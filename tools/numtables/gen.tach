// tools/numtables/gen.tach: writes compiler/std/num/tables.tach, the tables
// of std's number conversion (0.20, compiler/std/num.tach), computed with
// big integers:
//
//     target/tachyonc tools/numtables/gen.tach -o /tmp/gen && /tmp/gen > compiler/std/num/tables.tach
//
// (tests/std/oracle/num.sh checks that the result is the file checked in.)
//
// POW10_128: for K from -342 to 324, floor(10^K * 2^(127 - FL(K))) where
// FL(K) = floor(log2(10^K)): 10^K's first 128 bits, truncated, as two u64
// (high, low). Its users:
// - Schubfach (shortest digits, f64) needs g = POW10_128[K] + 1 for K from
//   -292 to 324 (Giulietti's g, with 128 bits), and f32 the high word + 1
//   for K from -31 to 45;
// - Eisel and Lemire (parsing) need, for q from -342 to 308, the table of
//   Rust's dec2flt (fast_float's): the same truncated values, except for
//   q from -27 to -1 where it is rounded up (one more). This generator
//   checks that against the table's own definition, entry by entry.
// It also checks FL(K) against (K * 1741647) >> 19, the formula num.tach
// uses.
//
// POW5_DIGITS and LSHIFT_TABLE: the slow path's (Rust's decimal.rs, Nigel
// Tao's): the decimal digits of 5^1, 5^2, .. 5^60 one after the other, and
// for each shift s from 0 to 64 (num_new_digits << 11) | the offset of
// 5^s's digits (from s = 61 on, 0x051C: none).

const LIMBS: i64 = 80;

// A natural number, 32 bits per limb, the lowest first.
struct Big { d: [u64; 80] }

fn big_zero() -> Big {
    Big { d: [0; 80] }
}

fn big_pow2(s: i64) -> Big {
    let mut b = big_zero();
    b.d[s / 32] = 1 << (s % 32) as u64;
    b
}

fn big_mul_small(b: &mut Big, m: u64) {
    let mut carry: u64 = 0;
    for i in 0..LIMBS {
        let x = b.d[i] * m + carry;
        b.d[i] = x & 0xffffffff;
        carry = x >> 32;
    }
    if carry != 0 {
        panic("big_mul_small: overflow");
    }
}

fn big_div_small(b: &mut Big, m: u64) {
    let mut rem: u64 = 0;
    let mut i = LIMBS - 1;
    while i >= 0 {
        let x = (rem << 32) | b.d[i];
        b.d[i] = x / m;
        rem = x % m;
        i -= 1;
    }
}

fn big_bitlen(b: &Big) -> i64 {
    let mut i = LIMBS - 1;
    while i >= 0 {
        if b.d[i] != 0 {
            let mut n = 0;
            let mut x = b.d[i];
            while x != 0 {
                n += 1;
                x = x >> 1;
            }
            return i * 32 + n;
        }
        i -= 1;
    }
    0
}

fn big_bit(b: &Big, i: i64) -> u64 {
    if i < 0 || i >= LIMBS * 32 {
        return 0;
    }
    (b.d[i / 32] >> (i % 32) as u64) & 1
}

// floor(b / 2^s), s >= 0.
fn big_shr(b: &Big, s: i64) -> Big {
    let mut r = big_zero();
    for i in 0..LIMBS * 32 - s {
        if big_bit(b, i + s) != 0 {
            r.d[i / 32] |= 1 << (i % 32) as u64;
        }
    }
    r
}

fn big_shl(b: &Big, s: i64) -> Big {
    let mut r = big_zero();
    for i in s..LIMBS * 32 {
        if big_bit(b, i - s) != 0 {
            r.d[i / 32] |= 1 << (i % 32) as u64;
        }
    }
    r
}

fn big_add_small(b: &mut Big, m: u64) {
    let mut carry = m;
    for i in 0..LIMBS {
        let x = b.d[i] + carry;
        b.d[i] = x & 0xffffffff;
        carry = x >> 32;
    }
}

fn big_pow(base: u64, n: i64) -> Big {
    let mut b = big_pow2(0);
    for _ in 0..n {
        big_mul_small(&mut b, base);
    }
    b
}

// The low 128 bits, as (high, low).
fn big_low128(b: &Big) -> (u64, u64) {
    ((b.d[3] << 32) | b.d[2], (b.d[1] << 32) | b.d[0])
}

fn fail(what: [u8], k: i64) {
    eprintln(f"gen: {what} at {k}");
    unsafe {
        exit(1);
    }
}

extern "C" {
    fn exit(code: i32);
}

// floor(10^K * 2^(127 - FL(K))), and FL(K).
fn pow10_128(k: i64) -> ((u64, u64), i64) {
    if k >= 0 {
        let p = big_pow(10, k);
        let len = big_bitlen(&p);
        let v = if len <= 128 { big_shl(&p, 128 - len) } else { big_shr(&p, len - 128) };
        return (big_low128(&v), len - 1);
    }
    let p = big_pow(10, -k);
    let len = big_bitlen(&p);
    // 2^(127 + len) / 10^-k, in [2^127, 2^128)
    let mut v = big_pow2(127 + len);
    for _ in 0..-k {
        big_div_small(&mut v, 10);
    }
    if big_bitlen(&v) != 128 {
        fail("pow10_128 not normalized", k);
    }
    (big_low128(&v), -len)
}

// Rust's dec2flt table entry for q (src/etc/dec2flt_table.py).
fn lemire_entry(q: i64) -> (u64, u64) {
    if q >= 0 {
        let p = big_pow(5, q);
        let len = big_bitlen(&p);
        let v = if len <= 128 { big_shl(&p, 128 - len) } else { big_shr(&p, len - 128) };
        return big_low128(&v);
    }
    let p = big_pow(5, -q);
    let z = big_bitlen(&p);
    let b = if q >= -27 { z + 127 } else { 2 * z + 128 };
    let mut c = big_pow2(b);
    for _ in 0..-q {
        big_div_small(&mut c, 5);
    }
    big_add_small(&mut c, 1);
    let len = big_bitlen(&c);
    if len > 128 {
        c = big_shr(&c, len - 128);
    }
    big_low128(&c)
}

fn main() -> i32 {
    println("// std::num::tables (0.20): generated by tools/numtables/gen.tach (do not");
    println("// edit): the tables of std's number conversion (std::num), computed");
    println("// there with big integers and checked against their definitions.");
    println("");
    println("// ---- Numbers: powers of ten (0.20) ----");
    println("");
    println("// For K from POW10_MIN (-342) to 324: 10^K's first 128 bits, truncated,");
    println("// floor(10^K * 2^(127 - floor(log2(10^K)))), as (high, low) at 2 * (K -");
    println("// POW10_MIN). Schubfach adds one (num.tach: f64_shortest, f32_shortest);");
    println("// Eisel and Lemire use them as they are, one more for K from -27 to -1");
    println("// (lemire_power).");
    println("pub const POW10_MIN: i64 = -342;");
    println("");
    println("pub static POW10_128: [u64; 1334] = [");
    for k in -342..325 {
        let (v, fl) = pow10_128(k);
        if fl != (k * 1741647) >> 19 {
            fail("FL(K) is not (K * 1741647) >> 19", k);
        }
        if k <= 308 {
            let want = lemire_entry(k);
            let adj: u64 = if k >= -27 && k <= -1 { 1 } else { 0 };
            let got = (v.0 + (if v.1 + adj < v.1 { 1 } else { 0 }), v.1 + adj);
            if got.0 != want.0 || got.1 != want.1 {
                fail("the Eisel-Lemire table differs", k);
            }
        }
        // (K = -342 is unused by Schubfach: (K * 1262611) >> 22 ranges over -324..292)
        println(f"    0x{v.0:016x}, 0x{v.1:016x},");
    }
    println("];");
    println("");
    println("// ---- Numbers: the slow path's digits of 5^s (0.20) ----");
    println("");
    // The digits of 5^1 .. 5^60, and the shift table.
    let mut digits: [u8; 1400] = [0; 1400];
    let mut n = 0;
    let mut table: [i64; 65] = [0; 65];
    for s in 0..65 {
        if s > 60 {
            table[s] = 0x051C;
            continue;
        }
        // num_new_digits: the number of decimal digits of 2^s
        let p2 = big_pow(2, s);
        let mut nd = 0;
        let mut q = p2;
        while big_bitlen(&q) != 0 {
            big_div_small(&mut q, 10);
            nd += 1;
        }
        if s == 0 {
            nd = 0;
        }
        table[s] = (nd << 11) | n;
        if s == 0 {
            continue;
        }
        let p = big_pow(5, s);
        let mut ds: [u8; 64] = [0; 64];
        let mut m = 0;
        let mut x = p;
        while big_bitlen(&x) != 0 {
            let mut y = x;
            big_div_small(&mut y, 10);
            let mut t = y;
            big_mul_small(&mut t, 10);
            ds[m] = (x.d[0] - t.d[0]) as u8;
            m += 1;
            x = y;
        }
        for i in 0..m {
            digits[n] = '0' + ds[m - 1 - i];
            n += 1;
        }
    }
    if n != 0x051C {
        fail("the digits of 5^1..5^60 are not 0x51c bytes", n);
    }
    println("// For each shift s from 0 to 64: (the decimal digits 2^s adds, at");
    println("// most) << 11 | where 5^s's digits start in POW5_DIGITS (Rust's");
    println("// number_of_digits_decimal_left_shift).");
    print("pub static LSHIFT_TABLE: [u16; 65] = [");
    for s in 0..65 {
        if s % 8 == 0 {
            print("\n   ");
        }
        print(f" {table[s]},");
    }
    println("\n];");
    println("");
    println("// The decimal digits of 5^1, 5^2, .. 5^60, one after the other, as text.");
    print("pub const POW5_DIGITS: [u8] = \"");
    print(digits[0..n]);
    println("\";");
    0
}
