// `wgslc explain CODE`: what a wgsl.* diagnostic means and how to fix it
// (the shader compiler's codes; `volec explain` has the language's).

struct Code { code: [u8], what: [u8], fix: [u8] }

const CODES: [Code; 20] = [
    Code { code: "wgsl.syntax", what: "the text is not WGSL: a token where another is expected, a declaration WGSL does not have at module scope, mixed operators that need parentheses ('a & b | c', 'a < b < c', '&&' with '||')", fix: "write the construct the message names; parenthesize mixed operators" },
    Code { code: "wgsl.name", what: "a name that is neither declared in scope, at module scope, nor a WGSL builtin; or a type name that is not a type", fix: "declare it, or correct the spelling (WGSL is case-sensitive: 'vec3f', 'textureSample')" },
    Code { code: "wgsl.type", what: "a value of the wrong type: WGSL converts nothing implicitly but abstract numbers ('1', '1.0'), so i32, u32 and f32 do not mix, and a condition is a bool", fix: "convert explicitly: f32(x), u32(x), i32(x); write a literal of the right type: 1u, 1i, 1.0" },
    Code { code: "wgsl.redefined", what: "a name declared twice in the same scope (module scope, a struct's members, a function's parameters)", fix: "rename one of them" },
    Code { code: "wgsl.unsupported", what: "WGSL this release's subset does not have (docs/design/gpu.md §2.10): f16, override, const_assert, extensions, cube, 3D and multisampled textures, pointer parameters beyond function and private ones", fix: "write it without the feature: f32 for f16, a const or a uniform for an override" },
    Code { code: "wgsl.attr", what: "an attribute that does not exist, or with the wrong arguments: '@workgroup_size' takes 1 to 3 constant integers from 1 to 1024 (1024 in all), '@builtin' a builtin value's name", fix: "use '@vertex', '@fragment', '@compute @workgroup_size(X, Y, Z)', '@builtin(NAME)', '@location(N)', '@interpolate(flat)'" },
    Code { code: "wgsl.binding", what: "a uniform, storage, texture or sampler variable without '@group(G) @binding(B)', or two variables at the same group and binding", fix: "give each resource its own '@group(G) @binding(B)'" },
    Code { code: "wgsl.layout", what: "a uniform buffer's type breaks the uniform address space's alignment rules: array strides and nested structs at multiples of 16 bytes", fix: "use vec4 elements (or pad them), or move the data to a storage buffer" },
    Code {
        code: "wgsl.cycle", what: "a type or constant defined in terms of itself",
        fix: "break the cycle",
    },
    Code { code: "wgsl.const", what: "a constant expression that overflows its type, divides by zero or shifts by its width or more; a literal out of range", fix: "WGSL evaluates constant expressions at translation: change the values, or compute it at run time" },
    Code {
        code: "wgsl.index",
        what: "a constant index out of a fixed-size array's, vector's or matrix's range",
        fix: "the index is 0 to length - 1 (run-time indices are clamped instead)",
    },
    Code { code: "wgsl.member", what: "a member a struct does not have, or a swizzle a vector does not have ('.xyzw' or '.rgba', not mixed, at most 4)", fix: "use one of the members the help lists" },
    Code { code: "wgsl.access", what: "a write to a variable that is read-only: a 'var<storage>' (read by default) or a 'var<uniform>'", fix: "declare it 'var<storage, read_write>', or write elsewhere" },
    Code {
        code: "wgsl.assign",
        what: "an assignment to a value: a 'let', a parameter, a call's result",
        fix: "assign to a 'var', a member or element of one, or through a pointer: '*p = x'",
    },
    Code { code: "wgsl.call", what: "a call with the wrong number of arguments, of a name that is not a function, or of an entry point", fix: "match the function's parameters; move an entry point's body into a function both call" },
    Code {
        code: "wgsl.recursion",
        what: "a function calls itself, directly or through others: WGSL has no recursion",
        fix: "write it as a loop",
    },
    Code { code: "wgsl.return", what: "a function with a result can reach its end without 'return', or a 'return' does not match the function", fix: "end every path with 'return VALUE;' ('return;' in a function without a result)" },
    Code { code: "wgsl.entry", what: "an entry point's interface is wrong: a parameter or result without '@location' or '@builtin', a builtin of another stage or of the wrong type, an integer location without '@interpolate(flat)', a vertex shader without '@builtin(position)'", fix: "the builtins: position (vec4<f32>), vertex_index and instance_index (u32), front_facing (bool), frag_depth (f32), global/local_invocation_id, workgroup_id, num_workgroups (vec3<u32>), local_invocation_index (u32)" },
    Code { code: "wgsl.stage", what: "an operation of another stage: 'discard', derivatives and implicit-level sampling are for fragment shaders, barriers for compute shaders", fix: "use textureSampleLevel outside fragment shaders; move the barrier into a compute shader" },
    Code {
        code: "wgsl.switch",
        what: "a switch without exactly one 'default', or with a case value twice",
        fix: "add 'default: {}'; merge the clauses: 'case 1, 2: { ... }'",
    },
];

pub fn explain(code: [u8]) -> i32 {
    for i in 0..CODES.len() {
        let c = CODES[i];
        if c.code == code {
            println(f"{c.code}: {c.what}.");
            println(f"fix: {c.fix}.");
            return 0;
        }
    }
    eprintln(f"error wgslc.explain: no code '{code}'");
    eprint("try: wgslc explain with one of:");
    for i in 0..CODES.len() {
        eprint(f" {CODES[i].code}");
    }
    eprintln("");
    1
}
