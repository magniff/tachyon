{
  "_doc": [
    "Hook settings for the agent eval, per condition (0.17; tools/agent-hooks). The harness copies",
    "`files` from tools/agent-hooks into its hooks directory, replaces @HOOKS@ with that directory",
    "and @PYTHON@ with its python (e.g. /usr/bin/python3 -I), and merges the condition's `hooks`",
    "into the run's --settings. Environment set in a command: TACHYON_CHECK_TESTS=0 leaves the tests",
    "out of the check and turn-end hooks; TACHYON_CHECK_HOOK_LOG names the check records' log (the",
    "harness sets it in the agent's environment, as for --check-hook); TACHYON_HOOK_STATE the hooks'",
    "per-session state directory (default $TMPDIR/tachyon-agent-hooks).",
    "Conditions: hook = check after each edit (delta, no tests); hook+test = the same with the",
    "program's tests (tests/NAME.in, NAME.out) after a clean check, debounced, and the turn-end check;",
    "hook+turn-end = the check and the turn-end check without tests; query = the query-first hook",
    "(compiler-tools); turn-end alone = only the Stop hook."
  ],
  "files": [
    "check-after-edit.py",
    "query-first.py",
    "turn-end.py",
    "tachyonc_cmd.py",
    "hookstate.py",
    "hints.txt"
  ],
  "conditions": {
    "hook": {
      "PostToolUse": [
        {
          "matcher": "Write|Edit|MultiEdit|Bash",
          "hooks": [
            {
              "type": "command",
              "command": "TACHYON_CHECK_TESTS=0 @PYTHON@ @HOOKS@/check-after-edit.py"
            }
          ]
        }
      ]
    },
    "hook+test": {
      "PostToolUse": [
        {
          "matcher": "Write|Edit|MultiEdit|Bash",
          "hooks": [
            {
              "type": "command",
              "command": "@PYTHON@ @HOOKS@/check-after-edit.py"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "@PYTHON@ @HOOKS@/turn-end.py"
            }
          ]
        }
      ]
    },
    "hook+turn-end": {
      "PostToolUse": [
        {
          "matcher": "Write|Edit|MultiEdit|Bash",
          "hooks": [
            {
              "type": "command",
              "command": "TACHYON_CHECK_TESTS=0 @PYTHON@ @HOOKS@/check-after-edit.py"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "TACHYON_CHECK_TESTS=0 @PYTHON@ @HOOKS@/turn-end.py"
            }
          ]
        }
      ]
    },
    "turn-end": {
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "@PYTHON@ @HOOKS@/turn-end.py"
            }
          ]
        }
      ]
    },
    "query": {
      "PreToolUse": [
        {
          "matcher": "Bash|Read|Grep|Edit|Write|MultiEdit",
          "hooks": [
            {
              "type": "command",
              "command": "@PYTHON@ @HOOKS@/query-first.py"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "@PYTHON@ @HOOKS@/query-first.py"
            }
          ]
        }
      ]
    }
  }
}
