#!/bin/sh
# Records where a tachyon tool (tachyonc query/edit/refactor/check/fix, or
# the harness) fell short, for the tools to improve (see AGENTS.md):
#
#   tools/agent-feedback TOOL "what you needed, what the tool did or lacked"
#
# Appends one JSON line to .git/agent-tools.jsonl (shared by all worktrees);
# tools/agent-tool-usage.py --hook-log summarizes it.
set -eu
[ $# -ge 2 ] || { echo "usage: tools/agent-feedback TOOL MESSAGE" >&2; exit 2; }
dir=$(git rev-parse --path-format=absolute --git-common-dir)
python3 -I - "$dir/agent-tools.jsonl" "$1" "$2" <<'PY'
import json, sys, time
path, tool, msg = sys.argv[1:4]
with open(path, "a") as fh:
    fh.write(json.dumps({"kind": "feedback", "tool": tool, "message": msg[:600],
                         "time": time.strftime("%Y-%m-%dT%H:%M:%S")}) + "\n")
PY
echo "recorded"
