// ---- The target's system (0.20) ----

// The end of std's text (front/stdalloc.tach, std_sys_source): what differs
// between the targets' C libraries, for sys/unix.tach. sys/linux.tach has
// the same items, in the same order, and the same length to the byte
// (embed.sh checks it), so that std's index holds for every target; the
// numbers are written as 8 hex digits for that.
// (macOS's values: <sys/fcntl.h>, <sys/errno.h>, <time.h>, <sys/ttycom.h>,
// <sys/signal.h>; errno is the int that __error() points to, C.)

// 0: macOS, 1: Linux.
pub const TARGET_OS: i64 = 0x00000000;

pub const SYS_O_CREAT: i32 = 0x00000200;
pub const SYS_O_TRUNC: i32 = 0x00000400;
pub const SYS_O_APPEND: i32 = 0x00000008;
pub const SYS_O_EXCL: i32 = 0x00000800;
pub const SYS_O_NONBLOCK: i32 = 0x00000004;
pub const SYS_O_CLOEXEC: i32 = 0x01000000;
pub const SYS_O_NOCTTY: i32 = 0x00020000;
pub const SYS_O_DIRECTORY: i32 = 0x00100000;

pub const SYS_EAGAIN: i32 = 0x00000023;
pub const SYS_ENOTEMPTY: i32 = 0x00000042;
pub const SYS_ETIMEDOUT: i32 = 0x0000003c;
pub const SYS_ENOSYS: i32 = 0x0000004e;
pub const SYS_ENOTSUP: i32 = 0x0000002d;
pub const SYS_ENAMETOOLONG: i32 = 0x0000003f;
pub const SYS_ELOOP: i32 = 0x0000003e;

pub const SYS_CLOCK_MONOTONIC: i32 = 0x00000006;
pub const SYS_PATH_MAX: i64 = 0x00000400;
pub const SYS_SIGCHLD: i32 = 0x00000014;
pub const SYS_TIOCSWINSZ: u64 = 0x80087467;
pub const SYS_TIOCGWINSZ: u64 = 0x40087468;
pub const SYS_TIOCSCTTY: u64 = 0x20007461;

extern "C" {
    #[link_name = "__error"]
    #[effects(global)]
    fn sys_errno_location() -> *i32;
}
