// std::env (0.20, docs/design/collections-text-io.md §2.6.3, task B6):
// the program's arguments and environment, with Rust's names. `args()`
// yields views of argv, valid for the whole program (no allocation);
// a variable's value is copied (`get_in`), since the environment can
// change under a view. (Rust's `env::var` is `env::get` here: `var`
// is a word, a keyword from 0.21.)

use std::{Allocator, Display, Fmt, Gpa, Iterator, Option, Result, Vec, sys_args};
use std::io::error::{Error, ErrorKind, __io_error, __os_error};
use std::path::PathBuf;
use std::str::validate_utf8;
use std::string::{String, str};
use std::sys::{
    sys_chdir, sys_cstr_view, sys_env_at, sys_env_count, sys_getcwd_into, sys_getenv, sys_setenv,
    sys_unsetenv,
};

// ---- Arguments (0.20) ----

// The i-th argument's bytes (i < count).
fn arg_bytes(i: i64) -> [u8] {
    let (n, argv) = sys_args();
    if i < 0 || i >= n {
        std::panic_str("env: argument index out of bounds");
    }
    // (argv[0..argc] are crt's NUL-ended strings, for the whole program)
    unsafe { sys_cstr_view(argv[i]) }
}

// The arguments, the program's name first: `for a in env::args()`,
// `env::args().collect_in(gpa)`. One that is not UTF-8 stops the program
// (as Rust's); `args_os()` yields bytes.
pub fn args() -> Args {
    let (n, _) = sys_args();
    Args { i: 0, n: n }
}

// The arguments as bytes.
pub fn args_os() -> ArgsOs {
    let (n, _) = sys_args();
    ArgsOs { i: 0, n: n }
}

pub struct Args { i: i64, n: i64 }

impl Iterator for Args {
    type Item = str;

    fn next(inout self) -> Option<str> {
        if self.i >= self.n {
            return Option::None;
        }
        let b = arg_bytes(self.i);
        self.i += 1;
        match str::from_utf8(b) {
            Ok(s) => Option::Some(s),
            Err(_) => std::panic_str(
                "env::args: an argument is not UTF-8 (env::args_os yields bytes)"),
        }
    }

    fn exact_len(self) -> i64 {
        self.n - self.i
    }
}

impl Args {
    // The arguments left.
    pub fn len(self) -> i64 {
        self.n - self.i
    }

    // Skips the first n (`env::args().skip(1)`: the program's name).
    pub fn skip(self, n: i64) -> Args {
        var a = self;
        a.i = if a.i + n < a.n { a.i + n } else { a.n };
        a
    }
}

pub struct ArgsOs { i: i64, n: i64 }

impl Iterator for ArgsOs {
    type Item = [u8];

    fn next(inout self) -> Option<[u8]> {
        if self.i >= self.n {
            return Option::None;
        }
        let b = arg_bytes(self.i);
        self.i += 1;
        Option::Some(b)
    }
}

// ---- The environment (0.20) ----

// Why env::get_in failed: the variable is not set, or its value is not
// UTF-8.
#[derive(Eq, Debug, Clone)]
pub enum VarError { NotPresent, NotUnicode }

impl Display for VarError {
    fn fmt(self, f: inout Fmt) {
        match self {
            VarError::NotPresent => f.str("environment variable not found"),
            VarError::NotUnicode => f.str("environment variable was not valid unicode"),
        }
    }
}

// The value of variable name, copied into a new String on allocator a.
pub fn get_in<A: Allocator>(name: [u8], a: sink A) -> Result<String<A>, VarError> {
    match sys_getenv(name) {
        Option::Some(v) => match validate_utf8(v) {
            Ok(_) => Ok(String::from_in(v as str, a)),
            Err(_) => Err(VarError::NotUnicode),
        },
        Option::None => Err(VarError::NotPresent),
    }
}

// (0.16: an error outside std, front/ambient.vl)
#[ambient("get_in(name, gpa)")]
pub fn get(name: [u8]) -> Result<String, VarError> {
    get_in(name, Gpa::ambient())
}

// The value of variable name, its bytes copied into a new Vec on a.
pub fn var_os_in<A: Allocator>(name: [u8], a: sink A) -> Option<Vec<u8, A>> {
    match sys_getenv(name) {
        Option::Some(v) => {
            var out: Vec<u8, A> = Vec::with_capacity_in(v.len, a);
            out.extend_from_slice(v);
            Option::Some(out)
        }
        Option::None => Option::None,
    }
}

// Whether variable name is set.
pub fn var_is_set(name: [u8]) -> bool {
    sys_getenv(name).is_some()
}

// Every variable, (name, value) copied into Strings on allocator a (the
// ones that are not UTF-8 left out).
pub fn vars_in<A: Allocator>(a: sink A) -> Vec<(String<A>, String<A>), A> {
    var out: Vec<(String<A>, String<A>), A> = Vec::new_in(a);
    for i in 0..sys_env_count() {
        let kv = sys_env_at(i);
        var eq = -1;
        for k in 0..kv.len {
            if kv[k] == '=' {
                eq = k;
                break;
            }
        }
        if eq < 0 || validate_utf8(kv).is_err() {
            continue;
        }
        let name: String<A> = String::from_in(kv[..eq] as str, a);
        let value: String<A> = String::from_in(kv[eq + 1..] as str, a);
        out.push((name, value));
    }
    out
}

// Sets variable name to value (Rust 2024's `unsafe fn`: no other thread
// may read the environment meanwhile, and views of it end).
pub unsafe fn set_var(name: [u8], value: [u8]) {
    let _ = sys_setenv(name, value);
}

pub unsafe fn remove_var(name: [u8]) {
    let _ = sys_unsetenv(name);
}

// ---- The working directory (0.20) ----

// The current directory, in a new PathBuf on allocator a.
pub fn current_dir_in<A: Allocator>(a: sink A) -> std::io::Result<PathBuf<A>> {
    var buf: [u8; 4096] = [0; 4096];
    match sys_getcwd_into(&buf[..]) {
        Ok(n) => Ok(PathBuf::from_in(buf[..n], a)),
        Err(e) => Err(__os_error(e)),
    }
}

pub fn set_current_dir(path: [u8]) -> std::io::Result<()> {
    match sys_chdir(path) {
        Ok(_) => Ok(()),
        Err(e) => Err(__os_error(e)),
    }
}
