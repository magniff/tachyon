// std::slice::stable: the stable sort, driftsort (0.20).

use std::{Ord, forget, memcpy, needs_drop};
use std::num::leading_zeros;
use super::{
    SortStackBuf, choose_pivot_raw, existing_run_raw, insertion_sort_raw, reverse_raw, rotate_raw,
    small_sort_raw, sort_stack_cap,
};

// ---- Sort, stable (0.20) ----

// The stable sort (0.20; docs/design/collections-text-io.md §2.4.6), after
// Rust's driftsort: the slice is cut into runs, which are merged in
// powersort's order (the depth of each boundary in the merge tree of the
// run midpoints). A run is a natural one when the input has one of
// sqrt(n) elements or more there (ascending, or strictly descending and
// reversed); elsewhere a run of sqrt(n) elements is left unsorted, and
// two neighbouring unsorted runs merge by just becoming one, as long as
// it fits in the scratch. An unsorted run is sorted when it must be
// merged with a sorted one, or at the end, by a stable quicksort: a
// branchless partition through the scratch, the elements equal to the
// pivot put in place at once when it is the least (O(n log k) for k
// distinct values), the small sort (Sort kernels) up to 32 elements, and
// the merge sort below a depth of 2·log2(n). A merge copies its shorter
// side into the scratch and merges with no branch on the comparisons.
//
// Scratch: `sort_stable_scratch_len(n)` elements (n up to 8 MB, then
// n / 2) give the full speed; with less (the 4 KB of the slice form), a
// merge whose shorter side does not fit is split by binary searches and
// rotations until its pieces do, in place (O(n log² n) at worst), and
// only runs that fit are sorted by quicksort.
//
// Unsafe code: as the unstable sort's (Sort, unstable). The scratch is
// slots of T that are written before they are read; it never overlaps
// the slice, and holds bit copies only (bytes, or an allocator's block
// whose Vec keeps length 0): nothing in it is ever dropped, and every
// element ends up in the slice exactly once, whatever the comparator
// answers (a merge that finds no total order copies the scratch back).
// Elements of a type with a drop keep no ancestor copies
// (stable_quicksort_plain_raw). Nothing recurses: the merge sort the quicksort falls back
// on is a separate function (drift_eager_raw) that never sorts by
// quicksort.

// Sorts s in place, smallest first, keeping equal elements in the order
// they had, with no allocation: the scratch is 4 KB on the stack, and
// larger merges are done in place (slower: `sort_stable_in` takes an
// allocator for the scratch).
pub fn sort_stable_noalloc<T: Ord>(s: inout [T]) {
    sort_stable_less(s, |a: T, b: T| a < b);
}

// Sorts s stably by is_less (`is_less(a, b)`: *a goes strictly before
// *b) with a 4 KB scratch on the stack (`sort_stable_noalloc`).
pub fn sort_stable_less<T, F: FnMut(let T, let T) -> bool>(s: inout [T], is_less: F) {
    let n = s.len;
    if n < 2 || size_of(T) == 0 {
        return;
    }
    var buf: SortStackBuf = SortStackBuf { words: [0; 512] };
    let cap = sort_stack_cap::<T>();
    // (s.ptr and s.len are one slice's; the buffer has cap slots and is
    // not s)
    unsafe {
        sort_stable_raw(s.ptr, n, &buf as *T, cap, is_less);
    }
}

// Sorts s stably by is_less, with scratch[0..scratch_len]
// (`sort_stable_scratch_len(s.len)` for the full speed; any length
// works). The caller promises that scratch points to scratch_len slots
// of T it owns, outside s; their contents are overwritten.
pub unsafe fn sort_stable_less_with<T, F: FnMut(let T, let T) -> bool>(s: inout [T], scratch: *T,
    scratch_len: i64, is_less: F) {
    if s.len < 2 || size_of(T) == 0 {
        return;
    }
    sort_stable_raw(s.ptr, s.len, scratch, scratch_len, is_less);
}

// The scratch the stable sort wants for n elements of T: all n up to
// 8 MB, n / 2 beyond (driftsort's), and at least 48 (the small sort's).
pub fn sort_stable_scratch_len<T>(n: i64) -> i64 {
    let full = if size_of(T) == 0 { n } else { 8000000 / size_of(T) };
    var len = n - n / 2;
    if len < n && n <= full {
        len = n;
    } else if len < full && full < n {
        len = full;
    }
    if len < 48 { 48 } else { len }
}

// v[0..n] (n >= 2), scratch[0..cap].
unsafe fn sort_stable_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, scratch: *T, cap: i64,
    is_less: F) {
    var f = is_less;
    if n <= 20 {
        insertion_sort_raw(v, n, 1, f);
        return;
    }
    // Short slices: a small sort or two and a merge beat the quicksort.
    if n <= 64 {
        drift_eager_raw(v, n, scratch, cap, f);
        return;
    }
    drift_lazy_raw(v, n, scratch, cap, f);
}

// The runs of 32 the merge sort makes where the input has none.
const SORT_STABLE_RUN: i64 = 32;

// sqrt(n) roughly: 2^((1 + floor(log2 n)) / 2), then a Newton step.
fn sort_sqrt_approx(n: i64) -> i64 {
    var lg = 0;
    for k in 1..63 {
        if ((n | 1) >> k) == 0 {
            break;
        }
        lg += 1;
    }
    let shift = (1 + lg) / 2;
    ((1 << shift) + (n >> shift)) / 2
}

// The natural runs a merge takes as they are: sqrt(n) long at least
// (from 4096 elements; below, 64 or half the slice).
fn sort_min_good_run(n: i64) -> i64 {
    if n <= 64 * 64 {
        if n - n / 2 < 64 { n - n / 2 } else { 64 }
    } else {
        sort_sqrt_approx(n)
    }
}

// The depth in the merge tree of the boundary between the runs
// [left, mid) and [mid, right) (powersort's node power, with scale =
// 2^62 / n rounded up).
fn sort_merge_depth(left: i64, mid: i64, right: i64, scale: u64) -> i64 {
    let x = (left + mid) as u64;
    let y = (mid + right) as u64;
    leading_zeros((scale * x) ^ (scale * y))
}

// Driftsort with lazy runs, v[0..n] (n >= 2): unsorted runs of sqrt(n)
// are sorted by the stable quicksort when they meet a sorted one or
// grow past the scratch.
unsafe fn drift_lazy_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, scratch: *T, cap: i64,
    is_less: F) {
    var f = is_less;
    let scale = ((1u64 << 62) + n as u64 - 1u64) / n as u64;
    let min_good = sort_min_good_run(n);
    // The stack of runs below the previous one; boundary depths increase
    // up it (below 64), so it holds 65 runs at most and a first, empty
    // one.
    var run_len: [i64; 66] = [0; 66];
    var run_sorted: [bool; 66] = [false; 66];
    var run_depth: [i64; 66] = [0; 66];
    var kept = 0;
    var prev_len = 0;
    var prev_sorted = true;
    var scan = 0;
    // (each round takes a run of at least 1: n + 1 rounds at most)
    for _ in 0..n + 2 {
        var next_len = 0;
        var next_sorted = true;
        var depth = 0;
        if scan < n {
            // A natural run long enough, else an unsorted one.
            let rest = n - scan;
            next_len = if rest < min_good { rest } else { min_good };
            next_sorted = false;
            if rest >= min_good {
                let (run, desc) = existing_run_raw(&v[scan], rest, f);
                if run >= min_good {
                    if desc {
                        reverse_raw(&v[scan], run);
                    }
                    next_len = run;
                    next_sorted = true;
                }
            }
            depth = sort_merge_depth(scan - prev_len, scan, scan + next_len, scale);
        }
        for _ in 0..66 {
            if kept <= 1 || run_depth[kept - 1] < depth {
                break;
            }
            let left = run_len[kept - 1];
            let left_sorted = run_sorted[kept - 1];
            let merged = left + prev_len;
            let w: *T = &v[scan - merged];
            // Two unsorted runs that fit in the scratch just join; else
            // each is sorted and they are merged.
            if merged > cap || left_sorted || prev_sorted {
                if !left_sorted {
                    stable_quicksort_raw(w, left, scratch, cap, f);
                }
                if !prev_sorted {
                    stable_quicksort_raw(&w[left], prev_len, scratch, cap, f);
                }
                merge_any_raw(w, merged, left, scratch, cap, f);
                prev_sorted = true;
            } else {
                prev_sorted = false;
            }
            prev_len = merged;
            kept -= 1;
        }
        if kept == 66 {
            // (not reached: see above)
            return;
        }
        run_len[kept] = prev_len;
        run_sorted[kept] = prev_sorted;
        run_depth[kept] = depth;
        kept += 1;
        if scan >= n {
            break;
        }
        scan += next_len;
        prev_len = next_len;
        prev_sorted = next_sorted;
    }
    if !prev_sorted {
        stable_quicksort_raw(v, n, scratch, cap, f);
    }
}

// Driftsort with eager runs (no quicksort): v[0..n] (n >= 2), every run
// sorted when it is made, then merged. The stable quicksort's fallback.
unsafe fn drift_eager_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, scratch: *T, cap: i64,
    is_less: F) {
    var f = is_less;
    let scale = ((1u64 << 62) + n as u64 - 1u64) / n as u64;
    let min_good = sort_min_good_run(n);
    var run_len: [i64; 66] = [0; 66];
    var run_depth: [i64; 66] = [0; 66];
    var kept = 0;
    var prev_len = 0;
    var scan = 0;
    for _ in 0..n + 2 {
        var next_len = 0;
        var depth = 0;
        if scan < n {
            next_len = eager_run_raw(&v[scan], n - scan, min_good, scratch, cap, f);
            depth = sort_merge_depth(scan - prev_len, scan, scan + next_len, scale);
        }
        for _ in 0..66 {
            if kept <= 1 || run_depth[kept - 1] < depth {
                break;
            }
            let left = run_len[kept - 1];
            let merged = left + prev_len;
            merge_any_raw(&v[scan - merged], merged, left, scratch, cap, f);
            prev_len = merged;
            kept -= 1;
        }
        if kept == 66 {
            return;
        }
        run_len[kept] = prev_len;
        run_depth[kept] = depth;
        kept += 1;
        if scan >= n {
            return;
        }
        scan += next_len;
        prev_len = next_len;
    }
}

// Makes a sorted run at the start of v[0..n] (n >= 1) and returns its
// length: the natural run there when it has min_good elements or more,
// else the first SORT_STABLE_RUN (or n) sorted by the small sort.
unsafe fn eager_run_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, min_good: i64,
    scratch: *T, cap: i64, is_less: F) -> i64 {
    var f = is_less;
    if n >= min_good && n >= 2 {
        let (run, desc) = existing_run_raw(v, n, f);
        if run >= min_good {
            if desc {
                reverse_raw(v, run);
            }
            return run;
        }
    }
    let len = if n < SORT_STABLE_RUN { n } else { SORT_STABLE_RUN };
    stable_small_sort_raw(v, len, scratch, cap, f);
    len
}

// Sorts v[0..len] (len <= 32) stably: the small sort when the scratch has
// its len + 16 slots, else insertion sort.
#[inline]
unsafe fn stable_small_sort_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, scratch: *T,
    cap: i64, is_less: F) {
    var f = is_less;
    if len < 2 {
        return;
    }
    if cap >= len + 16 {
        small_sort_raw(v, len, scratch, f);
    } else {
        insertion_sort_raw(v, len, 1, f);
    }
}

// The stable quicksort of v[0..n] (n <= cap). The left side of each
// partition is sorted next and the right side kept; every partition
// lowers the depth left (2·log2(n) <= 126), so at most 126 are kept.
// A range's ancestor is the pivot of the partition that made it its
// right side (a copy: the partition moves elements); when a new pivot is
// no greater than it, the pivot equals the least elements, which go left
// in place, and only the greater ones are left to sort (also when nothing
// is less than the pivot). Elements over 128 bytes keep no copies: only
// the second way applies.
unsafe fn stable_quicksort_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, scratch: *T,
    cap: i64, is_less: F) {
    var f = is_less;
    if size_of(T) > 128 || needs_drop::<T>() {
        stable_quicksort_plain_raw(v, n, scratch, cap, f);
        return;
    }
    var kept_lo: [i64; 128] = [0; 128];
    var kept_hi: [i64; 128] = [0; 128];
    var kept_limit: [i64; 128] = [0; 128];
    var kept_has_anc: [bool; 128] = [false; 128];
    var kept_anc: [T; 128] = [v[0]; 128];
    var kept = 0;
    var limit = 0;
    for k in 1..63 {
        if ((n | 1) >> k) == 0 {
            break;
        }
        limit += 2;
    }
    var lo = 0;
    var hi = n;
    var anc = v[0];
    var has_anc = false;
    // (each round finishes a range, or partitions one into two shorter
    // ones or puts some of it in place: 2n + 2 rounds at most)
    for _ in 0..2 * n + 2 {
        let len = hi - lo;
        if len <= SORT_STABLE_RUN || limit == 0 || len > cap || kept == 128 {
            if len <= SORT_STABLE_RUN {
                if len >= 2 {
                    stable_small_sort_raw(&v[lo], len, scratch, cap, f);
                }
            } else {
                drift_eager_raw(&v[lo], len, scratch, cap, f);
            }
            if kept == 0 {
                return;
            }
            kept -= 1;
            lo = kept_lo[kept];
            hi = kept_hi[kept];
            limit = kept_limit[kept];
            has_anc = kept_has_anc[kept];
            anc = kept_anc[kept];
            continue;
        }
        limit -= 1;
        let w: *T = &v[lo];
        let p = choose_pivot_raw(w, len, f);
        let pv = w[p];
        var num_lt = 0;
        let equal = has_anc && !f(anc, pv);
        if !equal {
            num_lt = stable_partition_raw(w, len, scratch, p, false, f);
        }
        if equal || num_lt == 0 {
            // (nothing moved when num_lt == 0: v[p] is still the pivot)
            let num_le = stable_partition_raw(w, len, scratch, p, true, |a: T, b: T| !f(b, a));
            lo += num_le;
            has_anc = false;
            continue;
        }
        kept_lo[kept] = lo + num_lt;
        kept_hi[kept] = hi;
        kept_limit[kept] = limit;
        kept_has_anc[kept] = true;
        kept_anc[kept] = pv;
        kept += 1;
        hi = lo + num_lt;
    }
}

// The stable quicksort without ancestor copies (elements over 128 bytes).
unsafe fn stable_quicksort_plain_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, scratch: *T,
    cap: i64, is_less: F) {
    var f = is_less;
    var kept_lo: [i64; 128] = [0; 128];
    var kept_hi: [i64; 128] = [0; 128];
    var kept_limit: [i64; 128] = [0; 128];
    var kept = 0;
    var limit = 0;
    for k in 1..63 {
        if ((n | 1) >> k) == 0 {
            break;
        }
        limit += 2;
    }
    var lo = 0;
    var hi = n;
    for _ in 0..2 * n + 2 {
        let len = hi - lo;
        if len <= SORT_STABLE_RUN || limit == 0 || len > cap || kept == 128 {
            if len <= SORT_STABLE_RUN {
                if len >= 2 {
                    stable_small_sort_raw(&v[lo], len, scratch, cap, f);
                }
            } else {
                drift_eager_raw(&v[lo], len, scratch, cap, f);
            }
            if kept == 0 {
                return;
            }
            kept -= 1;
            lo = kept_lo[kept];
            hi = kept_hi[kept];
            limit = kept_limit[kept];
            continue;
        }
        limit -= 1;
        let w: *T = &v[lo];
        let p = choose_pivot_raw(w, len, f);
        let num_lt = stable_partition_raw(w, len, scratch, p, false, f);
        if num_lt == 0 {
            let num_le = stable_partition_raw(w, len, scratch, p, true, |a: T, b: T| !f(b, a));
            lo += num_le;
            continue;
        }
        kept_lo[kept] = lo + num_lt;
        kept_hi[kept] = hi;
        kept_limit[kept] = limit;
        kept += 1;
        hi = lo + num_lt;
    }
}

// Partitions v[0..len] stably around the pivot v[p] (len <= the scratch's
// length): the elements x with is_less(x, pv) first, then the others,
// each side in its old order; the pivot itself goes left when
// pivot_goes_left. Returns how many went left. Each element is copied
// into the scratch, to the front for the left side and to the back
// (reversed) for the right, with no branch on the comparison, then both
// are copied back. (at step i: left slots num_left <= i, right slots
// len - 1 - (i - num_left) <= len - 1)
unsafe fn stable_partition_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, scratch: *T,
    p: i64, pivot_goes_left: bool, is_less: F) -> i64 {
    var f = is_less;
    let pv = v[p];
    // (the right side's base: element i goes to rev[num_left], rev being
    // &scratch[len - 1 - i])
    let rev: *T = &scratch[len - 1];
    var num_left = stable_partition_scan_raw(v, 0, p, scratch, rev, 0, &pv, f);
    let pivot_at = if pivot_goes_left { num_left } else { len - 1 - p + num_left };
    num_left += pivot_goes_left as i64;
    num_left = stable_partition_scan_raw(v, p + 1, len, scratch, &rev[-(p + 1)], num_left, &pv, f);
    // (the pivot last: the scans compared with it)
    scratch[pivot_at] = pv;
    copy_raw(v, scratch, num_left);
    for i in 0..len - num_left {
        v[num_left + i] = scratch[len - 1 - i];
    }
    num_left
}

// stable_partition_raw's scan of v[from..to], with rev the right side's
// base for element `from` and num_left so far; returns num_left after.
// Four steps a round, then the rest.
#[inline]
unsafe fn stable_partition_scan_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, from: i64, to: i64,
    scratch: *T, rev0: *T, num_left0: i64, pivot_at: *T, is_less: F) -> i64 {
    var f = is_less;
    let pv = *pivot_at;
    var rev = rev0;
    var num_left = num_left0;
    var i = from;
    for _ in 0..(to - from) / 4 {
        let src: *T = &v[i];
        let x0 = src[0];
        let l0 = f(x0, pv);
        let b0 = if l0 { scratch } else { rev };
        let at = num_left;
        num_left += l0 as i64;
        b0[at] = x0;
        let x1 = src[1];
        let l1 = f(x1, pv);
        let b1 = if l1 { scratch } else { &rev[-1] };
        let at = num_left;
        num_left += l1 as i64;
        b1[at] = x1;
        let x2 = src[2];
        let l2 = f(x2, pv);
        let b2 = if l2 { scratch } else { &rev[-2] };
        let at = num_left;
        num_left += l2 as i64;
        b2[at] = x2;
        let x3 = src[3];
        let l3 = f(x3, pv);
        let b3 = if l3 { scratch } else { &rev[-3] };
        let at = num_left;
        num_left += l3 as i64;
        b3[at] = x3;
        rev = &rev[-4];
        i += 4;
    }
    for _ in i..to {
        let x = v[i];
        let l = f(x, pv);
        let b = if l { scratch } else { rev };
        let at = num_left;
        num_left += l as i64;
        b[at] = x;
        rev = &rev[-1];
        i += 1;
    }
    // (a copy of the pivot, which stays where it is: not dropped here)
    forget(pv);
    num_left
}

// Merges the sorted v[0..mid] and v[mid..len], stably: through the
// scratch when the shorter side fits in it, else split in place (the
// halves found by binary search, the middle rotated) into merges that
// do, kept on a stack.
unsafe fn merge_any_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, mid: i64, scratch: *T,
    cap: i64, is_less: F) {
    var f = is_less;
    let shorter = if mid < len - mid { mid } else { len - mid };
    if shorter <= cap {
        merge_raw(v, len, mid, scratch, f);
        return;
    }
    // Pending merges (lo, mid, hi). A split leaves two merges of at most
    // 5/6 of its elements each, so the splits nest at most
    // log(6/5)(2^63) < 240 deep and fewer than 320 are pending at once.
    var p_lo: [i64; 320] = [0; 320];
    var p_mid: [i64; 320] = [0; 320];
    var p_hi: [i64; 320] = [0; 320];
    p_lo[0] = 0;
    p_mid[0] = mid;
    p_hi[0] = len;
    var pending = 1;
    // (each round finishes a merge or splits one: far fewer rounds than
    // this bound)
    for _ in 0..512 * (len + 1) {
        if pending == 0 {
            return;
        }
        pending -= 1;
        let lo = p_lo[pending];
        let m = p_mid[pending];
        let hi = p_hi[pending];
        let l1 = m - lo;
        let l2 = hi - m;
        if l1 == 0 || l2 == 0 {
            continue;
        }
        if l1 <= cap || l2 <= cap {
            merge_raw(&v[lo], hi - lo, l1, scratch, f);
            continue;
        }
        if l1 + l2 == 2 {
            // (no scratch at all)
            if f(*(&v[m]), *(&v[lo])) {
                let t = v[lo];
                v[lo] = v[m];
                v[m] = t;
            }
            continue;
        }
        if pending + 2 > 320 {
            // (not reached: see above)
            return;
        }
        // Cut the longer side in half; the other side's elements that go
        // before the cut element are found by binary search.
        var cut1 = 0;
        var cut2 = 0;
        if l1 >= l2 {
            cut1 = lo + l1 / 2;
            // the first in v[m..hi] not less than v[cut1]
            cut2 = m + lower_bound_raw(&v[m], l2, &v[cut1], f);
        } else {
            cut2 = m + l2 / 2;
            // the first in v[lo..m] greater than v[cut2]
            cut1 = lo + upper_bound_raw(&v[lo], l1, &v[cut2], f);
        }
        rotate_raw(&v[cut1], cut2 - cut1, m - cut1);
        let new_mid = cut1 + (cut2 - m);
        p_lo[pending] = new_mid;
        p_mid[pending] = cut2;
        p_hi[pending] = hi;
        p_lo[pending + 1] = lo;
        p_mid[pending + 1] = cut1;
        p_hi[pending + 1] = new_mid;
        pending += 2;
    }
}

// The number of elements of the sorted v[0..n] that are less than *x.
unsafe fn lower_bound_raw<T,
    F: FnMut(let T, let T) -> bool>(v: *T, n: i64, x: *T, is_less: F) -> i64 {
    var f = is_less;
    var lo = 0;
    var size = n;
    // (size halves each round)
    for _ in 0..64 {
        if size == 0 {
            break;
        }
        let half = size / 2;
        let mid = lo + half;
        if f(*(&v[mid]), *x) {
            lo = mid + 1;
            size -= half + 1;
        } else {
            size = half;
        }
    }
    lo
}

// The number of elements of the sorted v[0..n] that are not greater than
// *x.
unsafe fn upper_bound_raw<T,
    F: FnMut(let T, let T) -> bool>(v: *T, n: i64, x: *T, is_less: F) -> i64 {
    var f = is_less;
    var lo = 0;
    var size = n;
    for _ in 0..64 {
        if size == 0 {
            break;
        }
        let half = size / 2;
        let mid = lo + half;
        if !f(*x, *(&v[mid])) {
            lo = mid + 1;
            size -= half + 1;
        } else {
            size = half;
        }
    }
    lo
}

// Merges the sorted v[0..mid] and v[mid..len] (both nonempty), stably,
// with the shorter side copied into scratch (room for it): from the
// front when the left side is the shorter, else from the back. No branch
// on the comparisons; every index stays in its range whatever they
// answer, and what is left of the scratch's side is copied back after.
unsafe fn merge_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, mid: i64, scratch: *T,
    is_less: F) {
    var f = is_less;
    let right_len = len - mid;
    if mid <= right_len {
        copy_raw(scratch, v, mid);
        // left in scratch[l..mid], right in v[r..len], out = l + r - mid
        // < r: nothing unread is overwritten
        var l = 0;
        var r = mid;
        var out = 0;
        for _ in 0..len {
            if l >= mid || r >= len {
                break;
            }
            let take_left = !f(*(&v[r]), *(&scratch[l]));
            let p: *T = if take_left { &scratch[l] } else { &v[r] };
            l += take_left as i64;
            r += (!take_left) as i64;
            v[out] = *p;
            out += 1;
        }
        if l < mid {
            copy_raw(&v[out], &scratch[l], mid - l);
        }
    } else {
        copy_raw(scratch, &v[mid], right_len);
        // left in v[0..l], right in scratch[0..r], written at l + r - 1
        // >= l: nothing unread is overwritten
        var l = mid;
        var r = right_len;
        for _ in 0..len {
            if l <= 0 || r <= 0 {
                break;
            }
            let take_left = f(*(&scratch[r - 1]), *(&v[l - 1]));
            let p: *T = if take_left { &v[l - 1] } else { &scratch[r - 1] };
            let at = l + r - 1;
            l -= take_left as i64;
            r -= (!take_left) as i64;
            v[at] = *p;
        }
        copy_raw(&v[l], scratch, r);
    }
}

// dst[0..n] = src[0..n] (not overlapping).
#[inline]
unsafe fn copy_raw<T>(dst: *T, src: *T, n: i64) {
    if n > 0 {
        memcpy(dst as *u8, src as *u8, (n * size_of(T)) as u64);
    }
}
