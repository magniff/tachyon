// std::slice::search: binary search and partition_point (0.20).

use std::{Ord, Result};

// ---- Slice searches (0.20) ----

// Binary search and partition_point (0.20; docs/design/collections-text-io.md
// §2.4.6), Rust's: the loop runs a number of rounds that depends only on
// the length, each choosing its half with no branch on the comparison, and
// a match is not returned early. With equal elements, which of them a
// match finds is unspecified, as in Rust. Comparators follow sort_by's
// sign convention until std has Ordering (0.20's A0): `f(x)` negative,
// zero or positive as the element x goes before, with or after the one
// looked for.

// Searches the sorted s for *x: Ok(index of a match), or Err(the index
// where *x would go to keep s sorted). Rust's `binary_search`.
pub fn binary_search<T: Ord>(s: &[T], x: &T) -> Result<i64, i64> {
    binary_search_by(s, |e: &T| e.cmp(x))
}

// Searches s, sorted by f, for the element f places at 0 (`f(e)`: the
// sign of comparing e with what is looked for): Ok(index of a match), or
// Err(the index where it would go).
pub fn binary_search_by<T, F: FnMut(&T) -> i64>(s: &[T], f: F) -> Result<i64, i64> {
    let mut g = f;
    let mut size = s.len;
    if size == 0 {
        return Err(0);
    }
    let mut base = 0;
    // (size halves each round, base + size <= s.len: 63 rounds at most)
    for _ in 0..64 {
        if size <= 1 {
            break;
        }
        let half = size / 2;
        let mid = base + half;
        let c = g(&s[mid]);
        base = if c > 0 { base } else { mid };
        size -= half;
    }
    let c = g(&s[base]);
    if c == 0 {
        Ok(base)
    } else {
        Err(base + (c < 0) as i64)
    }
}

// Searches s, sorted by the key f gives, for *key: as binary_search.
pub fn binary_search_by_key<T, B: Ord, F: FnMut(&T) -> B>(s: &[T], key: &B, f: F) -> Result<i64,
    i64> {
    let mut g = f;
    binary_search_by(s, |e: &T| {
        let k = g(e);
        k.cmp(key)
    })
}

// The index of the first element for which pred is false, s being
// partitioned (pred true for a prefix, false after). Rust's
// `partition_point`.
pub fn partition_point<T, P: FnMut(&T) -> bool>(s: &[T], pred: P) -> i64 {
    let mut g = pred;
    match binary_search_by(s, |e: &T| if g(e) { -1 } else { 1 }) {
        Ok(i) => i,
        Err(i) => i,
    }
}
