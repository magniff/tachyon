}

// The physical key of a macOS virtual key code (Carbon's kVK_*, the
// position on an ANSI keyboard whatever the layout).
pub fn mac_keycode(vk: u16) -> KeyCode {
    match vk {
        0x00 => KeyCode::KeyA,
        0x01 => KeyCode::KeyS,
        0x02 => KeyCode::KeyD,
        0x03 => KeyCode::KeyF,
        0x04 => KeyCode::KeyH,
        0x05 => KeyCode::KeyG,
        0x06 => KeyCode::KeyZ,
        0x07 => KeyCode::KeyX,
        0x08 => KeyCode::KeyC,
        0x09 => KeyCode::KeyV,
        0x0A => KeyCode::IntlBackslash,
        0x0B => KeyCode::KeyB,
        0x0C => KeyCode::KeyQ,
        0x0D => KeyCode::KeyW,
        0x0E => KeyCode::KeyE,
        0x0F => KeyCode::KeyR,
        0x10 => KeyCode::KeyY,
        0x11 => KeyCode::KeyT,
        0x12 => KeyCode::Digit1,
        0x13 => KeyCode::Digit2,
        0x14 => KeyCode::Digit3,
        0x15 => KeyCode::Digit4,
        0x16 => KeyCode::Digit6,
        0x17 => KeyCode::Digit5,
        0x18 => KeyCode::Equal,
        0x19 => KeyCode::Digit9,
        0x1A => KeyCode::Digit7,
        0x1B => KeyCode::Minus,
        0x1C => KeyCode::Digit8,
        0x1D => KeyCode::Digit0,
        0x1E => KeyCode::BracketRight,
        0x1F => KeyCode::KeyO,
        0x20 => KeyCode::KeyU,
        0x21 => KeyCode::BracketLeft,
        0x22 => KeyCode::KeyI,
        0x23 => KeyCode::KeyP,
        0x24 => KeyCode::Enter,
        0x25 => KeyCode::KeyL,
        0x26 => KeyCode::KeyJ,
        0x27 => KeyCode::Quote,
        0x28 => KeyCode::KeyK,
        0x29 => KeyCode::Semicolon,
        0x2A => KeyCode::Backslash,
        0x2B => KeyCode::Comma,
        0x2C => KeyCode::Slash,
        0x2D => KeyCode::KeyN,
        0x2E => KeyCode::KeyM,
        0x2F => KeyCode::Period,
        0x30 => KeyCode::Tab,
        0x31 => KeyCode::Space,
        0x32 => KeyCode::Backquote,
        0x33 => KeyCode::Backspace,
        0x35 => KeyCode::Escape,
        0x36 => KeyCode::SuperRight,
        0x37 => KeyCode::SuperLeft,
        0x38 => KeyCode::ShiftLeft,
        0x39 => KeyCode::CapsLock,
        0x3A => KeyCode::AltLeft,
        0x3B => KeyCode::ControlLeft,
        0x3C => KeyCode::ShiftRight,
        0x3D => KeyCode::AltRight,
        0x3E => KeyCode::ControlRight,
        0x3F => KeyCode::Fn,
        0x40 => KeyCode::F17,
        0x41 => KeyCode::NumpadDecimal,
        0x43 => KeyCode::NumpadMultiply,
        0x45 => KeyCode::NumpadAdd,
        0x47 => KeyCode::NumLock,
        0x48 => KeyCode::AudioVolumeUp,
        0x49 => KeyCode::AudioVolumeDown,
        0x4A => KeyCode::AudioVolumeMute,
        0x4B => KeyCode::NumpadDivide,
        0x4C => KeyCode::NumpadEnter,
        0x4E => KeyCode::NumpadSubtract,
        0x4F => KeyCode::F18,
        0x50 => KeyCode::F19,
        0x51 => KeyCode::NumpadEqual,
        0x52 => KeyCode::Numpad0,
        0x53 => KeyCode::Numpad1,
        0x54 => KeyCode::Numpad2,
        0x55 => KeyCode::Numpad3,
        0x56 => KeyCode::Numpad4,
        0x57 => KeyCode::Numpad5,
        0x58 => KeyCode::Numpad6,
        0x59 => KeyCode::Numpad7,
        0x5A => KeyCode::F20,
        0x5B => KeyCode::Numpad8,
        0x5C => KeyCode::Numpad9,
        0x5D => KeyCode::IntlYen,
        0x5E => KeyCode::IntlRo,
        0x5F => KeyCode::NumpadComma,
        0x60 => KeyCode::F5,
        0x61 => KeyCode::F6,
        0x62 => KeyCode::F7,
        0x63 => KeyCode::F3,
        0x64 => KeyCode::F8,
        0x65 => KeyCode::F9,
        0x66 => KeyCode::Lang2,
        0x67 => KeyCode::F11,
        0x68 => KeyCode::Lang1,
        0x69 => KeyCode::F13,
        0x6A => KeyCode::F16,
        0x6B => KeyCode::F14,
        0x6D => KeyCode::F10,
        0x6E => KeyCode::ContextMenu,
        0x6F => KeyCode::F12,
        0x71 => KeyCode::F15,
        0x72 => KeyCode::Insert,
        0x73 => KeyCode::Home,
        0x74 => KeyCode::PageUp,
        0x75 => KeyCode::Delete,
        0x76 => KeyCode::F4,
        0x77 => KeyCode::End,
        0x78 => KeyCode::F2,
        0x79 => KeyCode::PageDown,
        0x7A => KeyCode::F1,
        0x7B => KeyCode::ArrowLeft,
        0x7C => KeyCode::ArrowRight,
        0x7D => KeyCode::ArrowDown,
        0x7E => KeyCode::ArrowUp,
        _ => KeyCode::Unidentified,
    }
}

// Keys that have a name rather than a character.
pub enum Named {
    Enter,
    Tab,
    Backspace,
    Escape,
    Delete,
    Insert,
    Home,
    End,
    PageUp,
    PageDown,
    ArrowLeft,
    ArrowRight,
    ArrowUp,
    ArrowDown,
    Shift,
    Control,
    Alt,
    Super,
    CapsLock,
    Fn,
    ContextMenu,
    Clear,
}

// The logical key: what the key means in the current layout, without
// the modifiers' effect (`charactersIgnoringModifiers`): a named key, a
// function key F1..F35, or a character.
pub enum Logical {
    Named(Named),
    F(i64),
    Char(u32),
    Unidentified,
}

// The logical key for the first character macOS reports (its
// NSFunctionKey private-use range, control characters, or text).
pub fn mac_logical(c: u32, code: KeyCode) -> Logical {
    // Modifier keys report no character: name them by their key.
    match code {
        KeyCode::ShiftLeft => return Logical::Named(Named::Shift),
        KeyCode::ShiftRight => return Logical::Named(Named::Shift),
        KeyCode::ControlLeft => return Logical::Named(Named::Control),
        KeyCode::ControlRight => return Logical::Named(Named::Control),
        KeyCode::AltLeft => return Logical::Named(Named::Alt),
        KeyCode::AltRight => return Logical::Named(Named::Alt),
        KeyCode::SuperLeft => return Logical::Named(Named::Super),
        KeyCode::SuperRight => return Logical::Named(Named::Super),
        KeyCode::CapsLock => return Logical::Named(Named::CapsLock),
        KeyCode::Fn => return Logical::Named(Named::Fn),
        _ => {}
    }
    if c >= 0xF704 && c <= 0xF726 {
        return Logical::F((c - 0xF704 + 1) as i64);
    }
    match c {
        0 => Logical::Unidentified,
        0x03 => Logical::Named(Named::Enter),
        0x0D => Logical::Named(Named::Enter),
        0x09 => Logical::Named(Named::Tab),
        0x19 => Logical::Named(Named::Tab),
        0x08 => Logical::Named(Named::Backspace),
        0x7F => Logical::Named(Named::Backspace),
        0x1B => Logical::Named(Named::Escape),
        0xF700 => Logical::Named(Named::ArrowUp),
        0xF701 => Logical::Named(Named::ArrowDown),
        0xF702 => Logical::Named(Named::ArrowLeft),
        0xF703 => Logical::Named(Named::ArrowRight),
        0xF727 => Logical::Named(Named::Insert),
        0xF728 => Logical::Named(Named::Delete),
        0xF729 => Logical::Named(Named::Home),
        0xF72B => Logical::Named(Named::End),
        0xF72C => Logical::Named(Named::PageUp),
        0xF72D => Logical::Named(Named::PageDown),
        0xF735 => Logical::Named(Named::ContextMenu),
        0xF739 => Logical::Named(Named::Clear),
        0xF746 => Logical::Named(Named::Insert),
        _ => {
            if c >= 0xF700 && c < 0xF900 { Logical::Unidentified } else { Logical::Char(c) }
        }
    }
}

// Modifiers: left and right apart, and caps lock.
pub struct Mods {
    pub bits: u32,
}

pub const SHIFT_L: u32 = 1;
pub const SHIFT_R: u32 = 2;
pub const CTRL_L: u32 = 4;
pub const CTRL_R: u32 = 8;
pub const ALT_L: u32 = 16;
pub const ALT_R: u32 = 32;
pub const SUPER_L: u32 = 64;
pub const SUPER_R: u32 = 128;
pub const CAPS: u32 = 256;

impl Mods {
    pub fn none() -> Mods {
        Mods { bits: 0 }
    }

    pub fn shift(self: Mods) -> bool {
        (self.bits & (SHIFT_L | SHIFT_R)) != 0
    }

    pub fn ctrl(self: Mods) -> bool {
        (self.bits & (CTRL_L | CTRL_R)) != 0
    }

    pub fn alt(self: Mods) -> bool {
        (self.bits & (ALT_L | ALT_R)) != 0
    }

    pub fn sup(self: Mods) -> bool {
        (self.bits & (SUPER_L | SUPER_R)) != 0
    }

    pub fn caps(self: Mods) -> bool {
        (self.bits & CAPS) != 0
    }
}

// NSEventModifierFlags: device-independent bits, and the device bits
// (IOKit's NX_DEVICE*KEYMASK) that tell left from right. A flag without
// either device bit (a synthesized event) counts as the left key.
pub fn mac_mods(flags: u64) -> Mods {
    let mut b: u32 = 0;
    if (flags & (1 << 16)) != 0 {
        b = b | CAPS;
    }
    b = b | side(flags, 1 << 17, 0x02, 0x04, SHIFT_L, SHIFT_R);
    b = b | side(flags, 1 << 18, 0x01, 0x2000, CTRL_L, CTRL_R);
    b = b | side(flags, 1 << 19, 0x20, 0x40, ALT_L, ALT_R);
    b = b | side(flags, 1 << 20, 0x08, 0x10, SUPER_L, SUPER_R);
    Mods { bits: b }
}

fn side(flags: u64, any: u64, left: u64, right: u64, l: u32, r: u32) -> u32 {
    if (flags & any) == 0 {
        return 0;
    }
    let mut b: u32 = 0;
    if (flags & left) != 0 {
        b = b | l;
    }
    if (flags & right) != 0 {
        b = b | r;
    }
    if b == 0 { l } else { b }
}

// For flagsChanged: whether the modifier key `code` is now down.
pub fn mac_modifier_down(code: KeyCode, flags: u64) -> bool {
    let m = mac_mods(flags).bits;
    match code {
        KeyCode::ShiftLeft => (m & SHIFT_L) != 0,
        KeyCode::ShiftRight => (m & SHIFT_R) != 0,
        KeyCode::ControlLeft => (m & CTRL_L) != 0,
        KeyCode::ControlRight => (m & CTRL_R) != 0,
        KeyCode::AltLeft => (m & ALT_L) != 0,
        KeyCode::AltRight => (m & ALT_R) != 0,
        KeyCode::SuperLeft => (m & SUPER_L) != 0,
        KeyCode::SuperRight => (m & SUPER_R) != 0,
        KeyCode::CapsLock => (m & CAPS) != 0,
        KeyCode::Fn => (flags & (1 << 23)) != 0,
        _ => false,
    }
}

// The first code point of UTF-8 text (0 for none; U+FFFD for a bad
// sequence).
pub fn first_char(s: [u8]) -> u32 {
    if s.len == 0 {
        return 0;
    }
    let b = s[0] as u32;
    if b < 0x80 {
        return b;
    }
    let n = if b >= 0xF0 { 4 } else if b >= 0xE0 { 3 } else if b >= 0xC0 { 2 } else { 0 };
    if n == 0 || s.len < n {
        return 0xFFFD;
    }
    let mut c = b & (0x7F >> n);
    for i in 1..n {
        c = (c << 6) | (s[i] as u32 & 0x3F);
    }
    c
}

// The byte offset in UTF-8 text of a position counted in UTF-16 units
// (AppKit's ranges count UTF-16 units; the preedit cursor is reported in
// bytes). Past the end: the text's length.
pub fn utf16_to_byte(s: [u8], units: i64) -> i64 {
    let mut i = 0;
    let mut u = 0;
    while i < s.len && u < units {
        let b = s[i];
        let n = if b >= 0xF0 { 4 } else if b >= 0xE0 { 3 } else if b >= 0xC0 { 2 } else { 1 };
        u += if n == 4 { 2 } else { 1 };
        i += n;
    }
    if i > s.len { s.len } else { i }
}

// The end of the longest prefix of `s` that is at most `max` bytes and
// does not split a UTF-8 sequence (for text events' inline bytes).
pub fn utf8_cut(s: [u8], max: i64) -> i64 {
    if s.len <= max {
        return s.len;
    }
    let mut n = max;
    while n > 0 && (s[n] & 0xC0) == 0x80 {
        n -= 1;
    }
    n
}
