// std::window: windows and input (docs/design/terminal.md §2), winit's
// objects with a pull-model event loop. 0.23.0 has the Cocoa backend
// (cocoa.tach); Wayland and X11 come in 0.23.1 beside it, behind the same
// `Backend` trait. objc.tach is the Objective-C layer the backend calls
// until std::objc (0.22) replaces it; tables/ lists every method it
// calls, for objcgen's runtime check. A program that uses std::window
// links AppKit, QuartzCore, CoreFoundation, CoreGraphics and libobjc
// (tests/window/frameworks.c does it with LC_LINKER_OPTION until
// tachyonc takes -framework).
//
// Events are pulled (D1): `app.wait()` blocks until one is ready,
// `app.poll()` returns at once, `app.wait_timeout(ms)` waits at most that
// long. An event is a plain value; nothing allocates per event once the
// queue has grown to its working size. Frames come on request (D2):
// `win.request_frame()` asks for one `Event::Frame` at the next display
// refresh, and an idle application wakes up never. A watched file
// descriptor (D3) delivers `Event::Readable` from inside `wait`, which
// is how the terminal serves its pty before 0.21's threads.
//
// `App` and `Window` release their Cocoa objects when dropped; drop the
// windows before the App. The live-resize hook is a plain `fn(*u8)` with
// a context pointer (a closure once callbacks can borrow).

// ---- Windows and input (0.23) ----

pub mod cocoa;
pub mod keys;
mod objc;

use keys::{KeyCode, Logical, Mods};

pub struct WindowId {
    pub n: i64,
}

impl WindowId {
    pub fn eq(self, o: WindowId) -> bool {
        self.n == o.n
    }
}

// A size in physical pixels, and the scale from logical points (2.0 on
// a Retina display).
pub struct Size {
    pub w: i64,
    pub h: i64,
    pub scale: f64,
}

// A key press, repeat or release. `ime` is true when an input method
// took the key (composition in progress before or after it): a terminal
// does not encode it. `text_follows` is true when the key produced text,
// delivered by the `Event::Text` right after this event (a terminal
// sends the text, not an encoding of the key, unless it treats Option as
// Meta).
pub struct Key {
    pub win: WindowId,
    pub code: KeyCode,
    pub key: Logical,
    pub mods: Mods,
    pub pressed: bool,
    pub repeat: bool,
    pub ime: bool,
    pub text_follows: bool,
}

// Text typed or committed by an input method, its UTF-8 bytes inline
// (D4): a longer commit arrives as several events, never split inside a
// character. Its text is `t.bytes[0..t.len as i64]` (0.20: a Text is
// plain, so a method takes a copy of it and cannot return a view of its
// bytes).
pub struct Text {
    pub win: WindowId,
    pub len: u8,
    pub bytes: [u8; 30],
}

// The input method's composition changed: `app.preedit()` is its text
// (empty: composition ended), `cursor` a byte offset in it.
pub struct Preedit {
    pub win: WindowId,
    pub len: i64,
    pub cursor: i64,
}

pub enum Button {
    Left,
    Right,
    Middle,
    Other(i64),
    None,
}

pub enum MouseAction {
    Press,
    Release,
    Move,
}

// A mouse button or motion; the position is in physical pixels from the
// window's content top-left. `clicks` counts a double (2) or triple (3)
// click on presses.
pub struct Mouse {
    pub win: WindowId,
    pub action: MouseAction,
    pub button: Button,
    pub x: f64,
    pub y: f64,
    pub mods: Mods,
    pub clicks: i64,
}

// Scrolling: `precise` deltas are in physical pixels (a trackpad);
// otherwise in lines (a wheel). Positive dy scrolls up (content moves
// down), as AppKit and winit report it.
pub struct Scroll {
    pub win: WindowId,
    pub dx: f64,
    pub dy: f64,
    pub precise: bool,
    pub mods: Mods,
}

pub enum Event {
    // A frame asked for by `request_frame`: draw now.
    Frame(WindowId),
    Key(Key),
    Text(Text),
    Preedit(Preedit),
    // The content's new size (also its first size, after `window`).
    Resize(WindowId, Size),
    Mouse(Mouse),
    Scroll(Scroll),
    // The pointer entered (true) or left the window.
    Cursor(WindowId, bool),
    Focus(WindowId, bool),
    // A watched file descriptor is readable.
    Readable(i32),
    // The user asked to close the window (it stays open until `close`).
    Close(WindowId),
    // The user chose Quit (Command-Q).
    Quit,
}

pub enum Error {
    // No window server (a headless session, ssh).
    NoDisplay,
    Failed([u8]),
}

pub enum CursorIcon {
    Arrow,
    Text,
    Pointer,
}

pub struct WindowDesc {
    pub title: [u8],
    // Logical points.
    pub w: i64,
    pub h: i64,
    pub min_w: i64,
    pub min_h: i64,
    pub resizable: bool,
}

impl WindowDesc {
    pub fn new(title: [u8], w: i64, h: i64) -> WindowDesc {
        WindowDesc { title: title, w: w, h: h, min_w: 100, min_h: 60, resizable: true }
    }
}

// What each backend provides (D6). App and Window call the one the
// target's OS has, statically.
pub trait Backend {
    fn open_window(inout self, desc: WindowDesc, id: WindowId) -> Result<Window, Error>;
    fn next_event(inout self, ms: i64) -> Option<Event>;
    fn watch(inout self, fd: i32) -> bool;
    fn unwatch(inout self, fd: i32);
    fn clipboard_get_in<A: Allocator>(self, a: sink A) -> Option<Buf<A>>;
    fn clipboard_set(self, text: [u8]);
    fn preedit(self) -> [u8];
    fn set_live_resize(inout self, f: fn(*u8), ctx: *u8);
    fn close(inout self);
}

pub struct App {
    b: cocoa::Cocoa,
    next_id: i64,
}

impl App {
    // The application: on macOS, NSApplication without a bundle (a
    // regular app with a Dock icon and a menu with Quit). Err(NoDisplay)
    // when there is no window server.
    pub fn new_in(gpa: Gpa) -> Result<App, Error> {
        match cocoa::Cocoa::new_in(gpa) {
            Ok(b) => Ok(App { b: b, next_id: 1 }),
            Err(e) => Err(e),
        }
    }

    pub fn window(inout self, desc: WindowDesc) -> Result<Window, Error> {
        let id = WindowId { n: self.next_id };
        self.next_id += 1;
        self.b.open_window(desc, id)
    }

    // The next event, waiting as long as it takes.
    pub fn wait(inout self) -> Result<Event, Error> {
        loop {
            match self.b.next_event(-1) {
                Some(e) => return Ok(e),
                None => {}
            }
        }
    }

    // The next event if one is ready.
    pub fn poll(inout self) -> Option<Event> {
        self.b.next_event(0)
    }

    // The next event within `ms` milliseconds.
    pub fn wait_timeout(inout self, ms: i64) -> Option<Event> {
        self.b.next_event(if ms < 0 { 0 } else { ms })
    }

    // Delivers `Event::Readable(fd)` whenever `fd` has data, from inside
    // wait/poll (until `unwatch`). False if the fd cannot be watched.
    pub fn watch(inout self, fd: i32) -> bool {
        self.b.watch(fd)
    }

    pub fn unwatch(inout self, fd: i32) {
        self.b.unwatch(fd);
    }

    // The clipboard's text, in a Buf of `a` (a frame's ScopedArena for a
    // paste that is sent and forgotten).
    pub fn clipboard_get_in<A: Allocator>(self, a: sink A) -> Option<Buf<A>> {
        self.b.clipboard_get_in(a)
    }

    pub fn clipboard_set(self, text: [u8]) {
        self.b.clipboard_set(text);
    }

    // The input method's current composition (see Event::Preedit), a view
    // valid until the next event.
    pub fn preedit(self) -> [u8] {
        self.b.preedit()
    }

    // macOS runs a loop of its own while the user drags a window's edge,
    // so `wait` does not return until the drag ends. `f(ctx)` is called
    // for each size change during the drag: it can `poll` (only the
    // queued events are returned there) and draw. The one callback of the
    // API (terminal.md §2.1).
    pub fn on_live_resize(inout self, f: fn(*u8), ctx: *u8) {
        self.b.set_live_resize(f, ctx);
    }
}

// The application's state is released with it (its windows should be
// dropped first: they do not outlive the App).
impl Drop for App {
    fn drop(inout self) {
        self.b.close();
    }
}

// A window: its Cocoa objects, retained until it is dropped (or closed).
pub struct Window {
    pub id: WindowId,
    pub ns: cocoa::NsWindow,
}

impl Window {
    // One Event::Frame at the next refresh of the window's display.
    pub fn request_frame(self) {
        self.ns.request_frame();
    }

    pub fn size(self) -> Size {
        self.ns.size()
    }

    // The CAMetalLayer (on macOS) a GPU surface is made on.
    pub fn raw_surface(self) -> *u8 {
        self.ns.layer
    }

    pub fn set_title(self, t: [u8]) {
        self.ns.set_title(t);
    }

    pub fn set_cursor(self, c: CursorIcon) {
        self.ns.set_cursor(c);
    }

    // Hides the pointer until the mouse moves (while typing).
    pub fn hide_cursor_while_typing(self) {
        cocoa::hide_cursor_until_moved();
    }

    // Where the input method's candidate window goes: the text cursor's
    // rectangle in physical pixels from the content's top-left.
    pub fn set_ime_area(self, x: f64, y: f64, w: f64, h: f64) {
        self.ns.set_ime_area(x, y, w, h);
    }

    pub fn set_fullscreen(self, on: bool) {
        self.ns.set_fullscreen(on);
    }

    pub fn is_fullscreen(self) -> bool {
        self.ns.is_fullscreen()
    }

    pub fn focused(self) -> bool {
        self.ns.focused()
    }

    // Closes the window now (dropping it does the same).
    pub fn close(inout self) {
        self.ns.close();
    }
}

impl Drop for Window {
    fn drop(inout self) {
        self.ns.close();
    }
}
