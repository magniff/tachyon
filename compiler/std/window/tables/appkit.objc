# AppKit (and the Foundation classes it needs): what std::window's Cocoa
# backend calls (docs/design/terminal.md §2.3, task W1). Every method of
# compiler/std/window/cocoa.vl and of its tests (tests/window/main.vl) is here,
# with the C types its hand-typed objc_msgSend shape uses, so that
# `objcgen --check` proves those shapes against the runtime until the
# backend is generated from this table (when std::objc lands).
# The format: tools/objcgen's table format (g22, lib/objc/tables/README.md).
# Checked by objcgen --check (and --c-check); generated into the backend's
# bindings when std::objc lands.

framework Foundation
framework AppKit
header AppKit/AppKit.h
use crate::objc::foundation::{NSString, NSArray}

struct CGPoint { x: f64, y: f64 }
struct CGSize { width: f64, height: f64 }
struct CGRect { origin: CGPoint, size: CGSize }

# NSApplicationActivationPolicy
const NSApplicationActivationPolicyRegular: i64 = 0
# NSWindowStyleMask
const NSWindowStyleMaskTitled: u64 = 1
const NSWindowStyleMaskClosable: u64 = 2
const NSWindowStyleMaskMiniaturizable: u64 = 4
const NSWindowStyleMaskResizable: u64 = 8
const NSWindowStyleMaskFullScreen: u64 = 16384
# NSBackingStoreType
const NSBackingStoreBuffered: u64 = 2
const NSWindowCollectionBehaviorFullScreenPrimary: u64 = 128
# NSEventType
const NSEventTypeLeftMouseDown: u64 = 1
const NSEventTypeLeftMouseUp: u64 = 2
const NSEventTypeRightMouseDown: u64 = 3
const NSEventTypeRightMouseUp: u64 = 4
const NSEventTypeMouseMoved: u64 = 5
const NSEventTypeLeftMouseDragged: u64 = 6
const NSEventTypeRightMouseDragged: u64 = 7
const NSEventTypeKeyDown: u64 = 10
const NSEventTypeKeyUp: u64 = 11
const NSEventTypeApplicationDefined: u64 = 15
const NSEventTypeOtherMouseDown: u64 = 25
const NSEventTypeOtherMouseUp: u64 = 26
const NSEventTypeOtherMouseDragged: u64 = 27
# NSEventModifierFlags
const NSEventModifierFlagCapsLock: u64 = 65536
const NSEventModifierFlagShift: u64 = 131072
const NSEventModifierFlagControl: u64 = 262144
const NSEventModifierFlagOption: u64 = 524288
const NSEventModifierFlagCommand: u64 = 1048576
const NSEventModifierFlagFunction: u64 = 8388608
# NSTrackingAreaOptions
const NSTrackingMouseEnteredAndExited: u64 = 1
const NSTrackingMouseMoved: u64 = 2
const NSTrackingActiveAlways: u64 = 128
const NSTrackingInVisibleRect: u64 = 512

class NSResponder
  interpretKeyEvents:              (events: NSArray)
  respondsToSelector:              (s: sel) -> bool
  isKindOfClass:                   (c: class) -> bool

class NSApplication : NSResponder
  +sharedApplication               () -> NSApplication
  setActivationPolicy:             (policy: i64) -> bool
  finishLaunching                  ()
  activateIgnoringOtherApps:       (flag: bool)
  setMainMenu:                     (menu: NSMenu?)
  mainMenu                         () -> NSMenu?
  nextEventMatchingMask:untilDate:inMode:dequeue: (mask: u64, until: NSDate?, mode: NSString, dequeue: bool) -> NSEvent?
  sendEvent:                       (event: NSEvent)
  postEvent:atStart:               (event: NSEvent, at_start: bool)

class NSWindow : NSResponder
  +alloc                           () -> own NSWindow
  +setAllowsAutomaticWindowTabbing: (allow: bool)
  initWithContentRect:styleMask:backing:defer: (rect: CGRect, style: u64, backing: u64, defer_: bool) -> own NSWindow
  setReleasedWhenClosed:           (flag: bool)
  setContentView:                  (view: NSView?)
  contentView                      () -> NSView?
  setDelegate:                     (delegate: id?)
  setTitle:                        (title: NSString)
  setAcceptsMouseMovedEvents:      (flag: bool)
  setContentMinSize:               (size: CGSize)
  setContentSize:                  (size: CGSize)
  setCollectionBehavior:           (behavior: u64)
  center                           ()
  makeFirstResponder:              (responder: NSResponder?) -> bool
  makeKeyAndOrderFront:            (sender: id?)
  backingScaleFactor               () -> f64
  invalidateCursorRectsForView:    (view: NSView)
  styleMask                        () -> u64
  toggleFullScreen:                (sender: id?)
  isKeyWindow                      () -> bool
  close                            ()
  performClose:                    (sender: id?)
  convertRectToScreen:             (rect: CGRect) -> CGRect
  windowNumber                     () -> i64
  sendEvent:                       (event: NSEvent)

class NSView : NSResponder
  +alloc                           () -> own NSView
  initWithFrame:                   (frame: CGRect) -> own NSView
  setLayer:                        (layer: CALayer?)
  layer                            () -> CALayer?
  setWantsLayer:                   (flag: bool)
  window                           () -> NSWindow?
  bounds                           () -> CGRect
  convertPoint:fromView:           (p: CGPoint, view: NSView?) -> CGPoint
  convertRect:toView:              (r: CGRect, view: NSView?) -> CGRect
  addTrackingArea:                 (area: NSTrackingArea)
  addCursorRect:cursor:            (r: CGRect, cursor: NSCursor)
  inLiveResize                     () -> bool
  inputContext                     () -> NSTextInputContext?
  displayLinkWithTarget:selector:  (target: id, s: sel) -> CADisplayLink

class NSEvent
  type                             () -> u64
  keyCode                          () -> u16
  modifierFlags                    () -> u64
  isARepeat                        () -> bool
  charactersIgnoringModifiers      () -> NSString?
  locationInWindow                 () -> CGPoint
  buttonNumber                     () -> i64
  clickCount                       () -> i64
  scrollingDeltaX                  () -> f64
  scrollingDeltaY                  () -> f64
  hasPreciseScrollingDeltas        () -> bool
  data1                            () -> i64
  +otherEventWithType:location:modifierFlags:timestamp:windowNumber:context:subtype:data1:data2: (ty: u64, at: CGPoint, flags: u64, time: f64, win: i64, ctx: id?, sub: i16, d1: i64, d2: i64) -> NSEvent?
  +keyEventWithType:location:modifierFlags:timestamp:windowNumber:context:characters:charactersIgnoringModifiers:isARepeat:keyCode: (ty: u64, at: CGPoint, flags: u64, time: f64, win: i64, ctx: id?, chars: NSString, plain: NSString, repeat: bool, code: u16) -> NSEvent?
  +mouseEventWithType:location:modifierFlags:timestamp:windowNumber:context:eventNumber:clickCount:pressure: (ty: u64, at: CGPoint, flags: u64, time: f64, win: i64, ctx: id?, num: i64, clicks: i64, pressure: f32) -> NSEvent?
  +eventWithCGEvent:               (e: *u8) -> NSEvent?

class NSMenu
  +alloc                           () -> own NSMenu
  init                             () -> own NSMenu
  addItem:                         (item: NSMenuItem)
  itemAtIndex:                     (i: i64) -> NSMenuItem?
  performActionForItemAtIndex:     (i: i64)

class NSMenuItem
  +alloc                           () -> own NSMenuItem
  init                             () -> own NSMenuItem
  initWithTitle:action:keyEquivalent: (title: NSString, action: sel, key: NSString) -> own NSMenuItem
  setTarget:                       (target: id?)
  setSubmenu:                      (menu: NSMenu?)
  submenu                          () -> NSMenu?

class NSCursor
  +IBeamCursor                     () -> NSCursor
  +arrowCursor                     () -> NSCursor
  +pointingHandCursor              () -> NSCursor
  +setHiddenUntilMouseMoves:       (flag: bool)

class NSTrackingArea
  +alloc                           () -> own NSTrackingArea
  initWithRect:options:owner:userInfo: (r: CGRect, options: u64, owner: id?, info: id?) -> own NSTrackingArea

class NSPasteboard
  +generalPasteboard               () -> NSPasteboard
  clearContents                    () -> i64
  setString:forType:               (s: NSString, ty: NSString) -> bool
  stringForType:                   (ty: NSString) -> NSString?

class NSTextInputContext
  discardMarkedText                ()

class NSDate
  +distantFuture                   () -> NSDate
  +distantPast                     () -> NSDate
  +dateWithTimeIntervalSinceNow:   (seconds: f64) -> NSDate

class NSRunLoop
  +mainRunLoop                     () -> NSRunLoop

class NSAttributedString
  string                           () -> NSString

class NSNotification
  object                           () -> id?

class CALayer
class CADisplayLink
