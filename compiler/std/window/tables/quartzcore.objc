# Quartz Core: the CAMetalLayer std::window gives std::gpu as a surface,
# and the CADisplayLink of its frame clock (docs/design/terminal.md §2.1,
# §2.3; task W1). As appkit.objc: the hand-typed shapes of std::window and
# voltty's renderer are checked against these lines by
# `objcgen --check`. The format: tools/objcgen's table format (g22, lib/objc/tables/README.md).
# Checked by objcgen --check (and --c-check); generated into the backend's
# bindings when std::objc lands.

framework Foundation
framework QuartzCore
framework Metal
header QuartzCore/QuartzCore.h
use crate::objc::foundation::{NSString}

struct CGSize { width: f64, height: f64 }

class CALayer
  setContentsScale:                (scale: f64)

class CAMetalLayer : CALayer
  +layer                           () -> CAMetalLayer
  setDevice:                       (device: id?)
  setPixelFormat:                  (format: u64)
  setFramebufferOnly:              (flag: bool)
  setMaximumDrawableCount:         (n: u64)
  setDisplaySyncEnabled:           (flag: bool)
  setDrawableSize:                 (size: CGSize)
  nextDrawable                     () -> CAMetalDrawable?

protocol CAMetalDrawable
  texture                          () -> id

class CADisplayLink
  setPaused:                       (flag: bool)
  addToRunLoop:forMode:            (rl: NSRunLoop, mode: NSString)
  invalidate                       ()

class NSRunLoop
