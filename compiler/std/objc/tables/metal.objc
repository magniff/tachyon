# Metal: what std::gpu's Metal hal calls (docs/design/gpu.md, §2.8).
# Generated into compiler/std/gpu/hal/metal/bindings.vl by tools/objcgen; every method is
# checked against the runtime (objcgen --check), every constant and struct
# against the SDK's headers (objcgen --c-check), by tests/gpu/run.sh.
# The format: compiler/std/objc/tables/README.md.

framework Foundation
framework Metal
header Metal/Metal.h
framework QuartzCore
header QuartzCore/CAMetalLayer.h
use std::objc::foundation::{NSString, NSError, NSArray}

struct MTLOrigin { x: u64, y: u64, z: u64 }
struct MTLSize { width: u64, height: u64, depth: u64 }
struct MTLRegion { origin: MTLOrigin, size: MTLSize }
struct MTLClearColor { red: f64, green: f64, blue: f64, alpha: f64 }
struct MTLViewport { originX: f64, originY: f64, width: f64, height: f64, znear: f64, zfar: f64 }
struct MTLScissorRect { x: u64, y: u64, width: u64, height: u64 }
struct CGSize { width: f64, height: f64 }

# MTLResourceOptions
const MTLResourceStorageModeShared: u64 = 0
const MTLResourceStorageModePrivate: u64 = 32
const MTLResourceCPUCacheModeWriteCombined: u64 = 1
const MTLResourceHazardTrackingModeUntracked: u64 = 256
# MTLStorageMode
const MTLStorageModeShared: u64 = 0
const MTLStorageModePrivate: u64 = 2
# MTLTextureUsage
const MTLTextureUsageShaderRead: u64 = 1
const MTLTextureUsageShaderWrite: u64 = 2
const MTLTextureUsageRenderTarget: u64 = 4
const MTLTextureUsagePixelFormatView: u64 = 16
# MTLTextureType
const MTLTextureType2D: u64 = 2
const MTLTextureType2DArray: u64 = 3
# MTLPixelFormat
const MTLPixelFormatInvalid: u64 = 0
const MTLPixelFormatR8Unorm: u64 = 10
const MTLPixelFormatR8Uint: u64 = 13
const MTLPixelFormatR16Float: u64 = 25
const MTLPixelFormatRG8Unorm: u64 = 30
const MTLPixelFormatR32Uint: u64 = 53
const MTLPixelFormatR32Sint: u64 = 54
const MTLPixelFormatR32Float: u64 = 55
const MTLPixelFormatRG16Float: u64 = 65
const MTLPixelFormatRGBA8Unorm: u64 = 70
const MTLPixelFormatRGBA8Unorm_sRGB: u64 = 71
const MTLPixelFormatRGBA8Uint: u64 = 73
const MTLPixelFormatBGRA8Unorm: u64 = 80
const MTLPixelFormatBGRA8Unorm_sRGB: u64 = 81
const MTLPixelFormatRG32Float: u64 = 105
const MTLPixelFormatRGBA16Float: u64 = 115
const MTLPixelFormatRGBA32Uint: u64 = 123
const MTLPixelFormatRGBA32Float: u64 = 125
const MTLPixelFormatDepth32Float: u64 = 252
# MTLLoadAction, MTLStoreAction
const MTLLoadActionDontCare: u64 = 0
const MTLLoadActionLoad: u64 = 1
const MTLLoadActionClear: u64 = 2
const MTLStoreActionDontCare: u64 = 0
const MTLStoreActionStore: u64 = 1
# MTLPrimitiveType, MTLIndexType
const MTLPrimitiveTypePoint: u64 = 0
const MTLPrimitiveTypeLine: u64 = 1
const MTLPrimitiveTypeLineStrip: u64 = 2
const MTLPrimitiveTypeTriangle: u64 = 3
const MTLPrimitiveTypeTriangleStrip: u64 = 4
const MTLIndexTypeUInt16: u64 = 0
const MTLIndexTypeUInt32: u64 = 1
# samplers
const MTLSamplerMinMagFilterNearest: u64 = 0
const MTLSamplerMinMagFilterLinear: u64 = 1
const MTLSamplerMipFilterNotMipmapped: u64 = 0
const MTLSamplerMipFilterNearest: u64 = 1
const MTLSamplerMipFilterLinear: u64 = 2
const MTLSamplerAddressModeClampToEdge: u64 = 0
const MTLSamplerAddressModeMirrorClampToEdge: u64 = 1
const MTLSamplerAddressModeRepeat: u64 = 2
const MTLSamplerAddressModeMirrorRepeat: u64 = 3
const MTLSamplerAddressModeClampToZero: u64 = 4
const MTLCompareFunctionNever: u64 = 0
const MTLCompareFunctionLess: u64 = 1
const MTLCompareFunctionEqual: u64 = 2
const MTLCompareFunctionLessEqual: u64 = 3
const MTLCompareFunctionGreater: u64 = 4
const MTLCompareFunctionNotEqual: u64 = 5
const MTLCompareFunctionGreaterEqual: u64 = 6
const MTLCompareFunctionAlways: u64 = 7
# vertex input
const MTLVertexFormatUChar4Normalized: u64 = 9
const MTLVertexFormatFloat: u64 = 28
const MTLVertexFormatFloat2: u64 = 29
const MTLVertexFormatFloat3: u64 = 30
const MTLVertexFormatFloat4: u64 = 31
const MTLVertexFormatInt: u64 = 32
const MTLVertexFormatUInt: u64 = 36
const MTLVertexFormatUInt2: u64 = 37
const MTLVertexFormatUInt4: u64 = 39
const MTLVertexStepFunctionPerVertex: u64 = 1
const MTLVertexStepFunctionPerInstance: u64 = 2
# blending
const MTLBlendFactorZero: u64 = 0
const MTLBlendFactorOne: u64 = 1
const MTLBlendFactorSourceColor: u64 = 2
const MTLBlendFactorOneMinusSourceColor: u64 = 3
const MTLBlendFactorSourceAlpha: u64 = 4
const MTLBlendFactorOneMinusSourceAlpha: u64 = 5
const MTLBlendFactorDestinationColor: u64 = 6
const MTLBlendFactorOneMinusDestinationColor: u64 = 7
const MTLBlendFactorDestinationAlpha: u64 = 8
const MTLBlendFactorOneMinusDestinationAlpha: u64 = 9
const MTLBlendOperationAdd: u64 = 0
const MTLBlendOperationSubtract: u64 = 1
const MTLBlendOperationReverseSubtract: u64 = 2
const MTLBlendOperationMin: u64 = 3
const MTLBlendOperationMax: u64 = 4
const MTLColorWriteMaskAll: u64 = 15
const MTLCullModeNone: u64 = 0
const MTLCullModeFront: u64 = 1
const MTLCullModeBack: u64 = 2
const MTLWindingClockwise: u64 = 0
const MTLWindingCounterClockwise: u64 = 1
# misc
const MTLLanguageVersion3_0: u64 = 196608
const MTLCommandBufferStatusCompleted: u64 = 4
const MTLCommandBufferStatusError: u64 = 5
const MTLBarrierScopeBuffers: u64 = 1
const MTLBarrierScopeTextures: u64 = 2

protocol MTLDevice
  name                                           () -> NSString
  registryID                                     () -> u64
  hasUnifiedMemory                               () -> bool
  isLowPower                                     () -> bool
  maxThreadsPerThreadgroup                       () -> MTLSize
  maxThreadgroupMemoryLength                     () -> u64
  maxBufferLength                                () -> u64
  recommendedMaxWorkingSetSize                   () -> u64
  supportsFamily:                                (family: i64) -> bool
  newCommandQueue                                () -> own MTLCommandQueue?
  newBufferWithLength:options:                   (length: u64, options: u64) -> own MTLBuffer?
  newBufferWithBytes:length:options:             (bytes: *u8, length: u64, options: u64) -> own MTLBuffer?
  newTextureWithDescriptor:                      (desc: MTLTextureDescriptor) -> own MTLTexture?
  newSamplerStateWithDescriptor:                 (desc: MTLSamplerDescriptor) -> own MTLSamplerState?
  newLibraryWithSource:options:error:            (source: NSString, options: MTLCompileOptions?, error: *u8) -> own MTLLibrary?
  newComputePipelineStateWithFunction:error:     (function: MTLFunction, error: *u8) -> own MTLComputePipelineState?
  newRenderPipelineStateWithDescriptor:error:    (desc: MTLRenderPipelineDescriptor, error: *u8) -> own MTLRenderPipelineState?
  newDepthStencilStateWithDescriptor:            (desc: MTLDepthStencilDescriptor) -> own MTLDepthStencilState?
  newSharedEvent                                 () -> own MTLSharedEvent?

protocol MTLResource
  label                                          () -> NSString?
  setLabel:                                      (label: NSString?)
  storageMode                                    () -> u64

protocol MTLBuffer : MTLResource
  contents                                       () -> *u8
  length                                         () -> u64

protocol MTLTexture : MTLResource
  width                                          () -> u64
  height                                         () -> u64
  depth                                          () -> u64
  arrayLength                                    () -> u64
  mipmapLevelCount                               () -> u64
  pixelFormat                                    () -> u64
  textureType                                    () -> u64
  usage                                          () -> u64
  replaceRegion:mipmapLevel:withBytes:bytesPerRow:  (region: MTLRegion, level: u64, bytes: *u8, bytes_per_row: u64)
  getBytes:bytesPerRow:fromRegion:mipmapLevel:      (bytes: *u8, bytes_per_row: u64, region: MTLRegion, level: u64)
  newTextureViewWithPixelFormat:                 (format: u64) -> own MTLTexture?

protocol MTLSamplerState
  label                                          () -> NSString?

protocol MTLLibrary
  newFunctionWithName:                           (name: NSString) -> own MTLFunction?
  functionNames                                  () -> NSArray

protocol MTLFunction
  name                                           () -> NSString
  functionType                                   () -> u64

protocol MTLComputePipelineState
  maxTotalThreadsPerThreadgroup                  () -> u64
  threadExecutionWidth                           () -> u64
  staticThreadgroupMemoryLength                  () -> u64

protocol MTLRenderPipelineState
  label                                          () -> NSString?

protocol MTLDepthStencilState
  label                                          () -> NSString?

protocol MTLEvent
  label                                          () -> NSString?

protocol MTLSharedEvent : MTLEvent
  signaledValue                                  () -> u64

protocol MTLCommandQueue
  device                                         () -> MTLDevice
  label                                          () -> NSString?
  setLabel:                                      (label: NSString?)
  commandBuffer                                  () -> MTLCommandBuffer?
  commandBufferWithUnretainedReferences          () -> MTLCommandBuffer?

protocol MTLCommandBuffer
  setLabel:                                      (label: NSString?)
  computeCommandEncoder                          () -> MTLComputeCommandEncoder?
  renderCommandEncoderWithDescriptor:            (desc: MTLRenderPassDescriptor) -> MTLRenderCommandEncoder?
  blitCommandEncoder                             () -> MTLBlitCommandEncoder?
  encodeSignalEvent:value:                       (event: MTLEvent, value: u64)
  commit                                         ()
  waitUntilScheduled                             ()
  waitUntilCompleted                             ()
  status                                         () -> u64
  error                                          () -> NSError?
  presentDrawable:                               (drawable: MTLDrawable)
  GPUStartTime                                   () -> f64 as gpu_start_time
  GPUEndTime                                     () -> f64 as gpu_end_time

protocol MTLCommandEncoder
  setLabel:                                      (label: NSString?)
  endEncoding                                    ()
  pushDebugGroup:                                (name: NSString)
  popDebugGroup                                  ()

protocol MTLComputeCommandEncoder : MTLCommandEncoder
  setComputePipelineState:                       (state: MTLComputePipelineState)
  setBuffer:offset:atIndex:                      (buffer: MTLBuffer?, offset: u64, index: u64)
  setBufferOffset:atIndex:                       (offset: u64, index: u64) as set_buffer_offset_only
  setBytes:length:atIndex:                       (bytes: *u8, length: u64, index: u64)
  setTexture:atIndex:                            (texture: MTLTexture?, index: u64)
  setSamplerState:atIndex:                       (sampler: MTLSamplerState?, index: u64)
  setThreadgroupMemoryLength:atIndex:            (length: u64, index: u64)
  dispatchThreadgroups:threadsPerThreadgroup:    (groups: MTLSize, threads: MTLSize)
  dispatchThreads:threadsPerThreadgroup:         (threads: MTLSize, group: MTLSize)
  memoryBarrierWithScope:                        (scope: u64)

protocol MTLRenderCommandEncoder : MTLCommandEncoder
  setRenderPipelineState:                        (state: MTLRenderPipelineState)
  setVertexBuffer:offset:atIndex:                (buffer: MTLBuffer?, offset: u64, index: u64)
  setFragmentBuffer:offset:atIndex:              (buffer: MTLBuffer?, offset: u64, index: u64)
  setVertexBufferOffset:atIndex:                 (offset: u64, index: u64) as set_vertex_buffer_offset_only
  setFragmentBufferOffset:atIndex:               (offset: u64, index: u64) as set_fragment_buffer_offset_only
  setVertexBytes:length:atIndex:                 (bytes: *u8, length: u64, index: u64)
  setFragmentBytes:length:atIndex:               (bytes: *u8, length: u64, index: u64)
  setVertexTexture:atIndex:                      (texture: MTLTexture?, index: u64)
  setFragmentTexture:atIndex:                    (texture: MTLTexture?, index: u64)
  setVertexSamplerState:atIndex:                 (sampler: MTLSamplerState?, index: u64)
  setFragmentSamplerState:atIndex:               (sampler: MTLSamplerState?, index: u64)
  setViewport:                                   (viewport: MTLViewport)
  setScissorRect:                                (rect: MTLScissorRect)
  setBlendColorRed:green:blue:alpha:             (red: f32, green: f32, blue: f32, alpha: f32)
  setDepthStencilState:                          (state: MTLDepthStencilState?)
  setStencilReferenceValue:                      (value: u32)
  setCullMode:                                   (mode: u64)
  setFrontFacingWinding:                         (winding: u64)
  drawPrimitives:vertexStart:vertexCount:instanceCount:baseInstance:  (primitive: u64, start: u64, count: u64, instances: u64, base_instance: u64)
  drawIndexedPrimitives:indexCount:indexType:indexBuffer:indexBufferOffset:instanceCount:baseVertex:baseInstance:  (primitive: u64, count: u64, index_type: u64, buffer: MTLBuffer, offset: u64, instances: u64, base_vertex: i64, base_instance: u64)

protocol MTLBlitCommandEncoder : MTLCommandEncoder
  copyFromBuffer:sourceOffset:toBuffer:destinationOffset:size:  (src: MTLBuffer, src_offset: u64, dst: MTLBuffer, dst_offset: u64, size: u64)
  copyFromTexture:sourceSlice:sourceLevel:sourceOrigin:sourceSize:toBuffer:destinationOffset:destinationBytesPerRow:destinationBytesPerImage:  (src: MTLTexture, slice: u64, level: u64, origin: MTLOrigin, size: MTLSize, dst: MTLBuffer, dst_offset: u64, bytes_per_row: u64, bytes_per_image: u64) as copy_texture_to_buffer
  copyFromBuffer:sourceOffset:sourceBytesPerRow:sourceBytesPerImage:sourceSize:toTexture:destinationSlice:destinationLevel:destinationOrigin:  (src: MTLBuffer, src_offset: u64, bytes_per_row: u64, bytes_per_image: u64, size: MTLSize, dst: MTLTexture, slice: u64, level: u64, origin: MTLOrigin) as copy_buffer_to_texture
  copyFromTexture:sourceSlice:sourceLevel:sourceOrigin:sourceSize:toTexture:destinationSlice:destinationLevel:destinationOrigin:  (src: MTLTexture, src_slice: u64, src_level: u64, src_origin: MTLOrigin, size: MTLSize, dst: MTLTexture, dst_slice: u64, dst_level: u64, dst_origin: MTLOrigin) as copy_texture_to_texture
  generateMipmapsForTexture:                     (texture: MTLTexture)

class MTLCompileOptions
  +new                                           () -> own MTLCompileOptions
  setLanguageVersion:                            (version: u64)

class MTLTextureDescriptor
  +new                                           () -> own MTLTextureDescriptor
  setTextureType:                                (kind: u64)
  setPixelFormat:                                (format: u64)
  setWidth:                                      (width: u64)
  setHeight:                                     (height: u64)
  setDepth:                                      (depth: u64)
  setMipmapLevelCount:                           (count: u64)
  setArrayLength:                                (length: u64)
  setSampleCount:                                (count: u64)
  setUsage:                                      (usage: u64)
  setStorageMode:                                (mode: u64)

class MTLSamplerDescriptor
  +new                                           () -> own MTLSamplerDescriptor
  setMinFilter:                                  (filter: u64)
  setMagFilter:                                  (filter: u64)
  setMipFilter:                                  (filter: u64)
  setSAddressMode:                               (mode: u64) as set_s_address_mode
  setTAddressMode:                               (mode: u64) as set_t_address_mode
  setRAddressMode:                               (mode: u64) as set_r_address_mode
  setCompareFunction:                            (function: u64)
  setMaxAnisotropy:                              (max: u64)
  setLodMinClamp:                                (lod: f32)
  setLodMaxClamp:                                (lod: f32)
  setNormalizedCoordinates:                      (normalized: bool)

class MTLRenderPassDescriptor
  +new                                           () -> own MTLRenderPassDescriptor
  colorAttachments                               () -> MTLRenderPassColorAttachmentDescriptorArray
  depthAttachment                                () -> MTLRenderPassDepthAttachmentDescriptor

class MTLRenderPassColorAttachmentDescriptorArray
  objectAtIndexedSubscript:                      (index: u64) -> MTLRenderPassColorAttachmentDescriptor

class MTLRenderPassAttachmentDescriptor
  setTexture:                                    (texture: MTLTexture?)
  setLevel:                                      (level: u64)
  setSlice:                                      (slice: u64)
  setLoadAction:                                 (action: u64)
  setStoreAction:                                (action: u64)
  setResolveTexture:                             (texture: MTLTexture?)

class MTLRenderPassColorAttachmentDescriptor : MTLRenderPassAttachmentDescriptor
  setClearColor:                                 (color: MTLClearColor)

class MTLRenderPassDepthAttachmentDescriptor : MTLRenderPassAttachmentDescriptor
  setClearDepth:                                 (depth: f64)

class MTLRenderPipelineDescriptor
  +new                                           () -> own MTLRenderPipelineDescriptor
  setLabel:                                      (label: NSString?)
  setVertexFunction:                             (function: MTLFunction?)
  setFragmentFunction:                           (function: MTLFunction?)
  setVertexDescriptor:                           (desc: MTLVertexDescriptor?)
  colorAttachments                               () -> MTLRenderPipelineColorAttachmentDescriptorArray
  setDepthAttachmentPixelFormat:                 (format: u64)
  setRasterSampleCount:                          (count: u64)

class MTLRenderPipelineColorAttachmentDescriptorArray
  objectAtIndexedSubscript:                      (index: u64) -> MTLRenderPipelineColorAttachmentDescriptor

class MTLRenderPipelineColorAttachmentDescriptor
  setPixelFormat:                                (format: u64)
  setBlendingEnabled:                            (enabled: bool)
  setSourceRGBBlendFactor:                       (factor: u64) as set_source_rgb_blend_factor
  setDestinationRGBBlendFactor:                  (factor: u64) as set_destination_rgb_blend_factor
  setRgbBlendOperation:                          (op: u64)
  setSourceAlphaBlendFactor:                     (factor: u64)
  setDestinationAlphaBlendFactor:                (factor: u64)
  setAlphaBlendOperation:                        (op: u64)
  setWriteMask:                                  (mask: u64)

class MTLVertexDescriptor
  +new                                           () -> own MTLVertexDescriptor
  attributes                                     () -> MTLVertexAttributeDescriptorArray
  layouts                                        () -> MTLVertexBufferLayoutDescriptorArray

class MTLVertexAttributeDescriptorArray
  objectAtIndexedSubscript:                      (index: u64) -> MTLVertexAttributeDescriptor

class MTLVertexAttributeDescriptor
  setFormat:                                     (format: u64)
  setOffset:                                     (offset: u64)
  setBufferIndex:                                (index: u64)

class MTLVertexBufferLayoutDescriptorArray
  objectAtIndexedSubscript:                      (index: u64) -> MTLVertexBufferLayoutDescriptor

class MTLVertexBufferLayoutDescriptor
  setStride:                                     (stride: u64)
  setStepFunction:                               (function: u64)
  setStepRate:                                   (rate: u64)

class MTLDepthStencilDescriptor
  +new                                           () -> own MTLDepthStencilDescriptor
  setDepthCompareFunction:                       (function: u64)
  setDepthWriteEnabled:                          (enabled: bool)

# Presentation (surfaces): QuartzCore's Metal layer and its drawables.
protocol MTLDrawable
  present                                        ()

protocol CAMetalDrawable : MTLDrawable
  texture                                        () -> MTLTexture

class CAMetalLayer
  +layer                                         () -> CAMetalLayer
  setDevice:                                     (device: MTLDevice?)
  setPixelFormat:                                (format: u64)
  setDrawableSize:                               (size: CGSize)
  drawableSize                                   () -> CGSize
  setFramebufferOnly:                            (only: bool)
  setMaximumDrawableCount:                       (count: u64)
  setDisplaySyncEnabled:                         (enabled: bool)
  nextDrawable                                   () -> CAMetalDrawable?
