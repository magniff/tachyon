# Foundation: the classes std::objc itself needs (strings, errors,
# exceptions, NSObject's retain count for the tests).
# Generated into compiler/std/objc/foundation.tach by tools/objcgen.

framework Foundation
header Foundation/Foundation.h

const NSUTF8StringEncoding: u64 = 4

class NSObject
  retainCount                      () -> u64
  description                      () -> NSString

class NSString : NSObject
  +alloc                           () -> own NSString
  initWithBytes:length:encoding:   (bytes: *u8, length: u64, encoding: u64) -> own NSString?
  UTF8String                       () -> *u8
  length                           () -> u64

class NSError : NSObject
  localizedDescription             () -> NSString
  code                             () -> i64
  domain                           () -> NSString

class NSException : NSObject
  name                             () -> NSString
  reason                           () -> NSString?

class NSArray : NSObject
  count                            () -> u64
  objectAtIndex:                   (index: u64) -> id
