// ---- Non-null pointers (0.18) ----

// A pointer that is never null (docs/design/contracts-verification.md
// §2.11): a distinct type over `*T`, so `p as *T` and `q as NonNull<T>`
// convert for free (the invariant checks the second). `Option<NonNull<T>>`
// is one pointer, None the null one, as C's nullable pointers are (the
// null niche, front/distinct.tach); an `extern "C"` signature may take
// either. Dereferencing stays unsafe, as for any raw pointer: NonNull is
// for pointers that are stored (the fields of unsafe data structures) and
// for C. `*T` has `is_null()`.
pub type NonNull<T> = distinct *T invariant self as u64 != 0 else "null pointer made NonNull";

impl<T> NonNull<T> {
    // p, unless it is null (`mut`: a raw pointer, which may be null, not
    // a borrow).
    pub fn new(mut p: *T) -> Option<NonNull<T>> {
        if p as u64 == 0 { Option::None } else { Option::Some(p as NonNull<T>) }
    }

    // The pointer, as a raw one.
    pub fn as_ptr(self: NonNull<T>) -> *T {
        self as *T
    }
}
