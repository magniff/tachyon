// ---- Non-null pointers (0.18) ----

// A pointer that is never null (docs/design/contracts-verification.md
// §2.11, 0.18 T4): `Option<NonNull<T>>` is one pointer, None the null
// one, as C's nullable pointers are. Phase 0: `distinct` is read as a
// transparent alias and the invariant is not checked; T4 makes it a type
// of its own with `NonNull::new`, `as_ptr` and the niche.
pub type NonNull<T> = distinct *T invariant self as u64 != 0 else "null pointer made NonNull";
