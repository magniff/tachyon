// std::ops: the operator traits (0.20: from std.tach).

// ---- Traits (0.9) ----

// The operators: `a + b` on a type implementing Add is `a.add(b)`, and so
// on; `-a` is `a.neg()`; `a == b` is `a.eq(&b)` (an impl wins over the
// structural ==); `a < b` is `a.cmp(&b) < 0`. Numbers implement them all
// without impl blocks, every type with == implements Eq, and numbers,
// pointers and fieldless enums Ord.
pub trait Add { fn add(self: Self, other: Self) -> Self; }
pub trait Sub { fn sub(self: Self, other: Self) -> Self; }
pub trait Mul { fn mul(self: Self, other: Self) -> Self; }
pub trait Div { fn div(self: Self, other: Self) -> Self; }
pub trait Neg { fn neg(self: Self) -> Self; }
