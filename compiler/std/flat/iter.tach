// ---- Iterators (0.14) ----
//
// compiler/std/embed.sh appends this file to std.tach: the same module,
// `std`. The Iterator trait (in the prelude), its sources and adapters;
// `for x in it` iterates any type implementing it
// (docs/design/closures-iterators.md).
//
// Every method is #[inline], so that a chain becomes one loop: the
// consumers are written on `fold`, and the sources and adapters override
// `fold` with a counted loop (internal iteration). `exact_len` and `at`
// let zip and enumerate index both sides when they know their length.

// ---- Slices (0.16) ----

impl<T>[T] {
    // Element i, or None when i is out of bounds (0.16: `s[i]` stops the
    // program then, this does not).
    #[inline]
    pub fn get(self: [T], i: i64) -> Option<T> {
        if (i as u64) >= (self.len as u64) {
            return Option::None;
        }
        Option::Some(unsafe { self.ptr[i] })
    }
}
