// ---- The fuzzer's implementation (0.18) ----

// `#[fuzz]` functions (docs/design/contracts-verification.md §2.8, 0.18
// T3): a property whose choice sequence is an input's bytes, one choice
// per byte. `volec fuzz NAME` runs it on inputs it mutates and keeps
// those that reach new code (--coverage's counters, below); `volec
// test` runs it as a property and on its saved inputs. A `[u8]`
// parameter is the input itself (gen_bytes).

// Coverage counters (T3, --coverage): the compiler (middle/coverage.vl)
// makes each block of the program count in COVERAGE_MAP as it runs.
pub static var COVERAGE_MAP: [u8; 65536] = [0; 65536];

// The counters (all zero in a program built without --coverage).
pub fn coverage() -> [u8] {
    COVERAGE_MAP[0..65536]
}

pub fn coverage_reset() {
    for i in 0..65536 {
        COVERAGE_MAP[i] = 0;
    }
}

extern "C" {
    #[link_name = "time"]
    #[effects(io)]
    fn fuzz_time(t: *i64) -> i64;
}

// An input's bytes: all of them when the choices are an input's
// (fuzzing, a saved input), else a generated text of bytes.
pub fn gen_bytes(g: inout Gen) -> Vec<u8> {
    var v: Vec<u8> = Vec::new_in(g.gpa);
    if g.raw {
        while g.at < g.count {
            v.push(g.draw() as u8);
        }
        return v;
    }
    while g.more(v.len()) {
        v.push(g.draw() as u8);
    }
    v
}

// A run of one input in a child process: its status, the choices it used,
// and (when it returned) its coverage, into `cov`.
fn fuzz_exec<F: Fn(inout Gen)>(f: F, gpa: Gpa, input: Vec<u64>, cov: [u8]) -> CaseRun {
    var fds = [0 as i32, 0 as i32];
    var cfds = [0 as i32, 0 as i32];
    if unsafe { pipe(&fds[0]) } != 0 || unsafe { pipe(&cfds[0]) } != 0 {
        eprintln("vole-test: cannot make a pipe");
        unsafe { exit(2) };
    }
    let pid = unsafe { fork() };
    if pid == 0 {
        unsafe { close(fds[0]) };
        unsafe { close(cfds[0]) };
        let null = unsafe { open(c"/dev/null", 1) };
        unsafe { dup2(null, 1) };
        unsafe { dup2(null, 2) };
        test_running();
        coverage_reset();
        let s = input.as_slice();
        var g = Gen {
            choices: s.ptr, count: s.len, at: 0, size: 64, gpa: gpa, depth: 0, showing: false,
            report: fds[1], raw: true,
        };
        // (0.18 with 0.17's drops: the case's values are dropped by now, so
        // a block it allocated and left is a leak; --check-alloc)
        let mark = check_alloc_mark();
        f(&g);
        if check_alloc_leaks_since(mark) > 0 {
            unsafe { test_exit_now(101) };
        }
        unsafe { write(cfds[1], &COVERAGE_MAP[0], 65536) };
        unsafe { test_exit_now(0) };
    }
    unsafe { close(fds[1]) };
    unsafe { close(cfds[1]) };
    var used: i64 = -1;
    let n = unsafe { read(fds[0], &used as *u8, 8) };
    unsafe { close(fds[0]) };
    var got = 0;
    for i in 0..65536 {
        cov[i] = 0;
    }
    loop {
        let k = unsafe { read(cfds[0], &cov[got], (65536 - got) as u64) };
        if k <= 0 {
            break;
        }
        got += k;
        if got >= 65536 {
            break;
        }
    }
    unsafe { close(cfds[0]) };
    var status = 0 as i32;
    unsafe { waitpid(pid, &status, 0) };
    let st = status as i64;
    let code = if (st & 127) == 0 { ((st >> 8) & 255) as i32 } else { 128 + (st & 127) as i32 };
    CaseRun { status: code, used: if n == 8 && used >= 0 { used } else { input.len() } }
}

// AFL's buckets of a count: 1, 2, 3, 4-7, 8-15, 16-31, 32-127, 128-255.
fn fuzz_bucket(c: u8) -> u8 {
    if c == 0 { 0 } else if c == 1 { 1 } else if c == 2 { 2 } else if c == 3 { 4 }
    else if c < 8 { 8 } else if c < 16 { 16 } else if c < 32 { 32 } else if c < 128 { 64 }
    else { 128 }
}

// Whether `cov` reaches a block (or a block's count) `seen` has not seen;
// `seen` takes it in.
fn fuzz_new_coverage(cov: [u8], seen: [u8]) -> bool {
    var new = false;
    for i in 0..65536 {
        let c = cov[i];
        if c != 0 {
            let b = fuzz_bucket(c);
            if (b & ~seen[i]) != 0 {
                seen[i] = seen[i] | b;
                new = true;
            }
        }
    }
    new
}

// The program's text constants a mutation may put in an input (the
// compiler gives them, front/tests).
static var FUZZ_WORDS: [[u8]; 64] = [""; 64];
static var FUZZ_WORD_COUNT: i64 = 0;

pub fn fuzz_word(w: [u8]) {
    if FUZZ_WORD_COUNT < 64 && w.len > 0 && w.len <= 32 {
        FUZZ_WORDS[FUZZ_WORD_COUNT] = w;
        FUZZ_WORD_COUNT += 1;
    }
}

// One mutation of `v` (bytes as choices), from the random state; `other`
// is another input of the corpus (for a splice).
fn fuzz_mutate(v: inout Vec<u64>, other: Vec<u64>, state: inout u64) {
    let len = v.len();
    let r = test_next(&state);
    let how = r % 10;
    let at = if len > 0 { ((r >> 8) % len as u64) as i64 } else { 0 };
    if len == 0 || how == 0 {
        // a byte inserted
        let b = test_next(&state) % 256;
        if len >= 4096 {
            return;
        }
        &v.insert(if len > 0 { at } else { 0 }, b);
    } else if how == 1 {
        // a bit flipped
        &v.set(at, v.get(at) ^ (1 << (test_next(&state) % 8)));
    } else if how == 2 {
        let interesting: [u64; 10] = [0, 1, 0x7f, 0x80, 0xff, 48, 97, 32, 10, 255];
        &v.set(at, interesting[(test_next(&state) % 10) as i64]);
    } else if how == 3 {
        &v.set(at, test_next(&state) % 256);
    } else if how == 4 {
        // a run deleted
        let n = 1 + (test_next(&state) % 4) as i64;
        var k = 0;
        while k < n && at < v.len() {
            &v.remove(at);
            k += 1;
        }
    } else if how == 5 {
        // a byte changed by a little
        let d = test_next(&state) % 16;
        &v.set(at, (v.get(at) + d + 240) % 256);
    } else if how == 6 && other.len() > 0 {
        // a splice: this input's start, the other's end
        let cut = (test_next(&state) % other.len() as u64) as i64;
        v.truncate(at);
        for i in cut..other.len() {
            if v.len() < 4096 {
                v.push(other.get(i));
            }
        }
    } else if how == 7 && FUZZ_WORD_COUNT > 0 {
        // a text constant of the program
        let w = FUZZ_WORDS[(test_next(&state) % FUZZ_WORD_COUNT as u64) as i64];
        for i in 0..w.len {
            if v.len() < 4096 {
                &v.insert(at + i, w[i] as u64);
            }
        }
    } else if how == 8 && len < 4096 {
        // a run repeated
        let n = 1 + (test_next(&state) % 8) as i64;
        var k = 0;
        while k < n && at + k < len && v.len() < 4096 {
            let to = if at + n + k < v.len() { at + n + k } else { v.len() };
            &v.insert(to, v.get(at + k));
            k += 1;
        }
    } else {
        &v.set(at, test_next(&state) % 256);
    }
}

fn fuzz_hash(v: Vec<u64>) -> u64 {
    var h: u64 = 14695981039346656037;
    for i in 0..v.len() {
        h = (h ^ v.get(i)) * 1099511628211;
    }
    h
}

// Input v saved as DIR/PREFIXHASH (bytes): its path.
fn fuzz_save(gpa: Gpa, v: Vec<u64>, prefix: [u8]) -> Buf {
    var path = Buf::new_in(gpa);
    if TEST_FUZZ_DIR != 0 as *u8 {
        unsafe { path.push_cstr(TEST_FUZZ_DIR) };
        path.push('/');
    }
    path.push_str(prefix);
    let h = fuzz_hash(v);
    let digits = "0123456789abcdef";
    for k in 0..16 {
        path.push(digits[((h >> (60 - 4 * k as u64)) & 15) as i64]);
    }
    var bytes = Buf::new_in(gpa);
    for i in 0..v.len() {
        bytes.push(v.get(i) as u8);
    }
    var c = Buf::new_in(gpa);
    c.push_str(path.as_slice());
    c.push(0);
    unsafe { test_write_file(c.as_slice().ptr, bytes.as_slice()) };
    c.free();
    bytes.free();
    path
}

unsafe fn fuzz_load(gpa: Gpa, path: *u8, into: *Vec<u64>) -> bool {
    var b = Buf::new_in(gpa);
    let ok = test_read_file(path, &b);
    into.clear();
    let s = b.as_slice();
    for i in 0..s.len {
        into.push(s[i] as u64);
    }
    b.free();
    ok
}

// A failing input: shrunk, saved, replayed with its inputs printed; exit 1.
fn fuzz_failed<F: Fn(inout Gen)>(f: F, gpa: Gpa, input: inout Vec<u64>, runs: i64) -> ! {
    TEST_RAW = true;
    let steps = test_shrink(f, gpa, &input, 64);
    let path = fuzz_save(gpa, input, "crash-");
    println(
        f"vole-test: property after {runs} runs, shrunk in {steps} {if steps == 1 { "step" } else { "steps" }}");
    println(f"vole-test: saved {path.as_slice()}");
    test_case(f, gpa, input, 64, false);
    test_exit(1)
}

// A fuzz target: fuzzed for --fuzz-time seconds (volec fuzz), else run
// on its saved inputs (--replay), then as a property.
pub fn run_fuzz_target<F: Fn(inout Gen)>(gpa: Gpa, name: [u8], f: F) {
    test_done();
    var input: Vec<u64> = Vec::new_in(gpa);
    if TEST_FUZZ_TIME <= 0 {
        TEST_RAW = true;
        for k in 0..TEST_REPLAYS {
            if !unsafe { fuzz_load(gpa, TEST_REPLAY[k], &input) } {
                continue;
            }
            let r = test_case(f, gpa, input, 64, true);
            if test_fails(r) {
                let p = unsafe { test_arg(TEST_REPLAY[k]) };
                println(f"vole-test: property input {p}");
                test_case(f, gpa, input, 64, false);
                test_exit(1);
            }
        }
        TEST_RAW = false;
        input.free();
        run_property(gpa, name, f);
        return;
    }
    // the corpus: the saved inputs, and the empty one
    var corpus: Vec<Vec<u64>> = Vec::new_in(gpa);
    var seen = [0 as u8; 65536];
    var cov = [0 as u8; 65536];
    let empty: Vec<u64> = Vec::new_in(gpa);
    corpus.push(empty);
    for k in 0..TEST_REPLAYS {
        var v: Vec<u64> = Vec::new_in(gpa);
        if unsafe { fuzz_load(gpa, TEST_REPLAY[k], &v) } {
            corpus.push(v);
        }
    }
    var runs = 0;
    for k in 0..corpus.len() {
        var v = corpus.get(k);
        let r = fuzz_exec(f, gpa, v, cov[..]);
        runs += 1;
        if test_fails(r) {
            fuzz_failed(f, gpa, &v, runs);
        }
        fuzz_new_coverage(cov[..], seen[..]);
    }
    var state = test_seed_of(name);
    let start = unsafe { fuzz_time(0 as *i64) };
    var kept = 0;
    var child: Vec<u64> = Vec::new_in(gpa);
    while unsafe { fuzz_time(0 as *i64) } - start < TEST_FUZZ_TIME {
        var parent = corpus.get((test_next(&state) % corpus.len() as u64) as i64);
        var other = corpus.get((test_next(&state) % corpus.len() as u64) as i64);
        child.clear();
        for i in 0..parent.len() {
            child.push(parent.get(i));
        }
        let stack = 1 + test_next(&state) % 4;
        for _ in 0..stack {
            fuzz_mutate(&child, other, &state);
        }
        let r = fuzz_exec(f, gpa, child, cov[..]);
        runs += 1;
        if test_fails(r) {
            fuzz_failed(f, gpa, &child, runs);
        }
        if r.status == 0 && fuzz_new_coverage(cov[..], seen[..]) {
            var keep: Vec<u64> = Vec::new_in(gpa);
            for i in 0..child.len() {
                keep.push(child.get(i));
            }
            let path = fuzz_save(gpa, keep, "corpus-");
            var p = path;
            p.free();
            corpus.push(keep);
            kept += 1;
        }
        let _ = parent.len();
        let _ = other.len();
    }
    println(f"vole-test: fuzz {runs} runs, {kept} inputs kept, {corpus.len()} in the corpus");
    test_exit(0)
}
