// ---- Conversions (0.15) ----
//
// compiler/std/embed.sh appends this file to std.tach: the same module,
// `std`. From and Into, the traits of conversions
// (docs/design/errors-formatting.md). Every type converts from itself,
// and an integer type from the integer types that widen to it, without
// an impl; Into is the compiler's: `let y: U = x.into()` is `U::from(x)`.

// ---- Option and Result's adapters (0.15) ----

impl<T> Option<T> {
    // Some(x) is Ok(x), None the error `err`: `opt.ok_or(E::Missing)?`.
    pub fn ok_or<E>(sink self, err: sink E) -> Result<T, E> {
        match self {
            Option::Some(x) => Result::Ok(x),
            Option::None => Result::Err(err),
        }
    }

    pub fn map<U, F: Fn(sink T) -> U>(sink self, f: F) -> Option<U> {
        match self {
            Option::Some(x) => Option::Some(f(x)),
            Option::None => Option::None,
        }
    }

    pub fn and_then<U, F: Fn(sink T) -> Option<U>>(sink self, f: F) -> Option<U> {
        match self {
            Option::Some(x) => f(x),
            Option::None => Option::None,
        }
    }

    pub fn unwrap_or_else<F: Fn() -> T>(sink self, f: F) -> T {
        match self {
            Option::Some(x) => x,
            Option::None => f(),
        }
    }
}

impl<T, E> Result<T, E> {
    pub fn map<U, F: Fn(sink T) -> U>(sink self, f: F) -> Result<U, E> {
        match self {
            Result::Ok(x) => Result::Ok(f(x)),
            Result::Err(e) => Result::Err(e),
        }
    }

    // The error converted: `r.map_err(AppError::Io)?`, `r.map_err(|e| ...)`.
    pub fn map_err<G, F: Fn(sink E) -> G>(sink self, f: F) -> Result<T, G> {
        match self {
            Result::Ok(x) => Result::Ok(x),
            Result::Err(e) => Result::Err(f(e)),
        }
    }

    pub fn err(sink self) -> Option<E> {
        match self {
            Result::Ok(_) => Option::None,
            Result::Err(e) => Option::Some(e),
        }
    }

    pub fn unwrap_or_else<F: Fn(sink E) -> T>(sink self, f: F) -> T {
        match self {
            Result::Ok(x) => x,
            Result::Err(e) => f(e),
        }
    }
}

// (No string literals below: std's literals are in every program that
// loads std, used or not.)

// What a `main` returning `Result<(), E>` does with an Err: `Error: {e:?}` and
// a newline on stderr, then exit status 1 (the compiler calls it).
pub fn main_error<E: Debug>(e: sink E) -> i32 {
    var f = Fmt::to_fd(2);
    let head: [u8; 7] = ['E', 'r', 'r', 'o', 'r', ':', ' '];
    f.str(head[..]);
    f.debug(e);
    f.byte('\n');
    f.flush();
    1
}
