// std's values section (0.17): appended to std's text after alloc.tach
// (compiler/std/embed.sh).

// ---- Values (0.17) ----

// Mutable value semantics (docs/design/value-semantics.md): the prelude's
// Drop, drop, forget, needs_drop and Copy; std::take and std::replace.
// (0.17: values move and drop, front/own; std's containers implement Drop
// with T4.)

// What a value does when its owner goes out of scope: `impl Drop for T`.
// Calling `x.drop()` yourself is an error; `drop(x)` ends x early.
pub trait Drop {
    fn drop(inout self);
}

// Consumes x: its drop runs here, not at the end of its scope.
pub fn drop<T>(x: sink T) {}

// Consumes x without running its drop: a leak, which is safe
// (`--check-alloc` lists it).
pub fn forget<T>(x: sink T) {}

// Whether a value of type T has a drop to run (a constant, folded where
// it is called).
pub fn needs_drop<T>() -> bool {
    false
}

// `T: Copy` holds when T is plain: `=` copies it (numbers, bool, raw
// pointers, fieldless enums, and aggregates of those). No type implements
// it with an impl block.
pub trait Copy {}

// A type's empty value: what std::take leaves behind.
pub trait Default {
    fn default() -> Self;
}

// Exchanges *a and *b. (Bit for bit, as replace: a write through a raw
// pointer drops nothing, so neither value is dropped or copied.)
pub fn swap<T>(a: inout T, b: inout T) {
    unsafe {
        let pa: *T = &a;
        let pb: *T = &b;
        let t = *pa;
        *pa = *pb;
        *pb = t;
    }
}

// The value at *dest, replaced by value. (The old value moves out and the
// new one in, bit for bit: a write through a raw pointer drops nothing.)
pub fn replace<T>(dest: inout T, value: sink T) -> T {
    unsafe {
        let p: *T = &dest;
        let old = *p;
        *p = value;
        old
    }
}

// The value at *dest, replaced by T's empty value (`std::take(&mut
// self.count)`). A container's empty value needs its allocator: Vec, Buf
// and HashMap have `take` methods, `self.keys.take()`, which keep it.
pub fn take<T: Default>(dest: inout T) -> T {
    let empty: T = T::default();
    replace(&dest, empty)
}

// The empty values: 0, false, None.
impl Default for i8 { fn default() -> i8 { 0 } }
impl Default for i16 { fn default() -> i16 { 0 } }
impl Default for i32 { fn default() -> i32 { 0 } }
impl Default for i64 { fn default() -> i64 { 0 } }
impl Default for u8 { fn default() -> u8 { 0 } }
impl Default for u16 { fn default() -> u16 { 0 } }
impl Default for u32 { fn default() -> u32 { 0 } }
impl Default for u64 { fn default() -> u64 { 0 } }
impl Default for f32 { fn default() -> f32 { 0.0 } }
impl Default for f64 { fn default() -> f64 { 0.0 } }
impl Default for bool { fn default() -> bool { false } }
impl<T> Default for Option<T> { fn default() -> Option<T> { Option::None } }
