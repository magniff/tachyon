// ---- Printing and formatting ----
//
// compiler/std/embed.sh appends this file to std.tach (its printing was
// split from it): the same module, `std`. Printing; the traits Display
// (`{x}`, print) and Debug (`{x:?}`), the formatter Fmt they write to, and
// Interp, the value of an f-string (docs/design/errors-formatting.md).
//
// Output to stdout and stderr goes through one static buffer of 4 KB
// (not the heap), written out at the end of each print call: one `write`
// per print, whatever its argument is made of. A Fmt to a file descriptor
// only fills that buffer: `flush` writes it out.
//
// (0.16) Formatting allocates nothing: a Fmt to a Buf writes into the
// room the Buf has, and counts what does not fit; then `push_fmt` grows
// the Buf to the count and runs the Display again (twice only when the
// text did not fit). So print's effects have no `alloc`.

// ---- Display and Debug of std's types (0.15) ----

impl Display for i8 {
    #[inline]
    fn fmt(self: &i8, f: &mut Fmt) { fmt_signed(f, *self as i64, 8); }
}

impl Debug for i8 {
    #[inline]
    fn fmt_debug(self: &i8, f: &mut Fmt) { fmt_signed(f, *self as i64, 8); }
}

impl Display for i16 {
    #[inline]
    fn fmt(self: &i16, f: &mut Fmt) { fmt_signed(f, *self as i64, 16); }
}

impl Debug for i16 {
    #[inline]
    fn fmt_debug(self: &i16, f: &mut Fmt) { fmt_signed(f, *self as i64, 16); }
}

impl Display for i32 {
    #[inline]
    fn fmt(self: &i32, f: &mut Fmt) { fmt_signed(f, *self as i64, 32); }
}

impl Debug for i32 {
    #[inline]
    fn fmt_debug(self: &i32, f: &mut Fmt) { fmt_signed(f, *self as i64, 32); }
}

impl Display for i64 {
    #[inline]
    fn fmt(self: &i64, f: &mut Fmt) { f.int(*self); }
}

impl Debug for i64 {
    #[inline]
    fn fmt_debug(self: &i64, f: &mut Fmt) { f.int(*self); }
}

// (a number, as in Rust: `{c:c}` writes the byte)
impl Display for u8 {
    #[inline]
    fn fmt(self: &u8, f: &mut Fmt) { f.uint(*self as u64); }
}

impl Debug for u8 {
    #[inline]
    fn fmt_debug(self: &u8, f: &mut Fmt) { f.uint(*self as u64); }
}

impl Display for u16 {
    #[inline]
    fn fmt(self: &u16, f: &mut Fmt) { f.uint(*self as u64); }
}

impl Debug for u16 {
    #[inline]
    fn fmt_debug(self: &u16, f: &mut Fmt) { f.uint(*self as u64); }
}

impl Display for u32 {
    #[inline]
    fn fmt(self: &u32, f: &mut Fmt) { f.uint(*self as u64); }
}

impl Debug for u32 {
    #[inline]
    fn fmt_debug(self: &u32, f: &mut Fmt) { f.uint(*self as u64); }
}

impl Display for u64 {
    #[inline]
    fn fmt(self: &u64, f: &mut Fmt) { f.uint(*self); }
}

impl Debug for u64 {
    #[inline]
    fn fmt_debug(self: &u64, f: &mut Fmt) { f.uint(*self); }
}

impl Display for bool {
    #[inline]
    fn fmt(self: &bool, f: &mut Fmt) { f.str(if *self { "true" } else { "false" }); }
}

impl Debug for bool {
    #[inline]
    fn fmt_debug(self: &bool, f: &mut Fmt) { f.str(if *self { "true" } else { "false" }); }
}

impl Display for [u8] {
    #[inline]
    fn fmt(self: &Self, f: &mut Fmt) { f.str(*self); }
}

// (quoted and escaped: `"a\n"`)
impl Debug for [u8] {
    #[inline]
    fn fmt_debug(self: &Self, f: &mut Fmt) { fmt_quoted(f, *self); }
}

impl<A: Allocator> Display for Buf<A> {
    #[inline]
    fn fmt(self: &Buf<A>, f: &mut Fmt) { f.str(self.as_slice()); }
}

impl<A: Allocator> Debug for Buf<A> {
    #[inline]
    fn fmt_debug(self: &Buf<A>, f: &mut Fmt) { fmt_quoted(f, self.as_slice()); }
}

impl<T: Debug> Debug for Option<T> {
    fn fmt_debug(self: &Option<T>, f: &mut Fmt) {
        match *self {
            Option::Some(x) => {
                f.str("Some(");
                f.debug(&x);
                f.byte(')');
            }
            Option::None => f.str("None"),
        }
    }
}

impl<T: Debug, E: Debug> Debug for Result<T, E> {
    fn fmt_debug(self: &Result<T, E>, f: &mut Fmt) {
        match *self {
            Result::Ok(x) => {
                f.str("Ok(");
                f.debug(&x);
            }
            Result::Err(e) => {
                f.str("Err(");
                f.debug(&e);
            }
        }
        f.byte(')');
    }
}

impl<T: Debug, A: Allocator> Debug for Vec<T, A> {
    fn fmt_debug(self: &Vec<T, A>, f: &mut Fmt) { debug_list(f, self.as_slice()); }
}

// (0.16: `Ok(())`)
impl Debug for () {
    fn fmt_debug(self: &(), f: &mut Fmt) {
        f.str("()");
    }
}

// ---- Debug of HashMap (0.15) ----

// `{k: v, ...}`, in slot order.
impl<K: Hash + Eq + Debug, V: Debug, A: Allocator> Debug for HashMap<K, V, A> {
    fn fmt_debug(self: &HashMap<K, V, A>, f: &mut Fmt) {
        f.byte('{');
        let mut first = true;
        for i in 0..self.slots() {
            if let Option::Some(k) = self.key_at(i) {
                if !first {
                    f.str(", ");
                }
                first = false;
                let v = self.value_at(i).unwrap();
                f.debug(&k);
                f.str(": ");
                f.debug(&v);
            }
        }
        f.byte('}');
    }
}
