// std::hash (0.20): the hash functions. FixedState, the default: foldhash
// with fixed seeds, the same hashes in every run and on every target (so
// that maps iterate in the same order everywhere); RandomState: foldhash
// seeded per process; SipHashState: SipHash-1-3 with random keys, for keys
// an attacker chooses. std's Hash impls of numbers and byte strings are
// FixedState's hashes (hash_u64, hash_bytes). Each state has
// build_hasher (a FoldHasher or SipHasher13: write, write_u8 .. write_u64,
// finish) and hash_u64, hash_bytes.

mod fold;
mod sip;
mod state;

pub use fold::{
    FoldHasher, FoldSeeds, fold_hash_bytes, fold_hash_bytes_fixed, fold_hash_u64_fixed, fold_mul,
};
pub use sip::SipHasher13;
pub use state::{FixedState, RandomState, SipHashState};
