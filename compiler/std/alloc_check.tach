// ---- Gpa's leak checks (0.16) ----

impl Gpa {
    // The blocks allocated and not freed: -1, unknown, unless --check-alloc.
    pub fn live_blocks(self) -> i64 {
        CHECK_LIVE
    }

    // Whether no block is left allocated (with --check-alloc, which lists
    // them); always true without.
    pub fn check_leaks(self) -> bool {
        unsafe { check_alloc_list_leaks() }
        CHECK_LIVE == 0
    }
}

// (0.18) The blocks allocated from `mark` (check_alloc_mark) on and not
// freed, listed as at exit (the first line names them a case's): a
// property's case, or a fuzz run, leaks them (test_case, fuzz_exec);
// their count.
fn check_alloc_leaks_since(mark: i64) -> i64 {
    var live = 0;
    var bytes = 0;
    unsafe {
        for b in mark..CHECK_COUNT {
            if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {
                live += 1;
                bytes += CHECK_BLOCKS[b].size;
            }
        }
        if live == 0 {
            return 0;
        }
        var m = check_msg();
        m.text("check-alloc: ");
        m.int(live);
        m.text(if live == 1 { " block" } else { " blocks" });
        m.text(" of Gpa not freed by the case (");
        m.int(bytes);
        m.text(" bytes):");
        m.out();
        var shown = 0;
        for b in mark..CHECK_COUNT {
            if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK
                && shown < 20 {
                var line = check_msg();
                line.text("  ");
                check_describe(&line, b);
                line.out();
                shown += 1;
            }
        }
        CHECK_LISTED = CHECK_CHANGES;
    }
    live
}

// ---- Gpa's implementation: the checking allocator (0.16, --check-alloc) ----

// With --check-alloc (docs/design/effects-allocation.md, §2.5), Gpa gives
// every block pages of its own, at the cursor of a large reservation of
// address space with no access: a block's pages are made readable and
// writable when it is allocated, and are given back with no access when it
// is freed, never to be handed out again; every resize moves. A later
// access to a freed block faults, and the fault handler names the block,
// where it was allocated and where freed (the compiler stores the site of
// each call from the program that may allocate in CHECK_ALLOC_SITE). Frees
// are checked: double, invalid and wrong-size frees stop the program; the
// blocks left at exit are listed. Arenas route their allocations here too
// (check_alloc_block, check_alloc_release). Block numbers count every
// allocation from 1, the same each run: TACHYON_ALLOC_TRAP=N raises SIGTRAP
// when block N is allocated, for a debugger.

// (Its messages and stops are the allocator's misuse, the effect `alloc`:
// not io, which an allocator may not do.)
extern "C" {
    #[effects(alloc(extern), global)]
    fn mmap(addr: *u8, len: u64, prot: i32, flags: i32, fd: i32, offset: i64) -> *u8;
    #[effects(alloc(extern), global)]
    fn mprotect(addr: *u8, len: u64, prot: i32) -> i32;
    #[effects(global)]
    fn getpagesize() -> i32;
    #[effects(global)]
    fn getenv(name: *u8) -> *u8;
    #[effects(global)]
    fn raise(sig: i32) -> i32;
    #[effects(global)]
    fn atexit(f: extern "C" fn()) -> i32;
    #[effects(global)]
    fn sigaction(sig: i32, act: *CheckSigaction, old: *CheckSigaction) -> i32;
    #[link_name = "write"]
    #[effects(global)]
    fn check_write(fd: i32, data: *u8, count: u64) -> i64;
    #[effects(diverge)]
    fn _exit(code: i32) -> !;
}

// The site of the program's call being run that may allocate (`main.tach:
// 14:9`, a C string), stored by the compiled program before the call.
static var CHECK_ALLOC_SITE: *u8 = 0 as *u8;

// A block: its pages [start, start + span), its size, its allocator (0:
// Gpa, else an arena's state), its state, and where it was allocated and
// freed.
struct CheckBlock {
    start: u64,
    size: i64,
    span: i64,
    owner: u64,
    state: i64,
    alloc_site: *u8,
    free_site: *u8,
}

const CHECK_LIVE_BLOCK: i64 = 1;
const CHECK_FREED: i64 = 2;
const CHECK_RELEASED: i64 = 3;

// Every block, in the order allocated (block #N is CHECK_BLOCKS[N - 1]).
static var CHECK_BLOCKS: *CheckBlock = 0 as *CheckBlock;
static var CHECK_COUNT: i64 = 0;
static var CHECK_CAP: i64 = 0;
// The live blocks of Gpa (arenas' blocks are not counted).
static var CHECK_LIVE: i64 = 0;
// The reservations of address space (regions): their bounds and their
// first block; a region's blocks follow each other (blocks are never
// placed in an earlier region), so the blocks are sorted by address within
// one. The cursor is in the last region.
const CHECK_MAX_REGIONS: i64 = 256;
static var CHECK_REGION_START: [u64; 256] = [0; 256];
static var CHECK_REGION_END: [u64; 256] = [0; 256];
static var CHECK_REGION_FIRST: [i64; 256] = [0; 256];
static var CHECK_REGIONS: i64 = 0;
static var CHECK_CURSOR: u64 = 0;
// The page size, 0 until the first allocation.
static var CHECK_PAGE: i64 = 0;
// TACHYON_ALLOC_TRAP; TACHYON_ALLOC_MAX_LIVE (the map limit's message when
// this many blocks are live: for tests, on any system); 0 when unset.
static var CHECK_TRAP: i64 = 0;
static var CHECK_MAX_LIVE: i64 = 0;
// The changes to the blocks (allocations and frees), and their count when
// check_leaks listed the leaks (the exit's list is left out then).
static var CHECK_CHANGES: i64 = 0;
static var CHECK_LISTED: i64 = -1;

const CHECK_REGION_BYTES: u64 = 68719476736;
const CHECK_PROT_NONE: i32 = 0;
const CHECK_PROT_RW: i32 = 3;

// The system's constants: macOS (CHECK_ALLOC_OS 0) and Linux (1).
fn check_map_flags() -> i32 {
    // MAP_PRIVATE | MAP_ANON | MAP_NORESERVE
    if CHECK_ALLOC_OS == 1 { 2 | 32 | 16384 } else { 2 | 4096 | 64 }
}

const CHECK_MAP_FIXED: i32 = 16;

fn check_sigbus() -> i32 {
    if CHECK_ALLOC_OS == 1 { 7 } else { 10 }
}

// struct sigaction: the handler, then (macOS) a 4-byte mask and the flags,
// or (glibc) a 128-byte mask and the flags.
#[repr(C)]
struct CheckSigaction { handler: extern "C" fn(i32, *u8, *u8), words: [u64; 19] }

fn check_sigaction() -> CheckSigaction {
    var a = CheckSigaction { handler: unsafe { check_alloc_fault }, words: [0; 19] };
    if CHECK_ALLOC_OS == 1 {
        // SA_SIGINFO | SA_RESETHAND
        a.words[16] = 4 | 2147483648;
    } else {
        a.words[0] = (64 | 4) << 32;
    }
    a
}

// The offset of si_addr in siginfo_t.
fn check_si_addr() -> u64 {
    if CHECK_ALLOC_OS == 1 { 16 } else { 24 }
}

// A message, written to stderr at once.
struct CheckMsg { len: i64, bytes: [u8; 2048] }

impl CheckMsg {
    fn text(inout self, s: [u8]) {
        for i in 0..s.len {
            if self.len < 2048 {
                self.bytes[self.len] = s[i];
                self.len += 1;
            }
        }
    }

    unsafe fn cstr(inout self, s: *u8) {
        var n = 0;
        while s[n] != 0 {
            n += 1;
        }
        self.text(s[0..n]);
    }

    fn int(inout self, v: i64) {
        if v < 0 {
            self.text("-");
            self.int(0 - v);
            return;
        }
        if v >= 10 {
            self.int(v / 10);
        }
        let d: [u8; 1] = [('0' as i64 + v % 10) as u8];
        self.text(d[0..1]);
    }

    fn hex(inout self, v: u64) {
        self.text("0x");
        let digits = "0123456789abcdef";
        var started = false;
        for k in 0..16 {
            let d = (v >> ((15 - k) * 4) as u64) & 15;
            if d != 0 || started || k == 15 {
                started = true;
                self.text(digits[d as i64..d as i64 + 1]);
            }
        }
    }

    unsafe fn site(inout self, s: *u8) {
        if s == 0 as *u8 {
            self.text("an unknown place");
        } else {
            self.cstr(s);
        }
    }

    // `block #N (48 bytes)`, ` of an arena`.
    fn block(inout self, b: i64) {
        unsafe {
            self.text("block #");
            self.int(b + 1);
            self.text(" (");
            self.int(CHECK_BLOCKS[b].size);
            self.text(if CHECK_BLOCKS[b].size == 1 { " byte)" } else { " bytes)" });
            if CHECK_BLOCKS[b].owner != 0 {
                self.text(" of an arena");
            }
        }
    }

    fn out(inout self) {
        self.text("\n");
        unsafe {
            check_write(2, &self.bytes[0], self.len as u64);
        }
    }
}

fn check_msg() -> CheckMsg {
    CheckMsg { len: 0, bytes: [0; 2048] }
}

// Stops the program with message m (exit 101, without the leaks' list).
fn check_stop(m: inout CheckMsg) -> ! {
    m.out();
    unsafe { _exit(101) }
}

// `block #N (48 bytes), allocated at X[, freed at Y]`.
unsafe fn check_describe(m: *CheckMsg, b: i64) {
    m.block(b);
    m.text(", allocated at ");
    m.site(CHECK_BLOCKS[b].alloc_site);
    if CHECK_BLOCKS[b].state != CHECK_LIVE_BLOCK {
        m.text(if CHECK_BLOCKS[b].state == CHECK_FREED { ", freed at " } else { ", released at " });
        m.site(CHECK_BLOCKS[b].free_site);
        if CHECK_BLOCKS[b].state == CHECK_RELEASED {
            m.text(" (the arena's reset or scope end)");
        }
    }
}

// The decimal number in C string s (0 when null or none).
// (0.21: VOLE_X wins over TACHYON_X, the name from 0.24)
unsafe fn check_env_int(vole: *u8, name: *u8) -> i64 {
    var s = getenv(vole);
    if s == 0 as *u8 {
        s = getenv(name);
    }
    if s == 0 as *u8 {
        return 0;
    }
    var v = 0;
    var i = 0;
    while s[i] >= '0' && s[i] <= '9' {
        v = v * 10 + (s[i] - '0') as i64;
        i += 1;
    }
    v
}

// The first allocation: the page size, the fault handlers, the leaks'
// list at exit, the environment.
unsafe fn check_init() {
    CHECK_PAGE = getpagesize() as i64;
    let a = check_sigaction();
    sigaction(11, &a, 0 as *CheckSigaction);
    sigaction(check_sigbus(), &a, 0 as *CheckSigaction);
    atexit(check_alloc_at_exit);
    CHECK_TRAP = check_env_int(c"VOLE_ALLOC_TRAP", c"TACHYON_ALLOC_TRAP");
    CHECK_MAX_LIVE = check_env_int(c"VOLE_ALLOC_MAX_LIVE", c"TACHYON_ALLOC_MAX_LIVE");
}

// The system refused to change a block's pages: on Linux, the limit of
// memory maps (each run of live blocks between freed ones is a map).
unsafe fn check_map_limit() -> ! {
    var m = check_msg();
    m.text("check-alloc: out of memory maps at block #");
    m.int(CHECK_COUNT + 1);
    m.text(", with ");
    m.int(CHECK_LIVE);
    m.text(" blocks live: the kernel's vm.max_map_count is reached (every live block has pages of its own)");
    m.text("\ntry: sudo sysctl vm.max_map_count=1048576");
    check_stop(&m)
}

// A new region of at least `bytes`, or false.
unsafe fn check_reserve(bytes: u64) -> bool {
    if CHECK_REGIONS == CHECK_MAX_REGIONS {
        return false;
    }
    var size = CHECK_REGION_BYTES;
    while size < bytes {
        size = size * 2;
    }
    loop {
        let p = mmap(0 as *u8, size, CHECK_PROT_NONE, check_map_flags(), -1, 0);
        if p as i64 != -1 {
            let r = CHECK_REGIONS;
            CHECK_REGION_START[r] = p as u64;
            CHECK_REGION_END[r] = p as u64 + size;
            CHECK_REGION_FIRST[r] = CHECK_COUNT;
            CHECK_REGIONS += 1;
            CHECK_CURSOR = p as u64;
            return true;
        }
        // (less address space: smaller reservations)
        if size / 2 < bytes || size <= 1073741824 {
            return false;
        }
        size = size / 2;
    }
}

// A new block of size bytes on pages of its own, for allocator owner (0:
// Gpa), or null when out of memory.
unsafe fn check_new_block(owner: u64, size: i64) -> *u8 {
    if CHECK_PAGE == 0 {
        check_init();
    }
    if size < 0 || size > 4611686018427387904 {
        return 0 as *u8;
    }
    let page = CHECK_PAGE as u64;
    let span = (size as u64 + page - 1) / page * page;
    if CHECK_REGIONS == 0 || CHECK_CURSOR + span > CHECK_REGION_END[CHECK_REGIONS - 1] {
        if !check_reserve(span) {
            return 0 as *u8;
        }
    }
    if CHECK_MAX_LIVE > 0 && CHECK_LIVE >= CHECK_MAX_LIVE {
        check_map_limit();
    }
    let p = CHECK_CURSOR as *u8;
    if mprotect(p, span, CHECK_PROT_RW) != 0 {
        if CHECK_ALLOC_OS == 1 {
            check_map_limit();
        }
        return 0 as *u8;
    }
    CHECK_CURSOR += span;
    if CHECK_COUNT == CHECK_CAP {
        CHECK_CAP = if CHECK_CAP == 0 { 1024 } else { CHECK_CAP * 2 };
        CHECK_BLOCKS = realloc(CHECK_BLOCKS as *u8, (CHECK_CAP * size_of(CheckBlock)) as u64)
            as *CheckBlock;
    }
    CHECK_BLOCKS[CHECK_COUNT] = CheckBlock {
        start: p as u64,
        size: size,
        span: span as i64,
        owner: owner,
        state: CHECK_LIVE_BLOCK,
        alloc_site: CHECK_ALLOC_SITE,
        free_site: 0 as *u8,
    };
    CHECK_COUNT += 1;
    CHECK_CHANGES += 1;
    if owner == 0 {
        CHECK_LIVE += 1;
    }
    if CHECK_COUNT == CHECK_TRAP {
        var m = check_msg();
        m.text("check-alloc: ");
        check_describe(&m, CHECK_COUNT - 1);
        m.text(" (TACHYON_ALLOC_TRAP): SIGTRAP");
        m.out();
        raise(5);
    }
    p
}

// Block b's pages given back, with no access, never used again.
unsafe fn check_drop_block(b: i64, state: i64) {
    let p = CHECK_BLOCKS[b].start as *u8;
    let span = CHECK_BLOCKS[b].span as u64;
    let flags = check_map_flags() | CHECK_MAP_FIXED;
    if mmap(p, span, CHECK_PROT_NONE, flags, -1, 0) != p {
        if CHECK_ALLOC_OS == 1 {
            check_map_limit();
        }
        // (the pages keep their contents, but no access)
        mprotect(p, span, CHECK_PROT_NONE);
    }
    if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {
        CHECK_LIVE -= 1;
    }
    CHECK_BLOCKS[b].state = state;
    CHECK_BLOCKS[b].free_site = CHECK_ALLOC_SITE;
    CHECK_CHANGES += 1;
}

// The block whose pages hold address a; -1 when a is outside the
// reservations, -2 when in one but in no block.
unsafe fn check_find(a: u64) -> i64 {
    for r in 0..CHECK_REGIONS {
        if a >= CHECK_REGION_START[r] && a < CHECK_REGION_END[r] {
            var lo = CHECK_REGION_FIRST[r];
            var hi = if r + 1 < CHECK_REGIONS { CHECK_REGION_FIRST[r + 1] }
                else { CHECK_COUNT };
            // the last block starting at or before a
            while lo < hi {
                let mid = (lo + hi) / 2;
                if CHECK_BLOCKS[mid].start <= a {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
            let b = lo - 1;
            if b >= CHECK_REGION_FIRST[r]
                && a < CHECK_BLOCKS[b].start + CHECK_BLOCKS[b].span as u64 {
                return b;
            }
            return -2;
        }
    }
    -1
}

// The live block p of `size` bytes from allocator owner, being freed or
// resized: its index, or the program stops.
unsafe fn check_owned(p: *u8, size: i64, owner: u64, freeing: bool) -> i64 {
    let b = check_find(p as u64);
    var m = check_msg();
    if b < 0 || CHECK_BLOCKS[b].start != p as u64 {
        m.text(if freeing { "invalid free at " } else { "invalid resize at " });
        m.site(CHECK_ALLOC_SITE);
        m.text(": ");
        m.hex(p as u64);
        if b >= 0 {
            m.text(" is ");
            m.int((p as u64 - CHECK_BLOCKS[b].start) as i64);
            m.text(" bytes into ");
            check_describe(&m, b);
        } else {
            m.text(if owner == 0 { " is not a block of Gpa" }
                else { " is not a block of the arena" });
        }
        check_stop(&m);
    }
    if CHECK_BLOCKS[b].state != CHECK_LIVE_BLOCK {
        m.text(if freeing { "double free: " } else { "resize after free: " });
        check_describe(&m, b);
        m.text(if freeing { ", freed again at " } else { ", resized at " });
        m.site(CHECK_ALLOC_SITE);
        check_stop(&m);
    }
    if CHECK_BLOCKS[b].owner != owner {
        m.text(if freeing { "invalid free at " } else { "invalid resize at " });
        m.site(CHECK_ALLOC_SITE);
        m.text(": ");
        check_describe(&m, b);
        m.text(if owner == 0 { ", given to Gpa" } else { ", given to another allocator" });
        check_stop(&m);
    }
    if CHECK_BLOCKS[b].size != size {
        m.text(if freeing { "wrong-size free: " } else { "wrong-size resize: " });
        check_describe(&m, b);
        m.text(if freeing { ", freed as " } else { ", resized as " });
        m.int(size);
        m.text(if size == 1 { " byte at " } else { " bytes at " });
        m.site(CHECK_ALLOC_SITE);
        check_stop(&m);
    }
    b
}

// p (old_size bytes from owner) moved to a new block of new_size bytes, or
// null (p untouched).
unsafe fn check_move(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
    if old_size == 0 {
        return check_alloc_block(owner, new_size, align);
    }
    let b = check_owned(p, old_size, owner, false);
    if new_size == 0 {
        check_drop_block(b, CHECK_FREED);
        return align as *u8;
    }
    let q = check_new_block(owner, new_size);
    if q == 0 as *u8 {
        return q;
    }
    memcpy(q, p, (if old_size < new_size { old_size } else { new_size }) as u64);
    check_drop_block(b, CHECK_FREED);
    q
}

// (Arenas, with --check-alloc) A block of size bytes on pages of its own
// for the allocator whose state is at owner (0: Gpa), or null; size 0: an
// aligned pointer, no block.
fn check_alloc_block(owner: u64, size: i64, align: i64) -> *u8 {
    if size == 0 {
        return unsafe { align as *u8 };
    }
    unsafe { check_new_block(owner, size) }
}

// (Arenas) p, a block of owner of old_size bytes, moved to new_size bytes.
unsafe fn check_alloc_moved(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64)
    -> *u8 {
    check_move(owner, p, old_size, new_size, align)
}

// (Arenas) The blocks allocated so far: a mark for check_alloc_release.
fn check_alloc_mark() -> i64 {
    CHECK_COUNT
}

// (Arenas: a reset, a scope's end) Every block of owner allocated after
// mark is given back: a later access faults.
fn check_alloc_release(owner: u64, mark: i64) {
    unsafe {
        for b in mark..CHECK_COUNT {
            if CHECK_BLOCKS[b].owner == owner && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {
                check_drop_block(b, CHECK_RELEASED);
            }
        }
    }
}

// (Arenas) The site of the call being run, and that site set again: a
// scope's end is reported at the scope's call, not at the last call in it.
fn check_alloc_site() -> *u8 {
    unsafe { CHECK_ALLOC_SITE }
}

fn check_alloc_set_site(site: *u8) {
    unsafe {
        CHECK_ALLOC_SITE = site;
    }
}

// (Arenas) Whether p starts the last live block of owner: the block an
// arena grows, or gives back, in place.
fn check_alloc_is_last(owner: u64, p: *u8) -> bool {
    unsafe {
        for k in 0..CHECK_COUNT {
            let b = CHECK_COUNT - 1 - k;
            if CHECK_BLOCKS[b].owner == owner && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {
                return CHECK_BLOCKS[b].start == p as u64;
            }
        }
        false
    }
}

// (--check-unsafe with --check-alloc) The access of size bytes at p:
// false when p is no memory of the checking allocator, true when it is in
// bounds of a live block; else the program stops.
pub unsafe fn check_alloc_access(p: u64, size: u64, site: *u8) -> bool {
    let b = check_find(p);
    if b == -1 {
        return false;
    }
    var m = check_msg();
    if b >= 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {
        if p + size <= CHECK_BLOCKS[b].start + CHECK_BLOCKS[b].size as u64 {
            return true;
        }
        m.text("unsafe access out of bounds: ");
    } else if b >= 0 {
        m.text("unsafe access after free: ");
    } else {
        m.text("unsafe access outside every block: ");
    }
    m.int(size as i64);
    m.text(if size == 1 { " byte at " } else { " bytes at " });
    if b >= 0 {
        m.text("offset ");
        m.int((p - CHECK_BLOCKS[b].start) as i64);
        m.text(" of ");
        check_describe(&m, b);
    } else {
        m.hex(p);
    }
    m.text("\n --> ");
    m.site(site);
    check_stop(&m)
}

// SIGSEGV, SIGBUS: an access to a freed block (or to the pages after the
// last one) is reported; any other fault happens again with the default
// action (SA_RESETHAND), as without --check-alloc.
extern "C" fn check_alloc_fault(sig: i32, info: *u8, context: *u8) {
    unsafe {
        let a = *((info as u64 + check_si_addr()) as *u64);
        let b = check_find(a);
        if b == -1 {
            return;
        }
        var m = check_msg();
        if b >= 0 {
            m.text(if CHECK_BLOCKS[b].state == CHECK_RELEASED { "use after release: " }
                else { "use after free: " });
            check_describe(&m, b);
        } else {
            m.text("access outside every block: ");
            m.hex(a);
            m.text(" (memory the checking allocator never handed out)");
        }
        check_stop(&m);
    }
}

// The live blocks of Gpa, listed (at most 20).
unsafe fn check_alloc_list_leaks() {
    CHECK_LISTED = CHECK_CHANGES;
    if CHECK_LIVE <= 0 {
        return;
    }
    var m = check_msg();
    var bytes = 0;
    for b in 0..CHECK_COUNT {
        if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {
            bytes += CHECK_BLOCKS[b].size;
        }
    }
    m.text("check-alloc: ");
    m.int(CHECK_LIVE);
    m.text(if CHECK_LIVE == 1 { " block" } else { " blocks" });
    m.text(" of Gpa not freed (");
    m.int(bytes);
    m.text(" bytes):");
    m.out();
    var shown = 0;
    for b in 0..CHECK_COUNT {
        if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {
            if shown == 20 {
                var more = check_msg();
                more.text("  and ");
                more.int(CHECK_LIVE - shown);
                more.text(" more");
                more.out();
                return;
            }
            var line = check_msg();
            line.text("  ");
            check_describe(&line, b);
            line.out();
            shown += 1;
        }
    }
}

// At exit: the leaks, unless check_leaks listed them and nothing changed
// since.
extern "C" fn check_alloc_at_exit() {
    unsafe {
        if CHECK_LISTED != CHECK_CHANGES {
            check_alloc_list_leaks();
        }
    }
}

impl Allocator for Gpa {
    fn try_alloc(self: *Gpa, size: i64, align: i64) -> *u8 {
        check_alloc_block(0, size, align)
    }

    unsafe fn try_resize(self: *Gpa, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
        check_move(0, p, old_size, new_size, align)
    }

    unsafe fn free(self: *Gpa, p: *u8, size: i64, align: i64) {
        if size == 0 && check_find(p as u64) == -1 {
            return;
        }
        check_drop_block(check_owned(p, size, 0, true), CHECK_FREED);
    }
}
