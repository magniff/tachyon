// std::iter: the Iterator trait, its adapters and its sources (0.20: from flat/iter.vl).

use std::{Allocator, Eq, Gpa, Hash, Option, Vec};
use std::collections::{HashMap, RawIter};
use std::slice::{swap_at, swap_raw};

pub trait Iterator {
    type Item;

    // The next item, or None when there are no more.
    fn next(inout self) -> Option<Self::Item>;

    // The number of items left, or -1 when it is not known.
    #[inline]
    fn exact_len(self) -> i64 {
        -1
    }

    // The k-th item left: only when exact_len() > k, with k increasing
    // (0, 1, 2, ...) and no other use of the iterator in between.
    #[inline]
    fn at(inout self, k: i64) -> Self::Item {
        self.next().unwrap()
    }

    // (0.25) The adapters and the consumers take the iterator `sink`: an
    // adapter owns the one it wraps (dropped with it, and with it the items
    // it did not reach), a consumer uses it up. The searches (any, all,
    // position, find) take it `inout`: they advance it, and the caller
    // keeps the rest. An item a consumer or an adapter passes over (count's,
    // the ones filter rejects, min's and max's losers) is dropped, unless
    // the iterator's items are copies of the elements of a container it
    // borrows (`v.iter()` of a Vec<Vec<i64>>): pass_over.

    #[inline]
    fn map<B, F: FnMut(sink Self::Item) -> B>(sink self, f: F) -> Map<Self, F> {
        Map { it: self, f: f }
    }

    #[inline]
    fn filter<F: FnMut(Self::Item) -> bool>(sink self, f: F) -> Filter<Self, F> {
        Filter { it: self, f: f }
    }

    // Items (i64, Self::Item): each with its index.
    #[inline]
    fn enumerate(sink self) -> Enumerate<Self> {
        Enumerate { it: self, k: 0 }
    }

    // Items (Self::Item, J::Item), as long as both have one.
    #[inline]
    fn zip<J: Iterator>(sink self, other: sink J) -> Zip<Self, J> {
        Zip { a: self, b: other }
    }

    // The first n items.
    #[inline]
    fn take(sink self, n: i64) -> Take<Self> {
        Take { it: self, n: n }
    }

    // f(...f(f(init, x0), x1)..., xn): the loop every consumer is.
    #[inline]
    fn fold<B, F: FnMut(sink B, sink Self::Item) -> B>(sink self, init: sink B, f: F) -> B {
        var it = self;
        var g = f;
        var acc = init;
        while let Option::Some(x) = it.next() {
            acc = g(acc, x);
        }
        acc
    }

    #[inline]
    fn for_each<F: FnMut(sink Self::Item)>(sink self, f: F) {
        var g = f;
        self.fold((), |u: (), x| g(x));
    }

    #[inline]
    fn count(sink self) -> i64 {
        self.fold(0i64, |n, x| {
            pass_over::<Self>(x);
            n + 1
        })
    }

    // The sum of the items, from `0 as Self::Item`.
    #[inline]
    fn sum(sink self) -> Self::Item {
        self.fold(0 as Self::Item, |s, x| s + x)
    }

    #[inline]
    fn min(sink self) -> Option<Self::Item> {
        var it = self;
        match it.next() {
            Option::Some(first) => Option::Some(it.fold(first, |m, x| if x < m {
                pass_over::<Self>(m);
                x
            } else {
                pass_over::<Self>(x);
                m
            })),
            Option::None => Option::None,
        }
    }

    #[inline]
    fn max(sink self) -> Option<Self::Item> {
        var it = self;
        match it.next() {
            Option::Some(first) => Option::Some(it.fold(first, |m, x| if x > m {
                pass_over::<Self>(m);
                x
            } else {
                pass_over::<Self>(x);
                m
            })),
            Option::None => Option::None,
        }
    }

    // A new Vec of the items on allocator a (0.16; the caller frees it).
    #[inline]
    fn collect_in<A: Allocator>(sink self, a: sink A) -> Vec<Self::Item, A> {
        var it = self;
        var v: Vec<Self::Item, A> = Vec::new_in(a);
        let n = it.exact_len();
        if n > 0 {
            v.reserve(n);
        }
        it.for_each(|x| v.push(x));
        v
    }

    // (0.16: an error outside std, front/ambient.vl)
    #[ambient("collect_in(gpa)")]
    #[inline]
    fn collect(sink self) -> Vec<Self::Item> {
        self.collect_in(Gpa::ambient())
    }

    // ---- Searches (0.15) ----
    // They call `next` and stop at the first item that decides: the items
    // after it are not reached, and stay in the iterator (0.25: `inout
    // self`).

    // Whether f is true for some item.
    #[inline]
    fn any<F: FnMut(Self::Item) -> bool>(inout self, f: F) -> bool {
        var g = f;
        while let Option::Some(x) = self.next() {
            if g(x) {
                return true;
            }
        }
        false
    }

    // Whether f is true for every item (true when there is none).
    #[inline]
    fn all<F: FnMut(Self::Item) -> bool>(inout self, f: F) -> bool {
        var g = f;
        while let Option::Some(x) = self.next() {
            if !g(x) {
                return false;
            }
        }
        true
    }

    // The index (counting from 0) of the first item f is true for.
    #[inline]
    fn position<F: FnMut(Self::Item) -> bool>(inout self, f: F) -> Option<i64> {
        var g = f;
        var k = 0;
        while let Option::Some(x) = self.next() {
            if g(x) {
                return Option::Some(k);
            }
            k += 1;
        }
        Option::None
    }

    // The first item f is true for.
    #[inline]
    fn find<F: FnMut(Self::Item) -> bool>(inout self, f: F) -> Option<Self::Item> {
        var g = f;
        while let Option::Some(x) = self.next() {
            if g(x) {
                return Option::Some(x);
            }
        }
        Option::None
    }
}

// (0.25) Consumes item x of an iterator of type I that an adapter or a
// consumer passes over: dropped, unless I's items are copies of elements
// a container it borrows keeps (`v.iter()`, a map's `iter`, `keys`,
// `values`, a set's `iter`, and adapters of them): then left alone, as
// std::forget would (front/own/drops.vl: param_drops decides, by I).
#[inline]
pub fn pass_over<I: Iterator>(x: sink I::Item) {}

// ---- Adapters ----

pub struct Map<I, F> { it: I, f: F }

impl<I: Iterator, M> Iterator for Map<I, M> {
    type Item = M::Output;

    #[inline]
    fn next(inout self) -> Option<M::Output> {
        match self.it.next() {
            Option::Some(x) => Option::Some((self.f)(x)),
            Option::None => Option::None,
        }
    }

    #[inline]
    fn exact_len(self) -> i64 {
        self.it.exact_len()
    }

    #[inline]
    fn at(inout self, k: i64) -> M::Output {
        (self.f)(self.it.at(k))
    }

    #[inline]
    fn fold<B, F: FnMut(sink B, sink M::Output) -> B>(sink self, init: sink B, f: F) -> B {
        var m = self.f;
        var g = f;
        self.it.fold(init, |acc, x| g(acc, m(x)))
    }
}

pub struct Filter<I, F> { it: I, f: F }

impl<I: Iterator, P> Iterator for Filter<I, P> {
    type Item = I::Item;

    #[inline]
    fn next(inout self) -> Option<I::Item> {
        loop {
            match self.it.next() {
                Option::Some(x) => {
                    if (self.f)(x) {
                        return Option::Some(x);
                    }
                }
                Option::None => return Option::None,
            }
        }
    }

    #[inline]
    fn fold<B, F: FnMut(sink B, sink I::Item) -> B>(sink self, init: sink B, f: F) -> B {
        var p = self.f;
        var g = f;
        self.it.fold(init, |acc, x| if p(x) {
            g(acc, x)
        } else {
            pass_over::<I>(x);
            acc
        })
    }
}

pub struct Enumerate<I> { it: I, k: i64 }

impl<I: Iterator> Iterator for Enumerate<I> {
    type Item = (i64, I::Item);

    #[inline]
    fn next(inout self) -> Option<(i64, I::Item)> {
        match self.it.next() {
            Option::Some(x) => {
                let k = self.k;
                self.k = k + 1;
                Option::Some((k, x))
            }
            Option::None => Option::None,
        }
    }

    #[inline]
    fn exact_len(self) -> i64 {
        self.it.exact_len()
    }

    #[inline]
    fn at(inout self, k: i64) -> (i64, I::Item) {
        (self.k + k, self.it.at(k))
    }

    #[inline]
    fn fold<B, F: FnMut(sink B, sink (i64, I::Item)) -> B>(sink self, init: sink B, f: F) -> B {
        var e = self;
        var g = f;
        var acc = init;
        let n = e.it.exact_len();
        if n >= 0 {
            for k in 0..n {
                acc = g(acc, (e.k + k, e.it.at(k)));
            }
        } else {
            while let Option::Some(p) = e.next() {
                acc = g(acc, p);
            }
        }
        acc
    }
}

pub struct Zip<I, J> { a: I, b: J }

impl<A: Iterator, J: Iterator> Iterator for Zip<A, J> {
    type Item = (A::Item, J::Item);

    #[inline]
    fn next(inout self) -> Option<(A::Item, J::Item)> {
        match self.a.next() {
            Option::Some(x) => match self.b.next() {
                Option::Some(y) => Option::Some((x, y)),
                Option::None => Option::None,
            },
            Option::None => Option::None,
        }
    }

    #[inline]
    fn exact_len(self) -> i64 {
        let n = self.a.exact_len();
        let m = self.b.exact_len();
        if n < 0 || m < 0 {
            -1
        } else if n < m {
            n
        } else {
            m
        }
    }

    #[inline]
    fn at(inout self, k: i64) -> (A::Item, J::Item) {
        (self.a.at(k), self.b.at(k))
    }

    #[inline]
    fn fold<B, F: FnMut(sink B, sink (A::Item, J::Item)) -> B>(sink self, init: sink B, f: F) -> B {
        var z = self;
        var g = f;
        var acc = init;
        let n = z.exact_len();
        if n >= 0 {
            for k in 0..n {
                acc = g(acc, (z.a.at(k), z.b.at(k)));
            }
        } else {
            while let Option::Some(p) = z.next() {
                acc = g(acc, p);
            }
        }
        acc
    }
}

pub struct Take<I> { it: I, n: i64 }

impl<I: Iterator> Iterator for Take<I> {
    type Item = I::Item;

    #[inline]
    fn next(inout self) -> Option<I::Item> {
        if self.n <= 0 {
            return Option::None;
        }
        self.n -= 1;
        self.it.next()
    }

    #[inline]
    fn exact_len(self) -> i64 {
        let m = self.it.exact_len();
        if m < 0 {
            -1
        } else if self.n <= 0 {
            0
        } else if m < self.n {
            m
        } else {
            self.n
        }
    }

    #[inline]
    fn at(inout self, k: i64) -> I::Item {
        self.it.at(k)
    }

    #[inline]
    fn fold<B, F: FnMut(sink B, sink I::Item) -> B>(sink self, init: sink B, f: F) -> B {
        var t = self;
        var g = f;
        var acc = init;
        let n = t.exact_len();
        if n >= 0 {
            for k in 0..n {
                acc = g(acc, t.it.at(k));
            }
        } else {
            while t.n > 0 {
                match t.it.next() {
                    Option::Some(x) => {
                        t.n -= 1;
                        acc = g(acc, x);
                    }
                    Option::None => break,
                }
            }
        }
        acc
    }
}

// ---- Sources ----
//
// `for` over a SliceIter, a Range or a RangeInclusive is a counted loop
// (front/check/iterate.vl); their `fold` is one too.

// `a..b` as a value: start, start + 1, ..., up to end, end excluded.
pub struct Range<T> { pub start: T, pub end: T }

impl<T> Iterator for Range<T> {
    type Item = T;

    #[inline]
    fn next(inout self) -> Option<T> {
        if self.start < self.end {
            let x = self.start;
            self.start = x + 1;
            Option::Some(x)
        } else {
            Option::None
        }
    }

    #[inline]
    fn exact_len(self) -> i64 {
        if self.start < self.end { (self.end - self.start) as i64 } else { 0 }
    }

    #[inline]
    fn at(inout self, k: i64) -> T {
        self.start + k as T
    }

    #[inline]
    fn fold<B, F: FnMut(sink B, sink T) -> B>(sink self, init: sink B, f: F) -> B {
        var g = f;
        var acc = init;
        for x in self.start..self.end {
            acc = g(acc, x);
        }
        acc
    }
}

// `a..=b` as a value: end included; `done` once `next` gave end.
pub struct RangeInclusive<T> { pub start: T, pub end: T, pub done: bool }

impl<T> Iterator for RangeInclusive<T> {
    type Item = T;

    #[inline]
    fn next(inout self) -> Option<T> {
        if self.done || self.start > self.end {
            return Option::None;
        }
        let x = self.start;
        if x == self.end {
            self.done = true;
        } else {
            self.start = x + 1;
        }
        Option::Some(x)
    }

    #[inline]
    fn exact_len(self) -> i64 {
        if self.done || self.start > self.end { 0 } else { (self.end - self.start) as i64 + 1 }
    }

    #[inline]
    fn at(inout self, k: i64) -> T {
        self.start + k as T
    }

    #[inline]
    fn fold<B, F: FnMut(sink B, sink T) -> B>(sink self, init: sink B, f: F) -> B {
        var g = f;
        var acc = init;
        if !self.done {
            for x in self.start..=self.end {
                acc = g(acc, x);
            }
        }
        acc
    }
}

// The items of a slice, by value: `v.iter()`, `s.iter()`.
pub struct SliceIter<T> { s: [T], pos: i64 }

impl<T> Iterator for SliceIter<T> {
    type Item = T;

    #[inline]
    fn next(inout self) -> Option<T> {
        if self.pos < self.s.len {
            let x = self.s[self.pos];
            self.pos += 1;
            Option::Some(x)
        } else {
            Option::None
        }
    }

    #[inline]
    fn exact_len(self) -> i64 {
        self.s.len - self.pos
    }

    #[inline]
    fn at(inout self, k: i64) -> T {
        self.s[self.pos + k]
    }

    #[inline]
    fn fold<B, F: FnMut(sink B, sink T) -> B>(sink self, init: sink B, f: F) -> B {
        var g = f;
        var acc = init;
        let s = self.s;
        for k in self.pos..s.len {
            acc = g(acc, s[k]);
        }
        acc
    }
}

impl<T> SliceIter<T> {
    // The items left, as a slice.
    #[inline]
    // (0.20: self is a copy of the view; what it views is its level 1)
    #[views(self)]
    pub fn as_slice(self) -> [T] {
        self.s[self.pos..self.s.len]
    }
}

impl<T>[T] {
    // Its items, by value.
    #[inline]
    #[views(self)]
    pub fn iter(self: [T]) -> SliceIter<T> {
        SliceIter { s: self, pos: 0 }
    }

    // Its items, by reference (0.17): `for x in s.iter_ref()`, x a `&T`,
    // the elements neither copied nor moved.
    #[inline]
    #[views(self)]
    pub fn iter_ref(self: [T]) -> SliceRefIter<T> {
        SliceRefIter { s: self, pos: 0 }
    }

    // Sorts it in place by f (see sort_by).
    #[inline]
    pub fn sort_by<F: FnMut(let T, let T) -> i64>(self: inout [T], f: F) {
        sort_by(self, f);
    }

    // Exchanges elements i and j (checked; 0.17).
    #[inline]
    pub fn swap(self: inout [T], i: i64, j: i64) {
        swap_at::<T>(self, i, j);
    }
}

impl<T, A: Allocator> Vec<T, A> {
    // Its items, by value (a view: valid until the vector grows or is
    // freed).
    #[inline]
    #[views(self)]
    pub fn iter(self) -> SliceIter<T> {
        SliceIter { s: self.as_slice(), pos: 0 }
    }

    // Its items, by reference (0.17): `for x in v.iter_ref()`, x a `&T`.
    #[inline]
    #[views(self)]
    pub fn iter_ref(self) -> SliceRefIter<T> {
        SliceRefIter { s: self.as_slice(), pos: 0 }
    }

    // Sorts it in place by f (see sort_by).
    #[inline]
    pub fn sort_by<F: FnMut(let T, let T) -> i64>(inout self, f: F) {
        sort_by(self.as_mut_slice(), f);
    }
}

// The items of a slice, by reference (0.17): `v.iter_ref()`,
// `s.iter_ref()`; a view of the slice.
pub struct SliceRefIter<T> { s: [T], pos: i64 }

impl<T> Iterator for SliceRefIter<T> {
    type Item = let T;

    #[inline]
    fn next(inout self) -> Option<let T> {
        if self.pos < self.s.len {
            let x = &self.s[self.pos];
            self.pos += 1;
            Option::Some(x)
        } else {
            Option::None
        }
    }

    #[inline]
    fn exact_len(self) -> i64 {
        self.s.len - self.pos
    }

    #[inline]
    fn at(inout self, k: i64) -> let T {
        self.s[self.pos + k]
    }
}

// `m.iter()`: (key, value) in slot order, until the map changes. (0.17) A
// view of the map: (0.20) its table's iterator, a view of its control
// bytes, and its buckets.
pub struct HashMapIter<K, V> { it: RawIter, data: *(K, V), left: i64 }

impl<K, V> Iterator for HashMapIter<K, V> {
    type Item = (K, V);

    #[inline]
    fn next(inout self) -> Option<(K, V)> {
        let i = self.it.next_index();
        if i < 0 {
            return Option::None;
        }
        self.left -= 1;
        let e = unsafe { &self.data[i] };
        Option::Some((unsafe { (*e).0 }, unsafe { (*e).1 }))
    }

    #[inline]
    fn exact_len(self) -> i64 {
        self.left
    }

    #[inline]
    fn fold<B, F: FnMut(sink B, sink (K, V)) -> B>(sink self, init: sink B, f: F) -> B {
        var g = f;
        var acc = init;
        var it = self.it;
        for _ in 0..self.left {
            let i = it.next_index();
            let e = unsafe { &self.data[i] };
            acc = g(acc, (unsafe { (*e).0 }, unsafe { (*e).1 }));
        }
        acc
    }
}

pub struct Keys<K, V> { it: HashMapIter<K, V> }

impl<K, V> Iterator for Keys<K, V> {
    type Item = K;

    #[inline]
    fn next(inout self) -> Option<K> {
        match self.it.next() {
            Option::Some(e) => Option::Some(e.0),
            Option::None => Option::None,
        }
    }

    #[inline]
    fn exact_len(self) -> i64 {
        self.it.left
    }

    #[inline]
    fn fold<B, F: FnMut(sink B, sink K) -> B>(sink self, init: sink B, f: F) -> B {
        var g = f;
        self.it.fold(init, |acc, e| g(acc, e.0))
    }
}

pub struct Values<K, V> { it: HashMapIter<K, V> }

impl<K, V> Iterator for Values<K, V> {
    type Item = V;

    #[inline]
    fn next(inout self) -> Option<V> {
        match self.it.next() {
            Option::Some(e) => Option::Some(e.1),
            Option::None => Option::None,
        }
    }

    #[inline]
    fn exact_len(self) -> i64 {
        self.it.left
    }

    #[inline]
    fn fold<B, F: FnMut(sink B, sink V) -> B>(sink self, init: sink B, f: F) -> B {
        var g = f;
        self.it.fold(init, |acc, e| g(acc, e.1))
    }
}

impl<K: Hash + Eq, V, A: Allocator> HashMap<K, V, A> {
    #[inline]
    #[views(self)]
    pub fn iter(self) -> HashMapIter<K, V> {
        let t = self.raw_table();
        let data = if t.len() == 0 { 0 as *(K, V) } else { t.bucket_ptr() };
        HashMapIter { it: t.iter(), data: data, left: t.len() }
    }

    #[inline]
    #[views(self)]
    pub fn keys(self) -> Keys<K, V> {
        Keys { it: self.iter() }
    }

    #[inline]
    #[views(self)]
    pub fn values(self) -> Values<K, V> {
        Values { it: self.iter() }
    }
}

// Sorts s in place by f: f(a, b) is negative, zero or positive as *a goes
// before, with or after *b (`|a, b| a.cmp(b)`: smallest first). A
// heapsort: not stable. (0.17) f takes references; the elements move as
// bits, so any T sorts, owned ones too.
pub fn sort_by<T, F: FnMut(let T, let T) -> i64>(s: inout [T], f: F) {
    var g = f;
    let n = s.len;
    let p = s.ptr;
    var start = n / 2;
    var end = n;
    // (each round takes one from start or end: n / 2 + n at most; 0.16:
    // counted loops, no effect diverge; every index is below end <= n)
    unsafe {
        for _ in 0..n / 2 + n + 1 {
            // Build the heap from n/2 down, then move its top behind it.
            if start > 0 {
                start -= 1;
            } else {
                end -= 1;
                if end <= 0 {
                    return;
                }
                swap_raw::<T>(p, 0, end);
            }
            var root = start;
            for _ in 0..64 {
                var child = 2 * root + 1;
                if child >= end {
                    break;
                }
                if child + 1 < end && g(*(&p[child]), *(&p[child + 1])) < 0 {
                    child += 1;
                }
                if g(*(&p[root]), *(&p[child])) >= 0 {
                    break;
                }
                swap_raw::<T>(p, root, child);
                root = child;
            }
        }
    }
}
