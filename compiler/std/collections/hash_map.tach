// std::collections::hash_map: HashMap (0.20: on the Swiss table).

use std::{ALLOC_LIMIT, Allocator, Ambient, Drop, Eq, Gpa, Hash, Option, out_of_memory, replace};
use super::raw_table::RawTable;

// ---- HashMap ----

// A hash table from K to V: hashbrown's Swiss table (RawTable), its
// entries (key, value) pairs in buckets, matched 8 control bytes at a
// time; keys hashed by their Hash impl (std's: foldhash with fixed seeds,
// so a map iterates in the same order in every run and on every target).
// Slots are numbered 0..slots(); `key_at(i)` and `value_at(i)` give an
// occupied slot's entry (None for a free one); `iter()` is the same in
// slot order.
#[sealed]
pub struct HashMap<K: Hash + Eq, V, A: Allocator = Gpa> {
    table: RawTable<(K, V), A>,
}

// (0.20: the old table's slot state of an entry; kept for code that names
// it)
pub const SLOT_FULL: u8 = 1;

// The hash of an entry's key.
#[inline]
fn entry_hash<K: Hash, V>(e: &(K, V)) -> u64 {
    e.0.hash()
}

impl<K: Hash + Eq, V, A: Allocator> HashMap<K, V, A> {
    // An empty map on allocator a (0.16).
    pub fn new_in(a: A) -> HashMap<K, V, A> {
        HashMap { table: RawTable::new_in(a) }
    }

    #[inline]
    pub fn len(self: &HashMap<K, V, A>) -> i64 {
        self.table.len()
    }

    #[inline]
    pub fn is_empty(self: &HashMap<K, V, A>) -> bool {
        self.table.len() == 0
    }

    // The slot holding `key`, or -1.
    #[inline]
    fn slot_of(self: &HashMap<K, V, A>, key: &K) -> i64 {
        self.table.find(key.hash(), |e: &(K, V)| e.0 == *key)
    }

    pub fn contains(self: &HashMap<K, V, A>, key: K) -> bool {
        self.slot_of(&key) >= 0
    }

    // The same as `contains` (Rust's name).
    #[inline]
    pub fn contains_key(self: &HashMap<K, V, A>, key: K) -> bool {
        self.slot_of(&key) >= 0
    }

    // A copy of the value of `key`, if it has one (`get_mut` changes it).
    #[inline]
    pub fn get(self: &HashMap<K, V, A>, key: K) -> Option<V> {
        let i = self.slot_of(&key);
        // (i from find: FULL)
        if i < 0 { Option::None }
        else { Option::Some(unsafe { (*self.table.bucket_unchecked(i)).1 }) }
    }

    // The value of `key` in place, as a writable view of one element, if
    // it has one: `if let Some(a) = m.get_mut(k) { a[0].balance += 10; }`.
    // The view is valid until the map's next insert, remove or free (like
    // a Vec's `as_mut_slice()`).
    #[views(self)]
    pub fn get_mut(self: &mut HashMap<K, V, A>, key: K) -> Option<&mut [V]> {
        let i = self.slot_of(&key);
        if i < 0 {
            return Option::None;
        }
        let p = unsafe { &(*self.table.bucket_unchecked(i)).1 as *V };
        Option::Some(unsafe { &mut p[0..1] })
    }

    // The value of `key` in place (a writable view of one element, as `get_mut`),
    // inserted as `default` first if the key has none; Rust's
    // `entry(k).or_insert(d)`. Counting: `counts.get_or_insert(w, 0)[0] += 1;`.
    #[views(self)]
    #[stores(key, default)]
    pub fn get_or_insert(self: &mut HashMap<K, V, A>, key: K, default: V) -> &mut [V] {
        let h = key.hash();
        self.table.reserve(1, |e: &(K, V)| entry_hash(e));
        let r = self.table.find_or_find_insert_slot(h, |e: &(K, V)| e.0 == key);
        let i = if r >= 0 { r } else { self.table.insert_in_slot(h, ~r, (key, default)) };
        // (i found or just filled: FULL)
        let p = unsafe { &(*self.table.bucket_unchecked(i)).1 as *V };
        unsafe { &mut p[0..1] }
    }

    // Sets the value of `key`; returns its old value, if it had one.
    #[stores(key, value)]
    pub fn insert(self: &mut HashMap<K, V, A>, key: K, value: V) -> Option<V> {
        let h = key.hash();
        self.table.reserve(1, |e: &(K, V)| entry_hash(e));
        let r = self.table.find_or_find_insert_slot(h, |e: &(K, V)| e.0 == key);
        if r >= 0 {
            // (the old value moves out, the new one in: neither is dropped)
            let p = unsafe { self.table.bucket_unchecked(r) };
            let old = unsafe { (*p).1 };
            unsafe {
                (*p).1 = value;
            }
            return Option::Some(old);
        }
        self.table.insert_in_slot(h, ~r, (key, value));
        Option::None
    }

    // Removes `key`; returns its value, if it had one (the stored key is
    // dropped).
    pub fn remove(self: &mut HashMap<K, V, A>, key: K) -> Option<V> {
        let i = self.slot_of(&key);
        if i < 0 {
            return Option::None;
        }
        let e = self.table.take(i);
        Option::Some(e.1)
    }

    // The slots: what `key_at` and `value_at` take.
    #[inline]
    pub fn slots(self: &HashMap<K, V, A>) -> i64 {
        if self.table.len() == 0 { 0 } else { self.table.buckets() }
    }

    pub fn key_at(self: &HashMap<K, V, A>, i: i64) -> Option<K> {
        if !self.table.is_full(i) {
            return Option::None;
        }
        Option::Some(unsafe { (*self.table.bucket(i)).0 })
    }

    pub fn value_at(self: &HashMap<K, V, A>, i: i64) -> Option<V> {
        if !self.table.is_full(i) {
            return Option::None;
        }
        Option::Some(unsafe { (*self.table.bucket(i)).1 })
    }

    // (std's iterators) The table.
    #[inline]
    #[views(self)]
    pub fn raw_table(self: &HashMap<K, V, A>) -> &RawTable<(K, V), A> {
        &self.table
    }

    // Its entries dropped and its memory given back; it is left empty, to
    // use again (0.17: a map is dropped at the end of its scope without
    // it).
    pub fn free(self: &mut HashMap<K, V, A>) {
        self.table.free();
    }

    // Removes every entry; keeps the memory.
    pub fn clear(self: &mut HashMap<K, V, A>) {
        self.table.clear();
    }

    // Its entries, in a map on the same allocator; it is left empty (0.17:
    // `std::take` for a container, which keeps its allocator).
    pub fn take(self: &mut HashMap<K, V, A>) -> HashMap<K, V, A> {
        let empty: HashMap<K, V, A> = HashMap::new_in(self.table.allocator());
        replace(self, empty)
    }

    // Its allocator (0.16): a copy of the handle.
    pub fn allocator(self: &HashMap<K, V, A>) -> A {
        self.table.allocator()
    }

    // An empty map on allocator a with room for n entries (0.16).
    pub fn with_capacity_in(n: i64, a: A) -> HashMap<K, V, A> {
        if n > ALLOC_LIMIT / 16 {
            out_of_memory();
        }
        HashMap { table: RawTable::with_capacity_in(n, a) }
    }

    // The entries it holds before it grows.
    pub fn capacity(self: &HashMap<K, V, A>) -> i64 {
        self.table.capacity()
    }

    // Room for n more entries without growing.
    pub fn reserve(self: &mut HashMap<K, V, A>, n: i64) {
        self.table.reserve(n, |e: &(K, V)| entry_hash(e));
    }
}

// (0.17) A map's drop: its entries' drops, then its memory given back.
impl<K: Hash + Eq, V, A: Allocator> Drop for HashMap<K, V, A> {
    #[inline]
    fn drop(self: &mut HashMap<K, V, A>) {
        self.table.free();
    }
}

impl<K: Hash + Eq, V, A: Allocator + Ambient> HashMap<K, V, A> {
    #[ambient("HashMap::new_in(gpa)")]
    pub fn new() -> HashMap<K, V, A> {
        HashMap::new_in(A::ambient())
    }
}
