// std::num: integer limits and bits (0.20: from flat/io.tach).

// ---- Integer limits (0.15) ----

// The smallest and largest values of the integer types: the same as the
// builtin `i32::MAX`, `u8::MIN`, ... (aliases, from before those).
pub const I8_MIN: i8 = i8::MIN;
pub const I8_MAX: i8 = i8::MAX;
pub const I16_MIN: i16 = i16::MIN;
pub const I16_MAX: i16 = i16::MAX;
pub const I32_MIN: i32 = i32::MIN;
pub const I32_MAX: i32 = i32::MAX;
pub const I64_MIN: i64 = i64::MIN;
pub const I64_MAX: i64 = i64::MAX;
pub const U8_MAX: u8 = u8::MAX;
pub const U16_MAX: u16 = u16::MAX;
pub const U32_MAX: u32 = u32::MAX;
pub const U64_MAX: u64 = u64::MAX;

// ---- Bits (0.16) ----

// The number of 1 bits of x (a narrower unsigned value widens: `count_ones(m)`
// of a u32 m). On AArch64 these three are instructions (cnt, clz, rbit
// and clz); elsewhere these bodies, a few operations each.
pub fn count_ones(x: u64) -> i64 {
    let a = x - ((x >> 1) & 0x5555555555555555);
    let b = (a & 0x3333333333333333) + ((a >> 2) & 0x3333333333333333);
    let c = (b + (b >> 4)) & 0x0f0f0f0f0f0f0f0f;
    ((c * 0x0101010101010101) >> 56) as i64
}

// The number of 0 bits above the highest 1 bit of x: 64 for 0, 0 when the
// top bit is set.
pub fn leading_zeros(x: u64) -> i64 {
    // (the highest bit smeared down, then the ones it leaves counted)
    let mut y = x | (x >> 1);
    y = y | (y >> 2);
    y = y | (y >> 4);
    y = y | (y >> 8);
    y = y | (y >> 16);
    y = y | (y >> 32);
    64 - count_ones(y)
}

// The number of 0 bits below the lowest 1 bit of x: 64 for 0. For x != 0,
// 1 << trailing_zeros(x) is x & -x, its lowest set bit.
pub fn trailing_zeros(x: u64) -> i64 {
    count_ones(~x & (x - 1))
}

// ---- Wide products (0.20) ----

// The high 64 bits of the 128-bit product a * b (0.20). On AArch64 at -O1
// and -O2 the call is one umulh (instruction selection replaces it: why
// it is never inlined); elsewhere the schoolbook product of the halves.
#[inline(never)]
pub fn mul_high(a: u64, b: u64) -> u64 {
    let a_lo = a & 0xffffffffu64;
    let a_hi = a >> 32;
    let b_lo = b & 0xffffffffu64;
    let b_hi = b >> 32;
    let ll = a_lo * b_lo;
    let lh = a_lo * b_hi;
    let hl = a_hi * b_lo;
    let hh = a_hi * b_hi;
    let mid = (ll >> 32) + (lh & 0xffffffffu64) + (hl & 0xffffffffu64);
    hh + (lh >> 32) + (hl >> 32) + (mid >> 32)
}

// The 128-bit product a * b as (high, low) 64 bits (0.20; Rust's
// `(a as u128) * (b as u128)`).
#[inline]
pub fn wide_mul(a: u64, b: u64) -> (u64, u64) {
    (mul_high(a, b), a * b)
}
