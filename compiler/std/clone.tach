// ---- Clone and hashing (0.15) ----
//
// compiler/std/embed.sh appends this file to std.tach: the same module,
// `std`. Clone, and the helpers `#[derive(Hash)]` uses
// (docs/design/errors-formatting.md).

// A copy owning its memory (a Vec's elements are cloned).
pub trait Clone { fn clone(self: *Self) -> Self; }

// Hash h of the fields so far, with the hash x of the next one mixed in.
#[inline]
pub fn hash_mix(h: u64, x: u64) -> u64 {
    hash_u64(h ^ (x + 0x9e3779b97f4a7c15u64 + (h << 6) + (h >> 2)))
}
