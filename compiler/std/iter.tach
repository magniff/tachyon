// ---- Iterators (0.14) ----
//
// compiler/std/embed.sh appends this file to std.tach: the same module,
// `std`. The Iterator trait (in the prelude) and its adapters; `for x in
// it` iterates any type implementing it (docs/design/closures-iterators.md).
//
// Every method is #[inline], so that a chain becomes one loop. The
// consumers here call `next`; the sources and the adapters (their impls
// are to come) override `fold` with a counted loop.

pub trait Iterator {
    type Item;

    // The next item, or None when there are no more.
    fn next(self: *Self) -> Option<Self::Item>;

    // The number of items left, or -1 when it is not known.
    #[inline]
    fn exact_len(self: *Self) -> i64 {
        -1
    }

    // The k-th item left: only when exact_len() > k, with k increasing.
    #[inline]
    fn at(self: *Self, k: i64) -> Self::Item {
        self.next().unwrap()
    }

    #[inline]
    fn map<B, F: FnMut(Self::Item) -> B>(self: Self, f: F) -> Map<Self, F> {
        Map { it: self, f: f }
    }

    #[inline]
    fn filter<F: FnMut(Self::Item) -> bool>(self: Self, f: F) -> Filter<Self, F> {
        Filter { it: self, f: f }
    }

    // Items (i64, Self::Item): each with its index.
    #[inline]
    fn enumerate(self: Self) -> Enumerate<Self> {
        Enumerate { it: self, k: 0 }
    }

    // Items (Self::Item, J::Item), as long as both have one.
    #[inline]
    fn zip<J: Iterator>(self: Self, other: J) -> Zip<Self, J> {
        Zip { a: self, b: other }
    }

    // The first n items.
    #[inline]
    fn take(self: Self, n: i64) -> Take<Self> {
        Take { it: self, n: n }
    }

    #[inline]
    fn fold<B, F: FnMut(B, Self::Item) -> B>(self: Self, init: B, f: F) -> B {
        let mut it = self;
        let mut g = f;
        let mut acc = init;
        while let Some(x) = it.next() {
            acc = g(acc, x);
        }
        acc
    }

    #[inline]
    fn for_each<F: FnMut(Self::Item)>(self: Self, f: F) {
        let mut it = self;
        let mut g = f;
        while let Some(x) = it.next() {
            g(x);
        }
    }

    #[inline]
    fn count(self: Self) -> i64 {
        let mut it = self;
        let mut n = 0;
        while let Some(_) = it.next() {
            n += 1;
        }
        n
    }

    // The sum of the items, from `0 as Self::Item`.
    #[inline]
    fn sum(self: Self) -> Self::Item {
        let mut it = self;
        let mut s = 0 as Self::Item;
        while let Some(x) = it.next() {
            s = s + x;
        }
        s
    }

    #[inline]
    fn min(self: Self) -> Option<Self::Item> {
        let mut it = self;
        let mut best = it.next();
        while let Some(x) = it.next() {
            if let Some(m) = best {
                if x < m {
                    best = Some(x);
                }
            }
        }
        best
    }

    #[inline]
    fn max(self: Self) -> Option<Self::Item> {
        let mut it = self;
        let mut best = it.next();
        while let Some(x) = it.next() {
            if let Some(m) = best {
                if x > m {
                    best = Some(x);
                }
            }
        }
        best
    }

    #[inline]
    fn collect(self: Self) -> Vec<Self::Item> {
        let mut it = self;
        let mut v: Vec<Self::Item> = Vec::new();
        while let Some(x) = it.next() {
            v.push(x);
        }
        v
    }
}

// The adapters (their Iterator impls are to come).
pub struct Map<I, F> { it: I, f: F }
pub struct Filter<I, F> { it: I, f: F }
pub struct Enumerate<I> { it: I, k: i64 }
pub struct Zip<I, J> { a: I, b: J }
pub struct Take<I> { it: I, n: i64 }

// ---- Sources ----
//
// (0.14, staged: until associated types land, the sources' Iterator
// methods are inherent; `for` finds `next` by name. Each overrides `fold`
// with a counted loop.)

// `a..b` as a value: start, start + 1, ..., up to end, end excluded.
pub struct Range<T> { pub start: T, pub end: T }

impl<T> Range<T> {
    #[inline]
    pub fn next(self: *Range<T>) -> Option<T> {
        if self.start < self.end {
            let x = self.start;
            self.start = x + 1;
            Option::Some(x)
        } else {
            Option::None
        }
    }

    #[inline]
    pub fn exact_len(self: *Range<T>) -> i64 {
        if self.start < self.end { (self.end - self.start) as i64 } else { 0 }
    }

    #[inline]
    pub fn at(self: *Range<T>, k: i64) -> T {
        self.start + k as T
    }

    #[inline]
    pub fn fold<B, F>(self: Range<T>, init: B, f: F) -> B {
        let mut g = f;
        let mut acc = init;
        for x in self.start..self.end {
            acc = g(acc, x);
        }
        acc
    }
}

// `a..=b` as a value: start, ..., end, end included; `done` once `next`
// has given end.
pub struct RangeInclusive<T> { pub start: T, pub end: T, pub done: bool }

impl<T> RangeInclusive<T> {
    #[inline]
    pub fn next(self: *RangeInclusive<T>) -> Option<T> {
        if self.done || self.start > self.end {
            return Option::None;
        }
        let x = self.start;
        if x == self.end {
            self.done = true;
        } else {
            self.start = x + 1;
        }
        Option::Some(x)
    }

    #[inline]
    pub fn exact_len(self: *RangeInclusive<T>) -> i64 {
        if self.done || self.start > self.end { 0 } else { (self.end - self.start) as i64 + 1 }
    }

    #[inline]
    pub fn at(self: *RangeInclusive<T>, k: i64) -> T {
        self.start + k as T
    }

    #[inline]
    pub fn fold<B, F>(self: RangeInclusive<T>, init: B, f: F) -> B {
        let mut g = f;
        let mut acc = init;
        if !self.done {
            for x in self.start..=self.end {
                acc = g(acc, x);
            }
        }
        acc
    }
}

// The items of a slice, by value: `v.iter()`, `s.iter()`.
pub struct SliceIter<T> { s: [T], pos: i64 }

impl<T> SliceIter<T> {
    #[inline]
    pub fn next(self: *SliceIter<T>) -> Option<T> {
        if self.pos < self.s.len {
            let x = self.s[self.pos];
            self.pos += 1;
            Option::Some(x)
        } else {
            Option::None
        }
    }

    #[inline]
    pub fn exact_len(self: *SliceIter<T>) -> i64 {
        self.s.len - self.pos
    }

    #[inline]
    pub fn at(self: *SliceIter<T>, k: i64) -> T {
        self.s[self.pos + k]
    }

    // The items left, as a slice.
    #[inline]
    pub fn as_slice(self: *SliceIter<T>) -> [T] {
        self.s[self.pos..self.s.len]
    }

    #[inline]
    pub fn fold<B, F>(self: SliceIter<T>, init: B, f: F) -> B {
        let mut g = f;
        let mut acc = init;
        let s = self.s;
        for k in self.pos..s.len {
            acc = g(acc, s[k]);
        }
        acc
    }
}

impl<T> Vec<T> {
    // Its items, by value (a view: valid until the vector grows or is
    // freed).
    #[inline]
    pub fn iter(self: *Vec<T>) -> SliceIter<T> {
        SliceIter { s: self.as_slice(), pos: 0 }
    }

    // Sorts it in place by f (see sort_by).
    #[inline]
    pub fn sort_by<F>(self: *Vec<T>, f: F) {
        sort_by(self.as_slice(), f);
    }
}

// The entries of a HashMap, (key, value), in slot order: `m.iter()`. A
// view, valid until the map changes or is freed.
pub struct HashMapIter<K, V> { keys: *K, values: *V, states: *u8, cap: i64, pos: i64, left: i64 }

impl<K, V> HashMapIter<K, V> {
    #[inline]
    pub fn next(self: *HashMapIter<K, V>) -> Option<(K, V)> {
        while self.pos < self.cap {
            let i = self.pos;
            self.pos = i + 1;
            if unsafe { self.states[i] } == SLOT_FULL {
                self.left -= 1;
                return Option::Some((unsafe { self.keys[i] }, unsafe { self.values[i] }));
            }
        }
        Option::None
    }

    #[inline]
    pub fn exact_len(self: *HashMapIter<K, V>) -> i64 {
        self.left
    }

    #[inline]
    pub fn at(self: *HashMapIter<K, V>, k: i64) -> (K, V) {
        self.next().unwrap()
    }

    #[inline]
    pub fn fold<B, F>(self: HashMapIter<K, V>, init: B, f: F) -> B {
        let mut g = f;
        let mut acc = init;
        for i in self.pos..self.cap {
            if unsafe { self.states[i] } == SLOT_FULL {
                acc = g(acc, (unsafe { self.keys[i] }, unsafe { self.values[i] }));
            }
        }
        acc
    }
}

// The keys of a HashMap: `m.keys()`.
pub struct Keys<K, V> { it: HashMapIter<K, V> }

impl<K, V> Keys<K, V> {
    #[inline]
    pub fn next(self: *Keys<K, V>) -> Option<K> {
        match self.it.next() {
            Option::Some(e) => Option::Some(e.0),
            Option::None => Option::None,
        }
    }

    #[inline]
    pub fn exact_len(self: *Keys<K, V>) -> i64 {
        self.it.left
    }

    #[inline]
    pub fn at(self: *Keys<K, V>, k: i64) -> K {
        self.next().unwrap()
    }
}

// The values of a HashMap: `m.values()`.
pub struct Values<K, V> { it: HashMapIter<K, V> }

impl<K, V> Values<K, V> {
    #[inline]
    pub fn next(self: *Values<K, V>) -> Option<V> {
        match self.it.next() {
            Option::Some(e) => Option::Some(e.1),
            Option::None => Option::None,
        }
    }

    #[inline]
    pub fn exact_len(self: *Values<K, V>) -> i64 {
        self.it.left
    }

    #[inline]
    pub fn at(self: *Values<K, V>, k: i64) -> V {
        self.next().unwrap()
    }
}

impl<K: Hash + Eq, V> HashMap<K, V> {
    #[inline]
    pub fn iter(self: *HashMap<K, V>) -> HashMapIter<K, V> {
        HashMapIter {
            keys: self.keys, values: self.values, states: self.states, cap: self.cap, pos: 0,
            left: self.len,
        }
    }

    #[inline]
    pub fn keys(self: *HashMap<K, V>) -> Keys<K, V> {
        Keys { it: self.iter() }
    }

    #[inline]
    pub fn values(self: *HashMap<K, V>) -> Values<K, V> {
        Values { it: self.iter() }
    }
}

// Sorts s in place by f: f(a, b) is negative, zero or positive as *a goes
// before, with or after *b (`|a, b| a.cmp(b)`: smallest first). A
// heapsort: not stable.
pub fn sort_by<T, F>(s: [T], f: F) {
    let mut g = f;
    let n = s.len;
    let mut start = n / 2;
    let mut end = n;
    loop {
        // Build the heap from n/2 down, then move its top behind it.
        if start > 0 {
            start -= 1;
        } else {
            end -= 1;
            if end <= 0 {
                return;
            }
            let top = s[0];
            s[0] = s[end];
            s[end] = top;
        }
        let mut root = start;
        loop {
            let mut child = 2 * root + 1;
            if child >= end {
                break;
            }
            if child + 1 < end && g(&s[child], &s[child + 1]) < 0 {
                child += 1;
            }
            if g(&s[root], &s[child]) >= 0 {
                break;
            }
            let t = s[root];
            s[root] = s[child];
            s[child] = t;
            root = child;
        }
    }
}
