// std::iter: the Iterator trait, its adapters and its sources (0.20: from flat/iter.tach).

use std::{Allocator, Eq, Gpa, Hash, Option, Vec};
use std::collections::{HashMap, SLOT_FULL};
use std::slice::{swap_at, swap_raw};

pub trait Iterator {
    type Item;

    // The next item, or None when there are no more.
    fn next(self: &mut Self) -> Option<Self::Item>;

    // The number of items left, or -1 when it is not known.
    #[inline]
    fn exact_len(self: &Self) -> i64 {
        -1
    }

    // The k-th item left: only when exact_len() > k, with k increasing
    // (0, 1, 2, ...) and no other use of the iterator in between.
    #[inline]
    fn at(self: &Self, k: i64) -> Self::Item {
        self.next().unwrap()
    }

    #[inline]
    fn map<B, F: FnMut(Self::Item) -> B>(self: Self, f: F) -> Map<Self, F> {
        Map { it: self, f: f }
    }

    #[inline]
    fn filter<F: FnMut(Self::Item) -> bool>(self: Self, f: F) -> Filter<Self, F> {
        Filter { it: self, f: f }
    }

    // Items (i64, Self::Item): each with its index.
    #[inline]
    fn enumerate(self: Self) -> Enumerate<Self> {
        Enumerate { it: self, k: 0 }
    }

    // Items (Self::Item, J::Item), as long as both have one.
    #[inline]
    fn zip<J: Iterator>(self: Self, other: J) -> Zip<Self, J> {
        Zip { a: self, b: other }
    }

    // The first n items.
    #[inline]
    fn take(self: Self, n: i64) -> Take<Self> {
        Take { it: self, n: n }
    }

    // f(...f(f(init, x0), x1)..., xn): the loop every consumer is.
    #[inline]
    fn fold<B, F: FnMut(B, Self::Item) -> B>(self: Self, init: B, f: F) -> B {
        let mut it = self;
        let mut g = f;
        let mut acc = init;
        while let Option::Some(x) = it.next() {
            acc = g(acc, x);
        }
        acc
    }

    #[inline]
    fn for_each<F: FnMut(Self::Item)>(self: Self, f: F) {
        let mut g = f;
        self.fold((), |u: (), x| g(x));
    }

    #[inline]
    fn count(self: Self) -> i64 {
        self.fold(0i64, |n, x| n + 1)
    }

    // The sum of the items, from `0 as Self::Item`.
    #[inline]
    fn sum(self: Self) -> Self::Item {
        self.fold(0 as Self::Item, |s, x| s + x)
    }

    #[inline]
    fn min(self: Self) -> Option<Self::Item> {
        let mut it = self;
        match it.next() {
            Option::Some(first) => Option::Some(it.fold(first, |m, x| if x < m { x } else { m })),
            Option::None => Option::None,
        }
    }

    #[inline]
    fn max(self: Self) -> Option<Self::Item> {
        let mut it = self;
        match it.next() {
            Option::Some(first) => Option::Some(it.fold(first, |m, x| if x > m { x } else { m })),
            Option::None => Option::None,
        }
    }

    // A new Vec of the items on allocator a (0.16; the caller frees it).
    #[inline]
    fn collect_in<A: Allocator>(self: Self, a: A) -> Vec<Self::Item, A> {
        let mut it = self;
        let mut v: Vec<Self::Item, A> = Vec::new_in(a);
        let n = it.exact_len();
        if n > 0 {
            v.reserve(n);
        }
        it.for_each(|x| v.push(x));
        v
    }

    // (0.16: an error outside std, front/ambient.tach)
    #[ambient("collect_in(gpa)")]
    #[inline]
    fn collect(self: Self) -> Vec<Self::Item> {
        self.collect_in(Gpa::ambient())
    }

    // ---- Searches (0.15) ----
    // They call `next` and stop at the first item that decides: the items
    // after it are not reached.

    // Whether f is true for some item.
    #[inline]
    fn any<F: FnMut(Self::Item) -> bool>(self: Self, f: F) -> bool {
        let mut it = self;
        let mut g = f;
        while let Option::Some(x) = it.next() {
            if g(x) {
                return true;
            }
        }
        false
    }

    // Whether f is true for every item (true when there is none).
    #[inline]
    fn all<F: FnMut(Self::Item) -> bool>(self: Self, f: F) -> bool {
        let mut it = self;
        let mut g = f;
        while let Option::Some(x) = it.next() {
            if !g(x) {
                return false;
            }
        }
        true
    }

    // The index (counting from 0) of the first item f is true for.
    #[inline]
    fn position<F: FnMut(Self::Item) -> bool>(self: Self, f: F) -> Option<i64> {
        let mut it = self;
        let mut g = f;
        let mut k = 0;
        while let Option::Some(x) = it.next() {
            if g(x) {
                return Option::Some(k);
            }
            k += 1;
        }
        Option::None
    }

    // The first item f is true for.
    #[inline]
    fn find<F: FnMut(Self::Item) -> bool>(self: Self, f: F) -> Option<Self::Item> {
        let mut it = self;
        let mut g = f;
        while let Option::Some(x) = it.next() {
            if g(x) {
                return Option::Some(x);
            }
        }
        Option::None
    }
}

// ---- Adapters ----

pub struct Map<I, F> { it: I, f: F }

impl<I: Iterator, M> Iterator for Map<I, M> {
    type Item = M::Output;

    #[inline]
    fn next(self: &mut Map<I, M>) -> Option<M::Output> {
        match self.it.next() {
            Option::Some(x) => Option::Some((self.f)(x)),
            Option::None => Option::None,
        }
    }

    #[inline]
    fn exact_len(self: &Map<I, M>) -> i64 {
        self.it.exact_len()
    }

    #[inline]
    fn at(self: &Map<I, M>, k: i64) -> M::Output {
        (self.f)(self.it.at(k))
    }

    #[inline]
    fn fold<B, F: FnMut(B, M::Output) -> B>(self: Map<I, M>, init: B, f: F) -> B {
        let mut m = self.f;
        let mut g = f;
        self.it.fold(init, |acc, x| g(acc, m(x)))
    }
}

pub struct Filter<I, F> { it: I, f: F }

impl<I: Iterator, P> Iterator for Filter<I, P> {
    type Item = I::Item;

    #[inline]
    fn next(self: &mut Filter<I, P>) -> Option<I::Item> {
        loop {
            match self.it.next() {
                Option::Some(x) => {
                    if (self.f)(x) {
                        return Option::Some(x);
                    }
                }
                Option::None => return Option::None,
            }
        }
    }

    #[inline]
    fn fold<B, F: FnMut(B, I::Item) -> B>(self: Filter<I, P>, init: B, f: F) -> B {
        let mut p = self.f;
        let mut g = f;
        self.it.fold(init, |acc, x| if p(x) { g(acc, x) } else { acc })
    }
}

pub struct Enumerate<I> { it: I, k: i64 }

impl<I: Iterator> Iterator for Enumerate<I> {
    type Item = (i64, I::Item);

    #[inline]
    fn next(self: &mut Enumerate<I>) -> Option<(i64, I::Item)> {
        match self.it.next() {
            Option::Some(x) => {
                let k = self.k;
                self.k = k + 1;
                Option::Some((k, x))
            }
            Option::None => Option::None,
        }
    }

    #[inline]
    fn exact_len(self: &Enumerate<I>) -> i64 {
        self.it.exact_len()
    }

    #[inline]
    fn at(self: &Enumerate<I>, k: i64) -> (i64, I::Item) {
        (self.k + k, self.it.at(k))
    }

    #[inline]
    fn fold<B, F: FnMut(B, (i64, I::Item)) -> B>(self: Enumerate<I>, init: B, f: F) -> B {
        let mut e = self;
        let mut g = f;
        let mut acc = init;
        let n = e.it.exact_len();
        if n >= 0 {
            for k in 0..n {
                acc = g(acc, (e.k + k, e.it.at(k)));
            }
        } else {
            while let Option::Some(p) = e.next() {
                acc = g(acc, p);
            }
        }
        acc
    }
}

pub struct Zip<I, J> { a: I, b: J }

impl<A: Iterator, J: Iterator> Iterator for Zip<A, J> {
    type Item = (A::Item, J::Item);

    #[inline]
    fn next(self: &mut Zip<A, J>) -> Option<(A::Item, J::Item)> {
        match self.a.next() {
            Option::Some(x) => match self.b.next() {
                Option::Some(y) => Option::Some((x, y)),
                Option::None => Option::None,
            },
            Option::None => Option::None,
        }
    }

    #[inline]
    fn exact_len(self: &Zip<A, J>) -> i64 {
        let n = self.a.exact_len();
        let m = self.b.exact_len();
        if n < 0 || m < 0 {
            -1
        } else if n < m {
            n
        } else {
            m
        }
    }

    #[inline]
    fn at(self: &Zip<A, J>, k: i64) -> (A::Item, J::Item) {
        (self.a.at(k), self.b.at(k))
    }

    #[inline]
    fn fold<B, F: FnMut(B, (A::Item, J::Item)) -> B>(self: Zip<A, J>, init: B, f: F) -> B {
        let mut z = self;
        let mut g = f;
        let mut acc = init;
        let n = z.exact_len();
        if n >= 0 {
            for k in 0..n {
                acc = g(acc, (z.a.at(k), z.b.at(k)));
            }
        } else {
            while let Option::Some(p) = z.next() {
                acc = g(acc, p);
            }
        }
        acc
    }
}

pub struct Take<I> { it: I, n: i64 }

impl<I: Iterator> Iterator for Take<I> {
    type Item = I::Item;

    #[inline]
    fn next(self: &mut Take<I>) -> Option<I::Item> {
        if self.n <= 0 {
            return Option::None;
        }
        self.n -= 1;
        self.it.next()
    }

    #[inline]
    fn exact_len(self: &Take<I>) -> i64 {
        let m = self.it.exact_len();
        if m < 0 {
            -1
        } else if self.n <= 0 {
            0
        } else if m < self.n {
            m
        } else {
            self.n
        }
    }

    #[inline]
    fn at(self: &Take<I>, k: i64) -> I::Item {
        self.it.at(k)
    }

    #[inline]
    fn fold<B, F: FnMut(B, I::Item) -> B>(self: Take<I>, init: B, f: F) -> B {
        let mut t = self;
        let mut g = f;
        let mut acc = init;
        let n = t.exact_len();
        if n >= 0 {
            for k in 0..n {
                acc = g(acc, t.it.at(k));
            }
        } else {
            while t.n > 0 {
                match t.it.next() {
                    Option::Some(x) => {
                        t.n -= 1;
                        acc = g(acc, x);
                    }
                    Option::None => break,
                }
            }
        }
        acc
    }
}

// ---- Sources ----
//
// `for` over a SliceIter, a Range or a RangeInclusive is a counted loop
// (front/check/iterate.tach); their `fold` is one too.

// `a..b` as a value: start, start + 1, ..., up to end, end excluded.
pub struct Range<T> { pub start: T, pub end: T }

impl<T> Iterator for Range<T> {
    type Item = T;

    #[inline]
    fn next(self: &mut Range<T>) -> Option<T> {
        if self.start < self.end {
            let x = self.start;
            self.start = x + 1;
            Option::Some(x)
        } else {
            Option::None
        }
    }

    #[inline]
    fn exact_len(self: &Range<T>) -> i64 {
        if self.start < self.end { (self.end - self.start) as i64 } else { 0 }
    }

    #[inline]
    fn at(self: &Range<T>, k: i64) -> T {
        self.start + k as T
    }

    #[inline]
    fn fold<B, F: FnMut(B, T) -> B>(self: Range<T>, init: B, f: F) -> B {
        let mut g = f;
        let mut acc = init;
        for x in self.start..self.end {
            acc = g(acc, x);
        }
        acc
    }
}

// `a..=b` as a value: end included; `done` once `next` gave end.
pub struct RangeInclusive<T> { pub start: T, pub end: T, pub done: bool }

impl<T> Iterator for RangeInclusive<T> {
    type Item = T;

    #[inline]
    fn next(self: &mut RangeInclusive<T>) -> Option<T> {
        if self.done || self.start > self.end {
            return Option::None;
        }
        let x = self.start;
        if x == self.end {
            self.done = true;
        } else {
            self.start = x + 1;
        }
        Option::Some(x)
    }

    #[inline]
    fn exact_len(self: &RangeInclusive<T>) -> i64 {
        if self.done || self.start > self.end { 0 } else { (self.end - self.start) as i64 + 1 }
    }

    #[inline]
    fn at(self: &RangeInclusive<T>, k: i64) -> T {
        self.start + k as T
    }

    #[inline]
    fn fold<B, F: FnMut(B, T) -> B>(self: RangeInclusive<T>, init: B, f: F) -> B {
        let mut g = f;
        let mut acc = init;
        if !self.done {
            for x in self.start..=self.end {
                acc = g(acc, x);
            }
        }
        acc
    }
}

// The items of a slice, by value: `v.iter()`, `s.iter()`.
pub struct SliceIter<T> { s: [T], pos: i64 }

impl<T> Iterator for SliceIter<T> {
    type Item = T;

    #[inline]
    fn next(self: &mut SliceIter<T>) -> Option<T> {
        if self.pos < self.s.len {
            let x = self.s[self.pos];
            self.pos += 1;
            Option::Some(x)
        } else {
            Option::None
        }
    }

    #[inline]
    fn exact_len(self: &SliceIter<T>) -> i64 {
        self.s.len - self.pos
    }

    #[inline]
    fn at(self: &SliceIter<T>, k: i64) -> T {
        self.s[self.pos + k]
    }

    #[inline]
    fn fold<B, F: FnMut(B, T) -> B>(self: SliceIter<T>, init: B, f: F) -> B {
        let mut g = f;
        let mut acc = init;
        let s = self.s;
        for k in self.pos..s.len {
            acc = g(acc, s[k]);
        }
        acc
    }
}

impl<T> SliceIter<T> {
    // The items left, as a slice.
    #[inline]
    #[views(*self)]
    pub fn as_slice(self: &SliceIter<T>) -> [T] {
        self.s[self.pos..self.s.len]
    }
}

impl<T>[T] {
    // Its items, by value.
    #[inline]
    #[views(self)]
    pub fn iter(self: [T]) -> SliceIter<T> {
        SliceIter { s: self, pos: 0 }
    }

    // Its items, by reference (0.17): `for x in s.iter_ref()`, x a `&T`,
    // the elements neither copied nor moved.
    #[inline]
    #[views(self)]
    pub fn iter_ref(self: [T]) -> SliceRefIter<T> {
        SliceRefIter { s: self, pos: 0 }
    }

    // Sorts it in place by f (see sort_by).
    #[inline]
    pub fn sort_by<F: FnMut(&T, &T) -> i64>(self: &mut [T], f: F) {
        sort_by(self, f);
    }

    // Exchanges elements i and j (checked; 0.17).
    #[inline]
    pub fn swap(self: &mut [T], i: i64, j: i64) {
        swap_at::<T>(self, i, j);
    }
}

impl<T, A: Allocator> Vec<T, A> {
    // Its items, by value (a view: valid until the vector grows or is
    // freed).
    #[inline]
    #[views(self)]
    pub fn iter(self: &Vec<T, A>) -> SliceIter<T> {
        SliceIter { s: self.as_slice(), pos: 0 }
    }

    // Its items, by reference (0.17): `for x in v.iter_ref()`, x a `&T`.
    #[inline]
    #[views(self)]
    pub fn iter_ref(self: &Vec<T, A>) -> SliceRefIter<T> {
        SliceRefIter { s: self.as_slice(), pos: 0 }
    }

    // Sorts it in place by f (see sort_by).
    #[inline]
    pub fn sort_by<F: FnMut(&T, &T) -> i64>(self: &mut Vec<T, A>, f: F) {
        sort_by(self.as_mut_slice(), f);
    }
}

// The items of a slice, by reference (0.17): `v.iter_ref()`,
// `s.iter_ref()`; a view of the slice.
pub struct SliceRefIter<T> { s: [T], pos: i64 }

impl<T> Iterator for SliceRefIter<T> {
    type Item = &T;

    #[inline]
    fn next(self: &mut SliceRefIter<T>) -> Option<&T> {
        if self.pos < self.s.len {
            let x = &self.s[self.pos];
            self.pos += 1;
            Option::Some(x)
        } else {
            Option::None
        }
    }

    #[inline]
    fn exact_len(self: &SliceRefIter<T>) -> i64 {
        self.s.len - self.pos
    }

    #[inline]
    fn at(self: &SliceRefIter<T>, k: i64) -> &T {
        &self.s[self.pos + k]
    }
}

// `m.iter()`: (key, value) in slot order, until the map changes. (0.17) A
// view of the map: `states` is its slots' states.
pub struct HashMapIter<K, V> { keys: *K, values: *V, states: [u8], pos: i64, left: i64 }

impl<K, V> Iterator for HashMapIter<K, V> {
    type Item = (K, V);

    #[inline]
    fn next(self: &mut HashMapIter<K, V>) -> Option<(K, V)> {
        for i in self.pos..self.states.len {
            self.pos = i + 1;
            if unsafe { self.states.ptr[i] } == SLOT_FULL {
                self.left -= 1;
                return Option::Some((unsafe { self.keys[i] }, unsafe { self.values[i] }));
            }
        }
        Option::None
    }

    #[inline]
    fn exact_len(self: &HashMapIter<K, V>) -> i64 {
        self.left
    }

    #[inline]
    fn fold<B, F: FnMut(B, (K, V)) -> B>(self: HashMapIter<K, V>, init: B, f: F) -> B {
        let mut g = f;
        let mut acc = init;
        for i in self.pos..self.states.len {
            if unsafe { self.states.ptr[i] } == SLOT_FULL {
                acc = g(acc, (unsafe { self.keys[i] }, unsafe { self.values[i] }));
            }
        }
        acc
    }
}

pub struct Keys<K, V> { it: HashMapIter<K, V> }

impl<K, V> Iterator for Keys<K, V> {
    type Item = K;

    #[inline]
    fn next(self: &mut Keys<K, V>) -> Option<K> {
        match self.it.next() {
            Option::Some(e) => Option::Some(e.0),
            Option::None => Option::None,
        }
    }

    #[inline]
    fn exact_len(self: &Keys<K, V>) -> i64 {
        self.it.left
    }

    #[inline]
    fn fold<B, F: FnMut(B, K) -> B>(self: Keys<K, V>, init: B, f: F) -> B {
        let mut g = f;
        self.it.fold(init, |acc, e| g(acc, e.0))
    }
}

pub struct Values<K, V> { it: HashMapIter<K, V> }

impl<K, V> Iterator for Values<K, V> {
    type Item = V;

    #[inline]
    fn next(self: &mut Values<K, V>) -> Option<V> {
        match self.it.next() {
            Option::Some(e) => Option::Some(e.1),
            Option::None => Option::None,
        }
    }

    #[inline]
    fn exact_len(self: &Values<K, V>) -> i64 {
        self.it.left
    }

    #[inline]
    fn fold<B, F: FnMut(B, V) -> B>(self: Values<K, V>, init: B, f: F) -> B {
        let mut g = f;
        self.it.fold(init, |acc, e| g(acc, e.1))
    }
}

impl<K: Hash + Eq, V, A: Allocator> HashMap<K, V, A> {
    #[inline]
    #[views(self)]
    pub fn iter(self: &HashMap<K, V, A>) -> HashMapIter<K, V> {
        HashMapIter {
            keys: self.keys, values: self.values, states: unsafe { self.states[0..self.cap] },
            pos: 0, left: self.len,
        }
    }

    #[inline]
    #[views(self)]
    pub fn keys(self: &HashMap<K, V, A>) -> Keys<K, V> {
        Keys { it: self.iter() }
    }

    #[inline]
    #[views(self)]
    pub fn values(self: &HashMap<K, V, A>) -> Values<K, V> {
        Values { it: self.iter() }
    }
}

// Sorts s in place by f: f(a, b) is negative, zero or positive as *a goes
// before, with or after *b (`|a, b| a.cmp(b)`: smallest first). A
// heapsort: not stable. (0.17) f takes references; the elements move as
// bits, so any T sorts, owned ones too.
pub fn sort_by<T, F: FnMut(&T, &T) -> i64>(s: &mut [T], f: F) {
    let mut g = f;
    let n = s.len;
    let p = s.ptr;
    let mut start = n / 2;
    let mut end = n;
    // (each round takes one from start or end: n / 2 + n at most; 0.16:
    // counted loops, no effect diverge; every index is below end <= n)
    unsafe {
        for _ in 0..n / 2 + n + 1 {
            // Build the heap from n/2 down, then move its top behind it.
            if start > 0 {
                start -= 1;
            } else {
                end -= 1;
                if end <= 0 {
                    return;
                }
                swap_raw::<T>(p, 0, end);
            }
            let mut root = start;
            for _ in 0..64 {
                let mut child = 2 * root + 1;
                if child >= end {
                    break;
                }
                if child + 1 < end && g(&*(&p[child]), &*(&p[child + 1])) < 0 {
                    child += 1;
                }
                if g(&*(&p[root]), &*(&p[child])) >= 0 {
                    break;
                }
                swap_raw::<T>(p, root, child);
                root = child;
            }
        }
    }
}
