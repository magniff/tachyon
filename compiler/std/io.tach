// ---- Reading stdin and text (0.14) ----
//
// compiler/std/embed.sh appends this file to std.tach (0.15: split from
// it): the same module, `std`. Reading stdin by lines or whole, trimming,
// splitting and parsing text, and a Scanner of tokens and numbers.
//
// (0.15) The convention: an Option means absence (the end of the input,
// nothing found), a Result with an error enum a failure: `read_line` and
// `read_stdin` fail with an IoError, `parse_int` with a ParseIntError,
// `Scanner::next_int` with a ScanError.

// ---- Reading stdin (0.14) ----

// `read_line` and `read_stdin` share one buffer: they can be mixed, but
// not with C's stdio reading (getchar, scanf, fgets), which has its own.
static mut STDIN_BUF: *u8 = 0 as *u8;
static mut STDIN_POS: i64 = 0;
static mut STDIN_LEN: i64 = 0;
const STDIN_BLOCK: i64 = 65536;

// Bytes in STDIN_BUF[STDIN_POS..STDIN_LEN], read if there were none: 1;
// 0 at the end of input, -1 when reading failed.
fn stdin_fill() -> i64 {
    if STDIN_POS < STDIN_LEN {
        return 1;
    }
    if STDIN_BUF == 0 as *u8 {
        STDIN_BUF = unsafe { malloc(STDIN_BLOCK as u64) };
    }
    let n = unsafe { read(0, STDIN_BUF, STDIN_BLOCK as u64) };
    STDIN_POS = 0;
    STDIN_LEN = if n > 0 { n } else { 0 };
    if n > 0 { 1 } else if n == 0 { 0 } else { -1 }
}

// The next line of stdin into `line` (emptied first; 0.16: a Buf on any
// allocator, which it grows), without its '\n'; Ok(false) at the end of
// input.
pub fn read_line<A: Allocator>(line: *Buf<A>) -> Result<bool, IoError> {
    line.clear();
    let mut any = false;
    loop {
        let filled = stdin_fill();
        if filled < 0 {
            return Result::Err(IoError::Read);
        }
        if filled == 0 {
            break;
        }
        any = true;
        let block = unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] };
        for i in 0..block.len {
            if block[i] == '\n' {
                line.push_str(block[..i]);
                STDIN_POS += i + 1;
                return Result::Ok(true);
            }
        }
        line.push_str(block);
        STDIN_POS = STDIN_LEN;
    }
    Result::Ok(any)
}

// All of stdin that is left, in a new Buf on allocator a (the caller
// frees it). It shares a buffer with read_line, not with C's getchar or
// scanf.
pub fn read_stdin_in<A: Allocator>(a: A) -> Result<Buf<A>, IoError> {
    let mut b: Buf<A> = Buf::new_in(a);
    if STDIN_POS < STDIN_LEN {
        b.push_str(unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] });
        STDIN_POS = STDIN_LEN;
    }
    loop {
        b.bytes.reserve(STDIN_BLOCK);
        let room = b.bytes.cap - b.bytes.len;
        let n = unsafe { read(0, &b.bytes.ptr[b.bytes.len], room as u64) };
        if n == 0 {
            return Result::Ok(b);
        }
        if n < 0 {
            b.free();
            return Result::Err(IoError::Read);
        }
        b.bytes.len += n;
    }
}

// ---- Text (0.14) ----

// ASCII whitespace: ' ', '\t', '\n', '\r', vertical tab, form feed.
pub fn is_space(b: u8) -> bool {
    b == ' ' || b == '\t' || b == '\n' || b == '\r' || b == 11 || b == 12
}

// '0' to '9'.
pub fn is_digit(b: u8) -> bool {
    b >= '0' && b <= '9'
}

// s without the whitespace (`is_space`) at its start and end.
pub fn trim(s: [u8]) -> [u8] {
    let mut a = 0;
    let mut b = s.len;
    for _ in 0..s.len {
        if !(a < b && is_space(s[a])) {
            break;
        }
        a += 1;
    }
    for _ in 0..s.len {
        if !(b > a && is_space(s[b - 1])) {
            break;
        }
        b -= 1;
    }
    s[a..b]
}

// s as an integer: an optional '-' or '+', then decimal digits, nothing
// else (no spaces); Err if s is not one or does not fit in an i64.
pub fn parse_int(s: [u8]) -> Result<i64, ParseIntError> {
    let mut i = 0;
    if s.len > 0 && (s[0] == '-' || s[0] == '+') {
        i = 1;
    }
    if i == s.len {
        return Result::Err(ParseIntError::Empty);
    }
    // Summed as a negative number, which reaches the smallest i64.
    let min = -9223372036854775807 - 1;
    let mut n = 0;
    for _ in i..s.len {
        if !is_digit(s[i]) {
            return Result::Err(ParseIntError::InvalidDigit(i));
        }
        let d = (s[i] - '0') as i64;
        if n < min / 10 || (n == min / 10 && d > -(min % 10)) {
            // (a later byte that is not a digit is still that error)
            for k in i..s.len {
                if !is_digit(s[k]) {
                    return Result::Err(ParseIntError::InvalidDigit(k));
                }
            }
            return Result::Err(ParseIntError::Overflow);
        }
        n = n * 10 - d;
        i += 1;
    }
    if s[0] == '-' {
        Result::Ok(n)
    } else if n == min {
        Result::Err(ParseIntError::Overflow)
    } else {
        Result::Ok(-n)
    }
}

#[ambient("read_stdin_in(gpa)")]
pub fn read_stdin() -> Result<Buf, IoError> {
    read_stdin_in(Gpa::ambient())
}

// The parts of s between `sep` bytes, empty ones too, as views of s
// (`split_in("a,,b", ',', gpa)`: "a", "", "b"), in a Vec on allocator a.
// The caller frees the Vec.
pub fn split_in<A: Allocator>(s: [u8], sep: u8, a: A) -> Vec<[u8], A> {
    let mut parts: Vec<[u8], A> = Vec::new_in(a);
    let mut start = 0;
    for i in 0..s.len {
        if s[i] == sep {
            parts.push(s[start..i]);
            start = i + 1;
        }
    }
    parts.push(s[start..]);
    parts
}

#[ambient("split_in(s, sep, gpa)")]
pub fn split(s: [u8], sep: u8) -> Vec<[u8]> {
    split_in(s, sep, Gpa::ambient())
}

#[ambient("split_whitespace_in(s, gpa)")]
pub fn split_whitespace(s: [u8]) -> Vec<[u8]> {
    split_whitespace_in(s, Gpa::ambient())
}

// The runs of non-whitespace in s, as views of s, in a Vec on allocator a.
// The caller frees it.
pub fn split_whitespace_in<A: Allocator>(s: [u8], a: A) -> Vec<[u8], A> {
    let mut words: Vec<[u8], A> = Vec::new_in(a);
    let mut sc = Scanner::new(s);
    while let Option::Some(w) = sc.next_token() {
        words.push(w);
    }
    words
}

// Reads a text (`read_stdin().as_slice()`) front to back, by tokens
// (runs of non-whitespace) and lines, as views of the text.
pub struct Scanner { text: [u8], pos: i64 }

impl Scanner {
    pub fn new(text: [u8]) -> Scanner {
        Scanner { text: text, pos: 0 }
    }

    // The next token; None when only whitespace is left.
    pub fn next_token(self: *Scanner) -> Option<[u8]> {
        let s = self.text;
        let mut i = self.pos;
        for _ in i..s.len {
            if !is_space(s[i]) {
                break;
            }
            i += 1;
        }
        if i >= s.len {
            self.pos = i;
            return Option::None;
        }
        let start = i;
        for _ in i..s.len {
            if is_space(s[i]) {
                break;
            }
            i += 1;
        }
        self.pos = i;
        Option::Some(s[start..i])
    }

    // The next token as an integer (`parse_int`); Err at the end, or if
    // it is not one (it is consumed all the same).
    pub fn next_int(self: *Scanner) -> Result<i64, ScanError> {
        match self.next_token() {
            Option::Some(t) => match parse_int(t) {
                Result::Ok(n) => Result::Ok(n),
                Result::Err(e) => Result::Err(ScanError::Parse(e)),
            },
            Option::None => Result::Err(ScanError::End),
        }
    }

    // The rest of the line, without its '\n'; None at the end of the
    // text ("a\n\nb": "a", "", "b"; "a\n": "a").
    pub fn next_line(self: *Scanner) -> Option<[u8]> {
        let s = self.text;
        if self.pos >= s.len {
            return Option::None;
        }
        let start = self.pos;
        let mut i = start;
        for _ in i..s.len {
            if s[i] == '\n' {
                break;
            }
            i += 1;
        }
        self.pos = if i < s.len { i + 1 } else { i };
        Option::Some(s[start..i])
    }

    // Whether nothing but whitespace is left.
    pub fn is_done(self: *Scanner) -> bool {
        let s = self.text;
        let mut i = self.pos;
        for _ in i..s.len {
            if !is_space(s[i]) {
                break;
            }
            i += 1;
        }
        i >= s.len
    }

    // What is left of the text.
    pub fn rest(self: *Scanner) -> [u8] {
        self.text[self.pos..]
    }
}

// ---- Errors of reading and parsing (0.15) ----

// Reading stdin failed (read_line, read_stdin).
pub enum IoError { Read, Write }

// Why parse_int failed: no digits; the byte at this index is not a digit;
// the number does not fit in an i64.
pub enum ParseIntError { Empty, InvalidDigit(i64), Overflow }

// Why Scanner::next_int failed: no token left; the token is not a number.
pub enum ScanError { End, Parse(ParseIntError) }

impl Display for IoError {
    #[inline]
    fn fmt(self: *IoError, f: *Fmt) {
        match *self {
            IoError::Read => f.str("cannot read the input"),
            IoError::Write => f.str("cannot write the output"),
        }
    }
}

impl Debug for IoError {
    #[inline]
    fn fmt_debug(self: *IoError, f: *Fmt) {
        match *self {
            IoError::Read => f.str("Read"),
            IoError::Write => f.str("Write"),
        }
    }
}

impl Display for ParseIntError {
    #[inline]
    fn fmt(self: *ParseIntError, f: *Fmt) {
        match *self {
            ParseIntError::Empty => f.str("cannot parse an integer from an empty text"),
            ParseIntError::InvalidDigit(i) => {
                f.str("invalid digit at byte ");
                f.display(&i);
            }
            ParseIntError::Overflow => f.str("the number does not fit in an i64"),
        }
    }
}

impl Debug for ParseIntError {
    #[inline]
    fn fmt_debug(self: *ParseIntError, f: *Fmt) {
        match *self {
            ParseIntError::Empty => f.str("Empty"),
            ParseIntError::InvalidDigit(i) => {
                f.str("InvalidDigit(");
                f.debug(&i);
                f.str(")");
            }
            ParseIntError::Overflow => f.str("Overflow"),
        }
    }
}

impl Display for ScanError {
    #[inline]
    fn fmt(self: *ScanError, f: *Fmt) {
        match *self {
            ScanError::End => f.str("no number left: the end of the input"),
            ScanError::Parse(e) => f.display(&e),
        }
    }
}

impl Debug for ScanError {
    #[inline]
    fn fmt_debug(self: *ScanError, f: *Fmt) {
        match *self {
            ScanError::End => f.str("End"),
            ScanError::Parse(e) => {
                f.str("Parse(");
                f.debug(&e);
                f.str(")");
            }
        }
    }
}

// ---- Integer limits (0.15) ----

// The smallest and largest values of the integer types: the same as the
// builtin `i32::MAX`, `u8::MIN`, ... (aliases, from before those).
pub const I8_MIN: i8 = i8::MIN;
pub const I8_MAX: i8 = i8::MAX;
pub const I16_MIN: i16 = i16::MIN;
pub const I16_MAX: i16 = i16::MAX;
pub const I32_MIN: i32 = i32::MIN;
pub const I32_MAX: i32 = i32::MAX;
pub const I64_MIN: i64 = i64::MIN;
pub const I64_MAX: i64 = i64::MAX;
pub const U8_MAX: u8 = u8::MAX;
pub const U16_MAX: u16 = u16::MAX;
pub const U32_MAX: u32 = u32::MAX;
pub const U64_MAX: u64 = u64::MAX;
