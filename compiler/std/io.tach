// std::io: reading stdin (0.20: from flat/io.tach).

use std::{Allocator, Buf, IoError, Result, malloc, read};

// `read_line` and `read_stdin` share one buffer: they can be mixed, but
// not with C's stdio reading (getchar, scanf, fgets), which has its own.
static mut STDIN_BUF: *u8 = 0 as *u8;
static mut STDIN_POS: i64 = 0;
static mut STDIN_LEN: i64 = 0;
const STDIN_BLOCK: i64 = 65536;

// Bytes in STDIN_BUF[STDIN_POS..STDIN_LEN], read if there were none: 1;
// 0 at the end of input, -1 when reading failed.
fn stdin_fill() -> i64 {
    if STDIN_POS < STDIN_LEN {
        return 1;
    }
    if STDIN_BUF == 0 as *u8 {
        STDIN_BUF = unsafe { malloc(STDIN_BLOCK as u64) };
    }
    let n = unsafe { read(0, STDIN_BUF, STDIN_BLOCK as u64) };
    STDIN_POS = 0;
    STDIN_LEN = if n > 0 { n } else { 0 };
    if n > 0 { 1 } else if n == 0 { 0 } else { -1 }
}

// The next line of stdin into `line` (emptied first; 0.16: a Buf on any
// allocator, which it grows), without its '\n'; Ok(false) at the end of
// input.
pub fn read_line<A: Allocator>(line: &mut Buf<A>) -> Result<bool, IoError> {
    line.clear();
    let mut any = false;
    loop {
        let filled = stdin_fill();
        if filled < 0 {
            return Result::Err(IoError::Read);
        }
        if filled == 0 {
            break;
        }
        any = true;
        let block = unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] };
        for i in 0..block.len {
            if block[i] == '\n' {
                line.push_str(block[..i]);
                STDIN_POS += i + 1;
                return Result::Ok(true);
            }
        }
        line.push_str(block);
        STDIN_POS = STDIN_LEN;
    }
    Result::Ok(any)
}

// All of stdin that is left, in a new Buf on allocator a (the caller
// frees it). It shares a buffer with read_line, not with C's getchar or
// scanf.
pub fn read_stdin_in<A: Allocator>(a: A) -> Result<Buf<A>, IoError> {
    let mut b: Buf<A> = Buf::new_in(a);
    if STDIN_POS < STDIN_LEN {
        b.push_str(unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] });
        STDIN_POS = STDIN_LEN;
    }
    loop {
        b.bytes.reserve(STDIN_BLOCK);
        let room = b.bytes.cap - b.bytes.len;
        let n = unsafe { read(0, &b.bytes.ptr[b.bytes.len], room as u64) };
        if n == 0 {
            return Result::Ok(b);
        }
        if n < 0 {
            b.free();
            return Result::Err(IoError::Read);
        }
        b.bytes.len += n;
    }
}
