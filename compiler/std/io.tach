// std::io: reading stdin (0.20: from flat/io.tach); (0.20, B6) io::Error
// and io::Result, Read, Write, BufReader, BufWriter and the standard
// streams (io/error.tach, io/buffered.tach).

pub mod error;
pub mod buffered;

pub use buffered::{
    BufRead, BufReader, BufWriter, Lines, Read, Stderr, Stdin, Stdout, Write, stderr, stdin, stdout,
    writeln,
};
pub use error::{Error, ErrorKind, Result};
use std::{Allocator, Buf, IoError, malloc, read};

// `read_line` and `read_stdin` share one buffer: they can be mixed, but
// not with C's stdio reading (getchar, scanf, fgets), which has its own.
static mut STDIN_BUF: *u8 = 0 as *u8;
static mut STDIN_POS: i64 = 0;
static mut STDIN_LEN: i64 = 0;
const STDIN_BLOCK: i64 = 65536;

// Bytes in STDIN_BUF[STDIN_POS..STDIN_LEN], read if there were none: 1;
// 0 at the end of input, -1 when reading failed.
fn stdin_fill() -> i64 {
    if STDIN_POS < STDIN_LEN {
        return 1;
    }
    if STDIN_BUF == 0 as *u8 {
        STDIN_BUF = unsafe { malloc(STDIN_BLOCK as u64) };
    }
    let n = unsafe { read(0, STDIN_BUF, STDIN_BLOCK as u64) };
    STDIN_POS = 0;
    STDIN_LEN = if n > 0 { n } else { 0 };
    if n > 0 { 1 } else if n == 0 { 0 } else { -1 }
}

// The next line of stdin into `line` (emptied first; 0.16: a Buf on any
// allocator, which it grows), without its '\n'; Ok(false) at the end of
// input.
pub fn read_line<A: Allocator>(line: &mut Buf<A>) -> std::Result<bool, IoError> {
    line.clear();
    let mut any = false;
    loop {
        let filled = stdin_fill();
        if filled < 0 {
            return std::Result::Err(IoError::Read);
        }
        if filled == 0 {
            break;
        }
        any = true;
        let block = unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] };
        for i in 0..block.len {
            if block[i] == '\n' {
                line.push_str(block[..i]);
                STDIN_POS += i + 1;
                return std::Result::Ok(true);
            }
        }
        line.push_str(block);
        STDIN_POS = STDIN_LEN;
    }
    std::Result::Ok(any)
}

// All of stdin that is left, in a new Buf on allocator a (the caller
// frees it). It shares a buffer with read_line, not with C's getchar or
// scanf.
pub fn read_stdin_in<A: Allocator>(a: A) -> std::Result<Buf<A>, IoError> {
    let mut b: Buf<A> = Buf::new_in(a);
    if STDIN_POS < STDIN_LEN {
        b.push_str(unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] });
        STDIN_POS = STDIN_LEN;
    }
    loop {
        b.bytes.reserve(STDIN_BLOCK);
        let room = b.bytes.cap - b.bytes.len;
        let n = unsafe { read(0, &b.bytes.ptr[b.bytes.len], room as u64) };
        if n == 0 {
            return std::Result::Ok(b);
        }
        if n < 0 {
            b.free();
            return std::Result::Err(IoError::Read);
        }
        b.bytes.len += n;
    }
}

// (0.20) Reads up to buf.len bytes of stdin into buf, what read_line has
// buffered first: how many (0 at the end), -1 when reading failed
// (std::io::Stdin).
pub fn __stdin_read(buf: &mut [u8]) -> i64 {
    if STDIN_POS < STDIN_LEN {
        let block = unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] };
        let n = if block.len < buf.len { block.len } else { buf.len };
        for i in 0..n {
            buf[i] = block[i];
        }
        STDIN_POS += n;
        return n;
    }
    let n = unsafe { read(0, buf.ptr, buf.len as u64) };
    if n < 0 { -1 } else { n }
}
