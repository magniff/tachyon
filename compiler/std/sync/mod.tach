// std::sync: atomics, locks and channels (0.21; docs/design/concurrency.md).

pub mod atomic;
pub mod mpsc;

use std::sync::atomic::{AtomicU32, Ordering};
use std::{sys_futex_wait, sys_futex_wake};

// ---- Locks (0.21) ----

// The lock under Mutex and the channels (§2.6): a 32-bit word, 0 unlocked,
// 1 locked, 2 locked with waiters (U. Drepper, "Futexes are tricky",
// mutex 3); the waiters sleep on the word (std's sys_futex_wait: futex on
// Linux, __ulock on macOS). Acquire on lock, release on unlock.
pub struct RawLock { state: AtomicU32 }

impl RawLock {
    #[inline]
    pub fn new() -> RawLock { RawLock { state: AtomicU32::new(0) } }

    // Waits until the lock is free, and takes it.
    #[inline]
    pub fn lock(self: &RawLock) {
        if self.state.compare_exchange(0, 1, Ordering::Acquire, Ordering::Relaxed).is_err() {
            self.lock_contended();
        }
    }

    // Takes the lock when it is free; whether it did.
    #[inline]
    pub fn try_lock(self: &RawLock) -> bool {
        self.state.compare_exchange(0, 1, Ordering::Acquire, Ordering::Relaxed).is_ok()
    }

    fn lock_contended(self: &RawLock) {
        // A short spin first: the holder may be about to let go.
        for _ in 0..100 {
            if self.state.load(Ordering::Relaxed) == 0
                && self.state.compare_exchange(0, 1, Ordering::Acquire, Ordering::Relaxed).is_ok() {
                return;
            }
        }
        while self.state.swap(2, Ordering::Acquire) != 0 {
            unsafe { sys_futex_wait(self.state.as_ptr(), 2); }
        }
    }

    // Lets the lock go (the caller holds it), waking a waiter.
    #[inline]
    pub fn unlock(self: &RawLock) {
        if self.state.swap(0, Ordering::Release) == 2 {
            unsafe { sys_futex_wake(self.state.as_ptr(), false); }
        }
    }
}

// Data behind a lock: only the thread holding it reaches the data. `with`
// locks, runs the closure on the data and unlocks; `lock` gives a guard
// that unlocks when it is dropped. No poisoning: a panic stops the program.
//
//     let m = Mutex::new(0);
//     m.with(|n| *n += 1);
pub struct Mutex<T> { raw: RawLock, data: T }

impl<T> Mutex<T> {
    #[inline]
    pub fn new(v: T) -> Mutex<T> { Mutex { raw: RawLock::new(), data: v } }

    // The data, when nothing else can reach the mutex.
    pub fn into_inner(self: Mutex<T>) -> T {
        let m = self;
        m.data
    }

    // Locks, runs f on the data, unlocks; f's result.
    pub fn with<R, F: FnMut(&mut T) -> R>(self: &Mutex<T>, f: F) -> R {
        self.raw.lock();
        let mut g = f;
        let p = &self.data as *T;
        let r = g(unsafe { &mut *p });
        self.raw.unlock();
        r
    }

    // with, when the lock is free now: Some(f's result), else None.
    pub fn try_with<R, F: FnMut(&mut T) -> R>(self: &Mutex<T>, f: F) -> Option<R> {
        if !self.raw.try_lock() {
            return None;
        }
        let mut g = f;
        let p = &self.data as *T;
        let r = g(unsafe { &mut *p });
        self.raw.unlock();
        Some(r)
    }

    // Locks; the guard unlocks when it is dropped. The caller keeps the
    // guard inside the mutex's life (0.21.0 does not check it yet: the
    // guard holds a raw pointer).
    pub unsafe fn lock(self: &Mutex<T>) -> MutexGuard<T> {
        self.raw.lock();
        MutexGuard { m: self as *Mutex<T> }
    }
}

// A held lock (Mutex::lock): `with` runs a closure on the data, `as_ptr`
// gives its address; dropping the guard unlocks.
pub struct MutexGuard<T> { m: *Mutex<T> }

impl<T> MutexGuard<T> {
    // Runs f on the data; f's result.
    pub fn with<R, F: FnMut(&mut T) -> R>(self: &mut MutexGuard<T>, f: F) -> R {
        let mut g = f;
        unsafe {
            let p = &(*self.m).data as *T;
            g(&mut *p)
        }
    }

    // A raw pointer to the data, valid while the guard is.
    pub fn as_ptr(self: &MutexGuard<T>) -> *T {
        unsafe { &(*self.m).data as *T }
    }
}

impl<T> Drop for MutexGuard<T> {
    fn drop(self: &mut MutexGuard<T>) {
        unsafe { (*self.m).raw.unlock(); }
    }
}
