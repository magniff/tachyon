// std::time: Duration and the clocks (0.20).

use std::{Option, Ord, SYS_CLOCK_MONOTONIC, panic_str};
use std::sys::{SYS_EINTR, SysTimespec, sys_clock_gettime, sys_nanosleep};

// ---- Duration (0.20) ----

// A span of time (docs/design/collections-text-io.md §2.6.3, task A7):
// Rust's std::time::Duration, whole seconds and the nanoseconds under one
// second. Its arithmetic is checked: `checked_*` return None, `saturating_*`
// stop at zero and the largest Duration, and `mul_u32` and `div_u32`
// panic, as Rust's operators do (0.20's public Duration adds `+` and `-`,
// impls of Add and Sub, which panic on overflow). (Rust's `as_millis`,
// `as_micros` and `as_nanos` return u128; here u64, saturating.) Pure: no
// clock is read here; the clocks are `clock_now` and `sleep` below (io).

const NANOS_PER_SEC: u32 = 1000000000;
const NANOS_PER_MILLI: u32 = 1000000;
const NANOS_PER_MICRO: u32 = 1000;
const U64_MAX_VALUE: u64 = 18446744073709551615;

#[derive(Eq, Debug)]
pub struct Duration {
    secs: u64,
    nanos: u32,
}

impl Duration {
    // secs seconds and nanos nanoseconds; nanos past a second carry into
    // the seconds (panics when the seconds overflow).
    pub fn new(secs: u64, nanos: u32) -> Duration {
        if nanos < NANOS_PER_SEC {
            return Duration { secs: secs, nanos: nanos };
        }
        let extra = (nanos / NANOS_PER_SEC) as u64;
        if secs > U64_MAX_VALUE - extra {
            panic_str("overflow in Duration::new");
        }
        Duration { secs: secs + extra, nanos: nanos % NANOS_PER_SEC }
    }

    // Rust's Duration::ZERO and Duration::MAX.
    pub fn zero() -> Duration {
        Duration { secs: 0, nanos: 0 }
    }

    pub fn max_value() -> Duration {
        Duration { secs: U64_MAX_VALUE, nanos: NANOS_PER_SEC - 1 }
    }

    pub fn from_secs(secs: u64) -> Duration {
        Duration { secs: secs, nanos: 0 }
    }

    pub fn from_millis(ms: u64) -> Duration {
        Duration { secs: ms / 1000, nanos: ((ms % 1000) as u32) * NANOS_PER_MILLI }
    }

    pub fn from_micros(us: u64) -> Duration {
        Duration { secs: us / 1000000, nanos: ((us % 1000000) as u32) * NANOS_PER_MICRO }
    }

    pub fn from_nanos(ns: u64) -> Duration {
        Duration { secs: ns / 1000000000, nanos: (ns % 1000000000) as u32 }
    }

    // secs seconds, a float: panics when it is negative, not finite or too
    // large, as Rust's does; rounded to the nearest nanosecond.
    pub fn from_secs_f64(secs: f64) -> Duration {
        match Duration::try_from_secs_f64(secs) {
            Some(d) => d,
            None => panic_str("Duration::from_secs_f64: negative, not finite or overflowing"),
        }
    }

    // from_secs_f64's value, or None where it panics.
    pub fn try_from_secs_f64(secs: f64) -> Option<Duration> {
        if !(secs >= 0.0) || secs >= 18446744073709551616.0 {
            return None;
        }
        let whole = secs as u64;
        let frac = secs - whole as f64;
        var nanos = (frac * 1000000000.0 + 0.5) as u64;
        var s = whole;
        if nanos >= 1000000000 {
            nanos -= 1000000000;
            if s == U64_MAX_VALUE {
                return None;
            }
            s += 1;
        }
        Some(Duration { secs: s, nanos: nanos as u32 })
    }

    pub fn is_zero(self) -> bool {
        self.secs == 0 && self.nanos == 0
    }

    // The whole seconds.
    pub fn as_secs(self) -> u64 {
        self.secs
    }

    pub fn subsec_nanos(self) -> u32 {
        self.nanos
    }

    pub fn subsec_micros(self) -> u32 {
        self.nanos / NANOS_PER_MICRO
    }

    pub fn subsec_millis(self) -> u32 {
        self.nanos / NANOS_PER_MILLI
    }

    // The whole milliseconds (u64::MAX when they do not fit).
    pub fn as_millis(self) -> u64 {
        duration_scaled(self.secs, 1000, (self.nanos / NANOS_PER_MILLI) as u64)
    }

    pub fn as_micros(self) -> u64 {
        duration_scaled(self.secs, 1000000, (self.nanos / NANOS_PER_MICRO) as u64)
    }

    pub fn as_nanos(self) -> u64 {
        duration_scaled(self.secs, 1000000000, self.nanos as u64)
    }

    pub fn as_secs_f64(self) -> f64 {
        self.secs as f64 + self.nanos as f64 / 1000000000.0
    }

    pub fn as_secs_f32(self) -> f32 {
        self.as_secs_f64() as f32
    }

    pub fn as_millis_f64(self) -> f64 {
        self.secs as f64 * 1000.0 + self.nanos as f64 / 1000000.0
    }

    pub fn checked_add(self, other: Duration) -> Option<Duration> {
        if self.secs > U64_MAX_VALUE - other.secs {
            return None;
        }
        var secs = self.secs + other.secs;
        var nanos = self.nanos + other.nanos;
        if nanos >= NANOS_PER_SEC {
            nanos -= NANOS_PER_SEC;
            if secs == U64_MAX_VALUE {
                return None;
            }
            secs += 1;
        }
        Some(Duration { secs: secs, nanos: nanos })
    }

    pub fn checked_sub(self, other: Duration) -> Option<Duration> {
        if self.secs < other.secs {
            return None;
        }
        var secs = self.secs - other.secs;
        var nanos = self.nanos;
        if nanos < other.nanos {
            if secs == 0 {
                return None;
            }
            secs -= 1;
            nanos += NANOS_PER_SEC;
        }
        Some(Duration { secs: secs, nanos: nanos - other.nanos })
    }

    pub fn checked_mul(self, k: u32) -> Option<Duration> {
        let total_nanos = self.nanos as u64 * k as u64;
        let extra = total_nanos / 1000000000;
        let nanos = (total_nanos % 1000000000) as u32;
        if k != 0 && self.secs > U64_MAX_VALUE / k as u64 {
            return None;
        }
        let s = self.secs * k as u64;
        if s > U64_MAX_VALUE - extra {
            return None;
        }
        Some(Duration { secs: s + extra, nanos: nanos })
    }

    // None for k == 0.
    pub fn checked_div(self, k: u32) -> Option<Duration> {
        if k == 0 {
            return None;
        }
        let kk = k as u64;
        let secs = self.secs / kk;
        let carry = self.secs - secs * kk;
        let extra = (carry * 1000000000 + self.nanos as u64) / kk;
        Some(Duration { secs: secs, nanos: extra as u32 })
    }

    pub fn saturating_add(self, other: Duration) -> Duration {
        match self.checked_add(other) {
            Some(d) => d,
            None => Duration::max_value(),
        }
    }

    pub fn saturating_sub(self, other: Duration) -> Duration {
        match self.checked_sub(other) {
            Some(d) => d,
            None => Duration::zero(),
        }
    }

    pub fn saturating_mul(self, k: u32) -> Duration {
        match self.checked_mul(k) {
            Some(d) => d,
            None => Duration::max_value(),
        }
    }

    // self * k; panics on overflow.
    pub fn mul_u32(self, k: u32) -> Duration {
        match self.checked_mul(k) {
            Some(d) => d,
            None => panic_str("overflow when multiplying duration by scalar"),
        }
    }

    // self / k; panics when k is 0.
    pub fn div_u32(self, k: u32) -> Duration {
        match self.checked_div(k) {
            Some(d) => d,
            None => panic_str("divide by zero error when dividing duration by scalar"),
        }
    }

    // self - other, or zero when other is longer (Rust's abs_diff).
    pub fn abs_diff(self, other: Duration) -> Duration {
        match self.checked_sub(other) {
            Some(d) => d,
            None => other.saturating_sub(self),
        }
    }
}

// secs * scale + part, or u64::MAX when it does not fit.
fn duration_scaled(secs: u64, scale: u64, part: u64) -> u64 {
    if secs > (U64_MAX_VALUE - part) / scale {
        return U64_MAX_VALUE;
    }
    secs * scale + part
}

impl Ord for Duration {
    fn cmp(self, other: Duration) -> i64 {
        if self.secs != other.secs {
            if self.secs < other.secs { -1 } else { 1 }
        } else if self.nanos != other.nanos {
            if self.nanos < other.nanos { -1 } else { 1 }
        } else {
            0
        }
    }
}

// ---- Clocks (0.20) ----

// The time of clock (SYS_CLOCK_MONOTONIC: since an arbitrary point, never
// going back; SYS_CLOCK_REALTIME: since 1970) as a Duration (0.20's
// Instant::now and SystemTime::now read these).
pub fn clock_now(clock: i32) -> Duration {
    let t = sys_clock_gettime(clock);
    if t.0 < 0 {
        return Duration::zero();
    }
    Duration { secs: t.0 as u64, nanos: t.1 as u32 }
}

// The monotonic clock's time.
pub fn monotonic_now() -> Duration {
    clock_now(SYS_CLOCK_MONOTONIC)
}

// Sleeps for d at least (Rust's std::thread::sleep): sleeps again for the
// rest when a signal wakes it.
pub fn sleep(d: Duration) {
    let max_secs = 9223372036854775807u64;
    var secs = if d.secs > max_secs { max_secs as i64 } else { d.secs as i64 };
    var nanos = d.nanos as i64;
    // (each round sleeps or ends; a signal per round could repeat it, so the
    // rounds are many but counted)
    for _ in 0..1000000 {
        if secs == 0 && nanos == 0 {
            return;
        }
        var left = SysTimespec { tv_sec: 0, tv_nsec: 0 };
        match sys_nanosleep(secs, nanos, &left) {
            Ok(()) => return,
            Err(e) => {
                if e != SYS_EINTR {
                    return;
                }
                secs = left.tv_sec;
                nanos = left.tv_nsec;
            }
        }
    }
}
