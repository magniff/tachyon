// ---- Testing (0.18) ----

// What `#[property]` tests and `#[fuzz]` targets draw their values from
// (docs/design/contracts-verification.md §2.7, 0.18 T2): a type with an
// `impl Arbitrary` is generated by it, any other generable type
// structurally. Gen reads a choice sequence; shrinking shortens and
// lowers it. Phase 0: the names; T2 gives the bodies (and `&mut Gen` once
// 0.17's references exist).
pub trait Arbitrary {
    fn arbitrary(g: *Gen) -> Self;
}

pub struct Gen { choices: *u64, count: i64, at: i64, size: i64 }

impl Gen {
    // An integer in lo..=hi.
    pub fn int_in(self: *Gen, lo: i64, hi: i64) -> i64 {
        panic_str("Gen is 0.18's (T2), not implemented yet")
    }

    // One of 0..n.
    pub fn choose(self: *Gen, n: i64) -> i64 {
        panic_str("Gen is 0.18's (T2), not implemented yet")
    }

    pub fn bool(self: *Gen) -> bool {
        panic_str("Gen is 0.18's (T2), not implemented yet")
    }

    // The size this case may grow to (it grows with the case number).
    pub fn size(self: *Gen) -> i64 {
        panic_str("Gen is 0.18's (T2), not implemented yet")
    }
}

// x's `{:?}` text against tests/snapshots/MODULE__TEST__N.snap (§2.6).
pub fn assert_snapshot<T: Debug>(x: T) {
    panic_str("assert_snapshot is 0.18's (T2), not implemented yet")
}
