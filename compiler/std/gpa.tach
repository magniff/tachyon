// ---- Gpa's implementation (0.16) ----

// C's allocator; malloc's memory is aligned to 16, larger alignments go
// through posix_memalign. (--check-alloc replaces this part of std with
// alloc_check.tach.)

extern "C" {
    #[effects(alloc(extern))]
    fn posix_memalign(out: **u8, align: u64, size: u64) -> i32;
}

const GPA_MALLOC_ALIGN: i64 = 16;

impl Allocator for Gpa {
    #[inline]
    fn try_alloc(self: *Gpa, size: i64, align: i64) -> *u8 {
        if size == 0 {
            // (a pointer nothing is read through)
            return unsafe { align as *u8 };
        }
        if align > GPA_MALLOC_ALIGN {
            return gpa_aligned(size, align);
        }
        unsafe { malloc(size as u64) }
    }

    #[inline]
    unsafe fn try_resize(self: *Gpa, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
        if align > GPA_MALLOC_ALIGN || new_size == 0 {
            return gpa_resize_slow(p, old_size, new_size, align);
        }
        realloc(if old_size == 0 { 0 as *u8 } else { p }, new_size as u64)
    }

    #[inline]
    unsafe fn free(self: *Gpa, p: *u8, size: i64, align: i64) {
        if size != 0 {
            free(p);
        }
    }
}

// size bytes (not 0) aligned to align (above malloc's), or null.
fn gpa_aligned(size: i64, align: i64) -> *u8 {
    let mut p = 0 as *u8;
    if unsafe { posix_memalign(&p, align as u64, size as u64) } != 0 {
        return 0 as *u8;
    }
    p
}

// Gpa::try_resize to 0 bytes, or above malloc's alignment.
#[cold]
unsafe fn gpa_resize_slow(p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
    if new_size == 0 {
        if old_size != 0 {
            free(p);
        }
        return align as *u8;
    }
    let q = gpa_aligned(new_size, align);
    if q == 0 as *u8 {
        return q;
    }
    let n = if old_size < new_size { old_size } else { new_size };
    for i in 0..n {
        q[i] = p[i];
    }
    if old_size != 0 {
        free(p);
    }
    q
}

// ---- Gpa's leak checks (0.16) ----

impl Gpa {
    // The blocks allocated and not freed: -1, unknown, unless --check-alloc
    // (the checking allocator, compiler/std/alloc_check.tach).
    pub fn live_blocks(self: *Gpa) -> i64 {
        -1
    }

    // Whether no block is left allocated (with --check-alloc, which lists
    // them); always true without.
    pub fn check_leaks(self: *Gpa) -> bool {
        true
    }
}

// ---- The checking allocator's hooks for arenas (0.16) ----

// With --check-alloc (CHECK_ALLOC), arenas route each allocation to the
// checking allocator's pages (compiler/std/alloc_check.tach); without, these
// are never called.

// A block of size bytes for the allocator whose state is at owner.
fn check_alloc_block(owner: u64, size: i64, align: i64) -> *u8 {
    0 as *u8
}

// p, a block of owner of old_size bytes, moved to new_size bytes.
unsafe fn check_alloc_moved(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64)
    -> *u8 {
    0 as *u8
}

// The blocks allocated so far: a mark for check_alloc_release.
fn check_alloc_mark() -> i64 {
    0
}

// Every block of owner allocated after mark given back.
fn check_alloc_release(owner: u64, mark: i64) {}
