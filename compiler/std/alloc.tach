// ---- Allocation (0.16) ----

// Memory comes from allocators: a type implementing Allocator. Containers
// carry theirs as a type parameter (`Vec<T, A: Allocator = Gpa>`), so an
// allocation is a call std can see, and effects name it (`alloc(Gpa)`).
// Allocation is explicit: nothing allocates without being given an
// allocator, `Vec::new_in(a)`, `collect_in(a)`, `format_in(x, a)`. Gpa,
// the general-purpose allocator (C's malloc), is the type parameters'
// default, and a program has one when its main takes it (`gpa: Gpa`, its
// parameter), passed down as a parameter.
//
// Sizes and alignments are in bytes; an alignment is a power of two from 1
// to 4096. Running out of memory, or misusing an allocator, stops the
// program (exit 101): part of the effect `alloc`, not `panic`.

pub trait Allocator {
    // size bytes aligned to align, null when out of memory; size 0: aligned,
    // non-null, unreadable.
    #[effects(alloc, global, panic, diverge, unsafe)]
    fn try_alloc(self: *Self, size: i64, align: i64) -> *u8;
    // p (old_size bytes, from this allocator) as new_size bytes, the first
    // min(old_size, new_size) kept; may move; null: p is left as it was.
    #[effects(alloc, global, panic, diverge, unsafe)]
    unsafe fn try_resize(self: *Self, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8;
    // Gives back p (size bytes, from this allocator).
    #[effects(alloc, global, panic, diverge, unsafe)]
    unsafe fn free(self: *Self, p: *u8, size: i64, align: i64);

    // try_alloc, stopping the program when out of memory.
    #[inline]
    fn alloc(self: *Self, size: i64, align: i64) -> *u8 {
        let p = self.try_alloc(size, align);
        if p == 0 as *u8 {
            out_of_memory();
        }
        p
    }

    // try_resize, stopping the program when out of memory.
    #[inline]
    unsafe fn resize(self: *Self, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
        let q = self.try_resize(p, old_size, new_size, align);
        if q == 0 as *u8 {
            out_of_memory();
        }
        q
    }
}

// Stops the program: an allocator is out of memory.
#[cold]
fn out_of_memory() -> ! {
    unsafe { panic(c"out of memory") }
}

// ---- Gpa ----

// The general-purpose allocator: C's malloc, realloc and free (its
// implementation follows std's source: gpa.tach, or the checking one of
// --check-alloc). Zero-sized, copied freely: a Vec<T> on it is three
// words. Sealed: only the runtime's entry makes one, main's parameter
// `gpa: Gpa`; a static cannot hold one (no constant makes one), so a
// program keeps its containers in main and passes them down.
#[sealed]
pub struct Gpa {}

// ---- Arenas (0.16; not implemented yet: T2) ----

// The arenas' functions until they are made (0.16 T2): they stop the
// program.
#[cold]
fn not_yet() -> ! {
    unsafe { panic(c"arenas and FixedBuf are not implemented yet (0.16)") }
}

// What the try_ functions of containers return when out of memory (T2).
pub enum AllocError { OutOfMemory }

// An arena: allocations bump a pointer through chunks taken from Gpa, and
// are given back all at once. A handle: copies share the arena.
#[sealed]
pub struct Arena { s: *ArenaState }

// An arena's state, in its first chunk.
struct ArenaState { base: *u8, used: i64, cap: i64, limit: i64, chunks: *u8 }

impl Allocator for Arena {
    fn try_alloc(self: *Arena, size: i64, align: i64) -> *u8 {
        not_yet()
    }

    unsafe fn try_resize(self: *Arena, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
        not_yet()
    }

    unsafe fn free(self: *Arena, p: *u8, size: i64, align: i64) {
        not_yet()
    }
}

impl Arena {
    pub fn new() -> Arena {
        not_yet()
    }

    pub fn with_capacity(bytes: i64) -> Arena {
        not_yet()
    }

    // An arena that has no memory yet, a constant (for statics).
    pub fn none() -> Arena {
        Arena { s: 0 as *ArenaState }
    }

    pub fn used(self: *Arena) -> i64 {
        not_yet()
    }

    pub fn chunk_bytes(self: *Arena) -> i64 {
        not_yet()
    }

    // Everything allocated from the arena is given back; its chunks are
    // kept. Unsafe: what was allocated must not be used after.
    pub unsafe fn reset(self: *Arena) {
        not_yet()
    }

    // The arena's memory, chunks included, given back.
    pub unsafe fn free_all(self: *Arena) {
        not_yet()
    }

    // f with a scope of this arena: what f allocates from the ScopedArena is
    // given back when f returns. The arena is lent meanwhile.
    pub fn scope<R, F: FnMut(ScopedArena) -> R>(self: *Arena, f: F) -> R {
        not_yet()
    }
}

// An arena lent to a scope (arena_scope, Arena::scope): nothing allocated
// from it outlives the scope.
#[sealed]
#[scoped]
pub struct ScopedArena { s: *ArenaState, mark: i64 }

impl Allocator for ScopedArena {
    fn try_alloc(self: *ScopedArena, size: i64, align: i64) -> *u8 {
        not_yet()
    }

    unsafe fn try_resize(self: *ScopedArena, p: *u8, old_size: i64, new_size: i64, align: i64)
        -> *u8 {
        not_yet()
    }

    unsafe fn free(self: *ScopedArena, p: *u8, size: i64, align: i64) {
        not_yet()
    }
}

impl ScopedArena {
    pub fn used(self: *ScopedArena) -> i64 {
        not_yet()
    }

    pub fn scope<R, F: FnMut(ScopedArena) -> R>(self: *ScopedArena, f: F) -> R {
        not_yet()
    }
}

// f with a new arena, given back when f returns.
pub fn arena_scope<R, F: FnMut(ScopedArena) -> R>(gpa: Gpa, f: F) -> R {
    not_yet()
}

// An allocator in a fixed buffer of bytes (its count of bytes used in the
// buffer's first 8 bytes).
#[sealed]
pub struct FixedBuf { base: *u8, cap: i64 }

impl Allocator for FixedBuf {
    fn try_alloc(self: *FixedBuf, size: i64, align: i64) -> *u8 {
        not_yet()
    }

    unsafe fn try_resize(self: *FixedBuf, p: *u8, old_size: i64, new_size: i64, align: i64)
        -> *u8 {
        not_yet()
    }

    unsafe fn free(self: *FixedBuf, p: *u8, size: i64, align: i64) {
        not_yet()
    }
}

impl FixedBuf {
    pub fn new(mem: [u8]) -> FixedBuf {
        not_yet()
    }

    pub fn used(self: *FixedBuf) -> i64 {
        not_yet()
    }

    pub unsafe fn reset(self: *FixedBuf) {
        not_yet()
    }
}

// ---- The ambient Gpa of 0.15 (0.16, until the corpus is migrated) ----

// std's ambient constructors of 0.15 (`Vec::new()`, `collect()`...),
// errors outside std, take their Gpa here, until `fix --only alloc016`
// migrates the corpus (front/ambient.tach): not `pub`, it goes with them.
trait Ambient { fn ambient() -> Self; }

impl Ambient for Gpa {
    #[ambient("a 'gpa: Gpa' parameter, from main's")]
    #[inline]
    fn ambient() -> Gpa { Gpa {} }
}
