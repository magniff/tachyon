// std::gpu (0.22, docs/design/gpu.md §2): GPU compute and rendering on
// wgpu's model. On macOS it runs on Metal (std::gpu::hal::metal); a
// program that uses it links libobjc: `tachyonc prog.tach -l objc -o
// prog` (Metal itself is opened at run time).
//
// - The objects are wgpu's: Instance, Adapter, Device and Queue, Buffer
//   (mapping included), Texture and TextureView, Sampler, Shader, the
//   pipelines, BindGroup, Encoder and Commands, the passes, Surface and
//   Frame. Each resource is an owned value: dropping it releases it, also
//   while the GPU still uses it (the work keeps it alive).
// - Passes are closure-scoped: `enc.compute_pass(|pass| { ... })`.
// - Misuse is a contract failure (`requires`, exit 101 with the rule's
//   code: gpu.usage, gpu.align, gpu.range, gpu.layout, gpu.pipeline,
//   gpu.format, gpu.limits, gpu.state, gpu.unsupported); what can fail
//   however correct the program is (no adapter, a shader the driver
//   rejects, a lost device) is a Result.
// - Backends are behind std::gpu::hal: `Api` (compute, memory, copies)
//   and `Render` (pipelines, passes, surfaces). Nothing here assumes a
//   backend's memory model or queue: buffers are reached through
//   map_read, map_write and unmap; `dev.caps()` says what the device can
//   do, and a compute-only backend reports `render: false`.
// - Shaders: `dev.shader(&src)` takes the shader compiler's output for
//   the device's ShaderKind (MSL on Metal): a ShaderSource, the code and
//   its reflection.

pub mod hal;
pub mod shader;
pub mod types;

pub use hal::{Caps, RawSurface};
pub use shader::{
    Binding, BindingType, EntryPoint, Reflection, ShaderKind, ShaderSource, VertexInput,
};
pub use types::{
    AddressMode, Blend, BlendComponent, BlendFactor, BlendOp, BufferUsage, Color, ColorTarget,
    Compare, Cull, DepthState, Filter, Format, FrontFace, IndexFormat, Limits, Load, PipelineState,
    Power, SamplerDesc, ShaderStage, StepMode, TextureDesc, TextureUsage, Topology, VertexAttribute,
    VertexFormat, VertexLayout,
};

use hal::{Api, Render};
use hal::metal as backend;
use std::iter::Range;
use types::{MAX_BIND_GROUPS, MAX_COLOR_TARGETS, MAX_VERTEX_BUFFERS};

extern "C" {
    fn exit(status: i32) -> !;
}

/// The backend of this build (Metal on macOS).
pub type Native = backend::Metal;

type N = backend::Metal;

// ---- GPU: errors (0.22) ----

/// What can fail however correct the program is (§2.7); misuse is a
/// contract failure instead. Messages are the driver's.
pub enum Error {
    NoAdapter,
    DeviceCreation,
    Shader(Buf),
    Pipeline(Buf),
    Submission,
    SurfaceLost,
}

impl Display for Error {
    fn fmt(self: &Error, f: &mut Fmt) {
        match self {
            Error::NoAdapter => f.str("gpu: no adapter"),
            Error::DeviceCreation => f.str("gpu: the device could not be opened"),
            Error::Shader(m) => {
                f.str("gpu: the shader did not compile: ");
                f.str(m.as_slice());
            }
            Error::Pipeline(m) => {
                f.str("gpu: the pipeline was rejected: ");
                f.str(m.as_slice());
            }
            Error::Submission => f.str("gpu: a submission failed (device lost or out of memory)"),
            Error::SurfaceLost => f.str(
                "gpu: the surface has no frame to give (lost, or reconfigure it)"),
        }
    }
}

impl Debug for Error {
    fn fmt_debug(self: &Error, f: &mut Fmt) {
        self.fmt(f);
    }
}

/// The device ran out of memory where the API returns no Result (buffer,
/// texture, sampler creation): the process ends, as an allocation failure
/// of Gpa does.
fn out_of_memory(what: [u8]) -> ! {
    eprintln(f"gpu: out of device memory ({what})");
    // exit is the C library's
    unsafe { exit(101) }
}

// ---- GPU: instance, adapters, devices (0.22) ----

/// The entry point: holds the allocator the devices use for host memory.
pub struct Instance {
    pub gpa: Gpa,
}

impl Instance {
    pub fn new_in(gpa: Gpa) -> Instance {
        Instance { gpa: gpa }
    }

    /// Every adapter of the system.
    pub fn adapters(self: &Instance) -> Vec<Adapter> {
        let gpa = self.gpa;
        let mut out: Vec<Adapter> = Vec::new_in(gpa);
        // the backend's list is scratch: an arena, freed at once
        arena_scope(gpa, |a| {
            let mut raw: Vec<backend::Adapter, ScopedArena> = Vec::new_in(a);
            N::adapters(&mut raw);
            for r in raw.iter() {
                out.push(Adapter { raw: backend::Adapter { dev: r.dev.clone() }, gpa: gpa });
            }
        });
        out
    }

    /// An adapter: the low-power one when asked and there is one.
    pub fn adapter(self: &Instance, power: Power = Power::High) -> Result<Adapter, Error> {
        if power == Power::Low {
            let found = arena_scope(self.gpa, |a| {
                let mut raw: Vec<backend::Adapter, ScopedArena> = Vec::new_in(a);
                N::adapters(&mut raw);
                let mut f: Option<backend::Adapter> = None;
                for r in raw.iter() {
                    if f.is_none() && N::adapter_low_power(r) {
                        f = Some(backend::Adapter { dev: r.dev.clone() });
                    }
                }
                f
            });
            match found {
                Some(a) => return Ok(Adapter { raw: a, gpa: self.gpa }),
                None => {}
            }
        }
        match N::default_adapter() {
            Some(a) => Ok(Adapter { raw: a, gpa: self.gpa }),
            None => Err(Error::NoAdapter),
        }
    }

    /// A surface for a window (or a headless one): its frames are drawn
    /// into and presented. Needs a device whose caps have `surfaces`.
    pub fn surface(self: &Instance, dev: &Device, raw: RawSurface) -> Result<Surface, Error>
        requires dev.caps.surfaces
        else "gpu.unsupported: this device has no surfaces (dev.caps().surfaces)"
        {
        match N::create_surface(&dev.raw, raw) {
            Some(s) => Ok(Surface {
                raw: s, configured: false, width: 0, height: 0, format: Format::Bgra8Unorm
            }),
            None => Err(Error::SurfaceLost),
        }
    }
}

pub struct Adapter {
    pub raw: backend::Adapter,
    pub gpa: Gpa,
}

impl Adapter {
    /// The adapter's name ("Apple M5").
    pub fn name_in<A: Allocator>(self: &Adapter, out: &mut Buf<A>) {
        N::adapter_name(&self.raw, out);
    }

    /// The device and its queue.
    pub fn device(self: &Adapter, limits: Limits = Limits::default()) -> Result<(Device, Queue),
        Error> {
        match N::open(&self.raw) {
            Some((d, q)) => {
                let caps = N::caps(&d);
                Ok((Device { raw: d, gpa: self.gpa, limits: limits, caps: caps }, Queue { raw: q }))
            }
            None => Err(Error::DeviceCreation),
        }
    }
}

pub struct Device {
    pub raw: backend::Device,
    pub gpa: Gpa,
    pub limits: Limits,
    pub caps: Caps,
}

pub struct Queue {
    pub raw: backend::Queue,
}

/// A layout key: the bindings' kinds and slots, so that a bind group made
/// for one pipeline is accepted by another only when their layouts agree.
fn layout_key(entries: [Binding]) -> u64 {
    let mut h: u64 = 0x9e3779b97f4a7c15;
    for b in entries {
        h = std::hash_mix(h, b.binding as u64);
        h = std::hash_mix(h, b.ty as u64);
        h = std::hash_mix(h, b.slot_vertex as u64);
        h = std::hash_mix(h, b.slot_fragment as u64);
        h = std::hash_mix(h, b.slot_compute as u64);
    }
    if h == 0 { 1 } else { h }
}

impl Device {
    pub fn limits(self: &Device) -> Limits {
        self.limits
    }

    /// What the device can do: compute, render, surfaces, its ShaderKind.
    pub fn caps(self: &Device) -> Caps {
        self.caps
    }

    /// n rounded up to the uniform buffer offset alignment.
    pub fn align_uniform(self: &Device, n: i64) -> i64 {
        let a = self.limits.min_uniform_buffer_offset_alignment;
        (n + a - 1) / a * a
    }

    /// A buffer of size bytes, zeroed.
    pub fn buffer(self: &Device, size: i64, usage: u32) -> Buffer
        requires size >= 0 && size <= self.limits.max_buffer_size
        else "gpu.limits: a buffer's size is 0..limits.max_buffer_size"
        requires usage != 0 else "gpu.usage: a buffer needs a usage"
    {
        match N::create_buffer(&self.raw, size, "") {
            Some(b) => Buffer { raw: b, size: size, usage: usage, mapped: false },
            None => out_of_memory("buffer"),
        }
    }

    /// A buffer holding a copy of bytes.
    pub fn buffer_init(self: &Device, bytes: [u8], usage: u32) -> Buffer
        requires bytes.len() <= self.limits.max_buffer_size
        else "gpu.limits: a buffer's size is 0..limits.max_buffer_size"
        requires usage != 0 else "gpu.usage: a buffer needs a usage"
    {
        match N::create_buffer(&self.raw, bytes.len(), bytes) {
            Some(b) => Buffer { raw: b, size: bytes.len(), usage: usage, mapped: false },
            None => out_of_memory("buffer"),
        }
    }

    /// A 2D texture (a 2D array when layers > 1).
    pub fn texture(self: &Device, width: i64, height: i64, format: Format,
        usage: u32 = TextureUsage::TEXTURE_BINDING | TextureUsage::COPY_DST, layers: i64 = 1,
        mips: i64 = 1) -> Texture
        requires self.caps.textures
        else "gpu.unsupported: this device has no textures (dev.caps().textures)"
        requires width >= 1 && height >= 1 && width <= self.limits.max_texture_dimension_2d
        && height <= self.limits.max_texture_dimension_2d
        else "gpu.limits: a texture's sides are 1..limits.max_texture_dimension_2d"
        requires layers >= 1 && layers <= self.limits.max_texture_array_layers && mips >= 1
        else "gpu.limits: layers and mips"
        requires usage != 0 else "gpu.usage: a texture needs a usage"
        requires usage & TextureUsage::STORAGE_BINDING == 0 || format.is_storable()
        else "gpu.format: STORAGE_BINDING needs a storable format"
        requires usage & TextureUsage::RENDER_ATTACHMENT == 0 || self.caps.render
        else "gpu.unsupported: RENDER_ATTACHMENT on a device without render"
        {
        let desc = TextureDesc {
            width: width, height: height, layers: layers, mips: mips, format: format, usage: usage
        };
        match N::create_texture(&self.raw, &desc) {
            Some(t) => Texture { raw: t, desc: desc },
            None => out_of_memory("texture"),
        }
    }

    pub fn sampler(self: &Device, desc: &SamplerDesc) -> Sampler
        requires self.caps.textures
        else "gpu.unsupported: this device has no samplers (dev.caps().textures)"
        requires desc.anisotropy >= 1 && desc.anisotropy <= 16
        else "gpu.limits: anisotropy is 1..16"
        {
        match N::create_sampler(&self.raw, desc) {
            Some(s) => Sampler { raw: s, comparison: desc.compare.is_some() },
            None => out_of_memory("sampler"),
        }
    }

    /// A shader module from the shader compiler's output for this device
    /// (`caps().shader_kind`: MSL on Metal). What it keeps of the source
    /// is copied.
    pub fn shader(self: &Device, src: &ShaderSource) -> Result<Shader, Error>
        requires src.kind == self.caps.shader_kind
        else "gpu.format: the shader is not of this device's ShaderKind (dev.caps().shader_kind)"
        {
        let mut err = Buf::new_in(self.gpa);
        match N::create_shader(&self.raw, src, &mut err) {
            Some(s) => {
                let mut entries: Vec<ShaderEntry> = Vec::new_in(self.gpa);
                for e in src.reflection.entries.iter() {
                    entries.push(ShaderEntry {
                        name: Buf::from_in(e.name, self.gpa),
                        native: Buf::from_in(e.native, self.gpa), stage: e.stage,
                        workgroup: e.workgroup
                    });
                }
                let mut bindings: Vec<Binding> = Vec::new_in(self.gpa);
                bindings.extend_from_slice(src.reflection.bindings.as_slice());
                let mut inputs: Vec<VertexInput> = Vec::new_in(self.gpa);
                inputs.extend_from_slice(src.reflection.inputs.as_slice());
                Ok(Shader { raw: s, entries: entries, bindings: bindings, inputs: inputs })
            }
            None => Err(Error::Shader(err)),
        }
    }

    /// A compute pipeline for the entry point `entry` of the shader; its
    /// bind layouts come from the shader's reflection.
    pub fn compute_pipeline(self: &Device, shader: &Shader, entry: [u8]) -> Result<ComputePipeline,
        Error>
        requires self.caps.compute
        else "gpu.unsupported: this device has no compute (dev.caps().compute)"
        {
        let e = match shader.entry(entry, ShaderStage::COMPUTE) {
            Some(e) => e,
            None => return Err(
                Error::Pipeline(format_in(f"no compute entry point '{entry}' in the shader",
                    self.gpa))),
        };
        let wg = e.workgroup;
        let l = self.limits;
        assert(wg[0] >= 1 && wg[1] >= 1 && wg[2] >= 1,
            "gpu.limits: a workgroup size is at least 1");
        assert(wg[0] <= l.max_compute_workgroup_size_x && wg[1] <= l.max_compute_workgroup_size_y
            && wg[2] <= l.max_compute_workgroup_size_z, "gpu.limits: workgroup size");
        assert(wg[0] * wg[1] * wg[2] <= l.max_compute_invocations_per_workgroup,
            "gpu.limits: invocations per workgroup");
        let mut err = Buf::new_in(self.gpa);
        match N::create_compute_pipeline(&self.raw, &shader.raw, &e, &mut err) {
            Some(p) => {
                let mut out = ComputePipeline { raw: p, layouts: Layouts::new(), workgroup: wg };
                out.layouts.merge_stage(shader.bindings.as_slice(), ShaderStage::COMPUTE);
                Ok(out)
            }
            None => Err(Error::Pipeline(err)),
        }
    }

    /// A render pipeline.
    pub fn render_pipeline(self: &Device, desc: &RenderDesc) -> Result<RenderPipeline, Error>
        requires self.caps.render
        else "gpu.unsupported: this device does not render (dev.caps().render)"
        requires desc.state.buffer_count <= self.limits.max_vertex_buffers
        else "gpu.limits: vertex buffers"
        requires desc.state.target_count >= 0
        && desc.state.target_count <= self.limits.max_color_attachments
        else "gpu.limits: color targets"
        {
        let vs = match desc.vertex.entry(desc.vs, ShaderStage::VERTEX) {
            Some(e) => e,
            None => return Err(
                Error::Pipeline(format_in(f"no vertex entry point '{desc.vs}' in the shader",
                    self.gpa))),
        };
        let mut fs = vs;
        if desc.has_fs {
            fs = match desc.fragment.entry(desc.fs, ShaderStage::FRAGMENT) {
                Some(e) => e,
                None => return Err(
                    Error::Pipeline(format_in(f"no fragment entry point '{desc.fs}' in the shader",
                        self.gpa))),
            };
        }
        let st = desc.state;
        for i in 0..st.buffer_count {
            let l = st.buffers[i];
            assert(l.stride >= 0 && l.stride % 4 == 0,
                "gpu.align: a vertex buffer's stride is a multiple of 4");
            for k in 0..l.count {
                let a = l.attributes[k];
                assert(a.offset % 4 == 0,
                    "gpu.align: a vertex attribute's offset is a multiple of 4");
                assert(a.offset + a.format.size() <= l.stride
                    || (l.stride == 0 && l.step == StepMode::Instance),
                    "gpu.range: a vertex attribute reaches past its stride");
            }
        }
        // every vertex input of the shader is fed by an attribute
        for inp in desc.vertex.inputs.iter() {
            let mut fed = false;
            for i in 0..st.buffer_count {
                let l = st.buffers[i];
                for k in 0..l.count {
                    if l.attributes[k].location == inp.location {
                        fed = true;
                        assert(l.attributes[k].format == inp.format, "gpu.format: a vertex attribute's format differs from the shader's input");
                    }
                }
            }
            assert(fed,
                "gpu.layout: a vertex input of the shader has no attribute (desc.vertex_buffer)");
        }
        for i in 0..st.target_count {
            assert(!st.targets[i].format.is_depth(),
                "gpu.format: a color target of a depth format");
        }
        match st.depth {
            Some(d) => assert(d.format.is_depth(),
                "gpu.format: the depth state needs a depth format"),
            None => {}
        }
        let mut err = Buf::new_in(self.gpa);
        match N::create_render_pipeline(&self.raw, &desc.vertex.raw, &vs, &desc.fragment.raw, &fs,
            desc.has_fs, &st, &mut err) {
            Some(p) => {
                let mut out = RenderPipeline { raw: p, layouts: Layouts::new(), state: st };
                out.layouts.merge_stage(desc.vertex.bindings.as_slice(), ShaderStage::VERTEX);
                if desc.has_fs {
                    out.layouts.merge_stage(desc.fragment.bindings.as_slice(),
                        ShaderStage::FRAGMENT);
                }
                Ok(out)
            }
            None => Err(Error::Pipeline(err)),
        }
    }

    /// A bind group for `layout` (from `pipe.bind_layout(i)`): one entry per
    /// binding of the layout, in any order.
    pub fn bind_group(self: &Device, layout: BindLayout, entries: [BindEntry]) -> BindGroup
        requires entries.len() == layout.count
        else "gpu.layout: a bind group has one entry for each binding of its layout"
        {
        let mut g = N::bind_group_new(&self.raw);
        for k in 0..layout.count {
            let b = layout.entries[k];
            let mut found = 0;
            for e in entries {
                if e.binding != b.binding { continue; }
                found += 1;
                match e.res {
                    Resource::Buffer(buf, offset, size) => {
                        assert(b.ty.is_buffer(),
                            "gpu.layout: a buffer at a binding that is not one");
                        let need = if b.ty == BindingType::Uniform { BufferUsage::UNIFORM }
                            else { BufferUsage::STORAGE };
                        assert(buf.usage & need != 0, "gpu.usage: a buffer bound as uniform or storage was created without that usage");
                        assert(!buf.mapped, "gpu.state: the buffer is mapped: unmap it first");
                        let align = if b.ty
                            == BindingType::Uniform {
                            self.limits.min_uniform_buffer_offset_alignment
                        } else { self.limits.min_storage_buffer_offset_alignment };
                        assert(offset % align == 0, "gpu.align: a binding's offset is a multiple of the device's alignment (dev.align_uniform(n))");
                        let n = if size < 0 { buf.size - offset } else { size };
                        assert(offset >= 0 && n >= b.min_size && offset + n <= buf.size, "gpu.range: a binding reaches past its buffer, or is smaller than the shader's");
                        N::bind_group_buffer(&mut g, &b, &buf.raw, offset, n);
                    }
                    Resource::Texture(v) => {
                        assert(b.ty.is_texture(),
                            "gpu.layout: a texture at a binding that is not one");
                        let need = if b.ty
                            == BindingType::StorageTexture { TextureUsage::STORAGE_BINDING }
                            else { TextureUsage::TEXTURE_BINDING };
                        assert(v.usage & need != 0,
                            "gpu.usage: a texture bound without TEXTURE_BINDING or STORAGE_BINDING");
                        N::bind_group_texture(&mut g, &b, &v.raw);
                    }
                    Resource::Sampler(s) => {
                        assert(b.ty.is_sampler(),
                            "gpu.layout: a sampler at a binding that is not one");
                        assert(s.comparison == (b.ty == BindingType::ComparisonSampler), "gpu.layout: a comparison sampler where a plain one is bound, or the reverse");
                        N::bind_group_sampler(&mut g, &b, &s.raw);
                    }
                }
            }
            assert(found == 1, "gpu.layout: each binding of the layout is given once");
        }
        BindGroup { raw: g, key: layout.key }
    }

    /// A command encoder.
    pub fn encoder(self: &Device) -> Encoder {
        Encoder { raw: N::begin(&self.raw), limits: self.limits, caps: self.caps }
    }

    /// Waits until the GPU has finished everything submitted.
    pub fn wait_idle(self: &Device) {
        N::device_wait_idle(&self.raw);
    }
}

impl Queue {
    /// Submits recorded commands; they run after everything submitted
    /// before.
    pub fn submit(self: &mut Queue, cmds: Commands) {
        let mut c = cmds;
        N::submit(&mut self.raw, &mut c.raw);
    }

    /// Writes bytes into buf at offset, before the commands submitted next
    /// run (and after the ones submitted before).
    pub fn write_buffer(self: &mut Queue, buf: &Buffer, offset: i64, bytes: [u8])
        requires buf.usage & BufferUsage::COPY_DST != 0
        else "gpu.usage: write_buffer needs COPY_DST"
        requires offset % 4 == 0 && bytes.len() % 4 == 0
        else "gpu.align: write_buffer's offset and size are multiples of 4"
        requires offset >= 0 && offset + bytes.len() <= buf.size
        else "gpu.range: write_buffer reaches past the buffer"
        requires !buf.mapped else "gpu.state: the buffer is mapped: unmap it first"
    {
        N::write_buffer(&mut self.raw, &buf.raw, offset, bytes);
    }

    /// Writes rows of texels into layer `layer` of tex at (x, y): h rows of
    /// bytes_per_row bytes each, w texels used of each row.
    pub fn write_texture(self: &mut Queue, tex: &Texture, bytes: [u8], bytes_per_row: i64,
        x: i64 = 0, y: i64 = 0, w: i64 = -1, h: i64 = -1, layer: i64 = 0)
        requires tex.desc.usage & TextureUsage::COPY_DST != 0
        else "gpu.usage: write_texture needs COPY_DST"
        requires layer >= 0 && layer < tex.desc.layers else "gpu.range: no such layer"
    {
        let ww = if w < 0 { tex.desc.width - x } else { w };
        let hh = if h < 0 { tex.desc.height - y } else { h };
        assert(x >= 0 && y >= 0 && ww >= 1 && hh >= 1 && x + ww <= tex.desc.width
            && y + hh <= tex.desc.height, "gpu.range: the region is outside the texture");
        assert(bytes_per_row >= ww * tex.desc.format.size(),
            "gpu.range: bytes_per_row is shorter than a row");
        assert(bytes.len() >= bytes_per_row * (hh - 1) + ww * tex.desc.format.size(),
            "gpu.range: fewer bytes than the region");
        N::write_texture(&mut self.raw, &tex.raw, layer, x, y, ww, hh, bytes, bytes_per_row);
    }

    /// Waits until everything submitted has finished.
    pub fn wait_idle(self: &mut Queue) -> Result<(), Error> {
        if N::queue_wait_idle(&mut self.raw) { Ok(()) } else { Err(Error::Submission) }
    }
}

// ---- GPU: buffers, textures, samplers, shaders (0.22) ----

pub struct Buffer {
    pub raw: backend::Buffer,
    pub size: i64,
    pub usage: u32,
    pub mapped: bool,
}

impl Buffer {
    pub fn size(self: &Buffer) -> i64 {
        self.size
    }

    pub fn usage(self: &Buffer) -> u32 {
        self.usage
    }

    /// The buffer's bytes once the GPU has finished every submitted
    /// command (it waits): a view of the buffer, which cannot be used
    /// while the view is.
    pub fn map_read(self: &mut Buffer, dev: &Device) -> [u8]
        requires self.usage & BufferUsage::MAP_READ != 0 else "gpu.usage: map_read needs MAP_READ"
    {
        N::device_wait_idle(&dev.raw);
        N::map_read(&dev.raw, &mut self.raw)
    }

    /// The buffer's bytes to write, once the GPU has finished with it; the
    /// writes reach the GPU at `unmap`, which must come before the buffer
    /// is used again.
    pub fn map_write(self: &mut Buffer, dev: &Device) -> &mut [u8]
        requires self.usage & BufferUsage::MAP_WRITE != 0
        else "gpu.usage: map_write needs MAP_WRITE"
        {
        N::device_wait_idle(&dev.raw);
        self.mapped = true;
        N::map_write(&dev.raw, &mut self.raw)
    }

    /// Ends a map_write: what was written reaches the GPU.
    pub fn unmap(self: &mut Buffer, dev: &Device) {
        N::unmap(&dev.raw, &mut self.raw);
        self.mapped = false;
    }
}

pub struct Texture {
    pub raw: backend::Texture,
    pub desc: TextureDesc,
}

impl Texture {
    pub fn width(self: &Texture) -> i64 {
        self.desc.width
    }

    pub fn height(self: &Texture) -> i64 {
        self.desc.height
    }

    pub fn format(self: &Texture) -> Format {
        self.desc.format
    }

    pub fn usage(self: &Texture) -> u32 {
        self.desc.usage
    }

    /// A view of the whole texture (it keeps the texture alive).
    pub fn view(self: &Texture) -> TextureView {
        self.view_as(self.desc.format)
    }

    /// A view reading the texels as another format of the same size
    /// (Rgba8Unorm as Rgba8UnormSrgb).
    pub fn view_as(self: &Texture, format: Format) -> TextureView
        requires format.size() == self.desc.format.size()
        && format.is_depth() == self.desc.format.is_depth()
        else "gpu.format: a view's format has its texture's texel size"
        {
        match N::create_view(&self.raw, format, format == self.desc.format) {
            Some(v) => TextureView {
                raw: v, format: format, width: self.desc.width, height: self.desc.height,
                usage: self.desc.usage
            },
            None => out_of_memory("texture view"),
        }
    }
}

pub struct TextureView {
    pub raw: backend::TextureView,
    pub format: Format,
    pub width: i64,
    pub height: i64,
    pub usage: u32,
}

pub struct Sampler {
    pub raw: backend::Sampler,
    pub comparison: bool,
}

/// An entry point of a Shader, its names copied.
pub struct ShaderEntry {
    pub name: Buf,
    pub native: Buf,
    pub stage: u32,
    pub workgroup: [i64; 3],
}

pub struct Shader {
    pub raw: backend::Shader,
    pub entries: Vec<ShaderEntry>,
    pub bindings: Vec<Binding>,
    pub inputs: Vec<VertexInput>,
}

impl Shader {
    /// The entry point of that name and stage (its names view the
    /// shader's copies).
    pub fn entry(self: &Shader, name: [u8], stage: u32) -> Option<EntryPoint> {
        for e in self.entries.iter() {
            if e.name.as_slice() == name && e.stage == stage {
                return Some(EntryPoint {
                    name: e.name.as_slice(), native: e.native.as_slice(), stage: e.stage,
                    workgroup: e.workgroup
                });
            }
        }
        None
    }
}

// ---- GPU: bind layouts and groups (0.22) ----

/// The bindings of one group as a pipeline sees them: plain data, kept in
/// the pipeline (no allocation).
pub struct BindLayout {
    pub group: i64,
    pub entries: [Binding; 16],
    pub count: i64,
    pub key: u64,
}

/// A pipeline's layouts, groups 0..MAX_BIND_GROUPS.
pub struct Layouts {
    pub groups: [BindLayout; 4],
    pub used: i64,
}

impl Layouts {
    fn new() -> Layouts {
        let none = Binding {
            group: 0, binding: 0, ty: BindingType::Uniform, slot_vertex: -1, slot_fragment: -1,
            slot_compute: -1, min_size: 0
        };
        let l = BindLayout { group: 0, entries: [none; 16], count: 0, key: 0 };
        let mut out = Layouts { groups: [l; 4], used: 0 };
        for i in 0..MAX_BIND_GROUPS {
            out.groups[i].group = i;
        }
        out
    }

    /// Adds the bindings a stage uses; a binding seen from two stages is
    /// one entry with both slots.
    fn merge_stage(self: &mut Layouts, bindings: [Binding], stage: u32) {
        for b in bindings {
            if b.visibility() & stage == 0 { continue; }
            assert(b.group >= 0 && b.group < MAX_BIND_GROUPS, "gpu.limits: bind groups 0..3");
            let gi = b.group;
            let mut merged = false;
            for k in 0..self.groups[gi].count {
                let mut e = self.groups[gi].entries[k];
                if e.binding == b.binding {
                    assert(e.ty == b.ty,
                        "gpu.layout: two stages see one binding as different kinds");
                    if stage == ShaderStage::VERTEX { e.slot_vertex = b.slot_vertex; }
                    if stage == ShaderStage::FRAGMENT { e.slot_fragment = b.slot_fragment; }
                    if stage == ShaderStage::COMPUTE { e.slot_compute = b.slot_compute; }
                    self.groups[gi].entries[k] = e;
                    merged = true;
                }
            }
            if !merged {
                let n = self.groups[gi].count;
                assert(n < 16, "gpu.limits: 16 bindings a group");
                let mut e = b;
                if stage != ShaderStage::VERTEX { e.slot_vertex = -1; }
                if stage != ShaderStage::FRAGMENT { e.slot_fragment = -1; }
                if stage != ShaderStage::COMPUTE { e.slot_compute = -1; }
                self.groups[gi].entries[n] = e;
                self.groups[gi].count = n + 1;
            }
            if gi + 1 > self.used { self.used = gi + 1; }
        }
        for i in 0..MAX_BIND_GROUPS {
            let n = self.groups[i].count;
            self.groups[i].key = if n == 0 { 0 } else { layout_key(self.groups[i].entries[0..n]) };
        }
    }
}

/// A resource bound at a binding: a buffer range (size -1: to the end), a
/// texture view or a sampler.
pub enum Resource {
    Buffer(&Buffer, i64, i64),
    Texture(&TextureView),
    Sampler(&Sampler),
}

pub struct BindEntry {
    pub binding: i64,
    pub res: Resource,
}

/// The whole of a buffer at `binding`.
pub fn bind(binding: i64, buf: &Buffer) -> BindEntry {
    BindEntry { binding: binding, res: Resource::Buffer(buf, 0, -1) }
}

/// size bytes of a buffer from offset at `binding`.
pub fn bind_range(binding: i64, buf: &Buffer, offset: i64, size: i64) -> BindEntry {
    BindEntry { binding: binding, res: Resource::Buffer(buf, offset, size) }
}

pub fn bind_texture(binding: i64, view: &TextureView) -> BindEntry {
    BindEntry { binding: binding, res: Resource::Texture(view) }
}

pub fn bind_sampler(binding: i64, s: &Sampler) -> BindEntry {
    BindEntry { binding: binding, res: Resource::Sampler(s) }
}

/// Resources bound together (the group keeps them alive).
pub struct BindGroup {
    pub raw: backend::BindGroup,
    pub key: u64,
}

// ---- GPU: pipelines (0.22) ----

pub struct ComputePipeline {
    pub raw: backend::ComputePipeline,
    pub layouts: Layouts,
    pub workgroup: [i64; 3],
}

impl ComputePipeline {
    /// The layout of group i, for `dev.bind_group`.
    pub fn bind_layout(self: &ComputePipeline, i: i64) -> BindLayout
        requires i >= 0 && i < MAX_BIND_GROUPS else "gpu.limits: bind groups 0..3"
    {
        self.layouts.groups[i]
    }
}

pub struct RenderPipeline {
    pub raw: backend::RenderPipeline,
    pub layouts: Layouts,
    pub state: PipelineState,
}

impl RenderPipeline {
    pub fn bind_layout(self: &RenderPipeline, i: i64) -> BindLayout
        requires i >= 0 && i < MAX_BIND_GROUPS else "gpu.limits: bind groups 0..3"
    {
        self.layouts.groups[i]
    }
}

/// A render pipeline's description: shaders and entry points, then the
/// fixed-function state (PipelineState) with its builder methods.
pub struct RenderDesc {
    pub vertex: &Shader,
    pub vs: [u8],
    pub fragment: &Shader,
    pub fs: [u8],
    pub has_fs: bool,
    pub state: PipelineState,
}

impl RenderDesc {
    /// Vertex entry `vs` and fragment entry `fs` of one shader, drawing
    /// into one target of `format`.
    pub fn new(shader: &Shader, vs: [u8], fs: [u8], format: Format) -> RenderDesc {
        RenderDesc {
            vertex: shader, vs: vs, fragment: shader, fs: fs, has_fs: true,
            state: PipelineState::new(format)
        }
    }

    /// No fragment stage (depth only).
    pub fn no_fragment(self: &mut RenderDesc) {
        self.has_fs = false;
        self.state.target_count = 0;
    }

    /// A vertex buffer's layout, at the next slot.
    pub fn vertex_buffer(self: &mut RenderDesc, layout: VertexLayout)
        requires self.state.buffer_count < MAX_VERTEX_BUFFERS
        else "gpu.limits: at most 8 vertex buffers"
        {
        self.state.buffers[self.state.buffer_count] = layout;
        self.state.buffer_count += 1;
    }

    /// Blending for target i (0: the first).
    pub fn blend(self: &mut RenderDesc, blend: Blend, target: i64 = 0)
        requires target >= 0 && target < self.state.target_count
        else "gpu.range: no such color target"
        {
        self.state.targets[target].blend = Some(blend);
    }

    /// Another color target.
    pub fn target(self: &mut RenderDesc, format: Format)
        requires self.state.target_count < MAX_COLOR_TARGETS
        else "gpu.limits: at most 8 color targets"
        {
        self.state.targets[self.state.target_count] = ColorTarget {
            format: format, blend: None, write_mask: 15
        };
        self.state.target_count += 1;
    }

    pub fn depth(self: &mut RenderDesc, format: Format = Format::Depth32Float,
        compare: Compare = Compare::Less, write: bool = true) {
        self.state.depth = Some(DepthState { format: format, write: write, compare: compare });
    }

    pub fn topology(self: &mut RenderDesc, t: Topology) {
        self.state.topology = t;
    }

    pub fn cull(self: &mut RenderDesc, c: Cull, front: FrontFace = FrontFace::Ccw) {
        self.state.cull = c;
        self.state.front_face = front;
    }
}

// ---- GPU: encoders and passes (0.22) ----

pub struct Encoder {
    pub raw: backend::CommandBuffer,
    pub limits: Limits,
    pub caps: Caps,
}

/// Recorded commands, for `queue.submit` (dropped unsubmitted: discarded).
pub struct Commands {
    pub raw: backend::CommandBuffer,
}

/// The bind group keys a pass has bound, against a pipeline's layouts.
struct Bindings {
    bound: [u64; 4],
    want: [u64; 4],
    used: i64,
    has_pipeline: bool,
}

impl Bindings {
    fn new() -> Bindings {
        Bindings { bound: [0, 0, 0, 0], want: [0, 0, 0, 0], used: 0, has_pipeline: false }
    }

    fn set_pipeline(self: &mut Bindings, l: &Layouts) {
        self.has_pipeline = true;
        self.used = l.used;
        for i in 0..MAX_BIND_GROUPS {
            self.want[i] = l.groups[i].key;
        }
    }

    fn set_group(self: &mut Bindings, i: i64, key: u64)
        requires i >= 0 && i < MAX_BIND_GROUPS else "gpu.limits: bind groups 0..3"
    {
        assert(!self.has_pipeline || self.want[i] == 0 || self.want[i] == key, "gpu.layout: the bind group was made for another layout (make it from pipe.bind_layout(i))");
        self.bound[i] = key;
    }

    /// Before a draw or dispatch: a pipeline, and a matching group for each
    /// group it uses.
    fn ready(self: &Bindings) {
        assert(self.has_pipeline, "gpu.pipeline: set a pipeline before drawing or dispatching");
        for i in 0..self.used {
            assert(self.want[i] == 0 || self.bound[i] == self.want[i],
                "gpu.pipeline: a bind group the pipeline uses is not set (pass.set_bind_group)");
        }
    }
}

pub struct ComputePass {
    raw: backend::ComputeEncoder,
    binds: Bindings,
    max_groups: i64,
}

impl ComputePass {
    pub fn set_pipeline(self: &mut ComputePass, p: &ComputePipeline) {
        self.binds.set_pipeline(&p.layouts);
        N::compute_set_pipeline(&mut self.raw, &p.raw);
    }

    pub fn set_bind_group(self: &mut ComputePass, i: i64, g: &BindGroup) {
        self.binds.set_group(i, g.key);
        N::compute_set_bind_group(&mut self.raw, &g.raw);
    }

    /// x * y * z workgroups of the pipeline's workgroup size.
    pub fn dispatch(self: &mut ComputePass, x: i64, y: i64 = 1, z: i64 = 1)
        requires x >= 0 && y >= 0 && z >= 0 && x <= self.max_groups && y <= self.max_groups
        && z <= self.max_groups else "gpu.limits: workgroups per dimension"
        {
        self.binds.ready();
        if x == 0 || y == 0 || z == 0 { return; }
        N::dispatch(&mut self.raw, x, y, z);
    }
}

/// A color attachment of a render pass.
pub struct ColorAttachment {
    pub view: &TextureView,
    pub load: Load,
    pub clear: Color,
    pub store: bool,
}

pub struct DepthAttachment {
    pub view: &TextureView,
    pub load: Load,
    pub clear: f64,
    pub store: bool,
}

/// A render pass's attachments: one color target, maybe a depth one
/// (several color targets: 0.22.x).
pub struct PassDesc {
    pub color: ColorAttachment,
    pub depth: Option<DepthAttachment>,
}

impl PassDesc {
    /// One color attachment, cleared to `clear` (or kept: load =
    /// Load::Keep) and stored.
    pub fn color(view: &TextureView, clear: Color = Color::black(), load: Load = Load::Clear) -> PassDesc {
        PassDesc {
            color: ColorAttachment { view: view, load: load, clear: clear, store: true },
            depth: None
        }
    }

    pub fn with_depth(self: PassDesc, view: &TextureView, clear: f64 = 1.0, store: bool = false) -> PassDesc {
        let mut d = self;
        d.depth = Some(DepthAttachment {
            view: view, load: Load::Clear, clear: clear, store: store
        });
        d
    }
}

pub struct RenderPass {
    raw: backend::RenderEncoder,
    binds: Bindings,
    format: Format,
    depth: Option<Format>,
    width: i64,
    height: i64,
    // per vertex buffer slot: the bytes after its offset (-1: none)
    vertex_bytes: [i64; 8],
    index_bytes: i64,
    index_size: i64,
    strides: [i64; 8],
    steps: [StepMode; 8],
    buffer_count: i64,
}

impl RenderPass {
    pub fn set_pipeline(self: &mut RenderPass, p: &RenderPipeline) {
        let st = p.state;
        assert(st.target_count == 1 && st.targets[0].format == self.format,
            "gpu.format: the pipeline's color target format differs from the pass's");
        match st.depth {
            Some(d) => assert(self.depth == Some(d.format),
                "gpu.format: the pipeline's depth format differs from the pass's"),
            None => {}
        }
        self.binds.set_pipeline(&p.layouts);
        self.buffer_count = st.buffer_count;
        for i in 0..st.buffer_count {
            self.strides[i] = st.buffers[i].stride;
            self.steps[i] = st.buffers[i].step;
        }
        N::render_set_pipeline(&mut self.raw, &p.raw);
    }

    pub fn set_bind_group(self: &mut RenderPass, i: i64, g: &BindGroup) {
        self.binds.set_group(i, g.key);
        N::render_set_bind_group(&mut self.raw, &g.raw);
    }

    pub fn set_vertex_buffer(self: &mut RenderPass, slot: i64, buf: &Buffer, offset: i64 = 0)
        requires slot >= 0 && slot < MAX_VERTEX_BUFFERS else "gpu.limits: vertex buffer slots 0..7"
        requires buf.usage & BufferUsage::VERTEX != 0
        else "gpu.usage: set_vertex_buffer needs VERTEX"
        requires offset % 4 == 0 else "gpu.align: a vertex buffer's offset is a multiple of 4"
        requires offset >= 0 && offset <= buf.size else "gpu.range: the offset is past the buffer"
        requires !buf.mapped else "gpu.state: the buffer is mapped: unmap it first"
    {
        self.vertex_bytes[slot] = buf.size - offset;
        N::render_set_vertex_buffer(&mut self.raw, slot, &buf.raw, offset);
    }

    pub fn set_index_buffer(self: &mut RenderPass, buf: &Buffer, format: IndexFormat,
        offset: i64 = 0)
        requires buf.usage & BufferUsage::INDEX != 0 else "gpu.usage: set_index_buffer needs INDEX"
        requires offset % format.size() == 0
        else "gpu.align: an index buffer's offset is a multiple of the index size"
        requires offset >= 0 && offset <= buf.size else "gpu.range: the offset is past the buffer"
    {
        self.index_bytes = buf.size - offset;
        self.index_size = format.size();
        N::render_set_index_buffer(&mut self.raw, &buf.raw, format, offset);
    }

    pub fn set_viewport(self: &mut RenderPass, x: f32, y: f32, w: f32, h: f32, min_depth: f32 = 0.0,
        max_depth: f32 = 1.0)
        requires w > 0.0 && h > 0.0 && min_depth >= 0.0 && max_depth <= 1.0
        && min_depth <= max_depth else "gpu.range: the viewport"
        {
        N::render_set_viewport(&mut self.raw, x, y, w, h, min_depth, max_depth);
    }

    pub fn set_scissor(self: &mut RenderPass, x: i64, y: i64, w: i64, h: i64)
        requires x >= 0 && y >= 0 && w >= 0 && h >= 0 && x + w <= self.width && y + h <= self.height
        else "gpu.range: the scissor rectangle is outside the target"
        {
        N::render_set_scissor(&mut self.raw, x, y, w, h);
    }

    pub fn set_blend_constant(self: &mut RenderPass, c: Color) {
        N::render_set_blend_constant(&mut self.raw, c);
    }

    // The vertex buffers cover `vertices` and `instances` (wgpu's check).
    fn check_buffers(self: &RenderPass, vertices_end: i64, instances_end: i64) {
        for i in 0..self.buffer_count {
            let n = if self.steps[i] == StepMode::Instance { instances_end } else { vertices_end };
            if self.strides[i] == 0 || n == 0 { continue; }
            assert(self.vertex_bytes[i] >= 0,
                "gpu.pipeline: a vertex buffer the pipeline reads is not set");
            assert(n * self.strides[i] <= self.vertex_bytes[i],
                "gpu.range: the draw reads past a vertex buffer");
        }
    }

    /// Draws vertices `vertices` of instances `instances` (`0..3, 0..1`).
    pub fn draw(self: &mut RenderPass, vertices: Range<i64>, instances: Range<i64>)
        requires vertices.start >= 0 && vertices.start <= vertices.end && instances.start >= 0
        && instances.start <= instances.end else "gpu.range: a draw's ranges"
        {
        self.binds.ready();
        self.check_buffers(vertices.end, instances.end);
        if vertices.end == vertices.start || instances.end == instances.start { return; }
        N::draw(&mut self.raw, vertices.start, vertices.end - vertices.start, instances.start,
            instances.end - instances.start);
    }

    /// Draws indices `indices` of the index buffer, each plus base_vertex.
    pub fn draw_indexed(self: &mut RenderPass, indices: Range<i64>, base_vertex: i64,
        instances: Range<i64>)
        requires indices.start >= 0 && indices.start <= indices.end && instances.start >= 0
        && instances.start <= instances.end else "gpu.range: a draw's ranges"
        {
        self.binds.ready();
        assert(self.index_size > 0,
            "gpu.pipeline: draw_indexed without an index buffer (pass.set_index_buffer)");
        assert(indices.end * self.index_size <= self.index_bytes,
            "gpu.range: the draw reads past the index buffer");
        // the vertices the indices reach are not known on the CPU: the
        // shaders' accesses are checked instead (design §2.6)
        self.check_buffers(0, instances.end);
        if indices.end == indices.start || instances.end == instances.start { return; }
        N::draw_indexed(&mut self.raw, indices.start, indices.end - indices.start, base_vertex,
            instances.start, instances.end - instances.start);
    }
}

impl Encoder {
    /// Runs f with a compute pass; the pass ends when f returns.
    pub fn compute_pass<F: FnMut(&mut ComputePass)>(self: &mut Encoder, mut f: F)
        requires self.caps.compute
        else "gpu.unsupported: this device has no compute (dev.caps().compute)"
        {
        let mut pass = ComputePass {
            raw: N::begin_compute(&mut self.raw), binds: Bindings::new(),
            max_groups: self.limits.max_compute_workgroups_per_dimension
        };
        f(&mut pass);
        N::end_compute(&mut pass.raw);
    }

    /// Runs f with a render pass into desc's attachments; the pass ends
    /// when f returns.
    pub fn render_pass<F: FnMut(&mut RenderPass)>(self: &mut Encoder, desc: PassDesc, mut f: F)
        requires self.caps.render
        else "gpu.unsupported: this device does not render (dev.caps().render)"
        requires desc.color.view.usage & TextureUsage::RENDER_ATTACHMENT != 0
        else "gpu.usage: a render target needs RENDER_ATTACHMENT"
        requires desc.color.view.format.is_renderable() && !desc.color.view.format.is_depth()
        else "gpu.format: the color target's format"
        {
        let c = desc.color;
        let mut p = N::pass_new();
        N::pass_color(&mut p, 0, &c.view.raw, c.load, c.clear, c.store);
        let mut depth: Option<Format> = None;
        match desc.depth {
            Some(d) => {
                assert(d.view.usage & TextureUsage::RENDER_ATTACHMENT != 0,
                    "gpu.usage: a depth target needs RENDER_ATTACHMENT");
                assert(d.view.format.is_depth(), "gpu.format: the depth target's format");
                assert(d.view.width == c.view.width && d.view.height == c.view.height,
                    "gpu.range: the depth target's size differs from the color target's");
                N::pass_depth(&mut p, &d.view.raw, d.load, d.clear, d.store);
                depth = Some(d.view.format);
            }
            None => {}
        }
        let mut pass = RenderPass {
            raw: N::begin_render(&mut self.raw, &p),
            binds: Bindings::new(),
            format: c.view.format,
            depth: depth,
            width: c.view.width,
            height: c.view.height,
            vertex_bytes: [-1; 8],
            index_bytes: 0,
            index_size: 0,
            strides: [0; 8],
            steps: [StepMode::Vertex; 8],
            buffer_count: 0,
        };
        f(&mut pass);
        N::end_render(&mut pass.raw);
    }

    /// Copies size bytes between buffers.
    pub fn copy_buffer(self: &mut Encoder, src: &Buffer, src_offset: i64, dst: &Buffer,
        dst_offset: i64, size: i64)
        requires src.usage & BufferUsage::COPY_SRC != 0 && dst.usage & BufferUsage::COPY_DST != 0
        else "gpu.usage: copy_buffer needs COPY_SRC and COPY_DST"
        requires src_offset % 4 == 0 && dst_offset % 4 == 0 && size % 4 == 0
        else "gpu.align: copy offsets and sizes are multiples of 4"
        requires src_offset >= 0 && dst_offset >= 0 && size >= 0 && src_offset + size <= src.size
        && dst_offset + size <= dst.size else "gpu.range: the copy reaches past a buffer"
        requires !src.mapped && !dst.mapped else "gpu.state: the buffer is mapped: unmap it first"
    {
        if size == 0 { return; }
        N::copy_buffer(&mut self.raw, &src.raw, src_offset, &dst.raw, dst_offset, size);
    }

    /// Copies a region of layer `layer` of tex (the whole of it by default)
    /// into buf at offset, rows bytes_per_row apart (a multiple of 256).
    pub fn copy_texture_to_buffer(self: &mut Encoder, tex: &Texture, buf: &Buffer,
        bytes_per_row: i64, offset: i64 = 0, x: i64 = 0, y: i64 = 0, w: i64 = -1, h: i64 = -1,
        layer: i64 = 0)
        requires tex.desc.usage & TextureUsage::COPY_SRC != 0
        && buf.usage & BufferUsage::COPY_DST != 0
        else "gpu.usage: the copy needs COPY_SRC on the texture and COPY_DST on the buffer"
        requires bytes_per_row % 256 == 0 && offset % tex.desc.format.size() == 0
        else "gpu.align: bytes_per_row is a multiple of 256"
        requires layer >= 0 && layer < tex.desc.layers else "gpu.range: no such layer"
        requires !buf.mapped else "gpu.state: the buffer is mapped: unmap it first"
    {
        let ww = if w < 0 { tex.desc.width - x } else { w };
        let hh = if h < 0 { tex.desc.height - y } else { h };
        assert(x >= 0 && y >= 0 && ww >= 1 && hh >= 1 && x + ww <= tex.desc.width
            && y + hh <= tex.desc.height, "gpu.range: the region is outside the texture");
        assert(bytes_per_row >= ww * tex.desc.format.size(),
            "gpu.range: bytes_per_row is shorter than a row");
        assert(offset >= 0
            && offset + bytes_per_row * (hh - 1) + ww * tex.desc.format.size() <= buf.size,
            "gpu.range: the copy reaches past the buffer");
        N::copy_texture_to_buffer(&mut self.raw, &tex.raw, layer, x, y, ww, hh, &buf.raw, offset,
            bytes_per_row);
    }

    /// Copies rows of buf (bytes_per_row apart, a multiple of 256) into a
    /// region of layer `layer` of tex.
    pub fn copy_buffer_to_texture(self: &mut Encoder, buf: &Buffer, tex: &Texture,
        bytes_per_row: i64, offset: i64 = 0, x: i64 = 0, y: i64 = 0, w: i64 = -1, h: i64 = -1,
        layer: i64 = 0)
        requires tex.desc.usage & TextureUsage::COPY_DST != 0
        && buf.usage & BufferUsage::COPY_SRC != 0
        else "gpu.usage: the copy needs COPY_SRC on the buffer and COPY_DST on the texture"
        requires bytes_per_row % 256 == 0 && offset % tex.desc.format.size() == 0
        else "gpu.align: bytes_per_row is a multiple of 256"
        requires layer >= 0 && layer < tex.desc.layers else "gpu.range: no such layer"
        requires !buf.mapped else "gpu.state: the buffer is mapped: unmap it first"
    {
        let ww = if w < 0 { tex.desc.width - x } else { w };
        let hh = if h < 0 { tex.desc.height - y } else { h };
        assert(x >= 0 && y >= 0 && ww >= 1 && hh >= 1 && x + ww <= tex.desc.width
            && y + hh <= tex.desc.height, "gpu.range: the region is outside the texture");
        assert(bytes_per_row >= ww * tex.desc.format.size(),
            "gpu.range: bytes_per_row is shorter than a row");
        assert(offset >= 0
            && offset + bytes_per_row * (hh - 1) + ww * tex.desc.format.size() <= buf.size,
            "gpu.range: the copy reaches past the buffer");
        N::copy_buffer_to_texture(&mut self.raw, &buf.raw, offset, bytes_per_row, &tex.raw, layer,
            x, y, ww, hh);
    }

    /// The recorded commands, for `queue.submit`.
    pub fn finish(self: Encoder) -> Commands {
        Commands { raw: self.raw }
    }
}

// ---- GPU: surfaces and frames (0.22) ----

/// What a window shows: frames drawn into and presented.
pub struct Surface {
    pub raw: backend::Surface,
    pub configured: bool,
    pub width: i64,
    pub height: i64,
    pub format: Format,
}

/// A frame of a surface: its texture is the render target; `present`
/// shows it after the work submitted before.
pub struct Frame {
    pub raw: backend::Frame,
    pub texture: Texture,
}

impl Surface {
    /// Sizes the surface's frames; vsync: presented at the display's rate.
    pub fn configure(self: &mut Surface, dev: &Device, width: i64, height: i64,
        format: Format = Format::Bgra8Unorm, vsync: bool = true)
        requires width >= 1 && height >= 1 && width <= dev.limits.max_texture_dimension_2d
        && height <= dev.limits.max_texture_dimension_2d else "gpu.limits: a surface's size"
        requires format == Format::Bgra8Unorm || format == Format::Bgra8UnormSrgb
        || format == Format::Rgba16Float
        else "gpu.format: a surface is Bgra8Unorm, Bgra8UnormSrgb or Rgba16Float"
        {
        N::configure(&mut self.raw, &dev.raw, width, height, format, vsync);
        self.configured = true;
        self.width = width;
        self.height = height;
        self.format = format;
    }

    /// The next frame to draw (waits for one to be free).
    pub fn frame(self: &mut Surface) -> Result<Frame, Error>
        requires self.configured else "gpu.state: configure the surface before taking a frame"
    {
        match N::next_frame(&mut self.raw) {
            Some((f, t)) => {
                let desc = TextureDesc {
                    width: self.width, height: self.height, layers: 1, mips: 1, format: self.format,
                    usage: TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC
                };
                Ok(Frame { raw: f, texture: Texture { raw: t, desc: desc } })
            }
            None => Err(Error::SurfaceLost),
        }
    }
}

impl Frame {
    /// Shows the frame after the work submitted to queue so far.
    pub fn present(self: Frame, queue: &mut Queue) {
        let f = self;
        N::present(&mut queue.raw, f.raw);
    }
}

// ---- GPU: bytes (0.22) ----

/// The bytes of a slice of f32s (a view of the same memory).
pub fn bytes_of_f32(s: [f32]) -> [u8] {
    // s.len() f32s are s.len() * 4 readable bytes; u8 has no alignment
    unsafe { (s.ptr as *u8)[0..s.len() * 4] }
}

/// The bytes of a slice of u32s (a view of the same memory).
pub fn bytes_of_u32(s: [u32]) -> [u8] {
    // as bytes_of_f32
    unsafe { (s.ptr as *u8)[0..s.len() * 4] }
}

/// The bytes of a slice of i32s (a view of the same memory).
pub fn bytes_of_i32(s: [i32]) -> [u8] {
    // as bytes_of_f32
    unsafe { (s.ptr as *u8)[0..s.len() * 4] }
}

/// Bytes as f32s (a view): the length a multiple of 4 and the memory
/// 4-aligned, as mapped buffers are.
pub fn f32s(b: [u8]) -> [f32]
    requires b.len() % 4 == 0 && (b.ptr as u64) % 4 == 0
    else "gpu.align: f32s needs 4-aligned bytes, a multiple of 4"
    {
    // aligned, and every bit pattern is an f32
    unsafe { (b.ptr as *f32)[0..b.len() / 4] }
}

/// Bytes as u32s (a view), as f32s.
pub fn u32s(b: [u8]) -> [u32]
    requires b.len() % 4 == 0 && (b.ptr as u64) % 4 == 0
    else "gpu.align: u32s needs 4-aligned bytes, a multiple of 4"
    {
    // aligned, and every bit pattern is a u32
    unsafe { (b.ptr as *u32)[0..b.len() / 4] }
}

/// Bytes as i32s (a view), as f32s.
pub fn i32s(b: [u8]) -> [i32]
    requires b.len() % 4 == 0 && (b.ptr as u64) % 4 == 0
    else "gpu.align: i32s needs 4-aligned bytes, a multiple of 4"
    {
    // aligned, and every bit pattern is an i32
    unsafe { (b.ptr as *i32)[0..b.len() / 4] }
}

/// The same bytes, writable, as u32s (a view of mapped memory).
pub fn u32s_mut(b: &mut [u8]) -> &mut [u32]
    requires b.len() % 4 == 0 && (b.ptr as u64) % 4 == 0
    else "gpu.align: u32s needs 4-aligned bytes, a multiple of 4"
    {
    // aligned, and every bit pattern is a u32
    unsafe { &mut (b.ptr as *u32)[0..b.len() / 4] }
}

/// The same bytes, writable, as f32s.
pub fn f32s_mut(b: &mut [u8]) -> &mut [f32]
    requires b.len() % 4 == 0 && (b.ptr as u64) % 4 == 0
    else "gpu.align: f32s needs 4-aligned bytes, a multiple of 4"
    {
    // aligned, and every bit pattern is an f32
    unsafe { &mut (b.ptr as *f32)[0..b.len() / 4] }
}
