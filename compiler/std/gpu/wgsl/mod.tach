// std::gpu::shader (0.22, docs/design/gpu.md §2.10): the shader compiler.
// WGSL (the subset of §2.10) is parsed, resolved and type-checked into a
// target-neutral IR (ir.tach: types, expressions, structured statements,
// entry points; nothing of any target), every index gets its bounds check
// (bounds.tach), and a back end writes it: MSL for Metal (msl.tach), or
// the CPU interpreter runs it (interp.tach: the tests' oracle). SPIR-V
// (spirv.tach) and other targets (PTX) are back ends over the same IR.
//
//   let mut out = Buf::new_in(gpa);
//   let mut refl = shader::new_reflection(gpa);
//   let mut err = shader::new_error(gpa);
//   if !shader::translate(src, shader::options(shader::TARGET_MSL), &mut out, &mut refl, &mut err, gpa) {
//       // err: code (wgsl.*), line, col, msg, help
//   }
//
// A translation allocates from an arena of its own, freed at its end, and
// does no io. `tools/wgslc` is the command line; tests/wgsl/run.sh runs
// the cases on the interpreter and on Metal.

pub mod ir;
pub mod names;
pub mod lex;
pub mod front;
pub mod expr;
pub mod builtins;
pub mod entry;
pub mod bounds;
pub mod uniformity;
pub mod msl;
pub mod spirv;
pub mod interp;
pub mod dump;
pub mod job;
pub mod translate;

pub use translate::{
    BK_COMPARISON_SAMPLER, BK_READ_ONLY_STORAGE, BK_SAMPLER, BK_STORAGE, BK_STORAGE_TEXTURE,
    BK_TEXTURE, BK_UNIFORM, BindingInfo, EntryInfo, InputInfo, Options, Reflection, ShaderError,
    TARGET_CHECK, TARGET_IR, TARGET_MSL, TARGET_SPIRV, line_col, new_error, new_reflection, options,
    translate,
};
