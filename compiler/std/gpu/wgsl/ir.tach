// ---- Shader compiler implementation, ir (0.22) ----
// The shader IR (docs/design/gpu.md §2.10): what the front end makes
// from WGSL and the back ends (MSL, SPIR-V, the interpreter) read. It is
// plain data: i64 handles into Vecs, one arena per translation.
//
// - Types are module-wide and interned: a handle is equal for equal types.
//   The scalar, vector and matrix types have fixed handles (`vec_ty`,
//   `mat_ty`); the rest are found through `types_map`.
// - A function has an expression arena, a statement arena and blocks
//   (runs of statement handles in `items`). Expressions are evaluated
//   where an `S_EMIT` statement covers them, in order, except the results
//   of calls and atomics (made by their statement) and the leaves
//   (literals, arguments, variables), which have no cost.
// - Every index has a bounds check (D15): `E_ACCESS.c` is the check's
//   kind, set by bounds.tach; a back end never sees `CK_PENDING`.
//
// Moves to compiler/std/gpu/wgsl/ir.tach with C2 (std submodules).

use std::{Allocator, Buf, Eq, Hash, HashMap, ScopedArena, Vec};
use std::Option::{None, Some};

// ---- Shader compiler implementation, ir: Scalars (0.22) ----

pub const SK_BOOL: u8 = 0;
pub const SK_I32: u8 = 1;
pub const SK_U32: u8 = 2;
pub const SK_F32: u8 = 3;
// Abstract numbers exist only in the front end (const evaluation).
pub const SK_AINT: u8 = 4;
pub const SK_AFLOAT: u8 = 5;

// ---- Shader compiler implementation, ir: Types (0.22) ----

pub const TK_SCALAR: u8 = 0;
pub const TK_VECTOR: u8 = 1;
// n columns of m rows of f32
pub const TK_MATRIX: u8 = 2;
// base: the element; n: the length, 0 when runtime-sized
pub const TK_ARRAY: u8 = 3;
pub const TK_STRUCT: u8 = 4;
pub const TK_ATOMIC: u8 = 5;
// base: the pointee; space, access
pub const TK_POINTER: u8 = 6;
// scalar: the sampled kind; n: TEX_*; access for storage textures; m: the texel format
pub const TK_TEXTURE: u8 = 7;
// n: 1 for sampler_comparison
pub const TK_SAMPLER: u8 = 8;

pub const TEX_2D: i64 = 0;
pub const TEX_2D_ARRAY: i64 = 1;
pub const TEX_DEPTH_2D: i64 = 2;
pub const TEX_STORAGE_2D: i64 = 3;

// Texel formats of storage textures (TK_TEXTURE.m).
pub const FMT_RGBA8UNORM: i64 = 0;
pub const FMT_RGBA32FLOAT: i64 = 1;
pub const FMT_R32FLOAT: i64 = 2;
pub const FMT_R32UINT: i64 = 3;
pub const FMT_R32SINT: i64 = 4;
pub const FMT_RGBA32UINT: i64 = 5;

// Address spaces.
pub const SP_FUNCTION: u8 = 0;
pub const SP_PRIVATE: u8 = 1;
pub const SP_WORKGROUP: u8 = 2;
pub const SP_UNIFORM: u8 = 3;
pub const SP_STORAGE: u8 = 4;
// textures and samplers: no address space, the global is the value
pub const SP_HANDLE: u8 = 5;

// Access modes (bits).
pub const ACC_READ: u8 = 1;
pub const ACC_WRITE: u8 = 2;
pub const ACC_RW: u8 = 3;

pub struct Type {
    kind: u8,
    scalar: u8,
    space: u8,
    access: u8,
    n: i64,
    m: i64,
    base: i64,
    // struct members: members[mstart .. mstart + mcount]
    mstart: i64,
    mcount: i64,
    name: [u8],
    // the WGSL memory layout, in bytes (every type, every address space)
    size: i64,
    align: i64,
    // arrays: the element stride; matrices: the column stride
    stride: i64,
}

// What an entry point's parameter, result or IO struct member is bound to.
pub const BIND_NONE: u8 = 0;
pub const BIND_BUILTIN: u8 = 1;
pub const BIND_LOCATION: u8 = 2;

pub const INTERP_PERSPECTIVE: u8 = 0;
pub const INTERP_LINEAR: u8 = 1;
pub const INTERP_FLAT: u8 = 2;

pub struct Binding { kind: u8, interp: u8, value: i64 }

pub fn no_binding() -> Binding {
    Binding { kind: BIND_NONE, interp: INTERP_PERSPECTIVE, value: 0 }
}

pub const BI_POSITION: i64 = 0;
pub const BI_VERTEX_INDEX: i64 = 1;
pub const BI_INSTANCE_INDEX: i64 = 2;
pub const BI_FRONT_FACING: i64 = 3;
pub const BI_FRAG_DEPTH: i64 = 4;
pub const BI_SAMPLE_INDEX: i64 = 5;
pub const BI_SAMPLE_MASK: i64 = 6;
pub const BI_LOCAL_INVOCATION_ID: i64 = 7;
pub const BI_LOCAL_INVOCATION_INDEX: i64 = 8;
pub const BI_GLOBAL_INVOCATION_ID: i64 = 9;
pub const BI_WORKGROUP_ID: i64 = 10;
pub const BI_NUM_WORKGROUPS: i64 = 11;

pub struct StructMember { name: [u8], ty: i64, offset: i64, binding: Binding }

// ---- Shader compiler implementation, ir: Expressions (0.22) ----

// a: the bits (a u32 for i32, u32, f32; 0 or 1 for bool)
pub const E_LITERAL: u8 = 0;
pub const E_ZERO: u8 = 1;
// a, b: args[a .. a + b]: scalars and vectors for a vector, columns for a
// matrix, elements, members
pub const E_COMPOSE: u8 = 2;
// a: a scalar
pub const E_SPLAT: u8 = 3;
// a: the vector; b: the components, 2 bits each from bit 0; c: how many
pub const E_SWIZZLE: u8 = 4;
// a: base (a pointer or a value); b: the index expression; c: CK_*;
// d: the length when the check is a clamp
pub const E_ACCESS: u8 = 5;
// a: base (a pointer or a value); b: the constant index (a member, or a
// component of a vector, matrix or fixed-size array, checked statically)
pub const E_ACCESS_INDEX: u8 = 6;
// a: the parameter's index
pub const E_ARG: u8 = 7;
// a: the global; its type is a pointer (a texture or sampler: the handle)
pub const E_GLOBAL: u8 = 8;
// a: the local; a pointer<function>
pub const E_LOCAL: u8 = 9;
// a: the pointer
pub const E_LOAD: u8 = 10;
// a: UN_*; b: the operand
pub const E_UNARY: u8 = 11;
// a: OP_*; b, c: the operands
pub const E_BINARY: u8 = 12;
// a: the condition (bool, or a vector of bool); b: if true; c: if false
pub const E_SELECT: u8 = 13;
// a: MF_*; b, c: args[b .. b + c]
pub const E_MATH: u8 = 14;
// a: the operand; the type is the target (value conversion)
pub const E_CONVERT: u8 = 15;
// a: the operand; the type is the target (bits)
pub const E_BITCAST: u8 = 16;
// made by S_CALL
pub const E_CALL_RESULT: u8 = 17;
// made by S_ATOMIC
pub const E_ATOMIC_RESULT: u8 = 18;
// a: a pointer to a runtime-sized array (or a struct ending in one: b is
// then the member index, else -1)
pub const E_ARRAY_LENGTH: u8 = 19;
// a: DV_*; b: the operand
pub const E_DERIVATIVE: u8 = 20;
// a: the texture; b: the sampler; c: args[c .. c + d] (coords, then
// array index, bias/level/depth ref as `aux`): see IMG_*
pub const E_IMAGE_SAMPLE: u8 = 21;
// a: the texture; c: args (coords, array index, level)
pub const E_IMAGE_LOAD: u8 = 22;
// a: the texture; b: IQ_*; c: the level expression or -1
pub const E_IMAGE_QUERY: u8 = 23;
// a: the pointer; made by S_WG_UNIFORM_LOAD
pub const E_WG_UNIFORM_RESULT: u8 = 24;

// Bounds checks of E_ACCESS.
pub const CK_PENDING: i64 = 0;
// proven in range: no check
pub const CK_NONE: i64 = 1;
// fixed length d: index = min(index, d - 1)
pub const CK_CLAMP: i64 = 2;
// runtime-sized: out of range, a load reads zero and a store is skipped
pub const CK_RZSW: i64 = 3;

pub const UN_NEG: i64 = 0;
pub const UN_NOT: i64 = 1;
pub const UN_BITNOT: i64 = 2;

pub const OP_ADD: i64 = 0;
pub const OP_SUB: i64 = 1;
pub const OP_MUL: i64 = 2;
pub const OP_DIV: i64 = 3;
pub const OP_MOD: i64 = 4;
pub const OP_EQ: i64 = 5;
pub const OP_NE: i64 = 6;
pub const OP_LT: i64 = 7;
pub const OP_LE: i64 = 8;
pub const OP_GT: i64 = 9;
pub const OP_GE: i64 = 10;
// bitwise on integers; logical (both operands evaluated) on bool
pub const OP_AND: i64 = 11;
pub const OP_OR: i64 = 12;
pub const OP_XOR: i64 = 13;
pub const OP_SHL: i64 = 14;
pub const OP_SHR: i64 = 15;
// short-circuit forms are lowered to control flow when the right side
// has effects; else they are these, on bool
pub const OP_LAND: i64 = 16;
pub const OP_LOR: i64 = 17;

// Math functions (E_MATH). Component-wise unless noted.
pub const MF_ABS: i64 = 0;
pub const MF_MIN: i64 = 1;
pub const MF_MAX: i64 = 2;
pub const MF_CLAMP: i64 = 3;
pub const MF_SIGN: i64 = 4;
pub const MF_FLOOR: i64 = 5;
pub const MF_CEIL: i64 = 6;
pub const MF_ROUND: i64 = 7;
pub const MF_FRACT: i64 = 8;
pub const MF_TRUNC: i64 = 9;
pub const MF_SQRT: i64 = 10;
pub const MF_INVERSE_SQRT: i64 = 11;
pub const MF_EXP: i64 = 12;
pub const MF_EXP2: i64 = 13;
pub const MF_LOG: i64 = 14;
pub const MF_LOG2: i64 = 15;
pub const MF_POW: i64 = 16;
pub const MF_SIN: i64 = 17;
pub const MF_COS: i64 = 18;
pub const MF_TAN: i64 = 19;
pub const MF_ASIN: i64 = 20;
pub const MF_ACOS: i64 = 21;
pub const MF_ATAN: i64 = 22;
pub const MF_ATAN2: i64 = 23;
pub const MF_SINH: i64 = 24;
pub const MF_COSH: i64 = 25;
pub const MF_TANH: i64 = 26;
pub const MF_MIX: i64 = 27;
pub const MF_STEP: i64 = 28;
pub const MF_SMOOTHSTEP: i64 = 29;
pub const MF_FMA: i64 = 30;
// the rest reduce or are not component-wise
pub const MF_LENGTH: i64 = 31;
pub const MF_DISTANCE: i64 = 32;
pub const MF_DOT: i64 = 33;
pub const MF_CROSS: i64 = 34;
pub const MF_NORMALIZE: i64 = 35;
pub const MF_REFLECT: i64 = 36;
pub const MF_DETERMINANT: i64 = 37;
pub const MF_TRANSPOSE: i64 = 38;
pub const MF_COUNT_ONE_BITS: i64 = 39;
pub const MF_COUNT_LEADING_ZEROS: i64 = 40;
pub const MF_COUNT_TRAILING_ZEROS: i64 = 41;
pub const MF_FIRST_LEADING_BIT: i64 = 42;
pub const MF_FIRST_TRAILING_BIT: i64 = 43;
pub const MF_REVERSE_BITS: i64 = 44;
pub const MF_EXTRACT_BITS: i64 = 45;
pub const MF_INSERT_BITS: i64 = 46;
pub const MF_ALL: i64 = 47;
pub const MF_ANY: i64 = 48;
pub const MF_DEGREES: i64 = 49;
pub const MF_RADIANS: i64 = 50;
pub const MF_SATURATE: i64 = 51;
pub const MF_PACK4X8UNORM: i64 = 52;
pub const MF_UNPACK4X8UNORM: i64 = 53;
pub const MF_PACK2X16FLOAT: i64 = 54;
pub const MF_UNPACK2X16FLOAT: i64 = 55;
pub const MF_ASINH: i64 = 56;
pub const MF_ACOSH: i64 = 57;
pub const MF_ATANH: i64 = 58;
pub const MF_FACE_FORWARD: i64 = 59;
pub const MF_LDEXP: i64 = 60;
pub const MF_PACK4X8SNORM: i64 = 61;
pub const MF_UNPACK4X8SNORM: i64 = 62;
pub const MF_PACK2X16UNORM: i64 = 63;
pub const MF_UNPACK2X16UNORM: i64 = 64;
pub const MF_PACK2X16SNORM: i64 = 65;
pub const MF_UNPACK2X16SNORM: i64 = 66;
pub const MF_COUNT: i64 = 67;

pub const DV_DPDX: i64 = 0;
pub const DV_DPDY: i64 = 1;
pub const DV_FWIDTH: i64 = 2;

// E_IMAGE_SAMPLE kinds (Expr.d's low byte) and its args: the coordinates,
// then the array index when the texture is an array, then the kind's
// operand (bias, level, depth reference).
pub const IMG_SAMPLE: i64 = 0;
pub const IMG_SAMPLE_BIAS: i64 = 1;
pub const IMG_SAMPLE_LEVEL: i64 = 2;
pub const IMG_SAMPLE_COMPARE: i64 = 3;
pub const IMG_SAMPLE_COMPARE_LEVEL: i64 = 4;

pub const IQ_SIZE: i64 = 0;
pub const IQ_LEVELS: i64 = 1;
pub const IQ_LAYERS: i64 = 2;

pub struct Expr { op: u8, ty: i64, a: i64, b: i64, c: i64, d: i64 }

// ---- Shader compiler implementation, ir: Statements (0.22) ----

// a .. b: the expressions evaluated here, in order
pub const S_EMIT: u8 = 0;
// a: the block
pub const S_BLOCK: u8 = 1;
// a: the condition; b: then; c: else (a block, possibly empty)
pub const S_IF: u8 = 2;
// a: the selector (i32 or u32); b, c: cases[b .. b + c]
pub const S_SWITCH: u8 = 3;
// a: body; b: continuing; c: the break-if expression, or -1 (evaluated
// at the end of continuing, after its emits)
pub const S_LOOP: u8 = 4;
pub const S_BREAK: u8 = 5;
pub const S_CONTINUE: u8 = 6;
// a: the value, or -1
pub const S_RETURN: u8 = 7;
// discard
pub const S_KILL: u8 = 8;
// a: BARRIER_* bits
pub const S_BARRIER: u8 = 9;
// a: the pointer; b: the value
pub const S_STORE: u8 = 10;
// a: the function; b, c: args[b .. b + c]; d: the E_CALL_RESULT or -1
pub const S_CALL: u8 = 11;
// a: the pointer; b: AT_*; c: the value; d: the E_ATOMIC_RESULT or -1;
// e: the comparand (AT_CMPXCHG) or -1
pub const S_ATOMIC: u8 = 12;
// a: the texture; b: the coordinates; c: the value; d: the array index or -1
pub const S_IMAGE_STORE: u8 = 13;
// a: the pointer; b: the E_WG_UNIFORM_RESULT
pub const S_WG_UNIFORM_LOAD: u8 = 14;

pub const BARRIER_WORKGROUP: i64 = 1;
pub const BARRIER_STORAGE: i64 = 2;

pub const AT_ADD: i64 = 0;
pub const AT_SUB: i64 = 1;
pub const AT_AND: i64 = 2;
pub const AT_OR: i64 = 3;
pub const AT_XOR: i64 = 4;
pub const AT_MIN: i64 = 5;
pub const AT_MAX: i64 = 6;
pub const AT_EXCHANGE: i64 = 7;
pub const AT_LOAD: i64 = 8;
pub const AT_STORE: i64 = 9;
// the result is __atomic_compare_exchange_result: { old_value, exchanged }
pub const AT_CMPXCHG: i64 = 10;

pub struct Stmt { op: u8, a: i64, b: i64, c: i64, d: i64, e: i64 }

// A switch clause: its selector values (vals[vstart .. vstart + vcount]),
// whether it is the default, its body.
pub struct Case { vstart: i64, vcount: i64, is_default: bool, body: i64 }

// A run of statement handles: items[start .. start + count].
pub struct Block { start: i64, count: i64 }

pub struct Param { name: [u8], ty: i64, binding: Binding }

pub struct Local { name: [u8], ty: i64 }

pub type V<T> = Vec<T, ScopedArena>;

pub struct Function {
    name: [u8],
    params: V<Param>,
    // -1: no result
    result: i64,
    result_binding: Binding,
    locals: V<Local>,
    exprs: V<Expr>,
    // the names of `let` declarations: names[e] for expression e, or ""
    names: V<[u8]>,
    stmts: V<Stmt>,
    blocks: V<Block>,
    items: V<i64>,
    args: V<i64>,
    cases: V<Case>,
    vals: V<i64>,
    body: i64,
    // the source position of the declaration (a byte offset)
    pos: i64,
}

pub struct Global {
    name: [u8],
    space: u8,
    access: u8,
    // the value's type (a texture, a sampler, or what the pointer points to)
    ty: i64,
    group: i64,
    binding: i64,
    // private globals: an expression of the module's init function, or -1
    init: i64,
    pos: i64,
}

pub const STAGE_VERTEX: u8 = 0;
pub const STAGE_FRAGMENT: u8 = 1;
pub const STAGE_COMPUTE: u8 = 2;

pub struct Entry { stage: u8, name: [u8], func: i64, wg: [i64; 3], early_depth: bool }

#[derive(Eq, Hash)]
pub struct TypeKey { kind: u8, scalar: u8, space: u8, access: u8, n: i64, m: i64, base: i64 }

pub struct Module {
    types: V<Type>,
    types_map: HashMap<TypeKey, i64, ScopedArena>,
    members: V<StructMember>,
    globals: V<Global>,
    functions: V<Function>,
    entries: V<Entry>,
    // private globals' initializers live in this function's expressions
    // (literals, zero, compose only)
    consts: Function,
    a: ScopedArena,
}

// ---- Shader compiler implementation, ir: Fixed type handles (0.22) ----

pub const T_BOOL: i64 = 0;
pub const T_I32: i64 = 1;
pub const T_U32: i64 = 2;
pub const T_F32: i64 = 3;

// vecN<scalar>: 4 + (n - 2) * 4 + scalar, for n in 2..4 and the four
// concrete scalars
pub fn vec_ty(sk: u8, n: i64) -> i64 {
    if n == 1 {
        return sk as i64;
    }
    4 + (n - 2) * 4 + sk as i64
}

// matCxR<f32>: 16 + (c - 2) * 3 + (r - 2)
pub fn mat_ty(c: i64, r: i64) -> i64 { 16 + (c - 2) * 3 + (r - 2) }

pub const T_FIXED_COUNT: i64 = 25;

pub fn new_function(name: [u8], a: ScopedArena) -> Function {
    Function {
        name: name,
        params: Vec::new_in(a),
        result: -1,
        result_binding: no_binding(),
        locals: Vec::new_in(a),
        exprs: Vec::new_in(a),
        names: Vec::new_in(a),
        stmts: Vec::new_in(a),
        blocks: Vec::new_in(a),
        items: Vec::new_in(a),
        args: Vec::new_in(a),
        cases: Vec::new_in(a),
        vals: Vec::new_in(a),
        body: -1,
        pos: 0,
    }
}

fn round_up(x: i64, a: i64) -> i64 { (x + a - 1) / a * a }

impl Module {
    pub fn new(a: ScopedArena) -> Module {
        var m = Module {
            types: Vec::new_in(a),
            types_map: HashMap::new_in(a),
            members: Vec::new_in(a),
            globals: Vec::new_in(a),
            functions: Vec::new_in(a),
            entries: Vec::new_in(a),
            consts: new_function("", a),
            a: a,
        };
        for sk in 0..4 {
            m.push_type(TK_SCALAR, sk as u8, 1, 1, -1);
        }
        for n in 2..5 {
            for sk in 0..4 {
                m.push_type(TK_VECTOR, sk as u8, n, 1, -1);
            }
        }
        for c in 2..5 {
            for r in 2..5 {
                m.push_type(TK_MATRIX, SK_F32, c, r, -1);
            }
        }
        m
    }

    fn push_type(inout self, kind: u8, sk: u8, n: i64, mm: i64, base: i64) -> i64 {
        var t = Type {
            kind: kind,
            scalar: sk,
            space: 0,
            access: 0,
            n: n,
            m: mm,
            base: base,
            mstart: 0,
            mcount: 0,
            name: "",
            size: 4,
            align: 4,
            stride: 0,
        };
        if kind == TK_VECTOR {
            t.size = 4 * n;
            t.align = if n == 2 { 8 } else { 16 };
        } else if kind == TK_MATRIX {
            let col_align = if mm == 2 { 8 } else { 16 };
            t.align = col_align;
            t.stride = round_up(4 * mm, col_align);
            t.size = n * t.stride;
        }
        self.types.push(t);
        self.types.len() - 1
    }

    // The handle of a type made of these parts, made once.
    pub fn intern(inout self, kind: u8, sk: u8, n: i64, mm: i64, base: i64, space: u8,
        access: u8) -> i64 {
        if kind == TK_SCALAR {
            return sk as i64;
        }
        if kind == TK_VECTOR {
            return vec_ty(sk, n);
        }
        if kind == TK_MATRIX {
            return mat_ty(n, mm);
        }
        let key = TypeKey {
            kind: kind, scalar: sk, space: space, access: access, n: n, m: mm, base: base
        };
        if let Some(h) = self.types_map.get(key) {
            return h;
        }
        let h = self.push_type(kind, sk, n, mm, base);
        self.types[h].space = space;
        self.types[h].access = access;
        if kind == TK_ARRAY {
            let el = self.types[base];
            let stride = round_up(el.size, el.align);
            self.types[h].align = el.align;
            self.types[h].stride = stride;
            self.types[h].size = if n == 0 { stride } else { stride * n };
        } else if kind == TK_POINTER {
            self.types[h].size = 8;
            self.types[h].align = 8;
        } else if kind == TK_TEXTURE || kind == TK_SAMPLER {
            self.types[h].size = 8;
            self.types[h].align = 8;
        }
        self.types_map.insert(key, h);
        h
    }

    pub fn array_ty(inout self, elem: i64, n: i64) -> i64 {
        self.intern(TK_ARRAY, 0, n, 0, elem, 0, 0)
    }

    pub fn ptr_ty(inout self, pointee: i64, space: u8, access: u8) -> i64 {
        self.intern(TK_POINTER, 0, 0, 0, pointee, space, access)
    }

    pub fn atomic_ty(inout self, sk: u8) -> i64 { self.intern(TK_ATOMIC, sk, 0, 0, -1, 0, 0) }

    // A struct type: a new handle for each declaration (structs are
    // nominal); members[mstart ..] must already be pushed, offsets unset.
    pub fn struct_ty(inout self, name: [u8], mstart: i64, mcount: i64) -> i64 {
        let h = self.push_type(TK_STRUCT, 0, 0, 0, -1);
        var off = 0;
        var al = 4;
        for i in mstart..mstart + mcount {
            let t = self.types[self.members[i].ty];
            off = round_up(off, t.align);
            self.members[i].offset = off;
            off += t.size;
            if t.align > al {
                al = t.align;
            }
        }
        self.types[h].name = name;
        self.types[h].mstart = mstart;
        self.types[h].mcount = mcount;
        self.types[h].align = al;
        self.types[h].size = round_up(off, al);
        h
    }

    // The scalar kind of a scalar, vector, matrix or atomic type.
    pub fn scalar_of(self, t: i64) -> u8 { self.types[t].scalar }

    // The component count of a scalar (1) or vector type, else 0.
    pub fn width_of(self, t: i64) -> i64 {
        let k = self.types[t].kind;
        if k == TK_SCALAR {
            1
        } else if k == TK_VECTOR {
            self.types[t].n
        } else {
            0
        }
    }

    // The pointee of a pointer type, else -1.
    pub fn pointee(self, t: i64) -> i64 {
        if self.types[t].kind == TK_POINTER {
            self.types[t].base
        } else {
            -1
        }
    }

    // The type of a component of t when indexed: a vector's scalar, a
    // matrix's column, an array's element; -1 for the others.
    pub fn elem_of(self, t: i64) -> i64 {
        let ty = self.types[t];
        if ty.kind == TK_VECTOR {
            ty.scalar as i64
        } else if ty.kind == TK_MATRIX {
            vec_ty(SK_F32, ty.m)
        } else if ty.kind == TK_ARRAY {
            ty.base
        } else {
            -1
        }
    }

    // How many components indexing t can reach: 0 for a runtime-sized array.
    pub fn index_len(self, t: i64) -> i64 {
        let ty = self.types[t];
        if ty.kind == TK_VECTOR || ty.kind == TK_ARRAY {
            ty.n
        } else if ty.kind == TK_MATRIX {
            ty.n
        } else {
            -1
        }
    }

    // Whether t is or holds a runtime-sized array.
    pub fn is_runtime_sized(self, t: i64) -> bool {
        let ty = self.types[t];
        if ty.kind == TK_ARRAY {
            return ty.n == 0;
        }
        if ty.kind == TK_STRUCT && ty.mcount > 0 {
            return self.is_runtime_sized(self.members[ty.mstart + ty.mcount - 1].ty);
        }
        false
    }

    // Whether t contains an atomic (such types cannot be loaded whole).
    pub fn has_atomic(self, t: i64) -> bool {
        let ty = self.types[t];
        if ty.kind == TK_ATOMIC {
            return true;
        }
        if ty.kind == TK_ARRAY {
            return self.has_atomic(ty.base);
        }
        if ty.kind == TK_STRUCT {
            for i in ty.mstart..ty.mstart + ty.mcount {
                if self.has_atomic(self.members[i].ty) {
                    return true;
                }
            }
        }
        false
    }

    // The type written as WGSL, for messages and the IR dump.
    pub fn type_name<A: Allocator>(self, t: i64, b: inout Buf<A>) {
        if t < 0 {
            b.push_str("void");
            return;
        }
        let ty = self.types[t];
        if ty.kind == TK_SCALAR {
            b.push_str(scalar_name(ty.scalar));
        } else if ty.kind == TK_VECTOR {
            b.push_fmt(f"vec{ty.n}<{scalar_name(ty.scalar)}>");
        } else if ty.kind == TK_MATRIX {
            b.push_fmt(f"mat{ty.n}x{ty.m}<f32>");
        } else if ty.kind == TK_ARRAY {
            b.push_str("array<");
            self.type_name(ty.base, &b);
            if ty.n > 0 {
                b.push_fmt(f", {ty.n}");
            }
            b.push('>');
        } else if ty.kind == TK_STRUCT {
            b.push_str(ty.name);
        } else if ty.kind == TK_ATOMIC {
            b.push_fmt(f"atomic<{scalar_name(ty.scalar)}>");
        } else if ty.kind == TK_POINTER {
            b.push_fmt(f"ptr<{space_name(ty.space)}, ");
            self.type_name(ty.base, &b);
            if ty.space == SP_STORAGE {
                b.push_str(if ty.access == ACC_RW { ", read_write" } else { ", read" });
            }
            b.push('>');
        } else if ty.kind == TK_TEXTURE {
            if ty.n == TEX_2D {
                b.push_fmt(f"texture_2d<{scalar_name(ty.scalar)}>");
            } else if ty.n == TEX_2D_ARRAY {
                b.push_fmt(f"texture_2d_array<{scalar_name(ty.scalar)}>");
            } else if ty.n == TEX_DEPTH_2D {
                b.push_str("texture_depth_2d");
            } else {
                b.push_fmt(f"texture_storage_2d<{format_name(ty.m)}, write>");
            }
        } else if ty.n == 1 {
            b.push_str("sampler_comparison");
        } else {
            b.push_str("sampler");
        }
    }
}

pub fn scalar_name(sk: u8) -> [u8] {
    if sk == SK_BOOL {
        "bool"
    } else if sk == SK_I32 {
        "i32"
    } else if sk == SK_U32 {
        "u32"
    } else if sk == SK_F32 {
        "f32"
    } else if sk == SK_AINT {
        "abstract-int"
    } else {
        "abstract-float"
    }
}

pub fn space_name(sp: u8) -> [u8] {
    if sp == SP_FUNCTION {
        "function"
    } else if sp == SP_PRIVATE {
        "private"
    } else if sp == SP_WORKGROUP {
        "workgroup"
    } else if sp == SP_UNIFORM {
        "uniform"
    } else if sp == SP_STORAGE {
        "storage"
    } else {
        "handle"
    }
}

pub fn format_name(f: i64) -> [u8] {
    if f == FMT_RGBA8UNORM {
        "rgba8unorm"
    } else if f == FMT_RGBA32FLOAT {
        "rgba32float"
    } else if f == FMT_R32FLOAT {
        "r32float"
    } else if f == FMT_R32UINT {
        "r32uint"
    } else if f == FMT_R32SINT {
        "r32sint"
    } else {
        "rgba32uint"
    }
}

// ---- Shader compiler implementation, ir: Building functions (0.22) ----

impl Function {
    pub fn expr(inout self, op: u8, ty: i64, a: i64, b: i64, c: i64) -> i64 {
        self.exprs.push(Expr { op: op, ty: ty, a: a, b: b, c: c, d: 0 });
        self.names.push("");
        self.exprs.len() - 1
    }

    pub fn stmt(inout self, op: u8, a: i64, b: i64, c: i64, d: i64) -> i64 {
        self.stmts.push(Stmt { op: op, a: a, b: b, c: c, d: d, e: -1 });
        self.stmts.len() - 1
    }

    // A block of the statements pending[from ..], which are removed from
    // pending.
    pub fn block_of(inout self, pending: inout V<i64>, from: i64) -> i64 {
        let start = self.items.len();
        for i in from..pending.len() {
            self.items.push(pending[i]);
        }
        let count = pending.len() - from;
        pending.truncate(from);
        self.blocks.push(Block { start: start, count: count });
        self.blocks.len() - 1
    }

    pub fn empty_block(inout self) -> i64 {
        self.blocks.push(Block { start: self.items.len(), count: 0 });
        self.blocks.len() - 1
    }

    pub fn arg(self, i: i64) -> i64 { self.args[i] }

    pub fn item(self, blk: i64, i: i64) -> i64 { self.items[self.blocks[blk].start + i] }
}

// The byte offsets of function h's parameters in a record holding them
// all, each at its alignment (WGSL's layout); the record's size, rounded
// to 16, is the last element.
pub fn record_offsets(m: Module, h: i64, a: ScopedArena) -> V<i64> {
    var offs: V<i64> = Vec::new_in(a);
    var off = 0;
    let f = m.functions[h];
    for k in 0..f.params.len() {
        let t = m.types[f.params[k].ty];
        off = round_up(off, t.align);
        offs.push(off);
        off += t.size;
    }
    offs.push(round_up(off, 16));
    offs
}

// The bytes a value of type t takes in an array of them (its stride).
pub fn stride_of(m: Module, t: i64) -> i64 {
    let ty = m.types[t];
    round_up(ty.size, ty.align)
}

// Statements and expressions that end a block's flow.
pub fn is_terminator(op: u8) -> bool {
    op == S_BREAK || op == S_CONTINUE || op == S_RETURN || op == S_KILL
}

// The bits of an f32, and back.
pub fn f32_bits(f: f32) -> u32 { std::num::f32_to_bits(f) }

pub fn bits_f32(u: u32) -> f32 { std::num::f32_from_bits(u) }

pub fn f64_bits(f: f64) -> u64 { std::num::f64_to_bits(f) }
