// std::gpu::types (0.22): flags, formats, descriptors (docs/design/gpu.md,
// §2.2), re-exported by std::gpu. Flags are u32 constants in modules named
// like the types the design makes them (`type BufferUsage = distinct
// u32`): a distinct type cannot have named constants yet, so a BufferUsage
// passed as a TextureUsage is not a type error until it can. Descriptors
// are small plain structs with constructors for the common cases; their
// fields are public, to change what differs.

// ---- GPU types: flags, formats, descriptors (0.22) ----

/// What a buffer may be used for (wgpu's values).
pub mod BufferUsage {
    pub const MAP_READ: u32 = 1;
    pub const MAP_WRITE: u32 = 2;
    pub const COPY_SRC: u32 = 4;
    pub const COPY_DST: u32 = 8;
    pub const INDEX: u32 = 16;
    pub const VERTEX: u32 = 32;
    pub const UNIFORM: u32 = 64;
    pub const STORAGE: u32 = 128;
    pub const INDIRECT: u32 = 256;
}

/// What a texture may be used for (wgpu's values).
pub mod TextureUsage {
    pub const COPY_SRC: u32 = 1;
    pub const COPY_DST: u32 = 2;
    pub const TEXTURE_BINDING: u32 = 4;
    pub const STORAGE_BINDING: u32 = 8;
    pub const RENDER_ATTACHMENT: u32 = 16;
}

/// The shader stages a binding is visible in.
pub mod ShaderStage {
    pub const VERTEX: u32 = 1;
    pub const FRAGMENT: u32 = 2;
    pub const COMPUTE: u32 = 4;
}

/// Which adapter `Instance::adapter` prefers.
#[derive(Eq, Debug, Clone)]
pub enum Power {
    Low,
    High,
}

/// Texture formats: the ones the backends and tests use.
#[derive(Eq, Debug, Clone)]
pub enum Format {
    R8Unorm,
    R8Uint,
    Rg8Unorm,
    R16Float,
    R32Uint,
    R32Sint,
    R32Float,
    Rg16Float,
    Rgba8Unorm,
    Rgba8UnormSrgb,
    Rgba8Uint,
    Bgra8Unorm,
    Bgra8UnormSrgb,
    Rg32Float,
    Rgba16Float,
    Rgba32Uint,
    Rgba32Float,
    Depth32Float,
}

impl Format {
    /// Bytes per texel.
    #[pure]
    pub fn size(self) -> i64 {
        match self {
            Format::R8Unorm | Format::R8Uint => 1,
            Format::Rg8Unorm | Format::R16Float => 2,
            Format::R32Uint | Format::R32Sint | Format::R32Float | Format::Rg16Float => 4,
            Format::Rgba8Unorm | Format::Rgba8UnormSrgb | Format::Rgba8Uint => 4,
            Format::Bgra8Unorm | Format::Bgra8UnormSrgb | Format::Depth32Float => 4,
            Format::Rg32Float | Format::Rgba16Float => 8,
            Format::Rgba32Uint | Format::Rgba32Float => 16,
        }
    }

    #[pure]
    pub fn is_depth(self) -> bool {
        self == Format::Depth32Float
    }

    /// Whether a render pass may draw into it.
    #[pure]
    pub fn is_renderable(self) -> bool {
        true
    }

    /// Whether a compute or fragment shader may write it as a storage
    /// texture (WebGPU's storage formats among these).
    #[pure]
    pub fn is_storable(self) -> bool {
        match self {
            Format::R32Uint | Format::R32Sint | Format::R32Float | Format::Rgba8Unorm
                | Format::Rgba8Uint => true,
            Format::Rg32Float | Format::Rgba16Float | Format::Rgba32Uint
                | Format::Rgba32Float => true,
            _ => false,
        }
    }
}

/// Formats of vertex attributes.
#[derive(Eq, Debug, Clone)]
pub enum VertexFormat {
    Float32,
    Float32x2,
    Float32x3,
    Float32x4,
    Uint32,
    Uint32x2,
    Uint32x4,
    Sint32,
    Unorm8x4,
}

impl VertexFormat {
    /// What the shader reads: the scalar (0 f32, 1 u32, 2 i32) times 8
    /// plus the component count. Formats with one shader type feed the same
    /// inputs (WebGPU's rule: Unorm8x4 feeds a vec4<f32>, as Float32x4 does).
    #[pure]
    pub fn shader_type(self) -> i64 {
        match self {
            VertexFormat::Float32 => 1,
            VertexFormat::Float32x2 => 2,
            VertexFormat::Float32x3 => 3,
            VertexFormat::Float32x4 | VertexFormat::Unorm8x4 => 4,
            VertexFormat::Uint32 => 9,
            VertexFormat::Uint32x2 => 10,
            VertexFormat::Uint32x4 => 12,
            VertexFormat::Sint32 => 17,
        }
    }

    #[pure]
    pub fn size(self) -> i64 {
        match self {
            VertexFormat::Float32 | VertexFormat::Uint32 | VertexFormat::Sint32
                | VertexFormat::Unorm8x4 => 4,
            VertexFormat::Float32x2 | VertexFormat::Uint32x2 => 8,
            VertexFormat::Float32x3 => 12,
            VertexFormat::Float32x4 | VertexFormat::Uint32x4 => 16,
        }
    }
}

#[derive(Eq, Debug, Clone)]
pub enum StepMode {
    Vertex,
    Instance,
}

#[derive(Eq, Debug, Clone)]
pub enum IndexFormat {
    Uint16,
    Uint32,
}

impl IndexFormat {
    #[pure]
    pub fn size(self) -> i64 {
        match self {
            IndexFormat::Uint16 => 2,
            IndexFormat::Uint32 => 4,
        }
    }
}

#[derive(Eq, Debug, Clone)]
pub enum Topology {
    PointList,
    LineList,
    LineStrip,
    TriangleList,
    TriangleStrip,
}

#[derive(Eq, Debug, Clone)]
pub enum Cull {
    None,
    Front,
    Back,
}

#[derive(Eq, Debug, Clone)]
pub enum FrontFace {
    Ccw,
    Cw,
}

#[derive(Eq, Debug, Clone)]
pub enum Compare {
    Never,
    Less,
    Equal,
    LessEqual,
    Greater,
    NotEqual,
    GreaterEqual,
    Always,
}

#[derive(Eq, Debug, Clone)]
pub enum Filter {
    Nearest,
    Linear,
}

#[derive(Eq, Debug, Clone)]
pub enum AddressMode {
    ClampToEdge,
    Repeat,
    MirrorRepeat,
}

#[derive(Eq, Debug, Clone)]
pub enum BlendFactor {
    Zero,
    One,
    Src,
    OneMinusSrc,
    SrcAlpha,
    OneMinusSrcAlpha,
    Dst,
    OneMinusDst,
    DstAlpha,
    OneMinusDstAlpha,
}

#[derive(Eq, Debug, Clone)]
pub enum BlendOp {
    Add,
    Subtract,
    ReverseSubtract,
    Min,
    Max,
}

/// One blend equation: src * src_factor OP dst * dst_factor.
#[derive(Eq, Debug, Clone)]
pub struct BlendComponent {
    pub src: BlendFactor,
    pub dst: BlendFactor,
    pub op: BlendOp,
}

/// A color target's blending; `None` in ColorTarget writes the source.
#[derive(Eq, Debug, Clone)]
pub struct Blend {
    pub color: BlendComponent,
    pub alpha: BlendComponent,
}

impl Blend {
    /// Source over destination, straight alpha (wgpu's ALPHA_BLENDING).
    pub fn alpha() -> Blend {
        Blend {
            color: BlendComponent {
                src: BlendFactor::SrcAlpha, dst: BlendFactor::OneMinusSrcAlpha, op: BlendOp::Add
            },
            alpha: BlendComponent {
                src: BlendFactor::One, dst: BlendFactor::OneMinusSrcAlpha, op: BlendOp::Add
            },
        }
    }

    /// Premultiplied alpha.
    pub fn premultiplied() -> Blend {
        Blend {
            color: BlendComponent {
                src: BlendFactor::One, dst: BlendFactor::OneMinusSrcAlpha, op: BlendOp::Add
            },
            alpha: BlendComponent {
                src: BlendFactor::One, dst: BlendFactor::OneMinusSrcAlpha, op: BlendOp::Add
            },
        }
    }

    /// src + dst.
    pub fn additive() -> Blend {
        Blend {
            color: BlendComponent {
                src: BlendFactor::One, dst: BlendFactor::One, op: BlendOp::Add
            },
            alpha: BlendComponent {
                src: BlendFactor::One, dst: BlendFactor::One, op: BlendOp::Add
            },
        }
    }
}

/// A clear color, components in 0..1 for normalized formats.
#[derive(Eq, Debug, Clone)]
pub struct Color {
    pub r: f64,
    pub g: f64,
    pub b: f64,
    pub a: f64,
}

impl Color {
    pub fn rgba(r: f64, g: f64, b: f64, a: f64) -> Color {
        Color { r: r, g: g, b: b, a: a }
    }

    pub fn black() -> Color {
        Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
    }

    pub fn transparent() -> Color {
        Color { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
    }
}

/// A sampler's description; `SamplerDesc::nearest()` and `::linear()`
/// are the common ones.
#[derive(Eq, Debug, Clone)]
pub struct SamplerDesc {
    pub mag: Filter,
    pub min: Filter,
    pub mip: Filter,
    pub address_u: AddressMode,
    pub address_v: AddressMode,
    pub address_w: AddressMode,
    pub lod_min: f32,
    pub lod_max: f32,
    pub compare: Option<Compare>,
    pub anisotropy: i64,
}

impl SamplerDesc {
    pub fn nearest() -> SamplerDesc {
        SamplerDesc {
            mag: Filter::Nearest,
            min: Filter::Nearest,
            mip: Filter::Nearest,
            address_u: AddressMode::ClampToEdge,
            address_v: AddressMode::ClampToEdge,
            address_w: AddressMode::ClampToEdge,
            lod_min: 0.0,
            lod_max: 32.0,
            compare: None,
            anisotropy: 1,
        }
    }

    pub fn linear() -> SamplerDesc {
        var d = SamplerDesc::nearest();
        d.mag = Filter::Linear;
        d.min = Filter::Linear;
        d.mip = Filter::Linear;
        d
    }
}

/// A texture's description (2D, or a 2D array with layers > 1).
#[derive(Eq, Debug, Clone)]
pub struct TextureDesc {
    pub width: i64,
    pub height: i64,
    pub layers: i64,
    pub mips: i64,
    pub format: Format,
    pub usage: u32,
}

/// The device's limits (wgpu's names; the defaults hold on Metal and on
/// lavapipe).
#[derive(Eq, Debug, Clone)]
pub struct Limits {
    pub max_texture_dimension_2d: i64,
    pub max_texture_array_layers: i64,
    pub max_bind_groups: i64,
    pub max_bindings_per_group: i64,
    pub max_buffer_size: i64,
    pub max_vertex_buffers: i64,
    pub max_vertex_attributes: i64,
    pub max_color_attachments: i64,
    pub min_uniform_buffer_offset_alignment: i64,
    pub min_storage_buffer_offset_alignment: i64,
    pub max_compute_workgroup_size_x: i64,
    pub max_compute_workgroup_size_y: i64,
    pub max_compute_workgroup_size_z: i64,
    pub max_compute_invocations_per_workgroup: i64,
    pub max_compute_workgroups_per_dimension: i64,
}

impl Limits {
    pub fn default() -> Limits {
        Limits {
            max_texture_dimension_2d: 16384,
            max_texture_array_layers: 2048,
            max_bind_groups: 4,
            max_bindings_per_group: 16,
            max_buffer_size: 1 << 30,
            max_vertex_buffers: 8,
            max_vertex_attributes: 16,
            max_color_attachments: 8,
            min_uniform_buffer_offset_alignment: 256,
            min_storage_buffer_offset_alignment: 256,
            max_compute_workgroup_size_x: 1024,
            max_compute_workgroup_size_y: 1024,
            max_compute_workgroup_size_z: 64,
            max_compute_invocations_per_workgroup: 1024,
            max_compute_workgroups_per_dimension: 65535,
        }
    }
}

/// One attribute of a vertex buffer: `@location(location)` reads `format`
/// at `offset` in each element.
#[derive(Eq, Debug, Clone)]
pub struct VertexAttribute {
    pub format: VertexFormat,
    pub offset: i64,
    pub location: i64,
}

pub const MAX_VERTEX_ATTRIBUTES: i64 = 8;
pub const MAX_VERTEX_BUFFERS: i64 = 8;
pub const MAX_COLOR_TARGETS: i64 = 8;
pub const MAX_BIND_GROUPS: i64 = 4;

/// A vertex buffer's layout: its stride, step mode and attributes (at most
/// MAX_VERTEX_ATTRIBUTES, kept in a fixed array: no allocation).
#[derive(Eq)]
pub struct VertexLayout {
    pub stride: i64,
    pub step: StepMode,
    pub attributes: [VertexAttribute; 8],
    pub count: i64,
}

impl VertexLayout {
    pub fn new(stride: i64, step: StepMode = StepMode::Vertex) -> VertexLayout {
        VertexLayout {
            stride: stride, step: step,
            attributes: [VertexAttribute { format: VertexFormat::Float32, offset: 0, location: 0 };
                8], count: 0
        }
    }

    pub fn attribute(inout self, location: i64, format: VertexFormat, offset: i64)
        requires self.count < MAX_VERTEX_ATTRIBUTES
        else "gpu.limits: at most 8 attributes in a vertex buffer"
        {
        self.attributes[self.count] = VertexAttribute {
            format: format, offset: offset, location: location
        };
        self.count += 1;
    }
}

/// A color target of a render pipeline.
#[derive(Eq, Debug, Clone)]
pub struct ColorTarget {
    pub format: Format,
    pub blend: Option<Blend>,
    pub write_mask: u32,
}

/// The depth test of a render pipeline.
#[derive(Eq, Debug, Clone)]
pub struct DepthState {
    pub format: Format,
    pub write: bool,
    pub compare: Compare,
}

/// Everything about a render pipeline but its shaders: plain data, so
/// that the hal takes it as it is.
#[derive(Eq)]
pub struct PipelineState {
    pub topology: Topology,
    pub cull: Cull,
    pub front_face: FrontFace,
    pub buffers: [VertexLayout; 8],
    pub buffer_count: i64,
    pub targets: [ColorTarget; 8],
    pub target_count: i64,
    pub depth: Option<DepthState>,
}

impl PipelineState {
    pub fn new(format: Format) -> PipelineState {
        let t = ColorTarget { format: format, blend: None, write_mask: 15 };
        PipelineState {
            topology: Topology::TriangleList,
            cull: Cull::None,
            front_face: FrontFace::Ccw,
            buffers: [VertexLayout::new(0); 8],
            buffer_count: 0,
            targets: [t; 8],
            target_count: 1,
            depth: None,
        }
    }
}

/// How a render pass starts with an attachment.
#[derive(Eq, Debug, Clone)]
pub enum Load {
    Clear,
    Keep,
    DontCare,
}
