// The standard library (0.5): the module `std`, built into the compiler
// (compiler/std/embed.sh makes compiler/src/front/stdsrc.tach from this file
// and the ones it appends: iter.tach, io.tach, fmt.tach, convert.tach,
// clone.tach). A program that names `std` gets it: `std::Vec<i64>`,
// `use std::{Buf, Vec};`.
//
// This file, the core: Option and Result, a growable vector, a byte
// buffer, the operator traits, sorting and a hash map.
// Failures (unwrapping None, an index out of bounds) print a message on
// stderr and exit with 101, like the language's own checks.
//
// Unsafe code (0.9): the safe functions here have no undefined behaviour
// as long as a Vec's and a Buf's fields are changed by their methods only
// (tachyon has no private fields yet), and a slice from `as_slice` (or a
// HashMap's `get_mut`, `get_or_insert`) is not used after the Vec grows
// (the map gets a new key) or is freed. The functions taking C strings
// are `unsafe fn`: the string must end with a NUL.

extern "C" {
    fn malloc(size: u64) -> *u8;
    fn realloc(p: *u8, size: u64) -> *u8;
    fn free(p: *u8);
    fn write(fd: i32, data: *u8, count: u64) -> i64;
    fn read(fd: i32, data: *u8, count: u64) -> i64;
    fn exit(code: i32) -> !;
}

// Prints `message` (a C string) on stderr and exits with 101.
pub unsafe fn panic(message: *u8) -> ! {
    let mut n = 0;
    while message[n] != 0 {
        n += 1;
    }
    write(2, message, n as u64);
    write(2, c"\n", 1);
    exit(101)
}

// ---- Option and Result ----

pub enum Option<T> { None, Some(T) }

impl<T> Option<T> {
    pub fn is_some(self: *Option<T>) -> bool {
        match *self {
            Option::Some(_) => true,
            Option::None => false,
        }
    }

    pub fn is_none(self: *Option<T>) -> bool {
        !self.is_some()
    }

    pub fn unwrap(self: Option<T>) -> T {
        match self {
            Option::Some(x) => x,
            Option::None => unsafe { panic(c"called unwrap on None") },
        }
    }

    pub fn unwrap_or(self: Option<T>, other: T) -> T {
        match self {
            Option::Some(x) => x,
            Option::None => other,
        }
    }
}

pub enum Result<T, E> { Ok(T), Err(E) }

impl<T, E> Result<T, E> {
    pub fn is_ok(self: *Result<T, E>) -> bool {
        match *self {
            Result::Ok(_) => true,
            Result::Err(_) => false,
        }
    }

    pub fn is_err(self: *Result<T, E>) -> bool {
        !self.is_ok()
    }

    pub fn unwrap(self: Result<T, E>) -> T {
        match self {
            Result::Ok(x) => x,
            Result::Err(_) => unsafe { panic(c"called unwrap on Err") },
        }
    }

    pub fn unwrap_or(self: Result<T, E>, other: T) -> T {
        match self {
            Result::Ok(x) => x,
            Result::Err(_) => other,
        }
    }

    pub fn ok(self: Result<T, E>) -> Option<T> {
        match self {
            Result::Ok(x) => Option::Some(x),
            Result::Err(_) => Option::None,
        }
    }
}

// ---- Vec ----

// A growable vector of T on the heap; `free` gives its memory back.
pub struct Vec<T> { ptr: *T, len: i64, cap: i64 }

impl<T> Vec<T> {
    pub fn new() -> Vec<T> {
        Vec { ptr: 0 as *T, len: 0, cap: 0 }
    }

    pub fn with_capacity(cap: i64) -> Vec<T> {
        let mut v: Vec<T> = Vec::new();
        v.reserve(cap);
        v
    }

    pub fn len(self: *Vec<T>) -> i64 {
        self.len
    }

    pub fn is_empty(self: *Vec<T>) -> bool {
        self.len == 0
    }

    // Room for `extra` more elements.
    pub fn reserve(self: *Vec<T>, extra: i64) {
        if self.len + extra <= self.cap {
            return;
        }
        let mut cap = if self.cap == 0 { 4 } else { self.cap * 2 };
        while cap < self.len + extra {
            cap *= 2;
        }
        self.ptr = unsafe { realloc(self.ptr as *u8, (cap * size_of(T)) as u64) as *T };
        self.cap = cap;
    }

    // Appends the elements of s, which may be a view of this Vec: when it
    // grows, the elements are copied to the new memory before the old is
    // freed.
    pub fn extend_from_slice(self: *Vec<T>, s: [T]) {
        let n = s.len;
        let mut old = 0 as *T;
        if self.len + n > self.cap {
            let mut cap = if self.cap == 0 { 4 } else { self.cap * 2 };
            while cap < self.len + n {
                cap *= 2;
            }
            old = self.ptr;
            unsafe {
                self.ptr = malloc((cap * size_of(T)) as u64) as *T;
                for i in 0..self.len {
                    self.ptr[i] = old[i];
                }
            }
            self.cap = cap;
        }
        for i in 0..n {
            unsafe {
                self.ptr[self.len + i] = s[i];
            }
        }
        self.len += n;
        unsafe {
            free(old as *u8);
        }
    }

    pub fn push(self: *Vec<T>, x: T) {
        if self.len == self.cap {
            self.reserve(1);
        }
        unsafe {
            self.ptr[self.len] = x;
        }
        self.len += 1;
    }

    pub fn pop(self: *Vec<T>) -> Option<T> {
        if self.len == 0 {
            return Option::None;
        }
        self.len -= 1;
        Option::Some(unsafe { self.ptr[self.len] })
    }

    // Element i (checked: out of bounds exits with 101).
    pub fn get(self: *Vec<T>, i: i64) -> T {
        self.as_slice()[i]
    }

    pub fn set(self: *Vec<T>, i: i64, x: T) {
        self.as_slice()[i] = x;
    }

    // The last element, if there is one (the Vec keeps it; `pop` takes it).
    pub fn last(self: *Vec<T>) -> Option<T> {
        if self.len == 0 { Option::None } else { Option::Some(self.get(self.len - 1)) }
    }

    // Exchanges elements i and j (checked).
    pub fn swap(self: *Vec<T>, i: i64, j: i64) {
        let s = self.as_slice();
        let t = s[i];
        s[i] = s[j];
        s[j] = t;
    }

    // Puts x at index i, 0 to len (checked), moving the elements from i
    // on up by one.
    pub fn insert(self: *Vec<T>, i: i64, x: T) {
        if i < 0 || i > self.len {
            unsafe { panic(c"Vec::insert: index out of bounds") }
        }
        self.push(x);
        let s = self.as_slice();
        let mut k = s.len - 1;
        while k > i {
            s[k] = s[k - 1];
            k -= 1;
        }
        s[i] = x;
    }

    // Takes element i out (checked) and returns it, moving the elements
    // after it down by one.
    pub fn remove(self: *Vec<T>, i: i64) -> T {
        let s = self.as_slice();
        let x = s[i];
        for k in i..s.len - 1 {
            s[k] = s[k + 1];
        }
        self.len -= 1;
        x
    }

    // Keeps the first n elements (all of them when there are fewer).
    pub fn truncate(self: *Vec<T>, n: i64) {
        if n >= 0 && n < self.len {
            self.len = n;
        }
    }

    pub fn as_slice(self: *Vec<T>) -> [T] {
        unsafe { self.ptr[0..self.len] }
    }

    pub fn clear(self: *Vec<T>) {
        self.len = 0;
    }

    pub fn free(self: *Vec<T>) {
        unsafe {
            free(self.ptr as *u8);
        }
        self.ptr = 0 as *T;
        self.len = 0;
        self.cap = 0;
    }
}

// ---- Buf ----

// A growable buffer of bytes, for building text.
pub struct Buf { bytes: Vec<u8> }

impl Buf {
    pub fn new() -> Buf {
        Buf { bytes: Vec::new() }
    }

    pub fn len(self: *Buf) -> i64 {
        self.bytes.len
    }

    pub fn push(self: *Buf, b: u8) {
        self.bytes.push(b);
    }

    // Appends s, which may be a view of this Buf.
    pub fn push_str(self: *Buf, s: [u8]) {
        self.bytes.extend_from_slice(s);
    }

    // A C string (up to its NUL).
    pub unsafe fn push_cstr(self: *Buf, s: *u8) {
        let mut n = 0;
        while s[n] != 0 {
            n += 1;
        }
        self.bytes.extend_from_slice(s[0..n]);
    }

    // The decimal digits of v.
    pub fn push_int(self: *Buf, v: i64) {
        if v < 0 {
            self.push('-');
            if v == -9223372036854775807 - 1 {
                self.push_str("9223372036854775808");
                return;
            }
            self.push_int(-v);
            return;
        }
        if v >= 10 {
            self.push_int(v / 10);
        }
        self.push('0' + (v % 10) as u8);
    }

    pub fn as_slice(self: *Buf) -> [u8] {
        self.bytes.as_slice()
    }

    pub fn clear(self: *Buf) {
        self.bytes.clear();
    }

    pub fn free(self: *Buf) {
        self.bytes.free();
    }
}

// ---- Traits (0.9) ----

// The operators: `a + b` on a type implementing Add is `a.add(b)`, and so
// on; `-a` is `a.neg()`; `a == b` is `a.eq(&b)` (an impl wins over the
// structural ==); `a < b` is `a.cmp(&b) < 0`. Numbers implement them all
// without impl blocks, every type with == implements Eq, and numbers,
// pointers and fieldless enums Ord.
pub trait Add { fn add(self: Self, other: Self) -> Self; }
pub trait Sub { fn sub(self: Self, other: Self) -> Self; }
pub trait Mul { fn mul(self: Self, other: Self) -> Self; }
pub trait Div { fn div(self: Self, other: Self) -> Self; }
pub trait Neg { fn neg(self: Self) -> Self; }
pub trait Eq { fn eq(self: *Self, other: *Self) -> bool; }
// Negative, zero or positive: self before, like or after other.
pub trait Ord { fn cmp(self: *Self, other: *Self) -> i64; }
pub trait Hash { fn hash(self: *Self) -> u64; }

// A 64-bit mix of x (splitmix64's finalizer): the hash of the integers.
pub fn hash_u64(x: u64) -> u64 {
    let mut z = x + 0x9e3779b97f4a7c15u64;
    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9u64;
    z = (z ^ (z >> 27)) * 0x94d049bb133111ebu64;
    z ^ (z >> 31)
}

impl Eq for i8 {
    fn eq(self: *i8, other: *i8) -> bool { *self == *other }
}

impl Ord for i8 {
    fn cmp(self: *i8, other: *i8) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for i8 {
    fn hash(self: *i8) -> u64 { hash_u64(*self as u64) }
}

impl Eq for i16 {
    fn eq(self: *i16, other: *i16) -> bool { *self == *other }
}

impl Ord for i16 {
    fn cmp(self: *i16, other: *i16) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for i16 {
    fn hash(self: *i16) -> u64 { hash_u64(*self as u64) }
}

impl Eq for i32 {
    fn eq(self: *i32, other: *i32) -> bool { *self == *other }
}

impl Ord for i32 {
    fn cmp(self: *i32, other: *i32) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for i32 {
    fn hash(self: *i32) -> u64 { hash_u64(*self as u64) }
}

impl Eq for i64 {
    fn eq(self: *i64, other: *i64) -> bool { *self == *other }
}

impl Ord for i64 {
    fn cmp(self: *i64, other: *i64) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for i64 {
    fn hash(self: *i64) -> u64 { hash_u64(*self as u64) }
}

impl Eq for u8 {
    fn eq(self: *u8, other: *u8) -> bool { *self == *other }
}

impl Ord for u8 {
    fn cmp(self: *u8, other: *u8) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for u8 {
    fn hash(self: *u8) -> u64 { hash_u64(*self as u64) }
}

impl Eq for u16 {
    fn eq(self: *u16, other: *u16) -> bool { *self == *other }
}

impl Ord for u16 {
    fn cmp(self: *u16, other: *u16) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for u16 {
    fn hash(self: *u16) -> u64 { hash_u64(*self as u64) }
}

impl Eq for u32 {
    fn eq(self: *u32, other: *u32) -> bool { *self == *other }
}

impl Ord for u32 {
    fn cmp(self: *u32, other: *u32) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for u32 {
    fn hash(self: *u32) -> u64 { hash_u64(*self as u64) }
}

impl Eq for u64 {
    fn eq(self: *u64, other: *u64) -> bool { *self == *other }
}

impl Ord for u64 {
    fn cmp(self: *u64, other: *u64) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for u64 {
    fn hash(self: *u64) -> u64 { hash_u64(*self as u64) }
}

impl Eq for bool {
    fn eq(self: *bool, other: *bool) -> bool { *self == *other }
}

impl Ord for bool {
    fn cmp(self: *bool, other: *bool) -> i64 {
        if !*self && *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for bool {
    fn hash(self: *bool) -> u64 { hash_u64(*self as u64) }
}

// Byte strings: compared by bytes, ordered lexicographically, hashed with
// FNV-1a.
impl Eq for [u8] {
    fn eq(self: *[u8], other: *[u8]) -> bool {
        let a = *self;
        let b = *other;
        if a.len != b.len {
            return false;
        }
        for i in 0..a.len {
            if a[i] != b[i] {
                return false;
            }
        }
        true
    }
}

impl Ord for [u8] {
    fn cmp(self: *[u8], other: *[u8]) -> i64 {
        let a = *self;
        let b = *other;
        let n = if a.len < b.len { a.len } else { b.len };
        for i in 0..n {
            if a[i] != b[i] {
                return if a[i] < b[i] { -1 } else { 1 };
            }
        }
        if a.len < b.len { -1 } else if a.len == b.len { 0 } else { 1 }
    }
}

impl Hash for [u8] {
    fn hash(self: *[u8]) -> u64 {
        let mut h = 14695981039346656037u64;
        for b in *self {
            h = (h ^ b as u64) * 1099511628211u64;
        }
        h
    }
}

// Sorts s in place, smallest first; not stable (equal elements may change
// order). An introsort: quicksort around the median of three, insertion
// sort for short runs, heapsort where the quicksort goes too deep, so
// O(n log n) comparisons at worst. A `cmp` that is not a total order
// leaves s in some order, never out of bounds.
pub fn sort<T: Ord>(s: [T]) {
    let mut depth = 0;
    let mut n = s.len;
    while n > 1 {
        depth += 2;
        n /= 2;
    }
    quicksort::<T>(s, 0, s.len, depth);
}

// Short runs are sorted by insertion.
const SORT_SMALL: i64 = 24;

// Sorts s[lo..hi]; below `depth` more partitions, by heapsort.
fn quicksort<T: Ord>(s: [T], lo: i64, hi: i64, depth: i64) {
    let mut lo = lo;
    let mut hi = hi;
    let mut depth = depth;
    while hi - lo > SORT_SMALL {
        if depth == 0 {
            heapsort::<T>(s[lo..hi]);
            return;
        }
        depth -= 1;
        // The median of the first, middle and last elements, at lo.
        let mid = lo + (hi - lo) / 2;
        if s[mid] < s[lo] {
            swap::<T>(s, mid, lo);
        }
        if s[hi - 1] < s[mid] {
            swap::<T>(s, hi - 1, mid);
            if s[mid] < s[lo] {
                swap::<T>(s, mid, lo);
            }
        }
        swap::<T>(s, lo, mid);
        // Hoare's partition: s[lo..p] <= pivot <= s[p + 1..hi]. Equal
        // elements stop both scans, so many equal keys split evenly.
        let pivot = s[lo];
        let mut i = lo;
        let mut j = hi;
        loop {
            i += 1;
            while i < hi && s[i] < pivot {
                i += 1;
            }
            j -= 1;
            while j > lo && pivot < s[j] {
                j -= 1;
            }
            if i >= j {
                break;
            }
            swap::<T>(s, i, j);
        }
        swap::<T>(s, lo, j);
        // The shorter side by recursion, the longer by the loop: a stack
        // of O(log n).
        if j - lo < hi - j - 1 {
            quicksort::<T>(s, lo, j, depth);
            lo = j + 1;
        } else {
            quicksort::<T>(s, j + 1, hi, depth);
            hi = j;
        }
    }
    insertion_sort::<T>(s, lo, hi);
}

fn insertion_sort<T: Ord>(s: [T], lo: i64, hi: i64) {
    for i in lo + 1..hi {
        let x = s[i];
        let mut j = i;
        while j > lo && x < s[j - 1] {
            s[j] = s[j - 1];
            j -= 1;
        }
        s[j] = x;
    }
}

fn swap<T>(s: [T], i: i64, j: i64) {
    let t = s[i];
    s[i] = s[j];
    s[j] = t;
}

fn heapsort<T: Ord>(s: [T]) {
    let n = s.len;
    let mut start = n / 2;
    while start > 0 {
        start -= 1;
        sift_down::<T>(s, start, n);
    }
    let mut end = n;
    while end > 1 {
        end -= 1;
        let top = s[0];
        s[0] = s[end];
        s[end] = top;
        sift_down::<T>(s, 0, end);
    }
}

fn sift_down<T: Ord>(s: [T], start: i64, end: i64) {
    let mut root = start;
    loop {
        let mut child = 2 * root + 1;
        if child >= end {
            return;
        }
        if child + 1 < end && s[child] < s[child + 1] {
            child += 1;
        }
        if !(s[root] < s[child]) {
            return;
        }
        let t = s[root];
        s[root] = s[child];
        s[child] = t;
        root = child;
    }
}

// ---- HashMap ----

// A hash table (open addressing, linear probing) from K to V. Slots are
// numbered 0..slots(); `key_at(i)` and `value_at(i)` give an occupied
// slot's entry (None for a free one), which is how the map is iterated.
pub struct HashMap<K: Hash + Eq, V> {
    keys: *K, values: *V, states: *u8, cap: i64, len: i64, used: i64,
}

// Slot states.
const SLOT_FREE: u8 = 0;
const SLOT_FULL: u8 = 1;
const SLOT_GONE: u8 = 2;

impl<K: Hash + Eq, V> HashMap<K, V> {
    pub fn new() -> HashMap<K, V> {
        HashMap { keys: 0 as *K, values: 0 as *V, states: 0 as *u8, cap: 0, len: 0, used: 0 }
    }

    pub fn len(self: *HashMap<K, V>) -> i64 {
        self.len
    }

    pub fn is_empty(self: *HashMap<K, V>) -> bool {
        self.len == 0
    }

    // The slot holding `key`, or -1.
    fn slot_of(self: *HashMap<K, V>, key: *K) -> i64 {
        if self.cap == 0 {
            return -1;
        }
        let mask = self.cap - 1;
        let mut i = (key.hash() & mask as u64) as i64;
        loop {
            let state = unsafe { self.states[i] };
            if state == SLOT_FREE {
                return -1;
            }
            if state == SLOT_FULL && unsafe { self.keys[i] } == *key {
                return i;
            }
            i = (i + 1) & mask;
        }
    }

    pub fn contains(self: *HashMap<K, V>, key: K) -> bool {
        self.slot_of(&key) >= 0
    }

    // The same as `contains` (Rust's name).
    pub fn contains_key(self: *HashMap<K, V>, key: K) -> bool {
        self.slot_of(&key) >= 0
    }

    // A copy of the value of `key`, if it has one (`get_mut` changes it).
    pub fn get(self: *HashMap<K, V>, key: K) -> Option<V> {
        let i = self.slot_of(&key);
        if i < 0 { Option::None } else { Option::Some(unsafe { self.values[i] }) }
    }

    // The value of `key` in place, as a view of one element, if it has
    // one: `if let Some(a) = m.get_mut(k) { a[0].balance += 10; }`. The
    // view is valid until the map's next insert, remove or free (like a
    // Vec's `as_slice()`).
    pub fn get_mut(self: *HashMap<K, V>, key: K) -> Option<[V]> {
        let i = self.slot_of(&key);
        if i < 0 { Option::None } else { Option::Some(unsafe { self.values[i..i + 1] }) }
    }

    // The value of `key` in place (a view of one element, as `get_mut`),
    // inserted as `default` first if the key has none; Rust's
    // `entry(k).or_insert(d)`. Counting: `counts.get_or_insert(w, 0)[0] += 1;`.
    pub fn get_or_insert(self: *HashMap<K, V>, key: K, default: V) -> [V] {
        let mut i = self.slot_of(&key);
        if i < 0 {
            i = self.insert_new(key, default);
        }
        unsafe { self.values[i..i + 1] }
    }

    // Sets the value of `key`; returns its old value, if it had one.
    pub fn insert(self: *HashMap<K, V>, key: K, value: V) -> Option<V> {
        let i = self.slot_of(&key);
        if i >= 0 {
            let old = unsafe { self.values[i] };
            unsafe {
                self.values[i] = value;
            }
            return Option::Some(old);
        }
        self.insert_new(key, value);
        Option::None
    }

    // Adds `key`, which the map does not have; returns its slot.
    fn insert_new(self: *HashMap<K, V>, key: K, value: V) -> i64 {
        if (self.used + 1) * 4 > self.cap * 3 {
            self.rehash();
        }
        let mask = self.cap - 1;
        let mut j = (key.hash() & mask as u64) as i64;
        while unsafe { self.states[j] } == SLOT_FULL {
            j = (j + 1) & mask;
        }
        unsafe {
            if self.states[j] == SLOT_FREE {
                self.used += 1;
            }
            self.states[j] = SLOT_FULL;
            self.keys[j] = key;
            self.values[j] = value;
        }
        self.len += 1;
        j
    }

    // Removes `key`; returns its value, if it had one.
    pub fn remove(self: *HashMap<K, V>, key: K) -> Option<V> {
        let i = self.slot_of(&key);
        if i < 0 {
            return Option::None;
        }
        self.len -= 1;
        unsafe {
            self.states[i] = SLOT_GONE;
            Option::Some(self.values[i])
        }
    }

    pub fn slots(self: *HashMap<K, V>) -> i64 {
        self.cap
    }

    pub fn key_at(self: *HashMap<K, V>, i: i64) -> Option<K> {
        if i < 0 || i >= self.cap || unsafe { self.states[i] } != SLOT_FULL {
            return Option::None;
        }
        Option::Some(unsafe { self.keys[i] })
    }

    pub fn value_at(self: *HashMap<K, V>, i: i64) -> Option<V> {
        if i < 0 || i >= self.cap || unsafe { self.states[i] } != SLOT_FULL {
            return Option::None;
        }
        Option::Some(unsafe { self.values[i] })
    }

    // Twice the room (at least 8 slots), the entries moved over and the
    // removed ones dropped.
    fn rehash(self: *HashMap<K, V>) {
        let old_cap = self.cap;
        let old_keys = self.keys;
        let old_values = self.values;
        let old_states = self.states;
        let mut cap = if old_cap == 0 { 8 } else { old_cap * 2 };
        while self.len * 2 > cap {
            cap *= 2;
        }
        unsafe {
            self.keys = malloc((cap * size_of(K)) as u64) as *K;
            self.values = malloc((cap * size_of(V)) as u64) as *V;
            self.states = malloc(cap as u64);
            for i in 0..cap {
                self.states[i] = SLOT_FREE;
            }
        }
        self.cap = cap;
        self.used = self.len;
        let mask = cap - 1;
        for i in 0..old_cap {
            if unsafe { old_states[i] } != SLOT_FULL {
                continue;
            }
            let key = unsafe { old_keys[i] };
            let mut j = (key.hash() & mask as u64) as i64;
            unsafe {
                while self.states[j] == SLOT_FULL {
                    j = (j + 1) & mask;
                }
                self.states[j] = SLOT_FULL;
                self.keys[j] = key;
                self.values[j] = old_values[i];
            }
        }
        if old_cap > 0 {
            unsafe {
                free(old_keys as *u8);
                free(old_values as *u8);
                free(old_states);
            }
        }
    }

    pub fn free(self: *HashMap<K, V>) {
        if self.cap > 0 {
            unsafe {
                free(self.keys as *u8);
                free(self.values as *u8);
                free(self.states);
            }
        }
        self.cap = 0;
        self.len = 0;
        self.used = 0;
    }
}
