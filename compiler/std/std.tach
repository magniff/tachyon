impl Eq for bool {
    fn eq(self: &bool, other: &bool) -> bool { *self == *other }
}

impl Ord for bool {
    fn cmp(self: &bool, other: &bool) -> i64 {
        if !*self && *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for bool {
    fn hash(self: &bool) -> u64 { hash_u64(*self as u64) }
}

// Byte strings: compared by bytes, ordered lexicographically, hashed with
// FNV-1a.
impl Eq for [u8] {
    fn eq(self: &Self, other: &Self) -> bool {
        let a = *self;
        let b = *other;
        if a.len != b.len {
            return false;
        }
        for i in 0..a.len {
            if a[i] != b[i] {
                return false;
            }
        }
        true
    }
}

impl Ord for [u8] {
    fn cmp(self: &Self, other: &Self) -> i64 {
        let a = *self;
        let b = *other;
        let n = if a.len < b.len { a.len } else { b.len };
        for i in 0..n {
            if a[i] != b[i] {
                return if a[i] < b[i] { -1 } else { 1 };
            }
        }
        if a.len < b.len { -1 } else if a.len == b.len { 0 } else { 1 }
    }
}

impl Hash for [u8] {
    fn hash(self: &Self) -> u64 {
        let mut h = 14695981039346656037u64;
        for b in *self {
            h = (h ^ b as u64) * 1099511628211u64;
        }
        h
    }
}

// ---- HashMap's room (0.16) ----

impl<K: Hash + Eq, V, A: Allocator> HashMap<K, V, A> {
    // Its allocator (0.16): a copy of the handle.
    pub fn allocator(self: &HashMap<K, V, A>) -> A {
        self.alloc
    }

    // An empty map on allocator a with room for n entries (0.16).
    pub fn with_capacity_in(n: i64, a: A) -> HashMap<K, V, A> {
        let mut m: HashMap<K, V, A> = HashMap::new_in(a);
        if n > 0 {
            if n > ALLOC_LIMIT / 8 {
                out_of_memory();
            }
            // (slots: a power of two, 8 at least, n at most 3/4 of them)
            let mut cap = 8;
            for _ in 0..62 {
                if n * 4 <= cap * 3 {
                    break;
                }
                cap *= 2;
            }
            m.rehash_to(cap);
        }
        m
    }
}

// ---- Contract checks: the implementation (0.18) ----

// (0.18) A contract or assertion check, which the compiler makes (from a
// `requires` or `ensures` clause, `assert`, `assert_eq`, ...): both back
// ends branch to the run-time failure when `ok` is false, whose line the
// compiler writes from `check` (front/contracts/checks.tach) and `site`
// (the position it blames); a, b, c: the values of the holes of an
// f-string message (`else f"index {i}"`), evaluated only when `ok` is
// false. Not called by programs.
pub fn contract_check(ok: bool, site: i64, check: i64, a: i64 = 0, b: i64 = 0, c: i64 = 0) {
    if !ok {
        unsafe { panic(c"contract check failed") }
    }
}
