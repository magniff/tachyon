    fn eq(self: &u16, other: &u16) -> bool { *self == *other }
}

impl Ord for u16 {
    fn cmp(self: &u16, other: &u16) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for u16 {
    fn hash(self: &u16) -> u64 { hash_u64(*self as u64) }
}

