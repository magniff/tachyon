// The standard library (0.5): the module `std`, built into the compiler
// (compiler/std/embed.sh makes compiler/src/front/stdsrc.tach from this file
// and the ones it appends: iter.tach, io.tach, fmt.tach, convert.tach,
// clone.tach, alloc.tach, then Gpa's implementation: gpa.tach). A program
// that names `std` gets it: `std::Vec<i64>`, `use std::{Buf, Vec};`.
//
// This file, the core: Option and Result, a growable vector, a byte
// buffer, the operator traits, sorting and a hash map.
// Failures (unwrapping None, an index out of bounds) print a message on
// stderr and exit with 101, like the language's own checks.
//
// Allocation (0.16): Vec, Buf and HashMap take their memory from an
// allocator, a type parameter (`Vec<T, A: Allocator = Gpa>`, alloc.tach),
// every growth and free through it.
//
// Unsafe code (0.9): the safe functions here have no undefined behaviour
// as long as a Vec's and a Buf's fields are changed by their methods only
// (0.16: #[sealed], checked from 0.16's T2), and a slice from `as_slice` (or a
// HashMap's `get_mut`, `get_or_insert`) is not used after the Vec grows
// (the map gets a new key) or is freed. The functions taking C strings
// are `unsafe fn`: the string must end with a NUL.

// (0.16) Their effects declared: allocation, I/O, none.
extern "C" {
    #[effects(alloc(extern))]
    fn malloc(size: u64) -> *u8;
    #[effects(alloc(extern))]
    fn realloc(p: *u8, size: u64) -> *u8;
    #[effects(alloc(extern))]
    fn free(p: *u8);
    #[effects(io)]
    fn write(fd: i32, data: *u8, count: u64) -> i64;
    #[effects(io)]
    fn read(fd: i32, data: *u8, count: u64) -> i64;
    #[effects(io, diverge)]
    fn exit(code: i32) -> !;
    #[effects()]
    fn memcpy(dst: *u8, src: *u8, n: u64) -> *u8;
    #[effects()]
    fn strlen(s: *u8) -> u64;
    // (0.16) What std's panic calls: its effect is `panic`, not the io of
    // writing a message and exiting (docs/design/effects-allocation.md
    // §2.2).
    #[link_name = "write"]
    #[effects(panic)]
    fn panic_write(fd: i32, data: *u8, count: u64) -> i64;
    #[link_name = "exit"]
    #[effects(panic)]
    fn panic_exit(code: i32) -> !;
}

// Prints `message` (a C string) on stderr and exits with 101.
pub unsafe fn panic(message: *u8) -> ! {
    panic_write(2, message, strlen(message));
    panic_write(2, c"\n", 1);
    panic_exit(101)
}

// ---- Option and Result ----

pub enum Option<T> { None, Some(T) }

impl<T> Option<T> {
    pub fn is_some(self: *Option<T>) -> bool {
        match *self {
            Option::Some(_) => true,
            Option::None => false,
        }
    }

    pub fn is_none(self: *Option<T>) -> bool {
        !self.is_some()
    }

    pub fn unwrap(self: Option<T>) -> T {
        match self {
            Option::Some(x) => x,
            Option::None => unsafe { panic(c"called unwrap on None") },
        }
    }

    pub fn unwrap_or(self: Option<T>, other: T) -> T {
        match self {
            Option::Some(x) => x,
            Option::None => other,
        }
    }
}

pub enum Result<T, E> { Ok(T), Err(E) }

impl<T, E> Result<T, E> {
    pub fn is_ok(self: *Result<T, E>) -> bool {
        match *self {
            Result::Ok(_) => true,
            Result::Err(_) => false,
        }
    }

    pub fn is_err(self: *Result<T, E>) -> bool {
        !self.is_ok()
    }

    pub fn unwrap(self: Result<T, E>) -> T {
        match self {
            Result::Ok(x) => x,
            Result::Err(_) => unsafe { panic(c"called unwrap on Err") },
        }
    }

    pub fn unwrap_or(self: Result<T, E>, other: T) -> T {
        match self {
            Result::Ok(x) => x,
            Result::Err(_) => other,
        }
    }

    pub fn ok(self: Result<T, E>) -> Option<T> {
        match self {
            Result::Ok(x) => Option::Some(x),
            Result::Err(_) => Option::None,
        }
    }
}

// ---- Vec ----

// A growable vector of T, its memory from allocator A (0.16; Gpa, C's
// malloc, by default); `free` gives its memory back.
#[sealed]
pub struct Vec<T, A: Allocator = Gpa> { ptr: *T, len: i64, cap: i64, alloc: A }

impl<T, A: Allocator> Vec<T, A> {
    // An empty Vec on allocator a (0.16).
    pub fn new_in(a: A) -> Vec<T, A> {
        Vec { ptr: 0 as *T, len: 0, cap: 0, alloc: a }
    }

    // An empty Vec on allocator a with room for cap elements (0.16).
    pub fn with_capacity_in(cap: i64, a: A) -> Vec<T, A> {
        let mut v: Vec<T, A> = Vec::new_in(a);
        v.reserve(cap);
        v
    }

    // (0.15) n copies of x on allocator a: Rust's `vec![x; n]`. x is copied
    // as it is, not cloned: n Vecs from one non-empty Vec would share its
    // elements (push `Vec::new_in(a)` n times instead).
    pub fn filled_in(n: i64, x: T, a: A) -> Vec<T, A> {
        let mut v: Vec<T, A> = Vec::with_capacity_in(n, a);
        for _ in 0..n {
            v.push(x);
        }
        v
    }

    pub fn len(self: *Vec<T, A>) -> i64 {
        self.len
    }

    pub fn is_empty(self: *Vec<T, A>) -> bool {
        self.len == 0
    }

    // Room for `extra` more elements.
    pub fn reserve(self: *Vec<T, A>, extra: i64) {
        if extra > self.cap - self.len && !self.reserve_more(extra) {
            out_of_memory();
        }
    }

    // Grows to room for `extra` (more than it has) more elements: twice the
    // capacity, or more when needed; false when out of memory.
    #[inline(never)]
    fn reserve_more(self: *Vec<T, A>, extra: i64) -> bool {
        if extra > ALLOC_LIMIT - self.len {
            return false;
        }
        let cap = grown_cap(self.cap, self.len + extra);
        let bytes = alloc_bytes(cap, size_of(T));
        if bytes < 0 {
            return false;
        }
        let p = unsafe {
            self.alloc.try_resize(self.ptr as *u8, self.cap * size_of(T), bytes, align_of(T))
        };
        if p == 0 as *u8 {
            return false;
        }
        self.ptr = p as *T;
        self.cap = cap;
        true
    }

    // Appends the elements of s, which may be a view of this Vec: when it
    // grows, the elements are copied to the new memory before the old is
    // freed.
    pub fn extend_from_slice(self: *Vec<T, A>, s: [T]) {
        let n = s.len;
        let mut old = 0 as *T;
        let mut old_cap = 0;
        if n > self.cap - self.len {
            let mut cap = -1;
            if n <= ALLOC_LIMIT - self.len {
                cap = grown_cap(self.cap, self.len + n);
            }
            let bytes = alloc_bytes(cap, size_of(T));
            if bytes < 0 {
                out_of_memory();
            }
            old = self.ptr;
            old_cap = self.cap;
            let p = self.alloc.try_alloc(bytes, align_of(T));
            if p == 0 as *u8 {
                out_of_memory();
            }
            unsafe {
                self.ptr = p as *T;
                for i in 0..self.len {
                    self.ptr[i] = old[i];
                }
            }
            self.cap = cap;
        }
        for i in 0..n {
            unsafe {
                self.ptr[self.len + i] = s[i];
            }
        }
        self.len += n;
        unsafe {
            self.alloc.free(old as *u8, old_cap * size_of(T), align_of(T));
        }
    }

    pub fn push(self: *Vec<T, A>, x: T) {
        if self.len == self.cap && !self.reserve_more(1) {
            out_of_memory();
        }
        unsafe {
            self.ptr[self.len] = x;
        }
        self.len += 1;
    }

    pub fn pop(self: *Vec<T, A>) -> Option<T> {
        if self.len == 0 {
            return Option::None;
        }
        self.len -= 1;
        Option::Some(unsafe { self.ptr[self.len] })
    }

    // Element i (checked: out of bounds exits with 101).
    pub fn get(self: *Vec<T, A>, i: i64) -> T {
        self.as_slice()[i]
    }

    pub fn set(self: *Vec<T, A>, i: i64, x: T) {
        self.as_slice()[i] = x;
    }

    // The last element, if there is one (the Vec keeps it; `pop` takes it).
    pub fn last(self: *Vec<T, A>) -> Option<T> {
        if self.len == 0 { Option::None } else { Option::Some(self.get(self.len - 1)) }
    }

    // Exchanges elements i and j (checked).
    pub fn swap(self: *Vec<T, A>, i: i64, j: i64) {
        let s = self.as_slice();
        let t = s[i];
        s[i] = s[j];
        s[j] = t;
    }

    // Puts x at index i, 0 to len (checked), moving the elements from i
    // on up by one.
    pub fn insert(self: *Vec<T, A>, i: i64, x: T) {
        if i < 0 || i > self.len {
            unsafe { panic(c"Vec::insert: index out of bounds") }
        }
        self.push(x);
        let s = self.as_slice();
        let last = s.len - 1;
        for d in 0..last - i {
            let k = last - d;
            s[k] = s[k - 1];
        }
        s[i] = x;
    }

    // Takes element i out (checked) and returns it, moving the elements
    // after it down by one.
    pub fn remove(self: *Vec<T, A>, i: i64) -> T {
        let s = self.as_slice();
        let x = s[i];
        for k in i..s.len - 1 {
            s[k] = s[k + 1];
        }
        self.len -= 1;
        x
    }

    // Keeps the first n elements (all of them when there are fewer).
    pub fn truncate(self: *Vec<T, A>, n: i64) {
        if n >= 0 && n < self.len {
            self.len = n;
        }
    }

    pub fn as_slice(self: *Vec<T, A>) -> [T] {
        unsafe { self.ptr[0..self.len] }
    }

    pub fn clear(self: *Vec<T, A>) {
        self.len = 0;
    }

    pub fn free(self: *Vec<T, A>) {
        unsafe {
            self.alloc.free(self.ptr as *u8, self.cap * size_of(T), align_of(T));
        }
        self.ptr = 0 as *T;
        self.len = 0;
        self.cap = 0;
    }
}

// (0.16) The ambient constructors of 0.15, errors outside std: allocation
// is explicit (front/ambient.tach; fix --only alloc016 reads them).
impl<T, A: Allocator + Ambient> Vec<T, A> {
    #[ambient("Vec::new_in(gpa)")]
    pub fn new() -> Vec<T, A> {
        Vec { ptr: 0 as *T, len: 0, cap: 0, alloc: A::ambient() }
    }

    #[ambient("Vec::with_capacity_in(cap, gpa)")]
    pub fn with_capacity(cap: i64) -> Vec<T, A> {
        Vec::with_capacity_in(cap, A::ambient())
    }

    #[ambient("Vec::filled_in(n, x, gpa)")]
    pub fn filled(n: i64, x: T) -> Vec<T, A> {
        Vec::filled_in(n, x, A::ambient())
    }
}

// ---- Vec's room and allocator (0.16) ----

impl<T, A: Allocator> Vec<T, A> {
    // The elements it has room for (0.16).
    pub fn capacity(self: *Vec<T, A>) -> i64 {
        self.cap
    }

    // Its allocator (0.16): a copy of the handle.
    pub fn allocator(self: *Vec<T, A>) -> A {
        self.alloc
    }

    // Room for `extra` more elements, or Err when out of memory, the Vec
    // as it was (0.16).
    pub fn try_reserve(self: *Vec<T, A>, extra: i64) -> Result<(), AllocError> {
        if extra > self.cap - self.len && !self.reserve_more(extra) {
            return Result::Err(AllocError::OutOfMemory);
        }
        Result::Ok(())
    }

    // push, or Err when out of memory, the Vec as it was (0.16).
    pub fn try_push(self: *Vec<T, A>, x: T) -> Result<(), AllocError> {
        if self.len == self.cap && !self.reserve_more(1) {
            return Result::Err(AllocError::OutOfMemory);
        }
        unsafe {
            self.ptr[self.len] = x;
        }
        self.len += 1;
        Result::Ok(())
    }
}

// ---- Buf ----

// A growable buffer of bytes, for building text (0.16: on allocator A).
#[sealed]
pub struct Buf<A: Allocator = Gpa> { bytes: Vec<u8, A> }

impl<A: Allocator> Buf<A> {
    // An empty Buf on allocator a (0.16).
    pub fn new_in(a: A) -> Buf<A> {
        Buf { bytes: Vec::new_in(a) }
    }

    pub fn len(self: *Buf<A>) -> i64 {
        self.bytes.len
    }

    pub fn push(self: *Buf<A>, b: u8) {
        self.bytes.push(b);
    }

    // Appends s, which may be a view of this Buf.
    pub fn push_str(self: *Buf<A>, s: [u8]) {
        self.bytes.extend_from_slice(s);
    }

    // A C string (up to its NUL).
    pub unsafe fn push_cstr(self: *Buf<A>, s: *u8) {
        self.bytes.extend_from_slice(s[0..strlen(s) as i64]);
    }

    // The decimal digits of v.
    pub fn push_int(self: *Buf<A>, v: i64) {
        let negative = v < 0;
        let u = if negative { (-(v + 1)) as u64 + 1 } else { v as u64 };
        let n = if negative { decimal_len(u) + 1 } else { decimal_len(u) };
        if n > self.bytes.cap - self.bytes.len {
            self.bytes.reserve(n);
        }
        unsafe {
            put_decimal(&self.bytes.ptr[self.bytes.len], n, u, negative);
        }
        self.bytes.len += n;
    }

    pub fn as_slice(self: *Buf<A>) -> [u8] {
        self.bytes.as_slice()
    }

    pub fn clear(self: *Buf<A>) {
        self.bytes.clear();
    }

    pub fn free(self: *Buf<A>) {
        self.bytes.free();
    }
}

impl<A: Allocator + Ambient> Buf<A> {
    #[ambient("Buf::new_in(gpa)")]
    pub fn new() -> Buf<A> {
        Buf { bytes: Vec::new_in(A::ambient()) }
    }
}

// The number of decimal digits of u.
#[inline]
fn decimal_len(u: u64) -> i64 {
    let mut n = 1;
    let mut ten: u64 = 10;
    for _ in 1..20 {
        if u < ten {
            break;
        }
        n += 1;
        ten *= 10;
    }
    n
}

// u's decimal digits in p[0..n] (n: decimal_len(u), one more when
// negative: after a '-'), two at a time. Unsafe: p has n bytes.
#[inline]
unsafe fn put_decimal(p: *u8, n: i64, u: u64, negative: bool) {
    let pairs = "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899";
    let mut x = u;
    let mut i = n;
    for _ in 0..10 {
        if x < 100 {
            break;
        }
        let q = x / 100;
        let r = (x - q * 100) as i64 * 2;
        i -= 2;
        p[i] = pairs.ptr[r];
        p[i + 1] = pairs.ptr[r + 1];
        x = q;
    }
    if x >= 10 {
        let r = x as i64 * 2;
        p[i - 2] = pairs.ptr[r];
        p[i - 1] = pairs.ptr[r + 1];
    } else {
        p[i - 1] = '0' + x as u8;
    }
    if negative {
        p[0] = '-';
    }
}

// ---- Buf's room and allocator (0.16) ----

impl<A: Allocator> Buf<A> {
    // An empty Buf on allocator a with room for cap bytes (0.16).
    pub fn with_capacity_in(cap: i64, a: A) -> Buf<A> {
        Buf { bytes: Vec::with_capacity_in(cap, a) }
    }

    // The bytes it has room for (0.16).
    pub fn capacity(self: *Buf<A>) -> i64 {
        self.bytes.cap
    }

    // Room for `extra` more bytes (0.16).
    pub fn reserve(self: *Buf<A>, extra: i64) {
        self.bytes.reserve(extra);
    }

    // Its allocator (0.16): a copy of the handle.
    pub fn allocator(self: *Buf<A>) -> A {
        self.bytes.alloc
    }
}

// ---- Traits (0.9) ----

// The operators: `a + b` on a type implementing Add is `a.add(b)`, and so
// on; `-a` is `a.neg()`; `a == b` is `a.eq(&b)` (an impl wins over the
// structural ==); `a < b` is `a.cmp(&b) < 0`. Numbers implement them all
// without impl blocks, every type with == implements Eq, and numbers,
// pointers and fieldless enums Ord.
pub trait Add { fn add(self: Self, other: Self) -> Self; }
pub trait Sub { fn sub(self: Self, other: Self) -> Self; }
pub trait Mul { fn mul(self: Self, other: Self) -> Self; }
pub trait Div { fn div(self: Self, other: Self) -> Self; }
pub trait Neg { fn neg(self: Self) -> Self; }
pub trait Eq { #[pure] fn eq(self: *Self, other: *Self) -> bool; }
// Negative, zero or positive: self before, like or after other.
pub trait Ord { #[pure] fn cmp(self: *Self, other: *Self) -> i64; }
pub trait Hash { #[pure] fn hash(self: *Self) -> u64; }

// A 64-bit mix of x (splitmix64's finalizer): the hash of the integers.
pub fn hash_u64(x: u64) -> u64 {
    let mut z = x + 0x9e3779b97f4a7c15u64;
    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9u64;
    z = (z ^ (z >> 27)) * 0x94d049bb133111ebu64;
    z ^ (z >> 31)
}

impl Eq for i8 {
    fn eq(self: *i8, other: *i8) -> bool { *self == *other }
}

impl Ord for i8 {
    fn cmp(self: *i8, other: *i8) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for i8 {
    fn hash(self: *i8) -> u64 { hash_u64(*self as u64) }
}

impl Eq for i16 {
    fn eq(self: *i16, other: *i16) -> bool { *self == *other }
}

impl Ord for i16 {
    fn cmp(self: *i16, other: *i16) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for i16 {
    fn hash(self: *i16) -> u64 { hash_u64(*self as u64) }
}

impl Eq for i32 {
    fn eq(self: *i32, other: *i32) -> bool { *self == *other }
}

impl Ord for i32 {
    fn cmp(self: *i32, other: *i32) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for i32 {
    fn hash(self: *i32) -> u64 { hash_u64(*self as u64) }
}

impl Eq for i64 {
    fn eq(self: *i64, other: *i64) -> bool { *self == *other }
}

impl Ord for i64 {
    fn cmp(self: *i64, other: *i64) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for i64 {
    fn hash(self: *i64) -> u64 { hash_u64(*self as u64) }
}

impl Eq for u8 {
    fn eq(self: *u8, other: *u8) -> bool { *self == *other }
}

impl Ord for u8 {
    fn cmp(self: *u8, other: *u8) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for u8 {
    fn hash(self: *u8) -> u64 { hash_u64(*self as u64) }
}

impl Eq for u16 {
    fn eq(self: *u16, other: *u16) -> bool { *self == *other }
}

impl Ord for u16 {
    fn cmp(self: *u16, other: *u16) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for u16 {
    fn hash(self: *u16) -> u64 { hash_u64(*self as u64) }
}

impl Eq for u32 {
    fn eq(self: *u32, other: *u32) -> bool { *self == *other }
}

impl Ord for u32 {
    fn cmp(self: *u32, other: *u32) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for u32 {
    fn hash(self: *u32) -> u64 { hash_u64(*self as u64) }
}

impl Eq for u64 {
    fn eq(self: *u64, other: *u64) -> bool { *self == *other }
}

impl Ord for u64 {
    fn cmp(self: *u64, other: *u64) -> i64 {
        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for u64 {
    fn hash(self: *u64) -> u64 { hash_u64(*self as u64) }
}

impl Eq for bool {
    fn eq(self: *bool, other: *bool) -> bool { *self == *other }
}

impl Ord for bool {
    fn cmp(self: *bool, other: *bool) -> i64 {
        if !*self && *other { -1 } else if *self == *other { 0 } else { 1 }
    }
}

impl Hash for bool {
    fn hash(self: *bool) -> u64 { hash_u64(*self as u64) }
}

// Byte strings: compared by bytes, ordered lexicographically, hashed with
// FNV-1a.
impl Eq for [u8] {
    fn eq(self: *[u8], other: *[u8]) -> bool {
        let a = *self;
        let b = *other;
        if a.len != b.len {
            return false;
        }
        for i in 0..a.len {
            if a[i] != b[i] {
                return false;
            }
        }
        true
    }
}

impl Ord for [u8] {
    fn cmp(self: *[u8], other: *[u8]) -> i64 {
        let a = *self;
        let b = *other;
        let n = if a.len < b.len { a.len } else { b.len };
        for i in 0..n {
            if a[i] != b[i] {
                return if a[i] < b[i] { -1 } else { 1 };
            }
        }
        if a.len < b.len { -1 } else if a.len == b.len { 0 } else { 1 }
    }
}

impl Hash for [u8] {
    fn hash(self: *[u8]) -> u64 {
        let mut h = 14695981039346656037u64;
        for b in *self {
            h = (h ^ b as u64) * 1099511628211u64;
        }
        h
    }
}

// Sorts s in place, smallest first; not stable (equal elements may change
// order). An introsort: quicksort around the median of three, insertion
// sort for short runs, heapsort where the quicksort goes too deep, so
// O(n log n) comparisons at worst. A `cmp` that is not a total order
// leaves s in some order, never out of bounds. (0.16: its loops are
// counted, and the ranges left to sort are on a stack, not recursion: it
// does not have the effect diverge.)
pub fn sort<T: Ord>(s: [T]) {
    let mut depth = 0;
    for k in 0..64 {
        if (s.len >> k) <= 1 {
            break;
        }
        depth += 2;
    }
    quicksort::<T>(s, 0, s.len, depth);
}

// Short runs are sorted by insertion.
const SORT_SMALL: i64 = 24;

// Sorts s[lo..hi]; below `depth` more partitions, by heapsort. Each
// partition puts its pivot in place, sorts the shorter side next and
// keeps the longer for later (at most 64 kept: each is at least twice as
// long as the one sorted next).
// (not inlined into sort's caller: its loops keep their registers)
#[inline(never)]
fn quicksort<T: Ord>(s: [T], lo: i64, hi: i64, depth: i64) {
    let mut lo = lo;
    let mut hi = hi;
    let mut depth = depth;
    let mut kept_lo: [i64; 64] = [0; 64];
    let mut kept_hi: [i64; 64] = [0; 64];
    let mut kept_depth: [i64; 64] = [0; 64];
    let mut kept = 0;
    // (each round places a pivot or finishes a range: 2n + 1 at most)
    for _ in 0..2 * (hi - lo) + 1 {
        if hi - lo <= SORT_SMALL || depth == 0 {
            if hi - lo <= SORT_SMALL {
                insertion_sort::<T>(s, lo, hi);
            } else {
                heapsort::<T>(s[lo..hi]);
            }
            if kept == 0 {
                return;
            }
            kept -= 1;
            lo = kept_lo[kept];
            hi = kept_hi[kept];
            depth = kept_depth[kept];
            continue;
        }
        depth -= 1;
        // The median of the first, middle and last elements, at lo.
        let mid = lo + (hi - lo) / 2;
        if s[mid] < s[lo] {
            swap::<T>(s, mid, lo);
        }
        if s[hi - 1] < s[mid] {
            swap::<T>(s, hi - 1, mid);
            if s[mid] < s[lo] {
                swap::<T>(s, mid, lo);
            }
        }
        swap::<T>(s, lo, mid);
        // Hoare's partition: s[lo..p] <= pivot <= s[p + 1..hi]. Equal
        // elements stop both scans, so many equal keys split evenly.
        let pivot = s[lo];
        let mut i = lo;
        let mut j = hi;
        // (the scans read s unchecked: i < hi and lo < j <= hi - 1 by their
        // counts, and hi <= s.len)
        for _ in lo..hi {
            i += 1;
            for _ in i..hi {
                if !(unsafe { s.ptr[i] } < pivot) {
                    break;
                }
                i += 1;
            }
            j -= 1;
            for _ in lo..j {
                if !(pivot < unsafe { s.ptr[j] }) {
                    break;
                }
                j -= 1;
            }
            if i >= j {
                break;
            }
            swap::<T>(s, i, j);
        }
        swap::<T>(s, lo, j);
        // The shorter side next, the longer kept.
        if kept == 64 {
            // (not reached: see above)
            heapsort::<T>(s[lo..hi]);
            hi = lo;
            continue;
        }
        kept_depth[kept] = depth;
        if j - lo < hi - j - 1 {
            kept_lo[kept] = j + 1;
            kept_hi[kept] = hi;
            hi = j;
        } else {
            kept_lo[kept] = lo;
            kept_hi[kept] = j;
            lo = j + 1;
        }
        kept += 1;
    }
}

fn insertion_sort<T: Ord>(s: [T], lo: i64, hi: i64) {
    for i in lo + 1..hi {
        let x = s[i];
        let mut at = lo;
        for d in 0..i - lo {
            let j = i - d;
            if !(x < s[j - 1]) {
                at = j;
                break;
            }
            s[j] = s[j - 1];
        }
        s[at] = x;
    }
}

fn swap<T>(s: [T], i: i64, j: i64) {
    let t = s[i];
    s[i] = s[j];
    s[j] = t;
}

fn heapsort<T: Ord>(s: [T]) {
    let n = s.len;
    for k in 0..n / 2 {
        sift_down::<T>(s, n / 2 - 1 - k, n);
    }
    for k in 1..n {
        let end = n - k;
        let top = s[0];
        s[0] = s[end];
        s[end] = top;
        sift_down::<T>(s, 0, end);
    }
}

// (the root's index at least doubles each round: 64 at most)
fn sift_down<T: Ord>(s: [T], start: i64, end: i64) {
    let mut root = start;
    for _ in 0..64 {
        let mut child = 2 * root + 1;
        if child >= end {
            return;
        }
        if child + 1 < end && s[child] < s[child + 1] {
            child += 1;
        }
        if !(s[root] < s[child]) {
            return;
        }
        let t = s[root];
        s[root] = s[child];
        s[child] = t;
        root = child;
    }
}

// ---- Stable sort (0.15) ----

// Sorts s in place, smallest first, keeping equal elements in the order
// they had (0.15), with a buffer from allocator a (0.16):
// `sort_stable_by_in` with `|a, b| a.cmp(b)`.
pub fn sort_stable_in<T: Ord, A: Allocator>(s: [T], a: A) {
    sort_stable_by_in(s, |x: *T, y: *T| x.cmp(y), a);
}

#[ambient("sort_stable_in(s, gpa)")]
pub fn sort_stable<T: Ord>(s: [T]) {
    sort_stable_in(s, Gpa::ambient());
}

#[ambient("sort_stable_by_in(s, f, gpa)")]
pub fn sort_stable_by<T, F: FnMut(*T, *T) -> i64>(s: [T], f: F) {
    sort_stable_by_in(s, f, Gpa::ambient());
}

// The runs sort_stable_by sorts by insertion before merging them.
const STABLE_RUN: i64 = 16;

// Sorts s in place by f (as sort_by: f(a, b) negative when *a goes before
// *b), keeping equal elements in the order they had (0.15). A merge sort:
// runs of 16 sorted by insertion, then merged in pairs through a buffer of
// s.len elements from allocator a (0.16), so O(n log n) comparisons. A
// `f` that is not a total order leaves s in some order, never out of
// bounds.
pub fn sort_stable_by_in<T, F: FnMut(*T, *T) -> i64, A: Allocator>(s: [T], f: F, a: A) {
    let mut g = f;
    let n = s.len;
    for r in 0..(n + STABLE_RUN - 1) / STABLE_RUN {
        let lo = r * STABLE_RUN;
        let hi = if lo + STABLE_RUN < n { lo + STABLE_RUN } else { n };
        for i in lo + 1..hi {
            let x = s[i];
            let mut j = i;
            for _ in lo..i {
                if !(g(&x, &s[j - 1]) < 0) {
                    break;
                }
                s[j] = s[j - 1];
                j -= 1;
            }
            s[j] = x;
        }
    }
    if n <= STABLE_RUN {
        return;
    }
    let mut buf: Vec<T, A> = Vec::with_capacity_in(n, a);
    // (every element of `to` is written before it is read)
    let mut from = s;
    let mut to = unsafe { buf.ptr[0..n] };
    let mut width = STABLE_RUN;
    // (the width doubles each round: 62 at most)
    for _ in 0..62 {
        if width >= n {
            break;
        }
        for p in 0..(n + 2 * width - 1) / (2 * width) {
            let lo = p * 2 * width;
            let mid = if lo + width < n { lo + width } else { n };
            let hi = if mid + width < n { mid + width } else { n };
            let mut i = lo;
            let mut j = mid;
            let mut k = lo;
            for _ in lo..hi {
                if i >= mid || j >= hi {
                    break;
                }
                // (the left run's element first when they are equal)
                if g(&from[j], &from[i]) < 0 {
                    to[k] = from[j];
                    j += 1;
                } else {
                    to[k] = from[i];
                    i += 1;
                }
                k += 1;
            }
            for ii in i..mid {
                to[k] = from[ii];
                k += 1;
            }
            for jj in j..hi {
                to[k] = from[jj];
                k += 1;
            }
        }
        let t = from;
        from = to;
        to = t;
        width *= 2;
    }
    if from.ptr != s.ptr {
        for i in 0..n {
            s[i] = from[i];
        }
    }
    buf.free();
}

// ---- HashMap ----

// A hash table (open addressing, linear probing) from K to V. Slots are
// numbered 0..slots(); `key_at(i)` and `value_at(i)` give an occupied
// slot's entry (None for a free one), which is how the map is iterated.
#[sealed]
pub struct HashMap<K: Hash + Eq, V, A: Allocator = Gpa> {
    keys: *K, values: *V, states: *u8, cap: i64, len: i64, used: i64, alloc: A,
}

// Slot states.
const SLOT_FREE: u8 = 0;
const SLOT_FULL: u8 = 1;
const SLOT_GONE: u8 = 2;

impl<K: Hash + Eq, V, A: Allocator> HashMap<K, V, A> {
    // An empty map on allocator a (0.16).
    pub fn new_in(a: A) -> HashMap<K, V, A> {
        HashMap {
            keys: 0 as *K, values: 0 as *V, states: 0 as *u8, cap: 0, len: 0, used: 0, alloc: a
        }
    }

    pub fn len(self: *HashMap<K, V, A>) -> i64 {
        self.len
    }

    pub fn is_empty(self: *HashMap<K, V, A>) -> bool {
        self.len == 0
    }

    // The slot holding `key`, or -1.
    fn slot_of(self: *HashMap<K, V, A>, key: *K) -> i64 {
        if self.cap == 0 {
            return -1;
        }
        let mask = self.cap - 1;
        let mut i = (key.hash() & mask as u64) as i64;
        // (a quarter of the slots at least are free: one ends the search)
        for _ in 0..self.cap {
            let state = unsafe { self.states[i] };
            if state == SLOT_FREE {
                return -1;
            }
            if state == SLOT_FULL && unsafe { self.keys[i] } == *key {
                return i;
            }
            i = (i + 1) & mask;
        }
        -1
    }

    pub fn contains(self: *HashMap<K, V, A>, key: K) -> bool {
        self.slot_of(&key) >= 0
    }

    // The same as `contains` (Rust's name).
    pub fn contains_key(self: *HashMap<K, V, A>, key: K) -> bool {
        self.slot_of(&key) >= 0
    }

    // A copy of the value of `key`, if it has one (`get_mut` changes it).
    pub fn get(self: *HashMap<K, V, A>, key: K) -> Option<V> {
        let i = self.slot_of(&key);
        if i < 0 { Option::None } else { Option::Some(unsafe { self.values[i] }) }
    }

    // The value of `key` in place, as a view of one element, if it has
    // one: `if let Some(a) = m.get_mut(k) { a[0].balance += 10; }`. The
    // view is valid until the map's next insert, remove or free (like a
    // Vec's `as_slice()`).
    pub fn get_mut(self: *HashMap<K, V, A>, key: K) -> Option<[V]> {
        let i = self.slot_of(&key);
        if i < 0 { Option::None } else { Option::Some(unsafe { self.values[i..i + 1] }) }
    }

    // The value of `key` in place (a view of one element, as `get_mut`),
    // inserted as `default` first if the key has none; Rust's
    // `entry(k).or_insert(d)`. Counting: `counts.get_or_insert(w, 0)[0] += 1;`.
    pub fn get_or_insert(self: *HashMap<K, V, A>, key: K, default: V) -> [V] {
        let mut i = self.slot_of(&key);
        if i < 0 {
            i = self.insert_new(key, default);
        }
        unsafe { self.values[i..i + 1] }
    }

    // Sets the value of `key`; returns its old value, if it had one.
    pub fn insert(self: *HashMap<K, V, A>, key: K, value: V) -> Option<V> {
        let i = self.slot_of(&key);
        if i >= 0 {
            let old = unsafe { self.values[i] };
            unsafe {
                self.values[i] = value;
            }
            return Option::Some(old);
        }
        self.insert_new(key, value);
        Option::None
    }

    // Adds `key`, which the map does not have; returns its slot.
    fn insert_new(self: *HashMap<K, V, A>, key: K, value: V) -> i64 {
        if (self.used + 1) * 4 > self.cap * 3 {
            self.rehash();
        }
        let mask = self.cap - 1;
        let mut j = (key.hash() & mask as u64) as i64;
        for _ in 0..self.cap {
            if unsafe { self.states[j] } != SLOT_FULL {
                break;
            }
            j = (j + 1) & mask;
        }
        unsafe {
            if self.states[j] == SLOT_FREE {
                self.used += 1;
            }
            self.states[j] = SLOT_FULL;
            self.keys[j] = key;
            self.values[j] = value;
        }
        self.len += 1;
        j
    }

    // Removes `key`; returns its value, if it had one.
    pub fn remove(self: *HashMap<K, V, A>, key: K) -> Option<V> {
        let i = self.slot_of(&key);
        if i < 0 {
            return Option::None;
        }
        self.len -= 1;
        unsafe {
            self.states[i] = SLOT_GONE;
            Option::Some(self.values[i])
        }
    }

    pub fn slots(self: *HashMap<K, V, A>) -> i64 {
        self.cap
    }

    pub fn key_at(self: *HashMap<K, V, A>, i: i64) -> Option<K> {
        if i < 0 || i >= self.cap || unsafe { self.states[i] } != SLOT_FULL {
            return Option::None;
        }
        Option::Some(unsafe { self.keys[i] })
    }

    pub fn value_at(self: *HashMap<K, V, A>, i: i64) -> Option<V> {
        if i < 0 || i >= self.cap || unsafe { self.states[i] } != SLOT_FULL {
            return Option::None;
        }
        Option::Some(unsafe { self.values[i] })
    }

    // Twice the room (at least 8 slots), the entries moved over and the
    // removed ones dropped.
    fn rehash(self: *HashMap<K, V, A>) {
        self.rehash_to(if self.cap == 0 { 8 } else { self.cap * 2 });
    }

    // The entries moved to `cap` slots (a power of two, more than 4/3 of
    // len), the removed ones dropped.
    fn rehash_to(self: *HashMap<K, V, A>, cap: i64) {
        let old_cap = self.cap;
        let old_keys = self.keys;
        let old_values = self.values;
        let old_states = self.states;
        let key_bytes = alloc_bytes(cap, size_of(K));
        let value_bytes = alloc_bytes(cap, size_of(V));
        if key_bytes < 0 || value_bytes < 0 || cap > ALLOC_LIMIT {
            out_of_memory();
        }
        unsafe {
            self.keys = self.alloc.try_alloc(key_bytes, align_of(K)) as *K;
            self.values = self.alloc.try_alloc(value_bytes, align_of(V)) as *V;
            self.states = self.alloc.try_alloc(cap, 1);
            if self.keys == 0 as *K || self.values == 0 as *V || self.states == 0 as *u8 {
                out_of_memory();
            }
            for i in 0..cap {
                self.states[i] = SLOT_FREE;
            }
        }
        self.cap = cap;
        self.used = self.len;
        let mask = cap - 1;
        for i in 0..old_cap {
            if unsafe { old_states[i] } != SLOT_FULL {
                continue;
            }
            let key = unsafe { old_keys[i] };
            let mut j = (key.hash() & mask as u64) as i64;
            unsafe {
                for _ in 0..cap {
                    if self.states[j] != SLOT_FULL {
                        break;
                    }
                    j = (j + 1) & mask;
                }
                self.states[j] = SLOT_FULL;
                self.keys[j] = key;
                self.values[j] = old_values[i];
            }
        }
        if old_cap > 0 {
            unsafe {
                self.alloc.free(old_keys as *u8, old_cap * size_of(K), align_of(K));
                self.alloc.free(old_values as *u8, old_cap * size_of(V), align_of(V));
                self.alloc.free(old_states, old_cap, 1);
            }
        }
    }

    pub fn free(self: *HashMap<K, V, A>) {
        if self.cap > 0 {
            unsafe {
                self.alloc.free(self.keys as *u8, self.cap * size_of(K), align_of(K));
                self.alloc.free(self.values as *u8, self.cap * size_of(V), align_of(V));
                self.alloc.free(self.states, self.cap, 1);
            }
        }
        self.cap = 0;
        self.len = 0;
        self.used = 0;
    }
}

impl<K: Hash + Eq, V, A: Allocator + Ambient> HashMap<K, V, A> {
    #[ambient("HashMap::new_in(gpa)")]
    pub fn new() -> HashMap<K, V, A> {
        HashMap::new_in(A::ambient())
    }
}

// ---- HashMap's room (0.16) ----

impl<K: Hash + Eq, V, A: Allocator> HashMap<K, V, A> {
    // Its allocator (0.16): a copy of the handle.
    pub fn allocator(self: *HashMap<K, V, A>) -> A {
        self.alloc
    }

    // An empty map on allocator a with room for n entries (0.16).
    pub fn with_capacity_in(n: i64, a: A) -> HashMap<K, V, A> {
        let mut m: HashMap<K, V, A> = HashMap::new_in(a);
        if n > 0 {
            if n > ALLOC_LIMIT / 8 {
                out_of_memory();
            }
            // (slots: a power of two, 8 at least, n at most 3/4 of them)
            let mut cap = 8;
            for _ in 0..62 {
                if n * 4 <= cap * 3 {
                    break;
                }
                cap *= 2;
            }
            m.rehash_to(cap);
        }
        m
    }
}
