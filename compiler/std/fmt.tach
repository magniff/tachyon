// ---- Printing and formatting ----
//
// compiler/std/embed.sh appends this file to std.tach (its printing was
// split from it): the same module, `std`. Printing; the traits Display
// (`{x}`, print) and Debug (`{x:?}`), the formatter Fmt they write to, and
// Interp, the value of an f-string (docs/design/errors-formatting.md).
//
// The functions of Display and Debug impls and Fmt's are #[inline]: std's
// #[inline] functions are checked and emitted only where they are used.

// ---- Printing ----

pub fn print(s: [u8]) {
    unsafe {
        write(1, s.ptr, s.len as u64);
    }
}

pub fn println(s: [u8]) {
    print(s);
    print("\n");
}

pub fn print_int(v: i64) {
    let mut b = Buf::new();
    b.push_int(v);
    print(b.as_slice());
    b.free();
}

// A C string (up to its NUL).
pub unsafe fn print_cstr(s: *u8) {
    let mut b = Buf::new();
    b.push_cstr(s);
    print(b.as_slice());
    b.free();
}

// ---- Display, Debug and Fmt (0.15) ----

// `{x}` in an f-string.
pub trait Display { fn fmt(self: *Self, f: *Fmt); }

// `{x:?}`: as the code that makes it.
pub trait Debug { fn fmt_debug(self: *Self, f: *Fmt); }

// A spec's flags (front/ast.tach's FMT_*): `<`, `>`, `0`, `x`, `X`, `b`, `c`.
const FMT_LEFT: i64 = 1;
const FMT_RIGHT: i64 = 2;
const FMT_ZERO: i64 = 4;
const FMT_HEX: i64 = 8;
const FMT_UPPER: i64 = 16;
const FMT_BIN: i64 = 32;
const FMT_CHAR: i64 = 64;

// What Display and Debug write to: `buf`, or `fd` when `buf` is null.
pub struct Fmt { buf: *Buf, fd: i32, width: i64, prec: i64, flags: i64, mark: i64 }

impl Fmt {
    #[inline]
    pub fn to_fd(fd: i32) -> Fmt {
        Fmt { buf: 0 as *Buf, fd: fd, width: -1, prec: -1, flags: 0, mark: 0 }
    }

    #[inline]
    pub fn to_buf(buf: *Buf) -> Fmt {
        Fmt { buf: buf, fd: -1, width: -1, prec: -1, flags: 0, mark: 0 }
    }

    #[inline]
    pub fn str(self: *Fmt, s: [u8]) {
        if self.fd >= 0 {
            unsafe {
                write(self.fd, s.ptr, s.len as u64);
            }
        } else {
            unsafe {
                (*self.buf).push_str(s);
            }
        }
    }

    #[inline]
    pub fn byte(self: *Fmt, b: u8) {
        let one: [u8; 1] = [b];
        self.str(one[0..1]);
    }

    // (nothing is buffered yet: a Fmt to a file descriptor writes at once)
    #[inline]
    pub fn flush(self: *Fmt) {
    }

    #[inline]
    pub fn display<T: Display>(self: *Fmt, x: *T) {
        x.fmt(self);
    }

    #[inline]
    pub fn debug<T: Debug>(self: *Fmt, x: *T) {
        x.fmt_debug(self);
    }
}

// v in decimal.
#[inline]
fn fmt_int(f: *Fmt, v: i64) {
    let mut digits: [u8; 20] = [0; 20];
    let mut n = 20;
    let mut u = if v < 0 { (-(v + 1)) as u64 + 1 } else { v as u64 };
    loop {
        n -= 1;
        digits[n] = '0' + (u % 10) as u8;
        u = u / 10;
        if u == 0 {
            break;
        }
    }
    if v < 0 {
        f.byte('-');
    }
    f.str(digits[n..20]);
}

// An f-string's value.
pub struct Interp<F> { f: F }

impl<F: Fn(*Fmt)> Display for Interp<F> {
    fn fmt(self: *Interp<F>, out: *Fmt) {
        (self.f)(out);
    }
}

impl Display for i64 {
    #[inline]
    fn fmt(self: *i64, f: *Fmt) { fmt_int(f, *self); }
}

impl Debug for i64 {
    #[inline]
    fn fmt_debug(self: *i64, f: *Fmt) { fmt_int(f, *self); }
}

impl Display for [u8] {
    #[inline]
    fn fmt(self: *[u8], f: *Fmt) { f.str(*self); }
}

// (quoted; the escapes are to come)
impl Debug for [u8] {
    #[inline]
    fn fmt_debug(self: *[u8], f: *Fmt) {
        f.byte('"');
        f.str(*self);
        f.byte('"');
    }
}
