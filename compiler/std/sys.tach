// A terminal's size (struct winsize, the same on both systems).
#[repr(C)]
#[derive(Eq, Debug)]
pub struct SysWinsize {
    ws_row: u16,
    ws_col: u16,
    ws_xpixel: u16,
    ws_ypixel: u16,
}

// struct termios, opaque: room for either system's (72 bytes on macOS, 60
// on Linux); sys_make_raw is the one change std makes to it.
pub struct SysTermios {
    words: [u64; 16],
}

// struct pollfd (the same on both systems).
#[repr(C)]
#[derive(Eq, Debug)]
pub struct SysPollFd {
    fd: i32,
    events: i16,
    revents: i16,
}

pub const SYS_POLLIN: i16 = 1;
pub const SYS_POLLPRI: i16 = 2;
pub const SYS_POLLOUT: i16 = 4;
pub const SYS_POLLERR: i16 = 8;
pub const SYS_POLLHUP: i16 = 16;
pub const SYS_POLLNVAL: i16 = 32;

// A new pseudo-terminal of the given size: (its controller, the terminal),
// both close-on-exec. The controller is the program's end (what it reads
// is the child's output); the terminal becomes the child's stdin, stdout
// and stderr (sys_fork_exec_pty), and the caller closes its copy then.
pub fn sys_openpty(size: SysWinsize) -> Result<(i32, i32), i32> {
    let m = sys_check(unsafe { sys_c_posix_openpt(SYS_O_RDWR | SYS_O_NOCTTY) } as i64)? as i32;
    match sys_openpty_side(m, size) {
        Ok(s) => Ok((m, s)),
        Err(e) => {
            unsafe { sys_c_close(m); }
            Err(e)
        }
    }
}

fn sys_openpty_side(m: i32, size: SysWinsize) -> Result<i32, i32> {
    sys_set_cloexec(m, true)?;
    sys_check_unit(unsafe { sys_c_grantpt(m) })?;
    sys_check_unit(unsafe { sys_c_unlockpt(m) })?;
    // (ptsname: the terminal's path, a NUL-ended string valid until the
    // next call; copied at once)
    let name = unsafe { sys_cstr_view(sys_c_ptsname(m)) };
    if name.len == 0 {
        return Err(sys_errno());
    }
    let s = sys_open(name, SYS_O_RDWR | SYS_O_NOCTTY, 0)?;
    match sys_set_winsize(m, size) {
        Ok(()) => Ok(s),
        Err(e) => {
            unsafe { sys_c_close(s); }
            Err(e)
        }
    }
}

// Starts path (a full path: no PATH lookup) with argv and envp (C strings
// ending with a null pointer, built before the call) in a new session
// whose controlling terminal is tty, the terminal end of sys_openpty, as
// its stdin, stdout and stderr: the child's pid. Between fork and execve
// the child calls only async-signal-safe functions (setsid, ioctl, dup2,
// close, execve, _exit) and allocates nothing; when execve fails it exits
// with 127.
// Unsafe: path and every pointer before argv's and envp's nulls must be
// NUL-ended strings.
pub unsafe fn sys_fork_exec_pty(tty: i32, path: *u8, argv: [*u8], envp: [*u8]) -> Result<i32, i32> {
    if argv.len == 0 || argv[argv.len - 1] != 0 as *u8 {
        return Err(SYS_EINVAL);
    }
    if envp.len == 0 || envp[envp.len - 1] != 0 as *u8 {
        return Err(SYS_EINVAL);
    }
    let av = argv.ptr;
    let ev = envp.ptr;
    let pid = sys_c_fork();
    if pid == -1 {
        return Err(sys_errno());
    }
    if pid == 0 {
        // The child.
        sys_c_setsid();
        sys_c_ioctl(tty, SYS_TIOCSCTTY, 0);
        sys_c_dup2(tty, 0);
        sys_c_dup2(tty, 1);
        sys_c_dup2(tty, 2);
        if tty > 2 {
            sys_c_close(tty);
        }
        sys_c_execve(path, av, ev);
        sys_c_exit_now(127);
    }
    Ok(pid)
}

// Sets the size of the terminal fd (TIOCSWINSZ; on a controller, the
// child gets SIGWINCH).
pub fn sys_set_winsize(fd: i32, size: SysWinsize) -> Result<(), i32> {
    let ws = size;
    // (ioctl reads one struct winsize)
    sys_check_unit(unsafe { sys_c_ioctl(fd, SYS_TIOCSWINSZ, &ws as *u8) })
}

// The size of the terminal fd (TIOCGWINSZ).
pub fn sys_get_winsize(fd: i32) -> Result<SysWinsize, i32> {
    var ws = SysWinsize { ws_row: 0, ws_col: 0, ws_xpixel: 0, ws_ypixel: 0 };
    // (ioctl writes one struct winsize)
    sys_check_unit(unsafe { sys_c_ioctl(fd, SYS_TIOCGWINSZ, &ws as *u8) })?;
    Ok(ws)
}

// The terminal fd's settings.
pub fn sys_tcgetattr(fd: i32) -> Result<SysTermios, i32> {
    var t = SysTermios { words: [0u64; 16] };
    // (128 bytes: more than either system's struct termios)
    sys_check_unit(unsafe { sys_c_tcgetattr(fd, &t.words as *u8) })?;
    Ok(t)
}

// Sets the terminal fd's settings, now (TCSANOW).
pub fn sys_tcsetattr(fd: i32, t: SysTermios) -> Result<(), i32> {
    // (as sys_tcgetattr)
    sys_check_unit(unsafe { sys_c_tcsetattr(fd, 0, &t.words as *u8) })
}

// Raw mode (cfmakeraw): no echo, no line editing, no signals from keys, no
// output processing, 8-bit characters.
pub fn sys_make_raw(t: inout SysTermios) {
    // (as sys_tcgetattr)
    unsafe { sys_c_cfmakeraw(&t.words as *u8); }
}

// Waits until one of fds is ready or timeout_ms passes (-1: no limit):
// how many have revents set.
pub fn sys_poll(fds: [SysPollFd], timeout_ms: i32) -> Result<i64, i32> {
    // (poll reads and writes fds.len structs at fds.ptr)
    sys_check(unsafe { sys_c_poll(fds.ptr, fds.len as u64, timeout_ms) } as i64)
}

// ---- Sys: clocks and entropy (0.20) ----

extern "C" {
    #[link_name = "clock_gettime"]
    #[effects(io)]
    fn sys_c_clock_gettime(clock: i32, ts: *SysTimespec) -> i32;
    #[link_name = "nanosleep"]
    #[effects(io)]
    fn sys_c_nanosleep(req: *SysTimespec, rem: *SysTimespec) -> i32;
    #[link_name = "getentropy"]
    #[effects(io)]
    fn sys_c_getentropy(buf: *u8, n: u64) -> i32;
}

// struct timespec (the same on both systems).
#[repr(C)]
#[derive(Eq, Debug)]
pub struct SysTimespec {
    tv_sec: i64,
    tv_nsec: i64,
}

pub const SYS_CLOCK_REALTIME: i32 = 0;

// The time of clock (SYS_CLOCK_REALTIME, SYS_CLOCK_MONOTONIC): (seconds,
// nanoseconds).
pub fn sys_clock_gettime(clock: i32) -> (i64, i64) {
    var ts = SysTimespec { tv_sec: 0, tv_nsec: 0 };
    // (clock_gettime writes one struct timespec; it fails only for a clock
    // the system does not have, which reads as 0)
    unsafe { sys_c_clock_gettime(clock, &ts); }
    (ts.tv_sec, ts.tv_nsec)
}

// Sleeps for secs seconds and nanos nanoseconds (nanos < 10^9); when a
// signal interrupts it, Err(EINTR) with the time left in *left.
pub fn sys_nanosleep(secs: i64, nanos: i64, left: inout SysTimespec) -> Result<(), i32> {
    let req = SysTimespec { tv_sec: secs, tv_nsec: nanos };
    // (nanosleep reads req and writes *left, a borrowed struct timespec)
    sys_check_unit(unsafe { sys_c_nanosleep(&req, &left) })
}

// Fills buf with random bytes from the system (getentropy, 256 at a time).
pub fn sys_getentropy(buf: inout [u8]) -> Result<(), i32> {
    var at = 0;
    for _ in 0..(buf.len + 255) / 256 {
        let n = if buf.len - at < 256 { buf.len - at } else { 256 };
        // (n bytes from buf.ptr + at, within buf)
        let r = unsafe { sys_c_getentropy(buf[at..at + n].ptr, n as u64) };
        if r != 0 {
            return Err(sys_errno());
        }
        at += n;
    }
    Ok(())
}
