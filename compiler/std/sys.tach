    #[link_name = "posix_spawn_file_actions_adddup2"]
    #[effects(io)]
    fn sys_c_actions_adddup2(a: *u8, fd: i32, to: i32) -> i32;
    #[link_name = "posix_spawn_file_actions_addclose"]
    #[effects(io)]
