// std::sys: the OS layer, thin bindings of the C library (0.20).

// (what differs between the targets: std's tail, sys/macos.tach or sys/linux.tach)
use std::{Option, Result, panic_str, sys_errno_location};
pub use std::{
    SYS_CLOCK_MONOTONIC, SYS_EAGAIN, SYS_ELOOP, SYS_ENAMETOOLONG, SYS_ENOSYS, SYS_ENOTEMPTY,
    SYS_ENOTSUP, SYS_ETIMEDOUT, SYS_O_APPEND, SYS_O_CLOEXEC, SYS_O_CREAT, SYS_O_DIRECTORY,
    SYS_O_EXCL, SYS_O_NOCTTY, SYS_O_NONBLOCK, SYS_O_TRUNC, SYS_PATH_MAX, SYS_SIGCHLD,
    SYS_TIOCGWINSZ, SYS_TIOCSCTTY, SYS_TIOCSWINSZ, TARGET_OS,
};

// ---- Sys: errors (0.20) ----

// The OS layer (0.20, docs/design/collections-text-io.md §2.6.1, task A7):
// thin bindings of the C library, the same on macOS and Linux; what differs
// between them (flag and errno values, errno's address) is in the target's
// tail, sys/macos.tach or sys/linux.tach, and a struct whose layout differs
// is declared once per system (`StatMacos`, `StatLinux`) and chosen by
// `TARGET_OS`, a constant. Every call's result is a `Result<T, i32>`: the
// value, or the errno it failed with (`sys_errno_kind` names it). Nothing
// here retries on EINTR or allocates; paths reach C through a NUL-ended copy
// in a stack buffer (`sys_cpath`): a path with a NUL in it, or longer than
// the system's PATH_MAX, fails with EINVAL or ENAMETOOLONG before any call.
// Every descriptor std opens (`sys_open`, `sys_pipe`, `sys_openpty`) is
// close-on-exec, so that a spawned program gets only what it is given.
// (Until std is a module tree these are `sys_` names in `std`; 0.20's
// std::sys drops the prefix, and std::io, fs, process and os::unix are
// built on them.)
//
// Unsafe code: each binding passes C a pointer and a length from a slice it
// was given, or a pointer to a local or a borrowed struct of the size C
// writes (the layouts are checked against the headers by tests/run/
// sys_layout.tach); a slice made from a C string (`sys_cstr_view`) is valid
// while that string is.

extern "C" {
    #[link_name = "strerror"]
    #[effects(global)]
    fn sys_c_strerror(e: i32) -> *u8;
    #[link_name = "strlen"]
    #[effects()]
    fn sys_c_strlen(s: *u8) -> u64;
}

pub const SYS_EPERM: i32 = 1;
pub const SYS_ENOENT: i32 = 2;
pub const SYS_ESRCH: i32 = 3;
pub const SYS_EINTR: i32 = 4;
pub const SYS_EIO: i32 = 5;
pub const SYS_EBADF: i32 = 9;
pub const SYS_ECHILD: i32 = 10;
pub const SYS_ENOMEM: i32 = 12;
pub const SYS_EACCES: i32 = 13;
pub const SYS_EEXIST: i32 = 17;
pub const SYS_EXDEV: i32 = 18;
pub const SYS_ENOTDIR: i32 = 20;
pub const SYS_EISDIR: i32 = 21;
pub const SYS_EINVAL: i32 = 22;
pub const SYS_ENOSPC: i32 = 28;
pub const SYS_EROFS: i32 = 30;
pub const SYS_EPIPE: i32 = 32;

// The kinds of io::Error (§2.6.2) an errno falls into (0.20's
// io::ErrorKind takes these variants).
#[derive(Eq, Debug)]
pub enum SysErrorKind {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    WouldBlock,
    InvalidInput,
    InvalidData,
    TimedOut,
    WriteZero,
    Interrupted,
    UnexpectedEof,
    BrokenPipe,
    NotADirectory,
    IsADirectory,
    DirectoryNotEmpty,
    Unsupported,
    OutOfMemory,
    Other,
}

// The errno of the last C call that failed (C's `errno`).
pub fn sys_errno() -> i32 {
    // (sys_errno_location points to this thread's errno: always valid)
    unsafe { *sys_errno_location() }
}

// Sets errno (to 0 before a call whose only failure report is errno).
pub fn sys_set_errno(e: i32) {
    // (as sys_errno)
    unsafe { *sys_errno_location() = e; }
}

// The kind of error errno e is, as Rust's std decodes it.
pub fn sys_errno_kind(e: i32) -> SysErrorKind {
    if e == SYS_ENOENT {
        SysErrorKind::NotFound
    } else if e == SYS_EPERM || e == SYS_EACCES {
        SysErrorKind::PermissionDenied
    } else if e == SYS_EEXIST {
        SysErrorKind::AlreadyExists
    } else if e == SYS_EAGAIN {
        SysErrorKind::WouldBlock
    } else if e == SYS_EINVAL || e == SYS_ENAMETOOLONG {
        SysErrorKind::InvalidInput
    } else if e == SYS_ETIMEDOUT {
        SysErrorKind::TimedOut
    } else if e == SYS_EINTR {
        SysErrorKind::Interrupted
    } else if e == SYS_EPIPE {
        SysErrorKind::BrokenPipe
    } else if e == SYS_ENOTDIR {
        SysErrorKind::NotADirectory
    } else if e == SYS_EISDIR {
        SysErrorKind::IsADirectory
    } else if e == SYS_ENOTEMPTY {
        SysErrorKind::DirectoryNotEmpty
    } else if e == SYS_ENOSYS || e == SYS_ENOTSUP {
        SysErrorKind::Unsupported
    } else if e == SYS_ENOMEM {
        SysErrorKind::OutOfMemory
    } else {
        SysErrorKind::Other
    }
}

// C's message for errno e (`strerror`) copied into out, cut to its length:
// the bytes written.
pub fn sys_strerror_into(e: i32, out: inout [u8]) -> i64 {
    // (strerror's result is a NUL-ended string, valid until the next call)
    let msg = unsafe { sys_cstr_view(sys_c_strerror(e)) };
    let n = if msg.len < out.len { msg.len } else { out.len };
    for i in 0..n {
        out[i] = msg[i];
    }
    n
}

// The bytes of the NUL-ended C string at p, without the NUL; empty for a
// null p. The caller promises that p is null or a NUL-ended string, valid
// while the slice is used.
pub unsafe fn sys_cstr_view(p: *u8) -> [u8] {
    if p == 0 as *u8 {
        return ""[0..0];
    }
    p[0..sys_c_strlen(p) as i64]
}

// The result of a C call returning -1 on failure, as a Result.
fn sys_check(r: i64) -> Result<i64, i32> {
    if r == -1 {
        Err(sys_errno())
    } else {
        Ok(r)
    }
}

fn sys_check_unit(r: i32) -> Result<(), i32> {
    if r == -1 {
        Err(sys_errno())
    } else {
        Ok(())
    }
}

// ---- Sys: paths (0.20) ----

// A path for C: the bytes and a NUL, in a buffer on the caller's stack.
pub struct SysPath {
    buf: [u8; 4096],
}

// A SysPath holding path and its NUL: ENAMETOOLONG when path does not fit
// the system's PATH_MAX (1024 bytes on macOS, 4096 on Linux, the NUL
// included), EINVAL when it has a NUL in it. Pass `&p.buf as *u8` of the
// local holding it (a `let self` method would see a copy).
pub fn sys_cpath(path: [u8]) -> Result<SysPath, i32> {
    if path.len >= SYS_PATH_MAX {
        return Err(SYS_ENAMETOOLONG);
    }
    var p = SysPath { buf: [0u8; 4096] };
    for i in 0..path.len {
        let b = path[i];
        if b == 0 {
            return Err(SYS_EINVAL);
        }
        p.buf[i] = b;
    }
    Ok(p)
}

impl SysPath {
}

// ---- Sys: files (0.20) ----

extern "C" {
    #[link_name = "open"]
    #[effects(io)]
    fn sys_c_open(path: *u8, flags: i32, ...) -> i32;
    #[link_name = "close"]
    #[effects(io)]
    fn sys_c_close(fd: i32) -> i32;
    #[link_name = "read"]
    #[effects(io)]
    fn sys_c_read(fd: i32, buf: *u8, n: u64) -> i64;
    #[link_name = "write"]
    #[effects(io)]
    fn sys_c_write(fd: i32, buf: *u8, n: u64) -> i64;
    #[link_name = "pread"]
    #[effects(io)]
    fn sys_c_pread(fd: i32, buf: *u8, n: u64, off: i64) -> i64;
    #[link_name = "pwrite"]
    #[effects(io)]
    fn sys_c_pwrite(fd: i32, buf: *u8, n: u64, off: i64) -> i64;
    #[link_name = "lseek"]
    #[effects(io)]
    fn sys_c_lseek(fd: i32, off: i64, whence: i32) -> i64;
    #[link_name = "ftruncate"]
    #[effects(io)]
    fn sys_c_ftruncate(fd: i32, len: i64) -> i32;
    #[link_name = "fsync"]
    #[effects(io)]
    fn sys_c_fsync(fd: i32) -> i32;
    #[link_name = "fstat"]
    #[effects(io)]
    fn sys_c_fstat(fd: i32, st: *u8) -> i32;
    #[link_name = "stat"]
    #[effects(io)]
    fn sys_c_stat(path: *u8, st: *u8) -> i32;
    #[link_name = "lstat"]
    #[effects(io)]
    fn sys_c_lstat(path: *u8, st: *u8) -> i32;
    #[link_name = "mkdir"]
    #[effects(io)]
    fn sys_c_mkdir(path: *u8, mode: u32) -> i32;
    #[link_name = "rmdir"]
    #[effects(io)]
    fn sys_c_rmdir(path: *u8) -> i32;
    #[link_name = "unlink"]
    #[effects(io)]
    fn sys_c_unlink(path: *u8) -> i32;
    #[link_name = "rename"]
    #[effects(io)]
    fn sys_c_rename(from: *u8, to: *u8) -> i32;
    #[link_name = "dup"]
    #[effects(io)]
    fn sys_c_dup(fd: i32) -> i32;
    #[link_name = "dup2"]
    #[effects(io)]
    fn sys_c_dup2(fd: i32, to: i32) -> i32;
    #[link_name = "pipe"]
    #[effects(io)]
    fn sys_c_pipe(fds: *i32) -> i32;
    #[link_name = "fcntl"]
    #[effects(io)]
    fn sys_c_fcntl(fd: i32, cmd: i32, ...) -> i32;
    #[link_name = "isatty"]
    #[effects(io)]
    fn sys_c_isatty(fd: i32) -> i32;
}

pub const SYS_O_RDONLY: i32 = 0;
pub const SYS_O_WRONLY: i32 = 1;
pub const SYS_O_RDWR: i32 = 2;
pub const SYS_SEEK_SET: i32 = 0;
pub const SYS_SEEK_CUR: i32 = 1;
pub const SYS_SEEK_END: i32 = 2;
const SYS_F_GETFD: i32 = 1;
const SYS_F_SETFD: i32 = 2;
const SYS_F_GETFL: i32 = 3;
const SYS_F_SETFL: i32 = 4;
const SYS_FD_CLOEXEC: i32 = 1;

// Opens path with flags (SYS_O_RDONLY, ..., | SYS_O_CREAT, ...) and, when it
// creates the file, the permission bits mode (0x1a4: 0644): the descriptor,
// close-on-exec (SYS_O_CLOEXEC is added).
pub fn sys_open(path: [u8], flags: i32, mode: i32) -> Result<i32, i32> {
    let p = sys_cpath(path)?;
    // (p holds a NUL-ended path; open's third argument is variadic, an int)
    let r = unsafe { sys_c_open(&p.buf as *u8, flags | SYS_O_CLOEXEC, mode) };
    Ok(sys_check(r as i64)? as i32)
}

pub fn sys_close(fd: i32) -> Result<(), i32> {
    sys_check_unit(unsafe { sys_c_close(fd) })
}

// Reads up to buf.len bytes into buf: how many (0 at the end).
pub fn sys_read(fd: i32, buf: inout [u8]) -> Result<i64, i32> {
    // (C writes at most buf.len bytes at buf.ptr)
    sys_check(unsafe { sys_c_read(fd, buf.ptr, buf.len as u64) })
}

// Writes some of buf: how many bytes.
pub fn sys_write(fd: i32, buf: [u8]) -> Result<i64, i32> {
    // (C reads at most buf.len bytes at buf.ptr)
    sys_check(unsafe { sys_c_write(fd, buf.ptr, buf.len as u64) })
}

// Reads into buf from offset off, not moving the file's position.
pub fn sys_pread(fd: i32, buf: inout [u8], off: i64) -> Result<i64, i32> {
    // (as sys_read)
    sys_check(unsafe { sys_c_pread(fd, buf.ptr, buf.len as u64, off) })
}

// Writes buf at offset off, not moving the file's position.
pub fn sys_pwrite(fd: i32, buf: [u8], off: i64) -> Result<i64, i32> {
    // (as sys_write)
    sys_check(unsafe { sys_c_pwrite(fd, buf.ptr, buf.len as u64, off) })
}

// Moves the position to off from SYS_SEEK_SET, _CUR or _END: the new one.
pub fn sys_lseek(fd: i32, off: i64, whence: i32) -> Result<i64, i32> {
    sys_check(unsafe { sys_c_lseek(fd, off, whence) })
}

pub fn sys_ftruncate(fd: i32, len: i64) -> Result<(), i32> {
    sys_check_unit(unsafe { sys_c_ftruncate(fd, len) })
}

pub fn sys_fsync(fd: i32) -> Result<(), i32> {
    sys_check_unit(unsafe { sys_c_fsync(fd) })
}

pub fn sys_mkdir(path: [u8], mode: i32) -> Result<(), i32> {
    let p = sys_cpath(path)?;
    sys_check_unit(unsafe { sys_c_mkdir(&p.buf as *u8, mode as u32) })
}

pub fn sys_rmdir(path: [u8]) -> Result<(), i32> {
    let p = sys_cpath(path)?;
    sys_check_unit(unsafe { sys_c_rmdir(&p.buf as *u8) })
}

pub fn sys_unlink(path: [u8]) -> Result<(), i32> {
    let p = sys_cpath(path)?;
    sys_check_unit(unsafe { sys_c_unlink(&p.buf as *u8) })
}

pub fn sys_rename(from: [u8], to: [u8]) -> Result<(), i32> {
    let a = sys_cpath(from)?;
    let b = sys_cpath(to)?;
    sys_check_unit(unsafe { sys_c_rename(&a.buf as *u8, &b.buf as *u8) })
}

pub fn sys_dup(fd: i32) -> Result<i32, i32> {
    Ok(sys_check(unsafe { sys_c_dup(fd) } as i64)? as i32)
}

// Makes `to` a copy of fd (closing what `to` was); `to` is not
// close-on-exec.
pub fn sys_dup2(fd: i32, to: i32) -> Result<i32, i32> {
    Ok(sys_check(unsafe { sys_c_dup2(fd, to) } as i64)? as i32)
}

// A pipe: (read end, write end), both close-on-exec.
pub fn sys_pipe() -> Result<(i32, i32), i32> {
    var fds: [i32; 2] = [0, 0];
    // (pipe writes two ints)
    sys_check_unit(unsafe { sys_c_pipe(&fds as *i32) })?;
    sys_set_cloexec(fds[0], true)?;
    sys_set_cloexec(fds[1], true)?;
    Ok((fds[0], fds[1]))
}

// Sets or clears O_NONBLOCK on fd.
pub fn sys_set_nonblocking(fd: i32, on: bool) -> Result<(), i32> {
    let fl = sys_check(unsafe { sys_c_fcntl(fd, SYS_F_GETFL) } as i64)? as i32;
    let want = if on { fl | SYS_O_NONBLOCK } else { fl & ~SYS_O_NONBLOCK };
    if want != fl {
        sys_check_unit(unsafe { sys_c_fcntl(fd, SYS_F_SETFL, want) })?;
    }
    Ok(())
}

// Sets or clears FD_CLOEXEC on fd.
pub fn sys_set_cloexec(fd: i32, on: bool) -> Result<(), i32> {
    let fl = sys_check(unsafe { sys_c_fcntl(fd, SYS_F_GETFD) } as i64)? as i32;
    let want = if on { fl | SYS_FD_CLOEXEC } else { fl & ~SYS_FD_CLOEXEC };
    if want != fl {
        sys_check_unit(unsafe { sys_c_fcntl(fd, SYS_F_SETFD, want) })?;
    }
    Ok(())
}

// Whether fd is a terminal.
pub fn sys_isatty(fd: i32) -> bool {
    unsafe { sys_c_isatty(fd) == 1 }
}

// ---- Sys: file status (0.20) ----

// What stat tells of a file, the same on every system.
#[derive(Eq, Debug)]
pub struct FileStat {
    dev: u64,
    ino: u64,
    mode: u32,
    nlink: u64,
    uid: u32,
    gid: u32,
    rdev: u64,
    size: i64,
    blocks: i64,
    blksize: i64,
    atime_sec: i64,
    atime_nsec: i64,
    mtime_sec: i64,
    mtime_nsec: i64,
    ctime_sec: i64,
    ctime_nsec: i64,
}

pub const SYS_S_IFMT: u32 = 0xf000;
pub const SYS_S_IFDIR: u32 = 0x4000;
pub const SYS_S_IFREG: u32 = 0x8000;
pub const SYS_S_IFLNK: u32 = 0xa000;

impl FileStat {
    pub fn is_dir(self) -> bool {
        (self.mode & SYS_S_IFMT) == SYS_S_IFDIR
    }

    pub fn is_file(self) -> bool {
        (self.mode & SYS_S_IFMT) == SYS_S_IFREG
    }

    pub fn is_symlink(self) -> bool {
        (self.mode & SYS_S_IFMT) == SYS_S_IFLNK
    }

    // The permission bits (the low 12 bits of mode).
    pub fn permissions(self) -> u32 {
        self.mode & 0xfff
    }
}

// struct stat on macOS (arm64, 64-bit inodes): 144 bytes.
#[repr(C)]
pub struct StatMacos {
    st_dev: i32,
    st_mode: u16,
    st_nlink: u16,
    st_ino: u64,
    st_uid: u32,
    st_gid: u32,
    st_rdev: i32,
    st_atime: i64,
    st_atime_nsec: i64,
    st_mtime: i64,
    st_mtime_nsec: i64,
    st_ctime: i64,
    st_ctime_nsec: i64,
    st_birthtime: i64,
    st_birthtime_nsec: i64,
    st_size: i64,
    st_blocks: i64,
    st_blksize: i32,
    st_flags: u32,
    st_gen: u32,
    st_lspare: i32,
    st_qspare: [i64; 2],
}

// struct stat on Linux (aarch64, glibc): 128 bytes.
#[repr(C)]
pub struct StatLinux {
    st_dev: u64,
    st_ino: u64,
    st_mode: u32,
    st_nlink: u32,
    st_uid: u32,
    st_gid: u32,
    st_rdev: u64,
    st_pad1: u64,
    st_size: i64,
    st_blksize: i32,
    st_pad2: i32,
    st_blocks: i64,
    st_atime: i64,
    st_atime_nsec: i64,
    st_mtime: i64,
    st_mtime_nsec: i64,
    st_ctime: i64,
    st_ctime_nsec: i64,
    st_unused: [i32; 2],
}

// Room for either system's struct stat.
struct SysStatBuf {
    words: [u64; 20],
}

// The FileStat in b, filled by a stat call of this system.
fn sys_stat_decode(b: *SysStatBuf) -> FileStat {
    if TARGET_OS == 1 {
        // (b holds a struct stat of Linux, 128 of its 160 bytes)
        let s = unsafe { *(&b.words as *StatLinux) };
        FileStat {
            dev: s.st_dev,
            ino: s.st_ino,
            mode: s.st_mode,
            nlink: s.st_nlink as u64,
            uid: s.st_uid,
            gid: s.st_gid,
            rdev: s.st_rdev,
            size: s.st_size,
            blocks: s.st_blocks,
            blksize: s.st_blksize as i64,
            atime_sec: s.st_atime,
            atime_nsec: s.st_atime_nsec,
            mtime_sec: s.st_mtime,
            mtime_nsec: s.st_mtime_nsec,
            ctime_sec: s.st_ctime,
            ctime_nsec: s.st_ctime_nsec,
        }
    } else {
        // (b holds a struct stat of macOS, 144 of its 160 bytes)
        let s = unsafe { *(&b.words as *StatMacos) };
        FileStat {
            dev: s.st_dev as u32 as u64,
            ino: s.st_ino,
            mode: s.st_mode as u32,
            nlink: s.st_nlink as u64,
            uid: s.st_uid,
            gid: s.st_gid,
            rdev: s.st_rdev as u32 as u64,
            size: s.st_size,
            blocks: s.st_blocks,
            blksize: s.st_blksize as i64,
            atime_sec: s.st_atime,
            atime_nsec: s.st_atime_nsec,
            mtime_sec: s.st_mtime,
            mtime_nsec: s.st_mtime_nsec,
            ctime_sec: s.st_ctime,
            ctime_nsec: s.st_ctime_nsec,
        }
    }
}

pub fn sys_fstat(fd: i32) -> Result<FileStat, i32> {
    var b = SysStatBuf { words: [0u64; 20] };
    // (160 bytes: more than either system's struct stat)
    sys_check_unit(unsafe { sys_c_fstat(fd, &b.words as *u8) })?;
    Ok(sys_stat_decode(&b))
}

// The status of the file at path, following symbolic links.
pub fn sys_stat(path: [u8]) -> Result<FileStat, i32> {
    let p = sys_cpath(path)?;
    var b = SysStatBuf { words: [0u64; 20] };
    // (as sys_fstat)
    sys_check_unit(unsafe { sys_c_stat(&p.buf as *u8, &b.words as *u8) })?;
    Ok(sys_stat_decode(&b))
}

// The status of the file at path, of a symbolic link itself.
pub fn sys_lstat(path: [u8]) -> Result<FileStat, i32> {
    let p = sys_cpath(path)?;
    var b = SysStatBuf { words: [0u64; 20] };
    // (as sys_fstat)
    sys_check_unit(unsafe { sys_c_lstat(&p.buf as *u8, &b.words as *u8) })?;
    Ok(sys_stat_decode(&b))
}

// ---- Sys: directories (0.20) ----

extern "C" {
    #[link_name = "opendir"]
    #[effects(io)]
    fn sys_c_opendir(path: *u8) -> *u8;
    #[link_name = "readdir"]
    #[effects(io)]
    fn sys_c_readdir(dir: *u8) -> *u8;
    #[link_name = "closedir"]
    #[effects(io)]
    fn sys_c_closedir(dir: *u8) -> i32;
    #[link_name = "getcwd"]
    #[effects(io)]
    fn sys_c_getcwd(buf: *u8, n: u64) -> *u8;
    #[link_name = "chdir"]
    #[effects(io)]
    fn sys_c_chdir(path: *u8) -> i32;
}

// struct dirent on macOS: d_name at 21, d_type at 20.
#[repr(C)]
pub struct DirentMacos {
    d_ino: u64,
    d_seekoff: u64,
    d_reclen: u16,
    d_namlen: u16,
    d_type: u8,
    d_name: [u8; 1024],
}

// struct dirent on Linux (glibc): d_name at 19, d_type at 18.
#[repr(C)]
pub struct DirentLinux {
    d_ino: u64,
    d_off: i64,
    d_reclen: u16,
    d_type: u8,
    d_name: [u8; 256],
}

// An open directory (C's DIR *); sys_closedir frees it.
pub struct SysDir {
    handle: *u8,
}

// An entry read by sys_readdir_into: its name's length (the name is in the
// caller's buffer), its kind (SYS_DT_DIR, ...; SYS_DT_UNKNOWN when the file
// system does not say) and its inode.
#[derive(Eq, Debug)]
pub struct SysDirEntry {
    name_len: i64,
    kind: u8,
    ino: u64,
}

pub const SYS_DT_UNKNOWN: u8 = 0;
pub const SYS_DT_FIFO: u8 = 1;
pub const SYS_DT_CHR: u8 = 2;
pub const SYS_DT_DIR: u8 = 4;
pub const SYS_DT_BLK: u8 = 6;
pub const SYS_DT_REG: u8 = 8;
pub const SYS_DT_LNK: u8 = 10;
pub const SYS_DT_SOCK: u8 = 12;

pub fn sys_opendir(path: [u8]) -> Result<SysDir, i32> {
    let p = sys_cpath(path)?;
    let d = unsafe { sys_c_opendir(&p.buf as *u8) };
    if d == 0 as *u8 {
        return Err(sys_errno());
    }
    Ok(SysDir { handle: d })
}

// The next entry of dir, its name copied into name (`.` and `..` included,
// in the order the file system gives them): None at the end.
pub fn sys_readdir_into(dir: inout SysDir, name: inout [u8; 256]) -> Result<Option<SysDirEntry>,
    i32> {
    if dir.handle == 0 as *u8 {
        return Err(SYS_EBADF);
    }
    sys_set_errno(0);
    // (handle is an open DIR * until sys_closedir clears it)
    let e = unsafe { sys_c_readdir(dir.handle) };
    if e == 0 as *u8 {
        let err = sys_errno();
        return if err == 0 { Ok(None) } else { Err(err) };
    }
    var kind = 0u8;
    var ino = 0u64;
    var nm = ""[0..0];
    // (readdir's entry is a struct dirent of this system, valid until the
    // next readdir; d_name is NUL-ended within it)
    unsafe {
        if TARGET_OS == 1 {
            let d = e as *DirentLinux;
            kind = d.d_type;
            ino = d.d_ino;
            nm = sys_cstr_view(&d.d_name as *u8);
        } else {
            let d = e as *DirentMacos;
            kind = d.d_type;
            ino = d.d_ino;
            nm = sys_cstr_view(&d.d_name as *u8);
        }
    }
    if nm.len > 256 {
        return Err(SYS_ENAMETOOLONG);
    }
    for i in 0..nm.len {
        name[i] = nm[i];
    }
    Ok(Some(SysDirEntry { name_len: nm.len, kind: kind, ino: ino }))
}

// Closes dir (once: its handle is cleared).
pub fn sys_closedir(dir: inout SysDir) -> Result<(), i32> {
    if dir.handle == 0 as *u8 {
        return Err(SYS_EBADF);
    }
    // (an open DIR *, closed once)
    let r = unsafe { sys_c_closedir(dir.handle) };
    dir.handle = 0 as *u8;
    sys_check_unit(r)
}

// The working directory's path, into buf: its length (ERANGE when buf is
// too short).
pub fn sys_getcwd_into(buf: inout [u8]) -> Result<i64, i32> {
    // (getcwd writes at most buf.len bytes, its NUL included)
    let r = unsafe { sys_c_getcwd(buf.ptr, buf.len as u64) };
    if r == 0 as *u8 {
        return Err(sys_errno());
    }
    var n = 0;
    for i in 0..buf.len {
        if buf[i] == 0 {
            break;
        }
        n += 1;
    }
    Ok(n)
}

pub fn sys_chdir(path: [u8]) -> Result<(), i32> {
    let p = sys_cpath(path)?;
    sys_check_unit(unsafe { sys_c_chdir(&p.buf as *u8) })
}

// ---- Sys: the environment (0.20) ----

extern "C" {
    static environ: **u8;
    #[link_name = "getenv"]
    #[effects(global)]
    fn sys_c_getenv(name: *u8) -> *u8;
    #[link_name = "setenv"]
    #[effects(global)]
    fn sys_c_setenv(name: *u8, value: *u8, overwrite: i32) -> i32;
    #[link_name = "unsetenv"]
    #[effects(global)]
    fn sys_c_unsetenv(name: *u8) -> i32;
}

// C's `environ`: the NUL-ended strings NAME=VALUE, then a null pointer.
pub fn sys_environ() -> **u8 {
    unsafe { environ }
}

// The number of the environment's variables.
pub fn sys_env_count() -> i64 {
    let e = sys_environ();
    var n = 0;
    // (environ ends with a null pointer; 2^31 bounds the walk)
    for i in 0..2147483647 {
        if unsafe { e[i] } == 0 as *u8 {
            break;
        }
        n += 1;
    }
    n
}

// The environment's i-th variable, `NAME=VALUE` (i < sys_env_count()): a
// view valid until the environment changes (sys_setenv, sys_unsetenv).
pub fn sys_env_at(i: i64) -> [u8] {
    if i < 0 || i >= sys_env_count() {
        panic_str("sys_env_at: index out of bounds");
    }
    // (i is within environ's entries, each a NUL-ended string)
    unsafe { sys_cstr_view(sys_environ()[i]) }
}

// The value of the variable name, a view valid until the environment
// changes; None when it is not set (or name is not a valid C string).
pub fn sys_getenv(name: [u8]) -> Option<[u8]> {
    let p = match sys_cpath(name) {
        Ok(p) => p,
        Err(_) => return None,
    };
    // (getenv returns null or a NUL-ended string in the environment)
    let v = unsafe { sys_c_getenv(&p.buf as *u8) };
    if v == 0 as *u8 {
        None
    } else {
        Some(unsafe { sys_cstr_view(v) })
    }
}

// Sets the variable name to value. Unsafe as in Rust 2024: views of the
// environment (sys_env_at, sys_getenv) may dangle afterwards, and other
// threads may be reading it.
pub unsafe fn sys_setenv(name: [u8], value: [u8]) -> Result<(), i32> {
    let n = sys_cpath(name)?;
    let v = sys_cpath(value)?;
    sys_check_unit(sys_c_setenv(&n.buf as *u8, &v.buf as *u8, 1))
}

// Removes the variable name (unsafe as sys_setenv).
pub unsafe fn sys_unsetenv(name: [u8]) -> Result<(), i32> {
    let n = sys_cpath(name)?;
    sys_check_unit(sys_c_unsetenv(&n.buf as *u8))
}

