pub const SYS_SIGHUP: i32 = 1;
pub const SYS_SIGINT: i32 = 2;
pub const SYS_SIGKILL: i32 = 9;
pub const SYS_SIGTERM: i32 = 15;
const SYS_WNOHANG: i32 = 1;

// posix_spawn_file_actions_t, opaque: room for either system's (8 bytes
// on macOS, 80 on Linux).
pub struct SysSpawnActions {
    words: [u64; 16],
    live: bool,
}

// Empty file actions; sys_spawn_actions_free frees them.
pub fn sys_spawn_actions() -> Result<SysSpawnActions, i32> {
    var a = SysSpawnActions { words: [0u64; 16], live: false };
    // (128 bytes, more than either system's posix_spawn_file_actions_t)
    let r = unsafe { sys_c_actions_init(&a.words as *u8) };
    if r != 0 {
        return Err(r);
    }
    a.live = true;
    Ok(a)
}

impl SysSpawnActions {
    // In the child: `to` becomes a copy of fd.
    pub fn dup2(inout self, fd: i32, to: i32) -> Result<(), i32> {
        if !self.live {
            return Err(SYS_EINVAL);
        }
        // (live: initialized and not destroyed)
        let r = unsafe { sys_c_actions_adddup2(&self.words as *u8, fd, to) };
        if r != 0 { Err(r) } else { Ok(()) }
    }

    // In the child: fd is closed.
    pub fn close(inout self, fd: i32) -> Result<(), i32> {
        if !self.live {
            return Err(SYS_EINVAL);
        }
        // (as dup2)
        let r = unsafe { sys_c_actions_addclose(&self.words as *u8, fd) };
        if r != 0 { Err(r) } else { Ok(()) }
    }

    pub fn free(inout self) {
        if self.live {
            // (as dup2)
            unsafe { sys_c_actions_destroy(&self.words as *u8); }
            self.live = false;
        }
    }
}

// Runs prog (a path, or a name looked up in PATH) with argv (C strings
// ending with a null pointer; argv[0] is the program's name) and envp
// (likewise; empty: this process's environment), after the file actions
// (null: none): the child's pid. EINVAL when argv or a non-empty envp does
// not end with a null pointer.
// Unsafe: prog and every pointer before argv's and envp's null must be
// NUL-ended strings.
pub unsafe fn sys_spawn(prog: *u8, argv: [*u8], envp: [*u8], actions: *SysSpawnActions) -> Result<i32, i32> {
    if argv.len == 0 || argv[argv.len - 1] != 0 as *u8 {
        return Err(SYS_EINVAL);
    }
    if envp.len > 0 && envp[envp.len - 1] != 0 as *u8 {
        return Err(SYS_EINVAL);
    }
    let env = if envp.len == 0 { sys_environ() } else { envp.ptr };
    let acts = if actions == 0 as *SysSpawnActions || !actions.live {
        0 as *u8
    } else {
        &actions.words as *u8
    };
    var pid = 0i32;
    let r = sys_c_posix_spawnp(&pid, prog, acts, 0 as *u8, argv.ptr, env);
    if r != 0 {
        return Err(r);
    }
    Ok(pid)
}

// Waits for the child pid (-1: any child) to end, or with nohang only
// looks: (its pid, its status; sys_exit_code and sys_exit_signal read it),
// or (0, 0) when nohang and it is still running.
pub fn sys_waitpid(pid: i32, nohang: bool) -> Result<(i32, i32), i32> {
    var status = 0i32;
    let r = unsafe { sys_c_waitpid(pid, &status, if nohang { SYS_WNOHANG } else { 0 }) };
    if r == -1 {
        return Err(sys_errno());
    }
    Ok((r, status))
}

// The exit code of a wait status, when the process exited.
pub fn sys_exit_code(status: i32) -> Option<i32> {
    if (status & 0x7f) == 0 { Some((status >> 8) & 0xff) } else { None }
}

// The signal that ended the process, when one did.
pub fn sys_exit_signal(status: i32) -> Option<i32> {
    let s = status & 0x7f;
    if s != 0 && s != 0x7f { Some(s) } else { None }
}

pub fn sys_kill(pid: i32, sig: i32) -> Result<(), i32> {
    sys_check_unit(unsafe { sys_c_kill(pid, sig) })
}

pub fn sys_getpid() -> i32 {
    unsafe { sys_c_getpid() }
}

