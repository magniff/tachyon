// Generics (0.5): monomorphization, checked at instantiation.
//
// A generic function, struct or enum is a template: it is never checked
// as it is written. Each use with new type arguments makes an instance:
// a struct or enum of its own (fields resolved with the parameters bound
// to the arguments), or a function of its own whose AST is a copy of the
// template's, checked with the parameters bound. The middle end and the
// code generators only ever see instances. Instances are made in the
// order the checker meets them, so their order and names are
// deterministic.
//
// Type arguments are written (`Vec<i64>`, `max::<i64>(...)`,
// `Vec::<u8>::new()`, `Pair::<i64> { ... }`) or inferred: from the types
// of the arguments (or fields), and from the type the context expects.
//
// Symbols: an instance's symbol is its template's, then `.G` and its type
// arguments in a self-delimiting code (mangle_type): `max.Gl` is
// max::<i64>, `Vec.Gl.push` is the method push of Vec<i64>.

// The type parameters in scope (of the instance being made or checked):
// names and types from TP_BASE on.
use std::Option;
use crate::base::{
    IntVec, SYMS, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_position, buf_slice,
    buf_str, err_begin, err_end, err_help, err_int, err_str, err_sym, error_at, free, intern,
};
use crate::lexer::{SUF_NONE, Tok};
use crate::ast::{NODES, NodeKind, child, list_begin, list_end, list_push, new_node};
use crate::modules::{CUR_MOD, module_of};
use crate::types::{
    ENUMS, ENUM_COUNT, FNS, FN_COUNT, STRUCTS, STRUCT_COUNT, SYM_ALIAS, SYM_ENUM, SYM_STRUCT,
    TLISTS, TSCRATCH, TYPES, TY_I8, TY_NEVER, TyKind, buf_type, enum_type, err_type, max_i64,
    struct_type, type_elem,
};
use crate::check::{
    Res, SELF_TYPE, SELF_TYPE_SYM, add_fn, check_expr, collect_enum_variants, collect_struct_fields,
    enum_has_cycle, mismatch_error, new_enum, new_struct, reset_layout_states, resolve_signature,
    resolve_type, struct_has_cycle, synth_expr, template_of_type_node, type_name_key,
};
use crate::lower::HMap;
use crate::traits::check_bounds;
use crate::ast::NodeKind::{
    Arm, Assign, Binary, Block, Break, Call, Cast, Defer, EnumPanic, ExprStmt, FieldAccess,
    FieldInit, Float, Fn, For, If, Index, Int, Let, Loop, Match, MethodCall, Param, PatLit,
    PatRange, Range, Repeat, Return, TupleField, TyArray, TyFn, TyName, TyPtr, TySlice, TyTuple,
    Unary, While,
};

pub static mut TP_NAMES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut TP_TYPES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut TP_BASE: i64 = 0;
// The instance whose body is being checked (-1: none).
pub static mut CUR_INST: i64 = -1;
// Instances whose bodies are still to be checked.
pub static mut INST_QUEUE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Arguments already synthesized to infer type arguments (node + 1 -> 1).
static mut SYNTHED: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
// The type the context expects of node HINT_NODE (see check_expr).
pub static mut HINT_NODE: i64 = 0;
pub static mut HINT_TY: i64 = 0;

const MAX_INST_DEPTH: i64 = 64;
const MAX_TYPE_DEPTH: i64 = 12;

// Binds the parameters `params` (a Generics node) to the `count` types at
// TLISTS[targs...]; returns what env_leave restores.
pub fn env_enter(params: i64, targs: i64, count: i64) -> i64 {
    let saved = TP_BASE;
    TP_BASE = TP_NAMES.count;
    for i in 0..count {
        TP_NAMES.push(NODES[child(params, i)].a);
        TP_TYPES.push(TLISTS.data[targs + i]);
    }
    saved
}

pub fn env_leave(saved: i64) {
    TP_NAMES.count = TP_BASE;
    TP_TYPES.count = TP_BASE;
    TP_BASE = saved;
}

// The type a type parameter in scope stands for, or 0.
pub fn env_lookup(name: i64) -> i64 {
    for i in TP_BASE..TP_NAMES.count {
        if TP_NAMES.data[i] == name {
            return TP_TYPES.data[i];
        }
    }
    0
}

pub fn hint_for(n: i64) -> i64 {
    if HINT_NODE == n { HINT_TY } else { 0 }
}

fn mark_synthed(n: i64) {
    SYNTHED.put(n + 1, 1);
}

// Checks argument (or field value) `arg` against `ty`; it may have been
// synthesized already, to infer type arguments.
pub fn check_arg(arg: i64, ty: i64) {
    if SYNTHED.get(arg + 1) == 0 {
        check_expr(arg, ty);
        return;
    }
    let actual = NODES[arg].ty;
    if actual != ty && actual != TY_NEVER {
        mismatch_error(arg, ty, actual);
    }
}

// An integer or float literal without a suffix (maybe negated): its type
// comes from where it goes, so it is looked at last.
fn is_untyped_literal_expr(n: i64) -> bool {
    let kind = NODES[n].kind;
    if kind == Unary && NODES[n].op == Tok::Minus {
        return is_untyped_literal_expr(NODES[n].b);
    }
    (kind == Int || kind == Float) && NODES[n].b == SUF_NONE
}

// ---- Names and symbols ----

// `name<A, B>` for messages.
fn generic_display(name: i64, targs: i64, count: i64) -> i64 {
    let out = buf_new();
    buf_bytes(out, SYMS[name].text);
    buf_byte(out, '<');
    for i in 0..count {
        if i > 0 {
            buf_str(out, c", ");
        }
        buf_type(out, TLISTS.data[targs + i]);
    }
    buf_byte(out, '>');
    intern(buf_slice(out))
}

// `base.G<code of each argument>`.
fn generic_symbol(base: i64, targs: i64, count: i64) -> i64 {
    let out = buf_new();
    buf_bytes(out, SYMS[base].text);
    buf_str(out, c".G");
    for i in 0..count {
        mangle_type(out, TLISTS.data[targs + i]);
    }
    intern(buf_slice(out))
}

// A code for type t, made of letters, digits, `_` and `.`, from which t
// can be read back: primitives by a letter (as in C++'s mangling), then
// P<t> pointer, S<t> slice, A<n>_<t> array, T<n>_<ts> tuple, F<n>_<ts><t>
// (C<n>_... for extern "C") function, and N<length><symbol> for a struct
// or an enum.
pub fn mangle_type(out: i64, t: i64) {
    let kind = TYPES[t].kind;
    if kind == TyKind::Prim {
        let codes: [u8; 13] = ['a', 's', 'i', 'l', 'h', 't', 'j', 'm', 'f', 'd', 'b', 'v', 'z'];
        buf_byte(out, codes[t - TY_I8]);
        return;
    }
    match kind {
        TyKind::Ptr => {
            buf_byte(out, 'P');
            mangle_type(out, TYPES[t].a);
        }
        TyKind::Slice => {
            buf_byte(out, 'S');
            mangle_type(out, TYPES[t].a);
        }
        TyKind::Array => {
            buf_byte(out, 'A');
            buf_int(out, TYPES[t].b);
            buf_byte(out, '_');
            mangle_type(out, TYPES[t].a);
        }
        TyKind::Tuple => {
            buf_byte(out, 'T');
            buf_int(out, TYPES[t].count);
            buf_byte(out, '_');
            for i in 0..TYPES[t].count {
                mangle_type(out, type_elem(t, i));
            }
        }
        TyKind::Fn => {
            buf_byte(out, if TYPES[t].b != 0 { 'C' } else { 'F' });
            buf_int(out, TYPES[t].count);
            buf_byte(out, '_');
            for i in 0..TYPES[t].count {
                mangle_type(out, type_elem(t, i));
            }
            mangle_type(out, TYPES[t].a);
        }
        TyKind::Struct | TyKind::Enum => {
            let sym = if kind == TyKind::Struct { STRUCTS[TYPES[t].a].sym } else { ENUMS[TYPES[t].a].sym };
            buf_byte(out, 'N');
            buf_int(out, SYMS[sym].text.len);
            buf_bytes(out, SYMS[sym].text);
        }
        _ => buf_byte(out, 'x'),
    }
}

// How deeply type t nests (to stop instantiations that grow forever).
fn type_depth(t: i64) -> i64 {
    let kind = TYPES[t].kind;
    let mut depth = 0;
    if kind == TyKind::Ptr || kind == TyKind::Slice || kind == TyKind::Array {
        depth = type_depth(TYPES[t].a);
    } else if kind == TyKind::Tuple || kind == TyKind::Fn {
        for i in 0..TYPES[t].count {
            depth = max_i64(depth, type_depth(type_elem(t, i)));
        }
        if kind == TyKind::Fn {
            depth = max_i64(depth, type_depth(TYPES[t].a));
        }
    } else if kind == TyKind::Struct && STRUCTS[TYPES[t].a].tmpl != 0 {
        let s = TYPES[t].a;
        for i in 0..STRUCTS[s].targ_count {
            depth = max_i64(depth, type_depth(TLISTS.data[STRUCTS[s].targs + i]));
        }
    } else if kind == TyKind::Enum && ENUMS[TYPES[t].a].tmpl != 0 {
        let e = TYPES[t].a;
        for i in 0..ENUMS[e].targ_count {
            depth = max_i64(depth, type_depth(TLISTS.data[ENUMS[e].targs + i]));
        }
    }
    depth + 1
}

// The type arguments TSCRATCH[mark..] (popped) as a new TLISTS range.
fn take_targs(mark: i64) -> i64 {
    let targs = TLISTS.count;
    for i in mark..TSCRATCH.count {
        TLISTS.push(TSCRATCH.data[i]);
    }
    TSCRATCH.count = mark;
    targs
}

fn same_targs(targs: i64, count: i64, mark: i64) -> bool {
    if TSCRATCH.count - mark != count {
        return false;
    }
    for i in 0..count {
        if TLISTS.data[targs + i] != TSCRATCH.data[mark + i] {
            return false;
        }
    }
    true
}

fn check_targ_depth(mark: i64, pos: i64) {
    for i in mark..TSCRATCH.count {
        if type_depth(TSCRATCH.data[i]) > MAX_TYPE_DEPTH {
            error_at(pos, c"type arguments nested too deeply (does a generic type instantiate itself with ever larger arguments?)");
        }
    }
}

pub fn targ_count_error(pos: i64, what: *u8, name: i64, expected: i64, got: i64) -> ! {
    err_begin(pos);
    err_str(what);
    err_str(c" '");
    err_sym(name);
    err_str(c"' takes ");
    err_int(expected);
    err_str(if expected == 1 { c" type argument" } else { c" type arguments" });
    err_str(c", got ");
    err_int(got);
    err_end()
}

// ---- Instances of structs and enums ----

// The instance of struct template `tpl` with the type arguments
// TSCRATCH[mark..] (popped).
fn struct_instance(tpl: i64, mark: i64, pos: i64) -> i64 {
    let count = TSCRATCH.count - mark;
    if count != STRUCTS[tpl].generic {
        targ_count_error(pos, c"struct", STRUCTS[tpl].name, STRUCTS[tpl].generic, count);
    }
    for s in 0..STRUCT_COUNT {
        if STRUCTS[s].tmpl == tpl + 1 && same_targs(STRUCTS[s].targs, STRUCTS[s].targ_count, mark) {
            TSCRATCH.count = mark;
            return struct_type(s);
        }
    }
    check_targ_depth(mark, pos);
    let targs = take_targs(mark);
    let node = STRUCTS[tpl].node;
    check_bounds(NODES[node].g, targs, count, STRUCTS[tpl].name, pos);
    let s = new_struct(node, generic_display(STRUCTS[tpl].name, targs, count),
        generic_symbol(STRUCTS[tpl].sym, targs, count), STRUCTS[tpl].module);
    STRUCTS[s].tmpl = tpl + 1;
    STRUCTS[s].targs = targs;
    STRUCTS[s].targ_count = count;
    let saved_mod = CUR_MOD;
    let saved_self = SELF_TYPE;
    CUR_MOD = STRUCTS[s].module;
    SELF_TYPE = 0;
    let saved = env_enter(NODES[node].g, targs, count);
    collect_struct_fields(s);
    env_leave(saved);
    CUR_MOD = saved_mod;
    SELF_TYPE = saved_self;
    reset_layout_states();
    if struct_has_cycle(s) {
        err_begin(pos);
        err_str(c"struct '");
        err_sym(STRUCTS[s].name);
        err_str(c"' has infinite size due to recursive field (use a pointer to break the cycle)");
        err_end();
    }
    struct_type(s)
}

fn enum_instance(tpl: i64, mark: i64, pos: i64) -> i64 {
    let count = TSCRATCH.count - mark;
    if count != ENUMS[tpl].generic {
        targ_count_error(pos, c"enum", ENUMS[tpl].name, ENUMS[tpl].generic, count);
    }
    for e in 0..ENUM_COUNT {
        if ENUMS[e].tmpl == tpl + 1 && same_targs(ENUMS[e].targs, ENUMS[e].targ_count, mark) {
            TSCRATCH.count = mark;
            return enum_type(e);
        }
    }
    check_targ_depth(mark, pos);
    let targs = take_targs(mark);
    let node = ENUMS[tpl].node;
    check_bounds(NODES[node].g, targs, count, ENUMS[tpl].name, pos);
    let e = new_enum(node, generic_display(ENUMS[tpl].name, targs, count),
        generic_symbol(ENUMS[tpl].sym, targs, count), ENUMS[tpl].module);
    ENUMS[e].tmpl = tpl + 1;
    ENUMS[e].targs = targs;
    ENUMS[e].targ_count = count;
    let saved_mod = CUR_MOD;
    let saved_self = SELF_TYPE;
    CUR_MOD = ENUMS[e].module;
    SELF_TYPE = 0;
    let saved = env_enter(NODES[node].g, targs, count);
    collect_enum_variants(e);
    env_leave(saved);
    CUR_MOD = saved_mod;
    SELF_TYPE = saved_self;
    reset_layout_states();
    if enum_has_cycle(e) {
        err_begin(pos);
        err_str(c"enum '");
        err_sym(ENUMS[e].name);
        err_str(c"' has infinite size due to a recursive field (use a pointer to break the cycle)");
        err_end();
    }
    enum_type(e)
}

// A template named by a type node (a TyName): struct s as s + 1, enum e
// as -(e + 1); 0 for none.
pub const TPL_NONE: i64 = 0;

pub fn template_of_key(key: i64) -> i64 {
    if SYM_STRUCT[key] != 0 && STRUCTS[SYM_STRUCT[key] - 1].generic > 0 {
        return SYM_STRUCT[key];
    }
    if SYM_ENUM[key] != 0 && ENUMS[SYM_ENUM[key] - 1].generic > 0 {
        return -SYM_ENUM[key];
    }
    TPL_NONE
}

// Whether type t is an instance of template `tpl` (encoded as above).
pub fn instance_of(t: i64, tpl: i64) -> bool {
    if tpl > 0 {
        return TYPES[t].kind == TyKind::Struct && STRUCTS[TYPES[t].a].tmpl == tpl;
    }
    tpl < 0 && TYPES[t].kind == TyKind::Enum && ENUMS[TYPES[t].a].tmpl == -tpl
}

pub fn instance_targs(t: i64) -> i64 {
    if TYPES[t].kind == TyKind::Struct { STRUCTS[TYPES[t].a].targs } else { ENUMS[TYPES[t].a].targs }
}

fn template_params(tpl: i64) -> i64 {
    if tpl > 0 { NODES[STRUCTS[tpl - 1].node].g } else { NODES[ENUMS[-tpl - 1].node].g }
}

pub fn template_name(tpl: i64) -> i64 {
    if tpl > 0 { STRUCTS[tpl - 1].name } else { ENUMS[-tpl - 1].name }
}

// The instance of template tpl with TSCRATCH[mark..].
pub fn template_instance(tpl: i64, mark: i64, pos: i64) -> i64 {
    if tpl > 0 { struct_instance(tpl - 1, mark, pos) } else { enum_instance(-tpl - 1, mark, pos) }
}

// ---- Inference ----

// Bindings of the parameters `params` (a Generics node) being inferred:
// bound[i] is the type of parameter i, 0 while unknown.
fn tparam_index(params: i64, name: i64) -> Option<i64> {
    if params == 0 {
        return Option::None;
    }
    for i in 0..NODES[params].count {
        if NODES[child(params, i)].a == name {
            return Option::Some(i);
        }
    }
    Option::None
}

// The self type (a TyName) of the impl block of the template being
// inferred, which `Self` stands for in its signature (0: none).
pub static mut UNIFY_SELF: i64 = 0;

fn is_self_name(p: i64) -> bool {
    UNIFY_SELF != 0 && NODES[p].a == SELF_TYPE_SYM && NODES[p].count == 0 && NODES[p].g == 0
}

// Whether type node p (of a template) mentions a parameter not yet bound.
fn mentions_unbound(params: i64, bound: *i64, p: i64) -> bool {
    if p == 0 {
        return false;
    }
    let kind = NODES[p].kind;
    if kind == TyName {
        if is_self_name(p) {
            return mentions_unbound(params, bound, UNIFY_SELF);
        }
        if NODES[p].count == 0 {
            match tparam_index(params, NODES[p].a) {
                Option::Some(k) => return bound[k] == 0,
                Option::None => {}
            }
        }
        let g = NODES[p].g;
        if g != 0 {
            for i in 0..NODES[g].count {
                if mentions_unbound(params, bound, child(g, i)) {
                    return true;
                }
            }
        }
        return false;
    }
    if kind == TyPtr || kind == TySlice || kind == TyArray {
        return mentions_unbound(params, bound, NODES[p].a);
    }
    if kind == TyTuple || kind == TyFn {
        for i in 0..NODES[p].count {
            if mentions_unbound(params, bound, child(p, i)) {
                return true;
            }
        }
        return kind == TyFn && mentions_unbound(params, bound, NODES[p].a);
    }
    false
}

// Matches type node p (of a template declared in module `tmod`) against
// type t, binding parameters; false when a parameter is already bound to
// another type.
// Generic aliases met while unifying (0.6): (name, argument node, its
// module, the frame it is in: lo, hi) for each parameter of the aliases
// being looked through; ALIAS_LO..ALIAS_HI are the entries in scope.
static mut ALIAS_SUBST: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut ALIAS_LO: i64 = 0;
static mut ALIAS_HI: i64 = 0;

// Unifies the body of the generic alias named by p (`Pair<T>`, its
// arguments in p's `g`) with t, its parameters standing for those
// arguments.
fn unify_alias(params: i64, bound: *i64, tmod: i64, p: i64, alias: i64, t: i64) -> bool {
    let g = NODES[p].g;
    let aparams = NODES[alias].g;
    if NODES[g].count != NODES[aparams].count {
        return true;
    }
    let mark = ALIAS_SUBST.count;
    for i in 0..NODES[g].count {
        ALIAS_SUBST.push(NODES[child(aparams, i)].a);
        ALIAS_SUBST.push(child(g, i));
        ALIAS_SUBST.push(tmod);
        ALIAS_SUBST.push(ALIAS_LO);
        ALIAS_SUBST.push(ALIAS_HI);
    }
    let (lo, hi) = (ALIAS_LO, ALIAS_HI);
    ALIAS_LO = mark;
    ALIAS_HI = ALIAS_SUBST.count;
    let ok = unify(params, bound, module_of(alias), NODES[alias].b, t);
    ALIAS_LO = lo;
    ALIAS_HI = hi;
    ALIAS_SUBST.count = mark;
    ok
}

fn unify(params: i64, bound: *i64, tmod: i64, p: i64, t: i64) -> bool {
    if p == 0 || t == 0 {
        return true;
    }
    let kind = NODES[p].kind;
    let tk = TYPES[t].kind;
    if kind == TyName {
        if is_self_name(p) {
            return unify(params, bound, tmod, UNIFY_SELF, t);
        }
        if NODES[p].count == 0 && NODES[p].g == 0 {
            // A parameter of an alias being looked through: its argument.
            let mut i = ALIAS_LO;
            while i < ALIAS_HI {
                if ALIAS_SUBST.data[i] == NODES[p].a {
                    let (lo, hi) = (ALIAS_LO, ALIAS_HI);
                    ALIAS_LO = ALIAS_SUBST.data[i + 3];
                    ALIAS_HI = ALIAS_SUBST.data[i + 4];
                    let ok = unify(params, bound, ALIAS_SUBST.data[i + 2], ALIAS_SUBST.data[i + 1], t);
                    ALIAS_LO = lo;
                    ALIAS_HI = hi;
                    return ok;
                }
                i += 5;
            }
            match tparam_index(params, NODES[p].a) {
                Option::Some(k) => {
                    if bound[k] == 0 {
                        bound[k] = t;
                        return true;
                    }
                    return bound[k] == t;
                }
                Option::None => return true,
            }
        }
        let g = NODES[p].g;
        if g == 0 {
            return true;
        }
        let saved = CUR_MOD;
        CUR_MOD = tmod;
        let key = if NODES[p].count == 0 && env_lookup(NODES[p].a) != 0 { -1 } else { type_name_key(p) };
        let tpl = template_of_type_node(p);
        CUR_MOD = saved;
        if key >= 0 && SYM_ALIAS[key] != 0 && NODES[SYM_ALIAS[key]].g != 0 {
            return unify_alias(params, bound, tmod, p, SYM_ALIAS[key], t);
        }
        if tpl == TPL_NONE || !instance_of(t, tpl) {
            return true;
        }
        let targs = instance_targs(t);
        let mut ok = true;
        for i in 0..NODES[g].count {
            if !unify(params, bound, tmod, child(g, i), TLISTS.data[targs + i]) {
                ok = false;
            }
        }
        return ok;
    }
    if kind == TyPtr && tk == TyKind::Ptr || kind == TySlice && tk == TyKind::Slice
        || kind == TyArray && tk == TyKind::Array {
        return unify(params, bound, tmod, NODES[p].a, TYPES[t].a);
    }
    if kind == TyTuple && tk == TyKind::Tuple && NODES[p].count == TYPES[t].count
        || kind == TyFn && tk == TyKind::Fn && NODES[p].count == TYPES[t].count {
        let mut ok = true;
        for i in 0..NODES[p].count {
            if !unify(params, bound, tmod, child(p, i), type_elem(t, i)) {
                ok = false;
            }
        }
        if kind == TyFn && !unify(params, bound, tmod, NODES[p].a, TYPES[t].a) {
            ok = false;
        }
        return ok;
    }
    true
}

// Infers the parameters of `params` from the expressions `args` (a node
// whose list they are, from list index `first`) against the type nodes
// `types` (a node whose list they are, from `first_type`; for a function
// its Param nodes, whose `b` is the type; `param_nodes` says which), and
// from the expected type `hint` against `result` (a type node, or 0).
fn infer_from(params: i64, bound: *i64, tmod: i64, args: i64, first: i64, types: i64, first_type: i64,
    param_nodes: bool, result: i64, hint: i64) {
    if hint != 0 && result != 0 {
        let trial = alloc_array::<i64>(NODES[params].count);
        for i in 0..NODES[params].count {
            trial[i] = bound[i];
        }
        if unify(params, trial, tmod, result, hint) {
            for i in 0..NODES[params].count {
                bound[i] = trial[i];
            }
        }
    }
    for pass in 0..2 {
        for i in first..NODES[args].count {
            let k = first_type + i - first;
            if k >= NODES[types].count {
                break;
            }
            let p = if param_nodes { NODES[child(types, k)].b } else { child(types, k) };
            if !mentions_unbound(params, bound, p) {
                continue;
            }
            let arg = child(args, i);
            if pass == 0 && is_untyped_literal_expr(arg) {
                continue;
            }
            let t = synth_expr(arg);
            mark_synthed(arg);
            if t != TY_NEVER && !unify(params, bound, tmod, p, t) {
                err_begin(NODES[arg].start);
                err_str(c"mismatched types: this is '");
                err_type(t);
                err_str(c"', which does not fit the type parameters inferred so far");
                err_end();
            }
        }
    }
}

// All parameters bound, or an error naming the first that is not.
fn require_bound(params: i64, bound: *i64, pos: i64, what: i64, how: *u8) {
    for i in 0..NODES[params].count {
        if bound[i] == 0 {
            err_begin(pos);
            err_str(c"cannot infer type parameter '");
            err_sym(NODES[child(params, i)].a);
            err_str(c"' of '");
            err_sym(what);
            err_str(c"'");
            err_help(how);
            err_end();
        }
    }
}

// The type arguments written in a Generics node (in the current scope),
// pushed on TSCRATCH.
pub fn push_written_targs(g: i64) {
    for i in 0..NODES[g].count {
        let t = resolve_type(child(g, i));
        TSCRATCH.push(t);
    }
}

// ---- Instances of functions ----

// The instance of function template tf with the type arguments
// TSCRATCH[mark..] (popped); `origin` is the node using it.
pub fn fn_instance(tf: i64, mark: i64, origin: i64) -> i64 {
    let count = TSCRATCH.count - mark;
    for f in 0..FN_COUNT {
        if FNS[f].tmpl == tf + 1 && same_targs(FNS[f].targs, FNS[f].targ_count, mark) {
            TSCRATCH.count = mark;
            return f;
        }
    }
    check_targ_depth(mark, NODES[origin].start);
    let depth = if CUR_INST >= 0 { FNS[CUR_INST].depth + 1 } else { 1 };
    if depth > MAX_INST_DEPTH {
        err_begin(NODES[origin].start);
        err_str(c"too many nested instantiations of '");
        err_sym(FNS[tf].display);
        err_str(c"' (does a generic function call itself with ever larger type arguments?)");
        err_end();
    }
    let targs = take_targs(mark);
    let template = FNS[tf].node;
    check_bounds(NODES[template].g, targs, count, FNS[tf].display, NODES[origin].start);
    let item = clone_node(template);
    NODES[item].g = 0;
    add_fn(item, generic_symbol(FNS[tf].name, targs, count), 0);
    let f = FN_COUNT - 1;
    FNS[f].targs = targs;
    FNS[f].targ_count = count;
    FNS[f].origin = origin;
    FNS[f].parent = CUR_INST + 1;
    FNS[f].depth = depth;
    FNS[f].module = FNS[tf].module;
    FNS[f].is_extern = false;
    FNS[f].export = false;
    let saved_mod = CUR_MOD;
    let saved_self = SELF_TYPE;
    CUR_MOD = FNS[f].module;
    let saved = env_enter(NODES[template].g, targs, count);
    SELF_TYPE = if NODES[template].h != 0 { resolve_type(NODES[template].h) } else { 0 };
    FNS[f].self_ty = SELF_TYPE;
    FNS[f].display = instance_display(f, tf);
    resolve_signature(f);
    // Found from now on (not when its signature failed to resolve).
    FNS[f].tmpl = tf + 1;
    env_leave(saved);
    CUR_MOD = saved_mod;
    SELF_TYPE = saved_self;
    INST_QUEUE.push(f);
    f
}

// `max<i64>`, or `Vec<i64>::push` for a method of a generic impl (with
// its own type arguments after it, if any).
fn instance_display(f: i64, tf: i64) -> i64 {
    let template = FNS[tf].node;
    let out = buf_new();
    let params = NODES[template].g;
    let impl_count = if NODES[template].h != 0 { NODES[params].a } else { 0 };
    if NODES[template].h != 0 {
        buf_type(out, FNS[f].self_ty);
        buf_str(out, c"::");
    }
    buf_bytes(out, SYMS[NODES[template].a].text);
    if FNS[f].targ_count > impl_count {
        buf_byte(out, '<');
        for i in impl_count..FNS[f].targ_count {
            if i > impl_count {
                buf_str(out, c", ");
            }
            buf_type(out, TLISTS.data[FNS[f].targs + i]);
        }
        buf_byte(out, '>');
    }
    intern(buf_slice(out))
}

// The instance of generic function tf called by `n` (a Call whose list
// holds the arguments, or a MethodCall, whose receiver of type `self_ty`
// is not in its list): its type parameters are bound from `self_ty` (the
// type of a method's receiver, or the type of a path `Vec<i64>::f`, 0 when
// none), the turbofish `written` (a Generics node with the function's own
// parameters, 0 when none), the arguments (from list index 0, against
// the parameters from `first_param`) and the expected type.
pub fn instantiate_call(tf: i64, n: i64, first_param: i64, self_ty: i64, written: i64) -> i64 {
    let template = FNS[tf].node;
    let params = NODES[template].g;
    let count = NODES[params].count;
    let impl_count = if NODES[template].h != 0 { NODES[params].a } else { 0 };
    let tmod = FNS[tf].module;
    let bound = alloc_array::<i64>(count);
    let saved_self = UNIFY_SELF;
    UNIFY_SELF = NODES[template].h;
    if self_ty != 0 && NODES[template].h != 0 {
        unify(params, bound, tmod, NODES[template].h, self_ty);
    }
    if written != 0 {
        if NODES[written].count != count - impl_count {
            targ_count_error(NODES[written].start, c"function", FNS[tf].display, count - impl_count, NODES[written].count);
        }
        for i in 0..NODES[written].count {
            bound[impl_count + i] = resolve_type(child(written, i));
        }
    }
    infer_from(params, bound, tmod, n, 0, template, first_param, true, NODES[template].b, hint_for(n));
    UNIFY_SELF = saved_self;
    require_bound(params, bound, NODES[n].start, FNS[tf].display, c"write the type arguments: 'f::<T>(...)'");
    let mark = TSCRATCH.count;
    for i in 0..count {
        TSCRATCH.push(bound[i]);
    }
    free(bound as *u8);
    fn_instance(tf, mark, n)
}

// The instance of enum template `tpl` (encoded, < 0) a variant `member`
// constructor makes: from the type arguments written on the path
// (`written`), the expected type, or the fields (the arguments of call
// `n`, 0 for a variant without fields).
pub fn infer_enum(tpl: i64, written: i64, member: i64, n: i64, pos: i64) -> i64 {
    let e = -tpl - 1;
    let item = ENUMS[e].node;
    let params = NODES[item].g;
    let mark = TSCRATCH.count;
    if written != 0 {
        push_written_targs(written);
        return template_instance(tpl, mark, pos);
    }
    let hint = if n != 0 { hint_for(n) } else { HINT_TY_PATH };
    if hint != 0 && instance_of(hint, tpl) {
        return hint;
    }
    let bound = alloc_array::<i64>(NODES[params].count);
    let mut variant = 0;
    for i in 0..NODES[item].count {
        if NODES[child(item, i)].a == member {
            variant = child(item, i);
        }
    }
    if n != 0 && variant != 0 {
        infer_from(params, bound, ENUMS[e].module, n, 0, variant, 0, false, 0, 0);
    }
    let how = c"write the type arguments: 'E::<T>::V'";
    require_bound(params, bound, pos, ENUMS[e].name, how);
    for i in 0..NODES[params].count {
        TSCRATCH.push(bound[i]);
    }
    free(bound as *u8);
    template_instance(tpl, mark, pos)
}

// The type expected of a variant written without arguments (`None`): set
// by synth_path from the hint of its node.
pub static mut HINT_TY_PATH: i64 = 0;

// The instance of struct template s a literal `n` builds: from its
// written type arguments, the expected type, or its fields' values.
pub fn infer_struct_literal(s: i64, n: i64, expected: i64) -> i64 {
    let tpl = s + 1;
    let item = STRUCTS[s].node;
    let params = NODES[item].g;
    let mark = TSCRATCH.count;
    if NODES[n].g != 0 {
        push_written_targs(NODES[n].g);
        return TYPES[template_instance(tpl, mark, NODES[n].start)].a;
    }
    if expected != 0 && instance_of(expected, tpl) {
        return TYPES[expected].a;
    }
    let bound = alloc_array::<i64>(NODES[params].count);
    for pass in 0..2 {
        for i in 0..NODES[n].count {
            let init = child(n, i);
            let mut field = 0;
            for k in 0..NODES[item].count {
                if NODES[child(item, k)].a == NODES[init].a {
                    field = child(item, k);
                }
            }
            if field == 0 || !mentions_unbound(params, bound, NODES[field].b) {
                continue;
            }
            let value = NODES[init].b;
            if pass == 0 && is_untyped_literal_expr(value) {
                continue;
            }
            let t = synth_expr(value);
            mark_synthed(value);
            if t != TY_NEVER && !unify(params, bound, STRUCTS[s].module, NODES[field].b, t) {
                err_begin(NODES[value].start);
                err_str(c"mismatched types: this is '");
                err_type(t);
                err_str(c"', which does not fit the type parameters inferred so far");
                err_end();
            }
        }
    }
    require_bound(params, bound, NODES[n].start, STRUCTS[s].name, c"write the type arguments: 'S::<T> { ... }'");
    for i in 0..NODES[params].count {
        TSCRATCH.push(bound[i]);
    }
    free(bound as *u8);
    TYPES[template_instance(tpl, mark, NODES[n].start)].a
}

// ---- Copying templates ----

// A deep copy of the tree at n (0 stays 0), with the checker's fields
// cleared: the body of a function instance.
pub fn clone_node(n: i64) -> i64 {
    if n == 0 {
        return 0;
    }
    let c = new_node(NODES[n].kind, NODES[n].start, NODES[n].end);
    NODES[c] = NODES[n];
    NODES[c].ty = 0;
    NODES[c].x = 0;
    NODES[c].y = 0;
    NODES[c].z = 0;
    NODES[c].res = Res::None;
    let kind = NODES[n].kind;
    match kind {
        Fn => {
            NODES[c].b = clone_node(NODES[n].b);
            NODES[c].c = clone_node(NODES[n].c);
        }
        Param | Let | Cast | Index | Repeat
            | If | Loop | While | For | Range
            | Assign | Return | Break | Arm
            | Binary | Unary | FieldInit | ExprStmt
            | Call | Match | MethodCall | FieldAccess
            | TupleField | Block | PatLit | PatRange
            | TyPtr | TyArray | TySlice | TyFn
            | EnumPanic | Defer => {
            if node_field_a(kind) {
                NODES[c].a = clone_node(NODES[n].a);
            }
            if node_field_b(kind) {
                NODES[c].b = clone_node(NODES[n].b);
            }
            if node_field_c(kind) {
                NODES[c].c = clone_node(NODES[n].c);
            }
            if kind == For {
                NODES[c].d = clone_node(NODES[n].d);
            }
        }
        _ => {}
    }
    NODES[c].g = clone_node(NODES[n].g);
    if kind != Fn {
        NODES[c].h = clone_node(NODES[n].h);
    }
    if NODES[n].count > 0 {
        let mark = list_begin();
        for i in 0..NODES[n].count {
            let copy = clone_node(child(n, i));
            list_push(copy);
        }
        list_end(c, mark);
    }
    c
}

// Which of a, b, c are child nodes, by kind (see ast.tach).
fn node_field_a(kind: NodeKind) -> bool {
    match kind {
        Let | Cast | Index | Repeat | If
            | Range | Return | Arm | ExprStmt
            | Call | Match | MethodCall | FieldAccess
            | TupleField | Block | PatLit | PatRange
            | TyPtr | TyArray | TySlice | TyFn
            | EnumPanic | Defer => true,
        _ => false,
    }
}

fn node_field_b(kind: NodeKind) -> bool {
    match kind {
        Param | Let | Cast | Index | Repeat
            | If | Loop | While | For | Range
            | Assign | Break | Arm | Binary
            | Unary | FieldInit | PatRange | TyArray => true,
        _ => false,
    }
}

fn node_field_c(kind: NodeKind) -> bool {
    match kind {
        Let | If | While | For | Assign
            | Arm | Binary => true,
        _ => false,
    }
}

// ---- Instantiation chains in messages ----

// Notes after an error in an instance: where each enclosing instance was
// made.
pub fn instantiation_notes(out: i64) {
    let mut f = CUR_INST;
    let mut lines = 0;
    while f >= 0 {
        if lines == 4 {
            buf_str(out, c"  = note: (and ");
            buf_int(out, FNS[f].depth);
            buf_str(out, c" more instantiations)\n");
            return;
        }
        buf_str(out, c"  = note: in instantiation of '");
        let text = SYMS[FNS[f].display].text;
        if text.len > 120 {
            buf_bytes(out, text[0..100]);
            buf_str(out, c"...");
        } else {
            buf_bytes(out, text);
        }
        buf_str(out, c"' at ");
        buf_position(out, NODES[FNS[f].origin].start);
        buf_byte(out, '\n');
        f = FNS[f].parent - 1;
        lines += 1;
    }
}
