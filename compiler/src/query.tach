// `tachyonc query` (0.11): questions about a program, answered by the
// front end (lexer, modules, parser, checker; no lowering, no code), for
// agents that would otherwise read the source with grep and sed. See
// docs/query.md for the commands and their output.
//
//   tachyonc query def NAME [ROOT] [--exact]       where NAME is defined
//   tachyonc query show NAME [ROOT] [--exact]      its source text
//   tachyonc query refs NAME [ROOT] [--count] [--exact] [--in FILE|MODULE]
//                       [--limit N] [--all]        every resolved reference
//   tachyonc query callers NAME [ROOT] [...]       the references that call it
//   tachyonc query items [MODULE] [ROOT]           a module's items, or the
//                                                  module tree
//
// Every definition has a fully qualified path (`crate::gvn::run_gvn`,
// `std::Vec::push`, `crate::ir::Inst.op`, `<crate::geom::V2 as Add>::add`),
// printed first and accepted back as NAME; a partial path matches every
// path it ends (by whole segments).
//
// The definitions are taken from the parsed program before the checker
// rewrites it; the references are what the checker resolved: recorded on
// the nodes it checked (identifiers, calls, fields, literals, variants),
// and, for what the nodes do not keep (types, imports, module paths), by
// the hooks that call `qnote`. A generic function is checked per instance
// (copies of its nodes, at the same positions): references are counted
// once per position.
//
// The output is for agents: one fact per line, fields separated by a
// TAB, refs grouped under `# FILE` and cut to a per-file summary past
// REFS_BUDGET; problems on stderr as `<severity> <code>: <message>` with
// `try: <command>` lines (see Diagnostics).

use crate::base::{
    ERR_BAIL, ERR_KIND, FILES, FILE_COUNT, IntVec, RECOVER_DEPTH, SRC, STDERR, STDOUT, SYMS, _setjmp,
    BUFS, alloc_array, alloc_zeroed, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, buf_clear, free, grow, intern, intern_c, load_sources, strlen,
    edit_distance, error_count, first_error_short,
};
use crate::lexer::{TOKS, TOK_COUNT, Tok, init_lexer, lex_range};
use crate::cpp::file_exists;
use crate::cimport::drop_shadowed_imports;
use crate::ast::{KEEP_PARSED, NODES, NODE_COUNT, NodeKind, child, init_ast, keep_parsed};
use crate::parser::{ITEM_PUBLIC, parse_program};
use crate::modules::{
    C_MODULE, MODULES, STD_MODULE, child_module, file_of_pos, load_modules, module_at, module_count,
    module_of,
};
use crate::types::{
    CONSTS, ENUMS, FNS, METHODS, METHOD_COUNT, STATICS, STRUCTS, TYPES, TyKind, VARIANTS, init_declarations,
    init_types,
};
use crate::check::{GMETHODS, GMETHOD_COUNT, Res, check_program};
use crate::traits::impl_trait_node;
use crate::target::{T_X86_64_LINUX, set_target};
use crate::gen::MAIN_SYM;
use crate::lower::HMap;
use crate::{IMPORTED_START, host_target, import_c_headers, streq};
use crate::plan::{query_deps, query_impact, query_stats, query_unused};
use crate::query_text::{WITH_COMMENTS, all_files, infer_root, run_text, section_start, show_region, show_files};
use crate::edit::run_query_diff;

extern "C" {
    fn getenv(name: *u8) -> *u8;
}

// Set while a query runs: the hooks record what they resolve.
pub static mut QUERY: bool = false;

// Flags of a reference: a call, the definition itself, an import.
pub const QF_CALL: i64 = 1;
pub const QF_DEF: i64 = 2;
pub const QF_USE: i64 = 4;

// What the checker resolved that its nodes do not keep: (position the name
// is looked for from, the name written there, the definition's node,
// flags), in fours.
static mut NOTES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The name `name` written at (or just after) `from` stands for the item
// whose node is `def`.
pub fn qnote(from: i64, name: i64, def: i64, flags: i64) {
    if !QUERY || def <= 0 {
        return;
    }
    NOTES.push(from);
    NOTES.push(name);
    NOTES.push(def);
    NOTES.push(flags);
}

// ... for module m.
pub fn qnote_module(from: i64, name: i64, m: i64, flags: i64) {
    unsafe {
        if !QUERY || m < 0 || m >= MOD_DEF.count || MOD_DEF.data[m] < 0 {
            return;
        }
        qnote(from, name, DEFS[MOD_DEF.data[m]].node, flags);
    }
}

// ---- Definitions ----

pub const K_FN: i64 = 1;
// A function of an impl block (`impl T { ... }`).
pub const K_METHOD: i64 = 2;
// A function of an `impl Trait for T` block.
pub const K_IMPL_METHOD: i64 = 3;
// A function declared by a trait (with or without a default body).
pub const K_TRAIT_FN: i64 = 4;
pub const K_STRUCT: i64 = 5;
pub const K_ENUM: i64 = 6;
pub const K_VARIANT: i64 = 7;
pub const K_FIELD: i64 = 8;
pub const K_TRAIT: i64 = 9;
pub const K_CONST: i64 = 10;
pub const K_STATIC: i64 = 11;
pub const K_ALIAS: i64 = 12;
pub const K_MOD: i64 = 13;

pub fn kind_name(k: i64) -> *u8 {
    if k == K_FN { return c"fn"; }
    if k == K_METHOD || k == K_IMPL_METHOD { return c"method"; }
    if k == K_TRAIT_FN { return c"trait-method"; }
    if k == K_STRUCT { return c"struct"; }
    if k == K_ENUM { return c"enum"; }
    if k == K_VARIANT { return c"variant"; }
    if k == K_FIELD { return c"field"; }
    if k == K_TRAIT { return c"trait"; }
    if k == K_CONST { return c"const"; }
    if k == K_STATIC { return c"static"; }
    if k == K_ALIAS { return c"type"; }
    c"mod"
}

// A definition: its item node (as parsed), name, module, the definition
// it belongs to (a field's struct, a variant's enum, a function's trait;
// -1), the position of its name, whether it is `pub`; after the checker,
// its path (`fqn`), the path partial names are matched against (`path`:
// a trait impl's function as `Type::f`), the path of its type (`owner`,
// for functions of impl blocks) and of its trait (`tr`), as symbols.
pub struct Def {
    pub node: i64, pub kind: i64, pub name: i64, pub module: i64, pub parent: i64, pub start: i64,
    pub end: i64, pub name_pos: i64, pub public: bool, pub impl_node: i64,
    pub fqn: i64, pub path: i64, pub owner: i64, pub tr: i64,
}

pub static mut DEFS: *Def = 0 as *Def;
pub static mut DEF_COUNT: i64 = 0;
static mut DEF_CAP: i64 = 0;
// Definition + 1 by the start of its node + 1 (a copy of a node made for
// a generic instance starts where the node does).
static mut DEF_AT: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
// Per module: the definition of its `mod` item, or -1.
pub static mut MOD_DEF: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The names of `use p::x as y;`: (y, the position of x), in pairs.
static mut ALIASES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The first `import "h.h" as c;`: its module and name (-1: none).
static mut C_ALIAS_MODULE: i64 = -1;
static mut C_ALIAS: i64 = -1;

fn add_def(node: i64, kind: i64, name: i64, parent: i64) -> i64 {
    unsafe {
        DEFS = grow_defs();
        let d = DEF_COUNT;
        DEFS[d] = Def {
            node: node, kind: kind, name: name, module: module_of(node), parent: parent,
            start: NODES[node].start, end: NODES[node].end,
            name_pos: name_position(NODES[node].start, name), public: (NODES[node].p & ITEM_PUBLIC) != 0,
            impl_node: 0, fqn: -1, path: -1, owner: -1, tr: -1,
        };
        DEF_COUNT += 1;
        DEF_AT.put(NODES[node].start + 1, d + 1);
        d
    }
}

fn grow_defs() -> *Def {
    unsafe { grow(DEFS, DEF_COUNT, &DEF_CAP) }
}

// The definition whose node is n (or a copy of it), or -1.
pub fn def_of_node(n: i64) -> i64 {
    unsafe {
        if n <= 0 {
            return -1;
        }
        DEF_AT.get(NODES[n].start + 1) - 1
    }
}

// The definitions of the program's items, as parsed.
fn collect_defs(program: i64) {
    unsafe {
        for i in 0..NODES[program].count {
            let item = child(program, i);
            let kind = NODES[item].kind;
            let name = NODES[item].a;
            if kind == NodeKind::Fn {
                add_def(item, if NODES[item].h != 0 { K_METHOD } else { K_FN }, name, -1);
            } else if kind == NodeKind::ExternFn {
                add_def(item, K_FN, name, -1);
            } else if kind == NodeKind::Struct || kind == NodeKind::Enum || kind == NodeKind::Trait {
                let k = if kind == NodeKind::Struct { K_STRUCT } else if kind == NodeKind::Enum { K_ENUM } else { K_TRAIT };
                let d = add_def(item, k, name, -1);
                let sub = if kind == NodeKind::Struct { K_FIELD } else if kind == NodeKind::Enum { K_VARIANT } else { K_TRAIT_FN };
                for j in 0..NODES[item].count {
                    let c = child(item, j);
                    add_def(c, sub, NODES[c].a, d);
                }
            } else if kind == NodeKind::Const {
                add_def(item, K_CONST, name, -1);
            } else if kind == NodeKind::Static {
                add_def(item, K_STATIC, name, -1);
            } else if kind == NodeKind::TypeAlias {
                add_def(item, K_ALIAS, name, -1);
            } else if kind == NodeKind::Mod {
                add_def(item, K_MOD, name, -1);
            } else if kind == NodeKind::Use && NODES[item].d == 2 && NODES[item].a != 0 && C_ALIAS < 0 {
                C_ALIAS = NODES[item].a;
                C_ALIAS_MODULE = module_of(item);
            } else if kind == NodeKind::Use && NODES[item].d != 2 {
                for j in 0..NODES[item].count {
                    let id = child(item, j);
                    if NODES[id].b != 0 {
                        ALIASES.push(NODES[id].b);
                        ALIASES.push(NODES[id].start);
                    }
                }
            }
        }
        // The functions of trait impls (pushed before their Impl node).
        for i in 0..NODES[program].count {
            let item = child(program, i);
            if NODES[item].kind != NodeKind::Impl {
                continue;
            }
            for j in 0..NODES[item].count {
                let d = def_of_node(child(item, j));
                if d >= 0 {
                    DEFS[d].kind = K_IMPL_METHOD;
                    DEFS[d].impl_node = item;
                }
            }
        }
        for _ in 0..module_count() {
            MOD_DEF.push(-1);
        }
        for d in 0..DEF_COUNT {
            if DEFS[d].kind == K_MOD {
                let m = child_module(DEFS[d].module, DEFS[d].name);
                if m >= 0 {
                    MOD_DEF.data[m] = d;
                }
            }
        }
    }
}

// ---- Paths ----

// The path of module m: `crate`, `crate::a::b`, `std`, or for the C
// headers' declarations the name the first `import ... as c` gives them
// (`crate::c`).
static mut MOD_FQN: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

pub fn mod_fqn(m: i64) -> i64 {
    unsafe {
        while MOD_FQN.count < module_count() {
            MOD_FQN.push(-1);
        }
        if m < 0 || m >= MOD_FQN.count {
            return intern_c(c"crate");
        }
        if MOD_FQN.data[m] >= 0 {
            return MOD_FQN.data[m];
        }
        let mut s = 0;
        if m == 0 {
            s = intern_c(c"crate");
        } else if m == STD_MODULE {
            s = intern_c(c"std");
        } else if m == C_MODULE {
            s = if C_ALIAS >= 0 { join(mod_fqn(C_ALIAS_MODULE), c"::", C_ALIAS) } else { intern_c(c"c") };
        } else {
            s = join(mod_fqn(MODULES[m].parent), c"::", MODULES[m].name);
        }
        MOD_FQN.data[m] = s;
        s
    }
}

fn join(a: i64, sep: *u8, b: i64) -> i64 {
    unsafe {
        let out = buf_new();
        buf_bytes(out, SYMS[a].text);
        buf_str(out, sep);
        buf_bytes(out, SYMS[b].text);
        intern(buf_slice(out))
    }
}

// The text of node n's source, its whitespace collapsed.
fn node_text(n: i64) -> i64 {
    unsafe {
        let out = buf_new();
        collapse(out, NODES[n].start, NODES[n].end);
        intern(buf_slice(out))
    }
}

// The paths of the definitions, once the checker has resolved the types
// of the impl blocks and the traits of the trait impls.
fn finish_defs() {
    unsafe {
        // The type of each function of an impl block: its item node.
        let mut owners = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for i in 0..METHOD_COUNT {
            let t = METHODS[i].ty;
            let node = if TYPES[t].kind == TyKind::Struct {
                STRUCTS[TYPES[t].a].node
            } else if TYPES[t].kind == TyKind::Enum {
                ENUMS[TYPES[t].a].node
            } else {
                0
            };
            if node != 0 {
                owners.put(METHODS[i].f + 1, node);
            }
        }
        for i in 0..GMETHOD_COUNT {
            let tpl = GMETHODS[i].ty;
            owners.put(GMETHODS[i].f + 1, if tpl > 0 { STRUCTS[tpl - 1].node } else { ENUMS[-tpl - 1].node });
        }
        let mut trait_names = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for d in 0..DEF_COUNT {
            let k = DEFS[d].kind;
            if k == K_TRAIT {
                trait_names.put(DEFS[d].name + 1, trait_names.get(DEFS[d].name + 1) + 1);
            }
            if DEFS[d].parent >= 0 || k == K_METHOD || k == K_IMPL_METHOD {
                continue;
            }
            if k == K_MOD {
                let m = child_module(DEFS[d].module, DEFS[d].name);
                DEFS[d].fqn = if m >= 0 { mod_fqn(m) } else { join(mod_fqn(DEFS[d].module), c"::", DEFS[d].name) };
            } else {
                DEFS[d].fqn = join(mod_fqn(DEFS[d].module), c"::", DEFS[d].name);
            }
            DEFS[d].path = DEFS[d].fqn;
        }
        for d in 0..DEF_COUNT {
            let k = DEFS[d].kind;
            if DEFS[d].parent >= 0 {
                let p = DEFS[d].parent;
                DEFS[d].owner = DEFS[p].fqn;
                DEFS[d].fqn = join(DEFS[p].fqn, if k == K_FIELD { c"." } else { c"::" }, DEFS[d].name);
                DEFS[d].path = DEFS[d].fqn;
                continue;
            }
            if k != K_METHOD && k != K_IMPL_METHOD {
                continue;
            }
            let node = DEFS[d].node;
            let f = NODES[node].x - 1;
            let mut owner = -1;
            if f >= 0 {
                let od = def_of_node(owners.get(f + 1));
                if od >= 0 {
                    owner = DEFS[od].fqn;
                }
            }
            if owner < 0 {
                // (a builtin type, or an impl the checker left out)
                let h = NODES[node].h;
                owner = if NODES[h].kind == NodeKind::TyName { NODES[h].a } else { node_text(h) };
            }
            DEFS[d].owner = owner;
            DEFS[d].path = join(owner, c"::", DEFS[d].name);
            if k == K_METHOD {
                DEFS[d].fqn = DEFS[d].path;
                continue;
            }
            // `<Type as Trait>::f`: the trait by its name, or by its path
            // when two traits have that name.
            let mut tr = -1;
            let mut shown = -1;
            let td = if f >= 0 { def_of_node(impl_trait_node(f)) } else { -1 };
            if td >= 0 {
                tr = DEFS[td].fqn;
                shown = if trait_names.get(DEFS[td].name + 1) > 1 { DEFS[td].fqn } else { DEFS[td].name };
            } else {
                tr = node_text(NODES[DEFS[d].impl_node].a);
                shown = tr;
            }
            DEFS[d].tr = tr;
            let out = buf_new();
            buf_byte(out, '<');
            buf_bytes(out, SYMS[owner].text);
            buf_str(out, c" as ");
            buf_bytes(out, SYMS[shown].text);
            buf_str(out, c">::");
            buf_bytes(out, SYMS[DEFS[d].name].text);
            DEFS[d].fqn = intern(buf_slice(out));
        }
    }
}

// The trait definition of a trait impl's function, or -1.
pub fn trait_of(d: i64) -> i64 {
    unsafe {
        if DEFS[d].kind != K_IMPL_METHOD {
            return -1;
        }
        let f = NODES[DEFS[d].node].x - 1;
        if f < 0 { -1 } else { def_of_node(impl_trait_node(f)) }
    }
}

// ---- Matching names ----

pub fn bytes_eq(a: [u8], b: [u8]) -> bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

// Whether path p ends with name s, by whole segments (or s is `.field`).
pub fn ends_with(p: [u8], s: [u8], exact: bool) -> bool {
    if s.len == 0 || s.len > p.len {
        return false;
    }
    let k = p.len - s.len;
    for i in 0..s.len {
        if p[k + i] != s[i] {
            return false;
        }
    }
    if k == 0 {
        return true;
    }
    if exact {
        return false;
    }
    s[0] == '.' || (k >= 2 && p[k - 1] == ':' && p[k - 2] == ':')
}

// The index of `pat` in s at or after `from`, or -1.
pub fn find_in(s: [u8], pat: *u8, from: i64) -> i64 {
    let n = unsafe { strlen(pat) as i64 };
    let mut i = from;
    while i + n <= s.len {
        let mut ok = true;
        for j in 0..n {
            if unsafe { s[i + j] != pat[j] } {
                ok = false;
                break;
            }
        }
        if ok {
            return i;
        }
        i += 1;
    }
    -1
}

// Whether definition d answers to `name`.
fn name_matches(d: i64, name: [u8], exact: bool) -> bool {
    unsafe {
        let fqn = SYMS[DEFS[d].fqn].text;
        if bytes_eq(fqn, name) {
            return true;
        }
        if name.len > 0 && name[0] == '<' {
            // `<Type as Trait>::f`, each part full or partial.
            if DEFS[d].kind != K_IMPL_METHOD {
                return false;
            }
            let a = find_in(name, c" as ", 1);
            let b = find_in(name, c">::", 1);
            if a < 0 || b < a {
                return false;
            }
            return ends_with(SYMS[DEFS[d].owner].text, name[1..a], exact)
                && (ends_with(SYMS[DEFS[d].tr].text, name[a + 4..b], exact))
                && bytes_eq(SYMS[DEFS[d].name].text, name[b + 3..name.len]);
        }
        ends_with(SYMS[DEFS[d].path].text, name, exact)
    }
}

// The definitions answering to `name`, in order of position.
pub fn find_defs(name: [u8], exact: bool, out: *IntVec) {
    for d in 0..DEF_COUNT {
        if unsafe { DEFS[d].fqn >= 0 } && name_matches(d, name, exact) {
            out.push(d);
        }
    }
    sort_by_position(out);
}

// The last segment of a name (after `::`, `.` or `>::`).
pub fn last_segment(name: [u8]) -> [u8] {
    let mut i = name.len;
    while i > 0 && name[i - 1] != ':' && name[i - 1] != '.' {
        i -= 1;
    }
    name[i..name.len]
}

// ---- Diagnostics ----
//
// On stderr, for agents and scripts (docs/query.md):
//   <severity> <code>: <message>
//   try: <command>          (0-3 lines, best first, ready to run)
// The codes are stable: query.no-match, query.alias, query.ambiguous,
// query.no-root, query.bad-root, query.program-errors, query.truncated,
// query.empty, query.bad-in, query.usage.

// The command line as given: how the compiler was run (argv[0]), the
// command, ROOT when it was given, and the options.
pub static mut PROG: *u8 = 0 as *u8;
pub static mut CMD: *u8 = 0 as *u8;
pub static mut ROOT_GIVEN: *u8 = 0 as *u8;
pub static mut OPT_EXACT: bool = false;
// The diagnostics so far (written last, after the answer).
static mut DIAGS: i64 = -1;

pub fn diags() -> i64 {
    if DIAGS < 0 {
        DIAGS = buf_new();
    }
    DIAGS
}

// Starts a diagnostic: `<severity> <code>: `; its message follows.
pub fn diag(severity: *u8, code: *u8) -> i64 {
    unsafe {
        let out = diags();
        buf_str(out, severity);
        buf_byte(out, ' ');
        buf_str(out, code);
        buf_str(out, c": ");
        out
    }
}

// Whether s needs quoting for the shell.
fn needs_quotes(s: [u8]) -> bool {
    if s.len == 0 {
        return true;
    }
    for i in 0..s.len {
        let c = s[i];
        let plain = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
            || c == '_' || c == ':' || c == '.' || c == '/' || c == '-' || c == '+' || c == '=' || c == ',';
        if !plain {
            return true;
        }
    }
    false
}

// A word of a command: ` s`, quoted when the shell needs it.
pub fn put_word(out: i64, s: [u8]) {
    buf_byte(out, ' ');
    if needs_quotes(s) {
        buf_byte(out, '\'');
        buf_bytes(out, s);
        buf_byte(out, '\'');
    } else {
        buf_bytes(out, s);
    }
}

pub fn put_cword(out: i64, s: *u8) {
    unsafe { put_word(out, s[0..strlen(s) as i64]); }
}

// Whether cmd is a command of `query` (the others, `replace`, `fix`...,
// are commands of their own, or of `edit`: see TOOL).
fn is_query_command(cmd: *u8) -> bool {
    for i in 0..N_COMMANDS {
        if unsafe { streq(cmd, command_name(i)) } {
            return true;
        }
    }
    false
}

// The words before a command that is not query's (`edit` for `replace`,
// `insert --after`, `delete`; 0: none, the command is the first word).
pub static mut TOOL: *u8 = 0 as *u8;

// Starts a `try:` line: `try: PROG query CMD [NAME] [ROOT]` (NAME is a
// full path, or the one asked about: --exact is not needed), or `try:
// PROG [TOOL] CMD ...` for a command that is not query's;
// more words follow (put_word), then try_end.
pub fn try_begin(cmd: *u8, name: [u8], with_name: bool) -> i64 {
    unsafe {
        let out = diags();
        buf_str(out, c"try:");
        put_cword(out, PROG);
        if is_query_command(cmd) {
            buf_str(out, c" query ");
        } else if TOOL != 0 as *u8 {
            buf_byte(out, ' ');
            buf_str(out, TOOL);
            buf_byte(out, ' ');
        } else {
            buf_byte(out, ' ');
        }
        buf_str(out, cmd);
        if with_name {
            put_word(out, name);
        }
        put_root(out);
        out
    }
}

// ROOT as it was given (` ROOT`, or ` --root ROOT` when it does not end in
// .tach), for a command line.
pub fn put_root(out: i64) {
    unsafe {
        if ROOT_GIVEN != 0 as *u8 {
            if !ends_with_c(ROOT_GIVEN, c".tach") {
                buf_str(out, c" --root");
            }
            put_cword(out, ROOT_GIVEN);
        }
    }
}

pub fn try_end(out: i64) {
    buf_byte(out, '\n');
}

// `try: PROG query CMD NAME`.
pub fn try_query(cmd: *u8, name: [u8]) {
    try_end(try_begin(cmd, name, true));
}

pub fn write_diags() {
    if DIAGS >= 0 {
        buf_write_fd(DIAGS, STDERR);
        buf_clear(DIAGS);
    }
}

// The program had errors: their number (and, `first`, the first one), and
// how to see them all.
pub fn program_errors(severity: *u8, root: *u8, first: bool) {
    unsafe {
        if error_count() == 0 {
            return;
        }
        let out = diag(severity, c"query.program-errors");
        buf_int(out, error_count());
        buf_str(out, if error_count() == 1 { c" error" } else { c" errors" });
        buf_str(out, if PARSED { c" in the program; results may be incomplete" } else { c" in the program; nothing to answer with" });
        if first {
            buf_str(out, c"; first: ");
            first_error_short(out);
        }
        buf_str(out, c"\ntry:");
        put_cword(out, PROG);
        buf_str(out, c" --diagnostics=short");
        put_cword(out, root);
        buf_str(out, c" -c -o /dev/null\n");
    }
}

// The definitions nearest to `want` (its last segment), nearest first:
// at most `max`, in `found`.
fn nearest_defs(want: [u8], found: *IntVec, max: i64) {
    unsafe {
        let mut limit = want.len / 3;
        if limit < 1 {
            limit = 1;
        }
        let mut dist = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for d in 0..DEF_COUNT {
            if DEFS[d].fqn < 0 {
                continue;
            }
            let k = edit_distance(want, SYMS[DEFS[d].name].text);
            if k <= limit {
                all.push(d);
                dist.push(k);
            }
        }
        // (nearest first, then by path)
        for i in 1..all.count {
            let mut j = i;
            while j > 0 && (dist.data[j] < dist.data[j - 1] || (dist.data[j] == dist.data[j - 1]
                && sym_less(DEFS[all.data[j]].fqn, DEFS[all.data[j - 1]].fqn))) {
                let t = all.data[j];
                all.data[j] = all.data[j - 1];
                all.data[j - 1] = t;
                let u = dist.data[j];
                dist.data[j] = dist.data[j - 1];
                dist.data[j - 1] = u;
                j -= 1;
            }
        }
        for i in 0..all.count {
            if (*found).count >= max {
                return;
            }
            push_once(found, all.data[i]);
        }
    }
}

pub fn push_once(v: *IntVec, x: i64) {
    unsafe {
        for i in 0..(*v).count {
            if (*v).data[i] == x {
                return;
            }
        }
        v.push(x);
    }
}

// The `try:` lines of an unanswered NAME: the definitions in `found`,
// else the module listing that could hold it.
fn try_found(cmd: *u8, name: [u8], found: *IntVec) {
    unsafe {
        for i in 0..(*found).count {
            try_query(cmd, SYMS[DEFS[(*found).data[i]].fqn].text);
        }
        if (*found).count > 0 {
            return;
        }
        // `m::x`: the items of m, if there is such a module.
        let mut i = name.len - 1;
        while i > 0 && !(name[i] == ':' && name[i - 1] == ':') {
            i -= 1;
        }
        if i > 1 {
            let mut modules = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            find_modules(name[0..i - 1], false, &modules);
            if modules.count > 0 {
                try_query(c"items", SYMS[mod_fqn(modules.data[0])].text);
                return;
            }
        }
        try_end(try_begin(c"items", name, false));
    }
}

// No definition answers to `name`: what it is (an import's other name),
// and the nearest names.
pub fn no_match(cmd: *u8, name: [u8]) {
    unsafe {
        let want = last_segment(name);
        let mut found = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut alias_at = -1;
        // An import's other name: what it imports.
        let mut i = 0;
        while i < ALIASES.count {
            if bytes_eq(SYMS[ALIASES.data[i]].text, want) {
                let mut k = 0;
                while k < NOTES.count {
                    let d = def_of_node(NOTES.data[k + 2]);
                    if NOTES.data[k] == ALIASES.data[i + 1] && (NOTES.data[k + 3] & QF_USE) != 0 && d >= 0 {
                        push_once(&found, d);
                        if alias_at < 0 {
                            alias_at = NOTES.data[k];
                        }
                    }
                    k += 4;
                }
            }
            i += 2;
        }
        if alias_at >= 0 {
            let out = diag(c"error", c"query.alias");
            buf_byte(out, '\'');
            buf_bytes(out, want);
            buf_str(out, c"' is an import alias in ");
            buf_bytes(out, SYMS[mod_fqn(module_at(alias_at))].text);
            buf_byte(out, '\n');
        } else {
            let out = diag(c"error", c"query.no-match");
            buf_str(out, c"no definition '");
            buf_bytes(out, name);
            buf_str(out, c"'\n");
        }
        nearest_defs(want, &found, 3);
        try_found(cmd, name, &found);
    }
}

// No module answers to `name`.
pub fn no_module(name: [u8]) {
    unsafe {
        let out = diag(c"error", c"query.no-match");
        buf_str(out, c"no module '");
        buf_bytes(out, name);
        buf_str(out, c"'\n");
        let want = last_segment(name);
        let mut limit = want.len / 3;
        if limit < 1 {
            limit = 1;
        }
        let mut shown = 0;
        for m in 0..module_count() {
            if MODULES[m].name < 0 || shown >= 3 {
                continue;
            }
            if edit_distance(want, last_segment(SYMS[mod_fqn(m)].text)) <= limit {
                try_query(c"items", SYMS[mod_fqn(m)].text);
                shown += 1;
            }
        }
        if shown == 0 {
            try_end(try_begin(c"items", name, false));
        }
    }
}

pub fn sym_less(a: i64, b: i64) -> bool {
    unsafe {
        let x = SYMS[a].text;
        let y = SYMS[b].text;
        let n = if x.len < y.len { x.len } else { y.len };
        for i in 0..n {
            if x[i] != y[i] {
                return x[i] < y[i];
            }
        }
        x.len < y.len
    }
}

// ---- Positions ----

// The start of every line of SRC, in order.
static mut LINES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Per file, its rank in the output's order (by path; the files the
// compiler makes, `<std>` and `<C import>`, last).
static mut FILE_RANK: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn init_positions() {
    unsafe {
        let end = FILES[FILE_COUNT - 1].end;
        LINES.push(0);
        for i in 0..end {
            if SRC[i] == '\n' {
                LINES.push(i + 1);
            }
        }
        for f in 0..FILE_COUNT {
            let mut rank = 0;
            for g in 0..FILE_COUNT {
                if file_before(g, f) {
                    rank += 1;
                }
            }
            FILE_RANK.push(rank);
        }
    }
}

fn file_before(a: i64, b: i64) -> bool {
    unsafe {
        let x = FILES[a].path;
        let y = FILES[b].path;
        let xs = x[0] == '<';
        let ys = y[0] == '<';
        if xs != ys {
            return ys;
        }
        let mut i = 0;
        while x[i] != 0 && x[i] == y[i] {
            i += 1;
        }
        if x[i] != y[i] {
            return x[i] < y[i];
        }
        a < b
    }
}

// The index in LINES of the line holding pos.
pub fn line_index(pos: i64) -> i64 {
    unsafe {
        let mut lo = 0;
        let mut hi = LINES.count - 1;
        while lo < hi {
            let mid = (lo + hi + 1) / 2;
            if LINES.data[mid] <= pos {
                lo = mid;
            } else {
                hi = mid - 1;
            }
        }
        lo
    }
}

// The line number of pos in its file.
pub fn line_of(pos: i64) -> i64 {
    unsafe { line_index(pos) - line_index(FILES[file_of_pos(pos)].start) + 1 }
}

pub fn line_start(pos: i64) -> i64 {
    unsafe { LINES.data[line_index(pos)] }
}

// The end of the line holding pos (its newline).
pub fn line_end(pos: i64) -> i64 {
    unsafe {
        let i = line_index(pos);
        if i + 1 < LINES.count { LINES.data[i + 1] - 1 } else { FILES[FILE_COUNT - 1].end }
    }
}

pub fn put_path(out: i64, f: i64) {
    unsafe {
        let mut p = FILES[f].path;
        while p[0] == '.' && p[1] == '/' {
            p = &p[2];
        }
        buf_str(out, p);
    }
}

// `file:line:col`.
pub fn put_loc(out: i64, pos: i64) {
    put_path(out, file_of_pos(pos));
    buf_byte(out, ':');
    buf_int(out, line_of(pos));
    buf_byte(out, ':');
    buf_int(out, pos - line_start(pos) + 1);
}

pub fn is_space(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

// The text of from..to with each run of whitespace (and `//` comments)
// one space, trimmed.
pub fn collapse(out: i64, from: i64, to: i64) {
    unsafe {
        let mut space = false;
        let mut any = false;
        let mut i = from;
        while i < to {
            let c = SRC[i];
            if c == '/' && i + 1 < to && SRC[i + 1] == '/' {
                while i < to && SRC[i] != '\n' {
                    i += 1;
                }
                space = true;
                continue;
            }
            if is_space(c) {
                space = true;
            } else {
                if space && any {
                    buf_byte(out, ' ');
                }
                space = false;
                any = true;
                buf_byte(out, c);
            }
            i += 1;
        }
    }
}

// The first token starting at or after pos.
pub fn token_at(pos: i64) -> i64 {
    unsafe {
        let mut lo = 0;
        let mut hi = TOK_COUNT;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if TOKS[mid].start < pos {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        lo
    }
}

// Where identifier `name` is written in from..to (to < 0: in the next
// few tokens): its first occurrence, or its last; -1 if nowhere.
fn find_name(from: i64, to: i64, name: i64, last: bool) -> i64 {
    unsafe {
        let mut i = token_at(from);
        let mut seen = 0;
        let mut found = -1;
        while i < TOK_COUNT && TOKS[i].kind != Tok::Eof {
            if to >= 0 && TOKS[i].start >= to {
                break;
            }
            if to < 0 && seen > 24 {
                break;
            }
            if TOKS[i].kind == Tok::Ident && TOKS[i].value as i64 == name {
                found = TOKS[i].start;
                if !last {
                    return found;
                }
            }
            seen += 1;
            i += 1;
        }
        found
    }
}

// The position of definition name `name` after `start` (its keyword).
fn name_position(start: i64, name: i64) -> i64 {
    let p = find_name(start, -1, name, false);
    if p < 0 { start } else { p }
}

// ---- Sorting ----

// Sorts the indices in v (merge sort) by key1, then key2 (arrays indexed
// by the values).
pub fn sort_by_keys(v: *IntVec, key1: *i64, key2: *i64) {
    unsafe {
        let n = (*v).count;
        if n < 2 {
            return;
        }
        let tmp = alloc_array::<i64>(n);
        let mut width = 1;
        let a = (*v).data;
        while width < n {
            let mut lo = 0;
            while lo < n {
                let mid = if lo + width < n { lo + width } else { n };
                let hi = if lo + 2 * width < n { lo + 2 * width } else { n };
                let mut i = lo;
                let mut j = mid;
                let mut k = lo;
                while i < mid || j < hi {
                    let take_j = i >= mid || (j < hi && (key1[a[j]] < key1[a[i]]
                        || (key1[a[j]] == key1[a[i]] && key2[a[j]] < key2[a[i]])));
                    if take_j {
                        tmp[k] = a[j];
                        j += 1;
                    } else {
                        tmp[k] = a[i];
                        i += 1;
                    }
                    k += 1;
                }
                lo = hi;
            }
            for x in 0..n {
                a[x] = tmp[x];
            }
            width *= 2;
        }
        free(tmp as *u8);
    }
}

// The sort keys of positions: (file rank, position).
pub fn rank_of(pos: i64) -> i64 {
    unsafe { FILE_RANK.data[file_of_pos(pos)] }
}

// Sorts definitions by file, then position.
pub fn sort_by_position(v: *IntVec) {
    unsafe {
        let n = DEF_COUNT;
        let k1 = alloc_array::<i64>(n + 1);
        let k2 = alloc_array::<i64>(n + 1);
        for i in 0..(*v).count {
            let d = (*v).data[i];
            k1[d] = rank_of(DEFS[d].start);
            k2[d] = DEFS[d].start;
        }
        sort_by_keys(v, k1, k2);
    }
}

// ---- Enclosing definitions ----

// The definitions that hold code (all but fields, variants and modules),
// by position.
pub static mut CONTAINERS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn init_containers() {
    unsafe {
        for d in 0..DEF_COUNT {
            let k = DEFS[d].kind;
            if k != K_FIELD && k != K_VARIANT && k != K_MOD {
                CONTAINERS.push(d);
            }
        }
        let k1 = alloc_array::<i64>(DEF_COUNT + 1);
        let k2 = alloc_array::<i64>(DEF_COUNT + 1);
        for d in 0..DEF_COUNT {
            k1[d] = DEFS[d].start;
            k2[d] = -DEFS[d].end;
        }
        sort_by_keys(&CONTAINERS, k1, k2);
    }
}

// The innermost definition holding pos, or -1.
pub fn enclosing(pos: i64) -> i64 {
    unsafe {
        let mut lo = 0;
        let mut hi = CONTAINERS.count;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if DEFS[CONTAINERS.data[mid]].start <= pos {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        // (items do not overlap, except a trait and its functions: a few
        // steps back at most)
        let mut i = lo - 1;
        let mut steps = 0;
        while i >= 0 && steps < 64 {
            let d = CONTAINERS.data[i];
            if DEFS[d].end > pos {
                return d;
            }
            i -= 1;
            steps += 1;
        }
        -1
    }
}

// ---- References ----

// The definitions asked about: GROUP maps a definition + 1 to the group
// (the index in TARGETS) + 1 its references count for; a trait's function
// also counts those of the functions implementing it.
pub static mut TARGETS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut GROUP: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
// The references found: position, definition, group, flags.
pub static mut R_POS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut R_DEF: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut R_GROUP: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut R_FLAGS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

pub fn set_targets(matches: *IntVec) {
    unsafe {
        for i in 0..(*matches).count {
            let d = (*matches).data[i];
            TARGETS.push(d);
            GROUP.put(d + 1, i + 1);
        }
        for i in 0..(*matches).count {
            let t = (*matches).data[i];
            if DEFS[t].kind != K_TRAIT_FN {
                continue;
            }
            for d in 0..DEF_COUNT {
                if DEFS[d].kind == K_IMPL_METHOD && DEFS[d].name == DEFS[t].name && GROUP.get(d + 1) == 0
                    && trait_of(d) == DEFS[t].parent {
                    GROUP.put(d + 1, i + 1);
                }
            }
        }
    }
}

// A reference to the item of node `def` (or a copy of it), its name
// looked for in from..to (first or last occurrence; at `at` when it is
// not there).
fn add_ref(def: i64, from: i64, to: i64, name: i64, last: bool, at: i64, flags: i64) {
    unsafe {
        let d = def_of_node(def);
        if d < 0 {
            return;
        }
        let g = GROUP.get(d + 1) - 1;
        if g < 0 {
            return;
        }
        let mut pos = at;
        if name >= 0 {
            let p = find_name(from, to, name, last);
            if p >= 0 {
                pos = p;
            }
        }
        R_POS.push(pos);
        R_DEF.push(d);
        R_GROUP.push(g);
        R_FLAGS.push(flags);
    }
}

// Whether the token at pos is followed by `::` (a path, not a bare name).
fn path_at(pos: i64) -> bool {
    unsafe {
        let i = token_at(pos);
        i + 1 < TOK_COUNT && TOKS[i].start == pos && TOKS[i + 1].kind == Tok::ColonColon
    }
}

// A reference written as an identifier or a path (node n).
fn add_name_ref(def: i64, n: i64, flags: i64) {
    unsafe {
        let d = def_of_node(def);
        if d < 0 {
            return;
        }
        if path_at(NODES[n].start) {
            add_ref(def, NODES[n].start, NODES[n].end, DEFS[d].name, true, NODES[n].start, flags);
        } else {
            add_ref(def, NODES[n].start, NODES[n].end, -1, false, NODES[n].start, flags);
        }
    }
}

// The struct item of struct type t (through a pointer), or 0.
fn struct_node(t0: i64) -> i64 {
    unsafe {
        if t0 <= 0 {
            return 0;
        }
        let t = if TYPES[t0].kind == TyKind::Ptr { TYPES[t0].a } else { t0 };
        if t <= 0 || TYPES[t].kind != TyKind::Struct {
            return 0;
        }
        STRUCTS[TYPES[t].a].node
    }
}

// The field of struct item s at index i, if it is named `name`; or 0.
fn field_node(s: i64, i: i64, name: i64) -> i64 {
    unsafe {
        if s == 0 || i < 0 || i >= NODES[s].count || NODES[child(s, i)].a != name {
            return 0;
        }
        child(s, i)
    }
}

// The references the checked nodes record, and the ones the hooks noted.
pub fn collect_refs() {
    unsafe {
        for n in 1..NODE_COUNT {
            let kind = NODES[n].kind;
            if kind == NodeKind::Ident {
                let y = NODES[n].y;
                let res = NODES[n].res;
                if res == Res::Fn {
                    add_name_ref(FNS[y].node, n, 0);
                } else if res == Res::Const {
                    add_name_ref(CONSTS[y].node, n, 0);
                } else if res == Res::Static {
                    add_name_ref(STATICS[y].node, n, 0);
                }
            } else if kind == NodeKind::Call {
                if NODES[n].x <= 0 {
                    continue;
                }
                let f = NODES[n].x - 1;
                let callee = NODES[n].a;
                let def = FNS[f].node;
                if callee != 0 {
                    add_name_ref(def, callee, QF_CALL);
                } else if NODES[n].count > 0 {
                    // A method call: its name after the receiver (an
                    // operator's call: at the operation).
                    let recv = child(n, 0);
                    add_ref(def, NODES[recv].end, NODES[n].end, NODES[def].a, false, NODES[n].start, QF_CALL);
                }
            } else if kind == NodeKind::FieldAccess {
                if NODES[n].y == 2 {
                    continue;
                }
                let s = struct_node(NODES[NODES[n].a].ty);
                let field = field_node(s, NODES[n].x, NODES[n].b);
                if field != 0 {
                    add_ref(field, NODES[NODES[n].a].end, NODES[n].end, NODES[n].b, false, NODES[n].start, 0);
                }
            } else if kind == NodeKind::StructLit {
                let s = struct_node(NODES[n].ty);
                if s == 0 {
                    continue;
                }
                if NODES[n].a == NODES[s].a {
                    add_ref(s, NODES[n].start, NODES[n].end, NODES[n].a, false, NODES[n].start, 0);
                }
                for i in 0..NODES[n].count {
                    let init = child(n, i);
                    let field = field_node(s, NODES[init].x, NODES[init].a);
                    if field != 0 {
                        add_ref(field, NODES[init].start, -1, -1, false, NODES[init].start, 0);
                    }
                }
            } else if kind == NodeKind::VariantLit {
                let v = NODES[n].a;
                add_ref(VARIANTS[v].node, NODES[n].start, NODES[n].end, VARIANTS[v].name, false, NODES[n].start, 0);
            } else if kind == NodeKind::PatVariant {
                let v = NODES[n].x;
                if NODES[n].ty != 0 && v >= 0 && VARIANTS[v].name == NODES[n].b {
                    add_ref(VARIANTS[v].node, NODES[n].start, NODES[n].end, NODES[n].b, false, NODES[n].start, 0);
                }
            }
        }
        let mut i = 0;
        while i < NOTES.count {
            add_ref(NOTES.data[i + 2], NOTES.data[i], -1, NOTES.data[i + 1], false, NOTES.data[i], NOTES.data[i + 3]);
            i += 4;
        }
        // The definitions themselves.
        for d in 0..DEF_COUNT {
            if GROUP.get(d + 1) != 0 {
                add_ref(DEFS[d].node, DEFS[d].name_pos, -1, -1, false, DEFS[d].name_pos, QF_DEF);
            }
        }
    }
}

// The references in order (file, position, definition), each once: the
// indices into R_*, in `out`.
pub fn sorted_refs(out: *IntVec) {
    unsafe {
        let n = R_POS.count;
        let k1 = alloc_array::<i64>(n + 1);
        let k2 = alloc_array::<i64>(n + 1);
        let mut all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..n {
            all.push(i);
            k1[i] = rank_of(R_POS.data[i]) * 4294967296 + R_POS.data[i];
            k2[i] = R_DEF.data[i];
        }
        sort_by_keys(&all, k1, k2);
        let mut i = 0;
        while i < all.count {
            let r = all.data[i];
            let mut j = i + 1;
            while j < all.count && R_POS.data[all.data[j]] == R_POS.data[r] && R_DEF.data[all.data[j]] == R_DEF.data[r] {
                R_FLAGS.data[r] |= R_FLAGS.data[all.data[j]];
                j += 1;
            }
            out.push(r);
            i = j;
        }
    }
}

// Source lines longer than this are cut (with `…`).
const LINE_MAX: i64 = 100;

// The line holding pos, trimmed (and cut to LINE_MAX bytes).
pub fn put_line(out: i64, pos: i64) {
    unsafe {
        let mut a = line_start(pos);
        let mut b = line_end(pos);
        while a < b && is_space(SRC[a]) {
            a += 1;
        }
        while b > a && is_space(SRC[b - 1]) {
            b -= 1;
        }
        if b - a <= LINE_MAX {
            buf_bytes(out, SRC[a..b]);
            return;
        }
        // (not inside a UTF-8 sequence)
        let mut e = a + LINE_MAX - 1;
        while e > a && (SRC[e] & 192) == 128 {
            e -= 1;
        }
        buf_bytes(out, SRC[a..e]);
        buf_byte(out, 226 as u8);
        buf_byte(out, 128 as u8);
        buf_byte(out, 166 as u8);
    }
}

// A path without its `crate::` prefixes (`gvn::run_gvn`,
// `<geom::V2 as Add>::add`); `crate` stays.
pub fn put_short(out: i64, sym: i64) {
    unsafe {
        let p = SYMS[sym].text;
        let mut i = 0;
        while i < p.len {
            let start = i == 0 || p[i - 1] == '<' || p[i - 1] == ' ';
            if start && i + 7 <= p.len && p[i] == 'c' && p[i + 1] == 'r' && p[i + 2] == 'a' && p[i + 3] == 't'
                && p[i + 4] == 'e' && p[i + 5] == ':' && p[i + 6] == ':' {
                i += 7;
                continue;
            }
            buf_byte(out, p[i]);
            i += 1;
        }
    }
}

// More references than this: refs and callers print a summary per file
// (unless --limit or --all).
pub const REFS_BUDGET: i64 = 60;

// The options of refs and callers.
pub static mut OPT_COUNT: bool = false;
pub static mut OPT_ALL: bool = false;
pub static mut OPT_LIMIT: i64 = -1;
pub static mut OPT_IN: *u8 = 0 as *u8;
// --in: per file, per module, whether it is in.
pub static mut IN_FILE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut IN_MODULE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// --in FILE:LINE: the text of the item holding that line, [IN_START, IN_END).
pub static mut IN_START: i64 = -1;
pub static mut IN_END: i64 = -1;
pub static mut IN_NO_ITEM: bool = false;

// The path of file f as printed.
pub fn file_text(f: i64) -> [u8] {
    unsafe {
        let mut p = FILES[f].path;
        while p[0] == '.' && p[1] == '/' {
            p = &p[2];
        }
        p[0..strlen(p) as i64]
    }
}

// Resolves --in X: a file (X has a `/`, ends in `.tach` or is `<std>`;
// the path, or its end by whole components) or a module (matched like
// NAME, with its inline modules), or FILE:LINE (the item holding that
// line: ref_in; its file for the fixes by module). Whether anything
// matched.
pub fn resolve_in(x: [u8]) -> bool {
    unsafe {
        let mut any = false;
        for _ in 0..FILE_COUNT {
            IN_FILE.push(0);
        }
        for _ in 0..module_count() {
            IN_MODULE.push(0);
        }
        // (FILE:LINE: the item holding that line; its file for what works by
        // file or module)
        let a = trailing_number(x);
        if a > 0 && x[a - 1] == ':' && (a < 2 || x[a - 2] != ':') {
            let file = x[0..a - 1];
            for f in 0..FILE_COUNT {
                let p = file_text(f);
                if bytes_eq(p, file) || (p.len > file.len && bytes_eq(p[p.len - file.len..p.len], file)
                    && p[p.len - file.len - 1] == '/') {
                    let d = def_at_line(f, parse_digits(x[a..x.len]));
                    if d < 0 {
                        IN_NO_ITEM = true;
                        return false;
                    }
                    IN_START = text_start(d);
                    IN_END = DEFS[d].end;
                    IN_FILE.data[f] = 1;
                    return true;
                }
            }
            return false;
        }
        let is_file = x.len > 0 && (x[0] == '<' || find_in(x, c"/", 0) >= 0 || find_in(x, c".tach", 0) >= 0);
        if is_file {
            for f in 0..FILE_COUNT {
                let p = file_text(f);
                if bytes_eq(p, x) || (p.len > x.len && bytes_eq(p[p.len - x.len..p.len], x) && p[p.len - x.len - 1] == '/') {
                    IN_FILE.data[f] = 1;
                    any = true;
                }
            }
            return any;
        }
        let mut modules = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        find_modules(x, false, &modules);
        for i in 0..modules.count {
            IN_MODULE.data[modules.data[i]] = 1;
            any = true;
        }
        any
    }
}

// The message of a --in that resolve_in did not resolve (after `diag`):
// no such file or module, or (FILE:LINE) no item at that line.
pub fn put_bad_in(d: i64, x: *u8) {
    unsafe {
        if IN_NO_ITEM {
            buf_str(d, c"no item at ");
            buf_str(d, x);
            buf_byte(d, '\n');
            return;
        }
        buf_str(d, c"no file or module '");
        buf_str(d, x);
        buf_str(d, c"' in the program\n");
    }
}

// Whether the reference at pos passes --in.
pub fn ref_in(pos: i64) -> bool {
    unsafe {
        if OPT_IN == 0 as *u8 {
            return true;
        }
        if IN_START >= 0 {
            return pos >= IN_START && pos < IN_END;
        }
        if IN_FILE.data[file_of_pos(pos)] != 0 {
            return true;
        }
        let mut m = module_at(pos);
        while m >= 0 {
            if IN_MODULE.data[m] != 0 {
                return true;
            }
            m = if m > 0 { MODULES[m].parent } else { -1 };
        }
        false
    }
}

// A `try:` line for refs/callers with one more option (and its value),
// keeping --in unless the option is another --in.
fn try_refs(cmd: *u8, name: [u8], option: *u8, value: [u8]) {
    unsafe {
        let out = try_begin(cmd, name, true);
        if OPT_IN != 0 as *u8 && !streq(option, c"--in") {
            buf_str(out, c" --in");
            put_cword(out, OPT_IN);
        }
        buf_byte(out, ' ');
        buf_str(out, option);
        if value.len > 0 {
            put_word(out, value);
        }
        try_end(out);
    }
}

fn query_refs(matches: *IntVec, cmd: *u8, name: [u8]) -> i64 {
    unsafe {
        let calls_only = streq(cmd, c"callers");
        set_targets(matches);
        collect_refs();
        let mut order = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        sorted_refs(&order);
        let mut sel = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut multi = TARGETS.count > 1;
        for i in 0..order.count {
            let r = order.data[i];
            if calls_only && (R_FLAGS.data[r] & QF_CALL) == 0 {
                continue;
            }
            if !ref_in(R_POS.data[r]) {
                continue;
            }
            sel.push(r);
            if R_DEF.data[r] != TARGETS.data[R_GROUP.data[r]] {
                multi = true;
            }
        }
        let out = buf_new();
        let groups = TARGETS.count;
        if OPT_COUNT {
            if groups == 1 {
                buf_int(out, sel.count);
                buf_byte(out, '\n');
            } else {
                for g in 0..groups {
                    let mut n = 0;
                    for i in 0..sel.count {
                        if R_GROUP.data[sel.data[i]] == g {
                            n += 1;
                        }
                    }
                    buf_int(out, n);
                    buf_byte(out, '\t');
                    buf_bytes(out, SYMS[DEFS[TARGETS.data[g]].fqn].text);
                    buf_byte(out, '\n');
                }
            }
            buf_write_fd(out, STDOUT);
            return 0;
        }
        let noun = if calls_only { c"calls" } else { c"refs" };
        let total = sel.count;
        if total == 0 {
            let d = diag(c"note", c"query.empty");
            buf_str(d, c"0 ");
            buf_str(d, noun);
            if OPT_IN != 0 as *u8 {
                buf_str(d, c" in ");
                buf_str(d, OPT_IN);
            }
            buf_byte(d, '\n');
            return 0;
        }
        // Per file: the number of references (files in order).
        let mut files = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut per_file = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut biggest = -1;
        let mut biggest_n = 0;
        for i in 0..sel.count {
            let f = file_of_pos(R_POS.data[sel.data[i]]);
            if files.count == 0 || files.data[files.count - 1] != f {
                files.push(f);
                per_file.push(0);
            }
            per_file.data[per_file.count - 1] += 1;
            if per_file.data[per_file.count - 1] > biggest_n {
                biggest_n = per_file.data[per_file.count - 1];
                biggest = f;
            }
        }
        if OPT_LIMIT < 0 && !OPT_ALL && total > REFS_BUDGET {
            for i in 0..files.count {
                buf_bytes(out, file_text(files.data[i]));
                buf_byte(out, '\t');
                buf_int(out, per_file.data[i]);
                buf_byte(out, '\n');
            }
            buf_write_fd(out, STDOUT);
            let d = diag(c"note", c"query.truncated");
            buf_int(d, total);
            buf_byte(d, ' ');
            buf_str(d, noun);
            buf_str(d, c" in ");
            buf_int(d, files.count);
            buf_str(d, if files.count == 1 { c" file\n" } else { c" files\n" });
            if files.count > 1 {
                try_refs(cmd, name, c"--in", file_text(biggest));
            }
            try_refs(cmd, name, c"--limit 60", file_text(biggest)[0..0]);
            try_refs(cmd, name, c"--all", file_text(biggest)[0..0]);
            return 0;
        }
        let shown = if OPT_LIMIT >= 0 && OPT_LIMIT < total { OPT_LIMIT } else { total };
        let mut cur = -1;
        for i in 0..shown {
            let r = sel.data[i];
            let pos = R_POS.data[r];
            let d = R_DEF.data[r];
            let f = file_of_pos(pos);
            if f != cur {
                buf_str(out, c"# ");
                buf_bytes(out, file_text(f));
                buf_byte(out, '\n');
                cur = f;
            }
            buf_int(out, line_of(pos));
            buf_byte(out, ':');
            buf_int(out, pos - line_start(pos) + 1);
            buf_byte(out, '\t');
            if (R_FLAGS.data[r] & QF_DEF) != 0 {
                buf_str(out, c"def");
            } else {
                let e = enclosing(pos);
                put_short(out, if e >= 0 { DEFS[e].fqn } else { mod_fqn(module_at(pos)) });
            }
            if multi {
                buf_str(out, c"\t->");
                put_short(out, DEFS[d].fqn);
            }
            buf_byte(out, '\t');
            put_line(out, pos);
            buf_byte(out, '\n');
        }
        buf_write_fd(out, STDOUT);
        if shown < total {
            let d = diag(c"note", c"query.truncated");
            buf_str(d, c"showing ");
            buf_int(d, shown);
            buf_str(d, c" of ");
            buf_int(d, total);
            buf_byte(d, ' ');
            buf_str(d, noun);
            buf_byte(d, '\n');
            if files.count > 1 {
                try_refs(cmd, name, c"--in", file_text(biggest));
            }
            try_refs(cmd, name, c"--all", file_text(biggest)[0..0]);
        }
        0
    }
}

// ---- def, show, items ----

// The end of definition d's signature (before its body or its value).
pub fn signature_end(d: i64) -> i64 {
    unsafe {
        let node = DEFS[d].node;
        let k = DEFS[d].kind;
        if (k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN)
            && NODES[node].kind == NodeKind::Fn && NODES[node].c != 0 {
            return NODES[NODES[node].c].start;
        }
        if k == K_STRUCT || k == K_ENUM || k == K_TRAIT {
            let mut i = token_at(DEFS[d].name_pos);
            while i < TOK_COUNT && TOKS[i].kind != Tok::LBrace && TOKS[i].kind != Tok::Semi
                && TOKS[i].kind != Tok::Eof {
                i += 1;
            }
            return TOKS[i].start;
        }
        if k == K_MOD {
            return DEFS[d].name_pos + SYMS[DEFS[d].name].text.len;
        }
        let mut end = DEFS[d].end;
        while end > DEFS[d].start && (SRC[end - 1] == ';' || SRC[end - 1] == ',' || is_space(SRC[end - 1])) {
            end -= 1;
        }
        end
    }
}

const LONG_SIGNATURE: i64 = 120;

pub fn put_signature(out: i64, d: i64) {
    unsafe {
        if DEFS[d].public && DEFS[d].kind != K_IMPL_METHOD {
            buf_str(out, c"pub ");
        }
        let mark = buf_slice(out).len;
        collapse(out, DEFS[d].start, signature_end(d));
        let k = DEFS[d].kind;
        if (k == K_CONST || k == K_STATIC) && buf_slice(out).len - mark > LONG_SIGNATURE {
            // A long value: cut at its `=`.
            let text = buf_slice(out);
            let eq = find_in(text, c" = ", mark);
            if eq >= 0 {
                BUFS[out].len = eq;
                buf_str(out, c" = ...");
            }
        }
    }
}

fn query_def(matches: *IntVec) {
    unsafe {
        let out = buf_new();
        for i in 0..(*matches).count {
            query_def_one(out, (*matches).data[i]);
        }
        buf_write_fd(out, STDOUT);
    }
}

// `PATH<TAB>FILE:LINE:COL<TAB>KIND<TAB>SIGNATURE` of definition d.
pub fn query_def_one(out: i64, d: i64) {
    unsafe {
        buf_bytes(out, SYMS[DEFS[d].fqn].text);
        buf_byte(out, '\t');
        put_loc(out, DEFS[d].name_pos);
        buf_byte(out, '\t');
        buf_str(out, kind_name(DEFS[d].kind));
        buf_byte(out, '\t');
        put_signature(out, d);
        buf_byte(out, '\n');
    }
}

// The start of the first line of definition d's text: the line of its
// start, and the comment and attribute lines right above it.
pub fn text_start(d: i64) -> i64 {
    unsafe {
        let mut first = line_start(DEFS[d].start);
        let file_start = FILES[file_of_pos(first)].start;
        while first > file_start {
            let prev = line_start(first - 1);
            let mut a = prev;
            while a < first - 1 && (SRC[a] == ' ' || SRC[a] == '\t') {
                a += 1;
            }
            let comment = a + 1 < first && SRC[a] == '/' && SRC[a + 1] == '/';
            let attribute = a + 1 < first && SRC[a] == '#' && SRC[a + 1] == '[';
            if !comment && !attribute {
                break;
            }
            first = prev;
        }
        first
    }
}

// More matches than this: `show` lists their paths only.
const SHOW_MAX: i64 = 5;

fn query_show(matches: *IntVec, name: [u8]) -> i64 {
    unsafe {
        let out = buf_new();
        let n = (*matches).count;
        if n > SHOW_MAX {
            for i in 0..n {
                buf_bytes(out, SYMS[DEFS[(*matches).data[i]].fqn].text);
                buf_byte(out, '\n');
            }
            buf_write_fd(out, STDOUT);
            let d = diag(c"error", c"query.ambiguous");
            buf_int(d, n);
            buf_str(d, c" definitions match '");
            buf_bytes(d, name);
            buf_str(d, c"'; showing paths only\n");
            try_query(c"show", SYMS[DEFS[(*matches).data[0]].fqn].text);
            return 1;
        }
        for i in 0..n {
            let d = (*matches).data[i];
            let first = section_start(text_start(d));
            let last = line_end(if DEFS[d].end > DEFS[d].start { DEFS[d].end - 1 } else { DEFS[d].start });
            buf_str(out, c"// ");
            buf_bytes(out, SYMS[DEFS[d].fqn].text);
            buf_byte(out, '\t');
            put_path(out, file_of_pos(first));
            buf_byte(out, ':');
            buf_int(out, line_of(first));
            buf_byte(out, '-');
            buf_int(out, line_of(last));
            buf_byte(out, '\n');
            buf_bytes(out, SRC[first..last]);
            buf_byte(out, '\n');
        }
        buf_write_fd(out, STDOUT);
        0
    }
}

// The modules answering to `name` (all of them for none), in `out`.
pub fn find_modules(name: [u8], exact: bool, out: *IntVec) {
    unsafe {
        for m in 0..module_count() {
            if MODULES[m].name < 0 && m != 0 {
                continue;
            }
            let fqn = SYMS[mod_fqn(m)].text;
            if name.len == 0 || bytes_eq(fqn, name) || ends_with(fqn, name, exact) {
                out.push(m);
            }
        }
    }
}

// The module tree: each module's path, file and number of items.
fn query_modules() {
    unsafe {
        let out = buf_new();
        let mut all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        find_modules(SYMS[intern_c(c"")].text, false, &all);
        for i in 0..all.count {
            let m = all.data[i];
            let mut items = 0;
            let mut first = -1;
            for d in 0..DEF_COUNT {
                if DEFS[d].module == m && DEFS[d].parent < 0 {
                    items += 1;
                    if first < 0 {
                        first = d;
                    }
                }
            }
            buf_bytes(out, SYMS[mod_fqn(m)].text);
            buf_byte(out, '\t');
            let f = module_file(m);
            if f >= 0 {
                put_path(out, f);
            }
            buf_byte(out, '\t');
            buf_int(out, items);
            buf_byte(out, '\n');
        }
        buf_write_fd(out, STDOUT);
    }
}

// The file of module m (an inline module's is its parent's), or -1.
pub fn module_file(m: i64) -> i64 {
    unsafe {
        for f in 0..FILE_COUNT {
            if FILES[f].module == m {
                return f;
            }
        }
        if m > 0 && MODULES[m].parent >= 0 { module_file(MODULES[m].parent) } else { -1 }
    }
}

// The `impl ... {` header of the impl block of function definition d.
fn put_impl_header(out: i64, d: i64) {
    unsafe {
        let node = DEFS[d].node;
        let mut from = 0;
        if DEFS[d].impl_node != 0 {
            from = NODES[DEFS[d].impl_node].start;
        } else {
            let mut i = token_at(NODES[NODES[node].h].start) - 1;
            while i > 0 && TOKS[i].kind != Tok::Impl {
                i -= 1;
            }
            from = TOKS[i].start;
        }
        let mut j = token_at(from);
        while j < TOK_COUNT && TOKS[j].kind != Tok::LBrace && TOKS[j].kind != Tok::Eof {
            j += 1;
        }
        buf_int(out, line_of(from));
        buf_str(out, c"\timpl\t");
        collapse(out, from, TOKS[j].start);
        buf_byte(out, '\n');
    }
}

fn query_items(modules: *IntVec) {
    unsafe {
        let out = buf_new();
        let mut all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for d in 0..DEF_COUNT {
            all.push(d);
        }
        sort_by_position(&all);
        for i in 0..(*modules).count {
            let m = (*modules).data[i];
            buf_str(out, c"# ");
            buf_bytes(out, SYMS[mod_fqn(m)].text);
            let f = module_file(m);
            if f >= 0 {
                buf_byte(out, '\t');
                put_path(out, f);
            }
            buf_byte(out, '\n');
            let mut impl_of = -1;
            for j in 0..all.count {
                let d = all.data[j];
                if DEFS[d].module != m || DEFS[d].parent >= 0 {
                    continue;
                }
                let k = DEFS[d].kind;
                if k == K_METHOD || k == K_IMPL_METHOD {
                    // (the functions of one impl block share its type node)
                    let block = if DEFS[d].impl_node != 0 { DEFS[d].impl_node } else { NODES[DEFS[d].node].h };
                    if block != impl_of {
                        put_impl_header(out, d);
                        impl_of = block;
                    }
                } else {
                    impl_of = -1;
                }
                buf_int(out, line_of(DEFS[d].name_pos));
                buf_byte(out, '\t');
                buf_str(out, kind_name(k));
                buf_byte(out, '\t');
                put_signature(out, d);
                buf_byte(out, '\n');
            }
        }
        buf_write_fd(out, STDOUT);
    }
}

// ---- The command line ----

pub fn ends_with_c(s: *u8, suffix: *u8) -> bool {
    unsafe {
        let n = strlen(s) as i64;
        let k = strlen(suffix) as i64;
        n >= k && streq(&s[n - k], suffix)
    }
}

// The program's root: ROOT, else $TACHYON_ROOT, ./main.tach or
// ./compiler/src/main.tach; 0 when there is none.
pub fn find_root(given: *u8) -> *u8 {
    unsafe {
        if given != 0 as *u8 {
            return given;
        }
        let env = getenv(c"TACHYON_ROOT");
        if env != 0 as *u8 && env[0] != 0 {
            return env;
        }
        if file_exists(c"main.tach") {
            return c"main.tach";
        }
        if file_exists(c"compiler/src/main.tach") {
            return c"compiler/src/main.tach";
        }
        0 as *u8
    }
}

// The root of a command's program (given, or found), or 0 after the
// diagnostic saying why there is none (the command then exits with 2);
// `cmd` and `name` make its `try:` line.
pub fn root_or_diag(given: *u8, cmd: *u8, name: [u8], with_name: bool) -> *u8 {
    unsafe {
        let root = find_root(given);
        if root == 0 as *u8 {
            let out = diag(c"error", c"query.no-root");
            buf_str(out, c"no root (TACHYON_ROOT, ./main.tach, ./compiler/src/main.tach)\n");
            ROOT_GIVEN = c"path/to/main.tach";
            try_end(try_begin(cmd, name, with_name));
            return 0 as *u8;
        }
        if !file_exists(root) {
            let out = diag(c"error", c"query.bad-root");
            buf_str(out, c"cannot read '");
            buf_str(out, root);
            buf_str(out, c"'\n");
            ROOT_GIVEN = 0 as *u8;
            if find_root(0 as *u8) != 0 as *u8 {
                try_end(try_begin(cmd, name, with_name));
            }
            return 0 as *u8;
        }
        root
    }
}

// The front end, up to the checked program, for `target` (0: the host);
// an error that would end the compilation jumps back to the caller's
// ERR_BAIL.
pub fn front_end(root: *u8, target0: i64) {
    unsafe {
        ERR_KIND = c"tokenizer error";
        let paths = alloc_array::<*u8>(1);
        paths[0] = root;
        load_sources(paths, 1);
        init_lexer();
        lex_range(FILES[0].start, FILES[0].end, false);
        ERR_KIND = c"module error";
        load_modules();
        ERR_KIND = c"tokenizer error";
        let mut target = target0;
        if target == 0 {
            target = host_target();
        }
        if target == 0 {
            target = T_X86_64_LINUX;
        }
        set_target(target);
        let dirs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        import_c_headers(target, &dirs, false, c"");
        lex_range(FILES[FILE_COUNT - 1].end, FILES[FILE_COUNT - 1].end, true);
        init_ast();
        ERR_KIND = c"parser error";
        let program = parse_program();
        if KEEP_PARSED {
            keep_parsed();
        }
        if IMPORTED_START >= 0 {
            drop_shadowed_imports(program);
        }
        collect_defs(program);
        PARSED = true;
        MAIN_SYM = intern_c(c"main");
        init_types();
        init_declarations();
        ERR_KIND = c"type error";
        check_program(program);
    }
}

// Whether the program was parsed (the definitions are known).
pub static mut PARSED: bool = false;

// Reads the program of `root` for a question or a change (0.11): its front
// end, as far as it gets (its errors are recorded, never printed), then
// the paths and positions of its definitions; the hooks note what they
// resolve (refs). Whether the program was parsed: when not, there is
// nothing to answer with.
pub fn load_program(root: *u8, target: i64) -> bool {
    unsafe {
        QUERY = true;
        ERR_BAIL = alloc_zeroed(512);
        if _setjmp(ERR_BAIL) == 0 {
            front_end(root, target);
        }
        RECOVER_DEPTH = 0;
        ERR_BAIL = 0 as *u8;
        QUERY = false;
        if !PARSED {
            return false;
        }
        init_positions();
        finish_defs();
        init_containers();
        true
    }
}

// The commands, for `--help` and the nearest command to a misspelt one.
fn put_usage(out: i64) {
    unsafe {
        buf_str(out, c"usage: tachyonc query def|show NAME... [--root ROOT] [--exact] [--with-comments]\n");
        buf_str(out, c"       tachyonc query show FILE.tach | MODULE::use | MODULE::header | MODULE::extern\n");
        buf_str(out, c"       tachyonc query text FILE[:A[-B]]...\n");
        buf_str(out, c"       tachyonc query diff\n");
        buf_str(out, c"       tachyonc query refs|callers NAME... [--exact] [--count] [--in FILE|MODULE] [--limit N] [--all]\n");
        buf_str(out, c"       tachyonc query items [MODULE...]\n");
        buf_str(out, c"       tachyonc query stats [MODULE|FILE] [--over N] [--all]\n");
        buf_str(out, c"       tachyonc query deps MODULE [--max-lines N]\n");
        buf_str(out, c"       tachyonc query unused [MODULE] [--all]\n");
        buf_str(out, c"       tachyonc query impact NAME\n");
        buf_str(out, c"NAME: a path or its end (f, m::f, T::f, T.field), or FILE:LINE\n");
        buf_str(out, c"ROOT: --root ROOT, a last argument ending in .tach, $TACHYON_ROOT, ./main.tach, ./compiler/src/main.tach\n");
        buf_str(out, c"see docs/query.md and docs/refactor.md\n");
    }
}

// A usage error: `error query.usage: <message>`; the caller writes the
// message, then its `try:` lines.
fn usage_error() -> i64 {
    unsafe { diag(c"error", c"query.usage") }
}

const N_COMMANDS: i64 = 11;

fn command_name(i: i64) -> *u8 {
    if i == 0 { c"def" } else if i == 1 { c"show" } else if i == 2 { c"refs" } else if i == 3 { c"callers" }
    else if i == 4 { c"items" } else if i == 5 { c"stats" } else if i == 6 { c"deps" } else if i == 7 { c"unused" }
    else if i == 8 { c"impact" } else if i == 9 { c"text" } else { c"diff" }
}

// The command nearest to cmd (edit distance at most 2), or 0.
fn nearest_command(cmd: *u8) -> *u8 {
    unsafe {
        let want = cmd[0..strlen(cmd) as i64];
        let mut best = 0 as *u8;
        let mut best_d = 3;
        for i in 0..N_COMMANDS {
            let c = command_name(i);
            let d = edit_distance(want, c[0..strlen(c) as i64]);
            if d < best_d {
                best = c;
                best_d = d;
            }
        }
        best
    }
}

pub fn c_slice(s: *u8) -> [u8] {
    unsafe { s[0..strlen(s) as i64] }
}

// A decimal number (all of s), or -1.
pub fn parse_count(s: *u8) -> i64 {
    unsafe {
        let mut n = 0;
        let mut j = 0;
        while s[j] >= '0' && s[j] <= '9' {
            n = n * 10 + (s[j] - '0') as i64;
            j += 1;
        }
        if j == 0 || s[j] != 0 { -1 } else { n }
    }
}

// The options of stats and deps (0.11).
pub static mut OPT_OVER: i64 = 1000;
pub static mut OPT_MAX_LINES: i64 = 1000;

pub fn run_query(argc: i64, argv: **u8) -> i64 {
    let status = run_query_inner(argc, argv);
    write_diags();
    status
}

fn run_query_inner(argc: i64, argv: **u8) -> i64 {
    unsafe {
        PROG = argv[0];
        if argc < 3 {
            let out = usage_error();
            buf_str(out, c"no command\n");
            try_end(try_begin(c"items", c_slice(c""), false));
            return 2;
        }
        let cmd = argv[2];
        CMD = cmd;
        if streq(cmd, c"--help") || streq(cmd, c"-h") || streq(cmd, c"help") {
            let out = buf_new();
            put_usage(out);
            buf_write_fd(out, STDOUT);
            return 0;
        }
        let mut args = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut bad = 0 as *u8;
        let mut bad_value = false;
        let mut root = 0 as *u8;
        let mut i = 3;
        while i < argc {
            let a = argv[i];
            let valued = streq(a, c"--in") || streq(a, c"--limit") || streq(a, c"--root") || streq(a, c"--over")
                || streq(a, c"--max-lines");
            if streq(a, c"--count") {
                OPT_COUNT = true;
            } else if streq(a, c"--exact") {
                OPT_EXACT = true;
            } else if streq(a, c"--all") {
                OPT_ALL = true;
            } else if streq(a, c"--with-comments") {
                WITH_COMMENTS = true;
            } else if valued {
                if i + 1 >= argc || argv[i + 1][0] == '-' {
                    bad = a;
                    bad_value = true;
                } else if streq(a, c"--in") {
                    OPT_IN = argv[i + 1];
                    i += 1;
                } else if streq(a, c"--root") {
                    root = argv[i + 1];
                    i += 1;
                } else {
                    let n = parse_count(argv[i + 1]);
                    if n < 0 {
                        bad = a;
                        bad_value = true;
                    } else if streq(a, c"--limit") {
                        OPT_LIMIT = n;
                    } else if streq(a, c"--over") {
                        OPT_OVER = n;
                    } else {
                        OPT_MAX_LINES = n;
                    }
                    i += 1;
                }
            } else if a[0] == '-' && a[1] == '-' {
                bad = a;
            } else {
                args.push(a as i64);
            }
            i += 1;
        }
        let items = streq(cmd, c"items");
        let is_refs = streq(cmd, c"refs") || streq(cmd, c"callers");
        if !is_query_command(cmd) {
            let out = usage_error();
            buf_str(out, c"unknown command '");
            buf_str(out, cmd);
            buf_str(out, c"'\n");
            let near = nearest_command(cmd);
            if near != 0 as *u8 && args.count >= 1 {
                try_query(near, c_slice(args.data[0] as *u8));
            } else if args.count >= 1 {
                try_query(c"def", c_slice(args.data[0] as *u8));
            } else {
                try_end(try_begin(c"items", c_slice(c""), false));
            }
            return 2;
        }
        // Text (0.12, query_text.tach): no program read.
        if streq(cmd, c"text") {
            return run_text(&args);
        }
        if streq(cmd, c"show") && root == 0 as *u8 && all_files(&args) {
            return show_files(&args);
        }
        if streq(cmd, c"diff") {
            return run_query_diff(root);
        }
        // ROOT: --root, else a last argument ending in .tach after the
        // NAMEs (or alone, for items: its MODULE is optional; for stats
        // and unused a lone FILE.tach is a file of the program).
        if root == 0 as *u8 && args.count >= 1 && ends_with_c(args.data[args.count - 1] as *u8, c".tach")
            && (args.count >= 2 || items) {
            args.count -= 1;
            root = args.data[args.count] as *u8;
        }
        ROOT_GIVEN = root;
        let needs_name = !items && !streq(cmd, c"unused") && !streq(cmd, c"stats");
        let single = streq(cmd, c"deps") || streq(cmd, c"impact") || streq(cmd, c"stats") || streq(cmd, c"unused");
        let first = if args.count == 0 { c_slice(c"") } else { c_slice(args.data[0] as *u8) };
        if needs_name && args.count == 0 {
            let out = usage_error();
            buf_str(out, cmd);
            if streq(cmd, c"deps") {
                buf_str(out, c" needs a MODULE\n");
            } else {
                buf_str(out, c" needs a NAME (a path or its end: f, m::f, T::f, T.field; or FILE:LINE)\n");
            }
            try_end(try_begin(c"items", first, false));
            return 2;
        }
        let mut extra = if single && args.count > 1 { args.data[1] as *u8 } else { 0 as *u8 };
        // (`NAME ROOT EXTRA...`: the old form, with an argument too many)
        for k in 0..args.count - 1 {
            if root == 0 as *u8 && extra == 0 as *u8 && ends_with_c(args.data[k] as *u8, c".tach") {
                ROOT_GIVEN = args.data[k] as *u8;
                extra = args.data[k + 1] as *u8;
            }
        }
        if bad != 0 as *u8 || extra != 0 as *u8 {
            let out = usage_error();
            if bad != 0 as *u8 && bad_value {
                buf_str(out, bad);
                buf_str(out, if streq(bad, c"--in") { c" needs a FILE or MODULE\n" } else if streq(bad, c"--root") { c" needs a root file\n" } else { c" needs a number\n" });
            } else if bad != 0 as *u8 {
                buf_str(out, c"unknown option '");
                buf_str(out, bad);
                buf_str(out, c"'\n");
            } else {
                buf_str(out, c"unexpected argument '");
                buf_str(out, extra);
                buf_str(out, c"'\n");
            }
            if bad != 0 as *u8 && bad_value && streq(bad, c"--limit") {
                try_refs(cmd, first, c"--limit 60", c_slice(c""));
            } else {
                try_end(try_begin(cmd, first, args.count > 0));
            }
            return 2;
        }
        if root == 0 as *u8 {
            root = infer_root(&args);
        }
        root = root_or_diag(root, cmd, first, args.count > 0);
        if root == 0 as *u8 {
            return 2;
        }
        if !load_program(root, 0) {
            // (nothing to answer with: the errors say why)
            program_errors(c"error", root, true);
            return 1;
        }
        let status = answer(cmd, &args, items, is_refs);
        program_errors(c"warning", root, status != 0);
        status
    }
}

// The definitions answering to NAME, in order of position (none: after
// the diagnostic saying so, for command cmd). NAME is a path, or its end
// (see name_matches), or `FILE:LINE` (`FILE:LINE:COL`, as a compiler's
// error has it): the innermost item whose text holds that line.
pub fn resolve_name(cmd: *u8, name: [u8], out: *IntVec) -> bool {
    unsafe {
        let mut line = -1;
        let mut file = name[0..0];
        let a = trailing_number(name);
        if a > 0 && name[a - 1] == ':' && (a < 2 || name[a - 2] != ':') {
            line = parse_digits(name[a..name.len]);
            file = name[0..a - 1];
            let b = trailing_number(file);
            if b > 0 && file[b - 1] == ':' && (b < 2 || file[b - 2] != ':') {
                // (FILE:LINE:COL)
                line = parse_digits(file[b..file.len]);
                file = file[0..b - 1];
            }
        }
        if line < 0 {
            find_defs(name, OPT_EXACT, out);
            if (*out).count == 0 {
                no_match(cmd, name);
                return false;
            }
            return true;
        }
        let mut f = -1;
        for g in 0..FILE_COUNT {
            let p = file_text(g);
            if bytes_eq(p, file) || (p.len > file.len && bytes_eq(p[p.len - file.len..p.len], file) && p[p.len - file.len - 1] == '/') {
                f = g;
                break;
            }
        }
        if f < 0 {
            let d = diag(c"error", c"query.no-match");
            buf_str(d, c"no file '");
            buf_bytes(d, file);
            buf_str(d, c"' in the program\n");
            try_end(try_begin(c"items", name[0..0], false));
            return false;
        }
        let d = def_at_line(f, line);
        if d < 0 {
            let e = diag(c"error", c"query.no-match");
            buf_str(e, c"no item at ");
            buf_bytes(e, name);
            buf_byte(e, '\n');
            try_query(c"items", SYMS[mod_fqn(FILES[f].module)].text);
            return false;
        }
        out.push(d);
        true
    }
}

// The start of the run of digits that ends s (s.len: none).
fn trailing_number(s: [u8]) -> i64 {
    let mut i = s.len;
    while i > 0 && s[i - 1] >= '0' && s[i - 1] <= '9' {
        i -= 1;
    }
    if i == s.len { -1 } else { i }
}

fn parse_digits(s: [u8]) -> i64 {
    let mut n = 0;
    for i in 0..s.len {
        n = n * 10 + (s[i] - '0') as i64;
    }
    n
}

// The innermost definition (not a field or variant) of file f whose text
// (its comments and attributes included) holds line `line`, or -1.
pub fn def_at_line(f: i64, line: i64) -> i64 {
    unsafe {
        let idx = line_index(FILES[f].start) + line - 1;
        if line < 1 || idx >= LINES.count || LINES.data[idx] >= FILES[f].end + 1 {
            return -1;
        }
        let mut pos = LINES.data[idx];
        while pos < FILES[f].end && (SRC[pos] == ' ' || SRC[pos] == '\t') {
            pos += 1;
        }
        let mut best = -1;
        let mut best_size = 0;
        for d in 0..DEF_COUNT {
            let k = DEFS[d].kind;
            if k == K_FIELD || k == K_VARIANT || DEFS[d].start < FILES[f].start || DEFS[d].start >= FILES[f].end {
                continue;
            }
            if pos >= DEFS[d].end || pos < line_start(DEFS[d].start) {
                continue;
            }
            let from = text_start(d);
            if pos < from {
                continue;
            }
            if best < 0 || DEFS[d].end - from < best_size {
                best = d;
                best_size = DEFS[d].end - from;
            }
        }
        best
    }
}

// The answer to the command, once the program is known; the NAMEs (or
// MODULEs) are `args`.
fn answer(cmd: *u8, args: *IntVec, items: bool, is_refs: bool) -> i64 {
    unsafe {
        let n = (*args).count;
        if items {
            if n == 0 {
                query_modules();
                return 0;
            }
            let mut modules = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            let mut status = 0;
            for i in 0..n {
                let text = c_slice((*args).data[i] as *u8);
                let before = modules.count;
                find_modules(text, OPT_EXACT, &modules);
                if modules.count == before {
                    no_module(text);
                    status = 1;
                }
            }
            query_items(&modules);
            return status;
        }
        if streq(cmd, c"stats") {
            return query_stats(if n == 0 { 0 as *u8 } else { (*args).data[0] as *u8 });
        }
        if streq(cmd, c"deps") {
            return query_deps(c_slice((*args).data[0] as *u8));
        }
        if streq(cmd, c"unused") {
            return query_unused(if n == 0 { 0 as *u8 } else { (*args).data[0] as *u8 });
        }
        if is_refs {
            if OPT_IN != 0 as *u8 && !resolve_in(c_slice(OPT_IN)) {
                let out = diag(c"error", c"query.bad-in");
                put_bad_in(out, OPT_IN);
                try_end(try_begin(cmd, c_slice((*args).data[0] as *u8), true));
                return 1;
            }
        }
        let mut status = 0;
        let mut all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..n {
            let text = c_slice((*args).data[i] as *u8);
            if streq(cmd, c"show") {
                // (MODULE::use, ::header, ::extern)
                let r = show_region(text);
                if r >= 0 {
                    if r != 0 {
                        status = 1;
                    }
                    continue;
                }
            }
            let mut matches = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            if !resolve_name(cmd, text, &matches) {
                status = 1;
                continue;
            }
            if is_refs {
                for j in 0..matches.count {
                    push_once(&all, matches.data[j]);
                }
            } else if streq(cmd, c"impact") {
                status = query_impact(&matches, text);
            } else if streq(cmd, c"show") {
                if query_show(&matches, text) != 0 {
                    status = 1;
                }
            } else {
                query_def(&matches);
            }
        }
        if is_refs && all.count > 0 {
            sort_by_position(&all);
            let name = c_slice((*args).data[0] as *u8);
            if query_refs(&all, cmd, name) != 0 {
                status = 1;
            }
        }
        status
    }
}
