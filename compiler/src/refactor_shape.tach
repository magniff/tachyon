// The refactorings that change a definition's shape (0.11, phase 2;
// docs/refactor.md), each one atomic edit (edit.tach) of the definition
// and of every use the checker resolved:
//
//   refactor signature FN --add 'x: T = VALUE' [--at N] | --remove x
//            | --rename-param a b | --reorder b,a,c | --type x T
//       the function (with a trait's function: the trait's declaration
//       and every impl's) and its calls (`f(..)`, `x.f(..)`, `T::f(..)`,
//       in generic instances too); a function used as a value is refused
//       for a change of its type
//   refactor field STRUCT --add 'g: T = VALUE' | --remove g | --rename g h
//            | --type g T
//       the struct, its literals, its field accesses
//   refactor variant ENUM --add 'X(T)' [--arm EXPR] | --remove V
//            | --rename V W
//       the enum, its constructions, the matches on it
//
// Changes are computed on the program as parsed (ast.tach's
// PARSED_NODES), from the checked nodes' resolutions; a generic
// function's instances are clones of its nodes (generics.tach), mapped
// back to the nodes as written by their span. Lists (parameters,
// arguments, fields, variants, arms) keep their layout: an element on
// lines of its own is added or removed with its lines.

use crate::base::{
    FILES, IntVec, SRC, SYMS, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, intern, intern_c,
};
use crate::lexer::{TOKS, TOK_COUNT, Tok};
use crate::ast::{ARM_SYNTHETIC, KEEP_PARSED, NODES, NODE_COUNT, NodeKind, PARSED_COUNT, REPR_C};
use crate::types::{ENUMS, FNS, STRUCTS, TYPES, TyKind, VARIANTS};
use crate::modules::file_of_pos;
use crate::query::{
    DEFS, DEF_COUNT, K_ENUM, K_FN, K_IMPL_METHOD, K_METHOD, K_STRUCT, K_TRAIT_FN, PROG,
    QF_CALL, QF_DEF, R_FLAGS, R_POS, ROOT_GIVEN, TOOL, bytes_eq, c_slice, collect_refs, def_of_node, diag,
    diags, enclosing, line_start, load_program, program_errors, put_cword, put_loc, put_root, put_word,
    resolve_name, root_or_diag, set_targets, token_at, trait_of, try_end, write_diags,
};
use crate::edit::{
    TARGET, after_line, ambiguous, apply_edit, edit_replace, indent_of, set_command, source_only,
    take_edit_option,
};
use crate::fix::remove_use_name;
use crate::rewrite::{pa, pb, pc, pcount, pchild, pend, pflags, pk, pstart, sort_by_start};
use crate::lower::HMap;
use crate::streq;

// ---- Common ----

// The subcommand being run (`signature`, ...), for messages.
static mut SUB: *u8 = 0 as *u8;
// The nodes of the program (the pattern's and others come after).
static mut PROGRAM_END: i64 = 0;
// The nodes as written, by span and kind (see orig_of).
static mut ORIG: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

fn text_buf(s: [u8]) -> i64 {
    let b = buf_new();
    buf_bytes(b, s);
    b
}

fn sym_text(sym: i64) -> [u8] {
    unsafe { SYMS[sym].text }
}

fn usage_error(message: *u8, example: *u8) -> i64 {
    unsafe {
        let d = diag(c"error", c"refactor.usage");
        buf_str(d, message);
        buf_byte(d, '\n');
        let out = diags();
        buf_str(out, c"try:");
        put_cword(out, PROG);
        buf_str(out, c" refactor ");
        buf_str(out, SUB);
        buf_byte(out, ' ');
        buf_str(out, example);
        put_root(out);
        try_end(out);
        2
    }
}

// Starts a `try:` line `PROG refactor SUB NAME`; words and put_root
// follow.
fn try_refactor(name: [u8]) -> i64 {
    unsafe {
        let out = diags();
        buf_str(out, c"try:");
        put_cword(out, PROG);
        buf_str(out, c" refactor ");
        buf_str(out, SUB);
        put_word(out, name);
        out
    }
}

// Starts a `try:` line `PROG query CMD NAME`, ending it.
fn try_query_name(cmd: *u8, name: [u8]) {
    unsafe {
        let out = diags();
        buf_str(out, c"try:");
        put_cword(out, PROG);
        buf_str(out, c" query ");
        buf_str(out, cmd);
        put_word(out, name);
        put_root(out);
        try_end(out);
    }
}

// `try: PROG query show FILE:LINE` of the code at pos.
fn try_show_at(pos: i64) {
    unsafe {
        let out = diags();
        buf_str(out, c"try:");
        put_cword(out, PROG);
        buf_str(out, c" query show ");
        let at = buf_new();
        put_loc(at, pos);
        // (FILE:LINE: the column dropped)
        let s = buf_slice(at);
        let mut e = s.len;
        while e > 0 && s[e - 1] != ':' {
            e -= 1;
        }
        buf_bytes(out, s[0..e - 1]);
        put_root(out);
        try_end(out);
    }
}

// The options and words of `refactor SUB NAME ...`: the edit options are
// taken, `--x` options with `values` values each go to `opts` (the option,
// then its values), the rest to `words`. False after a usage error.
fn take_args(argc: i64, argv: **u8, options: *u8, root: **u8, words: *IntVec, opts: *IntVec) -> bool {
    unsafe {
        let mut i = 3;
        while i < argc {
            let a = argv[i];
            if take_edit_option(argc, argv, &i, root) {
                i += 1;
                continue;
            }
            if a[0] == '-' && a[1] == '-' {
                let n = option_values(options, a);
                if n < 0 {
                    let d = diag(c"error", c"refactor.usage");
                    buf_str(d, c"unknown option '");
                    buf_str(d, a);
                    buf_str(d, c"' of refactor ");
                    buf_str(d, SUB);
                    buf_byte(d, '\n');
                    return false;
                }
                if i + n >= argc {
                    let d = diag(c"error", c"refactor.usage");
                    buf_str(d, a);
                    buf_str(d, if n == 1 { c" needs a value\n" } else { c" needs two values\n" });
                    return false;
                }
                opts.push(a as i64);
                for k in 0..n {
                    opts.push(argv[i + 1 + k] as i64);
                }
                i += n + 1;
                continue;
            }
            words.push(a as i64);
            i += 1;
        }
        if (*words).count == 2 && *root == 0 as *u8 && crate::query::ends_with_c((*words).data[1] as *u8, c".tach") {
            *root = (*words).data[1] as *u8;
            (*words).count = 1;
        }
        true
    }
}

// The number of values of option `a` in `options` (`--add=1 --at=1 ...`),
// or -1 when it is none.
fn option_values(options: *u8, a: *u8) -> i64 {
    unsafe {
        let s = c_slice(options);
        let w = c_slice(a);
        let mut i = 0;
        while i < s.len {
            let mut e = i;
            while e < s.len && s[e] != '=' {
                e += 1;
            }
            if bytes_eq(s[i..e], w) {
                return (s[e + 1] - '0') as i64;
            }
            while e < s.len && s[e] != ' ' {
                e += 1;
            }
            i = e + 1;
        }
        -1
    }
}

// The value of option `name` in opts (its first value; `second`: its
// second), or 0.
fn opt(opts: *IntVec, name: *u8, second: bool) -> *u8 {
    unsafe {
        let mut i = 0;
        while i < (*opts).count {
            if streq((*opts).data[i] as *u8, name) {
                return (*opts).data[if second { i + 2 } else { i + 1 }] as *u8;
            }
            i += 1;
        }
        0 as *u8
    }
}

// Loads the program and finds NAME, a definition of kind k1 or k2...
// (as a mask of 1 << K_*): the definition, or -1 after the diagnostic
// (*status: the exit status).
fn load_and_find(root: *u8, name: [u8], kinds: i64, what: *u8, status: *i64) -> i64 {
    unsafe {
        KEEP_PARSED = true;
        if !load_program(root, TARGET) {
            program_errors(c"error", root, true);
            *status = 1;
            return -1;
        }
        PROGRAM_END = PARSED_COUNT;
        let mut matches = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        TOOL = c"refactor";
        if !resolve_name(SUB, name, &matches) {
            *status = 1;
            return -1;
        }
        source_only(&matches);
        // (only the definitions of the kinds asked for, when some are)
        let mut kept = 0;
        for i in 0..matches.count {
            let d = matches.data[i];
            if (kinds & (1 << DEFS[d].kind)) != 0 {
                matches.data[kept] = d;
                kept += 1;
            }
        }
        if kept == 0 {
            let d = matches.data[0];
            let e = diag(c"error", c"refactor.kind");
            buf_bytes(e, sym_text(DEFS[d].fqn));
            buf_str(e, c" is a ");
            buf_str(e, crate::query::kind_name(DEFS[d].kind));
            buf_str(e, c", not a ");
            buf_str(e, what);
            buf_byte(e, '\n');
            try_query_name(c"def", name);
            *status = 1;
            return -1;
        }
        matches.count = kept;
        if matches.count > 1 {
            ambiguous(SUB, name, &matches);
            *status = 1;
            return -1;
        }
        let d = matches.data[0];
        if FILES[file_of_pos(DEFS[d].start)].path[0] == '<' {
            let e = diag(c"error", c"edit.not-source");
            buf_bytes(e, sym_text(DEFS[d].fqn));
            buf_str(e, c" is in ");
            buf_str(e, FILES[file_of_pos(DEFS[d].start)].path);
            buf_str(e, c", not in a file of the program\n");
            *status = 1;
            return -1;
        }
        // The nodes as written, by span and kind.
        for n in 1..PROGRAM_END {
            let key = orig_key(pstart(n), pend(n), pk(n));
            if ORIG.get(key) == 0 {
                ORIG.put(key, n + 1);
            }
        }
        d
    }
}

fn orig_key(start: i64, end: i64, kind: NodeKind) -> i64 {
    ((start * 128 + kind as i64) * 65536 + (end - start) % 65536) + 1
}

// The node as written of checked node n, of kind `kind` as parsed: n
// itself, or for a clone (an instance's body), the node it copies; -1.
fn orig_of(n: i64, kind: NodeKind) -> i64 {
    unsafe {
        if n < PROGRAM_END {
            return if pk(n) == kind { n } else { -1 };
        }
        ORIG.get(orig_key(NODES[n].start, NODES[n].end, kind)) - 1
    }
}

// Whether only spaces are between pos and the start of its line.
fn starts_line(pos: i64) -> bool {
    unsafe {
        let mut p = pos;
        while p > 0 && (SRC[p - 1] == ' ' || SRC[p - 1] == '\t') {
            p -= 1;
        }
        p == 0 || SRC[p - 1] == '\n'
    }
}

// Whether a newline is in SRC[a..b).
fn newline_in(a: i64, b: i64) -> bool {
    unsafe {
        for p in a..b {
            if SRC[p] == '\n' {
                return true;
            }
        }
        false
    }
}

// Whether the rest of the line after pos is blank, but for a `,` and a
// comment.
fn rest_blank(pos: i64) -> bool {
    unsafe {
        let mut p = pos;
        while SRC[p] == ' ' || SRC[p] == '\t' {
            p += 1;
        }
        if SRC[p] == ',' {
            p += 1;
        }
        while SRC[p] == ' ' || SRC[p] == '\t' {
            p += 1;
        }
        if SRC[p] == '/' && SRC[p + 1] == '/' {
            return true;
        }
        SRC[p] == '\n' || SRC[p] == 0
    }
}

// The start of the comment lines directly above the line of pos (that
// line's start when there are none).
fn comment_head(pos: i64) -> i64 {
    unsafe {
        let f = file_of_pos(pos);
        let mut p = line_start(pos);
        while p > FILES[f].start {
            let prev = line_start(p - 1);
            let mut q = prev;
            while SRC[q] == ' ' || SRC[q] == '\t' {
                q += 1;
            }
            if SRC[q] == '/' && SRC[q + 1] == '/' {
                p = prev;
            } else {
                break;
            }
        }
        p
    }
}

// The token index of the bracket matching the one at token i: back from
// a closing one (`back`), forward from an opening one; -1.
fn matching(i0: i64, back: bool) -> i64 {
    unsafe {
        let mut depth = 0;
        let mut i = i0;
        while i >= 0 && i < TOK_COUNT {
            let k = TOKS[i].kind;
            let close = k == Tok::RParen || k == Tok::RBracket || k == Tok::RBrace;
            let open = k == Tok::LParen || k == Tok::LBracket || k == Tok::LBrace;
            if (close && back) || (open && !back) {
                depth += 1;
            } else if open || close {
                depth -= 1;
            }
            if depth == 0 {
                return i;
            }
            i = if back { i - 1 } else { i + 1 };
        }
        -1
    }
}

// ---- Lists ----
//
// The list being changed: the position after its opening bracket, the
// position of its closing one, its elements' spans.

static mut L_OPEN: i64 = 0;
static mut L_CLOSE: i64 = 0;
static mut L_START: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut L_END: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The list of node n's elements (its list as parsed), between the
// bracket closing at n's end and the one it matches.
fn list_of_node(n: i64) {
    unsafe {
        let close = token_at(pend(n) - 1);
        let open = matching(close, true);
        L_OPEN = TOKS[open].end;
        L_CLOSE = TOKS[close].start;
        L_START.count = 0;
        L_END.count = 0;
        for i in 0..pcount(n) {
            let c = pchild(n, i);
            L_START.push(pstart(c));
            L_END.push(pend(c));
        }
    }
}

// The parameter list of function node f: after the `(` following its
// name.
fn list_of_params(f: i64, name_pos: i64) {
    unsafe {
        let mut i = token_at(name_pos);
        while i < TOK_COUNT && TOKS[i].kind != Tok::LParen {
            i += 1;
        }
        let close = matching(i, false);
        L_OPEN = TOKS[i].end;
        L_CLOSE = TOKS[close].start;
        L_START.count = 0;
        L_END.count = 0;
        for k in 0..pcount(f) {
            let c = pchild(f, k);
            L_START.push(pstart(c));
            L_END.push(pend(c));
        }
    }
}

// Inserts `text` as element k (k == count: at the end).
fn list_insert(k: i64, text: [u8]) {
    unsafe {
        let n = L_START.count;
        let brace = SRC[L_OPEN - 1] == '{';
        if n == 0 {
            let b = buf_new();
            if brace {
                buf_byte(b, ' ');
            }
            buf_bytes(b, text);
            if brace {
                buf_byte(b, ' ');
            }
            edit_replace(L_OPEN, L_CLOSE, b);
            return;
        }
        if k < n {
            let s = L_START.data[k];
            let b = buf_new();
            if starts_line(s) {
                buf_bytes(b, indent_of(s));
                buf_bytes(b, text);
                buf_str(b, c",\n");
                let at = comment_head(s);
                edit_replace(at, at, b);
            } else {
                buf_bytes(b, text);
                buf_str(b, c", ");
                edit_replace(s, s, b);
            }
            return;
        }
        let last = L_START.data[n - 1];
        let e = L_END.data[n - 1];
        if starts_line(last) && newline_in(e, L_CLOSE) {
            // (on a line of its own, after the last one's; with a comma
            // when the last one has one)
            let mut p = e;
            while SRC[p] == ' ' || SRC[p] == '\t' {
                p += 1;
            }
            let comma = SRC[p] == ',' || SRC[e - 1] == ',';
            if !comma {
                edit_replace(e, e, text_buf(c_slice(c",")));
            }
            let b = buf_new();
            buf_bytes(b, indent_of(last));
            buf_bytes(b, text);
            if comma {
                buf_byte(b, ',');
            }
            buf_byte(b, '\n');
            let at = after_line(e);
            edit_replace(at, at, b);
            return;
        }
        let b = buf_new();
        buf_str(b, if SRC[e - 1] == ',' { c" " } else { c", " });
        buf_bytes(b, text);
        edit_replace(e, e, b);
    }
}

// Removes element k with its separator (its lines, when it has lines of
// its own).
fn list_remove(k: i64) {
    unsafe {
        let n = L_START.count;
        let s = L_START.data[k];
        let e = L_END.data[k];
        if starts_line(s) && rest_blank(e) && newline_in(e, L_CLOSE) {
            edit_replace(comment_head(s), after_line(e), buf_new());
            if k == n - 1 && k > 0 && SRC[e - 1] != ',' && !has_comma_after(e) {
                // (the one before is the last now: like this one, without
                // a comma)
                let pe = L_END.data[k - 1];
                if has_comma_after(pe) {
                    let mut p = pe;
                    while SRC[p] != ',' {
                        p += 1;
                    }
                    edit_replace(p, p + 1, buf_new());
                }
            }
            return;
        }
        if n == 1 {
            edit_replace(L_OPEN, L_CLOSE, buf_new());
        } else if k < n - 1 {
            edit_replace(s, L_START.data[k + 1], buf_new());
        } else {
            edit_replace(L_END.data[k - 1], e, buf_new());
        }
    }
}

fn has_comma_after(e: i64) -> bool {
    unsafe {
        let mut p = e;
        while SRC[p] == ' ' || SRC[p] == '\t' {
            p += 1;
        }
        SRC[p] == ','
    }
}

// Element j becomes element perm[j] (each its text, layout kept).
fn list_permute(perm: *IntVec) {
    unsafe {
        for j in 0..(*perm).count {
            let from = (*perm).data[j];
            if from != j {
                edit_replace(L_START.data[j], L_END.data[j], text_buf(SRC[L_START.data[from]..L_END.data[from]]));
            }
        }
    }
}

// Whether SRC[a..b) has a call (an argument whose removal, or move,
// changes what the program does).
fn has_call(a: i64, b: i64) -> bool {
    unsafe {
        let mut i = token_at(a);
        while i < TOK_COUNT && TOKS[i].start < b {
            if TOKS[i].kind == Tok::LParen && i > 0 && TOKS[i - 1].kind == Tok::Ident {
                return true;
            }
            i += 1;
        }
        false
    }
}

// `NAME: T = VALUE` (or `NAME: T`): the end of the declaration, the
// start of VALUE (-1 for none) in s.
fn split_default(s: [u8], value: *i64) -> i64 {
    unsafe {
        let mut depth = 0;
        for i in 0..s.len {
            let c = s[i];
            if c == '(' || c == '[' || c == '{' || c == '<' {
                depth += 1;
            } else if c == ')' || c == ']' || c == '}' || (c == '>' && i > 0 && s[i - 1] != '-') {
                depth -= 1;
            } else if c == '=' && depth == 0 && (i + 1 >= s.len || (s[i + 1] != '=' && s[i + 1] != '>'))
                && (i == 0 || (s[i - 1] != '=' && s[i - 1] != '!' && s[i - 1] != '<' && s[i - 1] != '>')) {
                let mut e = i;
                while e > 0 && s[e - 1] == ' ' {
                    e -= 1;
                }
                let mut v = i + 1;
                while v < s.len && s[v] == ' ' {
                    v += 1;
                }
                *value = v;
                return e;
            }
        }
        *value = -1;
        let mut e = s.len;
        while e > 0 && s[e - 1] == ' ' {
            e -= 1;
        }
        e
    }
}

// The name a declaration `[pub] [mut] NAME ...` starts with, as a symbol
// (-1: none).
fn leading_name(s: [u8]) -> i64 {
    let mut i = 0;
    while i < s.len && s[i] == ' ' {
        i += 1;
    }
    let mut word = word_at(s, i);
    if (word == 3 && s[i] == 'p' && s[i + 1] == 'u' && s[i + 2] == 'b')
        || (word == 3 && s[i] == 'm' && s[i + 1] == 'u' && s[i + 2] == 't') {
        i += word;
        while i < s.len && s[i] == ' ' {
            i += 1;
        }
        word = word_at(s, i);
    }
    if word == 0 {
        return -1;
    }
    intern(s[i..i + word])
}

fn word_at(s: [u8], i: i64) -> i64 {
    let mut e = i;
    while e < s.len && ((s[e] >= 'a' && s[e] <= 'z') || (s[e] >= 'A' && s[e] <= 'Z') || s[e] == '_'
        || (e > i && s[e] >= '0' && s[e] <= '9')) {
        e += 1;
    }
    e - i
}

// The position of the name token `name` at or after pos (a parameter's
// name after `mut`), or -1.
fn name_token(pos: i64, end: i64, name: i64) -> i64 {
    unsafe {
        let mut i = token_at(pos);
        while i < TOK_COUNT && TOKS[i].start < end {
            if TOKS[i].kind == Tok::Ident && TOKS[i].value as i64 == name {
                return TOKS[i].start;
            }
            i += 1;
        }
        -1
    }
}

fn replace_name(pos: i64, old: i64, new: i64) {
    edit_replace(pos, pos + sym_text(old).len, text_buf(sym_text(new)));
}

// The references to the definitions of `targets` (query's refs): into
// R_POS, R_FLAGS.
fn refs_of(targets: *IntVec) {
    set_targets(targets);
    collect_refs();
}

fn put_count(out: i64, n: i64, one: *u8, many: *u8) {
    unsafe {
        buf_int(out, n);
        buf_byte(out, ' ');
        buf_str(out, if n == 1 { one } else { many });
    }
}

// ---- refactor signature ----

pub fn run_signature(argc: i64, argv: **u8) -> i64 {
    let status = signature_inner(argc, argv);
    write_diags();
    status
}

// The definitions changed with d: a trait's function and its impls' (d
// is either), else d alone; d first.
fn signature_group(d: i64, group: *IntVec) {
    unsafe {
        group.push(d);
        let mut t = -1;
        if DEFS[d].kind == K_TRAIT_FN {
            t = d;
        } else if DEFS[d].kind == K_IMPL_METHOD {
            let td = trait_of(d);
            for x in 0..DEF_COUNT {
                if td >= 0 && DEFS[x].kind == K_TRAIT_FN && DEFS[x].parent == td && DEFS[x].name == DEFS[d].name {
                    t = x;
                }
            }
        }
        if t < 0 {
            return;
        }
        if t != d {
            group.push(t);
        }
        for x in 0..DEF_COUNT {
            if x != d && DEFS[x].kind == K_IMPL_METHOD && DEFS[x].name == DEFS[t].name && trait_of(x) == DEFS[t].parent {
                group.push(x);
            }
        }
    }
}

fn in_group(group: *IntVec, d: i64) -> bool {
    unsafe {
        for i in 0..(*group).count {
            if (*group).data[i] == d {
                return true;
            }
        }
        false
    }
}

// The calls of the functions of `group`, as written (Call or MethodCall
// nodes; an operator's: its Binary, Unary, Index node), each once.
fn calls_of(group: *IntVec, out: *IntVec) {
    unsafe {
        let mut seen = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for n in 1..NODE_COUNT {
            if NODES[n].kind != NodeKind::Call || NODES[n].x <= 0 {
                continue;
            }
            let d = def_of_node(FNS[NODES[n].x - 1].node);
            if d < 0 || !in_group(group, d) {
                continue;
            }
            let mut o = orig_of(n, NodeKind::Call);
            if o < 0 {
                o = orig_of(n, NodeKind::MethodCall);
            }
            if o < 0 {
                o = orig_of(n, NodeKind::Binary);
            }
            if o < 0 {
                o = orig_of(n, NodeKind::Unary);
            }
            if o < 0 {
                o = orig_of(n, NodeKind::Index);
            }
            if o < 0 {
                o = orig_of(n, NodeKind::Assign);
            }
            if o < 0 || seen.get(o + 1) != 0 {
                continue;
            }
            seen.put(o + 1, 1);
            out.push(o);
        }
        sort_by_start(out);
    }
}

// The index of the parameter named `name` of function node f, or -1.
fn param_index(f: i64, name: i64) -> i64 {
    for i in 0..pcount(f) {
        if pa(pchild(f, i)) == name {
            return i;
        }
    }
    -1
}

fn has_self(f: i64) -> bool {
    unsafe { pcount(f) > 0 && pa(pchild(f, 0)) == intern_c(c"self") }
}

// The parameters of f, `(a, b)`, for messages.
fn put_params(out: i64, f: i64) {
    unsafe {
        buf_byte(out, '(');
        for i in 0..pcount(f) {
            if i > 0 {
                buf_str(out, c", ");
            }
            buf_bytes(out, sym_text(pa(pchild(f, i))));
        }
        buf_byte(out, ')');
    }
}

fn no_param(d: i64, f: i64, name: *u8) -> i64 {
    unsafe {
        let e = diag(c"error", c"refactor.no-param");
        buf_bytes(e, sym_text(DEFS[d].fqn));
        buf_str(e, c" has no parameter '");
        buf_str(e, name);
        buf_str(e, c"': ");
        put_params(e, f);
        buf_byte(e, '\n');
        try_query_name(c"def", sym_text(DEFS[d].fqn));
        1
    }
}

// The uses of the names `name` in the body of function node f, as
// written (an identifier, not a path's segment); the first's position
// into *first.
fn name_uses(f: i64, name: i64, out: *IntVec) {
    unsafe {
        let body = pc(f);
        if body == 0 {
            return;
        }
        for n in 1..PROGRAM_END {
            if pk(n) != NodeKind::Ident || pa(n) != name || pstart(n) < pstart(body) || pend(n) > pend(body) {
                continue;
            }
            // (`name::x` is a path)
            let t = token_at(pend(n));
            if t < TOK_COUNT && TOKS[t].kind == Tok::ColonColon {
                continue;
            }
            out.push(n);
        }
    }
}

// Whether `name` is bound in the body of f (a let, a pattern).
fn bound_in(f: i64, name: i64) -> i64 {
    unsafe {
        let body = pc(f);
        if body == 0 {
            return -1;
        }
        for n in 1..PROGRAM_END {
            if pk(n) == NodeKind::PatBind && pa(n) == name && pstart(n) >= pstart(body) && pend(n) <= pend(body) {
                return pstart(n);
            }
        }
        -1
    }
}

fn signature_inner(argc: i64, argv: **u8) -> i64 {
    unsafe {
        set_command(argc, argv);
        PROG = argv[0];
        TOOL = c"refactor";
        SUB = c"signature";
        let mut root = 0 as *u8;
        let mut words = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut opts = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let example = c"NAME --add 'x: i64 = 0' --dry-run";
        if !take_args(argc, argv, c"--add=1 --at=1 --remove=1 --rename-param=2 --reorder=1 --type=2", &root, &words, &opts) {
            return 2;
        }
        if words.count != 1 {
            return usage_error(if words.count == 0 { c"a function NAME is needed" } else { c"one NAME at a time" }, example);
        }
        let add = opt(&opts, c"--add", false);
        let at = opt(&opts, c"--at", false);
        let remove = opt(&opts, c"--remove", false);
        let rename = opt(&opts, c"--rename-param", false);
        let reorder = opt(&opts, c"--reorder", false);
        let retype = opt(&opts, c"--type", false);
        let actions = (add != 0 as *u8) as i64 + (remove != 0 as *u8) as i64 + (rename != 0 as *u8) as i64
            + (reorder != 0 as *u8) as i64 + (retype != 0 as *u8) as i64;
        if actions != 1 {
            return usage_error(c"one of --add, --remove, --rename-param, --reorder, --type", example);
        }
        if at != 0 as *u8 && add == 0 as *u8 {
            return usage_error(c"--at goes with --add", example);
        }
        let name = c_slice(words.data[0] as *u8);
        ROOT_GIVEN = root;
        root = root_or_diag(root, SUB, name, true);
        if root == 0 as *u8 {
            return 2;
        }
        let mut status = 0;
        let fn_kinds = (1 << K_FN) | (1 << K_METHOD) | (1 << K_IMPL_METHOD) | (1 << K_TRAIT_FN);
        let d = load_and_find(root, name, fn_kinds, c"function", &status);
        if d < 0 {
            return status;
        }
        let f = DEFS[d].node;
        let fqn = sym_text(DEFS[d].fqn);
        if pk(f) == NodeKind::ExternFn || NODES[f].y == 1 {
            let e = diag(c"error", c"refactor.extern");
            buf_bytes(e, fqn);
            buf_str(e, if pk(f) == NodeKind::ExternFn { c" is a C function: its signature is C's\n" }
                else { c" is an extern \"C\" fn: C code calls it\n" });
            return 1;
        }
        let mut group = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        signature_group(d, &group);
        for i in 1..group.count {
            if pcount(DEFS[group.data[i]].node) != pcount(f) {
                let e = diag(c"error", c"refactor.trait");
                buf_bytes(e, sym_text(DEFS[group.data[i]].fqn));
                buf_str(e, c" has not the parameters of ");
                buf_bytes(e, fqn);
                buf_byte(e, '\n');
                return 1;
            }
        }
        let mut calls = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        calls_of(&group, &calls);
        // The references that are no calls: a function used as a value
        // (its type is its signature's).
        if rename == 0 as *u8 {
            refs_of(&group);
            for r in 0..R_POS.count {
                if (R_FLAGS.data[r] & (QF_CALL | QF_DEF)) != 0 || enclosing(R_POS.data[r]) < 0 {
                    continue;
                }
                let e = diag(c"error", c"refactor.fn-value");
                buf_bytes(e, fqn);
                buf_str(e, c" is used as a value at ");
                put_loc(e, R_POS.data[r]);
                buf_str(e, c": its type would change; change that use first\n");
                try_query_name(c"refs", fqn);
                return 1;
            }
        }
        for i in 0..calls.count {
            let c = calls.data[i];
            if pk(c) != NodeKind::Call && pk(c) != NodeKind::MethodCall && rename == 0 as *u8 {
                let e = diag(c"error", c"refactor.operator");
                buf_bytes(e, fqn);
                buf_str(e, c" is called by an operator at ");
                put_loc(e, pstart(c));
                buf_str(e, c": its arguments are the operator's\n");
                return 1;
            }
        }
        let unchecked = unchecked_calls(DEFS[d].name, &calls);
        let self_param = has_self(f);
        let what = buf_new();
        if add != 0 as *u8 {
            let text = c_slice(add);
            let mut vstart = -1;
            let dend = split_default(text, &vstart);
            let decl = text[0..dend];
            let pname = leading_name(decl);
            if pname < 0 || find_byte(decl, ':') < 0 {
                return usage_error(c"--add takes 'NAME: TYPE = VALUE' (VALUE: the calls' argument)", example);
            }
            if param_index(f, pname) >= 0 {
                let e = diag(c"error", c"refactor.clash");
                buf_bytes(e, fqn);
                buf_str(e, c" has a parameter '");
                buf_bytes(e, sym_text(pname));
                buf_str(e, c"' already\n");
                return 1;
            }
            if vstart < 0 && calls.count > 0 {
                let e = diag(c"error", c"refactor.no-default");
                buf_str(e, c"the calls need a value for ");
                buf_bytes(e, sym_text(pname));
                buf_str(e, c": --add 'NAME: TYPE = VALUE'\n");
                let out = try_refactor(fqn);
                buf_str(out, c" --add");
                let w = text_buf(decl);
                buf_str(w, c" = 0");
                put_word(out, buf_slice(w));
                buf_str(out, c" --dry-run");
                put_root(out);
                try_end(out);
                return 2;
            }
            let k = if at != 0 as *u8 { crate::query::parse_count(at) } else { pcount(f) };
            if k < 0 || k > pcount(f) || (k == 0 && self_param) {
                let e = diag(c"error", c"refactor.usage");
                buf_str(e, c"--at takes a position from ");
                buf_int(e, self_param as i64);
                buf_str(e, c" to ");
                buf_int(e, pcount(f));
                buf_str(e, c" among ");
                put_params(e, f);
                buf_byte(e, '\n');
                return 2;
            }
            for g in 0..group.count {
                let gd = group.data[g];
                list_of_params(DEFS[gd].node, DEFS[gd].name_pos);
                list_insert(k, decl);
            }
            let value = if vstart >= 0 { text[vstart..text.len] } else { text[0..0] };
            for i in 0..calls.count {
                let c = calls.data[i];
                list_of_node(c);
                let off = if pk(c) == NodeKind::MethodCall && self_param { 1 } else { 0 };
                list_insert(k - off, value);
            }
            buf_str(what, c"added parameter ");
            buf_bytes(what, decl);
            buf_str(what, c" to ");
        } else if remove != 0 as *u8 {
            let pname = intern(c_slice(remove));
            let k = param_index(f, pname);
            if k < 0 {
                return no_param(d, f, remove);
            }
            if k == 0 && self_param {
                return usage_error(c"self is not removed: the function would be another kind (refactor move)", example);
            }
            for g in 0..group.count {
                let gf = DEFS[group.data[g]].node;
                let gname = pa(pchild(gf, k));
                let mut uses = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                name_uses(gf, gname, &uses);
                if uses.count > 0 {
                    let e = diag(c"error", c"refactor.used");
                    buf_str(e, c"parameter ");
                    buf_bytes(e, sym_text(gname));
                    buf_str(e, c" is used in ");
                    buf_bytes(e, sym_text(DEFS[group.data[g]].fqn));
                    buf_str(e, c" at ");
                    put_loc(e, pstart(uses.data[0]));
                    buf_byte(e, '\n');
                    try_show_at(pstart(uses.data[0]));
                    return 1;
                }
            }
            let mut effects = -1;
            for g in 0..group.count {
                let gd = group.data[g];
                list_of_params(DEFS[gd].node, DEFS[gd].name_pos);
                list_remove(k);
            }
            for i in 0..calls.count {
                let c = calls.data[i];
                list_of_node(c);
                let off = if pk(c) == NodeKind::MethodCall && self_param { 1 } else { 0 };
                if has_call(L_START.data[k - off], L_END.data[k - off]) && effects < 0 {
                    effects = L_START.data[k - off];
                }
                list_remove(k - off);
            }
            if effects >= 0 {
                let e = diag(c"warning", c"refactor.effects");
                buf_str(e, c"a removed argument calls a function (first: ");
                put_loc(e, effects);
                buf_str(e, c"); its calls are gone\n");
            }
            buf_str(what, c"removed parameter ");
            buf_bytes(what, sym_text(pname));
            buf_str(what, c" of ");
        } else if rename != 0 as *u8 {
            let old = intern(c_slice(rename));
            let new = intern(c_slice(opt(&opts, c"--rename-param", true)));
            let k = param_index(f, old);
            if k < 0 {
                return no_param(d, f, rename);
            }
            if old == intern_c(c"self") || new == intern_c(c"self") {
                return usage_error(c"self keeps its name (a method's first parameter is self)", example);
            }
            for g in 0..group.count {
                let gf = DEFS[group.data[g]].node;
                let p = pchild(gf, k);
                let gold = pa(p);
                if param_index(gf, new) >= 0 || bound_in(gf, new) >= 0 || bound_in(gf, gold) >= 0 || has_name(gf, new) {
                    let e = diag(c"error", c"refactor.clash");
                    buf_bytes(e, sym_text(new));
                    buf_str(e, c" is a name in ");
                    buf_bytes(e, sym_text(DEFS[group.data[g]].fqn));
                    buf_str(e, if bound_in(gf, gold) >= 0 { c" (or the parameter is shadowed there); rename by hand\n" }
                        else { c" already\n" });
                    try_query_name(c"show", sym_text(DEFS[group.data[g]].fqn));
                    return 1;
                }
                replace_name(name_token(pstart(p), pend(p), gold), gold, new);
                let mut uses = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                name_uses(gf, gold, &uses);
                for u in 0..uses.count {
                    replace_name(pstart(uses.data[u]), gold, new);
                }
            }
            buf_str(what, c"renamed parameter ");
            buf_bytes(what, sym_text(old));
            buf_str(what, c" to ");
            buf_bytes(what, sym_text(new));
            buf_str(what, c" of ");
        } else if reorder != 0 as *u8 {
            // The new order: the names, self first.
            let first = self_param as i64;
            let mut perm = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            if self_param {
                perm.push(0);
            }
            let s = c_slice(reorder);
            let mut i = 0;
            while i <= s.len {
                let mut e = i;
                while e < s.len && s[e] != ',' {
                    e += 1;
                }
                let mut a = i;
                while a < e && s[a] == ' ' {
                    a += 1;
                }
                let mut b = e;
                while b > a && s[b - 1] == ' ' {
                    b -= 1;
                }
                if b > a {
                    let k = param_index(f, intern(s[a..b]));
                    if k < first {
                        let nb = buf_new();
                        buf_bytes(nb, s[a..b]);
                        buf_byte(nb, 0);
                        return no_param(d, f, crate::proc::buf_cstr(nb));
                    }
                    perm.push(k);
                }
                i = e + 1;
            }
            let mut ok = perm.count == pcount(f);
            for x in 0..perm.count {
                for y in 0..x {
                    if perm.data[x] == perm.data[y] {
                        ok = false;
                    }
                }
            }
            if !ok {
                let e = diag(c"error", c"refactor.usage");
                buf_str(e, c"--reorder lists each parameter once");
                buf_str(e, if self_param { c" (but self, which stays first): " } else { c": " });
                put_params(e, f);
                buf_byte(e, '\n');
                return 2;
            }
            for g in 0..group.count {
                let gd = group.data[g];
                list_of_params(DEFS[gd].node, DEFS[gd].name_pos);
                list_permute(&perm);
            }
            let mut moved = -1;
            for c0 in 0..calls.count {
                let c = calls.data[c0];
                list_of_node(c);
                let mut cperm = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                let off = if pk(c) == NodeKind::MethodCall && self_param { 1 } else { 0 };
                let mut effects = 0;
                for x in off..perm.count {
                    cperm.push(perm.data[x] - off);
                    if has_call(L_START.data[x - off], L_END.data[x - off]) {
                        effects += 1;
                    }
                }
                if effects > 1 && moved < 0 {
                    moved = pstart(c);
                }
                list_permute(&cperm);
            }
            if moved >= 0 {
                let e = diag(c"warning", c"refactor.effects");
                buf_str(e, c"arguments that call functions are evaluated in another order (first: ");
                put_loc(e, moved);
                buf_str(e, c")\n");
            }
            buf_str(what, c"reordered the parameters of ");
        } else {
            let pname = intern(c_slice(retype));
            let k = param_index(f, pname);
            if k < 0 {
                return no_param(d, f, retype);
            }
            let ty = c_slice(opt(&opts, c"--type", true));
            for g in 0..group.count {
                let p = pchild(DEFS[group.data[g]].node, k);
                let t = pb(p);
                edit_replace(pstart(t), pend(t), text_buf(ty));
            }
            buf_str(what, c"changed parameter ");
            buf_bytes(what, sym_text(pname));
            buf_str(what, c" to ");
            buf_bytes(what, ty);
            buf_str(what, c" in ");
        }
        buf_bytes(what, fqn);
        if group.count > 1 {
            buf_str(what, c" and ");
            put_count(what, group.count - 1, c"other definition", c"other definitions");
        }
        if rename == 0 as *u8 && retype == 0 as *u8 {
            buf_str(what, c", ");
            put_count(what, calls.count, c"call", c"calls");
        }
        if unchecked.count > 0 {
            let e = diag(c"warning", c"refactor.unchecked");
            put_count(e, unchecked.count, c"call", c"calls");
            buf_str(e, c" named ");
            buf_bytes(e, sym_text(DEFS[d].name));
            buf_str(e, c" in code the checker did not see (a generic function never instantiated) are not changed; first: ");
            put_loc(e, pstart(unchecked.data[0]));
            buf_byte(e, '\n');
        }
        apply_edit(buf_slice(what), root)
    }
}

fn find_byte(s: [u8], c: u8) -> i64 {
    for i in 0..s.len {
        if s[i] == c {
            return i;
        }
    }
    -1
}

// Whether `name` is written as an identifier in the body of f.
fn has_name(f: i64, name: i64) -> bool {
    let mut uses = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    name_uses(f, name, &uses);
    uses.count > 0
}

// The calls written with name `name` that the checker never resolved
// (in code it did not check), but `calls`.
fn unchecked_calls(name: i64, calls: *IntVec) -> IntVec {
    unsafe {
        let mut out = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for n in 1..PROGRAM_END {
            if in_group(calls, n) {
                continue;
            }
            let k = pk(n);
            let named = (k == NodeKind::MethodCall && pb(n) == name)
                || (k == NodeKind::Call && pk(pa(n)) == NodeKind::Ident && pa(pa(n)) == name);
            if !named || FILES[file_of_pos(pstart(n))].path[0] == '<' {
                continue;
            }
            if NODES[n].kind == NodeKind::MethodCall || (NODES[n].kind == NodeKind::Call && NODES[n].x == 0 && NODES[NODES[n].a].res == crate::check::Res::None) {
                out.push(n);
            }
        }
        out
    }
}

// ---- refactor field ----

pub fn run_field(argc: i64, argv: **u8) -> i64 {
    let status = field_inner(argc, argv);
    write_diags();
    status
}

// The struct item of checked type t (through a pointer), or 0.
fn struct_node_of(t0: i64) -> i64 {
    unsafe {
        if t0 <= 0 {
            return 0;
        }
        let t = if TYPES[t0].kind == TyKind::Ptr { TYPES[t0].a } else { t0 };
        if t <= 0 || TYPES[t].kind != TyKind::Struct {
            return 0;
        }
        STRUCTS[TYPES[t].a].node
    }
}

// The literals of struct node s, as written, each once.
fn literals_of(s: i64, out: *IntVec) {
    unsafe {
        let mut seen = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for n in 1..NODE_COUNT {
            if NODES[n].kind != NodeKind::StructLit || struct_node_of(NODES[n].ty) != s {
                continue;
            }
            let o = orig_of(n, NodeKind::StructLit);
            if o < 0 || seen.get(o + 1) != 0 {
                continue;
            }
            seen.put(o + 1, 1);
            out.push(o);
        }
        sort_by_start(out);
    }
}

// The field of struct node s named `name`: its index, or -1.
fn field_index(s: i64, name: i64) -> i64 {
    for i in 0..pcount(s) {
        if pa(pchild(s, i)) == name {
            return i;
        }
    }
    -1
}

fn put_fields(out: i64, s: i64) {
    unsafe {
        buf_byte(out, '{');
        for i in 0..pcount(s) {
            buf_str(out, if i > 0 { c", " } else { c" " });
            buf_bytes(out, sym_text(pa(pchild(s, i))));
        }
        buf_str(out, c" }");
    }
}

fn no_member(d: i64, s: i64, name: *u8, what: *u8) -> i64 {
    unsafe {
        let e = diag(c"error", c"refactor.no-member");
        buf_bytes(e, sym_text(DEFS[d].fqn));
        buf_str(e, c" has no ");
        buf_str(e, what);
        buf_str(e, c" '");
        buf_str(e, name);
        buf_str(e, c"': ");
        put_fields(e, s);
        buf_byte(e, '\n');
        try_query_name(c"show", sym_text(DEFS[d].fqn));
        1
    }
}

// The definition of member `name` (a field, a variant) of d.
fn member_def(d: i64, name: i64) -> i64 {
    unsafe {
        for x in 0..DEF_COUNT {
            if DEFS[x].parent == d && DEFS[x].name == name {
                return x;
            }
        }
        -1
    }
}

// Renames each reference (R_POS) to `old` as `new`.
fn rename_refs(old: i64, new: i64) -> i64 {
    unsafe {
        let mut n = 0;
        let mut seen = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for r in 0..R_POS.count {
            let pos = R_POS.data[r];
            let t = token_at(pos);
            if seen.get(pos + 1) != 0 || t >= TOK_COUNT || TOKS[t].start != pos || TOKS[t].kind != Tok::Ident
                || TOKS[t].value as i64 != old {
                continue;
            }
            seen.put(pos + 1, 1);
            replace_name(pos, old, new);
            n += 1;
        }
        n
    }
}

fn field_inner(argc: i64, argv: **u8) -> i64 {
    unsafe {
        set_command(argc, argv);
        PROG = argv[0];
        TOOL = c"refactor";
        SUB = c"field";
        let mut root = 0 as *u8;
        let mut words = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut opts = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let example = c"STRUCT --add 'g: i64 = 0' --dry-run";
        if !take_args(argc, argv, c"--add=1 --remove=1 --rename=2 --type=2", &root, &words, &opts) {
            return 2;
        }
        if words.count != 1 {
            return usage_error(if words.count == 0 { c"a STRUCT is needed" } else { c"one STRUCT at a time" }, example);
        }
        let add = opt(&opts, c"--add", false);
        let remove = opt(&opts, c"--remove", false);
        let rename = opt(&opts, c"--rename", false);
        let retype = opt(&opts, c"--type", false);
        let actions = (add != 0 as *u8) as i64 + (remove != 0 as *u8) as i64 + (rename != 0 as *u8) as i64
            + (retype != 0 as *u8) as i64;
        if actions != 1 {
            return usage_error(c"one of --add, --remove, --rename, --type", example);
        }
        let name = c_slice(words.data[0] as *u8);
        ROOT_GIVEN = root;
        root = root_or_diag(root, SUB, name, true);
        if root == 0 as *u8 {
            return 2;
        }
        let mut status = 0;
        let d = load_and_find(root, name, 1 << K_STRUCT, c"struct", &status);
        if d < 0 {
            return status;
        }
        let s = DEFS[d].node;
        let fqn = sym_text(DEFS[d].fqn);
        let mut lits = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        literals_of(s, &lits);
        let what = buf_new();
        let layout = (pc(s) & REPR_C) != 0 && rename == 0 as *u8;
        if add != 0 as *u8 {
            let text = c_slice(add);
            let mut vstart = -1;
            let dend = split_default(text, &vstart);
            let decl = text[0..dend];
            let fname = leading_name(decl);
            if fname < 0 || find_byte(decl, ':') < 0 {
                return usage_error(c"--add takes 'NAME: TYPE = VALUE' (VALUE: the literals' value)", example);
            }
            if field_index(s, fname) >= 0 {
                let e = diag(c"error", c"refactor.clash");
                buf_bytes(e, fqn);
                buf_str(e, c" has a field '");
                buf_bytes(e, sym_text(fname));
                buf_str(e, c"' already\n");
                return 1;
            }
            if vstart < 0 && lits.count > 0 {
                let e = diag(c"error", c"refactor.no-default");
                buf_str(e, c"the literals of ");
                buf_bytes(e, fqn);
                buf_str(e, c" need a value for ");
                buf_bytes(e, sym_text(fname));
                buf_str(e, c": --add 'NAME: TYPE = VALUE'\n");
                return 2;
            }
            list_of_node(s);
            list_insert(pcount(s), decl);
            let init = buf_new();
            buf_bytes(init, sym_text(fname));
            buf_str(init, c": ");
            if vstart >= 0 {
                buf_bytes(init, text[vstart..text.len]);
            }
            for i in 0..lits.count {
                list_of_node(lits.data[i]);
                list_insert(pcount(lits.data[i]), buf_slice(init));
            }
            buf_str(what, c"added field ");
            buf_bytes(what, decl);
            buf_str(what, c" to ");
            buf_bytes(what, fqn);
            buf_str(what, c", ");
            put_count(what, lits.count, c"literal", c"literals");
        } else if remove != 0 as *u8 {
            let fname = intern(c_slice(remove));
            let k = field_index(s, fname);
            if k < 0 {
                return no_member(d, s, remove, c"field");
            }
            // Its uses: the references but its definition and the
            // literals' fields.
            let fd = member_def(d, fname);
            let mut targets = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            targets.push(fd);
            refs_of(&targets);
            let mut inits = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
            for i in 0..lits.count {
                for j in 0..pcount(lits.data[i]) {
                    inits.put(pstart(pchild(lits.data[i], j)) + 1, 1);
                }
            }
            let mut used = 0;
            let mut first = -1;
            for r in 0..R_POS.count {
                if (R_FLAGS.data[r] & QF_DEF) != 0 || inits.get(R_POS.data[r] + 1) != 0 {
                    continue;
                }
                if first < 0 {
                    first = R_POS.data[r];
                }
                used += 1;
            }
            if used > 0 {
                let e = diag(c"error", c"refactor.used");
                buf_bytes(e, sym_text(DEFS[fd].fqn));
                buf_str(e, c" is used: ");
                put_count(e, used, c"reference", c"references");
                buf_str(e, c" (first: ");
                put_loc(e, first);
                buf_str(e, c")\n");
                try_query_name(c"refs", sym_text(DEFS[fd].fqn));
                return 1;
            }
            list_of_node(s);
            list_remove(k);
            for i in 0..lits.count {
                let l = lits.data[i];
                list_of_node(l);
                for j in 0..pcount(l) {
                    if pa(pchild(l, j)) == fname {
                        list_remove(j);
                    }
                }
            }
            buf_str(what, c"removed field ");
            buf_bytes(what, sym_text(fname));
            buf_str(what, c" of ");
            buf_bytes(what, fqn);
            buf_str(what, c", ");
            put_count(what, lits.count, c"literal", c"literals");
        } else if rename != 0 as *u8 {
            let old = intern(c_slice(rename));
            let new = intern(c_slice(opt(&opts, c"--rename", true)));
            if field_index(s, old) < 0 {
                return no_member(d, s, rename, c"field");
            }
            if field_index(s, new) >= 0 {
                let e = diag(c"error", c"refactor.clash");
                buf_bytes(e, fqn);
                buf_str(e, c" has a field '");
                buf_bytes(e, sym_text(new));
                buf_str(e, c"' already\n");
                return 1;
            }
            let mut targets = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            targets.push(member_def(d, old));
            refs_of(&targets);
            let n = rename_refs(old, new);
            buf_str(what, c"renamed field ");
            buf_bytes(what, sym_text(old));
            buf_str(what, c" to ");
            buf_bytes(what, sym_text(new));
            buf_str(what, c" of ");
            buf_bytes(what, fqn);
            buf_str(what, c", ");
            put_count(what, n - 1, c"use", c"uses");
        } else {
            let fname = intern(c_slice(retype));
            let k = field_index(s, fname);
            if k < 0 {
                return no_member(d, s, retype, c"field");
            }
            let ty = c_slice(opt(&opts, c"--type", true));
            let t = pb(pchild(s, k));
            edit_replace(pstart(t), pend(t), text_buf(ty));
            buf_str(what, c"changed field ");
            buf_bytes(what, sym_text(fname));
            buf_str(what, c" to ");
            buf_bytes(what, ty);
            buf_str(what, c" in ");
            buf_bytes(what, fqn);
        }
        if layout {
            let e = diag(c"warning", c"refactor.layout");
            buf_bytes(e, fqn);
            buf_str(e, c" is #[repr(C)]: its layout changes (C code sharing it must change too)\n");
        }
        apply_edit(buf_slice(what), root)
    }
}

// ---- refactor variant ----

pub fn run_variant(argc: i64, argv: **u8) -> i64 {
    let status = variant_inner(argc, argv);
    write_diags();
    status
}

// Whether checked type t is enum node e's (an instance's of it too).
fn is_enum_of(t: i64, e: i64) -> bool {
    unsafe { t > 0 && TYPES[t].kind == TyKind::Enum && ENUMS[TYPES[t].a].node == e }
}

// The variant names of enum node e: whether `name` is one.
fn variant_named(e: i64, name: i64) -> bool {
    for i in 0..pcount(e) {
        if pa(pchild(e, i)) == name {
            return true;
        }
    }
    false
}

// Whether pattern p (checked) matches every value: `_`, a binding, an or
// of one.
fn catch_all(p: i64, e: i64) -> bool {
    unsafe {
        let k = NODES[p].kind;
        if k == NodeKind::PatWild {
            return true;
        }
        if k == NodeKind::PatBind {
            // (unchecked: a name of a variant brought by `use` is no binding)
            return NODES[p].ty != 0 || !variant_named(e, NODES[p].a);
        }
        if k == NodeKind::PatOr {
            for i in 0..pcount(p) {
                if catch_all(pchild(p, i), e) {
                    return true;
                }
            }
        }
        false
    }
}

// Whether pattern p (as written) names enum node e: `E::V(..)`, a variant
// of e.
fn names_enum(p: i64, e: i64) -> bool {
    unsafe {
        let k = pk(p);
        if k == NodeKind::PatVariant {
            return pa(p) == NODES[e].a || (pa(p) == 0 && variant_named(e, pb(p)));
        }
        if k == NodeKind::PatOr {
            for i in 0..pcount(p) {
                if names_enum(pchild(p, i), e) {
                    return true;
                }
            }
        }
        false
    }
}

// The matches on enum node e, as written: each once.
fn matches_on(e: i64, out: *IntVec) {
    unsafe {
        let mut seen = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for n in 1..NODE_COUNT {
            if NODES[n].kind != NodeKind::Match {
                continue;
            }
            let o = orig_of(n, NodeKind::Match);
            if o < 0 || seen.get(o + 1) != 0 || FILES[file_of_pos(pstart(o))].path[0] == '<' {
                continue;
            }
            let t = NODES[NODES[n].a].ty;
            let mut on = is_enum_of(t, e);
            if t <= 0 {
                for i in 0..pcount(o) {
                    if names_enum(pa(pchild(o, i)), e) {
                        on = true;
                    }
                }
            }
            if on {
                seen.put(o + 1, 1);
                out.push(o);
            }
        }
        sort_by_start(out);
    }
}

// The text written before the variant's name in a pattern of match m
// (`Kind::`, `crate::ast::Kind::`), or 0 when its arms name variants
// alone.
fn variant_prefix(m: i64) -> i64 {
    unsafe {
        for i in 0..pcount(m) {
            let mut p = pa(pchild(m, i));
            if pk(p) == NodeKind::PatOr && pcount(p) > 0 {
                p = pchild(p, 0);
            }
            if pk(p) != NodeKind::PatVariant || pa(p) == 0 {
                continue;
            }
            // (the name after the last `::` before a `(`)
            let mut t = token_at(pstart(p));
            let mut name_at = -1;
            while t < TOK_COUNT && TOKS[t].start < pend(p) && TOKS[t].kind != Tok::LParen {
                if TOKS[t].kind == Tok::ColonColon {
                    name_at = TOKS[t].end;
                }
                t += 1;
            }
            if name_at > pstart(p) {
                return text_buf(SRC[pstart(p)..name_at]);
            }
        }
        0
    }
}

fn variant_inner(argc: i64, argv: **u8) -> i64 {
    unsafe {
        set_command(argc, argv);
        PROG = argv[0];
        TOOL = c"refactor";
        SUB = c"variant";
        let mut root = 0 as *u8;
        let mut words = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut opts = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let example = c"ENUM --add 'X(i64)' --arm 'EXPR' --dry-run";
        if !take_args(argc, argv, c"--add=1 --arm=1 --remove=1 --rename=2", &root, &words, &opts) {
            return 2;
        }
        if words.count != 1 {
            return usage_error(if words.count == 0 { c"an ENUM is needed" } else { c"one ENUM at a time" }, example);
        }
        let add = opt(&opts, c"--add", false);
        let arm = opt(&opts, c"--arm", false);
        let remove = opt(&opts, c"--remove", false);
        let rename = opt(&opts, c"--rename", false);
        let actions = (add != 0 as *u8) as i64 + (remove != 0 as *u8) as i64 + (rename != 0 as *u8) as i64;
        if actions != 1 {
            return usage_error(c"one of --add, --remove, --rename", example);
        }
        if arm != 0 as *u8 && add == 0 as *u8 {
            return usage_error(c"--arm goes with --add", example);
        }
        let name = c_slice(words.data[0] as *u8);
        ROOT_GIVEN = root;
        root = root_or_diag(root, SUB, name, true);
        if root == 0 as *u8 {
            return 2;
        }
        let mut status = 0;
        let d = load_and_find(root, name, 1 << K_ENUM, c"enum", &status);
        if d < 0 {
            return status;
        }
        let e = DEFS[d].node;
        let fqn = sym_text(DEFS[d].fqn);
        let what = buf_new();
        if add != 0 as *u8 {
            let text = c_slice(add);
            let vname = leading_name(text);
            if vname < 0 {
                return usage_error(c"--add takes the variant: 'X', 'X(T, ...)'", example);
            }
            if variant_named(e, vname) {
                let x = diag(c"error", c"refactor.clash");
                buf_bytes(x, fqn);
                buf_str(x, c" has a variant '");
                buf_bytes(x, sym_text(vname));
                buf_str(x, c"' already\n");
                return 1;
            }
            // (its fields: the commas between its parentheses, plus one)
            let mut fields = 0;
            let open = find_byte(text, '(');
            if open >= 0 {
                fields = 1;
                let mut depth = 0;
                for i in open + 1..text.len {
                    let c = text[i];
                    if c == '(' || c == '[' || c == '<' {
                        depth += 1;
                    } else if c == ')' || c == ']' || c == '>' {
                        depth -= 1;
                    } else if c == ',' && depth == 0 {
                        fields += 1;
                    }
                }
            }
            let mut ms = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            matches_on(e, &ms);
            let mut open_ms = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for i in 0..ms.count {
                let m = ms.data[i];
                let mut covered = false;
                for j in 0..pcount(m) {
                    let a = pchild(m, j);
                    if pb(a) == 0 && catch_all(pa(a), e) {
                        covered = true;
                    }
                }
                if !covered {
                    open_ms.push(m);
                }
            }
            if open_ms.count > 0 && arm == 0 as *u8 {
                let out = buf_new();
                for i in 0..open_ms.count {
                    let m = open_ms.data[i];
                    put_loc(out, pstart(m));
                    buf_byte(out, '\t');
                    let x = enclosing(pstart(m));
                    if x >= 0 {
                        crate::query::put_short(out, DEFS[x].fqn);
                    }
                    buf_byte(out, '\n');
                }
                crate::base::buf_write_fd(out, crate::base::STDOUT);
                let x = diag(c"error", c"refactor.non-exhaustive");
                put_count(x, open_ms.count, c"match", c"matches");
                buf_str(x, c" on ");
                buf_bytes(x, fqn);
                buf_str(x, c" would not cover ");
                buf_bytes(x, sym_text(vname));
                buf_str(x, c"; nothing written\n");
                for i in 0..open_ms.count {
                    if i == 2 {
                        break;
                    }
                    try_show_at(pstart(open_ms.data[i]));
                }
                let out2 = try_refactor(fqn);
                buf_str(out2, c" --add");
                put_word(out2, text);
                buf_str(out2, c" --arm 'EXPR' --dry-run");
                put_root(out2);
                try_end(out2);
                return 1;
            }
            list_of_node(e);
            list_insert(pcount(e), text);
            for i in 0..open_ms.count {
                let m = open_ms.data[i];
                let pat = buf_new();
                let prefix = variant_prefix(m);
                if prefix != 0 {
                    buf_bytes(pat, buf_slice(prefix));
                } else {
                    buf_bytes(pat, fqn);
                    buf_str(pat, c"::");
                }
                buf_bytes(pat, sym_text(vname));
                if fields > 0 {
                    buf_byte(pat, '(');
                    for k in 0..fields {
                        buf_str(pat, if k > 0 { c", _" } else { c"_" });
                    }
                    buf_byte(pat, ')');
                }
                buf_str(pat, c" => ");
                buf_str(pat, arm);
                insert_arm(m, buf_slice(pat));
            }
            buf_str(what, c"added variant ");
            buf_bytes(what, text);
            buf_str(what, c" to ");
            buf_bytes(what, fqn);
            if open_ms.count > 0 {
                buf_str(what, c", an arm in ");
                put_count(what, open_ms.count, c"match", c"matches");
            }
        } else if remove != 0 as *u8 {
            let vname = intern(c_slice(remove));
            let mut k = -1;
            for i in 0..pcount(e) {
                if pa(pchild(e, i)) == vname {
                    k = i;
                }
            }
            if k < 0 {
                return no_member(d, e, remove, c"variant");
            }
            let vnode = pchild(e, k);
            let vd = member_def(d, vname);
            // Constructed: refused.
            for n in 1..NODE_COUNT {
                if NODES[n].kind == NodeKind::VariantLit && VARIANTS[NODES[n].a].node == vnode {
                    let x = diag(c"error", c"refactor.constructed");
                    buf_bytes(x, sym_text(DEFS[vd].fqn));
                    buf_str(x, c" is constructed at ");
                    put_loc(x, NODES[n].start);
                    buf_str(x, c"; change those first\n");
                    try_query_name(c"refs", sym_text(DEFS[vd].fqn));
                    return 1;
                }
            }
            // Matched: its arms go (an or loses it).
            let mut arms = 0;
            let mut seen = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
            for n in 1..NODE_COUNT {
                if NODES[n].kind != NodeKind::PatVariant || NODES[n].x < 0 || NODES[n].ty == 0
                    || VARIANTS[NODES[n].x].node != vnode {
                    continue;
                }
                let mut p = orig_of(n, NodeKind::PatVariant);
                if p < 0 {
                    p = orig_of(n, NodeKind::PatBind);
                }
                if p < 0 || seen.get(p + 1) != 0 {
                    continue;
                }
                seen.put(p + 1, 1);
                let r = remove_pattern(p);
                if r != 0 {
                    let x = diag(c"error", if r == 1 { c"refactor.nested" } else { c"refactor.if-let" });
                    buf_bytes(x, sym_text(DEFS[vd].fqn));
                    buf_str(x, if r == 1 { c" is matched inside another pattern at " } else { c" is matched by an `if let` or `while let` at " });
                    put_loc(x, pstart(p));
                    buf_str(x, c"; change it first\n");
                    try_show_at(pstart(p));
                    return 1;
                }
                arms += 1;
            }
            // Imported: the name goes from its `use`.
            let mut targets = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            targets.push(vd);
            refs_of(&targets);
            for r in 0..R_POS.count {
                if (R_FLAGS.data[r] & QF_DEF) != 0 || enclosing(R_POS.data[r]) >= 0 {
                    continue;
                }
                remove_import(R_POS.data[r]);
            }
            list_of_node(e);
            list_remove(k);
            if pcount(e) > k + 1 && fieldless_cast(e) {
                let x = diag(c"warning", c"refactor.discriminant");
                buf_bytes(x, fqn);
                buf_str(x, c" is cast to an integer somewhere: the variants after ");
                buf_bytes(x, sym_text(vname));
                buf_str(x, c" change their numbers\n");
            }
            buf_str(what, c"removed variant ");
            buf_bytes(what, sym_text(vname));
            buf_str(what, c" of ");
            buf_bytes(what, fqn);
            buf_str(what, c", ");
            put_count(what, arms, c"arm", c"arms");
        } else {
            let old = intern(c_slice(rename));
            let new = intern(c_slice(opt(&opts, c"--rename", true)));
            if !variant_named(e, old) {
                return no_member(d, e, rename, c"variant");
            }
            if variant_named(e, new) {
                let x = diag(c"error", c"refactor.clash");
                buf_bytes(x, fqn);
                buf_str(x, c" has a variant '");
                buf_bytes(x, sym_text(new));
                buf_str(x, c"' already\n");
                return 1;
            }
            let mut targets = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            targets.push(member_def(d, old));
            refs_of(&targets);
            let n = rename_refs(old, new);
            buf_str(what, c"renamed variant ");
            buf_bytes(what, sym_text(old));
            buf_str(what, c" to ");
            buf_bytes(what, sym_text(new));
            buf_str(what, c" of ");
            buf_bytes(what, fqn);
            buf_str(what, c", ");
            put_count(what, n - 1, c"use", c"uses");
        }
        apply_edit(buf_slice(what), root)
    }
}

// The arm `text` (`PATTERN => EXPR`) after the last arm of match m.
fn insert_arm(m: i64, text: [u8]) {
    unsafe {
        let n = pcount(m);
        if n == 0 {
            return;
        }
        let last = pchild(m, n - 1);
        let e = pend(last);
        let ends = SRC[e - 1] == ',' || SRC[e - 1] == '}';
        let b = buf_new();
        if starts_line(pstart(last)) && newline_in(e, pend(m) - 1) {
            if !ends {
                edit_replace(e, e, text_buf(c_slice(c",")));
            }
            buf_bytes(b, indent_of(pstart(last)));
            buf_bytes(b, text);
            buf_str(b, c",\n");
            let at = after_line(e);
            edit_replace(at, at, b);
            return;
        }
        // (on the line of the last: with a comma after it when it has one)
        buf_str(b, if ends { c" " } else { c", " });
        buf_bytes(b, text);
        if ends {
            buf_byte(b, ',');
        }
        edit_replace(e, e, b);
    }
}

// Removes pattern p (as written) from its arm: the arm, or the
// alternative of an or. 0 done, 1 p is inside another pattern, 2 the
// match is an `if let`'s.
fn remove_pattern(p: i64) -> i64 {
    unsafe {
        for m in 1..PROGRAM_END {
            if pk(m) != NodeKind::Match {
                continue;
            }
            for i in 0..pcount(m) {
                let a = pchild(m, i);
                let pat = pa(a);
                let direct = pat == p;
                let mut alt = -1;
                if pk(pat) == NodeKind::PatOr {
                    for j in 0..pcount(pat) {
                        if pchild(pat, j) == p {
                            alt = j;
                        }
                    }
                }
                if !direct && alt < 0 {
                    continue;
                }
                for j in 0..pcount(m) {
                    if (pflags(pchild(m, j)) & ARM_SYNTHETIC) != 0 {
                        return 2;
                    }
                }
                if alt >= 0 && pcount(pat) > 1 {
                    // `A | V | B`: V and a `|` next to it
                    if alt + 1 < pcount(pat) {
                        edit_replace(pstart(p), pstart(pchild(pat, alt + 1)), buf_new());
                    } else {
                        edit_replace(pend(pchild(pat, alt - 1)), pend(p), buf_new());
                    }
                    return 0;
                }
                // The arm: its lines, or its text and what separates it.
                let s = pstart(a);
                let e = pend(a);
                if starts_line(s) && rest_blank(e) {
                    edit_replace(comment_head(s), after_line(e), buf_new());
                } else if i + 1 < pcount(m) {
                    edit_replace(s, pstart(pchild(m, i + 1)), buf_new());
                } else if i > 0 {
                    edit_replace(pend(pchild(m, i - 1)), e, buf_new());
                } else {
                    edit_replace(s, e, buf_new());
                }
                return 0;
            }
        }
        1
    }
}

// Removes the import at pos (a name of a `use`).
fn remove_import(pos: i64) {
    unsafe {
        for u in 1..PROGRAM_END {
            if pk(u) != NodeKind::Use || pos < pstart(u) || pos >= pend(u) {
                continue;
            }
            for k in 0..pcount(u) {
                let id = pchild(u, k);
                if pstart(id) <= pos && pos < pend(id) {
                    if pcount(u) == 1 {
                        edit_replace(line_start(pstart(u)), after_line(pend(u)), buf_new());
                    } else {
                        remove_use_name(u, k);
                    }
                    return;
                }
            }
        }
    }
}

// Whether a value of enum node e is cast (`as`) somewhere.
fn fieldless_cast(e: i64) -> bool {
    unsafe {
        for n in 1..NODE_COUNT {
            if NODES[n].kind == NodeKind::Cast && is_enum_of(NODES[NODES[n].a].ty, e) {
                return true;
            }
        }
        false
    }
}
