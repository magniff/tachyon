// Value ranges and the comparisons they decide (0.4): bounds-check
// elimination, comparison folding, jump threading on implied conditions,
// and comparison chains turned into switches.
//
// A fact is a comparison (or a bool) known to hold, or not, at a block: the
// condition of every branch on the way to it along the dominator tree (when
// the edge into a block on that way is its only way in), the case of a
// switch that leads there, and for the blocks of a counted loop
// (scev.tach) `i < n` and `i >= start` for its induction variable. The
// range of an integer value is an interval (in the signed 64-bit view of
// its canonical value) from its type and its operation (masks, remainders,
// conversions, constants), narrowed by the facts that compare it with a
// constant. A comparison is decided when the facts about the same operands,
// or the ranges, leave only outcomes that agree.
//
// 0.11: phis have ranges (the union of their operands', a loop's found by
// induction: below), while a check's branch is decided; facts comparing a
// value with another bound it by the other's range; shifts and 64-bit
// conversions keep ranges; and a branch on a phi of `&&` or `||` is
// threaded from the predecessor that decided it, so that the facts on the
// way hold where it leads.

// The facts at a block: pairs (comparison or bool value, holds).
use crate::base::{IntVec, alloc_array, free};
use crate::types::{TY_BOOL, int_bits, is_integer, is_signed};
use crate::ir::{
    BLOCKS, BLOCK_COUNT, Cond, INSTS, INST_COUNT, IRF, IRFUNCS, Op, Term, case_target, case_value,
    ir_append, ir_arg, ir_make, ir_operand, ir_operand_count, ir_switch_no_preds, ir_val, is_succ,
    pred_index, redirect_succ, verify_func,
};
use crate::lower::SSA_STACK;
use crate::opt::{
    add_pred_like, compute_dominators, dominates, remove_pred, remove_pred_at, remove_trivial_phis,
    remove_unreachable, resolve_all, simplify_cfg,
};
use crate::fold::{is_const, shift_amount};
use crate::loops::{
    LP_PARENT, LP_VALUES, add_pred_values, analyze_loops, block_array, innermost_loop, loop_count,
    loop_header, loop_latch, loop_preheader,
};
use crate::scev::{counted_loop, iv_start};
use crate::ir::Cond::{Eq, Ge, Gt, Le, Lt, Ne};

static mut FACTS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// (0.11) Changes of FACTS are counted (FACTS_VER); FACT_MARK[v] is
// MARK_STAMP when a comparison of FACTS has v as an operand, for the
// FACTS of version MARK_VER: narrow_by_facts looks at the facts only for
// such a v.
static mut FACTS_VER: i64 = 1;
static mut MARK_VER: i64 = 0;
static mut MARK_STAMP: i64 = 0;
static mut FACT_MARK: *i64 = 0 as *i64;
static mut MARK_CAP: i64 = 0;
// Per loop: the comparisons its counted test implies (0: none), made for
// the facts (not in any block).
static mut LOOP_FACT_LT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut LOOP_FACT_GE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Outcomes of a comparison as a set: 1 less, 2 equal, 4 greater.
fn cond_set(c: Cond) -> i64 {
    match c {
        Lt => 1,
        Le => 3,
        Eq => 2,
        Ne => 5,
        Gt => 4,
        Ge => 6,
    }
}

// The set with less and greater swapped (the operands swapped).
fn mirror_set(s: i64) -> i64 {
    (s & 2) | ((s & 1) << 2) | ((s & 4) >> 2)
}

fn is_order(c: Cond) -> bool {
    c != Eq && c != Ne
}

// A comparison instruction outside any block, for a fact.
fn fact_cmp(cond: Cond, ty: i64, a: i64, b: i64) -> i64 {
    let v = ir_make(Op::Cmp, TY_BOOL, a, b, 0);
    unsafe {
        INSTS[v].cond = cond;
        INSTS[v].imm2 = ty;
    }
    v
}

fn fact_const(value: i64, ty: i64) -> i64 {
    ir_make(Op::Const, ty, 0, 0, value)
}

// The facts of the counted loops of the function (after analyze_loops).
fn make_loop_facts() {
    LOOP_FACT_LT.count = 0;
    LOOP_FACT_GE.count = 0;
    for l in 0..loop_count() {
        let mut lt = 0;
        let mut ge = 0;
        let mut iv = 0;
        let mut step = 0;
        let mut n = 0;
        let mut ne = false;
        if loop_preheader(l) != 0 && loop_latch(l) != 0
            && counted_loop(l, &iv, &step, &n, &ne) && !ne {
            let latch = loop_latch(l);
            let ty = unsafe { INSTS[BLOCKS[latch].cond].imm2 };
            let start = iv_start(l, iv);
            if step == 1 {
                lt = fact_cmp(Lt, ty, iv, n);
                ge = fact_cmp(Ge, ty, iv, start);
            } else {
                lt = fact_cmp(Gt, ty, iv, n);
                ge = fact_cmp(Le, ty, iv, start);
            }
        }
        LOOP_FACT_LT.push(lt);
        LOOP_FACT_GE.push(ge);
    }
}

// The facts at the start of block b into FACTS.
fn collect_facts(b: i64) {
    unsafe {
        FACTS_VER += 1;
        FACTS.count = 0;
        let mut x = b;
        let mut steps = 0;
        while steps < 64 {
            steps += 1;
            if BLOCKS[x].preds.count == 1 {
                let p = BLOCKS[x].preds.data[0];
                edge_fact(p, x);
            }
            let up = BLOCKS[x].idom;
            if up == x || up == 0 {
                break;
            }
            x = up;
        }
        let mut l = innermost_loop(b);
        while l >= 0 {
            if l < LOOP_FACT_LT.count && LOOP_FACT_LT.data[l] != 0 {
                FACTS.push(LOOP_FACT_LT.data[l]);
                FACTS.push(1);
                FACTS.push(LOOP_FACT_GE.data[l]);
                FACTS.push(1);
            }
            l = LP_PARENT.data[l];
        }
    }
}

// The fact the edge p -> x gives (x reached by it), if any.
fn edge_fact(p: i64, x: i64) {
    unsafe {
        FACTS_VER += 1;
        if BLOCKS[p].term == Term::Branch && BLOCKS[p].s0 != BLOCKS[p].s1 {
            FACTS.push(ir_val(BLOCKS[p].cond));
            FACTS.push(if BLOCKS[p].s0 == x { 1 } else { 0 });
        } else if BLOCKS[p].term == Term::Switch && BLOCKS[p].s0 != x {
            // x is the target of exactly one case: the value is that case's.
            let mut found = -1;
            let mut count = 0;
            for i in 0..BLOCKS[p].ncases {
                if case_target(p, i) == x {
                    found = i;
                    count += 1;
                }
            }
            if count == 1 {
                let v = ir_val(BLOCKS[p].cond);
                let ty = INSTS[v].ty;
                FACTS.push(fact_cmp(Eq, ty, v, fact_const(case_value(p, found), ty)));
                FACTS.push(1);
            }
        }
    }
}

// v with conversions between 64-bit integer types (which change no bits)
// looked through: values equal as bits compare equal.
pub fn bits_of_value(v: i64) -> i64 {
    unsafe {
        let mut x = ir_val(v);
        while INSTS[x].op == Op::Conv && is_integer(INSTS[x].ty) && is_integer(INSTS[x].imm2)
            && int_bits(INSTS[x].ty) == 64 && int_bits(INSTS[x].imm2) == 64 {
            x = ir_val(INSTS[x].a);
        }
        x
    }
}

// ---- Ranges ----

fn type_min(ty: i64) -> i64 {
    if ty == TY_BOOL {
        return 0;
    }
    if !is_integer(ty) {
        return 0 - 9223372036854775807 - 1;
    }
    let bits = int_bits(ty);
    if is_signed(ty) {
        if bits == 64 { 0 - 9223372036854775807 - 1 } else { 0 - (1 << (bits - 1) as u64) }
    } else if bits == 64 {
        0 - 9223372036854775807 - 1
    } else {
        0
    }
}

fn type_max(ty: i64) -> i64 {
    if ty == TY_BOOL {
        return 1;
    }
    if !is_integer(ty) {
        return 9223372036854775807;
    }
    let bits = int_bits(ty);
    if bits == 64 {
        return 9223372036854775807;
    }
    if is_signed(ty) { (1 << (bits - 1) as u64) - 1 } else { (1 << bits as u64) - 1 }
}

// How deep range_of follows operands: 6 operations of two operands, more
// of one.
const RANGE_DEPTH: i64 = 24;

// The range of v (context-free): *lo and *hi.
fn range_of(v: i64, lo: *i64, hi: *i64, depth: i64) {
    unsafe {
        let ty = INSTS[v].ty;
        *lo = type_min(ty);
        *hi = type_max(ty);
        let op = INSTS[v].op;
        if op == Op::Const {
            *lo = INSTS[v].imm;
            *hi = INSTS[v].imm;
            return;
        }
        if depth > RANGE_DEPTH || !is_integer(ty) {
            return;
        }
        let a = INSTS[v].a;
        let b = INSTS[v].b;
        // (0.11) An operation with one operand to range costs less depth
        // than one with two: chains of constants added, shifted and
        // converted are followed further than trees.
        let next = if op == Op::Conv || op == Op::Rem || op == Op::Shr || is_const(a) || is_const(b) {
            depth + 1
        } else {
            depth + 4
        };
        if op == Op::And {
            let m = if is_const(b) { INSTS[b].imm } else if is_const(a) { INSTS[a].imm } else { -1 };
            if m >= 0 {
                *lo = 0;
                if m < *hi {
                    *hi = m;
                }
            }
        } else if op == Op::Rem && is_const(b) && INSTS[b].imm != 0 {
            let c = INSTS[b].imm;
            if !is_signed(ty) && c > 0 {
                *lo = 0;
                *hi = c - 1;
            } else if is_signed(ty) && c > 0 - 9223372036854775807 {
                let m = if c < 0 { 0 - c } else { c };
                let mut alo = 0;
                let mut ahi = 0;
                range_with_facts(a, &alo, &ahi, next);
                *lo = if alo >= 0 { 0 } else { 1 - m };
                *hi = if ahi <= 0 { 0 } else { m - 1 };
            }
        } else if op == Op::Phi {
            phi_range(v, lo, hi, depth);
        } else if op == Op::Shr && is_const(b) {
            let k = shift_amount(INSTS[b].imm, ty);
            let mut alo = 0;
            let mut ahi = 0;
            range_with_facts(a, &alo, &ahi, next);
            if is_signed(ty) {
                // (0.11) An arithmetic shift is monotone.
                *lo = alo >> k as u64;
                *hi = ahi >> k as u64;
            } else if k > 0 {
                *lo = 0;
                let max = if int_bits(ty) == 64 { 0 - 1 } else { type_max(ty) };
                *hi = ((max as u64) >> k) as i64;
                if alo >= 0 {
                    // (0.11) A non-negative operand: monotone too.
                    *lo = alo >> k as u64;
                    *hi = lesser(*hi, ahi >> k as u64);
                }
            }
        } else if op == Op::Conv && is_integer(INSTS[v].imm2) {
            let from = INSTS[v].imm2;
            if int_bits(from) == 64 && int_bits(ty) == 64 {
                // (0.11) The same bits: the same range in the signed view.
                range_with_facts(a, lo, hi, next);
            } else if int_bits(from) < int_bits(ty) || (int_bits(from) == int_bits(ty) && is_signed(from) == is_signed(ty)) {
                let mut alo = 0;
                let mut ahi = 0;
                range_with_facts(a, &alo, &ahi, next);
                // Widening keeps the value when it fits the new type.
                if alo >= type_min(ty) && ahi <= type_max(ty) && (is_signed(ty) || alo >= 0) {
                    *lo = alo;
                    *hi = ahi;
                }
            }
        } else if op == Op::Add || op == Op::Sub || op == Op::Mul || op == Op::Shl {
            // Interval arithmetic on the operands' ranges (with the facts of
            // the block applied to them), given up when a bound could leave
            // the type or overflow.
            let big = 4611686018427387904;
            let small = 2147483648;
            // (0.11) The cheaper operand first (a phi's range costs most):
            // when its range already gives up, the other is not needed.
            let mut alo = MIN_I64;
            let mut ahi = MAX_I64;
            let mut blo = MIN_I64;
            let mut bhi = MAX_I64;
            if op == Op::Shl || (INSTS[a].op == Op::Phi && INSTS[b].op != Op::Phi) {
                range_with_facts(b, &blo, &bhi, next);
                if usable_operand(op, blo, bhi, true) {
                    range_with_facts(a, &alo, &ahi, next);
                }
            } else {
                range_with_facts(a, &alo, &ahi, next);
                if usable_operand(op, alo, ahi, false) {
                    range_with_facts(b, &blo, &bhi, next);
                }
            }
            let mut rlo = 0;
            let mut rhi = 0;
            let mut ok = false;
            if op == Op::Add || op == Op::Sub {
                if alo > 0 - big && ahi < big && blo > 0 - big && bhi < big {
                    ok = true;
                    if op == Op::Add {
                        rlo = alo + blo;
                        rhi = ahi + bhi;
                    } else {
                        rlo = alo - bhi;
                        rhi = ahi - blo;
                    }
                }
            } else if op == Op::Mul {
                if alo > 0 - small && ahi < small && blo > 0 - small && bhi < small {
                    ok = true;
                    let p1 = alo * blo;
                    let p2 = alo * bhi;
                    let p3 = ahi * blo;
                    let p4 = ahi * bhi;
                    rlo = lesser(lesser(p1, p2), lesser(p3, p4));
                    rhi = greater(greater(p1, p2), greater(p3, p4));
                }
            } else if blo == bhi && blo >= 0 && blo < 32 && alo >= 0 && ahi < small {
                ok = true;
                rlo = alo << blo as u64;
                rhi = ahi << blo as u64;
            }
            if ok && rlo >= type_min(ty) && rhi <= type_max(ty)
                && (is_signed(ty) || int_bits(ty) < 64 || rlo >= 0) {
                *lo = rlo;
                *hi = rhi;
            }
        }
    }
}

// Whether an operand of range [lo, hi] (the amount, for a shift, when
// `amount`) leaves range_of's interval arithmetic for op a result.
fn usable_operand(op: Op, lo: i64, hi: i64, amount: bool) -> bool {
    if op == Op::Shl {
        return if amount { lo == hi && lo >= 0 && lo < 32 } else { lo >= 0 && hi < 2147483648 };
    }
    let bound = if op == Op::Mul { 2147483648 } else { 4611686018427387904 };
    lo > 0 - bound && hi < bound
}

fn lesser(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn greater(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

// The range of v, with the facts in FACTS that compare v itself with a
// constant applied.
fn range_with_facts(v: i64, lo: *i64, hi: *i64, depth: i64) {
    range_of(v, lo, hi, depth);
    narrow_by_facts(v, lo, hi, depth);
}

// The range of v at a block whose facts are in FACTS.
fn range_at(v: i64, lo: *i64, hi: *i64) {
    range_with_facts(v, lo, hi, 0);
}

// ---- Ranges of phis (0.11) ----
//
// A phi's range is the union of its operands' ranges, each at the end of
// its predecessor with the facts there and on the edge: a property of the
// phi wherever it is used, kept per generation (a change of the control
// flow starts a new one).
//
// The phis of a loop header are found together, as the operands coming
// back around the loop (from predecessors the header dominates) may depend
// on them: each phi is assumed in a range H, the operands coming back are
// ranged under those assumptions, and when every one falls in its phi's H,
// every phi is in its H always (by induction over the values they take,
// as H holds the entry operands). H is first the entry operands' range;
// a phi whose operands coming back leave it upward (downward) has that end
// widened to what the facts on those edges allow (an increasing induction
// variable below its loop's bound, with any step; a decreasing one above);
// failing that, its type's range, which proves nothing about it but holds.
// The assumptions are on a stack, as are the phis of other blocks while
// their operands are ranged (assumed to have their type's range if met
// again); a range found under an assumption made outside its own
// finding is not kept. At most PHI_NEST levels.

const PHI_NEST: i64 = 12;
// Phi ranges being found within one another (each may take facts with
// other values afresh: see FACT_NEST), at most PHI_FINDS.
const PHI_FINDS: i64 = 3;
static mut PR_ACTIVE: i64 = 0;
// The phis of a header found together (the others have their type's
// range).
const HEADER_PHIS: i64 = 8;
// How deep facts comparing with a value whose range bounds it are taken
// (within the ranging of such a value), and how deep they are now.
const FACT_RANGE_DEPTH: i64 = 3;
static mut FACT_NEST: i64 = 0;
const NO_TAINT: i64 = 1000000;

static mut RANGE_GEN: i64 = 1;
// Whether phis get ranges now: while a check's branch is decided (one way
// unreachable: a bounds check, an unwrap), where they pay for their cost.
static mut PHI_RANGES: bool = false;
// Phis whose range was found in this generation, and how many may be (the
// others have their type's range: a bound on the work in large functions).
static mut PR_WORK: i64 = 0;
const PR_BUDGET: i64 = 5000;
static mut PR_GEN: *i64 = 0 as *i64;
static mut PR_LO: *i64 = 0 as *i64;
static mut PR_HI: *i64 = 0 as *i64;
static mut PR_CAP: i64 = 0;
// The phis whose ranges are being found: (phi, assumed lo, assumed hi,
// frame), a frame numbering each push (so one names the whole stack below
// it, which cannot change while it is there).
static mut PR_STACK: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
const PR_STRIDE: i64 = 4;
static mut PR_FRAMES: i64 = 0;
// A range found under assumptions: kept for the stack it was found under
// (its top frame), within the generation.
static mut PT_GEN: *i64 = 0 as *i64;
static mut PT_FRAME: *i64 = 0 as *i64;
static mut PT_LO: *i64 = 0 as *i64;
static mut PT_HI: *i64 = 0 as *i64;
static mut PT_TAINT_OF: *i64 = 0 as *i64;
// The outermost level of PR_STACK whose assumption the range being found
// used (NO_TAINT: none).
static mut PR_TAINT: i64 = 1000000;
// FACTS put aside while a phi's operands are ranged at its predecessors.
static mut FACTS_SAVED: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The header phis being found (HR_FIELDS each): the phi, its type's range,
// the entry operands' range, the assumption, the operands coming back,
// how far the assumption was widened.
static mut HR: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
const HR_FIELDS: i64 = 10;
const HR_PHI: i64 = 0;
const HR_TLO: i64 = 1;
const HR_THI: i64 = 2;
const HR_RLO: i64 = 3;
const HR_RHI: i64 = 4;
const HR_HLO: i64 = 5;
const HR_HHI: i64 = 6;
const HR_BLO: i64 = 7;
const HR_BHI: i64 = 8;
const HR_STAGE: i64 = 9;
const MIN_I64: i64 = 0 - 9223372036854775807 - 1;
const MAX_I64: i64 = 9223372036854775807;

fn forget_phi_ranges() {
    unsafe {
        RANGE_GEN += 1;
        PR_WORK = 0;
    }
}

fn facts_save() -> i64 {
    unsafe {
        let mark = FACTS_SAVED.count;
        for i in 0..FACTS.count {
            FACTS_SAVED.push(FACTS.data[i]);
        }
        FACTS_SAVED.push(FACTS.count);
        mark
    }
}

fn facts_restore(mark: i64) {
    unsafe {
        let n = FACTS_SAVED.data[FACTS_SAVED.count - 1];
        FACTS_VER += 1;
        FACTS.count = 0;
        for i in 0..n {
            FACTS.push(FACTS_SAVED.data[mark + i]);
        }
        FACTS_SAVED.count = mark;
    }
}

// The facts at the end of predecessor p of h, and on the edge, in FACTS.
fn edge_facts(p: i64, h: i64) {
    collect_facts(p);
    edge_fact(p, h);
}

fn is_back_edge(p: i64, h: i64) -> bool {
    dominates(h, p)
}

fn has_back_edge(h: i64) -> bool {
    unsafe {
        for i in 0..BLOCKS[h].preds.count {
            let p = BLOCKS[h].preds.data[i];
            if BLOCKS[p].order >= 0 && is_back_edge(p, h) {
                return true;
            }
        }
        false
    }
}

// Whether phi v's range is kept, or being found.
fn phi_known(v: i64) -> bool {
    unsafe {
        if v < PR_CAP && PR_GEN[v] == RANGE_GEN {
            return true;
        }
        let mut k = 0;
        while k < PR_STACK.count {
            if PR_STACK.data[k] == v {
                return true;
            }
            k += PR_STRIDE;
        }
        false
    }
}

fn pr_push(v: i64, lo: i64, hi: i64) {
    unsafe {
        PR_STACK.push(v);
        PR_STACK.push(lo);
        PR_STACK.push(hi);
        PR_FRAMES += 1;
        PR_STACK.push(PR_FRAMES);
    }
}

// Starts finding ranges at stack level `level`: the taint so far, set
// aside.
fn taint_enter() -> i64 {
    unsafe {
        let outer = PR_TAINT;
        PR_TAINT = NO_TAINT;
        outer
    }
}

// Ends it: the outermost level whose assumption what was found used (at
// least `level`: none from outside, it may be kept).
fn taint_leave(level: i64, outer: i64) -> i64 {
    unsafe {
        let taint = PR_TAINT;
        PR_TAINT = if taint < level { lesser(outer, taint) } else { outer };
        taint
    }
}

fn top_frame() -> i64 {
    unsafe { if PR_STACK.count == 0 { 0 } else { PR_STACK.data[PR_STACK.count - 1] } }
}

// Keeps phi v's range [lo, hi], found at stack level `level` using the
// assumptions down to level `taint`.
fn pr_keep(v: i64, lo: i64, hi: i64, level: i64, taint: i64) {
    unsafe {
        if taint >= level {
            PR_GEN[v] = RANGE_GEN;
            PR_LO[v] = lo;
            PR_HI[v] = hi;
        } else {
            PT_GEN[v] = RANGE_GEN;
            PT_FRAME[v] = top_frame();
            PT_LO[v] = lo;
            PT_HI[v] = hi;
            PT_TAINT_OF[v] = taint;
        }
    }
}

// The range of phi v (*lo and *hi hold its type's on entry).
fn phi_range(v: i64, lo: *i64, hi: *i64, depth: i64) {
    unsafe {
        if PR_CAP <= INST_COUNT {
            free(PR_GEN as *u8);
            free(PR_LO as *u8);
            free(PR_HI as *u8);
            free(PT_GEN as *u8);
            free(PT_FRAME as *u8);
            free(PT_LO as *u8);
            free(PT_HI as *u8);
            free(PT_TAINT_OF as *u8);
            PR_CAP = 2 * INST_COUNT + 1024;
            PR_GEN = alloc_array::<i64>(PR_CAP);
            PR_LO = alloc_array::<i64>(PR_CAP);
            PR_HI = alloc_array::<i64>(PR_CAP);
            PT_GEN = alloc_array::<i64>(PR_CAP);
            PT_FRAME = alloc_array::<i64>(PR_CAP);
            PT_LO = alloc_array::<i64>(PR_CAP);
            PT_HI = alloc_array::<i64>(PR_CAP);
            PT_TAINT_OF = alloc_array::<i64>(PR_CAP);
        }
        if PR_GEN[v] == RANGE_GEN {
            *lo = PR_LO[v];
            *hi = PR_HI[v];
            return;
        }
        if PT_GEN[v] == RANGE_GEN && PT_FRAME[v] == top_frame() {
            // (Found under this very stack: under the same assumptions.)
            *lo = PT_LO[v];
            *hi = PT_HI[v];
            if PT_TAINT_OF[v] < PR_TAINT {
                PR_TAINT = PT_TAINT_OF[v];
            }
            return;
        }
        let mut k = 0;
        while k < PR_STACK.count {
            if PR_STACK.data[k] == v {
                *lo = PR_STACK.data[k + 1];
                *hi = PR_STACK.data[k + 2];
                if k / PR_STRIDE < PR_TAINT {
                    PR_TAINT = k / PR_STRIDE;
                }
                return;
            }
            k += PR_STRIDE;
        }
        let h = INSTS[v].block;
        if !PHI_RANGES || PR_STACK.count >= PR_STRIDE * PHI_NEST || PR_ACTIVE >= PHI_FINDS || PR_WORK >= PR_BUDGET
            || h == 0 || BLOCKS[h].order < 0
            || INSTS[v].nargs != BLOCKS[h].preds.count {
            return;
        }
        PR_WORK += 1;
        if has_back_edge(h) {
            header_ranges(h, v, lo, hi, depth);
            return;
        }
        // In a loop, its header's phis first (they may be what v's operands
        // come from).
        let l = innermost_loop(h);
        if l >= 0 && l < loop_count() {
            let hh = loop_header(l);
            let first = BLOCKS[hh].first;
            if hh != h && BLOCKS[hh].order >= 0 && first != 0 && INSTS[first].op == Op::Phi && !phi_known(first)
                && is_integer(INSTS[first].ty) && INSTS[first].nargs == BLOCKS[hh].preds.count
                && has_back_edge(hh) {
                let mut ilo = type_min(INSTS[first].ty);
                let mut ihi = type_max(INSTS[first].ty);
                header_ranges(hh, first, &ilo, &ihi, depth);
            }
        }
        let tlo = *lo;
        let thi = *hi;
        let level = PR_STACK.count / PR_STRIDE;
        let outer = taint_enter();
        let mark = facts_save();
        // (A phi's range does not depend on where it is asked for: kept,
        // it must not depend on how deep that was.)
        let fact_nest = FACT_NEST;
        FACT_NEST = 0;
        PR_ACTIVE += 1;
        pr_push(v, tlo, thi);
        let mut rlo = thi;
        let mut rhi = tlo;
        for i in 0..INSTS[v].nargs {
            let p = BLOCKS[h].preds.data[i];
            if BLOCKS[p].order < 0 {
                continue;
            }
            edge_facts(p, h);
            let mut alo = 0;
            let mut ahi = 0;
            range_with_facts(ir_val(ir_arg(v, i)), &alo, &ahi, 1);
            rlo = lesser(rlo, alo);
            rhi = greater(rhi, ahi);
        }
        PR_STACK.count -= PR_STRIDE;
        facts_restore(mark);
        FACT_NEST = fact_nest;
        PR_ACTIVE -= 1;
        if rlo > rhi {
            rlo = tlo;
            rhi = thi;
        }
        rlo = greater(rlo, tlo);
        rhi = lesser(rhi, thi);
        let taint = taint_leave(level, outer);
        pr_keep(v, rlo, rhi, level, taint);
        *lo = rlo;
        *hi = rhi;
    }
}

// The ranges of the integer phis of loop header h (the first HEADER_PHIS),
// found together; *lo and *hi for v among them (its type's range on
// entry).
fn header_ranges(h: i64, v: i64, lo: *i64, hi: *i64, depth: i64) {
    unsafe {
        let base = HR.count;
        let mut n = 0;
        let mut phi = BLOCKS[h].first;
        while phi != 0 && INSTS[phi].op == Op::Phi && n < HEADER_PHIS {
            let ty = INSTS[phi].ty;
            if is_integer(ty) && INSTS[phi].nargs == BLOCKS[h].preds.count && !phi_known(phi) {
                HR.push(phi);
                HR.push(type_min(ty));
                HR.push(type_max(ty));
                HR.push(type_max(ty));
                HR.push(type_min(ty));
                for _ in 5..HR_FIELDS {
                    HR.push(0);
                }
                n += 1;
            }
            phi = INSTS[phi].next;
        }
        let level = PR_STACK.count / PR_STRIDE;
        if n == 0 || PR_STACK.count + PR_STRIDE * n > PR_STRIDE * PHI_NEST {
            HR.count = base;
            return;
        }
        let outer = taint_enter();
        let mark = facts_save();
        let fact_nest = FACT_NEST;
        FACT_NEST = 0;
        PR_ACTIVE += 1;
        // The entry operands.
        let mut entries = 0;
        for i in 0..BLOCKS[h].preds.count {
            let p = BLOCKS[h].preds.data[i];
            if BLOCKS[p].order < 0 || is_back_edge(p, h) {
                continue;
            }
            entries += 1;
            edge_facts(p, h);
            for m in 0..n {
                let e = base + m * HR_FIELDS;
                let mut alo = 0;
                let mut ahi = 0;
                range_with_facts(ir_val(ir_arg(HR.data[e + HR_PHI], i)), &alo, &ahi, 1);
                HR.data[e + HR_RLO] = lesser(HR.data[e + HR_RLO], alo);
                HR.data[e + HR_RHI] = greater(HR.data[e + HR_RHI], ahi);
            }
        }
        let mut settled = entries > 0;
        if settled {
            for m in 0..n {
                let e = base + m * HR_FIELDS;
                HR.data[e + HR_HLO] = HR.data[e + HR_RLO];
                HR.data[e + HR_HHI] = HR.data[e + HR_RHI];
            }
            // Each round ranges the operands coming back under the
            // assumptions, then widens those they leave (each at most three
            // times).
            settled = false;
            for _ in 0..3 * n + 1 {
                for m in 0..n {
                    let e = base + m * HR_FIELDS;
                    pr_push(HR.data[e + HR_PHI], HR.data[e + HR_HLO], HR.data[e + HR_HHI]);
                    HR.data[e + HR_BLO] = MAX_I64;
                    HR.data[e + HR_BHI] = MIN_I64;
                }
                for i in 0..BLOCKS[h].preds.count {
                    let p = BLOCKS[h].preds.data[i];
                    if BLOCKS[p].order < 0 || !is_back_edge(p, h) {
                        continue;
                    }
                    edge_facts(p, h);
                    for m in 0..n {
                        let e = base + m * HR_FIELDS;
                        let mut blo = 0;
                        let mut bhi = 0;
                        range_with_facts(ir_val(ir_arg(HR.data[e + HR_PHI], i)), &blo, &bhi, 1);
                        HR.data[e + HR_BLO] = lesser(HR.data[e + HR_BLO], blo);
                        HR.data[e + HR_BHI] = greater(HR.data[e + HR_BHI], bhi);
                    }
                }
                PR_STACK.count -= PR_STRIDE * n;
                let mut widened = false;
                for m in 0..n {
                    let e = base + m * HR_FIELDS;
                    let blo = HR.data[e + HR_BLO];
                    let bhi = HR.data[e + HR_BHI];
                    let hlo = HR.data[e + HR_HLO];
                    let hhi = HR.data[e + HR_HHI];
                    if blo >= hlo && bhi <= hhi {
                        continue;
                    }
                    widened = true;
                    HR.data[e + HR_STAGE] += 1;
                    if HR.data[e + HR_STAGE] == 1 {
                        HR.data[e + HR_HLO] = lesser(hlo, blo);
                        HR.data[e + HR_HHI] = greater(hhi, bhi);
                    } else if HR.data[e + HR_STAGE] == 2 {
                        let mut flo = 0;
                        let mut fhi = 0;
                        back_fact_hull(h, HR.data[e + HR_PHI], HR.data[e + HR_TLO], HR.data[e + HR_THI], &flo, &fhi);
                        if blo < hlo {
                            HR.data[e + HR_HLO] = lesser(hlo, flo);
                        }
                        if bhi > hhi {
                            HR.data[e + HR_HHI] = greater(hhi, fhi);
                        }
                    } else {
                        HR.data[e + HR_HLO] = HR.data[e + HR_TLO];
                        HR.data[e + HR_HHI] = HR.data[e + HR_THI];
                    }
                }
                if !widened {
                    settled = true;
                    break;
                }
            }
        }
        facts_restore(mark);
        FACT_NEST = fact_nest;
        PR_ACTIVE -= 1;
        let taint = taint_leave(level, outer);
        let keep = taint >= level;
        for m in 0..n {
            let e = base + m * HR_FIELDS;
            let tlo = HR.data[e + HR_TLO];
            let thi = HR.data[e + HR_THI];
            let mut rlo = tlo;
            let mut rhi = thi;
            if settled {
                rlo = greater(tlo, lesser(HR.data[e + HR_RLO], HR.data[e + HR_BLO]));
                rhi = lesser(thi, greater(HR.data[e + HR_RHI], HR.data[e + HR_BHI]));
            }
            let p = HR.data[e + HR_PHI];
            pr_keep(p, rlo, rhi, level, taint);
            if p == v {
                *lo = rlo;
                *hi = rhi;
            }
        }
        HR.count = base;
    }
}

// What the facts on the edges into h coming back say of phi v's operands
// there (of type range [tlo, thi]), alone.
fn back_fact_hull(h: i64, v: i64, tlo: i64, thi: i64, lo: *i64, hi: *i64) {
    unsafe {
        let mut rlo = thi;
        let mut rhi = tlo;
        for i in 0..INSTS[v].nargs {
            let p = BLOCKS[h].preds.data[i];
            if BLOCKS[p].order < 0 || !is_back_edge(p, h) {
                continue;
            }
            edge_facts(p, h);
            let mut olo = tlo;
            let mut ohi = thi;
            narrow_by_facts(ir_val(ir_arg(v, i)), &olo, &ohi, 1);
            rlo = lesser(rlo, olo);
            rhi = greater(rhi, ohi);
        }
        *lo = rlo;
        *hi = rhi;
    }
}

// Prepares the range queries of value_range_at for function fi: its
// loops and their facts (again after its control flow changes).
pub fn prepare_ranges(fi: i64) {
    analyze_loops(fi);
    make_loop_facts();
    forget_phi_ranges();
}

// The range of integer value v at block b (the signed 64-bit view of its
// canonical value): from its operations and the facts that hold at b.
pub fn value_range_at(v: i64, b: i64, lo: *i64, hi: *i64) {
    collect_facts(b);
    range_at(v, lo, hi);
}

// Narrows [*lo, *hi], the range of v, by the facts in FACTS comparing v
// with a constant, or (0.11; not too deep) with a value whose range bounds
// it: v < w gives v < w's upper bound, v > w v > w's lower one, v == w
// w's range (an unsigned comparison only with a non-negative w).
fn narrow_by_facts(v: i64, lo: *i64, hi: *i64, depth: i64) {
    unsafe {
        if MARK_VER != FACTS_VER {
            mark_facts();
        }
        let x0 = bits_of_value(v);
        if x0 < MARK_CAP && FACT_MARK[x0] != MARK_STAMP {
            return;
        }
        let mut i = 0;
        while i < FACTS.count {
            let f = FACTS.data[i];
            let holds = FACTS.data[i + 1] != 0;
            i += 2;
            if INSTS[f].op != Op::Cmp || !is_integer(INSTS[f].imm2) {
                continue;
            }
            let mut cond = INSTS[f].cond;
            if !holds {
                cond = cond.negate();
            }
            let fa = bits_of_value(INSTS[f].a);
            let fb = bits_of_value(INSTS[f].b);
            let x = bits_of_value(v);
            let mut k = 0;
            let mut w = 0;
            if fa == x && fa != fb {
                w = fb;
            } else if fb == x && fa != fb {
                w = fa;
                cond = cond.mirror();
            } else {
                continue;
            }
            let signed = is_signed(INSTS[f].imm2);
            let min = 0 - 9223372036854775807 - 1;
            let max = 9223372036854775807;
            // The bound w gives: k for a constant; else its range's upper end
            // for < and <=, its lower end for > and >=, both for ==.
            let mut klo = 0;
            if is_const(w) {
                k = INSTS[w].imm;
                klo = k;
            } else {
                if FACT_NEST >= FACT_RANGE_DEPTH || cond == Ne {
                    continue;
                }
                let mut whi = 0;
                FACT_NEST += 1;
                range_with_facts(w, &klo, &whi, depth + 1);
                FACT_NEST -= 1;
                if !signed && klo < 0 {
                    continue;
                }
                k = if cond == Gt || cond == Ge { klo } else { whi };
            }
            match cond {
                Eq => {
                    if is_const(w) {
                        *lo = k;
                        *hi = k;
                    } else if klo <= *hi && k >= *lo {
                        *lo = greater(*lo, klo);
                        *hi = lesser(*hi, k);
                    }
                }
                Ne => {
                    if *lo == k && k != max {
                        *lo = k + 1;
                    } else if *hi == k && k != min {
                        *hi = k - 1;
                    }
                }
                Lt | Le => {
                    let bound = if cond == Lt { if k == min { min } else { k - 1 } } else { k };
                    if signed || (k >= 0 && *lo >= 0) {
                        if bound < *hi {
                            *hi = bound;
                        }
                    } else if k >= 0 {
                        // Unsigned: below a non-negative bound, so non-negative.
                        if *lo < 0 {
                            *lo = 0;
                        }
                        if bound < *hi {
                            *hi = bound;
                        }
                    }
                }
                _ => {
                    let bound = if cond == Gt { if k == max { max } else { k + 1 } } else { k };
                    if signed || (k >= 0 && *lo >= 0) {
                        if bound > *lo {
                            *lo = bound;
                        }
                    }
                }
            }
        }
    }
}

// Whether range [lo, hi] of comparison operand v can help decide it: not
// its type's whole range, and for an unsigned order not of unknown sign.
fn bounds_something(v: i64, lo: i64, hi: i64, signed: bool, order: bool) -> bool {
    unsafe {
        let ty = INSTS[v].ty;
        if lo <= type_min(ty) && hi >= type_max(ty) {
            return false;
        }
        signed || !order || lo >= 0
    }
}

// Marks the operands of the comparisons in FACTS (see FACT_MARK).
fn mark_facts() {
    unsafe {
        if MARK_CAP <= INST_COUNT {
            free(FACT_MARK as *u8);
            MARK_CAP = 2 * INST_COUNT + 1024;
            FACT_MARK = alloc_array::<i64>(MARK_CAP);
        }
        MARK_STAMP += 1;
        let mut i = 0;
        while i < FACTS.count {
            let f = FACTS.data[i];
            i += 2;
            if INSTS[f].op != Op::Cmp {
                continue;
            }
            let fa = bits_of_value(INSTS[f].a);
            let fb = bits_of_value(INSTS[f].b);
            if fa < MARK_CAP {
                FACT_MARK[fa] = MARK_STAMP;
            }
            if fb < MARK_CAP {
                FACT_MARK[fb] = MARK_STAMP;
            }
        }
        MARK_VER = FACTS_VER;
    }
}

// The outcomes possible for intervals a and b.
fn interval_outcomes(alo: i64, ahi: i64, blo: i64, bhi: i64) -> i64 {
    let mut s = 0;
    if alo < bhi {
        s |= 1;
    }
    if alo <= bhi && blo <= ahi {
        s |= 2;
    }
    if ahi > blo {
        s |= 4;
    }
    s
}

// Whether comparison or bool c holds at a block with facts FACTS: 1 true,
// 0 false, -1 unknown.
fn decide(c: i64) -> i64 {
    unsafe {
        let mut i = 0;
        while i < FACTS.count {
            if FACTS.data[i] == c {
                return FACTS.data[i + 1];
            }
            i += 2;
        }
        if INSTS[c].op != Op::Cmp || !is_integer(INSTS[c].imm2) {
            return -1;
        }
        let a = bits_of_value(INSTS[c].a);
        let b = bits_of_value(INSTS[c].b);
        let q = cond_set(INSTS[c].cond);
        let signed = is_signed(INSTS[c].imm2);
        // (0.11) The cheaper side first (a phi's range costs most): when its
        // range bounds nothing, the other's cannot decide anything.
        let mut alo = MIN_I64;
        let mut ahi = MAX_I64;
        let mut blo = MIN_I64;
        let mut bhi = MAX_I64;
        let order = is_order(INSTS[c].cond);
        if INSTS[a].op == Op::Phi && INSTS[b].op != Op::Phi {
            range_at(b, &blo, &bhi);
            if bounds_something(b, blo, bhi, signed, order) {
                range_at(a, &alo, &ahi);
            }
        } else {
            range_at(a, &alo, &ahi);
            if bounds_something(a, alo, ahi, signed, order) {
                range_at(b, &blo, &bhi);
            }
        }
        let nonneg = alo >= 0 && blo >= 0;
        let mut outcomes = 7;
        if a == b {
            outcomes = 2;
        }
        if signed || nonneg || !is_order(INSTS[c].cond) {
            outcomes &= interval_outcomes(alo, ahi, blo, bhi);
        }
        i = 0;
        while i < FACTS.count {
            let f = FACTS.data[i];
            let holds = FACTS.data[i + 1] != 0;
            i += 2;
            if INSTS[f].op != Op::Cmp || !is_integer(INSTS[f].imm2) {
                continue;
            }
            let fa = bits_of_value(INSTS[f].a);
            let fb = bits_of_value(INSTS[f].b);
            let mut fs = cond_set(INSTS[f].cond);
            if !holds {
                fs = 7 & ~fs;
            }
            if fa == b && fb == a {
                fs = mirror_set(fs);
            } else if fa != a || fb != b {
                continue;
            }
            let fsigned = is_signed(INSTS[f].imm2);
            if fs == 2 || fs == 5 || fsigned == signed || nonneg {
                outcomes &= fs;
            } else if fsigned && !signed && alo >= 0 && (fs & 4) == 0 {
                // a <s b (or <=) with a >= 0: both are non-negative, and the
                // unsigned order is the same.
                outcomes &= fs;
            }
        }
        if outcomes == 0 {
            return -1;
        }
        if (outcomes & ~q) == 0 {
            return 1;
        }
        if (outcomes & q) == 0 {
            return 0;
        }
        -1
    }
}

// ---- The pass ----

// Decides the branches of fi whose condition the facts and ranges decide,
// threads edges past blocks whose test the edge decides, and turns chains
// of equality tests into switches. Returns whether anything changed.
pub fn fold_by_ranges(fi: i64) -> bool {
    unsafe {
        IRF = fi;
        resolve_all(fi);
        let mut changed = thread_phi_conditions(fi);
        if changed {
            resolve_all(fi);
            remove_unreachable(fi);
            remove_trivial_phis(fi);
            resolve_all(fi);
        }
        analyze_loops(fi);
        make_loop_facts();
        for round in 0..3 {
            if round > 0 {
                resolve_all(fi);
                analyze_loops(fi);
            }
            forget_phi_ranges();
            let mut folded = false;
            for i in 0..IRFUNCS[fi].blocks.count {
                let b = IRFUNCS[fi].blocks.data[i];
                if BLOCKS[b].removed != 0 || BLOCKS[b].order < 0 || BLOCKS[b].term != Term::Branch {
                    continue;
                }
                let c = ir_val(BLOCKS[b].cond);
                if is_const(c) {
                    continue;
                }
                PHI_RANGES = is_check(BLOCKS[b].s0) || is_check(BLOCKS[b].s1);
                let d = decide_branch(b, c);
                PHI_RANGES = false;
                if d >= 0 {
                    let k = ir_make(Op::Const, TY_BOOL, 0, 0, d);
                    ir_append(b, k);
                    BLOCKS[b].cond = k;
                    folded = true;
                }
            }
            if folded {
                simplify_cfg(fi);
            }
            let threaded = thread_implied(fi);
            if !folded && !threaded {
                break;
            }
            changed = true;
        }
        if chains_to_switches(fi) {
            changed = true;
        }
        if changed {
            resolve_all(fi);
            remove_unreachable(fi);
            remove_trivial_phis(fi);
            verify_func(fi, c"value ranges");
        }
        changed
    }
}

// (0.11) A block holding nothing but a phi and a branch on it (what `&&`
// and `||` leave), the phi used by the branch alone: a predecessor that
// branched on the phi's operand for it decides the branch by the edge it
// takes, and goes on to the outcome directly (as instruction selection
// threads them; here, so that the facts on the way hold where the outcome
// is: in `i < n && s[i] < x`, i < n wherever the whole is true). Returns
// whether any edge was redirected.
fn thread_phi_conditions(fi: i64) -> bool {
    let mut changed = false;
    compute_exports(fi);
    unsafe {
        for i in 0..IRFUNCS[fi].blocks.count {
            let j = IRFUNCS[fi].blocks.data[i];
            if BLOCKS[j].removed != 0 || BLOCKS[j].term != Term::Branch || j == IRFUNCS[fi].entry {
                continue;
            }
            let phi = BLOCKS[j].first;
            let s0 = BLOCKS[j].s0;
            let s1 = BLOCKS[j].s1;
            if phi == 0 || INSTS[phi].op != Op::Phi || INSTS[phi].next != 0 || ir_val(BLOCKS[j].cond) != phi
                || used_outside_block(fi, j) || s0 == s1 || s0 == j || s1 == j
                || INSTS[phi].nargs != BLOCKS[j].preds.count {
                continue;
            }
            let mut k = 0;
            while k < BLOCKS[j].preds.count {
                let p = BLOCKS[j].preds.data[k];
                let value = ir_val(ir_arg(phi, k));
                if BLOCKS[p].term != Term::Branch || p == j || ir_val(BLOCKS[p].cond) != value
                    || (BLOCKS[p].s0 == j) == (BLOCKS[p].s1 == j) {
                    k += 1;
                    continue;
                }
                let t = if BLOCKS[p].s0 == j { s0 } else { s1 };
                let other = if BLOCKS[p].s0 == j { BLOCKS[p].s1 } else { BLOCKS[p].s0 };
                if t == other || t == p {
                    k += 1;
                    continue;
                }
                redirect_succ(p, j, t);
                add_pred_like(t, p, j);
                remove_pred_at(j, k);
                changed = true;
            }
        }
    }
    changed
}

// Whether block b is where a check fails: it ends the program.
fn is_check(b: i64) -> bool {
    unsafe { BLOCKS[b].term == Term::Unreach }
}

// Whether the condition c of block b's branch is decided: by the facts at
// b, or, for a phi of b, by the facts on each incoming edge alike.
fn decide_branch(b: i64, c: i64) -> i64 {
    unsafe {
        collect_facts(b);
        let d = decide(c);
        if d >= 0 || INSTS[c].op != Op::Phi || INSTS[c].block != b {
            return d;
        }
        let mut all = -1;
        for k in 0..INSTS[c].nargs {
            let p = BLOCKS[b].preds.data[k];
            if BLOCKS[p].term == Term::Switch
                || (BLOCKS[p].term == Term::Branch && BLOCKS[p].s0 == BLOCKS[p].s1) {
                return -1;
            }
            collect_facts(p);
            edge_fact(p, b);
            let dk = decide(ir_val(ir_arg(c, k)));
            if dk < 0 || (all >= 0 && dk != all) {
                return -1;
            }
            all = dk;
        }
        all
    }
}

// A block that only tests: no phis, its instructions pure (or constants)
// and used by its own branch alone.
fn is_test_block(fi: i64, j: i64) -> bool {
    unsafe {
        if BLOCKS[j].term != Term::Branch || j == IRFUNCS[fi].entry || BLOCKS[j].s0 == BLOCKS[j].s1 {
            return false;
        }
        let mut v = BLOCKS[j].first;
        let mut n = 0;
        while v != 0 {
            let op = INSTS[v].op;
            if op != Op::Const && !op.is_pure() {
                return false;
            }
            n += 1;
            v = INSTS[v].next;
        }
        n <= 4 && !used_outside_block(fi, j)
    }
}

// Per block id: whether a value defined in it is used in another block
// (compute_exports).
static mut EXPORTS: *i64 = 0 as *i64;
static mut EXPORTS_CAP: i64 = 0;

fn compute_exports(fi: i64) {
    unsafe {
        EXPORTS = block_array(EXPORTS, &EXPORTS_CAP, fi);
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if BLOCKS[b].removed != 0 {
                continue;
            }
            let mut v = BLOCKS[b].first;
            while v != 0 {
                for k in 0..ir_operand_count(v) {
                    let w = ir_operand(v, k);
                    if w != 0 && INSTS[w].block != 0 && INSTS[w].block != b {
                        EXPORTS[INSTS[w].block] = 1;
                    }
                }
                v = INSTS[v].next;
            }
            let c = BLOCKS[b].cond;
            if c != 0 && INSTS[c].block != 0 && INSTS[c].block != b {
                EXPORTS[INSTS[c].block] = 1;
            }
        }
    }
}

// Whether a value defined in block j is used in another block.
fn used_outside_block(fi: i64, j: i64) -> bool {
    let _ = fi;
    unsafe { j >= BLOCK_COUNT || EXPORTS[j] != 0 }
}

// Jump threading: a predecessor p of a test block j, where the test is
// decided (by p's facts and the edge p -> j), goes to j's outcome directly.
fn thread_implied(fi: i64) -> bool {
    let mut changed = false;
    compute_exports(fi);
    // One edge at a time: the facts need the dominators of the current CFG.
    for _ in 0..1000 {
        let mut did = false;
        compute_dominators(fi);
        unsafe {
            for i in 0..IRFUNCS[fi].blocks.count {
                if did {
                    break;
                }
                let j = IRFUNCS[fi].blocks.data[i];
                if BLOCKS[j].removed != 0 || BLOCKS[j].order < 0 || BLOCKS[j].preds.count < 2 {
                    continue;
                }
                if !is_test_block(fi, j) {
                    continue;
                }
                let c = ir_val(BLOCKS[j].cond);
                let mut k = 0;
                while k < BLOCKS[j].preds.count {
                    let p = BLOCKS[j].preds.data[k];
                    k += 1;
                    if BLOCKS[p].term == Term::Switch || BLOCKS[p].order < 0
                        || (BLOCKS[p].term == Term::Branch && BLOCKS[p].s0 == BLOCKS[p].s1) {
                        continue;
                    }
                    collect_facts(p);
                    edge_fact(p, j);
                    let d = decide(c);
                    if d < 0 {
                        continue;
                    }
                    let t = if d == 1 { BLOCKS[j].s0 } else { BLOCKS[j].s1 };
                    if is_succ(p, t) || t == j {
                        continue;
                    }
                    // p -> t: t's phis take their operand for j.
                    let index = pred_index(t, j);
                    let first = LP_VALUES.count;
                    let mut phi = BLOCKS[t].first;
                    while phi != 0 && INSTS[phi].op == Op::Phi {
                        LP_VALUES.push(ir_arg(phi, index));
                        phi = INSTS[phi].next;
                    }
                    redirect_succ(p, j, t);
                    add_pred_values(t, p, &LP_VALUES, first);
                    LP_VALUES.count = first;
                    remove_pred(j, p);
                    did = true;
                    break;
                }
            }
        }
        if !did {
            break;
        }
        changed = true;
        remove_unreachable(fi);
        forget_phi_ranges();
    }
    changed
}

// ---- Comparison chains ----

const CHAIN_MIN_CASES: i64 = 4;

// The value block b tests for equality with a constant (its branch's
// condition `x == k` or `x != k`): x, with *k and *equal (the successor
// taken when equal) and *other (taken otherwise); 0 when it is not such a
// test.
fn equality_test(b: i64, k: *i64, equal: *i64, other: *i64) -> i64 {
    unsafe {
        if BLOCKS[b].term != Term::Branch || BLOCKS[b].s0 == BLOCKS[b].s1 {
            return 0;
        }
        let c = ir_val(BLOCKS[b].cond);
        if INSTS[c].op != Op::Cmp || !is_integer(INSTS[c].imm2) {
            return 0;
        }
        let cond = INSTS[c].cond;
        if cond != Eq && cond != Ne {
            return 0;
        }
        let mut x = ir_val(INSTS[c].a);
        let mut kv = ir_val(INSTS[c].b);
        if is_const(x) {
            let t = x;
            x = kv;
            kv = t;
        }
        if !is_const(kv) || is_const(x) {
            return 0;
        }
        *k = INSTS[kv].imm;
        if cond == Eq {
            *equal = BLOCKS[b].s0;
            *other = BLOCKS[b].s1;
        } else {
            *equal = BLOCKS[b].s1;
            *other = BLOCKS[b].s0;
        }
        x
    }
}

// Whether block b holds only constants and the comparison of its branch,
// none used elsewhere.
fn only_test(fi: i64, b: i64) -> bool {
    unsafe {
        let c = ir_val(BLOCKS[b].cond);
        let mut v = BLOCKS[b].first;
        while v != 0 {
            if v != c && INSTS[v].op != Op::Const {
                return false;
            }
            v = INSTS[v].next;
        }
        !used_outside_block(fi, b)
    }
}

fn chains_to_switches(fi: i64) -> bool {
    let mut changed = false;
    compute_dominators(fi);
    compute_exports(fi);
    unsafe {
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if BLOCKS[b].removed != 0 || BLOCKS[b].order < 0
                || (BLOCKS[b].preds.count == 0 && b != IRFUNCS[fi].entry) {
                continue;
            }
            let mut k = 0;
            let mut eq = 0;
            let mut ne = 0;
            let x = equality_test(b, &k, &eq, &ne);
            if x == 0 {
                continue;
            }
            // The chain: b, then blocks reached when not equal, each with b's
            // chain as its only predecessor, testing x against a constant.
            let mut cases = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            let mut chain = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            cases.push(k);
            cases.push(eq);
            chain.push(b);
            let mut tail = ne;
            loop {
                let mut k2 = 0;
                let mut eq2 = 0;
                let mut ne2 = 0;
                if BLOCKS[tail].preds.count != 1 || tail == b || equality_test(tail, &k2, &eq2, &ne2) != x
                    || !only_test(fi, tail) {
                    break;
                }
                let mut dup = false;
                for m in 0..cases.count / 2 {
                    if cases.data[2 * m] == k2 {
                        dup = true;
                    }
                }
                if dup {
                    break;
                }
                cases.push(k2);
                cases.push(eq2);
                chain.push(tail);
                tail = ne2;
            }
            if cases.count / 2 >= CHAIN_MIN_CASES && chain_targets_ok(&cases, &chain, tail) {
                make_chain_switch(b, x, &cases, &chain, tail);
                changed = true;
            }
            free(cases.data as *u8);
            free(chain.data as *u8);
        }
    }
    if changed {
        remove_unreachable(fi);
    }
    changed
}

// Whether the chain's targets can take the switch block as their
// predecessor: a target reached by several edges of the chain must have no
// phis; no target is a block of the chain.
fn chain_targets_ok(cases: *IntVec, chain: *IntVec, default: i64) -> bool {
    unsafe {
        let n = (*cases).count / 2;
        for i in 0..n + 1 {
            let t = if i < n { (*cases).data[2 * i + 1] } else { default };
            for m in 0..(*chain).count {
                if (*chain).data[m] == t {
                    return false;
                }
            }
            let mut edges = 0;
            for m in 0..n + 1 {
                let u = if m < n { (*cases).data[2 * m + 1] } else { default };
                if u == t {
                    edges += 1;
                }
            }
            let first = BLOCKS[t].first;
            if edges > 1 && first != 0 && INSTS[first].op == Op::Phi {
                return false;
            }
        }
        true
    }
}

fn make_chain_switch(b: i64, x: i64, cases: *IntVec, chain: *IntVec, default: i64) {
    unsafe {
        let n = (*cases).count / 2;
        // The targets lose the chain blocks as predecessors and get b once.
        for i in 0..n + 1 {
            let t = if i < n { (*cases).data[2 * i + 1] } else { default };
            let from = if i < n { (*chain).data[i] } else { (*chain).data[(*chain).count - 1] };
            let index = pred_index(t, from);
            if index < 0 {
                continue;
            }
            if pred_index(t, b) >= 0 && b != from {
                remove_pred_at(t, index);
            } else {
                BLOCKS[t].preds.data[index] = b;
            }
        }
        // The other chain blocks lose their predecessor (they become
        // unreachable).
        for m in 1..(*chain).count {
            BLOCKS[(*chain).data[m]].preds.count = 0;
        }
        let mark = SSA_STACK.count;
        for i in 0..n {
            SSA_STACK.push((*cases).data[2 * i]);
            SSA_STACK.push((*cases).data[2 * i + 1]);
        }
        ir_switch_no_preds(b, x, default, mark);
    }
}
