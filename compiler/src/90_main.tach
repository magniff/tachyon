// The command line:
//
//   tachyonc <file.tach>... [-o out.s]   compile the files (one program)
//   tachyonc --tokens <file.tach>        print the tokens of one file
//   tachyonc --version                   print the release

fn usage() -> ! {
    die(c"usage: tachyonc <file.tach>... [-o out.s] | tachyonc --tokens <file.tach> | tachyonc --version")
}

// The release this source is; see docs/releases.md.
fn version() -> *u8 {
    c"tachyonc 1.0.0 (aarch64-apple-darwin)"
}

fn streq(a: *u8, b: *u8) -> bool {
    let n = strlen(a);
    n == strlen(b) && memcmp(a, b, n) == 0
}

fn main(argc: i32, argv: **u8) -> i32 {
    let mut inputs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    let mut output = c"a.s";
    let mut tokens_only = false;
    let mut i = 1;
    while i < argc as i64 {
        let arg = argv[i];
        if streq(arg, c"-o") {
            if i + 1 >= argc as i64 {
                usage();
            }
            output = argv[i + 1];
            i += 2;
            continue;
        }
        if streq(arg, c"--version") {
            write(STDOUT, version(), strlen(version()));
            write(STDOUT, c"\n", 1);
            return 0;
        }
        if streq(arg, c"--tokens") {
            tokens_only = true;
        } else {
            intvec_push(&inputs, arg as i64);
        }
        i += 1;
    }
    if inputs.count == 0 {
        usage();
    }
    ERR_KIND = c"tokenizer error";
    load_sources(inputs.data as **u8, inputs.count);
    ERRORS_AS_DUMP = tokens_only;
    init_lexer();
    for f in 0..FILE_COUNT {
        lex_range(FILES[f].start, FILES[f].end, f + 1 == FILE_COUNT);
    }
    if tokens_only {
        let out = buf_new();
        dump_tokens(out, FILES[0].start);
        buf_write_fd(out, STDOUT);
        return 0;
    }
    compile_program(output);
    0
}
