// Parser: tokens to the AST. Items and statements by recursive descent,
// expressions by a Pratt parser with the binding powers of
// docs/grammar.md. After a syntax error the parser goes on at the next
// statement or item (see parse_program and parse_block).

use crate::base::{
    ERR, IntVec, RECOVER_DEPTH, SRC, _setjmp, buf_bytes, err_begin, err_end, err_str, err_sym,
    error_at, fail_name, intern, intern_c, recover_enter, recover_leave,
};
use crate::lexer::{STRS, SUF_NONE, TOKS, TOK_COUNT, Tok};
use crate::ast::{
    ARM_NO_ELSE, ARM_SYNTHETIC, BLOCK_UNSAFE, FN_BODY_FAILED, FN_COLD, FN_INLINE, FN_NO_INLINE, FN_UNSAFE, NODES, NodeKind, REPR_C, REPR_INT,
    REPR_PACKED, REPR_UNION, SCRATCH, child, list_begin, list_end, list_push, new_node,
};
use crate::check::name_error;
use crate::target::LINK_NAMES;
use crate::lexer::Tok::{
    Amp, AmpAmp, AmpEq, Arrow, As, At, Bang, BangEq, Break, CStr, Caret, CaretEq, Char, Colon,
    ColonColon, Comma, Const, Continue, Defer, Dot, DotDot, DotDotEq, Ellipsis, Else, Enum, Eof, Eq,
    EqEq, Extern, False, FatArrow, Float, Fn, For, Gt, GtEq, Hash, Ident, If, Impl, Import, In, Int,
    LBrace, LBracket, LParen, Let, Loop, Lt, LtEq, Match, Minus, MinusEq, Mod, Mut, Percent,
    PercentEq, Pipe, PipeEq, PipePipe, Plus, PlusEq, Pub, Question, RBrace, RBracket, RParen,
    Reserved, Return, Semi, Shl, ShlEq, Shr, ShrEq, Slash, SlashEq, Star, StarEq, Static, Str,
    Struct, Tilde, Trait, True, Type, Union, Unsafe, Use, While,
};

static mut P: i64 = 0;
// In `if`/`while` conditions and `for` ranges, `Name {` starts the body.
static mut NO_STRUCT: bool = false;

const AS_BP: i64 = 24;
const PREFIX_BP: i64 = 25;
const POSTFIX_BP: i64 = 27;

fn tok_kind(offset: i64) -> Tok {
    let i = P + offset;
    if i >= TOK_COUNT { Eof } else { unsafe { TOKS[i].kind } }
}

fn cur() -> Tok {
    unsafe { TOKS[P].kind }
}

fn at(kind: Tok) -> bool {
    unsafe { TOKS[P].kind == kind }
}

fn cur_start() -> i64 {
    unsafe { TOKS[P].start }
}

// The end of the previous token.
fn prev_end() -> i64 {
    if P == 0 { 0 } else { unsafe { TOKS[P - 1].end } }
}

fn advance() {
    if unsafe { TOKS[P].kind != Eof } {
        P += 1;
    }
}

fn eat(kind: Tok) -> bool {
    if at(kind) {
        advance();
        return true;
    }
    false
}

fn err_token(i: i64) {
    unsafe {
        let kind = TOKS[i].kind;
        if kind == Ident || kind == Reserved || kind.is_keyword() {
            err_sym(TOKS[i].value as i64);
        } else if kind == Int || kind == Float || kind == Char {
            buf_bytes(ERR, SRC[TOKS[i].start..TOKS[i].end]);
        } else if kind == Str || kind == CStr {
            err_str(c"string literal");
        } else {
            err_str(kind.text());
        }
    }
}

fn syntax_error(message: *u8) -> ! {
    unsafe {
        err_begin(cur_start());
        err_str(message);
        err_str(c", got '");
        err_token(P);
        err_str(c"'");
        err_end()
    }
}

fn expect(kind: Tok) {
    unsafe {
        if !at(kind) {
            err_begin(cur_start());
            err_str(c"expected '");
            err_str(kind.text());
            err_str(c"', got '");
            err_token(P);
            err_str(c"'");
            err_end();
        }
        advance();
    }
}

fn reserved_error() -> ! {
    unsafe {
        err_begin(cur_start());
        err_str(c"'");
        err_token(P);
        if at(Reserved) {
            err_str(c"' is a reserved keyword (reserved for future use)");
        } else {
            err_str(c"' is reserved for future use");
        }
        err_end()
    }
}

pub static mut UNDERSCORE: i64 = -1;

fn expect_ident() -> i64 {
    unsafe {
        if at(Reserved) {
            reserved_error();
        }
        if !at(Ident) {
            syntax_error(c"expected identifier");
        }
        let sym = TOKS[P].value as i64;
        advance();
        sym
    }
}

// A name being declared: an identifier other than `_`.
fn expect_binding_name() -> i64 {
    unsafe {
        if at(Ident) && TOKS[P].value as i64 == UNDERSCORE {
            error_at(cur_start(), c"'_' cannot be used as a name here");
        }
        expect_ident()
    }
}

fn with_no_struct(value: bool) -> bool {
    let saved = NO_STRUCT;
    NO_STRUCT = value;
    saved
}

// ---- Items ----

pub fn parse_program() -> i64 {
    unsafe {
        UNDERSCORE = intern_c(c"_");
        let program = new_node(NodeKind::None, 0, 0);
        let mark = list_begin();
        while !at(Eof) {
            // A recovery point (see err_end): after an error, the parser goes
            // on at the next item.
            let depth = RECOVER_DEPTH;
            let items = SCRATCH.count;
            let start = P;
            BODY_FAILED = false;
            if _setjmp(recover_enter()) == 0 {
                parse_top_item();
                if BODY_FAILED {
                    // A syntax error in a block outside a function's body (a
                    // constant's initializer...): the item is left out.
                    for i in items..SCRATCH.count {
                        let kind = NODES[SCRATCH.data[i]].kind;
                        if kind != NodeKind::Impl && kind != NodeKind::Use {
                            fail_name(NODES[SCRATCH.data[i]].a);
                        }
                    }
                    SCRATCH.count = items;
                }
            } else {
                SCRATCH.count = items;
                NO_STRUCT = false;
                skip_to_item(start);
                fail_names(start, P);
            }
            recover_leave(depth);
        }
        list_end(program, mark);
        program
    }
}

// Whether a statement of the block being parsed had a syntax error (and
// was left out).
static mut BODY_FAILED: bool = false;

// After an error in the item starting at token `start`: on to the next
// token after it that starts an item at the beginning of a line.
fn skip_to_item(start: i64) {
    unsafe {
        P = start + 1;
        while !at(Eof) {
            let pos = TOKS[P].start;
            let line_start = pos == 0 || SRC[pos - 1] == '\n';
            if line_start && (is_item_start(cur()) || at(Pub) || at(Use) || at(Mod)
                || at(Import) || at(Hash) || at(Impl) || at(Unsafe) || at(Trait)) {
                return;
            }
            advance();
        }
    }
}

// The names the items in tokens start..end (skipped after an error)
// declare, and those a `use` among them imports, are failed names: the
// errors saying they are unknown are not reported (see err_failed_name).
fn fail_names(start: i64, end: i64) {
    unsafe {
        let mut in_use = false;
        for i in start..end {
            let kind = TOKS[i].kind;
            if kind == Use || kind == Import {
                in_use = true;
            } else if kind == Semi {
                in_use = false;
            }
            if i + 1 < end && TOKS[i + 1].kind == Ident && (in_use || kind == Fn || kind == Struct
                || kind == Union || kind == Enum || kind == Const || kind == Static || kind == Type
                || kind == Trait || kind == Mod) {
                fail_name(TOKS[i + 1].value as i64);
            }
        }
    }
}

// After an error in the statement starting at token `start`: past its `;`,
// or up to the `}` closing its block.
fn skip_statement(start: i64) {
    P = start;
    // The brackets open in the statement (a `}` also closes the `(` and
    // `[` left open inside its `{`).
    let mut open = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    while !at(Eof) {
        let kind = cur();
        if kind == LBrace || kind == LParen || kind == LBracket {
            open.push(kind as i64);
        } else if kind == RBrace || kind == RParen || kind == RBracket {
            if kind == RBrace {
                while unsafe { open.count > 0 && open.data[open.count - 1] != LBrace as i64 } {
                    open.count -= 1;
                }
            }
            if open.count == 0 {
                if kind == RBrace {
                    return;
                }
                // (a stray `)` or `]` is part of the statement that failed)
                advance();
                continue;
            }
            open.count -= 1;
            let depth = open.count;
            if depth == 0 && kind == RBrace && P > start {
                // A statement ending with a block (`if`, `while`, ...),
                // unless an `else` follows.
                advance();
                if !at(Else) {
                    return;
                }
                continue;
            }
        } else if kind == Semi && open.count == 0 {
            advance();
            return;
        }
        advance();
    }
}

// One item (or the several items of an impl or extern block), pushed to
// the program's list.
fn parse_top_item() {
    unsafe {
        let public = eat(Pub);
        if at(Impl) {
            // The functions of an impl block are items of the program.
            parse_impl(false);
        } else if at(Trait) {
            let item = parse_trait();
            mark_public(item, public);
            list_push(item);
        } else if at(Extern) {
            let mark = SCRATCH.count;
            parse_extern();
            for i in mark..SCRATCH.count {
                mark_public(SCRATCH.data[i], public);
            }
        } else if at(Import) {
            parse_import(public);
        } else if at(Use) {
            parse_use(public);
        } else if at(Mod) {
            let start = cur_start();
            advance();
            let n = new_node(NodeKind::Mod, start, 0);
            NODES[n].a = expect_binding_name();
            if eat(LBrace) {
                // `mod name { items }` (0.6): its items are the program's, in
                // the module the loader made for the braces (modules.tach).
                NODES[n].end = prev_end();
                mark_public(n, public);
                list_push(n);
                while !at(RBrace) && !at(Eof) {
                    parse_top_item();
                }
                expect(RBrace);
                return;
            }
            expect(Semi);
            NODES[n].end = prev_end();
            mark_public(n, public);
            list_push(n);
        } else if at(Hash) {
            let item = parse_attributed_item(public);
            list_push(item);
        } else {
            let item = parse_item();
            mark_public(item, public);
            list_push(item);
        }
    }
}

pub const ITEM_PUBLIC: i64 = 1;

fn mark_public(item: i64, public: bool) {
    if public {
        unsafe { NODES[item].p |= ITEM_PUBLIC; }
    }
}

fn parse_item() -> i64 {
    match cur() {
        Fn | Unsafe => parse_function(),
        Struct | Union => parse_struct(),
        Const => parse_const_or_static(NodeKind::Const),
        Static => parse_const_or_static(NodeKind::Static),
        Type => parse_type_alias(),
        Enum => parse_enum(),
        Reserved => reserved_error(),
        _ => unsafe { syntax_error(c"expected an item ('fn', 'extern', 'struct', 'union', 'enum', 'impl', 'const', 'static' or 'type')") },
    }
}

// `impl T { fn ... }`, `impl<T> Vec<T> { ... }` or `impl Vec<i64> { ... }`:
// each function is pushed as an item, marked with the type's name (d) and
// the type (h); the impl's type parameters come first in its own (g).
fn parse_impl(public: bool) {
    unsafe {
        let impl_start = cur_start();
        expect(Impl);
        let params = parse_generic_params();
        let mut self_type = parse_type();
        // `impl Trait for Type` (0.9): any type.
        let mut trait_name = 0;
        if eat(For) {
            trait_name = self_type;
            if NODES[trait_name].kind != NodeKind::TyName {
                error_at(NODES[trait_name].start, c"expected a trait's name before 'for'");
            }
            self_type = parse_type();
        } else if NODES[self_type].kind != NodeKind::TyName {
            error_at(NODES[self_type].start, c"impl blocks are for named types (structs and enums)");
        }
        let fns = SCRATCH.count;
        expect(LBrace);
        while !at(RBrace) && !at(Eof) {
            let attrs_start = cur_start();
            let flags = parse_fn_attributes();
            let item_public = eat(Pub) || public;
            if !at(Fn) && !(at(Unsafe) && tok_kind(1) == Fn) {
                if flags != 0 {
                    error_at(attrs_start, c"#[inline] and #[cold] go before a function");
                }
                syntax_error(c"expected 'fn' or '}' in an impl block");
            }
            let f = parse_function();
            NODES[f].p |= flags;
            NODES[f].d = if NODES[self_type].kind == NodeKind::TyName { NODES[self_type].a } else { UNDERSCORE };
            NODES[f].h = self_type;
            if params != 0 {
                NODES[f].g = merge_generics(params, NODES[f].g);
            }
            // (a trait's methods are as visible as the trait)
            mark_public(f, item_public || trait_name != 0);
            list_push(f);
        }
        expect(RBrace);
        if trait_name != 0 {
            let n = new_node(NodeKind::Impl, impl_start, prev_end());
            NODES[n].a = trait_name;
            NODES[n].b = self_type;
            NODES[n].g = params;
            let end = SCRATCH.count;
            let mark = list_begin();
            for i in fns..end {
                list_push(SCRATCH.data[i]);
            }
            list_end(n, mark);
            list_push(n);
        }
    }
}

// `trait Name { fn m(self: *Self) -> T; fn d(self: *Self) { ... } }` (0.9).
fn parse_trait() -> i64 {
    unsafe {
        let start = cur_start();
        expect(Trait);
        let n = new_node(NodeKind::Trait, start, 0);
        NODES[n].a = expect_binding_name();
        if at(Lt) {
            error_at(cur_start(), c"traits cannot have type parameters (yet)");
        }
        expect(LBrace);
        let mark = list_begin();
        while !at(RBrace) && !at(Eof) {
            let attrs_start = cur_start();
            let flags = parse_fn_attributes();
            if at(Pub) {
                error_at(cur_start(), c"the functions of a trait are as visible as the trait: no 'pub'");
            }
            if !at(Fn) && !(at(Unsafe) && tok_kind(1) == Fn) {
                if flags != 0 {
                    error_at(attrs_start, c"#[inline] and #[cold] go before a function");
                }
                syntax_error(c"expected 'fn' or '}' in a trait");
            }
            let fstart = cur_start();
            let is_unsafe = eat(Unsafe);
            expect(Fn);
            let f = new_node(NodeKind::Fn, fstart, 0);
            NODES[f].p |= flags;
            if is_unsafe {
                NODES[f].p |= FN_UNSAFE;
            }
            NODES[f].a = expect_binding_name();
            NODES[f].g = parse_generic_params();
            expect(LParen);
            parse_params(f, false);
            expect(RParen);
            NODES[f].b = parse_return_type();
            if !eat(Semi) {
                NODES[f].c = parse_fn_body(f);
            }
            NODES[f].end = prev_end();
            list_push(f);
        }
        list_end(n, mark);
        expect(RBrace);
        NODES[n].end = prev_end();
        n
    }
}

// The parameters of an impl block followed by those of one of its
// functions (`a` counts the impl's).
fn merge_generics(outer: i64, own: i64) -> i64 {
    unsafe {
        let n = new_node(NodeKind::Generics, NODES[outer].start, NODES[outer].end);
        let mark = list_begin();
        for i in 0..NODES[outer].count {
            list_push(child(outer, i));
        }
        if own != 0 {
            for i in 0..NODES[own].count {
                list_push(child(own, i));
            }
        }
        list_end(n, mark);
        NODES[n].a = NODES[outer].count;
        n
    }
}

// `<T, U>` after the name of a generic item (0.5); 0 when there is none.
fn parse_generic_params() -> i64 {
    unsafe {
        if !at(Lt) {
            return 0;
        }
        let n = new_node(NodeKind::Generics, cur_start(), 0);
        advance();
        let mark = list_begin();
        while !at(Gt) && !at(Eof) {
            let param = new_node(NodeKind::TyName, cur_start(), 0);
            NODES[param].a = expect_binding_name();
            NODES[param].end = prev_end();
            if eat(Colon) {
                // Bounds (0.9): `T: Hash + Eq`, a Generics node of trait names.
                let bounds = new_node(NodeKind::Generics, cur_start(), 0);
                let bmark = list_begin();
                loop {
                    list_push(parse_type());
                    if !eat(Plus) {
                        break;
                    }
                }
                list_end(bounds, bmark);
                NODES[bounds].end = prev_end();
                NODES[param].h = bounds;
            }
            for i in mark..SCRATCH.count {
                if NODES[SCRATCH.data[i]].a == NODES[param].a {
                    name_error(NODES[param].start, c"duplicate type parameter '", NODES[param].a, c"'");
                }
            }
            list_push(param);
            if !eat(Comma) {
                break;
            }
        }
        list_end(n, mark);
        if NODES[n].count == 0 {
            error_at(NODES[n].start, c"expected a type parameter");
        }
        expect(Gt);
        NODES[n].end = prev_end();
        n
    }
}

// `<A, B>` type arguments (after a type's name, or `::` in an
// expression); the `>` of `>>` (and of `>=`, `>>=`) is split off.
fn parse_type_args() -> i64 {
    unsafe {
        let n = new_node(NodeKind::Generics, cur_start(), 0);
        expect(Lt);
        let mark = list_begin();
        while !at_gt() && !at(Eof) {
            list_push(parse_type());
            if !eat(Comma) {
                break;
            }
        }
        list_end(n, mark);
        if NODES[n].count == 0 {
            error_at(NODES[n].start, c"expected a type argument");
        }
        expect_gt();
        NODES[n].end = prev_end();
        n
    }
}

fn at_gt() -> bool {
    at(Gt) || at(Shr) || at(GtEq) || at(ShrEq)
}

fn expect_gt() {
    let kind = cur();
    if kind == Shr || kind == GtEq || kind == ShrEq {
        // Keep the rest of the token: `>`, `=` or `>=`.
        unsafe {
            TOKS[P].kind = if kind == Shr { Gt } else if kind == GtEq { Eq } else { GtEq };
            TOKS[P].start += 1;
        }
        return;
    }
    expect(Gt);
}

// `enum E { A, B(T, ...), C = expr, ... }`
fn parse_enum() -> i64 {
    unsafe {
        let start = cur_start();
        expect(Enum);
        let n = new_node(NodeKind::Enum, start, 0);
        NODES[n].a = expect_binding_name();
        NODES[n].g = parse_generic_params();
        expect(LBrace);
        let mark = list_begin();
        while !at(RBrace) && !at(Eof) {
            let variant = new_node(NodeKind::Variant, cur_start(), 0);
            NODES[variant].a = expect_binding_name();
            if at(LBrace) {
                error_at(cur_start(), c"struct-like enum variants are not supported yet; use a tuple variant");
            }
            if eat(LParen) {
                NODES[variant].c = 1;
                let types = list_begin();
                while !at(RParen) && !at(Eof) {
                    list_push(parse_type());
                    if !eat(Comma) {
                        break;
                    }
                }
                list_end(variant, types);
                expect(RParen);
            }
            if eat(Eq) {
                NODES[variant].b = parse_expr();
            }
            NODES[variant].end = prev_end();
            list_push(variant);
            if !eat(Comma) {
                break;
            }
        }
        list_end(n, mark);
        expect(RBrace);
        NODES[n].end = prev_end();
        n
    }
}

fn parse_function() -> i64 {
    unsafe {
        let start = cur_start();
        // `unsafe fn` (0.9).
        let is_unsafe = eat(Unsafe);
        expect(Fn);
        let n = new_node(NodeKind::Fn, start, 0);
        if is_unsafe {
            NODES[n].p |= FN_UNSAFE;
        }
        NODES[n].a = expect_binding_name();
        NODES[n].g = parse_generic_params();
        expect(LParen);
        parse_params(n, false);
        expect(RParen);
        NODES[n].b = parse_return_type();
        NODES[n].c = parse_fn_body(n);
        NODES[n].end = prev_end();
        n
    }
}

// The body of function n; one with a syntax error is marked so (the
// checker leaves it out).
fn parse_fn_body(n: i64) -> i64 {
    unsafe {
        let saved = BODY_FAILED;
        BODY_FAILED = false;
        let body = parse_block();
        if BODY_FAILED {
            NODES[n].p |= FN_BODY_FAILED;
        }
        BODY_FAILED = saved;
        body
    }
}

// After `extern "C"`: a block of C declarations, `extern "C" { fn f(...)
// -> T; static mut x: T; }`; a function with the C convention and an
// unmangled symbol, `extern "C" fn f(...) -> T { ... }`; or a static with
// a C symbol, `extern "C" static mut x: T = v;`. Items are pushed to the
// program's list. (0.2's single declarations, `extern fn f(...) -> T;`,
// were removed in 0.4.)
fn parse_extern() {
    unsafe {
        let start = cur_start();
        expect(Extern);
        if !at(Str) {
            error_at(start, c_fn_outside_block());
        }
        let abi = TOKS[P].value as i64;
        if !(STRS[abi].len == 1 && STRS[abi].ptr[0] == 'C') {
            error_at(cur_start(), c"unsupported ABI; only \"C\" is supported");
        }
        advance();
        if eat(LBrace) {
            while !at(RBrace) && !at(Eof) {
                let link = parse_link_name();
                let item = if at(Fn) {
                    parse_c_function(cur_start(), true)
                } else if at(Static) {
                    parse_c_static(cur_start(), false)
                } else {
                    syntax_error(c"expected 'fn', 'static' or '}' in an extern block")
                };
                if link >= 0 {
                    if NODES[item].kind != NodeKind::ExternFn && !(NODES[item].kind == NodeKind::Static && NODES[item].y == 1) {
                        error_at(NODES[item].start, c"#[link_name] is for the functions and statics of an extern block");
                    }
                    LINK_NAMES.put(NODES[item].a + 1, link + 1);
                }
                list_push(item);
            }
            expect(RBrace);
            return;
        }
        if at(Static) {
            list_push(parse_c_static(start, true));
            return;
        }
        list_push(parse_c_function(start, false));
    }
}

fn c_fn_outside_block() -> *u8 {
    c"C functions are declared in an extern block: `extern \"C\" { fn f(...) -> T; }` (the 0.2 form `extern fn f(...) -> T;` was removed in 0.4)"
}

// `#[link_name = "symbol"]` before a declaration in an extern block: the
// C symbol it stands for, when that is not its name. -1: none.
fn parse_link_name() -> i64 {
    unsafe {
        if !at(Hash) {
            return -1;
        }
        advance();
        expect(LBracket);
        let pos = cur_start();
        let name = expect_ident();
        if name != intern_c(c"link_name") {
            name_error(pos, c"unknown attribute '", name, c"' in an extern block (expected link_name)");
        }
        expect(Eq);
        if !at(Str) {
            syntax_error(c"expected the symbol's name as a string");
        }
        let sym = intern(STRS[TOKS[P].value as i64]);
        advance();
        expect(RBracket);
        sym
    }
}

// `use a::b::c;`, `use a::b::{c, d as e};`, `use a::b as x;` (0.5; 0.4
// had `use E::{A, B};` for the variants of an enum). `use a::b::*;` and
// `use E::*;` are parsed for --fix-imports, and are an error otherwise
// (0.8). c = a Path node whose list is the segments before the braces (or
// the star), b = 1 for `*`, list = the imported names (Ident nodes: a =
// the name, b = its new name, 0 for none).
fn parse_use(public: bool) {
    unsafe {
        let start = cur_start();
        expect(Use);
        let n = new_node(NodeKind::Use, start, 0);
        let path = new_node(NodeKind::Path, cur_start(), 0);
        let segments = list_begin();
        let mark = list_begin();
        let mut last = 0;
        loop {
            let seg = new_node(NodeKind::Ident, cur_start(), 0);
            NODES[seg].a = expect_ident();
            NODES[seg].end = prev_end();
            if !eat(ColonColon) {
                last = seg;
                break;
            }
            list_push(seg);
            if at(Star) || at(LBrace) {
                break;
            }
        }
        list_end(path, segments);
        NODES[path].end = prev_end();
        NODES[n].c = path;
        let items = list_begin();
        if last != 0 {
            if eat(As) {
                NODES[last].b = expect_binding_name();
            }
            list_push(last);
        } else if eat(Star) {
            NODES[n].b = 1;
        } else {
            expect(LBrace);
            while !at(RBrace) && !at(Eof) {
                let item = new_node(NodeKind::Ident, cur_start(), 0);
                NODES[item].a = expect_ident();
                if eat(As) {
                    NODES[item].b = expect_binding_name();
                }
                NODES[item].end = prev_end();
                list_push(item);
                if !eat(Comma) {
                    break;
                }
            }
            expect(RBrace);
        }
        list_end(n, items);
        if NODES[path].count == 0 && NODES[n].b == 0 {
            error_at(start, c"a use names an item through a path: 'use module::item;'");
        }
        expect(Semi);
        NODES[n].end = prev_end();
        mark_public(n, public);
        let _ = mark;
        list_push(n);
    }
}

// `import "header.h" as c;`: the declarations of a C header become part
// of the program (cimport.tach; the driver reads the imports before
// parsing). They live in a module of their own, which the importing
// module names `c`: `c::printf`. `import "header.h";`, which brought
// them all into scope, is parsed for --fix-imports, and is an error
// otherwise (0.8). A Use node with d = 2 and a = that name (0: none).
fn parse_import(public: bool) {
    unsafe {
        let start = cur_start();
        expect(Import);
        if !at(Str) {
            syntax_error(c"expected the name of a C header as a string");
        }
        advance();
        let n = new_node(NodeKind::Use, start, 0);
        NODES[n].d = 2;
        if eat(As) {
            NODES[n].a = expect_binding_name();
        }
        expect(Semi);
        NODES[n].end = prev_end();
        mark_public(n, public);
        list_push(n);
    }
}

// `fn f(...) -> T;` (a C function, only in an extern block) or `fn
// f(...) -> T { ... }` (one with the C convention, defined here).
fn parse_c_function(start: i64, in_block: bool) -> i64 {
    unsafe {
        if tok_kind(2) == LParen {
            // Look past the parameters for the body.
            let saved = P;
            advance();
            advance();
            let mut depth = 0;
            while !at(Eof) {
                if at(LParen) {
                    depth += 1;
                } else if at(RParen) {
                    depth -= 1;
                    if depth == 0 {
                        break;
                    }
                }
                advance();
            }
            advance();
            if eat(Arrow) {
                parse_type();
            }
            let has_body = at(LBrace);
            P = saved;
            if has_body {
                let f = parse_function();
                NODES[f].start = start;
                NODES[f].y = 1;
                return f;
            }
        }
        if !in_block {
            error_at(start, c_fn_outside_block());
        }
        expect(Fn);
        let n = new_node(NodeKind::ExternFn, start, 0);
        NODES[n].a = expect_binding_name();
        expect(LParen);
        NODES[n].d = parse_params(n, true) as i64;
        expect(RParen);
        NODES[n].b = parse_return_type();
        expect(Semi);
        NODES[n].end = prev_end();
        n
    }
}

// `static [mut] x: T;` (defined in C) or, when `defines`, also `static
// [mut] x: T = v;` (defined here, with a C symbol).
fn parse_c_static(start: i64, defines: bool) -> i64 {
    unsafe {
        expect(Static);
        let n = new_node(NodeKind::Static, start, 0);
        NODES[n].d = eat(Mut) as i64;
        NODES[n].a = expect_binding_name();
        expect(Colon);
        NODES[n].b = parse_type();
        NODES[n].y = 1;
        if defines && eat(Eq) {
            NODES[n].c = parse_expr();
            NODES[n].y = 2;
        }
        expect(Semi);
        NODES[n].end = prev_end();
        n
    }
}

// `#[inline]`, `#[inline(never)]` or `#[cold]` (0.6) after `#[` and the
// name: its FN_ flag, or 0 when `name` is another attribute.
fn parse_fn_attribute(name: i64, pos: i64) -> i64 {
    unsafe {
        if name == intern_c(c"cold") {
            return FN_COLD;
        }
        if name != intern_c(c"inline") {
            return 0;
        }
        if eat(LParen) {
            let arg = expect_ident();
            if arg != intern_c(c"never") {
                name_error(pos, c"unknown inline option '", arg, c"' (expected #[inline] or #[inline(never)])");
            }
            expect(RParen);
            return FN_NO_INLINE;
        }
        FN_INLINE
    }
}

// The function attributes before a function in an impl block (0.6).
fn parse_fn_attributes() -> i64 {
    let mut flags = 0;
    let start = cur_start();
    while at(Hash) {
        let pos = cur_start();
        advance();
        expect(LBracket);
        let name = expect_ident();
        let flag = parse_fn_attribute(name, pos);
        if flag == 0 {
            unsafe {
                name_error(pos, c"unknown attribute '", name, c"' before a function (expected inline, inline(never) or cold)");
            }
        }
        flags |= flag;
        expect(RBracket);
    }
    check_fn_attributes(flags, start);
    flags
}

fn check_fn_attributes(flags: i64, pos: i64) {
    if (flags & FN_INLINE) != 0 && (flags & FN_NO_INLINE) != 0 {
        unsafe { error_at(pos, c"a function cannot be both #[inline] and #[inline(never)]"); }
    }
}

// Attributes, then the item: `#[repr(...)]` before a struct, union or
// enum; `#[inline]`, `#[inline(never)]`, `#[cold]` (0.6) before a function.
// `pub` may come before the attributes or (0.6) after them.
fn parse_attributed_item(public: bool) -> i64 {
    unsafe {
        let mut flags = 0;
        let mut fn_flags = 0;
        let mut repr = false;
        let mut align = 0;
        let mut pack = 0;
        let mut int_type = 0;
        let at_start = cur_start();
        while at(Hash) {
            let attr_pos = cur_start();
            advance();
            expect(LBracket);
            let name = expect_ident();
            let fn_flag = parse_fn_attribute(name, attr_pos);
            if fn_flag != 0 {
                fn_flags |= fn_flag;
                expect(RBracket);
                continue;
            }
            if name != intern_c(c"repr") {
                name_error(TOKS[P - 1].start, c"unknown attribute '", name, c"' (expected repr, inline, inline(never) or cold)");
            }
            repr = true;
            expect(LParen);
            while !at(RParen) && !at(Eof) {
                let pos = cur_start();
                let arg = expect_ident();
                if arg == intern_c(c"C") {
                    flags |= REPR_C;
                } else if arg == intern_c(c"packed") {
                    flags |= REPR_PACKED;
                    pack = 1;
                    if eat(LParen) {
                        // packed(N): fields aligned to at most N (0.4; GCC's
                        // #pragma pack(N)).
                        if !at(Int) {
                            syntax_error(c"expected the packing");
                        }
                        pack = TOKS[P].value as i64;
                        advance();
                        expect(RParen);
                        if pack < 1 || pack > 16 || (pack & (pack - 1)) != 0 {
                            error_at(pos, c"packed(N) needs a power of two from 1 to 16");
                        }
                    }
                } else if arg == intern_c(c"align") {
                    expect(LParen);
                    if !at(Int) {
                        syntax_error(c"expected the alignment");
                    }
                    align = TOKS[P].value as i64;
                    advance();
                    expect(RParen);
                    if align < 1 || align > 4096 || (align & (align - 1)) != 0 {
                        error_at(pos, c"align(N) needs a power of two from 1 to 4096");
                    }
                } else if is_int_type_name(arg) {
                    flags |= REPR_INT;
                    int_type = arg;
                } else {
                    name_error(pos, c"unknown repr '", arg, c"' (expected C, packed, align(N) or an integer type)");
                }
                if !eat(Comma) {
                    break;
                }
            }
            expect(RParen);
            expect(RBracket);
        }
        let item_public = eat(Pub) || public;
        if fn_flags != 0 {
            if repr {
                error_at(at_start, c"#[repr(...)] and function attributes cannot be combined");
            }
            if !at(Fn) && !(at(Unsafe) && tok_kind(1) == Fn) {
                error_at(at_start, c"#[inline] and #[cold] go before a function");
            }
            check_fn_attributes(fn_flags, at_start);
            let f = parse_function();
            NODES[f].p |= fn_flags;
            mark_public(f, item_public);
            return f;
        }
        if !at(Struct) && !at(Union) && !at(Enum) {
            error_at(at_start, c"#[repr(...)] goes before a struct, union or enum");
        }
        if ((flags & REPR_PACKED) != 0 || align != 0) && (flags & REPR_C) == 0 {
            error_at(at_start, c"packed and align(N) are only for #[repr(C, ...)] types");
        }
        if (flags & REPR_PACKED) != 0 && align != 0 {
            error_at(at_start, c"a type cannot be both packed and aligned");
        }
        let item = parse_item();
        if NODES[item].kind == NodeKind::Enum {
            if (flags & REPR_PACKED) != 0 || align != 0 {
                error_at(at_start, c"packed and align(N) are for structs and unions, not enums");
            }
            NODES[item].d = int_type;
        } else {
            if (flags & REPR_INT) != 0 {
                error_at(at_start, c"an integer repr is for enums only");
            }
            // For packed types, `d` is the packing (1 for plain packed).
            NODES[item].d = if pack != 0 { pack } else { align };
        }
        NODES[item].c = NODES[item].c | flags;
        mark_public(item, item_public);
        item
    }
}

// Whether `name` is an integer type's name (for #[repr(u8)] and so on).
fn is_int_type_name(name: i64) -> bool {
    let names: [*u8; 8] = [c"i8", c"i16", c"i32", c"i64", c"u8", c"u16", c"u32", c"u64"];
    for i in 0..8 {
        if unsafe { name == intern_c(names[i]) } {
            return true;
        }
    }
    false
}

// The parameters of `n` up to `)`; whether they end with `...`.
fn parse_params(n: i64, allow_ellipsis: bool) -> bool {
    let mark = list_begin();
    let mut variadic = false;
    while !at(RParen) && !at(Eof) {
        if at(Ellipsis) {
            if !allow_ellipsis {
                unsafe { error_at(cur_start(), c"only extern functions can be variadic"); }
            }
            advance();
            variadic = true;
            eat(Comma);
            break;
        }
        list_push(parse_param());
        if !eat(Comma) {
            break;
        }
    }
    list_end(n, mark);
    variadic
}

fn parse_param() -> i64 {
    unsafe {
        let start = cur_start();
        let mutable = eat(Mut);
        let n = new_node(NodeKind::Param, start, 0);
        NODES[n].a = if mutable { expect_binding_name() } else { expect_ident() };
        expect(Colon);
        NODES[n].b = parse_type();
        NODES[n].c = mutable as i64;
        NODES[n].end = prev_end();
        n
    }
}

fn parse_return_type() -> i64 {
    if eat(Arrow) { parse_type() } else { 0 }
}

fn parse_struct() -> i64 {
    unsafe {
        let start = cur_start();
        let is_union = at(Union);
        advance();
        let n = new_node(NodeKind::Struct, start, 0);
        if is_union {
            NODES[n].c = REPR_UNION;
        }
        NODES[n].a = expect_binding_name();
        NODES[n].g = parse_generic_params();
        expect(LBrace);
        let mark = list_begin();
        while !at(RBrace) && !at(Eof) {
            let field_start = cur_start();
            // `pub` (0.5) is allowed: a field is visible wherever its struct is.
            eat(Pub);
            let field = new_node(NodeKind::Field, field_start, 0);
            NODES[field].a = expect_binding_name();
            expect(Colon);
            NODES[field].b = parse_type();
            NODES[field].end = prev_end();
            list_push(field);
            if !eat(Comma) {
                break;
            }
        }
        list_end(n, mark);
        expect(RBrace);
        NODES[n].end = prev_end();
        n
    }
}

fn parse_const_or_static(kind: NodeKind) -> i64 {
    unsafe {
        let start = cur_start();
        advance();
        let n = new_node(kind, start, 0);
        if kind == NodeKind::Static {
            NODES[n].d = eat(Mut) as i64;
        }
        NODES[n].a = expect_binding_name();
        expect(Colon);
        NODES[n].b = parse_type();
        expect(Eq);
        NODES[n].c = parse_expr();
        expect(Semi);
        NODES[n].end = prev_end();
        n
    }
}

fn parse_type_alias() -> i64 {
    unsafe {
        let start = cur_start();
        expect(Type);
        let n = new_node(NodeKind::TypeAlias, start, 0);
        NODES[n].a = expect_binding_name();
        // `type Pair<T> = (T, T);` (0.6): generic, its parameters in `g`.
        NODES[n].g = parse_generic_params();
        expect(Eq);
        NODES[n].b = parse_type();
        expect(Semi);
        NODES[n].end = prev_end();
        n
    }
}

// ---- Types ----

fn parse_type() -> i64 {
    unsafe {
        let start = cur_start();
        let kind = cur();
        if kind == Ident {
            let n = new_node(NodeKind::TyName, start, 0);
            NODES[n].a = expect_ident();
            if at(ColonColon) {
                // `a::b::T`: a type in a module (0.5); the segments before the
                // name are the TyName's list.
                let mark = list_begin();
                while eat(ColonColon) {
                    let seg = new_node(NodeKind::Ident, NODES[n].start, prev_end());
                    NODES[seg].a = NODES[n].a;
                    list_push(seg);
                    NODES[n].a = expect_ident();
                }
                list_end(n, mark);
            }
            if at(Lt) {
                NODES[n].g = parse_type_args();
            }
            NODES[n].end = prev_end();
            return n;
        }
        if kind == Star {
            advance();
            let n = new_node(NodeKind::TyPtr, start, 0);
            NODES[n].a = parse_type();
            NODES[n].end = prev_end();
            return n;
        }
        if kind == Bang {
            advance();
            return new_node(NodeKind::TyNever, start, prev_end());
        }
        if kind == LParen {
            return parse_paren_type(start);
        }
        if kind == LBracket {
            return parse_array_type(start);
        }
        if kind == Fn {
            return parse_fn_type(start);
        }
        if kind == Extern {
            advance();
            if at(Str) {
                let abi = TOKS[P].value as i64;
                if !(STRS[abi].len == 1 && STRS[abi].ptr[0] == 'C') {
                    error_at(cur_start(), c"unsupported ABI; only \"C\" is supported");
                }
                advance();
            }
            let n = parse_fn_type(start);
            NODES[n].d = 1;
            return n;
        }
        if kind == Reserved {
            reserved_error();
        }
        syntax_error(c"expected type")
    }
}

fn parse_paren_type(start: i64) -> i64 {
    expect(LParen);
    if eat(RParen) {
        return new_node(NodeKind::TyUnit, start, prev_end());
    }
    let first = parse_type();
    if !eat(Comma) {
        expect(RParen);
        return first;
    }
    let n = new_node(NodeKind::TyTuple, start, 0);
    let mark = list_begin();
    list_push(first);
    while !at(RParen) && !at(Eof) {
        list_push(parse_type());
        if !eat(Comma) {
            break;
        }
    }
    list_end(n, mark);
    expect(RParen);
    unsafe { NODES[n].end = prev_end(); }
    n
}

fn parse_array_type(start: i64) -> i64 {
    unsafe {
        expect(LBracket);
        let n = new_node(NodeKind::TyArray, start, 0);
        NODES[n].a = parse_type();
        if eat(RBracket) {
            NODES[n].kind = NodeKind::TySlice;
            NODES[n].end = prev_end();
            return n;
        }
        expect(Semi);
        let saved = with_no_struct(false);
        NODES[n].b = parse_expr();
        NO_STRUCT = saved;
        expect(RBracket);
        NODES[n].end = prev_end();
        n
    }
}

fn parse_fn_type(start: i64) -> i64 {
    unsafe {
        expect(Fn);
        expect(LParen);
        let n = new_node(NodeKind::TyFn, start, 0);
        let mark = list_begin();
        while !at(RParen) && !at(Eof) {
            if at(Ellipsis) {
                error_at(cur_start(), c"function pointer types cannot be variadic; call variadic functions directly");
            }
            list_push(parse_type());
            if !eat(Comma) {
                break;
            }
        }
        list_end(n, mark);
        expect(RParen);
        if eat(Arrow) {
            NODES[n].a = parse_type();
        } else {
            NODES[n].a = new_node(NodeKind::TyUnit, prev_end(), prev_end());
        }
        NODES[n].end = prev_end();
        n
    }
}

// ---- Blocks and statements ----

fn parse_block() -> i64 {
    unsafe {
        let start = cur_start();
        expect(LBrace);
        let saved = with_no_struct(false);
        let block = new_node(NodeKind::Block, start, 0);
        let mark = list_begin();
        let mut tail = 0;
        while !at(RBrace) && !at(Eof) {
            if eat(Semi) {
                continue;
            }
            if is_item_start(cur()) {
                syntax_error(c"expected '}' (items cannot be nested in blocks)");
            }
            // A recovery point: after an error, on at the next statement.
            let depth = RECOVER_DEPTH;
            let stmts = SCRATCH.count;
            let start = P;
            let mut stmt = 0;
            if _setjmp(recover_enter()) == 0 {
                if tail != 0 {
                    syntax_error(c"expected ';' or '}' after expression");
                }
                stmt = parse_stmt();
            } else {
                SCRATCH.count = stmts;
                NO_STRUCT = false;
                skip_statement(start);
                BODY_FAILED = true;
            }
            recover_leave(depth);
            if stmt == 0 {
                continue;
            }
            if NODES[stmt].kind == NodeKind::ExprStmt && NODES[stmt].b == 2 {
                // A tail expression.
                tail = NODES[stmt].a;
            } else {
                list_push(stmt);
            }
        }
        list_end(block, mark);
        NODES[block].a = tail;
        expect(RBrace);
        NO_STRUCT = saved;
        NODES[block].end = prev_end();
        block
    }
}

fn is_item_start(kind: Tok) -> bool {
    kind == Fn || kind == Extern || kind == Struct || kind == Const
        || kind == Static || kind == Type || kind == Enum || kind == Impl
        || kind == Union || kind == Import || kind == Use
}

// `name:` before `loop`, `while` or `for`.
fn at_label() -> bool {
    let after = tok_kind(2);
    at(Ident) && tok_kind(1) == Colon
        && (after == Loop || after == While || after == For)
}

fn at_block_like() -> bool {
    let kind = cur();
    kind == LBrace || kind == If || kind == Loop || kind == While
        || kind == For || kind == Match || at_label() || (kind == Unsafe && tok_kind(1) == LBrace)
}

fn expr_stmt(expr: i64, has_semi: i64, start: i64) -> i64 {
    let n = new_node(NodeKind::ExprStmt, start, prev_end());
    unsafe {
        NODES[n].a = expr;
        NODES[n].b = has_semi;
    }
    n
}

// A statement; an NodeKind::ExprStmt with b == 2 is the block's tail expression.
fn parse_stmt() -> i64 {
    let start = cur_start();
    if at(Let) {
        return parse_let();
    }
    if at(Defer) {
        return parse_defer();
    }
    if at_block_like() {
        // Ends at its closing brace; a `;` right after belongs to it.
        let expr = parse_primary();
        if at(RBrace) {
            return expr_stmt(expr, 2, start);
        }
        let has_semi = eat(Semi);
        return expr_stmt(expr, has_semi as i64, start);
    }
    let expr = parse_expr();
    if at(Semi) {
        advance();
        return expr_stmt(expr, 1, start);
    }
    if at(RBrace) {
        return expr_stmt(expr, 2, start);
    }
    unsafe { syntax_error(c"expected ';' or '}' after expression") }
}

// `defer expr;` or `defer { ... }` (0.6).
fn parse_defer() -> i64 {
    unsafe {
        let start = cur_start();
        expect(Defer);
        let n = new_node(NodeKind::Defer, start, 0);
        if at(LBrace) {
            NODES[n].a = parse_block();
            eat(Semi);
        } else {
            NODES[n].a = parse_expr();
            expect(Semi);
        }
        NODES[n].end = prev_end();
        n
    }
}

fn parse_let() -> i64 {
    unsafe {
        let start = cur_start();
        expect(Let);
        let n = new_node(NodeKind::Let, start, 0);
        NODES[n].a = parse_pattern();
        if eat(Colon) {
            NODES[n].b = parse_type();
        }
        if at(Semi) {
            error_at(cur_start(), c"'let' without an initializer is not supported; give the binding a value");
        }
        expect(Eq);
        NODES[n].c = parse_expr();
        expect(Semi);
        NODES[n].end = prev_end();
        n
    }
}

// A pattern: alternatives separated by `|`.
fn parse_pattern() -> i64 {
    let start = cur_start();
    let first = parse_single_pattern();
    if !at(Pipe) {
        return first;
    }
    let n = new_node(NodeKind::PatOr, start, 0);
    let mark = list_begin();
    list_push(first);
    while eat(Pipe) {
        list_push(parse_single_pattern());
    }
    list_end(n, mark);
    unsafe { NODES[n].end = prev_end(); }
    n
}

fn at_literal_pattern() -> bool {
    let kind = cur();
    kind == Int || kind == Char || kind == True || kind == False
        || (kind == Minus && (tok_kind(1) == Int || tok_kind(1) == Float)) || kind == Float
}

// A literal (or a constant's name) in a pattern: an expression node.
fn parse_pattern_literal() -> i64 {
    let start = cur_start();
    if at(Minus) {
        advance();
        let operand = parse_primary();
        return make_unary(Minus, operand, start);
    }
    if at(Ident) {
        let n = new_node(NodeKind::Ident, start, 0);
        unsafe {
            NODES[n].a = expect_ident();
            NODES[n].end = prev_end();
        }
        return n;
    }
    parse_primary()
}

// `lo ..= hi` after the low end has been parsed.
fn parse_range_pattern(start: i64, low: i64) -> i64 {
    unsafe {
        if at(DotDot) {
            error_at(cur_start(), c"exclusive range patterns are not supported; use 'a..=b'");
        }
        expect(DotDotEq);
        let n = new_node(NodeKind::PatRange, start, 0);
        NODES[n].a = low;
        if !(at_literal_pattern() || at(Ident)) {
            syntax_error(c"expected the end of the range pattern");
        }
        NODES[n].b = parse_pattern_literal();
        NODES[n].end = prev_end();
        n
    }
}

fn parse_single_pattern() -> i64 {
    unsafe {
        let start = cur_start();
        if at(Ident) && TOKS[P].value as i64 == UNDERSCORE {
            advance();
            return new_node(NodeKind::PatWild, start, prev_end());
        }
        if at(Mut) {
            advance();
            let n = new_node(NodeKind::PatBind, start, 0);
            NODES[n].a = expect_binding_name();
            NODES[n].b = 1;
            NODES[n].end = prev_end();
            return n;
        }
        if at_literal_pattern() {
            let low = parse_pattern_literal();
            if at(DotDotEq) || at(DotDot) {
                return parse_range_pattern(start, low);
            }
            let n = new_node(NodeKind::PatLit, start, prev_end());
            NODES[n].a = low;
            return n;
        }
        if at(Ident) && tok_kind(1) == ColonColon {
            return parse_variant_pattern(start);
        }
        if at(Ident) && (tok_kind(1) == DotDotEq || tok_kind(1) == DotDot) {
            let low = parse_pattern_literal();
            return parse_range_pattern(start, low);
        }
        if at(Ident) && tok_kind(1) == LParen {
            // `V(p, ...)`: a variant brought into scope by `use` (0.4); its
            // enum is found by the checker (d = 1).
            let n = new_node(NodeKind::PatVariant, start, 0);
            NODES[n].b = expect_ident();
            NODES[n].d = 1;
            NODES[n].c = 1;
            expect(LParen);
            let mark = list_begin();
            while !at(RParen) && !at(Eof) {
                list_push(parse_pattern());
                if !eat(Comma) {
                    break;
                }
            }
            list_end(n, mark);
            expect(RParen);
            NODES[n].end = prev_end();
            return n;
        }
        if at(Ident) {
            let n = new_node(NodeKind::PatBind, start, 0);
            NODES[n].a = expect_ident();
            NODES[n].end = prev_end();
            if at(LBrace) {
                error_at(cur_start(), c"struct patterns are not supported; enum variants are written 'Enum::Variant(...)'");
            }
            return n;
        }
        if at(LParen) {
            return parse_tuple_pattern(start);
        }
        if at(Reserved) {
            reserved_error();
        }
        syntax_error(c"expected a pattern")
    }
}

// `E::V` or `E::V(p, ...)`; `m::E::V` (0.5): h = a Path of the segments
// before the enum's name.
fn parse_variant_pattern(start: i64) -> i64 {
    unsafe {
        let n = new_node(NodeKind::PatVariant, start, 0);
        let mark = list_begin();
        let mut name = expect_ident();
        expect(ColonColon);
        let mut member = expect_ident();
        while at(ColonColon) {
            advance();
            let seg = new_node(NodeKind::Ident, start, prev_end());
            NODES[seg].a = name;
            list_push(seg);
            name = member;
            member = expect_ident();
        }
        if SCRATCH.count > mark {
            let prefix = new_node(NodeKind::Path, start, prev_end());
            list_end(prefix, mark);
            NODES[n].h = prefix;
        }
        NODES[n].a = name;
        NODES[n].b = member;
        if eat(LParen) {
            NODES[n].c = 1;
            let mark = list_begin();
            while !at(RParen) && !at(Eof) {
                list_push(parse_pattern());
                if !eat(Comma) {
                    break;
                }
            }
            list_end(n, mark);
            expect(RParen);
        }
        NODES[n].end = prev_end();
        if NODES[n].c == 0 && (at(DotDotEq) || at(DotDot)) {
            // `E::A..=E::C` (0.4).
            if at(DotDot) {
                error_at(cur_start(), c"exclusive range patterns are not supported; use 'a..=b'");
            }
            advance();
            if !(at(Ident) && tok_kind(1) == ColonColon) {
                syntax_error(c"expected the last variant of the range ('E::V')");
            }
            let r = new_node(NodeKind::PatRange, start, 0);
            NODES[r].a = n;
            NODES[r].b = parse_variant_pattern(cur_start());
            NODES[r].end = prev_end();
            return r;
        }
        n
    }
}

fn parse_tuple_pattern(start: i64) -> i64 {
    unsafe {
        expect(LParen);
        let n = new_node(NodeKind::PatTuple, start, 0);
        let mark = list_begin();
        let mut trailing_comma = false;
        while !at(RParen) && !at(Eof) {
            list_push(parse_pattern());
            trailing_comma = eat(Comma);
            if !trailing_comma {
                break;
            }
        }
        expect(RParen);
        if SCRATCH.count - mark == 1 && !trailing_comma {
            let only = SCRATCH.data[mark];
            SCRATCH.count = mark;
            return only;
        }
        list_end(n, mark);
        NODES[n].end = prev_end();
        n
    }
}

// ---- Expressions ----

fn parse_expr() -> i64 {
    parse_expr_bp(0)
}

fn parse_expr_no_struct() -> i64 {
    let saved = with_no_struct(true);
    let e = parse_expr_bp(0);
    NO_STRUCT = saved;
    e
}

// Left and right binding powers of an infix operator token, 0 if none.
fn infix_left_bp(kind: Tok) -> i64 {
    match kind {
        Eq | PlusEq | MinusEq | StarEq | SlashEq | PercentEq
            | AmpEq | PipeEq | CaretEq | ShlEq | ShrEq => 2,
        DotDot | DotDotEq => 4,
        PipePipe => 6,
        AmpAmp => 8,
        EqEq | BangEq | Lt | Gt | LtEq | GtEq => 10,
        Pipe => 12,
        Caret => 14,
        Amp => 16,
        Shl | Shr => 18,
        Plus | Minus => 20,
        Star | Slash | Percent => 22,
        _ => 0,
    }
}

pub fn is_comparison(kind: Tok) -> bool {
    infix_left_bp(kind) == 10
}

fn is_assign_op(kind: Tok) -> bool {
    infix_left_bp(kind) == 2
}

fn is_reserved_punct(kind: Tok) -> bool {
    kind == Hash || kind == Question || kind == At
}

// Non-associative level of an operator: 1 comparison, 2 range, 0 none.
fn non_assoc_level(kind: Tok) -> i64 {
    if is_comparison(kind) { return 1; }
    if kind == DotDot || kind == DotDotEq { return 2; }
    0
}

fn parse_expr_bp(min_bp: i64) -> i64 {
    let lhs = parse_prefix();
    parse_infix(lhs, min_bp)
}

// Continues an expression whose first operand `first` is parsed.
fn parse_infix(first: i64, min_bp: i64) -> i64 {
    unsafe {
        let mut lhs = first;
        let mut built_by = 0;
        loop {
            let kind = cur();
            if (kind == LParen || kind == LBracket || kind == Dot) && POSTFIX_BP >= min_bp {
                lhs = parse_postfix(lhs);
                built_by = 0;
                continue;
            }
            if kind == As && AS_BP >= min_bp {
                advance();
                let n = new_node(NodeKind::Cast, NODES[lhs].start, 0);
                NODES[n].a = lhs;
                NODES[n].b = parse_type();
                NODES[n].end = prev_end();
                lhs = n;
                built_by = 0;
                continue;
            }
            if is_reserved_punct(kind) {
                reserved_error();
            }
            let left_bp = infix_left_bp(kind);
            if left_bp == 0 || left_bp < min_bp {
                break;
            }
            let level = non_assoc_level(kind);
            if level != 0 && built_by == level {
                if level == 1 {
                    error_at(cur_start(), c"comparison operators cannot be chained; use parentheses");
                }
                error_at(cur_start(), c"range operators cannot be chained; use parentheses");
            }
            advance();
            // Assignment is right-associative; everything else left.
            let right_bp = if left_bp == 2 { 1 } else { left_bp + 1 };
            let rhs = parse_expr_bp(right_bp);
            lhs = make_infix(kind, lhs, rhs);
            built_by = level;
        }
        lhs
    }
}

fn make_infix(kind: Tok, lhs: i64, rhs: i64) -> i64 {
    unsafe {
        let start = NODES[lhs].start;
        let end = NODES[rhs].end;
        if is_assign_op(kind) {
            let n = new_node(NodeKind::Assign, start, end);
            NODES[n].op = kind;
            NODES[n].b = lhs;
            NODES[n].c = rhs;
            return n;
        }
        if kind == DotDot || kind == DotDotEq {
            let n = new_node(NodeKind::Range, start, end);
            NODES[n].a = lhs;
            NODES[n].b = rhs;
            NODES[n].c = (kind == DotDotEq) as i64;
            return n;
        }
        let n = new_node(NodeKind::Binary, start, end);
        NODES[n].op = kind;
        NODES[n].b = lhs;
        NODES[n].c = rhs;
        n
    }
}

fn starts_expr(kind: Tok) -> bool {
    kind == Int || kind == Float || kind == Char || kind == Str || kind == CStr
        || kind == Ident || kind == True || kind == False || kind == LParen
        || kind == LBracket || kind == LBrace || kind == Minus || kind == Bang
        || kind == Tilde || kind == Star || kind == Amp || kind == AmpAmp
        || kind == If || kind == Loop || kind == While || kind == For
        || kind == Return || kind == Break || kind == Continue || kind == Match
        || kind == Unsafe
}

fn make_unary(op: Tok, operand: i64, start: i64) -> i64 {
    unsafe {
        let n = new_node(NodeKind::Unary, start, NODES[operand].end);
        NODES[n].op = op;
        NODES[n].b = operand;
        n
    }
}

fn parse_prefix() -> i64 {
    unsafe {
        let kind = cur();
        let start = cur_start();
        if kind == Minus || kind == Bang || kind == Tilde || kind == Star || kind == Amp {
            advance();
            let operand = parse_expr_bp(PREFIX_BP);
            return make_unary(kind, operand, start);
        }
        if kind == AmpAmp {
            // `&&x` is `& &x`.
            advance();
            let operand = parse_expr_bp(PREFIX_BP);
            let inner = make_unary(Amp, operand, start + 1);
            return make_unary(Amp, inner, start);
        }
        if kind == Plus {
            error_at(start, c"unary '+' is not supported");
        }
        if kind == Return {
            advance();
            let n = new_node(NodeKind::Return, start, 0);
            NODES[n].a = parse_jump_value();
            NODES[n].end = prev_end();
            return n;
        }
        if kind == Break {
            advance();
            let n = new_node(NodeKind::Break, start, 0);
            NODES[n].a = parse_jump_label();
            NODES[n].b = parse_jump_value();
            NODES[n].end = prev_end();
            return n;
        }
        if kind == Continue {
            advance();
            let n = new_node(NodeKind::Continue, start, 0);
            NODES[n].a = parse_jump_label();
            NODES[n].end = prev_end();
            return n;
        }
        if kind == DotDot || kind == DotDotEq {
            error_at(start, c"a range needs a start: write 'a..b'");
        }
        parse_primary()
    }
}

fn parse_jump_value() -> i64 {
    if starts_expr(cur()) { parse_expr_bp(0) } else { 0 }
}

fn parse_jump_label() -> i64 {
    if at(Colon) && tok_kind(1) == Ident {
        advance();
        return expect_ident();
    }
    0
}

fn parse_postfix(lhs: i64) -> i64 {
    unsafe {
        let start = NODES[lhs].start;
        if at(LParen) && NODES[lhs].kind == NodeKind::Ident && NODES[lhs].g == 0
            && (NODES[lhs].a == intern_c(c"size_of") || NODES[lhs].a == intern_c(c"align_of")) {
            // `size_of(T)`, `align_of(T)` (builtins, 0.5): the argument is a
            // type (`size_of(Node<T>)`).
            advance();
            let n = new_node(NodeKind::Call, start, 0);
            NODES[n].a = lhs;
            let mark = list_begin();
            list_push(parse_type());
            list_end(n, mark);
            expect(RParen);
            NODES[n].end = prev_end();
            return n;
        }
        if eat(LParen) {
            let n = new_node(NodeKind::Call, start, 0);
            NODES[n].a = lhs;
            let saved = with_no_struct(false);
            parse_expr_list(n, RParen);
            NO_STRUCT = saved;
            expect(RParen);
            NODES[n].end = prev_end();
            return n;
        }
        if eat(LBracket) {
            let n = new_node(NodeKind::Index, start, 0);
            NODES[n].a = lhs;
            let saved = with_no_struct(false);
            NODES[n].b = parse_index();
            NO_STRUCT = saved;
            expect(RBracket);
            NODES[n].end = prev_end();
            return n;
        }
        expect(Dot);
        if at(Ident) {
            if tok_kind(1) == LParen || (tok_kind(1) == ColonColon && tok_kind(2) == Lt) {
                let n = new_node(NodeKind::MethodCall, start, 0);
                NODES[n].a = lhs;
                NODES[n].b = expect_ident();
                if eat(ColonColon) {
                    NODES[n].g = parse_type_args();
                }
                expect(LParen);
                let saved = with_no_struct(false);
                parse_expr_list(n, RParen);
                NO_STRUCT = saved;
                expect(RParen);
                NODES[n].end = prev_end();
                return n;
            }
            let n = new_node(NodeKind::FieldAccess, start, 0);
            NODES[n].a = lhs;
            NODES[n].b = expect_ident();
            NODES[n].end = prev_end();
            return n;
        }
        if at(Int) && TOKS[P].suffix == SUF_NONE {
            let n = new_node(NodeKind::TupleField, start, TOKS[P].end);
            NODES[n].a = lhs;
            NODES[n].b = TOKS[P].value as i64;
            advance();
            return n;
        }
        syntax_error(c"expected field name or index after '.'")
    }
}

// The inside of `[...]`: an index, or a range with optional ends
// (`lo..hi`, `lo..`, `..hi`, `..`, `lo..=hi`, `..=hi`) for slicing.
fn parse_index() -> i64 {
    unsafe {
        let start = cur_start();
        let mut low = 0;
        if !at(DotDot) && !at(DotDotEq) {
            // Stops before a range operator.
            low = parse_expr_bp(5);
            if !at(DotDot) && !at(DotDotEq) {
                return parse_infix(low, 0);
            }
        }
        let inclusive = at(DotDotEq);
        advance();
        let n = new_node(NodeKind::Range, start, 0);
        NODES[n].a = low;
        NODES[n].c = inclusive as i64;
        if !at(RBracket) {
            NODES[n].b = parse_expr_bp(5);
        } else if inclusive {
            syntax_error(c"an inclusive range needs an end");
        }
        NODES[n].end = prev_end();
        n
    }
}

// `e, e, ...` up to `close` (not consumed), as the list of `n`.
fn parse_expr_list(n: i64, close: Tok) {
    let mark = list_begin();
    while !at(close) && !at(Eof) {
        list_push(parse_expr());
        if !eat(Comma) {
            break;
        }
    }
    list_end(n, mark);
}

fn literal_node(kind: NodeKind, start: i64, a: i64, b: i64) -> i64 {
    advance();
    let n = new_node(kind, start, prev_end());
    unsafe {
        NODES[n].a = a;
        NODES[n].b = b;
    }
    n
}

fn parse_primary() -> i64 {
    unsafe {
        let kind = cur();
        let start = cur_start();
        let value = TOKS[P].value as i64;
        let suffix = TOKS[P].suffix;
        if kind == Int { return literal_node(NodeKind::Int, start, value, suffix); }
        if kind == Float { return literal_node(NodeKind::Float, start, value, suffix); }
        if kind == Char { return literal_node(NodeKind::Char, start, value, 0); }
        if kind == Str { return literal_node(NodeKind::Str, start, value, 0); }
        if kind == CStr { return literal_node(NodeKind::CStr, start, value, 0); }
        if kind == True { return literal_node(NodeKind::Bool, start, 1, 0); }
        if kind == False { return literal_node(NodeKind::Bool, start, 0, 0); }
        if kind == LParen {
            let saved = with_no_struct(false);
            let e = parse_paren_expr();
            NO_STRUCT = saved;
            return e;
        }
        if kind == LBracket {
            let saved = with_no_struct(false);
            let e = parse_array_literal();
            NO_STRUCT = saved;
            return e;
        }
        if kind == LBrace { return parse_block(); }
        if kind == Unsafe {
            // `unsafe { ... }` (0.9): a block of unsafe code.
            advance();
            if !at(LBrace) {
                syntax_error(c"expected '{' after 'unsafe' (an unsafe block), or 'unsafe fn' as an item");
            }
            let block = parse_block();
            NODES[block].start = start;
            NODES[block].p |= BLOCK_UNSAFE;
            return block;
        }
        if kind == If { return parse_if(); }
        if kind == Match { return parse_match(); }
        if kind == Loop || kind == While || kind == For {
            return parse_loop(0, start);
        }
        if kind == Ident && at_label() {
            let label = expect_ident();
            expect(Colon);
            return parse_loop(label, start);
        }
        if kind == Ident && value == UNDERSCORE {
            error_at(start, c"'_' can only be used in patterns");
        }
        if kind == Ident {
            return parse_name_or_struct_literal();
        }
        if is_reserved_punct(kind) || kind == Reserved {
            reserved_error();
        }
        syntax_error(c"expected expression")
    }
}

// One segment of a path in an expression: a name, with type arguments
// after `::<` (an Ident node, g = the arguments).
fn parse_path_segment() -> i64 {
    unsafe {
        let seg = new_node(NodeKind::Ident, cur_start(), 0);
        NODES[seg].a = expect_ident();
        if at(ColonColon) && tok_kind(1) == Lt {
            advance();
            NODES[seg].g = parse_type_args();
        }
        NODES[seg].end = prev_end();
        seg
    }
}

// A name (`x`, `max::<i64>`), a path (`T::m`, `a::b::c`), or a struct
// literal (`P { x: 1 }`, `Pair::<i64> { ... }`, `m::P { ... }`).
//
// A path of two segments is a Path node (a, b: the names, g: the first
// one's type arguments, h: the second's); with more, its list holds all
// the segments, and a, b, g, h describe the last two.
fn parse_name_or_struct_literal() -> i64 {
    unsafe {
        let start = cur_start();
        let first = parse_path_segment();
        let mark = list_begin();
        list_push(first);
        while at(ColonColon) && tok_kind(1) == Ident {
            advance();
            list_push(parse_path_segment());
        }
        let count = SCRATCH.count - mark;
        if at(ColonColon) {
            advance();
            syntax_error(c"expected a name after '::'");
        }
        let last = SCRATCH.data[SCRATCH.count - 1];
        if !NO_STRUCT && at(LBrace) {
            advance();
            let n = new_node(NodeKind::StructLit, start, 0);
            NODES[n].a = NODES[last].a;
            NODES[n].g = NODES[last].g;
            if count > 1 {
                // The module path of the struct: h, a Path of the segments
                // before its name.
                let prefix = new_node(NodeKind::Path, start, NODES[last].start);
                SCRATCH.count -= 1;
                list_end(prefix, mark);
                NODES[n].h = prefix;
            } else {
                SCRATCH.count = mark;
            }
            let saved = with_no_struct(false);
            let inits = list_begin();
            while !at(RBrace) && !at(Eof) {
                let init_start = cur_start();
                let init = new_node(NodeKind::FieldInit, init_start, 0);
                NODES[init].a = expect_binding_name();
                expect(Colon);
                NODES[init].b = parse_expr();
                NODES[init].end = prev_end();
                list_push(init);
                if !eat(Comma) {
                    break;
                }
            }
            list_end(n, inits);
            NO_STRUCT = saved;
            expect(RBrace);
            NODES[n].end = prev_end();
            return n;
        }
        if count == 1 {
            SCRATCH.count = mark;
            return first;
        }
        let n = new_node(NodeKind::Path, start, prev_end());
        let before = SCRATCH.data[SCRATCH.count - 2];
        NODES[n].a = NODES[before].a;
        NODES[n].g = NODES[before].g;
        NODES[n].b = NODES[last].a;
        NODES[n].h = NODES[last].g;
        if count == 2 {
            SCRATCH.count = mark;
        } else {
            list_end(n, mark);
        }
        n
    }
}

// `()`, `(e)`, `(e,)` or `(e, e, ...)`
fn parse_paren_expr() -> i64 {
    unsafe {
        let start = cur_start();
        expect(LParen);
        if eat(RParen) {
            return new_node(NodeKind::Unit, start, prev_end());
        }
        let first = parse_expr();
        if eat(Comma) {
            let n = new_node(NodeKind::Tuple, start, 0);
            let mark = list_begin();
            list_push(first);
            while !at(RParen) && !at(Eof) {
                list_push(parse_expr());
                if !eat(Comma) {
                    break;
                }
            }
            list_end(n, mark);
            expect(RParen);
            NODES[n].end = prev_end();
            return n;
        }
        expect(RParen);
        NODES[first].start = start;
        NODES[first].end = prev_end();
        first
    }
}

// `[]`, `[e; n]` or `[e, e, ...]`
fn parse_array_literal() -> i64 {
    unsafe {
        let start = cur_start();
        expect(LBracket);
        if eat(RBracket) {
            return new_node(NodeKind::Array, start, prev_end());
        }
        let first = parse_expr();
        if eat(Semi) {
            let n = new_node(NodeKind::Repeat, start, 0);
            NODES[n].a = first;
            NODES[n].b = parse_expr();
            expect(RBracket);
            NODES[n].end = prev_end();
            return n;
        }
        let n = new_node(NodeKind::Array, start, 0);
        let mark = list_begin();
        list_push(first);
        if eat(Comma) {
            while !at(RBracket) && !at(Eof) {
                list_push(parse_expr());
                if !eat(Comma) {
                    break;
                }
            }
        }
        list_end(n, mark);
        expect(RBracket);
        NODES[n].end = prev_end();
        n
    }
}

fn parse_if() -> i64 {
    unsafe {
        let start = cur_start();
        expect(If);
        if at(Let) {
            return parse_if_let(start);
        }
        let n = new_node(NodeKind::If, start, 0);
        NODES[n].a = parse_expr_no_struct();
        NODES[n].b = parse_block();
        if eat(Else) {
            NODES[n].c = parse_else_part();
        }
        NODES[n].end = prev_end();
        n
    }
}

// The else part of an `if` (after `else`): a block, or a block holding
// just the inner `if` of an `else if`.
fn parse_else_part() -> i64 {
    unsafe {
        if at(If) {
            let inner = parse_if();
            let block = new_node(NodeKind::Block, NODES[inner].start, NODES[inner].end);
            NODES[block].a = inner;
            return block;
        }
        parse_block()
    }
}

// A match arm made by the parser: `pattern => body`.
fn synthetic_arm(pattern: i64, body: i64, flags: i64) -> i64 {
    unsafe {
        let arm = new_node(NodeKind::Arm, NODES[pattern].start, NODES[body].end);
        NODES[arm].a = pattern;
        NODES[arm].c = body;
        NODES[arm].p = flags;
        arm
    }
}

// `if let P = e { A } else { B }` (0.6), after `if`: the match
// `match e { P => { A }, _ => { B } }` (B: an empty block without `else`).
// The bindings of P are in scope in A only; P may be refutable or not.
fn parse_if_let(start: i64) -> i64 {
    unsafe {
        expect(Let);
        let pattern = parse_pattern();
        expect(Eq);
        let n = new_node(NodeKind::Match, start, 0);
        NODES[n].a = parse_expr_no_struct();
        let then = parse_block();
        let mut flags = ARM_SYNTHETIC;
        let otherwise = if eat(Else) {
            parse_else_part()
        } else {
            flags = ARM_SYNTHETIC | ARM_NO_ELSE;
            new_node(NodeKind::Block, prev_end(), prev_end())
        };
        let wild = new_node(NodeKind::PatWild, NODES[otherwise].start, NODES[otherwise].start);
        let mark = list_begin();
        list_push(synthetic_arm(pattern, then, 0));
        list_push(synthetic_arm(wild, otherwise, flags));
        list_end(n, mark);
        NODES[n].end = prev_end();
        n
    }
}

// `match e { pattern [if guard] => body, ... }`
fn parse_match() -> i64 {
    unsafe {
        let start = cur_start();
        expect(Match);
        let n = new_node(NodeKind::Match, start, 0);
        NODES[n].a = parse_expr_no_struct();
        expect(LBrace);
        let saved = with_no_struct(false);
        let mark = list_begin();
        while !at(RBrace) && !at(Eof) {
            let arm = new_node(NodeKind::Arm, cur_start(), 0);
            NODES[arm].a = parse_pattern();
            if eat(If) {
                NODES[arm].b = parse_expr();
            }
            expect(FatArrow);
            if at_block_like() {
                // Ends at its closing brace, like a statement.
                NODES[arm].c = parse_primary();
                eat(Comma);
            } else {
                NODES[arm].c = parse_expr();
                if !at(RBrace) {
                    if !at(Comma) {
                        syntax_error(c"expected ',' or '}' after a match arm");
                    }
                    advance();
                }
            }
            NODES[arm].end = prev_end();
            list_push(arm);
        }
        list_end(n, mark);
        NO_STRUCT = saved;
        expect(RBrace);
        NODES[n].end = prev_end();
        n
    }
}

// `while let P = e { body }` (0.6), after `while`: the loop
// `loop { match e { P => { body }, _ => break } }`, keeping the label.
fn parse_while_let(label: i64, start: i64) -> i64 {
    unsafe {
        expect(Let);
        let pattern = parse_pattern();
        expect(Eq);
        let m = new_node(NodeKind::Match, start, 0);
        NODES[m].a = parse_expr_no_struct();
        let body = parse_block();
        let brk = new_node(NodeKind::Break, NODES[body].end, NODES[body].end);
        let wild = new_node(NodeKind::PatWild, NODES[body].end, NODES[body].end);
        let mark = list_begin();
        list_push(synthetic_arm(pattern, body, 0));
        list_push(synthetic_arm(wild, brk, ARM_SYNTHETIC));
        list_end(m, mark);
        NODES[m].end = prev_end();
        let block = new_node(NodeKind::Block, start, prev_end());
        NODES[block].a = m;
        let n = new_node(NodeKind::Loop, start, prev_end());
        NODES[n].a = label;
        NODES[n].b = block;
        n
    }
}

fn parse_loop(label: i64, start: i64) -> i64 {
    unsafe {
        if eat(Loop) {
            let n = new_node(NodeKind::Loop, start, 0);
            NODES[n].a = label;
            NODES[n].b = parse_block();
            NODES[n].end = prev_end();
            return n;
        }
        if eat(While) {
            if at(Let) {
                return parse_while_let(label, start);
            }
            let n = new_node(NodeKind::While, start, 0);
            NODES[n].a = label;
            NODES[n].b = parse_expr_no_struct();
            NODES[n].c = parse_block();
            NODES[n].end = prev_end();
            return n;
        }
        expect(For);
        let n = new_node(NodeKind::For, start, 0);
        NODES[n].a = label;
        NODES[n].b = parse_pattern();
        expect(In);
        NODES[n].c = parse_expr_no_struct();
        NODES[n].d = parse_block();
        NODES[n].end = prev_end();
        n
    }
}
