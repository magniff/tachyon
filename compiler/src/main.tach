// tachyonc: the tachyon compiler, written in tachyon. This file is the root
// of its module tree, one module per file of this directory (see
// compiler/README.md): tokens -> AST -> modules and names -> checked AST ->
// -O0's code generator, or (-O1, -O2) SSA IR -> the optimizer -> instruction
// selection -> register allocation -> assembly.
//
// The command line:
//
//   tachyonc [--target T] [-O0|-O1|-O2] <file.tach>... [-o out.s]
//                                   compile the files (one program) to
//                                   assembly for target T (default: the
//                                   host): aarch64-macos, x86_64-linux or
//                                   x86_64-macos, at an optimization level
//                                   (default -O2; see docs/optimizer.md)
//   --emit-ir                       write the optimized IR instead
//   --verify-ir                     check the IR after every pass
//   --print-after-all               print the IR after every pass (stderr)
//   --print-attrs                   print the inferred function
//                                   attributes (-O2, stderr)
//   --time-passes                   print the CPU time of each phase
//                                   (stderr)
//   --emit-imports                  write what `import`ed C headers declare
//                                   (as tachyon source) instead
//   --emit-header                   write the program's C header instead
//   -I DIR                          a directory for `import`ed C headers
//   tachyonc --tokens <file.tach>   print the tokens of one file
//   tachyonc --version              print the release and the host target

// Basics: the C library, arrays, buffers, symbols, files, errors.
mod base;

// The front end: tokens, C headers (import, --emit-header), the built-in
// std, the AST and parser, modules, types, the checker, constants,
// patterns, generics.
mod lexer;
mod cpp;
mod cimport;
mod cheader;
mod stdsrc;
mod ast;
mod parser;
mod modules;
mod types;
mod check;
mod consteval;
mod patterns;
mod generics;

// Code generation: the driver and -O0's generator, C's convention, the
// target interface, -O0's instruction sets.
mod gen;
mod abi;
mod target;
mod arm64;
mod x86_64;

// The middle end (-O1, -O2): the IR, lowering to SSA, the passes.
mod ir;
mod lower;
mod adce;
mod opt;
mod fold;
mod gvn;
mod sroa;
mod inline;
mod licm;
mod loops;
mod lsr;
mod range;
mod scev;
mod tre;
mod ipo;
mod promote;
mod timer;

// The back end: instruction selection, register allocation, emission,
// block layout, the machine instructions.
mod isel;
mod regalloc;
mod emit;
mod layout;
mod mc_arm64;
mod mc_x86_64;
mod objfile;
mod enc_arm64;
mod enc_x86;

// The standard library, named here in the root: 0.5.0, which builds this
// compiler, reads std only when the files of the command line name it.
use std::Option;

use base::*;
use lexer::*;
use cpp::*;
use cimport::*;
use modules::*;
use gen::*;
use target::*;
use objfile::*;
use ir::*;
use opt::*;
use ipo::*;
use timer::*;
use regalloc::*;
use emit::STATS;

extern "C" {
    fn uname(info: *u8) -> i32;
}

fn usage() -> ! {
    die(c"usage: tachyonc [--target aarch64-macos|x86_64-linux|x86_64-macos] [-O0|-O1|-O2] [--emit-ir] [--verify-ir] [--emit-imports] [--emit-header] [-I dir] <file.tach>... [-S|--emit-asm|-c] [-o out.o|out.s|program] | tachyonc --tokens <file.tach> | tachyonc --version")
}

// The release this source is; see docs/releases.md.
fn version() -> *u8 {
    c"0.6.0"
}

// struct utsname: sysname is the first field on every system; machine is
// the fifth, and the fields are 256 bytes long on macOS, 65 on Linux.
const UTSNAME_SIZE: i64 = 2048;
const MACOS_UTS_FIELD: i64 = 256;
const LINUX_UTS_FIELD: i64 = 65;

// The target of the machine this compiler runs on, or 0 when it has no
// backend for it.
pub fn host_target() -> i64 {
    let info = alloc_zeroed(UTSNAME_SIZE);
    if uname(info) != 0 {
        return 0;
    }
    let mut field = 0;
    if streq(info, c"Darwin") {
        field = MACOS_UTS_FIELD;
    } else if streq(info, c"Linux") {
        field = LINUX_UTS_FIELD;
    } else {
        return 0;
    }
    let machine = &info[4 * field];
    let x86 = streq(machine, c"x86_64");
    if field == MACOS_UTS_FIELD {
        if streq(machine, c"arm64") {
            return T_AARCH64_MACOS;
        }
        return if x86 { T_X86_64_MACOS } else { 0 };
    }
    if x86 { T_X86_64_LINUX } else { 0 }
}

fn print_version() {
    let out = buf_new();
    buf_str(out, c"tachyonc ");
    buf_str(out, version());
    let host = host_target();
    buf_str(out, c" (host: ");
    buf_str(out, if host == 0 { c"unsupported" } else { target_name(host) });
    buf_str(out, c")\n");
    buf_write_fd(out, STDOUT);
}

pub fn streq(a: *u8, b: *u8) -> bool {
    let n = strlen(a);
    n == strlen(b) && memcmp(a, b, n) == 0
}

fn main(argc: i32, argv: **u8) -> i32 {
    let mut inputs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    let mut output = c"a.o";
    let mut tokens_only = false;
    let mut target = 0;
    let mut include_dirs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    let mut emit_imports = false;
    let mut i = 1;
    while i < argc as i64 {
        let arg = argv[i];
        if streq(arg, c"-o") {
            if i + 1 >= argc as i64 {
                usage();
            }
            output = argv[i + 1];
            i += 2;
            continue;
        }
        if streq(arg, c"--target") {
            if i + 1 >= argc as i64 {
                usage();
            }
            target = target_of_name(argv[i + 1]);
            if target == 0 {
                die2(c"unknown target (expected aarch64-macos, x86_64-linux or x86_64-macos): ", argv[i + 1]);
            }
            i += 2;
            continue;
        }
        if streq(arg, c"-O0") || streq(arg, c"-O1") || streq(arg, c"-O2") {
            OPT_LEVEL = (arg[2] - '0') as i64;
            i += 1;
            continue;
        }
        if streq(arg, c"--emit-asm") || streq(arg, c"-S") {
            OUTPUT_MODE = OUT_ASM;
            i += 1;
            continue;
        }
        if streq(arg, c"-c") {
            OUTPUT_MODE = OUT_OBJECT;
            i += 1;
            continue;
        }
        if streq(arg, c"--emit-ir") {
            EMIT_IR = true;
            i += 1;
            continue;
        }
        if streq(arg, c"--emit-mir") {
            EMIT_MIR = true;
            i += 1;
            continue;
        }
        if streq(arg, c"--print-after-all") {
            PRINT_AFTER_ALL = true;
            i += 1;
            continue;
        }
        if streq(arg, c"--print-attrs") {
            PRINT_ATTRS = true;
            i += 1;
            continue;
        }
        if streq(arg, c"--time-passes") {
            TIME_PASSES = true;
            i += 1;
            continue;
        }
        if streq(arg, c"--verify-ir") {
            VERIFY_IR = true;
            i += 1;
            continue;
        }
        if streq(arg, c"--verify-regalloc") {
            VERIFY_REGALLOC = true;
            i += 1;
            continue;
        }
        if streq(arg, c"--stats") || streq(arg, c"--stats=functions") {
            STATS = if streq(arg, c"--stats") { 1 } else { 2 };
            i += 1;
            continue;
        }
        if streq(arg, c"--print-regalloc") {
            PRINT_REGALLOC = true;
            i += 1;
            continue;
        }
        if streq(arg, c"-I") {
            if i + 1 >= argc as i64 {
                usage();
            }
            include_dirs.push(argv[i + 1] as i64);
            i += 2;
            continue;
        }
        if arg[0] == '-' && arg[1] == 'I' {
            include_dirs.push(&arg[2] as i64);
            i += 1;
            continue;
        }
        if streq(arg, c"--emit-header") {
            EMIT_HEADER = true;
            i += 1;
            continue;
        }
        if streq(arg, c"--emit-imports") {
            emit_imports = true;
            i += 1;
            continue;
        }
        if streq(arg, c"--version") {
            print_version();
            return 0;
        }
        if streq(arg, c"--tokens") {
            tokens_only = true;
        } else {
            inputs.push(arg as i64);
        }
        i += 1;
    }
    if inputs.count == 0 {
        usage();
    }
    ERR_KIND = c"tokenizer error";
    load_sources(inputs.data as **u8, inputs.count);
    ERRORS_AS_DUMP = tokens_only;
    init_lexer();
    let user_files = FILE_COUNT;
    for f in 0..user_files {
        lex_range(FILES[f].start, FILES[f].end, tokens_only && f + 1 == user_files);
    }
    if !tokens_only {
        ERR_KIND = c"module error";
        load_modules();
        ERR_KIND = c"tokenizer error";
    }
    if tokens_only {
        let out = buf_new();
        dump_tokens(out, FILES[0].start);
        buf_write_fd(out, STDOUT);
        return 0;
    }
    if target == 0 {
        target = host_target();
        if target == 0 {
            die(c"no backend for this host; pass --target aarch64-macos, x86_64-linux or x86_64-macos");
        }
    }
    set_target(target);
    if OUTPUT_MODE < 0 {
        OUTPUT_MODE = output_mode_of(output);
    }
    import_c_headers(target, &include_dirs, emit_imports, output);
    lex_range(FILES[FILE_COUNT - 1].end, FILES[FILE_COUNT - 1].end, true);
    compile_program(output);
    0
}

// --emit-header: write the program's C header (cheader.tach).
pub static mut EMIT_HEADER: bool = false;

// The start in SRC of the declarations imported from C headers (-1: no
// `import`).
pub static mut IMPORTED_START: i64 = -1;

// `import "header.h";` items: the headers are read (cimport.tach) and
// their declarations, as tachyon source, are added to the program.
fn import_c_headers(target: i64, include_dirs: *IntVec, emit: bool, output: *u8) {
    let mut names = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    let mut dirs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for i in 0..TOK_COUNT {
        if TOKS[i].kind == Tok::Import && i + 1 < TOK_COUNT && TOKS[i + 1].kind == Tok::Str {
            let name = STRS[TOKS[i + 1].value as i64].ptr;
            let mut file = 0;
            while file + 1 < FILE_COUNT && TOKS[i].start >= FILES[file + 1].start {
                file += 1;
            }
            names.push(name as i64);
            C_IMPORT_POS.push(TOKS[i + 1].start);
            dirs.push(path_dir(FILES[file].path) as i64);
        }
    }
    if names.count == 0 {
        if emit {
            buf_write_file(buf_new(), output);
            exit(0);
        }
        return;
    }
    let text = c_import(&names, &dirs, include_dirs, target);
    if emit {
        buf_write_file(text, output);
        exit(0);
    }
    IMPORTED_START = add_source(c"<C import>", text);
    C_MODULE = add_module(intern_c(c"<c>"), 0, true);
    MODULES[C_MODULE].is_c = true;
    FILES[FILE_COUNT - 1].module = C_MODULE;
    lex_range(IMPORTED_START, FILES[FILE_COUNT - 1].end, false);
}
