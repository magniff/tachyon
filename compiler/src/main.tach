extern "C" {
    fn uname(info: *u8) -> i32;
}

fn usage() -> ! {
    unsafe { die(c"usage: tachyonc [--target aarch64-macos|aarch64-linux|x86_64-linux|x86_64-macos] [-O0|-O1|-O2] [-g] [--emit-ir] [--verify-ir] [--emit-imports] [--emit-header] [-I dir] [--deny-warnings] <file.tach>... [-S|--emit-asm|-c] [-o out.o|out.s|program] | tachyonc --fix-imports <file.tach>... | tachyonc --fix-unsafe <file.tach>... | tachyonc --tokens <file.tach> | tachyonc --version") }
}

// The release this source is; see docs/releases.md.
pub fn version() -> *u8 {
    c"0.10.0"
}

// struct utsname: sysname is the first field on every system; machine is
// the fifth, and the fields are 256 bytes long on macOS, 65 on Linux.
const UTSNAME_SIZE: i64 = 2048;
const MACOS_UTS_FIELD: i64 = 256;
const LINUX_UTS_FIELD: i64 = 65;

// The target of the machine this compiler runs on, or 0 when it has no
// backend for it.
pub fn host_target() -> i64 {
    unsafe {
        let info = alloc_zeroed(UTSNAME_SIZE);
        if uname(info) != 0 {
            return 0;
        }
        let mut field = 0;
        if streq(info, c"Darwin") {
            field = MACOS_UTS_FIELD;
        } else if streq(info, c"Linux") {
            field = LINUX_UTS_FIELD;
        } else {
            return 0;
        }
        let machine = &info[4 * field];
        let x86 = streq(machine, c"x86_64");
        if field == MACOS_UTS_FIELD {
            if streq(machine, c"arm64") {
                return T_AARCH64_MACOS;
            }
            return if x86 { T_X86_64_MACOS } else { 0 };
        }
        if x86 { T_X86_64_LINUX } else if streq(machine, c"aarch64") { T_AARCH64_LINUX } else { 0 }
    }
}

fn print_version() {
    unsafe {
        let out = buf_new();
        buf_str(out, c"tachyonc ");
        buf_str(out, version());
        let host = host_target();
        buf_str(out, c" (host: ");
        buf_str(out, if host == 0 { c"unsupported" } else { target_name(host) });
        buf_str(out, c")\n");
        buf_write_fd(out, STDOUT);
    }
}

pub fn streq(a: *u8, b: *u8) -> bool {
    unsafe {
        let n = strlen(a);
        n == strlen(b) && memcmp(a, b, n) == 0
    }
}

fn main(argc: i32, argv: **u8) -> i32 {
    unsafe {
        let mut inputs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut output = c"a.o";
        let mut tokens_only = false;
        let mut target = 0;
        let mut include_dirs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut emit_imports = false;
        let mut i = 1;
        while i < argc as i64 {
            let arg = argv[i];
            if streq(arg, c"-o") {
                if i + 1 >= argc as i64 {
                    usage();
                }
                output = argv[i + 1];
                i += 2;
                continue;
            }
            if streq(arg, c"--target") {
                if i + 1 >= argc as i64 {
                    usage();
                }
                target = target_of_name(argv[i + 1]);
                if target == 0 {
                    die2(c"unknown target (expected aarch64-macos, aarch64-linux, x86_64-linux or x86_64-macos): ", argv[i + 1]);
                }
                i += 2;
                continue;
            }
            if streq(arg, c"-O0") || streq(arg, c"-O1") || streq(arg, c"-O2") {
                OPT_LEVEL = (arg[2] - '0') as i64;
                i += 1;
                continue;
            }
            if streq(arg, c"--emit-asm") || streq(arg, c"-S") {
                OUTPUT_MODE = OUT_ASM;
                i += 1;
                continue;
            }
            if streq(arg, c"-c") {
                OUTPUT_MODE = OUT_OBJECT;
                i += 1;
                continue;
            }
            if streq(arg, c"--emit-ir") {
                EMIT_IR = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--emit-mir") {
                EMIT_MIR = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--print-after-all") {
                PRINT_AFTER_ALL = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--print-attrs") {
                PRINT_ATTRS = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--time-passes") {
                TIME_PASSES = true;
                i += 1;
                continue;
            }
            if streq(arg, c"-g") {
                DEBUG_INFO = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--verify-ir") {
                VERIFY_IR = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--verify-regalloc") {
                VERIFY_REGALLOC = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--stats") || streq(arg, c"--stats=functions") {
                STATS = if streq(arg, c"--stats") { 1 } else { 2 };
                i += 1;
                continue;
            }
            if streq(arg, c"--print-regalloc") {
                PRINT_REGALLOC = true;
                i += 1;
                continue;
            }
            if streq(arg, c"-I") {
                if i + 1 >= argc as i64 {
                    usage();
                }
                include_dirs.push(argv[i + 1] as i64);
                i += 2;
                continue;
            }
            if arg[0] == '-' && arg[1] == 'I' {
                include_dirs.push(&arg[2] as i64);
                i += 1;
                continue;
            }
            if streq(arg, c"--emit-header") {
                EMIT_HEADER = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--emit-imports") {
                emit_imports = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--fix-imports") {
                FIX_IMPORTS = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--fix-unsafe") {
                FIX_UNSAFE = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--no-vectorize") {
                VECTORIZE = false;
                i += 1;
                continue;
            }
            if streq(arg, c"--check-unsafe") {
                CHECK_UNSAFE = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--profile-generate") || streq(arg, c"--profile-use") {
                if i + 1 >= argc as i64 {
                    usage();
                }
                if streq(arg, c"--profile-use") {
                    PROFILE_USE = argv[i + 1];
                } else {
                    PROFILE_GENERATE = argv[i + 1];
                }
                i += 2;
                continue;
            }
            if streq(arg, c"--no-egraph") {
                EGRAPH = false;
                i += 1;
                continue;
            }
            if streq(arg, c"--check-rules") {
                return if check_rules(2000) == 0 { 0 } else { 1 };
            }
            if streq(arg, c"--deny-warnings") {
                DENY_WARNINGS = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--allow-unsafe") {
                // 0.9's option is gone: no bootstrap interface passes it
                // to 0.10 (see tachyonc-0.10 in bootstrap/releases.toml).
                die(c"--allow-unsafe was removed in 0.10: unsafe operations outside unsafe code are errors; `tachyonc --fix-unsafe` puts them in unsafe blocks");
            }
            if streq(arg, c"--version") {
                print_version();
                return 0;
            }
            if streq(arg, c"--tokens") {
                tokens_only = true;
            } else {
                inputs.push(arg as i64);
            }
            i += 1;
        }
        if inputs.count == 0 {
            usage();
        }
        if PROFILE_GENERATE != 0 as *u8 && OPT_LEVEL == 0 {
            die(c"--profile-generate needs -O1 or -O2");
        }
        if CHECK_UNSAFE && OPT_LEVEL == 0 {
            die(c"--check-unsafe needs -O1 or -O2");
        }
        // (-O0 optimizes nothing: a profile changes nothing there.)
        if OPT_LEVEL == 0 {
            PROFILE_USE = 0 as *u8;
        }
        ERR_KIND = c"tokenizer error";
        load_sources(inputs.data as **u8, inputs.count);
        ERRORS_AS_DUMP = tokens_only;
        init_lexer();
        let user_files = FILE_COUNT;
        for f in 0..user_files {
            lex_range(FILES[f].start, FILES[f].end, tokens_only && f + 1 == user_files);
        }
        if !tokens_only {
            ERR_KIND = c"module error";
            load_modules();
            ERR_KIND = c"tokenizer error";
        }
        if tokens_only {
            let out = buf_new();
            dump_tokens(out, FILES[0].start);
            buf_write_fd(out, STDOUT);
            return 0;
        }
        if target == 0 {
            target = host_target();
            if target == 0 {
                die(c"no backend for this host; pass --target aarch64-macos, aarch64-linux, x86_64-linux or x86_64-macos");
            }
        }
        set_target(target);
        if OUTPUT_MODE < 0 {
            OUTPUT_MODE = output_mode_of(output);
        }
        import_c_headers(target, &include_dirs, emit_imports, output);
        lex_range(FILES[FILE_COUNT - 1].end, FILES[FILE_COUNT - 1].end, true);
        compile_program(output);
        0
    }
}

// --emit-header: write the program's C header (cheader.tach).
pub static mut EMIT_HEADER: bool = false;

// The start in SRC of the declarations imported from C headers (-1: no
// `import`).
pub static mut IMPORTED_START: i64 = -1;

// `import "header.h" as c;` items: the headers are read (cimport.tach) and
// their declarations, as tachyon source, are added to the program.
fn import_c_headers(target: i64, include_dirs: *IntVec, emit: bool, output: *u8) {
    unsafe {
        let mut names = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut dirs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..TOK_COUNT {
            if TOKS[i].kind == Tok::Import && i + 1 < TOK_COUNT && TOKS[i + 1].kind == Tok::Str {
                let name = STRS[TOKS[i + 1].value as i64].ptr;
                let mut file = 0;
                while file + 1 < FILE_COUNT && TOKS[i].start >= FILES[file + 1].start {
                    file += 1;
                }
                names.push(name as i64);
                C_IMPORT_POS.push(TOKS[i + 1].start);
                dirs.push(path_dir(FILES[file].path) as i64);
            }
        }
        if names.count == 0 {
            if emit {
                buf_write_file(buf_new(), output);
                exit(0);
            }
            return;
        }
        // A recovery point (0.10): after an error in the headers, the
        // program is checked without them; the names they would have
        // brought (`c` in `import "h.h" as c;`) are failed names.
        let depth = RECOVER_DEPTH;
        let mut text = -1;
        if _setjmp(recover_enter()) == 0 {
            text = c_import(&names, &dirs, include_dirs, target);
        }
        recover_leave(depth);
        if text < 0 {
            for i in 0..TOK_COUNT {
                if TOKS[i].kind == Tok::Import && i + 3 < TOK_COUNT && TOKS[i + 2].kind == Tok::As
                    && TOKS[i + 3].kind == Tok::Ident {
                    fail_name(TOKS[i + 3].value as i64);
                }
            }
            if emit {
                exit_if_errors();
            }
            return;
        }
        if emit {
            buf_write_file(text, output);
            exit(0);
        }
        IMPORTED_START = add_source(c"<C import>", text);
        C_MODULE = add_module(intern_c(c"<c>"), 0, true);
        MODULES[C_MODULE].is_c = true;
        FILES[FILE_COUNT - 1].module = C_MODULE;
        lex_range(IMPORTED_START, FILES[FILE_COUNT - 1].end, false);
    }
}
