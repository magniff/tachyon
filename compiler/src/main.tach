// tachyonc: the tachyon compiler, written in tachyon. This file is the root
// of its module tree, one module per file of this directory (see
// compiler/README.md): tokens -> AST -> modules and names -> checked AST ->
// -O0's code generator, or (-O1, -O2) SSA IR -> the optimizer -> instruction
// selection -> register allocation -> assembly.
//
// The command line:
//
//   tachyonc [--target T] [-O0|-O1|-O2] <file.tach>... [-o out.s]
//                                   compile the files (one program) to
//                                   assembly for target T (default: the
//                                   host): aarch64-macos, aarch64-linux,
//                                   x86_64-linux or x86_64-macos, at an
//                                   optimization level
//                                   (default -O2; see docs/optimizer.md)
//   --emit-ir                       write the optimized IR instead
//   --verify-ir                     check the IR after every pass
//   --print-after-all               print the IR after every pass (stderr)
//   --print-attrs                   print the inferred function
//                                   attributes (-O2, stderr)
//   --time-passes                   print the CPU time of each phase
//                                   (stderr)
//   -g                              debug information: DWARF line tables
//                                   (0.11; see dwarf.tach)
//   --emit-imports                  write what `import`ed C headers declare
//                                   (as tachyon source) instead
//   --emit-header                   write the program's C header instead
//   -I DIR                          a directory for `import`ed C headers
//   --no-vectorize                  no loop vectorization (0.10: to
//                                   compare)
//   --profile-generate FILE         instrument the program: it writes its
//                                   blocks' counts to FILE at exit (0.10)
//   --profile-use FILE              optimize with the counts of FILE (0.10)
//   --check-unsafe                  check unsafe code's raw-pointer accesses
//                                   against the heap blocks at run time (0.10)
//   --no-egraph                     no rewrite rules in GVN (0.9: to
//                                   compare)
//   tachyonc --check-rules          check the rewrite rules on random
//                                   values (0.9)
//   --deny-warnings                 make warnings errors (0.9)
//   tachyonc --fix-unsafe <file.tach>...
//                                   wrap the unsafe operations outside
//                                   `unsafe` in unsafe blocks, in place
//   tachyonc --fix-imports <file.tach>...
//                                   rewrite 0.7's imports, in place
//   tachyonc --tokens <file.tach>   print the tokens of one file
//   tachyonc --version              print the release and the host target

// Basics: the C library, arrays, buffers, symbols, files, errors.
mod base;

