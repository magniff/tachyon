// The back end: instruction selection, register allocation, emission,
// block layout, the machine instructions.
mod isel;
mod regalloc;
mod emit;
mod layout;
mod mc_arm64;
mod mc_x86_64;
mod objfile;
mod enc_arm64;
mod enc_x86;
// Debug information (0.11).
mod dwarf;

