// Code generation: the driver and -O0's generator, C's convention, the
// target interface, -O0's instruction sets.
mod gen;
mod abi;
mod target;
mod arm64;
mod x86_64;

// The middle end (-O1, -O2): the IR, lowering to SSA, the passes.
mod ir;
mod lower;
mod adce;
mod opt;
mod fold;
mod gvn;
mod egraph;
mod sroa;
mod inline;
mod licm;
mod loops;
mod lsr;
mod range;
mod scev;
mod tre;
mod ipo;
