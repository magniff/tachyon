// tachyonc: the tachyon compiler, written in tachyon. This file is the root
// of its module tree and the driver; the modules are in a folder per phase
// (see compiler/README.md): tokens -> AST -> modules and names -> checked
// AST -> -O0's code generator, or (-O1, -O2) SSA IR -> the optimizer ->
// instruction selection -> register allocation -> assembly.
//
// The command line:
//
//   tachyonc [--target T] [-O0|-O1|-O2] <file.tach>... [-o out.s]
//                                   compile the files (one program) to
//                                   assembly for target T (default: the
//                                   host): aarch64-macos, aarch64-linux,
//                                   x86_64-linux or x86_64-macos, at an
//                                   optimization level
//                                   (default -O2; see docs/optimizer.md)
//   --emit-ir                       write the optimized IR instead
//   --verify-ir                     check the IR after every pass
//   --print-after-all               print the IR after every pass (stderr)
//   --print-attrs                   print the inferred function
//                                   attributes (-O2, stderr)
//   --time-passes                   print the CPU time of each phase
//                                   (stderr)
//   -g                              debug information: DWARF line tables
//                                   (0.11; see dwarf.tach)
//   --emit-imports                  write what `import`ed C headers declare
//                                   (as tachyon source) instead
//   --emit-header                   write the program's C header instead
//   -I DIR                          a directory for `import`ed C headers
//   --no-vectorize                  no loop vectorization (0.10: to
//                                   compare)
//   --no-unroll-runtime             no unrolling of loops whose trip count
//                                   is known at run time only (0.11: to
//                                   compare)
//   --no-slp                        no SLP vectorization (0.11: to compare)
//   --no-ifconv                     no if-conversion in loops (0.15: to
//                                   compare)
//   --profile-generate FILE         instrument the program: it writes its
//                                   blocks' counts to FILE at exit (0.10)
//   --profile-use FILE              optimize with the counts of FILE (0.10)
//   --check-unsafe                  check unsafe code's raw-pointer accesses
//                                   against the heap blocks at run time (0.10)
//   --no-egraph                     no rewrite rules in GVN (0.9: to
//                                   compare)
//   tachyonc --check-rules          check the rewrite rules on random
//                                   values (0.9)
//   --deny-warnings                 make warnings errors (0.9)
//   --diagnostics=short             one line per error or warning:
//                                   `file:line:col: error[kind] message |
//                                   help: ...` (0.11; =human: the default)
//   tachyonc --fix-unsafe <root.tach>
//                                   wrap the unsafe operations outside
//                                   `unsafe` in unsafe blocks, in place
//                                   (0.11: `fix --only unsafe`)
//   tachyonc --fix-imports <root.tach>
//                                   rewrite 0.7's imports, in place (0.11:
//                                   `fix --only imports`)
//   tachyonc query def|show|refs|callers|items|stats|deps|unused|impact ...
//                                   questions about a program, from the
//                                   front end (0.11; query.tach,
//                                   plan.tach, docs/query.md)
//   tachyonc edit patch|replace|insert|delete|wrap|new-file NAME ..., tachyonc undo
//                                   change a program by name, atomically
//                                   (0.11; edit.tach, docs/refactor.md)
//   tachyonc check [ROOT]           the front end's errors, one per line
//   tachyonc fix [ROOT]             every machine-applicable fix (fix.tach)
//   tachyonc lint --max-lines N     the files over N lines
//   tachyonc guide [TOPIC|--list]   the language guide (0.13; guide/,
//                                   compiler/guide/)
//   tachyonc same-output OLD        OLD's output and this compiler's, on a
//                                   corpus (sameout.tach)
//   tachyonc --tokens <file.tach>   print the tokens of one file
//   tachyonc --version              print the release and the host target

// Basics: the C library, arrays, buffers, symbols, files, errors, timers.
mod base;
// The front end: tokens, C imports and headers, std, the AST, modules,
// types, the checker.
mod front;
// The middle end (-O1, -O2): the IR, lowering to SSA, the passes.
mod middle;
// The back end: instruction selection, register allocation, emission,
// machine code, object files.
mod back;
// -O0's code generator and its target interface.
mod gen0;
// The tools on the front end (0.11): query, edit, refactor, fix, same-output.
mod tools;
// The language guide for newcomers (0.13): `tachyonc guide`.
mod guide;

// The standard library, named here in the root: 0.5.0, which builds this
// compiler, reads std only when the files of the command line name it.

use crate::back::dwarf::DEBUG_INFO;
use crate::back::emit::stats::STATS;
use crate::back::objfile::{OUTPUT_MODE, OUT_ASM, OUT_OBJECT, output_mode_of};
use crate::back::regalloc::{PRINT_REGALLOC, VERIFY_REGALLOC};
use crate::base::{
    FILES, FILE_COUNT, IntVec, STDERR, STDOUT, alloc_zeroed, buf_new, buf_str, buf_write_fd, die,
    die2, load_sources, streq,
};
use crate::base::diag::{DENY_WARNINGS, DIAG_SHORT, ERRORS_AS_DUMP, ERR_KIND};
use crate::base::json::DIAG_JSON;
use crate::base::target::{
    T_AARCH64_LINUX, T_AARCH64_MACOS, T_X86_64_LINUX, T_X86_64_MACOS, set_target, target_name,
    target_of_name,
};
use crate::base::timer::TIME_PASSES;
use crate::front::cheader::EMIT_HEADER;
use crate::front::cimport::import_c_headers;
use crate::front::lexer::{dump_tokens, init_lexer, lex_range};
use crate::front::modules::load_modules;
use crate::gen0::gen::{EMIT_IR, EMIT_MIR, compile_program};
use crate::middle::egraph::{EGRAPH, check_rules};
use crate::middle::ifconv::IFCONV;
use crate::middle::ipo::PRINT_ATTRS;
use crate::middle::ir::verify::{PRINT_AFTER_ALL, VERIFY_IR};
use crate::middle::opt::OPT_LEVEL;
use crate::middle::profile::{PROFILE_GENERATE, PROFILE_USE};
use crate::middle::slp::SLP;
use crate::middle::unsafecheck::CHECK_UNSAFE;
use crate::middle::vectorize::VECTORIZE;
use crate::middle::vectorize::unroll::UNROLL_RUNTIME;
use crate::tools::batch::run_batch;
use crate::tools::commands::run_command;
use crate::tools::fix::run_fix_alias;
use crate::tools::help::{is_help, run_help};

extern "C" {
    fn uname(info: *u8) -> i32;
    fn isatty(fd: i32) -> i32;
}

fn usage() -> ! {
    unsafe { die(c"usage: tachyonc [--target aarch64-macos|aarch64-linux|x86_64-linux|x86_64-macos] [-O0|-O1|-O2] [-g] [--emit-ir] [--verify-ir] [--emit-imports] [--emit-header] [-I dir] [--deny-warnings] [--diagnostics=short|human] [--json] <file.tach>... [-S|--emit-asm|-c] [-o out.o|out.s|program] | tachyonc guide [TOPIC|--list] (the language) | tachyonc query|edit|undo|check|fix|fmt|lint|same-output|explain ... (docs/query.md, docs/refactor.md, docs/fmt.md) | tachyonc --tokens <file.tach> | tachyonc --version") }
}

// The release this source is; see docs/releases.md.
pub fn version() -> *u8 {
    c"0.15.0"
}

// struct utsname: sysname is the first field on every system; machine is
// the fifth, and the fields are 256 bytes long on macOS, 65 on Linux.
const UTSNAME_SIZE: i64 = 2048;
const MACOS_UTS_FIELD: i64 = 256;
const LINUX_UTS_FIELD: i64 = 65;

// The target of the machine this compiler runs on, or 0 when it has no
// backend for it.
pub fn host_target() -> i64 {
    unsafe {
        let info = alloc_zeroed(UTSNAME_SIZE);
        if uname(info) != 0 {
            return 0;
        }
        let mut field = 0;
        if streq(info, c"Darwin") {
            field = MACOS_UTS_FIELD;
        } else if streq(info, c"Linux") {
            field = LINUX_UTS_FIELD;
        } else {
            return 0;
        }
        let machine = &info[4 * field];
        let x86 = streq(machine, c"x86_64");
        if field == MACOS_UTS_FIELD {
            if streq(machine, c"arm64") {
                return T_AARCH64_MACOS;
            }
            return if x86 { T_X86_64_MACOS } else { 0 };
        }
        if x86 { T_X86_64_LINUX } else if streq(machine, c"aarch64") { T_AARCH64_LINUX } else { 0 }
    }
}

fn print_version() {
    unsafe {
        let out = buf_new();
        buf_str(out, c"tachyonc ");
        buf_str(out, version());
        let host = host_target();
        buf_str(out, c" (host: ");
        buf_str(out, if host == 0 { c"unsupported" } else { target_name(host) });
        buf_str(out, c")\n");
        buf_write_fd(out, STDOUT);
    }
}

fn main(argc: i32, argv: **u8) -> i32 {
    unsafe {
        // (0.15) `--json`, anywhere: diagnostics and output as JSON lines
        // (base::diag::DIAG_JSON), for every command; taken out of argv.
        let mut argc = argc;
        let mut k = 1;
        while k < argc as i64 {
            if streq(argv[k], c"--json") {
                DIAG_JSON = true;
                for m in k..argc as i64 - 1 {
                    argv[m] = argv[m + 1];
                }
                argc -= 1;
            } else {
                k += 1;
            }
        }
        // (0.15: `--help` on every command, tools/help.tach; guide and
        // `query --help` have their own)
        if argc >= 2 && (is_help(argv[1]) || streq(argv[1], c"help")) {
            return run_help(argc as i64, argv) as i32;
        }
        for k in 2..argc as i64 {
            if is_help(argv[k]) && !streq(argv[1], c"guide")
                && !(k == 2 && streq(argv[1], c"query")) {
                return run_help(argc as i64, argv) as i32;
            }
        }
        // The tools (0.11): query, edit, undo, check, fix, the refactorings
        // ... (commands.tach); 0.15: several in one call, batch.
        let status = run_command(argc as i64, argv);
        if status >= 0 {
            return status as i32;
        }
        if argc >= 2 && streq(argv[1], c"batch") {
            return run_batch(argc as i64, argv) as i32;
        }
        // (0.8's --fix-imports and 0.9's --fix-unsafe: `fix --only`)
        for k in 1..argc as i64 {
            if streq(argv[k], c"--fix-imports") {
                return run_fix_alias(argc as i64, argv, 1) as i32;
            }
            if streq(argv[k], c"--fix-unsafe") {
                return run_fix_alias(argc as i64, argv, 8) as i32;
            }
        }
        // (0.15) A build prints its errors as `check` does, one per line,
        // when stderr is not a terminal (an agent, a script, a pipe);
        // `--diagnostics=human` or `=short` says which.
        DIAG_SHORT = isatty(STDERR) == 0;
        let mut inputs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut output = c"a.o";
        let mut tokens_only = false;
        let mut target = 0;
        let mut include_dirs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut emit_imports = false;
        let mut i = 1;
        while i < argc as i64 {
            let arg = argv[i];
            if streq(arg, c"-o") {
                if i + 1 >= argc as i64 {
                    usage();
                }
                output = argv[i + 1];
                i += 2;
                continue;
            }
            if streq(arg, c"--target") {
                if i + 1 >= argc as i64 {
                    usage();
                }
                target = target_of_name(argv[i + 1]);
                if target == 0 {
                    die2(c"unknown target (expected aarch64-macos, aarch64-linux, x86_64-linux or x86_64-macos): ", argv[i + 1]);
                }
                i += 2;
                continue;
            }
            if streq(arg, c"-O0") || streq(arg, c"-O1") || streq(arg, c"-O2") {
                OPT_LEVEL = (arg[2] - '0') as i64;
                i += 1;
                continue;
            }
            if streq(arg, c"--emit-asm") || streq(arg, c"-S") {
                OUTPUT_MODE = OUT_ASM;
                i += 1;
                continue;
            }
            if streq(arg, c"-c") {
                OUTPUT_MODE = OUT_OBJECT;
                i += 1;
                continue;
            }
            if streq(arg, c"--emit-ir") {
                EMIT_IR = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--emit-mir") {
                EMIT_MIR = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--print-after-all") {
                PRINT_AFTER_ALL = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--print-attrs") {
                PRINT_ATTRS = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--time-passes") {
                TIME_PASSES = true;
                i += 1;
                continue;
            }
            if streq(arg, c"-g") {
                DEBUG_INFO = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--verify-ir") {
                VERIFY_IR = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--verify-regalloc") {
                VERIFY_REGALLOC = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--stats") || streq(arg, c"--stats=functions") {
                STATS = if streq(arg, c"--stats") { 1 } else { 2 };
                i += 1;
                continue;
            }
            if streq(arg, c"--print-regalloc") {
                PRINT_REGALLOC = true;
                i += 1;
                continue;
            }
            if streq(arg, c"-I") {
                if i + 1 >= argc as i64 {
                    usage();
                }
                include_dirs.push(argv[i + 1] as i64);
                i += 2;
                continue;
            }
            if arg[0] == '-' && arg[1] == 'I' {
                include_dirs.push(&arg[2] as i64);
                i += 1;
                continue;
            }
            if streq(arg, c"--emit-header") {
                EMIT_HEADER = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--emit-imports") {
                emit_imports = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--no-ifconv") {
                IFCONV = false;
                i += 1;
                continue;
            }
            if streq(arg, c"--no-vectorize") {
                VECTORIZE = false;
                i += 1;
                continue;
            }
            if streq(arg, c"--no-unroll-runtime") {
                UNROLL_RUNTIME = false;
                i += 1;
                continue;
            }
            if streq(arg, c"--no-slp") {
                SLP = false;
                i += 1;
                continue;
            }
            if streq(arg, c"--check-unsafe") {
                CHECK_UNSAFE = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--profile-generate") || streq(arg, c"--profile-use") {
                if i + 1 >= argc as i64 {
                    usage();
                }
                if streq(arg, c"--profile-use") {
                    PROFILE_USE = argv[i + 1];
                } else {
                    PROFILE_GENERATE = argv[i + 1];
                }
                i += 2;
                continue;
            }
            if streq(arg, c"--no-egraph") {
                EGRAPH = false;
                i += 1;
                continue;
            }
            if streq(arg, c"--check-rules") {
                return if check_rules(2000) == 0 { 0 } else { 1 };
            }
            if streq(arg, c"--deny-warnings") {
                DENY_WARNINGS = true;
                i += 1;
                continue;
            }
            if streq(arg, c"--diagnostics=short") || streq(arg, c"--diagnostics=human") {
                DIAG_SHORT = streq(arg, c"--diagnostics=short");
                i += 1;
                continue;
            }
            if streq(arg, c"--allow-unsafe") {
                // 0.9's option is gone: no bootstrap interface passes it
                // to 0.10 (see tachyonc-0.10 in bootstrap/releases.toml).
                die(c"--allow-unsafe was removed in 0.10: unsafe operations outside unsafe code are errors; `tachyonc --fix-unsafe` puts them in unsafe blocks");
            }
            if streq(arg, c"--version") {
                print_version();
                return 0;
            }
            if streq(arg, c"--tokens") {
                tokens_only = true;
            } else {
                inputs.push(arg as i64);
            }
            i += 1;
        }
        if inputs.count == 0 {
            usage();
        }
        if PROFILE_GENERATE != 0 as *u8 && OPT_LEVEL == 0 {
            die(c"--profile-generate needs -O1 or -O2");
        }
        if CHECK_UNSAFE && OPT_LEVEL == 0 {
            die(c"--check-unsafe needs -O1 or -O2");
        }
        // (-O0 optimizes nothing: a profile changes nothing there.)
        if OPT_LEVEL == 0 {
            PROFILE_USE = 0 as *u8;
        }
        ERR_KIND = c"tokenizer error";
        load_sources(inputs.data as **u8, inputs.count);
        ERRORS_AS_DUMP = tokens_only;
        init_lexer();
        let user_files = FILE_COUNT;
        for f in 0..user_files {
            lex_range(FILES[f].start, FILES[f].end, tokens_only && f + 1 == user_files);
        }
        if !tokens_only {
            ERR_KIND = c"module error";
            load_modules();
            ERR_KIND = c"tokenizer error";
        }
        if tokens_only {
            let out = buf_new();
            dump_tokens(out, FILES[0].start);
            buf_write_fd(out, STDOUT);
            return 0;
        }
        if target == 0 {
            target = host_target();
            if target == 0 {
                die(c"no backend for this host; pass --target aarch64-macos, aarch64-linux, x86_64-linux or x86_64-macos");
            }
        }
        set_target(target);
        if OUTPUT_MODE < 0 {
            OUTPUT_MODE = output_mode_of(output);
        }
        import_c_headers(target, &include_dirs, emit_imports, output);
        lex_range(FILES[FILE_COUNT - 1].end, FILES[FILE_COUNT - 1].end, true);
        compile_program(output);
        0
    }
}
