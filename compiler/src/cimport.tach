// C import (2/2): C declarations to tachyon, for `import "header.h" as c;`.
//
// The preprocessed headers (cpp.tach) are parsed as C declarations
// (C11 6.7, with the GNU extensions of system headers: __attribute__,
// __asm__ labels, __extension__, anonymous members) and written out as
// tachyon source: `#[repr(C)]` structs and unions with C's exact layout
// (computed here: bit-fields, `packed` and `aligned` become explicit
// padding where tachyon's own C layout would differ), type aliases for
// typedefs and enums, constants for enumerators and for object-like
// macros that are integer or float constants, and an `extern "C"` block
// of functions and variables (with `#[link_name]` where a label renames
// the symbol). That text is then compiled with the program (90_main).
//
// What tachyon cannot express is left out, and remembered with the
// reason, for the error when it is used: long double (80-bit on x86-64),
// _Complex, __int128, vectors, variables with thread-local storage,
// `static` and inline functions. A struct whose layout depends on such a
// type stays opaque (usable through pointers only).

use crate::base::{
    IntVec, SYMS, alloc_zeroed, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_uint,
    BUFS, die, die2, grow, intern, intern_c, strlen, strtod, sym_name,
};
use crate::lexer::{Tok, keyword_of_sym};
use crate::cpp::{
    CDIRS, CINTS, CK, CTOKS, C_EOF, C_IMPORT_FILE, EV_FAIL, EV_N, EV_POS, EV_TOKS, MACROS,
    MACRO_COUNT, S_LPAREN, S_RPAREN, c_load_text, cpp_next, cpp_query_compiler, ctok_copy, ctok_is,
    ctok_text, ev_convert, ev_peek, ev_unary, eval_tokens, expand_list, init_cpp, macro_of,
    macro_tok, path_join, push_frame, snprintf, strtof, strtoull, c_compiler_given,
};
use crate::ast::{NODES, NodeKind, child, list_begin, list_end, list_push};
use crate::modules::module_of;
use crate::types::align_to;
use crate::target::{T_AARCH64_MACOS, T_X86_64_LINUX, T_X86_64_MACOS, target_name};
use crate::lower::HMap;
use crate::{IMPORTED_START, host_target, streq};
use CT::{Array, Bad, Bool, Enum, Float, Func, Int, Named, Ptr, Record, Void};

enum CT { Void, Int, Bool, Float, Ptr, Array, Func, Record, Enum, Named, Bad }

// Int: a=bits b=signed. Float: a=bits. Ptr: a=pointee. Array: a=element
// b=length (-1: unknown). Func: a=result b=params (CINTS) c=count
// d=variadic. Record: a=record. Enum: a=enum. Named: a=typedef.
// Bad: a=the reason (a symbol).
struct CType { kind: CT, a: i64, b: i64, c: i64, d: i64 }

static mut CTYPES: *CType = 0 as *CType;
static mut CTYPE_COUNT: i64 = 0;
static mut CTYPE_CAP: i64 = 0;
static mut CTY_INTS: [i64; 16] = [0; 16];
static mut CTY_VOID: i64 = 0;
static mut CTY_BOOL: i64 = 0;
static mut CTY_F32: i64 = 0;
static mut CTY_F64: i64 = 0;

fn cty_new(kind: CT, a: i64, b: i64, c: i64, d: i64) -> i64 {
    unsafe {
        CTYPES = grow(CTYPES, CTYPE_COUNT, &CTYPE_CAP);
        CTYPES[CTYPE_COUNT] = CType { kind: kind, a: a, b: b, c: c, d: d };
    }
    CTYPE_COUNT += 1;
    CTYPE_COUNT - 1
}

fn bits_index(bits: i64) -> i64 {
    if bits == 8 { 0 } else if bits == 16 { 1 } else if bits == 32 { 2 } else { 3 }
}

pub fn cty_int(bits: i64, signed: bool) -> i64 {
    CTY_INTS[bits_index(bits) * 2 + signed as i64]
}

fn cty_bad(reason: *u8) -> i64 {
    cty_new(Bad, intern_c(reason), 0, 0, 0)
}

fn cty_ptr(t: i64) -> i64 {
    cty_new(Ptr, t, 0, 0, 0)
}

// Through typedefs.
fn cty_resolve(t: i64) -> i64 {
    unsafe {
        let mut r = t;
        while CTYPES[r].kind == Named {
            r = CTYPEDEFS[CTYPES[r].a].ty;
        }
        r
    }
}

// Integer-like: integers, bool, enums (as their integer type).
fn cty_integer(t: i64) -> i64 {
    unsafe {
        let r = cty_resolve(t);
        match CTYPES[r].kind {
            Int => r,
            Bool => cty_int(8, false),
            Enum => cty_integer(CENUMS[CTYPES[r].a].underlying),
            _ => 0,
        }
    }
}

pub fn cty_bits(t: i64) -> i64 {
    let r = cty_integer(t);
    if r == 0 { 64 } else { unsafe { CTYPES[r].a } }
}

pub fn cty_signed(t: i64) -> bool {
    let r = cty_integer(t);
    unsafe { r != 0 && CTYPES[r].b != 0 }
}

// ---- Declarations ----

// Records: `opaque` is the reason (a symbol) it cannot be laid out or
// expressed, or -1. `name`: its tachyon name. `state`: layout 0 not done,
// 1 in progress, 2 done.
struct CRec {
    tag: i64, is_union: i64, complete: i64, packed: i64, align_attr: i64,
    fields: i64, field_count: i64, size: i64, align: i64, state: i64,
    opaque: i64, name: i64, ty: i64, parent: i64, emit_packed: i64, emit_align: i64, pack: i64,
}
// `bits`: the width of a bit-field, -1 for other fields; `name` -1 for
// anonymous members and unnamed bit-fields.
struct CField { name: i64, ty: i64, bits: i64, align_attr: i64, offset: i64, bit_offset: i64 }
struct CEnum { tag: i64, underlying: i64, name: i64, ty: i64, has_values: i64 }
struct CTypedef { name: i64, ty: i64, tname: i64, align_attr: i64 }
struct CFunc { name: i64, ty: i64, link: i64, noreturn: i64 }
struct CVar { name: i64, ty: i64, link: i64, is_const: i64 }
struct CEnumerator { name: i64, value: i64, ty: i64 }

static mut CRECS: *CRec = 0 as *CRec;
static mut CREC_COUNT: i64 = 0;
static mut CREC_CAP: i64 = 0;
static mut CFIELDS: *CField = 0 as *CField;
static mut CFIELD_COUNT: i64 = 0;
static mut CFIELD_CAP: i64 = 0;
static mut CENUMS: *CEnum = 0 as *CEnum;
static mut CENUM_COUNT: i64 = 0;
static mut CENUM_CAP: i64 = 0;
static mut CTYPEDEFS: *CTypedef = 0 as *CTypedef;
static mut CTYPEDEF_COUNT: i64 = 0;
static mut CTYPEDEF_CAP: i64 = 0;
static mut CFUNCS: *CFunc = 0 as *CFunc;
static mut CFUNC_COUNT: i64 = 0;
static mut CFUNC_CAP: i64 = 0;
static mut CVARS: *CVar = 0 as *CVar;
static mut CVAR_COUNT: i64 = 0;
static mut CVAR_CAP: i64 = 0;
static mut CENUMERATORS: *CEnumerator = 0 as *CEnumerator;
static mut CENUMERATOR_COUNT: i64 = 0;
static mut CENUMERATOR_CAP: i64 = 0;

// C's namespaces (symbol + 1 -> index + 1): tags, typedefs, functions and
// variables, enumerators.
static mut TAG_OF: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static mut TYPEDEF_OF: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static mut FUNC_OF: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static mut VAR_OF: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static mut ENUMERATOR_OF: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
// Names left out, with the reason: symbol + 1 -> reason symbol + 1.
static mut C_SKIPPED: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

fn crec_new(tag: i64, is_union: bool) -> i64 {
    unsafe {
        CRECS = grow(CRECS, CREC_COUNT, &CREC_CAP);
        let r = CREC_COUNT;
        CREC_COUNT += 1;
        CRECS[r] = CRec {
            tag: tag, is_union: is_union as i64, complete: 0, packed: 0, align_attr: 0,
            fields: 0, field_count: 0, size: -1, align: 1, state: 0, opaque: -1, name: -1,
            ty: 0, parent: -1, emit_packed: 0, emit_align: 0, pack: 0,
        };
        CRECS[r].ty = cty_new(Record, r, 0, 0, 0);
        r
    }
}

fn cfield(r: i64, i: i64) -> *CField {
    unsafe { &CFIELDS[CINTS.data[CRECS[r].fields + i]] }
}

fn skip_reason(name: i64, reason: i64) {
    if name >= 0 && C_SKIPPED.get(name + 1) == 0 {
        C_SKIPPED.put(name + 1, reason + 1);
    }
}

// ---- The token cursor ----

static mut D_TOKS: *i64 = 0 as *i64;
static mut D_N: i64 = 0;
static mut D_POS: i64 = 0;
// The declaration being read cannot be: the reason (a symbol), or -1.
static mut D_BAD: i64 = -1;

fn dpeek(k: i64) -> i64 {
    if D_POS + k < D_N { unsafe { D_TOKS[D_POS + k] } } else { C_EOF }
}

fn dcur() -> i64 {
    dpeek(0)
}

fn d_is(text: *u8) -> bool {
    let t = dcur();
    unsafe { t != C_EOF && CTOKS[t].kind != CK::Str && CTOKS[t].kind != CK::Char && streq(ctok_text(t), text) }
}

fn d_is_at(k: i64, text: *u8) -> bool {
    let t = dpeek(k);
    unsafe { t != C_EOF && CTOKS[t].kind != CK::Str && CTOKS[t].kind != CK::Char && streq(ctok_text(t), text) }
}

fn d_eat(text: *u8) -> bool {
    if d_is(text) {
        D_POS += 1;
        return true;
    }
    false
}

fn d_fail(reason: *u8) {
    if D_BAD < 0 {
        D_BAD = intern_c(reason);
    }
    D_POS = D_N;
}

fn d_expect(text: *u8) {
    if !d_eat(text) {
        unsafe { d_fail(c"syntax tachyon cannot read"); }
    }
}

// Skips a balanced (...) group starting at `(`.
fn d_skip_parens() {
    unsafe {
        if !d_eat(c"(") {
            return;
        }
        let mut depth = 1;
        while depth > 0 && D_POS < D_N {
            if d_is(c"(") {
                depth += 1;
            } else if d_is(c")") {
                depth -= 1;
            }
            D_POS += 1;
        }
    }
}

// ---- Attributes ----

// What `__attribute__((...))` and `__asm__("...")` said about the
// declaration being read.
static mut A_PACKED: bool = false;
static mut A_ALIGN: i64 = 0;
static mut A_MODE: i64 = 0;
static mut A_LINK: i64 = -1;
static mut A_NORETURN: bool = false;
static mut A_UNAVAILABLE: bool = false;
static mut A_VECTOR: bool = false;

fn attrs_reset() {
    A_PACKED = false;
    A_ALIGN = 0;
    A_MODE = 0;
    A_LINK = -1;
    A_NORETURN = false;
    A_UNAVAILABLE = false;
    A_VECTOR = false;
}

// An attribute's name without GNU's underscores: __packed__ is packed.
fn attr_name(t: i64) -> *u8 {
    let s = unsafe { SYMS[CTOKS[t].text].text };
    let mut lo = 0;
    let mut hi = s.len as i64;
    if hi > 4 && s[0] == '_' && s[1] == '_' && s[hi - 1] == '_' && s[hi - 2] == '_' {
        lo = 2;
        hi -= 2;
    }
    sym_name(intern(s[lo..hi]))
}

// Attributes and asm labels, wherever they may appear.
fn d_attributes() {
    unsafe {
        loop {
            if d_is(c"__attribute__") || d_is(c"__attribute") {
                D_POS += 1;
                d_expect(c"(");
                d_expect(c"(");
                while !d_is(c")") && D_POS < D_N {
                    if d_is(c",") {
                        D_POS += 1;
                        continue;
                    }
                    let t = dcur();
                    D_POS += 1;
                    let name = attr_name(t);
                    if streq(name, c"packed") {
                        A_PACKED = true;
                    } else if streq(name, c"noreturn") {
                        A_NORETURN = true;
                    } else if streq(name, c"unavailable") {
                        A_UNAVAILABLE = true;
                    } else if streq(name, c"vector_size") || streq(name, c"ext_vector_type") {
                        A_VECTOR = true;
                    } else if streq(name, c"aligned") {
                        if d_is(c"(") {
                            let (v, ok) = d_paren_value();
                            if ok {
                                A_ALIGN = v;
                            }
                        } else {
                            A_ALIGN = 16;
                        }
                        continue;
                    } else if streq(name, c"mode") && d_is(c"(") {
                        D_POS += 1;
                        let m = attr_name(dcur());
                        A_MODE = if streq(m, c"QI") || streq(m, c"byte") { 8 } else if streq(m, c"HI") { 16 }
                            else if streq(m, c"SI") { 32 } else if streq(m, c"DI") || streq(m, c"word") || streq(m, c"pointer") { 64 }
                            else { -1 };
                        D_POS += 1;
                        d_expect(c")");
                        continue;
                    }
                    if d_is(c"(") {
                        d_skip_parens();
                    }
                }
                d_expect(c")");
                d_expect(c")");
            } else if d_is(c"__asm__") || d_is(c"__asm") || d_is(c"asm") {
                D_POS += 1;
                d_expect(c"(");
                let b = buf_new();
                while dcur() != C_EOF && CTOKS[dcur()].kind == CK::Str {
                    let s = SYMS[CTOKS[dcur()].text].text;
                    buf_bytes(b, s[1..s.len as i64 - 1]);
                    D_POS += 1;
                }
                d_expect(c")");
                A_LINK = intern(buf_slice(b));
            } else if d_is(c"__declspec") {
                D_POS += 1;
                d_skip_parens();
            } else {
                return;
            }
        }
    }
}

// `( constant-expression )`: its value.
fn d_paren_value() -> (i64, bool) {
    unsafe {
        let open = dcur();
        if !d_eat(c"(") {
            return (0, false);
        }
        let list = d_collect_until(c")", c")");
        d_expect(c")");
        let (v, _) = eval_tokens(&list, open, true);
        (v as i64, !EV_FAIL)
    }
}

// The tokens up to `a` or `b` at depth 0 (not consumed).
fn d_collect_until(a: *u8, b: *u8) -> IntVec {
    unsafe {
        let mut out = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut depth = 0;
        while D_POS < D_N {
            if depth == 0 && (d_is(a) || d_is(b)) {
                break;
            }
            if d_is(c"(") || d_is(c"[") || d_is(c"{") {
                depth += 1;
            } else if d_is(c")") || d_is(c"]") || d_is(c"}") {
                if depth == 0 {
                    break;
                }
                depth -= 1;
            }
            out.push(dcur());
            D_POS += 1;
        }
        out
    }
}

// ---- Specifiers ----

const SP_TYPEDEF: i64 = 1;
const SP_EXTERN: i64 = 2;
const SP_STATIC: i64 = 4;
const SP_INLINE: i64 = 8;
const SP_NORETURN: i64 = 16;
const SP_CONST: i64 = 32;
const SP_THREAD: i64 = 64;

fn is_qualifier(s: *u8) -> bool {
    let names: [*u8; 17] = [c"const", c"__const", c"volatile", c"__volatile", c"__volatile__",
        c"restrict", c"__restrict", c"__restrict__", c"_Nullable", c"_Nonnull",
        c"_Null_unspecified", c"_Nullable_result", c"__nullable", c"__nonnull",
        c"__unaligned", c"__ptr64", c"__ptr32"];
    for i in 0..17 {
        if unsafe { streq(s, names[i]) } {
            return true;
        }
    }
    false
}

fn is_type_keyword(s: *u8) -> bool {
    let names: [*u8; 33] = [c"void", c"char", c"short", c"int", c"long", c"float", c"double",
        c"signed", c"__signed", c"__signed__", c"unsigned", c"_Bool", c"_Complex", c"__complex__",
        c"__int128", c"__int128_t", c"__uint128_t", c"_Float16", c"_Float32", c"_Float64",
        c"_Float128", c"_Float32x", c"_Float64x", c"__float128", c"__fp16", c"__bf16",
        c"struct", c"union", c"enum", c"__builtin_va_list", c"__typeof__", c"__typeof", c"typeof"];
    for i in 0..33 {
        if unsafe { streq(s, names[i]) } {
            return true;
        }
    }
    false
}

fn is_storage_word(s: *u8) -> bool {
    unsafe {
        streq(s, c"typedef") || streq(s, c"extern") || streq(s, c"static") || streq(s, c"auto")
            || streq(s, c"register") || streq(s, c"_Thread_local") || streq(s, c"__thread")
            || streq(s, c"inline") || streq(s, c"__inline") || streq(s, c"__inline__")
            || streq(s, c"_Noreturn") || streq(s, c"__extension__") || streq(s, c"_Alignas")
            || streq(s, c"__attribute__") || streq(s, c"__attribute") || streq(s, c"_Atomic")
    }
}

fn typedef_of(sym: i64) -> i64 {
    TYPEDEF_OF.get(sym + 1) - 1
}

// Whether token k starts a type name (for casts, sizeof, parameters).
fn d_starts_type(k: i64) -> bool {
    unsafe {
        let t = dpeek(k);
        if t == C_EOF || CTOKS[t].kind != CK::Ident {
            return false;
        }
        let s = ctok_text(t);
        is_type_keyword(s) || is_qualifier(s) || is_storage_word(s) || typedef_of(CTOKS[t].text) >= 0
    }
}

// Declaration specifiers: the base type and SP_* flags.
fn d_specifiers() -> (i64, i64) {
    unsafe {
        let mut flags = 0;
        let mut other = 0;
        let mut n_void = 0;
        let mut n_char = 0;
        let mut n_short = 0;
        let mut n_int = 0;
        let mut n_long = 0;
        let mut n_float = 0;
        let mut n_double = 0;
        let mut n_signed = 0;
        let mut n_unsigned = 0;
        let mut n_bool = 0;
        let mut bad = -1;
        let mut seen = false;
        while D_POS < D_N {
            let t = dcur();
            if CTOKS[t].kind != CK::Ident {
                break;
            }
            let s = ctok_text(t);
            if streq(s, c"__attribute__") || streq(s, c"__attribute") || streq(s, c"__declspec") {
                d_attributes();
                continue;
            }
            if is_qualifier(s) {
                if streq(s, c"const") || streq(s, c"__const") {
                    flags |= SP_CONST;
                }
                D_POS += 1;
                continue;
            }
            if streq(s, c"_Atomic") {
                if d_is_at(1, c"(") {
                    d_fail(c"_Atomic");
                    break;
                }
                D_POS += 1;
                continue;
            }
            if streq(s, c"_Alignas") || streq(s, c"alignas") {
                D_POS += 1;
                let (v, ok) = d_paren_value();
                if ok {
                    A_ALIGN = v;
                }
                continue;
            }
            let storage = if streq(s, c"typedef") { SP_TYPEDEF } else if streq(s, c"extern") { SP_EXTERN }
                else if streq(s, c"static") { SP_STATIC }
                else if streq(s, c"inline") || streq(s, c"__inline") || streq(s, c"__inline__") { SP_INLINE }
                else if streq(s, c"_Noreturn") { SP_NORETURN }
                else if streq(s, c"_Thread_local") || streq(s, c"__thread") { SP_THREAD }
                else if streq(s, c"auto") || streq(s, c"register") || streq(s, c"__extension__") { -1 }
                else { 0 };
            if storage != 0 {
                if storage > 0 {
                    flags |= storage;
                }
                D_POS += 1;
                continue;
            }
            if streq(s, c"void") { n_void += 1; }
            else if streq(s, c"char") { n_char += 1; }
            else if streq(s, c"short") { n_short += 1; }
            else if streq(s, c"int") { n_int += 1; }
            else if streq(s, c"long") { n_long += 1; }
            else if streq(s, c"float") { n_float += 1; }
            else if streq(s, c"double") { n_double += 1; }
            else if streq(s, c"signed") || streq(s, c"__signed") || streq(s, c"__signed__") { n_signed += 1; }
            else if streq(s, c"unsigned") { n_unsigned += 1; }
            else if streq(s, c"_Bool") { n_bool += 1; }
            else if streq(s, c"_Complex") || streq(s, c"__complex__") { bad = intern_c(c"_Complex"); }
            else if streq(s, c"__int128") || streq(s, c"__int128_t") || streq(s, c"__uint128_t") { bad = intern_c(c"__int128"); }
            else if streq(s, c"_Float32") { other = CTY_F32; }
            else if streq(s, c"_Float64") || streq(s, c"_Float32x") { other = CTY_F64; }
            else if streq(s, c"_Float16") || streq(s, c"__fp16") || streq(s, c"__bf16") { bad = intern_c(c"a 16-bit float"); }
            else if streq(s, c"_Float128") || streq(s, c"_Float64x") || streq(s, c"__float128") { bad = intern_c(c"a 128-bit float"); }
            else if streq(s, c"__builtin_va_list") { other = c_va_list(); }
            else if streq(s, c"struct") || streq(s, c"union") {
                D_POS += 1;
                other = d_record(streq(s, c"union"));
                seen = true;
                continue;
            } else if streq(s, c"enum") {
                D_POS += 1;
                other = d_enum();
                seen = true;
                continue;
            } else if streq(s, c"__typeof__") || streq(s, c"__typeof") || streq(s, c"typeof") {
                D_POS += 1;
                d_skip_parens();
                bad = intern_c(c"typeof");
                seen = true;
                continue;
            } else if !seen && typedef_of(CTOKS[t].text) >= 0 {
                other = cty_new(Named, typedef_of(CTOKS[t].text), 0, 0, 0);
            } else {
                break;
            }
            seen = true;
            D_POS += 1;
        }
        if bad >= 0 {
            return (cty_new(Bad, bad, 0, 0, 0), flags);
        }
        if other != 0 {
            return (other, flags);
        }
        if n_void > 0 {
            return (CTY_VOID, flags);
        }
        if n_bool > 0 {
            return (CTY_BOOL, flags);
        }
        if n_float > 0 {
            return (CTY_F32, flags);
        }
        if n_double > 0 {
            if n_long > 0 {
                return (if C_LONG_DOUBLE_64 { CTY_F64 } else { cty_bad(c"long double") }, flags);
            }
            return (CTY_F64, flags);
        }
        if n_char > 0 {
            // Plain char is tachyon's byte, u8 (the type of c"..." strings).
            return (cty_int(8, n_signed > 0), flags);
        }
        let signed = n_unsigned == 0;
        if n_short > 0 {
            return (cty_int(16, signed), flags);
        }
        if n_long > 0 {
            return (cty_int(64, signed), flags);
        }
        if n_int > 0 || n_signed > 0 || n_unsigned > 0 || flags != 0 {
            return (cty_int(32, signed), flags);
        }
        d_fail(c"a declaration without a type");
        (cty_int(32, true), flags)
    }
}

static mut C_LONG_DOUBLE_64: bool = false;
static mut C_VA_LIST: i64 = 0;
static mut C_TARGET_X86: bool = false;

// __builtin_va_list: `char *` on Apple's arm64, an array of one
// struct __va_list_tag on x86-64.
fn c_va_list() -> i64 {
    unsafe {
        if C_VA_LIST != 0 {
            return C_VA_LIST;
        }
        if !C_TARGET_X86 {
            C_VA_LIST = cty_ptr(cty_int(8, false));
            return C_VA_LIST;
        }
        let r = crec_new(intern_c(c"__va_list_tag"), false);
        TAG_OF.put(CRECS[r].tag + 1, r * 4 + 1);
        let names: [*u8; 4] = [c"gp_offset", c"fp_offset", c"overflow_arg_area", c"reg_save_area"];
        CRECS[r].fields = CINTS.count;
        let start = CINTS.count;
        for i in 0..4 {
            let ty = if i < 2 { cty_int(32, false) } else { cty_ptr(CTY_VOID) };
            CINTS.push(cfield_new(intern_c(names[i]), ty, -1, 0));
        }
        CRECS[r].fields = start;
        CRECS[r].field_count = 4;
        CRECS[r].complete = 1;
        C_VA_LIST = cty_new(Array, CRECS[r].ty, 1, 0, 0);
        C_VA_LIST
    }
}

fn cfield_new(name: i64, ty: i64, bits: i64, align: i64) -> i64 {
    unsafe {
        CFIELDS = grow(CFIELDS, CFIELD_COUNT, &CFIELD_CAP);
        CFIELDS[CFIELD_COUNT] = CField { name: name, ty: ty, bits: bits, align_attr: align, offset: 0, bit_offset: 0 };
    }
    CFIELD_COUNT += 1;
    CFIELD_COUNT - 1
}

// `struct` or `union` (already read) [attributes] [tag] [{ fields }].
fn d_record(is_union: bool) -> i64 {
    unsafe {
        let saved = (A_PACKED, A_ALIGN);
        A_PACKED = false;
        A_ALIGN = 0;
        d_attributes();
        let mut tag = -1;
        if dcur() != C_EOF && CTOKS[dcur()].kind == CK::Ident && !d_is(c"__attribute__") {
            tag = CTOKS[dcur()].text;
            D_POS += 1;
        }
        d_attributes();
        let kind = if is_union { 1 } else { 0 };
        let mut r = -1;
        if tag >= 0 {
            let found = TAG_OF.get(tag + 1) - 1;
            if found >= 0 && found % 4 == kind {
                r = found / 4;
            }
        }
        if !d_is(c"{") {
            if r < 0 {
                r = crec_new(tag, is_union);
                if tag >= 0 {
                    TAG_OF.put(tag + 1, r * 4 + kind + 1);
                }
            }
            let (p, a) = saved;
            A_PACKED = p;
            A_ALIGN = a;
            return CRECS[r].ty;
        }
        if r < 0 || CRECS[r].complete != 0 {
            r = crec_new(tag, is_union);
            if tag >= 0 {
                TAG_OF.put(tag + 1, r * 4 + kind + 1);
            }
        }
        let packed_before = A_PACKED;
        let align_before = A_ALIGN;
        D_POS += 1;
        CRECS[r].pack = D_PACK;
        let fields = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        while !d_is(c"}") && D_POS < D_N {
            d_pack_markers();
            if d_is(c"}") {
                break;
            }
            if d_eat(c";") {
                continue;
            }
            if d_is(c"_Static_assert") || d_is(c"static_assert") {
                while !d_is(c";") && D_POS < D_N {
                    D_POS += 1;
                }
                continue;
            }
            let outer = (A_PACKED, A_ALIGN, A_MODE, A_VECTOR);
            A_ALIGN = 0;
            A_MODE = 0;
            A_VECTOR = false;
            let (base, _) = d_specifiers();
            if d_is(c";") {
                // An anonymous struct or union member (C11).
                let rb = CTYPES[base].kind == Record && CRECS[CTYPES[base].a].tag < 0;
                if rb {
                    CRECS[CTYPES[base].a].parent = r;
                    fields.push(cfield_new(-1, base, -1, A_ALIGN));
                }
                D_POS += 1;
                let (p, a, m, v) = outer;
                A_PACKED = p;
                A_MODE = m;
                A_VECTOR = v;
                A_ALIGN = a;
                continue;
            }
            loop {
                let field_align_before = A_ALIGN;
                let mut name = -1;
                let mut ty = base;
                if !d_is(c":") {
                    let (n, t) = d_declarator(base);
                    name = n;
                    ty = t;
                }
                let mut bits = -1;
                if d_eat(c":") {
                    let at = dcur();
                    let list = d_collect_until(c",", c";");
                    let (v, _) = eval_tokens(&list, at, true);
                    if EV_FAIL {
                        d_fail(c"a bit-field width");
                    }
                    bits = v as i64;
                }
                d_attributes();
                ty = apply_mode(ty);
                let fa = if A_ALIGN > field_align_before { A_ALIGN } else { field_align_before };
                fields.push(cfield_new(name, ty, bits, fa));
                A_ALIGN = 0;
                if !d_eat(c",") {
                    break;
                }
            }
            d_expect(c";");
            let (p, a, m, v) = outer;
            A_PACKED = p;
            A_MODE = m;
            A_VECTOR = v;
            A_ALIGN = a;
        }
        d_expect(c"}");
        A_PACKED = packed_before;
        A_ALIGN = align_before;
        d_attributes();
        CRECS[r].packed = A_PACKED as i64;
        CRECS[r].align_attr = A_ALIGN;
        CRECS[r].fields = CINTS.count;
        for i in 0..fields.count {
            CINTS.push(fields.data[i]);
        }
        CRECS[r].field_count = fields.count;
        CRECS[r].complete = 1;
        let (p, a) = saved;
        A_PACKED = p;
        A_ALIGN = a;
        CRECS[r].ty
    }
}

// `mode(...)` on an integer type: the integer of that width.
fn apply_mode(t: i64) -> i64 {
    unsafe {
        if A_VECTOR {
            return cty_bad(c"a vector type");
        }
        if A_MODE == 0 {
            return t;
        }
        if A_MODE < 0 {
            return cty_bad(c"an integer of that mode");
        }
        let r = cty_integer(t);
        if r == 0 {
            return t;
        }
        cty_int(A_MODE, CTYPES[r].b != 0)
    }
}

// `enum` (already read) [attributes] [tag] [: type] [{ enumerators }].
fn d_enum() -> i64 {
    unsafe {
        let packed_before = A_PACKED;
        A_PACKED = false;
        d_attributes();
        let leading_packed = A_PACKED;
        A_PACKED = packed_before;
        let mut tag = -1;
        if dcur() != C_EOF && CTOKS[dcur()].kind == CK::Ident {
            tag = CTOKS[dcur()].text;
            D_POS += 1;
        }
        d_attributes();
        let mut fixed = 0;
        if d_eat(c":") {
            let (t, _) = d_specifiers();
            fixed = t;
        }
        let mut e = -1;
        if tag >= 0 {
            let found = TAG_OF.get(tag + 1) - 1;
            if found >= 0 && found % 4 == 2 {
                e = found / 4;
            }
        }
        if e < 0 {
            CENUMS = grow(CENUMS, CENUM_COUNT, &CENUM_CAP);
            e = CENUM_COUNT;
            CENUM_COUNT += 1;
            CENUMS[e] = CEnum { tag: tag, underlying: cty_int(32, false), name: -1, ty: 0, has_values: 0 };
            CENUMS[e].ty = cty_new(Enum, e, 0, 0, 0);
            if tag >= 0 {
                TAG_OF.put(tag + 1, e * 4 + 2 + 1);
            }
        }
        if fixed != 0 {
            CENUMS[e].underlying = fixed;
        }
        if !d_eat(c"{") {
            return CENUMS[e].ty;
        }
        CENUMS[e].has_values = 1;
        let first = CENUMERATOR_COUNT;
        let mut next: i64 = 0;
        let mut min: i64 = 0;
        let mut max: u64 = 0;
        while !d_is(c"}") && D_POS < D_N {
            let t = dcur();
            if CTOKS[t].kind != CK::Ident {
                d_fail(c"an enumerator");
                break;
            }
            D_POS += 1;
            d_attributes();
            let mut value = next;
            if d_eat(c"=") {
                let list = d_collect_until(c",", c"}");
                let (v, vt) = eval_tokens(&list, t, true);
                if EV_FAIL {
                    d_fail(c"an enumerator's value");
                    break;
                }
                value = if cty_signed(vt) { v as i64 } else { v as i64 };
            }
            CENUMERATORS = grow(CENUMERATORS, CENUMERATOR_COUNT, &CENUMERATOR_CAP);
            CENUMERATORS[CENUMERATOR_COUNT] = CEnumerator { name: CTOKS[t].text, value: value, ty: e };
            ENUMERATOR_OF.put(CTOKS[t].text + 1, CENUMERATOR_COUNT + 1);
            CENUMERATOR_COUNT += 1;
            if value < min {
                min = value;
            }
            if value >= 0 && value as u64 > max {
                max = value as u64;
            }
            next = value + 1;
            if !d_eat(c",") {
                break;
            }
        }
        d_expect(c"}");
        let saved_packed = A_PACKED;
        A_PACKED = leading_packed;
        d_attributes();
        if fixed == 0 {
            // GCC and Clang: unsigned int when no value is negative, int
            // otherwise; wider when the values need it; the smallest with
            // `packed`.
            let neg = min < 0;
            let mut bits = 32;
            if A_PACKED {
                bits = 8;
                while bits < 64 && !(if neg { min >= -(1 << (bits - 1) as u64) && max <= ((1 << (bits - 1) as u64) - 1) as u64 } else { max <= ((1 << bits as u64) - 1) as u64 }) {
                    bits *= 2;
                }
            } else if neg && (min < -2147483648 || max > 2147483647) {
                bits = 64;
            } else if !neg && max > 4294967295 {
                bits = 64;
            }
            CENUMS[e].underlying = cty_int(bits, neg);
        }
        A_PACKED = saved_packed;
        let _ = first;
        CENUMS[e].ty
    }
}

// ---- Declarators ----

fn skip_pointer_qualifiers() {
    unsafe {
        loop {
            let t = dcur();
            if t == C_EOF || CTOKS[t].kind != CK::Ident {
                return;
            }
            let s = ctok_text(t);
            if is_qualifier(s) || streq(s, c"_Atomic") {
                D_POS += 1;
            } else if streq(s, c"__attribute__") || streq(s, c"__attribute") {
                d_attributes();
            } else {
                return;
            }
        }
    }
}

// Whether `(` at the cursor opens a nested declarator (not parameters).
fn d_nested_declarator() -> bool {
    unsafe {
        let t = dpeek(1);
        if t == C_EOF {
            return false;
        }
        if d_is_at(1, c"*") || d_is_at(1, c"(") || d_is_at(1, c"^") || d_is_at(1, c"[") {
            return true;
        }
        if CTOKS[t].kind != CK::Ident {
            return false;
        }
        let s = ctok_text(t);
        if streq(s, c"__attribute__") || streq(s, c"__attribute") {
            return true;
        }
        !(is_type_keyword(s) || is_qualifier(s) || is_storage_word(s) || typedef_of(CTOKS[t].text) >= 0)
    }
}

// A declarator (abstract or not): the name (-1: none) and the type.
fn d_declarator(base: i64) -> (i64, i64) {
    unsafe {
        let mut ty = base;
        d_attributes();
        while d_eat(c"*") || d_eat(c"^") {
            ty = cty_ptr(ty);
            skip_pointer_qualifiers();
        }
        d_attributes();
        if d_is(c"(") && d_nested_declarator() {
            D_POS += 1;
            let inner = D_POS;
            let mut depth = 1;
            while depth > 0 && D_POS < D_N {
                if d_is(c"(") {
                    depth += 1;
                } else if d_is(c")") {
                    depth -= 1;
                }
                D_POS += 1;
            }
            let outer_ty = d_suffixes(ty);
            let end = D_POS;
            D_POS = inner;
            let (name, t) = d_declarator(outer_ty);
            d_expect(c")");
            D_POS = end;
            return (name, t);
        }
        let mut name = -1;
        let t = dcur();
        if t != C_EOF && CTOKS[t].kind == CK::Ident && !is_qualifier(ctok_text(t))
            && !d_is(c"__attribute__") && !d_is(c"__asm__") && !d_is(c"__asm") && !d_is(c"asm") {
            name = CTOKS[t].text;
            D_POS += 1;
        }
        (name, d_suffixes(ty))
    }
}

// Array and function suffixes.
fn d_suffixes(base: i64) -> i64 {
    unsafe {
        if d_eat(c"[") {
            skip_pointer_qualifiers();
            d_eat(c"static");
            skip_pointer_qualifiers();
            let mut len = -1;
            if !d_is(c"]") {
                let at = dcur();
                let list = d_collect_until(c"]", c"]");
                let (v, _) = eval_tokens(&list, at, true);
                if EV_FAIL {
                    d_expect(c"]");
                    let elem = d_suffixes(base);
                    let _ = elem;
                    return cty_bad(c"an array whose length is not a constant tachyon can compute");
                }
                len = v as i64;
            }
            d_expect(c"]");
            let elem = d_suffixes(base);
            return cty_new(Array, elem, len, 0, 0);
        }
        if d_is(c"(") {
            D_POS += 1;
            let saved = (A_PACKED, A_ALIGN, A_MODE, A_LINK, A_NORETURN, A_UNAVAILABLE, A_VECTOR);
            let params = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            let mut variadic = 0;
            if d_is(c"void") && d_is_at(1, c")") {
                D_POS += 1;
            }
            while !d_is(c")") && D_POS < D_N {
                if d_eat(c"...") {
                    variadic = 1;
                    break;
                }
                attrs_reset();
                let (pbase, _) = d_specifiers();
                let (_, pt) = d_declarator(pbase);
                d_attributes();
                params.push(param_adjust(apply_mode(pt)));
                if !d_eat(c",") {
                    break;
                }
            }
            d_expect(c")");
            let (p, a, m, l, nr, u, v) = saved;
            A_PACKED = p;
            A_ALIGN = a;
            A_MODE = m;
            A_LINK = l;
            A_NORETURN = nr;
            A_UNAVAILABLE = u;
            A_VECTOR = v;
            let start = CINTS.count;
            for i in 0..params.count {
                CINTS.push(params.data[i]);
            }
            return cty_new(Func, base, start, params.count, variadic);
        }
        base
    }
}

// Parameters of array and function type are pointers.
fn param_adjust(t: i64) -> i64 {
    unsafe {
        let r = cty_resolve(t);
        if CTYPES[r].kind == Array {
            return cty_ptr(CTYPES[r].a);
        }
        if CTYPES[r].kind == Func {
            return cty_ptr(t);
        }
        t
    }
}

// A type name (in casts and sizeof): specifiers and an abstract declarator.
fn d_type_name() -> i64 {
    let saved = (A_PACKED, A_ALIGN, A_MODE, A_LINK, A_NORETURN, A_UNAVAILABLE, A_VECTOR);
    let (base, _) = d_specifiers();
    let (_, t) = d_declarator(base);
    let (p, a, m, l, nr, u, v) = saved;
    A_PACKED = p;
    A_ALIGN = a;
    A_MODE = m;
    A_LINK = l;
    A_NORETURN = nr;
    A_UNAVAILABLE = u;
    A_VECTOR = v;
    t
}

// ---- Constant expressions in declarations ----

// Casts, sizeof and _Alignof, for cpp.tach's evaluator: whether one
// was read, and its value and type.
pub fn cdecl_eval_special() -> (bool, u64, i64) {
    unsafe {
        let t = ev_peek();
        if t == C_EOF {
            return (false, 0, 0);
        }
        let s = ctok_text(t);
        let is_sizeof = streq(s, c"sizeof");
        let is_alignof = streq(s, c"_Alignof") || streq(s, c"__alignof__") || streq(s, c"__alignof") || streq(s, c"alignof");
        let is_cast = CTOKS[t].kind == CK::Punct && streq(s, c"(");
        if !is_sizeof && !is_alignof && !is_cast {
            return (false, 0, 0);
        }
        // The type name is read by the declaration parser, at the
        // evaluator's position.
        let saved = (D_TOKS, D_N, D_POS, D_BAD);
        D_TOKS = EV_TOKS;
        D_N = EV_N;
        D_POS = EV_POS;
        D_BAD = -1;
        let mut ty = -1;
        if is_cast {
            if d_starts_type(1) {
                D_POS += 1;
                ty = d_type_name();
                d_expect(c")");
            }
        } else if d_is_at(1, c"(") && d_starts_type(2) {
            D_POS += 2;
            ty = d_type_name();
            d_expect(c")");
        }
        let after = D_POS;
        let bad = D_BAD >= 0;
        let (d_toks, d_n, d_pos, d_bad) = saved;
        D_TOKS = d_toks;
        D_N = d_n;
        D_POS = d_pos;
        D_BAD = d_bad;
        if ty < 0 {
            // A parenthesized expression, or sizeof of one.
            return (false, 0, 0);
        }
        EV_POS = after;
        if bad {
            EV_FAIL = true;
            return (true, 0, cty_int(32, true));
        }
        if is_cast {
            let (v, _) = ev_unary();
            if cty_integer(ty) == 0 {
                EV_FAIL = true;
                return (true, 0, cty_int(32, true));
            }
            return (true, ev_convert(v, ty), ty);
        }
        let v = if is_sizeof { c_size(ty) } else { c_align(ty) };
        if v < 0 {
            EV_FAIL = true;
        }
        (true, v as u64, cty_int(64, false))
    }
}

// An identifier's value in a constant expression: an enumerator.
pub fn cdecl_ident_value(sym: i64) -> (bool, u64, i64) {
    let e = ENUMERATOR_OF.get(sym + 1) - 1;
    if e < 0 {
        return (false, 0, 0);
    }
    unsafe { (true, CENUMERATORS[e].value as u64, enumerator_type(e)) }
}

// C's type of an enumerator: int when its value fits, else the enum's.
fn enumerator_type(e: i64) -> i64 {
    unsafe {
        let v = CENUMERATORS[e].value;
        if v >= -2147483648 && v <= 2147483647 {
            return cty_int(32, true);
        }
        CENUMS[CENUMERATORS[e].ty].underlying
    }
}

// ---- Layout ----

fn c_size(t: i64) -> i64 {
    unsafe {
        let r = cty_resolve(t);
        match CTYPES[r].kind {
            Int | Float => CTYPES[r].a / 8,
            Bool | Void => 1,
            Ptr => 8,
            Array => {
                let e = c_size(CTYPES[r].a);
                if e < 0 { -1 } else if CTYPES[r].b < 0 { 0 } else { e * CTYPES[r].b }
            }
            Record => {
                let rec = CTYPES[r].a;
                crec_layout(rec);
                if CRECS[rec].opaque >= 0 { -1 } else { CRECS[rec].size }
            }
            Enum => c_size(CENUMS[CTYPES[r].a].underlying),
            _ => -1,
        }
    }
}

fn c_align(t: i64) -> i64 {
    unsafe {
        if CTYPES[t].kind == Named {
            let td = CTYPES[t].a;
            let inner = c_align(CTYPEDEFS[td].ty);
            return if CTYPEDEFS[td].align_attr > inner { CTYPEDEFS[td].align_attr } else { inner };
        }
        match CTYPES[t].kind {
            Int | Float => CTYPES[t].a / 8,
            Bool | Void => 1,
            Ptr => 8,
            Array => c_align(CTYPES[t].a),
            Record => {
                let rec = CTYPES[t].a;
                crec_layout(rec);
                if CRECS[rec].opaque >= 0 { -1 } else { CRECS[rec].align }
            }
            Enum => c_align(CENUMS[CTYPES[t].a].underlying),
            _ => -1,
        }
    }
}

// Why a type cannot be a value in tachyon (-1: it can): Bad types, opaque
// records, functions.
fn c_value_problem(t: i64) -> i64 {
    unsafe {
        let r = cty_resolve(t);
        match CTYPES[r].kind {
            Bad => CTYPES[r].a,
            Func => intern_c(c"a function type"),
            Array => c_value_problem(CTYPES[r].a),
            Record => {
                let rec = CTYPES[r].a;
                crec_layout(rec);
                CRECS[rec].opaque
            }
            _ => -1,
        }
    }
}

const C_MAX_ALIGN: i64 = 4096;

// C's layout of record r (GCC's and Clang's for these targets: fields in
// order, bit-fields in storage units of their type, `packed` and
// `aligned`), then whether tachyon can express it: as a #[repr(C)] type
// (with explicit padding), packed when a field is unaligned.
fn crec_layout(r: i64) {
    unsafe {
        if CRECS[r].state != 0 {
            return;
        }
        CRECS[r].state = 1;
        if CRECS[r].complete == 0 {
            CRECS[r].opaque = intern_c(c"its definition is not in the headers");
            CRECS[r].state = 2;
            return;
        }
        let packed = CRECS[r].packed != 0;
        let is_union = CRECS[r].is_union != 0;
        let mut bit = 0;
        let mut size = 0;
        let mut align = 1;
        let mut widest = 1;
        for i in 0..CRECS[r].field_count {
            let f = cfield(r, i);
            let problem = c_value_problem((*f).ty);
            if problem >= 0 {
                CRECS[r].opaque = problem;
                CRECS[r].state = 2;
                return;
            }
            let fs = c_size((*f).ty);
            let mut fa = c_align((*f).ty);
            widest = if fa > widest { fa } else { widest };
            if (*f).align_attr > fa {
                fa = (*f).align_attr;
            }
            let mut eff = if packed && (*f).align_attr == 0 { 1 } else { fa };
            if CRECS[r].pack > 0 && eff > CRECS[r].pack {
                eff = CRECS[r].pack;
            }
            if (*f).bits >= 0 {
                let w = (*f).bits;
                if is_union {
                    (*f).bit_offset = 0;
                    size = if (w + 7) / 8 > size { (w + 7) / 8 } else { size };
                } else if w == 0 {
                    if !packed {
                        bit = align_to(bit, fa * 8);
                    }
                    (*f).bit_offset = bit;
                } else {
                    if !packed && (bit % (fs * 8)) + w > fs * 8 {
                        bit = align_to(bit, fa * 8);
                    }
                    (*f).bit_offset = bit;
                    bit += w;
                }
                if (*f).name >= 0 && w > 0 {
                    align = if eff > align { eff } else { align };
                }
                continue;
            }
            align = if eff > align { eff } else { align };
            if is_union {
                (*f).offset = 0;
                size = if fs > size { fs } else { size };
            } else {
                bit = align_to(bit, eff * 8);
                (*f).offset = bit / 8;
                bit += fs * 8;
            }
        }
        if CRECS[r].align_attr > align {
            align = CRECS[r].align_attr;
        }
        if !is_union {
            size = (bit + 7) / 8;
        }
        CRECS[r].size = align_to(size, align);
        CRECS[r].align = align;
        // In tachyon: unpacked when every member is at a multiple of its
        // alignment and the record is at least as aligned as its widest
        // member; packed when its alignment is 1; otherwise not expressible.
        let mut aligned_members = true;
        for i in 0..CRECS[r].field_count {
            let f = cfield(r, i);
            if (*f).bits < 0 && (*f).offset % c_align((*f).ty) != 0 {
                aligned_members = false;
            }
        }
        let mut natural = 1;
        for i in 0..CRECS[r].field_count {
            let f = cfield(r, i);
            if (*f).bits < 0 {
                let a = c_align((*f).ty);
                natural = if a > natural { a } else { natural };
            }
        }
        let _ = widest;
        if aligned_members && align >= natural {
            CRECS[r].emit_packed = 0;
            CRECS[r].emit_align = if align > natural { align } else { 0 };
        } else if packs_as(r, align) {
            // #[repr(C, packed(N))]: fields aligned to at most N.
            CRECS[r].emit_packed = align;
        } else {
            CRECS[r].opaque = intern_c(c"its layout (packed and aligned) cannot be expressed");
        }
        if CRECS[r].emit_align > C_MAX_ALIGN {
            CRECS[r].opaque = intern_c(c"its alignment is too large");
        }
        CRECS[r].state = 2;
    }
}

// Whether tachyon's packed(p) gives C's layout of r (with explicit
// padding): every field at a multiple of min(its alignment, p), and the
// record aligned to p.
fn packs_as(r: i64, p: i64) -> bool {
    let mut widest = 1;
    unsafe {
        for i in 0..CRECS[r].field_count {
            let f = cfield(r, i);
            if (*f).bits >= 0 {
                continue;
            }
            let a = c_align((*f).ty);
            let eff = if a > p { p } else { a };
            if (*f).offset % eff != 0 {
                return false;
            }
            widest = if eff > widest { eff } else { widest };
        }
    }
    widest == p
}

// The packing in force (#pragma pack), from the `__tachyon_pack <n>`
// tokens of the preprocessor.
static mut D_PACK: i64 = 0;

fn d_pack_markers() {
    unsafe {
        while d_is(c"__tachyon_pack") {
            D_POS += 1;
            let mut end = 0 as *u8;
            D_PACK = strtoull(ctok_text(dcur()), &end, 10) as i64;
            D_POS += 1;
        }
    }
}

// ---- Reading the declarations ----

// Reads every external declaration of the token list.
fn cdecl_parse(toks: *IntVec) {
    unsafe {
        D_TOKS = (*toks).data;
        D_N = (*toks).count;
        D_POS = 0;
        while D_POS < D_N {
            d_pack_markers();
            if D_POS >= D_N {
                break;
            }
            if d_eat(c";") {
                continue;
            }
            if d_is(c"_Static_assert") || d_is(c"static_assert") || d_is(c"__asm__") || d_is(c"__asm") || d_is(c"asm") {
                D_POS += 1;
                d_skip_parens();
                d_eat(c";");
                continue;
            }
            let start = D_POS;
            let saved_n = D_N;
            D_BAD = -1;
            attrs_reset();
            let first_name = d_declaration();
            if D_BAD >= 0 {
                // Skip what remains of it: to `;` at depth 0, or past a body.
                D_N = saved_n;
                D_POS = start;
                skip_reason(first_name, D_BAD);
                skip_declaration();
            }
        }
    }
}

fn skip_declaration() {
    unsafe {
        let mut depth = 0;
        while D_POS < D_N {
            if d_is(c"(") || d_is(c"[") {
                depth += 1;
            } else if d_is(c")") || d_is(c"]") {
                depth -= 1;
            } else if d_is(c"{") {
                // A record's body, or a function's.
                let mut braces = 0;
                loop {
                    if d_is(c"{") {
                        braces += 1;
                    } else if d_is(c"}") {
                        braces -= 1;
                        if braces == 0 {
                            break;
                        }
                    }
                    D_POS += 1;
                    if D_POS >= D_N {
                        return;
                    }
                }
                D_POS += 1;
                if depth == 0 && D_POS < D_N && !d_is(c";") && !d_is(c",") && !d_is(c"__attribute__")
                    && CTOKS[dcur()].kind != CK::Ident && !d_is(c"*") && !d_is(c"[") {
                    return;
                }
                continue;
            } else if d_is(c";") && depth == 0 {
                D_POS += 1;
                return;
            }
            D_POS += 1;
        }
    }
}

// One declaration; returns its first declared name (-1: none).
fn d_declaration() -> i64 {
    unsafe {
        let (base, flags) = d_specifiers();
        if D_BAD >= 0 {
            return -1;
        }
        if d_eat(c";") {
            return -1;
        }
        let mut first = -1;
        loop {
            let decl_attrs = (A_ALIGN, A_MODE, A_LINK, A_NORETURN, A_UNAVAILABLE, A_VECTOR);
            let (name, raw_ty) = d_declarator(base);
            d_attributes();
            if D_BAD >= 0 {
                return if first >= 0 { first } else { name };
            }
            if first < 0 {
                first = name;
            }
            let ty = apply_mode(raw_ty);
            let r = cty_resolve(ty);
            let is_func = CTYPES[r].kind == Func && CTYPES[ty].kind != Named;
            if name >= 0 {
                if (flags & SP_TYPEDEF) != 0 {
                    add_typedef(name, ty, A_ALIGN);
                } else if CTYPES[r].kind == Func {
                    if d_is(c"{") {
                        // A definition: imported when it has an external one.
                        skip_body();
                        if (flags & SP_STATIC) != 0 || ((flags & SP_INLINE) != 0 && (flags & SP_EXTERN) == 0) {
                            skip_reason(name, intern_c(c"it is defined in the header (static or inline)"));
                        } else {
                            add_function(name, ty, flags);
                        }
                        return first;
                    }
                    if (flags & SP_STATIC) != 0 {
                        skip_reason(name, intern_c(c"it is static"));
                    } else {
                        add_function(name, ty, flags);
                    }
                } else if (flags & SP_THREAD) != 0 {
                    skip_reason(name, intern_c(c"it is thread-local"));
                } else if (flags & SP_EXTERN) != 0 {
                    add_variable(name, ty, flags);
                } else {
                    skip_reason(name, intern_c(c"it is defined in the header"));
                }
            }
            let _ = is_func;
            let (a, m, l, nr, u, v) = decl_attrs;
            A_ALIGN = a;
            A_MODE = m;
            A_LINK = l;
            A_NORETURN = nr;
            A_UNAVAILABLE = u;
            A_VECTOR = v;
            if d_eat(c"=") {
                d_collect_until(c",", c";");
            }
            if !d_eat(c",") {
                break;
            }
        }
        d_expect(c";");
        first
    }
}

fn skip_body() {
    unsafe {
        let mut depth = 0;
        while D_POS < D_N {
            if d_is(c"{") {
                depth += 1;
            } else if d_is(c"}") {
                depth -= 1;
                if depth == 0 {
                    D_POS += 1;
                    return;
                }
            }
            D_POS += 1;
        }
    }
}

fn add_typedef(name: i64, ty: i64, align: i64) {
    if typedef_of(name) >= 0 {
        return;
    }
    unsafe {
        CTYPEDEFS = grow(CTYPEDEFS, CTYPEDEF_COUNT, &CTYPEDEF_CAP);
        CTYPEDEFS[CTYPEDEF_COUNT] = CTypedef { name: name, ty: ty, tname: -1, align_attr: align };
    }
    TYPEDEF_OF.put(name + 1, CTYPEDEF_COUNT + 1);
    CTYPEDEF_COUNT += 1;
}

fn add_function(name: i64, ty: i64, flags: i64) {
    unsafe {
        if FUNC_OF.get(name + 1) != 0 || VAR_OF.get(name + 1) != 0 {
            return;
        }
        if A_UNAVAILABLE {
            skip_reason(name, intern_c(c"it is marked unavailable"));
            return;
        }
        CFUNCS = grow(CFUNCS, CFUNC_COUNT, &CFUNC_CAP);
        let noreturn = (flags & SP_NORETURN) != 0 || A_NORETURN;
        CFUNCS[CFUNC_COUNT] = CFunc { name: name, ty: ty, link: A_LINK, noreturn: noreturn as i64 };
        FUNC_OF.put(name + 1, CFUNC_COUNT + 1);
        CFUNC_COUNT += 1;
    }
}

fn add_variable(name: i64, ty: i64, flags: i64) {
    if FUNC_OF.get(name + 1) != 0 || VAR_OF.get(name + 1) != 0 {
        return;
    }
    unsafe {
        CVARS = grow(CVARS, CVAR_COUNT, &CVAR_CAP);
        CVARS[CVAR_COUNT] = CVar { name: name, ty: ty, link: A_LINK, is_const: ((flags & SP_CONST) != 0) as i64 };
    }
    VAR_OF.put(name + 1, CVAR_COUNT + 1);
    CVAR_COUNT += 1;
}

// ---- Writing tachyon ----

static mut OUTB: i64 = 0;
// Tachyon names taken: types, values (symbol + 1 -> 1).
static mut USED_TYPE: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static mut USED_VALUE: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

fn out(s: *u8) {
    buf_str(OUTB, s);
}

fn out_int(v: i64) {
    buf_int(OUTB, v);
}

// A C identifier as a tachyon name: keywords as raw identifiers.
fn out_name(sym: i64) {
    unsafe {
        let k = keyword_of_sym(sym);
        if k != Tok::Eof || sym == intern_c(c"self") || sym == intern_c(c"Self") || sym == intern_c(c"_") {
            out(c"r#");
        }
        buf_bytes(OUTB, SYMS[sym].text);
    }
}

fn is_primitive_name(sym: i64) -> bool {
    let names: [*u8; 14] = [c"i8", c"i16", c"i32", c"i64", c"u8", c"u16", c"u32", c"u64",
        c"f32", c"f64", c"bool", c"isize", c"usize", c"Self"];
    for i in 0..14 {
        if unsafe { sym == intern_c(names[i]) } {
            return true;
        }
    }
    false
}

// Claims a type name; false when taken.
fn claim_type(sym: i64) -> bool {
    if USED_TYPE.get(sym + 1) != 0 || is_primitive_name(sym) {
        return false;
    }
    USED_TYPE.put(sym + 1, 1);
    true
}

fn prefixed(prefix: *u8, sym: i64) -> i64 {
    let b = buf_new();
    buf_str(b, prefix);
    unsafe { buf_bytes(b, SYMS[sym].text); }
    intern(buf_slice(b))
}

// The tachyon spelling of C type t (a value's type; void is not one).
fn out_type(t: i64) {
    unsafe {
        let k = CTYPES[t].kind;
        match k {
            Int => {
                out(if CTYPES[t].b != 0 { c"i" } else { c"u" });
                out_int(CTYPES[t].a);
            }
            Bool => out(c"bool"),
            Float => out(if CTYPES[t].a == 32 { c"f32" } else { c"f64" }),
            Void => out(c"u8"),
            Ptr => {
                let p = cty_resolve(CTYPES[t].a);
                let pk = CTYPES[p].kind;
                if pk == Func {
                    if CTYPES[p].d != 0 || c_fn_problem(p) >= 0 {
                        out(c"*u8");
                    } else {
                        out_fn_type(p);
                    }
                } else if pk == Void || pk == Bad {
                    out(c"*u8");
                } else {
                    out(c"*");
                    out_type(CTYPES[t].a);
                }
            }
            Array => {
                out(c"[");
                out_type(CTYPES[t].a);
                out(c"; ");
                out_int(if CTYPES[t].b < 0 { 0 } else { CTYPES[t].b });
                out(c"]");
            }
            Record => out_name(CRECS[CTYPES[t].a].name),
            Enum => {
                let e = CTYPES[t].a;
                if CENUMS[e].name >= 0 {
                    out_name(CENUMS[e].name);
                } else {
                    out_type(CENUMS[e].underlying);
                }
            }
            Named => {
                let td = CTYPES[t].a;
                if CTYPEDEFS[td].tname >= 0 {
                    out_name(CTYPEDEFS[td].tname);
                } else {
                    out_type(CTYPEDEFS[td].ty);
                }
            }
            Func => out_fn_type(t),
            Bad => out(c"u8"),
        }
    }
}

fn out_fn_type(f: i64) {
    unsafe {
        out(c"extern \"C\" fn(");
        for i in 0..CTYPES[f].c {
            if i > 0 {
                out(c", ");
            }
            out_type(CINTS.data[CTYPES[f].b + i]);
        }
        out(c")");
        let ret = cty_resolve(CTYPES[f].a);
        if CTYPES[ret].kind != Void {
            out(c" -> ");
            out_type(CTYPES[f].a);
        }
    }
}

// Why function type f cannot be imported, or -1.
fn c_fn_problem(f: i64) -> i64 {
    unsafe {
        for i in 0..CTYPES[f].c {
            let p = c_value_problem(CINTS.data[CTYPES[f].b + i]);
            if p >= 0 {
                return p;
            }
        }
        let ret = cty_resolve(CTYPES[f].a);
        if CTYPES[ret].kind == Void {
            return -1;
        }
        if CTYPES[ret].kind == Array {
            return intern_c(c"it returns an array");
        }
        c_value_problem(CTYPES[f].a)
    }
}

// Names for the records, enums and typedefs (C's tag and ordinary
// namespaces share tachyon's type namespace).
fn assign_type_names() {
    unsafe {
        // Anonymous records and enums take the name of their first typedef.
        for i in 0..CTYPEDEF_COUNT {
            let t = CTYPEDEFS[i].ty;
            if CTYPES[t].kind == Record {
                let r = CTYPES[t].a;
                // (Not a typedef that raises the alignment: GCC keeps the
                // size, which no tachyon type can do.)
                let raises = CTYPEDEFS[i].align_attr > 0 && CTYPEDEFS[i].align_attr > c_align(t);
                if CRECS[r].tag < 0 && CRECS[r].name < 0 && CRECS[r].parent < 0 && !raises && claim_type(CTYPEDEFS[i].name) {
                    CRECS[r].name = CTYPEDEFS[i].name;
                    CTYPEDEFS[i].tname = -2;
                }
            } else if CTYPES[t].kind == Enum {
                let e = CTYPES[t].a;
                if CENUMS[e].tag < 0 && CENUMS[e].name < 0 && claim_type(CTYPEDEFS[i].name) {
                    CENUMS[e].name = CTYPEDEFS[i].name;
                    CTYPEDEFS[i].tname = -2;
                }
            }
        }
        // Typedefs other than `typedef struct x x;`.
        for i in 0..CTYPEDEF_COUNT {
            if CTYPEDEFS[i].tname == -2 {
                continue;
            }
            let t = CTYPEDEFS[i].ty;
            let name = CTYPEDEFS[i].name;
            let r = cty_resolve(t);
            if CTYPES[r].kind == Func || CTYPES[r].kind == Bad || CTYPES[r].kind == Void {
                continue;
            }
            if CTYPES[t].kind == Record && CRECS[CTYPES[t].a].tag == name {
                continue;
            }
            if CTYPES[t].kind == Enum && CENUMS[CTYPES[t].a].tag == name {
                continue;
            }
            // A typedef that raises its type's alignment is another type,
            // which a tachyon alias is not.
            if CTYPEDEFS[i].align_attr > 0 && CTYPEDEFS[i].align_attr > c_align(t) {
                skip_reason(name, intern_c(c"its typedef raises the alignment"));
                continue;
            }
            if claim_type(name) {
                CTYPEDEFS[i].tname = name;
            }
        }
        for r in 0..CREC_COUNT {
            if CRECS[r].name >= 0 {
                continue;
            }
            if CRECS[r].tag >= 0 {
                if claim_type(CRECS[r].tag) {
                    CRECS[r].name = CRECS[r].tag;
                } else {
                    CRECS[r].name = prefixed(if CRECS[r].is_union != 0 { c"union_" } else { c"struct_" }, CRECS[r].tag);
                    claim_type(CRECS[r].name);
                }
            }
        }
        // Anonymous records: after their parent, `<parent>_anon<k>`; others
        // `anon_<k>`.
        let mut k = 0;
        for r in 0..CREC_COUNT {
            if CRECS[r].name < 0 {
                let b = buf_new();
                if CRECS[r].parent >= 0 && CRECS[CRECS[r].parent].name >= 0 {
                    buf_bytes(b, SYMS[CRECS[CRECS[r].parent].name].text);
                    buf_str(b, c"_anon");
                } else {
                    buf_str(b, c"anon_");
                }
                buf_int(b, k);
                k += 1;
                CRECS[r].name = intern(buf_slice(b));
                claim_type(CRECS[r].name);
            }
        }
        for e in 0..CENUM_COUNT {
            if CENUMS[e].name < 0 && CENUMS[e].tag >= 0 {
                if claim_type(CENUMS[e].tag) {
                    CENUMS[e].name = CENUMS[e].tag;
                } else {
                    CENUMS[e].name = prefixed(c"enum_", CENUMS[e].tag);
                    claim_type(CENUMS[e].name);
                }
            }
        }
    }
}

// A member name not used by a field of r: `base<k>`.
fn member_name(r: i64, base: *u8, k: i64) -> i64 {
    let b = buf_new();
    buf_str(b, base);
    buf_int(b, k);
    let mut sym = intern(buf_slice(b));
    loop {
        let mut clash = false;
        unsafe {
            for i in 0..CRECS[r].field_count {
                if (*cfield(r, i)).name == sym {
                    clash = true;
                }
            }
        }
        if !clash {
            return sym;
        }
        buf_byte(b, '_');
        sym = intern(buf_slice(b));
    }
}

fn out_member(name: i64, size: i64) {
    unsafe {
        out(c"    ");
        out_name(name);
        out(c": [u8; ");
        out_int(size);
        out(c"],\n");
    }
}

fn emit_record(r: i64) {
    unsafe {
        crec_layout(r);
        // The C spelling, when there is one.
        if CRECS[r].tag >= 0 && CRECS[r].tag != intern_c(c"__va_list_tag") {
            out(if CRECS[r].is_union != 0 { c"// C: union " } else { c"// C: struct " });
            buf_bytes(OUTB, SYMS[CRECS[r].tag].text);
            out(c"\n");
        } else if CRECS[r].parent < 0 && CRECS[r].name >= 0 && typedef_of(CRECS[r].name) >= 0 {
            out(c"// C: ");
            buf_bytes(OUTB, SYMS[CRECS[r].name].text);
            out(c"\n");
        }
        if CRECS[r].opaque >= 0 {
            // Usable through pointers only.
            out(c"// ");
            buf_bytes(OUTB, SYMS[CRECS[r].name].text);
            out(c": opaque, ");
            buf_bytes(OUTB, SYMS[CRECS[r].opaque].text);
            out(c"\nstruct ");
            out_name(CRECS[r].name);
            out(c" {}\n");
            return;
        }
        out(c"#[repr(C");
        if CRECS[r].emit_packed != 0 {
            out(c", packed");
            if CRECS[r].emit_packed > 1 {
                out(c"(");
                out_int(CRECS[r].emit_packed);
                out(c")");
            }
        }
        if CRECS[r].emit_align != 0 {
            out(c", align(");
            out_int(CRECS[r].emit_align);
            out(c")");
        }
        out(c")]\n");
        let is_union = CRECS[r].is_union != 0;
        out(if is_union { c"union " } else { c"struct " });
        out_name(CRECS[r].name);
        out(c" {\n");
        let mut at = 0;
        let mut pads = 0;
        let mut anons = 0;
        let mut bitfields = 0;
        let n = CRECS[r].field_count;
        let mut i = 0;
        while i < n {
            let f = cfield(r, i);
            if (*f).bits >= 0 {
                if is_union {
                    if (*f).bits > 0 {
                        out_member(member_name(r, c"_bitfield", bitfields), ((*f).bits + 7) / 8);
                        bitfields += 1;
                    }
                    i += 1;
                    continue;
                }
                // A run of bit-fields: their bytes.
                let first_bit = (*f).bit_offset;
                let mut end_bit = first_bit;
                while i < n && (*cfield(r, i)).bits >= 0 {
                    let g = cfield(r, i);
                    let e = (*g).bit_offset + (*g).bits;
                    end_bit = if e > end_bit { e } else { end_bit };
                    i += 1;
                }
                let lo = first_bit / 8;
                let hi = (end_bit + 7) / 8;
                if hi > lo {
                    if lo > at {
                        out_member(member_name(r, c"_pad", pads), lo - at);
                        pads += 1;
                    }
                    let start = if lo > at { lo } else { at };
                    out_member(member_name(r, c"_bitfield", bitfields), hi - start);
                    bitfields += 1;
                    at = hi;
                }
                continue;
            }
            // Padding only where tachyon's own placement would differ.
            let mut ma = c_align((*f).ty);
            if CRECS[r].emit_packed != 0 && ma > CRECS[r].emit_packed {
                ma = CRECS[r].emit_packed;
            }
            if !is_union && (*f).offset > align_to(at, ma) {
                out_member(member_name(r, c"_pad", pads), (*f).offset - at);
                pads += 1;
            }
            out(c"    ");
            if (*f).name >= 0 {
                out_name((*f).name);
            } else {
                out_name(member_name(r, c"_anon", anons));
                anons += 1;
            }
            out(c": ");
            out_type((*f).ty);
            out(c",\n");
            if !is_union {
                at = (*f).offset + c_size((*f).ty);
            }
            i += 1;
        }
        // Tail padding beyond what alignment gives.
        let align = if CRECS[r].emit_packed != 0 { CRECS[r].emit_packed } else { CRECS[r].align };
        if is_union {
            let mut largest = 0;
            for j in 0..n {
                let f = cfield(r, j);
                let s = if (*f).bits >= 0 { ((*f).bits + 7) / 8 } else { c_size((*f).ty) };
                largest = if s > largest { s } else { largest };
            }
            if align_to(largest, align) < CRECS[r].size {
                out_member(member_name(r, c"_pad", pads), CRECS[r].size);
            }
        } else if align_to(at, align) < CRECS[r].size {
            out_member(member_name(r, c"_pad", pads), CRECS[r].size - at);
        }
        out(c"}\n");
    }
}

// The tachyon type of an integer constant of C type t.
fn out_const_type(t: i64) {
    let r = cty_resolve(t);
    if unsafe { CTYPES[t].kind == Named && CTYPEDEFS[CTYPES[t].a].tname >= 0 && CTYPES[r].kind == Int } {
        out_type(t);
        return;
    }
    out_type(cty_integer(t));
}

fn out_value(v: u64, t: i64) {
    if cty_signed(t) {
        out_int(v as i64);
    } else {
        buf_uint(OUTB, v);
    }
}

fn claim_value(sym: i64) -> bool {
    if USED_VALUE.get(sym + 1) != 0 {
        return false;
    }
    USED_VALUE.put(sym + 1, 1);
    true
}

// Writes the imported declarations as tachyon source to buffer `b`.
fn cimport_emit(b: i64) {
    unsafe {
        OUTB = b;
        assign_type_names();
        for r in 0..CREC_COUNT {
            emit_record(r);
        }
        for i in 0..CTYPEDEF_COUNT {
            if CTYPEDEFS[i].tname >= 0 {
                let problem = c_value_problem(CTYPEDEFS[i].ty);
                let r = cty_resolve(CTYPEDEFS[i].ty);
                if problem >= 0 && !(CTYPES[r].kind == Record) {
                    skip_reason(CTYPEDEFS[i].name, problem);
                    continue;
                }
                out(c"type ");
                out_name(CTYPEDEFS[i].tname);
                out(c" = ");
                out_type(CTYPEDEFS[i].ty);
                out(c";\n");
            }
        }
        for e in 0..CENUM_COUNT {
            if CENUMS[e].name >= 0 {
                out(c"type ");
                out_name(CENUMS[e].name);
                out(c" = ");
                out_type(CENUMS[e].underlying);
                out(c";\n");
            }
        }
        out(c"extern \"C\" {\n");
        for i in 0..CFUNC_COUNT {
            let f = cty_resolve(CFUNCS[i].ty);
            let problem = c_fn_problem(f);
            if problem >= 0 {
                skip_reason(CFUNCS[i].name, problem);
                continue;
            }
            if !claim_value(CFUNCS[i].name) {
                continue;
            }
            EMITTED_VALUE.put(CFUNCS[i].name + 1, 1);
            out_link_name(CFUNCS[i].link, CFUNCS[i].name);
            out_function(i, CFUNCS[i].name);
        }
        for i in 0..CVAR_COUNT {
            let problem = c_value_problem(CVARS[i].ty);
            let r = cty_resolve(CVARS[i].ty);
            if problem >= 0 || (CTYPES[r].kind == Array && CTYPES[r].b < 0) {
                skip_reason(CVARS[i].name, if problem >= 0 { problem } else { intern_c(c"an array of unknown size") });
                continue;
            }
            if !claim_value(CVARS[i].name) {
                continue;
            }
            EMITTED_VALUE.put(CVARS[i].name + 1, 1);
            out_link_name(CVARS[i].link, CVARS[i].name);
            out(if CVARS[i].is_const != 0 { c"    static " } else { c"    static mut " });
            out_name(CVARS[i].name);
            out(c": ");
            out_type(CVARS[i].ty);
            out(c";\n");
        }
        out(c"}\n");
        for i in 0..CENUMERATOR_COUNT {
            let name = CENUMERATORS[i].name;
            if ENUMERATOR_OF.get(name + 1) != i + 1 || !claim_value(name) {
                continue;
            }
            let e = CENUMERATORS[i].ty;
            out(c"const ");
            out_name(name);
            out(c": ");
            let t = if CENUMS[e].name >= 0 { CENUMS[e].ty } else { enumerator_type(i) };
            out_type(t);
            out(c" = ");
            out_value(CENUMERATORS[i].value as u64, t);
            out(c";\n");
        }
        emit_macro_constants();
        emit_aliases();
    }
}

// The declaration of C function f under `name`.
fn out_function(i: i64, name: i64) {
    unsafe {
        let f = cty_resolve(CFUNCS[i].ty);
        out(c"    fn ");
        out_name(name);
        out(c"(");
        for k in 0..CTYPES[f].c {
            if k > 0 {
                out(c", ");
            }
            out(c"p");
            out_int(k);
            out(c": ");
            out_type(CINTS.data[CTYPES[f].b + k]);
        }
        if CTYPES[f].d != 0 {
            out(if CTYPES[f].c > 0 { c", ..." } else { c"..." });
        }
        out(c")");
        let ret = cty_resolve(CTYPES[f].a);
        if CTYPES[ret].kind == Void {
            if CFUNCS[i].noreturn != 0 {
                out(c" -> !");
            }
        } else {
            out(c" -> ");
            out_type(CTYPES[f].a);
        }
        out(c";\n");
    }
}

// `#[link_name]` when an asm label renames the symbol. Labels are
// assembler names: on Mach-O, C's names have a leading underscore.
fn out_link_name(link: i64, name: i64) {
    unsafe {
        if link < 0 {
            return;
        }
        let text = SYMS[link].text;
        let mut start = 0;
        if !C_TARGET_ELF {
            if text.len == 0 || text[0] != '_' {
                return;
            }
            start = 1;
        }
        let sym = intern(text[start..text.len as i64]);
        if sym == name {
            return;
        }
        out(c"    #[link_name = \"");
        buf_bytes(OUTB, SYMS[sym].text);
        out(c"\"]\n");
    }
}

static mut C_TARGET_ELF: bool = false;

// Object-like macros that are integer or float constants, as constants.
fn emit_macro_constants() {
    unsafe {
        for m in 0..MACRO_COUNT {
            let name = MACROS[m].name;
            if MACROS[m].builtin || MACROS[m].func || macro_of(name) != m || MACROS[m].body_count == 0 {
                continue;
            }
            if USED_VALUE.get(name + 1) != 0 {
                continue;
            }
            let at = macro_tok(m, 0);
            let start = CINTS.count;
            let tok = ctok_copy(at);
            CTOKS[tok].kind = CK::Ident;
            CTOKS[tok].text = name;
            CINTS.push(tok);
            let expanded = expand_list(start, 1);
            if expanded.count == 0 {
                continue;
            }
            if emit_float_constant(name, &expanded) {
                continue;
            }
            if expanded.count == 1 && CTOKS[expanded.data[0]].kind == CK::Ident {
                // `#define stdin __stdinp`: another name for a variable or a
                // function, declared again under it.
                ALIASES.push(name);
                ALIASES.push(CTOKS[expanded.data[0]].text);
                continue;
            }
            let saved = (D_TOKS, D_N, D_POS);
            let (v, t) = eval_tokens(&expanded, at, true);
            let (dt, dn, dp) = saved;
            D_TOKS = dt;
            D_N = dn;
            D_POS = dp;
            if EV_FAIL || cty_integer(t) == 0 {
                continue;
            }
            claim_value(name);
            out(c"const ");
            out_name(name);
            out(c": ");
            out_const_type(t);
            out(c" = ");
            out_value(ev_convert(v, t), t);
            out(c";\n");
        }
    }
}

// Macros naming a variable or a function: (macro, name) pairs.
static mut ALIASES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The aliases as declarations of the same C symbols under the macros'
// names (only of variables and functions that were imported).
fn emit_aliases() {
    unsafe {
        out(c"extern \"C\" {\n");
        let mut i = 0;
        while i < ALIASES.count {
            let name = ALIASES.data[i];
            let target = ALIASES.data[i + 1];
            i += 2;
            if USED_VALUE.get(name + 1) != 0 {
                continue;
            }
            let v = VAR_OF.get(target + 1) - 1;
            let f = FUNC_OF.get(target + 1) - 1;
            if v >= 0 && EMITTED_VALUE.get(target + 1) != 0 {
                claim_value(name);
                out_alias_link(CVARS[v].link, target);
                out(if CVARS[v].is_const != 0 { c"    static " } else { c"    static mut " });
                out_name(name);
                out(c": ");
                out_type(CVARS[v].ty);
                out(c";\n");
            } else if f >= 0 && EMITTED_VALUE.get(target + 1) != 0 {
                claim_value(name);
                out_alias_link(CFUNCS[f].link, target);
                out_function(f, name);
            }
        }
        out(c"}\n");
    }
}

// The link name of an alias: the target's own, or its name.
fn out_alias_link(link: i64, target: i64) {
    if link >= 0 {
        out_link_name(link, -1);
        return;
    }
    unsafe {
        out(c"    #[link_name = \"");
        buf_bytes(OUTB, SYMS[target].text);
        out(c"\"]\n");
    }
}

// Values emitted as declarations (symbol + 1 -> 1).
static mut EMITTED_VALUE: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

// `[(] [-] float-literal [)]`: a float constant.
fn emit_float_constant(name: i64, toks: *IntVec) -> bool {
    unsafe {
        let mut lo = 0;
        let mut hi = (*toks).count;
        while hi - lo >= 2 && ctok_is((*toks).data[lo], S_LPAREN) && ctok_is((*toks).data[hi - 1], S_RPAREN) {
            lo += 1;
            hi -= 1;
        }
        let mut negative = false;
        if hi - lo == 2 && CTOKS[(*toks).data[lo]].kind == CK::Punct && streq(ctok_text((*toks).data[lo]), c"-") {
            negative = true;
            lo += 1;
        }
        if hi - lo != 1 || CTOKS[(*toks).data[lo]].kind != CK::Num {
            return false;
        }
        let text = ctok_text((*toks).data[lo]);
        let n = strlen(text) as i64;
        let hex = n > 1 && text[0] == '0' && (text[1] == 'x' || text[1] == 'X');
        let mut is_float = false;
        for i in 0..n {
            let c = text[i];
            if c == '.' || (!hex && (c == 'e' || c == 'E')) || (hex && (c == 'p' || c == 'P')) {
                is_float = true;
            }
        }
        if !is_float {
            return false;
        }
        let last = text[n - 1];
        let mut end = 0 as *u8;
        let mut is_f32 = false;
        let mut value: f64 = 0.0;
        if last == 'f' || last == 'F' {
            is_f32 = true;
            value = strtof(text, &end) as f64;
        } else if last == 'l' || last == 'L' {
            if !C_LONG_DOUBLE_64 {
                return false;
            }
            value = strtod(text, &end);
        } else {
            value = strtod(text, &end);
        }
        if negative {
            value = 0.0 - value;
        }
        if value != value || value - value != 0.0 {
            return false;
        }
        if !claim_value(name) {
            return true;
        }
        let digits = alloc_zeroed(64);
        snprintf(digits, 64, c"%.17g", value);
        let mut dot = false;
        let mut exp = -1;
        let dn = strlen(digits) as i64;
        for i in 0..dn {
            if digits[i] == '.' {
                dot = true;
            }
            if digits[i] == 'e' {
                exp = i;
            }
        }
        out(c"const ");
        out_name(name);
        out(if is_f32 { c": f32 = " } else { c": f64 = " });
        if dot {
            out(digits);
        } else if exp >= 0 {
            buf_bytes(OUTB, digits[0..exp]);
            out(c".0");
            out(&digits[exp]);
        } else {
            out(digits);
            out(c".0");
        }
        out(c";\n");
        true
    }
}

// ---- The import ----

fn init_cimport() {
    let widths: [i64; 4] = [8, 16, 32, 64];
    for i in 0..4 {
        CTY_INTS[i * 2] = cty_new(Int, widths[i], 0, 0, 0);
        CTY_INTS[i * 2 + 1] = cty_new(Int, widths[i], 1, 0, 0);
    }
    CTY_VOID = cty_new(Void, 0, 0, 0, 0);
    CTY_BOOL = cty_new(Bool, 0, 0, 0, 0);
    CTY_F32 = cty_new(Float, 32, 0, 0, 0);
    CTY_F64 = cty_new(Float, 64, 0, 0, 0);
}

// The value of a predefined macro that is a number, or -1.
fn builtin_number(name: *u8) -> i64 {
    unsafe {
        let m = macro_of(intern_c(name));
        if m < 0 || MACROS[m].body_count != 1 {
            return -1;
        }
        let t = macro_tok(m, 0);
        if CTOKS[t].kind != CK::Num {
            return -1;
        }
        let mut end = 0 as *u8;
        strtoull(ctok_text(t), &end, 10) as i64
    }
}

// Imports the C headers named by the `import` items (`names`: C strings;
// `relative`: whether each is relative to `dirs`, the directory of its
// file) for target `target`; returns the tachyon source as a buffer.
pub fn c_import(names: *IntVec, dirs: *IntVec, include_dirs: *IntVec, target: i64) -> i64 {
    unsafe {
        init_cpp();
        init_cimport();
        C_TARGET_X86 = target != T_AARCH64_MACOS;
        C_TARGET_ELF = target == T_X86_64_LINUX;
        let host = host_target();
        let host_linux = host == T_X86_64_LINUX;
        let target_linux = target == T_X86_64_LINUX;
        if (host == 0 || host_linux != target_linux || (target_linux && host != target)) && !c_compiler_given() {
            // (0.9) Cross-compiling: the target's headers and predefined
            // macros come from a C compiler for it, named by $TACHYON_CC.
            let b = buf_new();
            buf_str(b, c"`import` of C headers for ");
            buf_str(b, target_name(target));
            buf_str(b, c" needs a C compiler for that target, with its headers: this host's cc is not one. Set TACHYON_CC to one (for example `clang --target=x86_64-linux-gnu --sysroot=DIR`, DIR holding a Linux system's /usr/include), or write the declarations as tachyon source with `tachyonc --emit-imports` on a host of the target's system");
            buf_byte(b, 0);
            die(BUFS[b].data);
        }
        for i in 0..(*include_dirs).count {
            CDIRS.push((*include_dirs).data[i]);
        }
        let flags = if target == T_AARCH64_MACOS { c" -arch arm64" } else if target == T_X86_64_MACOS { c" -arch x86_64" } else { c"" };
        cpp_query_compiler(flags);
        C_LONG_DOUBLE_64 = builtin_number(c"__SIZEOF_LONG_DOUBLE__") == 8;
        // The headers, as one translation unit of #includes.
        let top = buf_new();
        for i in 0..(*names).count {
            let name = (*names).data[i] as *u8;
            if name[0] == '.' && (name[1] == '/' || (name[1] == '.' && name[2] == '/')) {
                buf_str(top, c"#include \"");
                buf_str(top, path_join((*dirs).data[i] as *u8, name));
                buf_str(top, c"\"\n");
            } else {
                buf_str(top, c"#include <");
                buf_str(top, name);
                buf_str(top, c">\n");
            }
        }
        let f = c_load_text(c"<import>", top);
        C_IMPORT_FILE = f;
        push_frame(f);
        let toks = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        loop {
            let t = cpp_next();
            if t == C_EOF {
                break;
            }
            toks.push(t);
        }
        cdecl_parse(&toks);
        let b = buf_new();
        buf_str(b, c"// Declarations imported from C headers by tachyonc.\n");
        cimport_emit(b);
        b
    }
}

// Imported declarations live in a module of their own (modules.tach), so
// the program's own functions and constants of the same names shadow them
// without clashing (0.5). The program's types replace the imported ones
// of the same names (a program may declare the types a header it imports
// also declares; the imported functions then take the program's, as the
// C module sees the root's names), and so do its statics (the code
// generators know statics by symbol).
pub fn drop_shadowed_imports(program: i64) {
    unsafe {
        let mut types = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        let mut values = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for i in 0..NODES[program].count {
            let item = child(program, i);
            if NODES[item].start >= IMPORTED_START || module_of(item) != 0 {
                continue;
            }
            let name = NODES[item].a;
            match NODES[item].kind {
                NodeKind::Struct | NodeKind::Enum | NodeKind::TypeAlias => types.put(name + 1, 1),
                NodeKind::Static => values.put(name + 1, 1),
                _ => {}
            }
        }
        let mark = list_begin();
        for i in 0..NODES[program].count {
            let item = child(program, i);
            if NODES[item].start >= IMPORTED_START {
                let name = NODES[item].a;
                let shadowed = match NODES[item].kind {
                    NodeKind::Struct | NodeKind::Enum | NodeKind::TypeAlias => types.get(name + 1) != 0,
                    NodeKind::Static => values.get(name + 1) != 0,
                    _ => false,
                };
                if shadowed {
                    continue;
                }
            }
            list_push(item);
        }
        list_end(program, mark);
    }
}

// Why `name` was not imported from the C headers (0: it was not
// skipped), for the error when a program uses it.
pub fn c_import_skip_reason(name: i64) -> *u8 {
    let r = C_SKIPPED.get(name + 1);
    if r == 0 { 0 as *u8 } else { sym_name(r - 1) }
}
