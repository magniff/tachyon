static mut FRAME_OUT: i64 = 0;
static mut SPILL_BASE: i64 = 0;
static mut SAVE_BASE: i64 = 0;
static mut FRAME_TOTAL: i64 = 0;
static mut LABEL_BASE: i64 = 0;
static mut EPILOGUE_LABEL: i64 = 0;
// The index register of the next memory operand (-1: none) and its shift
// (LOADX, STOREX, LEA).
pub static mut MEM_INDEX: i64 = -1;
pub static mut MEM_SCALE: i64 = 0;
// Whether the function's branches all reach (AArch64's tbz and tbnz reach
// 32 KB).
pub static mut SHORT_BRANCHES: bool = false;

// ---- Statistics (--stats) ----

// --stats: 1 prints totals of the machine code emitted (at -O1 and -O2)
// on stderr, 2 also a line per function.
pub static mut STATS: i64 = 0;
// The counters, of the function being emitted (ST_FN) and in total
// (ST_ALL): instructions, register moves, stores to spill slots, loads
// from them, moves and spill traffic on loop back edges, frame bytes
// (with the saved frame pointer and return address), functions with a
// frame, saved callee-saved registers, functions.
const ST_INSTS: i64 = 0;
const ST_MOVES: i64 = 1;
const ST_SPILLS: i64 = 2;
const ST_RELOADS: i64 = 3;
const ST_BACK: i64 = 4;
const ST_FRAME: i64 = 5;
const ST_FRAMES: i64 = 6;
const ST_SAVES: i64 = 7;
const ST_FUNCS: i64 = 8;
const ST_COUNT: i64 = 9;
static mut ST_FN: [i64; 9] = [0; 9];
static mut ST_ALL: [i64; 9] = [0; 9];

fn st_names(k: i64) -> *u8 {
    if k == ST_INSTS { c"instructions" }
    else if k == ST_MOVES { c"moves" }
    else if k == ST_SPILLS { c"spill stores" }
    else if k == ST_RELOADS { c"reloads" }
    else if k == ST_BACK { c"back-edge moves" }
    else if k == ST_FRAME { c"frame bytes" }
    else if k == ST_FRAMES { c"frames" }
    else if k == ST_SAVES { c"saved registers" }
    else { c"functions" }
}

// The spill traffic of the move to or from [sp + offset].
fn st_spill(load: bool, base: i64, offset: i64) {
    if MEM_INDEX < 0 && base == reg_sp() && offset >= SPILL_BASE && offset < SAVE_BASE {
        ST_FN[if load { ST_RELOADS } else { ST_SPILLS }] += 1;
    }
}

// The instructions of the function just emitted: lines of CODE indented
// by four spaces that are not directives.
fn st_count_instructions() -> i64 {
    unsafe {
        let data = BUFS[CODE].data;
        let len = BUFS[CODE].len;
        let mut n = 0;
        let mut i = 0;
        while i < len {
            if i + 4 < len && data[i] == ' ' && data[i + 4] != '.' && data[i + 4] != ' ' {
                n += 1;
            }
            while i < len && data[i] != '\n' {
                i += 1;
            }
            i += 1;
        }
        n
    }
}

fn st_function_done(fi: i64) {
    unsafe {
        ST_FN[ST_INSTS] = st_count_instructions();
        ST_FN[ST_FUNCS] = 1;
        if STATS > 1 {
            let out = buf_new();
            buf_str(out, c"stats ");
            let name = FNS[IRFUNCS[fi].f].name;
            buf_bytes(out, SYMS[name].text);
            for k in 0..ST_COUNT - 1 {
                buf_byte(out, ' ');
                buf_int(out, ST_FN[k]);
            }
            buf_byte(out, '\n');
            buf_write_fd(out, STDERR);
        }
        for k in 0..ST_COUNT {
            ST_ALL[k] += ST_FN[k];
            ST_FN[k] = 0;
        }
    }
}

// Prints the totals (after the last function).
pub fn print_stats() {
    unsafe {
        if STATS == 0 {
            return;
        }
        let out = buf_new();
        buf_str(out, c"stats:");
        for k in 0..ST_COUNT {
            buf_str(out, if k == 0 { c" " } else { c", " });
            buf_int(out, ST_ALL[k]);
            buf_byte(out, ' ');
            buf_str(out, st_names(k));
        }
        buf_byte(out, '\n');
        buf_write_fd(out, STDERR);
    }
}

// ---- Registers of the machine layer ----

pub fn reg_sp() -> i64 { if X86 { 4 } else { 31 } }
pub fn reg_fp() -> i64 { if X86 { 5 } else { 29 } }
// Never allocated: the register that breaks cycles of parallel moves, and
// the temporary for memory-to-memory moves (and for operands loaded or
// rematerialized where they are needed).
fn reg_cycle(float: bool) -> i64 {
    if float { if X86 { 47 } else { 63 } } else if X86 { 10 } else { 17 }
}
fn reg_move_temp(float: bool) -> i64 {
    if float { if X86 { 46 } else { 62 } } else if X86 { 11 } else { 16 }
}
pub fn reg_ret(float: bool) -> i64 { if float { 32 } else { 0 } }
fn reg_result_ptr() -> i64 { if X86 { 7 } else { 8 } }
fn reg_callee() -> i64 { if X86 { 11 } else { 16 } }

// Argument locations in the back end, for both conventions (see
// abi.tach): 0-31 the index of an int argument register, 32-63 of a
// float one, XL_STACK + offset a slot of the stack argument area (outgoing:
// from sp; incoming: from the frame pointer, 16 bytes up).
const XL_FLOAT: i64 = 32;
const XL_STACK: i64 = 64;

pub fn xl_is_stack(location: i64) -> bool {
    location >= XL_STACK
}

fn xl_offset(location: i64) -> i64 {
    location - XL_STACK
}

// A location of the C convention (see arg_location) as a back-end one.
pub fn xl_from_c(location: i64) -> i64 {
    if location < 8 {
        return location;
    }
    if location < 16 {
        return XL_FLOAT + location - 8;
    }
    XL_STACK + location - 16
}

// The register of argument location `location`: C's argument registers
// first, then the tachyon convention's further ones.
pub fn arg_reg(location: i64) -> i64 {
    if location >= XL_FLOAT {
        let index = location - XL_FLOAT;
        if X86 || index < 8 {
            return 32 + index;
        }
        // d16-d23.
        return 32 + 8 + index;
    }
    if !X86 {
        return location;
    }
    if location == 0 { return 7; }
    if location == 1 { return 6; }
    if location == 2 { return 2; }
    if location == 3 { return 1; }
    if location == 4 { return 8; }
    if location == 5 { return 9; }
    0
}

// The tachyon convention's argument registers.
fn t_int_args() -> i64 { if X86 { 7 } else { 16 } }
fn t_float_args() -> i64 { if X86 { 14 } else { 16 } }

// The location of the next scalar argument of type ty under the tachyon
// convention: the next register of its class, else the next 8-byte stack
// slot. `state` as for arg_location.
fn t_arg_location(ty: i64, state: *i64) -> i64 {
    unsafe {
        if is_float(ty) {
            if state[1] < t_float_args() {
                state[1] += 1;
                return XL_FLOAT + state[1] - 1;
            }
        } else if state[0] < t_int_args() {
            state[0] += 1;
            return state[0] - 1;
        }
        let offset = state[2];
        state[2] += 8;
        XL_STACK + offset
    }
}

// Whether call v follows C's convention.
pub fn call_uses_c(v: i64) -> bool {
    unsafe {
        let op = INSTS[v].op;
        if op == Call { return fn_uses_c(INSTS[v].imm); }
        if op == CallI { return fn_type_uses_c(INSTS[v].imm); }
        true
    }
}

pub fn call_returns_through_pointer(v: i64) -> bool {
    conv_returns_through_pointer(call_uses_c(v), callee_result(v))
}

// The register of the result pointer: x8 / rdi in C's convention, the first
// argument register in tachyon's.
fn conv_result_ptr_reg(c: bool) -> i64 {
    if c { reg_result_ptr() } else { arg_reg(0) }
}

fn is_float_reg(r: i64) -> bool {
    r >= 32
}

// The type a spill slot is accessed with.
fn spill_type(ty: i64) -> i64 {
    if is_float(ty) { ty } else { TY_U64 }
}

fn spill_offset(loc: i64) -> i64 {
    SPILL_BASE + 8 * (0 - loc - 1)
}

fn block_label(b: i64) -> i64 {
    unsafe { LABEL_BASE + BLOCKS[b].order }
}

// ---- Dispatch to the machine layer ----

// Post-allocation peepholes on what was just emitted (nothing else, not
// even a label, since): a move back to where a value just came from is
// none, and a load of the spill slot (or stack slot) just stored to is a
// move from the register stored.
static mut LAST_MOV_DST: i64 = -1;
static mut LAST_MOV_SRC: i64 = -1;
static mut LAST_MOV_END: i64 = -1;
static mut LAST_STORE_REG: i64 = -1;
static mut LAST_STORE_OFFSET: i64 = 0;
static mut LAST_STORE_TYPE: i64 = 0;
static mut LAST_STORE_END: i64 = -1;

pub fn m_mov(dst: i64, src: i64, ty: i64) {
    unsafe {
        if dst == src { return; }
        if BUFS[CODE].len == LAST_MOV_END && dst == LAST_MOV_SRC && src == LAST_MOV_DST {
            return;
        }
        if X86 { mx_mov(dst, src, ty); } else { ma_mov(dst, src, ty); }
        ST_FN[ST_MOVES] += 1;
        LAST_MOV_DST = dst;
        LAST_MOV_SRC = src;
        LAST_MOV_END = BUFS[CODE].len;
    }
}
fn m_load_imm(dst: i64, value: u64) {
    if X86 { mx_load_imm(dst, value); } else { ma_load_imm(dst, value); }
}
fn m_load_fimm(dst: i64, bits: i64, ty: i64) {
    if X86 { mx_load_fimm(dst, bits, ty); } else { ma_load_fimm(dst, bits, ty); }
}
pub fn m_load(ty: i64, dst: i64, base: i64, offset: i64) {
    if unsafe { MEM_INDEX < 0 && base == reg_sp() && BUFS[CODE].len == LAST_STORE_END && offset == LAST_STORE_OFFSET
        && ty == LAST_STORE_TYPE && type_size(ty) == 8 && (dst >= 32) == (LAST_STORE_REG >= 32) } {
        m_mov(dst, LAST_STORE_REG, ty);
        return;
    }
    st_spill(true, base, offset);
    if X86 { mx_load(ty, dst, base, offset); } else { ma_load(ty, dst, base, offset); }
}
pub fn m_store(ty: i64, src: i64, base: i64, offset: i64) {
    st_spill(false, base, offset);
    if X86 { mx_store(ty, src, base, offset); } else { ma_store(ty, src, base, offset); }
    if MEM_INDEX < 0 && base == reg_sp() {
        LAST_STORE_REG = src;
        LAST_STORE_OFFSET = offset;
        LAST_STORE_TYPE = ty;
        unsafe { LAST_STORE_END = BUFS[CODE].len; }
    }
}
pub fn m_lea(dst: i64, base: i64, offset: i64) {
    if X86 { mx_lea(dst, base, offset); } else { ma_lea(dst, base, offset); }
}
fn m_symbol_addr(dst: i64, prefix: *u8, name: i64) {
    if X86 { mx_symbol_addr(dst, prefix, name); } else { ma_symbol_addr(dst, prefix, name); }
}
fn m_extern_addr(dst: i64, name: i64) {
    if X86 { mx_extern_addr(dst, name); } else { ma_extern_addr(dst, name); }
}
fn m_string_addr(dst: i64, id: i64) {
    if X86 { mx_string_addr(dst, id); } else { ma_string_addr(dst, id); }
}
fn m_normalize(r: i64, ty: i64) {
    if X86 { mx_normalize(r, ty); } else { ma_normalize(r, ty); }
}
fn m_int_op(op: Op, ty: i64, dst: i64, a: i64, b: i64) {
    if X86 { mx_int_op(op, ty, dst, a, b); } else { ma_int_op(op, ty, dst, a, b); }
}
// dst = a <op> imm when the target encodes it; false otherwise.
fn m_int_op_imm(op: Op, ty: i64, dst: i64, a: i64, imm: i64) -> bool {
    if X86 { mx_int_op_imm(op, ty, dst, a, imm) } else { ma_int_op_imm(op, ty, dst, a, imm) }
}
fn m_float_op(op: Op, ty: i64, dst: i64, a: i64, b: i64) {
    if X86 { mx_float_op(op, ty, dst, a, b); } else { ma_float_op(op, ty, dst, a, b); }
}
fn m_unary(op: Op, ty: i64, dst: i64, a: i64) {
    if X86 { mx_unary(op, ty, dst, a); } else { ma_unary(op, ty, dst, a); }
}
fn m_cmp(op: Cond, ty: i64, dst: i64, a: i64, b: i64) {
    if X86 { mx_cmp(op, ty, dst, a, b); } else { ma_cmp(op, ty, dst, a, b); }
}
// Compares integers a and b (b an immediate when b_imm) and jumps to
// `label` when a <op> b.
fn m_cmp_branch(op: Cond, ty: i64, a: i64, b: i64, b_is_imm: bool, imm: i64, label: i64) {
    if X86 { mx_cmp_branch(op, ty, a, b, b_is_imm, imm, label); } else { ma_cmp_branch(op, ty, a, b, b_is_imm, imm, label); }
}
fn m_branch_bool(r: i64, if_nonzero: bool, label: i64) {
    if X86 { mx_branch_bool(r, if_nonzero, label); } else { ma_branch_bool(r, if_nonzero, label); }
}
fn m_jump(label: i64) {
    emit_jump(label);
}
fn m_conv(from: i64, to: i64, dst: i64, src: i64) {
    if X86 { mx_conv(from, to, dst, src); } else { ma_conv(from, to, dst, src); }
}
fn m_copy(dst: i64, src: i64, size: i64) {
    if X86 { mx_copy(dst, src, size); } else { ma_copy(dst, src, size); }
}
fn m_div(op: Op, ty: i64, dst: i64, a: i64, b: i64, b_const: i64, b_is_const: bool) {
    if X86 { mx_div(op, ty, dst, a, b, b_const, b_is_const); } else { ma_int_op(op, ty, dst, a, b); }
}
// Whether `dst = a <op> imm` is one instruction (m_int_op_imm emits it).
pub fn m_int_imm_ok(op: Op, ty: i64, imm: i64) -> bool {
    if X86 { mx_int_imm_ok(op, imm) } else { ma_int_imm_ok(op, imm) }
}
fn m_trap() {
    unsafe {
        if X86 { ins(c"ud2"); } else { ins(c"brk #1"); }
    }
}

// ---- Operands and results ----

// The position of the instruction being emitted.
static mut CUR_POS: i64 = 0;

// Rematerializes value `v` (is_remat_op) into register `r`.
fn materialize(v: i64, r: i64) {
    unsafe {
        let op = INSTS[v].op;
        let imm = INSTS[v].imm;
        if op == Const {
            if is_float(INSTS[v].ty) {
                m_load_fimm(r, imm, INSTS[v].ty);
            } else {
                m_load_imm(r, imm as u64);
            }
        } else if op == Slot {
            m_lea(r, reg_sp(), SLOTS[imm].offset);
        } else if op == GAddr {
            let st = SYM_STATIC[imm] - 1;
            if STATICS[st].linkage == 1 {
                m_extern_addr(r, imm);
            } else {
                m_symbol_addr(r, static_symbol_prefix(st), imm);
            }
        } else if op == SAddr {
            m_string_addr(r, imm);
        } else if FNS[imm].is_extern {
            m_extern_addr(r, FNS[imm].name);
        } else {
            m_symbol_addr(r, fn_symbol_prefix(imm), FNS[imm].name);
        }
    }
}

// The register holding value `v`, an operand of the instruction being
// emitted that needs one.
fn use_reg(v: i64) -> i64 {
    let loc = vloc(v, CUR_POS);
    if loc < 0 || loc >= 64 {
        unsafe { die(c"internal error: an operand not in a register"); }
    }
    loc
}

// Value `v`, used at `pos` where it may be anywhere, in a register: its
// own, or `scratch` after loading or rematerializing it there.
fn use_any(v: i64, pos: i64, scratch: i64) -> i64 {
    unsafe {
        if INSTS[v].op.is_remat() {
            materialize(v, scratch);
            return scratch;
        }
        let loc = vloc(v, pos);
        if loc == LOC_NONE || loc == LOC_REMAT {
            die(c"internal error: operand without a location");
        }
        if loc >= 0 {
            return loc;
        }
        m_load(spill_type(INSTS[v].ty), scratch, reg_sp(), spill_offset(loc));
        scratch
    }
}

// Value `v` (used at `pos`) in register `r` exactly.
fn use_into(v: i64, pos: i64, r: i64) {
    let got = use_any(v, pos, r);
    unsafe { m_mov(r, got, INSTS[v].ty); }
}

fn int_operand(v: i64) -> i64 {
    use_reg(v)
}

fn float_operand(v: i64) -> i64 {
    use_reg(v)
}

fn operand_reg(v: i64) -> i64 {
    use_reg(v)
}

// Where the result of `v` is computed.
fn result_reg(v: i64) -> i64 {
    let loc = vloc(v, CUR_POS + 2);
    if loc < 0 || loc >= 64 {
        unsafe { die(c"internal error: a result not in a register"); }
    }
    loc
}

// Stores the result into its spill slot when it goes to the stack.
fn result_done(v: i64, r: i64) {
    let t = tracked(v);
    if t >= 0 && stored_at_def(t) {
        unsafe {
            m_store(spill_type(INSTS[v].ty), r, reg_sp(), spill_offset(0 - (1 + RV_SLOT[t])));
        }
    }
}

// Whether `v` is a constant (and its value in *value).
fn const_of(v: i64, value: *i64) -> bool {
    unsafe {
        if INSTS[v].op == Const {
            *value = INSTS[v].imm;
            return true;
        }
        false
    }
}

// ---- Parallel moves ----

// Pending moves: destination location, kind, source, type, done, the value
// read and the value written (for the checker). Kinds: a location, a
// rematerialized value, a stack argument of the caller (the source is an
// offset from the frame pointer), the address of one.
pub const PM_LOC: i64 = 0;
pub const PM_REMAT: i64 = 1;
const PM_STACK: i64 = 2;
const PM_ADDR: i64 = 3;
pub const PM_FIELDS: i64 = 7;
pub static mut PM: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// (A move to its own location is kept: for the checker, the location then
// holds the value written, as a phi takes its operand's register.)
pub fn pm_add(dst: i64, kind: i64, src: i64, ty: i64, value: i64, result: i64) {
    PM.push(dst);
    PM.push(kind);
    PM.push(src);
    PM.push(ty);
    // Not done.
    PM.push(0);
    PM.push(value);
    PM.push(result);
}

pub fn pm_dst(i: i64) -> i64 { unsafe { PM.data[i * PM_FIELDS] } }
pub fn pm_kind(i: i64) -> i64 { unsafe { PM.data[i * PM_FIELDS + 1] } }
pub fn pm_src(i: i64) -> i64 { unsafe { PM.data[i * PM_FIELDS + 2] } }
fn pm_ty(i: i64) -> i64 { unsafe { PM.data[i * PM_FIELDS + 3] } }
fn pm_done(i: i64) -> bool { unsafe { PM.data[i * PM_FIELDS + 4] != 0 } }
pub fn pm_value(i: i64) -> i64 { unsafe { PM.data[i * PM_FIELDS + 5] } }
pub fn pm_result(i: i64) -> i64 { unsafe { PM.data[i * PM_FIELDS + 6] } }

// Moves location `src` to location `dst` (a value of type `ty`).
fn move_loc(dst: i64, src: i64, ty: i64) {
    if dst == src {
        return;
    }
    let st = spill_type(ty);
    if dst >= 0 && src >= 0 {
        m_mov(dst, src, ty);
    } else if dst >= 0 {
        m_load(st, dst, reg_sp(), spill_offset(src));
    } else if src >= 0 {
        m_store(st, src, reg_sp(), spill_offset(dst));
    } else {
        let temp = reg_move_temp(is_float(ty));
        m_load(st, temp, reg_sp(), spill_offset(src));
        m_store(st, temp, reg_sp(), spill_offset(dst));
    }
}

// Whether location `loc` is the source of a pending location move other
// than move `except`.
fn pm_is_source(loc: i64, except: i64) -> bool {
    let n = PM.count / PM_FIELDS;
    for j in 0..n {
        if j != except && !pm_done(j) && pm_kind(j) == PM_LOC && pm_src(j) == loc {
            return true;
        }
    }
    false
}

// Emits every pending move, then clears them.
fn pm_resolve() {
    unsafe {
        let n = PM.count / PM_FIELDS;
        for i in 0..n {
            if pm_kind(i) == PM_LOC && pm_dst(i) == pm_src(i) {
                PM.data[i * PM_FIELDS + 4] = 1;
            }
        }
        loop {
            let mut pending = false;
            let mut progress = false;
            for i in 0..n {
                if pm_done(i) || pm_kind(i) != PM_LOC {
                    continue;
                }
                pending = true;
                if !pm_is_source(pm_dst(i), i) {
                    move_loc(pm_dst(i), pm_src(i), pm_ty(i));
                    PM.data[i * PM_FIELDS + 4] = 1;
                    progress = true;
                }
            }
            if !pending {
                break;
            }
            if progress {
                continue;
            }
            // Only cycles are left: save one destination's current value in
            // the cycle register, and read it from there instead.
            let mut i = 0;
            while pm_done(i) || pm_kind(i) != PM_LOC {
                i += 1;
            }
            let d = pm_dst(i);
            let temp = reg_cycle(is_float(pm_ty(i)));
            if pm_is_source(temp, -1) {
                die(c"internal error: parallel move cycle register in use");
            }
            move_loc(temp, d, pm_ty(i));
            for j in 0..n {
                if !pm_done(j) && pm_kind(j) == PM_LOC && pm_src(j) == d {
                    PM.data[j * PM_FIELDS + 2] = temp;
                }
            }
        }
        for i in 0..n {
            if pm_done(i) || pm_kind(i) == PM_LOC {
                continue;
            }
            let dst = pm_dst(i);
            let ty = pm_ty(i);
            let r = if dst >= 0 { dst } else { reg_move_temp(is_float(ty)) };
            if pm_kind(i) == PM_REMAT {
                materialize(pm_src(i), r);
            } else if pm_kind(i) == PM_ADDR {
                m_lea(r, reg_fp(), pm_src(i));
            } else {
                m_load(ty, r, reg_fp(), pm_src(i));
            }
            if dst < 0 {
                m_store(spill_type(ty), r, reg_sp(), spill_offset(dst));
            }
        }
        PM.count = 0;
    }
}

// Adds the move of value `v` (where it is at `pos`) into location `dst`.
fn pm_add_value(dst: i64, v: i64, pos: i64) {
    unsafe {
        if INSTS[v].op.is_remat() {
            pm_add(dst, PM_REMAT, v, INSTS[v].ty, v, v);
        } else {
            pm_add(dst, PM_LOC, vloc(v, pos), INSTS[v].ty, v, v);
        }
    }
}

// ---- Functions ----

// Assigns the frame offsets (after register allocation).
// Whether the function being emitted calls anything.
static mut HAS_CALLS: bool = false;

// The alignment of the frame (above 16: sp is realigned in the prologue,
// for slots, and stack arguments, aligned above 16).
static mut FRAME_ALIGN: i64 = 16;

fn layout_frame(fi: i64) {
    unsafe {
        FRAME_OUT = 0;
        FRAME_ALIGN = 16;
        HAS_CALLS = false;
        USES_SLOTS = false;
        // Slots no instruction refers to any more (scalar replacement took
        // them apart) get no room: offset -1.
        for i in 0..IRFUNCS[fi].slots.count {
            SLOTS[IRFUNCS[fi].slots.data[i]].offset = -1;
        }
        for i in 0..ORDER.count {
            let mut v = BLOCKS[ORDER.data[i]].first;
            while v != 0 {
                if INSTS[v].op.is_call() && is_emitted(v) {
                    HAS_CALLS = true;
                }
                if INSTS[v].op == Slot && USES[v] > 0 {
                    SLOTS[INSTS[v].imm].offset = 0;
                    USES_SLOTS = true;
                }
                if INSTS[v].op.is_call() {
                    let size = call_stack_size(v);
                    if size > FRAME_OUT {
                        FRAME_OUT = size;
                    }
                    if INSTS[v].op != CallC {
                        for k in 0..callee_param_count(v) {
                            FRAME_ALIGN = max_i64(FRAME_ALIGN, type_align(callee_param(v, k)));
                        }
                    }
                    // Aggregates passed to `...` (their first piece carries the
                    // type, negated).
                    for k in 0..INSTS[v].nargs {
                        let declared = ARGTY.data[INSTS[v].args + k];
                        if declared < 0 && declared != VARIADIC_PIECE {
                            FRAME_ALIGN = max_i64(FRAME_ALIGN, type_align(0 - declared));
                        }
                    }
                }
                v = INSTS[v].next;
            }
        }
        let mut offset = align_to(FRAME_OUT, 8);
        SPILL_BASE = offset;
        offset += 8 * SPILL_COUNT;
        SAVE_BASE = offset;
        for r in 0..64 {
            if CALLEE_USED[r] != 0 {
                offset += 8;
            }
        }
        if offset > 32760 {
            die(c"internal error: too many spill slots");
        }
        for i in 0..IRFUNCS[fi].slots.count {
            let s = IRFUNCS[fi].slots.data[i];
            if SLOTS[s].offset < 0 {
                continue;
            }
            offset = align_to(offset, SLOTS[s].align);
            SLOTS[s].offset = offset;
            offset += SLOTS[s].size;
            FRAME_ALIGN = max_i64(FRAME_ALIGN, SLOTS[s].align);
        }
        FRAME_TOTAL = align_to(offset, 16);
    }
}

// Saves (or restores) the callee-saved registers used: on AArch64 two at
// a time (stp, ldp) when they are of one kind.
fn save_callee_saved(restore: bool) {
    let mut offset = SAVE_BASE;
    let mut pending = -1;
    for r in 0..64 {
        if CALLEE_USED[r] == 0 {
            continue;
        }
        if !X86 && pending >= 0 && (pending >= 32) == (r >= 32) && offset - 8 <= 504 {
            ma_pair(restore, pending, r, offset - 8);
            pending = -1;
        } else {
            if pending >= 0 {
                save_one(restore, pending, offset - 8);
            }
            pending = r;
        }
        offset += 8;
    }
    if pending >= 0 {
        save_one(restore, pending, offset - 8);
    }
}

fn save_one(restore: bool, r: i64, offset: i64) {
    let ty = if r >= 32 { TY_F64 } else { TY_U64 };
    if restore {
        m_load(ty, r, reg_sp(), offset);
    } else {
        m_store(ty, r, reg_sp(), offset);
    }
}

// The location of each parameter of function `f` (by its convention): of
// parameter i at locations[i], or of its pieces at pieces[4 * i + k] (see
// abi.tach).
pub fn param_locations(f: i64, locations: *i64, pieces: *i64) {
    unsafe {
        let c = fn_uses_c(f);
        let ret = FNS[f].ret;
        let first = if c { first_int_arg(ret) } else if conv_returns_through_pointer(false, ret) { 1 } else { 0 };
        let mut state: [i64; 3] = [first, 0, 0];
        for i in 0..FNS[f].param_count {
            let ty = fn_param(f, i);
            if is_void(ty) {
                continue;
            }
            let kind = conv_classify(c, ty);
            if !c {
                if kind == AbiClass::Pieces {
                    for k in 0..ABI_PIECE_COUNT {
                        pieces[4 * i + k] = t_arg_location(ABI_PIECE_TY[k], &state as *i64);
                    }
                } else {
                    locations[i] = t_arg_location(if kind == AbiClass::Ref { TY_U64 } else { scalar_type(ty) }, &state as *i64);
                }
                continue;
            }
            if kind == AbiClass::Pieces {
                abi_piece_locations(ty, &state as *i64, &pieces[4 * i]);
                for k in 0..ABI_PIECE_COUNT {
                    pieces[4 * i + k] = xl_from_c(pieces[4 * i + k]);
                }
            } else if kind == AbiClass::Stack {
                locations[i] = xl_from_c(abi_stack_location(ty, &state as *i64));
            } else {
                locations[i] = xl_from_c(arg_location(if kind == AbiClass::Ref { TY_U64 } else { scalar_type(ty) }, &state as *i64));
            }
        }
    }
}

// Moves the parameters from where the caller put them to their locations.
fn emit_entry_moves(fi: i64) {
    unsafe {
        let f = IRFUNCS[fi].f;
        let mut locations: [i64; 64] = [0; 64];
        let mut pieces: [i64; 256] = [0; 256];
        if FNS[f].param_count > 64 {
            die(c"too many parameters (at most 64 are supported)");
        }
        param_locations(f, &locations as *i64, &pieces as *i64);
        let entry = IRFUNCS[fi].entry;
        let mut v = BLOCKS[entry].first;
        while v != 0 {
            let loc = vloc(v, 0);
            if INSTS[v].op == Param && loc != LOC_NONE {
                let ty = INSTS[v].ty;
                let index = INSTS[v].imm;
                let piece = INSTS[v].imm2;
                if index < 0 {
                    pm_add(loc, PM_LOC, conv_result_ptr_reg(fn_uses_c(f)), TY_U64, 0, v);
                } else {
                    let location = if piece > 0 { pieces[4 * index + piece - 1] } else { locations[index] };
                    // Stack arguments are 16 bytes above the frame pointer.
                    if piece < 0 {
                        pm_add(loc, PM_ADDR, 16 + xl_offset(location), TY_U64, 0, v);
                    } else if xl_is_stack(location) {
                        let param_ty = fn_param(f, index);
                        let load_ty = if is_compound(param_ty) && piece == 0 { TY_U64 } else { ty };
                        pm_add(loc, PM_STACK, 16 + xl_offset(location), load_ty, 0, v);
                    } else {
                        pm_add(loc, PM_LOC, arg_reg(location), ty, 0, v);
                    }
                }
            }
            v = INSTS[v].next;
        }
        pm_resolve();
        // Narrow integers from C callers may carry garbage above their width;
        // parameters that go to the stack are stored there.
        v = BLOCKS[entry].first;
        while v != 0 {
            let ty = INSTS[v].ty;
            let t = tracked(v);
            if INSTS[v].op == Param && t >= 0 {
                let narrow = INSTS[v].imm >= 0 && (ty == TY_BOOL || (is_integer(ty) && int_bits(ty) < 64));
                let loc = tloc(t, 0);
                if loc >= 0 {
                    if narrow {
                        m_normalize(loc, if ty == TY_BOOL { TY_U8 } else { ty });
                    }
                    result_done(v, loc);
                } else if narrow {
                    let r = reg_move_temp(false);
                    m_load(TY_U64, r, reg_sp(), spill_offset(loc));
                    m_normalize(r, if ty == TY_BOOL { TY_U8 } else { ty });
                    m_store(TY_U64, r, reg_sp(), spill_offset(loc));
                }
            }
            v = INSTS[v].next;
        }
    }
}

pub fn gen_ir_function(fi: i64) {
    unsafe {
        IRF = fi;
        let f = IRFUNCS[fi].f;
        allocate_registers(fi);
        if VERIFY_REGALLOC {
            check_allocation(fi);
        }
        layout_frame(fi);
        shrink_wrap(fi);
        SHORT_BRANCHES = function_size(fi) <= 800;
        find_trivial_jumps();
        layout_emission();
        buf_clear(CODE);
        // The peepholes' memory of what was just emitted belongs to the code of
        // the function before (whose length the new one's may match).
        LAST_MOV_END = -1;
        LAST_STORE_END = -1;
        LAST_SELECT = 0;
        LAST_SELECT_END = -1;
        LABEL_BASE = LABEL_COUNT + 1;
        LABEL_COUNT += ORDER.count;
        EPILOGUE_LABEL = new_label();
        EPILOGUE_USED = false;
        FELL_INTO_EPILOGUE = false;
        HAS_FRAME = SAVE >= 0;
        ir_function_start(fn_symbol_prefix(f), FNS[f].name, fn_is_global(f), SAVE == 0);
        CUR_IN_FRAME = SAVE == 0;
        if SAVE == 0 {
            emit_frame_setup();
        }
        emit_entry_moves(fi);
        for j in 0..EMIT.count {
            emit_ir_block(EMIT.data[j], j);
        }
        // The epilogue, when a block jumps to it or the last one falls into it
        // (blocks in the frame's region only).
        if EPILOGUE_USED || FELL_INTO_EPILOGUE {
            CUR_IN_FRAME = true;
            emit_label(EPILOGUE_LABEL);
            emit_ir_epilogue();
        }
        if STATS > 0 {
            if HAS_FRAME {
                ST_FN[ST_FRAMES] = 1;
                ST_FN[ST_FRAME] = FRAME_TOTAL + 16;
            }
            for r in 0..64 {
                if CALLEE_USED[r] != 0 {
                    ST_FN[ST_SAVES] += 1;
                }
            }
            st_function_done(fi);
        }
        buf_bytes(ASM, buf_slice(CODE));
    }
}

// Whether a jump to the epilogue was emitted.
static mut EPILOGUE_USED: bool = false;

// Whether the code emitted last returns, in the frame's region, by
// falling into the epilogue.
static mut FELL_INTO_EPILOGUE: bool = false;

// Whether the function being emitted has a frame.
static mut HAS_FRAME: bool = false;

fn emit_ir_epilogue() {
    unsafe {
        if !CUR_IN_FRAME {
            ins(c"ret");
            return;
        }
        save_callee_saved(true);
        if !HAS_FRAME {
            ins(c"ret");
        } else if X86 {
            x64_epilogue();
        } else {
            a64_epilogue();
        }
    }
}

// A return from a block that is not the last: the epilogue itself when it
// is short (at most 4 registers to restore), else a jump to it.
fn emit_return() {
    if !CUR_IN_FRAME {
        unsafe { ins(c"ret"); }
        return;
    }
    let mut saved = 0;
    for r in 0..64 {
        if CALLEE_USED[r] != 0 {
            saved += 1;
        }
    }
    if saved <= 4 {
        emit_ir_epilogue();
    } else {
        EPILOGUE_USED = true;
        m_jump(EPILOGUE_LABEL);
    }
}

// The number of instructions of function fi.
fn function_size(fi: i64) -> i64 {
    unsafe {
        let mut n = 0;
        for i in 0..ORDER.count {
            let mut v = BLOCKS[ORDER.data[i]].first;
            while v != 0 {
                n += 1;
                v = INSTS[v].next;
            }
        }
        n
    }
}

// Whether function fi has parameters on the stack (read from the frame
// pointer: the frame is then set up at its entry).
fn has_stack_params(fi: i64) -> bool {
    unsafe {
        let f = IRFUNCS[fi].f;
        let mut locations: [i64; 64] = [0; 64];
        let mut pieces: [i64; 256] = [0; 256];
        if FNS[f].param_count > 64 {
            return true;
        }
        param_locations(f, &locations as *i64, &pieces as *i64);
        let mut v = BLOCKS[IRFUNCS[fi].entry].first;
        while v != 0 {
            if INSTS[v].op == Param && INSTS[v].imm >= 0 {
                let index = INSTS[v].imm;
                let piece = INSTS[v].imm2;
                let location = if piece > 0 { pieces[4 * index + piece - 1] } else { locations[index] };
                if piece < 0 || xl_is_stack(location) {
                    return true;
                }
            }
            v = INSTS[v].next;
        }
        false
    }
}

// ---- Shrink-wrapping ----
//
// The frame (the saved frame pointer and return address, the reserved
// area, the saved callee-saved registers) is set up at the start of block
// SAVE (a layout index): the nearest common dominator of the blocks that
// need it (a call, a frame slot, a value in a callee-saved register or on
// the stack, see mark_frame_blocks), moved up the dominator tree out of
// loops. Its region is the blocks it dominates; a jump out of the region
// (with critical edges split, only a block ending in a jump leaves it)
// tears the frame down after the edge's moves, and the blocks outside run
// without a frame: no path re-enters the region but through SAVE, and
// SAVE is in no loop, so the frame is set up and torn down at most once.
// Blocks outside return with a bare `ret`; a block outside that ends in a
// call that does not return (a panic) links a frame of its own first
// (x86-64 calls need an aligned stack). SAVE is 0 (the entry) when the frame is set up with the
// function, -1 when it has none. Functions calling setjmp and the like,
// realigning their frame or taking parameters on the stack keep theirs
// at the entry.
static mut SAVE: i64 = -1;
// Per layout index: whether the block runs with the frame set up, and its
// immediate dominator.
static mut IN_FRAME: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut SW_IDOM: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Whether the block being emitted runs with the frame set up.
static mut CUR_IN_FRAME: bool = true;

// Whether block b ends in a call that does not return, passing nothing
// on the stack (its frame can be its own).
fn is_noreturn_call_block(b: i64) -> bool {
    unsafe {
        let v = BLOCKS[b].last;
        BLOCKS[b].term == Term::Unreach && v != 0 && INSTS[v].op.is_call() && call_stack_size(v) == 0
    }
}

fn sw_intersect(a: i64, b: i64) -> i64 {
    unsafe {
        let mut x = a;
        let mut y = b;
        while x != y {
            while x > y {
                x = SW_IDOM.data[x];
            }
            while y > x {
                y = SW_IDOM.data[y];
            }
        }
        x
    }
}

// Whether layout index a dominates layout index x.
fn sw_dominates(a: i64, x: i64) -> bool {
    let mut y = x;
    while y > a {
        unsafe { y = SW_IDOM.data[y]; }
    }
    y == a
}

// Dominators over the layout (a reverse post-order): Cooper, Harvey and
// Kennedy's iteration.
fn sw_dominators() {
    unsafe {
        let n = ORDER.count;
        SW_IDOM.count = 0;
        for k in 0..n {
            SW_IDOM.push(if k == 0 { 0 } else { -1 });
        }
        let mut changed = true;
        while changed {
            changed = false;
            for k in 1..n {
                let b = ORDER.data[k];
                let mut idom = -1;
                for i in 0..BLOCKS[b].preds.count {
                    let pk = BLOCKS[BLOCKS[b].preds.data[i]].order;
                    if pk < 0 || SW_IDOM.data[pk] < 0 {
                        continue;
                    }
                    idom = if idom < 0 { pk } else { sw_intersect(pk, idom) };
                }
                if idom != SW_IDOM.data[k] {
                    SW_IDOM.data[k] = idom;
                    changed = true;
                }
            }
        }
    }
}

// Whether the frame can be set up at layout index s: s is in no loop, no
// block of its region leads back to it, and only jumps leave the region.
fn sw_valid(s: i64) -> bool {
    unsafe {
        if s == 0 {
            return true;
        }
        if LDEPTH.data[s] != 0 {
            return false;
        }
        for k in s..ORDER.count {
            if !sw_dominates(s, k) {
                continue;
            }
            let b = ORDER.data[k];
            for i in 0..succ_count(b) {
                let sk = BLOCKS[succ(b, i)].order;
                if sk == s || sk < 0 || (!sw_dominates(s, sk) && BLOCKS[b].term != Term::Jump) {
                    return false;
                }
            }
        }
        true
    }
}

// Tears the frame down (on a jump out of its region): restores the
// callee-saved registers, sp, the frame pointer and the return address.
fn emit_frame_teardown() {
    save_callee_saved(true);
    if X86 { mx_frame_unlink(); } else { ma_frame_unlink(); }
}

fn shrink_wrap(fi: i64) {
    unsafe {
        let n = ORDER.count;
        let mut need = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for _ in 0..n {
            need.push(0);
        }
        for k in 0..n {
            let b = ORDER.data[k];
            let mut v = BLOCKS[b].first;
            while v != 0 {
                let op = INSTS[v].op;
                if op.is_call() && is_emitted(v) && !(v == BLOCKS[b].last && is_noreturn_call_block(b)) {
                    need.data[k] = 1;
                }
                if op == Slot && is_emitted(v) {
                    need.data[k] = 1;
                }
                for i in 0..ir_operand_count(v) {
                    let u = ir_operand(v, i);
                    if u != 0 && INSTS[u].op == Slot {
                        need.data[k] = 1;
                        if op == Phi {
                            for j in 0..BLOCKS[b].preds.count {
                                let pk = BLOCKS[BLOCKS[b].preds.data[j]].order;
                                if pk >= 0 {
                                    need.data[pk] = 1;
                                }
                            }
                        }
                    }
                }
                v = INSTS[v].next;
            }
            let cond = BLOCKS[b].cond;
            if cond != 0 && INSTS[cond].op == Slot {
                need.data[k] = 1;
            }
        }
        mark_frame_blocks(need.data);
        let mut any = false;
        for k in 0..n {
            if need.data[k] != 0 {
                any = true;
            }
        }
        if RETURNS_TWICE || FRAME_ALIGN > 16 || has_stack_params(fi) || (FRAME_TOTAL > 0 && !any) {
            need.data[0] = 1;
            any = true;
        }
        IN_FRAME.count = 0;
        for _ in 0..n {
            IN_FRAME.push(0);
        }
        SAVE = -1;
        if any {
            sw_dominators();
            let mut s = -1;
            for k in 0..n {
                if need.data[k] != 0 {
                    s = if s < 0 { k } else { sw_intersect(s, k) };
                }
            }
            while !sw_valid(s) {
                s = SW_IDOM.data[s];
            }
            SAVE = s;
            for k in 0..n {
                if sw_dominates(s, k) {
                    IN_FRAME.data[k] = 1;
                }
            }
        }
        free(need.data as *u8);
    }
}

// Links a frame: saves the frame pointer and the return address.
fn emit_frame_link() {
    if X86 { mx_frame_link(); } else { ma_frame_link(); }
}

// Reserves the frame's area, realigns it, saves the callee-saved
// registers.
fn emit_frame_setup() {
    unsafe {
        if FRAME_TOTAL > 0 {
            if X86 { x64_frame_reserve(FRAME_TOTAL); } else { a64_frame_reserve(FRAME_TOTAL); }
            if FRAME_ALIGN > 16 {
                // The frame is addressed from sp: aligned, its slots are (the
                // epilogue restores sp from the frame pointer).
                if X86 {
                    x64_imm(c"andq", 0 - FRAME_ALIGN, c"%rsp");
                } else {
                    ins(c"mov x16, sp");
                    a64_align_down(16, FRAME_ALIGN);
                    ins(c"mov sp, x16");
                }
            }
        }
        save_callee_saved(false);
    }
}

// The function's label (as the shared emit_function_start writes it), and
// the saving of the frame pointer and return address when it has a frame.
fn ir_function_start(prefix: *u8, name: i64, global: bool, frame: bool) {
    unsafe {
        emit_function_start(prefix, name, global);
        if frame {
            return;
        }
        let prologue = if X86 { c"    pushq %rbp\n    movq %rsp, %rbp\n" } else { c"    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n" };
        let n = strlen(prologue) as i64;
        let len = BUFS[ASM].len;
        if len < n || memcmp(&BUFS[ASM].data[len - n], prologue, n as u64) != 0 {
            die(c"internal error: unexpected function prologue");
        }
        BUFS[ASM].len = len - n;
    }
}

// Per layout index: whether the block emits nothing but a jump.
static mut TRIVIAL: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn find_trivial_jumps() {
    TRIVIAL.count = 0;
    for k in 0..ORDER.count {
        TRIVIAL.push(if unsafe { is_trivial_jump_now(ORDER.data[k]) } { 1 } else { 0 });
    }
}

// Whether block b emits nothing but a jump: no instruction, no move.
fn is_trivial_jump_now(b: i64) -> bool {
    unsafe {
        if BLOCKS[b].term != Term::Jump || b == IRFUNCS[IRF].entry || BLOCKS[b].order == SAVE {
            return false;
        }
        // A jump out of the frame's region tears the frame down.
        let sk = BLOCKS[BLOCKS[b].s0].order;
        if IN_FRAME.data[BLOCKS[b].order] != 0 && (sk < 0 || IN_FRAME.data[sk] == 0) {
            return false;
        }
        let mut v = BLOCKS[b].first;
        while v != 0 {
            let t = tracked(v);
            if is_emitted(v) || INSTS[v].op == Param || (INSTS[v].op == Phi && t >= 0 && stored_at_def(t)) {
                return false;
            }
            v = INSTS[v].next;
        }
        let k = BLOCKS[b].order;
        let i = gap_index(BSTART.data[k]);
        if i < SPLIT_MOVES.count / 2 && SPLIT_MOVES.data[2 * i] <= BEND.data[k] {
            return false;
        }
        plan_start_moves(b);
        plan_end_moves(b);
        let mut empty = true;
        for j in 0..PM.count / PM_FIELDS {
            if pm_kind(j) != PM_LOC || pm_dst(j) != pm_src(j) {
                empty = false;
            }
        }
        PM.count = 0;
        empty
    }
}

fn is_trivial_jump(b: i64) -> bool {
    unsafe { BLOCKS[b].order >= 0 && TRIVIAL.data[BLOCKS[b].order] != 0 }
}

// Where a jump to b really goes: past blocks that only jump on (b itself
// when the chain does not end, in an empty endless loop).
pub fn jump_target(b: i64) -> i64 {
    unsafe {
        let mut target = b;
        for _ in 0..16 {
            if target == IRFUNCS[IRF].entry || !is_trivial_jump(target) {
                return target;
            }
            target = BLOCKS[target].s0;
        }
        b
    }
}

// Blocks every jump passes by are not emitted at all.
pub fn is_skipped(b: i64) -> bool {
    unsafe { b != IRFUNCS[IRF].entry && is_trivial_jump(b) && jump_target(b) != b }
}

// The block emitted after the one at index j of the emission order, or 0.
fn next_block(j: i64) -> i64 {
    if j + 1 < EMIT.count { unsafe { EMIT.data[j + 1] } } else { 0 }
}

fn emit_ir_block(b: i64, j: i64) {
    emit_label(block_label(b));
    emit_block_code(b, next_block(j));
}

// Tail duplication: a jump to a small block (at most 3 instructions, no
// call, ending in a jump, a branch or a return) emits a copy of the block
// instead, up to 2 deep. The copy is exact: a block's code depends on its
// allocation (its positions) only, and the moves of the edge into it are
// already done.
static mut DUP_DEPTH: i64 = 0;

fn is_duplicable(b: i64) -> bool {
    unsafe {
        let term = BLOCKS[b].term;
        if b == IRFUNCS[IRF].entry || BLOCKS[b].order == SAVE || (term != Term::Jump && term != Term::Branch && term != Term::Ret) {
            return false;
        }
        let mut n = 0;
        let mut v = BLOCKS[b].first;
        while v != 0 {
            if INSTS[v].op.is_call() || INSTS[v].op == Piece || INSTS[v].op == Select && X86 {
                return false;
            }
            if is_emitted(v) && !is_fused_compare(v) {
                n += 1;
            }
            v = INSTS[v].next;
        }
        n <= 3
    }
}

// The code of block b (without its label); `next` is the block emitted
// after it (0: none, -1: a copy, which nothing follows).
fn emit_block_code(b: i64, next: i64) {
    unsafe {
        let k = BLOCKS[b].order;
        let outer = CUR_IN_FRAME;
        CUR_IN_FRAME = IN_FRAME.data[k] != 0;
        if SAVE > 0 && k == SAVE {
            emit_frame_link();
            emit_frame_setup();
        } else if !CUR_IN_FRAME && is_noreturn_call_block(b) {
            emit_frame_link();
        }
        emit_block_body(b, next);
        CUR_IN_FRAME = outer;
    }
}

fn emit_block_body(b: i64, next: i64) {
    unsafe {
        let k = BLOCKS[b].order;
        let start = BSTART.data[k];
        plan_start_moves(b);
        pm_resolve();
        // Phis that go to the stack are stored there.
        let mut v = BLOCKS[b].first;
        while v != 0 {
            let t = tracked(v);
            if INSTS[v].op == Phi && t >= 0 && stored_at_def(t) {
                let loc = tloc(t, start);
                if loc >= 0 {
                    result_done(v, loc);
                }
            }
            v = INSTS[v].next;
        }
        v = BLOCKS[b].first;
        while v != 0 {
            let op = INSTS[v].op;
            if op != Phi && op != Param {
                CUR_POS = INSTS[v].mark;
                plan_gap_moves(CUR_POS - 1);
                pm_resolve();
                if is_emitted(v) && !is_fused_compare(v) {
                    emit_inst(v);
                }
            }
            v = INSTS[v].next;
        }
        if TAIL_CALLED {
            // The callee returns for this block.
            TAIL_CALLED = false;
            return;
        }
        let end = BEND.data[k];
        CUR_POS = end;
        plan_gap_moves(end - 1);
        pm_resolve();
        let term = BLOCKS[b].term;
        if term == Term::Jump {
            let s = BLOCKS[b].s0;
            let before = ST_FN[ST_MOVES] + ST_FN[ST_SPILLS] + ST_FN[ST_RELOADS];
            plan_end_moves(b);
            pm_resolve();
            if BLOCKS[s].order <= k {
                ST_FN[ST_BACK] += ST_FN[ST_MOVES] + ST_FN[ST_SPILLS] + ST_FN[ST_RELOADS] - before;
            }
            let target = jump_target(s);
            if CUR_IN_FRAME && IN_FRAME.data[BLOCKS[target].order] == 0 {
                emit_frame_teardown();
            }
            if target != next {
                if DUP_DEPTH < 2 && is_duplicable(target) {
                    DUP_DEPTH += 1;
                    // The copy ends where this block does: its next block follows.
                    emit_block_code(target, next);
                    DUP_DEPTH -= 1;
                } else {
                    m_jump(block_label(target));
                }
            }
        } else if term == Term::Branch {
            emit_branch(b, next);
        } else if term == Term::Switch {
            emit_switch(b);
        } else if term == Term::Ret {
            let value = BLOCKS[b].cond;
            let ret = FNS[IRFUNCS[IRF].f].ret;
            let c = fn_uses_c(IRFUNCS[IRF].f);
            if value != 0 && INSTS[value].op == Pack {
                // The pieces of an aggregate result, into the result registers.
                conv_classify(c, ret);
                for i in 0..INSTS[value].nargs {
                    pm_add_value(conv_return_piece_reg(c, i), ir_arg(value, i), end);
                }
                pm_resolve();
            } else if value != 0 && is_compound(ret) && !conv_returns_through_pointer(c, ret) {
                // An aggregate returned in registers: its pieces, from its
                // address (out of the way of the result registers).
                conv_classify(c, ret);
                let mut offset = 0;
                let mut base = mem_base_any(value, 0, end, &offset);
                for i in 0..ABI_PIECE_COUNT {
                    if base == conv_return_piece_reg(c, i) {
                        m_mov(reg_move_temp(false), base, TY_U64);
                        base = reg_move_temp(false);
                    }
                }
                for i in 0..ABI_PIECE_COUNT {
                    m_load(ABI_PIECE_TY[i], conv_return_piece_reg(c, i), base, offset + ABI_PIECE_OFFSET[i]);
                }
            } else if value != 0 {
                use_into(value, end, reg_ret(is_float(INSTS[value].ty)));
            }
            if next != 0 || !CUR_IN_FRAME {
                emit_return();
            } else {
                FELL_INTO_EPILOGUE = true;
            }
        } else {
            m_trap();
        }
    }
}

fn emit_branch(b: i64, next: i64) {
    unsafe {
        let cond = BLOCKS[b].cond;
        // Branches have no phi moves (edges into phis are split), so they can
        // skip blocks that only jump on.
        let s0 = jump_target(BLOCKS[b].s0);
        let s1 = jump_target(BLOCKS[b].s1);
        // Jump to `target` when the condition is `sense`, fall through or jump
        // to `other` otherwise.
        let mut target = s0;
        let mut other = s1;
        let mut sense = true;
        if s0 == next {
            target = s1;
            other = s0;
            sense = false;
        }
        if is_fused_compare(cond) && INSTS[cond].op == Test {
            let mut op = INSTS[cond].cond;
            if !sense {
                op = op.negate();
            }
            let a = int_operand(INSTS[cond].a);
            let b = if INSTS[cond].b != 0 { int_operand(INSTS[cond].b) } else { -1 };
            if X86 {
                mx_test_branch(a, b, INSTS[cond].imm, op == Cond::Ne, block_label(target));
            } else {
                ma_test_branch(a, b, INSTS[cond].imm, op == Cond::Ne, block_label(target));
            }
        } else if is_fused_compare(cond) {
            let mut op = INSTS[cond].cond;
            if !sense {
                op = op.negate();
            }
            let ty = INSTS[cond].imm2;
            let a = int_operand(INSTS[cond].a);
            let mut imm = 0;
            let rhs = INSTS[cond].b;
            if const_of(rhs, &imm) && fits_cmp_imm(imm) {
                m_cmp_branch(op, ty, a, 0, true, imm, block_label(target));
            } else {
                let r = int_operand(rhs);
                m_cmp_branch(op, ty, a, r, false, 0, block_label(target));
            }
        } else {
            let r = int_operand(cond);
            m_branch_bool(r, sense, block_label(target));
        }
        if other != next {
            m_jump(block_label(other));
        }
    }
}

// ---- Switches ----

// The cases of the switch being emitted, sorted by value (in the order of
// the switch's type): value and label.
static mut SW_VALUES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut SW_LABELS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// A switch: a jump table when its cases are dense (at least 4, filling at
// least a third of their range), else a binary search. Like branches,
// switches have no phi moves (edges into phis are split).
fn emit_switch(b: i64) {
    unsafe {
        let cond = BLOCKS[b].cond;
        let ty = INSTS[cond].ty;
        let n = BLOCKS[b].ncases;
        SW_VALUES.count = 0;
        SW_LABELS.count = 0;
        for i in 0..n {
            // Insertion in order of the keys (see int_key).
            let key = int_key(case_value(b, i), ty);
            let mut at = SW_VALUES.count;
            SW_VALUES.push(0);
            SW_LABELS.push(0);
            while at > 0 && int_key(SW_VALUES.data[at - 1], ty) > key {
                SW_VALUES.data[at] = SW_VALUES.data[at - 1];
                SW_LABELS.data[at] = SW_LABELS.data[at - 1];
                at -= 1;
            }
            SW_VALUES.data[at] = case_value(b, i);
            SW_LABELS.data[at] = block_label(jump_target(case_target(b, i)));
        }
        let default = block_label(jump_target(BLOCKS[b].s0));
        let r = int_operand(cond);
        if n == 0 {
            m_jump(default);
            return;
        }
        let low = SW_VALUES.data[0];
        let range = int_key(SW_VALUES.data[n - 1], ty) - int_key(low, ty) + 1;
        if n >= 4 && range > 0 && range <= 3 * n && range <= 4096 {
            // One entry per value of the range: the case's label or the default.
            let table = alloc_array::<i64>(range);
            for i in 0..range {
                table[i] = default;
            }
            for i in 0..n {
                table[SW_VALUES.data[i] - low] = SW_LABELS.data[i];
            }
            if X86 {
                mx_jump_table(r, low, range, default, table);
            } else {
                ma_jump_table(r, low, range, default, table);
            }
            free(table as *u8);
            return;
        }
        emit_switch_search(r, ty, 0, n, default);
    }
}

// Compares and branches for the cases lo..hi (sorted), by halves.
fn emit_switch_search(r: i64, ty: i64, lo: i64, hi: i64, default: i64) {
    unsafe {
        if hi - lo <= 3 {
            for i in lo..hi {
                switch_compare(Cond::Eq, ty, r, SW_VALUES.data[i], SW_LABELS.data[i]);
            }
            m_jump(default);
            return;
        }
        let mid = (lo + hi) / 2;
        switch_compare(Cond::Eq, ty, r, SW_VALUES.data[mid], SW_LABELS.data[mid]);
        let right = new_label();
        switch_compare(Cond::Gt, ty, r, SW_VALUES.data[mid], right);
        emit_switch_search(r, ty, lo, mid, default);
        emit_label(right);
        emit_switch_search(r, ty, mid + 1, hi, default);
    }
}

// Jumps to `label` when register r <op> value.
fn switch_compare(op: Cond, ty: i64, r: i64, value: i64, label: i64) {
    if fits_cmp_imm(value) {
        m_cmp_branch(op, ty, r, 0, true, value, label);
    } else {
        let scratch = reg_move_temp(false);
        m_load_imm(scratch, value as u64);
        m_cmp_branch(op, ty, r, scratch, false, 0, label);
    }
}

pub fn fits_cmp_imm(imm: i64) -> bool {
    // AArch64: cmp #imm, or cmn #-imm for a negative one.
    if X86 { fits_i32(imm) } else { imm > -4096 && imm < 4096 }
}

// Whether comparison v (CMP) compares integers with a constant that fits
// an immediate.
pub fn is_cmp_imm_operand(v: i64) -> bool {
    unsafe {
        let b = INSTS[v].b;
        !is_float(INSTS[v].imm2) && b != 0 && INSTS[b].op == Const && fits_cmp_imm(INSTS[b].imm)
    }
}

// ---- Instructions ----

fn emit_inst(v: i64) {
    unsafe {
        let op = INSTS[v].op;
        if op.is_remat() {
            materialize(v, result_reg(v));
        } else if op.is_binary() {
            emit_binary(v);
        } else if op == Neg || op == Not || op == BNot {
            let a = operand_reg(INSTS[v].a);
            let r = result_reg(v);
            m_unary(op, INSTS[v].ty, r, a);
            result_done(v, r);
        } else if op == Cmp && is_cmp_imm_operand(v) {
            let ty = INSTS[v].imm2;
            let a = operand_reg(INSTS[v].a);
            let r = result_reg(v);
            if X86 {
                mx_cmp_imm(INSTS[v].cond, ty, r, a, INSTS[INSTS[v].b].imm);
            } else {
                ma_cmp_imm(INSTS[v].cond, ty, r, a, INSTS[INSTS[v].b].imm);
            }
            result_done(v, r);
        } else if op == Cmp {
            let ty = INSTS[v].imm2;
            let a = operand_reg(INSTS[v].a);
            let b = operand_reg(INSTS[v].b);
            let r = result_reg(v);
            m_cmp(INSTS[v].cond, ty, r, a, b);
            result_done(v, r);
        } else if op == Conv {
            let a = operand_reg(INSTS[v].a);
            let r = result_reg(v);
            m_conv(INSTS[v].imm2, INSTS[v].ty, r, a);
            result_done(v, r);
        } else if op == Load {
            emit_load_inst(v);
        } else if op == Store {
            emit_store_inst(v);
        } else if op == Copy {
            let dst = int_operand(INSTS[v].a);
            let src = int_operand(INSTS[v].b);
            m_copy(dst, src, INSTS[v].imm);
        } else if op.is_call() {
            emit_call_inst(v);
        } else if op == LoadX || op == StoreX || op == Lea {
            emit_indexed(v);
        } else if op == Select {
            emit_select(v);
        } else if op == FMath {
            let a = operand_reg(INSTS[v].a);
            let r = result_reg(v);
            if X86 {
                mx_sqrt(INSTS[v].ty, r, a);
            } else {
                ma_fmath(INSTS[v].imm, INSTS[v].ty, r, a);
            }
            result_done(v, r);
        } else if op == MAdd || op == MSub || op == ShOp || op == Ubfx {
            // AArch64 only (see isel.tach).
            let a = operand_reg(INSTS[v].a);
            let b = if INSTS[v].b != 0 { operand_reg(INSTS[v].b) } else { -1 };
            let r = result_reg(v);
            if op == Ubfx {
                ma_ubfx(r, a, INSTS[v].imm, INSTS[v].imm2);
            } else if op == ShOp {
                ma_shop(INSTS[v].imm2, INSTS[v].ty, r, a, b, INSTS[v].imm);
            } else {
                ma_madd(op == MSub, INSTS[v].ty, r, a, b, operand_reg(INSTS[v].c));
            }
            result_done(v, r);
        } else {
            die(c"internal error: unexpected instruction in emission");
        }
    }
}

// LOADX, STOREX and LEA: base + (index << scale) + offset (the base a frame
// slot from sp on x86-64).
fn emit_indexed(v: i64) {
    unsafe {
        let op = INSTS[v].op;
        let mut offset = INSTS[v].imm;
        let base_value = INSTS[v].a;
        let mut base = 0;
        if INSTS[base_value].op == Slot {
            offset += SLOTS[INSTS[base_value].imm].offset;
            base = reg_sp();
        } else {
            base = int_operand(base_value);
        }
        MEM_INDEX = if INSTS[v].b != 0 { int_operand(INSTS[v].b) } else { -1 };
        MEM_SCALE = INSTS[v].scale;
        if op == StoreX {
            let r = operand_reg(INSTS[v].c);
            m_store(INSTS[v].imm2, r, base, offset);
            MEM_INDEX = -1;
            return;
        }
        let r = result_reg(v);
        if op == LoadX {
            m_load(INSTS[v].ty, r, base, offset);
        } else {
            m_lea(r, base, offset);
        }
        MEM_INDEX = -1;
        result_done(v, r);
    }
}

// The last select emitted, and the length of the code after it.
static mut LAST_SELECT: i64 = 0;
static mut LAST_SELECT_END: i64 = 0;

// SELECT: the comparison (or test) of its last operands, then a conditional
// select of its first two.
fn emit_select(v: i64) {
    unsafe {
        let lhs = operand_reg(ir_arg(v, 0));
        let rhs = if ir_arg(v, 1) != 0 { operand_reg(ir_arg(v, 1)) } else { -1 };
        // (-1: xzr, see use_kind.)
        let then = if !X86 && is_zero_operand(INSTS[v].a) { -1 } else { operand_reg(INSTS[v].a) };
        let other = if !X86 && is_zero_operand(INSTS[v].b) { -1 } else { operand_reg(INSTS[v].b) };
        let r = result_reg(v);
        let test = (INSTS[v].scale & 1) == 1;
        if X86 {
            // The flags of the select just before, when it compared the same and
            // nothing was emitted since (a rematerialized 0 is an xorl).
            let p = INSTS[v].prev;
            let same = p != 0 && p == LAST_SELECT && BUFS[CODE].len == LAST_SELECT_END && ir_arg(p, 0) == ir_arg(v, 0)
                && ir_arg(p, 1) == ir_arg(v, 1) && INSTS[p].imm == INSTS[v].imm && INSTS[p].imm2 == INSTS[v].imm2
                && INSTS[p].scale == INSTS[v].scale;
            mx_select(INSTS[v].cond, test, !same, INSTS[v].imm2, lhs, rhs, INSTS[v].imm, r, then, other);
            LAST_SELECT = v;
            LAST_SELECT_END = BUFS[CODE].len;
        } else {
            // The flags of the select just before, when it compared the same
            // (nothing between them on AArch64 touches the flags: moves,
            // loads, stores and rematerializations do not).
            let p = INSTS[v].prev;
            let same = p != 0 && INSTS[p].op == Select && ir_arg(p, 0) == ir_arg(v, 0) && ir_arg(p, 1) == ir_arg(v, 1)
                && INSTS[p].imm == INSTS[v].imm && INSTS[p].imm2 == INSTS[v].imm2
                && (INSTS[p].scale & 1) == (INSTS[v].scale & 1);
            ma_select(INSTS[v].cond, test, !same, INSTS[v].imm2, lhs, rhs, INSTS[v].imm, INSTS[v].ty, r, then, other,
                (INSTS[v].scale & 2) != 0);
        }
        result_done(v, r);
    }
}

fn emit_binary(v: i64) {
    unsafe {
        let op = INSTS[v].op;
        let ty = INSTS[v].ty;
        if is_float(ty) {
            let a = float_operand(INSTS[v].a);
            let b = float_operand(INSTS[v].b);
            let r = result_reg(v);
            m_float_op(op, ty, r, a, b);
            result_done(v, r);
            return;
        }
        let a = int_operand(INSTS[v].a);
        let r = result_reg(v);
        let mut imm = 0;
        if use_kind(v, 1) == USE_NONE && const_of(INSTS[v].b, &imm) {
            if !m_int_op_imm(op, ty, r, a, imm) {
                die(c"internal error: an immediate operand that does not fit");
            }
            result_done(v, r);
            return;
        }
        let b = int_operand(INSTS[v].b);
        if op == Div || op == Rem {
            let is_const = const_of(INSTS[v].b, &imm);
            m_div(op, ty, r, a, b, imm, is_const);
        } else {
            m_int_op(op, ty, r, a, b);
        }
        result_done(v, r);
    }
}

// The base register and offset of a memory access to `addr` + `offset`
// (an operand needed in a register): frame slots are addressed from sp
// directly.
fn mem_base(addr: i64, offset: i64, out_offset: *i64) -> i64 {
    unsafe {
        if INSTS[addr].op == Slot {
            *out_offset = SLOTS[INSTS[addr].imm].offset + offset;
            return reg_sp();
        }
        *out_offset = offset;
        int_operand(addr)
    }
}

// The same for an address used at `pos` where it may be anywhere (loaded
// into the parallel moves' temporary then).
fn mem_base_any(addr: i64, offset: i64, pos: i64, out_offset: *i64) -> i64 {
    unsafe {
        if INSTS[addr].op == Slot {
            *out_offset = SLOTS[INSTS[addr].imm].offset + offset;
            return reg_sp();
        }
        *out_offset = offset;
        use_any(addr, pos, reg_move_temp(false))
    }
}

fn emit_load_inst(v: i64) {
    unsafe {
        let mut offset = 0;
        let base = mem_base(INSTS[v].a, INSTS[v].imm, &offset);
        let r = result_reg(v);
        m_load(INSTS[v].ty, r, base, offset);
        result_done(v, r);
    }
}

fn emit_store_inst(v: i64) {
    unsafe {
        let mut offset = 0;
        let base = mem_base(INSTS[v].a, INSTS[v].imm, &offset);
        let value = INSTS[v].b;
        let r = operand_reg(value);
        m_store(INSTS[v].imm2, r, base, offset);
    }
}

// ---- Calls ----

// The function type called by call v: its parameters and result (0 for
// the C library functions of Op::CallC, whose arguments are scalars).
fn callee_param_count(v: i64) -> i64 {
    unsafe {
        let op = INSTS[v].op;
        if op == Call { return FNS[INSTS[v].imm].param_count; }
        if op == CallI { return TYPES[INSTS[v].imm].count; }
        0
    }
}

fn callee_param(v: i64, i: i64) -> i64 {
    unsafe {
        if INSTS[v].op == Call { fn_param(INSTS[v].imm, i) } else { type_elem(INSTS[v].imm, i) }
    }
}

pub fn callee_result(v: i64) -> i64 {
    unsafe {
        let op = INSTS[v].op;
        if op == Call { return FNS[INSTS[v].imm].ret; }
        if op == CallI { return TYPES[INSTS[v].imm].a; }
        0
    }
}

// The location of each argument (IR operand) of call `v` (in
// `locations`), and for aggregates copied onto the stack their size (in
// `copies`, 0 otherwise); returns the size of its stack area, and the
// float registers used in `float_regs`.
pub fn call_locations(v: i64, locations: *i64, copies: *i64, float_regs: *i64) -> i64 {
    unsafe {
        if !call_uses_c(v) {
            return t_call_locations(v, locations, copies, float_regs);
        }
        let mut state: [i64; 3] = [first_int_arg(callee_result(v)), 0, 0];
        let mut j = 0;
        for i in 0..callee_param_count(v) {
            let ty = callee_param(v, i);
            if is_void(ty) {
                continue;
            }
            let kind = abi_classify(ty);
            if kind == AbiClass::Pieces {
                abi_piece_locations(ty, &state as *i64, &locations[j]);
                for k in 0..ABI_PIECE_COUNT {
                    copies[j + k] = 0;
                }
                j += ABI_PIECE_COUNT;
            } else if kind == AbiClass::Stack {
                locations[j] = abi_stack_location(ty, &state as *i64);
                copies[j] = type_size(ty);
                j += 1;
            } else {
                locations[j] = arg_location(if kind == AbiClass::Ref { TY_U64 } else { scalar_type(ty) }, &state as *i64);
                copies[j] = 0;
                j += 1;
            }
        }
        // The `...` arguments, and the arguments of C library functions.
        while j < INSTS[v].nargs {
            let ty = ARGTY.data[INSTS[v].args + j];
            copies[j] = 0;
            if ty < 0 && is_compound(0 - ty) {
                let t = 0 - ty;
                let kind = variadic_kind(t);
                if kind == AbiClass::Pieces {
                    abi_variadic_piece_locations(t, &state as *i64, &locations[j]);
                    for k in 0..ABI_PIECE_COUNT {
                        copies[j + k] = 0;
                    }
                    j += ABI_PIECE_COUNT;
                } else if kind == AbiClass::Stack {
                    locations[j] = abi_stack_location(t, &state as *i64);
                    copies[j] = type_size(t);
                    j += 1;
                } else {
                    locations[j] = variadic_arg_location(TY_U64, &state as *i64);
                    j += 1;
                }
                continue;
            }
            if ty < 0 {
                locations[j] = variadic_arg_location(0 - ty, &state as *i64);
            } else {
                locations[j] = arg_location(ty, &state as *i64);
            }
            j += 1;
        }
        for i in 0..j {
            locations[i] = xl_from_c(locations[i]);
        }
        *float_regs = state[1];
        align_to(state[2], 16)
    }
}

// call_locations for a call under the tachyon convention.
fn t_call_locations(v: i64, locations: *i64, copies: *i64, float_regs: *i64) -> i64 {
    unsafe {
        let first = if conv_returns_through_pointer(false, callee_result(v)) { 1 } else { 0 };
        let mut state: [i64; 3] = [first, 0, 0];
        let mut j = 0;
        for i in 0..callee_param_count(v) {
            let ty = callee_param(v, i);
            if is_void(ty) {
                continue;
            }
            let kind = tabi_classify(ty);
            if kind == AbiClass::Pieces {
                for k in 0..ABI_PIECE_COUNT {
                    locations[j] = t_arg_location(ABI_PIECE_TY[k], &state as *i64);
                    copies[j] = 0;
                    j += 1;
                }
            } else {
                locations[j] = t_arg_location(if kind == AbiClass::Ref { TY_U64 } else { scalar_type(ty) }, &state as *i64);
                copies[j] = 0;
                j += 1;
            }
        }
        if j != INSTS[v].nargs {
            die(c"internal error: arguments of a tachyon call");
        }
        *float_regs = state[1];
        align_to(state[2], 16)
    }
}

fn call_stack_size(v: i64) -> i64 {
    unsafe {
        if INSTS[v].nargs > 64 {
            die(c"too many arguments (at most 64 are supported)");
        }
        let mut locations: [i64; 64] = [0; 64];
        let mut copies: [i64; 64] = [0; 64];
        let mut float_regs = 0;
        call_locations(v, &locations as *i64, &copies as *i64, &float_regs)
    }
}

// Whether the block being emitted ended in a tail call (its return is then
// the callee's).
static mut TAIL_CALLED: bool = false;
// Whether the function being emitted uses frame slots (whose addresses a
// callee could hold: no tail calls then).
static mut USES_SLOTS: bool = false;

// Whether call v is a sibling call (at -O2): the last instruction of a
// block returning its result (or nothing), from a tachyon function, to a
// non-variadic callee taking no argument on the stack and returning no
// aggregate, with the same result type, in a function whose frame no
// callee can see.
fn is_tail_call(v: i64) -> bool {
    unsafe {
        let op = INSTS[v].op;
        let b = INSTS[v].block;
        if OPT_LEVEL < 2 || USES_SLOTS || RETURNS_TWICE || (op != Call && op != CallI) || INSTS[v].next != 0
            || INSTS[v].c != 0 {
            return false;
        }
        let f = IRFUNCS[IRF].f;
        let ret = FNS[f].ret;
        if FNS[f].is_extern || FNS[f].export || fn_is_global(f) || is_compound(ret) || returns_through_pointer(ret) {
            return false;
        }
        // The returning block: b, or the block b jumps to when it does
        // nothing but return (a phi of the result).
        let mut returning = b;
        let mut result = v;
        if BLOCKS[b].term == Term::Jump {
            returning = BLOCKS[b].s0;
            let mut w = BLOCKS[returning].first;
            while w != 0 {
                if INSTS[w].op != Phi && is_emitted(w) {
                    return false;
                }
                if w == BLOCKS[returning].cond {
                    if INSTS[w].op != Phi {
                        return false;
                    }
                    result = w;
                    if ir_arg(w, pred_index(returning, b)) != v {
                        return false;
                    }
                }
                w = INSTS[w].next;
            }
        }
        if BLOCKS[returning].term != Term::Ret {
            return false;
        }
        let value = BLOCKS[returning].cond;
        if value != 0 && (value != result || INSTS[v].ty != ir_type(ret)) {
            return false;
        }
        if value == 0 && !is_void(ret) {
            return false;
        }
        if op == Call && FNS[INSTS[v].imm].variadic {
            return false;
        }
        call_stack_size(v) == 0
    }
}

// The pieces of call v's aggregate result (see add_piece_defs): from the
// result registers to their locations (narrow integers normalized).
fn emit_call_pieces(v: i64, c: bool, ret: i64) {
    unsafe {
        let mut w = INSTS[v].next;
        let mut any = false;
        while w != 0 {
            if INSTS[w].op == Piece && INSTS[w].a == v && tracked(w) >= 0 {
                if !any {
                    conv_classify(c, ret);
                    any = true;
                }
                let ty = INSTS[w].ty;
                let reg = conv_return_piece_reg(c, INSTS[w].imm);
                if ty == TY_BOOL || (is_integer(ty) && int_bits(ty) < 64) {
                    m_normalize(reg, if ty == TY_BOOL { TY_U8 } else { ty });
                }
                pm_add(vloc(w, CUR_POS + 2), PM_LOC, reg, ty, 0, w);
            }
            w = INSTS[w].next;
        }
        if !any {
            return;
        }
        pm_resolve();
        w = INSTS[v].next;
        while w != 0 {
            if INSTS[w].op == Piece && INSTS[w].a == v && tracked(w) >= 0 {
                result_done(w, vloc(w, CUR_POS + 2));
            }
            w = INSTS[w].next;
        }
    }
}

fn emit_call_inst(v: i64) {
    unsafe {
        let op = INSTS[v].op;
        let mut locations: [i64; 64] = [0; 64];
        let mut copies: [i64; 64] = [0; 64];
        let mut float_regs = 0;
        call_locations(v, &locations as *i64, &copies as *i64, &float_regs);
        // Stack arguments first: their sources are still intact.
        let c = call_uses_c(v);
        for i in 0..INSTS[v].nargs {
            let location = locations[i];
            if !xl_is_stack(location) {
                continue;
            }
            let arg = ir_arg(v, i);
            if copies[i] > 0 {
                // An aggregate copied onto the stack, in 8-byte pieces (its
                // private copy is a multiple of 8 bytes), through registers no
                // value is allocated to.
                let mut offset = 0;
                let src = mem_base_any(arg, 0, CUR_POS, &offset);
                let temp = reg_cycle(false);
                let mut k = 0;
                while k < copies[i] {
                    m_load(TY_U64, temp, src, offset + k);
                    m_store(TY_U64, temp, reg_sp(), xl_offset(location) + k);
                    k += 8;
                }
                continue;
            }
            let declared = ARGTY.data[INSTS[v].args + i];
            let variadic = declared < 0;
            let ty = if variadic { 0 - declared } else { declared };
            let value_ty = INSTS[arg].ty;
            let r = use_any(arg, CUR_POS, reg_move_temp(is_float(value_ty)));
            let mut store_ty = value_ty;
            if !is_float(value_ty) {
                // Apple's arm64 ABI packs fixed stack arguments at their size;
                // everything else takes 8 bytes.
                store_ty = TY_U64;
                if c && !X86 && !variadic && !is_compound(ty) && type_size(ty) < 8 {
                    store_ty = ty;
                }
            }
            m_store(store_ty, r, reg_sp(), xl_offset(location));
        }
        for i in 0..INSTS[v].nargs {
            let location = locations[i];
            if !xl_is_stack(location) {
                pm_add_value(arg_reg(location), ir_arg(v, i), CUR_POS);
            }
        }
        let ret = callee_result(v);
        let through_pointer = INSTS[v].c != 0 && conv_returns_through_pointer(c, ret);
        if through_pointer {
            pm_add_value(conv_result_ptr_reg(c), INSTS[v].c, CUR_POS);
        }
        if op == CallI {
            pm_add_value(reg_callee(), INSTS[v].a, CUR_POS);
        }
        pm_resolve();
        if is_tail_call(v) {
            // The frame goes, then a jump: the callee returns to our caller.
            emit_frame_teardown();
            if op == Call {
                let f = INSTS[v].imm;
                o(if X86 { c"    jmp " } else { c"    b " });
                emit_symbol_ref(fn_symbol_prefix(f), FNS[f].name);
                if X86 && ELF && (FNS[f].is_extern || FNS[f].export) {
                    o(c"@PLT");
                }
                on();
            } else {
                ins(if X86 { c"jmp *%r11" } else { c"br x16" });
            }
            TAIL_CALLED = true;
            return;
        }
        if op == Call {
            let f = INSTS[v].imm;
            emit_call(fn_symbol_prefix(f), FNS[f].name, FNS[f].is_extern || FNS[f].export, FNS[f].variadic, float_regs);
        } else if op == CallC && INSTS[v].imm == rt_panic_sym() {
            emit_call(function_prefix(), INSTS[v].imm, false, false, 0);
        } else if op == CallC {
            emit_call(global_prefix(), INSTS[v].imm, true, false, 0);
        } else if X86 {
            x64_call_indirect();
        } else {
            a64_call_indirect();
        }
        emit_call_pieces(v, c, ret);
        if INSTS[v].c != 0 && !through_pointer {
            // An aggregate result in registers: stored in pieces into its slot.
            conv_classify(c, ret);
            let mut offset = 0;
            let base = mem_base_any(INSTS[v].c, 0, CUR_POS + 2, &offset);
            for k in 0..ABI_PIECE_COUNT {
                m_store(ABI_PIECE_TY[k], conv_return_piece_reg(c, k), base, offset + ABI_PIECE_OFFSET[k]);
            }
            return;
        }
        let ty = INSTS[v].ty;
        if ty == 0 || tracked(v) < 0 {
            return;
        }
        let ret_reg = reg_ret(is_float(ty));
        if ty == TY_BOOL || (is_integer(ty) && int_bits(ty) < 64) {
            m_normalize(ret_reg, if ty == TY_BOOL { TY_U8 } else { ty });
        }
        let r = result_reg(v);
        m_mov(r, ret_reg, ty);
        result_done(v, r);
    }
}
