// x86-64 instructions (AT&T syntax) for the IR back end (emit.tach), on
// physical registers: 0-15 are the integer registers by hardware number
// (rax rcx rdx rbx rsp rbp rsi rdi r8-r15), 32 + n is xmm<n>.
//
// Use of the registers: rax, rcx, rdx, rsi, rdi, r8 and r9 (caller-saved)
// and rbx, r12-r15 (callee-saved) are allocated (division and MULH take
// rax and rdx, a shift by a register cl: the allocator keeps them free
// there);
// r10 and r11 are the temporaries inside one instruction, and of the
// parallel moves (r10 breaks cycles, r11 is the temporary and holds the
// callee of indirect calls). xmm0-xmm13 are allocated, xmm14 and xmm15 are
// the parallel moves' registers and temporaries inside one instruction.

use crate::base::buf_uint;
use crate::types::{
    TY_F32, TY_F64, TY_I16, TY_I32, TY_I8, TY_U16, TY_U32, TY_U64, TY_U8, int_bits, is_float,
    is_signed, type_size, is_vector, vec_elem, vec_lanes,
};
use crate::consteval::{f32_bits, f64_of_bits};
use crate::target::{
    CODE, emit_label, emit_symbol_ref, global_prefix, ins, local_prefix, new_label, o, oi, on,
};
use crate::x86_64::{fits_i32, x64_int_cc, x64_jcc, x64_jump};
use crate::ir::{Cond, Op};
use crate::emit::{MEM_INDEX, MEM_SCALE, m_mov};
use crate::ir::Op::{Add, And, Div, Mul, Neg, Not, Or, Rem, Shl, Shr, Sub, Xor};

fn mx_name(r: i64, size: i64) -> *u8 {
    if r >= 32 {
        return c"";
    }
    if r == 0 { return if size == 8 { c"%rax" } else if size == 4 { c"%eax" } else if size == 2 { c"%ax" } else { c"%al" }; }
    if r == 1 { return if size == 8 { c"%rcx" } else if size == 4 { c"%ecx" } else if size == 2 { c"%cx" } else { c"%cl" }; }
    if r == 2 { return if size == 8 { c"%rdx" } else if size == 4 { c"%edx" } else if size == 2 { c"%dx" } else { c"%dl" }; }
    if r == 3 { return if size == 8 { c"%rbx" } else if size == 4 { c"%ebx" } else if size == 2 { c"%bx" } else { c"%bl" }; }
    if r == 4 { return if size == 8 { c"%rsp" } else if size == 4 { c"%esp" } else if size == 2 { c"%sp" } else { c"%spl" }; }
    if r == 5 { return if size == 8 { c"%rbp" } else if size == 4 { c"%ebp" } else if size == 2 { c"%bp" } else { c"%bpl" }; }
    if r == 6 { return if size == 8 { c"%rsi" } else if size == 4 { c"%esi" } else if size == 2 { c"%si" } else { c"%sil" }; }
    if r == 7 { return if size == 8 { c"%rdi" } else if size == 4 { c"%edi" } else if size == 2 { c"%di" } else { c"%dil" }; }
    if r == 8 { return if size == 8 { c"%r8" } else if size == 4 { c"%r8d" } else if size == 2 { c"%r8w" } else { c"%r8b" }; }
    if r == 9 { return if size == 8 { c"%r9" } else if size == 4 { c"%r9d" } else if size == 2 { c"%r9w" } else { c"%r9b" }; }
    if r == 10 { return if size == 8 { c"%r10" } else if size == 4 { c"%r10d" } else if size == 2 { c"%r10w" } else { c"%r10b" }; }
    if r == 11 { return if size == 8 { c"%r11" } else if size == 4 { c"%r11d" } else if size == 2 { c"%r11w" } else { c"%r11b" }; }
    if r == 12 { return if size == 8 { c"%r12" } else if size == 4 { c"%r12d" } else if size == 2 { c"%r12w" } else { c"%r12b" }; }
    if r == 13 { return if size == 8 { c"%r13" } else if size == 4 { c"%r13d" } else if size == 2 { c"%r13w" } else { c"%r13b" }; }
    if r == 14 { return if size == 8 { c"%r14" } else if size == 4 { c"%r14d" } else if size == 2 { c"%r14w" } else { c"%r14b" }; }
    if size == 8 { c"%r15" } else if size == 4 { c"%r15d" } else if size == 2 { c"%r15w" } else { c"%r15b" }
}

// Writes register r: 64-bit name for integers (size for narrower), xmm<n>
// for floats.
fn mx_r(r: i64) {
    mx_rs(r, 8);
}

fn mx_rs(r: i64, size: i64) {
    unsafe {
        if r >= 32 {
            o(c"%xmm");
            oi(r - 32);
        } else {
            o(mx_name(r, size));
        }
    }
}

// "    <mnemonic> %a, %b\n"
fn mx_rr(mnemonic: *u8, a: i64, b: i64) {
    unsafe {
        o(c"    ");
        o(mnemonic);
        o(c" ");
        mx_r(a);
        o(c", ");
        mx_r(b);
        on();
    }
}

// "    <mnemonic> $imm, %r\n"
fn mx_ir(mnemonic: *u8, imm: i64, r: i64) {
    unsafe {
        o(c"    ");
        o(mnemonic);
        o(c" $");
        oi(imm);
        o(c", ");
        mx_r(r);
        on();
    }
}

// "<offset>(%base)"
fn mx_mem(base: i64, offset: i64) {
    unsafe {
        if offset != 0 {
            oi(offset);
        }
        o(c"(");
        mx_r(base);
        if MEM_INDEX >= 0 {
            // disp(base, index, 1 << s) (see isel.tach).
            o(c",");
            mx_r(MEM_INDEX);
            if MEM_SCALE != 0 {
                o(c",");
                oi(1 << MEM_SCALE as u64);
            }
        }
        o(c")");
    }
}

pub fn mx_mov(dst: i64, src: i64, ty: i64) {
    unsafe {
        if dst >= 32 {
            mx_rr(c"movapd", src, dst);
        } else {
            mx_rr(c"movq", src, dst);
        }
    }
}

pub fn mx_load_imm(dst: i64, value: u64) {
    unsafe {
        let signed = value as i64;
        if signed == 0 {
            o(c"    xorl ");
            mx_rs(dst, 4);
            o(c", ");
            mx_rs(dst, 4);
            on();
        } else if signed > 0 && signed <= 4294967295 {
            // movl zero-extends to 64 bits.
            o(c"    movl $");
            buf_uint(CODE, value);
            o(c", ");
            mx_rs(dst, 4);
            on();
        } else if fits_i32(signed) {
            mx_ir(c"movq", signed, dst);
        } else {
            mx_ir(c"movabsq", signed, dst);
        }
    }
}

// Through r10 (free after the cycles of a parallel move, where constants
// are rematerialized, and inside instructions).
pub fn mx_load_fimm(dst: i64, bits: i64, ty: i64) {
    unsafe {
        if bits == 0 {
            mx_rr(if ty == TY_F32 { c"xorps" } else { c"xorpd" }, dst, dst);
            return;
        }
        if ty == TY_F32 {
            o(c"    movl $");
            buf_uint(CODE, f32_bits(f64_of_bits(bits)) as u64);
            o(c", %r10d\n    movd %r10d, ");
            mx_r(dst);
            on();
        } else {
            mx_ir(c"movabsq", bits, 10);
            o(c"    movq %r10, ");
            mx_r(dst);
            on();
        }
    }
}

pub fn mx_load(ty: i64, dst: i64, base: i64, offset: i64) {
    unsafe {
        let size = type_size(ty);
        o(c"    ");
        if is_vector(ty) {
            o(c"movups ");
        } else if ty == TY_F32 {
            o(c"movss ");
        } else if ty == TY_F64 {
            o(c"movsd ");
        } else if ty == TY_I8 {
            o(c"movsbq ");
        } else if size == 1 {
            o(c"movzbl ");
        } else if ty == TY_I16 {
            o(c"movswq ");
        } else if size == 2 {
            o(c"movzwl ");
        } else if ty == TY_I32 {
            o(c"movslq ");
        } else if size == 4 {
            o(c"movl ");
        } else {
            o(c"movq ");
        }
        mx_mem(base, offset);
        o(c", ");
        if !is_float(ty) && (size == 1 || size == 2 || (size == 4 && ty != TY_I32)) && ty != TY_I8 && ty != TY_I16 {
            mx_rs(dst, 4);
        } else {
            mx_r(dst);
        }
        on();
    }
}

pub fn mx_store(ty: i64, src: i64, base: i64, offset: i64) {
    unsafe {
        let size = type_size(ty);
        o(c"    ");
        if is_vector(ty) {
            o(c"movups ");
            mx_r(src);
        } else if ty == TY_F32 {
            o(c"movss ");
            mx_r(src);
        } else if ty == TY_F64 {
            o(c"movsd ");
            mx_r(src);
        } else if size == 1 {
            o(c"movb ");
            mx_rs(src, 1);
        } else if size == 2 {
            o(c"movw ");
            mx_rs(src, 2);
        } else if size == 4 {
            o(c"movl ");
            mx_rs(src, 4);
        } else {
            o(c"movq ");
            mx_r(src);
        }
        o(c", ");
        mx_mem(base, offset);
        on();
    }
}

pub fn mx_lea(dst: i64, base: i64, offset: i64) {
    unsafe {
        o(c"    leaq ");
        mx_mem(base, offset);
        o(c", ");
        mx_r(dst);
        on();
    }
}

pub fn mx_symbol_addr(dst: i64, prefix: *u8, name: i64) {
    unsafe {
        o(c"    leaq ");
        emit_symbol_ref(prefix, name);
        o(c"(%rip), ");
        mx_r(dst);
        on();
    }
}

pub fn mx_extern_addr(dst: i64, name: i64) {
    unsafe {
        o(c"    movq ");
        emit_symbol_ref(global_prefix(), name);
        o(c"@GOTPCREL(%rip), ");
    }
    mx_r(dst);
    on();
}

pub fn mx_string_addr(dst: i64, id: i64) {
    unsafe {
        o(c"    leaq ");
        o(local_prefix());
        o(c"str.");
        oi(id);
        o(c"(%rip), ");
        mx_r(dst);
        on();
    }
}

pub fn mx_normalize(r: i64, ty: i64) {
    unsafe {
        if ty == TY_I8 {
            o(c"    movsbq ");
            mx_rs(r, 1);
        } else if ty == TY_U8 {
            o(c"    movzbl ");
            mx_rs(r, 1);
            o(c", ");
            mx_rs(r, 4);
            on();
            return;
        } else if ty == TY_I16 {
            o(c"    movswq ");
            mx_rs(r, 2);
        } else if ty == TY_U16 {
            o(c"    movzwl ");
            mx_rs(r, 2);
            o(c", ");
            mx_rs(r, 4);
            on();
            return;
        } else if ty == TY_I32 {
            o(c"    movslq ");
            mx_rs(r, 4);
        } else if ty == TY_U32 {
            o(c"    movl ");
            mx_rs(r, 4);
            o(c", ");
            mx_rs(r, 4);
            on();
            return;
        } else {
            return;
        }
        o(c", ");
        mx_r(r);
        on();
    }
}

fn mx_op_mnemonic(op: Op) -> *u8 {
    match op {
        Add => c"addq",
        Sub => c"subq",
        Mul => c"imulq",
        And => c"andq",
        Or => c"orq",
        _ => c"xorq",
    }
}

pub fn is_commutative(op: Op) -> bool {
    op == Add || op == Mul || op == And || op == Or || op == Xor
}

// d = a <op> b (for shifts, none of them is rcx).
pub fn mx_int_op(op: Op, ty: i64, d: i64, a: i64, b: i64) {
    unsafe {
        if op == Shl || op == Shr {
            // The amount is taken modulo 32 for types up to 32 bits, modulo 64
            // for 64-bit ones.
            mx_rr(c"movq", b, 1);
            mx_ir(c"andq", if int_bits(ty) == 64 { 63 } else { 31 }, 1);
            m_mov(d, a, TY_U64);
            o(c"    ");
            if op == Shl {
                o(c"shlq");
            } else if is_signed(ty) {
                o(c"sarq");
            } else {
                o(c"shrq");
            }
            o(c" %cl, ");
            mx_r(d);
            on();
        } else if d == b && d != a {
            if is_commutative(op) {
                mx_rr(mx_op_mnemonic(op), a, d);
            } else {
                mx_rr(c"movq", a, 11);
                mx_rr(mx_op_mnemonic(op), b, 11);
                mx_rr(c"movq", 11, d);
            }
        } else {
            m_mov(d, a, TY_U64);
            mx_rr(mx_op_mnemonic(op), b, d);
        }
        mx_normalize(d, ty);
    }
}

// Whether mx_int_op_imm emits `a <op> imm`.
pub fn mx_int_imm_ok(op: Op, imm: i64) -> bool {
    if op == Shl || op == Shr {
        return true;
    }
    op != Div && op != Rem && fits_i32(imm)
}

pub fn mx_int_op_imm(op: Op, ty: i64, d: i64, a: i64, imm: i64) -> bool {
    unsafe {
        if op == Shl || op == Shr {
            let amount = imm & (if int_bits(ty) == 64 { 63 } else { 31 });
            m_mov(d, a, TY_U64);
            if amount != 0 {
                mx_ir(if op == Shl { c"shlq" } else if is_signed(ty) { c"sarq" } else { c"shrq" }, amount, d);
            }
            mx_normalize(d, ty);
            return true;
        }
        if op == Div || op == Rem || !fits_i32(imm) {
            return false;
        }
        if op == Mul && (imm == 3 || imm == 5 || imm == 9) {
            // a * (2^k + 1) = a + a * 2^k
            o(c"    leaq (");
            mx_r(a);
            o(c",");
            mx_r(a);
            o(c",");
            oi(imm - 1);
            o(c"), ");
            mx_r(d);
            on();
            mx_normalize(d, ty);
            return true;
        }
        if op == Mul {
            o(c"    imulq $");
            oi(imm);
            o(c", ");
            mx_r(a);
            o(c", ");
            mx_r(d);
            on();
        } else {
            m_mov(d, a, TY_U64);
            mx_ir(mx_op_mnemonic(op), imm, d);
        }
        mx_normalize(d, ty);
        true
    }
}

// d = a / b (or a % b). Division by zero gives 0 and the remainder the
// dividend, and the signed MIN / -1 wraps, as on AArch64 (where idiv would
// trap); the checks are left out for a constant divisor that needs none.
// Neither a nor b is rax or rdx (nor is d).
pub fn mx_div(op: Op, ty: i64, d: i64, a: i64, b: i64, b_const: i64, b_is_const: bool) {
    unsafe {
        let remainder = op == Rem;
        let signed = is_signed(ty);
        mx_rr(c"movq", a, 0);
        mx_rr(c"movq", b, 11);
        let checked = !(b_is_const && b_const != 0 && !(signed && b_const == -1));
        let by_zero = new_label();
        let done = new_label();
        if checked {
            ins(c"testq %r11, %r11");
            x64_jcc(c"e", by_zero);
        }
        if signed {
            let by_minus_one = new_label();
            if checked {
                ins(c"cmpq $-1, %r11");
                x64_jcc(c"e", by_minus_one);
            }
            ins(c"cqto");
            ins(c"idivq %r11");
            if remainder {
                ins(c"movq %rdx, %rax");
            }
            if checked {
                x64_jump(done);
                emit_label(by_minus_one);
                ins(if remainder { c"xorl %eax, %eax" } else { c"negq %rax" });
            }
        } else {
            ins(c"xorl %edx, %edx");
            ins(c"divq %r11");
            if remainder {
                ins(c"movq %rdx, %rax");
            }
        }
        if checked {
            x64_jump(done);
            emit_label(by_zero);
            if !remainder {
                ins(c"xorl %eax, %eax");
            }
            emit_label(done);
        }
        m_mov(d, 0, TY_U64);
        mx_normalize(d, ty);
    }
}

// d = the high 64 bits of a * b (MULH, 0.11): mulq or imulq, which leave
// them in rdx (the allocator keeps rax and rdx free there, as for a
// division; neither a nor b nor d is one of them). The result is already
// canonical for its type (see isel.tach).
pub fn mx_mulh(signed: bool, d: i64, a: i64, b: i64) {
    unsafe {
        mx_rr(c"movq", a, 0);
        o(if signed { c"    imulq " } else { c"    mulq " });
        mx_r(b);
        on();
        mx_rr(c"movq", 2, d);
    }
}

pub fn mx_float_op(op: Op, ty: i64, d: i64, a: i64, b: i64) {
    unsafe {
        let f32 = ty == TY_F32;
        let mut name = c"div";
        if op == Add { name = c"add"; }
        else if op == Sub { name = c"sub"; }
        else if op == Mul { name = c"mul"; }
        if d == b && d != a {
            if op == Add || op == Mul {
                mx_float_rr(name, f32, a, d);
                return;
            }
            mx_rr(c"movapd", a, 47);
            mx_float_rr(name, f32, b, 47);
            mx_rr(c"movapd", 47, d);
            return;
        }
        m_mov(d, a, ty);
        mx_float_rr(name, f32, b, d);
    }
}

// "    <name>ss/sd %a, %b\n"
fn mx_float_rr(name: *u8, f32: bool, a: i64, b: i64) {
    unsafe {
        o(c"    ");
        o(name);
        o(if f32 { c"ss " } else { c"sd " });
        mx_r(a);
        o(c", ");
        mx_r(b);
        on();
    }
}

pub fn mx_unary(op: Op, ty: i64, d: i64, a: i64) {
    unsafe {
        if op == Neg && ty == TY_F32 {
            mx_rr(c"movd", a, 11);
            ins(c"xorl $0x80000000, %r11d");
            mx_rr(c"movd", 11, d);
            return;
        }
        if op == Neg && ty == TY_F64 {
            mx_rr(c"movq", a, 11);
            ins(c"btcq $63, %r11");
            mx_rr(c"movq", 11, d);
            return;
        }
        m_mov(d, a, TY_U64);
        if op == Neg {
            o(c"    negq ");
        } else if op == Not {
            mx_ir(c"xorq", 1, d);
            return;
        } else {
            o(c"    notq ");
        }
        mx_r(d);
        on();
        mx_normalize(d, ty);
    }
}

pub fn mx_cmp(op: Cond, ty: i64, d: i64, a: i64, b: i64) {
    unsafe {
        if !is_float(ty) {
            mx_rr(c"cmpq", b, a);
            o(c"    set");
            o(x64_int_cc(op, is_signed(ty)));
            o(c" %r11b\n");
        } else {
            let compare = if ty == TY_F32 { c"ucomiss" } else { c"ucomisd" };
            // Unordered (NaN) sets ZF, PF and CF: == and != check PF; < and <=
            // swap the operands to use the ordered "above" conditions.
            if op == Cond::Lt || op == Cond::Le {
                mx_rr(compare, a, b);
            } else {
                mx_rr(compare, b, a);
            }
            if op == Cond::Eq {
                ins(c"sete %r11b");
                ins(c"setnp %r10b");
                ins(c"andb %r10b, %r11b");
            } else if op == Cond::Ne {
                ins(c"setne %r11b");
                ins(c"setp %r10b");
                ins(c"orb %r10b, %r11b");
            } else if op == Cond::Lt || op == Cond::Gt {
                ins(c"seta %r11b");
            } else {
                ins(c"setae %r11b");
            }
        }
        o(c"    movzbl %r11b, ");
        mx_rs(d, 4);
        on();
    }
}

// Links a frame: saves the frame pointer, points it at itself.
pub fn mx_frame_link() {
    unsafe {
        ins(c"pushq %rbp");
        ins(c"movq %rsp, %rbp");
    }
}

// Unlinks it: rsp from the frame pointer, which is restored.
pub fn mx_frame_unlink() {
    unsafe {
        ins(c"movq %rbp, %rsp");
        ins(c"popq %rbp");
    }
}

// d = (a op imm), integers, imm a 32-bit immediate.
pub fn mx_cmp_imm(op: Cond, ty: i64, d: i64, a: i64, imm: i64) {
    unsafe {
        mx_ir(c"cmpq", imm, a);
        o(c"    set");
        o(x64_int_cc(op, is_signed(ty)));
        o(c" %r11b\n");
        o(c"    movzbl %r11b, ");
    }
    mx_rs(d, 4);
    on();
}

pub fn mx_cmp_branch(op: Cond, ty: i64, a: i64, b: i64, b_is_imm: bool, imm: i64, label: i64) {
    unsafe {
        if b_is_imm {
            mx_ir(c"cmpq", imm, a);
        } else {
            mx_rr(c"cmpq", b, a);
        }
        x64_jcc(x64_int_cc(op, is_signed(ty)), label);
    }
}

pub fn mx_branch_bool(r: i64, if_nonzero: bool, label: i64) {
    unsafe {
        mx_rr(c"testq", r, r);
        x64_jcc(if if_nonzero { c"ne" } else { c"e" }, label);
    }
}

pub fn mx_conv(from: i64, to: i64, d: i64, src: i64) {
    unsafe {
        let from_f32 = from == TY_F32;
        if is_float(from) && is_float(to) {
            mx_rr(if to == TY_F64 { c"cvtss2sd" } else { c"cvtsd2ss" }, src, d);
            return;
        }
        if is_float(to) {
            mx_int_to_float(from, to, d, src);
            return;
        }
        if !is_float(from) {
            m_mov(d, src, TY_U64);
            mx_normalize(d, to);
            return;
        }
        // Saturating float to integer (see x64_float_to_int), in r11.
        if is_signed(to) && int_bits(to) <= 32 {
            mx_truncate(from_f32, 32, src);
            ins(c"movslq %r11d, %r11");
        } else if to != TY_U64 {
            mx_truncate(from_f32, 64, src);
        } else {
            // value >= 2^63 ? the unsigned conversion : the signed one.
            let big = new_label();
            let done = new_label();
            if from_f32 {
                ins(c"movl $0x5f000000, %r11d");
                ins(c"movd %r11d, %xmm15");
                mx_rr(c"ucomiss", 47, src);
            } else {
                ins(c"movabsq $0x43e0000000000000, %r11");
                ins(c"movq %r11, %xmm15");
                mx_rr(c"ucomisd", 47, src);
            }
            x64_jcc(c"ae", big);
            mx_truncate(from_f32, 64, src);
            x64_jump(done);
            emit_label(big);
            // value - 2^63 converts exactly below 2^64; above, the indefinite
            // result means "saturate to the maximum".
            mx_rr(c"movapd", src, 46);
            ins(if from_f32 { c"subss %xmm15, %xmm14" } else { c"subsd %xmm15, %xmm14" });
            ins(if from_f32 { c"cvttss2si %xmm14, %r11" } else { c"cvttsd2si %xmm14, %r11" });
            let saturate = new_label();
            ins(c"testq %r11, %r11");
            x64_jcc(c"s", saturate);
            ins(c"btsq $63, %r11");
            x64_jump(done);
            emit_label(saturate);
            ins(c"movq $-1, %r11");
            emit_label(done);
        }
        m_mov(d, 11, TY_U64);
        mx_normalize(d, to);
    }
}

// r11 (r11d at 32 bits) = the saturating signed conversion of float
// register src (see x64_truncate); r10 is a temporary.
fn mx_truncate(f32: bool, bits: i64, src: i64) {
    unsafe {
        let done = new_label();
        let nan = new_label();
        o(if f32 { c"    cvttss2si " } else { c"    cvttsd2si " });
        mx_r(src);
        o(if bits == 32 { c", %r11d\n" } else { c", %r11\n" });
        if bits == 32 {
            ins(c"cmpl $-2147483648, %r11d");
        } else {
            ins(c"movabsq $-9223372036854775808, %r10");
            ins(c"cmpq %r10, %r11");
        }
        x64_jcc(c"ne", done);
        mx_rr(if f32 { c"ucomiss" } else { c"ucomisd" }, src, src);
        x64_jcc(c"p", nan);
        // The minimum is right for negative overflow (and the minimum itself).
        if f32 {
            mx_rr(c"movd", src, 10);
            ins(c"testl %r10d, %r10d");
        } else {
            mx_rr(c"movq", src, 10);
            ins(c"testq %r10, %r10");
        }
        x64_jcc(c"s", done);
        if bits == 32 {
            ins(c"movl $2147483647, %r11d");
        } else {
            ins(c"movabsq $9223372036854775807, %r11");
        }
        x64_jump(done);
        emit_label(nan);
        ins(c"xorl %r11d, %r11d");
        emit_label(done);
    }
}

fn mx_int_to_float(from: i64, to: i64, d: i64, src: i64) {
    unsafe {
        let convert = if to == TY_F32 { c"cvtsi2ssq" } else { c"cvtsi2sdq" };
        if from != TY_U64 {
            // Signed, or unsigned below 2^32 (zero-extended): exact as signed.
            mx_rr(convert, src, d);
            return;
        }
        // u64 at 2^63 and above: halve (keeping the low bit, for rounding),
        // convert, double.
        let big = new_label();
        let done = new_label();
        mx_rr(c"testq", src, src);
        x64_jcc(c"s", big);
        mx_rr(convert, src, d);
        x64_jump(done);
        emit_label(big);
        mx_rr(c"movq", src, 11);
        ins(c"movq %r11, %r10");
        ins(c"shrq $1, %r11");
        ins(c"andl $1, %r10d");
        ins(c"orq %r10, %r11");
        mx_rr(convert, 11, d);
        mx_rr(if to == TY_F32 { c"addss" } else { c"addsd" }, d, d);
        emit_label(done);
    }
}

pub fn mx_copy(dst: i64, src: i64, size: i64) {
    unsafe {
        let mut offset = 0;
        while offset + 8 <= size {
            mx_copy_chunk(c"movq", 8, dst, src, offset);
            offset += 8;
        }
        if offset + 4 <= size {
            mx_copy_chunk(c"movl", 4, dst, src, offset);
            offset += 4;
        }
        if offset + 2 <= size {
            mx_copy_chunk(c"movw", 2, dst, src, offset);
            offset += 2;
        }
        if offset < size {
            mx_copy_chunk(c"movb", 1, dst, src, offset);
        }
    }
}

fn mx_copy_chunk(mnemonic: *u8, size: i64, dst: i64, src: i64, offset: i64) {
    unsafe {
        o(c"    ");
        o(mnemonic);
        o(c" ");
        mx_mem(src, offset);
        o(c", ");
        mx_rs(11, size);
        on();
        o(c"    ");
        o(mnemonic);
        o(c" ");
        mx_rs(11, size);
        o(c", ");
        mx_mem(dst, offset);
        on();
    }
}

// A jump through a table of 32-bit offsets (from the table) to labels:
// entry `value - low` for register r, the default above the range
// (position independent).
pub fn mx_jump_table(r: i64, low: i64, range: i64, default: i64, table: *i64) {
    unsafe {
        // The index: the value itself when the cases start at 0.
        let index = if low == 0 { r } else { 11 };
        if low != 0 {
            mx_mov(11, r, TY_U64);
        }
        if low != 0 {
            if fits_i32(low) {
                mx_ir(c"subq", low, 11);
            } else {
                mx_load_imm(10, low as u64);
                mx_rr(c"subq", 10, 11);
            }
        }
        mx_ir(c"cmpq", range - 1, index);
        x64_jcc(c"a", default);
        let at = new_label();
        o(c"    leaq ");
        o(local_prefix());
        oi(at);
        o(c"(%rip), %r10\n");
        o(c"    movslq (%r10,");
        mx_r(index);
        o(c",4), %r11\n");
        ins(c"addq %r10, %r11");
        ins(c"jmp *%r11");
        ins(c".p2align 2");
        emit_label(at);
        for i in 0..range {
            o(c"    .long ");
            o(local_prefix());
            oi(table[i]);
            o(c" - ");
            o(local_prefix());
            oi(at);
            on();
        }
    }
}

// ---- Machine operations of instruction selection (isel.tach) ----

// Sets the flags from a & b (b < 0: a & mask).
fn mx_test(a: i64, b: i64, mask: i64) {
    unsafe {
        if b >= 0 {
            mx_rr(c"testq", b, a);
        } else {
            mx_ir(c"testq", mask, a);
        }
    }
}

// Jumps to `label` when a & b (b < 0: a & mask) is nonzero, or zero.
pub fn mx_test_branch(a: i64, b: i64, mask: i64, if_nonzero: bool, label: i64) {
    mx_test(a, b, mask);
    unsafe { x64_jcc(if if_nonzero { c"ne" } else { c"e" }, label); }
}

// d = (lhs op rhs) ? then : other (integers), or (lhs & rhs) op 0 when
// `test` (rhs < 0: the immediate imm); the flags are already set unless
// `compare`.
pub fn mx_select(op: Cond, test: bool, compare: bool, cmp_ty: i64, lhs: i64, rhs: i64, imm: i64, d: i64, then: i64,
             other: i64) {
    unsafe {
        if !compare {
        } else if test {
            mx_test(lhs, rhs, imm);
        } else if rhs < 0 {
            mx_ir(c"cmpq", imm, lhs);
        } else {
            mx_rr(c"cmpq", rhs, lhs);
        }
        let signed = is_signed(cmp_ty);
        // movq leaves the flags alone.
        if d == other {
            mx_cmov(x64_int_cc(op, signed), then, d);
        } else if d == then {
            mx_cmov(x64_int_cc(op.negate(), signed), other, d);
        } else {
            mx_rr(c"movq", other, d);
            mx_cmov(x64_int_cc(op, signed), then, d);
        }
    }
}

fn mx_cmov(cc: *u8, src: i64, d: i64) {
    unsafe {
        o(c"    cmov");
        o(cc);
        o(c"q ");
        mx_r(src);
        o(c", ");
        mx_r(d);
        on();
    }
}

// d = sqrt(a).
pub fn mx_sqrt(ty: i64, d: i64, a: i64) {
    unsafe { mx_rr(if ty == TY_F32 { c"sqrtss" } else { c"sqrtsd" }, a, d); }
}

// ---- Vectors (0.10) ----
//
// SSE2 on xmm0-xmm15 (32 + n), two-operand forms: the destination holds
// the first operand first. xmm14 and xmm15 are the temporaries; what SSE2
// has no instruction for (a 32-, 64- or 8-bit multiplication, a 64-bit
// ordering, lanes moved to and from the integer registers, sums) goes lane
// by lane through the red zone below %rsp (System V keeps 128 bytes there
// for the function's own use, which nothing else in the code uses), in r10
// and r11.

const X15: i64 = 47;
const X14: i64 = 46;

// The suffix of the integer instructions for vt's lanes: q, d, w or b.
fn mx_lane_suffix(vt: i64) -> *u8 {
    let lanes = vec_lanes(vt);
    if lanes == 2 { return c"q"; }
    if lanes == 4 { return c"d"; }
    if lanes == 8 { return c"w"; }
    c"b"
}

// "    <mnemonic><suffix> %a, %b\n"
fn mx_rr2(mnemonic: *u8, suffix: *u8, a: i64, b: i64) {
    unsafe {
        o(c"    ");
        o(mnemonic);
        o(suffix);
        o(c" ");
        mx_r(a);
        o(c", ");
        mx_r(b);
        on();
    }
}

fn mx_vmov(d: i64, a: i64) {
    if d != a {
        unsafe { mx_rr(c"movaps", a, d); }
    }
}

// d = a <m> b, the instruction `m src, dst` computing dst = dst <op> src.
fn mx_v2op(m: *u8, suffix: *u8, commutative: bool, d: i64, a: i64, b: i64) {
    unsafe {
        if d == a {
            mx_rr2(m, suffix, b, d);
        } else if d == b && commutative {
            mx_rr2(m, suffix, a, d);
        } else if d == b {
            mx_vmov(X15, a);
            mx_rr2(m, suffix, b, X15);
            mx_vmov(d, X15);
        } else {
            mx_vmov(d, a);
            mx_rr2(m, suffix, b, d);
        }
    }
}

// "<offset>(%rsp)"
fn mx_red(offset: i64) {
    unsafe {
        oi(offset);
        o(c"(%rsp)");
    }
}

fn mx_to_red(r: i64, offset: i64) {
    unsafe {
        o(c"    movups ");
        mx_r(r);
        o(c", ");
        mx_red(offset);
        on();
    }
}

fn mx_from_red(r: i64, offset: i64) {
    unsafe {
        o(c"    movups ");
        mx_red(offset);
        o(c", ");
        mx_r(r);
        on();
    }
}

// Integer register r = the lane of type elem at offset (sign-extended).
fn mx_lane_load(elem: i64, offset: i64, r: i64) {
    unsafe {
        let size = type_size(elem);
        o(if size == 1 { c"    movsbq " } else if size == 2 { c"    movswq " } else if size == 4 { c"    movslq " } else { c"    movq " });
        mx_red(offset);
        o(c", ");
        mx_r(r);
        on();
    }
}

fn mx_lane_store(elem: i64, r: i64, offset: i64) {
    unsafe {
        let size = type_size(elem);
        o(if size == 1 { c"    movb " } else if size == 2 { c"    movw " } else if size == 4 { c"    movl " } else { c"    movq " });
        mx_rs(r, size);
        o(c", ");
        mx_red(offset);
        on();
    }
}

// d = a <op> b lane by lane in r10 and r11 through the red zone: a
// multiplication (op Mul), or a 64-bit comparison (op Sub, cond).
fn mx_vlanes(op: Op, cond: Cond, vt: i64, d: i64, a: i64, b: i64) {
    unsafe {
        let elem = vec_elem(vt);
        let size = type_size(elem);
        mx_to_red(a, -32);
        mx_to_red(b, -16);
        for lane in 0..vec_lanes(vt) {
            mx_lane_load(elem, -32 + lane * size, 10);
            if op == Mul {
                mx_lane_load(elem, -16 + lane * size, 11);
                o(c"    imulq %r11, %r10\n");
                mx_lane_store(elem, 10, -32 + lane * size);
            } else {
                o(c"    xorl %r11d, %r11d\n    cmpq ");
                mx_red(-16 + lane * size);
                o(if cond == Cond::Gt { c", %r10\n    setg %r11b\n" } else { c", %r10\n    setl %r11b\n" });
                o(c"    negq %r11\n");
                mx_lane_store(elem, 11, -32 + lane * size);
            }
        }
        mx_from_red(d, -32);
    }
}

pub fn mx_vbin(op: Op, vt: i64, d: i64, a: i64, b: i64) {
    unsafe {
        let float = is_float(vec_elem(vt));
        let fs = if vec_lanes(vt) == 2 { c"pd" } else { c"ps" };
        let is = mx_lane_suffix(vt);
        if op == And { mx_v2op(c"pand", c"", true, d, a, b); }
        else if op == Or { mx_v2op(c"por", c"", true, d, a, b); }
        else if op == Xor { mx_v2op(c"pxor", c"", true, d, a, b); }
        else if op == Add { if float { mx_v2op(c"add", fs, true, d, a, b); } else { mx_v2op(c"padd", is, true, d, a, b); } }
        else if op == Sub { if float { mx_v2op(c"sub", fs, false, d, a, b); } else { mx_v2op(c"psub", is, false, d, a, b); } }
        else if op == Div { mx_v2op(c"div", fs, false, d, a, b); }
        else if float { mx_v2op(c"mul", fs, true, d, a, b); }
        else if vec_lanes(vt) == 8 { mx_v2op(c"pmullw", c"", true, d, a, b); }
        else { mx_vlanes(Mul, Cond::Eq, vt, d, a, b); }
    }
}

// xmm14 = all ones.
fn mx_ones() {
    unsafe { o(c"    pcmpeqd %xmm14, %xmm14\n"); }
}

pub fn mx_vneg(vt: i64, d: i64, a: i64) {
    unsafe {
        if is_float(vec_elem(vt)) {
            // The sign bits, flipped.
            mx_ones();
            o(if vec_lanes(vt) == 2 { c"    psllq $63, %xmm14\n" } else { c"    pslld $31, %xmm14\n" });
            mx_vmov(d, a);
            mx_rr(c"xorps", X14, d);
            return;
        }
        mx_rr(c"pxor", X15, X15);
        mx_rr2(c"psub", mx_lane_suffix(vt), a, X15);
        mx_vmov(d, X15);
    }
}

// d = ~d.
fn mx_vnot(d: i64) {
    mx_ones();
    unsafe { mx_rr(c"pxor", X14, d); }
}

pub fn mx_vcmp(cond: Cond, vt: i64, d: i64, a: i64, b: i64) {
    unsafe {
        let lanes = vec_lanes(vt);
        if is_float(vec_elem(vt)) {
            // cmpps/cmppd predicates: 0 eq, 1 lt, 2 le, 4 neq (true on NaN).
            let fs = if lanes == 2 { c"pd" } else { c"ps" };
            let mut x = a;
            let mut y = b;
            let mut pred = 0;
            if cond == Cond::Ne { pred = 4; }
            else if cond == Cond::Lt { pred = 1; }
            else if cond == Cond::Le { pred = 2; }
            else if cond == Cond::Gt { pred = 1; x = b; y = a; }
            else if cond == Cond::Ge { pred = 2; x = b; y = a; }
            // dst = x <pred> y.
            let t = if d == y && d != x { X15 } else { d };
            mx_vmov(t, x);
            o(c"    cmp");
            o(fs);
            o(c" $");
            oi(pred);
            o(c", ");
            mx_r(y);
            o(c", ");
            mx_r(t);
            on();
            mx_vmov(d, t);
            return;
        }
        let is = mx_lane_suffix(vt);
        if cond == Cond::Eq || cond == Cond::Ne {
            if lanes == 2 {
                // Both 32-bit halves equal.
                mx_v2op(c"pcmpeqd", c"", true, d, a, b);
                o(c"    pshufd $177, ");
                mx_r(d);
                o(c", %xmm15\n");
                mx_rr(c"pand", X15, d);
            } else {
                mx_v2op(c"pcmpeq", is, true, d, a, b);
            }
            if cond == Cond::Ne {
                mx_vnot(d);
            }
            return;
        }
        // Gt: a > b; Lt: b > a; Le: not Gt; Ge: not Lt.
        let swap = cond == Cond::Lt || cond == Cond::Ge;
        let x = if swap { b } else { a };
        let y = if swap { a } else { b };
        if lanes == 2 {
            mx_vlanes(Sub, Cond::Gt, vt, d, x, y);
        } else {
            mx_v2op(c"pcmpgt", is, false, d, x, y);
        }
        if cond == Cond::Le || cond == Cond::Ge {
            mx_vnot(d);
        }
    }
}

pub fn mx_vsplat(vt: i64, d: i64, a: i64) {
    unsafe {
        let lanes = vec_lanes(vt);
        if is_float(vec_elem(vt)) {
            mx_vmov(d, a);
            if lanes == 2 {
                mx_rr(c"unpcklpd", d, d);
            } else {
                o(c"    shufps $0, ");
                mx_r(d);
                o(c", ");
                mx_r(d);
                on();
            }
            return;
        }
        if lanes == 2 {
            mx_rr(c"movq", a, d);
            mx_rr(c"punpcklqdq", d, d);
            return;
        }
        o(c"    movd ");
        mx_rs(a, 4);
        o(c", ");
        mx_r(d);
        on();
        if lanes == 16 {
            mx_rr(c"punpcklbw", d, d);
        }
        if lanes >= 8 {
            mx_rr(c"punpcklwd", d, d);
        }
        o(c"    pshufd $0, ");
        mx_r(d);
        o(c", ");
        mx_r(d);
        on();
    }
}

pub fn mx_vext(vt: i64, d: i64, a: i64, lane: i64) {
    unsafe {
        let elem = vec_elem(vt);
        let size = type_size(elem);
        mx_to_red(a, -16);
        if is_float(elem) {
            o(if size == 4 { c"    movss " } else { c"    movsd " });
            mx_red(-16 + lane * size);
            o(c", ");
            mx_r(d);
            on();
            return;
        }
        mx_lane_load(elem, -16 + lane * size, d);
    }
}

pub fn mx_vins(vt: i64, d: i64, a: i64, b: i64, lane: i64) {
    unsafe {
        let elem = vec_elem(vt);
        let size = type_size(elem);
        mx_to_red(a, -16);
        if is_float(elem) {
            o(if size == 4 { c"    movss " } else { c"    movsd " });
            mx_r(b);
            o(c", ");
            mx_red(-16 + lane * size);
            on();
        } else {
            mx_lane_store(elem, b, -16 + lane * size);
        }
        mx_from_red(d, -16);
    }
}

pub fn mx_vsum(vt: i64, d: i64, a: i64) {
    unsafe {
        let elem = vec_elem(vt);
        let size = type_size(elem);
        let lanes = vec_lanes(vt);
        mx_to_red(a, -16);
        if is_float(elem) {
            let m = if size == 4 { c"ss " } else { c"sd " };
            // Pairwise: (l0 + l1) for two lanes, (l0 + l1) + (l2 + l3) for four.
            o(c"    mov");
            o(m);
            mx_red(-16);
            o(c", %xmm15\n    add");
            o(m);
            mx_red(-16 + size);
            o(c", %xmm15\n");
            if lanes == 4 {
                o(c"    mov");
                o(m);
                mx_red(-8);
                o(c", %xmm14\n    add");
                o(m);
                mx_red(-4);
                o(c", %xmm14\n    add");
                o(m);
                o(c"%xmm14, %xmm15\n");
            }
            mx_vmov(d, X15);
            return;
        }
        mx_lane_load(elem, -16, 10);
        for lane in 1..lanes {
            mx_lane_load(elem, -16 + lane * size, 11);
            o(c"    addq %r11, %r10\n");
        }
        // Canonical: sign-extended from the lane width.
        o(if size == 1 { c"    movsbq %r10b, " } else if size == 2 { c"    movswq %r10w, " } else if size == 4 { c"    movslq %r10d, " } else { c"    movq %r10, " });
        mx_r(d);
        on();
    }
}

// d = (x & m) | (y & ~m).
pub fn mx_vsel(d: i64, m: i64, x: i64, y: i64) {
    unsafe {
        mx_vmov(X15, m);
        mx_rr(c"pand", x, X15);
        mx_vmov(X14, m);
        mx_rr(c"pandn", y, X14);
        mx_rr(c"por", X14, X15);
        mx_vmov(d, X15);
    }
}
