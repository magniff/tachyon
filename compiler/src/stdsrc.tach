pub fn std_source(out: i64) {
    buf_str(out, c"// The standard library (0.5): the module `std`, built into the compiler\n");
    buf_str(out, c"// (compiler/std/embed.sh makes compiler/src/stdsrc.tach from this file).\n");
    buf_str(out, c"// A program that names `std` gets it: `std::Vec<i64>`, `use std::{Buf, Vec};`.\n");
    buf_str(out, c"//\n");
    buf_str(out, c"// Option and Result, a growable vector, a byte buffer and printing.\n");
    buf_str(out, c"// Failures (unwrapping None, an index out of bounds) print a message on\n");
    buf_str(out, c"// stderr and exit with 101, like the language's own checks.\n");
    buf_str(out, c"\n");
    buf_str(out, c"extern \"C\" {\n");
    buf_str(out, c"    fn malloc(size: u64) -> *u8;\n");
    buf_str(out, c"    fn realloc(p: *u8, size: u64) -> *u8;\n");
    buf_str(out, c"    fn free(p: *u8);\n");
    buf_str(out, c"    fn write(fd: i32, data: *u8, count: u64) -> i64;\n");
    buf_str(out, c"    fn exit(code: i32) -> !;\n");
    buf_str(out, c"}\n");
    buf_str(out, c"\n");
    buf_str(out, c"// Prints `message` (a C string) on stderr and exits with 101.\n");
    buf_str(out, c"pub fn panic(message: *u8) -> ! {\n");
    buf_str(out, c"    let mut n = 0;\n");
    buf_str(out, c"    while message[n] != 0 {\n");
    buf_str(out, c"        n += 1;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    write(2, message, n as u64);\n");
    buf_str(out, c"    write(2, c\"\\n\", 1);\n");
    buf_str(out, c"    exit(101)\n");
    buf_str(out, c"}\n");
    buf_str(out, c"\n");
    buf_str(out, c"// ---- Option and Result ----\n");
    buf_str(out, c"\n");
    buf_str(out, c"pub enum Option<T> { None, Some(T) }\n");
    buf_str(out, c"\n");
    buf_str(out, c"impl<T> Option<T> {\n");
    buf_str(out, c"    pub fn is_some(self: *Option<T>) -> bool {\n");
    buf_str(out, c"        match *self {\n");
    buf_str(out, c"            Option::Some(_) => true,\n");
    buf_str(out, c"            Option::None => false,\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn is_none(self: *Option<T>) -> bool {\n");
    buf_str(out, c"        !self.is_some()\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn unwrap(self: Option<T>) -> T {\n");
    buf_str(out, c"        match self {\n");
    buf_str(out, c"            Option::Some(x) => x,\n");
    buf_str(out, c"            Option::None => panic(c\"called unwrap on None\"),\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn unwrap_or(self: Option<T>, other: T) -> T {\n");
    buf_str(out, c"        match self {\n");
    buf_str(out, c"            Option::Some(x) => x,\n");
    buf_str(out, c"            Option::None => other,\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
    buf_str(out, c"\n");
    buf_str(out, c"pub enum Result<T, E> { Ok(T), Err(E) }\n");
    buf_str(out, c"\n");
    buf_str(out, c"impl<T, E> Result<T, E> {\n");
    buf_str(out, c"    pub fn is_ok(self: *Result<T, E>) -> bool {\n");
    buf_str(out, c"        match *self {\n");
    buf_str(out, c"            Result::Ok(_) => true,\n");
    buf_str(out, c"            Result::Err(_) => false,\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn is_err(self: *Result<T, E>) -> bool {\n");
    buf_str(out, c"        !self.is_ok()\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn unwrap(self: Result<T, E>) -> T {\n");
    buf_str(out, c"        match self {\n");
    buf_str(out, c"            Result::Ok(x) => x,\n");
    buf_str(out, c"            Result::Err(_) => panic(c\"called unwrap on Err\"),\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn unwrap_or(self: Result<T, E>, other: T) -> T {\n");
    buf_str(out, c"        match self {\n");
    buf_str(out, c"            Result::Ok(x) => x,\n");
    buf_str(out, c"            Result::Err(_) => other,\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn ok(self: Result<T, E>) -> Option<T> {\n");
    buf_str(out, c"        match self {\n");
    buf_str(out, c"            Result::Ok(x) => Option::Some(x),\n");
    buf_str(out, c"            Result::Err(_) => Option::None,\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
    buf_str(out, c"\n");
    buf_str(out, c"// ---- Vec ----\n");
    buf_str(out, c"\n");
    buf_str(out, c"// A growable vector of T on the heap; `free` gives its memory back.\n");
    buf_str(out, c"pub struct Vec<T> { ptr: *T, len: i64, cap: i64 }\n");
    buf_str(out, c"\n");
    buf_str(out, c"impl<T> Vec<T> {\n");
    buf_str(out, c"    pub fn new() -> Vec<T> {\n");
    buf_str(out, c"        Vec { ptr: 0 as *T, len: 0, cap: 0 }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn with_capacity(cap: i64) -> Vec<T> {\n");
    buf_str(out, c"        let mut v: Vec<T> = Vec::new();\n");
    buf_str(out, c"        v.reserve(cap);\n");
    buf_str(out, c"        v\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn len(self: *Vec<T>) -> i64 {\n");
    buf_str(out, c"        self.len\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn is_empty(self: *Vec<T>) -> bool {\n");
    buf_str(out, c"        self.len == 0\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    // Room for `extra` more elements.\n");
    buf_str(out, c"    pub fn reserve(self: *Vec<T>, extra: i64) {\n");
    buf_str(out, c"        if self.len + extra <= self.cap {\n");
    buf_str(out, c"            return;\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        let mut cap = if self.cap == 0 { 4 } else { self.cap * 2 };\n");
    buf_str(out, c"        while cap < self.len + extra {\n");
    buf_str(out, c"            cap *= 2;\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        self.ptr = realloc(self.ptr as *u8, (cap * size_of(T)) as u64) as *T;\n");
    buf_str(out, c"        self.cap = cap;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn push(self: *Vec<T>, x: T) {\n");
    buf_str(out, c"        if self.len == self.cap {\n");
    buf_str(out, c"            self.reserve(1);\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        self.ptr[self.len] = x;\n");
    buf_str(out, c"        self.len += 1;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn pop(self: *Vec<T>) -> Option<T> {\n");
    buf_str(out, c"        if self.len == 0 {\n");
    buf_str(out, c"            return Option::None;\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        self.len -= 1;\n");
    buf_str(out, c"        Option::Some(self.ptr[self.len])\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    // Element i (checked: out of bounds exits with 101).\n");
    buf_str(out, c"    pub fn get(self: *Vec<T>, i: i64) -> T {\n");
    buf_str(out, c"        self.as_slice()[i]\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn set(self: *Vec<T>, i: i64, x: T) {\n");
    buf_str(out, c"        self.as_slice()[i] = x;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn as_slice(self: *Vec<T>) -> [T] {\n");
    buf_str(out, c"        self.ptr[0..self.len]\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn clear(self: *Vec<T>) {\n");
    buf_str(out, c"        self.len = 0;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn free(self: *Vec<T>) {\n");
    buf_str(out, c"        free(self.ptr as *u8);\n");
    buf_str(out, c"        self.ptr = 0 as *T;\n");
    buf_str(out, c"        self.len = 0;\n");
    buf_str(out, c"        self.cap = 0;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
    buf_str(out, c"\n");
    buf_str(out, c"// ---- Buf ----\n");
    buf_str(out, c"\n");
    buf_str(out, c"// A growable buffer of bytes, for building text.\n");
    buf_str(out, c"pub struct Buf { bytes: Vec<u8> }\n");
    buf_str(out, c"\n");
    buf_str(out, c"impl Buf {\n");
    buf_str(out, c"    pub fn new() -> Buf {\n");
    buf_str(out, c"        Buf { bytes: Vec::new() }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn len(self: *Buf) -> i64 {\n");
    buf_str(out, c"        self.bytes.len\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn push(self: *Buf, b: u8) {\n");
    buf_str(out, c"        self.bytes.push(b);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn push_str(self: *Buf, s: [u8]) {\n");
    buf_str(out, c"        self.bytes.reserve(s.len);\n");
    buf_str(out, c"        for b in s {\n");
    buf_str(out, c"            self.bytes.push(b);\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    // A C string (up to its NUL).\n");
    buf_str(out, c"    pub fn push_cstr(self: *Buf, s: *u8) {\n");
    buf_str(out, c"        let mut i = 0;\n");
    buf_str(out, c"        while s[i] != 0 {\n");
    buf_str(out, c"            self.bytes.push(s[i]);\n");
    buf_str(out, c"            i += 1;\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    // The decimal digits of v.\n");
    buf_str(out, c"    pub fn push_int(self: *Buf, v: i64) {\n");
    buf_str(out, c"        if v < 0 {\n");
    buf_str(out, c"            self.push('-');\n");
    buf_str(out, c"            if v == -9223372036854775807 - 1 {\n");
    buf_str(out, c"                self.push_cstr(c\"9223372036854775808\");\n");
    buf_str(out, c"                return;\n");
    buf_str(out, c"            }\n");
    buf_str(out, c"            self.push_int(-v);\n");
    buf_str(out, c"            return;\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        if v >= 10 {\n");
    buf_str(out, c"            self.push_int(v / 10);\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        self.push('0' + (v % 10) as u8);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn as_slice(self: *Buf) -> [u8] {\n");
    buf_str(out, c"        self.bytes.as_slice()\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn clear(self: *Buf) {\n");
    buf_str(out, c"        self.bytes.clear();\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    pub fn free(self: *Buf) {\n");
    buf_str(out, c"        self.bytes.free();\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
    buf_str(out, c"\n");
    buf_str(out, c"// ---- Printing ----\n");
    buf_str(out, c"\n");
    buf_str(out, c"pub fn print(s: [u8]) {\n");
    buf_str(out, c"    write(1, s.ptr, s.len as u64);\n");
    buf_str(out, c"}\n");
    buf_str(out, c"\n");
    buf_str(out, c"pub fn println(s: [u8]) {\n");
    buf_str(out, c"    print(s);\n");
    buf_str(out, c"    write(1, c\"\\n\", 1);\n");
    buf_str(out, c"}\n");
    buf_str(out, c"\n");
    buf_str(out, c"pub fn print_int(v: i64) {\n");
    buf_str(out, c"    let mut b = Buf::new();\n");
    buf_str(out, c"    b.push_int(v);\n");
    buf_str(out, c"    print(b.as_slice());\n");
    buf_str(out, c"    b.free();\n");
    buf_str(out, c"}\n");
    buf_str(out, c"\n");
    buf_str(out, c"pub fn print_cstr(s: *u8) {\n");
    buf_str(out, c"    let mut b = Buf::new();\n");
    buf_str(out, c"    b.push_cstr(s);\n");
    buf_str(out, c"    print(b.as_slice());\n");
    buf_str(out, c"    b.free();\n");
    buf_str(out, c"}\n");
}
