// Aggressive dead code elimination (0.4): liveness over data and control
// dependence. Instructions with effects and returns are live; so are the
// operands of live instructions, and the branches a live block is control
// dependent on (Ferrante, Ottenstein & Warren: block b depends on the
// branch at x when b post-dominates a successor of x but not x itself),
// and the branches of the blocks a live phi comes from. Every other
// instruction is removed, and a branch that is not live becomes a jump to
// its immediate post-dominator. Branches inside loops and in blocks that
// cannot reach a return are kept live: a loop may not terminate, and only
// 49_scev.tach's deletion of finite loops removes loops.

// Per block id: the immediate post-dominator (-1: the virtual exit, 0:
// none: the block cannot reach a return) and the post-order number.
static mut PDOM: *i64 = 0 as *i64;
static mut PORDER: *i64 = 0 as *i64;
static mut PORDER_LIST: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn is_exit_block(b: i64) -> bool {
    BLOCKS[b].term == Term::Ret || BLOCKS[b].term == Term::Unreach
}

fn pdom_intersect(b1: i64, b2: i64) -> i64 {
    let mut x = b1;
    let mut y = b2;
    while x != y {
        while x != -1 && (y == -1 || PORDER[x] < PORDER[y]) {
            x = PDOM[x];
        }
        while y != -1 && (x == -1 || PORDER[y] < PORDER[x]) {
            y = PDOM[y];
        }
    }
    x
}

// Post-dominators of fi's reachable blocks (layout_blocks done).
fn compute_post_dominators(fi: i64) {
    free(PDOM as *u8);
    free(PORDER as *u8);
    PDOM = alloc_zeroed((BLOCK_COUNT + 1) * 8) as *i64;
    PORDER = alloc_zeroed((BLOCK_COUNT + 1) * 8) as *i64;
    // Post-order of the reverse CFG from the virtual exit (whose number
    // is the largest).
    PORDER_LIST.count = 0;
    let mut seen = alloc_zeroed((BLOCK_COUNT + 1) * 8) as *i64;
    let mut stack = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for i in 0..ORDER.count {
        let r = ORDER.data[i];
        if !is_exit_block(r) || seen[r] != 0 {
            continue;
        }
        seen[r] = 1;
        stack.push(r);
        stack.push(0);
        while stack.count > 0 {
            let b = stack.data[stack.count - 2];
            let k = stack.data[stack.count - 1];
            if k < BLOCKS[b].preds.count {
                stack.data[stack.count - 1] = k + 1;
                let p = BLOCKS[b].preds.data[k];
                if BLOCKS[p].order >= 0 && seen[p] == 0 {
                    seen[p] = 1;
                    stack.push(p);
                    stack.push(0);
                }
            } else {
                stack.count -= 2;
                PORDER[b] = PORDER_LIST.count + 1;
                PORDER_LIST.push(b);
            }
        }
    }
    free(stack.data as *u8);
    free(seen as *u8);
    for i in 0..PORDER_LIST.count {
        let b = PORDER_LIST.data[i];
        PDOM[b] = if is_exit_block(b) { -1 } else { 0 };
    }
    // The virtual exit's number is above every block's.
    let mut changed = true;
    while changed {
        changed = false;
        let mut i = PORDER_LIST.count;
        while i > 0 {
            i -= 1;
            let b = PORDER_LIST.data[i];
            if is_exit_block(b) {
                continue;
            }
            let mut new_pdom = 0;
            for k in 0..succ_count(b) {
                let s = succ(b, k);
                if PORDER[s] == 0 || PDOM[s] == 0 {
                    continue;
                }
                new_pdom = if new_pdom == 0 { s } else { pdom_intersect(s, new_pdom) };
            }
            if new_pdom != PDOM[b] {
                PDOM[b] = new_pdom;
                changed = true;
            }
        }
    }
}

fn pdom_order(b: i64) -> i64 {
    if b == -1 { 9223372036854775807 } else { PORDER[b] }
}

fn adce_mark(v: i64, work: *IntVec) {
    if v != 0 && INSTS[v].mark == 0 {
        INSTS[v].mark = 1;
        work.push(v);
    }
}

// Marks block b's terminator live (and b itself).
fn adce_mark_branch(b: i64, live_term: *i64, blocks: *IntVec, work: *IntVec) {
    if live_term[b] == 0 {
        live_term[b] = 1;
        blocks.push(b);
        adce_mark(BLOCKS[b].cond, work);
    }
}

fn aggressive_dce(fi: i64) -> bool {
    IRF = fi;
    resolve_all(fi);
    analyze_loops(fi);
    compute_post_dominators(fi);
    let n = BLOCK_COUNT + 1;
    // Control dependence: the branches each block depends on, as lists
    // (CD_FIRST[b] .. linked through CD_NEXT).
    let mut deps = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    let mut first = alloc_zeroed(n * 8) as *i64;
    for i in 0..ORDER.count {
        let x = ORDER.data[i];
        if succ_count(x) < 2 || PORDER[x] == 0 || PDOM[x] == 0 {
            continue;
        }
        for k in 0..succ_count(x) {
            let mut runner = succ(x, k);
            while runner != PDOM[x] && runner > 0 && PORDER[runner] != 0 {
                deps.push(x);
                deps.push(first[runner]);
                first[runner] = deps.count / 2;
                runner = PDOM[runner];
                if runner == 0 {
                    break;
                }
            }
        }
    }
    let mut live_term = alloc_zeroed(n * 8) as *i64;
    let mut live_block = alloc_zeroed(n * 8) as *i64;
    let mut work = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    let mut blocks = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for i in 0..ORDER.count {
        let b = ORDER.data[i];
        let mut v = BLOCKS[b].first;
        while v != 0 {
            INSTS[v].mark = 0;
            v = INSTS[v].next;
        }
    }
    for i in 0..ORDER.count {
        let b = ORDER.data[i];
        let mut v = BLOCKS[b].first;
        while v != 0 {
            if INSTS[v].op.has_side_effect() {
                adce_mark(v, &work);
            }
            v = INSTS[v].next;
        }
        // Branches that stay: in loops, unable to reach a return, or
        // without a post-dominator a jump could go to (one with phis).
        let j = PDOM[b];
        let mut keep = is_exit_block(b) || innermost_loop(b) >= 0 || PORDER[b] == 0 || j <= 0;
        if !keep && BLOCKS[b].term != Term::Jump {
            let f = BLOCKS[j].first;
            keep = f != 0 && INSTS[f].op == Op::Phi;
        }
        if keep && BLOCKS[b].term != Term::Jump {
            adce_mark_branch(b, live_term, &blocks, &work);
        } else if is_exit_block(b) {
            adce_mark_branch(b, live_term, &blocks, &work);
        }
    }
    while work.count > 0 || blocks.count > 0 {
        if work.count > 0 {
            let v = work.pop();
            let b = INSTS[v].block;
            if b != 0 && live_block[b] == 0 {
                live_block[b] = 1;
                blocks.push(b);
            }
            for k in 0..ir_operand_count(v) {
                adce_mark(ir_operand(v, k), &work);
            }
            if INSTS[v].op == Op::Phi && b != 0 {
                for k in 0..BLOCKS[b].preds.count {
                    adce_mark_branch(BLOCKS[b].preds.data[k], live_term, &blocks, &work);
                }
            }
            continue;
        }
        let b = blocks.pop();
        live_block[b] = 1;
        let mut d = first[b];
        while d != 0 {
            adce_mark_branch(deps.data[2 * (d - 1)], live_term, &blocks, &work);
            d = deps.data[2 * (d - 1) + 1];
        }
    }
    // Sweep.
    let mut changed = false;
    for i in 0..ORDER.count {
        let b = ORDER.data[i];
        let mut v = BLOCKS[b].first;
        while v != 0 {
            let next = INSTS[v].next;
            if INSTS[v].mark == 0 {
                ir_unlink(v);
                changed = true;
            }
            v = next;
        }
    }
    for i in 0..ORDER.count {
        let b = ORDER.data[i];
        if live_term[b] != 0 || (BLOCKS[b].term != Term::Branch && BLOCKS[b].term != Term::Switch) {
            continue;
        }
        let j = PDOM[b];
        if j <= 0 {
            continue;
        }
        let first_inst = BLOCKS[j].first;
        if first_inst != 0 && INSTS[first_inst].op == Op::Phi {
            continue;
        }
        for k in 0..succ_count(b) {
            remove_pred(succ(b, k), b);
        }
        BLOCKS[b].term = Term::Jump;
        BLOCKS[b].cond = 0;
        BLOCKS[b].s0 = j;
        BLOCKS[b].s1 = 0;
        BLOCKS[j].preds.push(b);
        changed = true;
    }
    free(first as *u8);
    free(live_term as *u8);
    free(live_block as *u8);
    free(deps.data as *u8);
    free(work.data as *u8);
    free(blocks.data as *u8);
    if changed {
        remove_unreachable(fi);
        resolve_all(fi);
        remove_trivial_phis(fi);
    }
    changed
}
