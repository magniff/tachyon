// The target layer: AArch64 assembly for macOS (Apple's arm64 ABI), as
// text for clang's assembler. The code generator (40_gen.tach) walks the
// AST and calls these functions; another target replaces this file.
//
// Machine model used by the code generator:
//   - the accumulator: x0 for integers, bools and pointers, d0 (s0 for f32)
//     for floats, x0 holding the address for values kept in memory
//     (structs, tuples, arrays);
//   - a stack of temporaries (16 bytes each) on the machine stack;
//   - every local lives in a frame slot at x29 - offset;
//   - x1/d1 hold the second operand; x9-x17 are scratch.

// The assembly being generated for the current function, and for the
// whole file.
static mut CODE: i64 = -1;
static mut ASM: i64 = -1;
static mut DATA: i64 = -1;
// Temporaries currently pushed (16 bytes each).
static mut DEPTH: i64 = 0;
static mut LABEL_COUNT: i64 = 0;

fn o(s: *u8) {
    buf_str(CODE, s);
}

fn oi(value: i64) {
    buf_int(CODE, value);
}

fn on() {
    buf_byte(CODE, '\n');
}

// "    <s>\n"
fn ins(s: *u8) {
    buf_str(CODE, c"    ");
    buf_str(CODE, s);
    buf_byte(CODE, '\n');
}

// "    <a><value><b>\n"
fn ins_i(a: *u8, value: i64, b: *u8) {
    buf_str(CODE, c"    ");
    buf_str(CODE, a);
    buf_int(CODE, value);
    buf_str(CODE, b);
    buf_byte(CODE, '\n');
}

fn new_label() -> i64 {
    LABEL_COUNT += 1;
    LABEL_COUNT
}

fn emit_label(label: i64) {
    o(c"L");
    oi(label);
    o(c":\n");
}

fn emit_jump(label: i64) {
    ins_i(c"b L", label, c"");
}

// Jumps to `label` when x0 is zero (false).
fn emit_jump_if_zero(label: i64) {
    ins_i(c"cbz x0, L", label, c"");
}

fn emit_jump_if_nonzero(label: i64) {
    ins_i(c"cbnz x0, L", label, c"");
}

// ---- Constants and addresses ----

// x<reg> = value
fn emit_load_imm(reg: i64, value: u64) {
    let mut first = true;
    for chunk in 0..4 {
        let part = (value >> (chunk * 16) as u64) & 0xffff;
        if part != 0 || (chunk == 3 && first) {
            if first {
                o(c"    movz x");
            } else {
                o(c"    movk x");
            }
            oi(reg);
            o(c", #");
            oi(part as i64);
            if chunk > 0 {
                o(c", lsl #");
                oi(chunk * 16);
            }
            on();
            first = false;
        }
    }
}

// x<reg> = x29 - offset
fn emit_frame_addr(reg: i64, offset: i64) {
    if offset < 4096 {
        o(c"    sub x");
        oi(reg);
        ins_i(c", x29, #", offset, c"");
        return;
    }
    emit_load_imm(17, offset as u64);
    o(c"    sub x");
    oi(reg);
    ins(c", x29, x17");
}

// x<reg> += value
fn emit_add_imm(reg: i64, value: i64) {
    if value == 0 {
        return;
    }
    if value > 0 && value < 4096 {
        o(c"    add x");
        oi(reg);
        o(c", x");
        oi(reg);
        ins_i(c", #", value, c"");
        return;
    }
    emit_load_imm(17, value as u64);
    o(c"    add x");
    oi(reg);
    o(c", x");
    oi(reg);
    ins(c", x17");
}

fn emit_symbol_ref(sym_prefix: *u8, name: i64) {
    o(sym_prefix);
    buf_bytes(CODE, SYMS[name].ptr, SYMS[name].len);
}

// x0 = address of a symbol defined in this file.
fn emit_local_symbol_addr(prefix: *u8, name: i64) {
    o(c"    adrp x0, ");
    emit_symbol_ref(prefix, name);
    o(c"@PAGE\n    add x0, x0, ");
    emit_symbol_ref(prefix, name);
    o(c"@PAGEOFF\n");
}

// x0 = address of an external symbol, through the GOT.
fn emit_extern_symbol_addr(name: i64) {
    o(c"    adrp x0, ");
    emit_symbol_ref(c"_", name);
    o(c"@GOTPAGE\n    ldr x0, [x0, ");
    emit_symbol_ref(c"_", name);
    o(c"@GOTPAGEOFF]\n");
}

fn emit_string_addr(id: i64) {
    ins_i(c"adrp x0, Lstr.", id, c"@PAGE");
    ins_i(c"add x0, x0, Lstr.", id, c"@PAGEOFF");
}

// d0 (s0 for f32) = the float whose f64 bits are `bits`.
fn emit_load_float(bits: i64, ty: i64) {
    if ty == TY_F32 {
        emit_load_imm(16, f32_bits(f64_of_bits(bits)) as u64);
        ins(c"fmov s0, w16");
    } else {
        emit_load_imm(16, bits as u64);
        ins(c"fmov d0, x16");
    }
}

// ---- Temporaries ----

fn push_x0() {
    ins(c"str x0, [sp, #-16]!");
    DEPTH += 1;
}

fn push_d0() {
    ins(c"str d0, [sp, #-16]!");
    DEPTH += 1;
}

fn pop_x(reg: i64) {
    ins_i(c"ldr x", reg, c", [sp], #16");
    DEPTH -= 1;
}

fn pop_d(reg: i64) {
    ins_i(c"ldr d", reg, c", [sp], #16");
    DEPTH -= 1;
}

// Pushes the accumulator for a value of type `ty`.
fn push_value(ty: i64) {
    if is_float(ty) {
        push_d0();
    } else {
        push_x0();
    }
}

// Drops `count` temporaries without changing DEPTH (for jumps out of the
// current expression).
fn emit_drop_temps(count: i64) {
    if count > 0 {
        ins_i(c"add sp, sp, #", count * 16, c"");
    }
}

// ---- Loads and stores ----

// Accumulator = the value of type `ty` at [x<addr>].
fn emit_load(ty: i64, addr: i64) {
    let size = size_of(ty);
    if ty == TY_F32 {
        ins_i(c"ldr s0, [x", addr, c"]");
    } else if ty == TY_F64 {
        ins_i(c"ldr d0, [x", addr, c"]");
    } else if ty == TY_I8 {
        ins_i(c"ldrsb x0, [x", addr, c"]");
    } else if size == 1 {
        ins_i(c"ldrb w0, [x", addr, c"]");
    } else if ty == TY_I16 {
        ins_i(c"ldrsh x0, [x", addr, c"]");
    } else if size == 2 {
        ins_i(c"ldrh w0, [x", addr, c"]");
    } else if ty == TY_I32 {
        ins_i(c"ldrsw x0, [x", addr, c"]");
    } else if size == 4 {
        ins_i(c"ldr w0, [x", addr, c"]");
    } else {
        ins_i(c"ldr x0, [x", addr, c"]");
    }
}

// [x<addr>] = x<reg> (or d<reg>/s<reg> for floats), a value of type `ty`.
fn emit_store(ty: i64, reg: i64, addr: i64) {
    let size = size_of(ty);
    if ty == TY_F32 {
        o(c"    str s");
    } else if ty == TY_F64 {
        o(c"    str d");
    } else if size == 1 {
        o(c"    strb w");
    } else if size == 2 {
        o(c"    strh w");
    } else if size == 4 {
        o(c"    str w");
    } else {
        o(c"    str x");
    }
    oi(reg);
    ins_i(c", [x", addr, c"]");
}

// Copies `size` bytes from [x0] to [x1]; clobbers the scratch registers
// (and every caller-saved register for large copies).
fn emit_copy(size: i64) {
    if size > 128 {
        ins(c"mov x16, x0");
        ins(c"mov x0, x1");
        ins(c"mov x1, x16");
        emit_load_imm(2, size as u64);
        ins(c"bl _memcpy");
        return;
    }
    let mut offset = 0;
    while offset + 8 <= size {
        ins_i(c"ldr x16, [x0, #", offset, c"]");
        ins_i(c"str x16, [x1, #", offset, c"]");
        offset += 8;
    }
    if offset + 4 <= size {
        ins_i(c"ldr w16, [x0, #", offset, c"]");
        ins_i(c"str w16, [x1, #", offset, c"]");
        offset += 4;
    }
    if offset + 2 <= size {
        ins_i(c"ldrh w16, [x0, #", offset, c"]");
        ins_i(c"strh w16, [x1, #", offset, c"]");
        offset += 2;
    }
    if offset < size {
        ins_i(c"ldrb w16, [x0, #", offset, c"]");
        ins_i(c"strb w16, [x1, #", offset, c"]");
    }
}

// ---- Integer operations ----

// Brings x0 into the canonical form of `ty`: sign- or zero-extended from
// its width to 64 bits.
fn emit_normalize(ty: i64) {
    if ty == TY_I8 { ins(c"sxtb x0, w0"); }
    else if ty == TY_U8 { ins(c"and x0, x0, #0xff"); }
    else if ty == TY_I16 { ins(c"sxth x0, w0"); }
    else if ty == TY_U16 { ins(c"and x0, x0, #0xffff"); }
    else if ty == TY_I32 { ins(c"sxtw x0, w0"); }
    else if ty == TY_U32 { ins(c"mov w0, w0"); }
}

// x0 = x0 <op> x1 for integers of type `ty`.
fn emit_int_binary(op: i64, ty: i64) {
    let signed = is_signed(ty);
    if op == TK_PLUS { ins(c"add x0, x0, x1"); }
    else if op == TK_MINUS { ins(c"sub x0, x0, x1"); }
    else if op == TK_STAR { ins(c"mul x0, x0, x1"); }
    else if op == TK_SLASH {
        ins(if signed { c"sdiv x0, x0, x1" } else { c"udiv x0, x0, x1" });
    } else if op == TK_PERCENT {
        ins(if signed { c"sdiv x16, x0, x1" } else { c"udiv x16, x0, x1" });
        ins(c"msub x0, x16, x1, x0");
    } else if op == TK_AMP { ins(c"and x0, x0, x1"); }
    else if op == TK_PIPE { ins(c"orr x0, x0, x1"); }
    else if op == TK_CARET { ins(c"eor x0, x0, x1"); }
    else if op == TK_SHL || op == TK_SHR {
        // The amount is taken modulo 32 for types up to 32 bits (8- and
        // 16-bit values are shifted at 32 bits), modulo 64 for 64-bit ones.
        ins(if int_bits(ty) == 64 { c"and x1, x1, #63" } else { c"and x1, x1, #31" });
        if op == TK_SHL {
            ins(c"lsl x0, x0, x1");
        } else if signed {
            ins(c"asr x0, x0, x1");
        } else {
            ins(c"lsr x0, x0, x1");
        }
    }
    emit_normalize(ty);
}

// The condition code of a comparison.
fn condition(op: i64, signed: bool, float: bool) -> *u8 {
    if op == TK_EQ_EQ { return c"eq"; }
    if op == TK_BANG_EQ { return c"ne"; }
    if float {
        // False when unordered (NaN).
        if op == TK_LT { return c"mi"; }
        if op == TK_LT_EQ { return c"ls"; }
        if op == TK_GT { return c"gt"; }
        return c"ge";
    }
    if op == TK_LT { return if signed { c"lt" } else { c"lo" }; }
    if op == TK_LT_EQ { return if signed { c"le" } else { c"ls" }; }
    if op == TK_GT { return if signed { c"gt" } else { c"hi" }; }
    if signed { c"ge" } else { c"hs" }
}

// x0 = (x0 <op> x1), or of d0/d1 for floats; operands of type `ty`.
fn emit_compare(op: i64, ty: i64) {
    let float = is_float(ty);
    if ty == TY_F32 {
        ins(c"fcmp s0, s1");
    } else if ty == TY_F64 {
        ins(c"fcmp d0, d1");
    } else {
        ins(c"cmp x0, x1");
    }
    o(c"    cset x0, ");
    o(condition(op, is_signed(ty), float));
    on();
}

// d0 = d0 <op> d1 (s registers for f32).
fn emit_float_binary(op: i64, ty: i64) {
    let r = if ty == TY_F32 { c"s" } else { c"d" };
    if op == TK_PERCENT {
        ins(if ty == TY_F32 { c"bl _fmodf" } else { c"bl _fmod" });
        return;
    }
    if op == TK_PLUS { o(c"    fadd "); }
    else if op == TK_MINUS { o(c"    fsub "); }
    else if op == TK_STAR { o(c"    fmul "); }
    else { o(c"    fdiv "); }
    o(r);
    o(c"0, ");
    o(r);
    o(c"0, ");
    o(r);
    o(c"1\n");
}

// ---- Conversions ----

fn emit_int_to_float(from: i64, to: i64) {
    let reg = if to == TY_F32 { c"s0" } else { c"d0" };
    o(if is_signed(from) { c"    scvtf " } else { c"    ucvtf " });
    o(reg);
    o(c", x0\n");
}

fn emit_float_to_float(from: i64, to: i64) {
    if from == to {
        return;
    }
    ins(if to == TY_F64 { c"fcvt d0, s0" } else { c"fcvt s0, d0" });
}

// Saturating conversions (NaN is 0), like the reference backend: signed
// results up to 32 bits convert at 32 bits and wrap, unsigned ones up to
// 32 bits convert signed at 64 bits and wrap; u64 converts unsigned at
// 2^63 and above.
fn emit_float_to_int(from: i64, to: i64) {
    let src = if from == TY_F32 { c"s0" } else { c"d0" };
    if is_signed(to) && int_bits(to) <= 32 {
        o(c"    fcvtzs w0, ");
        o(src);
        on();
        ins(c"sxtw x0, w0");
    } else if to != TY_U64 {
        o(c"    fcvtzs x0, ");
        o(src);
        on();
    } else {
        // x0 = value >= 2^63 ? fcvtzu(value) : fcvtzs(value)
        o(c"    fcvtzs x16, ");
        o(src);
        on();
        o(c"    fcvtzu x17, ");
        o(src);
        on();
        if from == TY_F32 {
            emit_load_imm(9, 0x5f000000);
            ins(c"fmov s1, w9");
            ins(c"fcmp s0, s1");
        } else {
            emit_load_imm(9, 0x43e0000000000000);
            ins(c"fmov d1, x9");
            ins(c"fcmp d0, d1");
        }
        ins(c"csel x0, x17, x16, ge");
    }
    emit_normalize(to);
}

// ---- Functions ----

fn emit_function_start(symbol_prefix: *u8, name: i64, global: bool) {
    let out = ASM;
    buf_str(out, c"\n.p2align 2\n");
    if global {
        buf_str(out, c".globl ");
        buf_str(out, symbol_prefix);
        buf_bytes(out, SYMS[name].ptr, SYMS[name].len);
        buf_byte(out, '\n');
    }
    buf_str(out, symbol_prefix);
    buf_bytes(out, SYMS[name].ptr, SYMS[name].len);
    buf_str(out, c":\n");
    buf_str(out, c"    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n");
}

// Reserves the frame once its size is known.
fn emit_frame_reserve(frame_size: i64) {
    let size = align_to(frame_size, 16);
    if size == 0 {
        return;
    }
    let out = CODE;
    CODE = ASM;
    if size < 4096 {
        ins_i(c"sub sp, sp, #", size, c"");
    } else {
        emit_load_imm(16, size as u64);
        ins(c"sub sp, sp, x16");
    }
    CODE = out;
}

fn emit_epilogue() {
    ins(c"mov sp, x29");
    ins(c"ldp x29, x30, [sp], #16");
    ins(c"ret");
}

// ---- Data ----

fn data_label(prefix: *u8, name: i64) {
    buf_str(DATA, prefix);
    buf_bytes(DATA, SYMS[name].ptr, SYMS[name].len);
    buf_str(DATA, c":\n");
}

// `.byte` lines for `n` bytes at `p`.
fn data_bytes(p: *u8, n: i64) {
    let mut all_zero = true;
    for i in 0..n {
        if p[i] != 0 {
            all_zero = false;
        }
    }
    if all_zero {
        if n > 0 {
            buf_str(DATA, c"    .space ");
            buf_int(DATA, n);
            buf_byte(DATA, '\n');
        }
        return;
    }
    let mut i = 0;
    while i < n {
        buf_str(DATA, c"    .byte ");
        let mut j = 0;
        while j < 16 && i < n {
            if j > 0 {
                buf_byte(DATA, ',');
            }
            buf_uint(DATA, p[i] as u64);
            i += 1;
            j += 1;
        }
        buf_byte(DATA, '\n');
    }
}

fn data_section(writable: bool) {
    buf_str(DATA, if writable { c"\n.section __DATA,__data\n" } else { c"\n.section __TEXT,__const\n" });
}

// log2 of a power of two up to 16.
fn log2(value: i64) -> i64 {
    let mut result = 0;
    while (1 << result as u64) < value {
        result += 1;
    }
    result
}

fn data_align(align: i64) {
    buf_str(DATA, c".p2align ");
    buf_int(DATA, log2(align));
    buf_byte(DATA, '\n');
}

fn data_string(id: i64) {
    buf_str(DATA, c"Lstr.");
    buf_int(DATA, id);
    buf_str(DATA, c":\n");
    data_bytes(STRS[id].ptr, STRS[id].len);
    buf_str(DATA, c"    .byte 0\n");
}
