// Register allocation for the IR back end: linear scan on SSA form, with
// lifetime holes and interval splitting (C. Wimmer and H. Mössenböck,
// "Optimized Interval Splitting in a Linear Scan Register Allocator", VEE
// 2005; C. Wimmer and M. Franz, "Linear Scan Register Allocation on SSA
// Form", CGO 2010).
//
// Positions. Blocks are laid out in reverse post-order (ORDER); block k
// starts at BSTART[k], a multiple of 4, where its phis (and in the entry
// block the parameters) are defined. Its instructions follow 4 apart: the
// one at p reads its operands at p, clobbers registers at p + 1 (a call:
// every caller-saved register) and writes its result at p + 2, and p - 1
// is the gap before it, where moves go. The terminator reads its operands
// at BEND[k]; values live out of the block reach BEND[k] + 2.
//
// Intervals. A value's lifetime is a list of ranges [from, to), with holes,
// and the positions where it is used, with what each use needs: USE_REG a
// register, USE_ANY a register or the stack (call arguments, phi operands,
// returned values: they are moved into place). Uses as immediates or as
// frame addresses are not uses at all. Liveness comes from the usual
// backward data flow over the blocks. Constants and addresses (is_remat)
// get an interval only when some use needs them in a register; on the
// stack, they are rematerialized.
//
// Allocation walks the intervals by start. An interval gets a register
// that is free for its whole lifetime when there is one (its hint first:
// the register of a phi partner, or the argument or result register it
// goes to), else the register free longest, for a first part: the rest is
// split off and allocated later. When none is free at all, the register
// whose next use is farthest (uses in loops count as nearer) is taken
// from the intervals holding it, which go to the stack until just before
// their next use; or, when its own first use is farther still, the
// interval itself goes to the stack until then. Splits that reload a value
// move to a block boundary outside loops when there is one between the
// last and the next use. Registers clobbered by calls (or fixed by an
// instruction) are fixed intervals.
//
// Spilling. A value that goes to the stack anywhere is stored once, right
// after its definition (Wimmer's spill store elimination): going to the
// stack costs nothing, coming back is one load. Values whose lifetimes do
// not overlap share spill slots.
//
// Resolution. A split inside a block becomes a move in the gap where it
// falls. On each edge (critical edges are split first), the locations of
// the values live into the successor and of its phis are reconciled by
// one parallel move, at the end of the predecessor (when it has a single
// successor) or at the start of the successor. 51_emit.tach emits these
// moves; the checker below (--verify-regalloc) simulates them.
//
// Locations (vloc): 0-31 the integer registers (hardware numbers), 32-63
// the float registers (32 + n), -(1 + i) spill slot i, LOC_REMAT a value
// rematerialized where it is needed, LOC_NONE no location.

const LOC_NONE: i64 = 1000000;
const LOC_REMAT: i64 = 1000001;
// An interval's register when it is on the stack, or not allocated yet.
const ON_STACK: i64 = -1;
const UNASSIGNED: i64 = -2;
const POS_MAX: i64 = 0x3fffffffffffffff;

// What a use needs.
const USE_NONE: i64 = 0;
const USE_ANY: i64 = 1;
const USE_REG: i64 = 2;

// A part of a value's lifetime, with one location.
struct Interval {
    // The value (a dense index into RA_VALS) and its location: a register,
    // ON_STACK or UNASSIGNED.
    value: i64, reg: i64,
    // [from, to) pairs and (position, kind) pairs, ascending.
    ranges: IntVec, uses: IntVec,
    // The next part of the same value (split off this one), or -1.
    next: i64,
}
const INTERVAL_SIZE: i64 = 72;

// The function being allocated: its blocks in layout order, and per
// layout index the positions of the block's start and terminator, and its
// loop depth.
static mut ORDER: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut BSTART: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut BEND: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut LDEPTH: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Allocated values: value ids by dense index (INSTS[v].aux = index + 1).
static mut RA_VALS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut IVS: *Interval = 0 as *Interval;
static mut IV_COUNT: i64 = 0;
static mut IV_CAP: i64 = 0;
// Per dense index: the first interval, the spill slot (-1: never on the
// stack), the value whose register it would like (-1), the register it
// would like (-1).
static mut RV_FIRST: *i64 = 0 as *i64;
static mut RV_SLOT: *i64 = 0 as *i64;
static mut RV_HINT: *i64 = 0 as *i64;
static mut RV_HREG: *i64 = 0 as *i64;
static mut RV_CAP: i64 = 0;
// Fixed intervals: per register, the ranges where it is not available.
static mut FIXED: *IntVec = 0 as *IntVec;
// Moves inside blocks: (gap, dense index) pairs, sorted by gap.
static mut SPLIT_MOVES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut SPILL_COUNT: i64 = 0;
// Per register: whether a callee-saved register is used.
static mut CALLEE_USED: [i64; 64] = [0; 64];
// Uses of each instruction (indexed by value id), for the whole program,
// and whether some use needs the value in a register.
static mut USES: *i64 = 0 as *i64;
static mut REG_USED: *i64 = 0 as *i64;
// Liveness: bit sets of dense value indices, per layout index.
static mut LIVE_IN: *u64 = 0 as *u64;
static mut LIVE_OUT: *u64 = 0 as *u64;
static mut LIVE_WORDS: i64 = 0;
// --verify-regalloc: check every allocation by simulating its moves.
static mut VERIFY_REGALLOC: bool = false;

// ---- Preparation ----

// Counts the uses of every value of every function.
fn count_uses() {
    let intervals = 0 as *Interval;
    if &intervals[1] as i64 != INTERVAL_SIZE {
        die(c"internal error: Interval size");
    }
    USES = alloc_zeroed((INST_COUNT + 1) * 8) as *i64;
    REG_USED = alloc_zeroed((INST_COUNT + 1) * 8) as *i64;
    FIXED = alloc_zeroed(64 * 24) as *IntVec;
    for fi in 0..IRFUNC_COUNT {
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if BLOCKS[b].removed != 0 {
                continue;
            }
            let mut v = BLOCKS[b].first;
            while v != 0 {
                for k in 0..ir_operand_count(v) {
                    let operand = ir_operand(v, k);
                    if operand != 0 {
                        USES[operand] += 1;
                    }
                }
                v = INSTS[v].next;
            }
            let cond = BLOCKS[b].cond;
            if cond != 0 {
                USES[cond] += 1;
            }
        }
    }
}

// Splits every critical edge (from a block with several successors to one
// with several predecessors) with an empty block, so that the moves of
// each edge have a place of their own.
fn split_critical_edges(fi: i64) {
    IRF = fi;
    let count = IRFUNCS[fi].blocks.count;
    for i in 0..count {
        let b = IRFUNCS[fi].blocks.data[i];
        if BLOCKS[b].removed != 0 || succ_count(b) < 2 {
            continue;
        }
        if BLOCKS[b].term == Term::Branch && BLOCKS[b].s0 == BLOCKS[b].s1 {
            // Both ways lead to the same block: a jump (one edge less).
            let s = BLOCKS[b].s0;
            let first = pred_index(s, b);
            let mut second = -1;
            for j in first + 1..BLOCKS[s].preds.count {
                if second < 0 && BLOCKS[s].preds.data[j] == b {
                    second = j;
                }
            }
            if second >= 0 {
                for j in second..BLOCKS[s].preds.count - 1 {
                    BLOCKS[s].preds.data[j] = BLOCKS[s].preds.data[j + 1];
                }
                BLOCKS[s].preds.count -= 1;
                let mut phi = BLOCKS[s].first;
                while phi != 0 && INSTS[phi].op == Op::Phi {
                    let gone = ir_arg(phi, second);
                    if gone != 0 {
                        USES[gone] -= 1;
                    }
                    for j in second..INSTS[phi].nargs - 1 {
                        ir_set_arg(phi, j, ir_arg(phi, j + 1));
                    }
                    INSTS[phi].nargs -= 1;
                    phi = INSTS[phi].next;
                }
            }
            USES[BLOCKS[b].cond] -= 1;
            BLOCKS[b].cond = 0;
            BLOCKS[b].term = Term::Jump;
            BLOCKS[b].s1 = 0;
            continue;
        }
        let mut k = 0;
        while k < succ_count(b) {
            let s = succ(b, k);
            k += 1;
            if BLOCKS[s].preds.count < 2 {
                continue;
            }
            let e = ir_new_block();
            BLOCKS[e].sealed = 1;
            BLOCKS[e].term = Term::Jump;
            BLOCKS[e].s0 = s;
            BLOCKS[e].preds.push(b);
            redirect_succ(b, s, e);
            // Same index in the predecessor list, so the phis still match.
            let index = pred_index(s, b);
            BLOCKS[s].preds.data[index] = e;
        }
    }
}

// Lays out the reachable blocks in reverse post-order (BLOCKS[b].order is
// the layout index, -1 for unreachable blocks), and finds their loop
// depths.
fn layout_blocks(fi: i64) {
    for i in 0..IRFUNCS[fi].blocks.count {
        let b = IRFUNCS[fi].blocks.data[i];
        BLOCKS[b].order = -1;
        BLOCKS[b].mark = 0;
    }
    ORDER.count = 0;
    // Iterative depth-first search; post-order into ORDER, reversed below.
    let mut stack = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    let entry = IRFUNCS[fi].entry;
    stack.push(entry);
    stack.push(0);
    BLOCKS[entry].mark = 1;
    while stack.count > 0 {
        let b = stack.data[stack.count - 2];
        let next = stack.data[stack.count - 1];
        if next < succ_count(b) {
            stack.data[stack.count - 1] = next + 1;
            // The second successor first, so that the first one comes
            // right after the block when it can.
            let s = succ(b, succ_count(b) - 1 - next);
            if BLOCKS[s].mark == 0 {
                BLOCKS[s].mark = 1;
                stack.push(s);
                stack.push(0);
            }
        } else {
            stack.count -= 2;
            ORDER.push(b);
        }
    }
    let n = ORDER.count;
    for i in 0..n / 2 {
        let t = ORDER.data[i];
        ORDER.data[i] = ORDER.data[n - 1 - i];
        ORDER.data[n - 1 - i] = t;
    }
    for i in 0..n {
        BLOCKS[ORDER.data[i]].order = i;
    }
    // Loops: an edge to a block not later in the order is a back edge
    // (the graph is reducible); the loop of header h is h and the blocks
    // reaching a latch without passing h.
    LDEPTH.count = 0;
    for _ in 0..n {
        LDEPTH.push(0);
    }
    for h in 0..n {
        let header = ORDER.data[h];
        stack.count = 0;
        for i in 0..BLOCKS[header].preds.count {
            let p = BLOCKS[header].preds.data[i];
            if BLOCKS[p].order >= h {
                stack.push(p);
            }
        }
        if stack.count == 0 {
            continue;
        }
        for k in 0..n {
            BLOCKS[ORDER.data[k]].mark = 0;
        }
        BLOCKS[header].mark = 1;
        LDEPTH.data[h] += 1;
        while stack.count > 0 {
            let b = stack.pop();
            if BLOCKS[b].mark != 0 || BLOCKS[b].order < 0 {
                continue;
            }
            BLOCKS[b].mark = 1;
            LDEPTH.data[BLOCKS[b].order] += 1;
            for i in 0..BLOCKS[b].preds.count {
                stack.push(BLOCKS[b].preds.data[i]);
            }
        }
    }
    free(stack.data as *u8);
}

// Whether compare `v` is fused into the branch that ends its block.
fn is_fused_compare(v: i64) -> bool {
    let b = INSTS[v].block;
    INSTS[v].op == Op::Cmp && USES[v] == 1 && BLOCKS[b].term == Term::Branch
        && BLOCKS[b].cond == v && INSTS[v].next == 0 && !is_float(INSTS[v].imm2)
}

// How instruction v uses its operand i (see ir_operand).
fn use_kind(v: i64, i: i64) -> i64 {
    let operand = ir_operand(v, i);
    if operand == 0 {
        return USE_NONE;
    }
    let op = INSTS[v].op;
    if op.is_call() {
        if i == 2 && INSTS[operand].op == Op::Slot && !call_returns_through_pointer(v) {
            return USE_NONE;
        }
        return USE_ANY;
    }
    if op == Op::Phi {
        return USE_ANY;
    }
    if (op == Op::Load || op == Op::Store) && i == 0 && INSTS[operand].op == Op::Slot {
        return USE_NONE;
    }
    if op.is_binary() && i == 1 && !is_float(INSTS[v].ty) && op != Op::Div && op != Op::Rem
        && INSTS[operand].op == Op::Const && m_int_imm_ok(op, INSTS[v].ty, INSTS[operand].imm) {
        return USE_NONE;
    }
    USE_REG
}

// The operands the terminator of block b reads (at BEND), with their
// kinds: up to two (value, kind) pairs in out; returns the count.
fn term_uses(b: i64, out: *i64) -> i64 {
    let cond = BLOCKS[b].cond;
    let term = BLOCKS[b].term;
    if cond == 0 {
        return 0;
    }
    if term == Term::Ret {
        let ret = FNS[IRFUNCS[IRF].f].ret;
        if is_compound(ret) && !conv_returns_through_pointer(fn_uses_c(IRFUNCS[IRF].f), ret) && INSTS[cond].op == Op::Slot {
            return 0;
        }
        out[0] = cond;
        out[1] = USE_ANY;
        return 1;
    }
    if term == Term::Branch && is_fused_compare(cond) {
        out[0] = INSTS[cond].a;
        out[1] = USE_REG;
        let rhs = INSTS[cond].b;
        if INSTS[rhs].op == Op::Const && fits_cmp_imm(INSTS[rhs].imm) {
            return 1;
        }
        out[2] = rhs;
        out[3] = USE_REG;
        return 2;
    }
    if term == Term::Branch || term == Term::Switch {
        out[0] = cond;
        out[1] = USE_REG;
        return 1;
    }
    0
}

// Whether a use of kind `kind` of value `v` makes it live: remat values
// only when they are needed in a register (else they are rematerialized
// where they are needed).
fn is_live_use(v: i64, kind: i64) -> bool {
    kind == USE_REG || (kind == USE_ANY && !INSTS[v].op.is_remat())
}

// Whether `v` is computed where it is defined.
fn is_emitted(v: i64) -> bool {
    let op = INSTS[v].op;
    if op == Op::Phi || op == Op::Param {
        return false;
    }
    if op.is_remat() {
        if INSTS[v].aux == 0 {
            return false;
        }
        let loc = vloc(v, INSTS[v].mark + 2);
        return loc >= 0 && loc < 64;
    }
    op.has_side_effect() || USES[v] > 0
}

fn needs_location(v: i64) -> bool {
    let op = INSTS[v].op;
    if INSTS[v].ty == 0 || USES[v] == 0 || is_fused_compare(v) {
        return false;
    }
    !op.is_remat() || REG_USED[v] != 0
}

// ---- Positions and liveness ----

fn ra_reserve(n: i64) {
    if n <= RV_CAP {
        return;
    }
    let mut cap = RV_CAP * 2;
    if cap < n {
        cap = n;
    }
    if cap < 1024 {
        cap = 1024;
    }
    free(RV_FIRST as *u8);
    free(RV_SLOT as *u8);
    free(RV_HINT as *u8);
    free(RV_HREG as *u8);
    RV_FIRST = alloc_zeroed(cap * 8) as *i64;
    RV_SLOT = alloc_zeroed(cap * 8) as *i64;
    RV_HINT = alloc_zeroed(cap * 8) as *i64;
    RV_HREG = alloc_zeroed(cap * 8) as *i64;
    RV_CAP = cap;
}

// Marks the values some use needs in a register.
fn mark_reg_uses() {
    let mut out: [i64; 4] = [0; 4];
    for k in 0..ORDER.count {
        let b = ORDER.data[k];
        let mut v = BLOCKS[b].first;
        while v != 0 {
            if !is_fused_compare(v) {
                for i in 0..ir_operand_count(v) {
                    if use_kind(v, i) == USE_REG {
                        REG_USED[ir_operand(v, i)] = 1;
                    }
                }
            }
            v = INSTS[v].next;
        }
        let n = term_uses(b, &out as *i64);
        for i in 0..n {
            if out[2 * i + 1] == USE_REG {
                REG_USED[out[2 * i]] = 1;
            }
        }
    }
}

// Numbers the instructions and the allocated values.
fn number_positions() {
    BSTART.count = 0;
    BEND.count = 0;
    RA_VALS.count = 0;
    let mut pos = 0;
    for k in 0..ORDER.count {
        let b = ORDER.data[k];
        let start = pos;
        BSTART.push(start);
        let mut v = BLOCKS[b].first;
        while v != 0 {
            let op = INSTS[v].op;
            if op == Op::Phi || op == Op::Param {
                INSTS[v].mark = start;
            } else {
                pos += 4;
                INSTS[v].mark = pos;
            }
            INSTS[v].aux = 0;
            if needs_location(v) {
                RA_VALS.push(v);
                INSTS[v].aux = RA_VALS.count;
            }
            v = INSTS[v].next;
        }
        pos += 4;
        BEND.push(pos);
        pos += 4;
    }
    ra_reserve(RA_VALS.count);
}

fn bit_set(set: *u64, i: i64) {
    set[i >> 6] |= (1 as u64) << (i & 63) as u64;
}

fn bit_clear(set: *u64, i: i64) {
    set[i >> 6] &= ~((1 as u64) << (i & 63) as u64);
}

fn bit_get(set: *u64, i: i64) -> bool {
    (set[i >> 6] >> (i & 63) as u64) & 1 != 0
}

fn live_set(sets: *u64, k: i64) -> *u64 {
    &sets[k * LIVE_WORDS]
}

// The dense index of operand `v` if it is allocated, else -1.
fn tracked(v: i64) -> i64 {
    if v == 0 {
        return -1;
    }
    INSTS[v].aux - 1
}

fn compute_liveness() {
    let n = ORDER.count;
    LIVE_WORDS = (RA_VALS.count + 63) / 64 + 1;
    free(LIVE_IN as *u8);
    free(LIVE_OUT as *u8);
    LIVE_IN = alloc_zeroed(n * LIVE_WORDS * 8 + 8) as *u64;
    LIVE_OUT = alloc_zeroed(n * LIVE_WORDS * 8 + 8) as *u64;
    let gen = alloc_zeroed(n * LIVE_WORDS * 8 + 8) as *u64;
    let kill = alloc_zeroed(n * LIVE_WORDS * 8 + 8) as *u64;
    let mut out: [i64; 4] = [0; 4];
    for k in 0..n {
        let b = ORDER.data[k];
        let g = live_set(gen, k);
        let d = live_set(kill, k);
        let mut v = BLOCKS[b].first;
        while v != 0 {
            if INSTS[v].op != Op::Phi && !is_fused_compare(v) {
                for i in 0..ir_operand_count(v) {
                    let operand = ir_operand(v, i);
                    let t = tracked(operand);
                    if t >= 0 && is_live_use(operand, use_kind(v, i)) && !bit_get(d, t) {
                        bit_set(g, t);
                    }
                }
            }
            let t = tracked(v);
            if t >= 0 {
                bit_set(d, t);
            }
            v = INSTS[v].next;
        }
        let count = term_uses(b, &out as *i64);
        for i in 0..count {
            let t = tracked(out[2 * i]);
            if t >= 0 && is_live_use(out[2 * i], out[2 * i + 1]) && !bit_get(d, t) {
                bit_set(g, t);
            }
        }
    }
    let mut changed = true;
    while changed {
        changed = false;
        let mut k = n - 1;
        while k >= 0 {
            let b = ORDER.data[k];
            let live_out = live_set(LIVE_OUT, k);
            for i in 0..succ_count(b) {
                let s = succ(b, i);
                let sk = BLOCKS[s].order;
                let sin = live_set(LIVE_IN, sk);
                for w in 0..LIVE_WORDS {
                    live_out[w] |= sin[w];
                }
                // Phi operands flowing from b.
                let index = pred_index(s, b);
                let mut phi = BLOCKS[s].first;
                while phi != 0 && INSTS[phi].op == Op::Phi {
                    let arg = ir_arg(phi, index);
                    let t = tracked(arg);
                    if t >= 0 && tracked(phi) >= 0 && is_live_use(arg, USE_ANY) {
                        bit_set(live_out, t);
                    }
                    phi = INSTS[phi].next;
                }
            }
            let live_in = live_set(LIVE_IN, k);
            let g = live_set(gen, k);
            let d = live_set(kill, k);
            for w in 0..LIVE_WORDS {
                let value = g[w] | (live_out[w] & ~d[w]);
                if value != live_in[w] {
                    live_in[w] = value;
                    changed = true;
                }
            }
            k -= 1;
        }
    }
    free(gen as *u8);
    free(kill as *u8);
}

// ---- Intervals ----

fn iv_new(t: i64) -> i64 {
    IVS = grow(IVS as *u8, IV_COUNT, &IV_CAP, INTERVAL_SIZE) as *Interval;
    let i = IV_COUNT;
    IVS[i] = Interval {
        value: t, reg: UNASSIGNED,
        ranges: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        uses: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        next: -1,
    };
    IV_COUNT += 1;
    i
}

// Frees every interval (and the fixed ones' ranges).
fn iv_reset() {
    for i in 0..IV_COUNT {
        free(IVS[i].ranges.data as *u8);
        free(IVS[i].uses.data as *u8);
    }
    IV_COUNT = 0;
    for r in 0..64 {
        free(FIXED[r].data as *u8);
        FIXED[r] = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    }
}

fn ra_start(i: i64) -> i64 {
    IVS[i].ranges.data[0]
}

fn ra_end(i: i64) -> i64 {
    IVS[i].ranges.data[IVS[i].ranges.count - 1]
}

// While building (backwards), ranges and uses are kept in descending
// order, then reversed.

// Adds [from, to) below the ranges so far (merging with the lowest one).
fn rev_add_range(list: *IntVec, from: i64, to: i64) {
    let n = list.count;
    if n > 0 && to >= list.data[n - 2] {
        if from < list.data[n - 2] {
            list.data[n - 2] = from;
        }
        if to > list.data[n - 1] {
            list.data[n - 1] = to;
        }
        return;
    }
    list.push(from);
    list.push(to);
}

fn rev_add_use(t: i64, pos: i64, kind: i64) {
    let i = RV_FIRST[t];
    let n = IVS[i].uses.count;
    if n > 0 && IVS[i].uses.data[n - 2] == pos {
        if kind > IVS[i].uses.data[n - 1] {
            IVS[i].uses.data[n - 1] = kind;
        }
        return;
    }
    IVS[i].uses.push(pos);
    IVS[i].uses.push(kind);
}

// Value t is used at `pos` (in the block starting at `start`).
fn ra_add_use(t: i64, start: i64, pos: i64, kind: i64, live: *u64) {
    let i = RV_FIRST[t];
    rev_add_range(&IVS[i].ranges, start, pos + 1);
    rev_add_use(t, pos, kind);
    bit_set(live, t);
}

// Value t is defined at `pos` (in the block starting at `start`).
fn add_def(t: i64, start: i64, pos: i64, kind: i64, live: *u64) {
    let i = RV_FIRST[t];
    let n = IVS[i].ranges.count;
    if n > 0 && IVS[i].ranges.data[n - 2] == start && IVS[i].ranges.data[n - 1] > pos {
        IVS[i].ranges.data[n - 2] = pos;
    } else {
        // Never used after: it still needs a place to be written.
        IVS[i].ranges.push(pos);
        IVS[i].ranges.push(pos + 1);
    }
    if kind != USE_NONE {
        rev_add_use(t, pos, kind);
    }
    bit_clear(live, t);
}

fn reverse_pairs(list: *IntVec) {
    let n = list.count / 2;
    for i in 0..n / 2 {
        let j = n - 1 - i;
        let a = list.data[2 * i];
        let b = list.data[2 * i + 1];
        list.data[2 * i] = list.data[2 * j];
        list.data[2 * i + 1] = list.data[2 * j + 1];
        list.data[2 * j] = a;
        list.data[2 * j + 1] = b;
    }
}

fn add_fixed(r: i64, from: i64, to: i64) {
    rev_add_range(&FIXED[r], from, to);
}

// ---- Calls that return twice ----
//
// setjmp and the like return again when something longjmps to them: then
// the code after them runs again with the registers as the longjmp left
// them (callee-saved ones as they were at the setjmp) and the frame as it
// is now. So no register keeps a value across such a call (it clobbers
// every register: what lives across is on the stack, stored before),
// spill slots are not shared in its function (a slot reused after the
// call would be wrong after the second return), and the function is never
// a sibling caller, nor inlined, nor inlined into.

fn sym_is(name: i64, s: *u8) -> bool {
    let text = SYMS[name].text;
    let n = strlen(s) as i64;
    text.len == n && memcmp(text.ptr, s, n as u64) == 0
}

fn is_returns_twice_call(v: i64) -> bool {
    let op = INSTS[v].op;
    let mut name = 0;
    if op == Op::Call {
        name = FNS[INSTS[v].imm].name;
    } else if op == Op::CallC {
        name = INSTS[v].imm;
    } else {
        return false;
    }
    sym_is(name, c"setjmp") || sym_is(name, c"_setjmp") || sym_is(name, c"sigsetjmp")
        || sym_is(name, c"__sigsetjmp") || sym_is(name, c"savectx") || sym_is(name, c"vfork")
        || sym_is(name, c"getcontext")
}

fn calls_returns_twice(fi: i64) -> bool {
    for i in 0..IRFUNCS[fi].blocks.count {
        let b = IRFUNCS[fi].blocks.data[i];
        if BLOCKS[b].removed == 0 {
            let mut v = BLOCKS[b].first;
            while v != 0 {
                if is_returns_twice_call(v) {
                    return true;
                }
                v = INSTS[v].next;
            }
        }
    }
    false
}

// Whether the function being allocated calls one.
static mut RETURNS_TWICE: bool = false;

// Registers clobbered by the instruction at p (besides its result).
fn add_clobbers(v: i64, p: i64) {
    let op = INSTS[v].op;
    if op.is_call() {
        let all = is_returns_twice_call(v);
        for r in 0..64 {
            if is_allocatable(r) && (all || !is_callee_saved_reg(r)) {
                add_fixed(r, p + 1, p + 2);
            }
        }
        return;
    }
    if X86 && !is_float(INSTS[v].ty) {
        // Division uses rax and rdx, shifts by a register cl, from the
        // reading of the operands to the writing of the result.
        if (op == Op::Div || op == Op::Rem) && is_allocatable(0) {
            add_fixed(0, p, p + 3);
            add_fixed(2, p, p + 3);
        }
        if (op == Op::Shl || op == Op::Shr) && INSTS[INSTS[v].b].op != Op::Const && is_allocatable(1) {
            add_fixed(1, p, p + 3);
        }
    }
}

// The hints of instruction v (at p): its result's register, its operands'.
fn add_hints(v: i64) {
    let op = INSTS[v].op;
    let t = tracked(v);
    if op.is_call() {
        if t >= 0 && RV_HREG[t] < 0 {
            RV_HREG[t] = reg_ret(is_float(INSTS[v].ty));
        }
        let mut locations: [i64; 64] = [0; 64];
        let mut copies: [i64; 64] = [0; 64];
        let mut float_regs = 0;
        call_locations(v, &locations as *i64, &copies as *i64, &float_regs);
        for i in 0..INSTS[v].nargs {
            let a = tracked(ir_arg(v, i));
            if a >= 0 && !xl_is_stack(locations[i]) && RV_HREG[a] < 0 && USES[ir_arg(v, i)] == 1 {
                RV_HREG[a] = arg_reg(locations[i]);
            }
        }
        return;
    }
    if t < 0 {
        return;
    }
    if op.is_binary() || op == Op::Neg || op == Op::BNot || op == Op::Conv {
        let a = tracked(INSTS[v].a);
        if a >= 0 && RV_HINT[t] < 0 && is_float(INSTS[INSTS[v].a].ty) == is_float(INSTS[v].ty) {
            RV_HINT[t] = a;
        }
    }
}

fn build_intervals() {
    iv_reset();
    SPLIT_MOVES.count = 0;
    for t in 0..RA_VALS.count {
        RV_FIRST[t] = iv_new(t);
        RV_SLOT[t] = -1;
        RV_HINT[t] = -1;
        RV_HREG[t] = -1;
    }
    let live = alloc_zeroed(LIVE_WORDS * 8 + 8) as *u64;
    let mut out: [i64; 4] = [0; 4];
    let mut k = ORDER.count - 1;
    while k >= 0 {
        let b = ORDER.data[k];
        let start = BSTART.data[k];
        let end = BEND.data[k];
        let live_out = live_set(LIVE_OUT, k);
        for w in 0..LIVE_WORDS {
            live[w] = live_out[w];
            let mut bits = live_out[w];
            while bits != 0 {
                let bit = trailing_zeros(bits);
                bits &= bits - 1;
                let t = w * 64 + bit;
                rev_add_range(&IVS[RV_FIRST[t]].ranges, start, end + 2);
            }
        }
        let count = term_uses(b, &out as *i64);
        for i in 0..count {
            let t = tracked(out[2 * i]);
            if t >= 0 && is_live_use(out[2 * i], out[2 * i + 1]) {
                ra_add_use(t, start, end, out[2 * i + 1], live);
            }
        }
        if BLOCKS[b].term == Term::Ret && count > 0 {
            let t = tracked(out[0]);
            if t >= 0 && RV_HREG[t] < 0 && !is_compound(FNS[IRFUNCS[IRF].f].ret) {
                RV_HREG[t] = reg_ret(is_float(INSTS[out[0]].ty));
            }
        }
        let mut v = BLOCKS[b].last;
        while v != 0 {
            let op = INSTS[v].op;
            if op != Op::Phi && op != Op::Param && !is_fused_compare(v) {
                let p = INSTS[v].mark;
                let t = tracked(v);
                if t >= 0 {
                    add_def(t, start, p + 2, if op.is_remat() { USE_NONE } else { USE_REG }, live);
                }
                add_clobbers(v, p);
                add_hints(v);
                for i in 0..ir_operand_count(v) {
                    let operand = ir_operand(v, i);
                    let kind = use_kind(v, i);
                    let a = tracked(operand);
                    if a >= 0 && is_live_use(operand, kind) {
                        // An aggregate result in registers is stored through
                        // its address after the call.
                        let at = if op.is_call() && i == 2 && !call_returns_through_pointer(v) { p + 2 } else { p };
                        ra_add_use(a, start, at, kind, live);
                    }
                }
            }
            v = INSTS[v].prev;
        }
        // Phis and parameters, defined at the start (parameters may come
        // after other instructions of the entry block).
        v = BLOCKS[b].first;
        while v != 0 {
            let t = tracked(v);
            let op = INSTS[v].op;
            if t >= 0 && (op == Op::Phi || op == Op::Param) {
                add_def(t, start, start, USE_NONE, live);
            }
            v = INSTS[v].next;
        }
        k -= 1;
    }
    free(live as *u8);
    for t in 0..RA_VALS.count {
        let i = RV_FIRST[t];
        reverse_pairs(&IVS[i].ranges);
        reverse_pairs(&IVS[i].uses);
    }
    for r in 0..64 {
        reverse_pairs(&FIXED[r]);
    }
    phi_hints();
    param_hints();
}

// A phi operand would like its phi's register; a phi, the register of the
// phi it flows into, else of an operand (coalescing them removes moves).
fn phi_hints() {
    for k in 0..ORDER.count {
        let mut v = BLOCKS[ORDER.data[k]].first;
        while v != 0 && INSTS[v].op == Op::Phi {
            let t = tracked(v);
            if t >= 0 {
                for i in 0..INSTS[v].nargs {
                    let a = tracked(ir_arg(v, i));
                    if a >= 0 && RV_HINT[a] < 0 {
                        RV_HINT[a] = t;
                    }
                }
            }
            v = INSTS[v].next;
        }
    }
    for k in 0..ORDER.count {
        let mut v = BLOCKS[ORDER.data[k]].first;
        while v != 0 && INSTS[v].op == Op::Phi {
            let t = tracked(v);
            if t >= 0 && RV_HINT[t] < 0 {
                for i in 0..INSTS[v].nargs {
                    let a = tracked(ir_arg(v, i));
                    if a >= 0 && RV_HINT[t] < 0 {
                        RV_HINT[t] = a;
                    }
                }
            }
            v = INSTS[v].next;
        }
    }
}

// Parameters would like the register they arrive in.
fn param_hints() {
    let f = IRFUNCS[IRF].f;
    let mut locations: [i64; 64] = [0; 64];
    let mut pieces: [i64; 256] = [0; 256];
    if FNS[f].param_count > 64 {
        return;
    }
    param_locations(f, &locations as *i64, &pieces as *i64);
    let mut v = BLOCKS[IRFUNCS[IRF].entry].first;
    while v != 0 {
        let t = tracked(v);
        if INSTS[v].op == Op::Param && t >= 0 && INSTS[v].imm >= 0 {
            let index = INSTS[v].imm;
            let piece = INSTS[v].imm2;
            let location = if piece > 0 { pieces[4 * index + piece - 1] } else { locations[index] };
            if piece >= 0 && !xl_is_stack(location) {
                RV_HREG[t] = arg_reg(location);
            }
        }
        v = INSTS[v].next;
    }
}

fn trailing_zeros(bits: u64) -> i64 {
    let mut n = 0;
    let mut x = bits;
    while x & 0xff == 0 {
        x >>= 8;
        n += 8;
    }
    while x & 1 == 0 {
        x >>= 1;
        n += 1;
    }
    n
}

// The index of the last range of `list` starting at or before pos, or -1.
fn ra_range_at(list: *IntVec, pos: i64) -> i64 {
    let mut lo = 0;
    let mut hi = list.count / 2;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if list.data[2 * mid] <= pos {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo - 1
}

fn covers(i: i64, pos: i64) -> bool {
    let r = ra_range_at(&IVS[i].ranges, pos);
    r >= 0 && pos < IVS[i].ranges.data[2 * r + 1]
}

// The first position at or after `from` in both range lists, or POS_MAX.
fn next_intersection(a: *IntVec, b: *IntVec, from: i64) -> i64 {
    let mut i = ra_range_at(a, from);
    if i < 0 {
        i = 0;
    }
    let mut j = ra_range_at(b, from);
    if j < 0 {
        j = 0;
    }
    let na = a.count / 2;
    let nb = b.count / 2;
    while i < na && j < nb {
        let lo = max_i64(max_i64(a.data[2 * i], b.data[2 * j]), from);
        let hi = min_i64(a.data[2 * i + 1], b.data[2 * j + 1]);
        if lo < hi {
            return lo;
        }
        if a.data[2 * i + 1] < b.data[2 * j + 1] {
            i += 1;
        } else {
            j += 1;
        }
    }
    POS_MAX
}

// The first use of interval i at or after pos needing at least `kind`.
fn next_use(i: i64, pos: i64, kind: i64) -> i64 {
    let uses = &IVS[i].uses;
    let n = uses.count / 2;
    let mut lo = 0;
    let mut hi = n;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if uses.data[2 * mid] < pos {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    while lo < n {
        if uses.data[2 * lo + 1] >= kind {
            return uses.data[2 * lo];
        }
        lo += 1;
    }
    POS_MAX
}

fn min_i64(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

// The layout index of the block holding position pos.
fn block_at(pos: i64) -> i64 {
    let mut lo = 0;
    let mut hi = BSTART.count;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if BSTART.data[mid] <= pos {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo - 1
}

fn is_block_start(pos: i64) -> bool {
    let k = block_at(pos);
    k >= 0 && BSTART.data[k] == pos
}

// Splits interval i at pos: i keeps what comes before, the new interval
// (returned) the rest. A split inside a block, where the value is live,
// moves it in the gap at pos (only gaps hold moves: a split anywhere else
// must leave the rest on the stack).
fn split_at(i: i64, pos: i64) -> i64 {
    let child = iv_new(IVS[i].value);
    let n = IVS[i].ranges.count / 2;
    let mut r = 0;
    while r < n && IVS[i].ranges.data[2 * r + 1] <= pos {
        r += 1;
    }
    let mut live_across = false;
    let mut cut = 0;
    if r < n && IVS[i].ranges.data[2 * r] < pos {
        live_across = true;
        IVS[child].ranges.push(pos);
        IVS[child].ranges.push(IVS[i].ranges.data[2 * r + 1]);
        IVS[i].ranges.data[2 * r + 1] = pos;
        cut = r + 1;
        r += 1;
    } else {
        cut = r;
    }
    while r < n {
        IVS[child].ranges.push(IVS[i].ranges.data[2 * r]);
        IVS[child].ranges.push(IVS[i].ranges.data[2 * r + 1]);
        r += 1;
    }
    IVS[i].ranges.count = 2 * cut;
    let m = IVS[i].uses.count / 2;
    let mut u = 0;
    while u < m && IVS[i].uses.data[2 * u] < pos {
        u += 1;
    }
    let keep = u;
    while u < m {
        IVS[child].uses.push(IVS[i].uses.data[2 * u]);
        IVS[child].uses.push(IVS[i].uses.data[2 * u + 1]);
        u += 1;
    }
    IVS[i].uses.count = 2 * keep;
    IVS[child].next = IVS[i].next;
    IVS[i].next = child;
    if IVS[i].ranges.count == 0 || IVS[child].ranges.count == 0 {
        die(c"internal error: empty interval after a split");
    }
    if live_across && !is_block_start(pos) && pos % 4 == 3 {
        SPLIT_MOVES.push(pos);
        SPLIT_MOVES.push(IVS[i].value);
    }
    child
}

// The latest position at or before max where a value can move (a gap, or
// a block start), not before min; -1 if there is none.
fn move_point_before(max: i64, min: i64) -> i64 {
    let k = block_at(max);
    let start = BSTART.data[k];
    let end = BEND.data[k];
    let mut q = 0;
    if max >= end {
        q = end - 1;
    } else {
        q = max - (max + 1) % 4;
        if q < start + 3 {
            q = start;
        }
    }
    if q < min { -1 } else { q }
}

// Where to split between min and max for a value to come back into a
// register (or change register): the last move point before max, or the
// start of the outermost block in between when that is less deep in loops
// (so that reloads leave loops).
fn split_point(min: i64, max: i64) -> i64 {
    let kmin = block_at(min);
    let kmax = block_at(max);
    if kmax > kmin {
        let mut best = kmax;
        let mut k = kmax;
        while k > kmin {
            if LDEPTH.data[k] < LDEPTH.data[best] {
                best = k;
            }
            k -= 1;
        }
        if best != kmax {
            return BSTART.data[best];
        }
    }
    move_point_before(max, min)
}

// The gap before the instruction using a value at `use_pos` (p for an
// operand, p + 2 for a result, the end of a block for the terminator).
fn gap_before(use_pos: i64) -> i64 {
    use_pos - 1 - use_pos % 4
}

// ---- Registers ----

// The registers allocated, in order of preference: caller-saved first.
fn class_regs(float: bool, regs: *i64) -> i64 {
    let mut n = 0;
    if X86 {
        if float {
            for r in 2..14 { regs[n] = 32 + r; n += 1; }
            regs[n] = 32; n += 1;
            regs[n] = 33; n += 1;
            return n;
        }
        let list: [i64; 12] = [6, 7, 8, 9, 0, 1, 2, 3, 12, 13, 14, 15];
        for i in 0..12 {
            if is_allocatable(list[i]) {
                regs[n] = list[i];
                n += 1;
            }
        }
        return n;
    }
    if float {
        for r in 16..30 { regs[n] = 32 + r; n += 1; }
        for r in 0..8 { regs[n] = 32 + r; n += 1; }
        for r in 8..16 { regs[n] = 32 + r; n += 1; }
        return n;
    }
    for r in 9..16 { regs[n] = r; n += 1; }
    for r in 0..9 { regs[n] = r; n += 1; }
    for r in 19..29 { regs[n] = r; n += 1; }
    n
}

// x86-64 keeps rax, rcx and rdx out of allocation while the machine layer
// still uses them inside instructions.
static mut X86_ALLOC_ACD: bool = true;

fn is_allocatable(r: i64) -> bool {
    if X86 {
        if r >= 32 {
            return r < 46;
        }
        if r == 0 || r == 1 || r == 2 {
            return X86_ALLOC_ACD;
        }
        return r == 3 || r == 6 || r == 7 || r == 8 || r == 9 || (r >= 12 && r <= 15);
    }
    if r >= 32 {
        return r < 62;
    }
    r <= 15 || (r >= 19 && r <= 28)
}

fn is_callee_saved_reg(r: i64) -> bool {
    if X86 {
        return r == 3 || (r >= 12 && r <= 15);
    }
    (r >= 19 && r <= 28) || (r >= 40 && r <= 47)
}

// ---- Linear scan ----

static mut ACTIVE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut INACTIVE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Unhandled intervals: a binary heap by (start, id).
static mut UNHANDLED: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut FREE_UNTIL: [i64; 64] = [0; 64];
static mut USE_POS: [i64; 64] = [0; 64];
static mut BLOCK_POS: [i64; 64] = [0; 64];

fn heap_less(a: i64, b: i64) -> bool {
    let sa = ra_start(a);
    let sb = ra_start(b);
    sa < sb || (sa == sb && a < b)
}

fn heap_push(i: i64) {
    UNHANDLED.push(i);
    let mut k = UNHANDLED.count - 1;
    while k > 0 {
        let parent = (k - 1) / 2;
        if !heap_less(UNHANDLED.data[k], UNHANDLED.data[parent]) {
            break;
        }
        let t = UNHANDLED.data[k];
        UNHANDLED.data[k] = UNHANDLED.data[parent];
        UNHANDLED.data[parent] = t;
        k = parent;
    }
}

fn heap_pop() -> i64 {
    let top = UNHANDLED.data[0];
    UNHANDLED.count -= 1;
    let n = UNHANDLED.count;
    if n > 0 {
        UNHANDLED.data[0] = UNHANDLED.data[n];
        let mut k = 0;
        loop {
            let l = 2 * k + 1;
            let r = l + 1;
            let mut m = k;
            if l < n && heap_less(UNHANDLED.data[l], UNHANDLED.data[m]) {
                m = l;
            }
            if r < n && heap_less(UNHANDLED.data[r], UNHANDLED.data[m]) {
                m = r;
            }
            if m == k {
                break;
            }
            let t = UNHANDLED.data[k];
            UNHANDLED.data[k] = UNHANDLED.data[m];
            UNHANDLED.data[m] = t;
            k = m;
        }
    }
    top
}

fn iv_float(i: i64) -> bool {
    is_float(INSTS[RA_VALS.data[IVS[i].value]].ty)
}

fn iv_remat(i: i64) -> bool {
    INSTS[RA_VALS.data[IVS[i].value]].op.is_remat()
}

// How soon a use at `pos` comes after `from`, for choosing what to spill:
// uses in loops count as nearer (by 4 per level), remat values are cheap
// to bring back; between equals, the nearer position.
fn use_distance(i: i64, pos: i64, from: i64) -> i64 {
    if pos >= POS_MAX {
        return POS_MAX;
    }
    let depth = min_i64(LDEPTH.data[block_at(pos)], 6);
    let raw = pos - from;
    let mut d = raw >> (2 * depth) as u64;
    if iv_remat(i) {
        d = d * 4 + 3;
    }
    (d << 20) | min_i64(raw, 0xfffff)
}

// The register the value of interval i would like, or -1: its partner's
// (a phi and its operands), else the register it arrives in or goes to.
fn hint_reg(i: i64) -> i64 {
    let t = IVS[i].value;
    let mut other = RV_HINT[t];
    // The partner's register, or (not allocated yet) its own partner's.
    for _ in 0..2 {
        if other < 0 || other == t {
            break;
        }
        let mut j = RV_FIRST[other];
        while j >= 0 {
            if IVS[j].reg >= 0 {
                return IVS[j].reg;
            }
            j = IVS[j].next;
        }
        other = RV_HINT[other];
    }
    RV_HREG[t]
}

fn assign(i: i64, r: i64) {
    IVS[i].reg = r;
    if is_callee_saved_reg(r) {
        CALLEE_USED[r] = 1;
    }
}

fn try_allocate_free(cur: i64) -> bool {
    let mut regs: [i64; 32] = [0; 32];
    let n = class_regs(iv_float(cur), &regs as *i64);
    let start = ra_start(cur);
    let end = ra_end(cur);
    for k in 0..n {
        FREE_UNTIL[regs[k]] = POS_MAX;
    }
    for k in 0..ACTIVE.count {
        FREE_UNTIL[IVS[ACTIVE.data[k]].reg] = 0;
    }
    for k in 0..INACTIVE.count {
        let a = INACTIVE.data[k];
        let r = IVS[a].reg;
        if FREE_UNTIL[r] > 0 {
            let x = next_intersection(&IVS[a].ranges, &IVS[cur].ranges, start);
            if x < FREE_UNTIL[r] {
                FREE_UNTIL[r] = x;
            }
        }
    }
    for k in 0..n {
        let r = regs[k];
        if FREE_UNTIL[r] > 0 && FIXED[r].count > 0 {
            let x = next_intersection(&FIXED[r], &IVS[cur].ranges, start);
            if x < FREE_UNTIL[r] {
                FREE_UNTIL[r] = x;
            }
        }
    }
    let hint = hint_reg(cur);
    if hint >= 0 && (hint >= 32) == iv_float(cur) && is_allocatable(hint) && FREE_UNTIL[hint] >= end {
        assign(cur, hint);
        return true;
    }
    let mut best = regs[0];
    for k in 0..n {
        let r = regs[k];
        if FREE_UNTIL[r] >= end {
            assign(cur, r);
            return true;
        }
        if FREE_UNTIL[r] > FREE_UNTIL[best] {
            best = r;
        }
    }
    if FREE_UNTIL[best] <= start {
        return false;
    }
    // Free for a first part only.
    let split = split_point(start + 1, FREE_UNTIL[best]);
    if split <= start {
        return false;
    }
    assign(cur, best);
    heap_push(split_at(cur, split));
    true
}

// Interval a gives up its register from pos on: the rest goes to the
// stack until just before its next use in a register.
fn spill_from(a: i64, pos: i64) {
    let mut rest = a;
    if ra_start(a) < pos {
        rest = split_at(a, pos);
    }
    IVS[rest].reg = ON_STACK;
    let start = ra_start(rest);
    let u = next_use(rest, start, USE_REG);
    if u == POS_MAX {
        return;
    }
    let split = split_point(start + 1, gap_before(u));
    if split <= start {
        // Needed in a register right away: allocate it again.
        IVS[rest].reg = UNASSIGNED;
        heap_push(rest);
        return;
    }
    heap_push(split_at(rest, split));
}

fn remove_at(list: *IntVec, k: i64) {
    list.data[k] = list.data[list.count - 1];
    list.count -= 1;
}

fn allocate_blocked(cur: i64) {
    let mut regs: [i64; 32] = [0; 32];
    let n = class_regs(iv_float(cur), &regs as *i64);
    let start = ra_start(cur);
    for k in 0..n {
        USE_POS[regs[k]] = POS_MAX;
        BLOCK_POS[regs[k]] = POS_MAX;
    }
    for k in 0..ACTIVE.count {
        let a = ACTIVE.data[k];
        let r = IVS[a].reg;
        let u = use_distance(a, next_use(a, start, USE_REG), start);
        if u < USE_POS[r] {
            USE_POS[r] = u;
        }
    }
    for k in 0..INACTIVE.count {
        let a = INACTIVE.data[k];
        let r = IVS[a].reg;
        if next_intersection(&IVS[a].ranges, &IVS[cur].ranges, start) < POS_MAX {
            let u = use_distance(a, next_use(a, start, USE_REG), start);
            if u < USE_POS[r] {
                USE_POS[r] = u;
            }
        }
    }
    let end = ra_end(cur);
    let first = next_use(cur, start, USE_REG);
    if first == POS_MAX {
        IVS[cur].reg = ON_STACK;
        return;
    }
    // A register is a candidate when no fixed interval takes it before
    // the first use, nor before a place to give it back; the best one is
    // taken from the intervals whose next use is farthest.
    let mut best = -1;
    for k in 0..n {
        let r = regs[k];
        if FIXED[r].count > 0 {
            let x = next_intersection(&FIXED[r], &IVS[cur].ranges, start);
            BLOCK_POS[r] = x;
            if x <= first || (x < end && split_point(start + 1, x) <= start) {
                continue;
            }
        }
        if best < 0 || USE_POS[r] > USE_POS[best] {
            best = r;
        }
    }
    let split = split_point(start + 1, gap_before(first));
    if split > start && (best < 0 || USE_POS[best] <= use_distance(cur, first, start)) {
        // Every register is needed as soon: to the stack until its first
        // use.
        IVS[cur].reg = ON_STACK;
        heap_push(split_at(cur, split));
        return;
    }
    if best < 0 {
        die(c"internal error: no register for an operand");
    }
    assign(cur, best);
    if BLOCK_POS[best] < ra_end(cur) {
        let at = split_point(start + 1, BLOCK_POS[best]);
        if at <= start {
            die(c"internal error: no place to split before a fixed register");
        }
        heap_push(split_at(cur, at));
    }
    // Take the register from the intervals holding it.
    let mut k = 0;
    while k < ACTIVE.count {
        let a = ACTIVE.data[k];
        if IVS[a].reg == best {
            remove_at(&ACTIVE, k);
            spill_from(a, start);
        } else {
            k += 1;
        }
    }
    k = 0;
    while k < INACTIVE.count {
        let a = INACTIVE.data[k];
        if IVS[a].reg == best && next_intersection(&IVS[a].ranges, &IVS[cur].ranges, start) < POS_MAX {
            remove_at(&INACTIVE, k);
            spill_from(a, start);
        } else {
            k += 1;
        }
    }
}

fn linear_scan() {
    for r in 0..64 {
        CALLEE_USED[r] = 0;
    }
    ACTIVE.count = 0;
    INACTIVE.count = 0;
    UNHANDLED.count = 0;
    for t in 0..RA_VALS.count {
        heap_push(RV_FIRST[t]);
    }
    let mut steps = 0;
    while UNHANDLED.count > 0 {
        let cur = heap_pop();
        steps += 1;
        if steps > 64 * (RA_VALS.count + 16) * 16 {
            die(c"internal error: register allocation does not finish");
        }
        let pos = ra_start(cur);
        let mut k = 0;
        while k < ACTIVE.count {
            let a = ACTIVE.data[k];
            if ra_end(a) <= pos {
                remove_at(&ACTIVE, k);
            } else if !covers(a, pos) {
                remove_at(&ACTIVE, k);
                INACTIVE.push(a);
            } else {
                k += 1;
            }
        }
        k = 0;
        while k < INACTIVE.count {
            let a = INACTIVE.data[k];
            if ra_end(a) <= pos {
                remove_at(&INACTIVE, k);
            } else if covers(a, pos) {
                remove_at(&INACTIVE, k);
                ACTIVE.push(a);
            } else {
                k += 1;
            }
        }
        if !try_allocate_free(cur) {
            allocate_blocked(cur);
        }
        if IVS[cur].reg >= 0 {
            ACTIVE.push(cur);
        }
    }
    sort_split_moves();
    assign_spill_slots();
}

fn sort_split_moves() {
    // Insertion sort by gap (stable), on (gap, value) pairs.
    let n = SPLIT_MOVES.count / 2;
    for i in 1..n {
        let g = SPLIT_MOVES.data[2 * i];
        let t = SPLIT_MOVES.data[2 * i + 1];
        let mut j = i;
        while j > 0 && SPLIT_MOVES.data[2 * (j - 1)] > g {
            SPLIT_MOVES.data[2 * j] = SPLIT_MOVES.data[2 * (j - 1)];
            SPLIT_MOVES.data[2 * j + 1] = SPLIT_MOVES.data[2 * (j - 1) + 1];
            j -= 1;
        }
        SPLIT_MOVES.data[2 * j] = g;
        SPLIT_MOVES.data[2 * j + 1] = t;
    }
}

// Spill slots: a value that is on the stack anywhere gets one, shared
// with values whose lifetimes (from definition to last use) do not
// overlap its own.
fn assign_spill_slots() {
    SPILL_COUNT = 0;
    let mut spilled = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for t in 0..RA_VALS.count {
        if INSTS[RA_VALS.data[t]].op.is_remat() {
            continue;
        }
        let mut i = RV_FIRST[t];
        while i >= 0 {
            if IVS[i].reg == ON_STACK {
                spilled.push(t);
                break;
            }
            i = IVS[i].next;
        }
    }
    // By start of lifetime (values are numbered in layout order, but phis
    // and parameters come first in their block: sort to be sure).
    let n = spilled.count;
    for i in 1..n {
        let t = spilled.data[i];
        let s = value_start(t);
        let mut j = i;
        while j > 0 && value_start(spilled.data[j - 1]) > s {
            spilled.data[j] = spilled.data[j - 1];
            j -= 1;
        }
        spilled.data[j] = t;
    }
    // slot_end[i]: where the lifetime of the value in slot i ends.
    let mut slot_end = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for i in 0..n {
        let t = spilled.data[i];
        let s = value_start(t);
        let mut slot = -1;
        for k in 0..slot_end.count {
            if slot_end.data[k] <= s && !RETURNS_TWICE {
                slot = k;
                break;
            }
        }
        if slot < 0 {
            slot = slot_end.count;
            slot_end.push(0);
        }
        slot_end.data[slot] = value_end(t);
        RV_SLOT[t] = slot;
    }
    SPILL_COUNT = slot_end.count;
    free(spilled.data as *u8);
    free(slot_end.data as *u8);
}

fn value_start(t: i64) -> i64 {
    ra_start(RV_FIRST[t])
}

fn value_end(t: i64) -> i64 {
    let mut i = RV_FIRST[t];
    while IVS[i].next >= 0 {
        i = IVS[i].next;
    }
    ra_end(i)
}

// ---- Locations ----

// The interval of dense index t holding position pos.
fn interval_at(t: i64, pos: i64) -> i64 {
    let mut i = RV_FIRST[t];
    while IVS[i].next >= 0 && ra_start(IVS[i].next) <= pos {
        i = IVS[i].next;
    }
    i
}

// The location of dense index t at position pos.
fn tloc(t: i64, pos: i64) -> i64 {
    let r = IVS[interval_at(t, pos)].reg;
    if r >= 0 {
        return r;
    }
    if r == UNASSIGNED {
        die(c"internal error: an interval without a location");
    }
    if INSTS[RA_VALS.data[t]].op.is_remat() {
        return LOC_REMAT;
    }
    0 - (1 + RV_SLOT[t])
}

// The location of value v at position pos.
fn vloc(v: i64, pos: i64) -> i64 {
    let t = tracked(v);
    if t < 0 {
        return LOC_NONE;
    }
    tloc(t, pos)
}

// Whether value v (dense index t) is stored to its spill slot when it is
// defined.
fn stored_at_def(t: i64) -> bool {
    RV_SLOT[t] >= 0
}

// Allocates function `fi`: layout, positions, liveness, intervals and
// locations.
fn allocate_registers(fi: i64) {
    IRF = fi;
    RETURNS_TWICE = calls_returns_twice(fi);
    split_critical_edges(fi);
    layout_blocks(fi);
    mark_reg_uses();
    number_positions();
    compute_liveness();
    build_intervals();
    linear_scan();
    if PRINT_REGALLOC {
        print_allocation();
    }
}

// --print-regalloc: the blocks' positions and every value's intervals,
// on stderr.
static mut PRINT_REGALLOC: bool = false;

fn print_allocation() {
    let out = buf_new();
    buf_str(out, c"regalloc ");
    buf_bytes(out, SYMS[FNS[IRFUNCS[IRF].f].name].text);
    buf_str(out, c":\n");
    for k in 0..ORDER.count {
        buf_str(out, c"  b");
        buf_int(out, ORDER.data[k]);
        buf_str(out, c" [");
        buf_int(out, BSTART.data[k]);
        buf_str(out, c", ");
        buf_int(out, BEND.data[k]);
        buf_str(out, c"] depth ");
        buf_int(out, LDEPTH.data[k]);
        buf_str(out, c"\n");
    }
    for t in 0..RA_VALS.count {
        buf_str(out, c"  v");
        buf_int(out, RA_VALS.data[t]);
        if RV_HINT[t] >= 0 {
            buf_str(out, c" hint v");
            buf_int(out, RA_VALS.data[RV_HINT[t]]);
        }
        if RV_HREG[t] >= 0 {
            buf_str(out, c" hint r");
            buf_int(out, RV_HREG[t]);
        }
        let mut i = RV_FIRST[t];
        while i >= 0 {
            buf_str(out, c" |");
            if IVS[i].reg >= 0 {
                buf_str(out, c" r");
                buf_int(out, IVS[i].reg);
            } else {
                buf_str(out, c" stack");
            }
            for r in 0..IVS[i].ranges.count / 2 {
                buf_str(out, c" [");
                buf_int(out, IVS[i].ranges.data[2 * r]);
                buf_str(out, c",");
                buf_int(out, IVS[i].ranges.data[2 * r + 1]);
                buf_str(out, c")");
            }
            i = IVS[i].next;
        }
        buf_str(out, c"\n");
    }
    buf_write_fd(out, 2);
}

// ---- Moves ----
//
// The moves of the allocation, shared by the emitter (which emits them)
// and the checker (which simulates them): each adds to PM (see 51_emit).

// Value v (dense index t) goes from `from` to `to`, where it is live
// across: a register or the stack. The stack needs no move (the value is
// there since its definition, or is rematerialized).
fn add_relocation(t: i64, from: i64, to: i64) {
    if from == to || to < 0 || to == LOC_REMAT {
        return;
    }
    let v = RA_VALS.data[t];
    if from == LOC_REMAT {
        pm_add(to, PM_REMAT, v, INSTS[v].ty, v, v);
    } else {
        pm_add(to, PM_LOC, from, INSTS[v].ty, v, v);
    }
}

// The moves in the gap at q.
fn plan_gap_moves(q: i64) {
    let n = SPLIT_MOVES.count / 2;
    let mut i = gap_index(q);
    while i < n && SPLIT_MOVES.data[2 * i] == q {
        let t = SPLIT_MOVES.data[2 * i + 1];
        add_relocation(t, tloc(t, q - 1), tloc(t, q));
        i += 1;
    }
}

// The first entry of SPLIT_MOVES at gap q or later.
fn gap_index(q: i64) -> i64 {
    let mut lo = 0;
    let mut hi = SPLIT_MOVES.count / 2;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if SPLIT_MOVES.data[2 * mid] < q {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo
}

// The moves of the edge from b to s: the values live into s, and its phis.
fn plan_edge_moves(b: i64, s: i64) {
    let from_pos = BEND.data[BLOCKS[b].order] + 1;
    let to_pos = BSTART.data[BLOCKS[s].order];
    let live_in = live_set(LIVE_IN, BLOCKS[s].order);
    for w in 0..LIVE_WORDS {
        let mut bits = live_in[w];
        while bits != 0 {
            let bit = trailing_zeros(bits);
            bits &= bits - 1;
            let t = w * 64 + bit;
            add_relocation(t, tloc(t, from_pos), tloc(t, to_pos));
        }
    }
    let index = pred_index(s, b);
    let mut phi = BLOCKS[s].first;
    while phi != 0 && INSTS[phi].op == Op::Phi {
        let t = tracked(phi);
        if t >= 0 {
            let dst = tloc(t, to_pos);
            let arg = ir_arg(phi, index);
            let a = tracked(arg);
            if INSTS[arg].op.is_remat() || a < 0 {
                pm_add(dst, PM_REMAT, arg, INSTS[phi].ty, arg, phi);
            } else {
                let src = tloc(a, from_pos);
                if src == LOC_REMAT {
                    pm_add(dst, PM_REMAT, arg, INSTS[phi].ty, arg, phi);
                } else {
                    pm_add(dst, PM_LOC, src, INSTS[phi].ty, arg, phi);
                }
            }
        }
        phi = INSTS[phi].next;
    }
}

// The moves at the start of block b: those of its edge when its single
// predecessor has other successors.
fn plan_start_moves(b: i64) {
    if BLOCKS[b].preds.count == 1 {
        let p = BLOCKS[b].preds.data[0];
        if succ_count(p) > 1 {
            plan_edge_moves(p, b);
        }
    }
}

// The moves at the end of block b, after its last instruction: those of
// its edge when it has a single successor.
fn plan_end_moves(b: i64) {
    if BLOCKS[b].term == Term::Jump {
        plan_edge_moves(b, BLOCKS[b].s0);
    }
}

// ---- Checking (--verify-regalloc) ----
//
// Simulates the moves, definitions and clobbers of the allocation over the
// control flow graph, with the contents of every register and spill slot
// (a value, or -1 when unknown), and checks that every use finds its value
// where the allocation says it is.

static mut CHECK_STATE: *i64 = 0 as *i64;
static mut CHECK_WIDTH: i64 = 0;

fn check_fail(v: i64, message: *u8) -> ! {
    let out = buf_new();
    buf_str(out, c"internal error: register allocation of ");
    buf_bytes(out, SYMS[FNS[IRFUNCS[IRF].f].name].text);
    buf_str(out, c": ");
    buf_str(out, message);
    buf_str(out, c" (v");
    buf_int(out, v);
    buf_str(out, c")\n");
    buf_write_fd(out, 2);
    exit(1);
}

// The state slot of location loc.
fn check_index(loc: i64) -> i64 {
    if loc >= 0 && loc < 64 {
        return loc;
    }
    if loc < 0 {
        return 64 + (0 - loc - 1);
    }
    -1
}

fn check_get(state: *i64, loc: i64) -> i64 {
    let k = check_index(loc);
    if k < 0 { -1 } else { state[k] }
}

fn check_set(state: *i64, loc: i64, v: i64) {
    let k = check_index(loc);
    if k >= 0 {
        state[k] = v;
    }
}

// Value v is used at pos, needing `kind`.
fn check_use(state: *i64, v: i64, pos: i64, kind: i64) {
    if !is_live_use(v, kind) {
        return;
    }
    let loc = vloc(v, pos);
    if loc == LOC_NONE {
        check_fail(v, c"an operand without a location");
    }
    if kind == USE_REG && (loc < 0 || loc >= 64) {
        check_fail(v, c"an operand not in a register");
    }
    if loc == LOC_REMAT {
        return;
    }
    if check_get(state, loc) != v {
        check_fail(v, c"an operand not where it should be");
    }
}

// Applies the moves in PM (all sources read first), then clears them.
fn check_moves(state: *i64) {
    let n = PM.count / PM_FIELDS;
    for i in 0..n {
        let value = pm_value(i);
        if pm_kind(i) == PM_LOC && value != 0 && check_get(state, pm_src(i)) != value {
            check_fail(value, c"a move of the wrong value");
        }
    }
    for i in 0..n {
        check_set(state, pm_dst(i), pm_result(i));
    }
    PM.count = 0;
}

fn check_clobber(state: *i64, v: i64) {
    let op = INSTS[v].op;
    if op.is_call() {
        let all = is_returns_twice_call(v);
        for r in 0..64 {
            if all || !is_callee_saved_reg(r) {
                state[r] = -1;
            }
        }
        return;
    }
    if X86 && !is_float(INSTS[v].ty) && X86_ALLOC_ACD {
        if op == Op::Div || op == Op::Rem {
            state[0] = -1;
            state[2] = -1;
        }
        if (op == Op::Shl || op == Op::Shr) && INSTS[INSTS[v].b].op != Op::Const {
            state[1] = -1;
        }
    }
}

// Value v defined at pos: in its location, and in its slot when it is
// stored there.
fn check_def(state: *i64, v: i64, pos: i64) {
    let t = tracked(v);
    if t < 0 {
        return;
    }
    let loc = tloc(t, pos);
    if loc >= 0 && loc < 64 {
        state[loc] = v;
    }
    if stored_at_def(t) {
        check_set(state, 0 - (1 + RV_SLOT[t]), v);
    }
}

fn ra_check_block(state: *i64, b: i64) {
    let k = BLOCKS[b].order;
    let start = BSTART.data[k];
    plan_start_moves(b);
    check_moves(state);
    // Phis and parameters.
    let mut v = BLOCKS[b].first;
    while v != 0 {
        let t = tracked(v);
        let op = INSTS[v].op;
        if t >= 0 && (op == Op::Phi || op == Op::Param) {
            let loc = tloc(t, start);
            if op == Op::Param {
                check_set(state, loc, v);
            } else if check_get(state, loc) != v {
                check_fail(v, c"a phi not where it should be");
            }
            if stored_at_def(t) {
                check_set(state, 0 - (1 + RV_SLOT[t]), v);
            }
        }
        v = INSTS[v].next;
    }
    v = BLOCKS[b].first;
    while v != 0 {
        let op = INSTS[v].op;
        if op == Op::Phi || op == Op::Param || is_fused_compare(v) {
            v = INSTS[v].next;
            continue;
        }
        let p = INSTS[v].mark;
        plan_gap_moves(p - 1);
        check_moves(state);
        for i in 0..ir_operand_count(v) {
            let operand = ir_operand(v, i);
            if operand != 0 && !(op.is_call() && i == 2 && !call_returns_through_pointer(v)) {
                check_use(state, operand, p, use_kind(v, i));
            }
        }
        check_clobber(state, v);
        if op.is_call() && INSTS[v].c != 0 && !call_returns_through_pointer(v) {
            check_use(state, INSTS[v].c, p + 2, use_kind(v, 2));
        }
        if is_emitted(v) {
            check_def(state, v, p + 2);
        }
        v = INSTS[v].next;
    }
    let end = BEND.data[k];
    plan_gap_moves(end - 1);
    check_moves(state);
    let mut out: [i64; 4] = [0; 4];
    let count = term_uses(b, &out as *i64);
    for i in 0..count {
        check_use(state, out[2 * i], end, out[2 * i + 1]);
    }
    plan_end_moves(b);
    check_moves(state);
}

fn check_allocation(fi: i64) {
    let n = ORDER.count;
    CHECK_WIDTH = 64 + SPILL_COUNT;
    // Per layout index: the state at the end of the block (-2: not reached
    // yet).
    let exits = alloc_zeroed(n * CHECK_WIDTH * 8 + 8) as *i64;
    for i in 0..n * CHECK_WIDTH {
        exits[i] = -2;
    }
    let state = alloc_zeroed(CHECK_WIDTH * 8 + 8) as *i64;
    let mut changed = true;
    let mut rounds = 0;
    while changed {
        changed = false;
        rounds += 1;
        if rounds > 1000 {
            die(c"internal error: the register allocation check does not settle");
        }
        for k in 0..n {
            let b = ORDER.data[k];
            // The meet of the predecessors' exits (unknown where they
            // disagree).
            let mut first = true;
            for i in 0..CHECK_WIDTH {
                state[i] = -1;
            }
            for i in 0..BLOCKS[b].preds.count {
                let p = BLOCKS[b].preds.data[i];
                let pk = BLOCKS[p].order;
                if pk < 0 || exits[pk * CHECK_WIDTH] == -2 {
                    continue;
                }
                for j in 0..CHECK_WIDTH {
                    let x = exits[pk * CHECK_WIDTH + j];
                    if first {
                        state[j] = x;
                    } else if state[j] != x {
                        state[j] = -1;
                    }
                }
                first = false;
            }
            if first && k != 0 {
                continue;
            }
            ra_check_block(state, b);
            // -2 marks "not reached": a reached state never holds it.
            for j in 0..CHECK_WIDTH {
                let x = if state[j] == -2 { -1 } else { state[j] };
                if exits[k * CHECK_WIDTH + j] != x {
                    exits[k * CHECK_WIDTH + j] = x;
                    changed = true;
                }
            }
        }
    }
    free(exits as *u8);
    free(state as *u8);
}
