// Equality saturation, acyclic (0.9): an e-graph over the pure integer
// operations, in the manner of Cranelift's aegraph, built during GVN's
// walk of the dominator tree (gvn.tach).
//
// GVN's table already hash-conses the pure instructions: an instruction
// equal to one that dominates it is that one. Here each value also has an
// e-class: the values known to be equal to it. When an instruction is new
// to the table, the rewrite rules (RULES, below) are matched against it,
// their patterns' operands against every member of the operands' classes;
// each match builds its right-hand side from existing classes (through
// the table, so equal nodes are shared; new ones are inserted before the
// instruction) and joins it to the instruction's class. Nodes only refer to
// values that already exist, so the graph stays acyclic and needs no
// rebuilding. Then extraction picks the class's cheapest member (by
// operation costs, its operands' best costs added) to stand for the
// instruction; the members not picked are dead code, which the next pass
// removes.
//
// The rules are written in a small language, parsed once into patterns:
//
//   (add (add x c1) c2) => (add x (+ c1 c2))
//   (mul x c1) if (pow2 c1) => (shl x (log2 c1))
//
// `x`, `y` match any value (the same name: the same class), names starting
// with `c` a constant, a number a constant of that value; operations are
// add sub mul and or xor shl neg bnot, eq and ne (comparisons); the
// commutative ones (add mul and or xor eq ne) match their operands either
// way round. A right-hand side may compute constants: (+ a b), (- a b),
// (* a b), (& a b), (| a b), (^ a b), (negc a), (log2 a), wrapped to the
// type. Every rule is checked by `tachyonc --check-rules`: both sides
// evaluated on random values (edge values included) at every integer
// width, with the folding semantics of the optimizer (fold.tach), which
// are the language's.

use crate::base::{
    IntVec, STDOUT, buf_byte, buf_int, buf_new, buf_str, buf_write_fd, die2, strlen,
};
use crate::types::{
    TY_BOOL, TY_I16, TY_I32, TY_I64, TY_I8, TY_U16, TY_U32, TY_U64, TY_U8, is_integer,
};
use crate::consteval::wrap_int;
use crate::target::log2;
use crate::ir::{Cond, INSTS, INST_COUNT, Op, ir_insert_before, ir_make, ir_replace};
use crate::fold::{fold_compare, fold_value};
use crate::gvn::{gvn_find_or_add, is_commutative_op, operands_out_of_order};
use crate::ir::Op::{Add, And, BNot, Cmp, Const, Mul, Neg, Or, Shl, Sub, Xor};

// ---- The rules ----

const RULE_COUNT: i64 = 31;

fn rule_text(i: i64) -> *u8 {
    let rules: [*u8; 31] = [
        c"(add (add x c1) c2) => (add x (+ c1 c2))",
        c"(sub x c1) => (add x (negc c1))",
        c"(mul (mul x c1) c2) => (mul x (* c1 c2))",
        c"(and (and x c1) c2) => (and x (& c1 c2))",
        c"(or (or x c1) c2) => (or x (| c1 c2))",
        c"(xor (xor x c1) c2) => (xor x (^ c1 c2))",
        c"(sub (add x y) y) => x",
        c"(add (sub x y) y) => x",
        c"(sub x (sub x y)) => y",
        c"(sub (sub x y) x) => (neg y)",
        c"(xor (xor x y) y) => x",
        c"(and (or x y) x) => x",
        c"(or (and x y) x) => x",
        c"(add (mul x c1) x) => (mul x (+ c1 1))",
        c"(sub (mul x c1) x) => (mul x (- c1 1))",
        c"(mul x c1) if (pow2 c1) => (shl x (log2 c1))",
        c"(eq (add x c1) c2) => (eq x (- c2 c1))",
        c"(ne (add x c1) c2) => (ne x (- c2 c1))",
        c"(eq (xor x c1) c2) => (eq x (^ c1 c2))",
        c"(ne (xor x c1) c2) => (ne x (^ c1 c2))",
        c"(eq (sub x y) 0) => (eq x y)",
        c"(ne (sub x y) 0) => (ne x y)",
        c"(neg (sub x y)) => (sub y x)",
        c"(neg (neg x)) => x",
        c"(bnot (bnot x)) => x",
        c"(add x (neg y)) => (sub x y)",
        c"(sub x (neg y)) => (add x y)",
        c"(add (bnot x) 1) => (neg x)",
        c"(bnot (neg x)) => (add x -1)",
        c"(and x (bnot x)) => 0",
        c"(xor x (bnot x)) => -1",
    ];
    rules[i]
}

// Pattern nodes: kind, operation (an Op, or a constant operator), its
// condition (eq, ne), operands a and b, a variable's index or a literal.
const K_OP: i64 = 1;
const K_VAR: i64 = 2;
const K_CVAR: i64 = 3;
const K_LIT: i64 = 4;
const K_CEXPR: i64 = 5;

// Constant operators of right-hand sides.
const C_ADD: i64 = 1;
const C_SUB: i64 = 2;
const C_MUL: i64 = 3;
const C_AND: i64 = 4;
const C_OR: i64 = 5;
const C_XOR: i64 = 6;
const C_NEG: i64 = 7;
const C_LOG2: i64 = 8;

static mut P_KIND: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut P_OP: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut P_COND: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut P_A: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut P_B: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut P_VAL: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Per rule: left and right patterns, the guarded constant variable (-1:
// no guard), the variable count.
static mut R_LHS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut R_RHS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut R_GUARD: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut R_VARS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut RULES_READY: bool = false;

// The parser's state: the text, the position, the variable names (C
// strings' first two bytes) of the rule being parsed.
static mut PT: *u8 = 0 as *u8;
static mut PP: i64 = 0;
static mut PVARS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn rule_error(message: *u8) -> ! {
    unsafe { die2(message, PT) }
}

fn skip_space() {
    while unsafe { PT[PP] == ' ' } {
        PP += 1;
    }
}

fn is_word_byte(c: u8) -> bool {
    c != 0 && c != ' ' && c != '(' && c != ')'
}

// The word at PP: its start; PP moves past it.
fn word() -> i64 {
    unsafe {
        skip_space();
        let start = PP;
        while is_word_byte(PT[PP]) {
            PP += 1;
        }
        if PP == start {
            rule_error(c"internal error: a rewrite rule is malformed: ");
        }
        start
    }
}

fn word_is(start: i64, text: *u8) -> bool {
    unsafe {
        let n = strlen(text) as i64;
        if PP - start != n {
            return false;
        }
        for i in 0..n {
            if PT[start + i] != text[i] {
                return false;
            }
        }
        true
    }
}

fn new_pattern(kind: i64, op: i64, a: i64, b: i64, val: i64) -> i64 {
    P_KIND.push(kind);
    P_OP.push(op);
    P_COND.push(0);
    P_A.push(a);
    P_B.push(b);
    P_VAL.push(val);
    P_KIND.count - 1
}

// The variable named by the word at [start, PP), numbered in order of
// appearance.
fn variable(start: i64) -> i64 {
    unsafe {
        let second = if PP - start > 1 { PT[start + 1] as i64 } else { 0 };
        let key = (PP - start) * 65536 + (PT[start] as i64) * 256 + second;
        for i in 0..PVARS.count {
            if PVARS.data[i] == key {
                return i;
            }
        }
        PVARS.push(key);
        PVARS.count - 1
    }
}

fn parse_pattern(rhs: bool) -> i64 {
    unsafe {
        skip_space();
        if PT[PP] != '(' {
            let start = word();
            let c = PT[start];
            if c == '-' || (c >= '0' && c <= '9') {
                let mut value = 0;
                let mut i = start;
                let negative = c == '-';
                if negative {
                    i += 1;
                }
                while i < PP {
                    value = value * 10 + (PT[i] - '0') as i64;
                    i += 1;
                }
                return new_pattern(K_LIT, 0, 0, 0, if negative { 0 - value } else { value });
            }
            let var = variable(start);
            if rhs && var >= R_VARS_NOW {
                rule_error(c"internal error: a rewrite rule's right side has a new variable: ");
            }
            return new_pattern(if c == 'c' { K_CVAR } else { K_VAR }, 0, 0, 0, var);
        }
        PP += 1;
        let start = word();
        let mut kind = K_OP;
        let mut op = 0;
        let mut cond = 0;
        let mut arity = 2;
        if word_is(start, c"add") { op = Add as i64; }
        else if word_is(start, c"sub") { op = Sub as i64; }
        else if word_is(start, c"mul") { op = Mul as i64; }
        else if word_is(start, c"and") { op = And as i64; }
        else if word_is(start, c"or") { op = Or as i64; }
        else if word_is(start, c"xor") { op = Xor as i64; }
        else if word_is(start, c"shl") { op = Shl as i64; }
        else if word_is(start, c"neg") { op = Neg as i64; arity = 1; }
        else if word_is(start, c"bnot") { op = BNot as i64; arity = 1; }
        else if word_is(start, c"eq") { op = Cmp as i64; cond = Cond::Eq as i64; }
        else if word_is(start, c"ne") { op = Cmp as i64; cond = Cond::Ne as i64; }
        else {
            kind = K_CEXPR;
            if word_is(start, c"+") { op = C_ADD; }
            else if word_is(start, c"-") { op = C_SUB; }
            else if word_is(start, c"*") { op = C_MUL; }
            else if word_is(start, c"&") { op = C_AND; }
            else if word_is(start, c"|") { op = C_OR; }
            else if word_is(start, c"^") { op = C_XOR; }
            else if word_is(start, c"negc") { op = C_NEG; arity = 1; }
            else if word_is(start, c"log2") { op = C_LOG2; arity = 1; }
            else { rule_error(c"internal error: unknown operation in a rewrite rule: "); }
        }
        let a = parse_pattern(rhs);
        let b = if arity == 2 { parse_pattern(rhs) } else { -1 };
        skip_space();
        if PT[PP] != ')' {
            rule_error(c"internal error: expected ')' in a rewrite rule: ");
        }
        PP += 1;
        let p = new_pattern(kind, op, a, b, 0);
        P_COND.data[p] = cond;
        p
    }
}

static mut R_VARS_NOW: i64 = 0;

fn init_rules() {
    unsafe {
        if RULES_READY {
            return;
        }
        RULES_READY = true;
        for r in 0..RULE_COUNT {
            PT = rule_text(r);
            PP = 0;
            PVARS.count = 0;
            R_VARS_NOW = 1000;
            let lhs = parse_pattern(false);
            let mut guard = -1;
            let at = word();
            if word_is(at, c"if") {
                skip_space();
                PP += 1;
                let pred = word();
                if !word_is(pred, c"pow2") {
                    rule_error(c"internal error: unknown guard in a rewrite rule: ");
                }
                let v = word();
                guard = variable(v);
                skip_space();
                PP += 1;
                let arrow = word();
                if !word_is(arrow, c"=>") {
                    rule_error(c"internal error: expected '=>' in a rewrite rule: ");
                }
            } else if !word_is(at, c"=>") {
                rule_error(c"internal error: expected '=>' in a rewrite rule: ");
            }
            R_VARS_NOW = PVARS.count;
            let rhs = parse_pattern(true);
            if P_KIND.data[lhs] != K_OP {
                rule_error(c"internal error: a rewrite rule's left side is not an operation: ");
            }
            R_LHS.push(lhs);
            R_RHS.push(rhs);
            R_GUARD.push(guard);
            R_VARS.push(PVARS.count);
        }
    }
}

// ---- E-classes ----
//
// The e-classes are directional, as in Cranelift: when a rule shows
// instruction v equal to w (which dominates v), w and its own members
// join v's class, but v does not join w's (w's other users may not be
// dominated by v). Per value (by id, valid when its stamp is this run's):
// its members (a run in ALTS; none recorded: the value alone) and the
// best cost found for it.

static mut EC_STAMP: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut EC_START: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut EC_LEN: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut EC_COST: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut ALTS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut RUN: i64 = 0;

// Whether the e-graph runs (-O1 and up; `--no-egraph` turns it off, to
// compare).
pub static mut EGRAPH: bool = true;

pub fn egraph_start() {
    init_rules();
    RUN += 1;
    ALTS.count = 0;
}

fn ec_touch(v: i64) {
    unsafe {
        while EC_STAMP.count <= v {
            EC_STAMP.push(0);
            EC_START.push(0);
            EC_LEN.push(0);
            EC_COST.push(0);
        }
        if EC_STAMP.data[v] != RUN {
            EC_STAMP.data[v] = RUN;
            EC_START.data[v] = 0;
            EC_LEN.data[v] = 0;
            EC_COST.data[v] = 0;
        }
    }
}

fn member_count(v: i64) -> i64 {
    unsafe {
        ec_touch(v);
        if EC_LEN.data[v] == 0 { 1 } else { EC_LEN.data[v] }
    }
}

fn member(v: i64, i: i64) -> i64 {
    unsafe {
        if EC_LEN.data[v] == 0 { v } else { ALTS.data[EC_START.data[v] + i] }
    }
}

fn is_member(v: i64, w: i64) -> bool {
    let n = member_count(v);
    for i in 0..n {
        if member(v, i) == w {
            return true;
        }
    }
    false
}

// Whether v and w are known equal.
fn same_value(v: i64, w: i64) -> bool {
    v == w || is_member(v, w) || is_member(w, v)
}

fn op_cost(op: Op) -> i64 {
    match op {
        Const => 0,
        Mul => 3,
        Op::Div | Op::Rem => 20,
        _ => 1,
    }
}

// The cost of node m: its operation's, with its operands' best.
fn node_cost(m: i64) -> i64 {
    unsafe {
        let mut cost = op_cost(INSTS[m].op);
        let a = INSTS[m].a;
        let b = INSTS[m].b;
        if a != 0 {
            ec_touch(a);
            cost += EC_COST.data[a];
        }
        if b != 0 {
            ec_touch(b);
            cost += EC_COST.data[b];
        }
        cost
    }
}

// ---- Matching ----

// Variable bindings of the rule being matched, and the trail of bound
// variables (to undo a failed branch).
static mut BIND: [i64; 8] = [0; 8];
static mut TRAIL: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn undo_to(mark: i64) {
    while TRAIL.count > mark {
        BIND[TRAIL.pop()] = 0;
    }
}

fn bind(var: i64, v: i64) -> bool {
    if BIND[var] == 0 {
        BIND[var] = v;
        TRAIL.push(var);
        return true;
    }
    same_value(BIND[var], v)
}

fn is_commutative_pattern(p: i64) -> bool {
    let op = unsafe { P_OP.data[p] };
    op == Add as i64 || op == Mul as i64 || op == And as i64 || op == Or as i64 || op == Xor as i64
        || op == Cmp as i64
}

// Whether pattern p matches value v (of integer type ty): a member of
// v's class, for an operation.
fn pmatch(p: i64, v: i64, ty: i64) -> bool {
    unsafe {
        let kind = P_KIND.data[p];
        if kind == K_VAR {
            return bind(P_VAL.data[p], v);
        }
        if kind == K_CVAR || kind == K_LIT {
            let c = const_member(v);
            if c == 0 {
                return false;
            }
            if kind == K_LIT {
                return INSTS[c].imm == wrap_int(P_VAL.data[p], ty);
            }
            return bind(P_VAL.data[p], c);
        }
        let op = P_OP.data[p];
        let is_cmp = op == Cmp as i64;
        let n = member_count(v);
        for k in 0..n {
            let m = member(v, k);
            let mop = INSTS[m].op;
            if mop as i64 == op && (if is_cmp {
                INSTS[m].cond as i64 == P_COND.data[p] && INSTS[m].ty == TY_BOOL
            } else {
                INSTS[m].ty == ty
            }) {
                let child_ty = if is_cmp { INSTS[m].imm2 } else { ty };
                if is_integer(child_ty) {
                    let mark = TRAIL.count;
                    if pmatch(P_A.data[p], INSTS[m].a, child_ty)
                        && (P_B.data[p] < 0 || pmatch(P_B.data[p], INSTS[m].b, child_ty)) {
                        return true;
                    }
                    undo_to(mark);
                    if P_B.data[p] >= 0 && is_commutative_pattern(p) {
                        if pmatch(P_A.data[p], INSTS[m].b, child_ty) && pmatch(P_B.data[p], INSTS[m].a, child_ty) {
                            return true;
                        }
                        undo_to(mark);
                    }
                }
            }
        }
        false
    }
}

// A constant member of v's class, or 0.
fn const_member(v: i64) -> i64 {
    let n = member_count(v);
    for k in 0..n {
        let m = member(v, k);
        if unsafe { INSTS[m].op == Const } {
            return m;
        }
    }
    0
}

// ---- Building right-hand sides ----

// The scratch instruction folding evaluates constants with.
static mut SCRATCH_INST: i64 = 0;

fn fold2(op: Op, ty: i64, x: i64, y: i64) -> i64 {
    if SCRATCH_INST == 0 || SCRATCH_INST >= INST_COUNT {
        SCRATCH_INST = ir_make(op, ty, 0, 0, 0);
    }
    unsafe {
        INSTS[SCRATCH_INST].op = op;
        INSTS[SCRATCH_INST].ty = ty;
    }
    fold_value(SCRATCH_INST, x, y)
}

// The value of constant expression p (of type ty), with BIND's constants.
fn const_value_of(p: i64, ty: i64, consts: *i64) -> i64 {
    unsafe {
        let kind = P_KIND.data[p];
        if kind == K_LIT {
            return wrap_int(P_VAL.data[p], ty);
        }
        if kind == K_CVAR {
            return consts[P_VAL.data[p]];
        }
        let x = const_value_of(P_A.data[p], ty, consts);
        let op = P_OP.data[p];
        if op == C_NEG {
            return fold2(Neg, ty, x, 0);
        }
        if op == C_LOG2 {
            return log2(x);
        }
        let y = const_value_of(P_B.data[p], ty, consts);
        let fop = if op == C_ADD { Add } else if op == C_SUB { Sub } else if op == C_MUL { Mul }
            else if op == C_AND { And } else if op == C_OR { Or } else { Xor };
        fold2(fop, ty, x, y)
    }
}

static mut CONSTS: [i64; 8] = [0; 8];

// A node (op, ty, a, b) before instruction `at`: an equal one the table
// knows, or a new one.
fn make_node(at: i64, op: Op, cond: i64, ty: i64, operand_ty: i64, a: i64, b: i64, imm: i64) -> i64 {
    unsafe {
        let n = ir_make(op, ty, a, b, imm);
        if op == Cmp {
            INSTS[n].cond = if cond == Cond::Ne as i64 { Cond::Ne } else { Cond::Eq };
            INSTS[n].imm2 = operand_ty;
        }
        if b != 0 && is_commutative_op(n) && operands_out_of_order(a, b) {
            INSTS[n].a = b;
            INSTS[n].b = a;
        }
        ir_insert_before(at, n);
        let w = gvn_find_or_add(n);
        if w != 0 {
            ir_replace(n, w);
            return w;
        }
        ec_touch(n);
        EC_COST.data[n] = node_cost(n);
        n
    }
}

fn build(at: i64, p: i64, ty: i64) -> i64 {
    unsafe {
        let kind = P_KIND.data[p];
        if kind == K_VAR || kind == K_CVAR {
            return BIND[P_VAL.data[p]];
        }
        if kind == K_LIT || kind == K_CEXPR {
            return make_node(at, Const, 0, ty, 0, 0, 0, const_value_of(p, ty, &CONSTS as *i64));
        }
        let op = P_OP.data[p];
        let is_cmp = op == Cmp as i64;
        let child_ty = if is_cmp { BUILD_CMP_TY } else { ty };
        let a = build(at, P_A.data[p], child_ty);
        let b = if P_B.data[p] >= 0 { build(at, P_B.data[p], child_ty) } else { 0 };
        let iop = op_of(op);
        make_node(at, iop, P_COND.data[p], if is_cmp { TY_BOOL } else { ty }, child_ty, a, b, 0)
    }
}

static mut BUILD_CMP_TY: i64 = 0;

fn op_of(op: i64) -> Op {
    if op == Add as i64 { return Add; }
    if op == Sub as i64 { return Sub; }
    if op == Mul as i64 { return Mul; }
    if op == And as i64 { return And; }
    if op == Or as i64 { return Or; }
    if op == Xor as i64 { return Xor; }
    if op == Shl as i64 { return Shl; }
    if op == Neg as i64 { return Neg; }
    if op == BNot as i64 { return BNot; }
    Cmp
}

fn is_pow2(x: i64) -> bool {
    x > 0 && (x & (x - 1)) == 0
}

// The rules on instruction v (new to GVN's table, its operands resolved):
// returns the value standing for it (v itself, or a cheaper equal one).
pub fn egraph_rewrite(v: i64) -> i64 {
    unsafe {
        let op = INSTS[v].op;
        let is_cmp = op == Cmp;
        let ty = INSTS[v].ty;
        let operand_ty = if is_cmp { INSTS[v].imm2 } else { ty };
        ec_touch(v);
        EC_COST.data[v] = node_cost(v);
        if !is_integer(operand_ty) || (is_cmp && INSTS[v].cond != Cond::Eq && INSTS[v].cond != Cond::Ne) {
            return v;
        }
        FOUND.count = 0;
        FOUND.push(v);
        for r in 0..RULE_COUNT {
            let lhs = R_LHS.data[r];
            if P_OP.data[lhs] != op as i64 {
                continue;
            }
            for i in 0..8 {
                BIND[i] = 0;
            }
            TRAIL.count = 0;
            if !pmatch(lhs, v, ty) {
                continue;
            }
            // The constants bound, as values of their type.
            for i in 0..R_VARS.data[r] {
                CONSTS[i] = if BIND[i] != 0 && INSTS[BIND[i]].op == Const { INSTS[BIND[i]].imm } else { 0 };
            }
            let guard = R_GUARD.data[r];
            if guard >= 0 && !is_pow2(CONSTS[guard]) {
                continue;
            }
            BUILD_CMP_TY = operand_ty;
            let w = build(v, R_RHS.data[r], ty);
            if INSTS[w].ty != ty {
                continue;
            }
            // w and its members join v's class.
            let n = member_count(w);
            for k in 0..n {
                let m = member(w, k);
                let mut known = false;
                for j in 0..FOUND.count {
                    if FOUND.data[j] == m {
                        known = true;
                    }
                }
                if !known {
                    FOUND.push(m);
                }
            }
        }
        if FOUND.count == 1 {
            return v;
        }
        EC_START.data[v] = ALTS.count;
        EC_LEN.data[v] = FOUND.count;
        for j in 0..FOUND.count {
            ALTS.push(FOUND.data[j]);
        }
        // Extraction: the cheapest member (v on a tie).
        let mut best = v;
        let mut best_cost = EC_COST.data[v];
        for j in 1..FOUND.count {
            let m = FOUND.data[j];
            ec_touch(m);
            if EC_COST.data[m] < best_cost {
                best = m;
                best_cost = EC_COST.data[m];
            }
        }
        EC_COST.data[v] = best_cost;
        best
    }
}

static mut FOUND: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// ---- Checking the rules (tachyonc --check-rules) ----

static mut RNG: u64 = 88172645463325252;

fn rand64() -> i64 {
    RNG = RNG ^ (RNG << 13);
    RNG = RNG ^ (RNG >> 7);
    RNG = RNG ^ (RNG << 17);
    RNG as i64
}

// A random value of type ty: often small, or at an edge.
fn random_value(ty: i64) -> i64 {
    let k = rand64() & 7;
    let raw = if k == 0 {
        0
    } else if k == 1 {
        -1
    } else if k == 2 {
        1
    } else if k == 3 {
        (rand64() & 15) - 8
    } else if k == 4 {
        1 << ((rand64() & 63) as u64)
    } else if k == 5 {
        (1 << ((rand64() & 63) as u64)) - 1
    } else {
        rand64()
    };
    wrap_int(raw, ty)
}

static mut EVAL_VARS: [i64; 8] = [0; 8];

// Pattern p evaluated with EVAL_VARS (integers of type ty; comparisons as
// 0 or 1).
fn eval_pattern(p: i64, ty: i64, cmp_ty: i64) -> i64 {
    unsafe {
        let kind = P_KIND.data[p];
        if kind == K_VAR || kind == K_CVAR {
            return EVAL_VARS[P_VAL.data[p]];
        }
        if kind == K_LIT || kind == K_CEXPR {
            return const_value_of(p, ty, &EVAL_VARS as *i64);
        }
        let op = P_OP.data[p];
        if op == Cmp as i64 {
            let x = eval_pattern(P_A.data[p], cmp_ty, cmp_ty);
            let y = eval_pattern(P_B.data[p], cmp_ty, cmp_ty);
            let cond = if P_COND.data[p] == Cond::Ne as i64 { Cond::Ne } else { Cond::Eq };
            return fold_compare(cond, cmp_ty, x, y) as i64;
        }
        let x = eval_pattern(P_A.data[p], ty, cmp_ty);
        let y = if P_B.data[p] >= 0 { eval_pattern(P_B.data[p], ty, cmp_ty) } else { 0 };
        fold2(op_of(op), ty, x, y)
    }
}

// Checks every rule on random values at every integer width; prints a
// line per failure and a summary; returns the number of failures.
pub fn check_rules(trials: i64) -> i64 {
    unsafe {
        init_rules();
        let types: [i64; 8] = [TY_I8, TY_I16, TY_I32, TY_I64, TY_U8, TY_U16, TY_U32, TY_U64];
        let out = buf_new();
        let mut failures = 0;
        let mut checked = 0;
        for r in 0..RULE_COUNT {
            let lhs = R_LHS.data[r];
            let is_cmp = P_OP.data[lhs] == Cmp as i64;
            for t in 0..8 {
                let ty = types[t];
                let value_ty = if is_cmp { TY_BOOL } else { ty };
                let mut failed = false;
                for _ in 0..trials {
                    for i in 0..R_VARS.data[r] {
                        EVAL_VARS[i] = random_value(ty);
                    }
                    let guard = R_GUARD.data[r];
                    if guard >= 0 && !is_pow2(EVAL_VARS[guard]) {
                        EVAL_VARS[guard] = wrap_int(1 << ((rand64() & 7) as u64), ty);
                        if !is_pow2(EVAL_VARS[guard]) {
                            continue;
                        }
                    }
                    checked += 1;
                    let left = eval_pattern(lhs, value_ty, ty);
                    let right = eval_pattern(R_RHS.data[r], value_ty, ty);
                    if left != right && !failed {
                        failed = true;
                        failures += 1;
                        buf_str(out, c"rule failed: ");
                        buf_str(out, rule_text(r));
                        buf_str(out, c" (type ");
                        buf_int(out, t);
                        buf_str(out, c", variables");
                        for i in 0..R_VARS.data[r] {
                            buf_byte(out, ' ');
                            buf_int(out, EVAL_VARS[i]);
                        }
                        buf_str(out, c": ");
                        buf_int(out, left);
                        buf_str(out, c" vs ");
                        buf_int(out, right);
                        buf_str(out, c")\n");
                    }
                }
            }
        }
        buf_str(out, c"rewrite rules: ");
        buf_int(out, RULE_COUNT);
        buf_str(out, c" rules, ");
        buf_int(out, checked);
        buf_str(out, c" checks, ");
        buf_int(out, failures);
        buf_str(out, c" failed\n");
        buf_write_fd(out, STDOUT);
        failures
    }
}
