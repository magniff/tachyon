pub enum Res { None, Local, Const, Static, Fn }

// `borrow` (0.9): a parameter declared with a pointer type, not `mut`: a
// borrow of what the caller passed, dereferenced in safe code (see
// "Unsafe code" below).
// `tparam` (0.9): the bounded type parameter its declared type names (a
// parameter `x: T` or `x: *T`), whose bounds its methods come from; 0.
struct Local {
    name: i64, ty: i64, mutable: bool, is_param: bool, offset: i64, borrow: bool, tparam: i64,
}

pub static mut LOCALS: *Local = 0 as *Local;
pub static mut LOCAL_COUNT: i64 = 0;
static mut LOCAL_CAP: i64 = 0;
// Locals in scope (innermost last), and where each scope starts in it.
pub static mut ENV: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut SCOPES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut LOOP_STACK: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// While checking a deferred statement (0.6): the LOOP_STACK depth at it
// (loops below it cannot be left from it); -1 elsewhere.
static mut DEFER_LOOP_BASE: i64 = -1;
pub static mut RETURN_TYPE: i64 = 0;
// In constant expressions no locals are visible.
pub static mut CONST_CONTEXT: bool = false;
pub static mut PROGRAM: i64 = 0;
// The type `Self` names (in an impl block), or 0; the symbols `Self` and
// `self`.
pub static mut SELF_TYPE: i64 = 0;
pub static mut SELF_TYPE_SYM: i64 = 0;
pub static mut SELF_SYM: i64 = 0;

// ---- Errors ----

pub fn type_error(n: i64, message: *u8) -> ! {
    error_at(NODES[n].start, message)
}

pub fn mismatch_error(n: i64, expected: i64, actual: i64) -> ! {
    err_begin(NODES[n].start);
    err_str(c"expected '");
    err_type(expected);
    err_str(c"', got '");
    err_type(actual);
    err_str(c"'");
    err_end()
}

// `message` followed by `, got '<type>'`.
pub fn type_error_got(n: i64, message: *u8, t: i64) -> ! {
    err_begin(NODES[n].start);
    err_str(message);
    err_str(c", got '");
    err_type(t);
    err_str(c"'");
    err_end()
}

pub fn name_error(pos: i64, before: *u8, name: i64, after: *u8) -> ! {
    err_begin(pos);
    err_str(before);
    err_sym(name);
    err_str(after);
    err_end()
}

// ---- Scopes ----

pub fn push_scope() {
    SCOPES.push(ENV.count);
}

pub fn pop_scope() {
    ENV.count = SCOPES.pop();
}

pub fn define_local(name: i64, ty: i64, mutable: bool, is_param: bool) -> i64 {
    LOCALS = grow(LOCALS, LOCAL_COUNT, &LOCAL_CAP);
    let id = LOCAL_COUNT;
    LOCALS[id] = Local {
        name: name, ty: ty, mutable: mutable, is_param: is_param, offset: 0, borrow: false,
        tparam: 0,
    };
    LOCAL_COUNT += 1;
    ENV.push(id);
    id
}

// The innermost local named `name`, or -1.
pub fn lookup_local(name: i64) -> Option<i64> {
    if CONST_CONTEXT {
        return Option::None;
    }
    let mut i = ENV.count - 1;
    while i >= 0 {
        let id = ENV.data[i];
        if LOCALS[id].name == name {
            return Option::Some(id);
        }
        i -= 1;
    }
    Option::None
}

// ---- Unsafe code (0.9) ----
//
// Safe code has no undefined behaviour; the operations that can have it
// are allowed in unsafe code only: inside `unsafe { ... }` and in the body
// of an `unsafe fn` (UNSAFE_DEPTH > 0). They are dereferencing, indexing
// and slicing a raw pointer, casting an integer (other than the literal 0)
// to a pointer, calling C (an `extern "C"` declaration or function
// pointer), calling an `unsafe fn`, and reading a union's field.
//
// A *borrow* is a pointer known to point to live memory of its type: `&p`
// for a place p, or a parameter declared with a pointer type (and not
// `mut`), `self: *T` included. Dereferencing a borrow (`*b`, `b.f`, a
// method through it) is safe; any other pointer is raw. So that borrowed
// parameters can be trusted, passing a raw pointer where a function takes
// a pointer parameter is unsafe (and so is calling through a function
// pointer with one, or using such a function as a value).
//
// 0.9 reports an unsafe operation outside unsafe code as a warning
// (`--deny-warnings`: an error; `--allow-unsafe`: nothing, for the
// compiler's own source); 0.10 makes it an error. `--fix-unsafe` wraps
// them in unsafe blocks (fixunsafe.tach).

pub static mut ALLOW_UNSAFE: bool = false;
pub static mut UNSAFE_DEPTH: i64 = 0;
// The innermost statement, block tail or condition being checked: what
// --fix-unsafe wraps (0: none).
pub static mut WRAP_NODE: i64 = 0;

// Flag of an expression whose value is not read (a place written, or
// whose address is taken): a union's field may be written so.
const NODE_NO_READ: i64 = 256;

// The kinds of unsafe operations (a warning is reported once per position
// and kind).
const U_DEREF: i64 = 1;
const U_FIELD: i64 = 2;
const U_METHOD: i64 = 3;
const U_INDEX: i64 = 4;
const U_SLICE: i64 = 5;
const U_INT_PTR: i64 = 6;
const U_C_CALL: i64 = 7;
const U_UNSAFE_CALL: i64 = 8;
const U_UNION: i64 = 9;
const U_PTR_ARG: i64 = 10;
const U_FN_VALUE: i64 = 11;

// Operation n, of kind `key`, needs unsafe code.
fn unsafe_op(n: i64, key: i64, message: *u8) {
    if UNSAFE_DEPTH > 0 || CONST_CONTEXT {
        return;
    }
    if FIX_UNSAFE {
        note_unsafe_site(WRAP_NODE);
        return;
    }
    if ALLOW_UNSAFE {
        return;
    }
    report_warning(NODES[n].start, key, c"unsafe", message,
        c"put it in an `unsafe { ... }` block, or the function's body in an `unsafe fn` (`tachyonc --fix-unsafe` does the former; an error from 0.10)");
}

// Checks expression e (synthesized when `expected` is 0) as a unit
// --fix-unsafe may wrap: a condition, a sequence, an arm's body.
pub fn check_wrapped(e: i64, expected: i64) -> i64 {
    let saved = WRAP_NODE;
    WRAP_NODE = e;
    let ty = if expected != 0 { check_expr(e, expected) } else { synth_expr(e) };
    WRAP_NODE = saved;
    ty
}

// Whether parameter node `param` is a borrow: a pointer type as written,
// not `mut`.
fn is_borrow_param(param: i64) -> bool {
    NODES[param].c == 0 && NODES[param].b != 0 && NODES[NODES[param].b].kind == TyPtr
}

fn has_borrow_param(f: i64) -> bool {
    if FNS[f].is_extern {
        return false;
    }
    let item = FNS[f].node;
    for i in 0..NODES[item].count {
        if is_borrow_param(child(item, i)) {
            return true;
        }
    }
    false
}

// Whether expression e (checked) is a borrow.
fn is_borrow(e: i64) -> bool {
    let kind = NODES[e].kind;
    if kind == Unary && NODES[e].op == Tok::Amp {
        return true;
    }
    if kind == Ident && NODES[e].res == Res::Local && NODES[e].y >= 0 {
        return LOCALS[NODES[e].y].borrow;
    }
    false
}

// Marks the place `target` (a chain of fields) as not read.
fn mark_no_read(target: i64) {
    let mut e = target;
    while NODES[e].kind == FieldAccess || NODES[e].kind == TupleField {
        NODES[e].p |= NODE_NO_READ;
        e = NODES[e].a;
    }
}

// A direct call n of function f (its arguments in n's list, from `first`
// on for the ones written after a method's receiver): calling C or an
// `unsafe fn`, and passing a raw pointer to a borrowed parameter, are
// unsafe.
fn check_call_safety(n: i64, f: i64, first: i64) {
    if FNS[f].is_extern {
        unsafe_op(n, U_C_CALL, c"calling a C function is unsafe");
        return;
    }
    if (FNS[f].attrs & FN_UNSAFE) != 0 {
        unsafe_op(n, U_UNSAFE_CALL, c"calling an `unsafe fn` is unsafe");
    }
    let item = FNS[f].node;
    let count = if NODES[n].count < NODES[item].count { NODES[n].count } else { NODES[item].count };
    for i in first..count {
        let arg = child(n, i);
        if is_borrow_param(child(item, i)) && !is_borrow(arg) {
            unsafe_op(arg, U_PTR_ARG, c"passing a raw pointer to a pointer parameter is unsafe (the function dereferences it as a borrow): pass `&place` or a pointer parameter");
        }
    }
}

// ---- Declarations ----

pub fn check_program(program: i64) {
    PROGRAM = program;
    SELF_TYPE_SYM = intern_c(c"Self");
    SELF_SYM = intern_c(c"self");
    init_modules();
    init_traits();
    // The declarations, one phase after the other (see collect_phase).
    for phase in 0..PHASE_COUNT {
        collect_phase(phase);
    }
    if has_errors() {
        report_legacy_imports(false);
    }
    exit_if_errors();
    for i in 0..NODES[program].count {
        let item = child(program, i);
        if NODES[item].kind == Fn && FNS[NODES[item].x - 1].generic == 0 {
            check_function_recovering(item);
        }
    }
    // The instances, as they are made: an instance may make more.
    let mut q = 0;
    while q < INST_QUEUE.count {
        check_function_recovering(FNS[INST_QUEUE.data[q]].node);
        q += 1;
    }
    // (0.8: `*` imports and plain header imports, once the names used
    // through them are known)
    report_legacy_imports(true);
    exit_if_errors();
    finish_program(program);
}

const PHASE_COUNT: i64 = 14;

// One phase of the declarations; its first error ends the checking (the
// errors of function bodies, checked after, are reported together).
fn collect_phase(phase: i64) {
    let depth = RECOVER_DEPTH;
    let state = save_check_state();
    if _setjmp(recover_enter()) == 0 {
        match phase {
            0 => collect_names(),
            1 => collect_uses(),
            2 => collect_const_types(),
            3 => collect_structs(),
            4 => collect_enums(),
            5 => resolve_all_uses(),
            6 => collect_aliases(),
            7 => check_struct_cycles(),
            8 => collect_impls(),
            9 => collect_methods(),
            10 => collect_functions(),
            11 => check_impl_signatures(),
            12 => collect_statics(),
            _ => evaluate_consts(),
        }
    } else {
        // Later phases would only report what follows from this error.
        restore_check_state(state);
        report_legacy_imports(false);
        exit_if_errors();
    }
    recover_leave(depth);
}

fn check_function_recovering(item: i64) {
    let depth = RECOVER_DEPTH;
    let state = save_check_state();
    if _setjmp(recover_enter()) == 0 {
        check_function(item);
    } else {
        restore_check_state(state);
    }
    recover_leave(depth);
}

// What the checker must put back after an error (see err_end): its
// scopes, stacks and context.
struct CheckState {
    env: i64, scopes: i64, loops: i64, module: i64, self_ty: i64, tp_base: i64, tp_count: i64,
    inst: i64, ret: i64, tscratch: i64, scratch: i64, const_context: bool,
    defer_base: i64, unsafe_depth: i64, wrap: i64,
}

fn save_check_state() -> CheckState {
    CheckState {
        env: ENV.count, scopes: SCOPES.count, loops: LOOP_STACK.count, module: CUR_MOD,
        self_ty: SELF_TYPE, tp_base: TP_BASE, tp_count: TP_NAMES.count, inst: CUR_INST,
        ret: RETURN_TYPE, tscratch: TSCRATCH.count, scratch: SCRATCH.count,
        const_context: CONST_CONTEXT, defer_base: DEFER_LOOP_BASE, unsafe_depth: UNSAFE_DEPTH,
        wrap: WRAP_NODE,
    }
}

fn restore_check_state(s: CheckState) {
    ENV.count = s.env;
    SCOPES.count = s.scopes;
    LOOP_STACK.count = s.loops;
    DEFER_LOOP_BASE = s.defer_base;
    CUR_MOD = s.module;
    SELF_TYPE = s.self_ty;
    TP_BASE = s.tp_base;
    TP_NAMES.count = s.tp_count;
    TP_TYPES.count = s.tp_count;
    CUR_INST = s.inst;
    RETURN_TYPE = s.ret;
    TSCRATCH.count = s.tscratch;
    SCRATCH.count = s.scratch;
    CONST_CONTEXT = s.const_context;
    UNSAFE_DEPTH = s.unsafe_depth;
    WRAP_NODE = s.wrap;
    OR_MODE = false;
    UNIFY_SELF = 0;
}

// After an error in statement `stmt`: the names its `let` binds stand for
// values of the error type, so that their uses report nothing more.
fn poison_statement(stmt: i64) {
    if NODES[stmt].kind == Let {
        poison_pattern(NODES[stmt].a);
    }
}

fn poison_pattern(p: i64) {
    if p == 0 {
        return;
    }
    if NODES[p].kind == PatBind {
        NODES[p].x = define_local(NODES[p].a, TY_ERROR, true, false);
        return;
    }
    for i in 0..NODES[p].count {
        poison_pattern(child(p, i));
    }
}

// The program's list, for the code generators: its items without the
// generic templates, then the instances of generic functions.
fn finish_program(program: i64) {
    let mark = list_begin();
    for i in 0..NODES[program].count {
        let item = child(program, i);
        let kind = NODES[item].kind;
        if (kind == Fn || kind == Struct || kind == Enum) && NODES[item].g != 0 {
            continue;
        }
        list_push(item);
    }
    for q in 0..INST_QUEUE.count {
        list_push(FNS[INST_QUEUE.data[q]].node);
    }
    list_end(program, mark);
}

fn duplicate_error(item: i64, kind: *u8) -> ! {
    err_begin(NODES[item].start);
    err_str(c"duplicate ");
    err_str(kind);
    err_str(c" '");
    err_sym(NODES[item].a);
    err_str(c"'");
    err_end()
}

fn collect_names() {
    for i in 0..NODES[PROGRAM].count {
        let item = child(PROGRAM, i);
        let mut kind = NODES[item].kind;
        if kind == Impl {
            continue;
        }
        if kind == Const && NODES[item].b != 0 && NODES[NODES[item].b].kind == TyArray {
            // An array constant (0.9) is an immutable static: memory
            // holding its elements.
            NODES[item].kind = Static;
            NODES[item].d = 0;
            NODES[item].y = 0;
            kind = Static;
        }
        let name = NODES[item].a;
        let m = module_of(item);
        if MODULES[m].is_c {
            NODES[item].p |= ITEM_PUBLIC;
        }
        let key = qualify(m, name);
        match kind {
            Struct | TypeAlias | Enum => {
                if SYM_STRUCT[key] != 0 || SYM_ENUM[key] != 0 || SYM_ALIAS[key] != 0
                    || SYM_PRIMITIVE[name] != 0 || name == SELF_TYPE_SYM {
                    duplicate_error(item, match kind {
                        Struct => c"struct",
                        Enum => c"enum",
                        _ => c"type",
                    });
                }
                match kind {
                    Struct => add_struct(item, key, m),
                    Enum => add_enum(item, key, m),
                    _ => SYM_ALIAS[key] = item,
                }
                SYM_ITEM[key] = item;
                continue;
            }
            Use => continue,
            Trait => {
                if item_node_of(key) != 0 || SYM_PRIMITIVE[name] != 0 {
                    duplicate_error(item, c"name");
                }
                SYM_ITEM[key] = item;
                add_trait(item, key, m);
                continue;
            }
            Mod => {
                if item_node_of(key) != 0 {
                    duplicate_error(item, c"name");
                }
                continue;
            }
            Fn if NODES[item].d != 0 => {
                // A method or associated function: found through METHODS
                // (see collect_methods), which also names it.
                add_fn(item, name, name);
                continue;
            }
            _ => {}
        }
        if SYM_FN[key] != 0 || SYM_CONST[key] != 0 || SYM_STATIC[key] != 0 {
            match kind {
                Const => duplicate_error(item, c"constant"),
                Static => duplicate_error(item, c"static"),
                _ => duplicate_error(item, c"function"),
            }
        }
        if child_module(m, name) >= 0 {
            duplicate_error(item, c"name (a module has it)");
        }
        if name == intern_c(c"size_of") || name == intern_c(c"align_of") {
            name_error(NODES[item].start, c"'", name, c"' is a builtin (size_of(T) and align_of(T)); choose another name");
        }
        SYM_ITEM[key] = item;
        match kind {
            Fn | ExternFn => {
                // C functions and `extern "C" fn` definitions keep their
                // names as symbols; others are prefixed by their module.
                let c_name = kind == ExternFn || NODES[item].y != 0;
                add_fn(item, if c_name { name } else { item_symbol(m, name) }, key);
                SYM_FN[key] = FN_COUNT;
            }
            Const => {
                CONSTS = grow(CONSTS, CONST_COUNT, &CONST_CAP);
                CONSTS[CONST_COUNT] = ConstInfo { node: item, ty: 0, value: 0, state: 0 };
                CONST_COUNT += 1;
                SYM_CONST[key] = CONST_COUNT;
            }
            Static => {
                STATICS = grow(STATICS, STATIC_COUNT, &STATIC_CAP);
                STATICS[STATIC_COUNT] = StaticInfo {
                    node: item, ty: 0, mutable: NODES[item].d != 0, linkage: NODES[item].y,
                };
                STATIC_COUNT += 1;
                SYM_STATIC[key] = STATIC_COUNT;
                // The static's symbol (its name for C, prefixed by its
                // module otherwise) is its item's name from now on, and
                // also finds it (the code generators look statics up by
                // symbol).
                let sym = if NODES[item].y != 0 { name } else { item_symbol(m, name) };
                SYM_STATIC[sym] = STATIC_COUNT;
                NODES[item].a = sym;
            }
            _ => {}
        }
    }
}

pub fn add_fn(item: i64, name: i64, display: i64) {
    FNS = grow(FNS, FN_COUNT, &FN_CAP);
    let kind = NODES[item].kind;
    FNS[FN_COUNT] = FnInfo {
        name: name, node: item, params: 0, param_count: 0, ret: TY_UNIT,
        variadic: kind == ExternFn && NODES[item].d != 0, is_extern: kind == ExternFn,
        self_ty: 0, export: kind == Fn && NODES[item].y != 0,
        display: display, generic: generic_count(NODES[item].g), tmpl: 0, targs: 0, targ_count: 0,
        origin: 0, parent: 0, depth: 0, module: module_of(item),
        attrs: NODES[item].p & (FN_INLINE | FN_NO_INLINE | FN_COLD | FN_UNSAFE),
    };
    FN_COUNT += 1;
    NODES[item].x = FN_COUNT;
}

fn generic_count(g: i64) -> i64 {
    if g == 0 { 0 } else { NODES[g].count }
}

// The symbol `Type.name` of a method (from its type's symbol).
fn method_symbol(type_sym: i64, name: i64) -> i64 {
    let out = buf_new();
    buf_bytes(out, SYMS[type_sym].text);
    buf_byte(out, '.');
    buf_bytes(out, SYMS[name].text);
    intern(buf_slice(out))
}

// The symbol of a type with methods.
fn type_symbol(t: i64) -> i64 {
    if TYPES[t].kind == TyKind::Struct { return STRUCTS[TYPES[t].a].sym; }
    if TYPES[t].kind == TyKind::Enum { return ENUMS[TYPES[t].a].sym; }
    // (0.9: a trait's impl for a builtin type)
    builtin_type_symbol(t)
}

pub fn new_enum(item: i64, name: i64, sym: i64, module: i64) -> i64 {
    ENUMS = grow(ENUMS, ENUM_COUNT, &ENUM_CAP);
    ENUMS[ENUM_COUNT] = EnumInfo {
        name: name, node: item, variants: 0, variant_count: 0, tag: TY_U8,
        has_fields: false, layout_state: 0, repr: NODES[item].c, payload: 0,
        generic: 0, tmpl: 0, targs: 0, targ_count: 0, sym: sym, module: module,
    };
    ENUM_COUNT += 1;
    ENUM_COUNT - 1
}

fn add_enum(item: i64, key: i64, module: i64) {
    let e = new_enum(item, NODES[item].a, item_symbol(module, NODES[item].a), module);
    ENUMS[e].generic = generic_count(NODES[item].g);
    SYM_ENUM[key] = e + 1;
}

pub fn new_struct(item: i64, name: i64, sym: i64, module: i64) -> i64 {
    STRUCTS = grow(STRUCTS, STRUCT_COUNT, &STRUCT_CAP);
    STRUCTS[STRUCT_COUNT] = StructInfo {
        name: name, node: item, fields: 0, field_count: 0, layout_state: 0,
        repr: NODES[item].c, align: NODES[item].d,
        generic: 0, tmpl: 0, targs: 0, targ_count: 0, sym: sym, module: module,
    };
    STRUCT_COUNT += 1;
    STRUCT_COUNT - 1
}

fn add_struct(item: i64, key: i64, module: i64) {
    let s = new_struct(item, NODES[item].a, item_symbol(module, NODES[item].a), module);
    STRUCTS[s].generic = generic_count(NODES[item].g);
    SYM_STRUCT[key] = s + 1;
}

fn collect_const_types() {
    for c in 0..CONST_COUNT {
        let item = CONSTS[c].node;
        CUR_MOD = module_of(item);
        let ty = resolve_type(NODES[item].b);
        // 0.4: fieldless enums, and C strings (`const S: *u8 = c"...";`).
        let string = is_pointer(ty) && NODES[NODES[item].c].kind == CStr;
        if !(is_numeric(ty) || ty == TY_BOOL || is_fieldless_enum(ty) || string) {
            err_begin(NODES[NODES[item].b].start);
            err_str(c"constant '");
            err_sym(NODES[item].a);
            err_str(c"' has type '");
            err_type(ty);
            err_str(c"'; constants must be integers, floats or bool");
            err_end();
        }
        CONSTS[c].ty = ty;
    }
}

fn collect_structs() {
    for s in 0..STRUCT_COUNT {
        if STRUCTS[s].generic == 0 && STRUCTS[s].tmpl == 0 {
            CUR_MOD = STRUCTS[s].module;
            collect_struct_fields(s);
        }
    }
    CUR_MOD = 0;
}

// The fields of struct s (of a struct item, or of an instance of a
// generic one, with its parameters in scope).
pub fn collect_struct_fields(s: i64) {
    let item = STRUCTS[s].node;
    let mark = TSCRATCH.count;
    for i in 0..NODES[item].count {
        let field = child(item, i);
        for j in 0..i {
            if NODES[child(item, j)].a == NODES[field].a {
                err_begin(NODES[field].start);
                err_str(c"duplicate field '");
                err_sym(NODES[field].a);
                err_str(c"' in struct '");
                err_sym(NODES[item].a);
                err_str(c"'");
                err_end();
            }
        }
        let ty = resolve_type(NODES[field].b);
        TSCRATCH.push(ty);
    }
    // Instances made while resolving the types added fields of their own:
    // this struct's go after them.
    STRUCTS[s].fields = FIELD_COUNT;
    for i in 0..NODES[item].count {
        FIELDS = grow(FIELDS, FIELD_COUNT, &FIELD_CAP);
        FIELDS[FIELD_COUNT] = FieldInfo { name: NODES[child(item, i)].a, ty: TSCRATCH.data[mark + i], offset: 0 };
        FIELD_COUNT += 1;
    }
    TSCRATCH.count = mark;
    STRUCTS[s].field_count = NODES[item].count;
}

fn collect_enums() {
    for e in 0..ENUM_COUNT {
        if ENUMS[e].generic == 0 && ENUMS[e].tmpl == 0 {
            CUR_MOD = ENUMS[e].module;
            collect_enum_variants(e);
        }
    }
    CUR_MOD = 0;
}

// The variants of enum e (of an enum item, or of an instance of a generic
// one, with its parameters in scope).
pub fn collect_enum_variants(e: i64) {
    let item = ENUMS[e].node;
    let mut has_fields = false;
    for i in 0..NODES[item].count {
        if NODES[child(item, i)].c != 0 {
            has_fields = true;
        }
    }
    ENUMS[e].has_fields = has_fields;
    // The field types of every variant first (resolving them may make
    // instances, with variants of their own), then the variants.
    let types = TSCRATCH.count;
    let discrs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    let mut next = 0;
    let mut low = 0;
    let mut high = 0;
    for i in 0..NODES[item].count {
        let node = child(item, i);
        for j in 0..i {
            if NODES[child(item, j)].a == NODES[node].a {
                err_begin(NODES[node].start);
                err_str(c"duplicate variant '");
                err_sym(NODES[node].a);
                err_str(c"' in enum '");
                err_sym(NODES[item].a);
                err_str(c"'");
                err_end();
            }
        }
        if NODES[node].c != 0 && NODES[node].count == 0 {
            type_error(node, c"a tuple variant needs at least one field; write the variant without '()'");
        }
        for k in 0..NODES[node].count {
            let ty = resolve_type(child(node, k));
            TSCRATCH.push(ty);
        }
        let mut discr = next;
        if NODES[node].b != 0 {
            if has_fields {
                type_error(NODES[node].b, c"explicit discriminants are only allowed in enums without fields");
            }
            discr = eval_discriminant(NODES[node].b);
        }
        for j in 0..i {
            if discrs.data[j] == discr {
                err_begin(NODES[node].start);
                err_str(c"discriminant ");
                err_int(discr);
                err_str(c" of variant '");
                err_sym(NODES[node].a);
                err_str(c"' is already used by '");
                err_sym(NODES[child(item, j)].a);
                err_str(c"'");
                err_end();
            }
        }
        discrs.push(discr);
        if i == 0 || discr < low {
            low = discr;
        }
        if i == 0 || discr > high {
            high = discr;
        }
        next = discr + 1;
    }
    ENUMS[e].variants = VARIANT_COUNT;
    ENUMS[e].variant_count = NODES[item].count;
    let mut at = types;
    for i in 0..NODES[item].count {
        let node = child(item, i);
        let fields = TLISTS.count;
        for k in 0..NODES[node].count {
            TLISTS.push(TSCRATCH.data[at + k]);
        }
        at += NODES[node].count;
        VARIANTS = grow(VARIANTS, VARIANT_COUNT, &VARIANT_CAP);
        VARIANTS[VARIANT_COUNT] = VariantInfo {
            name: NODES[node].a, node: node, enum_id: e, discr: discrs.data[i], fields: fields,
            field_count: NODES[node].count, shape: 0,
        };
        VARIANT_COUNT += 1;
    }
    TSCRATCH.count = types;
    ENUMS[e].tag = enum_tag_type(e, item, low, high);
    let repr_c = (ENUMS[e].repr & REPR_C) != 0;
    if has_fields {
        for i in 0..ENUMS[e].variant_count {
            let v = enum_variant(e, i);
            let mark = TSCRATCH.count;
            if !repr_c {
                TSCRATCH.push(ENUMS[e].tag);
            }
            for k in 0..VARIANTS[v].field_count {
                TSCRATCH.push(variant_field(v, k));
            }
            VARIANTS[v].shape = make_type(TyKind::Tuple, 0, 0, mark);
        }
    }
}

// The type of the tag of enum e: from #[repr(u8)] and the like, a C int
// for #[repr(C)], else the smallest that holds every discriminant.
fn enum_tag_type(e: i64, item: i64, low: i64, high: i64) -> i64 {
    let mut tag = 0;
    if (ENUMS[e].repr & REPR_INT) != 0 {
        tag = SYM_PRIMITIVE[NODES[item].d];
    } else if (ENUMS[e].repr & REPR_C) != 0 {
        tag = TY_I32;
    } else {
        return tag_type_for(low, high);
    }
    if ENUMS[e].variant_count > 0 && (wrap_int(low, tag) != low || wrap_int(high, tag) != high) {
        err_begin(NODES[item].start);
        err_str(c"the discriminants of enum '");
        err_sym(NODES[item].a);
        err_str(c"' do not fit its tag type '");
        err_type(tag);
        err_str(c"'");
        err_end();
    }
    tag
}

// The smallest integer type holding every discriminant in low..=high.
fn tag_type_for(low: i64, high: i64) -> i64 {
    if low >= 0 {
        if high <= 255 { return TY_U8; }
        if high <= 65535 { return TY_U16; }
        if high <= 4294967295 { return TY_U32; }
        return TY_I64;
    }
    if low >= -128 && high <= 127 { return TY_I8; }
    if low >= -32768 && high <= 32767 { return TY_I16; }
    if low >= -2147483648 && high <= 2147483647 { return TY_I32; }
    TY_I64
}

fn eval_discriminant(n: i64) -> i64 {
    let saved_context = CONST_CONTEXT;
    CONST_CONTEXT = true;
    let ty = synth_expr(n);
    if !is_integer(ty) {
        type_error_got(n, c"an enum discriminant must be an integer", ty);
    }
    let value = const_eval(n);
    CONST_CONTEXT = saved_context;
    if ty == TY_U64 && value < 0 {
        type_error(n, c"an enum discriminant must fit in i64");
    }
    value
}

// The methods and associated functions of impl blocks. Those of a
// generic type (`impl<T> Vec<T>`) are templates, found through GMETHODS
// by the type's template; the others are found through METHODS by type.
fn collect_methods() {
    for f in 0..FN_COUNT {
        let item = FNS[f].node;
        let self_node = NODES[item].h;
        if FNS[f].is_extern || self_node == 0 {
            continue;
        }
        CUR_MOD = FNS[f].module;
        let name = NODES[item].a;
        let tpl = impl_template(item);
        if tpl != TPL_NONE {
            for i in 0..GMETHOD_COUNT {
                if GMETHODS[i].ty == tpl && GMETHODS[i].name == name {
                    err_begin(NODES[item].start);
                    err_str(c"duplicate method '");
                    err_sym(name);
                    err_str(c"' for type '");
                    err_sym(template_name(tpl));
                    err_str(c"'");
                    err_end();
                }
            }
            if tpl < 0 && template_variant_named(-tpl - 1, name) {
                variant_and_method_error(item, template_name(tpl));
            }
            GMETHODS = grow(GMETHODS, GMETHOD_COUNT, &GMETHOD_CAP);
            GMETHODS[GMETHOD_COUNT] = MethodInfo { ty: tpl, name: name, f: f };
            GMETHOD_COUNT += 1;
            let base = if tpl > 0 { STRUCTS[tpl - 1].sym } else { ENUMS[-tpl - 1].sym };
            FNS[f].name = method_symbol(base, name);
            FNS[f].display = join_sym(template_name(tpl), c"::", name);
            continue;
        }
        if NODES[self_node].kind == TyName && NODES[self_node].count == 0 && NODES[self_node].g == 0
            && type_name_key(self_node) < 0
            && SYM_PRIMITIVE[NODES[self_node].a] == 0 && env_lookup(NODES[self_node].a) == 0 {
            name_error(NODES[item].start, c"impl for unknown type '", NODES[self_node].a, c"'");
        }
        let t = resolve_type(self_node);
        let kind = TYPES[t].kind;
        if kind != TyKind::Struct && kind != TyKind::Enum && impl_of_fn(f) < 0 {
            err_begin(NODES[item].start);
            err_str(c"impl blocks are only allowed for structs and enums, not '");
            err_type(t);
            err_str(c"'");
            err_end();
        }
        if find_method(t, name) >= 0 {
            err_begin(NODES[item].start);
            err_str(c"duplicate method '");
            err_sym(name);
            err_str(c"' for type '");
            err_type(t);
            err_str(c"'");
            err_end();
        }
        if kind == TyKind::Enum && find_variant(TYPES[t].a, name) >= 0 {
            let out = buf_new();
            buf_type(out, t);
            variant_and_method_error(item, intern(buf_slice(out)));
        }
        if FNS[f].generic == 0 {
            FNS[f].self_ty = t;
        }
        FNS[f].name = method_symbol(type_symbol(t), name);
        let out = buf_new();
        buf_type(out, t);
        buf_str(out, c"::");
        buf_bytes(out, SYMS[name].text);
        FNS[f].display = intern(buf_slice(out));
        METHODS = grow(METHODS, METHOD_COUNT, &METHOD_CAP);
        METHODS[METHOD_COUNT] = MethodInfo { ty: t, name: name, f: f };
        METHOD_COUNT += 1;
    }
    CUR_MOD = 0;
}

fn variant_and_method_error(item: i64, type_name: i64) -> ! {
    err_begin(NODES[item].start);
    err_str(c"'");
    err_sym(NODES[item].a);
    err_str(c"' is both a variant and an associated function of '");
    err_sym(type_name);
    err_str(c"'");
    err_end()
}

pub fn template_variant_named(e: i64, name: i64) -> bool {
    let item = ENUMS[e].node;
    for i in 0..NODES[item].count {
        if NODES[child(item, i)].a == name {
            return true;
        }
    }
    false
}

// The template an impl block is for, when it is generic (`impl<T>
// Vec<T>`): its self type names a generic type with the impl's
// parameters as arguments. TPL_NONE otherwise.
fn impl_template(item: i64) -> i64 {
    let self_node = NODES[item].h;
    let tpl = template_of_type_node(self_node);
    if tpl == TPL_NONE {
        return TPL_NONE;
    }
    let params = NODES[item].g;
    let impl_count = if params == 0 { 0 } else { NODES[params].a };
    if impl_count == 0 {
        // `impl Vec<i64>`: methods of one instance.
        return TPL_NONE;
    }
    let g = NODES[self_node].g;
    if g == 0 || NODES[g].count != impl_count {
        error_at(NODES[self_node].start, c"a generic impl block is for its type with its parameters as arguments: 'impl<T> Vec<T>'");
    }
    for i in 0..impl_count {
        let arg = child(g, i);
        if NODES[arg].kind != TyName || NODES[arg].a != NODES[child(params, i)].a || NODES[arg].g != 0 {
            error_at(NODES[arg].start, c"a generic impl block is for its type with its parameters as arguments, in order: 'impl<T> Vec<T>'");
        }
    }
    tpl
}

// The template a TyName names (a generic struct or enum), or TPL_NONE.
pub fn template_of_type_node(n: i64) -> i64 {
    if NODES[n].kind != TyName || env_lookup(NODES[n].a) != 0 {
        return TPL_NONE;
    }
    let key = type_name_key(n);
    if key < 0 {
        return TPL_NONE;
    }
    template_of_key(key)
}

static mut GMETHODS: *MethodInfo = 0 as *MethodInfo;
static mut GMETHOD_COUNT: i64 = 0;
static mut GMETHOD_CAP: i64 = 0;

// The method template `name` of template tpl, or -1.
fn find_generic_method(tpl: i64, name: i64) -> i64 {
    for i in 0..GMETHOD_COUNT {
        if GMETHODS[i].ty == tpl && GMETHODS[i].name == name {
            return GMETHODS[i].f;
        }
    }
    -1
}

fn collect_aliases() {
    for i in 0..NODES[PROGRAM].count {
        let item = child(PROGRAM, i);
        // (generic aliases (0.6) are resolved where they are used)
        if NODES[item].kind == TypeAlias && NODES[item].g == 0 {
            CUR_MOD = module_of(item);
            resolve_alias(qualify(CUR_MOD, NODES[item].a), NODES[item].start);
        }
    }
    CUR_MOD = 0;
}

pub fn reset_layout_states() {
    for t in 0..STRUCT_COUNT {
        STRUCTS[t].layout_state = 0;
    }
    for t in 0..ENUM_COUNT {
        ENUMS[t].layout_state = 0;
    }
}

fn check_struct_cycles() {
    for s in 0..STRUCT_COUNT {
        reset_layout_states();
        if struct_has_cycle(s) {
            err_begin(NODES[STRUCTS[s].node].start);
            err_str(c"struct '");
            err_sym(STRUCTS[s].name);
            err_str(c"' has infinite size due to recursive field (use a pointer to break the cycle)");
            err_end();
        }
    }
    for e in 0..ENUM_COUNT {
        reset_layout_states();
        if enum_has_cycle(e) {
            err_begin(NODES[ENUMS[e].node].start);
            err_str(c"enum '");
            err_sym(ENUMS[e].name);
            err_str(c"' has infinite size due to a recursive field (use a pointer to break the cycle)");
            err_end();
        }
    }
}

pub fn enum_has_cycle(e: i64) -> bool {
    if ENUMS[e].layout_state == 1 {
        return true;
    }
    ENUMS[e].layout_state = 1;
    for i in 0..ENUMS[e].variant_count {
        let v = enum_variant(e, i);
        for k in 0..VARIANTS[v].field_count {
            if embeds_cycle(variant_field(v, k)) {
                return true;
            }
        }
    }
    ENUMS[e].layout_state = 0;
    false
}

// layout_state: 1 while visiting.
pub fn struct_has_cycle(s: i64) -> bool {
    if STRUCTS[s].layout_state == 1 {
        return true;
    }
    STRUCTS[s].layout_state = 1;
    for i in 0..STRUCTS[s].field_count {
        if embeds_cycle((*struct_field(s, i)).ty) {
            return true;
        }
    }
    STRUCTS[s].layout_state = 0;
    false
}

fn embeds_cycle(t: i64) -> bool {
    let kind = TYPES[t].kind;
    if kind == TyKind::Struct {
        return struct_has_cycle(TYPES[t].a);
    }
    if kind == TyKind::Enum {
        return enum_has_cycle(TYPES[t].a);
    }
    if kind == TyKind::Array {
        return embeds_cycle(TYPES[t].a);
    }
    if kind == TyKind::Tuple {
        for i in 0..TYPES[t].count {
            if embeds_cycle(type_elem(t, i)) {
                return true;
            }
        }
    }
    false
}

fn collect_functions() {
    for f in 0..FN_COUNT {
        if FNS[f].generic == 0 && FNS[f].tmpl == 0 {
            CUR_MOD = FNS[f].module;
            SELF_TYPE = FNS[f].self_ty;
            resolve_signature(f);
        }
    }
    SELF_TYPE = 0;
    CUR_MOD = 0;
}

// The parameter and result types of function f.
pub fn resolve_signature(f: i64) {
    let item = FNS[f].node;
    let mark = TSCRATCH.count;
    for i in 0..NODES[item].count {
        let param = child(item, i);
        let name = NODES[param].a;
        if name != UNDERSCORE {
            for j in 0..i {
                if NODES[child(item, j)].a == name {
                    name_error(NODES[param].start, c"duplicate parameter '", name, c"'");
                }
            }
        }
        let ty = resolve_type(NODES[param].b);
        TSCRATCH.push(ty);
    }
    FNS[f].params = TLISTS.count;
    FNS[f].param_count = TSCRATCH.count - mark;
    for i in mark..TSCRATCH.count {
        TLISTS.push(TSCRATCH.data[i]);
    }
    TSCRATCH.count = mark;
    FNS[f].ret = if NODES[item].b == 0 { TY_UNIT } else { resolve_type(NODES[item].b) };
    if FNS[f].is_extern || FNS[f].export {
        check_c_function(f);
    }
}

// The parameters and result of a function with C's convention must be
// FFI-safe (see is_ffi_safe).
fn check_c_function(f: i64) {
    let item = FNS[f].node;
    for i in 0..FNS[f].param_count {
        let param = child(item, i);
        check_ffi_type(fn_param(f, i), NODES[param].b, c"parameter");
    }
    let ret = FNS[f].ret;
    if ret != TY_UNIT && ret != TY_NEVER {
        check_ffi_type(ret, NODES[item].b, c"result");
    }
}

fn check_c_signature(fn_ty: i64, n: i64, what: *u8) {
    for i in 0..TYPES[fn_ty].count {
        check_ffi_type(type_elem(fn_ty, i), child(n, i), c"parameter");
    }
    let ret = TYPES[fn_ty].a;
    if ret != TY_UNIT && ret != TY_NEVER {
        check_ffi_type(ret, NODES[n].a, c"result");
    }
}

fn check_ffi_type(t: i64, n: i64, what: *u8) {
    if is_ffi_safe(t) {
        return;
    }
    err_begin(NODES[n].start);
    err_str(c"type '");
    err_type(t);
    err_str(c"' of this ");
    err_str(what);
    err_str(c" cannot cross to C");
    let kind = TYPES[t].kind;
    if kind == TyKind::Struct || kind == TyKind::Enum {
        err_help(c"declare it #[repr(C)] (its layout is unspecified otherwise), with fields that can cross to C");
    } else if kind == TyKind::Fn {
        err_help(c"use an extern \"C\" fn type, and pass functions defined with extern \"C\" fn");
    } else if kind == TyKind::Slice {
        err_help(c"pass the pointer and the length (s.ptr, s.len)");
    } else if kind == TyKind::Tuple {
        err_help(c"use a #[repr(C)] struct");
    } else if kind == TyKind::Array {
        err_help(c"pass a pointer to its first element, or wrap it in a #[repr(C)] struct");
    }
    err_end();
}

fn collect_statics() {
    for s in 0..STATIC_COUNT {
        let item = STATICS[s].node;
        CUR_MOD = module_of(item);
        let ty = resolve_type(NODES[item].b);
        STATICS[s].ty = ty;
        // A static shared with C is memory with C's layout: arrays of
        // FFI-safe types too (0.4).
        if STATICS[s].linkage != 0 && !is_ffi_field(ty) {
            check_ffi_type(ty, NODES[item].b, c"static");
        }
        if STATICS[s].linkage == 1 {
            continue;
        }
        check_const_expr(NODES[item].c, ty);
        if NODES[NODES[item].c].kind == CStr {
            // A C string (0.4): the address of the literal.
            continue;
        }
        // Evaluated now to report non-constant initializers; the code
        // generator evaluates it again into the data section.
        let scratch = buf_new();
        const_emit(NODES[item].c, ty, scratch);
    }
}

fn evaluate_consts() {
    CUR_MOD = 0;
    for c in 0..CONST_COUNT {
        const_value(c);
    }
}

// ---- Resolving types ----

pub fn resolve_type(n: i64) -> i64 {
    let kind = NODES[n].kind;
    match kind {
        TyName => return resolve_type_name(n),
        TyUnit => return TY_UNIT,
        TyNever => return TY_NEVER,
        TyPtr => return ptr_to(resolve_type(NODES[n].a)),
        TySlice => return slice_of(resolve_type(NODES[n].a)),
        TyArray => {
            let elem = resolve_type(NODES[n].a);
            return array_of(elem, eval_array_len(NODES[n].b));
        }
        _ => {}
    }
    // A tuple or a function type: the element types first.
    let mark = TSCRATCH.count;
    for i in 0..NODES[n].count {
        let elem = resolve_type(child(n, i));
        TSCRATCH.push(elem);
    }
    if kind == TyTuple {
        return make_type(TyKind::Tuple, 0, 0, mark);
    }
    let result = resolve_type(NODES[n].a);
    let fn_ty = make_type(TyKind::Fn, result, NODES[n].d, mark);
    if NODES[n].d != 0 {
        check_c_signature(fn_ty, n, c"an extern \"C\" fn type");
    }
    fn_ty
}

// A named type: a type parameter, a primitive, `Self`, or a struct, enum
// or alias (through the module path in its list, if any; an instance of a
// generic one with the arguments in its `g`).
fn resolve_type_name(n: i64) -> i64 {
    let name = NODES[n].a;
    let g = NODES[n].g;
    if NODES[n].count == 0 {
        let param = env_lookup(name);
        if param != 0 {
            if g != 0 {
                name_error(NODES[n].start, c"type parameter '", name, c"' takes no type arguments");
            }
            return param;
        }
        if g == 0 {
            return resolve_named(name, NODES[n].start);
        }
    }
    let key = type_name_key(n);
    if key < 0 {
        unknown_name_error(NODES[n].start, c"unknown type '", name);
    }
    let tpl = template_of_key(key);
    if tpl != TPL_NONE {
        if g == 0 {
            err_begin(NODES[n].start);
            err_str(c"'");
            err_sym(name);
            err_str(c"' is generic: write its type arguments ('");
            err_sym(name);
            err_str(c"<...>')");
            err_end();
        }
        let mark = TSCRATCH.count;
        push_written_targs(g);
        return template_instance(tpl, mark, NODES[n].start);
    }
    if g != 0 && SYM_ALIAS[key] != 0 && NODES[SYM_ALIAS[key]].g != 0 {
        return generic_alias(key, g, NODES[n].start);
    }
    if g != 0 {
        name_error(NODES[n].start, c"'", name, c"' is not generic");
    }
    resolve_key(key, name, NODES[n].start)
}

// `Pair<i64>` of a generic alias (0.6): its type with its parameters bound
// to the arguments written in `g` (resolved here), in its own module.
fn generic_alias(key: i64, g: i64, pos: i64) -> i64 {
    let alias = SYM_ALIAS[key];
    let params = NODES[alias].g;
    if NODES[g].count != NODES[params].count {
        err_begin(pos);
        err_str(c"type alias '");
        err_sym(NODES[alias].a);
        err_str(c"' takes ");
        err_int(NODES[params].count);
        err_str(if NODES[params].count == 1 { c" type argument, got " } else { c" type arguments, got " });
        err_int(NODES[g].count);
        err_end();
    }
    if ALIAS_BUSY[key] != 0 {
        name_error(pos, c"type alias '", NODES[alias].a, c"' is defined in terms of itself");
    }
    let mark = TSCRATCH.count;
    push_written_targs(g);
    let saved = TP_BASE;
    let saved_mod = CUR_MOD;
    TP_BASE = TP_NAMES.count;
    for i in 0..NODES[params].count {
        TP_NAMES.push(NODES[child(params, i)].a);
        TP_TYPES.push(TSCRATCH.data[mark + i]);
    }
    TSCRATCH.count = mark;
    CUR_MOD = module_of(alias);
    ALIAS_BUSY[key] = 1;
    let t = resolve_type(NODES[alias].b);
    ALIAS_BUSY[key] = 0;
    CUR_MOD = saved_mod;
    TP_NAMES.count = TP_BASE;
    TP_TYPES.count = TP_BASE;
    TP_BASE = saved;
    t
}

// The key a TyName names (through its module path), or -1.
pub fn type_name_key(n: i64) -> i64 {
    let name = NODES[n].a;
    let mut m = CUR_MOD;
    let mut b = 0;
    if NODES[n].count > 0 {
        m = path_module(n, NODES[n].count);
        b = lookup_name(m, name, CUR_MOD);
    } else {
        if SYM_PRIMITIVE[name] != 0 || (name == SELF_TYPE_SYM && SELF_TYPE != 0) {
            return -1;
        }
        b = lookup_name(m, name, CUR_MOD);
        note_c_use(NODES[n].start, name, b);
    }
    if binding_kind(b) == B_PRIVATE {
        access_error(b, NODES[n].start, name);
    }
    if binding_kind(b) != B_ITEM {
        return -1;
    }
    binding_value(b)
}

pub fn resolve_named(name: i64, pos: i64) -> i64 {
    let param = env_lookup(name);
    if param != 0 {
        return param;
    }
    if SYM_PRIMITIVE[name] != 0 {
        return SYM_PRIMITIVE[name];
    }
    if name == SELF_TYPE_SYM && SELF_TYPE != 0 {
        return SELF_TYPE;
    }
    let b = lookup_name(CUR_MOD, name, CUR_MOD);
    note_c_use(pos, name, b);
    if binding_kind(b) == B_PRIVATE {
        access_error(b, pos, name);
    }
    if binding_kind(b) != B_ITEM {
        unknown_name_error(pos, c"unknown type '", name);
    }
    let key = binding_value(b);
    if template_of_key(key) != TPL_NONE {
        err_begin(pos);
        err_str(c"'");
        err_sym(name);
        err_str(c"' is generic: write its type arguments ('");
        err_sym(name);
        err_str(c"<...>')");
        err_end();
    }
    resolve_key(key, name, pos)
}

// The struct, enum or alias with key `key`.
pub fn resolve_key(key: i64, name: i64, pos: i64) -> i64 {
    if SYM_STRUCT[key] != 0 {
        return struct_type(SYM_STRUCT[key] - 1);
    }
    if SYM_ENUM[key] != 0 {
        return enum_type(SYM_ENUM[key] - 1);
    }
    if SYM_ALIAS[key] == 0 {
        if SYM_TRAIT[key] != 0 {
            name_error(pos, c"'", name, c"' is a trait, not a type (no trait objects: use a type parameter bounded by it, 'T: Trait')");
        }
        unknown_name_error(pos, c"unknown type '", name);
    }
    resolve_alias(key, pos)
}

fn resolve_alias(key: i64, pos: i64) -> i64 {
    if ALIAS_TYPE[key] != 0 {
        return ALIAS_TYPE[key];
    }
    let alias = SYM_ALIAS[key];
    if NODES[alias].g != 0 {
        err_begin(pos);
        err_str(c"type alias '");
        err_sym(NODES[alias].a);
        err_str(c"' is generic: write its type arguments ('");
        err_sym(NODES[alias].a);
        err_str(c"<...>')");
        err_end();
    }
    if ALIAS_BUSY[key] != 0 {
        name_error(pos, c"type alias '", NODES[alias].a, c"' is defined in terms of itself");
    }
    ALIAS_BUSY[key] = 1;
    let saved = CUR_MOD;
    CUR_MOD = module_of(alias);
    let resolved = resolve_type(NODES[alias].b);
    CUR_MOD = saved;
    ALIAS_BUSY[key] = 0;
    ALIAS_TYPE[key] = resolved;
    resolved
}

// ---- Functions ----

fn check_function(item: i64) {
    let f = NODES[item].x - 1;
    CUR_MOD = FNS[f].module;
    let mut saved_env = TP_BASE;
    if FNS[f].tmpl != 0 {
        // An instance: its template's parameters stand for its arguments.
        saved_env = env_enter(NODES[FNS[FNS[f].tmpl - 1].node].g, FNS[f].targs, FNS[f].targ_count);
        CUR_INST = f;
    }
    SELF_TYPE = FNS[f].self_ty;
    RETURN_TYPE = FNS[f].ret;
    LOOP_STACK.count = 0;
    DEFER_LOOP_BASE = -1;
    ENV.count = 0;
    SCOPES.count = 0;
    for i in 0..NODES[item].count {
        let param = child(item, i);
        if NODES[param].a != UNDERSCORE {
            NODES[param].x = define_local(NODES[param].a, fn_param(f, i), NODES[param].c != 0, true);
            LOCALS[NODES[param].x].borrow = is_borrow_param(param);
            LOCALS[NODES[param].x].tparam = bounded_param_of_type(NODES[param].b);
        } else {
            NODES[param].x = -1;
        }
    }
    UNSAFE_DEPTH = if (FNS[f].attrs & FN_UNSAFE) != 0 { 1 } else { 0 };
    WRAP_NODE = 0;
    let body = NODES[item].c;
    let body_ty = check_block(body, RETURN_TYPE);
    if body_ty != RETURN_TYPE && body_ty != TY_NEVER {
        err_begin(NODES[body].start);
        err_str(c"function '");
        err_sym(NODES[item].a);
        err_str(c"' body has type '");
        err_type(body_ty);
        err_str(c"', expected '");
        err_type(RETURN_TYPE);
        err_str(c"'");
        err_end();
    }
    SELF_TYPE = 0;
    if FNS[f].tmpl != 0 {
        env_leave(saved_env);
        CUR_INST = -1;
    }
    CUR_MOD = 0;
}

// The type of a block; `expected` (0 for none) goes to its tail.
fn check_block(block: i64, expected: i64) -> i64 {
    push_scope();
    let is_unsafe = (NODES[block].p & BLOCK_UNSAFE) != 0;
    if is_unsafe {
        UNSAFE_DEPTH += 1;
    }
    let saved_wrap = WRAP_NODE;
    let mut diverges = false;
    for i in 0..NODES[block].count {
        // A recovery point: after an error, on at the next statement. A
        // block with a statement that failed counts as diverging, which
        // reports nothing more about its type.
        let stmt = child(block, i);
        let depth = RECOVER_DEPTH;
        let state = save_check_state();
        let mut result = false;
        WRAP_NODE = stmt;
        if _setjmp(recover_enter()) == 0 {
            result = check_stmt(stmt);
        } else {
            restore_check_state(state);
            poison_statement(stmt);
            result = true;
        }
        recover_leave(depth);
        if result {
            diverges = true;
        }
    }
    let tail = NODES[block].a;
    let mut ty = TY_UNIT;
    if tail != 0 {
        WRAP_NODE = tail;
        ty = if expected != 0 { check_expr(tail, expected) } else { synth_expr(tail) };
    }
    WRAP_NODE = saved_wrap;
    if is_unsafe {
        UNSAFE_DEPTH -= 1;
    }
    pop_scope();
    NODES[block].ty = if diverges { TY_NEVER } else { ty };
    NODES[block].ty
}

fn check_branch(block: i64, expected: i64) -> i64 {
    let ty = check_block(block, expected);
    if ty != expected && ty != TY_NEVER {
        mismatch_error(block, expected, ty);
    }
    ty
}

// Whether the statement diverges.
fn check_stmt(stmt: i64) -> bool {
    if NODES[stmt].kind == Let {
        return check_let(stmt);
    }
    if NODES[stmt].kind == Defer {
        return check_defer(stmt);
    }
    let expr = NODES[stmt].a;
    let ty = if NODES[stmt].b != 0 { synth_expr(expr) } else { check_expr(expr, TY_UNIT) };
    ty == TY_NEVER
}

// `defer` (0.6): the deferred expression, of any type (its value is
// dropped), may not leave it: no `return`, and `break`/`continue` only to
// loops inside it. It is checked where it stands, so it sees the bindings
// made before it.
fn check_defer(stmt: i64) -> bool {
    let saved = DEFER_LOOP_BASE;
    DEFER_LOOP_BASE = LOOP_STACK.count;
    synth_expr(NODES[stmt].a);
    DEFER_LOOP_BASE = saved;
    false
}

fn check_let(stmt: i64) -> bool {
    let init = NODES[stmt].c;
    let mut binding_ty = 0;
    let mut actual = 0;
    if NODES[stmt].b != 0 {
        binding_ty = resolve_type(NODES[stmt].b);
        actual = check_expr(init, binding_ty);
    } else {
        binding_ty = synth_expr(init);
        actual = binding_ty;
    }
    check_pattern(NODES[stmt].a, binding_ty);
    check_irrefutable(NODES[stmt].a, c"let");
    actual == TY_NEVER
}

// ---- Check mode ----

fn passes_expected_to_operands(op: Tok, expected: i64) -> bool {
    if op == Tok::Plus || op == Tok::Minus || op == Tok::Star || op == Tok::Slash || op == Tok::Percent {
        return is_numeric(expected);
    }
    if op == Tok::Amp || op == Tok::Pipe || op == Tok::Caret {
        return is_integer(expected);
    }
    false
}

// Checks `n` against `expected`; returns `expected`, or `!` when the
// expression diverges.
pub fn check_expr(n: i64, expected: i64) -> i64 {
    fold_layout_query(n);
    HINT_NODE = n;
    HINT_TY = expected;
    let actual = check_expr_inner(n, expected);
    NODES[n].ty = expected;
    actual
}

fn check_expr_inner(n: i64, expected: i64) -> i64 {
    match NODES[n].kind {
        Int if NODES[n].b == SUF_NONE && is_integer(expected) => {
            check_int_fits(n, NODES[n].a as u64, expected);
            return expected;
        }
        Char if is_integer(expected) => {
            check_int_fits(n, NODES[n].a as u64, expected);
            return expected;
        }
        Float if NODES[n].b == SUF_NONE && is_float(expected) => {
            return expected;
        }
        Tuple if TYPES[expected].kind == TyKind::Tuple => {
            check_tuple(n, expected);
            return expected;
        }
        Array if TYPES[expected].kind == TyKind::Array => {
            check_array(n, expected);
            return expected;
        }
        Repeat if TYPES[expected].kind == TyKind::Array => {
            check_expr(NODES[n].a, TYPES[expected].a);
            let count = eval_array_len(NODES[n].b);
            if count != TYPES[expected].b {
                err_begin(NODES[NODES[n].b].start);
                err_str(c"array repeat count is ");
                err_int(count);
                err_str(c", expected ");
                err_int(TYPES[expected].b);
                err_end();
            }
            return expected;
        }
        StructLit => {
            check_struct_literal(n, expected);
            return expected;
        }
        If => return check_if(n, expected),
        Match => return check_match(n, expected),
        Block => return check_branch(n, expected),
        Loop => return check_loop(n, expected),
        Binary if passes_expected_to_operands(NODES[n].op, expected) => {
            check_expr(NODES[n].b, expected);
            check_expr(NODES[n].c, expected);
            return expected;
        }
        Binary if (NODES[n].op == Tok::Shl || NODES[n].op == Tok::Shr) && is_integer(expected) => {
            check_expr(NODES[n].b, expected);
            check_shift_amount(NODES[n].c);
            return expected;
        }
        Unary if NODES[n].op == Tok::Minus && is_numeric(expected) => {
            check_negation(n, expected);
            return expected;
        }
        Unary if NODES[n].op == Tok::Tilde && is_integer(expected) => {
            check_expr(NODES[n].b, expected);
            return expected;
        }
        _ => {}
    }
    let actual = synth_expr(n);
    if actual == TY_NEVER {
        return actual;
    }
    if actual != expected {
        mismatch_error(n, expected, actual);
    }
    expected
}

fn check_int_fits(n: i64, value: u64, ty: i64) {
    if value > int_max(ty) {
        err_begin(NODES[n].start);
        err_str(c"integer literal ");
        buf_uint(ERR, value);
        err_str(c" does not fit in type '");
        err_type(ty);
        err_str(c"'");
        err_end();
    }
}

fn check_tuple(n: i64, expected: i64) {
    let count = NODES[n].count;
    if count != TYPES[expected].count {
        err_begin(NODES[n].start);
        err_str(c"tuple has ");
        err_int(count);
        err_str(c" elements, expected ");
        err_int(TYPES[expected].count);
        err_end();
    }
    for i in 0..count {
        check_expr(child(n, i), type_elem(expected, i));
    }
}

fn check_array(n: i64, expected: i64) {
    let count = NODES[n].count;
    if count != TYPES[expected].b {
        err_begin(NODES[n].start);
        err_str(c"array has ");
        err_int(count);
        err_str(c" elements, expected ");
        err_int(TYPES[expected].b);
        err_end();
    }
    for i in 0..count {
        check_expr(child(n, i), TYPES[expected].a);
    }
}

// The struct a struct literal names (`Self` included; through its module
// path, h), or -1. A generic struct's template is returned as it is.
fn struct_of_literal(n: i64) -> i64 {
    let name = NODES[n].a;
    if NODES[n].h == 0 {
        if name == SELF_TYPE_SYM && SELF_TYPE != 0 && TYPES[SELF_TYPE].kind == TyKind::Struct {
            return TYPES[SELF_TYPE].a;
        }
        let param = env_lookup(name);
        if param != 0 && TYPES[param].kind == TyKind::Struct {
            return TYPES[param].a;
        }
    }
    let m = if NODES[n].h != 0 { path_module(NODES[n].h, NODES[NODES[n].h].count) } else { CUR_MOD };
    let b = lookup_name(m, name, CUR_MOD);
    if NODES[n].h == 0 {
        note_c_use(NODES[n].start, name, b);
    }
    if binding_kind(b) == B_PRIVATE {
        access_error(b, NODES[n].start, name);
    }
    if binding_kind(b) != B_ITEM {
        return -1;
    }
    let key = binding_value(b);
    if SYM_STRUCT[key] != 0 {
        return SYM_STRUCT[key] - 1;
    }
    if SYM_ALIAS[key] != 0 {
        let t = resolve_alias(key, NODES[n].start);
        if TYPES[t].kind == TyKind::Struct {
            return TYPES[t].a;
        }
    }
    -1
}

fn check_struct_literal(n: i64, expected: i64) {
    let actual = check_struct_fields(n, expected);
    if actual != expected {
        if TYPES[expected].kind == TyKind::Struct && TYPES[actual].kind == TyKind::Struct {
            err_begin(NODES[n].start);
            err_str(c"expected struct '");
            err_sym(STRUCTS[TYPES[expected].a].name);
            err_str(c"', got constructor for '");
            err_sym(STRUCTS[TYPES[actual].a].name);
            err_str(c"'");
            err_end();
        }
        mismatch_error(n, expected, actual);
    }
}

// The fields of `Name { ... }`: each exactly once, with its declared type.
// `expected` (0: none) may give a generic struct's type arguments.
fn check_struct_fields(n: i64, expected: i64) -> i64 {
    let name = NODES[n].a;
    let mut s = struct_of_literal(n);
    if s < 0 {
        name_error(NODES[n].start, c"unknown struct '", name, c"'");
    }
    if STRUCTS[s].generic > 0 {
        s = infer_struct_literal(s, n, expected);
    } else if NODES[n].g != 0 {
        name_error(NODES[n].start, c"struct '", name, c"' is not generic");
    }
    for i in 0..NODES[n].count {
        let init = child(n, i);
        for j in 0..i {
            if NODES[child(n, j)].a == NODES[init].a {
                name_error(NODES[init].start, c"duplicate field '", NODES[init].a, c"' in constructor");
            }
        }
        let field = find_field(s, NODES[init].a);
        if field < 0 {
            err_begin(NODES[init].start);
            err_str(c"unknown field '");
            err_sym(NODES[init].a);
            err_str(c"' in struct '");
            err_sym(STRUCTS[s].name);
            err_str(c"'");
            err_end();
        }
        NODES[init].x = field;
        check_arg(NODES[init].b, (*struct_field(s, field)).ty);
    }
    if (STRUCTS[s].repr & REPR_UNION) != 0 {
        if NODES[n].count != 1 {
            err_begin(NODES[n].start);
            err_str(c"a literal of union '");
            err_sym(STRUCTS[s].name);
            err_str(c"' sets exactly one field");
            err_end();
        }
        return struct_type(s);
    }
    for f in 0..STRUCTS[s].field_count {
        let mut found = false;
        for i in 0..NODES[n].count {
            if NODES[child(n, i)].x == f {
                found = true;
            }
        }
        if !found {
            err_begin(NODES[n].start);
            err_str(c"missing field '");
            err_sym((*struct_field(s, f)).name);
            err_str(c"' in struct '");
            err_sym(STRUCTS[s].name);
            err_str(c"' constructor");
            err_end();
        }
    }
    struct_type(s)
}

fn check_if(n: i64, expected: i64) -> i64 {
    check_wrapped(NODES[n].a, TY_BOOL);
    let else_block = NODES[n].c;
    if else_block == 0 {
        if expected != TY_UNIT {
            err_begin(NODES[n].start);
            err_str(c"if without else must have type '()', expected '");
            err_type(expected);
            err_str(c"'");
            err_end();
        }
        check_branch(NODES[n].b, TY_UNIT);
        return expected;
    }
    let then_ty = check_branch(NODES[n].b, expected);
    let else_ty = check_branch(else_block, expected);
    if then_ty == TY_NEVER && else_ty == TY_NEVER { TY_NEVER } else { expected }
}

fn check_negation(n: i64, expected: i64) {
    let operand = NODES[n].b;
    if NODES[operand].kind == Int && NODES[operand].b == SUF_NONE && is_signed(expected) {
        let value = NODES[operand].a as u64;
        let magnitude: u64 = if value == 0 { 0 } else { value - 1 };
        if magnitude > int_max(expected) {
            err_begin(NODES[n].start);
            err_str(c"integer literal -");
            buf_uint(ERR, value);
            err_str(c" does not fit in type '");
            err_type(expected);
            err_str(c"'");
            err_end();
        }
        NODES[operand].ty = expected;
        return;
    }
    check_expr(operand, expected);
}

fn check_shift_amount(amount: i64) {
    let ty = synth_expr(amount);
    if !is_integer(ty) {
        type_error_got(amount, c"shift amount must be integer", ty);
    }
}

// ---- Synth mode ----

pub fn synth_expr(n: i64) -> i64 {
    fold_layout_query(n);
    let ty = synth_expr_inner(n);
    NODES[n].ty = ty;
    ty
}

fn synth_expr_inner(n: i64) -> i64 {
    match NODES[n].kind {
        Int | Float => {
            if NODES[n].b != SUF_NONE {
                return suffixed_literal(n, false);
            }
            if NODES[n].kind == Int { TY_I64 } else { TY_F64 }
        }
        Char => TY_U8,
        Bool => TY_BOOL,
        Unit => TY_UNIT,
        Str => TY_STRING,
        CStr => TY_U8_PTR,
        Ident => synth_name(n),
        EnumPanic => {
            synth_expr(NODES[n].a);
            TY_NEVER
        }
        // Already checked (a path made a variant), when a rewrite checks
        // an expression again.
        VariantLit => NODES[n].ty,
        Binary => synth_binary(n),
        Unary => synth_unary(n),
        Cast => synth_cast(n),
        Call => synth_call(n),
        Index => synth_index(n),
        FieldAccess => synth_field(n),
        TupleField => synth_tuple_field(n),
        Tuple => {
            let mark = TSCRATCH.count;
            for i in 0..NODES[n].count {
                let elem = synth_expr(child(n, i));
                TSCRATCH.push(elem);
            }
            make_type(TyKind::Tuple, 0, 0, mark)
        }
        Array => synth_array(n),
        Repeat => {
            let elem = synth_expr(NODES[n].a);
            array_of(elem, eval_array_len(NODES[n].b))
        }
        StructLit => check_struct_fields(n, 0),
        Block => check_block(n, 0),
        If => synth_if(n),
        Match => check_match(n, 0),
        Path => synth_path(n),
        MethodCall => synth_method(n),
        Loop => check_loop(n, 0),
        While => check_while(n),
        For => check_for(n),
        Range => type_error(n, c"ranges can only be used as the bounds of a 'for' loop"),
        Assign => {
            check_assign(n);
            TY_UNIT
        }
        Return => check_return(n),
        Break => {
            check_break(n);
            TY_NEVER
        }
        Continue => {
            NODES[n].x = find_loop(n, c"continue");
            TY_NEVER
        }
        _ => type_error(n, c"internal error: not an expression"),
    }
}

fn suffix_type(suffix: i64) -> i64 {
    if suffix == SUF_I8 { return TY_I8; }
    if suffix == SUF_I16 { return TY_I16; }
    if suffix == SUF_I32 { return TY_I32; }
    if suffix == SUF_I64 || suffix == SUF_ISIZE { return TY_I64; }
    if suffix == SUF_U8 { return TY_U8; }
    if suffix == SUF_U16 { return TY_U16; }
    if suffix == SUF_U32 { return TY_U32; }
    if suffix == SUF_U64 || suffix == SUF_USIZE { return TY_U64; }
    if suffix == SUF_F32 { return TY_F32; }
    TY_F64
}

// `1u8`, `2.5f32`; `negated` allows `-128i8`.
fn suffixed_literal(n: i64, negated: bool) -> i64 {
    let ty = suffix_type(NODES[n].b);
    if NODES[n].kind == Int && is_integer(ty) {
        let value = NODES[n].a as u64;
        let mut limit = value;
        if negated && is_signed(ty) && value > 0 {
            limit = value - 1;
        }
        if limit > int_max(ty) {
            err_begin(NODES[n].start);
            err_str(c"integer literal ");
            if negated {
                err_str(c"-");
            }
            buf_uint(ERR, value);
            err_str(c" does not fit in type '");
            err_type(ty);
            err_str(c"'");
            err_end();
        }
    }
    ty
}

fn synth_name(n: i64) -> i64 {
    let name = NODES[n].a;
    let resolved = (NODES[n].p & NODE_RESOLVED) != 0;
    if !resolved {
        match lookup_local(name) {
            Option::Some(local) => {
                if NODES[n].g != 0 {
                    name_error(NODES[n].start, c"'", name, c"' is a variable, not a generic function");
                }
                NODES[n].res = Res::Local;
                NODES[n].y = local;
                return LOCALS[local].ty;
            }
            Option::None => {}
        }
    }
    let b = if resolved { binding(B_ITEM, name) } else { lookup_name(CUR_MOD, name, CUR_MOD) };
    if !resolved {
        note_c_use(NODES[n].start, name, b);
    }
    let kind = binding_kind(b);
    if kind == B_PRIVATE {
        access_error(b, NODES[n].start, name);
    }
    if kind == B_VARIANT {
        // A variant brought into scope by `use E::...;`: `E::V`.
        let v = binding_value(b);
        NODES[n].kind = Path;
        NODES[n].a = VARIANTS[v].name;
        NODES[n].b = VARIANTS[v].name;
        NODES[n].y = enum_type(VARIANTS[v].enum_id);
        return synth_expr(n);
    }
    if kind == B_TVARIANT {
        // A variant of a generic enum (0.6): its type arguments inferred
        // (`y` < 0: the template; see path_target).
        NODES[n].kind = Path;
        NODES[n].b = name;
        NODES[n].y = -binding_value(b) - 1;
        return synth_expr(n);
    }
    if kind == B_MODULE {
        name_error(NODES[n].start, c"'", name, c"' is a module, not a value");
    }
    if kind != B_ITEM {
        unknown_name_error(NODES[n].start, c"undefined variable '", name);
    }
    let key = binding_value(b);
    if SYM_CONST[key] != 0 {
        let c = SYM_CONST[key] - 1;
        let init = NODES[CONSTS[c].node].c;
        if NODES[init].kind == CStr && is_pointer(CONSTS[c].ty) {
            // A C string constant: the literal itself.
            NODES[n].kind = CStr;
            NODES[n].a = NODES[init].a;
            return CONSTS[c].ty;
        }
        NODES[n].res = Res::Const;
        NODES[n].y = c;
        return CONSTS[NODES[n].y].ty;
    }
    if SYM_STATIC[key] != 0 {
        NODES[n].res = Res::Static;
        NODES[n].y = SYM_STATIC[key] - 1;
        // The code generators find statics by their symbol.
        NODES[n].a = NODES[STATICS[NODES[n].y].node].a;
        return STATICS[NODES[n].y].ty;
    }
    if SYM_FN[key] != 0 {
        let mut f = SYM_FN[key] - 1;
        if FNS[f].variadic {
            name_error(NODES[n].start, c"variadic function '", name, c"' cannot be used as a value");
        }
        if FNS[f].generic > 0 {
            // `max::<i64>` as a value: the arguments must be written.
            if NODES[n].g == 0 {
                name_error(NODES[n].start, c"generic function '", name, c"' needs its type arguments to be used as a value ('f::<T>')");
            }
            if NODES[NODES[n].g].count != FNS[f].generic {
                targ_count_error(NODES[n].start, c"function", FNS[f].display, FNS[f].generic, NODES[NODES[n].g].count);
            }
            let mark = TSCRATCH.count;
            push_written_targs(NODES[n].g);
            f = fn_instance(f, mark, n);
        } else if NODES[n].g != 0 {
            name_error(NODES[n].start, c"function '", name, c"' is not generic");
        }
        NODES[n].res = Res::Fn;
        NODES[n].y = f;
        if (FNS[f].attrs & FN_UNSAFE) != 0 || has_borrow_param(f) {
            unsafe_op(n, U_FN_VALUE, c"using an `unsafe fn`, or a function with pointer parameters, as a value is unsafe (its callers are not checked)");
        }
        return fn_value_type(f);
    }
    if SYM_STRUCT[key] != 0 || SYM_ENUM[key] != 0 || SYM_ALIAS[key] != 0 {
        name_error(NODES[n].start, c"'", name, c"' is a type, not a value");
    }
    unknown_name_error(NODES[n].start, c"undefined variable '", name)
}

// An Ident whose `a` is already a key (a path resolved to an item).
const NODE_RESOLVED: i64 = 2;

// The enum type of the variant `name` in scope, in a pattern (p) against
// a value of type `ty`, or 0 when `name` is no variant: a generic enum's
// variant (0.6) takes the instance `ty`.
pub fn used_variant_enum(name: i64, ty: i64, p: i64) -> i64 {
    let b = lookup_quiet(CUR_MOD, name, CUR_MOD);
    if binding_kind(b) == B_VARIANT {
        return enum_type(VARIANTS[binding_value(b)].enum_id);
    }
    if binding_kind(b) != B_TVARIANT {
        return 0;
    }
    let e = binding_value(b);
    if !instance_of(ty, -e - 1) {
        err_begin(NODES[p].start);
        err_str(c"expected '");
        err_type(ty);
        err_str(c"', got a pattern of '");
        err_sym(ENUMS[e].name);
        err_str(c"'");
        err_end();
    }
    ty
}

// Whether `name` is a constant in the current scope (its index + 1, or 0).
pub fn scope_const(name: i64) -> i64 {
    let b = lookup_quiet(CUR_MOD, name, CUR_MOD);
    if binding_kind(b) == B_ITEM { SYM_CONST[binding_value(b)] } else { 0 }
}

// The function `name` names in the current scope (index + 1, or 0).
fn scope_fn(name: i64) -> i64 {
    let b = lookup_name(CUR_MOD, name, CUR_MOD);
    if binding_kind(b) == B_ITEM { SYM_FN[binding_value(b)] } else { 0 }
}

// An unknown name; when a C header left it out, why.
pub fn unknown_name_error(pos: i64, before: *u8, name: i64) -> ! {
    err_begin(pos);
    err_str(before);
    err_sym(name);
    err_str(c"'");
    let reason = c_import_skip_reason(name);
    if reason != 0 as *u8 {
        err_help(c"'");
        err_help_sym(name);
        err_help(c"' was not imported from the C headers: ");
        err_help(reason);
    }
    err_end()
}

fn fn_value_type(f: i64) -> i64 {
    let mark = TSCRATCH.count;
    for i in 0..FNS[f].param_count {
        TSCRATCH.push(fn_param(f, i));
    }
    if FNS[f].is_extern || FNS[f].export {
        return make_type(TyKind::Fn, FNS[f].ret, 1, mark);
    }
    make_type(TyKind::Fn, FNS[f].ret, 0, mark)
}

fn is_valid_cast(from: i64, to: i64) -> bool {
    if is_fieldless_enum(from) && is_integer(to) { return true; }
    if is_integer(from) && is_fieldless_enum(to) { return true; }
    if is_numeric(from) && is_numeric(to) { return true; }
    if is_pointer(from) && is_pointer(to) { return true; }
    if is_integer(from) && is_pointer(to) { return true; }
    if is_pointer(from) && is_integer(to) { return true; }
    if from == TY_BOOL && is_integer(to) { return true; }
    from == TY_NEVER
}

fn synth_cast(n: i64) -> i64 {
    let operand = NODES[n].a;
    let from = synth_expr(operand);
    let to = resolve_type(NODES[n].b);
    if !is_valid_cast(from, to) {
        err_begin(NODES[operand].start);
        err_str(c"cannot cast '");
        err_type(from);
        err_str(c"' to '");
        err_type(to);
        err_str(c"'");
        err_end();
    }
    if is_integer(from) && is_fieldless_enum(to) {
        return enum_cast(n, operand, from, to);
    }
    if is_integer(from) && is_pointer(to) && !(NODES[operand].kind == Int && NODES[operand].a == 0) {
        unsafe_op(n, U_INT_PTR, c"casting an integer to a pointer is unsafe");
    }
    to
}

// `n as E` for a fieldless enum E (0.4), checked: it becomes
//   match n { d0 => E::V0, d1 => E::V1, ..., v => <panic: invalid value> }
// (the discriminants the operand's type can hold).
fn enum_cast(n: i64, operand: i64, from: i64, to: i64) -> i64 {
    let e = TYPES[to].a;
    let start = NODES[n].start;
    let end = NODES[n].end;
    let m = new_node(Match, start, end);
    NODES[m].a = operand;
    let mark = list_begin();
    for i in 0..ENUMS[e].variant_count {
        let v = enum_variant(e, i);
        let d = VARIANTS[v].discr;
        let fits = if is_signed(from) {
            let half = 1 << (int_bits(from) - 1) as u64;
            int_bits(from) == 64 || (d >= 0 - half && d < half)
        } else {
            d >= 0 && (int_bits(from) == 64 || d as u64 <= int_max(from))
        };
        if !fits {
            continue;
        }
        let lit = new_node(Int, start, end);
        NODES[lit].a = if d < 0 { 0 - d } else { d };
        let mut value = lit;
        if d < 0 {
            value = new_node(Unary, start, end);
            NODES[value].op = Tok::Minus;
            NODES[value].b = lit;
        }
        let pat = new_node(PatLit, start, end);
        NODES[pat].a = value;
        let body = new_node(Path, start, end);
        NODES[body].a = ENUMS[e].name;
        NODES[body].b = VARIANTS[v].name;
        let arm = new_node(Arm, start, end);
        NODES[arm].a = pat;
        NODES[arm].c = body;
        list_push(arm);
    }
    let name = intern_c(c"__invalid_value");
    let bind = new_node(PatBind, start, end);
    NODES[bind].a = name;
    let value = new_node(Ident, start, end);
    NODES[value].a = name;
    let panic = new_node(EnumPanic, start, end);
    NODES[panic].a = value;
    NODES[panic].x = enum_panic_kind(e);
    let arm = new_node(Arm, start, end);
    NODES[arm].a = bind;
    NODES[arm].c = panic;
    list_push(arm);
    list_end(m, mark);
    NODES[n] = NODES[m];
    synth_expr(n)
}

// `T` as a type node: for casts the checker adds.
fn type_name_node(t: i64, at: i64) -> i64 {
    let node = new_node(TyName, NODES[at].start, NODES[at].end);
    NODES[node].a = intern_c(primitive_name(t));
    node
}

fn cast_node(e: i64, t: i64) -> i64 {
    let c = new_node(Cast, NODES[e].start, NODES[e].end);
    NODES[c].a = e;
    NODES[c].b = type_name_node(t, e);
    c
}

fn synth_index(n: i64) -> i64 {
    let base = NODES[n].a;
    let base_ty = synth_expr(base);
    let base_kind = TYPES[base_ty].kind;
    if base_kind != TyKind::Array && base_kind != TyKind::Ptr && base_kind != TyKind::Slice {
        err_begin(NODES[base].start);
        err_str(c"cannot index type '");
        err_type(base_ty);
        err_str(c"'");
        err_end();
    }
    let index = NODES[n].b;
    if base_kind == TyKind::Ptr {
        if NODES[index].kind == Range {
            unsafe_op(n, U_SLICE, c"slicing a raw pointer is unsafe");
        } else {
            unsafe_op(n, U_INDEX, c"indexing a raw pointer is unsafe");
        }
    }
    if NODES[index].kind == Range {
        // Slicing.
        if NODES[index].a != 0 {
            check_index_type(NODES[index].a);
        }
        if NODES[index].b != 0 {
            check_index_type(NODES[index].b);
        } else if base_kind == TyKind::Ptr {
            type_error(index, c"slicing a pointer needs an end: 'p[lo..hi]'");
        }
        NODES[index].ty = TY_UNIT;
        return slice_of(TYPES[base_ty].a);
    }
    check_index_type(index);
    TYPES[base_ty].a
}

fn check_index_type(index: i64) {
    let index_ty = synth_expr(index);
    if !is_integer(index_ty) {
        err_begin(NODES[index].start);
        err_str(c"index must be integer, got '");
        err_type(index_ty);
        err_str(c"'");
        err_end();
    }
}

// Fields of structs (also through a pointer to one: y = 1) and the `ptr`
// and `len` of slices (y = 2, x = 0 for ptr and 1 for len).
fn synth_field(n: i64) -> i64 {
    let mut base_ty = synth_expr(NODES[n].a);
    let name = NODES[n].b;
    NODES[n].y = 0;
    if TYPES[base_ty].kind == TyKind::Slice {
        NODES[n].y = 2;
        if name == intern_c(c"len") {
            // i64 (0.4; u64 before): lengths and indices mix without casts.
            NODES[n].x = 1;
            return TY_I64;
        }
        if name == intern_c(c"ptr") {
            NODES[n].x = 0;
            return ptr_to(TYPES[base_ty].a);
        }
        err_begin(NODES[n].start);
        err_str(c"slices have the fields 'ptr' and 'len', not '");
        err_sym(name);
        err_str(c"'");
        err_end();
    }
    if TYPES[base_ty].kind == TyKind::Ptr && TYPES[TYPES[base_ty].a].kind == TyKind::Struct {
        NODES[n].y = 1;
        base_ty = TYPES[base_ty].a;
        if !is_borrow(NODES[n].a) {
            unsafe_op(n, U_FIELD, c"access to a field through a raw pointer is unsafe");
        }
    }
    if TYPES[base_ty].kind != TyKind::Struct {
        err_begin(NODES[n].start);
        err_str(c"cannot access field '");
        err_sym(name);
        err_str(c"' on type '");
        err_type(base_ty);
        err_str(c"'");
        err_end();
    }
    let s = TYPES[base_ty].a;
    let field = find_field(s, name);
    if field < 0 {
        err_begin(NODES[n].start);
        err_str(c"struct '");
        err_sym(STRUCTS[s].name);
        err_str(c"' has no field '");
        err_sym(name);
        err_str(c"'");
        if find_method(base_ty, name) >= 0 {
            err_help(c"'");
            err_help_sym(name);
            err_help(c"' is a method: call it with '(...)'");
        }
        err_end();
    }
    NODES[n].x = field;
    if (STRUCTS[s].repr & REPR_UNION) != 0 && (NODES[n].p & NODE_NO_READ) == 0 {
        unsafe_op(n, U_UNION, c"reading a field of a union is unsafe");
    }
    (*struct_field(s, field)).ty
}

fn synth_tuple_field(n: i64) -> i64 {
    let base_ty = synth_expr(NODES[n].a);
    let index = NODES[n].b;
    if TYPES[base_ty].kind != TyKind::Tuple {
        err_begin(NODES[n].start);
        err_str(c"cannot use tuple index on type '");
        err_type(base_ty);
        err_str(c"'");
        err_end();
    }
    if index >= TYPES[base_ty].count {
        err_begin(NODES[n].start);
        err_str(c"tuple index ");
        err_int(index);
        err_str(c" out of range for tuple with ");
        err_int(TYPES[base_ty].count);
        err_str(c" elements");
        err_end();
    }
    type_elem(base_ty, index)
}

fn synth_array(n: i64) -> i64 {
    let count = NODES[n].count;
    if count == 0 {
        type_error(n, c"cannot infer the type of an empty array; annotate it");
    }
    let elem = synth_expr(child(n, 0));
    for i in 1..count {
        check_expr(child(n, i), elem);
    }
    array_of(elem, count)
}

// Whether block b ends in a variant of a generic enum named without its
// type arguments (`None`, `Option::None`): its type comes from context.
fn tail_needs_context(b: i64) -> bool {
    if NODES[b].kind != Block {
        return false;
    }
    let tail = NODES[b].a;
    if tail == 0 || NODES[tail].g != 0 {
        return false;
    }
    if NODES[tail].kind == Ident {
        if lookup_local(NODES[tail].a).is_some() {
            return false;
        }
        return binding_kind(lookup_quiet(CUR_MOD, NODES[tail].a, CUR_MOD)) == B_TVARIANT;
    }
    if NODES[tail].kind == Path && NODES[tail].count == 0 && NODES[tail].y == 0 {
        let b2 = lookup_quiet(CUR_MOD, NODES[tail].a, CUR_MOD);
        return binding_kind(b2) == B_ITEM && template_of_key(binding_value(b2)) < 0;
    }
    false
}

fn synth_if(n: i64) -> i64 {
    check_wrapped(NODES[n].a, TY_BOOL);
    let else_block = NODES[n].c;
    // (0.9) `if c { None } else { Some(x) }`: the type from the other
    // branch.
    if else_block != 0 && NODES[else_block].kind == Block && tail_needs_context(NODES[n].b)
        && !tail_needs_context(else_block) {
        let else_ty = check_block(else_block, 0);
        if else_ty != TY_NEVER {
            check_branch(NODES[n].b, else_ty);
            return else_ty;
        }
        return check_block(NODES[n].b, 0);
    }
    let then_ty = check_block(NODES[n].b, 0);
    if else_block != 0 && then_ty != TY_NEVER && tail_needs_context(else_block) {
        check_branch(else_block, then_ty);
        return then_ty;
    }
    if else_block == 0 {
        if then_ty != TY_UNIT && then_ty != TY_NEVER {
            type_error_got(n, c"if without else must have type '()'", then_ty);
        }
        return TY_UNIT;
    }
    let else_ty = check_block(else_block, 0);
    if then_ty == TY_NEVER {
        return else_ty;
    }
    if else_ty == TY_NEVER || then_ty == else_ty {
        return then_ty;
    }
    err_begin(NODES[n].start);
    err_str(c"if/else branches have different types: '");
    err_type(then_ty);
    err_str(c"' vs '");
    err_type(else_ty);
    err_str(c"'");
    err_end()
}

// ---- Operators ----

fn is_untyped_literal(n: i64) -> bool {
    match NODES[n].kind {
        Int | Float => NODES[n].b == SUF_NONE,
        Char => true,
        Unary if NODES[n].op == Tok::Minus => is_untyped_literal(NODES[n].b),
        _ => false,
    }
}

fn literal_takes_rhs_type(lhs: i64, rhs: i64) -> bool {
    is_untyped_literal(lhs) && !is_untyped_literal(rhs)
}

// The common type of a non-shift operator's operands.
fn synth_operands(lhs: i64, rhs: i64) -> i64 {
    if literal_takes_rhs_type(lhs, rhs) {
        let rhs_ty = synth_expr(rhs);
        check_expr(lhs, rhs_ty);
        return rhs_ty;
    }
    let lhs_ty = synth_expr(lhs);
    check_expr(rhs, lhs_ty);
    lhs_ty
}

fn synth_binary(n: i64) -> i64 {
    let op = NODES[n].op;
    let lhs = NODES[n].b;
    let rhs = NODES[n].c;
    if op == Tok::Shl || op == Tok::Shr {
        let value_ty = synth_expr(lhs);
        let amount_ty = synth_expr(rhs);
        if !is_integer(value_ty) {
            type_error_got(n, c"shift operator requires integer type", value_ty);
        }
        if !is_integer(amount_ty) {
            type_error_got(n, c"shift amount must be integer", amount_ty);
        }
        return value_ty;
    }
    let ty = synth_operands(lhs, rhs);
    // (0.9: an operator trait's impl for the type)
    if binary_op_trait(op, ty) >= 0 {
        return operator_call(n, ty);
    }
    if op == Tok::Plus || op == Tok::Minus || op == Tok::Star || op == Tok::Slash || op == Tok::Percent {
        if !is_numeric(ty) {
            type_error_got(n, c"arithmetic operator requires numeric type", ty);
        }
        return ty;
    }
    if (op == Tok::Lt || op == Tok::Gt || op == Tok::LtEq || op == Tok::GtEq) && is_fieldless_enum(ty) {
        // 0.4: fieldless enums are ordered by declaration, which must be
        // the order of their discriminants; compared as their tags.
        let e = TYPES[ty].a;
        for i in 1..ENUMS[e].variant_count {
            if VARIANTS[enum_variant(e, i)].discr <= VARIANTS[enum_variant(e, i - 1)].discr {
                err_begin(NODES[n].start);
                err_str(c"'");
                err_sym(ENUMS[e].name);
                err_str(c"' cannot be ordered: its discriminants do not increase in declaration order");
                err_end();
            }
        }
        NODES[n].b = cast_node(lhs, ENUMS[e].tag);
        NODES[n].c = cast_node(rhs, ENUMS[e].tag);
        synth_expr(NODES[n].b);
        synth_expr(NODES[n].c);
        return TY_BOOL;
    }
    if op == Tok::Lt || op == Tok::Gt || op == Tok::LtEq || op == Tok::GtEq {
        if !(is_numeric(ty) || is_pointer(ty)) {
            type_error_got(n, c"comparison requires numeric type", ty);
        }
        return TY_BOOL;
    }
    if op == Tok::EqEq || op == Tok::BangEq {
        if ty == TY_NEVER || ty == TY_ERROR {
            return TY_BOOL;
        }
        let bad = eq_unsupported(ty);
        if bad != 0 {
            if bad == ty {
                type_error_got(n, c"equality requires numeric, bool, pointer or enum type, or a struct, tuple or array of them", ty);
            }
            err_begin(NODES[n].start);
            err_str(c"cannot compare '");
            err_type(ty);
            err_str(c"' with ==: it holds a '");
            err_type(bad);
            err_str(c"', which has no ==");
            err_end();
        }
        if is_compound(ty) {
            structural_eq(n, ty);
        }
        return TY_BOOL;
    }
    if op == Tok::AmpAmp || op == Tok::PipePipe {
        if ty != TY_BOOL {
            type_error_got(n, c"logical operator requires bool", ty);
        }
        return TY_BOOL;
    }
    if !is_integer(ty) {
        type_error_got(n, c"bitwise operator requires integer type", ty);
    }
    ty
}

// ---- Structural equality (0.6) ----
//
// `a == b` on a struct, tuple, array or enum with fields compares field by
// field (floats as floats: NaN differs from itself); `!=` is its negation.
// The checker rewrites the comparison in place into a block it checks:
//     { let l = a; let r = b; l.f == r.f && l.g == r.g }        (struct)
//     { let l = a; let r = b; l.0 == r.0 && ... }               (tuple)
//     { let l = a; let r = b; let mut i = 0; let mut e = true;
//       while e && i < N { e = l[i] == r[i]; i += 1; } e }      (array)
//     { let l = a; let r = b; match (l, r) {
//         (E::V(x0, x1), E::V(y0, y1)) => x0 == y0 && x1 == y1,
//         ..., _ => false } }                                   (enum)
// whose inner comparisons are rewritten the same way when compound.

// 0 when values of type `ty` can be compared with ==, else a type in it
// that cannot.
pub fn eq_unsupported(ty: i64) -> i64 {
    if is_numeric(ty) || ty == TY_BOOL || is_pointer(ty) || is_fn_type(ty) || is_fieldless_enum(ty) {
        return 0;
    }
    let kind = TYPES[ty].kind;
    if kind == TyKind::Struct {
        let s = TYPES[ty].a;
        if (STRUCTS[s].repr & REPR_UNION) != 0 {
            return ty;
        }
        for i in 0..STRUCTS[s].field_count {
            let bad = eq_unsupported((*struct_field(s, i)).ty);
            if bad != 0 { return bad; }
        }
        return 0;
    }
    if kind == TyKind::Tuple {
        for i in 0..TYPES[ty].count {
            let bad = eq_unsupported(type_elem(ty, i));
            if bad != 0 { return bad; }
        }
        return 0;
    }
    if kind == TyKind::Array {
        return eq_unsupported(TYPES[ty].a);
    }
    if kind == TyKind::Enum {
        let e = TYPES[ty].a;
        for i in 0..ENUMS[e].variant_count {
            let v = enum_variant(e, i);
            for k in 0..VARIANTS[v].field_count {
                let bad = eq_unsupported(variant_field(v, k));
                if bad != 0 { return bad; }
            }
        }
        return 0;
    }
    ty
}

fn eq_ident(name: i64, pos: i64) -> i64 {
    let n = new_node(Ident, pos, pos);
    NODES[n].a = name;
    n
}

fn eq_binary(op: Tok, lhs: i64, rhs: i64, pos: i64) -> i64 {
    let n = new_node(Binary, pos, pos);
    NODES[n].op = op;
    NODES[n].b = lhs;
    NODES[n].c = rhs;
    n
}

fn eq_bool(value: bool, pos: i64) -> i64 {
    let n = new_node(Bool, pos, pos);
    NODES[n].a = value as i64;
    n
}

fn eq_int(value: i64, pos: i64) -> i64 {
    let n = new_node(Int, pos, pos);
    NODES[n].a = value;
    NODES[n].b = SUF_NONE;
    n
}

fn eq_bind(name: i64, mutable: bool, pos: i64) -> i64 {
    let p = new_node(PatBind, pos, pos);
    NODES[p].a = name;
    NODES[p].b = mutable as i64;
    p
}

fn eq_let(pattern: i64, init: i64, pos: i64) -> i64 {
    let n = new_node(Let, pos, pos);
    NODES[n].a = pattern;
    NODES[n].c = init;
    n
}

fn eq_stmt(expr: i64, pos: i64) -> i64 {
    let n = new_node(ExprStmt, pos, pos);
    NODES[n].a = expr;
    NODES[n].b = 1;
    n
}

fn eq_assign(op: Tok, target: i64, value: i64, pos: i64) -> i64 {
    let n = new_node(Assign, pos, pos);
    NODES[n].op = op;
    NODES[n].b = target;
    NODES[n].c = value;
    n
}

// `parts` conjoined with &&, `true` for none.
fn eq_and(mark: i64, pos: i64) -> i64 {
    let count = SCRATCH.count - mark;
    if count == 0 {
        return eq_bool(true, pos);
    }
    let mut e = SCRATCH.data[mark];
    for i in 1..count {
        e = eq_binary(Tok::AmpAmp, e, SCRATCH.data[mark + i], pos);
    }
    SCRATCH.count = mark;
    e
}

// The comparison of the values named `l` and `r` (of type `ty`), as
// unchecked nodes.
fn eq_compare(ty: i64, l: i64, r: i64, pos: i64) -> i64 {
    let kind = TYPES[ty].kind;
    if kind == TyKind::Struct {
        let s = TYPES[ty].a;
        let mark = SCRATCH.count;
        for i in 0..STRUCTS[s].field_count {
            let name = (*struct_field(s, i)).name;
            let a = new_node(FieldAccess, pos, pos);
            NODES[a].a = eq_ident(l, pos);
            NODES[a].b = name;
            let b = new_node(FieldAccess, pos, pos);
            NODES[b].a = eq_ident(r, pos);
            NODES[b].b = name;
            SCRATCH.push(eq_binary(Tok::EqEq, a, b, pos));
        }
        return eq_and(mark, pos);
    }
    if kind == TyKind::Tuple {
        let mark = SCRATCH.count;
        for i in 0..TYPES[ty].count {
            let a = new_node(TupleField, pos, pos);
            NODES[a].a = eq_ident(l, pos);
            NODES[a].b = i;
            let b = new_node(TupleField, pos, pos);
            NODES[b].a = eq_ident(r, pos);
            NODES[b].b = i;
            SCRATCH.push(eq_binary(Tok::EqEq, a, b, pos));
        }
        return eq_and(mark, pos);
    }
    if kind == TyKind::Array {
        let i_name = intern_c(c"==i");
        let e_name = intern_c(c"==e");
        let block = new_node(Block, pos, pos);
        let li = new_node(Index, pos, pos);
        NODES[li].a = eq_ident(l, pos);
        NODES[li].b = eq_ident(i_name, pos);
        let ri = new_node(Index, pos, pos);
        NODES[ri].a = eq_ident(r, pos);
        NODES[ri].b = eq_ident(i_name, pos);
        let body = new_node(Block, pos, pos);
        let body_mark = list_begin();
        list_push(eq_stmt(eq_assign(Tok::Eq, eq_ident(e_name, pos), eq_binary(Tok::EqEq, li, ri, pos), pos), pos));
        list_push(eq_stmt(eq_assign(Tok::PlusEq, eq_ident(i_name, pos), eq_int(1, pos), pos), pos));
        list_end(body, body_mark);
        let w = new_node(While, pos, pos);
        NODES[w].b = eq_binary(Tok::AmpAmp, eq_ident(e_name, pos),
            eq_binary(Tok::Lt, eq_ident(i_name, pos), eq_int(TYPES[ty].b, pos), pos), pos);
        NODES[w].c = body;
        let mark = list_begin();
        list_push(eq_let(eq_bind(i_name, true, pos), eq_int(0, pos), pos));
        list_push(eq_let(eq_bind(e_name, true, pos), eq_bool(true, pos), pos));
        list_push(eq_stmt(w, pos));
        list_end(block, mark);
        NODES[block].a = eq_ident(e_name, pos);
        return block;
    }
    // An enum with fields: a match on the pair.
    let e = TYPES[ty].a;
    let m = new_node(Match, pos, pos);
    let pair = new_node(Tuple, pos, pos);
    let pair_mark = list_begin();
    list_push(eq_ident(l, pos));
    list_push(eq_ident(r, pos));
    list_end(pair, pair_mark);
    NODES[m].a = pair;
    let arms = list_begin();
    for i in 0..ENUMS[e].variant_count {
        let v = enum_variant(e, i);
        let count = VARIANTS[v].field_count;
        let pats = new_node(PatTuple, pos, pos);
        let pats_mark = list_begin();
        for side in 0..2 {
            let pv = new_node(PatVariant, pos, pos);
            NODES[pv].a = ENUMS[e].name;
            NODES[pv].b = VARIANTS[v].name;
            NODES[pv].c = (count > 0) as i64;
            NODES[pv].y = ty;
            let fields_mark = list_begin();
            for k in 0..count {
                list_push(eq_bind(eq_field_name(side, k), false, pos));
            }
            list_end(pv, fields_mark);
            list_push(pv);
        }
        list_end(pats, pats_mark);
        let mark = SCRATCH.count;
        for k in 0..count {
            SCRATCH.push(eq_binary(Tok::EqEq, eq_ident(eq_field_name(0, k), pos), eq_ident(eq_field_name(1, k), pos), pos));
        }
        let body = eq_and(mark, pos);
        let arm = new_node(Arm, pos, pos);
        NODES[arm].a = pats;
        NODES[arm].c = body;
        list_push(arm);
    }
    let arm = new_node(Arm, pos, pos);
    NODES[arm].a = new_node(PatWild, pos, pos);
    NODES[arm].c = eq_bool(false, pos);
    NODES[arm].p = ARM_SYNTHETIC;
    list_push(arm);
    list_end(m, arms);
    m
}

// The binding of field k of the left (side 0) or right value in an arm.
fn eq_field_name(side: i64, k: i64) -> i64 {
    let out = buf_new();
    buf_str(out, if side == 0 { c"==x" } else { c"==y" });
    buf_int(out, k);
    intern(buf_slice(out))
}

// Rewrites the checked comparison `n` of two values of compound type `ty`
// into the block above, checked.
fn structural_eq(n: i64, ty: i64) {
    let pos = NODES[n].start;
    let l = intern_c(c"==l");
    let r = intern_c(c"==r");
    let pl = eq_bind(l, false, pos);
    let pr = eq_bind(r, false, pos);
    let block = new_node(Block, NODES[n].start, NODES[n].end);
    let mark = list_begin();
    list_push(eq_let(pl, NODES[n].b, pos));
    list_push(eq_let(pr, NODES[n].c, pos));
    list_end(block, mark);
    let mut tail = eq_compare(ty, l, r, pos);
    if NODES[n].op == Tok::BangEq {
        let not = new_node(Unary, pos, pos);
        NODES[not].op = Tok::Bang;
        NODES[not].b = tail;
        tail = not;
    }
    NODES[block].a = tail;
    // The operands are checked already: only their bindings are made.
    push_scope();
    check_pattern(pl, ty);
    check_pattern(pr, ty);
    check_expr(tail, TY_BOOL);
    pop_scope();
    NODES[n] = NODES[block];
    NODES[n].ty = TY_BOOL;
}

fn synth_unary(n: i64) -> i64 {
    let op = NODES[n].op;
    let operand = NODES[n].b;
    if op == Tok::Minus {
        let mut ty = 0;
        if NODES[operand].kind == Int && NODES[operand].b != SUF_NONE {
            ty = suffixed_literal(operand, true);
            NODES[operand].ty = ty;
        } else {
            ty = synth_expr(operand);
        }
        if !is_numeric(ty) {
            let neg = std_trait(c"Neg");
            if neg >= 0 && has_impl(neg, ty) {
                return negation_call(n, ty);
            }
            type_error_got(n, c"unary '-' requires numeric type", ty);
        }
        return ty;
    }
    if op == Tok::Bang {
        check_expr(operand, TY_BOOL);
        return TY_BOOL;
    }
    if op == Tok::Tilde {
        let ty = synth_expr(operand);
        if !is_integer(ty) {
            type_error_got(n, c"bitwise NOT requires integer type", ty);
        }
        return ty;
    }
    if op == Tok::Star {
        let ty = synth_expr(operand);
        if !is_pointer(ty) {
            err_begin(NODES[n].start);
            err_str(c"cannot deref non-pointer type '");
            err_type(ty);
            err_str(c"'");
            err_end();
        }
        if !is_borrow(operand) {
            unsafe_op(n, U_DEREF, c"dereference of a raw pointer is unsafe");
        }
        return TYPES[ty].a;
    }
    // Tok::Amp: taking an address reads nothing (a union's field too).
    mark_no_read(operand);
    let ty = synth_expr(operand);
    if !is_place(operand) {
        type_error(n, c"cannot take address of non-lvalue expression");
    }
    ptr_to(ty)
}

// ---- Calls ----

fn is_variadic_arg_type(t: i64) -> bool {
    is_ffi_safe(t)
}

// `size_of(T)` and `align_of(T)` (0.4): integer constants, typed like an
// integer literal. The argument, parsed as an expression, is read as a type
// (`*T`, `[T; n]`, `[T]`, `(A, B)` and names are also expressions); the
// call becomes the literal. They are builtins: no function, constant or
// static may have their names (0.5; in 0.4 a function of the same name
// replaced them).
fn fold_layout_query(n: i64) {
    if NODES[n].kind != Call || NODES[n].count != 1 {
        return;
    }
    let callee = NODES[n].a;
    if NODES[callee].kind != Ident || (NODES[callee].p & NODE_RESOLVED) != 0 {
        return;
    }
    let name = NODES[callee].a;
    let is_size = name == intern_c(c"size_of");
    if !is_size && name != intern_c(c"align_of") {
        return;
    }
    if lookup_local(name).is_some() {
        return;
    }
    let t = resolve_type(expr_as_type(child(n, 0)));
    let value = if is_size { type_size(t) } else { type_align(t) };
    NODES[n].kind = Int;
    NODES[n].a = value;
    NODES[n].b = SUF_NONE;
    NODES[n].count = 0;
}

// The expression `e` turned into the type node it spells.
fn expr_as_type(e: i64) -> i64 {
    let kind = NODES[e].kind;
    if kind == TyName || kind == TyPtr || kind == TyUnit
        || kind == TyNever || kind == TyTuple || kind == TyArray
        || kind == TyFn || kind == TySlice {
        // Parsed as a type already (0.5).
        return e;
    }
    if kind == Ident {
        NODES[e].kind = TyName;
    } else if kind == Unary && NODES[e].op == Tok::Star {
        NODES[e].kind = TyPtr;
        NODES[e].a = expr_as_type(NODES[e].b);
    } else if kind == Repeat {
        NODES[e].kind = TyArray;
        NODES[e].a = expr_as_type(NODES[e].a);
    } else if kind == Array && NODES[e].count == 1 {
        NODES[e].kind = TySlice;
        NODES[e].a = expr_as_type(child(e, 0));
    } else if kind == Tuple {
        NODES[e].kind = TyTuple;
        for i in 0..NODES[e].count {
            expr_as_type(child(e, i));
        }
    } else if kind == Unit {
        NODES[e].kind = TyUnit;
    } else {
        type_error(e, c"size_of and align_of take a type");
    }
    e
}

fn synth_call(n: i64) -> i64 {
    let callee = NODES[n].a;
    if callee == 0 && NODES[n].x != 0 {
        // A method call, already checked (and made a call), when a rewrite
        // checks an expression again (`for x in v.items()`).
        return FNS[NODES[n].x - 1].ret;
    }
    if NODES[callee].kind == Path {
        return synth_path_call(n, callee);
    }
    if NODES[callee].kind == Ident && (NODES[callee].p & NODE_RESOLVED) == 0
        && lookup_local(NODES[callee].a).is_none() {
        let name = NODES[callee].a;
        let b = lookup_name(CUR_MOD, name, CUR_MOD);
        note_c_use(NODES[callee].start, name, b);
        if binding_kind(b) == B_VARIANT {
            // `V(a, b)` for a variant brought into scope by `use`.
            let v = binding_value(b);
            NODES[callee].kind = Path;
            NODES[callee].b = name;
            NODES[callee].y = enum_type(VARIANTS[v].enum_id);
            return synth_path_call(n, callee);
        }
        if binding_kind(b) == B_TVARIANT {
            // ... of a generic enum (0.6), its type arguments inferred.
            NODES[callee].kind = Path;
            NODES[callee].b = name;
            NODES[callee].y = -binding_value(b) - 1;
            return synth_path_call(n, callee);
        }
        if binding_kind(b) == B_PRIVATE {
            access_error(b, NODES[callee].start, name);
        }
        if binding_kind(b) == B_ITEM && SYM_FN[binding_value(b)] != 0 {
            return call_function(n, SYM_FN[binding_value(b)] - 1, NODES[callee].g);
        }
    }
    if NODES[callee].kind == Ident && (NODES[callee].p & NODE_RESOLVED) != 0
        && SYM_FN[NODES[callee].a] != 0 {
        return call_function(n, SYM_FN[NODES[callee].a] - 1, NODES[callee].g);
    }
    let callee_ty = synth_expr(callee);
    if !is_fn_type(callee_ty) {
        err_begin(NODES[callee].start);
        err_str(c"cannot call non-function type '");
        err_type(callee_ty);
        err_str(c"'");
        err_end();
    }
    if NODES[n].count != TYPES[callee_ty].count {
        err_begin(NODES[n].start);
        err_str(c"function pointer expects ");
        err_int(TYPES[callee_ty].count);
        err_str(c" arguments, got ");
        err_int(NODES[n].count);
        err_end();
    }
    if TYPES[callee_ty].b != 0 {
        unsafe_op(n, U_C_CALL, c"calling an extern \"C\" function pointer is unsafe");
    }
    for i in 0..NODES[n].count {
        let arg = child(n, i);
        check_expr(arg, type_elem(callee_ty, i));
        if TYPES[callee_ty].b == 0 && is_pointer(type_elem(callee_ty, i)) && !is_borrow(arg) {
            unsafe_op(arg, U_PTR_ARG, c"passing a raw pointer through a function pointer is unsafe (the function may dereference it)");
        }
    }
    TYPES[callee_ty].a
}

// A direct call of function f (a template is instantiated first, with
// the turbofish `written`, a Generics node or 0).
fn call_function(n: i64, f: i64, written: i64) -> i64 {
    let mut g = f;
    if FNS[f].generic > 0 {
        g = instantiate_call(f, n, 0, 0, written);
    } else if written != 0 {
        err_begin(NODES[written].start);
        err_str(c"function '");
        err_sym(FNS[f].display);
        err_str(c"' is not generic");
        err_end();
    }
    NODES[n].x = g + 1;
    check_direct_call(n, g)
}

fn check_direct_call(n: i64, f: i64) -> i64 {
    let count = NODES[n].count;
    let params = FNS[f].param_count;
    let variadic = FNS[f].variadic;
    let arity_ok = if variadic { count >= params } else { count == params };
    if !arity_ok {
        err_begin(NODES[n].start);
        err_str(c"function '");
        err_sym(FNS[f].display);
        err_str(c"' expects ");
        if variadic {
            err_str(c"at least ");
        }
        err_int(params);
        err_str(c" arguments, got ");
        err_int(count);
        err_end();
    }
    for i in 0..params {
        check_arg(child(n, i), fn_param(f, i));
    }
    check_call_safety(n, f, 0);
    for i in params..count {
        let arg = child(n, i);
        let ty = synth_expr(arg);
        if !is_variadic_arg_type(ty) {
            err_begin(NODES[arg].start);
            err_str(c"cannot pass value of type '");
            err_type(ty);
            err_str(c"' as a variadic argument");
            err_end();
        }
    }
    FNS[f].ret
}

// ---- Paths, variants and methods ----

// What the type part of a path `T::m` names: a type (returned), or a
// generic struct or enum without its type arguments (PATH_TPL set, -1
// returned). A path whose first part is a module (`m::f`, `a::b::T::m`)
// names an item: the node becomes an Ident of it (-2 returned).
static mut PATH_TPL: i64 = 0;

fn path_target(n: i64) -> i64 {
    if NODES[n].y > 0 {
        // Made by the checker from a variant in scope.
        return NODES[n].y;
    }
    if NODES[n].y < 0 {
        // ... of a generic enum (0.6): its template.
        PATH_TPL = NODES[n].y;
        return -1;
    }
    let name = NODES[n].a;
    let member = NODES[n].b;
    let mut m = CUR_MOD;
    let mut b = 0;
    let segments = NODES[n].count;
    if segments > 0 {
        // `a::b::T::m` or `a::b::f`: the module of the next-to-last part.
        m = path_module(n, segments - 2);
        b = lookup_name(m, name, CUR_MOD);
    } else {
        if env_lookup(name) != 0 || SYM_PRIMITIVE[name] != 0 || (name == SELF_TYPE_SYM && SELF_TYPE != 0) {
            if NODES[n].g != 0 {
                name_error(NODES[n].start, c"'", name, c"' takes no type arguments");
            }
            return resolve_named(name, NODES[n].start);
        }
        if name == SYM_CRATE || name == SELF_SYM || name == SYM_SUPER {
            m = if name == SYM_CRATE { 0 } else if name == SELF_SYM { CUR_MOD } else { MODULES[CUR_MOD].parent };
            if m < 0 {
                error_at(NODES[n].start, c"the root module has no 'super'");
            }
            b = binding(B_MODULE, m);
        } else {
            b = lookup_name(m, name, CUR_MOD);
            note_c_use(NODES[n].start, name, b);
            if b == B_NONE && name == SYM_STD && STD_MODULE >= 0 {
                b = binding(B_MODULE, STD_MODULE);
            }
        }
    }
    if binding_kind(b) == B_PRIVATE {
        access_error(b, NODES[n].start, name);
    }
    if binding_kind(b) == B_MODULE {
        // `m::item`: the item, by key.
        let target = binding_value(b);
        let item = lookup_name(target, member, CUR_MOD);
        if binding_kind(item) == B_PRIVATE {
            access_error(item, NODES[n].start, member);
        }
        if binding_kind(item) == B_MODULE {
            name_error(NODES[n].start, c"'", member, c"' is a module, not a value");
        }
        if binding_kind(item) == B_VARIANT {
            let v = binding_value(item);
            NODES[n].y = enum_type(VARIANTS[v].enum_id);
            NODES[n].count = 0;
            return NODES[n].y;
        }
        if binding_kind(item) != B_ITEM && target == C_MODULE {
            // (`c::name`, through `import "h.h" as c;`)
            unknown_name_error(NODES[n].start, c"no declaration in the C headers named '", member);
        }
        if binding_kind(item) != B_ITEM {
            err_begin(NODES[n].start);
            err_str(c"no '");
            err_sym(member);
            err_str(c"' in module '");
            if target == 0 {
                err_str(c"crate");
            } else {
                err_sym(MODULES[target].key);
            }
            err_str(c"'");
            err_end();
        }
        NODES[n].kind = Ident;
        NODES[n].a = binding_value(item);
        NODES[n].p |= NODE_RESOLVED;
        NODES[n].g = NODES[n].h;
        NODES[n].count = 0;
        return -2;
    }
    if binding_kind(b) != B_ITEM {
        unknown_name_error(NODES[n].start, c"unknown type '", name);
    }
    let key = binding_value(b);
    let tpl = template_of_key(key);
    if tpl != TPL_NONE {
        if NODES[n].g != 0 {
            let mark = TSCRATCH.count;
            push_written_targs(NODES[n].g);
            return template_instance(tpl, mark, NODES[n].start);
        }
        PATH_TPL = tpl;
        return -1;
    }
    if NODES[n].g != 0 {
        name_error(NODES[n].start, c"'", name, c"' is not generic");
    }
    resolve_key(key, name, NODES[n].start)
}

// `T::m`: a variant without fields, or an associated function as a value.
fn synth_path(n: i64) -> i64 {
    let hint = hint_for(n);
    let mut t = path_target(n);
    if t == -2 {
        return synth_expr(n);
    }
    let member = NODES[n].b;
    if t == -1 {
        if PATH_TPL < 0 && template_variant_named(-PATH_TPL - 1, member) {
            HINT_TY_PATH = hint;
            t = infer_enum(PATH_TPL, 0, member, 0, NODES[n].start);
        } else {
            err_begin(NODES[n].start);
            err_str(c"'");
            err_sym(template_name(PATH_TPL));
            err_str(c"' is generic: write its type arguments ('");
            err_sym(template_name(PATH_TPL));
            err_str(c"::<...>::");
            err_sym(member);
            err_str(c"')");
            err_end();
        }
    }
    if TYPES[t].kind == TyKind::Enum {
        let v = find_variant(TYPES[t].a, member);
        if v >= 0 {
            if VARIANTS[v].field_count > 0 {
                err_begin(NODES[n].start);
                err_str(c"variant '");
                err_type(t);
                err_str(c"::");
                err_sym(member);
                err_str(c"' has ");
                err_int(VARIANTS[v].field_count);
                err_str(if VARIANTS[v].field_count == 1 { c" field" } else { c" fields" });
                err_help(c"construct it with '");
                buf_type(ERR_HELP, t);
                err_help(c"::");
                err_help_sym(member);
                err_help(c"(...)'");
                err_end();
            }
            NODES[n].kind = VariantLit;
            NODES[n].a = v;
            NODES[n].count = 0;
            return t;
        }
    }
    let mut f = method_of(t, member);
    if f < 0 {
        path_member_error(n, t, member);
    }
    if FNS[f].generic > 0 {
        if NODES[n].h == 0 && FNS[f].generic > impl_param_count(f) {
            err_begin(NODES[n].start);
            err_str(c"generic function '");
            err_sym(member);
            err_str(c"' needs its type arguments to be used as a value");
            err_end();
        }
        let mark = TSCRATCH.count;
        bind_impl_params(f, t);
        if NODES[n].h != 0 {
            push_written_targs(NODES[n].h);
        }
        if TSCRATCH.count - mark != FNS[f].generic {
            targ_count_error(NODES[n].start, c"function", FNS[f].display, FNS[f].generic - impl_param_count(f),
                TSCRATCH.count - mark - impl_param_count(f));
        }
        f = fn_instance(f, mark, n);
    }
    NODES[n].kind = Ident;
    NODES[n].a = FNS[f].name;
    NODES[n].res = Res::Fn;
    NODES[n].y = f;
    NODES[n].count = 0;
    fn_value_type(f)
}

// The number of a method template's parameters that are its impl's.
fn impl_param_count(f: i64) -> i64 {
    let item = FNS[f].node;
    if NODES[item].h == 0 || NODES[item].g == 0 { 0 } else { NODES[NODES[item].g].a }
}

// Pushes on TSCRATCH the arguments of t's template that a method
// template of it takes as its impl's parameters.
fn bind_impl_params(f: i64, t: i64) {
    let count = impl_param_count(f);
    if count == 0 {
        return;
    }
    let targs = instance_targs(t);
    for i in 0..count {
        TSCRATCH.push(TLISTS.data[targs + i]);
    }
}

// The method or associated function `name` of type t: of its impl
// blocks, or a template of the generic impl blocks of its template.
fn method_of(t: i64, name: i64) -> i64 {
    let f = find_method(t, name);
    if f >= 0 {
        return f;
    }
    let kind = TYPES[t].kind;
    if kind == TyKind::Struct && STRUCTS[TYPES[t].a].tmpl != 0 {
        return find_generic_method(STRUCTS[TYPES[t].a].tmpl, name);
    }
    if kind == TyKind::Enum && ENUMS[TYPES[t].a].tmpl != 0 {
        return find_generic_method(-ENUMS[TYPES[t].a].tmpl, name);
    }
    -1
}

fn path_member_error(n: i64, t: i64, member: i64) -> ! {
    err_begin(NODES[n].start);
    if TYPES[t].kind == TyKind::Enum {
        err_str(c"no variant or associated function '");
    } else {
        err_str(c"no associated function '");
    }
    err_sym(member);
    err_str(c"' in '");
    err_type(t);
    err_str(c"'");
    err_end()
}

// `T::m(args)`: a variant with fields, or a call of an associated function
// (or of a method, with the receiver passed explicitly).
fn synth_path_call(n: i64, callee: i64) -> i64 {
    let mut t = path_target(callee);
    if t == -2 {
        // `m::f(args)`: a call of an item of a module.
        return synth_call(n);
    }
    let member = NODES[callee].b;
    if NODES[callee].count == 0 && t >= 0 {
        let bp = bounded_param(NODES[callee].a);
        if bp != 0 {
            require_in_bounds(bp, member, NODES[callee].start);
        }
    }
    if t == -1 {
        let tpl = PATH_TPL;
        if tpl < 0 && template_variant_named(-tpl - 1, member) {
            t = infer_enum(tpl, 0, member, n, NODES[callee].start);
        } else {
            let f = find_generic_method(tpl, member);
            if f < 0 {
                err_begin(NODES[callee].start);
                err_str(c"no associated function '");
                err_sym(member);
                err_str(c"' in '");
                err_sym(template_name(tpl));
                err_str(c"'");
                err_end();
            }
            // `Vec::new()`: the type's arguments are inferred too.
            let g = instantiate_call(f, n, 0, 0, NODES[callee].h);
            NODES[n].x = g + 1;
            return check_direct_call(n, g);
        }
    }
    if TYPES[t].kind == TyKind::Enum {
        let v = find_variant(TYPES[t].a, member);
        if v >= 0 {
            let count = VARIANTS[v].field_count;
            if count == 0 {
                err_begin(NODES[n].start);
                err_str(c"variant '");
                err_type(t);
                err_str(c"::");
                err_sym(member);
                err_str(c"' has no fields");
                err_help(c"write it without parentheses");
                err_end();
            }
            if NODES[n].count != count {
                err_begin(NODES[n].start);
                err_str(c"variant '");
                err_type(t);
                err_str(c"::");
                err_sym(member);
                err_str(c"' has ");
                err_int(count);
                err_str(if count == 1 { c" field" } else { c" fields" });
                err_str(c", got ");
                err_int(NODES[n].count);
                err_end();
            }
            for i in 0..count {
                check_arg(child(n, i), variant_field(v, i));
            }
            NODES[n].kind = VariantLit;
            NODES[n].a = v;
            return t;
        }
    }
    let mut f = method_of(t, member);
    if f < 0 {
        path_member_error(callee, t, member);
    }
    if FNS[f].generic > 0 {
        f = instantiate_call(f, n, 0, t, NODES[callee].h);
    }
    NODES[n].x = f + 1;
    check_direct_call(n, f)
}

// Whether function f is a method: its first parameter is named `self`.
fn is_method(f: i64) -> bool {
    let item = FNS[f].node;
    NODES[item].count > 0 && NODES[child(item, 0)].a == SELF_SYM
}

// A new node for the checker: `op operand` (`&` or `*`) of type `ty`.
fn synthetic_unary(op: Tok, operand: i64, ty: i64) -> i64 {
    let u = new_node(Unary, NODES[operand].start, NODES[operand].end);
    NODES[u].op = op;
    NODES[u].b = operand;
    NODES[u].ty = ty;
    u
}

// `x.m(args)`: a call of method m of x's type (or of the type x points
// to), with `&x` or `*x` as needed for its `self`; becomes an NodeKind::Call.
fn synth_method(n: i64) -> i64 {
    let receiver = NODES[n].a;
    let name = NODES[n].b;
    let receiver_ty = synth_expr(receiver);
    let mut t = receiver_ty;
    let mut through_pointer = false;
    if is_pointer(t) && (TYPES[TYPES[t].a].kind == TyKind::Struct || TYPES[TYPES[t].a].kind == TyKind::Enum
        || (method_of(t, name) < 0 && method_of(TYPES[t].a, name) >= 0)) {
        t = TYPES[t].a;
        through_pointer = true;
    }
    // (0.9: a value of a bounded parameter's type has its bounds' methods)
    if NODES[receiver].kind == Ident && NODES[receiver].res == Res::Local && NODES[receiver].y >= 0
        && LOCALS[NODES[receiver].y].tparam != 0 {
        require_in_bounds(LOCALS[NODES[receiver].y].tparam, name, NODES[n].start);
    }
    let f0 = method_of(t, name);
    let mut f = -1;
    if TYPES[t].kind == TyKind::Struct || TYPES[t].kind == TyKind::Enum || f0 >= 0 {
        f = f0;
    }
    if f < 0 {
        err_begin(NODES[n].start);
        err_str(c"no method '");
        err_sym(name);
        err_str(c"' on type '");
        err_type(receiver_ty);
        err_str(c"'");
        if TYPES[t].kind == TyKind::Struct && find_field(TYPES[t].a, name) >= 0 {
            err_help(c"to call a function stored in a field, write (s.f)(x)");
        }
        err_end();
    }
    if !is_method(f) {
        err_begin(NODES[n].start);
        err_str(c"'");
        err_type(t);
        err_str(c"::");
        err_sym(name);
        err_str(c"' is an associated function, not a method (it has no 'self' parameter)");
        err_help(c"call it as '");
        buf_type(ERR_HELP, t);
        err_help(c"::");
        err_help_sym(name);
        err_help(c"(...)'");
        err_end();
    }
    if FNS[f].generic > 0 {
        // A method template: its impl's parameters from the receiver's
        // type, its own from the arguments.
        f = instantiate_call(f, n, 1, t, NODES[n].g);
    } else if NODES[n].g != 0 {
        name_error(NODES[n].start, c"method '", name, c"' is not generic");
    }
    let self_ty = fn_param(f, 0);
    let mut arg = receiver;
    if through_pointer && !is_borrow(receiver) {
        unsafe_op(n, U_METHOD, c"calling a method through a raw pointer is unsafe");
    }
    if self_ty == t {
        if through_pointer {
            arg = synthetic_unary(Tok::Star, receiver, t);
        }
    } else if self_ty == ptr_to(t) {
        if !through_pointer {
            if !is_place(receiver) && !is_compound(t) {
                err_begin(NODES[n].start);
                err_str(c"method '");
                err_sym(name);
                err_str(c"' takes 'self: *");
                err_type(t);
                err_str(c"', but the receiver is a temporary value");
                err_help(c"bind it to a variable first");
                err_end();
            }
            arg = synthetic_unary(Tok::Amp, receiver, self_ty);
        }
    } else {
        err_begin(NODES[n].start);
        err_str(c"method '");
        err_sym(name);
        err_str(c"' has 'self' of type '");
        err_type(self_ty);
        err_str(c"'; a method's 'self' must be '");
        err_type(t);
        err_str(c"' or '*");
        err_type(t);
        err_str(c"'");
        err_end();
    }
    let count = NODES[n].count;
    if count + 1 != FNS[f].param_count {
        err_begin(NODES[n].start);
        err_str(c"method '");
        err_sym(name);
        err_str(c"' expects ");
        err_int(FNS[f].param_count - 1);
        err_str(c" arguments, got ");
        err_int(count);
        err_end();
    }
    let mark = list_begin();
    list_push(arg);
    for i in 0..count {
        let a = child(n, i);
        check_arg(a, fn_param(f, i + 1));
        list_push(a);
    }
    list_end(n, mark);
    NODES[n].kind = Call;
    NODES[n].a = 0;
    NODES[n].x = f + 1;
    check_call_safety(n, f, 1);
    FNS[f].ret
}

// ---- Places and assignment ----

fn is_place(n: i64) -> bool {
    match NODES[n].kind {
        Ident => {
            let name = NODES[n].a;
            lookup_local(name).is_some() || SYM_STATIC[name] != 0
        }
        Unary => NODES[n].op == Tok::Star,
        // Through a pointer.
        FieldAccess if NODES[n].y == 1 => true,
        FieldAccess | TupleField => is_place(NODES[n].a),
        Index => {
            let base = NODES[n].a;
            if NODES[NODES[n].b].kind == Range {
                return false;
            }
            is_pointer(NODES[base].ty) || is_slice(NODES[base].ty) || is_place(base)
        }
        _ => false,
    }
}

fn check_assign(n: i64) {
    let op = NODES[n].op;
    let target = NODES[n].b;
    let value = NODES[n].c;
    if op == Tok::Eq {
        // Writing a union's field reads nothing.
        mark_no_read(target);
    }
    let target_ty = synth_expr(target);
    if !is_place(target) {
        let name = NODES[target].a;
        if NODES[target].kind == Ident && NODES[target].res == Res::Const {
            name_error(NODES[target].start, c"cannot assign to constant '", NODES[CONSTS[NODES[target].y].node].a, c"'");
        }
        if NODES[target].kind == Ident && NODES[target].res == Res::Fn {
            name_error(NODES[target].start, c"cannot assign to function '", name, c"'");
        }
        type_error(target, c"invalid assignment target");
    }
    check_mutable_place(target);
    if op == Tok::Eq {
        check_expr(value, target_ty);
        return;
    }
    if op == Tok::ShlEq || op == Tok::ShrEq {
        if !is_integer(target_ty) {
            type_error_got(n, c"shift assignment requires integer type", target_ty);
        }
        check_shift_amount(value);
        return;
    }
    if op == Tok::AmpEq || op == Tok::PipeEq || op == Tok::CaretEq {
        if !is_integer(target_ty) {
            type_error_got(n, c"bitwise assignment requires integer type", target_ty);
        }
    } else if !is_numeric(target_ty) {
        type_error_got(n, c"compound assignment requires numeric type", target_ty);
    }
    check_expr(value, target_ty);
}

fn check_mutable_place(target: i64) {
    let mut root = target;
    loop {
        match NODES[root].kind {
            // Through a pointer: no `mut` needed.
            FieldAccess if NODES[root].y == 1 => return,
            FieldAccess | TupleField => root = NODES[root].a,
            Index if !is_pointer(NODES[NODES[root].a].ty)
                && !is_slice(NODES[NODES[root].a].ty) => root = NODES[root].a,
            Ident => {
                check_mutable_name(root, target);
                return;
            }
            _ => return,
        }
    }
}

fn check_mutable_name(ident: i64, target: i64) {
    let name = NODES[ident].a;
    let local = if NODES[ident].res == Res::Local { NODES[ident].y } else { -1 };
    if local >= 0 {
        if LOCALS[local].mutable {
            return;
        }
        err_begin(NODES[target].start);
        err_str(c"cannot assign to immutable variable '");
        err_sym(name);
        err_str(c"'");
        if LOCALS[local].is_param {
            err_help(c"make the parameter mutable: `mut ");
            err_help_sym(name);
            err_help(c": ");
            buf_type(ERR_HELP, LOCALS[local].ty);
            err_help(c"`");
        } else {
            err_help(c"make it mutable: `let mut ");
            err_help_sym(name);
            err_help(c"`");
        }
        err_end();
    }
    if NODES[ident].res == Res::Static && !STATICS[NODES[ident].y].mutable {
        err_begin(NODES[target].start);
        err_str(c"cannot assign to immutable static '");
        err_sym(name);
        err_str(c"'");
        err_help(c"declare it `static mut ");
        err_help_sym(name);
        err_help(c"`");
        err_end();
    }
}

// ---- Loops and jumps ----

fn leave_defer_error(n: i64, keyword: *u8) {
    err_begin(NODES[n].start);
    err_str(c"'");
    err_str(keyword);
    err_str(c"' cannot leave a deferred statement");
    err_end();
}

// The loop a `break`/`continue` refers to.
fn find_loop(n: i64, keyword: *u8) -> i64 {
    let label = NODES[n].a;
    if label == 0 {
        if LOOP_STACK.count == 0 {
            err_begin(NODES[n].start);
            err_str(keyword);
            err_str(c" outside of loop");
            err_end();
        }
        if DEFER_LOOP_BASE >= LOOP_STACK.count {
            leave_defer_error(n, keyword);
        }
        return LOOP_STACK.data[LOOP_STACK.count - 1];
    }
    let mut i = LOOP_STACK.count - 1;
    while i >= 0 {
        let lp = LOOP_STACK.data[i];
        if NODES[lp].a == label {
            if DEFER_LOOP_BASE > i {
                leave_defer_error(n, keyword);
            }
            return lp;
        }
        i -= 1;
    }
    name_error(NODES[n].start, c"unknown loop label ':", label, c"'")
}

fn check_loop_body(lp: i64, body: i64) {
    LOOP_STACK.push(lp);
    check_branch(body, TY_UNIT);
    LOOP_STACK.pop();
}

// `loop`; `expected` (0 for none) is the type of its break values.
fn check_loop(n: i64, expected: i64) -> i64 {
    NODES[n].x = 0;
    NODES[n].y = expected;
    check_loop_body(n, NODES[n].b);
    if NODES[n].x == 0 {
        return TY_NEVER;
    }
    if NODES[n].y == 0 { TY_UNIT } else { NODES[n].y }
}

fn check_while(n: i64) -> i64 {
    check_wrapped(NODES[n].b, TY_BOOL);
    check_loop_body(n, NODES[n].c);
    TY_UNIT
}

fn check_for(n: i64) -> i64 {
    let range = NODES[n].c;
    if NODES[range].kind != Range {
        return check_for_each(n);
    }
    let start = NODES[range].a;
    let end = NODES[range].b;
    let mut elem_ty = 0;
    if literal_takes_rhs_type(start, end) {
        elem_ty = synth_expr(end);
        check_expr(start, elem_ty);
    } else {
        elem_ty = synth_expr(start);
        check_expr(end, elem_ty);
    }
    if !is_integer(elem_ty) {
        type_error_got(range, c"range bounds must be integers", elem_ty);
    }
    NODES[range].ty = elem_ty;
    let pattern = NODES[n].b;
    if NODES[pattern].kind == PatTuple {
        type_error(pattern, c"a 'for' loop over a range binds one integer, not a tuple");
    }
    push_scope();
    check_pattern(pattern, elem_ty);
    check_irrefutable(pattern, c"for");
    check_loop_body(n, NODES[n].d);
    pop_scope();
    TY_UNIT
}

// `for p in s` over a slice or an array (0.4), by value:
//   { let s' = s; for i' in 0..len { let p = s'[i']; body } }
// The sequence is evaluated once; the loop keeps its label.
fn check_for_each(n: i64) -> i64 {
    let seq = NODES[n].c;
    let seq_ty = check_wrapped(seq, 0);
    let kind = TYPES[seq_ty].kind;
    if kind != TyKind::Slice && kind != TyKind::Array {
        type_error_got(seq, c"'for' loops iterate over integer ranges ('a..b'), slices and arrays", seq_ty);
    }
    let start = NODES[n].start;
    let end = NODES[n].end;
    // (Fixed names: an inner loop's shadow the outer's, which are read
    // before it. Interned before the symbol tables, see init_declarations.)
    let seq_sym = intern_c(c"__for_seq");
    let index_sym = intern_c(c"__for_index");
    // let s' = s;
    let seq_bind = new_node(PatBind, start, end);
    NODES[seq_bind].a = seq_sym;
    let seq_let = new_node(Let, start, end);
    NODES[seq_let].a = seq_bind;
    NODES[seq_let].c = seq;
    // 0..len
    let zero = new_node(Int, start, end);
    let len = if kind == TyKind::Slice {
        let s_ref = new_node(Ident, start, end);
        NODES[s_ref].a = seq_sym;
        let field = new_node(FieldAccess, start, end);
        NODES[field].a = s_ref;
        NODES[field].b = intern_c(c"len");
        field
    } else {
        let count = new_node(Int, start, end);
        NODES[count].a = TYPES[seq_ty].b;
        NODES[count].b = SUF_I64;
        count
    };
    NODES[zero].b = SUF_I64;
    let range = new_node(Range, start, end);
    NODES[range].a = zero;
    NODES[range].b = len;
    // let p = s'[i'];
    let s_ref = new_node(Ident, start, end);
    NODES[s_ref].a = seq_sym;
    let i_ref = new_node(Ident, start, end);
    NODES[i_ref].a = index_sym;
    let elem = new_node(Index, start, end);
    NODES[elem].a = s_ref;
    NODES[elem].b = i_ref;
    let elem_let = new_node(Let, start, end);
    NODES[elem_let].a = NODES[n].b;
    NODES[elem_let].c = elem;
    // The body, after it.
    let body = new_node(Block, start, end);
    let mark = list_begin();
    list_push(elem_let);
    let old_body = new_node(ExprStmt, start, end);
    NODES[old_body].a = NODES[n].d;
    list_push(old_body);
    list_end(body, mark);
    // The loop, then the block around it, which takes the loop's place.
    let index_bind = new_node(PatBind, start, end);
    NODES[index_bind].a = index_sym;
    let lp = new_node(For, start, end);
    NODES[lp] = NODES[n];
    NODES[lp].b = index_bind;
    NODES[lp].c = range;
    NODES[lp].d = body;
    let outer = new_node(Block, start, end);
    let mark2 = list_begin();
    list_push(seq_let);
    let loop_stmt = new_node(ExprStmt, start, end);
    NODES[loop_stmt].a = lp;
    list_push(loop_stmt);
    list_end(outer, mark2);
    NODES[n] = NODES[outer];
    synth_expr(n)
}

fn check_break(n: i64) {
    let lp = find_loop(n, c"break");
    NODES[n].x = lp;
    let value = NODES[n].b;
    if value != 0 {
        if NODES[lp].kind != Loop {
            err_begin(NODES[value].start);
            err_str(c"'break' with a value is only allowed in 'loop', not in '");
            err_str(if NODES[lp].kind == While { c"while" } else { c"for" });
            err_str(c"'");
            err_end();
        }
        if NODES[lp].y != 0 {
            check_expr(value, NODES[lp].y);
        } else {
            let ty = synth_expr(value);
            if ty != TY_NEVER {
                NODES[lp].y = ty;
            }
        }
    } else if NODES[lp].kind == Loop {
        let ty = NODES[lp].y;
        if ty != 0 && ty != TY_UNIT && ty != TY_NEVER {
            err_begin(NODES[n].start);
            err_str(c"expected '");
            err_type(ty);
            err_str(c"', got '()' (break without a value)");
            err_end();
        }
        if ty == 0 {
            NODES[lp].y = TY_UNIT;
        }
    }
    NODES[lp].x = 1;
}

fn check_return(n: i64) -> i64 {
    let value = NODES[n].a;
    if DEFER_LOOP_BASE >= 0 {
        type_error(n, c"'return' inside a deferred statement");
    }
    if value != 0 {
        check_expr(value, RETURN_TYPE);
    } else if RETURN_TYPE != TY_UNIT && RETURN_TYPE != TY_NEVER {
        err_begin(NODES[n].start);
        err_str(c"empty return in function returning '");
        err_type(RETURN_TYPE);
        err_str(c"'");
        err_end();
    }
    TY_NEVER
}
