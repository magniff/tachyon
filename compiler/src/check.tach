    SYM_TRAIT, add_trait, binary_op_trait, bounded_param, bounded_param_of_type,
    builtin_type_symbol, check_impl_signatures, collect_impls, impl_of_fn, init_traits,
    negation_call, operator_call, require_in_bounds, std_trait, has_impl,
