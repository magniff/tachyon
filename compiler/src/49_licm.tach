// Loop-invariant code motion. Natural loops are found from back edges
// (an edge t -> h where h dominates t); a loop's body is h and every block
// that reaches t without passing h. A pure instruction whose operands are
// all defined outside the loop moves to the loop's preheader (the single
// block entering the header from outside; made by splitting the entering
// edge when needed), and so does a load from a frame slot or a static
// that nothing in the loop may write. Nothing here can trap: division
// never traps in tachyon, and those loads always address valid memory.

// Loops: header, then the index of their first body block in LOOP_BODY,
// and its count (3 per loop).
static mut LOOPS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut LOOP_BODY: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn find_loops(fi: i64) {
    LOOPS.count = 0;
    LOOP_BODY.count = 0;
    let mut work = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for i in 0..ORDER.count {
        let h = ORDER.data[i];
        let start = LOOP_BODY.count;
        // Every back edge into h.
        for k in 0..BLOCKS[h].preds.count {
            let t = BLOCKS[h].preds.data[k];
            if BLOCKS[t].order < 0 || !dominates(h, t) {
                continue;
            }
            if LOOP_BODY.count == start {
                for j in 0..ORDER.count {
                    BLOCKS[ORDER.data[j]].mark = 0;
                }
                BLOCKS[h].mark = 1;
                intvec_push(&LOOP_BODY, h);
            }
            if BLOCKS[t].mark == 0 {
                BLOCKS[t].mark = 1;
                intvec_push(&LOOP_BODY, t);
                intvec_push(&work, t);
            }
            while work.count > 0 {
                let x = intvec_pop(&work);
                for m in 0..BLOCKS[x].preds.count {
                    let p = BLOCKS[x].preds.data[m];
                    if BLOCKS[p].order >= 0 && BLOCKS[p].mark == 0 {
                        BLOCKS[p].mark = 1;
                        intvec_push(&LOOP_BODY, p);
                        intvec_push(&work, p);
                    }
                }
            }
        }
        if LOOP_BODY.count > start {
            intvec_push(&LOOPS, h);
            intvec_push(&LOOPS, start);
            intvec_push(&LOOPS, LOOP_BODY.count - start);
        }
    }
    free(work.data as *u8);
}

// The preheader of the loop with header h (body blocks marked with
// `stamp`), or 0 when the loop has several entering edges (or when its
// entering edge would have to be split and `split` is false).
fn preheader(fi: i64, h: i64, stamp: i64, split: bool) -> i64 {
    let mut outside = 0;
    let mut count = 0;
    for k in 0..BLOCKS[h].preds.count {
        let p = BLOCKS[h].preds.data[k];
        if BLOCKS[p].mark != stamp {
            outside = p;
            count += 1;
        }
    }
    if count != 1 || BLOCKS[outside].order < 0 {
        return 0;
    }
    if BLOCKS[outside].term == TERM_JUMP {
        return outside;
    }
    if !split {
        return 0;
    }
    // Split the edge: a new block between the predecessor and the header,
    // at the same index in the header's predecessors.
    IRF = fi;
    let e = ir_new_block();
    BLOCKS[e].sealed = 1;
    BLOCKS[e].term = TERM_JUMP;
    BLOCKS[e].s0 = h;
    intvec_push(&BLOCKS[e].preds, outside);
    if BLOCKS[outside].s0 == h {
        BLOCKS[outside].s0 = e;
    } else {
        BLOCKS[outside].s1 = e;
    }
    let index = pred_index(h, outside);
    BLOCKS[h].preds.data[index] = e;
    e
}

// Whether something in the loop (blocks marked `stamp`) may write
// [base + offset, + size): a store, a copy, or a call (unless the base is
// a private slot).
fn loop_may_write(start: i64, count: i64, base: i64, offset: i64, size: i64) -> bool {
    for i in start..start + count {
        let mut v = BLOCKS[LOOP_BODY.data[i]].first;
        while v != 0 {
            let op = INSTS[v].op;
            if op == OP_STORE || op == OP_COPY {
                let mut other_offset = if op == OP_STORE { INSTS[v].imm } else { 0 };
                let other = address_base(INSTS[v].a, &other_offset);
                let other_size = if op == OP_STORE { size_of(INSTS[v].imm2) } else { INSTS[v].imm };
                if may_alias(base, offset, size, other, other_offset, other_size) {
                    return true;
                }
            } else if is_call_op(op) && !is_private_slot(base) {
                return true;
            }
            v = INSTS[v].next;
        }
    }
    false
}

fn defined_outside(v: i64, stamp: i64) -> bool {
    v == 0 || BLOCKS[INSTS[v].block].mark != stamp
}

fn is_invariant(v: i64, stamp: i64, start: i64, count: i64) -> bool {
    let op = INSTS[v].op;
    if op == OP_LOAD {
        if !defined_outside(INSTS[v].a, stamp) {
            return false;
        }
        let mut offset = INSTS[v].imm;
        let base = address_base(INSTS[v].a, &offset);
        if object_of(base) == 0 {
            return false;
        }
        return !loop_may_write(start, count, base, offset, size_of(INSTS[v].ty));
    }
    if op < OP_ADD || op > OP_CONV {
        return false;
    }
    defined_outside(INSTS[v].a, stamp) && defined_outside(INSTS[v].b, stamp)
}

fn licm(fi: i64) -> bool {
    // First give every loop a preheader (splitting edges changes the
    // blocks, so the loops are found again until no split is needed).
    let mut rounds = 0;
    loop {
        build_dom_tree(fi);
        find_loops(fi);
        let mut split = false;
        for l in 0..LOOPS.count / 3 {
            let stamp = mark_loop(fi, l);
            let h = LOOPS.data[3 * l];
            if preheader(fi, h, stamp, false) == 0 && preheader(fi, h, stamp, true) != 0 {
                split = true;
            }
        }
        rounds += 1;
        if !split {
            break;
        }
        if rounds > 4 {
            // Give up on the remaining splits; the loop info must be
            // fresh for hoisting.
            build_dom_tree(fi);
            find_loops(fi);
            break;
        }
    }
    find_escaping_slots(fi);
    let mut changed = false;
    let loop_count = LOOPS.count / 3;
    // Innermost (smallest) loops first.
    let mut done = alloc_zeroed((loop_count + 1) * 8) as *i64;
    for _ in 0..loop_count {
        let mut best = -1;
        for l in 0..loop_count {
            if done[l] == 0 && (best < 0 || LOOPS.data[3 * l + 2] < LOOPS.data[3 * best + 2]) {
                best = l;
            }
        }
        done[best] = 1;
        if hoist_loop(fi, best) {
            changed = true;
        }
    }
    free(done as *u8);
    if changed {
        resolve_all(fi);
    }
    changed
}

// Marks the body of loop l with a stamp of its own (and only it); returns
// the stamp.
fn mark_loop(fi: i64, l: i64) -> i64 {
    let start = LOOPS.data[3 * l + 1];
    let count = LOOPS.data[3 * l + 2];
    let stamp = 100 + l;
    for i in 0..IRFUNCS[fi].blocks.count {
        let b = IRFUNCS[fi].blocks.data[i];
        if BLOCKS[b].mark == stamp {
            BLOCKS[b].mark = 0;
        }
    }
    for i in start..start + count {
        BLOCKS[LOOP_BODY.data[i]].mark = stamp;
    }
    stamp
}

fn hoist_loop(fi: i64, l: i64) -> bool {
    let h = LOOPS.data[3 * l];
    let start = LOOPS.data[3 * l + 1];
    let count = LOOPS.data[3 * l + 2];
    let stamp = mark_loop(fi, l);
    let pre = preheader(fi, h, stamp, false);
    if pre == 0 {
        return false;
    }
    let mut moved_any = false;
    let mut moved = true;
    while moved {
        moved = false;
        // In layout order, so operands are seen before their users.
        for k in 0..ORDER.count {
            let b = ORDER.data[k];
            if BLOCKS[b].mark != stamp {
                continue;
            }
            let mut v = BLOCKS[b].first;
            while v != 0 {
                let next = INSTS[v].next;
                ir_resolve_operands(v);
                if is_invariant(v, stamp, start, count) {
                    ir_unlink(v);
                    ir_append(pre, v);
                    moved = true;
                    moved_any = true;
                }
                v = next;
            }
        }
    }
    moved_any
}
