use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Iterators\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`Iterator` is a prelude trait with one required function and an\n");
    buf_bytes(out, "associated type:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "trait Iterator {\n");
    buf_bytes(out, "    type Item;\n");
    buf_bytes(out, "    fn next(self: *Self) -> Option<Self::Item>;\n");
    buf_bytes(out, "    // and, written once in std: map filter enumerate zip take\n");
    buf_bytes(out, "    // fold for_each count sum min max collect\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "std's sources and adapters are small structs whose methods are\n");
    buf_bytes(out, "`#[inline]`: a chain of them compiles to the loop written by hand (the\n");
    buf_bytes(out, "same machine code at -O2, vectorized where the loop would be).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach 0.14\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut v: Vec<i64> = Vec::new();\n");
    buf_bytes(out, "    defer v.free();\n");
    buf_bytes(out, "    for i in 1..=6 { v.push(i); }\n");
    buf_bytes(out, "    std::print_int(v.iter().filter(|x| x % 2 == 0).map(|x| x * x).sum());\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    std::print_int(v.iter().map(|x| x * 10).max().unwrap());\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    std::print_int((0..100).filter(|n| n % 7 == 0).count());\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    for (i, x) in v.iter().enumerate().take(2) {\n");
    buf_bytes(out, "        std::print_int(i * 100 + x);\n");
    buf_bytes(out, "        print(\" \");\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    std::print_int(v.iter().zip(v.iter()).fold(0, |acc, (a, b)| acc + a * b));\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    let mut w = v.iter().map(|x| 7 - x).collect();      // a Vec<i64>\n");
    buf_bytes(out, "    defer w.free();\n");
    buf_bytes(out, "    w.sort_by(|a, b| a.cmp(b));                         // a, b: *i64\n");
    buf_bytes(out, "    for x in w { std::print_int(x); }\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "56 60 15\n");
    buf_bytes(out, "1 102 91\n");
    buf_bytes(out, "123456\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Sources\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| source | items |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `v.iter()` (a `Vec<T>`), `s.iter()` (a slice `[T]`) | each element, a copy |\n");
    buf_bytes(out, "| `m.iter()`, `m.keys()`, `m.values()` (a `HashMap<K, V>`) | `(K, V)`, `K`, `V`, in slot order |\n");
    buf_bytes(out, "| `a..b`, `a..=b` as a value: `(0..n).map(...)` | the integers; `0..=255u8` ends without overflow |\n");
    buf_bytes(out, "| a type with `impl Iterator` | what its `next` returns |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`for x in E` takes a range, a slice or an array as before, an iterator,\n");
    buf_bytes(out, "or anything with an `iter` method (`for x in v`, `for (k, n) in m`);\n");
    buf_bytes(out, "items are copies, as `for x in slice` gives. To change elements, loop\n");
    buf_bytes(out, "over the indices: `for i in 0..v.len() { v.set(i, v.get(i) * 2); }`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Adapters and consumers\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `map(f)`, `filter(f)` (`f` takes the item by value: `|x| x > 0`, not\n");
    buf_bytes(out, "  `|&x|`), `enumerate()` (items `(i64, Item)`), `zip(other)` (items\n");
    buf_bytes(out, "  `(A, B)`, as long as both have one), `take(n)`.\n");
    buf_bytes(out, "- `fold(init, |acc, x| ...)`, `for_each(f)`, `count()`, `sum()` (from\n");
    buf_bytes(out, "  `0 as Item`), `min()` and `max()` (an `Option`), `collect()` (a `Vec`\n");
    buf_bytes(out, "  of the items; free it; there is no other target, and no\n");
    buf_bytes(out, "  `collect::<Vec<_>>()`).\n");
    buf_bytes(out, "- `sort_by(s, |a, b| ...)` sorts in place by a comparison of `*T`s\n");
    buf_bytes(out, "  returning negative, zero or positive (`a.cmp(b)`; `b.cmp(a)`\n");
    buf_bytes(out, "  descending); also `v.sort_by(...)` and `s.sort_by(...)`.\n");
    buf_bytes(out, "- An adapter takes its iterator by value, so a chain is one value; to\n");
    buf_bytes(out, "  call `next` yourself, keep the iterator in a `let mut`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Your own iterator\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach 0.14\n");
    buf_bytes(out, "struct Countdown { n: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Iterator for Countdown {\n");
    buf_bytes(out, "    type Item = i64;\n");
    buf_bytes(out, "    fn next(self: *Countdown) -> Option<i64> {\n");
    buf_bytes(out, "        if self.n == 0 { return None; }\n");
    buf_bytes(out, "        self.n -= 1;\n");
    buf_bytes(out, "        Some(self.n + 1)\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn first<I: Iterator>(it: I) -> Option<I::Item> {\n");
    buf_bytes(out, "    let mut it = it;\n");
    buf_bytes(out, "    it.next()\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn total<I: Iterator<Item = i64>>(it: I) -> i64 {\n");
    buf_bytes(out, "    it.sum()\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let c = Countdown { n: 3 };\n");
    buf_bytes(out, "    for x in c { std::print_int(x); }\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    std::print_int(total(Countdown { n: 4 }));\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    std::print_int(first(Countdown { n: 9 }).unwrap());\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "321 10 9\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `type Item = T;` in the impl is required; `Self::Item` and `I::Item`\n");
    buf_bytes(out, "  (for a type parameter `I: Iterator`) name it. `I: Iterator<Item = i64>`\n");
    buf_bytes(out, "  constrains it.\n");
    buf_bytes(out, "- The defaults (`map`, `sum`...) come with the trait; one used with an\n");
    buf_bytes(out, "  `Item` it does not fit (`sum` of `[u8]` items) is an error only when\n");
    buf_bytes(out, "  it is called.\n");
    buf_bytes(out, "- `exact_len()` (items left, or -1) and `at(k)` are hooks that let `zip`\n");
    buf_bytes(out, "  and `enumerate` run as a counted loop; leave them out.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Not there: `iter_mut` (use indices and `set`), `rev`, `step_by`,\n");
    buf_bytes(out, "`chain`, `flat_map`, `peekable`, `collect` into other types, `dyn\n");
    buf_bytes(out, "Iterator`, returning an iterator built from a closure (0.15).\n");
}
