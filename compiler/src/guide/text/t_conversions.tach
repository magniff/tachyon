// Generated by compiler/guide/embed.sh from compiler/guide/conversions.md (do
// not edit): the guide's topic 'conversions'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Conversions and errors (0.15)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Widening between integers, `From`/`Into`, the `?` operator, `main`\n");
    buf_bytes(out, "returning a `Result`, and std's convention for failure: Option means\n");
    buf_bytes(out, "absent, Result means failed.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Widening\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A narrower integer becomes a wider one where a value of the wider type\n");
    buf_bytes(out, "is expected: `let x: T = v`, assignment and `+=`, arguments, `return`,\n");
    buf_bytes(out, "a block's last value, struct fields, variant payloads, array and tuple\n");
    buf_bytes(out, "elements. It is lossless, so it is implicit; nothing else is:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- it widens: `i8 -> i16 -> i32 -> i64` and `u8 -> u16 -> u32 -> u64`\n");
    buf_bytes(out, "  (the same signedness), and unsigned to a strictly wider signed type\n");
    buf_bytes(out, "  (`u8 -> i16`, `u32 -> i64`); `isize`/`usize` are `i64`/`u64`;\n");
    buf_bytes(out, "- it never converts int to float, `bool` to int, signed to unsigned, or\n");
    buf_bytes(out, "  to a narrower type: write `x as T`;\n");
    buf_bytes(out, "- it applies to a value, never inside another type: `*i32`, `[i32]`,\n");
    buf_bytes(out, "  `Vec<i32>`, `fn(i32)` stay what they are.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Where two integer types meet without an expected type (the operands of\n");
    buf_bytes(out, "`+` or `<`, the branches of `if` and `match`, two arguments for one\n");
    buf_bytes(out, "type parameter), the result is the wider one, if one widens to the\n");
    buf_bytes(out, "other: `a_i32 + b_i64` is an `i64`, `max(a_i32, b_i64)` is\n");
    buf_bytes(out, "`max::<i64>`. An expected type flows into the arithmetic, as it does for\n");
    buf_bytes(out, "literals: `let t: i64 = a_i32 * b_i32` multiplies in `i64`, so the\n");
    buf_bytes(out, "product cannot overflow `i32` first (C's bug, avoided).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn total(xs: [i32]) -> i64 {\n");
    buf_bytes(out, "    let mut t: i64 = 0;\n");
    buf_bytes(out, "    for x in xs { t += x; }              // each i32 widens\n");
    buf_bytes(out, "    t\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let a: i32 = 2000000000;\n");
    buf_bytes(out, "    let b: i32 = 2000000000;\n");
    buf_bytes(out, "    let wide: i64 = a + b;               // computed in i64\n");
    buf_bytes(out, "    let c: u32 = 1200;\n");
    buf_bytes(out, "    let xs = [1i32, 2, 3];\n");
    buf_bytes(out, "    std::print_int(wide);\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    std::print_int(total(xs[..]) + c);   // u32 + i64: an i64\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "4000000000 1206\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## From and Into\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Traits may have type parameters (0.15): `trait From<T> { fn from(x: T)\n");
    buf_bytes(out, "-> Self; }` is std's. A type can implement it for several `T`s, one\n");
    buf_bytes(out, "impl per trait, arguments and type; `T::from(x)` picks the impl by the\n");
    buf_bytes(out, "type of `x`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct Celsius { deg: i64 }\n");
    buf_bytes(out, "struct Fahrenheit { deg: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl From<Celsius> for Fahrenheit {\n");
    buf_bytes(out, "    fn from(c: Celsius) -> Fahrenheit { Fahrenheit { deg: c.deg * 9 / 5 + 32 } }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let f = Fahrenheit::from(Celsius { deg: 100 });\n");
    buf_bytes(out, "    let g: Fahrenheit = Celsius { deg: -40 }.into();   // Into: From backwards\n");
    buf_bytes(out, "    let n = i64::from(7i32);                           // widening is a From too\n");
    buf_bytes(out, "    std::print_int(f.deg);\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    std::print_int(g.deg);\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    std::print_int(n);\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "212 -40 7\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- Implement `From`, never `Into`: `x.into()` is `U::from(x)` with `U`\n");
    buf_bytes(out, "  the type expected there (`let y: U = x.into();`); without one it is an\n");
    buf_bytes(out, "  error. `t: Into<U>` holds when `U: From<t>`.\n");
    buf_bytes(out, "- `From` is there without an impl for the identity and for every\n");
    buf_bytes(out, "  widening (`i64::from(x_i32)` is a cast).\n");
    buf_bytes(out, "- Bounds take arguments: `fn f<T: From<i64>>(n: i64) -> T { T::from(n) }`.\n");
    buf_bytes(out, "- Restrictions of generic traits: no default bodies; the operator traits\n");
    buf_bytes(out, "  (`Add`, ...) stay without parameters; an impl names concrete types or\n");
    buf_bytes(out, "  its own parameters (`impl<T> From<T> for Wrap<T>`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## The ? operator\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`e?` on an `Option<T>` gives the `T`, or returns `None` from the\n");
    buf_bytes(out, "function. On a `Result<T, E>` it gives the `T`, or returns `Err`: the\n");
    buf_bytes(out, "error as it is when `E` is the function's error type `F`, widened when\n");
    buf_bytes(out, "`E` widens to `F`, else `F::from(err)` through an `impl From<E> for F`.\n");
    buf_bytes(out, "Inside a closure it returns from the closure (give it `-> T`). `defer`s\n");
    buf_bytes(out, "run, as for `return`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::ParseIntError;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "enum AppError { Parse(ParseIntError), Negative(i64) }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl From<ParseIntError> for AppError {\n");
    buf_bytes(out, "    fn from(e: ParseIntError) -> AppError { AppError::Parse(e) }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn checked(s: [u8]) -> Result<i64, AppError> {\n");
    buf_bytes(out, "    let n = parse_int(s)?;               // an Err returns Err(AppError::from(e))\n");
    buf_bytes(out, "    if n < 0 { return Err(AppError::Negative(n)); }\n");
    buf_bytes(out, "    Ok(n)\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn half(x: Option<i64>) -> Option<i64> {\n");
    buf_bytes(out, "    let v = x?;                          // None returns None\n");
    buf_bytes(out, "    Some(v / 2)\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    match checked(\"42\") { Ok(n) => std::print_int(n), Err(_) => print(\"error\") }\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    match checked(\"4x\") {\n");
    buf_bytes(out, "        Err(AppError::Parse(ParseIntError::InvalidDigit(at))) => std::print_int(at),\n");
    buf_bytes(out, "        _ => print(\"?\"),\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    match checked(\"-3\") { Err(AppError::Negative(n)) => std::print_int(n), _ => print(\"?\") }\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    std::print_int(half(Some(8)).unwrap_or(-1) + half(None).unwrap_or(-1));\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "42 1 -3 3\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`?` on an Option in a function returning a Result needs the error\n");
    buf_bytes(out, "named: `x.ok_or(AppError::Missing)?`. std's `Option` has `ok_or`, `map`,\n");
    buf_bytes(out, "`and_then`, `unwrap_or_else`; `Result` has `map`, `map_err`, `err`,\n");
    buf_bytes(out, "`ok`, `unwrap_or_else`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## main returning a Result\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`fn main() -> Result<(), E>` with `E: Debug` (`#[derive(Debug)]`): on\n");
    buf_bytes(out, "`Err(e)` it prints `Error: ` and `e`'s Debug text on stderr and exits\n");
    buf_bytes(out, "with 1, as Rust does.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "#[derive(Debug)]\n");
    buf_bytes(out, "enum ConfigError { Missing, Bad(i64) }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn port(raw: i64) -> Result<i64, ConfigError> {\n");
    buf_bytes(out, "    if raw == 0 { return Err(ConfigError::Missing); }\n");
    buf_bytes(out, "    if raw < 0 { return Err(ConfigError::Bad(raw)); }\n");
    buf_bytes(out, "    Ok(raw)\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> Result<(), ConfigError> {\n");
    buf_bytes(out, "    let p = port(8080)?;\n");
    buf_bytes(out, "    println(f\"port {p}\");\n");
    buf_bytes(out, "    let q = port(-1)?;\n");
    buf_bytes(out, "    println(f\"port {q}\");\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out (exit 1)\n");
    buf_bytes(out, "port 8080\n");
    buf_bytes(out, "Error: Bad(-1)\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## std's errors and input\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Option means absence (the end of the input, a key not found); a Result\n");
    buf_bytes(out, "with an error enum means failure. std's input (0.15):\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| function | returns | at the end, on failure |\n");
    buf_bytes(out, "|---|---|---|\n");
    buf_bytes(out, "| `read_line(&mut buf)` | `Result<bool, IoError>` | `Ok(false)` at the end; `Err(IoError::Read)` |\n");
    buf_bytes(out, "| `read_stdin_in(gpa)` | `Result<Buf, IoError>` | `Err(IoError::Read)` |\n");
    buf_bytes(out, "| `parse_int(s)` | `Result<i64, ParseIntError>` | `Empty`, `InvalidDigit(at)` (the byte's index), `Overflow` |\n");
    buf_bytes(out, "| `sc.next_int()` | `Result<i64, ScanError>` | `ScanError::End`, `ScanError::Parse(e)` |\n");
    buf_bytes(out, "| `sc.next_token()`, `sc.next_line()` | `Option<[u8]>` | `None` at the end |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`pub enum IoError { Read, Write }`, `pub enum ParseIntError { Empty,\n");
    buf_bytes(out, "InvalidDigit(i64), Overflow }`, `pub enum ScanError { End,\n");
    buf_bytes(out, "Parse(ParseIntError) }`; each has Display and Debug.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::ScanError;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let input = read_stdin_in(gpa).unwrap();\n");
    buf_bytes(out, "    let mut sc = Scanner::new(input.as_slice());\n");
    buf_bytes(out, "    let mut sum = 0;\n");
    buf_bytes(out, "    loop {\n");
    buf_bytes(out, "        match sc.next_int() {\n");
    buf_bytes(out, "            Ok(n) => sum += n,\n");
    buf_bytes(out, "            Err(ScanError::End) => break,\n");
    buf_bytes(out, "            Err(ScanError::Parse(_)) => println(\"skipped a token\"),\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    std::print_int(sum);\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```in\n");
    buf_bytes(out, "1 2 x 3\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "skipped a token\n");
    buf_bytes(out, "6\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Code written for 0.14's API (Option and bool results) is moved by\n");
    buf_bytes(out, "`tachyonc fix --only std015`: `parse_int(s)` becomes\n");
    buf_bytes(out, "`parse_int(s).ok()`, `sc.next_int()` `sc.next_int().ok()`,\n");
    buf_bytes(out, "`read_line(b)` `read_line(b).unwrap_or(false)`, `read_stdin()`\n");
    buf_bytes(out, "`read_stdin().unwrap()`. All four mean what they meant, but a read\n");
    buf_bytes(out, "error, which `read_stdin().unwrap()` now reports (exit 101). (0.16:\n");
    buf_bytes(out, "then `fix --only alloc016` makes allocation explicit: `guide\n");
    buf_bytes(out, "allocators`.)\n");
}
