// Generated by compiler/guide/embed.sh from compiler/guide/core.md (do
// not edit): the guide's topic 'core'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# The tachyon guide (tachyon 0.13)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Tachyon is a compiled systems language. Its syntax is close to Rust's,\n");
    buf_bytes(out, "its model close to C's: structs, enums with exhaustive `match`, traits\n");
    buf_bytes(out, "and generics (monomorphized), modules, checked slices, raw pointers,\n");
    buf_bytes(out, "`unsafe`, exact C interop. There is no borrow checker, no lifetimes, no\n");
    buf_bytes(out, "destructors, no macros, and (in 0.13) no closures or iterators. Safe\n");
    buf_bytes(out, "code has no undefined behaviour. This text matches this compiler;\n");
    buf_bytes(out, "`tachyonc guide TOPIC` gives the detail (topics at the end).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Build and run\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```sh\n");
    buf_bytes(out, "tachyonc hello.tach -o hello && ./hello   # executable (cc links it)\n");
    buf_bytes(out, "tachyonc hello.tach -o hello.o            # object; `-o x.s`: assembly\n");
    buf_bytes(out, "tachyonc check hello.tach                 # errors only, one per line\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    println(\"hello\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "hello\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`main` returns the exit status (`fn main()` with no result is 0);\n");
    buf_bytes(out, "`fn main(argc: i32, argv: **u8) -> i32` takes the arguments. Several\n");
    buf_bytes(out, "files on the command line make one program; `mod name;` loads\n");
    buf_bytes(out, "`name.tach`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Rust habits and what tachyon has instead\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| Rust | tachyon |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `String`, `&str` | `[u8]`, a byte slice: `\"text\"` is a `[u8]`; build text with `std::Buf`; `c\"text\"` is a NUL-terminated `*u8` for C |\n");
    buf_bytes(out, "| `&T`, `&mut T`, `Box<T>` | `*T`, one raw pointer type; `&x` takes an address; no lifetimes, no borrow checker |\n");
    buf_bytes(out, "| `fn f(&self)`, `fn f(&mut self)` | `fn f(self: *T)` (may write through it); `fn f(self: T)` takes a copy |\n");
    buf_bytes(out, "| `use m::*;` | not allowed: `use m::{a, b};`, or the path `m::a` |\n");
    buf_bytes(out, "| `println!(\"{}\", x)`, `format!` | no macros: `print(\"x = \"); std::print_int(x); println(\"\");`; floats through C's `printf` |\n");
    buf_bytes(out, "| `v[i]` on a `Vec` | `v.get(i)`, `v.set(i, x)`, `v.as_slice()[i]` |\n");
    buf_bytes(out, "| closures, `.iter().map()` | none in 0.13 (coming in 0.14): `for i in 0..s.len { ... s[i] ... }`, `for x in slice` |\n");
    buf_bytes(out, "| `x?` | none yet (0.15): `match r { Ok(v) => v, Err(e) => return Err(e) }` |\n");
    buf_bytes(out, "| `impl Trait for T`, `T: Trait` | the same; `type Item;` associated types (0.14); no `dyn`, `where`, supertraits, `#[derive]` |\n");
    buf_bytes(out, "| `Drop`, RAII | none: call `free()`, usually `defer v.free();` |\n");
    buf_bytes(out, "| `'outer: loop`, `break 'outer` | `outer: loop`, `break :outer`, `continue :outer` |\n");
    buf_bytes(out, "| `!x` on integers | `~x`; `!` is for `bool` only |\n");
    buf_bytes(out, "| `i64::MAX`, `x.abs()`, `x.pow(2)` | none: write the literal, the expression, or call C |\n");
    buf_bytes(out, "| `x as usize` to index | lengths and indices are `i64` (`s.len`); any integer indexes |\n");
    buf_bytes(out, "| overflow panics, `/ 0` panics | integers wrap; `x / 0 == 0`, `x % 0 == x`; no panic |\n");
    buf_bytes(out, "| `match s { \"add\" => ... }` | strings are not patterns: `if s == \"add\" { ... }` |\n");
    buf_bytes(out, "| `char` | none: `'a'` is a `u8` (one ASCII byte) |\n");
    buf_bytes(out, "| `P { x, ..base }` | every field written: `P { x: x, y: base.y }` |\n");
    buf_bytes(out, "| `let x;` | every `let` has a value |\n");
    buf_bytes(out, "| implicit `i32` -> `i64` | no implicit conversion: `a as i64` |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The prelude, in every module without `use`: `Option`, `Some`, `None`,\n");
    buf_bytes(out, "`Result`, `Ok`, `Err`, `Vec`, `print`, `println`, and the traits `Add`,\n");
    buf_bytes(out, "`Sub`, `Mul`, `Div`, `Neg`, `Eq`, `Ord`, `Hash`. The rest of std is used\n");
    buf_bytes(out, "by path (`std::print_int(n)`) or imported (`use std::{Buf, HashMap};`).\n");
    buf_bytes(out, "Calling C or an `unsafe fn`, and dereferencing or indexing a raw\n");
    buf_bytes(out, "pointer, are allowed only in `unsafe { }` (`tachyonc guide rust`: the\n");
    buf_bytes(out, "full list).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Values and types\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let a = 42;               // i64: an integer literal is i64 unless the context says\n");
    buf_bytes(out, "let b: u8 = 255;          // i8 i16 i32 i64 u8 u16 u32 u64 isize usize\n");
    buf_bytes(out, "let c = 3u32;             // suffixes; 1_000, 0xff, 0b1010\n");
    buf_bytes(out, "let d = 2.5;              // f64; 2.5f32 is f32\n");
    buf_bytes(out, "let e = 'A';              // u8: a byte, ASCII only\n");
    buf_bytes(out, "let f = true;             // bool\n");
    buf_bytes(out, "let s = \"bytes\";          // [u8]: s.len (an i64 field, not a method), s[0], s[1..3]\n");
    buf_bytes(out, "let p = c\"for C\";         // *u8, NUL-terminated\n");
    buf_bytes(out, "let t = (1, \"two\");       // a tuple: t.0, t.1\n");
    buf_bytes(out, "let arr = [0; 8];         // [i64; 8]; also [1, 2, 3]; arr[i] is checked\n");
    buf_bytes(out, "let mut n = a as i32;     // `as` converts numbers; nothing converts implicitly\n");
    buf_bytes(out, "n += c as i32 + b as i32 + e as i32;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Bindings are immutable unless `mut`. Shadowing (`let x = x + 1;`) is\n");
    buf_bytes(out, "allowed. `const N: i64 = 10;` and `static mut COUNT: i64 = 0;` are items\n");
    buf_bytes(out, "(statics are safe to use: there are no threads).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Functions and control flow\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn classify(n: i64) -> [u8] {\n");
    buf_bytes(out, "    if n < 0 { \"negative\" } else if n == 0 { \"zero\" } else { \"positive\" }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut total = 0;\n");
    buf_bytes(out, "    for i in 0..10 {              // 0..10 and 0..=9: ranges exist only in `for`\n");
    buf_bytes(out, "        if i % 2 == 0 { continue; }\n");
    buf_bytes(out, "        total += i;\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    let mut k = 0;\n");
    buf_bytes(out, "    while k < 3 { k += 1; }\n");
    buf_bytes(out, "    let found = loop {            // loop's value comes from `break value`\n");
    buf_bytes(out, "        k += 1;\n");
    buf_bytes(out, "        if k * k > 50 { break k; }\n");
    buf_bytes(out, "    };\n");
    buf_bytes(out, "    outer: for i in 0..5 {        // a label: `name:`, then `break :name`\n");
    buf_bytes(out, "        for j in 0..5 {\n");
    buf_bytes(out, "            if i * j == 6 { break :outer; }\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    println(classify(total - found));\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "positive\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The last expression of a block, without `;`, is its value; `if`, `match`,\n");
    buf_bytes(out, "`loop` and blocks are expressions. There are no nested functions.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Structs, enums, match, methods\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct Point { x: i64, y: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "enum Shape { Circle(Point, i64), Rect(Point, Point), Empty }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Point {\n");
    buf_bytes(out, "    fn new(x: i64, y: i64) -> Point { Point { x: x, y: y } }   // Point::new(1, 2)\n");
    buf_bytes(out, "    fn shift(self: *Point, dx: i64) { self.x += dx; }           // writes through self\n");
    buf_bytes(out, "    fn sum(self: Point) -> i64 { self.x + self.y }              // a copy\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn area(s: Shape) -> i64 {\n");
    buf_bytes(out, "    match s {\n");
    buf_bytes(out, "        Shape::Circle(_, r) => 3 * r * r,\n");
    buf_bytes(out, "        Shape::Rect(a, b) => (b.x - a.x) * (b.y - a.y),\n");
    buf_bytes(out, "        Shape::Empty => 0,\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut p = Point::new(1, 2);\n");
    buf_bytes(out, "    p.shift(10);                          // passes &p\n");
    buf_bytes(out, "    let shapes = [Shape::Rect(Point::new(0, 0), p), Shape::Circle(p, 2), Shape::Empty];\n");
    buf_bytes(out, "    for s in shapes {\n");
    buf_bytes(out, "        std::print_int(area(s));\n");
    buf_bytes(out, "        print(\" \");\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    std::print_int(p.sum());\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    let o: Option<i64> = Some(7);\n");
    buf_bytes(out, "    if let Some(v) = o { std::print_int(v); }\n");
    buf_bytes(out, "    match 15 {\n");
    buf_bytes(out, "        0 => println(\" zero\"),\n");
    buf_bytes(out, "        1..=9 => println(\" digit\"),\n");
    buf_bytes(out, "        n if n % 5 == 0 => println(\" fives\"),\n");
    buf_bytes(out, "        _ => println(\" other\"),\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "22 12 0 13\n");
    buf_bytes(out, "7 fives\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A match must cover every value; arms can have `|`, ranges `a..=b` and\n");
    buf_bytes(out, "guards `if`. `use Shape::{Circle, Empty};` lets variants be written\n");
    buf_bytes(out, "without `Shape::`. `==` compares structs, enums, tuples and arrays field\n");
    buf_bytes(out, "by field; `[u8]` compares by bytes.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Generics and traits\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "trait Area {\n");
    buf_bytes(out, "    fn area(self: *Self) -> i64;\n");
    buf_bytes(out, "    fn describe(self: *Self) {            // a default method\n");
    buf_bytes(out, "        print(\"area \");\n");
    buf_bytes(out, "        std::print_int(self.area());\n");
    buf_bytes(out, "        println(\"\");\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "struct Square { side: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Area for Square {\n");
    buf_bytes(out, "    fn area(self: *Square) -> i64 { self.side * self.side }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn total<T: Area>(items: [T]) -> i64 {    // bounds: T: A + B\n");
    buf_bytes(out, "    let mut sum = 0;\n");
    buf_bytes(out, "    for it in items { sum += it.area(); }\n");
    buf_bytes(out, "    sum\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "struct Pair<T> { a: T, b: T }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl<T: Ord> Pair<T> {\n");
    buf_bytes(out, "    fn max(self: *Pair<T>) -> T { if self.a > self.b { self.a } else { self.b } }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let squares = [Square { side: 2 }, Square { side: 3 }];\n");
    buf_bytes(out, "    std::print_int(total(squares[..]));   // an array to a slice: a[..]\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    squares[0].describe();\n");
    buf_bytes(out, "    let p = Pair { a: 3, b: 9 };\n");
    buf_bytes(out, "    std::print_int(p.max() + Pair::<i64> { a: 1, b: 0 }.max());\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "13\n");
    buf_bytes(out, "area 4\n");
    buf_bytes(out, "10\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Generics are templates, checked per instantiation (`max::<i64>(a, b)`\n");
    buf_bytes(out, "is the turbofish). Operators go through the prelude's traits: `impl Add\n");
    buf_bytes(out, "for V` makes `a + b` work; `Ord`'s `cmp` gives `<`. There are no trait\n");
    buf_bytes(out, "objects: dispatch is static.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Modules and imports\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "mod geometry {                            // or `mod geometry;` for geometry.tach\n");
    buf_bytes(out, "    pub struct Rect { pub w: i64, pub h: i64 }\n");
    buf_bytes(out, "    pub fn area(r: Rect) -> i64 { r.w * r.h }\n");
    buf_bytes(out, "    fn helper() {}                        // private: only this module and its children\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "use geometry::{Rect, area};               // by name; never `*`\n");
    buf_bytes(out, "use std::Buf;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut b = Buf::new();\n");
    buf_bytes(out, "    defer b.free();\n");
    buf_bytes(out, "    b.push_int(area(Rect { w: 2, h: 3 }));\n");
    buf_bytes(out, "    println(b.as_slice());\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "6\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Paths start with a name in scope, `crate`, `self`, `super` or `std`.\n");
    buf_bytes(out, "Items are private unless `pub`; `pub use` re-exports. A missing import's\n");
    buf_bytes(out, "error says which `use` line to add, and `tachyonc fix` adds it.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Slices, arrays, text\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn sum(xs: [i64]) -> i64 {\n");
    buf_bytes(out, "    let mut t = 0;\n");
    buf_bytes(out, "    for i in 0..xs.len { t += xs[i]; }    // indices are i64; checked\n");
    buf_bytes(out, "    t\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut a = [5, 1, 4];\n");
    buf_bytes(out, "    a[1] = 2;\n");
    buf_bytes(out, "    std::print_int(sum(a[..]) + sum(a[1..]));   // a[lo..hi], a[..hi], a[lo..]\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    let s = \"hello world\";\n");
    buf_bytes(out, "    println(s[6..]);\n");
    buf_bytes(out, "    if s[0..5] == \"hello\" { println(\"starts with hello\"); }\n");
    buf_bytes(out, "    let words = [0; 4];\n");
    buf_bytes(out, "    std::print_int(words[4]);             // out of bounds: a message, exit 101\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out (exit 101)\n");
    buf_bytes(out, "17\n");
    buf_bytes(out, "world\n");
    buf_bytes(out, "starts with hello\n");
    buf_bytes(out, "index out of bounds: index 4, length 4\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "An array `[T; N]` is a value (copied by `=`, no `.len`); a slice `[T]`\n");
    buf_bytes(out, "is a pointer and a length (`.ptr`, `.len`) viewing an array, a `Vec` or\n");
    buf_bytes(out, "memory. Writing through a slice needs no `mut`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## std: Vec, HashMap, Buf\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::{Buf, HashMap, sort};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut v: Vec<i64> = Vec::new();\n");
    buf_bytes(out, "    defer v.free();                        // no destructors: free explicitly\n");
    buf_bytes(out, "    v.push(30);\n");
    buf_bytes(out, "    v.push(10);\n");
    buf_bytes(out, "    v.push(20);\n");
    buf_bytes(out, "    sort(v.as_slice());                    // in place\n");
    buf_bytes(out, "    v.set(0, v.get(0) + 1);                // get/set are checked\n");
    buf_bytes(out, "    for x in v.as_slice() { std::print_int(x); print(\" \"); }\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    let last = v.pop();                    // Option<i64>\n");
    buf_bytes(out, "    std::print_int(last.unwrap_or(-1));\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "    let mut m: HashMap<[u8], i64> = HashMap::new();\n");
    buf_bytes(out, "    defer m.free();\n");
    buf_bytes(out, "    m.insert(\"a\", 1);\n");
    buf_bytes(out, "    m.insert(\"b\", 2);\n");
    buf_bytes(out, "    match m.get(\"a\") { Some(x) => std::print_int(x), None => print(\"none\") }\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    for i in 0..m.slots() {                // iterate by slot\n");
    buf_bytes(out, "        if let Some(k) = m.key_at(i) { print(k); }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "    let mut b = Buf::new();                // text builder\n");
    buf_bytes(out, "    defer b.free();\n");
    buf_bytes(out, "    b.push_str(\"n=\");\n");
    buf_bytes(out, "    b.push_int(m.len());\n");
    buf_bytes(out, "    b.push('!');\n");
    buf_bytes(out, "    println(b.as_slice());\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "11 20 30\n");
    buf_bytes(out, "30\n");
    buf_bytes(out, "1\n");
    buf_bytes(out, "ab\n");
    buf_bytes(out, "n=2!\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`Vec`, `Buf` and `HashMap` are handles: copying one (`let w = v;`,\n");
    buf_bytes(out, "passing it by value) copies the pointer, not the contents. Pass `&v` to\n");
    buf_bytes(out, "a `*Vec<T>` parameter to let a function push. A slice from `as_slice`\n");
    buf_bytes(out, "is valid until the vector grows or is freed. The whole of std, made\n");
    buf_bytes(out, "from its source in this compiler (every item is `pub`):\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "@STD-API@\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Input, output, arguments\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "std prints; reading goes through C (`getchar`, `read`, `fopen`):\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "import \"stdio.h\" as c;\n");
    buf_bytes(out, "import \"string.h\" as c;\n");
    buf_bytes(out, "use std::Buf;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn read_all() -> Buf {                    // all of stdin\n");
    buf_bytes(out, "    let mut b = Buf::new();\n");
    buf_bytes(out, "    loop {\n");
    buf_bytes(out, "        let ch = unsafe { c::getchar() };\n");
    buf_bytes(out, "        if ch < 0 { break; }              // EOF\n");
    buf_bytes(out, "        b.push(ch as u8);\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    b                                     // the caller frees it\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(argc: i32, argv: **u8) -> i32 {\n");
    buf_bytes(out, "    let mut input = read_all();\n");
    buf_bytes(out, "    defer input.free();\n");
    buf_bytes(out, "    let text = input.as_slice();\n");
    buf_bytes(out, "    let mut total = 0;\n");
    buf_bytes(out, "    let mut start = 0;\n");
    buf_bytes(out, "    for i in 0..text.len + 1 {            // each line, the last one too\n");
    buf_bytes(out, "        if i == text.len || text[i] == '\\n' {\n");
    buf_bytes(out, "            let line = text[start..i];\n");
    buf_bytes(out, "            let mut n = 0;\n");
    buf_bytes(out, "            for ch in line { if ch >= '0' && ch <= '9' { n = n * 10 + (ch - '0') as i64; } }\n");
    buf_bytes(out, "            total += n;\n");
    buf_bytes(out, "            start = i + 1;\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    std::print_int(total);\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    for k in 1..argc as i64 {             // argv[0] is the program\n");
    buf_bytes(out, "        let arg = unsafe { argv[k] };     // a C string\n");
    buf_bytes(out, "        let len = unsafe { c::strlen(arg) } as i64;\n");
    buf_bytes(out, "        println(unsafe { arg[0..len] });  // as a [u8]\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```in\n");
    buf_bytes(out, "12\n");
    buf_bytes(out, "30\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "42\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## unsafe and C\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "import \"stdio.h\" as c;                   // a C header, its names under c::\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "extern \"C\" {                              // or declare C functions yourself\n");
    buf_bytes(out, "    fn abs(x: i32) -> i32;\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[repr(C)]                                // C's layout, for passing to C\n");
    buf_bytes(out, "struct Pair { a: i32, b: i32 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "extern \"C\" fn add(p: Pair) -> i32 { p.a + p.b }   // callable from C\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let x = 2.5;\n");
    buf_bytes(out, "    unsafe {\n");
    buf_bytes(out, "        c::printf(c\"%.1f %d\\n\", x * 2.0, abs(-3) + add(Pair { a: 1, b: 2 }));\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "5.0 6\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Unsafe operations: calling C or an `unsafe fn`, dereferencing (`*p`,\n");
    buf_bytes(out, "`p.f`) or indexing (`p[i]`) a raw pointer, reading a union field. A\n");
    buf_bytes(out, "*borrow* is safe to dereference: `&place` passed directly, or a pointer\n");
    buf_bytes(out, "parameter (`self: *T` included). A local holding a pointer is raw.\n");
    buf_bytes(out, "`tachyonc fix --only unsafe` wraps what needs it.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Behaviour that is defined\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let big: i32 = 2147483647;\n");
    buf_bytes(out, "let zero = 0;\n");
    buf_bytes(out, "std::print_int((big + 1) as i64);         // wraps: -2147483648\n");
    buf_bytes(out, "print(\" \");\n");
    buf_bytes(out, "std::print_int(7 / zero + 7 % zero);      // x / 0 == 0, x % 0 == x\n");
    buf_bytes(out, "print(\" \");\n");
    buf_bytes(out, "std::print_int(-7 / 2);                   // truncates toward zero; -7 % 2 == -1\n");
    buf_bytes(out, "print(\" \");\n");
    buf_bytes(out, "std::print_int(300.7 as u8 as i64);       // float to int: truncates, then wraps\n");
    buf_bytes(out, "println(\"\");\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "-2147483648 7 -3 44\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Indexing and slicing are checked (exit 101 with a message), as are\n");
    buf_bytes(out, "`unwrap` and casts to enums. A slice used after its memory is freed is\n");
    buf_bytes(out, "the one hole in safe code (no lifetimes).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Errors you will meet first\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| error (short form) | fix |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `unknown type 'String'` (or `char`, `Box`) | `[u8]`, `u8`, `*T` or `Vec<T>` |\n");
    buf_bytes(out, "| `expected type, got '&'` | `*T` for `&T` and `&mut T` |\n");
    buf_bytes(out, "| `expected identifier, got '&'` in `fn f(&self)` | `self: *T` |\n");
    buf_bytes(out, "| `closures are not implemented yet` | (0.14 in progress) a named `fn`, or a loop |\n");
    buf_bytes(out, "| `'?' is reserved for future use` | `match` on the `Result` |\n");
    buf_bytes(out, "| `expected ';', got '!'` | no macros: `println(...)`, `std::print_int(...)` |\n");
    buf_bytes(out, "| `cannot assign to immutable variable 'x'` | `let mut x` |\n");
    buf_bytes(out, "| `cannot index type 'Vec<i64>'` | `v.get(i)`, `v.as_slice()[i]` |\n");
    buf_bytes(out, "| `'for' loops iterate over ... got 'Vec<i64>'` | `for x in v.as_slice()` |\n");
    buf_bytes(out, "| `no method 'len' on type '[u8]'` | `s.len`, a field |\n");
    buf_bytes(out, "| `expected '[i64]', got '[i64; 3]'` | pass `a[..]` |\n");
    buf_bytes(out, "| `expected 'i64', got 'i32'` | `x as i64` |\n");
    buf_bytes(out, "| `cannot take address of non-lvalue expression` | `&` needs a place: `let p = P { x: 1 }; f(&p)` |\n");
    buf_bytes(out, "| `non-exhaustive match: 'E::C' is not covered` | an arm, or `_ =>` |\n");
    buf_bytes(out, "| `error[unsafe] calling a C function is unsafe` | `unsafe { ... }` |\n");
    buf_bytes(out, "| `undefined variable 'helper' \\| help: add 'use ...'` | add the `use` line the help names |\n");
    buf_bytes(out, "| `wildcard imports are not allowed` | `use m::{a, b};` |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc guide errors` has more, each with its fix.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Tools: read and change code through the compiler\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```sh\n");
    buf_bytes(out, "tachyonc check [ROOT]                   # all errors, one line each: FILE:L:C: error[KIND] MSG | help: ...\n");
    buf_bytes(out, "tachyonc --diagnostics=short f.tach -o f # the same form when compiling\n");
    buf_bytes(out, "tachyonc query show NAME                # an item's source: fn, Type::method, Enum::Variant, FILE:LINE\n");
    buf_bytes(out, "tachyonc query def NAME                 # where it is defined, its signature\n");
    buf_bytes(out, "tachyonc query refs NAME                # every resolved use (--count, --in FILE)\n");
    buf_bytes(out, "tachyonc query items [MODULE]           # a module's items with signatures, like a header\n");
    buf_bytes(out, "tachyonc edit patch NAME --old 'a < b' --new 'a <= b'   # change text inside one item\n");
    buf_bytes(out, "tachyonc edit replace NAME < new.tach   # replace an item; edit insert --after NAME; edit delete NAME\n");
    buf_bytes(out, "tachyonc fix                            # missing imports, unused, pub, unsafe blocks\n");
    buf_bytes(out, "tachyonc undo                           # take the last edit back (in a git checkout)\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "ROOT is `--root FILE`, a last argument ending in `.tach`, or\n");
    buf_bytes(out, "`./main.tach`. Every edit is checked first: one that adds an error\n");
    buf_bytes(out, "writes nothing. A problem is one line, `error CODE: message`, then\n");
    buf_bytes(out, "`try:` lines: commands to run as they are. `tachyonc guide tools` has\n");
    buf_bytes(out, "the rest.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Topics\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc guide TOPIC` prints one; `tachyonc guide --list` gives their\n");
    buf_bytes(out, "sizes; `tachyonc guide --all` prints everything.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "@TOPICS@\n");
}
