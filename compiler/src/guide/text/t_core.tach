// Generated by compiler/guide/embed.sh from compiler/guide/core.md (do
// not edit): the guide's topic 'core'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# tachyon, the core (tachyon 0.20)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Tachyon is a compiled systems language of values: a value has one\n");
    buf_bytes(out, "owner, is copied or moved, and is dropped at the end of its scope. A\n");
    buf_bytes(out, "function says what it does with each argument: reads it (`let`, the\n");
    buf_bytes(out, "default), changes it (`inout`, marked `&x` at the call) or takes it\n");
    buf_bytes(out, "(`sink`). There are no references to store or lifetimes to write; views\n");
    buf_bytes(out, "(slices, structs holding one) are checked to stay inside what they view.\n");
    buf_bytes(out, "Nothing allocates without an allocator, indexing is checked, and safe\n");
    buf_bytes(out, "code has no undefined behaviour. This page is the core; the rest is on\n");
    buf_bytes(out, "demand (the end). From Rust: `tachyonc guide rust` has the mapping.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Build and run\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```sh\n");
    buf_bytes(out, "tachyonc main.tach -o prog && ./prog < in.txt   # `mod x;` loads x.tach\n");
    buf_bytes(out, "tachyonc check main.tach                        # every error, one line each\n");
    buf_bytes(out, "tachyonc try 'parse_int(\"42\")'                  # a snippet: its TYPE = VALUE\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## The language in one program\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "import \"stdio.h\" as c;                 // a C header; its names under c::\n");
    buf_bytes(out, "use std::is_digit;                     // std items by name (never *)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "struct P { x: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl P {\n");
    buf_bytes(out, "    fn bump(inout self) { self.x += 1; }   // inout self: changes the caller's P\n");
    buf_bytes(out, "    fn get(self) -> i64 { self.x }         // self (let): reads it\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn total(v: Vec<i64>) -> i64 {         // let (the default): read-only, no copy\n");
    buf_bytes(out, "    v.iter().sum()\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn grow(v: inout Vec<i64>, x: i64) {   // inout: the caller writes grow(&v, x)\n");
    buf_bytes(out, "    v.push(x);\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn keep(all: inout Vec<Vec<i64>>, v: sink Vec<i64>) {   // sink: keep takes v\n");
    buf_bytes(out, "    all.push(v);\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn first(s: [u8]) -> u8 { s[0] }       // text is [u8]; 'a' is a u8; no char\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn odds(n: i64, gpa: Gpa) -> Vec<i64> {     // allocating takes an allocator\n");
    buf_bytes(out, "    (0..n).filter(|i| i % 2 == 1).collect_in(gpa)\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {             // gpa: the program's allocator; 0 = exit status\n");
    buf_bytes(out, "    var v: Vec<i64> = Vec::new_in(gpa);    // var: mutable; let: not\n");
    buf_bytes(out, "    v.push(5);\n");
    buf_bytes(out, "    grow(&v, 2);                       // & marks the argument grow may change\n");
    buf_bytes(out, "    v[0] += 10;                        // checked (v[1..2] a slice)\n");
    buf_bytes(out, "    v.sort();                          // or sort(v.as_mut_slice())\n");
    buf_bytes(out, "    var p = P { x: 1 };\n");
    buf_bytes(out, "    p.bump();                          // a receiver needs no &; p must be var\n");
    buf_bytes(out, "    println(f\"{p.get()} {v:?} {total(v)}\");   // f-strings; total(v) only reads\n");
    buf_bytes(out, "    var all: Vec<Vec<i64>> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    keep(&all, v);                     // v moved into keep: dead from here\n");
    buf_bytes(out, "    let s = \"hi\";\n");
    buf_bytes(out, "    println(s.len());                  // an i64 (slices, Vec, Buf, HashMap)\n");
    buf_bytes(out, "    var b = Buf::new_in(gpa);          // a text builder\n");
    buf_bytes(out, "    let o = odds(7, gpa);\n");
    buf_bytes(out, "    b.push_str(\"n=\");\n");
    buf_bytes(out, "    b.push_int(o.len());\n");
    buf_bytes(out, "    println(b.as_slice());\n");
    buf_bytes(out, "    if s == \"hi\" && !is_digit(first(s)) { println(first(s)); }   // compared, not matched\n");
    buf_bytes(out, "    var m: HashMap<[u8], i64> = HashMap::new_in(gpa);\n");
    buf_bytes(out, "    m.get_or_insert(\"k\", 0)[0] += 1;   // a one-element view: [0] is the value\n");
    buf_bytes(out, "    let z = 0;\n");
    buf_bytes(out, "    println(f\"{~0u8} {7 / z} {m.get(\"k\").unwrap()}\");   // ~x; no methods on numbers; x / 0 == 0\n");
    buf_bytes(out, "    unsafe { c::puts(c\"from C\"); }     // C calls need unsafe; c\"..\": a NUL-terminated *u8\n");
    buf_bytes(out, "    if z != 0 { panic(\"z\"); }          // exit 101; unreachable()\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}                                      // all, o, b, m: dropped (freed) here\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "2 [2, 15] 17\n");
    buf_bytes(out, "2\n");
    buf_bytes(out, "n=3\n");
    buf_bytes(out, "104\n");
    buf_bytes(out, "255 0 1\n");
    buf_bytes(out, "from C\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Also: `usize` is `i64` (lengths, indices); integers wrap; `a as i32`\n");
    buf_bytes(out, "narrows, widening is implicit; `x?`, closures (`|x| x + k`, `sink ||`\n");
    buf_bytes(out, "to take what it captures), `impl Trait for T`, `T: Trait`,\n");
    buf_bytes(out, "`#[derive(Eq, Debug)]`; no `dyn`, `where`, `Box`. A let or inout\n");
    buf_bytes(out, "parameter is used as the value itself: `n + 1`, `out = acc`, `p.x`\n");
    buf_bytes(out, "(`*` is only for raw `*T` pointers, which need `unsafe`). `inout r =\n");
    buf_bytes(out, "&st;` names an access to pass on: `f(&r)`, `g(&r)`. `match e` on a let\n");
    buf_bytes(out, "`e: E` binds into it (`E::A(n) => n + 1`). Arguments may have defaults\n");
    buf_bytes(out, "and names: `fn f(a: i64, b: i64 = 2)`, `f(1, b: 3)`. The prelude (no\n");
    buf_bytes(out, "`use`) has `Option`, `Result`, `Vec`, `Buf`, `HashMap`, `BinaryHeap` and\n");
    buf_bytes(out, "`MinHeap` (priority queues: `pop` the largest, the smallest), `print`,\n");
    buf_bytes(out, "`println`, `format_in`, `Gpa`, `read_line`, `read_stdin_in`, `Scanner`,\n");
    buf_bytes(out, "`parse_int`, `trim`, `split_in`, `split_whitespace_in`, `sort`,\n");
    buf_bytes(out, "`sort_by`, `sort_stable_by`, `cmp_of`, `Fmt`, `panic`, `unreachable`;\n");
    buf_bytes(out, "the rest of std is `use std::{...}`; `use lexer::Tok;` in a module\n");
    buf_bytes(out, "reaches its sibling `lexer`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## std: what programs use most\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct Item { name: [u8], qty: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn add(v: inout Vec<Item>, it: Item) { v.push(it); }   // called as add(&items, ..)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let input = read_stdin_in(gpa).unwrap();   // all of stdin: Result<Buf, IoError>\n");
    buf_bytes(out, "    var sc = Scanner::new(input.as_slice());\n");
    buf_bytes(out, "    let n = sc.next_int().unwrap();            // Result<i64, ScanError>\n");
    buf_bytes(out, "    var items: Vec<Item> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    var seen: HashMap<[u8], i64> = HashMap::new_in(gpa);\n");
    buf_bytes(out, "    for _ in 0..n {\n");
    buf_bytes(out, "        let name = sc.next_token().unwrap();   // Option<[u8]>: a slice of input\n");
    buf_bytes(out, "        let qty = sc.next_int().unwrap_or(0);\n");
    buf_bytes(out, "        add(&items, Item { name: name, qty: qty });\n");
    buf_bytes(out, "        seen.insert(name, qty);                // also contains(k), remove(k)\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    items.sort_by(|a, b| b.qty - a.qty);       // a, b: Item (let); < 0: a first\n");
    buf_bytes(out, "    for (i, it) in items.iter().enumerate() { print(f\"{i}:{it.name} \"); }\n");
    buf_bytes(out, "    let line = trim(sc.next_line().unwrap());  // the rest of the line\n");
    buf_bytes(out, "    let total = split_in(line, ',', gpa).iter()\n");
    buf_bytes(out, "        .map(|w| parse_int(trim(w)).unwrap_or(0)).sum();\n");
    buf_bytes(out, "    match seen.get(\"pen\") {                    // Option<i64>\n");
    buf_bytes(out, "        Some(q) => println(f\"pen={q} total={total}\"),\n");
    buf_bytes(out, "        None => println(\"no pen\"),\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    let text = format_in(f\"{items.len()} {seen.len()}\", gpa);   // a Buf\n");
    buf_bytes(out, "    println(text.as_slice());                  // text, seen, items, input: dropped at the end\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```in\n");
    buf_bytes(out, "3 pen 2 ink 5 cap 1 1,2, 3\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "0:ink 1:pen 2:cap pen=2 total=6\n");
    buf_bytes(out, "3 3\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Lines one at a time: `var b = Buf::new_in(gpa); while\n");
    buf_bytes(out, "read_line(&b).unwrap() { ... }` (without the `'\\n'`). An owned value\n");
    buf_bytes(out, "(`Vec`, `Buf`, `HashMap`, a struct holding one) moves into a `sink`\n");
    buf_bytes(out, "parameter, a `let w = v;`, a struct field or a `return`: `v` is dead\n");
    buf_bytes(out, "after it (`own.moved`); pass it to a let parameter to lend it, or pass\n");
    buf_bytes(out, "`v.clone()`. A plain value (numbers, structs of them) is copied. `&f(x)`\n");
    buf_bytes(out, "makes a temporary that lives to the end of the block (0.18.1); any other\n");
    buf_bytes(out, "owned temporary used without being moved (`f()?.read()`,\n");
    buf_bytes(out, "`make().len()`) is dropped at the end of its statement (0.20). A slice\n");
    buf_bytes(out, "of `v` is a view: take it again after `v` grows. std's most used items:\n");
    buf_bytes(out, "`tachyonc guide std`; all, a line each: `tachyonc guide std#the-api`;\n");
    buf_bytes(out, "one name with its comment: `tachyonc guide --find split_in`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## The first errors and their fixes\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| error (short form) | fix |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `conv.marker: 'v' is lent inout here` | `f(&v)`: the callee may change `v` |\n");
    buf_bytes(out, "| `conv.marker_extra: '&' marks an argument the callee may change` | `f(v)`: a let or sink argument has no `&` |\n");
    buf_bytes(out, "| `conv.rust: 'let mut' is Rust's spelling` | the `try:` line's form (`var`, `x: inout T`, `self`, `&x`) |\n");
    buf_bytes(out, "| `cannot assign to immutable variable 'a'` | `var a`; a parameter you change: `a: inout T` |\n");
    buf_bytes(out, "| `own.moved: 'v' is used here after it moved into 'keep(sink v)'` | lend it (a let parameter), or `keep(v.clone())` |\n");
    buf_bytes(out, "| `own.conflict: ... while 'first' views them` | use the view before the change, or take it again after (`guide views`) |\n");
    buf_bytes(out, "| `non-exhaustive match: 'E::B' is not covered` | an arm for it, or `_ =>` |\n");
    buf_bytes(out, "| `calling a C function is unsafe` | `unsafe { ... }`; `tachyonc fix --only unsafe` adds them |\n");
    buf_bytes(out, "| `no 'cmp' in module 'std'` | every std item is `std::name` (its most used names need no `use`) |\n");
    buf_bytes(out, "| `expected 'String', got '[u8]'` | `String::from_in(\"..\", gpa)`: a String owns its text; a parameter `s: str` takes literals and a String's `&s` |\n");
    buf_bytes(out, "| `allocation is explicit: pass an allocator` | `Vec::new_in(gpa)`, `gpa` from `fn main(gpa: Gpa)` passed down |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Every error has a `help:`; `tachyonc guide errors` has more.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Tests and checks (0.18): `#[test] fn` and `#[property] fn p(v: Vec<i64>)`\n");
    buf_bytes(out, "(inputs generated, shrunk) sit next to the code and `tachyonc test` runs\n");
    buf_bytes(out, "them at -O0 and -O2; `requires`/`ensures` clauses and `assert_eq(a, b)`\n");
    buf_bytes(out, "are checked at run time, a failure one line `FILE:L:C: message` (`guide\n");
    buf_bytes(out, "testing`, `guide contracts`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "SIMD and CPU intrinsics (0.19): `std::arch`, the vendors' names (`vaddq_u8`,\n");
    buf_bytes(out, "`__crc32cd`) checked against the CPU: `tachyonc guide arch`; `query arch WORDS`.\n");
    buf_bytes(out, "GPU compute and rendering (0.22): `std::gpu`, wgpu's objects on Metal, `-l objc`: `tachyonc guide gpu`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## The loop\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Write the program, then `tachyonc check` (a check hook, where there is\n");
    buf_bytes(out, "one, runs it after each edit); fix the first error first. A clean check\n");
    buf_bytes(out, "ends with `ok: 0 errors in main.tach`, a build with `ok: built prog`. Before writing a construct\n");
    buf_bytes(out, "you are unsure of, `tachyonc guide --find WORDS` (`--find read a line`)\n");
    buf_bytes(out, "or `tachyonc guide TOPIC#SECTION` prints the lines on it; `tachyonc\n");
    buf_bytes(out, "try 'CODE'` runs a snippet. For an unfamiliar item, ask\n");
    buf_bytes(out, "`tachyonc query context NAME` first: its source, what it calls and its\n");
    buf_bytes(out, "callers in one call (`query context parse_args`). Edits, refactorings\n");
    buf_bytes(out, "and the other queries: `tachyonc guide tools`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Topics (`tachyonc guide TOPIC`, `TOPIC#` lists its sections):\n");
    buf_bytes(out, "@TOPIC-NAMES@\n");
}
