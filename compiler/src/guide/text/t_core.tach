use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# tachyon, the core (tachyon 0.17)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Tachyon is a compiled systems language with Rust's syntax and value\n");
    buf_bytes(out, "semantics (0.17: moves, drops, `&T`/`&mut T`, checked views) but no\n");
    buf_bytes(out, "lifetimes to write, no macros; nothing allocates without an allocator;\n");
    buf_bytes(out, "indexing is checked; safe code has no undefined behaviour. This page is the core; the rest is on demand (the end).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Build and run\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```sh\n");
    buf_bytes(out, "tachyonc main.tach -o prog && ./prog < in.txt   # `mod x;` loads x.tach\n");
    buf_bytes(out, "tachyonc check main.tach                        # every error, one line each\n");
    buf_bytes(out, "tachyonc try 'parse_int(\"42\")'                  # a snippet: its TYPE = VALUE\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Looks like Rust, means something else\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Each `// Rust:` line is followed by the tachyon for it.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "import \"stdio.h\" as c;                 // a C header; its names under c::\n");
    buf_bytes(out, "use std::is_digit;                     // Rust: use std::collections::*;  (never *)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "struct P { x: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl P {\n");
    buf_bytes(out, "    // Rust: fn bump(&mut self)\n");
    buf_bytes(out, "    fn bump(self: &mut P) { self.x += 1; } // self written out\n");
    buf_bytes(out, "    // Rust: fn get(&self) -> i64\n");
    buf_bytes(out, "    fn get(self: &P) -> i64 { self.x }     // (self: P: a copy, a move if owned)\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// Rust: fn first(s: &str) -> char\n");
    buf_bytes(out, "fn first(s: [u8]) -> u8 { s[0] }       // text is [u8]; 'a' is a u8; no char\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// Rust: fn odds(n: i64) -> Vec<i64>\n");
    buf_bytes(out, "fn odds(n: i64, gpa: Gpa) -> Vec<i64> {     // allocating takes an allocator\n");
    buf_bytes(out, "    (0..n).filter(|i| i % 2 == 1).collect_in(gpa)\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// Rust: fn main()\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {             // gpa: the program's allocator; 0 = exit status\n");
    buf_bytes(out, "    // Rust: let mut v = Vec::new();\n");
    buf_bytes(out, "    let mut v: Vec<i64> = Vec::new_in(gpa);  // dropped at scope end, as in Rust\n");
    buf_bytes(out, "    v.push(5);\n");
    buf_bytes(out, "    v.push(2);\n");
    buf_bytes(out, "    v[0] += 10;                        // as Rust: checked (v[1..2] a slice)\n");
    buf_bytes(out, "    // Rust: v.sort();\n");
    buf_bytes(out, "    sort(v.as_slice());\n");
    buf_bytes(out, "    // Rust: let mut p = P { x: 1 }; p.bump();\n");
    buf_bytes(out, "    let mut p = P { x: 1 };\n");
    buf_bytes(out, "    p.bump();                          // passes &mut p\n");
    buf_bytes(out, "    // Rust: println!(\"{} {:?}\", p.get(), v);\n");
    buf_bytes(out, "    println(f\"{p.get()} {v:?}\");       // no macros: f-strings\n");
    buf_bytes(out, "    let s = \"hi\";\n");
    buf_bytes(out, "    println(s.len());                  // an i64; or the field, s.len\n");
    buf_bytes(out, "    // Rust: let mut b = String::new(); b.push_str(\"n=\"); ...\n");
    buf_bytes(out, "    let mut b = Buf::new_in(gpa);\n");
    buf_bytes(out, "    let o = odds(7, gpa);\n");
    buf_bytes(out, "    b.push_str(\"n=\");\n");
    buf_bytes(out, "    b.push_int(o.len());\n");
    buf_bytes(out, "    println(b.as_slice());\n");
    buf_bytes(out, "    // Rust: match s { \"hi\" => ..., _ => ... }\n");
    buf_bytes(out, "    if s == \"hi\" && !is_digit(first(s)) { println(first(s)); }   // compared, not matched\n");
    buf_bytes(out, "    // Rust: *m.entry(k).or_insert(0) += 1;\n");
    buf_bytes(out, "    let mut m: HashMap<[u8], i64> = HashMap::new_in(gpa);\n");
    buf_bytes(out, "    m.get_or_insert(\"k\", 0)[0] += 1;\n");
    buf_bytes(out, "    // Rust: !x on an integer; x.abs(); 7 / 0 panics\n");
    buf_bytes(out, "    let z = 0;\n");
    buf_bytes(out, "    println(f\"{~0u8} {7 / z} {m.get(\"k\").unwrap()}\");   // ~x; no methods on numbers; x / 0 == 0\n");
    buf_bytes(out, "    // Rust: libc::puts(...) in unsafe -- the same: C calls need unsafe\n");
    buf_bytes(out, "    unsafe { c::puts(c\"from C\"); }     // c\"..\": a NUL-terminated *u8\n");
    buf_bytes(out, "    if z != 0 { panic(\"z\"); }          // Rust: panic!(\"z\"): exit 101; unreachable()\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "2 [2, 15]\n");
    buf_bytes(out, "2\n");
    buf_bytes(out, "n=3\n");
    buf_bytes(out, "104\n");
    buf_bytes(out, "255 0 1\n");
    buf_bytes(out, "from C\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Also: `usize` is `i64` (lengths, indices); integers wrap; `a as i32`\n");
    buf_bytes(out, "narrows, widening is implicit; `x?`, closures, `impl Trait for T`, `T:\n");
    buf_bytes(out, "Trait`, `#[derive(Eq, Debug)]` are Rust's; no `dyn`, `where`, `Box` (a\n");
    buf_bytes(out, "`Vec` or `*T`); `&x` and `&mut x` are references (`&T`, `&mut T`,\n");
    buf_bytes(out, "0.17), and `p.0`, `p.x` reach through a reference or a pointer. Arguments may have defaults and names: `fn f(a: i64, b: i64 =\n");
    buf_bytes(out, "2)`, `f(1, b: 3)`. The prelude (no `use`) has `Option`, `Result`, `Vec`,\n");
    buf_bytes(out, "`Buf`, `HashMap`, `print`, `println`, `format_in`, `Gpa`, `read_line`,\n");
    buf_bytes(out, "`read_stdin_in`, `Scanner`, `parse_int`, `trim`, `split_in`,\n");
    buf_bytes(out, "`split_whitespace_in`, `sort`, `sort_by`, `sort_stable_by`, `cmp_of`, `Fmt`, `panic`,\n");
    buf_bytes(out, "`unreachable`; the rest of std is `use std::{...}`; `use lexer::Tok;`\n");
    buf_bytes(out, "in a module reaches its sibling `lexer`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## std: what programs use most\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct Item { name: [u8], qty: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn add(v: &mut Vec<Item>, it: Item) { v.push(it); }   // called as add(&mut items, ..)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let input = read_stdin_in(gpa).unwrap();   // all of stdin: Result<Buf, IoError>\n");
    buf_bytes(out, "    let mut sc = Scanner::new(input.as_slice());\n");
    buf_bytes(out, "    let n = sc.next_int().unwrap();            // Result<i64, ScanError>\n");
    buf_bytes(out, "    let mut items: Vec<Item> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    let mut seen: HashMap<[u8], i64> = HashMap::new_in(gpa);\n");
    buf_bytes(out, "    for _ in 0..n {\n");
    buf_bytes(out, "        let name = sc.next_token().unwrap();   // Option<[u8]>: a slice of input\n");
    buf_bytes(out, "        let qty = sc.next_int().unwrap_or(0);\n");
    buf_bytes(out, "        add(&mut items, Item { name: name, qty: qty });\n");
    buf_bytes(out, "        seen.insert(name, qty);                // also contains(k), remove(k)\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    items.sort_by(|a, b| b.qty - a.qty);       // a, b: &Item; < 0: a first\n");
    buf_bytes(out, "    for (i, it) in items.iter().enumerate() { print(f\"{i}:{it.name} \"); }\n");
    buf_bytes(out, "    let line = trim(sc.next_line().unwrap());  // the rest of the line\n");
    buf_bytes(out, "    let total = split_in(line, ',', gpa).iter()\n");
    buf_bytes(out, "        .map(|w| parse_int(trim(w)).unwrap_or(0)).sum();\n");
    buf_bytes(out, "    match seen.get(\"pen\") {                    // Option<i64>\n");
    buf_bytes(out, "        Some(q) => println(f\"pen={q} total={total}\"),\n");
    buf_bytes(out, "        None => println(\"no pen\"),\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    let text = format_in(f\"{items.len()} {seen.len()}\", gpa);   // a Buf\n");
    buf_bytes(out, "    println(text.as_slice());                  // text, seen, items, input: dropped at the end\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```in\n");
    buf_bytes(out, "3 pen 2 ink 5 cap 1 1,2, 3\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "0:ink 1:pen 2:cap pen=2 total=6\n");
    buf_bytes(out, "3 3\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Lines one at a time: `let mut b = Buf::new_in(gpa); while\n");
    buf_bytes(out, "read_line(&mut b).unwrap() { ... }` (without the `'\\n'`). An owned\n");
    buf_bytes(out, "value (`Vec`, `Buf`, `HashMap`, a struct holding one) moves: after `let\n");
    buf_bytes(out, "w = v;` or `f(v)`, `v` is dead (`own.moved`); take `v: &Vec<T>` (`&mut`\n");
    buf_bytes(out, "to change it) and pass `&v` (`&mut v`), or `.clone()`. A reference kept\n");
    buf_bytes(out, "in a local (`let p = &mut st;`) is passed on as `p`, any number of\n");
    buf_bytes(out, "times. A slice of `v` is a view: take it again after `v` grows. std's API, a line per item: `tachyonc guide std`; one name\n");
    buf_bytes(out, "with its comment: `tachyonc guide --find split_in`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## The first errors and their fixes\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| error (short form) | fix |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `non-exhaustive match: 'E::B' is not covered` | an arm for it, or `_ =>` |\n");
    buf_bytes(out, "| `calling a C function is unsafe`; `dereference of a raw pointer is unsafe` | `unsafe { ... }`; `tachyonc fix --only unsafe` adds them |\n");
    buf_bytes(out, "| `no 'collections' in module 'std'`; `unknown type 'String'` | std is one module: `use std::name;` (its most used names need none); text is `[u8]`, built in a `Buf` |\n");
    buf_bytes(out, "| `allocation is explicit: pass an allocator` | `Vec::new_in(gpa)`, `gpa` from `fn main(gpa: Gpa)` passed down |\n");
    buf_bytes(out, "| `expected '&mut P', got '&P'` | `&mut x` at the call |\n");
    buf_bytes(out, "| `own.moved: 'v' is used here after it moved into 'f(v)'` | `f(&v)` with `v: &Vec<T>`, or `f(v.clone())` (the `try:`) |\n");
    buf_bytes(out, "| `own.conflict: ... while 'first' views them` | use the view before the change, or take it again after (`guide views`) |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Every error has a `help:`; `tachyonc guide errors` has more.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## The loop\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Write the program, then `tachyonc check` (a check hook, where there is\n");
    buf_bytes(out, "one, runs it after each edit); fix the first error first. Before writing a construct\n");
    buf_bytes(out, "you are unsure of, `tachyonc guide --find WORDS` (`--find read a line`)\n");
    buf_bytes(out, "or `tachyonc guide TOPIC#SECTION` prints the lines on it; `tachyonc\n");
    buf_bytes(out, "try 'CODE'` runs a snippet. For an unfamiliar item, ask\n");
    buf_bytes(out, "`tachyonc query context NAME` first: its source, what it calls and its\n");
    buf_bytes(out, "callers in one call (`query context parse_args`). Edits, refactorings\n");
    buf_bytes(out, "and the other queries: `tachyonc guide tools`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Topics (`tachyonc guide TOPIC`, `TOPIC#` lists its sections):\n");
    buf_bytes(out, "@TOPIC-NAMES@\n");
}
