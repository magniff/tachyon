use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Tests, properties and fuzzing\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Tests are written in the language (0.18) and run by `tachyonc test`,\n");
    buf_bytes(out, "which builds them at -O0 and at -O2 and compares the two. Other builds\n");
    buf_bytes(out, "leave test items out; `check` and the queries see them.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## #[test]\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn gap(v: [i64]) -> i64 {\n");
    buf_bytes(out, "    let mut best = 0;\n");
    buf_bytes(out, "    for i in 1..v.len() {\n");
    buf_bytes(out, "        if v[i] - v[i - 1] > best {\n");
    buf_bytes(out, "            best = v[i] - v[i - 1];\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    best\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[test]\n");
    buf_bytes(out, "fn gap_of_three() {\n");
    buf_bytes(out, "    assert_eq(gap([1, 5, 6][..]), 4);\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[test]\n");
    buf_bytes(out, "fn parses() -> Result<(), std::ParseIntError> {\n");
    buf_bytes(out, "    let n = std::parse_int(\"12\")?;\n");
    buf_bytes(out, "    assert(n == 12);\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[test]\n");
    buf_bytes(out, "fn keeps_nothing(gpa: Gpa) {\n");
    buf_bytes(out, "    let mut b = Buf::new_in(gpa);\n");
    buf_bytes(out, "    b.push_str(\"dropped at the end\");\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    std::print_int(gap([2, 9][..]));\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "7\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- A `#[test]` takes nothing or `gpa: Gpa`, and returns `()` or a\n");
    buf_bytes(out, "  Result (an `Err` fails). Anything else is `test.signature`.\n");
    buf_bytes(out, "- Test builds use `--check-alloc`: a block left allocated fails the test\n");
    buf_bytes(out, "  (`check-alloc: 1 block of Gpa not freed ... allocated at FILE:L:C`).\n");
    buf_bytes(out, "- `#[cfg(test)] mod tests;` (a file, or `mod tests { .. }`) is a module\n");
    buf_bytes(out, "  only test builds have. It sees its parent's items without an import:\n");
    buf_bytes(out, "  `use super::*;` is refused (`import.wildcard`; no wildcard imports).\n");
    buf_bytes(out, "- `assert_snapshot(x)` compares `{x:?}` with\n");
    buf_bytes(out, "  `tests/snapshots/MODULE__TEST__N.snap`; the first run writes it, a\n");
    buf_bytes(out, "  change fails with the first differing line, `--accept` rewrites it.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## #[property]\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A property's parameters are generated: 100 cases (`--cases N`), sizes\n");
    buf_bytes(out, "growing, a failure shrunk to a small input and printed with its seed.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn clamp(x: i64, lo: i64, hi: i64) -> i64 {\n");
    buf_bytes(out, "    if x < lo { lo } else if x > hi { hi } else { x }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[property]\n");
    buf_bytes(out, "fn clamp_stays_in(x: i64, lo: i64, hi: i64) {\n");
    buf_bytes(out, "    if lo <= hi {\n");
    buf_bytes(out, "        let c = clamp(x, lo, hi);\n");
    buf_bytes(out, "        assert(lo <= c && c <= hi);\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "struct Small { n: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl std::Arbitrary for Small {\n");
    buf_bytes(out, "    fn arbitrary(g: &mut std::Gen) -> Small {\n");
    buf_bytes(out, "        Small { n: g.int_in(0, 9) }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[property]\n");
    buf_bytes(out, "fn small_is_small(s: Small) {\n");
    buf_bytes(out, "    assert(s.n >= 0 && s.n <= 9);\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    std::print_int(clamp(12, 0, 9));\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "9\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- Numbers, bool, `Vec<T>`, `[T]`, `Buf`, `Option`, `Result`, tuples\n");
    buf_bytes(out, "  and the program's structs and enums are generated from their types;\n");
    buf_bytes(out, "  `impl std::Arbitrary` gives a type its own (`g.int_in(lo, hi)`,\n");
    buf_bytes(out, "  `g.choose(n)`, `g.bool()`, `g.size()`).\n");
    buf_bytes(out, "- Each case runs in a child process; its values are dropped after it,\n");
    buf_bytes(out, "  and a block it leaves allocated fails the case (a leak).\n");
    buf_bytes(out, "- A function with an `ensures` is tested as a property too, its\n");
    buf_bytes(out, "  requires filtering the inputs (`--no-contracts`: not).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## tachyonc test\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "$ tachyonc test\n");
    buf_bytes(out, "test main.tach: 6 passed, 2 failed (1 case, 5 #[test], 2 #[property], 1 contract; -O0 and -O2 agree)\n");
    buf_bytes(out, "FAIL gap_needs_two: checks.tach:14:8: index out of bounds: index 1, length 1\n");
    buf_bytes(out, "  trace: checks.tach:14 checks::gap_needs_two\n");
    buf_bytes(out, "FAIL bubble_sorts (property, case 11 of 100, shrunk in 8 steps): not sorted\n");
    buf_bytes(out, "  input: v = [1, 0]\n");
    buf_bytes(out, "  try: tachyonc test bubble_sorts --seed 0xf788dd27897d1fed main.tach\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- The summary first, then one line per failure, its trace, its input\n");
    buf_bytes(out, "  and the command that replays it. `FILTER` runs the tests whose name\n");
    buf_bytes(out, "  holds it; `tests/NAME.in` with `NAME.out` are cases of the program.\n");
    buf_bytes(out, "- A test whose -O0 and -O2 runs differ is a `DIFF` line: the compiler's\n");
    buf_bytes(out, "  bug, not yours (`tachyonc reduce --differs` shrinks it).\n");
    buf_bytes(out, "- `--seed H` replays a property's failure, `--accept` takes snapshots,\n");
    buf_bytes(out, "  case outputs and saved fuzz inputs, `-O N` runs one level.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## #[fuzz] and tachyonc fuzz\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn parse(data: [u8]) -> i64 {\n");
    buf_bytes(out, "    if data.len() >= 2 && data[0] == 'O' && data[1] == 'K' {\n");
    buf_bytes(out, "        return 1;\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[fuzz]\n");
    buf_bytes(out, "fn parse_never_crashes(data: [u8]) {\n");
    buf_bytes(out, "    let _ = parse(data);\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    std::print_int(parse(\"OK\"));\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "1\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc fuzz NAME [--time S]` builds the test binary with `--coverage`\n");
    buf_bytes(out, "(every block counts in std's map) and mutates inputs, keeping those that\n");
    buf_bytes(out, "reach new code. A crash is shrunk, saved under `.tachyonc/fuzz/NAME/`\n");
    buf_bytes(out, "and replayed by every `tachyonc test` after (`--accept` keeps it in\n");
    buf_bytes(out, "`tests/fuzz/NAME/`). A `#[fuzz]` takes one `[u8]` (or any generated\n");
    buf_bytes(out, "types, like a property).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## tachyonc reduce over programs\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `tachyonc reduce PROG.tach --differs [--input F]`: the program cut\n");
    buf_bytes(out, "  while its -O0 and -O2 runs disagree (a miscompile, to report).\n");
    buf_bytes(out, "- `--fails 'TEXT'`: while the build or the run prints TEXT.\n");
    buf_bytes(out, "- `--test NAME`: while test NAME fails as it does now.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Items, then statements, are cut by halves, then one by one; the result\n");
    buf_bytes(out, "is `PROG.min.tach`. For an input instead: `tachyonc reduce FILE --until\n");
    buf_bytes(out, "'CMD'` (guide debug).\n");
}
