// Generated by compiler/guide/embed.sh from compiler/guide/traits.md (do
// not edit): the guide's topic 'traits'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Traits\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A trait declares functions; `Self` stands for the implementing type; a\n");
    buf_bytes(out, "function may have a default body. `impl Trait for Type` defines them for\n");
    buf_bytes(out, "any type (`i64`, `[u8]`, `Vec<T>`, a struct). Its functions become the\n");
    buf_bytes(out, "type's methods. Dispatch is static: a trait is not a type.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::hash_u64;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "trait Shape {\n");
    buf_bytes(out, "    fn area(self: &Self) -> i64;\n");
    buf_bytes(out, "    fn name(self: &Self) -> [u8] { \"shape\" }   // a default\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "struct Square { side: i64 }\n");
    buf_bytes(out, "struct Rect { w: i64, h: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Shape for Square {\n");
    buf_bytes(out, "    fn area(self: &Square) -> i64 { self.side * self.side }\n");
    buf_bytes(out, "    fn name(self: &Square) -> [u8] { \"square\" }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Shape for Rect {\n");
    buf_bytes(out, "    fn area(self: &Rect) -> i64 { self.w * self.h }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn report<T: Shape>(s: &T) {\n");
    buf_bytes(out, "    print(s.name());\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    std::print_int(s.area());\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// Operators: + - * / and unary - through Add Sub Mul Div Neg,\n");
    buf_bytes(out, "// == through Eq, < <= > >= through Ord's cmp. Eq and Ord take\n");
    buf_bytes(out, "// `self: &Self`, so their impls do (Display, Debug, Iterator: `*Self`).\n");
    buf_bytes(out, "struct V2 { x: i64, y: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Add for V2 {\n");
    buf_bytes(out, "    fn add(self: V2, o: V2) -> V2 { V2 { x: self.x + o.x, y: self.y + o.y } }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Ord for V2 {\n");
    buf_bytes(out, "    fn cmp(self: &V2, o: &V2) -> i64 { (self.x + self.y) - (o.x + o.y) }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Hash for V2 {\n");
    buf_bytes(out, "    fn hash(self: &V2) -> u64 { hash_u64((self.x * 31 + self.y) as u64) }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "trait Double { fn double(self: Self) -> Self; }\n");
    buf_bytes(out, "impl Double for i64 { fn double(self: i64) -> i64 { self * 2 } }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let sq = Square { side: 3 };\n");
    buf_bytes(out, "    let r = Rect { w: 2, h: 5 };\n");
    buf_bytes(out, "    report(&sq);                          // &place: a temporary has no address\n");
    buf_bytes(out, "    report(&r);\n");
    buf_bytes(out, "    let v = V2 { x: 1, y: 2 } + V2 { x: 3, y: 4 };\n");
    buf_bytes(out, "    if v > (V2 { x: 0, y: 0 }) { std::print_int(v.x * 10 + v.y); }\n");
    buf_bytes(out, "    let mut seen: HashMap<V2, bool> = HashMap::new_in(gpa);   // a struct key: Hash + Eq\n");
    buf_bytes(out, "    seen.insert(v, true);\n");
    buf_bytes(out, "    if seen.contains(V2 { x: 4, y: 6 }) { print(\" found \"); }\n");
    buf_bytes(out, "    std::print_int(21.double());\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "square 9\n");
    buf_bytes(out, "shape 10\n");
    buf_bytes(out, "46 found 42\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- Bounds: `fn f<T: A + B>`, `impl<T: Hash> Hash for Pair<T>`, `struct\n");
    buf_bytes(out, "  Map<K: Hash + Eq, V>`. A call with a type that lacks the trait is an\n");
    buf_bytes(out, "  error naming the bound.\n");
    buf_bytes(out, "- At most one impl per trait and type (a generic impl counts for all\n");
    buf_bytes(out, "  its instances).\n");
    buf_bytes(out, "- `Eq`: every type with structural `==` has it (structs, enums, tuples,\n");
    buf_bytes(out, "  arrays, slices whose parts have `==`; a `[u8]` by bytes); an\n");
    buf_bytes(out, "  `impl Eq` replaces structural `==`, also for a part.\n");
    buf_bytes(out, "  `Ord`: numbers, pointers, fieldless enums have it.\n");
    buf_bytes(out, "- Methods are called `x.m()` or `Type::m(&x)`; a trait's function\n");
    buf_bytes(out, "  without `self` is called `Type::f()`.\n");
    buf_bytes(out, "- A default function is checked, and compiled, only for the impls\n");
    buf_bytes(out, "  that use it (in a non-generic impl).\n");
    buf_bytes(out, "- Not there: `dyn Trait` (use generics, or an enum of the cases),\n");
    buf_bytes(out, "  supertraits, associated constants, `impl Trait` in argument or return\n");
    buf_bytes(out, "  position, blanket impls over all `T`.\n");
    buf_bytes(out, "- (0.15) Traits may take type parameters, `trait From<T>`; bounds take\n");
    buf_bytes(out, "  arguments, `T: From<i64>` (`tachyonc guide conversions`).\n");
    buf_bytes(out, "  `#[derive(Eq, Ord, Hash, Debug, Clone)]` writes impls (`tachyonc\n");
    buf_bytes(out, "  guide formatting`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Associated types (0.14)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A trait declares `type Name;`, each impl defines it, and `T::Name` (or\n");
    buf_bytes(out, "`Self::Name`) is that type. A bound can fix it: `I: Iterator<Item =\n");
    buf_bytes(out, "i64>`. Slices get impls too: `impl<T> [T] { ... }`, `impl<T> Tr for [T]`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::print_int;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "struct Countdown { n: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Iterator for Countdown {           // std's trait, in the prelude\n");
    buf_bytes(out, "    type Item = i64;\n");
    buf_bytes(out, "    fn next(self: &mut Countdown) -> Option<i64> {\n");
    buf_bytes(out, "        if self.n == 0 { return None; }\n");
    buf_bytes(out, "        self.n -= 1;\n");
    buf_bytes(out, "        Some(self.n + 1)\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn first<I: Iterator>(it: I) -> Option<I::Item> {\n");
    buf_bytes(out, "    let mut it = it;\n");
    buf_bytes(out, "    it.next()\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn total<I: Iterator<Item = i64>>(it: I) -> i64 {\n");
    buf_bytes(out, "    it.sum()                            // a default of Iterator\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl<T> [T] {\n");
    buf_bytes(out, "    fn second(self: [T]) -> T { self[1] }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    print_int(first(Countdown { n: 3 }).unwrap());\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    print_int(total(Countdown { n: 4 }));\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    print_int(Countdown { n: 5 }.count());\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    let c: [u8; 1] = [\"xyz\".second()];\n");
    buf_bytes(out, "    print(c[0..1]);\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "3 10 5 y\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- Every declared name must be defined: \"the impl of trait 'Iterator' is\n");
    buf_bytes(out, "  missing 'type Item'\".\n");
    buf_bytes(out, "- `X::Name` needs `X` to be a type parameter or `Self`; two traits\n");
    buf_bytes(out, "  defining the name for one type is an ambiguity error. No defaults or\n");
    buf_bytes(out, "  bounds on associated types, no `<T as Tr>::Name`.\n");
    buf_bytes(out, "- A constraint that does not hold: \"'Small::Item' is 'u8', but the bound\n");
    buf_bytes(out, "  'I: Iterator<Item = i64>' of 'total' requires 'i64'\".\n");
    buf_bytes(out, "- `F::Output` is the result type of a fn type (or a closure).\n");
}
