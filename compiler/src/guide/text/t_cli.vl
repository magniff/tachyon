use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Command lines: std::cli (0.24)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`std::cli` parses a program's arguments: clap's builder, without derive.\n");
    buf_bytes(out, "A `Command` lists flags, options and positionals (and subcommands);\n");
    buf_bytes(out, "`parse` gives `Matches` or a `CliError`. `--help`, `-h` and (with a\n");
    buf_bytes(out, "version) `--version`, `-V` are built in. The design: docs/design/cli.md.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "use std::cli::{Arg, Command};\n");
    buf_bytes(out, "use std::env;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let cmd = Command::new_in(\"grep\", gpa).version(\"1.0\").about(\"find lines\")\n");
    buf_bytes(out, "        .arg(Arg::flag(\"count\").short('c').help(\"print how many\"))\n");
    buf_bytes(out, "        .arg(Arg::option(\"max\").short('m').value_name(\"N\").default(\"0\"))\n");
    buf_bytes(out, "        .arg(Arg::positional(\"pattern\").required())\n");
    buf_bytes(out, "        .arg(Arg::positional(\"file\").multiple());\n");
    buf_bytes(out, "    let m = cmd.parse_or_exit(env::args());    // an error: printed, exit 2\n");
    buf_bytes(out, "    let max = match m.get_as::<i64>(\"max\") { Ok(n) => n, Err(e) => cmd.exit(e) };\n");
    buf_bytes(out, "    for f in m.values(\"file\") { .. }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Parsing and Matches\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`cmd.parse(args)` takes any iterator of `str`, the program's name first\n");
    buf_bytes(out, "(`env::args()`, `line.split(' ')`, `v.iter()`); `parse_in(args, a)`\n");
    buf_bytes(out, "puts the Matches on allocator `a` (an arena). Accepted: `-v`, `-vvv`,\n");
    buf_bytes(out, "clusters `-vq`, `-ofile`, `-o file`, `-o=file`, `--out file`,\n");
    buf_bytes(out, "`--out=file`, `--` (the rest is positional), `-` (a positional). An\n");
    buf_bytes(out, "option takes the next argument even when it starts with `-` (`-n -5`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::cli::{Arg, Command};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let cmd = Command::new_in(\"tool\", gpa)\n");
    buf_bytes(out, "        .arg(Arg::flag(\"verbose\").short('v'))\n");
    buf_bytes(out, "        .arg(Arg::option(\"out\").short('o').default(\"-\"))\n");
    buf_bytes(out, "        .arg(Arg::option(\"jobs\").short('j').default(\"1\"))\n");
    buf_bytes(out, "        .arg(Arg::positional(\"file\").multiple())\n");
    buf_bytes(out, "        .subcommand(Command::new_in(\"push\", gpa).arg(Arg::flag(\"force\").short('f')));\n");
    buf_bytes(out, "    let m = cmd.parse(\"tool -vv -ofile a b\".split(' ')).unwrap();\n");
    buf_bytes(out, "    let jobs = m.get_as::<i64>(\"jobs\").unwrap();\n");
    buf_bytes(out, "    println(f\"{m.count(\"verbose\")} {m.get(\"out\").unwrap()} {jobs} {m.values(\"file\").len()}\");\n");
    buf_bytes(out, "    let p = cmd.parse(\"tool -j 4 push -f\".split(' ')).unwrap();\n");
    buf_bytes(out, "    match p.subcommand() {\n");
    buf_bytes(out, "        Some((name, sub)) => println(f\"{name} {sub.flag(\"force\")}\"),\n");
    buf_bytes(out, "        None => println(\"none\"),\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    match cmd.parse(\"tool --outt x\".split(' ')) {\n");
    buf_bytes(out, "        Ok(_) => println(\"ok\"),\n");
    buf_bytes(out, "        Err(e) => print(cmd.render_in(e, gpa).as_slice()),\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "2 file 1 2\n");
    buf_bytes(out, "push true\n");
    buf_bytes(out, "error: unknown option '--outt'\n");
    buf_bytes(out, "try: --out\n");
    buf_bytes(out, "usage: tool [options] [file]... [command]\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `m.flag(name)`: given (a default is not); `m.count(name)`: how many\n");
    buf_bytes(out, "  times; `m.get(name)`: the last value or the default, an\n");
    buf_bytes(out, "  `Option<str>`; `m.values(name)`: every value, a `[str]`;\n");
    buf_bytes(out, "  `m.get_as::<T>(name)`: parsed (`FromStr`), `Err(CliError)` naming the\n");
    buf_bytes(out, "  argument; `m.subcommand()`: `Option<(str, Matches)>`. A name that is\n");
    buf_bytes(out, "  no Arg of that command panics.\n");
    buf_bytes(out, "- An Arg: `.short('x')`, `.long(\"s\")` (its name by default),\n");
    buf_bytes(out, "  `.help(..)`, `.value_name(\"FILE\")`, `.default(..)`, `.required()`,\n");
    buf_bytes(out, "  `.multiple()` (a positional taking the rest). Options may repeat.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Help and errors\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`cmd.exit(e)` prints a CliError and exits with `e.exit_code()`: the\n");
    buf_bytes(out, "help or version on stdout (0), else on stderr (2) the error, a `try:`\n");
    buf_bytes(out, "line (the nearest option or command by edit distance, or the fix) and\n");
    buf_bytes(out, "the usage line. `cmd.render_in(e, a)` and `cmd.help_in(a)` give that\n");
    buf_bytes(out, "text as a `Buf`; `.width(n)` wraps the help (80). Parsing does no io\n");
    buf_bytes(out, "(`query effects`): only `exit` and `parse_or_exit` print.\n");
}
