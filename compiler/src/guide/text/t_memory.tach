// Generated by compiler/guide/embed.sh from compiler/guide/memory.md (do
// not edit): the guide's topic 'memory'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Memory\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Tachyon manages no memory for you: there are no destructors, no\n");
    buf_bytes(out, "garbage collector, no reference counting. Values live on the stack, in\n");
    buf_bytes(out, "statics, or on the heap through std's types (`Vec`, `Buf`, `HashMap`,\n");
    buf_bytes(out, "which call C's `malloc`/`realloc`/`free`) and C's allocator.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Copies\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Every value is copied by `=`, by a call and by a return, bit for bit;\n");
    buf_bytes(out, "nothing is moved. For plain values (numbers, arrays, structs of them)\n");
    buf_bytes(out, "the copy is independent. A `Vec`, `Buf` or `HashMap` is a small handle\n");
    buf_bytes(out, "(a pointer, a length, a capacity): its copy points to the same memory,\n");
    buf_bytes(out, "and a push through one copy is not seen by the other.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn add_one(v: *Vec<i64>) { v.push(1); }   // through a pointer: the caller's Vec\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn lost(v: Vec<i64>) {                    // a copy of the handle\n");
    buf_bytes(out, "    let mut w = v;\n");
    buf_bytes(out, "    w.push(2);                            // the caller's len does not change\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let mut v: Vec<i64> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    defer v.free();\n");
    buf_bytes(out, "    add_one(&v);\n");
    buf_bytes(out, "    add_one(&v);\n");
    buf_bytes(out, "    std::print_int(v.len());\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    let a = [1, 2, 3];\n");
    buf_bytes(out, "    let mut b = a;                        // arrays are values\n");
    buf_bytes(out, "    b[0] = 9;\n");
    buf_bytes(out, "    std::print_int(a[0]);\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "2 1\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Write functions that change a container to take `*Vec<T>` and pass\n");
    buf_bytes(out, "`&v`; return a new container by value (`fn make(gpa: Gpa) -> Vec<i64>`:\n");
    buf_bytes(out, "making one takes an allocator, `guide allocators`), which the caller\n");
    buf_bytes(out, "then owns and frees.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Freeing: defer\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`defer stmt;` (or `defer { ... }`) runs when control leaves the block:\n");
    buf_bytes(out, "at its end, or by `return`, `break` or `continue`, last deferred first.\n");
    buf_bytes(out, "The value a block returns is computed before the deferred statements\n");
    buf_bytes(out, "run. They do not run on `exit` or a failed check (exit 101).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::Buf;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn describe(n: i64, gpa: Gpa) -> i64 {\n");
    buf_bytes(out, "    let mut b = Buf::new_in(gpa);\n");
    buf_bytes(out, "    defer b.free();                       // on every path out\n");
    buf_bytes(out, "    if n < 0 { return -1; }\n");
    buf_bytes(out, "    b.push_int(n);\n");
    buf_bytes(out, "    b.len()                               // computed before the free\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    defer println(\"done\");\n");
    buf_bytes(out, "    std::print_int(describe(12345, gpa) + describe(-5, gpa));\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "4\n");
    buf_bytes(out, "done\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Views\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A slice (`[T]`) does not own memory. One from `v.as_slice()` is valid\n");
    buf_bytes(out, "until `v` grows (a push may reallocate) or is freed; one of an array,\n");
    buf_bytes(out, "while the array lives (not after the function holding it returns).\n");
    buf_bytes(out, "Using a view after its memory is gone is undefined behaviour, the one\n");
    buf_bytes(out, "case in safe code (tachyon has no lifetimes yet). Take the slice again\n");
    buf_bytes(out, "after pushing:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let mut v: Vec<i64> = Vec::new_in(gpa);\n");
    buf_bytes(out, "defer v.free();\n");
    buf_bytes(out, "v.push(1);\n");
    buf_bytes(out, "let s = v.as_slice();\n");
    buf_bytes(out, "std::print_int(s[0]);\n");
    buf_bytes(out, "for i in 0..100 { v.push(i); }            // may move the elements\n");
    buf_bytes(out, "let s2 = v.as_slice();                    // a fresh view; do not use s now\n");
    buf_bytes(out, "std::print_int(s2.len);\n");
    buf_bytes(out, "println(\"\");\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "1101\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Views without a name count too: `for x in v` and `v.iter()` view `v`\n");
    buf_bytes(out, "for the whole loop (do not push to `v` inside it; collect into another\n");
    buf_bytes(out, "Vec), and in `f(v.as_slice(), g(&v))` the slice is taken before `g`\n");
    buf_bytes(out, "runs. A view kept in a variable or a field and re-taken after each push\n");
    buf_bytes(out, "is fine, even inside an index: in `s[grow(&v, &s)]` the slice `s` is\n");
    buf_bytes(out, "read after `grow` returns (0.14).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Raw memory\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`malloc` and `free` from C, in `unsafe` (see `tachyonc guide unsafe`).\n");
    buf_bytes(out, "`tachyonc --check-unsafe -O1` checks heap accesses through raw pointers\n");
    buf_bytes(out, "at run time. Memory nobody wrote (from `malloc`) has an unspecified\n");
    buf_bytes(out, "value: write it before reading it.\n");
}
