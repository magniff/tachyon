// Generated by compiler/guide/embed.sh from compiler/guide/memory.md (do
// not edit): the guide's topic 'memory'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Memory\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Tachyon has Rust's value semantics without lifetimes (0.17): a value has\n");
    buf_bytes(out, "one owner, an owned value moves and is dropped at the end of its scope,\n");
    buf_bytes(out, "references `&T` and `&mut T` are checked, and so are the views a slice\n");
    buf_bytes(out, "holds. There is no garbage collector and no reference counting; memory\n");
    buf_bytes(out, "comes from an allocator (`guide allocators`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Three kinds of types\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The kind is computed from the type; nothing is declared:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| kind | what | `=`, a by-value argument, `return` |\n");
    buf_bytes(out, "|---|---|---|\n");
    buf_bytes(out, "| plain | numbers, bool, raw `*T`, structs, tuples and arrays of plain types | a bit copy, as in C |\n");
    buf_bytes(out, "| owned | `Vec`, `Buf`, `HashMap`, `Arena`, a type with `Drop`, a struct holding one | a move: the old name is dead until assigned again; `.clone()` copies |\n");
    buf_bytes(out, "| view | a slice `[T]`, a reference `&T`/`&mut T`, a struct holding one (`Scanner`), a closure capturing by reference | a copy (`&mut`: a move) that cannot outlive what it views |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc query own FILE:LINE:COL` shows each local's kind there, and\n");
    buf_bytes(out, "whether it is moved or what it views.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Moves and drops\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn total(v: &Vec<i64>) -> i64 {           // reads: a shared reference\n");
    buf_bytes(out, "    let mut s = 0;\n");
    buf_bytes(out, "    for x in v { s += x; }\n");
    buf_bytes(out, "    s\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn fill(v: &mut Vec<i64>, n: i64) {       // writes: an exclusive one\n");
    buf_bytes(out, "    for i in 0..n { v.push(i * i); }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn make(n: i64, gpa: Gpa) -> Vec<i64> {   // the caller owns the result\n");
    buf_bytes(out, "    let mut v: Vec<i64> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    fill(&mut v, n);\n");
    buf_bytes(out, "    v                                     // moved out: not dropped here\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) {\n");
    buf_bytes(out, "    let v = make(4, gpa);\n");
    buf_bytes(out, "    let w = v.clone();                    // a copy; `let w = v;` moves v\n");
    buf_bytes(out, "    println(f\"{total(&v)} {total(&w)} {w.len()}\");\n");
    buf_bytes(out, "}                                         // w, then v, dropped (freed)\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "14 14 4\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `let w = v;`, `f(v)` for a parameter `v: Vec<T>`, `return v`, a struct\n");
    buf_bytes(out, "  literal's field and a `move` closure move `v`; using `v` after that is\n");
    buf_bytes(out, "  `own.moved` (its `try:` makes the parameter `&Vec<T>`, or passes\n");
    buf_bytes(out, "  `v.clone()`).\n");
    buf_bytes(out, "- At the end of a scope its owned locals are dropped, last declared\n");
    buf_bytes(out, "  first, on every exit (`return`, `break`, `?`), not on `exit` or a\n");
    buf_bytes(out, "  panic. A moved value is not dropped where it was.\n");
    buf_bytes(out, "- `impl Drop for T { fn drop(self: &mut T) { ... } }` runs code at the\n");
    buf_bytes(out, "  drop; a type without one drops its fields. `drop(x)` drops early,\n");
    buf_bytes(out, "  `std::forget(x)` never (a leak, safe).\n");
    buf_bytes(out, "- Moving out of a borrowed place (`let k = self.keys;` in a `&mut self`\n");
    buf_bytes(out, "  method) is `own.move_out`: take it with `self.keys.take()`, which\n");
    buf_bytes(out, "  leaves an empty one (`std::take(&mut x)` for a `Default` value), or\n");
    buf_bytes(out, "  `std::replace`.\n");
    buf_bytes(out, "- `v.free()` still works: it frees now and leaves `v` empty (its drop\n");
    buf_bytes(out, "  then frees nothing). `defer v.free()`, the idiom before 0.17, is\n");
    buf_bytes(out, "  legal and no longer needed; `tachyonc fix --values` rewrites old code.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## References\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `&x` takes a shared reference: the callee reads. `&mut x` takes an\n");
    buf_bytes(out, "  exclusive one: the callee may change `x`. The parameter says which\n");
    buf_bytes(out, "  (`p: &T`, `p: &mut T`), and so does the call.\n");
    buf_bytes(out, "- `self: &T` and `self: &mut T` receivers are referenced by the call:\n");
    buf_bytes(out, "  `v.push(1)`, `p.get()`.\n");
    buf_bytes(out, "- Fields and methods reach through a reference (`p.x`, `p.len()`);\n");
    buf_bytes(out, "  the value itself is `*p` (`*out = acc`).\n");
    buf_bytes(out, "- `let r = &mut x;` keeps a reference in a local; passing `r` to several\n");
    buf_bytes(out, "  calls reborrows it each time. A struct may hold one\n");
    buf_bytes(out, "  (`struct Parser { q: &mut Query }`).\n");
    buf_bytes(out, "- Aliasing XOR mutation: while a `&mut x` (or a view of `x`) is in use,\n");
    buf_bytes(out, "  `x` is not read or changed another way. `f(&mut a, &a)` is an error;\n");
    buf_bytes(out, "  `v.push(v.len())` is fine (the receiver is taken after the arguments).\n");
    buf_bytes(out, "- A `*T` parameter (without `mut`) is still accepted as `&mut T` in\n");
    buf_bytes(out, "  0.17; `tachyonc fix --values` rewrites it to `&mut T` or `&T`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Views\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A slice does not own memory: `v.as_slice()` views `v`'s elements, a\n");
    buf_bytes(out, "`Scanner` views its text. The checker keeps every view inside what it\n");
    buf_bytes(out, "views: a view used after its owner grew or was dropped (`own.conflict`),\n");
    buf_bytes(out, "returned out of the function that owns its memory (`own.escape`), or a\n");
    buf_bytes(out, "`for` loop over a Vec that pushes to it, is an error, not undefined\n");
    buf_bytes(out, "behaviour. Take the view again after the change, or keep an index:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let mut v: Vec<i64> = Vec::new_in(gpa);\n");
    buf_bytes(out, "v.push(1);\n");
    buf_bytes(out, "let s = v.as_slice();\n");
    buf_bytes(out, "print(f\"{s[0]} \");                        // used before the pushes\n");
    buf_bytes(out, "for i in 0..100 { v.push(i); }            // may move the elements\n");
    buf_bytes(out, "let s2 = v.as_slice();                    // a fresh view\n");
    buf_bytes(out, "println(f\"{s2.len}\");\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "1 101\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc guide views` has the rules, the diagnostics and the patterns\n");
    buf_bytes(out, "(parsers and lexers that keep views of their input are fine).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc --check-alloc` (0.16) also checks at run time: every Gpa block\n");
    buf_bytes(out, "on pages of its own, so a use after free (through `unsafe` code) faults\n");
    buf_bytes(out, "and is reported with where the block was allocated and freed; bad frees\n");
    buf_bytes(out, "and leaks are reported too (`gpa.live_blocks()`, `gpa.check_leaks()` for\n");
    buf_bytes(out, "tests).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Raw memory\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`malloc` and `free` from C, raw `*T` pointers, in `unsafe` (`tachyonc\n");
    buf_bytes(out, "guide unsafe`). `tachyonc --check-unsafe -O1` checks heap accesses\n");
    buf_bytes(out, "through raw pointers at run time. Memory nobody wrote (from `malloc`)\n");
    buf_bytes(out, "has an unspecified value: write it before reading it.\n");
}
