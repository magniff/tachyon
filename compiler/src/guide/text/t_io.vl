pub fn text(out: i64) {
    buf_bytes(out, "# io\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Files, paths, the environment, processes\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Rust's names; a path is any `[u8]`: a literal, a `str`, a `Path`, `&p`\n");
    buf_bytes(out, "of a PathBuf. `File::open(p)?`, `File::create(p)?`,\n");
    buf_bytes(out, "`OpenOptions::new().append(true).create(true).open(p)?`;\n");
    buf_bytes(out, "`fs::read_to_string_in(p, gpa)?` (a String), `fs::read_in(p, gpa)?` (a\n");
    buf_bytes(out, "`Vec<u8>`), `fs::write(p, data)?`, `fs::append(p, data)?`,\n");
    buf_bytes(out, "`fs::metadata(p)?` (`len()`, `is_dir()`), `fs::create_dir_all(p)?`,\n");
    buf_bytes(out, "`fs::remove_file`, `fs::remove_dir_all`, `fs::rename(a, b)`,\n");
    buf_bytes(out, "`fs::read_dir(p)?` (entries: `let e = e?; e.file_name()`, a view of the entry; `e.path_in(dir, gpa)`),\n");
    buf_bytes(out, "`fs::exists(p)`. Errors are `io::Error` (`e.kind()`, an `ErrorKind`;\n");
    buf_bytes(out, "Display as Rust's: `No such file or directory (os error 2)`), and\n");
    buf_bytes(out, "`io::Result<T>` goes with `?`. `BufReader::new(f)` and\n");
    buf_bytes(out, "`BufWriter::new(f)` keep an 8 KB buffer inline (no allocation):\n");
    buf_bytes(out, "`r.read_line(&s)?` appends a line, its `'\\n'` included (0 at the\n");
    buf_bytes(out, "end); `r.lines_in(gpa)` yields each line as a String;\n");
    buf_bytes(out, "`writeln(&w, f\"..\")?` (Rust's `writeln!`; `use std::io::writeln`).\n");
    buf_bytes(out, "`Path::new(p)`: `file_name()`, `extension()`, `parent()`,\n");
    buf_bytes(out, "`components()`, `join_in(q, gpa)` (a PathBuf). `env::args()` yields\n");
    buf_bytes(out, "`str`s (`.collect_in(gpa)`), `env::get_in(name, gpa)` a\n");
    buf_bytes(out, "`Result<String, VarError>` (Rust's `env::var`). `Command::new(p)`, then `c.arg(a)` (it\n");
    buf_bytes(out, "changes `c`: `var c = ..`, no chaining), `c.output_in(gpa)?`\n");
    buf_bytes(out, "(`status`, `stdout`, `stderr`), `c.status()?`. A Rust `use std::io::{self,\n");
    buf_bytes(out, "Write}` is two lines here: `use std::io;` and `use std::io::Write;`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::fs;\n");
    buf_bytes(out, "use std::fs::File;\n");
    buf_bytes(out, "use std::io;\n");
    buf_bytes(out, "use std::io::{BufReader, BufWriter, Write, writeln};\n");
    buf_bytes(out, "use std::process::Command;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn run(gpa: Gpa) -> io::Result<()> {\n");
    buf_bytes(out, "    let path = \"/tmp/vole-guide-files.txt\";\n");
    buf_bytes(out, "    {\n");
    buf_bytes(out, "        var w = BufWriter::new(File::create(path)?);\n");
    buf_bytes(out, "        for i in 1..4 {\n");
    buf_bytes(out, "            writeln(&w, f\"line {i}\")?;\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    var r = BufReader::new(File::open(path)?);\n");
    buf_bytes(out, "    var line = String::new_in(gpa);\n");
    buf_bytes(out, "    var total = 0;\n");
    buf_bytes(out, "    while r.read_line(&line)? > 0 {\n");
    buf_bytes(out, "        total += 1;\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    println(f\"{total} {line.lines().count()} {fs::metadata(path)?.len()}\");\n");
    buf_bytes(out, "    fs::remove_file(path)?;\n");
    buf_bytes(out, "    var c = Command::new(\"echo\");\n");
    buf_bytes(out, "    c.arg(\"hi\");\n");
    buf_bytes(out, "    let out = c.output_in(gpa)?;\n");
    buf_bytes(out, "    println(f\"{out.status.success()} {out.stdout.len()}\");\n");
    buf_bytes(out, "    match File::open(path) {\n");
    buf_bytes(out, "        Ok(_) => println(\"still there\"),\n");
    buf_bytes(out, "        Err(e) => println(f\"{e.kind():?}\"),\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    match run(gpa) {\n");
    buf_bytes(out, "        Ok(_) => 0,\n");
    buf_bytes(out, "        Err(e) => {\n");
    buf_bytes(out, "            eprintln(f\"{e}\");\n");
    buf_bytes(out, "            1\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "3 3 21\n");
    buf_bytes(out, "true 3\n");
    buf_bytes(out, "NotFound\n");
    buf_bytes(out, "```\n");
}
