// Generated by compiler/guide/embed.sh from compiler/guide/how.md (do
// not edit): the guide's topic 'how'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# How to add an X\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Recipes for the changes made again and again (0.17): the files, the\n");
    buf_bytes(out, "commands in order, the test, the docs. `volec guide how TASK` prints\n");
    buf_bytes(out, "one; `volec query examples KIND` prints the items to start from, and\n");
    buf_bytes(out, "`volec query similar NAME` the items like one you name (copy the\n");
    buf_bytes(out, "nearest). In the vole repository (commands from its root):\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `add-std-fn`: a std function or method\n");
    buf_bytes(out, "- `add-peephole`: an instruction-combining or e-graph rule\n");
    buf_bytes(out, "- `add-pass`: an optimization pass\n");
    buf_bytes(out, "- `add-diagnostic`: a compiler error, or a tool diagnostic with a code\n");
    buf_bytes(out, "- `add-test`: a test case\n");
    buf_bytes(out, "- `add-subcommand`: a `volec` command, or a `query` command\n");
    buf_bytes(out, "- `add-guide-text`: a paragraph or an example in the guide\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "In a program of your own:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `add-module`: a module (a file) to a program\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## add-std-fn\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "To add a std function or method.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "std is `compiler/std/`: the module `std` (`std.vl` and the files of\n");
    buf_bytes(out, "`flat/`) and its modules (`std::fmt` in `fmt.vl`, `std::collections::hash_map`\n");
    buf_bytes(out, "in `collections/hash_map.vl`); `compiler/std/embed.sh` builds it into the compiler (`compiler/src/front/stdsrc.vl`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "1. Find where it goes: `volec query similar std::trim` (or\n");
    buf_bytes(out, "   `Vec::swap`) prints its neighbours, with their files\n");
    buf_bytes(out, "   (`compiler/std/flat/io.vl:28`); `volec query examples std-fn`.\n");
    buf_bytes(out, "2. Add it by name, next to its kin:\n");
    buf_bytes(out, "   `volec edit insert --after std::trim < new.vl` (a method:\n");
    buf_bytes(out, "   `--after Vec::swap`). The edit is made in std's file and checked with\n");
    buf_bytes(out, "   the edited std, every function of it (a generic one with `i64` for\n");
    buf_bytes(out, "   its type parameters); then embed.sh runs (`note edit.std`). Inside\n");
    buf_bytes(out, "   std the prelude is as everywhere (0.17): `None`, `Ok(x)`. A function\n");
    buf_bytes(out, "   that allocates takes its allocator, `NAME_in(..., a: A)`, and has an\n");
    buf_bytes(out, "   `#[ambient]` wrapper without it, like `split_whitespace` and\n");
    buf_bytes(out, "   `split_whitespace_in`.\n");
    buf_bytes(out, "3. A test: `tests/run/std_NAME.vl` with `// EXPECT:` lines (edge\n");
    buf_bytes(out, "   cases: empty, too long, at the ends); see `add-test`.\n");
    buf_bytes(out, "4. The guide: a sentence and a `tach` example with its `out` block in\n");
    buf_bytes(out, "   `compiler/guide/std.md` (the API listing at its end is generated);\n");
    buf_bytes(out, "   `compiler/guide/embed.sh`.\n");
    buf_bytes(out, "5. `bootstrap/bootstrap.sh --dev` (the compiler with the new std), then\n");
    buf_bytes(out, "   `tests/run.sh std_NAME`, `tests/run.sh -O 0 std_NAME`,\n");
    buf_bytes(out, "   `tests/run.sh guide`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`volec undo` takes a std edit back (and embeds again).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## add-peephole\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "To add an instruction-combining or e-graph rule.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "An algebraic identity on constants and operations (`(x + c1) + c2`):\n");
    buf_bytes(out, "a line of `crate::middle::egraph::rule_text`, such as\n");
    buf_bytes(out, "`(neg (neg x)) => x` or `(mul x c1) if (pow2 c1) => (shl x (log2 c1))`;\n");
    buf_bytes(out, "the array's length and `RULE_COUNT` grow by one, in the same edit\n");
    buf_bytes(out, "(`volec edit patch rule_text --pairs FILE` with a `@@ RULE_COUNT`\n");
    buf_bytes(out, "block for the second target, or `volec edit apply`). `volec --check-rules` tests every rule on\n");
    buf_bytes(out, "random values (the suite runs it).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Anything else (a select, a negated comparison, an address): a function\n");
    buf_bytes(out, "`combine_X(v: i64) -> bool` in `compiler/src/middle/fold/mod.vl`,\n");
    buf_bytes(out, "section \"Instruction combining\", called from `combine` on the\n");
    buf_bytes(out, "instruction's op; true when it changed `v` (in place, or with\n");
    buf_bytes(out, "`replace_same_type`, `make_const`, `op_before`). Templates: `volec\n");
    buf_bytes(out, "query examples peephole`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Test: `tests/run/opt_NAME.vl`, a program with `// EXPECT:` and\n");
    buf_bytes(out, "`// CHECK:` / `// CHECK-NOT:` lines on the optimized IR (`--emit-ir`;\n");
    buf_bytes(out, "`tests/run/opt_egraph.vl`); `tests/run.sh opt_` at `-O 0`, `1`, `2`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## add-pass\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "To add an optimization pass.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "1. `volec edit new-file compiler/src/middle/NAME.vl < text` (adds\n");
    buf_bytes(out, "   the `mod` line): `pub fn NAME(fi: i64) -> bool`, true when it\n");
    buf_bytes(out, "   changed function `fi`. Templates: `volec query examples pass`\n");
    buf_bytes(out, "   (`elide_copies`, `thread_tags`).\n");
    buf_bytes(out, "2. Call it in `compiler/src/middle/opt.vl`: in `simplify_function`\n");
    buf_bytes(out, "   (scalar, -O1 and -O2) as `if round == 0 && NAME(fi) { verify_func(fi,\n");
    buf_bytes(out, "   c\"NAME\"); }`, or in `optimize_loops` (-O2) as `if NAME(fi) { changed =\n");
    buf_bytes(out, "   true; light_cleanup(fi); }`. `verify_func` checks the IR under\n");
    buf_bytes(out, "   `--verify-ir` and prints it under `--print-after-all`.\n");
    buf_bytes(out, "3. Test: `tests/run/opt_NAME.vl` with `// CHECK:` lines (see\n");
    buf_bytes(out, "   `add-peephole`); `tests/run.sh opt_`; `tests/fuzz/run.sh` (random\n");
    buf_bytes(out, "   programs at every level); `--time-passes` for its compile time.\n");
    buf_bytes(out, "4. Docs: the module table of `compiler/src/middle/README.md`,\n");
    buf_bytes(out, "   `docs/optimizer.md`. Before committing: `bootstrap/gate.sh --quick`\n");
    buf_bytes(out, "   (and `bench/run.sh`: no program may get slower).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## add-diagnostic\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "To add a compiler error, or a tool diagnostic with a code.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A compiler error (`error[type error] ... | help: ...`), where the\n");
    buf_bytes(out, "checker finds it: `err_begin(pos); err_str(c\"...\"); err_sym(name);\n");
    buf_bytes(out, "err_help(c\"try ...\"); err_end();` (`err_end_soft()` goes on checking).\n");
    buf_bytes(out, "Templates: `volec query examples diagnostic`. Test:\n");
    buf_bytes(out, "`tests/run/err_NAME.vl` with `// ERROR: text` lines, the help line\n");
    buf_bytes(out, "too (`// ERROR: help: ...`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A tool diagnostic (`error edit.not-source: ...` then `try:` lines):\n");
    buf_bytes(out, "`let d = diag(c\"error\", c\"tool.code\"); buf_str(d, c\"...\\n\");` then\n");
    buf_bytes(out, "`try_end(try_begin(c\"cmd\", name, true))`: a command that runs as it is\n");
    buf_bytes(out, "written. Then its `explain` entry: an `Explain { code, severity,\n");
    buf_bytes(out, "means, fix, example }` in `crate::tools::explain::tools_table::TOOLS_TABLE`\n");
    buf_bytes(out, "(or `refactor_table`), `TOOLS_COUNT` and the array's length one more,\n");
    buf_bytes(out, "in one `edit apply`; the Diagnostics table of `docs/query.md` or\n");
    buf_bytes(out, "`docs/refactor.md`. `tests/refactor/run.sh` fails on a code without an\n");
    buf_bytes(out, "entry. Test: a transcript (`tests/query/NAME.q`, `tests/refactor/NAME.t`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## add-test\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "To add a test case.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- A program: `tests/run/CATEGORY_NAME.vl` (the category is the name\n");
    buf_bytes(out, "  up to its first `_`: `std_`, `opt_`, `err_`...), or\n");
    buf_bytes(out, "  `tests/run/NAME/main.vl` for several modules. Directives in `//`\n");
    buf_bytes(out, "  comments: `EXPECT:` (stdout, a line each), `STDIN:`, `ARGS:`,\n");
    buf_bytes(out, "  `EXIT:`, `STDERR:`, `ERROR:` (compiling fails with that message),\n");
    buf_bytes(out, "  `CHECK:` / `CHECK-NOT:` (the IR), `FLAGS:`; the header of\n");
    buf_bytes(out, "  `tests/run.sh` lists them all. Cases compile with `--deny-warnings`.\n");
    buf_bytes(out, "- Run it: `tests/run.sh NAME` (cases whose name holds NAME), with\n");
    buf_bytes(out, "  `-O 0` and `-O 1` too.\n");
    buf_bytes(out, "- A tool: a transcript, `$ ARGS` lines and their output:\n");
    buf_bytes(out, "  `tests/query/NAME.q` (on `tests/query/NAME/main.vl`),\n");
    buf_bytes(out, "  `tests/refactor/NAME.t` (in a copy of `tests/refactor/NAME/`; `%`\n");
    buf_bytes(out, "  lines run shell commands); `tests/query/run.sh -u` writes what the\n");
    buf_bytes(out, "  commands print now (read the diff before keeping it).\n");
    buf_bytes(out, "- Templates: `volec query examples test`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## add-subcommand\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "To add a volec command, or a query command.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A command (`volec NAME ...`): `pub fn run_NAME(argc: i64, argv:\n");
    buf_bytes(out, "**u8) -> i64` (diagnostics with `diag`, written with `write_diags()`\n");
    buf_bytes(out, "before it returns), and its line in the chain of\n");
    buf_bytes(out, "`crate::tools::commands::run_command`: `if streq(word, c\"NAME\") {\n");
    buf_bytes(out, "return run_NAME(argc, argv); }` (`batch` runs it too). Its `--help`: a\n");
    buf_bytes(out, "`Help { cmd: \"NAME\", text: \"...\" }` row in `compiler/src/tools/help.vl`\n");
    buf_bytes(out, "(15 lines at most; `HELP_COUNT` and the array's length one more), and\n");
    buf_bytes(out, "the command in the list `tests/guide/run.sh` checks `--help` for.\n");
    buf_bytes(out, "Templates: `volec query examples subcommand` (`run_lint`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A query (`volec query NAME ...`): its name in `command_name`\n");
    buf_bytes(out, "(`N_COMMANDS` one more), its branch in `answer`, its line in\n");
    buf_bytes(out, "`put_usage` and in the `query` row of the help table; `volec query\n");
    buf_bytes(out, "examples query-command`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Docs: `docs/query.md` or `docs/refactor.md`, the tables of\n");
    buf_bytes(out, "`compiler/guide/tools.md` (then `compiler/guide/embed.sh`), the module\n");
    buf_bytes(out, "table of `compiler/src/tools/README.md`. Test: a transcript (`add-test`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## add-guide-text\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "To add a paragraph or an example in the guide.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The guide is `compiler/guide/TOPIC.md` (the topics and their order:\n");
    buf_bytes(out, "`compiler/guide/topics.txt`). An example is a `tach` block, then an\n");
    buf_bytes(out, "`out` block with what it prints (an `in` block before it: its stdin; an\n");
    buf_bytes(out, "`err` block: it must fail to compile); each is compiled and run.\n");
    buf_bytes(out, "`tests/guide/run.sh -f compiler/guide/TOPIC.md` checks one topic as you\n");
    buf_bytes(out, "write it; then `compiler/guide/embed.sh`, `bootstrap/bootstrap.sh --dev`\n");
    buf_bytes(out, "and `tests/run.sh guide`. The core topic has a budget (the test says).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## add-module\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "To add a module (a file) to a program.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "1. `volec edit new-file shapes.vl < text` writes the file and adds\n");
    buf_bytes(out, "   `mod shapes;` to its parent (`main.vl`); or `volec refactor\n");
    buf_bytes(out, "   new-module crate::shapes` for an empty one.\n");
    buf_bytes(out, "2. Items another module uses are `pub`; there they are named\n");
    buf_bytes(out, "   `crate::shapes::area` or imported: `use crate::shapes::{Shape,\n");
    buf_bytes(out, "   area};` (`volec fix --only imports` adds the lines a check asks\n");
    buf_bytes(out, "   for).\n");
    buf_bytes(out, "3. Items that should move there: `volec refactor move area Shape --to\n");
    buf_bytes(out, "   crate::shapes` (their uses and imports follow).\n");
    buf_bytes(out, "4. `volec check`; build with the root, `volec main.vl -o prog`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`volec guide modules` has the rules (paths, `pub`, `use`).\n");
}
