// Generated by compiler/guide/embed.sh from compiler/guide/threads.md (do
// not edit): the guide's topic 'threads'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Threads\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Threads, atomics, locks and channels (0.21; the design is\n");
    buf_bytes(out, "docs/design/concurrency.md). In 0.21.0 nothing checks yet what crosses\n");
    buf_bytes(out, "threads (Rust's `Send` and `Sync` come in 0.21.1), so starting a thread is\n");
    buf_bytes(out, "`unsafe`: the code vouches for what it shares. Everything else is safe.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Atomics\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`std::sync::atomic` has `Atomic<T>` for integers, `bool` and raw\n");
    buf_bytes(out, "pointers, with Rust's names as aliases (`AtomicI64`, `AtomicU32`,\n");
    buf_bytes(out, "`AtomicBool`, `AtomicPtr<T>`...) and Rust's methods: `load`, `store`,\n");
    buf_bytes(out, "`swap`, `compare_exchange` (`Ok(old)` or `Err(found)`), `fetch_add`,\n");
    buf_bytes(out, "`fetch_sub`, `fetch_and`, `fetch_or`, `fetch_xor`, `fetch_nand`,\n");
    buf_bytes(out, "`fetch_max`, `fetch_min`, `into_inner`, and `fence(order)`. The orderings\n");
    buf_bytes(out, "are C++'s (`Ordering::Relaxed`, `Acquire`, `Release`, `AcqRel`,\n");
    buf_bytes(out, "`SeqCst`); one an operation cannot have (a load with `Release`) is made\n");
    buf_bytes(out, "`SeqCst`. An atomic is move-only. A static one is written with its\n");
    buf_bytes(out, "field: `static mut HITS: AtomicI64 = AtomicI64 { v: 0 };`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::sync::atomic::{AtomicI64, Ordering};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() {\n");
    buf_bytes(out, "    let n = AtomicI64::new(5);\n");
    buf_bytes(out, "    let old = n.fetch_add(3, Ordering::Relaxed);\n");
    buf_bytes(out, "    let r = n.compare_exchange(8, 10, Ordering::AcqRel, Ordering::Acquire);\n");
    buf_bytes(out, "    println(f\"{old} {r.is_ok()} {n.load(Ordering::SeqCst)}\");\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "5 true 10\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "On AArch64 they are `ldar`/`stlr` and LSE's `ldadd`, `cas`, `swp`... on\n");
    buf_bytes(out, "macOS, exclusive-pair loops (`ldxr`/`stxr`) on Linux (`--atomics=lse` or\n");
    buf_bytes(out, "`--atomics=llsc` chooses). The optimizer moves no memory access across an\n");
    buf_bytes(out, "atomic or a fence, and invents no store to memory another thread may see.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Threads\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`std::thread::spawn(f)` runs the closure on a new thread; its handle's\n");
    buf_bytes(out, "`join()` waits and gives the result (a panic in any thread stops the\n");
    buf_bytes(out, "program, so there is no `Result` to unwrap). `thread::scope(|s| ...)`\n");
    buf_bytes(out, "joins every thread started with `s.spawn` before it returns, so those may\n");
    buf_bytes(out, "borrow the caller's values. Both are `unsafe fn`: what the closure\n");
    buf_bytes(out, "captures must be safe to use from another thread (no raw pointer or view\n");
    buf_bytes(out, "the caller still writes; no `static mut`: `query effects` shows `global`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::thread;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn sum(s: [i64]) -> i64 {\n");
    buf_bytes(out, "    let mut t = 0;\n");
    buf_bytes(out, "    for x in s { t += x; }\n");
    buf_bytes(out, "    t\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) {\n");
    buf_bytes(out, "    let mut v: Vec<i64> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    for i in 0..1000 { v.push(i); }\n");
    buf_bytes(out, "    let s = v.as_slice();\n");
    buf_bytes(out, "    let total = unsafe {\n");
    buf_bytes(out, "        thread::scope(|sc| {\n");
    buf_bytes(out, "            let a = sc.spawn(|| sum(s[0..500]));\n");
    buf_bytes(out, "            let b = sc.spawn(|| sum(s[500..]));\n");
    buf_bytes(out, "            a.join() + b.join()\n");
    buf_bytes(out, "        })\n");
    buf_bytes(out, "    };\n");
    buf_bytes(out, "    let h = unsafe { thread::spawn(move || v.len()) };\n");
    buf_bytes(out, "    println(f\"{total} {h.join()}\");\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "499500 1000\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`thread::yield_now()`, `thread::available_parallelism()`. Printing is safe\n");
    buf_bytes(out, "from any thread: once threads run, each print holds a lock, so lines do\n");
    buf_bytes(out, "not mix.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Mutex and channels\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`std::sync::Mutex<T>` owns its data: `m.with(|data| ...)` locks, runs the\n");
    buf_bytes(out, "closure and unlocks (`try_with` when the lock is free now). `std::sync::\n");
    buf_bytes(out, "mpsc::channel_in(gpa)` gives a `Sender` (clone it for more senders) and a\n");
    buf_bytes(out, "`Receiver`: `send(x)` fails, giving `x` back, when the receiver is gone;\n");
    buf_bytes(out, "`recv()` waits, and fails when every sender is gone and nothing is left;\n");
    buf_bytes(out, "`for x in rx.iter()` runs until then.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::thread;\n");
    buf_bytes(out, "use std::sync::{Mutex, mpsc};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) {\n");
    buf_bytes(out, "    let (tx, rx) = mpsc::channel_in::<i64>(gpa);\n");
    buf_bytes(out, "    let count = Mutex::new(0);\n");
    buf_bytes(out, "    let c = &count as *Mutex<i64>;\n");
    buf_bytes(out, "    let t = tx.clone();\n");
    buf_bytes(out, "    let h = unsafe { thread::spawn(move || {\n");
    buf_bytes(out, "        for i in 1..=10 {\n");
    buf_bytes(out, "            t.send(i).unwrap();\n");
    buf_bytes(out, "            (*c).with(|n| *n += 1);\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "        0\n");
    buf_bytes(out, "    }) };\n");
    buf_bytes(out, "    drop(tx);\n");
    buf_bytes(out, "    let mut total = 0;\n");
    buf_bytes(out, "    for x in rx.iter() { total += x; }\n");
    buf_bytes(out, "    h.join();\n");
    buf_bytes(out, "    println(f\"{total} {count.with(|n| *n)}\");\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "55 10\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`m.lock()` (unsafe in 0.21.0) gives a guard that unlocks when it is\n");
    buf_bytes(out, "dropped; `g.with(|data| ...)` reaches the data through it. The locks wait\n");
    buf_bytes(out, "on a futex (Linux) or `__ulock` (macOS). There is no poisoning.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Thread-locals\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`#[thread_local] static mut X: T = INIT;` gives each thread its own `X`,\n");
    buf_bytes(out, "made from `INIT` when the thread first uses it. Using one is safe; its\n");
    buf_bytes(out, "effect is `tls`, not `global`. A thread-local's drop does not run.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::thread;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[thread_local]\n");
    buf_bytes(out, "static mut CALLS: i64 = 0;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn work() -> i64 {\n");
    buf_bytes(out, "    for _ in 0..3 { CALLS += 1; }\n");
    buf_bytes(out, "    CALLS\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() {\n");
    buf_bytes(out, "    let h = unsafe { thread::spawn(move || work()) };\n");
    buf_bytes(out, "    CALLS = 100;\n");
    buf_bytes(out, "    println(f\"{h.join()} {CALLS}\");\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "3 100\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Effects\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Three effects (0.21): `sync` (an atomic, a fence, a lock, a join, a\n");
    buf_bytes(out, "channel), `thread` (starting a thread) and `tls` (a thread-local).\n");
    buf_bytes(out, "`query effects f` shows them; `#[pure]` excludes them.\n");
}
