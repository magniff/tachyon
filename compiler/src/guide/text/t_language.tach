// Generated by compiler/guide/embed.sh from compiler/guide/language.md (do
// not edit): the guide's topic 'language'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# The language, the long form (tachyon 0.17)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Tachyon is a compiled systems language. Its syntax is close to Rust's,\n");
    buf_bytes(out, "its model close to C's: structs, enums with exhaustive `match`, traits\n");
    buf_bytes(out, "and generics (monomorphized), modules, checked slices, raw pointers,\n");
    buf_bytes(out, "`unsafe`, exact C interop. There is no borrow checker, no lifetimes, no\n");
    buf_bytes(out, "destructors, no macros. Closures and iterators are new in 0.14; `?`,\n");
    buf_bytes(out, "f-strings, widening, `#[derive]`, named and default arguments in 0.15;\n");
    buf_bytes(out, "explicit allocation and effects in 0.16. Safe code has no undefined\n");
    buf_bytes(out, "behaviour. This text matches this compiler;\n");
    buf_bytes(out, "`tachyonc guide` is the short core of this text, `tachyonc guide TOPIC`\n");
    buf_bytes(out, "the detail (topics at the end); `tachyonc guide --full` prints this\n");
    buf_bytes(out, "topic with std's API in its place.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Build and run\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```sh\n");
    buf_bytes(out, "tachyonc hello.tach -o hello && ./hello   # executable (cc links it)\n");
    buf_bytes(out, "tachyonc hello.tach -o hello.o            # object; `-o x.s`: assembly\n");
    buf_bytes(out, "tachyonc check hello.tach                 # errors only, one per line\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    println(\"hello\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "hello\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`main` returns the exit status (`fn main()` with no result is 0).\n");
    buf_bytes(out, "`fn main(gpa: Gpa)` takes the program's allocator (below), `fn\n");
    buf_bytes(out, "main(argc: i32, argv: **u8, gpa: Gpa)` the arguments too. Several files\n");
    buf_bytes(out, "on the command line make one program; `mod name;` loads `name.tach`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Rust habits and what tachyon has instead\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| Rust | tachyon |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `String`, `&str` | `[u8]`, a byte slice: `\"text\"` is a `[u8]`; build text with `std::Buf`; `c\"text\"` is a NUL-terminated `*u8` for C |\n");
    buf_bytes(out, "| `&T`, `&mut T`, `Box<T>` | `&T`, `&mut T` (0.17): `&x`, `&mut x`, checked and safe; no lifetimes; `*T` is the raw pointer (a `*T` parameter is still taken as `&mut T`); no `Box` |\n");
    buf_bytes(out, "| `fn f(&self)`, `fn f(&mut self)` | `fn f(self: &T)`, `fn f(self: &mut T)` (0.17); `fn f(self: T)` takes the value (an owned one moves) |\n");
    buf_bytes(out, "| `use m::*;` | not allowed: `use m::{a, b};`, or the path `m::a` |\n");
    buf_bytes(out, "| `println!(\"{}\", x)`, `format!` | no macros: `println(f\"x = {x:>4} {v:?}\")`, `format_in(f\"..\", gpa)` (a `Buf`) (`guide formatting`) |\n");
    buf_bytes(out, "| `Vec::new()`, a global allocator | `Vec::new_in(gpa)`: nothing allocates without an allocator; `gpa` comes from `fn main(gpa: Gpa)`, passed down as a parameter (0.16, `guide allocators`) |\n");
    buf_bytes(out, "| `Box<T>`, arenas | a `Vec`; `arena_scope(gpa, \\|a\\| ..)` frees all it allocated at its end; `--check-alloc` traps a use after free |\n");
    buf_bytes(out, "| `const fn`, purity | `#[pure]`, `#[no_alloc]`: checked declarations; `tachyonc query effects f` (0.16, `guide effects`) |\n");
    buf_bytes(out, "| `v[i]` on a `Vec` | the same (0.17): `v[i]`, `v[i] = x`, `v[a..b]` index its slice, checked, also through a reference (`v: &mut Vec<i64>`); `v.get(i)`, `v.set(i, x)` too |\n");
    buf_bytes(out, "| closures, `.iter().map()` | the same (0.14): `v.iter().map(\\|x\\| x * k).sum()`; `F: Fn(i64) -> i64` bounds; no `dyn Fn`, `iter_mut` (`guide closures`, `guide iterators`) |\n");
    buf_bytes(out, "| `x?` | the same on `Option` and `Result` (0.15); `impl From<E> for F` converts the error; `main` may return `Result<(), E>` (`guide conversions`) |\n");
    buf_bytes(out, "| `impl Trait for T`, `T: Trait` | the same; `type Item;` associated types (0.14); `#[derive(Eq, Ord, Hash, Debug, Clone)]` (0.15); no `dyn`, `where`, supertraits |\n");
    buf_bytes(out, "| `Drop`, RAII | the same (0.17): values are dropped at the end of their scope; `impl Drop for T`, `drop(x)`, `std::forget(x)`; no `free` calls (`guide memory`) |\n");
    buf_bytes(out, "| `!x` on integers | `~x`; `!` is for `bool` only |\n");
    buf_bytes(out, "| `i64::MAX`, `x.abs()`, `x.pow(2)` | `i64::MAX`, `u8::MIN` the same (0.15); no methods on numbers: write the expression, or call C |\n");
    buf_bytes(out, "| overflow panics, `/ 0` panics | integers wrap; `x / 0 == 0`, `x % 0 == x`; no panic |\n");
    buf_bytes(out, "| `match s { \"add\" => ... }` | strings are not patterns: `if s == \"add\" { ... }` |\n");
    buf_bytes(out, "| `char` | none: `'a'` is a `u8` (one ASCII byte) |\n");
    buf_bytes(out, "| no default or named arguments | `fn f(a: i64, b: i64 = 2)`, `f(1, b: 3)` (0.15): named ones last, in order |\n");
    buf_bytes(out, "| `usize`, implicit `i32` -> `i64` | lengths and indices are `i64`; lossless widening (0.15), `a as i32` narrows |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The prelude, in every module without `use`: `Option`, `Some`, `None`,\n");
    buf_bytes(out, "`Result`, `Ok`, `Err`, `Vec`, `print`, `println`, `eprint`, `eprintln`,\n");
    buf_bytes(out, "`format_in`, `Gpa`, `Arena`, `ScopedArena`, `arena_scope`, and the traits\n");
    buf_bytes(out, "`Add`, `Sub`, `Mul`, `Div`, `Neg`, `Eq`, `Ord`, `Hash`, `Display`, `Debug`,\n");
    buf_bytes(out, "`Clone`, `From`, `Into`, `Allocator`. The rest of std is used by path\n");
    buf_bytes(out, "(`std::print_int(n)`) or imported (`use std::{Buf, HashMap};`).\n");
    buf_bytes(out, "Calling C or an `unsafe fn`, and dereferencing or indexing a raw\n");
    buf_bytes(out, "pointer, are allowed only in `unsafe { }` (`tachyonc guide rust`: the\n");
    buf_bytes(out, "full list).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Values and types\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let a = 42;               // i64: an integer literal is i64 unless the context says\n");
    buf_bytes(out, "let b: u8 = 255;          // i8 i16 i32 i64 u8 u16 u32 u64 isize usize\n");
    buf_bytes(out, "let c = 3u32;             // suffixes; 1_000, 0xff, 0b1010\n");
    buf_bytes(out, "let d = 2.5;              // f64; 2.5f32 is f32\n");
    buf_bytes(out, "let e = 'A';              // u8: a byte, ASCII only\n");
    buf_bytes(out, "let f = true;             // bool\n");
    buf_bytes(out, "let s = \"bytes\";          // [u8]: s.len() (or the field s.len, an i64), s[0], s[1..3]\n");
    buf_bytes(out, "let p = c\"for C\";         // *u8, NUL-terminated\n");
    buf_bytes(out, "let t = (1, \"two\");       // a tuple: t.0, t.1\n");
    buf_bytes(out, "let arr = [0; 8];         // [i64; 8]; also [1, 2, 3]; arr[i] is checked\n");
    buf_bytes(out, "let mut n = a as i32;     // `as` converts numbers; nothing converts implicitly\n");
    buf_bytes(out, "n += c as i32 + b as i32 + e as i32;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Bindings are immutable unless `mut`. Shadowing (`let x = x + 1;`) is\n");
    buf_bytes(out, "allowed. `const N: i64 = 10;` and `static mut COUNT: i64 = 0;` are items\n");
    buf_bytes(out, "(statics are safe to use: there are no threads). Integers wrap, `x / 0 ==\n");
    buf_bytes(out, "0`, `x % 0 == x`; indexing, slicing, `unwrap` and casts to enums are\n");
    buf_bytes(out, "checked (a message, exit 101): `guide types`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Functions and control flow\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn classify(n: i64) -> [u8] {\n");
    buf_bytes(out, "    if n < 0 { \"negative\" } else if n == 0 { \"zero\" } else { \"positive\" }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn greet(name: [u8], times: i64 = 1, sep: [u8] = \" \") {   // defaults (0.15)\n");
    buf_bytes(out, "    for _ in 0..times { print(f\"hi {name}{sep}\"); }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut total = 0;\n");
    buf_bytes(out, "    for i in 0..10 {              // 0..10 and 0..=9: ranges exist only in `for`\n");
    buf_bytes(out, "        if i % 2 == 0 { continue; }\n");
    buf_bytes(out, "        total += i;\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    let mut k = 0;\n");
    buf_bytes(out, "    while k < 3 { k += 1; }\n");
    buf_bytes(out, "    let found = loop {            // loop's value comes from `break value`\n");
    buf_bytes(out, "        k += 1;\n");
    buf_bytes(out, "        if k * k > 50 { break k; }\n");
    buf_bytes(out, "    };\n");
    buf_bytes(out, "    outer: for i in 0..5 {        // a label: `name:`, then `break :name`\n");
    buf_bytes(out, "        for j in 0..5 {\n");
    buf_bytes(out, "            if i * j == 6 { break :outer; }\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    greet(\"ann\");\n");
    buf_bytes(out, "    greet(\"bob\", times: 2, sep: \"! \");    // named arguments: last, in order\n");
    buf_bytes(out, "    println(classify(total - found));\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "hi ann hi bob! hi bob! positive\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The last expression of a block, without `;`, is its value; `if`, `match`,\n");
    buf_bytes(out, "`loop` and blocks are expressions. There are no nested functions.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Structs, enums, match, methods\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct Point { x: i64, y: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "enum Shape { Circle(Point, i64), Rect { min: Point, max: Point }, Empty }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Point {\n");
    buf_bytes(out, "    fn new(x: i64, y: i64) -> Point { Point { x: x, y: y } }   // Point::new(1, 2)\n");
    buf_bytes(out, "    fn shift(self: &mut Point, dx: i64) { self.x += dx; }       // writes through self\n");
    buf_bytes(out, "    fn sum(self: Point) -> i64 { self.x + self.y }              // a copy\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn area(s: Shape) -> i64 {\n");
    buf_bytes(out, "    match s {\n");
    buf_bytes(out, "        Shape::Circle(_, r) => 3 * r * r,\n");
    buf_bytes(out, "        Shape::Rect { min, max } => (max.x - min.x) * (max.y - min.y),\n");
    buf_bytes(out, "        Shape::Empty => 0,\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut p = Point::new(1, 2);\n");
    buf_bytes(out, "    p.shift(10);                          // passes &mut p\n");
    buf_bytes(out, "    let shapes = [Shape::Rect { min: Point::new(0, 0), max: p }, Shape::Circle(p, 2),\n");
    buf_bytes(out, "        Shape::Empty];\n");
    buf_bytes(out, "    for s in shapes {\n");
    buf_bytes(out, "        std::print_int(area(s));\n");
    buf_bytes(out, "        print(\" \");\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    std::print_int(p.sum());\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    let o: Option<i64> = Some(7);\n");
    buf_bytes(out, "    if let Some(v) = o { std::print_int(v); }\n");
    buf_bytes(out, "    match 15 {\n");
    buf_bytes(out, "        0 => println(\" zero\"),\n");
    buf_bytes(out, "        1..=9 => println(\" digit\"),\n");
    buf_bytes(out, "        n if n % 5 == 0 => println(\" fives\"),\n");
    buf_bytes(out, "        _ => println(\" other\"),\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "22 12 0 13\n");
    buf_bytes(out, "7 fives\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A variant's fields are by position (`Circle(Point, i64)`) or by name\n");
    buf_bytes(out, "(`Rect { min: Point, max: Point }`, 0.17: made as `Shape::Rect { min: a,\n");
    buf_bytes(out, "max }` in any order, matched as `Shape::Rect { min, .. }`; a variant's\n");
    buf_bytes(out, "fields are read only through patterns, as in Rust). A match must cover\n");
    buf_bytes(out, "every value; arms can have `|`, ranges `a..=b` and guards `if`. `use Shape::{Circle, Empty};` lets variants be written\n");
    buf_bytes(out, "without `Shape::`. `==` compares structs, enums, tuples and arrays field\n");
    buf_bytes(out, "by field; `[u8]` compares by bytes, a `Vec` or `HashMap` by contents.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Generics and traits\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "trait Area {\n");
    buf_bytes(out, "    fn area(self: &Self) -> i64;\n");
    buf_bytes(out, "    fn twice(self: &Self) -> i64 { 2 * self.area() }   // a default method\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "struct Square { side: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Area for Square {\n");
    buf_bytes(out, "    fn area(self: &Square) -> i64 { self.side * self.side }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn total<T: Area>(items: [T]) -> i64 {    // bounds: T: A + B\n");
    buf_bytes(out, "    items.iter().map(|it| it.area()).sum()\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "struct Pair<T> { a: T, b: T }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl<T: Ord> Pair<T> {\n");
    buf_bytes(out, "    fn max(self: &Pair<T>) -> T { if self.a > self.b { self.a } else { self.b } }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let squares = [Square { side: 2 }, Square { side: 3 }];\n");
    buf_bytes(out, "    let p = Pair::<i64> { a: 3, b: 9 };   // the turbofish: Pair::<i64>\n");
    buf_bytes(out, "    println(f\"{total(squares[..])} {squares[0].twice()} {p.max()}\");   // a[..]: a slice\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "13 8 9\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Generics are templates, checked per instantiation (`max::<i64>(a, b)`\n");
    buf_bytes(out, "is the turbofish). Operators go through the prelude's traits: `impl Add\n");
    buf_bytes(out, "for V` makes `a + b` work; `Ord`'s `cmp` gives `<`. There are no trait\n");
    buf_bytes(out, "objects: dispatch is static.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Modules and imports\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`mod geometry;` loads geometry.tach (or `mod geometry { ... }` inline);\n");
    buf_bytes(out, "`use geometry::{Rect, area};` imports by name, never `*`. Paths start\n");
    buf_bytes(out, "with a name in scope, `crate`, `self`, `super` or `std`. Items are\n");
    buf_bytes(out, "private (to their module and its children) unless `pub`; `pub use`\n");
    buf_bytes(out, "re-exports. A missing import's error says which `use` line to add, and\n");
    buf_bytes(out, "`tachyonc fix` adds it.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Slices, arrays, text\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn sum(xs: [i64]) -> i64 {\n");
    buf_bytes(out, "    let mut t = 0;\n");
    buf_bytes(out, "    for i in 0..xs.len { t += xs[i]; }    // indices are i64; checked\n");
    buf_bytes(out, "    t\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut a = [5, 1, 4];\n");
    buf_bytes(out, "    a[1] = 2;\n");
    buf_bytes(out, "    std::print_int(sum(a[..]) + sum(a[1..]));   // a[lo..hi], a[..hi], a[lo..]\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    let s = \"hello world\";\n");
    buf_bytes(out, "    println(s[6..]);\n");
    buf_bytes(out, "    if s[0..5] == \"hello\" { println(\"starts with hello\"); }\n");
    buf_bytes(out, "    let words = [0; 4];\n");
    buf_bytes(out, "    std::print_int(words[4]);             // out of bounds: a message, exit 101\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out (exit 101)\n");
    buf_bytes(out, "17\n");
    buf_bytes(out, "world\n");
    buf_bytes(out, "starts with hello\n");
    buf_bytes(out, "main.tach:16:20: index out of bounds: index 4, length 4\n");
    buf_bytes(out, "note: build with --trace for the line and its callers\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "An array `[T; N]` is a value (copied by `=`; `a.len()` is N); a slice\n");
    buf_bytes(out, "`[T]` is a pointer and a length (`.ptr`, `.len`, `.len()`) viewing an\n");
    buf_bytes(out, "array, a `Vec` or memory. A `[T]` is read-only; `&mut [T]`\n");
    buf_bytes(out, "(`&mut a[..]`, `v.as_mut_slice()`) writes its elements (0.17).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## std: Vec, HashMap, Buf; allocation\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn evens(n: i64, gpa: Gpa) -> Vec<i64> {  // it allocates: it takes an allocator\n");
    buf_bytes(out, "    (0..n).map(|i| i * 2).collect_in(gpa)\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {                 // the program's allocator\n");
    buf_bytes(out, "    let mut v: Vec<i64> = Vec::new_in(gpa);  // dropped (freed) when main returns\n");
    buf_bytes(out, "    v.push(30);\n");
    buf_bytes(out, "    v.push(10);\n");
    buf_bytes(out, "    v.push(20);\n");
    buf_bytes(out, "    sort(v.as_mut_slice());                // in place\n");
    buf_bytes(out, "    v.set(0, v.get(0) + 1);                // get/set are checked\n");
    buf_bytes(out, "    for x in v { std::print_int(x); print(\" \"); }   // also &v, v.iter()\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    let last = v.pop();                    // Option<i64>\n");
    buf_bytes(out, "    std::print_int(last.unwrap_or(-1));\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "    let mut m: HashMap<[u8], i64> = HashMap::new_in(gpa);\n");
    buf_bytes(out, "    m.insert(\"a\", 1);\n");
    buf_bytes(out, "    m.insert(\"b\", 2);\n");
    buf_bytes(out, "    match m.get(\"a\") { Some(x) => std::print_int(x), None => print(\"none\") }\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    for (k, _) in m.iter() { print(k); }   // (K, V) pairs, in slot order\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "    let mut b = Buf::new_in(gpa);          // text builder\n");
    buf_bytes(out, "    let e = evens(4, gpa);\n");
    buf_bytes(out, "    b.push_str(\"n=\");\n");
    buf_bytes(out, "    b.push_int(m.len() + e.len());\n");
    buf_bytes(out, "    b.push('!');\n");
    buf_bytes(out, "    println(b.as_slice());\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "11 20 30\n");
    buf_bytes(out, "30\n");
    buf_bytes(out, "1\n");
    buf_bytes(out, "ab\n");
    buf_bytes(out, "n=6!\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Allocation is explicit (0.16): nothing allocates without an allocator.\n");
    buf_bytes(out, "A function that allocates takes one, `gpa: Gpa` or `a: A` with `A:\n");
    buf_bytes(out, "Allocator`, or a container it was given (`push` uses the Vec's own);\n");
    buf_bytes(out, "main's `gpa` is where they come from. `arena_scope(gpa, |a| ...)` hands out\n");
    buf_bytes(out, "an arena whose memory is all freed when the closure returns.\n");
    buf_bytes(out, "`--check-alloc` builds the program with a checking allocator: a use\n");
    buf_bytes(out, "after free, a double free, a leak are reported where they happen.\n");
    buf_bytes(out, "`tachyonc fix --only alloc016` moves 0.15 code (`Vec::new()`) over.\n");
    buf_bytes(out, "Every function's effects are inferred (`alloc(Gpa) io global panic\n");
    buf_bytes(out, "diverge unsafe`): `tachyonc query effects f --why io` shows where;\n");
    buf_bytes(out, "`#[pure]` or `#[no_alloc]` on a function is checked (`guide effects`,\n");
    buf_bytes(out, "`guide allocators`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`Vec`, `Buf` and `HashMap` own their contents: `let w = v;` or passing\n");
    buf_bytes(out, "one by value moves it (`.clone()` copies). Pass `&v` to a `&Vec<T>`\n");
    buf_bytes(out, "parameter to read it, `&mut v` to a `&mut Vec<T>` one to let a function\n");
    buf_bytes(out, "push. A slice from `as_slice` views the vector: using it after the\n");
    buf_bytes(out, "vector grew or was dropped is an error (`guide views`). std's API,\n");
    buf_bytes(out, "made from its source in this compiler, a\n");
    buf_bytes(out, "line per item: `tachyonc guide std#the-api`; each item with its comment:\n");
    buf_bytes(out, "`tachyonc guide std#every-item`; one name: `tachyonc guide --find NAME`.\n");
    buf_bytes(out, "@STD-API-FULL@\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Input, output, arguments\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "std prints and reads stdin: `read_stdin_in(gpa)` (all of it, a\n");
    buf_bytes(out, "`Result<Buf, IoError>`), `read_line(&buf)` (the next line, without its\n");
    buf_bytes(out, "`'\\n'`; `Ok(false)` at the end), `Scanner` (tokens, numbers, lines of a\n");
    buf_bytes(out, "text), `parse_int` (a `Result`), `split_in`, `trim` (`guide conversions`:\n");
    buf_bytes(out, "Option means absent, Result failed). Files go through C (`fopen`):\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "import \"string.h\" as c;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(argc: i32, argv: **u8, gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let input = read_stdin_in(gpa).unwrap(); // all of stdin, a Buf\n");
    buf_bytes(out, "    let mut sc = Scanner::new(input.as_slice());\n");
    buf_bytes(out, "    let mut total = 0;\n");
    buf_bytes(out, "    while let Ok(n) = sc.next_int() {     // Err(ScanError::End) at the end\n");
    buf_bytes(out, "        total += n;\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    println(total);\n");
    buf_bytes(out, "    for k in 1..argc as i64 {             // argv[0] is the program; C strings\n");
    buf_bytes(out, "        println(unsafe { argv[k][0..c::strlen(argv[k]) as i64] });\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```in\n");
    buf_bytes(out, "12\n");
    buf_bytes(out, "30\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "42\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## unsafe and C\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "import \"stdio.h\" as c;                   // a C header, its names under c::\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "extern \"C\" {                              // or declare C functions yourself\n");
    buf_bytes(out, "    fn abs(x: i32) -> i32;\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    unsafe { c::printf(c\"%.1f %d\\n\", 2.5 * 2.0, abs(-3)); }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "5.0 3\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Unsafe operations: calling C or an `unsafe fn`, dereferencing (`*p`,\n");
    buf_bytes(out, "`p.f`) or indexing (`p[i]`) a raw pointer, reading a union field. A\n");
    buf_bytes(out, "reference (`&T`, `&mut T`) is safe to read and write through wherever\n");
    buf_bytes(out, "it is kept, and so is a `*T` parameter (taken as `&mut T` in 0.17); any\n");
    buf_bytes(out, "other `*T` (a local or field of that type, a C result) is raw.\n");
    buf_bytes(out, "`tachyonc fix --only unsafe` wraps what needs it; `#[repr(C)]`, callbacks\n");
    buf_bytes(out, "and linking: `guide c-interop`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Errors you will meet first\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| error (short form) | fix |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `unknown type 'String'` (or `char`, `Box`) | `[u8]`, `u8`, `*T` or `Vec<T>` |\n");
    buf_bytes(out, "| `expected type, got '&'`; `expected identifier, got '&'` | `[u8]` for `&str`; `self: &T`, `self: &mut T` or `self: *T` |\n");
    buf_bytes(out, "| `cannot infer the type of closure parameter 'x'` | `\\|x: i64\\| ...`, or pass it where an `Fn` bound or `fn` type gives it |\n");
    buf_bytes(out, "| `'?' needs 'f' to return Option or Result` | `fn f(..) -> Option<T>` or `-> Result<T, E>` |\n");
    buf_bytes(out, "| `'println!' is a macro call` | no macros: `println(f\"{x}\")` |\n");
    buf_bytes(out, "| `cannot assign to immutable variable 'x'` | `let mut x` |\n");
    buf_bytes(out, "| `cannot index type 'HashMap<K, V>'` | `m.get(k)` (an Option), `m.insert(k, v)` |\n");
    buf_bytes(out, "| `allocation is explicit: pass an allocator (try: Vec::new_in(gpa))` | `fn main(gpa: Gpa)`, `gpa` passed down; `tachyonc fix --only alloc016` |\n");
    buf_bytes(out, "| `'for' iterates over ... got 'i64'` | a range: `for x in 0..n`; a Vec, a HashMap, `v.iter()` and ranges as values iterate too (0.14) |\n");
    buf_bytes(out, "| `expected '[i64]', got '[i64; 3]'` | pass `a[..]` |\n");
    buf_bytes(out, "| `expected 'i32', got 'i64'` | `x as i32`: only widening is implicit |\n");
    buf_bytes(out, "| `cannot take address of non-lvalue expression` | `&` needs a place: `let p = P { x: 1 }; f(&p)` |\n");
    buf_bytes(out, "| `non-exhaustive match: 'E::C' is not covered` | an arm, or `_ =>` |\n");
    buf_bytes(out, "| `error[unsafe] calling a C function is unsafe` | `unsafe { ... }` |\n");
    buf_bytes(out, "| `undefined variable 'helper' \\| help: add 'use ...'` | add the `use` line the help names |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc guide errors` has more, each with its fix.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Tools: read and change code through the compiler\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```sh\n");
    buf_bytes(out, "tachyonc check [ROOT]                   # all errors, one line each: FILE:L:C: error[KIND] MSG | help: ...\n");
    buf_bytes(out, "tachyonc f.tach -o f                    # the same lines when compiling, off a terminal\n");
    buf_bytes(out, "tachyonc query show NAME                # an item's source: fn, Type::method, Enum::Variant, FILE:LINE\n");
    buf_bytes(out, "tachyonc query def NAME                 # where it is defined, its signature\n");
    buf_bytes(out, "tachyonc query refs NAME                # every resolved use (--count, --in FILE)\n");
    buf_bytes(out, "tachyonc query items [MODULE]           # a module's items with signatures (std: its API)\n");
    buf_bytes(out, "tachyonc query context NAME             # source, what it calls, its types and callers, at once\n");
    buf_bytes(out, "tachyonc query effects NAME             # what it may do: alloc(Gpa) io global panic diverge unsafe\n");
    buf_bytes(out, "tachyonc try '7 / 2'                    # run a snippet with std: its output, TYPE = VALUE\n");
    buf_bytes(out, "tachyonc edit patch NAME --old 'a < b' --new 'a <= b'   # change text inside one item\n");
    buf_bytes(out, "tachyonc edit replace NAME < new.tach   # replace an item; edit insert --after NAME; edit delete NAME\n");
    buf_bytes(out, "tachyonc fix                            # missing imports, unused, pub, unsafe blocks\n");
    buf_bytes(out, "tachyonc undo                           # take the last edit back\n");
    buf_bytes(out, "tachyonc refactor rename main::x total  # a local (or FILE:LINE:COL), an item, a field, with every use\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "They pay off on renames, moves, signature changes, errors across files\n");
    buf_bytes(out, "and large code; a small file is cheaper read whole (`query show\n");
    buf_bytes(out, "FILE.tach`). ROOT is `--root FILE`, a last argument ending in `.tach`,\n");
    buf_bytes(out, "or `./main.tach`. Every edit is checked first: one that adds an error\n");
    buf_bytes(out, "writes nothing. A problem is one line, `error CODE: message`, then\n");
    buf_bytes(out, "`try:` lines to run as they are (`guide tools`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Topics\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc guide TOPIC` prints one; `tachyonc guide --list` gives their\n");
    buf_bytes(out, "sizes; `tachyonc guide --all` prints everything.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "@TOPICS@\n");
}
