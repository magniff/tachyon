// Generated by compiler/guide/embed.sh from compiler/guide/c-interop.md (do
// not edit): the guide's topic 'c-interop'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# C interop\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "C compatibility is asked for explicitly and then exact. Tachyon's own\n");
    buf_bytes(out, "types and functions have no fixed layout or convention; `#[repr(C)]`\n");
    buf_bytes(out, "types and `extern \"C\"` functions have C's, for the target.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Calling C\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Import a header (its names are reached through the `as` name; every\n");
    buf_bytes(out, "header of a program shares one C module, so one name serves them all),\n");
    buf_bytes(out, "or declare the functions yourself. Every call is `unsafe`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "import \"stdio.h\" as c;\n");
    buf_bytes(out, "import \"string.h\" as c;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "extern \"C\" {\n");
    buf_bytes(out, "    fn getenv(name: *u8) -> *u8;          // declared by hand\n");
    buf_bytes(out, "    #[link_name = \"strlen\"]\n");
    buf_bytes(out, "    fn c_length(s: *u8) -> u64;           // another name for a C symbol\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let s = c\"tachyon\";\n");
    buf_bytes(out, "    let n = unsafe { c::strlen(s) } as i64;\n");
    buf_bytes(out, "    let home = unsafe { getenv(c\"NO_SUCH_VARIABLE_HERE\") };\n");
    buf_bytes(out, "    unsafe {\n");
    buf_bytes(out, "        c::printf(c\"%s has %ld bytes, %d %.3f\\n\", s, n, home == 0 as *u8, 1.0 / 8.0);\n");
    buf_bytes(out, "        c::printf(c\"%lu\\n\", c_length(c\"abc\"));\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "tachyon has 7 bytes, 1 0.125\n");
    buf_bytes(out, "3\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `c\"...\"` is a NUL-terminated `*u8`, for C. A `[u8]` slice (`\"...\"`) is\n");
    buf_bytes(out, "  not terminated: pass `s.ptr` and `s.len` to C (`write(1, s.ptr,\n");
    buf_bytes(out, "  s.len as u64)`), or copy into a buffer with a 0 at the end.\n");
    buf_bytes(out, "- A C string to a slice: `unsafe { p[0..c::strlen(p) as i64] }`.\n");
    buf_bytes(out, "- Variadic functions (`printf`) take any FFI-safe value; `%ld` for `i64`,\n");
    buf_bytes(out, "  `%d` for `i32` and `bool`, `%f` for `f64` (and `f32`), `%s` for `*u8`.\n");
    buf_bytes(out, "- Types from C: `int` is `i32`, `long` is `i64`, `char *` and `void *`\n");
    buf_bytes(out, "  are `*u8`, `size_t` is `u64`, structs are `#[repr(C)]` structs, enums\n");
    buf_bytes(out, "  are integer types with constants. `tachyonc --emit-imports prog.tach\n");
    buf_bytes(out, "  -o decls.tach` shows what a program's headers declare.\n");
    buf_bytes(out, "- What headers cannot give: function-like macros, `static inline`\n");
    buf_bytes(out, "  functions, `errno` (call `__error()` on macOS, `__errno_location()` on\n");
    buf_bytes(out, "  Linux).\n");
    buf_bytes(out, "- `-I DIR` adds an include directory; `import \"./mine.h\" as c;` is\n");
    buf_bytes(out, "  relative to the importing file.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Layout: #[repr(C)]\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "#[repr(C)]\n");
    buf_bytes(out, "struct Header { tag: u8, size: u32 }          // C's field order and padding\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[repr(C, packed)]\n");
    buf_bytes(out, "struct Packed { tag: u8, size: u32 }          // no padding\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[repr(C)]\n");
    buf_bytes(out, "union Bits { i: u32, f: f32 }                 // reading a field is unsafe\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[repr(u8)]\n");
    buf_bytes(out, "enum Kind { A = 1, B = 2 }                    // an enum with a u8 tag\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let b = Bits { f: 1.0 };\n");
    buf_bytes(out, "    std::print_int(size_of(Header) + size_of(Packed) + size_of(Kind));\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    std::print_int(unsafe { b.i } as i64);\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "14 1065353216\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Also `#[repr(C, align(N))]` and `#[repr(C, packed(N))]`. A `#[repr(C)]`\n");
    buf_bytes(out, "enum with fields is C's struct of a tag and a union. Types in `extern\n");
    buf_bytes(out, "\"C\"` signatures must be FFI-safe: numbers, `bool`, pointers, `extern\n");
    buf_bytes(out, "\"C\" fn` pointers, `#[repr(C)]` types. Slices, tuples, plain structs and\n");
    buf_bytes(out, "plain `fn` pointers are rejected with a hint.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## C calling tachyon\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`extern \"C\" fn` defines a function with C's convention and an unmangled\n");
    buf_bytes(out, "symbol; only such a function is a C callback (a plain `fn` is another\n");
    buf_bytes(out, "type).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "import \"stdlib.h\" as c;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "extern \"C\" fn by_value(a: *u8, b: *u8) -> i32 {\n");
    buf_bytes(out, "    let x = unsafe { *(a as *i32) };\n");
    buf_bytes(out, "    let y = unsafe { *(b as *i32) };\n");
    buf_bytes(out, "    if x < y { -1 } else if x > y { 1 } else { 0 }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut a: [i32; 5] = [4, 2, 5, 1, 3];\n");
    buf_bytes(out, "    unsafe { c::qsort(&a as *u8, 5, 4, by_value); }\n");
    buf_bytes(out, "    for x in a { std::print_int(x as i64); }\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "12345\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`extern \"C\" static mut COUNT: i64 = 0;` defines a static C can use.\n");
    buf_bytes(out, "`tachyonc --emit-header prog.tach -o prog.h` writes the C header of a\n");
    buf_bytes(out, "program's `extern \"C\"` functions and statics, with the `#[repr(C)]`\n");
    buf_bytes(out, "types they use.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Building with C\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc prog.tach -o prog` links with `cc` (`$TACHYON_CC` instead).\n");
    buf_bytes(out, "For other libraries or C files, make an object and link it yourself:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```sh\n");
    buf_bytes(out, "tachyonc prog.tach -o prog.o && cc prog.o helper.c -o prog -lm\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Reading stdin: std has `read_line` and `read_stdin` (`tachyonc guide\n");
    buf_bytes(out, "std`); from C, `getchar()` from `stdio.h`, or `read(0, buf, n)` from\n");
    buf_bytes(out, "`unistd.h`, into a `Buf` or an array (not mixed with std's, which\n");
    buf_bytes(out, "buffers):\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "import \"stdio.h\" as c;\n");
    buf_bytes(out, "use std::Buf;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut line = Buf::new();\n");
    buf_bytes(out, "    defer line.free();\n");
    buf_bytes(out, "    loop {\n");
    buf_bytes(out, "        let ch = unsafe { c::getchar() };\n");
    buf_bytes(out, "        if ch < 0 || ch == '\\n' as i32 { break; }\n");
    buf_bytes(out, "        line.push(ch as u8);\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    print(\"read \");\n");
    buf_bytes(out, "    std::print_int(line.len());\n");
    buf_bytes(out, "    println(\" bytes\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "read 0 bytes\n");
    buf_bytes(out, "```\n");
}
