// Generated by compiler/guide/embed.sh from compiler/guide/threads.md (do
// not edit): the guide's topic 'threads'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Threads\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Threads, atomics, locks and channels (0.21; the design is\n");
    buf_bytes(out, "docs/design/concurrency.md). Safe code cannot make a data race: what\n");
    buf_bytes(out, "crosses threads is checked where a thread starts, from the types (Rust's\n");
    buf_bytes(out, "`Send` and `Sync`, inferred) and the effects (no `static var` on another\n");
    buf_bytes(out, "thread). The errors are `sync.*` (`volec explain sync.global`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Atomics\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`std::sync::atomic` has `Atomic<T>` for integers, `bool` and raw\n");
    buf_bytes(out, "pointers, with Rust's names as aliases (`AtomicI64`, `AtomicU32`,\n");
    buf_bytes(out, "`AtomicBool`, `AtomicPtr<T>`...) and Rust's methods: `load`, `store`,\n");
    buf_bytes(out, "`swap`, `compare_exchange` (`Ok(old)` or `Err(found)`), `fetch_add`,\n");
    buf_bytes(out, "`fetch_sub`, `fetch_and`, `fetch_or`, `fetch_xor`, `fetch_nand`,\n");
    buf_bytes(out, "`fetch_max`, `fetch_min`, `into_inner`, and `fence(order)`. The orderings\n");
    buf_bytes(out, "are C++'s (`Ordering::Relaxed`, `Acquire`, `Release`, `AcqRel`,\n");
    buf_bytes(out, "`SeqCst`); one an operation cannot have (a load with `Release`) is made\n");
    buf_bytes(out, "`SeqCst`. An atomic is move-only. A static one needs no `var` (and so has\n");
    buf_bytes(out, "no `global`): `static HITS: AtomicI64 = AtomicI64 { v: 0 };`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::sync::atomic::{AtomicI64, Ordering};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() {\n");
    buf_bytes(out, "    let n = AtomicI64::new(5);\n");
    buf_bytes(out, "    let old = n.fetch_add(3, Ordering::Relaxed);\n");
    buf_bytes(out, "    let r = n.compare_exchange(8, 10, Ordering::AcqRel, Ordering::Acquire);\n");
    buf_bytes(out, "    println(f\"{old} {r.is_ok()} {n.load(Ordering::SeqCst)}\");\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "5 true 10\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "On AArch64 they are `ldar`/`stlr` and LSE's `ldadd`, `cas`, `swp`... on\n");
    buf_bytes(out, "macOS, exclusive-pair loops (`ldxr`/`stxr`) on Linux (`--atomics=lse` or\n");
    buf_bytes(out, "`--atomics=llsc` chooses). The optimizer moves no memory access across an\n");
    buf_bytes(out, "atomic or a fence, and invents no store to memory another thread may see.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Threads\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`std::thread::spawn(sink || ...)` runs the closure on a new thread; its\n");
    buf_bytes(out, "handle's `join()` waits and gives the result (a panic in any thread stops\n");
    buf_bytes(out, "the program, so there is no `Result` to unwrap). The closure is a `sink`\n");
    buf_bytes(out, "one: the thread may outlive the caller, so it takes owned values (a Vec\n");
    buf_bytes(out, "moves in), no views (`sync.borrow_escapes`) and no raw pointers\n");
    buf_bytes(out, "(`sync.not_send`). `thread::scope(|s| ...)` joins every thread started\n");
    buf_bytes(out, "with `s.spawn` before it returns, so those may use the caller's values\n");
    buf_bytes(out, "and views; while the scope runs its closure changes nothing they use\n");
    buf_bytes(out, "(`sync.scope_write`), and a scoped thread only reads what it is given\n");
    buf_bytes(out, "(`sync.scope_shared_write`: return results through `join`, or use a Mutex\n");
    buf_bytes(out, "or an atomic). No thread may reach a `static var` (`sync.global`; `query\n");
    buf_bytes(out, "effects FILE:LINE --why global` shows the chain); printing is fine.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::thread;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn sum(s: [i64]) -> i64 {\n");
    buf_bytes(out, "    var t = 0;\n");
    buf_bytes(out, "    for x in s { t += x; }\n");
    buf_bytes(out, "    t\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) {\n");
    buf_bytes(out, "    var v: Vec<i64> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    for i in 0..1000 { v.push(i); }\n");
    buf_bytes(out, "    let s = v.as_slice();\n");
    buf_bytes(out, "    let total = thread::scope(|sc| {\n");
    buf_bytes(out, "        let a = sc.spawn(|| sum(s[0..500]));\n");
    buf_bytes(out, "        let b = sc.spawn(|| sum(s[500..]));\n");
    buf_bytes(out, "        a.join() + b.join()\n");
    buf_bytes(out, "    });\n");
    buf_bytes(out, "    let h = thread::spawn(sink || v.len());\n");
    buf_bytes(out, "    println(f\"{total} {h.join()}\");\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "499500 1000\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`thread::yield_now()`, `thread::available_parallelism()`. Printing is safe\n");
    buf_bytes(out, "from any thread: once threads run, each print holds a lock, so output\n");
    buf_bytes(out, "never interleaves.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Mutex, Once, Condvar and channels\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`std::sync::Mutex<T>` owns its data: `m.with(|data| ...)` locks, runs the\n");
    buf_bytes(out, "closure and unlocks (`try_with` when the lock is free now), the way to\n");
    buf_bytes(out, "reach the data in 0.21.0. Scoped threads share the Mutex (and an atomic). `m.lock()` gives a guard that unlocks when dropped, but it is\n");
    buf_bytes(out, "`unsafe` and internal until a type holding a view may implement Drop\n");
    buf_bytes(out, "(0.21.x): nothing keeps the guard inside the mutex's life yet. `Once`'s\n");
    buf_bytes(out, "`call_once(f)` runs f once whatever the threads; `Condvar`'s\n");
    buf_bytes(out, "`wait_then(m, ready, then)` sleeps until `ready(data)`, then runs `then`\n");
    buf_bytes(out, "under the lock (`notify_one`, `notify_all`). There is no poisoning.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`std::sync::mpsc::channel_in(gpa)` gives a `Sender` (clone it for more\n");
    buf_bytes(out, "senders) and a `Receiver`: `send(x)` fails, giving `x` back, when the\n");
    buf_bytes(out, "receiver is gone; `recv()` waits, and fails when every sender is gone and\n");
    buf_bytes(out, "nothing is left; `for x in rx.iter()` runs until then.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::thread;\n");
    buf_bytes(out, "use std::sync::{Mutex, mpsc};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) {\n");
    buf_bytes(out, "    let count = Mutex::new(0);\n");
    buf_bytes(out, "    let total = thread::scope(|s| {\n");
    buf_bytes(out, "        let (tx, rx) = mpsc::channel_in::<i64>(gpa);\n");
    buf_bytes(out, "        s.spawn(sink || {\n");
    buf_bytes(out, "            for i in 1..=10 { tx.send(i).unwrap(); }\n");
    buf_bytes(out, "            0\n");
    buf_bytes(out, "        });\n");
    buf_bytes(out, "        s.spawn(|| {\n");
    buf_bytes(out, "            for _ in 0..10 { count.with(|n| n += 1); }\n");
    buf_bytes(out, "            0\n");
    buf_bytes(out, "        });\n");
    buf_bytes(out, "        var sum = 0;\n");
    buf_bytes(out, "        for x in rx.iter() { sum += x; }\n");
    buf_bytes(out, "        sum\n");
    buf_bytes(out, "    });\n");
    buf_bytes(out, "    println(f\"{total} {count.with(|n| n)}\");\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "55 10\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The locks wait on a futex (Linux) or `__ulock` (macOS).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Thread-locals\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`#[thread_local] static var X: T = INIT;` gives each thread its own `X`,\n");
    buf_bytes(out, "made from `INIT` when the thread first uses it. Using one is safe; its\n");
    buf_bytes(out, "effect is `tls`, not `global`. A thread-local's drop does not run.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::thread;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[thread_local]\n");
    buf_bytes(out, "static var CALLS: i64 = 0;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn work() -> i64 {\n");
    buf_bytes(out, "    for _ in 0..3 { CALLS += 1; }\n");
    buf_bytes(out, "    CALLS\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() {\n");
    buf_bytes(out, "    let h = thread::spawn(sink || work());\n");
    buf_bytes(out, "    CALLS = 100;\n");
    buf_bytes(out, "    println(f\"{h.join()} {CALLS}\");\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "3 100\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Effects\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Three effects (0.21): `sync` (an atomic, a fence, a lock, a join, a\n");
    buf_bytes(out, "channel), `thread` (starting a thread) and `tls` (a thread-local).\n");
    buf_bytes(out, "`query effects f` shows them; `#[pure]` excludes them.\n");
}
