// Generated by compiler/guide/embed.sh from compiler/guide/debug.md (do
// not edit): the guide's topic 'debug'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Debugging\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`query` and `edit` answer where code is and how to change it. These\n");
    buf_bytes(out, "tools answer what the program does: where it failed, which values a line\n");
    buf_bytes(out, "saw, which part of an input matters. None of them edits the source.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## The recipe\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "1. Make the failure a test case: the input in `tests/NAME.in`, the\n");
    buf_bytes(out, "   output it should give in `tests/NAME.out`. Then run `tachyonc test\n");
    buf_bytes(out, "   NAME`. Tests are built with `--trace`. A crash prints its line and\n");
    buf_bytes(out, "   the calls that led to it, and a hang stopped by `--timeout S` prints\n");
    buf_bytes(out, "   where it was running. For one run without a case: `tachyonc test\n");
    buf_bytes(out, "   --input FILE`.\n");
    buf_bytes(out, "2. Read the trace. Its first frame, `FILE:LINE  function`, is the\n");
    buf_bytes(out, "   failing statement. `tachyonc query show FILE:LINE` prints its item.\n");
    buf_bytes(out, "3. See the values without editing:\n");
    buf_bytes(out, "   `tachyonc probe FILE:LINE EXPR... --input FILE`. Probe the lines\n");
    buf_bytes(out, "   above the failure, then the callers in the trace. `--count FILE:LINE`\n");
    buf_bytes(out, "   says how often a line runs (a loop that never ends, a branch never\n");
    buf_bytes(out, "   taken).\n");
    buf_bytes(out, "4. If the input is too big to reason about, shrink it:\n");
    buf_bytes(out, "   `tachyonc reduce FILE --until 'CMD'`.\n");
    buf_bytes(out, "5. Fix the bug (`edit patch`), then run `tachyonc test` again. In the\n");
    buf_bytes(out, "   tachyon tree, each failing case is also run with\n");
    buf_bytes(out, "   `target/tools/tachyonc`. A case that fails there too\n");
    buf_bytes(out, "   (`failing too`) was not broken by your change.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Failure traces\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc FILE.tach --trace -o prog` builds with a shadow stack: each\n");
    buf_bytes(out, "function's frame records the statement it is running. A failed check\n");
    buf_bytes(out, "prints the frames, innermost first:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "index out of bounds: index 0, length 0\n");
    buf_bytes(out, "trace, innermost call first:\n");
    buf_bytes(out, "  stats.tach:44  stats::best\n");
    buf_bytes(out, "  main.tach:25  main\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The first frame is the line of the failing index (or `unwrap`, `panic`).\n");
    buf_bytes(out, "The frames below it are the calls that led there, each at the line of its\n");
    buf_bytes(out, "call. A program stopped by SIGALRM (`tachyonc test --timeout`), SIGINT,\n");
    buf_bytes(out, "SIGTERM or SIGSEGV prints `stopped by signal N` and the frames. A loop\n");
    buf_bytes(out, "without calls shows its own line.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`--trace` builds at -O1 or -O2 (with -O0, at -O1). It costs a few\n");
    buf_bytes(out, "instructions per call and per loop iteration: the compiler runs about\n");
    buf_bytes(out, "25% slower when built with it, and its binary is larger. Without\n");
    buf_bytes(out, "`--trace`, a failure is one line, its position and message:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let v = [1, 2, 3];\n");
    buf_bytes(out, "    let i = v.len() as i64;\n");
    buf_bytes(out, "    std::print_int(v[i]);\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out (exit 101)\n");
    buf_bytes(out, "main.tach:4:20: index out of bounds: index 3, length 3\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc test` builds with `--trace` (`--no-trace` turns it off). A\n");
    buf_bytes(out, "failing case shows the first lines of its stderr, so the trace appears\n");
    buf_bytes(out, "in the summary.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## probe\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "$ tachyonc probe stats.tach:46 i m 'v[i]' --input tests/ok.in\n");
    buf_bytes(out, "probe stats.tach:46 (before `if v[i] > m {`): 2 times\n");
    buf_bytes(out, "  #1  i = 1  m = 3  v[i] = 7\n");
    buf_bytes(out, "  #2  i = 1  m = 3  v[i] = 7\n");
    buf_bytes(out, "run: exit 0; stdout 4 lines (.tachyonc/probe/out)\n");
    buf_bytes(out, "  | a best 7\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Each `FILE:LINE` starts a probe, and the expressions after it are\n");
    buf_bytes(out, "printed each time it runs (the first 10 times; `--max N`). Where it goes\n");
    buf_bytes(out, "depends on the line:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| the line | the probe |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| begins a statement | runs before it |\n");
    buf_bytes(out, "| begins a `let` | runs after it: the new names are visible |\n");
    buf_bytes(out, "| begins `while`, `for`, `loop` | runs at the start of the body, each time round |\n");
    buf_bytes(out, "| opens a block (`} else {`, `X => {`, `fn f(x: T) {`) | runs at the start of that block |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Values are printed by type. Integers, floats and bool print as values,\n");
    buf_bytes(out, "`[u8]` quoted, arrays and slices up to 16 elements, `Option` and tuples\n");
    buf_bytes(out, "element by element, pointers as addresses. A struct uses Debug when it\n");
    buf_bytes(out, "has it, else prints field by field. The program is built from copies of\n");
    buf_bytes(out, "its files with the probes written in (`--overlay`), so line numbers stay\n");
    buf_bytes(out, "the same, and with `--trace`. Then it runs with `-- ARGS` and stdin from\n");
    buf_bytes(out, "`--input FILE` (or the command's own stdin), within `--timeout S` (10).\n");
    buf_bytes(out, "The report lists each probe's count and values, then the exit status,\n");
    buf_bytes(out, "the start of stdout and stderr.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Several probes go in one run: `tachyonc probe a.tach:10 x a.tach:20 y`.\n");
    buf_bytes(out, "`--count FILE:LINE` counts runs without printing. A probe whose name is\n");
    buf_bytes(out, "not in scope at its line is an error (`probe.expr`), so probe a later\n");
    buf_bytes(out, "line for a value made later.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "In the tachyon tree the program is the compiler itself. To see what it\n");
    buf_bytes(out, "does when compiling a test:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "tachyonc probe compiler/src/front/check/interp.tach:633 h t -- case.tach -o /tmp/p\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## reduce\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "$ tachyonc reduce big.in --until './prog < {} > /dev/null 2>&1; test $? = 101'\n");
    buf_bytes(out, "reduced big.in: 304 lines to 2 in 35 runs; written to big.in.min\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`{}` is the candidate's path. CMD must exit with 0 while the failure is\n");
    buf_bytes(out, "still there: `./prog < {} | grep -q wrong` for wrong output,\n");
    buf_bytes(out, "`test $? = 101` for a crash. For a compiler bug, use\n");
    buf_bytes(out, "`target/tachyonc {} -o /tmp/p 2>&1 | grep -q 'MESSAGE'`. Lines are left\n");
    buf_bytes(out, "out in chunks, and the chunks are halved when none can go. A run that\n");
    buf_bytes(out, "takes longer than `--timeout S` (5) counts as not failing.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Other questions\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| to know | run |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| who changes a field or static | `tachyonc query refs Struct.field --kind write` |\n");
    buf_bytes(out, "| who calls a function, transitively | `tachyonc query callers NAME`, `query callees FN --transitive` |\n");
    buf_bytes(out, "| whether optimization changes it | `tachyonc test -O 0`, then `tachyonc test` (-O2) |\n");
    buf_bytes(out, "| which test a compiler change broke | `tachyonc test FILTER` (tachyon tree): `new` vs `failing too` |\n");
    buf_bytes(out, "| what an expression gives | `tachyonc try 'STATEMENTS'` |\n");
}
