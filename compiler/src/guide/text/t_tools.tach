// Generated by compiler/guide/embed.sh from compiler/guide/tools.md (do
// not edit): the guide's topic 'tools'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Tools\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The compiler reads and changes programs by name: ask it instead of\n");
    buf_bytes(out, "reading files with grep or sed, and edit through it instead of\n");
    buf_bytes(out, "rewriting files. Names are resolved by the compiler, so a query sees\n");
    buf_bytes(out, "uses through imports and ignores comments and strings.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "When they pay off: renames, moves, signature, field and variant\n");
    buf_bytes(out, "changes (every use, checked, in one command), errors across files, and\n");
    buf_bytes(out, "code too large to read. A small program (a few hundred lines) is\n");
    buf_bytes(out, "cheaper read whole, once (`tachyonc query show FILE.tach` up to 200\n");
    buf_bytes(out, "lines, `query text FILE:A-B` 200 at a time), than explored with many\n");
    buf_bytes(out, "small queries.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## The loop\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "1. Write the program; `tachyonc check` (the front end only: fast, every\n");
    buf_bytes(out, "   error, one line each). Before writing a construct you are unsure of,\n");
    buf_bytes(out, "   `tachyonc guide --find WORDS` or `tachyonc guide TOPIC#SECTION`\n");
    buf_bytes(out, "   prints the lines on it.\n");
    buf_bytes(out, "2. Fix each error: `tachyonc query show FILE:LINE` prints the item at\n");
    buf_bytes(out, "   the error's position; `tachyonc edit patch` changes a few lines of it.\n");
    buf_bytes(out, "3. `tachyonc fix --suggested` when errors have `try: tachyonc fix\n");
    buf_bytes(out, "   --suggested main.tach` (0.18): their exact fixes, one checked edit,\n");
    buf_bytes(out, "   then the errors left; `tachyonc fix` for unsafe blocks.\n");
    buf_bytes(out, "4. Build and run: `tachyonc main.tach -o prog && ./prog`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## The program\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Commands find the program's root file from `--root FILE`, a last\n");
    buf_bytes(out, "argument ending in `.tach`, `$TACHYON_ROOT`, or `./main.tach`. The other\n");
    buf_bytes(out, "files are the modules it loads.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Reading\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "For an item you have not seen, ask `tachyonc query context NAME` first:\n");
    buf_bytes(out, "one call gives its source, the signatures of what it calls and uses,\n");
    buf_bytes(out, "and its callers (instead of `show`, then `def`, then `refs`):\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "$ tachyonc query context parse_item\n");
    buf_bytes(out, "// crate::parse_item  main.tach:5-9  effects: panic\n");
    buf_bytes(out, "fn parse_item(sc: &mut Scanner) -> Option<Item> {\n");
    buf_bytes(out, "    let name = sc.next_token()?;\n");
    buf_bytes(out, "    ...\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "// calls (3)\n");
    buf_bytes(out, "std::Scanner::next_token  <std>:2184:12  method  pub fn next_token(self: &mut Scanner) -> Option<[u8]>\n");
    buf_bytes(out, "...\n");
    buf_bytes(out, "// types (3)\n");
    buf_bytes(out, "crate::Item  main.tach:3:8  struct  struct Item { name: [u8], qty: i64 }\n");
    buf_bytes(out, "...\n");
    buf_bytes(out, "// callers (1)\n");
    buf_bytes(out, "main  main.tach:19:26  while let Some(it) = parse_item(&sc) {\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "(The fields are separated by TABs.) It stays within about 2,000 tokens\n");
    buf_bytes(out, "(`--budget N`); a module's name gives its items and its most used\n");
    buf_bytes(out, "bodies.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| to | run |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| an item with what it calls, its types and callers | `tachyonc query context NAME` (`--budget N`) |\n");
    buf_bytes(out, "| an item's source | `tachyonc query show NAME` (`--with-comments`) |\n");
    buf_bytes(out, "| the item at an error | `tachyonc query show FILE:LINE` |\n");
    buf_bytes(out, "| where it is defined, its signature | `tachyonc query def NAME` |\n");
    buf_bytes(out, "| every use | `tachyonc query refs NAME` (`--count`, `--in FILE\\|MODULE`; a local: `FN::x`) |\n");
    buf_bytes(out, "| who calls a function; what it calls | `tachyonc query callers NAME`; `query callees FN` (`--transitive`) |\n");
    buf_bytes(out, "| each local's kind, moves and views there (0.17) | `tachyonc query own main.tach:12:5` |\n");
    buf_bytes(out, "| what a function may do: allocate, io, panic... (0.16) | `tachyonc query effects NAME\\|MODULE` (`--why io`, `--has alloc(Gpa)`) |\n");
    buf_bytes(out, "| a module's items, with signatures | `tachyonc query items MODULE`; every module: `query items` |\n");
    buf_bytes(out, "| a module's `use` lines, header comment | `tachyonc query show MODULE::use` (`::header`) |\n");
    buf_bytes(out, "| lines of any file | `tachyonc query text FILE:A-B` |\n");
    buf_bytes(out, "| what nothing uses | `tachyonc query unused` |\n");
    buf_bytes(out, "| sizes, dependencies | `tachyonc query stats`, `query deps MODULE` |\n");
    buf_bytes(out, "| std's API, a std item | `tachyonc query items std`, `query show std::read_line` (any program) |\n");
    buf_bytes(out, "| what a snippet does | `tachyonc try 'let v = [3, 1]; v[..].len'` prints `i64 = 2` |\n");
    buf_bytes(out, "| the guide on some words | `tachyonc guide --find WORDS`, `guide TOPIC#SECTION`, `explain WORDS` |\n");
    buf_bytes(out, "| items like one, to copy for a new one; recipes for adding an X (0.17) | `tachyonc query similar NAME`; `query examples KIND`; `tachyonc guide how` |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "NAME is `f`, `module::f`, `Type::method`, `Enum::Variant`,\n");
    buf_bytes(out, "`Struct.field`, `<Type as Trait>::f` or `FILE:LINE`; several in one call;\n");
    buf_bytes(out, "every name a tool prints is taken back. Output is one fact per line,\n");
    buf_bytes(out, "fields separated by a TAB; `--budget N` keeps it to about N tokens.\n");
    buf_bytes(out, "`CMD --help` lists a command's options.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Several commands in one call: `tachyonc batch < cmds.txt`, one command\n");
    buf_bytes(out, "per line as typed after `tachyonc` (`<<END` ... `END` gives one its\n");
    buf_bytes(out, "stdin); each output follows a line `## $ tachyonc ARGS`. Chain what you\n");
    buf_bytes(out, "would run in turn: `query items` then `query show`, `show` then `refs`,\n");
    buf_bytes(out, "an edit then `check`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Changing\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| to | run |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| change text inside an item | `tachyonc edit patch NAME --old 'TEXT' --new 'TEXT'` (pairs repeat) |\n");
    buf_bytes(out, "| replace, add, remove an item | `tachyonc edit replace NAME < new.tach`, `edit insert --after NAME < item.tach`, `edit delete NAME` |\n");
    buf_bytes(out, "| add statements inside an item | `tachyonc edit insert --in NAME --after 'ANCHOR' < text` |\n");
    buf_bytes(out, "| several items at once, one edit | `tachyonc edit apply items.tach`: `@@ NAME` then its new text, `@@ new after NAME`, `@@ delete NAME` (or `query show A B`'s output, edited) |\n");
    buf_bytes(out, "| see the result | `--show` on any edit; `tachyonc query diff` |\n");
    buf_bytes(out, "| undo the last edit | `tachyonc undo` (the journal: in `.git`, else in `.tachyonc/` next to main.tach) |\n");
    buf_bytes(out, "| merge conflicts | `tachyonc query conflicts --show`, then `tachyonc edit resolve FILE:LINE --ours` (`--theirs`, `--both`, `< text`) |\n");
    buf_bytes(out, "| rename anything, with every use | `tachyonc refactor rename PATH NEW` |\n");
    buf_bytes(out, "| rename a local or parameter | `tachyonc refactor rename FILE:LINE:COL NEW` or `refactor rename FN::x NEW` (shadowing respected) |\n");
    buf_bytes(out, "| a parameter, with every call | `tachyonc refactor signature FN --add 'x: i64 = 0'` (a default; `--fill-calls`: each call gets 0; `--remove`, `--rename-param`, `--reorder`, `--type`; `--type v '&mut T'`: the calls' `&v` become `&mut v`) |\n");
    buf_bytes(out, "| a field, with every literal | `tachyonc refactor field STRUCT --add 'g: i64 = 0'` (`--type g T --default EXPR`) |\n");
    buf_bytes(out, "| a variant, with every match | `tachyonc refactor variant ENUM --add 'X(i64)' --arm 'EXPR'` (`--arm-in FN 'EXPR'` per match) |\n");
    buf_bytes(out, "| move items to a module | `tachyonc refactor move PATH --to MODULE` (made when missing) |\n");
    buf_bytes(out, "| an idiom everywhere, typed | `tachyonc rewrite 'old($a)' 'new($a)' --dry-run` |\n");
    buf_bytes(out, "| imports, unused, pub, unsafe | `tachyonc fix` (`--only imports,unused,pub,unsafe`, `--dry-run`) |\n");
    buf_bytes(out, "| `*T` and by-value parameters to `&T`/`&mut T`, with every call (0.17) | `tachyonc fix --values` (`--dry-run`) |\n");
    buf_bytes(out, "| the errors' exact fixes (their `try: tachyonc fix --suggested`) | `tachyonc fix --suggested` (`--dry-run`, `--at FILE:LINE`) |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Every edit is atomic: the edited program is checked first, and an edit\n");
    buf_bytes(out, "that adds an error writes nothing and prints the errors, each tagged\n");
    buf_bytes(out, "`[edited: PATH]` or `[in PATH]` (an item the edit did not change: change\n");
    buf_bytes(out, "it in the same `edit apply`, or run the refactoring the `try:` line\n");
    buf_bytes(out, "names). `--dry-run` prints the diff instead; `--no-check` writes anyway.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Testing\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc test` builds the program when a source changed and runs its\n");
    buf_bytes(out, "cases: `tests/NAME.in` (stdin; none: empty) with `tests/NAME.out` (the\n");
    buf_bytes(out, "expected stdout), next to `main.tach`; `tests/NAME.exit` holds an exit\n");
    buf_bytes(out, "status other than 0. It prints the counts first, then each failing case\n");
    buf_bytes(out, "with a few lines of difference, within about 1,000 tokens:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "$ tachyonc test\n");
    buf_bytes(out, "test main.tach: 4 passed, 1 failed (tests/)\n");
    buf_bytes(out, "FAIL big: stdout differs at line 3 (10 lines expected, 9 printed)\n");
    buf_bytes(out, "  - 42 apples\n");
    buf_bytes(out, "  - 43 pears\n");
    buf_bytes(out, "  + 41 apples\n");
    buf_bytes(out, "  + 43 pears\n");
    buf_bytes(out, "(outputs: .tachyonc/test/NAME.got, NAME.err)\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc test big small` runs the cases whose names contain a word;\n");
    buf_bytes(out, "`--full` every failure in full; `--input FILE` (`-`: stdin) one run,\n");
    buf_bytes(out, "its output and exit status; `--timeout S` per case (10). Output is\n");
    buf_bytes(out, "compared with `\\r\\n` as `\\n` and trailing whitespace at the end left\n");
    buf_bytes(out, "out. In the tachyon tree, `tachyonc test FILTER` rebuilds\n");
    buf_bytes(out, "`target/tachyonc` when the source is newer and runs `tests/run.sh\n");
    buf_bytes(out, "FILTER`, summarized the same way.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Debugging\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A bug: `tachyonc guide debug`. Tests are built with `--trace`, so a crash\n");
    buf_bytes(out, "or a hang prints its line and callers. `tachyonc probe FILE:LINE EXPR...\n");
    buf_bytes(out, "--input FILE` prints values at a line without editing the source.\n");
    buf_bytes(out, "`tachyonc reduce FILE --until 'CMD'` shrinks a failing input. In the\n");
    buf_bytes(out, "tachyon tree, `tachyonc test FILTER` also runs each failure with\n");
    buf_bytes(out, "`target/tools/tachyonc`, to tell new failures from old ones.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Diagnostics\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Compiler errors, from `tachyonc check` or a build whose output is not a\n");
    buf_bytes(out, "terminal (`--diagnostics=short` anywhere, `--diagnostics=human` for the\n");
    buf_bytes(out, "multi-line form):\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "main.tach:4:20: error[type error] undefined variable 'totl' | help: did you mean 'total'?\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A tool's problem is one line, `SEVERITY CODE: MESSAGE` (the code is\n");
    buf_bytes(out, "stable), followed by `try:` lines, each a command to run as it is:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "error patch.no-match: OLD 1 is not in crate::main; nearest, line 4: std::print_int(total);\n");
    buf_bytes(out, "try: tachyonc edit patch main --old 'print_int(total)' --new 'print_int(total + 1)'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Exit status: 0 done, 1 refused or failed (nothing written), 2 usage.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Other compiler options\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`-O0`, `-O1`, `-O2` (the default; all behave the same), `-j N` (0.18.1:\n");
    buf_bytes(out, "the threads -O1 and -O2 compile on; the output is the same whatever N),\n");
    buf_bytes(out, "`--target aarch64-macos|aarch64-linux|x86_64-linux|x86_64-macos`, `-g` (debug line\n");
    buf_bytes(out, "tables), `--trace` (0.17: a failure prints its line and callers),\n");
    buf_bytes(out, "`--check-unsafe`, `--check-alloc` (0.16), `--emit-header`,\n");
    buf_bytes(out, "`--emit-imports`, `-I DIR`, `--version`. `tachyonc guide TOPIC` for the language.\n");
}
