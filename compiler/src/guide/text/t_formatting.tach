// Generated by compiler/guide/embed.sh from compiler/guide/formatting.md (do
// not edit): the guide's topic 'formatting'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Formatting and derive (0.15)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "f-strings, the `Display` and `Debug` traits, the generic `print`\n");
    buf_bytes(out, "family, and `#[derive]`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## f-strings\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`f\"text {expr} text\"` is formatted text: each hole `{expr}` is a value\n");
    buf_bytes(out, "whose type has `Display` (`{expr:?}`: `Debug`). It is a value too (an\n");
    buf_bytes(out, "`std::Interp`), passed to anything taking `T: Display`: `print`,\n");
    buf_bytes(out, "`println`, `eprint`, `eprintln` (stderr), `format` (a new `Buf`, the\n");
    buf_bytes(out, "caller owns it), `b.push_fmt(..)` (appends to a `Buf`; 0.17:\n");
    buf_bytes(out, "`b.push_str(f\"..\")` is the same call), `f.write(..)` (inside a Display\n");
    buf_bytes(out, "impl). A plain `\"...\"` never formats: `\"{x}\"` is\n");
    buf_bytes(out, "those three bytes (a literal holding `{name}` of a local passed to\n");
    buf_bytes(out, "`println` gets a warning, `try: f\"...\"`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `{{` and `}}` are a brace; the text takes a string's escapes.\n");
    buf_bytes(out, "- A hole holds any expression but a top-level `:` (parenthesize it);\n");
    buf_bytes(out, "  string literals work in it (`{m.get(\"k\"):?}`); f-strings do not nest.\n");
    buf_bytes(out, "- The holes are evaluated where the f-string is written, once, left to\n");
    buf_bytes(out, "  right; the value holds copies, so it can be stored and printed later.\n");
    buf_bytes(out, "- The spec after `:` is `[<|>][0][width][.precision][?|x|X|b|c]`: `<`\n");
    buf_bytes(out, "  and `>` align (numbers go right by default, text left), `0` pads with\n");
    buf_bytes(out, "  zeros, `.N` gives a float N decimals, `?` is Debug, `x`/`X` hex, `b`\n");
    buf_bytes(out, "  binary, `c` a `u8` as its byte (a `u8` is a number otherwise).\n");
    buf_bytes(out, "- Floats print the shortest text that reads back as the same value\n");
    buf_bytes(out, "  (`2.5`, `0.1`).\n");
    buf_bytes(out, "- (0.17) Passed straight to `print`, `println`, `eprint`, `eprintln`,\n");
    buf_bytes(out, "  `format_in` or `b.push_fmt`, an f-string is written in place: no\n");
    buf_bytes(out, "  closure, no `Interp`, no copy of the function, at every `-O` level.\n");
    buf_bytes(out, "  Through a function of your own taking `T: Display`, each f-string is\n");
    buf_bytes(out, "  a new copy of that function (and of what it calls).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let name = \"tachyon\";\n");
    buf_bytes(out, "    let n = 42;\n");
    buf_bytes(out, "    let x = 2.5;\n");
    buf_bytes(out, "    println(f\"{name} has {n} and {x}\");\n");
    buf_bytes(out, "    println(f\"[{n:>6}] [{n:<6}] [{n:06}] [{n:x}] [{n:X}] [{n:b}]\");\n");
    buf_bytes(out, "    println(f\"[{name:>9}] [{x:.3}] [{'A':c}] {{braces}} {n * 2 + 1}\");\n");
    buf_bytes(out, "    let s = format_in(f\"{n}-{n + 1}\", gpa);       // a Buf, dropped at the end\n");
    buf_bytes(out, "    eprintln(f\"to stderr: {s.as_slice()}\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "tachyon has 42 and 2.5\n");
    buf_bytes(out, "[    42] [42    ] [000042] [2a] [2A] [101010]\n");
    buf_bytes(out, "[  tachyon] [2.500] [A] {braces} 85\n");
    buf_bytes(out, "to stderr: 42-43\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn next(c: &mut i64) -> i64 {\n");
    buf_bytes(out, "    *c += 1;\n");
    buf_bytes(out, "    *c\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut c = 0;\n");
    buf_bytes(out, "    let line = f\"{next(&mut c)} {next(&mut c)}\";     // evaluated here: 1, then 2\n");
    buf_bytes(out, "    c = 100;\n");
    buf_bytes(out, "    println(line);\n");
    buf_bytes(out, "    println(line);\n");
    buf_bytes(out, "    std::print_int(c);\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "1 2\n");
    buf_bytes(out, "1 2\n");
    buf_bytes(out, "100\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Printing writes through a static 4 KB buffer, one `write` per call, no\n");
    buf_bytes(out, "heap. Rust's `println!(\"{}\", x)` is `println(f\"{x}\")`, `format!` is\n");
    buf_bytes(out, "`format_in(f\"...\", gpa)`; there are no macros.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Display and Debug\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "trait Display { fn fmt(self: &Self, f: &mut Fmt); }\n");
    buf_bytes(out, "trait Debug { fn fmt_debug(self: &Self, f: &mut Fmt); }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Write `impl Display for T` (no derive: the text is yours) with the\n");
    buf_bytes(out, "methods of `std::Fmt`: `f.str(s)` (a `[u8]`), `f.byte(b)`, `f.write(x)`\n");
    buf_bytes(out, "(any Display value, an f-string too), `f.display(&x)`, `f.debug(&x)`.\n");
    buf_bytes(out, "Not Rust's `fn fmt(&self, f: &mut Formatter) -> fmt::Result`: there is\n");
    buf_bytes(out, "no result to return. Display is in std for the numbers, `[u8]` and the\n");
    buf_bytes(out, "error enums; Debug for those (a `[u8]` quoted and\n");
    buf_bytes(out, "escaped: `\"a\\n\"`), `Vec<T>`, `Option`, `Result` and `HashMap` (`[1, 2]`,\n");
    buf_bytes(out, "`Some(5)`, `{1: 2}`). A slice `[T]` has no Debug (it would clash with\n");
    buf_bytes(out, "`[u8]`'s): `std::debug_list(f, s)` writes one from a Debug impl.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "#[derive(Debug, Clone)]\n");
    buf_bytes(out, "struct Point { x: i64, y: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[derive(Debug)]\n");
    buf_bytes(out, "enum Shape { Circle(i64), Rect(Point, Point), Line { from: Point, len: i64 }, Empty }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Display for Point {\n");
    buf_bytes(out, "    fn fmt(self: &Point, f: &mut Fmt) {\n");
    buf_bytes(out, "        f.write(f\"({self.x}, {self.y})\");\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let p = Point { x: 1, y: 2 };\n");
    buf_bytes(out, "    let mut q = p.clone();\n");
    buf_bytes(out, "    q.x = 5;\n");
    buf_bytes(out, "    println(f\"{p} {q:?}\");\n");
    buf_bytes(out, "    let shapes = [Shape::Circle(3), Shape::Rect(p, q), Shape::Line { from: p, len: 4 }, Shape::Empty];\n");
    buf_bytes(out, "    for s in shapes { println(f\"{s:?}\"); }\n");
    buf_bytes(out, "    let mut v: Vec<i64> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    v.push(1);\n");
    buf_bytes(out, "    v.push(2);\n");
    buf_bytes(out, "    println(f\"{v:?} {v.last():?} {\"hi\":?}\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "(1, 2) Point { x: 5, y: 2 }\n");
    buf_bytes(out, "Circle(3)\n");
    buf_bytes(out, "Rect(Point { x: 1, y: 2 }, Point { x: 5, y: 2 })\n");
    buf_bytes(out, "Line { from: Point { x: 1, y: 2 }, len: 4 }\n");
    buf_bytes(out, "Empty\n");
    buf_bytes(out, "[1, 2] Some(2) \"hi\"\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## derive\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`#[derive(Eq, Ord, Hash, Debug, Clone)]` before a struct or an enum\n");
    buf_bytes(out, "(with `#[repr]` if it has one) writes the impls:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| trait | what it is |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `Eq` | the structural `==` it already has; an error if a field has no `==` |\n");
    buf_bytes(out, "| `Ord` | field by field, in declaration order; an enum by variant order, then payload |\n");
    buf_bytes(out, "| `Hash` | the fields' hashes mixed (`std::hash_mix`), an enum's variant first |\n");
    buf_bytes(out, "| `Debug` | Rust's text: `P { x: 1, y: 2 }`, `Circle(3)`, `Empty` |\n");
    buf_bytes(out, "| `Clone` | field by field (`std::clone_of`): a `Vec` field is copied deep |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "On a generic type each parameter gets the trait as a bound: `#[derive(Ord)]\n");
    buf_bytes(out, "struct P<T>` is `impl<T: Ord> Ord for P<T>`. Display has no derive. A\n");
    buf_bytes(out, "derived trait and a hand-written impl of it clash: remove one.\n");
    buf_bytes(out, "`x.clone()` of a plain value (numbers, pointers, fieldless enums,\n");
    buf_bytes(out, "tuples of them) is a copy. `Clone` is in std for `Vec` (deep), `Buf`,\n");
    buf_bytes(out, "`HashMap`, `Option`, `Result` and the primitives.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "#[derive(Eq, Ord, Hash, Debug)]\n");
    buf_bytes(out, "struct Key { group: i64, id: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let mut keys = [Key { group: 2, id: 1 }, Key { group: 1, id: 9 }, Key { group: 1, id: 3 }];\n");
    buf_bytes(out, "    sort(&mut keys[..]);                     // by group, then id\n");
    buf_bytes(out, "    let mut m: HashMap<Key, i64> = HashMap::new_in(gpa);\n");
    buf_bytes(out, "    for k in keys { m.insert(k, k.id * 10); }\n");
    buf_bytes(out, "    let wanted = Key { group: 2, id: 1 };\n");
    buf_bytes(out, "    println(f\"{keys[0]:?} {m.get(wanted):?}\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "Key { group: 1, id: 3 } Some(10)\n");
    buf_bytes(out, "```\n");
}
