// Generated by compiler/guide/embed.sh from compiler/guide/closures.md (do
// not edit): the guide's topic 'closures'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Closures\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A closure is a function written as an expression, that uses the locals\n");
    buf_bytes(out, "around it: `|x| x + k`. Each closure has its own type, which has no\n");
    buf_bytes(out, "name: give a closure to a generic parameter bounded by `Fn` or `FnMut`,\n");
    buf_bytes(out, "or keep it in a `let`. Calls are direct (no allocation, no pointer to a\n");
    buf_bytes(out, "function), and a closure passed to a generic function is usually\n");
    buf_bytes(out, "inlined.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 {\n");
    buf_bytes(out, "    f(x)\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn repeat<F: FnMut(i64)>(n: i64, mut f: F) {\n");
    buf_bytes(out, "    for i in 0..n { f(i); }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let k = 10;\n");
    buf_bytes(out, "    let add_k = |x: i64| x + k;              // a `let` needs the parameter's type\n");
    buf_bytes(out, "    std::print_int(apply(add_k, 1));\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    std::print_int(apply(|x| x * 2, 21));    // here F's bound gives x: i64\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    let mut total = 0;\n");
    buf_bytes(out, "    repeat(4, |i| { total += i; });          // changes `total` (a `let mut`)\n");
    buf_bytes(out, "    std::print_int(total);\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "11 42 6\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Syntax\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `|a, b| a + b`; `|| 42` takes nothing; `|x: i64| -> i64 { x + 1 }`:\n");
    buf_bytes(out, "  with a result type, the body is a block. The body takes everything\n");
    buf_bytes(out, "  after the bars, as `return`'s value does: `|x| x + 1` is\n");
    buf_bytes(out, "  `|x| (x + 1)`.\n");
    buf_bytes(out, "- Parameters are patterns: `|(a, b): (i64, i64)| a * b`, `|mut x|`,\n");
    buf_bytes(out, "  `|_|`; not `|a | b|` (no or-pattern at the top).\n");
    buf_bytes(out, "- A parameter's type is the annotation, else the one the context\n");
    buf_bytes(out, "  expects (an `F: Fn(i64) -> bool` bound, an `fn(i64) -> bool`\n");
    buf_bytes(out, "  parameter). Without either it is an error: `cannot infer the type of\n");
    buf_bytes(out, "  closure parameter 'x'`, fixed by writing `|x: i64|`.\n");
    buf_bytes(out, "- `return` in the body returns from the closure; `break` and `continue`\n");
    buf_bytes(out, "  cannot leave it. An `unsafe { }` around a closure covers its body.\n");
    buf_bytes(out, "- Messages and `tachyonc query type FILE:LINE:COL` show a closure's type\n");
    buf_bytes(out, "  as `closure(i64) -> i64 at main.tach:4:15`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## What a closure captures\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Decided per variable, so the meaning never depends on an analysis:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| the variable | captured | the closure sees |\n");
    buf_bytes(out, "|---|---|---|\n");
    buf_bytes(out, "| `let x`, a parameter, a `for` variable | by value (a copy) | the value it had; nothing can change it |\n");
    buf_bytes(out, "| `let mut x` | by reference | later changes, and its own assignments change `x` |\n");
    buf_bytes(out, "| anything, with `move \\|..\\|` | by value | a snapshot; assignments change the closure's copy |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn call<F: FnMut() -> i64>(mut f: F) -> i64 {\n");
    buf_bytes(out, "    f()\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut n = 1;\n");
    buf_bytes(out, "    let read = || n;            // by reference\n");
    buf_bytes(out, "    let snap = move || n;       // a copy of n, now\n");
    buf_bytes(out, "    n = 5;\n");
    buf_bytes(out, "    std::print_int(call(read) * 10 + call(snap));\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "51\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A closure that borrows a variable cannot leave that variable's block: a\n");
    buf_bytes(out, "block's value, a `break` value, a `match` or `if let` arm's value. The\n");
    buf_bytes(out, "error says to write `move`, or to declare the variable outside the\n");
    buf_bytes(out, "block. There is nothing else a closure can escape through: closure\n");
    buf_bytes(out, "types cannot be named, so no struct field, static or return type can\n");
    buf_bytes(out, "hold one (outside generic parameters).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Fn, FnMut, fn\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `F: Fn(A, B) -> R` takes a closure with that signature that assigns\n");
    buf_bytes(out, "  no captured variable, or a plain function `fn(A, B) -> R`.\n");
    buf_bytes(out, "- `F: FnMut(A, B) -> R` takes any closure with that signature, or a\n");
    buf_bytes(out, "  plain function. Call `f` from a `mut f: F` parameter or a `let mut`.\n");
    buf_bytes(out, "- `-> R` may be left out: `FnMut(i64)` returns `()`. There is no\n");
    buf_bytes(out, "  `FnOnce`.\n");
    buf_bytes(out, "- A closure that captures nothing is a plain function: it converts to\n");
    buf_bytes(out, "  `fn(i64) -> i64` where one is expected. A capturing one is an error\n");
    buf_bytes(out, "  there; make the parameter generic: `fn run<F: Fn(i64) -> i64>(f: F)`.\n");
    buf_bytes(out, "- In a struct, a closure is a generic field: `struct Button<F> { on: F }`,\n");
    buf_bytes(out, "  called as `(b.on)(3)`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct Counter<F> { step: F, n: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn run(f: fn(i64) -> i64) -> i64 {\n");
    buf_bytes(out, "    f(4)\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    std::print_int(run(|x| x * x));       // captures nothing: a plain fn\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    let k = 3;\n");
    buf_bytes(out, "    let mut c = Counter { step: |x: i64| x + k, n: 0 };\n");
    buf_bytes(out, "    c.n = (c.step)(c.n);\n");
    buf_bytes(out, "    c.n = (c.step)(c.n);\n");
    buf_bytes(out, "    std::print_int(c.n);\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "16 6\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Not there: `FnOnce`, `Box<dyn Fn>` and `dyn` (use generics), `impl Fn`\n");
    buf_bytes(out, "in a result (0.15), closures in statics, a closure calling itself.\n");
    buf_bytes(out, "`tachyonc guide iterators`: closures with `map`, `filter`, `fold`.\n");
}
