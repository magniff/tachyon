// Generated by compiler/guide/embed.sh from compiler/guide/example.md (do
// not edit): the guide's topic 'example'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# A whole program (0.17)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "One complete program, written the way tachyon code is written: modules\n");
    buf_bytes(out, "and `use`, enums with data and `match`, `Result` and `?`, `Vec`,\n");
    buf_bytes(out, "`HashMap`, `Buf`, text as `[u8]`, a sort closure, f-strings, the\n");
    buf_bytes(out, "allocator passed down from `main`, and a test case. A program of this\n");
    buf_bytes(out, "kind needs only what it shows: copy its patterns.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`stock` reads commands from stdin, one a line, and prints a line for\n");
    buf_bytes(out, "each command it rejects and the report it is asked for. It has three\n");
    buf_bytes(out, "files next to each other: `tachyonc main.tach -o prog` builds them all.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach main.tach\n");
    buf_bytes(out, "// stock: a ledger of items. Reads commands from stdin, one a line; prints\n");
    buf_bytes(out, "// the report it is asked for, and a line for each command it rejects.\n");
    buf_bytes(out, "mod command;\n");
    buf_bytes(out, "mod store;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "use command::{Error, parse};\n");
    buf_bytes(out, "use store::Store;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let input = read_stdin_in(gpa).unwrap();    // all of stdin, a Buf\n");
    buf_bytes(out, "    let mut store = Store::new(gpa);            // it allocates: give it gpa\n");
    buf_bytes(out, "    let mut sc = Scanner::new(input.as_slice());\n");
    buf_bytes(out, "    let mut line_no = 0;\n");
    buf_bytes(out, "    while let Some(raw) = sc.next_line() {      // a line, without its '\\n'\n");
    buf_bytes(out, "        line_no += 1;\n");
    buf_bytes(out, "        let line = trim(cut_comment(raw));      // views into input: no copies\n");
    buf_bytes(out, "        if line.len() == 0 {\n");
    buf_bytes(out, "            continue;\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "        if let Err(e) = run(&mut store, line, gpa) { // run may change store\n");
    buf_bytes(out, "            println(f\"line {line_no}: {e}\");    // Error has Display\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}                                               // store, then input, dropped (freed)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// One line: parsed, then applied; `?` passes the first Err up.\n");
    buf_bytes(out, "fn run(store: &mut Store, line: [u8], gpa: Gpa) -> Result<(), Error> {\n");
    buf_bytes(out, "    let cmd = parse(line, gpa)?;\n");
    buf_bytes(out, "    store.apply(cmd)\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// s up to its first '#'.\n");
    buf_bytes(out, "fn cut_comment(s: [u8]) -> [u8] {\n");
    buf_bytes(out, "    for i in 0..s.len() {\n");
    buf_bytes(out, "        if s[i] == '#' {                        // '#' is a u8\n");
    buf_bytes(out, "            return s[..i];                      // a slice of s: s[a..b], s[a..]\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    s\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach command.tach\n");
    buf_bytes(out, "// A line of input as a Command, or the Error that rejects it.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// pub on a struct makes its fields visible with it. Clone: Vec::clone\n");
    buf_bytes(out, "// needs it (the derives: Eq, Ord, Hash, Debug, Clone).\n");
    buf_bytes(out, "#[derive(Clone)]\n");
    buf_bytes(out, "pub struct Item { name: [u8], count: i64, price: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// Variants carry data, tuple-like or struct-like, as in Rust.\n");
    buf_bytes(out, "pub enum Command {\n");
    buf_bytes(out, "    Add(Item),\n");
    buf_bytes(out, "    Sell { name: [u8], count: i64 },\n");
    buf_bytes(out, "    Report,\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "pub enum Error {\n");
    buf_bytes(out, "    Unknown([u8]),\n");
    buf_bytes(out, "    Arity([u8], i64),\n");
    buf_bytes(out, "    BadNumber([u8]),\n");
    buf_bytes(out, "    NoItem([u8]),\n");
    buf_bytes(out, "    Short([u8], i64),\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// What `{e}` in an f-string prints.\n");
    buf_bytes(out, "impl Display for Error {\n");
    buf_bytes(out, "    fn fmt(self: &Error, f: &mut Fmt) {\n");
    buf_bytes(out, "        match *self {\n");
    buf_bytes(out, "            Error::Unknown(w) => f.write(f\"unknown command {w}\"),\n");
    buf_bytes(out, "            Error::Arity(w, n) => f.write(f\"{w} takes {n - 1} arguments\"),\n");
    buf_bytes(out, "            Error::BadNumber(w) => f.write(f\"not a number: {w}\"),\n");
    buf_bytes(out, "            Error::NoItem(name) => f.write(f\"no item {name}\"),\n");
    buf_bytes(out, "            Error::Short(name, have) => f.write(f\"only {have} {name} left\"),\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// `add NAME COUNT PRICE`, `sell NAME COUNT` or `report`.\n");
    buf_bytes(out, "pub fn parse(line: [u8], gpa: Gpa) -> Result<Command, Error> {\n");
    buf_bytes(out, "    let words = split_whitespace_in(line, gpa); // Vec<[u8]>: views into line\n");
    buf_bytes(out, "    let w = words.as_slice();                   // [[u8]]\n");
    buf_bytes(out, "    let verb = w[0];\n");
    buf_bytes(out, "    if verb == \"add\" {                          // text is compared with ==, not matched\n");
    buf_bytes(out, "        arity(w, 4)?;\n");
    buf_bytes(out, "        let item = Item { name: w[1], count: number(w[2])?, price: number(w[3])? };\n");
    buf_bytes(out, "        Ok(Command::Add(item))\n");
    buf_bytes(out, "    } else if verb == \"sell\" {\n");
    buf_bytes(out, "        arity(w, 3)?;\n");
    buf_bytes(out, "        Ok(Command::Sell { name: w[1], count: number(w[2])? })\n");
    buf_bytes(out, "    } else if verb == \"report\" {\n");
    buf_bytes(out, "        Ok(Command::Report)\n");
    buf_bytes(out, "    } else {\n");
    buf_bytes(out, "        Err(Error::Unknown(verb))\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn arity(w: [[u8]], n: i64) -> Result<(), Error> {\n");
    buf_bytes(out, "    if w.len() != n {\n");
    buf_bytes(out, "        return Err(Error::Arity(w[0], n));\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// A count or a price: a number, not negative.\n");
    buf_bytes(out, "fn number(w: [u8]) -> Result<i64, Error> {\n");
    buf_bytes(out, "    match parse_int(w) {\n");
    buf_bytes(out, "        Ok(n) if n >= 0 => Ok(n),\n");
    buf_bytes(out, "        _ => Err(Error::BadNumber(w)),\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach store.tach\n");
    buf_bytes(out, "// The items in stock, in the order they were first added.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "use command::{Command, Error, Item};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "pub struct Store {\n");
    buf_bytes(out, "    items: Vec<Item>,\n");
    buf_bytes(out, "    index: HashMap<[u8], i64>,                  // name -> its position in items\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Store {\n");
    buf_bytes(out, "    pub fn new(gpa: Gpa) -> Store {\n");
    buf_bytes(out, "        Store { items: Vec::new_in(gpa), index: HashMap::new_in(gpa) }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "    // No free: a Store drops its fields (items, then index) when it is dropped.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "    pub fn apply(self: &mut Store, cmd: Command) -> Result<(), Error> {\n");
    buf_bytes(out, "        match cmd {\n");
    buf_bytes(out, "            Command::Add(item) => match self.index.get(item.name) {\n");
    buf_bytes(out, "                Some(i) => {\n");
    buf_bytes(out, "                    self.items[i].count += item.count;\n");
    buf_bytes(out, "                    self.items[i].price = item.price;\n");
    buf_bytes(out, "                }\n");
    buf_bytes(out, "                None => {\n");
    buf_bytes(out, "                    self.index.insert(item.name, self.items.len());\n");
    buf_bytes(out, "                    self.items.push(item);\n");
    buf_bytes(out, "                }\n");
    buf_bytes(out, "            },\n");
    buf_bytes(out, "            Command::Sell { name, count } => {\n");
    buf_bytes(out, "                let i = self.index.get(name).ok_or(Error::NoItem(name))?;\n");
    buf_bytes(out, "                let have = self.items[i].count;\n");
    buf_bytes(out, "                if have < count {\n");
    buf_bytes(out, "                    return Err(Error::Short(name, have));\n");
    buf_bytes(out, "                }\n");
    buf_bytes(out, "                self.items[i].count = have - count;\n");
    buf_bytes(out, "            }\n");
    buf_bytes(out, "            Command::Report => self.report(),\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "        Ok(())\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "    // The items by value, highest first, ties by name; then the total.\n");
    buf_bytes(out, "    fn report(self: &Store) {\n");
    buf_bytes(out, "        let gpa = self.items.allocator();       // a Vec's allocator, to allocate with\n");
    buf_bytes(out, "        let mut order = self.items.clone();     // a copy (in that allocator)\n");
    buf_bytes(out, "        order.sort_by(|a, b| {                  // a, b: &Item; < 0: a goes first\n");
    buf_bytes(out, "            let d = value(*b) - value(*a);\n");
    buf_bytes(out, "            if d != 0 { d } else { cmp_of(&a.name, &b.name) }   // cmp_of takes references\n");
    buf_bytes(out, "        });\n");
    buf_bytes(out, "        let mut out = Buf::new_in(gpa);         // Rust's String\n");
    buf_bytes(out, "        let mut total = 0;\n");
    buf_bytes(out, "        for it in order {\n");
    buf_bytes(out, "            out.push_fmt(f\"{it.name:<5}{it.count:>3} x {it.price:>2} = {value(it)}\\n\");\n");
    buf_bytes(out, "            total += value(it);\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "        out.push_str(\"total \");\n");
    buf_bytes(out, "        out.push_int(total);\n");
    buf_bytes(out, "        println(out.as_slice());\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn value(it: Item) -> i64 {\n");
    buf_bytes(out, "    it.count * it.price\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A test case is two files: the input in `tests/basic.in`, the expected\n");
    buf_bytes(out, "output in `tests/basic.out`. `tachyonc test` builds the program and runs\n");
    buf_bytes(out, "every case (`test main.tach: 1 passed (tests/)`, or the first lines that\n");
    buf_bytes(out, "differ):\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```in\n");
    buf_bytes(out, "# a day at the shop\n");
    buf_bytes(out, "add pen 10 3\n");
    buf_bytes(out, "add ink 4 12\n");
    buf_bytes(out, "add cap 6 8   # caps arrived\n");
    buf_bytes(out, "sell pen 3\n");
    buf_bytes(out, "sell hat 1\n");
    buf_bytes(out, "add pen x 2\n");
    buf_bytes(out, "sell ink 9\n");
    buf_bytes(out, "add ink 1 12\n");
    buf_bytes(out, "refund pen 1\n");
    buf_bytes(out, "sell cap\n");
    buf_bytes(out, "report\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "line 6: no item hat\n");
    buf_bytes(out, "line 7: not a number: x\n");
    buf_bytes(out, "line 8: only 4 ink left\n");
    buf_bytes(out, "line 10: unknown command refund\n");
    buf_bytes(out, "line 11: sell takes 2 arguments\n");
    buf_bytes(out, "ink    5 x 12 = 60\n");
    buf_bytes(out, "cap    6 x  8 = 48\n");
    buf_bytes(out, "pen    7 x  3 = 21\n");
    buf_bytes(out, "total 129\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## What differs from Rust here\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- Text is `[u8]`, a view: `trim`, `split_whitespace_in`, `s[a..b]`\n");
    buf_bytes(out, "  copy nothing. A name stays valid while the buffer it views lives,\n");
    buf_bytes(out, "  here `input`, until `main` returns. Text is compared with `==` and `<`;\n");
    buf_bytes(out, "  `match` has no string patterns.\n");
    buf_bytes(out, "- Enum variants are tuple-like or struct-like; patterns as in Rust, with\n");
    buf_bytes(out, "  guards (`Ok(n) if n >= 0`), `if let`, `while let`. Matching a\n");
    buf_bytes(out, "  reference matches what it points to: `match self` binds references\n");
    buf_bytes(out, "  into it (0.18.1, `n: &i64`, read as `*n`), `match *self` copies.\n");
    buf_bytes(out, "- `#[derive(Eq, Ord, Hash, Debug, Clone)]` (no `PartialEq`, no `Copy`\n");
    buf_bytes(out, "  derive: a struct of numbers and views, as `Item`, copies; one holding a\n");
    buf_bytes(out, "  `Vec`, `Buf` or `HashMap`, as `Store`, moves). `Display` is written by\n");
    buf_bytes(out, "  hand, with `f.write(f\"..\")`; its `self: &Self` is a reference.\n");
    buf_bytes(out, "- Nothing allocates without an allocator. `main` gets `gpa` and passes\n");
    buf_bytes(out, "  it down. A function that allocates takes `gpa: Gpa`; one holding a\n");
    buf_bytes(out, "  `Vec` can use `v.allocator()`. Nothing is freed by hand: a value is\n");
    buf_bytes(out, "  dropped at the end of its scope (`tachyonc guide memory`).\n");
    buf_bytes(out, "- `self: &T` and `self: &mut T` are `&self` and `&mut self`; `&x` and\n");
    buf_bytes(out, "  `&mut x` give `&T` and `&mut T`; fields are reached through them with `.`.\n");
    buf_bytes(out, "- Comparators return an `i64` (negative: `a` first) and take\n");
    buf_bytes(out, "  references: `sort_by(|a, b| ..)`, `cmp_of(&x, &y)`.\n");
    buf_bytes(out, "- `Buf` is Rust's `String`: `push_str`, `push_int`, `push_fmt(f\"..\")`,\n");
    buf_bytes(out, "  `as_slice()`.\n");
}
