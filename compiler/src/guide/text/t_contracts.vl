// Generated by compiler/guide/embed.sh from compiler/guide/contracts.md (do
// not edit): the guide's topic 'contracts'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Contracts and assertions\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A function states what it needs and what it promises between its\n");
    buf_bytes(out, "signature and its body (0.18). The clauses are checked at run time, as\n");
    buf_bytes(out, "bounds are: a failure is one line on stderr and exit 101. There is no\n");
    buf_bytes(out, "release switch; `debug` clauses are the ones only test builds check.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## requires and ensures\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct Stack { items: Vec<i64> }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Stack {\n");
    buf_bytes(out, "    fn top(self, i: i64) -> i64\n");
    buf_bytes(out, "        requires 0 <= i && i < self.items.len() else f\"no item {i}\"\n");
    buf_bytes(out, "        ensures result == self.items.get(i)\n");
    buf_bytes(out, "    {\n");
    buf_bytes(out, "        self.items.get(i)\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "    fn pop(inout self) -> i64\n");
    buf_bytes(out, "        requires self.items.len() > 0 else \"pop on an empty stack\"\n");
    buf_bytes(out, "    {\n");
    buf_bytes(out, "        self.items.pop().unwrap()\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    var s = Stack { items: Vec::new_in(gpa) };\n");
    buf_bytes(out, "    s.items.push(4);\n");
    buf_bytes(out, "    println(f\"{s.top(0)} {s.pop()}\");\n");
    buf_bytes(out, "    println(f\"{s.pop()}\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out (exit 101)\n");
    buf_bytes(out, "4 4\n");
    buf_bytes(out, "main.vl:22:16: pop on an empty stack: self.items.len() = 0\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `requires COND` is checked at the call, after the arguments: a failure\n");
    buf_bytes(out, "  names the caller's line, the one to change. Several clauses are\n");
    buf_bytes(out, "  checked in order.\n");
    buf_bytes(out, "- `ensures COND` is checked at every return of the body, before its\n");
    buf_bytes(out, "  drops and defers: a failure names the function. `result` is the value\n");
    buf_bytes(out, "  returned; `old(e)` is e evaluated at entry.\n");
    buf_bytes(out, "- A failure reads `requires failed: 'COND' of 'f' (FILE:L:C): x = 4, ...`\n");
    buf_bytes(out, "  (the integer operands' values). `else \"text\"` (or an f-string,\n");
    buf_bytes(out, "  evaluated only on failure) replaces all before the values.\n");
    buf_bytes(out, "- `debug requires` / `debug ensures` are checked only by `volec test`\n");
    buf_bytes(out, "  (and `--debug-contracts`): for conditions that cost more than the\n");
    buf_bytes(out, "  function (`debug requires is_sorted(v)`).\n");
    buf_bytes(out, "- std's own: `Vec::get`, `set`, `swap`, `insert`, `remove`,\n");
    buf_bytes(out, "  `Option::unwrap`, `Result::unwrap` have requires, so their failures\n");
    buf_bytes(out, "  name your line.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## What a condition may do\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A condition reads the parameters, `result`, `old(..)` and constants, and\n");
    buf_bytes(out, "calls functions; it must be pure: no io, no allocation, no static\n");
    buf_bytes(out, "(`contract.effect`, with the `query effects --why` that shows the call).\n");
    buf_bytes(out, "Owned parameters are read in place, never moved or dropped.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "An ensures runs after the body, so (`contract.old`):\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- a parameter taken by value and owned (a `Vec`, a `Buf`) is gone:\n");
    buf_bytes(out, "  write `old(v.len())` (or `old(v.clone())`), or take it by `&`;\n");
    buf_bytes(out, "- `old(e)` must not keep a view (`old(v.as_slice())`) of what the body\n");
    buf_bytes(out, "  may change: take a plain part, `old(v.len())`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`result` in a requires, or in an ensures of a function that returns\n");
    buf_bytes(out, "nothing, is `contract.result`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Assertions\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`assert(c)`, `assert(c, \"message\")`, `assert_eq(a, b)`, `assert_ne(a,\n");
    buf_bytes(out, "b)` and `debug_assert(c)` are in the prelude; `assert!(..)` and the other\n");
    buf_bytes(out, "bang spellings are accepted. Each operand is evaluated once; the\n");
    buf_bytes(out, "message is `assertion failed: 'COND'` (or the message given) and the\n");
    buf_bytes(out, "values:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let k = std::parse_int(\"3\").unwrap_or(0);\n");
    buf_bytes(out, "    assert_eq(k * 2, 6);\n");
    buf_bytes(out, "    assert(k > 5, \"k is small\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out (exit 101)\n");
    buf_bytes(out, "main.vl:4:5: k is small: k = 3\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## The failure line\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Every run-time check prints one line, `FILE:LINE:COL: message`, and\n");
    buf_bytes(out, "exits with 101: bounds, `as E`, `unwrap`, contracts, assertions.\n");
    buf_bytes(out, "`--trace` adds the calls that led there (`volec test` builds with\n");
    buf_bytes(out, "it; guide debug).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Contracts and the optimizer\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A check passes facts on: after `requires i < v.len()`, `v[i]` in the\n");
    buf_bytes(out, "body needs no bounds check, where the call is inlined and (0.18.1, -O2)\n");
    buf_bytes(out, "in a function no caller inlines, since every direct call checks first.\n");
    buf_bytes(out, "Nothing is assumed: a fact comes only from a check that ran, so a\n");
    buf_bytes(out, "function whose address is taken (an indirect call does not check its\n");
    buf_bytes(out, "requires) or that C calls keeps its own checks. Integers wrap: `i + 4\n");
    buf_bytes(out, "<= v.len()` holds for an i near `i64::MAX`, so it does not prove\n");
    buf_bytes(out, "`v[i + 1]`; `x % n` with `requires n > 0` is in `0..n`. `volec\n");
    buf_bytes(out, "query checks FN` lists the checks left after the optimizer and the ones\n");
    buf_bytes(out, "it removed.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Contracts as tests\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`volec test` tests every function with an `ensures` as a property:\n");
    buf_bytes(out, "its inputs generated, its requires filtering them (guide testing).\n");
}
