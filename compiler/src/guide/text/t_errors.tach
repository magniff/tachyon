// Generated by compiler/guide/embed.sh from compiler/guide/errors.md (do
// not edit): the guide's topic 'errors'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Errors and their fixes\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc check`, and a build whose output is not a terminal (an\n");
    buf_bytes(out, "agent's shell, a pipe; `--diagnostics=short` anywhere): one line per\n");
    buf_bytes(out, "error, `FILE:LINE:COL: error[KIND] MESSAGE | help: HELP | note: NOTE |\n");
    buf_bytes(out, "try: TRY`, every error of every file at once (up to 50), sorted by\n");
    buf_bytes(out, "position. A `try:` (0.17) is text to use as it is: code to paste where\n");
    buf_bytes(out, "the error is (`a as i32`, `std::trim(s)`, the missing match arms), a\n");
    buf_bytes(out, "`use` line, or a `tachyonc` command to run (`tachyonc fix --only unsafe\n");
    buf_bytes(out, "main.tach`, `tachyonc edit new-file util.tach main.tach`); VALUE in it\n");
    buf_bytes(out, "is yours to fill in.\n");
    buf_bytes(out, "An error whose fix the compiler knows exactly (0.18: a did-you-mean with\n");
    buf_bytes(out, "one name that near, a conversion, a path from `crate::`, a Rust type or\n");
    buf_bytes(out, "label respelled, a missing `use` or `pub`, a missing `gpa` argument)\n");
    buf_bytes(out, "also has `try: tachyonc fix --suggested main.tach`: one command makes\n");
    buf_bytes(out, "all of them, as one checked edit (`--dry-run` shows the diff, `tachyonc\n");
    buf_bytes(out, "undo` takes it back, `--at FILE:LINE` fixes one line's), then prints the\n");
    buf_bytes(out, "errors left. Run it instead of editing those lines by hand or with sed.\n");
    buf_bytes(out, "KIND is `tokenizer error`, `parser error`, `module error`, `type error`\n");
    buf_bytes(out, "or `unsafe`. Fix the first errors first: a parser error can hide\n");
    buf_bytes(out, "type errors in the same function. `tachyonc query show FILE:LINE` prints\n");
    buf_bytes(out, "the item at an error's position. Below: what a newcomer writes, the\n");
    buf_bytes(out, "error (short form, without the position), and the fix.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Rust habits\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let s: String = String::new();\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] unknown type 'String' | help: text is `[u8]`, a slice of bytes (string literals are one); text you build is a `std::Buf` (`Buf::new_in(gpa)`, `b.push_str(s)`, `b.as_slice()` is its `[u8]`) | try: [u8]\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "The `try:` is the type to write. Also `str` (`[u8]`), `char` (`u8`),\n");
    buf_bytes(out, "`Box`, `Rc` (`*T`), `HashSet` (`HashMap<K, bool>`), `BTreeMap`,\n");
    buf_bytes(out, "`VecDeque`, `RefCell`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::collections::HashMap;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] no 'collections' in module 'std' | help: tachyon's std is one module, without 'collections': its items are `std::NAME` | try: use std::HashMap;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "std has no submodules: `use std::{IoError, is_digit};` (`HashMap`,\n");
    buf_bytes(out, "`read_line` and std's most used names are in the prelude: no `use`).\n");
    buf_bytes(out, "`use std::io;` gets what reads stdin (`read_line`, `read_stdin_in`,\n");
    buf_bytes(out, "`Scanner`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main() -> i32 { let s = \"  a \"; let t = s.trim(); 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] no method 'trim' on type '[u8]' | help: 'trim' is no method: std's function `trim` takes the value as its first argument | try: trim(s)\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "A method std has as a function (`trim`, `sort`, `parse` as `parse_int`,\n");
    buf_bytes(out, "`split_whitespace` as `split_whitespace_in(s, gpa)`) gets the call to\n");
    buf_bytes(out, "write; another unknown method, the type's nearest methods and `tachyonc\n");
    buf_bytes(out, "query items TYPE`, which lists them all.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn get(x: &i64) -> i64 { *x }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] expected type, got '&' | help: write `*T`: one pointer type for `&T` and `&mut T`\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`*i64`; `&str` is `[u8]`. In an expression, `&mut x` is `&x`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct P { x: i64 }\n");
    buf_bytes(out, "impl P { fn get(&self) -> i64 { self.x } }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] expected identifier, got '&' | help: write the type of self: `self: *T` (a pointer: `&self`, `&mut self`) or `self: T` (a copy)\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`fn get(self: *P) -> i64`; `fn get(self)` is an error too: write\n");
    buf_bytes(out, "`self: P` for a copy.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "println!(\"{}\", 1);\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] 'println!' is a macro call: tachyon has no macros | help: write `println(f\"{1}\")`\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`println(f\"{x}\")` (0.15, `tachyonc guide formatting`). The help names\n");
    buf_bytes(out, "what replaces `vec!`, `format!`, `assert!` and the others.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "'outer: for i in 0..3 { break 'outer; }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[tokenizer error] unterminated character literal | help: a label has no quote: `outer: loop { break :outer; }` | try: outer: for i in 0..3 { break :outer; }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Labels have no quote: `outer: for i in 0..3 { break :outer; }` (the\n");
    buf_bytes(out, "try: line is yours, respelled).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let o: Option<i64> = Some(1);\n");
    buf_bytes(out, "let Some(x) = o;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] refutable pattern in 'let'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`let x = match o { Some(x) => x, None => return 1 };` (no `let else`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let n = 5;\n");
    buf_bytes(out, "let m = !n;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] expected 'bool', got 'i64'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Bitwise not is `~n`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let big = i64::MAX();\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] no associated function 'MAX' in 'i64' | help: a constant, without (): 'i64::MAX'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`i64::MAX`, `u8::MIN`, ... are constants (0.15); integer types have no\n");
    buf_bytes(out, "other associated items, and floats no limits (yet).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let s = \"add\";\n");
    buf_bytes(out, "match s { \"add\" => println(\"a\"), _ => println(\"b\") }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] expected a pattern, got 'string literal'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`if s == \"add\" { ... }`: patterns are integers, bytes, bools, variants,\n");
    buf_bytes(out, "tuples.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "#[derive(PartialEq, Debug)]\n");
    buf_bytes(out, "struct P { x: i64 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] cannot derive 'PartialEq' (derivable: Eq, Ord, Hash, Debug, Clone)\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`#[derive(Eq, Ord, Hash, Debug, Clone)]` (0.15): Eq is Rust's PartialEq\n");
    buf_bytes(out, "and Eq, Ord its PartialOrd and Ord; there is no Copy (every type copies).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn f<T>(x: T) -> T where T: Ord { x }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] expected '{', got 'where'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Bounds go in the list: `fn f<T: Ord>(x: T) -> T`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    fn helper() -> i64 { 3 }\n");
    buf_bytes(out, "    helper() as i32\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "items cannot be nested in blocks\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Move `helper` to the module level.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Types\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let x = 1;\n");
    buf_bytes(out, "x = 2;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] cannot assign to immutable variable 'x' | help: make it mutable: `let mut x`\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let a: i64 = 1;\n");
    buf_bytes(out, "let b: i32 = a;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] expected 'i32', got 'i64'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Only widening is implicit (0.15: `i32` to `i64`, `u8` to `u32`, ...):\n");
    buf_bytes(out, "narrowing is `a as i32`. The same for `1 + 1.0`, `u32` to `i32`, and\n");
    buf_bytes(out, "for `main` returning an `i64` (`n as i32`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let b: u8 = 300;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] integer literal 300 does not fit in type 'u8'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "An unsuffixed literal takes the type the code around it gives: `if ok {\n");
    buf_bytes(out, "line[i] } else { 0 }` is a `u8`, from the other branch; so are match arms\n");
    buf_bytes(out, "and array elements beside a `u8`. Alone, a literal is `i64` (`f64`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "const ORIGIN: (i64, i64) = (0, 0);\n");
    buf_bytes(out, "fn main() -> i32 { 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] constant 'ORIGIN' has type '(i64, i64)'; constants must be integers, floats, bool or string literals | help: a `static` holds other values: `static ORIGIN: (i64, i64) = ...;`\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`const GREETING: [u8] = \"hello\";` is a constant (0.14).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let x = 1;\n");
    buf_bytes(out, "if x { }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] expected 'bool', got 'i64'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`if x != 0`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let a = 1;\n");
    buf_bytes(out, "if 0 < a < 2 { }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] comparison operators cannot be chained; use parentheses\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`if 0 < a && a < 2`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn f() -> i64 { 1; }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] function 'f' body has type '()', expected 'i64'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "The value is the last expression without `;`: `fn f() -> i64 { 1 }`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let x: i64;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] 'let' without an initializer is not supported\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct P { x: i64, y: i64 }\n");
    buf_bytes(out, "fn make() -> P { P { x: 1 } }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] missing field 'y' in struct 'P' constructor\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn f(a: i64, b: i64) -> i64 { a + b }\n");
    buf_bytes(out, "fn g() -> i64 { f(1) }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] function 'f' expects 2 arguments, got 1\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "enum E { A, B, C }\n");
    buf_bytes(out, "fn f(e: E) -> i64 { match e { E::A => 1, E::B => 2 } }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] non-exhaustive match: 'E::C' is not covered | help: add an arm for it (try:), or a wildcard arm '_ =>' | try: E::C => VALUE,\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "The `try:` lists every missing pattern as an arm to paste (integers as\n");
    buf_bytes(out, "ranges: `201..=255 => VALUE,`). An unreachable arm's help gives the line\n");
    buf_bytes(out, "of the arm above that already matches all it matches.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn f() -> i64 { 1 }\n");
    buf_bytes(out, "fn main() -> i32 { 0 }\n");
    buf_bytes(out, "fn f() -> i64 { 2 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "duplicate function 'f'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "The help says where the other one is, and the two `try:` lines delete\n");
    buf_bytes(out, "either (`tachyonc edit delete main.tach:3 main.tach`); to change an item\n");
    buf_bytes(out, "in place, `tachyonc edit replace f < new.tach` instead of adding a second.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "enum E { A(i64), B }\n");
    buf_bytes(out, "fn f(e: E) -> i64 { match e { A(x) => x, B => 0 } }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] unknown variant 'A'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`E::A(x)`, or `use E::{A, B};` once.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "enum Ev { Key { code: i64, shift: bool }, Quit }\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let e = Ev::Key(1, false);\n");
    buf_bytes(out, "    match e { Ev::Key(c, _) => c as i32, Ev::Quit => 0 }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] variant 'Ev::Key' has named fields; give them by name | try: Ev::Key { code: 1, shift: false }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "A struct-like variant (0.17) is built and matched by name, as in Rust:\n");
    buf_bytes(out, "`Ev::Key { code: 1, shift: false }`, `Ev::Key { code, .. } => code`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "enum Ev { Key { code: i64, shift: bool }, Quit }\n");
    buf_bytes(out, "fn code(e: Ev) -> i64 {\n");
    buf_bytes(out, "    match e { Ev::Key { code } => code, Ev::Quit => 0 }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] the pattern of 'Ev::Key' does not mention field 'shift' | help: match it too, or end the pattern with '..' to leave the rest out | try: Ev::Key { code, .. }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "enum Ev { Key { code: i64, shift: bool }, Quit }\n");
    buf_bytes(out, "fn code(e: Ev) -> i64 { e.code }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] cannot access field 'code' on type 'Ev' | help: a variant's fields are read through a pattern (no '.field' on an enum) | try: if let Ev::Key { code, .. } = e { ... }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Slices, Vec, std\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let mut m: HashMap<i64, i64> = HashMap::new_in(gpa);\n");
    buf_bytes(out, "let a = m[0];\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] cannot index type 'HashMap<i64, i64>'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`m.get(0)` (an Option), `m.insert(0, x)`. A `Vec` and a `Buf` index as\n");
    buf_bytes(out, "their slice (0.17): `v[0]`, `v[0] = x`, `v[1..3]` are\n");
    buf_bytes(out, "`v.as_slice()[0]`, ..., checked.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let n = 3;\n");
    buf_bytes(out, "for x in n { }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] 'for' iterates over ranges, slices, arrays, iterators and types with an 'iter' method, got 'i64'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`for x in 0..n`. A type of yours iterates with `impl Iterator for T`, or\n");
    buf_bytes(out, "an `iter` method returning one (`tachyonc guide iterators`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A misspelt method, field or item gets the nearest name of its kind:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 { let mut b = Buf::new_in(gpa); b.push_string(\"x\"); 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] no method 'push_string' on type 'Buf' | help: did you mean 'push_str'?\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn sum(s: [i64]) -> i64 { s[0] }\n");
    buf_bytes(out, "fn main() -> i32 { let a = [1, 2, 3]; sum(a) as i32 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] expected '[i64]', got '[i64; 3]'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`sum(a[..])`. An array's length is `a.len()` (or `a[..].len`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let e: IoError = IoError::Read;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] unknown type 'IoError'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`use std::IoError;` (the prelude's names need no import: `tachyonc guide\n");
    buf_bytes(out, "modules`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct K { a: i64 }\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 { let m: HashMap<K, i64> = HashMap::new_in(gpa); 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] the trait 'Hash' is not implemented for 'K' | help: required by the bound 'K: Hash' of 'HashMap'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`impl Hash for K { fn hash(self: *K) -> u64 { std::hash_u64(self.a as u64) } }`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Closures and iterators (0.14)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let f = |x| x + 1;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] cannot infer the type of closure parameter 'x'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`|x: i64| x + 1`: in a `let`, nothing says what `x` is; as an argument\n");
    buf_bytes(out, "for `F: Fn(i64) -> i64` or `fn(i64) -> i64` the type comes from there.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn run(f: fn(i64) -> i64) -> i64 { f(1) }\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let k = 2;\n");
    buf_bytes(out, "    run(|x| x + k) as i32\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "make the parameter generic\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "A closure that captures is no plain `fn`: `fn run<F: Fn(i64) -> i64>(f:\n");
    buf_bytes(out, "F) -> i64`. One that captures nothing converts.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn apply<F: Fn(i64)>(f: F) { f(1); }\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut total = 0;\n");
    buf_bytes(out, "    apply(|x| { total += x; });\n");
    buf_bytes(out, "    total as i32\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "FnMut\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`Fn` takes closures that assign no captured variable: bound `F:\n");
    buf_bytes(out, "FnMut(i64)` (and call it from a `mut f: F`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn apply<F: Fn(i64) -> i64>(f: F) -> i64 { f(1) }\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let f = {\n");
    buf_bytes(out, "        let mut j = 1;\n");
    buf_bytes(out, "        |x: i64| x + j\n");
    buf_bytes(out, "    };\n");
    buf_bytes(out, "    apply(f) as i32\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "write `move`\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "The closure borrows `j` (a `let mut`), which ends with the block: `move\n");
    buf_bytes(out, "|x: i64| x + j` takes a copy, or declare `j` before the block.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## ?, conversions, arguments, formatting, derive (0.15)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn first(v: Option<i64>) -> i64 { let x = v?; x }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "'?' needs 'first' to return Option or Result; it returns 'i64'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Return `Option<i64>` (or `Result<i64, E>`), or `match` on the value.\n");
    buf_bytes(out, "`?` on an Option inside a function returning a Result needs the error:\n");
    buf_bytes(out, "`v.ok_or(MyError::Missing)?`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::ParseIntError;\n");
    buf_bytes(out, "enum AppError { Bad }\n");
    buf_bytes(out, "fn read(s: [u8]) -> Result<i64, AppError> { let n = parse_int(s)?; Ok(n) }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "'?' cannot convert the error 'ParseIntError' into 'AppError'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "The help is the impl to add: `impl From<ParseIntError> for\n");
    buf_bytes(out, "AppError { fn from(e: ParseIntError) -> AppError { ... } }`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct M { m: i64 }\n");
    buf_bytes(out, "impl Into<M> for i64 { fn into(self: i64) -> M { M { m: self } } }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "From\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Implement `From<i64> for M`; `Into` comes with it. `x.into()` needs the\n");
    buf_bytes(out, "type it converts to: `let y: M = x.into();`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn f(a: i64, b: i64) -> i64 { a + b }\n");
    buf_bytes(out, "fn main() -> i32 { f(b: 1, 2) as i32 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "a positional argument after a named one: the named arguments come last\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Named arguments follow the positional ones, in the parameters' order\n");
    buf_bytes(out, "(`f(1, c: 3, b: 2)` is an error whose `try:` is `f(1, b: 2, c: 3)`); a\n");
    buf_bytes(out, "missing one without a default gets `try: f(1, b: VALUE)`, a misspelt\n");
    buf_bytes(out, "name the nearest.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "trait T { fn f(x: i64 = 1) -> i64; }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "a default value is for a parameter of a function or an inherent method, not of a trait function\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Defaults go on trailing parameters of `fn` items and inherent methods,\n");
    buf_bytes(out, "not on trait or extern functions, closures or `fn` types.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct P { x: i64, y: i64 }\n");
    buf_bytes(out, "fn main() -> i32 { let x = 1; let p = P { x, y }; p.x as i32 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "undefined variable 'y'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "The shorthand `P { x, y }` takes locals of the fields' names: write\n");
    buf_bytes(out, "`y: VALUE`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "#[derive(Debg)]\n");
    buf_bytes(out, "struct P { x: i64 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "did you mean 'Debug'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Derivable: `Eq`, `Ord`, `Hash`, `Debug`, `Clone` (Display is written by\n");
    buf_bytes(out, "hand). Deriving a trait and implementing it too is a coherence error\n");
    buf_bytes(out, "whose help is `remove Ord from #[derive]`; deriving `Eq` needs `==` on\n");
    buf_bytes(out, "every field.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct P { x: i64 }\n");
    buf_bytes(out, "fn main() -> i32 { let p = P { x: 1 }; println(f\"{p}\"); 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "'P' does not implement Display\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Implement it (`impl Display for P { fn fmt(self: *P, f: *std::Fmt) {\n");
    buf_bytes(out, "f.write(f\"P({self.x})\"); } }`), or print with `{p:?}` and\n");
    buf_bytes(out, "`#[derive(Debug)]`. Rust's `fn fmt(&self, f: &mut Formatter) ->\n");
    buf_bytes(out, "fmt::Result` is `fn fmt(self: *P, f: *Fmt)`, with nothing to return.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main() -> i32 { let x = 1; println(f\"{f\"{x}\"}\"); 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "f-strings cannot be nested\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Compute the inner one in a `let` first. A `:` outside brackets ends a\n");
    buf_bytes(out, "hole (the spec follows): parenthesize, `{(|x: i64| x + 1)(n)}`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Generics and traits\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn biggest<T>(a: T, b: T) -> T { if a > b { a } else { b } }\n");
    buf_bytes(out, "struct P { x: i64 }\n");
    buf_bytes(out, "fn main() -> i32 { let p = biggest(P { x: 1 }, P { x: 2 }); 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] comparison requires numeric type, got 'P' | note: in instantiation of 'biggest<P>'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "A generic body is checked per use; the note names the instance.\n");
    buf_bytes(out, "Implement `Ord` for `P`, or bound `T: Ord` to say what it needs.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "trait A { fn a(self: *Self) -> i64; fn b(self: *Self) -> i64; }\n");
    buf_bytes(out, "struct S { }\n");
    buf_bytes(out, "impl A for S { fn a(self: *S) -> i64 { 1 } }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] the impl of trait 'A' is missing 'b' | help: it has no default: write it in the impl\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "trait A { fn a(self: *Self) -> i64; }\n");
    buf_bytes(out, "fn f(x: *dyn A) -> i64 { 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] 'dyn' is a reserved keyword\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "No trait objects: `fn f<T: A>(x: *T)`, or an enum of the cases.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Modules and imports\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::*;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[module error] wildcard imports are not allowed\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`use std::{Buf, HashMap};`; `tachyonc fix --only imports` writes them.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "mod m { pub fn helper() -> i64 { 1 } }\n");
    buf_bytes(out, "fn main() -> i32 { helper() as i32 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] undefined variable 'helper' | help: add `use crate::m::helper;`\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Add the `use` line the help names, or run the `try:` line, `tachyonc fix\n");
    buf_bytes(out, "--suggested main.tach`, which adds every missing one (and makes the\n");
    buf_bytes(out, "other errors' exact fixes; `fix --only imports`: the imports alone).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "In a module other than the root, a path starts in that module, or with\n");
    buf_bytes(out, "a sibling module, or one of the root (0.17): `use table::Table;` and\n");
    buf_bytes(out, "`table::f(x)` in check.tach are `crate::table::...` when `mod table;` is\n");
    buf_bytes(out, "in main.tach. A module elsewhere (`crate::a::table`) is `unknown module\n");
    buf_bytes(out, "'table'`, whose help says `crate::a::table::...` and whose `try:` is the\n");
    buf_bytes(out, "`use` line so written (in code: `use crate::a::table;`). `mod util;` with no util.tach is\n");
    buf_bytes(out, "`cannot find the file of module 'util'`, whose `try:` makes it:\n");
    buf_bytes(out, "`tachyonc edit new-file util.tach main.tach < util.tach` (the text on\n");
    buf_bytes(out, "stdin; the `mod` line that is there stays). A `mod` line for a file that\n");
    buf_bytes(out, "is next to a submodule's file belongs in the root.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main() -> i32 { let text = read_to_string(); 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] undefined variable 'read_to_string' | help: std reads stdin: `read_stdin_in(gpa)` (all of it, a Buf), `read_line(&buf)` (one line, Ok(false) at the end), `Scanner` (tokens)\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "std's items outside the prelude get their `use` line (`add `use\n");
    buf_bytes(out, "std::is_digit;``) or the nearest std name; an unknown function with neither points to `tachyonc\n");
    buf_bytes(out, "guide std`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main() -> i32 { let total = 1; std::print_int(totl); 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] undefined variable 'totl' | help: did you mean 'total'?\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "A module and an item of the same name both work, as in Rust: after `mod\n");
    buf_bytes(out, "eval; use eval::eval;`, `eval(x)` calls the function and `eval::NAME`\n");
    buf_bytes(out, "goes through the module.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "mod m { fn hidden() -> i64 { 1 } }\n");
    buf_bytes(out, "fn main() -> i32 { m::hidden() as i32 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] 'hidden' is private | help: make it public: `pub fn hidden` at\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "The help gives the declaration with `pub` and where it is (`tachyonc fix\n");
    buf_bytes(out, "--only pub` writes them all). Child modules see their parent's private items, not\n");
    buf_bytes(out, "the reverse.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## unsafe\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "extern \"C\" { fn abs(x: i32) -> i32; }\n");
    buf_bytes(out, "fn main() -> i32 { abs(-3) }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[unsafe] calling a C function is unsafe\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`unsafe { abs(-3) }`. The error's `try:`, `tachyonc fix --only unsafe\n");
    buf_bytes(out, "main.tach`, wraps every such place; the check hook prints it once at the\n");
    buf_bytes(out, "head of its report, with how many errors it answers.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn helper() -> i64 { let v: Vec<i64> = Vec::new(); v.len() }\n");
    buf_bytes(out, "fn main() -> i32 { helper() as i32 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "add the parameter `gpa: Gpa` to 'helper' and pass it down\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Allocation is explicit (0.16): the help says where the allocator comes\n");
    buf_bytes(out, "from here (this function's `gpa`, main's parameter, or one to add), and\n");
    buf_bytes(out, "the `try:`, `tachyonc fix --only alloc016 main.tach`, threads main's\n");
    buf_bytes(out, "`gpa` down to every such call.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct P { x: i64 }\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut p = P { x: 1 };\n");
    buf_bytes(out, "    let q = &p;\n");
    buf_bytes(out, "    q.x = 9;\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[unsafe] access to a field through a raw pointer is unsafe\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "A local holding a pointer is raw. Use `p.x = 9;`, or pass `&p` to a\n");
    buf_bytes(out, "function taking `*P` (a borrow, safe there).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct P { x: i64 }\n");
    buf_bytes(out, "fn get(p: *P) -> i64 { p.x }\n");
    buf_bytes(out, "fn main() -> i32 { get(&P { x: 1 }) as i32 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] cannot take address of non-lvalue expression\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`&` takes the address of a place (a variable, a field, an element):\n");
    buf_bytes(out, "`let p = P { x: 1 }; get(&p)`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn first(p: *i64) -> i64 { p[1] }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[unsafe] indexing a raw pointer is unsafe\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "A pointer is one value; for many, take a slice `[i64]`. A pointer to a\n");
    buf_bytes(out, "Vec, a Buf or a slice (`v: *Vec<i64>`) indexes what it points to, checked:\n");
    buf_bytes(out, "safely through a parameter, in `unsafe` through a raw one (`let p = &v;`:\n");
    buf_bytes(out, "index `v`).\n");
    buf_bytes(out, "`out[0] = acc` meant to write through the pointer: the error's try: is\n");
    buf_bytes(out, "`*out = acc`, safe through a borrow.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn read(x: *i64) -> i64 { *x }\n");
    buf_bytes(out, "struct H { p: *i64 }\n");
    buf_bytes(out, "fn get(h: H) -> i64 { read(h.p) }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[unsafe] passing a raw pointer to a pointer parameter is unsafe\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Only `&place` and pointer parameters are borrows; vouch for others in\n");
    buf_bytes(out, "`unsafe { read(h.p) }`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn add(p: *i64, x: i64) { *p += x; }\n");
    buf_bytes(out, "fn main() -> i32 { let f = add; 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[unsafe] using an `unsafe fn`, or a function with pointer parameters, as a value is unsafe\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`let f = unsafe { add };` and call it in `unsafe` too.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main() -> i32 { std::print_cstr(c\"x\"); 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[unsafe] calling an `unsafe fn` is unsafe\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`std::panic`, `print_cstr` and `Buf::push_cstr` take C strings and are\n");
    buf_bytes(out, "`unsafe fn`; for literals use `print(\"x\")`, `panic(\"x\")` (the prelude's,\n");
    buf_bytes(out, "safe).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## At run time\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A failed check prints its message on stderr and exits with code 101:\n");
    buf_bytes(out, "`index out of bounds: index I, length N`, `slice range out of bounds:\n");
    buf_bytes(out, "...`, `called unwrap on None`, `called unwrap on Err`, `invalid value V\n");
    buf_bytes(out, "for enum E`. A note follows (0.17). A program built with `--trace`\n");
    buf_bytes(out, "prints, instead, the failing line and the calls that led to it\n");
    buf_bytes(out, "(`tachyonc test` builds so; `guide debug`). Arithmetic never fails (it\n");
    buf_bytes(out, "wraps; `/ 0` is 0). Runaway recursion is stopped by the operating system\n");
    buf_bytes(out, "(a signal, no message).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "enum Level { Low, High }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let v: Option<i64> = None;\n");
    buf_bytes(out, "    std::print_int(v.unwrap_or(5));\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    let e = 3 as Level;\n");
    buf_bytes(out, "    std::print_int(e as i64);\n");
    buf_bytes(out, "    0\n");
