// Generated by compiler/guide/embed.sh from compiler/guide/errors.md (do
// not edit): the guide's topic 'errors'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Errors and their fixes\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Compile with `--diagnostics=short` (or run `tachyonc check`): one line\n");
    buf_bytes(out, "per error, `FILE:LINE:COL: error[KIND] MESSAGE | help: HELP | note:\n");
    buf_bytes(out, "NOTE`, every error of every file at once (up to 50), sorted by position.\n");
    buf_bytes(out, "KIND is `tokenizer error`, `parser error`, `module error`, `type error`\n");
    buf_bytes(out, "or `unsafe`. Fix the first errors first: a parser error can hide\n");
    buf_bytes(out, "type errors in the same function. `tachyonc query show FILE:LINE` prints\n");
    buf_bytes(out, "the item at an error's position. Below: what a newcomer writes, the\n");
    buf_bytes(out, "error (short form, without the position), and the fix.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Rust habits\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let s: String = String::new();\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] unknown type 'String' | help: text is `[u8]`, a slice of bytes (string literals are one); build it in a `std::Buf`\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Also `str`, `char` (use `u8`), `Box`, `usize` indices (use `i64`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn get(x: &i64) -> i64 { *x }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] expected type, got '&' | help: write `*T`: one pointer type for `&T` and `&mut T`\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`*i64`; `&str` is `[u8]`. In an expression, `&mut x` is `&x`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct P { x: i64 }\n");
    buf_bytes(out, "impl P { fn get(&self) -> i64 { self.x } }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] expected identifier, got '&' | help: write the type of self: `self: *T` (a pointer: `&self`, `&mut self`) or `self: T` (a copy)\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`fn get(self: *P) -> i64`; `fn get(self)` is an error too: write\n");
    buf_bytes(out, "`self: P` for a copy.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn f(r: Result<i64, i64>) -> Result<i64, i64> { let x = r?; Ok(x) }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] '?' is reserved for future use | help: `match r { Ok(v) => v, Err(e) => return Err(e) }` (the same for Option)\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`let x = match r { Ok(v) => v, Err(e) => return Err(e) };`\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "println!(\"{}\", 1);\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] 'println!' is a macro call: tachyon has no macros | help: `println(s)` and `print(s)` take a [u8]; numbers: `std::print_int(n)`; or build the text in a `std::Buf` (`push_str`, `push_int`) and print `b.as_slice()`\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "The help names what replaces `vec!`, `format!`, `assert!` and the others.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "'outer: for i in 0..3 { break 'outer; }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[tokenizer error] unterminated character literal\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Labels have no quote: `outer: for i in 0..3 { break :outer; }`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct P { x: i64, y: i64 }\n");
    buf_bytes(out, "fn make(x: i64) -> P { P { x, y: 0 } }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] expected ':', got ','\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Every field is written `name: value`: `P { x: x, y: 0 }`; no `..base`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let o: Option<i64> = Some(1);\n");
    buf_bytes(out, "let Some(x) = o;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] refutable pattern in 'let'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`let x = match o { Some(x) => x, None => return 1 };` (no `let else`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let n = 5;\n");
    buf_bytes(out, "let m = !n;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] expected 'bool', got 'i64'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Bitwise not is `~n`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let big = i64::MAX;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] no associated function 'MAX' in 'i64'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Write the value: `9223372036854775807`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let s = \"add\";\n");
    buf_bytes(out, "match s { \"add\" => println(\"a\"), _ => println(\"b\") }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] expected a pattern, got 'string literal'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`if s == \"add\" { ... }`: patterns are integers, bytes, bools, variants,\n");
    buf_bytes(out, "tuples.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "#[derive(Debug)]\n");
    buf_bytes(out, "struct P { x: i64 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] unknown attribute 'derive'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`==` is structural without it; there is no `Debug` printing.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn f<T>(x: T) -> T where T: Ord { x }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] expected '{', got 'where'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Bounds go in the list: `fn f<T: Ord>(x: T) -> T`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    fn helper() -> i64 { 3 }\n");
    buf_bytes(out, "    helper() as i32\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "items cannot be nested in blocks\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Move `helper` to the module level.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Types\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let x = 1;\n");
    buf_bytes(out, "x = 2;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] cannot assign to immutable variable 'x' | help: make it mutable: `let mut x`\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let a: i32 = 1;\n");
    buf_bytes(out, "let b: i64 = a;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] expected 'i64', got 'i32'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "No implicit conversion: `a as i64`. The same for `1 + 1.0`, and for\n");
    buf_bytes(out, "`main` returning an `i64` (`n as i32`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let b: u8 = 300;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] integer literal 300 does not fit in type 'u8'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "An unsuffixed literal takes the type the code around it gives: `if ok {\n");
    buf_bytes(out, "line[i] } else { 0 }` is a `u8`, from the other branch; so are match arms\n");
    buf_bytes(out, "and array elements beside a `u8`. Alone, a literal is `i64` (`f64`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "const ORIGIN: (i64, i64) = (0, 0);\n");
    buf_bytes(out, "fn main() -> i32 { 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] constant 'ORIGIN' has type '(i64, i64)'; constants must be integers, floats, bool or string literals | help: a `static` holds other values: `static ORIGIN: (i64, i64) = ...;`\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`const GREETING: [u8] = \"hello\";` is a constant (0.14).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let x = 1;\n");
    buf_bytes(out, "if x { }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] expected 'bool', got 'i64'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`if x != 0`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let a = 1;\n");
    buf_bytes(out, "if 0 < a < 2 { }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] comparison operators cannot be chained; use parentheses\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`if 0 < a && a < 2`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn f() -> i64 { 1; }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] function 'f' body has type '()', expected 'i64'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "The value is the last expression without `;`: `fn f() -> i64 { 1 }`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let x: i64;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] 'let' without an initializer is not supported\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct P { x: i64, y: i64 }\n");
    buf_bytes(out, "fn make() -> P { P { x: 1 } }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] missing field 'y' in struct 'P' constructor\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn f(a: i64, b: i64) -> i64 { a + b }\n");
    buf_bytes(out, "fn g() -> i64 { f(1) }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] function 'f' expects 2 arguments, got 1\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "enum E { A, B, C }\n");
    buf_bytes(out, "fn f(e: E) -> i64 { match e { E::A => 1, E::B => 2 } }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] non-exhaustive match: 'E::C' is not covered | help: add an arm for it, or a wildcard arm '_ =>'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "enum E { A(i64), B }\n");
    buf_bytes(out, "fn f(e: E) -> i64 { match e { A(x) => x, B => 0 } }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] unknown variant 'A'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`E::A(x)`, or `use E::{A, B};` once.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct P { x: i64 }\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let p = P { x: 1 };\n");
    buf_bytes(out, "    if p == P { x: 1 } { println(\"same\"); }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] expected ';' or '}' after expression, got ':'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "In a condition, parenthesize a struct literal: `if p == (P { x: 1 })`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Slices, Vec, std\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let mut v: Vec<i64> = Vec::new();\n");
    buf_bytes(out, "v.push(1);\n");
    buf_bytes(out, "let a = v[0];\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] cannot index type 'Vec<i64>'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`v.get(0)`, `v.set(0, x)`, `v.as_slice()[0]`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach 0.14\n");
    buf_bytes(out, "let n = 5;\n");
    buf_bytes(out, "for x in n { }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] 'for' iterates over ranges, slices, arrays, iterators and types with an 'iter' method\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`for x in 0..n`. A type of yours iterates with `impl Iterator for T`, or\n");
    buf_bytes(out, "an `iter` method returning one (`tachyonc guide iterators`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let s = \"abc\";\n");
    buf_bytes(out, "let n = s.len();\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] no method 'len' on type '[u8]' | help: `len` is a field of slices: `s.len`\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "(`Vec` has the method `len()`.) A misspelt method, field or item gets\n");
    buf_bytes(out, "the nearest name of its kind:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::Buf;\n");
    buf_bytes(out, "fn main() -> i32 { let mut b = Buf::new(); b.push_string(\"x\"); 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] no method 'push_string' on type 'Buf' | help: did you mean 'push_str'?\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn sum(s: [i64]) -> i64 { s[0] }\n");
    buf_bytes(out, "fn main() -> i32 { let a = [1, 2, 3]; sum(a) as i32 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] expected '[i64]', got '[i64; 3]'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`sum(a[..])`. An array has no `.len` either: `a[..].len`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let b = Buf::new();\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] unknown type 'Buf'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`use std::Buf;` (only the prelude names need no import).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::HashMap;\n");
    buf_bytes(out, "struct K { a: i64 }\n");
    buf_bytes(out, "fn main() -> i32 { let m: HashMap<K, i64> = HashMap::new(); 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] the trait 'Hash' is not implemented for 'K' | help: required by the bound 'K: Hash' of 'HashMap'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`impl Hash for K { fn hash(self: *K) -> u64 { std::hash_u64(self.a as u64) } }`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Closures and iterators (0.14)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let f = |x| x + 1;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] cannot infer the type of closure parameter 'x'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`|x: i64| x + 1`: in a `let`, nothing says what `x` is; as an argument\n");
    buf_bytes(out, "for `F: Fn(i64) -> i64` or `fn(i64) -> i64` the type comes from there.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn run(f: fn(i64) -> i64) -> i64 { f(1) }\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let k = 2;\n");
    buf_bytes(out, "    run(|x| x + k) as i32\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "make the parameter generic\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "A closure that captures is no plain `fn`: `fn run<F: Fn(i64) -> i64>(f:\n");
    buf_bytes(out, "F) -> i64`. One that captures nothing converts.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn apply<F: Fn(i64)>(f: F) { f(1); }\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut total = 0;\n");
    buf_bytes(out, "    apply(|x| { total += x; });\n");
    buf_bytes(out, "    total as i32\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "FnMut\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`Fn` takes closures that assign no captured variable: bound `F:\n");
    buf_bytes(out, "FnMut(i64)` (and call it from a `mut f: F`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn apply<F: Fn(i64) -> i64>(f: F) -> i64 { f(1) }\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let f = {\n");
    buf_bytes(out, "        let mut j = 1;\n");
    buf_bytes(out, "        |x: i64| x + j\n");
    buf_bytes(out, "    };\n");
    buf_bytes(out, "    apply(f) as i32\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "write `move`\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "The closure borrows `j` (a `let mut`), which ends with the block: `move\n");
    buf_bytes(out, "|x: i64| x + j` takes a copy, or declare `j` before the block.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Generics and traits\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn biggest<T>(a: T, b: T) -> T { if a > b { a } else { b } }\n");
    buf_bytes(out, "struct P { x: i64 }\n");
    buf_bytes(out, "fn main() -> i32 { let p = biggest(P { x: 1 }, P { x: 2 }); 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] comparison requires numeric type, got 'P' | note: in instantiation of 'biggest<P>'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "A generic body is checked per use; the note names the instance.\n");
    buf_bytes(out, "Implement `Ord` for `P`, or bound `T: Ord` to say what it needs.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "trait A { fn a(self: *Self) -> i64; fn b(self: *Self) -> i64; }\n");
    buf_bytes(out, "struct S { }\n");
    buf_bytes(out, "impl A for S { fn a(self: *S) -> i64 { 1 } }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] the impl of trait 'A' is missing 'b' | help: it has no default: write it in the impl\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "trait A { fn a(self: *Self) -> i64; }\n");
    buf_bytes(out, "fn f(x: *dyn A) -> i64 { 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] 'dyn' is a reserved keyword\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "No trait objects: `fn f<T: A>(x: *T)`, or an enum of the cases.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "trait Conv<T> { fn conv(self: Self) -> T; }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[parser error] traits cannot have type parameters (yet)\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Modules and imports\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::*;\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[module error] wildcard imports are not allowed\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`use std::{Buf, HashMap};`; `tachyonc fix --only imports` writes them.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "mod m { pub fn helper() -> i64 { 1 } }\n");
    buf_bytes(out, "fn main() -> i32 { helper() as i32 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] undefined variable 'helper' | help: add `use crate::m::helper;`\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Add the `use` line the help names, or run `tachyonc fix`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main() -> i32 { let text = read_to_string(); 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] undefined variable 'read_to_string' | help: std reads stdin: `std::read_stdin()` (all of it, a Buf), `std::read_line(&buf)` (one line, false at the end), `std::Scanner` (tokens)\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "std's items get their `use` line (`add `use std::read_line;``) or the\n");
    buf_bytes(out, "nearest std name; an unknown function with neither points to `tachyonc\n");
    buf_bytes(out, "guide std`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main() -> i32 { let total = 1; std::print_int(totl); 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] undefined variable 'totl' | help: did you mean 'total'?\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "A module and an item of the same name both work, as in Rust: after `mod\n");
    buf_bytes(out, "eval; use eval::eval;`, `eval(x)` calls the function and `eval::NAME`\n");
    buf_bytes(out, "goes through the module.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "mod m { fn hidden() -> i64 { 1 } }\n");
    buf_bytes(out, "fn main() -> i32 { m::hidden() as i32 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] 'hidden' is private | help: make it public: `pub fn hidden` at\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "The help gives the declaration with `pub` and where it is (`tachyonc fix\n");
    buf_bytes(out, "--only pub` writes them all). Child modules see their parent's private items, not\n");
    buf_bytes(out, "the reverse.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## unsafe\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "extern \"C\" { fn abs(x: i32) -> i32; }\n");
    buf_bytes(out, "fn main() -> i32 { abs(-3) }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[unsafe] calling a C function is unsafe\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`unsafe { abs(-3) }`. `tachyonc fix --only unsafe` wraps every such\n");
    buf_bytes(out, "place.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct P { x: i64 }\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut p = P { x: 1 };\n");
    buf_bytes(out, "    let q = &p;\n");
    buf_bytes(out, "    q.x = 9;\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[unsafe] access to a field through a raw pointer is unsafe\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "A local holding a pointer is raw. Use `p.x = 9;`, or pass `&p` to a\n");
    buf_bytes(out, "function taking `*P` (a borrow, safe there).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct P { x: i64 }\n");
    buf_bytes(out, "fn get(p: *P) -> i64 { p.x }\n");
    buf_bytes(out, "fn main() -> i32 { get(&P { x: 1 }) as i32 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] cannot take address of non-lvalue expression\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`&` takes the address of a place (a variable, a field, an element):\n");
    buf_bytes(out, "`let p = P { x: 1 }; get(&p)`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn first(p: *i64) -> i64 { p[1] }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[unsafe] indexing a raw pointer is unsafe\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "A pointer is one value; for many, take a slice `[i64]`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn read(x: *i64) -> i64 { *x }\n");
    buf_bytes(out, "struct H { p: *i64 }\n");
    buf_bytes(out, "fn get(h: H) -> i64 { read(h.p) }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[unsafe] passing a raw pointer to a pointer parameter is unsafe\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "Only `&place` and pointer parameters are borrows; vouch for others in\n");
    buf_bytes(out, "`unsafe { read(h.p) }`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn add(p: *i64, x: i64) { *p += x; }\n");
    buf_bytes(out, "fn main() -> i32 { let f = add; 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[unsafe] using an `unsafe fn`, or a function with pointer parameters, as a value is unsafe\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`let f = unsafe { add };` and call it in `unsafe` too.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main() -> i32 { std::print_cstr(c\"x\"); 0 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[unsafe] calling an `unsafe fn` is unsafe\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "`std::panic`, `print_cstr` and `Buf::push_cstr` take C strings and are\n");
    buf_bytes(out, "`unsafe fn`; for literals use `print(\"x\")`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## At run time\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A failed check prints one line on stderr and exits with code 101:\n");
    buf_bytes(out, "`index out of bounds: index I, length N`, `slice range out of bounds:\n");
    buf_bytes(out, "...`, `called unwrap on None`, `called unwrap on Err`, `invalid value V\n");
    buf_bytes(out, "for enum E`. Arithmetic never fails (it wraps; `/ 0` is 0). Runaway\n");
    buf_bytes(out, "recursion is stopped by the operating system (a signal, no message).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "enum Level { Low, High }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let v: Option<i64> = None;\n");
    buf_bytes(out, "    std::print_int(v.unwrap_or(5));\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    let e = 3 as Level;\n");
    buf_bytes(out, "    std::print_int(e as i64);\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out (exit 101)\n");
    buf_bytes(out, "5\n");
    buf_bytes(out, "invalid value 3 for enum Level\n");
    buf_bytes(out, "```\n");
}
