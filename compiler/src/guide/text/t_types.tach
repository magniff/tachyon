// Generated by compiler/guide/embed.sh from compiler/guide/types.md (do
// not edit): the guide's topic 'types'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Types\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| type | |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `i8 i16 i32 i64 isize`, `u8 u16 u32 u64 usize` | integers; literals are `i64` unless the context or a suffix says |\n");
    buf_bytes(out, "| `f32`, `f64` | IEEE floats; literals are `f64` |\n");
    buf_bytes(out, "| `bool` | `true`, `false` |\n");
    buf_bytes(out, "| `()` | the unit type |\n");
    buf_bytes(out, "| `!` | never: `return`, `break`, `loop` without `break`, `fn f() -> !` |\n");
    buf_bytes(out, "| `(A, B)` | tuples: `t.0` (through a pointer too: `p.0`); `(x,)` has one element |\n");
    buf_bytes(out, "| `[T; N]` | an array, a value; `N` a constant expression |\n");
    buf_bytes(out, "| `[T]` | a slice: `.ptr` (a `*T`) and `.len` (an `i64`) |\n");
    buf_bytes(out, "| `*T` | a pointer (`*u8` is also C's `void *` and `char *`) |\n");
    buf_bytes(out, "| `fn(A, B) -> R` | a plain function value |\n");
    buf_bytes(out, "| `extern \"C\" fn(A) -> R` | a C function pointer, another type |\n");
    buf_bytes(out, "| `S`, `E`, `S<T>` | structs, enums, unions, their instances |\n");
    buf_bytes(out, "| `type X = distinct T` | a type of its own with T's representation (0.18) |\n");
    buf_bytes(out, "| `std::NonNull<T>` | a `*T` that is never null; `Option<NonNull<T>>` is one pointer |\n");
    buf_bytes(out, "| `v2f64 v4f32 v2i64 v4i32 v8i16 v16i8` | SIMD vectors of 16 bytes |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Numbers\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Only widening converts implicitly (0.15: a narrower integer to a wider\n");
    buf_bytes(out, "one, `tachyonc guide conversions`); otherwise both sides of `+`, `==`,\n");
    buf_bytes(out, "`=` have one type, and `as` converts between numeric types (and `bool` to an integer,\n");
    buf_bytes(out, "fieldless enums to integers and back). An unsuffixed literal takes the\n");
    buf_bytes(out, "type the context needs (`let b: u8 = 7;`, `x + 1` with `x: u32`), and\n");
    buf_bytes(out, "must fit: `let b: u8 = 300;` is an error.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Every operation is defined, the same at every optimization level:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let max: i64 = 9223372036854775807;\n");
    buf_bytes(out, "let b: u8 = 250;\n");
    buf_bytes(out, "let s: u32 = 1;\n");
    buf_bytes(out, "std::print_int(max + 1); print(\" \");                // wraps\n");
    buf_bytes(out, "std::print_int((b + 10) as i64); print(\" \");        // u8 wraps: 4\n");
    buf_bytes(out, "std::print_int(10 / 0); print(\" \");                 // 0\n");
    buf_bytes(out, "std::print_int(10 % 0); print(\" \");                 // 10\n");
    buf_bytes(out, "std::print_int(-7 % 3); print(\" \");                 // the sign of the dividend\n");
    buf_bytes(out, "std::print_int((s << 33) as i64); print(\" \");       // the amount mod 32 for narrow types\n");
    buf_bytes(out, "std::print_int(1e30 as i64 - max); print(\" \");      // float to int saturates\n");
    buf_bytes(out, "std::print_int(-1.9 as i64); print(\" \");            // truncates\n");
    buf_bytes(out, "std::print_int((0.0 / 0.0) as i64);                 // NaN becomes 0\n");
    buf_bytes(out, "println(\"\");\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "-9223372036854775808 4 0 10 -1 2 0 -1 0\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Floats are IEEE 754 without fast-math; `1.0 / 0.0` is infinity, and\n");
    buf_bytes(out, "`NaN != NaN`. There are no `MIN`/`MAX` constants, no `abs`, `pow` or\n");
    buf_bytes(out, "`sqrt` methods: write them, or call C's math functions\n");
    buf_bytes(out, "(`import \"math.h\" as m;`, `unsafe { m::sqrt(x) }`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Arrays and slices\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let mut grid = [[0; 3]; 2];       // [[i64; 3]; 2]\n");
    buf_bytes(out, "grid[1][2] = 5;\n");
    buf_bytes(out, "let copy = grid;                  // arrays are values: copied whole\n");
    buf_bytes(out, "grid[0][0] = 1;\n");
    buf_bytes(out, "let row = grid[1][..];            // [i64]: a view of the array\n");
    buf_bytes(out, "let part = row[1..];              // checked: lo <= hi <= len\n");
    buf_bytes(out, "std::print_int(copy[0][0] + part.len + part[1]);\n");
    buf_bytes(out, "println(\"\");\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "7\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Indexing (`a[i]`, any integer type) and slicing (`a[lo..hi]`, `a[..hi]`,\n");
    buf_bytes(out, "`a[lo..]`, `a[..]`) are checked: out of bounds, the program prints\n");
    buf_bytes(out, "`index out of bounds: index I, length N` and exits with 101. An array\n");
    buf_bytes(out, "has no `.len` field: `a.len()` (0.17), or slice it: `a[..].len`. A function taking `[T]` gets\n");
    buf_bytes(out, "`a[..]`, not `a`. A slice of a raw pointer, `p[0..n]`, is unchecked and\n");
    buf_bytes(out, "unsafe.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## References and pointers\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`&place` makes a shared reference `&T`, `&mut place` an exclusive one\n");
    buf_bytes(out, "`&mut T` (0.17): both are checked (`tachyonc guide memory`), safe to read\n");
    buf_bytes(out, "and write through, kept in locals and fields. `*r` is the value, `r.f`\n");
    buf_bytes(out, "reaches a field (and `r.m()` calls a method) through it. A raw pointer\n");
    buf_bytes(out, "`*T` (from C, from a reference where a `*T` is expected, `0 as *T` for\n");
    buf_bytes(out, "null) is dereferenced only in `unsafe`. There is no pointer arithmetic:\n");
    buf_bytes(out, "index a raw pointer (`p[i]`, `&p[i]`) in unsafe code, or cast through\n");
    buf_bytes(out, "`i64`. On a reference to a Vec, a Buf or a slice, `p[i]` indexes the one\n");
    buf_bytes(out, "it points to, checked: safe through a reference, `unsafe` through a raw\n");
    buf_bytes(out, "pointer. A `*T` parameter is raw like any `*T` (0.18.1); `tachyonc fix --values`\n");
    buf_bytes(out, "makes it a reference.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct Counter { n: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn bump(c: &mut Counter) { c.n += 1; }   // a reference: safe\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut c = Counter { n: 0 };\n");
    buf_bytes(out, "    bump(&mut c);\n");
    buf_bytes(out, "    let r = &mut c;                      // a reference in a local: safe\n");
    buf_bytes(out, "    r.n += 5;\n");
    buf_bytes(out, "    let p: *Counter = &mut c;            // a raw pointer: unsafe\n");
    buf_bytes(out, "    unsafe { p.n += 5; }\n");
    buf_bytes(out, "    std::print_int(c.n);\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "11\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Distinct types\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`type NodeId = distinct i64;` is a new type, as Go's defined types are:\n");
    buf_bytes(out, "T's representation and ABI, but not interchangeable with T. `as`\n");
    buf_bytes(out, "converts both ways for free (`id as i64`, `n as NodeId`); a literal is\n");
    buf_bytes(out, "the one implicit conversion. T's operators work between two values of\n");
    buf_bytes(out, "the type, or one and a literal (`a + 1`, `m / 2.0`, `a < b` is a bool);\n");
    buf_bytes(out, "mixing it with T is `distinct.mix`, whose `try:` is the `as` to write\n");
    buf_bytes(out, "(`tachyonc fix --suggested` writes them all). It has T's Eq, Ord, Hash,\n");
    buf_bytes(out, "Debug, Display and Clone (`Vec<NodeId>` sorts, prints, is a HashMap key)\n");
    buf_bytes(out, "and T's literal patterns, but none of T's methods (`distinct.method`):\n");
    buf_bytes(out, "`impl NodeId { .. }` adds its own. `type Id<T> = distinct i64;` makes\n");
    buf_bytes(out, "`Id<Node>` and `Id<Edge>` two types. T is plain: numbers, bool, raw\n");
    buf_bytes(out, "pointers, and structs, tuples and arrays of them; not owned (a Vec, a\n");
    buf_bytes(out, "type with a Drop impl) nor a view (a slice, a `&T`) (`distinct.kind`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "type NodeId = distinct i64;\n");
    buf_bytes(out, "type Meters = distinct f64;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl NodeId {\n");
    buf_bytes(out, "    fn next(self: NodeId) -> NodeId { self + 1 }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() {\n");
    buf_bytes(out, "    let a: NodeId = 3;\n");
    buf_bytes(out, "    let b = a.next() * 2;              // NodeId\n");
    buf_bytes(out, "    let x: f64 = 0.5;\n");
    buf_bytes(out, "    let d: Meters = 2.0;\n");
    buf_bytes(out, "    let e = d + x as Meters;           // `d + x` is distinct.mix\n");
    buf_bytes(out, "    println(f\"{b} {a < b} {e} {b as i64 + 1}\");\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "8 true 2.5 9\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`std::NonNull<T>` is std's `distinct *T` that is never null:\n");
    buf_bytes(out, "`NonNull::new(p)` is `Some` unless p is null, `p as NonNull<T>` is\n");
    buf_bytes(out, "checked (a null p exits 101: `null pointer made NonNull`), `p.as_ptr()`\n");
    buf_bytes(out, "(or `p as *T`) is the raw pointer, and dereferencing stays `unsafe`.\n");
    buf_bytes(out, "`Option<NonNull<T>>` is one pointer, `None` the null one, so it is the\n");
    buf_bytes(out, "field type of a nullable link and C's nullable pointer in an `extern\n");
    buf_bytes(out, "\"C\"` signature; a C header's `_Nonnull` pointers import as NonNull (a\n");
    buf_bytes(out, "result is C's promise, which the unsafe call vouches for). `_Nonnull`\n");
    buf_bytes(out, "is clang's nullability qualifier: imports read headers as the system's\n");
    buf_bytes(out, "C compiler does, so they see it where that compiler is clang (macOS);\n");
    buf_bytes(out, "with gcc (most Linux systems) a header has no such qualifier and its\n");
    buf_bytes(out, "pointers import as `*T`. Any `*T` has `p.is_null()`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::NonNull;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "struct Node { value: i64, next: Option<NonNull<Node>> }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() {\n");
    buf_bytes(out, "    let b = Node { value: 2, next: None };\n");
    buf_bytes(out, "    let a = Node { value: 1, next: NonNull::new(&b) };\n");
    buf_bytes(out, "    let mut total = 0;\n");
    buf_bytes(out, "    let mut cur = NonNull::new(&a);\n");
    buf_bytes(out, "    while let Some(p) = cur {\n");
    buf_bytes(out, "        unsafe {\n");
    buf_bytes(out, "            total += (*p.as_ptr()).value;\n");
    buf_bytes(out, "            cur = (*p.as_ptr()).next;\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    println(f\"{total} {size_of(Option<NonNull<Node>>)}\");\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "3 8\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Enums as integers\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "#[repr(u8)]\n");
    buf_bytes(out, "enum Level { Low = 1, Mid = 5, High = 9 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let l = Level::Mid;\n");
    buf_bytes(out, "    std::print_int(l as i64);\n");
    buf_bytes(out, "    if Level::Low < l { println(\" above low\"); }   // declaration order\n");
    buf_bytes(out, "    let back = 9 as Level;                         // checked: 4 as Level exits 101\n");
    buf_bytes(out, "    if back == Level::High { println(\"high\"); }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "5 above low\n");
    buf_bytes(out, "high\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Layout\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`size_of(T)` and `align_of(T)` are constants. Tachyon's own types have\n");
    buf_bytes(out, "no guaranteed layout (field order, enum tags, slices); `#[repr(C)]`\n");
    buf_bytes(out, "gives C's. See `tachyonc guide c-interop`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## SIMD vectors\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`v4f32(a, b, c, d)`, `v4f32::splat(x)`, `v4f32::load(s, i)` (checked)\n");
    buf_bytes(out, "make vectors; `+ - *` work lane by lane on all six types, `/` on float\n");
    buf_bytes(out, "vectors, `& | ^` on integer ones; comparisons give a mask\n");
    buf_bytes(out, "(`m.select(a, b)`); `v.lane(i)`, `v.with_lane(i, x)`, `v.sum()`,\n");
    buf_bytes(out, "`v.store(s, i)`. They are not FFI-safe.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let xs: [f32; 4] = [1.0, 2.0, 3.0, 4.0];\n");
    buf_bytes(out, "let v = v4f32::load(xs[..], 0) * v4f32::splat(2.0);\n");
    buf_bytes(out, "std::print_int(v.sum() as i64);\n");
    buf_bytes(out, "println(\"\");\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "20\n");
    buf_bytes(out, "```\n");
}
