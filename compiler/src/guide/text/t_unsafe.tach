// Generated by compiler/guide/embed.sh from compiler/guide/unsafe.md (do
// not edit): the guide's topic 'unsafe'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# unsafe\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Safe code has no undefined behaviour: arithmetic wraps, `/ 0` is 0,\n");
    buf_bytes(out, "indexing is checked, every variable is initialized. What can have\n");
    buf_bytes(out, "undefined behaviour is an *unsafe operation*, allowed only inside\n");
    buf_bytes(out, "`unsafe { ... }` (an expression: `let x = unsafe { *p };`) or in the body\n");
    buf_bytes(out, "of an `unsafe fn`:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- calling a C function (an `extern \"C\"` declaration, an `import`ed one,\n");
    buf_bytes(out, "  an `extern \"C\" fn` pointer) or an `unsafe fn`;\n");
    buf_bytes(out, "- dereferencing a raw pointer: `*p`, `p.f`, a method called through `p`;\n");
    buf_bytes(out, "- indexing or slicing a raw pointer: `p[i]`, `p[lo..hi]` (unchecked);\n");
    buf_bytes(out, "- casting an integer to a pointer (except the literal `0`, null);\n");
    buf_bytes(out, "- reading a union's field;\n");
    buf_bytes(out, "- using an `unsafe fn` as a value.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A `*T` is raw wherever it comes from, a parameter too (0.18.1): in Rust's\n");
    buf_bytes(out, "terms `*mut T` / `*const T`. Passing, comparing and casting one is safe;\n");
    buf_bytes(out, "dereferencing it is not.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## References and raw pointers\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`&T` and `&mut T` (0.17) are references: checked by the compiler\n");
    buf_bytes(out, "(`guide memory`, `guide views`), so dereferencing one is safe. `*T` is\n");
    buf_bytes(out, "the raw pointer, the escape hatch: nothing checks what it points to.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `&place` and `&mut place` are references, kept in a local too (`let r\n");
    buf_bytes(out, "  = &mut x; r.f = 1;`); a reference converts to a raw `*T` wherever one\n");
    buf_bytes(out, "  is expected (`malloc`'s callers, C's parameters).\n");
    buf_bytes(out, "- A raw pointer: a `*T` local or field, `malloc`'s result, `c\"...\"`\n");
    buf_bytes(out, "  (read-only memory), and `&(*p).f` of a place reached through a raw\n");
    buf_bytes(out, "  `p`. In `unsafe` code `&*p` makes a reference of it: the code vouches.\n");
    buf_bytes(out, "- Every `*T` is raw, a parameter too, `mut` or not (0.18.1; before, a\n");
    buf_bytes(out, "  non-`mut` `*T` parameter was checked as `&mut T`). Borrowing is `&T` /\n");
    buf_bytes(out, "  `&mut T`: `fn read(x: &i64)`. `tachyonc fix --values` makes such\n");
    buf_bytes(out, "  parameters references, with their calls (it keeps raw a pointer that is\n");
    buf_bytes(out, "  indexed, compared, cast, stored or given to C); `fix --only unsafe`\n");
    buf_bytes(out, "  wraps the rest. `&x` and `&mut x` convert to a `*T` parameter.\n");
    buf_bytes(out, "- `p[i]` on a reference to a Vec, a Buf or a slice is the element of the\n");
    buf_bytes(out, "  one it points to, checked; `p[i]` on a raw pointer is pointer\n");
    buf_bytes(out, "  arithmetic, unchecked and unsafe. On `out: &mut i64` the value is\n");
    buf_bytes(out, "  `*out` (`*out = acc`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "extern \"C\" {\n");
    buf_bytes(out, "    fn malloc(n: u64) -> *u8;\n");
    buf_bytes(out, "    fn free(p: *u8);\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "struct Stats { count: i64, sum: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn add(s: &mut Stats, x: i64) {      // a reference: safe to use\n");
    buf_bytes(out, "    s.count += 1;\n");
    buf_bytes(out, "    s.sum += x;\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// The caller promises that p points to n valid i64s.\n");
    buf_bytes(out, "unsafe fn total(p: *i64, n: i64) -> i64 {\n");
    buf_bytes(out, "    let mut t = 0;\n");
    buf_bytes(out, "    for i in 0..n { t += p[i]; }      // allowed: the body is unsafe code\n");
    buf_bytes(out, "    t\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut st = Stats { count: 0, sum: 0 };\n");
    buf_bytes(out, "    add(&mut st, 5);\n");
    buf_bytes(out, "    add(&mut st, 7);\n");
    buf_bytes(out, "    let p = unsafe { malloc(3 * 8) as *i64 };\n");
    buf_bytes(out, "    defer { unsafe { free(p as *u8); } }\n");
    buf_bytes(out, "    unsafe {\n");
    buf_bytes(out, "        p[0] = 1;\n");
    buf_bytes(out, "        p[1] = 2;\n");
    buf_bytes(out, "        p[2] = 3;\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    let raw = unsafe { p[0..3] };     // a slice of raw memory: valid while p is\n");
    buf_bytes(out, "    std::print_int(st.sum + unsafe { total(p, 3) } + raw[2]);\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "21\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Write the contract of an `unsafe fn` in its comment: its callers take it\n");
    buf_bytes(out, "on. What unsafe code must keep so that the safe code around it stays\n");
    buf_bytes(out, "defined:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- every pointer it hands to safe code as a reference points to live\n");
    buf_bytes(out, "  memory of its type, and every slice it makes is valid for its length\n");
    buf_bytes(out, "  while it is used;\n");
    buf_bytes(out, "- it makes no second live alias of a place under a `&mut` (the optimizer\n");
    buf_bytes(out, "  relies on a `&mut` parameter being the only way to its memory);\n");
    buf_bytes(out, "- a type whose safe methods manage memory through raw pointers (a\n");
    buf_bytes(out, "  growable buffer of its own) implements `Drop`: that makes it owned and\n");
    buf_bytes(out, "  move-only, so a copy cannot outlive a reallocation.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Tools\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `tachyonc fix --only unsafe` puts each unsafe operation outside unsafe\n");
    buf_bytes(out, "  code into an `unsafe { }` block (the statement around it).\n");
    buf_bytes(out, "- `tachyonc --check-unsafe -O1 prog.tach -o prog` checks raw-pointer\n");
    buf_bytes(out, "  accesses against the heap blocks at run time (`malloc`/`free`):\n");
    buf_bytes(out, "  out-of-bounds and use-after-free stop the program with `unsafe access\n");
    buf_bytes(out, "  ...` and exit 101. Programs run tens of times slower.\n");
    buf_bytes(out, "- `tachyonc --check-alloc` (0.16) puts every block of Gpa on pages of\n");
    buf_bytes(out, "  its own: a use after free through raw pointers faults and is reported\n");
    buf_bytes(out, "  with where the block was allocated and freed;\n");
    buf_bytes(out, "  bad frees and leaks are reported too (`tachyonc guide memory`). With\n");
    buf_bytes(out, "  `--check-unsafe`, raw accesses are checked against those blocks.\n");
    buf_bytes(out, "- Statics, `static mut` included, are safe: tachyon has no threads.\n");
}
