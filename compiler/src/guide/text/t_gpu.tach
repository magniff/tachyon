// Generated by compiler/guide/embed.sh from compiler/guide/gpu.md (do
// not edit): the guide's topic 'gpu'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# GPU: std::gpu (0.22)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`std::gpu` is compute and rendering on the GPU, on wgpu's model: an\n");
    buf_bytes(out, "`Instance`, an `Adapter`, a `Device` and its `Queue`; `Buffer`s,\n");
    buf_bytes(out, "`Texture`s and their views, `Sampler`s; a `Shader`, bind groups and\n");
    buf_bytes(out, "compute and render pipelines; an `Encoder` whose passes are closures.\n");
    buf_bytes(out, "On macOS it runs on Metal. Link the Objective-C runtime; std opens\n");
    buf_bytes(out, "Metal itself (no `-framework`):\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```sh\n");
    buf_bytes(out, "tachyonc main.tach -l objc -o prog\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Lifecycle\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Every object is an owned value (`guide memory`): it is dropped at the\n");
    buf_bytes(out, "end of its scope, and dropping a resource the GPU still uses is safe\n");
    buf_bytes(out, "(the submitted work keeps it alive). There is no `free`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| object | made by | used by |\n");
    buf_bytes(out, "|---|---|---|\n");
    buf_bytes(out, "| `Device`, `Queue` | `inst.adapter()?.device()?` | everything below; `queue.submit(cmds)` |\n");
    buf_bytes(out, "| `Buffer` | `dev.buffer(size, usage)`, `dev.buffer_init(bytes, usage)` | bind groups, copies, `map_read(dev)`, `map_write(dev)` + `unmap(dev)` |\n");
    buf_bytes(out, "| `Texture`, `TextureView` | `dev.texture(w, h, format, usage: ..)`, `tex.view()` | bind groups, render passes, copies |\n");
    buf_bytes(out, "| `Shader` | `dev.shader_wgsl(wgsl)?` (WGSL text), or `dev.shader(src)?` with `src` a `ShaderSource::msl(code, reflection)` | pipelines |\n");
    buf_bytes(out, "| `ComputePipeline`, `RenderPipeline` | `dev.compute_pipeline(shader, \"main\")?`, `dev.render_pipeline(desc)?` | passes; `pipe.bind_layout(0)` |\n");
    buf_bytes(out, "| `BindGroup` | `dev.bind_group(pipe.bind_layout(0), [gpu::bind(0, buf)][..])` | `pass.set_bind_group(0, g)` |\n");
    buf_bytes(out, "| `Encoder`, `Commands` | `dev.encoder()`, `enc.finish()` | `enc.compute_pass(\\|pass\\| ..)`, `enc.render_pass(desc, \\|pass\\| ..)`, copies |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A mapped buffer is a view (`guide views`): `let b = buf.map_read(dev);`\n");
    buf_bytes(out, "waits for the GPU and views the buffer, which cannot be used while `b`\n");
    buf_bytes(out, "is. Shaders come from the shader compiler as a `ShaderSource`: the code\n");
    buf_bytes(out, "for the device's `caps().shader_kind` (MSL on Metal) and its\n");
    buf_bytes(out, "`Reflection` (entry points, bindings and their native slots).\n");
    buf_bytes(out, "`dev.shader_wgsl(text)` does it all: `std::gpu::wgsl` translates the\n");
    buf_bytes(out, "WGSL and its reflection feeds the pipelines (a rejected shader is a\n");
    buf_bytes(out, "`gpu::Error::Shader` with its `LINE:COL: error wgsl.CODE` line); a\n");
    buf_bytes(out, "program can also write both by hand, as below.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Compute\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::gpu;\n");
    buf_bytes(out, "use std::gpu::{BindingType, BufferUsage, Reflection, ShaderSource};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> Result<(), gpu::Error> {\n");
    buf_bytes(out, "    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, "    let (dev, var queue) = inst.adapter()?.device()?;\n");
    buf_bytes(out, "    let code = \"kernel void k(device uint* xs [[buffer(0)]], uint i [[thread_position_in_grid]]) { xs[i] = xs[i] * xs[i]; }\";\n");
    buf_bytes(out, "    var refl = Reflection::new_in(gpa);\n");
    buf_bytes(out, "    refl.compute(\"main\", \"k\", 64);                         // entry, its MSL name, workgroup\n");
    buf_bytes(out, "    refl.bind(0, 0, BindingType::Storage, compute: 0);     // @group(0) @binding(0): buffer(0)\n");
    buf_bytes(out, "    let src = ShaderSource::msl(code, refl);\n");
    buf_bytes(out, "    let shader = dev.shader(src)?;\n");
    buf_bytes(out, "    let pipe = dev.compute_pipeline(shader, \"main\")?;\n");
    buf_bytes(out, "    var xs: Vec<u32> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    for i in 0..64 { xs.push(i as u32); }\n");
    buf_bytes(out, "    var buf = dev.buffer_init(gpu::bytes_of_u32(xs.as_slice()),\n");
    buf_bytes(out, "        BufferUsage::STORAGE | BufferUsage::MAP_READ);\n");
    buf_bytes(out, "    let group = dev.bind_group(pipe.bind_layout(0), [gpu::bind(0, buf)][..]);\n");
    buf_bytes(out, "    var enc = dev.encoder();\n");
    buf_bytes(out, "    enc.compute_pass(|pass| {\n");
    buf_bytes(out, "        pass.set_pipeline(pipe);\n");
    buf_bytes(out, "        pass.set_bind_group(0, group);\n");
    buf_bytes(out, "        pass.dispatch(1); // one workgroup of 64\n");
    buf_bytes(out, "    });\n");
    buf_bytes(out, "    queue.submit(enc.finish());\n");
    buf_bytes(out, "    let squares = gpu::u32s(buf.map_read(dev));\n");
    buf_bytes(out, "    println(f\"{squares[3]} {squares[63]}\");\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "9 3969\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The same kernel in WGSL: `@group(g) @binding(b)` are the bind groups'\n");
    buf_bytes(out, "numbers, and a runtime-sized array is bounds-checked against the buffer\n");
    buf_bytes(out, "bound there.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::gpu;\n");
    buf_bytes(out, "use std::gpu::BufferUsage;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "const SQUARE: [u8] = \"@group(0) @binding(0) var<storage, read_write> xs: array<u32>;\\n\\\n");
    buf_bytes(out, "    @compute @workgroup_size(64) fn main(@builtin(global_invocation_id) id: vec3<u32>) {\\n\\\n");
    buf_bytes(out, "    xs[id.x] = xs[id.x] * xs[id.x];\\n\\\n");
    buf_bytes(out, "    }\";\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> Result<(), gpu::Error> {\n");
    buf_bytes(out, "    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, "    let (dev, var queue) = inst.adapter()?.device()?;\n");
    buf_bytes(out, "    let shader = dev.shader_wgsl(SQUARE)?;\n");
    buf_bytes(out, "    let pipe = dev.compute_pipeline(shader, \"main\")?;\n");
    buf_bytes(out, "    var xs: Vec<u32> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    for i in 0..64 { xs.push(i as u32); }\n");
    buf_bytes(out, "    var buf = dev.buffer_init(gpu::bytes_of_u32(xs.as_slice()),\n");
    buf_bytes(out, "        BufferUsage::STORAGE | BufferUsage::MAP_READ);\n");
    buf_bytes(out, "    let group = dev.bind_group(pipe.bind_layout(0), [gpu::bind(0, buf)][..]);\n");
    buf_bytes(out, "    var enc = dev.encoder();\n");
    buf_bytes(out, "    enc.compute_pass(|pass| {\n");
    buf_bytes(out, "        pass.set_pipeline(pipe);\n");
    buf_bytes(out, "        pass.set_bind_group(0, group);\n");
    buf_bytes(out, "        pass.dispatch(1);\n");
    buf_bytes(out, "    });\n");
    buf_bytes(out, "    queue.submit(enc.finish());\n");
    buf_bytes(out, "    let squares = gpu::u32s(buf.map_read(dev));\n");
    buf_bytes(out, "    println(f\"{squares[3]} {squares[63]}\");\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "9 3969\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Render to a texture\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::gpu;\n");
    buf_bytes(out, "use std::gpu::{BufferUsage, Format, PassDesc, Reflection, ShaderSource, TextureUsage};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> Result<(), gpu::Error> {\n");
    buf_bytes(out, "    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, "    let (dev, var queue) = inst.adapter()?.device()?;\n");
    buf_bytes(out, "    let code = \"#include <metal_stdlib>\\nusing namespace metal;\\nvertex float4 vs(uint v [[vertex_id]]) { float2 p[3] = { float2(-1, -1), float2(3, -1), float2(-1, 3) }; return float4(p[v], 0, 1); }\\nfragment float4 fs() { return float4(1, 0.5, 0, 1); }\\n\";\n");
    buf_bytes(out, "    var refl = Reflection::new_in(gpa);\n");
    buf_bytes(out, "    refl.vertex(\"vs\", \"vs\");\n");
    buf_bytes(out, "    refl.fragment(\"fs\", \"fs\");\n");
    buf_bytes(out, "    let src = ShaderSource::msl(code, refl);\n");
    buf_bytes(out, "    let shader = dev.shader(src)?;\n");
    buf_bytes(out, "    let desc = gpu::RenderDesc::new(shader, \"vs\", \"fs\", Format::Rgba8Unorm);\n");
    buf_bytes(out, "    let pipe = dev.render_pipeline(desc)?;\n");
    buf_bytes(out, "    let tex = dev.texture(8, 8, Format::Rgba8Unorm, usage: TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC);\n");
    buf_bytes(out, "    let view = tex.view();\n");
    buf_bytes(out, "    var out = dev.buffer(256 * 8, BufferUsage::MAP_READ | BufferUsage::COPY_DST);\n");
    buf_bytes(out, "    var enc = dev.encoder();\n");
    buf_bytes(out, "    enc.render_pass(PassDesc::color(view), |pass| { // cleared to black, then drawn\n");
    buf_bytes(out, "        pass.set_pipeline(pipe);\n");
    buf_bytes(out, "        pass.draw(0..3, 0..1); // a triangle over the whole target\n");
    buf_bytes(out, "    });\n");
    buf_bytes(out, "    enc.copy_texture_to_buffer(tex, out, 256); // rows 256 bytes apart\n");
    buf_bytes(out, "    queue.submit(enc.finish());\n");
    buf_bytes(out, "    let px = out.map_read(dev);\n");
    buf_bytes(out, "    println(f\"{px[0]} {px[1]} {px[2]} {px[3]}\");\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "255 128 0 255\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Capabilities\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`dev.caps()` says what the device can do: `compute`, `render`,\n");
    buf_bytes(out, "`surfaces`, `textures`, `unified_memory` (information only: mapping\n");
    buf_bytes(out, "behaves the same either way) and `shader_kind` (`ShaderKind::Msl`,\n");
    buf_bytes(out, "`Spirv`, `Ptx`). A compute-only backend reports `render: false`, and\n");
    buf_bytes(out, "every render, texture and surface call `requires` its flag\n");
    buf_bytes(out, "(`gpu.unsupported`). Backends implement `std::gpu::hal::Api` (and\n");
    buf_bytes(out, "`hal::Render` when they draw); the API never depends on one's memory\n");
    buf_bytes(out, "model.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Contracts\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Misuse stops the program at the call, `FILE:LINE:COL: gpu.CODE: ...`,\n");
    buf_bytes(out, "exit 101 (`guide contracts`); what can fail however correct the program\n");
    buf_bytes(out, "is (no adapter, a shader the driver rejects) is a `gpu::Error`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| code | the rule | the fix |\n");
    buf_bytes(out, "|---|---|---|\n");
    buf_bytes(out, "| `gpu.usage` | a buffer or texture used without the usage flag that allows it | add it at creation: `BufferUsage::STORAGE \\| BufferUsage::COPY_SRC` |\n");
    buf_bytes(out, "| `gpu.align` | offsets: 256 for uniform and storage bindings, 4 for copies; rows 256 | `dev.align_uniform(n)` |\n");
    buf_bytes(out, "| `gpu.range` | an offset, size or draw range past its buffer or texture | the sizes |\n");
    buf_bytes(out, "| `gpu.layout` | a bind group that does not match the pipeline's layout | make it from `pipe.bind_layout(i)` |\n");
    buf_bytes(out, "| `gpu.pipeline` | a draw or dispatch without a pipeline or a bind group it uses | `pass.set_pipeline`, `pass.set_bind_group` |\n");
    buf_bytes(out, "| `gpu.format` | a format that does not fit: target, view, storage, shader kind | the pipeline's target format |\n");
    buf_bytes(out, "| `gpu.limits` | a size or count above `dev.limits()` | smaller |\n");
    buf_bytes(out, "| `gpu.state` | a buffer used while mapped for writing | `buf.unmap(dev)` first |\n");
    buf_bytes(out, "| `gpu.unsupported` | a capability the device lacks | check `dev.caps()` |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Surfaces (`inst.surface(dev, RawSurface::MetalLayer(layer))`,\n");
    buf_bytes(out, "`surf.configure(..)`, `surf.frame()?`, `frame.present(&queue)`) are\n");
    buf_bytes(out, "what std::window draws into; `RawSurface::Headless` gives frames without\n");
    buf_bytes(out, "a window.\n");
}
