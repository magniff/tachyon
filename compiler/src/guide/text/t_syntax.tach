use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Syntax\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The whole grammar is docs/grammar.md; this is what a program uses.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Lexical\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- Comments: `// line`, `/* block, nesting */`. No doc-comment syntax:\n");
    buf_bytes(out, "  `//` above an item is its comment.\n");
    buf_bytes(out, "- Identifiers: ASCII letters, digits, `_`; `_` alone is the wildcard.\n");
    buf_bytes(out, "  `r#type` is the identifier `type` (C names that are keywords).\n");
    buf_bytes(out, "- Keywords: `as break const continue defer else enum extern false fn for\n");
    buf_bytes(out, "  if impl import in let loop match mod mut pub return static struct\n");
    buf_bytes(out, "  trait true type union unsafe use while move` (0.14). Reserved (errors):\n");
    buf_bytes(out, "  `where`, `dyn`, `@`. `self`, `Self`, `super`, `crate` are names.\n");
    buf_bytes(out, "- Integers: `42`, `1_000`, `0xff`, `0b1010`, with a type suffix\n");
    buf_bytes(out, "  `255u8`, `7i32`. Floats: `1.5`, `2e10`, `1.5f32`. Chars: `'a'`, `'\\n'`,\n");
    buf_bytes(out, "  `'\\x41'`, `'\\''` (one byte, a `u8`). Strings: `\"a\\tb\\n\\\"q\\\"\\\\\"`,\n");
    buf_bytes(out, "  `\"\\x41\"`, `\"\\u{e9}\"` (UTF-8 bytes); `c\"...\"` is NUL-terminated;\n");
    buf_bytes(out, "  `f\"x = {x:>4}\"` is an f-string (0.15, `guide formatting`). A\n");
    buf_bytes(out, "  backslash at the end of a line inside a string continues it, leaving\n");
    buf_bytes(out, "  out the line break and the next line's indentation.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Items\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::Buf;                       // imports first, by convention\n");
    buf_bytes(out, "import \"stdio.h\" as c;              // a C header\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "const LIMIT: i64 = 100;             // a constant expression\n");
    buf_bytes(out, "const NAMES: [i64; 3] = [1, 2, 3];  // array constants too\n");
    buf_bytes(out, "static mut COUNTER: i64 = 0;        // a global; safe to use\n");
    buf_bytes(out, "type Grid = [[u8; 8]; 8];           // an alias; `type P<T> = (T, T);`\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "pub struct Point { x: i64, y: i64 }\n");
    buf_bytes(out, "struct Wrapper<T> { inner: T }      // generic\n");
    buf_bytes(out, "enum Dir { North, South }           // fieldless: compares with ==, casts with `as`\n");
    buf_bytes(out, "enum Tok { Num(i64), Op(u8), End }  // tuple variants\n");
    buf_bytes(out, "enum Ev { Key { code: u8, shift: bool }, Quit }   // struct-like variants (0.17)\n");
    buf_bytes(out, "#[repr(C)] union Bits { i: u32, f: f32 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "pub fn add(a: i64, b: i64) -> i64 { a + b }\n");
    buf_bytes(out, "fn first<T>(s: [T]) -> T { s[0] }\n");
    buf_bytes(out, "fn ignore(_: i64) {}                 // `_` ignores an argument\n");
    buf_bytes(out, "fn bump(mut n: i64) -> i64 { n += 1; n }   // a mutable parameter\n");
    buf_bytes(out, "unsafe fn raw(p: *i64) -> i64 { p[0] }     // callers need unsafe\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Point {\n");
    buf_bytes(out, "    fn len2(self: *Point) -> i64 { self.x * self.x + self.y * self.y }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "trait Named { fn name(self: *Self) -> [u8]; }\n");
    buf_bytes(out, "impl Named for Point { fn name(self: *Point) -> [u8] { \"point\" } }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "mod util { pub fn twice(x: i64) -> i64 { x * 2 } }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "extern \"C\" { fn abs(x: i32) -> i32; }\n");
    buf_bytes(out, "extern \"C\" fn callback(x: i32) -> i32 { x + 1 }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Items may come in any order and refer to each other. Attributes:\n");
    buf_bytes(out, "`#[repr(C)]`, `#[repr(C, packed)]`, `#[repr(C, align(16))]`,\n");
    buf_bytes(out, "`#[repr(u8)]` (an enum's tag), `#[inline]`, `#[inline(never)]`,\n");
    buf_bytes(out, "`#[cold]`; any other is an error.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Statements and blocks\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let x = 1;                          // immutable\n");
    buf_bytes(out, "let mut y: i64 = 2;                 // mutable, with a type\n");
    buf_bytes(out, "let (a, b) = (3, 4);                // patterns that always match\n");
    buf_bytes(out, "y += x + a * b;                     // = += -= *= /= %= &= |= ^= <<= >>=\n");
    buf_bytes(out, "defer println(\"last\");              // runs when the block exits\n");
    buf_bytes(out, "{\n");
    buf_bytes(out, "    let inner = y;                  // a block is an expression\n");
    buf_bytes(out, "    std::print_int(inner);\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "println(\"\");\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "15\n");
    buf_bytes(out, "last\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A statement that starts with `if`, `match`, `loop`, `while`, `for`,\n");
    buf_bytes(out, "`unsafe` or a block ends at its `}`: no `;` is needed, and it is never\n");
    buf_bytes(out, "continued by an operator. The last expression of a block, without `;`,\n");
    buf_bytes(out, "is the block's value. There is no `++`/`--`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Expressions and precedence\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "From loosest to tightest (all left-associative except where noted):\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| operators | |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `=` `+=` `-=` ... | right; an assignment is `()` |\n");
    buf_bytes(out, "| `\\|\\|` | |\n");
    buf_bytes(out, "| `&&` | |\n");
    buf_bytes(out, "| `==` `!=` `<` `>` `<=` `>=` | not chained: `a < b < c` is an error |\n");
    buf_bytes(out, "| `\\|` then `^` then `&` | bits; `a \\| b == c` is `(a \\| b) == c` |\n");
    buf_bytes(out, "| `<<` `>>` | arithmetic `>>` on signed, logical on unsigned |\n");
    buf_bytes(out, "| `+` `-` | |\n");
    buf_bytes(out, "| `*` `/` `%` | |\n");
    buf_bytes(out, "| `as` | `-x as i64` is `(-x) as i64`; `a * b as f64` is `a * (b as f64)` |\n");
    buf_bytes(out, "| prefix `-` `!` `~` `*` `&` | `!` on bool, `~` bitwise not |\n");
    buf_bytes(out, "| `f()` `a[i]` `a[i..j]` `x.f` `x.0` `x.m()` | `*p.x` is `*(p.x)` |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "No `**` (power), no ternary (`if c { a } else { b }` is an\n");
    buf_bytes(out, "expression). `e?` (0.15) is postfix, as tight as a call: `parse(s)?.len`\n");
    buf_bytes(out, "(`tachyonc guide conversions`). `return`,\n");
    buf_bytes(out, "`break`, `continue` have type `!` and fit anywhere:\n");
    buf_bytes(out, "`let v = if ok { x } else { return 1 };`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "In an `if`, `while`, `match` or `for` head, `Name {` starts the body: put\n");
    buf_bytes(out, "a struct literal there in parentheses, `if p == (P { x: 1 }) { ... }`\n");
    buf_bytes(out, "(0.17: `Name { a: ...` with a field's colon is read as a literal there\n");
    buf_bytes(out, "too).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Control flow\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let n = 7;\n");
    buf_bytes(out, "    let parity = if n % 2 == 0 { \"even\" } else { \"odd\" };\n");
    buf_bytes(out, "    println(parity);\n");
    buf_bytes(out, "    let mut i = 0;\n");
    buf_bytes(out, "    while i < 3 { i += 1; }\n");
    buf_bytes(out, "    for k in 0..=2 { i += k; }          // 0..n excludes n, 0..=n includes it\n");
    buf_bytes(out, "    for ch in \"ab\" { i += ch as i64; }  // slices and arrays, by value\n");
    buf_bytes(out, "    let v = loop { i += 1; if i % 10 == 0 { break i; } };\n");
    buf_bytes(out, "    rows: for r in 0..3 {\n");
    buf_bytes(out, "        for c in 0..3 {\n");
    buf_bytes(out, "            if c == 1 { continue :rows; }\n");
    buf_bytes(out, "            if r == 2 { break :rows; }\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    let o: Option<i64> = Some(3);\n");
    buf_bytes(out, "    if let Some(x) = o { i += x; } else if n > 0 { i -= 1; }\n");
    buf_bytes(out, "    let mut stack: Vec<i64> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    stack.push(1);\n");
    buf_bytes(out, "    while let Some(top) = stack.pop() { i += top; }\n");
    buf_bytes(out, "    std::print_int(v);\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "odd\n");
    buf_bytes(out, "210\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`match`: arms are tried in order; a pattern may be a literal, a range\n");
    buf_bytes(out, "`'a'..='z'`, alternatives `A | B`, a variant `E::V(x, _)` or `E::K {\n");
    buf_bytes(out, "code, shift: true }` (`E::K { code, .. }` leaves the other fields out), a\n");
    buf_bytes(out, "tuple `(a, 0)`, a binding (`n`), `_`, with a guard `n if n > 0`. The arms must\n");
    buf_bytes(out, "cover every value; a match is an expression.\n");
}
