// Generated by compiler/guide/embed.sh from compiler/guide/allocators.md (do
// not edit): the guide's topic 'allocators'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Allocators (0.16)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Allocation is explicit: nothing allocates without being given an\n");
    buf_bytes(out, "allocator. A program's general-purpose allocator is the `gpa: Gpa` its\n");
    buf_bytes(out, "`main` takes; a function that allocates takes one as a parameter, or\n");
    buf_bytes(out, "works on a container it was given (a `Vec` holds its allocator: `push`,\n");
    buf_bytes(out, "`clone` and `free` use it). There is no global allocator to reach for,\n");
    buf_bytes(out, "so a function's signature says whether it allocates.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Gpa, from main\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn squares(n: i64, gpa: Gpa) -> Vec<i64> {   // allocates: takes the allocator\n");
    buf_bytes(out, "    let mut v: Vec<i64> = Vec::with_capacity_in(n, gpa);\n");
    buf_bytes(out, "    for i in 0..n { v.push(i * i); }\n");
    buf_bytes(out, "    v\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn total(v: *Vec<i64>) -> i64 {              // grows nothing: no allocator\n");
    buf_bytes(out, "    v.iter().sum()\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {                    // or main(argc, argv, gpa)\n");
    buf_bytes(out, "    let mut v = squares(4, gpa);\n");
    buf_bytes(out, "    defer v.free();\n");
    buf_bytes(out, "    v.push(100);                              // the Vec's own allocator\n");
    buf_bytes(out, "    let mut b = Buf::new_in(gpa);\n");
    buf_bytes(out, "    defer b.free();\n");
    buf_bytes(out, "    b.push_int(total(&v));\n");
    buf_bytes(out, "    let words: Vec<i64> = (1..4).map(|x| x * 10).collect_in(gpa);\n");
    buf_bytes(out, "    println(f\"{b.as_slice()} {words:?}\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "114 [10, 20, 30]\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`Gpa` is a zero-sized value, copied freely; only `main` gets one (std's\n");
    buf_bytes(out, "types are `#[sealed]`: no `Gpa {}` outside std). Each 0.15 form that\n");
    buf_bytes(out, "allocated has an `_in` form taking the allocator last: `Vec::new_in(a)`,\n");
    buf_bytes(out, "`with_capacity_in(n, a)`, `filled_in(n, x, a)`, `Buf::new_in(a)`,\n");
    buf_bytes(out, "`HashMap::new_in(a)`, `it.collect_in(a)`, `format_in(x, a)`,\n");
    buf_bytes(out, "`read_stdin_in(a)`, `split_in(s, sep, a)`, `split_whitespace_in(s, a)`,\n");
    buf_bytes(out, "`sort_stable_in(s, a)`, `sort_stable_by_in(s, f, a)`, `v.clone_in(b)`.\n");
    buf_bytes(out, "The 0.15 forms are errors that name the `_in` form:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "let v: Vec<i64> = Vec::new();\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[type error] allocation is explicit: pass an allocator (try: Vec::new_in(gpa))\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc fix --only alloc016` moves a 0.15 program over: each call\n");
    buf_bytes(out, "becomes its `_in` form, and `gpa: Gpa` is added to every function from\n");
    buf_bytes(out, "`main` down to the calls (and passed at each call). A function it cannot\n");
    buf_bytes(out, "change (an impl of std's `Display`, a function used as a value, a\n");
    buf_bytes(out, "parameter's default) is an error naming where it allocates: keep a\n");
    buf_bytes(out, "`gpa: Gpa` in the value it works on, or allocate in the caller.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Containers and their allocator\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`Vec<T, A: Allocator = Gpa>`, `Buf<A = Gpa>`, `HashMap<K, V, A = Gpa>`:\n");
    buf_bytes(out, "the allocator is a type parameter with a default, so `Vec<i64>` is\n");
    buf_bytes(out, "`Vec<i64, Gpa>` (and `Vec<i64>` costs what it did: `Gpa` takes no\n");
    buf_bytes(out, "bytes). Code generic over the allocator names it; code that only reads\n");
    buf_bytes(out, "takes a slice:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn fill<A: Allocator>(v: *Vec<i64, A>, n: i64) {\n");
    buf_bytes(out, "    for i in 0..n { v.push(i); }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn sum(s: [i64]) -> i64 {                     // any Vec's as_slice()\n");
    buf_bytes(out, "    s.iter().sum()\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let mut v: Vec<i64> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    defer v.free();\n");
    buf_bytes(out, "    fill(&v, 5);\n");
    buf_bytes(out, "    println(sum(v.as_slice()));\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "10\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "An impl block writes every type argument, the defaulted ones too:\n");
    buf_bytes(out, "`impl<T, A: Allocator> Tr for Vec<T, A>`. A static cannot hold a `Gpa`:\n");
    buf_bytes(out, "keep containers in `main` and pass them (or views of them) down.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Arenas\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "An arena allocates by bumping a pointer and frees everything at once.\n");
    buf_bytes(out, "`arena_scope(gpa, |a| ...)` makes one (its memory from `gpa`), runs the\n");
    buf_bytes(out, "closure with it, and frees all of it when the closure returns; nothing allocated from it may leave\n");
    buf_bytes(out, "the closure (the compiler rejects a result or a capture that holds the\n");
    buf_bytes(out, "`ScopedArena`). `Arena::new_in(gpa)` is a handle kept longer,\n");
    buf_bytes(out, "`a.scope(|s| ...)` a scope of it; `FixedBuf::new(mem)` allocates from memory you give it.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn longest(words: [[u8]], gpa: Gpa) -> i64 {\n");
    buf_bytes(out, "    arena_scope(gpa, |a| {\n");
    buf_bytes(out, "        let mut lens: Vec<i64, ScopedArena> = Vec::new_in(a);\n");
    buf_bytes(out, "        for w in words { lens.push(w.len); }\n");
    buf_bytes(out, "        lens.iter().max().unwrap_or(0)        // an i64 leaves, the Vec does not\n");
    buf_bytes(out, "    })\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## --check-alloc\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc --check-alloc f.tach -o f` builds the program with a checking\n");
    buf_bytes(out, "`Gpa` (like `--check-unsafe`, at any `-O`): every block gets pages of\n");
    buf_bytes(out, "its own, never reused, so a use after free, a double free, a free of a\n");
    buf_bytes(out, "wrong pointer or size stop the program with where the block was\n");
    buf_bytes(out, "allocated and freed; leaks are listed at exit (`gpa.check_leaks()` in a\n");
    buf_bytes(out, "test). Arenas and `FixedBuf` are checked the same way: a block\n");
    buf_bytes(out, "used after their `reset`, after its scope ended, or after it moved is\n");
    buf_bytes(out, "reported. Views (`as_slice()`, a `[T]`) into memory that was freed or\n");
    buf_bytes(out, "moved are the one hole left in safe code (0.17 closes it); this mode is\n");
    buf_bytes(out, "how to find one.\n");
}
