// Generated by compiler/guide/embed.sh from compiler/guide/generics.md (do
// not edit): the guide's topic 'generics'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Generics\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Functions, structs, enums, impl blocks and type aliases take type\n");
    buf_bytes(out, "parameters. A generic item is a template: each use with new type\n");
    buf_bytes(out, "arguments makes a separate copy (monomorphization), checked and\n");
    buf_bytes(out, "optimized as if written by hand. No boxing, no dynamic dispatch.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct Stack<T> { items: Vec<T> }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl<T> Stack<T> {\n");
    buf_bytes(out, "    fn new() -> Stack<T> { Stack { items: Vec::new() } }\n");
    buf_bytes(out, "    fn push(self: *Stack<T>, x: T) { self.items.push(x); }\n");
    buf_bytes(out, "    fn pop(self: *Stack<T>) -> Option<T> { self.items.pop() }\n");
    buf_bytes(out, "    fn free(self: *Stack<T>) { self.items.free(); }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Stack<i64> {                          // methods of one instance only\n");
    buf_bytes(out, "    fn sum(self: *Stack<i64>) -> i64 {\n");
    buf_bytes(out, "        let mut t = 0;\n");
    buf_bytes(out, "        for x in self.items.as_slice() { t += x; }\n");
    buf_bytes(out, "        t\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn largest<T: Ord>(s: [T]) -> T {          // a bound: T must implement Ord\n");
    buf_bytes(out, "    let mut best = s[0];\n");
    buf_bytes(out, "    for x in s { if x > best { best = x; } }\n");
    buf_bytes(out, "    best\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn swap<T, U>(p: (T, U)) -> (U, T) { (p.1, p.0) }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "type Pair<T> = (T, T);\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn sum_pair(p: Pair<i64>) -> i64 { p.0 + p.1 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut s: Stack<i64> = Stack::new();\n");
    buf_bytes(out, "    defer s.free();\n");
    buf_bytes(out, "    s.push(4);\n");
    buf_bytes(out, "    s.push(9);\n");
    buf_bytes(out, "    std::print_int(s.sum());\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    let a = [3, 8, 1];\n");
    buf_bytes(out, "    std::print_int(largest(a[..]));\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    std::print_int(largest::<u8>(\"tachyon\") as i64);   // the turbofish\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    let t = swap((1, \"one\"));\n");
    buf_bytes(out, "    print(t.0);\n");
    buf_bytes(out, "    print(\" \");\n");
    buf_bytes(out, "    std::print_int(sum_pair((2, 3)) + s.pop().unwrap());\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "13 8 121 one 14\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- Type arguments: after a type's name (`Vec<i64>`, `Option<*u8>`), and in\n");
    buf_bytes(out, "  expressions after `::` (`Vec::<u8>::new()`, `max::<i64>(a, b)`,\n");
    buf_bytes(out, "  `Pair::<i64> { a: 1, b: 2 }`, a method's own: `x.m::<u8>()`). They are inferred\n");
    buf_bytes(out, "  from arguments and from the expected type (`let v: Vec<i64> =\n");
    buf_bytes(out, "  Vec::new();`); unsuffixed literals are looked at last.\n");
    buf_bytes(out, "- A generic function used as a value needs its arguments:\n");
    buf_bytes(out, "  `let f = largest::<i64>;`.\n");
    buf_bytes(out, "- Without bounds, a body is checked per instance: `a > b` works for\n");
    buf_bytes(out, "  every `T` that has `>`. An error inside an instance is reported with\n");
    buf_bytes(out, "  `note: in instantiation of 'f<P>' at ...`. With a bound, only the\n");
    buf_bytes(out, "  bound's functions may be called on `T`'s values.\n");
    buf_bytes(out, "- `size_of(T)` and `align_of(T)` work on type parameters.\n");
    buf_bytes(out, "- Not there: const generics (`[T; N]` with `N` a parameter), generic\n");
    buf_bytes(out, "  traits (`trait Conv<T>`), `where` clauses, variadic generics.\n");
    buf_bytes(out, "  Associated types (0.14): `I::Item` for `I: Iterator`, and bounds\n");
    buf_bytes(out, "  `I: Iterator<Item = i64>`, `F: Fn(i64) -> bool` (`tachyonc guide\n");
    buf_bytes(out, "  iterators`, `guide closures`).\n");
}
