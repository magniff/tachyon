// Generated by compiler/guide/embed.sh from compiler/guide/modules.md (do
// not edit): the guide's topic 'modules'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Modules and imports\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A file is a module. The files on the command line make the root module\n");
    buf_bytes(out, "(`crate`); `mod name;` in a module loads its child `name` from\n");
    buf_bytes(out, "`name.tach` or `name/mod.tach` next to it (from `a.tach`: `a/name.tach`).\n");
    buf_bytes(out, "`mod name { items }` declares one inline.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "main.tach            mod geometry;  use geometry::shapes::{Shape, area};\n");
    buf_bytes(out, "geometry.tach        pub mod shapes;  pub struct Rect { w: i64, h: i64 }\n");
    buf_bytes(out, "geometry/shapes.tach pub enum Shape { ... }  pub fn area(s: Shape) -> i64 { ... }\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```sh\n");
    buf_bytes(out, "tachyonc main.tach -o prog      # loads the modules main.tach names\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Visibility\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Every item is private to its module and the modules inside it unless\n");
    buf_bytes(out, "`pub`. A struct's fields are as visible as the struct (no private\n");
    buf_bytes(out, "fields). Methods are visible wherever their type is. A `pub mod` can be\n");
    buf_bytes(out, "reached from outside its parent. `pub use a::b;` re-exports `b`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Paths and use\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A path starts with a name in scope, `crate`, `self`, `super` or `std`:\n");
    buf_bytes(out, "`geometry::area(s)`, `crate::util::Vec2 { x: 1, y: 2 }`,\n");
    buf_bytes(out, "`shapes::Shape::Rect(r)`, `util::Stack::<u8>::new()`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "mod util {\n");
    buf_bytes(out, "    pub fn double(x: i64) -> i64 { x * 2 }\n");
    buf_bytes(out, "    pub fn half(x: i64) -> i64 { x / 2 }\n");
    buf_bytes(out, "    pub enum Mode { Fast, Slow }\n");
    buf_bytes(out, "    pub mod inner {\n");
    buf_bytes(out, "        use super::double;               // the parent's item\n");
    buf_bytes(out, "        pub fn quad(x: i64) -> i64 { double(double(x)) }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "use util::{double, half as halve};       // by name, with `as` to rename\n");
    buf_bytes(out, "use util::inner::quad;\n");
    buf_bytes(out, "use util::Mode::{Fast, Slow};            // an enum's variants\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn speed(m: util::Mode) -> i64 {\n");
    buf_bytes(out, "    match m { Fast => 10, Slow => 1 }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    std::print_int(double(3) + halve(8) + quad(1) + speed(Fast) + crate::util::double(1));\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "26\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- No wildcard imports (`use m::*;` is an error): every name a file uses\n");
    buf_bytes(out, "  is declared there, imported by name, or written as a path.\n");
    buf_bytes(out, "- The order of items and `use` lines does not matter.\n");
    buf_bytes(out, "- Name resolution: a local binding, then the module's own items, then\n");
    buf_bytes(out, "  its imports, then the prelude (`Option Some None Result Ok Err Vec\n");
    buf_bytes(out, "  print println`, the operator traits). A program's own `Vec` hides the\n");
    buf_bytes(out, "  prelude's.\n");
    buf_bytes(out, "- A C header: `import \"stdio.h\" as c;` then `c::printf`; in a pattern,\n");
    buf_bytes(out, "  import a C constant by name: `use c::EOF;`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Symbols\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "An item of module `a::b` has the symbol `a.b.name`; root items keep\n");
    buf_bytes(out, "their names, as do `extern \"C\"` items and `#[link_name]`s.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Tools\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `tachyonc fix --only imports` adds the `use` lines a program is\n");
    buf_bytes(out, "  missing for its own items (std's are imported by hand: `use std::Buf;`),\n");
    buf_bytes(out, "  and `--only unused` removes unused ones.\n");
    buf_bytes(out, "- `tachyonc query items` lists every module; `query items MODULE` its\n");
    buf_bytes(out, "  items with signatures.\n");
    buf_bytes(out, "- `tachyonc refactor move a::f --to crate::b` moves items, fixing\n");
    buf_bytes(out, "  imports and `pub`; `refactor rename`, `refactor new-module`,\n");
    buf_bytes(out, "  `refactor split` (see `tachyonc guide tools`).\n");
}
