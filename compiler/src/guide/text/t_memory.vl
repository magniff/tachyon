// Generated by compiler/guide/embed.sh from compiler/guide/memory.md (do
// not edit): the guide's topic 'memory'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Memory\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Vole's values have one owner each (0.17; spelled `let` / `inout` /\n");
    buf_bytes(out, "`sink` since 0.20): an owned value moves and is dropped at the end of\n");
    buf_bytes(out, "its scope, a function says by its parameters' conventions what it does\n");
    buf_bytes(out, "with each argument, and the views a slice holds are checked. Nothing\n");
    buf_bytes(out, "stores a reference, so there are no lifetimes to write. There is no\n");
    buf_bytes(out, "garbage collector and no reference counting; memory comes from an\n");
    buf_bytes(out, "allocator (`guide allocators`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Three kinds of types\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The kind is computed from the type; nothing is declared:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| kind | what | `let w = v;`, a sink argument, `return` |\n");
    buf_bytes(out, "|---|---|---|\n");
    buf_bytes(out, "| plain | numbers, bool, raw `*T`, structs, tuples and arrays of plain types | a bit copy, as in C |\n");
    buf_bytes(out, "| owned | `Vec`, `Buf`, `HashMap`, `Arena`, a type with `Drop`, a struct holding one | a move: the old name is dead until assigned again; `.clone()` copies |\n");
    buf_bytes(out, "| view | a slice `[T]`, a struct holding one (`Scanner`) or an access field (`q: inout Query`), a closure capturing by access | a copy (one holding an `inout`: a move) that cannot outlive what it views |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`volec query own FILE:LINE:COL` shows each local's kind there, and\n");
    buf_bytes(out, "whether it is moved or what it views.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Conventions: let, inout, sink\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A parameter's convention says what the function does with the argument:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| convention | written | the callee | the caller writes |\n");
    buf_bytes(out, "|---|---|---|---|\n");
    buf_bytes(out, "| let (the default) | `v: Vec<i64>` | reads it; cannot change or keep it | `total(v)`: lent for the call, or a temporary |\n");
    buf_bytes(out, "| inout | `v: inout Vec<i64>` | may change it; the change reaches the caller | `fill(&v)`: `&` marks it |\n");
    buf_bytes(out, "| sink | `v: sink Vec<i64>` | owns it (may change it, keeps or drops it) | `keep(v)`: v moves (a plain value is copied) |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn total(v: Vec<i64>) -> i64 {           // let: reads, no copy\n");
    buf_bytes(out, "    var s = 0;\n");
    buf_bytes(out, "    for x in v { s += x; }\n");
    buf_bytes(out, "    s\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn fill(v: inout Vec<i64>, n: i64) {     // inout: changes the caller's Vec\n");
    buf_bytes(out, "    for i in 0..n { v.push(i * i); }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn keep(all: inout Vec<Vec<i64>>, v: sink Vec<i64>) {   // sink: takes it\n");
    buf_bytes(out, "    all.push(v);\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn make(n: i64, gpa: Gpa) -> Vec<i64> {  // the caller owns the result\n");
    buf_bytes(out, "    var v: Vec<i64> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    fill(&v, n);\n");
    buf_bytes(out, "    v                                    // moved out: not dropped here\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) {\n");
    buf_bytes(out, "    let v = make(4, gpa);\n");
    buf_bytes(out, "    let w = v.clone();                   // a copy; `let w = v;` moves v\n");
    buf_bytes(out, "    println(f\"{total(v)} {total(w)} {w.len()}\");\n");
    buf_bytes(out, "    var all: Vec<Vec<i64>> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    keep(&all, w);                       // w is dead from here\n");
    buf_bytes(out, "    println(all.len());\n");
    buf_bytes(out, "}                                        // all (and w in it), then v, dropped (freed)\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "14 14 4\n");
    buf_bytes(out, "1\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- There are no references to take or store: where other languages\n");
    buf_bytes(out, "  borrow (a shared reference `&T`, a mutable reference `&mut T`), a let\n");
    buf_bytes(out, "  parameter borrows the value read-only for the call and an inout one\n");
    buf_bytes(out, "  borrows it exclusively, with `&x` at the call.\n");
    buf_bytes(out, "- For a plain type (`i64`, a struct of numbers) `let` and `sink` are\n");
    buf_bytes(out, "  both a copy; only `inout` changes the caller's value. For an owned one\n");
    buf_bytes(out, "  `let` lends it and `sink` moves it.\n");
    buf_bytes(out, "- Receivers: `fn len(self)`, `fn push(inout self, x: sink T)`, `fn\n");
    buf_bytes(out, "  finish(sink self)`. A method call lends its receiver without `&`:\n");
    buf_bytes(out, "  `v.push(1)` changes `v`, so `v` must be `var` (or an inout parameter).\n");
    buf_bytes(out, "- A let parameter is read-only: changing it is an error that names the\n");
    buf_bytes(out, "  fix (take it `inout`). Defaults: `b: i64 = 2` on let and sink\n");
    buf_bytes(out, "  parameters, not on inout ones.\n");
    buf_bytes(out, "- Mutable locals are `var x = e;`; `let` ones cannot change. A `sink`\n");
    buf_bytes(out, "  parameter is the callee's own, so it is mutable.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Moves and drops\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `let w = v;`, a sink argument, `return v`, a struct literal's field\n");
    buf_bytes(out, "  and a `sink ||` closure move `v`; using `v` after that is `own.moved`,\n");
    buf_bytes(out, "  which names where it moved (`'keep(sink v)'`); its `try:` passes\n");
    buf_bytes(out, "  `v.clone()`, or lend it to a let parameter instead.\n");
    buf_bytes(out, "- At the end of a scope its owned locals are dropped, last declared\n");
    buf_bytes(out, "  first, on every exit (`return`, `break`, `?`), not on `exit` or a\n");
    buf_bytes(out, "  panic. A moved value is not dropped where it was.\n");
    buf_bytes(out, "- `impl Drop for T { fn drop(inout self) { ... } }` runs code at the\n");
    buf_bytes(out, "  drop; a type without one drops its fields. `drop(x)` drops early,\n");
    buf_bytes(out, "  `std::forget(x)` never (a leak, safe).\n");
    buf_bytes(out, "- `let x = v[i];` of an owned element borrows it (a let access, read\n");
    buf_bytes(out, "  only); `var x = v[i];` would move it out of the Vec and is\n");
    buf_bytes(out, "  `own.move_out`, as is `var k = self.keys;` in an `inout self` method:\n");
    buf_bytes(out, "  take it with `self.keys.take()`, which leaves an empty one\n");
    buf_bytes(out, "  (`std::take(&x)` for a `Default` value), `std::replace`, or\n");
    buf_bytes(out, "  `.clone()`.\n");
    buf_bytes(out, "- `v.free()` still works: it frees now and leaves `v` empty (its drop\n");
    buf_bytes(out, "  then frees nothing). `defer v.free()`, the idiom before 0.17, is\n");
    buf_bytes(out, "  legal and no longer needed.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Accesses\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "An access is what a let or inout parameter holds: not a pointer to\n");
    buf_bytes(out, "manage, but the caller's value itself, used as that value.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- Read it, write it, call its methods: `n + 1`, `out = acc`, `out +=\n");
    buf_bytes(out, "  1`, `v.push(x)`, `p.x`. There is no `*r`; `*` is only for raw `*T`\n");
    buf_bytes(out, "  pointers.\n");
    buf_bytes(out, "- `inout r = &st;` names an inout access in a local; pass it on as\n");
    buf_bytes(out, "  `&r`, any number of times: `bump(&r); bump(&r);`. A let argument needs\n");
    buf_bytes(out, "  no local: pass `st` itself.\n");
    buf_bytes(out, "- A struct may hold one as a field: `struct Parser { toks: [Tok], q:\n");
    buf_bytes(out, "  inout Query }`, built as `Parser { toks: t, q: &q }`; such a struct is\n");
    buf_bytes(out, "  a view (`guide views`).\n");
    buf_bytes(out, "- `match e { E::A(n) => n + 1, .. }` on a let `e` binds into it;\n");
    buf_bytes(out, "  `match &x { .. }` binds inout accesses that change `x`'s parts.\n");
    buf_bytes(out, "- Exclusivity: while an inout access of `x` (or a view of it) is in use,\n");
    buf_bytes(out, "  `x` is not read or changed another way. `f(&a, a)` and `f(&a, &a)` are\n");
    buf_bytes(out, "  errors (`own.conflict`); `v.push(v.len())` is fine (the receiver is\n");
    buf_bytes(out, "  taken after the arguments).\n");
    buf_bytes(out, "- `*T` is a raw pointer (0.18.1): dereferencing it needs `unsafe`;\n");
    buf_bytes(out, "  `&x` passed where a `*T` is wanted gives the address, with an\n");
    buf_bytes(out, "  exclusive loan for the call (`guide unsafe`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Views\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A slice does not own memory: `v.as_slice()` views `v`'s elements, a\n");
    buf_bytes(out, "`Scanner` views its text. The checker keeps every view inside what it\n");
    buf_bytes(out, "views: a view used after its owner grew or was dropped (`own.conflict`),\n");
    buf_bytes(out, "returned out of the function that owns its memory (`own.escape`), or a\n");
    buf_bytes(out, "`for` loop over a Vec that pushes to it, is an error, not undefined\n");
    buf_bytes(out, "behaviour. Take the view again after the change, or keep an index:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "var v: Vec<i64> = Vec::new_in(gpa);\n");
    buf_bytes(out, "v.push(1);\n");
    buf_bytes(out, "let s = v.as_slice();\n");
    buf_bytes(out, "print(f\"{s[0]} \");                        // used before the pushes\n");
    buf_bytes(out, "for i in 0..100 { v.push(i); }            // may move the elements\n");
    buf_bytes(out, "let s2 = v.as_slice();                    // a fresh view\n");
    buf_bytes(out, "println(f\"{s2.len()}\");\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "1 101\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`volec guide views` has the rules, the diagnostics and the patterns\n");
    buf_bytes(out, "(parsers and lexers that keep views of their input are fine).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`volec --check-alloc` (0.16) also checks at run time: every Gpa block\n");
    buf_bytes(out, "on pages of its own, so a use after free (through `unsafe` code) faults\n");
    buf_bytes(out, "and is reported with where the block was allocated and freed; bad frees\n");
    buf_bytes(out, "and leaks are reported too (`gpa.live_blocks()`, `gpa.check_leaks()` for\n");
    buf_bytes(out, "tests).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Raw memory\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`malloc` and `free` from C, raw `*T` pointers, in `unsafe` (`volec\n");
    buf_bytes(out, "guide unsafe`). `volec --check-unsafe -O1` checks heap accesses\n");
    buf_bytes(out, "through raw pointers at run time. Memory nobody wrote (from `malloc`)\n");
    buf_bytes(out, "has an unspecified value: write it before reading it.\n");
}
