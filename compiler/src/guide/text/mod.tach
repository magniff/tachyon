pub fn topic_summary(i: i64) -> [u8] {
    match i {
        0 => "about 2k tokens: Rust habits as paired lines, std's most used items, first errors, the loop (the default)",
        1 => "a whole program in three files and a test case: modules, enums and match, Result and ?, Vec, HashMap, Buf, sorting, allocators",
        2 => "the long form of the core: values, functions, structs, generics, modules, slices, std, input, unsafe, errors, tools",
        3 => "Rust -> tachyon, area by area: text, memory, errors, iteration, syntax",
        4 => "lexical rules, items, statements, precedence, control flow, patterns",
        5 => "numbers and their defined behaviour, arrays, slices, pointers, enums, SIMD",
        6 => "Vec, HashMap, Buf, Option, Result, printing, reading stdin, text, sort: the API from std's source",
        7 => "copies and handles, freeing with defer, views and their lifetime",
        8 => "explicit allocation (0.16): gpa from main, the _in forms, A: Allocator, arenas, --check-alloc, fix --only alloc016",
        9 => "what a function may do (0.16): alloc(Gpa) io global panic diverge unsafe, query effects, #[pure] and its kin",
        10 => "the errors newcomers hit, each with its fix; run-time failures",
        11 => "files, mod, pub, use, paths, the prelude",
        12 => "type parameters, instances, the turbofish, inference",
        13 => "traits, impls, defaults, bounds, operator traits",
        14 => "|x| x + k, captures, move, Fn and FnMut bounds, fn coercion (0.14)",
        15 => "Iterator, map/filter/fold/sum/collect, for over iterators, sort_by (0.14)",
        16 => "widening, From and Into, the ? operator, main -> Result, std's error enums (0.15)",
        17 => "f-strings, Display and Debug, print/println/format, #[derive] (0.15)",
        18 => "unsafe operations, borrows, unsafe fn, --check-unsafe",
        19 => "calling C, importing headers, repr(C), callbacks, linking",
        20 => "query, edit, refactor, fix, check, diagnostics and try lines",
        21 => "a bug: tests with failure traces, probe values at a line, reduce an input, which change broke a test (0.17)",
        22 => "recipes for \"add an X\": a std function, a peephole rule, a pass, a diagnostic, a test, a subcommand, a module (0.17)",
        _ => "",
    }
}

