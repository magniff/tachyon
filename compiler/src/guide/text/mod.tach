pub fn topic_summary(i: i64) -> [u8] {
    match i {
        0 => "about 2k tokens: the language in one program (let, inout, sink, var), std's most used items, first errors, the loop (the default)",
        1 => "a whole program in three files and a test case: modules, enums and match, Result and ?, Vec, HashMap, Buf, sorting, allocators",
        2 => "the long form of the core: values, functions, structs, generics, modules, slices, std, input, unsafe, errors, tools",
        3 => "Rust -> tachyon, area by area: text, parameters and memory (&T, &mut T, let mut), errors, iteration, syntax",
        4 => "lexical rules, items, statements, precedence, control flow, patterns",
        5 => "numbers and their defined behaviour, arrays, slices, pointers, distinct types and NonNull (0.18), enums, SIMD",
        6 => "Vec, HashMap, Buf, Option, Result, printing, reading stdin, text, sort: the API from std's source",
        7 => "str and String (0.20): UTF-8 text with Rust's methods (split, trim, find, parse, lines, chars), patterns, the _in forms, bytes to text",
        8 => "files, paths, the environment, processes (0.20): std::fs, io::Error, BufReader, BufWriter, std::path, std::env, std::process",
        9 => "plain, owned and view types; the conventions let, inout, sink; moves, drops, accesses; views checked (0.17, 0.20)",
        10 => "slices and access fields as views: exclusivity, inout [T], view summaries, parsers, the own.* diagnostics (0.17)",
        11 => "explicit allocation (0.16): gpa from main, the _in forms, A: Allocator, arenas, --check-alloc, fix --only alloc016",
        12 => "what a function may do (0.16): alloc(Gpa) io global panic diverge unsafe, query effects, #[pure] and its kin",
        13 => "the errors newcomers hit, each with its fix; run-time failures",
        14 => "files, mod, pub, use, paths, the prelude",
        15 => "type parameters, instances, the turbofish, inference",
        16 => "traits, impls, defaults, bounds, operator traits",
        17 => "|x| x + k, captures, sink closures, Fn and FnMut bounds, fn coercion (0.14)",
        18 => "Iterator, map/filter/fold/sum/collect, for over iterators, sort_by (0.14)",
        19 => "widening, From and Into, the ? operator, main -> Result, std's error enums (0.15)",
        20 => "f-strings, Display and Debug, print/println/format, #[derive] (0.15)",
        21 => "unsafe operations, raw pointers and &x, unsafe fn, --check-unsafe",
        22 => "calling C, importing headers, repr(C), callbacks, linking",
        23 => "SIMD and CPU intrinsics (0.19): NEON, SSE, AVX2, CRC32, AES, SHA-256, popcount; finding one (query arch), byte search, detect and has, #[target_feature], #[multiversion], checked memory",
        24 => "GPU compute and rendering (0.22): std::gpu on Metal, the objects and their lifecycle, a compute and a render example, capabilities, the gpu.* contracts, -l objc",
        25 => "query, edit, refactor, fix, check, diagnostics and try lines",
        26 => "requires, ensures, old and result, assert and assert_eq, debug clauses, the failure line (0.18)",
        27 => "#[test], #[property] and Arbitrary, snapshots, tachyonc test, #[fuzz] and tachyonc fuzz, reduce over programs (0.18)",
        28 => "a bug: tests with failure traces, probe values at a line, reduce an input, which change broke a test (0.17)",
        29 => "recipes for \"add an X\": a std function, a peephole rule, a pass, a diagnostic, a test, a subcommand, a module (0.17)",
        _ => "",
    }
}

