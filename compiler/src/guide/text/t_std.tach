    buf_bytes(out, "# std\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## The most used\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "std's most used items (0.17's evals: by how many of 362 sessions used\n");
    buf_bytes(out, "each), most used first. `v` is a `Vec`, `b` a `Buf`, `m` a `HashMap`,\n");
    buf_bytes(out, "`sc` a `Scanner`, `o` an `Option` or `Result`. All of these are in the\n");
    buf_bytes(out, "prelude: no `use` line.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "v.push(x: T)                     Vec; Buf: b.push(byte: u8)\n");
    buf_bytes(out, "v.as_slice() -> [T]              Vec; Buf: -> [u8]\n");
    buf_bytes(out, "Vec::new_in(gpa) -> Vec<T>       let mut v: Vec<i64> = Vec::new_in(gpa);\n");
    buf_bytes(out, "v.len() -> i64                   Vec, Buf, HashMap, slices\n");
    buf_bytes(out, "v.get(i: i64) -> T               checked, as v[i]; m.get(k) -> Option<V>\n");
    buf_bytes(out, "b.push_str(s: [u8])\n");
    buf_bytes(out, "Buf::new_in(gpa) -> Buf          text you build (there is no String)\n");
    buf_bytes(out, "o.unwrap() -> T                  Option, Result; o.is_some(), o.is_none()\n");
    buf_bytes(out, "read_stdin_in(gpa) -> Result<Buf, IoError>    all of stdin\n");
    buf_bytes(out, "print(x), println(x)             any Display; f\"{x} {v:?} {v[i]} {s.len()}\"\n");
    buf_bytes(out, "b.push_int(v: i64)\n");
    buf_bytes(out, "v.set(i: i64, x: T)              checked, as v[i] = x\n");
    buf_bytes(out, "Scanner::new(text: [u8]) -> Scanner\n");
    buf_bytes(out, "sc.next_int() -> Result<i64, ScanError>\n");
    buf_bytes(out, "o.unwrap_or(x: T) -> T           Option, Result\n");
    buf_bytes(out, "v.clear()                        Vec, Buf\n");
    buf_bytes(out, "v.sort()                         by Ord: numbers, [u8], tuples, #[derive(Eq, Ord)]\n");
    buf_bytes(out, "v.sort_by(|a, b| a.x - b.x)      a, b: &T (*a - *b); < 0: a first; cmp_of(a, b)\n");
    buf_bytes(out, "HashMap::new_in(gpa) -> HashMap<K, V>\n");
    buf_bytes(out, "v.pop() -> Option<T>             v.remove(i: i64) -> T; m.remove(k) -> Option<V>\n");
    buf_bytes(out, "Vec::filled_in(n: i64, x: T, gpa) -> Vec<T>\n");
    buf_bytes(out, "sort(s: &mut [T])                a slice in place: sort(&mut v[a..b])\n");
    buf_bytes(out, "for (k, x) in m.iter()           in slot order (not insertion order)\n");
    buf_bytes(out, "m.get_or_insert(k: K, d: V) -> &mut [V]    m.get_or_insert(w, 0)[0] += 1;\n");
    buf_bytes(out, "sc.next_token() -> Option<[u8]>  sc.next_line() -> Option<[u8]>\n");
    buf_bytes(out, "parse_int(s: [u8]) -> Result<i64, ParseIntError>\n");
    buf_bytes(out, "m.insert(k: K, x: V) -> Option<V>     Vec: v.insert(i: i64, x: T)\n");
    buf_bytes(out, "std::print_int(v: i64)           std::is_digit(b: u8) -> bool\n");
    buf_bytes(out, "trim(s: [u8]) -> [u8]\n");
    buf_bytes(out, "read_line(&mut b) -> Result<bool, IoError>    Ok(false) at the end of input\n");
    buf_bytes(out, "split_whitespace_in(s: [u8], gpa) -> Vec<[u8]>\n");
    buf_bytes(out, "split_in(s: [u8], sep: u8, gpa) -> Vec<[u8]>\n");
    buf_bytes(out, "v.swap(i: i64, j: i64)           m.contains_key(k: K) -> bool\n");
    buf_bytes(out, "MinHeap::new_in(gpa), h.push(x), h.pop() -> Option<T>   a priority queue, smallest first; BinaryHeap: largest\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`[u8]` compares with `==`, `<` and `cmp_of` (`'a'` is a `u8`); `for b\n");
    buf_bytes(out, "in s` yields its bytes. A slice from `as_slice()`, `trim`, `split_in` or\n");
    buf_bytes(out, "a `Scanner` views its text: keep the `Buf`, and push to it only when\n");
    buf_bytes(out, "done with them (`guide std#overview`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "An allocator (`gpa`, from `fn main(gpa: Gpa)`, passed down as a\n");
    buf_bytes(out, "parameter) goes only to constructors and `_in` functions; methods\n");
    buf_bytes(out, "(`push`, `insert`, `clone`, `sort`) use the container's own. Not in\n");
    buf_bytes(out, "std: `String` (text is `[u8]` and `Buf`), `Box`. (0.20)\n");
    buf_bytes(out, "`std::collections::HashSet`: `insert` (false if present), `contains`,\n");
    buf_bytes(out, "`remove`, `iter()`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "@PAGE-END@ More, a section at a time: `tachyonc guide std#the-api` (every item, a line each), `std#overview` (ownership, views, HashMap), `std#input` (reading stdin), `std#heaps` (priority queues); one item: `tachyonc guide --find NAME`; all of it: `tachyonc guide std --whole`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Overview\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The standard library is the module `std`, built into the compiler. The\n");
    buf_bytes(out, "prelude names need no import: `Option`, `Some`, `None`, `Result`, `Ok`,\n");
    buf_bytes(out, "`Err`, `Vec`, `print`, `println`, `eprint`, `eprintln`, `format`,\n");
    buf_bytes(out, "`format_in`, the allocators (`Gpa`, `Allocator`, `Arena`, `ScopedArena`,\n");
    buf_bytes(out, "`arena_scope`), the traits `Add`, `Sub`, `Mul`, `Div`, `Neg`, `Eq`,\n");
    buf_bytes(out, "`Ord`, `Hash`, `Iterator`, `Display`, `Debug`, `Clone`, `From`, `Into`,\n");
    buf_bytes(out, "and (0.17) `Buf`, `HashMap`, `read_line`, `read_stdin_in`, `Scanner`,\n");
    buf_bytes(out, "`parse_int`, `trim`, `split_in`, `split_whitespace_in`, `sort`,\n");
    buf_bytes(out, "`sort_by`, `sort_stable`, `sort_stable_by` (and their `_in` forms),\n");
    buf_bytes(out, "`cmp_of`, `eq_of`, `Fmt`, `panic(msg)` and `unreachable()`; (0.18.1)\n");
    buf_bytes(out, "the heaps `BinaryHeap` and `MinHeap`.\n");
    buf_bytes(out, "Anything else is used by path (`std::print_int(n)`) or imported by name\n");
    buf_bytes(out, "(`use std::{IoError, is_digit};`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "What a Rust programmer will miss: there is no `String` (use `[u8]` and\n");
    buf_bytes(out, "`Buf`), no file reading (call C; iterators: `tachyonc guide\n");
    buf_bytes(out, "iterators`). A `Vec` (and a `Buf`) indexes as\n");
    buf_bytes(out, "its slice: `v[i]`, `v[i] = x`, `v[a..b]` (0.17), checked. Formatting is 0.15's f-strings,\n");
    buf_bytes(out, "`println(f\"{x:>4}\")` (`tachyonc guide formatting`); errors are enums in a\n");
    buf_bytes(out, "`Result` (`tachyonc guide conversions`). A `Vec`, `Buf` or `HashMap` is\n");
    buf_bytes(out, "dropped (freed) at the end of its scope (0.17): no `free` calls.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `Vec<T>`, `Buf` and `HashMap<K, V>` own their memory: `let w = v;`\n");
    buf_bytes(out, "  moves it, `.clone()` copies. Pass `&v` (a `&Vec<T>`) to functions that\n");
    buf_bytes(out, "  read it, `&mut v` (a `&mut Vec<T>`) to those that change it.\n");
    buf_bytes(out, "- A slice from `as_slice()` views the container: the checker rejects its\n");
    buf_bytes(out, "  use after the next push, `free` or drop (`tachyonc guide views`).\n");
    buf_bytes(out, "- `get`, `set`, slice indexing and `unwrap` are checked: a failure prints\n");
    buf_bytes(out, "  a message and exits with 101.\n");
    buf_bytes(out, "- `HashMap` keys need `Hash` and `Eq` (integers, `bool`, `[u8]` have\n");
    buf_bytes(out, "  them; for a struct key, write `impl Hash`; `==` is structural). `==` on\n");
    buf_bytes(out, "  Vecs, Bufs and maps compares their contents (0.15). `get`\n");
    buf_bytes(out, "  returns a copy of the value in an `Option`. Iterate with\n");
    buf_bytes(out, "  `for i in 0..m.slots()` and `key_at(i)`/`value_at(i)`, in slot order\n");
    buf_bytes(out, "  (not the order of insertion).\n");
    buf_bytes(out, "- (0.20) A `HashMap` is a Swiss table (hashbrown's design), and std's\n");
    buf_bytes(out, "  hashes are foldhash with fixed seeds (`std::hash::FixedState`): the\n");
    buf_bytes(out, "  slot order is the same in every run and on every target. Not proof\n");
    buf_bytes(out, "  against keys an attacker chooses: `std::hash::SipHashState::new()`\n");
    buf_bytes(out, "  hashes with SipHash-1-3 and random keys, as Rust's default does.\n");
    buf_bytes(out, "- To change a value in place, `get_mut(k)` and `get_or_insert(k, d)`\n");
    buf_bytes(out, "  give a writable view of one element (`&mut [V]`; `a[0]` is the value),\n");
    buf_bytes(out, "  safe to use until the map's next insert, remove or free, like\n");
    buf_bytes(out, "  `as_mut_slice()`: Rust's `*m.entry(k).or_insert(0) += 1` is\n");
    buf_bytes(out, "  `counts.get_or_insert(word, 0)[0] += 1;`.\n");
    buf_bytes(out, "- `sort(s)` sorts a slice in place by `Ord` (an introsort: O(n log n),\n");
    buf_bytes(out, "  not stable); `v.sort()`, `s.sort()` too.\n");
    buf_bytes(out, "- (0.17) `sort(&mut a[..])`, `sort(v.as_mut_slice())`; `v.free()`\n");
    buf_bytes(out, "  frees now and leaves `v` empty; `v.take()` moves the contents out,\n");
    buf_bytes(out, "  leaving an empty container with the same allocator;\n");
    buf_bytes(out, "  `std::take`, `std::replace`, `std::swap`; `v.iter_ref()` yields `&T`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let mut counts: HashMap<[u8], i64> = HashMap::new_in(gpa);\n");
    buf_bytes(out, "    let words = [\"a\", \"b\", \"a\", \"c\", \"a\"];\n");
    buf_bytes(out, "    for w in words {\n");
    buf_bytes(out, "        counts.get_or_insert(w, 0)[0] += 1;\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    if let Some(n) = counts.get_mut(\"c\") {\n");
    buf_bytes(out, "        n[0] *= 10;\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    for i in 0..counts.slots() {\n");
    buf_bytes(out, "        if let Some(k) = counts.key_at(i) {\n");
    buf_bytes(out, "            print(k);\n");
    buf_bytes(out, "            print(\"=\");\n");
    buf_bytes(out, "            std::print_int(counts.value_at(i).unwrap());\n");
    buf_bytes(out, "            print(\" \");\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    std::print_int(counts.len());\n");
    buf_bytes(out, "    if counts.contains_key(\"b\") { println(\" has b\"); }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "b=1 a=3 c=10\n");
    buf_bytes(out, "3 has b\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Heaps: priority queues\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`BinaryHeap<T>` and `MinHeap<T>` (`T: Ord`; tuples compare field by\n");
    buf_bytes(out, "field) are priority queues: `push(x)`, `pop() -> Option<T>`, `peek()`,\n");
    buf_bytes(out, "`len()`, `from_vec(v)`, `into_sorted_vec()`; a BinaryHeap pops the\n");
    buf_bytes(out, "largest first, a MinHeap the smallest (Rust's `BinaryHeap<Reverse<T>>`:\n");
    buf_bytes(out, "tachyon has no tuple structs, so no `Reverse(x)`). Dijkstra with a\n");
    buf_bytes(out, "MinHeap: `tachyonc guide --find dijkstra`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Input\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`read_line(&mut buf)` reads stdin a line at a time: the line goes into the\n");
    buf_bytes(out, "`Buf` without its `'\\n'`, and the result is `Ok(false)` at the end of\n");
    buf_bytes(out, "input (an empty line is `Ok(true)` with an empty `buf`; a read error is\n");
    buf_bytes(out, "`Err(IoError::Read)`). `read_stdin_in(gpa)` returns all of stdin that is left\n");
    buf_bytes(out, "(a `Result<Buf, IoError>`); the two share a buffer, so they mix, but not with\n");
    buf_bytes(out, "C's `getchar` or `scanf`. A `Scanner` reads a text's tokens\n");
    buf_bytes(out, "(`next_token`; `next_int`, a `Result<i64, ScanError>`) and lines\n");
    buf_bytes(out, "(`next_line`); `parse_int` (a `Result<i64, ParseIntError>`),\n");
    buf_bytes(out, "`split_in`, `split_whitespace_in` and `trim` work on any `[u8]`. An Option\n");
    buf_bytes(out, "means absence (the end, nothing found), a Result a failure: `.ok()`\n");
    buf_bytes(out, "turns one into the other, `.unwrap_or(x)` gives a default. What they\n");
    buf_bytes(out, "return are views of the text: keep the `Buf` until done with them. The\n");
    buf_bytes(out, "next `read_line` overwrites the line, so to keep a part of it (a map's\n");
    buf_bytes(out, "key), read all of stdin and take lines with `Scanner::next_line`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let mut line = Buf::new_in(gpa);\n");
    buf_bytes(out, "    read_line(&mut line).unwrap();        // the header: \"n m\"\n");
    buf_bytes(out, "    let header = split_whitespace_in(line.as_slice(), gpa);\n");
    buf_bytes(out, "    let n = parse_int(header.get(0)).unwrap();\n");
    buf_bytes(out, "    let m = parse_int(header.get(1)).unwrap_or(0);\n");
    buf_bytes(out, "    let rest = read_stdin_in(gpa).unwrap(); // everything after it\n");
    buf_bytes(out, "    let mut sc = Scanner::new(rest.as_slice());\n");
    buf_bytes(out, "    let mut sum = 0;\n");
    buf_bytes(out, "    for _ in 0..n {\n");
    buf_bytes(out, "        sum += sc.next_int().unwrap();\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    std::print_int(sum * m);\n");
    buf_bytes(out, "    print(\" [\");\n");
    buf_bytes(out, "    print(sc.next_line().unwrap());       // the rest of that line\n");
    buf_bytes(out, "    println(\"]\");\n");
    buf_bytes(out, "    while let Some(l) = sc.next_line() {  // the lines after it\n");
    buf_bytes(out, "        print(l);\n");
    buf_bytes(out, "        println(\"|\");\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```in\n");
    buf_bytes(out, "3 2\n");
    buf_bytes(out, "10 20 30 tail\n");
    buf_bytes(out, "x y\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "last\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "120 [ tail]\n");
    buf_bytes(out, "x y|\n");
    buf_bytes(out, "|\n");
    buf_bytes(out, "last|\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## The API\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Generated from std's source in this compiler: every public item a\n");
    buf_bytes(out, "program uses, one line each. Methods take `self: &Self` (reads),\n");
    buf_bytes(out, "`self: &mut Self` (changes; called as `v.push(x)` on a place), `self:\n");
    buf_bytes(out, "*Self` (a reference, the older spelling) or `self: Self` (by value). Each item with its\n");
    buf_bytes(out, "comment: `tachyonc guide std#every-item`; one item's source: `tachyonc\n");
    buf_bytes(out, "query show std::Scanner::next_line`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "@STD-API@\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "@STD-API-DOC@\n");
}
