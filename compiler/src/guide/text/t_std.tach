// Generated by compiler/guide/embed.sh from compiler/guide/std.md (do
// not edit): the guide's topic 'std'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# std\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The standard library is the module `std`, built into the compiler. The\n");
    buf_bytes(out, "prelude names need no import: `Option`, `Some`, `None`, `Result`, `Ok`,\n");
    buf_bytes(out, "`Err`, `Vec`, `print`, `println`, and the traits `Add`, `Sub`, `Mul`,\n");
    buf_bytes(out, "`Div`, `Neg`, `Eq`, `Ord`, `Hash`. Anything else is used by path\n");
    buf_bytes(out, "(`std::print_int(n)`, `std::sort(s)`) or imported by name\n");
    buf_bytes(out, "(`use std::{Buf, HashMap, sort};`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "What a Rust programmer will miss: there is no `String` (use `[u8]` and\n");
    buf_bytes(out, "`Buf`), no formatting (`print` takes a `[u8]`; numbers through\n");
    buf_bytes(out, "`print_int` or `Buf::push_int`; floats through C's `printf`), no\n");
    buf_bytes(out, "iterators, no file or stdin reading (call C), no `HashSet` (a\n");
    buf_bytes(out, "`HashMap<K, bool>`), no `Vec` indexing (`get`, `set`, `as_slice()[i]`),\n");
    buf_bytes(out, "no `Option::map`. Nothing frees itself: call `free()`, usually right\n");
    buf_bytes(out, "after creating the value with `defer x.free();`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `Vec<T>`, `Buf` and `HashMap<K, V>` are handles: copying one shares its\n");
    buf_bytes(out, "  memory. Pass `&v` (a `*Vec<T>`) to functions that change it.\n");
    buf_bytes(out, "- A slice from `as_slice()` is valid until the next push or `free`.\n");
    buf_bytes(out, "- `get`, `set`, slice indexing and `unwrap` are checked: a failure prints\n");
    buf_bytes(out, "  a message and exits with 101.\n");
    buf_bytes(out, "- `HashMap` keys need `Hash` and `Eq` (integers, `bool`, `[u8]` have\n");
    buf_bytes(out, "  them; for a struct key, write `impl Hash`; `==` is structural). `get`\n");
    buf_bytes(out, "  returns a copy of the value in an `Option`. Iterate with\n");
    buf_bytes(out, "  `for i in 0..m.slots()` and `key_at(i)`/`value_at(i)`, in slot order\n");
    buf_bytes(out, "  (not the order of insertion).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "use std::HashMap;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut counts: HashMap<[u8], i64> = HashMap::new();\n");
    buf_bytes(out, "    defer counts.free();\n");
    buf_bytes(out, "    let words = [\"a\", \"b\", \"a\", \"c\", \"a\"];\n");
    buf_bytes(out, "    for w in words {\n");
    buf_bytes(out, "        let n = counts.get(w).unwrap_or(0);\n");
    buf_bytes(out, "        counts.insert(w, n + 1);\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    for i in 0..counts.slots() {\n");
    buf_bytes(out, "        if let Some(k) = counts.key_at(i) {\n");
    buf_bytes(out, "            print(k);\n");
    buf_bytes(out, "            print(\"=\");\n");
    buf_bytes(out, "            std::print_int(counts.value_at(i).unwrap());\n");
    buf_bytes(out, "            print(\" \");\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    std::print_int(counts.len());\n");
    buf_bytes(out, "    if counts.contains(\"b\") { println(\" has b\"); }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "c=1 a=3 b=1\n");
    buf_bytes(out, "3 has b\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## The API\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Generated from std's source in this compiler: every public item, with\n");
    buf_bytes(out, "its comment. Methods take `self: *T` (called as `v.push(x)` on a place)\n");
    buf_bytes(out, "or `self: T` (a copy).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "@STD-API@\n");
    buf_bytes(out, "```\n");
}
