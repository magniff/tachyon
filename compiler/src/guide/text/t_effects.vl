// Generated by compiler/guide/embed.sh from compiler/guide/effects.md (do
// not edit): the guide's topic 'effects'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Effects (0.16)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Every function has an inferred effect set: what calling it may do. It\n");
    buf_bytes(out, "is inferred from the body and everything the body calls, closures and\n");
    buf_bytes(out, "generic instances included, and never depends on `-O`. A signature\n");
    buf_bytes(out, "says two things: its conventions what a call may change of its\n");
    buf_bytes(out, "arguments (`inout`) and keep (`sink`), its effects what it may do beyond\n");
    buf_bytes(out, "them:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| effect | comes from |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `alloc(Gpa)`, `alloc(Arena)`, `alloc(extern)` | allocating from that allocator type (`extern`: C's malloc) |\n");
    buf_bytes(out, "| `io` | a C function that reads or writes: `write`, `read`, stdio |\n");
    buf_bytes(out, "| `global` | reading or writing a `static var`, taking its address |\n");
    buf_bytes(out, "| `panic` | a checked index or slice, `unwrap`, `as E`, std's panic |\n");
    buf_bytes(out, "| `diverge` | `while`, `loop`, recursion: it may not return (a counted `for` returns) |\n");
    buf_bytes(out, "| `unsafe` | unsafe operations in its own body (not its callers') |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A set is written in that order, `none` for the empty one. Allocation is\n");
    buf_bytes(out, "explicit (`guide allocators`), so `alloc(Gpa)` without `global` means\n");
    buf_bytes(out, "\"from a Gpa it was given\". Running out of memory is `alloc`, not `panic`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Asking\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```sh\n");
    buf_bytes(out, "volec query effects total            # crate::total  alloc(Gpa) panic\n");
    buf_bytes(out, "volec query effects crate::parser    # every function of a module\n");
    buf_bytes(out, "volec query effects total --why alloc     # the chain of calls down to where it allocates\n");
    buf_bytes(out, "volec query effects crate --has io        # the functions that do io\n");
    buf_bytes(out, "volec --print-effects main.vl           # every function's set, then the build\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`query def`, `show` and `context` print a function's set on its first\n");
    buf_bytes(out, "line (`effects: alloc(Gpa) panic`); a generic function's sets are its\n");
    buf_bytes(out, "instances' (`query effects` lists each).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Declaring\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A declaration is an upper bound the compiler checks against the\n");
    buf_bytes(out, "inferred set; callers still see the inferred one, which may be smaller.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "#[pure]                                   // no alloc, io or global\n");
    buf_bytes(out, "fn mid(a: i64, b: i64) -> i64 { a + (b - a) / 2 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[no_alloc]\n");
    buf_bytes(out, "fn sum(s: [i64]) -> i64 { s.iter().sum() }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[effects(alloc(Gpa), panic)]             // at most these\n");
    buf_bytes(out, "fn grow(v: inout Vec<i64>) { v.push(1); }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn apply<F: Fn(i64) -> i64 + effects(panic)>(f: F, x: i64) -> i64 { f(x) }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let a = [1, 2];\n");
    buf_bytes(out, "    println(apply(|x| mid(x, 10), 2) + sum(a[..]));\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "9\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `#[pure]`: no `alloc`, `io`, `global` (it may panic, loop and write\n");
    buf_bytes(out, "  through its `inout` parameters: they are in the signature, the call\n");
    buf_bytes(out, "  marks them `&x`); `#[no_alloc]`, `#[no_io]`,\n");
    buf_bytes(out, "  `#[no_panic]` forbid one; `#[effects(...)]` lists what is allowed,\n");
    buf_bytes(out, "  `#[effects()]` nothing. Several attributes intersect.\n");
    buf_bytes(out, "- On a trait's function (`#[pure] fn hash(self) -> u64;`) the\n");
    buf_bytes(out, "  declaration binds every impl; std's `Eq`, `Ord` and `Hash` are pure.\n");
    buf_bytes(out, "- On a C function in an `extern` block it is trusted, as its signature\n");
    buf_bytes(out, "  is. Undeclared, std's table applies (libm and `mem*`: none, `malloc`:\n");
    buf_bytes(out, "  `alloc(extern)`, stdio: `io`), else everything.\n");
    buf_bytes(out, "- A bound `F: Fn(..) -> R + effects(panic)` is checked where `F` is\n");
    buf_bytes(out, "  given: the error is at the call, naming the closure's effect.\n");
    buf_bytes(out, "- A call through a `fn` value may call every function of that type\n");
    buf_bytes(out, "  whose address the program takes.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A broken declaration is one error with where the effect comes from:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "sum.vl:3:1: error[effect] 'total' is #[no_alloc], but it allocates from Gpa: 'v.push(x)' at sum.vl:7:9 grows a Vec<i64>\n");
    buf_bytes(out, "help: allocate in the caller and pass the memory in, or remove #[no_alloc]\n");
    buf_bytes(out, "try: volec query effects total --why alloc\n");
    buf_bytes(out, "```\n");
}
