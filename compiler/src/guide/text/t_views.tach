// Generated by compiler/guide/embed.sh from compiler/guide/views.md (do
// not edit): the guide's topic 'views'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Views\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A *view* points into memory something else owns: a slice `[T]` (a\n");
    buf_bytes(out, "string literal, `v.as_slice()`, `a[1..3]`), an access field (`q: inout\n");
    buf_bytes(out, "Query`, `cfg: let Config`), a struct holding one (`Scanner`, `struct Tok\n");
    buf_bytes(out, "{ text: [u8] }`), a `Vec<[u8]>` of them, a closure that captures by\n");
    buf_bytes(out, "access. Views are second-class: the checker keeps each one inside what\n");
    buf_bytes(out, "it views, with no lifetimes to write.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## What a view may do\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- Live in locals, parameters, struct fields and containers\n");
    buf_bytes(out, "  (`Vec<[u8]>`, `HashMap<[u8], i64>`): a parser keeps tokens that view\n");
    buf_bytes(out, "  its input.\n");
    buf_bytes(out, "- Be returned when it views a parameter: `fn first_word(s: [u8]) ->\n");
    buf_bytes(out, "  [u8]`, `fn as_slice(self) -> [T]` on a `Vec<T>`.\n");
    buf_bytes(out, "- Not outlive its owner: not returned out of the function that owns the\n");
    buf_bytes(out, "  memory (`own.escape`), not used after its owner changed, moved or was\n");
    buf_bytes(out, "  dropped (`own.conflict`).\n");
    buf_bytes(out, "- Statics hold only views of constant data (string literals).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`[T]` is read-only (a let access to elements); `inout [T]` is the\n");
    buf_bytes(out, "exclusive, writable one: `fn fill(s: inout [i64], x: i64)`, called as\n");
    buf_bytes(out, "`fill(&a[1..3], 0)`, `fill(&v[..], 0)` or `fill(v.as_mut_slice(), 0)`\n");
    buf_bytes(out, "(already an access: no `&`). A struct with an `inout` field (`struct\n");
    buf_bytes(out, "Parser { q: inout Query }`) is a *move-only* view: it moves, it is not\n");
    buf_bytes(out, "copied, and while it lives `q` is reached only through it.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Exclusivity\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "While a view of `x` (or a let access, a let argument) is used later,\n");
    buf_bytes(out, "nothing writes, moves or drops `x`; while an inout access `&x` is used\n");
    buf_bytes(out, "later, `x` is reached only through it. Uses end at the last one (not at the end of the block), so a view\n");
    buf_bytes(out, "that is not used again is no conflict.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "let first = v.as_slice();   v.push(4);   first[0]     own.conflict: use first before the push\n");
    buf_bytes(out, "for x in v { v.push(x); }                             own.conflict: loop over 0..v.len()\n");
    buf_bytes(out, "f(&a, a)                                              own.conflict: f(&a.x, a.y) is fine\n");
    buf_bytes(out, "rng.big(1 + rng.next())                               own.conflict: let n = rng.next(); first\n");
    buf_bytes(out, "v.push(v.len())                                       fine: the receiver is taken after the arguments\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Disjoint fields do not overlap; `v[i]` and `v[j]` do (`v.swap(i, j)`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## What a function returns: its view summary\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Each function has an inferred summary, like its effects (`guide\n");
    buf_bytes(out, "effects`): which parameters its result (and what its `inout` parameters\n");
    buf_bytes(out, "come to hold) points into.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| summary | meaning | e.g. |\n");
    buf_bytes(out, "|---|---|---|\n");
    buf_bytes(out, "| `views(self)` | points into what `self` points to | `Vec::as_slice`; a lexer that owns its text, returning `self.src.as_slice()[a..b]` |\n");
    buf_bytes(out, "| `views(*self)` | carries views `self` holds, not into `self` | a parser returning a token's `text` |\n");
    buf_bytes(out, "| `views(s)`, `views()` | into parameter `s`; nothing | `first_word(s)`; a function returning a Buf |\n");
    buf_bytes(out, "| `stores(word)` | what the `inout` parameters may come to hold | `intern(names: inout Vec<[u8]>, word: [u8])` |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`tachyonc query views NAME --why` shows a summary and the line that\n");
    buf_bytes(out, "makes each part; `#[views(*self)]` on a function pins it (the body is\n");
    buf_bytes(out, "checked against it, callers use it).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Parsers and lexers\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A parser over tokens that view the input, and a lexer over text its\n");
    buf_bytes(out, "caller owns, are `views(*self)`: what they return outlives the next\n");
    buf_bytes(out, "call. This checks clean:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct Tok { text: [u8], kind: i64 }\n");
    buf_bytes(out, "struct Parser { toks: Vec<Tok>, pos: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Parser {\n");
    buf_bytes(out, "    fn name(inout self) -> [u8] {\n");
    buf_bytes(out, "        let t = self.toks[self.pos];\n");
    buf_bytes(out, "        self.pos += 1;\n");
    buf_bytes(out, "        t.text                        // a view of the input, not of the parser\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) {\n");
    buf_bytes(out, "    var p = Parser { toks: Vec::new_in(gpa), pos: 0 };\n");
    buf_bytes(out, "    p.toks.push(Tok { text: \"let\", kind: 0 });\n");
    buf_bytes(out, "    p.toks.push(Tok { text: \"x\", kind: 1 });\n");
    buf_bytes(out, "    let a = p.name();\n");
    buf_bytes(out, "    let b = p.name();                 // a is still fine\n");
    buf_bytes(out, "    println(f\"{a} {b}\");\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "let x\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A lexer that *owns* its text (`src: Buf`) and returns views of it is\n");
    buf_bytes(out, "`views(self)`: the second call (`word(inout self)`) changes the lexer\n");
    buf_bytes(out, "while the first word still views it.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "main.tach:14:13: error[own.conflict] 'lx.word()' may change 'lx' while 'a' (main.tach:13:9) views it; 'a' is used at main.tach:15:16\n");
    buf_bytes(out, "  help: use the view before the change, keep an index instead of a view, or keep a copy\n");
    buf_bytes(out, "  try: tachyonc query own main.tach:15:16\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Let the lexer view text its caller owns (`src: [u8]`: `tachyonc\n");
    buf_bytes(out, "refactor field Lexer --type src '[u8]'`), or copy each word into a\n");
    buf_bytes(out, "`Buf`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## The diagnostics\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Each is one line (`check` joins the parts with ` | `), with what\n");
    buf_bytes(out, "happened and both positions, a `help:` with the fix, and `try:` lines\n");
    buf_bytes(out, "that run as they are. `tachyonc explain own.conflict` (and the other\n");
    buf_bytes(out, "codes) has each in full; `tachyonc query own FILE:LINE:COL` shows every\n");
    buf_bytes(out, "local's state at a position.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "main.tach:10:5: error[own.conflict] 'v.push(4)' may change 'v' while 'first' (main.tach:9:9) views it; 'first' is used at main.tach:11:13\n");
    buf_bytes(out, "  help: use the view before the change, keep an index instead of a view, or keep a copy\n");
    buf_bytes(out, "  try: tachyonc edit patch main --old 'v.as_slice()' --new 'v.clone()'\n");
    buf_bytes(out, "  try: tachyonc query own main.tach:11:13\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "greet.tach:4:5: error[own.escape] 'greet' returns a view of 'b', which is dropped when 'greet' returns\n");
    buf_bytes(out, "  help: return the owner itself; a caller that wants a view takes '.as_slice()' of it\n");
    buf_bytes(out, "  try: tachyonc edit patch greet --old '-> [u8]' --new '-> Buf' --old 'b.as_slice()' --new 'b'\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "main.tach:12:18: error[own.conflict] 'v.push(x)' may change the elements of 'v' while the 'for' at main.tach:12:5 iterates over them\n");
    buf_bytes(out, "  help: loop over the indexes (the loop sees the elements present when it starts), or collect the new elements and append them after the loop\n");
    buf_bytes(out, "  try: tachyonc edit patch main --old 'for x in v {' --new 'for i in 0..v.len() { let x = v[i];'\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "main.tach:6:11: error[own.conflict] 'a' is borrowed mutably by '&a' and mutably again by '&a' in the same call\n");
    buf_bytes(out, "  help: pass disjoint places, copy the plain value out first, or for two elements of one Vec use 'v.swap(i, j)'\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "They are errors by default (`--values=error`). `--values=warn` makes\n");
    buf_bytes(out, "them warnings; `--values=report` lists them without failing\n");
    buf_bytes(out, "the build; `--values=off` turns the checks and the drops off (0.16's\n");
    buf_bytes(out, "semantics, for code not yet migrated by `tachyonc fix --values`).\n");
}
