use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Rust -> tachyon\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "What a Rust programmer reaches for, and what tachyon has instead.\n");
    buf_bytes(out, "Tachyon looks like Rust, so the Rust habit compiles to an error more\n");
    buf_bytes(out, "often than to something else; each error names the fix.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Text\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| Rust | tachyon |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `&str`, `String`, `&[u8]` | `[u8]`: a pointer and a length; `\"abc\"` is one; no UTF-8 type |\n");
    buf_bytes(out, "| `String::new()`, `push_str`, `format!` | `std::Buf` (`Buf::new_in(gpa)`): `push`, `push_str`, `push_int`, `push_fmt(f\"..\")` (or `push_str(f\"..\")`), `as_slice`; `format_in(f\"..\", gpa)` |\n");
    buf_bytes(out, "| `s.len()` | the same (0.17), an `i64`; or the field `s.len` |\n");
    buf_bytes(out, "| `s == \"x\"`, `s < t` | the same (std's `Eq` and `Ord` for `[u8]`, by bytes) |\n");
    buf_bytes(out, "| `&s[1..3]` | `s[1..3]` (checked) |\n");
    buf_bytes(out, "| `s.as_bytes()[0]`, `b'a'` | `s[0]`, `'a'` (a `u8`) |\n");
    buf_bytes(out, "| `CString`, `.as_ptr()` | `c\"text\"` (a `*u8`); a slice is not NUL-terminated |\n");
    buf_bytes(out, "| `match s { \"a\" => .. }` | `if s == \"a\" { .. } else if ...` |\n");
    buf_bytes(out, "| `x.to_string()`, `s.parse::<i64>()` | `Buf::push_int`; `std::parse_int(s)` (a `Result<i64, ParseIntError>`, 0.15) |\n");
    buf_bytes(out, "| `s.trim()`, `s.split(',')`, `s.split_whitespace()` | `std::trim(s)`; `std::split_in(s, ',', gpa)`, `std::split_whitespace_in(s, gpa)`: a `Vec<[u8]>` of views of `s` |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let mut b = Buf::new_in(gpa);              // freed at the end of main\n");
    buf_bytes(out, "    b.push_str(\"sum=\");\n");
    buf_bytes(out, "    let parts = split_in(\"40,2\", ',', gpa);\n");
    buf_bytes(out, "    let mut sum = 0;\n");
    buf_bytes(out, "    for p in parts.as_slice() {\n");
    buf_bytes(out, "        sum += parse_int(p).unwrap_or(0);\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    b.push_int(sum);\n");
    buf_bytes(out, "    println(b.as_slice());\n");
    buf_bytes(out, "    if parse_int(\"4x\").is_err() { println(\"not a number\"); }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "sum=42\n");
    buf_bytes(out, "not a number\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## References, ownership, memory\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| Rust | tachyon |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `&T`, `&mut T`, `&x`, `&mut x` | the same (0.17): checked, no lifetimes written; `&mut x` at the call when the parameter is `&mut T` |\n");
    buf_bytes(out, "| `&self`, `&mut self` | `self: &Self`, `self: &mut Self` (written out); calls reference the receiver: `v.push(1)` |\n");
    buf_bytes(out, "| `*r`, `r.field` | the same; fields and methods reach through a reference |\n");
    buf_bytes(out, "| moves, `Clone`, `Copy` | the same: an owned value (`Vec`, `Buf`, `HashMap`, a struct holding one) moves; `.clone()` copies; plain values copy (no `Copy` derive) |\n");
    buf_bytes(out, "| `Drop`, RAII | the same: dropped at the end of the scope, last first; `impl Drop for T { fn drop(self: &mut T) }`; `drop(x)` |\n");
    buf_bytes(out, "| `&str`, `&[T]`, `&mut [T]` | `[u8]`, `[T]` (read-only), `&mut [T]` (writable) |\n");
    buf_bytes(out, "| lifetimes `'a`, `fn f<'a>(x: &'a str) -> &'a str` | none: each function's view summary is inferred (`query views NAME`); `#[views(s)]` pins one (`guide views`) |\n");
    buf_bytes(out, "| the borrow checker | the own pass: `own.moved`, `own.conflict`, `own.escape`... each with `try:` lines (`tachyonc explain own.conflict`) |\n");
    buf_bytes(out, "| `Box<T>`, `Rc<T>`, `Arc<T>` | none: a `Vec<T>`, an index, or `malloc` in `unsafe` |\n");
    buf_bytes(out, "| `Vec::new()`, the global allocator | `Vec::new_in(gpa)`: allocation is explicit (0.16); `gpa: Gpa` comes from `fn main(gpa: Gpa)` and is passed down; `arena_scope(gpa, \\|a\\| ..)` (`guide allocators`) |\n");
    buf_bytes(out, "| `Option<&T>` | `Option<T>` of a copy, an index, or a one-element view `[T]` (references as type arguments: 0.17.1) |\n");
    buf_bytes(out, "| `&mut v[i]`, `m.get_mut(&k)` | `v[i].f = x`; `m.get_mut(k)`: an `Option<[V]>`, a view of one element (`a[0].f += 1`) |\n");
    buf_bytes(out, "| `*m.entry(k).or_insert(0) += 1` | `m.get_or_insert(k, 0)[0] += 1` |\n");
    buf_bytes(out, "| `std::mem::take`, `replace` | `std::take(&mut x)`, `std::replace(&mut x, v)` |\n");
    buf_bytes(out, "| `Mutex`, threads | none in tachyon (C's threads are C's business) |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Pass a container to a function that changes it as `&mut`, one that reads\n");
    buf_bytes(out, "it as `&`; return a new one by value (the caller owns it):\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "fn fill(v: &mut Vec<i64>, n: i64) {      // v.push works through the reference\n");
    buf_bytes(out, "    for i in 0..n { v.push(i * i); }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn sum(v: &Vec<i64>) -> i64 {\n");
    buf_bytes(out, "    let mut s = 0;\n");
    buf_bytes(out, "    for x in v { s += x; }\n");
    buf_bytes(out, "    s\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let mut v: Vec<i64> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    fill(&mut v, 4);\n");
    buf_bytes(out, "    let r = &mut v;                      // a reference in a local: passed on twice\n");
    buf_bytes(out, "    fill(r, 1);\n");
    buf_bytes(out, "    fill(r, 1);\n");
    buf_bytes(out, "    std::print_int(v.len() + sum(&v));\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "20\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Before 0.17, `*T` was the one pointer type and `&x` its address: a\n");
    buf_bytes(out, "non-`mut` `p: *T` parameter is still accepted (as `&mut T`), and\n");
    buf_bytes(out, "`tachyonc fix --values` rewrites such code to references.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Errors and Option\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| Rust | tachyon |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `x?` | the same (0.15), on `Option` and `Result`; the error goes through `From` |\n");
    buf_bytes(out, "| `panic!(\"msg\")`, `unreachable!()` | `panic(\"msg\")`, `unreachable()` (0.17; exit 101), or `return` an error |\n");
    buf_bytes(out, "| `.map()`, `.and_then()`, `.ok_or()`, `.map_err()` | the same (0.15), and `unwrap_or_else` |\n");
    buf_bytes(out, "| `.unwrap()`, `.unwrap_or(d)`, `.is_some()`, `.is_none()` | the same |\n");
    buf_bytes(out, "| `.is_ok()`, `.is_err()`, `.ok()` | the same |\n");
    buf_bytes(out, "| `assert!(c)`, `debug_assert!` | `if !c { panic(\"...\"); }` |\n");
    buf_bytes(out, "| `std::process::exit(n)` | `return n;` from `main`, or C's `exit` in `unsafe` |\n");
    buf_bytes(out, "| `fn main() -> Result<(), E>` | the same (0.15): `Err(e)` prints `Error: ` and `e`'s Debug, exit 1 |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "enum Error { Empty, TooBig(i64) }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn check(n: i64) -> Result<i64, Error> {\n");
    buf_bytes(out, "    if n == 0 { return Err(Error::Empty); }\n");
    buf_bytes(out, "    if n > 100 { return Err(Error::TooBig(n)); }\n");
    buf_bytes(out, "    Ok(n * 2)\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn twice_checked(n: i64) -> Result<i64, Error> {\n");
    buf_bytes(out, "    let v = check(n)?;                    // Err(e) returns Err(e)\n");
    buf_bytes(out, "    Ok(v + 1)\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    match twice_checked(500) {\n");
    buf_bytes(out, "        Ok(v) => std::print_int(v),\n");
    buf_bytes(out, "        Err(Error::TooBig(n)) => { print(\"too big: \"); std::print_int(n); }\n");
    buf_bytes(out, "        Err(Error::Empty) => print(\"empty\"),\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    std::print_int(twice_checked(4).unwrap());\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "too big: 500\n");
    buf_bytes(out, "9\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Iteration and closures\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| Rust | tachyon |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `for x in v.iter()`, `for x in &v` | the same (0.14), and `for x in v`: a copy of each element |\n");
    buf_bytes(out, "| `for (i, x) in s.iter().enumerate()` | the same (0.14) |\n");
    buf_bytes(out, "| `for x in v.iter_mut() { *x += 1 }` | `for i in 0..s.len { s[i] += 1; }` |\n");
    buf_bytes(out, "| `.map()`, `.filter()`, `.sum()`, `.collect()` | the same (0.14); `collect_in(gpa)` makes a `Vec` only (`guide iterators`) |\n");
    buf_bytes(out, "| `\\|x\\| x + 1`, `move \\|\\|` | the same (0.14); a `let mut` is captured by reference, the rest by value (`guide closures`) |\n");
    buf_bytes(out, "| `impl Fn(i64) -> i64`, `Box<dyn Fn>` | a generic parameter `F: Fn(i64) -> i64`; none as a result |\n");
    buf_bytes(out, "| `(0..n).rev()` | the same (0.18.1) |\n");
    buf_bytes(out, "| `.step_by(2)` | `while` with `i += 2` |\n");
    buf_bytes(out, "| `sort()`, `sort_by(\\|a, b\\| ...)` | `std::sort(s)` (`T: Ord`; not stable); `v.sort_by(\\|a, b\\| b.cmp(a))` (0.14; `a`, `b`: `&T`) |\n");
    buf_bytes(out, "| `v.sort_by_key(\\|x\\| x.k)`, `v.retain(..)`, `v.contains(&x)`, `v.first()` | the same on a `Vec` (0.18.1; `sort_by_key` is stable); `contains(x)` takes x by value |\n");
    buf_bytes(out, "| `BinaryHeap<T>`; a min-heap `BinaryHeap<Reverse<T>>` | `BinaryHeap<T>`; `MinHeap<T>`, no `Reverse` (0.18.1, `guide std#heaps-priority-queues`) |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A function value is `fn(A) -> R`, a plain function, no environment.\n");
    buf_bytes(out, "Its parameters may be references (`fn(&mut Sum, i64)`, 0.17); a\n");
    buf_bytes(out, "function with raw `*T` parameters used as a value is called in\n");
    buf_bytes(out, "`unsafe` (its callee is not checked):\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```tach\n");
    buf_bytes(out, "struct Sum { total: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn add(s: &mut Sum, x: i64) { s.total += x; }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn each(xs: [i64], f: fn(&mut Sum, i64), s: &mut Sum) {\n");
    buf_bytes(out, "    for x in xs { f(s, x); }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn square(x: i64) -> i64 { x * x }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn map_sum(xs: [i64], f: fn(i64) -> i64) -> i64 {\n");
    buf_bytes(out, "    let mut t = 0;\n");
    buf_bytes(out, "    for x in xs { t += f(x); }\n");
    buf_bytes(out, "    t\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    let mut s = Sum { total: 0 };\n");
    buf_bytes(out, "    let xs = [1, 2, 3];\n");
    buf_bytes(out, "    each(xs[..], add, &mut s);\n");
    buf_bytes(out, "    std::print_int(s.total + map_sum(xs[..], square));\n");
    buf_bytes(out, "    println(\"\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "20\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Types and numbers\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| Rust | tachyon |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `usize` for lengths and indices | `i64` (`s.len`, `v.len()`); indexing takes any integer type |\n");
    buf_bytes(out, "| implicit widening `i32` -> `i64` | the same (0.15), lossless only; `i64::from(x)`; narrowing is `x as i32` |\n");
    buf_bytes(out, "| `i32::MAX`, `u8::MIN` | the same (0.15), for the integer types |\n");
    buf_bytes(out, "| overflow: panic in debug, wrap in release | always wraps (two's complement) |\n");
    buf_bytes(out, "| `x / 0` panics | `x / 0 == 0`, `x % 0 == x` |\n");
    buf_bytes(out, "| `!x` (bitwise not) | `~x` |\n");
    buf_bytes(out, "| `x.pow(n)`, `x.abs()`, `f.sqrt()` | write it, or C's `pow`, `labs`, `sqrt` (`import \"math.h\" as m;`) |\n");
    buf_bytes(out, "| `char`, a non-ASCII `char` literal | `u8`, ASCII literals only; `\"\\u{e9}\"` in strings is UTF-8 bytes |\n");
    buf_bytes(out, "| `()` | `()` |\n");
    buf_bytes(out, "| `!` (never) | `!`: `fn fail() -> ! { ... }` |\n");
    buf_bytes(out, "| `#[derive(PartialEq, Eq)]` | `==` is structural for structs, enums, tuples, arrays; `Vec`, `Buf`, `HashMap` by contents (0.15); `#[derive(Eq)]` checks it |\n");
    buf_bytes(out, "| `#[derive(Clone, Copy, Debug, Default, Hash)]` | `#[derive(Clone, Debug, Hash, Ord)]` (0.15); every value copies, no `Copy`, no `Default` |\n");
    buf_bytes(out, "| `impl Display`, `{:?}` | `impl Display for T { fn fmt(self: &T, f: &mut Fmt) {..} }`, `{x:?}` (0.15, `guide formatting`) |\n");
    buf_bytes(out, "| `impl From<A> for B`, `.into()` | the same (0.15, `guide conversions`) |\n");
    buf_bytes(out, "| `type A = B;` | the same (`type Pair<T> = (T, T);` too) |\n");
    buf_bytes(out, "| `const fn` | none; `const` items take constant expressions |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Syntax\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| Rust | tachyon |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `fn f(&self)`, `&mut self`, `self` | `fn f(self: &T)`, `fn f(self: &mut T)`, `fn f(self: T)`; `Self` works (`self: *T`, before 0.17: as `&mut T`) |\n");
    buf_bytes(out, "| `'a: loop { break 'a; }` | `a: loop { break :a; }` |\n");
    buf_bytes(out, "| `let x;` then assign | `let x = ...;` always |\n");
    buf_bytes(out, "| `let Some(x) = o else { .. };` | `let x = match o { Some(x) => x, None => return 1 };` |\n");
    buf_bytes(out, "| `P { x, y }` shorthand, `..base` | the shorthand (0.15); no `..base` |\n");
    buf_bytes(out, "| `where T: Ord` | `<T: Ord>` |\n");
    buf_bytes(out, "| `pub(crate)`, `pub(super)` | `pub`, or nothing (private to the module and its children) |\n");
    buf_bytes(out, "| `fn` inside a `fn` | items only at module level |\n");
    buf_bytes(out, "| `macro_rules!`, `println!`, `vec!` | none: `println(f\"{x}\")` (0.15) |\n");
    buf_bytes(out, "| default arguments (none in Rust) | `fn f(a: i64, b: i64 = 2)`, `f(1, b: 3)` (0.15) |\n");
    buf_bytes(out, "| `impl<T> Trait for Vec<T>` | the same (one impl per trait and type) |\n");
    buf_bytes(out, "| `dyn Trait`, `impl Trait` in argument position | generics: `fn f<T: Trait>(x: T)` |\n");
    buf_bytes(out, "| `#[test]`, proptest, cargo-fuzz | `#[test]`, `#[property]`, `#[fuzz]`, run by `tachyonc test` and `tachyonc fuzz` (0.18; guide testing) |\n");
    buf_bytes(out, "| `assert!`, `debug_assert!`, contracts crates | `assert(c)`, `assert_eq(a, b)`; `requires`/`ensures` clauses (0.18; guide contracts) |\n");
    buf_bytes(out, "| `use a::b::*;` | `use a::b::{c, d};` |\n");
    buf_bytes(out, "| `x as T` | the same; `bool as i64` works, an integer to an enum is checked |\n");
    buf_bytes(out, "| `if let ... else if let ...`, `while let` | the same |\n");
    buf_bytes(out, "| `match` guards, `a \\| b`, `1..=9` | the same; no `x @ pat`, no slice patterns, no string patterns |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Modules and crates\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| Rust | tachyon |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `mod m;` | the same: `m.tach` or `m/mod.tach` next to the file |\n");
    buf_bytes(out, "| `use crate::a::b;`, `super::`, `self::` | the same |\n");
    buf_bytes(out, "| `extern crate`, Cargo dependencies | none: one program from its files; C through headers |\n");
    buf_bytes(out, "| `pub use` | the same |\n");
    buf_bytes(out, "| `std::collections::HashMap` | `std::HashMap` |\n");
    buf_bytes(out, "| `std::io::stdin().read_line(&mut s)` | `std::read_line(&buf)`: the line without its `'\\n'`; `Ok(false)` at the end of input |\n");
    buf_bytes(out, "| `io::read_to_string(io::stdin())` | `std::read_stdin_in(gpa)`, a `Result<Buf, IoError>`; `std::Scanner` for its tokens, numbers and lines |\n");
    buf_bytes(out, "| `std::env::args()` | `fn main(argc: i32, argv: **u8) -> i32` |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## unsafe and C\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| Rust | tachyon |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `unsafe { }`, `unsafe fn` | the same |\n");
    buf_bytes(out, "| `extern \"C\" { fn f(); }` | the same; or `import \"stdio.h\" as c;` then `c::printf` |\n");
    buf_bytes(out, "| `#[repr(C)]`, `#[repr(u8)]` | the same; also `packed`, `align(N)` |\n");
    buf_bytes(out, "| `extern \"C\" fn cb()` | the same; a plain `fn` is not a C callback |\n");
    buf_bytes(out, "| `std::ptr::null()` | `0 as *T` |\n");
    buf_bytes(out, "| `p.add(i)`, `p.offset(i)` | `p[i]`, `&p[i]` (unsafe); no pointer arithmetic |\n");
    buf_bytes(out, "| `std::mem::size_of::<T>()` | `size_of(T)`, `align_of(T)` |\n");
    buf_bytes(out, "| `libc::malloc` | `extern \"C\" { fn malloc(n: u64) -> *u8; }` or `import \"stdlib.h\" as c;` |\n");
}
