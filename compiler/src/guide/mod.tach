// `tachyonc guide` (0.13): the language, taught by the compiler that
// implements it, for a reader who has never seen tachyon. The text is
// compiler/guide/*.md, built into the compiler by compiler/guide/embed.sh
// (text/, as std's source is into front/stdsrc.tach), so it matches the
// compiler it comes with; std's API is made from std's embedded source
// when it is printed (stdapi.tach). tests/guide/run.sh compiles and runs
// every example in it.
//
//   tachyonc guide              the core guide (the default topic)
//   tachyonc guide TOPIC...     the topics, in turn
//   tachyonc guide --list       NAME TAB SIZE TAB SUMMARY per topic, SIZE
//                               as `N tokens` (bytes / 4)
//   tachyonc guide --all        every topic, in order

pub mod text;
mod stdapi;

use crate::base::{STDERR, STDOUT, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd};
use crate::guide::stdapi::std_api;
use crate::guide::text::{TOPIC_COUNT, topic_name, topic_summary, topic_text};

// The topic named `name`, or -1.
fn topic_of(name: [u8]) -> i64 {
    for i in 0..TOPIC_COUNT {
        if topic_name(i) == name {
            return i;
        }
    }
    -1
}

// Writes topic i to buffer out, with its placeholder lines filled in:
// `@STD-API@` (std's API) and `@TOPICS@` (the other topics).
fn render(i: i64, out: i64) {
    let raw = buf_new();
    topic_text(i, raw);
    let text = buf_slice(raw);
    let mut start = 0;
    while start < text.len {
        let mut end = start;
        while end < text.len && text[end] != '\n' {
            end += 1;
        }
        let line = text[start..end];
        if line == "@STD-API@" {
            std_api(out);
        } else if line == "@TOPICS@" {
            topic_lines(out);
        } else {
            buf_bytes(out, line);
            buf_bytes(out, "\n");
        }
        start = end + 1;
    }
}

// The topics but the core, one line each, for the core guide's end.
fn topic_lines(out: i64) {
    for i in 1..TOPIC_COUNT {
        buf_bytes(out, "- `");
        buf_bytes(out, topic_name(i));
        buf_bytes(out, "`: ");
        buf_bytes(out, topic_summary(i));
        buf_bytes(out, "\n");
    }
}

// --list: each topic with its size, in tokens at 4 bytes a token.
fn list(out: i64) {
    for i in 0..TOPIC_COUNT {
        let b = buf_new();
        render(i, b);
        buf_bytes(out, topic_name(i));
        buf_bytes(out, "\t");
        buf_int(out, (buf_slice(b).len + 2) / 4);
        buf_bytes(out, " tokens\t");
        buf_bytes(out, topic_summary(i));
        buf_bytes(out, "\n");
    }
}

fn usage(out: i64) {
    buf_bytes(out, "usage: tachyonc guide [TOPIC...] [--list] [--all]\n");
    buf_bytes(out, "  (no TOPIC)   the core guide: the language, Rust habits, errors, tools\n");
    buf_bytes(out, "  TOPIC...     the topics, in turn\n");
    buf_bytes(out, "  --list       the topics, with their sizes\n");
    buf_bytes(out, "  --all        every topic\n");
}

// `tachyonc guide ...`; the exit status: 0, 1 (a topic that does not
// exist; the others are printed) or 2 (a usage error).
pub fn run_guide(argc: i64, argv: **u8) -> i64 {
    unsafe {
        let out = buf_new();
        let err = buf_new();
        let prog = argv[0];
        let mut status = 0;
        let mut any = false;
        for k in 2..argc {
            let arg = argv[k];
            let mut n = 0;
            while arg[n] != 0 {
                n += 1;
            }
            let name = arg[0..n];
            any = true;
            if name == "--list" {
                list(out);
            } else if name == "--all" {
                for i in 0..TOPIC_COUNT {
                    render(i, out);
                }
            } else if name == "--help" || name == "-h" {
                usage(out);
            } else if n > 0 && name[0] == '-' {
                buf_bytes(err, "error guide.usage: unknown option '");
                buf_bytes(err, name);
                buf_bytes(err, "'\ntry: ");
                buf_str(err, prog);
                buf_bytes(err, " guide --help\n");
                buf_write_fd(out, STDOUT);
                buf_write_fd(err, STDERR);
                return 2;
            } else {
                let i = topic_of(name);
                if i < 0 {
                    buf_bytes(err, "error guide.no-topic: no topic '");
                    buf_bytes(err, name);
                    buf_bytes(err, "'\ntry: ");
                    buf_str(err, prog);
                    buf_bytes(err, " guide --list\n");
                    status = 1;
                } else {
                    render(i, out);
                }
            }
        }
        if !any {
            render(0, out);
        }
        buf_write_fd(out, STDOUT);
        buf_write_fd(err, STDERR);
        status
    }
}
