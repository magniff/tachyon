// The AST: every node (item, type, pattern, statement, expression) is an
// entry in NODES, referred to by index; 0 is "no node". Child lists live in
// LISTS (`list` is the first index, `count` the length).
//
// Field use by kind (operators are their token kinds, labels are symbols
// with 0 for "no label"):
//
//   items       I_FN       a=name b=return type c=body list=params
//               I_EXTERN   a=name b=return type d=variadic list=params
//               I_STRUCT   a=name list=fields
//               I_CONST    a=name b=type c=value
//               I_STATIC   a=name b=type c=value d=mutable
//               I_TYPE     a=name b=type
//               PARAM      a=name b=type c=mutable
//               FIELD      a=name b=type
//   types       T_NAME a=name, T_PTR a=pointee, T_UNIT, T_NEVER,
//               T_TUPLE list, T_ARRAY a=elem b=length expr,
//               T_FN list=params a=result
//   patterns    P_WILD, P_BIND a=name b=mutable, P_TUPLE list
//   statements  S_LET a=pattern b=type c=init, S_EXPR a=expr b=has_semi
//   expressions E_INT a=value b=suffix, E_FLOAT a=bits b=suffix,
//               E_CHAR a=value, E_STR/E_CSTR a=string id, E_BOOL a,
//               E_UNIT, E_IDENT a=name,
//               E_BINARY a=op b=lhs c=rhs, E_UNARY a=op b=operand,
//               E_CAST a=expr b=type, E_CALL a=callee list=args,
//               E_INDEX a=base b=index, E_FIELD a=base b=name,
//               E_TUPLE_FIELD a=base b=index, E_TUPLE list, E_ARRAY list,
//               E_REPEAT a=value b=count, E_STRUCT a=name list=inits,
//               FIELD_INIT a=name b=value,
//               E_BLOCK list=stmts a=tail, E_IF a=cond b=then c=else,
//               E_LOOP a=label b=body, E_WHILE a=label b=cond c=body,
//               E_FOR a=label b=pattern c=range d=body,
//               E_RANGE a=start b=end c=inclusive,
//               E_ASSIGN a=op b=target c=value, E_RETURN a=value,
//               E_BREAK a=label b=value, E_CONTINUE a=label
//
// The checker fills `ty` (the node's type) and `x`, `y` (resolutions, see
// 31_check.tach); the code generator uses `z`.

const I_FN: i64 = 1;
const I_EXTERN: i64 = 2;
const I_STRUCT: i64 = 3;
const I_CONST: i64 = 4;
const I_STATIC: i64 = 5;
const I_TYPE: i64 = 6;
const PARAM: i64 = 7;
const FIELD: i64 = 8;
const T_NAME: i64 = 10;
const T_PTR: i64 = 11;
const T_UNIT: i64 = 12;
const T_NEVER: i64 = 13;
const T_TUPLE: i64 = 14;
const T_ARRAY: i64 = 15;
const T_FN: i64 = 16;
const P_WILD: i64 = 20;
const P_BIND: i64 = 21;
const P_TUPLE: i64 = 22;
const S_LET: i64 = 25;
const S_EXPR: i64 = 26;
const E_INT: i64 = 30;
const E_FLOAT: i64 = 31;
const E_CHAR: i64 = 32;
const E_STR: i64 = 33;
const E_CSTR: i64 = 34;
const E_BOOL: i64 = 35;
const E_UNIT: i64 = 36;
const E_IDENT: i64 = 37;
const E_BINARY: i64 = 38;
const E_UNARY: i64 = 39;
const E_CAST: i64 = 40;
const E_CALL: i64 = 41;
const E_INDEX: i64 = 42;
const E_FIELD: i64 = 43;
const E_TUPLE_FIELD: i64 = 44;
const E_TUPLE: i64 = 45;
const E_ARRAY: i64 = 46;
const E_REPEAT: i64 = 47;
const E_STRUCT: i64 = 48;
const FIELD_INIT: i64 = 49;
const E_BLOCK: i64 = 50;
const E_IF: i64 = 51;
const E_LOOP: i64 = 52;
const E_WHILE: i64 = 53;
const E_FOR: i64 = 54;
const E_RANGE: i64 = 55;
const E_ASSIGN: i64 = 56;
const E_RETURN: i64 = 57;
const E_BREAK: i64 = 58;
const E_CONTINUE: i64 = 59;

struct Node {
    kind: i64, start: i64, end: i64,
    a: i64, b: i64, c: i64, d: i64,
    list: i64, count: i64,
    ty: i64, x: i64, y: i64, z: i64,
}

static mut NODES: *Node = 0 as *Node;
static mut NODE_COUNT: i64 = 0;
static mut NODE_CAP: i64 = 0;
static mut LISTS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Children of lists being built; see list_begin/list_end.
static mut SCRATCH: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn new_node(kind: i64, start: i64, end: i64) -> i64 {
    NODES = grow(NODES as *u8, NODE_COUNT, &NODE_CAP, 104) as *Node;
    let n = NODE_COUNT;
    NODES[n] = Node {
        kind: kind, start: start, end: end, a: 0, b: 0, c: 0, d: 0,
        list: 0, count: 0, ty: 0, x: 0, y: 0, z: 0,
    };
    NODE_COUNT += 1;
    n
}

fn init_ast() {
    // Node 0 stands for "no node".
    new_node(0, 0, 0);
}

// Lists are built on SCRATCH: remember `list_begin()`, push the children
// with `list_push`, and move them to node `n` with `list_end(n, mark)`.
fn list_begin() -> i64 {
    SCRATCH.count
}

fn list_push(child: i64) {
    intvec_push(&SCRATCH, child);
}

fn list_end(n: i64, mark: i64) {
    NODES[n].list = LISTS.count;
    NODES[n].count = SCRATCH.count - mark;
    for i in mark..SCRATCH.count {
        intvec_push(&LISTS, SCRATCH.data[i]);
    }
    SCRATCH.count = mark;
}

// Child `i` of node `n`'s list.
fn child(n: i64, i: i64) -> i64 {
    LISTS.data[NODES[n].list + i]
}
