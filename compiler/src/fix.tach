// `tachyonc fix [ROOT] [--only imports|unused|pub|unsafe] [--in FILE|MODULE]
// [--dry-run]`
// (0.11; docs/refactor.md): every fix the compiler can make by itself, in
// one atomic edit (edit.tach), one summary line:
//
//   imports  the `use` lines the errors for unknown names ask for (`add
//            `use crate::m::name;``), merged into a `use` of that module
//            when there is one; and 0.8's wildcard migration (`use
//            a::*;` becomes the names it brings: fiximports.tach)
//   unused   imports nothing in their file names, removed
//   pub      `pub` on the items other modules use while they are private
//   unsafe   unsafe operations outside unsafe code, wrapped in unsafe
//            blocks (fixunsafe.tach)
//
// `tachyonc --fix-imports ROOT` and `--fix-unsafe ROOT` (0.8, 0.9) are
// `fix --only imports` and `fix --only unsafe`, silent when there is
// nothing to do.

use crate::base::{
    BUFS, FILES, IntVec, OVERLAY, SRC, STDOUT, SYMS, buf_byte, buf_bytes, buf_int, buf_new, buf_slice,
    buf_str, buf_write_fd, intern,
};
use crate::lexer::{TOKS, TOK_COUNT, Tok};
use crate::ast::{NODES, NODE_COUNT, NodeKind, child};
use crate::parser::ITEM_PUBLIC;
use crate::modules::{
    B_PRIVATE, C_MODULE, LEGACY_IMPORTS, MODULES, STD_MODULE, binding_kind, binding_value, file_of_pos,
    module_count, module_of,
};
use crate::types::item_node_of;
use crate::query::{
    DEFS, DEF_COUNT, IN_FILE, IN_MODULE, MOD_DEF, OPT_IN, PROG, ROOT_GIVEN, TOOL, c_slice, diag, line_end,
    line_start, load_program, program_errors, ref_in, resolve_in, root_or_diag, sym_less, text_start,
    try_begin, try_end, write_diags, put_bad_in,
};
use crate::edit::{
    TARGET, TARGET_NAME, after_line, copy_rewritten, delete_lines, edit_count, edit_replace,
    finish_edit, indent_of, node_head, overlay_args, prepare_edit, set_command, take_edit_option,
    write_round,
};
use crate::fiximports::{FIX_IMPORTS, fix_imports_edits};
use crate::fixunsafe::{FIX_UNSAFE, fix_unsafe_edits};
use crate::streq;

const F_IMPORTS: i64 = 1;
const F_UNUSED: i64 = 2;
const F_PUB: i64 = 4;
const F_UNSAFE: i64 = 8;
const F_ALL: i64 = 15;

// What the checker found to fix: the imports an unknown name asks for
// (module, path, name: symbols), and the private items used elsewhere
// (their bindings).
static mut MISSING: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut PRIVATE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The unknown `name` in module m is item `name` of the module with path
// `path` (its help says `add `use PATH::name;``).
pub fn note_missing_use(m: i64, path: i64, name: i64) {
    let mut i = 0;
    while i < MISSING.count {
        if unsafe { MISSING.data[i] == m && MISSING.data[i + 1] == path && MISSING.data[i + 2] == name } {
            return;
        }
        i += 3;
    }
    MISSING.push(m);
    MISSING.push(path);
    MISSING.push(name);
}

// Binding b (B_PRIVATE) was used where it is private.
pub fn note_private(b: i64) {
    if binding_kind(b) != B_PRIVATE {
        return;
    }
    for i in 0..PRIVATE.count {
        if unsafe { PRIVATE.data[i] == b } {
            return;
        }
    }
    PRIVATE.push(b);
}

// Whether module m passes --in (its file or itself).
fn module_in(m: i64) -> bool {
    unsafe {
        if OPT_IN == 0 as *u8 {
            return true;
        }
        if IN_MODULE.data[m] != 0 {
            return true;
        }
        for f in 0..crate::base::FILE_COUNT {
            if FILES[f].module == m && IN_FILE.data[f] != 0 {
                return true;
            }
        }
        false
    }
}

// Whether module m's code is in a file of the program (not std's, the C
// headers').
fn user_module(m: i64) -> bool {
    m >= 0 && m != STD_MODULE && m != C_MODULE
}

fn user_pos(pos: i64) -> bool {
    unsafe { FILES[file_of_pos(pos)].path[0] != '<' }
}

// ---- Missing imports ----

// The path of Use node u (its segments before the imported names), as a
// symbol: `crate::a::b`.
fn use_path(u: i64) -> i64 {
    unsafe {
        let path = NODES[u].c;
        let out = buf_new();
        for i in 0..NODES[path].count {
            if i > 0 {
                buf_str(out, c"::");
            }
            buf_bytes(out, SYMS[NODES[child(path, i)].a].text);
        }
        intern(buf_slice(out))
    }
}

// Whether Use node u, in module m, imports from the module of path p
// (`crate::a`; written `a` in the root module).
fn same_path(u: i64, m: i64, p: i64) -> bool {
    unsafe {
        let up = use_path(u);
        if up == p {
            return true;
        }
        let t = SYMS[p].text;
        let w = SYMS[up].text;
        m == 0 && t.len == w.len + 7 && crate::proc::same_bytes(t[7..t.len], w) && t[0] == 'c' && t[5] == ':'
    }
}

// The Use items (not header imports, not `*`) of module m, by position.
fn module_uses(m: i64, out: *IntVec) {
    unsafe {
        for n in 1..NODE_COUNT {
            if NODES[n].kind == NodeKind::Use && NODES[n].d != 2 && module_of(n) == m && user_pos(NODES[n].start) {
                out.push(n);
            }
        }
    }
}

// The edits adding the missing imports; their number.
fn missing_use_edits() -> i64 {
    unsafe {
        let mut fixes = 0;
        let mut done = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut i = 0;
        while i < MISSING.count {
            let m = MISSING.data[i];
            let p = MISSING.data[i + 1];
            i += 3;
            if !user_module(m) || !module_in(m) {
                continue;
            }
            // (once per module and path, with all its names)
            let mut seen = false;
            let mut k = 0;
            while k < done.count {
                if done.data[k] == m && done.data[k + 1] == p {
                    seen = true;
                }
                k += 2;
            }
            if seen {
                continue;
            }
            done.push(m);
            done.push(p);
            let mut names = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            let mut j = 0;
            while j < MISSING.count {
                if MISSING.data[j] == m && MISSING.data[j + 1] == p {
                    names.push(MISSING.data[j + 2]);
                }
                j += 3;
            }
            sort_syms(&names);
            if add_import(m, p, &names) {
                fixes += names.count;
            }
        }
        fixes
    }
}

fn sort_syms(v: *IntVec) {
    unsafe {
        for k in 1..(*v).count {
            let mut j = k;
            while j > 0 && sym_less((*v).data[j], (*v).data[j - 1]) {
                let t = (*v).data[j];
                (*v).data[j] = (*v).data[j - 1];
                (*v).data[j - 1] = t;
                j -= 1;
            }
        }
    }
}

// The edit importing `names` from the module of path p into module m:
// into a `use` of that module, else a `use` line after m's last one (or
// before its first item).
fn add_import(m: i64, p: i64, names: *IntVec) -> bool {
    unsafe {
        let mut uses = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        module_uses(m, &uses);
        for k in 0..uses.count {
            let u = uses.data[k];
            if NODES[u].b == 1 || !same_path(u, m, p) || NODES[u].count == 0 {
                continue;
            }
            let last = child(u, NODES[u].count - 1);
            let braces = brace_after(NODES[NODES[u].c].end, NODES[u].end);
            let text = buf_new();
            if braces {
                // `use p::{a, b};` -> `use p::{a, b, NAME};`
                for x in 0..(*names).count {
                    buf_str(text, c", ");
                    buf_bytes(text, SYMS[(*names).data[x]].text);
                }
                return edit_replace(NODES[last].end, NODES[last].end, text);
            }
            // `use p::a;` (or `use p::a as b;`) -> `use p::{a, NAME};`
            let mut semi = NODES[u].end;
            while semi > NODES[last].start && SRC[semi - 1] != ';' {
                semi -= 1;
            }
            buf_byte(text, '{');
            buf_bytes(text, SRC[NODES[last].start..semi - 1]);
            for x in 0..(*names).count {
                buf_str(text, c", ");
                buf_bytes(text, SYMS[(*names).data[x]].text);
            }
            buf_byte(text, '}');
            return edit_replace(NODES[last].start, semi - 1, text);
        }
        // A new line.
        let line = buf_new();
        buf_str(line, c"use ");
        buf_bytes(line, SYMS[p].text);
        buf_str(line, c"::");
        if (*names).count > 1 {
            buf_byte(line, '{');
        }
        for x in 0..(*names).count {
            if x > 0 {
                buf_str(line, c", ");
            }
            buf_bytes(line, SYMS[(*names).data[x]].text);
        }
        if (*names).count > 1 {
            buf_byte(line, '}');
        }
        buf_byte(line, ';');
        if uses.count > 0 {
            let u = uses.data[uses.count - 1];
            let at = line_end(NODES[u].end - 1);
            let text = buf_new();
            buf_byte(text, '\n');
            buf_bytes(text, indent_of(NODES[u].start));
            buf_bytes(text, buf_slice(line));
            return edit_replace(at, at, text);
        }
        // Before the module's first item (and its comments).
        let mut first = -1;
        for d in 0..DEF_COUNT {
            if DEFS[d].module == m && DEFS[d].parent < 0 && user_pos(DEFS[d].start)
                && (first < 0 || DEFS[d].start < DEFS[first].start) {
                first = d;
            }
        }
        if first < 0 {
            return false;
        }
        let at = line_start(text_start(first));
        let text = buf_new();
        buf_bytes(text, indent_of(DEFS[first].start));
        buf_bytes(text, buf_slice(line));
        buf_str(text, c"\n\n");
        edit_replace(at, at, text)
    }
}

// Whether a `{` is in SRC[from..to).
fn brace_after(from: i64, to: i64) -> bool {
    unsafe {
        for p in from..to {
            if SRC[p] == '{' {
                return true;
            }
        }
        false
    }
}

// ---- Unused imports ----

// Whether identifier `name` is written in file f outside SRC[a..b).
fn named_in_file(name: i64, f: i64, a: i64, b: i64) -> bool {
    unsafe {
        let lo = crate::query::token_at(FILES[f].start);
        let mut i = lo;
        while i < TOK_COUNT && TOKS[i].start < FILES[f].end {
            if TOKS[i].kind == Tok::Ident && TOKS[i].value as i64 == name && (TOKS[i].start < a || TOKS[i].start >= b) {
                return true;
            }
            i += 1;
        }
        false
    }
}

// The edits removing the imports nothing in their file names (a name
// written anywhere in the file keeps its import: a local of that name
// too); their number. `pub use` items are kept (other modules may use
// what they bring).
fn unused_import_edits(only_report: *IntVec) -> i64 {
    unsafe {
        let mut fixes = 0;
        for u in 1..NODE_COUNT {
            if NODES[u].kind != NodeKind::Use || NODES[u].d == 2 || NODES[u].b == 1 || (NODES[u].p & ITEM_PUBLIC) != 0 {
                continue;
            }
            if !user_pos(NODES[u].start) || !user_module(module_of(u)) || !ref_in(NODES[u].start) {
                continue;
            }
            let f = file_of_pos(NODES[u].start);
            let n = NODES[u].count;
            let mut unused = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for k in 0..n {
                let id = child(u, k);
                let local = if NODES[id].b != 0 { NODES[id].b } else { NODES[id].a };
                if !named_in_file(local, f, NODES[u].start, NODES[u].end) {
                    unused.push(k);
                }
            }
            if unused.count == 0 {
                continue;
            }
            if only_report != 0 as *IntVec {
                for k in 0..unused.count {
                    only_report.push(child(u, unused.data[k]));
                }
                continue;
            }
            if unused.count == n {
                let head = node_head(NODES[u].start);
                if blank_before(head) && blank_after(NODES[u].end) {
                    delete_lines(line_start(head), NODES[u].end);
                } else {
                    edit_replace(head, NODES[u].end, buf_new());
                }
                fixes += n;
                continue;
            }
            if n - unused.count == 1 && one_line_braces(u) {
                // (one name left: `use p::{a};` is `use p::a;`)
                let mut kept = 0;
                for k in 0..n {
                    let mut gone = false;
                    for x in 0..unused.count {
                        if unused.data[x] == k {
                            gone = true;
                        }
                    }
                    if !gone {
                        kept = child(u, k);
                    }
                }
                let mut open = NODES[NODES[u].c].end;
                while SRC[open] != '{' {
                    open += 1;
                }
                let mut close = NODES[u].end;
                while SRC[close] != '}' {
                    close -= 1;
                }
                let text = buf_new();
                buf_bytes(text, SRC[NODES[kept].start..NODES[kept].end]);
                if edit_replace(open, close + 1, text) {
                    fixes += unused.count;
                }
                continue;
            }
            for k in 0..unused.count {
                if remove_use_name(u, unused.data[k]) {
                    fixes += 1;
                }
            }
        }
        fixes
    }
}

// Whether Use node u lists its names between braces, on one line.
fn one_line_braces(u: i64) -> bool {
    unsafe { brace_after(NODES[NODES[u].c].end, NODES[u].end) && same_line(NODES[u].start, NODES[u].end) }
}

// Whether only blanks are before pos on its line.
fn blank_before(pos: i64) -> bool {
    unsafe {
        let mut p = line_start(pos);
        while p < pos && (SRC[p] == ' ' || SRC[p] == '\t') {
            p += 1;
        }
        p == pos
    }
}

// Whether only blanks (or a comment) are after pos on its line.
fn blank_after(pos: i64) -> bool {
    unsafe {
        let e = line_end(pos);
        let mut p = pos;
        while p < e && (SRC[p] == ' ' || SRC[p] == '\t' || SRC[p] == '\r') {
            p += 1;
        }
        p == e || (p + 1 < e && SRC[p] == '/' && SRC[p + 1] == '/')
    }
}

// The edit removing name k of Use node u (one of several between braces),
// with its separator: `a, b, c` loses `b, ` (its line, when it is alone
// on it), the last loses `, c`.
pub fn remove_use_name(u: i64, k: i64) -> bool {
    unsafe {
        let id = child(u, k);
        let a = NODES[id].start;
        let b = NODES[id].end;
        let n = NODES[u].count;
        if k + 1 < n {
            let next = NODES[child(u, k + 1)].start;
            if blank_before(a) && !same_line(b, next) {
                // alone on its line: the line
                return edit_replace(line_start(a), after_line(b), buf_new());
            }
            if same_line(b, next) {
                return edit_replace(a, next, buf_new());
            }
            // last on its line: `, NAME` (from the end of the one before)
            if k > 0 && same_line(NODES[child(u, k - 1)].end, a) {
                return edit_replace(NODES[child(u, k - 1)].end, b, buf_new());
            }
            return edit_replace(a, next, buf_new());
        }
        // The last name: from the end of the one before.
        let prev = NODES[child(u, k - 1)].end;
        if blank_before(a) && !same_line(prev, a) {
            let mut e = b;
            if SRC[e] == ',' {
                e += 1;
            }
            if blank_after(e) {
                return edit_replace(line_start(a), after_line(b), buf_new());
            }
        }
        edit_replace(prev, b, buf_new())
    }
}

fn same_line(a: i64, b: i64) -> bool {
    line_start(a) == line_start(b)
}

// ---- pub ----

// The edits making the private items used elsewhere public; their number.
fn pub_edits() -> i64 {
    unsafe {
        let mut fixes = 0;
        for i in 0..PRIVATE.count {
            let key = binding_value(PRIVATE.data[i]);
            let mut node = item_node_of(key);
            if node == 0 {
                // a module: its `mod` item
                for m in 1..module_count() {
                    if MODULES[m].key == key && MOD_DEF.data[m] >= 0 {
                        node = DEFS[MOD_DEF.data[m]].node;
                    }
                }
            }
            if node == 0 || (NODES[node].p & ITEM_PUBLIC) != 0 || !user_pos(NODES[node].start) || !ref_in(NODES[node].start) {
                continue;
            }
            let text = buf_new();
            buf_str(text, c"pub ");
            if edit_replace(NODES[node].start, NODES[node].start, text) {
                fixes += 1;
            }
        }
        fixes
    }
}

// ---- The command ----

// `N noun` (plural when N is not 1), after a comma when the summary has
// something already.
fn put_count(out: i64, n: i64, one: *u8, many: *u8) {
    unsafe {
        if n == 0 {
            return;
        }
        if BUFS[out].len > 6 {
            buf_str(out, c",");
        }
        buf_byte(out, ' ');
        buf_int(out, n);
        buf_byte(out, ' ');
        buf_str(out, if n == 1 { one } else { many });
    }
}

pub fn run_fix(argc: i64, argv: **u8) -> i64 {
    let status = run_fix_inner(argc, argv, 0);
    write_diags();
    status
}

// `tachyonc --fix-imports ROOT`, `--fix-unsafe ROOT` (`only`: F_IMPORTS,
// F_UNSAFE): fix, quiet when there is nothing to do.
pub fn run_fix_alias(argc: i64, argv: **u8, only: i64) -> i64 {
    let status = run_fix_inner(argc, argv, only);
    write_diags();
    status
}

fn run_fix_inner(argc: i64, argv: **u8, alias: i64) -> i64 {
    unsafe {
        set_command(argc, argv);
        PROG = argv[0];
        TOOL = 0 as *u8;
        let mut only = if alias != 0 { alias } else { F_ALL };
        let mut only_arg = if alias == F_IMPORTS { c"imports" } else if alias == F_UNSAFE { c"unsafe" } else { 0 as *u8 };
        let mut round = false;
        let mut root = 0 as *u8;
        let mut i = if alias != 0 { 1 } else { 2 };
        while i < argc {
            let a = argv[i];
            if alias != 0 && (streq(a, c"--fix-imports") || streq(a, c"--fix-unsafe")) {
                i += 1;
                continue;
            }
            if streq(a, c"--round") {
                round = true;
                i += 1;
                continue;
            }
            if streq(a, c"--in") && i + 1 < argc {
                OPT_IN = argv[i + 1];
                i += 2;
                continue;
            }
            if streq(a, c"--overlay") && i + 2 < argc {
                OVERLAY.push(argv[i + 1] as i64);
                OVERLAY.push(argv[i + 2] as i64);
                i += 3;
                continue;
            }
            if streq(a, c"--only") && i + 1 < argc {
                only = 0;
                let v = argv[i + 1];
                only_arg = v;
                let mut k = 0;
                // (a comma-separated list)
                while v[k] != 0 {
                    let mut e = k;
                    while v[e] != 0 && v[e] != ',' {
                        e += 1;
                    }
                    let w = v[k..e];
                    let bit = if word_is(w, c"imports") { F_IMPORTS } else if word_is(w, c"unused") { F_UNUSED }
                        else if word_is(w, c"pub") { F_PUB } else if word_is(w, c"unsafe") { F_UNSAFE } else { 0 };
                    if bit == 0 {
                        let d = diag(c"error", c"fix.usage");
                        buf_str(d, c"--only takes imports, unused, pub or unsafe, not '");
                        buf_bytes(d, w);
                        buf_str(d, c"'\n");
                        return 2;
                    }
                    only |= bit;
                    k = if v[e] == ',' { e + 1 } else { e };
                }
                i += 2;
                continue;
            }
            if take_edit_option(argc, argv, &i, &root) {
                i += 1;
                continue;
            }
            if a[0] == '-' {
                let d = diag(c"error", c"fix.usage");
                buf_str(d, c"unknown option '");
                buf_str(d, a);
                buf_str(d, c"'\n");
                let out = try_begin(c"fix", c_slice(c""), false);
                try_end(out);
                return 2;
            }
            if root != 0 as *u8 {
                let d = diag(c"error", c"fix.usage");
                buf_str(d, c"one ROOT (the program's root file), not '");
                buf_str(d, a);
                buf_str(d, c"'\n");
                return 2;
            }
            root = a;
            i += 1;
        }
        ROOT_GIVEN = root;
        root = root_or_diag(root, c"fix", c_slice(c""), false);
        if root == 0 as *u8 {
            return 2;
        }
        FIX_IMPORTS = (only & F_IMPORTS) != 0;
        FIX_UNSAFE = (only & F_UNSAFE) != 0;
        if !load_program(root, TARGET) {
            program_errors(c"error", root, true);
            return 1;
        }
        if OPT_IN != 0 as *u8 && !resolve_in(c_slice(OPT_IN)) {
            let d = diag(c"error", c"fix.bad-in");
            put_bad_in(d, OPT_IN);
            return 1;
        }
        // The fixes (an edit overlapping one made before is left for the
        // next run).
        let wild = if (only & F_IMPORTS) != 0 && LEGACY_IMPORTS { fix_imports_edits() } else { 0 };
        let imports = if (only & F_IMPORTS) != 0 { missing_use_edits() } else { 0 };
        let unused = if (only & F_UNUSED) != 0 { unused_import_edits(0 as *IntVec) } else { 0 };
        let public = if (only & F_PUB) != 0 { pub_edits() } else { 0 };
        let wrapped = if (only & F_UNSAFE) != 0 { fix_unsafe_edits() } else { 0 };
        let mut counts = [imports, wild, unused, public, wrapped];
        if round {
            // (a later round, on the edited program: what it fixed, the
            // copies it rewrote)
            if edit_count() == 0 {
                return 0;
            }
            let out = buf_new();
            buf_str(out, c"count");
            for k in 0..5 {
                buf_byte(out, '\t');
                buf_int(out, counts[k]);
            }
            buf_byte(out, '\n');
            buf_write_fd(out, STDOUT);
            return write_round();
        }
        if edit_count() == 0 {
            if alias == 0 {
                let d = diag(c"note", c"fix.none");
                buf_str(d, c"nothing to fix\n");
            }
            return 0;
        }
        let status = prepare_edit();
        if status >= 0 {
            return status;
        }
        // More rounds, on the edited program: a fix may let the checker
        // see more (the next unknown name of a statement).
        for _ in 0..4 {
            if !more_round(root, only_arg, &counts) {
                break;
            }
        }
        let what = buf_new();
        buf_str(what, c"fixed");
        put_count(what, counts[0], c"missing import", c"missing imports");
        put_count(what, counts[1], c"wildcard import", c"wildcard imports");
        put_count(what, counts[2], c"unused import", c"unused imports");
        put_count(what, counts[3], c"pub", c"pubs");
        put_count(what, counts[4], c"unsafe block", c"unsafe blocks");
        finish_edit(buf_slice(what), root)
    }
}

// A round of fix on the edited program (`PROG fix --round ... --overlay
// FILE COPY... ROOT`): adds what it fixed to counts. Whether it fixed
// anything.
fn more_round(root: *u8, only_arg: *u8, counts: *[i64; 5]) -> bool {
    unsafe {
        let mut args = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        args.push(PROG as i64);
        args.push(c"fix" as i64);
        args.push(c"--round" as i64);
        if only_arg != 0 as *u8 {
            args.push(c"--only" as i64);
            args.push(only_arg as i64);
        }
        if OPT_IN != 0 as *u8 {
            args.push(c"--in" as i64);
            args.push(OPT_IN as i64);
        }
        if TARGET_NAME != 0 as *u8 {
            args.push(c"--target" as i64);
            args.push(TARGET_NAME as i64);
        }
        overlay_args(&args);
        args.push(root as i64);
        args.push(0);
        let out = buf_new();
        if crate::proc::run_capture(args.data as **u8, out) != 0 {
            return false;
        }
        let t = buf_slice(out);
        let mut any = false;
        let mut i = 0;
        while i < t.len {
            let mut e = i;
            while e < t.len && t[e] != '\n' {
                e += 1;
            }
            let line = t[i..e];
            if line.len > 5 && line[0] == 'f' && line[4] == '\t' {
                if copy_rewritten(line[5..line.len]) {
                    any = true;
                }
            } else if line.len > 6 && line[0] == 'c' && line[5] == '\t' {
                let mut k = 0;
                let mut p = 6;
                while p < line.len && k < 5 {
                    let mut n = 0;
                    while p < line.len && line[p] >= '0' && line[p] <= '9' {
                        n = n * 10 + (line[p] - '0') as i64;
                        p += 1;
                    }
                    (*counts)[k] += n;
                    k += 1;
                    p += 1;
                }
            }
            i = e + 1;
        }
        any
    }
}

fn word_is(w: [u8], s: *u8) -> bool {
    unsafe { crate::proc::same_bytes(w, c_slice(s)) }
}

// The imports nothing names (query unused): their Ident nodes, into out.
pub fn unused_imports(out: *IntVec) {
    unused_import_edits(out);
}
