// x86-64 with the System V ABI, as AT&T-syntax text for the GNU assembler
// (Linux, ELF) or clang's assembler (macOS, Mach-O): the x64_* half of the
// target interface in target.tach. AT&T syntax because registers carry
// a `%`, so no symbol can be mistaken for a register or an operator.
//
// Registers: R_ACC is rax, R_SECOND rcx, R_RESULT rdi (the result pointer
// is the hidden first argument), R_ADDR r11, R_LOOP_PTR r8, R_LOOP_COUNT
// r9; the float accumulator is xmm0, the second float operand xmm1. r10,
// rdx, rsi and xmm8 are scratch; rbp is the frame pointer. Every 16-byte
// temporary keeps rsp 16-byte aligned, as calls require.
//
// The code is position independent: data is addressed relative to rip,
// and C functions are reached through the PLT and the GOT on ELF.

// The 64-, 32-, 16- and 8-bit names of virtual register `reg`.
use crate::base::{SYMS, buf_fmt, buf_str, buf_uint, cstr, die};
use crate::base::target::ELF;
use crate::front::consteval::{f32_bits, f64_of_bits};
use crate::front::lexer::Tok;
use crate::front::lexer::Tok::{Amp, Caret, Minus, Percent, Pipe, Plus, Shl, Shr, Slash, Star};
use crate::front::types::{
    TY_F32, TY_F64, TY_I16, TY_I32, TY_I8, TY_U16, TY_U32, TY_U64, TY_U8, int_bits, is_float,
    is_signed, type_size,
};
use crate::gen0::target::{
    ASM, CODE, R_ACC, R_ADDR, R_LOOP_COUNT, R_LOOP_PTR, R_RESULT, R_SECOND, emit_label,
    emit_symbol_ref, end_i, function_prefix, global_prefix, ins, ins_i, local_prefix, log2,
    new_label, o, oi, on, rt_panic_sym,
};
use crate::middle::ir::Cond;

fn x64_reg(reg: i64, size: i64) -> *u8 {
    if reg == R_ACC {
        if size == 8 { return c"%rax"; }
        if size == 4 { return c"%eax"; }
        if size == 2 { return c"%ax"; }
        return c"%al";
    }
    if reg == R_SECOND {
        if size == 8 { return c"%rcx"; }
        if size == 4 { return c"%ecx"; }
        if size == 2 { return c"%cx"; }
        return c"%cl";
    }
    if reg == R_RESULT {
        if size == 8 { return c"%rdi"; }
        if size == 4 { return c"%edi"; }
        if size == 2 { return c"%di"; }
        return c"%dil";
    }
    if reg == R_ADDR {
        if size == 8 { return c"%r11"; }
        if size == 4 { return c"%r11d"; }
        if size == 2 { return c"%r11w"; }
        return c"%r11b";
    }
    if reg == R_LOOP_PTR {
        if size == 8 { return c"%r8"; }
        if size == 4 { return c"%r8d"; }
        if size == 2 { return c"%r8w"; }
        return c"%r8b";
    }
    if reg == R_LOOP_COUNT {
        if size == 8 { return c"%r9"; }
        if size == 4 { return c"%r9d"; }
        if size == 2 { return c"%r9w"; }
        return c"%r9b";
    }
    unsafe { die(c"internal error: no x86-64 register for a virtual register") }
}

fn x64_r(reg: i64) -> *u8 {
    x64_reg(reg, 8)
}

// The int argument registers, in order.
fn x64_int_arg(index: i64) -> *u8 {
    if index == 0 { return c"%rdi"; }
    if index == 1 { return c"%rsi"; }
    if index == 2 { return c"%rdx"; }
    if index == 3 { return c"%rcx"; }
    if index == 4 { return c"%r8"; }
    c"%r9"
}

const X64_INT_ARG_REGS: i64 = 6;
const X64_FLOAT_ARG_REGS: i64 = 8;

// "    <mnemonic> <a>, <b>\n"
fn x64_ins2(mnemonic: *u8, a: *u8, b: *u8) {
    unsafe {
        o(c"    ");
        o(mnemonic);
        o(c" ");
        o(a);
        o(c", ");
        o(b);
        on();
    }
}

// "<offset>(<base>)"
fn x64_mem(offset: i64, base: *u8) {
    unsafe {
        if offset != 0 {
            oi(offset);
        }
        o(c"(");
        o(base);
        o(c")");
    }
}

// "    <mnemonic> <offset>(<base>), <reg>\n"
fn x64_load_from(mnemonic: *u8, offset: i64, base: *u8, reg: *u8) {
    unsafe {
        o(c"    ");
        o(mnemonic);
        o(c" ");
        x64_mem(offset, base);
        o(c", ");
        o(reg);
        on();
    }
}

// "    <mnemonic> <reg>, <offset>(<base>)\n"
fn x64_store_to(mnemonic: *u8, reg: *u8, offset: i64, base: *u8) {
    unsafe {
        o(c"    ");
        o(mnemonic);
        o(c" ");
        o(reg);
        o(c", ");
        x64_mem(offset, base);
        on();
    }
}

// "    <mnemonic> $<value>, <reg>\n"
pub fn x64_imm(mnemonic: *u8, value: i64, reg: *u8) {
    unsafe {
        o(c"    ");
        o(mnemonic);
        o(c" $");
        oi(value);
        o(c", ");
        o(reg);
        on();
    }
}

pub fn x64_jcc(cc: *u8, label: i64) {
    unsafe {
        o(c"    j");
        o(cc);
        o(c" ");
        o(local_prefix());
        oi(label);
        on();
    }
}

// A reference to a symbol from code: "<prefix><name>".
fn x64_symbol(prefix: *u8, name: i64) {
    emit_symbol_ref(prefix, name);
}

pub fn fits_i32(value: i64) -> bool {
    value >= -2147483648 && value <= 2147483647
}

// ---- Control flow ----

pub fn x64_jump(label: i64) {
    unsafe { x64_jcc(c"mp", label); }
}

pub fn x64_jump_if_zero(label: i64) {
    unsafe {
        ins(c"testq %rax, %rax");
        x64_jcc(c"e", label);
    }
}

pub fn x64_jump_if_nonzero(label: i64) {
    unsafe {
        ins(c"testq %rax, %rax");
        x64_jcc(c"ne", label);
    }
}

pub fn x64_decrement(reg: i64) {
    unsafe { x64_imm(c"subq", 1, x64_r(reg)); }
}

pub fn x64_jump_unless_zero_result(label: i64) {
    unsafe { x64_jcc(c"ne", label); }
}

// The condition code of an integer comparison.
pub fn x64_int_cc(op: Cond, signed: bool) -> *u8 {
    match op {
        Cond::Eq => c"e",
        Cond::Ne => c"ne",
        Cond::Lt => if signed { c"l" } else { c"b" },
        Cond::Le => if signed { c"le" } else { c"be" },
        Cond::Gt => if signed { c"g" } else { c"a" },
        Cond::Ge => if signed { c"ge" } else { c"ae" },
    }
}

pub fn x64_compare_jump(op: Cond, signed: bool, label: i64) {
    unsafe {
        ins(c"cmpq %rcx, %rax");
        x64_jcc(x64_int_cc(op, signed), label);
    }
}

// ---- Constants and addresses ----

pub fn x64_load_imm(reg: i64, value: u64) {
    unsafe {
        let signed = value as i64;
        if signed >= 0 && signed <= 4294967295 {
            // movl zero-extends to 64 bits.
            o(c"    movl $");
            buf_uint(CODE, value);
            o(c", ");
            o(x64_reg(reg, 4));
            on();
        } else if fits_i32(signed) {
            x64_imm(c"movq", signed, x64_r(reg));
        } else {
            x64_imm(c"movabsq", signed, x64_r(reg));
        }
    }
}

// reg &= -align.
pub fn x64_align_down(reg: i64, align: i64) {
    unsafe { x64_imm(c"andq", 0 - align, x64_r(reg)); }
}

pub fn x64_frame_addr(reg: i64, offset: i64) {
    unsafe { x64_load_from(c"leaq", -offset, c"%rbp", x64_r(reg)); }
}

pub fn x64_add_imm(reg: i64, value: i64) {
    unsafe {
        if value == 0 {
            return;
        }
        if fits_i32(value) {
            x64_imm(c"addq", value, x64_r(reg));
            return;
        }
        x64_imm(c"movabsq", value, c"%r10");
        x64_ins2(c"addq", c"%r10", x64_r(reg));
    }
}

pub fn x64_local_symbol_addr(prefix: *u8, name: i64) {
    unsafe {
        o(c"    leaq ");
        x64_symbol(prefix, name);
        o(c"(%rip), %rax\n");
    }
}

// Through the GOT.
pub fn x64_extern_symbol_addr(name: i64) {
    unsafe {
        o(c"    movq ");
        x64_symbol(global_prefix(), name);
        o(c"@GOTPCREL(%rip), %rax\n");
    }
}

pub fn x64_string_addr(id: i64) {
    unsafe {
        o(c"    leaq ");
        o(local_prefix());
        o(c"str.");
        oi(id);
        o(c"(%rip), %rax\n");
    }
}

pub fn x64_load_float(bits: i64, ty: i64) {
    unsafe {
        if ty == TY_F32 {
            o(c"    movl $");
            buf_uint(CODE, f32_bits(f64_of_bits(bits)) as u64);
            o(c", %r10d\n");
            ins(c"movd %r10d, %xmm0");
        } else {
            x64_imm(c"movabsq", bits, c"%r10");
            ins(c"movq %r10, %xmm0");
        }
    }
}

// ---- Temporaries ----

pub fn x64_push_int() {
    unsafe {
        ins(c"subq $16, %rsp");
        ins(c"movq %rax, (%rsp)");
    }
}

pub fn x64_push_float() {
    unsafe {
        ins(c"subq $16, %rsp");
        ins(c"movsd %xmm0, (%rsp)");
    }
}

pub fn x64_pop_int(reg: i64) {
    unsafe {
        x64_load_from(c"movq", 0, c"%rsp", x64_r(reg));
        ins(c"addq $16, %rsp");
    }
}

pub fn x64_pop_float(reg: i64) {
    unsafe {
        ins_i(c"movsd (%rsp), %xmm", reg, c"");
        ins(c"addq $16, %rsp");
    }
}

pub fn x64_peek(reg: i64) {
    unsafe { x64_load_from(c"movq", 0, c"%rsp", x64_r(reg)); }
}

pub fn x64_peek_at(reg: i64, depth: i64, float: bool) {
    unsafe {
        if float {
            o(c"    movsd ");
            x64_mem(depth * 16, c"%rsp");
            end_i(c", %xmm", reg, c"");
        } else {
            x64_load_from(c"movq", depth * 16, c"%rsp", x64_r(reg));
        }
    }
}

pub fn x64_drop_temps(count: i64) {
    unsafe { x64_imm(c"addq", count * 16, c"%rsp"); }
}

// ---- Loads and stores ----

pub fn x64_load(ty: i64, addr: i64) {
    unsafe {
        let size = type_size(ty);
        let base = x64_r(addr);
        if ty == TY_F32 {
            x64_load_from(c"movss", 0, base, c"%xmm0");
        } else if ty == TY_F64 {
            x64_load_from(c"movsd", 0, base, c"%xmm0");
        } else if ty == TY_I8 {
            x64_load_from(c"movsbq", 0, base, c"%rax");
        } else if size == 1 {
            x64_load_from(c"movzbl", 0, base, c"%eax");
        } else if ty == TY_I16 {
            x64_load_from(c"movswq", 0, base, c"%rax");
        } else if size == 2 {
            x64_load_from(c"movzwl", 0, base, c"%eax");
        } else if ty == TY_I32 {
            x64_load_from(c"movslq", 0, base, c"%rax");
        } else if size == 4 {
            x64_load_from(c"movl", 0, base, c"%eax");
        } else {
            x64_load_from(c"movq", 0, base, c"%rax");
        }
    }
}

pub fn x64_load_reg(reg: i64, addr: i64) {
    unsafe { x64_load_from(c"movq", 0, x64_r(addr), x64_r(reg)); }
}

pub fn x64_store(ty: i64, reg: i64, addr: i64) {
    unsafe {
        let size = type_size(ty);
        let base = x64_r(addr);
        if ty == TY_F32 || ty == TY_F64 {
            o(if ty == TY_F32 { c"    movss %xmm" } else { c"    movsd %xmm" });
            oi(reg);
            o(c", ");
            x64_mem(0, base);
            on();
        } else if size == 1 {
            x64_store_to(c"movb", x64_reg(reg, 1), 0, base);
        } else if size == 2 {
            x64_store_to(c"movw", x64_reg(reg, 2), 0, base);
        } else if size == 4 {
            x64_store_to(c"movl", x64_reg(reg, 4), 0, base);
        } else {
            x64_store_to(c"movq", x64_r(reg), 0, base);
        }
    }
}

pub fn x64_store_offset(reg: i64, addr: i64, offset: i64) {
    unsafe { x64_store_to(c"movq", x64_r(reg), offset, x64_r(addr)); }
}

pub fn x64_copy(size: i64) {
    unsafe {
        if size > 128 {
            ins(c"movq %rcx, %rdi");
            ins(c"movq %rax, %rsi");
            x64_imm(c"movq", size, c"%rdx");
            x64_call_c(c"memcpy");
            return;
        }
        let mut offset = 0;
        while offset + 8 <= size {
            x64_load_from(c"movq", offset, c"%rax", c"%r10");
            x64_store_to(c"movq", c"%r10", offset, c"%rcx");
            offset += 8;
        }
        if offset + 4 <= size {
            x64_load_from(c"movl", offset, c"%rax", c"%r10d");
            x64_store_to(c"movl", c"%r10d", offset, c"%rcx");
            offset += 4;
        }
        if offset + 2 <= size {
            x64_load_from(c"movw", offset, c"%rax", c"%r10w");
            x64_store_to(c"movw", c"%r10w", offset, c"%rcx");
            offset += 2;
        }
        if offset < size {
            x64_load_from(c"movb", offset, c"%rax", c"%r10b");
            x64_store_to(c"movb", c"%r10b", offset, c"%rcx");
        }
    }
}

pub fn x64_move_to_second(ty: i64) {
    unsafe {
        if is_float(ty) {
            ins(c"movapd %xmm0, %xmm1");
        } else {
            ins(c"movq %rax, %rcx");
        }
    }
}

// Calls the C function `name` (in the C library).
fn x64_call_c(name: *u8) {
    unsafe {
        o(c"    call ");
        o(global_prefix());
        o(name);
        if ELF {
            o(c"@PLT");
        }
        on();
    }
}

// ---- Integer operations ----

pub fn x64_normalize(ty: i64) {
    unsafe {
        if ty == TY_I8 { ins(c"movsbq %al, %rax"); }
        else if ty == TY_U8 { ins(c"movzbl %al, %eax"); }
        else if ty == TY_I16 { ins(c"movswq %ax, %rax"); }
        else if ty == TY_U16 { ins(c"movzwl %ax, %eax"); }
        else if ty == TY_I32 { ins(c"movslq %eax, %rax"); }
        else if ty == TY_U32 { ins(c"movl %eax, %eax"); }
    }
}

pub fn x64_int_binary(op: Tok, ty: i64) {
    unsafe {
        let signed = is_signed(ty);
        match op {
            Plus => ins(c"addq %rcx, %rax"),
            Minus => ins(c"subq %rcx, %rax"),
            Star => ins(c"imulq %rcx, %rax"),
            Slash | Percent => x64_divide(op == Percent, signed),
            Amp => ins(c"andq %rcx, %rax"),
            Pipe => ins(c"orq %rcx, %rax"),
            Caret => ins(c"xorq %rcx, %rax"),
            Shl | Shr => {
                // The amount is taken modulo 32 for types up to 32 bits (8- and
                // 16-bit values are shifted at 32 bits), modulo 64 for 64-bit ones.
                ins(if int_bits(ty) == 64 { c"andq $63, %rcx" } else { c"andq $31, %rcx" });
                if op == Shl {
                    ins(c"shlq %cl, %rax");
                } else if signed {
                    ins(c"sarq %cl, %rax");
                } else {
                    ins(c"shrq %cl, %rax");
                }
            }
            _ => {}
        }
        x64_normalize(ty);
    }
}

// rax = rax / rcx (or rax % rcx), at 64 bits. Division by zero gives 0 and
// the remainder the dividend, and the signed MIN / -1 wraps, as on
// AArch64 (where idiv would trap).
fn x64_divide(remainder: bool, signed: bool) {
    unsafe {
        let by_zero = new_label();
        let done = new_label();
        ins(c"testq %rcx, %rcx");
        x64_jcc(c"e", by_zero);
        if signed {
            let by_minus_one = new_label();
            ins(c"cmpq $-1, %rcx");
            x64_jcc(c"e", by_minus_one);
            ins(c"cqto");
            ins(c"idivq %rcx");
            if remainder {
                ins(c"movq %rdx, %rax");
            }
            x64_jump(done);
            emit_label(by_minus_one);
            ins(if remainder { c"xorl %eax, %eax" } else { c"negq %rax" });
            x64_jump(done);
        } else {
            ins(c"xorl %edx, %edx");
            ins(c"divq %rcx");
            if remainder {
                ins(c"movq %rdx, %rax");
            }
            x64_jump(done);
        }
        emit_label(by_zero);
        if !remainder {
            ins(c"xorl %eax, %eax");
        }
        emit_label(done);
    }
}

pub fn x64_compare(op: Cond, ty: i64) {
    unsafe {
        if !is_float(ty) {
            ins(c"cmpq %rcx, %rax");
            o(c"    set");
            o(x64_int_cc(op, is_signed(ty)));
            o(c" %al\n");
            ins(c"movzbl %al, %eax");
            return;
        }
        let compare = if ty == TY_F32 { c"ucomiss" } else { c"ucomisd" };
        // Unordered (NaN) sets ZF, PF and CF: == and != check PF; < and <= swap
        // the operands to use the ordered "above" conditions.
        if op == Cond::Lt || op == Cond::Le {
            x64_ins2(compare, c"%xmm0", c"%xmm1");
        } else {
            x64_ins2(compare, c"%xmm1", c"%xmm0");
        }
        if op == Cond::Eq {
            ins(c"sete %al");
            ins(c"setnp %r10b");
            ins(c"andb %r10b, %al");
        } else if op == Cond::Ne {
            ins(c"setne %al");
            ins(c"setp %r10b");
            ins(c"orb %r10b, %al");
        } else if op == Cond::Lt || op == Cond::Gt {
            ins(c"seta %al");
        } else {
            ins(c"setae %al");
        }
        ins(c"movzbl %al, %eax");
    }
}

pub fn x64_negate(ty: i64) {
    unsafe {
        if ty == TY_F32 {
            ins(c"movd %xmm0, %r10d");
            ins(c"xorl $0x80000000, %r10d");
            ins(c"movd %r10d, %xmm0");
        } else if ty == TY_F64 {
            ins(c"movq %xmm0, %r10");
            ins(c"btcq $63, %r10");
            ins(c"movq %r10, %xmm0");
        } else {
            ins(c"negq %rax");
            x64_normalize(ty);
        }
    }
}

pub fn x64_not_bool() {
    unsafe { ins(c"xorq $1, %rax"); }
}

pub fn x64_bitnot(ty: i64) {
    unsafe { ins(c"notq %rax"); }
    x64_normalize(ty);
}

pub fn x64_index_addr(elem_size: i64) {
    unsafe {
        if elem_size == 1 || elem_size == 2 || elem_size == 4 || elem_size == 8 {
            ins_i(c"leaq (%rcx,%rax,", elem_size, c"), %rax");
            return;
        }
        if elem_size > 0 && (elem_size & (elem_size - 1)) == 0 {
            x64_imm(c"shlq", log2(elem_size), c"%rax");
        } else if fits_i32(elem_size) {
            ins_i(c"imulq $", elem_size, c", %rax, %rax");
        } else {
            x64_imm(c"movabsq", elem_size, c"%r10");
            ins(c"imulq %r10, %rax");
        }
        ins(c"addq %rcx, %rax");
    }
}

// ---- Floats ----

pub fn x64_float_binary(op: Tok, ty: i64) {
    unsafe {
        let f32 = ty == TY_F32;
        if op == Percent {
            x64_call_c(if f32 { c"fmodf" } else { c"fmod" });
            return;
        }
        o(match op {
            Plus => c"    add",
            Minus => c"    sub",
            Star => c"    mul",
            _ => c"    div",
        });
        o(if f32 { c"ss %xmm1, %xmm0\n" } else { c"sd %xmm1, %xmm0\n" });
    }
}

pub fn x64_int_to_float(from: i64, to: i64) {
    unsafe {
        let convert = if to == TY_F32 { c"cvtsi2ssq" } else { c"cvtsi2sdq" };
        if from != TY_U64 {
            // Signed, or unsigned below 2^32 (zero-extended): exact as signed.
            x64_ins2(convert, c"%rax", c"%xmm0");
            return;
        }
        // u64 at 2^63 and above: halve (keeping the low bit, for rounding),
        // convert, double.
        let big = new_label();
        let done = new_label();
        ins(c"testq %rax, %rax");
        x64_jcc(c"s", big);
        x64_ins2(convert, c"%rax", c"%xmm0");
        x64_jump(done);
        emit_label(big);
        ins(c"movq %rax, %r10");
        ins(c"shrq $1, %r10");
        ins(c"andl $1, %eax");
        ins(c"orq %rax, %r10");
        x64_ins2(convert, c"%r10", c"%xmm0");
        ins(if to == TY_F32 { c"addss %xmm0, %xmm0" } else { c"addsd %xmm0, %xmm0" });
        emit_label(done);
    }
}

pub fn x64_float_to_float(to: i64) {
    unsafe { ins(if to == TY_F64 { c"cvtss2sd %xmm0, %xmm0" } else { c"cvtsd2ss %xmm0, %xmm0" }); }
}

pub fn x64_float_to_int(from: i64, to: i64) {
    unsafe {
        let f32 = from == TY_F32;
        if is_signed(to) && int_bits(to) <= 32 {
            x64_truncate(f32, 32);
            ins(c"movslq %eax, %rax");
        } else if to != TY_U64 {
            x64_truncate(f32, 64);
        } else {
            // value >= 2^63 ? the unsigned conversion : the signed one.
            let big = new_label();
            let done = new_label();
            if f32 {
                ins(c"movl $0x5f000000, %r10d");
                ins(c"movd %r10d, %xmm1");
                ins(c"ucomiss %xmm1, %xmm0");
            } else {
                ins(c"movabsq $0x43e0000000000000, %r10");
                ins(c"movq %r10, %xmm1");
                ins(c"ucomisd %xmm1, %xmm0");
            }
            x64_jcc(c"ae", big);
            x64_truncate(f32, 64);
            x64_jump(done);
            emit_label(big);
            // value - 2^63 converts exactly below 2^64; above, the indefinite
            // result means "saturate to the maximum".
            ins(if f32 { c"subss %xmm1, %xmm0" } else { c"subsd %xmm1, %xmm0" });
            x64_ins2(if f32 { c"cvttss2si" } else { c"cvttsd2si" }, c"%xmm0", c"%rax");
            let saturate = new_label();
            ins(c"testq %rax, %rax");
            x64_jcc(c"s", saturate);
            ins(c"btsq $63, %rax");
            x64_jump(done);
            emit_label(saturate);
            ins(c"movq $-1, %rax");
            emit_label(done);
        }
        x64_normalize(to);
    }
}

// rax (eax at 32 bits) = the saturating signed conversion of xmm0: cvtt*
// gives the "integer indefinite" (the minimum) on NaN and overflow, which
// is fixed up to 0 for NaN and to the maximum for positive overflow.
fn x64_truncate(f32: bool, bits: i64) {
    unsafe {
        let done = new_label();
        let nan = new_label();
        let dst = if bits == 32 { c"%eax" } else { c"%rax" };
        x64_ins2(if f32 { c"cvttss2si" } else { c"cvttsd2si" }, c"%xmm0", dst);
        if bits == 32 {
            ins(c"cmpl $-2147483648, %eax");
        } else {
            ins(c"movabsq $-9223372036854775808, %r10");
            ins(c"cmpq %r10, %rax");
        }
        x64_jcc(c"ne", done);
        x64_ins2(if f32 { c"ucomiss" } else { c"ucomisd" }, c"%xmm0", c"%xmm0");
        x64_jcc(c"p", nan);
        // The minimum is right for negative overflow (and the minimum itself).
        if f32 {
            ins(c"movd %xmm0, %r10d");
            ins(c"testl %r10d, %r10d");
        } else {
            ins(c"movq %xmm0, %r10");
            ins(c"testq %r10, %r10");
        }
        x64_jcc(c"s", done);
        if bits == 32 {
            ins(c"movl $2147483647, %eax");
        } else {
            ins(c"movabsq $9223372036854775807, %rax");
        }
        x64_jump(done);
        emit_label(nan);
        ins(c"xorl %eax, %eax");
        emit_label(done);
    }
}

// ---- Functions ----

pub fn x64_function_start(symbol_prefix: *u8, name: i64, global: bool) {
    unsafe {
        let out = ASM;
        buf_str(out, c"\n.p2align 4\n");
        if global {
            buf_fmt(out, f".globl {cstr(symbol_prefix)}{SYMS[name].text}\n");
        }
        buf_fmt(out,
            f"{cstr(symbol_prefix)}{SYMS[name].text}:\n    pushq %rbp\n    movq %rsp, %rbp\n");
    }
}

pub fn x64_frame_reserve(size: i64) {
    unsafe { x64_imm(c"subq", size, c"%rsp"); }
}

pub fn x64_epilogue() {
    unsafe {
        ins(c"movq %rbp, %rsp");
        ins(c"popq %rbp");
        ins(c"ret");
    }
}

// ---- Calls ----

// System V: six int registers, eight float registers, then 8-byte stack
// slots in order. Variadic arguments are passed the same way.
pub fn x64_arg_location(ty: i64, state: *i64) -> i64 {
    unsafe {
        if is_float(ty) {
            if state[1] < X64_FLOAT_ARG_REGS {
                state[1] += 1;
                return 8 + state[1] - 1;
            }
        } else if state[0] < X64_INT_ARG_REGS {
            state[0] += 1;
            return state[0] - 1;
        }
        let offset = state[2];
        state[2] += 8;
        16 + offset
    }
}

pub fn x64_load_param(location: i64, ty: i64) {
    unsafe {
        if location < 8 {
            x64_ins2(c"movq", x64_int_arg(location), c"%rax");
        } else if location < 16 {
            ins_i(c"movapd %xmm", location - 8, c", %xmm0");
        } else {
            x64_load_from(c"leaq", location, c"%rbp", c"%r11");
            x64_load(ty, R_ADDR);
        }
    }
}

pub fn x64_sp_sub(size: i64) {
    unsafe { x64_imm(c"subq", size, c"%rsp"); }
}

pub fn x64_sp_add(size: i64) {
    unsafe { x64_imm(c"addq", size, c"%rsp"); }
}

pub fn x64_load_arg_reg(location: i64, ty: i64, from: i64, promote: bool) {
    unsafe {
        if location < 8 {
            x64_load_from(c"movq", from, c"%rsp", x64_int_arg(location));
            return;
        }
        o(if ty == TY_F32 { c"    movss " } else { c"    movsd " });
        x64_mem(from, c"%rsp");
        end_i(c", %xmm", location - 8, c"");
        if ty == TY_F32 && promote {
            o(c"    cvtss2sd %xmm");
            oi(location - 8);
            end_i(c", %xmm", location - 8, c"");
        }
    }
}

pub fn x64_stack_arg(ty: i64, from: i64, offset: i64, promote: bool) {
    unsafe {
        if ty == TY_F32 && promote {
            x64_load_from(c"movss", from, c"%rsp", c"%xmm8");
            ins(c"cvtss2sd %xmm8, %xmm8");
            x64_store_to(c"movsd", c"%xmm8", offset, c"%rsp");
            return;
        }
        // Every stack argument takes an 8-byte slot; scalars are canonical in
        // their temporary, f32 in its low 4 bytes.
        x64_load_from(c"movq", from, c"%rsp", c"%r10");
        x64_store_to(c"movq", c"%r10", offset, c"%rsp");
    }
}

// The `pushed` 16-byte temporaries at rsp move down so that the stack
// argument area below them (`stack_size` bytes) starts at a multiple of
// `align`; the rsp to restore after the call (above them) goes to frame
// slot `saved`. rax, r10 and r11 are free here.
pub fn x64_realign_pushed(pushed: i64, stack_size: i64, align: i64, saved: i64) {
    unsafe {
        ins(c"movq %rsp, %r10");
        x64_load_from(c"leaq", 16 * pushed, c"%r10", c"%r11");
        x64_store_to(c"movq", c"%r11", 0 - saved, c"%rbp");
        ins(c"movq %r10, %r11");
        x64_imm(c"subq", stack_size, c"%r11");
        x64_imm(c"andq", 0 - align, c"%r11");
        x64_imm(c"addq", stack_size, c"%r11");
        for i in 0..2 * pushed {
            x64_load_from(c"movq", 8 * i, c"%r10", c"%rax");
            x64_store_to(c"movq", c"%rax", 8 * i, c"%r11");
        }
        ins(c"movq %r11, %rsp");
    }
}

// rsp = frame slot `saved` (see x64_realign_pushed).
pub fn x64_restore_sp(saved: i64) {
    unsafe { x64_load_from(c"movq", 0 - saved, c"%rbp", c"%rsp"); }
}

pub fn x64_load_callee(from: i64) {
    unsafe { x64_load_from(c"movq", from, c"%rsp", c"%r11"); }
}

pub fn x64_call(prefix: *u8, name: i64, is_extern: bool, variadic: bool, vector_regs: i64) {
    unsafe {
        if variadic {
            // al: an upper bound on the vector registers carrying arguments.
            ins_i(c"movl $", vector_regs, c", %eax");
        }
        o(c"    call ");
        x64_symbol(prefix, name);
        if is_extern && ELF {
            o(c"@PLT");
        }
        on();
    }
}

pub fn x64_call_indirect() {
    unsafe { ins(c"call *%r11"); }
}

// ---- Run-time checks ----

pub fn x64_panic(kind: i64) {
    unsafe {
        ins(c"movq %rcx, %rdx");
        ins(c"movq %rax, %rsi");
        ins(c"movq %r11, %rcx");
        ins_i(c"movl $", kind, c", %edi");
        o(c"    call ");
        x64_symbol(function_prefix(), rt_panic_sym());
    }
    on();
}

// rt.panic(kind, a, b, c): dprintf(2, message[kind], a, b, c); exit(101).
pub fn x64_runtime() {
    unsafe {
        o(c"\n.p2align 4\n");
        x64_symbol(function_prefix(), rt_panic_sym());
        o(c":\n");
        ins(c"pushq %rbp");
        ins(c"movq %rsp, %rbp");
        ins(c"movq %rcx, %r8");
        ins(c"movq %rdx, %rcx");
        ins(c"movq %rsi, %rdx");
        ins(c"shlq $6, %rdi");
        o(c"    leaq ");
        o(local_prefix());
        o(c"rt.messages(%rip), %rsi\n");
        ins(c"addq %rdi, %rsi");
        ins(c"movl $2, %edi");
        ins(c"xorl %eax, %eax");
        o(c"    call ");
        o(global_prefix());
        o(if ELF { c"dprintf@PLT\n" } else { c"dprintf\n" });
        ins(c"movl $101, %edi");
        o(c"    call ");
        o(global_prefix());
        o(if ELF { c"exit@PLT\n" } else { c"exit\n" });
    }
}
