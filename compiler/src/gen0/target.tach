// The target layer: what the code generator (gen/) knows about the
// machine. This file holds the output helpers shared by every target and
// the target interface, which dispatches to the instruction set's file:
// arm64.tach (a64_*) or x86_64.tach (x64_*). The target selection (which
// machine, X86, ELF) is base/target.tach.
//
// Machine model used by the code generator, in virtual registers that each
// target maps to real ones:
//   R_ACC (0)     the accumulator: integers, bools and pointers; the float
//                 accumulator is a separate register (d0/s0, xmm0); values
//                 kept in memory (structs, tuples, arrays) are represented
//                 by their address in R_ACC
//   R_SECOND (1)  the second operand (int or float), and the destination
//                 of a copy
//   R_RESULT (8)  the result pointer of a function returning a compound
//                 value (set by the caller right before the call)
//   R_ADDR (9)    an address, for a load or store right after it is made
//   R_LOOP_PTR (10), R_LOOP_COUNT (11)
//                 the cursor and count of a fill loop (no calls inside)
// Temporaries (16 bytes each) live on the machine stack; every local lives
// in a frame slot at a negative offset from the frame pointer. Each target
// keeps its own scratch registers out of this set.

use crate::back::abi::returns_through_pointer;
use crate::base::{
    BUFS, IntVec, SYMS, buf_byte, buf_bytes, buf_clear, buf_fmt, buf_int, buf_new, buf_slice,
    buf_str, buf_uint, cstr, intern_c, strlen,
};
use crate::front::lexer::{Tok, add_string, str_at};
use crate::front::types::{ENUMS, align_to, is_float, scalar_type};
use crate::gen0::arm64::{
    a64_add_imm, a64_align_down, a64_arg_location, a64_bitnot, a64_call, a64_call_indirect,
    a64_compare, a64_compare_jump, a64_copy, a64_decrement, a64_drop_temps, a64_epilogue,
    a64_extern_symbol_addr, a64_float_binary, a64_float_to_float, a64_float_to_int, a64_frame_addr,
    a64_frame_reserve, a64_function_start, a64_index_addr, a64_int_binary, a64_int_to_float,
    a64_jump, a64_jump_if_nonzero, a64_jump_if_zero, a64_jump_unless_zero_result, a64_load,
    a64_load_arg_reg, a64_load_callee, a64_load_float, a64_load_imm, a64_load_param, a64_load_reg,
    a64_local_symbol_addr, a64_move_to_second, a64_negate, a64_normalize, a64_not_bool, a64_panic,
    a64_peek, a64_peek_at, a64_pop_float, a64_pop_int, a64_push_float, a64_push_int, a64_runtime,
    a64_sp_add, a64_sp_sub, a64_stack_arg, a64_store, a64_store_offset, a64_string_addr,
    a64_variadic_arg_location,
};
use crate::gen0::gen::{OVERALIGNED, overaligned_slot};
use crate::gen0::x86_64::{
    x64_add_imm, x64_align_down, x64_arg_location, x64_bitnot, x64_call, x64_call_indirect,
    x64_compare, x64_compare_jump, x64_copy, x64_decrement, x64_drop_temps, x64_epilogue,
    x64_extern_symbol_addr, x64_float_binary, x64_float_to_float, x64_float_to_int, x64_frame_addr,
    x64_frame_reserve, x64_function_start, x64_index_addr, x64_int_binary, x64_int_to_float,
    x64_jump, x64_jump_if_nonzero, x64_jump_if_zero, x64_jump_unless_zero_result, x64_load,
    x64_load_arg_reg, x64_load_callee, x64_load_float, x64_load_imm, x64_load_param, x64_load_reg,
    x64_local_symbol_addr, x64_move_to_second, x64_negate, x64_normalize, x64_not_bool, x64_panic,
    x64_peek, x64_peek_at, x64_pop_float, x64_pop_int, x64_push_float, x64_push_int, x64_runtime,
    x64_sp_add, x64_sp_sub, x64_stack_arg, x64_store, x64_store_offset, x64_string_addr,
};
use crate::middle::ir::Cond;
use crate::middle::lower::ssa::HMap;

use crate::base::target::{APPLE_A64, ELF, X86};
use crate::middle::ctx::FnCtx;
use crate::middle::parallel::const_data_id;
use crate::middle::trace::trace_dump_fn;

pub const R_ACC: i64 = 0;
pub const R_SECOND: i64 = 1;
pub const R_RESULT: i64 = 8;
pub const R_ADDR: i64 = 9;
pub const R_LOOP_PTR: i64 = 10;
pub const R_LOOP_COUNT: i64 = 11;

pub static mut DATA: i64 = -1;
// Temporaries currently pushed (16 bytes each).
pub static mut DEPTH: i64 = 0;

// ---- Output helpers ----

pub fn o(mut cx: *FnCtx, s: *u8) {
    unsafe { buf_str(cx.code, s); }
}

pub fn oi(mut cx: *FnCtx, value: i64) {
    unsafe { buf_int(cx.code, value); }
}

// (0.18.1) buf_fmt with cx's scratch text: base::buf_fmt's is the
// program's, which two tasks would share.
pub fn cx_fmt<T: std::Display>(mut cx: *FnCtx, b: i64, x: T) {
    unsafe {
        (*cx.fmt).clear();
        (*cx.fmt).push_fmt(x);
        buf_bytes(b, (*cx.fmt).as_slice());
    }
}

pub fn on(mut cx: *FnCtx) {
    unsafe { buf_byte(cx.code, '\n'); }
}

// "    <s>\n"
pub fn ins(mut cx: *FnCtx, s: *u8) {
    unsafe {
        unsafe { buf_str(cx.code, c"    "); }
        buf_str(cx.code, s);
        buf_byte(cx.code, '\n');
    }
}

// "    <a><value><b>\n"
pub fn ins_i(mut cx: *FnCtx, a: *u8, value: i64, b: *u8) {
    unsafe {
        unsafe { buf_str(cx.code, c"    "); }
        buf_str(cx.code, a);
        buf_int(cx.code, value);
        buf_str(cx.code, b);
        buf_byte(cx.code, '\n');
    }
}

// Ends a line started with o(): "<a><value><b>\n".
pub fn end_i(mut cx: *FnCtx, a: *u8, value: i64, b: *u8) {
    unsafe {
        buf_str(cx.code, a);
        buf_int(cx.code, value);
        buf_str(cx.code, b);
        buf_byte(cx.code, '\n');
    }
}

// Ends a line started with o(): "<s>\n".
pub fn end(mut cx: *FnCtx, s: *u8) {
    unsafe {
        buf_str(cx.code, s);
        buf_byte(cx.code, '\n');
    }
}

pub fn new_label(mut cx: *FnCtx) -> i64 {
    unsafe {
        cx.label_count += 1;
        cx.label_count
    }
}

// Assembler-local labels: "L" on Mach-O, ".L" on ELF.
pub fn local_prefix() -> *u8 {
    if ELF { c".L" } else { c"L" }
}

// The prefix of C-visible symbols: "_" on Mach-O, nothing on ELF.
pub fn global_prefix() -> *u8 {
    if ELF { c"" } else { c"_" }
}

// The symbol prefix of tachyon functions (other than main) and statics.
pub fn function_prefix() -> *u8 {
    if ELF { c"tachyon." } else { c"_tachyon." }
}

pub fn static_prefix() -> *u8 {
    if ELF { c"tachyon.static." } else { c"_tachyon.static." }
}

pub fn emit_label(mut cx: *FnCtx, label: i64) {
    unsafe {
        o_label(cx, label);
        o(cx, c":\n");
    }
}

// A local label as an operand: L<n> (.L<n> on ELF). In a task's context
// (local_labels) the number is the function's own, written L\x01<n>,
// which the join renumbers (middle::parallel, join_text).
pub fn o_label(mut cx: *FnCtx, label: i64) {
    unsafe {
        o(cx, local_prefix());
        if cx.local_labels {
            buf_byte(cx.code, 1);
        }
    }
    oi(cx, label);
}

// The label of string literal or constant data `id`: Lstr.<id>. Constant
// data a task made, not numbered yet (a negative id, middle::parallel):
// Lstr.\x02<n>, which the join numbers.
pub fn o_str_label(mut cx: *FnCtx, id: i64) {
    unsafe {
        o(cx, local_prefix());
        o(cx, c"str.");
    }
    let real = const_data_id(id);
    if real < 0 {
        unsafe { buf_byte(cx.code, 2); }
        oi(cx, -id - 1);
    } else {
        oi(cx, real);
    }
}

// C symbols given by #[link_name = "..."] (symbol + 1 -> symbol + 1).
pub static mut LINK_NAMES: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

// "<prefix><name>"; a C symbol (prefix "_" or none) may be renamed by
// #[link_name].
pub fn emit_symbol_ref(mut cx: *FnCtx, sym_prefix: *u8, name: i64) {
    unsafe {
        o(cx, sym_prefix);
        if strlen(sym_prefix) <= 1 {
            let link = LINK_NAMES.get(name + 1);
            if link != 0 {
                buf_bytes(cx.code, SYMS[link - 1].text);
                return;
            }
        }
        buf_bytes(cx.code, SYMS[name].text);
    }
}

// log2 of a power of two.
pub fn log2(value: i64) -> i64 {
    let mut result = 0;
    while (1 << result as u64) < value {
        result += 1;
    }
    result
}

// Pushes the accumulator for a value of type `ty`.
pub fn push_value(mut cx: *FnCtx, ty: i64) {
    if is_float(ty) {
        push_d0(cx);
    } else {
        push_x0(cx);
    }
}

// ---- Data ----

pub fn data_label(prefix: *u8, name: i64) {
    buf_str(DATA, prefix);
    unsafe {
        buf_fmt(DATA, f"{SYMS[name].text}:\n");
    }
}

// `.byte` lines for `n` bytes at `p`.
pub fn data_bytes(bytes: [u8]) {
    unsafe {
        let n = bytes.len as i64;
        let p = bytes.ptr;
        if (0..n).all(|i| p[i] == 0) {
            if n > 0 {
                buf_fmt(DATA, f"    .space {n}\n");
            }
            return;
        }
        let mut i = 0;
        while i < n {
            buf_str(DATA, c"    .byte ");
            let mut j = 0;
            while j < 16 && i < n {
                if j > 0 {
                    buf_byte(DATA, ',');
                }
                buf_uint(DATA, p[i]);
                i += 1;
                j += 1;
            }
            buf_byte(DATA, '\n');
        }
    }
}

pub fn data_section(writable: bool) {
    unsafe {
        if ELF {
            buf_str(DATA, if writable { c"\n.data\n" } else { c"\n.section .rodata\n" });
        } else {
            buf_str(DATA,
                if writable { c"\n.section __DATA,__data\n" }
                else { c"\n.section __TEXT,__const\n" });
        }
    }
}

pub fn data_align(align: i64) {
    unsafe { buf_str(DATA, c".p2align "); }
    buf_fmt(DATA, f"{log2(align)}\n");
}

// The alignment of each string literal or constant data (0: none).
static mut STR_ALIGN: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Read-only data made by the optimizer (as a string, so that it is
// addressed like one): returns its id.
pub fn add_const_data(bytes: [u8], align: i64) -> i64 {
    let id = add_string(bytes);
    while STR_ALIGN.count <= id {
        STR_ALIGN.push(0);
    }
    unsafe { STR_ALIGN.data[id] = align; }
    id
}

pub fn data_string(id: i64) {
    unsafe {
        if id < STR_ALIGN.count && STR_ALIGN.data[id] > 1 {
            data_align(STR_ALIGN.data[id]);
        }
        buf_fmt(DATA, f"{cstr(local_prefix())}str.{id}:\n");
        data_bytes(str_at(id));
        buf_str(DATA, c"    .byte 0\n");
    }
}

// The start and the end of the assembly file.
pub fn emit_file_header(mut cx: *FnCtx) {
    unsafe { buf_str(cx.asm, if ELF { c".text\n" } else { c".section __TEXT,__text\n" }); }
}

pub fn emit_file_trailer(mut cx: *FnCtx) {
    if ELF {
        // No executable stack.
        unsafe { buf_str(cx.asm, c"\n.section .note.GNU-stack,\"\",@progbits\n"); }
    }
}

// ---- The target interface ----
//
// Every function below dispatches to the instruction set. The comments
// describe the contract in terms of the virtual registers above.

// Control flow.
pub fn emit_jump(mut cx: *FnCtx, label: i64) {
    if X86 { x64_jump(cx, label); } else { a64_jump(cx, label); }
}

// Jumps when the accumulator is zero (false).
pub fn emit_jump_if_zero(mut cx: *FnCtx, label: i64) {
    if X86 { x64_jump_if_zero(cx, label); } else { a64_jump_if_zero(cx, label); }
}

pub fn emit_jump_if_nonzero(mut cx: *FnCtx, label: i64) {
    if X86 { x64_jump_if_nonzero(cx, label); } else { a64_jump_if_nonzero(cx, label); }
}

// <reg> -= 1, setting the flags for emit_jump_unless_zero_result.
pub fn emit_decrement(mut cx: *FnCtx, reg: i64) {
    if X86 { x64_decrement(cx, reg); } else { a64_decrement(cx, reg); }
}

// Jumps unless the last emit_decrement reached zero (stores in between do
// not change the flags).
pub fn emit_jump_unless_zero_result(mut cx: *FnCtx, label: i64) {
    if X86 { x64_jump_unless_zero_result(cx, label); }
    else { a64_jump_unless_zero_result(cx, label); }
}

// Jumps when R_ACC <op> R_SECOND, integers (op a comparison token).
pub fn emit_compare_jump(mut cx: *FnCtx, op: Cond, signed: bool, label: i64) {
    if X86 { x64_compare_jump(cx, op, signed, label); }
    else { a64_compare_jump(cx, op, signed, label); }
}

// Constants and addresses.

// <reg> = value
pub fn emit_load_imm(mut cx: *FnCtx, reg: i64, value: u64) {
    if X86 { x64_load_imm(cx, reg, value); } else { a64_load_imm(cx, reg, value); }
}

// <reg> = frame pointer - offset
pub fn emit_frame_addr(mut cx: *FnCtx, reg: i64, offset: i64) {
    unsafe {
        let i = overaligned_slot(offset);
        if i >= 0 {
            // The slot's address rounded up to its alignment, inside the room
            // left below it; then the field's offset.
            let slot = OVERALIGNED.data[i];
            let align = OVERALIGNED.data[i + 1];
            emit_frame_addr_plain(cx, reg, slot - (align - 16));
            if X86 { x64_align_down(cx, reg, align); } else { a64_align_down(cx, reg, align); }
            if slot != offset {
                if X86 { x64_add_imm(cx, reg, slot - offset); }
                else { a64_add_imm(cx, reg, slot - offset); }
            }
            return;
        }
        emit_frame_addr_plain(cx, reg, offset);
    }
}

fn emit_frame_addr_plain(mut cx: *FnCtx, reg: i64, offset: i64) {
    if X86 { x64_frame_addr(cx, reg, offset); } else { a64_frame_addr(cx, reg, offset); }
}

// <reg> += value
pub fn emit_add_imm(mut cx: *FnCtx, reg: i64, value: i64) {
    if X86 { x64_add_imm(cx, reg, value); } else { a64_add_imm(cx, reg, value); }
}

// R_ACC = address of a symbol defined in this file.
pub fn emit_local_symbol_addr(mut cx: *FnCtx, prefix: *u8, name: i64) {
    if X86 { x64_local_symbol_addr(cx, prefix, name); }
    else { a64_local_symbol_addr(cx, prefix, name); }
}

// R_ACC = address of an external (C) symbol.
pub fn emit_extern_symbol_addr(mut cx: *FnCtx, name: i64) {
    if X86 { x64_extern_symbol_addr(cx, name); } else { a64_extern_symbol_addr(cx, name); }
}

// R_ACC = address of string literal `id`.
pub fn emit_string_addr(mut cx: *FnCtx, id: i64) {
    if X86 { x64_string_addr(cx, id); } else { a64_string_addr(cx, id); }
}

// Float accumulator = the float whose f64 bits are `bits`.
pub fn emit_load_float(mut cx: *FnCtx, bits: i64, ty: i64) {
    if X86 { x64_load_float(cx, bits, ty); } else { a64_load_float(cx, bits, ty); }
}

// Temporaries.

pub fn push_x0(mut cx: *FnCtx) {
    if X86 { x64_push_int(cx); } else { a64_push_int(cx); }
    DEPTH += 1;
}

fn push_d0(mut cx: *FnCtx) {
    if X86 { x64_push_float(cx); } else { a64_push_float(cx); }
    DEPTH += 1;
}

// Pops the top temporary into int register <reg>.
pub fn pop_x(mut cx: *FnCtx, reg: i64) {
    if X86 { x64_pop_int(cx, reg); } else { a64_pop_int(cx, reg); }
    DEPTH -= 1;
}

// Pops the top temporary into float register <reg> (0: the accumulator).
pub fn pop_d(mut cx: *FnCtx, reg: i64) {
    if X86 { x64_pop_float(cx, reg); } else { a64_pop_float(cx, reg); }
    DEPTH -= 1;
}

// <reg> = the top temporary, left in place.
pub fn emit_peek(mut cx: *FnCtx, reg: i64) {
    if X86 { x64_peek(cx, reg); } else { a64_peek(cx, reg); }
}

// <reg> (an int register, or float register <reg> when `float`) = the
// temporary `depth` below the top (0: the top), left in place.
pub fn emit_peek_at(mut cx: *FnCtx, reg: i64, depth: i64, float: bool) {
    if X86 { x64_peek_at(cx, reg, depth, float); } else { a64_peek_at(cx, reg, depth, float); }
}

// Drops `count` temporaries without changing DEPTH (for jumps out of the
// current expression).
pub fn emit_drop_temps(mut cx: *FnCtx, count: i64) {
    if count > 0 {
        if X86 { x64_drop_temps(cx, count); } else { a64_drop_temps(cx, count); }
    }
}

// Loads and stores.

// Accumulator = the value of type `ty` at [<addr>].
pub fn emit_load(mut cx: *FnCtx, ty: i64, addr: i64) {
    let t = scalar_type(ty);
    if X86 { x64_load(cx, t, addr); } else { a64_load(cx, t, addr); }
}

// <reg> = the 8 bytes at [<addr>].
pub fn emit_load_reg(mut cx: *FnCtx, reg: i64, addr: i64) {
    if X86 { x64_load_reg(cx, reg, addr); } else { a64_load_reg(cx, reg, addr); }
}

// [<addr>] = <reg>, a value of type `ty` (register <reg> of the float
// accumulator's kind for floats).
pub fn emit_store(mut cx: *FnCtx, ty: i64, reg: i64, addr: i64) {
    let t = scalar_type(ty);
    if X86 { x64_store(cx, t, reg, addr); } else { a64_store(cx, t, reg, addr); }
}

// [<addr> + offset] = the 8 bytes of <reg>.
pub fn emit_store_offset(mut cx: *FnCtx, reg: i64, addr: i64, offset: i64) {
    if X86 { x64_store_offset(cx, reg, addr, offset); }
    else { a64_store_offset(cx, reg, addr, offset); }
}

// Copies `size` bytes from [R_ACC] to [R_SECOND]; clobbers the target's
// scratch registers (and every caller-saved register for large copies).
pub fn emit_copy(mut cx: *FnCtx, size: i64) {
    if X86 { x64_copy(cx, size); } else { a64_copy(cx, size); }
}

// R_SECOND = accumulator (the float registers for floats).
pub fn emit_move_to_second(mut cx: *FnCtx, ty: i64) {
    if X86 { x64_move_to_second(cx, ty); } else { a64_move_to_second(cx, ty); }
}

// Integer operations: integers are kept sign- or zero-extended to 64 bits.

// Brings R_ACC into the canonical form of `ty`.
pub fn emit_normalize(mut cx: *FnCtx, ty: i64) {
    let t = scalar_type(ty);
    if X86 { x64_normalize(cx, t); } else { a64_normalize(cx, t); }
}

// R_ACC = R_ACC <op> R_SECOND for integers of type `ty`.
pub fn emit_int_binary(mut cx: *FnCtx, op: Tok, ty: i64) {
    if X86 { x64_int_binary(cx, op, ty); } else { a64_int_binary(cx, op, ty); }
}

// R_ACC = (accumulator <op> second operand) as a bool; operands of `ty`.
pub fn emit_compare(mut cx: *FnCtx, op: Cond, ty: i64) {
    let t = scalar_type(ty);
    if X86 { x64_compare(cx, op, t); } else { a64_compare(cx, op, t); }
}

// Accumulator = -accumulator.
pub fn emit_negate(mut cx: *FnCtx, ty: i64) {
    if X86 { x64_negate(cx, ty); } else { a64_negate(cx, ty); }
}

// R_ACC = !R_ACC (a bool).
pub fn emit_not_bool(mut cx: *FnCtx) {
    if X86 { x64_not_bool(cx); } else { a64_not_bool(cx); }
}

// R_ACC = ~R_ACC.
pub fn emit_bitnot(mut cx: *FnCtx, ty: i64) {
    if X86 { x64_bitnot(cx, ty); } else { a64_bitnot(cx, ty); }
}

// R_ACC = R_SECOND + R_ACC * elem_size (an element's address).
pub fn emit_index_addr(mut cx: *FnCtx, elem_size: i64) {
    if X86 { x64_index_addr(cx, elem_size); } else { a64_index_addr(cx, elem_size); }
}

// Floats.

// Float accumulator = accumulator <op> second operand.
pub fn emit_float_binary(mut cx: *FnCtx, op: Tok, ty: i64) {
    if X86 { x64_float_binary(cx, op, ty); } else { a64_float_binary(cx, op, ty); }
}

pub fn emit_int_to_float(mut cx: *FnCtx, from: i64, to: i64) {
    if X86 { x64_int_to_float(cx, from, to); } else { a64_int_to_float(cx, from, to); }
}

pub fn emit_float_to_float(mut cx: *FnCtx, from: i64, to: i64) {
    if from == to {
        return;
    }
    if X86 { x64_float_to_float(cx, to); } else { a64_float_to_float(cx, to); }
}

// Saturating conversions (NaN is 0): signed results up to 32 bits convert
// at 32 bits and wrap, unsigned ones up to 32 bits convert signed at 64
// bits and wrap; u64 converts unsigned at 2^63 and above.
pub fn emit_float_to_int(mut cx: *FnCtx, from: i64, to: i64) {
    if X86 { x64_float_to_int(cx, from, to); } else { a64_float_to_int(cx, from, to); }
}

// Functions.

pub fn emit_function_start(mut cx: *FnCtx, symbol_prefix: *u8, name: i64, global: bool) {
    if X86 { x64_function_start(cx, symbol_prefix, name, global); }
    else { a64_function_start(cx, symbol_prefix, name, global); }
}

// Reserves the frame once its size is known (written to ASM, after the
// function start).
pub fn emit_frame_reserve(mut cx: *FnCtx, frame_size: i64) {
    unsafe {
        let size = align_to(frame_size, 16);
        if size == 0 {
            return;
        }
        let out = cx.code;
        cx.code = cx.asm;
        if X86 { x64_frame_reserve(cx, size); } else { a64_frame_reserve(cx, size); }
        cx.code = out;
    }
}

pub fn emit_epilogue(mut cx: *FnCtx) {
    if X86 { x64_epilogue(cx); } else { a64_epilogue(cx); }
}

// Calls. An argument's location is 0-7 for an int register (by index in
// the target's argument registers), 8-15 for a float register, or
// 16 + offset for the outgoing stack area. `state` holds the next int
// register, the next float register and the stack offset.

pub fn arg_location(ty: i64, state: *i64) -> i64 {
    if X86 { x64_arg_location(ty, state) } else { a64_arg_location(ty, state) }
}

// The location of an argument passed to the `...` of a C function: where
// a named one would go, but on Apple's arm64 (always on the stack).
pub fn variadic_arg_location(ty: i64, state: *i64) -> i64 {
    if X86 { x64_arg_location(ty, state) } else if APPLE_A64 { a64_variadic_arg_location(state) }
    else { a64_arg_location(ty, state) }
}

// The first int argument register used by ordinary arguments of a function
// returning `ret` (1 where the result pointer takes the first one).
pub fn first_int_arg(mut cx: *FnCtx, ret: i64) -> i64 {
    if X86 && returns_through_pointer(cx, ret) { 1 } else { 0 }
}

// Accumulator = the incoming parameter at `location`, of type `ty` (a
// pointer for compound values).
pub fn emit_load_param(mut cx: *FnCtx, location: i64, ty: i64) {
    let t = scalar_type(ty);
    if X86 { x64_load_param(cx, location, t); } else { a64_load_param(cx, location, t); }
}

// Moves the stack pointer down (reserve) or up (release) by `size` bytes.
pub fn emit_sp_sub(mut cx: *FnCtx, size: i64) {
    if X86 { x64_sp_sub(cx, size); } else { a64_sp_sub(cx, size); }
}

pub fn emit_sp_add(mut cx: *FnCtx, size: i64) {
    if X86 { x64_sp_add(cx, size); } else { a64_sp_add(cx, size); }
}

// Loads argument register `location` from the temporary at sp + from;
// `promote` widens an f32 to f64 (C's default promotion).
pub fn emit_load_arg_reg(mut cx: *FnCtx, location: i64, ty: i64, from: i64, promote: bool) {
    let t = scalar_type(ty);
    if X86 { x64_load_arg_reg(cx, location, t, from, promote); }
    else { a64_load_arg_reg(cx, location, t, from, promote); }
}

// Copies the temporary at sp + from to the outgoing stack area at
// sp + offset.
pub fn emit_stack_arg(mut cx: *FnCtx, ty: i64, from: i64, offset: i64, promote: bool) {
    let t = scalar_type(ty);
    if X86 { x64_stack_arg(cx, t, from, offset, promote); }
    else { a64_stack_arg(cx, t, from, offset, promote); }
}

// Loads the callee of an indirect call from the temporary at sp + from.
pub fn emit_load_callee(mut cx: *FnCtx, from: i64) {
    if X86 { x64_load_callee(cx, from); } else { a64_load_callee(cx, from); }
}

// Calls a function by symbol; `vector_regs` float registers carry
// arguments (needed by variadic C functions on x86-64).
pub fn emit_call(mut cx: *FnCtx, prefix: *u8, name: i64, is_extern: bool, variadic: bool,
    vector_regs: i64) {
    if X86 { x64_call(cx, prefix, name, is_extern, variadic, vector_regs); }
    else { a64_call(cx, prefix, name); }
}

pub fn emit_call_indirect(mut cx: *FnCtx) {
    if X86 { x64_call_indirect(cx); } else { a64_call_indirect(cx); }
}

// ---- Run-time checks ----
//
// A failed check calls the run-time helper `rt.panic(kind, a, b, c)`,
// emitted once per program (see emit_runtime), which writes a message to
// stderr and exits with 101. Kinds: index out of bounds (a = the index, b
// = the length), signed or unsigned index; slice range out of bounds (a..b,
// c = the length), signed or unsigned bounds.

pub const PANIC_INDEX_SIGNED: i64 = 0;
pub const PANIC_INDEX_UNSIGNED: i64 = 1;
pub const PANIC_RANGE_SIGNED: i64 = 2;
pub const PANIC_RANGE_UNSIGNED: i64 = 3;

// Whether a check was generated (the helper is then emitted), and its
// symbol (after the prefix of tachyon functions).
pub static mut PANIC_USED: bool = false;
static mut RT_PANIC_SYM: i64 = 0;

// Enums checked by `n as E` (0.4): kind 4 + i is "invalid value V for
// enum E" for ENUM_PANICS[i].
static mut ENUM_PANICS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

pub fn enum_panic_kind(e: i64) -> i64 {
    for i in 0..ENUM_PANICS.count {
        if unsafe { ENUM_PANICS.data[i] == e } {
            return 4 + i;
        }
    }
    ENUM_PANICS.push(e);
    3 + ENUM_PANICS.count
}

pub fn rt_panic_sym() -> i64 {
    if RT_PANIC_SYM == 0 {
        unsafe { RT_PANIC_SYM = intern_c(c"rt.panic"); }
    }
    RT_PANIC_SYM
}

// Calls the helper with a = R_ACC, b = R_SECOND, c = R_ADDR.
pub fn emit_panic(mut cx: *FnCtx, kind: i64) {
    PANIC_USED = true;
    if X86 { x64_panic(cx, kind); } else { a64_panic(cx, kind); }
}

// (0.17) The line after a failure's message, without --trace; std's panic
// prints the same (std::panic_note).
pub fn panic_note_text() -> [u8] {
    "note: build with --trace for the line and its callers\n"
}

// The helper and its messages, when a check was generated.
pub fn emit_runtime(mut cx: *FnCtx) {
    unsafe {
        if !PANIC_USED {
            return;
        }
        let out = cx.code;
        buf_clear(cx.code);
        if X86 { x64_runtime(cx); } else { a64_runtime(cx); }
        buf_bytes(cx.asm, buf_slice(cx.code));
        cx.code = out;
        // The four messages, 128 bytes apart; (0.17) each with a note on
        // --trace, without --trace (with it, the trace follows them).
        let note = if trace_dump_fn() >= 0 { "" } else { panic_note_text() };
        data_section(writable: false);
        buf_fmt(DATA, f".p2align 7\n{cstr(local_prefix())}rt.messages:\n");
        let messages: [*u8; 4] = [
            c"index out of bounds: index %lld, length %llu\n",
            c"index out of bounds: index %llu, length %llu\n",
            c"slice range out of bounds: %lld..%lld, length %llu\n",
            c"slice range out of bounds: %llu..%llu, length %llu\n",
        ];
        for i in 0..4 {
            let text = messages[i];
            let n = strlen(text) as i64;
            data_bytes(text[0..n]);
            data_bytes(note);
            buf_fmt(DATA, f"    .space {128 - n - note.len as i64}\n");
        }
        for i in 0..ENUM_PANICS.count {
            let m = buf_new();
            buf_str(m, c"invalid value %lld for enum ");
            let name = SYMS[ENUMS[ENUM_PANICS.data[i]].name].text;
            let room = 126 - note.len as i64 - BUFS[m].len;
            buf_bytes(m, if name.len as i64 > room { name[0..room] } else { name });
            buf_byte(m, '\n');
            buf_bytes(m, note);
            data_bytes(buf_slice(m));
            buf_fmt(DATA, f"    .space {128 - BUFS[m].len}\n");
        }
    }
}
