// SIMD vectors in gen0 (0.10): vector operators, negation, compound
// assignment and the vector operations (load, store, splat, lanes, sum),
// all lane by lane with the scalar operations.

use crate::front::ast::{
    NODES, VK_LANE, VK_LOAD, VK_NEW, VK_SPLAT, VK_STORE, VK_SUM, VK_WITH, child,
};
use crate::front::lexer::Tok;
use crate::front::parser::exprs::is_comparison;
use crate::front::types::{
    TYPES, TY_I64, TY_U64, is_float, is_slice, type_size, vec_elem, vec_lanes,
};
use crate::gen0::gen::{
    alloc_slot, load_reg_from_frame, pop_second_operand, store_reg_to_frame, store_to_frame,
};
use crate::gen0::gen::expr::{gen_addr, gen_aggregate, gen_expr};
use crate::gen0::target::{
    PANIC_INDEX_SIGNED, PANIC_RANGE_SIGNED, R_ACC, R_ADDR, R_SECOND, emit_add_imm, emit_bitnot,
    emit_compare, emit_compare_jump, emit_copy, emit_float_binary, emit_frame_addr, emit_index_addr,
    emit_int_binary, emit_label, emit_load, emit_load_imm, emit_load_reg, emit_move_to_second,
    emit_negate, emit_panic, emit_store, new_label, push_value,
};
use crate::middle::ir::{Cond, cond_of_token};

// ---- Vectors (0.10) ----
//
// Lane by lane, with the scalar operations: each vector operand is first
// copied into a frame slot of its own (so that evaluating the next operand
// cannot change it), each lane is loaded from there, and the result is
// built in a new slot, whose address is the value.

fn lane_size(vt: i64) -> i64 {
    type_size(vec_elem(vt))
}

// Evaluates vector expression e into a new slot; returns its offset.
fn gen_vector_to_slot(e: i64) -> i64 {
    let slot = alloc_slot(16, 16);
    gen_expr(e);
    emit_frame_addr(R_SECOND, slot);
    emit_copy(16);
    slot
}

// Evaluates scalar expression e (of type ty) into a new slot.
fn gen_scalar_to_slot(e: i64, ty: i64) -> i64 {
    let slot = alloc_slot(8, 8);
    gen_expr(e);
    store_to_frame(ty, slot);
    slot
}

// Accumulator = the scalar of type ty at frame offset `offset`.
fn load_frame_scalar(ty: i64, offset: i64) {
    emit_frame_addr(R_ACC, offset);
    emit_load(ty, R_ACC);
}

// Accumulator = lane i (of type ty) of the vector in slot `slot`.
fn load_lane(slot: i64, ty: i64, i: i64) {
    load_frame_scalar(ty, slot - i * type_size(ty));
}

// Lane i of the vector in slot `slot` = the accumulator (of type ty).
fn store_lane(slot: i64, ty: i64, i: i64) {
    store_to_frame(ty, slot - i * type_size(ty));
}

// Accumulator = lane i of slot a <op> lane i of slot b (the operands of
// type ty); a comparison gives -1 or 0 (of type result_ty).
fn gen_lane_operator(op: Tok, a: i64, b: i64, ty: i64, result_ty: i64, i: i64) {
    load_lane(a, ty, i);
    push_value(ty);
    load_lane(b, ty, i);
    pop_second_operand(ty);
    if is_comparison(op) {
        emit_compare(cond_of_token(op), ty);
        emit_negate(result_ty);
    } else if is_float(ty) {
        emit_float_binary(op, ty);
    } else {
        emit_int_binary(op, ty);
    }
}

pub fn gen_vector_binary(op: Tok, lhs: i64, rhs: i64, result_vt: i64) {
    let vt = unsafe { NODES[lhs].ty };
    let a = gen_vector_to_slot(lhs);
    let b = gen_vector_to_slot(rhs);
    let r = alloc_slot(16, 16);
    let elem = vec_elem(vt);
    let result_elem = vec_elem(result_vt);
    for i in 0..vec_lanes(vt) {
        gen_lane_operator(op, a, b, elem, result_elem, i);
        store_lane(r, result_elem, i);
    }
    emit_frame_addr(R_ACC, r);
}

pub fn gen_vector_negate(operand: i64, vt: i64) {
    let a = gen_vector_to_slot(operand);
    let elem = vec_elem(vt);
    for i in 0..vec_lanes(vt) {
        load_lane(a, elem, i);
        emit_negate(elem);
        store_lane(a, elem, i);
    }
    emit_frame_addr(R_ACC, a);
}

// `target <op>= value` on a vector: the value is in the accumulator (its
// address).
pub fn gen_vector_assign(op: Tok, target: i64, vt: i64) {
    let b = alloc_slot(16, 16);
    emit_frame_addr(R_SECOND, b);
    emit_copy(16);
    let addr = alloc_slot(8, 8);
    gen_addr(target);
    store_reg_to_frame(R_ACC, addr);
    let elem = vec_elem(vt);
    let size = type_size(elem);
    for i in 0..vec_lanes(vt) {
        load_reg_from_frame(R_ACC, addr);
        emit_add_imm(R_ACC, i * size);
        emit_load(elem, R_ACC);
        push_value(elem);
        load_lane(b, elem, i);
        pop_second_operand(elem);
        if is_float(elem) {
            emit_float_binary(op, elem);
        } else {
            emit_int_binary(op, elem);
        }
        load_reg_from_frame(R_ADDR, addr);
        emit_add_imm(R_ADDR, i * size);
        emit_store(elem, R_ACC, R_ADDR);
    }
}

// The memory of a vector load or store, `s` (a slice or an array), and its
// index: slots holding the address of the first lane, after checking
// that the lanes are in bounds (a range i..i + lanes of s).
fn gen_vector_address(s: i64, index: i64, lanes: i64, elem: i64) -> i64 {
    unsafe {
        let s_ty = NODES[s].ty;
        let ptr = alloc_slot(8, 8);
        let len = alloc_slot(8, 8);
        gen_expr(s);
        if is_slice(s_ty) {
            emit_move_to_second(TY_U64);
            emit_load_reg(R_ACC, R_SECOND);
            store_reg_to_frame(R_ACC, ptr);
            emit_add_imm(R_SECOND, 8);
            emit_load_reg(R_ACC, R_SECOND);
            store_reg_to_frame(R_ACC, len);
        } else {
            store_reg_to_frame(R_ACC, ptr);
            emit_load_imm(R_ACC, TYPES[s_ty].b as u64);
            store_reg_to_frame(R_ACC, len);
        }
        let idx = gen_scalar_to_slot(index, TY_I64);
        // index <= len - lanes (signed: len - lanes may be negative), and
        // 0 <= index.
        let ok = new_label();
        let fail = new_label();
        load_reg_from_frame(R_SECOND, len);
        emit_add_imm(R_SECOND, 0 - lanes);
        load_reg_from_frame(R_ACC, idx);
        emit_compare_jump(Cond::Gt, true, fail);
        emit_load_imm(R_SECOND, 0);
        emit_compare_jump(Cond::Ge, true, ok);
        emit_label(fail);
        load_reg_from_frame(R_SECOND, idx);
        emit_add_imm(R_SECOND, lanes);
        load_reg_from_frame(R_ACC, idx);
        emit_frame_addr(R_ADDR, len);
        emit_load_reg(R_ADDR, R_ADDR);
        emit_panic(PANIC_RANGE_SIGNED);
        emit_label(ok);
        load_reg_from_frame(R_SECOND, ptr);
        load_reg_from_frame(R_ACC, idx);
        emit_index_addr(type_size(elem));
        store_reg_to_frame(R_ACC, ptr);
        ptr
    }
}

// The address of lane `index` (an expression) of the vector in slot
// `slot`, checked, in the accumulator.
fn gen_lane_address(slot: i64, index: i64, vt: i64) {
    let idx = gen_scalar_to_slot(index, TY_I64);
    let ok = new_label();
    load_reg_from_frame(R_ACC, idx);
    emit_load_imm(R_SECOND, vec_lanes(vt) as u64);
    emit_compare_jump(Cond::Lt, false, ok);
    emit_panic(PANIC_INDEX_SIGNED);
    emit_label(ok);
    emit_frame_addr(R_SECOND, slot);
    load_reg_from_frame(R_ACC, idx);
    emit_index_addr(lane_size(vt));
}

// The float sum of lanes lo..hi of slot a (pairwise: the sum of the first
// half plus the sum of the second), in the accumulator.
fn gen_float_sum(a: i64, elem: i64, lo: i64, hi: i64) {
    if hi - lo == 1 {
        load_lane(a, elem, lo);
        return;
    }
    let mid = lo + (hi - lo) / 2;
    gen_float_sum(a, elem, lo, mid);
    push_value(elem);
    gen_float_sum(a, elem, mid, hi);
    pop_second_operand(elem);
    emit_float_binary(Tok::Plus, elem);
}

pub fn gen_vecop(n: i64) {
    unsafe {
        let kind = NODES[n].x;
        let vt = NODES[n].y;
        let elem = vec_elem(vt);
        let lanes = vec_lanes(vt);
        if kind == VK_NEW {
            gen_aggregate(n);
            return;
        }
        if kind == VK_SPLAT {
            let r = alloc_slot(16, 16);
            gen_expr(child(n, 0));
            for i in 0..lanes {
                store_lane(r, elem, i);
            }
            emit_frame_addr(R_ACC, r);
            return;
        }
        if kind == VK_LOAD {
            let ptr = gen_vector_address(child(n, 0), child(n, 1), lanes, elem);
            let r = alloc_slot(16, 16);
            for i in 0..lanes {
                load_reg_from_frame(R_ACC, ptr);
                emit_add_imm(R_ACC, i * type_size(elem));
                emit_load(elem, R_ACC);
                store_lane(r, elem, i);
            }
            emit_frame_addr(R_ACC, r);
            return;
        }
        let a = gen_vector_to_slot(NODES[n].a);
        if kind == VK_STORE {
            let ptr = gen_vector_address(child(n, 0), child(n, 1), lanes, elem);
            for i in 0..lanes {
                load_lane(a, elem, i);
                load_reg_from_frame(R_ADDR, ptr);
                emit_add_imm(R_ADDR, i * type_size(elem));
                emit_store(elem, R_ACC, R_ADDR);
            }
            return;
        }
        if kind == VK_LANE {
            gen_lane_address(a, child(n, 0), vt);
            emit_load(elem, R_ACC);
            return;
        }
        if kind == VK_WITH {
            let addr = alloc_slot(8, 8);
            gen_lane_address(a, child(n, 0), vt);
            store_reg_to_frame(R_ACC, addr);
            let x = gen_scalar_to_slot(child(n, 1), elem);
            load_frame_scalar(elem, x);
            load_reg_from_frame(R_SECOND, addr);
            emit_store(elem, R_ACC, R_SECOND);
            emit_frame_addr(R_ACC, a);
            return;
        }
        if kind == VK_SUM {
            if is_float(elem) {
                gen_float_sum(a, elem, 0, lanes);
                return;
            }
            load_lane(a, elem, 0);
            for i in 1..lanes {
                push_value(elem);
                load_lane(a, elem, i);
                pop_second_operand(elem);
                emit_int_binary(Tok::Plus, elem);
            }
            return;
        }
        // VK_SELECT: mask a; (x & a) | (y & ~a), on the lanes' bits.
        let x = gen_vector_to_slot(child(n, 0));
        let y = gen_vector_to_slot(child(n, 1));
        let it = vec_elem(vt);
        let t = alloc_slot(8, 8);
        for i in 0..lanes {
            load_lane(a, it, i);
            emit_bitnot(it);
            push_value(it);
            load_lane(y, it, i);
            pop_second_operand(it);
            emit_int_binary(Tok::Amp, it);
            store_to_frame(it, t);
            load_lane(x, it, i);
            push_value(it);
            load_lane(a, it, i);
            pop_second_operand(it);
            emit_int_binary(Tok::Amp, it);
            push_value(it);
            load_frame_scalar(it, t);
            pop_second_operand(it);
            emit_int_binary(Tok::Pipe, it);
            store_lane(x, it, i);
        }
        emit_frame_addr(R_ACC, x);
    }
}
