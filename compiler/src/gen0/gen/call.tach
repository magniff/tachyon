// Calls (gen0): the arguments evaluated and passed by the platform's C
// convention (classified by abi.tach: registers, pieces, the stack,
// variadic arguments), compound arguments by a pointer to a copy, and the
// call itself, direct or through a pointer.

use crate::arch::intrinsic_of_fn;
use crate::back::abi::{
    AbiClass, abi_classify, abi_piece_locations, abi_stack_location, abi_variadic_piece_locations,
    return_piece_reg, returns_through_pointer, variadic_kind,
};
use crate::back::emit::machine::{arg_reg, m_load, m_store, reg_sp, xl_from_c};
use crate::base::{IntVec, free};
use crate::base::target::X86;
use crate::front::ast::{NODES, child};
use crate::front::check::type_error;
use crate::front::contracts::checks::{CHECK_FN, check_message, check_values, conjuncts, operands};
use crate::front::types::{
    FNS, TYPES, TY_BOOL, TY_U64, TY_U8, align_to, fn_param, is_compound, is_float, is_integer,
    is_void, max_i64, scalar_type, type_align, type_elem, type_size,
};
use crate::gen0::gen::{alloc_slot, alloc_slot_for, fn_symbol_prefix};
use crate::gen0::gen::arch::gen_intrinsic;
use crate::gen0::gen::checkalloc::site_before_call;
use crate::gen0::gen::expr::gen_expr;
use crate::gen0::target::{
    DEPTH, R_ACC, R_ADDR, R_RESULT, R_SECOND, arg_location, emit_call, emit_call_indirect,
    emit_copy, emit_frame_addr, emit_jump_if_nonzero, emit_label, emit_load_arg_reg,
    emit_load_callee, emit_normalize, emit_panic_site_popped, emit_sp_add, emit_sp_sub,
    emit_stack_arg, first_int_arg, message_kind, new_label, pop_x, push_value, push_x0,
    variadic_arg_location,
};
use crate::gen0::x86_64::{x64_realign_pushed, x64_restore_sp};
use crate::middle::ctx::FnCtx;
use crate::middle::lower::is_fresh;

pub fn gen_call(mut cx: *FnCtx, n: i64) {
    unsafe {
        let callee = NODES[n].a;
        let direct = NODES[n].x - 1;
        // (0.18: a contract check, front/contracts)
        if direct >= 0 && direct == CHECK_FN {
            gen_contract_check(cx, n);
            return;
        }
        // (0.19: std::arch's intrinsics)
        let intr = intrinsic_of_fn(direct);
        if intr >= 0 && gen_intrinsic(cx, n, direct, intr) {
            return;
        }
        let mut param_count = 0;
        let mut ret = 0;
        let mut variadic = false;
        let mut callee_ty = 0;
        if direct >= 0 {
            param_count = FNS[direct].param_count;
            ret = FNS[direct].ret;
            variadic = FNS[direct].variadic;
        } else {
            callee_ty = NODES[callee].ty;
            param_count = TYPES[callee_ty].count;
            ret = TYPES[callee_ty].a;
        }
        let count = NODES[n].count;
        if count > 64 {
            type_error(n, c"too many arguments (at most 64 are supported)");
        }
        // The type of each passed argument (0 for unit arguments, not passed).
        let mut arg_types: [i64; 64] = [0; 64];
        let mut pushed = 0;
        for i in 0..count {
            let arg = child(n, i);
            let mut ty = NODES[arg].ty;
            if i < param_count {
                ty = if direct >= 0 { fn_param(direct, i) } else { type_elem(callee_ty, i) };
            }
            gen_expr(cx, arg);
            if is_void(ty) {
                continue;
            }
            // A private copy, of a multiple of 8 bytes (read in pieces), unless
            // the value is a new temporary.
            if is_compound(ty) && !is_fresh(arg) {
                let copy = alloc_slot_for(ty);
                emit_frame_addr(cx, R_SECOND, copy);
                emit_copy(cx, type_size(ty));
                emit_frame_addr(cx, R_ACC, copy);
            }
            push_value(cx, ty);
            arg_types[i] = ty;
            pushed += 1;
        }
        if direct < 0 {
            gen_expr(cx, callee);
            push_x0(cx);
            pushed += 1;
        }
        // (0.16: --check-alloc's allocation site, the arguments pushed)
        site_before_call(cx, n);
        gen_call_sequence(cx, n, direct, &arg_types as *i64, count, param_count, variadic, pushed,
            ret);
    }
}

// (0.18) `std::contract_check(cond, site, check)`, as middle's
// lower_contract_check: each conjunct checked in turn; a false one calls
// the helper with its message, its shown operands (evaluated again: a
// condition is pure) and the site.
fn gen_contract_check(mut cx: *FnCtx, n: i64) {
    unsafe {
        let cond = child(n, 0);
        let site = child(n, 1);
        let check = NODES[child(n, 2)].a;
        let mut conjs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        conjuncts(cond, &mut conjs);
        let mut ops = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for k in 0..conjs.count {
            let conj = conjs.data[k];
            gen_expr(cx, conj);
            let ok = new_label(cx);
            emit_jump_if_nonzero(cx, ok);
            ops.count = 0;
            check_values(n, conj, &mut ops);
            gen_expr(cx, site);
            push_x0(cx);
            for i in 0..ops.count {
                gen_expr(cx, ops.data[i]);
                push_x0(cx);
            }
            if ops.count > 2 {
                pop_x(cx, R_ADDR);
            }
            if ops.count > 1 {
                pop_x(cx, R_SECOND);
            }
            if ops.count > 0 {
                pop_x(cx, R_ACC);
            }
            let kind = message_kind(check_message(check, conj, &ops, crate::gen0::gen::CUR_FN));
            emit_panic_site_popped(cx, kind);
            emit_label(cx, ok);
        }
        free(conjs.data as *u8);
        free(ops.data as *u8);
    }
}

// Where each argument goes (see arg_location): `locations[i]` for scalars,
// pointers to copies (AbiClass::Ref) and copies on the stack (AbiClass::Stack), the
// pieces' locations at `pieces[4 * i + k]` for aggregates in pieces;
// `kinds[i]` is the ABI kind. Returns the size of the outgoing stack area,
// and the number of float registers used in `float_regs`.
fn assign_arg_locations(mut cx: *FnCtx, arg_types: *i64, count: i64, param_count: i64,
    variadic: bool, ret: i64, locations: *i64, pieces: *i64, kinds: *AbiClass,
    float_regs: &mut i64) -> i64 {
    unsafe {
        let mut state: [i64; 3] = [first_int_arg(cx, ret), 0, 0];
        for i in 0..count {
            let ty = arg_types[i];
            if ty == 0 {
                continue;
            }
            let extra = variadic && i >= param_count;
            let kind = if extra { variadic_kind(cx, ty) } else { abi_classify(cx, ty) };
            kinds[i] = kind;
            if extra && kind == AbiClass::Pieces {
                abi_variadic_piece_locations(cx, ty, &state as *i64, &pieces[4 * i]);
            } else if extra && kind != AbiClass::Stack {
                locations[i] = variadic_arg_location(if kind == AbiClass::Ref { TY_U64 }
                    else { ty }, &state as *i64);
            } else if kind == AbiClass::Pieces {
                abi_piece_locations(cx, ty, &state as *i64, &pieces[4 * i]);
            } else if kind == AbiClass::Stack {
                locations[i] = abi_stack_location(ty, &state as *i64);
            } else {
                locations[i] = arg_location(if kind == AbiClass::Ref { TY_U64 } else { ty },
                    &state as *i64);
            }
        }
        *float_regs = state[1];
        align_to(state[2], 16)
    }
}

// Moves the pushed arguments into their registers and stack slots. The
// k-th pushed temporary is at sp + stack_size + 16 * (pushed - 1 - k); an
// aggregate's temporary holds its address (of a private copy).
fn place_args(mut cx: *FnCtx, arg_types: *i64, count: i64, param_count: i64, variadic: bool,
    locations: *i64, pieces: *i64, kinds: *AbiClass, stack_size: i64, pushed: i64) {
    unsafe {
        let scratch = if X86 { 10 } else { 16 };
        let temp_int = if X86 { 11 } else { 17 };
        let temp_float = if X86 { 40 } else { 48 };
        let mut k = 0;
        for i in 0..count {
            let ty = arg_types[i];
            if ty == 0 {
                continue;
            }
            let from = stack_size + 16 * (pushed - 1 - k);
            k += 1;
            let kind = kinds[i];
            if kind == AbiClass::Pieces {
                abi_classify(cx, ty);
                m_load(cx, TY_U64, scratch, reg_sp(), from);
                for p in 0..cx.abi_piece_count {
                    let location = pieces[4 * i + p];
                    let piece_ty = cx.abi_piece_ty[p];
                    let offset = cx.abi_piece_offset[p];
                    if location < 16 {
                        m_load(cx, piece_ty, arg_reg(xl_from_c(location)), scratch, offset);
                    } else {
                        let temp = if is_float(piece_ty) { temp_float } else { temp_int };
                        m_load(cx, piece_ty, temp, scratch, offset);
                        m_store(cx, piece_ty, temp, reg_sp(), location - 16);
                    }
                }
                continue;
            }
            let location = locations[i];
            if kind == AbiClass::Stack {
                // The aggregate's bytes, in 8-byte pieces (its copy is a
                // multiple of 8 bytes).
                m_load(cx, TY_U64, scratch, reg_sp(), from);
                let mut offset = 0;
                while offset < type_size(ty) {
                    m_load(cx, TY_U64, temp_int, scratch, offset);
                    m_store(cx, TY_U64, temp_int, reg_sp(), location - 16 + offset);
                    offset += 8;
                }
                continue;
            }
            let value_ty = if kind == AbiClass::Ref { TY_U64 } else { ty };
            let promote = variadic && i >= param_count;
            if location >= 16 {
                emit_stack_arg(cx, value_ty, from, location - 16, promote);
            } else {
                emit_load_arg_reg(cx, location, value_ty, from, promote);
            }
        }
    }
}

// Moves the pushed arguments into place, calls, and pops them. A compound
// result is in a new frame slot (through the result pointer, or stored
// from the result registers).
fn gen_call_sequence(mut cx: *FnCtx, n: i64, direct: i64, arg_types: *i64, count: i64,
    param_count: i64, variadic: bool, pushed: i64, ret: i64) {
    unsafe {
        let mut locations: [i64; 64] = [0; 64];
        let mut pieces: [i64; 256] = [0; 256];
        let mut kinds: [AbiClass; 64] = [AbiClass::Scalar; 64];
        let mut float_regs = 0;
        let stack_size = assign_arg_locations(cx, arg_types, count, param_count, variadic, ret,
            &locations as *i64, &pieces as *i64,
            &kinds as *AbiClass, &mut float_regs);
        // An aggregate aligned above 16 copied onto the stack (x86-64) must be
        // aligned there: the pushed arguments move down so that the stack area
        // is, and sp is restored from a frame slot after the call.
        let mut over = 0;
        for i in 0..count {
            if kinds[i] == AbiClass::Stack {
                let t = if arg_types[i] < 0 { 0 - arg_types[i] } else { arg_types[i] };
                over = max_i64(over, type_align(t));
            }
        }
        let mut saved_sp = 0;
        if over > 16 && X86 {
            saved_sp = alloc_slot(8, 8);
            x64_realign_pushed(cx, pushed, stack_size, over, saved_sp);
        }
        if stack_size > 0 {
            emit_sp_sub(cx, stack_size);
        }
        place_args(cx, arg_types, count, param_count, variadic, &locations as *i64, &pieces as *i64,
            &kinds as *AbiClass, stack_size, pushed);
        if direct < 0 {
            emit_load_callee(cx, stack_size);
        }
        let mut result_slot = 0;
        let through_pointer = returns_through_pointer(cx, ret);
        if is_compound(ret) {
            result_slot = alloc_slot_for(ret);
        }
        if through_pointer {
            emit_frame_addr(cx, R_RESULT, result_slot);
        }
        if direct >= 0 {
            emit_call(cx, fn_symbol_prefix(direct), FNS[direct].name,
                FNS[direct].is_extern || FNS[direct].export, variadic, float_regs);
        } else {
            emit_call_indirect(cx);
        }
        if saved_sp != 0 {
            x64_restore_sp(cx, saved_sp);
            DEPTH -= pushed;
        } else {
            emit_drop_temps_now(cx, stack_size, pushed);
        }
        if is_compound(ret) {
            if !through_pointer {
                abi_classify(cx, ret);
                emit_frame_addr(cx, R_ADDR, result_slot);
                let base = if X86 { 11 } else { 9 };
                for k in 0..cx.abi_piece_count {
                    m_store(cx, cx.abi_piece_ty[k], return_piece_reg(cx, k), base,
                        cx.abi_piece_offset[k]);
                }
            }
            emit_frame_addr(cx, R_ACC, result_slot);
        } else if is_integer(scalar_type(ret)) || ret == TY_BOOL {
            emit_normalize(cx, if ret == TY_BOOL { TY_U8 } else { ret });
        }
    }
}

fn emit_drop_temps_now(mut cx: *FnCtx, stack_size: i64, pushed: i64) {
    let total = stack_size + 16 * pushed;
    if total > 0 {
        emit_sp_add(cx, total);
    }
    DEPTH -= pushed;
}
