// --check-alloc's allocation sites in gen0 (0.16): as middle/checkalloc.tach,
// for the -O0 code generator: std::CHECK_ALLOC_SITE = the call's site,
// right before the call (its arguments are on the stack).

use crate::front::ast::NODES;
use crate::front::types::TY_U64;
use crate::gen0::gen::CUR_FN;
use crate::gen0::gen::expr::emit_static_addr;
use crate::gen0::target::{R_ACC, R_SECOND, emit_store, emit_string_addr, pop_x, push_x0};
use crate::middle::checkalloc::{needs_site, site_static, site_text};
use crate::middle::ctx::FnCtx;

// Before generating call n's call sequence: its site, when it needs one.
pub fn site_before_call(mut cx: *FnCtx, n: i64) {
    unsafe {
        if !needs_site(n, CUR_FN) {
            return;
        }
        emit_string_addr(cx, site_text(NODES[n].start));
        push_x0(cx);
        emit_static_addr(cx, site_static());
        pop_x(cx, R_SECOND);
        emit_store(cx, TY_U64, R_SECOND, R_ACC);
    }
}
