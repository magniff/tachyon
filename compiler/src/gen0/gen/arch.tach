// -O0's calls of std::arch's intrinsics (0.19, docs/design/arch.md §5.1):
// the arguments are evaluated into frame slots in order, the vector
// operands loaded into v0-v2 (xmm0-xmm2), the scalar ones into x0-x2
// (rax, rcx, rdx), and the instruction is written by the machine layer
// with those registers: its table's template (INTR) or 0.10's vector
// operation (the generic forms), as -O1 and -O2 write them; the result
// (v0/xmm0, x0/rax) is stored into a new slot (a vector) or stays in the
// accumulator. Loads and stores are checked as 0.10's v.load(s, i) and
// copy the bytes; has() and detect() are constants. (T1 may route the
// generic forms through 0.10's lane-by-lane code, to keep -O0 an
// independent oracle for them.)

use crate::arch::{
    FORM_BITS, FORM_CAST, FORM_FEAT, FORM_INTR, FORM_LOAD, FORM_STORE, FORM_VBIN, FORM_VCMP,
    FORM_VEXT, FORM_VSPLAT, INTRS, intr_param_is_const, intrinsic_is_foreign,
};
use crate::back::mc_arm64::arch::ma_intr;
use crate::back::mc_arm64::vector::{ma_vbin, ma_vcmp, ma_vext, ma_vsplat};
use crate::back::mc_x86_64::arch::mx_intr;
use crate::back::mc_x86_64::vector::{mx_vbin, mx_vcmp, mx_vext, mx_vsplat};
use crate::base::die;
use crate::base::target::X86;
use crate::front::ast::{NODES, child};
use crate::front::consteval::const_eval;
use crate::front::features::{feature_call_bit, feature_call_value};
use crate::front::lexer::Tok;
use crate::front::types::{
    FNS, SYM_PRIMITIVE, TYPES, TY_U64, is_compound, is_float, is_vector, is_void, type_size,
};
use crate::gen0::gen::{alloc_slot, fn_symbol_prefix, load_reg_from_frame, store_reg_to_frame};
use crate::gen0::gen::expr::gen_expr;
use crate::gen0::gen::vector::{gen_vector_address, gen_vector_to_slot};
use crate::gen0::target::{
    R_ACC, R_ADDR, R_SECOND, emit_call, emit_copy, emit_frame_addr, emit_int_binary, emit_load_imm,
    emit_normalize, emit_store, ins, o, oi, on,
};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Cond, Op};

// The registers the operands and the result take: vector k in 32 + k,
// scalar k in k (x0-x2 / rax rcx rdx: the machine layer's numbers).
const VREG: i64 = 32;

// Call n of intrinsic id (its declaration is function f) into the
// accumulator (a vector's slot address); false for a call left to
// gen_call (a bits.* intrinsic: its body is called).
pub fn gen_intrinsic(mut cx: *FnCtx, n: i64, f: i64, id: i64) -> bool {
    unsafe {
        let ret = FNS[f].ret;
        let form = INTRS[id].form;
        if form == FORM_BITS {
            return false;
        }
        if intrinsic_is_foreign(id) {
            // (dead: under a constant-false has/detect; T2 makes the rest
            // errors)
            if X86 { ins(cx, c"ud2"); } else { ins(cx, c"brk #1"); }
            if is_compound(ret) {
                emit_frame_addr(cx, R_ACC, alloc_slot(type_size(ret), 16));
            }
            return true;
        }
        if form == FORM_FEAT {
            let value = feature_call_value(n);
            let word = crate::back::isel::arch::arch_std_fn(false);
            if value >= 0 || word < 0 {
                emit_load_imm(cx, R_ACC, if value > 0 { 1 } else { 0 });
                return true;
            }
            // (0.19 T3) tested at run time: std's word (filled by main's
            // first call, or by this one in a library), then its bit
            emit_call(cx, fn_symbol_prefix(word), FNS[word].name, false, false, 0);
            emit_load_imm(cx, R_SECOND, feature_call_bit(n) as u64);
            emit_int_binary(cx, Tok::Shr, TY_U64);
            emit_load_imm(cx, R_SECOND, 1);
            emit_int_binary(cx, Tok::Amp, TY_U64);
            return true;
        }
        if form == FORM_LOAD || form == FORM_STORE {
            let s = INTRS[id].mem_param;
            let arg = child(n, s);
            // (0.19 T1: a raw:: pointer form has no index: the pointer, then
            // the vector to store)
            let raw = FNS[f].param_count < INTRS[id].nparams;
            let mut ptr = 0;
            if raw {
                ptr = alloc_slot(8, 8);
                gen_expr(cx, arg);
                store_reg_to_frame(cx, R_ACC, ptr);
            } else {
                let elem = TYPES[NODES[arg].ty].a;
                let count = INTRS[id].mem_bytes / type_size(elem);
                ptr = gen_vector_address(cx, arg, child(n, s + 1), count, elem);
            }
            let bytes = INTRS[id].mem_bytes;
            if form == FORM_LOAD {
                let r = alloc_slot(bytes, 16);
                load_reg_from_frame(cx, R_ACC, ptr);
                emit_frame_addr(cx, R_SECOND, r);
                emit_copy(cx, bytes);
                emit_frame_addr(cx, R_ACC, r);
            } else {
                let v = gen_vector_to_slot(cx, child(n, if raw { s + 1 } else { s + 2 }));
                load_reg_from_frame(cx, R_SECOND, ptr);
                emit_frame_addr(cx, R_ACC, v);
                emit_copy(cx, bytes);
            }
            return true;
        }
        if form == FORM_CAST {
            let v = gen_vector_to_slot(cx, child(n, 0));
            emit_frame_addr(cx, R_ACC, v);
            return true;
        }
        // The operands into slots, in order; the immediates' values.
        let count = INTRS[id].nparams;
        let mut slots: [i64; 8] = [0; 8];
        let mut imms: [i64; 8] = [0; 8];
        let mut regs: [i64; 8] = [-1; 8];
        for k in 0..count {
            let e = child(n, k);
            if intr_param_is_const(id, k) {
                imms[k] = const_eval(e);
            } else if is_vector(NODES[e].ty) {
                slots[k] = gen_vector_to_slot(cx, e);
            } else if is_float(NODES[e].ty) {
                // (a float in the float accumulator, d0/xmm0)
                let slot = alloc_slot(8, 8);
                gen_expr(cx, e);
                emit_frame_addr(cx, R_ADDR, slot);
                emit_store(cx, NODES[e].ty, R_ACC, R_ADDR);
                slots[k] = slot;
            } else {
                // (the canonical 64 bits)
                let slot = alloc_slot(8, 8);
                gen_expr(cx, e);
                store_reg_to_frame(cx, R_ACC, slot);
                slots[k] = slot;
            }
        }
        // ... then into their registers.
        for k in 0..count {
            let e = child(n, k);
            if intr_param_is_const(id, k) {
                continue;
            }
            let ty = NODES[e].ty;
            regs[k] = if is_vector(ty) || is_float(ty) { VREG + k } else { k };
            emit_frame_addr(cx, R_ADDR, slots[k]);
            load_register(cx, regs[k], ty);
        }
        let vector_result = is_vector(ret);
        // (a float result in v0: the float accumulator's d0/s0)
        let d = if vector_result || is_float(ret) { VREG } else { 0 };
        let work = if INTRS[id].work != 0 { SYM_PRIMITIVE[INTRS[id].work] } else { ret };
        if form == FORM_INTR {
            if X86 { mx_intr(cx, id, d, regs[..], imms[..]); }
            else { ma_intr(cx, id, d, regs[..], imms[..]); }
        } else if form == FORM_VSPLAT {
            if X86 { mx_vsplat(cx, work, d, regs[0]); } else { ma_vsplat(cx, work, d, regs[0]); }
        } else if form == FORM_VEXT {
            let vt = NODES[child(n, 0)].ty;
            if X86 { mx_vext(cx, vt, d, regs[0], imms[1]); }
            else { ma_vext(cx, vt, d, regs[0], imms[1]); }
        } else if form == FORM_VBIN {
            let raw = INTRS[id].form_arg;
            let op = raw as Op;
            if X86 { mx_vbin(cx, op, work, d, regs[0], regs[1]); }
            else { ma_vbin(cx, op, work, d, regs[0], regs[1]); }
        } else if form == FORM_VCMP {
            let raw = INTRS[id].form_arg;
            let cond = raw as Cond;
            if X86 { mx_vcmp(cx, cond, work, d, regs[0], regs[1]); }
            else { ma_vcmp(cx, cond, work, d, regs[0], regs[1]); }
        } else {
            die(c"internal error: an intrinsic of a form not generated yet at -O0 (0.19 Phase 0)");
        }
        if vector_result {
            let r = alloc_slot(type_size(ret), 16);
            emit_frame_addr(cx, R_ADDR, r);
            store_register(cx, VREG, ret);
            emit_frame_addr(cx, R_ACC, r);
        } else if !is_void(ret) && !is_float(ret) {
            emit_normalize(cx, ret);
        }
        true
    }
}

// Register r (the machine layer's number) = the value of type ty at the
// address in R_ADDR (x9 / r11).
fn load_register(mut cx: *FnCtx, r: i64, ty: i64) {
    unsafe {
        let size = type_size(ty);
        if X86 {
            o(cx, if r
                >= 32 {
                if size == 16 { c"    movups (%r11), %xmm" } else { c"    movsd (%r11), %xmm" }
            }
                else { c"    movq (%r11), " });
            if r >= 32 {
                oi(cx, r - 32);
            } else {
                o(cx, if r == 0 { c"%rax" } else if r == 1 { c"%rcx" } else { c"%rdx" });
            }
            on(cx);
            return;
        }
        o(cx, c"    ldr ");
        if r >= 32 {
            o(cx, if size == 16 { c"q" } else if size == 4 { c"s" } else { c"d" });
            oi(cx, r - 32);
        } else {
            o(cx, c"x");
            oi(cx, r);
        }
        o(cx, c", [x9]");
        on(cx);
    }
}

// The value of type ty in register r into the memory at R_ADDR.
fn store_register(mut cx: *FnCtx, r: i64, ty: i64) {
    unsafe {
        let size = type_size(ty);
        if X86 {
            o(cx, if size == 16 { c"    movups %xmm" } else { c"    movsd %xmm" });
            oi(cx, r - 32);
            o(cx, c", (%r11)");
            on(cx);
            return;
        }
        o(cx, if size == 16 { c"    str q" } else { c"    str d" });
        oi(cx, r - 32);
        o(cx, c", [x9]");
        on(cx);
    }
}
