// Control flow (gen0): match (the scrutinee once, then each arm's pattern
// tested in order), if, and the loops (`loop`, `while`, `for`) with their
// labels for break and continue.

use crate::base::IntVec;
use crate::front::ast::{NODES, child, defer_loop_enter, defer_loop_leave, kids};
use crate::front::ast::NodeKind::{
    PatBind, PatLit, PatOr, PatRange, PatTuple, PatVariant, PatWild, While,
};
use crate::front::check::LOCALS;
use crate::front::consteval::wrap_int;
use crate::front::distinct::enum_niche;
use crate::front::patterns::{binds_ref, pattern_referent};
use crate::front::types::{
    ENUMS, TYPES, TY_NEVER, TY_U64, VARIANTS, is_compound, is_signed, is_void, scalar_type,
    tuple_offset, type_elem, variant_field, variant_field_offset,
};
use crate::gen0::gen::{
    alloc_slot, alloc_slot_for, bind, gen_block, load_from_x0, load_reg_from_frame,
    store_reg_to_frame, store_to_frame,
};
use crate::gen0::gen::expr::gen_expr;
use crate::gen0::target::{
    DEPTH, R_ACC, R_SECOND, emit_add_imm, emit_compare_jump, emit_drop_temps, emit_frame_addr,
    emit_jump, emit_jump_if_zero, emit_label, emit_load, emit_load_imm, new_label,
};
use crate::middle::ir::Cond;

// The temporaries depth at the start of each loop, by its continue label.
static mut LABEL_DEPTH: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// ---- match ----

// Sequential tests in arm order: the scrutinee is evaluated once (a
// compound one stays where it is: its address is kept), every arm's
// pattern is tested in order, its bindings copied, its guard evaluated.
pub fn gen_match(n: i64) {
    unsafe {
        let scrutinee = NODES[n].a;
        let st = NODES[scrutinee].ty;
        gen_expr(scrutinee);
        if st == TY_NEVER {
            return;
        }
        let held = alloc_slot(8, 8);
        if is_compound(st) {
            store_reg_to_frame(R_ACC, held);
        } else {
            store_to_frame(st, held);
        }
        let end = new_label();
        for arm in kids(n) {
            let next = new_label();
            alloc_pattern_slots(NODES[arm].a);
            gen_pattern_test(NODES[arm].a, st, held, next);
            if NODES[arm].b != 0 {
                gen_expr(NODES[arm].b);
                emit_jump_if_zero(next);
            }
            gen_expr(NODES[arm].c);
            emit_jump(end);
            emit_label(next);
        }
        emit_label(end);
    }
}

// Frame slots for the locals a pattern binds (once: the alternatives of an
// or-pattern bind the same locals).
fn alloc_pattern_slots(p: i64) {
    unsafe {
        let kind = NODES[p].kind;
        if kind == PatBind {
            let local = NODES[p].x;
            if LOCALS[local].offset == 0 {
                LOCALS[local].offset = alloc_slot_for(LOCALS[local].ty);
            }
            return;
        }
        if kind == PatTuple || kind == PatVariant || kind == PatOr {
            for c in kids(p) {
                alloc_pattern_slots(c);
            }
        }
    }
}

// Jumps to `fail` unless the value of type `ty` in frame slot `held` (the
// address of a compound value) matches pattern p; binds its variables.
fn gen_pattern_test(p: i64, ty: i64, held: i64, fail: i64) {
    unsafe {
        let kind = NODES[p].kind;
        if ty == TY_NEVER {
            return;
        }
        let inner = pattern_referent(p, ty);
        if inner != 0 {
            // (0.18.1) `held` holds a reference: the pattern matches what it
            // points to (a compound one stays where it is)
            let inner_held = alloc_slot(8, 8);
            load_reg_from_frame(R_ACC, held);
            if is_compound(inner) {
                store_reg_to_frame(R_ACC, inner_held);
            } else if !is_void(inner) {
                emit_load(inner, R_ACC);
                store_to_frame(inner, inner_held);
            }
            gen_pattern_test(p, inner, inner_held, fail);
            return;
        }
        match kind {
            PatWild => return,
            PatBind => {
                if binds_ref(p) {
                    // (held: the address of what it binds)
                    load_reg_from_frame(R_ACC, held);
                    store_reg_to_frame(R_ACC, LOCALS[NODES[p].x].offset);
                    return;
                }
                if !is_void(ty) {
                    load_held(ty, held);
                    store_to_frame(ty, LOCALS[NODES[p].x].offset);
                }
                return;
            }
            PatLit => {
                load_held(ty, held);
                emit_load_imm(R_SECOND, NODES[p].x as u64);
                emit_compare_jump(Cond::Ne, is_signed(scalar_type(ty)), fail);
                return;
            }
            PatRange => {
                let signed = is_signed(scalar_type(ty));
                load_held(ty, held);
                emit_load_imm(R_SECOND, NODES[p].x as u64);
                emit_compare_jump(Cond::Lt, signed, fail);
                emit_load_imm(R_SECOND, NODES[p].y as u64);
                emit_compare_jump(Cond::Gt, signed, fail);
                return;
            }
            PatOr => {
                let ok = new_label();
                let last = NODES[p].count - 1;
                for i in 0..last {
                    let next = new_label();
                    gen_pattern_test(child(p, i), ty, held, next);
                    emit_jump(ok);
                    emit_label(next);
                }
                gen_pattern_test(child(p, last), ty, held, fail);
                emit_label(ok);
                return;
            }
            PatVariant => {
                let v = NODES[p].x;
                let tag = ENUMS[TYPES[ty].a].tag;
                if enum_niche(TYPES[ty].a) {
                    // (0.18: the null niche: null or not)
                    load_reg_from_frame(R_ACC, held);
                    emit_load(TY_U64, R_ACC);
                    emit_load_imm(R_SECOND, 0);
                    emit_compare_jump(if VARIANTS[v].field_count == 1 { Cond::Eq }
                        else { Cond::Ne },
                        false, fail);
                } else {
                    if is_compound(ty) {
                        load_reg_from_frame(R_ACC, held);
                        emit_load(tag, R_ACC);
                    } else {
                        load_held(ty, held);
                    }
                    emit_load_imm(R_SECOND, wrap_int(VARIANTS[v].discr, tag) as u64);
                    emit_compare_jump(Cond::Ne, is_signed(tag), fail);
                }
            }
            _ => {}
        }
        // The elements of a tuple, the fields of a variant.
        for i in 0..NODES[p].count {
            let sub = child(p, i);
            if NODES[sub].kind == PatWild {
                continue;
            }
            let mut elem_ty = 0;
            let mut offset = 0;
            if kind == PatVariant {
                elem_ty = variant_field(NODES[p].x, i);
                offset = variant_field_offset(NODES[p].x, i);
            } else {
                elem_ty = type_elem(ty, i);
                offset = tuple_offset(ty, i);
            }
            let elem_held = alloc_slot(8, 8);
            load_reg_from_frame(R_ACC, held);
            emit_add_imm(R_ACC, offset);
            if is_compound(elem_ty) || binds_ref(sub) {
                store_reg_to_frame(R_ACC, elem_held);
            } else if !is_void(elem_ty) {
                emit_load(elem_ty, R_ACC);
                store_to_frame(elem_ty, elem_held);
            }
            gen_pattern_test(sub, elem_ty, elem_held, fail);
        }
    }
}

// The accumulator = the value held in frame slot `held` (the address of a
// compound value).
fn load_held(ty: i64, held: i64) {
    if is_compound(ty) {
        load_reg_from_frame(R_ACC, held);
    } else {
        emit_frame_addr(R_ACC, held);
        load_from_x0(ty);
    }
}

// ---- Control flow ----

pub fn gen_if(n: i64) {
    unsafe {
        let else_label = new_label();
        let end_label = new_label();
        gen_expr(NODES[n].a);
        emit_jump_if_zero(else_label);
        gen_block(NODES[n].b);
        if NODES[n].c != 0 {
            emit_jump(end_label);
            emit_label(else_label);
            gen_block(NODES[n].c);
            emit_label(end_label);
        } else {
            emit_label(else_label);
        }
    }
}

fn new_loop_labels(n: i64, count: i64) -> i64 {
    unsafe {
        let first = new_label();
        for _ in 1..count {
            new_label();
        }
        NODES[n].z = first;
        while LABEL_DEPTH.count <= first {
            LABEL_DEPTH.push(0);
        }
        LABEL_DEPTH.data[first] = DEPTH;
        first
    }
}

// `loop` and `while`.
pub fn gen_loop(n: i64) {
    unsafe {
        let top = new_loop_labels(n, 2);
        emit_label(top);
        if NODES[n].kind == While {
            gen_expr(NODES[n].b);
            emit_jump_if_zero(top + 1);
            defer_loop_enter(n);
            gen_block(NODES[n].c);
        } else {
            defer_loop_enter(n);
            gen_block(NODES[n].b);
        }
        defer_loop_leave();
        emit_jump(top);
        emit_label(top + 1);
    }
}

// `for i in a..b`: the bounds are evaluated once; the loop variable is a
// copy of the counter.
pub fn gen_for(n: i64) {
    unsafe {
        let range = NODES[n].c;
        let ty = NODES[range].ty;
        let inclusive = NODES[range].c != 0;
        let counter = alloc_slot(8, 8);
        let end = alloc_slot(8, 8);
        gen_expr(NODES[range].a);
        store_reg_to_frame(R_ACC, counter);
        gen_expr(NODES[range].b);
        store_reg_to_frame(R_ACC, end);
        let labels = new_loop_labels(n, 3);
        let next = labels;
        let exit = labels + 1;
        let test = labels + 2;
        emit_label(test);
        load_counter_and_end(counter, end);
        emit_compare_jump(if inclusive { Cond::Gt } else { Cond::Ge }, is_signed(ty), exit);
        bind(NODES[n].b);
        defer_loop_enter(n);
        gen_block(NODES[n].d);
        defer_loop_leave();
        emit_label(next);
        load_counter_and_end(counter, end);
        if inclusive {
            emit_compare_jump(Cond::Eq, is_signed(ty), exit);
        }
        emit_add_imm(R_ACC, 1);
        store_reg_to_frame(R_ACC, counter);
        emit_jump(test);
        emit_label(exit);
    }
}

// The accumulator = the counter, the second operand = the end.
fn load_counter_and_end(counter: i64, end: i64) {
    load_reg_from_frame(R_SECOND, end);
    load_reg_from_frame(R_ACC, counter);
}

// `break` (to_end 1) or `continue` (to_end 0) out of loop `lp`.
pub fn jump_out_to_loop(lp: i64, to_end: i64) {
    unsafe {
        let label = NODES[lp].z;
        emit_drop_temps(DEPTH - LABEL_DEPTH.data[label]);
        emit_jump(label + to_end);
    }
}
