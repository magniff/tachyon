static mut FRAME_SIZE: i64 = 0;
static mut RETURN_LABEL: i64 = 0;
// Frame slot holding the result pointer of a function returning a
// compound value.
static mut RESULT_SLOT: i64 = 0;
static mut CUR_FN: i64 = 0;
pub static mut MAIN_SYM: i64 = 0;
// --emit-ir: print the optimized IR instead of assembly.
pub static mut EMIT_IR: bool = false;
// --emit-mir: the IR after instruction selection (isel.tach).
pub static mut EMIT_MIR: bool = false;

// Slots aligned above 16 (offset, alignment, size triples): the frame
// pointer is only 16-aligned, so their address is rounded up at run time,
// inside room left for it (see emit_frame_addr).
pub static mut OVERALIGNED: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// A new frame slot; returns its offset below the frame pointer.
fn alloc_slot(size: i64, align: i64) -> i64 {
    let mut a = align;
    if a < 1 {
        a = 1;
    }
    if a > 16 {
        FRAME_SIZE = align_to(FRAME_SIZE + size + a - 16, 16);
        OVERALIGNED.push(FRAME_SIZE);
        OVERALIGNED.push(a);
        OVERALIGNED.push(size);
        return FRAME_SIZE;
    }
    FRAME_SIZE = align_to(FRAME_SIZE + size, a);
    FRAME_SIZE
}

// The slot aligned above 16 holding frame offset `offset` (the offset of
// a slot, or of a field inside one: `slot - field`), as its index in
// OVERALIGNED, or -1.
pub fn overaligned_slot(offset: i64) -> i64 {
    unsafe {
        let mut i = 0;
        while i < OVERALIGNED.count {
            let slot = OVERALIGNED.data[i];
            if offset <= slot && offset > slot - OVERALIGNED.data[i + 2] {
                return i;
            }
            i += 3;
        }
        -1
    }
}

// A frame slot for a value of type `ty`; compound values get a multiple
// of 8 bytes, so that they can be read and written in 8-byte pieces.
fn alloc_slot_for(ty: i64) -> i64 {
    let size = if is_compound(ty) { align_to(type_size(ty), 8) } else { type_size(ty) };
    alloc_slot(size, type_align(ty))
}

pub fn fn_symbol_prefix(f: i64) -> *u8 {
    if unsafe { FNS[f].is_extern || FNS[f].export || FNS[f].name == MAIN_SYM } { global_prefix() } else { function_prefix() }
}

// Whether function f has a global (C-visible) symbol.
pub fn fn_is_global(f: i64) -> bool {
    unsafe { FNS[f].name == MAIN_SYM || FNS[f].export }
}

pub fn static_symbol_prefix(s: i64) -> *u8 {
    if unsafe { STATICS[s].linkage != 0 } { global_prefix() } else { static_prefix() }
}

// ---- The program ----

pub fn compile_program(output: *u8) {
    unsafe {
        let mut t = timer_now();
        init_ast();
        ERR_KIND = c"parser error";
        let program = parse_program();
        if IMPORTED_START >= 0 {
            drop_shadowed_imports(program);
        }
        timer_add(T_PARSE, t);
        t = timer_now();
        MAIN_SYM = intern_c(c"main");
        init_types();
        init_declarations();
        ERR_KIND = c"type error";
        check_program(program);
        timer_add(T_CHECK, t);
        flush_warnings();
        if EMIT_HEADER {
            emit_c_header(program, output);
            return;
        }
        ASM = buf_new();
        DATA = buf_new();
        CODE = buf_new();
        if OPT_LEVEL > 0 || EMIT_IR {
            t = timer_now();
            lower_program(program);
            // (0.10: profiles, on the IR as lowered)
            profile_after_lowering();
            flush_warnings();
            timer_add(T_LOWER, t);
            optimize_program();
            if EMIT_IR {
                for fi in 0..IRFUNC_COUNT {
                    if FN_LIVE[fi] != 0 {
                        print_ir_func(ASM, fi);
                    }
                }
                buf_write_file(ASM, output);
                return;
            }
            t = timer_now();
            select_instructions();
            timer_add(T_ISEL, t);
            if EMIT_MIR {
                for fi in 0..IRFUNC_COUNT {
                    if FN_LIVE[fi] != 0 {
                        print_ir_func(ASM, fi);
                    }
                }
                buf_write_file(ASM, output);
                return;
            }
            count_uses();
        }
        t = timer_now();
        emit_file_header();
        if OPT_LEVEL > 0 {
            for fi in 0..IRFUNC_COUNT {
                if FN_LIVE[fi] != 0 {
                    gen_ir_function(fi);
                }
            }
            print_stats();
        } else {
            for i in 0..NODES[program].count {
                let item = child(program, i);
                if NODES[item].kind == Fn {
                    gen_function(item);
                }
            }
        }
        timer_add(T_CODEGEN, t);
        t = timer_now();
        emit_runtime();
        dbg_text_end();
        gen_data();
        buf_bytes(ASM, buf_slice(DATA));
        if DEBUG_INFO {
            let producer = buf_new();
            buf_str(producer, c"tachyonc ");
            buf_str(producer, version());
            buf_byte(producer, 0);
            dbg_sections(FILES[0].path, BUFS[producer].data);
        }
        emit_file_trailer();
        dbg_place_locs();
        write_output(output);
        timer_add(T_OUTPUT, t);
        timer_report();
    }
}

fn gen_data() {
    unsafe {
        data_section(false);
        for id in 0..STR_COUNT {
            data_string(id);
        }
        let scratch = buf_new();
        for s in 0..STATIC_COUNT {
            let item = STATICS[s].node;
            let ty = STATICS[s].ty;
            if STATICS[s].linkage == 1 {
                // Defined in C.
                continue;
            }
            buf_clear(scratch);
            let init = NODES[item].c;
            if NODES[init].kind == CStr {
                // A C string (0.4): the address of its bytes. (In the
                // writable section: the address is relocated at load time.)
                data_section(true);
                data_align(8);
                if STATICS[s].linkage == 2 {
                    buf_str(DATA, c".globl ");
                    buf_str(DATA, global_prefix());
                    buf_bytes(DATA, SYMS[NODES[item].a].text);
                    buf_byte(DATA, '\n');
                }
                data_label(static_symbol_prefix(s), NODES[item].a);
                buf_str(DATA, c"    .quad ");
                buf_str(DATA, local_prefix());
                buf_str(DATA, c"str.");
                buf_int(DATA, NODES[init].a);
                buf_byte(DATA, '\n');
                continue;
            }
            const_emit(init, ty, scratch);
            // (with addresses in it, in the writable section: relocated at
            // load time)
            let relocs = CONST_RELOCS.count > 0;
            data_section(STATICS[s].mutable || relocs);
            data_align(type_align(ty));
            if STATICS[s].linkage == 2 {
                buf_str(DATA, c".globl ");
                buf_str(DATA, global_prefix());
                buf_bytes(DATA, SYMS[NODES[item].a].text);
                buf_byte(DATA, '\n');
            }
            data_label(static_symbol_prefix(s), NODES[item].a);
            let bytes = buf_slice(scratch);
            let mut done = 0;
            let mut r = 0;
            while r < CONST_RELOCS.count {
                let at = CONST_RELOCS.data[r];
                data_bytes(bytes[done..at]);
                buf_str(DATA, c"    .quad ");
                buf_str(DATA, local_prefix());
                buf_str(DATA, c"str.");
                buf_int(DATA, CONST_RELOCS.data[r + 1]);
                buf_byte(DATA, '\n');
                done = at + 8;
                r += 2;
            }
            data_bytes(bytes[done..bytes.len]);
            if BUFS[scratch].len == 0 {
                buf_str(DATA, c"    .space 1\n");
            }
        }
    }
}

// ---- Functions ----

fn gen_function(item: i64) {
    unsafe {
        let f = NODES[item].x - 1;
        CUR_FN = f;
        DEFERS.count = 0;
        DEFER_LOOPS.count = 0;
        buf_clear(CODE);
        DEPTH = 0;
        FRAME_SIZE = 0;
        OVERALIGNED.count = 0;
        RETURN_LABEL = new_label();
        STMT_POS = -1;
        dbg_function_begin(f, fn_symbol_prefix(f), NODES[item].start);
        emit_function_start(fn_symbol_prefix(f), FNS[f].name, fn_is_global(f));
        let ret = FNS[f].ret;
        RESULT_SLOT = 0;
        if returns_through_pointer(ret) {
            RESULT_SLOT = alloc_slot(8, 8);
            emit_frame_addr(R_ADDR, RESULT_SLOT);
            emit_store(TY_U64, R_RESULT, R_ADDR);
        }
        gen_params(item, f);
        let body = NODES[item].c;
        gen_block(body);
        if NODES[body].ty != TY_NEVER {
            gen_return_value(ret);
        }
        emit_label(RETURN_LABEL);
        if is_void(ret) && FNS[f].name == MAIN_SYM {
            // `main` without a result exits with 0.
            emit_load_imm(R_ACC, 0);
        }
        emit_epilogue();
        emit_frame_reserve(FRAME_SIZE);
        buf_bytes(ASM, buf_slice(CODE));
        dbg_function_end();
    }
}

// (-g) The position of the statement being generated (-1: none).
static mut STMT_POS: i64 = -1;

// (-g) Starts the code of the statement at `pos`.
fn stmt_loc(pos: i64) {
    STMT_POS = pos;
    dbg_loc(CODE, pos);
}

// Stores the incoming parameters in their frame slots, in order (so a
// register is saved before another parameter's move can reuse it).
// Aggregates in registers are stored piece by piece; those passed by
// reference or on the stack are copied once every register is saved.
fn gen_params(item: i64, f: i64) {
    unsafe {
        let mut state: [i64; 3] = [first_int_arg(FNS[f].ret), 0, 0];
        let mut pending: [i64; 64] = [0; 64];
        let mut pending_count = 0;
        let mut pieces: [i64; 4] = [0; 4];
        for i in 0..FNS[f].param_count {
            let ty = fn_param(f, i);
            if is_void(ty) {
                continue;
            }
            let kind = abi_classify(ty);
            let local = NODES[child(item, i)].x;
            if kind == AbiClass::Pieces {
                abi_piece_locations(ty, &state as *i64, &pieces as *i64);
                if local < 0 {
                    continue;
                }
                let slot = alloc_slot_for(ty);
                LOCALS[local].offset = slot;
                for k in 0..ABI_PIECE_COUNT {
                    // On x86-64 a piece on the stack is copied as an integer of
                    // its size: through the float accumulator it would
                    // overwrite the first float argument register (xmm0),
                    // which a later parameter may still be in. Not on AArch64,
                    // whose int accumulator is x0, the first int argument
                    // register (an HFA on the stack, after the float registers
                    // ran out, may come before int parameters still in
                    // registers); its float registers are all taken by earlier
                    // parameters then.
                    let mut piece_ty = ABI_PIECE_TY[k];
                    if X86 && pieces[k] >= 16 && is_float(piece_ty) {
                        piece_ty = if piece_ty == TY_F32 { TY_U32 } else { TY_U64 };
                    }
                    emit_load_param(pieces[k], piece_ty);
                    store_to_frame(piece_ty, slot - ABI_PIECE_OFFSET[k]);
                }
                continue;
            }
            let mut location = 0;
            if kind == AbiClass::Stack {
                location = abi_stack_location(ty, &state as *i64);
            } else {
                location = arg_location(if kind == AbiClass::Ref { TY_U64 } else { ty }, &state as *i64);
            }
            if local < 0 {
                continue;
            }
            let slot = alloc_slot_for(ty);
            LOCALS[local].offset = slot;
            if kind == AbiClass::Scalar {
                emit_load_param(location, ty);
                emit_frame_addr(R_ADDR, slot);
                emit_store(ty, R_ACC, R_ADDR);
                continue;
            }
            // The accumulator = the address of the caller's copy.
            if kind == AbiClass::Stack {
                m_lea(0, reg_fp(), location);
            } else {
                emit_load_param(location, TY_U64);
            }
            let pointer_slot = alloc_slot(8, 8);
            emit_frame_addr(R_ADDR, pointer_slot);
            emit_store(TY_U64, R_ACC, R_ADDR);
            pending[pending_count] = local;
            pending[pending_count + 1] = pointer_slot;
            pending_count += 2;
        }
        let mut i = 0;
        while i < pending_count {
            let local = pending[i];
            emit_frame_addr(R_ADDR, pending[i + 1]);
            emit_load_reg(R_ACC, R_ADDR);
            emit_frame_addr(R_SECOND, LOCALS[local].offset);
            emit_copy(type_size(LOCALS[local].ty));
            i += 2;
        }
    }
}

// The accumulator holds the function's result: hand it to the caller (in
// registers, or copied through the result pointer, which x86-64 also
// returns in rax).
fn gen_return_value(ret: i64) {
    if !is_compound(ret) {
        return;
    }
    if returns_through_pointer(ret) {
        emit_frame_addr(R_ADDR, RESULT_SLOT);
        emit_load_reg(R_SECOND, R_ADDR);
        emit_copy(type_size(ret));
        if X86 {
            load_reg_from_frame(R_ACC, RESULT_SLOT);
        }
        return;
    }
    let size = type_size(ret);
    if size % 8 != 0 {
        // Read in whole pieces from a copy of a multiple of 8 bytes.
        let copy = alloc_slot_for(ret);
        emit_frame_addr(R_SECOND, copy);
        emit_copy(size);
        emit_frame_addr(R_ACC, copy);
    }
    abi_classify(ret);
    // The address moves out of the accumulator (a result register).
    let base = if X86 { 11 } else { 16 };
    m_mov(base, 0, TY_U64);
    for k in 0..ABI_PIECE_COUNT {
        m_load(ABI_PIECE_TY[k], return_piece_reg(k), base, ABI_PIECE_OFFSET[k]);
    }
}

// ---- Statements ----

fn gen_block(block: i64) {
    unsafe {
        let mark = DEFERS.count;
        // (-g) After the block, the code is the enclosing statement's again.
        let outer = STMT_POS;
        for i in 0..NODES[block].count {
            let stmt = child(block, i);
            if DEBUG_INFO {
                stmt_loc(NODES[stmt].start);
            }
            if NODES[stmt].kind == Let {
                gen_expr(NODES[stmt].c);
                bind(NODES[stmt].a);
            } else if NODES[stmt].kind == Defer {
                DEFERS.push(stmt);
            } else {
                gen_expr(NODES[stmt].a);
            }
        }
        let tail = NODES[block].a;
        if tail != 0 {
            if DEBUG_INFO {
                stmt_loc(NODES[tail].start);
            }
            gen_expr(tail);
        }
        if DEFERS.count > mark {
            gen_defers(mark, if tail != 0 { NODES[tail].ty } else { TY_UNIT });
            DEFERS.count = mark;
        }
        if DEBUG_INFO && outer >= 0 {
            stmt_loc(outer);
        }
        STMT_POS = outer;
    }
}

// Runs the deferred statements registered above DEFERS depth `depth`, last
// first (0.6), keeping the accumulator's value of type `ty` (a compound
// one is copied first, so a deferred statement cannot change it).
fn gen_defers(depth: i64, ty: i64) {
    if DEFERS.count <= depth {
        return;
    }
    let keep = !is_void(ty) && ty != TY_NEVER;
    let mut slot = 0;
    if keep {
        slot = alloc_slot_for(ty);
        store_to_frame(ty, slot);
    }
    let mut i = DEFERS.count - 1;
    while i >= depth {
        unsafe { gen_expr(NODES[DEFERS.data[i]].a); }
        i -= 1;
    }
    if keep {
        emit_frame_addr(R_ACC, slot);
        load_from_x0(ty);
    }
}

// Stores the accumulator (of type `ty`) in the frame slot at `offset`.
fn store_to_frame(ty: i64, offset: i64) {
    if is_void(ty) {
        return;
    }
    if is_compound(ty) {
        emit_frame_addr(R_SECOND, offset);
        emit_copy(type_size(ty));
        return;
    }
    emit_frame_addr(R_ADDR, offset);
    emit_store(ty, R_ACC, R_ADDR);
}

// Binds a pattern to the value in the accumulator (of the pattern's type).
fn bind(pattern: i64) {
    unsafe {
        let kind = NODES[pattern].kind;
        let ty = NODES[pattern].ty;
        if kind == PatWild || ty == TY_NEVER {
            return;
        }
        if kind == PatBind {
            let local = NODES[pattern].x;
            let slot = alloc_slot_for(ty);
            LOCALS[local].offset = slot;
            store_to_frame(ty, slot);
            return;
        }
        if NODES[pattern].count == 0 {
            return;
        }
        // A tuple, or the only variant of an enum: the accumulator is its
        // address.
        push_x0();
        for i in 0..NODES[pattern].count {
            let mut elem_ty = 0;
            let mut offset = 0;
            if kind == PatVariant {
                elem_ty = variant_field(NODES[pattern].x, i);
                offset = variant_field_offset(NODES[pattern].x, i);
            } else {
                elem_ty = type_elem(ty, i);
                offset = tuple_offset(ty, i);
            }
            emit_peek(R_ACC);
            emit_add_imm(R_ACC, offset);
            if !is_compound(elem_ty) && !is_void(elem_ty) {
                emit_load(elem_ty, R_ACC);
            }
            bind(child(pattern, i));
        }
        pop_x(R_ACC);
    }
}

// ---- Values: the accumulator, temporaries, frame slots ----

// The accumulator holds the address of a value of type `ty`: load it if it
// is a scalar.
fn load_from_x0(ty: i64) {
    if !is_compound(ty) && !is_void(ty) {
        emit_load(ty, R_ACC);
    }
}

// Moves the accumulator to the second operand and pops the first one into
// the accumulator.
fn pop_second_operand(ty: i64) {
    emit_move_to_second(ty);
    if is_float(ty) {
        pop_d(0);
    } else {
        pop_x(R_ACC);
    }
}

// The 8 bytes of frame slot `offset` = <reg> (R_ADDR keeps the address).
fn store_reg_to_frame(reg: i64, offset: i64) {
    emit_frame_addr(R_ADDR, offset);
    emit_store(TY_U64, reg, R_ADDR);
}

// <reg> = the 8 bytes of frame slot `offset` (R_ADDR keeps the address).
fn load_reg_from_frame(reg: i64, offset: i64) {
    emit_frame_addr(R_ADDR, offset);
    emit_load_reg(reg, R_ADDR);
}
