// Expressions (gen0): gen_expr dispatches on the node kind and leaves the
// value in the accumulator. Here: names and addresses (places, indexing),
// operators and casts, struct, tuple and array literals, enum variants,
// slicing, and assignment; match, if and loops are in control.tach,
// vectors in vector.tach, calls in call.tach.

use crate::front::ast::{NODES, NodeKind, child, defer_loop_depth, field_order};
use crate::front::ast::NodeKind::{
    Array, Assign, Binary, Bool, Break, CStr, Call, Cast, Char, Continue, EnumPanic, FieldAccess,
    Float, For, Ident, If, Index, Int, Loop, Match, Range, Repeat, Return, Str, StructLit, Tuple,
    TupleField, Unary, Unit, VariantLit, While,
};
use crate::front::check::{LOCALS, Res, type_error};
use crate::front::consteval::{const_value, f64_of_bits, float_const, wrap_int};
use crate::front::lexer::{STRS, Tok};
use crate::front::parser::exprs::is_comparison;
use crate::front::types::{
    ENUMS, FNS, STATICS, SYM_STATIC, TYPES, TY_BOOL, TY_NEVER, TY_U64, TY_UNIT, TyKind, VARIANTS,
    field_offset, is_compound, is_float, is_signed, is_slice, is_vector, is_void, struct_field,
    tuple_offset, type_elem, type_size, variant_field, variant_field_offset,
};
use crate::gen0::gen::{
    CUR_FN, RETURN_LABEL, alloc_slot, alloc_slot_for, fn_symbol_prefix, gen_block, gen_defers,
    gen_return_value, load_from_x0, load_reg_from_frame, pop_second_operand, static_symbol_prefix,
    store_reg_to_frame, store_to_frame,
};
use crate::gen0::gen::call::gen_call;
use crate::gen0::gen::control::{gen_for, gen_if, gen_loop, gen_match, jump_out_to_loop};
use crate::gen0::gen::vector::{gen_vecop, gen_vector_assign, gen_vector_binary, gen_vector_negate};
use crate::gen0::target::{
    DEPTH, PANIC_INDEX_SIGNED, PANIC_INDEX_UNSIGNED, PANIC_RANGE_SIGNED, PANIC_RANGE_UNSIGNED,
    R_ACC, R_ADDR, R_LOOP_COUNT, R_LOOP_PTR, R_SECOND, emit_add_imm, emit_bitnot, emit_compare,
    emit_compare_jump, emit_copy, emit_decrement, emit_drop_temps, emit_extern_symbol_addr,
    emit_float_binary, emit_float_to_float, emit_float_to_int, emit_frame_addr, emit_index_addr,
    emit_int_binary, emit_int_to_float, emit_jump, emit_jump_if_nonzero, emit_jump_if_zero,
    emit_jump_unless_zero_result, emit_label, emit_load, emit_load_float, emit_load_imm,
    emit_load_reg, emit_local_symbol_addr, emit_move_to_second, emit_negate, emit_normalize,
    emit_not_bool, emit_panic, emit_peek, emit_peek_at, emit_store, emit_store_offset,
    emit_string_addr, new_label, pop_d, pop_x, push_value, push_x0,
};
use crate::middle::ir::{Cond, cond_of_token};

// ---- Expressions ----

// R_ACC (or `reg` with the machine layer) = the address of static `name`:
// through the GOT when C defines it.
pub fn emit_static_addr(name: i64) {
    unsafe {
        let s = SYM_STATIC[name] - 1;
        let linkage = STATICS[s].linkage;
        if linkage == 1 {
            emit_extern_symbol_addr(name);
        } else {
            emit_local_symbol_addr(static_symbol_prefix(s), name);
        }
    }
}

pub fn gen_expr(n: i64) {
    unsafe {
        let ty = NODES[n].ty;
        match NODES[n].kind {
            Int | Char => emit_load_imm(R_ACC, wrap_int(NODES[n].a, ty) as u64),
            Float => emit_load_float(float_const(f64_of_bits(NODES[n].a), ty), ty),
            Bool => emit_load_imm(R_ACC, NODES[n].a as u64),
            Unit => {}
            Str => gen_string(n),
            CStr => emit_string_addr(NODES[n].a),
            Ident => gen_ident(n),
            Binary => gen_binary(n),
            Unary => gen_unary(n),
            Cast => {
                gen_expr(NODES[n].a);
                gen_cast(NODES[NODES[n].a].ty, ty);
            }
            Call => gen_call(n),
            Index if NODES[NODES[n].b].kind == Range => gen_slicing(n),
            Index | FieldAccess | TupleField => {
                gen_addr(n);
                load_from_x0(ty);
            }
            Tuple | Array | StructLit => gen_aggregate(n),
            // (0.14: its env, or its function as a value)
            NodeKind::Closure => gen_expr(NODES[n].y),
            // (0.15: the Match of `?`, the Block of an f-string)
            NodeKind::Try | NodeKind::Interp => gen_expr(NODES[n].y),
            Repeat => gen_repeat(n),
            NodeKind::Block => gen_block(n),
            If => gen_if(n),
            Match => gen_match(n),
            VariantLit => gen_variant(n),
            NodeKind::VecOp => gen_vecop(n),
            Loop | While => gen_loop(n),
            For => gen_for(n),
            Assign => gen_assign(n),
            EnumPanic => {
                gen_expr(NODES[n].a);
                emit_panic(NODES[n].x);
            }
            Return => {
                if NODES[n].a != 0 {
                    gen_expr(NODES[n].a);
                    gen_defers(0, NODES[NODES[n].a].ty);
                    gen_return_value(FNS[CUR_FN].ret);
                } else {
                    gen_defers(0, TY_UNIT);
                }
                emit_jump(RETURN_LABEL);
            }
            Break => {
                let mut ty = TY_UNIT;
                if NODES[n].b != 0 {
                    gen_expr(NODES[n].b);
                    ty = NODES[NODES[n].b].ty;
                }
                gen_defers(defer_loop_depth(NODES[n].x), ty);
                jump_out_to_loop(NODES[n].x, 1);
            }
            Continue => {
                gen_defers(defer_loop_depth(NODES[n].x), TY_UNIT);
                jump_out_to_loop(NODES[n].x, 0);
            }
            _ => type_error(n, c"internal error: unexpected node in code generation"),
        }
    }
}

// A string literal is a (pointer, length) tuple.
fn gen_string(n: i64) {
    unsafe {
        let slot = alloc_slot(16, 8);
        emit_string_addr(NODES[n].a);
        emit_frame_addr(R_ADDR, slot);
        emit_store(TY_U64, R_ACC, R_ADDR);
        emit_load_imm(R_ACC, STRS[NODES[n].a].len as u64);
        emit_store_offset(R_ACC, R_ADDR, 8);
        emit_frame_addr(R_ACC, slot);
    }
}

fn gen_ident(n: i64) {
    unsafe {
        let ty = NODES[n].ty;
        let resolution = NODES[n].res;
        let index = NODES[n].y;
        if resolution == Res::Local {
            emit_frame_addr(R_ACC, LOCALS[index].offset);
            load_from_x0(ty);
        } else if resolution == Res::Const {
            let value = const_value(index);
            if is_float(ty) {
                emit_load_float(value, ty);
            } else {
                emit_load_imm(R_ACC, value as u64);
            }
        } else if resolution == Res::Static {
            emit_static_addr(NODES[n].a);
            load_from_x0(ty);
        } else {
            gen_fn_address(index);
        }
    }
}

fn gen_fn_address(f: i64) {
    unsafe {
        if FNS[f].is_extern {
            emit_extern_symbol_addr(FNS[f].name);
        } else {
            emit_local_symbol_addr(fn_symbol_prefix(f), FNS[f].name);
        }
    }
}

// The accumulator = the address of a place (or of a compound value).
pub fn gen_addr(n: i64) {
    unsafe {
        match NODES[n].kind {
            Ident if NODES[n].res
                == Res::Local => emit_frame_addr(R_ACC, LOCALS[NODES[n].y].offset),
            Ident if NODES[n].res == Res::Static => emit_static_addr(NODES[n].a),
            Unary if NODES[n].op == Tok::Star => gen_expr(NODES[n].b),
            FieldAccess => {
                // The struct's (or slice's) address, or the pointer to the struct.
                gen_expr(NODES[n].a);
                emit_add_imm(R_ACC, field_offset_of(n));
            }
            TupleField => {
                let base = NODES[n].a;
                gen_expr(base);
                emit_add_imm(R_ACC, tuple_offset(NODES[base].ty, NODES[n].b));
            }
            Index => gen_index_addr(n),
            _ => gen_expr(n),
        }
    }
}

// The offset of the field of NodeKind::FieldAccess n in its base: a struct (also through
// a pointer), or a slice.
pub fn field_offset_of(n: i64) -> i64 {
    unsafe {
        let base_ty = NODES[NODES[n].a].ty;
        if NODES[n].y == 2 {
            return NODES[n].x * 8;
        }
        if NODES[n].y == 1 {
            return field_offset(TYPES[TYPES[base_ty].a].a, NODES[n].x);
        }
        field_offset(TYPES[base_ty].a, NODES[n].x)
    }
}

pub fn panic_kind(index_ty: i64, range: bool) -> i64 {
    let signed = is_signed(index_ty);
    if range {
        return if signed { PANIC_RANGE_SIGNED } else { PANIC_RANGE_UNSIGNED };
    }
    if signed { PANIC_INDEX_SIGNED } else { PANIC_INDEX_UNSIGNED }
}

// Whether the pointer `n`, the base of `p[i]` or `p[lo..hi]`, is a place:
// evaluated to its location first and read only after the index or bounds
// (as a slice's pointer and length are), so that an index that changes it,
// a call that grows the table it points to, is seen (0.14).
pub fn pointer_place(n: i64) -> bool {
    unsafe {
        match NODES[n].kind {
            Ident => NODES[n].res == Res::Local || NODES[n].res == Res::Static,
            Unary => NODES[n].op == Tok::Star,
            FieldAccess | TupleField => true,
            Index => NODES[NODES[n].b].kind != Range,
            _ => false,
        }
    }
}

fn gen_index_addr(n: i64) {
    unsafe {
        let base = NODES[n].a;
        let base_ty = NODES[base].ty;
        let elem_size = type_size(TYPES[base_ty].a);
        if TYPES[base_ty].kind == TyKind::Ptr && pointer_place(base) {
            // The pointer's location, the index, then the pointer.
            gen_addr(base);
            push_x0();
            gen_expr(NODES[n].b);
            pop_x(R_SECOND);
            emit_load_reg(R_SECOND, R_SECOND);
            emit_index_addr(elem_size);
            return;
        }
        // A slice's address (its pointer and length are read after the
        // index), an array's, or a pointer value.
        gen_expr(base);
        push_x0();
        gen_expr(NODES[n].b);
        if is_slice(base_ty) {
            // Checked: the index against the slice's length.
            emit_peek(R_SECOND);
            emit_add_imm(R_SECOND, 8);
            emit_load_reg(R_SECOND, R_SECOND);
            let ok = new_label();
            emit_compare_jump(Cond::Lt, false, ok);
            emit_panic(panic_kind(NODES[NODES[n].b].ty, range: false));
            emit_label(ok);
            pop_x(R_SECOND);
            emit_load_reg(R_SECOND, R_SECOND);
            emit_index_addr(elem_size);
            return;
        }
        if TYPES[base_ty].kind == TyKind::Array {
            // Checked (0.7): the index against the array's length.
            emit_load_imm(R_SECOND, TYPES[base_ty].b as u64);
            let ok = new_label();
            emit_compare_jump(Cond::Lt, false, ok);
            emit_panic(panic_kind(NODES[NODES[n].b].ty, range: false));
            emit_label(ok);
        }
        pop_x(R_SECOND);
        emit_index_addr(elem_size);
    }
}

// ---- Operators ----

fn gen_binary(n: i64) {
    unsafe {
        let op = NODES[n].op;
        let lhs = NODES[n].b;
        let rhs = NODES[n].c;
        if op == Tok::AmpAmp || op == Tok::PipePipe {
            let end = new_label();
            gen_expr(lhs);
            if op == Tok::AmpAmp {
                emit_jump_if_zero(end);
            } else {
                emit_jump_if_nonzero(end);
            }
            gen_expr(rhs);
            emit_label(end);
            return;
        }
        let operand_ty = NODES[lhs].ty;
        if is_vector(operand_ty) {
            gen_vector_binary(op, lhs, rhs, NODES[n].ty);
            return;
        }
        gen_expr(lhs);
        push_value(operand_ty);
        gen_expr(rhs);
        pop_second_operand(operand_ty);
        gen_operator(op, operand_ty, NODES[n].ty);
    }
}

// Accumulator = accumulator <op> second operand.
fn gen_operator(op: Tok, operand_ty: i64, result_ty: i64) {
    if is_comparison(op) {
        emit_compare(cond_of_token(op), operand_ty);
    } else if is_float(operand_ty) {
        emit_float_binary(op, result_ty);
    } else {
        emit_int_binary(op, result_ty);
    }
}

fn gen_unary(n: i64) {
    unsafe {
        let op = NODES[n].op;
        let operand = NODES[n].b;
        let ty = NODES[n].ty;
        if op == Tok::Amp {
            gen_addr(operand);
            return;
        }
        if op == Tok::Minus && is_vector(ty) {
            gen_vector_negate(operand, ty);
            return;
        }
        gen_expr(operand);
        if op == Tok::Minus {
            emit_negate(ty);
        } else if op == Tok::Bang {
            emit_not_bool();
        } else if op == Tok::Tilde {
            emit_bitnot(ty);
        } else {
            // Deref: the accumulator is the pointer.
            load_from_x0(ty);
        }
    }
}

fn gen_cast(from: i64, to: i64) {
    if from == TY_NEVER || from == to {
        return;
    }
    if is_float(from) && is_float(to) {
        emit_float_to_float(from, to);
    } else if is_float(to) {
        emit_int_to_float(from, to);
    } else if is_float(from) {
        emit_float_to_int(from, to);
    } else if from != TY_BOOL {
        // Integers and pointers: the accumulator is canonical for `from`,
        // so this truncates or extends.
        emit_normalize(to);
    }
}

// ---- Aggregates ----

// A struct, tuple or array literal, built in a new frame slot.
pub fn gen_aggregate(n: i64) {
    unsafe {
        let ty = NODES[n].ty;
        let kind = NODES[n].kind;
        let slot = alloc_slot_for(ty);
        for i in 0..NODES[n].count {
            let elem = child(n, i);
            let mut value = elem;
            let mut offset = 0;
            let mut elem_ty = 0;
            if kind == StructLit {
                let s = TYPES[ty].a;
                value = NODES[elem].b;
                offset = field_offset(s, NODES[elem].x);
                elem_ty = (*struct_field(s, NODES[elem].x)).ty;
            } else if kind == Tuple {
                offset = tuple_offset(ty, i);
                elem_ty = type_elem(ty, i);
            } else {
                elem_ty = TYPES[ty].a;
                offset = i * type_size(elem_ty);
            }
            gen_expr(value);
            store_to_frame(elem_ty, slot - offset);
        }
        emit_frame_addr(R_ACC, slot);
    }
}

// `[value; count]`: the value is evaluated once.
fn gen_repeat(n: i64) {
    unsafe {
        let ty = NODES[n].ty;
        let elem_ty = TYPES[ty].a;
        let count = TYPES[ty].b;
        let elem_size = type_size(elem_ty);
        let slot = alloc_slot_for(ty);
        gen_expr(NODES[n].a);
        if count > 0 && !is_void(elem_ty) && elem_size > 0 {
            let top = new_label();
            if is_compound(elem_ty) {
                // Copies from the value's address, keeping the cursor and the
                // count in frame slots (copies may call memcpy).
                let source = alloc_slot(8, 8);
                let cursor = alloc_slot(8, 8);
                let remaining = alloc_slot(8, 8);
                store_reg_to_frame(R_ACC, source);
                emit_frame_addr(R_ACC, slot);
                store_reg_to_frame(R_ACC, cursor);
                emit_load_imm(R_ACC, count as u64);
                store_reg_to_frame(R_ACC, remaining);
                emit_label(top);
                load_reg_from_frame(R_SECOND, cursor);
                load_reg_from_frame(R_ACC, source);
                emit_copy(elem_size);
                load_reg_from_frame(R_ACC, cursor);
                emit_add_imm(R_ACC, elem_size);
                emit_store(TY_U64, R_ACC, R_ADDR);
                load_reg_from_frame(R_ACC, remaining);
                emit_decrement(R_ACC);
                emit_store(TY_U64, R_ACC, R_ADDR);
                emit_jump_unless_zero_result(top);
            } else {
                emit_frame_addr(R_LOOP_PTR, slot);
                emit_load_imm(R_LOOP_COUNT, count as u64);
                emit_label(top);
                emit_store(elem_ty, R_ACC, R_LOOP_PTR);
                emit_add_imm(R_LOOP_PTR, elem_size);
                emit_decrement(R_LOOP_COUNT);
                emit_jump_unless_zero_result(top);
            }
        }
        emit_frame_addr(R_ACC, slot);
    }
}

// ---- Enums and slices ----

// `E::V(...)`: a fieldless enum's tag, or a new value in a frame slot.
fn gen_variant(n: i64) {
    unsafe {
        let ty = NODES[n].ty;
        let v = NODES[n].a;
        let tag = ENUMS[TYPES[ty].a].tag;
        if !is_compound(ty) {
            emit_load_imm(R_ACC, wrap_int(VARIANTS[v].discr, tag) as u64);
            return;
        }
        let slot = alloc_slot_for(ty);
        for j in 0..NODES[n].count {
            let i = field_order(n, j);
            gen_expr(child(n, i));
            store_to_frame(variant_field(v, i), slot - variant_field_offset(v, i));
        }
        emit_load_imm(R_ACC, wrap_int(VARIANTS[v].discr, tag) as u64);
        store_to_frame(tag, slot);
        emit_frame_addr(R_ACC, slot);
    }
}

// `a[lo..hi]` (and the other ranges) of an array, a slice or a pointer: a
// new slice in a frame slot. Arrays and slices are checked: lo <= hi <=
// the length (lo <= hi + 1 and hi < the length for `..=`).
fn gen_slicing(n: i64) {
    unsafe {
        let base = NODES[n].a;
        let base_ty = NODES[base].ty;
        let range = NODES[n].b;
        let low = NODES[range].a;
        let high = NODES[range].b;
        let inclusive = NODES[range].c != 0;
        let elem_size = type_size(TYPES[base_ty].a);
        // The result: the pointer at `slot`, the length at `slot - 8`.
        let slot = alloc_slot(16, 8);
        let length = alloc_slot(8, 8);
        let low_slot = alloc_slot(8, 8);
        let high_slot = alloc_slot(8, 8);
        // The base first: a slice's address, a pointer's location (a
        // place) or value, an array's address; then the bounds; then what
        // the base holds, so that bounds that change it are seen.
        let late_pointer = TYPES[base_ty].kind == TyKind::Ptr && pointer_place(base);
        if late_pointer {
            gen_addr(base);
        } else {
            gen_expr(base);
        }
        store_reg_to_frame(R_ACC, slot);
        let mut bound_ty = TY_U64;
        if low != 0 {
            gen_expr(low);
            bound_ty = NODES[low].ty;
        } else {
            emit_load_imm(R_ACC, 0);
        }
        store_reg_to_frame(R_ACC, low_slot);
        if high != 0 {
            gen_expr(high);
            bound_ty = NODES[high].ty;
            store_reg_to_frame(R_ACC, high_slot);
        }
        if is_slice(base_ty) {
            load_reg_from_frame(R_SECOND, slot);
            emit_load_reg(R_ACC, R_SECOND);
            store_reg_to_frame(R_ACC, slot);
            emit_add_imm(R_SECOND, 8);
            emit_load_reg(R_ACC, R_SECOND);
            store_reg_to_frame(R_ACC, length);
        } else if late_pointer {
            load_reg_from_frame(R_SECOND, slot);
            emit_load_reg(R_ACC, R_SECOND);
            store_reg_to_frame(R_ACC, slot);
        } else if TYPES[base_ty].kind == TyKind::Array {
            emit_load_imm(R_ACC, TYPES[base_ty].b as u64);
            store_reg_to_frame(R_ACC, length);
        }
        if high == 0 {
            load_reg_from_frame(R_ACC, length);
            store_reg_to_frame(R_ACC, high_slot);
        }
        if TYPES[base_ty].kind != TyKind::Ptr {
            let ok = new_label();
            let fail = new_label();
            // hi <= length (hi < length for `..=`), then lo <= hi (+ 1).
            load_reg_from_frame(R_SECOND, length);
            load_reg_from_frame(R_ACC, high_slot);
            emit_compare_jump(if inclusive { Cond::Ge } else { Cond::Gt }, false, fail);
            if inclusive {
                emit_add_imm(R_ACC, 1);
            }
            emit_move_to_second(TY_U64);
            load_reg_from_frame(R_ACC, low_slot);
            emit_compare_jump(Cond::Le, false, ok);
            emit_label(fail);
            load_reg_from_frame(R_ACC, length);
            push_x0();
            load_reg_from_frame(R_SECOND, high_slot);
            if inclusive {
                emit_add_imm(R_SECOND, 1);
            }
            load_reg_from_frame(R_ACC, low_slot);
            pop_x(R_ADDR);
            emit_panic(panic_kind(bound_ty, range: true));
            emit_label(ok);
        }
        // ptr += lo * size; len = hi (+ 1) - lo.
        load_reg_from_frame(R_ACC, low_slot);
        load_reg_from_frame(R_SECOND, slot);
        emit_index_addr(elem_size);
        store_reg_to_frame(R_ACC, slot);
        load_reg_from_frame(R_ACC, low_slot);
        emit_move_to_second(TY_U64);
        load_reg_from_frame(R_ACC, high_slot);
        if inclusive {
            emit_add_imm(R_ACC, 1);
        }
        emit_int_binary(Tok::Minus, TY_U64);
        store_reg_to_frame(R_ACC, slot - 8);
        emit_frame_addr(R_ACC, slot);
    }
}

// ---- Assignment ----

pub fn arith_op_of_assign(op: Tok) -> Tok {
    match op {
        Tok::PlusEq => Tok::Plus,
        Tok::MinusEq => Tok::Minus,
        Tok::StarEq => Tok::Star,
        Tok::SlashEq => Tok::Slash,
        Tok::PercentEq => Tok::Percent,
        Tok::AmpEq => Tok::Amp,
        Tok::PipeEq => Tok::Pipe,
        Tok::CaretEq => Tok::Caret,
        Tok::ShlEq => Tok::Shl,
        _ => Tok::Shr,
    }
}

// The right-hand side is evaluated first, then the target's address; a
// compound assignment then reads the old value.
fn gen_assign(n: i64) {
    unsafe {
        let op = NODES[n].op;
        let target = NODES[n].b;
        let value = NODES[n].c;
        let ty = NODES[target].ty;
        gen_expr(value);
        if op == Tok::Eq {
            if is_void(ty) {
                gen_addr(target);
                return;
            }
            // The value (the source's address for compound values) waits on the
            // stack while the target's address is computed.
            push_value(ty);
            gen_addr(target);
            emit_move_to_second(TY_U64);
            if is_float(ty) {
                pop_d(0);
            } else {
                pop_x(R_ACC);
            }
            if is_compound(ty) {
                emit_copy(type_size(ty));
            } else {
                emit_store(ty, R_ACC, R_SECOND);
            }
            return;
        }
        let value_ty = NODES[value].ty;
        if is_vector(ty) {
            gen_vector_assign(arith_op_of_assign(op), target, ty);
            return;
        }
        push_value(value_ty);
        gen_addr(target);
        push_x0();
        emit_peek(R_ADDR);
        emit_load(ty, R_ADDR);
        emit_peek_at(R_SECOND, 1, is_float(value_ty));
        gen_operator(arith_op_of_assign(op), ty, ty);
        pop_x(R_ADDR);
        emit_store(ty, R_ACC, R_ADDR);
        emit_drop_temps(1);
        DEPTH -= 1;
    }
}
