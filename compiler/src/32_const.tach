// Compile-time constants: `const` items, array lengths and the
// initializers of statics. A scalar constant is held as 64 bits: integers
// wrapped to their type (sign-extended when signed), floats as the bits of
// an f64 (rounded to f32 first for f32), bools as 0 or 1.

fn f64_of_bits(bits: i64) -> f64 {
    let copy = bits;
    *(&copy as *f64)
}

fn bits_of(value: f64) -> i64 {
    let copy = value;
    *(&copy as *i64)
}

fn f32_bits(value: f64) -> u32 {
    let narrow = value as f32;
    *(&narrow as *u32)
}

// `value` wrapped to the integer (or pointer) type `ty`.
fn wrap_int(value: i64, ty: i64) -> i64 {
    if !is_integer(ty) {
        return value;
    }
    let bits = int_bits(ty);
    if bits == 64 {
        return value;
    }
    let mask: i64 = (1 << bits as u64) - 1;
    let masked = value & mask;
    if is_signed(ty) && (masked >> (bits - 1) as u64) == 1 {
        return masked - (1 << bits as u64);
    }
    masked
}

fn float_const(value: f64, ty: i64) -> i64 {
    if ty == TY_F32 {
        return bits_of(value as f32 as f64);
    }
    bits_of(value)
}

fn not_constant(n: i64) -> ! {
    type_error(n, c"expression is not a compile-time constant")
}

// Type checks `n` against `ty` with no locals in scope.
fn check_const_expr(n: i64, ty: i64) {
    let saved_context = CONST_CONTEXT;
    let saved_return = RETURN_TYPE;
    CONST_CONTEXT = true;
    RETURN_TYPE = TY_UNIT;
    check_expr(n, ty);
    CONST_CONTEXT = saved_context;
    RETURN_TYPE = saved_return;
}

fn const_value(c: i64) -> i64 {
    if CONSTS[c].state == 2 {
        return CONSTS[c].value;
    }
    let item = CONSTS[c].node;
    if CONSTS[c].state == 1 {
        name_error(NODES[item].start, c"constant '", NODES[item].a, c"' is defined in terms of itself");
    }
    CONSTS[c].state = 1;
    // In the constant's module, without type parameters in scope.
    let saved_mod = CUR_MOD;
    CUR_MOD = module_of(item);
    let saved_env = env_enter(0, 0, 0);
    check_const_expr(NODES[item].c, CONSTS[c].ty);
    // A C string constant (0.4) has no value: its uses are the literal.
    let value = if NODES[NODES[item].c].kind == NodeKind::CStr { 0 } else { const_eval(NODES[item].c) };
    env_leave(saved_env);
    CUR_MOD = saved_mod;
    CONSTS[c].value = value;
    CONSTS[c].state = 2;
    value
}

fn eval_array_len(n: i64) -> i64 {
    let saved_context = CONST_CONTEXT;
    CONST_CONTEXT = true;
    let ty = synth_expr(n);
    if !is_integer(ty) {
        type_error_got(n, c"array length must be an integer", ty);
    }
    let value = const_eval(n);
    CONST_CONTEXT = saved_context;
    if is_signed(ty) && value < 0 {
        type_error(n, c"array length must not be negative");
    }
    value
}

// The value of a scalar constant expression (already type checked).
fn const_eval(n: i64) -> i64 {
    let ty = NODES[n].ty;
    match NODES[n].kind {
        NodeKind::Int | NodeKind::Char => wrap_int(NODES[n].a, ty),
        NodeKind::Float => float_const(f64_of_bits(NODES[n].a), ty),
        NodeKind::Bool => NODES[n].a,
        NodeKind::Unit => 0,
        NodeKind::Ident => {
            if NODES[n].res != Res::Const {
                name_error(NODES[n].start, c"'", NODES[n].a, c"' is not a constant");
            }
            const_value(NODES[n].y)
        }
        NodeKind::Unary => const_unary(n, ty),
        NodeKind::Binary => const_binary(n, ty),
        NodeKind::Cast => {
            let operand = NODES[n].a;
            let value = const_eval(operand);
            const_cast(n, value, scalar_type(NODES[operand].ty), ty)
        }
        NodeKind::VariantLit if !is_compound(ty) => wrap_int(VARIANTS[NODES[n].a].discr, scalar_type(ty)),
        _ => not_constant(n),
    }
}

fn const_unary(n: i64, ty: i64) -> i64 {
    let value = const_eval(NODES[n].b);
    match NODES[n].op {
        Tok::Minus => if is_float(ty) {
            float_const(0.0 - f64_of_bits(value), ty)
        } else {
            wrap_int(0 - value, ty)
        },
        Tok::Bang => 1 - value,
        Tok::Tilde => wrap_int(~value, ty),
        _ => not_constant(n),
    }
}

fn const_binary(n: i64, ty: i64) -> i64 {
    let op = NODES[n].op;
    let lhs = NODES[n].b;
    let operand_ty = NODES[lhs].ty;
    let a = const_eval(lhs);
    if op == Tok::AmpAmp && a == 0 {
        return 0;
    }
    if op == Tok::PipePipe && a == 1 {
        return 1;
    }
    let b = const_eval(NODES[n].c);
    if operand_ty == TY_BOOL {
        if op == Tok::AmpAmp || op == Tok::PipePipe { return b; }
        if op == Tok::EqEq { return (a == b) as i64; }
        if op == Tok::BangEq { return (a != b) as i64; }
        type_error(n, c"invalid operator on bools");
    }
    if is_float(operand_ty) {
        return const_float_binary(n, op, f64_of_bits(a), f64_of_bits(b), ty);
    }
    const_int_binary(n, op, a, b, operand_ty, ty)
}

fn const_float_binary(n: i64, op: Tok, a: f64, b: f64, ty: i64) -> i64 {
    match op {
        Tok::Plus => float_const(a + b, ty),
        Tok::Minus => float_const(a - b, ty),
        Tok::Star => float_const(a * b, ty),
        Tok::Slash => float_const(a / b, ty),
        Tok::Percent => float_const(a % b, ty),
        Tok::EqEq => (a == b) as i64,
        Tok::BangEq => (a != b) as i64,
        Tok::Lt => (a < b) as i64,
        Tok::Gt => (a > b) as i64,
        Tok::LtEq => (a <= b) as i64,
        Tok::GtEq => (a >= b) as i64,
        _ => type_error(n, c"invalid operator on floats"),
    }
}

// `a < b` for values of an integer type.
fn const_less(a: i64, b: i64, ty: i64) -> bool {
    if is_signed(ty) { a < b } else { (a as u64) < (b as u64) }
}

fn const_int_binary(n: i64, op: Tok, a: i64, b: i64, operand_ty: i64, ty: i64) -> i64 {
    match op {
        Tok::Plus => wrap_int(a + b, ty),
        Tok::Minus => wrap_int(a - b, ty),
        Tok::Star => wrap_int(a * b, ty),
        Tok::Slash | Tok::Percent => {
            if b == 0 {
                type_error(n, c"division by zero in constant expression");
            }
            if is_signed(operand_ty) {
                // -MIN / -1 overflows; computed by negation, which wraps.
                if b == -1 {
                    return if op == Tok::Slash { wrap_int(0 - a, ty) } else { 0 };
                }
                return wrap_int(if op == Tok::Slash { a / b } else { a % b }, ty);
            }
            let ua = a as u64;
            let ub = b as u64;
            wrap_int((if op == Tok::Slash { ua / ub } else { ua % ub }) as i64, ty)
        }
        Tok::Amp => wrap_int(a & b, ty),
        Tok::Pipe => wrap_int(a | b, ty),
        Tok::Caret => wrap_int(a ^ b, ty),
        Tok::Shl | Tok::Shr => {
            let amount = (b as u64 & 0xffffffff) % int_bits(operand_ty) as u64;
            if op == Tok::Shl {
                wrap_int(a << amount, ty)
            } else if is_signed(operand_ty) {
                wrap_int(a >> amount, ty)
            } else {
                wrap_int(((a as u64) >> amount) as i64, ty)
            }
        }
        Tok::EqEq => (a == b) as i64,
        Tok::BangEq => (a != b) as i64,
        Tok::Lt => const_less(a, b, operand_ty) as i64,
        Tok::Gt => const_less(b, a, operand_ty) as i64,
        Tok::LtEq => !const_less(b, a, operand_ty) as i64,
        Tok::GtEq => !const_less(a, b, operand_ty) as i64,
        _ => not_constant(n),
    }
}

fn int_to_f64(value: i64, from: i64) -> f64 {
    if is_signed(from) { value as f64 } else { (value as u64) as f64 }
}

fn const_cast(n: i64, value: i64, from: i64, to: i64) -> i64 {
    let from_float = is_float(from);
    if (is_integer(to) || is_pointer(to)) && !from_float {
        if from == TY_BOOL {
            return value;
        }
        return wrap_int(value, to);
    }
    if is_float(to) && from_float {
        return float_const(f64_of_bits(value), to);
    }
    if is_float(to) && (is_integer(from) || is_pointer(from)) {
        return float_const(int_to_f64(value, from), to);
    }
    if is_integer(to) && from_float {
        return float_to_int(f64_of_bits(value), to);
    }
    not_constant(n)
}

// A saturating float to integer conversion (NaN is 0), like Rust's `as`.
fn float_to_int(value: f64, to: i64) -> i64 {
    if value != value {
        return 0;
    }
    let bits = int_bits(to);
    if to == TY_U64 {
        if value <= 0.0 {
            return 0;
        }
        if value >= 18446744073709551616.0 {
            return -1;
        }
        if value >= 9223372036854775808.0 {
            return ((value - 9223372036854775808.0) as i64) ^ (1 << 63);
        }
        return value as i64;
    }
    let mut min = 0.0;
    let mut max = 0.0;
    if is_signed(to) {
        min = 0.0 - int_to_f64(1 << (bits - 1) as u64, TY_I64);
        max = int_to_f64(int_max(to) as i64, TY_I64);
    } else {
        max = int_to_f64(int_max(to) as i64, TY_I64);
    }
    if value <= min {
        return wrap_int(min as i64, to);
    }
    if value >= max {
        return int_max(to) as i64;
    }
    value as i64
}

// ---- Aggregate constants (the initializers of statics) ----

// Appends the bytes of the constant `n` of type `ty` to buffer `out`.
fn const_emit(n: i64, ty: i64, out: i64) {
    let at = BUFS[out].len;
    let size = size_of(ty);
    buf_reserve(out, size);
    memset(&BUFS[out].data[at], 0, size as u64);
    BUFS[out].len += size;
    const_write(n, ty, out, at);
}

fn const_write(n: i64, ty: i64, out: i64, at: i64) {
    match NODES[n].kind {
        NodeKind::StructLit => {
            let s = TYPES[ty].a;
            for i in 0..NODES[n].count {
                let init = child(n, i);
                let field = NODES[init].x;
                const_write(NODES[init].b, (*struct_field(s, field)).ty, out, at + field_offset(s, field));
            }
        }
        NodeKind::Tuple => {
            for i in 0..NODES[n].count {
                const_write(child(n, i), type_elem(ty, i), out, at + tuple_offset(ty, i));
            }
        }
        NodeKind::Array | NodeKind::Repeat => {
            let elem = TYPES[ty].a;
            let elem_size = size_of(elem);
            for i in 0..TYPES[ty].b {
                let value = if NODES[n].kind == NodeKind::Array { child(n, i) } else { NODES[n].a };
                const_write(value, elem, out, at + i * elem_size);
            }
        }
        NodeKind::VariantLit if is_compound(ty) => {
            let v = NODES[n].a;
            let tag = ENUMS[TYPES[ty].a].tag;
            write_scalar(out, at, wrap_int(VARIANTS[v].discr, tag), tag);
            for i in 0..NODES[n].count {
                const_write(child(n, i), variant_field(v, i), out, at + variant_field_offset(v, i));
            }
        }
        _ => {
            if is_compound(ty) {
                not_constant(n);
            }
            let value = const_eval(n);
            write_scalar(out, at, value, scalar_type(ty));
        }
    }
}

// The bytes of a scalar constant, little-endian.
fn write_scalar(out: i64, at: i64, value: i64, ty: i64) {
    let size = size_of(ty);
    let mut bits = value as u64;
    if ty == TY_F32 {
        bits = f32_bits(f64_of_bits(value)) as u64;
    }
    for i in 0..size {
        BUFS[out].data[at + i] = (bits >> (i * 8) as u64) as u8;
    }
}
