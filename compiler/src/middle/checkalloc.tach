// --check-alloc's allocation sites (0.16; T3 makes it): with the flag,
// lowering stores a site string (`main.tach:14:9`) before each call from
// code outside std to a function whose effects allocate, for the checking
// allocator's reports (docs/design/effects-allocation.md §2.5).

// Before lowering call n (a checked Call node): its site, when it
// allocates and --check-alloc is on.
pub fn site_before_call(n: i64) {}
