// Profile-guided optimization (0.10): instrumentation (`--profile-generate
// FILE`) and its use (`--profile-use FILE`).
//
// Both work on the IR just after lowering, where a function's blocks are
// exactly what its source makes of them (the same in both compilations):
// its blocks in order (IRFUNCS[fi].blocks) are numbered, and the function
// is identified by its symbol and a checksum of that IR's shape (the
// blocks' instructions' operations and successors).
//
// Instrumentation: a counter per block, incremented where the block
// starts; the counters are an array the runtime (the module __profile,
// whose source is built in below and added to the program) allocates
// when main starts, and writes at exit (atexit) to FILE:
//
//     tachyon-profile 1
//     fn <symbol> <checksum> <blocks>
//     <count of block 0>
//     ...
//
// Use: the counts of a function whose symbol and checksum match are its
// blocks' BLOCKS[b].count (-1: unknown, for blocks without a profile and
// those made later); a function whose checksum differs (its source
// changed since) keeps no counts, with a warning. The passes read the
// counts as hints (layout.tach, inline.tach, scev.tach); those that copy
// blocks keep them (scaled when inlining).

use crate::base::{BUFS, IntVec, buf_byte, buf_int, buf_new, buf_str, buf_uint, intern_c, sym_name};
use crate::base::diag::report_warning;
use crate::front::ast::NODES;
use crate::front::lexer::add_string;
use crate::front::types::{FNS, SYM_FN, SYM_STATIC, TY_I64, TY_U64, TY_U8, ptr_to};
use crate::gen0::gen::MAIN_SYM;
use crate::middle::ir::{
    ARGS, ARGTY, BLOCKS, INSTS, IRFUNCS, IRFUNC_COUNT, Op, ir_append, ir_enter, ir_insert_before,
    ir_make,
};
use crate::middle::ir::cfg::{succ, succ_count};

extern "C" {
    fn fopen(path: *u8, mode: *u8) -> *u8;
    fn fread(buf: *u8, size: u64, count: u64, file: *u8) -> u64;
    fn fclose(file: *u8) -> i32;
}

pub static mut PROFILE_GENERATE: *u8 = 0 as *u8;
pub static mut PROFILE_USE: *u8 = 0 as *u8;
// The module of the runtime (when instrumenting), or -1.
pub static mut PROFILE_MODULE: i64 = -1;

// The runtime: started first in main, it writes the profile at exit.
pub fn profile_runtime_source(out: i64) {
    unsafe {
        buf_str(out, c"// The profile runtime (0.10): see compiler/src/profile.tach.\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    fn calloc(count: u64, size: u64) -> *u8;\n");
        buf_str(out, c"    fn fopen(path: *u8, mode: *u8) -> *u8;\n");
        buf_str(out, c"    fn fprintf(file: *u8, format: *u8, ...) -> i32;\n");
        buf_str(out, c"    fn fclose(file: *u8) -> i32;\n");
        buf_str(out, c"    fn atexit(f: extern \"C\" fn()) -> i32;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"pub static mut COUNTERS: *u64 = 0 as *u64;\n");
        buf_str(out, c"static mut PATH: *u8 = 0 as *u8;\n");
        buf_str(out, c"static mut META: *u8 = 0 as *u8;\n");
        buf_str(out, c"pub unsafe fn start(n: i64, path: *u8, meta: *u8) {\n");
        buf_str(out, c"    COUNTERS = calloc(n as u64 + 1, 8) as *u64;\n");
        buf_str(out, c"    PATH = path;\n");
        buf_str(out, c"    META = meta;\n");
        buf_str(out, c"    atexit(dump);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"extern \"C\" fn dump() {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let f = fopen(PATH, c\"w\");\n");
        buf_str(out, c"        if f == 0 as *u8 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        fprintf(f, c\"tachyon-profile 1\\n\");\n");
        buf_str(out, c"        let mut at = 0;\n");
        buf_str(out, c"        let mut k = 0;\n");
        buf_str(out, c"        while META[at] != 0 {\n");
        buf_str(out, c"            let line = at;\n");
        buf_str(out, c"            while META[at] != '\\n' {\n");
        buf_str(out, c"                at += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let mut j = at;\n");
        buf_str(out, c"            while META[j - 1] != ' ' {\n");
        buf_str(out, c"                j -= 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let mut blocks = 0;\n");
        buf_str(out, c"            for q in j..at {\n");
        buf_str(out, c"                blocks = blocks * 10 + (META[q] - '0') as i64;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            fprintf(f, c\"%.*s\\n\", (at - line) as i32, &META[line]);\n");
        buf_str(out, c"            for _ in 0..blocks {\n");
        buf_str(out, c"                fprintf(f, c\"%llu\\n\", COUNTERS[k]);\n");
        buf_str(out, c"                k += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            at += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        fclose(f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
    }
}

// Whether IR function fi takes part (the runtimes' own functions do not:
// --check-unsafe's run before the counters are made).
fn profiled(fi: i64) -> bool {
    unsafe {
        let m = FNS[IRFUNCS[fi].f].module;
        (m != PROFILE_MODULE || PROFILE_MODULE < 0)
            && (m != crate::middle::unsafecheck::CHECK_MODULE || m < 0)
    }
}

// The checksum of IR function fi's shape: per block (in order), its
// instructions' operations, its terminator and its successors' positions.
fn checksum(fi: i64) -> u64 {
    unsafe {
        let n = IRFUNCS[fi].blocks.count;
        for i in 0..n {
            BLOCKS[IRFUNCS[fi].blocks.data[i]].aux = i;
        }
        let mut h: u64 = 1469598103934665603;
        h = (h ^ n as u64) * 1099511628211;
        for i in 0..n {
            let b = IRFUNCS[fi].blocks.data[i];
            let mut v = BLOCKS[b].first;
            while v != 0 {
                h = (h ^ INSTS[v].op as u64) * 1099511628211;
                v = INSTS[v].next;
            }
            h = (h ^ (100 + BLOCKS[b].term as i64) as u64) * 1099511628211;
            for k in 0..succ_count(b) {
                h = (h ^ (1000 + BLOCKS[succ(b, k)].aux) as u64) * 1099511628211;
            }
        }
        h
    }
}

// The first instruction of block b after its phis and parameters (0: none).
fn body_start(b: i64) -> i64 {
    unsafe {
        let mut v = BLOCKS[b].first;
        while v != 0 && (INSTS[v].op == Op::Phi || INSTS[v].op == Op::Param) {
            v = INSTS[v].next;
        }
        v
    }
}

fn make(op: Op, ty: i64, a: i64, x: i64, imm: i64) -> i64 {
    ir_make(op, ty, a, x, imm)
}

// Counter `k`'s increment, at the start of block b.
fn count_block(b: i64, k: i64, counters: i64) {
    unsafe {
        let g = make(Op::GAddr, TY_U64, 0, 0, counters);
        let p = make(Op::Load, TY_U64, g, 0, 0);
        let off = make(Op::Const, TY_U64, 0, 0, 8 * k);
        let a = make(Op::Add, TY_U64, p, off, 0);
        let c = make(Op::Load, TY_U64, a, 0, 0);
        let one = make(Op::Const, TY_U64, 0, 0, 1);
        let c1 = make(Op::Add, TY_U64, c, one, 0);
        let s = make(Op::Store, 0, a, c1, 0);
        INSTS[s].imm2 = TY_U64;
        let list: [i64; 8] = [g, p, off, a, c, one, c1, s];
        let at = body_start(b);
        for i in 0..8 {
            if at == 0 {
                ir_append(b, list[i]);
            } else {
                ir_insert_before(at, list[i]);
            }
        }
    }
}

fn function_name(fi: i64) -> *u8 {
    unsafe { sym_name(FNS[IRFUNCS[fi].f].name) }
}

// A function's name in a profile: its spaces (a generic instance's tuple
// types have some) written as `~`.
fn name_char(c: u8) -> u8 {
    if c == ' ' { '~' } else { c }
}

fn buf_name(out: i64, name: *u8) {
    unsafe {
        let mut i = 0;
        while name[i] != 0 {
            buf_byte(out, name_char(name[i]));
            i += 1;
        }
    }
}

// --profile-generate: the counters, and the runtime's start in main.
fn instrument() {
    unsafe {
        let counters = intern_c(c"__profile.COUNTERS");
        let start = SYM_FN[intern_c(c"__profile::start")] - 1;
        if SYM_STATIC[counters] == 0 || start < 0 {
            return;
        }
        // (Without main, nothing would start the runtime: no counters.)
        let mut main = -1;
        for fi in 0..IRFUNC_COUNT {
            if profiled(fi) && FNS[IRFUNCS[fi].f].name == MAIN_SYM {
                main = fi;
            }
        }
        if main < 0 {
            return;
        }
        let meta = buf_new();
        let mut total = 0;
        for fi in 0..IRFUNC_COUNT {
            if !profiled(fi) {
                continue;
            }
            ir_enter(fi);
            let n = IRFUNCS[fi].blocks.count;
            buf_str(meta, c"fn ");
            buf_name(meta, function_name(fi));
            buf_byte(meta, ' ');
            buf_uint(meta, checksum(fi));
            buf_byte(meta, ' ');
            buf_int(meta, n);
            buf_byte(meta, '\n');
            for i in 0..n {
                count_block(IRFUNCS[fi].blocks.data[i], total + i, counters);
            }
            total += n;
        }
        let meta_id = add_string(BUFS[meta].data[0..BUFS[meta].len]);
        let path = buf_new();
        buf_str(path, PROFILE_GENERATE);
        let path_id = add_string(BUFS[path].data[0..BUFS[path].len]);
        // start(total, path, meta), before the entry's counter.
        ir_enter(main);
        let entry = IRFUNCS[main].entry;
        let n = make(Op::Const, TY_I64, 0, 0, total);
        let p = make(Op::SAddr, TY_U64, 0, 0, path_id);
        let m = make(Op::SAddr, TY_U64, 0, 0, meta_id);
        let call = make(Op::Call, 0, 0, 0, start);
        INSTS[call].args = ARGS.count;
        INSTS[call].nargs = 3;
        let str_ty = ptr_to(TY_U8);
        ARGS.push(n);
        ARGTY.push(TY_I64);
        ARGS.push(p);
        ARGTY.push(str_ty);
        ARGS.push(m);
        ARGTY.push(str_ty);
        let list: [i64; 4] = [n, p, m, call];
        let at = body_start(entry);
        for i in 0..4 {
            if at == 0 {
                ir_append(entry, list[i]);
            } else {
                ir_insert_before(at, list[i]);
            }
        }
    }
}

// ---- Reading a profile ----

static mut PF_TEXT: *u8 = 0 as *u8;
static mut PF_LEN: i64 = 0;
static mut PF_AT: i64 = 0;

fn pf_char() -> u8 {
    unsafe { if PF_AT < PF_LEN { PF_TEXT[PF_AT] } else { 0 } }
}

// The next word of the line (up to a space or the end of the line).
fn pf_word(start: *i64) -> i64 {
    unsafe {
        while pf_char() == ' ' {
            PF_AT += 1;
        }
        *start = PF_AT;
        while PF_AT < PF_LEN && pf_char() != ' ' && pf_char() != '\n' {
            PF_AT += 1;
        }
        PF_AT - *start
    }
}

fn pf_number() -> u64 {
    let mut s = 0;
    let n = pf_word(&s);
    let mut x: u64 = 0;
    for i in 0..n {
        let c = unsafe { PF_TEXT[s + i] };
        if c >= '0' && c <= '9' {
            x = x * 10 + (c - '0') as u64;
        }
    }
    x
}

fn pf_next_line() {
    unsafe {
        while PF_AT < PF_LEN && pf_char() != '\n' {
            PF_AT += 1;
        }
        PF_AT += 1;
    }
}

// Whether the word at [s, s + n) is the C string `name` (as buf_name
// writes it).
fn word_is(s: i64, n: i64, name: *u8) -> bool {
    unsafe {
        for i in 0..n {
            if name[i] == 0 || PF_TEXT[s + i] != name_char(name[i]) {
                return false;
            }
        }
        name[n] == 0
    }
}

// --profile-use: the counts of the functions whose profile matches.
fn annotate() {
    unsafe {
        let file = fopen(PROFILE_USE, c"rb");
        if file == 0 as *u8 {
            report_warning(0, 1, c"profile", c"cannot read the profile: no counts used", 0 as *u8);
            return;
        }
        let text = buf_new();
        loop {
            let at = BUFS[text].len;
            crate::base::buf_reserve(text, 65536);
            let got = fread(&BUFS[text].data[at], 1, 65536, file);
            BUFS[text].len += got as i64;
            if got == 0 {
                break;
            }
        }
        fclose(file);
        PF_TEXT = BUFS[text].data;
        PF_LEN = BUFS[text].len;
        PF_AT = 0;
        let mut s = 0;
        let n = pf_word(&s);
        if !word_is(s, n, c"tachyon-profile") || pf_number() != 1 {
            report_warning(0, 2, c"profile", c"not a tachyon profile (version 1): no counts used",
                0 as *u8);
            return;
        }
        pf_next_line();
        // The functions, by name: (name start, length, checksum, blocks, first
        // count's position) per function.
        let mut fns = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        while PF_AT < PF_LEN {
            let mut ws = 0;
            let wn = pf_word(&ws);
            if !word_is(ws, wn, c"fn") {
                pf_next_line();
                continue;
            }
            let mut ns = 0;
            let nn = pf_word(&ns);
            let sum = pf_number();
            let blocks = pf_number() as i64;
            pf_next_line();
            fns.push(ns);
            fns.push(nn);
            fns.push(sum as i64);
            fns.push(blocks);
            fns.push(PF_AT);
            for _ in 0..blocks {
                pf_next_line();
            }
        }
        for fi in 0..IRFUNC_COUNT {
            ir_enter(fi);
            let name = function_name(fi);
            let mut k = 0;
            while k < fns.count {
                if word_is(fns.data[k], fns.data[k + 1], name) {
                    break;
                }
                k += 5;
            }
            if k >= fns.count {
                continue;
            }
            let n = IRFUNCS[fi].blocks.count;
            if fns.data[k + 2] as u64 != checksum(fi) || fns.data[k + 3] != n {
                let message = buf_new();
                buf_str(message, c"the profile of '");
                buf_str(message, name);
                buf_str(message, c"' is stale (the function changed since it was made): ignored");
                buf_byte(message, 0);
                report_warning(NODES[FNS[IRFUNCS[fi].f].node].start, 3, c"profile",
                    BUFS[message].data, c"make the profile again with --profile-generate");
                continue;
            }
            PF_AT = fns.data[k + 4];
            for i in 0..n {
                let count = pf_number();
                pf_next_line();
                let c = if count > 1099511627776 { 1099511627776 } else { count as i64 };
                BLOCKS[IRFUNCS[fi].blocks.data[i]].count = c;
                if c > PROFILE_MAX {
                    PROFILE_MAX = c;
                }
            }
        }
    }
}

// After lowering: instruments the functions, or reads their counts.
pub fn profile_after_lowering() {
    if PROFILE_GENERATE != 0 as *u8 {
        instrument();
    }
    if PROFILE_USE != 0 as *u8 {
        annotate();
    }
}

// The largest count of the profile (0: none).
pub static mut PROFILE_MAX: i64 = 0;

// Whether a block that ran `count` times is hot: a 32nd of the most run
// block, and 64 times at least.
pub fn is_hot_count(count: i64) -> bool {
    PROFILE_MAX > 0 && count >= 64 && count >= PROFILE_MAX / 32
}

// Whether block b never ran (in a function with a profile).
pub fn is_cold_block(b: i64) -> bool {
    unsafe { PROFILE_MAX > 0 && BLOCKS[b].count == 0 }
}
