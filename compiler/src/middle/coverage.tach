// --coverage (0.18, T3; docs/design/contracts-verification.md §2.8): an
// 8-bit counter per basic block of the program's functions, as lowered
// (a `&&`, `||` or `if` is blocks of its own, so the edges between them
// are counted), incremented as the program runs: what `tachyonc fuzz`
// reads to keep the inputs that reach new code. The counters are std's
// (compiler/std/fuzz.tach: COVERAGE_MAP, 65536 of them; block k counts
// in COVERAGE_MAP[k % 65536]). std's functions and the runtimes' are not
// counted. A program built with --coverage prints what it prints without.

use crate::base::intern_c;
use crate::front::modules::STD_MODULE;
use crate::front::types::{FNS, SYM_STATIC, TY_U64, TY_U8};
use crate::middle::ir::{
    BLOCKS, INSTS, IRFUNCS, IRFUNC_COUNT, Op, ir_append, ir_enter, ir_insert_before, ir_make,
};

// `--coverage` (front/contracts/flags.tach).
pub static mut COVERAGE: bool = false;

// The counters std has room for.
const MAP_SIZE: i64 = 65536;

// Whether IR function fi is counted: the program's, not std's nor a
// runtime's.
fn counted(fi: i64) -> bool {
    unsafe {
        let m = FNS[IRFUNCS[fi].f].module;
        m != STD_MODULE && (m != crate::middle::profile::PROFILE_MODULE || m < 0)
            && (m != crate::middle::unsafecheck::CHECK_MODULE || m < 0)
            && (m != crate::middle::trace::TRACE_MODULE || m < 0)
    }
}

// The first instruction of block b after its phis and parameters (0: none).
fn body_start(b: i64) -> i64 {
    unsafe {
        let mut v = BLOCKS[b].first;
        while v != 0 && (INSTS[v].op == Op::Phi || INSTS[v].op == Op::Param) {
            v = INSTS[v].next;
        }
        v
    }
}

// Counter k's increment (8 bits, wrapping), at the start of block b.
fn count_block(b: i64, k: i64, map: i64) {
    unsafe {
        let g = ir_make(Op::GAddr, TY_U64, 0, 0, map);
        let off = ir_make(Op::Const, TY_U64, 0, 0, k % MAP_SIZE);
        let a = ir_make(Op::Add, TY_U64, g, off, 0);
        let c = ir_make(Op::Load, TY_U8, a, 0, 0);
        let one = ir_make(Op::Const, TY_U8, 0, 0, 1);
        let c1 = ir_make(Op::Add, TY_U8, c, one, 0);
        let s = ir_make(Op::Store, 0, a, c1, 0);
        INSTS[s].imm2 = TY_U8;
        let list: [i64; 7] = [g, off, a, c, one, c1, s];
        let at = body_start(b);
        for i in 0..7 {
            if at == 0 {
                ir_append(b, list[i]);
            } else {
                ir_insert_before(at, list[i]);
            }
        }
    }
}

// After lowering, with --coverage: every counted block's increment
// (nothing when std's map is not in the program: no fuzz target uses it).
pub fn coverage_after_lowering() {
    unsafe {
        if !COVERAGE {
            return;
        }
        let map = intern_c(c"std.COVERAGE_MAP");
        if SYM_STATIC[map] == 0 {
            return;
        }
        let mut k = 0;
        for fi in 0..IRFUNC_COUNT {
            if !counted(fi) {
                continue;
            }
            ir_enter(fi);
            let n = IRFUNCS[fi].blocks.count;
            for i in 0..n {
                count_block(IRFUNCS[fi].blocks.data[i], k, map);
                k += 1;
            }
        }
    }
}
