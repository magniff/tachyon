use crate::middle::ctx::FnCtx;
use crate::middle::exits::count_loop_exits;
use crate::middle::fold::instcombine;
use crate::middle::fold::lattice::sccp;
use crate::middle::gvn::run_gvn;
use crate::middle::gvn_calls::repeated_pure_calls;
use crate::middle::ifconv::if_convert_loops;
use crate::middle::inline::{
    FN_ADDRESS, FN_CALLS, FN_LIVE, FN_SCC, FN_SIZE, SCC_ORDER, compute_sccs, count_call_sites,
    forget_fn_caches, func_size, init_fn_caches, inline_rounds, inlined_everywhere, ir_callee,
    optimize_with_leaves, simplify_inlining_leaves, start_inlining_budget,
};
