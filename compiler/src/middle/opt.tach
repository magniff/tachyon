use crate::base::{IntVec, alloc_array, die, free};
use crate::base::timer::{
    T_ATTRS, T_GLOBAL_DCE, T_HEAP, T_INLINE, T_IPCP, T_LICM, T_LOOPS, T_PROMOTE, T_SCALAR, T_SLP,
    T_TRE, timer_add, timer_now,
};
use crate::front::modules::{STD_MODULE, module_of};
use crate::front::types::FNS;
use crate::gen0::gen::fn_is_global;
use crate::middle::adce::aggressive_dce;
