// Jump threading on constant tags (0.14): a block whose switch decides on
// a phi (a `match` on an enum's tag), or whose branch compares one with a
// constant (`if let`), is copied for each predecessor that gives the phi a
// constant, and the copy goes on to that constant's outcome directly. This
// is what makes `loop { match it.next() { Some(x) => .., None => break } }`
// a plain loop once `next` is inlined: each return of `next` built its tag
// as a constant. A block holding only phis that jumps to such a block, with
// the tag's phi among them, is merged into it first (what the arms of an
// `if` leave). The values the block defines are then read, where they are
// used, through the SSA updater (as rotation does, loops.tach), and a
// block no predecessor is left to is removed. A loop header threaded from
// its latch is peeled: the first iteration keeps the test, the copy is the
// new header.

use crate::base::IntVec;
use crate::middle::fold::{fold_compare, is_const};
use crate::middle::ir::{
    ARGS, ARGTY, BLOCKS, INSTS, IRF, IRFUNCS, Op, Term, ir_append, ir_arg, ir_make, ir_new_block,
    ir_operand, ir_operand_count, ir_set_arg, ir_set_operand, ir_val,
};
use crate::middle::ir::cfg::{pred_index, redirect_succ, switch_target};
use crate::middle::loops::{clone_inst, seal_all};
use crate::middle::lower::ssa::{DEFS, new_synth_var, ssa_read, ssa_write};
use crate::middle::opt::{
    add_pred_like, remove_block, remove_pred_at, remove_trivial_phis, remove_unreachable,
    resolve_all,
};

// The blocks copied have at most this many instructions other than phis.
const THREAD_MAX_INSTS: i64 = 12;
// At most this many copies per call (a bound on growth).
const THREAD_MAX_COPIES: i64 = 64;

static mut COPIES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The chain of blocks being threaded (see decider_phi), marked STAMP in
// BLOCKS[].mark; the copies of one.
static mut CHAIN: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut COPY_OF: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut STAMP: i64 = 1000000000;
// At most this many blocks in a chain.
const MAX_CHAIN: i64 = 4;

// The phi that block j's terminator decides on, or 0: the switch's value,
// or an operand of the branch's comparison with a constant. The phi may be
// in an earlier block h, with j reached from h through blocks whose only
// predecessor is the one before (a loop's header testing its exit before
// the match): CHAIN is then h, those blocks, j. (0.16) Or the phi a branch
// is on, a bool (taken when it has a constant operand, see is_tag_phi).
fn decider_phi(j: i64) -> i64 {
    unsafe {
        let c = ir_val(BLOCKS[j].cond);
        if c == 0 || INSTS[c].block == 0 {
            return 0;
        }
        let mut phi = 0;
        if BLOCKS[j].term == Term::Switch {
            if INSTS[c].op == Op::Phi {
                phi = c;
            }
        } else if BLOCKS[j].term == Term::Branch && INSTS[c].op == Op::Cmp
            && BLOCKS[j].s0 != BLOCKS[j].s1 {
            let a = ir_val(INSTS[c].a);
            let b = ir_val(INSTS[c].b);
            if INSTS[a].op == Op::Phi && is_const(b) {
                phi = a;
            } else if INSTS[b].op == Op::Phi && is_const(a) {
                phi = b;
            }
        } else if BLOCKS[j].term == Term::Branch && INSTS[c].op == Op::Phi
            && BLOCKS[j].s0 != BLOCKS[j].s1 {
            // (0.16) A branch on a phi of bools (a comparison of a phi of
            // constants with a constant, folded into the phi: fold.tach).
            phi = c;
        }
        if phi == 0 {
            return 0;
        }
        // The chain from the phi's block to j.
        let h = INSTS[phi].block;
        CHAIN.count = 0;
        let mut x = j;
        let mut size = 0;
        loop {
            CHAIN.push(x);
            size += body_size(x);
            if x == h {
                break;
            }
            if CHAIN.count > MAX_CHAIN || BLOCKS[x].preds.count != 1 {
                return 0;
            }
            x = BLOCKS[x].preds.data[0];
            if x == j || (x != h && BLOCKS[x].term != Term::Jump && BLOCKS[x].term != Term::Branch)
                || (BLOCKS[x].term == Term::Branch && BLOCKS[x].s0 == BLOCKS[x].s1) {
                return 0;
            }
        }
        if size > THREAD_MAX_INSTS || (h != j && BLOCKS[h].term != Term::Jump
            && BLOCKS[h].term != Term::Branch) {
            return 0;
        }
        // (h first)
        let n = CHAIN.count;
        for i in 0..n / 2 {
            let t = CHAIN.data[i];
            CHAIN.data[i] = CHAIN.data[n - 1 - i];
            CHAIN.data[n - 1 - i] = t;
        }
        // The comparison is in the chain.
        STAMP += 1;
        for i in 0..n {
            BLOCKS[CHAIN.data[i]].mark = STAMP;
        }
        if BLOCKS[INSTS[c].block].mark != STAMP {
            return 0;
        }
        phi
    }
}

// The successor of block j when its decider phi is the constant `value`.
fn outcome(j: i64, phi: i64, value: i64) -> i64 {
    unsafe {
        if BLOCKS[j].term == Term::Switch {
            return switch_target(j, INSTS[value].imm);
        }
        let c = ir_val(BLOCKS[j].cond);
        if c == phi {
            return if INSTS[value].imm != 0 { BLOCKS[j].s0 } else { BLOCKS[j].s1 };
        }
        let a = ir_val(INSTS[c].a);
        let b = ir_val(INSTS[c].b);
        let x = if a == phi { INSTS[value].imm } else { INSTS[a].imm };
        let y = if b == phi { INSTS[value].imm } else { INSTS[b].imm };
        if fold_compare(INSTS[c].cond, INSTS[c].imm2, x, y) { BLOCKS[j].s0 } else { BLOCKS[j].s1 }
    }
}

// The number of j's instructions other than phis.
fn body_size(j: i64) -> i64 {
    unsafe {
        let mut n = 0;
        let mut v = BLOCKS[j].first;
        while v != 0 {
            if INSTS[v].op != Op::Phi {
                n += 1;
            }
            v = INSTS[v].next;
        }
        n
    }
}

// Whether value w (a phi of block b) is used only by the phis of block j,
// as their operand for b.
fn used_only_by_phis(fi: i64, w: i64, b: i64, j: i64) -> bool {
    unsafe {
        let index = pred_index(j, b);
        for i in 0..IRFUNCS[fi].blocks.count {
            let u_block = IRFUNCS[fi].blocks.data[i];
            if BLOCKS[u_block].removed != 0 {
                continue;
            }
            if ir_val(BLOCKS[u_block].cond) == w && BLOCKS[u_block].cond != 0 {
                return false;
            }
            let mut u = BLOCKS[u_block].first;
            while u != 0 {
                for k in 0..ir_operand_count(u) {
                    if ir_val(ir_operand(u, k)) == w {
                        // (a phi's operands are 3.., one per predecessor)
                        if u_block != j || INSTS[u].op != Op::Phi || k - 3 != index {
                            return false;
                        }
                    }
                }
                u = INSTS[u].next;
            }
        }
        true
    }
}

// Merges block b (phis only, then a jump to j) into j: b's predecessors go
// to j, whose phis take, for each, what they took from b (a phi of b: its
// operand for that predecessor). Returns whether it did.
pub fn merge_phi_block(fi: i64, b: i64, j: i64) -> bool {
    unsafe {
        if b == j || b == IRFUNCS[fi].entry || BLOCKS[b].term != Term::Jump
            || BLOCKS[b].preds.count == 0 {
            return false;
        }
        let mut v = BLOCKS[b].first;
        while v != 0 {
            if INSTS[v].op != Op::Phi || !used_only_by_phis(fi, v, b, j) {
                return false;
            }
            v = INSTS[v].next;
        }
        for i in 0..BLOCKS[b].preds.count {
            let q = BLOCKS[b].preds.data[i];
            if q == b || pred_index(j, q) >= 0 {
                return false;
            }
        }
        let index = pred_index(j, b);
        for i in 0..BLOCKS[b].preds.count {
            let q = BLOCKS[b].preds.data[i];
            redirect_succ(q, b, j);
            add_pred_like(j, q, b);
            // The new operands: a phi of b gives its operand for q.
            let at = BLOCKS[j].preds.count - 1;
            let mut phi = BLOCKS[j].first;
            while phi != 0 && INSTS[phi].op == Op::Phi {
                let w = ir_val(ir_arg(phi, index));
                if INSTS[w].block == b {
                    ir_set_arg(phi, at, ir_val(ir_arg(w, i)));
                }
                phi = INSTS[phi].next;
            }
        }
        BLOCKS[b].preds.count = 0;
        remove_block(b);
        true
    }
}

// Copies the chain (CHAIN) for the predecessor at `index` of its first
// block, whose operand of the decider phi is a constant: the copies (their
// phis with one operand each, their instructions, their terminators, the
// last a jump to the outcome `target`) take that predecessor's edge. Each
// value of the chain gets its copy's value as a definition in the copy
// (INSTS[v].mark is v's updater variable + 1).
fn copy_chain(index: i64, target: i64) {
    unsafe {
        let h = CHAIN.data[0];
        let p = BLOCKS[h].preds.data[index];
        let first = COPY_OF.count;
        for i in 0..CHAIN.count {
            let nb = ir_new_block();
            BLOCKS[nb].sealed = 1;
            BLOCKS[nb].count = -1;
            COPY_OF.push(nb);
        }
        for i in 0..CHAIN.count {
            let x = CHAIN.data[i];
            let nb = COPY_OF.data[first + i];
            let mut v = BLOCKS[x].first;
            while v != 0 {
                let mut nv = 0;
                if INSTS[v].op == Op::Phi {
                    nv = ir_make(Op::Phi, INSTS[v].ty, 0, 0, 0);
                    INSTS[nv].args = ARGS.count;
                    INSTS[nv].nargs = 1;
                    let w = ir_val(ir_arg(v, if x == h { index } else { 0 }));
                    ARGS.push(if x != h && in_chain(w) { INSTS[w].aux } else { w });
                    ARGTY.push(0);
                } else {
                    nv = clone_inst(v);
                    for k in 0..ir_operand_count(nv) {
                        let w = ir_val(ir_operand(nv, k));
                        if in_chain(w) {
                            ir_set_operand(nv, k, INSTS[w].aux);
                        }
                    }
                }
                ir_append(nb, nv);
                INSTS[v].aux = nv;
                ssa_write(INSTS[v].mark - 1, nb, nv);
                v = INSTS[v].next;
            }
            if i + 1 == CHAIN.count {
                BLOCKS[nb].term = Term::Jump;
                BLOCKS[nb].s0 = target;
                add_pred_like(target, nb, x);
            } else {
                // The terminator: to the next block's copy, or out of the
                // chain as x goes.
                let next = CHAIN.data[i + 1];
                let c = ir_val(BLOCKS[x].cond);
                BLOCKS[nb].term = BLOCKS[x].term;
                BLOCKS[nb].cond = if in_chain(c) { INSTS[c].aux } else { BLOCKS[x].cond };
                for e in 0..2 {
                    let s = if e == 0 { BLOCKS[x].s0 } else { BLOCKS[x].s1 };
                    if s == 0 {
                        continue;
                    }
                    let ns = if s == next { COPY_OF.data[first + i + 1] } else { s };
                    if e == 0 {
                        BLOCKS[nb].s0 = ns;
                    } else {
                        BLOCKS[nb].s1 = ns;
                    }
                    if s == next {
                        BLOCKS[ns].preds.push(nb);
                    } else {
                        add_pred_like(s, nb, x);
                    }
                }
            }
        }
        let nh = COPY_OF.data[first];
        BLOCKS[nh].preds.push(p);
        redirect_succ(p, h, nh);
        remove_pred_at(h, index);
        COPY_OF.count = first;
    }
}

// Whether value w is defined in the chain being copied.
fn in_chain(w: i64) -> bool {
    unsafe { w != 0 && INSTS[w].block != 0 && BLOCKS[INSTS[w].block].mark == STAMP }
}

// Threads the chain ending in block j (see decider_phi): copies it for
// each predecessor of its first block giving the decider phi a constant,
// then repairs the uses of the chain's values. Returns the number of
// copies made.
fn thread_block(fi: i64, j: i64, phi: i64, budget: i64) -> i64 {
    unsafe {
        let h = CHAIN.data[0];
        // A predecessor holding only phis, one of them the tag, is merged
        // into h first.
        let mut k = 0;
        while k < BLOCKS[h].preds.count {
            let b = BLOCKS[h].preds.data[k];
            let w = ir_val(ir_arg(phi, k));
            if INSTS[w].op == Op::Phi && INSTS[w].block == b && BLOCKS[b].first != 0
                && has_const_operand(w) && BLOCKS[b].mark != STAMP && merge_phi_block(fi, b, h) {
                k = 0;
                continue;
            }
            k += 1;
        }
        // (pred, outcome) pairs to copy for.
        COPIES.count = 0;
        for i in 0..BLOCKS[h].preds.count {
            let p = BLOCKS[h].preds.data[i];
            let w = ir_val(ir_arg(phi, i));
            if !is_const(w) || BLOCKS[p].mark == STAMP
                || (BLOCKS[p].term == Term::Branch && BLOCKS[p].s0 == BLOCKS[p].s1) {
                continue;
            }
            let t = outcome(j, phi, w);
            if BLOCKS[t].mark == STAMP {
                continue;
            }
            COPIES.push(p);
            COPIES.push(t);
            if COPIES.count / 2 >= budget {
                break;
            }
        }
        if COPIES.count == 0 {
            return 0;
        }
        DEFS.clear();
        seal_all(fi);
        for i in 0..CHAIN.count {
            let x = CHAIN.data[i];
            let mut v = BLOCKS[x].first;
            while v != 0 {
                let var = new_synth_var(INSTS[v].ty);
                INSTS[v].mark = var + 1;
                ssa_write(var, x, v);
                v = INSTS[v].next;
            }
        }
        let n = COPIES.count / 2;
        for c in 0..n {
            let p = COPIES.data[2 * c];
            let t = COPIES.data[2 * c + 1];
            copy_chain(pred_index(h, p), t);
        }
        // Every use of the chain's values reads the definition reaching it
        // (but in the block defining it: that one), phis in their
        // predecessors.
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if BLOCKS[b].removed != 0 {
                continue;
            }
            let mut u = BLOCKS[b].first;
            while u != 0 {
                for k in 0..ir_operand_count(u) {
                    let w = ir_val(ir_operand(u, k));
                    if w != 0 && INSTS[w].block != 0 && BLOCKS[INSTS[w].block].mark == STAMP
                        && (INSTS[u].op == Op::Phi || INSTS[w].block != b) {
                        ir_set_operand(u, k, ssa_read(INSTS[w].mark - 1, use_block(u, k)));
                    }
                }
                u = INSTS[u].next;
            }
            let c = ir_val(BLOCKS[b].cond);
            if BLOCKS[b].cond != 0 && INSTS[c].block != 0 && BLOCKS[INSTS[c].block].mark == STAMP
                && INSTS[c].block != b {
                BLOCKS[b].cond = ssa_read(INSTS[c].mark - 1, b);
            }
        }
        for i in 0..CHAIN.count {
            let mut v = BLOCKS[CHAIN.data[i]].first;
            while v != 0 {
                INSTS[v].mark = 0;
                v = INSTS[v].next;
            }
        }
        n
    }
}

// Whether phi w has a constant operand.
fn has_const_operand(w: i64) -> bool {
    unsafe {
        for k in 0..INSTS[w].nargs {
            if is_const(ir_val(ir_arg(w, k))) {
                return true;
            }
        }
        false
    }
}

// The block where a use of an operand happens: the block of instruction u,
// or for a phi's k-th operand, the k-th predecessor of the phi's block.
fn use_block(u: i64, k: i64) -> i64 {
    unsafe {
        if INSTS[u].op == Op::Phi && k >= 3 {
            return BLOCKS[INSTS[u].block].preds.data[k - 3];
        }
        INSTS[u].block
    }
}

// Threads the blocks of function fi that decide on constant tags. Returns
// whether any was.
pub fn thread_tags(fi: i64) -> bool {
    unsafe {
        IRF = fi;
        let mut budget = THREAD_MAX_COPIES;
        let mut changed = false;
        let mut i = 0;
        while i < IRFUNCS[fi].blocks.count && budget > 0 {
            let j = IRFUNCS[fi].blocks.data[i];
            i += 1;
            if BLOCKS[j].removed != 0 || j == IRFUNCS[fi].entry || body_size(j) > THREAD_MAX_INSTS {
                continue;
            }
            let phi = decider_phi(j);
            if phi == 0 || !is_tag_phi(phi) {
                continue;
            }
            let n = thread_block(fi, j, phi, budget);
            if n > 0 {
                budget -= n;
                changed = true;
                resolve_all(fi);
                remove_unreachable(fi);
                remove_trivial_phis(fi);
            }
        }
        changed
    }
}

// Whether phi is a tag: its operands are constants or phis (of the blocks
// merged first, see thread_block), one at least constant or a phi with a
// constant operand. (An induction variable, whose operand from the latch
// is arithmetic, is not one: rotation takes care of its loop.)
fn is_tag_phi(phi: i64) -> bool {
    unsafe {
        let mut any = false;
        for k in 0..INSTS[phi].nargs {
            let w = ir_val(ir_arg(phi, k));
            if is_const(w) {
                any = true;
            } else if INSTS[w].op == Op::Phi && w != phi {
                if has_const_operand(w) {
                    any = true;
                }
            } else {
                return false;
            }
        }
        any
    }
}
