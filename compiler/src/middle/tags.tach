// Jump threading on constant tags (0.14): a block whose switch decides on
// a phi (a `match` on an enum's tag), or whose branch compares one with a
// constant (`if let`), is copied for each predecessor that gives the phi a
// constant, and the copy goes on to that constant's outcome directly. This
// is what makes `loop { match it.next() { Some(x) => .., None => break } }`
// a plain loop once `next` is inlined: each return of `next` built its tag
// as a constant. A block holding only phis that jumps to such a block, with
// the tag's phi among them, is merged into it first (what the arms of an
// `if` leave). The values the block defines are then read, where they are
// used, through the SSA updater (as rotation does, loops.tach), and a
// block no predecessor is left to is removed. A loop header threaded from
// its latch is peeled: the first iteration keeps the test, the copy is the
// new header.

use crate::middle::ctx::FnCtx;
use crate::middle::fold::{fold_compare, is_const};
use crate::middle::ir::{
    IRFUNCS, Op, Term, ir_append, ir_arg, ir_enter, ir_make, ir_new_block, ir_operand,
    ir_operand_count, ir_set_arg, ir_set_operand, ir_val,
};
use crate::middle::ir::cfg::{pred_index, redirect_succ, switch_target};
use crate::middle::loops::{clone_inst, seal_all};
use crate::middle::lower::ssa::{new_synth_var, ssa_read, ssa_write};
use crate::middle::opt::{
    add_pred_like, remove_block, remove_pred_at, remove_trivial_phis, remove_unreachable,
    resolve_all,
};

// The blocks copied have at most this many instructions other than phis.
const THREAD_MAX_INSTS: i64 = 12;
// At most this many copies per call (a bound on growth).
const THREAD_MAX_COPIES: i64 = 64;

// At most this many blocks in a chain.
const MAX_CHAIN: i64 = 4;

// The phi that block j's terminator decides on, or 0: the switch's value,
// or an operand of the branch's comparison with a constant. The phi may be
// in an earlier block h, with j reached from h through blocks whose only
// predecessor is the one before (a loop's header testing its exit before
// the match): CHAIN is then h, those blocks, j. (0.16) Or the phi a branch
// is on, a bool (taken when it has a constant operand, see is_tag_phi).
fn decider_phi(mut cx: *FnCtx, j: i64) -> i64 {
    unsafe {
        let c = ir_val(cx, cx.blocks[j].cond);
        if c == 0 || cx.insts[c].block == 0 {
            return 0;
        }
        let mut phi = 0;
        if cx.blocks[j].term == Term::Switch {
            if cx.insts[c].op == Op::Phi {
                phi = c;
            }
        } else if cx.blocks[j].term == Term::Branch && cx.insts[c].op == Op::Cmp
            && cx.blocks[j].s0 != cx.blocks[j].s1 {
            let a = ir_val(cx, cx.insts[c].a);
            let b = ir_val(cx, cx.insts[c].b);
            if cx.insts[a].op == Op::Phi && is_const(cx, b) {
                phi = a;
            } else if cx.insts[b].op == Op::Phi && is_const(cx, a) {
                phi = b;
            }
        } else if cx.blocks[j].term == Term::Branch && cx.insts[c].op == Op::Phi
            && cx.blocks[j].s0 != cx.blocks[j].s1 {
            // (0.16) A branch on a phi of bools (a comparison of a phi of
            // constants with a constant, folded into the phi: fold.tach).
            phi = c;
        }
        if phi == 0 {
            return 0;
        }
        // The chain from the phi's block to j.
        let h = cx.insts[phi].block;
        cx.chain.count = 0;
        let mut x = j;
        let mut size = 0;
        loop {
            cx.chain.push(x);
            size += body_size(cx, x);
            if x == h {
                break;
            }
            if cx.chain.count > MAX_CHAIN || cx.blocks[x].preds.count != 1 {
                return 0;
            }
            x = cx.blocks[x].preds.data[0];
            if x == j
                || (x != h && cx.blocks[x].term != Term::Jump && cx.blocks[x].term != Term::Branch)
                || (cx.blocks[x].term == Term::Branch && cx.blocks[x].s0 == cx.blocks[x].s1) {
                return 0;
            }
        }
        if size > THREAD_MAX_INSTS || (h != j && cx.blocks[h].term != Term::Jump
            && cx.blocks[h].term != Term::Branch) {
            return 0;
        }
        // (h first)
        let n = cx.chain.count;
        for i in 0..n / 2 {
            let t = cx.chain.data[i];
            cx.chain.data[i] = cx.chain.data[n - 1 - i];
            cx.chain.data[n - 1 - i] = t;
        }
        // The comparison is in the chain.
        cx.tags_stamp += 1;
        for i in 0..n {
            cx.blocks[cx.chain.data[i]].mark = cx.tags_stamp;
        }
        if cx.blocks[cx.insts[c].block].mark != cx.tags_stamp {
            return 0;
        }
        phi
    }
}

// The successor of block j when its decider phi is the constant `value`.
fn outcome(mut cx: *FnCtx, j: i64, phi: i64, value: i64) -> i64 {
    unsafe {
        if cx.blocks[j].term == Term::Switch {
            return switch_target(cx, j, cx.insts[value].imm);
        }
        let c = ir_val(cx, cx.blocks[j].cond);
        if c == phi {
            return if cx.insts[value].imm != 0 { cx.blocks[j].s0 } else { cx.blocks[j].s1 };
        }
        let a = ir_val(cx, cx.insts[c].a);
        let b = ir_val(cx, cx.insts[c].b);
        let x = if a == phi { cx.insts[value].imm } else { cx.insts[a].imm };
        let y = if b == phi { cx.insts[value].imm } else { cx.insts[b].imm };
        if fold_compare(cx.insts[c].cond, cx.insts[c].imm2, x, y) { cx.blocks[j].s0 }
        else { cx.blocks[j].s1 }
    }
}

// The number of j's instructions other than phis.
fn body_size(mut cx: *FnCtx, j: i64) -> i64 {
    unsafe {
        let mut n = 0;
        let mut v = cx.blocks[j].first;
        while v != 0 {
            if cx.insts[v].op != Op::Phi {
                n += 1;
            }
            v = cx.insts[v].next;
        }
        n
    }
}

// Whether value w (a phi of block b) is used only by the phis of block j,
// as their operand for b.
fn used_only_by_phis(mut cx: *FnCtx, fi: i64, w: i64, b: i64, j: i64) -> bool {
    unsafe {
        let index = pred_index(cx, j, b);
        for i in 0..IRFUNCS[fi].blocks.count {
            let u_block = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[u_block].removed != 0 {
                continue;
            }
            if ir_val(cx, cx.blocks[u_block].cond) == w && cx.blocks[u_block].cond != 0 {
                return false;
            }
            let mut u = cx.blocks[u_block].first;
            while u != 0 {
                for k in 0..ir_operand_count(cx, u) {
                    if ir_val(cx, ir_operand(cx, u, k)) == w {
                        // (a phi's operands are 3.., one per predecessor)
                        if u_block != j || cx.insts[u].op != Op::Phi || k - 3 != index {
                            return false;
                        }
                    }
                }
                u = cx.insts[u].next;
            }
        }
        true
    }
}

// Merges block b (phis only, then a jump to j) into j: b's predecessors go
// to j, whose phis take, for each, what they took from b (a phi of b: its
// operand for that predecessor). Returns whether it did.
pub fn merge_phi_block(mut cx: *FnCtx, fi: i64, b: i64, j: i64) -> bool {
    unsafe {
        if b == j || b == IRFUNCS[fi].entry || cx.blocks[b].term != Term::Jump
            || cx.blocks[b].preds.count == 0 {
            return false;
        }
        let mut v = cx.blocks[b].first;
        while v != 0 {
            if cx.insts[v].op != Op::Phi || !used_only_by_phis(cx, fi, v, b, j) {
                return false;
            }
            v = cx.insts[v].next;
        }
        for i in 0..cx.blocks[b].preds.count {
            let q = cx.blocks[b].preds.data[i];
            if q == b || pred_index(cx, j, q) >= 0 {
                return false;
            }
        }
        let index = pred_index(cx, j, b);
        for i in 0..cx.blocks[b].preds.count {
            let q = cx.blocks[b].preds.data[i];
            redirect_succ(cx, q, b, j);
            add_pred_like(cx, j, q, b);
            // The new operands: a phi of b gives its operand for q.
            let at = cx.blocks[j].preds.count - 1;
            let mut phi = cx.blocks[j].first;
            while phi != 0 && cx.insts[phi].op == Op::Phi {
                let w = ir_val(cx, ir_arg(cx, phi, index));
                if cx.insts[w].block == b {
                    ir_set_arg(cx, phi, at, ir_val(cx, ir_arg(cx, w, i)));
                }
                phi = cx.insts[phi].next;
            }
        }
        cx.blocks[b].preds.count = 0;
        remove_block(cx, b);
        true
    }
}

// Copies the chain (CHAIN) for the predecessor at `index` of its first
// block, whose operand of the decider phi is a constant: the copies (their
// phis with one operand each, their instructions, their terminators, the
// last a jump to the outcome `target`) take that predecessor's edge. Each
// value of the chain gets its copy's value as a definition in the copy
// (INSTS[v].mark is v's updater variable + 1).
fn copy_chain(mut cx: *FnCtx, index: i64, target: i64) {
    unsafe {
        let h = cx.chain.data[0];
        let p = cx.blocks[h].preds.data[index];
        let first = cx.copy_of.count;
        for i in 0..cx.chain.count {
            let nb = ir_new_block(cx);
            cx.blocks[nb].sealed = 1;
            cx.blocks[nb].count = -1;
            cx.copy_of.push(nb);
        }
        for i in 0..cx.chain.count {
            let x = cx.chain.data[i];
            let nb = cx.copy_of.data[first + i];
            let mut v = cx.blocks[x].first;
            while v != 0 {
                let mut nv = 0;
                if cx.insts[v].op == Op::Phi {
                    nv = ir_make(cx, Op::Phi, cx.insts[v].ty, 0, 0, 0);
                    cx.insts[nv].args = cx.args.count;
                    cx.insts[nv].nargs = 1;
                    let w = ir_val(cx, ir_arg(cx, v, if x == h { index } else { 0 }));
                    cx.args.push(if x != h && in_chain(cx, w) { cx.insts[w].aux } else { w });
                    cx.argty.push(0);
                } else {
                    nv = clone_inst(cx, v);
                    for k in 0..ir_operand_count(cx, nv) {
                        let w = ir_val(cx, ir_operand(cx, nv, k));
                        if in_chain(cx, w) {
                            ir_set_operand(cx, nv, k, cx.insts[w].aux);
                        }
                    }
                }
                ir_append(cx, nb, nv);
                cx.insts[v].aux = nv;
                ssa_write(cx, cx.insts[v].mark - 1, nb, nv);
                v = cx.insts[v].next;
            }
            if i + 1 == cx.chain.count {
                cx.blocks[nb].term = Term::Jump;
                cx.blocks[nb].s0 = target;
                add_pred_like(cx, target, nb, x);
            } else {
                // The terminator: to the next block's copy, or out of the
                // chain as x goes.
                let next = cx.chain.data[i + 1];
                let c = ir_val(cx, cx.blocks[x].cond);
                cx.blocks[nb].term = cx.blocks[x].term;
                cx.blocks[nb].cond = if in_chain(cx, c) { cx.insts[c].aux }
                    else { cx.blocks[x].cond };
                for e in 0..2 {
                    let s = if e == 0 { cx.blocks[x].s0 } else { cx.blocks[x].s1 };
                    if s == 0 {
                        continue;
                    }
                    let ns = if s == next { cx.copy_of.data[first + i + 1] } else { s };
                    if e == 0 {
                        cx.blocks[nb].s0 = ns;
                    } else {
                        cx.blocks[nb].s1 = ns;
                    }
                    if s == next {
                        cx.blocks[ns].preds.push(nb);
                    } else {
                        add_pred_like(cx, s, nb, x);
                    }
                }
            }
        }
        let nh = cx.copy_of.data[first];
        cx.blocks[nh].preds.push(p);
        redirect_succ(cx, p, h, nh);
        remove_pred_at(cx, h, index);
        cx.copy_of.count = first;
    }
}

// Whether value w is defined in the chain being copied.
fn in_chain(mut cx: *FnCtx, w: i64) -> bool {
    unsafe {
        w != 0 && cx.insts[w].block != 0 && cx.blocks[cx.insts[w].block].mark == cx.tags_stamp
    }
}

// Threads the chain ending in block j (see decider_phi): copies it for
// each predecessor of its first block giving the decider phi a constant,
// then repairs the uses of the chain's values. Returns the number of
// copies made.
fn thread_block(mut cx: *FnCtx, fi: i64, j: i64, phi: i64, budget: i64) -> i64 {
    unsafe {
        let h = cx.chain.data[0];
        // A predecessor holding only phis, one of them the tag, is merged
        // into h first.
        let mut k = 0;
        while k < cx.blocks[h].preds.count {
            let b = cx.blocks[h].preds.data[k];
            let w = ir_val(cx, ir_arg(cx, phi, k));
            if cx.insts[w].op == Op::Phi && cx.insts[w].block == b && cx.blocks[b].first != 0
                && has_const_operand(cx, w) && cx.blocks[b].mark != cx.tags_stamp
                && merge_phi_block(cx, fi, b, h) {
                k = 0;
                continue;
            }
            k += 1;
        }
        // (pred, outcome) pairs to copy for.
        cx.tags_copies.count = 0;
        for i in 0..cx.blocks[h].preds.count {
            let p = cx.blocks[h].preds.data[i];
            let w = ir_val(cx, ir_arg(cx, phi, i));
            if !is_const(cx, w) || cx.blocks[p].mark == cx.tags_stamp
                || (cx.blocks[p].term == Term::Branch && cx.blocks[p].s0 == cx.blocks[p].s1) {
                continue;
            }
            let t = outcome(cx, j, phi, w);
            if cx.blocks[t].mark == cx.tags_stamp {
                continue;
            }
            cx.tags_copies.push(p);
            cx.tags_copies.push(t);
            if cx.tags_copies.count / 2 >= budget {
                break;
            }
        }
        if cx.tags_copies.count == 0 {
            return 0;
        }
        cx.defs.clear();
        seal_all(cx, fi);
        for i in 0..cx.chain.count {
            let x = cx.chain.data[i];
            let mut v = cx.blocks[x].first;
            while v != 0 {
                let var = new_synth_var(cx, cx.insts[v].ty);
                cx.insts[v].mark = var + 1;
                ssa_write(cx, var, x, v);
                v = cx.insts[v].next;
            }
        }
        let n = cx.tags_copies.count / 2;
        for c in 0..n {
            let p = cx.tags_copies.data[2 * c];
            let t = cx.tags_copies.data[2 * c + 1];
            copy_chain(cx, pred_index(cx, h, p), t);
        }
        // Every use of the chain's values reads the definition reaching it
        // (but in the block defining it: that one), phis in their
        // predecessors.
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            let mut u = cx.blocks[b].first;
            while u != 0 {
                for k in 0..ir_operand_count(cx, u) {
                    let w = ir_val(cx, ir_operand(cx, u, k));
                    if w != 0 && cx.insts[w].block != 0
                        && cx.blocks[cx.insts[w].block].mark == cx.tags_stamp
                        && (cx.insts[u].op == Op::Phi || cx.insts[w].block != b) {
                        ir_set_operand(cx, u, k,
                            ssa_read(cx, cx.insts[w].mark - 1, use_block(cx, u, k)));
                    }
                }
                u = cx.insts[u].next;
            }
            let c = ir_val(cx, cx.blocks[b].cond);
            if cx.blocks[b].cond != 0 && cx.insts[c].block != 0
                && cx.blocks[cx.insts[c].block].mark == cx.tags_stamp
                && cx.insts[c].block != b {
                cx.blocks[b].cond = ssa_read(cx, cx.insts[c].mark - 1, b);
            }
        }
        for i in 0..cx.chain.count {
            let mut v = cx.blocks[cx.chain.data[i]].first;
            while v != 0 {
                cx.insts[v].mark = 0;
                v = cx.insts[v].next;
            }
        }
        n
    }
}

// Whether phi w has a constant operand.
fn has_const_operand(mut cx: *FnCtx, w: i64) -> bool {
    unsafe {
        for k in 0..cx.insts[w].nargs {
            if is_const(cx, ir_val(cx, ir_arg(cx, w, k))) {
                return true;
            }
        }
        false
    }
}

// The block where a use of an operand happens: the block of instruction u,
// or for a phi's k-th operand, the k-th predecessor of the phi's block.
fn use_block(mut cx: *FnCtx, u: i64, k: i64) -> i64 {
    unsafe {
        if cx.insts[u].op == Op::Phi && k >= 3 {
            return cx.blocks[cx.insts[u].block].preds.data[k - 3];
        }
        cx.insts[u].block
    }
}

// Threads the blocks of function fi that decide on constant tags. Returns
// whether any was.
pub fn thread_tags(mut cx: *FnCtx, fi: i64) -> bool {
    unsafe {
        ir_enter(cx, fi);
        let mut budget = THREAD_MAX_COPIES;
        let mut changed = false;
        let mut i = 0;
        while i < IRFUNCS[fi].blocks.count && budget > 0 {
            let j = IRFUNCS[fi].blocks.data[i];
            i += 1;
            if cx.blocks[j].removed != 0 || j == IRFUNCS[fi].entry
                || body_size(cx, j) > THREAD_MAX_INSTS {
                continue;
            }
            let phi = decider_phi(cx, j);
            if phi == 0 || !is_tag_phi(cx, phi) {
                continue;
            }
            let n = thread_block(cx, fi, j, phi, budget);
            if n > 0 {
                budget -= n;
                changed = true;
                resolve_all(cx, fi);
                remove_unreachable(cx, fi);
                remove_trivial_phis(cx, fi);
            }
        }
        changed
    }
}

// Whether phi is a tag: its operands are constants or phis (of the blocks
// merged first, see thread_block), one at least constant or a phi with a
// constant operand. (An induction variable, whose operand from the latch
// is arithmetic, is not one: rotation takes care of its loop.)
fn is_tag_phi(mut cx: *FnCtx, phi: i64) -> bool {
    unsafe {
        let mut any = false;
        for k in 0..cx.insts[phi].nargs {
            let w = ir_val(cx, ir_arg(cx, phi, k));
            if is_const(cx, w) {
                any = true;
            } else if cx.insts[w].op == Op::Phi && w != phi {
                if has_const_operand(cx, w) {
                    any = true;
                }
            } else {
                return false;
            }
        }
        any
    }
}
