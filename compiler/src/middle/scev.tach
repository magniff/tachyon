// Induction variables, trip counts, exit values, dead loop deletion and
// unrolling (0.4). The loops here are canonical (loops.tach) and rotated:
// their only exit is the branch at the end of the latch, back to the
// header or out to the single exit block.
//
// An induction variable is a header phi {start, +, step}: its operand from
// the preheader is `start`, its operand from the latch is the phi plus a
// constant `step`. The trip count (how many times the body runs) is found
// for constant starts by evaluating the exit test iteration by iteration
// with the folding rules of fold.tach (so wrapping is exactly what the
// machine does). A counted loop continues while `next < n` (`next` the
// induction variable plus 1, `n` invariant, the loop entered only when
// `start < n`) or `next != n` (or the same downwards with `>` and a step of
// -1): it is finite, it runs n - start times, and an induction variable's
// value at the exit is an expression computed in the preheader.

use crate::base::{IntVec, free};
use crate::front::consteval::wrap_int;
use crate::front::types::{TY_I64, TY_U64, int_bits, is_integer, is_signed};
use crate::middle::ctx::FnCtx;
use crate::middle::fold::{fold_compare, fold_makes_nan, fold_value, is_const};
use crate::middle::ipo::has_effect;
use crate::middle::ir::{
    Cond, IRFUNCS, Op, Term, ir_append, ir_arg, ir_enter, ir_make, ir_replace, ir_set_arg, ir_val,
};
use crate::middle::ir::Op::{Add, Cmp, Const, Conv, Mul, Phi, Sub};
use crate::middle::ir::cfg::{pred_index, succ, succ_count};
use crate::middle::ir::verify::verify_func;
use crate::middle::loops::{
    canonicalize_loops, clone_map, clone_region, form_lcssa, invariant_in, is_canonical,
    is_innermost, loop_block, loop_contains, loop_count, loop_header, loop_inst_count, loop_latch,
    loop_preheader, loop_size, mark_loop_blocks,
};
use crate::middle::opt::{remove_pred, remove_trivial_phis, remove_unreachable, resolve_all};
use crate::middle::profile::{is_cold_block, is_hot_count};
use crate::middle::range::bits_of_value;
use crate::middle::vectorize::vectorizable_lanes;

const UNROLL_FULL_TRIPS: i64 = 16;
const UNROLL_FULL_SIZE: i64 = 160;
const UNROLL_PARTIAL_SIZE: i64 = 96;
const SIM_MAX_TRIPS: i64 = 4096;

// The exit block of loop l when its only exit is the latch's branch, else 0.
fn latch_exit(mut cx: *FnCtx, l: i64) -> i64 {
    unsafe {
        let h = loop_header(cx, l);
        let latch = loop_latch(cx, l);
        if latch == 0 || loop_preheader(cx, l) == 0 || cx.blocks[latch].term != Term::Branch {
            return 0;
        }
        let s0 = cx.blocks[latch].s0;
        let s1 = cx.blocks[latch].s1;
        if (s0 == h) == (s1 == h) {
            return 0;
        }
        let exit = if s0 == h { s1 } else { s0 };
        if loop_contains(cx, l, exit) {
            return 0;
        }
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            if b == latch {
                continue;
            }
            for k in 0..succ_count(cx, b) {
                if !loop_contains(cx, l, succ(cx, b, k)) {
                    return 0;
                }
            }
        }
        if cx.blocks[exit].preds.count != 1 {
            return 0;
        }
        exit
    }
}

// The constant step of header phi `phi` of loop l (an induction variable),
// in *step; false when it is not one.
pub fn iv_step(mut cx: *FnCtx, l: i64, phi: i64, step: &mut i64) -> bool {
    unsafe {
        let latch = loop_latch(cx, l);
        let h = loop_header(cx, l);
        if cx.insts[phi].op != Phi || cx.insts[phi].block != h || !is_integer(cx.insts[phi].ty) {
            return false;
        }
        let next = ir_val(cx, ir_arg(cx, phi, pred_index(cx, h, latch)));
        if cx.insts[next].ty != cx.insts[phi].ty {
            return false;
        }
        // A chain of additions and subtractions of constants (as unrolling
        // leaves them), back to the phi.
        let ty = cx.insts[phi].ty;
        let mut total = 0;
        let mut x = next;
        for _ in 0..16 {
            if x == phi {
                *step = wrap_int(total, ty);
                return x != next;
            }
            let op = cx.insts[x].op;
            let a = ir_val(cx, cx.insts[x].a);
            let b = ir_val(cx, cx.insts[x].b);
            if cx.insts[x].ty != ty || (op != Add && op != Sub) {
                return false;
            }
            if is_const(cx, b) {
                total = if op == Add { total + cx.insts[b].imm } else { total - cx.insts[b].imm };
                x = a;
            } else if op == Add && is_const(cx, a) {
                total += cx.insts[a].imm;
                x = b;
            } else {
                return false;
            }
        }
        false
    }
}

pub fn iv_start(mut cx: *FnCtx, l: i64, phi: i64) -> i64 {
    ir_val(cx, ir_arg(cx, phi, pred_index(cx, loop_header(cx, l), loop_preheader(cx, l))))
}

fn iv_next(mut cx: *FnCtx, l: i64, phi: i64) -> i64 {
    ir_val(cx, ir_arg(cx, phi, pred_index(cx, loop_header(cx, l), loop_latch(cx, l))))
}

// ---- Constant trip counts ----

// The value of v in the current iteration of loop l, computed from the
// header phis' values; *ok becomes false when it cannot be.
fn sim_eval(mut cx: *FnCtx, l: i64, v: i64, ok: &mut bool) -> i64 {
    unsafe {
        if !*ok || v == 0 {
            *ok = false;
            return 0;
        }
        let op = cx.insts[v].op;
        if op == Const {
            return cx.insts[v].imm;
        }
        let b = cx.insts[v].block;
        if b == 0 || !loop_contains(cx, l, b) {
            *ok = false;
            return 0;
        }
        if cx.insts[v].mark == cx.sim_stamp {
            return cx.insts[v].aux;
        }
        let mut result = 0;
        if op == Phi {
            let mut found = false;
            for i in 0..cx.sim_phis.count {
                if cx.sim_phis.data[i] == v && cx.sim_known.data[i] != 0 {
                    result = cx.sim_value.data[i];
                    found = true;
                }
            }
            if !found {
                *ok = false;
                return 0;
            }
        } else if op.is_pure() {
            let a = sim_eval(cx, l, cx.insts[v].a, ok);
            let mut bv = 0;
            if op.is_binary() || op == Cmp {
                bv = sim_eval(cx, l, cx.insts[v].b, ok);
            }
            if !*ok {
                return 0;
            }
            result = fold_value(cx, v, a, bv);
            if fold_makes_nan(cx, v, result) {
                *ok = false;
                return 0;
            }
        } else {
            *ok = false;
            return 0;
        }
        cx.insts[v].mark = cx.sim_stamp;
        cx.insts[v].aux = result;
        result
    }
}

// The trip count of loop l (exit at the latch, `exit` its exit block) when
// it is a constant up to `max`, else -1.
fn constant_trip_count(mut cx: *FnCtx, l: i64, max: i64) -> i64 {
    unsafe {
        let h = loop_header(cx, l);
        let latch = loop_latch(cx, l);
        let pre = loop_preheader(cx, l);
        cx.sim_phis.count = 0;
        cx.sim_known.count = 0;
        cx.sim_value.count = 0;
        let mut phi = cx.blocks[h].first;
        while phi != 0 && cx.insts[phi].op == Phi {
            let start = ir_val(cx, ir_arg(cx, phi, pred_index(cx, h, pre)));
            cx.sim_phis.push(phi);
            cx.sim_known.push(if is_const(cx, start) { 1 } else { 0 });
            cx.sim_value.push(if is_const(cx, start) { cx.insts[start].imm } else { 0 });
            phi = cx.insts[phi].next;
        }
        let continue_if = cx.blocks[latch].s0 == h;
        let latch_index = pred_index(cx, h, latch);
        let mut nexts = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..cx.sim_phis.count {
            nexts.push(ir_val(cx, ir_arg(cx, cx.sim_phis.data[i], latch_index)));
        }
        let mut trips = -1;
        let mut k = 1;
        while k <= max {
            cx.sim_stamp += 1;
            let mut ok = true;
            let c = sim_eval(cx, l, cx.blocks[latch].cond, &mut ok);
            if !ok {
                break;
            }
            if (c != 0) != continue_if {
                trips = k;
                break;
            }
            // The phis' values in the next iteration.
            for i in 0..cx.sim_phis.count {
                let mut ok2 = true;
                let value = sim_eval(cx, l, nexts.data[i], &mut ok2);
                cx.sim_known.push(if ok2 { 1 } else { 0 });
                cx.sim_value.push(value);
            }
            let n = cx.sim_phis.count;
            for i in 0..n {
                cx.sim_known.data[i] = cx.sim_known.data[n + i];
                cx.sim_value.data[i] = cx.sim_value.data[n + i];
            }
            cx.sim_known.count = n;
            cx.sim_value.count = n;
            k += 1;
        }
        free(nexts.data as *u8);
        trips
    }
}

// ---- Counted loops and exit values ----

// The counted loop test of loop l: its induction variable (*iv), the
// constant step (+1 or -1), the bound (*bound) and whether the test is
// `!=` (*ne); false when the latch's test is not one.
pub fn counted_loop(mut cx: *FnCtx, l: i64, iv: &mut i64, step: &mut i64, bound: &mut i64,
    ne: &mut bool) -> bool {
    unsafe {
        let h = loop_header(cx, l);
        let latch = loop_latch(cx, l);
        let c = cx.blocks[latch].cond;
        if cx.insts[c].op != Cmp || !is_integer(cx.insts[c].imm2) {
            return false;
        }
        let mut cond = cx.insts[c].cond;
        let mut x = bits_of_value(cx, cx.insts[c].a);
        let mut n = bits_of_value(cx, cx.insts[c].b);
        if !invariant_in(cx, l, n) {
            let t = x;
            x = n;
            n = t;
            cond = cond.mirror();
        }
        if !invariant_in(cx, l, n) || invariant_in(cx, l, x) {
            return false;
        }
        if cx.blocks[latch].s0 != h {
            cond = cond.negate();
        }
        // x must be the next value of a header phi.
        let mut phi = cx.blocks[h].first;
        while phi != 0 && cx.insts[phi].op == Phi {
            let mut s = 0;
            if iv_next(cx, l, phi) == x && iv_step(cx, l, phi, &mut s)
                && int_bits(cx.insts[phi].ty) == int_bits(cx.insts[c].imm2) {
                let signed = is_signed(cx.insts[c].imm2);
                if s == 1 && (cond == Cond::Ne || cond == Cond::Lt) {
                    if cond == Cond::Lt
                        && !entry_implies(cx, l, iv_start(cx, l, phi), n, Cond::Lt, signed) {
                        return false;
                    }
                    *iv = phi;
                    *step = 1;
                    *bound = n;
                    *ne = cond == Cond::Ne;
                    return true;
                }
                if s == -1 && (cond == Cond::Ne || cond == Cond::Gt) {
                    if cond == Cond::Gt
                        && !entry_implies(cx, l, iv_start(cx, l, phi), n, Cond::Gt, signed) {
                        return false;
                    }
                    *iv = phi;
                    *step = -1;
                    *bound = n;
                    *ne = cond == Cond::Ne;
                    return true;
                }
                return false;
            }
            phi = cx.insts[phi].next;
        }
        false
    }
}

// Whether `a cond b` holds whenever loop l is entered: both constants, or a
// branch on that comparison (the guard loop rotation leaves) decides the
// way to the preheader: through blocks with a single predecessor, or
// (0.10) from a block dominating it (a guard an outer loop's made
// redundant).
fn entry_implies(mut cx: *FnCtx, l: i64, a: i64, b: i64, cond: Cond, signed: bool) -> bool {
    unsafe {
        let ty = if signed { TY_I64 } else { TY_U64 };
        if is_const(cx, a) && is_const(cx, b) {
            return fold_compare(cond, ty, cx.insts[a].imm, cx.insts[b].imm);
        }
        let mut x = loop_preheader(cx, l);
        for _ in 0..16 {
            if cx.blocks[x].preds.count != 1 {
                x = cx.blocks[x].idom;
                if x == 0 {
                    return false;
                }
                continue;
            }
            let p = cx.blocks[x].preds.data[0];
            if cx.blocks[p].term == Term::Branch && cx.blocks[p].s0 != cx.blocks[p].s1 {
                let c = cx.blocks[p].cond;
                if cx.insts[c].op == Cmp && is_signed(cx.insts[c].imm2) == signed {
                    let mut k = cx.insts[c].cond;
                    if cx.blocks[p].s0 != x {
                        k = k.negate();
                    }
                    let ca = bits_of_value(cx, cx.insts[c].a);
                    let cb = bits_of_value(cx, cx.insts[c].b);
                    if ca == a && cb == b && k == cond {
                        return true;
                    }
                    if ca == b && cb == a && k.mirror() == cond {
                        return true;
                    }
                }
            }
            x = p;
        }
        false
    }
}

// Replaces the exit values of induction variables of counted loop l (the
// operands of the exit block's phis) by expressions computed in the
// preheader. Returns whether any was.
fn replace_exit_values(mut cx: *FnCtx, fi: i64, l: i64, exit: i64) -> bool {
    unsafe {
        let mut iv = 0;
        let mut step = 0;
        let mut n = 0;
        let mut ne = false;
        if !counted_loop(cx, l, &mut iv, &mut step, &mut n, &mut ne) {
            return false;
        }
        ir_enter(cx, fi);
        let pre = loop_preheader(cx, l);
        let h = loop_header(cx, l);
        let ty = cx.insts[iv].ty;
        let start = iv_start(cx, l, iv);
        let mut trips = 0;
        let mut changed = false;
        let mut phi = cx.blocks[exit].first;
        while phi != 0 && cx.insts[phi].op == Phi {
            let w = ir_val(cx, ir_arg(cx, phi, 0));
            phi = cx.insts[phi].next;
            if invariant_in(cx, l, w) {
                continue;
            }
            // w is a header phi p or its next value, p {s2, +, c2}.
            let mut p = 0;
            let mut is_next = false;
            let mut x = cx.blocks[h].first;
            while x != 0 && cx.insts[x].op == Phi {
                if x == w {
                    p = x;
                    is_next = false;
                    break;
                }
                if p == 0 && iv_next(cx, l, x) == w {
                    p = x;
                    is_next = true;
                }
                x = cx.insts[x].next;
            }
            let mut c2 = 0;
            if p == 0 || !iv_step(cx, l, p, &mut c2) || int_bits(cx.insts[p].ty) > int_bits(ty) {
                continue;
            }
            let ty2 = cx.insts[p].ty;
            let mut value = 0;
            if p == iv && is_next {
                value = n;
                if cx.insts[n].ty != ty {
                    value = append_inst(cx, pre, Conv, ty, n, 0);
                    cx.insts[value].imm2 = cx.insts[n].ty;
                }
            } else {
                if trips == 0 {
                    trips = append_inst(cx, pre, Sub, ty, if step == 1 { n } else { start },
                        if step == 1 { start } else { n });
                }
                let mut count = trips;
                if ty2 != ty {
                    count = append_inst(cx, pre, Conv, ty2, trips, 0);
                    cx.insts[count].imm2 = ty;
                }
                if !is_next {
                    count = append_inst(cx, pre, Sub, ty2, count, append_const(cx, pre, 1, ty2));
                }
                let scaled = append_inst(cx, pre, Mul, ty2, count, append_const(cx, pre, c2, ty2));
                value = append_inst(cx, pre, Add, ty2, iv_start(cx, l, p), scaled);
            }
            set_exit_operand(cx, exit, w, value);
            changed = true;
        }
        changed
    }
}

// Sets the operand w of the phis of block `exit` (one predecessor) to v.
fn set_exit_operand(mut cx: *FnCtx, exit: i64, w: i64, v: i64) {
    unsafe {
        let mut phi = cx.blocks[exit].first;
        while phi != 0 && cx.insts[phi].op == Phi {
            if ir_val(cx, ir_arg(cx, phi, 0)) == w {
                ir_set_arg(cx, phi, 0, v);
            }
            phi = cx.insts[phi].next;
        }
    }
}

pub fn append_inst(mut cx: *FnCtx, b: i64, op: Op, ty: i64, a: i64, x: i64) -> i64 {
    let v = ir_make(cx, op, ty, a, x, 0);
    ir_append(cx, b, v);
    v
}

pub fn append_const(mut cx: *FnCtx, b: i64, value: i64, ty: i64) -> i64 {
    let v = ir_make(cx, Const, ty, 0, 0, wrap_int(value, ty));
    ir_append(cx, b, v);
    v
}

// Whether loop l is finite: a counted loop, or a constant trip count.
fn loop_is_finite(mut cx: *FnCtx, l: i64) -> bool {
    let mut iv = 0;
    let mut step = 0;
    let mut n = 0;
    let mut ne = false;
    counted_loop(cx, l, &mut iv, &mut step, &mut n, &mut ne)
        || constant_trip_count(cx, l, SIM_MAX_TRIPS) > 0
}

// Removes loop l (innermost, exit at the latch to `exit`) when it is
// finite, has no side effects and none of its values is used after it.
fn delete_dead_loop(mut cx: *FnCtx, fi: i64, l: i64, exit: i64) -> bool {
    unsafe {
        if !is_innermost(cx, l) {
            return false;
        }
        for i in 0..loop_size(cx, l) {
            let mut v = cx.blocks[loop_block(cx, l, i)].first;
            while v != 0 {
                if has_effect(cx, v) {
                    return false;
                }
                v = cx.insts[v].next;
            }
        }
        let mut phi = cx.blocks[exit].first;
        while phi != 0 && cx.insts[phi].op == Phi {
            if !invariant_in(cx, l, ir_val(cx, ir_arg(cx, phi, 0))) {
                return false;
            }
            phi = cx.insts[phi].next;
        }
        if !loop_is_finite(cx, l) {
            return false;
        }
        let pre = loop_preheader(cx, l);
        let latch = loop_latch(cx, l);
        // The preheader jumps to the exit instead (its phis keep their
        // operands, all defined before the loop).
        cx.blocks[exit].preds.data[0] = pre;
        cx.blocks[pre].s0 = exit;
        remove_pred(cx, loop_header(cx, l), pre);
        cx.blocks[latch].term = Term::Jump;
        cx.blocks[latch].s0 = loop_header(cx, l);
        cx.blocks[latch].s1 = 0;
        cx.blocks[latch].cond = 0;
        remove_unreachable(cx, fi);
        true
    }
}

// ---- Unrolling ----

// Unrolls loop l (exit at the latch to `exit`, in LCSSA form) whose trip
// count is the constant `trips`: fully (`factor` == trips) or by `factor`,
// which divides trips. All copies are made from the untouched loop first,
// then chained: each copy's header phis become the previous copy's values
// for the next iteration, each latch but the last jumps to the next copy.
fn unroll_loop(mut cx: *FnCtx, fi: i64, l: i64, exit: i64, trips: i64, factor: i64) {
    unsafe {
        ir_enter(cx, fi);
        let h = loop_header(cx, l);
        let latch = loop_latch(cx, l);
        let latch_index = pred_index(cx, h, latch);
        let stamp = mark_loop_blocks(cx, l);
        let mut region = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..cx.lp_list2.count {
            region.push(cx.lp_list2.data[i]);
        }
        let mut phis = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut phi = cx.blocks[h].first;
        while phi != 0 && cx.insts[phi].op == Phi {
            phis.push(phi);
            phi = cx.insts[phi].next;
        }
        let mut exits = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        phi = cx.blocks[exit].first;
        while phi != 0 && cx.insts[phi].op == Phi {
            exits.push(phi);
            phi = cx.insts[phi].next;
        }
        let np = phis.count;
        let ne = exits.count;
        // Per copy k: header, latch, header phis (np), next values (np), exit
        // values (ne).
        let mut hdr = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut lat = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut cphi = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut next = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut outv = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        hdr.push(h);
        lat.push(latch);
        for i in 0..np {
            cphi.push(phis.data[i]);
            next.push(ir_val(cx, ir_arg(cx, phis.data[i], latch_index)));
        }
        for i in 0..ne {
            outv.push(ir_val(cx, ir_arg(cx, exits.data[i], 0)));
        }
        for _ in 1..factor {
            clone_region(cx, fi, &region, stamp);
            hdr.push(cx.blocks[h].aux);
            lat.push(cx.blocks[latch].aux);
            for i in 0..np {
                cphi.push(cx.insts[phis.data[i]].aux);
                next.push(clone_map(cx, ir_val(cx, ir_arg(cx, phis.data[i], latch_index)), stamp));
            }
            for i in 0..ne {
                outv.push(clone_map(cx, ir_val(cx, ir_arg(cx, exits.data[i], 0)), stamp));
            }
        }
        for k in 1..factor {
            for i in 0..np {
                ir_replace(cx, cphi.data[k * np + i], next.data[(k - 1) * np + i]);
            }
            let ch = hdr.data[k];
            cx.blocks[ch].preds.count = 0;
            cx.blocks[ch].preds.push(lat.data[k - 1]);
            let pl = lat.data[k - 1];
            cx.blocks[pl].term = Term::Jump;
            cx.blocks[pl].cond = 0;
            cx.blocks[pl].s0 = ch;
            cx.blocks[pl].s1 = 0;
        }
        let last = lat.data[factor - 1];
        if factor == trips {
            cx.blocks[last].term = Term::Jump;
            cx.blocks[last].cond = 0;
            cx.blocks[last].s0 = exit;
            cx.blocks[last].s1 = 0;
            remove_pred(cx, h, latch);
        } else {
            // The last copy's branch went back to its own header.
            let own = hdr.data[factor - 1];
            if cx.blocks[last].s0 == own {
                cx.blocks[last].s0 = h;
            } else {
                cx.blocks[last].s1 = h;
            }
            cx.blocks[h].preds.data[latch_index] = last;
            for i in 0..np {
                ir_set_arg(cx, phis.data[i], latch_index, next.data[(factor - 1) * np + i]);
            }
        }
        cx.blocks[exit].preds.data[0] = last;
        for i in 0..ne {
            ir_set_arg(cx, exits.data[i], 0, outv.data[(factor - 1) * ne + i]);
        }
        free(region.data as *u8);
        free(phis.data as *u8);
        free(exits.data as *u8);
        free(hdr.data as *u8);
        free(lat.data as *u8);
        free(cphi.data as *u8);
        free(next.data as *u8);
        free(outv.data as *u8);
        resolve_all(cx, fi);
        remove_trivial_phis(cx, fi);
    }
}

// The trip count of loop l (in LCSSA form) when transform_loops would
// unroll it fully: its only exit the latch's, a constant number of trips,
// small enough; else 0.
pub fn full_unroll_trips(mut cx: *FnCtx, l: i64) -> i64 {
    if latch_exit(cx, l) == 0 {
        return 0;
    }
    let trips = constant_trip_count(cx, l, UNROLL_FULL_TRIPS);
    if trips < 1 || trips * loop_inst_count(cx, l) > UNROLL_FULL_SIZE
        || (is_cold_block(cx, loop_header(cx, l)) && trips > 1) {
        return 0;
    }
    trips
}

// Unrolls loop l when its trip count allows; returns whether it did.
fn try_unroll(mut cx: *FnCtx, fi: i64, l: i64, exit: i64) -> bool {
    let size = loop_inst_count(cx, l);
    let trips = constant_trip_count(cx, l, SIM_MAX_TRIPS);
    if trips < 1 {
        return false;
    }
    // (0.10: with a profile, a loop that never ran stays as it is, and a
    // hot one may grow twice as much)
    let h = loop_header(cx, l);
    if is_cold_block(cx, h) && trips > 1 {
        return false;
    }
    let partial = if is_hot_count(unsafe { cx.blocks[h].count }) { 2 * UNROLL_PARTIAL_SIZE }
        else { UNROLL_PARTIAL_SIZE };
    let mut factor = 0;
    if trips <= UNROLL_FULL_TRIPS && trips * size <= UNROLL_FULL_SIZE {
        factor = trips;
    } else if is_innermost(cx, l) && trips % 4 == 0 && 4 * size <= partial {
        factor = 4;
    } else if is_innermost(cx, l) && trips % 2 == 0 && 2 * size <= partial {
        factor = 2;
    }
    if factor < 2 && factor != trips {
        return false;
    }
    // (0.10: a loop the vectorizer takes, when it runs a vector iteration;
    // 0.11: against the loop fully unrolled when it would be)
    let lanes = vectorizable_lanes(cx, l, if factor == trips { trips } else { 0 });
    if lanes > 0 && trips >= lanes {
        return false;
    }
    if factor == 1 {
        // One trip: the loop is its body; dropping the back edge is all.
        let latch = loop_latch(cx, l);
        let h = loop_header(cx, l);
        unsafe {
            cx.blocks[latch].term = Term::Jump;
            cx.blocks[latch].cond = 0;
            cx.blocks[latch].s0 = exit;
            cx.blocks[latch].s1 = 0;
        }
        remove_pred(cx, h, latch);
        resolve_all(cx, fi);
        remove_trivial_phis(cx, fi);
        return true;
    }
    form_lcssa(cx, fi, l);
    resolve_all(cx, fi);
    unroll_loop(cx, fi, l, exit, trips, factor);
    true
}

// Exit values, dead loops and unrolling over the loops of fi, innermost
// first. Returns whether anything changed.
pub fn transform_loops(mut cx: *FnCtx, fi: i64) -> bool {
    unsafe {
        let mut changed = false;
        // Each loop is unrolled at most once: its header is remembered.
        let mut done = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for _ in 0..200 {
            canonicalize_loops(cx, fi);
            let mut did = false;
            // Deepest loops first.
            let mut best_depth = 0;
            for l in 0..loop_count(cx) {
                if cx.lp_depth.data[l] > best_depth {
                    best_depth = cx.lp_depth.data[l];
                }
            }
            let mut depth = best_depth;
            while depth >= 1 && !did {
                for l in 0..loop_count(cx) {
                    if cx.lp_depth.data[l] != depth || loop_header(cx, l) == IRFUNCS[fi].entry {
                        continue;
                    }
                    let h = loop_header(cx, l);
                    let mut seen = false;
                    for i in 0..done.count {
                        if done.data[i] == h {
                            seen = true;
                        }
                    }
                    if seen || !is_canonical(cx, l) {
                        continue;
                    }
                    let exit = latch_exit(cx, l);
                    if exit == 0 {
                        continue;
                    }
                    done.push(h);
                    form_lcssa(cx, fi, l);
                    resolve_all(cx, fi);
                    let replaced = replace_exit_values(cx, fi, l, exit);
                    if delete_dead_loop(cx, fi, l, exit) || try_unroll(cx, fi, l, exit)
                        || replaced {
                        did = true;
                        break;
                    }
                }
                depth -= 1;
            }
            if !did {
                break;
            }
            changed = true;
            resolve_all(cx, fi);
            remove_trivial_phis(cx, fi);
            verify_func(cx, fi, c"loop transformations");
        }
        free(done.data as *u8);
        changed
    }
}
