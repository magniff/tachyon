// Inlining, bottom-up over the call graph: functions are processed by
// strongly connected components (Tarjan's algorithm yields them callees
// first), so a callee is already optimized when it is inlined, and calls
// within a component (recursion) are never inlined. Whether a call is
// inlined is a cost model (see should_inline and docs/optimizer.md): the
// callee's size, less a bonus for the constant arguments that decide
// something in it and the cost of the call itself, against a threshold
// that grows with the call site's loop depth and is zero in cold blocks;
// a function's only call site takes up to INLINE_ONCE. Inlining iterates:
// the inlined copies' calls are considered again once the copies are
// simplified (see inline_rounds).

use crate::back::abi::{
    ABI_PIECE_COUNT, AbiClass, conv_classify, conv_returns_through_pointer, fn_uses_c,
};
use crate::back::regalloc::intervals::calls_returns_twice;
use crate::base::{IntVec, alloc_array, free};
use crate::front::ast::{FN_CLOSURE, NODES};
use crate::front::types::{FNS, fn_attr_cold, fn_attr_inline, fn_param, is_void, type_size};
use crate::gen0::gen::fn_is_global;
use crate::middle::fold::is_const;
use crate::middle::ipo::devirtualize;
use crate::middle::ir::{
    ARGS, ARGTY, BLOCKS, BLOCK_COUNT, FN_IR, INSTS, IRFUNCS, IRFUNC_COUNT, IRTables, IR_CUR, Op,
    SLOTS, Term, ir_append, ir_arg, ir_enter, ir_make, ir_new_block, ir_new_slot, ir_prepend,
    ir_replace, ir_set_arg, ir_unlink, ir_val, ir_view,
};
use crate::middle::ir::cfg::{
    case_target, case_value, copy_terminator, ir_switch_no_preds, pred_index, succ, succ_count,
};
use crate::middle::loops::{LP_DEPTH, analyze_loops, block_array, innermost_loop};
use crate::middle::lower::ssa::{SSA_STACK, ssa_undef};
use crate::middle::opt::{optimize_after_inlining, resolve_all};
use crate::middle::profile::{is_cold_block, is_hot_count};

const INLINE_SMALL: i64 = 30;
const INLINE_ONCE: i64 = 400;
const INLINE_BUDGET: i64 = 3000;
const INLINE_ROUNDS: i64 = 3;

// (0.14) The cost of a callee inlined whatever the budgets (see
// should_inline).
const INLINE_TINY: i64 = 2;
// The size a hot call site's callee may have (0.10, profiles).
const INLINE_HOT: i64 = 240;
// The bonus per constant argument whose parameter decides a branch, a
// switch or an arithmetic operation of the callee.
const CONST_ARG_BONUS: i64 = 10;

// The program's growth budget: the sum of the functions' sizes may reach
// PROGRAM_BUDGET.
static mut PROGRAM_SIZE: i64 = 0;
static mut PROGRAM_BUDGET: i64 = 0;

// ---- Inlining hints ----
//
// `#[inline]`, `#[inline(never)]` and `#[cold]` (the front end's
// fn_attr_inline: 1, -1 or 0; fn_attr_cold; types.tach).

const HINT_ALWAYS: i64 = 1;
const HINT_NEVER: i64 = -1;

// Per IR function: its component, size, number of direct call sites and
// whether its address is taken (FADDR).
pub static mut FN_SCC: *i64 = 0 as *i64;
pub static mut FN_SIZE: *i64 = 0 as *i64;
pub static mut FN_CALLS: *i64 = 0 as *i64;
pub static mut FN_ADDRESS: *i64 = 0 as *i64;
// Whether the function is emitted.
pub static mut FN_LIVE: *i64 = 0 as *i64;
// (0.17) Per IR function, once it is optimized (its component done):
// whether it calls a function that returns twice (1), or not (0); -1 not
// yet known. should_inline asked calls_returns_twice of the caller and the
// callee for every candidate call, a scan of both: a few percent of -O2.
pub static mut FN_RT: *i64 = 0 as *i64;

// (0.17) See deciders: -1 not yet known.
pub static mut FN_DECIDERS_START: *i64 = 0 as *i64;
static mut FN_DECIDERS_LEN: *i64 = 0 as *i64;
static mut DECIDERS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// (0.17) The inliner's caches of function information (FN_RT, deciders),
// for IRFUNC_COUNT functions, none known.
pub fn init_fn_caches() {
    unsafe {
        FN_RT = alloc_array::<i64>(IRFUNC_COUNT + 1);
        FN_DECIDERS_START = alloc_array::<i64>(IRFUNC_COUNT + 1);
        FN_DECIDERS_LEN = alloc_array::<i64>(IRFUNC_COUNT + 1);
        for fi in 0..IRFUNC_COUNT {
            FN_RT[fi] = -1;
            FN_DECIDERS_START[fi] = -1;
        }
    }
}

// Forgets what the caches know of fi (it changed).
pub fn forget_fn_caches(fi: i64) {
    unsafe {
        FN_RT[fi] = -1;
        FN_DECIDERS_START[fi] = -1;
    }
}
// Whether the function inline_calls works on calls one (it does not change
// while it inlines: only callees that do not are inlined).
static mut CALLER_RT: bool = false;

// The number of instructions that turn into code.
pub fn func_size(fi: i64) -> i64 {
    let mut size = 0;
    unsafe {
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if BLOCKS[b].removed != 0 {
                continue;
            }
            let mut v = BLOCKS[b].first;
            while v != 0 {
                if !INSTS[v].op.is_remat() && INSTS[v].op != Op::Param {
                    size += 1;
                }
                v = INSTS[v].next;
            }
            size += 1;
        }
    }
    size
}

// The IR function called by direct call v, or -1.
pub fn ir_callee(v: i64) -> i64 {
    unsafe {
        if INSTS[v].op != Op::Call {
            return -1;
        }
        FN_IR[INSTS[v].imm] - 1
    }
}

// Counts the call sites and address uses of every function.
pub fn count_call_sites() {
    unsafe {
        for fi in 0..IRFUNC_COUNT {
            FN_CALLS[fi] = 0;
            FN_ADDRESS[fi] = 0;
        }
        for fi in 0..IRFUNC_COUNT {
            if FN_LIVE[fi] == 0 {
                continue;
            }
            ir_enter(fi);
            for i in 0..IRFUNCS[fi].blocks.count {
                let b = IRFUNCS[fi].blocks.data[i];
                if BLOCKS[b].removed != 0 {
                    continue;
                }
                let mut v = BLOCKS[b].first;
                while v != 0 {
                    let g = ir_callee(v);
                    if g >= 0 {
                        FN_CALLS[g] += 1;
                    }
                    if INSTS[v].op == Op::FAddr && FN_IR[INSTS[v].imm] != 0 {
                        FN_ADDRESS[FN_IR[INSTS[v].imm] - 1] = 1;
                    }
                    v = INSTS[v].next;
                }
            }
        }
    }
}

// ---- Strongly connected components (Tarjan) ----

// The functions in the order to process them: components callees first.
pub static mut SCC_ORDER: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The direct callees of fi (with repeats), in `out`.
fn callees(fi: i64, out: *IntVec) {
    (*out).count = 0;
    unsafe {
        ir_enter(fi);
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if BLOCKS[b].removed != 0 {
                continue;
            }
            let mut v = BLOCKS[b].first;
            while v != 0 {
                let g = ir_callee(v);
                if g >= 0 {
                    out.push(g);
                }
                v = INSTS[v].next;
            }
        }
    }
}

pub fn compute_sccs() {
    unsafe {
        let n = IRFUNC_COUNT;
        let index = alloc_array::<i64>(n + 1);
        let low = alloc_array::<i64>(n + 1);
        let on_stack = alloc_array::<i64>(n + 1);
        // Adjacency, computed once (CSR).
        let adj_start = alloc_array::<i64>(n + 2);
        let mut adj = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut scratch = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for fi in 0..n {
            adj_start[fi] = adj.count;
            callees(fi, &scratch);
            for i in 0..scratch.count {
                adj.push(scratch.data[i]);
            }
        }
        adj_start[n] = adj.count;
        let mut stack = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut calls = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut next_index = 1;
        let mut scc_id = 0;
        SCC_ORDER.count = 0;
        for root in 0..n {
            if index[root] != 0 {
                continue;
            }
            // (node, next edge) frames.
            calls.push(root);
            calls.push(adj_start[root]);
            index[root] = next_index;
            low[root] = next_index;
            next_index += 1;
            stack.push(root);
            on_stack[root] = 1;
            while calls.count > 0 {
                let top = calls.count - 2;
                let v = calls.data[top];
                let e = calls.data[top + 1];
                if e < adj_start[v + 1] {
                    calls.data[top + 1] = e + 1;
                    let w = adj.data[e];
                    if index[w] == 0 {
                        index[w] = next_index;
                        low[w] = next_index;
                        next_index += 1;
                        stack.push(w);
                        on_stack[w] = 1;
                        calls.push(w);
                        calls.push(adj_start[w]);
                    } else if on_stack[w] != 0 && index[w] < low[v] {
                        low[v] = index[w];
                    }
                    continue;
                }
                calls.count -= 2;
                if calls.count > 0 {
                    let parent = calls.data[calls.count - 2];
                    if low[v] < low[parent] {
                        low[parent] = low[v];
                    }
                }
                if low[v] == index[v] {
                    loop {
                        let w = stack.pop();
                        on_stack[w] = 0;
                        FN_SCC[w] = scc_id;
                        SCC_ORDER.push(w);
                        if w == v {
                            break;
                        }
                    }
                    scc_id += 1;
                }
            }
        }
        free(index as *u8);
        free(low as *u8);
        free(on_stack as *u8);
        free(adj_start as *u8);
        free(adj.data as *u8);
        free(scratch.data as *u8);
        free(stack.data as *u8);
        free(calls.data as *u8);
    }
}

// ---- The policy ----

// Per block (by id): the loop depth of the call sites in it, and whether
// it is cold; set by mark_call_sites for the function being processed.
static mut SITE_DEPTH: *i64 = 0 as *i64;
static mut SITE_DEPTH_CAP: i64 = 0;
static mut SITE_COLD: *i64 = 0 as *i64;
static mut SITE_COLD_CAP: i64 = 0;
static mut SITE_NBLOCKS: i64 = 0;

// Whether block b is cold: it leads only to a panic (it ends in UNREACH),
// or it calls a #[cold] function.
fn block_is_cold(b: i64) -> bool {
    unsafe {
        if BLOCKS[b].term == Term::Unreach {
            return true;
        }
        let mut v = BLOCKS[b].first;
        while v != 0 {
            if INSTS[v].op == Op::Call && fn_attr_cold(INSTS[v].imm) {
                return true;
            }
            v = INSTS[v].next;
        }
        false
    }
}

fn mark_call_sites(fi: i64) {
    unsafe {
        resolve_all(fi);
        analyze_loops(fi);
        SITE_DEPTH = block_array(SITE_DEPTH, &SITE_DEPTH_CAP, fi);
        SITE_COLD = block_array(SITE_COLD, &SITE_COLD_CAP, fi);
        SITE_NBLOCKS = BLOCK_COUNT;
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if BLOCKS[b].removed != 0 {
                continue;
            }
            let l = innermost_loop(b);
            SITE_DEPTH[b] = if l >= 0 { LP_DEPTH.data[l] } else { 0 };
            SITE_COLD[b] = if block_is_cold(b) { 1 } else { 0 };
        }
    }
}

// The operand of a call holding the value of PARAM instruction p of
// callee g (its piece, for an aggregate passed in pieces), or -1.
pub fn param_operand(g: i64, p: i64) -> i64 {
    unsafe {
        let index = INSTS[p].imm;
        let piece = INSTS[p].imm2;
        if index < 0 {
            return -1;
        }
        let callee_f = IRFUNCS[g].f;
        let mut k = 0;
        for q in 0..index {
            let ty = fn_param(callee_f, q);
            if !is_void(ty) {
                k += if conv_classify(fn_uses_c(callee_f), ty)
                    == AbiClass::Pieces { ABI_PIECE_COUNT } else { 1 };
            }
        }
        k + if piece > 0 { piece - 1 } else { 0 }
    }
}

// Whether value p decides something in function g: it is compared,
// switched on, or an operand of a multiplication, division, shift or mask
// (a constant there folds in the copy).
fn decides(g: i64, p: i64) -> bool {
    unsafe {
        for i in 0..IRFUNCS[g].blocks.count {
            let b = IRFUNCS[g].blocks.data[i];
            if BLOCKS[b].removed != 0 {
                continue;
            }
            if BLOCKS[b].term == Term::Switch && ir_val(BLOCKS[b].cond) == p {
                return true;
            }
            let mut v = BLOCKS[b].first;
            while v != 0 {
                let op = INSTS[v].op;
                if op == Op::Cmp || op == Op::Mul || op == Op::Div || op == Op::Rem
                    || op == Op::Shl || op == Op::Shr || op == Op::And {
                    if ir_val(INSTS[v].a) == p || ir_val(INSTS[v].b) == p {
                        return true;
                    }
                }
                v = INSTS[v].next;
            }
        }
    }
    false
}

// The cost of inlining callee g at call `call`: its size, less the bonus
// for constant arguments that decide something in it, less the call's own
// cost (its argument moves, the call and the result). (0.17: which of g's
// parameters decide something is found once g is optimized, deciders.)
fn inline_cost(g: i64, call: i64) -> i64 {
    unsafe {
        let nargs = INSTS[call].nargs;
        let mut cost = FN_SIZE[g];
        let start = deciders(g);
        for i in start..start + FN_DECIDERS_LEN[g] {
            let k = DECIDERS.data[i];
            if k < nargs && is_const(ir_val(ir_arg(call, k))) {
                cost -= CONST_ARG_BONUS;
            }
        }
        cost - 2 - nargs
    }
}

// The call operands of g's parameters that decide something in it (one
// per parameter instruction, in order): DECIDERS[deciders(g) ..
// + FN_DECIDERS_LEN[g]], found once g is optimized (reset with FN_RT).
fn deciders(g: i64) -> i64 {
    unsafe {
        if FN_DECIDERS_START[g] < 0 {
            let back = IR_CUR;
            ir_enter(g);
            FN_DECIDERS_START[g] = DECIDERS.count;
            let entry = IRFUNCS[g].entry;
            let mut v = BLOCKS[entry].first;
            while v != 0 {
                if INSTS[v].op == Op::Param {
                    let k = param_operand(g, v);
                    if k >= 0 && decides(g, v) {
                        DECIDERS.push(k);
                    }
                }
                v = INSTS[v].next;
            }
            FN_DECIDERS_LEN[g] = DECIDERS.count - FN_DECIDERS_START[g];
            ir_enter(back);
        }
        FN_DECIDERS_START[g]
    }
}

fn site_depth(b: i64) -> i64 {
    if b < SITE_NBLOCKS { unsafe { SITE_DEPTH[b] } } else { 0 }
}

fn site_cold(b: i64) -> bool {
    unsafe { b < SITE_NBLOCKS && SITE_COLD[b] != 0 }
}

// Whether optimized function g calls a function that returns twice (see
// FN_RT).
fn callee_returns_twice(g: i64) -> bool {
    (callee_flags(g) & RT_RETURNS_TWICE) != 0
}

// Whether optimized function g calls nothing (0.17: see should_inline).
fn callee_is_leaf(g: i64) -> bool {
    (callee_flags(g) & RT_CALLS) == 0
}

// FN_RT[g], computed once g is optimized.
fn callee_flags(g: i64) -> i64 {
    unsafe {
        if FN_RT[g] < 0 {
            let back = IR_CUR;
            ir_enter(g);
            let mut flags = if calls_returns_twice(g) { RT_RETURNS_TWICE } else { 0 };
            for b in IRFUNCS[g].blocks.items() {
                if BLOCKS[b].removed == 0 {
                    let mut v = BLOCKS[b].first;
                    while v != 0 {
                        if INSTS[v].op.is_call() {
                            flags = flags | RT_CALLS;
                        }
                        v = INSTS[v].next;
                    }
                }
            }
            FN_RT[g] = flags;
            ir_enter(back);
        }
        FN_RT[g]
    }
}

const RT_RETURNS_TWICE: i64 = 1;
const RT_CALLS: i64 = 2;
// (0.17) A leaf this small is inlined whatever the program's budget (see
// should_inline).
const INLINE_LEAF: i64 = 6;

fn should_inline(fi: i64, g: i64, call: i64) -> bool {
    unsafe {
        if g == fi || FN_SCC[g] == FN_SCC[fi] || FN_LIVE[g] == 0 {
            return false;
        }
        // A function calling setjmp (or the like) keeps its own frame, and
        // its callers theirs (see regalloc.tach).
        if CALLER_RT || callee_returns_twice(g) {
            return false;
        }
        let gf = IRFUNCS[g].f;
        let hint = fn_attr_inline(gf);
        if hint == HINT_NEVER || fn_attr_cold(gf) {
            return false;
        }
        if hint == HINT_ALWAYS {
            return true;
        }
        // (0.14) A callee about as big as its call is inlined whatever the
        // caller's size: the chain of small closures an iterator chain calls,
        // `as_slice`.
        // (0.17: computed once; it scans the callee for what each constant
        // argument decides)
        let cost = inline_cost(g, call);
        if cost <= INLINE_TINY && PROGRAM_SIZE + FN_SIZE[g] <= PROGRAM_BUDGET {
            return true;
        }
        let b = INSTS[call].block;
        let once = FN_CALLS[g] == 1 && FN_ADDRESS[g] == 0 && !fn_is_global(gf);
        // A closure called once is inlined whatever its size: it is moved,
        // not copied, and its size before its environment is known (the
        // loads through it) says little of what it becomes (a closure
        // calling closures, the fold of an iterator chain).
        if once && is_closure_fn(g) {
            return true;
        }
        // (0.17) A small leaf is not charged to the program's budget: its
        // code is about its call's (the arguments' moves, the call, the
        // caller-saved registers it clobbers), and the program's callers,
        // last in the order, found the budget spent.
        let small_leaf = FN_SIZE[g] <= INLINE_LEAF && callee_is_leaf(g);
        if FN_SIZE[fi] + FN_SIZE[g] > INLINE_BUDGET
            || (PROGRAM_SIZE + FN_SIZE[g] > PROGRAM_BUDGET && !small_leaf) {
            return false;
        }
        // (0.10: with a profile, a call that never ran is cold, and a hot one
        // takes a callee up to INLINE_HOT)
        if site_cold(b) || is_cold_block(b) {
            // In a cold block, only when that makes the program no bigger.
            return once || cost <= 0;
        }
        if once && FN_SIZE[g] <= INLINE_ONCE {
            return true;
        }
        if is_hot_count(BLOCKS[b].count) && cost <= INLINE_HOT {
            return true;
        }
        let depth = site_depth(b);
        let mut threshold = INLINE_SMALL;
        if depth >= 1 {
            threshold *= 2;
        }
        if depth >= 2 {
            threshold *= 2;
        }
        cost <= threshold
    }
}

// Whether inlining function g is charged to the budgets only for what it
// adds once simplified (see inline_calls): `#[inline]` functions (the std
// iterator methods are) and closures' functions.
fn counted_after(g: i64) -> bool {
    unsafe { fn_attr_inline(IRFUNCS[g].f) == HINT_ALWAYS || is_closure_fn(g) }
}

// Whether IR function g is a closure's (FN_CLOSURE, 0.14).
fn is_closure_fn(g: i64) -> bool {
    unsafe {
        let node = FNS[IRFUNCS[g].f].node;
        node != 0 && (NODES[node].p & FN_CLOSURE) != 0
    }
}

// Inlines the calls of function fi that should be, in one pass over its
// blocks. Returns whether any was.
pub fn inline_calls(fi: i64) -> bool {
    unsafe {
        devirtualize(fi);
        mark_call_sites(fi);
        CALLER_RT = calls_returns_twice(fi);
        let mut changed = false;
        let mut i = 0;
        // Blocks appended by inlining are visited too, except the callees'
        // copies (BLOCKS[b].loop_depth == 1): their calls wait for the next
        // round, once the copies are simplified.
        while i < IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            i += 1;
            if BLOCKS[b].removed != 0 || BLOCKS[b].loop_depth == 1 {
                continue;
            }
            let mut v = BLOCKS[b].first;
            while v != 0 {
                let next = INSTS[v].next;
                let g = ir_callee(v);
                if g >= 0 && should_inline(fi, g, v) {
                    // (0.14) A function made to be inlined counts for its size
                    // once simplified, when inline_rounds measures it: its
                    // size alone, before its arguments are known, would use
                    // up the budgets in the middle of an iterator chain.
                    if !counted_after(g) {
                        FN_SIZE[fi] += FN_SIZE[g];
                        PROGRAM_SIZE += FN_SIZE[g];
                    }
                    FN_CALLS[g] -= 1;
                    // The continuation block keeps the call site's loop depth
                    // and coldness.
                    let depth = site_depth(b);
                    let cold = site_cold(b);
                    let cont = inline_call(fi, v, g);
                    set_site(cont, depth, cold);
                    changed = true;
                    // The rest of this block moved to the continuation block,
                    // visited later.
                    break;
                }
                v = next;
            }
        }
        for k in 0..IRFUNCS[fi].blocks.count {
            BLOCKS[IRFUNCS[fi].blocks.data[k]].loop_depth = 0;
        }
        changed
    }
}

// The count of a block of a callee (that ran `count` times, its entry
// `entry` times) inlined at a call site that ran `site` times (0.10), or
// -1.
fn scaled_count(count: i64, site: i64, entry: i64) -> i64 {
    if count < 0 || site < 0 || entry <= 0 {
        return -1;
    }
    let x = count as f64 * site as f64 / entry as f64;
    if x > 1099511627776.0 { 1099511627776 } else { x as i64 }
}

// Records the loop depth and coldness of a block made after
// mark_call_sites (when the tables cover it).
fn set_site(b: i64, depth: i64, cold: bool) {
    unsafe {
        if b < SITE_DEPTH_CAP && b < SITE_COLD_CAP {
            if b >= SITE_NBLOCKS {
                for x in SITE_NBLOCKS..b + 1 {
                    SITE_DEPTH[x] = 0;
                    SITE_COLD[x] = 0;
                }
                SITE_NBLOCKS = b + 1;
            }
            SITE_DEPTH[b] = depth;
            SITE_COLD[b] = if cold { 1 } else { 0 };
        }
    }
}

// Inlining in function fi, in rounds: each round inlines, then simplifies
// (so constants reach the copies) and recounts the function's size; the
// copies' own calls are candidates in the next round. Returns whether
// anything was inlined.
pub fn inline_rounds(fi: i64) -> bool {
    unsafe {
        let mut any = false;
        for round in 0..INLINE_ROUNDS {
            if !inline_calls(fi) {
                break;
            }
            any = true;
            let before = FN_SIZE[fi];
            optimize_after_inlining(fi);
            let after = func_size(fi);
            // (0.14: not a function that goes once inlined everywhere)
            if !inlined_everywhere(fi) {
                PROGRAM_SIZE += after - before;
            }
            FN_SIZE[fi] = after;
        }
        any
    }
}

// The program's size now, and its growth budget.
pub fn start_inlining_budget() {
    unsafe {
        PROGRAM_SIZE = 0;
        for fi in 0..IRFUNC_COUNT {
            if FN_LIVE[fi] != 0 && !inlined_everywhere(fi) {
                PROGRAM_SIZE += FN_SIZE[fi];
            }
        }
        PROGRAM_BUDGET = PROGRAM_SIZE + PROGRAM_SIZE / 2 + 2000;
    }
}

// ---- Inlining one call ----

// The copy of value `v` of the callee (its aux, in the callee's tables).
fn mapped(gt: *IRTables, v: i64) -> i64 {
    if v == 0 { 0 } else { unsafe { gt.insts[v].aux } }
}

// Inlines callee g at call `call` of function fi. Returns the continuation
// block (the instructions after the call). (0.17: g's IR is read through
// its own tables, gt, while fi's are current: ids are each function's.)
fn inline_call(fi: i64, call: i64, g: i64) -> i64 {
    unsafe {
        ir_enter(g);
        resolve_all(g);
        ir_enter(fi);
        let gt = ir_view(g);
        let b = INSTS[call].block;
        // The continuation: the instructions after the call, and b's end.
        let cont = ir_new_block();
        BLOCKS[cont].sealed = 1;
        BLOCKS[cont].count = BLOCKS[b].count;
        let mut v = INSTS[call].next;
        while v != 0 {
            let next = INSTS[v].next;
            ir_unlink(v);
            ir_append(cont, v);
            v = next;
        }
        copy_terminator(cont, b);
        for k in 0..succ_count(cont) {
            let s = succ(cont, k);
            let index = pred_index(s, b);
            BLOCKS[s].preds.data[index] = cont;
        }
        // The operand of the call holding each parameter (its first piece,
        // for an aggregate passed in pieces).
        let callee_f = IRFUNCS[g].f;
        let mut param_first: [i64; 64] = [0; 64];
        let mut k = 0;
        for p in 0..FNS[callee_f].param_count {
            let ty = fn_param(callee_f, p);
            if !is_void(ty) {
                param_first[p] = k;
                k += if conv_classify(fn_uses_c(callee_f), ty)
                    == AbiClass::Pieces { ABI_PIECE_COUNT } else { 1 };
            }
        }
        // Copy the blocks and instructions.
        let gentry = IRFUNCS[g].entry;
        for i in 0..IRFUNCS[g].blocks.count {
            let gb = IRFUNCS[g].blocks.data[i];
            if gt.blocks[gb].removed != 0 {
                continue;
            }
            let nb = ir_new_block();
            BLOCKS[nb].sealed = 1;
            BLOCKS[nb].loop_depth = 1;
            BLOCKS[nb].novec = gt.blocks[gb].novec;
            BLOCKS[nb].count = scaled_count(gt.blocks[gb].count, BLOCKS[b].count,
                gt.blocks[gentry].count);
            gt.blocks[gb].aux = nb;
            let mut gv = gt.blocks[gb].first;
            while gv != 0 {
                let op = gt.insts[gv].op;
                if op == Op::Param {
                    let index = gt.insts[gv].imm;
                    let piece = gt.insts[gv].imm2;
                    if index < 0 {
                        gt.insts[gv].aux = INSTS[call].c;
                    } else {
                        gt.insts[gv].aux = ir_arg(call,
                            param_first[index] + if piece > 0 { piece - 1 } else { 0 });
                    }
                } else {
                    let nv = ir_make(op, gt.insts[gv].ty, gt.insts[gv].a, gt.insts[gv].b,
                        gt.insts[gv].imm);
                    INSTS[nv].c = gt.insts[gv].c;
                    INSTS[nv].cond = gt.insts[gv].cond;
                    INSTS[nv].imm2 = gt.insts[gv].imm2;
                    if op == Op::Slot {
                        let s = gt.insts[gv].imm;
                        INSTS[nv].imm = ir_new_slot(gt.slots[s].size, gt.slots[s].align);
                        SLOTS[INSTS[nv].imm].ty = gt.slots[s].ty;
                    }
                    if gt.insts[gv].nargs > 0 || op == Op::Phi || op.is_call() {
                        let base = gt.insts[gv].args;
                        INSTS[nv].args = ARGS.count;
                        INSTS[nv].nargs = gt.insts[gv].nargs;
                        for a in 0..gt.insts[gv].nargs {
                            ARGS.push(gt.args.data[base + a]);
                            ARGTY.push(gt.argty.data[base + a]);
                        }
                    }
                    ir_append(nb, nv);
                    gt.insts[gv].aux = nv;
                }
                gv = gt.insts[gv].next;
            }
        }
        // Map the operands, the terminators and the predecessors. An aggregate
        // returned in registers is copied from its address to the call's
        // result slot.
        let ret = FNS[callee_f].ret;
        let copy_result = INSTS[call].c != 0
            && !conv_returns_through_pointer(fn_uses_c(callee_f), ret);
        let mut returns = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..IRFUNCS[g].blocks.count {
            let gb = IRFUNCS[g].blocks.data[i];
            if gt.blocks[gb].removed != 0 {
                continue;
            }
            let nb = gt.blocks[gb].aux;
            let mut nv = BLOCKS[nb].first;
            while nv != 0 {
                INSTS[nv].a = mapped(&gt, INSTS[nv].a);
                INSTS[nv].b = mapped(&gt, INSTS[nv].b);
                INSTS[nv].c = mapped(&gt, INSTS[nv].c);
                for a in 0..INSTS[nv].nargs {
                    ir_set_arg(nv, a, mapped(&gt, ir_arg(nv, a)));
                }
                nv = INSTS[nv].next;
            }
            for p in 0..gt.blocks[gb].preds.count {
                BLOCKS[nb].preds.push(gt.blocks[gt.blocks[gb].preds.data[p]].aux);
            }
            let term = gt.blocks[gb].term;
            let gcond = gt.blocks[gb].cond;
            if term == Term::Ret {
                if copy_result {
                    let copy = ir_make(Op::Copy, 0, INSTS[call].c, mapped(&gt, gcond),
                        type_size(ret));
                    ir_append(nb, copy);
                }
                BLOCKS[nb].term = Term::Jump;
                BLOCKS[nb].s0 = cont;
                BLOCKS[cont].preds.push(nb);
                returns.push(mapped(&gt, gcond));
            } else if term == Term::Switch {
                let mark = SSA_STACK.count;
                let cases = gt.blocks[gb].cases;
                for c in 0..gt.blocks[gb].ncases {
                    SSA_STACK.push(gt.swcases.data[cases + 2 * c]);
                    SSA_STACK.push(gt.blocks[gt.swcases.data[cases + 2 * c + 1]].aux);
                }
                ir_switch_no_preds(nb, mapped(&gt, gcond), gt.blocks[gt.blocks[gb].s0].aux, mark);
            } else {
                let s0 = gt.blocks[gb].s0;
                let s1 = gt.blocks[gb].s1;
                BLOCKS[nb].term = term;
                BLOCKS[nb].cond = mapped(&gt, gcond);
                BLOCKS[nb].s0 = if s0 != 0 { gt.blocks[s0].aux } else { 0 };
                BLOCKS[nb].s1 = if s1 != 0 { gt.blocks[s1].aux } else { 0 };
            }
        }
        // Enter the copy.
        let entry = gt.blocks[gentry].aux;
        BLOCKS[b].term = Term::Jump;
        BLOCKS[b].cond = 0;
        BLOCKS[b].s0 = entry;
        BLOCKS[b].s1 = 0;
        BLOCKS[entry].preds.push(b);
        // The result.
        let ty = INSTS[call].ty;
        if ty != 0 {
            let mut result = 0;
            if returns.count == 0 {
                result = ssa_undef(ty);
            } else if returns.count == 1 {
                result = returns.data[0];
            } else {
                result = ir_make(Op::Phi, ty, 0, 0, 0);
                INSTS[result].args = ARGS.count;
                INSTS[result].nargs = returns.count;
                for r in 0..returns.count {
                    ARGS.push(returns.data[r]);
                    ARGTY.push(0);
                }
                ir_prepend(cont, result);
            }
            ir_replace(call, result);
        } else {
            replace_pieces(call, cont, &returns);
            ir_unlink(call);
        }
        free(returns.data as *u8);
        cont
    }
}

// The pieces of an aggregate result in registers (PIECE instructions after
// the call, now in `cont`) become the pieces the inlined returns pack (a
// phi of them when there are several); the packs go.
fn replace_pieces(call: i64, cont: i64, returns: *IntVec) {
    unsafe {
        let mut v = BLOCKS[cont].first;
        while v != 0 {
            let next = INSTS[v].next;
            if INSTS[v].op == Op::Piece && INSTS[v].a == call {
                let k = INSTS[v].imm;
                let ty = INSTS[v].ty;
                let mut result = 0;
                if returns.count == 0 {
                    result = ssa_undef(ty);
                } else if returns.count == 1 {
                    result = ir_arg(returns.data[0], k);
                } else {
                    result = ir_make(Op::Phi, ty, 0, 0, 0);
                    INSTS[result].args = ARGS.count;
                    INSTS[result].nargs = returns.count;
                    for r in 0..returns.count {
                        ARGS.push(ir_arg(returns.data[r], k));
                        ARGTY.push(0);
                    }
                    ir_prepend(cont, result);
                }
                ir_replace(v, result);
            }
            v = next;
        }
        for r in 0..returns.count {
            let pack = returns.data[r];
            if pack != 0 && INSTS[pack].op == Op::Pack {
                ir_unlink(pack);
            }
        }
    }
}

// Whether function fi is going to be inlined into each of its callers
// (0.14): `#[inline]`, its address not taken, not visible outside. Its
// loop passes wait (they do better in the callers, where its arguments
// are known: an iterator source's `fold` sees its position is 0 only
// there; opt.tach), and its size does not count in the program's, which
// it leaves once inlined.
pub fn inlined_everywhere(fi: i64) -> bool {
    unsafe {
        let f = IRFUNCS[fi].f;
        fn_attr_inline(f) == 1 && FN_ADDRESS[fi] == 0 && !fn_is_global(f)
    }
}
