// Scalar promotion (0.6): a memory location that a loop reads and writes
// lives in a register for the loop. The location is one type at one
// loop-invariant address in a frame slot or a static, accessed in the loop
// only by loads and stores of that address, where no other access in the
// loop may overlap it and no call may reach it. It is loaded in the
// preheader; its loads and stores in the loop become SSA values (the SSA
// updater places the phis); when the loop stores to it, it is stored back
// in each exit. Accesses to the same object at variable offsets are kept
// apart by the value ranges at their blocks (bounds checks, loop counters):
// `vm.stack[vm.sp]` does not overlap `vm.sp`.

use crate::back::regalloc::prepare::layout_order;
use crate::base::{IntVec, free};
use crate::front::types::{TY_BOOL, TY_U64, is_float, is_integer, type_size};
use crate::middle::ctx::FnCtx;
use crate::middle::gvn::{
    address_base, copy_dst, copy_size, copy_src, find_escaping_slots, is_copy, is_private_root,
    root_of,
};
use crate::middle::ipo::{call_reads, call_writes};
use crate::middle::ir::{
    Op, ir_append, ir_enter, ir_insert_before, ir_make, ir_prepend, ir_replace, ir_set_arg,
    ir_unlink, ir_val,
};
use crate::middle::ir::Op::{Add, GAddr, Load, Phi, SAddr, Store};
use crate::middle::ir::atomic::is_barrier;
use crate::middle::ir::cfg::{succ, succ_count};
use crate::middle::ir::verify::verify_func;
use crate::middle::loops::{
    canonicalize_loops, is_canonical, loop_block, loop_contains, loop_count, loop_exits,
    loop_preheader, loop_size, seal_all,
};
use crate::middle::lower::ssa::{new_synth_var, ssa_read, ssa_write};
use crate::middle::opt::{dominates, remove_trivial_phis, resolve_all};
use crate::middle::range::{prepare_ranges, value_range_at};

const MAX_ACCESSES: i64 = 2000;

// Promotes the memory locations of function fi's loops that can be.
// Returns whether any was.
pub fn promote_loop_memory(cx: sink *FnCtx, fi: i64) -> bool {
    unsafe {
        ir_enter(cx, fi);
        // Most functions have no loop with memory in it: the loop analysis is
        // not worth starting for them.
        if !has_loop_with_memory(cx, fi) {
            return false;
        }
        resolve_all(cx, fi);
        seal_all(cx, fi);
        canonicalize_loops(cx, fi);
        resolve_all(cx, fi);
        find_escaping_slots(cx, fi);
        prepare_ranges(cx, fi);
        var changed = false;
        // Inner loops first (deeper), so an outer loop sees what they made.
        var order = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for depth in 0..16 {
            let d = 16 - depth;
            for l in 0..loop_count(cx) {
                if cx.lp_depth.data[l] == d {
                    order.push(l);
                }
            }
        }
        for i in 0..order.count {
            let l = order.data[i];
            if !is_canonical(cx, l) {
                continue;
            }
            if promote_in_loop(cx, fi, l) {
                changed = true;
                // The control flow is unchanged; the values are new.
                resolve_all(cx, fi);
            }
        }
        free(order.data as *u8);
        if changed {
            resolve_all(cx, fi);
            remove_trivial_phis(cx, fi);
            verify_func(cx, fi, c"scalar promotion");
        }
        changed
    }
}

// Whether function fi has a cycle (an edge to a block not later in
// reverse post-order) with a store to a frame slot or a static in a block
// on it: a quick filter (a location only loaded in a loop is LICM's).
fn has_loop_with_memory(cx: sink *FnCtx, fi: i64) -> bool {
    unsafe {
        layout_order(cx, fi);
        for i in 0..cx.order.count {
            let b = cx.order.data[i];
            for k in 0..succ_count(cx, b) {
                let s = succ(cx, b, k);
                if cx.blocks[s].order >= 0 && cx.blocks[s].order <= cx.blocks[b].order {
                    // A back edge s <- b: the blocks from s to b in the order
                    // hold the loop (and maybe more).
                    for j in cx.blocks[s].order..cx.blocks[b].order + 1 {
                        var v = cx.blocks[cx.order.data[j]].first;
                        while v != 0 {
                            if cx.insts[v].op == Store {
                                var offset = 0;
                                let base = address_base(cx, ir_val(cx, cx.insts[v].a), &offset);
                                let op = cx.insts[base].op;
                                if op == Op::Slot || op == GAddr {
                                    return true;
                                }
                            }
                            v = cx.insts[v].next;
                        }
                    }
                }
            }
        }
        false
    }
}

fn collect_accesses(cx: sink *FnCtx, l: i64) -> bool {
    unsafe {
        cx.accesses.count = 0;
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            var v = cx.blocks[b].first;
            while v != 0 {
                let op = cx.insts[v].op;
                if op == Load || op == Store {
                    var offset = cx.insts[v].imm;
                    let base = address_base(cx, ir_val(cx, cx.insts[v].a), &offset);
                    cx.accesses.push(v);
                    cx.accesses.push(base);
                    cx.accesses.push(offset);
                    let ty = if op == Load { cx.insts[v].ty } else { cx.insts[v].imm2 };
                    cx.accesses.push(type_size(ty));
                    cx.accesses.push(ty);
                } else if is_copy(cx, v) || op.is_call() || is_barrier(cx, v) {
                    cx.accesses.push(v);
                    cx.accesses.push(0);
                    cx.accesses.push(0);
                    cx.accesses.push(0);
                    cx.accesses.push(0);
                }
                if cx.accesses.count > MAX_ACCESSES * 5 {
                    return false;
                }
                v = cx.insts[v].next;
            }
        }
        true
    }
}

fn promote_in_loop(cx: sink *FnCtx, fi: i64, l: i64) -> bool {
    unsafe {
        if !collect_accesses(cx, l) {
            return false;
        }
        var changed = false;
        let n = cx.accesses.count / 5;
        for i in 0..n {
            let v = cx.accesses.data[5 * i];
            let base = cx.accesses.data[5 * i + 1];
            let ty = cx.accesses.data[5 * i + 4];
            if base == 0 || cx.insts[v].block == 0 || ty == 0 || !is_integer_like(ty) {
                continue;
            }
            // The address is computed outside the loop, or is an address
            // constant (remade where it is needed).
            if cx.insts[base].block != 0 && loop_contains(cx, l, cx.insts[base].block)
                && !is_address_constant(cx, base) {
                continue;
            }
            let root = root_of(cx, base);
            if root == 0 || (cx.insts[root].op != Op::Slot && cx.insts[root].op != GAddr) {
                continue;
            }
            let offset = cx.accesses.data[5 * i + 2];
            // Done already (an earlier access of the same location)?
            var first = true;
            for j in 0..i {
                if cx.accesses.data[5 * j + 1] == base && cx.accesses.data[5 * j + 2] == offset
                    && cx.insts[cx.accesses.data[5 * j]].block != 0 {
                    first = false;
                }
            }
            if !first {
                continue;
            }
            if can_promote(cx, l, root, base, offset, ty) {
                promote(cx, fi, l, base, offset, ty);
                changed = true;
            }
        }
        changed
    }
}

// The scalar types a location can be promoted with.
fn is_integer_like(ty: i64) -> bool {
    is_integer(ty) || is_float(ty) || ty == TY_BOOL
}

// Whether the location [base + offset, + size of ty) of object `root` can
// be promoted in loop l: every access of it is a load or store of type
// ty at base + offset, and nothing else in the loop may reach it.
fn can_promote(cx: sink *FnCtx, l: i64, root: i64, base: i64, offset: i64, ty: i64) -> bool {
    unsafe {
        let size = type_size(ty);
        let private = is_private_root(cx, root);
        var loc_lo = 0;
        var loc_hi = 0;
        if !relative_range(cx, base, root, cx.insts[cx.accesses.data[0]].block, &loc_lo,
            &loc_hi, 0)
            || loc_lo != loc_hi {
            return false;
        }
        let loc = loc_lo + offset;
        var uses = 0;
        for i in 0..cx.accesses.count / 5 {
            let v = cx.accesses.data[5 * i];
            if cx.insts[v].block == 0 {
                continue;
            }
            let b2 = cx.accesses.data[5 * i + 1];
            let o2 = cx.accesses.data[5 * i + 2];
            let s2 = cx.accesses.data[5 * i + 3];
            let t2 = cx.accesses.data[5 * i + 4];
            let op = cx.insts[v].op;
            if b2 == base && o2 == offset && t2 != 0 {
                if t2 != ty {
                    return false;
                }
                uses += 1;
                continue;
            }
            // (0.21) An atomic or a fence: only private memory moves across.
            if is_barrier(cx, v) {
                if !private {
                    return false;
                }
                continue;
            }
            if op.is_call() && !is_copy(cx, v) {
                if !private && (call_reads(cx, v) || call_writes(cx, v)) {
                    return false;
                }
                continue;
            }
            if is_copy(cx, v) {
                var dst_offset = 0;
                let dst = address_base(cx, ir_val(cx, copy_dst(cx, v)), &dst_offset);
                var src_offset = 0;
                let src = address_base(cx, ir_val(cx, copy_src(cx, v)), &src_offset);
                let n = copy_size(cx, v);
                if !disjoint(cx, l, root, private, loc, size, dst, dst_offset, n, cx.insts[v].block)
                    || !disjoint(cx, l, root, private, loc, size, src, src_offset, n,
                        cx.insts[v].block) {
                    return false;
                }
                continue;
            }
            if !disjoint(cx, l, root, private, loc, size, b2, o2, s2, cx.insts[v].block) {
                return false;
            }
        }
        // (0.21, docs/design/concurrency.md §4.2, O3) The value is stored back
        // at the loop's exits: for memory another thread may see (a slot
        // whose address escapes), only when the loop stored it on the way to
        // every exit, so that no store is invented on a path that made none.
        // A static is main-thread memory (§2.5).
        if uses >= 2 && !private && cx.insts[root].op == Op::Slot
            && !stores_before_exits(cx, l, base, offset) {
            return false;
        }
        uses >= 2
    }
}

// (0.21) Whether loop l stores to [base + offset] before it can leave: each
// block that exits the loop is dominated by a block of the loop that
// stores there (or the loop does not store there at all).
fn stores_before_exits(cx: sink *FnCtx, l: i64, base: i64, offset: i64) -> bool {
    unsafe {
        var any = false;
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            var v = cx.blocks[b].first;
            while v != 0 {
                if is_location(cx, v, Store, base, offset) {
                    any = true;
                }
                v = cx.insts[v].next;
            }
        }
        if !any {
            return true;
        }
        for i in 0..loop_size(cx, l) {
            let x = loop_block(cx, l, i);
            var exits = false;
            for k in 0..succ_count(cx, x) {
                if !loop_contains(cx, l, succ(cx, x, k)) {
                    exits = true;
                }
            }
            if !exits {
                continue;
            }
            var covered = false;
            for j in 0..loop_size(cx, l) {
                let s = loop_block(cx, l, j);
                if covered || !dominates(cx, s, x) {
                    continue;
                }
                var v = cx.blocks[s].first;
                while v != 0 {
                    if is_location(cx, v, Store, base, offset) {
                        covered = true;
                    }
                    v = cx.insts[v].next;
                }
            }
            if !covered {
                return false;
            }
        }
        true
    }
}

// Whether the access [b2 + o2, + s2) at block `at` cannot overlap the
// location [loc, + size) of object `root`.
fn disjoint(cx: sink *FnCtx, l: i64, root: i64, private: bool, loc: i64, size: i64, b2: i64,
    o2: i64, s2: i64, at: i64) -> bool {
    let r2 = root_of(cx, b2);
    if r2 == 0 {
        // An unknown pointer reaches no private slot.
        return private;
    }
    if r2 != root {
        // Another object, or constant data.
        unsafe {
            return cx.insts[r2].op == SAddr || cx.insts[r2].op != cx.insts[root].op
                || cx.insts[r2].imm != cx.insts[root].imm;
        }
    }
    var lo = 0;
    var hi = 0;
    if !relative_range(cx, b2, root, at, &lo, &hi, 0) {
        return false;
    }
    let limit = 1152921504606846976;
    if lo < 0 - limit || hi > limit || s2 < 0 || s2 > limit {
        return false;
    }
    hi + o2 + s2 <= loc || lo + o2 >= loc + size
}

// The range of x - root (x an address computed from `root` by additions)
// at block `at`, in *lo and *hi. Returns false when x is not such an
// address or its range is unknown.
fn relative_range(cx: sink *FnCtx, x: i64, root: i64, at: i64, lo: inout i64, hi: inout i64,
    depth: i64) -> bool {
    unsafe {
        let v = ir_val(cx, x);
        if v == root {
            lo = 0;
            hi = 0;
            return true;
        }
        if depth > 8 || cx.insts[v].op != Add || cx.insts[v].ty != TY_U64 {
            return false;
        }
        let a = ir_val(cx, cx.insts[v].a);
        let c = ir_val(cx, cx.insts[v].b);
        var blo = 0;
        var bhi = 0;
        var other = 0;
        if relative_range(cx, a, root, at, &lo, &hi, depth + 1) {
            other = c;
        } else if relative_range(cx, c, root, at, &lo, &hi, depth + 1) {
            other = a;
        } else {
            return false;
        }
        value_range_at(cx, other, at, &blo, &bhi);
        let limit = 1152921504606846976;
        if blo < 0 - limit || bhi > limit || lo < 0 - limit || hi > limit {
            return false;
        }
        lo = lo + blo;
        hi = hi + bhi;
        true
    }
}

// The address of a frame slot or a static, which has no operands.
fn is_address_constant(cx: sink *FnCtx, v: i64) -> bool {
    unsafe { cx.insts[v].op == Op::Slot || cx.insts[v].op == GAddr }
}

// `base` for a use in block b, outside loop l: base itself, or for an
// address constant defined in the loop, a copy of it placed before `at`
// (or at the end of b when at is 0).
fn address_outside(cx: sink *FnCtx, l: i64, base: i64, b: i64, at: i64) -> i64 {
    unsafe {
        if cx.insts[base].block == 0 || !loop_contains(cx, l, cx.insts[base].block) {
            return base;
        }
        let copy = ir_make(cx, cx.insts[base].op, cx.insts[base].ty, 0, 0, cx.insts[base].imm);
        if at == 0 {
            ir_append(cx, b, copy);
        } else {
            ir_insert_before(cx, at, copy);
        }
        copy
    }
}

// Promotes [base + offset] (type ty) in loop l.
fn promote(cx: sink *FnCtx, fi: i64, l: i64, base: i64, offset: i64, ty: i64) {
    unsafe {
        ir_enter(cx, fi);
        let pre = loop_preheader(cx, l);
        let initial = ir_make(cx, Load, ty, address_outside(cx, l, base, pre, 0), 0, offset);
        ir_append(cx, pre, initial);
        let var_id = new_synth_var(cx, ty);
        ssa_write(cx, var_id, pre, initial);
        // The value each block leaves in the location: its last store.
        var stores = false;
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            var last = 0;
            var v = cx.blocks[b].first;
            while v != 0 {
                if is_location(cx, v, Store, base, offset) {
                    last = v;
                }
                v = cx.insts[v].next;
            }
            if last != 0 {
                ssa_write(cx, var_id, b, ir_val(cx, cx.insts[last].b));
                cx.blocks[b].aux = 1;
                stores = true;
            } else {
                cx.blocks[b].aux = 0;
            }
        }
        // Loads and stores become values.
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            var current = 0;
            var v = cx.blocks[b].first;
            while v != 0 {
                let next = cx.insts[v].next;
                if is_location(cx, v, Load, base, offset) {
                    if current == 0 {
                        current = value_at_start(cx, var_id, b, ty);
                    }
                    ir_replace(cx, v, current);
                } else if is_location(cx, v, Store, base, offset) {
                    current = ir_val(cx, cx.insts[v].b);
                    ir_unlink(cx, v);
                }
                v = next;
            }
        }
        // Stored back in the exits.
        if stores {
            loop_exits(cx, l);
            var exits = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for i in 0..cx.lp_list.count {
                exits.push(cx.lp_list.data[i]);
            }
            for i in 0..exits.count {
                let e = exits.data[i];
                let value = ssa_read(cx, var_id, e);
                var at = cx.blocks[e].first;
                while at != 0 && cx.insts[at].op == Phi {
                    at = cx.insts[at].next;
                }
                let address = address_outside(cx, l, base, e, at);
                let st = ir_make(cx, Store, 0, address, value, offset);
                cx.insts[st].imm2 = ty;
                if at == 0 {
                    ir_append(cx, e, st);
                } else {
                    ir_insert_before(cx, at, st);
                }
            }
            free(exits.data as *u8);
        }
    }
}

fn is_location(cx: sink *FnCtx, v: i64, op: Op, base: i64, offset: i64) -> bool {
    unsafe {
        if cx.insts[v].op != op {
            return false;
        }
        var o = cx.insts[v].imm;
        let b = address_base(cx, ir_val(cx, cx.insts[v].a), &o);
        b == base && o == offset
    }
}

// The value of the location at the start of loop block b: with no store
// in b, what reaches its end; else what its predecessors leave (a phi
// when they differ).
fn value_at_start(cx: sink *FnCtx, var_id: i64, b: i64, ty: i64) -> i64 {
    unsafe {
        if cx.blocks[b].aux == 0 {
            return ssa_read(cx, var_id, b);
        }
        let n = cx.blocks[b].preds.count;
        if n == 1 {
            return ssa_read(cx, var_id, cx.blocks[b].preds.data[0]);
        }
        let phi = ir_make(cx, Phi, ty, 0, 0, 0);
        ir_prepend(cx, b, phi);
        cx.insts[phi].args = cx.args.count;
        cx.insts[phi].nargs = n;
        for k in 0..n {
            cx.args.push(0);
            cx.argty.push(0);
        }
        for k in 0..n {
            ir_set_arg(cx, phi, k, ssa_read(cx, var_id, cx.blocks[b].preds.data[k]));
        }
        phi
    }
}
