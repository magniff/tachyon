// Jump threading on implied conditions: an edge into a block that only
// tests what the facts on the edge already decide goes on to the outcome
// directly, and a branch on a phi of `&&` or `||` is threaded from the
// predecessor that decided it. EXPORTS marks the blocks with values used
// outside them, which threading cannot skip.

use crate::middle::ctx::FnCtx;
use crate::middle::ir::{IRFUNCS, Op, Term, ir_arg, ir_operand, ir_operand_count, ir_val};
use crate::middle::ir::cfg::{is_succ, pred_index, redirect_succ};
use crate::middle::loops::{add_pred_values, block_array};
use crate::middle::opt::{
    add_pred_like, compute_dominators, remove_pred, remove_pred_at, remove_unreachable,
};
use crate::middle::range::{collect_facts, decide, edge_fact};
use crate::middle::range::phi::forget_phi_ranges;

// (0.11) A block holding nothing but a phi and a branch on it (what `&&`
// and `||` leave), the phi used by the branch alone: a predecessor that
// branched on the phi's operand for it decides the branch by the edge it
// takes, and goes on to the outcome directly (as instruction selection
// threads them; here, so that the facts on the way hold where the outcome
// is: in `i < n && s[i] < x`, i < n wherever the whole is true). Returns
// whether any edge was redirected.
pub fn thread_phi_conditions(cx: sink *FnCtx, fi: i64) -> bool {
    var changed = false;
    compute_exports(cx, fi);
    unsafe {
        for i in 0..IRFUNCS[fi].blocks.count {
            let j = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[j].removed != 0 || cx.blocks[j].term != Term::Branch
                || j == IRFUNCS[fi].entry {
                continue;
            }
            let phi = cx.blocks[j].first;
            let s0 = cx.blocks[j].s0;
            let s1 = cx.blocks[j].s1;
            if phi == 0 || cx.insts[phi].op != Op::Phi || cx.insts[phi].next != 0
                || ir_val(cx, cx.blocks[j].cond) != phi || used_outside_block(cx, fi, j) || s0 == s1
                || s0 == j || s1 == j
                || cx.insts[phi].nargs != cx.blocks[j].preds.count {
                continue;
            }
            var k = 0;
            while k < cx.blocks[j].preds.count {
                let p = cx.blocks[j].preds.data[k];
                let value = ir_val(cx, ir_arg(cx, phi, k));
                if cx.blocks[p].term != Term::Branch || p == j
                    || ir_val(cx, cx.blocks[p].cond) != value
                    || (cx.blocks[p].s0 == j) == (cx.blocks[p].s1 == j) {
                    k += 1;
                    continue;
                }
                let t = if cx.blocks[p].s0 == j { s0 } else { s1 };
                let other = if cx.blocks[p].s0 == j { cx.blocks[p].s1 } else { cx.blocks[p].s0 };
                if t == other || t == p {
                    k += 1;
                    continue;
                }
                redirect_succ(cx, p, j, t);
                add_pred_like(cx, t, p, j);
                remove_pred_at(cx, j, k);
                changed = true;
            }
        }
    }
    changed
}

// A block that only tests: no phis, its instructions pure (or constants)
// and used by its own branch alone.
fn is_test_block(cx: sink *FnCtx, fi: i64, j: i64) -> bool {
    unsafe {
        if cx.blocks[j].term != Term::Branch || j == IRFUNCS[fi].entry
            || cx.blocks[j].s0 == cx.blocks[j].s1 {
            return false;
        }
        var v = cx.blocks[j].first;
        var n = 0;
        while v != 0 {
            let op = cx.insts[v].op;
            if op != Op::Const && !op.is_pure() {
                return false;
            }
            n += 1;
            v = cx.insts[v].next;
        }
        n <= 4 && !used_outside_block(cx, fi, j)
    }
}

pub fn compute_exports(cx: sink *FnCtx, fi: i64) {
    unsafe {
        cx.exports = block_array(cx, cx.exports, &cx.exports_cap, fi);
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            var v = cx.blocks[b].first;
            while v != 0 {
                for k in 0..ir_operand_count(cx, v) {
                    let w = ir_operand(cx, v, k);
                    if w != 0 && cx.insts[w].block != 0 && cx.insts[w].block != b {
                        cx.exports[cx.insts[w].block] = 1;
                    }
                }
                v = cx.insts[v].next;
            }
            let c = cx.blocks[b].cond;
            if c != 0 && cx.insts[c].block != 0 && cx.insts[c].block != b {
                cx.exports[cx.insts[c].block] = 1;
            }
        }
    }
}

// Whether a value defined in block j is used in another block.
pub fn used_outside_block(cx: sink *FnCtx, fi: i64, j: i64) -> bool {
    let _ = fi;
    unsafe { j >= cx.block_count || cx.exports[j] != 0 }
}

// Jump threading: a predecessor p of a test block j, where the test is
// decided (by p's facts and the edge p -> j), goes to j's outcome directly.
pub fn thread_implied(cx: sink *FnCtx, fi: i64) -> bool {
    var changed = false;
    compute_exports(cx, fi);
    // One edge at a time: the facts need the dominators of the current CFG.
    for _ in 0..1000 {
        var did = false;
        compute_dominators(cx, fi);
        unsafe {
            for i in 0..IRFUNCS[fi].blocks.count {
                if did {
                    break;
                }
                let j = IRFUNCS[fi].blocks.data[i];
                if cx.blocks[j].removed != 0 || cx.blocks[j].order < 0
                    || cx.blocks[j].preds.count < 2 {
                    continue;
                }
                if !is_test_block(cx, fi, j) {
                    continue;
                }
                let c = ir_val(cx, cx.blocks[j].cond);
                var k = 0;
                while k < cx.blocks[j].preds.count {
                    let p = cx.blocks[j].preds.data[k];
                    k += 1;
                    if cx.blocks[p].term == Term::Switch || cx.blocks[p].order < 0
                        || (cx.blocks[p].term == Term::Branch && cx.blocks[p].s0 == cx.blocks[p].s1) {
                        continue;
                    }
                    collect_facts(cx, p);
                    edge_fact(cx, p, j);
                    let d = decide(cx, c);
                    if d < 0 {
                        continue;
                    }
                    let t = if d == 1 { cx.blocks[j].s0 } else { cx.blocks[j].s1 };
                    if is_succ(cx, p, t) || t == j {
                        continue;
                    }
                    // p -> t: t's phis take their operand for j.
                    let index = pred_index(cx, t, j);
                    let first = cx.lp_values.count;
                    var phi = cx.blocks[t].first;
                    while phi != 0 && cx.insts[phi].op == Op::Phi {
                        cx.lp_values.push(ir_arg(cx, phi, index));
                        phi = cx.insts[phi].next;
                    }
                    redirect_succ(cx, p, j, t);
                    add_pred_values(cx, t, p, &cx.lp_values, first);
                    cx.lp_values.count = first;
                    remove_pred(cx, j, p);
                    did = true;
                    break;
                }
            }
        }
        if !did {
            break;
        }
        changed = true;
        remove_unreachable(cx, fi);
        forget_phi_ranges(cx);
    }
    changed
}
