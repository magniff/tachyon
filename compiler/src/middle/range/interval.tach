// The range of an integer value: an interval in the signed 64-bit view of
// its canonical value, from its type and its operation (masks, remainders,
// shifts, conversions, constants, phis: phi.tach), narrowed by the facts
// that hold at a block (mod.tach).

use crate::front::types::{TY_BOOL, int_bits, is_integer, is_signed};
use crate::middle::ctx::FnCtx;
use crate::middle::fold::{is_const, shift_amount};
use crate::middle::ir::Op;
use crate::middle::range::narrow_by_facts;
use crate::middle::range::phi::phi_range;

pub fn type_min(ty: i64) -> i64 {
    if ty == TY_BOOL {
        return 0;
    }
    if !is_integer(ty) {
        return 0 - 9223372036854775807 - 1;
    }
    let bits = int_bits(ty);
    if is_signed(ty) {
        if bits == 64 { 0 - 9223372036854775807 - 1 } else { 0 - (1 << (bits - 1) as u64) }
    } else if bits == 64 {
        0 - 9223372036854775807 - 1
    } else {
        0
    }
}

pub fn type_max(ty: i64) -> i64 {
    if ty == TY_BOOL {
        return 1;
    }
    if !is_integer(ty) {
        return 9223372036854775807;
    }
    let bits = int_bits(ty);
    if bits == 64 {
        return 9223372036854775807;
    }
    if is_signed(ty) { (1 << (bits - 1) as u64) - 1 } else { (1 << bits as u64) - 1 }
}

// How deep range_of follows operands: 6 operations of two operands, more
// of one.
const RANGE_DEPTH: i64 = 24;

// The range of v (context-free): *lo and *hi.
fn range_of(mut cx: *FnCtx, v: i64, lo: &mut i64, hi: &mut i64, depth: i64) {
    unsafe {
        let ty = cx.insts[v].ty;
        *lo = type_min(ty);
        *hi = type_max(ty);
        let op = cx.insts[v].op;
        if op == Op::Const {
            *lo = cx.insts[v].imm;
            *hi = cx.insts[v].imm;
            return;
        }
        if depth > RANGE_DEPTH || !is_integer(ty) {
            return;
        }
        let a = cx.insts[v].a;
        let b = cx.insts[v].b;
        // (0.11) An operation with one operand to range costs less depth
        // than one with two: chains of constants added, shifted and
        // converted are followed further than trees.
        let next = if op == Op::Conv || op == Op::Rem || op == Op::Shr || is_const(cx, a)
            || is_const(cx, b) {
            depth + 1
        } else {
            depth + 4
        };
        if op == Op::And {
            let m = if is_const(cx, b) { cx.insts[b].imm }
                else if is_const(cx, a) { cx.insts[a].imm } else { -1 };
            if m >= 0 {
                *lo = 0;
                if m < *hi {
                    *hi = m;
                }
            }
        } else if op == Op::Rem && is_const(cx, b) && cx.insts[b].imm != 0 {
            let c = cx.insts[b].imm;
            if !is_signed(ty) && c > 0 {
                *lo = 0;
                *hi = c - 1;
            } else if is_signed(ty) && c > 0 - 9223372036854775807 {
                let m = if c < 0 { 0 - c } else { c };
                let mut alo = 0;
                let mut ahi = 0;
                range_with_facts(cx, a, &mut alo, &mut ahi, next);
                *lo = if alo >= 0 { 0 } else { 1 - m };
                *hi = if ahi <= 0 { 0 } else { m - 1 };
            }
        } else if op == Op::Phi {
            phi_range(cx, v, lo, hi, depth);
        } else if op == Op::Sel {
            // (0.15) Either operand.
            let mut blo = 0;
            let mut bhi = 0;
            let mut clo = 0;
            let mut chi = 0;
            range_with_facts(cx, b, &mut blo, &mut bhi, depth + 4);
            range_with_facts(cx, cx.insts[v].c, &mut clo, &mut chi, depth + 4);
            *lo = lesser(blo, clo);
            *hi = greater(bhi, chi);
        } else if op == Op::Shr && is_const(cx, b) {
            let k = shift_amount(cx.insts[b].imm, ty);
            let mut alo = 0;
            let mut ahi = 0;
            range_with_facts(cx, a, &mut alo, &mut ahi, next);
            if is_signed(ty) {
                // (0.11) An arithmetic shift is monotone.
                *lo = alo >> k as u64;
                *hi = ahi >> k as u64;
            } else if k > 0 {
                *lo = 0;
                let max = if int_bits(ty) == 64 { 0 - 1 } else { type_max(ty) };
                *hi = ((max as u64) >> k) as i64;
                if alo >= 0 {
                    // (0.11) A non-negative operand: monotone too.
                    *lo = alo >> k as u64;
                    *hi = lesser(*hi, ahi >> k as u64);
                }
            }
        } else if op == Op::Conv && is_integer(cx.insts[v].imm2) {
            let from = cx.insts[v].imm2;
            if int_bits(from) == 64 && int_bits(ty) == 64 {
                // (0.11) The same bits: the same range in the signed view.
                range_with_facts(cx, a, lo, hi, next);
            }
            else if int_bits(from) < int_bits(ty)
                || (int_bits(from) == int_bits(ty) && is_signed(from) == is_signed(ty)) {
                let mut alo = 0;
                let mut ahi = 0;
                range_with_facts(cx, a, &mut alo, &mut ahi, next);
                // Widening keeps the value when it fits the new type.
                if alo >= type_min(ty) && ahi <= type_max(ty) && (is_signed(ty) || alo >= 0) {
                    *lo = alo;
                    *hi = ahi;
                }
            }
        } else if op == Op::Add || op == Op::Sub || op == Op::Mul || op == Op::Shl {
            // Interval arithmetic on the operands' ranges (with the facts of
            // the block applied to them), given up when a bound could leave
            // the type or overflow.
            let big = 4611686018427387904;
            let small = 2147483648;
            // (0.11) The cheaper operand first (a phi's range costs most):
            // when its range already gives up, the other is not needed.
            let mut alo = MIN_I64;
            let mut ahi = MAX_I64;
            let mut blo = MIN_I64;
            let mut bhi = MAX_I64;
            if op == Op::Shl || (cx.insts[a].op == Op::Phi && cx.insts[b].op != Op::Phi) {
                range_with_facts(cx, b, &mut blo, &mut bhi, next);
                if usable_operand(op, blo, bhi, true) {
                    range_with_facts(cx, a, &mut alo, &mut ahi, next);
                }
            } else {
                range_with_facts(cx, a, &mut alo, &mut ahi, next);
                if usable_operand(op, alo, ahi, false) {
                    range_with_facts(cx, b, &mut blo, &mut bhi, next);
                }
            }
            let mut rlo = 0;
            let mut rhi = 0;
            let mut ok = false;
            if op == Op::Add || op == Op::Sub {
                if alo > 0 - big && ahi < big && blo > 0 - big && bhi < big {
                    ok = true;
                    if op == Op::Add {
                        rlo = alo + blo;
                        rhi = ahi + bhi;
                    } else {
                        rlo = alo - bhi;
                        rhi = ahi - blo;
                    }
                }
            } else if op == Op::Mul {
                if alo > 0 - small && ahi < small && blo > 0 - small && bhi < small {
                    ok = true;
                    let p1 = alo * blo;
                    let p2 = alo * bhi;
                    let p3 = ahi * blo;
                    let p4 = ahi * bhi;
                    rlo = lesser(lesser(p1, p2), lesser(p3, p4));
                    rhi = greater(greater(p1, p2), greater(p3, p4));
                }
            } else if blo == bhi && blo >= 0 && blo < 32 && alo >= 0 && ahi < small {
                ok = true;
                rlo = alo << blo as u64;
                rhi = ahi << blo as u64;
            }
            if ok && rlo >= type_min(ty) && rhi <= type_max(ty)
                && (is_signed(ty) || int_bits(ty) < 64 || rlo >= 0) {
                *lo = rlo;
                *hi = rhi;
            }
        }
    }
}

// Whether an operand of range [lo, hi] (the amount, for a shift, when
// `amount`) leaves range_of's interval arithmetic for op a result.
fn usable_operand(op: Op, lo: i64, hi: i64, amount: bool) -> bool {
    if op == Op::Shl {
        return if amount { lo == hi && lo >= 0 && lo < 32 } else { lo >= 0 && hi < 2147483648 };
    }
    let bound = if op == Op::Mul { 2147483648 } else { 4611686018427387904 };
    lo > 0 - bound && hi < bound
}

pub fn lesser(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

pub fn greater(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

// The range of v, with the facts in FACTS that compare v itself with a
// constant applied.
pub fn range_with_facts(mut cx: *FnCtx, v: i64, lo: &mut i64, hi: &mut i64, depth: i64) {
    range_of(cx, v, lo, hi, depth);
    narrow_by_facts(cx, v, lo, hi, depth);
}

// The range of v at a block whose facts are in FACTS.
pub fn range_at(mut cx: *FnCtx, v: i64, lo: &mut i64, hi: &mut i64) {
    range_with_facts(cx, v, lo, hi, 0);
}

pub const MIN_I64: i64 = 0 - 9223372036854775807 - 1;

pub const MAX_I64: i64 = 9223372036854775807;
