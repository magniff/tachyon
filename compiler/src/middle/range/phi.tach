// Ranges of phis (0.11).
//
// A phi's range is the union of its operands' ranges, each at the end of
// its predecessor with the facts there and on the edge: a property of the
// phi wherever it is used, kept per generation (a change of the control
// flow starts a new one).
//
// The phis of a loop header are found together, as the operands coming
// back around the loop (from predecessors the header dominates) may depend
// on them: each phi is assumed in a range H, the operands coming back are
// ranged under those assumptions, and when every one falls in its phi's H,
// every phi is in its H always (by induction over the values they take,
// as H holds the entry operands). H is first the entry operands' range;
// a phi whose operands coming back leave it upward (downward) has that end
// widened to what the facts on those edges allow (an increasing induction
// variable below its loop's bound, with any step; a decreasing one above);
// failing that, its type's range, which proves nothing about it but holds.
// The assumptions are on a stack, as are the phis of other blocks while
// their operands are ranged (assumed to have their type's range if met
// again); a range found under an assumption made outside its own
// finding is not kept. At most PHI_NEST levels.

use crate::base::{IntVec, alloc_array, free};
use crate::front::types::is_integer;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Op, ir_arg, ir_val};
use crate::middle::loops::{innermost_loop, loop_count, loop_header};
use crate::middle::opt::dominates;
use crate::middle::range::{collect_facts, edge_fact, narrow_by_facts};
use crate::middle::range::interval::{
    MAX_I64, MIN_I64, greater, lesser, range_with_facts, type_max, type_min,
};

const PHI_NEST: i64 = 12;
// Phi ranges being found within one another (each may take facts with
// other values afresh: see FACT_NEST), at most PHI_FINDS.
const PHI_FINDS: i64 = 3;
// The phis of a header found together (the others have their type's
// range).
const HEADER_PHIS: i64 = 8;
// How deep facts comparing with a value whose range bounds it are taken
// (within the ranging of such a value), and how deep they are now.
pub const FACT_RANGE_DEPTH: i64 = 3;
const NO_TAINT: i64 = 1000000;

const PR_BUDGET: i64 = 5000;
const PR_STRIDE: i64 = 4;
const HR_FIELDS: i64 = 10;
const HR_PHI: i64 = 0;
const HR_TLO: i64 = 1;
const HR_THI: i64 = 2;
const HR_RLO: i64 = 3;
const HR_RHI: i64 = 4;
const HR_HLO: i64 = 5;
const HR_HHI: i64 = 6;
const HR_BLO: i64 = 7;
const HR_BHI: i64 = 8;
const HR_STAGE: i64 = 9;

pub fn forget_phi_ranges(mut cx: *FnCtx) {
    unsafe {
        cx.range_gen += 1;
        cx.pr_work = 0;
    }
}

fn facts_save(mut cx: *FnCtx) -> i64 {
    unsafe {
        let mark = cx.facts_saved.count;
        for i in 0..cx.facts.count {
            cx.facts_saved.push(cx.facts.data[i]);
        }
        cx.facts_saved.push(cx.facts.count);
        mark
    }
}

fn facts_restore(mut cx: *FnCtx, mark: i64) {
    unsafe {
        let n = cx.facts_saved.data[cx.facts_saved.count - 1];
        cx.facts_ver += 1;
        cx.facts.count = 0;
        for i in 0..n {
            cx.facts.push(cx.facts_saved.data[mark + i]);
        }
        cx.facts_saved.count = mark;
    }
}

// The facts at the end of predecessor p of h, and on the edge, in FACTS.
fn edge_facts(mut cx: *FnCtx, p: i64, h: i64) {
    collect_facts(cx, p);
    edge_fact(cx, p, h);
}

fn is_back_edge(mut cx: *FnCtx, p: i64, h: i64) -> bool {
    dominates(cx, h, p)
}

fn has_back_edge(mut cx: *FnCtx, h: i64) -> bool {
    unsafe {
        for i in 0..cx.blocks[h].preds.count {
            let p = cx.blocks[h].preds.data[i];
            if cx.blocks[p].order >= 0 && is_back_edge(cx, p, h) {
                return true;
            }
        }
        false
    }
}

// Whether phi v's range is kept, or being found.
fn phi_known(mut cx: *FnCtx, v: i64) -> bool {
    unsafe {
        if v < cx.pr_cap && cx.pr_gen[v] == cx.range_gen {
            return true;
        }
        let mut k = 0;
        while k < cx.pr_stack.count {
            if cx.pr_stack.data[k] == v {
                return true;
            }
            k += PR_STRIDE;
        }
        false
    }
}

fn pr_push(mut cx: *FnCtx, v: i64, lo: i64, hi: i64) {
    unsafe {
        cx.pr_stack.push(v);
        cx.pr_stack.push(lo);
        cx.pr_stack.push(hi);
        cx.pr_frames += 1;
        cx.pr_stack.push(cx.pr_frames);
    }
}

// Starts finding ranges at stack level `level`: the taint so far, set
// aside.
fn taint_enter(mut cx: *FnCtx) -> i64 {
    unsafe {
        let outer = cx.pr_taint;
        cx.pr_taint = NO_TAINT;
        outer
    }
}

// Ends it: the outermost level whose assumption what was found used (at
// least `level`: none from outside, it may be kept).
fn taint_leave(mut cx: *FnCtx, level: i64, outer: i64) -> i64 {
    unsafe {
        let taint = cx.pr_taint;
        cx.pr_taint = if taint < level { lesser(outer, taint) } else { outer };
        taint
    }
}

fn top_frame(mut cx: *FnCtx) -> i64 {
    unsafe { if cx.pr_stack.count == 0 { 0 } else { cx.pr_stack.data[cx.pr_stack.count - 1] } }
}

// Keeps phi v's range [lo, hi], found at stack level `level` using the
// assumptions down to level `taint`.
fn pr_keep(mut cx: *FnCtx, v: i64, lo: i64, hi: i64, level: i64, taint: i64) {
    unsafe {
        if taint >= level {
            cx.pr_gen[v] = cx.range_gen;
            cx.pr_lo[v] = lo;
            cx.pr_hi[v] = hi;
        } else {
            cx.pt_gen[v] = cx.range_gen;
            cx.pt_frame[v] = top_frame(cx);
            cx.pt_lo[v] = lo;
            cx.pt_hi[v] = hi;
            cx.pt_taint_of[v] = taint;
        }
    }
}

// The range of phi v (*lo and *hi hold its type's on entry).
pub fn phi_range(mut cx: *FnCtx, v: i64, lo: *i64, hi: *i64, depth: i64) {
    unsafe {
        if cx.pr_cap <= cx.inst_count {
            free(cx.pr_gen as *u8);
            free(cx.pr_lo as *u8);
            free(cx.pr_hi as *u8);
            free(cx.pt_gen as *u8);
            free(cx.pt_frame as *u8);
            free(cx.pt_lo as *u8);
            free(cx.pt_hi as *u8);
            free(cx.pt_taint_of as *u8);
            cx.pr_cap = 2 * cx.inst_count + 1024;
            cx.pr_gen = alloc_array::<i64>(cx.pr_cap);
            cx.pr_lo = alloc_array::<i64>(cx.pr_cap);
            cx.pr_hi = alloc_array::<i64>(cx.pr_cap);
            cx.pt_gen = alloc_array::<i64>(cx.pr_cap);
            cx.pt_frame = alloc_array::<i64>(cx.pr_cap);
            cx.pt_lo = alloc_array::<i64>(cx.pr_cap);
            cx.pt_hi = alloc_array::<i64>(cx.pr_cap);
            cx.pt_taint_of = alloc_array::<i64>(cx.pr_cap);
        }
        if cx.pr_gen[v] == cx.range_gen {
            *lo = cx.pr_lo[v];
            *hi = cx.pr_hi[v];
            return;
        }
        if cx.pt_gen[v] == cx.range_gen && cx.pt_frame[v] == top_frame(cx) {
            // (Found under this very stack: under the same assumptions.)
            *lo = cx.pt_lo[v];
            *hi = cx.pt_hi[v];
            if cx.pt_taint_of[v] < cx.pr_taint {
                cx.pr_taint = cx.pt_taint_of[v];
            }
            return;
        }
        let mut k = 0;
        while k < cx.pr_stack.count {
            if cx.pr_stack.data[k] == v {
                *lo = cx.pr_stack.data[k + 1];
                *hi = cx.pr_stack.data[k + 2];
                if k / PR_STRIDE < cx.pr_taint {
                    cx.pr_taint = k / PR_STRIDE;
                }
                return;
            }
            k += PR_STRIDE;
        }
        let h = cx.insts[v].block;
        if !cx.phi_ranges || cx.pr_stack.count >= PR_STRIDE * PHI_NEST || cx.pr_active >= PHI_FINDS
            || cx.pr_work >= PR_BUDGET || h == 0 || cx.blocks[h].order < 0
            || cx.insts[v].nargs != cx.blocks[h].preds.count {
            return;
        }
        cx.pr_work += 1;
        if has_back_edge(cx, h) {
            header_ranges(cx, h, v, lo, hi, depth);
            return;
        }
        // In a loop, its header's phis first (they may be what v's operands
        // come from).
        let l = innermost_loop(cx, h);
        if l >= 0 && l < loop_count(cx) {
            let hh = loop_header(cx, l);
            let first = cx.blocks[hh].first;
            if hh != h && cx.blocks[hh].order >= 0 && first != 0 && cx.insts[first].op == Op::Phi
                && !phi_known(cx, first) && is_integer(cx.insts[first].ty)
                && cx.insts[first].nargs == cx.blocks[hh].preds.count
                && has_back_edge(cx, hh) {
                let mut ilo = type_min(cx.insts[first].ty);
                let mut ihi = type_max(cx.insts[first].ty);
                header_ranges(cx, hh, first, &ilo, &ihi, depth);
            }
        }
        let tlo = *lo;
        let thi = *hi;
        let level = cx.pr_stack.count / PR_STRIDE;
        let outer = taint_enter(cx);
        let mark = facts_save(cx);
        // (A phi's range does not depend on where it is asked for: kept,
        // it must not depend on how deep that was.)
        let fact_nest = cx.fact_nest;
        cx.fact_nest = 0;
        cx.pr_active += 1;
        pr_push(cx, v, tlo, thi);
        let mut rlo = thi;
        let mut rhi = tlo;
        for i in 0..cx.insts[v].nargs {
            let p = cx.blocks[h].preds.data[i];
            if cx.blocks[p].order < 0 {
                continue;
            }
            edge_facts(cx, p, h);
            let mut alo = 0;
            let mut ahi = 0;
            range_with_facts(cx, ir_val(cx, ir_arg(cx, v, i)), &alo, &ahi, 1);
            rlo = lesser(rlo, alo);
            rhi = greater(rhi, ahi);
        }
        cx.pr_stack.count -= PR_STRIDE;
        facts_restore(cx, mark);
        cx.fact_nest = fact_nest;
        cx.pr_active -= 1;
        if rlo > rhi {
            rlo = tlo;
            rhi = thi;
        }
        rlo = greater(rlo, tlo);
        rhi = lesser(rhi, thi);
        let taint = taint_leave(cx, level, outer);
        pr_keep(cx, v, rlo, rhi, level, taint);
        *lo = rlo;
        *hi = rhi;
    }
}

// The ranges of the integer phis of loop header h (the first HEADER_PHIS),
// found together; *lo and *hi for v among them (its type's range on
// entry).
fn header_ranges(mut cx: *FnCtx, h: i64, v: i64, lo: *i64, hi: *i64, depth: i64) {
    unsafe {
        let base = cx.hr.count;
        let mut n = 0;
        let mut phi = cx.blocks[h].first;
        while phi != 0 && cx.insts[phi].op == Op::Phi && n < HEADER_PHIS {
            let ty = cx.insts[phi].ty;
            if is_integer(ty) && cx.insts[phi].nargs == cx.blocks[h].preds.count
                && !phi_known(cx, phi) {
                cx.hr.push(phi);
                cx.hr.push(type_min(ty));
                cx.hr.push(type_max(ty));
                cx.hr.push(type_max(ty));
                cx.hr.push(type_min(ty));
                for _ in 5..HR_FIELDS {
                    cx.hr.push(0);
                }
                n += 1;
            }
            phi = cx.insts[phi].next;
        }
        let level = cx.pr_stack.count / PR_STRIDE;
        if n == 0 || cx.pr_stack.count + PR_STRIDE * n > PR_STRIDE * PHI_NEST {
            cx.hr.count = base;
            return;
        }
        let outer = taint_enter(cx);
        let mark = facts_save(cx);
        let fact_nest = cx.fact_nest;
        cx.fact_nest = 0;
        cx.pr_active += 1;
        // The entry operands.
        let mut entries = 0;
        for i in 0..cx.blocks[h].preds.count {
            let p = cx.blocks[h].preds.data[i];
            if cx.blocks[p].order < 0 || is_back_edge(cx, p, h) {
                continue;
            }
            entries += 1;
            edge_facts(cx, p, h);
            for m in 0..n {
                let e = base + m * HR_FIELDS;
                let mut alo = 0;
                let mut ahi = 0;
                range_with_facts(cx, ir_val(cx, ir_arg(cx, cx.hr.data[e + HR_PHI], i)), &alo, &ahi,
                    1);
                cx.hr.data[e + HR_RLO] = lesser(cx.hr.data[e + HR_RLO], alo);
                cx.hr.data[e + HR_RHI] = greater(cx.hr.data[e + HR_RHI], ahi);
            }
        }
        let mut settled = entries > 0;
        if settled {
            for m in 0..n {
                let e = base + m * HR_FIELDS;
                cx.hr.data[e + HR_HLO] = cx.hr.data[e + HR_RLO];
                cx.hr.data[e + HR_HHI] = cx.hr.data[e + HR_RHI];
            }
            // Each round ranges the operands coming back under the
            // assumptions, then widens those they leave (each at most three
            // times).
            settled = false;
            for _ in 0..3 * n + 1 {
                for m in 0..n {
                    let e = base + m * HR_FIELDS;
                    pr_push(cx, cx.hr.data[e + HR_PHI], cx.hr.data[e + HR_HLO],
                        cx.hr.data[e + HR_HHI]);
                    cx.hr.data[e + HR_BLO] = MAX_I64;
                    cx.hr.data[e + HR_BHI] = MIN_I64;
                }
                for i in 0..cx.blocks[h].preds.count {
                    let p = cx.blocks[h].preds.data[i];
                    if cx.blocks[p].order < 0 || !is_back_edge(cx, p, h) {
                        continue;
                    }
                    edge_facts(cx, p, h);
                    for m in 0..n {
                        let e = base + m * HR_FIELDS;
                        let mut blo = 0;
                        let mut bhi = 0;
                        range_with_facts(cx, ir_val(cx, ir_arg(cx, cx.hr.data[e + HR_PHI], i)),
                            &blo, &bhi, 1);
                        cx.hr.data[e + HR_BLO] = lesser(cx.hr.data[e + HR_BLO], blo);
                        cx.hr.data[e + HR_BHI] = greater(cx.hr.data[e + HR_BHI], bhi);
                    }
                }
                cx.pr_stack.count -= PR_STRIDE * n;
                let mut widened = false;
                for m in 0..n {
                    let e = base + m * HR_FIELDS;
                    let blo = cx.hr.data[e + HR_BLO];
                    let bhi = cx.hr.data[e + HR_BHI];
                    let hlo = cx.hr.data[e + HR_HLO];
                    let hhi = cx.hr.data[e + HR_HHI];
                    if blo >= hlo && bhi <= hhi {
                        continue;
                    }
                    widened = true;
                    cx.hr.data[e + HR_STAGE] += 1;
                    if cx.hr.data[e + HR_STAGE] == 1 {
                        cx.hr.data[e + HR_HLO] = lesser(hlo, blo);
                        cx.hr.data[e + HR_HHI] = greater(hhi, bhi);
                    } else if cx.hr.data[e + HR_STAGE] == 2 {
                        let mut flo = 0;
                        let mut fhi = 0;
                        back_fact_hull(cx, h, cx.hr.data[e + HR_PHI], cx.hr.data[e + HR_TLO],
                            cx.hr.data[e + HR_THI], &flo, &fhi);
                        if blo < hlo {
                            cx.hr.data[e + HR_HLO] = lesser(hlo, flo);
                        }
                        if bhi > hhi {
                            cx.hr.data[e + HR_HHI] = greater(hhi, fhi);
                        }
                    } else {
                        cx.hr.data[e + HR_HLO] = cx.hr.data[e + HR_TLO];
                        cx.hr.data[e + HR_HHI] = cx.hr.data[e + HR_THI];
                    }
                }
                if !widened {
                    settled = true;
                    break;
                }
            }
        }
        facts_restore(cx, mark);
        cx.fact_nest = fact_nest;
        cx.pr_active -= 1;
        let taint = taint_leave(cx, level, outer);
        let keep = taint >= level;
        for m in 0..n {
            let e = base + m * HR_FIELDS;
            let tlo = cx.hr.data[e + HR_TLO];
            let thi = cx.hr.data[e + HR_THI];
            let mut rlo = tlo;
            let mut rhi = thi;
            if settled {
                rlo = greater(tlo, lesser(cx.hr.data[e + HR_RLO], cx.hr.data[e + HR_BLO]));
                rhi = lesser(thi, greater(cx.hr.data[e + HR_RHI], cx.hr.data[e + HR_BHI]));
            }
            let p = cx.hr.data[e + HR_PHI];
            pr_keep(cx, p, rlo, rhi, level, taint);
            if p == v {
                *lo = rlo;
                *hi = rhi;
            }
        }
        cx.hr.count = base;
    }
}

// What the facts on the edges into h coming back say of phi v's operands
// there (of type range [tlo, thi]), alone.
fn back_fact_hull(mut cx: *FnCtx, h: i64, v: i64, tlo: i64, thi: i64, lo: *i64, hi: *i64) {
    unsafe {
        let mut rlo = thi;
        let mut rhi = tlo;
        for i in 0..cx.insts[v].nargs {
            let p = cx.blocks[h].preds.data[i];
            if cx.blocks[p].order < 0 || !is_back_edge(cx, p, h) {
                continue;
            }
            edge_facts(cx, p, h);
            let mut olo = tlo;
            let mut ohi = thi;
            narrow_by_facts(cx, ir_val(cx, ir_arg(cx, v, i)), &olo, &ohi, 1);
            rlo = lesser(rlo, olo);
            rhi = greater(rhi, ohi);
        }
        *lo = rlo;
        *hi = rhi;
    }
}
