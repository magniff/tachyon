// Value ranges and the comparisons they decide (0.4): bounds-check
// elimination, comparison folding, jump threading on implied conditions,
// and comparison chains turned into switches.
//
// A fact is a comparison (or a bool) known to hold, or not, at a block: the
// condition of every branch on the way to it along the dominator tree (when
// the edge into a block on that way is its only way in), the case of a
// switch that leads there, and for the blocks of a counted loop
// (scev.tach) `i < n` and `i >= start` for its induction variable. The
// range of an integer value is an interval (in the signed 64-bit view of
// its canonical value) from its type and its operation (masks, remainders,
// conversions, constants), narrowed by the facts that compare it with a
// constant. A comparison is decided when the facts about the same operands,
// or the ranges, leave only outcomes that agree.
//
// 0.11: phis have ranges (the union of their operands', a loop's found by
// induction: below), while a check's branch is decided; facts comparing a
// value with another bound it by the other's range; shifts and 64-bit
// conversions keep ranges; and a branch on a phi of `&&` or `||` is
// threaded from the predecessor that decided it, so that the facts on the
// way hold where it leads.

mod chains;
mod interval;
mod phi;
mod thread;

use crate::base::{IntVec, alloc_array, free};
use crate::front::types::{TY_BOOL, int_bits, is_integer, is_signed};
use crate::middle::ir::{
    BLOCKS, Cond, INSTS, INST_COUNT, IRF, IRFUNCS, Op, Term, ir_append, ir_arg, ir_make, ir_val,
};
use crate::middle::ir::cfg::{case_target, case_value};
use crate::middle::ir::verify::verify_func;
use crate::middle::opt::{remove_trivial_phis, remove_unreachable, resolve_all, simplify_cfg};
use crate::middle::fold::is_const;
use crate::middle::loops::{
    LP_PARENT, analyze_loops, innermost_loop, loop_count, loop_latch, loop_preheader,
};
use crate::middle::scev::{counted_loop, iv_start};
use crate::middle::ir::Cond::{Eq, Ge, Gt, Le, Lt, Ne};
use crate::middle::range::chains::chains_to_switches;
use crate::middle::range::interval::{
    MAX_I64, MIN_I64, greater, lesser, range_at, range_with_facts, type_max, type_min,
};
use crate::middle::range::phi::{FACT_NEST, FACT_RANGE_DEPTH, PHI_RANGES, forget_phi_ranges};
use crate::middle::range::thread::{thread_implied, thread_phi_conditions};

// The facts at a block: pairs (comparison or bool value, holds).
static mut FACTS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// (0.11) Changes of FACTS are counted (FACTS_VER); FACT_MARK[v] is
// MARK_STAMP when a comparison of FACTS has v as an operand, for the
// FACTS of version MARK_VER: narrow_by_facts looks at the facts only for
// such a v.
static mut FACTS_VER: i64 = 1;
static mut MARK_VER: i64 = 0;
static mut MARK_STAMP: i64 = 0;
static mut FACT_MARK: *i64 = 0 as *i64;
static mut MARK_CAP: i64 = 0;
// Per loop: the comparisons its counted test implies (0: none), made for
// the facts (not in any block).
static mut LOOP_FACT_LT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut LOOP_FACT_GE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Outcomes of a comparison as a set: 1 less, 2 equal, 4 greater.
fn cond_set(c: Cond) -> i64 {
    match c {
        Lt => 1,
        Le => 3,
        Eq => 2,
        Ne => 5,
        Gt => 4,
        Ge => 6,
    }
}

// The set with less and greater swapped (the operands swapped).
fn mirror_set(s: i64) -> i64 {
    (s & 2) | ((s & 1) << 2) | ((s & 4) >> 2)
}

fn is_order(c: Cond) -> bool {
    c != Eq && c != Ne
}

// A comparison instruction outside any block, for a fact.
fn fact_cmp(cond: Cond, ty: i64, a: i64, b: i64) -> i64 {
    let v = ir_make(Op::Cmp, TY_BOOL, a, b, 0);
    unsafe {
        INSTS[v].cond = cond;
        INSTS[v].imm2 = ty;
    }
    v
}

fn fact_const(value: i64, ty: i64) -> i64 {
    ir_make(Op::Const, ty, 0, 0, value)
}

// The facts of the counted loops of the function (after analyze_loops).
fn make_loop_facts() {
    LOOP_FACT_LT.count = 0;
    LOOP_FACT_GE.count = 0;
    for l in 0..loop_count() {
        let mut lt = 0;
        let mut ge = 0;
        let mut iv = 0;
        let mut step = 0;
        let mut n = 0;
        let mut ne = false;
        if loop_preheader(l) != 0 && loop_latch(l) != 0
            && counted_loop(l, &iv, &step, &n, &ne) && !ne {
            let latch = loop_latch(l);
            let ty = unsafe { INSTS[BLOCKS[latch].cond].imm2 };
            let start = iv_start(l, iv);
            if step == 1 {
                lt = fact_cmp(Lt, ty, iv, n);
                ge = fact_cmp(Ge, ty, iv, start);
            } else {
                lt = fact_cmp(Gt, ty, iv, n);
                ge = fact_cmp(Le, ty, iv, start);
            }
        }
        LOOP_FACT_LT.push(lt);
        LOOP_FACT_GE.push(ge);
    }
}

// The facts at the start of block b into FACTS.
fn collect_facts(b: i64) {
    unsafe {
        FACTS_VER += 1;
        FACTS.count = 0;
        let mut x = b;
        let mut steps = 0;
        while steps < 64 {
            steps += 1;
            if BLOCKS[x].preds.count == 1 {
                let p = BLOCKS[x].preds.data[0];
                edge_fact(p, x);
            }
            let up = BLOCKS[x].idom;
            if up == x || up == 0 {
                break;
            }
            x = up;
        }
        let mut l = innermost_loop(b);
        while l >= 0 {
            if l < LOOP_FACT_LT.count && LOOP_FACT_LT.data[l] != 0 {
                FACTS.push(LOOP_FACT_LT.data[l]);
                FACTS.push(1);
                FACTS.push(LOOP_FACT_GE.data[l]);
                FACTS.push(1);
            }
            l = LP_PARENT.data[l];
        }
    }
}

// The fact the edge p -> x gives (x reached by it), if any.
fn edge_fact(p: i64, x: i64) {
    unsafe {
        FACTS_VER += 1;
        if BLOCKS[p].term == Term::Branch && BLOCKS[p].s0 != BLOCKS[p].s1 {
            FACTS.push(ir_val(BLOCKS[p].cond));
            FACTS.push(if BLOCKS[p].s0 == x { 1 } else { 0 });
        } else if BLOCKS[p].term == Term::Switch && BLOCKS[p].s0 != x {
            // x is the target of exactly one case: the value is that case's.
            let mut found = -1;
            let mut count = 0;
            for i in 0..BLOCKS[p].ncases {
                if case_target(p, i) == x {
                    found = i;
                    count += 1;
                }
            }
            if count == 1 {
                let v = ir_val(BLOCKS[p].cond);
                let ty = INSTS[v].ty;
                FACTS.push(fact_cmp(Eq, ty, v, fact_const(case_value(p, found), ty)));
                FACTS.push(1);
            }
        }
    }
}

// v with conversions between 64-bit integer types (which change no bits)
// looked through: values equal as bits compare equal.
pub fn bits_of_value(v: i64) -> i64 {
    unsafe {
        let mut x = ir_val(v);
        while INSTS[x].op == Op::Conv && is_integer(INSTS[x].ty) && is_integer(INSTS[x].imm2)
            && int_bits(INSTS[x].ty) == 64 && int_bits(INSTS[x].imm2) == 64 {
            x = ir_val(INSTS[x].a);
        }
        x
    }
}

// ---- Ranges at a block, and the comparisons they decide ----

// Prepares the range queries of value_range_at for function fi: its
// loops and their facts (again after its control flow changes).
pub fn prepare_ranges(fi: i64) {
    analyze_loops(fi);
    make_loop_facts();
    forget_phi_ranges();
}

// The range of integer value v at block b (the signed 64-bit view of its
// canonical value): from its operations and the facts that hold at b.
pub fn value_range_at(v: i64, b: i64, lo: *i64, hi: *i64) {
    collect_facts(b);
    range_at(v, lo, hi);
}

// Narrows [*lo, *hi], the range of v, by the facts in FACTS comparing v
// with a constant, or (0.11; while a check's branch is decided, as for
// phis, and not too deep) with a value whose range bounds it: v < w gives
// v < w's upper bound, v > w v > w's lower one, v == w w's range (an
// unsigned comparison only with a non-negative w).
fn narrow_by_facts(v: i64, lo: *i64, hi: *i64, depth: i64) {
    unsafe {
        if MARK_VER != FACTS_VER {
            mark_facts();
        }
        let x0 = bits_of_value(v);
        if x0 < MARK_CAP && FACT_MARK[x0] != MARK_STAMP {
            return;
        }
        let mut i = 0;
        while i < FACTS.count {
            let f = FACTS.data[i];
            let holds = FACTS.data[i + 1] != 0;
            i += 2;
            if INSTS[f].op != Op::Cmp || !is_integer(INSTS[f].imm2) {
                continue;
            }
            let mut cond = INSTS[f].cond;
            if !holds {
                cond = cond.negate();
            }
            let fa = bits_of_value(INSTS[f].a);
            let fb = bits_of_value(INSTS[f].b);
            let x = bits_of_value(v);
            let mut k = 0;
            let mut w = 0;
            if fa == x && fa != fb {
                w = fb;
            } else if fb == x && fa != fb {
                w = fa;
                cond = cond.mirror();
            } else {
                continue;
            }
            let signed = is_signed(INSTS[f].imm2);
            let min = 0 - 9223372036854775807 - 1;
            let max = 9223372036854775807;
            // The bound w gives: k for a constant; else its range's upper end
            // for < and <=, its lower end for > and >=, both for ==.
            let mut klo = 0;
            if is_const(w) {
                k = INSTS[w].imm;
                klo = k;
            } else {
                if !PHI_RANGES || FACT_NEST >= FACT_RANGE_DEPTH || cond == Ne {
                    continue;
                }
                let mut whi = 0;
                FACT_NEST += 1;
                range_with_facts(w, &klo, &whi, depth + 1);
                FACT_NEST -= 1;
                if !signed && klo < 0 {
                    continue;
                }
                k = if cond == Gt || cond == Ge { klo } else { whi };
            }
            match cond {
                Eq => {
                    if is_const(w) {
                        *lo = k;
                        *hi = k;
                    } else if klo <= *hi && k >= *lo {
                        *lo = greater(*lo, klo);
                        *hi = lesser(*hi, k);
                    }
                }
                Ne => {
                    if *lo == k && k != max {
                        *lo = k + 1;
                    } else if *hi == k && k != min {
                        *hi = k - 1;
                    }
                }
                Lt | Le => {
                    let bound = if cond == Lt { if k == min { min } else { k - 1 } } else { k };
                    if signed || (k >= 0 && *lo >= 0) {
                        if bound < *hi {
                            *hi = bound;
                        }
                    } else if k >= 0 {
                        // Unsigned: below a non-negative bound, so non-negative.
                        if *lo < 0 {
                            *lo = 0;
                        }
                        if bound < *hi {
                            *hi = bound;
                        }
                    }
                }
                _ => {
                    let bound = if cond == Gt { if k == max { max } else { k + 1 } } else { k };
                    if signed || (k >= 0 && *lo >= 0) {
                        if bound > *lo {
                            *lo = bound;
                        }
                    }
                }
            }
        }
    }
}

// Whether range [lo, hi] of comparison operand v can help decide it: not
// its type's whole range, and for an unsigned order not of unknown sign.
fn bounds_something(v: i64, lo: i64, hi: i64, signed: bool, order: bool) -> bool {
    unsafe {
        let ty = INSTS[v].ty;
        if lo <= type_min(ty) && hi >= type_max(ty) {
            return false;
        }
        signed || !order || lo >= 0
    }
}

// Marks the operands of the comparisons in FACTS (see FACT_MARK).
fn mark_facts() {
    unsafe {
        if MARK_CAP <= INST_COUNT {
            free(FACT_MARK as *u8);
            MARK_CAP = 2 * INST_COUNT + 1024;
            FACT_MARK = alloc_array::<i64>(MARK_CAP);
        }
        MARK_STAMP += 1;
        let mut i = 0;
        while i < FACTS.count {
            let f = FACTS.data[i];
            i += 2;
            if INSTS[f].op != Op::Cmp {
                continue;
            }
            let fa = bits_of_value(INSTS[f].a);
            let fb = bits_of_value(INSTS[f].b);
            if fa < MARK_CAP {
                FACT_MARK[fa] = MARK_STAMP;
            }
            if fb < MARK_CAP {
                FACT_MARK[fb] = MARK_STAMP;
            }
        }
        MARK_VER = FACTS_VER;
    }
}

// The outcomes possible for intervals a and b.
fn interval_outcomes(alo: i64, ahi: i64, blo: i64, bhi: i64) -> i64 {
    let mut s = 0;
    if alo < bhi {
        s |= 1;
    }
    if alo <= bhi && blo <= ahi {
        s |= 2;
    }
    if ahi > blo {
        s |= 4;
    }
    s
}

// Whether comparison or bool c holds at a block with facts FACTS: 1 true,
// 0 false, -1 unknown.
fn decide(c: i64) -> i64 {
    unsafe {
        let mut i = 0;
        while i < FACTS.count {
            if FACTS.data[i] == c {
                return FACTS.data[i + 1];
            }
            i += 2;
        }
        if INSTS[c].op != Op::Cmp || !is_integer(INSTS[c].imm2) {
            return -1;
        }
        let a = bits_of_value(INSTS[c].a);
        let b = bits_of_value(INSTS[c].b);
        let q = cond_set(INSTS[c].cond);
        let signed = is_signed(INSTS[c].imm2);
        // (0.11) The cheaper side first (a phi's range costs most): when its
        // range bounds nothing, the other's cannot decide anything.
        let mut alo = MIN_I64;
        let mut ahi = MAX_I64;
        let mut blo = MIN_I64;
        let mut bhi = MAX_I64;
        let order = is_order(INSTS[c].cond);
        if INSTS[a].op == Op::Phi && INSTS[b].op != Op::Phi {
            range_at(b, &blo, &bhi);
            if bounds_something(b, blo, bhi, signed, order) {
                range_at(a, &alo, &ahi);
            }
        } else {
            range_at(a, &alo, &ahi);
            if bounds_something(a, alo, ahi, signed, order) {
                range_at(b, &blo, &bhi);
            }
        }
        let nonneg = alo >= 0 && blo >= 0;
        let mut outcomes = 7;
        if a == b {
            outcomes = 2;
        }
        if signed || nonneg || !is_order(INSTS[c].cond) {
            outcomes &= interval_outcomes(alo, ahi, blo, bhi);
        }
        i = 0;
        while i < FACTS.count {
            let f = FACTS.data[i];
            let holds = FACTS.data[i + 1] != 0;
            i += 2;
            if INSTS[f].op != Op::Cmp || !is_integer(INSTS[f].imm2) {
                continue;
            }
            let fa = bits_of_value(INSTS[f].a);
            let fb = bits_of_value(INSTS[f].b);
            let mut fs = cond_set(INSTS[f].cond);
            if !holds {
                fs = 7 & ~fs;
            }
            if fa == b && fb == a {
                fs = mirror_set(fs);
            } else if fa != a || fb != b {
                continue;
            }
            let fsigned = is_signed(INSTS[f].imm2);
            if fs == 2 || fs == 5 || fsigned == signed || nonneg {
                outcomes &= fs;
            } else if fsigned && !signed && alo >= 0 && (fs & 4) == 0 {
                // a <s b (or <=) with a >= 0: both are non-negative, and the
                // unsigned order is the same.
                outcomes &= fs;
            }
        }
        if outcomes == 0 {
            return -1;
        }
        if (outcomes & ~q) == 0 {
            return 1;
        }
        if (outcomes & q) == 0 {
            return 0;
        }
        -1
    }
}

// ---- The pass ----

// Decides the branches of fi whose condition the facts and ranges decide,
// threads edges past blocks whose test the edge decides, and turns chains
// of equality tests into switches. Returns whether anything changed.
pub fn fold_by_ranges(fi: i64) -> bool {
    unsafe {
        IRF = fi;
        resolve_all(fi);
        let mut changed = thread_phi_conditions(fi);
        if changed {
            resolve_all(fi);
            remove_unreachable(fi);
            remove_trivial_phis(fi);
            resolve_all(fi);
        }
        analyze_loops(fi);
        make_loop_facts();
        for round in 0..3 {
            if round > 0 {
                resolve_all(fi);
                analyze_loops(fi);
            }
            forget_phi_ranges();
            let mut folded = false;
            for i in 0..IRFUNCS[fi].blocks.count {
                let b = IRFUNCS[fi].blocks.data[i];
                if BLOCKS[b].removed != 0 || BLOCKS[b].order < 0 || BLOCKS[b].term != Term::Branch {
                    continue;
                }
                let c = ir_val(BLOCKS[b].cond);
                if is_const(c) {
                    continue;
                }
                PHI_RANGES = is_check(BLOCKS[b].s0) || is_check(BLOCKS[b].s1);
                let d = decide_branch(b, c);
                PHI_RANGES = false;
                if d >= 0 {
                    let k = ir_make(Op::Const, TY_BOOL, 0, 0, d);
                    ir_append(b, k);
                    BLOCKS[b].cond = k;
                    folded = true;
                }
            }
            if folded {
                simplify_cfg(fi);
            }
            let threaded = thread_implied(fi);
            if !folded && !threaded {
                break;
            }
            changed = true;
        }
        if chains_to_switches(fi) {
            changed = true;
        }
        if changed {
            resolve_all(fi);
            remove_unreachable(fi);
            remove_trivial_phis(fi);
            verify_func(fi, c"value ranges");
        }
        changed
    }
}

// Whether block b is where a check fails: it ends the program.
fn is_check(b: i64) -> bool {
    unsafe { BLOCKS[b].term == Term::Unreach }
}

// Whether the condition c of block b's branch is decided: by the facts at
// b, or, for a phi of b, by the facts on each incoming edge alike.
fn decide_branch(b: i64, c: i64) -> i64 {
    unsafe {
        collect_facts(b);
        let d = decide(c);
        if d >= 0 || INSTS[c].op != Op::Phi || INSTS[c].block != b {
            return d;
        }
        let mut all = -1;
        for k in 0..INSTS[c].nargs {
            let p = BLOCKS[b].preds.data[k];
            if BLOCKS[p].term == Term::Switch
                || (BLOCKS[p].term == Term::Branch && BLOCKS[p].s0 == BLOCKS[p].s1) {
                return -1;
            }
            collect_facts(p);
            edge_fact(p, b);
            let dk = decide(ir_val(ir_arg(c, k)));
            if dk < 0 || (all >= 0 && dk != all) {
                return -1;
            }
            all = dk;
        }
        all
    }
}
