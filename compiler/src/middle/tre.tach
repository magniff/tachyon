// Tail recursion elimination, with accumulators (0.4). A function whose
// returns are `return f(args)` or `return f(args) op y` / `y op f(args)`
// (op one associative and commutative integer operation: + * & | ^, the
// call to itself last before the return) becomes a loop: the entry block
// is the loop's header, with a phi per parameter and one for the
// accumulator; a recursive return jumps back with the new arguments and
// `acc op y`; any other return gives `acc op value`. Fibonacci's
// `fib(n - 1) + fib(n - 2)` becomes a loop adding fib(n - 1) and going on
// with n - 2: half the calls.
//
// The function must return a scalar, take scalar parameters only, and have
// no frame slots (each activation's memory would be one).

// Moves a return through a phi block into the blocks before it: a block
// holding only a phi that its `ret` returns, entered by jumps, becomes a
// `ret` of the phi's operand in each predecessor.
use crate::base::{IntVec, free};
use crate::front::types::{FNS, is_integer};
use crate::middle::ctx::FnCtx;
use crate::middle::fold::all_ones;
use crate::middle::inline::ir_callee;
use crate::middle::ir::{
    IRFUNCS, Op, Term, ir_append, ir_arg, ir_enter, ir_make, ir_new_block, ir_operand,
    ir_operand_count, ir_prepend, ir_set_arg, ir_type, ir_unlink, ir_val,
};
use crate::middle::ir::Op::{Add, And, Const, Mul, Or, Param, Phi, Slot, Xor};
use crate::middle::loops::clone_inst;
use crate::middle::opt::{remove_unreachable, resolve_all};
use crate::middle::scev::{append_const, append_inst};

fn split_returns(mut cx: *FnCtx, fi: i64) {
    unsafe {
        for i in 0..IRFUNCS[fi].blocks.count {
            let r = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[r].removed != 0 || cx.blocks[r].term != Term::Ret
                || cx.blocks[r].preds.count < 2 {
                continue;
            }
            let phi = ir_val(cx, cx.blocks[r].cond);
            if phi == 0 || cx.insts[phi].op != Phi || cx.insts[phi].block != r
                || cx.blocks[r].first != phi || cx.blocks[r].last != phi {
                continue;
            }
            let mut jumps = true;
            for k in 0..cx.blocks[r].preds.count {
                if cx.blocks[cx.blocks[r].preds.data[k]].term != Term::Jump {
                    jumps = false;
                }
            }
            if !jumps {
                continue;
            }
            for k in 0..cx.blocks[r].preds.count {
                let p = cx.blocks[r].preds.data[k];
                cx.blocks[p].term = Term::Ret;
                cx.blocks[p].cond = ir_val(cx, ir_arg(cx, phi, k));
                cx.blocks[p].s0 = 0;
            }
            cx.blocks[r].preds.count = 0;
        }
    }
    remove_unreachable(cx, fi);
}

// The number of uses of v in function fi (operands and conditions).
fn use_count(mut cx: *FnCtx, fi: i64, v: i64) -> i64 {
    let mut n = 0;
    unsafe {
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            let mut u = cx.blocks[b].first;
            while u != 0 {
                for k in 0..ir_operand_count(cx, u) {
                    if ir_val(cx, ir_operand(cx, u, k)) == v {
                        n += 1;
                    }
                }
                u = cx.insts[u].next;
            }
            if cx.blocks[b].cond != 0 && ir_val(cx, cx.blocks[b].cond) == v {
                n += 1;
            }
        }
    }
    n
}

// The recursive call of a tail site: block b returns `call` or `call op y`;
// *y is the other operand (0 for a plain tail call), *op its operation.
// Returns the call, or 0.
fn tail_site(mut cx: *FnCtx, fi: i64, b: i64, op: *Op, y: *i64) -> i64 {
    unsafe {
        if cx.blocks[b].term != Term::Ret {
            return 0;
        }
        let r = ir_val(cx, cx.blocks[b].cond);
        if r == 0 || cx.insts[r].block != b {
            return 0;
        }
        let mut call = 0;
        if ir_callee(cx, r) == fi {
            call = r;
            *y = 0;
        } else {
            let o = cx.insts[r].op;
            if !(o == Add || o == Mul || o == And || o == Or || o == Xor)
                || !is_integer(cx.insts[r].ty) {
                return 0;
            }
            let a = ir_val(cx, cx.insts[r].a);
            let c = ir_val(cx, cx.insts[r].b);
            // (When both are calls to itself, the later one.)
            if ir_callee(cx, c) == fi && cx.insts[c].block == b && a != c
                && only_pure_after(cx, c, r) {
                call = c;
                *y = a;
            } else if ir_callee(cx, a) == fi && cx.insts[a].block == b && a != c {
                call = a;
                *y = c;
            } else {
                return 0;
            }
            *op = o;
            if use_count(cx, fi, call) != 1 || use_count(cx, fi, r) != 1 {
                return 0;
            }
        }
        if !only_pure_after(cx, call, r) {
            return 0;
        }
        call
    }
}

// Whether nothing with an effect follows instruction `call` in its block
// (the operation r and pure instructions only).
fn only_pure_after(mut cx: *FnCtx, call: i64, r: i64) -> bool {
    unsafe {
        let mut v = cx.insts[call].next;
        while v != 0 {
            if v != r && !cx.insts[v].op.is_pure() && cx.insts[v].op != Const {
                return false;
            }
            v = cx.insts[v].next;
        }
        true
    }
}

pub fn eliminate_tail_recursion(mut cx: *FnCtx, fi: i64) -> bool {
    unsafe {
        ir_enter(cx, fi);
        let f = IRFUNCS[fi].f;
        if IRFUNCS[fi].result_ptr != 0 || !is_integer(ir_type(FNS[f].ret)) {
            return false;
        }
        let entry = IRFUNCS[fi].entry;
        // Scalar parameters only, no frame slots, and a self call somewhere.
        let mut any_call = false;
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            let mut v = cx.blocks[b].first;
            while v != 0 {
                let op = cx.insts[v].op;
                if op == Slot || (op == Param && (cx.insts[v].imm < 0 || cx.insts[v].imm2 != 0)) {
                    return false;
                }
                if op == Param && b != entry {
                    return false;
                }
                if ir_callee(cx, v) == fi {
                    any_call = true;
                }
                v = cx.insts[v].next;
            }
        }
        if !any_call {
            return false;
        }
        resolve_all(cx, fi);
        split_returns(cx, fi);
        // The tail sites, all with one operation.
        let mut sites = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut acc_op = Op::None;
        let mut ok = true;
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            let mut op = Op::None;
            let mut y = 0;
            let call = tail_site(cx, fi, b, &op, &y);
            if call == 0 {
                continue;
            }
            if y != 0 {
                if acc_op != Op::None && acc_op != op {
                    ok = false;
                }
                acc_op = op;
            }
            sites.push(b);
            sites.push(call);
            sites.push(y);
        }
        if !ok || sites.count == 0 {
            free(sites.data as *u8);
            return false;
        }
        let ty = ir_type(FNS[f].ret);
        // A new entry holds the parameters and jumps to the old one, the loop's
        // header. Each parameter becomes a phi there (its uses follow).
        let e2 = ir_new_block(cx);
        cx.blocks[e2].sealed = 1;
        let old_preds = cx.blocks[entry].preds.count;
        let mut params = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut v = cx.blocks[entry].first;
        while v != 0 {
            let next = cx.insts[v].next;
            if cx.insts[v].op == Param {
                params.push(v);
            }
            v = next;
        }
        let nsites = sites.count / 3;
        let npreds = old_preds + 1 + nsites;
        for i in 0..params.count {
            let p = params.data[i];
            let fresh = clone_inst(cx, p);
            ir_append(cx, e2, fresh);
            ir_unlink(cx, p);
            cx.insts[p].op = Phi;
            cx.insts[p].a = 0;
            cx.insts[p].b = 0;
            cx.insts[p].imm = 0;
            cx.insts[p].imm2 = 0;
            cx.insts[p].args = cx.args.count;
            cx.insts[p].nargs = npreds;
            let index = cx.insts[fresh].imm;
            for k in 0..old_preds {
                cx.args.push(p);
                cx.argty.push(0);
            }
            cx.args.push(fresh);
            cx.argty.push(0);
            for s in 0..nsites {
                cx.args.push(ir_arg(cx, sites.data[3 * s + 1], index));
                cx.argty.push(0);
            }
            ir_prepend(cx, entry, p);
        }
        let mut acc = 0;
        if acc_op != Op::None {
            let identity = if acc_op == Mul { 1 } else if acc_op == And { all_ones(ty) } else { 0 };
            let start = append_const(cx, e2, identity, ty);
            acc = ir_make(cx, Phi, ty, 0, 0, 0);
            cx.insts[acc].args = cx.args.count;
            cx.insts[acc].nargs = npreds;
            for k in 0..old_preds {
                cx.args.push(acc);
                cx.argty.push(0);
            }
            cx.args.push(start);
            cx.argty.push(0);
            for s in 0..nsites {
                cx.args.push(0);
                cx.argty.push(0);
            }
            ir_prepend(cx, entry, acc);
        }
        cx.blocks[e2].term = Term::Jump;
        cx.blocks[e2].s0 = entry;
        cx.blocks[entry].preds.push(e2);
        IRFUNCS[fi].entry = e2;
        // The tail sites jump back.
        for s in 0..nsites {
            let b = sites.data[3 * s];
            let call = sites.data[3 * s + 1];
            let y = sites.data[3 * s + 2];
            let r = ir_val(cx, cx.blocks[b].cond);
            let mut next_acc = acc;
            if r != call {
                ir_unlink(cx, r);
            }
            ir_unlink(cx, call);
            if acc != 0 {
                if y != 0 {
                    next_acc = append_inst(cx, b, acc_op, ty, acc, y);
                }
                ir_set_arg(cx, acc, old_preds + 1 + s, next_acc);
            }
            cx.blocks[b].term = Term::Jump;
            cx.blocks[b].cond = 0;
            cx.blocks[b].s0 = entry;
            cx.blocks[entry].preds.push(b);
        }
        // The other returns combine their value with the accumulator.
        if acc != 0 {
            for i in 0..IRFUNCS[fi].blocks.count {
                let b = IRFUNCS[fi].blocks.data[i];
                if cx.blocks[b].removed != 0 || cx.blocks[b].term != Term::Ret
                    || cx.blocks[b].cond == 0 {
                    continue;
                }
                cx.blocks[b].cond = append_inst(cx, b, acc_op, ty, acc,
                    ir_val(cx, cx.blocks[b].cond));
            }
        }
        free(params.data as *u8);
        free(sites.data as *u8);
        resolve_all(cx, fi);
        true
    }
}
