// The loop vectorizer (0.10): an innermost counted loop (induction
// variable i from `start`, step 1, to `n`; scev.tach) whose body is a
// chain of blocks that only branch out to checks that fail (to blocks
// ending in `unreachable`), whose memory accesses are unit-stride loads
// and stores of one scalar type T, and whose only values carried from one
// iteration to the next are i and reductions (`r = r op x` on integers,
// op one of + - * & | ^), gets a vector version: VF = 16 / size(T) lanes
// per iteration, in vector instructions, run for the first
// (n - start) & ~(VF - 1) iterations when it may be, the original loop
// running the rest (the remainder) or all of them.
//
//     P:  jump C                        (the old preheader)
//     C:  trips = n - start; ok = trips >= VF && checks && no overlap
//         branch ok, VP, SP
//     VP: splats, reductions' first vectors (the start value in lane 0,
//         the identity in the others), vend = start + (trips & ~(VF - 1))
//     VH: the body on VF lanes; iv += VF; branch iv != vend, VH, VX
//     VX: reductions summed; branch vend == n, E, SP
//     SP: i and the reductions from C or VX; jump H (the scalar loop)
//
// The vector loop runs only when nothing the scalar loop would check can
// fail in any iteration (each check `idx <u len` with idx = i + k, k
// invariant: idx at start >= 0, idx at n - 1 >= that, and below len) and
// when no store overlaps another access of the loop at a different
// address (ranges over the whole loop, compared at run time); the scalar
// loop runs otherwise, and stops where it would. Results are exactly the
// scalar loop's: lanewise float arithmetic is the same IEEE operations
// (float reductions, which would reassociate, are not vectorized), and
// integer reductions wrap. The scalar loop is marked (BLOCKS[h].novec) so
// that it is not vectorized again.

mod build;
mod checks;
mod legality;
mod outer;
pub mod unroll;

pub use unroll::{UNROLL_RUNTIME, unroll_runtime_loops};

use crate::base::{IntVec, free};
use crate::front::types::{TY_I64, TY_U64, is_float, type_size};
use crate::middle::ir::{
    ARGS, ARGTY, BLOCKS, Cond, INSTS, IRF, IRFUNCS, Op, Term, ir_append, ir_arg, ir_make,
    ir_new_block, ir_set_arg, ir_terminate, ir_val, pred_index, verify_func,
};
use crate::middle::opt::resolve_all;
use crate::middle::fold::is_const;
use crate::middle::loops::{
    add_pred_values, canonicalize_loops, form_lcssa, innermost_loop, invariant_in, is_canonical,
    is_innermost, loop_block, loop_count, loop_header, loop_preheader, loop_size, new_phi_in,
    LP_PARENT,
};
use crate::middle::scev::full_unroll_trips;
use crate::middle::profile::{PROFILE_MAX, is_cold_block};
use crate::gen0::target::X86;
use crate::middle::ir::Op::{
    Add, And, Conv, Div, Load, Mul, Phi, Shl, Store, Sub, VBin, VExt, VIns, VSplat, VSum,
};
use crate::middle::vectorize::build::{
    append, cmp, emit_body, eval_at, identity, konst, map_get, map_put,
};
use crate::middle::vectorize::checks::{build_groups, check_tests, overlap_pairs, overlap_tests};
use crate::middle::vectorize::legality::{
    NONAFFINE, analyze, class_of, coef, lane_type, reduction_of_next,
};
use crate::middle::vectorize::outer::vectorize_outer;

// --no-vectorize turns it off (to compare).
pub static mut VECTORIZE: bool = true;

// Set by vectorize_loops when it left a loop to be unrolled whole (see
// vectorize_loop).
pub static mut UNROLL_WHOLE: bool = false;

const VEC_MAX_INSTS: i64 = 160;
const VEC_MAX_CHECKS: i64 = 8;
const VEC_MAX_OVERLAPS: i64 = 16;
const VEC_UNROLL_SIZE: i64 = 40;

// The classes of the loop's instructions (INSTS[v].aux, while INSTS[v].mark
// is the analysis' stamp).
const VC_UNIFORM: i64 = 1;
const VC_VECTOR: i64 = 2;
const VC_SKIP: i64 = 3;

static mut VSTAMP: i64 = 4398046511104;

// The loop being vectorized.
static mut V_IV: i64 = 0;
static mut V_N: i64 = 0;
static mut V_START: i64 = 0;
// The inner loop's induction variable (outer loops, see below), or 0.
static mut V_IV2: i64 = 0;
// The inner loop's induction variable's last value (a constant).
static mut V_LAST2: i64 = 0;
// The number of instructions of the loop.
static mut V_SIZE: i64 = 0;
static mut V_NE: bool = false;
static mut V_ELEM: i64 = 0;
static mut V_VT: i64 = 0;
static mut V_VF: i64 = 0;
static mut V_HAS_STORE: bool = false;
static mut V_HAS_ULOAD: bool = false;
// The blocks of the body, in order, header first.
static mut V_CHAIN: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The checks: (compare, index, length) triples.
static mut V_CHECKS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The memory accesses: (instruction, address, size) triples.
static mut V_ACCESS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The reductions: (phi, next, op) triples.
static mut V_REDS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The vector loop's values of the loop's: (old, new) pairs.
static mut V_MAP: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Values materialized at an iteration (eval_at): (old, iteration, new)
// triples.
static mut V_EVAL: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// ---- The cost model (0.11) ----
//
// After the analysis, whether the vector loop pays, and how many copies of
// the body it runs (U): costs are rough cycles of throughput. A scalar
// iteration costs S (its instructions, a check two, a float division
// four); a vector iteration, U * VF scalar ones, costs U * B + 3 (the
// vector body: an instruction one, a lane-by-lane multiplication
// 3 * VF; the induction variable, its test and branch); the decision
// before the loop, the reductions' setup and their combination after it
// cost G. With T iterations expected (exact for constant bounds, else
// the profile's average: the header's count over the entries'), the
// vector version costs G + (T / (U*VF)) * (U*B + 3) + (T % (U*VF)) * S
// against T * S; U = 2 is tried for small bodies, then U = 1. Without an
// expected T a vector iteration must only be cheaper than the scalar ones
// it replaces, and U is 2 for small bodies, as in 0.10.

// Whether integer multiplication of the loop's lanes is done lane by lane
// (SSE2 has 16-bit lanes only; NEON lacks 64-bit lanes).
fn lanewise_mul() -> bool {
    unsafe {
        let size = type_size(V_ELEM);
        if is_float(V_ELEM) {
            return false;
        }
        if X86 { size != 2 } else { size == 8 }
    }
}

// v as x + c: returns x (0 for a constant) and adds c to *offset.
fn const_base(v: i64, offset: *i64) -> i64 {
    unsafe {
        let mut x = ir_val(v);
        for _ in 0..8 {
            if is_const(x) {
                *offset += INSTS[x].imm;
                return 0;
            }
            if INSTS[x].op != Add || !is_const(ir_val(INSTS[x].b)) {
                return x;
            }
            *offset += INSTS[ir_val(INSTS[x].b)].imm;
            x = ir_val(INSTS[x].a);
        }
        x
    }
}

// The expected number of iterations of loop l (analyzed) per entry, or -1.
fn expected_trips(l: i64) -> i64 {
    unsafe {
        let h = loop_header(l);
        let p = loop_preheader(l);
        let start = ir_val(ir_arg(V_IV, pred_index(h, p)));
        // (Constants, or one value plus two constants: an array's end.)
        let mut off_n = 0;
        let mut off_s = 0;
        let n = const_base(V_N, &off_n);
        let s = const_base(start, &off_s);
        if n == s {
            let t = off_n - off_s;
            return if t > 0 { t } else { -1 };
        }
        let hc = BLOCKS[h].count;
        if PROFILE_MAX <= 0 || hc < 0 {
            return -1;
        }
        // The entries: the preheader's count, or the nearest one above it
        // through single predecessors (blocks made after the profile was
        // read have none).
        let mut b = p;
        for _ in 0..8 {
            if BLOCKS[b].count > 0 {
                return hc / BLOCKS[b].count;
            }
            if BLOCKS[b].count == 0 || BLOCKS[b].preds.count != 1 {
                return -1;
            }
            b = BLOCKS[b].preds.data[0];
        }
        -1
    }
}

// Whether v is computed from the induction variable and constants alone
// (a constant in each copy of the loop fully unrolled from a constant
// start), looking depth operations deep.
fn constant_affine(v: i64, depth: i64) -> bool {
    unsafe {
        let x = ir_val(v);
        if x == V_IV || is_const(x) {
            return true;
        }
        let op = INSTS[x].op;
        if depth == 0 || !(op == Add || op == Sub || op == Mul || op == Shl || op == Conv) {
            return false;
        }
        constant_affine(INSTS[x].a, depth - 1) && (INSTS[x].b == 0 || constant_affine(INSTS[x].b, depth - 1))
    }
}

// How many vector bodies an iteration of the vector loop of l (analyzed)
// runs, 1 or 2; 0 when vectorizing does not pay. unrolled > 0: the scalar
// alternative is the loop fully unrolled, that many times (the unroller
// asks), whose copies keep only the work on each element: the induction
// variable, the latch's test and the addresses affine in it become
// constants and offsets, what is invariant leaves the loop, and a check
// of a constant length on an index made of the induction variable and
// constants (from a constant start) is decided.
fn vector_unroll(l: i64, unrolled: i64) -> i64 {
    unsafe {
        let vf = V_VF;
        let mut s = 2;
        let mut su = 0;
        let mut body = 0;
        for k in 0..V_CHAIN.count {
            let mut v = BLOCKS[V_CHAIN.data[k]].first;
            while v != 0 {
                let op = INSTS[v].op;
                let cls = class_of(v);
                let div = op == Div;
                if op != Phi {
                    let cost = if cls == VC_SKIP { 2 } else if div { 4 } else { 1 };
                    s += cost;
                    if unrolled > 0 && cls != VC_SKIP
                        && (cls != VC_UNIFORM || (!invariant_in(l, v) && coef(l, v) == NONAFFINE)) {
                        su += cost;
                    }
                }
                if cls == VC_UNIFORM {
                    body += 1;
                } else if cls == VC_VECTOR && op != Phi {
                    body += if op == Mul && lanewise_mul() { 3 * vf } else if div { 4 } else { 1 };
                }
                v = INSTS[v].next;
            }
        }
        if unrolled > 0 {
            let h = loop_header(l);
            let start = ir_val(ir_arg(V_IV, pred_index(h, loop_preheader(l))));
            for k in 0..V_CHECKS.count / 3 {
                if !is_const(start) || !is_const(ir_val(V_CHECKS.data[3 * k + 2]))
                    || !constant_affine(V_CHECKS.data[3 * k + 1], 8) {
                    su += 2;
                }
            }
        }
        let nreds = V_REDS.count / 3;
        let mut setup = 6 + 8 * (V_CHECKS.count / 3) + 10 * overlap_pairs();
        for r in 0..nreds {
            let raw = V_REDS.data[3 * r + 2];
            let op = raw as Op;
            setup += if op == Add || op == Sub { 4 } else { 2 + 2 * vf };
        }
        let small = V_SIZE <= VEC_UNROLL_SIZE;
        let t = if unrolled > 0 { unrolled } else { expected_trips(l) };
        if t < 0 {
            let u = if small { 2 } else { 1 };
            return if u * body + 3 < u * vf * s { u } else { 0 };
        }
        let scalar = if unrolled > 0 { t * su } else { t * s };
        let mut best = 0;
        let mut best_cost = scalar;
        let mut u = if small { 2 } else { 1 };
        while u >= 1 {
            let w = u * vf;
            if t >= w {
                let cost = setup + nreds * (u - 1) + (t / w) * (u * body + 3) + (t % w) * s;
                if cost < best_cost {
                    best = u;
                    best_cost = cost;
                }
            }
            u -= 1;
        }
        best
    }
}

fn vectorize_loop(fi: i64, l: i64) -> bool {
    unsafe {
        // (before the analysis, whose marks the trip count's evaluation
        // would overwrite)
        let whole = full_unroll_trips(l);
        let mut e = 0;
        if !analyze(l, &e) {
            return false;
        }
        let unroll = vector_unroll(l, 0);
        if unroll == 0 {
            return false;
        }
        // (0.11: a loop of a few constant trips whose checks kept
        // transform_loops from unrolling it whole, until the ranges removed
        // them, is better unrolled whole when that is cheaper: then each
        // copy keeps only its loads, stores and operations, which SLP may
        // pack, and no test of the trip count or overlap is made)
        if whole > 0 && vector_unroll(l, whole) == 0 {
            UNROLL_WHOLE = true;
            return false;
        }
        IRF = fi;
        let h = loop_header(l);
        let p = loop_preheader(l);
        let start = ir_val(ir_arg(V_IV, pred_index(h, p)));
        V_START = start;
        let vf = V_VF;
        let elem = V_ELEM;
        let vt = V_VT;
        let lt = lane_type(elem);
        V_MAP.count = 0;
        V_EVAL.count = 0;
        // C: the decision.
        let c = ir_new_block();
        let vp = ir_new_block();
        let vh = ir_new_block();
        let vx = ir_new_block();
        let sp = ir_new_block();
        BLOCKS[c].sealed = 1;
        BLOCKS[vp].sealed = 1;
        BLOCKS[vh].sealed = 1;
        BLOCKS[vx].sealed = 1;
        BLOCKS[sp].sealed = 1;
        BLOCKS[p].s0 = c;
        BLOCKS[c].preds.push(p);
        let n = V_N;
        let trips = append(c, Sub, TY_I64, n, start, 0);
        let mut ok = cmp(c, Cond::Ge, TY_U64, trips, konst(c, unroll * vf, TY_I64));
        let last = append(c, Sub, TY_I64, n, konst(c, 1, TY_I64), 0);
        ok = check_tests(l, c, ok, start, last);
        build_groups();
        ok = overlap_tests(l, c, ok, start, last, 0, 0);
        ir_terminate(c, Term::Branch, ok, vp, sp);
        // VP: the vector preheader.
        let mask = konst(vp, 0 - unroll * vf, TY_I64);
        let vtrips = append(vp, And, TY_I64, trips, mask, 0);
        let vend = append(vp, Add, TY_I64, start, vtrips, 0);
        let mut red_init = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut red_id = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for r in 0..V_REDS.count / 3 {
            let phi = V_REDS.data[3 * r];
            let raw = V_REDS.data[3 * r + 2];
            let op = raw as Op;
            let init = ir_val(ir_arg(phi, pred_index(h, p)));
            let id = append(vp, VSplat, vt, konst(vp, identity(op), lt), 0, 0);
            let first = append(vp, VIns, vt, id, init, 0);
            red_init.push(first);
            red_id.push(id);
        }
        ir_terminate(vp, Term::Jump, 0, vh, 0);
        // VH: the vector loop, `unroll` copies of the body (each with its
        // own accumulators, combined after the loop).
        let viv = ir_make(Phi, INSTS[V_IV].ty, 0, 0, 0);
        INSTS[viv].args = ARGS.count;
        INSTS[viv].nargs = 2;
        ARGS.push(start);
        ARGTY.push(0);
        ARGS.push(0);
        ARGTY.push(0);
        ir_append(vh, viv);
        let mut red_phis = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut red_nexts = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for u in 0..unroll {
            for r in 0..V_REDS.count / 3 {
                let rp = ir_make(Phi, vt, 0, 0, 0);
                INSTS[rp].args = ARGS.count;
                INSTS[rp].nargs = 2;
                ARGS.push(if u == 0 { red_init.data[r] } else { red_id.data[r] });
                ARGTY.push(0);
                ARGS.push(0);
                ARGTY.push(0);
                ir_append(vh, rp);
                red_phis.push(rp);
            }
        }
        for u in 0..unroll {
            // A fresh map per copy (the splats of invariants stay).
            let mut k = 0;
            let mut kept = 0;
            while k < V_MAP.count {
                if V_MAP.data[k] < 0 {
                    V_MAP.data[kept] = V_MAP.data[k];
                    V_MAP.data[kept + 1] = V_MAP.data[k + 1];
                    kept += 2;
                }
                k += 2;
            }
            V_MAP.count = kept;
            if u == 0 {
                map_put(V_IV, viv);
            } else {
                map_put(V_IV, append(vh, Add, INSTS[V_IV].ty, viv, konst(vh, u * vf, INSTS[V_IV].ty), 0));
            }
            for r in 0..V_REDS.count / 3 {
                map_put(V_REDS.data[3 * r], red_phis.data[u * (V_REDS.count / 3) + r]);
            }
            emit_body(l, vh, vp);
            for r in 0..V_REDS.count / 3 {
                red_nexts.push(map_get(V_REDS.data[3 * r + 1]));
            }
        }
        let vnext = append(vh, Add, INSTS[V_IV].ty, viv, konst(vh, unroll * vf, INSTS[V_IV].ty), 0);
        ir_set_arg(viv, 1, vnext);
        for i in 0..red_phis.count {
            ir_set_arg(red_phis.data[i], 1, red_nexts.data[i]);
        }
        let more = cmp(vh, Cond::Ne, TY_I64, vnext, vend);
        // (Its predecessors: vp, then vh, the phis' operand order.)
        ir_terminate(vh, Term::Branch, more, vh, vx);
        // VX: the reductions summed.
        let mut red_final = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let nr = V_REDS.count / 3;
        for r in 0..nr {
            let phi = V_REDS.data[3 * r];
            let raw = V_REDS.data[3 * r + 2];
            let op = raw as Op;
            let ty = INSTS[phi].ty;
            let mut vec = red_nexts.data[r];
            for u in 1..unroll {
                let comb = if op == Sub { Add } else { op };
                vec = append(vx, VBin, vt, vec, red_nexts.data[u * nr + r], comb as i64);
            }
            let mut s = 0;
            if op == Add || op == Sub {
                s = append(vx, VSum, lt, vec, 0, 0);
            } else {
                s = append(vx, VExt, lt, vec, 0, 0);
                for k in 1..vf {
                    let x = append(vx, VExt, lt, vec, 0, k);
                    s = append(vx, op, lt, s, x, 0);
                }
            }
            if ty != lt {
                s = append(vx, Conv, ty, s, 0, 0);
                INSTS[s].imm2 = lt;
            }
            red_final.push(s);
        }
        let done = cmp(vx, Cond::Eq, TY_I64, vend, n);
        ir_terminate(vx, Term::Branch, done, e, sp);
        // SP: the scalar loop's preheader, from C or VX (its predecessors, in
        // that order).
        let mut vals = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        vals.push(start);
        vals.push(vend);
        let iv0 = new_phi_in(sp, INSTS[V_IV].ty, &vals, 0, 2);
        let hp = pred_index(h, p);
        ir_set_arg(V_IV, hp, iv0);
        for r in 0..V_REDS.count / 3 {
            let phi = V_REDS.data[3 * r];
            vals.count = 0;
            vals.push(ir_val(ir_arg(phi, hp)));
            vals.push(red_final.data[r]);
            let r0 = new_phi_in(sp, INSTS[phi].ty, &vals, 0, 2);
            ir_set_arg(phi, hp, r0);
        }
        ir_terminate(sp, Term::Jump, 0, h, 0);
        // (ir_terminate added sp to h's predecessors: it replaces p.)
        BLOCKS[h].preds.count -= 1;
        BLOCKS[h].preds.data[hp] = sp;
        // E: from VX too, with the reductions' results.
        vals.count = 0;
        let mut x = BLOCKS[e].first;
        while x != 0 && INSTS[x].op == Phi {
            let w = ir_val(ir_arg(x, 0));
            let r = reduction_of_next(w);
            if r >= 0 {
                vals.push(red_final.data[r]);
            } else {
                // (Uniform values at the last iteration.)
                vals.push(eval_at(l, w, last, vx));
            }
            x = INSTS[x].next;
        }
        BLOCKS[e].preds.count -= 1;
        add_pred_values(e, vx, &vals, 0);
        BLOCKS[h].novec = 1;
        free(vals.data as *u8);
        free(red_init.data as *u8);
        free(red_id.data as *u8);
        free(red_nexts.data as *u8);
        free(red_phis.data as *u8);
        free(red_final.data as *u8);
        true
    }
}

// Whether loop l is no candidate at a glance: a call, a copy, no memory
// access, or too big (before the costlier analysis).
fn quick_reject(l: i64) -> bool {
    unsafe {
        let mut n = 0;
        let mut memory = false;
        for i in 0..loop_size(l) {
            let mut v = BLOCKS[loop_block(l, i)].first;
            while v != 0 {
                let op = INSTS[v].op;
                if op.is_call() || op == Op::Copy || op.is_vector() {
                    return true;
                }
                if op == Load || op == Store {
                    memory = true;
                }
                n += 1;
                v = INSTS[v].next;
            }
        }
        !memory || n > VEC_MAX_INSTS
    }
}

// Vectorizes the innermost loops of fi that can be; returns whether any
// was.
pub fn vectorize_loops(fi: i64) -> bool {
    unsafe {
        UNROLL_WHOLE = false;
        if !VECTORIZE {
            return false;
        }
        canonicalize_loops(fi);
        let mut headers = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut outer = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for l in 0..loop_count() {
            if loop_header(l) == IRFUNCS[fi].entry || BLOCKS[loop_header(l)].novec != 0
                || is_cold_block(loop_header(l)) || quick_reject(l) {
                continue;
            }
            if is_innermost(l) {
                headers.push(loop_header(l));
                continue;
            }
            // (A loop holding one innermost loop.)
            let mut child = -1;
            let mut children = 0;
            for x in 0..loop_count() {
                if LP_PARENT.data[x] == l {
                    child = x;
                    children += 1;
                }
            }
            if children == 1 && is_innermost(child) {
                outer.push(loop_header(l));
                outer.push(loop_header(child));
            }
        }
        let mut changed = false;
        let mut k = 0;
        while k < outer.count {
            canonicalize_loops(fi);
            let l = innermost_loop(outer.data[k]);
            let l2 = innermost_loop(outer.data[k + 1]);
            k += 2;
            if l < 0 || l2 < 0 || loop_header(l) != outer.data[k - 2] || loop_header(l2) != outer.data[k - 1]
                || !is_canonical(l) || !is_canonical(l2) || LP_PARENT.data[l2] != l {
                continue;
            }
            if form_lcssa(fi, l) {
                resolve_all(fi);
            }
            if vectorize_outer(fi, l, l2) {
                changed = true;
                resolve_all(fi);
                verify_func(fi, c"vectorization (outer loop)");
            }
        }
        free(outer.data as *u8);
        if changed {
            canonicalize_loops(fi);
        }
        // (The loops are found again after a change only.)
        let mut stale = false;
        for i in 0..headers.count {
            if stale {
                canonicalize_loops(fi);
                stale = false;
            }
            let l = innermost_loop(headers.data[i]);
            if l < 0 || loop_header(l) != headers.data[i] || !is_canonical(l) {
                continue;
            }
            if form_lcssa(fi, l) {
                resolve_all(fi);
            }
            if vectorize_loop(fi, l) {
                changed = true;
                stale = true;
                resolve_all(fi);
                verify_func(fi, c"vectorization");
            }
        }
        free(headers.data as *u8);
        changed
    }
}

// ---- For the unroller (scev.tach) ----

// Whether the vectorizer would take loop l instead of unrolling it.
// Returns the lanes (0: not vectorizable). unrolled: the trip count when
// the alternative is the loop fully unrolled (0: the loop as it is).
pub fn vectorizable_lanes(l: i64, unrolled: i64) -> i64 {
    let mut e = 0;
    if VECTORIZE && analyze(l, &e) && vector_unroll(l, unrolled) > 0 { V_VF } else { 0 }
}
