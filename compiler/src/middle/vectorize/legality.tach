// Whether an innermost loop can be vectorized (analyze): its shape (a
// chain of blocks, branching out only to checks that fail), its memory
// accesses (unit-stride, of one element type), its reductions, and the
// class of each of its instructions (uniform, vector or skipped), with the
// affine coefficients of values in the induction variables (coef).

use crate::front::types::{
    TY_BOOL, TY_F32, TY_F64, TY_I16, TY_I32, TY_I64, TY_I8, TY_U16, TY_U32, TY_U64, TY_U8, int_bits,
    is_float, is_integer, type_size, vector_type,
};
use crate::middle::fold::is_const;
use crate::middle::ir::{BLOCKS, INSTS, Op, Term, ir_arg, ir_val};
use crate::middle::ir::Op::{
    Add, And, Const, Conv, Div, Load, Mul, Neg, Or, Phi, Shl, Store, Sub, Xor,
};
use crate::middle::ir::cfg::pred_index;
use crate::middle::loops::{
    invariant_in, loop_contains, loop_header, loop_latch, loop_preheader, loop_size,
};
use crate::middle::profile::is_cold_block;
use crate::middle::scev::counted_loop;
use crate::middle::vectorize::{
    VC_SKIP, VC_UNIFORM, VC_VECTOR, VEC_MAX_INSTS, VEC_MAX_OVERLAPS, VSTAMP, V_ACCESS, V_CHAIN,
    V_CHECKS, V_ELEM, V_HAS_STORE, V_HAS_ULOAD, V_IV, V_IV2, V_N, V_NE, V_REDS, V_SIZE, V_VF, V_VT,
};
use crate::middle::vectorize::checks::{overlap_pairs, record_check};

pub fn class_of(v: i64) -> i64 {
    unsafe {
        if v != 0 && INSTS[v].mark == VSTAMP { INSTS[v].aux } else { 0 }
    }
}

pub fn set_class(v: i64, c: i64) {
    unsafe {
        INSTS[v].mark = VSTAMP;
        INSTS[v].aux = c;
    }
}

// The coefficient of the induction variable in v (a uniform value or an
// invariant one): v = coef * i + (something invariant). NONAFFINE when v
// is not such a value.
pub const NONAFFINE: i64 = 9223372036854775807;

pub fn coef(l: i64, v: i64) -> i64 {
    coef_wrt(l, v, V_IV, V_IV2)
}

// The coefficient of induction variable `iv` in v, where `other` (another
// induction variable, of an inner loop, or 0) counts as invariant.
pub fn coef_wrt(l: i64, v: i64, iv: i64, other: i64) -> i64 {
    unsafe {
        let x = ir_val(v);
        if x == iv {
            return 1;
        }
        if x == other && other != 0 {
            return 0;
        }
        if invariant_in(l, x) {
            return 0;
        }
        if class_of(x) != VC_UNIFORM {
            return NONAFFINE;
        }
        let op = INSTS[x].op;
        let a = if INSTS[x].a != 0 { coef_wrt(l, INSTS[x].a, iv, other) } else { 0 };
        let b = if INSTS[x].b != 0 { coef_wrt(l, INSTS[x].b, iv, other) } else { 0 };
        if a == NONAFFINE || b == NONAFFINE {
            return NONAFFINE;
        }
        if a == 0 && b == 0 {
            // Computed from invariants alone (it would be hoisted).
            return 0;
        }
        let wide = is_integer(INSTS[x].ty) && int_bits(INSTS[x].ty) == 64;
        if !wide {
            return NONAFFINE;
        }
        if op == Add {
            return a + b;
        }
        if op == Sub {
            return a - b;
        }
        if op == Mul && is_const(ir_val(INSTS[x].b)) && b == 0 {
            return a * INSTS[ir_val(INSTS[x].b)].imm;
        }
        if op == Mul && is_const(ir_val(INSTS[x].a)) && a == 0 {
            return b * INSTS[ir_val(INSTS[x].a)].imm;
        }
        if op == Shl && is_const(ir_val(INSTS[x].b)) && b == 0 {
            let k = INSTS[ir_val(INSTS[x].b)].imm;
            if k >= 0 && k < 16 {
                return a << k as u64;
            }
        }
        if op == Conv && is_integer(INSTS[x].imm2) && int_bits(INSTS[x].imm2) == 64 {
            return a;
        }
        NONAFFINE
    }
}

// The lane type of IR type t when it can be one (integers by their signed
// type), else 0.
pub fn lane_type(t: i64) -> i64 {
    if t == TY_F32 || t == TY_F64 || t == TY_I64 || t == TY_I32 || t == TY_I16 || t == TY_I8 {
        return t;
    }
    if t == TY_U64 { return TY_I64; }
    if t == TY_U32 { return TY_I32; }
    if t == TY_U16 { return TY_I16; }
    if t == TY_U8 { return TY_I8; }
    0
}

// Records T, the type of the loop's vectorized values; false when another
// one was seen.
pub fn use_elem(t: i64) -> bool {
    unsafe {
        let lt = lane_type(t);
        if lt == 0 {
            return false;
        }
        if V_ELEM == 0 {
            V_ELEM = t;
            return true;
        }
        V_ELEM == t
    }
}

// Whether v (an operand of a vector operation) has a value: a vector, or
// one value for all lanes (invariant, or uniform without the induction
// variable).
pub fn vector_operand_ok(l: i64, v: i64) -> bool {
    let x = ir_val(v);
    let c = class_of(x);
    if c == VC_VECTOR {
        return true;
    }
    coef(l, x) == 0
}

pub fn is_unreachable_exit(l: i64, b: i64) -> bool {
    unsafe { !loop_contains(l, b) && BLOCKS[b].term == Term::Unreach }
}

// Classifies the instructions of loop l; false when it cannot be
// vectorized.
pub fn analyze(l: i64, exit: *i64) -> bool {
    unsafe {
        VSTAMP += 1;
        V_ELEM = 0;
        V_HAS_STORE = false;
        V_HAS_ULOAD = false;
        V_IV2 = 0;
        V_CHAIN.count = 0;
        V_CHECKS.count = 0;
        V_ACCESS.count = 0;
        V_REDS.count = 0;
        let h = loop_header(l);
        let latch = loop_latch(l);
        if BLOCKS[h].novec != 0 || is_cold_block(h) || latch == 0 || loop_preheader(l) == 0 || BLOCKS[latch].term != Term::Branch {
            return false;
        }
        let mut iv = 0;
        let mut step = 0;
        let mut n = 0;
        let mut ne = false;
        if !counted_loop(l, &iv, &step, &n, &ne) || step != 1 || int_bits(INSTS[iv].ty) != 64 {
            return false;
        }
        V_IV = iv;
        V_N = n;
        V_NE = ne;
        // The chain of blocks.
        let mut b = h;
        let mut count = 0;
        loop {
            V_CHAIN.push(b);
            if b == latch {
                break;
            }
            if BLOCKS[b].term == Term::Jump && loop_contains(l, BLOCKS[b].s0) && BLOCKS[BLOCKS[b].s0].preds.count == 1 {
                b = BLOCKS[b].s0;
            } else if BLOCKS[b].term == Term::Branch {
                let s0 = BLOCKS[b].s0;
                let s1 = BLOCKS[b].s1;
                let mut next = 0;
                if loop_contains(l, s0) && is_unreachable_exit(l, s1) {
                    next = s0;
                } else if loop_contains(l, s1) && is_unreachable_exit(l, s0) {
                    next = s1;
                }
                if next == 0 || BLOCKS[next].preds.count != 1 || !record_check(l, b, next) {
                    return false;
                }
                b = next;
            } else {
                return false;
            }
            count += 1;
            if count > 32 {
                return false;
            }
        }
        if V_CHAIN.count != loop_size(l) {
            return false;
        }
        // The exit at the latch.
        let s0 = BLOCKS[latch].s0;
        let s1 = BLOCKS[latch].s1;
        let e = if s0 == h { s1 } else { s0 };
        if loop_contains(l, e) || BLOCKS[e].preds.count != 1 {
            return false;
        }
        *exit = e;
        let latch_cond = ir_val(BLOCKS[latch].cond);
        // The header's phis: the induction variable and reductions.
        let mut phi = BLOCKS[h].first;
        while phi != 0 && INSTS[phi].op == Phi {
            if phi != iv {
                let next = ir_val(ir_arg(phi, pred_index(h, latch)));
                if !is_integer(INSTS[phi].ty) || class_of(next) != 0 || INSTS[next].block == 0
                    || !loop_contains(l, INSTS[next].block) {
                    return false;
                }
                let op = INSTS[next].op;
                if op != Add && op != Sub && op != Mul && op != And && op != Or && op != Xor {
                    return false;
                }
                let a = ir_val(INSTS[next].a);
                let bb = ir_val(INSTS[next].b);
                if !(a == phi || (bb == phi && op != Sub)) || a == bb || INSTS[next].ty != INSTS[phi].ty {
                    return false;
                }
                if !use_elem(INSTS[phi].ty) {
                    return false;
                }
                set_class(phi, VC_VECTOR);
                V_REDS.push(phi);
                V_REDS.push(next);
                V_REDS.push(op as i64);
            } else {
                set_class(phi, VC_UNIFORM);
            }
            phi = INSTS[phi].next;
        }
        // Every instruction, in order.
        let mut total = 0;
        for k in 0..V_CHAIN.count {
            let mut v = BLOCKS[V_CHAIN.data[k]].first;
            while v != 0 {
                total += 1;
                if total > VEC_MAX_INSTS {
                    return false;
                }
                if !classify(l, v, latch_cond) {
                    return false;
                }
                v = INSTS[v].next;
            }
        }
        V_SIZE = total;
        if V_ELEM == 0 {
            return false;
        }
        V_VF = 16 / type_size(V_ELEM);
        V_VT = vector_type(lane_type(V_ELEM), V_VF);
        if V_VT == 0 {
            return false;
        }
        // The reductions' phis are used by their next values alone, and the
        // loop's values used after it are reductions' (LCSSA: the exit's
        // phis).
        for r in 0..V_REDS.count / 3 {
            let p = V_REDS.data[3 * r];
            if !only_used_by(l, p, V_REDS.data[3 * r + 1]) {
                return false;
            }
        }
        let mut x = BLOCKS[e].first;
        while x != 0 && INSTS[x].op == Phi {
            let w = ir_val(ir_arg(x, 0));
            // (A uniform value: its value at the last iteration, computed
            // after the vector loop.)
            if !invariant_in(l, w) && reduction_of_next(w) < 0
                && (class_of(w) != VC_UNIFORM || coef(l, w) == NONAFFINE || loads_in(l, w)) {
                return false;
            }
            x = INSTS[x].next;
        }
        // Checks: on an index with coefficient 1. What is computed before the
        // loop (indices and addresses at its first and last iterations)
        // loads nothing.
        for k in 0..V_CHECKS.count / 3 {
            if coef(l, V_CHECKS.data[3 * k + 1]) != 1 || loads_in(l, V_CHECKS.data[3 * k + 1]) {
                return false;
            }
        }
        for k in 0..V_ACCESS.count / 3 {
            if loads_in(l, V_ACCESS.data[3 * k + 1]) {
                return false;
            }
        }
        if overlap_pairs() > VEC_MAX_OVERLAPS {
            return false;
        }
        true
    }
}

// Whether uniform value v depends on a load in loop l.
pub fn loads_in(l: i64, v: i64) -> bool {
    unsafe {
        let x = ir_val(v);
        if x == 0 || x == V_IV || invariant_in(l, x) {
            return false;
        }
        if INSTS[x].op == Load {
            return true;
        }
        loads_in(l, INSTS[x].a) || loads_in(l, INSTS[x].b)
    }
}

// Whether every use of v inside loop l is instruction u (or the phi it
// came from).
fn only_used_by(l: i64, v: i64, u: i64) -> bool {
    unsafe {
        for k in 0..V_CHAIN.count {
            let mut x = BLOCKS[V_CHAIN.data[k]].first;
            while x != 0 {
                if x != u {
                    let n = if INSTS[x].op == Phi { 3 + INSTS[x].nargs } else { 3 };
                    for i in 0..n {
                        let w = if i == 0 { INSTS[x].a } else if i == 1 { INSTS[x].b } else if i == 2 { INSTS[x].c } else { ir_arg(x, i - 3) };
                        if w != 0 && ir_val(w) == v {
                            return false;
                        }
                    }
                }
                x = INSTS[x].next;
            }
            let b = V_CHAIN.data[k];
            if BLOCKS[b].cond != 0 && ir_val(BLOCKS[b].cond) == v {
                return false;
            }
        }
        true
    }
}

// The reduction (index) whose next value is w, or -1.
pub fn reduction_of_next(w: i64) -> i64 {
    unsafe {
        for r in 0..V_REDS.count / 3 {
            if V_REDS.data[3 * r + 1] == w {
                return r;
            }
        }
        -1
    }
}

fn is_check(c: i64) -> bool {
    unsafe {
        let mut k = 0;
        while k < V_CHECKS.count {
            if V_CHECKS.data[k] == c {
                return true;
            }
            k += 3;
        }
        false
    }
}

fn classify(l: i64, v: i64, latch_cond: i64) -> bool {
    unsafe {
        let op = INSTS[v].op;
        if op == Phi {
            return class_of(v) != 0;
        }
        if v == latch_cond || is_check(v) {
            set_class(v, VC_SKIP);
            return true;
        }
        if op == Load {
            let ty = INSTS[v].ty;
            let addr = ir_val(INSTS[v].a);
            let c = coef(l, addr);
            if c == 0 && (class_of(addr) == VC_UNIFORM || invariant_in(l, addr)) {
                // An invariant address: the same value in every iteration (a
                // store reaching it is ruled out by the overlap test).
                V_HAS_ULOAD = true;
                V_ACCESS.push(v);
                V_ACCESS.push(addr);
                V_ACCESS.push(type_size(ty));
                set_class(v, VC_UNIFORM);
                return true;
            }
            if c != type_size(ty) || !use_elem(ty) {
                return false;
            }
            V_ACCESS.push(v);
            V_ACCESS.push(addr);
            V_ACCESS.push(type_size(ty));
            set_class(v, VC_VECTOR);
            return true;
        }
        if op == Store {
            let ty = INSTS[v].imm2;
            let addr = ir_val(INSTS[v].a);
            if coef(l, addr) != type_size(ty) || !use_elem(ty) || !vector_operand_ok(l, INSTS[v].b) {
                return false;
            }
            V_HAS_STORE = true;
            V_ACCESS.push(v);
            V_ACCESS.push(addr);
            V_ACCESS.push(type_size(ty));
            set_class(v, VC_VECTOR);
            return true;
        }
        let a = if INSTS[v].a != 0 { class_of(ir_val(INSTS[v].a)) } else { 0 };
        let b = if INSTS[v].b != 0 { class_of(ir_val(INSTS[v].b)) } else { 0 };
        if a == VC_VECTOR || b == VC_VECTOR {
            let ty = INSTS[v].ty;
            let ok_op = op == Add || op == Sub || op == Mul || op == And || op == Or || op == Xor
                || op == Neg || (op == Div && is_float(ty));
            if !ok_op || (is_float(ty) && (op == And || op == Or || op == Xor)) || !use_elem(ty) {
                return false;
            }
            if !vector_operand_ok(l, INSTS[v].a) || (INSTS[v].b != 0 && !vector_operand_ok(l, INSTS[v].b)) {
                return false;
            }
            set_class(v, VC_VECTOR);
            return true;
        }
        if a == VC_SKIP || b == VC_SKIP {
            return false;
        }
        if op.is_pure() || op == Const {
            if op == Op::Cmp || INSTS[v].ty == TY_BOOL {
                // (A comparison that is no check: control flow, or a value.)
                return false;
            }
            set_class(v, VC_UNIFORM);
            return true;
        }
        false
    }
}
