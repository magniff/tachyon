// Vectorizing outer loops (0.10).
//
// A loop L (induction variable j) whose body holds one inner loop L2
// (induction variable k, its bounds invariant in L), and nothing else but
// straight-line code before and after it, gets a vector version over j:
// VF iterations of L at once, L2 run once for all of them with each lane's
// values (its phis, accumulators over k, become vectors: each lane adds up
// exactly what the scalar loop adds for its j, in the same order, so a
// float sum vectorizes too). Values the same for all lanes (j's, k's, and
// loads at addresses without j) stay scalar. matmul's `for j { sum = 0;
// for k { sum += a[i][k] * b[k][j] } c[i][j] = sum }` is the case. As for
// innermost loops, a run-time test before the loop requires enough
// iterations and no store overlapping another access at another address
// (ranges over all j and k); the original loop runs otherwise, and the
// remainder.

use crate::base::{IntVec, free};
use crate::front::types::{TY_I64, TY_U64, int_bits, is_float, is_integer, type_size, vector_type};
use crate::middle::ctx::FnCtx;
use crate::middle::fold::is_const;
use crate::middle::ir::{
    Cond, Term, ir_append, ir_arg, ir_enter, ir_insert_before, ir_make, ir_new_block, ir_set_arg,
    ir_val,
};
use crate::middle::ir::Op::{
    Add, And, Cmp, Const, Conv, Div, Load, Mul, Neg, Or, Phi, Shl, Store, Sub, VBin, VNeg, VSplat,
    Xor,
};
use crate::middle::ir::cfg::{ir_terminate, pred_index};
use crate::middle::loops::{
    add_pred_values, clone_region, invariant_in, loop_contains, loop_header, loop_latch,
    loop_preheader, loop_size, mark_loop_blocks, new_phi_in,
};
use crate::middle::profile::is_cold_block;
use crate::middle::range::bits_of_value;
use crate::middle::scev::{counted_loop, iv_step};
use crate::middle::vectorize::{VC_SKIP, VC_UNIFORM, VC_VECTOR, VEC_MAX_INSTS, VEC_MAX_OVERLAPS};
use crate::middle::vectorize::build::{append, cmp, konst};
use crate::middle::vectorize::checks::{build_groups, overlap_pairs, overlap_tests};
use crate::middle::vectorize::legality::{
    class_of, coef, lane_type, loads_in, set_class, use_elem, vector_operand_ok,
};

fn saved_class(mut cx: *FnCtx, v: i64) -> i64 {
    unsafe {
        let x = ir_val(cx, v);
        let mut k = 0;
        while k < cx.v_class.count {
            if cx.v_class.data[k] == x {
                return cx.v_class.data[k + 1];
            }
            k += 2;
        }
        0
    }
}

// The chain of blocks from b to `to` (both in L, not in L2), each jumping
// to the next, appended to V_CHAIN; false when there is another shape.
fn chain_to(mut cx: *FnCtx, l: i64, l2: i64, from: i64, to: i64) -> bool {
    unsafe {
        let mut b = from;
        for _ in 0..16 {
            cx.v_chain.push(b);
            if b == to {
                return true;
            }
            let s = cx.blocks[b].s0;
            if cx.blocks[b].term != Term::Jump || !loop_contains(cx, l, s)
                || loop_contains(cx, l2, s)
                || cx.blocks[s].preds.count != 1 {
                return false;
            }
            b = s;
        }
        false
    }
}

// The inner loop l2: a header phi (*iv) from a constant start, by a
// constant step s > 0 (unrolling makes it more than 1), while its next
// value is below a constant (or not equal to it, reached exactly); its
// last value in *last.
fn inner_counted(mut cx: *FnCtx, l2: i64, iv: &mut i64, last: &mut i64) -> bool {
    unsafe {
        let h = loop_header(cx, l2);
        let latch = loop_latch(cx, l2);
        let c = ir_val(cx, cx.blocks[latch].cond);
        if cx.insts[c].op != Cmp || !is_integer(cx.insts[c].imm2)
            || int_bits(cx.insts[c].imm2) != 64 {
            return false;
        }
        let mut cond = cx.insts[c].cond;
        let mut x = bits_of_value(cx, cx.insts[c].a);
        let mut n = bits_of_value(cx, cx.insts[c].b);
        if is_const(cx, x) && !is_const(cx, n) {
            let t = x;
            x = n;
            n = t;
            cond = cond.mirror();
        }
        if !is_const(cx, n) || cx.blocks[latch].term != Term::Branch {
            return false;
        }
        if cx.blocks[latch].s0 != h {
            cond = cond.negate();
        }
        let mut phi = cx.blocks[h].first;
        while phi != 0 && cx.insts[phi].op == Phi {
            let mut s = 0;
            if ir_val(cx, ir_arg(cx, phi, pred_index(cx, h, latch))) == x
                && iv_step(cx, l2, phi, &mut s) && s > 0
                && int_bits(cx.insts[phi].ty) == 64 {
                let k0v = ir_val(cx, ir_arg(cx, phi, pred_index(cx, h, loop_preheader(cx, l2))));
                if !is_const(cx, k0v) {
                    return false;
                }
                let k0 = cx.insts[k0v].imm;
                let nn = cx.insts[n].imm;
                if k0 >= nn || nn - k0 > 1073741824 {
                    return false;
                }
                if cond == Cond::Ne && (nn - k0) % s != 0 {
                    return false;
                }
                if cond != Cond::Ne && cond != Cond::Lt {
                    return false;
                }
                let trips = (nn - k0 + s - 1) / s;
                *iv = phi;
                *last = k0 + (trips - 1) * s;
                return true;
            }
            phi = cx.insts[phi].next;
        }
        false
    }
}

fn analyze_outer(mut cx: *FnCtx, l: i64, l2: i64, exit: &mut i64) -> bool {
    unsafe {
        cx.vstamp += 1;
        cx.v_elem = 0;
        cx.v_has_store = false;
        cx.v_has_uload = false;
        cx.v_chain.count = 0;
        cx.v_checks.count = 0;
        cx.v_access.count = 0;
        cx.v_reds.count = 0;
        cx.v_iv2 = 0;
        let h = loop_header(cx, l);
        let latch = loop_latch(cx, l);
        let h2 = loop_header(cx, l2);
        let latch2 = loop_latch(cx, l2);
        let p2 = loop_preheader(cx, l2);
        if cx.blocks[h].novec != 0 || is_cold_block(cx, h) || latch == 0
            || loop_preheader(cx, l) == 0 || latch2 == 0 || p2 == 0
            || cx.blocks[latch].term != Term::Branch
            || cx.blocks[latch2].term != Term::Branch {
            return false;
        }
        let mut iv = 0;
        let mut step = 0;
        let mut n = 0;
        let mut ne = false;
        if !counted_loop(cx, l, &mut iv, &mut step, &mut n, &mut ne) || step != 1
            || int_bits(cx.insts[iv].ty) != 64 {
            return false;
        }
        let mut iv2 = 0;
        let mut last2 = 0;
        if !inner_counted(cx, l2, &mut iv2, &mut last2) {
            return false;
        }
        cx.v_iv = iv;
        cx.v_n = n;
        cx.v_ne = ne;
        cx.v_iv2 = iv2;
        cx.v_last2 = last2;
        // L2's only exit is at its latch.
        let s0 = cx.blocks[latch2].s0;
        let s1 = cx.blocks[latch2].s1;
        let e2 = if s0 == h2 { s1 } else { s0 };
        if loop_contains(cx, l2, e2) || !loop_contains(cx, l, e2)
            || cx.blocks[e2].preds.count != 1 {
            return false;
        }
        // The blocks: h ... p2, L2 (a chain of jumps), e2 ... latch.
        if !chain_to(cx, l, l2, h, p2) || cx.blocks[p2].s0 != h2 {
            return false;
        }
        cx.v_pre = cx.v_chain.count;
        let mut b = h2;
        for _ in 0..16 {
            cx.v_chain.push(b);
            if b == latch2 {
                break;
            }
            let s = cx.blocks[b].s0;
            if cx.blocks[b].term != Term::Jump || !loop_contains(cx, l2, s)
                || cx.blocks[s].preds.count != 1 {
                return false;
            }
            b = s;
        }
        if cx.v_chain.data[cx.v_chain.count - 1] != latch2
            || cx.v_chain.count - cx.v_pre != loop_size(cx, l2) {
            return false;
        }
        if !chain_to(cx, l, l2, e2, latch) || cx.v_chain.count != loop_size(cx, l) {
            return false;
        }
        let ss0 = cx.blocks[latch].s0;
        let e = if ss0 == h { cx.blocks[latch].s1 } else { ss0 };
        if loop_contains(cx, l, e) || cx.blocks[e].preds.count != 1 {
            return false;
        }
        *exit = e;
        // Phis: j alone in h; k and accumulators in h2; e2's (one operand)
        // take their operand's class below.
        let mut phi = cx.blocks[h].first;
        while phi != 0 && cx.insts[phi].op == Phi {
            if phi != iv {
                return false;
            }
            set_class(cx, phi, VC_UNIFORM);
            phi = cx.insts[phi].next;
        }
        phi = cx.blocks[h2].first;
        while phi != 0 && cx.insts[phi].op == Phi {
            if phi == iv2 {
                set_class(cx, phi, VC_UNIFORM);
            } else {
                if !use_elem(cx, cx.insts[phi].ty) {
                    return false;
                }
                set_class(cx, phi, VC_VECTOR);
            }
            phi = cx.insts[phi].next;
        }
        let latch_cond = ir_val(cx, cx.blocks[latch].cond);
        let mut total = 0;
        for k in 0..cx.v_chain.count {
            let blk = cx.v_chain.data[k];
            let mut v = cx.blocks[blk].first;
            while v != 0 {
                total += 1;
                if total > VEC_MAX_INSTS {
                    return false;
                }
                if cx.insts[v].op == Phi {
                    if blk == e2 {
                        let w = ir_val(cx, ir_arg(cx, v, 0));
                        let c = if class_of(cx, w) != 0 { class_of(cx, w) } else { VC_UNIFORM };
                        if c == VC_SKIP {
                            return false;
                        }
                        set_class(cx, v, c);
                    } else if class_of(cx, v) == 0 {
                        return false;
                    }
                } else if !classify_outer(cx, l, v, latch_cond) {
                    return false;
                }
                v = cx.insts[v].next;
            }
        }
        cx.v_size = total;
        if cx.v_elem == 0 {
            return false;
        }
        cx.v_vf = 16 / type_size(cx.v_elem);
        cx.v_vt = vector_type(lane_type(cx.v_elem), cx.v_vf);
        if cx.v_vt == 0 {
            return false;
        }
        // The accumulators' operands have values for every lane.
        phi = cx.blocks[h2].first;
        while phi != 0 && cx.insts[phi].op == Phi {
            if phi != iv2 {
                for i in 0..cx.insts[phi].nargs {
                    if !vector_operand_ok(cx, l, ir_arg(cx, phi, i)) {
                        return false;
                    }
                }
            }
            phi = cx.insts[phi].next;
        }
        // What L leaves for after it: invariants only.
        let mut x = cx.blocks[e].first;
        while x != 0 && cx.insts[x].op == Phi {
            if !invariant_in(cx, l, ir_val(cx, ir_arg(cx, x, 0))) {
                return false;
            }
            x = cx.insts[x].next;
        }
        // Addresses: affine in j and k, from no load.
        for k in 0..cx.v_access.count / 3 {
            let a = cx.v_access.data[3 * k + 1];
            if !multi_affine(cx, l, a) || loads_in(cx, l, a) {
                return false;
            }
        }
        if overlap_pairs(cx) > VEC_MAX_OVERLAPS {
            return false;
        }
        true
    }
}

fn classify_outer(mut cx: *FnCtx, l: i64, v: i64, latch_cond: i64) -> bool {
    unsafe {
        let op = cx.insts[v].op;
        if v == latch_cond {
            set_class(cx, v, VC_SKIP);
            return true;
        }
        if op == Load || op == Store {
            let ty = if op == Load { cx.insts[v].ty } else { cx.insts[v].imm2 };
            let addr = ir_val(cx, cx.insts[v].a);
            let c = coef(cx, l, addr);
            cx.v_access.push(v);
            cx.v_access.push(addr);
            cx.v_access.push(type_size(ty));
            if op == Load && c == 0
                && (class_of(cx, addr) == VC_UNIFORM || invariant_in(cx, l, addr)) {
                // The same for all lanes (stores are kept apart by the
                // overlap test).
                set_class(cx, v, VC_UNIFORM);
                return true;
            }
            if c != type_size(ty) || !use_elem(cx, ty) {
                return false;
            }
            if op == Store {
                if !vector_operand_ok(cx, l, cx.insts[v].b) {
                    return false;
                }
                cx.v_has_store = true;
            }
            set_class(cx, v, VC_VECTOR);
            return true;
        }
        let a = if cx.insts[v].a != 0 { class_of(cx, ir_val(cx, cx.insts[v].a)) } else { 0 };
        let b = if cx.insts[v].b != 0 { class_of(cx, ir_val(cx, cx.insts[v].b)) } else { 0 };
        if a == VC_VECTOR || b == VC_VECTOR {
            let ty = cx.insts[v].ty;
            let ok_op = op == Add || op == Sub || op == Mul || op == And || op == Or || op == Xor
                || op == Neg || (op == Div && is_float(ty));
            if !ok_op || (is_float(ty) && (op == And || op == Or || op == Xor))
                || !use_elem(cx, ty) {
                return false;
            }
            if !vector_operand_ok(cx, l, cx.insts[v].a)
                || (cx.insts[v].b != 0 && !vector_operand_ok(cx, l, cx.insts[v].b)) {
                return false;
            }
            set_class(cx, v, VC_VECTOR);
            return true;
        }
        if a == VC_SKIP || b == VC_SKIP {
            return false;
        }
        if op.is_pure() || op == Const {
            // (A comparison: the inner loop's test; its operands are the same
            // for all lanes.)
            set_class(cx, v, VC_UNIFORM);
            return true;
        }
        false
    }
}

// Whether v is affine in j and in k separately, with invariant (maybe
// not constant) coefficients and no product of the two: its extremes over
// the iterations are then at the corners.
fn multi_affine(mut cx: *FnCtx, l: i64, v: i64) -> bool {
    lin_mask(cx, l, v) >= 0
}

// What v depends on: 1 for j, 2 for k (3 for both), -1 when not linear.
fn lin_mask(mut cx: *FnCtx, l: i64, v: i64) -> i64 {
    unsafe {
        let x = ir_val(cx, v);
        if x == cx.v_iv {
            return 1;
        }
        if x == cx.v_iv2 {
            return 2;
        }
        if x == 0 || invariant_in(cx, l, x) {
            return 0;
        }
        if class_of(cx, x) != VC_UNIFORM || cx.insts[x].op == Load || cx.insts[x].op == Phi {
            return -1;
        }
        let op = cx.insts[x].op;
        let a = lin_mask(cx, l, cx.insts[x].a);
        let b = lin_mask(cx, l, cx.insts[x].b);
        if a < 0 || b < 0 {
            return -1;
        }
        if a == 0 && b == 0 {
            return 0;
        }
        if !is_integer(cx.insts[x].ty) || int_bits(cx.insts[x].ty) != 64 {
            return -1;
        }
        if op == Add || op == Sub {
            return a | b;
        }
        if op == Mul && (a == 0 || b == 0) {
            return a | b;
        }
        if op == Shl && b == 0 && is_const(cx, ir_val(cx, cx.insts[x].b)) {
            return a;
        }
        if op == Conv && is_integer(cx.insts[x].imm2) && int_bits(cx.insts[x].imm2) == 64 {
            return a;
        }
        -1
    }
}

// The value of v (uniform, without loads) with j = `at` and k = `at2`, in
// block b.
pub fn eval_at2(mut cx: *FnCtx, l: i64, v: i64, at: i64, at2: i64, b: i64) -> i64 {
    unsafe {
        let x = ir_val(cx, v);
        if x == cx.v_iv {
            return at;
        }
        if x == cx.v_iv2 {
            return at2;
        }
        if invariant_in(cx, l, x) {
            return x;
        }
        let a = if cx.insts[x].a != 0 { eval_at2(cx, l, cx.insts[x].a, at, at2, b) } else { 0 };
        let y = if cx.insts[x].b != 0 { eval_at2(cx, l, cx.insts[x].b, at, at2, b) } else { 0 };
        let nv = ir_make(cx, cx.insts[x].op, cx.insts[x].ty, a, y, cx.insts[x].imm);
        cx.insts[nv].imm2 = cx.insts[x].imm2;
        cx.insts[nv].cond = cx.insts[x].cond;
        ir_append(cx, b, nv);
        nv
    }
}

// The vector value of operand w of copy nv (whose original's operand had
// class `cls`): w itself, or a splat (in vp for invariants, else just
// before nv).
fn outer_vector(mut cx: *FnCtx, l: i64, w: i64, cls: i64, nv: i64, vp: i64) -> i64 {
    unsafe {
        if cls == VC_VECTOR {
            return w;
        }
        let s = ir_make(cx, VSplat, cx.v_vt, w, 0, 0);
        // (Copies are in no loop of the forest: in_clone tells them apart.)
        if !in_clone(cx, w) && invariant_in(cx, l, w) {
            ir_append(cx, vp, s);
        } else {
            ir_insert_before(cx, nv, s);
        }
        s
    }
}

// Whether value w is in the copy of L.
fn in_clone(mut cx: *FnCtx, w: i64) -> bool {
    unsafe {
        let b = cx.insts[w].block;
        b != 0 && cx.blocks[b].mark == cx.v_clone_stamp
    }
}

pub fn vectorize_outer(mut cx: *FnCtx, fi: i64, l: i64, l2: i64) -> bool {
    unsafe {
        let mut e = 0;
        if !analyze_outer(cx, l, l2, &mut e) {
            cx.v_iv2 = 0;
            return false;
        }
        ir_enter(cx, fi);
        let h = loop_header(cx, l);
        let p = loop_preheader(cx, l);
        let latch = loop_latch(cx, l);
        let h2 = loop_header(cx, l2);
        let p2 = loop_preheader(cx, l2);
        let start = ir_val(cx, ir_arg(cx, cx.v_iv, pred_index(cx, h, p)));
        let start2 = ir_val(cx, ir_arg(cx, cx.v_iv2, pred_index(cx, h2, p2)));
        let vf = cx.v_vf;
        let vt = cx.v_vt;
        let n = cx.v_n;
        // Classes, saved before cloning.
        cx.v_class.count = 0;
        for k in 0..cx.v_chain.count {
            let mut v = cx.blocks[cx.v_chain.data[k]].first;
            while v != 0 {
                cx.v_class.push(v);
                cx.v_class.push(class_of(cx, v));
                v = cx.insts[v].next;
            }
        }
        let c = ir_new_block(cx);
        let vp = ir_new_block(cx);
        let vx = ir_new_block(cx);
        let sp = ir_new_block(cx);
        cx.blocks[c].sealed = 1;
        cx.blocks[vp].sealed = 1;
        cx.blocks[vx].sealed = 1;
        cx.blocks[sp].sealed = 1;
        cx.blocks[p].s0 = c;
        cx.blocks[c].preds.push(p);
        let trips = append(cx, c, Sub, TY_I64, n, start, 0);
        let mut ok = cmp(cx, c, Cond::Ge, TY_U64, trips, konst(cx, c, vf, TY_I64));
        let last = append(cx, c, Sub, TY_I64, n, konst(cx, c, 1, TY_I64), 0);
        let last2 = konst(cx, c, cx.v_last2, TY_I64);
        build_groups(cx);
        ok = overlap_tests(cx, l, c, ok, start, last, start2, last2);
        ir_terminate(cx, c, Term::Branch, ok, vp, sp);
        let vtrips = append(cx, vp, And, TY_I64, trips, konst(cx, vp, 0 - vf, TY_I64), 0);
        let vend = append(cx, vp, Add, TY_I64, start, vtrips, 0);
        // The copy of L.
        let stamp = mark_loop_blocks(cx, l);
        clone_region(cx, fi, &cx.lp_list2, stamp);
        cx.vstamp += 1;
        cx.v_clone_stamp = cx.vstamp;
        for i in 0..cx.lp_list2.count {
            cx.blocks[cx.blocks[cx.lp_list2.data[i]].aux].mark = cx.v_clone_stamp;
        }
        let h_c = cx.blocks[h].aux;
        let latch_c = cx.blocks[latch].aux;
        // Turn the copy's vector values into vectors.
        for k in 0..cx.v_chain.count {
            let mut v = cx.blocks[cx.v_chain.data[k]].first;
            while v != 0 {
                let nv = cx.insts[v].aux;
                let op = cx.insts[v].op;
                if saved_class(cx, v) == VC_VECTOR {
                    if op == Phi {
                        cx.insts[nv].ty = vt;
                        let pb = cx.insts[nv].block;
                        for i in 0..cx.insts[nv].nargs {
                            let cls = saved_class(cx, ir_arg(cx, v, i));
                            if cls != VC_VECTOR {
                                // A splat at the end of the predecessor.
                                let w = ir_arg(cx, nv, i);
                                let s = ir_make(cx, VSplat, vt, w, 0, 0);
                                ir_append(cx, cx.blocks[pb].preds.data[i], s);
                                ir_set_arg(cx, nv, i, s);
                            }
                        }
                    } else if op == Load {
                        cx.insts[nv].ty = vt;
                    } else if op == Store {
                        cx.insts[nv].imm2 = vt;
                        cx.insts[nv].b = outer_vector(cx, l, cx.insts[nv].b,
                            saved_class(cx, cx.insts[v].b), nv, vp);
                    } else if op == Neg {
                        cx.insts[nv].op = VNeg;
                        cx.insts[nv].ty = vt;
                        cx.insts[nv].a = outer_vector(cx, l, cx.insts[nv].a,
                            saved_class(cx, cx.insts[v].a), nv, vp);
                    } else {
                        cx.insts[nv].imm = op as i64;
                        cx.insts[nv].op = VBin;
                        cx.insts[nv].ty = vt;
                        cx.insts[nv].a = outer_vector(cx, l, cx.insts[nv].a,
                            saved_class(cx, cx.insts[v].a), nv, vp);
                        cx.insts[nv].b = outer_vector(cx, l, cx.insts[nv].b,
                            saved_class(cx, cx.insts[v].b), nv, vp);
                    }
                }
                v = cx.insts[v].next;
            }
        }
        // The copy's entry: from vp; its j steps by VF, to vend, out to vx.
        let hp = pred_index(cx, h_c, p);
        cx.blocks[h_c].preds.data[hp] = vp;
        cx.blocks[vp].term = Term::Jump;
        cx.blocks[vp].s0 = h_c;
        let jv = cx.insts[cx.v_iv].aux;
        let jl = pred_index(cx, h_c, latch_c);
        let vnext = append(cx, latch_c, Add, cx.insts[cx.v_iv].ty, jv,
            konst(cx, latch_c, vf, cx.insts[cx.v_iv].ty), 0);
        ir_set_arg(cx, jv, jl, vnext);
        let more = cmp(cx, latch_c, Cond::Ne, TY_I64, vnext, vend);
        cx.blocks[latch_c].term = Term::Branch;
        cx.blocks[latch_c].cond = more;
        cx.blocks[latch_c].s0 = h_c;
        cx.blocks[latch_c].s1 = vx;
        cx.blocks[vx].preds.push(latch_c);
        let done = cmp(cx, vx, Cond::Eq, TY_I64, vend, n);
        ir_terminate(cx, vx, Term::Branch, done, e, sp);
        // SP: the scalar loop's preheader, from C or VX.
        let mut vals = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        vals.push(start);
        vals.push(vend);
        let iv0 = new_phi_in(cx, sp, cx.insts[cx.v_iv].ty, &vals, 0, 2);
        let ohp = pred_index(cx, h, p);
        ir_set_arg(cx, cx.v_iv, ohp, iv0);
        ir_terminate(cx, sp, Term::Jump, 0, h, 0);
        cx.blocks[h].preds.count -= 1;
        cx.blocks[h].preds.data[ohp] = sp;
        // E: from VX too (its phis' operands are invariants).
        vals.count = 0;
        let mut x = cx.blocks[e].first;
        while x != 0 && cx.insts[x].op == Phi {
            vals.push(ir_val(cx, ir_arg(cx, x, 0)));
            x = cx.insts[x].next;
        }
        cx.blocks[e].preds.count -= 1;
        add_pred_values(cx, e, vx, &vals, 0);
        cx.blocks[h].novec = 1;
        cx.blocks[h2].novec = 1;
        cx.blocks[cx.blocks[h2].aux].novec = 1;
        free(vals.data as *u8);
        cx.v_iv2 = 0;
        true
    }
}
