// Counted loops out of loops with several exits, and equal induction
// variables merged (0.14), before rotation (opt.tach's optimize_loops).
//
// A loop whose header, and the blocks that follow it alone, test several
// exits to one block, each a comparison of an induction variable with an
// invariant, runs as many times as the smallest of their trip counts:
// `loop { match it.next() { .. } }` over `take(n)` of a slice iterator
// becomes, once threaded (tags.tach), a header testing n != 0, then
// pos < len. The trip counts are computed in the preheader (as unsigned
// numbers), their minimum T, and the loop gets a new induction variable c
// from 0: the first test becomes c != T, the others are always true. The
// loop then has one exit, which rotation and SCEV count and the
// vectorizer takes. The blocks between the first test and the last have
// no effects (the last iteration skips them), and the exit block's phis
// take one value from all the tests.
//
// Two header phis with the same start and the same constant step are one
// induction variable (an index counted twice, as enumerate and zip over
// `next` do, or the counter above beside the slice position).

use crate::middle::ir::{
    Cond, IRFUNCS, Op, Term, ir_append, ir_arg, ir_enter, ir_make, ir_prepend, ir_replace, ir_val,
};

use crate::base::IntVec;

use crate::middle::range::bits_of_value;

use crate::middle::fold::is_const;

use crate::middle::loops::{
    canonicalize_loops, invariant_in, loop_contains, loop_count, loop_header, loop_latch,
    loop_preheader,
};

use crate::front::types::{TY_BOOL, TY_I64, TY_U64, int_bits, is_integer, is_signed};
use crate::middle::ctx::FnCtx;
use crate::middle::ipo::has_effect;
use crate::middle::ir::cfg::pred_index;
use crate::middle::opt::resolve_all;
use crate::middle::scev::{append_const, append_inst, iv_start, iv_step};

const COUNT_STRIDE: i64 = 5;
// At most this many tests in a chain.
const MAX_TESTS: i64 = 8;

// The induction variable value x is (a header phi of loop l, plus a
// constant): the phi in *phi, the constant in *offset; false when x is not
// one with a step of 1 or -1 (in *step) and 64 bits.
fn affine_iv(mut cx: *FnCtx, l: i64, x: i64, phi: *i64, offset: *i64, step: *i64) -> bool {
    unsafe {
        let mut v = bits_of_value(cx, x);
        let mut c = 0;
        for _ in 0..4 {
            if cx.insts[v].op == Op::Phi {
                break;
            }
            let op = cx.insts[v].op;
            if op != Op::Add && op != Op::Sub {
                return false;
            }
            let a = bits_of_value(cx, cx.insts[v].a);
            let b = bits_of_value(cx, cx.insts[v].b);
            if is_const(cx, b) {
                c = if op == Op::Add { c + cx.insts[b].imm } else { c - cx.insts[b].imm };
                v = a;
            } else if op == Op::Add && is_const(cx, a) {
                c += cx.insts[a].imm;
                v = b;
            } else {
                return false;
            }
        }
        let mut s = 0;
        if cx.insts[v].op != Op::Phi || cx.insts[v].block != loop_header(cx, l)
            || !is_integer(cx.insts[v].ty)
            || int_bits(cx.insts[v].ty) != 64 || !iv_step(cx, l, v, &s) || (s != 1 && s != -1) {
            return false;
        }
        *phi = v;
        *offset = c;
        *step = s;
        true
    }
}

// Records the test of block b's branch (`stay` is true when the loop goes
// on along s0): x <cond> bound, x an induction variable. False when it is
// not a test that has a trip count.
fn record_test(mut cx: *FnCtx, l: i64, b: i64, stay_s0: bool) -> bool {
    unsafe {
        let c = ir_val(cx, cx.blocks[b].cond);
        if cx.insts[c].op != Op::Cmp || !is_integer(cx.insts[c].imm2)
            || int_bits(cx.insts[c].imm2) != 64 {
            return false;
        }
        let mut cond = cx.insts[c].cond;
        let mut x = ir_val(cx, cx.insts[c].a);
        let mut n = bits_of_value(cx, cx.insts[c].b);
        if !invariant_in(cx, l, n) {
            n = bits_of_value(cx, cx.insts[c].a);
            x = ir_val(cx, cx.insts[c].b);
            cond = cond.mirror();
        }
        if !invariant_in(cx, l, n) {
            return false;
        }
        if !stay_s0 {
            cond = cond.negate();
        }
        let mut phi = 0;
        let mut offset = 0;
        let mut step = 0;
        if !affine_iv(cx, l, x, &phi, &offset, &step) {
            return false;
        }
        // (the condition to stay: x != n either way; x < n going up; x > n
        // going down; signedness from the comparison)
        let ok = cond == Cond::Ne || (cond == Cond::Lt && step == 1)
            || (cond == Cond::Gt && step == -1);
        if !ok {
            return false;
        }
        cx.tests.push(b);
        cx.tests.push(phi);
        cx.tests.push(offset);
        cx.tests.push(n);
        // cond, and the comparison's signedness
        cx.tests.push(cond as i64 * 2 + if is_signed(cx.insts[c].imm2) { 1 } else { 0 });
        true
    }
}

// The number of iterations test k lets the loop run (an unsigned 64-bit
// value), computed at the end of block pre.
fn trip_count(mut cx: *FnCtx, l: i64, k: i64, pre: i64) -> i64 {
    unsafe {
        let phi = cx.tests.data[COUNT_STRIDE * k + 1];
        let offset = cx.tests.data[COUNT_STRIDE * k + 2];
        let n = cx.tests.data[COUNT_STRIDE * k + 3];
        let code = cx.tests.data[COUNT_STRIDE * k + 4];
        let signed = (code & 1) != 0;
        let cond = code / 2;
        let mut start = iv_start(cx, l, phi);
        if offset != 0 {
            start = append_inst(cx, pre, Op::Add, TY_I64, start,
                append_const(cx, pre, offset, TY_I64));
        }
        if cond == Cond::Ne as i64 {
            let mut step = 0;
            iv_step(cx, l, phi, &step);
            return if step == 1 { append_inst(cx, pre, Op::Sub, TY_I64, n, start) }
                else { append_inst(cx, pre, Op::Sub, TY_I64, start, n) };
        }
        // x < n going up: n - start when start < n, else 0 (x > n down: the
        // mirror).
        let lt = cond == Cond::Lt as i64;
        let a = if lt { start } else { n };
        let b = if lt { n } else { start };
        let diff = append_inst(cx, pre, Op::Sub, TY_I64, b, a);
        let enter = append_cmp(cx, pre, Cond::Lt, if signed { TY_I64 } else { TY_U64 }, a, b);
        and_mask(cx, pre, diff, enter)
    }
}

// v when bool `keep` holds, else 0 (no branch: v & -keep).
fn and_mask(mut cx: *FnCtx, b: i64, v: i64, keep: i64) -> i64 {
    unsafe {
        let wide = ir_make(cx, Op::Conv, TY_I64, keep, 0, 0);
        cx.insts[wide].imm2 = TY_BOOL;
        ir_append(cx, b, wide);
        let mask = append_inst(cx, b, Op::Neg, TY_I64, wide, 0);
        append_inst(cx, b, Op::And, TY_I64, v, mask)
    }
}

// The smaller of unsigned x and y: y ^ ((x ^ y) & -(x < y)).
fn umin(mut cx: *FnCtx, b: i64, x: i64, y: i64) -> i64 {
    let less = append_cmp(cx, b, Cond::Lt, TY_U64, x, y);
    let diff = append_inst(cx, b, Op::Xor, TY_I64, x, y);
    append_inst(cx, b, Op::Xor, TY_I64, y, and_mask(cx, b, diff, less))
}

fn append_cmp(mut cx: *FnCtx, b: i64, cond: Cond, ty: i64, x: i64, y: i64) -> i64 {
    unsafe {
        let v = ir_make(cx, Op::Cmp, TY_BOOL, x, y, 0);
        cx.insts[v].cond = cond;
        cx.insts[v].imm2 = ty;
        ir_append(cx, b, v);
        v
    }
}

// The block an exit edge leads to: past an exit block of the loop's own
// (canonical form gives each exiting edge one) holding only phis of one
// operand and a jump.
fn forward(mut cx: *FnCtx, out: i64) -> i64 {
    unsafe {
        if cx.blocks[out].term != Term::Jump || cx.blocks[out].preds.count != 1 {
            return out;
        }
        let mut v = cx.blocks[out].first;
        while v != 0 {
            if cx.insts[v].op != Op::Phi || cx.insts[v].nargs != 1 {
                return out;
            }
            v = cx.insts[v].next;
        }
        cx.blocks[out].s0
    }
}

// The value phi x (of the exit) takes when the loop leaves from test block
// t through its exit block `out`.
fn value_from(mut cx: *FnCtx, x: i64, t: i64, out: i64) -> i64 {
    unsafe {
        let exit = cx.insts[x].block;
        if out == exit {
            return ir_val(cx, ir_arg(cx, x, pred_index(cx, exit, t)));
        }
        let w = ir_val(cx, ir_arg(cx, x, pred_index(cx, exit, out)));
        if cx.insts[w].op == Op::Phi && cx.insts[w].block == out { ir_val(cx, ir_arg(cx, w, 0)) }
        else { w }
    }
}

// Loop l with several counted exits at its top made a counted loop (see
// the header). Returns whether it was.
fn merge_exits(mut cx: *FnCtx, l: i64) -> bool {
    unsafe {
        let h = loop_header(cx, l);
        let pre = loop_preheader(cx, l);
        let latch = loop_latch(cx, l);
        if pre == 0 || latch == 0 {
            return false;
        }
        cx.tests.count = 0;
        cx.outs.count = 0;
        let mut exit = 0;
        let mut b = h;
        for _ in 0..MAX_TESTS {
            if cx.blocks[b].term != Term::Branch {
                break;
            }
            let s0 = cx.blocks[b].s0;
            let s1 = cx.blocks[b].s1;
            let in0 = loop_contains(cx, l, s0);
            if in0 == loop_contains(cx, l, s1) {
                break;
            }
            let out = if in0 { s1 } else { s0 };
            let next = if in0 { s0 } else { s1 };
            if exit != 0 && forward(cx, out) != exit {
                break;
            }
            if b != h && !no_effects(cx, b) {
                break;
            }
            if !record_test(cx, l, b, in0) {
                break;
            }
            exit = forward(cx, out);
            cx.outs.push(out);
            if next == h || cx.blocks[next].preds.count != 1 {
                break;
            }
            b = next;
        }
        let count = cx.tests.count / COUNT_STRIDE;
        if count < 2 {
            return false;
        }
        // The exit's phis take one value from every test.
        let mut x = cx.blocks[exit].first;
        while x != 0 && cx.insts[x].op == Op::Phi {
            let first = value_from(cx, x, h, cx.outs.data[0]);
            for k in 1..count {
                if value_from(cx, x, cx.tests.data[COUNT_STRIDE * k], cx.outs.data[k]) != first {
                    return false;
                }
            }
            x = cx.insts[x].next;
        }
        // T, the smallest trip count.
        let mut trips = trip_count(cx, l, 0, pre);
        for k in 1..count {
            trips = umin(cx, pre, trips, trip_count(cx, l, k, pre));
        }
        // c: 0, 1, ... with c != T the first test, the others true.
        let zero = append_const(cx, pre, 0, TY_I64);
        let c = ir_make(cx, Op::Phi, TY_I64, 0, 0, 0);
        cx.insts[c].args = cx.args.count;
        cx.insts[c].nargs = cx.blocks[h].preds.count;
        let one = append_const(cx, latch, 1, TY_I64);
        let next = append_inst(cx, latch, Op::Add, TY_I64, c, one);
        for k in 0..cx.blocks[h].preds.count {
            cx.args.push(if cx.blocks[h].preds.data[k] == pre { zero } else { next });
            cx.argty.push(0);
        }
        ir_prepend(cx, h, c);
        let stay_s0 = loop_contains(cx, l, cx.blocks[h].s0);
        cx.blocks[h].cond = append_cmp(cx, h, if stay_s0 { Cond::Ne } else { Cond::Eq }, TY_I64, c,
            trips);
        for k in 1..count {
            let t = cx.tests.data[COUNT_STRIDE * k];
            let stay = loop_contains(cx, l, cx.blocks[t].s0);
            cx.blocks[t].cond = append_const(cx, t, if stay { 1 } else { 0 }, TY_BOOL);
        }
        true
    }
}

// Whether block b's instructions have no effects (they may be skipped).
fn no_effects(mut cx: *FnCtx, b: i64) -> bool {
    unsafe {
        let mut v = cx.blocks[b].first;
        while v != 0 {
            if has_effect(cx, v) {
                return false;
            }
            v = cx.insts[v].next;
        }
        true
    }
}

// Merges the header phis of loop l that are one induction variable: the
// same start, the same constant step. Returns whether any was.
fn merge_equal_ivs(mut cx: *FnCtx, l: i64) -> bool {
    unsafe {
        let h = loop_header(cx, l);
        if loop_preheader(cx, l) == 0 || loop_latch(cx, l) == 0 {
            return false;
        }
        let mut changed = false;
        let mut p = cx.blocks[h].first;
        while p != 0 && cx.insts[p].op == Op::Phi {
            let mut s1 = 0;
            if ir_val(cx, p) == p && is_integer(cx.insts[p].ty) && iv_step(cx, l, p, &s1) {
                let start = iv_start(cx, l, p);
                let mut q = cx.insts[p].next;
                while q != 0 && cx.insts[q].op == Op::Phi {
                    let mut s2 = 0;
                    if ir_val(cx, q) == q && cx.insts[q].ty == cx.insts[p].ty
                        && iv_step(cx, l, q, &s2) && s1 == s2
                        && same_value(cx, iv_start(cx, l, q), start) {
                        ir_replace(cx, q, p);
                        changed = true;
                    }
                    q = cx.insts[q].next;
                }
            }
            p = cx.insts[p].next;
        }
        changed
    }
}

// Whether a and b are one value (or equal constants).
fn same_value(mut cx: *FnCtx, a: i64, b: i64) -> bool {
    unsafe {
        a == b || (is_const(cx, a) && is_const(cx, b) && cx.insts[a].imm == cx.insts[b].imm
            && cx.insts[a].ty == cx.insts[b].ty)
    }
}

// Both, on every loop of function fi (canonical form first). Returns
// whether anything changed.
pub fn count_loop_exits(mut cx: *FnCtx, fi: i64) -> bool {
    unsafe {
        ir_enter(cx, fi);
        canonicalize_loops(cx, fi);
        let mut changed = false;
        for l in 0..loop_count(cx) {
            if loop_header(cx, l) == IRFUNCS[fi].entry {
                continue;
            }
            if merge_equal_ivs(cx, l) {
                changed = true;
                resolve_all(cx, fi);
            }
            if merge_exits(cx, l) {
                changed = true;
                resolve_all(cx, fi);
                if merge_equal_ivs(cx, l) {
                    resolve_all(cx, fi);
                }
            }
        }
        changed
    }
}
