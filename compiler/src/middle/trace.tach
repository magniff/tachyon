// Failure traces (0.17, `--trace`): the calls that led to a failed check.
//
// Built at -O1 and -O2, on the IR just after lowering (as profile.tach's
// counters): each function of the program (not std's, not the runtimes')
// keeps a frame on a shadow stack, the runtime's FRAMES (4096 entries, a
// ring: deeper calls write over the outermost) at index DEPTH:
//
//     entry:       d = DEPTH; DEPTH = d + 1; FRAMES[d & 4095] = "FILE:LINE  NAME"
//     each call:   FRAMES[d & 4095] = "FILE:LINE  NAME" of the call's statement
//     each return: DEPTH = d
//
// so a frame names the statement its function is running (the last call
// made, or the entry): a failed check is a call (rt.panic), and std's
// failures (unwrap, panic) are calls of std functions. The cost: a store
// per call (consecutive calls of one statement in a block: one), a few
// instructions per entry and return. Without --trace nothing changes.
//
// On a failure, the runtime's `dump` prints the frames, innermost first,
// after the message: rt.panic calls it (gen0's runtime), std::panic's call
// of `panic_note` (the note "build with --trace") becomes a call of it.
// `start`, called first in main, also makes SIGINT, SIGALRM (a time limit:
// `tachyonc test`'s), SIGTERM and SIGSEGV print the frames before the
// program stops.

use crate::back::dwarf::file_and_line;
use crate::base::{
    BUFS, FILES, IntVec, buf_byte, buf_bytes, buf_new, buf_str, intern_c, out_path, sym_name,
};
use crate::front::ast::NODES;
use crate::front::lexer::add_string;
use crate::front::types::{FNS, SYM_FN, SYM_STATIC, TY_I64, TY_U64};
use crate::gen0::gen::MAIN_SYM;
use crate::middle::ctx::FnCtx;
use crate::middle::inline::FN_LIVE;
use crate::middle::ir::{
    FN_IR, IRFUNCS, IRFUNC_COUNT, Op, Term, ir_append, ir_enter, ir_insert_before, ir_make,
};

pub static mut TRACE: bool = false;
pub static mut TRACE_MODULE: i64 = -1;

// The runtime, the module __trace.
pub fn trace_runtime_source(out: i64) {
    unsafe {
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    fn write(fd: i32, data: *u8, count: u64) -> i64;\n");
        buf_str(out, c"    fn strlen(s: *u8) -> u64;\n");
        buf_str(out, c"    fn signal(sig: i32, handler: extern \"C\" fn(i32)) -> u64;\n");
        buf_str(out, c"    #[link_name = \"signal\"]\n");
        buf_str(out, c"    fn signal_default(sig: i32, handler: u64) -> u64;\n");
        buf_str(out, c"    fn raise(sig: i32) -> i32;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"pub static mut DEPTH: i64 = 0;\n");
        buf_str(out, c"pub static mut FRAMES: [*u8; 4096] = [0 as *u8; 4096];\n");
        buf_str(out, c"fn put(s: *u8) {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        write(2, s, strlen(s));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"fn put_int(n: i64) {\n");
        buf_str(out, c"    let mut digits: [u8; 24] = [0; 24];\n");
        buf_str(out, c"    let mut i = 22;\n");
        buf_str(out, c"    let mut v = if n < 0 { 0 - n } else { n };\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        digits[i] = '0' + (v % 10) as u8;\n");
        buf_str(out, c"        v = v / 10;\n");
        buf_str(out, c"        if v == 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        put(&digits[i]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"fn frame(i: i64) {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        put(c\"  \");\n");
        buf_str(out, c"        put(FRAMES[i & 4095]);\n");
        buf_str(out, c"        put(c\"\\n\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// (extern \"C\": always emitted, for rt.panic to call)\n");
        buf_str(out, c"pub extern \"C\" fn __tachyon_trace_dump() {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let d = DEPTH;\n");
        buf_str(out, c"        if d <= 0 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        put(c\"trace, innermost call first:\\n\");\n");
        buf_str(out, c"        let low = if d > 4096 { d - 4096 } else { 0 };\n");
        buf_str(out, c"        let mut i = d - 1;\n");
        buf_str(out, c"        while i >= low {\n");
        buf_str(out, c"            if d - 1 - i == 20 && i - low > 8 {\n");
        buf_str(out, c"                put(c\"  ... \");\n");
        buf_str(out, c"                put_int(i - low - 3);\n");
        buf_str(out, c"                put(c\" more\\n\");\n");
        buf_str(out, c"                i = low + 3;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            frame(i);\n");
        buf_str(out, c"            i -= 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if low > 0 {\n");
        buf_str(out, c"            put(c\"  ... \");\n");
        buf_str(out, c"            put_int(low);\n");
        buf_str(out, c"            put(c\" outer calls not kept\\n\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"extern \"C\" fn stopped(sig: i32) {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        put(c\"stopped by signal \");\n");
        buf_str(out, c"        put_int(sig as i64);\n");
        buf_str(out, c"        if sig == 14 {\n");
        buf_str(out, c"            put(c\" (SIGALRM: a time limit)\");\n");
        buf_str(out, c"        } else if sig == 2 {\n");
        buf_str(out, c"            put(c\" (SIGINT)\");\n");
        buf_str(out, c"        } else if sig == 15 {\n");
        buf_str(out, c"            put(c\" (SIGTERM)\");\n");
        buf_str(out, c"        } else if sig == 11 {\n");
        buf_str(out, c"            put(c\" (SIGSEGV: an invalid memory access)\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        put(c\"\\n\");\n");
        buf_str(out, c"        __tachyon_trace_dump();\n");
        buf_str(out, c"        signal_default(sig, 0);\n");
        buf_str(out, c"        raise(sig);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"pub fn start() {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        signal(2, stopped);\n");
        buf_str(out, c"        signal(14, stopped);\n");
        buf_str(out, c"        signal(15, stopped);\n");
        buf_str(out, c"        signal(11, stopped);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
    }
}

// Whether IR function fi keeps a frame: a function of the program's own
// files (not of a synthesized source: std, the runtimes, C imports).
fn traced(fi: i64) -> bool {
    unsafe {
        let start = NODES[IRFUNCS[fi].item].start;
        let file = file_and_line(start) >> 32;
        FILES[file].path[0] != '<'
    }
}

// The site string "FILE:LINE  NAME" of position pos (0: the function's
// own position) in function fi.
fn site(fi: i64, pos: i64) -> i64 {
    unsafe {
        let at = if pos > 0 { pos } else { NODES[IRFUNCS[fi].item].start };
        let fl = file_and_line(at);
        let b = buf_new();
        buf_str(b, out_path(fl >> 32));
        buf_byte(b, ':');
        crate::base::buf_int(b, fl & 4294967295);
        buf_bytes(b, "  ");
        let name = sym_name(FNS[IRFUNCS[fi].f].name);
        let mut i = 0;
        while name[i] != 0 {
            if name[i] == '.' {
                buf_bytes(b, "::");
            } else {
                buf_byte(b, name[i]);
            }
            i += 1;
        }
        add_string(BUFS[b].data[0..BUFS[b].len])
    }
}

// The site string of position pos in function fi, one per line: `lines`
// holds the lines made (file_and_line), `sids` their strings.
fn site_of(fi: i64, pos: i64, lines: *IntVec, sids: *IntVec) -> i64 {
    unsafe {
        let line = file_and_line(pos);
        for j in 0..lines.count {
            if lines.data[j] == line {
                return sids.data[j];
            }
        }
        let sid = site(fi, pos);
        lines.push(line);
        sids.push(sid);
        sid
    }
}

// The first instruction of block b after its phis and parameters (0: none).
fn body_start(mut cx: *FnCtx, b: i64) -> i64 {
    unsafe {
        let mut v = cx.blocks[b].first;
        while v != 0 && (cx.insts[v].op == Op::Phi || cx.insts[v].op == Op::Param) {
            v = cx.insts[v].next;
        }
        v
    }
}

// Puts the instructions of `list` before instruction `at` (0: at the end
// of block b).
fn put_before(mut cx: *FnCtx, b: i64, at: i64, list: *IntVec) {
    unsafe {
        for i in 0..list.count {
            if at == 0 {
                ir_append(cx, b, list.data[i]);
            } else {
                ir_insert_before(cx, at, list.data[i]);
            }
        }
    }
}

// FRAMES[slot] = the string `sid`, before `at` in block b.
fn store_site(mut cx: *FnCtx, b: i64, at: i64, slot: i64, sid: i64) {
    unsafe {
        let s = ir_make(cx, Op::SAddr, TY_U64, 0, 0, sid);
        let st = ir_make(cx, Op::Store, 0, slot, s, 0);
        cx.insts[st].imm2 = TY_U64;
        let mut list = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        list.push(s);
        list.push(st);
        put_before(cx, b, at, &list);
    }
}

// A call of `callee` (an FNS index) with no arguments, before `at`.
fn call_before(mut cx: *FnCtx, b: i64, at: i64, callee: i64) {
    unsafe {
        let call = ir_make(cx, Op::Call, 0, 0, 0, callee);
        cx.insts[call].args = cx.args.count;
        cx.insts[call].nargs = 0;
        let mut list = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        list.push(call);
        put_before(cx, b, at, &list);
    }
}

fn instrument_function(mut cx: *FnCtx, fi: i64, depth_sym: i64, frames_sym: i64) {
    unsafe {
        ir_enter(cx, fi);
        let entry = IRFUNCS[fi].entry;
        if cx.blocks[entry].preds.count > 0 {
            // (an entry that is also a loop's header would push each time)
            return;
        }
        let at = body_start(cx, entry);
        let g = ir_make(cx, Op::GAddr, TY_U64, 0, 0, depth_sym);
        let d = ir_make(cx, Op::Load, TY_I64, g, 0, 0);
        let one = ir_make(cx, Op::Const, TY_I64, 0, 0, 1);
        let d1 = ir_make(cx, Op::Add, TY_I64, d, one, 0);
        let st = ir_make(cx, Op::Store, 0, g, d1, 0);
        cx.insts[st].imm2 = TY_I64;
        let base = ir_make(cx, Op::GAddr, TY_U64, 0, 0, frames_sym);
        let mask = ir_make(cx, Op::Const, TY_I64, 0, 0, 4095);
        let m = ir_make(cx, Op::And, TY_I64, d, mask, 0);
        let three = ir_make(cx, Op::Const, TY_I64, 0, 0, 3);
        let off = ir_make(cx, Op::Shl, TY_I64, m, three, 0);
        let slot = ir_make(cx, Op::Add, TY_U64, base, off, 0);
        let mut list = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let parts: [i64; 11] = [g, d, one, d1, st, base, mask, m, three, off, slot];
        for i in 0..11 {
            list.push(parts[i]);
        }
        put_before(cx, entry, at, &list);
        store_site(cx, entry, at, slot, site(fi, 0));
        // The sites of the calls (one string per line), the returns.
        let mut lines = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut sids = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let blocks = IRFUNCS[fi].blocks;
        for k in 0..blocks.count {
            cx.blocks[blocks.data[k]].aux = k + 1;
        }
        for k in 0..blocks.count {
            let b = blocks.data[k];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            let mut last = -1;
            // A loop's header (a predecessor after it): its statement, each
            // time round (where a loop without calls runs, when stopped).
            let mut back = false;
            for p in 0..cx.blocks[b].preds.count {
                back = back || cx.blocks[cx.blocks[b].preds.data[p]].aux > k;
            }
            if back {
                let mut w = cx.blocks[b].first;
                while w != 0 && cx.inst_loc.data[w] == 0 {
                    w = cx.insts[w].next;
                }
                if w != 0 {
                    let pos = cx.inst_loc.data[w] - 1;
                    last = file_and_line(pos);
                    store_site(cx, b, body_start(cx, b), slot, site_of(fi, pos, &lines, &sids));
                }
            }
            let mut v = cx.blocks[b].first;
            while v != 0 {
                let next = cx.insts[v].next;
                if cx.insts[v].op.is_call() && cx.inst_loc.data[v] > 0 {
                    let pos = cx.inst_loc.data[v] - 1;
                    let line = file_and_line(pos);
                    if line != last {
                        store_site(cx, b, v, slot, site_of(fi, pos, &lines, &sids));
                        last = line;
                    }
                }
                v = next;
            }
            if cx.blocks[b].term == Term::Ret {
                let g2 = ir_make(cx, Op::GAddr, TY_U64, 0, 0, depth_sym);
                let restore = ir_make(cx, Op::Store, 0, g2, d, 0);
                cx.insts[restore].imm2 = TY_I64;
                ir_append(cx, b, g2);
                ir_append(cx, b, restore);
            }
        }
        for k in 0..blocks.count {
            cx.blocks[blocks.data[k]].aux = 0;
        }
    }
}

// --trace: every function's frame; main starts the runtime; std::panic
// dumps the frames.
pub fn trace_after_lowering(mut cx: *FnCtx) {
    unsafe {
        if !TRACE {
            return;
        }
        let depth_sym = intern_c(c"__trace.DEPTH");
        let frames_sym = intern_c(c"__trace.FRAMES");
        let start = SYM_FN[intern_c(c"__trace::start")] - 1;
        let dump = SYM_FN[intern_c(c"__trace::__tachyon_trace_dump")] - 1;
        if SYM_STATIC[depth_sym] == 0 || SYM_STATIC[frames_sym] == 0 || start < 0 || dump < 0 {
            return;
        }
        let note = SYM_FN[intern_c(c"std::panic_note")] - 1;
        let panic = SYM_FN[intern_c(c"std::panic")] - 1;
        for fi in 0..IRFUNC_COUNT {
            let f = IRFUNCS[fi].f;
            if FNS[f].module == TRACE_MODULE {
                continue;
            }
            if note >= 0 && f == panic {
                // std::panic's note: the frames instead.
                ir_enter(cx, fi);
                let blocks = IRFUNCS[fi].blocks;
                for k in 0..blocks.count {
                    let mut v = cx.blocks[blocks.data[k]].first;
                    while v != 0 {
                        if cx.insts[v].op == Op::Call && cx.insts[v].imm == note {
                            cx.insts[v].imm = dump;
                        }
                        v = cx.insts[v].next;
                    }
                }
            }
            if traced(fi) {
                instrument_function(cx, fi, depth_sym, frames_sym);
            }
            if FNS[f].name == MAIN_SYM {
                ir_enter(cx, fi);
                let entry = IRFUNCS[fi].entry;
                call_before(cx, entry, body_start(cx, entry), start);
            }
        }
    }
}

// The runtime's `dump` (an FNS index) when it is emitted, for rt.panic
// to call; -1: none (no --trace, or nothing reaches it).
pub fn trace_dump_fn() -> i64 {
    unsafe {
        if !TRACE {
            return -1;
        }
        let f = SYM_FN[intern_c(c"__trace::__tachyon_trace_dump")] - 1;
        if f < 0 || FN_IR[f] == 0 || FN_LIVE == 0 as *i64 || FN_LIVE[FN_IR[f] - 1] == 0 {
            return -1;
        }
        f
    }
}
