// Loop analysis and the canonical form of loops (0.4), with the utilities
// the loop transformations share: an SSA updater and the cloning of a
// region of blocks.
//
// The loop forest: a natural loop per header (every back edge t -> h, where
// h dominates t, adds to h's loop the blocks that reach t without passing
// h); loops with distinct headers are nested or disjoint. A loop in
// canonical form has a preheader (its header's only predecessor outside
// the loop, ending in a jump), a single latch (the header's only
// predecessor inside the loop) and dedicated exits (every block outside
// the loop that a loop block branches to has only predecessors inside the
// loop). LCSSA: a value defined in a loop and used outside it is used
// through a phi in an exit block.

// Per loop: its header, parent loop (-1: outermost), depth (1: outermost)
// and blocks: LP_BLOCKS[LP_START[l]..][..LP_COUNT[l]], the header first.
use crate::base::{IntVec, alloc_array, free};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    IRFUNCS, IR_LOCS, Op, Term, ir_append, ir_arg, ir_enter, ir_insert_before, ir_make,
    ir_new_block, ir_operand, ir_operand_count, ir_prepend, ir_set_operand,
};
use crate::middle::ir::cfg::{
    case_target, case_value, copy_terminator, pred_index, redirect_succ, succ, succ_count,
    switch_rebuild_succs,
};
use crate::middle::ir::verify::verify_func;
use crate::middle::lower::ssa::{new_synth_var, ssa_read, ssa_write};
use crate::middle::opt::{
    compute_dominators, dominates, remove_pred, remove_trivial_phis, resolve_all, simplify_cfg,
};

pub fn loop_count(cx: sink *FnCtx) -> i64 {
    unsafe { cx.lp_header.count }
}

pub fn loop_header(cx: sink *FnCtx, l: i64) -> i64 {
    unsafe { cx.lp_header.data[l] }
}

pub fn loop_block(cx: sink *FnCtx, l: i64, i: i64) -> i64 {
    unsafe { cx.lp_blocks.data[cx.lp_start.data[l] + i] }
}

pub fn loop_size(cx: sink *FnCtx, l: i64) -> i64 {
    unsafe { cx.lp_count.data[l] }
}

// Whether block b belongs to loop l (or to a loop nested in it).
pub fn loop_contains(cx: sink *FnCtx, l: i64, b: i64) -> bool {
    unsafe {
        if b >= cx.lp_nblocks {
            return false;
        }
        var x = cx.lp_of[b] - 1;
        while x >= 0 {
            if x == l {
                return true;
            }
            x = cx.lp_parent.data[x];
        }
        false
    }
}

// The innermost loop containing block b, or -1.
pub fn innermost_loop(cx: sink *FnCtx, b: i64) -> i64 {
    if unsafe { b >= cx.lp_nblocks } { -1 } else { unsafe { cx.lp_of[b] - 1 } }
}

// Whether loop l contains no other loop.
pub fn is_innermost(cx: sink *FnCtx, l: i64) -> bool {
    for k in 0..loop_count(cx) {
        if unsafe { cx.lp_parent.data[k] == l } {
            return false;
        }
    }
    true
}

// A per-block array (indexed by block id) kept from call to call: grown
// to cover every block (the contents are not kept then), with the entries
// of function fi's blocks set to 0. (Allocating one per call would cost
// the size of the whole program each time.)
pub fn block_array(cx: sink *FnCtx, arr: *i64, cap: *i64, fi: i64) -> *i64 {
    unsafe {
        var a = arr;
        if *cap < cx.block_count + 1 {
            free(a as *u8);
            *cap = (cx.block_count + 1) * 2;
            a = alloc_array::<i64>(*cap);
        }
        for i in 0..IRFUNCS[fi].blocks.count {
            a[IRFUNCS[fi].blocks.data[i]] = 0;
        }
        a
    }
}

fn new_stamp(cx: sink *FnCtx) -> i64 {
    unsafe {
        cx.lp_stamp += 1;
        cx.lp_stamp
    }
}

// Finds the loops of function fi (and its dominators and block layout).
pub fn analyze_loops(cx: sink *FnCtx, fi: i64) {
    unsafe {
        compute_dominators(cx, fi);
        cx.lp_header.count = 0;
        cx.lp_parent.count = 0;
        cx.lp_depth.count = 0;
        cx.lp_start.count = 0;
        cx.lp_count.count = 0;
        cx.lp_blocks.count = 0;
        cx.lp_nblocks = cx.block_count;
        cx.lp_of = block_array(cx, cx.lp_of, &cx.lp_of_cap, fi);
        // (Stamps only grow, so LP_SEEN needs no clearing.)
        cx.lp_seen = block_array(cx, cx.lp_seen, &cx.lp_seen_cap, fi);
        var work = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..cx.order.count {
            let h = cx.order.data[i];
            let start = cx.lp_blocks.count;
            let stamp = new_stamp(cx);
            for k in 0..cx.blocks[h].preds.count {
                let t = cx.blocks[h].preds.data[k];
                // (h dominates t only when t is not earlier in the
                // order: the walk up t's dominators is for back edges)
                if cx.blocks[t].order < cx.blocks[h].order || !dominates(cx, h, t) {
                    continue;
                }
                if cx.lp_blocks.count == start {
                    cx.lp_seen[h] = stamp;
                    cx.lp_blocks.push(h);
                }
                if cx.lp_seen[t] != stamp {
                    cx.lp_seen[t] = stamp;
                    cx.lp_blocks.push(t);
                    work.push(t);
                }
                while work.count > 0 {
                    let x = work.pop();
                    for m in 0..cx.blocks[x].preds.count {
                        let p = cx.blocks[x].preds.data[m];
                        if cx.blocks[p].order >= 0 && cx.lp_seen[p] != stamp {
                            cx.lp_seen[p] = stamp;
                            cx.lp_blocks.push(p);
                            work.push(p);
                        }
                    }
                }
            }
            if cx.lp_blocks.count > start {
                cx.lp_header.push(h);
                cx.lp_parent.push(-1);
                cx.lp_depth.push(1);
                cx.lp_start.push(start);
                cx.lp_count.push(cx.lp_blocks.count - start);
            }
        }
        free(work.data as *u8);
        // Nesting: the loops from the largest to the smallest; the innermost
        // loop seen so far that contains a header is its parent.
        let n = loop_count(cx);
        let by_size = alloc_array::<i64>(n + 1);
        for l in 0..n {
            var k = l;
            while k > 0 && cx.lp_count.data[by_size[k - 1]] < cx.lp_count.data[l] {
                by_size[k] = by_size[k - 1];
                k -= 1;
            }
            by_size[k] = l;
        }
        for i in 0..n {
            let l = by_size[i];
            let parent = cx.lp_of[loop_header(cx, l)] - 1;
            cx.lp_parent.data[l] = parent;
            cx.lp_depth.data[l] = if parent < 0 { 1 } else { cx.lp_depth.data[parent] + 1 };
            for k in 0..loop_size(cx, l) {
                cx.lp_of[loop_block(cx, l, k)] = l + 1;
            }
        }
        free(by_size as *u8);
    }
}

// ---- Canonical form ----

// The preheader of loop l (its header's only outside predecessor, which
// jumps to it), or 0.
pub fn loop_preheader(cx: sink *FnCtx, l: i64) -> i64 {
    unsafe {
        let h = loop_header(cx, l);
        var found = 0;
        for k in 0..cx.blocks[h].preds.count {
            let p = cx.blocks[h].preds.data[k];
            if !loop_contains(cx, l, p) {
                if found != 0 {
                    return 0;
                }
                found = p;
            }
        }
        if found == 0 || cx.blocks[found].term != Term::Jump {
            return 0;
        }
        found
    }
}

// The single latch of loop l, or 0.
pub fn loop_latch(cx: sink *FnCtx, l: i64) -> i64 {
    let h = loop_header(cx, l);
    var found = 0;
    unsafe {
        for k in 0..cx.blocks[h].preds.count {
            let p = cx.blocks[h].preds.data[k];
            if loop_contains(cx, l, p) {
                if found != 0 {
                    return 0;
                }
                found = p;
            }
        }
    }
    found
}

// The exit blocks of loop l (outside it, entered from it) into LP_LIST.
pub fn loop_exits(cx: sink *FnCtx, l: i64) {
    unsafe {
        cx.lp_list.count = 0;
        let stamp = new_stamp(cx);
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            for k in 0..succ_count(cx, b) {
                let s = succ(cx, b, k);
                if !loop_contains(cx, l, s) && cx.lp_seen[s] != stamp {
                    cx.lp_seen[s] = stamp;
                    cx.lp_list.push(s);
                }
            }
        }
    }
}

// Appends predecessor `pred` to block b; its k-th phi gets values[first + k].
pub fn add_pred_values(cx: sink *FnCtx, b: i64, pred: i64, values: *IntVec, first: i64) {
    unsafe {
        cx.blocks[b].preds.push(pred);
        var k = 0;
        var phi = cx.blocks[b].first;
        while phi != 0 && cx.insts[phi].op == Op::Phi {
            let n = cx.insts[phi].nargs;
            let start = cx.args.count;
            for i in 0..n {
                cx.args.push(cx.args.data[cx.insts[phi].args + i]);
                cx.argty.push(0);
            }
            cx.args.push((*values).data[first + k]);
            cx.argty.push(0);
            cx.insts[phi].args = start;
            cx.insts[phi].nargs = n + 1;
            k += 1;
            phi = cx.insts[phi].next;
        }
    }
}

// A new phi of type ty in block b (after its other phis) over `count`
// operands values[first..].
pub fn new_phi_in(cx: sink *FnCtx, b: i64, ty: i64, values: *IntVec, first: i64, count: i64) -> i64 {
    unsafe {
        let phi = ir_make(cx, Op::Phi, ty, 0, 0, 0);
        cx.insts[phi].args = cx.args.count;
        cx.insts[phi].nargs = count;
        for i in 0..count {
            cx.args.push((*values).data[first + i]);
            cx.argty.push(0);
        }
        var last_phi = 0;
        var v = cx.blocks[b].first;
        while v != 0 && cx.insts[v].op == Op::Phi {
            last_phi = v;
            v = cx.insts[v].next;
        }
        if last_phi == 0 {
            ir_prepend(cx, b, phi);
        } else if cx.insts[last_phi].next == 0 {
            ir_append(cx, b, phi);
        } else {
            ir_insert_before(cx, cx.insts[last_phi].next, phi);
        }
        phi
    }
}

// Moves the predecessors `list` of block b (each once among b's
// predecessors) to a new block that jumps to b: their edges go to the new
// block, and b's phis get, for it, the operand of the one predecessor or a
// new phi in the new block over theirs. Returns the new block.
fn split_preds(cx: sink *FnCtx, fi: i64, b: i64, list: IntVec) -> i64 {
    unsafe {
        ir_enter(cx, fi);
        let nb = ir_new_block(cx);
        cx.blocks[nb].sealed = 1;
        let n = list.count;
        let mark = cx.lp_values.count;
        var phi = cx.blocks[b].first;
        while phi != 0 && cx.insts[phi].op == Op::Phi {
            if n == 1 {
                cx.lp_values.push(ir_arg(cx, phi, pred_index(cx, b, list.data[0])));
            } else {
                let first = cx.lp_values.count;
                for i in 0..n {
                    cx.lp_values.push(ir_arg(cx, phi, pred_index(cx, b, list.data[i])));
                }
                let np = new_phi_in(cx, nb, cx.insts[phi].ty, &cx.lp_values, first, n);
                cx.lp_values.count = first;
                cx.lp_values.push(np);
            }
            phi = cx.insts[phi].next;
        }
        for i in 0..n {
            let p = list.data[i];
            remove_pred(cx, b, p);
            redirect_succ(cx, p, b, nb);
            cx.blocks[nb].preds.push(p);
        }
        add_pred_values(cx, b, nb, &cx.lp_values, mark);
        cx.lp_values.count = mark;
        cx.blocks[nb].term = Term::Jump;
        cx.blocks[nb].s0 = b;
        nb
    }
}

// Puts loop l in canonical form; returns whether anything changed (the
// loop forest must then be found again).
fn canonicalize_loop(cx: sink *FnCtx, fi: i64, l: i64) -> bool {
    unsafe {
        let h = loop_header(cx, l);
        var outside = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var inside = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for k in 0..cx.blocks[h].preds.count {
            let p = cx.blocks[h].preds.data[k];
            if loop_contains(cx, l, p) {
                inside.push(p);
            } else {
                outside.push(p);
            }
        }
        var changed = false;
        if outside.count > 0
            && (outside.count > 1 || cx.blocks[outside.data[0]].term != Term::Jump) {
            split_preds(cx, fi, h, outside);
            changed = true;
        }
        if inside.count > 1 {
            split_preds(cx, fi, h, inside);
            changed = true;
        }
        free(outside.data as *u8);
        free(inside.data as *u8);
        if changed {
            return true;
        }
        // Dedicated exits.
        loop_exits(cx, l);
        var exits = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..cx.lp_list.count {
            exits.push(cx.lp_list.data[i]);
        }
        var from = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..exits.count {
            let e = exits.data[i];
            var shared = false;
            from.count = 0;
            for k in 0..cx.blocks[e].preds.count {
                let p = cx.blocks[e].preds.data[k];
                if loop_contains(cx, l, p) {
                    from.push(p);
                } else {
                    shared = true;
                }
            }
            if shared {
                split_preds(cx, fi, e, from);
                changed = true;
            }
        }
        free(exits.data as *u8);
        free(from.data as *u8);
        changed
    }
}

// Puts every loop of fi in canonical form (finding the loops again after
// each change). Loops whose header is the entry are left alone.
pub fn canonicalize_loops(cx: sink *FnCtx, fi: i64) -> bool {
    var changed = false;
    for _ in 0..1000 {
        analyze_loops(cx, fi);
        var did = false;
        for l in 0..loop_count(cx) {
            if unsafe { loop_header(cx, l) != IRFUNCS[fi].entry && canonicalize_loop(cx, fi, l) } {
                did = true;
                break;
            }
        }
        if !did {
            break;
        }
        changed = true;
    }
    changed
}

// Whether loop l is in canonical form.
pub fn is_canonical(cx: sink *FnCtx, l: i64) -> bool {
    unsafe {
        if loop_preheader(cx, l) == 0 || loop_latch(cx, l) == 0 {
            return false;
        }
        loop_exits(cx, l);
        for i in 0..cx.lp_list.count {
            let e = cx.lp_list.data[i];
            for k in 0..cx.blocks[e].preds.count {
                if !loop_contains(cx, l, cx.blocks[e].preds.data[k]) {
                    return false;
                }
            }
        }
        true
    }
}

// ---- The SSA updater ----

// A value defined in several blocks: ssa_write(var, block, value) for each
// definition, then ssa_read(var, block) gives the value reaching the end of
// a block (phis are placed where definitions meet; lower.vl). Every
// block must be sealed.
fn updater_var(cx: sink *FnCtx, ty: i64) -> i64 {
    new_synth_var(cx, ty)
}

pub fn seal_all(cx: sink *FnCtx, fi: i64) {
    unsafe {
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            cx.blocks[b].sealed = 1;
            cx.blocks[b].incomplete = 0;
        }
    }
}

// The block where a use of an operand happens: the block of instruction u,
// or for a phi's k-th operand, the k-th predecessor of the phi's block.
fn use_block(cx: sink *FnCtx, u: i64, k: i64) -> i64 {
    unsafe {
        if cx.insts[u].op == Op::Phi && k >= 3 {
            return cx.blocks[cx.insts[u].block].preds.data[k - 3];
        }
        cx.insts[u].block
    }
}

// ---- LCSSA ----

// Makes every value defined in loop l and used outside it go through phis
// in the exit blocks. Returns whether anything changed. The dominators
// must be current.
pub fn form_lcssa(cx: sink *FnCtx, fi: i64, l: i64) -> bool {
    unsafe {
        ir_enter(cx, fi);
        // Uses outside the loop of values defined inside: (user, operand index)
        // pairs; a terminator's condition is user -block (index 0).
        var uses = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 || cx.blocks[b].order < 0 {
                continue;
            }
            var v = cx.blocks[b].first;
            while v != 0 {
                for k in 0..ir_operand_count(cx, v) {
                    let w = ir_operand(cx, v, k);
                    if w != 0 && cx.insts[w].block != 0 && loop_contains(cx, l, cx.insts[w].block)
                        && !loop_contains(cx, l, use_block(cx, v, k)) {
                        uses.push(v);
                        uses.push(k);
                    }
                }
                v = cx.insts[v].next;
            }
            let c = cx.blocks[b].cond;
            if c != 0 && cx.insts[c].block != 0 && loop_contains(cx, l, cx.insts[c].block)
                && !loop_contains(cx, l, b) {
                uses.push(0 - b);
                uses.push(0);
            }
        }
        if uses.count == 0 {
            free(uses.data as *u8);
            return false;
        }
        loop_exits(cx, l);
        var exits = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..cx.lp_list.count {
            exits.push(cx.lp_list.data[i]);
        }
        // One updater variable per value (INSTS[w].mark = var + 1).
        for i in 0..uses.count / 2 {
            let w = lcssa_used(cx, uses.data[2 * i], uses.data[2 * i + 1]);
            cx.insts[w].mark = 0;
        }
        for i in 0..uses.count / 2 {
            let u = uses.data[2 * i];
            let k = uses.data[2 * i + 1];
            let w = lcssa_used(cx, u, k);
            if cx.insts[w].mark == 0 {
                let var_id = updater_var(cx, cx.insts[w].ty);
                cx.insts[w].mark = var_id + 1;
                for j in 0..exits.count {
                    let e = exits.data[j];
                    if dominates(cx, cx.insts[w].block, e) {
                        let first = cx.lp_values.count;
                        for m in 0..cx.blocks[e].preds.count {
                            cx.lp_values.push(w);
                        }
                        let phi = new_phi_in(cx, e, cx.insts[w].ty, &cx.lp_values, first,
                            cx.blocks[e].preds.count);
                        cx.lp_values.count = first;
                        ssa_write(cx, var_id, e, phi);
                    }
                }
            }
            let var_id = cx.insts[w].mark - 1;
            if u < 0 {
                cx.blocks[0 - u].cond = ssa_read(cx, var_id, 0 - u);
            } else {
                ir_set_operand(cx, u, k, ssa_read(cx, var_id, use_block(cx, u, k)));
            }
        }
        free(exits.data as *u8);
        free(uses.data as *u8);
        true
    }
}

fn lcssa_used(cx: sink *FnCtx, u: i64, k: i64) -> i64 {
    if u < 0 { unsafe { cx.blocks[0 - u].cond } } else { ir_operand(cx, u, k) }
}

// ---- Cloning ----

// The copy of value v when v is defined in the region being cloned (blocks
// marked `stamp` in LP_SEEN), else v.
pub fn clone_map(cx: sink *FnCtx, v: i64, stamp: i64) -> i64 {
    unsafe {
        if v == 0 || cx.insts[v].block == 0 {
            return v;
        }
        let b = cx.insts[v].block;
        if b < cx.lp_nblocks && cx.lp_seen[b] == stamp { cx.insts[v].aux } else { v }
    }
}

fn clone_block_map(cx: sink *FnCtx, b: i64, stamp: i64) -> i64 {
    unsafe {
        if b != 0 && b < cx.lp_nblocks && cx.lp_seen[b] == stamp { cx.blocks[b].aux } else { b }
    }
}

// A copy of instruction v (not in a block; operands as they are).
pub fn clone_inst(cx: sink *FnCtx, v: i64) -> i64 {
    unsafe {
        let op = cx.insts[v].op;
        let nv = ir_make(cx, op, cx.insts[v].ty, cx.insts[v].a, cx.insts[v].b, cx.insts[v].imm);
        cx.insts[nv].c = cx.insts[v].c;
        cx.insts[nv].cond = cx.insts[v].cond;
        cx.insts[nv].imm2 = cx.insts[v].imm2;
        if IR_LOCS {
            cx.inst_loc.data[nv] = cx.inst_loc.data[v];
        }
        if cx.insts[v].nargs > 0 || op == Op::Phi || op.is_call() {
            cx.insts[nv].args = cx.args.count;
            cx.insts[nv].nargs = cx.insts[v].nargs;
            for a in 0..cx.insts[v].nargs {
                cx.args.push(ir_arg(cx, v, a));
                cx.argty.push(cx.argty.data[cx.insts[v].args + a]);
            }
        }
        nv
    }
}

// Clones the blocks `list` (marked `stamp` in LP_SEEN; LP_NBLOCKS must
// cover them): BLOCKS[b].aux is b's copy and INSTS[v].aux v's. Operands
// and successors inside the region are mapped to their copies; a copy's
// predecessors are its original's, mapped, in the same order (those from
// outside the region kept: their terminators still go to the original).
pub fn clone_region(cx: sink *FnCtx, fi: i64, list: *IntVec, stamp: i64) {
    unsafe {
        ir_enter(cx, fi);
        let n = (*list).count;
        for i in 0..n {
            let b = (*list).data[i];
            let nb = ir_new_block(cx);
            cx.blocks[nb].sealed = 1;
            cx.blocks[nb].novec = cx.blocks[b].novec;
            cx.blocks[nb].count = cx.blocks[b].count;
            cx.blocks[b].aux = nb;
            var v = cx.blocks[b].first;
            while v != 0 {
                let nv = clone_inst(cx, v);
                ir_append(cx, nb, nv);
                cx.insts[v].aux = nv;
                v = cx.insts[v].next;
            }
        }
        for i in 0..n {
            let b = (*list).data[i];
            let nb = cx.blocks[b].aux;
            var v = cx.blocks[nb].first;
            while v != 0 {
                for k in 0..ir_operand_count(cx, v) {
                    let w = ir_operand(cx, v, k);
                    if w != 0 {
                        ir_set_operand(cx, v, k, clone_map(cx, w, stamp));
                    }
                }
                v = cx.insts[v].next;
            }
            copy_terminator(cx, nb, b);
            cx.blocks[nb].cond = clone_map(cx, cx.blocks[b].cond, stamp);
            map_successors(cx, nb, stamp);
            for k in 0..cx.blocks[b].preds.count {
                cx.blocks[nb].preds.push(clone_block_map(cx, cx.blocks[b].preds.data[k], stamp));
            }
        }
    }
}

// Maps the successors of block b (a copy) through clone_block_map.
fn map_successors(cx: sink *FnCtx, b: i64, stamp: i64) {
    unsafe {
        if cx.blocks[b].term == Term::Switch {
            let start = cx.swcases.count;
            for i in 0..cx.blocks[b].ncases {
                cx.swcases.push(case_value(cx, b, i));
                cx.swcases.push(clone_block_map(cx, case_target(cx, b, i), stamp));
            }
            cx.blocks[b].cases = start;
            cx.blocks[b].s0 = clone_block_map(cx, cx.blocks[b].s0, stamp);
            switch_rebuild_succs(cx, b);
            return;
        }
        cx.blocks[b].s0 = clone_block_map(cx, cx.blocks[b].s0, stamp);
        cx.blocks[b].s1 = clone_block_map(cx, cx.blocks[b].s1, stamp);
    }
}

// Marks the blocks of loop l with a fresh stamp in LP_SEEN and lists them
// in LP_LIST2; returns the stamp.
pub fn mark_loop_blocks(cx: sink *FnCtx, l: i64) -> i64 {
    unsafe {
        let stamp = new_stamp(cx);
        cx.lp_list2.count = 0;
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            unsafe { cx.lp_seen[b] = stamp; }
            cx.lp_list2.push(b);
        }
        stamp
    }
}

// The number of instructions in loop l.
pub fn loop_inst_count(cx: sink *FnCtx, l: i64) -> i64 {
    unsafe {
        var n = 0;
        for i in 0..loop_size(cx, l) {
            var v = cx.blocks[loop_block(cx, l, i)].first;
            while v != 0 {
                n += 1;
                v = cx.insts[v].next;
            }
        }
        n
    }
}

// Whether v is defined outside loop l (constants and the like included).
pub fn invariant_in(cx: sink *FnCtx, l: i64, v: i64) -> bool {
    unsafe { v == 0 || cx.insts[v].block == 0 || !loop_contains(cx, l, cx.insts[v].block) }
}

// ---- Rotation ----

// Instructions (other than phis) a header may have to be duplicated.
const ROTATE_MAX: i64 = 16;

fn was_rotated(cx: sink *FnCtx, h: i64) -> bool {
    unsafe {
        for i in 0..cx.rotated.count {
            if unsafe { cx.rotated.data[i] == h } {
                return true;
            }
        }
    }
    false
}

// Turns loop l, when its header tests the exit (a while loop), into a
// guarded do-while: the header's instructions are copied into the
// preheader, which branches to the body or the exit; the header, reached
// from the latch only, becomes part of the latch. Returns whether it did.
fn rotate_loop(cx: sink *FnCtx, fi: i64, l: i64) -> bool {
    unsafe {
        let h = loop_header(cx, l);
        let pre = loop_preheader(cx, l);
        let latch = loop_latch(cx, l);
        if pre == 0 || latch == 0 || latch == h || cx.blocks[h].term != Term::Branch {
            return false;
        }
        let s0 = cx.blocks[h].s0;
        let s1 = cx.blocks[h].s1;
        let in0 = loop_contains(cx, l, s0);
        let in1 = loop_contains(cx, l, s1);
        if in0 == in1 || s0 == s1 {
            return false;
        }
        let body = if in0 { s0 } else { s1 };
        let exit = if in0 { s1 } else { s0 };
        if body == h || was_rotated(cx, h) {
            return false;
        }
        var size = 0;
        var v = cx.blocks[h].first;
        while v != 0 {
            if cx.insts[v].op != Op::Phi {
                size += 1;
            }
            v = cx.insts[v].next;
        }
        if size > ROTATE_MAX {
            return false;
        }
        ir_enter(cx, fi);
        cx.rotated.push(body);
        // The header's values as the preheader sees them: a phi's operand for
        // the preheader, copies of the other instructions (INSTS[v].aux).
        let pre_index = pred_index(cx, h, pre);
        v = cx.blocks[h].first;
        while v != 0 {
            if cx.insts[v].op == Op::Phi {
                cx.insts[v].aux = ir_arg(cx, v, pre_index);
            } else {
                let nv = clone_inst(cx, v);
                for k in 0..ir_operand_count(cx, nv) {
                    let w = ir_operand(cx, nv, k);
                    if w != 0 && cx.insts[w].block == h {
                        ir_set_operand(cx, nv, k, cx.insts[w].aux);
                    }
                }
                ir_append(cx, pre, nv);
                cx.insts[v].aux = nv;
            }
            v = cx.insts[v].next;
        }
        let cond = cx.blocks[h].cond;
        let pre_cond = if cx.insts[cond].block == h { cx.insts[cond].aux } else { cond };
        // The preheader branches like the header; the header loses it.
        cx.blocks[pre].term = Term::Branch;
        cx.blocks[pre].cond = pre_cond;
        cx.blocks[pre].s0 = s0;
        cx.blocks[pre].s1 = s1;
        remove_pred(cx, h, pre);
        for t in 0..2 {
            let s = if t == 0 { body } else { exit };
            let index = pred_index(cx, s, h);
            let first = cx.lp_values.count;
            var phi = cx.blocks[s].first;
            while phi != 0 && cx.insts[phi].op == Op::Phi {
                let w = ir_arg(cx, phi, index);
                cx.lp_values.push(if w != 0 && cx.insts[w].block == h { cx.insts[w].aux }
                    else { w });
                phi = cx.insts[phi].next;
            }
            add_pred_values(cx, s, pre, &cx.lp_values, first);
            cx.lp_values.count = first;
        }
        // Uses of the header's values elsewhere read whichever definition
        // reaches them: the header's or the preheader's.
        v = cx.blocks[h].first;
        while v != 0 {
            cx.insts[v].mark = 0;
            v = cx.insts[v].next;
        }
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            // (The header's own phis use values at the latch.)
            if cx.blocks[b].removed != 0 {
                continue;
            }
            var u = cx.blocks[b].first;
            while u != 0 {
                for k in 0..ir_operand_count(cx, u) {
                    let w = ir_operand(cx, u, k);
                    if w != 0 && cx.insts[w].block == h {
                        let ub = use_block(cx, u, k);
                        if ub != h {
                            ir_set_operand(cx, u, k, ssa_read(cx, rotate_var(cx, w, h, pre), ub));
                        }
                    }
                }
                u = cx.insts[u].next;
            }
            let c = cx.blocks[b].cond;
            if c != 0 && cx.insts[c].block == h && b != pre && b != h {
                cx.blocks[b].cond = ssa_read(cx, rotate_var(cx, c, h, pre), b);
            }
        }
        true
    }
}

// The updater variable of header value w (defined in h, and as
// INSTS[w].aux in the preheader).
fn rotate_var(cx: sink *FnCtx, w: i64, h: i64, pre: i64) -> i64 {
    unsafe {
        if cx.insts[w].mark == 0 {
            let var_id = updater_var(cx, cx.insts[w].ty);
            cx.insts[w].mark = var_id + 1;
            ssa_write(cx, var_id, h, w);
            ssa_write(cx, var_id, pre, cx.insts[w].aux);
        }
        cx.insts[w].mark - 1
    }
}

// Rotates every loop of fi that can be; returns whether any was. One
// analysis serves them all: rotation makes no blocks and moves none
// between loops (a rotated loop's preheader now branches, which no other
// loop's rotation depends on).
pub fn rotate_loops(cx: sink *FnCtx, fi: i64) -> bool {
    unsafe {
        cx.rotated.count = 0;
        canonicalize_loops(cx, fi);
        var changed = false;
        // Innermost loops first: an outer loop's rotation then only adds phis
        // to inner loops already rotated. The phis an updater leaves trivial
        // go before the next rotation reads its header's phis.
        var depth = 0;
        for l in 0..loop_count(cx) {
            if cx.lp_depth.data[l] > depth {
                depth = cx.lp_depth.data[l];
            }
        }
        while depth >= 1 {
            for l in 0..loop_count(cx) {
                if cx.lp_depth.data[l] == depth && loop_header(cx, l) != IRFUNCS[fi].entry
                    && rotate_loop(cx, fi, l) {
                    changed = true;
                    resolve_all(cx, fi);
                    remove_trivial_phis(cx, fi);
                }
            }
            depth -= 1;
        }
        if changed {
            resolve_all(cx, fi);
            verify_func(cx, fi, c"loop rotation");
            // The old headers now have their latch as only predecessor.
            simplify_cfg(cx, fi);
        }
        changed
    }
}
