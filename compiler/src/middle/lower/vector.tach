// Lowering vector expressions (0.10).
//
// A vector expression's value is an address, as for other compound types;
// its operations load their operands (once, in order: the value is taken
// before the next operand is evaluated, as -O0 copies it), compute with
// the vector instructions, and store the result into a new slot. Scalar
// replacement turns those slots into values.

use crate::front::ast::{
    NODES, VK_LANE, VK_LOAD, VK_NEW, VK_SELECT, VK_SPLAT, VK_STORE, VK_SUM, child,
};
use crate::front::contracts::sites::site_of;
use crate::front::lexer::Tok;
use crate::front::parser::exprs::is_comparison;
use crate::front::types::{TYPES, TY_I64, TY_U64, is_slice, type_size, vec_elem, vec_lanes};
use crate::gen0::target::{PANIC_INDEX_SIGNED, PANIC_RANGE_SIGNED};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    Cond, Op, cond_of_token, emit_ir, ir_binary, ir_cmp, ir_const, ir_load, ir_slot_addr, ir_store,
    ir_type,
};
use crate::middle::lower::new_slot_for;
use crate::middle::lower::calls::lower_check;
use crate::middle::lower::expr::{arith_op, lower_operand};

pub fn arith_token_of(t: Tok) -> Tok {
    t
}

// The value of vector expression e (of its vector type).
pub fn vec_operand(mut cx: *FnCtx, e: i64) -> i64 {
    unsafe {
        let addr = lower_operand(cx, e);
        ir_load(cx, NODES[e].ty, addr, 0)
    }
}

// The address of a new slot holding vector `value`.
pub fn vec_result(mut cx: *FnCtx, value: i64, vt: i64) -> i64 {
    let base = ir_slot_addr(cx, new_slot_for(cx, vt));
    ir_store(cx, vt, base, value, 0);
    base
}

// a <token> b on vectors of type vt; the result of type `result_ty`.
pub fn vector_operator(mut cx: *FnCtx, token: Tok, vt: i64, result_ty: i64, a: i64, b: i64) -> i64 {
    if is_comparison(token) {
        let v = emit_ir(cx, Op::VCmp, result_ty, a, b, 0);
        unsafe {
            cx.insts[v].cond = cond_of_token(token);
            cx.insts[v].imm2 = vt;
        }
        return v;
    }
    emit_ir(cx, Op::VBin, vt, a, b, arith_op(token) as i64)
}

// The first element's address and the length of the slice or array of
// type ty at `value` (its address), read when called.
fn lower_elements(mut cx: *FnCtx, ty: i64, value: i64, len: &mut i64) -> i64 {
    unsafe {
        if is_slice(ty) {
            *len = ir_load(cx, TY_U64, value, 8);
            return ir_load(cx, TY_U64, value, 0);
        }
        *len = ir_const(cx, TYPES[ty].b, TY_U64);
        value
    }
}

// The address of lanes index..index + lanes of s (checked). s is
// evaluated first, to its address; a slice's pointer and length are read
// after the index, as in `s[i]`.
fn lower_vector_address(mut cx: *FnCtx, s: i64, index: i64, vt: i64) -> i64 {
    let mut len = 0;
    let value = lower_operand(cx, s);
    let idx = lower_operand(cx, index);
    let base = unsafe { lower_elements(cx, NODES[s].ty, value, &mut len) };
    let lanes = vec_lanes(vt);
    let end = ir_binary(cx, Op::Add, TY_I64, idx, ir_const(cx, lanes, TY_I64));
    let room = ir_binary(cx, Op::Sub, TY_I64, len, ir_const(cx, lanes, TY_I64));
    lower_check(cx, ir_cmp(cx, Cond::Le, TY_I64, idx, room), PANIC_RANGE_SIGNED, idx, end, len,
        site_of(index, 0));
    lower_check(cx, ir_cmp(cx, Cond::Ge, TY_I64, idx, ir_const(cx, 0, TY_I64)), PANIC_RANGE_SIGNED,
        idx, end, len, site_of(index, 0));
    let size = type_size(vec_elem(vt));
    ir_binary(cx, Op::Add, TY_U64, base,
        ir_binary(cx, Op::Mul, TY_U64, idx, ir_const(cx, size, TY_U64)))
}

// The lane index `index` (an expression), checked against vt's lanes.
fn lower_lane_index(mut cx: *FnCtx, index: i64, vt: i64) -> i64 {
    let idx = lower_operand(cx, index);
    let lanes = ir_const(cx, vec_lanes(vt), TY_U64);
    lower_check(cx, ir_cmp(cx, Cond::Lt, TY_U64, idx, lanes), PANIC_INDEX_SIGNED, idx, lanes, 0,
        site_of(index, 0));
    idx
}

// The constant value of IR value v (-1 when not a constant).
fn const_lane(mut cx: *FnCtx, v: i64) -> i64 {
    unsafe {
        if cx.insts[v].op == Op::Const && cx.insts[v].imm >= 0 && cx.insts[v].imm < 16 {
            return cx.insts[v].imm;
        }
        -1
    }
}

pub fn lower_vecop(mut cx: *FnCtx, n: i64) -> i64 {
    unsafe {
        let kind = NODES[n].x;
        let vt = NODES[n].y;
        let elem = vec_elem(vt);
        let lanes = vec_lanes(vt);
        let esize = type_size(elem);
        if kind == VK_NEW || kind == VK_SPLAT {
            let first = lower_operand(cx, child(n, 0));
            let mut v = emit_ir(cx, Op::VSplat, vt, first, 0, 0);
            if kind == VK_NEW {
                for i in 1..lanes {
                    let x = lower_operand(cx, child(n, i));
                    v = emit_ir(cx, Op::VIns, vt, v, x, i);
                }
            }
            return vec_result(cx, v, vt);
        }
        if kind == VK_LOAD {
            let addr = lower_vector_address(cx, child(n, 0), child(n, 1), vt);
            return vec_result(cx, ir_load(cx, vt, addr, 0), vt);
        }
        let a = vec_operand(cx, NODES[n].a);
        if kind == VK_STORE {
            let addr = lower_vector_address(cx, child(n, 0), child(n, 1), vt);
            ir_store(cx, vt, addr, a, 0);
            return 0;
        }
        if kind == VK_SUM {
            return emit_ir(cx, Op::VSum, ir_type(elem), a, 0, 0);
        }
        if kind == VK_SELECT {
            let x = vec_operand(cx, child(n, 0));
            let y = vec_operand(cx, child(n, 1));
            let ty = NODES[child(n, 0)].ty;
            let v = emit_ir(cx, Op::VSel, ty, a, x, 0);
            cx.insts[v].c = y;
            return vec_result(cx, v, ty);
        }
        let idx = lower_lane_index(cx, child(n, 0), vt);
        let lane = const_lane(cx, idx);
        if kind == VK_LANE {
            if lane >= 0 {
                return emit_ir(cx, Op::VExt, ir_type(elem), a, 0, lane);
            }
            let base = vec_result(cx, a, vt);
            let at = ir_binary(cx, Op::Add, TY_U64, base,
                ir_binary(cx, Op::Mul, TY_U64, idx, ir_const(cx, esize, TY_U64)));
            return ir_load(cx, ir_type(elem), at, 0);
        }
        // VK_WITH
        let x = lower_operand(cx, child(n, 1));
        if lane >= 0 {
            return vec_result(cx, emit_ir(cx, Op::VIns, vt, a, x, lane), vt);
        }
        let base = vec_result(cx, a, vt);
        let at = ir_binary(cx, Op::Add, TY_U64, base,
            ir_binary(cx, Op::Mul, TY_U64, idx, ir_const(cx, esize, TY_U64)));
        ir_store(cx, ir_type(elem), at, x, 0);
        base
    }
}
