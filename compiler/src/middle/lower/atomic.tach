// (0.21) std's atomic intrinsics (compiler/std/atomic.tach) lowered to
// ATOMIC and FENCE instructions (docs/design/concurrency.md §4.1): a call of
// `std::atomic_add::<T>(p, v, order)` is one ATOMIC of T's width, its
// ordering the literal `order` (SeqCst when it is not a constant, or not
// one the kind can have). At -O0 the intrinsics are functions whose bodies
// gen0 writes (gen0/gen/atomic.tach); their tachyon bodies only panic.

use crate::base::SYMS;
use crate::front::ast::{NODES, child};
use crate::front::effects::infer::template_of;
use crate::front::modules::{STD_MODULE, within_std};
use crate::front::types::{FNS, fn_param, is_signed};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Op, emit_ir, ir_type};
use crate::middle::ir::atomic::{
    ATOMIC_ADD, ATOMIC_AND, ATOMIC_CAS, ATOMIC_LOAD, ATOMIC_NAND, ATOMIC_OR, ATOMIC_SMAX,
    ATOMIC_SMIN, ATOMIC_STORE, ATOMIC_SUB, ATOMIC_SWAP, ATOMIC_UMAX, ATOMIC_UMIN, ATOMIC_XOR,
    FENCE_COMPILER, ORD_SEQCST, legal_order,
};
use crate::middle::lower::expr::{lower_expr, need_value};

// The codes of the intrinsics that are not an ATOMIC kind.
pub const INTR_FENCE: i64 = 100;
pub const INTR_COMPILER_FENCE: i64 = 101;
// atomic_max and atomic_min: SMAX or UMAX (SMIN, UMIN) by T.
const INTR_MAX: i64 = 102;
const INTR_MIN: i64 = 103;

// The intrinsic named `text` (a std symbol, `std.sync.atomic.atomic_add`):
// an ATOMIC kind, INTR_*, or -1.
fn intrinsic_code(text: [u8]) -> i64 {
    let mut k = text.len;
    while k > 0 && text[k - 1] != '.' {
        k -= 1;
    }
    let name = text[k..];
    if name.len < 8 || name[0..7] != "atomic_" {
        return -1;
    }
    let rest = name[7..];
    if rest == "load" { ATOMIC_LOAD } else if rest == "store" { ATOMIC_STORE }
    else if rest == "swap" { ATOMIC_SWAP } else if rest == "cas" { ATOMIC_CAS }
    else if rest == "add" { ATOMIC_ADD } else if rest == "sub" { ATOMIC_SUB }
    else if rest == "and" { ATOMIC_AND } else if rest == "nand" { ATOMIC_NAND }
    else if rest == "or" { ATOMIC_OR } else if rest == "xor" { ATOMIC_XOR }
    else if rest == "max" { INTR_MAX } else if rest == "min" { INTR_MIN }
    else if rest == "fence" { INTR_FENCE } else if rest == "compiler_fence" { INTR_COMPILER_FENCE }
    else { -1 }
}

// The intrinsic function f is (an instance of): its ATOMIC kind (max and
// min resolved by T's signedness), INTR_FENCE, INTR_COMPILER_FENCE, or -1.
pub fn atomic_intrinsic(f: i64) -> i64 {
    unsafe {
        if f < 0 {
            return -1;
        }
        let t = template_of(f);
        if !within_std(FNS[t].module) {
            return -1;
        }
        let code = intrinsic_code(SYMS[FNS[t].name].text);
        if code == INTR_MAX || code == INTR_MIN {
            let signed = is_signed(fn_param(f, 1));
            if code == INTR_MAX {
                return if signed { ATOMIC_SMAX } else { ATOMIC_UMAX };
            }
            return if signed { ATOMIC_SMIN } else { ATOMIC_UMIN };
        }
        code
    }
}

// The value type of intrinsic f with code `code` (an ATOMIC kind): T.
pub fn atomic_value_type(f: i64, code: i64) -> i64 {
    unsafe {
        if code == ATOMIC_LOAD { FNS[f].ret } else { fn_param(f, 1) }
    }
}

// The index of the ordering among the arguments of an intrinsic.
pub fn order_arg(code: i64) -> i64 {
    if code == INTR_FENCE || code == INTR_COMPILER_FENCE {
        0
    } else if code == ATOMIC_LOAD {
        1
    } else if code == ATOMIC_CAS {
        3
    } else {
        2
    }
}

// Call n of intrinsic f (code `code`) as an ATOMIC or a FENCE; its value.
pub fn lower_atomic_call(mut cx: *FnCtx, n: i64, f: i64, code: i64) -> i64 {
    unsafe {
        let count = NODES[n].count;
        let mut vals: [i64; 4] = [0; 4];
        for i in 0..count {
            let arg = child(n, i);
            vals[i] = need_value(cx, lower_expr(cx, arg), NODES[arg].ty);
        }
        let ov = vals[order_arg(code)];
        let mut order = if cx.insts[ov].op == Op::Const { cx.insts[ov].imm } else { ORD_SEQCST };
        if code == INTR_FENCE || code == INTR_COMPILER_FENCE {
            if order < 1 || order > ORD_SEQCST {
                order = ORD_SEQCST;
            }
            let flag = if code == INTR_COMPILER_FENCE { FENCE_COMPILER } else { 0 };
            emit_ir(cx, Op::Fence, 0, 0, 0, order | flag);
            return 0;
        }
        order = legal_order(code, order);
        let ty = ir_type(atomic_value_type(f, code));
        let result_ty = if code == ATOMIC_STORE { 0 } else { ty };
        let mut b = 0;
        let mut c = 0;
        if code == ATOMIC_CAS {
            b = vals[2];
            c = vals[1];
        } else if code != ATOMIC_LOAD {
            b = vals[1];
        }
        let v = emit_ir(cx, Op::Atomic, result_ty, vals[0], b, code | (order << 8));
        cx.insts[v].c = c;
        cx.insts[v].imm2 = ty;
        if result_ty == 0 { 0 } else { v }
    }
}
