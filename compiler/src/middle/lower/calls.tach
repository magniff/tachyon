// Lowering calls (arguments as the callee's convention takes them, compound
// results through a result pointer) and the run-time checks: the branch to
// a panic when a check fails, panics, and with --check-unsafe the checks of
// raw-pointer accesses.

use crate::back::abi::{
    ABI_PIECE_COUNT, ABI_PIECE_OFFSET, ABI_PIECE_TY, AbiClass, conv_classify,
    conv_returns_through_pointer, fn_type_uses_c, fn_uses_c, variadic_kind,
};
use crate::base::intern_c;
use crate::base::target::X86;
use crate::front::ast::{NODES, NODE_RAW, child};
use crate::front::modules::STD_MODULE;
use crate::front::types::{
    FNS, TYPES, TY_F32, TY_F64, TY_I64, TY_U64, TY_U8_PTR, fn_param, is_compound, is_void,
    scalar_type, type_elem, type_size,
};
use crate::gen0::target::{PANIC_USED, rt_panic_sym};
use crate::middle::checkalloc::site_before_call;
use crate::middle::ir::{
    ARGS, ARGTY, BITS_LEADING, BITS_ONES, BITS_TRAILING, CUR, INSTS, IRF, IRFUNCS, Op, Term,
    VARIADIC_PIECE, emit_ir, ir_const, ir_load, ir_new_block, ir_slot_addr, ir_store, ir_type,
};
use crate::middle::ir::cfg::ir_terminate;
use crate::middle::lower::{is_fresh, lower_branch, lower_copy, new_slot_for, start_dead_block};
use crate::middle::lower::expr::{ir_conv, lower_expr, lower_operand, need_value};
use crate::middle::lower::ssa::{SSA_STACK, ir_seal};
use crate::middle::profile::PROFILE_MODULE;
use crate::middle::unsafecheck::{
    CHECK_MODULE, CHECK_UNSAFE, check_function, redirect_alloc, site_string,
};

// ---- Calls ----

pub fn push_arg(value: i64, ty: i64) {
    SSA_STACK.push(value);
    SSA_STACK.push(ty);
}

// Moves the arguments pushed since `mark` into call `call`.
pub fn take_args(call: i64, mark: i64) {
    unsafe {
        let count = (SSA_STACK.count - mark) / 2;
        INSTS[call].args = ARGS.count;
        INSTS[call].nargs = count;
        for i in 0..count {
            ARGS.push(SSA_STACK.data[mark + 2 * i]);
            ARGTY.push(SSA_STACK.data[mark + 2 * i + 1]);
        }
        SSA_STACK.count = mark;
    }
}

// (0.16) The count std's function f makes (BITS_ONES, BITS_LEADING,
// BITS_TRAILING) when its call is a BITS instruction here, else -1:
// count_ones, leading_zeros and trailing_zeros, on AArch64.
fn bits_kind(f: i64) -> i64 {
    unsafe {
        if X86 || f < 0 || FNS[f].module != STD_MODULE || FNS[f].param_count != 1 {
            return -1;
        }
        let name = FNS[f].name;
        if name == intern_c(c"std.count_ones") {
            return BITS_ONES;
        }
        if name == intern_c(c"std.leading_zeros") {
            return BITS_LEADING;
        }
        if name == intern_c(c"std.trailing_zeros") {
            return BITS_TRAILING;
        }
        -1
    }
}

pub fn lower_call(n: i64) -> i64 {
    unsafe {
        let callee = NODES[n].a;
        // (0.16: --check-alloc's allocation site)
        site_before_call(n);
        // (--check-unsafe: malloc and the like go through the runtime)
        let direct = redirect_alloc(NODES[n].x - 1, FNS[IRFUNCS[IRF].f].module);
        let kind = bits_kind(direct);
        if kind >= 0 {
            let x = need_value(lower_expr(child(n, 0)), TY_U64);
            return emit_ir(Op::Bits, TY_I64, x, 0, kind);
        }
        let mut param_count = 0;
        let mut ret = 0;
        let mut variadic = false;
        let mut callee_ty = 0;
        let mut c = true;
        if direct >= 0 {
            param_count = FNS[direct].param_count;
            ret = FNS[direct].ret;
            variadic = FNS[direct].variadic;
            c = fn_uses_c(direct);
        } else {
            callee_ty = NODES[callee].ty;
            param_count = TYPES[callee_ty].count;
            ret = TYPES[callee_ty].a;
            c = fn_type_uses_c(callee_ty);
        }
        let mark = SSA_STACK.count;
        for i in 0..NODES[n].count {
            let arg = child(n, i);
            let mut ty = NODES[arg].ty;
            if i < param_count {
                ty = if direct >= 0 { fn_param(direct, i) } else { type_elem(callee_ty, i) };
            }
            let mut value = lower_expr(arg);
            if is_void(ty) {
                continue;
            }
            value = need_value(value, ty);
            let extra = variadic && i >= param_count;
            if is_compound(ty) {
                if !is_fresh(arg) {
                    let copy = ir_slot_addr(new_slot_for(ty));
                    lower_copy(copy, value, type_size(ty));
                    value = copy;
                }
                let kind = if extra { variadic_kind(ty) } else { conv_classify(c, ty) };
                if kind == AbiClass::Pieces {
                    // Its pieces, read from the (new) slot; a variadic one's
                    // first piece carries its type (see call_locations).
                    for k in 0..ABI_PIECE_COUNT {
                        let piece = ir_load(ABI_PIECE_TY[k], value, ABI_PIECE_OFFSET[k]);
                        let mut arg_ty = ABI_PIECE_TY[k];
                        if extra {
                            arg_ty = if k == 0 { 0 - ty } else { VARIADIC_PIECE };
                        }
                        push_arg(piece, arg_ty);
                    }
                    continue;
                }
                push_arg(value, if extra { 0 - ty } else { ty });
                continue;
            }
            if extra && ty == TY_F32 {
                // C's default promotion.
                value = ir_conv(value, TY_F32, TY_F64);
                ty = TY_F64;
            }
            let arg_ty = scalar_type(ty);
            push_arg(value, if extra { 0 - arg_ty } else { arg_ty });
        }
        let mut callee_value = 0;
        if direct < 0 {
            callee_value = lower_operand(callee);
        }
        let mut result_ptr = 0;
        if is_compound(ret) {
            result_ptr = ir_slot_addr(new_slot_for(ret));
        }
        let result_ty = if is_compound(ret) { 0 } else { ir_type(ret) };
        let mut call = 0;
        if direct >= 0 {
            call = emit_ir(Op::Call, result_ty, 0, 0, direct);
        } else {
            call = emit_ir(Op::CallI, result_ty, callee_value, 0, callee_ty);
        }
        let in_registers = is_compound(ret) && !conv_returns_through_pointer(c, ret);
        INSTS[call].c = if in_registers { 0 } else { result_ptr };
        take_args(call, mark);
        if in_registers {
            // Its pieces, from the result registers (PIECE instructions right
            // after the call), stored into the result's slot.
            conv_classify(c, ret);
            let count = ABI_PIECE_COUNT;
            let mut pieces: [i64; 4] = [0; 4];
            for k in 0..count {
                pieces[k] = emit_ir(Op::Piece, ABI_PIECE_TY[k], call, 0, k);
            }
            for k in 0..count {
                ir_store(ABI_PIECE_TY[k], result_ptr, pieces[k], ABI_PIECE_OFFSET[k]);
            }
        }
        if is_compound(ret) {
            return result_ptr;
        }
        if result_ty == 0 {
            return 0;
        }
        call
    }
}

// ---- Checks ----

// Continues when `ok` holds; otherwise calls the run-time helper (see
// emit_panic) with kind, a, b and c, which does not return.
pub fn lower_check(ok: i64, kind: i64, a: i64, b: i64, c: i64) {
    PANIC_USED = true;
    let pass = ir_new_block();
    let fail = ir_new_block();
    lower_branch(ok, pass, fail);
    ir_seal(fail);
    CUR = fail;
    let mark = SSA_STACK.count;
    push_arg(ir_const(kind, TY_U64), TY_U64);
    push_arg(a, TY_U64);
    push_arg(b, TY_U64);
    push_arg(if c != 0 { c } else { ir_const(0, TY_U64) }, TY_U64);
    let call = emit_ir(Op::CallC, 0, 0, 0, rt_panic_sym());
    take_args(call, mark);
    ir_terminate(CUR, Term::Unreach, 0, 0, 0);
    ir_seal(pass);
    CUR = pass;
}

// A failed `n as E`: the run-time helper with the value; does not return.
pub fn lower_panic(kind: i64, a: i64) {
    PANIC_USED = true;
    let mark = SSA_STACK.count;
    push_arg(ir_const(kind, TY_U64), TY_U64);
    push_arg(a, TY_U64);
    push_arg(ir_const(0, TY_U64), TY_U64);
    push_arg(ir_const(0, TY_U64), TY_U64);
    let call = emit_ir(Op::CallC, 0, 0, 0, rt_panic_sym());
    take_args(call, mark);
    ir_terminate(CUR, Term::Unreach, 0, 0, 0);
    start_dead_block();
}

// ---- The checking mode (0.10) ----

// With --check-unsafe: the check of `size` bytes (an IR value) at addr,
// for the raw-pointer access n.
pub fn raw_check(n: i64, addr: i64, size: i64) {
    unsafe {
        let m = FNS[IRFUNCS[IRF].f].module;
        if !CHECK_UNSAFE || (NODES[n].p & NODE_RAW) == 0 || m == CHECK_MODULE
            || m == PROFILE_MODULE {
            return;
        }
        let f = check_function();
        if f < 0 {
            return;
        }
        let mark = SSA_STACK.count;
        push_arg(addr, TY_U64);
        push_arg(size, TY_U64);
        push_arg(emit_ir(Op::SAddr, TY_U64, 0, 0, site_string(NODES[n].start)), TY_U8_PTR);
        let call = emit_ir(Op::Call, 0, 0, 0, f);
        take_args(call, mark);
    }
}
