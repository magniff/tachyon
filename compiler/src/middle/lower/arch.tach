// Lowering the calls of std::arch's intrinsics (0.19, docs/design/arch.md
// §5.1): by the table's IR form, so that the optimizer sees them.
//
//   vbin.OP vcmp.C vsplat vext  0.10's vector operation (on the `work`
//                               type when the signature's are others:
//                               x86's __m128i), with casts around it
//   cast                        a register-preserving CONV
//   load, store                 the slice's bounds check, then a LOAD or a
//                               STORE of the vector
//   bits.K                      BITS on AArch64; elsewhere the call of its
//                               body (std's function)
//   feat                        a constant where the feature is known or
//                               foreign, else CPUFEAT (expanded late)
//   intr                        INTR: its register parameters as a, b, c,
//                               its immediates in imm2
// An intrinsic of another architecture is never generated: its call is
// dead code (under a constant-false has/detect), lowered as unreachable.
// It reads the tables and the front end's notes only (read-only once the
// front end is done).

use crate::arch::{
    FORM_BITS, FORM_CAST, FORM_FEAT, FORM_INTR, FORM_LOAD, FORM_LOAD_DUP, FORM_STORE, FORM_VBIN,
    FORM_VCMP, FORM_VEXT, FORM_VINS, FORM_VNEG, FORM_VSEL, FORM_VSPLAT, FORM_VSUM, INTRS,
    intr_param_is_const, intr_with_imm, intrinsic_is_foreign,
};
use crate::base::die;
use crate::base::target::X86;
use crate::front::ast::{NODES, child};
use crate::front::consteval::const_eval;
use crate::front::contracts::sites::site_of;
use crate::front::features::{feature_call_bit, feature_call_value};
use crate::front::types::{
    FNS, SYM_PRIMITIVE, TYPES, TY_BOOL, TY_I64, TY_U64, is_compound, is_vector, is_void, type_size,
};
use crate::gen0::target::PANIC_RANGE_SIGNED;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    CUR, Cond, Op, Term, emit_ir, ir_binary, ir_cmp, ir_const, ir_load, ir_slot_addr, ir_store,
    ir_type,
};
use crate::middle::ir::cfg::ir_terminate;
use crate::middle::lower::{new_slot_for, start_dead_block};
use crate::middle::lower::calls::lower_check;
use crate::middle::lower::expr::{lower_operand, need_value};
use crate::middle::lower::vector::{lower_elements, vec_operand, vec_result};

// lower_intrinsic's answer for a call it leaves to lower_call (a bits.*
// intrinsic where its body is called).
pub const NOT_LOWERED: i64 = -1;

// Call n of intrinsic id (its declaration is function f): its value (an
// address for a vector), or NOT_LOWERED.
pub fn lower_intrinsic(mut cx: *FnCtx, n: i64, f: i64, id: i64) -> i64 {
    unsafe {
        let ret = FNS[f].ret;
        let form = INTRS[id].form;
        if intrinsic_is_foreign(id) {
            ir_terminate(cx, CUR, Term::Unreach, 0, 0, 0);
            start_dead_block(cx);
            return placeholder(cx, ret);
        }
        if form == FORM_FEAT {
            let value = feature_call_value(n);
            if value >= 0 {
                return ir_const(cx, value, TY_BOOL);
            }
            return emit_ir(cx, Op::CpuFeat, TY_BOOL, 0, 0, feature_call_bit(n));
        }
        if form == FORM_BITS {
            if X86 {
                return NOT_LOWERED;
            }
            let x = need_value(cx, lower_operand(cx, child(n, 0)), TY_U64);
            return emit_ir(cx, Op::Bits, TY_I64, x, 0, INTRS[id].form_arg);
        }
        if (form == FORM_LOAD || form == FORM_STORE) && FNS[f].param_count < INTRS[id].nparams {
            // (0.19 T1) a raw:: pointer form: the pointer, then the vector
            // to store
            let p = lower_operand(cx, child(n, INTRS[id].mem_param));
            if form == FORM_LOAD {
                return vec_result(cx, ir_load(cx, ret, p, 0), ret);
            }
            let v_arg = child(n, INTRS[id].mem_param + 1);
            ir_store(cx, NODES[v_arg].ty, p, vec_operand(cx, v_arg), 0);
            return 0;
        }
        if form == FORM_LOAD {
            let addr = memory_address(cx, n, id);
            return vec_result(cx, ir_load(cx, ret, addr, 0), ret);
        }
        if form == FORM_STORE {
            // (s, i, then the vector: the arguments' order)
            let s = INTRS[id].mem_param;
            let value = lower_operand(cx, child(n, s));
            let idx = lower_operand(cx, child(n, s + 1));
            let v_arg = child(n, s + 2);
            let v = vec_operand(cx, v_arg);
            let addr = checked_address(cx, NODES[child(n, s)].ty, value, idx,
                INTRS[id].mem_bytes, site_of(child(n, s + 1), 0));
            ir_store(cx, NODES[v_arg].ty, addr, v, 0);
            return 0;
        }
        if form == FORM_LOAD_DUP {
            // (T6) one element, checked (or at a raw:: pointer), splat
            let elem = TYPES[ret].a;
            let mut addr = 0;
            if FNS[f].param_count < INTRS[id].nparams {
                addr = lower_operand(cx, child(n, INTRS[id].mem_param));
            } else {
                addr = memory_address(cx, n, id);
            }
            let x = ir_load(cx, elem, addr, 0);
            return vec_result(cx, emit_ir(cx, Op::VSplat, ret, x, 0, 0), ret);
        }
        if form == FORM_VNEG {
            let v = emit_ir(cx, Op::VNeg, ret, vec_operand(cx, child(n, 0)), 0, 0);
            return vec_result(cx, v, ret);
        }
        if form == FORM_VSUM {
            return emit_ir(cx, Op::VSum, ir_type(ret), vec_operand(cx, child(n, 0)), 0, 0);
        }
        if form == FORM_VINS {
            // (x, v, lane)
            let ex = child(n, 0);
            let x = need_value(cx, lower_operand(cx, ex), NODES[ex].ty);
            let v = vec_operand(cx, child(n, 1));
            let lane = const_eval(child(n, 2));
            return vec_result(cx, emit_ir(cx, Op::VIns, ret, v, x, lane), ret);
        }
        if form == FORM_VSEL {
            // (mask a, b, c): b's bits where a's are set, c's elsewhere
            let em = child(n, 0);
            let m = as_type(cx, vec_operand(cx, em), NODES[em].ty, ret);
            let b = vec_operand(cx, child(n, 1));
            let c = vec_operand(cx, child(n, 2));
            let v = emit_ir(cx, Op::VSel, ret, m, b, 0);
            cx.insts[v].c = c;
            return vec_result(cx, v, ret);
        }
        if form == FORM_CAST {
            let e = child(n, 0);
            let v = vec_operand(cx, e);
            return vec_result(cx, as_type(cx, v, NODES[e].ty, ret), ret);
        }
        let work = work_type(id, ret);
        if form == FORM_VSPLAT {
            let x = lower_operand(cx, child(n, 0));
            let v = emit_ir(cx, Op::VSplat, work, x, 0, 0);
            return vec_result(cx, as_type(cx, v, work, ret), ret);
        }
        if form == FORM_VEXT {
            let e = child(n, 0);
            let a = vec_operand(cx, e);
            let lane = const_eval(child(n, 1));
            return emit_ir(cx, Op::VExt, ir_type(ret), a, 0, lane);
        }
        if form == FORM_VBIN || form == FORM_VCMP {
            let ea = child(n, 0);
            let eb = child(n, 1);
            let va = vec_operand(cx, ea);
            let a = as_type(cx, va, NODES[ea].ty, work);
            let vb = vec_operand(cx, eb);
            let b = as_type(cx, vb, NODES[eb].ty, work);
            let mut v = 0;
            if form == FORM_VBIN {
                v = emit_ir(cx, Op::VBin, work, a, b, INTRS[id].form_arg);
            } else {
                v = emit_ir(cx, Op::VCmp, work, a, b, 0);
                let raw = INTRS[id].form_arg;
                cx.insts[v].cond = raw as Cond;
                cx.insts[v].imm2 = work;
            }
            return vec_result(cx, as_type(cx, v, work, ret), ret);
        }
        if form != FORM_INTR {
            die(c"internal error: an intrinsic of a form not lowered yet (0.19 Phase 0)");
        }
        // INTR: the register parameters in order, the immediates packed.
        let mut operands: [i64; 3] = [0, 0, 0];
        let mut count = 0;
        let mut imm2 = 0;
        let mut ci = 0;
        for k in 0..INTRS[id].nparams {
            let e = child(n, k);
            if intr_param_is_const(id, k) {
                imm2 = intr_with_imm(imm2, ci, const_eval(e));
                ci += 1;
                continue;
            }
            if count == 3 {
                die(c"internal error: an INTR of more than three register operands");
            }
            let ty = NODES[e].ty;
            operands[count] = if is_vector(ty) { vec_operand(cx, e) }
                else { need_value(cx, lower_operand(cx, e), ty) };
            count += 1;
        }
        let rt = if is_void(ret) { 0 } else { ir_type(ret) };
        let v = emit_ir(cx, Op::Intr, rt, operands[0], operands[1], id);
        cx.insts[v].c = operands[2];
        cx.insts[v].imm2 = imm2;
        if is_compound(ret) {
            return vec_result(cx, v, ret);
        }
        v
    }
}

// The type a generic form computes in: the table's `work` (x86's
// `vcmp.eq:v16i8`), else the result's.
fn work_type(id: i64, ret: i64) -> i64 {
    unsafe {
        let w = INTRS[id].work;
        if w != 0 {
            return SYM_PRIMITIVE[w];
        }
        ret
    }
}

// Vector v of type `from` as type `to` (the same bits).
fn as_type(mut cx: *FnCtx, v: i64, from: i64, to: i64) -> i64 {
    if from == to {
        return v;
    }
    let c = emit_ir(cx, Op::Conv, to, v, 0, 0);
    unsafe { cx.insts[c].imm2 = from; }
    c
}

// What a dead call yields: an unused slot's address for a compound
// result, a zero for a scalar one.
fn placeholder(mut cx: *FnCtx, ret: i64) -> i64 {
    if is_void(ret) {
        return 0;
    }
    if is_compound(ret) {
        let s = new_slot_for(cx, ret);
        return ir_slot_addr(cx, s);
    }
    ir_const(cx, 0, ir_type(ret))
}

// The checked address of a memory form's bytes: its slice parameter and
// the index after it.
fn memory_address(mut cx: *FnCtx, n: i64, id: i64) -> i64 {
    unsafe {
        let s = INTRS[id].mem_param;
        let value = lower_operand(cx, child(n, s));
        let idx = lower_operand(cx, child(n, s + 1));
        checked_address(cx, NODES[child(n, s)].ty, value, idx, INTRS[id].mem_bytes,
            site_of(child(n, s + 1), 0))
    }
}

// The address of element idx of the slice (or array) of type ty at
// `value`, checked that `bytes` bytes from it are in it: as 0.10's
// v.load(s, i), `0 <= idx` and `idx + bytes / elem <= len`.
fn checked_address(mut cx: *FnCtx, ty: i64, value: i64, idx: i64, bytes: i64, site: i64 = 0) -> i64 {
    let mut len = 0;
    let base = lower_elements(cx, ty, value, &mut len);
    let esize = unsafe { type_size(TYPES[ty].a) };
    let count = bytes / esize;
    let end = ir_binary(cx, Op::Add, TY_I64, idx, ir_const(cx, count, TY_I64));
    let room = ir_binary(cx, Op::Sub, TY_I64, len, ir_const(cx, count, TY_I64));
    lower_check(cx, ir_cmp(cx, Cond::Le, TY_I64, idx, room), PANIC_RANGE_SIGNED, idx, end, len,
        site);
    lower_check(cx, ir_cmp(cx, Cond::Ge, TY_I64, idx, ir_const(cx, 0, TY_I64)),
        PANIC_RANGE_SIGNED, idx, end, len, site);
    let scale = ir_binary(cx, Op::Mul, TY_U64, idx, ir_const(cx, esize, TY_U64));
    ir_binary(cx, Op::Add, TY_U64, base, scale)
}
