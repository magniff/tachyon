// SSA construction during lowering (Braun et al., see mod.tach): the
// current definition of each variable in each block, phis made on reads
// in unsealed blocks and completed when the block is sealed, trivial phis
// removed. Also HMap, the hash map the definitions are kept in (used by
// other passes too).

use crate::base::{alloc_array, free, memset};
use crate::front::check::{LOCALS, LOCAL_COUNT};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{IRFUNCS, Op, ir_arg, ir_make, ir_prepend, ir_replace, ir_type, ir_val};

// An open-addressing hash map from i64 keys (never 0) to i64 values.
pub struct HMap { keys: *i64, vals: *i64, size: i64, count: i64 }

impl HMap {
    fn slot(self: *HMap, key: i64) -> i64 {
        let mask = (*self).size - 1;
        let mut slot = ((key as u64 * 11400714819323198485) >> 20) as i64 & mask;
        while unsafe { (*self).keys[slot] != 0 && (*self).keys[slot] != key } {
            slot = (slot + 1) & mask;
        }
        slot
    }

    fn get(self: *HMap, key: i64) -> i64 {
        unsafe {
            if (*self).size == 0 {
                return 0;
            }
            let slot = self.slot(key);
            if (*self).keys[slot] == key { (*self).vals[slot] } else { 0 }
        }
    }

    fn put(self: *HMap, key: i64, value: i64) {
        unsafe {
            if ((*self).count + 1) * 2 > (*self).size {
                self.rehash();
            }
            let slot = self.slot(key);
            if (*self).keys[slot] == 0 {
                (*self).count += 1;
                (*self).keys[slot] = key;
            }
            (*self).vals[slot] = value;
        }
    }

    fn rehash(self: *HMap) {
        unsafe {
            let old_keys = (*self).keys;
            let old_vals = (*self).vals;
            let old_size = (*self).size;
            let mut size = old_size * 2;
            if size < 256 {
                size = 256;
            }
            (*self).keys = alloc_array::<i64>(size);
            (*self).vals = alloc_array::<i64>(size);
            (*self).size = size;
            (*self).count = 0;
            for i in 0..old_size {
                if old_keys[i] != 0 {
                    self.put(old_keys[i], old_vals[i]);
                }
            }
            if old_size > 0 {
                free(old_keys as *u8);
                free(old_vals as *u8);
            }
        }
    }

    fn clear(self: *HMap) {
        if (*self).size > 0 {
            unsafe { memset((*self).keys as *u8, 0, ((*self).size * 8) as u64); }
        }
        (*self).count = 0;
    }
}

// ---- SSA construction ----

// Per local: whether it is an SSA variable, and the address of its
// storage otherwise.
pub static mut PROMOTE: *i64 = 0 as *i64;
pub static mut LOCAL_ADDR: *i64 = 0 as *i64;

fn def_key(var: i64, b: i64) -> i64 {
    ((var + 1) << 32) | b
}

fn var_type(mut cx: *FnCtx, var: i64) -> i64 {
    unsafe {
        if var < LOCAL_COUNT {
            return ir_type(LOCALS[var].ty);
        }
        cx.synth_ty.data[var - LOCAL_COUNT]
    }
}

pub fn new_synth_var(mut cx: *FnCtx, ty: i64) -> i64 {
    unsafe {
        cx.synth_ty.push(ty);
        LOCAL_COUNT + cx.synth_ty.count - 1
    }
}

pub fn ssa_write(mut cx: *FnCtx, var: i64, b: i64, value: i64) {
    unsafe { cx.defs.put(def_key(var, b), value); }
}

pub fn ssa_read(mut cx: *FnCtx, var: i64, b: i64) -> i64 {
    let v = unsafe { cx.defs.get(def_key(var, b)) };
    if v != 0 {
        return ir_val(cx, v);
    }
    ssa_read_recursive(cx, var, b)
}

// An undefined value of type `ty`: 0, placed in the entry block.
pub fn ssa_undef(mut cx: *FnCtx, ty: i64) -> i64 {
    let v = ir_make(cx, Op::Const, ty, 0, 0, 0);
    unsafe { ir_prepend(cx, IRFUNCS[cx.irf].entry, v); }
    v
}

fn new_phi(mut cx: *FnCtx, var: i64, b: i64) -> i64 {
    let phi = ir_make(cx, Op::Phi, var_type(cx, var), 0, 0, 0);
    ir_prepend(cx, b, phi);
    phi
}

fn ssa_read_recursive(mut cx: *FnCtx, var: i64, b: i64) -> i64 {
    unsafe {
        let mut value = 0;
        let preds = cx.blocks[b].preds.count;
        if cx.blocks[b].sealed == 0 {
            value = new_phi(cx, var, b);
            cx.incomplete.push(var);
            cx.incomplete.push(value);
            cx.incomplete.push(cx.blocks[b].incomplete);
            cx.blocks[b].incomplete = cx.incomplete.count / 3;
        } else if preds == 1 {
            value = ssa_read(cx, var, cx.blocks[b].preds.data[0]);
        } else if preds == 0 {
            value = ssa_undef(cx, var_type(cx, var));
        } else {
            let phi = new_phi(cx, var, b);
            ssa_write(cx, var, b, phi);
            value = add_phi_operands(cx, var, phi);
        }
        ssa_write(cx, var, b, value);
        value
    }
}

fn add_phi_operands(mut cx: *FnCtx, var: i64, phi: i64) -> i64 {
    unsafe {
        let b = cx.insts[phi].block;
        let mark = cx.ssa_stack.count;
        for i in 0..cx.blocks[b].preds.count {
            let pred = cx.blocks[b].preds.data[i];
            let value = ssa_read(cx, var, pred);
            cx.ssa_stack.push(value);
        }
        let count = cx.ssa_stack.count - mark;
        cx.insts[phi].args = cx.args.count;
        cx.insts[phi].nargs = count;
        for i in 0..count {
            cx.args.push(cx.ssa_stack.data[mark + i]);
            cx.argty.push(0);
        }
        cx.ssa_stack.count = mark;
        try_remove_trivial_phi(cx, phi)
    }
}

// A phi whose operands are all the same value (or itself) is that value.
fn try_remove_trivial_phi(mut cx: *FnCtx, phi: i64) -> i64 {
    unsafe {
        let mut same = 0;
        for i in 0..cx.insts[phi].nargs {
            let operand = ir_val(cx, ir_arg(cx, phi, i));
            if operand == same || operand == phi {
                continue;
            }
            if same != 0 {
                return phi;
            }
            same = operand;
        }
        if same == 0 {
            same = ssa_undef(cx, cx.insts[phi].ty);
        }
        ir_replace(cx, phi, same);
        same
    }
}

pub fn ir_seal(mut cx: *FnCtx, b: i64) {
    unsafe {
        let mut entry = cx.blocks[b].incomplete;
        while entry != 0 {
            let at = (entry - 1) * 3;
            let var = cx.incomplete.data[at];
            let phi = cx.incomplete.data[at + 1];
            add_phi_operands(cx, var, phi);
            entry = cx.incomplete.data[at + 2];
        }
        cx.blocks[b].incomplete = 0;
        cx.blocks[b].sealed = 1;
    }
}
