// Lowering control flow: `if`, `loop`, `while` and `for`, `break` and
// `continue`, and the joins that carry the value of an expression with
// several exits (if, match, loop) to where they meet.

use crate::base::IntVec;
use crate::front::ast::{NODES, defer_loop_depth, defer_loop_enter, defer_loop_leave};
use crate::front::ast::NodeKind::{Loop, While};
use crate::front::types::{TY_NEVER, is_compound, is_void, type_size};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    CUR, Cond, Op, ir_binary, ir_cmp, ir_const, ir_new_block, ir_slot_addr, ir_type,
};
use crate::middle::lower::{
    bind_pattern_ir, keep_value, lower_block, lower_branch, lower_copy, lower_defers, lower_jump,
    new_slot_for, start_dead_block,
};
use crate::middle::lower::expr::{lower_expr, lower_operand, need_value};
use crate::middle::lower::ssa::{ir_seal, new_synth_var, ssa_read, ssa_write};

// The value of an expression with several exits (if, match, loop): an SSA
// variable, or for a compound value of up to 128 bytes the address of a
// frame slot every exit copies its value into (which scalar replacement
// sees through), as JOIN_SLOT + the address.
const JOIN_SLOT: i64 = 1 << 40;

pub fn join_new(cx: sink *FnCtx, ty: i64) -> i64 {
    if is_compound(ty) && type_size(ty) <= 128 {
        return JOIN_SLOT + ir_slot_addr(cx, new_slot_for(cx, ty));
    }
    new_synth_var(cx, ir_type(ty))
}

pub fn join_write(cx: sink *FnCtx, join: i64, value: i64, ty: i64) {
    if join >= JOIN_SLOT {
        lower_copy(cx, join - JOIN_SLOT, need_value(cx, value, ty), type_size(ty));
    } else {
        ssa_write(cx, join, CUR, need_value(cx, value, ty));
    }
}

pub fn join_read(cx: sink *FnCtx, join: i64, b: i64) -> i64 {
    if join >= JOIN_SLOT { join - JOIN_SLOT } else { ssa_read(cx, join, b) }
}

pub fn lower_if(cx: sink *FnCtx, n: i64) -> i64 {
    unsafe {
        let ty = NODES[n].ty;
        let has_value = !is_void(ty);
        var result = 0;
        if has_value {
            result = join_new(cx, ty);
        }
        // (0.19: a constant has()/detect() condition: only the live branch
        // is generated, front/features)
        let fixed = crate::front::features::static_condition(NODES[n].a);
        if fixed >= 0 {
            let live = if fixed == 1 { NODES[n].b } else { NODES[n].c };
            let join = ir_new_block(cx);
            if live != 0 {
                lower_branch_body(cx, live, result, has_value, join);
            } else {
                lower_jump(cx, join);
            }
            ir_seal(cx, join);
            CUR = join;
            if has_value {
                return join_read(cx, result, join);
            }
            return 0;
        }
        let cond = lower_operand(cx, NODES[n].a);
        let then_block = ir_new_block(cx);
        var else_block = 0;
        if NODES[n].c != 0 {
            else_block = ir_new_block(cx);
        }
        let join = ir_new_block(cx);
        lower_branch(cx, cond, then_block, if else_block != 0 { else_block } else { join });
        ir_seal(cx, then_block);
        CUR = then_block;
        lower_branch_body(cx, NODES[n].b, result, has_value, join);
        if else_block != 0 {
            ir_seal(cx, else_block);
            CUR = else_block;
            lower_branch_body(cx, NODES[n].c, result, has_value, join);
        }
        ir_seal(cx, join);
        CUR = join;
        if has_value {
            return join_read(cx, result, join);
        }
        0
    }
}

fn lower_branch_body(cx: sink *FnCtx, block: i64, result: i64, has_value: bool, join: i64) {
    unsafe {
        let value = lower_block(cx, block);
        if has_value && NODES[block].ty != TY_NEVER {
            join_write(cx, result, value, NODES[block].ty);
        }
        lower_jump(cx, join);
    }
}

// Per loop (NODES[loop].z): continue block, exit block, break variable.
pub static var LOOP_INFO: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn new_loop_info(n: i64, continue_block: i64, exit: i64, break_var: i64) {
    unsafe { NODES[n].z = LOOP_INFO.count; }
    LOOP_INFO.push(continue_block);
    LOOP_INFO.push(exit);
    LOOP_INFO.push(break_var);
}

// `loop` and `while`.
pub fn lower_loop(cx: sink *FnCtx, n: i64) -> i64 {
    unsafe {
        let header = ir_new_block(cx);
        let exit = ir_new_block(cx);
        var break_var = -1;
        if NODES[n].kind == Loop && NODES[n].x != 0 && !is_void(NODES[n].y) {
            break_var = join_new(cx, NODES[n].y);
        }
        new_loop_info(n, header, exit, break_var);
        lower_jump(cx, header);
        CUR = header;
        if NODES[n].kind == While {
            let cond = lower_operand(cx, NODES[n].b);
            let body = ir_new_block(cx);
            lower_branch(cx, cond, body, exit);
            ir_seal(cx, body);
            CUR = body;
            defer_loop_enter(n);
            lower_block(cx, NODES[n].c);
        } else {
            defer_loop_enter(n);
            lower_block(cx, NODES[n].b);
        }
        defer_loop_leave();
        lower_jump(cx, header);
        ir_seal(cx, header);
        ir_seal(cx, exit);
        CUR = exit;
        if break_var >= 0 {
            return join_read(cx, break_var, exit);
        }
        0
    }
}

pub fn lower_break(cx: sink *FnCtx, n: i64) {
    unsafe {
        let info = NODES[NODES[n].x].z;
        let value = NODES[n].b;
        let break_var = LOOP_INFO.data[info + 2];
        let depth = defer_loop_depth(NODES[n].x);
        if value != 0 {
            let v = keep_value(cx, lower_expr(cx, value), NODES[value].ty, depth);
            if break_var >= 0 && NODES[value].ty != TY_NEVER {
                join_write(cx, break_var, v, NODES[value].ty);
            }
        }
        lower_defers(cx, depth);
        lower_jump(cx, LOOP_INFO.data[info + 1]);
        start_dead_block(cx);
    }
}

// `for i in a..b`: the bounds are evaluated once; the loop variable is a
// copy of the counter.
pub fn lower_for(cx: sink *FnCtx, n: i64) {
    unsafe {
        let range = NODES[n].c;
        let ty = NODES[range].ty;
        let inclusive = NODES[range].c != 0;
        let counter = new_synth_var(cx, ty);
        let start = lower_operand(cx, NODES[range].a);
        let end = lower_operand(cx, NODES[range].b);
        ssa_write(cx, counter, CUR, start);
        let test = ir_new_block(cx);
        let next = ir_new_block(cx);
        let exit = ir_new_block(cx);
        new_loop_info(n, next, exit, -1);
        lower_jump(cx, test);
        CUR = test;
        let value = ssa_read(cx, counter, test);
        let body = ir_new_block(cx);
        lower_branch(cx, ir_cmp(cx, if inclusive { Cond::Gt } else { Cond::Ge }, ty, value, end),
            exit, body);
        ir_seal(cx, body);
        CUR = body;
        bind_pattern_ir(cx, NODES[n].b, ssa_read(cx, counter, body), false);
        defer_loop_enter(n);
        lower_block(cx, NODES[n].d);
        defer_loop_leave();
        lower_jump(cx, next);
        ir_seal(cx, next);
        CUR = next;
        let current = ssa_read(cx, counter, next);
        if inclusive {
            let step = ir_new_block(cx);
            lower_branch(cx, ir_cmp(cx, Cond::Eq, ty, current, end), exit, step);
            ir_seal(cx, step);
            CUR = step;
        }
        ssa_write(cx, counter, CUR, ir_binary(cx, Op::Add, ty, current, ir_const(cx, 1, ty)));
        lower_jump(cx, test);
        ir_seal(cx, test);
        ir_seal(cx, exit);
        CUR = exit;
    }
}
