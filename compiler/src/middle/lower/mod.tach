// Lowering: the checked AST to the IR of ir.tach, building SSA form on
// the fly (Braun, Buchwald, Hack, Leißa, Mallon, Zwinkau: "Simple and
// Efficient Construction of Static Single Assignment Form", CC 2013).
//
// SSA variables are the scalar locals whose address is never taken (the
// others live in frame slots), and synthetic variables for the values of
// `if`, `&&`/`||`, `loop` with `break` values and loop counters. A block
// is sealed once all its predecessors are known; reading a variable in an
// unsealed block makes an incomplete phi, completed when the block is
// sealed. Structured control flow makes the sealing points obvious.
//
// Semantics are those of the 0.1 code generator (gen.tach): the same
// evaluation order, the same calling convention (compound arguments are
// passed as a pointer to a private copy, compound results through a
// result pointer), and the same arithmetic.

pub mod calls;
mod control;
mod expr;
mod matching;
pub mod ssa;
mod vector;
mod arch;

use ssa::{ssa_read, ssa_write};

use crate::arch::features::own_features;
use crate::back::abi::{AbiClass, conv_classify, conv_returns_through_pointer, fn_uses_c};
use crate::base::{alloc_array, intern_c};
use crate::base::target::X86;
use crate::front::ast::{DEFERS, DEFER_LOOPS, NODES, NODE_COUNT, NodeKind, PAT_DEREF, child};
use crate::front::ast::NodeKind::{
    Array, Call, Defer, Fn, Ident, Index, Let, PatBind, PatVariant, PatWild, Range, Repeat, Str,
    StructLit, Tuple, Unary, VariantLit,
};
use crate::front::check::{LOCALS, LOCAL_COUNT, Res};
use crate::front::features::fn_needs;
use crate::front::lexer::Tok;
use crate::front::patterns::binds_ref;
use crate::front::types::{
    FNS, TY_I64, TY_NEVER, TY_U64, align_to, fn_param, is_compound, is_vector, is_void,
    tuple_offset, type_align, type_elem, type_size, variant_field, variant_field_offset,
};
use crate::gen0::gen::MAIN_SYM;
use crate::gen0::gen::expr::arith_op_of_assign;
use crate::middle::copies::{moves_local, note_move_copies};
use crate::middle::ctx::FnCtx;
use crate::middle::entryfacts::lower_entry_facts;
use crate::middle::ir::{
    CUR, INLINE_COPY_MAX, IRFUNCS, IR_EXPR_LOC, IR_LOC, IR_LOCS, Op, Term, emit_ir, init_ir,
    ir_const, ir_enter, ir_load, ir_new_block, ir_new_func, ir_new_slot, ir_offset, ir_shrink,
    ir_slot_addr, ir_store, ir_type,
};
