use crate::middle::lower::vector::{arith_token_of, vector_assign_store, vector_assign_value};
use crate::middle::opt::OPT_LEVEL;

// ---- Blocks during lowering ----

// A block that no edge reaches (code after `return`, `break`, ...).
fn is_dead_block(cx: sink *FnCtx, b: i64) -> bool {
    unsafe {
        cx.blocks[b].sealed != 0 && cx.blocks[b].preds.count == 0 && b != IRFUNCS[cx.irf].entry
    }
}

fn start_dead_block(cx: sink *FnCtx) {
    let b = ir_new_block(cx);
    unsafe { cx.blocks[b].sealed = 1; }
    CUR = b;
}

// Ends the current block with a jump (no edge from a dead block).
fn lower_jump(cx: sink *FnCtx, target: i64) {
    if is_dead_block(cx, CUR) {
        ir_terminate(cx, CUR, Term::Unreach, 0, 0, 0);
    } else {
        ir_terminate(cx, CUR, Term::Jump, 0, target, 0);
    }
}

fn lower_branch(cx: sink *FnCtx, cond: i64, if_true: i64, if_false: i64) {
    if is_dead_block(cx, CUR) {
        ir_terminate(cx, CUR, Term::Unreach, 0, 0, 0);
    } else {
        ir_terminate(cx, CUR, Term::Branch, cond, if_true, if_false);
    }
}

// ---- The program ----

// Lowers every function to IR.
pub fn lower_program(cx: sink *FnCtx, program: i64) {
    unsafe {
        init_ir(cx);
        PROMOTE = alloc_array::<i64>(LOCAL_COUNT + 1);
        LOCAL_ADDR = alloc_array::<i64>(LOCAL_COUNT + 1);
        for local in 0..LOCAL_COUNT {
            let ty = LOCALS[local].ty;
            PROMOTE[local] = if is_void(ty) || is_compound(ty) { 0 } else { 1 };
        }
        // A local whose address is taken lives in memory.
        for n in 1..NODE_COUNT {
            if NODES[n].kind == Unary && NODES[n].op == Tok::Amp {
                let operand = NODES[n].b;
                if NODES[operand].kind == Ident && NODES[operand].res == Res::Local {
                    PROMOTE[NODES[operand].y] = 0;
                }
            }
        }
        for i in 0..NODES[program].count {
            let item = child(program, i);
            if NODES[item].kind == Fn {
                lower_function(cx, item);
            }
        }
    }
}

fn lower_function(cx: sink *FnCtx, item: i64) {
    unsafe {
        let f = NODES[item].x - 1;
        // (-g) The parameters and the frame come from the declaration.
        IR_LOC = if IR_LOCS { NODES[item].start + 1 } else { 0 };
        IR_EXPR_LOC = 0;
        ir_enter(cx, ir_new_func(cx, f, item));
        cx.defs.clear();
        DEFERS.count = 0;
        DEFER_LOOPS.count = 0;
        let entry = ir_new_block(cx);
        IRFUNCS[cx.irf].entry = entry;
        cx.blocks[entry].sealed = 1;
        CUR = entry;
        let ret = FNS[f].ret;
        let c = fn_uses_c(f);
        if conv_returns_through_pointer(cx, c, ret) {
            IRFUNCS[cx.irf].result_ptr = emit_ir(cx, Op::Param, TY_U64, 0, 0, -1);
        }
        for i in 0..FNS[f].param_count {
            let ty = fn_param(f, i);
            let local = NODES[child(item, i)].x;
            if is_void(ty) || local < 0 {
                continue;
            }
            let kind = conv_classify(cx, c, ty);
            if kind == AbiClass::Pieces {
                // Stored from the registers (or stack slots) of its pieces:
                // NodeKind::Param imm2 = the piece + 1.
                let slot = ir_slot_addr(cx, new_slot_for(cx, ty));
                for k in 0..cx.abi_piece_count {
                    let piece = emit_ir(cx, Op::Param, cx.abi_piece_ty[k], 0, 0, i);
                    cx.insts[piece].imm2 = k + 1;
                    ir_store(cx, cx.abi_piece_ty[k], slot, piece, cx.abi_piece_offset[k]);
                }
                bind_local(cx, local, slot, ty, true);
                continue;
            }
            let param = emit_ir(cx, Op::Param, ir_type(ty), 0, 0, i);
            if kind == AbiClass::Stack {
                // The address of the caller's copy on the stack.
                cx.insts[param].imm2 = -1;
            }
            // A compound parameter points to the caller's private copy.
            bind_local(cx, local, param, ty, true);
        }
        // (0.18.1) -O2: its checked requires as facts (middle::entryfacts)
        if OPT_LEVEL >= 2 {
            lower_entry_facts(cx, item, f);
        }
        let body = NODES[item].c;
        // (0.19) A function that needs another architecture's features is
        // never called (each call is dead code under a constant has/detect,
        // or an error): its body is not generated (docs/design/arch.md §2.4)
        if (fn_needs(f) & ~own_features()) != 0 {
            ir_terminate(cx, CUR, Term::Unreach, 0, 0, 0);
        } else {
            let value = lower_block(cx, body);
            if NODES[body].ty != TY_NEVER {
                lower_return(cx, value);
            }
        }
        if cx.blocks[CUR].term == Term::None {
            ir_terminate(cx, CUR, Term::Unreach, 0, 0, 0);
        }
        IR_LOC = 0;
        ir_shrink(cx);
    }
}

fn lower_return(cx: sink *FnCtx, value: i64) {
    unsafe {
        let f = IRFUNCS[cx.irf].f;
        let ret = FNS[f].ret;
        var result = 0;
        let c = fn_uses_c(f);
        if conv_returns_through_pointer(cx, c, ret) {
            lower_copy(cx, IRFUNCS[cx.irf].result_ptr, value, type_size(ret));
            if X86 && c {
                // Returned in rax, as C does.
                result = IRFUNCS[cx.irf].result_ptr;
            }
        } else if is_compound(ret) {
            // Returned in registers: its pieces, read from a multiple of 8
            // bytes, packed for the RET.
            var addr = need_value(cx, value, ret);
            if type_size(ret) % 8 != 0 && cx.insts[addr].op != Op::Slot {
                let copy = ir_slot_addr(cx, new_slot_for(cx, ret));
                lower_copy(cx, copy, addr, type_size(ret));
                addr = copy;
            }
            conv_classify(cx, c, ret);
            let count = cx.abi_piece_count;
            var tys: [i64; 4] = [0; 4];
            var offsets: [i64; 4] = [0; 4];
            for k in 0..count {
                tys[k] = cx.abi_piece_ty[k];
                offsets[k] = cx.abi_piece_offset[k];
            }
            let mark = cx.ssa_stack.count;
            for k in 0..count {
                push_arg(cx, ir_load(cx, tys[k], addr, offsets[k]), tys[k]);
            }
            result = emit_ir(cx, Op::Pack, 0, 0, 0, 0);
            take_args(cx, result, mark);
        } else if is_void(ret) {
            // `main` without a result exits with 0.
            if FNS[f].name == MAIN_SYM {
                result = ir_const(cx, 0, TY_I64);
            }
        } else {
            result = need_value(cx, value, ret);
        }
        if !is_dead_block(cx, CUR) {
            ir_terminate(cx, CUR, Term::Ret, result, 0, 0);
        } else {
            ir_terminate(cx, CUR, Term::Unreach, 0, 0, 0);
        }
        start_dead_block(cx);
    }
}

// ---- Statements and bindings ----

fn lower_block(cx: sink *FnCtx, block: i64) -> i64 {
    unsafe {
        let mark = DEFERS.count;
        // (-g) Instructions come from the statement being lowered, and after
        // the block from the statement holding it.
        let outer = IR_LOC;
        for i in 0..NODES[block].count {
            let stmt = child(block, i);
            if IR_LOCS {
                IR_LOC = NODES[stmt].start + 1;
                IR_EXPR_LOC = 0;
            }
            if NODES[stmt].kind == Let {
                lower_let(cx, stmt);
            } else if NODES[stmt].kind == Defer {
                DEFERS.push(stmt);
            } else {
                lower_expr(cx, NODES[stmt].a);
            }
        }
        let tail = NODES[block].a;
        var value = 0;
        if tail != 0 {
            if IR_LOCS {
                IR_LOC = NODES[tail].start + 1;
                IR_EXPR_LOC = 0;
            }
            value = lower_expr(cx, tail);
        }
        if DEFERS.count > mark {
            if tail != 0 {
                value = keep_value(cx, value, NODES[tail].ty, mark);
            }
            lower_defers(cx, mark);
            DEFERS.count = mark;
        }
        IR_LOC = outer;
        IR_EXPR_LOC = 0;
        value
    }
}

// The deferred statements registered above DEFERS depth `depth`, last
// first (0.6): at the end of their block, or at a jump out of it.
fn lower_defers(cx: sink *FnCtx, depth: i64) {
    var i = DEFERS.count - 1;
    while i >= depth && !is_dead_block(cx, CUR) {
        unsafe { lower_expr(cx, NODES[DEFERS.data[i]].a); }
        i -= 1;
    }
}

// A value computed before deferred statements run: a compound value is
// copied, so a deferred statement changing its source does not change it.
fn keep_value(cx: sink *FnCtx, value: i64, ty: i64, depth: i64) -> i64 {
    if DEFERS.count > depth && value != 0 && is_compound(ty) && !is_dead_block(cx, CUR) {
        let copy = ir_slot_addr(cx, new_slot_for(cx, ty));
        lower_copy(cx, copy, value, type_size(ty));
        return copy;
    }
    value
}

// Expressions whose compound value is a new temporary, which a binding or
// an argument may take over without copying.
pub fn is_fresh(n: i64) -> bool {
    unsafe {
        match NODES[n].kind {
            StructLit | Tuple | Array | Repeat
                | Call | Str | VariantLit => true,
            Index => NODES[NODES[n].b].kind == Range,
            _ => false,
        }
    }
}

fn lower_let(cx: sink *FnCtx, stmt: i64) {
    unsafe {
        let init = NODES[stmt].c;
        let value = lower_expr(cx, init);
        if NODES[init].ty == TY_NEVER {
            return;
        }
        let first = cx.inst_count;
        bind_pattern_ir(cx, NODES[stmt].a, value, is_fresh(init));
        // (0.17: a move, COPY_MOVE; copies.tach)
        if moves_local(init) {
            note_move_copies(cx, first);
        }
    }
}

fn bind_pattern_ir(cx: sink *FnCtx, pattern: i64, value: i64, fresh: bool) {
    unsafe {
        let kind = NODES[pattern].kind;
        let ty = NODES[pattern].ty;
        if kind == PatWild || ty == TY_NEVER {
            return;
        }
        if kind == PatBind {
            bind_local(cx, NODES[pattern].x, value, ty, fresh);
            return;
        }
        var value = value;
        if (NODES[pattern].p & PAT_DEREF) != 0 {
            // (0.18.1) value is a reference; ty, what it points to
            value = referent_value(cx, value, ty);
        }
        for i in 0..NODES[pattern].count {
            var elem_ty = 0;
            var offset = 0;
            if kind == PatVariant {
                elem_ty = variant_field(NODES[pattern].x, i);
                offset = variant_field_offset(NODES[pattern].x, i);
            } else {
                elem_ty = type_elem(ty, i);
                offset = tuple_offset(ty, i);
            }
            var elem = 0;
            if is_compound(elem_ty) || binds_ref(child(pattern, i)) {
                elem = ir_offset(cx, value, offset);
            } else if !is_void(elem_ty) {
                elem = ir_load(cx, ir_type(elem_ty), value, offset);
            }
            bind_pattern_ir(cx, child(pattern, i), elem, false);
        }
    }
}

// Binds local `local` (of type `ty`) to `value` (the address of a compound
// value, taken over when `fresh`).
fn bind_local(cx: sink *FnCtx, local: i64, value: i64, ty: i64, fresh: bool) {
    unsafe {
        if is_void(ty) {
            return;
        }
        if PROMOTE[local] != 0 {
            ssa_write(cx, local, CUR, need_value(cx, value, ty));
            return;
        }
        if is_compound(ty) && fresh {
            LOCAL_ADDR[local] = value;
            return;
        }
        let addr = ir_slot_addr(cx, new_slot_for(cx, ty));
        if is_compound(ty) {
            lower_copy(cx, addr, value, type_size(ty));
        } else {
            ir_store(cx, ir_type(ty), addr, need_value(cx, value, ty), 0);
        }
        LOCAL_ADDR[local] = addr;
    }
}

// A frame slot for a value of type `ty`; compound values get a multiple of
// 8 bytes, so that they can be read and written in 8-byte pieces.
fn new_slot_for(cx: sink *FnCtx, ty: i64) -> i64 {
    let size = if is_compound(ty) { align_to(type_size(ty), 8) } else { type_size(ty) };
    let slot = ir_new_slot(cx, size, type_align(ty));
    unsafe { cx.slots[slot].ty = ty; }
    slot
}

// Copies `size` bytes from `src` to `dst`.
fn lower_copy(cx: sink *FnCtx, dst: i64, src: i64, size: i64) {
    unsafe {
        if size == 0 {
            return;
        }
        if size <= INLINE_COPY_MAX {
            let v = emit_ir(cx, Op::Copy, 0, dst, src, size);
            cx.insts[v].imm2 = 0;
            return;
        }
        let mark = cx.ssa_stack.count;
        push_arg(cx, dst, TY_U64);
        push_arg(cx, src, TY_U64);
        push_arg(cx, ir_const(cx, size, TY_U64), TY_U64);
        let call = emit_ir(cx, Op::CallC, 0, 0, 0, intern_c(c"memcpy"));
        take_args(cx, call, mark);
    }
}

// ---- Assignment ----

// The right-hand side is evaluated first, then the target's address; a
// compound assignment then reads the old value.
fn lower_assign(cx: sink *FnCtx, n: i64) {
    unsafe {
        let op = NODES[n].op;
        let target = NODES[n].b;
        let value = NODES[n].c;
        let ty = NODES[target].ty;
        if NODES[target].kind == Ident && NODES[target].res == Res::Local
            && (PROMOTE[NODES[target].y] != 0 || is_void(ty)) {
            let local = NODES[target].y;
            if is_void(ty) {
                lower_expr(cx, value);
                return;
            }
            let v = lower_operand(cx, value);
            if op == Tok::Eq {
                ssa_write(cx, local, CUR, v);
                return;
            }
            let old = ssa_read(cx, local, CUR);
            ssa_write(cx, local, CUR, lower_operator(cx, arith_op_of_assign(op), ty, ty, old, v));
            return;
        }
        if op == Tok::Eq {
            let v = lower_expr(cx, value);
            let addr = lower_addr(cx, target);
            store_value(cx, addr, 0, v, ty);
            return;
        }
        if is_vector(ty) {
            var hi = 0;
            let v = vector_assign_value(cx, value, &hi);
            let addr = lower_addr(cx, target);
            vector_assign_store(cx, arith_token_of(arith_op_of_assign(op)), ty, addr, v, hi);
            return;
        }
        let v = lower_operand(cx, value);
        let addr = lower_addr(cx, target);
        let old = ir_load(cx, ir_type(ty), addr, 0);
        ir_store(cx, ir_type(ty), addr, lower_operator(cx, arith_op_of_assign(op), ty, ty, old, v),
            0);
    }
}
