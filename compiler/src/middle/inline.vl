// Inlining, bottom-up over the call graph: functions are processed by
// strongly connected components (Tarjan's algorithm yields them callees
// first), so a callee is already optimized when it is inlined, and calls
// within a component (recursion) are never inlined. Whether a call is
// inlined is a cost model (see should_inline and docs/optimizer.md): the
// callee's size, less a bonus for the constant arguments that decide
// something in it and the cost of the call itself, against a threshold
// that grows with the call site's loop depth and is zero in cold blocks;
// a function's only call site takes up to INLINE_ONCE. Inlining iterates:
// the inlined copies' calls are considered again once the copies are
// simplified (see inline_rounds).

use crate::back::abi::{AbiClass, conv_classify, conv_returns_through_pointer, fn_uses_c};
use crate::back::codecache::{
    R_DEC, R_IR, R_RT, R_SIZE, R_STATIC, cc_note, cc_note_budget, cc_note_calls,
};
use crate::back::regalloc::intervals::calls_returns_twice;
use crate::base::{IntVec, alloc_array, alloc_zeroed, free, memset};
use crate::front::ast::{FN_CLOSURE, NODES};
use crate::front::types::{FNS, fn_attr_cold, fn_attr_inline, fn_param, is_void, type_size};
use crate::gen0::gen::fn_is_global;
use crate::middle::ctx::FnCtx;
use crate::middle::fold::is_const;
use crate::middle::gvn::has_ref_facts;
use crate::middle::ipo::devirtualize;
use crate::middle::ir::{
    FN_IR, IRFUNCS, IRFUNC_COUNT, Op, Term, ir_append, ir_arg, ir_enter, ir_make, ir_new_block,
    ir_new_slot, ir_prepend, ir_replace, ir_set_arg, ir_unlink, ir_val, ir_view,
};
use crate::middle::ir::cfg::{copy_terminator, ir_switch_no_preds, pred_index, succ, succ_count};
use crate::middle::loops::{analyze_loops, block_array, innermost_loop};
use crate::middle::lower::ssa::ssa_undef;
use crate::middle::opt::{PER_FUNCTION, optimize_after_inlining, resolve_all, simplify_function};
use crate::middle::parallel::fn_facts_ready;
use crate::middle::profile::{is_cold_block, is_hot_count};

const INLINE_SMALL: i64 = 30;
const INLINE_ONCE: i64 = 400;
const INLINE_BUDGET: i64 = 3000;
const INLINE_ROUNDS: i64 = 3;

// (0.14) The cost of a callee inlined whatever the budgets (see
// should_inline).
const INLINE_TINY: i64 = 2;
// The size a hot call site's callee may have (0.10, profiles).
const INLINE_HOT: i64 = 240;
// The bonus per constant argument whose parameter decides a branch, a
// switch or an arithmetic operation of the callee.
const CONST_ARG_BONUS: i64 = 10;

// The program's growth budget: the sum of the functions' sizes may reach
// PROGRAM_BUDGET.
pub static var PROGRAM_SIZE: i64 = 0;
pub static var PROGRAM_BUDGET: i64 = 0;

// ---- Inlining hints ----
//
// `#[inline]`, `#[inline(never)]` and `#[cold]` (the front end's
// fn_attr_inline: 1, -1 or 0; fn_attr_cold; types.vl).

const HINT_ALWAYS: i64 = 1;
const HINT_NEVER: i64 = -1;

// Per IR function: its component, size, number of direct call sites and
// whether its address is taken (FADDR).
pub static var FN_SCC: *i64 = 0 as *i64;
pub static var FN_SIZE: *i64 = 0 as *i64;
pub static var FN_CALLS: *i64 = 0 as *i64;
pub static var FN_ADDRESS: *i64 = 0 as *i64;
// Whether the function is emitted.
pub static var FN_LIVE: *i64 = 0 as *i64;
// (0.17) Per IR function, once it is optimized (its component done):
// whether it calls a function that returns twice (1), or not (0); -1 not
// yet known. should_inline asked calls_returns_twice of the caller and the
// callee for every candidate call, a scan of both: a few percent of -O2.
pub static var FN_RT: *i64 = 0 as *i64;

// (0.17) See deciders: -1 not yet known.
pub static var FN_DECIDERS_START: *i64 = 0 as *i64;
// (0.18.1) Per function, the deciders (its own list: the function's task
// makes it, its callers read it).
pub static var FN_DECIDERS: *IntVec = 0 as *IntVec;

// (0.17) The inliner's caches of function information (FN_RT, deciders),
// for IRFUNC_COUNT functions, none known.
pub fn init_fn_caches() {
    unsafe {
        FN_RT = alloc_array::<i64>(IRFUNC_COUNT + 1);
        FN_DECIDERS_START = alloc_array::<i64>(IRFUNC_COUNT + 1);
        FN_DECIDERS = alloc_zeroed((IRFUNC_COUNT + 1) * size_of(IntVec)) as *IntVec;
        for fi in 0..IRFUNC_COUNT {
            FN_RT[fi] = -1;
            FN_DECIDERS_START[fi] = -1;
        }
    }
}

// Forgets what the caches know of fi (it changed).
pub fn forget_fn_caches(fi: i64) {
    unsafe {
        FN_RT[fi] = -1;
        FN_DECIDERS_START[fi] = -1;
    }
}

// The number of instructions that turn into code.
pub fn func_size(cx: sink *FnCtx, fi: i64) -> i64 {
    var size = 0;
    unsafe {
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            var v = cx.blocks[b].first;
            while v != 0 {
                if !cx.insts[v].op.is_remat() && cx.insts[v].op != Op::Param {
                    size += 1;
                }
                v = cx.insts[v].next;
            }
            size += 1;
        }
    }
    size
}

// The IR function called by direct call v, or -1.
pub fn ir_callee(cx: sink *FnCtx, v: i64) -> i64 {
    unsafe {
        if cx.insts[v].op != Op::Call {
            return -1;
        }
        let g = FN_IR[cx.insts[v].imm] - 1;
        // (0.18.1: what the task saw of g, for the code cache)
        cc_note(cx, R_STATIC, g);
        g
    }
}

// Counts the call sites and address uses of every function.
pub fn count_call_sites(cx: sink *FnCtx) {
    unsafe {
        for fi in 0..IRFUNC_COUNT {
            FN_CALLS[fi] = 0;
            FN_ADDRESS[fi] = 0;
        }
        for fi in 0..IRFUNC_COUNT {
            if FN_LIVE[fi] == 0 {
                continue;
            }
            ir_enter(cx, fi);
            for i in 0..IRFUNCS[fi].blocks.count {
                let b = IRFUNCS[fi].blocks.data[i];
                if cx.blocks[b].removed != 0 {
                    continue;
                }
                var v = cx.blocks[b].first;
                while v != 0 {
                    let g = ir_callee(cx, v);
                    if g >= 0 {
                        FN_CALLS[g] += 1;
                    }
                    if cx.insts[v].op == Op::FAddr && FN_IR[cx.insts[v].imm] != 0 {
                        FN_ADDRESS[FN_IR[cx.insts[v].imm] - 1] = 1;
                    }
                    v = cx.insts[v].next;
                }
            }
        }
    }
}

// ---- Strongly connected components (Tarjan) ----

// The functions in the order to process them: components callees first.
pub static var SCC_ORDER: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The direct callees of fi (with repeats), in `out`.
pub fn callees(cx: sink *FnCtx, fi: i64, out: inout IntVec) {
    out.count = 0;
    unsafe {
        ir_enter(cx, fi);
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            var v = cx.blocks[b].first;
            while v != 0 {
                let g = ir_callee(cx, v);
                if g >= 0 {
                    out.push(g);
                }
                v = cx.insts[v].next;
            }
        }
    }
}

pub fn compute_sccs(cx: sink *FnCtx) {
    unsafe {
        let n = IRFUNC_COUNT;
        let index = alloc_array::<i64>(n + 1);
        let low = alloc_array::<i64>(n + 1);
        let on_stack = alloc_array::<i64>(n + 1);
        // Adjacency, computed once (CSR).
        let adj_start = alloc_array::<i64>(n + 2);
        var adj = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var scratch = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for fi in 0..n {
            adj_start[fi] = adj.count;
            callees(cx, fi, &scratch);
            for i in 0..scratch.count {
                adj.push(scratch.data[i]);
            }
        }
        adj_start[n] = adj.count;
        var stack = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var calls = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var next_index = 1;
        var scc_id = 0;
        SCC_ORDER.count = 0;
        for root in 0..n {
            if index[root] != 0 {
                continue;
            }
            // (node, next edge) frames.
            calls.push(root);
            calls.push(adj_start[root]);
            index[root] = next_index;
            low[root] = next_index;
            next_index += 1;
            stack.push(root);
            on_stack[root] = 1;
            while calls.count > 0 {
                let top = calls.count - 2;
                let v = calls.data[top];
                let e = calls.data[top + 1];
                if e < adj_start[v + 1] {
                    calls.data[top + 1] = e + 1;
                    let w = adj.data[e];
                    if index[w] == 0 {
                        index[w] = next_index;
                        low[w] = next_index;
                        next_index += 1;
                        stack.push(w);
                        on_stack[w] = 1;
                        calls.push(w);
                        calls.push(adj_start[w]);
                    } else if on_stack[w] != 0 && index[w] < low[v] {
                        low[v] = index[w];
                    }
                    continue;
                }
                calls.count -= 2;
                if calls.count > 0 {
                    let parent = calls.data[calls.count - 2];
                    if low[v] < low[parent] {
                        low[parent] = low[v];
                    }
                }
                if low[v] == index[v] {
                    loop {
                        let w = stack.pop();
                        on_stack[w] = 0;
                        FN_SCC[w] = scc_id;
                        SCC_ORDER.push(w);
                        if w == v {
                            break;
                        }
                    }
                    scc_id += 1;
                }
            }
        }
        free(index as *u8);
        free(low as *u8);
        free(on_stack as *u8);
        free(adj_start as *u8);
        free(adj.data as *u8);
        free(scratch.data as *u8);
        free(stack.data as *u8);
        free(calls.data as *u8);
    }
}

// ---- The policy ----

// Whether block b is cold: it leads only to a panic (it ends in UNREACH),
// or it calls a #[cold] function.
fn block_is_cold(cx: sink *FnCtx, b: i64) -> bool {
    unsafe {
        if cx.blocks[b].term == Term::Unreach {
            return true;
        }
        var v = cx.blocks[b].first;
        while v != 0 {
            if cx.insts[v].op == Op::Call && fn_attr_cold(cx.insts[v].imm) {
                return true;
            }
            v = cx.insts[v].next;
        }
        false
    }
}

fn mark_call_sites(cx: sink *FnCtx, fi: i64) {
    unsafe {
        resolve_all(cx, fi);
        analyze_loops(cx, fi);
        cx.site_depth = block_array(cx, cx.site_depth, &cx.site_depth_cap, fi);
        cx.site_cold = block_array(cx, cx.site_cold, &cx.site_cold_cap, fi);
        cx.site_nblocks = cx.block_count;
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            let l = innermost_loop(cx, b);
            cx.site_depth[b] = if l >= 0 { cx.lp_depth.data[l] } else { 0 };
            cx.site_cold[b] = if block_is_cold(cx, b) { 1 } else { 0 };
        }
    }
}

// The operand of a call holding the value of PARAM instruction p of
// callee g (its piece, for an aggregate passed in pieces), or -1.
pub fn param_operand(cx: sink *FnCtx, g: i64, p: i64) -> i64 {
    unsafe {
        let index = cx.insts[p].imm;
        let piece = cx.insts[p].imm2;
        if index < 0 {
            return -1;
        }
        let callee_f = IRFUNCS[g].f;
        var k = 0;
        for q in 0..index {
            let ty = fn_param(callee_f, q);
            if !is_void(ty) {
                k += if conv_classify(cx, fn_uses_c(callee_f), ty)
                    == AbiClass::Pieces { cx.abi_piece_count } else { 1 };
            }
        }
        k + if piece > 0 { piece - 1 } else { 0 }
    }
}

// Whether value p decides something in function g: it is compared,
// switched on, or an operand of a multiplication, division, shift or mask
// (a constant there folds in the copy).
fn decides(cx: sink *FnCtx, g: i64, p: i64) -> bool {
    unsafe {
        for i in 0..IRFUNCS[g].blocks.count {
            let b = IRFUNCS[g].blocks.data[i];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            if cx.blocks[b].term == Term::Switch && ir_val(cx, cx.blocks[b].cond) == p {
                return true;
            }
            var v = cx.blocks[b].first;
            while v != 0 {
                let op = cx.insts[v].op;
                if op == Op::Cmp || op == Op::Mul || op == Op::Div || op == Op::Rem
                    || op == Op::Shl || op == Op::Shr || op == Op::And {
                    if ir_val(cx, cx.insts[v].a) == p || ir_val(cx, cx.insts[v].b) == p {
                        return true;
                    }
                }
                v = cx.insts[v].next;
            }
        }
    }
    false
}

// The cost of inlining callee g at call `call`: its size, less the bonus
// for constant arguments that decide something in it, less the call's own
// cost (its argument moves, the call and the result). (0.17: which of g's
// parameters decide something is found once g is optimized, deciders.)
fn inline_cost(cx: sink *FnCtx, g: i64, call: i64) -> i64 {
    unsafe {
        let nargs = cx.insts[call].nargs;
        cc_note(cx, R_SIZE, g);
        var cost = FN_SIZE[g];
        let list = deciders(cx, g);
        for i in 0..(*list).count {
            let k = (*list).data[i];
            if k < nargs && is_const(cx, ir_val(cx, ir_arg(cx, call, k))) {
                cost -= CONST_ARG_BONUS;
            }
        }
        cost - 2 - nargs
    }
}

// The call operands of g's parameters that decide something in it (one
// per parameter instruction, in order): FN_DECIDERS[g], found once g is
// optimized (reset with FN_RT; 0.18.1: by g's task, finish_component).
fn deciders(cx: sink *FnCtx, g: i64) -> *IntVec {
    unsafe {
        if FN_DECIDERS_START[g] < 0 {
            let back = cx.ir_cur;
            ir_enter(cx, g);
            FN_DECIDERS_START[g] = 0;
            FN_DECIDERS[g].count = 0;
            let entry = IRFUNCS[g].entry;
            var v = cx.blocks[entry].first;
            while v != 0 {
                if cx.insts[v].op == Op::Param {
                    let k = param_operand(cx, g, v);
                    if k >= 0 && decides(cx, g, v) {
                        FN_DECIDERS[g].push(k);
                    }
                }
                v = cx.insts[v].next;
            }
            ir_enter(cx, back);
        }
        cc_note(cx, R_DEC, g);
        &FN_DECIDERS[g]
    }
}

fn site_depth(cx: sink *FnCtx, b: i64) -> i64 {
    if unsafe { b < cx.site_nblocks } { unsafe { cx.site_depth[b] } } else { 0 }
}

fn site_cold(cx: sink *FnCtx, b: i64) -> bool {
    unsafe { b < cx.site_nblocks && cx.site_cold[b] != 0 }
}

// Whether optimized function g calls a function that returns twice (see
// FN_RT).
fn callee_returns_twice(cx: sink *FnCtx, g: i64) -> bool {
    (callee_flags(cx, g) & RT_RETURNS_TWICE) != 0
}

// Whether optimized function g calls nothing (0.17: see should_inline).
fn callee_is_leaf(cx: sink *FnCtx, g: i64) -> bool {
    (callee_flags(cx, g) & RT_CALLS) == 0
}

// FN_RT[g], computed once g is optimized.
fn callee_flags(cx: sink *FnCtx, g: i64) -> i64 {
    unsafe {
        if FN_RT[g] < 0 {
            let back = cx.ir_cur;
            ir_enter(cx, g);
            var flags = if calls_returns_twice(cx, g) { RT_RETURNS_TWICE } else { 0 };
            for b in IRFUNCS[g].blocks.items() {
                if cx.blocks[b].removed == 0 {
                    var v = cx.blocks[b].first;
                    while v != 0 {
                        if cx.insts[v].op.is_call() {
                            flags = flags | RT_CALLS;
                        }
                        v = cx.insts[v].next;
                    }
                }
            }
            FN_RT[g] = flags;
            ir_enter(cx, back);
        }
        cc_note(cx, R_RT, g);
        FN_RT[g]
    }
}

const RT_RETURNS_TWICE: i64 = 1;
const RT_CALLS: i64 = 2;
// (0.17) A leaf this small is inlined whatever the program's budget (see
// should_inline).
const INLINE_LEAF: i64 = 6;

fn should_inline(cx: sink *FnCtx, fi: i64, g: i64, call: i64) -> bool {
    unsafe {
        if g == fi || FN_SCC[g] == FN_SCC[fi] || FN_LIVE[g] == 0 {
            return false;
        }
        // (0.18.1) Only a callee whose component is done (below this one: a
        // call made direct may call any function).
        if !fn_facts_ready(cx, g, true) {
            return false;
        }
        cc_note(cx, R_SIZE, g);
        // A function calling setjmp (or the like) keeps its own frame, and
        // its callers theirs (see regalloc.vl).
        if cx.caller_rt || callee_returns_twice(cx, g) {
            return false;
        }
        let gf = IRFUNCS[g].f;
        let hint = fn_attr_inline(gf);
        if hint == HINT_NEVER || fn_attr_cold(gf) {
            return false;
        }
        if hint == HINT_ALWAYS {
            return true;
        }
        // (0.14) A callee about as big as its call is inlined whatever the
        // caller's size: the chain of small closures an iterator chain calls,
        // `as_slice`.
        // (0.17: computed once; it scans the callee for what each constant
        // argument decides)
        let cost = inline_cost(cx, g, call);
        if cost <= INLINE_TINY && budget_allows(cx, FN_SIZE[g]) {
            return true;
        }
        let b = cx.insts[call].block;
        let once = calls_left(cx, g) == 1 && FN_ADDRESS[g] == 0 && !fn_is_global(gf);
        // A closure called once is inlined whatever its size: it is moved,
        // not copied, and its size before its environment is known (the
        // loads through it) says little of what it becomes (a closure
        // calling closures, the fold of an iterator chain).
        if once && is_closure_fn(g) {
            return true;
        }
        // (0.17) A small leaf is not charged to the program's budget: its
        // code is about its call's (the arguments' moves, the call, the
        // caller-saved registers it clobbers), and the program's callers,
        // last in the order, found the budget spent.
        let small_leaf = FN_SIZE[g] <= INLINE_LEAF && callee_is_leaf(cx, g);
        if FN_SIZE[fi] + FN_SIZE[g] > INLINE_BUDGET
            || (!budget_allows(cx, FN_SIZE[g]) && !small_leaf) {
            return false;
        }
        // (0.10: with a profile, a call that never ran is cold, and a hot one
        // takes a callee up to INLINE_HOT)
        if site_cold(cx, b) || is_cold_block(cx, b) {
            // In a cold block, only when that makes the program no bigger.
            return once || cost <= 0;
        }
        if once && FN_SIZE[g] <= INLINE_ONCE {
            return true;
        }
        if is_hot_count(cx.blocks[b].count) && cost <= INLINE_HOT {
            return true;
        }
        let depth = site_depth(cx, b);
        var threshold = INLINE_SMALL;
        if depth >= 1 {
            threshold *= 2;
        }
        if depth >= 2 {
            threshold *= 2;
        }
        cost <= threshold
    }
}

// Whether inlining function g is charged to the budgets only for what it
// adds once simplified (see inline_calls): `#[inline]` functions (the std
// iterator methods are) and closures' functions.
fn counted_after(g: i64) -> bool {
    unsafe { fn_attr_inline(IRFUNCS[g].f) == HINT_ALWAYS || is_closure_fn(g) }
}

// Whether IR function g is a closure's (FN_CLOSURE, 0.14).
fn is_closure_fn(g: i64) -> bool {
    unsafe {
        let node = FNS[IRFUNCS[g].f].node;
        node != 0 && (NODES[node].p & FN_CLOSURE) != 0
    }
}

// Inlines the calls of function fi that should be, in one pass over its
// blocks. Returns whether any was.
pub fn inline_calls(cx: sink *FnCtx, fi: i64) -> bool {
    unsafe {
        devirtualize(cx, fi);
        mark_call_sites(cx, fi);
        cx.caller_rt = calls_returns_twice(cx, fi);
        var changed = false;
        var i = 0;
        // Blocks appended by inlining are visited too, except the callees'
        // copies (BLOCKS[b].loop_depth == 1): their calls wait for the next
        // round, once the copies are simplified.
        while i < IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            i += 1;
            if cx.blocks[b].removed != 0 || cx.blocks[b].loop_depth == 1 {
                continue;
            }
            var v = cx.blocks[b].first;
            while v != 0 {
                let next = cx.insts[v].next;
                let g = ir_callee(cx, v);
                if g >= 0 && should_inline(cx, fi, g, v) {
                    // (0.14) A function made to be inlined counts for its size
                    // once simplified, when inline_rounds measures it: its
                    // size alone, before its arguments are known, would use
                    // up the budgets in the middle of an iterator chain.
                    if !counted_after(g) {
                        FN_SIZE[fi] += FN_SIZE[g];
                        program_grows(cx, FN_SIZE[g]);
                    }
                    note_inlined(cx, g);
                    // The continuation block keeps the call site's loop depth
                    // and coldness.
                    let depth = site_depth(cx, b);
                    let cold = site_cold(cx, b);
                    let cont = inline_call(cx, fi, v, g);
                    set_site(cx, cont, depth, cold);
                    changed = true;
                    // The rest of this block moved to the continuation block,
                    // visited later.
                    break;
                }
                v = next;
            }
        }
        for k in 0..IRFUNCS[fi].blocks.count {
            cx.blocks[IRFUNCS[fi].blocks.data[k]].loop_depth = 0;
        }
        changed
    }
}

// The count of a block of a callee (that ran `count` times, its entry
// `entry` times) inlined at a call site that ran `site` times (0.10), or
// -1.
fn scaled_count(count: i64, site: i64, entry: i64) -> i64 {
    if count < 0 || site < 0 || entry <= 0 {
        return -1;
    }
    let x = count as f64 * site as f64 / entry as f64;
    if x > 1099511627776.0 { 1099511627776 } else { x as i64 }
}

// Records the loop depth and coldness of a block made after
// mark_call_sites. (0.18.1: the tables grow to cover it; 0.17 recorded it
// only when they covered it already, which depended on the largest
// function optimized before, on this thread.)
fn set_site(cx: sink *FnCtx, b: i64, depth: i64, cold: bool) {
    unsafe {
        if b >= cx.site_depth_cap || b >= cx.site_cold_cap {
            let cap = (b + 1) * 2;
            let depths = alloc_array::<i64>(cap);
            let colds = alloc_array::<i64>(cap);
            for x in 0..cx.site_nblocks {
                depths[x] = cx.site_depth[x];
                colds[x] = cx.site_cold[x];
            }
            free(cx.site_depth as *u8);
            free(cx.site_cold as *u8);
            cx.site_depth = depths;
            cx.site_cold = colds;
            cx.site_depth_cap = cap;
            cx.site_cold_cap = cap;
        }
        if b >= cx.site_nblocks {
            for x in cx.site_nblocks..b + 1 {
                cx.site_depth[x] = 0;
                cx.site_cold[x] = 0;
            }
            cx.site_nblocks = b + 1;
        }
        cx.site_depth[b] = depth;
        cx.site_cold[b] = if cold { 1 } else { 0 };
    }
}

// Inlining in function fi, in rounds: each round inlines, then simplifies
// (so constants reach the copies) and recounts the function's size; the
// copies' own calls are candidates in the next round. Returns whether
// anything was inlined.
pub fn inline_rounds(cx: sink *FnCtx, fi: i64) -> bool {
    unsafe {
        var any = false;
        for round in 0..INLINE_ROUNDS {
            if !inline_calls(cx, fi) {
                break;
            }
            any = true;
            let before = FN_SIZE[fi];
            optimize_after_inlining(cx, fi);
            let after = func_size(cx, fi);
            // (0.14: not a function that goes once inlined everywhere)
            if !inlined_everywhere(fi) {
                program_grows(cx, after - before);
            }
            FN_SIZE[fi] = after;
        }
        any
    }
}

// The program's size now, and its growth budget.
pub fn start_inlining_budget() {
    unsafe {
        PROGRAM_SIZE = 0;
        for fi in 0..IRFUNC_COUNT {
            if FN_LIVE[fi] != 0 && !inlined_everywhere(fi) {
                PROGRAM_SIZE += FN_SIZE[fi];
            }
        }
        PROGRAM_BUDGET = PROGRAM_SIZE + PROGRAM_SIZE / 2 + 2000;
    }
}

// ---- Inlining one call ----

// The copy of value `v` of the callee (cx.inl_imap; its aux until 0.18.1).
fn mapped(cx: sink *FnCtx, v: i64) -> i64 {
    if v == 0 { 0 } else { unsafe { cx.inl_imap[v] } }
}

// Inlines callee g at call `call` of function fi. Returns the continuation
// block (the instructions after the call). (0.17: g's IR is read through
// its own tables, gt, while fi's are current: ids are each function's.)
fn inline_call(cx: sink *FnCtx, fi: i64, call: i64, g: i64) -> i64 {
    unsafe {
        // (0.18.1: g is resolved already, finish_component_function and
        // simplify_inlining_leaves; its tables are only read: another thread
        // may be copying it too)
        ir_enter(cx, fi);
        cc_note(cx, R_IR, g);
        let gt = ir_view(g);
        inline_maps(cx, gt.block_count + 1, gt.inst_count + 1);
        let b = cx.insts[call].block;
        // The continuation: the instructions after the call, and b's end.
        let cont = ir_new_block(cx);
        cx.blocks[cont].sealed = 1;
        cx.blocks[cont].count = cx.blocks[b].count;
        var v = cx.insts[call].next;
        while v != 0 {
            let next = cx.insts[v].next;
            ir_unlink(cx, v);
            ir_append(cx, cont, v);
            v = next;
        }
        copy_terminator(cx, cont, b);
        for k in 0..succ_count(cx, cont) {
            let s = succ(cx, cont, k);
            let index = pred_index(cx, s, b);
            cx.blocks[s].preds.data[index] = cont;
        }
        // The operand of the call holding each parameter (its first piece,
        // for an aggregate passed in pieces).
        let callee_f = IRFUNCS[g].f;
        var param_first: [i64; 64] = [0; 64];
        var k = 0;
        for p in 0..FNS[callee_f].param_count {
            let ty = fn_param(callee_f, p);
            if !is_void(ty) {
                param_first[p] = k;
                k += if conv_classify(cx, fn_uses_c(callee_f), ty)
                    == AbiClass::Pieces { cx.abi_piece_count } else { 1 };
            }
        }
        // Copy the blocks and instructions.
        let gentry = IRFUNCS[g].entry;
        for i in 0..IRFUNCS[g].blocks.count {
            let gb = IRFUNCS[g].blocks.data[i];
            if gt.blocks[gb].removed != 0 {
                continue;
            }
            let nb = ir_new_block(cx);
            cx.blocks[nb].sealed = 1;
            cx.blocks[nb].loop_depth = 1;
            cx.blocks[nb].novec = gt.blocks[gb].novec;
            cx.blocks[nb].count = scaled_count(gt.blocks[gb].count, cx.blocks[b].count,
                gt.blocks[gentry].count);
            cx.inl_bmap[gb] = nb;
            var gv = gt.blocks[gb].first;
            while gv != 0 {
                let op = gt.insts[gv].op;
                if op == Op::Param {
                    let index = gt.insts[gv].imm;
                    let piece = gt.insts[gv].imm2;
                    if index < 0 {
                        cx.inl_imap[gv] = cx.insts[call].c;
                    } else {
                        cx.inl_imap[gv] = ir_arg(cx, call,
                            param_first[index] + if piece > 0 { piece - 1 } else { 0 });
                    }
                } else {
                    let nv = ir_make(cx, op, gt.insts[gv].ty, gt.insts[gv].a, gt.insts[gv].b,
                        gt.insts[gv].imm);
                    cx.insts[nv].c = gt.insts[gv].c;
                    cx.insts[nv].cond = gt.insts[gv].cond;
                    cx.insts[nv].imm2 = gt.insts[gv].imm2;
                    if op == Op::Slot {
                        let s = gt.insts[gv].imm;
                        cx.insts[nv].imm = ir_new_slot(cx, gt.slots[s].size, gt.slots[s].align);
                        cx.slots[cx.insts[nv].imm].ty = gt.slots[s].ty;
                    }
                    if gt.insts[gv].nargs > 0 || op == Op::Phi || op.is_call() {
                        let base = gt.insts[gv].args;
                        cx.insts[nv].args = cx.args.count;
                        cx.insts[nv].nargs = gt.insts[gv].nargs;
                        for a in 0..gt.insts[gv].nargs {
                            cx.args.push(gt.args.data[base + a]);
                            cx.argty.push(gt.argty.data[base + a]);
                        }
                    }
                    ir_append(cx, nb, nv);
                    cx.inl_imap[gv] = nv;
                }
                gv = gt.insts[gv].next;
            }
        }
        // Map the operands, the terminators and the predecessors. An aggregate
        // returned in registers is copied from its address to the call's
        // result slot.
        let ret = FNS[callee_f].ret;
        let copy_result = cx.insts[call].c != 0
            && !conv_returns_through_pointer(cx, fn_uses_c(callee_f), ret);
        var returns = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..IRFUNCS[g].blocks.count {
            let gb = IRFUNCS[g].blocks.data[i];
            if gt.blocks[gb].removed != 0 {
                continue;
            }
            let nb = cx.inl_bmap[gb];
            var nv = cx.blocks[nb].first;
            while nv != 0 {
                cx.insts[nv].a = mapped(cx, cx.insts[nv].a);
                cx.insts[nv].b = mapped(cx, cx.insts[nv].b);
                cx.insts[nv].c = mapped(cx, cx.insts[nv].c);
                for a in 0..cx.insts[nv].nargs {
                    ir_set_arg(cx, nv, a, mapped(cx, ir_arg(cx, nv, a)));
                }
                nv = cx.insts[nv].next;
            }
            for p in 0..gt.blocks[gb].preds.count {
                cx.blocks[nb].preds.push(cx.inl_bmap[gt.blocks[gb].preds.data[p]]);
            }
            let term = gt.blocks[gb].term;
            let gcond = gt.blocks[gb].cond;
            if term == Term::Ret {
                if copy_result {
                    let copy = ir_make(cx, Op::Copy, 0, cx.insts[call].c, mapped(cx, gcond),
                        type_size(ret));
                    ir_append(cx, nb, copy);
                }
                cx.blocks[nb].term = Term::Jump;
                cx.blocks[nb].s0 = cont;
                cx.blocks[cont].preds.push(nb);
                returns.push(mapped(cx, gcond));
            } else if term == Term::Switch {
                let mark = cx.ssa_stack.count;
                let cases = gt.blocks[gb].cases;
                for c in 0..gt.blocks[gb].ncases {
                    cx.ssa_stack.push(gt.swcases.data[cases + 2 * c]);
                    cx.ssa_stack.push(cx.inl_bmap[gt.swcases.data[cases + 2 * c + 1]]);
                }
                ir_switch_no_preds(cx, nb, mapped(cx, gcond), cx.inl_bmap[gt.blocks[gb].s0],
                    mark);
            } else {
                let s0 = gt.blocks[gb].s0;
                let s1 = gt.blocks[gb].s1;
                cx.blocks[nb].term = term;
                cx.blocks[nb].cond = mapped(cx, gcond);
                cx.blocks[nb].s0 = if s0 != 0 { cx.inl_bmap[s0] } else { 0 };
                cx.blocks[nb].s1 = if s1 != 0 { cx.inl_bmap[s1] } else { 0 };
            }
        }
        // Enter the copy.
        let entry = cx.inl_bmap[gentry];
        cx.blocks[b].term = Term::Jump;
        cx.blocks[b].cond = 0;
        cx.blocks[b].s0 = entry;
        cx.blocks[b].s1 = 0;
        cx.blocks[entry].preds.push(b);
        // The result.
        let ty = cx.insts[call].ty;
        if ty != 0 {
            var result = 0;
            if returns.count == 0 {
                result = ssa_undef(cx, ty);
            } else if returns.count == 1 {
                result = returns.data[0];
            } else {
                result = ir_make(cx, Op::Phi, ty, 0, 0, 0);
                cx.insts[result].args = cx.args.count;
                cx.insts[result].nargs = returns.count;
                for r in 0..returns.count {
                    cx.args.push(returns.data[r]);
                    cx.argty.push(0);
                }
                ir_prepend(cx, cont, result);
            }
            ir_replace(cx, call, result);
        } else {
            replace_pieces(cx, call, cont, returns);
            ir_unlink(cx, call);
        }
        free(returns.data as *u8);
        cont
    }
}

// The pieces of an aggregate result in registers (PIECE instructions after
// the call, now in `cont`) become the pieces the inlined returns pack (a
// phi of them when there are several); the packs go.
fn replace_pieces(cx: sink *FnCtx, call: i64, cont: i64, returns: IntVec) {
    unsafe {
        var v = cx.blocks[cont].first;
        while v != 0 {
            let next = cx.insts[v].next;
            if cx.insts[v].op == Op::Piece && cx.insts[v].a == call {
                let k = cx.insts[v].imm;
                let ty = cx.insts[v].ty;
                var result = 0;
                if returns.count == 0 {
                    result = ssa_undef(cx, ty);
                } else if returns.count == 1 {
                    result = ir_arg(cx, returns.data[0], k);
                } else {
                    result = ir_make(cx, Op::Phi, ty, 0, 0, 0);
                    cx.insts[result].args = cx.args.count;
                    cx.insts[result].nargs = returns.count;
                    for r in 0..returns.count {
                        cx.args.push(ir_arg(cx, returns.data[r], k));
                        cx.argty.push(0);
                    }
                    ir_prepend(cx, cont, result);
                }
                ir_replace(cx, v, result);
            }
            v = next;
        }
        for r in 0..returns.count {
            let pack = returns.data[r];
            if pack != 0 && cx.insts[pack].op == Op::Pack {
                ir_unlink(cx, pack);
            }
        }
    }
}

// Whether function fi is going to be inlined into each of its callers
// (0.14): `#[inline]`, its address not taken, not visible outside. Its
// loop passes wait (they do better in the callers, where its arguments
// are known: an iterator source's `fold` sees its position is 0 only
// there; opt.vl), and its size does not count in the program's, which
// it leaves once inlined. (0.17) Not one whose reference parameters
// give facts (gvn.vl, has_ref_facts): inlining would lose them, so its
// loops are optimized while they hold.
pub fn inlined_everywhere(fi: i64) -> bool {
    unsafe {
        let f = IRFUNCS[fi].f;
        fn_attr_inline(f) == 1 && FN_ADDRESS[fi] == 0 && !fn_is_global(f) && !has_ref_facts(f)
    }
}

// (0.18.1) Whether function fi, as lowered, is one no caller inlines:
// `#[inline(never)]`, cold, or bigger than any callee inlined
// (INLINE_ONCE). Only such a function takes its requires as facts at its
// entry (middle::entryfacts): one its callers may inline has the facts of
// their checks there, and its loops are better left to them as they are
// (cleaned by the facts, they would come to the caller unrolled, where it
// would have vectorized them).
pub fn never_inlined(cx: sink *FnCtx, fi: i64) -> bool {
    unsafe {
        let f = IRFUNCS[fi].f;
        let hint = fn_attr_inline(f);
        if hint == HINT_NEVER || fn_attr_cold(f) {
            return true;
        }
        hint != HINT_ALWAYS && !is_closure_fn(fi) && func_size(cx, fi) > INLINE_ONCE
    }
}

// (0.18.1) Room in cx's maps from a callee's blocks and instructions to
// their copies for `blocks` and `insts` ids, all 0 (inline_call).
fn inline_maps(cx: sink *FnCtx, blocks: i64, insts: i64) {
    unsafe {
        if cx.inl_bmap_cap < blocks {
            free(cx.inl_bmap as *u8);
            cx.inl_bmap_cap = blocks * 2;
            cx.inl_bmap = alloc_array::<i64>(cx.inl_bmap_cap);
        }
        if cx.inl_imap_cap < insts {
            free(cx.inl_imap as *u8);
            cx.inl_imap_cap = insts * 2;
            cx.inl_imap = alloc_array::<i64>(cx.inl_imap_cap);
        }
        memset(cx.inl_bmap as *u8, 0, (blocks * 8) as u64);
        memset(cx.inl_imap as *u8, 0, (insts * 8) as u64);
    }
}

// (0.18.1) The program's size as the component being optimized sees it:
// the program's before the bottom-up phase, and what the component
// itself added (PROGRAM_SIZE, which every component added to in 0.17,
// made the decisions depend on the order the components were done in).
fn program_size(cx: sink *FnCtx) -> i64 {
    unsafe { PROGRAM_SIZE + cx.comp_growth }
}

// (0.18.1) Whether the program, grown by n more, is within the inlining
// budget as the component being optimized sees it (the code cache keeps
// the answer, not the size: back::codecache).
fn budget_allows(cx: sink *FnCtx, n: i64) -> bool {
    unsafe {
        let within = program_size(cx) + n <= PROGRAM_BUDGET;
        cc_note_budget(cx, cx.comp_growth + n, within);
        within
    }
}

fn program_grows(cx: sink *FnCtx, n: i64) {
    unsafe { cx.comp_growth += n; }
}

// (0.18.1) Between the bottom-up phase's levels (middle::parallel): what
// a level's components added.
pub fn add_program_size(n: i64) {
    unsafe { PROGRAM_SIZE += n; }
}

// (0.18.1) The calls of g left as the component being optimized sees them:
// those before the bottom-up phase, less the ones it inlined itself.
fn calls_left(cx: sink *FnCtx, g: i64) -> i64 {
    unsafe {
        var n = FN_CALLS[g];
        var own = 0;
        for i in 0..cx.comp_dec.count {
            if cx.comp_dec.data[i] == g {
                own += 1;
            }
        }
        n -= own;
        // (0.18.1: the code cache keeps whether it is one, not the count)
        cc_note_calls(cx, g, own, n == 1);
        n
    }
}

fn note_inlined(cx: sink *FnCtx, g: i64) {
    unsafe { cx.comp_dec.push(g); }
}

// (0.18.1) What the callers of fi read of it, made by fi's task once its
// component is done (so that no caller's task writes it): its call flags,
// its deciders, and its operands resolved (inline_call copies them).
pub fn finish_component_function(cx: sink *FnCtx, fi: i64) {
    ir_enter(cx, fi);
    callee_flags(cx, fi);
    deciders(cx, fi);
    resolve_all(cx, fi);
}

// ---- (0.17) -O1: small leaf functions ----

// The largest leaf -O1 inlines (func_size, once simplified), and one with
// `#[inline]`. (Measured, 0.17: at 6, -O1 has all the gains 8 to 12 give
// on the benchmarks (matmul 2.5 times fewer instructions, iterchain 37%,
// wordcount 10%, json 6% fewer), 5 fewer and 4 nearly none; the -O1
// compile of the compiler costs 2% more at 6, 3% at 8, 4.6% at 10;
// docs/optimizer.md.)
const LEAF_SIZE: i64 = 6;
const LEAF_HINTED: i64 = 40;

// -O1's scalar pipeline with the calls of small leaf functions inlined
// first: a function with no calls, of at most LEAF_SIZE instructions once
// simplified (LEAF_HINTED with `#[inline]`; never with `#[inline(never)]`
// or `#[cold]`), so that Fmt's tiny methods, `len`, `as_slice` and the
// like do not stay calls. The leaves are simplified first (here, for the
// whole program); then each other function has their calls inlined and is
// simplified (optimize_with_leaves: here too, or, per function, when it is
// emitted: PER_FUNCTION). A small leaf every call of which is inlined (no
// caller calls setjmp or the like, its address not taken, not global) is
// not emitted (leaf_dropped). -O2 inlines by its own cost model.
pub fn simplify_inlining_leaves(cx: sink *FnCtx) {
    unsafe {
        free(LEAF_SMALL as *u8);
        free(LEAF_DONE as *u8);
        free(LEAF_KEEP as *u8);
        LEAF_SMALL = alloc_array::<i64>(IRFUNC_COUNT + 1);
        LEAF_DONE = alloc_array::<i64>(IRFUNC_COUNT + 1);
        LEAF_KEEP = alloc_array::<i64>(IRFUNC_COUNT + 1);
        for fi in 0..IRFUNC_COUNT {
            if FN_LIVE[fi] == 0 || has_calls(cx, fi) {
                continue;
            }
            ir_enter(cx, fi);
            simplify_function(cx, fi);
            // (0.18.1: resolved now, as inline_call reads it; it was resolved
            // there, which another thread may be doing too)
            resolve_all(cx, fi);
            LEAF_DONE[fi] = 1;
            let f = IRFUNCS[fi].f;
            let hint = fn_attr_inline(f);
            if hint == HINT_NEVER || fn_attr_cold(f) || FNS[f].variadic {
                continue;
            }
            let limit = if hint == HINT_ALWAYS { LEAF_HINTED } else { LEAF_SIZE };
            if func_size(cx, fi) <= limit {
                LEAF_SMALL[fi] = 1;
            }
        }
        // The small leaves something keeps: an address taken, a call from a
        // function that calls setjmp or the like (which inlines nothing).
        for fi in 0..IRFUNC_COUNT {
            if FN_LIVE[fi] == 0 {
                continue;
            }
            ir_enter(cx, fi);
            let rt = LEAF_DONE[fi] == 0 && calls_returns_twice(cx, fi);
            for i in 0..IRFUNCS[fi].blocks.count {
                let b = IRFUNCS[fi].blocks.data[i];
                if cx.blocks[b].removed != 0 {
                    continue;
                }
                var v = cx.blocks[b].first;
                while v != 0 {
                    let g = ir_callee(cx, v);
                    if g >= 0 && rt {
                        LEAF_KEEP[g] = 1;
                    }
                    if cx.insts[v].op == Op::FAddr && FN_IR[cx.insts[v].imm] != 0 {
                        LEAF_KEEP[FN_IR[cx.insts[v].imm] - 1] = 1;
                    }
                    v = cx.insts[v].next;
                }
            }
        }
        if !PER_FUNCTION {
            for fi in 0..IRFUNC_COUNT {
                if FN_LIVE[fi] != 0 {
                    optimize_with_leaves(cx, fi);
                }
            }
            for fi in 0..IRFUNC_COUNT {
                if leaf_dropped(fi) {
                    FN_LIVE[fi] = 0;
                }
            }
        }
    }
}

// Function fi's -O1 pipeline after the leaves (see
// simplify_inlining_leaves): their calls inlined, then the scalar
// pipeline; nothing for a leaf (simplified already).
pub fn optimize_with_leaves(cx: sink *FnCtx, fi: i64) {
    unsafe {
        if LEAF_DONE[fi] != 0 {
            return;
        }
        ir_enter(cx, fi);
        if inline_leaf_calls(cx, fi, LEAF_SMALL) {
            optimize_after_inlining(cx, fi);
        } else {
            simplify_function(cx, fi);
        }
    }
}

// Whether fi is a small leaf no call of which is left (not emitted).
pub fn leaf_dropped(fi: i64) -> bool {
    unsafe {
        LEAF_SMALL != 0 as *i64 && LEAF_SMALL[fi] != 0 && LEAF_KEEP[fi] == 0
            && !fn_is_global(IRFUNCS[fi].f)
    }
}

// Whether fi's IR is still needed after it is emitted: a small leaf, which
// a later function may inline.
pub fn leaf_kept(fi: i64) -> bool {
    unsafe { LEAF_SMALL != 0 as *i64 && LEAF_SMALL[fi] != 0 }
}

// (0.17, -O1) Per function: a small leaf, a leaf (simplified already), one
// something keeps (see simplify_inlining_leaves).
pub static var LEAF_SMALL: *i64 = 0 as *i64;
pub static var LEAF_DONE: *i64 = 0 as *i64;
pub static var LEAF_KEEP: *i64 = 0 as *i64;

// Whether function fi makes a call (direct or not).
fn has_calls(cx: sink *FnCtx, fi: i64) -> bool {
    unsafe {
        ir_enter(cx, fi);
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            var v = cx.blocks[b].first;
            while v != 0 {
                if cx.insts[v].op.is_call() {
                    return true;
                }
                v = cx.insts[v].next;
            }
        }
        false
    }
}

// Inlines function fi's calls of the functions `small` marks (leaves:
// their copies make no calls), in one pass over its blocks; whether any
// was. (None in a function that calls setjmp or the like: it keeps its
// frame, see regalloc.vl.)
fn inline_leaf_calls(cx: sink *FnCtx, fi: i64, small: *i64) -> bool {
    unsafe {
        var changed = false;
        var i = 0;
        // (a call's continuation block is appended: visited too)
        while i < IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            i += 1;
            if cx.blocks[b].removed != 0 || cx.blocks[b].loop_depth == 1 {
                continue;
            }
            var v = cx.blocks[b].first;
            while v != 0 {
                let next = cx.insts[v].next;
                let g = ir_callee(cx, v);
                if g >= 0 && g != fi && small[g] != 0 && FN_LIVE[g] != 0 {
                    if !changed && calls_returns_twice(cx, fi) {
                        return false;
                    }
                    inline_call(cx, fi, v, g);
                    changed = true;
                    break;
                }
                v = next;
            }
        }
        for k in 0..IRFUNCS[fi].blocks.count {
            cx.blocks[IRFUNCS[fi].blocks.data[k]].loop_depth = 0;
        }
        changed
    }
}
