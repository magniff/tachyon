// The SLP vectorizer (0.11): straight-line code. In each block, a group of
// stores writing the VF lanes of one 16-byte vector (one base, consecutive
// offsets, one scalar type T, VF = 16 / size(T)) is a seed; the values they
// store are packed bottom-up, lane by lane:
//
// - lanes that are the same value: a splat;
// - loads of consecutive addresses (one base) in the block: a vector load;
// - the same operation in every lane (+ - * & | ^, negation; / on floats)
//   of type T, in the block: that operation on the vectors of its
//   operands' lanes;
// - anything else: gathered into a vector, lane by lane.
//
// Each lane computes exactly what its scalar code does (a float lane is the
// same IEEE operation; nothing is reassociated). The vector code goes just
// before the group's last store, which the vector store replaces; the
// scalar code no longer used goes with dead code elimination. That moves
// the group's loads and stores down to that point, which the memory
// between must allow: no call or other write to memory in between, no
// store in between that may write what a moved load reads, no access in
// between to what a moved store writes, and no load reading a store of the
// group made before it. The group is vectorized when the scalar
// instructions that go outnumber the vector ones it costs.

use crate::base::{IntVec, alloc_array, free};
use crate::base::target::X86;
use crate::front::types::{
    TY_F32, TY_F64, TY_I16, TY_I32, TY_I64, TY_I8, TY_U16, TY_U32, TY_U64, TY_U8, is_float,
    type_size, vector_type,
};
use crate::middle::ctx::FnCtx;
use crate::middle::gvn::{address_base, find_escaping_slots, may_alias};
use crate::middle::ir::{
    IRFUNCS, Op, ir_enter, ir_insert_before, ir_make, ir_operand, ir_operand_count, ir_unlink,
    ir_val,
};
use crate::middle::ir::Op::{
    Add, And, Div, Load, Mul, Neg, Or, Store, Sub, VBin, VIns, VNeg, VSplat, Xor,
};

// --no-slp turns it off (to compare).
pub static var SLP: bool = true;

const SLP_MAX_STORES: i64 = 64;
const SLP_MAX_DEPTH: i64 = 8;
const SLP_MAX_NODES: i64 = 32;

// The tree: nodes of VF lanes each (N_LANES, VF per node), their kind and
// their operand nodes. Kinds: a splat of lane 0, a vector load, an
// operation, a gather.
const K_SPLAT: i64 = 1;
const K_LOAD: i64 = 2;
const K_OP: i64 = 3;
const K_GATHER: i64 = 4;

// Whether some lane of node n goes (after scalars_removed).
fn some_lane_goes(cx: sink *FnCtx, n: i64) -> bool {
    unsafe {
        for k in 0..cx.g_vf {
            if goes(cx, lane(cx, n, k)) {
                return true;
            }
        }
    }
    false
}

// The vector instructions the tree from node n costs; a load or an
// operation whose scalars all stay (used elsewhere) becomes a gather of
// them when that is cheaper.
fn tree_cost(cx: sink *FnCtx, n: i64) -> i64 {
    unsafe {
        if cx.n_seen.data[n] != 0 {
            return 0;
        }
        cx.n_seen.data[n] = 1;
        let kind = cx.n_kind.data[n];
        if kind != K_OP && kind != K_LOAD {
            return node_cost(cx, n);
        }
        var cost = node_cost(cx, n);
        if kind == K_OP {
            cost += tree_cost(cx, cx.n_a.data[n]);
            if cx.n_b.data[n] >= 0 {
                cost += tree_cost(cx, cx.n_b.data[n]);
            }
        }
        if cost > cx.g_vf && !some_lane_goes(cx, n) {
            cx.n_kind.data[n] = K_GATHER;
            return cx.g_vf;
        }
        cost
    }
}

// Marks the nodes the vector code of node n uses (N_SEEN 2).
fn reach(cx: sink *FnCtx, n: i64) {
    unsafe {
        if cx.n_seen.data[n] == 2 {
            return;
        }
        cx.n_seen.data[n] = 2;
        if cx.n_kind.data[n] == K_OP {
            reach(cx, cx.n_a.data[n]);
            if cx.n_b.data[n] >= 0 {
                reach(cx, cx.n_b.data[n]);
            }
        }
    }
}

// Whether node n is a vector load of the tree.
fn is_tree_load(cx: sink *FnCtx, n: i64) -> bool {
    unsafe { cx.n_kind.data[n] == K_LOAD && cx.n_seen.data[n] == 2 }
}

fn lane_type(t: i64) -> i64 {
    if t == TY_F32 || t == TY_F64 || t == TY_I64 || t == TY_I32 || t == TY_I16 || t == TY_I8 {
        return t;
    }
    if t == TY_U64 { return TY_I64; }
    if t == TY_U32 { return TY_I32; }
    if t == TY_U16 { return TY_I16; }
    if t == TY_U8 { return TY_I8; }
    0
}

fn pos_of(cx: sink *FnCtx, v: i64) -> i64 {
    unsafe {
        if v < cx.table_size && cx.pos_stamp[v] == cx.slp_stamp { cx.pos[v] } else { -1 }
    }
}

fn lane(cx: sink *FnCtx, n: i64, k: i64) -> i64 {
    unsafe { cx.n_lanes.data[n * cx.g_vf + k] }
}

// Whether instruction v is a scalar of the block being looked at.
fn in_block(cx: sink *FnCtx, v: i64) -> bool {
    pos_of(cx, v) >= 0
}

// The node for lanes `lanes` (VF values); -1 when the tree grows too big.
fn build(cx: sink *FnCtx, lanes: *i64, depth: i64) -> i64 {
    unsafe {
        let vf = cx.g_vf;
        // (The same lanes again: the same node.)
        for n in 0..cx.n_kind.count {
            var same = true;
            for k in 0..vf {
                if lane(cx, n, k) != lanes[k] {
                    same = false;
                }
            }
            if same {
                return n;
            }
        }
        if cx.n_kind.count >= SLP_MAX_NODES {
            return -1;
        }
        let n = cx.n_kind.count;
        for k in 0..vf {
            cx.n_lanes.push(lanes[k]);
        }
        cx.n_kind.push(K_GATHER);
        cx.n_a.push(-1);
        cx.n_b.push(-1);
        cx.n_value.push(0);
        let x = lanes[0];
        var all_same = true;
        for k in 1..vf {
            if lanes[k] != x {
                all_same = false;
            }
        }
        for k in 0..vf {
            // (Every lane a value of the lane type.)
            if lane_type(cx.insts[lanes[k]].ty) != lane_type(cx.g_elem) {
                return -1;
            }
        }
        if all_same {
            cx.n_kind.data[n] = K_SPLAT;
            return n;
        }
        // Every lane a scalar of the block, of type T, by one operation.
        let op = cx.insts[x].op;
        var iso = true;
        for k in 0..vf {
            let v = lanes[k];
            if !in_block(cx, v) || cx.insts[v].op != op
                || lane_type(cx.insts[v].ty) != lane_type(cx.g_elem)
                || cx.insts[v].ty != cx.insts[x].ty {
                iso = false;
            }
        }
        if !iso || depth >= SLP_MAX_DEPTH {
            return n;
        }
        if op == Load {
            let size = type_size(cx.g_elem);
            var off0 = cx.insts[x].imm;
            let base = ir_val(cx, address_base(cx, ir_val(cx, cx.insts[x].a), &off0));
            for k in 1..vf {
                var off = cx.insts[lanes[k]].imm;
                let b = ir_val(cx, address_base(cx, ir_val(cx, cx.insts[lanes[k]].a), &off));
                if b != base || off != off0 + k * size {
                    return n;
                }
            }
            cx.n_kind.data[n] = K_LOAD;
            return n;
        }
        let float = is_float(cx.g_elem);
        let ok_op = op == Add || op == Sub || op == Mul || op == Neg
            || (!float && (op == And || op == Or || op == Xor)) || (float && op == Div);
        if !ok_op {
            return n;
        }
        var sub: [i64; 16] = [0; 16];
        for k in 0..vf {
            sub[k] = ir_val(cx, cx.insts[lanes[k]].a);
        }
        let a = build(cx, &sub as *i64, depth + 1);
        if a < 0 {
            return -1;
        }
        var b = -1;
        if op != Neg {
            for k in 0..vf {
                sub[k] = ir_val(cx, cx.insts[lanes[k]].b);
            }
            b = build(cx, &sub as *i64, depth + 1);
            if b < 0 {
                return -1;
            }
        }
        cx.n_kind.data[n] = K_OP;
        cx.n_a.data[n] = a;
        cx.n_b.data[n] = b;
        n
    }
}

// The vector instructions node n costs (an integer multiplication done
// lane by lane: SSE2 has 16-bit lanes only, NEON no 64-bit ones).
fn node_cost(cx: sink *FnCtx, n: i64) -> i64 {
    unsafe {
        let kind = cx.n_kind.data[n];
        if kind == K_GATHER {
            return cx.g_vf;
        }
        if kind == K_OP && cx.insts[lane(cx, n, 0)].op == Mul && !is_float(cx.g_elem) {
            let size = type_size(cx.g_elem);
            let lanewise = if X86 { size != 2 } else { size == 8 };
            if lanewise {
                return 3 * cx.g_vf;
            }
        }
        1
    }
}

fn dead_uses(cx: sink *FnCtx, v: i64) -> i64 {
    unsafe {
        var k = 0;
        while k < cx.dead.count {
            if cx.dead.data[k] == v {
                return cx.dead.data[k + 1];
            }
            k += 2;
        }
        0
    }
}

fn add_dead_use(cx: sink *FnCtx, v: i64) {
    unsafe {
        var k = 0;
        while k < cx.dead.count {
            if cx.dead.data[k] == v {
                cx.dead.data[k + 1] += 1;
                return;
            }
            k += 2;
        }
        cx.dead.push(v);
        cx.dead.push(1);
    }
}

// Whether scalar v goes: every use of it by scalars that go.
fn goes(cx: sink *FnCtx, v: i64) -> bool {
    unsafe { v < cx.table_size && dead_uses(cx, v) == cx.slp_uses[v] }
}

// The scalar instructions the group's vectorization removes: its stores,
// and the tree's scalars (of its loads and operations) whose every use
// goes, found from the stores down (nodes are numbered from the root).
fn scalars_removed(cx: sink *FnCtx) -> i64 {
    unsafe {
        cx.dead.count = 0;
        let vf = cx.g_vf;
        var count = vf;
        for k in 0..vf {
            add_dead_use(cx, ir_val(cx, cx.insts[cx.g_stores[k]].b));
        }
        for n in 0..cx.n_kind.count {
            let kind = cx.n_kind.data[n];
            if kind != K_LOAD && kind != K_OP {
                continue;
            }
            for k in 0..vf {
                let v = lane(cx, n, k);
                if !goes(cx, v) {
                    continue;
                }
                count += 1;
                if kind == K_OP {
                    add_dead_use(cx, ir_val(cx, cx.insts[v].a));
                    if cx.insts[v].op != Neg {
                        add_dead_use(cx, ir_val(cx, cx.insts[v].b));
                    }
                }
            }
        }
        count
    }
}

// The memory an instruction accesses: base, offset, size (for a load or a
// store); false for other instructions.
fn access(cx: sink *FnCtx, v: i64, base: inout i64, off: inout i64, size: inout i64) -> bool {
    unsafe {
        let op = cx.insts[v].op;
        if op != Load && op != Store {
            return false;
        }
        var o = cx.insts[v].imm;
        base = ir_val(cx, address_base(cx, ir_val(cx, cx.insts[v].a), &o));
        off = o;
        size = type_size(if op == Load { cx.insts[v].ty } else { cx.insts[v].imm2 });
        true
    }
}

fn overlap(cx: sink *FnCtx, v: i64, w: i64) -> bool {
    var b1 = 0;
    var o1 = 0;
    var s1 = 0;
    var b2 = 0;
    var o2 = 0;
    var s2 = 0;
    access(cx, v, &b1, &o1, &s1);
    access(cx, w, &b2, &o2, &s2);
    may_alias(cx, b1, o1, s1, b2, o2, s2)
}

fn in_group(cx: sink *FnCtx, v: i64) -> bool {
    unsafe {
        for k in 0..cx.g_vf {
            if cx.g_stores[k] == v {
                return true;
            }
        }
        false
    }
}

fn in_tree_load(cx: sink *FnCtx, v: i64) -> bool {
    unsafe {
        for n in 0..cx.n_kind.count {
            if is_tree_load(cx, n) {
                for k in 0..cx.g_vf {
                    if lane(cx, n, k) == v {
                        return true;
                    }
                }
            }
        }
        false
    }
}

// Whether moving the tree's loads and the group's stores down to the last
// store `last` keeps every access's value (see the top).
fn memory_allows(cx: sink *FnCtx, last: i64) -> bool {
    unsafe {
        let p = pos_of(cx, last);
        // (From the first access moved.)
        var first = p;
        for k in 0..cx.g_vf {
            if pos_of(cx, cx.g_stores[k]) < first {
                first = pos_of(cx, cx.g_stores[k]);
            }
        }
        for n in 0..cx.n_kind.count {
            if is_tree_load(cx, n) {
                for k in 0..cx.g_vf {
                    if pos_of(cx, lane(cx, n, k)) < first {
                        first = pos_of(cx, lane(cx, n, k));
                    }
                }
            }
        }
        var x = cx.blocks[cx.g_block].first;
        while x != 0 && x != last {
            let q = pos_of(cx, x);
            if q < first {
                x = cx.insts[x].next;
                continue;
            }
            let op = cx.insts[x].op;
            let group = op == Store && in_group(cx, x);
            let tree = op == Load && in_tree_load(cx, x);
            if op == Load || op == Store {
                for k in 0..cx.g_vf {
                    // A moved store against an access after it (the tree's
                    // loads: below).
                    let s = cx.g_stores[k];
                    if pos_of(cx, s) < q && !group && !tree && overlap(cx, s, x) {
                        return false;
                    }
                }
                for n in 0..cx.n_kind.count {
                    if !is_tree_load(cx, n) {
                        continue;
                    }
                    for k in 0..cx.g_vf {
                        let l = lane(cx, n, k);
                        // A moved load against a store after it, and against a
                        // store of the group before it (whose value it read).
                        if op == Store && !group && pos_of(cx, l) < q && overlap(cx, x, l) {
                            return false;
                        }
                        if group && q < pos_of(cx, l) && overlap(cx, x, l) {
                            return false;
                        }
                    }
                }
            } else if (op.has_side_effect() || op.is_call()) && q < p {
                return false;
            }
            x = cx.insts[x].next;
        }
        true
    }
}

// The vector of node n, made before instruction `at`.
fn emit_node(cx: sink *FnCtx, n: i64, at: i64) -> i64 {
    unsafe {
        if cx.n_value.data[n] != 0 {
            return cx.n_value.data[n];
        }
        let vt = cx.g_vt;
        let kind = cx.n_kind.data[n];
        let x = lane(cx, n, 0);
        var v = 0;
        if kind == K_SPLAT {
            v = ir_make(cx, VSplat, vt, x, 0, 0);
            ir_insert_before(cx, at, v);
        } else if kind == K_LOAD {
            v = ir_make(cx, Load, vt, ir_val(cx, cx.insts[x].a), 0, cx.insts[x].imm);
            ir_insert_before(cx, at, v);
        } else if kind == K_OP {
            let a = emit_node(cx, cx.n_a.data[n], at);
            let op = cx.insts[x].op;
            if op == Neg {
                v = ir_make(cx, VNeg, vt, a, 0, 0);
            } else {
                let b = emit_node(cx, cx.n_b.data[n], at);
                v = ir_make(cx, VBin, vt, a, b, op as i64);
            }
            ir_insert_before(cx, at, v);
        } else {
            v = ir_make(cx, VSplat, vt, x, 0, 0);
            ir_insert_before(cx, at, v);
            for k in 1..cx.g_vf {
                let w = ir_make(cx, VIns, vt, v, lane(cx, n, k), k);
                ir_insert_before(cx, at, w);
                v = w;
            }
        }
        cx.n_value.data[n] = v;
        v
    }
}

// Tries the group G_STORES (lanes in order of offset); whether it was
// vectorized.
fn try_group(cx: sink *FnCtx) -> bool {
    unsafe {
        cx.n_lanes.count = 0;
        cx.n_kind.count = 0;
        cx.n_a.count = 0;
        cx.n_b.count = 0;
        cx.n_value.count = 0;
        var values: [i64; 16] = [0; 16];
        var last = cx.g_stores[0];
        for k in 0..cx.g_vf {
            values[k] = ir_val(cx, cx.insts[cx.g_stores[k]].b);
            if pos_of(cx, cx.g_stores[k]) > pos_of(cx, last) {
                last = cx.g_stores[k];
            }
        }
        let root = build(cx, &values as *i64, 0);
        if root < 0 || cx.n_kind.data[root] == K_GATHER {
            return false;
        }
        let removed = scalars_removed(cx);
        cx.n_seen.count = 0;
        for _ in 0..cx.n_kind.count {
            cx.n_seen.push(0);
        }
        let cost = 1 + tree_cost(cx, root);
        // (The loads that stay in the tree: N_SEEN 2.)
        reach(cx, root);
        if removed <= cost || !memory_allows(cx, last) {
            return false;
        }
        let v = emit_node(cx, root, last);
        let s = ir_make(cx, Store, 0, ir_val(cx, cx.insts[cx.g_stores[0]].a), v,
            cx.insts[cx.g_stores[0]].imm);
        cx.insts[s].imm2 = cx.g_vt;
        ir_insert_before(cx, last, s);
        for k in 0..cx.g_vf {
            ir_unlink(cx, cx.g_stores[k]);
        }
        true
    }
}

// Looks for groups in block b; whether any was vectorized.
fn slp_block(cx: sink *FnCtx, b: i64) -> bool {
    unsafe {
        cx.slp_stamp += 1;
        var stores = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var i = 0;
        var v = cx.blocks[b].first;
        while v != 0 {
            if v < cx.table_size {
                cx.pos[v] = i;
                cx.pos_stamp[v] = cx.slp_stamp;
            }
            if cx.insts[v].op == Store && lane_type(cx.insts[v].imm2) != 0
                && stores.count < SLP_MAX_STORES {
                stores.push(v);
            }
            i += 1;
            v = cx.insts[v].next;
        }
        var changed = false;
        if stores.count < 2 {
            free(stores.data as *u8);
            return false;
        }
        cx.g_block = b;
        for s in 0..stores.count {
            let st = stores.data[s];
            if cx.insts[st].block != b {
                continue;
            }
            let ty = cx.insts[st].imm2;
            let size = type_size(ty);
            let vf = 16 / size;
            var off0 = 0;
            var b0 = 0;
            var s0 = 0;
            access(cx, st, &b0, &off0, &s0);
            // The other lanes, at off0 + k * size.
            var found = 1;
            cx.g_stores[0] = st;
            for k in 1..vf {
                var lane_store = 0;
                for t in 0..stores.count {
                    let w = stores.data[t];
                    if w == st || cx.insts[w].block != b || cx.insts[w].imm2 != ty {
                        continue;
                    }
                    var bw = 0;
                    var ow = 0;
                    var sw = 0;
                    access(cx, w, &bw, &ow, &sw);
                    if bw == b0 && ow == off0 + k * size {
                        lane_store = w;
                    }
                }
                if lane_store == 0 {
                    break;
                }
                cx.g_stores[k] = lane_store;
                found += 1;
            }
            if found != vf {
                continue;
            }
            cx.g_vf = vf;
            cx.g_elem = ty;
            cx.g_vt = vector_type(lane_type(ty), vf);
            if cx.g_vt == 0 {
                continue;
            }
            if try_group(cx) {
                changed = true;
                // (Positions: the new instructions have none, which the
                // later groups' checks treat as outside; renumber.)
                cx.slp_stamp += 1;
                var j = 0;
                var x = cx.blocks[b].first;
                while x != 0 {
                    if x < cx.table_size {
                        cx.pos[x] = j;
                        cx.pos_stamp[x] = cx.slp_stamp;
                    }
                    j += 1;
                    x = cx.insts[x].next;
                }
            }
        }
        free(stores.data as *u8);
        changed
    }
}

// USES, POS and POS_STAMP, indexed by instruction, as large as the
// function's instructions are now, with room for a half more. (0.17: ids
// are local to each function, so slp_block's new instructions can pass a
// size taken once at the pass's start; count_uses runs after each block
// that made some.)
fn grow_tables(cx: sink *FnCtx) {
    unsafe {
        if cx.table_size < cx.inst_count {
            if cx.table_size > 0 {
                free(cx.slp_uses as *u8);
                free(cx.pos as *u8);
                free(cx.pos_stamp as *u8);
            }
            cx.table_size = cx.inst_count + cx.inst_count / 2;
            cx.slp_uses = alloc_array::<i64>(cx.table_size);
            cx.pos = alloc_array::<i64>(cx.table_size);
            cx.pos_stamp = alloc_array::<i64>(cx.table_size);
        }
    }
}

// Counts the uses of every instruction of fi (the tables grown first).
fn count_uses(cx: sink *FnCtx, fi: i64) {
    unsafe {
        grow_tables(cx);
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            var v = cx.blocks[b].first;
            while v != 0 {
                cx.slp_uses[v] = 0;
                v = cx.insts[v].next;
            }
        }
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            var v = cx.blocks[b].first;
            while v != 0 {
                for k in 0..ir_operand_count(cx, v) {
                    let w = ir_operand(cx, v, k);
                    if w != 0 {
                        cx.slp_uses[ir_val(cx, w)] += 1;
                    }
                }
                v = cx.insts[v].next;
            }
            if cx.blocks[b].cond != 0 {
                cx.slp_uses[ir_val(cx, cx.blocks[b].cond)] += 1;
            }
        }
    }
}

// Whether block b has two stores of one lane type, one base and adjacent
// offsets (a cheap first look).
fn has_candidates(cx: sink *FnCtx, b: i64) -> bool {
    unsafe {
        var seen: [i64; 48] = [0; 48];
        var n = 0;
        var v = cx.blocks[b].first;
        while v != 0 && n < 16 {
            if cx.insts[v].op == Store && lane_type(cx.insts[v].imm2) != 0 {
                let ty = cx.insts[v].imm2;
                var off = cx.insts[v].imm;
                let base = ir_val(cx, address_base(cx, ir_val(cx, cx.insts[v].a), &off));
                let size = type_size(ty);
                for k in 0..n {
                    if seen[3 * k] == base && seen[3 * k + 2] == ty
                        && (seen[3 * k + 1] == off + size || seen[3 * k + 1] + size == off) {
                        return true;
                    }
                }
                seen[3 * n] = base;
                seen[3 * n + 1] = off;
                seen[3 * n + 2] = ty;
                n += 1;
            }
            v = cx.insts[v].next;
        }
        false
    }
}

// Vectorizes the store groups of fi; returns whether any was.
pub fn slp_vectorize(cx: sink *FnCtx, fi: i64) -> bool {
    unsafe {
        if !SLP {
            return false;
        }
        ir_enter(cx, fi);
        var any = false;
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed == 0 && has_candidates(cx, b) {
                any = true;
            }
        }
        if !any {
            return false;
        }
        find_escaping_slots(cx, fi);
        count_uses(cx, fi);
        var changed = false;
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed == 0 && has_candidates(cx, b) && slp_block(cx, b) {
                changed = true;
                count_uses(cx, fi);
            }
        }
        changed
    }
}
