// Copy elision (0.14): a whole frame slot copied into another (all of it,
// or a part at a constant offset: a field), by a copy that runs once (in
// no loop), where the source is only used before the copy, and the part
// of the destination only after it, is that part: the source's uses use
// it, and the copy goes. Adapters taking `self: Self` make these chains:
// each level of an iterator chain copies the level below into its own
// struct (memcpy calls above INLINE_COPY_MAX bytes, which scalar
// replacement does not look through). Neither slot's address may escape
// (gvn.vl's find_escaping_slots).

use crate::base::IntVec;

use crate::middle::ir::{
    IRFUNCS, Op, Term, ir_arg, ir_enter, ir_insert_before, ir_make, ir_operand, ir_operand_count,
    ir_replace, ir_unlink, ir_val,
};

use crate::middle::gvn::{address_base, copy_dst, copy_src, find_escaping_slots, is_copy, root_of};

use crate::middle::opt::{dominates, resolve_all};

use crate::back::abi::fn_uses_c;
use crate::front::ast::{NODES, NodeKind};
use crate::front::own::diag::{MODE_ERROR, OWN_MODE};
use crate::front::types::{TY_U64, type_size};
use crate::middle::ctx::FnCtx;
use crate::middle::loops::{analyze_loops, innermost_loop};

// (0.17) The copies that are moves (COPY_MOVE): `let w = v` of an owned
// local under --values=error, (function, instruction) pairs, noted by the
// lowering (lower_let). The own pass guarantees v is not read again before
// it is initialized again, and a move in a loop needs v initialized again
// before the next one: with every other use of v before the copy (as
// elidable requires), v is written whole in each iteration before it is
// moved, so such a copy is elided in a loop too.
static var MOVE_COPIES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Whether expression n moves an owned local (`let w = v`): its value is
// v's, which nothing reads until v is initialized again.
pub fn moves_local(n: i64) -> bool {
    unsafe {
        OWN_MODE == MODE_ERROR && NODES[n].kind == NodeKind::Ident
            && NODES[n].res == crate::front::check::Res::Local
            && (crate::front::own::kinds::type_kind(NODES[n].ty)
                & crate::front::own::kinds::K_OWNED) != 0
    }
}

// Notes the copies the lowering made since instruction `first` of the
// current function as moves.
pub fn note_move_copies(cx: sink *FnCtx, first: i64) {
    unsafe {
        for v in first..cx.inst_count {
            if cx.insts[v].block != 0 && is_copy(cx, v) {
                MOVE_COPIES.push(cx.irf);
                MOVE_COPIES.push(v);
            }
        }
    }
}

fn is_move_copy(fi: i64, c: i64) -> bool {
    unsafe {
        for i in 0..MOVE_COPIES.count / 2 {
            if MOVE_COPIES.data[2 * i] == fi && MOVE_COPIES.data[2 * i + 1] == c {
                return true;
            }
        }
        false
    }
}

// (0.18.1, back::codecache) The copies noted as moves: (IR function,
// instruction) pairs.
pub fn move_copies() -> *IntVec {
    unsafe { &MOVE_COPIES }
}

// The slot that address v is the start of (a SLOT instruction), or -1.
fn whole_slot(cx: sink *FnCtx, v: i64) -> i64 {
    unsafe {
        let x = ir_val(cx, v);
        if cx.insts[x].op == Op::Slot { cx.insts[x].imm } else { -1 }
    }
}

// The slot address v points into at a constant offset (in *offset), or -1.
fn slot_at(cx: sink *FnCtx, v: i64, offset: inout i64) -> i64 {
    unsafe {
        let base = address_base(cx, ir_val(cx, v), &offset);
        if cx.insts[base].op == Op::Slot { cx.insts[base].imm } else { -1 }
    }
}

// The size copy v moves (a constant).
fn copy_size(cx: sink *FnCtx, v: i64) -> i64 {
    unsafe {
        if cx.insts[v].op == Op::Copy { cx.insts[v].imm }
        else { cx.insts[ir_val(cx, ir_arg(cx, v, 2))].imm }
    }
}

// Whether instruction u comes strictly before instruction v (u's block
// dominates v's; INSTS[].aux numbers each block's instructions).
fn before(cx: sink *FnCtx, u: i64, v: i64) -> bool {
    unsafe {
        let bu = cx.insts[u].block;
        let bv = cx.insts[v].block;
        if bu == bv { cx.insts[u].aux < cx.insts[v].aux } else { dominates(cx, bu, bv) }
    }
}

// Whether instruction u accesses no byte of slot d in [lo, hi): a load,
// store or copy at constant offsets elsewhere (an address computation is
// not an access: its own uses are).
fn misses(cx: sink *FnCtx, u: i64, d: i64, lo: i64, hi: i64) -> bool {
    unsafe {
        let op = cx.insts[u].op;
        if op == Op::Add {
            return true;
        }
        var addrs = 0;
        var size = 0;
        if op == Op::Load {
            addrs = 1;
            size = type_size(cx.insts[u].ty);
        } else if op == Op::Store {
            addrs = 1;
            size = type_size(cx.insts[u].imm2);
        } else if is_copy(cx, u) {
            addrs = 2;
            size = copy_size(cx, u);
        } else {
            return false;
        }
        for k in 0..addrs {
            let a = if op == Op::Load || op == Op::Store { cx.insts[u].a }
                else if k == 0 { copy_dst(cx, u) } else { copy_src(cx, u) };
            let root = root_of(cx, ir_val(cx, a));
            if root == 0 || cx.insts[root].op != Op::Slot || cx.insts[root].imm != d {
                continue;
            }
            var offset = 0;
            if slot_at(cx, a, &offset) != d {
                return false;
            }
            if op == Op::Load || op == Op::Store {
                offset += cx.insts[u].imm;
            }
            if offset < hi && offset + size > lo {
                return false;
            }
        }
        true
    }
}

// Whether copy c of slot s to slot d at `offset` can be elided: every
// other use of s comes before it, every use of d's part after it (or
// before, elsewhere in d).
fn elidable(cx: sink *FnCtx, c: i64, s: i64, d: i64, offset: i64) -> bool {
    unsafe {
        let n = cx.slots[s].size;
        for k in 0..cx.copies_uses.count / 2 {
            let slot = cx.copies_uses.data[2 * k];
            let u = cx.copies_uses.data[2 * k + 1];
            if u == c || cx.insts[u].block == 0 {
                continue;
            }
            if slot == s && !before(cx, u, c) {
                return false;
            }
            if slot == d && !before(cx, c, u)
                && !(before(cx, u, c) && misses(cx, u, d, offset, offset + n)) {
                return false;
            }
        }
        true
    }
}

// Slot s becomes the part of slot d at `offset`: its SLOT instructions
// compute that address.
fn place_slot(cx: sink *FnCtx, fi: i64, s: i64, d: i64, offset: i64) {
    unsafe {
        for j in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[j];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            var v = cx.blocks[b].first;
            while v != 0 {
                if cx.insts[v].op == Op::Slot && cx.insts[v].imm == s {
                    if offset == 0 {
                        cx.insts[v].imm = d;
                    } else {
                        let base = ir_make(cx, Op::Slot, TY_U64, 0, 0, d);
                        let k = ir_make(cx, Op::Const, TY_U64, 0, 0, offset);
                        ir_insert_before(cx, v, base);
                        ir_insert_before(cx, v, k);
                        cx.insts[base].aux = cx.insts[v].aux;
                        cx.insts[k].aux = cx.insts[v].aux;
                        cx.insts[v].op = Op::Add;
                        cx.insts[v].a = base;
                        cx.insts[v].b = k;
                        cx.insts[v].imm = 0;
                    }
                }
                v = cx.insts[v].next;
            }
        }
        for k in 0..cx.copies_uses.count / 2 {
            if cx.copies_uses.data[2 * k] == s {
                cx.copies_uses.data[2 * k] = d;
            }
        }
        if cx.slots[s].align > cx.slots[d].align {
            cx.slots[d].align = cx.slots[s].align;
        }
    }
}

// (0.17) The returned local is the result (NRVO): in a function returning a
// compound value through the result pointer, a local slot s that every
// return copies into it (and nothing else touches the result's memory)
// becomes that memory, and the copies go. The caller's result is a fresh
// slot of its own (lower/calls.vl), which nothing else the function
// sees can reach. Only for copies that are memcpy calls (over
// INLINE_COPY_MAX bytes): smaller locals are scalar replacement's, which
// the result's memory would stop. A copy must end its block, which returns,
// so that nothing reads or writes s after it (a defer after the copy).
fn elide_result_copy(cx: sink *FnCtx, fi: i64) -> bool {
    unsafe {
        let f = IRFUNCS[fi].f;
        let result = IRFUNCS[fi].result_ptr;
        if result == 0 || f < 0 || fn_uses_c(f) {
            return false;
        }
        let r = ir_val(cx, result);
        cx.candidates.count = 0;
        var s = -1;
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            var v = cx.blocks[b].first;
            while v != 0 {
                for k in 0..ir_operand_count(cx, v) {
                    let w = ir_operand(cx, v, k);
                    if w == 0 || ir_val(cx, w) != r {
                        continue;
                    }
                    // The destination of a memcpy (its first argument).
                    if !(is_copy(cx, v) && cx.insts[v].op != Op::Copy && k == 3) {
                        return false;
                    }
                    let src = whole_slot(cx, copy_src(cx, v));
                    if src < 0 || s >= 0 && src != s || cx.slots[src].size != copy_size(cx, v)
                        || cx.insts[v].next != 0 || cx.blocks[b].term != Term::Ret {
                        return false;
                    }
                    s = src;
                    cx.candidates.push(v);
                }
                v = cx.insts[v].next;
            }
        }
        if s < 0 || cx.slots[s].align > 8 {
            return false;
        }
        find_escaping_slots(cx, fi);
        if cx.slots[s].escapes != 0 {
            return false;
        }
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            var v = cx.blocks[b].first;
            while v != 0 {
                let next = cx.insts[v].next;
                if cx.insts[v].op == Op::Slot && cx.insts[v].imm == s {
                    ir_replace(cx, v, r);
                }
                v = next;
            }
        }
        for i in 0..cx.candidates.count {
            ir_unlink(cx, cx.candidates.data[i]);
        }
        cx.candidates.count = 0;
        resolve_all(cx, fi);
        true
    }
}

// Elides the copies of function fi that can be. Returns whether any was.
pub fn elide_copies(cx: sink *FnCtx, fi: i64) -> bool {
    unsafe {
        ir_enter(cx, fi);
        let nrvo = elide_result_copy(cx, fi);
        cx.candidates.count = 0;
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            var v = cx.blocks[b].first;
            while v != 0 {
                if is_copy(cx, v) {
                    var offset = 0;
                    let d = slot_at(cx, copy_dst(cx, v), &offset);
                    let s = whole_slot(cx, copy_src(cx, v));
                    let n = copy_size(cx, v);
                    if d >= 0 && s >= 0 && d != s && cx.slots[s].size == n
                        && offset >= 0 && offset + n <= cx.slots[d].size {
                        cx.candidates.push(v);
                    }
                }
                v = cx.insts[v].next;
            }
        }
        if cx.candidates.count == 0 {
            return nrvo;
        }
        resolve_all(cx, fi);
        find_escaping_slots(cx, fi);
        analyze_loops(cx, fi);
        // The uses of the slots' addresses; the instructions numbered.
        cx.copies_uses.count = 0;
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            var n = 0;
            var v = cx.blocks[b].first;
            while v != 0 {
                cx.insts[v].aux = n;
                n += 1;
                for k in 0..ir_operand_count(cx, v) {
                    let w = ir_operand(cx, v, k);
                    if w == 0 {
                        continue;
                    }
                    let root = root_of(cx, ir_val(cx, w));
                    if root != 0 && cx.insts[root].op == Op::Slot {
                        cx.copies_uses.push(cx.insts[root].imm);
                        cx.copies_uses.push(v);
                    }
                }
                v = cx.insts[v].next;
            }
        }
        var changed = false;
        for i in 0..cx.candidates.count {
            let c = cx.candidates.data[i];
            var offset = 0;
            let d = slot_at(cx, copy_dst(cx, c), &offset);
            let s = whole_slot(cx, copy_src(cx, c));
            let b = cx.insts[c].block;
            if d < 0 || s < 0 || d == s || cx.slots[d].escapes != 0 || cx.slots[s].escapes != 0
                || offset % cx.slots[s].align != 0 || cx.blocks[b].order < 0
                || innermost_loop(cx, b) >= 0 && !is_move_copy(fi, c)
                || !elidable(cx, c, s, d, offset) {
                continue;
            }
            place_slot(cx, fi, s, d, offset);
            ir_unlink(cx, c);
            changed = true;
        }
        if changed {
            resolve_all(cx, fi);
        }
        changed || nrvo
    }
}
