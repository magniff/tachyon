// Printing the IR as text (--print-ir, --print-after-all, the verifier's
// failures): values, instructions, blocks and whole functions.

use crate::base::{buf_byte, buf_hex, buf_int, buf_str, sym_name};
use crate::front::types::{FNS, buf_type, is_float};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{IRFUNCS, Op, Term, ir_operand, ir_operand_count, ir_val};
use crate::middle::ir::Op::{
    Call, CallC, Cmp, Const, Conv, Copy, FAddr, GAddr, Load, Param, Piece, SAddr, Select, Store,
    Test, VBin, VCmp, VExt, VIns,
};
use crate::middle::ir::cfg::{case_target, case_value};
use crate::middle::parallel::const_data_id;

pub fn buf_value(out: i64, v: i64) {
    if v == 0 {
        unsafe { buf_str(out, c"_"); }
        return;
    }
    buf_byte(out, 'v');
    buf_int(out, v);
}

fn buf_ir_type(out: i64, t: i64) {
    if t == 0 {
        unsafe { buf_str(out, c"void"); }
    } else {
        buf_type(out, t);
    }
}

fn print_inst(mut cx: *FnCtx, out: i64, v: i64) {
    unsafe {
        let op = cx.insts[v].op;
        buf_str(out, c"    ");
        if cx.insts[v].ty != 0 {
            buf_value(out, v);
            buf_str(out, c": ");
            buf_ir_type(out, cx.insts[v].ty);
            buf_str(out, c" = ");
        }
        buf_str(out, op.name());
        if op == Cmp || op == Test || op == Select || op == VCmp {
            buf_byte(out, '.');
            buf_str(out, cx.insts[v].cond.name());
        }
        if op == Op::Bits {
            buf_str(out,
                if cx.insts[v].imm == 0 { c".ones" } else if cx.insts[v].imm == 1 { c".leading" }
                else { c".trailing" });
        }
        if op == VBin {
            buf_byte(out, '.');
            let raw = cx.insts[v].imm;
            let bop = raw as Op;
            buf_str(out, bop.name());
        }
        if op == Const {
            buf_byte(out, ' ');
            if is_float(cx.insts[v].ty) {
                buf_str(out, c"0x");
                buf_hex(out, cx.insts[v].imm as u64, 16);
            } else {
                buf_int(out, cx.insts[v].imm);
            }
        } else if op == GAddr || op == CallC {
            buf_byte(out, ' ');
            buf_str(out, sym_name(cx.insts[v].imm));
        } else if op == Call || op == FAddr {
            buf_byte(out, ' ');
            buf_str(out, sym_name(FNS[cx.insts[v].imm].name));
        } else if op == SAddr {
            buf_byte(out, ' ');
            buf_int(out, const_data_id(cx.insts[v].imm));
        } else if op == Param || op == Op::Slot || op == Piece {
            buf_byte(out, ' ');
            buf_int(out, cx.insts[v].imm);
        }
        let mut first = true;
        for i in 0..ir_operand_count(cx, v) {
            let operand = ir_operand(cx, v, i);
            if operand == 0 && i < 3 {
                continue;
            }
            buf_str(out, if first { c" " } else { c", " });
            first = false;
            buf_value(out, ir_val(cx, operand));
        }
        if op == Load || op == Store {
            if cx.insts[v].imm != 0 {
                buf_str(out, c" +");
                buf_int(out, cx.insts[v].imm);
            }
            if op == Store {
                buf_byte(out, ' ');
                buf_ir_type(out, cx.insts[v].imm2);
            }
        } else if op == Copy {
            buf_str(out, c" size ");
            buf_int(out, cx.insts[v].imm);
        } else if op == Conv || op == Cmp || op == VCmp {
            buf_str(out, c" from ");
            buf_ir_type(out, cx.insts[v].imm2);
        } else if op == VExt || op == VIns {
            buf_str(out, c" lane ");
            buf_int(out, cx.insts[v].imm);
        } else if op.is_machine() {
            // imm, imm2 and scale as they are (see isel.tach).
            buf_str(out, c" [");
            buf_int(out, cx.insts[v].imm);
            buf_str(out, c", ");
            buf_int(out, cx.insts[v].imm2);
            buf_str(out, c", ");
            buf_int(out, cx.insts[v].scale);
            buf_byte(out, ']');
        }
        buf_byte(out, '\n');
    }
}

pub fn buf_block(out: i64, b: i64) {
    buf_byte(out, 'b');
    buf_int(out, b);
}

fn print_block(mut cx: *FnCtx, out: i64, b: i64) {
    unsafe {
        buf_block(out, b);
        if cx.blocks[b].preds.count > 0 {
            buf_str(out, c" <-");
            for i in 0..cx.blocks[b].preds.count {
                buf_byte(out, ' ');
                buf_block(out, cx.blocks[b].preds.data[i]);
            }
        }
        buf_str(out, c":\n");
        let mut v = cx.blocks[b].first;
        while v != 0 {
            print_inst(cx, out, v);
            v = cx.insts[v].next;
        }
        let term = cx.blocks[b].term;
        buf_str(out, c"    ");
        if term == Term::Jump {
            buf_str(out, c"jump ");
            buf_block(out, cx.blocks[b].s0);
        } else if term == Term::Branch {
            buf_str(out, c"branch ");
            buf_value(out, ir_val(cx, cx.blocks[b].cond));
            buf_str(out, c", ");
            buf_block(out, cx.blocks[b].s0);
            buf_str(out, c", ");
            buf_block(out, cx.blocks[b].s1);
        } else if term == Term::Ret {
            buf_str(out, c"ret");
            if cx.blocks[b].cond != 0 {
                buf_byte(out, ' ');
                buf_value(out, ir_val(cx, cx.blocks[b].cond));
            }
        } else if term == Term::Unreach {
            buf_str(out, c"unreachable");
        } else if term == Term::Switch {
            buf_str(out, c"switch ");
            buf_value(out, ir_val(cx, cx.blocks[b].cond));
            buf_str(out, c", default ");
            buf_block(out, cx.blocks[b].s0);
            for i in 0..cx.blocks[b].ncases {
                buf_str(out, c", ");
                buf_int(out, case_value(cx, b, i));
                buf_str(out, c" -> ");
                buf_block(out, case_target(cx, b, i));
            }
        } else {
            buf_str(out, c"(no terminator)");
        }
        buf_byte(out, '\n');
    }
}

pub fn print_ir_func(mut cx: *FnCtx, out: i64, fi: i64) {
    unsafe {
        buf_str(out, c"fn ");
        buf_str(out, sym_name(FNS[IRFUNCS[fi].f].name));
        buf_str(out, c":\n");
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed == 0 {
                print_block(cx, out, b);
            }
        }
        buf_byte(out, '\n');
    }
}
