// Block terminators and the edges of the control flow graph: ending a
// block (jump, branch, return, switch), walking and redirecting its
// successors, the cases of a switch, and the index of a predecessor.

use crate::middle::ctx::FnCtx;
use crate::middle::ir::Term;

// ---- Terminators ----

fn ir_add_pred(cx: sink *FnCtx, b: i64, pred: i64) {
    unsafe { cx.blocks[b].preds.push(pred); }
}

// Ends block `b`.
pub fn ir_terminate(cx: sink *FnCtx, b: i64, term: Term, cond: i64, s0: i64, s1: i64) {
    unsafe {
        cx.blocks[b].term = term;
        cx.blocks[b].cond = cond;
        cx.blocks[b].s0 = s0;
        cx.blocks[b].s1 = s1;
    }
    if s0 != 0 {
        ir_add_pred(cx, s0, b);
    }
    if s1 != 0 {
        ir_add_pred(cx, s1, b);
    }
}

pub fn succ_count(cx: sink *FnCtx, b: i64) -> i64 {
    unsafe {
        let term = cx.blocks[b].term;
        if term == Term::Jump { return 1; }
        if term == Term::Branch { return 2; }
        if term == Term::Switch { return cx.blocks[b].nsucc; }
        0
    }
}

pub fn succ(cx: sink *FnCtx, b: i64, i: i64) -> i64 {
    unsafe {
        if cx.blocks[b].term == Term::Switch {
            return cx.swcases.data[cx.blocks[b].succs + i];
        }
        if i == 0 { cx.blocks[b].s0 } else { cx.blocks[b].s1 }
    }
}

// Whether s is a successor of b.
pub fn is_succ(cx: sink *FnCtx, b: i64, s: i64) -> bool {
    for i in 0..succ_count(cx, b) {
        if succ(cx, b, i) == s {
            return true;
        }
    }
    false
}

pub fn case_value(cx: sink *FnCtx, b: i64, i: i64) -> i64 {
    unsafe { cx.swcases.data[cx.blocks[b].cases + 2 * i] }
}

pub fn case_target(cx: sink *FnCtx, b: i64, i: i64) -> i64 {
    unsafe { cx.swcases.data[cx.blocks[b].cases + 2 * i + 1] }
}

// Ends block b with a switch on `value`: `count` cases as (value, block)
// pairs at SSA_STACK[mark..], popped, and the default block.
pub fn ir_switch(cx: sink *FnCtx, b: i64, value: i64, default: i64, mark: i64) {
    ir_switch_no_preds(cx, b, value, default, mark);
    unsafe {
        for i in 0..cx.blocks[b].nsucc {
            ir_add_pred(cx, succ(cx, b, i), b);
        }
    }
}

// The same, without adding b to the predecessors of its successors.
pub fn ir_switch_no_preds(cx: sink *FnCtx, b: i64, value: i64, default: i64, mark: i64) {
    unsafe {
        let count = (cx.ssa_stack.count - mark) / 2;
        cx.blocks[b].term = Term::Switch;
        cx.blocks[b].cond = value;
        cx.blocks[b].s0 = default;
        cx.blocks[b].s1 = 0;
        cx.blocks[b].cases = cx.swcases.count;
        cx.blocks[b].ncases = count;
        for i in 0..2 * count {
            cx.swcases.push(cx.ssa_stack.data[mark + i]);
        }
        cx.ssa_stack.count = mark;
        switch_rebuild_succs(cx, b);
    }
}

// Rebuilds the list of distinct successors of switch b (the default
// first, then in case order).
pub fn switch_rebuild_succs(cx: sink *FnCtx, b: i64) {
    unsafe {
        let start = cx.swcases.count;
        cx.swcases.push(cx.blocks[b].s0);
        for i in 0..cx.blocks[b].ncases {
            let t = case_target(cx, b, i);
            var seen = false;
            for k in start..cx.swcases.count {
                if cx.swcases.data[k] == t {
                    seen = true;
                }
            }
            if !seen {
                cx.swcases.push(t);
            }
        }
        cx.blocks[b].succs = start;
        cx.blocks[b].nsucc = cx.swcases.count - start;
    }
}

// The block switch b goes to for the constant `value`.
pub fn switch_target(cx: sink *FnCtx, b: i64, value: i64) -> i64 {
    unsafe {
        for i in 0..cx.blocks[b].ncases {
            if case_value(cx, b, i) == value {
                return case_target(cx, b, i);
            }
        }
        cx.blocks[b].s0
    }
}

// Makes the edge from b to `from` go to `to` (the predecessor lists are
// the caller's business). A switch whose cases already reach `to` is not
// changed (that would make two edges into `to`): returns false.
pub fn redirect_succ(cx: sink *FnCtx, b: i64, from: i64, to: i64) -> bool {
    unsafe {
        let term = cx.blocks[b].term;
        if term == Term::Switch {
            if is_succ(cx, b, to) {
                return false;
            }
            let start = cx.swcases.count;
            for i in 0..cx.blocks[b].ncases {
                cx.swcases.push(case_value(cx, b, i));
                let t = case_target(cx, b, i);
                cx.swcases.push(if t == from { to } else { t });
            }
            cx.blocks[b].cases = start;
            if cx.blocks[b].s0 == from {
                cx.blocks[b].s0 = to;
            }
            switch_rebuild_succs(cx, b);
            return true;
        }
        if cx.blocks[b].s0 == from {
            cx.blocks[b].s0 = to;
        }
        if term == Term::Branch && cx.blocks[b].s1 == from {
            cx.blocks[b].s1 = to;
        }
        true
    }
}

// Copies the terminator of block `from` to block `to` (successors as they
// are; the predecessor lists are the caller's business).
pub fn copy_terminator(cx: sink *FnCtx, to: i64, from: i64) {
    unsafe {
        cx.blocks[to].term = cx.blocks[from].term;
        cx.blocks[to].cond = cx.blocks[from].cond;
        cx.blocks[to].s0 = cx.blocks[from].s0;
        cx.blocks[to].s1 = cx.blocks[from].s1;
        cx.blocks[to].cases = cx.blocks[from].cases;
        cx.blocks[to].ncases = cx.blocks[from].ncases;
        cx.blocks[to].succs = cx.blocks[from].succs;
        cx.blocks[to].nsucc = cx.blocks[from].nsucc;
    }
}

// The index of `pred` among the predecessors of `b`, or -1.
pub fn pred_index(cx: sink *FnCtx, b: i64, pred: i64) -> i64 {
    unsafe {
        for i in 0..cx.blocks[b].preds.count {
            if cx.blocks[b].preds.data[i] == pred {
                return i;
            }
        }
    }
    -1
}
