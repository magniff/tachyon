// The IR verifier (--verify-ir): checks the structure of a function after
// each pass (terminators, predecessor lists, phis, operands dominating
// their uses) and stops with the function printed when it is broken.

use crate::arch::{INTRS, intr_param_is_const, intrinsic_count};
use crate::base::{STDERR, buf_byte, buf_new, buf_str, buf_write_fd, exit, sym_name};
use crate::front::types::{FNS, TY_BOOL};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{IRFUNCS, Op, Term, ir_arg, ir_operand, ir_operand_count};
use crate::middle::ir::Op::Phi;
use crate::middle::ir::cfg::{case_target, case_value, is_succ, pred_index, succ, succ_count};
use crate::middle::ir::print::{buf_block, buf_value, print_ir_func};
use crate::middle::opt::{compute_dominators, dominates};

pub static mut VERIFY_IR: bool = false;

// --print-after-all: the IR of each function after each pass, on stderr.
pub static mut PRINT_AFTER_ALL: bool = false;

fn ir_fail(mut cx: *FnCtx, fi: i64, b: i64, v: i64, message: *u8) -> ! {
    unsafe {
        let out = buf_new();
        buf_str(out, c"internal error: invalid IR after ");
        buf_str(out, cx.verify_pass);
        buf_str(out, c" in fn ");
        buf_str(out, sym_name(FNS[IRFUNCS[fi].f].name));
        buf_str(out, c", ");
        buf_block(out, b);
        if v != 0 {
            buf_str(out, c", ");
            buf_value(out, v);
        }
        buf_str(out, c": ");
        buf_str(out, message);
        buf_byte(out, '\n');
        print_ir_func(cx, out, fi);
        buf_write_fd(out, STDERR);
        exit(101)
    }
}

// Checks the structure of function `fi`: terminators, predecessor lists,
// phis, and that every operand is a live instruction that dominates its
// use (dominators must be up to date: see compute_dominators).
pub fn verify_func(mut cx: *FnCtx, fi: i64, pass: *u8) {
    unsafe {
        if PRINT_AFTER_ALL {
            let out = buf_new();
            buf_str(out, c"; after ");
            buf_str(out, pass);
            buf_byte(out, '\n');
            print_ir_func(cx, out, fi);
            buf_write_fd(out, STDERR);
        }
        if !VERIFY_IR {
            return;
        }
        cx.verify_pass = pass;
        // (0.17: ids are each function's; a pass reading another
        // function's tables than its own would read the wrong IR)
        if cx.ir_cur != fi {
            ir_fail(cx, fi, 0, 0, c"the function's tables are not the current ones");
        }
        compute_dominators(cx, fi);
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed == 0 {
                verify_block(cx, fi, b);
            }
        }
    }
}

fn verify_block(mut cx: *FnCtx, fi: i64, b: i64) {
    unsafe {
        let term = cx.blocks[b].term;
        if term == Term::None {
            ir_fail(cx, fi, b, 0, c"no terminator");
        }
        for i in 0..succ_count(cx, b) {
            let s = succ(cx, b, i);
            if cx.blocks[s].removed != 0 {
                ir_fail(cx, fi, b, 0, c"successor removed");
            }
            if pred_index(cx, s, b) < 0 {
                ir_fail(cx, fi, b, 0, c"not a predecessor of its successor");
            }
        }
        for i in 0..cx.blocks[b].preds.count {
            let p = cx.blocks[b].preds.data[i];
            if cx.blocks[p].removed != 0 {
                ir_fail(cx, fi, b, 0, c"predecessor removed");
            }
            if !is_succ(cx, p, b) {
                ir_fail(cx, fi, b, 0, c"predecessor does not branch here");
            }
            for j in 0..i {
                if cx.blocks[b].preds.data[j] == p && cx.blocks[p].term == Term::Switch {
                    ir_fail(cx, fi, b, 0, c"a switch is a predecessor twice");
                }
            }
        }
        let reachable = cx.blocks[b].order >= 0;
        let mut v = cx.blocks[b].first;
        let mut past_phis = false;
        while v != 0 {
            if cx.insts[v].block != b {
                ir_fail(cx, fi, b, v, c"instruction list broken");
            }
            if cx.insts[v].repl != 0 {
                ir_fail(cx, fi, b, v, c"replaced instruction still in a block");
            }
            let op = cx.insts[v].op;
            if op == Op::Intr || op == Op::CpuFeat {
                verify_arch(cx, fi, b, v);
            }
            if op == Phi {
                if past_phis {
                    ir_fail(cx, fi, b, v, c"phi after a non-phi instruction");
                }
                if cx.insts[v].nargs != cx.blocks[b].preds.count {
                    ir_fail(cx, fi, b, v, c"phi operand count differs from the predecessor count");
                }
                for k in 0..cx.insts[v].nargs {
                    verify_operand(cx, fi, b, v, ir_arg(cx, v, k), cx.blocks[b].preds.data[k],
                        reachable);
                }
            } else {
                past_phis = true;
                for k in 0..ir_operand_count(cx, v) {
                    let operand = ir_operand(cx, v, k);
                    if operand != 0 {
                        verify_operand(cx, fi, b, v, operand, b, reachable);
                    }
                }
            }
            v = cx.insts[v].next;
        }
        if (term == Term::Branch || term == Term::Ret || term == Term::Switch)
            && cx.blocks[b].cond != 0 {
            verify_operand(cx, fi, b, 0, cx.blocks[b].cond, b, reachable);
        }
        if (term == Term::Branch || term == Term::Switch) && cx.blocks[b].cond == 0 {
            ir_fail(cx, fi, b, 0, c"branch without a condition");
        }
        if term == Term::Switch {
            if !is_succ(cx, b, cx.blocks[b].s0) {
                ir_fail(cx, fi, b, 0, c"switch default not among its successors");
            }
            for i in 0..cx.blocks[b].ncases {
                if !is_succ(cx, b, case_target(cx, b, i)) {
                    ir_fail(cx, fi, b, 0, c"switch case not among its successors");
                }
                for j in 0..i {
                    if case_value(cx, b, j) == case_value(cx, b, i) {
                        ir_fail(cx, fi, b, 0, c"switch case value repeated");
                    }
                }
            }
        }
    }
}

// (0.19) The intrinsics' operations: an INTR names an intrinsic of the
// tables and has one operand per register parameter; a CPUFEAT is a bool
// of a feature's bit.
fn verify_arch(mut cx: *FnCtx, fi: i64, b: i64, v: i64) {
    unsafe {
        let op = cx.insts[v].op;
        if op == Op::Intr {
            let id = cx.insts[v].imm;
            if id < 0 || id >= intrinsic_count() {
                ir_fail(cx, fi, b, v, c"intr of no intrinsic");
            }
            let mut want = 0;
            for k in 0..INTRS[id].nparams {
                if !intr_param_is_const(id, k) {
                    want += 1;
                }
            }
            let mut have = 0;
            for k in 0..3 {
                if ir_operand(cx, v, k) != 0 {
                    have += 1;
                }
            }
            if have != want {
                ir_fail(cx, fi, b, v, c"intr operand count differs from its register parameters");
            }
        } else if op == Op::CpuFeat {
            if cx.insts[v].ty != TY_BOOL || cx.insts[v].imm < 0 || cx.insts[v].imm > 62 {
                ir_fail(cx, fi, b, v, c"cpufeat not a bool of a feature bit");
            }
        }
    }
}

// `operand` of `user` (0: the terminator), used at the end of block `at`
// for phis or in block `at` otherwise.
fn verify_operand(mut cx: *FnCtx, fi: i64, b: i64, user: i64, operand: i64, at: i64,
    reachable: bool) {
    unsafe {
        if operand <= 0 || operand >= cx.inst_count {
            ir_fail(cx, fi, b, user, c"operand out of range");
        }
        if cx.insts[operand].repl != 0 {
            ir_fail(cx, fi, b, user, c"operand was replaced (not resolved)");
        }
        let def_block = cx.insts[operand].block;
        if def_block == 0 {
            ir_fail(cx, fi, b, user, c"operand not in any block");
        }
        if cx.blocks[def_block].func != fi {
            ir_fail(cx, fi, b, user, c"operand from another function");
        }
        if !reachable || cx.blocks[at].order < 0 {
            return;
        }
        if def_block == at && user != 0 && cx.insts[user].op != Phi {
            // Defined before the use in the same block.
            let mut w = cx.insts[user].prev;
            while w != 0 && w != operand {
                w = cx.insts[w].prev;
            }
            if w == 0 {
                ir_fail(cx, fi, b, user, c"operand defined after its use");
            }
            return;
        }
        if !dominates(cx, def_block, at) {
            ir_fail(cx, fi, b, user, c"operand does not dominate its use");
        }
    }
}
