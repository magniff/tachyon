// Value numbering's regions and calls (split from gvn.tach): whether what
// gvn knows at the end of a dominating block still holds where it is
// inherited (the writes of the blocks between applied), and the numbering
// of calls the effects make pure: readnone calls by callee and arguments,
// readonly ones while nothing is written (0.16).

use crate::base::{IntVec, free};
use crate::middle::ctx::FnCtx;
use crate::middle::gvn::apply_block_kills;
use crate::middle::ipo::{ATTR_READNONE, ATTR_READONLY, call_attrs};
use crate::middle::ir::{IRFUNCS, Op, ir_arg, ir_val};
use crate::middle::ir::Op::CallC;

pub fn inherit_into(mut cx: *FnCtx, d: i64, c: i64) -> bool {
    unsafe {
        if cx.blocks[c].preds.count == 1 && cx.blocks[c].preds.data[0] == d {
            return true;
        }
        cx.region_stamp += 1;
        let stamp = cx.region_stamp;
        cx.region.count = 0;
        let mut work = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..cx.blocks[c].preds.count {
            work.push(cx.blocks[c].preds.data[i]);
        }
        let mut ok = true;
        while work.count > 0 {
            let b = work.pop();
            if b == d || cx.blocks[b].mark == stamp {
                continue;
            }
            cx.blocks[b].mark = stamp;
            cx.region.push(b);
            if cx.region.count > 64 {
                ok = false;
                break;
            }
            for i in 0..cx.blocks[b].preds.count {
                work.push(cx.blocks[b].preds.data[i]);
            }
        }
        free(work.data as *u8);
        if !ok {
            return false;
        }
        for i in 0..cx.region.count {
            apply_block_kills(cx, cx.region.data[i]);
        }
        true
    }
}

// How call v may be numbered: 1 when it reads and writes no memory
// (ATTR_READNONE: an equal call dominating it is the same value), 2 when
// it only reads (ATTR_READONLY: the same within a block while nothing is
// written), 0 not at all (an indirect call, a compound result, no
// result).
pub fn call_numbering(mut cx: *FnCtx, v: i64) -> i64 {
    unsafe {
        let op = cx.insts[v].op;
        if op != Op::Call && op != CallC || cx.insts[v].ty == 0 || cx.insts[v].c != 0 {
            return 0;
        }
        let attrs = call_attrs(cx, v);
        if (attrs & ATTR_READNONE) != 0 {
            return 1;
        }
        if (attrs & ATTR_READONLY) != 0 {
            return 2;
        }
        0
    }
}

// Whether calls v and w call one function with the same arguments.
fn same_call(mut cx: *FnCtx, v: i64, w: i64) -> bool {
    unsafe {
        if cx.insts[v].op != cx.insts[w].op || cx.insts[v].imm != cx.insts[w].imm
            || cx.insts[v].nargs != cx.insts[w].nargs {
            return false;
        }
        for i in 0..cx.insts[v].nargs {
            if ir_val(cx, ir_arg(cx, v, i)) != ir_val(cx, ir_arg(cx, w, i)) {
                return false;
            }
        }
        true
    }
}

// (0.16) Whether function fi has two calls value numbering may merge (the
// same callee and arguments, READNONE or READONLY): at -O2, its callees' attributes are
// known only once they are optimized, after fi's first value numbering.
pub fn repeated_pure_calls(mut cx: *FnCtx, fi: i64) -> bool {
    unsafe {
        let mut seen = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut found = false;
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 {
                continue;
            }
            let mut v = cx.blocks[b].first;
            while v != 0 && !found {
                if cx.insts[v].op.is_call() && call_numbering(cx, v) != 0 {
                    for k in 0..seen.count {
                        // (a readonly call is merged within its block only)
                        if same_call(cx, seen.data[k], v) && (call_numbering(cx, v) == 1
                            || cx.insts[seen.data[k]].block == cx.insts[v].block) {
                            found = true;
                        }
                    }
                    if seen.count < 64 {
                        seen.push(v);
                    }
                }
                v = cx.insts[v].next;
            }
        }
        free(seen.data as *u8);
        found
    }
}
