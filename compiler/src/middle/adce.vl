// Aggressive dead code elimination (0.4): liveness over data and control
// dependence. Instructions with effects and returns are live; so are the
// operands of live instructions, and the branches a live block is control
// dependent on (Ferrante, Ottenstein & Warren: block b depends on the
// branch at x when b post-dominates a successor of x but not x itself),
// and the branches of the blocks a live phi comes from. Every other
// instruction is removed, and a branch that is not live becomes a jump to
// its immediate post-dominator. Branches inside loops and in blocks that
// cannot reach a return are kept live: a loop may not terminate, and only
// scev.vl's deletion of finite loops removes loops.

// Per block id: the immediate post-dominator (-1: the virtual exit, 0:
// none: the block cannot reach a return) and the post-order number.
use crate::base::{IntVec, free};
use crate::middle::ctx::FnCtx;
use crate::middle::ipo::has_effect;
use crate::middle::ir::{Op, Term, ir_enter, ir_operand, ir_operand_count, ir_unlink};
use crate::middle::ir::cfg::{succ, succ_count};
use crate::middle::loops::{analyze_loops, block_array, innermost_loop};
use crate::middle::opt::{remove_pred, remove_trivial_phis, remove_unreachable, resolve_all};

fn is_exit_block(cx: sink *FnCtx, b: i64) -> bool {
    unsafe { cx.blocks[b].term == Term::Ret || cx.blocks[b].term == Term::Unreach }
}

fn pdom_intersect(cx: sink *FnCtx, b1: i64, b2: i64) -> i64 {
    unsafe {
        var x = b1;
        var y = b2;
        while x != y {
            while x != -1 && (y == -1 || cx.porder[x] < cx.porder[y]) {
                x = cx.pdom[x];
            }
            while y != -1 && (x == -1 || cx.porder[y] < cx.porder[x]) {
                y = cx.pdom[y];
            }
        }
        x
    }
}

// Post-dominators of fi's reachable blocks (layout_blocks done).
fn compute_post_dominators(cx: sink *FnCtx, fi: i64) {
    unsafe {
        cx.pdom = block_array(cx, cx.pdom, &cx.pdom_cap, fi);
        cx.porder = block_array(cx, cx.porder, &cx.porder_cap, fi);
        // Post-order of the reverse CFG from the virtual exit (whose number
        // is the largest).
        cx.porder_list.count = 0;
        cx.ad_seen = block_array(cx, cx.ad_seen, &cx.ad_seen_cap, fi);
        let seen = cx.ad_seen;
        var stack = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..cx.order.count {
            let r = cx.order.data[i];
            if !is_exit_block(cx, r) || seen[r] != 0 {
                continue;
            }
            seen[r] = 1;
            stack.push(r);
            stack.push(0);
            while stack.count > 0 {
                let b = stack.data[stack.count - 2];
                let k = stack.data[stack.count - 1];
                if k < cx.blocks[b].preds.count {
                    stack.data[stack.count - 1] = k + 1;
                    let p = cx.blocks[b].preds.data[k];
                    if cx.blocks[p].order >= 0 && seen[p] == 0 {
                        seen[p] = 1;
                        stack.push(p);
                        stack.push(0);
                    }
                } else {
                    stack.count -= 2;
                    cx.porder[b] = cx.porder_list.count + 1;
                    cx.porder_list.push(b);
                }
            }
        }
        free(stack.data as *u8);
        for i in 0..cx.porder_list.count {
            let b = cx.porder_list.data[i];
            cx.pdom[b] = if is_exit_block(cx, b) { -1 } else { 0 };
        }
        // The virtual exit's number is above every block's.
        var changed = true;
        while changed {
            changed = false;
            var i = cx.porder_list.count;
            while i > 0 {
                i -= 1;
                let b = cx.porder_list.data[i];
                if is_exit_block(cx, b) {
                    continue;
                }
                var new_pdom = 0;
                for k in 0..succ_count(cx, b) {
                    let s = succ(cx, b, k);
                    if cx.porder[s] == 0 || cx.pdom[s] == 0 {
                        continue;
                    }
                    new_pdom = if new_pdom == 0 { s } else { pdom_intersect(cx, s, new_pdom) };
                }
                if new_pdom != cx.pdom[b] {
                    cx.pdom[b] = new_pdom;
                    changed = true;
                }
            }
        }
    }
}

fn adce_mark(cx: sink *FnCtx, v: i64, work: inout IntVec) {
    unsafe {
        if v != 0 && cx.insts[v].mark == 0 {
            cx.insts[v].mark = 1;
            work.push(v);
        }
    }
}

// Marks block b's terminator live (and b itself).
fn adce_mark_branch(cx: sink *FnCtx, b: i64, live_term: *i64, blocks: inout IntVec,
    work: inout IntVec) {
    unsafe {
        if live_term[b] == 0 {
            live_term[b] = 1;
            blocks.push(b);
            adce_mark(cx, cx.blocks[b].cond, &work);
        }
    }
}

pub fn aggressive_dce(cx: sink *FnCtx, fi: i64) -> bool {
    unsafe {
        ir_enter(cx, fi);
        resolve_all(cx, fi);
        analyze_loops(cx, fi);
        compute_post_dominators(cx, fi);
        // Control dependence: the branches each block depends on, as lists
        // (CD_FIRST[b] .. linked through CD_NEXT).
        var deps = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        cx.ad_first = block_array(cx, cx.ad_first, &cx.ad_first_cap, fi);
        let first = cx.ad_first;
        for i in 0..cx.order.count {
            let x = cx.order.data[i];
            if succ_count(cx, x) < 2 || cx.porder[x] == 0 || cx.pdom[x] == 0 {
                continue;
            }
            for k in 0..succ_count(cx, x) {
                var runner = succ(cx, x, k);
                while runner != cx.pdom[x] && runner > 0 && cx.porder[runner] != 0 {
                    deps.push(x);
                    deps.push(first[runner]);
                    first[runner] = deps.count / 2;
                    runner = cx.pdom[runner];
                    if runner == 0 {
                        break;
                    }
                }
            }
        }
        cx.ad_term = block_array(cx, cx.ad_term, &cx.ad_term_cap, fi);
        cx.ad_block = block_array(cx, cx.ad_block, &cx.ad_block_cap, fi);
        let live_term = cx.ad_term;
        let live_block = cx.ad_block;
        var work = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var blocks = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..cx.order.count {
            let b = cx.order.data[i];
            var v = cx.blocks[b].first;
            while v != 0 {
                cx.insts[v].mark = 0;
                v = cx.insts[v].next;
            }
        }
        for i in 0..cx.order.count {
            let b = cx.order.data[i];
            var v = cx.blocks[b].first;
            while v != 0 {
                if has_effect(cx, v) {
                    adce_mark(cx, v, &work);
                }
                v = cx.insts[v].next;
            }
            // Branches that stay: in loops, unable to reach a return, or
            // without a post-dominator a jump could go to (one with phis).
            let j = cx.pdom[b];
            var keep = is_exit_block(cx, b) || innermost_loop(cx, b) >= 0 || cx.porder[b] == 0
                || j <= 0;
            if !keep && cx.blocks[b].term != Term::Jump {
                let f = cx.blocks[j].first;
                keep = f != 0 && cx.insts[f].op == Op::Phi;
            }
            if keep && cx.blocks[b].term != Term::Jump {
                adce_mark_branch(cx, b, live_term, &blocks, &work);
            } else if is_exit_block(cx, b) {
                adce_mark_branch(cx, b, live_term, &blocks, &work);
            }
        }
        while work.count > 0 || blocks.count > 0 {
            if work.count > 0 {
                let v = work.pop();
                let b = cx.insts[v].block;
                if b != 0 && live_block[b] == 0 {
                    live_block[b] = 1;
                    blocks.push(b);
                }
                for k in 0..ir_operand_count(cx, v) {
                    adce_mark(cx, ir_operand(cx, v, k), &work);
                }
                if cx.insts[v].op == Op::Phi && b != 0 {
                    for k in 0..cx.blocks[b].preds.count {
                        adce_mark_branch(cx, cx.blocks[b].preds.data[k], live_term, &blocks,
                            &work);
                    }
                }
                continue;
            }
            let b = blocks.pop();
            live_block[b] = 1;
            var d = first[b];
            while d != 0 {
                adce_mark_branch(cx, deps.data[2 * (d - 1)], live_term, &blocks, &work);
                d = deps.data[2 * (d - 1) + 1];
            }
        }
        // Sweep.
        var changed = false;
        for i in 0..cx.order.count {
            let b = cx.order.data[i];
            var v = cx.blocks[b].first;
            while v != 0 {
                let next = cx.insts[v].next;
                if cx.insts[v].mark == 0 {
                    ir_unlink(cx, v);
                    changed = true;
                }
                v = next;
            }
        }
        for i in 0..cx.order.count {
            let b = cx.order.data[i];
            if live_term[b] != 0
                || (cx.blocks[b].term != Term::Branch && cx.blocks[b].term != Term::Switch) {
                continue;
            }
            let j = cx.pdom[b];
            if j <= 0 {
                continue;
            }
            let first_inst = cx.blocks[j].first;
            if first_inst != 0 && cx.insts[first_inst].op == Op::Phi {
                continue;
            }
            for k in 0..succ_count(cx, b) {
                remove_pred(cx, succ(cx, b, k), b);
            }
            cx.blocks[b].term = Term::Jump;
            cx.blocks[b].cond = 0;
            cx.blocks[b].s0 = j;
            cx.blocks[b].s1 = 0;
            cx.blocks[j].preds.push(b);
            changed = true;
        }
        free(deps.data as *u8);
        free(work.data as *u8);
        free(blocks.data as *u8);
        if changed {
            remove_unreachable(cx, fi);
            resolve_all(cx, fi);
            remove_trivial_phis(cx, fi);
        }
        changed
    }
}
