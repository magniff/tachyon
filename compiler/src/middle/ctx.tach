// A new context: its fields at the statics' initial values, and buffers
// of its own (serial code only: buf_new grows the program's table).
pub fn fnctx_new() -> *FnCtx {
    unsafe {
        let cx = fnctx_fields();
        cx.code = buf_new();
        cx.asm = buf_new();
        cx.scratch_buf = buf_new();
        cx
    }
}

// (testing, middle::parallel) A new context with cx's buffers and scratch
// text: one per task, made while other tasks run (so without buf_new).
pub fn fnctx_new_with(mut cx: *FnCtx) -> *FnCtx {
    unsafe {
        let code = cx.code;
        let asm = cx.asm;
        let scratch = cx.scratch_buf;
        let fmt = cx.fmt;
        let n = fnctx_fields();
        n.code = code;
        n.asm = asm;
        n.scratch_buf = scratch;
        n.fmt = fmt;
        n
    }
}

// The main thread's context: the serial phases' (lowering, the
// whole-program passes, -j1).
static mut MAIN_CX: *FnCtx = 0 as *FnCtx;

pub fn main_cx() -> *FnCtx {
    unsafe {
        if MAIN_CX == 0 as *FnCtx {
            MAIN_CX = fnctx_new();
        }
        MAIN_CX
    }
}
