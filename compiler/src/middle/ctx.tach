// (0.18.1) The code generator's state that belongs to one thread: the
// statics of middle, back and gen0 that a function's optimization and
// emission write (pass scratch, the current function's IR tables, the
// emitter's frame and peephole memory), moved here so that each worker
// thread has its own (docs/optimizer.md, "0.18.1: threads"). Every
// function that reaches one takes `cx`; serial code passes main_cx().

use crate::base::{IntVec, alloc_zeroed, buf_new};

use crate::back::regalloc::Interval;
use crate::middle::fold::lattice::Lattice;
use crate::middle::ir::{Block, Inst, Slot};
use crate::middle::lower::ssa::HMap;

pub struct FnCtx {
    // middle::loops
    pub lp_header: IntVec,
    pub lp_parent: IntVec,
    pub lp_depth: IntVec,
    pub lp_start: IntVec,
    pub lp_count: IntVec,
    pub lp_blocks: IntVec,
    // Per block id (below LP_NBLOCKS): the innermost loop containing it, + 1.
    pub lp_of: *i64,
    pub lp_of_cap: i64,
    pub lp_nblocks: i64,
    // A visit stamp per block id, for walks over the CFG.
    pub lp_seen: *i64,
    pub lp_seen_cap: i64,
    pub lp_stamp: i64,
    // Scratch lists.
    pub lp_list: IntVec,
    pub lp_list2: IntVec,
    pub lp_values: IntVec,
    // The headers of the loops rotated in the current function (each loop is
    // rotated once).
    pub rotated: IntVec,
    // middle::copies
    // (slot, user instruction) for every use of a slot's address.
    pub copies_uses: IntVec,
    // The copies that are candidates.
    pub candidates: IntVec,
    // middle::licm
    pub loops: IntVec,
    pub loop_body: IntVec,
    // middle::sroa
    // Per slot: 1 while a candidate; its leaves are (offset, IR type) pairs at
    // SR_LEAVES[SR_FIRST[s]..] (SR_COUNT[s] of them, by offset), and their
    // variables start at SR_VAR[s].
    pub sr_state: *i64,
    pub sr_first: *i64,
    pub sr_count: *i64,
    pub sr_var: *i64,
    pub sr_leaves: IntVec,
    pub sr_values: IntVec,
    // Slots holding the address of another slot (a closure's environment
    // holding a variable captured by reference): when they are replaced, the
    // other slot's address reaches its uses directly, and it may be replaced
    // in turn (0.14).
    pub sr_held: IntVec,
    // middle::inline
    // Whether the function inline_calls works on calls one (it does not change
    // while it inlines: only callees that do not are inlined).
    pub caller_rt: bool,
    // Per block (by id): the loop depth of the call sites in it, and whether
    // it is cold; set by mark_call_sites for the function being processed.
    pub site_depth: *i64,
    pub site_depth_cap: i64,
    pub site_cold: *i64,
    pub site_cold_cap: i64,
    pub site_nblocks: i64,
    // middle::gvn
    pub dom_start: *i64,
    pub dom_child: *i64,
    pub gvn_table: *i64,
    pub gvn_size: i64,
    pub gvn_cap: i64,
    pub gvn_count: i64,
    // Slots filled, in order, to undo a scope.
    pub gvn_log: IntVec,
    pub ro_fn: i64,
    pub ro_stamp: i64,
    pub ro_written: i64,
    pub avail: IntVec,
    pub gvn_copies: IntVec,
    pub pending: IntVec,
    // (y, x) pairs: y is x in the blocks being visited.
    pub eq_map: IntVec,
    // (0.16) Calls numbered like pure instructions: the READONLY calls of the
    // current block since the last write (an equal one there is the same
    // value).
    pub ro_calls: IntVec,
    // middle::egraph
    pub ec_stamp: IntVec,
    pub ec_start: IntVec,
    pub ec_len: IntVec,
    pub ec_cost: IntVec,
    pub alts: IntVec,
    pub run: i64,
    // Variable bindings of the rule being matched, and the trail of bound
    // variables (to undo a failed branch).
    pub bind: [i64; 8],
    pub trail: IntVec,
    pub consts: [i64; 8],
    pub build_cmp_ty: i64,
    pub found: IntVec,
    // middle::slp
    // Per instruction: the number of uses in the function (USES), its position
    // in the block being looked at (POS, valid where POS_STAMP is the stamp).
    pub slp_uses: *i64,
    pub pos: *i64,
    pub pos_stamp: *i64,
    pub slp_stamp: i64,
    pub table_size: i64,
    // The group being vectorized: its stores (by lane), the lane type, VF, the
    // vector type.
    pub g_stores: [i64; 16],
    pub g_vf: i64,
    pub g_elem: i64,
    pub g_vt: i64,
    pub g_block: i64,
    pub n_lanes: IntVec,
    pub n_kind: IntVec,
    pub n_a: IntVec,
    pub n_b: IntVec,
    pub n_value: IntVec,
    // Nodes counted by tree_cost.
    pub n_seen: IntVec,
    // Per scalar of the tree: its uses by scalars that go (DEAD_USES), and
    // whether it goes (GOES), keyed by instruction; (instruction, count)
    // pairs.
    pub dead: IntVec,
    // middle::ipo
    // Whether value p (an address) is captured in function fi: stored as a
    // value, returned, merged by a phi, converted, or passed where it may be
    // kept. Addresses computed from it (p + x) are followed.
    // The addresses derived from the parameter being looked at are marked
    // with a stamp (INSTS[v].mark); passes over the function repeat while new
    // ones are found (rarely more than two).
    pub capture_stamp: i64,
    // Whether the attributes just computed used the assumptions about the
    // component's own functions (a call within it).
    pub used_component: bool,
    // middle::adce
    pub pdom: *i64,
    pub porder: *i64,
    pub pdom_cap: i64,
    pub porder_cap: i64,
    pub ad_seen: *i64,
    pub ad_seen_cap: i64,
    pub ad_first: *i64,
    pub ad_first_cap: i64,
    pub ad_term: *i64,
    pub ad_term_cap: i64,
    pub ad_block: *i64,
    pub ad_block_cap: i64,
    pub porder_list: IntVec,
    // middle::gvn_calls
    // Whether what is known at the end of d (in AVAIL) holds at the start of
    // c, which d dominates, once the writes of the blocks on the paths from d
    // to c are applied; false when those are too many to look at.
    pub region_stamp: i64,
    pub region: IntVec,
    // middle::scev
    // Header phis and their values in the iteration being evaluated:
    // SIM_PHIS[i], SIM_KNOWN[i], SIM_VALUE[i].
    pub sim_phis: IntVec,
    pub sim_known: IntVec,
    pub sim_value: IntVec,
    pub sim_stamp: i64,
    // middle::exits
    // The tests of one loop: (block, induction variable phi, offset, invariant
    // bound, condition to stay) per test; COUNT_STRIDE values each.
    pub tests: IntVec,
    // The exit blocks of the tests (OUTS[k] for test k).
    pub outs: IntVec,
    // middle::tags
    pub tags_copies: IntVec,
    // The chain of blocks being threaded (see decider_phi), marked STAMP in
    // BLOCKS[].mark; the copies of one.
    pub chain: IntVec,
    pub copy_of: IntVec,
    pub tags_stamp: i64,
    // middle::promote
    // The memory accesses of the loop being looked at: per access, its
    // instruction, its base (resolved), its constant offset, its size, and its
    // type (0 for a copy or a call); 5 per access.
    pub accesses: IntVec,
    // middle::ir::verify
    pub verify_pass: *u8,
    // middle::fold::lattice
    // The users of each value of a function (CSR): USER_START[i] ..
    // USER_START[i + 1] in USER_LIST, by dense index (INSTS[v].aux - 1);
    // users are instructions, or -(block) for a block's terminator.
    pub fn_values: IntVec,
    pub user_start: *i64,
    pub user_list: *i64,
    // Per dense index: lattice state and constant.
    pub lat: *Lattice,
    pub lat_value: *i64,
    pub ssa_work: IntVec,
    pub cfg_work: IntVec,
    // middle::range::thread
    // Per block id: whether a value defined in it is used in another block
    // (compute_exports).
    pub exports: *i64,
    pub exports_cap: i64,
    // middle::ir
    pub insts: *Inst,
    pub inst_count: i64,
    pub inst_cap: i64,
    pub blocks: *Block,
    pub block_count: i64,
    pub block_cap: i64,
    pub slots: *Slot,
    pub slot_count: i64,
    pub slot_cap: i64,
    // Operand lists of phis and calls, and the argument types of calls.
    pub args: IntVec,
    // The cases and successor lists of switches (append-only).
    pub swcases: IntVec,
    pub argty: IntVec,
    // (0.11, -g) Per instruction, the source position of the statement it
    // comes from, + 1 (0: none, as for most of what the passes make; see
    // dwarf.tach); kept out of Inst, which every pass walks, and only with -g.
    // New instructions get IR_LOC.
    pub inst_loc: IntVec,
    // The function and block being built.
    pub irf: i64,
    // (0.17) The function whose tables are current (see ir_enter), or -1.
    pub ir_cur: i64,
    // middle::range
    // The facts at a block: pairs (comparison or bool value, holds).
    pub facts: IntVec,
    // (0.11) Changes of FACTS are counted (FACTS_VER); FACT_MARK[v] is
    // MARK_STAMP when a comparison of FACTS has v as an operand, for the
    // FACTS of version MARK_VER: narrow_by_facts looks at the facts only for
    // such a v.
    pub facts_ver: i64,
    pub mark_ver: i64,
    pub mark_stamp: i64,
    pub fact_mark: *i64,
    pub mark_cap: i64,
    // Per loop: the comparisons its counted test implies (0: none), made for
    // the facts (not in any block).
    pub loop_fact_lt: IntVec,
    pub loop_fact_ge: IntVec,
    // middle::range::phi
    pub pr_active: i64,
    pub fact_nest: i64,
    pub range_gen: i64,
    // Whether phis get ranges now (and facts comparing two values are taken):
    // while a check's branch is decided (one way unreachable: a bounds check,
    // an unwrap), where they pay for their cost.
    pub phi_ranges: bool,
    // Phis whose range was found in this generation, and how many may be (the
    // others have their type's range: a bound on the work in large functions).
    pub pr_work: i64,
    pub pr_gen: *i64,
    pub pr_lo: *i64,
    pub pr_hi: *i64,
    pub pr_cap: i64,
    // The phis whose ranges are being found: (phi, assumed lo, assumed hi,
    // frame), a frame numbering each push (so one names the whole stack below
    // it, which cannot change while it is there).
    pub pr_stack: IntVec,
    pub pr_frames: i64,
    // A range found under assumptions: kept for the stack it was found under
    // (its top frame), within the generation.
    pub pt_gen: *i64,
    pub pt_frame: *i64,
    pub pt_lo: *i64,
    pub pt_hi: *i64,
    pub pt_taint_of: *i64,
    // The outermost level of PR_STACK whose assumption the range being found
    // used (NO_TAINT: none).
    pub pr_taint: i64,
    // FACTS put aside while a phi's operands are ranged at its predecessors.
    pub facts_saved: IntVec,
    // The header phis being found (HR_FIELDS each): the phi, its type's range,
    // the entry operands' range, the assumption, the operands coming back,
    // how far the assumption was widened.
    pub hr: IntVec,
    // middle::vectorize
    // Set by vectorize_loops when it left a loop to be unrolled whole (see
    // vectorize_loop).
    pub unroll_whole: bool,
    pub vstamp: i64,
    // The loop being vectorized.
    pub v_iv: i64,
    pub v_n: i64,
    pub v_start: i64,
    // The inner loop's induction variable (outer loops, see below), or 0.
    pub v_iv2: i64,
    // The inner loop's induction variable's last value (a constant).
    pub v_last2: i64,
    // The number of instructions of the loop.
    pub v_size: i64,
    pub v_ne: bool,
    pub v_elem: i64,
    pub v_vt: i64,
    pub v_vf: i64,
    pub v_has_store: bool,
    pub v_has_uload: bool,
    // The blocks of the body, in order, header first.
    pub v_chain: IntVec,
    // The checks: (compare, index, length) triples.
    pub v_checks: IntVec,
    // The memory accesses: (instruction, address, size) triples.
    pub v_access: IntVec,
    // The reductions: (phi, next, op) triples.
    pub v_reds: IntVec,
    // The vector loop's values of the loop's: (old, new) pairs.
    pub v_map: IntVec,
    // Values materialized at an iteration (eval_at): (old, iteration, new)
    // triples.
    pub v_eval: IntVec,
    // middle::lower::ssa
    // The current definition of each variable in each block: key
    // (var + 1) << 32 | block.
    pub defs: HMap,
    // Incomplete phis: triples (var, phi, next) linked from Block.incomplete
    // (index + 1).
    pub incomplete: IntVec,
    // Scratch stack for phi operands and call arguments.
    pub ssa_stack: IntVec,
    // Types of the synthetic variables (variable LOCAL_COUNT + i).
    pub synth_ty: IntVec,
    // middle::vectorize::outer
    // Instructions' classes, saved (cloning uses INSTS[v].aux): (value,
    // class) pairs.
    pub v_class: IntVec,
    // The blocks of L (and L2) in order: before L2, L2's, after it.
    pub v_pre: i64,
    pub v_clone_stamp: i64,
    // middle::vectorize::checks
    // The accesses grouped by the base of their address (the address less a
    // constant): (base, lowest offset, highest offset + size, whether one
    // stores) quadruples. An access's offset adds its constant to its
    // instruction's.
    pub v_groups: IntVec,
    // back::regalloc
    // The function being allocated: its blocks in layout order, and per
    // layout index the positions of the block's start and terminator, and its
    // loop depth.
    pub order: IntVec,
    pub bstart: IntVec,
    pub bend: IntVec,
    pub ldepth: IntVec,
    // Allocated values: value ids by dense index (INSTS[v].aux = index + 1).
    pub ra_vals: IntVec,
    pub ivs: *Interval,
    pub iv_count: i64,
    // Per dense index: the first interval, the spill slot (-1: never on the
    // stack), the value whose register it would like (-1), the register it
    // would like (-1).
    pub rv_first: *i64,
    pub rv_slot: *i64,
    pub rv_hint: *i64,
    pub rv_hreg: *i64,
    pub rv_cap: i64,
    // Fixed intervals: per register, the ranges where it is not available.
    pub fixed: *IntVec,
    // Moves inside blocks: (gap, dense index) pairs, sorted by gap.
    pub split_moves: IntVec,
    pub spill_count: i64,
    // Whether a vector is spilled (the spill area is then 16-aligned).
    pub spill_vectors: bool,
    // Per register: whether a callee-saved register is used.
    pub callee_used: [i64; 64],
    // Uses of each instruction (indexed by value id), for the whole program,
    // and whether some use needs the value in a register.
    pub regalloc_uses: *i64,
    pub reg_used: *i64,
    // Liveness: bit sets of dense value indices, per layout index.
    pub live_in: *u64,
    pub live_out: *u64,
    pub live_words: i64,
    // back::regalloc::intervals
    // Whether the function being allocated calls one.
    pub returns_twice: bool,
    // The allocatable registers a call clobbers, in order (see add_clobbers).
    pub clobbered: IntVec,
    // back::regalloc::scan
    pub active: IntVec,
    pub inactive: IntVec,
    // Unhandled intervals: a binary heap by (start, id).
    pub unhandled: IntVec,
    pub free_until: [i64; 64],
    pub use_pos: [i64; 64],
    pub block_pos: [i64; 64],
    // Dominators over the layout (a reverse post-order), computed once per
    // function when an entry split asks (Cooper, Harvey and Kennedy).
    pub ra_idom: IntVec,
    pub ra_idom_ready: bool,
    // (0.17) The fixed intervals' intersections, shared by registers with the
    // same ranges: every caller-saved register has the calls' (FIXED_CANON[r]
    // is the first register with r's ranges), and try_allocate_free,
    // allocate_blocked and crosses_calls asked each of them the same question,
    // a seventh of -O1. An answer holds within one allocation step
    // (FIX_STEP), for one interval and starting position.
    pub fixed_canon: [i64; 64],
    pub fix_step: i64,
    pub fix_at: [i64; 64],
    pub fix_iv: [i64; 64],
    pub fix_from: [i64; 64],
    pub fix_x: [i64; 64],
    // back::layout
    pub emit: IntVec,
    // Per layout index (BLOCKS[b].order): the next block of its chain (-1),
    // the first block of its chain, the last one (valid at the first), and
    // whether the block is cold.
    pub chain_next: IntVec,
    pub chain_head: IntVec,
    pub chain_tail: IntVec,
    pub cold: IntVec,
    // Edges: (weight, source index, target index) triples, then sorted.
    pub edges: IntVec,
    pub edge_order: IntVec,
    pub edge_temp: IntVec,
    // With a profile (0.10): the blocks' counts, by layout index (estimated
    // for blocks made after the profile was read: an edge's block runs as
    // often as the least of its ends, another as its predecessors' shares).
    pub profiled: bool,
    pub count: IntVec,
    // back::abi
    // The pieces of the last classified aggregate.
    pub abi_piece_ty: [i64; 4],
    pub abi_piece_offset: [i64; 4],
    pub abi_piece_count: i64,
    // Scalar leaves of an aggregate: (offset, type) pairs.
    pub abi_leaves: IntVec,
    // Whether abi_leaves keeps a vector whole (scalar replacement) rather than
    // as its lanes (the calling conventions, 0.10).
    pub leaves_whole_vectors: bool,
    // back::emit::blocks
    // Per layout index: whether the block emits nothing but a jump.
    pub trivial: IntVec,
    // Tail duplication: a jump to a small block (at most 3 instructions, no
    // call, ending in a jump, a branch or a return) emits a copy of the block
    // instead, up to 2 deep. The copy is exact: a block's code depends on its
    // allocation (its positions) only, and the moves of the edge into it are
    // already done.
    pub dup_depth: i64,
    // The cases of the switch being emitted, sorted by value (in the order of
    // the switch's type): value and label.
    pub sw_values: IntVec,
    pub sw_labels: IntVec,
    // back::emit::operands
    // The position of the instruction being emitted.
    pub cur_pos: i64,
    pub pm: IntVec,
    // back::emit::function
    // Assigns the frame offsets (after register allocation).
    // Whether the function being emitted calls anything.
    pub has_calls: bool,
    // The alignment of the frame (above 16: sp is realigned in the prologue,
    // for slots, and stack arguments, aligned above 16).
    pub frame_align: i64,
    // (-g) The source position (+ 1) of the last `.loc` written.
    pub last_loc: i64,
    // Whether a jump to the epilogue was emitted.
    pub epilogue_used: bool,
    // Whether the code emitted last returns, in the frame's region, by
    // falling into the epilogue.
    pub fell_into_epilogue: bool,
    // Whether the function being emitted has a frame.
    pub has_frame: bool,
    // ---- Shrink-wrapping ----
    //
    // The frame (the saved frame pointer and return address, the reserved
    // area, the saved callee-saved registers) is set up at the start of block
    // SAVE (a layout index): the nearest common dominator of the blocks that
    // need it (a call, a frame slot, a value in a callee-saved register or on
    // the stack, see mark_frame_blocks), moved up the dominator tree out of
    // loops. Its region is the blocks it dominates; a jump out of the region
    // (with critical edges split, only a block ending in a jump leaves it)
    // tears the frame down after the edge's moves, and the blocks outside run
    // without a frame: no path re-enters the region but through SAVE, and
    // SAVE is in no loop, so the frame is set up and torn down at most once.
    // Blocks outside return with a bare `ret`; a block outside that ends in a
    // call that does not return (a panic) links a frame of its own first
    // (x86-64 calls need an aligned stack). SAVE is 0 (the entry) when the frame is set up with the
    // function, -1 when it has none. Functions calling setjmp and the like,
    // realigning their frame or taking parameters on the stack keep theirs
    // at the entry.
    pub save: i64,
    // Per layout index: whether the block runs with the frame set up, and its
    // immediate dominator.
    pub in_frame: IntVec,
    pub sw_idom: IntVec,
    // Whether the block being emitted runs with the frame set up.
    pub cur_in_frame: bool,
    // back::regalloc::check
    pub check_width: i64,
    // back::emit::insts
    // The last select emitted, and the length of the code after it.
    pub last_select: i64,
    pub last_select_end: i64,
    // back::emit::machine
    // Post-allocation peepholes on what was just emitted (nothing else, not
    // even a label, since): a move back to where a value just came from is
    // none, and a load of the spill slot (or stack slot) just stored to is a
    // move from the register stored.
    pub last_mov_dst: i64,
    pub last_mov_src: i64,
    pub last_mov_end: i64,
    pub last_store_reg: i64,
    pub last_store_offset: i64,
    pub last_store_type: i64,
    pub last_store_end: i64,
    // back::isel::divisions
    // The quotients made in the block being lowered: (dividend, divisor, type,
    // quotient) for each.
    pub div_seen: IntVec,
    // back::emit
    pub frame_out: i64,
    pub spill_base: i64,
    pub save_base: i64,
    pub frame_total: i64,
    pub label_base: i64,
    pub epilogue_label: i64,
    // The index register of the next memory operand (-1: none) and its shift
    // (LOADX, STOREX, LEA).
    pub mem_index: i64,
    pub mem_scale: i64,
    // Whether the function's branches all reach (AArch64's tbz and tbnz reach
    // 32 KB).
    pub short_branches: bool,
    // back::emit::stats
    pub st_fn: [i64; 9],
    // back::emit::calls
    // Whether the block being emitted ended in a tail call (its return is then
    // the callee's).
    pub tail_called: bool,
    // Whether the function being emitted uses frame slots (whose addresses a
    // callee could hold: no tail calls then).
    pub uses_slots: bool,
    // back::mc_arm64
    // (0.16) While set, the general registers are written w<n>: a u32
    // operation on the 32-bit registers, whose results are zero-extended (so
    // canonical, without the `mov wN, wN` of ma_normalize).
    pub ma_w32: bool,
    // (0.15) The last load or store a pair may start (see pair_with_last): its
    // line's start and end in CODE (end -1: none), kind (1 an x register, 2 a
    // d register, 3 a q register; negated for a store), register, base and
    // offset.
    pub pair_end: i64,
    pub pair_start: i64,
    pub pair_kind: i64,
    pub pair_reg: i64,
    pub pair_base: i64,
    pub pair_offset: i64,
    // back::isel
    // Uses of each instruction of the function being selected (by value id).
    pub isel_uses: *i64,
    pub isel_cap: i64,
    // gen0::target
    // The assembly being generated for the current function, and for the
    // whole file.
    pub code: i64,
    pub asm: i64,
    // The local labels made so far (LABEL_COUNT until 0.18.1): the
    // program's for the main thread's context; in a task's, its function's,
    // numbered from 1 and written L\x01<n> (local_labels), which the join
    // renumbers (middle::parallel).
    pub label_count: i64,
    pub local_labels: bool,
    // (0.18.1) The task this context runs (middle::parallel): its phase and
    // its rank there (0: serial code), which order the constant data it
    // makes; the component of the -O2 bottom-up phase (-1: none), its
    // calls inlined (pairs of callee and count: FN_CALLS as this component
    // sees it) and its growth (PROGRAM_SIZE as it sees it).
    pub task_phase: i64,
    pub task_rank: i64,
    pub cur_comp: i64,
    pub comp_dec: IntVec,
    pub comp_growth: i64,
    // (0.18.1) Counts for --vec-stats (VEC_STAT_*), summed over the
    // contexts.
    pub vec_loops: i64,
    pub vec_tests: i64,
    pub vec_skipped: i64,
    // (0.18.1) The scratch text of cx_fmt (base::buf_fmt's is the program's).
    pub fmt: *std::Buf,
    // (0.18.1) While a callee is copied into its caller (inline_call), its
    // blocks' and instructions' copies, by the callee's ids (the aux of the
    // callee's tables until 0.18.1, which another thread may read).
    pub inl_bmap: *i64,
    pub inl_bmap_cap: i64,
    pub inl_imap: *i64,
    pub inl_imap_cap: i64,
    // (0.18.1) A buffer for a pass's scratch bytes (base::buf_new makes the
    // program's, which a task must not).
    pub scratch_buf: i64,
    // back::regalloc's IVS capacity (IV_CAP until 0.18.1).
    pub iv_cap: i64,
}

// A context with every field at the static's initial value, and no
