// The code generator's two contexts (0.18 T7; docs/design/contracts-verification.md
// §4.3). FnCtx: one per worker thread, the pass state that is
// per-function by use (the ~456 statics of middle, back and gen0 that
// `refactor context` moves here) and the current function's IR tables
// and arena. Program: read-only while functions are compiled in
// parallel, the tables of the whole-program phases (FN_ATTRS, FN_SIZE,
// ..., the inline store, types, symbols, options), moved out of their
// statics by `Program::freeze`. A worker's entry,
// `codegen_function(p: &Program, cx: &mut FnCtx, f) -> FnOutput`, is
// declared without `global`, which the effects check.
//
// Phase 0: the names only; T7 fills them, T8 records Program's reads.

pub struct FnCtx {}

pub struct Program {}

impl Program {
    // The program's tables, taken out of their statics for the parallel
    // phase. Phase 0: an empty Program.
    pub fn freeze() -> Program {
        Program {}
    }
}
