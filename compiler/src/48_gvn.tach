// Global value numbering: a walk of the dominator tree with a scoped hash
// table of the pure instructions seen on the way down; an instruction
// equal to one that dominates it is replaced by it. Within each block,
// redundant loads are removed and stored values forwarded to later loads,
// with a simple alias analysis (see may_alias).

// The dominator tree: children of the block at layout index k are
// DOM_CHILD[DOM_START[k] .. DOM_START[k + 1]] (blocks).
static mut DOM_START: *i64 = 0 as *i64;
static mut DOM_CHILD: *i64 = 0 as *i64;

fn build_dom_tree(fi: i64) {
    compute_dominators(fi);
    let n = ORDER.count;
    free(DOM_START as *u8);
    free(DOM_CHILD as *u8);
    DOM_START = alloc_zeroed((n + 2) * 8) as *i64;
    DOM_CHILD = alloc_zeroed((n + 1) * 8) as *i64;
    for i in 1..n {
        let b = ORDER.data[i];
        DOM_START[BLOCKS[BLOCKS[b].idom].order] += 1;
    }
    let mut total = 0;
    for k in 0..n + 1 {
        let count = DOM_START[k];
        DOM_START[k] = total;
        total += count;
    }
    let fill = alloc_zeroed((n + 1) * 8) as *i64;
    for i in 1..n {
        let b = ORDER.data[i];
        let parent = BLOCKS[BLOCKS[b].idom].order;
        DOM_CHILD[DOM_START[parent] + fill[parent]] = b;
        fill[parent] += 1;
    }
    free(fill as *u8);
}

// ---- The value table ----

static mut GVN_TABLE: *i64 = 0 as *i64;
static mut GVN_SIZE: i64 = 0;
static mut GVN_COUNT: i64 = 0;
// Slots filled, in order, to undo a scope.
static mut GVN_LOG: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn is_gvn_op(op: i64) -> bool {
    is_remat_op(op) || (op >= OP_ADD && op <= OP_CONV)
}

fn is_commutative_op(v: i64) -> bool {
    let op = INSTS[v].op;
    if op == OP_CMP {
        return INSTS[v].imm == TK_EQ_EQ || INSTS[v].imm == TK_BANG_EQ;
    }
    op == OP_ADD || op == OP_MUL || op == OP_AND || op == OP_OR || op == OP_XOR
}

// The canonical order of commutative operands: constants on the right
// (where the targets have immediate forms), others by value id.
fn operands_out_of_order(a: i64, b: i64) -> bool {
    let a_const = is_const(a);
    let b_const = is_const(b);
    if a_const != b_const {
        return a_const;
    }
    a > b
}

fn gvn_hash(v: i64) -> u64 {
    let mut h: u64 = 1469598103934665603;
    h = (h ^ INSTS[v].op as u64) * 1099511628211;
    h = (h ^ INSTS[v].ty as u64) * 1099511628211;
    h = (h ^ INSTS[v].a as u64) * 1099511628211;
    h = (h ^ INSTS[v].b as u64) * 1099511628211;
    h = (h ^ INSTS[v].imm as u64) * 1099511628211;
    h = (h ^ INSTS[v].imm2 as u64) * 1099511628211;
    h ^ (h >> 29)
}

fn gvn_equal(v: i64, w: i64) -> bool {
    INSTS[v].op == INSTS[w].op && INSTS[v].ty == INSTS[w].ty && INSTS[v].a == INSTS[w].a
        && INSTS[v].b == INSTS[w].b && INSTS[v].imm == INSTS[w].imm
        && INSTS[v].imm2 == INSTS[w].imm2
}

fn gvn_reset(capacity: i64) {
    let mut size = 1024;
    while size < capacity * 2 {
        size *= 2;
    }
    if size > GVN_SIZE {
        free(GVN_TABLE as *u8);
        GVN_TABLE = alloc_zeroed(size * 8) as *i64;
        GVN_SIZE = size;
    } else {
        memset(GVN_TABLE as *u8, 0, (GVN_SIZE * 8) as u64);
    }
    GVN_COUNT = 0;
    GVN_LOG.count = 0;
}

// The equal value already in the table, or 0 after adding v.
fn gvn_find_or_add(v: i64) -> i64 {
    let mask = (GVN_SIZE - 1) as u64;
    let mut slot = gvn_hash(v) & mask;
    while GVN_TABLE[slot] != 0 {
        let w = GVN_TABLE[slot];
        if gvn_equal(v, w) {
            return w;
        }
        slot = (slot + 1) & mask;
    }
    GVN_TABLE[slot] = v;
    intvec_push(&GVN_LOG, slot as i64);
    0
}

// Removes the entries added after `mark` (most recent first, which keeps
// the linear probing chains intact).
fn gvn_undo(mark: i64) {
    while GVN_LOG.count > mark {
        let slot = intvec_pop(&GVN_LOG);
        GVN_TABLE[slot] = 0;
    }
}

// ---- Alias analysis ----

// The base of address `v` and its constant offset: (x + c1) + c2 is x at
// c1 + c2.
fn address_base(v: i64, offset: *i64) -> i64 {
    let mut base = v;
    while INSTS[base].op == OP_ADD && INSTS[base].ty == TY_U64 && is_const(INSTS[base].b) {
        *offset += INSTS[INSTS[base].b].imm;
        base = INSTS[base].a;
    }
    base
}

// Marks the frame slots of function `fi` whose address escapes: used other
// than as the address of a load, store or copy (or plus a constant).
fn find_escaping_slots(fi: i64) {
    for i in 0..IRFUNCS[fi].slots.count {
        SLOTS[IRFUNCS[fi].slots.data[i]].escapes = 0;
    }
    for i in 0..IRFUNCS[fi].blocks.count {
        let b = IRFUNCS[fi].blocks.data[i];
        if BLOCKS[b].removed != 0 {
            continue;
        }
        let mut v = BLOCKS[b].first;
        while v != 0 {
            let op = INSTS[v].op;
            for k in 0..ir_operand_count(v) {
                let operand = ir_operand(v, k);
                if operand == 0 {
                    continue;
                }
                let allowed = ((op == OP_LOAD || op == OP_STORE) && k == 0)
                    || (op == OP_COPY && k <= 1)
                    || (op == OP_ADD && k == 0 && is_const(INSTS[v].b) && INSTS[v].ty == TY_U64);
                if !allowed {
                    mark_escape(operand);
                }
            }
            v = INSTS[v].next;
        }
        if BLOCKS[b].cond != 0 {
            mark_escape(BLOCKS[b].cond);
        }
    }
}

fn mark_escape(operand: i64) {
    let mut offset = 0;
    let base = address_base(operand, &offset);
    if INSTS[base].op == OP_SLOT {
        SLOTS[INSTS[base].imm].escapes = 1;
    }
}

// The memory object of a base address: a frame slot or a static, else 0.
fn object_of(base: i64) -> i64 {
    let op = INSTS[base].op;
    if op == OP_SLOT {
        return INSTS[base].imm;
    }
    if op == OP_GADDR {
        // Statics: negative symbols, apart from the slots.
        return -1 - INSTS[base].imm;
    }
    0
}

fn is_private_slot(base: i64) -> bool {
    INSTS[base].op == OP_SLOT && SLOTS[INSTS[base].imm].escapes == 0
}

// Whether [base1 + off1, + size1) and [base2 + off2, + size2) may overlap.
fn may_alias(base1: i64, off1: i64, size1: i64, base2: i64, off2: i64, size2: i64) -> bool {
    let o1 = object_of(base1);
    let o2 = object_of(base2);
    if base1 == base2 || (o1 != 0 && o1 == o2) {
        return off1 < off2 + size2 && off2 < off1 + size1;
    }
    if o1 != 0 && o2 != 0 {
        return false;
    }
    // A slot whose address never escapes is only reached through itself.
    !is_private_slot(base1) && !is_private_slot(base2)
}

// ---- Memory values within a block ----

// Known memory contents: (base, offset, size, type, value), 5 per entry.
static mut AVAIL: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn avail_kill(base: i64, offset: i64, size: i64) {
    let mut i = 0;
    while i < AVAIL.count {
        let d = AVAIL.data;
        if may_alias(base, offset, size, d[i], d[i + 1], d[i + 2]) {
            for k in 0..5 {
                AVAIL.data[i + k] = AVAIL.data[AVAIL.count - 5 + k];
            }
            AVAIL.count -= 5;
        } else {
            i += 5;
        }
    }
}

// A call may write any memory but the private slots.
fn avail_kill_call() {
    let mut i = 0;
    while i < AVAIL.count {
        if !is_private_slot(AVAIL.data[i]) {
            for k in 0..5 {
                AVAIL.data[i + k] = AVAIL.data[AVAIL.count - 5 + k];
            }
            AVAIL.count -= 5;
        } else {
            i += 5;
        }
    }
}

fn avail_add(base: i64, offset: i64, size: i64, ty: i64, value: i64) {
    intvec_push(&AVAIL, base);
    intvec_push(&AVAIL, offset);
    intvec_push(&AVAIL, size);
    intvec_push(&AVAIL, ty);
    intvec_push(&AVAIL, value);
}

fn avail_find(base: i64, offset: i64, ty: i64) -> i64 {
    let mut i = 0;
    while i < AVAIL.count {
        let d = AVAIL.data;
        if d[i] == base && d[i + 1] == offset && d[i + 3] == ty {
            return d[i + 4];
        }
        i += 5;
    }
    0
}

// Memory effects of instruction v; returns whether v was replaced.
fn memory_step(v: i64) -> bool {
    let op = INSTS[v].op;
    if op == OP_LOAD {
        let mut offset = INSTS[v].imm;
        let base = address_base(INSTS[v].a, &offset);
        let ty = INSTS[v].ty;
        let known = avail_find(base, offset, ty);
        if known != 0 {
            ir_replace(v, known);
            return true;
        }
        avail_add(base, offset, size_of(ty), ty, v);
    } else if op == OP_STORE {
        let mut offset = INSTS[v].imm;
        let base = address_base(INSTS[v].a, &offset);
        let ty = INSTS[v].imm2;
        avail_kill(base, offset, size_of(ty));
        avail_add(base, offset, size_of(ty), ty, INSTS[v].b);
    } else if op == OP_COPY {
        let mut offset = 0;
        let base = address_base(INSTS[v].a, &offset);
        avail_kill(base, offset, INSTS[v].imm);
    } else if is_call_op(op) {
        avail_kill_call();
    }
    false
}

// ---- The walk ----

fn gvn(fi: i64) -> bool {
    build_dom_tree(fi);
    find_escaping_slots(fi);
    let mut count = 0;
    for i in 0..ORDER.count {
        let mut v = BLOCKS[ORDER.data[i]].first;
        while v != 0 {
            count += 1;
            v = INSTS[v].next;
        }
    }
    gvn_reset(count);
    let mut changed = false;
    // Explicit stack of (layout index, child position, log mark).
    let mut stack = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    gvn_block(ORDER.data[0], &changed);
    intvec_push(&stack, 0);
    intvec_push(&stack, 0);
    intvec_push(&stack, 0);
    while stack.count > 0 {
        let top = stack.count - 3;
        let k = stack.data[top];
        let next = stack.data[top + 1];
        if DOM_START[k] + next < DOM_START[k + 1] {
            stack.data[top + 1] = next + 1;
            let child = DOM_CHILD[DOM_START[k] + next];
            let mark = GVN_LOG.count;
            gvn_block(child, &changed);
            intvec_push(&stack, BLOCKS[child].order);
            intvec_push(&stack, 0);
            intvec_push(&stack, mark);
        } else {
            gvn_undo(stack.data[top + 2]);
            stack.count -= 3;
        }
    }
    free(stack.data as *u8);
    if changed {
        resolve_all(fi);
    }
    changed
}

fn gvn_block(b: i64, changed: *bool) {
    AVAIL.count = 0;
    let mut v = BLOCKS[b].first;
    while v != 0 {
        let next = INSTS[v].next;
        ir_resolve_operands(v);
        let op = INSTS[v].op;
        if is_gvn_op(op) {
            if is_commutative_op(v) && operands_out_of_order(INSTS[v].a, INSTS[v].b) {
                let a = INSTS[v].a;
                INSTS[v].a = INSTS[v].b;
                INSTS[v].b = a;
            }
            let w = gvn_find_or_add(v);
            if w != 0 {
                ir_replace(v, w);
                *changed = true;
            }
        } else if memory_step(v) {
            *changed = true;
        }
        v = next;
    }
    if BLOCKS[b].cond != 0 {
        BLOCKS[b].cond = ir_val(BLOCKS[b].cond);
    }
}
