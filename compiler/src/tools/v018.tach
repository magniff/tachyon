// The commands and options of 0.18 that phase 0 only names
// (docs/design/contracts-verification.md §2.6-§2.9): each says which task
// makes it, so that a script or an agent gets one clear line. T2 owns
// `tachyonc test`'s new options, T3 `tachyonc fuzz` and reduce's program
// modes; each replaces its stub here with the real command.

use crate::base::{buf_str, streq};
use crate::tools::query::diagnostics::{PROG, TOOL, diag, write_diags};

// `error CODE: WHAT is 0.18's (TASK), not implemented yet`; exit status 2.
pub fn not_yet(code: *u8, what: *u8, task: *u8) -> i64 {
    unsafe {
        let d = diag(c"error", code);
        buf_str(d, c"'");
        buf_str(d, what);
        buf_str(d, c"' is 0.18's (");
        buf_str(d, task);
        buf_str(d, c"), not implemented yet\n");
    }
    2
}

// The options of `tachyonc test` that 0.18's T2 adds (§2.9).
pub fn test_option018(a: *u8) -> bool {
    unsafe {
        streq(a, c"--fuzz") || streq(a, c"--gen")
    }
}

// The program modes of `tachyonc reduce` that 0.18's T3 adds (§2.9).
pub fn reduce_mode018(a: *u8) -> bool {
    unsafe { streq(a, c"--differs") || streq(a, c"--fails") || streq(a, c"--test") }
}

// `tachyonc fuzz NAME [--time S] [--jobs N]` (§2.8, T3).
pub fn run_fuzz(argc: i64, argv: **u8) -> i64 {
    let status = unsafe {
        PROG = argv[0];
        TOOL = 0 as *u8;
        not_yet(c"fuzz.not-yet", c"tachyonc fuzz", c"T3")
    };
    write_diags();
    status
}
