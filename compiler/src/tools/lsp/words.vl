// What a hover says of a word that names no item (0.25, docs/lsp.md): a
// keyword or a parameter's convention, an attribute, a primitive type.
// A line or two each, as the guide has them (`volec guide syntax`,
// `memory`, `contracts`, `effects`); the topic to read for more last.

// The text for keyword w (a convention, `self`, a contract's word), or
// an empty slice.
pub fn keyword_text(w: [u8]) -> [u8] {
    if w == "let" {
        "`let x = e;` binds a value that does not change. As a parameter's convention (the default: `x: T` is `x: let T`) the function only reads the argument: no copy, no `&` at the call. (`volec guide memory`)"
    } else if w == "var" {
        "`var x = e;` binds a variable that can change: `x = ..`, `x += ..`, `x.push(..)`. A method that changes its receiver needs a `var`. (`volec guide memory`)"
    } else if w == "inout" {
        "`x: inout T`: the function may change the caller's value, which the call marks `&v` (`grow(&v)`); `inout self` changes the receiver (a `var`, no `&`). `inout r = &st;` names an access to pass on. (`volec guide memory`)"
    } else if w == "sink" {
        "`x: sink T`: the function takes the value. An owned argument (`Vec`, `Buf`, `String`, a struct holding one) moves in and is dead after the call: pass `v.clone()` to keep it. `sink self` consumes the receiver; `sink || ..` is a closure that takes what it captures. (`volec guide memory`)"
    } else if w == "fn" {
        "`fn name(params) -> R { body }`: a function. Each parameter is `let` (read, the default), `inout` (changed: `&x` at the call) or `sink` (taken). (`volec guide language`)"
    } else if w == "self" {
        "`self`: the receiver of a method: `self` reads it, `inout self` changes it, `sink self` takes it. (`volec guide language`)"
    } else if w == "Self" {
        "`Self`: the type of the impl block or the trait it is written in."
    } else if w == "requires" {
        "`requires COND else \"message\"`: a precondition, between the signature and the body, checked at run time at each call: a failure prints `FILE:L:C: message` and exits 101. (`volec guide contracts`)"
    } else if w == "ensures" {
        "`ensures COND`: a postcondition, checked when the function returns; `result` is the value it returns. (`volec guide contracts`)"
    } else if w == "result" {
        "`result`: in an `ensures` clause, the value the function returns. (`volec guide contracts`)"
    } else if w == "struct" {
        "`struct S { x: T }`: a value type of named fields; `S { x: 1 }` makes one. (`volec guide types`)"
    } else if w == "enum" {
        "`enum E { A, B(T) }`: a type that is one of its variants, taken apart with `match`. (`volec guide types`)"
    } else if w == "trait" {
        "`trait T { fn f(self); }`: functions a type implements (`impl T for S`); a bound `<X: T>` asks for them. No `dyn`. (`volec guide traits`)"
    } else if w == "impl" {
        "`impl S { .. }`: the methods of a type; `impl Trait for S { .. }` implements a trait for it. (`volec guide traits`)"
    } else if w == "use" {
        "`use path::{a, b};` names items of another module here (never `*`); std's most used names need none. (`volec guide modules`)"
    } else if w == "mod" {
        "`mod name;` is the module in `name.vl` (or `name/mod.vl`); `mod name { .. }` one written here. (`volec guide modules`)"
    } else if w == "pub" {
        "`pub`: the item is visible outside its module. (`volec guide modules`)"
    } else if w == "const" {
        "`const N: T = e;`: a constant, computed at compile time."
    } else if w == "static" {
        "`static X: T = e;` a global value; `static var` one that changes (a `global` effect, never on another thread). (`volec guide effects`)"
    } else if w == "match" {
        "`match e { P => .., _ => .. }`: the arm of the first pattern that fits; every case must be covered. (`volec guide language`)"
    } else if w == "unsafe" {
        "`unsafe { .. }`: raw pointers and C calls, which safe code cannot make undefined; `unsafe fn` needs one at its calls. (`volec guide unsafe`)"
    } else if w == "defer" {
        "`defer stmt;` runs the statement when the block it is in ends, however it ends."
    } else if w == "extern" {
        "`extern \"C\" { fn f(..); }` declares C functions (called in `unsafe`); `extern \"C\" fn` defines one C can call. (`volec guide c-interop`)"
    } else if w == "import" {
        "`import \"h.h\" as c;` reads a C header: its names are `c::name`. (`volec guide c-interop`)"
    } else if w == "type" {
        "`type X = T;` another name for T; `type X = distinct T;` a type of its own with T's representation. (`volec guide types`)"
    } else if w == "union" {
        "`union U { .. }`: fields sharing their memory; reading one is `unsafe`. (`volec guide c-interop`)"
    } else if w == "loop" {
        "`loop { .. }` repeats until a `break` (`break value` gives the loop's value)."
    } else if w == "while" {
        "`while cond { .. }` repeats while cond holds; `while let P = e` while e fits P."
    } else if w == "for" {
        "`for x in e { .. }`: x takes each element of a range, slice, Vec or iterator. (`volec guide iterators`)"
    } else if w == "return" {
        "`return e;` leaves the function with e; a block's last expression is its value without one."
    } else if w == "as" {
        "`e as T` converts between numeric types (and a bool or a fieldless enum to an integer); only widening is implicit. (`volec guide conversions`)"
    } else if w == "if" || w == "else" {
        "`if cond { a } else { b }`: an expression; `if let P = e { .. }` when e fits P."
    } else if w == "in" {
        "`for x in e`: what the loop goes over."
    } else if w == "break" || w == "continue" {
        "`break` leaves the loop (`break value`, `break 'label`); `continue` goes on with its next turn."
    } else if w == "move" {
        "`move` is Rust's spelling: a closure that takes what it captures is `sink || ..`."
    } else {
        ""
    }
}

// The text for attribute a (`#[a]`, `#[a(..)]`), or an empty slice.
pub fn attribute_text(a: [u8]) -> [u8] {
    if a == "derive" {
        "`#[derive(Eq, Debug, ..)]` writes the impls of the traits named for the type: Eq, Ord, Hash, Clone, Debug, Default. (`volec guide traits`)"
    } else if a == "test" {
        "`#[test] fn`: a test, run by `volec test` at -O0 and -O2. (`volec guide testing`)"
    } else if a == "property" {
        "`#[property] fn p(x: T)`: a property, run on generated inputs (shrunk on a failure) by `volec test`. (`volec guide testing`)"
    } else if a == "fuzz" {
        "`#[fuzz] fn f(data: [u8])`: a fuzz target, run by `volec fuzz`. (`volec guide testing`)"
    } else if a == "pure" {
        "`#[pure]`: the function has no effect (no allocation, I/O, global, panic...); the checker holds it to that. (`volec guide effects`)"
    } else if a == "effects" {
        "`#[effects(io, alloc(A), ..)]`: the effects the function may have, and no other. (`volec guide effects`)"
    } else if a == "no_alloc" || a == "no_io" || a == "no_panic" {
        "`#[no_alloc]`, `#[no_io]`, `#[no_panic]`: the function has no such effect, checked. (`volec guide effects`)"
    } else if a == "inline" || a == "cold" {
        "`#[inline]`, `#[inline(never)]`, `#[cold]`: hints for the optimizer."
    } else if a == "repr" {
        "`#[repr(C)]`: the struct or enum is laid out as C would; `#[repr(u8)]` an enum's tag type. (`volec guide c-interop`)"
    } else if a == "link" {
        "`#[link(\"name\")]` on an extern block links the library. (`volec guide c-interop`)"
    } else if a == "link_name" {
        "`#[link_name = \"sym\"]`: the C symbol of an extern item. (`volec guide c-interop`)"
    } else if a == "thread_local" {
        "`#[thread_local] static var X: T = e;` gives each thread its own X. (`volec guide threads`)"
    } else if a == "cfg" {
        "`#[cfg(test)]`: the item (a module's items) exists only in test builds. (`volec guide testing`)"
    } else if a == "multiversion" || a == "target_feature" {
        "`#[target_feature(enable = \"..\")]` declares the CPU features a function needs; `#[multiversion(\"..\")]` compiles it once per feature set, chosen at run time. (`volec guide arch`)"
    } else if a == "views" || a == "stores" {
        "`#[views(a, *b)]`, `#[stores(c)]`: pin a function's view summary (what its result views, what it stores); otherwise inferred. (`volec guide views`)"
    } else if a == "sealed" {
        "`#[sealed]`: the struct's fields not marked `pub` are hidden outside its module; no `S { .. }` there."
    } else if a == "scoped" {
        "`#[scoped]`: the type's values may not leave the closure that is given them (an arena's `ScopedArena`). (`volec guide allocators`)"
    } else if a == "ambient" {
        "`#[ambient]`: a std function that allocates from the program's Gpa without taking it (0.15's forms). (`volec guide allocators`)"
    } else {
        ""
    }
}

// The text for primitive type t, or an empty slice.
pub fn primitive_text(t: [u8]) -> [u8] {
    if t == "i8" || t == "i16" || t == "i32" || t == "i64" || t == "isize" {
        "A signed integer of that many bits (`isize`: 64). Every operation is defined: it wraps, `x / 0 == 0`; only widening converts implicitly. (`volec guide types`)"
    } else if t == "u8" || t == "u16" || t == "u32" || t == "u64" || t == "usize" {
        "An unsigned integer of that many bits (`usize`: 64; lengths and indices are `i64`). It wraps; `'a'` is a `u8`, text is `[u8]`. (`volec guide types`)"
    } else if t == "f32" || t == "f64" {
        "An IEEE 754 float; literals are `f64`. (`volec guide types`)"
    } else if t == "bool" {
        "`true` or `false`; `b as i64` is 0 or 1."
    } else if t == "str" {
        "`str`: a parameter that takes text: a literal, a `[u8]` or a String's `&s`. (`volec guide text`)"
    } else {
        ""
    }
}

// The text for a closure bound's name (`F: Fn(i64) -> i64`), or an empty
// slice.
pub fn bound_text(w: [u8]) -> [u8] {
    if w == "Fn" {
        "`F: Fn(A) -> R`: a closure with that signature that assigns no captured variable, or a plain function `fn(A) -> R`. (`volec guide closures`)"
    } else if w == "FnMut" {
        "`F: FnMut(A) -> R`: any closure with that signature, or a plain function; called from a `sink F` parameter or a `var`. (`volec guide closures`)"
    } else {
        ""
    }
}
