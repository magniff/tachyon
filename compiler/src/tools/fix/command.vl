// `volec fix`'s command line: the kinds of fix (--only), the
// import paths chosen for a missing name, and the rounds of fixes until
// nothing is left (split from fix).

use crate::base::{
    BUFS, IntVec, OVERLAY, STDOUT, SYMS, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, intern, streq,
};
use crate::base::diag::{FIX_AT_FILE, FIX_AT_LINE, SUGGESTED};
use crate::front::ambient::AMBIENT_GPA;
use crate::front::ast::{KEEP_PARSED, NODES};
use crate::front::generics::{TPL_NONE, template_of_key};
use crate::front::modules::{C_MODULE, MODULES, item_key_if_known, module_count, within_std};
use crate::front::modules::lookup::LEGACY_IMPORTS;
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::types::{
    SYM_ALIAS, SYM_CONST, SYM_ENUM, SYM_FN, SYM_STATIC, SYM_STRUCT, item_node_of,
};
use crate::tools::edit::{TARGET, TARGET_NAME, edit_count};
use crate::tools::edit::apply::{
    CHECK_STRICT, LEFT_OK, STRICT_ALLOC, copy_rewritten, finish_edit, overlay_args, prepare_edit,
    set_command, write_round,
};
use crate::tools::edit::cli::take_edit_option;
use crate::tools::fix::{missing_use_edits, pub_edits, suggested_edits, unused_import_edits};
use crate::tools::fixconv::{
    CC_DEREF, CC_INOUT_LOCAL, CC_MARKER, CC_PARAM_INOUT, CC_PARAM_LET, CC_PARAM_SINK, CC_RECEIVER,
    CC_SINK_CLOSURE, CC_STATIC, CC_TYPE, CC_UNMARKED, CC_VAR, CONV_COUNTS, CONV_LIST_LEFT,
    CONV_SPELLING, conventions_edits, conventions_report,
};
use crate::tools::fiximports::{FIX_IMPORTS, fix_imports_edits};
use crate::tools::fixstd015::std015_edits;
use crate::tools::fixunsafe::{FIX_UNSAFE, WHOLE_BODIES, fix_unsafe_edits};
use crate::tools::fixvalues::{VALUES_COUNTS, values_edits};
use crate::tools::query::{c_slice, file_line, root_or_diag};
use crate::tools::query::command_line::load_program;
use crate::tools::query::defs::{mod_fqn, mod_fqn_text};
use crate::tools::query::diagnostics::{
    PROG, ROOT_GIVEN, TOOL, diag, program_errors, put_word, try_begin, try_end, write_diags,
};
use crate::tools::query::refs::{OPT_IN, put_bad_in, resolve_in};
use crate::tools::reexports::reexport_edits;
use crate::tools::refactor_shape::alloc016::{ALLOC016_LEFT, alloc016_edits};
use crate::tools::tidyimports::{TIDY_EDITED, tidy_import_edits};

const F_IMPORTS: i64 = 1;
const F_UNUSED: i64 = 2;
const F_PUB: i64 = 4;
const F_UNSAFE: i64 = 8;
// (0.12; not in the default: --only tidy-imports, --only reexports)
const F_TIDY: i64 = 16;
const F_REEXPORTS: i64 = 32;
// (0.15: only when asked for, as tidy-imports and reexports: fixstd015.vl)
const F_STD015: i64 = 64;
// (0.16: refactor_shape/alloc016.vl)
const F_ALLOC016: i64 = 128;
// (0.18: --suggested, `--only suggested`) the errors' exact fixes
// (fix::suggested_edits), with the imports and pubs the errors ask for
const F_SUGGESTED: i64 = 256;
// (0.17: --values, fixvalues.vl)
const F_VALUES: i64 = 512;
// (0.20: `--only conventions`, fixconv.vl; `conventions-spelling`: the
// part the checker of Phase 0 means as 0.19 did)
const F_CONV: i64 = 1024;
const F_CONV_SPELLING: i64 = 2048;
const F_SUGGESTS: i64 = F_IMPORTS | F_PUB | F_SUGGESTED;
const F_ALL: i64 = 15;

// ---- Which module a missing import comes from (0.16) ----

// `--use PATH::NAME`: the module to import NAME from when several have
// it (fix.ambiguous's `try:` lines), as symbols: path, name, in pairs.
static var CHOSEN: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Whether a name was left for fix.ambiguous (the exit status is 1).
static var AMBIGUOUS: bool = false;

// `--use PATH::NAME` into CHOSEN. False when it has no `::`.
fn take_use(v: [u8]) -> bool {
    unsafe {
        var cut = -1;
        for i in 1..v.len {
            if v[i] == ':' && v[i - 1] == ':' {
                cut = i - 1;
            }
        }
        if cut <= 0 || cut + 2 >= v.len {
            return false;
        }
        CHOSEN.push(intern(v[0..cut]));
        CHOSEN.push(intern(v[cut + 2..v.len]));
        true
    }
}

// The module whose path is symbol p (`crate::a::b`, `std`), or -1 (std's
// path when std is not read).
fn module_of_path(p: i64) -> i64 {
    for m in 0..module_count() {
        if m != C_MODULE && mod_fqn(m) == p {
            return m;
        }
    }
    -1
}

// 1 for a value (a function, constant or static), 2 for a type, else 0.
fn key_kind(key: i64) -> i64 {
    unsafe {
        if SYM_FN[key] != 0 || SYM_CONST[key] != 0 || SYM_STATIC[key] != 0 {
            1
        } else if SYM_STRUCT[key] != 0 || SYM_ENUM[key] != 0 || SYM_ALIAS[key] != 0
            || template_of_key(key) != TPL_NONE {
            2
        } else {
            0
        }
    }
}

// Whether module a is module m or holds it.
fn holds(a: i64, m: i64) -> bool {
    unsafe {
        var x = m;
        loop {
            if x == a {
                return true;
            }
            if x <= 0 {
                return false;
            }
            x = MODULES[x].parent;
        }
    }
}

// Whether module m can name module c's items: each module on c's path is
// public, or its parent holds m.
fn reachable(c: i64, m: i64) -> bool {
    unsafe {
        if within_std(c) {
            return true;
        }
        var x = c;
        while x > 0 {
            let p = MODULES[x].parent;
            if !MODULES[x].public && !holds(p, m) {
                return false;
            }
            x = p;
        }
        true
    }
}

// How near module c is to module m: the depth of the innermost module
// holding both (std: -1, farther than any of the program's), and the
// number of segments of c's path.
fn nearness(c: i64, m: i64, shared: inout i64, segments: inout i64) {
    unsafe {
        var n = 0;
        var x = c;
        while x > 0 {
            n += 1;
            x = MODULES[x].parent;
        }
        segments = if within_std(c) { 1 } else { n + 1 };
        if within_std(c) {
            shared = -1;
            return;
        }
        var a = c;
        while !holds(a, m) {
            a = MODULES[a].parent;
        }
        var d = 0;
        while a > 0 {
            d += 1;
            a = MODULES[a].parent;
        }
        shared = d;
    }
}

// Whether module a is nearer to m than module b.
fn nearer(a: i64, b: i64, m: i64) -> bool {
    var sa = 0;
    var na = 0;
    var sb = 0;
    var nb = 0;
    nearness(a, m, &sa, &na);
    nearness(b, m, &sb, &nb);
    sa > sb || (sa == sb && na < nb)
}

// The path (a symbol) to import `name` from into module m, which the
// checker's help gave as p: when other modules m can name have a public
// item `name` of the same kind, the one --use names, else the nearest
// (the innermost module holding both, then the fewest segments) when no
// other is as near; else -1, after fix.ambiguous.
pub fn choose_path(m: i64, name: i64, p: i64) -> i64 {
    unsafe {
        let pm = module_of_path(p);
        if pm < 0 {
            return p;
        }
        let kind = key_kind(item_key_if_known(pm, name));
        var cands = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var keys = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for c in 0..module_count() {
            if c == m || c == C_MODULE {
                continue;
            }
            let key = item_key_if_known(c, name);
            if key < 0 {
                continue;
            }
            let item = item_node_of(key);
            if item == 0 || (NODES[item].p & ITEM_PUBLIC) == 0 || key_kind(key) != kind
                || !reachable(c, m) {
                continue;
            }
            cands.push(c);
            keys.push(key);
        }
        if cands.count <= 1 {
            return p;
        }
        for i in 0..CHOSEN.count / 2 {
            if CHOSEN.data[2 * i + 1] != name {
                continue;
            }
            for k in 0..cands.count {
                if mod_fqn(cands.data[k]) == CHOSEN.data[2 * i] {
                    return CHOSEN.data[2 * i];
                }
            }
        }
        // The nearest; those as near that are another item.
        var best = 0;
        for k in 1..cands.count {
            if nearer(cands.data[k], cands.data[best], m) {
                best = k;
            }
        }
        var tied = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        tied.push(cands.data[best]);
        for k in 0..cands.count {
            if k != best && keys.data[k] != keys.data[best]
                && !nearer(cands.data[best], cands.data[k], m) {
                tied.push(cands.data[k]);
            }
        }
        if tied.count == 1 {
            return mod_fqn(cands.data[best]);
        }
        AMBIGUOUS = true;
        let d = diag(c"error", c"fix.ambiguous");
        buf_bytes(d, mod_fqn_text(m));
        buf_str(d, c" uses '");
        buf_bytes(d, SYMS[name].text);
        buf_str(d, c"', which ");
        buf_int(d, tied.count);
        buf_str(d, c" modules as near have: ");
        for k in 0..tied.count {
            if k > 0 {
                buf_str(d, c", ");
            }
            buf_bytes(d, mod_fqn_text(tied.data[k]));
        }
        buf_str(d, c"; nothing is imported for it: name one with --use\n");
        for k in 0..tied.count {
            if k == 5 {
                break;
            }
            let out = try_begin(c"fix", c_slice(c""), false);
            buf_str(out, c" --only imports --use");
            let path = buf_new();
            buf_bytes(path, mod_fqn_text(tied.data[k]));
            buf_str(path, c"::");
            buf_bytes(path, SYMS[name].text);
            put_word(out, buf_slice(path));
            if OPT_IN != 0 as *u8 {
                buf_str(out, c" --in");
                put_word(out, c_slice(OPT_IN));
            }
            try_end(out);
        }
        -1
    }
}

// ---- The command ----

// `N noun` (plural when N is not 1), after a comma when the summary has
// something already.
fn put_count(out: i64, n: i64, one: *u8, many: *u8) {
    unsafe {
        if n == 0 {
            return;
        }
        if BUFS[out].len > 6 {
            buf_str(out, c",");
        }
        buf_byte(out, ' ');
        buf_int(out, n);
        buf_byte(out, ' ');
        buf_str(out, if n == 1 { one } else { many });
    }
}

pub fn run_fix(argc: i64, argv: **u8) -> i64 {
    let status = run_fix_inner(argc, argv, 0);
    write_diags();
    status
}

// `volec --fix-imports ROOT`, `--fix-unsafe ROOT` (`only`: F_IMPORTS,
// F_UNSAFE): fix, quiet when there is nothing to do.
pub fn run_fix_alias(argc: i64, argv: **u8, only: i64) -> i64 {
    let status = run_fix_inner(argc, argv, only);
    write_diags();
    status
}

fn run_fix_inner(argc: i64, argv: **u8, alias: i64) -> i64 {
    unsafe {
        set_command(argc, argv);
        PROG = argv[0];
        TOOL = 0 as *u8;
        var only = if alias != 0 { alias } else { F_ALL };
        var only_arg = if alias == F_IMPORTS { c"imports" }
            else if alias == F_UNSAFE { c"unsafe" } else { 0 as *u8 };
        var round = false;
        var suggested = false;
        var at = 0 as *u8;
        var root = 0 as *u8;
        var i = if alias != 0 { 1 } else { 2 };
        while i < argc {
            let a = argv[i];
            if alias != 0 && (streq(a, c"--fix-imports") || streq(a, c"--fix-unsafe")) {
                i += 1;
                continue;
            }
            if streq(a, c"--round") {
                round = true;
                i += 1;
                continue;
            }
            if streq(a, c"--suggested") {
                suggested = true;
                i += 1;
                continue;
            }
            if streq(a, c"--values") {
                only = if only_arg == 0 as *u8 { F_VALUES } else { only | F_VALUES };
                only_arg = c"values";
                i += 1;
                continue;
            }
            if streq(a, c"--at") && i + 1 < argc {
                at = argv[i + 1];
                let s = c_slice(at);
                var line = 0;
                let n = file_line(s, &line);
                if n <= 0 || line <= 0 {
                    let d = diag(c"error", c"fix.usage");
                    buf_str(d, c"--at takes FILE:LINE, the line of an error\n");
                    return 2;
                }
                let f = buf_new();
                buf_bytes(f, s[0..n]);
                buf_byte(f, 0);
                FIX_AT_FILE = BUFS[f].data;
                FIX_AT_LINE = line;
                i += 2;
                continue;
            }
            if streq(a, c"--list-left") {
                CONV_LIST_LEFT = true;
                i += 1;
                continue;
            }
            if streq(a, c"--tidy-edited") {
                TIDY_EDITED = true;
                i += 1;
                continue;
            }
            if streq(a, c"--in") && i + 1 < argc {
                OPT_IN = argv[i + 1];
                i += 2;
                continue;
            }
            if streq(a, c"--use") && i + 1 < argc {
                if !take_use(c_slice(argv[i + 1])) {
                    let d = diag(c"error", c"fix.usage");
                    buf_str(d, c"--use takes the path of an item, 'crate::a::b::name'\n");
                    return 2;
                }
                i += 2;
                continue;
            }
            if streq(a, c"--overlay") && i + 2 < argc {
                OVERLAY.push(argv[i + 1] as i64);
                OVERLAY.push(argv[i + 2] as i64);
                i += 3;
                continue;
            }
            if streq(a, c"--only") && i + 1 < argc {
                only = 0;
                let v = argv[i + 1];
                only_arg = v;
                var k = 0;
                // (a comma-separated list)
                while v[k] != 0 {
                    var e = k;
                    while v[e] != 0 && v[e] != ',' {
                        e += 1;
                    }
                    let w = v[k..e];
                    let bit = if word_is(w, c"imports") { F_IMPORTS }
                        else if word_is(w, c"unused") { F_UNUSED }
                        else if word_is(w, c"pub") { F_PUB }
                        else if word_is(w, c"unsafe") { F_UNSAFE }
                        else if word_is(w, c"tidy-imports") { F_TIDY }
                        else if word_is(w, c"reexports") { F_REEXPORTS }
                        else if word_is(w, c"std015") { F_STD015 }
                        else if word_is(w, c"alloc016") { F_ALLOC016 }
                        else if word_is(w, c"values") { F_VALUES }
                        else if word_is(w, c"conventions") { F_CONV }
                        else if word_is(w, c"conventions-spelling") { F_CONV_SPELLING }
                        else if word_is(w, c"suggested") { F_SUGGESTS } else { 0 };
                    if bit == 0 {
                        let d = diag(c"error", c"fix.usage");
                        buf_str(d, c"--only takes imports, unused, pub, unsafe, suggested, tidy-imports, reexports, std015, alloc016, values, conventions or conventions-spelling, not '");
                        buf_bytes(d, w);
                        buf_str(d, c"'\n");
                        return 2;
                    }
                    only |= bit;
                    k = if v[e] == ',' { e + 1 } else { e };
                }
                i += 2;
                continue;
            }
            if take_edit_option(argc, argv, &i, &root) {
                i += 1;
                continue;
            }
            if a[0] == '-' {
                let d = diag(c"error", c"fix.usage");
                buf_str(d, c"unknown option '");
                buf_str(d, a);
                buf_str(d, c"'\n");
                let out = try_begin(c"fix", c_slice(c""), false);
                try_end(out);
                return 2;
            }
            if root != 0 as *u8 {
                let d = diag(c"error", c"fix.usage");
                buf_str(d, c"one ROOT (the program's root file), not '");
                buf_str(d, a);
                buf_str(d, c"'\n");
                return 2;
            }
            root = a;
            i += 1;
        }
        if suggested {
            only = if only_arg == 0 as *u8 { F_SUGGESTS } else { only | F_SUGGESTS };
        }
        // (0.20) The migrations read 0.19's spelling: the program is read
        // mixed (front/conv), whatever the default
        if (only & (F_STD015 | F_ALLOC016 | F_VALUES | F_CONV | F_CONV_SPELLING)) != 0 {
            crate::front::conv::set_mixed();
        }
        if (only & (F_STD015 | F_ALLOC016 | F_VALUES)) != 0 {
            crate::tools::fixconv::WRITE_019 = true;
        }
        if (only & F_SUGGESTED) != 0 {
            LEFT_OK = true;
        } else if at != 0 as *u8 {
            let d = diag(c"error", c"fix.usage");
            buf_str(d, c"--at is for --suggested: the fixes of the errors at a line\n");
            return 2;
        }
        ROOT_GIVEN = root;
        root = root_or_diag(root, c"fix", c_slice(c""), false);
        if root == 0 as *u8 {
            return 2;
        }
        FIX_IMPORTS = (only & F_IMPORTS) != 0;
        FIX_UNSAFE = (only & F_UNSAFE) != 0;
        // (std015 reads the calls as written)
        if (only & F_STD015) != 0 {
            KEEP_PARSED = true;
        }
        // (alloc016 reads the 0.15 forms as calls of std's functions, and
        // the edited program is checked with them errors)
        if (only & F_ALLOC016) != 0 {
            KEEP_PARSED = true;
            AMBIENT_GPA = true;
            STRICT_ALLOC = true;
        }
        // (0.20: conventions reads the program as 0.19 meant it, mixed; the
        // edited one is checked in 0.20's spelling, but by
        // conventions-spelling's, which keeps 0.19's meaning)
        if (only & (F_CONV | F_CONV_SPELLING)) != 0 {
            CONV_SPELLING = (only & F_CONV) == 0;
            CHECK_STRICT = !CONV_SPELLING;
            crate::front::conv::set_mixed();
        }
        if !load_program(root, TARGET) {
            // (0.18) a program that does not parse: its errors' exact
            // fixes alone (a Rust label respelled)
            if (only & F_SUGGESTED) == 0 || SUGGESTED.count == 0 || OPT_IN != 0 as *u8 {
                program_errors(c"error", root, true);
                return 1;
            }
            only = F_SUGGESTED;
        }
        if OPT_IN != 0 as *u8 && !resolve_in_list(c_slice(OPT_IN)) {
            let d = diag(c"error", c"fix.bad-in");
            put_bad_in(d, OPT_IN);
            return 1;
        }
        // The fixes (an edit overlapping one made before is left for the
        // next run).
        let wild = if (only & F_IMPORTS) != 0 && LEGACY_IMPORTS { fix_imports_edits() } else { 0 };
        let imports = if (only & F_IMPORTS) != 0 { missing_use_edits() } else { 0 };
        let unused = if (only & F_UNUSED) != 0 { unused_import_edits(0 as *IntVec) } else { 0 };
        let public = if (only & F_PUB) != 0 { pub_edits() } else { 0 };
        WHOLE_BODIES = alias == 0;
        let wrapped = if (only & F_UNSAFE) != 0 { fix_unsafe_edits() } else { 0 };
        var dropped = 0;
        let through = if (only & F_REEXPORTS) != 0 { reexport_edits(&dropped) } else { 0 };
        let tidied = if (only & F_TIDY) != 0 { tidy_import_edits() } else { 0 };
        let migrated = if (only & F_STD015) != 0 { std015_edits() } else { 0 };
        let explicit = if (only & F_ALLOC016) != 0 { alloc016_edits() } else { 0 };
        let exact = if (only & F_SUGGESTED) != 0 { suggested_edits() } else { 0 };
        let valued = if (only & F_VALUES) != 0 { values_edits() } else { 0 };
        let conv = if (only & (F_CONV | F_CONV_SPELLING)) != 0 { conventions_edits() } else { 0 };
        if (only & (F_CONV | F_CONV_SPELLING)) != 0 {
            conventions_report();
        }
        var counts = [imports, wild, unused, public, wrapped, through, dropped, tidied,
            migrated, explicit, exact];
        if round {
            // (a later round, on the edited program: what it fixed, the
            // copies it rewrote)
            if edit_count() == 0 {
                return 0;
            }
            let out = buf_new();
            buf_str(out, c"count");
            for k in 0..11 {
                buf_byte(out, '\t');
                buf_int(out, counts[k]);
            }
            buf_byte(out, '\n');
            buf_write_fd(out, STDOUT);
            return write_round();
        }
        if edit_count() == 0 {
            if AMBIGUOUS || ALLOC016_LEFT > 0 {
                return 1;
            }
            if alias == 0 {
                let d = diag(c"note", c"fix.none");
                buf_str(d, c"nothing to fix\n");
            }
            return 0;
        }
        let status = prepare_edit();
        if status >= 0 {
            return status;
        }
        // More rounds, on the edited program: a fix may let the checker
        // see more (the next unknown name of a statement). (--values: its
        // own fixed point, one round)
        let one_round = only == F_VALUES || only == F_CONV || only == F_CONV_SPELLING;
        for _ in 0..if one_round { 0 } else { 4 } {
            if !more_round(root, only_arg, suggested, at, &counts) {
                break;
            }
        }
        if only == F_VALUES {
            // (0.19.1) then a read-only `[T]` given to a `&mut [T]`
            // parameter (own.readonly) made exclusive, `&mut a[..]`,
            // `v.as_mut_slice()`, `v.sort()`: the errors' exact fixes
            more_round(root, c"suggested", true, at, &counts);
        }
        let what = buf_new();
        buf_str(what, c"fixed");
        put_count(what, counts[0], c"missing import", c"missing imports");
        put_count(what, counts[1], c"wildcard import", c"wildcard imports");
        put_count(what, counts[2], c"unused import", c"unused imports");
        put_count(what, counts[3], c"pub", c"pubs");
        put_count(what, counts[4], c"unsafe block", c"unsafe blocks");
        put_count(what, counts[5], c"import through a re-export", c"imports through re-exports");
        put_count(what, counts[6], c"unused re-export", c"unused re-exports");
        put_count(what, counts[7], c"untidy use line", c"untidy use lines");
        put_count(what, counts[8], c"call of 0.14's std", c"calls of 0.14's std");
        put_count(what, counts[9], c"allocation made explicit", c"allocations made explicit");
        put_count(what, counts[10], c"suggested fix", c"suggested fixes");
        if valued > 0 {
            put_count(what, VALUES_COUNTS[0], c"parameter to &mut T", c"parameters to &mut T");
            put_count(what, VALUES_COUNTS[1], c"parameter to &T", c"parameters to &T");
            put_count(what, VALUES_COUNTS[2], c"slice parameter to &mut [T]",
                c"slice parameters to &mut [T]");
            put_count(what, VALUES_COUNTS[3], c"owned parameter to &T (only read)",
                c"owned parameters to &T (only read)");
            put_count(what, VALUES_COUNTS[4], c"argument", c"arguments");
            put_count(what, VALUES_COUNTS[5], c"defer x.free() (dropped now)",
                c"defer x.free()s (dropped now)");
        }
        if conv > 0 {
            put_count(what, CONV_COUNTS[CC_PARAM_LET], c"parameter to let", c"parameters to let");
            put_count(what, CONV_COUNTS[CC_PARAM_INOUT], c"parameter to inout",
                c"parameters to inout");
            put_count(what, CONV_COUNTS[CC_PARAM_SINK], c"parameter to sink",
                c"parameters to sink");
            put_count(what, CONV_COUNTS[CC_RECEIVER], c"receiver", c"receivers");
            put_count(what, CONV_COUNTS[CC_MARKER], c"'&mut e' to '&e'", c"'&mut e's to '&e'");
            put_count(what, CONV_COUNTS[CC_UNMARKED], c"'&e' to a let", c"'&e's to a let");
            put_count(what, CONV_COUNTS[CC_DEREF], c"'*r' of an access", c"'*r's of accesses");
            put_count(what, CONV_COUNTS[CC_VAR], c"'let mut' / 'mut x' to var",
                c"'let mut's / 'mut x's to var");
            put_count(what, CONV_COUNTS[CC_INOUT_LOCAL], c"inout local", c"inout locals");
            put_count(what, CONV_COUNTS[CC_STATIC], c"static var", c"static vars");
            put_count(what, CONV_COUNTS[CC_SINK_CLOSURE], c"sink closure", c"sink closures");
            put_count(what, CONV_COUNTS[CC_TYPE], c"access type", c"access types");
        }
        let status = finish_edit(buf_slice(what), root);
        if AMBIGUOUS || ALLOC016_LEFT > 0 { 1 } else { status }
    }
}

// (0.20) --in A,B,...: each resolved (query's --in, the matches adding up);
// whether each matched.
fn resolve_in_list(x: [u8]) -> bool {
    var start = 0;
    for i in 0..x.len + 1 {
        if i == x.len || x[i] == ',' {
            if i > start && !resolve_in(x[start..i]) {
                return false;
            }
            start = i + 1;
        }
    }
    true
}

// A round of fix on the edited program (`PROG fix --round ... --overlay
// FILE COPY... ROOT`): adds what it fixed to counts. Whether it fixed
// anything.
fn more_round(root: *u8, only_arg: *u8, suggested: bool, at: *u8, counts: inout [i64; 11]) -> bool {
    unsafe {
        var args = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        args.push(PROG as i64);
        args.push(c"fix" as i64);
        args.push(c"--round" as i64);
        if only_arg != 0 as *u8 {
            args.push(c"--only" as i64);
            args.push(only_arg as i64);
        }
        if OPT_IN != 0 as *u8 {
            args.push(c"--in" as i64);
            args.push(OPT_IN as i64);
        }
        if suggested {
            args.push(c"--suggested" as i64);
        }
        if at != 0 as *u8 {
            args.push(c"--at" as i64);
            args.push(at as i64);
        }
        if TIDY_EDITED {
            args.push(c"--tidy-edited" as i64);
        }
        if TARGET_NAME != 0 as *u8 {
            args.push(c"--target" as i64);
            args.push(TARGET_NAME as i64);
        }
        overlay_args(&args);
        args.push(root as i64);
        args.push(0);
        let out = buf_new();
        if crate::tools::proc::run_capture(args.data as **u8, out) != 0 {
            return false;
        }
        let t = buf_slice(out);
        var any = false;
        var i = 0;
        while i < t.len {
            var e = i;
            while e < t.len && t[e] != '\n' {
                e += 1;
            }
            let line = t[i..e];
            if line.len > 5 && line[0] == 'f' && line[4] == '\t' {
                if copy_rewritten(line[5..line.len]) {
                    any = true;
                }
            } else if line.len > 6 && line[0] == 'c' && line[5] == '\t' {
                var k = 0;
                var p = 6;
                while p < line.len && k < 11 {
                    var n = 0;
                    while p < line.len && line[p] >= '0' && line[p] <= '9' {
                        n = n * 10 + (line[p] - '0') as i64;
                        p += 1;
                    }
                    counts[k] += n;
                    k += 1;
                    p += 1;
                }
            }
            i = e + 1;
        }
        any
    }
}

fn word_is(w: [u8], s: *u8) -> bool {
    unsafe { crate::tools::proc::same_bytes(w, c_slice(s)) }
}
