// `volec assemble [--target T] FILE.s -o FILE.o` (0.19): the compiler's
// own assembler (back/objfile, enc_x86, enc_arm64) on a file of assembly,
// as `cc -c` would assemble it. A developer's tool, for the encoding tests
// (tests/arch/enc.sh: every instruction of the tables with extreme
// registers and memory forms, compared byte for byte with cc's).

use crate::arch::table::load_insns;
use crate::back::objfile::write_object;
use crate::base::{BUFS, buf_byte, die, read_file, streq};
use crate::base::target::{set_target, target_of_name};
use crate::middle::ctx::main_cx;

pub fn run_assemble(argc: i64, argv: **u8) -> i64 {
    unsafe {
        var target = 0;
        var input = 0 as *u8;
        var output = 0 as *u8;
        var i = 2;
        while i < argc {
            let a = argv[i];
            if streq(a, c"--target") && i + 1 < argc {
                target = target_of_name(argv[i + 1]);
                if target == 0 {
                    die(c"assemble: unknown target");
                }
                i += 1;
            } else if streq(a, c"-o") && i + 1 < argc {
                output = argv[i + 1];
                i += 1;
            } else {
                input = a;
            }
            i += 1;
        }
        if input == 0 as *u8 || output == 0 as *u8 {
            die(c"usage: volec assemble [--target T] FILE.s -o FILE.o");
        }
        set_target(if target == 0 { crate::host_target() } else { target });
        load_insns();
        let cx = main_cx();
        read_file(input, cx.asm);
        if BUFS[cx.asm].len > 0 && BUFS[cx.asm].data[BUFS[cx.asm].len - 1] != '\n' {
            buf_byte(cx.asm, '\n');
        }
        write_object(cx, output);
        0
    }
}
