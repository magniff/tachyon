// Planning queries (0.11; docs/refactor.md): the facts for deciding how to
// change a program, from the same front end as the other queries.
//
//   query stats [MODULE|FILE] [--over N]   lines per file (or per item),
//                                          largest first
//   query deps MODULE [--max-lines N]      what each item of a module uses
//                                          of it and is used by, and a
//                                          grouping into parts of at most
//                                          N lines
//   query unused [MODULE]                  items, fields, variants and
//                                          imports nothing uses
//   query impact NAME                      what a change of NAME's
//                                          signature touches
//   tachyonc lint --max-lines N [ROOT]     the files over N lines
//
// Lines of an item are its text's: from its comments and attributes to
// its last line (as `query show` prints it).
//
// `query deps` and the clustering it shares with `refactor split --plan`
// are in deps; the other queries and lint are here.

pub mod deps;

use crate::base::{
    FILES, FILE_COUNT, IntVec, SRC, STDOUT, SYMS, alloc_array, buf_byte, buf_bytes, buf_int,
    buf_new, buf_str, buf_write_fd, free, streq,
};
use crate::front::ast::{NODES, NodeKind};
use crate::front::modules::{C_MODULE, MODULES, STD_MODULE, file_of_pos, module_at, within_std};
use crate::front::types::{FNS, FN_COUNT};
use crate::gen0::gen::MAIN_SYM;
use crate::tools::fix::unused_imports;
use crate::tools::fmt::generated;
use crate::tools::proc::same_bytes;
use crate::tools::query::{OPT_OVER, QF_CALL, QF_DEF, QF_USE, c_slice, root_or_diag};
use crate::tools::query::command_line::load_program;
use crate::tools::query::defs::{
    DEFS, DEF_COUNT, K_IMPL_METHOD, K_MOD, K_TRAIT_FN, kind_name, mod_fqn, mod_fqn_text,
};
use crate::tools::query::diagnostics::{
    PROG, ROOT_GIVEN, TOOL, diag, program_errors, try_begin, try_end, try_query, write_diags,
};
use crate::tools::query::positions::{enclosing, line_of, put_loc, sort_by_position};
use crate::tools::query::refs::{
    GROUP, OPT_ALL, REFS_BUDGET, R_DEF, R_FLAGS, R_POS, TARGETS, collect_refs, file_text, put_short,
    set_targets, sorted_refs,
};
use crate::tools::query::show::{find_modules, module_file, text_start};
use deps::put_local;

// ---- Sizes ----

// The number of lines of file f.
fn file_lines(f: i64) -> i64 {
    unsafe {
        var n = 0;
        for p in FILES[f].start..FILES[f].end {
            if SRC[p] == '\n' {
                n += 1;
            }
        }
        if FILES[f].end > FILES[f].start && SRC[FILES[f].end - 1] != '\n' {
            n += 1;
        }
        n
    }
}

// The lines of definition d's text.
fn def_lines(d: i64) -> i64 {
    unsafe {
        let last = if DEFS[d].end > DEFS[d].start { DEFS[d].end - 1 } else { DEFS[d].start };
        line_of(last) - line_of(text_start(d)) + 1
    }
}

// Whether file f is one of the program's own (not std's, the C headers').
fn user_file(f: i64) -> bool {
    unsafe { FILES[f].path[0] != '<' }
}

// Whether definition d is an item: not a field or variant, not a module,
// in a file of the program.
fn is_item(d: i64) -> bool {
    unsafe {
        DEFS[d].parent < 0 && DEFS[d].kind != K_MOD && user_file(file_of_pos(DEFS[d].start))
    }
}

// Whether text names a file (it has a `/`, ends in .tach, or is `<std>`).
fn is_file_name(t: [u8]) -> bool {
    if t.len > 0 && t[0] == '<' {
        return true;
    }
    for i in 0..t.len {
        if t[i] == '/' {
            return true;
        }
    }
    t.len > 5 && t[t.len - 5] == '.' && t[t.len - 4] == 't' && t[t.len - 1] == 'h'
}

// The files whose path is t or ends with it (by whole components).
fn files_named(t: [u8], out: inout IntVec) {
    for f in 0..FILE_COUNT {
        let p = file_text(f);
        if same_bytes(p, t)
            || (p.len > t.len && same_bytes(p[p.len - t.len..p.len], t)
                && p[p.len - t.len - 1] == '/') {
            out.push(f);
        }
    }
}

// Sorts v by key[v[i]], largest first (stable).
fn sort_desc(v: IntVec, key: *i64) {
    unsafe {
        let a = v.data;
        for i in 1..v.count {
            var j = i;
            while j > 0 && key[a[j]] > key[a[j - 1]] {
                let t = a[j];
                a[j] = a[j - 1];
                a[j - 1] = t;
                j -= 1;
            }
        }
    }
}

// `query stats`: per file, its lines and items, largest first (`over` after
// a file of more than --over lines); `query stats MODULE|FILE`: per item.
pub fn query_stats(name: *u8) -> i64 {
    unsafe {
        let out = buf_new();
        if name == 0 as *u8 {
            let lines = alloc_array::<i64>(FILE_COUNT + 1);
            let items = alloc_array::<i64>(FILE_COUNT + 1);
            var files = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for f in 0..FILE_COUNT {
                if user_file(f) {
                    files.push(f);
                    lines[f] = file_lines(f);
                }
            }
            for d in 0..DEF_COUNT {
                if is_item(d) {
                    items[file_of_pos(DEFS[d].start)] += 1;
                }
            }
            sort_desc(files, lines);
            var total = 0;
            var total_items = 0;
            var over = 0;
            var biggest = -1;
            for i in 0..files.count {
                let f = files.data[i];
                buf_int(out, lines[f]);
                buf_byte(out, '\t');
                buf_int(out, items[f]);
                buf_byte(out, '\t');
                buf_bytes(out, file_text(f));
                if lines[f] > OPT_OVER {
                    buf_str(out, c"\tover");
                    over += 1;
                    if biggest < 0 {
                        biggest = f;
                    }
                }
                buf_byte(out, '\n');
                total += lines[f];
                total_items += items[f];
            }
            buf_int(out, total);
            buf_byte(out, '\t');
            buf_int(out, total_items);
            buf_str(out, c"\ttotal\n");
            buf_write_fd(out, STDOUT);
            if over > 0 {
                let d = diag(c"note", c"query.over");
                buf_int(d, over);
                buf_str(d, if over == 1 { c" file over " } else { c" files over " });
                buf_int(d, OPT_OVER);
                buf_str(d, c" lines\n");
                try_deps(FILES[biggest].module, OPT_OVER);
            }
            free(lines as *u8);
            free(items as *u8);
            return 0;
        }
        // The items of a module or a file.
        let t = c_slice(name);
        var files = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var modules = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if is_file_name(t) {
            files_named(t, &files);
        } else {
            find_modules(t, false, &modules);
        }
        if files.count == 0 && modules.count == 0 {
            let d = diag(c"error", c"query.no-match");
            buf_str(d, if is_file_name(t) { c"no file '" } else { c"no module '" });
            buf_bytes(d, t);
            buf_str(d, c"' in the program\n");
            let o = try_begin(c"stats", t, false);
            try_end(o);
            return 1;
        }
        var status = 0;
        for i in 0..files.count {
            status = stats_of(out, files.data[i], -1);
        }
        for i in 0..modules.count {
            status = stats_of(out, -1, modules.data[i]);
        }
        buf_write_fd(out, STDOUT);
        status
    }
}

// The items of file f (or module m), largest first: `LINES<TAB>KIND<TAB>PATH`
// under `# PATH<TAB>FILE<TAB>N lines<TAB>N items`.
fn stats_of(out: i64, f: i64, m: i64) -> i64 {
    unsafe {
        var items = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let lines = alloc_array::<i64>(DEF_COUNT + 1);
        for d in 0..DEF_COUNT {
            if !is_item(d) {
                continue;
            }
            if (f >= 0 && file_of_pos(DEFS[d].start) == f) || (m >= 0 && DEFS[d].module == m) {
                items.push(d);
                lines[d] = def_lines(d);
            }
        }
        sort_desc(items, lines);
        let file = if f >= 0 { f } else { module_file(m) };
        buf_str(out, c"# ");
        if m >= 0 {
            buf_bytes(out, mod_fqn_text(m));
            buf_byte(out, '\t');
        }
        if file >= 0 {
            buf_bytes(out, file_text(file));
            buf_byte(out, '\t');
            buf_int(out, file_lines(file));
            buf_str(out, c" lines\t");
        }
        buf_int(out, items.count);
        buf_str(out, c" items\n");
        let shown = if !OPT_ALL && items.count > REFS_BUDGET { REFS_BUDGET } else { items.count };
        for i in 0..shown {
            let d = items.data[i];
            buf_int(out, lines[d]);
            buf_byte(out, '\t');
            buf_str(out, kind_name(DEFS[d].kind));
            buf_byte(out, '\t');
            put_local(out, d, DEFS[d].module);
            buf_byte(out, '\n');
        }
        if shown < items.count {
            let d = diag(c"note", c"query.truncated");
            buf_str(d, c"showing the ");
            buf_int(d, shown);
            buf_str(d, c" largest of ");
            buf_int(d, items.count);
            buf_str(d, c" items\n");
            let o = try_begin(c"stats", if m >= 0 { mod_fqn_text(m) } else { file_text(f) },
                true);
            buf_str(o, c" --all");
            try_end(o);
        }
        free(lines as *u8);
        0
    }
}

// `try: PROG query deps MODULE --max-lines N`.
fn try_deps(m: i64, n: i64) {
    unsafe {
        let o = try_begin(c"deps", mod_fqn_text(m), true);
        buf_str(o, c" --max-lines ");
        buf_int(o, n);
        try_end(o);
    }
}

// ---- unused ----

// Whether definition d is one `unused` leaves out: main, C's (extern "C"
// declarations and `extern "C" fn` definitions), trait impls' functions
// (called through the trait), trait functions, modules, std's and the C
// headers'.
fn always_used(d: i64) -> bool {
    unsafe {
        let k = DEFS[d].kind;
        if k == K_MOD || k == K_IMPL_METHOD || k == K_TRAIT_FN
            || !user_file(file_of_pos(DEFS[d].start)) {
            return true;
        }
        let m = DEFS[d].module;
        if within_std(m) || m == C_MODULE {
            return true;
        }
        let node = DEFS[d].node;
        if NODES[node].kind == NodeKind::ExternFn {
            return true;
        }
        if NODES[node].kind == NodeKind::Fn {
            if DEFS[d].name == MAIN_SYM && DEFS[d].parent < 0 && m == 0 {
                return true;
            }
            let f = NODES[node].x - 1;
            if f >= 0 && f < FN_COUNT && FNS[f].export {
                return true;
            }
        }
        if DEFS[d].parent >= 0 && always_used(DEFS[d].parent)
            && DEFS[DEFS[d].parent].kind == K_TRAIT_FN {
            return true;
        }
        false
    }
}

// `query unused [MODULE]`: the definitions nothing refers to (but their
// own `use` lines, and themselves), and the imports nothing in their file
// names: `PATH<TAB>FILE:LINE:COL<TAB>KIND`, in order.
pub fn query_unused(name: *u8) -> i64 {
    unsafe {
        var modules = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var files = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if name != 0 as *u8 {
            let t = c_slice(name);
            if is_file_name(t) {
                files_named(t, &files);
            } else {
                find_modules(t, false, &modules);
            }
            if modules.count == 0 && files.count == 0 {
                let d = diag(c"error", c"query.no-match");
                buf_str(d, if is_file_name(t) { c"no file '" } else { c"no module '" });
                buf_bytes(d, t);
                buf_str(d, c"' in the program\n");
                let o = try_begin(c"unused", t, false);
                try_end(o);
                return 1;
            }
        }
        var targets = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for d in 0..DEF_COUNT {
            if DEFS[d].fqn < 0 || always_used(d) || !selected(DEFS[d].start, modules, files) {
                continue;
            }
            targets.push(d);
        }
        set_targets(targets);
        collect_refs();
        var order = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        sorted_refs(&order);
        let used = alloc_array::<bool>(DEF_COUNT + 1);
        for k in 0..order.count {
            let r = order.data[k];
            let flags = R_FLAGS.data[r];
            if (flags & QF_DEF) != 0
                || ((flags & QF_USE) != 0 && (flags & QF_CALL) == 0 && is_use_ref(R_POS.data[r])) {
                continue;
            }
            let d = R_DEF.data[r];
            // (a function calling itself does not use itself)
            let e = enclosing(R_POS.data[r]);
            if e == d {
                continue;
            }
            used[d] = true;
        }
        // The results: definitions, then imports, by position.
        var found = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..targets.count {
            let d = targets.data[i];
            // (a field or variant of an unused item is not listed again)
            if !used[d]
                && !(DEFS[d].parent >= 0 && !used[DEFS[d].parent] && is_target(DEFS[d].parent)) {
                found.push(d);
            }
        }
        sort_by_position(found);
        var imports = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var all_imports = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        unused_imports(&all_imports);
        for i in 0..all_imports.count {
            let id = all_imports.data[i];
            if selected(NODES[id].start, modules, files) {
                imports.push(id);
            }
        }
        let total = found.count + imports.count;
        let out = buf_new();
        if total > REFS_BUDGET && !OPT_ALL {
            // Per file: how many.
            let per = alloc_array::<i64>(FILE_COUNT + 1);
            for i in 0..found.count {
                per[file_of_pos(DEFS[found.data[i]].start)] += 1;
            }
            for i in 0..imports.count {
                per[file_of_pos(NODES[imports.data[i]].start)] += 1;
            }
            var biggest = -1;
            for f in 0..FILE_COUNT {
                if per[f] > 0 {
                    buf_bytes(out, file_text(f));
                    buf_byte(out, '\t');
                    buf_int(out, per[f]);
                    buf_byte(out, '\n');
                    if biggest < 0 || per[f] > per[biggest] {
                        biggest = f;
                    }
                }
            }
            buf_write_fd(out, STDOUT);
            let d = diag(c"note", c"query.truncated");
            buf_int(d, total);
            buf_str(d, c" unused\n");
            try_query(c"unused", file_text(biggest));
            let o = try_begin(c"unused",
                if name != 0 as *u8 { c_slice(name) } else { c_slice(c"") }, name != 0 as *u8);
            buf_str(o, c" --all");
            try_end(o);
            return 0;
        }
        var i = 0;
        var j = 0;
        while i < found.count || j < imports.count {
            let take_def = j >= imports.count
                || (i < found.count && DEFS[found.data[i]].name_pos < NODES[imports.data[j]].start);
            if take_def {
                let d = found.data[i];
                buf_bytes(out, SYMS[DEFS[d].fqn].text);
                buf_byte(out, '\t');
                put_loc(out, DEFS[d].name_pos);
                buf_byte(out, '\t');
                buf_str(out, kind_name(DEFS[d].kind));
                i += 1;
            } else {
                let id = imports.data[j];
                put_import(out, id);
                buf_byte(out, '\t');
                put_loc(out, NODES[id].start);
                buf_str(out, c"\timport");
                j += 1;
            }
            buf_byte(out, '\n');
        }
        buf_write_fd(out, STDOUT);
        if total == 0 {
            let d = diag(c"note", c"query.empty");
            buf_str(d, c"nothing unused\n");
        }
        0
    }
}

fn is_target(d: i64) -> bool {
    GROUP.get(d + 1) != 0
}

// Whether the code at pos is in one of `modules` (0.17: or a child of
// one) or `files` (all when both are empty).
fn selected(pos: i64, modules: IntVec, files: IntVec) -> bool {
    unsafe {
        if modules.count == 0 && files.count == 0 {
            return true;
        }
        var m = module_at(pos);
        while m >= 0 {
            for i in 0..modules.count {
                if modules.data[i] == m {
                    return true;
                }
            }
            m = if m > 0 { MODULES[m].parent } else { -1 };
        }
        let f = file_of_pos(pos);
        for i in 0..files.count {
            if files.data[i] == f {
                return true;
            }
        }
        false
    }
}

// Whether the reference at pos is in a `use` item.
fn is_use_ref(pos: i64) -> bool {
    enclosing(pos) < 0
}

// The path an import (Ident node id of a `use`) brings: `use PATH::NAME`.
fn put_import(out: i64, id: i64) {
    unsafe {
        // (the Use node holding id: the nearest one before it)
        var u = id - 1;
        while u > 0 && NODES[u].kind != NodeKind::Use {
            u -= 1;
        }
        let path = NODES[u].c;
        for i in 0..NODES[path].count {
            buf_bytes(out, SYMS[NODES[crate::front::ast::child(path, i)].a].text);
            buf_str(out, c"::");
        }
        buf_bytes(out, SYMS[NODES[id].a].text);
        if NODES[id].b != 0 {
            buf_str(out, c" as ");
            buf_bytes(out, SYMS[NODES[id].b].text);
        }
    }
}

// ---- impact ----

// `query impact NAME`: what a change of NAME's signature touches: its
// definition line, then per file the calls and other references to it
// and the functions they are in, its generic instances, and a total.
pub fn query_impact(matches: IntVec, name: [u8]) -> i64 {
    unsafe {
        let out = buf_new();
        var calls = 0;
        var other = 0;
        var files = 0;
        for i in 0..matches.count {
            let d = matches.data[i];
            crate::tools::query::show::query_def_one(out, d);
        }
        set_targets(matches);
        collect_refs();
        var order = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        sorted_refs(&order);
        var k = 0;
        while k < order.count {
            let f = file_of_pos(R_POS.data[order.data[k]]);
            var c = 0;
            var o = 0;
            var fns = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            while k < order.count && file_of_pos(R_POS.data[order.data[k]]) == f {
                let r = order.data[k];
                k += 1;
                if (R_FLAGS.data[r] & QF_DEF) != 0 {
                    continue;
                }
                if (R_FLAGS.data[r] & QF_CALL) != 0 { c += 1; } else { o += 1; }
                let e = enclosing(R_POS.data[r]);
                let sym = if e >= 0 { DEFS[e].fqn } else { mod_fqn(module_at(R_POS.data[r])) };
                crate::tools::query::diagnostics::push_once(&fns, sym);
            }
            if c + o == 0 {
                continue;
            }
            files += 1;
            calls += c;
            other += o;
            buf_bytes(out, file_text(f));
            buf_byte(out, '\t');
            buf_int(out, c);
            buf_byte(out, '\t');
            buf_int(out, o);
            buf_byte(out, '\t');
            for x in 0..fns.count {
                if x == 10 {
                    buf_str(out, c" +");
                    buf_int(out, fns.count - 10);
                    break;
                }
                if x > 0 {
                    buf_byte(out, ' ');
                }
                put_short(out, fns.data[x]);
            }
            buf_byte(out, '\n');
        }
        // Generic instances, and the functions implementing a trait's.
        var instances = 0;
        for i in 0..matches.count {
            let d = matches.data[i];
            let node = DEFS[d].node;
            if NODES[node].kind != NodeKind::Fn || NODES[node].x <= 0 {
                continue;
            }
            let tf = NODES[node].x - 1;
            var list = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for f in 0..FN_COUNT {
                if FNS[f].tmpl == tf + 1 {
                    crate::tools::query::diagnostics::push_once(&list, FNS[f].display);
                }
            }
            if list.count == 0 {
                continue;
            }
            instances += list.count;
            buf_str(out, c"instances\t");
            buf_int(out, list.count);
            buf_byte(out, '\t');
            for x in 0..list.count {
                if x == 20 {
                    buf_str(out, c" +");
                    buf_int(out, list.count - 20);
                    break;
                }
                if x > 0 {
                    buf_byte(out, ' ');
                }
                buf_bytes(out, SYMS[list.data[x]].text);
            }
            buf_byte(out, '\n');
        }
        var impls = 0;
        for x in 0..DEF_COUNT {
            let g = GROUP.get(x + 1) - 1;
            if g >= 0 && TARGETS.data[g] != x {
                if impls == 0 {
                    buf_str(out, c"impls\t");
                } else {
                    buf_byte(out, ' ');
                }
                put_short(out, DEFS[x].fqn);
                impls += 1;
            }
        }
        if impls > 0 {
            buf_byte(out, '\n');
        }
        buf_str(out, c"total\t");
        buf_int(out, calls);
        buf_byte(out, '\t');
        buf_int(out, other);
        buf_byte(out, '\t');
        buf_int(out, files);
        buf_str(out, if files == 1 { c" file" } else { c" files" });
        if instances > 0 {
            buf_str(out, c", ");
            buf_int(out, instances);
            buf_str(out, if instances == 1 { c" instance" } else { c" instances" });
        }
        if impls > 0 {
            buf_str(out, c", ");
            buf_int(out, impls);
            buf_str(out, if impls == 1 { c" impl" } else { c" impls" });
        }
        buf_byte(out, '\n');
        buf_write_fd(out, STDOUT);
        let _ = name;
        0
    }
}

// ---- lint ----

// `tachyonc lint --max-lines N [ROOT]`: one error per file of more than N
// lines (`error lint.max-lines`, `try:` the deps of its module); exit 1
// when there is one.
pub fn run_lint(argc: i64, argv: **u8) -> i64 {
    let status = run_lint_inner(argc, argv);
    write_diags();
    status
}

fn run_lint_inner(argc: i64, argv: **u8) -> i64 {
    unsafe {
        PROG = argv[0];
        TOOL = 0 as *u8;
        var max = -1;
        var root = 0 as *u8;
        var i = 2;
        while i < argc {
            let a = argv[i];
            if streq(a, c"--max-lines") && i + 1 < argc {
                max = crate::tools::query::parse_count(argv[i + 1]);
                i += 2;
                continue;
            }
            if streq(a, c"--root") && i + 1 < argc {
                root = argv[i + 1];
                i += 2;
                continue;
            }
            if a[0] == '-' || root != 0 as *u8 {
                let d = diag(c"error", c"lint.usage");
                buf_str(d,
                    if a[0] == '-' { c"unknown option '" } else { c"unexpected argument '" });
                buf_str(d, a);
                buf_str(d, c"'\n");
                let o = try_begin(c"lint --max-lines 1000", c_slice(c""), false);
                try_end(o);
                return 2;
            }
            root = a;
            i += 1;
        }
        if max < 0 {
            let d = diag(c"error", c"lint.usage");
            buf_str(d, c"lint needs --max-lines N\n");
            let o = try_begin(c"lint --max-lines 1000", c_slice(c""), false);
            try_end(o);
            return 2;
        }
        ROOT_GIVEN = root;
        root = root_or_diag(root, c"lint", c_slice(c""), false);
        if root == 0 as *u8 {
            return 2;
        }
        if !load_program(root, 0) {
            program_errors(c"error", root, true);
            return 1;
        }
        var files = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let lines = alloc_array::<i64>(FILE_COUNT + 1);
        for f in 0..FILE_COUNT {
            // (a generated file, `// Generated by`, is its generator's: not linted)
            if user_file(f) && !generated(SRC[FILES[f].start..FILES[f].end]) {
                lines[f] = file_lines(f);
                if lines[f] > max {
                    files.push(f);
                }
            }
        }
        sort_desc(files, lines);
        for k in 0..files.count {
            let f = files.data[k];
            let d = diag(c"error", c"lint.max-lines");
            buf_bytes(d, file_text(f));
            buf_str(d, c": ");
            buf_int(d, lines[f]);
            buf_str(d, c" lines (at most ");
            buf_int(d, max);
            buf_str(d, c")\n");
            try_deps(FILES[f].module, max);
        }
        if files.count > 0 { 1 } else { 0 }
    }
}
