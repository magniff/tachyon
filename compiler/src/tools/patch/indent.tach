// Indentation of edit texts: a text's indents, a new text re-indented
// as the old one, the lines of a text trimmed (split from patch).

use crate::base::{buf_byte, buf_bytes, buf_new};
use crate::tools::edit::items::indent_of;
use crate::tools::patch::is_blank;

// The width of the indentation of each line of text: the first line's
// (`first`), and the least of its non-blank lines (`least`).
pub fn indents(text: [u8], first: *i64, least: *i64) {
    *first = -1;
    *least = 1000000;
    let mut i = 0;
    while i < text.len {
        let mut j = i;
        while j < text.len && (text[j] == ' ' || text[j] == '\t') {
            j += 1;
        }
        if j < text.len && text[j] != '\n' && text[j] != '\r' {
            if *first < 0 {
                *first = j - i;
            }
            if j - i < *least {
                *least = j - i;
            }
        }
        while i < text.len && text[i] != '\n' {
            i += 1;
        }
        i += 1;
    }
    if *first < 0 {
        *first = 0;
        *least = 0;
    }
}

// NEW indented like the text OLD matched at s (--loose): its first line
// goes where OLD's started, the others keep their indentation relative to
// NEW's least, on top of the indentation OLD's least indented lines have
// in the file.
pub fn reindented(new: [u8], s: i64, old: [u8]) -> i64 {
    unsafe {
        let mut old_first = 0;
        let mut old_least = 0;
        indents(old, &old_first, &old_least);
        let mut new_first = 0;
        let mut new_least = 0;
        let t = trimmed_lines(new);
        indents(t, &new_first, &new_least);
        let line = indent_of(s);
        let mut base = line.len - (old_first - old_least);
        if base < 0 {
            base = 0;
        }
        let out = buf_new();
        let mut i = 0;
        let mut first = true;
        while i < t.len {
            let mut e = i;
            while e < t.len && t[e] != '\n' {
                e += 1;
            }
            let mut a = i;
            while a < e && (t[a] == ' ' || t[a] == '\t') {
                a += 1;
            }
            if !first {
                buf_byte(out, '\n');
                if a < e {
                    buf_bytes(out, line[0..base]);
                    let keep = i + new_least;
                    buf_bytes(out, t[if keep < a { keep } else { a } ..e]);
                }
            } else {
                buf_bytes(out, t[a..e]);
            }
            first = false;
            i = e + 1;
        }
        out
    }
}

// text without its blank lines first and last, and its last blanks.
pub fn trimmed_lines(text: [u8]) -> [u8] {
    let mut a = 0;
    let mut p = 0;
    while p < text.len {
        let mut e = p;
        while e < text.len && (text[e] == ' ' || text[e] == '\t' || text[e] == '\r') {
            e += 1;
        }
        if e < text.len && text[e] == '\n' {
            p = e + 1;
            a = p;
        } else {
            break;
        }
    }
    let mut b = text.len;
    while b > a && is_blank(text[b - 1]) {
        b -= 1;
    }
    text[a..b]
}
