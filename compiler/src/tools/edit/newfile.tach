// `edit new-file` (0.13; docs/refactor.md): a file of the program made
// with its `mod` line,
//
//   tachyonc edit new-file PATH [--pub] [ROOT] < TEXT
//
// PATH (`a/b.tach`, or `a/b/mod.tach`) is made with TEXT, and `mod b;`
// (`pub mod b;` with --pub) goes into the file of the module whose child
// it is, as the module loader finds children (next to the root or a
// `mod.tach`, else in the directory named after the parent's file): one
// edit of the engine, checked, so the new module is at once a TARGET of
// `edit patch` and the other commands.

use crate::base::{
    BUFS, FILES, FILE_COUNT, IntVec, SRC, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, streq,
};
use crate::front::cpp::directives::file_exists;
use crate::tools::edit::{TARGET, edit_new_file};
use crate::tools::edit::apply::{ADD_IMPORTS, apply_edit};
use crate::tools::edit::cli::take_edit_option;
use crate::tools::proc::{absolute_path, read_stdin};
use crate::tools::query::{c_slice, root_or_diag};
use crate::tools::query::command_line::load_program;
use crate::tools::query::defs::mod_fqn_text;
use crate::tools::query::diagnostics::{ROOT_GIVEN, diag, program_errors, try_begin, try_end};
use crate::tools::refactor_mod::{add_mod_line, base_name, child_path, is_mod_file, root_like};
use crate::tools::refactor_mod::cli::is_ident;

pub fn run_new_file(argc: i64, argv: **u8) -> i64 {
    unsafe {
        var root = 0 as *u8;
        var words = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var public = false;
        var i = 3;
        while i < argc {
            let a = argv[i];
            if streq(a, c"--pub") {
                public = true;
            } else if take_edit_option(argc, argv, &i, &root) {
            } else if a[0] == '-' && a[1] == '-' {
                return usage(a, c": an unknown option");
            } else {
                words.push(a as i64);
            }
            i += 1;
        }
        if words.count == 2 && root == 0 as *u8
            && crate::base::is_source_path(words.data[1] as *u8) {
            root = words.data[1] as *u8;
            words.count = 1;
        }
        if words.count != 1 {
            return usage(c"new-file",
                if words.count == 0 { c": a PATH is needed" } else { c": one PATH at a time" });
        }
        let path = words.data[0] as *u8;
        if !crate::base::is_source_path(path) {
            return usage(path, c": PATH is a .tach (or .vl) file");
        }
        // The module's name: the file's, or its directory's for a mod.tach.
        let dir = is_mod_file(path);
        var name = base_name(path);
        let ext_len = crate::base::source_ext_len(name);
        let ext = if ext_len == 3 { c".vl" } else { c".tach" };
        name = name[0..name.len - ext_len];
        if dir {
            let p = c_slice(path);
            let e = if p.len > 4 + ext_len { p.len - 4 - ext_len } else { 0 };
            var s = e;
            while s > 0 && p[s - 1] != '/' {
                s -= 1;
            }
            name = p[s..e];
        }
        if !is_ident(name) {
            return usage(path, c": the module's name is not a name");
        }
        let input = buf_new();
        if !read_stdin(input) || BUFS[input].len == 0 {
            let d = diag(c"error", c"edit.no-text");
            buf_str(d, c"the file's text is read from stdin; none was given\n");
            let out = try_begin(c"new-file", c_slice(path), true);
            buf_str(out, c" < new.tach");
            try_end(out);
            return 2;
        }
        ROOT_GIVEN = root;
        root = root_or_diag(root, c"new-file", c_slice(path), true);
        if root == 0 as *u8 {
            return 2;
        }
        if !load_program(root, TARGET) {
            program_errors(c"error", root, true);
            return 1;
        }
        if file_exists(path) {
            let d = diag(c"error", c"edit.exists");
            buf_str(d, c"'");
            buf_str(d, path);
            buf_str(d, c"' exists already; nothing written\n");
            return 1;
        }
        // The parent: the file of the program whose child's file is PATH.
        let want = absolute_path(path);
        // (the file is made as the program spells it: the overlay of the
        // check is found by that name)
        var parent = -1;
        var spelled = path;
        for g in 0..FILE_COUNT {
            if FILES[g].path[0] == '<' {
                continue;
            }
            let c = child_path(FILES[g].path, root_like(FILES[g].module), name, dir, ext: ext);
            if streq(c, path) || streq(absolute_path(c), want) {
                parent = g;
                spelled = c;
                break;
            }
        }
        if parent < 0 {
            let d = diag(c"error", c"edit.no-parent");
            buf_str(d, c"no file of the program has ");
            buf_str(d, path);
            buf_str(d, c" as a child's file (a mod.tach or the root next to it, or the file its directory is named after)\n");
            try_end(try_begin(c"items", c_slice(c""), false));
            return 1;
        }
        let line = buf_new();
        buf_str(line, if public { c"pub mod " } else { c"mod " });
        buf_bytes(line, name);
        buf_byte(line, ';');
        // (0.17: a `mod NAME;` already there, the file missing, as the
        // compiler's `cannot find the file of module` says: only the file)
        if !declares_module(parent, name) {
            add_mod_line(parent, buf_slice(line));
        }
        let text = buf_new();
        buf_bytes(text, buf_slice(input));
        while BUFS[text].len > 0
            && (BUFS[text].data[BUFS[text].len - 1] == '\n'
                || BUFS[text].data[BUFS[text].len - 1] == ' ') {
            BUFS[text].len -= 1;
        }
        buf_byte(text, '\n');
        edit_new_file(spelled, text);
        let what = buf_new();
        buf_str(what, c"made ");
        buf_bytes(what, mod_fqn_text(FILES[parent].module));
        buf_str(what, c"::");
        buf_bytes(what, name);
        // (0.17: the imports the new text needs, as edit insert adds them)
        ADD_IMPORTS = true;
        apply_edit(buf_slice(what), root)
    }
}

// (0.17) Whether file f has a line `mod NAME;` (or `pub mod NAME;`).
fn declares_module(f: i64, name: [u8]) -> bool {
    unsafe {
        let text = SRC[FILES[f].start..FILES[f].end];
        var i = 0;
        while i < text.len {
            var s = i;
            while s < text.len && (text[s] == ' ' || text[s] == '\t') {
                s += 1;
            }
            var e = s;
            while e < text.len && text[e] != '\n' {
                e += 1;
            }
            var l = text[s..e];
            if l.len > 4 && l[0..4] == "pub " {
                l = l[4..l.len];
            }
            if l.len == name.len + 5 && l[0..4] == "mod " && l[4..4 + name.len] == name
                && l[l.len - 1] == ';' {
                return true;
            }
            i = e + 1;
        }
        false
    }
}

fn usage(what: *u8, message: *u8) -> i64 {
    unsafe {
        let d = diag(c"error", c"edit.usage");
        buf_str(d, what);
        buf_str(d, message);
        buf_byte(d, '\n');
        let out = try_begin(c"new-file a/b.tach < b.tach", c_slice(c""), false);
        try_end(out);
        2
    }
}
