// `edit wrap` (0.13; docs/refactor.md): lines of an item put in a block,
//
//   tachyonc edit wrap TARGET --in HEAD [--body | --lines A-B] [ROOT]
//
// `HEAD { ... }` (`unsafe`, `loop`, `if c`; '' for a bare block) around a
// function's body (`--body`, the default: its braces on lines of their
// own) or around lines A to B of TARGET (the file's line numbers), every
// line of them one level (4 spaces) deeper; one edit of the engine,
// checked, journaled, undone by `undo`.

use crate::base::{
    FILES, IntVec, SRC, SYMS, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, streq,
    strlen,
};
use crate::front::ast::{NODES, NodeKind};
use crate::front::modules::file_of_pos;
use crate::tools::edit::{TARGET, edit_replace};
use crate::tools::edit::apply::apply_edit;
use crate::tools::edit::cli::{ambiguous, source_only, take_edit_option};
use crate::tools::edit::items::{after_line, item_tail};
use crate::tools::query::{c_slice, ends_with_c, resolve_name, root_or_diag};
use crate::tools::query::command_line::load_program;
use crate::tools::query::defs::DEFS;
use crate::tools::query::diagnostics::{ROOT_GIVEN, diag, program_errors, try_begin, try_end};
use crate::tools::query::positions::{LINES, line_end, line_index, line_of, line_start};
use crate::tools::query::show::text_start;

pub fn run_wrap(argc: i64, argv: **u8) -> i64 {
    unsafe {
        let mut root = 0 as *u8;
        let mut names = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut head = 0 as *u8;
        let mut lines = 0 as *u8;
        let mut body = false;
        let mut i = 3;
        while i < argc {
            let a = argv[i];
            if streq(a, c"--in") || streq(a, c"--lines") {
                if i + 1 >= argc {
                    return usage(a, c" needs a value");
                }
                if streq(a, c"--in") {
                    head = argv[i + 1];
                } else {
                    lines = argv[i + 1];
                }
                i += 2;
                continue;
            }
            if streq(a, c"--body") {
                body = true;
            } else if take_edit_option(argc, argv, &i, &root) {
            } else if a[0] == '-' && a[1] == '-' {
                return usage(a, c": an unknown option");
            } else {
                names.push(a as i64);
            }
            i += 1;
        }
        if names.count == 2 && root == 0 as *u8 && ends_with_c(names.data[1] as *u8, c".tach") {
            root = names.data[1] as *u8;
            names.count = 1;
        }
        if names.count != 1 {
            return usage(c"wrap",
                if names.count == 0 { c": a TARGET is needed" } else { c": one TARGET at a time" });
        }
        if head == 0 as *u8 {
            return usage(c"wrap",
                c": --in HEAD is needed (unsafe, loop, 'if c'; '' for a bare block)");
        }
        if body && lines != 0 as *u8 {
            return usage(c"wrap", c": --body or --lines A-B, not both");
        }
        let mut la = 0;
        let mut lb = 0;
        if lines != 0 as *u8 && !line_range(c_slice(lines), &la, &lb) {
            return usage(lines, c": --lines takes A-B, the first and last line (or one line, A)");
        }
        let name = c_slice(names.data[0] as *u8);
        ROOT_GIVEN = root;
        root = root_or_diag(root, c"wrap", name, true);
        if root == 0 as *u8 {
            return 2;
        }
        if !load_program(root, TARGET) {
            program_errors(c"error", root, true);
            return 1;
        }
        let mut matches = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if !resolve_name(c"wrap", name, &matches) {
            return 1;
        }
        source_only(&matches);
        if matches.count > 1 {
            ambiguous(c"wrap", name, &matches);
            return 1;
        }
        let d = matches.data[0];
        let f = file_of_pos(DEFS[d].start);
        let fqn = SYMS[DEFS[d].fqn].text;
        if FILES[f].path[0] == '<' {
            let e = diag(c"error", c"edit.not-source");
            buf_bytes(e, fqn);
            buf_str(e, c" is in ");
            buf_str(e, FILES[f].path);
            buf_str(e, c", not in a file of the program\n");
            return 1;
        }
        // The lines: [first, last), whole lines.
        let mut first = 0;
        let mut last = 0;
        if lines == 0 as *u8 {
            let n = DEFS[d].node;
            if n <= 0 || NODES[n].kind != NodeKind::Fn || NODES[n].c <= 0 {
                let e = diag(c"error", c"edit.wrap");
                buf_bytes(e, fqn);
                buf_str(e, c" is not a function with a body; wrap lines of it with --lines A-B\n");
                try_end(try_begin(c"show", fqn, true));
                return 1;
            }
            let b = NODES[n].c;
            let s = NODES[b].start;
            let e = NODES[b].end;
            if SRC[s] != '{' || SRC[e - 1] != '}' || line_of(s) == line_of(e - 1)
                || !blank(s + 1, line_end(s))
                || !blank(line_start(e - 1), e - 1) {
                let x = diag(c"error", c"edit.layout");
                buf_str(x, c"the braces of ");
                buf_bytes(x, fqn);
                buf_str(x,
                    c"'s body share their lines with code; wrap lines of it with --lines A-B\n");
                try_end(try_begin(c"show", fqn, true));
                return 1;
            }
            first = after_line(s);
            last = line_start(e - 1);
        } else {
            let top = line_of(line_start(text_start(d)));
            let bottom = line_of(item_tail(d) - 1);
            if la < top || lb > bottom {
                let x = diag(c"error", c"edit.wrap");
                buf_str(x, c"lines ");
                put_range(x, la, lb);
                buf_str(x, c" are not all in ");
                buf_bytes(x, fqn);
                buf_str(x, c" (lines ");
                put_range(x, top, bottom);
                buf_str(x, c")\n");
                try_end(try_begin(c"show", fqn, true));
                return 1;
            }
            let base = line_index(FILES[f].start);
            first = LINES.data[base + la - 1];
            last = after_line(LINES.data[base + lb - 1]);
        }
        // Their least indentation: the block's.
        let mut least = -1;
        let mut p = first;
        while p < last {
            let e = line_end(p);
            let mut a = p;
            while a < e && (SRC[a] == ' ' || SRC[a] == '\t') {
                a += 1;
            }
            if a < e && (least < 0 || a - p < least) {
                least = a - p;
            }
            p = e + 1;
        }
        if least < 0 {
            let x = diag(c"error", c"edit.wrap");
            buf_str(x, c"the lines to wrap are blank\n");
            return 1;
        }
        let text = buf_new();
        buf_bytes(text, SRC[first..first + least]);
        buf_str(text, head);
        if strlen(head) > 0 {
            buf_byte(text, ' ');
        }
        buf_str(text, c"{\n");
        p = first;
        while p < last {
            let e = line_end(p);
            if !blank(p, e) {
                buf_str(text, c"    ");
                buf_bytes(text, SRC[p..e]);
            }
            buf_byte(text, '\n');
            p = e + 1;
        }
        buf_bytes(text, SRC[first..first + least]);
        buf_str(text, c"}\n");
        edit_replace(first, last, text);
        let what = buf_new();
        buf_str(what, c"wrapped ");
        if lines == 0 as *u8 {
            buf_str(what, c"the body of ");
        } else {
            buf_str(what, c"lines ");
            put_range(what, la, lb);
            buf_str(what, c" of ");
        }
        buf_bytes(what, fqn);
        buf_str(what, c" in ");
        buf_str(what, if strlen(head) > 0 { head } else { c"a block" });
        apply_edit(buf_slice(what), root)
    }
}

fn usage(what: *u8, message: *u8) -> i64 {
    unsafe {
        let d = diag(c"error", c"edit.usage");
        buf_str(d, what);
        buf_str(d, message);
        buf_byte(d, '\n');
        let out = try_begin(c"wrap NAME --in unsafe --lines 12-20", c_slice(c""), false);
        try_end(out);
        2
    }
}

// `A-B` or `A`: the lines, A <= B, both from 1. Whether it is one.
fn line_range(s: [u8], a: *i64, b: *i64) -> bool {
    let mut i = 0;
    let mut x = 0;
    while i < s.len && s[i] >= '0' && s[i] <= '9' {
        x = x * 10 + (s[i] - '0') as i64;
        i += 1;
    }
    if i == 0 {
        return false;
    }
    let mut y = x;
    if i < s.len {
        if s[i] != '-' {
            return false;
        }
        i += 1;
        let from = i;
        y = 0;
        while i < s.len && s[i] >= '0' && s[i] <= '9' {
            y = y * 10 + (s[i] - '0') as i64;
            i += 1;
        }
        if i == from || i < s.len {
            return false;
        }
    }
    *a = x;
    *b = y;
    x >= 1 && x <= y
}

fn put_range(out: i64, a: i64, b: i64) {
    buf_int(out, a);
    if b > a {
        buf_byte(out, '-');
        buf_int(out, b);
    }
}

// Whether SRC[from..to) is blanks without a newline.
fn blank(from: i64, to: i64) -> bool {
    unsafe {
        for p in from..to {
            if SRC[p] != ' ' && SRC[p] != '\t' && SRC[p] != '\r' {
                return false;
            }
        }
        true
    }
}
