// The diff of an edit, as --dry-run and `query diff` print it.

use crate::base::{IntVec, buf_byte, buf_bytes, buf_int, buf_str, strlen};
use crate::tools::edit::{ADDED, REMOVED};
use crate::tools::proc::same_bytes;

// ---- Diffs ----
//
// Unified, with no context lines (`diff -U0`, `git diff -U0`): per file
// `--- a/FILE` and `+++ b/FILE`, then per hunk `@@ -L,N +L,N @@` and its
// lines. Hunks are found by comparing the old and new texts line by line
// from both ends between the edits (the edits are small: the common
// lines around each changed run are not printed).

// The lines of text: their starts, and the end.
fn split_lines(text: [u8], out: *IntVec) {
    let mut i = 0;
    while i < text.len {
        out.push(i);
        while i < text.len && text[i] != '\n' {
            i += 1;
        }
        i += 1;
    }
    out.push(text.len);
}

// Line k of text (lines starting at starts), without its newline.
fn line_text(text: [u8], starts: *IntVec, k: i64) -> [u8] {
    unsafe {
        let a = (*starts).data[k];
        let mut b = (*starts).data[k + 1];
        if b > a && b <= text.len && text[b - 1] == '\n' {
            b -= 1;
        }
        text[a..b]
    }
}

// Whether line k of text ends without a newline (the file's last).
fn no_newline(text: [u8], starts: *IntVec, k: i64) -> bool {
    unsafe {
        let b = (*starts).data[k + 1];
        b == text.len && (b == 0 || text[b - 1] != '\n')
    }
}

// The diff of old and new (the texts of one file), appended to out;
// counts the lines added and removed. A line-based diff: the longest
// common subsequence of the lines between the common head and tail
// (dynamic programming, on the differing middle only).
pub fn diff_texts(out: i64, path: [u8], old: [u8], new: [u8]) {
    unsafe {
        buf_str(out, c"--- a/");
        buf_bytes(out, path);
        buf_str(out, c"\n+++ b/");
        buf_bytes(out, path);
        buf_byte(out, '\n');
    }
    diff_lines(out, old, new);
}

// The diff of a file moved from `from` to `to` (and edited), with git's
// rename lines.
pub fn diff_moved(out: i64, from: [u8], to: [u8], old: [u8], new: [u8]) {
    unsafe {
        buf_str(out, c"diff --git a/");
        buf_bytes(out, from);
        buf_str(out, c" b/");
        buf_bytes(out, to);
        buf_str(out, c"\nrename from ");
        buf_bytes(out, from);
        buf_str(out, c"\nrename to ");
        buf_bytes(out, to);
        buf_str(out, c"\n--- a/");
        buf_bytes(out, from);
        buf_str(out, c"\n+++ b/");
        buf_bytes(out, to);
        buf_byte(out, '\n');
    }
    diff_lines(out, old, new);
}

// A path as printed (without a leading `./`).
pub fn shown_path(path: *u8) -> [u8] {
    unsafe {
        let mut p = path;
        while p[0] == '.' && p[1] == '/' {
            p = &p[2];
        }
        p[0..strlen(p) as i64]
    }
}

// The hunks of the diff of old and new (see diff_texts).
fn diff_lines(out: i64, old: [u8], new: [u8]) {
    unsafe {
        let mut a = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut b = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        split_lines(old, &a);
        split_lines(new, &b);
        let na = a.count - 1;
        let nb = b.count - 1;
        // The common head and tail.
        let mut head = 0;
        while head < na && head < nb
            && same_bytes(line_text(old, &a, head), line_text(new, &b, head))
            && no_newline(old, &a, head) == no_newline(new, &b, head) {
            head += 1;
        }
        let mut tail = 0;
        while tail < na - head && tail < nb - head
            && same_bytes(line_text(old, &a, na - 1 - tail), line_text(new, &b, nb - 1 - tail))
            && no_newline(old, &a, na - 1 - tail) == no_newline(new, &b, nb - 1 - tail) {
            tail += 1;
        }
        let m = na - head - tail;
        let n = nb - head - tail;
        // The middle: an LCS table when it is small; else, with as many
        // lines on both sides (a rewrite of lines in place), line by line;
        // else the lines in step, resynchronized after each change.
        let mut ops = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if m * n <= 4000000 {
            lcs_ops(old, &a, new, &b, head, m, n, &ops);
        } else if m == n {
            let mut i = 0;
            while i < m {
                if same_bytes(line_text(old, &a, head + i), line_text(new, &b, head + i)) {
                    ops.push(0);
                    i += 1;
                    continue;
                }
                let mut e = i;
                while e < m
                    && !same_bytes(line_text(old, &a, head + e), line_text(new, &b, head + e)) {
                    e += 1;
                }
                for x in i..e {
                    ops.push(-(head + x) - 1);
                }
                for x in i..e {
                    ops.push(head + x + 1);
                }
                i = e;
            }
        } else {
            resync_ops(old, &a, new, &b, head, m, n, &ops);
        }
        // ops: -(i + 1) removes old line i, (j + 1) adds new line j, 0
        // keeps a line; hunks are the runs between kept lines.
        let mut oi = head;
        let mut nj = head;
        let mut k = 0;
        while k < ops.count {
            if ops.data[k] == 0 {
                oi += 1;
                nj += 1;
                k += 1;
                continue;
            }
            let mut end = k;
            let mut dels = 0;
            let mut adds = 0;
            while end < ops.count && ops.data[end] != 0 {
                if ops.data[end] < 0 { dels += 1; } else { adds += 1; }
                end += 1;
            }
            put_hunk_header(out, oi, dels, nj, adds);
            for x in k..end {
                if ops.data[x] < 0 {
                    let i = -ops.data[x] - 1;
                    buf_byte(out, '-');
                    buf_bytes(out, line_text(old, &a, i));
                    buf_byte(out, '\n');
                    if no_newline(old, &a, i) {
                        buf_str(out, c"\\ No newline at end of file\n");
                    }
                }
            }
            for x in k..end {
                if ops.data[x] > 0 {
                    let j = ops.data[x] - 1;
                    buf_byte(out, '+');
                    buf_bytes(out, line_text(new, &b, j));
                    buf_byte(out, '\n');
                    if no_newline(new, &b, j) {
                        buf_str(out, c"\\ No newline at end of file\n");
                    }
                }
            }
            oi += dels;
            nj += adds;
            k = end;
        }
    }
}

// `@@ -L,N +L,N @@` for `dels` old lines from line index oi and `adds` new
// lines from nj (0-based); a count of 1 is left out, and an empty side
// names the line before it.
fn put_hunk_header(out: i64, oi: i64, dels: i64, nj: i64, adds: i64) {
    unsafe {
        buf_str(out, c"@@ -");
        put_range(out, oi, dels);
        buf_str(out, c" +");
        put_range(out, nj, adds);
        buf_str(out, c" @@\n");
        ADDED += adds;
        REMOVED += dels;
    }
}

fn put_range(out: i64, first: i64, count: i64) {
    buf_int(out, if count == 0 { first } else { first + 1 });
    if count != 1 {
        buf_byte(out, ',');
        buf_int(out, count);
    }
}

// The edit script of the m old lines and n new lines after `head` when
// they are too many for lcs_ops (an edit of lines far apart in a large
// file): equal lines are kept; after a difference, the nearest pair of
// equal lines (the fewest lines skipped, at most 400) is where both go on.
fn resync_ops(old: [u8], a: *IntVec, new: [u8], b: *IntVec, head: i64, m: i64, n: i64, ops: *IntVec) {
    unsafe {
        let mut x = 0;
        let mut y = 0;
        while x < m || y < n {
            if x < m && y < n
                && same_bytes(line_text(old, a, head + x), line_text(new, b, head + y)) {
                ops.push(0);
                x += 1;
                y += 1;
                continue;
            }
            let mut di = -1;
            let mut dj = -1;
            let mut d = 1;
            while d <= 400 && di < 0 {
                for i in 0..d + 1 {
                    let j = d - i;
                    if x + i < m && y + j < n
                        && same_bytes(line_text(old, a, head + x + i),
                            line_text(new, b, head + y + j)) {
                        di = i;
                        dj = j;
                        break;
                    }
                }
                d += 1;
            }
            if di < 0 {
                di = m - x;
                dj = n - y;
            }
            for i in 0..di {
                ops.push(-(head + x + i) - 1);
            }
            for j in 0..dj {
                ops.push(head + y + j + 1);
            }
            x += di;
            y += dj;
        }
    }
}

// The edit script of the m old lines and n new lines after `head`: a
// longest common subsequence, as ops (see diff_texts).
fn lcs_ops(old: [u8], a: *IntVec, new: [u8], b: *IntVec, head: i64, m: i64, n: i64, ops: *IntVec) {
    unsafe {
        // len[i][j]: the LCS of old lines i.. and new lines j.. (of the middle).
        let w = n + 1;
        let len = crate::base::alloc_array::<i32>((m + 1) * w);
        let mut i = m - 1;
        while i >= 0 {
            let mut j = n - 1;
            while j >= 0 {
                if same_bytes(line_text(old, a, head + i), line_text(new, b, head + j)) {
                    len[i * w + j] = len[(i + 1) * w + j + 1] + 1;
                } else if len[(i + 1) * w + j] >= len[i * w + j + 1] {
                    len[i * w + j] = len[(i + 1) * w + j];
                } else {
                    len[i * w + j] = len[i * w + j + 1];
                }
                j -= 1;
            }
            i -= 1;
        }
        let mut x = 0;
        let mut y = 0;
        while x < m || y < n {
            if x < m && y < n
                && same_bytes(line_text(old, a, head + x), line_text(new, b, head + y)) {
                ops.push(0);
                x += 1;
                y += 1;
            } else if y >= n || (x < m && len[(x + 1) * w + y] >= len[x * w + y + 1]) {
                ops.push(-(head + x) - 1);
                x += 1;
            } else {
                ops.push(head + y + 1);
                y += 1;
            }
        }
        crate::base::free(len as *u8);
    }
}
