// `tachyonc edit apply [FILE] [--dry-run] [--show] [--no-check] [ROOT]`
// (0.15; docs/refactor.md, "edit apply"): the new text of several items in
// one file (stdin without FILE), each block introduced by a header line,
// made one edit: checked once, written all or not at all, one `undo`.
//
//   // PATH<TAB>FILE:A-B     (a header of `query show`) the item PATH
//                            becomes the text below it
//   @@ NAME                  NAME becomes the text below it; a NAME no
//                            definition has, whose text defines it, is
//                            added at the end of its module
//   @@ new after NAME        the text goes after NAME (`new before NAME`)
//   @@ new in MODULE         the text goes at the end of MODULE's file
//   @@ delete NAME           NAME goes (no text)
//
// So `query show A B` (or the items of `query context`), changed and
// given back, is a round trip. Each block is the edit `edit replace`,
// `insert` or `delete` would make (cli's item_edit, region_edit for
// `MODULE::use` and `MODULE::header`); the imports the new text needs are
// added, as for edit replace.

use crate::base::{
    BUFS, FILES, FILE_COUNT, IntVec, SRC, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
    streq,
};
use crate::tools::edit::{TARGET, edit_replace};
use crate::tools::edit::apply::{ADD_IMPORTS, apply_edit, set_command};
use crate::tools::edit::cli::{item_edit, region_edit, source_only, take_edit_option};
use crate::tools::edit::items::item_text;
use crate::tools::proc::{read_file_if, read_stdin};
use crate::tools::query::{
    c_slice, ends_with_c, file_line, load_program, resolve_name, root_or_diag,
};
use crate::tools::query::cache::cache_restore;
use crate::tools::query::defs::{DEFS, bytes_eq, find_defs, last_segment, mod_fqn};
use crate::tools::query::diagnostics::{ROOT_GIVEN, diag, program_errors, try_begin, try_end};
use crate::tools::query::show::find_modules;
use crate::tools::query_text::{region_target, root_stem};

// The blocks: what each does ('r' replace, 'a' insert after, 'b' insert
// before, 'd' delete, 'n' add at the end of a module), its NAME and its
// text (buffers), the line of its header.
static mut B_HOW: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut B_NAME: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut B_TEXT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut B_LINE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Where the blocks come from (FILE, or `stdin`).
static mut SOURCE: *u8 = 0 as *u8;

pub fn run_apply(argc: i64, argv: **u8) -> i64 {
    unsafe {
        set_command(argc, argv);
        let mut root = 0 as *u8;
        let mut file = 0 as *u8;
        let mut i = 3;
        while i < argc {
            let a = argv[i];
            if take_edit_option(argc, argv, &i, &root) {
            } else if a[0] == '-' && a[1] == '-' {
                let d = diag(c"error", c"edit.usage");
                buf_str(d, c"unknown option '");
                buf_str(d, a);
                buf_str(d, c"' of edit apply (--dry-run, --show, --no-check, --root, --target)\n");
                return 2;
            } else if file == 0 as *u8 {
                file = a;
            } else if root == 0 as *u8 && ends_with_c(a, c".tach") {
                root = a;
            } else {
                return usage(c"one FILE of blocks (or none: stdin)");
            }
            i += 1;
        }
        let input = buf_new();
        if file == 0 as *u8 || streq(file, c"-") {
            SOURCE = c"stdin";
            if !read_stdin(input) || BUFS[input].len == 0 {
                let d = diag(c"error", c"edit.no-text");
                buf_str(d, c"the blocks are read from FILE or stdin; none was given\n");
                let out = try_begin(c"apply", c_slice(c"items.tach"), true);
                try_end(out);
                return 2;
            }
        } else {
            SOURCE = file;
            if !read_file_if(file, input) {
                let d = diag(c"error", c"edit.no-text");
                buf_str(d, c"cannot read '");
                buf_str(d, file);
                buf_str(d, c"'\n");
                return 2;
            }
        }
        if !read_blocks(buf_slice(input)) {
            return 2;
        }
        ROOT_GIVEN = root;
        root = root_or_diag(root, c"apply", c_slice(SOURCE), true);
        if root == 0 as *u8 {
            return 2;
        }
        if !cache_restore(root, TARGET, false) && !load_program(root, TARGET) {
            program_errors(c"error", root, true);
            return 1;
        }
        let summary = buf_new();
        if B_HOW.count > 1 {
            buf_str(summary, c"applied ");
            buf_int(summary, B_HOW.count);
            buf_str(summary, c" blocks: ");
        }
        for k in 0..B_HOW.count {
            if k > 0 {
                buf_str(summary, c"; ");
            }
            if !apply_block(k, summary) {
                return 1;
            }
            if B_HOW.data[k] != 'd' {
                ADD_IMPORTS = true;
            }
        }
        apply_edit(buf_slice(summary), root)
    }
}

fn usage(message: *u8) -> i64 {
    unsafe {
        let d = diag(c"error", c"edit.usage");
        buf_str(d, message);
        buf_byte(d, '\n');
        let out = try_begin(c"apply items.tach --dry-run", c_slice(c""), false);
        try_end(out);
        2
    }
}

fn is_blank(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

fn trimmed(t: [u8]) -> [u8] {
    let mut a = 0;
    let mut b = t.len;
    while a < b && is_blank(t[a]) {
        a += 1;
    }
    while b > a && is_blank(t[b - 1]) {
        b -= 1;
    }
    t[a..b]
}

fn starts_with(t: [u8], p: *u8) -> bool {
    unsafe {
        let mut i = 0;
        while p[i] != 0 {
            if i >= t.len || t[i] != p[i] {
                return false;
            }
            i += 1;
        }
        true
    }
}

// Whether line is a header (`@@ ...`, or `// PATH<TAB>FILE:A-B ...`): its
// kind into *how, its NAME into buffer name.
fn block_header(line: [u8], how: *u8, name: i64) -> bool {
    unsafe {
        if line.len >= 2 && line[0] == '@' && line[1] == '@' {
            let rest = trimmed(line[2..line.len]);
            *how = 'r';
            let mut from = 0;
            if starts_with(rest, c"new after ") {
                *how = 'a';
                from = 10;
            } else if starts_with(rest, c"new before ") {
                *how = 'b';
                from = 11;
            } else if starts_with(rest, c"new in ") {
                *how = 'n';
                from = 7;
            } else if starts_with(rest, c"delete ") {
                *how = 'd';
                from = 7;
            }
            buf_bytes(name, trimmed(rest[from..rest.len]));
            return true;
        }
        // `// PATH<TAB>FILE:A-B`, as query show prints an item's header
        if line.len > 4 && line[0] == '/' && line[1] == '/' && line[2] == ' ' {
            let mut tab = 3;
            while tab < line.len && line[tab] != '\t' {
                if line[tab] == ' ' {
                    return false;
                }
                tab += 1;
            }
            if tab >= line.len || tab == 3 {
                return false;
            }
            // (FILE:A-B, maybe more words after it: query context's)
            let mut place = trimmed(line[tab + 1..line.len]);
            let mut w = 0;
            while w < place.len && place[w] != ' ' && place[w] != '\t' {
                w += 1;
            }
            place = place[0..w];
            let mut colon = false;
            for i in 0..place.len {
                if place[i] == ':' {
                    colon = true;
                }
            }
            if !colon || place.len == 0 || place[place.len - 1] < '0'
                || place[place.len - 1] > '9' {
                return false;
            }
            *how = 'r';
            buf_bytes(name, line[3..tab]);
            return true;
        }
        false
    }
}

// The blocks of the input. False after the diagnostic.
fn read_blocks(input: [u8]) -> bool {
    unsafe {
        let mut text = -1;
        let mut n = 0;
        let mut i = 0;
        while i < input.len {
            let mut e = i;
            while e < input.len && input[e] != '\n' {
                e += 1;
            }
            let line = input[i..e];
            n += 1;
            let mut how = ' ';
            let name = buf_new();
            if block_header(line, &how, name) {
                if BUFS[name].len == 0 {
                    return format_error(n, c"a header names no item");
                }
                text = buf_new();
                B_HOW.push(how as i64);
                B_NAME.push(name);
                B_TEXT.push(text);
                B_LINE.push(n);
            } else if text < 0 {
                if trimmed(line).len > 0 {
                    return format_error(n, c"text before the first header");
                }
            } else {
                buf_bytes(text, line);
                buf_byte(text, '\n');
            }
            i = e + 1;
        }
        if B_HOW.count == 0 {
            return format_error(n, c"no block");
        }
        for k in 0..B_HOW.count {
            let empty = trimmed(buf_slice(B_TEXT.data[k])).len == 0;
            if B_HOW.data[k] == 'd' && !empty {
                return format_error(B_LINE.data[k], c"a delete block has no text");
            }
            if B_HOW.data[k] != 'd' && empty {
                return format_error(B_LINE.data[k],
                    c"the block has no text (`@@ delete NAME` deletes an item)");
            }
        }
        true
    }
}

fn format_error(line: i64, message: *u8) -> bool {
    unsafe {
        let d = diag(c"error", c"edit.format");
        buf_str(d, SOURCE);
        buf_str(d, c" line ");
        buf_int(d, line);
        buf_str(d, c": ");
        buf_str(d, message);
        buf_str(d, c"; a block starts with `@@ NAME`, `@@ new after NAME`, `@@ new in MODULE`, `@@ delete NAME` or a header of query show\n");
        let out = try_begin(c"show", c_slice(c"NAME"), true);
        try_end(out);
        false
    }
}

// `how` as an edit of item_edit and region_edit.
fn item_how(how: i64) -> u8 {
    if how == 'r' { 'r' } else if how == 'a' { 'a' } else if how == 'b' { 'b' } else { 'd' }
}

// Block k, added to the engine's edits; its words in summary. False after
// the diagnostic.
fn apply_block(k: i64, summary: i64) -> bool {
    unsafe {
        let name = buf_slice(B_NAME.data[k]);
        let how = B_HOW.data[k];
        let text = B_TEXT.data[k];
        if how == 'n' {
            return add_to_module(name, text, summary, name[0..0]);
        }
        // A module's use lines or header (0.12).
        let mut rf = 0;
        let mut rk = 0;
        let mut spans = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let r = region_target(name, c"show", &rf, &rk, &spans);
        if r == 1 {
            return false;
        }
        if r == 0 {
            return region_edit(rf, rk, &spans, item_how(how), text, summary) < 0;
        }
        // A new item named by its path: at the end of its module.
        let mut line = 0;
        if how == 'r' && file_line(name, &line) < 0 {
            let mut found = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            find_defs(name, false, &found);
            let seg = last_segment(name);
            if found.count == 0 && seg.len < name.len && defines(buf_slice(text), seg) {
                return add_to_module(name[0..name.len - seg.len - 2], text, summary, seg);
            }
        }
        let mut matches = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if !resolve_name(c"show", name, &matches) {
            return false;
        }
        source_only(&matches);
        if matches.count > 1 {
            let d = diag(c"error", c"query.ambiguous");
            buf_int(d, matches.count);
            buf_str(d, c" definitions match '");
            buf_bytes(d, name);
            buf_str(d, c"' (");
            buf_str(d, SOURCE);
            buf_str(d, c" line ");
            buf_int(d, B_LINE.data[k]);
            buf_str(d, c"); name one by its path in the header\n");
            let out = try_begin(c"def", name, true);
            try_end(out);
            return false;
        }
        let d = matches.data[0];
        let f = crate::front::modules::file_of_pos(DEFS[d].start);
        if FILES[f].path[0] == '<' {
            let e = diag(c"error", c"edit.not-source");
            buf_bytes(e, crate::base::SYMS[DEFS[d].fqn].text);
            buf_str(e, c" is in ");
            buf_str(e, FILES[f].path);
            buf_str(e, c", not in a file of the program\n");
            return false;
        }
        item_edit(item_how(how), d, text, summary)
    }
}

// Whether text defines an item named `name`: the word after its first
// keyword (`fn`, `struct`, `enum`, `const`, `static`, `trait`, `type`,
// `mod`) is name.
fn defines(text: [u8], name: [u8]) -> bool {
    let mut i = 0;
    while i < text.len {
        while i < text.len && is_blank(text[i]) {
            i += 1;
        }
        let mut e = i;
        while e < text.len && !is_blank(text[e]) && text[e] != '(' && text[e] != '<'
            && text[e] != '{' && text[e] != ':' && text[e] != ';' {
            e += 1;
        }
        let w = text[i..e];
        if w.len >= 2 && w[0] == '/' && w[1] == '/' {
            while e < text.len && text[e] != '\n' {
                e += 1;
            }
        } else if keyword(w) {
            let mut a = e;
            while a < text.len && is_blank(text[a]) {
                a += 1;
            }
            let mut b = a;
            while b < text.len && (text[b] == '_' || (text[b] >= 'a' && text[b] <= 'z')
                || (text[b] >= 'A' && text[b] <= 'Z') || (text[b] >= '0' && text[b] <= '9')) {
                b += 1;
            }
            return bytes_eq(text[a..b], name);
        }
        if e == i {
            e += 1;
        }
        i = e;
    }
    false
}

fn keyword(w: [u8]) -> bool {
    bytes_eq(w, "fn") || bytes_eq(w, "struct") || bytes_eq(w, "enum") || bytes_eq(w, "const")
        || bytes_eq(w, "static") || bytes_eq(w, "trait") || bytes_eq(w, "type")
        || bytes_eq(w, "mod")
}

// The text of buffer `text` at the end of module `module`'s file (`item`:
// the new item's name, when the block's header gave it). False after the diagnostic.
fn add_to_module(module: [u8], text: i64, summary: i64, item: [u8]) -> bool {
    unsafe {
        let mut modules = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        find_modules(module, false, &modules);
        if modules.count == 0 && root_stem(module) {
            modules.push(0);
        }
        let mut files = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..modules.count {
            for f in 0..FILE_COUNT {
                if FILES[f].module == modules.data[i] && FILES[f].path[0] != '<' {
                    files.push(f);
                }
            }
        }
        if files.count != 1 {
            let d = diag(c"error",
                if files.count == 0 { c"edit.no-module" } else { c"query.ambiguous" });
            if files.count == 0 {
                buf_str(d, c"no module '");
                buf_bytes(d, module);
                buf_str(d, c"' with a file of its own; name an item to put the text after (`@@ new after NAME`)\n");
            } else {
                buf_bytes(d, module);
                buf_str(d, c" names ");
                buf_int(d, files.count);
                buf_str(d, c" modules; give more of its path\n");
            }
            let out = try_begin(c"items", module, true);
            try_end(out);
            return false;
        }
        let f = files.data[0];
        let t = item_text(buf_slice(text), SRC[0..0]);
        let out = buf_new();
        let end = FILES[f].end;
        if end > FILES[f].start && SRC[end - 1] != '\n' {
            buf_byte(out, '\n');
        }
        if end > FILES[f].start {
            buf_byte(out, '\n');
        }
        buf_bytes(out, buf_slice(t));
        buf_byte(out, '\n');
        edit_replace(end, end, out);
        if item.len > 0 {
            buf_str(summary, c"added ");
            buf_bytes(summary, crate::base::SYMS[mod_fqn(FILES[f].module)].text);
            buf_str(summary, c"::");
            buf_bytes(summary, item);
        } else {
            buf_str(summary, c"inserted in ");
            buf_bytes(summary, crate::base::SYMS[mod_fqn(FILES[f].module)].text);
        }
        true
    }
}
