// The journal of edits, `undo` (the last edit taken back) and `query diff`
// (the last edit's diff).

use crate::base::{
    BUFS, FILES, IntVec, SRC, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, cstr,
};
use crate::front::cpp::directives::file_exists;
use crate::front::stdtree::find_std_tree;
use crate::tools::edit::{CH_FILE, CH_TEXT, DEL_FILE, NEW_PATH, NEW_TEXT, remove_empty_dirs};
use crate::tools::edit::apply::{cannot_write, copy_path, make_parent};
use crate::tools::edit::diff::diff_texts;
use crate::tools::edit::stdedit::{embed_std, is_std_file};
use crate::tools::proc::{
    absolute_path, buf_cstr, make_dirs, read_file_if, remove_dir, remove_file, rename_file,
    same_bytes, write_file_if,
};
use crate::tools::query::{c_slice, find_root};
use crate::tools::query::diagnostics::{diag, try_begin, try_end};

// ---- The journal ----
//
// .git/tachyon-edits (the git directory of the root's checkout), or, for
// a program in no git checkout (0.14), .tachyonc/edits next to its root
// (and found from below it): `head` holds the number N of the last edit; directory N/ holds its `summary`
// line, its `files` (one `ABSOLUTE-PATH<TAB>NEW` per changed file, NEW 1
// for a file the edit made) and each file's text before (`K.before`) and
// after (`K.after`) the edit. `tachyonc undo` restores the last one.

// The journal's directory: in the git directory of the checkout around
// `from`; outside one (0.14), `.tachyonc/edits` in the nearest directory
// up from `from` that has one, else in from's directory.
pub fn journal_dir(from: *u8) -> *u8 {
    unsafe {
        let start = absolute_path(from);
        let dir = buf_new();
        buf_str(dir, start);
        // (from a file: its directory)
        if !is_dir(buf_cstr(dir)) {
            while BUFS[dir].len > 0 && BUFS[dir].data[BUFS[dir].len - 1] != '/' {
                BUFS[dir].len -= 1;
            }
            if BUFS[dir].len > 1 {
                BUFS[dir].len -= 1;
            }
        }
        let own = buf_new();
        buf_bytes(own, buf_slice(dir));
        buf_str(own, c"/.tachyonc/edits");
        let fallback = buf_cstr(own);
        loop {
            let git = buf_new();
            buf_bytes(git, buf_slice(dir));
            buf_str(git, c"/.git");
            let gp = buf_cstr(git);
            let head = buf_new();
            buf_str(head, gp);
            buf_str(head, c"/HEAD");
            if file_exists(buf_cstr(head)) {
                buf_str(git, c"/tachyon-edits");
                return buf_cstr(git);
            }
            let text = buf_new();
            if file_exists(gp) && read_file_if(gp, text) {
                // A worktree: `gitdir: PATH`.
                let t = buf_slice(text);
                if t.len > 8 && t[0] == 'g' && t[6] == ':' {
                    var a = 7;
                    while a < t.len && t[a] == ' ' {
                        a += 1;
                    }
                    var b = t.len;
                    while b > a && (t[b - 1] == '\n' || t[b - 1] == ' ' || t[b - 1] == '\r') {
                        b -= 1;
                    }
                    let out = buf_new();
                    if t[a] != '/' {
                        buf_bytes(out, buf_slice(dir));
                        buf_byte(out, '/');
                    }
                    buf_bytes(out, t[a..b]);
                    buf_str(out, c"/tachyon-edits");
                    return buf_cstr(out);
                }
            }
            let mine = buf_new();
            buf_bytes(mine, buf_slice(dir));
            buf_str(mine, c"/.tachyonc/edits");
            if is_dir(buf_cstr(mine)) {
                return buf_cstr(mine);
            }
            if BUFS[dir].len <= 1 {
                return fallback;
            }
            while BUFS[dir].len > 1 && BUFS[dir].data[BUFS[dir].len - 1] != '/' {
                BUFS[dir].len -= 1;
            }
            if BUFS[dir].len > 1 {
                BUFS[dir].len -= 1;
            }
        }
    }
}

fn is_dir(path: *u8) -> bool {
    unsafe {
        let b = buf_new();
        buf_str(b, path);
        buf_str(b, c"/.");
        file_exists(buf_cstr(b))
    }
}

// `DIR/NAME`.
fn path_in(dir: *u8, name: *u8) -> *u8 {
    unsafe {
        let b = buf_new();
        buf_str(b, dir);
        buf_byte(b, '/');
        buf_str(b, name);
        buf_cstr(b)
    }
}

// `DIR/N/K.SUFFIX` (K < 0: `DIR/N/SUFFIX`).
fn entry_path(dir: *u8, n: i64, k: i64, suffix: *u8) -> *u8 {
    unsafe {
        let b = buf_new();
        buf_str(b, dir);
        buf_byte(b, '/');
        buf_int(b, n);
        buf_byte(b, '/');
        if k >= 0 {
            buf_int(b, k);
            buf_byte(b, '.');
        }
        buf_str(b, suffix);
        buf_cstr(b)
    }
}

// The number in file `path` (0 when there is none).
fn read_number(path: *u8) -> i64 {
    let b = buf_new();
    if !read_file_if(path, b) {
        return 0;
    }
    let t = buf_slice(b);
    var n = 0;
    var i = 0;
    while i < t.len && t[i] >= '0' && t[i] <= '9' {
        n = n * 10 + (t[i] - '0') as i64;
        i += 1;
    }
    n
}

fn write_number(path: *u8, n: i64) -> bool {
    unsafe {
        let b = buf_new();
        buf_int(b, n);
        buf_byte(b, '\n');
        write_file_if(path, buf_slice(b))
    }
}

// Records the edit about to be written.
pub fn journal(root: *u8, summary: [u8]) {
    unsafe {
        let dir = journal_dir(root);
        if dir == 0 as *u8 {
            return;
        }
        let n = read_number(path_in(dir, c"head")) + 1;
        let entry = buf_new();
        buf_str(entry, dir);
        buf_byte(entry, '/');
        buf_int(entry, n);
        var ok = make_dirs(buf_cstr(entry));
        let files = buf_new();
        var k = 0;
        for i in 0..CH_FILE.count {
            let f = CH_FILE.data[i];
            buf_str(files, absolute_path(FILES[f].path));
            buf_str(files, c"\t0\n");
            ok = ok
                && write_file_if(entry_path(dir, n, k, c"before"),
                    SRC[FILES[f].start..FILES[f].end])
                && write_file_if(entry_path(dir, n, k, c"after"), buf_slice(CH_TEXT.data[i]));
            k += 1;
        }
        for i in 0..NEW_PATH.count {
            buf_str(files, absolute_path(NEW_PATH.data[i] as *u8));
            buf_str(files, c"\t1\n");
            ok = ok && write_file_if(entry_path(dir, n, k, c"after"), buf_slice(NEW_TEXT.data[i]));
            k += 1;
        }
        // (a removed file: its text before; none after)
        for i in 0..DEL_FILE.count {
            let f = DEL_FILE.data[i];
            buf_str(files, absolute_path(FILES[f].path));
            buf_str(files, c"\t2\n");
            ok = ok
                && write_file_if(entry_path(dir, n, k, c"before"),
                    SRC[FILES[f].start..FILES[f].end])
                && write_file_if(entry_path(dir, n, k, c"after"), SRC[0..0]);
            k += 1;
        }
        ok = ok && write_file_if(entry_path(dir, n, -1, c"files"), buf_slice(files))
            && write_file_if(entry_path(dir, n, -1, c"summary"), summary)
            && write_number(path_in(dir, c"head"), n);
        if !ok {
            let d = diag(c"warning", c"edit.journal");
            buf_str(d, c"cannot write the journal in ");
            buf_str(d, dir);
            buf_str(d, c"; undo will not know this edit\n");
        }
    }
}

// (0.15) Records an edit of files read as text, not as a program (`edit
// resolve`: a tree with conflict markers does not parse): per file, its
// path (a C string) and its texts before and after (buffers).
pub fn journal_texts(from: *u8, paths: IntVec, befores: IntVec, afters: IntVec, summary: [u8]) {
    unsafe {
        let dir = journal_dir(from);
        if dir == 0 as *u8 {
            return;
        }
        let n = read_number(path_in(dir, c"head")) + 1;
        let entry = buf_new();
        buf_str(entry, dir);
        buf_byte(entry, '/');
        buf_int(entry, n);
        var ok = make_dirs(buf_cstr(entry));
        let files = buf_new();
        for k in 0..paths.count {
            buf_str(files, absolute_path(paths.data[k] as *u8));
            buf_str(files, c"\t0\n");
            ok = ok
                && write_file_if(entry_path(dir, n, k, c"before"), buf_slice(befores.data[k]))
                && write_file_if(entry_path(dir, n, k, c"after"), buf_slice(afters.data[k]));
        }
        ok = ok && write_file_if(entry_path(dir, n, -1, c"files"), buf_slice(files))
            && write_file_if(entry_path(dir, n, -1, c"summary"), summary)
            && write_number(path_in(dir, c"head"), n);
        if !ok {
            let d = diag(c"warning", c"edit.journal");
            buf_str(d, c"cannot write the journal in ");
            buf_str(d, dir);
            buf_str(d, c"; undo will not know this edit\n");
        }
    }
}

// Where undo and query diff look for the journal: ROOT when given, else
// the program's default root (./main.tach...), else the current directory.
fn default_from(from: *u8) -> *u8 {
    if from != 0 as *u8 {
        return from;
    }
    let root = unsafe { find_root(0 as *u8) };
    if root != 0 as *u8 { root } else { c"." }
}

// `tachyonc undo [--force] [ROOT]`: restores the files of the last edit
// (refused when one changed since, unless --force).
pub fn run_undo(force: bool, from: *u8) -> i64 {
    unsafe {
        let dir = journal_dir(default_from(from));
        let n = if dir == 0 as *u8 { 0 } else { read_number(path_in(dir, c"head")) };
        let files = buf_new();
        if n <= 0 || !read_file_if(entry_path(dir, n, -1, c"files"), files) {
            let d = diag(c"error", c"undo.empty");
            buf_str(d, c"no edit to undo\n");
            return 1;
        }
        // The files: path and whether the edit made it.
        var paths = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var made = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let t = buf_slice(files);
        var i = 0;
        while i < t.len {
            var tab = i;
            while tab < t.len && t[tab] != '\t' {
                tab += 1;
            }
            let p = buf_new();
            buf_bytes(p, t[i..tab]);
            paths.push(buf_cstr(p) as i64);
            made.push(if tab + 1 < t.len && t[tab + 1] == '1' { 1 }
                else if tab + 1 < t.len && t[tab + 1] == '2' { 2 } else { 0 });
            while i < t.len && t[i] != '\n' {
                i += 1;
            }
            i += 1;
        }
        // Each file must be as the edit left it.
        if !force {
            for k in 0..paths.count {
                let now = buf_new();
                let after = buf_new();
                let have = read_file_if(paths.data[k] as *u8, now);
                // (a file the edit removed must still be gone)
                let changed = if made.data[k] == 2 { have } else {
                    !have || !read_file_if(entry_path(dir, n, k, c"after"), after)
                        || !same_bytes(buf_slice(now), buf_slice(after))
                };
                if changed {
                    let d = diag(c"error", c"undo.changed");
                    buf_str(d, c"'");
                    buf_str(d, paths.data[k] as *u8);
                    buf_str(d, c"' changed since the edit; nothing undone\n");
                    let out = try_begin(c"undo --force", c_slice(c""), false);
                    try_end(out);
                    return 1;
                }
            }
        }
        var ok = true;
        for k in 0..paths.count {
            let path = paths.data[k] as *u8;
            if made.data[k] == 1 {
                remove_file(path);
                remove_empty_dirs(path);
                continue;
            }
            let before = buf_new();
            if !read_file_if(entry_path(dir, n, k, c"before"), before) || !make_parent(path)
                || !write_file_if(copy_path(path), buf_slice(before))
                || !rename_file(copy_path(path), path) {
                cannot_write(path);
                ok = false;
            }
        }
        let summary = buf_new();
        read_file_if(entry_path(dir, n, -1, c"summary"), summary);
        for k in 0..paths.count {
            remove_file(entry_path(dir, n, k, c"before"));
            remove_file(entry_path(dir, n, k, c"after"));
        }
        remove_file(entry_path(dir, n, -1, c"files"));
        remove_file(entry_path(dir, n, -1, c"summary"));
        let entry = buf_new();
        buf_str(entry, dir);
        buf_byte(entry, '/');
        buf_int(entry, n);
        remove_dir(buf_cstr(entry));
        write_number(path_in(dir, c"head"), n - 1);
        let out = buf_new();
        buf_str(out, c"undid ");
        buf_bytes(out, buf_slice(summary));
        if BUFS[out].len == 0 || BUFS[out].data[BUFS[out].len - 1] != '\n' {
            buf_byte(out, '\n');
        }
        buf_write_fd(out, STDOUT);
        // (0.17: a std edit undone: std's built-in text follows; stdedit.tach)
        if (0..paths.count).any(|k| is_std_file(cstr(paths.data[k] as *u8))) {
            let tree = find_std_tree();
            if tree != 0 as *u8 {
                embed_std(tree);
            }
        }
        if ok { 0 } else { 1 }
    }
}

// `tachyonc query diff [ROOT]` (0.12): the last edit of the journal (what
// `undo` would take back), its summary line, then its diff with no
// context lines; nothing changes.
pub fn run_query_diff(from: *u8) -> i64 {
    unsafe {
        let dir = journal_dir(default_from(from));
        let n = if dir == 0 as *u8 { 0 } else { read_number(path_in(dir, c"head")) };
        let files = buf_new();
        if n <= 0 || !read_file_if(entry_path(dir, n, -1, c"files"), files) {
            let d = diag(c"error", c"undo.empty");
            buf_str(d, c"no edit in the journal\n");
            return 1;
        }
        let out = buf_new();
        let summary = buf_new();
        read_file_if(entry_path(dir, n, -1, c"summary"), summary);
        buf_str(out, c"# ");
        buf_bytes(out, buf_slice(summary));
        if BUFS[out].data[BUFS[out].len - 1] != '\n' {
            buf_byte(out, '\n');
        }
        let t = buf_slice(files);
        var i = 0;
        var k = 0;
        while i < t.len {
            var tab = i;
            while tab < t.len && t[tab] != '\t' {
                tab += 1;
            }
            let p = buf_new();
            buf_bytes(p, t[i..tab]);
            let before = buf_new();
            let after = buf_new();
            read_file_if(entry_path(dir, n, k, c"before"), before);
            read_file_if(entry_path(dir, n, k, c"after"), after);
            // (relative to the current directory when under it)
            let path = buf_slice(p);
            let here = c_slice(absolute_path(c"."));
            var shown = path;
            if path.len > here.len + 1 && path[here.len] == '/'
                && same_bytes(path[0..here.len], here) {
                shown = path[here.len + 1..path.len];
            }
            diff_texts(out, shown, buf_slice(before), buf_slice(after));
            while i < t.len && t[i] != '\n' {
                i += 1;
            }
            i += 1;
            k += 1;
        }
        buf_write_fd(out, STDOUT);
        0
    }
}
