// `tachyonc test [FILTER...]` in the tachyon tree (0.17; testrun/mod.tach):
// std embedded and target/tachyonc rebuilt when a source is newer, then
// tests/run.sh once per FILTER, its FAIL blocks and totals summarized.
use crate::base::{
    IntVec, STDOUT, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, streq,
};
use crate::front::cpp::directives::file_exists;
use crate::tools::proc::{buf_cstr, read_file_if, rename_file, same_bytes};
use crate::tools::query::diagnostics::{PROG, put_cword};
use crate::tools::testrun::{
    AGAINST, BUDGET, FILTERS, OPT, contains, detail_lines, line_end, newer_tach, now_ms, put_cut,
    put_failures, put_lines, put_secs, run_words, starts,
};

// ---- The tachyon repository ----

pub fn run_repo() -> i64 {
    unsafe {
        let t0 = now_ms();
        let out = buf_new();
        let notes = buf_new();
        // std's embedding, then the dev compiler, when older than a source.
        if newer_tach(c"compiler/std", 0 as *u8, c"compiler/src/front/stdsrc.tach") {
            let log = buf_new();
            if run_words(c"sh", c"compiler/std/embed.sh", 0 as *u8, 0 as *u8, 0 as *u8, 0 as *u8,
                0 as *u8, log) != 0 {
                buf_bytes(out, "test: compiler/std/embed.sh failed\n");
                put_lines(out, buf_slice(log), 0, 20, "");
                buf_write_fd(out, STDOUT);
                return 1;
            }
            buf_bytes(notes, "; std embedded");
        }
        if !file_exists(c"target/tachyonc")
            || newer_tach(c"compiler/src", c"compiler/std", c"target/tachyonc") {
            let t1 = now_ms();
            let builder = if file_exists(c"target/tools/tachyonc") {
                c"target/tools/tachyonc"
            } else if file_exists(c"target/tachyonc") {
                c"target/tachyonc"
            } else {
                PROG
            };
            let log = buf_new();
            let rc = run_words(builder, c"compiler/src/main.tach", c"-o", c"target/tachyonc.test~",
                c"--diagnostics=short", 0 as *u8, 0 as *u8, log);
            if rc != 0 || !rename_file(c"target/tachyonc.test~", c"target/tachyonc") {
                buf_bytes(out, "test: target/tachyonc does not build (with ");
                buf_str(out, builder);
                buf_bytes(out, ")\n");
                let l = buf_slice(log);
                var i = 0;
                while i < l.len {
                    let e = line_end(l, i);
                    if e > i {
                        if buf_slice(out).len + (e - i) > BUDGET {
                            buf_bytes(out, "(more: ");
                            buf_str(out, builder);
                            buf_bytes(out, " check)\n");
                            break;
                        }
                        put_cut(out, "", l[i..e]);
                    }
                    i = e + 1;
                }
                buf_write_fd(out, STDOUT);
                return 1;
            }
            buf_bytes(notes, "; target/tachyonc rebuilt in ");
            put_secs(notes, now_ms() - t1);
        }
        var blocks = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var names = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let totals = alloc_array::<i64>(3);
        totals[0] = 0;
        totals[1] = 0;
        totals[2] = 0;
        var ran = false;
        let unmatched = buf_new();
        let runs = if FILTERS.count == 0 { 1 } else { FILTERS.count };
        for k in 0..runs {
            let filter = if FILTERS.count == 0 { 0 as *u8 } else { FILTERS.data[k] as *u8 };
            let log = buf_new();
            let rc = if OPT != 0 as *u8 {
                let level = buf_new();
                buf_byte(level, OPT[2]);
                run_words(c"sh", c"tests/run.sh", c"-O", buf_cstr(level), filter, 0 as *u8,
                    0 as *u8, log)
            } else {
                run_words(c"sh", c"tests/run.sh", filter, 0 as *u8, 0 as *u8, 0 as *u8, 0 as *u8,
                    log)
            };
            if parse_run(buf_slice(log), totals, &blocks, &names) {
                ran = true;
            } else if rc == 2 && contains(buf_slice(log), "no cases match") {
                buf_bytes(unmatched,
                    if buf_slice(unmatched).len == 0 { " (no case matches" } else { "," });
                put_cword(unmatched, filter);
            } else {
                // (no table: no case matched, or run.sh could not run)
                let b = buf_new();
                buf_bytes(b, "tests/run.sh");
                if filter != 0 as *u8 {
                    put_cword(b, filter);
                }
                buf_bytes(b, ": exit ");
                buf_int(b, rc);
                buf_byte(b, '\n');
                let l = buf_slice(log);
                var lines = 0;
                var i = 0;
                while i < l.len {
                    let e = line_end(l, i);
                    lines += 1;
                    i = e + 1;
                }
                put_lines(b, l, if lines > 3 { lines - 3 } else { 0 }, 3, "  ");
                blocks.push(b);
                let n = buf_new();
                buf_bytes(n, "run.sh");
                names.push(n);
            }
        }
        // (0.17) The failures run again with the last passing build.
        let counts = alloc_array::<i64>(2);
        counts[0] = 0;
        counts[1] = 0;
        let base = if names.count > 0 { baseline_compiler() } else { 0 as *u8 };
        if base != 0 as *u8 {
            mark_baseline(base, blocks, names, counts);
        }
        buf_bytes(out, "test");
        for k in 0..FILTERS.count {
            put_cword(out, FILTERS.data[k] as *u8);
        }
        if FILTERS.count == 0 {
            buf_bytes(out, " (the whole suite)");
        }
        if buf_slice(unmatched).len > 0 {
            buf_bytes(out, buf_slice(unmatched));
            buf_byte(out, ')');
        }
        buf_bytes(out, ": ");
        if !ran && blocks.count == 0 {
            buf_bytes(out, "nothing run\n");
            buf_write_fd(out, STDOUT);
            return 2;
        }
        buf_int(out, totals[0]);
        buf_bytes(out, " passed, ");
        buf_int(out, totals[2]);
        buf_bytes(out, " failed");
        if totals[1] > 0 {
            buf_bytes(out, ", ");
            buf_int(out, totals[1]);
            buf_bytes(out, " xfail");
        }
        buf_bytes(out, " (tests/run.sh");
        if OPT != 0 as *u8 {
            buf_byte(out, ' ');
            buf_str(out, OPT);
        }
        buf_bytes(out, buf_slice(notes));
        if counts[0] + counts[1] > 0 {
            buf_bytes(out, "; with ");
            buf_str(out, base);
            buf_bytes(out, ": ");
            buf_int(out, counts[0]);
            buf_bytes(out, " new, ");
            buf_int(out, counts[1]);
            buf_bytes(out, " failing too");
        }
        buf_bytes(out, "; ");
        put_secs(out, now_ms() - t0);
        buf_bytes(out, ")\n");
        put_failures(out, blocks, names);
        buf_write_fd(out, STDOUT);
        if !ran {
            return 2;
        }
        if blocks.count > 0 || totals[2] > 0 { 1 } else { 0 }
    }
}

// (0.17) The compiler the failures are run again with: --against's, else
// target/tools/tachyonc (the last build whose suite passed) when its bytes
// differ from target/tachyonc's; 0: none (`--against none`).
fn baseline_compiler() -> *u8 {
    unsafe {
        if AGAINST != 0 as *u8 {
            return if streq(AGAINST, c"none") { 0 as *u8 } else { AGAINST };
        }
        let tools = c"target/tools/tachyonc";
        if !file_exists(tools) {
            return 0 as *u8;
        }
        let a = buf_new();
        let b = buf_new();
        if read_file_if(tools, a) && read_file_if(c"target/tachyonc", b)
            && same_bytes(buf_slice(a), buf_slice(b)) {
            return 0 as *u8;
        }
        tools
    }
}

// Whether case `name` fails with compiler `base` too: 1 it fails, 0 it
// passes, -1 unknown (run.sh made no table).
fn fails_with(base: *u8, name: [u8]) -> i64 {
    unsafe {
        let filter = buf_new();
        buf_bytes(filter, name);
        let log = buf_new();
        if OPT != 0 as *u8 {
            let level = buf_new();
            buf_byte(level, OPT[2]);
            run_words(c"sh", c"tests/run.sh", c"-c", base, c"-O", buf_cstr(level),
                buf_cstr(filter), log);
        } else {
            run_words(c"sh", c"tests/run.sh", c"-c", base, buf_cstr(filter), 0 as *u8, 0 as *u8,
                log);
        }
        let totals = alloc_array::<i64>(3);
        totals[0] = 0;
        totals[1] = 0;
        totals[2] = 0;
        var blocks = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var names = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if !parse_run(buf_slice(log), totals, &blocks, &names) {
            return -1;
        }
        for k in 0..names.count {
            if buf_slice(names.data[k]) == name {
                return 1;
            }
        }
        0
    }
}

// Each failure run again with the baseline compiler: its block says whether
// it fails there too (the environment, or a cause older than the change)
// or is new; `counts` gets (new, old).
fn mark_baseline(base: *u8, blocks: IntVec, names: IntVec, counts: *i64) {
    unsafe {
        for k in 0..names.count {
            let name = buf_slice(names.data[k]);
            if name == "run.sh" {
                continue;
            }
            let f = fails_with(base, name);
            if f < 0 {
                continue;
            }
            let b = blocks.data[k];
            if f == 1 {
                buf_bytes(b, "  (fails with ");
                buf_str(b, base);
                buf_bytes(b, " too: not from this change)\n");
                counts[1] = counts[1] + 1;
            } else {
                buf_bytes(b, "  (new: passes with ");
                buf_str(b, base);
                buf_bytes(b, ")\n");
                counts[0] = counts[0] + 1;
            }
        }
    }
}

// Reads run.sh's report: its FAIL and XPASS blocks into blocks (their
// first lines and a few more) and names, its totals (pass, xfail, fail)
// added; false when it has no table.
fn parse_run(log: [u8], totals: *i64, blocks: inout IntVec, names: inout IntVec) -> bool {
    unsafe {
        var block = -1;
        var lines = 0;
        var extra = 0;
        var table = false;
        var i = 0;
        while i <= log.len {
            let e = line_end(log, i);
            let l = if i < log.len { log[i..e] } else { log[0..0] };
            i = e + 1;
            let fail = starts(l, "FAIL ");
            let xpass = starts(l, "XPASS ");
            let end = l.len == 0 || fail || xpass || starts(l, "tests for ");
            if end && block >= 0 {
                if extra > 0 {
                    buf_bytes(block, "  (");
                    buf_int(block, extra);
                    buf_bytes(block, " more lines)\n");
                }
                block = -1;
            }
            if fail || xpass {
                let start = if fail { 5 } else { 6 };
                var n = start;
                while n < l.len && l[n] != ':' && l[n] != ' ' {
                    n += 1;
                }
                var dup = false;
                for k in 0..names.count {
                    dup = dup || buf_slice(names.data[k]) == l[start..n];
                }
                if dup {
                    continue;
                }
                let name = buf_new();
                buf_bytes(name, l[start..n]);
                names.push(name);
                let b = buf_new();
                put_cut(b, "", l);
                blocks.push(b);
                block = if fail { b } else { -1 };
                lines = 0;
                extra = 0;
                continue;
            }
            if block >= 0 {
                var s = 0;
                while s < 4 && s < l.len && l[s] == ' ' {
                    s += 1;
                }
                if lines < 2 * detail_lines() {
                    put_cut(block, "  ", l[s..l.len]);
                } else {
                    extra += 1;
                }
                lines += 1;
                continue;
            }
            if starts(l, "  total ") {
                var k = 0;
                var p = 8;
                while k < 3 && p < l.len {
                    while p < l.len && l[p] == ' ' {
                        p += 1;
                    }
                    var n = 0;
                    while p < l.len && l[p] >= '0' && l[p] <= '9' {
                        n = n * 10 + (l[p] - '0') as i64;
                        p += 1;
                    }
                    totals[k] = totals[k] + n;
                    k += 1;
                }
                table = true;
            }
        }
        table
    }
}
