// `tachyonc test [FILTER...] [ROOT.tach]` (0.17; docs/query.md, "test"):
// one command that builds what changed, runs the tests and ends with a
// compact summary: the counts on the first line, then only the failing
// cases, each with a short difference, within --budget tokens (1000;
// `--full`: every failure, longer differences, no budget unless given).
//
// A program (ROOT, default ./main.tach): its cases are tests/NAME.in
// (stdin; none: empty) with tests/NAME.out (the expected stdout) in
// ROOT's directory (--dir DIR: another), and tests/NAME.exit, when there,
// the expected exit status (default 0). Output is compared as the agent
// eval grades it: `\r\n` as `\n`, trailing whitespace at the end left out.
// The program is built into $TMPDIR/tachyonc-test/KEY/prog (KEY: the
// root, the level and the compiler) when it is not there or a .tach file
// under ROOT's directory is newer; the outputs stay there (NAME.got,
// NAME.err). Each case may run --timeout seconds (10). Without cases: the
// build alone, or a run on --input FILE (`-`: stdin).
//
// The tachyon repository (./compiler/src/main.tach and ./tests/run.sh, no
// ROOT given): std embedded again when compiler/std is newer than its
// embedding (compiler/std/embed.sh); target/tachyonc rebuilt when a .tach
// file of compiler/src or compiler/std is newer (one build, by
// target/tools/tachyonc when there; bootstrap/bootstrap.sh --dev checks
// the fixpoint); then `tests/run.sh [-O N] FILTER` once per FILTER (none:
// the whole suite), its FAIL blocks and totals summarized.
//
// Exit status: 0 when every case passed, 1 a failure or a build error, 2
// a usage error or no case to run.

mod repo;
mod program;

use crate::base::{
    IntVec, STDOUT, alloc_array, buf_byte, buf_bytes, buf_hex, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, streq, strlen,
};
use crate::front::cpp::directives::file_exists;
use crate::tools::proc::{
    absolute_path, buf_cstr, make_dirs, read_file_if, read_stdin, rename_file, run_capture,
    write_file_if,
};
use crate::tools::query::{c_slice, ends_with_c, parse_count};
use crate::tools::query::diagnostics::{
    PROG, TOOL, diag, put_cword, try_begin, try_end, write_diags,
};
use crate::tools::testrun::program::{ACCEPT, CASES, NO_CHECK_ALLOC, NO_CONTRACTS, SEED, run_all};
use crate::tools::testrun::repo::run_repo;
use crate::tools::v018::{not_yet, test_option018};

extern "C" {
    fn getenv(name: *u8) -> *u8;
    fn fork() -> i32;
    fn execvp(file: *u8, argv: **u8) -> i32;
    fn waitpid(pid: i32, status: *i32, options: i32) -> i32;
    fn open(path: *u8, flags: i32) -> i32;
    fn creat(path: *u8, mode: i32) -> i32;
    fn dup2(from: i32, to: i32) -> i32;
    fn close(fd: i32) -> i32;
    fn alarm(seconds: u32) -> u32;
    fn _exit(code: i32) -> !;
    fn chmod(path: *u8, mode: i32) -> i32;
    fn gettimeofday(tv: *i64, tz: *u8) -> i32;
}

// The options.
static mut BUDGET: i64 = 4000;
static mut BUDGET_GIVEN: bool = false;
static mut FULL: bool = false;
static mut TIMEOUT: i64 = 10;
static mut OPT: *u8 = 0 as *u8;
static mut INPUT: *u8 = 0 as *u8;
static mut DIR: *u8 = 0 as *u8;
// (0.17) Programs are built with --trace (not at -O0, nor with --no-trace):
// a failed check prints the calls that led to it, a time limit where it ran.
static mut TRACED: bool = true;
// (0.17) In the tachyon tree: the compiler failures are run again with
// (`--against C`; "none": not run again; 0: target/tools/tachyonc).
pub static mut AGAINST: *u8 = 0 as *u8;
static mut FILTERS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The arguments as typed but --budget and --full, for the `--full` hint.
static mut ARGS: i64 = -1;

// Lines of difference (or stderr) shown per failing case, and columns.
fn detail_lines() -> i64 {
    unsafe { if FULL { 40 } else { 4 } }
}

// Lines of stderr shown for a case that failed or ran out of time: its
// message and (0.17) the trace after it.
fn stderr_lines() -> i64 {
    unsafe { if FULL { 40 } else { 12 } }
}

// Whether the program is built with --trace.
fn traced() -> bool {
    unsafe { TRACED && !(OPT != 0 as *u8 && streq(OPT, c"-O0")) }
}

fn columns() -> i64 {
    unsafe { if FULL { 400 } else { 160 } }
}

pub fn run_test(argc: i64, argv: **u8) -> i64 {
    let status = test_inner(argc, argv);
    write_diags();
    status
}

fn usage(why: *u8, word: *u8) -> i64 {
    unsafe {
        let d = diag(c"error", c"test.usage");
        buf_str(d, why);
        if word != 0 as *u8 {
            buf_str(d, c" '");
            buf_str(d, word);
            buf_byte(d, '\'');
        }
        buf_str(d, c"; usage: tachyonc test [FILTER...] [ROOT.tach] [--dir DIR] [--input FILE] [--budget N] [--full] [--timeout S] [-O N] [--no-trace] [--against TACHYONC] [--accept] [--cases N] [--seed S] [--no-contracts] [--no-check-alloc]\n");
        2
    }
}

fn test_inner(argc: i64, argv: **u8) -> i64 {
    unsafe {
        PROG = argv[0];
        TOOL = 0 as *u8;
        ARGS = buf_new();
        let mut root = 0 as *u8;
        let mut i = 2;
        while i < argc {
            let a = argv[i];
            // (0.18: the language's tests, tools/testrun/program.tach)
            if streq(a, c"--accept") || streq(a, c"--no-contracts")
                || streq(a, c"--no-check-alloc") {
                if streq(a, c"--accept") {
                    ACCEPT = true;
                } else if streq(a, c"--no-contracts") {
                    NO_CONTRACTS = true;
                } else {
                    NO_CHECK_ALLOC = true;
                }
                put_cword(ARGS, a);
                i += 1;
                continue;
            }
            if streq(a, c"--cases") || streq(a, c"--seed") {
                if i + 1 >= argc {
                    return usage(c"a value is needed after", a);
                }
                if streq(a, c"--cases") {
                    let n = parse_count(argv[i + 1]);
                    if n <= 0 {
                        return usage(c"--cases takes a number, not", argv[i + 1]);
                    }
                    CASES = n;
                } else {
                    SEED = argv[i + 1];
                }
                put_cword(ARGS, a);
                put_cword(ARGS, argv[i + 1]);
                i += 2;
                continue;
            }
            // (0.18 T3: --fuzz S; --gen: tools/v018.tach)
            if test_option018(a) {
                return not_yet(c"test.not-yet", a, c"T2");
            }
            let valued = streq(a, c"--budget") || streq(a, c"--timeout") || streq(a, c"--dir")
                || streq(a, c"--input") || streq(a, c"--root") || streq(a, c"-O")
                || streq(a, c"--against");
            if valued && i + 1 >= argc {
                return usage(c"a value is needed after", a);
            }
            if streq(a, c"--full") {
                FULL = true;
            } else if streq(a, c"--against") {
                AGAINST = argv[i + 1];
                i += 1;
            } else if streq(a, c"--no-trace") {
                TRACED = false;
                put_cword(ARGS, a);
            } else if streq(a, c"--budget") {
                let n = parse_count(argv[i + 1]);
                if n <= 0 {
                    return usage(c"--budget takes a number of tokens, not", argv[i + 1]);
                }
                BUDGET = n * 4;
                BUDGET_GIVEN = true;
                i += 1;
            } else if streq(a, c"--timeout") {
                let n = parse_count(argv[i + 1]);
                if n <= 0 {
                    return usage(c"--timeout takes a number of seconds, not", argv[i + 1]);
                }
                TIMEOUT = n;
                put_cword(ARGS, a);
                put_cword(ARGS, argv[i + 1]);
                i += 1;
            } else if streq(a, c"--dir") || streq(a, c"--input") || streq(a, c"--root") {
                if streq(a, c"--dir") {
                    DIR = argv[i + 1];
                } else if streq(a, c"--input") {
                    INPUT = argv[i + 1];
                } else {
                    root = argv[i + 1];
                }
                put_cword(ARGS, a);
                put_cword(ARGS, argv[i + 1]);
                i += 1;
            } else if streq(a, c"-O") {
                let l = argv[i + 1];
                if !(l[0] >= '0' && l[0] <= '2' && l[1] == 0) {
                    return usage(c"-O takes 0, 1 or 2, not", l);
                }
                let b = buf_new();
                buf_str(b, c"-O");
                buf_str(b, l);
                OPT = buf_cstr(b);
                put_cword(ARGS, OPT);
                i += 1;
            } else if streq(a, c"-O0") || streq(a, c"-O1") || streq(a, c"-O2") {
                OPT = a;
                put_cword(ARGS, a);
            } else if a[0] == '-' && a[1] != 0 {
                return usage(c"unknown option", a);
            } else if ends_with_c(a, c".tach") {
                if root != 0 as *u8 {
                    return usage(c"one ROOT at most; a second", a);
                }
                root = a;
                put_cword(ARGS, a);
            } else {
                FILTERS.push(a as i64);
                put_cword(ARGS, a);
            }
            i += 1;
        }
        if FULL && !BUDGET_GIVEN {
            BUDGET = 1 << 40;
        }
        if root == 0 as *u8 && file_exists(c"compiler/src/main.tach")
            && file_exists(c"tests/run.sh") {
            return run_repo();
        }
        if root == 0 as *u8 {
            if !file_exists(c"main.tach") {
                let d = diag(c"error", c"test.no-root");
                buf_str(d, c"no main.tach here: name the program's root\n");
                let t = try_begin(c"test path/to/main.tach", c_slice(c""), false);
                try_end(t);
                return 2;
            }
            root = c"main.tach";
        }
        if !file_exists(root) {
            let d = diag(c"error", c"test.no-root");
            buf_str(d, c"no file '");
            buf_str(d, root);
            buf_str(d, c"'\n");
            return 2;
        }
        run_program(root)
    }
}

// ---- Helpers ----

// Wall-clock milliseconds.
fn now_ms() -> i64 {
    unsafe {
        let tv = alloc_array::<i64>(2);
        tv[0] = 0;
        tv[1] = 0;
        gettimeofday(tv, 0 as *u8);
        // (tv_usec: a 32-bit int on macOS, a long on Linux; little-endian)
        tv[0] * 1000 + (tv[1] & 4294967295) / 1000
    }
}

fn put_secs(out: i64, ms: i64) {
    buf_int(out, ms / 1000);
    buf_byte(out, '.');
    let c = (ms % 1000) / 10;
    if c < 10 {
        buf_byte(out, '0');
    }
    buf_int(out, c);
    buf_bytes(out, " s");
}

fn join(dir: *u8, name: [u8]) -> *u8 {
    unsafe {
        let b = buf_new();
        buf_str(b, dir);
        let s = buf_slice(b);
        if s.len > 0 && s[s.len - 1] != '/' {
            buf_byte(b, '/');
        }
        buf_bytes(b, name);
        buf_cstr(b)
    }
}

// The directory part of path (`.` when it has none), as a C string.
fn dir_of(path: *u8) -> *u8 {
    unsafe {
        let s = c_slice(path);
        let mut i = s.len - 1;
        while i > 0 && s[i] != '/' {
            i -= 1;
        }
        let b = buf_new();
        if i <= 0 {
            buf_bytes(b, if s.len > 0 && s[0] == '/' { "/" } else { "." });
        } else {
            buf_bytes(b, s[0..i]);
        }
        buf_cstr(b)
    }
}

// path as the user would type it from here: relative under the current
// directory.
fn shown_path(path: *u8) -> *u8 {
    unsafe {
        let here = absolute_path(c".");
        let n = strlen(here) as i64;
        if strlen(path) as i64 > n + 1 && c_slice(path)[0..n] == c_slice(here) && path[n] == '/' {
            return &path[n + 1];
        }
        path
    }
}

pub fn contains(hay: [u8], needle: [u8]) -> bool {
    if needle.len == 0 {
        return true;
    }
    let mut i = 0;
    while i + needle.len <= hay.len {
        if hay[i..i + needle.len] == needle {
            return true;
        }
        i += 1;
    }
    false
}

fn starts(s: [u8], p: [u8]) -> bool {
    s.len >= p.len && s[0..p.len] == p
}

fn fnv(h0: u64, s: [u8]) -> u64 {
    let mut h = h0;
    for i in 0..s.len {
        h = (h ^ s[i] as u64) * 1099511628211;
    }
    h
}

// Whether a name passes the filters (any of them is part of it; none:
// every name).
fn selected(name: [u8]) -> bool {
    unsafe {
        if FILTERS.count == 0 {
            return true;
        }
        for k in 0..FILTERS.count {
            if contains(name, c_slice(FILTERS.data[k] as *u8)) {
                return true;
            }
        }
        false
    }
}

// Runs argv (ending with 0), stdout and stderr into out: its exit status.
fn run_words(w0: *u8, w1: *u8, w2: *u8, w3: *u8, w4: *u8, w5: *u8, w6: *u8, out: i64) -> i64 {
    unsafe {
        let argv = alloc_array::<*u8>(8);
        argv[0] = w0;
        argv[1] = w1;
        argv[2] = w2;
        argv[3] = w3;
        argv[4] = w4;
        argv[5] = w5;
        argv[6] = w6;
        argv[7] = 0 as *u8;
        // (a 0 ends the list: the words after the first 0 are left out)
        run_capture(argv, out)
    }
}

// Whether `find DIRS -name '*.tach' -newer FILE` finds a file.
fn newer_tach(dir1: *u8, dir2: *u8, file: *u8) -> bool {
    unsafe {
        let out = buf_new();
        if dir2 == 0 as *u8 {
            run_words(c"find", dir1, c"-name", c"*.tach", c"-newer", file, 0 as *u8, out);
        } else {
            let argv = alloc_array::<*u8>(8);
            argv[0] = c"find";
            argv[1] = dir1;
            argv[2] = dir2;
            argv[3] = c"-name";
            argv[4] = c"*.tach";
            argv[5] = c"-newer";
            argv[6] = file;
            argv[7] = 0 as *u8;
            run_capture(argv, out);
        }
        buf_slice(out).len > 0
    }
}

// Appends line (cut at the column limit) after prefix, and a newline.
fn put_cut(out: i64, prefix: [u8], line: [u8]) {
    buf_bytes(out, prefix);
    let max = columns();
    if line.len > max {
        buf_bytes(out, line[0..max]);
        buf_bytes(out, "...");
    } else {
        buf_bytes(out, line);
    }
    buf_byte(out, '\n');
}

// The end of the line starting at i (its '\n', or s.len).
fn line_end(s: [u8], i: i64) -> i64 {
    let mut e = i;
    while e < s.len && s[e] != '\n' {
        e += 1;
    }
    e
}

fn line_count(s: [u8]) -> i64 {
    if s.len == 0 {
        return 0;
    }
    let mut n = 1;
    for i in 0..s.len {
        if s[i] == '\n' {
            n += 1;
        }
    }
    if s[s.len - 1] == '\n' { n - 1 } else { n }
}

// `N line` or `N lines`.
fn put_lines_count(out: i64, n: i64) {
    buf_int(out, n);
    buf_bytes(out, if n == 1 { " line" } else { " lines" });
}

// Up to max lines of s from line index `from`, each after prefix.
fn put_lines(out: i64, s: [u8], from: i64, max: i64, prefix: [u8]) -> i64 {
    let mut i = 0;
    let mut ln = 0;
    let mut shown = 0;
    while i < s.len && shown < max {
        let e = line_end(s, i);
        if ln >= from {
            put_cut(out, prefix, s[i..e]);
            shown += 1;
        }
        ln += 1;
        i = e + 1;
    }
    shown
}

// The text as the eval compares it: `\r\n` as `\n`, trailing whitespace
// at the end left out.
fn normal(s: [u8]) -> [u8] {
    let b = buf_new();
    let mut i = 0;
    while i < s.len {
        if !(s[i] == '\r' && i + 1 < s.len && s[i + 1] == '\n') {
            buf_byte(b, s[i]);
        }
        i += 1;
    }
    let t = buf_slice(b);
    let mut e = t.len;
    while e > 0 && (t[e - 1] == ' ' || t[e - 1] == '\t' || t[e - 1] == '\n' || t[e - 1] == '\r') {
        e -= 1;
    }
    t[0..e]
}

// The failures, as many as the budget holds (one at least), then the
// names of the rest and the command that prints them.
fn put_failures(out: i64, blocks: *IntVec, names: *IntVec) {
    unsafe {
        let mut shown = 0;
        while shown < (*blocks).count {
            let b = buf_slice((*blocks).data[shown]);
            if shown > 0 && buf_slice(out).len + b.len > BUDGET {
                break;
            }
            buf_bytes(out, b);
            shown += 1;
        }
        if shown < (*blocks).count {
            buf_byte(out, '(');
            buf_int(out, (*blocks).count - shown);
            buf_bytes(out, " more failing: ");
            let mut k = shown;
            while k < (*blocks).count && k < shown + 12 {
                if k > shown {
                    buf_bytes(out, ", ");
                }
                buf_bytes(out, buf_slice((*names).data[k]));
                k += 1;
            }
            if k < (*blocks).count {
                buf_bytes(out, ", ...");
            }
            buf_bytes(out, "; all of them:");
            put_cword(out, PROG);
            buf_bytes(out, " test");
            buf_bytes(out, buf_slice(ARGS));
            buf_bytes(out, " --full)\n");
        }
    }
}

// ---- A program ----

// The directory of the program's build and outputs: .tachyonc/test next
// to its root (as the edit journal's .tachyonc/ outside git), else, when
// that cannot be made, $TMPDIR/tachyonc-test/KEY (KEY: the root's path).
fn work_dir(root_abs: *u8, src_dir: *u8) -> *u8 {
    unsafe {
        let local = join(src_dir, ".tachyonc/test");
        if make_dirs(local) {
            return local;
        }
        let h = fnv(14695981039346656037, c_slice(root_abs));
        let b = buf_new();
        let tmp = getenv(c"TMPDIR");
        buf_str(b, if tmp != 0 as *u8 && tmp[0] != 0 { tmp } else { c"/tmp" });
        let s = buf_slice(b);
        if s[s.len - 1] != '/' {
            buf_byte(b, '/');
        }
        buf_bytes(b, "tachyonc-test/");
        buf_hex(b, h, 16);
        let dir = buf_cstr(b);
        make_dirs(dir);
        dir
    }
}

// What the build was made with (the options, the compiler's bytes), kept
// next to it: another compiler or level builds anew.
fn build_key() -> [u8] {
    unsafe {
        let mut h = fnv(14695981039346656037, "tachyonc test");
        if OPT != 0 as *u8 {
            h = fnv(h, c_slice(OPT));
        }
        if traced() {
            h = fnv(h, "--trace");
        }
        let mut slash = false;
        for i in 0..strlen(PROG) as i64 {
            slash = slash || PROG[i] == '/';
        }
        let exe = buf_new();
        if slash && read_file_if(PROG, exe) {
            h = fnv(h, buf_slice(exe));
        } else {
            h = fnv(h, c_slice(PROG));
        }
        let b = buf_new();
        buf_hex(b, h, 16);
        buf_byte(b, '\n');
        buf_slice(b)
    }
}

// (0.18) build_key at another level than OPT.
fn build_key_for(level: *u8) -> [u8] {
    unsafe {
        let was = OPT;
        OPT = level;
        let key = build_key();
        OPT = was;
        key
    }
}

// Builds the program into prog when a source is newer (or there is none):
// false, with its errors printed, when it does not build.
fn build_program(root: *u8, src_dir: *u8, work: *u8, prog: *u8, out: i64) -> bool {
    unsafe {
        let key_file = join(work, "key");
        let key = build_key();
        let old = buf_new();
        if file_exists(prog) && read_file_if(key_file, old) && buf_slice(old) == key
            && !newer_tach(src_dir, 0 as *u8, prog) {
            return true;
        }
        let built = join(work, "build");
        let log = buf_new();
        let trace = if traced() { c"--trace" } else { 0 as *u8 };
        let rc = if OPT == 0 as *u8 {
            run_words(PROG, root, c"-o", built, c"--diagnostics=short", trace, 0 as *u8, log)
        } else {
            run_words(PROG, root, c"-o", built, c"--diagnostics=short", OPT, trace, log)
        };
        if rc != 0 {
            let l = buf_slice(log);
            let mut errors = 0;
            let mut i = 0;
            while i < l.len {
                let e = line_end(l, i);
                if contains(l[i..e], ": error") || starts(l[i..e], "error") {
                    errors += 1;
                }
                i = e + 1;
            }
            buf_bytes(out, "test ");
            buf_str(out, root);
            buf_bytes(out, ": does not build");
            if errors > 0 {
                buf_bytes(out, " (");
                buf_int(out, errors);
                buf_bytes(out, if errors == 1 { " error)" } else { " errors)" });
            }
            buf_byte(out, '\n');
            let mut i = 0;
            while i < l.len {
                let e = line_end(l, i);
                if e > i {
                    if buf_slice(out).len + (e - i) > BUDGET {
                        buf_bytes(out, "(more: ");
                        buf_str(out, PROG);
                        buf_bytes(out, " check ");
                        buf_str(out, root);
                        buf_bytes(out, ")\n");
                        break;
                    }
                    put_cut(out, "", l[i..e]);
                }
                i = e + 1;
            }
            return false;
        }
        // (written over in place: macOS checks a new executable file the
        // first time it runs, not one written over)
        let bytes = buf_new();
        if !read_file_if(built, bytes) || !write_file_if(prog, buf_slice(bytes)) {
            rename_file(built, prog);
        }
        chmod(prog, 493);
        write_file_if(key_file, key);
        true
    }
}

// Runs prog with stdin from input (0: none), stdout and stderr into the
// files: its exit status, 128 + a signal, -1 past the time limit.
fn run_case(prog: *u8, input: *u8, out_path: *u8, err_path: *u8) -> i64 {
    unsafe {
        let argv = alloc_array::<*u8>(2);
        argv[0] = prog;
        argv[1] = 0 as *u8;
        let from = if input != 0 as *u8 { input } else { c"/dev/null" };
        let pid = fork();
        if pid < 0 {
            return 127;
        }
        if pid == 0 {
            let fd = open(from, 0);
            if fd >= 0 {
                dup2(fd, 0);
                close(fd);
            }
            let o = creat(out_path, 420);
            if o >= 0 {
                dup2(o, 1);
                close(o);
            }
            let e = creat(err_path, 420);
            if e >= 0 {
                dup2(e, 2);
                close(e);
            }
            alarm(TIMEOUT as u32);
            execvp(prog, argv);
            _exit(127);
        }
        let mut status = 0 as i32;
        waitpid(pid, &status, 0);
        let s = status as i64;
        if (s & 127) == 14 {
            return -1;
        }
        if (s & 127) == 0 { (s >> 8) & 255 } else { 128 + (s & 127) }
    }
}

// The names of the cases in dir: each NAME with a NAME.out or NAME.in,
// once, as the filters select them; false when dir cannot be listed.
fn list_cases(dir: *u8, names: *IntVec) -> bool {
    unsafe {
        let listing = buf_new();
        if run_words(c"ls", c"-1", dir, 0 as *u8, 0 as *u8, 0 as *u8, 0 as *u8, listing) != 0 {
            return false;
        }
        let t = buf_slice(listing);
        let mut i = 0;
        while i < t.len {
            let e = line_end(t, i);
            let f = t[i..e];
            i = e + 1;
            let mut n = -1;
            if f.len > 4 && f[f.len - 4..f.len] == ".out" {
                n = f.len - 4;
            } else if f.len > 3 && f[f.len - 3..f.len] == ".in" {
                n = f.len - 3;
            }
            if n <= 0 || !selected(f[0..n]) {
                continue;
            }
            let mut seen = false;
            for k in 0..(*names).count {
                seen = seen || buf_slice((*names).data[k]) == f[0..n];
            }
            if !seen {
                let b = buf_new();
                buf_bytes(b, f[0..n]);
                names.push(b);
            }
        }
        true
    }
}

fn case_file(dir: *u8, name: [u8], ext: [u8]) -> *u8 {
    let b = buf_new();
    buf_bytes(b, name);
    buf_bytes(b, ext);
    join(dir, buf_slice(b))
}

// The expected exit status: NAME.exit's number, else 0.
fn expected_exit(path: *u8) -> i64 {
    let b = buf_new();
    if !read_file_if(path, b) {
        return 0;
    }
    let s = buf_slice(b);
    let mut n = 0;
    for i in 0..s.len {
        if s[i] >= '0' && s[i] <= '9' {
            n = n * 10 + (s[i] - '0') as i64;
        }
    }
    n
}

// Why the output differs, into block: from the first line that differs,
// a few expected lines (`-`) and the lines it printed (`+`).
fn put_difference(block: i64, want: [u8], got: [u8]) {
    let mut i = 0;
    let mut j = 0;
    let mut ln = 0;
    while i < want.len && j < got.len {
        let a = line_end(want, i);
        let b = line_end(got, j);
        if want[i..a] != got[j..b] {
            break;
        }
        i = a + 1;
        j = b + 1;
        ln += 1;
    }
    buf_bytes(block, "stdout differs at line ");
    buf_int(block, ln + 1);
    buf_bytes(block, " (");
    put_lines_count(block, line_count(want));
    buf_bytes(block, " expected, ");
    buf_int(block, line_count(got));
    buf_bytes(block, " printed)\n");
    let half = (detail_lines() + 1) / 2;
    if put_lines(block, want, ln, half, "  - ") == 0 {
        buf_bytes(block, "  - (end of output)\n");
    }
    if put_lines(block, got, ln, half, "  + ") == 0 {
        buf_bytes(block, "  + (end of output)\n");
    }
}

// The program at root: its cases and tests (0.18: tools/testrun/program.tach),
// or one run on --input.
fn run_program(root: *u8) -> i64 {
    unsafe {
        let out = buf_new();
        let root_abs = absolute_path(root);
        let src_dir = dir_of(root_abs);
        let dir_shown = if DIR != 0 as *u8 { DIR } else { join(dir_of(root), "tests") };
        let shown = if streq(dir_shown, c"./tests") { c"tests" } else { dir_shown };
        let tests = absolute_path(dir_shown);
        let work = work_dir(root_abs, src_dir);
        if !file_exists(work) {
            let d = diag(c"error", c"test.no-root");
            buf_str(d, c"cannot make the build directory '");
            buf_str(d, work);
            buf_str(d, c"' (set TMPDIR)\n");
            return 2;
        }
        if INPUT != 0 as *u8 {
            let prog = join(work, "prog");
            if !build_program(root, src_dir, work, prog, out) {
                buf_write_fd(out, STDOUT);
                return 1;
            }
            return run_on_input(root, prog, work, out);
        }
        run_all(root, src_dir, tests, shown, work, out)
    }
}

// `--input FILE`: one run, its output and exit status.
fn run_on_input(root: *u8, prog: *u8, work: *u8, out: i64) -> i64 {
    unsafe {
        let mut input = INPUT;
        if streq(INPUT, c"-") {
            let b = buf_new();
            read_stdin(b);
            input = join(work, "stdin.in");
            write_file_if(input, buf_slice(b));
        } else if !file_exists(INPUT) {
            let d = diag(c"error", c"test.usage");
            buf_str(d, c"no file '");
            buf_str(d, INPUT);
            buf_str(d, c"' (--input FILE)\n");
            return 2;
        }
        let got_path = join(work, "input.got");
        let err_path = join(work, "input.err");
        let status = run_case(prog, input, got_path, err_path);
        let got_b = buf_new();
        read_file_if(got_path, got_b);
        let got = normal(buf_slice(got_b));
        let err_b = buf_new();
        read_file_if(err_path, err_b);
        let err = normal(buf_slice(err_b));
        buf_bytes(out, "test ");
        buf_str(out, root);
        buf_bytes(out, ": ran on ");
        buf_str(out, INPUT);
        buf_bytes(out, ": ");
        if status == -1 {
            buf_bytes(out, "no exit after ");
            buf_int(out, TIMEOUT);
            buf_bytes(out, " s");
        } else {
            buf_bytes(out, "exit ");
            buf_int(out, status);
        }
        buf_bytes(out, ", ");
        put_lines_count(out, line_count(got));
        buf_bytes(out, " of output\n");
        let mut i = 0;
        while i < got.len {
            let e = line_end(got, i);
            if buf_slice(out).len + (e - i) > BUDGET {
                buf_bytes(out, "(the rest: ");
                buf_str(out, got_path);
                buf_bytes(out, ")\n");
                break;
            }
            put_cut(out, "", got[i..e]);
            i = e + 1;
        }
        put_lines(out, err, 0, stderr_lines(), "stderr: ");
        buf_write_fd(out, STDOUT);
        if status == 0 { 0 } else { 1 }
    }
}
