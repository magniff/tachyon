// A rewrite's pattern and replacement: their holes (`$x`, `$x...`, the
// --where types), parsed as tachyon; the matching of the pattern against a
// node, with the types the checker gave; and a site's replacement text.

use crate::base::{
    BUFS, IntVec, SRC, _setjmp, add_source, buf_byte, buf_bytes, buf_new, buf_slice, buf_str,
    intern,
};
use crate::base::diag::{
    ERR, RECOVER_DEPTH, errors_forget, errors_mark, recover_enter, recover_leave,
};
use crate::front::ast::{NODES, NodeKind, PARSED_COUNT, keep_parsed};
use crate::front::lexer::{TOK_COUNT, lex_range};
use crate::front::parser::parse_fragment;
use crate::front::types::buf_type;
use crate::middle::lower::ssa::HMap;
use crate::tools::query::c_slice;
use crate::tools::query::defs::bytes_eq;
use crate::tools::query::diagnostics::diag;
use crate::tools::query::positions::is_space;
use crate::tools::rewrite::parsed::{
    binding_level, pa, pb, pc, pchild, pcount, pd, pend, pflags, pg, ph, pk, pop, pstart,
    same_tokens,
};

// ---- Holes ----

// Per hole: its identifier's symbol, its name as written (a buffer:
// `$x`), whether it is `$x...`, its --where type (a buffer, without
// spaces; -1: none).
pub static mut H_SYM: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut H_NAME: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut H_REST: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut H_TYPE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// What each hole matched at the site being tried: B_NODE the node (-1:
// nothing yet, -2: arguments, from B_START to B_END; -3: no arguments).
pub static mut B_NODE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut B_START: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut B_END: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// (0.15) For a `$x...` hole: the node whose list it matched in.
pub static mut B_LIST: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The pattern's hole nodes.
pub static mut PAT_HOLES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Sites left out by a --where type: how many, and the first one (its
// node, hole, type).
pub static mut TYPE_MISSES: i64 = 0;
pub static mut MISS_NODE: i64 = 0;
pub static mut MISS_HOLE: i64 = 0;
pub static mut MISS_TYPE: i64 = 0;
// Sites left out because the checker did not type their code.
pub static mut UNTYPED: i64 = 0;

pub fn is_name_byte(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

pub fn hole_named(name: [u8], rest: bool) -> i64 {
    unsafe {
        for h in 0..H_SYM.count {
            if bytes_eq(buf_slice(H_NAME.data[h]), name) && (H_REST.data[h] != 0) == rest {
                return h;
            }
        }
        -1
    }
}

// Writes `text` into buffer `out` with each hole an identifier; the
// pattern's holes are added (`add`), the replacement's must be the
// pattern's. False after the diagnostic.
pub fn holes_to_idents(text: *u8, out: i64, add: bool) -> bool {
    unsafe {
        let s = c_slice(text);
        let mut i = 0;
        while i < s.len {
            let c = s[i];
            if c == '"' || c == '\'' {
                // (a string or a character: as it is)
                buf_byte(out, c);
                i += 1;
                while i < s.len && s[i] != c {
                    if s[i] == '\\' && i + 1 < s.len {
                        buf_byte(out, s[i]);
                        i += 1;
                    }
                    buf_byte(out, s[i]);
                    i += 1;
                }
                if i < s.len {
                    buf_byte(out, s[i]);
                    i += 1;
                }
                continue;
            }
            if c != '$' {
                buf_byte(out, c);
                i += 1;
                continue;
            }
            let mut e = i + 1;
            while e < s.len && is_name_byte(s[e]) {
                e += 1;
            }
            if e == i + 1 {
                let d = diag(c"error", c"rewrite.pattern");
                buf_str(d, c"'$' without a name in '");
                buf_bytes(d, s);
                buf_str(d, c"': holes are $name, or $name... for arguments\n");
                return false;
            }
            let name = s[i..e];
            let rest = e + 3 <= s.len && s[e] == '.' && s[e + 1] == '.' && s[e + 2] == '.';
            let ident = buf_new();
            buf_str(ident, if rest { c"__tachyon_rest_" } else { c"__tachyon_hole_" });
            buf_bytes(ident, s[i + 1..e]);
            let mut h = hole_named(name, rest);
            if h < 0 {
                if hole_named(name, !rest) >= 0 {
                    let d = diag(c"error", c"rewrite.pattern");
                    buf_bytes(d, name);
                    buf_str(d, c" is written both with and without '...'\n");
                    return false;
                }
                if !add {
                    let d = diag(c"error", c"rewrite.unbound");
                    buf_str(d, c"the replacement's ");
                    buf_bytes(d, name);
                    if rest {
                        buf_str(d, c"...");
                    }
                    buf_str(d, c" is not in the pattern\n");
                    return false;
                }
                h = H_SYM.count;
                H_SYM.push(intern(buf_slice(ident)));
                let nb = buf_new();
                buf_bytes(nb, name);
                H_NAME.push(nb);
                H_REST.push(rest as i64);
                H_TYPE.push(-1);
            }
            buf_bytes(out, buf_slice(ident));
            i = if rest { e + 3 } else { e };
        }
        true
    }
}

// The hole node n is (an identifier, a type name or a binding of a
// hole), or -1.
pub fn hole_of(n: i64) -> i64 {
    unsafe {
        if n <= 0 {
            return -1;
        }
        let k = pk(n);
        if k != NodeKind::Ident && k != NodeKind::TyName && k != NodeKind::PatBind {
            return -1;
        }
        if k == NodeKind::Ident && pg(n) != 0 {
            return -1;
        }
        let sym = pa(n);
        for h in 0..H_SYM.count {
            if H_SYM.data[h] == sym {
                return h;
            }
        }
        -1
    }
}

// (0.15) The elements of node n's list as matched: a block's statements
// and then its tail expression, when it has one; another node's list.
pub fn seq_len(n: i64) -> i64 {
    if pk(n) == NodeKind::Block && pa(n) != 0 { pcount(n) + 1 } else { pcount(n) }
}

pub fn seq_at(n: i64, i: i64) -> i64 {
    if i < pcount(n) { pchild(n, i) } else { pa(n) }
}

// The `$x...` hole element e of a list is (in a block, written as a
// statement `$s...;` or as the tail `$s...`), or -1.
pub fn rest_hole_of(e: i64) -> i64 {
    let x = if e > 0 && pk(e) == NodeKind::ExprStmt { pa(e) } else { e };
    let h = hole_of(x);
    if h >= 0 && unsafe { H_REST.data[h] } != 0 { h } else { -1 }
}

// Parses buffer `text` (the statements, `stmts`) after the program: its
// node, or 0 after the diagnostic (`what`: the pattern or the
// replacement).
pub fn parse_text(text: i64, stmts: bool, what: *u8) -> i64 {
    unsafe {
        let start = add_source(c"<rewrite>", text);
        let first = TOK_COUNT;
        let mark = errors_mark();
        let depth = RECOVER_DEPTH;
        let mut n = 0;
        if _setjmp(recover_enter()) == 0 {
            lex_range(start, start + BUFS[text].len, true);
            n = parse_fragment(first, stmts);
        } else {
            n = 0;
            let d = diag(c"error", c"rewrite.pattern");
            buf_str(d, c"the ");
            buf_str(d, what);
            buf_str(d, c" is no tachyon ");
            buf_str(d, if stmts { c"statement" } else { c"expression" });
            buf_str(d, c": ");
            buf_bytes(d, buf_slice(ERR));
            buf_byte(d, '\n');
        }
        recover_leave(depth);
        errors_forget(mark);
        keep_parsed();
        n
    }
}

// ---- Matching ----

fn has_hole(p: i64) -> bool {
    unsafe {
        for i in 0..PAT_HOLES.count {
            let h = PAT_HOLES.data[i];
            if pstart(p) <= pstart(h) && pend(h) <= pend(p) {
                return true;
            }
        }
        false
    }
}

// The type of checked node n as written in --where (no spaces), into a
// new buffer.
fn type_key(t: i64) -> i64 {
    unsafe {
        let out = buf_new();
        let text = buf_new();
        buf_type(text, t);
        let s = buf_slice(text);
        for i in 0..s.len {
            if s[i] != ' ' {
                buf_byte(out, s[i]);
            }
        }
        out
    }
}

// The checked nodes made by the checker (a generic function's
// instances are clones of its body: generics.tach), by span and kind.
static mut CLONES: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

fn span_key(start: i64, end: i64, kind: NodeKind) -> i64 {
    ((start * 128 + kind as i64) * 65536 + (end - start) % 65536) + 1
}

pub fn note_clones(first: i64, last: i64) {
    unsafe {
        for n in first..last {
            let key = span_key(NODES[n].start, NODES[n].end, NODES[n].kind);
            if NODES[n].ty > 0 && CLONES.get(key) == 0 {
                CLONES.put(key, n + 1);
            }
        }
    }
}

// The type the checker gave node n (as parsed): its own, or in a generic
// function, its first instance's; 0 when it was not checked.
fn checked_type(n: i64) -> i64 {
    unsafe {
        if NODES[n].ty > 0 {
            return NODES[n].ty;
        }
        let mut c = CLONES.get(span_key(pstart(n), pend(n), pk(n))) - 1;
        if c < 0 && pk(n) == NodeKind::MethodCall {
            c = CLONES.get(span_key(pstart(n), pend(n), NodeKind::Call)) - 1;
        }
        if c < 0 { 0 } else { NODES[c].ty }
    }
}

// Hole h matches node n (a repeated hole: the same tokens as before).
// Its --where type is checked once the whole pattern matched
// (`types_match`).
fn bind(h: i64, n: i64) -> bool {
    unsafe {
        if H_REST.data[h] != 0 {
            return false;
        }
        if B_NODE.data[h] != -1 {
            return B_NODE.data[h] >= 0
                && same_tokens(B_START.data[h], B_END.data[h], pstart(n), pend(n));
        }
        B_NODE.data[h] = n;
        B_START.data[h] = pstart(n);
        B_END.data[h] = pend(n);
        true
    }
}

// Whether the holes of the site just matched have their --where types
// (counting the sites left out, for the notes).
pub fn types_match() -> bool {
    unsafe {
        for h in 0..H_SYM.count {
            let n = B_NODE.data[h];
            if H_TYPE.data[h] < 0 || n <= 0 || pk(n) == NodeKind::TyName
                || pk(n) == NodeKind::PatBind {
                continue;
            }
            let t = checked_type(n);
            if t <= 0 {
                UNTYPED += 1;
                return false;
            }
            let key = type_key(t);
            if !bytes_eq(buf_slice(key), buf_slice(H_TYPE.data[h])) {
                if TYPE_MISSES == 0 {
                    MISS_NODE = n;
                    MISS_HOLE = h;
                    MISS_TYPE = t;
                }
                TYPE_MISSES += 1;
                return false;
            }
        }
        true
    }
}

// Hole h (`$x...`) matches the elements from..to of node n's list. In a
// block (0.15) its text is all between the elements around them, the
// comments too, spaces trimmed.
fn bind_rest(h: i64, n: i64, from: i64, to: i64) -> bool {
    unsafe {
        let mut s = if from < to { pstart(seq_at(n, from)) } else { -1 };
        let mut e = if from < to { pend(seq_at(n, to - 1)) } else { -1 };
        if from < to && pk(n) == NodeKind::Block {
            s = if from > 0 { pend(seq_at(n, from - 1)) } else { block_open(n) + 1 };
            e = if to < seq_len(n) { pstart(seq_at(n, to)) } else { pend(n) - 1 };
            while s < e && is_space(SRC[s]) {
                s += 1;
            }
            while e > s && is_space(SRC[e - 1]) {
                e -= 1;
            }
        }
        if B_NODE.data[h] != -1 {
            if B_NODE.data[h] == -3 || from == to {
                return B_NODE.data[h] == -3 && from == to;
            }
            return same_tokens(B_START.data[h], B_END.data[h], s, e);
        }
        B_NODE.data[h] = if from < to { -2 } else { -3 };
        B_START.data[h] = s;
        B_END.data[h] = e;
        B_LIST.data[h] = n;
        true
    }
}

// The position of block n's `{` (after `unsafe`).
pub fn block_open(n: i64) -> i64 {
    let mut i = pstart(n);
    while i < pend(n) && unsafe { SRC[i] } != '{' {
        i += 1;
    }
    i
}

fn match_list(p: i64, n: i64) -> bool {
    let np = seq_len(p);
    let nn = seq_len(n);
    let mut v = -1;
    let mut vh = -1;
    for i in 0..np {
        let h = rest_hole_of(seq_at(p, i));
        if h >= 0 {
            v = i;
            vh = h;
            break;
        }
    }
    if v < 0 {
        if np != nn {
            return false;
        }
        for i in 0..np {
            if !match_node(seq_at(p, i), seq_at(n, i)) {
                return false;
            }
        }
        return true;
    }
    let after = np - v - 1;
    if nn < np - 1 {
        return false;
    }
    for i in 0..v {
        if !match_node(seq_at(p, i), seq_at(n, i)) {
            return false;
        }
    }
    for j in 0..after {
        if !match_node(seq_at(p, v + 1 + j), seq_at(n, nn - after + j)) {
            return false;
        }
    }
    bind_rest(vh, n, v, nn - after)
}

// Whether pattern node p matches program node n (binding the holes).
pub fn match_node(p: i64, n: i64) -> bool {
    if p == 0 || n == 0 {
        return p == n;
    }
    let h = hole_of(p);
    if h >= 0 {
        return bind(h, n);
    }
    if !has_hole(p) {
        return same_tokens(pstart(p), pend(p), pstart(n), pend(n));
    }
    let k = pk(p);
    if k != pk(n) {
        return false;
    }
    if k == NodeKind::Binary || k == NodeKind::Assign {
        return pop(p) == pop(n) && match_node(pb(p), pb(n)) && match_node(pc(p), pc(n));
    }
    if k == NodeKind::Unary {
        return pop(p) == pop(n) && match_node(pb(p), pb(n));
    }
    if k == NodeKind::Cast || k == NodeKind::Index || k == NodeKind::Repeat {
        return match_node(pa(p), pa(n)) && match_node(pb(p), pb(n));
    }
    if k == NodeKind::Call {
        return match_node(pa(p), pa(n)) && match_list(p, n);
    }
    if k == NodeKind::MethodCall {
        return pb(p) == pb(n) && same_part(pg(p), pg(n)) && match_node(pa(p), pa(n))
            && match_list(p, n);
    }
    if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
        return pb(p) == pb(n) && match_node(pa(p), pa(n));
    }
    if k == NodeKind::Tuple || k == NodeKind::Array {
        return match_list(p, n);
    }
    if k == NodeKind::Range {
        return pc(p) == pc(n) && match_node(pa(p), pa(n)) && match_node(pb(p), pb(n));
    }
    if k == NodeKind::Return || k == NodeKind::Defer {
        return match_node(pa(p), pa(n));
    }
    if k == NodeKind::Break {
        return pa(p) == pa(n) && match_node(pb(p), pb(n));
    }
    if k == NodeKind::StructLit {
        if pa(p) != pa(n) || !same_part(ph(p), ph(n)) || !same_part(pg(p), pg(n))
            || pcount(p) != pcount(n) {
            return false;
        }
        for i in 0..pcount(p) {
            let a = pchild(p, i);
            let b = pchild(n, i);
            if pa(a) != pa(b) || !match_node(pb(a), pb(b)) {
                return false;
            }
        }
        return true;
    }
    if k == NodeKind::If {
        return match_node(pa(p), pa(n)) && match_node(pb(p), pb(n)) && match_node(pc(p), pc(n));
    }
    if k == NodeKind::While {
        return pa(p) == pa(n) && match_node(pb(p), pb(n)) && match_node(pc(p), pc(n));
    }
    if k == NodeKind::Loop {
        return pa(p) == pa(n) && match_node(pb(p), pb(n));
    }
    if k == NodeKind::Block {
        // (its tail is the last element of match_list's)
        return pflags(p) == pflags(n) && match_list(p, n);
    }
    if k == NodeKind::ExprStmt {
        return pb(p) == pb(n) && match_node(pa(p), pa(n));
    }
    if k == NodeKind::Let {
        return match_node(pa(p), pa(n)) && match_node(pb(p), pb(n)) && match_node(pc(p), pc(n));
    }
    if k == NodeKind::Closure {
        // (0.14: the same parameters, result type and `move`, as written;
        // the body matched)
        if pc(p) != pc(n) || pcount(p) != pcount(n) || !same_part(pb(p), pb(n)) {
            return false;
        }
        for i in 0..pcount(p) {
            if !same_part(pchild(p, i), pchild(n, i)) {
                return false;
            }
        }
        return match_node(pa(p), pa(n));
    }
    // (0.15: loops over iterators, matches, `?`, named arguments,
    // f-strings, patterns with holes)
    if k == NodeKind::For {
        return pa(p) == pa(n) && match_node(pb(p), pb(n)) && match_node(pc(p), pc(n))
            && match_node(pd(p), pd(n));
    }
    if k == NodeKind::Match || k == NodeKind::Interp {
        return match_node(pa(p), pa(n)) && match_list(p, n);
    }
    if k == NodeKind::Arm {
        return match_node(pa(p), pa(n)) && match_node(pb(p), pb(n)) && match_node(pc(p), pc(n));
    }
    if k == NodeKind::Try {
        return match_node(pa(p), pa(n));
    }
    if k == NodeKind::NamedArg {
        return pa(p) == pa(n) && match_node(pb(p), pb(n));
    }
    if k == NodeKind::InterpHole {
        return pb(p) == pb(n) && pc(p) == pc(n) && pd(p) == pd(n) && pflags(p) == pflags(n)
            && match_node(pa(p), pa(n));
    }
    if k == NodeKind::PatTuple || k == NodeKind::PatOr {
        return match_list(p, n);
    }
    if k == NodeKind::PatVariant {
        return pa(p) == pa(n) && pb(p) == pb(n) && pc(p) == pc(n) && match_list(p, n);
    }
    false
}

// Optional parts without holes (type arguments, a path's prefix, a let's
// pattern): both absent, or the same tokens.
fn same_part(p: i64, n: i64) -> bool {
    if p == 0 || n == 0 {
        return p == n;
    }
    same_tokens(pstart(p), pend(p), pstart(n), pend(n))
}

// ---- Replacing ----

// The replacement: its node, its text (SRC[R_START..R_END)), its holes'
// nodes in order, and the level each of its nodes needs.
pub static mut R_ROOT: i64 = 0;
pub static mut R_START: i64 = 0;
pub static mut R_END: i64 = 0;
pub static mut R_HOLES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut R_LEVELS: *i64 = 0 as *i64;
pub static mut P_LEVELS: *i64 = 0 as *i64;
pub static mut STMTS: bool = false;

// (0.15) Per replacement hole (as R_HOLES): the node its text replaces,
// the statement `$s...;` when it is written so, else the hole itself.
pub static mut R_HOLE_SPAN: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Per pattern hole: 1 when the replacement has it.
pub static mut R_KEPT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Sites left because they use a binding the replacement drops: how many,
// and the first one's use and hole.
pub static mut DROPPED: i64 = 0;
pub static mut DROP_USE: i64 = 0;
pub static mut DROP_HOLE: i64 = 0;

// The list node holding replacement node q as an element, and its index
// (-1 when none).
fn list_of(q: i64, index: *i64) -> i64 {
    unsafe {
        for n in 1..PARSED_COUNT {
            if pstart(n) < R_START || pend(n) > R_END {
                continue;
            }
            let k = pk(n);
            if k != NodeKind::Call && k != NodeKind::MethodCall && k != NodeKind::Tuple
                && k != NodeKind::Array {
                continue;
            }
            for i in 0..pcount(n) {
                if pchild(n, i) == q {
                    *index = i;
                    return n;
                }
            }
        }
        -1
    }
}

// The level of what hole h matched (99: arguments).
fn bound_level(h: i64) -> i64 {
    unsafe {
        let n = B_NODE.data[h];
        if n < 0 { 99 } else { binding_level(n) }
    }
}

// The text replacing the site, from the holes' bindings, into a buffer.
pub fn replacement_text() -> i64 {
    unsafe {
        let out = buf_new();
        BREAK_NEXT = 0;
        let mut cur = R_START;
        for i in 0..R_HOLES.count {
            let q = R_HOLES.data[i];
            let h = hole_of(q);
            let at = R_HOLE_SPAN.data[i];
            let mut from = pstart(at);
            let mut to = pend(at);
            if H_REST.data[h] != 0 && B_NODE.data[h] == -3 {
                // (no arguments: the hole goes, with a comma next to it)
                let mut k = 0;
                let list = list_of(q, &k);
                if list >= 0 && pcount(list) > 1 {
                    if k > 0 {
                        from = pend(pchild(list, k - 1));
                    } else {
                        to = pstart(pchild(list, 1));
                    }
                }
                if from < cur {
                    from = cur;
                }
                copy_laid(out, cur, from, false);
                cur = to;
                continue;
            }
            copy_laid(out, cur, from, true);
            let wrap = H_REST.data[h] == 0 && bound_level(h) < R_LEVELS[q];
            if wrap {
                buf_byte(out, '(');
            }
            let text = SRC[B_START.data[h]..B_END.data[h]];
            buf_bytes(out, text);
            if wrap {
                buf_byte(out, ')');
            }
            if at != q && text.len > 0 && text[text.len - 1] != ';' && text[text.len - 1] != '}' {
                // (`$s...;` for statements ending in a tail expression)
                buf_byte(out, ';');
            }
            cur = to;
        }
        copy_laid(out, cur, R_END, true);
        out
    }
}

// (0.15) Where the replacement's lines break when a block of it holding
// a `$s...` stands for a block of the site written on several lines: at
// each of its elements and at its `}`. Per break: its position, the hole,
// 1 at the `}` (else 0), the block's number of elements; by position.
pub static mut R_BREAKS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The first break not yet passed while a site's text is made.
static mut BREAK_NEXT: i64 = 0;

// The breaks of the replacement's nodes first..last.
pub fn note_breaks(first: i64, last: i64) {
    unsafe {
        for n in first..last {
            if pk(n) != NodeKind::Block {
                continue;
            }
            let mut h = -1;
            for i in 0..seq_len(n) {
                let e = rest_hole_of(seq_at(n, i));
                if e >= 0 {
                    h = e;
                }
            }
            if h < 0 {
                continue;
            }
            for i in 0..seq_len(n) + 1 {
                let close = i == seq_len(n);
                R_BREAKS.push(if close { pend(n) - 1 } else { pstart(seq_at(n, i)) });
                R_BREAKS.push(h);
                R_BREAKS.push(close as i64);
                R_BREAKS.push(seq_len(n));
            }
        }
        // (by position: blocks inside blocks)
        let d = R_BREAKS.data;
        let mut i = 4;
        while i < R_BREAKS.count {
            let mut j = i;
            while j > 0 && d[j] < d[j - 4] {
                for f in 0..4 {
                    let t = d[j + f];
                    d[j + f] = d[j - 4 + f];
                    d[j - 4 + f] = t;
                }
                j -= 4;
            }
            i += 4;
        }
    }
}

// Copies the replacement's text from..to into out, its lines broken (see
// R_BREAKS) where the site's block had lines; a break at `to` too when
// `at_end`.
fn copy_laid(out: i64, from: i64, to: i64, at_end: bool) {
    unsafe {
        let mut cur = from;
        while BREAK_NEXT < R_BREAKS.count {
            let k = BREAK_NEXT;
            let at = R_BREAKS.data[k];
            if at > to || (at == to && !at_end) {
                break;
            }
            BREAK_NEXT += 4;
            let h = R_BREAKS.data[k + 1];
            let block = B_LIST.data[h];
            if at < from || block <= 0 || !has_newline(block_open(block), pend(block))
                || (B_NODE.data[h] == -3 && R_BREAKS.data[k + 3] == 1) {
                continue;
            }
            buf_bytes(out, SRC[cur..at]);
            cur = at;
            while BUFS[out].len > 0 && BUFS[out].data[BUFS[out].len - 1] == ' ' {
                BUFS[out].len -= 1;
            }
            buf_byte(out, '\n');
            if R_BREAKS.data[k + 2] != 0 {
                put_indent(out, pend(block) - 1);
            } else if seq_len(block) > 0 {
                put_indent(out, pstart(seq_at(block, 0)));
            } else {
                put_indent(out, pend(block) - 1);
                buf_str(out, c"    ");
            }
        }
        buf_bytes(out, SRC[cur..to]);
    }
}

// Whether SRC[from..to) has a line break.
fn has_newline(from: i64, to: i64) -> bool {
    for i in from..to {
        if unsafe { SRC[i] } == '\n' {
            return true;
        }
    }
    false
}

// Writes the indentation of the line of position pos into buffer out.
fn put_indent(out: i64, pos: i64) {
    unsafe {
        let mut a = pos;
        while a > 0 && SRC[a - 1] != '\n' {
            a -= 1;
        }
        let mut b = a;
        while b < pos && (SRC[b] == ' ' || SRC[b] == '\t') {
            b += 1;
        }
        buf_bytes(out, SRC[a..b]);
    }
}

// (0.15) At the site just matched: an identifier inside what a hole the
// replacement keeps matched, naming the binding (`for $i`, `let $x`) a
// hole it drops matched; 0 when there is none (else its hole in *hole).
// Such a site would lose the binding its code uses.
pub fn dropped_use(program_end: i64, hole: *i64) -> i64 {
    unsafe {
        for h in 0..H_SYM.count {
            let b = B_NODE.data[h];
            if R_KEPT.data[h] != 0 || b <= 0 || pk(b) != NodeKind::PatBind {
                continue;
            }
            let sym = pa(b);
            for n in 1..program_end {
                if pk(n) != NodeKind::Ident || pa(n) != sym {
                    continue;
                }
                for k in 0..H_SYM.count {
                    if R_KEPT.data[k] != 0 && B_NODE.data[k] != -3 && B_START.data[k] <= pstart(n)
                        && pend(n) <= B_END.data[k] {
                        *hole = h;
                        return n;
                    }
                }
            }
        }
        0
    }
}

// The level of the replacement as a whole, at the site being replaced.
pub fn replacement_level() -> i64 {
    let h = hole_of(unsafe { R_ROOT });
    if h >= 0 {
        return bound_level(h);
    }
    binding_level(unsafe { R_ROOT })
}
