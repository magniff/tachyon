// Reading the program's nodes as the parser made them (rewrite and the
// shape refactorings work on them): their fields, their tokens, and how
// tightly an expression binds (where a replacement needs parentheses).

use crate::base::{IntVec, SRC, alloc_array};
use crate::front::ast::{NodeKind, PARSED_COUNT, PARSED_NODES, parsed_child};
use crate::front::lexer::{TOKS, TOK_COUNT, Tok};
use crate::front::parser::exprs::{infix_left_bp, is_comparison};
use crate::tools::query::defs::bytes_eq;
use crate::tools::query::positions::token_at;

// ---- The program as parsed ----
//
// PARSED_NODES holds every node as the parser made it (the program's,
// then the pattern's and the replacement's): these read it.

pub fn pk(n: i64) -> NodeKind {
    unsafe { PARSED_NODES[n].kind }
}

pub fn pa(n: i64) -> i64 {
    unsafe { PARSED_NODES[n].a }
}

pub fn pb(n: i64) -> i64 {
    unsafe { PARSED_NODES[n].b }
}

pub fn pc(n: i64) -> i64 {
    unsafe { PARSED_NODES[n].c }
}

pub fn pd(n: i64) -> i64 {
    unsafe { PARSED_NODES[n].d }
}

pub fn pg(n: i64) -> i64 {
    unsafe { PARSED_NODES[n].g }
}

pub fn ph(n: i64) -> i64 {
    unsafe { PARSED_NODES[n].h }
}

pub fn pflags(n: i64) -> i64 {
    unsafe { PARSED_NODES[n].p }
}

pub fn pop(n: i64) -> Tok {
    unsafe { PARSED_NODES[n].op }
}

pub fn pcount(n: i64) -> i64 {
    unsafe { PARSED_NODES[n].count }
}

pub fn pchild(n: i64, i: i64) -> i64 {
    parsed_child(n, i)
}

pub fn pstart(n: i64) -> i64 {
    unsafe { PARSED_NODES[n].start }
}

pub fn pend(n: i64) -> i64 {
    unsafe { PARSED_NODES[n].end }
}

// Whether SRC[a0..a1) and SRC[b0..b1) have the same tokens (comments and
// spacing aside).
pub fn same_tokens(a0: i64, a1: i64, b0: i64, b1: i64) -> bool {
    unsafe {
        let mut i = token_at(a0);
        let mut j = token_at(b0);
        loop {
            let more_a = i < TOK_COUNT && TOKS[i].kind != Tok::Eof && TOKS[i].start < a1;
            let more_b = j < TOK_COUNT && TOKS[j].kind != Tok::Eof && TOKS[j].start < b1;
            if !more_a || !more_b {
                return more_a == more_b;
            }
            if TOKS[i].kind != TOKS[j].kind
                || !bytes_eq(SRC[TOKS[i].start..TOKS[i].end], SRC[TOKS[j].start..TOKS[j].end]) {
                return false;
            }
            i += 1;
            j += 1;
        }
    }
}

// Whether node n's text is in parentheses of its own: `(a + b)` (the
// parser widens a parenthesized expression's span to its parentheses).
pub fn parenthesized(n: i64) -> bool {
    unsafe {
        let k = pk(n);
        if k == NodeKind::Tuple || k == NodeKind::Unit {
            return false;
        }
        let s = pstart(n);
        let e = pend(n);
        if e - s < 2 || SRC[s] != '(' || SRC[e - 1] != ')' {
            return false;
        }
        let mut i = token_at(s);
        let mut depth = 0;
        while i < TOK_COUNT && TOKS[i].start < e {
            let t = TOKS[i].kind;
            if t == Tok::LParen || t == Tok::LBracket || t == Tok::LBrace {
                depth += 1;
            } else if t == Tok::RParen || t == Tok::RBracket || t == Tok::RBrace {
                depth -= 1;
                if depth == 0 {
                    return TOKS[i].start == e - 1;
                }
            }
            i += 1;
        }
        false
    }
}

// How tightly expression n binds (the binding power levels of
// docs/grammar.md): 1 an assignment, 2 a range, 3 to 11 the binary
// operators, 12 a cast, 13 a prefix operator, 99 a postfix expression,
// a primary or anything in parentheses; 0 `return`, `break`.
pub fn binding_level(n: i64) -> i64 {
    let k = pk(n);
    if parenthesized(n) {
        return 99;
    }
    if k == NodeKind::Binary {
        return infix_left_bp(pop(n)) / 2;
    }
    if k == NodeKind::Assign {
        return 1;
    }
    if k == NodeKind::Range {
        return 2;
    }
    if k == NodeKind::Cast {
        return 12;
    }
    if k == NodeKind::Unary {
        return 13;
    }
    if k == NodeKind::Return || k == NodeKind::Break || k == NodeKind::Continue {
        return 0;
    }
    99
}

// The expressions inside node n, each with the binding level an
// expression needs there to stand without parentheses.
pub fn expr_slots(n: i64, kids: *IntVec, levels: *IntVec) {
    unsafe {
        let k = pk(n);
        if k == NodeKind::Binary {
            let lv = infix_left_bp(pop(n)) / 2;
            kids.push(pb(n));
            levels.push(if is_comparison(pop(n)) { lv + 1 } else { lv });
            kids.push(pc(n));
            levels.push(lv + 1);
        } else if k == NodeKind::Assign {
            kids.push(pb(n));
            levels.push(13);
            kids.push(pc(n));
            levels.push(1);
        } else if k == NodeKind::Range {
            kids.push(pa(n));
            levels.push(3);
            kids.push(pb(n));
            levels.push(3);
        } else if k == NodeKind::Unary {
            kids.push(pb(n));
            levels.push(13);
        } else if k == NodeKind::Cast {
            kids.push(pa(n));
            levels.push(12);
        } else if k == NodeKind::Call || k == NodeKind::MethodCall {
            kids.push(pa(n));
            levels.push(99);
            for i in 0..pcount(n) {
                kids.push(pchild(n, i));
                levels.push(0);
            }
        } else if k == NodeKind::Index {
            kids.push(pa(n));
            levels.push(99);
            kids.push(pb(n));
            levels.push(0);
        } else if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
            kids.push(pa(n));
            levels.push(99);
        }
        else if k == NodeKind::Tuple || k == NodeKind::Array || k == NodeKind::StructLit
            || k == NodeKind::Match {
            if k == NodeKind::Match {
                kids.push(pa(n));
                levels.push(0);
            }
            for i in 0..pcount(n) {
                kids.push(pchild(n, i));
                levels.push(0);
            }
        } else if k == NodeKind::Block {
            for i in 0..pcount(n) {
                kids.push(pchild(n, i));
                levels.push(0);
            }
            kids.push(pa(n));
            levels.push(0);
        } else if k == NodeKind::FieldInit || k == NodeKind::ExprStmt || k == NodeKind::Defer {
            kids.push(if k == NodeKind::FieldInit { pb(n) } else { pa(n) });
            levels.push(0);
        }
        else if k == NodeKind::Repeat || k == NodeKind::If || k == NodeKind::Let
            || k == NodeKind::Arm || k == NodeKind::While || k == NodeKind::For
            || k == NodeKind::Loop
            || k == NodeKind::Return
            || k == NodeKind::Break {
            // (a, b, c, d: the expressions of each, in order; a Let's
            // pattern and type, a loop's label are not)
            if k == NodeKind::Repeat || k == NodeKind::If || k == NodeKind::Return {
                kids.push(pa(n));
                levels.push(0);
            }
            if k == NodeKind::Repeat || k == NodeKind::If || k == NodeKind::Arm
                || k == NodeKind::While
                || k == NodeKind::Loop || k == NodeKind::Break {
                kids.push(pb(n));
                levels.push(0);
            }
            if k == NodeKind::If || k == NodeKind::Let || k == NodeKind::Arm || k == NodeKind::While
                || k == NodeKind::For {
                kids.push(pc(n));
                levels.push(0);
            }
            if k == NodeKind::For {
                kids.push(pd(n));
                levels.push(0);
            }
        }
    }
}

// The level each node of first..last needs where it is (0 when it is in
// no expression of them), indexed by node.
pub fn slot_levels(first: i64, last: i64) -> *i64 {
    unsafe {
        let levels = alloc_array::<i64>(PARSED_COUNT + 1);
        let mut kids = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut lv = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for n in first..last {
            kids.count = 0;
            lv.count = 0;
            expr_slots(n, &kids, &lv);
            for i in 0..kids.count {
                let c = kids.data[i];
                if c > 0 && c < PARSED_COUNT {
                    levels[c] = lv.data[i];
                }
            }
        }
        levels
    }
}
