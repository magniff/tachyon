// The text of inline: names, lines and indentation of the code it copies,
// and the paths and words it reads.

use crate::base::{BUFS, IntVec, SYMS, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, intern};
use crate::front::lexer::{TOKS, TOK_COUNT, Tok};
use crate::tools::query::c_slice;
use crate::tools::query::positions::token_at;
use crate::tools::refactor_shape::inline::{BODY_FREE, BODY_LOCALS, P_NAME};
use crate::tools::rewrite::parsed::{pend, pstart};

// s from its first character that is not a blank.
pub fn skip_indent(s: [u8]) -> [u8] {
    var i = 0;
    while i < s.len && (s[i] == ' ' || s[i] == '\t') {
        i += 1;
    }
    s[i..s.len]
}

// Whether text is a place written with names, `.` and digits (`a.b.0`).
pub fn place_path(s: [u8]) -> bool {
    for i in 0..s.len {
        let c = s[i];
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
            || c == '.') {
            return false;
        }
    }
    s.len > 0
}

// Whether `name` is a word of an argument's text.
pub fn named_in_args(args: IntVec, name: [u8]) -> bool {
    unsafe {
        for i in 0..args.count {
            let a = args.data[i];
            var t = token_at(pstart(a));
            while t < TOK_COUNT && TOKS[t].start < pend(a) {
                if TOKS[t].kind == Tok::Ident && bytes_eq_sym(TOKS[t].value as i64, name) {
                    return true;
                }
                t += 1;
            }
        }
        false
    }
}

fn bytes_eq_sym(sym: i64, s: [u8]) -> bool {
    unsafe {
        let t = SYMS[sym].text;
        if t.len != s.len {
            return false;
        }
        for i in 0..s.len {
            if t[i] != s[i] {
                return false;
            }
        }
        true
    }
}

// `NAME_2`, `NAME_3`... the first that no argument, body local or other
// name of the body has (`self`: `this`, then `this_2`...).
pub fn fresh_name(name: [u8], args: IntVec) -> [u8] {
    unsafe {
        let base = if bytes_is(name, c"self") { c_slice(c"this") } else { name };
        var k = 1;
        loop {
            let b = buf_new();
            buf_bytes(b, base);
            if k > 1 {
                buf_byte(b, '_');
                buf_int(b, k);
            }
            let s = buf_slice(b);
            let sym = intern(s);
            var taken = named_in_args(args, s);
            for i in 0..BODY_LOCALS.count {
                if BODY_LOCALS.data[i] == sym {
                    taken = true;
                }
            }
            for i in 0..BODY_FREE.count {
                if BODY_FREE.data[i] == sym {
                    taken = true;
                }
            }
            for i in 0..P_NAME.count {
                if P_NAME.data[i] == sym {
                    taken = true;
                }
            }
            if !taken {
                return s;
            }
            k += 1;
        }
    }
}

// The lines of text s after its first, their first `from` columns of
// indentation replaced by `to` (the first line as it is), into out.
pub fn shift_lines(out: i64, s: [u8], from: i64, to: [u8]) {
    var i = 0;
    var first = true;
    while i < s.len {
        var e = i;
        while e < s.len && s[e] != '\n' {
            e += 1;
        }
        if first {
            buf_bytes(out, s[i..e]);
        } else {
            var a = i;
            while a < e && a - i < from && (s[a] == ' ' || s[a] == '\t') {
                a += 1;
            }
            if a < e {
                buf_bytes(out, to);
            }
            buf_bytes(out, s[a..e]);
        }
        if e < s.len {
            buf_byte(out, '\n');
        }
        first = false;
        i = e + 1;
    }
}

// s without its first and last blank lines.
pub fn trim_blank_lines(s: [u8]) -> [u8] {
    var a = 0;
    var i = 0;
    while i < s.len && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') {
        if s[i] == '\n' {
            a = i + 1;
        }
        i += 1;
    }
    var b = s.len;
    while b > a && (s[b - 1] == ' ' || s[b - 1] == '\t' || s[b - 1] == '\n' || s[b - 1] == '\r') {
        b -= 1;
    }
    s[a..b]
}

// FILE:LINE into *file (a C string) and *line.
pub fn file_line(s: [u8], file: **u8, line: inout i64) -> bool {
    unsafe {
        var c = s.len - 1;
        while c > 0 && s[c] != ':' {
            c -= 1;
        }
        if c <= 0 || c == s.len - 1 {
            return false;
        }
        var n = 0;
        for i in c + 1..s.len {
            if s[i] < '0' || s[i] > '9' {
                return false;
            }
            n = n * 10 + (s[i] - '0') as i64;
        }
        let b = buf_new();
        buf_bytes(b, s[0..c]);
        buf_byte(b, 0);
        *file = BUFS[b].data;
        line = n;
        n > 0
    }
}

// Whether path ends with suffix (at a `/`, or whole): `src/calc.vl`
// ends with `calc.vl`, `./calc.vl` too.
pub fn ends_with(path: *u8, suffix: [u8]) -> bool {
    unsafe {
        let p = c_slice(path);
        var s = suffix;
        while s.len > 2 && s[0] == '.' && s[1] == '/' {
            s = s[2..s.len];
        }
        if p.len < s.len {
            return false;
        }
        let off = p.len - s.len;
        for i in 0..s.len {
            if p[off + i] != s[i] {
                return false;
            }
        }
        off == 0 || p[off - 1] == '/'
    }
}

pub fn contains(v: IntVec, x: i64) -> bool {
    unsafe {
        for i in 0..v.count {
            if v.data[i] == x {
                return true;
            }
        }
        false
    }
}

pub fn bytes_is(s: [u8], c: *u8) -> bool {
    unsafe { bytes_eq_sym(intern(c_slice(c)), s) }
}
