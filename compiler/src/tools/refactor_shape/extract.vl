// `refactor extract-function FN --lines A-B --to NEW` (0.13): the
// statements of lines A to B of function FN become a new function NEW,
// after FN, called where they were.
//
// Its parameters are the locals of FN the lines use and do not declare,
// in the order they are first used: by value; `mut` and given back when
// the lines assign them; by reference (`x: &mut T`, called with `&mut x`,
// the lines' `&x` then `x`) when the lines only take their address or write
// their fields (`v.push(1)`, `p.x = 0`). Its result: the one local the
// lines declare and FN uses after them (`let x = NEW(...);`), or several
// as a tuple (`let (a, b) = NEW(...);`), or a local declared before them
// that they assign (`x = NEW(...);`), or the value the lines end the
// block with. Inside unsafe code its body is an unsafe block; in a method
// using `self`, it is a method of the same impl (`self.NEW(...)`).
//
// Refused: lines that are not whole statements of one block
// (refactor.range), control flow leaving them (`return`, a `break` or
// `continue` of a loop around them, a `defer`: refactor.escapes), results
// it cannot give back (refactor.results), a generic function
// (refactor.generic).

use crate::base::{
    BUFS, FILES, IntVec, SRC, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, intern,
};
use crate::front::ast::{DEFER_IMPLICIT, NODES, NODE_COUNT, NodeKind, child};
use crate::front::check::LOCALS;
use crate::front::modules::file_of_pos;
use crate::front::types::{REF_MUT, TYPES, TY_NEVER, TY_UNIT, TyKind, buf_type, is_pointer};
use crate::tools::edit::edit_replace;
use crate::tools::edit::apply::{apply_edit, set_command};
use crate::tools::edit::items::{after_line, indent_of};
use crate::tools::fixconv::{new_spelling, put_type_conv};
use crate::tools::query::{c_slice, root_or_diag};
use crate::tools::query::defs::{DEFS, DEF_COUNT, K_FN, K_IMPL_METHOD, K_METHOD};
use crate::tools::query::diagnostics::{
    PROG, ROOT_GIVEN, TOOL, diag, diags, put_cword, put_root, put_word, try_end, write_diags,
};
use crate::tools::query::positions::{LINES, line_index, line_of, put_path};
use crate::tools::refactor_mod::cli::is_ident;
use crate::tools::refactor_shape::{SUB, load_and_find, opt, sym_text, take_args, usage_error};
use crate::tools::refactor_shape::body::{
    USE_ADDR, USE_ASSIGN, USE_AUTOREF, USE_FIELD_READ, USE_FIELD_WRITE, USE_VALUE, captured_by_move,
    closure_around, decl_of, has_closure, in_body, in_unsafe, load_body, local_mut, local_name,
    local_of, parent, put_local_type, reindent, text_with, use_kind,
};

// How a local the lines use is passed (mode of each parameter).
const BY_VALUE: i64 = 0;
const BY_POINTER: i64 = 1;
const GIVEN_BACK: i64 = 2;

pub fn run_extract(argc: i64, argv: **u8) -> i64 {
    let status = extract_inner(argc, argv);
    write_diags();
    status
}

fn extract_inner(argc: i64, argv: **u8) -> i64 {
    unsafe {
        set_command(argc, argv);
        PROG = argv[0];
        TOOL = c"refactor";
        SUB = c"extract-function";
        var root = 0 as *u8;
        var words = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var opts = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let example = c"FN --lines 12-18 --to NEW --dry-run";
        if !take_args(argc, argv, c"--lines=1 --to=1", &root, &words, &opts) {
            return 2;
        }
        if words.count != 1 {
            return usage_error(if words.count == 0 { c"a function FN is needed" }
                else { c"one FN at a time" }, example);
        }
        let lines = opt(opts, c"--lines", false);
        let to = opt(opts, c"--to", false);
        if lines == 0 as *u8 || to == 0 as *u8 {
            return usage_error(c"--lines A-B (lines of FN's file) and --to NEW are needed",
                example);
        }
        var la = 0;
        var lb = 0;
        if !line_range(c_slice(lines), &la, &lb) {
            return usage_error(c"--lines takes A-B, line numbers of FN's file (A-A: one line)",
                example);
        }
        let new_name = c_slice(to);
        if !is_ident(new_name) {
            return usage_error(c"NEW must be an identifier (not a keyword)", example);
        }
        let name = c_slice(words.data[0] as *u8);
        ROOT_GIVEN = root;
        root = root_or_diag(root, SUB, name, true);
        if root == 0 as *u8 {
            return 2;
        }
        var status = 0;
        let d = load_and_find(root, name, (1 << K_FN) | (1 << K_METHOD) | (1 << K_IMPL_METHOD),
            c"function", &status);
        if d < 0 {
            return status;
        }
        let f = DEFS[d].node;
        let body = NODES[f].c;
        let fqn = sym_text(DEFS[d].fqn);
        if body <= 0 {
            let e = diag(c"error", c"refactor.kind");
            buf_bytes(e, fqn);
            buf_str(e, c" has no body\n");
            return 1;
        }
        if NODES[f].g != 0 || NODES[f].h != 0 && NODES[NODES[f].h].g != 0 {
            let e = diag(c"error", c"refactor.generic");
            buf_bytes(e, fqn);
            buf_str(e, c" is generic: its body is checked once per instance; extract by hand\n");
            return 1;
        }
        let file = file_of_pos(DEFS[d].start);
        let first_line = line_index(FILES[file].start);
        let file_lines = line_index(FILES[file].end - 1) - first_line + 1;
        // (0.17: past the file's end, the body's lines are the help)
        let past = lb > file_lines;
        let ra = if past { 0 } else { LINES.data[first_line + la - 1] };
        let rb = if past { 0 } else { after_line(LINES.data[first_line + lb - 1]) };
        if past || ra <= NODES[body].start || rb > NODES[body].end {
            let e = diag(c"error", c"refactor.range");
            buf_str(e, c"lines ");
            put_range(e, la, lb);
            buf_str(e, c" are not inside the body of ");
            buf_bytes(e, fqn);
            buf_str(e, c" (lines ");
            put_range(e, line_of(NODES[body].start), line_of(NODES[body].end - 1));
            buf_str(e, c")\n");
            try_show(fqn);
            return 1;
        }
        load_body(f);
        // The innermost block around the lines, and its statements in them.
        var blk = -1;
        for n in 1..NODE_COUNT {
            if NODES[n].kind == NodeKind::Block && in_body(n) && NODES[n].start < ra
                && NODES[n].end >= rb
                && (blk < 0 || NODES[n].end - NODES[n].start < NODES[blk].end - NODES[blk].start) {
                blk = n;
            }
        }
        if blk < 0 {
            blk = body;
        }
        var stmts = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var tail = -1;
        let nst = NODES[blk].count;
        for i in 0..nst + 1 {
            let s = if i < nst { child(blk, i) } else { NODES[blk].a };
            if s <= 0 || NODES[s].end <= ra || NODES[s].start >= rb {
                continue;
            }
            if NODES[s].start < ra || NODES[s].end > rb {
                return cut_statement(fqn, name, new_name, la, lb, s);
            }
            // (a value of type () ending the block is a statement here)
            if i < nst || NODES[s].ty == TY_UNIT || NODES[s].ty == TY_NEVER {
                stmts.push(s);
            } else {
                tail = s;
            }
        }
        if stmts.count == 0 && tail < 0 {
            let e = diag(c"error", c"refactor.range");
            buf_str(e, c"no statement of ");
            buf_bytes(e, fqn);
            buf_str(e, c" is in lines ");
            put_range(e, la, lb);
            buf_byte(e, '\n');
            try_show(fqn);
            return 1;
        }
        let sa = if stmts.count > 0 { NODES[stmts.data[0]].start } else { NODES[tail].start };
        let sb = if tail >= 0 { NODES[tail].end } else { NODES[stmts.data[stmts.count - 1]].end };
        // (code of the lines outside the statements: a brace of the block)
        var p = ra;
        while p < rb {
            let c = SRC[p];
            if (p < sa || p >= sb) && c != ' ' && c != '\t' && c != '\n' && c != '\r'
                && !(c == ';' && p == sb) {
                if c == '/' && SRC[p + 1] == '/' {
                    p = after_line(p);
                    continue;
                }
                let e = diag(c"error", c"refactor.range");
                buf_str(e, c"line ");
                buf_int(e, line_of(p));
                buf_str(e, c" has code outside the statements of lines ");
                put_range(e, line_of(sa), line_of(sb - 1));
                buf_byte(e, '\n');
                try_extract(name, new_name, line_of(sa), line_of(sb - 1));
                return 1;
            }
            p += 1;
        }
        // Control flow leaving the lines.
        for n in 1..NODE_COUNT {
            if !in_body(n) || NODES[n].start < sa || NODES[n].end > sb {
                continue;
            }
            let k = NODES[n].kind;
            // (0.14: control flow inside a closure of the lines stays in it)
            let c = closure_around(n);
            if c >= 0 && NODES[c].start >= sa {
                continue;
            }
            var what = 0 as *u8;
            if k == NodeKind::Return {
                what = c"returns from ";
            } else if k == NodeKind::Try {
                // (0.15: `e?` returns from the function when e is None or Err)
                what = c"may return (`?`) from ";
            } else if k == NodeKind::Defer && (NODES[n].p & DEFER_IMPLICIT) == 0 {
                // (a drop the checker placed moves with its binding)
                what = c"defers to the end of a block of ";
            } else if (k == NodeKind::Break || k == NodeKind::Continue) && !loop_inside(n, sa, sb) {
                what = if k == NodeKind::Break { c"breaks out of a loop of " }
                    else { c"continues a loop of " };
            }
            if what != 0 as *u8 {
                let e = diag(c"error", c"refactor.escapes");
                buf_str(e, c"line ");
                buf_int(e, line_of(NODES[n].start));
                buf_byte(e, ' ');
                buf_str(e, what);
                buf_bytes(e, fqn);
                buf_str(e, c": out of lines ");
                put_range(e, la, lb);
                buf_str(e, c", which NEW cannot do for its caller\n");
                let before = statements_before(stmts, NODES[n].start);
                if before >= la {
                    try_extract(name, new_name, la, before);
                } else {
                    try_show_at(file, line_of(NODES[n].start));
                }
                return 1;
            }
        }
        // The locals: the parameters (declared before the lines), the
        // results (declared in them and used after, or assigned in them).
        var params = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var modes = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var results = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var self_local = -1;
        var amp_s = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var amp_e = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var amp_t = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for n in 1..NODE_COUNT {
            let l = local_of(n);
            if l < 0 || !in_body(n) || NODES[n].start < sa || NODES[n].end > sb {
                continue;
            }
            let dn = decl_of(l);
            if dn >= 0 && NODES[dn].start >= sa && NODES[dn].start < sb {
                continue;
            }
            if bytes_is(local_name(l), c"self") {
                self_local = l;
                continue;
            }
            if contains(params, l) {
                continue;
            }
            params.push(l);
            modes.push(mode_of(l, sa, sb));
        }
        // (the locals declared in the lines and used after them, in order)
        for n in 1..NODE_COUNT {
            if NODES[n].kind == NodeKind::PatBind && in_body(n) && NODES[n].start >= sa
                && NODES[n].end <= sb
                && used_after(NODES[n].x, sb) && !contains(results, NODES[n].x) {
                results.push(NODES[n].x);
            }
        }
        // (in the order of first use: they were found in node order)
        sort_by_first_use(&params, &modes, sa, sb);
        // (0.14: a closure's type has no name: NEW cannot take or give one)
        for i in 0..params.count + results.count + 1 {
            var l = -1;
            var t = 0;
            if i < params.count {
                l = params.data[i];
                t = LOCALS[l].ty;
            } else if i < params.count + results.count {
                l = results.data[i - params.count];
                t = LOCALS[l].ty;
            } else if tail >= 0 {
                t = NODES[tail].ty;
            }
            if !has_closure(t, 0) {
                continue;
            }
            let e = diag(c"error", c"refactor.closure");
            buf_str(e, c"lines ");
            put_range(e, la, lb);
            if i < params.count {
                buf_str(e, c" use '");
                buf_bytes(e, local_name(l));
                buf_str(e, c"', a closure made before them");
            } else if l >= 0 {
                buf_str(e, c" make '");
                buf_bytes(e, local_name(l));
                buf_str(e, c"', a closure used after them");
            } else {
                buf_str(e, c" end the block with a closure");
            }
            buf_str(e, c"; a closure's type has no name for NEW's signature\n");
            let dn = if i < params.count { decl_of(l) } else { -1 };
            // (made by a `let` of the same block: extract from there)
            if dn >= 0 && parent(dn) >= 0 && parent(parent(dn)) == blk {
                try_extract(name, new_name, line_of(NODES[dn].start), lb);
            } else {
                try_show_at(file, la);
            }
            return 1;
        }
        var back = 0;
        for i in 0..params.count {
            if modes.data[i] == GIVEN_BACK {
                back += 1;
                results.push(params.data[i]);
            }
            if modes.data[i] == BY_POINTER {
                // (`&x` in the lines is `x`, a pointer there)
                for n in 1..NODE_COUNT {
                    if local_of(n) == params.data[i] && in_body(n) && NODES[n].start >= sa
                        && NODES[n].end <= sb
                        && use_kind(n) == USE_ADDR {
                        let u = parent(n);
                        amp_s.push(NODES[u].start);
                        amp_e.push(NODES[n].start);
                        amp_t.push(buf_new());
                    }
                }
            }
        }
        if (back > 0 && results.count > 1) || (tail >= 0 && results.count > 0) {
            let e = diag(c"error", c"refactor.results");
            buf_str(e, c"lines ");
            put_range(e, la, lb);
            buf_str(e,
                if tail >= 0 { c" end the block with its value and set " } else { c" set " });
            for i in 0..results.count {
                buf_str(e, if i == 0 { c"" } else { c", " });
                buf_bytes(e, local_name(results.data[i]));
            }
            buf_str(e,
                c", used after them; NEW gives back one local it assigns, or the ones it declares\n");
            try_show_at(file, la);
            return 1;
        }
        let kind = DEFS[d].kind;
        if self_local >= 0 && kind != K_METHOD {
            let e = diag(c"error", c"refactor.self");
            buf_str(e, c"lines ");
            put_range(e, la, lb);
            buf_str(e, c" use self in a trait impl's function: NEW cannot be a method there\n");
            return 1;
        }
        if taken_name(d, intern(new_name), self_local >= 0) {
            let e = diag(c"error", c"refactor.collision");
            buf_str(e, c"'");
            buf_bytes(e, new_name);
            buf_str(e, c"' is already a name there\n");
            try_query(c"def", new_name);
            return 1;
        }
        // NEW's text, after FN (a method: in its impl, else after it).
        let method = self_local >= 0;
        let outer = if kind == K_FN || method { f } else { DEFS[d].impl_node };
        let base = if method { indent_of(NODES[f].start) } else { indent_of(NODES[outer].start) };
        let text = buf_new();
        buf_byte(text, '\n');
        buf_bytes(text, base);
        buf_str(text, c"fn ");
        buf_bytes(text, new_name);
        buf_byte(text, '(');
        if method {
            let sp = decl_of(self_local);
            if (NODES[sp].p & crate::front::ast::CONV_NEW) != 0 {
                // (0.20: the receiver as written, `self`, `inout self`)
                buf_bytes(text, SRC[NODES[sp].start..NODES[sp].end]);
            } else {
                buf_str(text, c"self: ");
                buf_bytes(text, SRC[NODES[NODES[sp].b].start..NODES[NODES[sp].b].end]);
            }
        }
        for i in 0..params.count {
            if i > 0 || method {
                buf_str(text, c", ");
            }
            // (0.20: in 0.20's spelling, but in the crate read in 0.19's,
            // fixconv::new_spelling: `x: sink T`, `x: inout T`)
            let new = new_spelling();
            if modes.data[i] == GIVEN_BACK && !new {
                buf_str(text, c"mut ");
            }
            buf_bytes(text, local_name(params.data[i]));
            buf_str(text, c": ");
            if modes.data[i] == GIVEN_BACK && new {
                buf_str(text, c"sink ");
            }
            if modes.data[i] == BY_POINTER {
                // (0.18.1: a reference; a `*T` is raw)
                buf_str(text, if new { c"inout " } else { c"&mut " });
            }
            put_local_type(text, params.data[i]);
        }
        buf_byte(text, ')');
        let result_type = buf_new();
        if results.count == 1 {
            put_local_type(result_type, results.data[0]);
        } else if results.count > 1 {
            buf_byte(result_type, '(');
            for i in 0..results.count {
                buf_str(result_type, if i == 0 { c"" } else { c", " });
                put_local_type(result_type, results.data[i]);
            }
            buf_byte(result_type, ')');
        }
        else if tail >= 0 && NODES[tail].ty != TY_UNIT && NODES[tail].ty != TY_NEVER
            && NODES[tail].ty != 0 {
            put_type_conv(result_type, NODES[tail].ty, false);
        }
        if BUFS[result_type].len > 0 {
            buf_str(text, c" -> ");
            buf_bytes(text, buf_slice(result_type));
        }
        buf_str(text, c" {\n");
        let inner = buf_new();
        buf_bytes(inner, base);
        buf_str(inner, c"    ");
        let unsafe_wrap = in_unsafe(f, if stmts.count > 0 { stmts.data[0] } else { tail });
        if unsafe_wrap {
            buf_bytes(text, buf_slice(inner));
            buf_str(text, c"unsafe {\n");
            buf_str(inner, c"    ");
        }
        let lines_text = text_with(ra, rb, amp_s, amp_e, amp_t);
        reindent(text, buf_slice(lines_text), buf_slice(inner));
        if results.count > 0 {
            buf_bytes(text, buf_slice(inner));
            put_results(text, results, false, 0);
            buf_byte(text, '\n');
        }
        if unsafe_wrap {
            buf_bytes(text, base);
            buf_str(text, c"    }\n");
        }
        buf_bytes(text, base);
        buf_str(text, c"}\n");
        // The call, where the lines were.
        let call = buf_new();
        buf_bytes(call, indent_of(sa));
        if results.count == 1 && back == 1 {
            buf_bytes(call, local_name(results.data[0]));
            buf_str(call, c" = ");
        } else if results.count > 0 {
            let pat = buf_new();
            put_results(pat, results, true, sb);
            let ps = buf_slice(pat);
            if new_spelling() && ps.len > 4 && ps[0] == 'm' && ps[1] == 'u' && ps[2] == 't'
                && ps[3] == ' ' {
                // (0.20: `var x = ..`; in a tuple `let (var a, b) = ..`)
                buf_str(call, c"var ");
                buf_bytes(call, ps[4..ps.len]);
            } else {
                buf_str(call, c"let ");
                buf_bytes(call, ps);
            }
            buf_str(call, c" = ");
        }
        if method {
            buf_str(call, c"self.");
        }
        buf_bytes(call, new_name);
        buf_byte(call, '(');
        for i in 0..params.count {
            buf_str(call, if i == 0 { c"" } else { c", " });
            if modes.data[i] == BY_POINTER {
                buf_str(call, if new_spelling() { c"&" } else { c"&mut " });
            } else if new_spelling() && LOCALS[params.data[i]].ty > 0
                && TYPES[LOCALS[params.data[i]].ty].kind == TyKind::Ptr
                && TYPES[LOCALS[params.data[i]].ty].b == REF_MUT && access_local(params.data[i]) {
                // (an inout binding or parameter passed on is lent again)
                buf_str(call, c"&");
            }
            buf_bytes(call, local_name(params.data[i]));
        }
        buf_byte(call, ')');
        if tail < 0 {
            buf_byte(call, ';');
        }
        buf_byte(call, '\n');
        edit_replace(ra, rb, call);
        let at = after_line(NODES[outer].end - 1);
        edit_replace(at, at, text);
        let what = buf_new();
        buf_str(what, c"extracted lines ");
        put_range(what, la, lb);
        buf_str(what, c" of ");
        buf_bytes(what, fqn);
        buf_str(what, c" into ");
        buf_bytes(what, new_name);
        buf_byte(what, '(');
        for i in 0..params.count {
            buf_str(what, if i == 0 { c"" } else { c", " });
            buf_bytes(what, local_name(params.data[i]));
        }
        buf_byte(what, ')');
        if BUFS[result_type].len > 0 {
            buf_str(what, c" -> ");
            buf_bytes(what, buf_slice(result_type));
        }
        apply_edit(buf_slice(what), root)
    }
}

// `A-B` (or `A`) into *a, *b: line numbers, 1 <= A <= B.
fn line_range(s: [u8], a: inout i64, b: inout i64) -> bool {
    var i = 0;
    var x = 0;
    while i < s.len && s[i] >= '0' && s[i] <= '9' {
        x = x * 10 + (s[i] - '0') as i64;
        i += 1;
    }
    var y = x;
    if i < s.len && s[i] == '-' {
        i += 1;
        let from = i;
        y = 0;
        while i < s.len && s[i] >= '0' && s[i] <= '9' {
            y = y * 10 + (s[i] - '0') as i64;
            i += 1;
        }
        if i == from {
            return false;
        }
    }
    unsafe {
        a = x;
        b = y;
    }
    i == s.len && x >= 1 && y >= x
}

fn put_range(out: i64, a: i64, b: i64) {
    buf_int(out, a);
    buf_byte(out, '-');
    buf_int(out, b);
}

// How the lines [sa, sb) use local l, declared before them: given back
// when they assign it (or use its value and take its address), by
// pointer when they only take its address or write its fields, else by
// value.
fn mode_of(l: i64, sa: i64, sb: i64) -> i64 {
    unsafe {
        var assign = false;
        var address = false;
        var value = false;
        // (an array indexed: by pointer, `a[i]` would index the pointer)
        var indexed = false;
        for n in 1..NODE_COUNT {
            if local_of(n) != l || !in_body(n) || NODES[n].start < sa || NODES[n].end > sb {
                continue;
            }
            let p = parent(n);
            if p >= 0 && NODES[p].kind == NodeKind::Index && NODES[p].a == n
                && !is_pointer(NODES[n].ty) {
                indexed = true;
            }
            // (0.14: a `move` closure changes its own copy)
            let k = if captured_by_move(n) { USE_VALUE } else { use_kind(n) };
            if k == USE_ASSIGN {
                assign = true;
            } else if k == USE_ADDR || k == USE_AUTOREF || k == USE_FIELD_WRITE {
                address = true;
            } else if k == USE_VALUE {
                value = true;
            }
        }
        if assign || (address && (value || indexed)) {
            GIVEN_BACK
        } else if address {
            BY_POINTER
        } else {
            BY_VALUE
        }
    }
}

// Whether local l is used at or after position pos.
fn used_after(l: i64, pos: i64) -> bool {
    unsafe {
        for n in 1..NODE_COUNT {
            if local_of(n) == l && in_body(n) && NODES[n].start >= pos {
                return true;
            }
        }
        false
    }
}

// Whether the loop break or continue n leaves is inside [sa, sb).
fn loop_inside(n: i64, sa: i64, sb: i64) -> bool {
    unsafe {
        let label = NODES[n].a;
        var q = parent(n);
        while q >= 0 {
            let k = NODES[q].kind;
            if (k == NodeKind::Loop || k == NodeKind::While || k == NodeKind::For)
                && (label == 0 || NODES[q].a == label) {
                return NODES[q].start >= sa && NODES[q].end <= sb;
            }
            q = parent(q);
        }
        false
    }
}

// The last line of the statements of stmts before the one holding pos;
// -1 when that is the first.
fn statements_before(stmts: IntVec, pos: i64) -> i64 {
    unsafe {
        var last = -1;
        for i in 0..stmts.count {
            let s = stmts.data[i];
            if NODES[s].end <= pos && !(NODES[s].start <= pos && pos < NODES[s].end) {
                last = line_of(NODES[s].end - 1);
            }
        }
        last
    }
}

fn contains(v: IntVec, x: i64) -> bool {
    unsafe {
        for i in 0..v.count {
            if v.data[i] == x {
                return true;
            }
        }
        false
    }
}

fn bytes_is(s: [u8], c: *u8) -> bool {
    unsafe {
        let t = c_slice(c);
        if s.len != t.len {
            return false;
        }
        for i in 0..s.len {
            if s[i] != t[i] {
                return false;
            }
        }
        true
    }
}

// The first use in [sa, sb) of local l.
fn first_use(l: i64, sa: i64, sb: i64) -> i64 {
    unsafe {
        var first = sb;
        for n in 1..NODE_COUNT {
            if local_of(n) == l && in_body(n) && NODES[n].start >= sa && NODES[n].start < first {
                first = NODES[n].start;
            }
        }
        first
    }
}

fn sort_by_first_use(params: inout IntVec, modes: inout IntVec, sa: i64, sb: i64) {
    unsafe {
        let n = params.count;
        for i in 1..n {
            var j = i;
            while j > 0
                && first_use(params.data[j], sa, sb) < first_use(params.data[j - 1], sa, sb) {
                let t = params.data[j];
                params.data[j] = params.data[j - 1];
                params.data[j - 1] = t;
                let m = modes.data[j];
                modes.data[j] = modes.data[j - 1];
                modes.data[j - 1] = m;
                j -= 1;
            }
        }
    }
}

// Whether `name` is taken where NEW goes: an item of FN's module, or a
// method of its type (method).
fn taken_name(d: i64, name: i64, method: bool) -> bool {
    unsafe {
        for x in 0..DEF_COUNT {
            if DEFS[x].name != name {
                continue;
            }
            let k = DEFS[x].kind;
            if method && k == K_METHOD && DEFS[x].owner == DEFS[d].owner {
                return true;
            }
            if !method && DEFS[x].module == DEFS[d].module && k != K_METHOD && k != K_IMPL_METHOD
                && DEFS[x].parent < 0 {
                return true;
            }
        }
        false
    }
}

// The results: `x`, or `(a, b)`; as a pattern, with `mut` where they
// were declared so and are changed at or after `after`.
fn put_results(out: i64, results: IntVec, pattern: bool, after: i64) {
    unsafe {
        let n = results.count;
        if n > 1 {
            buf_byte(out, '(');
        }
        for i in 0..n {
            let l = results.data[i];
            buf_str(out, if i == 0 { c"" } else { c", " });
            if pattern && local_mut(l) && changed_after(l, after) {
                buf_str(out, if new_spelling() && n > 1 { c"var " } else { c"mut " });
            }
            buf_bytes(out, local_name(l));
        }
        if n > 1 {
            buf_byte(out, ')');
        }
    }
}

// (0.20) Whether local l is an access declared in 0.20's spelling (`x:
// inout T`, `inout r = &v`; any in a file read in it), used as its place:
// passed on, it is lent again (`&r`). A 0.19 `&mut T` is a reference
// value, passed as it is.
fn access_local(l: i64) -> bool {
    unsafe {
        let dn = decl_of(l);
        if dn < 0 {
            return false;
        }
        if crate::front::conv::strict_at(NODES[dn].start) {
            return true;
        }
        if NODES[dn].kind == NodeKind::Param {
            return (NODES[dn].p & crate::front::ast::CONV_NEW) != 0;
        }
        let p = parent(dn);
        p >= 0 && NODES[p].kind == NodeKind::Let
            && (NODES[p].p & crate::front::ast::CONV_INOUT) != 0
    }
}

// Whether local l is assigned (or its address taken, a field of it
// written) at or after position pos.
fn changed_after(l: i64, pos: i64) -> bool {
    unsafe {
        for n in 1..NODE_COUNT {
            if local_of(n) == l && in_body(n) && NODES[n].start >= pos && use_kind(n) != USE_VALUE
                && use_kind(n) != USE_FIELD_READ {
                return true;
            }
        }
        false
    }
}

// The lines A-B cut statement s: the range of whole statements, to try.
fn cut_statement(fqn: [u8], name: [u8], new_name: [u8], la: i64, lb: i64, s: i64) -> i64 {
    unsafe {
        let sa = line_of(NODES[s].start);
        let sb = line_of(NODES[s].end - 1);
        let e = diag(c"error", c"refactor.range");
        buf_str(e, c"lines ");
        put_range(e, la, lb);
        buf_str(e, c" cut a statement of ");
        buf_bytes(e, fqn);
        buf_str(e, c" (lines ");
        put_range(e, sa, sb);
        buf_str(e, c"); NEW takes whole statements of one block\n");
        try_extract(name, new_name, if sa < la { sa } else { la }, if sb > lb { sb } else { lb });
        1
    }
}

fn try_extract(name: [u8], new_name: [u8], a: i64, b: i64) {
    unsafe {
        let out = diags();
        buf_str(out, c"try:");
        put_cword(out, PROG);
        buf_str(out, c" refactor extract-function");
        put_word(out, name);
        buf_str(out, c" --lines ");
        put_range(out, a, b);
        buf_str(out, c" --to");
        put_word(out, new_name);
        put_root(out);
        try_end(out);
    }
}

fn try_query(cmd: *u8, what: [u8]) {
    unsafe {
        let out = diags();
        buf_str(out, c"try:");
        put_cword(out, PROG);
        buf_str(out, c" query ");
        buf_str(out, cmd);
        put_word(out, what);
        put_root(out);
        try_end(out);
    }
}

fn try_show(fqn: [u8]) {
    unsafe { try_query(c"show", fqn); }
}

fn try_show_at(file: i64, line: i64) {
    unsafe {
        let b = buf_new();
        put_path(b, file);
        buf_byte(b, ':');
        buf_int(b, line);
        try_query(c"show", buf_slice(b));
    }
}
