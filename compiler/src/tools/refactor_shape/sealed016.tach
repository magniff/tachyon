// `fix --only alloc016`, the fields: 0.16 seals std's Vec, Buf and
// HashMap (#[sealed]: their fields are private to std), so a 0.15
// program's reads of their fields become the methods that return the
// same (`v.len` -> `v.len()`, `v.cap` -> `v.capacity()`, `v.ptr` ->
// `v.as_slice().ptr`, `m.len` -> `m.len()`). A write (`v.len = 0`,
// `v.len += 1`), or a field with no such method, is left: `error
// fix.alloc016-manual`, with where it is.

use crate::base::{buf_bytes, buf_str, intern_c};
use crate::front::ast::{NODES, NODE_COUNT, NodeKind, STRUCT_SEALED};
use crate::front::check::collect::find_generic_method;
use crate::front::lexer::{TOKS, TOK_COUNT, Tok};
use crate::front::modules::STD_MODULE;
use crate::front::types::{STRUCTS, TYPES, TyKind, find_method, struct_type};
use crate::middle::lower::ssa::HMap;
use crate::tools::edit::edit_replace;
use crate::tools::query::positions::{put_loc, token_at};
use crate::tools::refactor_shape::{orig_of, sym_text, text_buf, try_show_at};
use crate::tools::refactor_shape::alloc016::{in_std, left};
use crate::tools::rewrite::parsed::{pa, pend, pstart};

// Whether token k assigns to what is before it (`=`, `+=`, ...).
fn assigns(k: i64) -> bool {
    unsafe {
        if k >= TOK_COUNT {
            return false;
        }
        let t = TOKS[k].kind;
        t == Tok::Eq || t == Tok::PlusEq || t == Tok::MinusEq || t == Tok::StarEq
            || t == Tok::SlashEq || t == Tok::PercentEq || t == Tok::AmpEq || t == Tok::PipeEq
            || t == Tok::CaretEq || t == Tok::ShlEq || t == Tok::ShrEq
    }
}

// What a read of field `name` of std's sealed struct s is now: the method
// call's text (after the dot), or an empty slice when there is none.
fn method_for(s: i64, name: i64) -> [u8] {
    unsafe {
        let (text, method) = if name == intern_c(c"len") { ("len()", intern_c(c"len")) }
            else if name == intern_c(c"cap") { ("capacity()", intern_c(c"capacity")) }
            else if name == intern_c(c"ptr") { ("as_slice().ptr", intern_c(c"as_slice")) }
            else { ("", 0) };
        if method == 0 {
            return "";
        }
        let has = find_method(struct_type(s), method) >= 0
            || (STRUCTS[s].tmpl != 0 && find_generic_method(STRUCTS[s].tmpl, method) >= 0);
        if has { text } else { "" }
    }
}

// The edits of the field reads; their number. The writes and the fields
// with no method are errors left (alloc016's `left`).
pub fn sealed_field_edits() -> i64 {
    unsafe {
        let mut fixes = 0;
        let mut seen = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for n in 1..NODE_COUNT {
            // (y: 0 a struct's field, 1 through a pointer, 2 a slice's)
            if NODES[n].kind != NodeKind::FieldAccess || NODES[n].y > 1 {
                continue;
            }
            let mut t = NODES[NODES[n].a].ty;
            if t <= 0 {
                continue;
            }
            if NODES[n].y == 1 && TYPES[t].kind == TyKind::Ptr {
                t = TYPES[t].a;
            }
            if TYPES[t].kind != TyKind::Struct {
                continue;
            }
            let s = TYPES[t].a;
            let s0 = if STRUCTS[s].tmpl != 0 { STRUCTS[s].tmpl - 1 } else { s };
            if (STRUCTS[s0].repr & STRUCT_SEALED) == 0 || STRUCTS[s0].module != STD_MODULE
                || STD_MODULE < 0 {
                continue;
            }
            let o = orig_of(n, NodeKind::FieldAccess);
            if o < 0 || seen.get(o + 1) != 0 || in_std(pstart(o)) {
                continue;
            }
            seen.put(o + 1, 1);
            let name = NODES[n].b;
            // (the name: the last such identifier between the base and o's end)
            let mut k = -1;
            let mut i = token_at(pend(pa(o)));
            while i >= 0 && i < TOK_COUNT && TOKS[i].start < pend(o) {
                if TOKS[i].kind == Tok::Ident && TOKS[i].value as i64 == name {
                    k = i;
                }
                i += 1;
            }
            if k < 0 {
                continue;
            }
            let text = method_for(s, name);
            if assigns(k + 1) || text.len == 0 {
                let e = left(c"fix.alloc016-manual");
                buf_str(e,
                    if text.len == 0 { c"a read of field '" } else { c"a write of field '" });
                buf_bytes(e, sym_text(name));
                buf_str(e, c"' at ");
                put_loc(e, TOKS[k].start);
                buf_str(e, c": std's ");
                buf_bytes(e, sym_text(STRUCTS[if STRUCTS[s].tmpl != 0 { STRUCTS[s].tmpl - 1 }
                    else { s }].name));
                buf_str(e,
                    c" is #[sealed] (0.16): its fields change only through its methods (push, clear, truncate, reserve, ...)\n");
                try_show_at(TOKS[k].start);
                continue;
            }
            edit_replace(TOKS[k].start, TOKS[k].end, text_buf(text));
            fixes += 1;
        }
        fixes
    }
}
