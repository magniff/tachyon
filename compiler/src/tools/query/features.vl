// `query features NAME... [--why FEATURE] [-C ...]` (0.19; docs/design/
// arch.md §2.9): what each function needs beyond the build's features,
// `PATH<TAB>FEATURES (inferred|declared)` a line (`none`: callable
// anywhere), a generic function's line each of its instances'; with
// `--why FEATURE`, under each line, the calls down to the intrinsic that
// needs it (front/features/check.vl's source_of). `-C target-cpu=` and
// `-C target-feature=` change the build's features, so what is needed.

use crate::arch::{F_DOC, F_EQUIV, F_FEATURES, F_INSN, F_SEMANTICS, intr_text, intrinsic_of_fn};
use crate::arch::features::{has_bit, own_features, parse_feature};
use crate::base::{
    IntVec, STDOUT, SYMS, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, buf_write_fd,
};
use crate::front::ast::NODES;
use crate::front::features::check::{put_features, put_pos, source_of, top_features};
use crate::front::features::infer::{DECLARED, DECLARED_MARK, NEEDS, NEEDS_COUNT};
use crate::front::modules::{STD_MODULE, within_std};
use crate::front::types::{FNS, FN_COUNT, TLISTS, TY_ERROR};
use crate::tools::query::cache::RESTORED;
use crate::tools::query::defs::{DEFS, K_FN, K_IMPL_METHOD, K_METHOD, K_TRAIT_FN};
use crate::tools::query::diagnostics::diag;
use crate::tools::query::effects::{OPT_WHY, cached_text};

fn fn_of_def(d: i64) -> i64 {
    unsafe {
        let k = DEFS[d].kind;
        if !(k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN) {
            return -1;
        }
        let f = NODES[DEFS[d].node].x - 1;
        if f < 0 || f >= FN_COUNT { -1 } else { f }
    }
}

// Whether instance g is one query mode made to check a template (a type
// argument the error type).
fn error_instance(g: i64) -> bool {
    unsafe {
        for i in 0..FNS[g].targ_count {
            if TLISTS.data[FNS[g].targs + i] == TY_ERROR {
                return true;
            }
        }
        false
    }
}

// The text of d's `features:` for def, show and context (0.19, T8): what
// a function needs beyond the build's features, `avx2 (inferred)` or
// `crc (declared)`; nothing for a function that needs nothing, a generic
// one, or an intrinsic (put_def_features prints the table's line).
pub fn def_features_text(out: i64, d: i64) {
    unsafe {
        if RESTORED {
            cached_text(out, d, 2);
            return;
        }
        let f = fn_of_def(d);
        if f < 0 || f >= NEEDS_COUNT || FNS[f].generic != 0 || intrinsic_of_fn(f) >= 0 {
            return;
        }
        let needs = NEEDS[f];
        if needs == 0 {
            return;
        }
        put_features(out, needs, c", ", c"");
        buf_str(out, if DECLARED[f] != 0 { c" (declared)" } else { c" (inferred)" });
    }
}

// The intrinsic definition d declares, or -1.
pub fn def_intrinsic(d: i64) -> i64 {
    unsafe {
        if RESTORED {
            return -1;
        }
        let f = fn_of_def(d);
        if f < 0 { -1 } else { intrinsic_of_fn(f) }
    }
}

// ` features: SET` of definition d into out, for def, show and context;
// an intrinsic's: `features: neon<sep>instruction: TEMPLATE` (the
// table's). Whether there was one.
pub fn put_def_features(out: i64, d: i64, sep: *u8) -> bool {
    unsafe {
        let id = def_intrinsic(d);
        if id >= 0 {
            buf_str(out, sep);
            buf_str(out, c"features: ");
            let f = intr_text(id, F_FEATURES);
            buf_bytes(out, if f == "-" { "none" } else { f });
            buf_str(out, sep);
            buf_str(out, c"instruction: ");
            let i = intr_text(id, F_INSN);
            buf_bytes(out, if i == "-" { "none" } else { i });
            return true;
        }
        let text = buf_new();
        def_features_text(text, d);
        if buf_slice(text).len == 0 {
            return false;
        }
        buf_str(out, sep);
        buf_str(out, c"features: ");
        buf_bytes(out, buf_slice(text));
        true
    }
}

// An intrinsic's notes under show's and context's first line: its doc,
// what it computes, the other architecture's equivalent, its `use` line.
pub fn put_intrinsic_notes(out: i64, d: i64) {
    unsafe {
        let id = def_intrinsic(d);
        if id < 0 {
            return;
        }
        buf_str(out, c"// ");
        buf_bytes(out, intr_text(id, F_DOC));
        buf_byte(out, '\n');
        let s = intr_text(id, F_SEMANTICS);
        if s != "-" {
            buf_str(out, c"// computes: ");
            buf_bytes(out, s);
            buf_byte(out, '\n');
        }
        let e = intr_text(id, F_EQUIV);
        if e != "-" {
            buf_str(out, c"// equivalent: ");
            buf_bytes(out, e);
            buf_byte(out, '\n');
        }
        buf_str(out, c"// use ");
        buf_bytes(out, SYMS[DEFS[d].fqn].text);
        buf_str(out, c";\n");
    }
}

// `query features`: the functions among the definitions `matches`.
pub fn query_features(matches: IntVec) -> i64 {
    unsafe {
        var why = -1;
        if OPT_WHY != 0 as *u8 {
            var n = 0;
            while OPT_WHY[n] != 0 {
                n += 1;
            }
            why = parse_feature(OPT_WHY[0..n]);
            if why < 0 {
                let e = diag(c"error", c"query.usage");
                buf_str(e, c"unknown feature '");
                buf_str(e, OPT_WHY);
                buf_str(e, c"' for --why (`volec explain arch.feature_name` lists them)\n");
                return 2;
            }
        }
        // (std's functions only when no other is named so: `fold`)
        var own = false;
        for i in 0..matches.count {
            if !within_std(DEFS[matches.data[i]].module) {
                own = true;
            }
        }
        let out = buf_new();
        var shown = 0;
        for i in 0..matches.count {
            let d = matches.data[i];
            let f = fn_of_def(d);
            if f < 0 || own && within_std(DEFS[d].module) {
                continue;
            }
            var fs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            if FNS[f].generic == 0 {
                fs.push(f);
            } else {
                for g in 0..FN_COUNT {
                    if FNS[g].tmpl == f + 1 && !error_instance(g) {
                        fs.push(g);
                    }
                }
            }
            for k in 0..fs.count {
                let g = fs.data[k];
                buf_bytes(out,
                    if g == f { SYMS[DEFS[d].fqn].text } else { SYMS[FNS[g].display].text });
                buf_byte(out, '\t');
                let needs = if g < NEEDS_COUNT { NEEDS[g] } else { 0 };
                if needs == 0 {
                    buf_str(out, c"none");
                    if DECLARED[g] != 0 {
                        buf_str(out, c" (declared: ");
                        put_features(out, DECLARED[g] & ~DECLARED_MARK & own_features(), c", ",
                            c"");
                        buf_str(out, c")");
                    }
                } else {
                    put_features(out, needs, c", ", c"");
                    buf_str(out, if DECLARED[g] != 0 { c" (declared)" } else { c" (inferred)" });
                }
                buf_byte(out, '\n');
                shown += 1;
                if why >= 0 {
                    put_chain(out, g, why);
                }
            }
        }
        buf_write_fd(out, STDOUT);
        if shown == 0 {
            let e = diag(c"note", c"query.empty");
            buf_str(e, c"no function among the names (a generic function without instances?)\n");
            return 1;
        }
        0
    }
}

// The calls that bring feature b into function g, one indented line each.
fn put_chain(out: i64, g: i64, b: i64) {
    unsafe {
        let needs = if g < NEEDS_COUNT { NEEDS[g] } else { 0 };
        if !has_bit(needs, b) {
            buf_str(out, c"  (not: ");
            buf_str(out, OPT_WHY);
            buf_str(out, c")\n");
            return;
        }
        if DECLARED[g] != 0 {
            buf_str(out, c"  declared by its #[target_feature]\n");
            return;
        }
        var chain = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        source_of(g, b, &chain);
        for k in 0..chain.count {
            let n = chain.data[k];
            let callee = NODES[n].x - 1;
            buf_str(out, c"  ");
            put_pos(out, NODES[n].start);
            buf_str(out, c": calls '");
            buf_bytes(out, SYMS[FNS[callee].display].text);
            buf_str(out, c"'");
            if k == chain.count - 1 {
                buf_str(out, c", which needs ");
                put_features(out, top_features(NEEDS[callee]), c", ", c"");
                if DECLARED[callee] != 0 {
                    buf_str(out, c" (declared)");
                }
            }
            buf_byte(out, '\n');
        }
    }
}
