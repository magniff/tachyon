// `query effects NAME...` (0.16, minimal; T5 makes the full command with
// `--why`, `--has` and modules): the inferred effects of each function
// NAME names, `PATH<TAB>EFFECTS` a line; a generic function's line is
// each of its instances'.

use crate::base::{IntVec, STDOUT, SYMS, buf_byte, buf_bytes, buf_new, buf_str, buf_write_fd};
use crate::front::ast::NODES;
use crate::front::effects::{effects_text, fn_effects};
use crate::front::types::{FNS, FN_COUNT, TLISTS, TY_ERROR};
use crate::tools::query::defs::{DEFS, K_FN, K_IMPL_METHOD, K_METHOD, K_TRAIT_FN};

// The effects of the functions among the definitions `matches`; 1 when
// none is a function.
pub fn query_effects(matches: *IntVec) -> i64 {
    unsafe {
        let out = buf_new();
        let mut found = false;
        for i in 0..(*matches).count {
            let d = (*matches).data[i];
            let k = DEFS[d].kind;
            if k != K_FN && k != K_METHOD && k != K_IMPL_METHOD && k != K_TRAIT_FN {
                continue;
            }
            let f = NODES[DEFS[d].node].x - 1;
            if f < 0 {
                continue;
            }
            found = true;
            if FNS[f].generic == 0 {
                effects_line(out, SYMS[DEFS[d].fqn].text, f);
                continue;
            }
            for g in 0..FN_COUNT {
                if FNS[g].tmpl == f + 1 && !error_instance(g) {
                    effects_line(out, SYMS[FNS[g].display].text, g);
                }
            }
        }
        if !found {
            buf_str(out, c"note query.empty: no function among the names\n");
        }
        buf_write_fd(out, STDOUT);
        if found { 0 } else { 1 }
    }
}

// Whether instance g is one query mode made to check a template (a type
// argument the error type).
fn error_instance(g: i64) -> bool {
    unsafe {
        for i in 0..FNS[g].targ_count {
            if TLISTS.data[FNS[g].targs + i] == TY_ERROR {
                return true;
            }
        }
        false
    }
}

fn effects_line(out: i64, name: [u8], f: i64) {
    unsafe {
        buf_bytes(out, name);
        buf_byte(out, '\t');
        effects_text(out, fn_effects(f));
        buf_byte(out, '\n');
    }
}
