// The tools' cache (0.13): what the queries take from a program's front
// end (its files, symbols, modules, definitions, positions, errors and,
// apart, every reference), on disk, so that a question about a program
// that has not changed reads its files and the cache, and neither lexes,
// parses nor checks it.
//
// The cache of a program is target/tachyonc-cache/q-KEY.bin (and
// q-KEY.refs), KEY a hash of the root as given, the current directory
// and the target; $TACHYON_CACHE names another directory, or `off`.
// Without $TACHYON_CACHE and a ./target directory there is none.
//
// It holds for the compiler that wrote it (a hash of its executable) and
// for the files it was made from: every file is read again and the hash
// of their text compared, and the module files that were looked for and
// not found must still not exist. Then the program's tables are restored
// as the front end left them (RESTORED), the few things the answers would
// take from the nodes and tokens precomputed (the C_* tables), and the
// answers are the same code as without the cache, byte for byte.
//
// A command that read the program in full writes the cache afterwards (a
// new file, renamed over the old one), when the program was parsed and
// imports no C header (the headers' text is not a file of the program).

use crate::base::{
    BUFS, FILES, FILE_COUNT, IntVec, SRC, SYMS, SYM_COUNT, buf_byte, buf_bytes, buf_new,
    buf_reserve, buf_slice, buf_str, fclose, fopen, fwrite, memcpy, memset, restore_sources,
    restore_sym, strlen, sym_hash,
};
use crate::base::diag::{diag_records, diag_restore};
use crate::base::timer::{TIME_PASSES, T_CACHE, timer_add, timer_now};
use crate::front::cimport::IMPORTED_START;
use crate::front::lexer::init_lexer;
use crate::front::modules::{
    C_MODULE, INLINE_MODS, MODULES, MODULE_PROBES, STD_MODULE, add_module, init_modules,
    module_count,
};
use crate::front::own::diag::OWN_MODE;
use crate::tools::edit::items::{item_head, item_tail, keyword_head};
use crate::tools::proc::{
    fork_worker, make_dirs, read_file_if, remove_file, rename_file, worker_exit, write_file_if,
};
use crate::tools::query::QF_USE;
use crate::tools::query::command_line::{NOTES, PARSED};
use crate::tools::query::defs::{
    ALIASES, C_ALIAS, C_ALIAS_MODULE, DEFS, DEF_COUNT, Def, K_IMPL_METHOD, K_METHOD, MOD_DEF,
    def_of_node, restore_def, trait_of,
};
use crate::tools::query::diagnostics::PROG;
use crate::tools::query::effects::{C_EFF_BUF, C_EFF_TEXT, cache_texts};
use crate::tools::query::positions::{CONTAINERS, FILE_RANK, LINES};
use crate::tools::query::refs::{GROUP, R_DEF, R_FLAGS, R_GROUP, R_POS, collect_all_refs};
use crate::tools::query::sections::code_start;
use crate::tools::query::show::{impl_block, impl_header_span, signature_end};
use crate::tools::query::values::{C_OWN_BUF, C_OWN_TEXT, own_cache_texts};

extern "C" {
    fn getenv(name: *u8) -> *u8;
    fn getcwd(buf: *u8, size: u64) -> *u8;
    fn getpid() -> i32;
    fn access(path: *u8, mode: i32) -> i32;
    // (open is variadic in C: called with no mode, so never to create)
    fn open(path: *u8, flags: i32) -> i32;
    fn read(fd: i32, buf: *u8, n: u64) -> i64;
    fn close(fd: i32) -> i32;
    fn dup2(from: i32, to: i32) -> i32;
    fn setsid() -> i32;
}

// "tachyonq", and the version of the format.
const MAGIC: i64 = 8174034211981648244;
// (6, 0.17: the kinds and view summaries)
const VERSION: i64 = 6;

// The program came from the cache: the answers take what the nodes and
// tokens would give from the C_* tables (per definition).
pub static mut RESTORED: bool = false;
pub static mut C_SIG_END: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut C_TRAIT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut C_BLOCK: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut C_HDR_FROM: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut C_HDR_TO: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// (the edits: an item's head, tail and keyword, edit/items.tach)
pub static mut C_HEAD: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut C_TAIL: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut C_KEYWORD: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Per file, where its code starts (its first token; sections.tach).
pub static mut C_CODE_START: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Every reference: (position << 32) | (definition << 6) | flags.
static mut C_REFS: *i64 = 0 as *i64;
static mut C_REF_COUNT: i64 = 0;

// ---- Words ----

// The cache files are 8-byte words; a string is its length, then its
// bytes and a NUL, padded to a word.

fn put(b: i64, v: i64) {
    unsafe {
        buf_reserve(b, 8);
        let p = (&BUFS[b].data[BUFS[b].len]) as *i64;
        p[0] = v;
        BUFS[b].len += 8;
    }
}

fn put_str(b: i64, s: [u8]) {
    unsafe {
        let n = s.len as i64;
        put(b, n);
        let words = (n + 8) / 8;
        buf_reserve(b, words * 8);
        let dst = &BUFS[b].data[BUFS[b].len];
        memset(dst, 0, (words * 8) as u64);
        if n > 0 {
            memcpy(dst, s.ptr, n as u64);
        }
        BUFS[b].len += words * 8;
    }
}

fn put_cstr(b: i64, s: *u8) {
    unsafe { put_str(b, s[0..strlen(s) as i64]); }
}

static mut RD: *i64 = 0 as *i64;
static mut RD_AT: i64 = 0;
static mut RD_N: i64 = 0;
static mut RD_BAD: bool = false;

fn read_words(b: i64) {
    unsafe {
        RD = BUFS[b].data as *i64;
        RD_AT = 0;
        RD_N = BUFS[b].len / 8;
        RD_BAD = BUFS[b].len % 8 != 0;
    }
}

fn get() -> i64 {
    unsafe {
        if RD_AT >= RD_N {
            RD_BAD = true;
            return 0;
        }
        let v = RD[RD_AT];
        RD_AT += 1;
        v
    }
}

// A count of at most `per`-word records that fit in what is left.
fn get_count(per: i64) -> i64 {
    unsafe {
        let n = get();
        if n < 0 || n * per > RD_N - RD_AT {
            RD_BAD = true;
            return 0;
        }
        n
    }
}

fn get_str() -> [u8] {
    unsafe {
        let n = get();
        let words = (n + 8) / 8;
        if n < 0 || words > RD_N - RD_AT {
            RD_BAD = true;
            let none = c"";
            return none[0..0];
        }
        let p = (&RD[RD_AT]) as *u8;
        RD_AT += words;
        p[0..n]
    }
}

fn same(a: [u8], b: [u8]) -> bool {
    unsafe {
        if a.len != b.len {
            return false;
        }
        for i in 0..a.len as i64 {
            if a[i] != b[i] {
                return false;
            }
        }
        true
    }
}

// ---- Hashes ----

fn mix(h: u64, x: u64) -> u64 {
    let v = (h ^ x) * 11400714819323198485;
    v ^ (v >> 29)
}

// The hash of n bytes at p (8-aligned): by words, then the last bytes.
fn hash_region(p: *u8, n: i64) -> u64 {
    unsafe {
        let w = p as *u64;
        let k = n / 8;
        let mut h: u64 = mix(0, n as u64);
        for i in 0..k {
            h = mix(h, w[i]);
        }
        let mut t: u64 = 0;
        for i in k * 8..n {
            t = (t << 8) | p[i] as u64;
        }
        mix(h, t)
    }
}

// The hash of buffer b's words from word `from` on (a cache file's body:
// a file that is not as written is not read).
fn body_hash(b: i64, from: i64) -> i64 {
    unsafe {
        if BUFS[b].len < from * 8 {
            return -1;
        }
        (hash_region(&BUFS[b].data[from * 8], BUFS[b].len - from * 8) >> 1) as i64
    }
}

// The hash of the compiler's executable (0: not found by its path).
static mut IDENT: i64 = -1;

pub fn ident() -> i64 {
    unsafe {
        if IDENT >= 0 {
            return IDENT;
        }
        IDENT = 0;
        let mut slash = false;
        let mut i = 0;
        while PROG != 0 as *u8 && PROG[i] != 0 {
            slash = slash || PROG[i] == '/';
            i += 1;
        }
        let b = buf_new();
        if slash && read_file_if(PROG, b) {
            IDENT = (hash_region(BUFS[b].data, BUFS[b].len) >> 1) as i64;
            if IDENT == 0 {
                IDENT = 1;
            }
        }
        IDENT
    }
}

// ---- Where ----

static mut DIR: *u8 = 0 as *u8;

// The cache directory, or 0: none.
pub fn cache_dir() -> *u8 {
    unsafe {
        if DIR != 0 as *u8 {
            return DIR;
        }
        let env = getenv(c"TACHYON_CACHE");
        if env != 0 as *u8 {
            if env[0] == 0 || (env[0] == 'o' && env[1] == 'f' && env[2] == 'f' && env[3] == 0) {
                return 0 as *u8;
            }
            DIR = env;
        } else if access(c"target/.", 0) == 0 {
            DIR = c"target/tachyonc-cache";
        }
        DIR
    }
}

fn cwd() -> *u8 {
    unsafe {
        let b = buf_new();
        buf_reserve(b, 4096);
        if getcwd(BUFS[b].data, 4096) == 0 as *u8 {
            BUFS[b].data[0] = 0;
        }
        BUFS[b].data
    }
}

// The cache's file for root and target, with suffix `ext`.
fn cache_file(root: *u8, target: i64, ext: *u8) -> *u8 {
    unsafe {
        let k = buf_new();
        put_cstr(k, root);
        put_cstr(k, cwd());
        put(k, target);
        // (0.17: the own pass's mode decides the errors: --values)
        put(k, OWN_MODE);
        let h = hash_region(BUFS[k].data, BUFS[k].len);
        let out = buf_new();
        buf_str(out, cache_dir());
        buf_str(out, c"/q-");
        for i in 0..16 {
            let d = ((h >> ((15 - i) * 4) as u64) & 15) as u8;
            buf_byte(out, if d < 10 { '0' + d } else { 'a' + d - 10 });
        }
        buf_str(out, ext);
        buf_byte(out, 0);
        BUFS[out].data
    }
}

// Whether the cache can be used at all: a directory, and the compiler
// found.
fn usable() -> bool {
    unsafe {
        cache_dir() != 0 as *u8 && ident() != 0
    }
}

// Whether a command that reads a program in full should make its cache.
pub fn cache_on() -> bool {
    usable()
}

// ---- Reading ----

// Reads file `path` into dst: exactly n bytes (dst has room for one more),
// or false.
fn read_exact(path: *u8, dst: *u8, n: i64) -> bool {
    unsafe {
        let fd = open(path, 0);
        if fd < 0 {
            return false;
        }
        let mut got = 0;
        while got <= n {
            let k = read(fd, &dst[got], (n + 1 - got) as u64);
            if k <= 0 {
                break;
            }
            got += k;
        }
        close(fd);
        got == n
    }
}

// The program of root, from the cache, when it holds for it (and, with
// `refs`, its references too): whether it was restored. Nothing is
// changed when it was not.
//
// The cache is q-KEY.bin, or else q-KEY.next.bin: what the check of an
// edit (`check --overlay`) made of the edited program, which holds once
// the edit is written (it is then renamed the cache), and else is removed.
pub fn cache_restore(root: *u8, target: i64, refs: bool) -> bool {
    unsafe {
        let t = timer_now();
        let mut ok = restore(root, target, refs, false);
        if !ok && usable() {
            let next_bin = cache_file(root, target, c".next.bin");
            let next_refs = cache_file(root, target, c".next.refs");
            ok = restore(root, target, refs, true);
            if ok {
                rename_file(next_refs, cache_file(root, target, c".refs"));
                rename_file(next_bin, cache_file(root, target, c".bin"));
            } else {
                remove_file(next_bin);
                remove_file(next_refs);
            }
        }
        if usable() {
            trace(if ok { c"hit" } else { c"miss" });
        }
        timer_add(T_CACHE, t);
        ok
    }
}

// With $TACHYON_CACHE_TRACE (a file), a line per use of the cache: `hit`,
// `miss` or `save` (tests/query/run.sh: what saved is then a hit).
fn trace(word: *u8) {
    unsafe {
        let path = getenv(c"TACHYON_CACHE_TRACE");
        if path == 0 as *u8 {
            return;
        }
        let file = fopen(path, c"a");
        if file != 0 as *u8 {
            fwrite(word, 1, strlen(word), file);
            fwrite(c"\n", 1, 1, file);
            fclose(file);
        }
    }
}

fn restore(root: *u8, target: i64, refs: bool, next: bool) -> bool {
    unsafe {
        if !usable() || SYM_COUNT != 0 || crate::base::OVERLAY.count > 0
            || crate::front::stdtree::STD_TREE != 0 as *u8 {
            return false;
        }
        let b = buf_new();
        if !read_file_if(cache_file(root, target, if next { c".next.bin" } else { c".bin" }), b) {
            return false;
        }
        read_words(b);
        if get() != MAGIC || get() != VERSION || get() != ident() || get() != RD_N
            || get() != body_hash(b, 5) {
            return false;
        }
        if !same(get_str(), root[0..strlen(root) as i64]) || get() != target {
            return false;
        }
        let stamp = get();
        let src_len = get();
        let n_files = get_count(6);
        if RD_BAD || src_len < 0 || src_len > 1 << 40 {
            return false;
        }
        // The files, read again where they were.
        let all = buf_new();
        buf_reserve(all, src_len + 16);
        let mut files = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut at = 0;
        for _ in 0..n_files {
            let path = get_str();
            let start = get();
            let end = get();
            let module = get();
            let made = get();
            if RD_BAD || start != at || end < start || end >= src_len {
                return false;
            }
            let dst = &BUFS[all].data[start];
            if made != 0 {
                let text = get_str();
                if RD_BAD || text.len as i64 != end - start {
                    return false;
                }
                memcpy(dst, text.ptr, text.len as u64);
            } else if !read_exact(path.ptr, dst, end - start) {
                return false;
            }
            BUFS[all].data[end] = '\n';
            at = end + 1;
            files.push(path.ptr as i64);
            files.push(start);
            files.push(end);
            files.push(module);
        }
        if at != src_len {
            return false;
        }
        BUFS[all].data[at] = 0;
        BUFS[all].len = at + 1;
        if (hash_region(BUFS[all].data, src_len) >> 1) as i64 != stamp {
            return false;
        }
        let n_probes = get_count(1);
        for _ in 0..n_probes {
            let path = get_str();
            if RD_BAD || access(path.ptr, 0) == 0 {
                return false;
            }
        }
        let mut words = 0 as *i64;
        let mut n_refs = 0;
        if refs {
            let r = buf_new();
            if !read_file_if(cache_file(root, target, if next { c".next.refs" } else { c".refs" }),
                r)
                || BUFS[r].len % 8 != 0 || BUFS[r].len < 40 {
                return false;
            }
            words = BUFS[r].data as *i64;
            n_refs = BUFS[r].len / 8 - 5;
            if words[0] != MAGIC || words[1] != ident() || words[2] != stamp || words[3] != n_refs
                || words[4] != body_hash(r, 5) {
                return false;
            }
        }
        if RD_BAD {
            return false;
        }
        // It holds: the tables, as the front end left them.
        restore_sources(all, &files);
        restore_tables();
        // (the lexer as the front end left it: its keywords, for what
        // lexes a text again, the layout of an edit)
        init_lexer();
        if RD_BAD {
            crate::base::die(c"the tools' cache is damaged; remove target/tachyonc-cache");
        }
        if refs {
            C_REFS = &words[5];
            C_REF_COUNT = n_refs;
        }
        PARSED = true;
        RESTORED = true;
        true
    }
}

fn get_ints(v: *IntVec) {
    let n = get_count(1);
    for _ in 0..n {
        v.push(get());
    }
}

fn restore_tables() {
    unsafe {
        let n_syms = get_count(2);
        for _ in 0..n_syms {
            let h = get() as u64;
            restore_sym(get_str(), h);
        }
        let n_modules = get_count(4);
        init_modules();
        for m in 0..n_modules {
            let name = get();
            let parent = get();
            let public = get() != 0;
            let is_c = get() != 0;
            if m > 0 {
                add_module(name, parent, public);
            }
            MODULES[m].is_c = is_c;
        }
        STD_MODULE = get();
        C_MODULE = get();
        get_ints(&INLINE_MODS);
        let n_defs = get_count(26);
        C_EFF_BUF = buf_new();
        C_OWN_BUF = buf_new();
        for _ in 0..n_defs {
            let def = Def {
                node: get(), kind: get(), name: get(), module: get(), parent: get(), start: get(),
                end: get(), name_pos: get(), public: get() != 0, impl_node: get(), fqn: get(),
                path: get(), owner: get(), tr: get(),
            };
            restore_def(def);
            C_SIG_END.push(get());
            C_TRAIT.push(get());
            C_BLOCK.push(get());
            C_HDR_FROM.push(get());
            C_HDR_TO.push(get());
            C_HEAD.push(get());
            C_TAIL.push(get());
            C_KEYWORD.push(get());
            for _ in 0..2 {
                let text = get_str();
                C_EFF_TEXT.push(buf_slice(C_EFF_BUF).len);
                buf_bytes(C_EFF_BUF, text);
                C_EFF_TEXT.push(buf_slice(C_EFF_BUF).len);
            }
            for _ in 0..2 {
                let text = get_str();
                C_OWN_TEXT.push(buf_slice(C_OWN_BUF).len);
                buf_bytes(C_OWN_BUF, text);
                C_OWN_TEXT.push(buf_slice(C_OWN_BUF).len);
            }
        }
        get_ints(&MOD_DEF);
        get_ints(&ALIASES);
        C_ALIAS = get();
        C_ALIAS_MODULE = get();
        get_ints(&NOTES);
        get_ints(&LINES);
        get_ints(&FILE_RANK);
        get_ints(&CONTAINERS);
        get_ints(&C_CODE_START);
        let error_count = get();
        let mut errors = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut warnings = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let n_errors = get_count(2);
        for _ in 0..n_errors {
            errors.push(get());
            errors.push(text_buf(get_str()));
        }
        let n_warnings = get_count(3);
        for _ in 0..n_warnings {
            warnings.push(get());
            warnings.push(text_buf(get_str()));
            warnings.push(get());
        }
        diag_restore(&errors, &warnings, error_count);
    }
}

fn text_buf(s: [u8]) -> i64 {
    let b = buf_new();
    crate::base::buf_bytes(b, s);
    b
}

// The references of collect_refs, from the cache: those to the
// definitions of GROUP.
pub fn cached_refs() {
    unsafe {
        let group = crate::base::alloc_array::<i64>(DEF_COUNT + 1);
        for d in 0..DEF_COUNT {
            group[d] = GROUP.get(d + 1) - 1;
        }
        for i in 0..C_REF_COUNT {
            let w = C_REFS[i];
            let d = (w & 4294967295) >> 6;
            if d >= DEF_COUNT || group[d] < 0 {
                continue;
            }
            R_POS.push(w >> 32);
            R_DEF.push(d);
            R_GROUP.push(group[d]);
            R_FLAGS.push(w & 63);
        }
    }
}

// ---- Writing ----

// Writes the cache of the program just read in full (its front end, the
// paths and positions of its definitions), for root and target. Nothing
// when there is no cache or the program cannot be cached.
//
// The answer is out by then: a copy of the process (fork) writes the cache
// while this one ends, its output to /dev/null. Here instead with
// --time-passes and $TACHYON_CACHE_TRACE (the tests: the next command
// must find it).
pub fn cache_save(root: *u8, target: i64) {
    unsafe {
        if RESTORED || !PARSED || IMPORTED_START >= 0 || !usable() {
            return;
        }
        if !TIME_PASSES && getenv(c"TACHYON_CACHE_TRACE") == 0 as *u8 {
            let pid = fork_worker();
            if pid > 0 {
                return;
            }
            if pid == 0 {
                // (a session of its own: not ended with the caller's group)
                setsid();
                let null = open(c"/dev/null", 1);
                if null >= 0 {
                    dup2(null, 1);
                    dup2(null, 2);
                }
                save(root, target);
                worker_exit(0);
            }
        }
        let t = timer_now();
        save(root, target);
        timer_add(T_CACHE, t);
    }
}

fn put_ints(b: i64, v: *IntVec) {
    unsafe {
        put(b, (*v).count);
        for i in 0..(*v).count {
            put(b, (*v).data[i]);
        }
    }
}

// Writes buffer b to `path`, through a new file renamed over it.
fn write_atomic(b: i64, path: *u8) -> bool {
    unsafe {
        let tmp = buf_new();
        buf_str(tmp, path);
        buf_str(tmp, c".tmp");
        crate::base::buf_int(tmp, getpid() as i64);
        buf_byte(tmp, 0);
        if !write_file_if(BUFS[tmp].data, buf_slice(b)) {
            crate::tools::proc::remove_file(BUFS[tmp].data);
            return false;
        }
        rename_file(BUFS[tmp].data, path)
    }
}

fn save(root: *u8, target: i64) {
    unsafe {
        if FILE_COUNT == 0 || crate::front::stdtree::STD_TREE != 0 as *u8
            || !make_dirs(cache_dir()) {
            return;
        }
        // (with --overlay, the edited program: its cache for after the edit)
        let next = crate::base::OVERLAY.count > 0;
        let src_len = FILES[FILE_COUNT - 1].end + 1;
        let stamp = (hash_region(SRC, src_len) >> 1) as i64;
        // The references, apart (only refs and callers read them).
        let mut all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        collect_all_refs(&all);
        let r = buf_new();
        put(r, MAGIC);
        put(r, ident());
        put(r, stamp);
        put(r, all.count / 3);
        put(r, 0);
        let mut i = 0;
        while i < all.count {
            put(r, (all.data[i] << 32) | (all.data[i + 1] << 6) | (all.data[i + 2] & 63));
            i += 3;
        }
        let refs_header = BUFS[r].data as *i64;
        refs_header[4] = body_hash(r, 5);
        if !write_atomic(r, cache_file(root, target, if next { c".next.refs" } else { c".refs" })) {
            return;
        }
        let b = buf_new();
        put(b, MAGIC);
        put(b, VERSION);
        put(b, ident());
        put(b, 0);
        put(b, 0);
        put_cstr(b, root);
        put(b, target);
        put(b, stamp);
        put(b, src_len);
        put(b, FILE_COUNT);
        for f in 0..FILE_COUNT {
            let path = FILES[f].path;
            put_cstr(b, path);
            put(b, FILES[f].start);
            put(b, FILES[f].end);
            put(b, FILES[f].module);
            let made = path[0] == '<';
            put(b, if made { 1 } else { 0 });
            if made {
                put_str(b, SRC[FILES[f].start..FILES[f].end]);
            }
        }
        put(b, MODULE_PROBES.count);
        for k in 0..MODULE_PROBES.count {
            put_cstr(b, MODULE_PROBES.data[k] as *u8);
        }
        save_tables(b);
        // (the number of words, in the header)
        let header = BUFS[b].data as *i64;
        header[3] = BUFS[b].len / 8;
        header[4] = body_hash(b, 5);
        if write_atomic(b, cache_file(root, target, if next { c".next.bin" } else { c".bin" })) {
            trace(c"save");
        }
    }
}

fn save_tables(b: i64) {
    unsafe {
        put(b, SYM_COUNT);
        for s in 0..SYM_COUNT {
            put(b, sym_hash(s) as i64);
            put_str(b, SYMS[s].text);
        }
        put(b, module_count());
        for m in 0..module_count() {
            put(b, MODULES[m].name);
            put(b, MODULES[m].parent);
            put(b, if MODULES[m].public { 1 } else { 0 });
            put(b, if MODULES[m].is_c { 1 } else { 0 });
        }
        put(b, STD_MODULE);
        put(b, C_MODULE);
        put_ints(b, &INLINE_MODS);
        put(b, DEF_COUNT);
        for d in 0..DEF_COUNT {
            let x = DEFS[d];
            put(b, d + 1);
            put(b, x.kind);
            put(b, x.name);
            put(b, x.module);
            put(b, x.parent);
            put(b, x.start);
            put(b, x.end);
            put(b, x.name_pos);
            put(b, if x.public { 1 } else { 0 });
            put(b, x.impl_node);
            put(b, x.fqn);
            put(b, x.path);
            put(b, x.owner);
            put(b, x.tr);
            put(b, signature_end(d));
            put(b, trait_of(d));
            let method = x.kind == K_METHOD || x.kind == K_IMPL_METHOD;
            put(b, if method { impl_block(d) } else { 0 });
            let mut to = 0;
            let from = if method { impl_header_span(d, &to) } else { 0 };
            put(b, from);
            put(b, to);
            put(b, item_head(d));
            put(b, item_tail(d));
            put(b, keyword_head(d));
            // (0.16: the effects def, show and `query effects` print)
            let set = buf_new();
            let lines = buf_new();
            cache_texts(d, set, lines);
            put_str(b, buf_slice(set));
            put_str(b, buf_slice(lines));
            // (0.17: the kind and the view summary, tools/query/values)
            let kind = buf_new();
            let views = buf_new();
            own_cache_texts(d, kind, views);
            put_str(b, buf_slice(kind));
            put_str(b, buf_slice(views));
        }
        put_ints(b, &MOD_DEF);
        put_ints(b, &ALIASES);
        put(b, C_ALIAS);
        put(b, C_ALIAS_MODULE);
        // The notes of the imports that give another name (query.alias):
        // the definition + 1 in place of its node (def_of_node).
        let mut notes = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut k = 0;
        while k < NOTES.count {
            if (NOTES.data[k + 3] & QF_USE) != 0 && is_alias_at(NOTES.data[k]) {
                let d = def_of_node(NOTES.data[k + 2]);
                if d >= 0 {
                    notes.push(NOTES.data[k]);
                    notes.push(NOTES.data[k + 1]);
                    notes.push(d + 1);
                    notes.push(NOTES.data[k + 3]);
                }
            }
            k += 4;
        }
        put_ints(b, &notes);
        put_ints(b, &LINES);
        put_ints(b, &FILE_RANK);
        put_ints(b, &CONTAINERS);
        put(b, FILE_COUNT);
        for f in 0..FILE_COUNT {
            put(b, code_start(f));
        }
        let mut errors = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut warnings = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let error_count = diag_records(&errors, &warnings);
        put(b, error_count);
        put(b, errors.count / 2);
        let mut e = 0;
        while e < errors.count {
            put(b, errors.data[e]);
            put_str(b, buf_slice(errors.data[e + 1]));
            e += 2;
        }
        put(b, warnings.count / 3);
        let mut w = 0;
        while w < warnings.count {
            put(b, warnings.data[w]);
            put_str(b, buf_slice(warnings.data[w + 1]));
            put(b, warnings.data[w + 2]);
            w += 3;
        }
    }
}

fn is_alias_at(pos: i64) -> bool {
    unsafe {
        let mut i = 0;
        while i < ALIASES.count {
            if ALIASES.data[i + 1] == pos {
                return true;
            }
            i += 2;
        }
        false
    }
}
