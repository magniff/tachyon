// `tachyonc query own FILE:LINE:COL` (0.17, docs/design/value-semantics.md
// §2.9): the own pass's state at a position. The first line is the
// position and the function; then a line per local in scope: its name,
// type and kind (plain, owned, view), whether it is moved (where, by what)
// and the views it holds (their origins, where they were taken, what
// invalidated them). The state is front/own/observe.tach's
// (`own_state_at`, which walks the function); without it (the function is
// not walked: a template never instantiated) the locals and their kinds
// alone.

use crate::base::{
    IntVec, STDOUT, SYMS, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd,
};
use crate::front::ast::{NODES, NodeKind, child};
use crate::front::own::kinds::kind_word;
use crate::front::own::observe::own_state_at;
use crate::front::types::{FNS, FN_COUNT, buf_type, fn_param};
use crate::middle::lower::ssa::HMap;
use crate::tools::query::{parse_digits, trailing_number};
use crate::tools::query::defs::DEFS;
use crate::tools::query::diagnostics::{diag, try_begin, try_end};
use crate::tools::query::positions::{LINES, enclosing, line_end, line_index};
use crate::tools::query::refs::file_text;
use crate::tools::query::typeat::file_named;

pub fn query_own(arg: [u8]) -> i64 {
    unsafe {
        var line = -1;
        var col = -1;
        var file = arg[0..0];
        let a = trailing_number(arg);
        if a > 0 && arg[a - 1] == ':' {
            line = parse_digits(arg[a..arg.len]);
            file = arg[0..a - 1];
            let b = trailing_number(file);
            if b > 0 && file[b - 1] == ':' {
                col = line;
                line = parse_digits(file[b..file.len]);
                file = file[0..b - 1];
            }
        }
        if line < 1 {
            let d = diag(c"error", c"query.usage");
            buf_str(d, c"own needs a position, FILE:LINE:COL (not '");
            buf_bytes(d, arg);
            buf_str(d, c"')\n");
            return 2;
        }
        let f = file_named(file);
        if f < 0 {
            let d = diag(c"error", c"query.no-match");
            buf_str(d, c"no file '");
            buf_bytes(d, file);
            buf_str(d, c"' in the program\n");
            try_end(try_begin(c"items", arg[0..0], false));
            return 1;
        }
        let idx = line_index(crate::base::FILES[f].start) + line - 1;
        if idx >= LINES.count || LINES.data[idx] >= crate::base::FILES[f].end {
            let d = diag(c"error", c"query.no-match");
            buf_bytes(d, file_text(f));
            buf_str(d, c" has no line ");
            buf_int(d, line);
            buf_byte(d, '\n');
            return 1;
        }
        let ls = LINES.data[idx];
        let le = line_end(ls);
        var pos = ls;
        if col >= 1 {
            pos = ls + col - 1;
        } else {
            while pos < le && (crate::base::SRC[pos] == ' ' || crate::base::SRC[pos] == '\t') {
                pos += 1;
            }
            col = pos - ls + 1;
        }
        if pos > le {
            pos = le;
        }
        let fi = fn_at(pos);
        if fi < 0 {
            let d = diag(c"error", c"query.no-match");
            buf_bytes(d, arg);
            buf_str(d, c" is in no function the checker saw\n");
            let w = buf_new();
            buf_bytes(w, file);
            buf_byte(w, ':');
            buf_int(w, line);
            try_end(try_begin(c"show", buf_slice(w), true));
            return 1;
        }
        let out = buf_new();
        buf_bytes(out, file_text(f));
        buf_byte(out, ':');
        buf_int(out, line);
        buf_byte(out, ':');
        buf_int(out, col);
        buf_str(out, c" in ");
        let d = enclosing(pos);
        if d >= 0 {
            buf_bytes(out, SYMS[DEFS[d].fqn].text);
        } else {
            buf_bytes(out, SYMS[FNS[fi].display].text);
        }
        buf_byte(out, '\n');
        if !own_state_at(out, pos) {
            put_locals(out, fi, pos);
        }
        buf_write_fd(out, STDOUT);
        0
    }
}

// The innermost function whose body holds pos (a closure's own function
// inside its parent's), the first instance of a generic one; -1.
fn fn_at(pos: i64) -> i64 {
    unsafe {
        var best = -1;
        var size = 0;
        for i in 0..FN_COUNT {
            let n = FNS[i].node;
            if n <= 0 || FNS[i].is_extern || (FNS[i].generic > 0 && FNS[i].tmpl == 0) {
                continue;
            }
            let s = NODES[n].start;
            let e = NODES[n].end;
            if s <= pos && pos < e && (best < 0 || e - s < size) {
                best = i;
                size = e - s;
            }
        }
        best
    }
}

// The locals in scope at pos in function fi, each with its type and kind,
// aligned in columns.
fn put_locals(out: i64, fi: i64, pos: i64) {
    unsafe {
        let item = FNS[fi].node;
        var ls = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var starts = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        // (the bindings before pos whose scope, the innermost block, loop,
        // arm or closure holding them, holds pos)
        var inside = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var scopes = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var lets = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for n in 1..crate::front::ast::NODE_COUNT {
            if n == item || NODES[n].start < NODES[item].start || NODES[n].end > NODES[item].end {
                continue;
            }
            let k = NODES[n].kind;
            if k == NodeKind::PatBind || k == NodeKind::Param {
                inside.push(n);
            }
            else if k == NodeKind::Let && NODES[n].a > 0
                && NODES[n].start < NODES[NODES[n].a].start
                && crate::base::SRC[NODES[n].start] == 'l' {
                // (a `let`'s names from its end on)
                lets.put(NODES[n].a + 1, NODES[n].end);
            } else if k == NodeKind::Block || k == NodeKind::For || k == NodeKind::Arm
                || k == NodeKind::Closure || k == NodeKind::While {
                scopes.push(n);
            }
        }
        // (in the order they are declared, once each: a binding the
        // checker copied has its position; `__` names are the checker's)
        sort_nodes(inside);
        for i in 0..inside.count {
            let n = inside.data[i];
            if NODES[n].start >= pos || lets.get(n + 1) > pos || !in_scope(scopes, n, pos)
                || has_local(starts, NODES[n].start) {
                continue;
            }
            let name = SYMS[NODES[n].a].text;
            if name.len >= 2 && name[0] == '_' && name[1] == '_' || binding_type(fi, n) <= 0 {
                continue;
            }
            ls.push(n);
            starts.push(NODES[n].start);
        }
        var wn = 1;
        var wt = 1;
        let types = buf_new();
        var ends = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..ls.count {
            let l = ls.data[i];
            let nl = SYMS[NODES[l].a].text.len;
            if nl > wn {
                wn = nl;
            }
            let before = buf_slice(types).len;
            buf_type(types, binding_type(fi, l));
            let tl = buf_slice(types).len - before;
            ends.push(buf_slice(types).len);
            if tl > wt {
                wt = tl;
            }
        }
        var start = 0;
        for i in 0..ls.count {
            let l = ls.data[i];
            let name = SYMS[NODES[l].a].text;
            buf_bytes(out, name);
            pad(out, wn - name.len + 2);
            let t = buf_slice(types)[start..ends.data[i]];
            start = ends.data[i];
            buf_bytes(out, t);
            pad(out, wt - t.len + 2);
            buf_str(out, kind_word(binding_type(fi, l)));
            buf_byte(out, '\n');
        }
    }
}

// The type of binding node n (a Param or a PatBind) of function fi, as the
// checker gave it; 0 when it has none (code it did not check).
fn binding_type(fi: i64, n: i64) -> i64 {
    unsafe {
        if NODES[n].ty > 0 {
            return NODES[n].ty;
        }
        let item = FNS[fi].node;
        for i in 0..NODES[item].count {
            if child(item, i) == n && i < FNS[fi].param_count {
                return fn_param(fi, i);
            }
        }
        0
    }
}

fn pad(out: i64, n: i64) {
    for _ in 0..n {
        buf_byte(out, ' ');
    }
}

// Sorts nodes by their position (insertion: a function's bindings).
fn sort_nodes(v: IntVec) {
    unsafe {
        let d = v.data;
        for i in 1..v.count {
            var j = i;
            while j > 0 && NODES[d[j]].start < NODES[d[j - 1]].start {
                let t = d[j];
                d[j] = d[j - 1];
                d[j - 1] = t;
                j -= 1;
            }
        }
    }
}

fn has_local(ls: IntVec, l: i64) -> bool {
    for i in 0..ls.count {
        if unsafe { ls.data[i] } == l {
            return true;
        }
    }
    false
}

// Whether binding node b is in scope at pos: the innermost of `scopes`
// (the blocks, loops, arms and closures of its function) holding b holds
// pos.
fn in_scope(scopes: IntVec, b: i64, pos: i64) -> bool {
    unsafe {
        let at = NODES[b].start;
        var best = -1;
        var size = 0;
        for i in 0..scopes.count {
            let n = scopes.data[i];
            if NODES[n].start <= at && at < NODES[n].end
                && (best < 0 || NODES[n].end - NODES[n].start < size) {
                best = n;
                size = NODES[n].end - NODES[n].start;
            }
        }
        best < 0 || (NODES[best].start <= pos && pos < NODES[best].end)
    }
}
