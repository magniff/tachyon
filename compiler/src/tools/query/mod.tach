extern "C" {
    fn getenv(name: *u8) -> *u8;
}

// Flags of a reference: a call, the definition itself, an import.
pub const QF_CALL: i64 = 1;
pub const QF_DEF: i64 = 2;
pub const QF_USE: i64 = 4;
// (0.13) An assignment's target, a struct literal or a constructed variant,
// a pattern.
pub const QF_WRITE: i64 = 8;
pub const QF_INIT: i64 = 16;
pub const QF_PAT: i64 = 32;

// ---- The command line ----

pub fn ends_with_c(s: *u8, suffix: *u8) -> bool {
    unsafe {
        let n = strlen(s) as i64;
        let k = strlen(suffix) as i64;
        n >= k && streq(&s[n - k], suffix)
    }
}

// The program's root: ROOT, else $TACHYON_ROOT, ./main.tach or
// ./compiler/src/main.tach; 0 when there is none.
pub fn find_root(given: *u8) -> *u8 {
    unsafe {
        if given != 0 as *u8 {
            return given;
        }
        let env = getenv(c"TACHYON_ROOT");
        if env != 0 as *u8 && env[0] != 0 {
            return env;
        }
        if file_exists(c"main.tach") {
            return c"main.tach";
        }
        if file_exists(c"compiler/src/main.tach") {
            return c"compiler/src/main.tach";
        }
        0 as *u8
    }
}

// The root of a command's program (given, or found), or 0 after the
// diagnostic saying why there is none (the command then exits with 2);
// `cmd` and `name` make its `try:` line.
pub fn root_or_diag(given: *u8, cmd: *u8, name: [u8], with_name: bool) -> *u8 {
    unsafe {
        let root = find_root(given);
        if root == 0 as *u8 {
            let out = diag(c"error", c"query.no-root");
            buf_str(out, c"no root (TACHYON_ROOT, ./main.tach, ./compiler/src/main.tach)\n");
            ROOT_GIVEN = c"path/to/main.tach";
            try_end(try_begin(cmd, name, with_name));
            return 0 as *u8;
        }
        if !file_exists(root) {
            let out = diag(c"error", c"query.bad-root");
            buf_str(out, c"cannot read '");
            buf_str(out, root);
            buf_str(out, c"'\n");
            ROOT_GIVEN = 0 as *u8;
            if find_root(0 as *u8) != 0 as *u8 {
                try_end(try_begin(cmd, name, with_name));
            }
            return 0 as *u8;
        }
        root
    }
}

// The commands, for `--help` and the nearest command to a misspelt one.
fn put_usage(out: i64) {
    unsafe {
        buf_str(out,
            c"usage: tachyonc query def|show NAME... [--root ROOT] [--exact] [--with-comments]\n");
        buf_str(out, c"       tachyonc query show FILE.tach | MODULE::use | MODULE::header | MODULE::extern\n");
        buf_str(out, c"       tachyonc query context NAME...|MODULE [--budget TOKENS]   (source, calls, types, callers)\n");
        buf_str(out, c"       tachyonc query text FILE[:A[-B]]...\n");
        buf_str(out, c"       tachyonc query diff\n");
        buf_str(out, c"       tachyonc query refs|callers NAME... [--exact] [--count] [--in FILE|MODULE|ITEM] [--limit N] [--all]\n");
        buf_str(out, c"       tachyonc query callees FN... [--transitive] [--writes TABLE] [--count] [--limit N] [--all]\n");
        buf_str(out, c"       tachyonc query items [MODULE...] [--comments]\n");
        buf_str(out, c"       tachyonc query show MODULE::section TITLE\n");
        buf_str(out, c"       tachyonc query grep PATTERN... [--in FILE|MODULE|ITEM] [--code] [--comments] [--strings] [--word] [--count] [--limit N] [--all]\n");
        buf_str(out, c"       tachyonc query type FILE:LINE[:COL]...\n");
        buf_str(out, c"       tachyonc query own FILE:LINE:COL...   (0.17: each local's kind, moves and views there)\n");
        buf_str(out, c"       tachyonc query stats [MODULE|FILE] [--over N] [--all]\n");
        buf_str(out, c"       tachyonc query deps MODULE [--max-lines N]\n");
        buf_str(out, c"       tachyonc query unused [MODULE] [--all]\n");
        buf_str(out, c"       tachyonc query impact NAME\n");
        buf_str(out, c"       tachyonc query effects NAME...|MODULE [--has EFFECT] [--why EFFECT]   (alloc(Gpa) io global panic diverge unsafe)\n");
        buf_str(out, c"       tachyonc query features NAME... [--why FEATURE] [-C target-cpu=CPU] [-C target-feature=+x,-y]   (std::arch: what a function needs beyond the build's features)\n");
        buf_str(out, c"       tachyonc query arch WORDS... [--feature F] [--arch aarch64|x86_64|portable] [--equiv NAME]   (std::arch: the intrinsics by name, instruction, feature or doc; also query intrinsics)\n");
        buf_str(out, c"       tachyonc query views NAME...|MODULE [--why]   (what results and `&mut` parameters view: views(self), views(*self), stores(word))\n");
        buf_str(out, c"       tachyonc query conflicts [FILE|DIR|FILE:LINE...] [--show]\n");
        buf_str(out, c"       tachyonc query similar NAME... [--limit N]   (items like NAME to copy, nearest first)\n");
        buf_str(out, c"       tachyonc query examples [KIND...]   (items to start from for an \"add an X\" change; tachyonc guide how)\n");
        buf_str(out, c"NAME: a path or its end (f, m::f, T::f, T.field), or FILE:LINE; std's too (std::f, Vec::push)\n");
        buf_str(out, c"--budget TOKENS: any answer cut to about TOKENS (default 8000; 0: no limit; context: 2000)\n");
        buf_str(out, c"ROOT: --root ROOT, a last argument ending in .tach, $TACHYON_ROOT, ./main.tach, ./compiler/src/main.tach\n");
        buf_str(out, c"see docs/query.md and docs/refactor.md\n");
    }
}

// A usage error: `error query.usage: <message>`; the caller writes the
// message, then its `try:` lines.
fn usage_error() -> i64 {
    unsafe { diag(c"error", c"query.usage") }
}

const N_COMMANDS: i64 = 24;

fn command_name(i: i64) -> *u8 {
    if i == 0 { c"def" } else if i == 1 { c"show" } else if i == 2 { c"refs" }
    else if i == 3 { c"callers" } else if i == 4 { c"items" } else if i == 5 { c"stats" }
    else if i == 6 { c"deps" } else if i == 7 { c"unused" } else if i == 8 { c"impact" }
    else if i == 9 { c"text" } else if i == 10 { c"diff" } else if i == 11 { c"grep" }
    else if i == 12 { c"type" } else if i == 13 { c"context" } else if i == 14 { c"callees" }
    else if i == 15 { c"conflicts" } else if i == 16 { c"effects" }
    else if i == 17 { c"similar" } else if i == 18 { c"examples" } else if i == 19 { c"own" }
    else if i == 20 { c"views" } else if i == 21 { c"features" }
    else if i == 22 { c"arch" } else { c"intrinsics" }
}

// The command nearest to cmd (edit distance at most 2), or 0.
fn nearest_command(cmd: *u8) -> *u8 {
    unsafe {
        let want = cmd[0..strlen(cmd) as i64];
        let mut best = 0 as *u8;
        let mut best_d = 3;
        for i in 0..N_COMMANDS {
            let c = command_name(i);
            let d = edit_distance(want, c[0..strlen(c) as i64]);
            if d < best_d {
                best = c;
                best_d = d;
            }
        }
        best
    }
}

pub fn c_slice(s: *u8) -> [u8] {
    unsafe { s[0..strlen(s) as i64] }
}

// A decimal number (all of s), or -1.
pub fn parse_count(s: *u8) -> i64 {
    unsafe {
        let mut n = 0;
        let mut j = 0;
        while s[j] >= '0' && s[j] <= '9' {
            n = n * 10 + (s[j] - '0') as i64;
            j += 1;
        }
        if j == 0 || s[j] != 0 { -1 } else { n }
    }
}

// The options of stats and deps (0.11).
pub static mut OPT_OVER: i64 = 1000;
pub static mut OPT_MAX_LINES: i64 = 1000;

pub fn run_query(argc: i64, argv: **u8) -> i64 {
    // (0.15: the answer within its budget, budget.tach)
    begin_output();
    let status = run_query_inner(argc, argv);
    end_output(argc, argv, argc >= 3 && unsafe { streq(argv[2], c"context") });
    write_diags();
    timer_report();
    status
}

fn run_query_inner(argc: i64, argv: **u8) -> i64 {
    unsafe {
        PROG = argv[0];
        if argc < 3 {
            let out = usage_error();
            buf_str(out, c"no command\n");
            try_end(try_begin(c"items", c_slice(c""), false));
            return 2;
        }
        let cmd = argv[2];
        CMD = cmd;
        QUERY_ARGV = argv;
        // (0.15: merge conflicts, read as text: conflicts.tach)
        if streq(cmd, c"conflicts") {
            return run_conflicts(argc, argv);
        }
        if streq(cmd, c"--help") || streq(cmd, c"-h") || streq(cmd, c"help") {
            let out = buf_new();
            put_usage(out);
            buf_write_fd(out, STDOUT);
            return 0;
        }
        let mut args = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut bad = 0 as *u8;
        let mut bad_value = false;
        let mut root = 0 as *u8;
        let mut i = 3;
        while i < argc {
            let a = argv[i];
            let valued = streq(a, c"--in") || streq(a, c"--limit") || streq(a, c"--root")
                || streq(a, c"--over") || streq(a, c"--max-lines") || streq(a, c"--kind")
                || streq(a, c"--budget") || streq(a, c"--writes") || streq(a, c"--has")
                || streq(a, c"--why") && !streq(cmd, c"views") || streq(a, c"--std-tree");
            if streq(a, c"-C") && i + 1 < argc && arch_option(argv[i + 1]) {
                // (0.19: the build's features, for `query features`)
                i += 1;
            } else if streq(a, c"--count") {
                OPT_COUNT = true;
            } else if streq(a, c"--transitive") {
                OPT_TRANSITIVE = true;
            } else if streq(a, c"--exact") {
                OPT_EXACT = true;
            } else if streq(a, c"--all") {
                OPT_ALL = true;
            } else if streq(a, c"--time-passes") {
                TIME_PASSES = true;
            } else if streq(a, c"--with-comments") {
                WITH_COMMENTS = true;
            } else if streq(a, c"--comments") {
                OPT_WHERE |= G_COMMENT;
                OPT_BANNERS = true;
            } else if streq(a, c"--code") {
                OPT_WHERE |= G_CODE;
            } else if streq(a, c"--strings") {
                OPT_WHERE |= G_STRING;
            } else if streq(a, c"--word") {
                OPT_WORD = true;
            } else if streq(a, c"--why") && streq(cmd, c"views") {
                // (0.17: `query views --why`, a flag)
                OPT_VIEWS_WHY = true;
            } else if valued {
                if i + 1 >= argc || argv[i + 1][0] == '-' {
                    bad = a;
                    bad_value = true;
                } else if streq(a, c"--in") {
                    OPT_IN = argv[i + 1];
                    i += 1;
                } else if streq(a, c"--root") {
                    root = argv[i + 1];
                    i += 1;
                } else if streq(a, c"--kind") {
                    OPT_KIND = argv[i + 1];
                    i += 1;
                } else if streq(a, c"--writes") {
                    OPT_WRITES = argv[i + 1];
                    i += 1;
                } else if streq(a, c"--has") {
                    OPT_HAS = argv[i + 1];
                    i += 1;
                } else if streq(a, c"--why") {
                    OPT_WHY = argv[i + 1];
                    i += 1;
                } else if streq(a, c"--std-tree") {
                    // (0.17: std from its files; front/stdtree.tach)
                    STD_TREE = argv[i + 1];
                    i += 1;
                } else {
                    let n = parse_count(argv[i + 1]);
                    if n < 0 {
                        bad = a;
                        bad_value = true;
                    } else if streq(a, c"--limit") {
                        OPT_LIMIT = n;
                    } else if streq(a, c"--over") {
                        OPT_OVER = n;
                    } else if streq(a, c"--budget") {
                        OPT_BUDGET = n;
                    } else {
                        OPT_MAX_LINES = n;
                    }
                    i += 1;
                }
            } else if a[0] == '-' && a[1] == '-' {
                bad = a;
            } else {
                args.push(a as i64);
            }
            i += 1;
        }
        // (0.17: a std file named, `query show compiler/std/io.tach:102`:
        // std from its files)
        if names_std_file(argc, argv) {
            STD_TREE = find_std_tree();
        }
        let items = streq(cmd, c"items");
        let is_refs = streq(cmd, c"refs") || streq(cmd, c"callers") || streq(cmd, c"grep")
            || streq(cmd, c"callees");
        if !is_query_command(cmd) {
            let out = usage_error();
            buf_str(out, c"unknown command '");
            buf_str(out, cmd);
            buf_str(out, c"'\n");
            let near = nearest_command(cmd);
            if near != 0 as *u8 && args.count >= 1 {
                try_query(near, c_slice(args.data[0] as *u8));
            } else if args.count >= 1 {
                try_query(c"def", c_slice(args.data[0] as *u8));
            } else {
                try_end(try_begin(c"items", c_slice(c""), false));
            }
            return 2;
        }
        // (0.19: the intrinsic tables, intrinsics.tach: no program read)
        if streq(cmd, c"arch") || streq(cmd, c"intrinsics") {
            return crate::tools::query::intrinsics::run_query_arch(argc, argv);
        }
        // Text (0.12, query_text.tach): no program read.
        if streq(cmd, c"text") {
            return run_text(&args);
        }
        if streq(cmd, c"show") && root == 0 as *u8 && all_files(&args) {
            return show_files(&args);
        }
        if streq(cmd, c"diff") {
            return run_query_diff(root);
        }
        // ROOT: --root, else a last argument ending in .tach after the
        // NAMEs (or alone, for items: its MODULE is optional; for stats
        // and unused a lone FILE.tach is a file of the program).
        if root == 0 as *u8 && args.count >= 1
            && ends_with_c(args.data[args.count - 1] as *u8, c".tach")
            && (args.count >= 2 || items) {
            args.count -= 1;
            root = args.data[args.count] as *u8;
        }
        ROOT_GIVEN = root;
        // (0.17: examples.tach; the kinds without the program)
        if streq(cmd, c"examples") {
            if args.count == 0 {
                return list_examples();
            }
            if !check_kinds(&args) {
                return 2;
            }
        }
        let needs_name = !items && !streq(cmd, c"unused") && !streq(cmd, c"stats");
        let single = streq(cmd, c"deps") || streq(cmd, c"impact") || streq(cmd, c"stats")
            || streq(cmd, c"unused");
        let first = if args.count == 0 { c_slice(c"") } else { c_slice(args.data[0] as *u8) };
        if needs_name && args.count == 0 {
            let out = usage_error();
            buf_str(out, cmd);
            if streq(cmd, c"deps") {
                buf_str(out, c" needs a MODULE\n");
            } else {
                buf_str(out,
                    c" needs a NAME (a path or its end: f, m::f, T::f, T.field; or FILE:LINE)\n");
            }
            try_end(try_begin(c"items", first, false));
            return 2;
        }
        let mut extra = if single && args.count > 1 { args.data[1] as *u8 } else { 0 as *u8 };
        // (`NAME ROOT EXTRA...`: the old form, with an argument too many)
        for k in 0..args.count - 1 {
            if root == 0 as *u8 && extra == 0 as *u8 && ends_with_c(args.data[k] as *u8, c".tach") {
                ROOT_GIVEN = args.data[k] as *u8;
                extra = args.data[k + 1] as *u8;
            }
        }
        if bad != 0 as *u8 || extra != 0 as *u8 {
            let out = usage_error();
            if bad != 0 as *u8 && bad_value {
                buf_str(out, bad);
                buf_str(out,
                    if streq(bad, c"--in") { c" needs a FILE or MODULE\n" }
                    else if streq(bad, c"--root") { c" needs a root file\n" }
                    else if streq(bad, c"--kind") {
                        c" needs a KIND (read, write, call, init, type, use, mod, pat, def)\n"
                    } else { c" needs a number\n" });
            } else if bad != 0 as *u8 {
                buf_str(out, c"unknown option '");
                buf_str(out, bad);
                buf_str(out, c"'\n");
            } else {
                buf_str(out, c"unexpected argument '");
                buf_str(out, extra);
                buf_str(out, c"'\n");
            }
            if bad != 0 as *u8 && bad_value && streq(bad, c"--limit") {
                try_refs(cmd, first, c"--limit 60", c_slice(c""));
            } else {
                try_end(try_begin(cmd, first, args.count > 0));
            }
            return 2;
        }
        if root == 0 as *u8 {
            root = infer_root(&args);
        }
        // (0.15: std's names where there is no program: a program of
        // nothing but std)
        // (0.19: an intrinsic, declared for the question: intrinsics.tach)
        let names_intrinsics = !streq(cmd, c"grep")
            && crate::tools::query::intrinsics::query_names_intrinsics(&args);
        let mut std_only = false;
        if find_root(root) == 0 as *u8 && !streq(cmd, c"grep")
            && (all_std(&args) || names_intrinsics) {
            root = std_root();
            std_only = root != 0 as *u8;
        }
        root = root_or_diag(root, cmd, first, args.count > 0);
        if root == 0 as *u8 {
            return 2;
        }
        if streq(cmd, c"effects") && check_effect_options() != 0 {
            return 2;
        }
        // (0.13: def, show, refs, callers and items from the tools' cache,
        // when it holds for the program; else read in full, then cached.
        // grep and type need the tokens and nodes, which are not cached:
        // they read the program in full, and leave the cache as it is)
        // (0.15: a question about std reads the program with std, and
        // without the cache, which holds the program as it is)
        let mut with_std = std_only || std_requested() || streq(cmd, c"examples")
            || (OPT_IN != 0 as *u8 && names_std(c_slice(OPT_IN)));
        for k in 0..args.count {
            if names_std(c_slice(args.data[k] as *u8)) {
                with_std = true;
            }
        }
        if names_intrinsics {
            with_std = true;
        }
        STD_ALWAYS = with_std;
        let context = streq(cmd, c"context");
        // (0.16: a local, by FILE:LINE:COL or asked again in full, needs
        // the nodes: locals.tach)
        let mut at_column = false;
        for k in 0..args.count {
            if streq(cmd, c"refs") && has_column(c_slice(args.data[k] as *u8)) {
                at_column = true;
            }
        }
        // (0.16: effects without --has and --why: the cached lines)
        let plain_effects = streq(cmd, c"effects") && OPT_HAS == 0 as *u8 && OPT_WHY == 0 as *u8;
        let cacheable = (streq(cmd, c"def") || streq(cmd, c"show") || streq(cmd, c"refs")
            || streq(cmd, c"callers") || items || context || plain_effects) && !with_std
            && !at_column && !full_requested() && !arch_options_given();
        let cached = cacheable && cache_restore(root, 0, is_refs || context);
        if !cached && !load_program(root, 0) {
            // (nothing to answer with: the errors say why)
            program_errors(c"error", root, true);
            return 1;
        }
        // (0.17: `items TYPE` of a std type, when no module is named so)
        let mut items_of_types = items;
        for k in 0..args.count {
            let mut ms = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            if items {
                find_modules(c_slice(args.data[k] as *u8), OPT_EXACT, &mut ms);
            }
            if ms.count > 0 {
                items_of_types = false;
            }
        }
        if !with_std && STD_MODULE < 0 && (!items || items_of_types) && !streq(cmd, c"grep")
            && !streq(cmd, c"type") && !streq(cmd, c"own") && wants_std(&args) {
            // (a NAME std defines and the program does not: asked again
            // with std)
            ask_with_std(argv);
        }
        let t = timer_now();
        let status = answer(cmd, &args, items, is_refs);
        timer_add(T_ANSWER, t);
        program_errors(c"warning", root, status != 0);
        // (the diagnostics after the answer: run_query)
        if cacheable {
            cache_save(root, 0);
        }
        status
    }
}

// The definitions answering to NAME, in order of position (none: after
// the diagnostic saying so, for command cmd). NAME is a path, or its end
// (see name_matches), or `FILE:LINE` (`FILE:LINE:COL`, as a compiler's
// error has it): the innermost item whose text holds that line (0.15: on
// a comment or blank line, the item below it; outside every item, as on
// a `use` line, what the name at COL, or the first on the line, names).
// Every spelling the tools print is taken (canonical_name).
pub fn resolve_name(cmd: *u8, name0: [u8], out: &mut IntVec) -> bool {
    unsafe {
        let name = canonical_name(name0);
        let mut line = -1;
        let mut col = -1;
        let mut file = name[0..0];
        let a = trailing_number(name);
        if a > 0 && name[a - 1] == ':' && (a < 2 || name[a - 2] != ':') {
            line = parse_digits(name[a..name.len]);
            file = name[0..a - 1];
            let b = trailing_number(file);
            if b > 0 && file[b - 1] == ':' && (b < 2 || file[b - 2] != ':') {
                // (FILE:LINE:COL)
                col = line;
                line = parse_digits(file[b..file.len]);
                file = file[0..b - 1];
            }
        }
        if line < 0 {
            find_defs(name, OPT_EXACT, out);
            if (*out).count == 0 && !OPT_EXACT {
                // (0.13: an import's other name, for what it imports)
                let at = alias_defs(last_segment(name), out);
                if at >= 0 {
                    let d = diag(c"note", c"query.alias");
                    buf_byte(d, '\'');
                    buf_bytes(d, last_segment(name));
                    buf_str(d, c"' is an import alias in ");
                    buf_bytes(d, mod_fqn_text(module_at(at)));
                    buf_str(d, c", for ");
                    buf_bytes(d, SYMS[DEFS[(*out).data[0]].fqn].text);
                    buf_byte(d, '\n');
                    sort_by_position(out);
                }
            }
            if (*out).count == 0 && name.len != name0.len && is_symbol(name0) {
                // (a symbol of a trait's default function: `T::f` is the
                // trait's `f`)
                find_defs(last_segment(name), OPT_EXACT, out);
            }
            if (*out).count == 0 && name.len > 5 && name[0..5] == "std::" {
                // (0.20) `std::NAME` that std re-exports from its modules:
                // the item it names (`std::read_line` is std::io::read_line)
                let rest = name[5..name.len];
                let mut cut = 0;
                while cut + 1 < rest.len && !(rest[cut] == ':' && rest[cut + 1] == ':') {
                    cut += 1;
                }
                let head = if cut + 1 < rest.len { rest[0..cut] } else { rest };
                let key = std_item_key(intern(head));
                if key >= 0 {
                    let full = buf_new();
                    buf_bytes(full, SYMS[key].text);
                    buf_bytes(full, rest[head.len..rest.len]);
                    find_defs(buf_slice(full), OPT_EXACT, out);
                }
            }
            if (*out).count == 0 && module_def(name, out) {
                return true;
            }
            if (*out).count == 0 && derived_note(&*cmd, name) {
                return false;
            }
            if (*out).count == 0 {
                no_match(cmd, name);
                return false;
            }
            return true;
        }
        let mut f = -1;
        for g in 0..FILE_COUNT {
            let p = file_text(g);
            if path_matches(p, file) {
                f = g;
                break;
            }
        }
        if f < 0 {
            let d = diag(c"error", c"query.no-match");
            buf_str(d, c"no file '");
            buf_bytes(d, file);
            buf_str(d, c"' in the program\n");
            try_end(try_begin(c"items", name[0..0], false));
            return false;
        }
        let mut d = def_at_line(f, line);
        if d < 0 {
            d = item_below(f, line);
        }
        if d < 0 && line >= 1 {
            let idx = line_index(FILES[f].start) + line - 1;
            if idx < LINES.count && LINES.data[idx] < FILES[f].end {
                let start = LINES.data[idx];
                let end = line_end(start);
                if col >= 1 && start + col - 1 <= end {
                    // (the name holding COL: it starts at or before it)
                    let mut p = start + col - 1;
                    while p > start && is_name_char(SRC[p - 1]) {
                        p -= 1;
                    }
                    d = def_used_at(p, end);
                } else {
                    d = def_used_at(start, end);
                }
            }
        }
        if d < 0 {
            let e = diag(c"error", c"query.no-match");
            buf_str(e, c"no item at ");
            buf_bytes(e, name);
            buf_byte(e, '\n');
            try_query(c"items", mod_fqn_text(FILES[f].module));
            return false;
        }
        out.push(d);
        true
    }
}

// The start of the run of digits that ends s (s.len: none).
pub fn trailing_number(s: [u8]) -> i64 {
    let mut i = s.len;
    while i > 0 && s[i - 1] >= '0' && s[i - 1] <= '9' {
        i -= 1;
    }
    if i == s.len { -1 } else { i }
}

pub fn parse_digits(s: [u8]) -> i64 {
    let mut n = 0;
    for i in 0..s.len {
        n = n * 10 + (s[i] - '0') as i64;
    }
    n
}

// The innermost definition (not a field or variant) of file f whose text
// (its comments and attributes included) holds line `line`, or -1.
pub fn def_at_line(f: i64, line: i64) -> i64 {
    unsafe {
        let idx = line_index(FILES[f].start) + line - 1;
        if line < 1 || idx >= LINES.count || LINES.data[idx] >= FILES[f].end + 1 {
            return -1;
        }
        let mut pos = LINES.data[idx];
        while pos < FILES[f].end && (SRC[pos] == ' ' || SRC[pos] == '\t') {
            pos += 1;
        }
        let mut best = -1;
        let mut best_size = 0;
        for d in 0..DEF_COUNT {
            let k = DEFS[d].kind;
            if k == K_FIELD || k == K_VARIANT || DEFS[d].start < FILES[f].start
                || DEFS[d].start >= FILES[f].end {
                continue;
            }
            if pos >= DEFS[d].end || pos < line_start(DEFS[d].start) {
                continue;
            }
            let from = text_start(d);
            if pos < from {
                continue;
            }
            if best < 0 || DEFS[d].end - from < best_size {
                best = d;
                best_size = DEFS[d].end - from;
            }
        }
        best
    }
}

// (0.14) NAME as `FILE:LINE` (or `FILE:LINE:COL`): the length of its FILE
// part, its line in *line; -1 when it is not one.
pub fn file_line(name: [u8], line: &mut i64) -> i64 {
    let a = trailing_number(name);
    if a < 2 || name[a - 1] != ':' || name[a - 2] == ':' {
        return -1;
    }
    let mut file = name[0..a - 1];
    *line = parse_digits(name[a..name.len]);
    let b = trailing_number(file);
    if b >= 2 && file[b - 1] == ':' && file[b - 2] != ':' {
        *line = parse_digits(file[b..file.len]);
        file = file[0..b - 1];
    }
    file.len
}

// (0.14) The file of the program named `file` (its path, or the end of it
// after a `/`), or -1.
pub fn file_named(file: [u8]) -> i64 {
    unsafe {
        for g in 0..FILE_COUNT {
            let p = file_text(g);
            if p.len > 0 && p[0] != '<' && path_matches(p, file) {
                return g;
            }
        }
        -1
    }
}

// The answer to the command, once the program is known; the NAMEs (or
// MODULEs) are `args`.
fn answer(cmd: *u8, args: &IntVec, items: bool, is_refs: bool) -> i64 {
    unsafe {
        let n = (*args).count;
        if items {
            if n == 0 {
                query_modules();
                return 0;
            }
            let mut modules = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            let mut types = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            let mut status = 0;
            for i in 0..n {
                let text = c_slice((*args).data[i] as *u8);
                let before = modules.count;
                find_modules(text, OPT_EXACT, &mut modules);
                // (0.20) `items std` is std's whole API: its modules' items
                // too, module by module
                if modules.count == before + 1 && modules.data[before] == STD_MODULE {
                    for m in 0..module_count() {
                        if m != STD_MODULE && within_std(m) && !is_within(m, ARCH_MODULE) {
                            modules.push(m);
                        }
                    }
                }
                if modules.count == before {
                    // (0.17: a type: its impl blocks' functions)
                    let mut defs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                    find_defs(text, OPT_EXACT, &mut defs);
                    let t0 = types.count;
                    for j in 0..defs.count {
                        let k = DEFS[defs.data[j]].kind;
                        if k == K_STRUCT || k == K_ENUM || k == K_TRAIT {
                            types.push(defs.data[j]);
                        }
                    }
                    if types.count == t0 {
                        no_module(text);
                        status = 1;
                    }
                }
            }
            if modules.count > 0 {
                query_items(&modules);
            }
            if types.count > 0 {
                query_type_items(&types);
            }
            return status;
        }
        if streq(cmd, c"stats") {
            return query_stats(if n == 0 { 0 as *u8 } else { (*args).data[0] as *u8 });
        }
        if streq(cmd, c"deps") {
            return query_deps(c_slice((*args).data[0] as *u8));
        }
        if streq(cmd, c"unused") {
            return query_unused(if n == 0 { 0 as *u8 } else { (*args).data[0] as *u8 });
        }
        if is_refs {
            if OPT_IN != 0 as *u8 && !resolve_in(c_slice(OPT_IN)) {
                let out = diag(c"error", c"query.bad-in");
                put_bad_in(out, OPT_IN);
                try_end(try_begin(cmd, c_slice((*args).data[0] as *u8), true));
                return 1;
            }
        }
        if streq(cmd, c"grep") {
            return query_grep(args);
        }
        if streq(cmd, c"callees") {
            // (0.16: callees.tach)
            let mut fns = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for i in 0..n {
                let mut matches = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                if !resolve_name(cmd, c_slice((*args).data[i] as *u8), &mut matches) {
                    return 1;
                }
                for j in 0..matches.count {
                    push_once(&mut fns, matches.data[j]);
                }
            }
            let mut table = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            if OPT_WRITES != 0 as *u8 && !resolve_name(cmd, c_slice(OPT_WRITES), &mut table) {
                return 1;
            }
            return query_callees(&fns, c_slice((*args).data[0] as *u8), &table);
        }
        // (0.17: similar.tach, examples.tach)
        if streq(cmd, c"similar") {
            return query_similar(args);
        }
        if streq(cmd, c"examples") {
            return query_examples(args);
        }
        if streq(cmd, c"context") {
            // (0.15: context.tach)
            let mut status = 0;
            for i in 0..n {
                let text = c_slice((*args).data[i] as *u8);
                let m = context_module(text);
                if m >= 0 {
                    query_context_module(m, text);
                    continue;
                }
                let mut matches = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                if !resolve_name(cmd, text, &mut matches) || query_context(text, &matches) != 0 {
                    status = 1;
                }
            }
            return status;
        }
        let mut status = 0;
        let mut all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut title_next = false;
        for i in 0..n {
            let text = c_slice((*args).data[i] as *u8);
            if title_next {
                title_next = false;
                continue;
            }
            if streq(cmd, c"type") {
                if query_type(text) != 0 {
                    status = 1;
                }
                continue;
            }
            // (0.17: ownat.tach)
            if streq(cmd, c"own") {
                if query_own(text) != 0 {
                    status = 1;
                }
                continue;
            }
            if streq(cmd, c"views") {
                // (0.17: a module's functions, values.tach)
                let m = context_module(text);
                if m >= 0 {
                    if query_views_module(m) != 0 {
                        status = 1;
                    }
                    continue;
                }
            }
            if streq(cmd, c"effects") {
                // (0.16: a module's functions, effects.tach)
                let m = context_module(text);
                if m >= 0 {
                    if query_effects_module(m) != 0 {
                        status = 1;
                    }
                    continue;
                }
            }
            if streq(cmd, c"show") && ends_with_c((*args).data[i] as *u8, c"::section") {
                // (MODULE::section TITLE)
                let title = if i + 1 < n { c_slice((*args).data[i + 1] as *u8) }
                    else { text[0..0] };
                title_next = true;
                let r = show_section(text, title);
                if r >= 0 {
                    if r != 0 {
                        status = r;
                    }
                    continue;
                }
                title_next = false;
            }
            if streq(cmd, c"show") {
                // (MODULE::use, ::header, ::extern)
                let r = show_region(text);
                if r >= 0 {
                    if r != 0 {
                        status = 1;
                    }
                    continue;
                }
            }
            if streq(cmd, c"refs") {
                // (0.16: a local, `FN::x` or FILE:LINE:COL)
                let r = local_refs(text);
                if r >= 0 {
                    if r != 0 {
                        status = r;
                    }
                    continue;
                }
            }
            let mut matches = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            if !resolve_name(cmd, text, &mut matches) {
                status = 1;
                continue;
            }
            if is_refs {
                for j in 0..matches.count {
                    push_once(&mut all, matches.data[j]);
                }
            } else if streq(cmd, c"impact") {
                status = query_impact(&matches, text);
            } else if streq(cmd, c"show") {
                if query_show(&matches, text) != 0 {
                    status = 1;
                }
            } else if streq(cmd, c"effects") {
                // (0.16, effects.tach)
                if query_effects(&matches) != 0 {
                    status = 1;
                }
            } else if streq(cmd, c"features") {
                // (0.19, features.tach)
                let r = crate::tools::query::features::query_features(&matches);
                if r != 0 {
                    status = r;
                }
            } else if streq(cmd, c"views") {
                // (0.17, values.tach)
                if query_views(&matches) != 0 {
                    status = 1;
                }
            } else {
                query_def(&matches);
            }
        }
        if is_refs && all.count > 0 {
            sort_by_position(&all);
            let name = c_slice((*args).data[0] as *u8);
            if query_refs(&all, cmd, name) != 0 {
                status = 1;
            }
        }
        status
    }
}
