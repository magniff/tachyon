// `query arch WORDS... [--feature F] [--arch A] [--equiv NAME]` (0.19,
// docs/design/arch.md §2.9; `query intrinsics` is the same command): the
// intrinsic tables searched without reading a program. One intrinsic a
// line, `MODULE::NAME<TAB>FEATURES<TAB>INSTRUCTION<TAB>DOC`, the best
// matches first: every WORD (any case) in its name, features, instruction,
// doc, semantics or equivalent; when no intrinsic has them all, those
// with the most. `--feature F` keeps those that need F (alone: lists
// them), `--arch aarch64|x86_64|portable` one table, `--equiv NAME` the
// other architecture's equivalent of NAME and the intrinsics naming NAME
// as theirs. The answer is cut at --budget as any query's (budget.vl).

use crate::arch::{
    ARCH_AARCH64, ARCH_PORTABLE, ARCH_X86_64, F_DOC, F_EQUIV, F_FEATURES, F_INSN, F_SEMANTICS,
    INTRS, intr_text, intrinsic_count, intrinsic_name, intrinsic_named,
};
use crate::arch::table::load_table;
use crate::arch::tables::intrinsics_source;
use crate::arch::virtual::QUERY_WANTED;
use crate::base::{
    IntVec, STDOUT, SYMS, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, buf_write_fd, intern,
    streq,
};
use crate::tools::query::{c_slice, parse_count};
use crate::tools::query::budget::OPT_BUDGET;
use crate::tools::query::diagnostics::{diag, put_cword, put_word};

fn lower(c: u8) -> u8 {
    if c >= 'A' && c <= 'Z' { c + 32 } else { c }
}

// Whether text holds word (lower case), ignoring case.
fn holds(text: [u8], word: [u8]) -> bool {
    if word.len == 0 || word.len > text.len {
        return false;
    }
    var i = 0;
    while i + word.len <= text.len {
        var k = 0;
        while k < word.len && lower(text[i + k]) == word[k] {
            k += 1;
        }
        if k == word.len {
            return true;
        }
        i += 1;
    }
    false
}

// Whether the comma-separated list holds the item (any case).
fn lists(list: [u8], item: [u8]) -> bool {
    var a = 0;
    while a < list.len {
        var b = a;
        while b < list.len && list[b] != ',' {
            b += 1;
        }
        var s = a;
        while s < b && list[s] == ' ' {
            s += 1;
        }
        var e = b;
        while e > s && list[e - 1] == ' ' {
            e -= 1;
        }
        if e - s == item.len {
            var k = 0;
            while k < item.len && lower(list[s + k]) == lower(item[k]) {
                k += 1;
            }
            if k == item.len {
                return true;
            }
        }
        a = b + 1;
    }
    false
}

// The module an intrinsic is in, below std::arch ("" for std::arch).
fn module_prefix(id: i64) -> [u8] {
    unsafe {
        let a = INTRS[id].arch;
        if a == ARCH_AARCH64 { "aarch64::" } else if a == ARCH_X86_64 { "x86_64::" } else { "" }
    }
}

// One intrinsic's line.
pub fn put_intrinsic_line(out: i64, id: i64) {
    unsafe {
        buf_bytes(out, module_prefix(id));
        buf_bytes(out, SYMS[intrinsic_name(id)].text);
        buf_byte(out, '\t');
        let f = intr_text(id, F_FEATURES);
        buf_bytes(out, if f == "-" { "-" } else { f });
        buf_byte(out, '\t');
        buf_bytes(out, intr_text(id, F_INSN));
        buf_byte(out, '\t');
        buf_bytes(out, intr_text(id, F_DOC));
        buf_byte(out, '\n');
    }
}

// The intrinsic named `name` (with or without its module path), or -1.
pub fn intrinsic_by_text(name0: [u8]) -> i64 {
    unsafe {
        var a = name0.len;
        while a > 0 && name0[a - 1] != ':' {
            a -= 1;
        }
        let name = name0[a..name0.len];
        for id in 0..intrinsic_count() {
            if SYMS[intrinsic_name(id)].text == name {
                return id;
            }
        }
        -1
    }
}

// Plain words and the table's spellings of them: a word matches when it
// or one of its spellings does (`subtract`: the names say `sub`).
const SPELLINGS: [[u8]; 28] = [
    "subtract", "sub", "multiply", "mul", "minimum", "min", "maximum", "max",
    "equal", "== b", "compare", "== b", "search", "== b", "find", "== b", "memchr", "== b",
    "popcount", "1 bits", "popcnt", "1 bits", "byte", "u8", "bytes", "u8", "checksum", "crc",
];

// Whether `word` is in text, or a spelling of it.
fn holds_word(text: [u8], word: [u8]) -> bool {
    if holds(text, word) {
        return true;
    }
    var i = 0;
    while i + 1 < 28 {
        if SPELLINGS[i] == word && holds(text, SPELLINGS[i + 1]) {
            return true;
        }
        i += 2;
    }
    false
}

// The tables' text, a line before the first (query_names_intrinsics).
static var TABLE_TEXT: i64 = -1;

// Whether a NAME of def, show, context... is an intrinsic (`vqsubq_u8`,
// `_mm_movemask_epi8`, or any `arch::NAME`): each one's id is then in
// QUERY_WANTED, which the loader declares (arch/virtual.vl), and the
// program is read with std.
pub fn query_names_intrinsics(args: IntVec) -> bool {
    unsafe {
        var any = false;
        for i in 0..args.count {
            let name = c_slice(args.data[i] as *u8);
            var a = name.len;
            while a > 0 && name[a - 1] != ':' {
                a -= 1;
            }
            let last = name[a..name.len];
            if last.len < 2 || !(last[0] == 'v' || last[0] == '_' || holds(name, "arch::")) {
                continue;
            }
            // (by the table's text: parsing it would intern its names before
            // the program's keywords)
            if TABLE_TEXT < 0 {
                TABLE_TEXT = buf_new();
                buf_byte(TABLE_TEXT, '\n');
                intrinsics_source(TABLE_TEXT);
            }
            let line = buf_new();
            buf_byte(line, '\n');
            buf_bytes(line, last);
            buf_bytes(line, " | ");
            if holds(buf_slice(TABLE_TEXT), buf_slice(line)) {
                QUERY_WANTED.push(args.data[i] + a);
                any = true;
            }
        }
        any
    }
}

// How well intrinsic id matches the words: 0 when it holds none; *k the
// number it holds.
fn score(id: i64, words: IntVec, k: inout i64) -> i64 {
    unsafe {
        let name = SYMS[intrinsic_name(id)].text;
        let feats = intr_text(id, F_FEATURES);
        var s = 0;
        k = 0;
        for w in 0..words.count {
            let word = buf_slice(words.data[w]);
            var hit = 0;
            if name.len == word.len && holds(name, word) {
                hit = 1000;
            } else if holds_word(name, word) {
                hit = 100;
            } else if lists(feats, word) {
                hit = 60;
            } else if holds_word(intr_text(id, F_INSN), word) {
                hit = 40;
            } else if holds_word(intr_text(id, F_DOC), word) {
                hit = 20;
            } else if holds_word(intr_text(id, F_SEMANTICS), word) {
                hit = 10;
            } else if holds_word(intr_text(id, F_EQUIV), word) {
                hit = 5;
            }
            if hit > 0 {
                k = k + 1;
                s += hit;
            }
        }
        s
    }
}

fn arch_of_text(a: *u8) -> i64 {
    unsafe {
        if streq(a, c"aarch64") || streq(a, c"arm64") || streq(a, c"neon") {
            ARCH_AARCH64
        } else if streq(a, c"x86_64") || streq(a, c"x86-64") || streq(a, c"x86") {
            ARCH_X86_64
        } else if streq(a, c"portable") || streq(a, c"std::arch") {
            ARCH_PORTABLE
        } else {
            -1
        }
    }
}

fn usage(message: *u8, arg: *u8) -> i64 {
    unsafe {
        let e = diag(c"error", c"query.usage");
        buf_str(e, message);
        if arg != 0 as *u8 {
            buf_str(e, c" '");
            buf_str(e, arg);
            buf_str(e, c"'");
        }
        buf_str(e,
            c" (query arch WORDS... [--feature F] [--arch aarch64|x86_64|portable] [--equiv NAME] [--budget N])\n");
        let t = crate::tools::query::diagnostics::diags();
        buf_str(t, c"try:");
        put_cword(t, crate::tools::query::diagnostics::PROG);
        buf_str(t, c" query arch 'saturating subtract'\n");
        2
    }
}

// `--equiv NAME`: NAME's line, its equivalent, the intrinsics that one
// names, and those whose equivalent names NAME.
fn equiv(out: i64, id: i64) {
    unsafe {
        put_intrinsic_line(out, id);
        let e = intr_text(id, F_EQUIV);
        buf_str(out, c"equivalent: ");
        buf_bytes(out, if e == "-" { "none recorded" } else { e });
        buf_byte(out, '\n');
        var shown = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        shown.push(id);
        // (the names in the equivalent's text)
        var a = 0;
        while a < e.len {
            while a < e.len
                && !(e[a] == '_' || e[a] >= 'a' && e[a] <= 'z' || e[a] >= '0' && e[a] <= '9') {
                a += 1;
            }
            var b = a;
            while b < e.len
                && (e[b] == '_' || e[b] >= 'a' && e[b] <= 'z' || e[b] >= '0' && e[b] <= '9') {
                b += 1;
            }
            if b > a {
                let other = intrinsic_by_text(e[a..b]);
                var seen = false;
                for k in 0..shown.count {
                    if shown.data[k] == other {
                        seen = true;
                    }
                }
                if other >= 0 && !seen {
                    shown.push(other);
                    put_intrinsic_line(out, other);
                }
            }
            a = b;
        }
        // (the intrinsics that name it as their equivalent)
        let name = SYMS[intrinsic_name(id)].text;
        for other in 0..intrinsic_count() {
            var seen = false;
            for k in 0..shown.count {
                if shown.data[k] == other {
                    seen = true;
                }
            }
            if !seen && holds(intr_text(other, F_EQUIV), name) {
                shown.push(other);
                put_intrinsic_line(out, other);
            }
        }
    }
}

pub fn run_query_arch(argc: i64, argv: **u8) -> i64 {
    unsafe {
        var words = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var feature = 0 as *u8;
        var arch = -1;
        var equiv_of = 0 as *u8;
        var i = 3;
        while i < argc {
            let a = argv[i];
            let valued = streq(a, c"--feature") || streq(a, c"--arch") || streq(a, c"--equiv")
                || streq(a, c"--budget");
            if valued && i + 1 >= argc {
                return usage(c"a value is missing after", a);
            }
            if streq(a, c"--feature") {
                feature = argv[i + 1];
                i += 1;
            } else if streq(a, c"--arch") {
                arch = arch_of_text(argv[i + 1]);
                if arch < 0 {
                    return usage(c"unknown architecture", argv[i + 1]);
                }
                i += 1;
            } else if streq(a, c"--equiv") {
                equiv_of = argv[i + 1];
                i += 1;
            } else if streq(a, c"--budget") {
                let n = parse_count(argv[i + 1]);
                if n < 0 {
                    return usage(c"--budget needs a number, not", argv[i + 1]);
                }
                OPT_BUDGET = n;
                i += 1;
            } else if streq(a, c"--all") {
                OPT_BUDGET = 0;
            } else if a[0] == '-' && a[1] == '-' {
                return usage(c"unknown option", a);
            } else {
                // (each word of the argument, lower case)
                let s = c_slice(a);
                var p = 0;
                while p < s.len {
                    while p < s.len && s[p] == ' ' {
                        p += 1;
                    }
                    let w = buf_new();
                    while p < s.len && s[p] != ' ' {
                        buf_byte(w, lower(s[p]));
                        p += 1;
                    }
                    if buf_slice(w).len > 0 {
                        words.push(w);
                    }
                }
            }
            i += 1;
        }
        load_table();
        let out = buf_new();
        if equiv_of != 0 as *u8 {
            let id = intrinsic_by_text(c_slice(equiv_of));
            if id < 0 {
                let e = diag(c"error", c"query.no-match");
                buf_str(e, c"no intrinsic '");
                buf_str(e, equiv_of);
                buf_str(e, c"'\n");
                let t = crate::tools::query::diagnostics::diags();
                buf_str(t, c"try:");
                put_cword(t, crate::tools::query::diagnostics::PROG);
                buf_str(t, c" query arch");
                put_word(t, c_slice(equiv_of));
                buf_byte(t, '\n');
                return 1;
            }
            equiv(out, id);
            buf_write_fd(out, STDOUT);
            return 0;
        }
        if words.count == 0 && feature == 0 as *u8 && arch < 0 {
            return usage(c"no words to search for", 0 as *u8);
        }
        let n = intrinsic_count();
        let scores = crate::base::alloc_array::<i64>(n + 1);
        let held = crate::base::alloc_array::<i64>(n + 1);
        var best = 0;
        for id in 0..n {
            scores[id] = -1;
            if arch >= 0 && INTRS[id].arch != arch {
                continue;
            }
            if feature != 0 as *u8 && !lists(intr_text(id, F_FEATURES), c_slice(feature)) {
                continue;
            }
            var k = 0;
            scores[id] = score(id, words, &k);
            held[id] = k;
            if k > best {
                best = k;
            }
        }
        // (all the words; else the most any intrinsic holds)
        var picked = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for id in 0..n {
            if scores[id] >= 0 && (words.count == 0 || best > 0 && held[id] == best) {
                picked.push(id);
            }
        }
        if picked.count == 0 {
            let e = diag(c"error", c"query.no-match");
            buf_str(e, c"no intrinsic matches");
            for w in 0..words.count {
                buf_byte(e, ' ');
                buf_bytes(e, buf_slice(words.data[w]));
            }
            if feature != 0 as *u8 {
                buf_str(e, c" with feature ");
                buf_str(e, feature);
            }
            buf_byte(e, '\n');
            let t = crate::tools::query::diagnostics::diags();
            buf_str(t, c"try:");
            put_cword(t, crate::tools::query::diagnostics::PROG);
            buf_str(t, c" guide arch#recipes\n");
            return 1;
        }
        // (the best first; the tables' order among equals: a stable sort)
        for a in 1..picked.count {
            var b = a;
            while b > 0 && scores[picked.data[b - 1]] < scores[picked.data[b]] {
                let t = picked.data[b];
                picked.data[b] = picked.data[b - 1];
                picked.data[b - 1] = t;
                b -= 1;
            }
        }
        for k in 0..picked.count {
            put_intrinsic_line(out, picked.data[k]);
        }
        buf_write_fd(out, STDOUT);
        if words.count > 0 && best < words.count {
            let e = diag(c"note", c"query.partial");
            buf_str(e, c"no intrinsic holds every word; these hold ");
            crate::base::buf_int(e, best);
            buf_str(e, c" of ");
            crate::base::buf_int(e, words.count);
            buf_byte(e, '\n');
        }
        0
    }
}
