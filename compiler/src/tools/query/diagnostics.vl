// The diagnostics of `query` and of the tools built on it: the command line
// as given (PROG, CMD, ROOT_GIVEN, TOOL), the `<severity> <code>: <message>`
// lines, the `try:` lines that give the command corrected, and the answer
// to a NAME that matches nothing (the nearest definitions, the modules).

use crate::base::{
    IntVec, STDERR, SYMS, buf_byte, buf_bytes, buf_clear, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, streq, strlen,
};
use crate::base::diag::{edit_distance, error_count, first_error_short};
use crate::base::json::{DIAG_JSON, json_tool_diags};
use crate::front::modules::{MODULES, module_count};
use crate::tools::query::{N_COMMANDS, QF_USE, command_name};
use crate::tools::query::command_line::{NOTES, PARSED};
use crate::tools::query::defs::{
    ALIASES, DEFS, DEF_COUNT, bytes_eq, def_of_node, last_segment, mod_fqn_text,
};
use crate::tools::query::show::find_modules;

// ---- Diagnostics ----
//
// On stderr, for agents and scripts (docs/query.md):
//   <severity> <code>: <message>
//   try: <command>          (0-3 lines, best first, ready to run)
// The codes are stable: query.no-match, query.alias, query.ambiguous,
// query.no-root, query.bad-root, query.program-errors, query.truncated,
// query.empty, query.bad-in, query.usage.

// The command line as given: how the compiler was run (argv[0]), the
// command, ROOT when it was given, and the options.
pub static var PROG: *u8 = 0 as *u8;
pub static var CMD: *u8 = 0 as *u8;
pub static var ROOT_GIVEN: *u8 = 0 as *u8;
pub static var OPT_EXACT: bool = false;
// The diagnostics so far (written last, after the answer).
static var DIAGS: i64 = -1;

pub fn diags() -> i64 {
    if DIAGS < 0 {
        DIAGS = buf_new();
    }
    DIAGS
}

// Starts a diagnostic: `<severity> <code>: `; its message follows.
pub fn diag(severity: *u8, code: *u8) -> i64 {
    unsafe {
        let out = diags();
        buf_str(out, severity);
        buf_byte(out, ' ');
        buf_str(out, code);
        buf_str(out, c": ");
        out
    }
}

// Whether s needs quoting for the shell.
fn needs_quotes(s: [u8]) -> bool {
    if s.len == 0 {
        return true;
    }
    for i in 0..s.len {
        let c = s[i];
        let plain = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
            || c == '_' || c == ':' || c == '.' || c == '/' || c == '-' || c == '+' || c == '='
            || c == ',';
        if !plain {
            return true;
        }
    }
    false
}

// A word of a command: ` s`, quoted when the shell needs it.
pub fn put_word(out: i64, s: [u8]) {
    buf_byte(out, ' ');
    if needs_quotes(s) {
        buf_byte(out, '\'');
        buf_bytes(out, s);
        buf_byte(out, '\'');
    } else {
        buf_bytes(out, s);
    }
}

pub fn put_cword(out: i64, s: *u8) {
    unsafe { put_word(out, s[0..strlen(s) as i64]); }
}

// Whether cmd is a command of `query` (the others, `replace`, `fix`...,
// are commands of their own, or of `edit`: see TOOL).
pub fn is_query_command(cmd: *u8) -> bool {
    for i in 0..N_COMMANDS {
        if unsafe { streq(cmd, command_name(i)) } {
            return true;
        }
    }
    false
}

// The words before a command that is not query's (`edit` for `replace`,
// `insert --after`, `delete`; 0: none, the command is the first word).
pub static var TOOL: *u8 = 0 as *u8;

// Starts a `try:` line: `try: PROG query CMD [NAME] [ROOT]` (NAME is a
// full path, or the one asked about: --exact is not needed), or `try:
// PROG [TOOL] CMD ...` for a command that is not query's;
// more words follow (put_word), then try_end.
pub fn try_begin(cmd: *u8, name: [u8], with_name: bool) -> i64 {
    unsafe {
        let out = diags();
        buf_str(out, c"try:");
        put_cword(out, PROG);
        if is_query_command(cmd) {
            buf_str(out, c" query ");
        } else if TOOL != 0 as *u8 {
            buf_byte(out, ' ');
            buf_str(out, TOOL);
            buf_byte(out, ' ');
        } else {
            buf_byte(out, ' ');
        }
        buf_str(out, cmd);
        if with_name {
            put_word(out, name);
        }
        put_root(out);
        out
    }
}

// ROOT as it was given (` ROOT`, or ` --root ROOT` when it does not end in
// .vl), for a command line.
pub fn put_root(out: i64) {
    unsafe {
        if ROOT_GIVEN != 0 as *u8 {
            if !crate::base::is_source_path(ROOT_GIVEN) {
                buf_str(out, c" --root");
            }
            put_cword(out, ROOT_GIVEN);
        }
    }
}

pub fn try_end(out: i64) {
    buf_byte(out, '\n');
}

// `try: PROG query CMD NAME`.
pub fn try_query(cmd: *u8, name: [u8]) {
    try_end(try_begin(cmd, name, true));
}

pub fn write_diags() {
    if DIAGS >= 0 {
        if DIAG_JSON {
            let j = buf_new();
            json_tool_diags(j, buf_slice(DIAGS));
            buf_write_fd(j, STDERR);
        } else {
            buf_write_fd(DIAGS, STDERR);
        }
        buf_clear(DIAGS);
    }
}

// The program had errors: their number (and, `first`, the first one), and
// how to see them all.
pub fn program_errors(severity: *u8, root: *u8, first: bool) {
    unsafe {
        if error_count() == 0 {
            return;
        }
        let out = diag(severity, c"query.program-errors");
        buf_int(out, error_count());
        buf_str(out, if error_count() == 1 { c" error" } else { c" errors" });
        buf_str(out,
            if PARSED { c" in the program; results may be incomplete" }
            else { c" in the program; nothing to answer with" });
        if first {
            buf_str(out, c"; first: ");
            first_error_short(out);
        }
        buf_str(out, c"\ntry:");
        put_cword(out, PROG);
        buf_str(out, c" --diagnostics=short");
        put_cword(out, root);
        buf_str(out, c" -c -o /dev/null\n");
    }
}

// The definitions nearest to `want` (its last segment), nearest first:
// at most `max`, in `found`.
fn nearest_defs(want: [u8], found: inout IntVec, max: i64) {
    unsafe {
        var limit = want.len / 3;
        if limit < 1 {
            limit = 1;
        }
        var dist = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for d in 0..DEF_COUNT {
            if DEFS[d].fqn < 0 {
                continue;
            }
            let k = edit_distance(want, SYMS[DEFS[d].name].text);
            if k <= limit {
                all.push(d);
                dist.push(k);
            }
        }
        // (nearest first, then by path)
        for i in 1..all.count {
            var j = i;
            while j > 0 && (dist.data[j] < dist.data[j - 1] || (dist.data[j] == dist.data[j - 1]
                && sym_less(DEFS[all.data[j]].fqn, DEFS[all.data[j - 1]].fqn))) {
                let t = all.data[j];
                all.data[j] = all.data[j - 1];
                all.data[j - 1] = t;
                let u = dist.data[j];
                dist.data[j] = dist.data[j - 1];
                dist.data[j - 1] = u;
                j -= 1;
            }
        }
        for i in 0..all.count {
            if found.count >= max {
                return;
            }
            push_once(&found, all.data[i]);
        }
    }
}

pub fn push_once(v: inout IntVec, x: i64) {
    unsafe {
        for i in 0..v.count {
            if v.data[i] == x {
                return;
            }
        }
        v.push(x);
    }
}

// The `try:` lines of an unanswered NAME: the definitions in `found`,
// else the module listing that could hold it.
fn try_found(cmd: *u8, name: [u8], found: IntVec) {
    unsafe {
        for i in 0..found.count {
            try_query(cmd, SYMS[DEFS[found.data[i]].fqn].text);
        }
        if found.count > 0 {
            return;
        }
        // `m::x`: the items of m, if there is such a module.
        var i = name.len - 1;
        while i > 0 && !(name[i] == ':' && name[i - 1] == ':') {
            i -= 1;
        }
        if i > 1 {
            var modules = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            find_modules(name[0..i - 1], false, &modules);
            if modules.count > 0 {
                try_query(c"items", mod_fqn_text(modules.data[0]));
                return;
            }
        }
        try_end(try_begin(c"items", name, false));
    }
}

// The definitions an import's other name `want` (`use a::f as want;`)
// imports, into found; the position of the first such import, or -1.
pub fn alias_defs(want: [u8], found: inout IntVec) -> i64 {
    unsafe {
        var alias_at = -1;
        var i = 0;
        while i < ALIASES.count {
            if bytes_eq(SYMS[ALIASES.data[i]].text, want) {
                var k = 0;
                while k < NOTES.count {
                    let d = def_of_node(NOTES.data[k + 2]);
                    if NOTES.data[k] == ALIASES.data[i + 1] && (NOTES.data[k + 3] & QF_USE) != 0
                        && d >= 0 {
                        push_once(&found, d);
                        if alias_at < 0 {
                            alias_at = NOTES.data[k];
                        }
                    }
                    k += 4;
                }
            }
            i += 2;
        }
        alias_at
    }
}

// No definition answers to `name`: the nearest names.
pub fn no_match(cmd: *u8, name: [u8]) {
    unsafe {
        let want = last_segment(name);
        var found = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let out = diag(c"error", c"query.no-match");
        buf_str(out, c"no definition '");
        buf_bytes(out, name);
        buf_str(out, c"'\n");
        nearest_defs(want, &found, 3);
        try_found(cmd, name, found);
    }
}

// No module answers to `name`.
pub fn no_module(name: [u8]) {
    unsafe {
        let out = diag(c"error", c"query.no-match");
        buf_str(out, c"no module '");
        buf_bytes(out, name);
        buf_str(out, c"'\n");
        let want = last_segment(name);
        var limit = want.len / 3;
        if limit < 1 {
            limit = 1;
        }
        var shown = 0;
        for m in 0..module_count() {
            if MODULES[m].name < 0 || shown >= 3 {
                continue;
            }
            if edit_distance(want, last_segment(mod_fqn_text(m))) <= limit {
                try_query(c"items", mod_fqn_text(m));
                shown += 1;
            }
        }
        if shown == 0 {
            try_end(try_begin(c"items", name, false));
        }
    }
}

pub fn sym_less(a: i64, b: i64) -> bool {
    unsafe {
        let x = SYMS[a].text;
        let y = SYMS[b].text;
        let n = if x.len < y.len { x.len } else { y.len };
        for i in 0..n {
            if x[i] != y[i] {
                return x[i] < y[i];
            }
        }
        x.len < y.len
    }
}
