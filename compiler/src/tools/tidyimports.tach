// `tachyonc fix --only tidy-imports` (0.12; docs/refactor.md): a
// module's `use` lines in the codebase's style. The `use` items of one
// module with the same path (and the same `pub`) become one, where the
// first of them is; its names are sorted (byte order: capitals first) and
// written `use p::a;` for one, `use p::{a, b};` when the line fits in 100
// columns, else wrapped:
//
//   use p::{
//       a, b, c,
//       d,
//   };
//
// A name imported under another name has a line of its own (`use p::a as
// b;`), after the others. A `use` with a comment on its lines, or sharing
// a line with other code, is left as it is; one with a comment right
// above it is not merged into another.
//
// `refactor move` and `split` tidy the imports of the files they edit
// (tidy_round: a round of `fix --only tidy-imports --tidy-edited` on the
// edited program), and so does `fix --only reexports,tidy-imports`.

use crate::base::{
    FILES, FILE_COUNT, IntVec, OVERLAY, SRC, SYMS, buf_byte, buf_bytes, buf_new, buf_slice, buf_str,
    streq,
};
use crate::front::ast::{NODES, NODE_COUNT, NodeKind, child};
use crate::front::modules::{file_of_pos, module_of};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::tools::edit::{TARGET_NAME, edit_replace};
use crate::tools::edit::apply::{copy_rewritten, overlay_args};
use crate::tools::edit::cli::delete_lines;
use crate::tools::edit::items::node_head;
use crate::tools::proc::run_capture;
use crate::tools::query::diagnostics::{PROG, sym_less};
use crate::tools::query::positions::{line_end, line_start};
use crate::tools::query::refs::ref_in;

const LINE_WIDTH: i64 = 100;

// `--tidy-edited` (a round run by an edit): only the files the edit
// changed or made (the overlays) are tidied.
pub static mut TIDY_EDITED: bool = false;

// Whether file f is tidied: a file of the program (with TIDY_EDITED, one
// the edit changed).
fn file_tidied(f: i64) -> bool {
    unsafe {
        if FILES[f].path[0] == '<' {
            return false;
        }
        if !TIDY_EDITED {
            return true;
        }
        let mut k = 0;
        while k < OVERLAY.count {
            if streq(OVERLAY.data[k] as *u8, FILES[f].path) {
                return true;
            }
            k += 2;
        }
        false
    }
}

// Whether Use item u imports names (not `*`, not a C header).
fn name_use(u: i64) -> bool {
    unsafe {
        NODES[u].kind == NodeKind::Use && NODES[u].d != 2 && NODES[u].b != 1 && NODES[u].count > 0
    }
}

// Whether Use item u has its lines to itself, without a comment: only
// blanks before it on its first line, and after it on its last.
fn alone(u: i64) -> bool {
    unsafe {
        let head = node_head(NODES[u].start);
        let mut p = line_start(head);
        while p < head {
            if SRC[p] != ' ' && SRC[p] != '\t' {
                return false;
            }
            p += 1;
        }
        let e = line_end(NODES[u].end - 1);
        for q in head..e {
            if SRC[q] == '/' && SRC[q + 1] == '/' {
                return false;
            }
        }
        for q in NODES[u].end..e {
            if SRC[q] != ' ' && SRC[q] != '\t' && SRC[q] != '\r' {
                return false;
            }
        }
        true
    }
}

// Whether the line above Use item u is a comment.
fn comment_above(u: i64) -> bool {
    unsafe {
        let ls = line_start(node_head(NODES[u].start));
        let f = file_of_pos(ls);
        if ls <= FILES[f].start {
            return false;
        }
        let mut p = line_start(ls - 1);
        while SRC[p] == ' ' || SRC[p] == '\t' {
            p += 1;
        }
        SRC[p] == '/' && SRC[p + 1] == '/'
    }
}

// The path of Use item u (its segments before the names), as a symbol.
pub fn use_path_sym(u: i64) -> i64 {
    unsafe {
        let path = NODES[u].c;
        let out = buf_new();
        for i in 0..NODES[path].count {
            if i > 0 {
                buf_str(out, c"::");
            }
            buf_bytes(out, SYMS[NODES[child(path, i)].a].text);
        }
        crate::base::intern(buf_slice(out))
    }
}

// The text of the `use` items importing `names` (symbols) and `aliased`
// (pairs: name, its new name) from `path`, indented by `indent`, `pub`
// when public: one line for one name, the names between braces on one
// line when it fits in LINE_WIDTH columns, else wrapped; then a line per
// aliased name. Names are sorted, each once. No newline after the last
// line.
pub fn put_use_text(out: i64, indent: [u8], public: bool, path: [u8], names: *IntVec,
    aliased: *IntVec) {
    unsafe {
        let mut plain = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..(*names).count {
            let n = (*names).data[i];
            let mut seen = false;
            for j in 0..plain.count {
                if plain.data[j] == n {
                    seen = true;
                }
            }
            if !seen {
                plain.push(n);
            }
        }
        for k in 1..plain.count {
            let mut j = k;
            while j > 0 && sym_less(plain.data[j], plain.data[j - 1]) {
                let t = plain.data[j];
                plain.data[j] = plain.data[j - 1];
                plain.data[j - 1] = t;
                j -= 1;
            }
        }
        let mut lines = 0;
        if plain.count > 0 {
            let line = buf_new();
            buf_bytes(line, indent);
            if public {
                buf_str(line, c"pub ");
            }
            buf_str(line, c"use ");
            buf_bytes(line, path);
            buf_str(line, c"::");
            let head = crate::base::BUFS[line].len;
            if plain.count > 1 {
                buf_byte(line, '{');
            }
            for i in 0..plain.count {
                if i > 0 {
                    buf_str(line, c", ");
                }
                buf_bytes(line, SYMS[plain.data[i]].text);
            }
            if plain.count > 1 {
                buf_byte(line, '}');
            }
            buf_byte(line, ';');
            if crate::base::BUFS[line].len <= LINE_WIDTH || plain.count == 1 {
                buf_bytes(out, buf_slice(line));
            } else {
                let s = buf_slice(line);
                buf_bytes(out, s[0..head]);
                buf_str(out, c"{\n");
                let mut col = 0;
                for i in 0..plain.count {
                    let w = SYMS[plain.data[i]].text;
                    if col > 0 && col + 2 + w.len + 1 > LINE_WIDTH {
                        buf_str(out, c",\n");
                        col = 0;
                    } else if col > 0 {
                        buf_str(out, c", ");
                        col += 2;
                    }
                    if col == 0 {
                        buf_bytes(out, indent);
                        buf_str(out, c"    ");
                        col = indent.len + 4;
                    }
                    buf_bytes(out, w);
                    col += w.len;
                }
                buf_str(out, c",\n");
                buf_bytes(out, indent);
                buf_str(out, c"};");
            }
            lines += 1;
        }
        let mut k = 0;
        while k < (*aliased).count {
            let a = (*aliased).data[k];
            let b = (*aliased).data[k + 1];
            let mut seen = false;
            let mut j = 0;
            while j < k {
                if (*aliased).data[j] == a && (*aliased).data[j + 1] == b {
                    seen = true;
                }
                j += 2;
            }
            k += 2;
            if seen {
                continue;
            }
            if lines > 0 {
                buf_byte(out, '\n');
            }
            buf_bytes(out, indent);
            if public {
                buf_str(out, c"pub ");
            }
            buf_str(out, c"use ");
            buf_bytes(out, path);
            buf_str(out, c"::");
            buf_bytes(out, SYMS[a].text);
            buf_str(out, c" as ");
            buf_bytes(out, SYMS[b].text);
            buf_byte(out, ';');
            lines += 1;
        }
    }
}

// The names of Use item u into names, and its renamed ones (name, new
// name) into aliased.
pub fn use_names(u: i64, names: *IntVec, aliased: *IntVec) {
    unsafe {
        for k in 0..NODES[u].count {
            let id = child(u, k);
            if NODES[id].b != 0 {
                aliased.push(NODES[id].a);
                aliased.push(NODES[id].b);
            } else {
                names.push(NODES[id].a);
            }
        }
    }
}

// The edits tidying the imports; how many `use` items they rewrite or
// merge away.
pub fn tidy_import_edits() -> i64 {
    unsafe {
        let mut fixes = 0;
        for f in 0..FILE_COUNT {
            if !file_tidied(f) {
                continue;
            }
            let mut uses = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for u in 1..NODE_COUNT {
                if name_use(u) && file_of_pos(NODES[u].start) == f && ref_in(NODES[u].start)
                    && alone(u) {
                    uses.push(u);
                }
            }
            let mut done = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for i in 0..uses.count {
                done.push(0);
            }
            for i in 0..uses.count {
                if done.data[i] != 0 {
                    continue;
                }
                let u = uses.data[i];
                let public = (NODES[u].p & ITEM_PUBLIC) != 0;
                let path = use_path_sym(u);
                let m = module_of(u);
                // Its group: the later ones of the module with its path.
                let mut group = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                group.push(u);
                for j in i + 1..uses.count {
                    let v = uses.data[j];
                    if done.data[j] == 0 && module_of(v) == m
                        && ((NODES[v].p & ITEM_PUBLIC) != 0) == public
                        && use_path_sym(v) == path && !comment_above(v) {
                        group.push(v);
                        done.data[j] = 1;
                    }
                }
                let mut names = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                let mut aliased = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                for g in 0..group.count {
                    use_names(group.data[g], &names, &aliased);
                }
                let from = line_start(node_head(NODES[u].start));
                let text = buf_new();
                put_use_text(text, SRC[from..node_head(NODES[u].start)], public, SYMS[path].text,
                    &names, &aliased);
                // (unchanged: the group is on consecutive lines, and is the text)
                let mut consecutive = true;
                for g in 1..group.count {
                    let v = group.data[g];
                    if line_start(node_head(NODES[v].start))
                        != line_end(NODES[group.data[g - 1]].end - 1) + 1 {
                        consecutive = false;
                    }
                }
                let last = group.data[group.count - 1];
                if consecutive
                    && crate::tools::proc::same_bytes(buf_slice(text), SRC[from..NODES[last].end]) {
                    continue;
                }
                if !edit_replace(from, NODES[u].end, text) {
                    continue;
                }
                for g in 1..group.count {
                    let v = group.data[g];
                    delete_lines(line_start(node_head(NODES[v].start)), NODES[v].end);
                }
                fixes += group.count;
            }
        }
        fixes
    }
}

// The round of `fix --only tidy-imports --tidy-edited` an edit runs on
// the program it edited (refactor move, split): the files whose imports
// it tidied have their new texts. False when it could not run (then the
// edit stands as it is).
pub fn tidy_round(root: *u8) -> bool {
    unsafe {
        let mut args = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        args.push(PROG as i64);
        args.push(c"fix" as i64);
        args.push(c"--round" as i64);
        args.push(c"--only" as i64);
        args.push(c"tidy-imports" as i64);
        args.push(c"--tidy-edited" as i64);
        if TARGET_NAME != 0 as *u8 {
            args.push(c"--target" as i64);
            args.push(TARGET_NAME as i64);
        }
        overlay_args(&args);
        args.push(root as i64);
        args.push(0);
        let out = buf_new();
        if run_capture(args.data as **u8, out) != 0 {
            return false;
        }
        let t = buf_slice(out);
        let mut i = 0;
        while i < t.len {
            let mut e = i;
            while e < t.len && t[e] != '\n' {
                e += 1;
            }
            let line = t[i..e];
            if line.len > 5 && line[0] == 'f' && line[4] == '\t' {
                copy_rewritten(line[5..line.len]);
            }
            i = e + 1;
        }
        true
    }
}
