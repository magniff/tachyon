// (0.20) fmt's respellings of conventions (docs/design/conventions.md D9,
// §2.1): a receiver in its short form, `self: inout Self` → `inout self`,
// `self: let Self` → `self`, `self: sink Self` → `sink self` (one meaning
// in every spelling); and with `--syntax=0.20`, where a parameter is let
// unless it says otherwise, a written `let` dropped from a parameter's or
// a function type's convention (`x: let T` → `x: T`, `fn(let T)` →
// `fn(T)`). Only these tokens change: the layout is laid on the result.

use crate::base::{IntVec, buf_bytes, buf_new};
use crate::front::conv::STRICT;
use crate::tools::fmt::pieces::{MATCH, P_END, P_KIND, P_START, is_comment, piece};

// The next piece after i that is no comment nor blank (P_KIND.count: none).
fn next_tok(i: i64) -> i64 {
    unsafe {
        let mut j = i + 1;
        while j < P_KIND.count && (is_comment(P_KIND.data[j]) || P_KIND.data[j] == 0) {
            j += 1;
        }
        j
    }
}

fn prev_tok(i: i64) -> i64 {
    unsafe {
        let mut j = i - 1;
        while j >= 0 && (is_comment(P_KIND.data[j]) || P_KIND.data[j] == 0) {
            j -= 1;
        }
        j
    }
}

fn is(i: i64, w: [u8]) -> bool {
    unsafe { i >= 0 && i < P_KIND.count && piece(i) == w }
}

// Whether `(` piece i opens a parameter list: of `fn name(`, `fn
// name<..>(`, or a function type `fn(`.
fn params_open(i: i64) -> bool {
    unsafe {
        let p = prev_tok(i);
        if is(p, "fn") {
            return true;
        }
        if is(p, ">") {
            // (`fn name<T: A>(`: back to the `<` the `>` closes)
            let mut depth = 0;
            let mut j = p;
            while j >= 0 {
                if is(j, ">") {
                    depth += 1;
                } else if is(j, "<") {
                    depth -= 1;
                    if depth == 0 {
                        break;
                    }
                }
                j -= 1;
            }
            let name = prev_tok(j);
            return name >= 0 && is(prev_tok(name), "fn");
        }
        p >= 0 && is(prev_tok(p), "fn") && P_KIND.data[p] > 0
    }
}

// The text respelled into a buffer, or -1 when nothing changes. The
// pieces of text are read (read_pieces).
pub fn respell_conventions(text: [u8]) -> i64 {
    unsafe {
        let out = buf_new();
        let mut at = 0;
        let mut changed = false;
        // (the closing pieces of the parameter lists the walk is in)
        let mut closes = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut i = 0;
        while i < P_KIND.count {
            if closes.count > 0 && i == closes.data[closes.count - 1] {
                closes.count -= 1;
            }
            if is(i, "(") && params_open(i) && i < MATCH.count && MATCH.data[i] > i {
                closes.push(MATCH.data[i]);
            }
            // `self: inout Self` / `self: let Self` / `self: sink Self`
            if is(i, "self") && is(next_tok(i), ":") {
                let c = next_tok(next_tok(i));
                let s = next_tok(c);
                let after = next_tok(s);
                if (is(c, "inout") || is(c, "let") || is(c, "sink")) && is(s, "Self")
                    && (is(after, ",") || is(after, ")")) && !is(prev_tok(i), "inout")
                    && !is(prev_tok(i), "sink") {
                    buf_bytes(out, text[at..P_START.data[i]]);
                    buf_bytes(out, if is(c, "inout") { "inout self" }
                        else if is(c, "sink") { "sink self" } else { "self" });
                    at = P_END.data[s];
                    changed = true;
                    i = s + 1;
                    continue;
                }
            }
            // `x: let T` in a parameter list, `fn(let T)`: let is the default
            if STRICT && closes.count > 0 && is(i, "let") {
                let p = prev_tok(i);
                let depth_ok = enclosing_open(i) >= 0
                    && MATCH.data[enclosing_open(i)] == closes.data[closes.count - 1];
                if depth_ok && (is(p, ":") || is(p, "(") || is(p, ",")) {
                    buf_bytes(out, text[at..P_START.data[i]]);
                    at = P_START.data[next_tok(i)];
                    changed = true;
                    i += 1;
                    continue;
                }
            }
            i += 1;
        }
        if !changed {
            return -1;
        }
        buf_bytes(out, text[at..text.len]);
        out
    }
}

// The bracket piece that piece i is directly in, or -1.
fn enclosing_open(i: i64) -> i64 {
    unsafe {
        let mut j = i - 1;
        while j >= 0 {
            if j < MATCH.count && MATCH.data[j] > i && (is(j, "(") || is(j, "[") || is(j, "{")
                || is(j, "<")) {
                return j;
            }
            if j < MATCH.count && MATCH.data[j] >= 0 && MATCH.data[j] < j {
                // (a closing bracket: past its opening one)
                j = MATCH.data[j];
            }
            j -= 1;
        }
        -1
    }
}
