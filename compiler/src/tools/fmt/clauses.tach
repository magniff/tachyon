// The layout of 0.18's syntax (docs/design/contracts-verification.md
// §2.14, phase 0): clauses after a signature are continuation lines and
// the body's `{` on a line of its own is at the signature's level; the
// line after an `invariant` starts a new item; `distinct *T` is a type,
// its `*` a prefix. T9 owns the rest of the clauses' layout.

use crate::front::lexer::Tok;
use crate::tools::fmt::pieces::{P_KIND, is_comment, kind, piece};

// Whether piece i is the identifier `word`.
fn is_ident(i: i64, word: [u8]) -> bool {
    i >= 0 && kind(i) == Tok::Ident as i64 && piece(i) == word
}

// The code piece after i (comments skipped), or -1.
fn next_code(i: i64) -> i64 {
    let mut j = i + 1;
    unsafe {
        while j < P_KIND.count && is_comment(kind(j)) {
            j += 1;
        }
        if j < P_KIND.count { j } else { -1 }
    }
}

// Whether a line whose first code piece is f is a clause of a signature:
// `requires`, `ensures`, `debug requires`, `debug ensures`.
pub fn starts_clause(f: i64) -> bool {
    if is_ident(f, "debug") {
        let g = next_code(f);
        return is_ident(g, "requires") || is_ident(g, "ensures");
    }
    is_ident(f, "requires") || is_ident(f, "ensures")
}

// Whether a line whose first code piece is f is a type's invariant:
// `invariant ...` or `debug invariant ...`.
pub fn starts_invariant(f: i64) -> bool {
    if is_ident(f, "debug") {
        return is_ident(next_code(f), "invariant");
    }
    is_ident(f, "invariant")
}

// Whether piece j, before a `*`, makes it a prefix: `distinct *T`; 0.20's
// `x: sink *T` (a raw pointer the callee owns), `inout *T`, `let *T`.
pub fn before_prefix_star(j: i64) -> bool {
    is_ident(j, "distinct")
        || (is_ident(j, "sink") || is_ident(j, "inout") || is_ident(j, "let"))
        && j + 1 < P_KIND.count && kind(j + 1) == Tok::Star as i64
}
