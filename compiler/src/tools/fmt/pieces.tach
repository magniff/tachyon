// The pieces of a text for `tachyonc fmt` (0.13): its tokens, as the
// compiler's lexer makes them, and its comments, in order. A piece is a
// byte range of the text, its kind (a Tok as i64, or LINE_COMMENT,
// BLOCK_COMMENT) and the number of line breaks before it (the first
// piece's counts as one). The text is lexed in place of SRC, with a
// recovery point: a text that does not lex is reported, never fatal.
// Then the brackets are matched (MATCH), and a formatted text is checked
// against its original: the same pieces, byte for byte.

use crate::base::{IntVec, SRC, _setjmp, buf_slice};
use crate::base::diag::{
    ERR, ERR_KIND, RECOVER_DEPTH, errors_forget, errors_mark, recover_enter, recover_leave,
};
use crate::front::lexer::{TOKS, TOK_COUNT, Tok, lex_range};

pub const LINE_COMMENT: i64 = -1;
pub const BLOCK_COMMENT: i64 = -2;

// The text being formatted, and its pieces.
pub static mut FT: [u8] = "";
pub static mut P_START: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut P_END: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut P_KIND: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut P_NL: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The other bracket of each bracket piece (-1 for the others).
pub static mut MATCH: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// (0.15) Whether each piece is inside an f-string: in a hole, or its
// middle or tail text (1), or not (0); its head is not. fmt breaks no
// line there.
pub static mut IN_F: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Why the text could not be read: the message and its byte offset.
pub static mut BAD_MESSAGE: [u8] = "";
pub static mut BAD_AT: i64 = 0;

fn clear(v: &mut IntVec) {
    unsafe { (*v).count = 0; }
}

fn push_piece(start: i64, end: i64, kind: i64, nl: i64) {
    P_START.push(start);
    P_END.push(end);
    P_KIND.push(kind);
    P_NL.push(nl);
}

// The comments in text[from..to) (blanks and comments only), as pieces;
// `nl` counts the line breaks before the first. Returns the line breaks
// after the last.
fn gap_pieces(from: i64, to: i64, nl: i64) -> i64 {
    unsafe {
        let t = FT;
        let mut breaks = nl;
        let mut i = from;
        while i < to {
            let c = t[i];
            if c == '\n' {
                breaks += 1;
                i += 1;
            } else if c == '/' && i + 1 < to && t[i + 1] == '/' {
                let s = i;
                while i < to && t[i] != '\n' {
                    i += 1;
                }
                // (as written, trailing blanks too: a test directive may end with one)
                push_piece(s, i, LINE_COMMENT, breaks);
                breaks = 0;
            } else if c == '/' && i + 1 < to && t[i + 1] == '*' {
                let s = i;
                let mut depth = 0;
                while i < to {
                    if t[i] == '/' && i + 1 < to && t[i + 1] == '*' {
                        depth += 1;
                        i += 2;
                    } else if t[i] == '*' && i + 1 < to && t[i + 1] == '/' {
                        depth -= 1;
                        i += 2;
                        if depth == 0 {
                            break;
                        }
                    } else {
                        i += 1;
                    }
                }
                push_piece(s, i, BLOCK_COMMENT, breaks);
                breaks = 0;
            } else {
                i += 1;
            }
        }
        breaks
    }
}

// Reads `text` into pieces (FT, P_*); false when it does not lex
// (BAD_MESSAGE, BAD_AT say why).
pub fn read_pieces(text: [u8]) -> bool {
    unsafe {
        FT = text;
        clear(&mut P_START);
        clear(&mut P_END);
        clear(&mut P_KIND);
        clear(&mut P_NL);
        clear(&mut MATCH);
        let first = TOK_COUNT;
        let saved = SRC;
        let mark = errors_mark();
        let depth = RECOVER_DEPTH;
        let mut ok = true;
        let error_kind = ERR_KIND;
        ERR_KIND = c"tokenizer error";
        // (the lexer reads SRC, up to the length it is given)
        SRC = text.ptr;
        if _setjmp(recover_enter()) == 0 {
            lex_range(0, text.len, false);
        } else {
            ok = false;
        }
        recover_leave(depth);
        SRC = saved;
        ERR_KIND = error_kind;
        if !ok {
            BAD_MESSAGE = buf_slice(ERR);
            BAD_AT = if TOK_COUNT > first { TOKS[TOK_COUNT - 1].end } else { 0 };
            errors_forget(mark);
            TOK_COUNT = first;
            return false;
        }
        let mut at = 0;
        let mut nl = 1;
        for k in first..TOK_COUNT {
            nl = gap_pieces(at, TOKS[k].start, nl);
            push_piece(TOKS[k].start, TOKS[k].end, TOKS[k].kind as i64, nl);
            nl = 0;
            at = TOKS[k].end;
        }
        gap_pieces(at, text.len, nl);
        TOK_COUNT = first;
        match_brackets()
    }
}

// MATCH; false when the brackets do not balance (BAD_MESSAGE, BAD_AT).
fn match_brackets() -> bool {
    unsafe {
        let mut stack = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        clear(&mut IN_F);
        let mut in_f = 0;
        for i in 0..P_KIND.count {
            MATCH.push(-1);
            let k = P_KIND.data[i];
            // (0.15: an f-string's holes, up to its tail)
            IN_F.push(in_f);
            if k == Tok::FHead as i64 && P_END.data[i] > P_START.data[i]
                && FT[P_END.data[i] - 1] == '{' {
                in_f = 1;
            } else if k == Tok::FTail as i64 {
                in_f = 0;
            }
            if is_open(k) {
                stack.push(i);
            } else if is_close(k) {
                if stack.count == 0 || P_KIND.data[stack.data[stack.count - 1]] != k - 1 {
                    BAD_MESSAGE = "unbalanced brackets";
                    BAD_AT = P_START.data[i];
                    return false;
                }
                let o = stack.pop();
                MATCH.data[o] = i;
                MATCH.data[i] = o;
            }
        }
        if stack.count > 0 {
            BAD_MESSAGE = "unclosed bracket";
            BAD_AT = P_START.data[stack.data[stack.count - 1]];
            return false;
        }
        true
    }
}

pub fn is_open(k: i64) -> bool {
    k == Tok::LParen as i64 || k == Tok::LBrace as i64 || k == Tok::LBracket as i64
}

pub fn is_close(k: i64) -> bool {
    k == Tok::RParen as i64 || k == Tok::RBrace as i64 || k == Tok::RBracket as i64
}

pub fn is_comment(k: i64) -> bool {
    k < 0
}

// The text of piece i.
pub fn piece(i: i64) -> [u8] {
    unsafe { FT[P_START.data[i]..P_END.data[i]] }
}

pub fn kind(i: i64) -> i64 {
    unsafe { P_KIND.data[i] }
}

// Whether two texts have the same pieces (the formatter's check: only
// blanks changed). Reads both; the pieces left are `after`'s.
pub fn same_pieces(before: [u8], after: [u8]) -> bool {
    unsafe {
        if !read_pieces(before) {
            return false;
        }
        let n = P_KIND.count;
        let starts = P_START;
        let ends = P_END;
        let kinds = P_KIND;
        P_START = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        P_END = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        P_KIND = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let ok = read_pieces(after) && P_KIND.count == n;
        let mut same = ok;
        let mut i = 0;
        while same && i < n {
            let a = before[starts.data[i]..ends.data[i]];
            let b = piece(i);
            if kinds.data[i] != P_KIND.data[i] || a.len != b.len {
                same = false;
            } else {
                for j in 0..a.len {
                    if a[j] != b[j] {
                        same = false;
                    }
                }
            }
            i += 1;
        }
        same
    }
}

// The line (1-based) of byte offset `at` of text.
pub fn line_of(text: [u8], at: i64) -> i64 {
    unsafe {
        let mut line = 1;
        let mut i = 0;
        while i < at && i < text.len {
            if text[i] == '\n' {
                line += 1;
            }
            i += 1;
        }
        line
    }
}
