// `tachyonc fix --only reexports` (0.12; docs/refactor.md): the imports
// and paths that reach an item through a re-export (a `pub use` of
// another module, or an import of an ancestor module: `use crate::f`
// where the root imports f) are written from the module that defines the
// item; then the re-exports nothing uses any more go (a name still used
// in its own file stays, as a private import).
//
// A re-export with a comment line `// api: ...` right above it is the
// module's interface: it stays, and so do the imports through it. With
// `--in FILE|MODULE`, only the imports and paths there are rewritten, and
// only the re-exports there removed.
//
// A module that a path goes through is found from the path's words
// (`crate`, `self`, `super`, child modules, a module imported by name);
// what the path names is the checker's (the program's references).

use crate::base::{FILES, IntVec, SRC, SYMS, alloc_zeroed, buf_bytes, buf_new, buf_str, intern_c};
use crate::front::ast::{NODES, NODE_COUNT, child};
use crate::front::lexer::{TOKS, TOK_COUNT, Tok};
use crate::front::modules::{MODULES, child_module, file_of_pos, module_at, module_count, module_of};
use crate::front::modules::lookup::{SYM_CRATE, SYM_SUPER};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::middle::lower::ssa::HMap;
use crate::tools::edit::cli::delete_lines;
use crate::tools::edit::items::node_head;
use crate::tools::query::{QF_DEF, QF_USE};
use crate::tools::query::defs::{
    DEFS, K_IMPL_METHOD, K_METHOD, K_MOD, K_VARIANT, MOD_DEF, mod_fqn, mod_fqn_text,
};
use crate::tools::query::positions::{line_start, token_at};
use crate::tools::query::refs::{R_DEF, R_FLAGS, R_POS, ref_in};
use crate::tools::refactor_mod::{
    REFS, chain_public, load_refs, path_start, put_edit, qualified, use_binding, use_binding_id,
    use_def, use_local, use_node_of,
};
use crate::tools::refactor_mod::cli::is_name_use;
use crate::tools::tidyimports::{put_use_text, use_path_sym};

static mut SYM_SELF: i64 = -1;

// The module that segment `name` of a path leads to from module `cur`
// (the first segment: from module `from`, the path's own); -1 when it is
// no module (an item, an enum, std's).
fn step(cur: i64, name: i64, first: bool, from: i64) -> i64 {
    unsafe {
        if SYM_SELF < 0 {
            SYM_SELF = intern_c(c"self");
        }
        if cur < 0 {
            return -1;
        }
        if first && name == SYM_CRATE {
            return 0;
        }
        if first && name == SYM_SELF {
            return from;
        }
        if name == SYM_SUPER {
            return if cur > 0 { MODULES[cur].parent } else { -1 };
        }
        let c = child_module(cur, name);
        if c >= 0 || !first {
            return c;
        }
        // (a module imported by name: `use crate::a::b;` then `b::f`)
        let d = use_binding(from, name);
        if d >= 0 && DEFS[d].kind == K_MOD {
            for m in 1..module_count() {
                if MOD_DEF.data[m] == d {
                    return m;
                }
            }
        }
        -1
    }
}

// The module the path of Use item u leads to (-1: none).
fn use_via(u: i64) -> i64 {
    unsafe {
        let path = NODES[u].c;
        let from = module_of(u);
        let mut cur = from;
        for i in 0..NODES[path].count {
            cur = step(cur, NODES[child(path, i)].a, i == 0, from);
        }
        if NODES[path].count == 0 { -1 } else { cur }
    }
}

// The module the path before the name at pos leads to (`a::b::NAME`), or
// -1.
fn path_via(pos: i64) -> i64 {
    unsafe {
        let from = module_at(pos);
        let mut i = token_at(path_start(pos));
        let end = token_at(pos);
        let mut cur = from;
        let mut first = true;
        while i < end {
            if TOKS[i].kind == Tok::Ident {
                cur = step(cur, TOKS[i].value as i64, first, from);
                first = false;
            }
            i += 1;
        }
        cur
    }
}

// Whether definition d is an item imports and paths name (not a module, a
// method, a variant, a field).
fn plain_item(d: i64) -> bool {
    unsafe {
        let k = DEFS[d].kind;
        DEFS[d].parent < 0 && k != K_MOD && k != K_METHOD && k != K_IMPL_METHOD && k != K_VARIANT
    }
}

// Whether Use item u is marked as the module's interface: a comment line
// `// api: ...` in the comment lines right above it.
fn api_marked(u: i64) -> bool {
    unsafe {
        let f = file_of_pos(NODES[u].start);
        let mut ls = line_start(node_head(NODES[u].start));
        while ls > FILES[f].start {
            let prev = line_start(ls - 1);
            let mut p = prev;
            while SRC[p] == ' ' || SRC[p] == '\t' {
                p += 1;
            }
            if SRC[p] != '/' || SRC[p + 1] != '/' {
                return false;
            }
            p += 2;
            while SRC[p] == ' ' {
                p += 1;
            }
            if SRC[p] == 'a' && SRC[p + 1] == 'p' && SRC[p + 2] == 'i' && SRC[p + 3] == ':' {
                return true;
            }
            ls = prev;
        }
        false
    }
}

// Whether identifier `name` is written in file f outside SRC[a..b).
fn named_in_file(name: i64, f: i64, a: i64, b: i64) -> bool {
    unsafe {
        let mut i = token_at(FILES[f].start);
        while i < TOK_COUNT && TOKS[i].start < FILES[f].end {
            if TOKS[i].kind == Tok::Ident && TOKS[i].value as i64 == name
                && (TOKS[i].start < a || TOKS[i].start >= b) {
                return true;
            }
            i += 1;
        }
        false
    }
}

// Whether something goes through the import (or re-export) of `name` in
// module m: an import or a path of another module whose words lead to m
// (`use crate::m::name`, `m::name(...)`, `m::name::Variant`), that the
// fix does not rewrite. So it is not unused although its own file does
// not name it (`fix --only unused`, `query unused`).
pub fn reached_through(m: i64, name: i64) -> bool {
    unsafe {
        for u in 1..NODE_COUNT {
            if !is_name_use(u) || module_of(u) == m {
                continue;
            }
            let path = NODES[u].c;
            let from = module_of(u);
            let mut cur = from;
            for i in 0..NODES[path].count {
                let a = NODES[child(path, i)].a;
                if i > 0 && cur == m && a == name {
                    return true;
                }
                cur = step(cur, a, i == 0, from);
            }
            if cur != m {
                continue;
            }
            for k in 0..NODES[u].count {
                let c = child(u, k);
                if NODES[c].a == name && NEW_HOME.get(c) == 0 {
                    return true;
                }
            }
        }
        for i in 2..TOK_COUNT {
            if TOKS[i].kind == Tok::Ident && TOKS[i].value as i64 == name
                && TOKS[i - 1].kind == Tok::ColonColon && REWRITTEN.get(TOKS[i].start + 1) == 0
                && module_at(TOKS[i].start) != m && FILES[file_of_pos(TOKS[i].start)].path[0] != '<'
                && path_via(TOKS[i].start) == m {
                return true;
            }
        }
        false
    }
}

// What the fix does to the name (Ident node) of a `use`: its new module
// (+1), whether it is dropped or made private; the paths it rewrites
// (position of the name + 1).
static mut NEW_HOME: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static mut DROP: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static mut DEMOTE: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static mut REWRITTEN: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

// The re-export (an Ident node of a `use` of module via) that importing
// `name` from via goes through, when it is not the interface (`// api:`);
// 0 for none.
fn reexport_of(via: i64, name: i64) -> i64 {
    unsafe {
        let r = use_binding_id(via, name);
        if r == 0 || api_marked(use_node_of(r)) {
            return 0;
        }
        r
    }
}

// The edits of `fix --only reexports`: how many imports and paths are
// rewritten; *dropped, how many re-exports go (or become private).
pub fn reexport_edits(dropped: &mut i64) -> i64 {
    unsafe {
        load_refs();
        let mut fixes = 0;
        // The imports through a re-export.
        let mut touched = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for u in 1..NODE_COUNT {
            if !is_name_use(u) {
                continue;
            }
            let via = use_via(u);
            if via < 0 {
                continue;
            }
            let mut any = false;
            for k in 0..NODES[u].count {
                let id = child(u, k);
                let d = use_def(id);
                if d < 0 || !plain_item(d) || DEFS[d].module == via {
                    continue;
                }
                let r = reexport_of(via, NODES[id].a);
                if r == 0 {
                    continue;
                }
                if !ref_in(NODES[u].start) {
                    continue;
                }
                NEW_HOME.put(id, DEFS[d].module + 1);
                chain_public(module_of(u), DEFS[d].module);
                any = true;
                fixes += 1;
            }
            if any {
                touched.push(u);
            }
        }
        // The paths through one: `a::reexported(...)`.
        for k in 0..REFS.count {
            let r = REFS.data[k];
            let p = R_POS.data[r];
            let d = R_DEF.data[r];
            if (R_FLAGS.data[r] & (QF_DEF | QF_USE)) != 0 || !plain_item(d) || !qualified(p)
                || FILES[file_of_pos(p)].path[0] == '<' {
                continue;
            }
            let ti = token_at(p);
            if ti >= TOK_COUNT || TOKS[ti].start != p || TOKS[ti].kind != Tok::Ident {
                continue;
            }
            let via = path_via(p);
            if via < 0 || via == DEFS[d].module {
                continue;
            }
            if reexport_of(via, TOKS[ti].value as i64) == 0 || !ref_in(p)
                || TOKS[token_at(path_start(p)) - 1].kind == Tok::Use {
                continue;
            }
            REWRITTEN.put(p + 1, 1);
            let b = buf_new();
            buf_bytes(b, mod_fqn_text(DEFS[d].module));
            buf_str(b, c"::");
            buf_bytes(b, SYMS[DEFS[d].name].text);
            put_edit(path_start(p), TOKS[ti].end, b);
            chain_public(module_at(p), DEFS[d].module);
            fixes += 1;
        }
        // The re-exports nothing goes through any more.
        for u in 1..NODE_COUNT {
            if !is_name_use(u) || (NODES[u].p & ITEM_PUBLIC) == 0 || !ref_in(NODES[u].start)
                || api_marked(u) {
                continue;
            }
            let f = file_of_pos(NODES[u].start);
            let mut any = false;
            for k in 0..NODES[u].count {
                let id = child(u, k);
                if reached_through(module_of(u), use_local(id)) {
                    continue;
                }
                if named_in_file(use_local(id), f, NODES[u].start, NODES[u].end) {
                    DEMOTE.put(id, 1);
                } else {
                    DROP.put(id, 1);
                }
                *dropped += 1;
                any = true;
            }
            if any {
                let mut seen = false;
                for i in 0..touched.count {
                    if touched.data[i] == u {
                        seen = true;
                    }
                }
                if !seen {
                    touched.push(u);
                }
            }
        }
        for i in 0..touched.count {
            rewrite_use(touched.data[i]);
        }
        fixes
    }
}

// Use item u's new text: its names under their paths (its own, or their
// new modules'), `pub` as it was (or not, made private), the dropped ones
// gone; its lines removed when none is left.
fn rewrite_use(u: i64) {
    unsafe {
        let public = (NODES[u].p & ITEM_PUBLIC) != 0;
        let head = node_head(NODES[u].start);
        let from = line_start(head);
        let mut blank = true;
        for p in from..head {
            if SRC[p] != ' ' && SRC[p] != '\t' {
                blank = false;
            }
        }
        // The groups: (path symbol, pub) in order of first name.
        let mut g_path = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut g_pub = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut g_names = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut g_alias = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let own = use_path_sym(u);
        // (the names that keep its path first, then the others)
        for x in 0..2 * NODES[u].count {
            let k = x % NODES[u].count;
            let id = child(u, k);
            if DROP.get(id) != 0 || (NEW_HOME.get(id) != 0) != (x >= NODES[u].count) {
                continue;
            }
            let h = NEW_HOME.get(id) - 1;
            let path = if h >= 0 { mod_fqn(h) } else { own };
            let pb = public && DEMOTE.get(id) == 0;
            let mut g = -1;
            for j in 0..g_path.count {
                if g_path.data[j] == path && (g_pub.data[j] != 0) == pb {
                    g = j;
                }
            }
            if g < 0 {
                g = g_path.count;
                g_path.push(path);
                g_pub.push(if pb { 1 } else { 0 });
                let names = alloc_vec();
                let alias = alloc_vec();
                g_names.push(names);
                g_alias.push(alias);
            }
            // (the name it is defined with, under the name it had here)
            let d = use_def(id);
            let real = if h >= 0 && d >= 0 { DEFS[d].name } else { NODES[id].a };
            let local = use_local(id);
            if real == local {
                (g_names.data[g] as *IntVec).push(real);
            } else {
                (g_alias.data[g] as *IntVec).push(real);
                (g_alias.data[g] as *IntVec).push(local);
            }
        }
        if g_path.count == 0 {
            if blank {
                delete_lines(from, NODES[u].end);
            } else {
                put_edit(head, NODES[u].end, buf_new());
            }
            return;
        }
        let text = buf_new();
        let indent = if blank { SRC[from..head] } else { SRC[from..from] };
        for j in 0..g_path.count {
            if j > 0 {
                buf_str(text, c"\n");
            }
            put_use_text(text, indent, g_pub.data[j] != 0, SYMS[g_path.data[j]].text,
                g_names.data[j] as *IntVec, g_alias.data[j] as *IntVec);
        }
        put_edit(if blank { from } else { head }, NODES[u].end, text);
    }
}

// A new, empty IntVec (its address, as an i64).
fn alloc_vec() -> i64 {
    unsafe {
        alloc_zeroed(24) as i64
    }
}
