// `--help` on every command (0.15): `tachyonc CMD [SUB] --help` prints
// the rows of the tools table (AGENTS.md, docs/query.md) for that
// command, at most 15 lines; `tachyonc --help` lists the commands. The
// language is in `tachyonc guide`, a diagnostic code in `tachyonc
// explain CODE`.

use crate::base::{STDOUT, buf_bytes, buf_new, buf_str, buf_write_fd, streq, strlen};

// One command's help: `cmd` is `edit` or `edit patch`.
struct Help { cmd: [u8], text: [u8] }

const HELP_COUNT: i64 = 32;

static HELP: [Help; 32] = [
    Help { cmd: "", text: "tachyonc FILE.tach -o prog        compile (cc links); -c object, -S assembly\n\
tachyonc check [ROOT]               the front end's errors, one line each\n\
tachyonc try 'STATEMENTS'           run a snippet with std: its value and output\n\
tachyonc query CMD NAME...          read a program by name (def, show, context, refs, grep...)\n\
tachyonc edit CMD NAME ...          change items by name (patch, replace, insert, delete...)\n\
tachyonc refactor CMD ...           rename, move, signature, field, variant, extract, inline\n\
tachyonc rewrite 'OLD' 'NEW'        typed search and replace\n\
tachyonc fix                        missing imports, unused, pub, unsafe blocks\n\
tachyonc fmt FILE|MODULE|--all      lay code out\n\
tachyonc undo                       take the last edit back\n\
tachyonc guide [TOPIC|--find WORDS] the language; tachyonc explain CODE: a diagnostic\n\
tachyonc lint, same-output, --version; CMD --help for each\n" },
    Help { cmd: "query", text: "tachyonc query def|show NAME...            where it is defined | its source (--with-comments)\n\
tachyonc query context NAME [--budget N]   source, calls, types, callers in one answer\n\
tachyonc query refs|callers NAME           every use | every call (--count, --in FILE|MODULE, --kind)\n\
tachyonc query grep TEXT                   text that is not a name (--comments, --strings, --code, --word)\n\
tachyonc query items [MODULE]              a module's items with signatures (--comments: banners)\n\
tachyonc query type FILE:LINE:COL          the type of an expression\n\
tachyonc query text FILE:A-B               lines of any file (std:A-B: std's source)\n\
tachyonc query stats|deps|unused|impact    sizes, dependencies, what nothing uses, what a change touches\n\
tachyonc query diff                        what the last edit changed\n\
NAME: f, m::f, Type::method, Enum::Variant, Struct.field, FILE:LINE[:COL], std::f\n\
--budget N: answers cut to about N tokens (default 8000; context 2000); --root ROOT\n" },
    Help { cmd: "edit", text: "tachyonc edit patch NAME --old 'TEXT' --new 'TEXT'   change lines inside an item (pairs repeat)\n\
tachyonc edit insert --in NAME --after 'ANCHOR' < text   add statements inside an item\n\
tachyonc edit replace NAME < new.tach                  replace an item\n\
tachyonc edit insert --after|--before NAME < item.tach  add an item\n\
tachyonc edit delete NAME                              remove an item\n\
tachyonc edit wrap NAME --in unsafe [--lines A-B]      wrap a body or lines in a block\n\
tachyonc edit new-file PATH < text                     a new file with its mod line\n\
--show: the diff after; --dry-run: the diff only; --no-check: write despite new errors\n" },
    Help { cmd: "edit patch", text: "tachyonc edit patch NAME|FILE:LINE --old 'TEXT' --new 'TEXT' [--old ... --new ...]\n\
  several lines: --pairs FILE (or stdin), blocks <<<<<<< OLD / ======= / >>>>>>> NEW\n\
  --loose: other indentation; --show, --dry-run, --no-check\n" },
    Help { cmd: "edit insert", text: "tachyonc edit insert --after|--before NAME < item.tach     add an item\n\
tachyonc edit insert --in NAME --after|--before 'ANCHOR' < text   add statements inside an item\n" },
    Help { cmd: "edit replace", text: "tachyonc edit replace NAME < new.tach   replace an item (MODULE::use, MODULE::header too)\n" },
    Help { cmd: "edit delete", text: "tachyonc edit delete NAME   remove an item\n" },
    Help { cmd: "edit wrap", text: "tachyonc edit wrap NAME --in unsafe|loop [--lines A-B]   wrap a body or lines in a block, re-indented\n" },
    Help {
        cmd: "edit new-file",
        text: "tachyonc edit new-file PATH < text   make a file, with its mod line in its parent\n"
    },
    Help { cmd: "refactor", text: "tachyonc refactor rename PATH NEW                    anything (a module: its file too), every reference\n\
tachyonc refactor move PATH... --to MODULE           items to another module, imports and pub fixed\n\
tachyonc refactor new-module crate::a::b             a module (move-module crate::a crate::x::a: move one)\n\
tachyonc refactor split MODULE --plan                a module into files (--auto, --into M --items a,b)\n\
tachyonc refactor signature FN --add 'x: i64 = 0'    a parameter, every call (--remove, --rename-param, --reorder, --type)\n\
tachyonc refactor field STRUCT --add 'g: i64 = 0'    a field, every literal (--remove, --rename, --type)\n\
tachyonc refactor variant ENUM --add 'X(i64)' --arm 'EXPR'   a variant, every match (--remove, --rename)\n\
tachyonc refactor extract-function FN --lines A-B --to NEW   lines into a new function\n\
tachyonc refactor inline FN [--at FILE:LINE]         a small function's body at its calls\n\
tachyonc refactor --script steps.txt                 several, checked once, all or nothing\n\
--dry-run: the diff only\n" },
    Help { cmd: "refactor rename", text: "tachyonc refactor rename PATH NEW   rename an item, field, variant, module (its file too), local (FN::x or FILE:LINE:COL)\n" },
    Help { cmd: "refactor move", text: "tachyonc refactor move PATH... --to MODULE [--after|--before ITEM]   move items, imports and pub fixed\n" },
    Help {
        cmd: "refactor new-module",
        text: "tachyonc refactor new-module crate::a::b   make a module (its file and mod line)\n"
    },
    Help {
        cmd: "refactor move-module", text: "tachyonc refactor move-module crate::a crate::x::a   move a module: file, folder, paths\n"
    },
    Help { cmd: "refactor split", text: "tachyonc refactor split MODULE --plan   then --auto, or --into M --items a,b (--names a,b; --reexport; --header TEXT)\n" },
    Help { cmd: "refactor signature", text: "tachyonc refactor signature FN --add 'x: i64 = 0'   with every call\n\
  --remove x, --rename-param a b, --reorder b,a, --type x T --default '$x as T'\n" },
    Help { cmd: "refactor field", text: "tachyonc refactor field STRUCT --add 'g: i64 = 0'   with every literal (--remove g, --rename g h, --type g T)\n" },
    Help { cmd: "refactor variant", text: "tachyonc refactor variant ENUM --add 'X(i64)' --arm 'EXPR'   an arm in each match (--arm-in FN 'EXPR'; --remove V; --rename V W)\n" },
    Help { cmd: "refactor extract-function", text: "tachyonc refactor extract-function FN --lines A-B --to NEW   parameters and result computed\n" },
    Help {
        cmd: "refactor inline",
        text: "tachyonc refactor inline FN [--at FILE:LINE]   its body at each call (and delete it)\n"
    },
    Help { cmd: "rewrite", text: "tachyonc rewrite 'grow($v, $n)' '$v.reserve($n)' --where '$v: *IntVec' --dry-run   an idiom everywhere, typed (--in FILE|MODULE)\n" },
    Help { cmd: "fix", text: "tachyonc fix   every machine-applicable fix: imports, unused, pub, unsafe\n\
  --only imports,unused,pub,unsafe,reexports,tidy-imports,std015; --in FILE|MODULE; --dry-run\n\
  (std015, asked for only: 0.14's parse_int, next_int, read_line, read_stdin calls given .ok(), .unwrap_or(false), .unwrap())\n" },
    Help { cmd: "check", text: "tachyonc check [ROOT]   the front end's errors, one line each (FILE:L:C: error[KIND] MESSAGE | help: ...)\n" },
    Help {
        cmd: "fmt",
        text: "tachyonc fmt FILE|MODULE   lay code out (--check, --dry-run; --all the tree)\n"
    },
    Help { cmd: "undo", text: "tachyonc undo   take the last edit back (the journal: .git, else .tachyonc/ next to main.tach)\n" },
    Help { cmd: "lint", text: "tachyonc lint --max-lines N   files over a size\n" },
    Help {
        cmd: "same-output",
        text: "tachyonc same-output OLD_TACHYONC   prove a refactoring changed no output\n"
    },
    Help { cmd: "explain", text: "tachyonc explain CODE   what a diagnostic code means, how to fix it (explain TOOL: its codes; explain --list)\n\
tachyonc explain WORDS  a word or a compiler message: the guide's paragraphs about it\n" },
    Help { cmd: "guide", text: "tachyonc guide [TOPIC...]        the core guide, or topics (--list: the topics; --all)\n\
tachyonc guide TOPIC#SECTION     one section (guide TOPIC#: its sections)\n\
tachyonc guide --find WORDS      the paragraphs about WORDS, each with its topic#section\n\
--budget N: about N tokens at most\n" },
    Help { cmd: "try", text: "tachyonc try 'STATEMENTS'   run a snippet (std imported, in fn main): the last expression's type and value, the output\n\
tachyonc try --file F.tach  the same for a file (items and statements, or a whole program)\n\
tachyonc try -              the snippet from stdin\n" },
    Help { cmd: "query context", text: "tachyonc query context NAME... [--budget TOKENS]   the source, the signatures it calls and uses, its callers\n\
tachyonc query context MODULE                      its banners and items, then its most used bodies\n" },
    Help { cmd: "query grep", text: "tachyonc query grep TEXT...   text that is not a name, with its item (--comments, --strings, --code, --word, --in, --count)\n" },
];

fn c_slice(s: *u8) -> [u8] {
    unsafe { s[0..strlen(s) as i64] }
}

// Whether an argument asks for help.
pub fn is_help(s: *u8) -> bool {
    unsafe { streq(s, c"--help") || streq(s, c"-h") }
}

// The help of `tachyonc CMD [SUB]` (argv[1], argv[2] when it is a word):
// the exit status.
pub fn run_help(argc: i64, argv: **u8) -> i64 {
    unsafe {
        let out = buf_new();
        let cmd = if argc >= 2 && !is_help(argv[1]) && !streq(argv[1], c"help") { c_slice(argv[1]) }
            else { "" };
        let sub = buf_new();
        buf_bytes(sub, cmd);
        if argc >= 3 && cmd.len > 0 && argv[2][0] != '-' {
            buf_bytes(sub, " ");
            buf_bytes(sub, c_slice(argv[2]));
        }
        let want = crate::base::buf_slice(sub);
        let mut found = -1;
        for i in 0..HELP_COUNT {
            if HELP[i].cmd == want {
                found = i;
            }
        }
        if found < 0 {
            for i in 0..HELP_COUNT {
                if HELP[i].cmd == cmd {
                    found = i;
                }
            }
        }
        if found < 0 {
            found = 0;
        }
        buf_bytes(out, HELP[found].text);
        buf_write_fd(out, STDOUT);
        0
    }
}
