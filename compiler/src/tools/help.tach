    },
    Help { cmd: "refactor split", text: "tachyonc refactor split MODULE --plan   then --auto, or --into M --items a,b (--names a,b; --reexport; --header TEXT)\n" },
    Help { cmd: "refactor signature", text: "tachyonc refactor signature FN --add 'x: i64 = 0'   with every call\n\
  --add declares a default, calls unchanged (--fill-calls: each call gets 0)\n\
  --remove x, --rename-param a b, --reorder b,a, --type x T --default '$x as T'\n\
  --type x '&mut T' (0.17): the calls' &v become &mut v, a value v becomes &mut v (&T: &v; &mut [T]: v.as_mut_slice())\n" },
    Help { cmd: "refactor field", text: "tachyonc refactor field STRUCT --add 'g: i64 = 0'   with every literal (--remove g, --rename g h, --type g T [--default '$g.as_slice()'])\n" },
    Help { cmd: "refactor variant", text: "tachyonc refactor variant ENUM --add 'X(i64)' --arm 'EXPR'   an arm in each match (--arm-in FN 'EXPR'; --remove V; --rename V W)\n" },
    Help { cmd: "refactor extract-function", text: "tachyonc refactor extract-function FN --lines A-B --to NEW   parameters and result computed\n" },
    Help {
        cmd: "refactor inline",
        text: "tachyonc refactor inline FN [--at FILE:LINE]   its body at each call (and delete it)\n"
    },
    Help { cmd: "rewrite", text: "tachyonc rewrite 'grow($v, $n)' '$v.reserve($n)' --where '$v: *IntVec' --dry-run   an idiom everywhere, typed (--in FILE|MODULE|ITEM, repeated)\n\
  --list (PATTERN alone too): a line per site, what its holes matched; --where '$v: name ~ RE' or $v~/RE/: names only\n\
  --subst 'PATTERN' 'REPL': inside the code the holes keep; a hole the pattern lacks is a new name (`for $x in`)\n" },
    Help { cmd: "fix", text: "tachyonc fix   every machine-applicable fix: imports, unused, pub, unsafe\n\
  --suggested: the exact fixes the errors' `try: tachyonc fix --suggested` names (a did-you-mean\n\
    name with one candidate, a conversion, a path from crate::, a Rust spelling, a missing use or\n\
    pub, a missing `gpa` argument), one checked edit; prints the errors left (--at FILE:LINE: one line's)\n\
  --only imports,unused,pub,unsafe,suggested,reexports,tidy-imports,std015; --in FILE|MODULE; --dry-run, --show\n\
  --use PATH::NAME: the module to import NAME from when several as near have it (fix.ambiguous)\n\
  (std015, asked for only: 0.14's parse_int, next_int, read_line, read_stdin calls given .ok(), .unwrap_or(false), .unwrap())\n\
  --values (0.17, or --only values): parameters to references, with every call: *T written through\n\
    -> &mut T (&x -> &mut x), else &T; a written [T] -> &mut [T]; an owned value only read -> &T (v -> &v)\n" },
    Help { cmd: "check", text: "tachyonc check [ROOT]   the front end's errors, one line each (FILE:L:C: error[KIND] MESSAGE | help: ...)\n" },
    Help {
        cmd: "fmt",
        text: "tachyonc fmt FILE|MODULE   lay code out (--check, --dry-run; --all the tree)\n"
    },
    Help { cmd: "undo", text: "tachyonc undo   take the last edit back (the journal: .git, else .tachyonc/ next to main.tach)\n" },
    Help { cmd: "lint", text: "tachyonc lint --max-lines N   files over a size\n" },
    Help {
        cmd: "same-output",
        text: "tachyonc same-output OLD_TACHYONC   prove a refactoring changed no output\n"
    },
    Help { cmd: "explain", text: "tachyonc explain CODE   what a diagnostic code means, how to fix it (explain TOOL: its codes; explain --list)\n\
tachyonc explain WORDS  a word or a compiler message: the guide's paragraphs about it\n" },
    Help { cmd: "guide", text: "tachyonc guide [TOPIC...]        the core guide (2k tokens), or topics (--list; --all; --full: the long form)\n\
tachyonc guide TOPIC#SECTION     one section (guide TOPIC#: its sections; TOPIC SECTION too)\n\
tachyonc guide how [TASK]        recipes for adding a std function, a pass, a diagnostic, a test...\n\
tachyonc guide --find WORDS      the paragraphs about WORDS, each with its topic#section\n\
--budget N: about N tokens at most\n" },
    Help { cmd: "try", text: "tachyonc try 'STATEMENTS'   run a snippet (std imported, in fn main): the last expression's type and value, the output\n\
tachyonc try --file F.tach  the same for a file (items and statements, or a whole program)\n\
tachyonc try -              the snippet from stdin\n" },
    Help { cmd: "test", text: "tachyonc test [FILTER...] [ROOT.tach]   build if needed, run the tests; a summary: counts, then each failure\n\
  a program: tests/NAME.in (stdin) with tests/NAME.out (expected stdout), NAME.exit (status); --dir DIR\n\
  the tachyon tree: target/tachyonc rebuilt when older than compiler/src, then tests/run.sh FILTER\n\
  --budget N (tokens, 1000), --full (every failure), --input FILE (one run), --timeout S, -O N\n\
  (0.17) built with --trace: a crash or a time limit shows its line and callers (--no-trace)\n\
  (0.17) the tachyon tree: each failure run again with target/tools/tachyonc: new, or failing\n\
  before too (--against TACHYONC; --against none)\n" },
    Help { cmd: "probe", text: "tachyonc probe FILE:LINE [EXPR...]... [-- ARGS] [--input FILE]   run the program with EXPRs printed at LINE\n\
  each FILE:LINE starts a probe: before the statement that begins the line; after a `let`;\n\
  in a loop's body each time round; at the start of a block the line opens (`} else {`)\n\
  --count FILE:LINE (how often it runs), --max N (values printed, 10), --timeout S (10),\n\
  -O N, --root ROOT; the source is not changed (guide debug)\n" },
    Help { cmd: "reduce", text: "tachyonc reduce FILE --until 'CMD'   FILE's lines left out while CMD still exits 0\n\
  {} in CMD: the candidate (`./prog < {}; test $? = 101`); the result: FILE.min (--out F)\n\
  --max-runs N (500), --timeout S per run (5)\n" },
    Help { cmd: "query context", text: "tachyonc query context NAME... [--budget TOKENS]   the source, the signatures it calls and uses, its callers\n\
tachyonc query context MODULE                      its banners and items, then its most used bodies\n" },
    Help { cmd: "query grep", text: "tachyonc query grep TEXT...   text that is not a name, with its item (--comments, --strings, --code, --word, --in, --count)\n" },
];

fn c_slice(s: *u8) -> [u8] {
    unsafe { s[0..strlen(s) as i64] }
}

// Whether an argument asks for help.
pub fn is_help(s: *u8) -> bool {
    unsafe { streq(s, c"--help") || streq(s, c"-h") }
}

// The help of `tachyonc CMD [SUB]` (argv[1], argv[2] when it is a word):
// the exit status.
pub fn run_help(argc: i64, argv: **u8) -> i64 {
    unsafe {
        let out = buf_new();
        let cmd = if argc >= 2 && !is_help(argv[1]) && !streq(argv[1], c"help") { c_slice(argv[1]) }
            else { "" };
        let sub = buf_new();
        buf_bytes(sub, cmd);
        if argc >= 3 && cmd.len > 0 && argv[2][0] != '-' {
            buf_bytes(sub, " ");
            buf_bytes(sub, c_slice(argv[2]));
        }
        let want = crate::base::buf_slice(sub);
        let mut found = -1;
        for i in 0..HELP_COUNT {
            if HELP[i].cmd == want {
                found = i;
            }
        }
        if found < 0 {
            for i in 0..HELP_COUNT {
                if HELP[i].cmd == cmd {
                    found = i;
                }
            }
        }
        if found < 0 {
            found = 0;
        }
        buf_bytes(out, HELP[found].text);
        buf_write_fd(out, STDOUT);
        0
    }
}
