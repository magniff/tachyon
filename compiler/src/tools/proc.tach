// Processes and files for the tools of 0.11 (edit, fix, check,
// same-output): running a program and collecting its output, waiting for
// several at once, and the file operations an edit needs (a file written
// whole and renamed into place, directories, absolute paths).

use crate::base::{
    BUFS, alloc_array, buf_byte, buf_bytes, buf_new, buf_reserve, buf_str, fclose, fopen, fread,
    fwrite, strlen,
};

extern "C" {
    fn fork() -> i32;
    fn execvp(file: *u8, argv: **u8) -> i32;
    fn waitpid(pid: i32, status: *i32, options: i32) -> i32;
    fn pipe(fds: *i32) -> i32;
    fn dup2(from: i32, to: i32) -> i32;
    fn close(fd: i32) -> i32;
    fn read(fd: i32, buf: *u8, n: u64) -> i64;
    fn _exit(code: i32) -> !;
    fn rename(from: *u8, to: *u8) -> i32;
    fn unlink(path: *u8) -> i32;
    fn mkdir(path: *u8, mode: i32) -> i32;
    fn rmdir(path: *u8) -> i32;
    fn creat(path: *u8, mode: i32) -> i32;
    fn getcwd(buf: *u8, size: u64) -> *u8;
    fn realpath(path: *u8, resolved: *u8) -> *u8;
    fn isatty(fd: i32) -> i32;
}

// The status of a process as waitpid gives it: its exit code, or 128 +
// the signal that ended it.
fn exit_code(status: i32) -> i64 {
    let s = status as i64;
    if (s & 127) == 0 { (s >> 8) & 255 } else { 128 + (s & 127) }
}

// Runs argv (argv[0] found as a shell finds it; argv ends with 0), its
// stdout and stderr into buffer `out`; returns its exit status (127 when
// it could not be run).
pub fn run_capture(argv: **u8, out: i64) -> i64 {
    unsafe {
        let fds = alloc_array::<i32>(2);
        if pipe(fds) != 0 {
            return 127;
        }
        let pid = fork();
        if pid < 0 {
            return 127;
        }
        if pid == 0 {
            dup2(fds[1], 1);
            dup2(fds[1], 2);
            close(fds[0]);
            close(fds[1]);
            execvp(argv[0], argv);
            _exit(127);
        }
        close(fds[1]);
        loop {
            buf_reserve(out, 65536);
            let got = read(fds[0], &BUFS[out].data[BUFS[out].len], 65536);
            if got <= 0 {
                break;
            }
            BUFS[out].len += got;
        }
        close(fds[0]);
        let mut status = 0 as i32;
        waitpid(pid, &status, 0);
        exit_code(status)
    }
}

// Starts argv with its stdout and stderr into file `path` (made anew);
// returns its process id, or -1.
pub fn spawn_to_file(argv: **u8, path: *u8) -> i64 {
    unsafe {
        let pid = fork();
        if pid < 0 {
            return -1;
        }
        if pid == 0 {
            let fd = creat(path, 420);
            if fd >= 0 {
                dup2(fd, 1);
                dup2(fd, 2);
                close(fd);
            }
            execvp(argv[0], argv);
            _exit(127);
        }
        pid as i64
    }
}

// Starts a copy of this process (fork): 0 in the copy, its process id in
// the caller, -1 on failure.
pub fn fork_worker() -> i64 {
    unsafe { fork() as i64 }
}

// Ends a copy made by fork_worker.
pub fn worker_exit(code: i64) -> ! {
    unsafe { _exit(code as i32) }
}

// Waits for any child: its process id (-1: none left), its exit status in
// *status.
pub fn wait_any(status: *i64) -> i64 {
    unsafe {
        let mut st = 0 as i32;
        let pid = waitpid(-1, &st, 0);
        *status = exit_code(st);
        pid as i64
    }
}

// Reads file `path` into buffer `out`; false when it cannot be read.
pub fn read_file_if(path: *u8, out: i64) -> bool {
    unsafe {
        let file = fopen(path, c"rb");
        if file == 0 as *u8 {
            return false;
        }
        loop {
            buf_reserve(out, 65536);
            let got = fread(&BUFS[out].data[BUFS[out].len], 1, 65536, file);
            BUFS[out].len += got as i64;
            if got == 0 {
                break;
            }
        }
        fclose(file);
        true
    }
}

// Writes bytes to file `path` (made anew); false when it cannot.
pub fn write_file_if(path: *u8, bytes: [u8]) -> bool {
    unsafe {
        let file = fopen(path, c"wb");
        if file == 0 as *u8 {
            return false;
        }
        let n = if bytes.len > 0 { fwrite(bytes.ptr, 1, bytes.len as u64, file) as i64 } else { 0 };
        fclose(file) == 0 && n == bytes.len
    }
}

pub fn rename_file(from: *u8, to: *u8) -> bool {
    unsafe { rename(from, to) == 0 }
}

pub fn remove_file(path: *u8) -> bool {
    unsafe { unlink(path) == 0 }
}

pub fn remove_dir(path: *u8) -> bool {
    unsafe { rmdir(path) == 0 }
}

// Makes directory `path` and its parents (`mkdir -p`); whether it exists.
pub fn make_dirs(path: *u8) -> bool {
    unsafe {
        let n = strlen(path) as i64;
        let b = buf_new();
        for i in 0..n {
            if path[i] == '/' && i > 0 {
                buf_byte(b, 0);
                mkdir(BUFS[b].data, 493);
                BUFS[b].len -= 1;
            }
            buf_byte(b, path[i]);
        }
        buf_byte(b, 0);
        mkdir(BUFS[b].data, 493);
        let probe = buf_new();
        buf_str(probe, path);
        buf_str(probe, c"/.");
        buf_byte(probe, 0);
        realpath(BUFS[probe].data, 0 as *u8) != 0 as *u8
    }
}

// The absolute path of `path`, which exists (its directory, when it does
// not); the path itself when neither does.
pub fn absolute_path(path: *u8) -> *u8 {
    unsafe {
        let r = realpath(path, 0 as *u8);
        if r != 0 as *u8 {
            return r;
        }
        let n = strlen(path) as i64;
        let mut i = n - 1;
        while i >= 0 && path[i] != '/' {
            i -= 1;
        }
        let dir = buf_new();
        if i < 0 {
            buf_str(dir, c".");
        } else {
            buf_bytes(dir, path[0..i]);
        }
        buf_byte(dir, 0);
        let d = realpath(BUFS[dir].data, 0 as *u8);
        if d == 0 as *u8 {
            return path;
        }
        let out = buf_new();
        buf_str(out, d);
        buf_byte(out, '/');
        buf_str(out, &path[i + 1]);
        buf_byte(out, 0);
        BUFS[out].data
    }
}

// Reads all of stdin into `out`; false when stdin is a terminal (nothing
// was piped in).
pub fn read_stdin(out: i64) -> bool {
    unsafe {
        if isatty(0) != 0 {
            return false;
        }
        loop {
            buf_reserve(out, 65536);
            let got = read(0, &BUFS[out].data[BUFS[out].len], 65536);
            if got <= 0 {
                break;
            }
            BUFS[out].len += got;
        }
        true
    }
}

// The bytes of buffer b as a C string (b gets a NUL after its bytes, not
// counted in its length).
pub fn buf_cstr(b: i64) -> *u8 {
    unsafe {
        buf_byte(b, 0);
        BUFS[b].len -= 1;
        BUFS[b].data
    }
}

// Whether the bytes of buffers a and b are the same.
pub fn same_bytes(a: [u8], b: [u8]) -> bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}
