    Help {
        cmd: "same-output",
        text: "volec same-output OLD_VOLEC   prove a refactoring changed no output\n",
    },
    Help { cmd: "explain", text: "volec explain CODE   what a diagnostic code means, how to fix it (explain TOOL: its codes; explain --list)\n\
volec explain WORDS  a word or a compiler message: the guide's paragraphs about it\n" },
    Help { cmd: "guide", text: "volec guide [TOPIC...]        the core guide (2k tokens), or topics (--list; --all; --full: the long form)\n\
volec guide TOPIC#SECTION     one section (guide TOPIC#: its sections; TOPIC SECTION too)\n\
volec guide how [TASK]        recipes for adding a std function, a pass, a diagnostic, a test...\n\
volec guide --find WORDS      the paragraphs about WORDS, each with its topic#section\n\
--budget N: about N tokens at most\n" },
    Help { cmd: "try", text: "volec try 'STATEMENTS'   run a snippet (std imported, in fn main): the last expression's type and value, the output\n\
volec try --file F.vl  the same for a file (items and statements, or a whole program)\n\
volec try -              the snippet from stdin\n" },
    Help { cmd: "test", text: "volec test [FILTER...] [ROOT.vl]   build if needed, run the tests; a summary: counts, then each failure\n\
  a program: tests/NAME.in (stdin) with tests/NAME.out (expected stdout), NAME.exit (status); --dir DIR\n\
  the vole tree: target/volec rebuilt when older than compiler/src, then tests/run.sh FILTER\n\
  --budget N (tokens, 1000), --full (every failure), --input FILE (one run), --timeout S, -O N\n\
  (0.17) built with --trace: a crash or a time limit shows its line and callers (--no-trace)\n\
  (0.17) the vole tree: each failure run again with target/tools/volec: new, or failing\n\
  before too (--against VOLEC; --against none)\n\
  (0.18) the program's #[test], #[property] and #[fuzz] functions and its contracts too, at -O0\n\
  and -O2 (a difference is DIFF), with --check-alloc (a leak fails); --seed H, --cases N,\n\
  --accept (snapshots, a case's .out, saved fuzz inputs), --no-contracts (guide testing)\n" },
    Help { cmd: "fuzz", text: "volec fuzz NAME [ROOT.vl] [--time S]   run the #[fuzz] function NAME on inputs it mutates\n\
  built with --coverage: an input that reaches new code is kept; a failure is shrunk, saved under\n\
  .volec/fuzz/NAME/ and replayed by volec test (--accept keeps it in tests/fuzz/NAME/)\n" },
    Help { cmd: "probe", text: "volec probe FILE:LINE [EXPR...]... [-- ARGS] [--input FILE]   run the program with EXPRs printed at LINE\n\
  each FILE:LINE starts a probe: before the statement that begins the line; after a `let`;\n\
  in a loop's body each time round; at the start of a block the line opens (`} else {`)\n\
  --count FILE:LINE (how often it runs), --max N (values printed, 10), --timeout S (10),\n\
  -O N, --root ROOT; the source is not changed (guide debug)\n" },
    Help { cmd: "reduce", text: "volec reduce FILE --until 'CMD'   FILE's lines left out while CMD still exits 0\n\
  {} in CMD: the candidate (`./prog < {}; test $? = 101`); the result: FILE.min (--out F)\n\
  --max-runs N (500), --timeout S per run (5)\n\
volec reduce PROG.vl --differs [--input F] | --fails 'TEXT' | --test NAME   (0.18) the program\n\
  cut while -O0 and -O2 disagree, while it prints TEXT, or while test NAME fails: PROG.min.vl\n" },
    Help { cmd: "query context", text: "volec query context NAME... [--budget TOKENS]   the source, the signatures it calls and uses, its callers\n\
volec query context MODULE                      its banners and items, then its most used bodies\n" },
    Help { cmd: "query grep", text: "volec query grep TEXT...   text that is not a name, with its item (--comments, --strings, --code, --word, --ignore-case, --in, --count)\n" },
    Help { cmd: "lsp", text: "volec lsp   (0.24) the language server: LSP over stdin and stdout, for an editor\n\
  definition, references, hover (signature, effects and why, features; a local's type),\n\
  documentSymbol, publishDiagnostics (check's, with the try: lines); root: the nearest main.vl\n\
  VOLE_LSP_TIME=1: each request's time on stderr (docs/lsp.md)\n" },
];

fn c_slice(s: *u8) -> [u8] {
    unsafe { s[0..strlen(s) as i64] }
}

// Whether an argument asks for help.
pub fn is_help(s: *u8) -> bool {
    unsafe { streq(s, c"--help") || streq(s, c"-h") }
}

// The help of `volec CMD [SUB]` (argv[1], argv[2] when it is a word):
// the exit status.
pub fn run_help(argc: i64, argv: **u8) -> i64 {
    unsafe {
        let out = buf_new();
        let cmd = if argc >= 2 && !is_help(argv[1]) && !streq(argv[1], c"help") { c_slice(argv[1]) }
            else { "" };
        let sub = buf_new();
        buf_bytes(sub, cmd);
        if argc >= 3 && cmd.len > 0 && argv[2][0] != '-' {
            buf_bytes(sub, " ");
            buf_bytes(sub, c_slice(argv[2]));
        }
        let want = crate::base::buf_slice(sub);
        var found = -1;
        for i in 0..HELP_COUNT {
            if HELP[i].cmd == want {
                found = i;
            }
        }
        if found < 0 {
            for i in 0..HELP_COUNT {
                if HELP[i].cmd == cmd {
                    found = i;
                }
            }
        }
        if found < 0 {
            found = 0;
        }
        buf_bytes(out, HELP[found].text);
        buf_write_fd(out, STDOUT);
        0
    }
}
