// Merge conflicts in a program's files (0.15; docs/refactor.md, "Merge
// conflicts"), read as text, so that they work on a tree that does not
// parse:
//
//   volec query conflicts [FILE|DIR|FILE:LINE...] [--show] [--root R]
//   volec edit resolve FILE:LINE|FILE|NAME --ours|--theirs|--both|--base
//       [--all] [--in FILE] [--dry-run] [--show]
//   volec edit resolve TARGET < TEXT
//
// A region is git's: `<<<<<<< LABEL`, our lines, (diff3: `||||||| LABEL`,
// the base's lines,) `=======`, their lines, `>>>>>>> LABEL`. Its item is
// found from the text: the items whose header lines the region has (`fn
// f`, `struct S`, `use` lines; a method as `T::m`), else the item around
// it (the nearest header above it that is less indented), else, for
// comments at the top level, the item after it; `-` when none.
//
// Without a FILE, the files are the .vl files with conflict markers
// under the root's directory (`grep -rl`). A resolve writes each file
// whole (a copy, renamed onto it), is journaled for `undo`, and, when no
// markers are left, checks the program and prints its errors.

pub mod resolve;

use crate::base::{
    BUFS, IntVec, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd,
    streq,
};
use crate::tools::proc::{buf_cstr, read_file_if, run_capture, same_bytes};
use crate::tools::query::{c_slice, file_line, find_root};
use crate::tools::query::diagnostics::{
    PROG, ROOT_GIVEN, TOOL, diag, diags, put_cword, put_word, try_end,
};

// ---- Files and regions ----

// The files read: path (a C string, without `./`), text (a buffer), the
// index in LS of the start of their first line, their number of lines,
// whether their regions were read.
static var F_PATH: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var F_TEXT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var F_L0: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var F_NL: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var F_SCANNED: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var LS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The regions: file, the lines (from 1) of their markers (R_BASE -1 when
// there is no base side), their items (a buffer, `a, b`).
static var R_FILE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var R_START: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var R_BASE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var R_SEP: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var R_END: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var R_ITEMS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// File `path` read, its regions found: its index, or -1 after the
// diagnostic.
fn read_source(path0: *u8) -> i64 {
    unsafe {
        var path = path0;
        while path[0] == '.' && path[1] == '/' {
            path = &path[2];
        }
        for f in 0..F_PATH.count {
            if streq(F_PATH.data[f] as *u8, path) {
                return f;
            }
        }
        let text = buf_new();
        if !read_file_if(path, text) {
            let d = diag(c"error", c"query.no-file");
            buf_str(d, c"cannot read '");
            buf_str(d, path);
            buf_str(d, c"'\n");
            return -1;
        }
        F_PATH.push(path as i64);
        F_TEXT.push(text);
        F_L0.push(LS.count);
        let t = buf_slice(text);
        var n = 0;
        var i = 0;
        while i < t.len {
            LS.push(i);
            n += 1;
            while i < t.len && t[i] != '\n' {
                i += 1;
            }
            i += 1;
        }
        F_NL.push(n);
        F_SCANNED.push(0);
        let f = F_PATH.count - 1;
        if !scan(f) {
            return -1;
        }
        f
    }
}

fn path_of(f: i64) -> [u8] {
    unsafe { c_slice(F_PATH.data[f] as *u8) }
}

// Line n (from 1) of file f, without its newline.
fn line(f: i64, n: i64) -> [u8] {
    unsafe {
        let t = buf_slice(F_TEXT.data[f]);
        let s = LS.data[F_L0.data[f] + n - 1];
        var e = s;
        while e < t.len && t[e] != '\n' {
            e += 1;
        }
        if e > s && t[e - 1] == '\r' {
            e -= 1;
        }
        t[s..e]
    }
}

// Where line n of file f starts (one past its last line: its end).
fn line_pos(f: i64, n: i64) -> i64 {
    unsafe {
        if n > F_NL.data[f] {
            return BUFS[F_TEXT.data[f]].len;
        }
        LS.data[F_L0.data[f] + n - 1]
    }
}

// Whether l is a marker line of byte m (seven of it; `=======` alone).
fn marker(l: [u8], m: u8) -> bool {
    if l.len < 7 {
        return false;
    }
    for i in 0..7 {
        if l[i] != m {
            return false;
        }
    }
    if m == '=' {
        for i in 7..l.len {
            if l[i] != ' ' && l[i] != '\t' {
                return false;
            }
        }
        return true;
    }
    l.len == 7 || l[7] == ' '
}

fn any_marker(l: [u8]) -> bool {
    marker(l, '<') || marker(l, '|') || marker(l, '=') || marker(l, '>')
}

// A marker line's label (`HEAD`, a branch).
fn label(l: [u8]) -> [u8] {
    if l.len > 8 { l[8..l.len] } else { l[0..0] }
}

// The regions of file f. False after the diagnostic.
fn scan(f: i64) -> bool {
    unsafe {
        if F_SCANNED.data[f] != 0 {
            return true;
        }
        F_SCANNED.data[f] = 1;
        var state = 0;
        var start = 0;
        var base = -1;
        var sep = 0;
        for n in 1..F_NL.data[f] + 1 {
            let l = line(f, n);
            if marker(l, '<') {
                if state != 0 {
                    return format_error(f, n, c"a <<<<<<< line inside the region of line ", start);
                }
                state = 1;
                start = n;
                base = -1;
            } else if marker(l, '|') && state == 1 {
                state = 2;
                base = n;
            } else if marker(l, '=') && (state == 1 || state == 2) {
                state = 3;
                sep = n;
            } else if marker(l, '>') {
                if state != 3 {
                    return format_error(f, n,
                        c"a >>>>>>> line without its <<<<<<< and ======= lines", -1);
                }
                R_FILE.push(f);
                R_START.push(start);
                R_BASE.push(base);
                R_SEP.push(sep);
                R_END.push(n);
                R_ITEMS.push(region_items(R_FILE.count - 1));
                state = 0;
            }
        }
        if state != 0 {
            return format_error(f, start, c"a region without its >>>>>>> line", -1);
        }
        true
    }
}

fn format_error(f: i64, n: i64, message: *u8, other: i64) -> bool {
    unsafe {
        let d = diag(c"error", c"conflict.format");
        buf_bytes(d, path_of(f));
        buf_byte(d, ':');
        buf_int(d, n);
        buf_str(d, c": ");
        buf_str(d, message);
        if other >= 0 {
            buf_int(d, other);
        }
        buf_str(d, c"; fix the markers by hand\n");
        let out = try_start();
        buf_str(out, c" query text");
        let w = buf_new();
        buf_bytes(w, path_of(f));
        buf_byte(w, ':');
        buf_int(w, if n > 5 { n - 5 } else { 1 });
        buf_byte(w, '-');
        buf_int(w, n + 5);
        put_word(out, buf_slice(w));
        try_end(out);
        false
    }
}

// `try: PROG`; the words follow, then try_end.
fn try_start() -> i64 {
    unsafe {
        let out = diags();
        buf_str(out, c"try:");
        put_cword(out, PROG);
        out
    }
}

// ---- The items of a region ----

fn indent(l: [u8]) -> i64 {
    var i = 0;
    while i < l.len && (l[i] == ' ' || l[i] == '\t') {
        i += 1;
    }
    i
}

fn blank(l: [u8]) -> bool {
    indent(l) == l.len
}

fn comment(l: [u8]) -> bool {
    let i = indent(l);
    i + 1 < l.len && ((l[i] == '/' && l[i + 1] == '/') || (l[i] == '#' && l[i + 1] == '['))
}

fn is_ident(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

// Where word w ends when l has it at i (then a blank, `<`, `{` or `(`), or -1.
fn word_at(l: [u8], i: i64, w: *u8) -> i64 {
    unsafe {
        var k = 0;
        while w[k] != 0 {
            if i + k >= l.len || l[i + k] != w[k] {
                return -1;
            }
            k += 1;
        }
        let e = i + k;
        if e < l.len && l[e] != ' ' && l[e] != '<' && l[e] != '{' && l[e] != '(' {
            return -1;
        }
        e
    }
}

// The identifier at or after the blanks at i, into out: whether there is one.
fn ident_into(l: [u8], i0: i64, out: i64) -> bool {
    var i = i0;
    while i < l.len && l[i] == ' ' {
        i += 1;
    }
    let s = i;
    while i < l.len && is_ident(l[i]) {
        i += 1;
    }
    if i == s {
        return false;
    }
    buf_bytes(out, l[s..i]);
    true
}

// Whether line l is an item's header: 0 no, 1 an item, 2 an impl or a
// trait (a container of methods), 3 `use` lines; its name into out.
fn header(l: [u8], out: i64) -> i64 {
    unsafe {
        var i = indent(l);
        let p = word_at(l, i, c"pub");
        if p >= 0 {
            var j = p;
            if j < l.len && l[j] == '(' {
                while j < l.len && l[j] != ')' {
                    j += 1;
                }
                j += 1;
            }
            while j < l.len && l[j] == ' ' {
                j += 1;
            }
            i = j;
        }
        let u = word_at(l, i, c"unsafe");
        if u >= 0 && word_at(l, u + 1, c"fn") >= 0 {
            i = u + 1;
        }
        if word_at(l, i, c"use") >= 0 {
            buf_str(out, c"use");
            return 3;
        }
        var e = word_at(l, i, c"impl");
        if e >= 0 {
            // `impl<T> Trait for Type`: Type; `impl Type`: Type
            if e < l.len && l[e] == '<' {
                var depth = 0;
                while e < l.len {
                    if l[e] == '<' {
                        depth += 1;
                    } else if l[e] == '>' {
                        depth -= 1;
                        if depth == 0 {
                            e += 1;
                            break;
                        }
                    }
                    e += 1;
                }
            }
            var k = e;
            while k + 5 <= l.len {
                if l[k] == ' ' && l[k + 1] == 'f' && l[k + 2] == 'o' && l[k + 3] == 'r'
                    && l[k + 4] == ' ' {
                    e = k + 5;
                    break;
                }
                k += 1;
            }
            return if ident_into(l, e, out) { 2 } else { 0 };
        }
        e = word_at(l, i, c"trait");
        if e >= 0 {
            return if ident_into(l, e, out) { 2 } else { 0 };
        }
        e = word_at(l, i, c"fn");
        if e < 0 {
            e = word_at(l, i, c"struct");
        }
        if e < 0 {
            e = word_at(l, i, c"enum");
        }
        if e < 0 {
            e = word_at(l, i, c"union");
        }
        if e < 0 {
            e = word_at(l, i, c"type");
        }
        if e < 0 {
            e = word_at(l, i, c"mod");
        }
        if e < 0 {
            e = word_at(l, i, c"const");
        }
        if e < 0 {
            e = word_at(l, i, c"static");
            if e >= 0 {
                while e < l.len && l[e] == ' ' {
                    e += 1;
                }
                let m = word_at(l, e, c"mut");
                if m >= 0 {
                    e = m;
                }
            }
        }
        if e < 0 {
            return 0;
        }
        if ident_into(l, e, out) { 1 } else { 0 }
    }
}

// The name of the item whose header is line n of file f (its name in
// `name`), into out: `T::m` for a method (an impl or trait header less
// indented above it).
fn qualified(f: i64, n: i64, name: i64, out: i64) {
    let ind = indent(line(f, n));
    if ind > 0 {
        var m = n - 1;
        while m >= 1 {
            let l = line(f, m);
            if !blank(l) && !comment(l) && !any_marker(l) && indent(l) < ind {
                let b = buf_new();
                if header(l, b) == 2 {
                    buf_bytes(out, buf_slice(b));
                    unsafe { buf_str(out, c"::"); }
                }
                break;
            }
            m -= 1;
        }
    }
    buf_bytes(out, buf_slice(name));
}

// Name q added to the list in out (`a, b`) unless it is there.
fn add_name(out: i64, q: [u8]) {
    let t = buf_slice(out);
    var i = 0;
    while i < t.len {
        var e = i;
        while e < t.len && t[e] != ',' {
            e += 1;
        }
        if same_bytes(t[i..e], q) {
            return;
        }
        i = e + 2;
    }
    if t.len > 0 {
        unsafe { buf_str(out, c", "); }
    }
    buf_bytes(out, q);
}

// The items of region r (a buffer, `a, b`; `-` when none is found).
fn region_items(r: i64) -> i64 {
    unsafe {
        let f = R_FILE.data[r];
        let start = R_START.data[r];
        let end = R_END.data[r];
        let out = buf_new();
        var first = -1;
        var notes = true;
        for n in start + 1..end {
            let l = line(f, n);
            if any_marker(l) || blank(l) {
                continue;
            }
            if first < 0 {
                first = indent(l);
            }
            if !comment(l) {
                notes = false;
            }
            let b = buf_new();
            if header(l, b) != 0 {
                let q = buf_new();
                qualified(f, n, b, q);
                add_name(out, buf_slice(q));
            }
        }
        if BUFS[out].len > 0 {
            return out;
        }
        if first > 0 {
            // (the item around it: a less indented header above)
            var ind = first;
            var m = start - 1;
            while m >= 1 {
                let l = line(f, m);
                if !blank(l) && !comment(l) && !any_marker(l) && indent(l) < ind {
                    let b = buf_new();
                    if header(l, b) != 0 {
                        qualified(f, m, b, out);
                        return out;
                    }
                    ind = indent(l);
                    if ind == 0 {
                        break;
                    }
                }
                m -= 1;
            }
        } else if notes {
            // (comments at the top level: the item after them)
            var m = end + 1;
            while m <= F_NL.data[f] {
                let l = line(f, m);
                if !blank(l) && !comment(l) {
                    let b = buf_new();
                    if indent(l) == 0 && header(l, b) != 0 {
                        qualified(f, m, b, out);
                        return out;
                    }
                    break;
                }
                m += 1;
            }
        }
        buf_byte(out, '-');
        out
    }
}

// Whether NAME names one of region r's items: the same, or one ends the
// other after `::`.
fn names_item(r: i64, name: [u8]) -> bool {
    unsafe {
        let t = buf_slice(R_ITEMS.data[r]);
        var i = 0;
        while i < t.len {
            var e = i;
            while e < t.len && t[e] != ',' {
                e += 1;
            }
            let item = t[i..e];
            if same_bytes(item, name) || ends_path(item, name) || ends_path(name, item) {
                return true;
            }
            i = e + 2;
        }
        false
    }
}

// Whether a is `...::b`.
fn ends_path(a: [u8], b: [u8]) -> bool {
    a.len > b.len + 2 && same_bytes(a[a.len - b.len..a.len], b) && a[a.len - b.len - 1] == ':'
        && a[a.len - b.len - 2] == ':'
}

// ---- Finding the files ----

// The .vl files with a `<<<<<<<` line under dir (C strings), sorted.
fn conflicted_files(dir: *u8, out: inout IntVec) {
    unsafe {
        var args = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        args.push(c"grep" as i64);
        args.push(c"-rl" as i64);
        args.push(c"--include=*.vl" as i64);
        args.push(c"--include=*.vl" as i64);
        args.push(c"-e" as i64);
        args.push(c"^<<<<<<<" as i64);
        args.push(dir as i64);
        args.push(0);
        let b = buf_new();
        run_capture(args.data as **u8, b);
        let t = buf_slice(b);
        var i = 0;
        while i < t.len {
            var e = i;
            while e < t.len && t[e] != '\n' {
                e += 1;
            }
            var s = i;
            while s + 1 < e && t[s] == '.' && t[s + 1] == '/' {
                s += 2;
            }
            if crate::base::source_ext_len(t[s..e]) > 0 {
                let p = buf_new();
                buf_bytes(p, t[s..e]);
                out.push(buf_cstr(p) as i64);
            }
            i = e + 1;
        }
        // (sorted: grep lists them in the directory's order)
        let v = out.data;
        for k in 1..out.count {
            var j = k;
            while j > 0 && less(c_slice(v[j] as *u8), c_slice(v[j - 1] as *u8)) {
                let x = v[j];
                v[j] = v[j - 1];
                v[j - 1] = x;
                j -= 1;
            }
        }
    }
}

fn less(a: [u8], b: [u8]) -> bool {
    var i = 0;
    while i < a.len && i < b.len {
        if a[i] != b[i] {
            return a[i] < b[i];
        }
        i += 1;
    }
    a.len < b.len
}

// The directory searched without a FILE: the root's (`.` without one).
fn default_dir() -> *u8 {
    unsafe {
        let root = find_root(ROOT_GIVEN);
        if root == 0 as *u8 {
            return c".";
        }
        let s = c_slice(root);
        var i = s.len;
        while i > 0 && s[i - 1] != '/' {
            i -= 1;
        }
        if i <= 1 {
            return if i == 1 { c"/" } else { c"." };
        }
        let b = buf_new();
        buf_bytes(b, s[0..i - 1]);
        buf_cstr(b)
    }
}

// The files under dir, read. False after a diagnostic.
fn read_dir(dir: *u8) -> bool {
    var files = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    conflicted_files(dir, &files);
    for k in 0..files.count {
        if unsafe { read_source(files.data[k] as *u8) < 0 } {
            return false;
        }
    }
    true
}

// TARGET `FILE` or `FILE:LINE` (a .vl file): its regions (with a line,
// the one holding it) into sel. 1 when it is no file, 2 after a
// diagnostic, 0 done.
fn file_target(arg: *u8, sel: inout IntVec) -> i64 {
    unsafe {
        let a = c_slice(arg);
        var ln = -1;
        var n = file_line(a, &ln);
        if n < 0 {
            n = a.len;
            ln = -1;
        }
        if crate::base::source_ext_len(a[0..n]) == 0 {
            return 1;
        }
        let p = buf_new();
        buf_bytes(p, a[0..n]);
        let f = read_source(buf_cstr(p));
        if f < 0 {
            return 2;
        }
        var found = false;
        for r in 0..R_FILE.count {
            if R_FILE.data[r] == f && (ln < 0 || (R_START.data[r] <= ln && ln <= R_END.data[r])) {
                add_region(&sel, r);
                found = true;
            }
        }
        if !found && ln >= 0 {
            let d = diag(c"error", c"conflict.none");
            buf_str(d, c"no conflict region holds ");
            buf_bytes(d, path_of(f));
            buf_byte(d, ':');
            buf_int(d, ln);
            buf_byte(d, '\n');
            let out = try_start();
            buf_str(out, c" query conflicts");
            put_word(out, path_of(f));
            try_end(out);
            return 2;
        }
        0
    }
}

fn add_region(sel: inout IntVec, r: i64) {
    for k in 0..sel.count {
        if unsafe { sel.data[k] == r } {
            return;
        }
    }
    sel.push(r);
}

// ---- query conflicts ----

fn put_lines(out: i64, n: i64) {
    buf_int(out, n);
    unsafe { buf_str(out, if n == 1 { c" line" } else { c" lines" }); }
}

fn put_side(out: i64, f: i64, side: *u8, marker_line: i64, n: i64) {
    buf_str(out, side);
    buf_byte(out, ' ');
    put_lines(out, n);
    let lab = label(line(f, marker_line));
    if lab.len > 0 {
        unsafe { buf_str(out, c" ("); }
        buf_bytes(out, lab);
        buf_byte(out, ')');
    }
}

// The lines of the sides of region r: ours [a, b], base, theirs.
fn ours_end(r: i64) -> i64 {
    unsafe { if R_BASE.data[r] >= 0 { R_BASE.data[r] } else { R_SEP.data[r] } }
}

// `FILE:A-B<TAB>ITEMS<TAB>ours N lines (LABEL)[<TAB>base ...]<TAB>theirs ...`
fn put_region(out: i64, r: i64) {
    unsafe {
        let f = R_FILE.data[r];
        let s = R_START.data[r];
        buf_bytes(out, path_of(f));
        buf_byte(out, ':');
        buf_int(out, s);
        buf_byte(out, '-');
        buf_int(out, R_END.data[r]);
        buf_byte(out, '\t');
        buf_bytes(out, buf_slice(R_ITEMS.data[r]));
        buf_byte(out, '\t');
        put_side(out, f, c"ours", s, ours_end(r) - s - 1);
        if R_BASE.data[r] >= 0 {
            buf_byte(out, '\t');
            put_side(out, f, c"base", R_BASE.data[r], R_SEP.data[r] - R_BASE.data[r] - 1);
        }
        buf_byte(out, '\t');
        put_side(out, f, c"theirs", R_END.data[r], R_END.data[r] - R_SEP.data[r] - 1);
        buf_byte(out, '\n');
    }
}

// One side's lines a..b (excluded) of file f, under `// SIDE (LABEL), lines A-B:`.
fn show_side(out: i64, f: i64, side: *u8, marker_line: i64, a: i64, b: i64) {
    unsafe {
        buf_str(out, c"// ");
        buf_str(out, side);
        let lab = label(line(f, marker_line));
        if lab.len > 0 {
            buf_str(out, c" (");
            buf_bytes(out, lab);
            buf_byte(out, ')');
        }
        if a >= b {
            buf_str(out, c": no lines\n");
            return;
        }
        buf_str(out, if a + 1 == b { c", line " } else { c", lines " });
        buf_int(out, a);
        if a + 1 < b {
            buf_byte(out, '-');
            buf_int(out, b - 1);
        }
        buf_str(out, c":\n");
        for n in a..b {
            buf_bytes(out, line(f, n));
            buf_byte(out, '\n');
        }
    }
}

fn show_region(out: i64, r: i64) {
    unsafe {
        let f = R_FILE.data[r];
        let s = R_START.data[r];
        buf_str(out, c"// ");
        buf_bytes(out, path_of(f));
        buf_byte(out, ':');
        buf_int(out, s);
        buf_byte(out, '-');
        buf_int(out, R_END.data[r]);
        buf_byte(out, '\t');
        buf_bytes(out, buf_slice(R_ITEMS.data[r]));
        buf_byte(out, '\n');
        show_side(out, f, c"ours", s, s + 1, ours_end(r));
        if R_BASE.data[r] >= 0 {
            show_side(out, f, c"base", R_BASE.data[r], R_BASE.data[r] + 1, R_SEP.data[r]);
        }
        show_side(out, f, c"theirs", R_END.data[r], R_SEP.data[r] + 1, R_END.data[r]);
    }
}

// `volec query conflicts [FILE|DIR|FILE:LINE...] [--show] [--root R]`:
// the exit status (the diagnostics are written by run_query).
pub fn run_conflicts(argc: i64, argv: **u8) -> i64 {
    unsafe {
        TOOL = 0 as *u8;
        var show = false;
        var args = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var i = 3;
        while i < argc {
            let a = argv[i];
            if streq(a, c"--show") {
                show = true;
            } else if streq(a, c"--root") && i + 1 < argc {
                ROOT_GIVEN = argv[i + 1];
                i += 1;
            } else if a[0] == '-' && a[1] == '-' {
                let d = diag(c"error", c"query.usage");
                buf_str(d, c"unknown option '");
                buf_str(d, a);
                buf_str(d, c"' of query conflicts (--show, --root)\n");
                let out = try_start();
                buf_str(out, c" query conflicts --show");
                try_end(out);
                return 2;
            } else {
                args.push(a as i64);
            }
            i += 1;
        }
        var sel = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if args.count == 0 {
            if !read_dir(default_dir()) {
                return 1;
            }
            for r in 0..R_FILE.count {
                sel.push(r);
            }
        }
        for k in 0..args.count {
            let a = args.data[k] as *u8;
            let t = file_target(a, &sel);
            if t == 2 {
                return 1;
            }
            if t == 1 {
                let before = R_FILE.count;
                if !read_dir(a) {
                    return 1;
                }
                for r in before..R_FILE.count {
                    add_region(&sel, r);
                }
            }
        }
        if sel.count == 0 {
            let d = diag(c"note", c"conflict.none");
            buf_str(d, c"no conflict markers in ");
            if args.count == 0 {
                buf_str(d, c"the .vl files under ");
                buf_str(d, default_dir());
            } else {
                for k in 0..args.count {
                    if k > 0 {
                        buf_str(d, c", ");
                    }
                    buf_str(d, args.data[k] as *u8);
                }
            }
            buf_byte(d, '\n');
            return 0;
        }
        let out = buf_new();
        for k in 0..sel.count {
            if show {
                show_region(out, sel.data[k]);
            } else {
                put_region(out, sel.data[k]);
            }
        }
        buf_write_fd(out, STDOUT);
        0
    }
}
