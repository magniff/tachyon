// `tachyonc rewrite --text OLD NEW [--files GLOB]... [--word] [--case]
// [--regex] [--comments] [--strings] [--code] [--exclude SPEC]...
// [--exclude-from FILE] [--move-paths] [--no-sources] [--check ROOT]... [--dry-run]
// [--diff]` (0.21; docs/refactor.md): OLD replaced by NEW in the files
// git tracks (those --files names; all by default), text files of any
// kind, as one edit `undo` takes back. --comments, --strings, --code: in
// vole sources only there (the lexer's places), and only vole sources;
// --no-sources: the other files only.
// --move-paths: a file whose path has OLD moves too (as `git mv`).
// --check ROOT: the program's check, before and after (the new texts read
// in place of the files), must find no new error, else nothing is
// written. Prints a line per file changed, then the totals, and what was
// left: matches in excluded files and lines, and in a source's other
// places.

use crate::base::{BUFS, IntVec, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, streq};
use crate::tools::edit::{DRY_RUN, gone_path};
use crate::tools::edit::apply::{copy_path, error_lines};
use crate::tools::edit::diff::diff_texts;
use crate::tools::proc::{
    buf_cstr, read_file_if, remove_file, run_capture, same_bytes, write_file_if,
};
use crate::tools::query::c_slice;
use crate::tools::query::diagnostics::{
    PROG, diag, diags, put_cword, put_word, try_end, write_diags,
};
use crate::tools::query::grep::{G_CODE, G_COMMENT, G_STRING};
use crate::tools::textual::{
    MIXED_CASE, M_FROM, M_TO, T_CASE, T_PLACES, T_REGEX, T_WORD, W_AFTER, W_BEFORE, W_PATH,
    add_exclusion, excluded, find_matches, flush, glob_match, is_text, kept_ranges, put_file_line,
    put_replacement, read_exclusions, tracked_files, write_edit,
};
use crate::tools::textual::places::{match_in, read_lines, read_places};

// Whether argv has word w (rewrite: `--text` makes it this command).
pub fn has_word(argc: i64, argv: **u8, w: *u8) -> bool {
    unsafe {
        for i in 2..argc {
            if streq(argv[i], w) {
                return true;
            }
        }
        false
    }
}

fn usage(message: *u8) -> i64 {
    unsafe {
        let d = diag(c"error", c"rewrite.usage");
        buf_str(d, message);
        buf_byte(d, '\n');
        let out = diags();
        buf_str(out, c"try:");
        put_cword(out, PROG);
        buf_str(out, c" rewrite --text tachyon vole --word --case --files '*.md' --dry-run");
        try_end(out);
        2
    }
}

// The new text of `t` (file p) with OLD replaced in the bytes allowed:
// the number of matches replaced, the new text in `after`; `left` counts
// the matches not taken (kept lines, other places); `kept` the lines kept.
pub fn rewrite_text(p: [u8], t: [u8], old: [u8], new: [u8], after: inout i64, left: inout i64,
    kept: inout i64) -> i64 {
    unsafe {
        var starts = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var ends = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        find_matches(t, 0, t.len, old, &starts, &ends);
        if starts.count == 0 {
            return 0;
        }
        var keep = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        kept = kept_ranges(p, t, &keep);
        let source = crate::base::source_ext_len(p) > 0;
        var placed = T_PLACES != 0 && source && read_places(t);
        if T_PLACES != 0 && source && !placed {
            // (it does not lex: its `//` lines are its comments)
            read_lines(t);
            placed = true;
        }
        let out = buf_new();
        var at = 0;
        var n = 0;
        var r = 0;
        for k in 0..starts.count {
            let s = starts.data[k];
            let e = ends.data[k];
            while r < keep.count && keep.data[r + 1] <= s {
                r += 2;
            }
            let in_kept = r < keep.count && keep.data[r] < e;
            let in_place = T_PLACES == 0 || (placed && match_in(s, e, T_PLACES));
            if in_kept || !in_place {
                left += 1;
                continue;
            }
            buf_bytes(out, t[at..s]);
            put_replacement(out, new, t[s..e]);
            at = e;
            n += 1;
        }
        buf_bytes(out, t[at..t.len]);
        after = out;
        n
    }
}

// The path p with OLD replaced (--move-paths), or an empty slice when it
// has none.
fn moved_path(p: [u8], old: [u8], new: [u8]) -> [u8] {
    unsafe {
        var starts = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var ends = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        find_matches(p, 0, p.len, old, &starts, &ends);
        if starts.count == 0 {
            return p[0..0];
        }
        let out = buf_new();
        var at = 0;
        for k in 0..starts.count {
            buf_bytes(out, p[at..starts.data[k]]);
            put_replacement(out, new, p[starts.data[k]..ends.data[k]]);
            at = ends.data[k];
        }
        buf_bytes(out, p[at..p.len]);
        buf_slice(out)
    }
}

// `PROG check --diagnostics=short [--overlay FILE COPY]... ROOT`, the
// edit's texts read in place of the files when `edited`: its output into
// out; its status.
pub fn check_root(root: *u8, edited: bool, out: i64) -> i64 {
    unsafe {
        var args = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        args.push(PROG as i64);
        args.push(c"check" as i64);
        args.push(c"--diagnostics=short" as i64);
        if edited {
            for k in 0..W_PATH.count {
                let p = W_PATH.data[k] as *u8;
                overlay(&args, p, copy_path(original_path(p)));
            }
            for k in 0..M_FROM.count {
                let a = M_FROM.data[k] as *u8;
                overlay(&args, a, gone_path(a));
                if !changed(M_TO.data[k] as *u8) {
                    overlay(&args, M_TO.data[k] as *u8, a);
                }
            }
        }
        args.push(root as i64);
        args.push(0);
        run_capture(args.data as **u8, out)
    }
}

// `--overlay P COPY`, and `--overlay ./P COPY` (a module next to the root
// is `./P` to the compiler).
fn overlay(args: inout IntVec, p: *u8, copy: *u8) {
    unsafe {
        args.push(c"--overlay" as i64);
        args.push(p as i64);
        args.push(copy as i64);
        if p[0] != '/' && p[0] != '.' {
            let b = buf_new();
            buf_str(b, c"./");
            buf_str(b, p);
            args.push(c"--overlay" as i64);
            args.push(buf_cstr(b) as i64);
            args.push(copy as i64);
        }
    }
}

// The path file p (as it is after the moves) has now.
fn original_path(p: *u8) -> *u8 {
    unsafe {
        for k in 0..M_TO.count {
            if streq(M_TO.data[k] as *u8, p) {
                return M_FROM.data[k] as *u8;
            }
        }
        p
    }
}

fn changed(p: *u8) -> bool {
    unsafe {
        for k in 0..W_PATH.count {
            if streq(W_PATH.data[k] as *u8, p) {
                return true;
            }
        }
        false
    }
}

// The --check of each root: the new errors' lines into `added`; false when
// a check could not run.
pub fn check_roots(roots: IntVec, added: inout IntVec) -> bool {
    unsafe {
        for k in 0..W_PATH.count {
            let orig = original_path(W_PATH.data[k] as *u8);
            write_file_if(copy_path(orig), buf_slice(W_AFTER.data[k]));
        }
        var ran = true;
        for r in 0..roots.count {
            let root = roots.data[r] as *u8;
            let before = buf_new();
            let after = buf_new();
            let s1 = check_root(root, false, before);
            let s2 = check_root(root, true, after);
            if (s1 != 0 && s1 != 1) || (s2 != 0 && s2 != 1) {
                ran = false;
                continue;
            }
            var old = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            var now = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            error_lines(buf_slice(before), &old);
            error_lines(buf_slice(after), &now);
            let used = crate::base::alloc_array::<bool>(old.count / 2 + 1);
            for j in 0..old.count / 2 + 1 {
                used[j] = false;
            }
            var i = 0;
            while i < now.count {
                var found = false;
                var j = 0;
                while j < old.count {
                    if !used[j / 2] && same_bytes(buf_slice(old.data[j]), buf_slice(now.data[i])) {
                        used[j / 2] = true;
                        found = true;
                        break;
                    }
                    j += 2;
                }
                if !found {
                    added.push(now.data[i + 1]);
                }
                i += 2;
            }
        }
        for k in 0..W_PATH.count {
            remove_file(copy_path(original_path(W_PATH.data[k] as *u8)));
        }
        ran
    }
}

pub fn run_text_rewrite(argc: i64, argv: **u8) -> i64 {
    let status = run_inner(argc, argv);
    write_diags();
    status
}

fn run_inner(argc: i64, argv: **u8) -> i64 {
    unsafe {
        PROG = argv[0];
        var words = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var globs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var roots = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var move_paths = false;
        var no_sources = false;
        var show_diff = false;
        var i = 2;
        while i < argc {
            let a = argv[i];
            let valued = i + 1 < argc;
            if streq(a, c"--text") {
            } else if streq(a, c"--word") {
                T_WORD = true;
            } else if streq(a, c"--case") {
                T_CASE = true;
            } else if streq(a, c"--regex") {
                T_REGEX = true;
            } else if streq(a, c"--comments") {
                T_PLACES |= G_COMMENT;
            } else if streq(a, c"--strings") {
                T_PLACES |= G_STRING;
            } else if streq(a, c"--code") {
                T_PLACES |= G_CODE;
            } else if streq(a, c"--move-paths") {
                move_paths = true;
            } else if streq(a, c"--no-sources") {
                no_sources = true;
            } else if streq(a, c"--dry-run") {
                DRY_RUN = true;
            } else if streq(a, c"--diff") {
                show_diff = true;
            } else if streq(a, c"--files") && valued {
                globs.push(argv[i + 1] as i64);
                i += 1;
            } else if streq(a, c"--check") && valued {
                roots.push(argv[i + 1] as i64);
                i += 1;
            } else if streq(a, c"--exclude") && valued {
                if !add_exclusion(c_slice(argv[i + 1])) {
                    return 2;
                }
                i += 1;
            } else if streq(a, c"--exclude-from") && valued {
                if !read_exclusions(argv[i + 1]) {
                    return 2;
                }
                i += 1;
            } else if a[0] == '-' && a[1] == '-' {
                let d = diag(c"error", c"rewrite.usage");
                buf_str(d, c"unknown option '");
                buf_str(d, a);
                buf_str(d,
                    c"' (--files, --word, --case, --regex, --comments, --strings, --code, --exclude, --exclude-from, --move-paths, --no-sources, --check, --dry-run, --diff)\n");
                return 2;
            } else {
                words.push(a as i64);
            }
            i += 1;
        }
        if words.count != 2 {
            return usage(c"--text takes OLD and NEW");
        }
        let old = c_slice(words.data[0] as *u8);
        let new = c_slice(words.data[1] as *u8);
        if old.len == 0 {
            return usage(c"OLD is empty");
        }
        if T_REGEX && T_CASE {
            return usage(c"--case is for a literal OLD, not with --regex");
        }
        if T_REGEX && !crate::tools::rewrite::regex::re_valid(old) {
            return usage(c"OLD is no regular expression (^ $ . * + ? [a-z] \\d \\w)");
        }
        var files = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if !tracked_files(&files) {
            let d = diag(c"error", c"rewrite.no-git");
            buf_str(d, c"--text edits the files git tracks: this is no git checkout\n");
            return 2;
        }
        let out = buf_new();
        let diff = buf_new();
        var total = 0;
        var changed_files = 0;
        var left_excluded = 0;
        var excluded_files = 0;
        var left_kept = 0;
        var kept_files = 0;
        var not_lexed = 0;
        let unlexed = buf_new();
        for f in 0..files.count {
            let path = files.data[f] as *u8;
            let p = c_slice(path);
            if globs.count > 0 {
                var picked = false;
                for g in 0..globs.count {
                    if glob_match(c_slice(globs.data[g] as *u8), p) {
                        picked = true;
                    }
                }
                if !picked {
                    continue;
                }
            }
            let source = crate::base::source_ext_len(p) > 0;
            if (T_PLACES != 0 && !source) || (no_sources && source) {
                continue;
            }
            let text = buf_new();
            // (0.24: a link is its target's text: never written through)
            if crate::tools::proc::link_target(path) >= 0 || !read_file_if(path, text)
                || !is_text(buf_slice(text)) {
                continue;
            }
            let t = buf_slice(text);
            if excluded(p) {
                var s = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                var e = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                find_matches(t, 0, t.len, old, &s, &e);
                if s.count > 0 {
                    left_excluded += s.count;
                    excluded_files += 1;
                }
                continue;
            }
            // (a file without a match: nothing to read further, unless it moves)
            var ms = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            var me = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            find_matches(t, 0, t.len, old, &ms, &me);
            if ms.count == 0 && !move_paths {
                continue;
            }
            if ms.count > 0 && T_PLACES != 0 && !read_places(t) {
                if not_lexed < 3 {
                    buf_str(unlexed, if not_lexed == 0 { c" (" } else { c", " });
                    buf_bytes(unlexed, p);
                }
                not_lexed += 1;
            }
            var after = -1;
            var left = 0;
            var kept = 0;
            let n = rewrite_text(p, t, old, new, &after, &left, &kept);
            if left > 0 {
                left_kept += left;
                kept_files += 1;
            }
            let to = if move_paths { moved_path(p, old, new) } else { p[0..0] };
            if n == 0 && to.len == 0 {
                continue;
            }
            var final_path = path;
            if to.len > 0 {
                let b = buf_new();
                buf_bytes(b, to);
                final_path = buf_cstr(b);
                M_FROM.push(path as i64);
                M_TO.push(final_path as i64);
            }
            if n > 0 {
                W_PATH.push(final_path as i64);
                W_BEFORE.push(text);
                W_AFTER.push(after);
                if show_diff {
                    diff_texts(diff, c_slice(final_path), t, buf_slice(after));
                }
            }
            put_file_line(out, c_slice(final_path), if to.len > 0 { p } else { p[0..0] }, n,
                kept);
            total += n;
            changed_files += 1;
        }
        // The totals.
        buf_str(out, if DRY_RUN { c"would rewrite " } else { c"rewrote " });
        buf_int(out, total);
        buf_str(out, if total == 1 { c" match in " } else { c" matches in " });
        buf_int(out, changed_files);
        buf_str(out, if changed_files == 1 { c" file" } else { c" files" });
        if M_FROM.count > 0 {
            buf_str(out, c", ");
            buf_int(out, M_FROM.count);
            buf_str(out, c" moved");
        }
        buf_byte(out, '\n');
        if show_diff {
            buf_bytes(out, buf_slice(diff));
        }
        // What is left, and why.
        if left_excluded > 0 {
            let d = diag(c"note", c"rewrite.excluded");
            buf_int(d, left_excluded);
            buf_str(d, if left_excluded == 1 { c" match left in " } else { c" matches left in " });
            buf_int(d, excluded_files);
            buf_str(d,
                if excluded_files == 1 { c" excluded file\n" } else { c" excluded files\n" });
        }
        if left_kept > 0 {
            let d = diag(c"note", c"rewrite.kept");
            buf_int(d, left_kept);
            buf_str(d, if left_kept == 1 { c" match left in " } else { c" matches left in " });
            buf_int(d, kept_files);
            buf_str(d, if kept_files == 1 { c" file" } else { c" files" });
            buf_str(d, c": in kept lines (the exclusions), or in other places than --comments, --strings, --code ask\n");
        }
        if not_lexed > 0 {
            let d = diag(c"warning", c"rewrite.not-lexed");
            buf_int(d, not_lexed);
            buf_str(d,
                if not_lexed == 1 { c" vole source with a match does" }
                else { c" vole sources with a match do" });
            buf_str(d,
                c" not lex: read by lines, only the lines that start with `//` are comments");
            buf_bytes(d, buf_slice(unlexed));
            buf_str(d, if not_lexed > 3 { c", ...)\n" } else { c")\n" });
        }
        if MIXED_CASE > 0 {
            let d = diag(c"note", c"rewrite.mixed-case");
            buf_int(d, MIXED_CASE);
            buf_str(d, c" matches in a mixed case took NEW as it is\n");
        }
        if total == 0 && M_FROM.count == 0 {
            flush(out);
            return 0;
        }
        // The check, then the edit.
        if roots.count > 0 {
            var added = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            if !check_roots(roots, &added) {
                let d = diag(c"error", c"rewrite.check");
                buf_str(d, c"--check could not run the check; nothing written\n");
                return 1;
            }
            if added.count > 0 {
                let e = diags();
                for k in 0..added.count {
                    if k < 10 {
                        buf_bytes(e, buf_slice(added.data[k]));
                        buf_byte(e, '\n');
                    }
                }
                let d = diag(c"error", c"rewrite.breaks");
                buf_int(d, added.count);
                buf_str(d, if added.count == 1 { c" new error" } else { c" new errors" });
                buf_str(d, c" in the --check programs; nothing written\n");
                let t = diags();
                buf_str(t, c"try:");
                put_cword(t, PROG);
                for k in 1..argc {
                    put_cword(t, argv[k]);
                }
                if !DRY_RUN {
                    buf_str(t, c" --dry-run");
                }
                if !show_diff {
                    buf_str(t, c" --diff");
                }
                try_end(t);
                return 1;
            }
        }
        flush(out);
        if DRY_RUN {
            return 0;
        }
        let summary = buf_new();
        buf_str(summary, c"rewrote --text");
        put_word(summary, old);
        put_word(summary, new);
        buf_byte(summary, '\t');
        buf_int(summary, changed_files);
        buf_str(summary, c" files\t");
        buf_int(summary, total);
        buf_str(summary, c" matches");
        if write_edit(buf_slice(summary), c".") { 0 } else { 1 }
    }
}
