// The places of a vole source's bytes (0.21): code, a comment or a string
// (or character) literal, an f-string's text pieces too, as the lexer
// reads the file alone (fmt's pieces: tokens and comments). A file that
// does not lex has no places: its matches are not taken.

use crate::base::IntVec;
use crate::front::lexer::{Tok, init_lexer};
use crate::tools::fmt::pieces::{
    BAD_MESSAGE, BLOCK_COMMENT, LINE_COMMENT, P_END, P_KIND, P_START, read_pieces,
};
use crate::tools::query::grep::{G_CODE, G_COMMENT, G_STRING};

static var LEXER_READY: bool = false;

// Whether the text read did not lex: its places are its lines that start
// with `//` (comments, a test's directives), nothing else (read_lines).
static var BY_LINES: bool = false;
static var LINES_TEXT: [u8] = "";

// Reads the pieces of source text t; false when it does not lex (its
// brackets need not balance).
pub fn read_places(t: [u8]) -> bool {
    unsafe {
        if !LEXER_READY {
            init_lexer();
            // (a lexer's error names a file: one, when the program has none)
            if crate::base::FILE_COUNT == 0 {
                crate::base::load_sources(0 as **u8, 0);
                crate::base::add_source(c"<text>", crate::base::buf_new());
            }
            LEXER_READY = true;
        }
        BY_LINES = false;
        if read_pieces(t) {
            return true;
        }
        let m = BAD_MESSAGE;
        // (the pieces are read when only the brackets are wrong)
        (m == "unbalanced brackets" || m == "unclosed bracket") && P_START.count > 0
    }
}

// (0.21) Reads source text t that does not lex (read_places false) by
// its lines: a match on a line that starts with `//` is in a comment.
pub fn read_lines(t: [u8]) {
    unsafe {
        BY_LINES = true;
        // (0.25: a static holds only views of static data; t outlives
        // every use of LINES_TEXT, the caller's)
        let p = t.ptr;
        LINES_TEXT = p[0..t.len];
    }
}

// In a text read by lines: whether [s, e) is on one line after a `//`
// that starts it.
fn in_line_comment(s: i64, e: i64) -> bool {
    unsafe {
        let t = LINES_TEXT;
        var a = s;
        while a > 0 && t[a - 1] != '\n' {
            a -= 1;
        }
        for k in s..e {
            if t[k] == '\n' {
                return false;
            }
        }
        while a < s && (t[a] == ' ' || t[a] == '\t') {
            a += 1;
        }
        a + 1 < s && t[a] == '/' && t[a + 1] == '/'
    }
}

// The piece holding byte pos, or -1 (between pieces).
fn piece_at(pos: i64) -> i64 {
    unsafe {
        var lo = 0;
        var hi = P_START.count;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if P_START.data[mid] <= pos {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        let i = lo - 1;
        if i >= 0 && pos < P_END.data[i] { i } else { -1 }
    }
}

fn place_of_kind(k: i64) -> i64 {
    if k == LINE_COMMENT || k == BLOCK_COMMENT {
        return G_COMMENT;
    }
    if k == Tok::Str as i64 || k == Tok::CStr as i64 || k == Tok::Char as i64
        || k == Tok::FHead as i64 || k == Tok::FMid as i64 || k == Tok::FTail as i64 {
        return G_STRING;
    }
    G_CODE
}

// Whether the match [s, e) of the text read is in one of `places` (G_*
// bits): inside one comment or literal, or in code (tokens of code and
// the blanks between them: `a::b`).
pub fn match_in(s: i64, e: i64, places: i64) -> bool {
    unsafe {
        if BY_LINES {
            return (places & G_COMMENT) != 0 && in_line_comment(s, e);
        }
        let i = piece_at(s);
        if i < 0 {
            return false;
        }
        let p = place_of_kind(P_KIND.data[i]);
        if (p & places) == 0 {
            return false;
        }
        if e <= P_END.data[i] {
            return true;
        }
        if p != G_CODE {
            return false;
        }
        var j = i + 1;
        while j < P_START.count && P_START.data[j] < e {
            if place_of_kind(P_KIND.data[j]) != G_CODE {
                return false;
            }
            j += 1;
        }
        true
    }
}

// The places that hold matches (starts, ends) and the ones that do not:
// the number of matches in each of code, comments and strings, into
// counts[0..3].
pub fn count_places(starts: IntVec, ends: IntVec, counts: *i64) {
    unsafe {
        for k in 0..starts.count {
            let i = piece_at(starts.data[k]);
            if i < 0 {
                continue;
            }
            let p = place_of_kind(P_KIND.data[i]);
            if p == G_CODE {
                counts[0] += 1;
            } else if p == G_COMMENT {
                counts[1] += 1;
            } else {
                counts[2] += 1;
            }
        }
    }
}
