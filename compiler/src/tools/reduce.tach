// `tachyonc reduce` (0.17): a failing input made small, line by line.
//
//     tachyonc reduce FILE --until 'CMD' [--out FILE] [--max-runs N]
//
// CMD (run by `sh -c`, `{}` replaced by the candidate's path) exits with 0
// while the candidate still shows the failure: `./prog < {} | grep -q
// wrong`, `./prog < {}; test $? = 101`, `tachyonc {} -o /dev/null 2>&1 |
// grep -q 'internal'`. Delta debugging on the lines: chunks of the lines
// left out while CMD still holds, halving the chunks when none can go.
// FILE is not changed; the result is written to FILE.min (--out), and
// printed when short. The candidate keeps FILE's name, in .tachyonc/reduce/
// next to it (a program's root named the same).

mod program;

use crate::base::{
    IntVec, STDOUT, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, streq,
};
use crate::tools::proc::{buf_cstr, make_dirs, read_file_if, remove_file, write_file_if};
use crate::tools::query::{c_slice, parse_count};
use crate::tools::query::diagnostics::{PROG, TOOL, diag, write_diags};
use crate::tools::reduce::program::{program_mode, program_option, reduce_program};
use crate::tools::v018::reduce_mode018;

static var RUNS: i64 = 0;
static var MAX_RUNS: i64 = 500;
// Seconds a run of CMD may take (--timeout), and the runs stopped.
static var TIMEOUT: i64 = 5;
static var TIMED_OUT: i64 = 0;

extern "C" {
    fn fork() -> i32;
    fn execvp(file: *u8, argv: **u8) -> i32;
    fn waitpid(pid: i32, status: *i32, options: i32) -> i32;
    fn setpgid(pid: i32, group: i32) -> i32;
    fn kill(pid: i32, sig: i32) -> i32;
    fn usleep(us: u32) -> i32;
    fn open(path: *u8, flags: i32) -> i32;
    fn dup2(from: i32, to: i32) -> i32;
    fn close(fd: i32) -> i32;
    fn _exit(code: i32) -> !;
}

pub fn run_reduce(argc: i64, argv: **u8) -> i64 {
    let status = reduce_inner(argc, argv);
    write_diags();
    status
}

fn usage(why: *u8, word: *u8) -> i64 {
    unsafe {
        let d = diag(c"error", c"reduce.usage");
        buf_str(d, why);
        if word != 0 as *u8 {
            buf_str(d, c" '");
            buf_str(d, word);
            buf_byte(d, '\'');
        }
        buf_str(d, c"; usage: tachyonc reduce FILE --until 'CMD' [--out FILE] [--max-runs N] [--timeout S] ({} in CMD: the candidate; exit 0: it still fails); tachyonc reduce PROG.tach --differs [--input F] | --fails 'TEXT' | --test NAME [--differs] (a program made small)\n");
        2
    }
}

// The candidate's path: .tachyonc/reduce/NAME next to FILE.
fn candidate_path(file: *u8) -> *u8 {
    unsafe {
        let s = c_slice(file);
        var slash = s.len;
        while slash > 0 && s[slash - 1] != '/' {
            slash -= 1;
        }
        let d = buf_new();
        buf_bytes(d, s[0..slash]);
        buf_bytes(d, ".tachyonc/reduce");
        let dir = buf_cstr(d);
        make_dirs(dir);
        let b = buf_new();
        buf_str(b, dir);
        buf_byte(b, '/');
        buf_bytes(b, s[slash..s.len]);
        buf_cstr(b)
    }
}

// CMD with each `{}` replaced by path.
fn command_for(cmd: *u8, path: *u8) -> *u8 {
    unsafe {
        let s = c_slice(cmd);
        let b = buf_new();
        var i = 0;
        while i < s.len {
            if i + 1 < s.len && s[i] == '{' && s[i + 1] == '}' {
                buf_byte(b, '\'');
                buf_str(b, path);
                buf_byte(b, '\'');
                i += 2;
            } else {
                buf_byte(b, s[i]);
                i += 1;
            }
        }
        buf_cstr(b)
    }
}

// Runs `sh -c cmd` (its output dropped) in a process group of its own,
// killed with it after TIMEOUT seconds: whether it exited with 0.
fn run_limited(cmd: *u8) -> bool {
    unsafe {
        let pid = fork();
        if pid < 0 {
            return false;
        }
        if pid == 0 {
            setpgid(0, 0);
            let null = open(c"/dev/null", 1);
            if null >= 0 {
                dup2(null, 1);
                dup2(null, 2);
                close(null);
            }
            let argv = alloc_array::<*u8>(4);
            argv[0] = c"sh";
            argv[1] = c"-c";
            argv[2] = cmd;
            argv[3] = 0 as *u8;
            execvp(c"sh", argv);
            _exit(127);
        }
        var status = 0 as i32;
        var waited = 0;
        loop {
            let r = waitpid(pid, &status, 1);
            if r == pid {
                break;
            }
            if r < 0 || waited >= TIMEOUT * 100 {
                kill(0 - pid, 9);
                waitpid(pid, &status, 0);
                TIMED_OUT += 1;
                return false;
            }
            usleep(10000);
            waited += 1;
        }
        // (the group's other processes: gone with it)
        kill(0 - pid, 9);
        let s = status as i64;
        (s & 127) == 0 && ((s >> 8) & 255) == 0
    }
}

// Whether CMD holds (exits 0) on the lines `keep` of `lines` (each a
// slice's start and end in text), written to path.
fn holds(text: [u8], lines: IntVec, keep: IntVec, path: *u8, cmd: *u8) -> bool {
    unsafe {
        let b = buf_new();
        for i in 0..keep.count {
            let l = keep.data[i];
            buf_bytes(b, text[lines.data[2 * l]..lines.data[2 * l + 1]]);
        }
        write_file_if(path, buf_slice(b));
        RUNS += 1;
        run_limited(cmd)
    }
}

fn reduce_inner(argc: i64, argv: **u8) -> i64 {
    unsafe {
        PROG = argv[0];
        TOOL = 0 as *u8;
        var file = 0 as *u8;
        var until = 0 as *u8;
        var out = 0 as *u8;
        var i = 2;
        while i < argc {
            let a = argv[i];
            // (0.18 T3: --differs, --fails, --test, --input over a program;
            // tools/reduce/program.tach)
            let taken = program_option(argc, argv, i);
            if taken > 0 {
                i += taken;
                continue;
            }
            if reduce_mode018(a) {
                return usage(c"a value is needed after", a);
            }
            let valued = streq(a, c"--until") || streq(a, c"--out") || streq(a, c"--max-runs")
                || streq(a, c"--timeout");
            if valued && i + 1 >= argc {
                return usage(c"a value is needed after", a);
            }
            if streq(a, c"--until") {
                until = argv[i + 1];
                i += 2;
            } else if streq(a, c"--out") {
                out = argv[i + 1];
                i += 2;
            } else if streq(a, c"--timeout") {
                TIMEOUT = parse_count(argv[i + 1]);
                if TIMEOUT <= 0 {
                    return usage(c"--timeout takes a number of seconds, not", argv[i + 1]);
                }
                i += 2;
            } else if streq(a, c"--max-runs") {
                MAX_RUNS = parse_count(argv[i + 1]);
                if MAX_RUNS <= 0 {
                    return usage(c"--max-runs takes a number, not", argv[i + 1]);
                }
                i += 2;
            } else if a[0] == '-' && a[1] != 0 {
                return usage(c"unknown option", a);
            } else if file != 0 as *u8 {
                return usage(c"one FILE at most; a second", a);
            } else {
                file = a;
                i += 1;
            }
        }
        if program_mode() {
            if file == 0 as *u8 {
                return usage(c"the program's root file is needed", 0 as *u8);
            }
            return reduce_program(file, out, if MAX_RUNS != 500 { MAX_RUNS } else { 0 });
        }
        if file == 0 as *u8 || until == 0 as *u8 {
            return usage(c"FILE and --until 'CMD' are needed", 0 as *u8);
        }
        let original = buf_new();
        if !read_file_if(file, original) {
            let d = diag(c"error", c"reduce.no-file");
            buf_str(d, c"cannot read '");
            buf_str(d, file);
            buf_str(d, c"'\n");
            return 2;
        }
        let text = buf_slice(original);
        // The lines: start and end (with its newline) of each.
        var lines = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var s = 0;
        for k in 0..text.len {
            if text[k] == '\n' {
                lines.push(s);
                lines.push(k + 1);
                s = k + 1;
            }
        }
        if s < text.len {
            lines.push(s);
            lines.push(text.len);
        }
        let n_lines = lines.count / 2;
        var keep = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for k in 0..n_lines {
            keep.push(k);
        }
        let path = candidate_path(file);
        let cmd = command_for(until, path);
        if !holds(text, lines, keep, path, cmd) {
            remove_file(path);
            let d = diag(c"error", c"reduce.not-failing");
            buf_str(d, c"the command does not hold (exit 0) on ");
            buf_str(d, file);
            buf_str(d, c" as it is: ");
            buf_str(d, cmd);
            buf_byte(d, '\n');
            return 1;
        }
        // Delta debugging: chunks of the lines left out.
        var parts = 2;
        while keep.count >= 2 && RUNS < MAX_RUNS {
            let size = (keep.count + parts - 1) / parts;
            var gone = false;
            var start = 0;
            while start < keep.count && RUNS < MAX_RUNS {
                var rest = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                for k in 0..keep.count {
                    if k < start || k >= start + size {
                        rest.push(keep.data[k]);
                    }
                }
                if rest.count > 0 && holds(text, lines, rest, path, cmd) {
                    keep = rest;
                    gone = true;
                    // (the same chunk position holds new lines now)
                } else {
                    start += size;
                }
            }
            if gone {
                parts = if parts > 2 { parts - 1 } else { 2 };
            } else {
                if parts >= keep.count {
                    break;
                }
                parts = if parts * 2 < keep.count { parts * 2 } else { keep.count };
            }
        }
        // The result, written and shown.
        let result = buf_new();
        for k in 0..keep.count {
            let l = keep.data[k];
            buf_bytes(result, text[lines.data[2 * l]..lines.data[2 * l + 1]]);
        }
        let target = if out != 0 as *u8 { out } else {
            let b = buf_new();
            buf_str(b, file);
            buf_bytes(b, ".min");
            buf_cstr(b)
        };
        write_file_if(target, buf_slice(result));
        remove_file(path);
        let o = buf_new();
        buf_bytes(o, "reduced ");
        buf_str(o, file);
        buf_bytes(o, ": ");
        buf_int(o, n_lines);
        buf_bytes(o, " lines to ");
        buf_int(o, keep.count);
        buf_bytes(o, " in ");
        buf_int(o, RUNS);
        buf_bytes(o, " runs");
        if RUNS >= MAX_RUNS {
            buf_bytes(o, " (--max-runs reached: not minimal)");
        }
        if TIMED_OUT > 0 {
            buf_bytes(o, " (");
            buf_int(o, TIMED_OUT);
            buf_bytes(o, " stopped after --timeout S: taken as not failing)");
        }
        buf_bytes(o, "; written to ");
        buf_str(o, target);
        buf_byte(o, '\n');
        if keep.count <= 30 {
            buf_bytes(o, buf_slice(result));
            let r = buf_slice(result);
            if r.len > 0 && r[r.len - 1] != '\n' {
                buf_byte(o, '\n');
            }
        }
        buf_write_fd(o, STDOUT);
        0
    }
}
