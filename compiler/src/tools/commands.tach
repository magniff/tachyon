// The commands that change a program (0.11; docs/refactor.md), in one
// table: `tachyonc COMMAND ...` and each line of a `tachyonc refactor
// --script FILE` reach them from here, so a command added here works in
// scripts too.
//
//   run_tool       the top-level commands a script may run: edit, fix,
//                  rewrite, refactor
//   run_refactor   `refactor SUB ...`: one row per subcommand
//
// A command is `fn(argc: i64, argv: **u8) -> i64` (argv[1] is its word,
// argv[2] a refactor's subcommand), returns the exit status and prints
// its diagnostics itself; it changes the program through the edit engine
// (edit.tach: edit_replace, edit_new_file, then apply_edit or
// prepare_edit and finish_edit), which a script's step makes write
// copies only (STEP_REPORT).

use crate::base::{buf_str, streq};
use crate::tools::query::diagnostics::{PROG, diag, diags, put_cword, try_end, write_diags};
use crate::tools::edit::cli::run_edit;
use crate::tools::fix::run_fix;
use crate::tools::rewrite::run_rewrite;
use crate::tools::refactor_shape::field::run_field;
use crate::tools::refactor_shape::signature::run_signature;
use crate::tools::refactor_shape::variant::run_variant;
use crate::tools::script::run_script;
use crate::tools::refactor_mod::cli::run_refactor_mod;

// A top-level command a script may run: its exit status, or -1 when
// `word` is none.
pub fn run_tool(word: *u8, argc: i64, argv: **u8) -> i64 {
    unsafe {
        if streq(word, c"edit") {
            return run_edit(argc, argv);
        }
        if streq(word, c"fix") {
            return run_fix(argc, argv);
        }
        if streq(word, c"rewrite") {
            return run_rewrite(argc, argv);
        }
        if streq(word, c"refactor") {
            return run_refactor(argc, argv);
        }
        -1
    }
}

// The subcommands of `tachyonc refactor`, for messages.
fn refactor_names() -> *u8 {
    c"rename, move, new-module, move-module, split, signature, field, variant, --script"
}

// `tachyonc refactor SUB ...`.
pub fn run_refactor(argc: i64, argv: **u8) -> i64 {
    unsafe {
        let sub = if argc >= 3 { argv[2] } else { c"" };
        // Phase 2b (refactor_shape.tach, script.tach).
        if streq(sub, c"signature") {
            return run_signature(argc, argv);
        }
        if streq(sub, c"field") {
            return run_field(argc, argv);
        }
        if streq(sub, c"variant") {
            return run_variant(argc, argv);
        }
        if streq(sub, c"--script") {
            return run_script(argc, argv);
        }
        // Phase 2a (refactor_mod.tach, refactor_move.tach).
        if streq(sub, c"rename") {
            return run_refactor_mod(argc, argv);
        }
        if streq(sub, c"move") {
            return run_refactor_mod(argc, argv);
        }
        if streq(sub, c"new-module") {
            return run_refactor_mod(argc, argv);
        }
        if streq(sub, c"move-module") {
            return run_refactor_mod(argc, argv);
        }
        if streq(sub, c"split") {
            return run_refactor_mod(argc, argv);
        }
        PROG = argv[0];
        let d = diag(c"error", c"refactor.usage");
        if argc < 3 {
            buf_str(d, c"no command (");
        } else {
            buf_str(d, c"unknown command '");
            buf_str(d, sub);
            buf_str(d, c"' (");
        }
        buf_str(d, refactor_names());
        buf_str(d, c")\n");
        let out = diags();
        buf_str(out, c"try:");
        put_cword(out, PROG);
        buf_str(out, c" refactor signature NAME --add 'x: i64 = 0' --dry-run");
        try_end(out);
        write_diags();
        2
    }
}

// Whether a script may run `word` (a top-level command of run_tool).
pub fn is_tool(word: *u8) -> bool {
    unsafe { streq(word, c"edit") || streq(word, c"fix") || streq(word, c"rewrite") || streq(word, c"refactor") }
}
