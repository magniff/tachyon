// `tachyonc same-output OLD [--corpus DIR|FILE]... [-j N] [--work DIR]`
// (0.11; docs/refactor.md): a pure refactoring of the compiler proven to
// change nothing. Every program of the corpus is compiled by OLD and by
// this compiler, for every target both have, at -O0, -O1 and -O2, and the
// outputs are compared byte for byte: the assembly, what the compiler
// printed, and its exit status (tests/compare.sh does this and more, in
// sh).
//
// The corpus: tests/run, examples, bench and compiler/src by default. A
// directory holds programs: its main.tach when that is a module tree's
// root (it has `mod` items), else each of its .tach files and each
// SUB/main.tach. Each comparison runs in a copy of this process (a
// worker), up to -j at once; its outputs go to WORK/N/ and are kept when
// they differ.

use crate::base::{
    BUFS, IntVec, STDOUT, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, streq,
};
use crate::base::target::{target_name, target_of_name};
use crate::front::cpp::directives::file_exists;
use crate::tools::proc::{
    buf_cstr, fork_worker, make_dirs, read_file_if, remove_dir, remove_file, run_capture,
    same_bytes, spawn_to_file, wait_any, worker_exit,
};
use crate::tools::query::{c_slice, ends_with_c};
use crate::tools::query::diagnostics::{PROG, diag, diags, put_cword, try_end, write_diags};

// The compilations: program (C string), target, level; and the outcome
// (0 same, 1 different, 2 could not run).
static mut J_PROG: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut J_TARGET: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut J_LEVEL: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut J_RESULT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

static mut WORK: *u8 = 0 as *u8;
static mut OLD: *u8 = 0 as *u8;

// `DIR/NAME`.
fn join_path(dir: *u8, name: [u8]) -> *u8 {
    unsafe {
        let b = buf_new();
        buf_str(b, dir);
        if BUFS[b].len > 0 && BUFS[b].data[BUFS[b].len - 1] != '/' {
            buf_byte(b, '/');
        }
        buf_bytes(b, name);
        buf_cstr(b)
    }
}

// Whether file `path` is the root of a module tree (it has a `mod` item).
fn is_tree_root(path: *u8) -> bool {
    let text = buf_new();
    if !read_file_if(path, text) {
        return false;
    }
    let t = buf_slice(text);
    let mut i = 0;
    while i + 4 < t.len {
        if (i == 0 || t[i - 1] == '\n') && t[i] == 'm' && t[i + 1] == 'o' && t[i + 2] == 'd'
            && t[i + 3] == ' ' {
            return true;
        }
        i += 1;
    }
    false
}

// The programs of corpus entry `entry` (a file, or a directory), into out.
fn add_programs(entry: *u8, out: *IntVec) -> bool {
    unsafe {
        if ends_with_c(entry, c".tach") {
            if !file_exists(entry) {
                return false;
            }
            out.push(entry as i64);
            return true;
        }
        let root = join_path(entry, c_slice(c"main.tach"));
        if file_exists(root) && is_tree_root(root) {
            out.push(root as i64);
            return true;
        }
        // `ls -1 DIR`: its .tach files, and its directories with a main.tach.
        let args = alloc_array::<*u8>(4);
        args[0] = c"ls";
        args[1] = c"-1";
        args[2] = entry;
        args[3] = 0 as *u8;
        let listing = buf_new();
        if run_capture(args, listing) != 0 {
            return false;
        }
        let t = buf_slice(listing);
        let mut i = 0;
        while i < t.len {
            let mut e = i;
            while e < t.len && t[e] != '\n' {
                e += 1;
            }
            let name = t[i..e];
            i = e + 1;
            if name.len == 0 {
                continue;
            }
            let path = join_path(entry, name);
            if ends_with_c(path, c".tach") {
                out.push(path as i64);
            } else {
                let sub = join_path(path, c_slice(c"main.tach"));
                if file_exists(sub) {
                    out.push(sub as i64);
                }
            }
        }
        true
    }
}

// The number of processors (4 when it cannot be told).
fn processors() -> i64 {
    unsafe {
        let args = alloc_array::<*u8>(3);
        args[0] = c"getconf";
        args[1] = c"_NPROCESSORS_ONLN";
        args[2] = 0 as *u8;
        let out = buf_new();
        if run_capture(args, out) != 0 {
            return 4;
        }
        let t = buf_slice(out);
        let mut n = 0;
        let mut i = 0;
        while i < t.len && t[i] >= '0' && t[i] <= '9' {
            n = n * 10 + (t[i] - '0') as i64;
            i += 1;
        }
        if n < 1 { 4 } else { n }
    }
}

// Whether compiler `cc` has target t (`cc --target T --version` works).
fn has_target(cc: *u8, t: i64) -> bool {
    unsafe {
        let args = alloc_array::<*u8>(5);
        args[0] = cc;
        args[1] = c"--target";
        args[2] = target_name(t);
        args[3] = c"--version";
        args[4] = 0 as *u8;
        let out = buf_new();
        run_capture(args, out) == 0
    }
}

// The directory of compilation j: `WORK/j`.
fn job_dir(j: i64) -> *u8 {
    unsafe {
        let b = buf_new();
        buf_str(b, WORK);
        buf_byte(b, '/');
        buf_int(b, j);
        buf_cstr(b)
    }
}

fn level_flag(level: i64) -> *u8 {
    if level == 0 { c"-O0" } else if level == 1 { c"-O1" } else { c"-O2" }
}

// Compiler `cc` on compilation j, its output in DIR/WHO.s and what it
// printed in DIR/WHO.out; its exit status.
fn compile_one(cc: *u8, j: i64, dir: *u8, who: *u8) -> i64 {
    unsafe {
        let asm = buf_new();
        buf_str(asm, dir);
        buf_byte(asm, '/');
        buf_str(asm, who);
        buf_str(asm, c"/out.s");
        let printed = buf_new();
        buf_str(printed, dir);
        buf_byte(printed, '/');
        buf_str(printed, who);
        buf_str(printed, c".out");
        let sub = buf_new();
        buf_str(sub, dir);
        buf_byte(sub, '/');
        buf_str(sub, who);
        make_dirs(buf_cstr(sub));
        let args = alloc_array::<*u8>(9);
        args[0] = cc;
        args[1] = c"--target";
        args[2] = target_name(J_TARGET.data[j]);
        args[3] = level_flag(J_LEVEL.data[j]);
        args[4] = J_PROG.data[j] as *u8;
        args[5] = c"-o";
        args[6] = buf_cstr(asm);
        // (0.15: one form of the errors, whatever the default of each:
        // a build whose stderr is not a terminal prints the short form)
        args[7] = c"--diagnostics=human";
        args[8] = 0 as *u8;
        let pid = spawn_to_file(args, buf_cstr(printed));
        if pid < 0 {
            return 127;
        }
        let mut status = 0;
        while wait_any(&status) != pid {
        }
        status
    }
}

// In a worker: compilation j by both compilers, compared. Exit 0: the
// same, 1: different (the outputs stay in WORK/j), 2: not run.
fn run_job(j: i64) -> ! {
    unsafe {
        let dir = job_dir(j);
        make_dirs(dir);
        let a = compile_one(OLD, j, dir, c"old");
        let b = compile_one(PROG, j, dir, c"new");
        let same = a == b && same_file(dir, c"old/out.s", c"new/out.s")
            && same_file(dir, c"old.out", c"new.out");
        if same {
            remove_file(join_path(dir, c_slice(c"old/out.s")));
            remove_file(join_path(dir, c_slice(c"new/out.s")));
            remove_file(join_path(dir, c_slice(c"old.out")));
            remove_file(join_path(dir, c_slice(c"new.out")));
            remove_dir(join_path(dir, c_slice(c"old")));
            remove_dir(join_path(dir, c_slice(c"new")));
            remove_dir(dir);
            worker_exit(0);
        }
        // (the exit statuses, for the report)
        let st = buf_new();
        buf_int(st, a);
        buf_byte(st, ' ');
        buf_int(st, b);
        buf_byte(st, '\n');
        crate::tools::proc::write_file_if(join_path(dir, c_slice(c"status")), buf_slice(st));
        worker_exit(1)
    }
}

// Whether DIR/A and DIR/B have the same bytes (both missing: the same).
fn same_file(dir: *u8, a: *u8, b: *u8) -> bool {
    unsafe {
        let x = buf_new();
        let y = buf_new();
        let hx = read_file_if(join_path(dir, c_slice(a)), x);
        let hy = read_file_if(join_path(dir, c_slice(b)), y);
        hx == hy && same_bytes(buf_slice(x), buf_slice(y))
    }
}

pub fn run_same_output(argc: i64, argv: **u8) -> i64 {
    let status = run_inner(argc, argv);
    write_diags();
    status
}

fn usage(message: *u8) -> i64 {
    unsafe {
        let d = diag(c"error", c"same-output.usage");
        buf_str(d, message);
        buf_byte(d, '\n');
        let o = diags();
        buf_str(o, c"try:");
        put_cword(o, PROG);
        buf_str(o, c" same-output path/to/old/tachyonc");
        try_end(o);
        2
    }
}

// OLD as the shell finds it (0.16): a name without a `/` and no file
// here, in the directories of $PATH; else as it is.
fn find_compiler(name: *u8) -> *u8 {
    unsafe {
        let mut k = 0;
        while name[k] != 0 {
            if name[k] == '/' {
                return name;
            }
            k += 1;
        }
        let path = crate::base::getenv(c"PATH");
        if path == 0 as *u8 || file_exists(name) {
            return name;
        }
        let mut start = 0;
        let mut i = 0;
        loop {
            if path[i] == ':' || path[i] == 0 {
                let b = buf_new();
                if i == start {
                    buf_byte(b, '.');
                }
                for j in start..i {
                    buf_byte(b, path[j]);
                }
                buf_byte(b, '/');
                buf_str(b, name);
                buf_byte(b, 0);
                if file_exists(BUFS[b].data) {
                    return BUFS[b].data;
                }
                if path[i] == 0 {
                    return name;
                }
                start = i + 1;
            }
            i += 1;
        }
    }
}

fn run_inner(argc: i64, argv: **u8) -> i64 {
    unsafe {
        PROG = argv[0];
        let mut corpus = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut jobs = 0;
        WORK = c"target/same-output";
        let mut i = 2;
        while i < argc {
            let a = argv[i];
            if streq(a, c"--corpus") && i + 1 < argc {
                corpus.push(argv[i + 1] as i64);
                i += 2;
                continue;
            }
            if streq(a, c"-j") && i + 1 < argc {
                jobs = crate::tools::query::parse_count(argv[i + 1]);
                i += 2;
                continue;
            }
            if streq(a, c"--work") && i + 1 < argc {
                WORK = argv[i + 1];
                i += 2;
                continue;
            }
            if a[0] == '-' {
                return usage(c"unknown option");
            }
            if OLD != 0 as *u8 {
                return usage(c"one OLD compiler");
            }
            OLD = find_compiler(a);
            i += 1;
        }
        if OLD == 0 as *u8 {
            return usage(c"same-output needs the OLD compiler to compare with");
        }
        if !file_exists(OLD) {
            let d = diag(c"error", c"same-output.no-compiler");
            buf_str(d, c"cannot run '");
            buf_str(d, OLD);
            buf_str(d, c"'\n");
            return 2;
        }
        let explicit = corpus.count > 0;
        if !explicit {
            corpus.push(c"tests/run" as i64);
            corpus.push(c"examples" as i64);
            corpus.push(c"bench" as i64);
            corpus.push(c"compiler/src" as i64);
        }
        let mut programs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for k in 0..corpus.count {
            let e = corpus.data[k] as *u8;
            if !add_programs(e, &programs) && explicit {
                let d = diag(c"error", c"same-output.no-corpus");
                buf_str(d, c"cannot read '");
                buf_str(d, e);
                buf_str(d, c"'\n");
                return 2;
            }
        }
        if programs.count == 0 {
            let d = diag(c"error", c"same-output.no-corpus");
            buf_str(d,
                c"no programs (tests/run, examples, bench, compiler/src; or --corpus DIR)\n");
            return 2;
        }
        // The targets: this compiler's, the ones OLD has too.
        let mut targets = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for t in 1..16 {
            if target_of_name(target_name(t)) != t {
                continue;
            }
            if has_target(OLD, t) {
                targets.push(t);
            } else {
                let d = diag(c"note", c"same-output.target");
                buf_str(d, OLD);
                buf_str(d, c" has no target ");
                buf_str(d, target_name(t));
                buf_str(d, c"; not compared\n");
            }
        }
        if targets.count == 0 {
            let d = diag(c"error", c"same-output.no-compiler");
            buf_str(d, OLD);
            buf_str(d, c" compiles for none of this compiler's targets\n");
            return 2;
        }
        for p in 0..programs.count {
            for t in 0..targets.count {
                for level in 0..3 {
                    J_PROG.push(programs.data[p]);
                    J_TARGET.push(targets.data[t]);
                    J_LEVEL.push(level);
                    J_RESULT.push(-1);
                }
            }
        }
        if !make_dirs(WORK) {
            let d = diag(c"error", c"same-output.work");
            buf_str(d, c"cannot make '");
            buf_str(d, WORK);
            buf_str(d, c"'\n");
            return 2;
        }
        if jobs <= 0 {
            jobs = processors();
        }
        // The workers: up to `jobs` at once.
        let total = J_PROG.count;
        let pids = alloc_array::<i64>(total + 1);
        let mut next = 0;
        let mut running = 0;
        while next < total || running > 0 {
            while next < total && running < jobs {
                let pid = fork_worker();
                if pid == 0 {
                    run_job(next);
                }
                if pid < 0 {
                    J_RESULT.data[next] = 2;
                } else {
                    pids[next] = pid;
                    running += 1;
                }
                next += 1;
            }
            let mut status = 0;
            let pid = wait_any(&status);
            if pid < 0 {
                break;
            }
            running -= 1;
            for j in 0..next {
                if pids[j] == pid && J_RESULT.data[j] < 0 {
                    J_RESULT.data[j] = status;
                    break;
                }
            }
        }
        report(programs.count, targets.count)
    }
}

// The summary: `identical<TAB>N compilations...`, or the differences (each
// `PROGRAM<TAB>TARGET<TAB>-ON<TAB>WHAT`, at most 10), the first one's
// first differing line, and the error.
fn report(programs: i64, targets: i64) -> i64 {
    unsafe {
        let total = J_PROG.count;
        let out = buf_new();
        let mut differ = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut failed = 0;
        for j in 0..total {
            if J_RESULT.data[j] == 1 {
                differ.push(j);
            } else if J_RESULT.data[j] != 0 {
                failed += 1;
            }
        }
        if differ.count == 0 && failed == 0 {
            buf_str(out, c"identical\t");
            buf_int(out, total);
            buf_str(out, c" compilations\t");
            buf_int(out, programs);
            buf_str(out, c" programs\t");
            buf_int(out, targets);
            buf_str(out, if targets == 1 { c" target" } else { c" targets" });
            buf_str(out, c"\t-O0 -O1 -O2\n");
            buf_write_fd(out, STDOUT);
            return 0;
        }
        for k in 0..differ.count {
            if k == 10 {
                break;
            }
            let j = differ.data[k];
            buf_str(out, J_PROG.data[j] as *u8);
            buf_byte(out, '\t');
            buf_str(out, target_name(J_TARGET.data[j]));
            buf_byte(out, '\t');
            buf_str(out, level_flag(J_LEVEL.data[j]));
            buf_byte(out, '\t');
            put_difference(out, j, k == 0);
        }
        buf_write_fd(out, STDOUT);
        if failed > 0 {
            let d = diag(c"warning", c"same-output.not-run");
            buf_int(d, failed);
            buf_str(d, c" compilations could not be run\n");
        }
        if differ.count == 0 {
            return 1;
        }
        let first = differ.data[0];
        let d = diag(c"error", c"same-output.differs");
        buf_int(d, differ.count);
        buf_str(d, c" of ");
        buf_int(d, total);
        buf_str(d, c" compilations differ (kept in ");
        buf_str(d, WORK);
        buf_str(d, c")\n");
        let dir = job_dir(first);
        let o = diags();
        let asm_differs = !same_file(dir, c"old/out.s", c"new/out.s");
        buf_str(o, c"try: diff");
        put_cword(o, join_path(dir, c_slice(if asm_differs { c"old/out.s" } else { c"old.out" })));
        put_cword(o, join_path(dir, c_slice(if asm_differs { c"new/out.s" } else { c"new.out" })));
        try_end(o);
        let o2 = diags();
        buf_str(o2, c"try:");
        put_cword(o2, PROG);
        buf_str(o2, c" --target ");
        buf_str(o2, target_name(J_TARGET.data[first]));
        buf_byte(o2, ' ');
        buf_str(o2, level_flag(J_LEVEL.data[first]));
        put_cword(o2, J_PROG.data[first] as *u8);
        buf_str(o2, c" -o new.s");
        try_end(o2);
        1
    }
}

// What differs in compilation j (`exit A B`, `output`, `asm line N`), and
// for the first one the two lines (`-<TAB>old`, `+<TAB>new`).
fn put_difference(out: i64, j: i64, lines: bool) {
    unsafe {
        let dir = job_dir(j);
        let st = buf_new();
        read_file_if(join_path(dir, c_slice(c"status")), st);
        let s = buf_slice(st);
        let mut k = 0;
        while k < s.len && s[k] != ' ' {
            k += 1;
        }
        let same_status = k < s.len && same_bytes(s[0..k], s[k + 1..s.len - 1]);
        if !same_status {
            buf_str(out, c"exit ");
            buf_bytes(out, if s.len > 0 { s[0..s.len - 1] } else { s });
            buf_byte(out, '\n');
            return;
        }
        let asm = !same_file(dir, c"old/out.s", c"new/out.s");
        let a = buf_new();
        let b = buf_new();
        read_file_if(join_path(dir, c_slice(if asm { c"old/out.s" } else { c"old.out" })), a);
        read_file_if(join_path(dir, c_slice(if asm { c"new/out.s" } else { c"new.out" })), b);
        let x = buf_slice(a);
        let y = buf_slice(b);
        // The first differing line.
        let mut i = 0;
        let mut line = 1;
        let mut start = 0;
        while i < x.len && i < y.len && x[i] == y[i] {
            if x[i] == '\n' {
                line += 1;
                start = i + 1;
            }
            i += 1;
        }
        buf_str(out, if asm { c"asm line " } else { c"output line " });
        buf_int(out, line);
        buf_byte(out, '\n');
        if lines {
            buf_str(out, c"-\t");
            put_line_at(out, x, start);
            buf_str(out, c"+\t");
            put_line_at(out, y, start);
        }
    }
}

// The line of text starting at `start` (cut to 100 bytes), and a newline.
fn put_line_at(out: i64, text: [u8], start: i64) {
    if start >= text.len {
        unsafe { buf_str(out, c"(end of file)\n"); }
        return;
    }
    let mut e = start;
    while e < text.len && text[e] != '\n' && e - start < 100 {
        e += 1;
    }
    buf_bytes(out, text[start..e]);
    buf_byte(out, '\n');
}
