// The explanations of the codes of the text edits of a tree (0.21, for
// 0.24's rename): `rewrite --text` and `refactor extension`
// (tools/textual).

use crate::tools::explain::Explain;

pub const TEXTUAL_COUNT: i64 = 21;

pub static TEXTUAL_TABLE: [Explain; 21] = [
    Explain {
        code: "extension.check", severity: "error, exit 1 (note with --dry-run)",
        means: "`refactor extension`: the programs renamed are compiled before and after the \
            rename (in target/extension-check); that directory could not be made. With \
            --dry-run, a note: how many programs would be compiled.",
        fix: "Make target/ writable, or rename with --no-check and run the tests.",
        example: "note extension.check: 1 program would be compiled before and after the rename, and compared",
    },
    Explain {
        code: "extension.differs", severity: "error, exit 1",
        means: "`refactor extension`: a renamed program does not build as it did (its assembly, \
            what the compiler printed or its exit status differ, the renamed paths aside). \
            The rename is undone; both builds are kept in target/extension-check.",
        fix: "Compare target/extension-check/before/N.s with after/N.s: something reads a file \
            by its name (a `mod` with both extensions, a path in the program). Fix it, then \
            rename again.",
        example: "error extension.differs: 1 of 12 programs build differently after the rename \
            (tests/run/x.vl: assembly, line 40); the rename is undone, the outputs are in target/extension-check",
    },
    Explain {
        code: "extension.excluded", severity: "note",
        means: "`refactor extension`: files the exclusions keep were not renamed, and mentions in \
            excluded files and lines were left.",
        fix: "Nothing, when they are history (old releases, past notes); else narrow the exclusions.",
        example: "note extension.excluded: 158 files kept their name (excluded); 40 mentions left in excluded files and lines",
    },
    Explain {
        code: "extension.exists", severity: "error, exit 1",
        means: "`refactor extension`: a file's new name is taken (`x.vl` next to `x.tach`).",
        fix: "Remove or rename the one that is in the way, then rename again.",
        example: "error extension.exists: 'util.vl' exists already: 'util.tach' cannot take its name; nothing renamed",
    },
    Explain {
        code: "extension.no-files", severity: "error, exit 1 (note: nothing to rename)",
        means: "`refactor extension`: no file git tracks under that directory has the old \
            extension; or (a note) every one is excluded.",
        fix: "Name a directory with such files, a program's root, or --all.",
        example: "error extension.no-files: no file of git's ends with .tach under 'nowhere'",
    },
    Explain {
        code: "extension.no-git", severity: "error, exit 2",
        means: "`refactor extension` renames the files git tracks, and this is no git checkout.",
        fix: "Run it in the checkout (or `git init` and add the files first).",
        example: "error extension.no-git: refactor extension renames the files git tracks: this is no git checkout",
    },
    Explain {
        code: "extension.no-program", severity: "error, exit 1",
        means: "`refactor extension ROOT`: the program of ROOT could not be read.",
        fix: "`tachyonc check ROOT` says why.",
        example: "error extension.no-program: cannot read the program of 'main.tach'",
    },
    Explain {
        code: "extension.strings", severity: "note",
        means: "`refactor extension` changes no string literal of a source: a path in a string is \
            what the program does (a compiler looking for `main.tach`), not a mention.",
        fix: "Change them on purpose, checked: the `try:` line (`rewrite --text OLD NEW --word \
            --strings --check ROOT`).",
        example: "note extension.strings: 3 mentions in string literals of 2 sources left: changing them changes what the program does\n\
            try: tachyonc rewrite --text .tach .vl --word --strings --dry-run",
    },
    Explain {
        code: "extension.unresolved", severity: "note",
        means: "`refactor extension ROOT|DIR`: mentions of paths with the old extension that name \
            no renamed file (a glob, a file that is not there), or the end of several files' \
            paths (`main.tach`), were left; the first is shown.",
        fix: "Look at them (`git grep`); with --all every mention changes.",
        example: "note extension.unresolved: 2 mentions name no file, 0 the end of several files' paths: left (run.sh: *.tach)",
    },
    Explain {
        code: "extension.untracked", severity: "note",
        means: "`refactor extension ROOT`: some of the program's files are not git's: they were \
            renamed without git (`git add` them).",
        fix: "`git add` the new files if they belong to the checkout.",
        example: "note extension.untracked: 1 files of the program git does not track: renamed without it",
    },
    Explain {
        code: "extension.usage", severity: "error, exit 2",
        means: "`refactor extension OLD NEW [ROOT|DIR|--all]`: the words or options are not right.",
        fix: "Follow the `try:` line.",
        example: "error extension.usage: OLD and NEW are two extensions\n\
            try: tachyonc refactor extension .tach .vl --all --dry-run",
    },
    Explain {
        code: "rewrite.breaks", severity: "error, exit 1",
        means: "`rewrite --text ... --check ROOT`: the program checks with new errors with the new \
            texts read in place of the files (listed above); nothing was written.",
        fix: "Narrow the rewrite (--comments, --strings, --word, --exclude), or look at the diff \
            (the `try:` line).",
        example: "main.tach: error[type error] unknown function 'shapes::nope'\n\
            error rewrite.breaks: 1 new error in the --check programs; nothing written\n\
            try: tachyonc rewrite --text shapes::rect shapes::nope --check main.tach --dry-run --diff",
    },
    Explain {
        code: "rewrite.check", severity: "error, exit 1",
        means: "`rewrite --text ... --check ROOT`: the check could not run; nothing was written.",
        fix: "`tachyonc check ROOT` says why (a root that does not exist).",
        example: "error rewrite.check: --check could not run the check; nothing written",
    },
    Explain {
        code: "rewrite.exclude", severity: "error, exit 2",
        means: "`--exclude SPEC` (or a line of --exclude-from's file) is malformed: a spec is \
            GLOB (a whole file), GLOB:/RE/ (its lines RE matches) or GLOB:/A/,/B/ (from a line \
            A matches to the line before the next one B matches).",
        fix: "Close each /RE/ (`\\/` is a / in it); the RE is rewrite's (^ $ . * + ? [a-z] \\d \\w).",
        example: "error rewrite.exclude: 'x:/[a/' is no exclusion: GLOB, GLOB:/RE/ (its lines) or GLOB:/A/,/B/ (from A to before B)",
    },
    Explain {
        code: "rewrite.excluded", severity: "note",
        means: "`rewrite --text`: matches in files the exclusions keep whole were left.",
        fix: "Nothing, when they are history; else narrow the exclusions.",
        example: "note rewrite.excluded: 12 matches left in 3 excluded files",
    },
    Explain {
        code: "rewrite.exists", severity: "error, exit 1",
        means: "`rewrite --text --move-paths`: a file's new path is taken; nothing was written.",
        fix: "Move the file in the way first.",
        example: "error rewrite.exists: 'vole-run.sh' exists already; nothing moved",
    },
    Explain {
        code: "rewrite.git", severity: "error, exit 1",
        means: "`rewrite --text --move-paths`, `refactor extension`, `undo` of one: `git \
            update-index` could not move the index's entries; nothing was moved.",
        fix: "`git status` says why (a lock left by another git: .git/index.lock).",
        example: "error rewrite.git: git update-index could not move the index's entries; nothing moved",
    },
    Explain {
        code: "rewrite.kept", severity: "note",
        means: "`rewrite --text`: matches were left in kept lines (an exclusion's /RE/ or range), \
            or in a source, in places other than --comments, --strings, --code asked.",
        fix: "Nothing, when that was meant; `query grep --code OLD` lists a source's in code \
            (identifiers: `refactor rename`).",
        example: "note rewrite.kept: 2 matches left in 1 file: in kept lines (the exclusions), or in other places than --comments, --strings, --code ask",
    },
    Explain {
        code: "rewrite.mixed-case", severity: "note",
        means: "`rewrite --text --case`: some matches were neither all lower, all upper, nor \
            capitalized (`TachYon`): NEW was written as it is there.",
        fix: "Look at them with --dry-run --diff.",
        example: "note rewrite.mixed-case: 1 matches in a mixed case took NEW as it is",
    },
    Explain {
        code: "rewrite.no-git", severity: "error, exit 2",
        means: "`rewrite --text` edits the files git tracks, and this is no git checkout.",
        fix: "Run it in the checkout; for a program's code, `rewrite PATTERN REPLACEMENT`.",
        example: "error rewrite.no-git: --text edits the files git tracks: this is no git checkout",
    },
    Explain {
        code: "rewrite.not-lexed", severity: "warning",
        means: "`rewrite --text --comments|--strings|--code`: some vole sources do not lex (a test \
            of the lexer's errors), so their places are unknown; nothing was changed in them.",
        fix: "Rewrite them without the place options, with --files naming them.",
        example: "warning rewrite.not-lexed: 2 vole sources do not lex: their places are unknown, nothing taken in them",
    },
];
