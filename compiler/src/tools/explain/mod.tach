// `tachyonc explain [CODE]` (0.13; docs/query.md): what a diagnostic
// code means, how to fix it, an example, from one table: every code the
// tools print (`error query.no-match: ...`) and the kinds of the
// compiler's errors and warnings (`error[type error]`), in tools_table
// and refactor_table. tests/refactor/run.sh checks that every code in
// the compiler's source has an entry.
//
//   tachyonc explain CODE      the entry (`type-error` for `type error`)
//   tachyonc explain PREFIX    the codes of a tool (`explain fmt`)
//   tachyonc explain           every code, with its severity
//   tachyonc explain --list    every code, one per line

mod tools_table;
mod refactor_table;
// (0.18: the codes of contracts, distinct types and tests)
mod v018_table;

use crate::base::{STDOUT, buf_byte, buf_bytes, buf_new, buf_str, buf_write_fd, streq};
use crate::base::diag::edit_distance;
use crate::guide::find::guide_find;
use crate::tools::explain::refactor_table::{REFACTOR_COUNT, REFACTOR_TABLE};
use crate::tools::explain::tools_table::{TOOLS_COUNT, TOOLS_TABLE};
use crate::tools::explain::v018_table::{V018_COUNT, V018_TABLE};
use crate::tools::proc::same_bytes;
use crate::tools::query::c_slice;
use crate::tools::query::diagnostics::{PROG, TOOL, diag, put_word, try_begin, try_end, write_diags};

pub struct Explain { code: [u8], severity: [u8], means: [u8], fix: [u8], example: [u8] }

fn count() -> i64 {
    TOOLS_COUNT + REFACTOR_COUNT + V018_COUNT
}

fn entry(i: i64) -> *Explain {
    unsafe {
        if i < TOOLS_COUNT { &TOOLS_TABLE[i] as *Explain }
        else if i < TOOLS_COUNT + REFACTOR_COUNT { &REFACTOR_TABLE[i - TOOLS_COUNT] as *Explain }
        else { &V018_TABLE[i - TOOLS_COUNT - REFACTOR_COUNT] as *Explain }
    }
}

// CODE as the table has it: lower case but for `C import`; without
// `error[...]` around it; `-` and `_` as spaces in a compiler kind (no
// dot).
fn normal(arg: [u8]) -> i64 {
    unsafe {
        let mut s = arg;
        let mut k = 0;
        while k < s.len && s[k] != '[' {
            k += 1;
        }
        if k < s.len && s[s.len - 1] == ']' {
            s = s[k + 1..s.len - 1];
        }
        let mut dot = false;
        for i in 0..s.len {
            if s[i] == '.' {
                dot = true;
            }
        }
        let out = buf_new();
        for i in 0..s.len {
            let mut c = s[i];
            if !dot && (c == '-' || c == '_') {
                c = ' ';
            }
            if c >= 'A' && c <= 'Z' && !(i == 0 && c == 'C') {
                c = c - 'A' + 'a';
            }
            if i == 0 && c == 'c' && s.len > 1 && (s[1] == ' ' || s[1] == '-' || s[1] == '_') {
                c = 'C';
            }
            buf_byte(out, c);
        }
        out
    }
}

fn put_entry(out: i64, e: *Explain) {
    unsafe {
        buf_bytes(out, (*e).code);
        buf_str(out, c": ");
        buf_bytes(out, (*e).severity);
        buf_byte(out, '\n');
        buf_bytes(out, (*e).means);
        buf_str(out, c"\nfix: ");
        buf_bytes(out, (*e).fix);
        buf_str(out, c"\nexample:\n    ");
        let x = (*e).example;
        for i in 0..x.len {
            buf_byte(out, x[i]);
            if x[i] == '\n' {
                buf_str(out, c"    ");
            }
        }
        buf_byte(out, '\n');
    }
}

fn usage(message: *u8) -> i64 {
    unsafe {
        let d = diag(c"error", c"explain.usage");
        buf_str(d, message);
        buf_byte(d, '\n');
        try_end(try_begin(c"explain query.no-match", c_slice(c""), false));
        2
    }
}

pub fn run_explain(argc: i64, argv: **u8) -> i64 {
    let status = explain_inner(argc, argv);
    write_diags();
    status
}

fn explain_inner(argc: i64, argv: **u8) -> i64 {
    unsafe {
        PROG = argv[0];
        TOOL = 0 as *u8;
        let out = buf_new();
        if argc == 2 || (argc == 3 && streq(argv[2], c"--list")) {
            for i in 0..count() {
                buf_bytes(out, (*entry(i)).code);
                if argc == 2 {
                    buf_byte(out, '\t');
                    buf_bytes(out, (*entry(i)).severity);
                }
                buf_byte(out, '\n');
            }
            buf_write_fd(out, STDOUT);
            return 0;
        }
        if argv[2][0] == '-' {
            return usage(c"no options but --list");
        }
        if argc > 3 {
            // (0.15: words, a compiler's message: the guide about them)
            let q = buf_new();
            for k in 2..argc {
                if k > 2 {
                    buf_byte(q, ' ');
                }
                buf_str(q, argv[k]);
            }
            if explain_by_guide(crate::base::buf_slice(q)) == 0 {
                return 0;
            }
            let d = diag(c"error", c"explain.unknown");
            buf_str(d, c"no code, and no paragraph of the guide about '");
            buf_bytes(d, crate::base::buf_slice(q));
            buf_str(d, c"'\n");
            try_end(try_begin(c"explain", c_slice(c""), false));
            return 1;
        }
        let want = crate::base::buf_slice(normal(c_slice(argv[2])));
        for i in 0..count() {
            if same_bytes((*entry(i)).code, want) {
                put_entry(out, entry(i));
                buf_write_fd(out, STDOUT);
                return 0;
            }
        }
        // A tool's name: its codes (0.16: as written too, `same-output`
        // keeps its `-`).
        let raw = c_slice(argv[2]);
        let mut listed = 0;
        for i in 0..count() {
            let c = (*entry(i)).code;
            if (c.len > want.len && c[want.len] == '.' && same_bytes(c[0..want.len], want))
                || (c.len > raw.len && c[raw.len] == '.' && same_bytes(c[0..raw.len], raw)) {
                buf_bytes(out, c);
                buf_byte(out, '\t');
                buf_bytes(out, (*entry(i)).severity);
                buf_byte(out, '\n');
                listed += 1;
            }
        }
        if listed > 0 {
            buf_write_fd(out, STDOUT);
            return 0;
        }
        if explain_by_guide(c_slice(argv[2])) == 0 {
            return 0;
        }
        let d = diag(c"error", c"explain.unknown");
        buf_str(d, c"no code '");
        buf_bytes(d, want);
        buf_str(d, c"'\n");
        // The nearest codes (at most 3, within a third of the length).
        let mut shown = 0;
        let mut dist = 1;
        while dist <= want.len / 3 + 1 && shown < 3 {
            for i in 0..count() {
                let c = (*entry(i)).code;
                if shown < 3 && edit_distance(c, want) == dist {
                    let t = try_begin(c"explain", c_slice(c""), false);
                    put_word(t, c);
                    try_end(t);
                    shown += 1;
                }
            }
            dist += 1;
        }
        if shown == 0 {
            try_end(try_begin(c"explain", c_slice(c""), false));
        }
        1
    }
}

// (0.15) WORDS that are no code (`explain type`, a compiler's message):
// the guide's paragraphs about them (guide --find, 600 tokens at most),
// after a note; 0, or 1 when the guide has none or words is spelt like a
// code (nothing printed).
fn explain_by_guide(words: [u8]) -> i64 {
    unsafe {
        let out = buf_new();
        let mut left = 0;
        if find_dot(words) || guide_find(words, 600 * 4, out, &left) == 0 {
            return 1;
        }
        let d = diag(c"note", c"explain.guide");
        buf_str(d, c"'");
        buf_bytes(d, words);
        buf_str(d, c"' is no code: the guide's paragraphs about it\n");
        if left > 0 {
            let t = try_begin(c"guide", c_slice(c""), false);
            buf_str(t, c" --find");
            put_word(t, words);
            buf_str(t, c" --budget 3000");
            try_end(t);
        }
        buf_write_fd(out, STDOUT);
        0
    }
}

// Whether s has a `.` (a code's spelling, `query.no-match`).
fn find_dot(s: [u8]) -> bool {
    for i in 0..s.len {
        if s[i] == '.' {
            return true;
        }
    }
    false
}
