// The explanations of the diagnostic codes of the refactorings, rewrite
// and the compiler itself (its errors' and warnings' kinds, as in
// `error[type error]`), for `tachyonc explain CODE` (0.13).

use crate::tools::explain::Explain;

pub const REFACTOR_COUNT: i64 = 60;

pub static REFACTOR_TABLE: [Explain; 60] = [
    Explain {
        code: "refactor.ambiguous", severity: "error, exit 1",
        means: "`refactor inline FN --at FILE:LINE`: that line has several calls of FN.",
        fix: "Inline every call (no --at), or put the call wanted on a line of its own first.",
        example: "error refactor.ambiguous: main.tach:12 has 2 calls of crate::sq; inline them all, or put one on a line of its own",
    },
    Explain {
        code: "refactor.ambiguous-local", severity: "error, exit 1",
        means: "`refactor rename FN::x NEW`: FN has several locals named x (one shadows another).",
        fix: "Name the one wanted by the position of its declaration, as the `try:` lines do.",
        example: "error refactor.ambiguous-local: crate::total::x is several locals (shadowing); name one by its position\n\
            try: tachyonc refactor rename main.tach:7:9 y\ntry: tachyonc refactor rename main.tach:9:13 y",
    },
    Explain {
        code: "refactor.anchor", severity: "error, exit 1",
        means: "`refactor move --after|--before ITEM`: ITEM is not an item of the target module \
            with lines of its own (or it is one of the items moved).",
        fix: "Name an item that stays in the target module (`query items MODULE` lists them).",
        example: "error refactor.anchor: --after area: not an item of crate::geom with lines of its own \
            (a function, type, constant, static)\ntry: tachyonc query items crate::geom",
    },
    Explain {
        code: "refactor.clash", severity: "error, exit 1",
        means: "The new name (of a parameter, field or variant) is taken there.",
        fix: "Choose another name; `query show` of the item shows the names it has.",
        example: "error refactor.clash: 'y' is a field of crate::geom::P already",
    },
    Explain {
        code: "refactor.closure", severity: "error, exit 1",
        means: "`extract-function` (0.14): NEW would take or give back a closure (or a value \
            holding one, `Map<I, F>`), whose type has no name to write in its signature.",
        fix: "Extract the lines that make the closure too (the `try:` line starts at its `let`), \
            or the ones that use it after; or make the closure a named function.",
        example: "error refactor.closure: lines 6-7 use 'scale', a closure made before them; a \
            closure's type has no name for NEW's signature\n\
            try: tachyonc refactor extract-function crate::main --lines 5-7 --to step",
    },
    Explain {
        code: "refactor.collision", severity: "error, exit 1",
        means: "`rename`, `move`, `new-module`, `move-module`: a name the item would take is \
            already a name in that module (renaming a local: in its scope).",
        fix: "Rename one of them first (`refactor rename`), or move to another module.",
        example: "error refactor.collision: 'area' is already a name in crate::shapes (fn crate::shapes::area)\n\
            try: tachyonc query show crate::shapes::area",
    },
    Explain {
        code: "refactor.constructed", severity: "error, exit 1",
        means: "`refactor variant --remove`: the variant is constructed somewhere.",
        fix: "Change those places first (`query refs ENUM::VARIANT` lists them).",
        example: "error refactor.constructed: crate::Shape::Dot is constructed at main.tach:12",
    },
    Explain {
        code: "refactor.discriminant", severity: "warning, exit 0",
        means: "A removed variant renumbers the variants after it, and the enum is cast to an \
            integer somewhere.",
        fix: "Check the casts (`query refs ENUM`), or give the variants explicit values.",
        example: "warning refactor.discriminant: removing crate::Op::Nop renumbers 4 variants; Op is cast",
    },
    Explain {
        code: "refactor.effects", severity: "warning, exit 0",
        means: "`refactor signature`: an argument that calls a function is removed or moved, so \
            its effects are lost or reordered.",
        fix: "Look at the calls named; keep the call's effect in a `let` before the call if needed.",
        example: "warning refactor.effects: an argument removed at main.tach:20 calls a function",
    },
    Explain {
        code: "refactor.escapes", severity: "error, exit 1",
        means: "`extract-function`: a statement of the lines returns, defers, breaks or continues \
            out of them, or has a `?` (0.15: it returns when its operand is None or Err); \
            `inline`: the function returns early, or has a `?`.",
        fix: "Extract fewer lines (the `try:` line gives the ones before it), or restructure the \
            function so that it ends with its value.",
        example: "error refactor.escapes: line 14 returns from crate::run: out of lines 12-16, which NEW cannot do for its caller",
    },
    Explain {
        code: "refactor.exists", severity: "error, exit 1",
        means: "`new-module`, `move-module`: the module (or its file) exists already.",
        fix: "Use the module that is there, or choose another path.",
        example: "error refactor.exists: crate::geom exists already",
    },
    Explain {
        code: "refactor.extern", severity: "error, exit 1",
        means: "`refactor signature` of a C function (`extern \"C\"`): its signature is C's.",
        fix: "Change the C side and its declaration by hand (`edit replace`).",
        example: "error refactor.extern: crate::c::printf is a C function",
    },
    Explain {
        code: "refactor.fill-calls", severity: "note, exit 0",
        means: "`refactor signature FN --add 'x: T = V'` (0.15) declares V as x's default and \
            leaves the calls as they are; but with --fill-calls, for a trait's function (which has \
            no defaults) or before a parameter without one (defaults are on trailing parameters \
            only), every call gets V, as in 0.14: by position, or `x: V` when a parameter before x \
            is left to its default.",
        fix: "Nothing to fix; leave out --fill-calls, or add x after the parameters without a \
            default (--at), to declare a default instead.",
        example: "note refactor.fill-calls: the calls get the value (a trait's function has no defaults)",
    },
    Explain {
        code: "refactor.fits", severity: "note, exit 0",
        means: "`refactor split --plan`: the module has at most N lines already.",
        fix: "Nothing to split.",
        example: "note refactor.fits: crate::geom has 120 lines (at most 1000)",
    },
    Explain {
        code: "refactor.fn-value", severity: "error, exit 1",
        means: "`refactor signature`: the function is used as a value (its type would change).",
        fix: "Change the uses as a value first (`query refs FN`).",
        example: "error refactor.fn-value: crate::cmp is used as a value at main.tach:30",
    },
    Explain {
        code: "refactor.generic", severity: "error, exit 1",
        means: "`extract-function`, `inline`: the function is generic (its body is checked once \
            per instance), or has no body.",
        fix: "Make the change by hand (`edit replace`, `edit patch`).",
        example: "error refactor.generic: crate::max is generic: its body is checked once per instance",
    },
    Explain {
        code: "refactor.if-let", severity: "error, exit 1",
        means: "`refactor variant --remove`: an `if let` or `while let` matches the variant.",
        fix: "Rewrite that `if let` first (`query refs ENUM::VARIANT`).",
        example: "error refactor.if-let: crate::Shape::Dot is matched by an if let at main.tach:40",
    },
    Explain {
        code: "refactor.inline", severity: "error, exit 1",
        means: "The module is an inline `mod m { }`, which has no file to move.",
        fix: "Move its items with `refactor move PATH... --to MODULE` instead.",
        example: "error refactor.inline: crate::util is an inline module",
    },
    Explain {
        code: "refactor.internal", severity: "error, exit 1",
        means: "The refactoring's edits overlap: a case it does not handle. Nothing was written.",
        fix: "Make the change in smaller steps (one item at a time), and report the case.",
        example: "error refactor.internal: the edits overlap (a case the refactoring does not handle); nothing written",
    },
    Explain {
        code: "refactor.kind", severity: "error, exit 1",
        means: "NAME is not of the kind the refactoring changes (`signature`: a function; `field`: \
            a struct; `variant`: an enum).",
        fix: "Check NAME with `query def`.",
        example: "error refactor.kind: crate::geom::P is a struct, not a function\ntry: tachyonc query def P",
    },
    Explain {
        code: "refactor.layout", severity: "warning, exit 0",
        means: "`refactor field` changes the layout of a `#[repr(C)]` struct, which C code may rely on.",
        fix: "Change the C side to match, or leave the struct as it is.",
        example: "warning refactor.layout: crate::Pt is #[repr(C)]: its layout changes",
    },
    Explain {
        code: "refactor.nested", severity: "error, exit 1",
        means: "`refactor variant --remove`: the variant is matched inside another pattern.",
        fix: "Rewrite that match first (`query show FILE:LINE`).",
        example: "error refactor.nested: crate::Shape::Dot is matched inside a pattern at main.tach:44",
    },
    Explain {
        code: "refactor.no-call", severity: "error, exit 1",
        means: "`refactor inline`: the function is not called (or not on the line --at names).",
        fix: "Check the calls with `query callers FN`; give --at a line that calls it.",
        example: "error refactor.no-call: crate::sq is not called on main.tach:12",
    },
    Explain {
        code: "refactor.no-default", severity: "error, exit 2",
        means: "`--add` without a value, and calls or struct literals need one.",
        fix: "Give the value: `--add 'x: i64 = 0'`.",
        example: "error refactor.no-default: calls need a value for 'x'\n\
            try: tachyonc refactor signature f --add 'x: i64 = 0'",
    },
    Explain {
        code: "refactor.no-member", severity: "error, exit 1",
        means: "No such field or variant (the ones there are listed).",
        fix: "Use one of the names listed; `query show` of the type shows them.",
        example: "error refactor.no-member: crate::P has no field 'z' (x, y)",
    },
    Explain {
        code: "refactor.no-module", severity: "error, exit 1",
        means: "The module to move to (or from) does not exist.",
        fix: "Make it first: the `try:` line runs `refactor new-module`.",
        example: "error refactor.no-module: no module crate::geom\ntry: tachyonc refactor new-module crate::geom",
    },
    Explain {
        code: "refactor.no-param", severity: "error, exit 1",
        means: "`refactor signature`: no such parameter (the ones there are listed).",
        fix: "Use one of the names listed; `query def FN` shows the signature.",
        example: "error refactor.no-param: crate::f has no parameter 'z' (a, b)",
    },
    Explain {
        code: "refactor.no-site", severity: "error, exit 1",
        means: "`refactor variant --add --arm-in SITE EXPR` (0.14): SITE (a function, or \
            FILE:LINE) holds no match that needs an arm for the new variant (they are listed).",
        fix: "Name one of the listed matches: the item it is in, or its FILE:LINE.",
        example: "error refactor.no-site: --arm-in describe names no match on crate::Shape that \
            needs an arm; nothing written",
    },
    Explain {
        code: "refactor.non-exhaustive", severity: "error, exit 1",
        means: "`refactor variant --add` without --arm, and matches need an arm for the new \
            variant (they are listed; with --arm-in, the ones none names).",
        fix: "Give the arm's value with `--arm 'EXPR'` (every match), `--arm-in SITE 'EXPR'` \
            per match (SITE: the function it is in, or FILE:LINE; 0.14), or add a `_` arm.",
        example: "error refactor.non-exhaustive: 2 matches on crate::Shape would not cover Ring\n\
            try: tachyonc refactor variant Shape --add 'Ring(i64)' --arm-in area '0' \
            --arm-in name '\"ring\"'",
    },
    Explain {
        code: "refactor.not-movable", severity: "error, exit 1",
        means: "`refactor move` of a method or a field: they move with their type.",
        fix: "Move the type (its impl blocks go with it).",
        example: "error refactor.not-movable: crate::geom::V2::len is a method: move crate::geom::V2",
    },
    Explain {
        code: "refactor.operator", severity: "error, exit 1",
        means: "`refactor signature` of a function an operator calls (`a + b` calls \
            `<T as Add>::add`): the operator's signature is fixed.",
        fix: "Leave it, or replace the operator uses by calls first.",
        example: "error refactor.operator: <crate::V2 as Add>::add is called by an operator at main.tach:9",
    },
    Explain {
        code: "refactor.plan", severity: "note, exit 0",
        means: "`refactor split --plan` printed a plan; the `try:` line makes it in one edit.",
        fix: "Run the `try:` line (--auto), or give the parts with --into and --items.",
        example: "note refactor.plan: the same in one edit: --auto\n\
            try: tachyonc refactor split crate::check --auto --max-lines 1000",
    },
    Explain {
        code: "refactor.range", severity: "error, exit 1",
        means: "`extract-function --lines A-B`: the lines are not inside the function's body, hold \
            no whole statement, or cut a statement.",
        fix: "Give lines of whole statements of the body (`query show FN` prints the lines).",
        example: "error refactor.range: line 13 has code outside the statements of lines 12-14",
    },
    Explain {
        code: "refactor.receiver", severity: "error, exit 1",
        means: "`refactor inline` of a method: the receiver is borrowed and the method uses self \
            other than as self.f or self.m(...).",
        fix: "Bind the receiver to a local first, then inline.",
        example: "error refactor.receiver: the receiver on line 20 is borrowed, and crate::P::norm uses self other than as self.f or self.m(...): bind it to a local first",
    },
    Explain {
        code: "refactor.recursive", severity: "error, exit 1",
        means: "`refactor inline`: the function calls itself.",
        fix: "Inline by hand, or not at all.",
        example: "error refactor.recursive: crate::fact calls itself, on line 5",
    },
    Explain {
        code: "refactor.results", severity: "error, exit 1",
        means: "`extract-function`: the lines set more than one local used after them (or end the \
            block with its value and set one): the new function gives back one value.",
        fix: "Extract fewer lines, or gather the results in a struct first.",
        example: "error refactor.results: lines 12-15 set a, b, used after them; NEW gives back one local it assigns, or the ones it declares",
    },
    Explain {
        code: "refactor.script", severity: "error, exit 1 or 2",
        means: "`refactor --script`: a line is no command, or a command failed; nothing was written.",
        fix: "Fix that line (its number is given) and run the script again.",
        example: "error refactor.script: line 3: unknown command 'renmae'",
    },
    Explain {
        code: "refactor.self", severity: "error, exit 1",
        means: "`extract-function` in a trait impl's function: the lines use self, and the new \
            function cannot be a method of the trait.",
        fix: "Extract lines that do not use self, or move the code to an inherent method first.",
        example: "error refactor.self: lines 8-10 use self in a trait impl's function: NEW cannot be a method there",
    },
    Explain {
        code: "refactor.trait", severity: "error, exit 1",
        means: "`refactor signature` of a trait's function, whose impls' parameters differ.",
        fix: "Make the impls' parameters the same first, or change each by hand.",
        example: "error refactor.trait: the impls of crate::Area::area have other parameters",
    },
    Explain {
        code: "refactor.unchecked", severity: "warning, exit 0",
        means: "Calls in code the checker did not see (a generic function never instantiated) are \
            not changed.",
        fix: "Look at those functions (named) and change their calls by hand.",
        example: "warning refactor.unchecked: calls in 1 unchecked function are not changed: crate::g",
    },
    Explain {
        code: "refactor.usage", severity: "error, exit 2",
        means: "The refactor command line is wrong: an unknown subcommand or option, a missing \
            NAME or value.",
        fix: "Run the corrected command of the `try:` line (docs/refactor-shape.md, refactor-modules.md).",
        example: "error refactor.usage: no command (rename, move, new-module, move-module, split, \
            signature, field, variant, --script)",
    },
    Explain {
        code: "refactor.used", severity: "error, exit 1",
        means: "A parameter or field to remove is used (where is named).",
        fix: "Remove the uses first (`query show FILE:LINE`, `query refs`).",
        example: "error refactor.used: parameter 'b' of crate::f is used at main.tach:5\n\
            try: tachyonc query show main.tach:5",
    },
    Explain {
        code: "rewrite.bad-in", severity: "error, exit 1",
        means: "`rewrite --in` names no file or module of the program.",
        fix: "Give a file's path (or its end) or a module, or drop --in.",
        example: "error rewrite.bad-in: no file or module 'gnv' in the program",
    },
    Explain {
        code: "rewrite.nested", severity: "note, exit 0",
        means: "Sites inside rewritten ones were left as they are.",
        fix: "Run the rewrite again: they are rewritten then.",
        example: "note rewrite.nested: 2 sites inside rewritten ones are left; run it again",
    },
    Explain {
        code: "rewrite.dropped", severity: "note, exit 0",
        means: "Sites match, but the replacement leaves out a hole bound to a name (`for $i in`, \
            `let $x =`) that the code it keeps still uses; they are left as they are.",
        fix: "Rewrite those sites by hand, or keep the hole in the replacement.",
        example: "note rewrite.dropped: 1 site is left: the replacement drops $i, which the code \
            it keeps uses; first: main.tach:12:20\ntry: tachyonc query show main.tach:12",
    },
    Explain {
        code: "rewrite.none", severity: "note, exit 0",
        means: "Nothing matches the pattern.",
        fix: "Check the pattern (`$x` holes, `$xs...` for lists) and --where's types.",
        example: "note rewrite.none: nothing matches 'grow($v, $n)'",
    },
    Explain {
        code: "rewrite.pattern", severity: "error, exit 2",
        means: "The pattern or the replacement does not parse, is a hole alone, or has `$x...` \
            outside a list (arguments, a tuple, an array, a block's statements).",
        fix: "Write an expression or statement with holes (`$v.reserve($n)`).",
        example: "error rewrite.pattern: the pattern is a hole alone: it would match every expression",
    },
    Explain {
        code: "rewrite.types", severity: "note, exit 0",
        means: "Sites match but for --where's types; the type found is given.",
        fix: "Run the `try:` line with the type found, if it is the one meant.",
        example: "note rewrite.types: 3 sites match but $v is *Vec, not *IntVec\n\
            try: tachyonc rewrite 'grow($v, $n)' '$v.reserve($n)' --where '$v: *Vec'",
    },
    Explain {
        code: "rewrite.unbound", severity: "error, exit 2",
        means: "A hole of the replacement is not in the pattern.",
        fix: "Use only the pattern's holes in the replacement.",
        example: "error rewrite.unbound: the replacement's $y is not in the pattern",
    },
    Explain {
        code: "rewrite.untyped", severity: "note, exit 0",
        means: "Sites in code the checker did not see (never instantiated generics) were not \
            matched.",
        fix: "Look at those functions and rewrite them by hand if needed.",
        example: "note rewrite.untyped: 1 unchecked function not searched: crate::g",
    },
    Explain {
        code: "rewrite.usage", severity: "error, exit 2",
        means: "The rewrite command line is wrong: no PATTERN or REPLACEMENT, a bad --where.",
        fix: "`tachyonc rewrite 'PATTERN' 'REPLACEMENT' [--where '$x: TYPE'] [--in X] [--dry-run]`.",
        example: "error rewrite.usage: a PATTERN and a REPLACEMENT are needed",
    },
    Explain {
        code: "tokenizer error", severity: "error (compiler)",
        means: "The text does not lex: an unterminated string or comment, a newline in a string, \
            an unknown character, a bad escape or number.",
        fix: "Fix the text at the position given; nothing after it was read.",
        example: "main.tach:3:17: error[tokenizer error] newline in string literal",
    },
    Explain {
        code: "parser error", severity: "error (compiler)",
        means: "The tokens are not the grammar's (docs/grammar.md): a missing `;` or bracket, a \
            keyword out of place.",
        fix: "Fix the syntax at the position given; the parser goes on after it, so later errors \
            may follow from it.",
        example: "main.tach:4:5: error[parser error] expected ';', got 'let'",
    },
    Explain {
        code: "module error", severity: "error (compiler)",
        means: "The module tree cannot be made: a `mod m;` without m.tach or m/mod.tach, a \
            wildcard import, a module cycle.",
        fix: "Make the file, or fix the `mod`/`use` line (`tachyonc --fix-imports` rewrites \
            wildcards).",
        example: "main.tach:1:5: error[module error] cannot find the file of module 'nothere' | help: \
            looked for ./nothere.tach and ./nothere/mod.tach",
    },
    Explain {
        code: "type error", severity: "error (compiler)",
        means: "The program is not well typed, or names something that is not there or not \
            visible: an undefined name, a private item, a wrong type or argument count.",
        fix: "Read the message and its help; `tachyonc fix` adds the imports and `pub` it can.",
        example: "main.tach:4:5: error[type error] 'secret' is private",
    },
    Explain {
        code: "C import", severity: "error (compiler)",
        means: "`import \"h.h\" as c;`: the header cannot be found or read, or has what the C \
            importer does not take.",
        fix: "Check the header's name and -I directories; declare what is needed in an `extern \
            \"C\" { }` block instead.",
        example: "main.tach:1:8: error[C import] header not found: nothere.h",
    },
    Explain {
        code: "unsafe", severity: "error (compiler)",
        means: "An unsafe operation (a raw pointer's dereference or indexing, a C call, a union \
            field) outside unsafe code.",
        fix: "Put it in an `unsafe { }` block (`tachyonc fix --only unsafe` does), or the function \
            in `unsafe fn`.",
        example: "main.tach:39:13: error[unsafe] dereference of a raw pointer is unsafe | help: put it \
            in an `unsafe { ... }` block",
    },
    Explain {
        code: "effect", severity: "error (compiler)",
        means: "(0.16) A function does more than its effect declaration allows (`#[pure]`, \
            `#[no_alloc]`, `#[no_io]`, `#[no_panic]`, `#[effects(...)]`, or its trait method's), \
            a closure more than its parameter's `effects(...)` bound, or a declaration names an \
            unknown effect or a value instead of an allocator type.",
        fix: "Follow the chain (`tachyonc query effects NAME --why EFFECT`) to the source and \
            remove it, or widen the declaration; effects are alloc(A), io, global, panic, \
            diverge, unsafe.",
        example: "sum.tach:3:1: error[effect] 'total' is #[no_alloc], but it allocates from Gpa: \
            'v.push(x)' at sum.tach:7:9 grows a Vec<i64>",
    },
    Explain {
        code: "profile", severity: "warning (compiler)",
        means: "`--profile-use FILE`: the profile cannot be read, is not a tachyon profile, or is \
            stale for a function; its counts are not used there.",
        fix: "Make the profile again with --profile-generate and a run of the program.",
        example: "main.tach:1:1: warning[profile] cannot read the profile: no counts used",
    },
    Explain {
        code: "format", severity: "warning (compiler)",
        means: "(0.15) A plain string literal passed to print, println, eprint, eprintln or \
            format has `{name}` in it, name a local: it prints the braces, not the value; only \
            an f-string, `f\"...\"`, has holes.",
        fix: "Write the f-string the help gives (`println(f\"x = {x}\")`), or double the braces \
            for text: `\"{{x}}\"` in an f-string.",
        example: "main.tach:3:13: warning[format] this string has '{x}' in it, as text: it is \
            not an f-string | help: an f-string writes the local's value: 'println(f\"x = \
            {x}\")'",
    },
];
