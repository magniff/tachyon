// The `explain` entries of 0.18's codes (docs/design/contracts-verification.md
// §2.14) that phase 0 prints (tools/v018.vl) or names with a prefix
// tests/refactor/run.sh looks for (`test.`, `contract.`, `distinct.`, in
// front/contracts/diag.vl).
// Each task adds the entries of the other codes as it starts reporting
// them: run.sh wants every entry to be a code of the source.

use crate::tools::explain::Explain;

pub const V018_COUNT: i64 = 15;

pub static V018_TABLE: [Explain; 15] = [
    Explain {
        code: "contract.effect", severity: "error",
        means: "(0.18) A `requires`, `ensures` or `invariant` condition does io, allocates or touches a static: a check that passes must not change what the program does, and `debug` clauses are switched on and off.",
        fix: "Compute the value in the body (or check it there with `assert`); the condition reads parameters, `result`, `old(..)` and calls pure functions. The try: line shows why the call has the effect.",
        example: "error[contract.effect] the 'requires' of 'push' calls 'log', which does io: a condition may not do io, allocate or touch statics",
    },
    Explain {
        code: "contract.impl-requires", severity: "error",
        means: "(0.18) An impl's method adds a `requires` to a trait's method: callers through the trait would not check it.",
        fix: "Move the requires to the trait's method, or make it an `assert` in the body.",
        example: "error[contract.impl-requires] 'Shape::area' of 'impl Shape for Circle' adds a requires",
    },
    Explain {
        code: "contract.old", severity: "error",
        means: "(0.18) An `ensures` runs after the body: `old(e)` must not keep a view (it would see what the body changes), and a by-value parameter of an owned type is gone by then (the body took it, 0.17).",
        fix: "Take a plain part at entry (`old(self.len())`), or a copy (`old(v.clone())`); or take the parameter by reference.",
        example: "error[contract.old] 'old(self.items.as_slice())' keeps a view: the ensures of 'pop' runs after the body, which may change what it views",
    },
    Explain {
        code: "contract.result", severity: "error",
        means: "(0.18) `result`, the returned value, is used in a `requires` (the function has not returned yet) or in an `ensures` of a function that returns nothing.",
        fix: "State the requires on the parameters, or move the condition to an `ensures` of a function that returns a value.",
        example: "error[contract.result] 'result' is the returned value, which a 'requires' does not see",
    },
    Explain {
        code: "contract.sealed", severity: "error",
        means: "(0.18) A field of a type with an `invariant` is written, or a literal of it made, outside its module: only the module's functions keep the invariant.",
        fix: "Call the type's methods (`volec query items MODULE`).",
        example: "error[contract.sealed] 's.max = 3' writes a field of 'Stack', which has an invariant",
    },
    Explain {
        code: "contract.violated", severity: "error",
        means: "(0.18) A `requires` is false for the constant arguments of a call (or a literal is outside a distinct type's invariant): the program would fail there every time.",
        fix: "Change the argument, or the clause.",
        example: "error[contract.violated] 'get(-1)' violates 'requires 0 <= i' of 'get' (stack.vl:4:14)",
    },
    Explain {
        code: "distinct.kind", severity: "error",
        means: "(0.18) `type X = distinct T` makes a new type with T's representation, copied freely as T is; T must be plain: numbers, bool, raw pointers, fn types, and structs, enums, tuples and arrays of them. An owned type (Vec, Buf, HashMap, or one holding them) or a view (a slice) is refused.",
        fix: "Declare a struct of one field instead: `struct Ids { v: Vec<i64> }`, with the methods it needs.",
        example: "error[distinct.kind] a distinct type is over a plain type: 'Vec<i64>' owns memory",
    },
    Explain {
        code: "distinct.method", severity: "error",
        means: "(0.18) A distinct type has none of its underlying type's methods (Go's defined types): only those of its own `impl X { .. }`, and the traits Eq, Ord, Hash, Debug, Display and Clone, which it takes from the underlying type.",
        fix: "Convert to call the underlying type's method, `(x as T).m(..)` (the conversion is free; `volec fix --suggested` writes it), or add the method to `impl X`.",
        example: "error[distinct.method] 'area' is a method of 'Rect', not of 'Tile' | try: (t as Rect).area(..)",
    },
    Explain {
        code: "distinct.mix", severity: "error",
        means: "(0.18) A distinct type and its underlying type (or another distinct type) do not mix: an operator takes two values of the same distinct type, or one and a literal, and a value of one where the other goes needs `as`. Literals are the one implicit conversion.",
        fix: "Convert with `as`, which is free: `d + x as Meters`, `id as i64`, `n as NodeId` (`volec fix --suggested` makes every such conversion).",
        example: "error[distinct.mix] 'd + x' mixes 'Meters' and 'f64' | try: d + x as Meters",
    },
    Explain {
        code: "fuzz.unknown", severity: "error, exit 2",
        means: "(0.18) `volec fuzz NAME`: the program has no #[fuzz] or #[property] function NAME. The message lists the ones it has.",
        fix: "Run the try: line (the first target), or name one of the list.",
        example: "error fuzz.unknown: no #[fuzz] or #[property] function 'nope' in main.vl; its targets: parse_never_crashes | try: volec fuzz parse_never_crashes main.vl",
    },
    Explain {
        code: "fuzz.usage", severity: "error, exit 2",
        means: "(0.18) `volec fuzz` was given an unknown option, no target, or a bad --time.",
        fix: "volec fuzz NAME [ROOT.vl] [--time S]: NAME a #[fuzz] function, S seconds (10 by default).",
        example: "error fuzz.usage: the #[fuzz] function to fuzz is needed; usage: volec fuzz NAME [ROOT.vl] [--time S]",
    },
    Explain {
        code: "import.wildcard", severity: "error",
        means: "(0.18) `use super::*;`, Rust's habit in a test module: wildcard imports are not allowed, and a `#[cfg(test)]` module sees its parent's items (private ones too) without an import.",
        fix: "Delete the line (the try: line does): the names resolve through the parent.",
        example: "error[import.wildcard] wildcard imports are not allowed: 'use super::*;' is not needed | help: a #[cfg(test)] module sees its parent's items, private ones too, without an import | try: volec edit patch main.vl:10 --old 'use super::*;' --new '' main.vl",
    },
    Explain {
        code: "test.generate", severity: "error",
        means: "(0.18) A `#[property]` parameter has a type with no generator (a raw pointer, a fn value, a view).",
        fix: "Take an owned value, or write `impl Arbitrary for T`.",
        example: "error[test.generate] no generator for '*u8' (raw pointer)",
    },
    Explain {
        code: "test.not-yet", severity: "error, exit 2",
        means: "(0.18) An option of `volec test` that is named but not implemented yet: --fuzz S (fuzz each target S seconds) and --gen (inputs from a generator, with --against).",
        fix: "Leave the option out: `volec fuzz NAME --time S` fuzzes one target.",
        example: "error test.not-yet: '--fuzz' is not implemented yet",
    },
    Explain {
        code: "test.signature", severity: "error",
        means: "(0.18) A `#[test]` function takes nothing or `gpa: Gpa`, and returns `()` or a Result.",
        fix: "For generated arguments make it a `#[property]`.",
        example: "error[test.signature] '#[test] fn parses(s: [u8])' takes 's': a test takes nothing or 'gpa: Gpa'",
    },
];
