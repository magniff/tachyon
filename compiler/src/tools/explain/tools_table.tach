// The explanations of the diagnostic codes of query, edit, patch, undo,
// check, fix, lint, fmt, same-output and explain (`tachyonc explain
// CODE`, 0.13): what each means, how to fix it, an example. The codes
// of the refactorings, rewrite and the compiler are in refactor_table.

use crate::tools::explain::Explain;

pub const TOOLS_COUNT: i64 = 82;

pub static TOOLS_TABLE: [Explain; 82] = [
    Explain {
        code: "query.alias", severity: "note, exit 0",
        means: "NAME is the other name an import gives (`use a::f as g;`), not a definition: the \
            answer is about what it imports.",
        fix: "Nothing to fix; ask by the imported definition's own path to go without the note.",
        example: "note query.alias: 'area' is an import alias in crate, for crate::shapes::area_of",
    },
    Explain {
        code: "query.ambiguous", severity: "error, exit 1",
        means: "NAME matches more than 5 definitions (`show`), or several where an edit needs one; \
            their paths are listed.",
        fix: "Give more of the path (`Type::method`, `module::name`) or the full path printed.",
        example: "error query.ambiguous: 20 definitions match '.name'; showing paths only\n\
            try: tachyonc query show crate::back::objfile::ASym.name",
    },
    Explain {
        code: "query.bad-in", severity: "error, exit 1",
        means: "`--in` names no file or module of the program (or FILE:LINE is between items).",
        fix: "Give a file's path (or its end, `gvn.tach`), a module (`crate::middle::gvn`), or \
            drop --in.",
        example: "error query.bad-in: no file or module 'gnv.tach' in the program\n\
            try: tachyonc query refs run_gvn",
    },
    Explain {
        code: "query.bad-root", severity: "error, exit 2",
        means: "The root given (--root, or a last argument ending in .tach) cannot be read.",
        fix: "Give the program's root file, or leave it out to use the default root.",
        example: "error query.bad-root: cannot read 'mian.tach'",
    },
    Explain {
        code: "query.budget", severity: "note, exit 0",
        means: "The answer was over its budget (`--budget TOKENS`; 8000 tokens by default, 2000 for \
            `query context`) and was cut at a line; the note says how much was left out (0.15).",
        fix: "Run a `try:` line: the same command with the budget it needs, or the narrower query \
            (`show`, `callers`) for the part left out; `--budget 0` prints everything.",
        example: "note query.budget: cut at about 40 tokens: 4 of 8 lines (about 53 tokens in all)\n\
            try: tachyonc query show report --budget 100",
    },
    Explain {
        code: "query.derived", severity: "note, exit 1",
        means: "The NAME (`Type::m`) is a method that `#[derive(...)]` makes for the struct or enum \
            (0.15: Eq's eq, Ord's cmp, Hash's hash, Debug's fmt_debug, Clone's clone): it has no \
            source of its own; the note gives the position of the trait in the attribute.",
        fix: "Read the type (the `try:` line); the guide's formatting topic says what each derive \
            makes. To change it, write the impl by hand and take the trait out of the derive.",
        example: "note query.derived: 'P::cmp' is derived, at main.tach:6:14: #[derive] makes it; it has no source of its own\ntry: tachyonc query show crate::P",
    },
    Explain {
        code: "query.empty", severity: "note, exit 0",
        means: "The answer is empty: no references (after --in), or a module without `use` lines, \
            header comment or extern blocks.",
        fix: "Nothing to fix; widen --in, or check NAME with `query def`.",
        example: "note query.empty: 0 refs",
    },
    Explain {
        code: "query.module", severity: "note, exit 0",
        means: "NAME is the root module (`crate`) or `std`, which have no `mod` item to show: \
            their items are listed instead (0.15).",
        fix: "Nothing to fix; `query items crate` lists them without the note.",
        example: "note query.module: 'crate' is a module without a `mod` item (the root, or std); its items:",
    },
    Explain {
        code: "query.no-file", severity: "error, exit 1",
        means: "`query text FILE` or `query show FILE.tach`: the file cannot be read.",
        fix: "Check the path (relative to the current directory).",
        example: "error query.no-file: cannot read 'tests/run/nope.tach'",
    },
    Explain {
        code: "query.no-match", severity: "error, exit 1",
        means: "No definition answers to NAME (no module, for `items`; no item at FILE:LINE): a \
            typo, or a field asked without its dot (`Inst.op`, `.op`).",
        fix: "Run a `try:` line: the definitions nearest to NAME, or the items of its module.",
        example: "$ tachyonc query def run_gnv\nerror query.no-match: no definition 'run_gnv'\n\
            try: tachyonc query def crate::middle::gvn::run_gvn",
    },
    Explain {
        code: "query.no-root", severity: "error, exit 2",
        means: "No program to read: no ROOT given, no $TACHYON_ROOT, no ./main.tach and no \
            ./compiler/src/main.tach.",
        fix: "Give the root: `--root path/to/main.tach`, or a last argument ending in .tach.",
        example: "error query.no-root: no root (TACHYON_ROOT, ./main.tach, ./compiler/src/main.tach)\n\
            try: tachyonc query def main path/to/main.tach",
    },
    Explain {
        code: "query.over", severity: "note, exit 0",
        means: "`query stats`: files over --over lines (1000 by default).",
        fix: "Split the largest: the `try:` line gives its `query deps` for a plan.",
        example: "note query.over: 2 files over 1000 lines\n\
            try: tachyonc query deps crate::front::check --max-lines 1000",
    },
    Explain {
        code: "query.program-errors", severity: "warning (error when nothing parsed)",
        means: "The program has errors; the answer comes from what the front end got and may be \
            incomplete.",
        fix: "Run the compilation of the `try:` line to see the errors, one per line.",
        example: "warning query.program-errors: 4 errors in the program; results may be incomplete\n\
            try: tachyonc --diagnostics=short main.tach -c -o /dev/null",
    },
    Explain {
        code: "query.too-long", severity: "error, exit 1",
        means: "`query show FILE.tach` of a file of more than 200 lines.",
        fix: "Show items by name, or lines by range with `query text FILE:A-B`.",
        example: "error query.too-long: compiler/src/main.tach has 459 lines (show prints a file of at \
            most 200)\ntry: tachyonc query text compiler/src/main.tach:1-200",
    },
    Explain {
        code: "query.truncated", severity: "note, exit 0",
        means: "The answer was cut: more than 60 references (a count per file is printed), \
            --limit, or `query text` past 200 lines.",
        fix: "Narrow with `--in FILE|MODULE`, or ask for more (`--limit N`, `--all`, the next \
            range).",
        example: "note query.truncated: 645 refs in 44 files\n\
            try: tachyonc query refs IntVec::push --in compiler/src/middle/vectorize.tach",
    },
    Explain {
        code: "query.usage", severity: "error, exit 2",
        means: "The query command line is wrong: no or an unknown command or option, a missing \
            NAME or value, an extra argument.",
        fix: "Run the corrected command of the `try:` line; `tachyonc query --help` lists them.",
        example: "error query.usage: unknown command 'deff'\ntry: tachyonc query def main",
    },
    Explain {
        code: "patch.ambiguous", severity: "error, exit 1",
        means: "`edit patch`: an OLD (or an ANCHOR) occurs several times in TARGET; their lines \
            are listed.",
        fix: "Give more of the text around it: each `try:` line widens OLD and NEW until unique; \
            or `--nth N` patches the Nth (`--all`: every one, 0.16).",
        example: "error patch.ambiguous: OLD 1 occurs 2 times in crate::calc::clamp, lines 6, 9\n\
            try: tachyonc edit patch clamp --old 'return lo;' --new 'return 0 + lo;'",
    },
    Explain {
        code: "patch.nth", severity: "error, exit 1",
        means: "`edit patch --nth N` (`edit insert --nth N`, 0.16): OLD (the ANCHOR) occurs fewer \
            than N times in TARGET.",
        fix: "Count again from 1 among the lines patch.ambiguous lists, or give more of the text \
            around OLD; `--all` patches every occurrence.",
        example: "error patch.nth: OLD 1 occurs 3 times in crate::calc::clamp; --nth 4 is past the last",
    },
    Explain {
        code: "patch.format", severity: "error, exit 2",
        means: "The pairs on stdin are not blocks of `            lines.",
        fix: "Write each pair as a block: the markers alone on their lines, OLD and NEW between.",
        example: "error patch.format: stdin line 1: text outside a block; pairs are blocks of lines: \
            <<<<<<< OLD, the old lines, =======, the new lines, >>>>>>> NEW",
    },
    Explain {
        code: "patch.no-match", severity: "error, exit 1",
        means: "`edit patch`: an OLD (or ANCHOR) is not in TARGET's text; the nearest line is \
            named.",
        fix: "Copy OLD from the nearest line (the `try:` line), or add --loose for other blanks.",
        example: "error patch.no-match: OLD 1 is not in crate::calc::clamp; nearest, line 5: if v < lo {\n\
            try: tachyonc edit patch clamp --old 'v < lo' --new 'v <= lo'",
    },
    Explain {
        code: "patch.no-region", severity: "error, exit 1",
        means: "`edit patch MODULE::use` or `MODULE::header`, and the module has none.",
        fix: "Add them with `edit replace MODULE::use < uses.tach` (or `::header`).",
        example: "error patch.no-region: no use lines in crate::tools; edit replace adds them\n\
            try: tachyonc edit replace crate::tools::use < uses.tach",
    },
    Explain {
        code: "patch.overlap", severity: "error, exit 1",
        means: "Two OLDs of one `edit patch` overlap in TARGET's text.",
        fix: "Merge them into one pair, or make them disjoint.",
        example: "error patch.overlap: OLD 1 and OLD 2 overlap",
    },
    Explain {
        code: "edit.format", severity: "error, exit 2",
        means: "`edit apply` (0.15): the blocks' file is not blocks: text before the first header, \
            a header naming nothing, a block without text (or a delete block with text).",
        fix: "Start each block with a header: `@@ NAME` (replace), `@@ new after NAME`, `@@ new \
            before NAME`, `@@ new in MODULE`, `@@ delete NAME`, or a header line of `query show` \
            (`// PATH<TAB>FILE:A-B`).",
        example: "error edit.format: items.tach line 1: text before the first header; a block starts with `@@ NAME`, ...",
    },
    Explain {
        code: "edit.no-module", severity: "error, exit 1",
        means: "`edit apply` (0.15): a block adds a new item to a module (`@@ new in MODULE`, or \
            a new path) that has no file of its own (or no such module).",
        fix: "Name an item to put it after (`@@ new after NAME`), or make the module first \
            (`refactor new-module`).",
        example: "error edit.no-module: no module 'shapez' with a file of its own; name an item to put the text after (`@@ new after NAME`)",
    },
    Explain {
        code: "edit.breaks", severity: "error, exit 1 (warning with --dry-run or --no-check)",
        means: "The edited program has errors the program had not; they are printed, each \
            tagged with the item it is in (`[edited: PATH]` for text the edit changed, `[in \
            PATH]` for an item it does not change; 0.15), and nothing is written.",
        fix: "Errors in the edited text: change the edit. Errors in other items: change them in \
            the same edit (`edit apply`, or `edit patch` with `@@ NAME` blocks), or run the \
            refactoring the `note edit.refactor` names first. --no-check writes it anyway \
            (`tachyonc check` lists what is left).",
        example: "main.tach:13:25: error[type error] expected 'i64', got 'bool'  [in crate::total]\n\
            error edit.breaks: 1 new error (1 in crate::total, which the edit does not change); nothing written\n\
            note edit.together: change crate::total in the same edit: ...\ntry: tachyonc query show crate::total",
    },
    Explain {
        code: "edit.exists", severity: "error, exit 1",
        means: "A file the edit makes exists already.",
        fix: "Choose another name or path, or remove the file first.",
        example: "error edit.exists: 'geom/shapes.tach' exists already",
    },
    Explain {
        code: "edit.imports", severity: "note, exit 0",
        means: "`edit replace`, `insert` or `patch` (0.14): the new text used names of other \
            modules that its file does not import; the edit adds their `use` lines, as `fix \
            --only imports` does, and is checked with them.",
        fix: "Nothing to do; `--show` or `query diff` shows the lines added.",
        example: "note edit.imports: added the imports the new text needs (fix --only imports)",
    },
    Explain {
        code: "edit.overlap", severity: "error, exit 1",
        means: "`edit apply` (0.15): two blocks change one item (or one inside the other).",
        fix: "Give each item one block, with all of its new text.",
        example: "error edit.overlap: crate::shapes::area is changed twice in one edit; give each item one block",
    },
    Explain {
        code: "edit.refactor", severity: "note (with edit.breaks)",
        means: "The edit changed an item's shape (a function's name or parameters, a struct's \
            fields, an enum's variants) and its uses no longer fit (0.15): the `try:` lines \
            after it are the refactorings that change the uses with it, computed from the old \
            and the new text.",
        fix: "Run the refactoring (fill in VALUE, the argument each call gets, or EXPR), then \
            the rest of the edit; or change the uses in the same edit (`edit apply`).",
        example: "note edit.refactor: the uses of crate::shapes::scale no longer fit its new shape: ...\n\
            try: tachyonc refactor signature crate::shapes::scale --add 'm: i64 = VALUE'",
    },
    Explain {
        code: "edit.together", severity: "note (with edit.breaks)",
        means: "Items the edit does not change have new errors (0.15); their text is the `try:` \
            line's `query show`.",
        fix: "Change them in the same edit: `edit apply FILE` with a block per item (the edited \
            ones and these), or `edit patch --pairs FILE` with `@@ NAME` blocks.",
        example: "note edit.together: change crate::main in the same edit: ...\ntry: tachyonc query show crate::main",
    },
    Explain {
        code: "edit.journal", severity: "warning, exit 0",
        means: "The edit was written, but the journal (.git/tachyon-edits) could not be: `undo` \
            will not know it.",
        fix: "Check that the git directory is writable; `git diff` still shows the change.",
        example: "warning edit.journal: cannot write the journal in .git/tachyon-edits; undo will not know this edit",
    },
    Explain {
        code: "edit.layout", severity: "error, exit 1",
        means: "An insertion next to an item that shares its line with other code (a field of a \
            one-line struct), or a header next to a header.",
        fix: "Replace the enclosing item instead (`edit replace`), or `edit replace MODULE::header`.",
        example: "error edit.layout: crate::P.x shares its line with other code; insert needs an item on lines of its own",
    },
    Explain {
        code: "edit.no-parent", severity: "error, exit 1",
        means: "`edit new-file PATH`: no file of the program would hold PATH as a child module's \
            file (a mod.tach or the root next to it, or the file its directory is named after).",
        fix: "Make the parent module first (`refactor new-module`), or choose a path next to a \
            file of the program; `query items` lists the modules and their files.",
        example: "error edit.no-parent: no file of the program has geom/shapes.tach as a child's file \
            (a mod.tach or the root next to it, or the file its directory is named after)\n\
            try: tachyonc query items",
    },
    Explain {
        code: "edit.no-text", severity: "error, exit 2",
        means: "`edit replace` or `insert` without TEXT on stdin; `edit patch` without pairs.",
        fix: "Give the text on stdin (`< new.tach`), or --old OLD --new NEW.",
        example: "error edit.no-text: the new text is read from stdin; none was given\n\
            try: tachyonc edit replace clamp < new.tach",
    },
    Explain {
        code: "edit.not-source", severity: "error, exit 1",
        means: "NAME is the standard library's or a C header's, not the program's own source.",
        fix: "Edit the program's own items; std is compiler/std/std.tach (then embed.sh).",
        example: "error edit.not-source: std::Vec::push is in <std>, not in a file of the program",
    },
    Explain {
        code: "edit.unchanged", severity: "note, exit 0",
        means: "The edit changes nothing (the text is already so).",
        fix: "Nothing to fix.",
        example: "note edit.unchanged: nothing to change",
    },
    Explain {
        code: "edit.unchecked", severity: "warning",
        means: "The edited program could not be checked (`tachyonc check` did not run).",
        fix: "Run `tachyonc check` yourself; the edit was made without the check.",
        example: "warning edit.unchecked: the edited program could not be checked (tachyonc check did not run)",
    },
    Explain {
        code: "edit.usage", severity: "error, exit 2",
        means: "The edit command line is wrong: an unknown subcommand or option, a missing NAME.",
        fix: "Run the corrected command of the `try:` line (docs/refactor.md).",
        example: "error edit.usage: no command (patch, replace, insert, delete)\n\
            try: tachyonc edit replace NAME < new.tach",
    },
    Explain {
        code: "edit.wrap", severity: "error, exit 1",
        means: "`edit wrap`: TARGET is not a function with a body, the lines given are not all in \
            it, or they are blank.",
        fix: "Name a function, or give --lines A-B inside it (`query show TARGET` prints its lines).",
        example: "error edit.wrap: lines 3-40 are not all in crate::area (lines 10-18)\n\
            try: tachyonc query show crate::area",
    },
    Explain {
        code: "edit.write", severity: "error, exit 1",
        means: "A file of the edit cannot be written.",
        fix: "Check the permissions of the file and its directory; nothing else was written.",
        example: "error edit.write: cannot write 'main.tach'",
    },
    Explain {
        code: "undo.changed", severity: "error, exit 1",
        means: "A file of the last edit changed since: undoing would lose that change.",
        fix: "Look at `tachyonc query diff`; `undo --force` restores the file anyway.",
        example: "error undo.changed: main.tach changed since the edit\ntry: tachyonc undo --force",
    },
    Explain {
        code: "undo.empty", severity: "error, exit 1",
        means: "No edit to undo (or to show with `query diff`): the journal is empty.",
        fix: "Nothing to undo; `git diff` shows changes made otherwise.",
        example: "error undo.empty: no edit to undo",
    },
    Explain {
        code: "check.usage", severity: "error, exit 2",
        means: "The check command line is wrong: an unknown option or an extra argument.",
        fix: "`tachyonc check [ROOT]`.",
        example: "error check.usage: unknown option '--all'",
    },
    Explain {
        code: "fix.ambiguous", severity: "error, exit 1",
        means: "`fix --only imports` (0.16): a name the module uses is public in several modules, \
            and more than one of them is nearest (the innermost module holding both, then the \
            fewest path segments; std is farther than any of the program's): nothing is imported \
            for it. The other fixes are made.",
        fix: "Run the `try:` line of the module you mean: `--use PATH::NAME` imports NAME from \
            there (repeat --use for several names).",
        example: "error fix.ambiguous: crate::back uses 'is_blank', which 2 modules as near have: \
            crate::back::asm, crate::back::obj; nothing is imported for it: name one with --use\n\
            try: tachyonc fix --only imports --use crate::back::asm::is_blank",
    },
    Explain {
        code: "fix.bad-in", severity: "error, exit 1",
        means: "`fix --in` names no file or module of the program.",
        fix: "Give a file's path (or its end) or a module, or drop --in.",
        example: "error fix.bad-in: no file or module 'gnv' in the program",
    },
    Explain {
        code: "fix.none", severity: "note, exit 0",
        means: "Nothing to fix: no missing or unused imports, no `pub` or `unsafe` to add.",
        fix: "Nothing to fix.",
        example: "note fix.none: nothing to fix",
    },
    Explain {
        code: "fix.usage", severity: "error, exit 2",
        means: "The fix command line is wrong: an unknown option, an --only kind that is not one.",
        fix: "--only takes imports, unused, pub, unsafe, tidy-imports, reexports, std015 (0.15: \
            0.14's std calls moved to the Result API).",
        example: "error fix.usage: --only takes imports, unused, pub, unsafe, tidy-imports, reexports or std015, not 'import'",
    },
    Explain {
        code: "lint.max-lines", severity: "error, exit 1",
        means: "A file has more lines than --max-lines allows (a generated file, one starting `// Generated by`, is not counted).",
        fix: "Split its module: `query deps MODULE --max-lines N` plans it, `refactor split` makes it.",
        example: "error lint.max-lines: compiler/src/front/check.tach: 4785 lines (at most 1000)\n\
            try: tachyonc query deps crate::check --max-lines 1000",
    },
    Explain {
        code: "lint.usage", severity: "error, exit 2",
        means: "The lint command line is wrong: no --max-lines N, an unknown option.",
        fix: "`tachyonc lint --max-lines N [ROOT]`.",
        example: "error lint.usage: lint needs --max-lines N\ntry: tachyonc lint --max-lines 1000",
    },
    Explain {
        code: "fmt.bad-in", severity: "error, exit 1",
        means: "`fmt MODULE`: no module (or file) of the program has that name.",
        fix: "Give a module path (`crate::middle::gvn`), or a FILE or DIR.",
        example: "error fmt.bad-in: no file or module 'gnv' in the program\ntry: tachyonc fmt",
    },
    Explain {
        code: "fmt.no-file", severity: "error, exit 1",
        means: "A FILE or DIR given to fmt is not there, or has no .tach file.",
        fix: "Check the path (relative to the current directory).",
        example: "error fmt.no-file: no .tach file at 'test/run'",
    },
    Explain {
        code: "fmt.none", severity: "note, exit 0",
        means: "Every file is formatted already: nothing was written.",
        fix: "Nothing to fix.",
        example: "note fmt.none: 178 files formatted already",
    },
    Explain {
        code: "fmt.skipped", severity: "note, exit 0",
        means: "Files left as they are: they do not lex, or their brackets do not balance (the \
            first is named).",
        fix: "Fix the file so that it lexes and its brackets balance (`tachyonc check`), then fmt \
            it again; test cases of errors stay as they are.",
        example: "note fmt.skipped: 10 files left as they are (not lexed, or unbalanced brackets); first: \
            tests/query/broken/main.tach:19: unbalanced brackets",
    },
    Explain {
        code: "fmt.unformatted", severity: "error, exit 1",
        means: "`fmt --check`: the files listed (one per line, on stdout) are not formatted.",
        fix: "Run fmt on them (the `try:` line); --dry-run shows the change first.",
        example: "compiler/src/x.tach\nerror fmt.unformatted: 1 of 178 files is not formatted\n\
            try: tachyonc fmt --dry-run compiler/src/x.tach",
    },
    Explain {
        code: "fmt.unreadable", severity: "error, exit 1",
        means: "The one file given does not lex or its brackets do not balance (or formatting it \
            would change its tokens, a bug of fmt): it is left as it is.",
        fix: "Fix the error at the line named, then fmt it again.",
        example: "error fmt.unreadable: main.tach:3: newline in string literal; left as it is",
    },
    Explain {
        code: "fmt.usage", severity: "error, exit 2",
        means: "The fmt command line is wrong: an unknown option, several MODULEs, FILEs with a \
            MODULE.",
        fix: "`tachyonc fmt [FILE|DIR...|MODULE|--all] [--check] [--dry-run]`.",
        example: "error fmt.usage: unknown option '--width'\ntry: tachyonc fmt --check --all",
    },
    Explain {
        code: "same-output.differs", severity: "error, exit 1",
        means: "Compilations by OLD and by this compiler differ: the change is not a pure \
            refactoring. The first differing lines are shown; the outputs are kept.",
        fix: "Run the `try:` lines (the diff, the compilation) to find the change of behaviour.",
        example: "error same-output.differs: 3 of 81 compilations differ (kept in target/same-output)\n\
            try: diff target/same-output/64/old/out.s target/same-output/64/new/out.s",
    },
    Explain {
        code: "same-output.no-compiler", severity: "error, exit 2",
        means: "OLD (the compiler to compare with) cannot be run.",
        fix: "Give the path of a tachyonc binary, e.g. one built before the change.",
        example: "error same-output.no-compiler: cannot run 'target/old'",
    },
    Explain {
        code: "same-output.no-corpus", severity: "error, exit 2",
        means: "No programs to compile: the default corpus is not under the current directory, or \
            the --corpus entries have none.",
        fix: "Run it from the tree's root, or give --corpus DIR|FILE.",
        example: "error same-output.no-corpus: no programs",
    },
    Explain {
        code: "same-output.not-run", severity: "warning",
        means: "Some compilations could not be run (a worker failed).",
        fix: "Run again with fewer jobs (-j); check the disk space of --work.",
        example: "warning same-output.not-run: 2 compilations could not be run",
    },
    Explain {
        code: "same-output.target", severity: "note",
        means: "OLD has no such target: its compilations are skipped.",
        fix: "Nothing to fix; compare on the targets both have.",
        example: "note same-output.target: OLD has no target aarch64-linux",
    },
    Explain {
        code: "same-output.usage", severity: "error, exit 2",
        means: "The same-output command line is wrong: no OLD, an unknown option.",
        fix: "`tachyonc same-output OLD [--corpus DIR|FILE]... [-j N] [--work DIR]`.",
        example: "error same-output.usage: same-output needs the OLD compiler to compare with\n\
            try: tachyonc same-output path/to/old/tachyonc",
    },
    Explain {
        code: "same-output.work", severity: "error, exit 2",
        means: "The work directory (--work, target/same-output) cannot be made.",
        fix: "Give a writable --work DIR.",
        example: "error same-output.work: cannot make 'target/same-output'",
    },
    Explain {
        code: "batch.usage", severity: "error, exit 2 (a command's: in its output, `## exit 2`)",
        means: "`tachyonc batch` (0.15): an unknown option, more than one FILE, no commands \
            (no FILE and nothing piped in), a FILE or a command's `< PATH` that cannot be read, \
            or a line whose first word is not a tool command (query, edit, undo, check, fix, \
            fmt, refactor, rewrite, explain, guide, lint).",
        fix: "`tachyonc batch [FILE] [--root R] [--stop]`, one command per line as typed after \
            `tachyonc`; compile with `tachyonc FILE.tach`, outside a batch.",
        example: "error batch.usage: 'build' is not a command batch runs (query, edit, undo, check, \
            fix, fmt, refactor, rewrite, explain, guide, lint)",
    },
    Explain {
        code: "batch.format", severity: "error, exit 2",
        means: "A line of the batch's commands cannot be read: a quote is not closed, `<<WORD` \
            has no line WORD after it, or `< PATH` has no command; nothing is run.",
        fix: "Close the quote (words are quoted as in sh), end the text with a line WORD alone.",
        example: "error batch.format: stdin:2: a quote is not closed; nothing run",
    },
    Explain {
        code: "explain.guide", severity: "note, exit 0",
        means: "The words given are no code (`explain type`, a compiler's message): the guide's \
            paragraphs about them follow, as `guide --find WORDS` prints them (0.15).",
        fix: "Nothing to fix; `tachyonc guide --find WORDS --budget N` for more of them.",
        example: "note explain.guide: 'closure capture' is no code: the guide's paragraphs about it",
    },
    Explain {
        code: "explain.unknown", severity: "error, exit 1",
        means: "`tachyonc explain CODE`: no diagnostic has that code, and the guide has no paragraph \
            about the words.",
        fix: "Run a `try:` line (the nearest codes), or `tachyonc explain` for the list.",
        example: "error explain.unknown: no code 'query.nomatch'\ntry: tachyonc explain query.no-match",
    },
    Explain {
        code: "explain.usage", severity: "error, exit 2",
        means: "The explain command line is wrong: an option other than --list.",
        fix: "`tachyonc explain CODE`, or `tachyonc explain` for every code.",
        example: "error explain.usage: no options but --list\ntry: tachyonc explain query.no-match",
    },
    Explain {
        code: "guide.budget", severity: "note, exit 0",
        means: "`guide --budget N` (or `--find`, 1000 tokens by default): the text was over the \
            budget and was cut at a line, or paragraphs were left out (0.15).",
        fix: "Run the `try:` line: the same command with the budget it needs; or ask for one \
            section, `guide TOPIC#SECTION`.",
        example: "note guide.budget: cut at about 200 tokens (about 7089 in all)\n\
            try: tachyonc guide core --budget 7100",
    },
    Explain {
        code: "guide.no-match", severity: "error, exit 1",
        means: "`guide --find WORDS`: no paragraph of the guide holds most of the words (0.15).",
        fix: "Fewer or other words (a name, `read_line`; a message's words); `guide --list` for \
            the topics.",
        example: "error guide.no-match: no paragraph about 'xyzzy frob'\ntry: tachyonc guide --list",
    },
    Explain {
        code: "guide.no-section", severity: "error, exit 1",
        means: "`guide TOPIC#SECTION`: the topic has no section whose name is or starts with \
            SECTION (0.15).",
        fix: "Run a `try:` line, a section of the topic; `guide TOPIC#` lists them all.",
        example: "error guide.no-section: no section 'loops' in tools\ntry: tachyonc guide tools#the-loop",
    },
    Explain {
        code: "guide.no-topic", severity: "error, exit 1",
        means: "`guide TOPIC`: there is no such topic (the others asked are printed).",
        fix: "`tachyonc guide --list` lists the topics; `guide --find WORDS` searches them all.",
        example: "error guide.no-topic: no topic 'loops'\ntry: tachyonc guide --list",
    },
    Explain {
        code: "guide.usage", severity: "error, exit 2",
        means: "The guide command line is wrong: an unknown option, --find without words, \
            --budget without a number.",
        fix: "`tachyonc guide --help`.",
        example: "error guide.usage: unknown option '--topics'\ntry: tachyonc guide --help",
    },
    Explain {
        code: "try.kept", severity: "note, exit 0",
        means: "`try --keep`: the program the snippet became, and its binary, are kept; the note \
            names the program (0.15).",
        fix: "Nothing to fix; read or build the program as any other.",
        example: "note try.kept: the program and its binary: /tmp/tachyonc-try-4242/snippet.tach",
    },
    Explain {
        code: "try.no-file", severity: "error, exit 1",
        means: "`try --file FILE`: the file cannot be read (or the scratch directory cannot be \
            written) (0.15).",
        fix: "Check the path; a snippet can also come as an argument or on stdin (`try -`).",
        example: "error try.no-file: cannot read 'snipet.tach'",
    },
    Explain {
        code: "try.usage", severity: "error, exit 2",
        means: "The try command line is wrong: no snippet, an unknown option, `-` with nothing \
            piped in (0.15).",
        fix: "`tachyonc try 'STATEMENTS'` (the last expression's value is printed), `try --file \
            F`, or `try -` with the snippet on stdin.",
        example: "error try.usage: a snippet is needed: STATEMENTS, --file FILE, or - (stdin)\n\
            try: tachyonc try 'let v = [3, 1, 2]; v[..].len'",
    },
    Explain {
        code: "conflict.none",
        severity: "note, exit 0 (query conflicts); error, exit 1 (FILE:LINE, edit resolve)",
        means: "No merge conflict region where it was looked for: no `<<<<<<<` line in the files, none \
            holding FILE:LINE, or none in an item of that NAME.",
        fix: "`tachyonc query conflicts` lists the regions left, with their lines and items; resolve one \
            by FILE:LINE.",
        example: "error conflict.none: no conflict region in an item 'nosuch'\ntry: tachyonc query conflicts",
    },
    Explain {
        code: "conflict.ambiguous", severity: "error, exit 1",
        means: "`edit resolve`: several conflict regions match TARGET (a FILE, or a NAME several regions \
            are in); nothing is written.",
        fix: "Run a `try:` line (TARGET as FILE:LINE, one region), or add --all to resolve every one the \
            same way.",
        example: "error conflict.ambiguous: 2 conflict regions match 'shapes.tach': shapes.tach:10, \
            shapes.tach:25; give FILE:LINE, or --all for every one\ntry: tachyonc edit resolve shapes.tach:10 --ours",
    },
    Explain {
        code: "conflict.format", severity: "error, exit 1",
        means: "A file's conflict markers do not make regions: a `<<<<<<<` line without its `=======` \
            and `>>>>>>>` lines, one inside another region, or a `>>>>>>>` line alone.",
        fix: "Look at the lines (`try:` query text) and fix the markers with the Edit tool; then \
            `query conflicts` again.",
        example: "error conflict.format: broken.tach:2: a region without its >>>>>>> line; fix the \
            markers by hand\ntry: tachyonc query text broken.tach:1-7",
    },
    Explain {
        code: "conflict.no-base", severity: "error, exit 1",
        means: "`edit resolve --base`: the region has no base side; git writes the base (`||||||| \
            base`) only with merge.conflictStyle diff3 or zdiff3.",
        fix: "Choose --ours, --theirs, --both, or give the text on stdin; `query conflicts FILE:LINE \
            --show` prints the sides.",
        example: "error conflict.no-base: main.tach:4 has no base side (git writes it with \
            merge.conflictStyle diff3)\ntry: tachyonc query conflicts main.tach:4 --show",
    },
    Explain {
        code: "conflict.left", severity: "note, exit 0",
        means: "`edit resolve` wrote its regions; others are left in the root's directory, so the \
            program is not checked yet.",
        fix: "Resolve the others (`tachyonc query conflicts` lists them); the last resolve checks the \
            program.",
        example: "note conflict.left: 2 conflict regions left in 2 files\ntry: tachyonc query conflicts",
    },
    Explain {
        code: "conflict.check", severity: "warning, exit 0",
        means: "`edit resolve` resolved the last region and the program has errors: the sides chosen do \
            not fit together (both sides' imports, a function called with the other side's \
            parameters). The resolve is written; its errors are printed above.",
        fix: "Fix the errors with edit patch (or `tachyonc undo`, and resolve with another side or a \
            text of your own).",
        example: "main.tach:5:14: error[type error] 'Shape' is imported twice\nwarning conflict.check: \
            the resolved program has errors (written; the merge may need more than one side)\ntry: tachyonc check",
    },
];
