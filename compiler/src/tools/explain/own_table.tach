// The explanations of the own pass's codes (0.17, front/own/diag.tach;
// docs/design/value-semantics.md §2.9, §4). Phase 0 wrote what each code
// reports; T6 completes the fixes and the examples, with the tasks that
// report them (T1: moved, move_out, partial, drop_view; T2: conflict,
// escape, static, readonly; T3: views).

use crate::tools::explain::Explain;

pub const OWN_COUNT: i64 = 9;

pub static OWN_TABLE: [Explain; 9] = [
    Explain {
        code: "own.moved",
        severity: "error (--values=error; a warning with warn, a note with report)",
        means: "A value of an owned type (one with a Drop, or holding a Vec, Buf, HashMap) is \
            used after it moved: into a by-value parameter, a `let`, a struct field, a `return`.",
        fix: "Pass a reference (`&v`, the parameter `&Vec<T>`) when the callee only reads it, or \
            a copy (`v.clone()`); the line's try: names the edit.",
        example: "main.tach:6:5: error[own.moved] 'v' is used here after it moved into 'total(v)' at 5:19",
    },
    Explain {
        code: "own.move_out", severity: "error (as own.moved)",
        means: "An owned value is moved out of an index, `*r`, a static or a borrowed parameter, \
            which would leave the place without a value.",
        fix: "Take it out and leave an empty one (`std::take(&mut place)`), swap it \
            (`std::replace`), remove it (`v.remove(i)`), or copy it (`.clone()`).",
        example: "table.tach:2:15: error[own.move_out] cannot move 'self.keys' (Vec<Entry>) out of '*self'",
    },
    Explain {
        code: "own.partial", severity: "error (as own.moved)",
        means: "A field is moved out of a value whose type implements Drop: its drop would see \
            the field gone.",
        fix: "Move the whole value, or take the field out with `std::take`.",
        example: "error[own.partial] cannot move 'f.name' out of 'f': 'File' implements Drop",
    },
    Explain {
        code: "own.conflict", severity: "error (as own.moved)",
        means: "A place is written, moved, dropped or mutably borrowed while a view or a loan of \
            it is still used later: a view after a push, a `for` loop over a Vec it pushes to, \
            two arguments of one call where one writes what the other reads.",
        fix: "Use the view before the change, keep an index instead of a view, or copy the \
            value out first; `tachyonc query own FILE:LINE:COL` shows the state.",
        example: "main.tach:5:5: error[own.conflict] 'v.push(4)' may move v's elements while 'first' (4:17) views them; 'first' is used at 6:16",
    },
    Explain {
        code: "own.escape", severity: "error (as own.moved)",
        means: "A view outlives what it points into: a function returns a view of a local, or \
            of an owned parameter it drops; a block's value views a local of the block.",
        fix: "Return the owner (the Buf, the Vec) instead, and let the caller take its view.",
        example: "greet.tach:3:5: error[own.escape] 'greet' returns a view of 'b', which is dropped when 'greet' returns",
    },
    Explain {
        code: "own.static", severity: "error (as own.moved)",
        means: "A view of a static is used after a call that may write statics (its effects \
            include `global`).",
        fix: "Copy the plain value out first (`let t = TYPES[i];`), or take the view again \
            after the call.",
        example: "types.tach:41:9: error[own.static] 'template_instance' writes statics (global) while 't' (40:9) views TYPES",
    },
    Explain {
        code: "own.views", severity: "error",
        means: "A `#[views(...)]` or `#[stores(...)]` names something that is not a parameter \
            (`p`) or what a parameter's views point into (`*p`); (T3) a body returns or stores \
            more than its declaration says.",
        fix: "Name the parameters the result points into; `tachyonc query views NAME` shows \
            the inferred summary.",
        example: "lex.tach:9:5: error[own.views] 'word' has no parameter 'src'",
    },
    Explain {
        code: "own.drop_view", severity: "error",
        means: "A view type (one holding a slice or a reference) implements Drop: its drop could \
            read what its owner already freed.",
        fix: "Implement Drop on the owner instead, or make the type own its data.",
        example: "error[own.drop_view] 'Scanner' holds a view ('text: [u8]') and cannot implement Drop",
    },
    Explain {
        code: "own.readonly", severity: "error (as own.moved)",
        means: "A write through a shared reference (`&T`) or a read-only slice (`[T]`).",
        fix: "Take `&mut T` (`&mut x` at the call), or `&mut [T]` (`v.as_mut_slice()`, `&mut \
            a[..]`).",
        example: "error[own.readonly] cannot write 'p.x': 'p' is '&P', a shared reference",
    },
];
