// The explanations of the parameter conventions' codes (0.20,
// front/conv.tach; docs/design/conventions.md §10). Phase 0 reports
// conv.rust, conv.set, conv.sink_type and syntax.legacy (the parser);
// conv.marker, conv.marker_extra, conv.place and conv.extern are T1's
// (the checker), their entries written now so that the codes are fixed.

use crate::tools::explain::Explain;

pub const CONV_COUNT: i64 = 9;

pub static CONV_TABLE: [Explain; 9] = [
    Explain {
        code: "conv.rust",
        severity: "error in a file read in 0.20's spelling (--syntax=0.20; the default from Phase M); mixed files accept both spellings",
        means: "Rust's spelling where tachyon has its own (conventions.md §7): `&T` and `&mut T` \
            types, `&mut x`, `let mut`, `mut x` in a pattern, a `mut x: T` parameter, `static \
            mut` and `move |..|`. Parameters take a convention: `x: T` is borrowed read-only \
            (let, the default), `x: inout T` may be changed (the call marks it: `f(&x)`), `x: \
            sink T` is the callee's. Mutable bindings are `var`.",
        fix: "Write the 0.20 form the message names; the try: line (and `tachyonc fix \
            --suggested`) does it: `x: &T` -> `x: T`, `x: &mut T` -> `x: inout T`, `&mut x` -> \
            `&x`, `let mut x` -> `var x`, `static mut` -> `static var`, `mut x: T` -> `x: sink \
            T`, `move |..|` -> `sink |..|`, a field `&T` -> `let T`.",
        example: "fn fill(v: &mut Vec<i64>) { v.push(1); }\n\
            \n\
            main.tach:1:12: error[conv.rust] '&mut Vec<i64>' is Rust's spelling; an exclusive access is 'inout T' (a parameter 'x: inout T', called with '&x')\n\
            \x20 try: tachyonc edit patch main.tach:1 --old '&mut Vec<i64>' --new 'inout Vec<i64>'",
    },
    Explain {
        code: "conv.marker",
        severity: "error (T1 of the conventions; until then the checker's type error)",
        means: "An argument for an `inout` parameter is not marked: the callee may change it, \
            and the call says so with `&`.",
        fix: "Mark it: `f(&v)`. When the callee never changes it, take the parameter let \
            instead: `tachyonc refactor signature F --convention v let`.",
        example: "fn fill(v: inout Vec<i64>) { v.push(1); }\n\
            ...\n\
            fill(v);\n\
            \n\
            main.tach:7:10: error[conv.marker] 'fill' takes 'v' inout (it may change 'v'): mark the argument\n\
            \x20 try: tachyonc edit patch main.tach:7 --old 'fill(v)' --new 'fill(&v)'",
    },
    Explain {
        code: "conv.marker_extra",
        severity: "error (T1 of the conventions)",
        means: "`&` on an argument the callee cannot change: a let parameter (the default) or a \
            sink one, or a value that already is an inout access (a call returning `inout T`). \
            `&` marks only what the callee may change.",
        fix: "Pass the value as it is: `total(v)`.",
        example: "fn total(v: Vec<i64>) -> i64 { v.len() }\n\
            ...\n\
            total(&v);\n\
            \n\
            main.tach:8:15: error[conv.marker_extra] '&' marks an argument the callee may change; 'total' takes 'v' let (it only reads)\n\
            \x20 try: tachyonc edit patch main.tach:8 --old 'total(&v)' --new 'total(v)'",
    },
    Explain {
        code: "conv.place",
        severity: "error (T1 of the conventions)",
        means: "`&` of a temporary (a call's value, a literal): `&` lends a place the caller \
            has, so that the callee's changes stay in it.",
        fix: "Bind the value first: `var t = make(); grow(&t);`. A let parameter takes a \
            temporary as it is: `total(make())`.",
        example: "grow(&make());\n\
            \n\
            main.tach:9:11: error[conv.place] '&' lends a place, and 'make()' is a temporary\n\
            \x20 help: bind it first\n\
            \x20 try: tachyonc edit patch main.tach:9 --old 'grow(&make())' --new 'var t = make(); grow(&t)'",
    },
    Explain {
        code: "conv.set",
        severity: "error",
        means: "`x: set T`: Hylo's convention for a parameter the callee initializes. Tachyon \
            has no uninitialized bindings, so it has no `set`: a function returns what it \
            makes.",
        fix: "Return the value (a tuple or a struct for several); `x: inout T` changes a value \
            the caller already has.",
        example: "fn make(out: set Vec<i64>) { ... }\n\
            \n\
            main.tach:1:14: error[conv.set] there is no 'set' convention: a function returns what it makes\n\
            \x20 help: return the value (a tuple or a struct for several); 'x: inout T' changes a value the caller has",
    },
    Explain {
        code: "conv.sink_type",
        severity: "error",
        means: "`sink T` outside a parameter (a field, a result, a type argument): `sink` says \
            that a parameter is the callee's. A field or a result of type T owns its value \
            already.",
        fix: "Write `T`.",
        example: "struct Job { data: sink Buf }\n\
            \n\
            main.tach:1:20: error[conv.sink_type] 'sink' is a parameter's convention: a field or a result of type T owns its value already",
    },
    Explain {
        code: "conv.extern",
        severity: "error (T1 of the conventions)",
        means: "`inout` or `sink` in an `extern \"C\"` signature: C has values and pointers, \
            no conventions.",
        fix: "Take a raw pointer, `p: *T`, and pass `&x` (it converts).",
        example: "extern \"C\" { fn fill(p: inout i64); }\n\
            \n\
            main.tach:1:24: error[conv.extern] C takes a pointer: 'p: *i64', and the call passes '&x'",
    },
    Explain {
        code: "syntax.legacy",
        severity: "error",
        means: "0.20's spelling (`inout`, `sink`, `var`, `let T`, `self` without a type) in a \
            crate read in 0.19's: its root's first line is `// tachyon-syntax: 0.19`. Only \
            tachyon's own source (compiler/src/main.tach) carries that line, during 0.20: \
            v0.19.1 compiles it, so it keeps 0.19's spelling until 0.21 migrates it \
            (conventions.md §9.3). tests/run.sh fails if another file carries it.",
        fix: "Write 0.19's spelling in that crate (`&mut T`, `let mut`, `mut self: T`); \
            anywhere else, delete the line.",
        example: "// tachyon-syntax: 0.19 (tachyon's own source until 0.21)\n\
            fn bump(n: inout i64) { ... }\n\
            \n\
            main.tach:2:12: error[syntax.legacy] 'inout T' is 0.20's spelling, and this crate is read in 0.19's: its root's first line is '// tachyon-syntax: 0.19' (tachyon's own source until 0.21)",
    },
    Explain {
        code: "syntax.legacy_removed",
        severity: "error (from 0.21)",
        means: "Reserved for 0.21, which reads 0.20's spelling only: a root starting with `// \
            tachyon-syntax: 0.19` is this error.",
        fix: "Run tachyonc 0.20's `fix --only conventions` on the program, then delete the \
            line.",
        example: "(0.21)",
    },
];
