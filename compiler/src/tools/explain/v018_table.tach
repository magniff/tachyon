// The `explain` entries of 0.18's codes (docs/design/contracts-verification.md
// §2.14) that phase 0 prints (tools/v018.tach) or names with a prefix
// tests/refactor/run.sh looks for (`test.`, in front/contracts/diag.tach).
// Each task adds the entries of the other codes as it starts reporting
// them: run.sh wants every entry to be a code of the source.

use crate::tools::explain::Explain;

pub const V018_COUNT: i64 = 7;

pub static V018_TABLE: [Explain; 7] = [
    Explain {
        code: "fuzz.unknown", severity: "error, exit 2",
        means: "(0.18, T3) `tachyonc fuzz NAME`: the program has no #[fuzz] or #[property] function NAME. The message lists the ones it has.",
        fix: "Run the try: line (the first target), or name one of the list.",
        example: "error fuzz.unknown: no #[fuzz] or #[property] function 'nope' in main.tach; its targets: parse_never_crashes | try: tachyonc fuzz parse_never_crashes main.tach",
    },
    Explain {
        code: "fuzz.usage", severity: "error, exit 2",
        means: "(0.18, T3) `tachyonc fuzz` was given an unknown option, no target, or a bad --time.",
        fix: "tachyonc fuzz NAME [ROOT.tach] [--time S]: NAME a #[fuzz] function, S seconds (10 by default).",
        example: "error fuzz.usage: the #[fuzz] function to fuzz is needed; usage: tachyonc fuzz NAME [ROOT.tach] [--time S]",
    },
    Explain {
        code: "import.wildcard", severity: "error",
        means: "(0.18, T2) `use super::*;`, Rust's habit in a test module: wildcard imports are not allowed, and a `#[cfg(test)]` module sees its parent's items (private ones too) without an import.",
        fix: "Delete the line (the try: line does): the names resolve through the parent.",
        example: "error[import.wildcard] wildcard imports are not allowed: 'use super::*;' is not needed | help: a #[cfg(test)] module sees its parent's items, private ones too, without an import | try: tachyonc edit patch main.tach:10 --old 'use super::*;' --new '' main.tach",
    },
    Explain {
        code: "reduce.not-yet", severity: "error, exit 2",
        means: "(0.18 phase 0) A program mode of `tachyonc reduce` (--differs, --fails, --test) that 0.18's T3 adds is named but not implemented yet.",
        fix: "Use `tachyonc reduce FILE --until 'CMD'` until T3 has landed.",
        example: "error reduce.not-yet: '--differs' is 0.18's (T3), not implemented yet",
    },
    Explain {
        code: "test.generate", severity: "error",
        means: "(0.18, T2) A `#[property]` parameter has a type with no generator (a raw pointer, a fn value, a view).",
        fix: "Take an owned value, or write `impl Arbitrary for T`.",
        example: "error[test.generate] no generator for '*u8' (raw pointer)",
    },
    Explain {
        code: "test.not-yet", severity: "error, exit 2",
        means: "(0.18) An option of `tachyonc test` that is named but not implemented yet: --fuzz S (fuzz each target S seconds, T3) and --gen (inputs from a generator, with --against).",
        fix: "Leave the option out: `tachyonc fuzz NAME --time S` fuzzes one target.",
        example: "error test.not-yet: '--fuzz' is 0.18's (T3), not implemented yet",
    },
    Explain {
        code: "test.signature", severity: "error",
        means: "(0.18, T2) A `#[test]` function takes nothing or `gpa: Gpa`, and returns `()` or a Result.",
        fix: "For generated arguments make it a `#[property]`.",
        example: "error[test.signature] '#[test] fn parses(s: [u8])' takes 's': a test takes nothing or 'gpa: Gpa'",
    },
];
