// The `explain` entries of 0.18's codes (docs/design/contracts-verification.md
// §2.14) that phase 0 prints (tools/v018.tach) or names with a prefix
// tests/refactor/run.sh looks for (`test.`, `contract.`, in
// front/contracts/diag.tach).
// Each task adds the entries of the other codes as it starts reporting
// them: run.sh wants every entry to be a code of the source.

use crate::tools::explain::Explain;

pub const V018_COUNT: i64 = 11;

pub static V018_TABLE: [Explain; 11] = [
    Explain {
        code: "contract.effect", severity: "error",
        means: "(0.18) A `requires`, `ensures` or `invariant` condition does io, allocates or touches a static: a check that passes must not change what the program does, and `debug` clauses are switched on and off.",
        fix: "Compute the value in the body (or check it there with `assert`); the condition reads parameters, `result`, `old(..)` and calls pure functions. The try: line shows why the call has the effect.",
        example: "error[contract.effect] the 'requires' of 'push' calls 'log', which does io: a condition may not do io, allocate or touch statics",
    },
    Explain {
        code: "contract.impl-requires", severity: "error",
        means: "(0.18) An impl's method adds a `requires` to a trait's method: callers through the trait would not check it.",
        fix: "Move the requires to the trait's method, or make it an `assert` in the body.",
        example: "error[contract.impl-requires] 'Shape::area' of 'impl Shape for Circle' adds a requires",
    },
    Explain {
        code: "contract.old", severity: "error",
        means: "(0.18) `old(e)` in an `ensures` must be a plain value: a view would see what the body changes, an owned value must be copied.",
        fix: "Take a plain part (`old(self.len())`), or `old(v.clone())`.",
        example: "error[contract.old] 'old(self.items.as_slice())' would view 'self', which 'pop' changes",
    },
    Explain {
        code: "contract.result", severity: "error",
        means: "(0.18) `result`, the returned value, is used in a `requires` (the function has not returned yet) or in an `ensures` of a function that returns nothing.",
        fix: "State the requires on the parameters, or move the condition to an `ensures` of a function that returns a value.",
        example: "error[contract.result] 'result' is the returned value, which a 'requires' does not see",
    },
    Explain {
        code: "contract.sealed", severity: "error",
        means: "(0.18) A field of a type with an `invariant` is written, or a literal of it made, outside its module: only the module's functions keep the invariant.",
        fix: "Call the type's methods (`tachyonc query items MODULE`).",
        example: "error[contract.sealed] 's.max = 3' writes a field of 'Stack', which has an invariant",
    },
    Explain {
        code: "contract.violated", severity: "error",
        means: "(0.18) A `requires` is false for the constant arguments of a call (or a literal is outside a distinct type's invariant): the program would fail there every time.",
        fix: "Change the argument, or the clause.",
        example: "error[contract.violated] 'get(-1)' violates 'requires 0 <= i' of 'get' (stack.tach:4:14)",
    },
    Explain {
        code: "fuzz.not-yet", severity: "error, exit 2",
        means: "(0.18 phase 0) `tachyonc fuzz` (coverage-guided fuzzing of #[fuzz] functions) is named but not implemented yet (T3).",
        fix: "Test with `tachyonc test` until T3 has landed.",
        example: "error fuzz.not-yet: 'tachyonc fuzz' is 0.18's (T3), not implemented yet",
    },
    Explain {
        code: "reduce.not-yet", severity: "error, exit 2",
        means: "(0.18 phase 0) A program mode of `tachyonc reduce` (--differs, --fails, --test) that 0.18's T3 adds is named but not implemented yet.",
        fix: "Use `tachyonc reduce FILE --until 'CMD'` until T3 has landed.",
        example: "error reduce.not-yet: '--differs' is 0.18's (T3), not implemented yet",
    },
    Explain {
        code: "test.generate", severity: "error",
        means: "(0.18, T2) A `#[property]` parameter has a type with no generator (a raw pointer, a fn value, a view).",
        fix: "Take an owned value, or write `impl Arbitrary for T`.",
        example: "error[test.generate] no generator for '*u8' (raw pointer)",
    },
    Explain {
        code: "test.not-yet", severity: "error, exit 2",
        means: "(0.18 phase 0) An option of `tachyonc test` that 0.18's T2 adds (--accept, --cases, --seed, --no-contracts, --no-check-alloc, --fuzz, --gen) is named but not implemented yet.",
        fix: "Leave the option out until T2 has landed.",
        example: "error test.not-yet: '--accept' is 0.18's (T2), not implemented yet",
    },
    Explain {
        code: "test.signature", severity: "error",
        means: "(0.18, T2) A `#[test]` function takes nothing or `gpa: Gpa`, and returns `()` or a Result.",
        fix: "For generated arguments make it a `#[property]`.",
        example: "error[test.signature] '#[test] fn parses(s: [u8])' takes 's': a test takes nothing or 'gpa: Gpa'",
    },
];
