// The module-structure refactorings (0.11, phase 2a; docs/refactor.md):
//
//   tachyonc refactor rename PATH NEW            an item, method, field, variant or
//                                                module, and every reference to it
//   tachyonc refactor move PATH... --to MODULE   items into another module
//   tachyonc refactor new-module crate::a::b [--file|--dir]
//   tachyonc refactor move-module crate::a crate::x::a
//   tachyonc refactor split MODULE --into NEWMOD --items a,b,c
//   tachyonc refactor split MODULE --plan|--auto [--max-lines N]
//
// Each is one edit of the edit engine (edit.tach): checked before it is
// written (nothing is written when it adds an error), journaled for
// `undo`, printed as a diff with --dry-run, one summary line. The moves
// and splits are in refactor_move.tach; this file has the command line,
// what they share (every reference of the program, the modules an edit
// makes, module files), rename, new-module and move-module.

use crate::base::{
    FILES, FILE_COUNT, IntVec, SRC, SYMS, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, intern,
};
use crate::lexer::{TOKS, TOK_COUNT, Tok};
use crate::ast::{NODES, NODE_COUNT, NodeKind, child};
use crate::lower::HMap;
use crate::modules::{MODULES, child_module, file_of_pos, module_at, module_count, module_of};
use crate::query::{
    DEFS, DEF_COUNT, K_FIELD, K_IMPL_METHOD, K_METHOD, K_MOD, K_TRAIT_FN, K_VARIANT, MOD_DEF, OPT_MAX_LINES,
    PROG, QF_DEF, QF_USE, ROOT_GIVEN, R_DEF, R_FLAGS, R_POS, TOOL, bytes_eq, c_slice, collect_refs, diag,
    ends_with_c, find_modules, kind_name, line_end, line_start, load_program, mod_fqn, parse_count,
    program_errors, put_word, resolve_name, root_or_diag, set_targets, sorted_refs, text_start, token_at,
    trait_of, try_begin, try_end, write_diags,
};
use crate::edit::{
    after_line, apply_edit, blank_line, delete_lines, edit_move_file, edit_new_file, edit_replace,
    set_command, take_edit_option,
};
use crate::proc::{buf_cstr, same_bytes};
use crate::cpp::{file_exists, path_dir};
use crate::streq;
use crate::refactor_move::{run_move, run_split};

// ---- The program's references ----

// Every reference the checker resolved (every definition is a target),
// in order, each once: indices into query's R_* vectors.
pub static mut REFS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// What the name a `use` imports at a position is (position + 1 ->
// definition + 1), and its Ident node (position + 1 -> node).
static mut USE_AT: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static mut USE_ID: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
// The Use node of a name's Ident node (node -> Use node).
static mut USE_OF: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
// The names of the modules: (module, name) -> definition + 1, for the
// items (and `mod` declarations), and for the imports.
static mut ITEM_BIND: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static mut USE_BIND: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

fn bind_key(m: i64, name: i64) -> i64 {
    (m + 1) * 4294967296 + name + 1
}

// Collects the references of the whole program, and the names of its
// modules.
pub fn load_refs() {
    unsafe {
        let mut all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for d in 0..DEF_COUNT {
            all.push(d);
            let k = DEFS[d].kind;
            if DEFS[d].parent < 0 && k != K_METHOD && k != K_IMPL_METHOD {
                ITEM_BIND.put(bind_key(DEFS[d].module, DEFS[d].name), d + 1);
            }
        }
        set_targets(&all);
        collect_refs();
        sorted_refs(&REFS);
        for k in 0..REFS.count {
            let r = REFS.data[k];
            if (R_FLAGS.data[r] & QF_USE) != 0 {
                USE_AT.put(R_POS.data[r] + 1, R_DEF.data[r] + 1);
            }
        }
        for u in 1..NODE_COUNT {
            if !is_name_use(u) {
                continue;
            }
            let m = module_of(u);
            for k in 0..NODES[u].count {
                let id = child(u, k);
                USE_ID.put(NODES[id].start + 1, id);
                USE_OF.put(id, u);
                if USE_AT.get(NODES[id].start + 1) > 0 {
                    USE_BIND.put(bind_key(m, use_local(id)), id);
                }
            }
        }
    }
}

// Whether node u is a `use` of names (not a `*`, not a C header's import),
// in a file of the program.
pub fn is_name_use(u: i64) -> bool {
    unsafe { NODES[u].kind == NodeKind::Use && NODES[u].d != 2 && NODES[u].b != 1 && user_pos(NODES[u].start) }
}

// The name a `use` gives (its alias, or the name), of its Ident node id.
pub fn use_local(id: i64) -> i64 {
    unsafe { if NODES[id].b != 0 { NODES[id].b } else { NODES[id].a } }
}

// The Ident node of the `use` name at pos (0: none), and its Use node.
pub fn use_id_at(pos: i64) -> i64 {
    unsafe { USE_ID.get(pos + 1) }
}

pub fn use_node_of(id: i64) -> i64 {
    unsafe { USE_OF.get(id) }
}

// What name `name` is in module m: an item (or a module declared there),
// an import; -1 for none.
pub fn item_binding(m: i64, name: i64) -> i64 {
    unsafe { ITEM_BIND.get(bind_key(m, name)) - 1 }
}

pub fn use_binding(m: i64, name: i64) -> i64 {
    unsafe {
        let id = USE_BIND.get(bind_key(m, name));
        if id == 0 { -1 } else { USE_AT.get(NODES[id].start + 1) - 1 }
    }
}

// The Ident node of the import of `name` in module m (0: none).
pub fn use_binding_id(m: i64, name: i64) -> i64 {
    unsafe { USE_BIND.get(bind_key(m, name)) }
}

pub fn binding_of(m: i64, name: i64) -> i64 {
    let d = item_binding(m, name);
    if d >= 0 { d } else { use_binding(m, name) }
}

pub fn user_pos(pos: i64) -> bool {
    unsafe { FILES[file_of_pos(pos)].path[0] != '<' }
}

// Whether the token at pos is identifier `name`.
pub fn ref_named(pos: i64, name: i64) -> bool {
    unsafe {
        let i = token_at(pos);
        i < TOK_COUNT && TOKS[i].start == pos && TOKS[i].kind == Tok::Ident && TOKS[i].value as i64 == name
    }
}

// Whether the name at pos follows a `::` (a path's later segment).
pub fn qualified(pos: i64) -> bool {
    unsafe {
        let i = token_at(pos);
        i > 0 && TOKS[i - 1].kind == Tok::ColonColon
    }
}

// The start of the path whose segment is at pos: back over `NAME::`.
pub fn path_start(pos: i64) -> i64 {
    unsafe {
        let mut i = token_at(pos);
        while i >= 2 && TOKS[i - 1].kind == Tok::ColonColon && TOKS[i - 2].kind == Tok::Ident {
            i -= 2;
        }
        TOKS[i].start
    }
}

// ---- Regions: the modules, and the ones the edit makes ----
//
// A region is a module of the program (0 .. module_count()) or a module the
// edit makes (module_count() + k): its name, parent region, file, whether
// it is a dir module (`name/mod.tach`), whether it is declared `pub`, and
// its text: the `mod` lines of the modules made in it, its imports, the
// items moved into it.

pub static mut NM_NAME: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut NM_PARENT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut NM_PATH: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut NM_PUB: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut NM_MODS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut NM_USES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut NM_BODY: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

pub fn new_region(parent: i64, name: i64, path: *u8) -> i64 {
    unsafe {
        NM_NAME.push(name);
        NM_PARENT.push(parent);
        NM_PATH.push(path as i64);
        NM_PUB.push(0);
        NM_MODS.push(buf_new());
        NM_USES.push(buf_new());
        NM_BODY.push(buf_new());
        module_count() + NM_NAME.count - 1
    }
}

pub fn is_new(r: i64) -> bool {
    r >= module_count()
}

pub fn region_parent(r: i64) -> i64 {
    unsafe {
        if r < 0 {
            return -1;
        }
        if r < module_count() { MODULES[r].parent } else { NM_PARENT.data[r - module_count()] }
    }
}

pub fn region_name(r: i64) -> i64 {
    unsafe { if r < module_count() { MODULES[r].name } else { NM_NAME.data[r - module_count()] } }
}

// Whether region `inner` is `outer` or inside it.
pub fn within(inner: i64, outer: i64) -> bool {
    let mut m = inner;
    while m >= 0 {
        if m == outer {
            return true;
        }
        m = region_parent(m);
    }
    false
}

pub fn region_public(r: i64) -> bool {
    unsafe {
        if r == 0 {
            return true;
        }
        if r < module_count() { MODULES[r].public } else { NM_PUB.data[r - module_count()] != 0 }
    }
}

// The path of region r: `crate`, `crate::a::b`.
pub fn put_region_path(out: i64, r: i64) {
    unsafe {
        if r < module_count() {
            buf_bytes(out, SYMS[mod_fqn(r)].text);
            return;
        }
        put_region_path(out, region_parent(r));
        buf_str(out, c"::");
        buf_bytes(out, SYMS[NM_NAME.data[r - module_count()]].text);
    }
}

// ---- Module files ----

// The file of module m (not an inline module's), or -1.
pub fn own_file(m: i64) -> i64 {
    unsafe {
        for f in 0..FILE_COUNT {
            if FILES[f].module == m && FILES[f].path[0] != '<' {
                return f;
            }
        }
        -1
    }
}

// The last component of a path.
pub fn base_name(path: *u8) -> [u8] {
    unsafe {
        let p = c_slice(path);
        let mut i = p.len;
        while i > 0 && p[i - 1] != '/' {
            i -= 1;
        }
        p[i..p.len]
    }
}

pub fn is_mod_file(path: *u8) -> bool {
    unsafe { bytes_eq(base_name(path), c_slice(c"mod.tach")) }
}

// The file of module `name`, a child of the module whose file is `path`
// (`root`: the root module's), as the module loader finds it: next to the
// file for the root or a `mod.tach`, else in the directory named after it;
// `name.tach`, or `name/mod.tach` for a dir module.
pub fn child_path(path: *u8, root: bool, name: [u8], dir: bool) -> *u8 {
    unsafe {
        let out = buf_new();
        buf_str(out, path_dir(path));
        buf_byte(out, '/');
        let base = base_name(path);
        if !root && !is_mod_file(path) {
            buf_bytes(out, base[0..base.len - 5]);
            buf_byte(out, '/');
        }
        buf_bytes(out, name);
        buf_str(out, if dir { c"/mod.tach" } else { c".tach" });
        buf_cstr(out)
    }
}

// `x/a.tach` as a dir module's file: `x/a/mod.tach`.
pub fn dir_form(path: *u8) -> *u8 {
    unsafe {
        let p = c_slice(path);
        let b = buf_new();
        buf_bytes(b, p[0..p.len - 5]);
        buf_str(b, c"/mod.tach");
        buf_cstr(b)
    }
}

// The file module m's text will be in after the edit, and moves it to its
// dir form (`a.tach` -> `a/mod.tach`) when it gains a child: the path its
// children are found from. 0 for an inline module.
pub fn parent_file_path(m: i64, converts: *HMap) -> *u8 {
    unsafe {
        let f = own_file(m);
        if f < 0 {
            return 0 as *u8;
        }
        if m == 0 || is_mod_file(FILES[f].path) {
            return FILES[f].path;
        }
        let p = dir_form(FILES[f].path);
        if (*converts).get(f + 1) == 0 {
            (*converts).put(f + 1, p as i64);
            edit_move_file(f, p);
        }
        (*converts).get(f + 1) as *u8
    }
}

// Moves the files of module m (its file, and its children's) so that its
// file is `path`.
pub fn move_tree(m: i64, path: *u8) {
    unsafe {
        let f = own_file(m);
        let p = c_slice(FILES[f].path);
        let np = c_slice(path);
        let old = buf_new();
        let new = buf_new();
        if is_mod_file(FILES[f].path) {
            buf_bytes(old, p[0..p.len - 8]);
            buf_bytes(new, np[0..np.len - 8]);
        } else {
            buf_bytes(old, p[0..p.len - 5]);
            buf_byte(old, '/');
            buf_bytes(new, np[0..np.len - 5]);
            buf_byte(new, '/');
            edit_move_file(f, path);
        }
        let o = buf_slice(old);
        for g in 0..FILE_COUNT {
            let q = c_slice(FILES[g].path);
            if q.len > o.len && same_bytes(q[0..o.len], o) {
                let b = buf_new();
                buf_bytes(b, buf_slice(new));
                buf_bytes(b, q[o.len..q.len]);
                edit_move_file(g, buf_cstr(b));
            }
        }
    }
}

// Adds line `text` (`mod NAME;`) to file f: after its last `mod NAME;`
// line, else before its first item (after the comment at its top).
pub fn add_mod_line(f: i64, text: [u8]) {
    unsafe {
        let mut last = -1;
        for d in 0..DEF_COUNT {
            if DEFS[d].kind == K_MOD && file_of_pos(DEFS[d].start) == f && SRC[DEFS[d].end - 1] == ';'
                && (last < 0 || DEFS[d].start > DEFS[last].start) {
                last = d;
            }
        }
        let b = buf_new();
        if last >= 0 {
            buf_byte(b, '\n');
            buf_bytes(b, text);
            let at = line_end(DEFS[last].end - 1);
            put_edit(at, at, b);
            return;
        }
        let at = first_item_line(f);
        buf_bytes(b, text);
        buf_byte(b, '\n');
        if at < FILES[f].end {
            buf_byte(b, '\n');
        }
        put_edit(at, at, b);
    }
}

// The start of the line where file f's first item (or `use`) starts, with
// the comment lines directly above it; the file's end when it has none.
pub fn first_item_line(f: i64) -> i64 {
    unsafe {
        let i = token_at(FILES[f].start);
        if i >= TOK_COUNT || TOKS[i].start >= FILES[f].end {
            return FILES[f].end;
        }
        let mut at = line_start(TOKS[i].start);
        while at > FILES[f].start {
            let prev = line_start(at - 1);
            if !comment_line(prev) {
                break;
            }
            at = prev;
        }
        // (a comment from the top of the file is the file's)
        if at == FILES[f].start { line_start(TOKS[i].start) } else { at }
    }
}

// Whether the line at pos (a line's start) is a `//` comment.
pub fn comment_line(pos: i64) -> bool {
    unsafe {
        let mut p = pos;
        while SRC[p] == ' ' || SRC[p] == '\t' {
            p += 1;
        }
        SRC[p] == '/' && SRC[p + 1] == '/'
    }
}

// ---- Edits ----

// Whether an edit could not be added (it overlaps another): the command
// then fails, nothing written.
pub static mut EDIT_FAILED: bool = false;

pub fn put_edit(a: i64, b: i64, text: i64) {
    unsafe {
        if !edit_replace(a, b, text) {
            EDIT_FAILED = true;
        }
    }
}

pub fn text_of(s: [u8]) -> i64 {
    let b = buf_new();
    buf_bytes(b, s);
    b
}

// The edit, applied: summary `what`; refused when its edits overlap.
pub fn finish(what: i64, root: *u8) -> i64 {
    unsafe {
        if EDIT_FAILED {
            let d = diag(c"error", c"refactor.internal");
            buf_str(d, c"the edits overlap (a case the refactoring does not handle); nothing written\n");
            return 1;
        }
        apply_edit(buf_slice(what), root)
    }
}

// ---- Diagnostics ----

pub fn usage(message: *u8, example: *u8) -> i64 {
    unsafe {
        let d = diag(c"error", c"refactor.usage");
        buf_str(d, message);
        buf_byte(d, '\n');
        if example != 0 as *u8 {
            let out = try_begin(example, c_slice(c""), false);
            try_end(out);
        }
        2
    }
}

// `name` would be two things in region r: d is the other (a definition,
// or what an import of that name brings).
pub fn collision(name: [u8], r: i64, d: i64, imported: bool) -> i64 {
    unsafe {
        let e = diag(c"error", c"refactor.collision");
        buf_byte(e, '\'');
        buf_bytes(e, name);
        buf_str(e, c"' is already a name in ");
        put_region_path(e, r);
        if d >= 0 {
            buf_str(e, if imported { c" (an import of " } else { c" (" });
            buf_str(e, kind_name(DEFS[d].kind));
            buf_byte(e, ' ');
            buf_bytes(e, SYMS[DEFS[d].fqn].text);
            buf_byte(e, ')');
        }
        buf_str(e, c"; nothing written\n");
        if d >= 0 {
            let out = try_begin(if imported { c"refs" } else { c"def" }, SYMS[DEFS[d].fqn].text, true);
            if imported && r < module_count() {
                buf_str(out, c" --in ");
                buf_bytes(out, SYMS[mod_fqn(r)].text);
            }
            try_end(out);
        }
        1
    }
}

// A path that names no module.
pub fn no_module(name: [u8], cmd: *u8) -> i64 {
    unsafe {
        let d = diag(c"error", c"refactor.no-module");
        buf_str(d, c"no module '");
        buf_bytes(d, name);
        buf_str(d, c"'\n");
        if cmd != 0 as *u8 {
            let out = try_begin(cmd, name, true);
            try_end(out);
        } else {
            let out = try_begin(c"items", c_slice(c""), false);
            try_end(out);
        }
        1
    }
}

// Keeps the definitions in the program's files (std's and the C headers'
// aside), unless there are none.
pub fn keep_source(matches: *IntVec) {
    unsafe {
        let mut kept = 0;
        for i in 0..(*matches).count {
            let d = (*matches).data[i];
            if user_pos(DEFS[d].start) {
                (*matches).data[kept] = d;
                kept += 1;
            }
        }
        if kept > 0 {
            (*matches).count = kept;
        }
    }
}

// NAME names several definitions: the first ones, as the command to run.
pub fn ambiguous(cmd: *u8, name: [u8], rest: [u8], matches: *IntVec) {
    unsafe {
        let n = (*matches).count;
        let d = diag(c"error", c"query.ambiguous");
        buf_int_n(d, n);
        buf_str(d, c" definitions match '");
        buf_bytes(d, name);
        buf_str(d, c"'; name one\n");
        for i in 0..n {
            if i == 3 || (i == 2 && n > 3) {
                break;
            }
            let out = try_begin(cmd, SYMS[DEFS[(*matches).data[i]].fqn].text, true);
            if rest.len > 0 {
                put_word(out, rest);
            }
            try_end(out);
        }
        if n > 3 {
            let out = try_begin(c"def", name, true);
            try_end(out);
        }
    }
}

fn buf_int_n(out: i64, n: i64) {
    crate::base::buf_int(out, n);
}

// The one definition NAME names in the program's files (for command cmd,
// `rest` its other words), or -1 after the diagnostic.
pub fn one_definition(cmd: *u8, name: [u8], rest: [u8]) -> i64 {
    unsafe {
        let mut matches = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if !resolve_name(c"def", name, &matches) {
            return -1;
        }
        keep_source(&matches);
        if matches.count > 1 {
            ambiguous(cmd, name, rest, &matches);
            return -1;
        }
        let d = matches.data[0];
        if !user_pos(DEFS[d].start) {
            let e = diag(c"error", c"edit.not-source");
            buf_bytes(e, SYMS[DEFS[d].fqn].text);
            buf_str(e, c" is not in a file of the program\n");
            return -1;
        }
        d
    }
}

// Whether s is an identifier (and not a keyword).
pub fn is_ident(s: [u8]) -> bool {
    if s.len == 0 || (s[0] >= '0' && s[0] <= '9') {
        return false;
    }
    for i in 0..s.len {
        let c = s[i];
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_') {
            return false;
        }
    }
    let words = c"fn let mut struct if else loop while for in break continue true false as return extern const static type enum match impl union import use pub mod defer unsafe trait crate super self Self ";
    unsafe {
        let w = c_slice(words);
        let mut i = 0;
        while i < w.len {
            let mut e = i;
            while w[e] != ' ' {
                e += 1;
            }
            if bytes_eq(w[i..e], s) {
                return false;
            }
            i = e + 1;
        }
    }
    true
}

// The module a path names (`crate`, `crate::a::b`, or its end), or -1.
pub fn module_named(name: [u8]) -> i64 {
    unsafe {
        let mut found = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        find_modules(name, false, &found);
        let mut best = -1;
        for i in 0..found.count {
            let m = found.data[i];
            if bytes_eq(SYMS[mod_fqn(m)].text, name) {
                return m;
            }
            best = if best < 0 { m } else { -2 };
        }
        if best >= 0 { best } else { -1 }
    }
}

// The segments of path `crate::a::b` (symbols, `crate` left out), or
// false when it is not such a path.
pub fn path_segments(path: [u8], out: *IntVec) -> bool {
    unsafe {
        if path.len < 5 || !bytes_eq(path[0..5], c_slice(c"crate")) {
            return false;
        }
        let mut i = 5;
        while i < path.len {
            if i + 2 > path.len || path[i] != ':' || path[i + 1] != ':' {
                return false;
            }
            i += 2;
            let mut e = i;
            while e < path.len && path[e] != ':' {
                e += 1;
            }
            if !is_ident(path[i..e]) {
                return false;
            }
            out.push(intern(path[i..e]));
            i = e;
        }
        true
    }
}

// ---- The command line ----

pub fn is_module_refactor(cmd: *u8) -> bool {
    unsafe {
        streq(cmd, c"rename") || streq(cmd, c"move") || streq(cmd, c"new-module") || streq(cmd, c"move-module")
            || streq(cmd, c"split")
    }
}

// The options of the module refactorings.
pub static mut OPT_TO: *u8 = 0 as *u8;
pub static mut OPT_INTO: *u8 = 0 as *u8;
pub static mut OPT_ITEMS: *u8 = 0 as *u8;
pub static mut OPT_PLAN: bool = false;
pub static mut OPT_AUTO: bool = false;
pub static mut OPT_DIR: bool = false;
pub static mut OPT_KEEP_IMPLS: bool = false;

pub fn run_refactor_mod(argc: i64, argv: **u8) -> i64 {
    let status = run_inner(argc, argv);
    write_diags();
    status
}

fn run_inner(argc: i64, argv: **u8) -> i64 {
    unsafe {
        PROG = argv[0];
        TOOL = c"refactor";
        set_command(argc, argv);
        let cmd = argv[2];
        let mut root = 0 as *u8;
        let mut words = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut i = 3;
        while i < argc {
            let a = argv[i];
            let has_value = i + 1 < argc;
            if streq(a, c"--to") && has_value {
                OPT_TO = argv[i + 1];
                i += 1;
            } else if streq(a, c"--into") && has_value {
                OPT_INTO = argv[i + 1];
                i += 1;
            } else if streq(a, c"--items") && has_value {
                OPT_ITEMS = argv[i + 1];
                i += 1;
            } else if streq(a, c"--max-lines") && has_value {
                OPT_MAX_LINES = parse_count(argv[i + 1]);
                if OPT_MAX_LINES <= 0 {
                    return usage(c"--max-lines takes a number of lines", 0 as *u8);
                }
                i += 1;
            } else if streq(a, c"--plan") {
                OPT_PLAN = true;
            } else if streq(a, c"--auto") {
                OPT_AUTO = true;
            } else if streq(a, c"--dir") {
                OPT_DIR = true;
            } else if streq(a, c"--file") {
                OPT_DIR = false;
            } else if streq(a, c"--keep-impls") {
                OPT_KEEP_IMPLS = true;
            } else if take_edit_option(argc, argv, &i, &root) {
            } else if a[0] == '-' && a[1] == '-' {
                let d = diag(c"error", c"refactor.usage");
                buf_str(d, c"unknown option '");
                buf_str(d, a);
                buf_str(d, c"'\n");
                return 2;
            } else {
                words.push(a as i64);
            }
            i += 1;
        }
        if root == 0 as *u8 && words.count > 0 && ends_with_c(words.data[words.count - 1] as *u8, c".tach") {
            root = words.data[words.count - 1] as *u8;
            words.count -= 1;
        }
        ROOT_GIVEN = root;
        let n = words.count;
        let w0 = if n > 0 { c_slice(words.data[0] as *u8) } else { c_slice(c"") };
        let w1 = if n > 1 { c_slice(words.data[1] as *u8) } else { c_slice(c"") };
        // The command's words, checked before the program is read.
        if streq(cmd, c"rename") && n != 2 {
            return usage(c"rename takes PATH and the NEW name", c"rename crate::m::old new");
        }
        if streq(cmd, c"rename") && !is_ident(w1) {
            return usage(c"the new name must be an identifier (not a keyword)", 0 as *u8);
        }
        if streq(cmd, c"move") && (n == 0 || (OPT_TO == 0 as *u8 && n < 2)) {
            return usage(c"move takes PATH... and the MODULE (`--to MODULE`)", c"move crate::m::item --to crate::other");
        }
        if (streq(cmd, c"new-module") && n != 1) || (streq(cmd, c"move-module") && n != 2) {
            return usage(if n == 0 || streq(cmd, c"move-module") { c"a module path is needed (crate::a::b)" } else { c"one module at a time" },
                if streq(cmd, c"new-module") { c"new-module crate::a::b" } else { c"move-module crate::a crate::b::a" });
        }
        if streq(cmd, c"split") && (n != 1 || (!OPT_PLAN && !OPT_AUTO && (OPT_INTO == 0 as *u8 || OPT_ITEMS == 0 as *u8))) {
            return usage(c"split takes MODULE and --into NEWMOD --items a,b,c, or --plan, or --auto", c"split crate::m --plan");
        }
        root = root_or_diag(root, cmd, w0, true);
        if root == 0 as *u8 {
            return 2;
        }
        if !load_program(root, crate::edit::TARGET) {
            program_errors(c"error", root, true);
            return 1;
        }
        if streq(cmd, c"rename") {
            return run_rename(w0, w1, root);
        }
        if streq(cmd, c"new-module") {
            return run_new_module(w0, root);
        }
        if streq(cmd, c"move-module") {
            return run_move_module(w0, w1, root);
        }
        if streq(cmd, c"move") {
            if OPT_TO == 0 as *u8 {
                OPT_TO = words.data[n - 1] as *u8;
                words.count -= 1;
            }
            return run_move(&words, OPT_TO, root);
        }
        run_split(w0, root)
    }
}

// ---- rename ----

// `refactor rename PATH NEW`: the definition and every reference to it
// (its uses, imports and paths) get the new name; a module's file (or
// directory) is renamed too. A trait impl's function is renamed with the
// trait's: the trait's function and every impl's. Backquoted mentions in
// comments (`name`, `a::name`, `name()`) are renamed when no other
// definition has the old name.
fn run_rename(name: [u8], new: [u8], root: *u8) -> i64 {
    unsafe {
        let mut d = one_definition(c"rename", name, new);
        if d < 0 {
            return 1;
        }
        if DEFS[d].kind == K_IMPL_METHOD {
            let t = trait_of(d);
            let mut tf = -1;
            if t >= 0 {
                for e in 0..DEF_COUNT {
                    if DEFS[e].parent == t && DEFS[e].name == DEFS[d].name {
                        tf = e;
                    }
                }
            }
            if tf < 0 || !user_pos(DEFS[tf].start) {
                let e = diag(c"error", c"edit.not-source");
                buf_bytes(e, SYMS[DEFS[d].fqn].text);
                buf_str(e, c" implements a function of a trait that is not in a file of the program\n");
                return 1;
            }
            d = tf;
        }
        let old = DEFS[d].name;
        let newsym = intern(new);
        if old == newsym {
            let e = diag(c"note", c"edit.unchanged");
            buf_str(e, c"nothing to change\n");
            return 0;
        }
        load_refs();
        // The definitions renamed together: a trait's function and its impls'.
        let mut group = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        group.push(d);
        if DEFS[d].kind == K_TRAIT_FN {
            for e in 0..DEF_COUNT {
                if DEFS[e].kind == K_IMPL_METHOD && DEFS[e].name == old && trait_of(e) == DEFS[d].parent {
                    group.push(e);
                }
            }
        }
        if rename_collides(d, &group, newsym) {
            return 1;
        }
        let m = if DEFS[d].kind == K_MOD { child_module(DEFS[d].module, old) } else { -1 };
        if m >= 0 && own_file(m) >= 0 {
            // (a module of its own file: the file is renamed too)
            let status = relocate_module(m, MODULES[m].parent, newsym);
            if status >= 0 {
                return status;
            }
        } else {
            rename_refs(&group, old, new);
        }
        doc_mentions(&group, old, new);
        finish_rename(d, new, root)
    }
}

fn finish_rename(d: i64, new: [u8], root: *u8) -> i64 {
    unsafe {
        let what = buf_new();
        buf_str(what, c"renamed ");
        buf_bytes(what, SYMS[DEFS[d].fqn].text);
        buf_str(what, c" to ");
        buf_bytes(what, new);
        finish(what, root)
    }
}

// Every reference to the definitions of group, written `old`, becomes new.
fn rename_refs(group: *IntVec, old: i64, new: [u8]) {
    unsafe {
        let mut in_group = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for i in 0..(*group).count {
            in_group.put((*group).data[i] + 1, 1);
        }
        let mut done = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        let n = SYMS[old].text.len;
        for k in 0..REFS.count {
            let r = REFS.data[k];
            let p = R_POS.data[r];
            if in_group.get(R_DEF.data[r] + 1) == 0 || !user_pos(p) || done.get(p + 1) != 0 || !ref_named(p, old) {
                continue;
            }
            done.put(p + 1, 1);
            put_edit(p, p + n, text_of(new));
        }
    }
}

// Whether the new name is taken where the definitions of group are named
// (diagnosed).
fn rename_collides(d: i64, group: *IntVec, new: i64) -> bool {
    unsafe {
        let k = DEFS[d].kind;
        let text = SYMS[new].text;
        let m = DEFS[d].module;
        if k == K_FIELD || k == K_VARIANT || k == K_TRAIT_FN {
            for e in 0..DEF_COUNT {
                if DEFS[e].parent == DEFS[d].parent && DEFS[e].name == new {
                    collision(text, m, e, false);
                    return true;
                }
            }
        }
        if k == K_METHOD || k == K_TRAIT_FN {
            for i in 0..(*group).count {
                let g = (*group).data[i];
                for e in 0..DEF_COUNT {
                    if (DEFS[e].kind == K_METHOD || DEFS[e].kind == K_IMPL_METHOD) && DEFS[e].owner == DEFS[g].owner
                        && DEFS[e].name == new && (k == K_METHOD || DEFS[g].kind == K_IMPL_METHOD) {
                        collision(text, m, e, false);
                        return true;
                    }
                }
            }
        }
        if DEFS[d].parent >= 0 || k == K_METHOD || k == K_IMPL_METHOD {
            return false;
        }
        // An item: its module's names, and those of the modules importing it.
        let b = binding_of(m, new);
        if b >= 0 {
            collision(text, m, b, item_binding(m, new) < 0);
            return true;
        }
        for x in 0..REFS.count {
            let r = REFS.data[x];
            if R_DEF.data[r] != d || (R_FLAGS.data[r] & QF_USE) == 0 {
                continue;
            }
            let id = use_id_at(R_POS.data[r]);
            if id == 0 || NODES[id].b != 0 {
                continue;
            }
            let u = module_at(R_POS.data[r]);
            let c = binding_of(u, new);
            if c >= 0 {
                collision(text, u, c, item_binding(u, new) < 0);
                return true;
            }
        }
        false
    }
}

// The mentions of the old name in comments: `old`, `a::old`, `old()`
// between backquotes; only when no definition outside group is named old.
fn doc_mentions(group: *IntVec, old: i64, new: [u8]) {
    unsafe {
        for e in 0..DEF_COUNT {
            if DEFS[e].name != old {
                continue;
            }
            let mut mine = false;
            for i in 0..(*group).count {
                if (*group).data[i] == e {
                    mine = true;
                }
            }
            if !mine {
                return;
            }
        }
        let o = SYMS[old].text;
        for f in 0..FILE_COUNT {
            if FILES[f].path[0] == '<' {
                continue;
            }
            // The gaps between tokens hold the comments.
            let mut from = FILES[f].start;
            let mut i = token_at(FILES[f].start);
            loop {
                let to = if i < TOK_COUNT && TOKS[i].start < FILES[f].end { TOKS[i].start } else { FILES[f].end };
                mentions_in(from, to, o, new);
                if to >= FILES[f].end {
                    break;
                }
                from = TOKS[i].end;
                i += 1;
            }
        }
    }
}

// The mentions in the comments of SRC[from..to).
fn mentions_in(from: i64, to: i64, old: [u8], new: [u8]) {
    unsafe {
        let mut p = from;
        while p + 1 < to {
            if SRC[p] != '/' || SRC[p + 1] != '/' {
                p += 1;
                continue;
            }
            // A comment: its backquoted spans.
            let mut q = p + 2;
            while q < to && SRC[q] != '\n' {
                if SRC[q] != '`' {
                    q += 1;
                    continue;
                }
                let mut e = q + 1;
                while e < to && SRC[e] != '`' && SRC[e] != '\n' {
                    e += 1;
                }
                if e >= to || SRC[e] != '`' {
                    break;
                }
                let at = mention(SRC[q + 1..e], old);
                if at >= 0 {
                    put_edit(q + 1 + at, q + 1 + at + old.len, text_of(new));
                }
                q = e + 1;
            }
            p = q;
        }
    }
}

// Where old is in s when s is `old`, `a::b::old` or `old()`, else -1.
fn mention(s: [u8], old: [u8]) -> i64 {
    let mut t = s;
    if t.len > 2 && t[t.len - 2] == '(' && t[t.len - 1] == ')' {
        t = t[0..t.len - 2];
    }
    if t.len < old.len || !bytes_eq(t[t.len - old.len..t.len], old) {
        return -1;
    }
    let at = t.len - old.len;
    if at == 0 {
        return 0;
    }
    if at < 3 || t[at - 1] != ':' || t[at - 2] != ':' {
        return -1;
    }
    // (the segments before are identifiers)
    let mut i = 0;
    while i < at - 2 {
        let mut e = i;
        while e < at - 2 && t[e] != ':' {
            e += 1;
        }
        if unsafe { !is_ident(t[i..e]) && !bytes_eq(t[i..e], c_slice(c"crate")) && !bytes_eq(t[i..e], c_slice(c"super")) } {
            return -1;
        }
        i = e + 2;
    }
    at
}

// ---- new-module ----

// `refactor new-module crate::a::b [--file|--dir]`: makes the module's
// file (`a/b.tach`, or `a/b/mod.tach`) and its `mod b;` line in its
// parent, making the modules of the path that do not exist (as dir
// modules); a file module that gains a child becomes a dir module
// (`a.tach` -> `a/mod.tach`).
fn run_new_module(path: [u8], root: *u8) -> i64 {
    unsafe {
        let mut segs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if !path_segments(path, &segs) || segs.count == 0 {
            return usage(c"a module path is needed (crate::a::b)", c"new-module crate::a::b");
        }
        load_refs();
        let mut converts = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        let r = make_path(&segs, segs.count, OPT_DIR, &converts);
        if r == -2 {
            let d = diag(c"error", c"refactor.exists");
            buf_str(d, c"module ");
            buf_bytes(d, path);
            buf_str(d, c" exists\n");
            let out = try_begin(c"items", path, true);
            try_end(out);
            return 1;
        }
        if r < 0 {
            return 1;
        }
        emit_regions();
        let what = buf_new();
        buf_str(what, c"made module ");
        buf_bytes(what, path);
        finish(what, root)
    }
}

// The region of the module with path segs[0..n) (after `crate`), made
// when it does not exist (and the modules before it); the last one a dir
// module when `dir`. -2 when it exists and `n` is all of segs and none is
// made, -1 after a diagnostic.
pub fn make_path(segs: *IntVec, n: i64, dir: bool, converts: *HMap) -> i64 {
    unsafe {
        let mut m = 0;
        let mut k = 0;
        while k < n {
            let c = child_module(m, (*segs).data[k]);
            if c < 0 {
                break;
            }
            m = c;
            k += 1;
        }
        if k == n {
            return -2;
        }
        let mut r = m;
        while k < n {
            let name = (*segs).data[k];
            let last = k == n - 1;
            r = make_module(r, name, if last { dir } else { true }, converts);
            if r < 0 {
                return -1;
            }
            k += 1;
        }
        r
    }
}

// Makes module `name` in region parent (its `mod` line goes there when the
// edit is emitted): its region, or -1 after a diagnostic.
pub fn make_module(parent: i64, name: i64, dir: bool, converts: *HMap) -> i64 {
    unsafe {
        let mut ppath = 0 as *u8;
        let mut proot = false;
        if is_new(parent) {
            ppath = NM_PATH.data[parent - module_count()] as *u8;
        } else {
            let b = binding_of(parent, name);
            if b >= 0 {
                collision(SYMS[name].text, parent, b, item_binding(parent, name) < 0);
                return -1;
            }
            ppath = parent_file_path(parent, converts);
            proot = parent == 0;
            if ppath == 0 as *u8 {
                return inline_module(parent);
            }
        }
        let path = child_path(ppath, proot, SYMS[name].text, dir);
        let other = child_path(ppath, proot, SYMS[name].text, !dir);
        if file_exists(path) || file_exists(other) {
            let d = diag(c"error", c"refactor.exists");
            buf_str(d, c"'");
            buf_str(d, if file_exists(path) { path } else { other });
            buf_str(d, c"' exists already; nothing written\n");
            return -1;
        }
        new_region(parent, name, path)
    }
}

pub fn inline_module(m: i64) -> i64 {
    unsafe {
        let d = diag(c"error", c"refactor.inline");
        buf_bytes(d, SYMS[mod_fqn(m)].text);
        buf_str(d, c" is an inline module (`mod m { }`); the module refactorings work on modules of their own files\n");
        1
    }
}

// The texts of the modules the edit makes: their files, and their `mod`
// lines in the modules of the program.
pub fn emit_regions() {
    unsafe {
        let mc = module_count();
        // (the lines for one module of the program together)
        let mut lines = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        let mut parents = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for k in 0..NM_NAME.count {
            let line = buf_new();
            if NM_PUB.data[k] != 0 {
                buf_str(line, c"pub ");
            }
            buf_str(line, c"mod ");
            buf_bytes(line, SYMS[NM_NAME.data[k]].text);
            buf_byte(line, ';');
            let parent = NM_PARENT.data[k];
            if parent < mc {
                let mut b = lines.get(parent + 1);
                if b == 0 {
                    b = buf_new();
                    lines.put(parent + 1, b);
                    parents.push(parent);
                } else {
                    buf_byte(b, '\n');
                }
                buf_bytes(b, buf_slice(line));
            } else {
                buf_bytes(NM_MODS.data[parent - mc], buf_slice(line));
                buf_byte(NM_MODS.data[parent - mc], '\n');
            }
        }
        for i in 0..parents.count {
            add_mod_line(own_file(parents.data[i]), buf_slice(lines.get(parents.data[i] + 1)));
        }
        for k in 0..NM_NAME.count {
            let text = buf_new();
            let parts = [NM_MODS.data[k], NM_USES.data[k], NM_BODY.data[k]];
            for j in 0..3 {
                if crate::base::BUFS[parts[j]].len == 0 {
                    continue;
                }
                if crate::base::BUFS[text].len > 0 {
                    buf_byte(text, '\n');
                }
                buf_bytes(text, buf_slice(parts[j]));
            }
            edit_new_file(NM_PATH.data[k] as *u8, text);
        }
    }
}

// ---- move-module ----

// `refactor move-module crate::a crate::x::b`: module a, its file (or
// directory) and its children's, becomes crate::x::b: the modules of the
// path that do not exist are made (dir modules), its `mod` line moves to
// its new parent, every path and `use` naming it is rewritten, and the
// `super::` paths inside it that lead out of it are written from `crate`.
fn run_move_module(from: [u8], to: [u8], root: *u8) -> i64 {
    unsafe {
        let m = module_named(from);
        if m <= 0 {
            return no_module(from, 0 as *u8);
        }
        if own_file(m) < 0 {
            return inline_module(m);
        }
        let mut segs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if !path_segments(to, &segs) || segs.count == 0 {
            return usage(c"the new path of the module is needed (crate::x::b)", c"move-module crate::a crate::x::a");
        }
        load_refs();
        let mut converts = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        // The new parent (made when it does not exist).
        let n = segs.count;
        let mut parent = 0;
        if n > 1 {
            parent = make_path(&segs, n - 1, true, &converts);
            if parent == -2 {
                // (it exists)
                parent = 0;
                for k in 0..n - 1 {
                    parent = child_module(parent, segs.data[k]);
                }
            }
            if parent < 0 {
                return 1;
            }
        }
        if within(parent, m) {
            return usage(c"a module cannot move into itself", 0 as *u8);
        }
        let name = segs.data[n - 1];
        if parent == MODULES[m].parent && name == MODULES[m].name {
            let e = diag(c"note", c"edit.unchanged");
            buf_str(e, c"nothing to change\n");
            return 0;
        }
        let status = relocate_module(m, parent, name);
        if status >= 0 {
            return status;
        }
        crate::refactor_move::emit_use_edits();
        emit_regions();
        let what = buf_new();
        buf_str(what, c"moved module ");
        buf_bytes(what, SYMS[mod_fqn(m)].text);
        buf_str(what, c" to ");
        buf_bytes(what, to);
        finish(what, root)
    }
}

// The edits making module m (of its own file) module `name` of region
// parent: its files, its `mod` line, the references to it. -1 when they
// are made, else the exit status (after a diagnostic).
fn relocate_module(m: i64, parent: i64, name: i64) -> i64 {
    unsafe {
        let dm = MOD_DEF.data[m];
        let same = parent == MODULES[m].parent;
        let mut converts = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        // Its new file.
        let mut ppath = 0 as *u8;
        if is_new(parent) {
            ppath = NM_PATH.data[parent - module_count()] as *u8;
        } else {
            let b = binding_of(parent, name);
            if b >= 0 {
                return collision(SYMS[name].text, parent, b, item_binding(parent, name) < 0);
            }
            ppath = if same { FILES[own_file(parent)].path } else { parent_file_path(parent, &converts) };
            if ppath == 0 as *u8 {
                return inline_module(parent);
            }
        }
        let dir = is_mod_file(FILES[own_file(m)].path);
        let path = child_path(ppath, parent == 0, SYMS[name].text, dir);
        let other = child_path(ppath, parent == 0, SYMS[name].text, !dir);
        if file_exists(path) || file_exists(other) {
            let d = diag(c"error", c"refactor.collision");
            buf_str(d, c"'");
            buf_str(d, if file_exists(path) { path } else { other });
            buf_str(d, c"' exists already; nothing written\n");
            return 1;
        }
        move_tree(m, path);
        // The references.
        let newpath = buf_new();
        put_region_path(newpath, parent);
        buf_str(newpath, c"::");
        buf_bytes(newpath, SYMS[name].text);
        let old = MODULES[m].name;
        let mut at = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        let mut public = MODULES[m].public;
        for k in 0..REFS.count {
            let r = REFS.data[k];
            if R_DEF.data[r] == dm && user_pos(R_POS.data[r]) {
                at.put(R_POS.data[r] + 1, 1);
            }
        }
        for k in 0..REFS.count {
            let r = REFS.data[k];
            let p = R_POS.data[r];
            if R_DEF.data[r] != dm || !user_pos(p) || !ref_named(p, old) {
                continue;
            }
            let flags = R_FLAGS.data[r];
            if same {
                // (a rename: the name, where it is written)
                put_edit(p, p + SYMS[old].text.len, text_of(SYMS[name].text));
                continue;
            }
            if (flags & QF_DEF) != 0 {
                continue;
            }
            let from = module_at(p);
            if !within(from, parent) {
                public = true;
            }
            chain_public(from, parent);
            if (flags & QF_USE) != 0 {
                use_of_module(p, buf_slice(newpath), old, name);
            } else if qualified(p) {
                put_edit(path_start(p), p + SYMS[old].text.len, text_of(buf_slice(newpath)));
            } else if use_binding(from, old) != dm {
                // (a path from its old parent: `a::f`)
                put_edit(p, p + SYMS[old].text.len, text_of(buf_slice(newpath)));
            }
        }
        if same {
            if public && !MODULES[m].public {
                put_edit(DEFS[dm].start, DEFS[dm].start, text_of(c_slice(c"pub ")));
            }
            return -1;
        }
        // The `super::` paths of its files that lead out of it.
        for f in 0..FILE_COUNT {
            if FILES[f].path[0] != '<' && within(FILES[f].module, m) {
                escaping_supers(f, m, &at);
            }
        }
        // Its `mod` line, from its old parent to its new one.
        let line = buf_new();
        let ts = line_start(text_start(dm));
        let kw = DEFS[dm].start;
        buf_bytes(line, SRC[ts..line_start(kw)]);
        if public {
            buf_str(line, c"pub ");
        }
        buf_str(line, c"mod ");
        buf_bytes(line, SYMS[name].text);
        buf_byte(line, ';');
        delete_lines(ts, DEFS[dm].end);
        if is_new(parent) {
            buf_bytes(NM_MODS.data[parent - module_count()], buf_slice(line));
            buf_byte(NM_MODS.data[parent - module_count()], '\n');
        } else {
            add_mod_line(own_file(parent), buf_slice(line));
        }
        -1
    }
}

// The modules of the path of region r that the code of region from cannot
// see while they are private: made `pub`.
pub fn chain_public(from: i64, r: i64) {
    unsafe {
        let mut x = r;
        while x > 0 {
            let p = region_parent(x);
            if !region_public(x) && !within(from, p) {
                if is_new(x) {
                    NM_PUB.data[x - module_count()] = 1;
                } else if MOD_DEF.data[x] >= 0 && !MODULES[x].public {
                    let dx = MOD_DEF.data[x];
                    MODULES[x].public = true;
                    put_edit(DEFS[dx].start, DEFS[dx].start, text_of(c_slice(c"pub ")));
                }
            }
            x = p;
        }
    }
}

// The import of the module (`use a::m;`) at pos: its path becomes newpath
// (`as old` when its name changes); in a list, the name leaves it for a
// `use` line of its own.
fn use_of_module(pos: i64, newpath: [u8], old: i64, name: i64) {
    unsafe {
        let id = use_id_at(pos);
        let u = use_node_of(id);
        if id == 0 || u == 0 {
            return;
        }
        let text = buf_new();
        buf_bytes(text, newpath);
        if NODES[id].b == 0 && old != name {
            buf_str(text, c" as ");
            buf_bytes(text, SYMS[old].text);
        }
        if NODES[u].count == 1 && !braced(u) {
            put_edit(NODES[NODES[u].c].start, NODES[id].start + SYMS[old].text.len, text);
            return;
        }
        crate::refactor_move::remove_use_names(u, id);
        let line = buf_new();
        buf_str(line, c"\nuse ");
        buf_bytes(line, buf_slice(text));
        if NODES[id].b != 0 {
            buf_str(line, c" as ");
            buf_bytes(line, SYMS[NODES[id].b].text);
        }
        buf_byte(line, ';');
        let at = line_end(NODES[u].end - 1);
        put_edit(at, at, line);
    }
}

// Whether Use node u lists its names between braces.
pub fn braced(u: i64) -> bool {
    unsafe {
        for p in NODES[NODES[u].c].end..NODES[u].end {
            if SRC[p] == '{' {
                return true;
            }
        }
        false
    }
}

// The paths of file f (of module m or one of its children) that start
// with `super::` and lead out of m: written from `crate`. A path that
// goes on to name m itself is left to the reference's rewriting.
fn escaping_supers(f: i64, m: i64, refs_at: *HMap) {
    unsafe {
        let q = FILES[f].module;
        let mut depth = 0;
        let mut x = q;
        while x != m && x >= 0 {
            depth += 1;
            x = MODULES[x].parent;
        }
        let sup = intern(c_slice(c"super"));
        let mut i = token_at(FILES[f].start);
        while i + 1 < TOK_COUNT && TOKS[i].start < FILES[f].end {
            if TOKS[i].kind != Tok::Ident || TOKS[i].value as i64 != sup || TOKS[i + 1].kind != Tok::ColonColon
                || (i > 0 && TOKS[i - 1].kind == Tok::ColonColon) {
                i += 1;
                continue;
            }
            let first = i;
            let mut k = 0;
            let mut target = module_at(TOKS[i].start);
            while i + 1 < TOK_COUNT && TOKS[i].kind == Tok::Ident && TOKS[i].value as i64 == sup
                && TOKS[i + 1].kind == Tok::ColonColon {
                k += 1;
                target = if target >= 0 { MODULES[target].parent } else { -1 };
                i += 2;
            }
            if k <= depth || target < 0 {
                continue;
            }
            // (the rest of the path naming m: left to the reference)
            let mut j = i;
            let mut names_m = false;
            while j + 1 < TOK_COUNT && TOKS[j].kind == Tok::Ident {
                if (*refs_at).get(TOKS[j].start + 1) != 0 {
                    names_m = true;
                }
                if TOKS[j + 1].kind != Tok::ColonColon {
                    break;
                }
                j += 2;
            }
            if names_m {
                continue;
            }
            let text = buf_new();
            buf_bytes(text, SYMS[mod_fqn(target)].text);
            buf_str(text, c"::");
            put_edit(TOKS[first].start, TOKS[i].start, text);
        }
    }
}
