// `#[derive(Eq, Ord, Hash, Debug, Clone)]` (0.15;
// docs/design/errors-formatting.md): before the names are collected, each
// derive of a struct or enum (its `h`, a holder of TyNames) becomes an
// `impl` item appended to the program, whose functions (flagged
// FN_DERIVED, spans the derive attribute's) are syntactic: they call
// std's generic helpers (`cmp_of`, `hash_of`, `clone_of`, `Fmt::debug`),
// so no type is needed to make them. On a generic type each parameter is
// bounded by the trait. Eq makes nothing (structural `==` is the derived
// equality); it checks that every field has `==`.
//
// Phase 0: a stub, which reports derives unimplemented.

use crate::base::diag::{err_begin, err_end_soft, err_str};
use crate::front::ast::{NODES, NodeKind, child};
use crate::front::check::PROGRAM;

// The derives of the program's structs and enums, expanded into impls
// (after the modules are loaded, before collect_names). (Phase 0: each
// is reported, and left out.)
pub fn expand_derives() {
    unsafe {
        for i in 0..NODES[PROGRAM].count {
            let item = child(PROGRAM, i);
            let kind = NODES[item].kind;
            if (kind == NodeKind::Struct || kind == NodeKind::Enum) && NODES[item].h != 0 {
                err_begin(NODES[NODES[item].h].start);
                err_str(c"#[derive] attributes are not implemented yet (check.unimplemented)");
                err_end_soft();
            }
        }
    }
}
