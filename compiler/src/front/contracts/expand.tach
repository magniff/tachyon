// Clauses made into ordinary functions before the names are collected
// (0.18 T1, design §5 "Desugaring"), so that generics, laziness, effects
// and both back ends treat them as any other code:
//
// - `requires`: function f gets a companion `f$pre(?site: i64, <f's
//   parameters>)` in f's module (and impl, generics), whose body checks
//   each clause with `std::contract_check(COND, ?site, CHECK)`. A direct
//   call of f calls it first with the call's site (desugar.tach), so a
//   failure blames the caller.
// - `ensures`: f's body moves to `f$body` (the same signature), and f
//   becomes `{ let ?old1 = e1; ...; let result = f$body(<parameters>);
//   std::contract_check(COND, SITE, CHECK); ...; result }`, so every return
//   of the body (`return`, `?`, the tail) is checked; `old(e)` reads the
//   value e had at entry.
//
// The functions made are flagged FN_DERIVED (the tools leave them out).
// `debug` clauses are made only with --debug-contracts.

use crate::base::{
    BUFS, buf_bytes, buf_clear, buf_new, buf_slice, buf_str, intern, intern_c, sym_text,
};
use crate::base::diag::{err_begin, err_help, err_str};
use crate::front::ast::{
    FN_DERIVED, FN_INLINE, NODES, NodeKind, child, list_begin, list_end, list_push, new_node,
};
use crate::front::check::PROGRAM;
use crate::front::contracts::{
    CLAUSE_COND, CLAUSE_DEBUG, CLAUSE_ENSURES, CLAUSE_KIND, CLAUSE_MESSAGE, CLAUSE_OWNER,
    CLAUSE_POS, CLAUSE_REQUIRES,
};
use crate::front::contracts::checks::{CHK_ENSURES, CHK_REQUIRES, add_check};
use crate::front::contracts::diag::{CONTRACT_RESULT, end_with_code};
use crate::front::contracts::flags::DEBUG_CONTRACTS;
use crate::front::contracts::sites::site_at;
use crate::front::effects::EFFECTS_WANTED;
use crate::front::generics::instantiate::{clone_node, node_field_a, node_field_b, node_field_c};
use crate::front::types::FNS;
use crate::middle::lower::ssa::HMap;

// Fn node + 1 -> its `$pre` companion's Fn node (0: none).
pub static mut PRE_OF: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
// Whether any function has a requires (desugar_call looks at calls only
// then).
pub static mut ANY_REQUIRES: bool = false;

static mut NAME_BUF: i64 = -1;
static mut SYM_STD: i64 = 0;
static mut SYM_CHECK: i64 = 0;
static mut SYM_RESULT: i64 = 0;
static mut SYM_OLD: i64 = 0;
static mut SYM_SITE: i64 = 0;
static mut SYM_I64: i64 = 0;
static mut SYM_SELF_TYPE: i64 = 0;

fn words() {
    unsafe {
        if SYM_STD != 0 {
            return;
        }
        SYM_STD = intern_c(c"std");
        SYM_CHECK = intern_c(c"contract_check");
        SYM_RESULT = intern_c(c"result");
        SYM_OLD = intern_c(c"old");
        SYM_SITE = intern_c(c"?site");
        SYM_I64 = intern_c(c"i64");
        SYM_SELF_TYPE = intern_c(c"Self");
        NAME_BUF = buf_new();
    }
}

// Whether clause k is made in this build (a `debug` one only with
// --debug-contracts).
pub fn clause_on(k: i64) -> bool {
    unsafe { (CLAUSE_KIND.data[k] & CLAUSE_DEBUG) == 0 || DEBUG_CONTRACTS }
}

// (0.18, with 0.17's values) Whether function f (an instance's template
// too) is a `$pre` companion: its parameters are the call's arguments,
// read in place, never moved or dropped (front/own: walk::eval_call,
// drops::param_drops).
pub fn is_pre_fn(f: i64) -> bool {
    unsafe {
        if f < 0 || !ANY_REQUIRES {
            return false;
        }
        let t = if FNS[f].tmpl > 0 { FNS[f].tmpl - 1 } else { f };
        let name = sym_text(FNS[t].name);
        name.len >= 4 && name[name.len - 4..name.len] == "$pre"
    }
}

// (0.18, with 0.17's values) The call a requires check wraps when block n
// is one (desugar::requires_call: `{ let ?aI = ..; f$pre(..); f(..) }`),
// else 0: the own pass sees through it to the call.
pub fn requires_tail(n: i64) -> i64 {
    unsafe {
        if n <= 0 || !ANY_REQUIRES || NODES[n].kind != NodeKind::Block || NODES[n].count == 0 {
            return 0;
        }
        let tail = NODES[n].a;
        let last = child(n, NODES[n].count - 1);
        if tail <= 0 || NODES[tail].kind != NodeKind::Call || NODES[last].kind != NodeKind::ExprStmt
            || NODES[NODES[last].a].kind != NodeKind::Call
            || !is_pre_fn(NODES[NODES[last].a].x - 1) {
            return 0;
        }
        tail
    }
}

// `name` + `suffix`, a symbol.
fn suffixed(name: i64, suffix: *u8) -> i64 {
    unsafe {
        buf_clear(NAME_BUF);
        buf_bytes(NAME_BUF, sym_text(name));
        buf_str(NAME_BUF, suffix);
        intern(buf_slice(NAME_BUF))
    }
}

fn ident(sym: i64, pos: i64) -> i64 {
    let n = new_node(NodeKind::Ident, pos, pos);
    unsafe { NODES[n].a = sym; }
    n
}

fn int_lit(value: i64, pos: i64) -> i64 {
    let n = new_node(NodeKind::Int, pos, pos);
    unsafe { NODES[n].a = value; }
    n
}

fn expr_stmt(e: i64) -> i64 {
    unsafe {
        let s = new_node(NodeKind::ExprStmt, NODES[e].start, NODES[e].end);
        NODES[s].a = e;
        NODES[s].b = 1;
        s
    }
}

fn let_stmt(sym: i64, init: i64, pos: i64) -> i64 {
    unsafe {
        let bind = new_node(NodeKind::PatBind, pos, pos);
        NODES[bind].a = sym;
        let s = new_node(NodeKind::Let, pos, pos);
        NODES[s].a = bind;
        NODES[s].c = init;
        s
    }
}

// `std::contract_check(cond, site, check)`, with the holes of an f-string
// `message` (at most three) after them.
fn check_call(cond: i64, site: i64, check: i64, message: i64) -> i64 {
    unsafe {
        let pos = NODES[cond].start;
        let path = new_node(NodeKind::Path, pos, pos);
        NODES[path].a = SYM_STD;
        NODES[path].b = SYM_CHECK;
        let call = new_node(NodeKind::Call, NODES[cond].start, NODES[cond].end);
        NODES[call].a = path;
        let mark = list_begin();
        list_push(cond);
        list_push(site);
        list_push(int_lit(check, pos));
        if message != 0 && NODES[message].kind == NodeKind::Interp {
            let mut holes = 0;
            for i in 0..NODES[message].count {
                let piece = child(message, i);
                if NODES[piece].kind == NodeKind::InterpHole && holes < 3 {
                    list_push(clone_node(NODES[piece].a));
                    holes += 1;
                }
            }
        }
        list_end(call, mark);
        call
    }
}

// The clauses expanded, before the names are collected (check_program).
pub fn expand_contracts() {
    unsafe {
        if CLAUSE_OWNER.count == 0 {
            return;
        }
        words();
        // (the conditions' purity is checked on the inferred effects)
        EFFECTS_WANTED = true;
        let program = PROGRAM;
        let made = list_begin();
        for i in 0..NODES[program].count {
            let f = child(program, i);
            if NODES[f].kind != NodeKind::Fn || NODES[f].c == 0 {
                continue;
            }
            let mut requires = 0;
            let mut ensures = 0;
            for k in 0..CLAUSE_OWNER.count {
                if CLAUSE_OWNER.data[k] == f && clause_on(k) {
                    let kind = CLAUSE_KIND.data[k] & ~CLAUSE_DEBUG;
                    if kind == CLAUSE_REQUIRES {
                        requires += 1;
                    } else if kind == CLAUSE_ENSURES {
                        ensures += 1;
                    }
                }
            }
            if requires > 0 {
                no_result(f);
                let pre = make_pre(f);
                list_push(pre);
                PRE_OF.put(f + 1, pre);
                ANY_REQUIRES = true;
            }
            if ensures > 0 {
                let body = make_body(f);
                if body != 0 {
                    list_push(body);
                }
            }
        }
        let count = crate::front::ast::SCRATCH.count - made;
        if count == 0 {
            crate::front::ast::SCRATCH.count = made;
            return;
        }
        // The program's items, then the functions made.
        let extra = crate::base::alloc_array::<i64>(count);
        for j in 0..count {
            extra[j] = crate::front::ast::SCRATCH.data[made + j];
        }
        crate::front::ast::SCRATCH.count = made;
        let all = list_begin();
        for i in 0..NODES[program].count {
            list_push(child(program, i));
        }
        for j in 0..count {
            list_push(extra[j]);
        }
        list_end(program, all);
    }
}

// `result` in a requires: contract.result.
fn no_result(f: i64) {
    unsafe {
        for k in 0..CLAUSE_OWNER.count {
            if CLAUSE_OWNER.data[k] == f
                && (CLAUSE_KIND.data[k] & ~CLAUSE_DEBUG) == CLAUSE_REQUIRES {
                let r = find_ident(CLAUSE_COND.data[k], SYM_RESULT);
                if r != 0 {
                    err_begin(NODES[r].start);
                    err_str(c"'result' is the returned value, which a 'requires' does not see");
                    err_help(c"a requires holds when the function is entered: state it on the parameters, or move it to an 'ensures'");
                    end_with_code(CONTRACT_RESULT);
                }
            }
        }
    }
}

// An Ident node named `sym` in the tree at n (not inside closures), or 0.
fn find_ident(n: i64, sym: i64) -> i64 {
    unsafe {
        if n == 0 {
            return 0;
        }
        let kind = NODES[n].kind;
        if kind == NodeKind::Ident {
            return if NODES[n].a == sym { n } else { 0 };
        }
        if kind == NodeKind::Closure || kind == NodeKind::Fn {
            return 0;
        }
        for k in 0..3 {
            let e = subtree(n, k);
            if e > 0 {
                let r = find_ident(e, sym);
                if r != 0 {
                    return r;
                }
            }
        }
        for i in 0..NODES[n].count {
            let r = find_ident(child(n, i), sym);
            if r != 0 {
                return r;
            }
        }
        0
    }
}

// The children of node n that are subtrees (a, b, c by the node's kind,
// as clone_node copies them): k from 0 to 2; -1 for none.
pub fn subtree(n: i64, k: i64) -> i64 {
    unsafe {
        let kind = NODES[n].kind;
        if k == 0 {
            return if node_field_a(kind) { NODES[n].a } else { -1 };
        }
        if k == 1 {
            return if node_field_b(kind) { NODES[n].b } else { -1 };
        }
        if node_field_c(kind) { NODES[n].c } else { -1 }
    }
}

// A copy of f's signature as a new function named `name` (the same
// generics, impl, flags and module; no effect declarations), with
// `first` (a Param node, or 0) before f's parameters and `extra` (or 0)
// after them.
fn signature_copy(f: i64, name: i64, first: i64, extra: i64) -> i64 {
    unsafe {
        let g = new_node(NodeKind::Fn, NODES[f].start, NODES[f].end);
        NODES[g] = NODES[f];
        NODES[g].a = name;
        NODES[g].b = clone_node(NODES[f].b);
        NODES[g].c = 0;
        NODES[g].g = clone_node(NODES[f].g);
        NODES[g].z = 0;
        NODES[g].x = 0;
        NODES[g].y = 0;
        NODES[g].ty = 0;
        NODES[g].p = NODES[f].p | FN_DERIVED;
        let mark = list_begin();
        if first != 0 {
            list_push(first);
        }
        for i in 0..NODES[f].count {
            let p = clone_node(child(f, i));
            // (a default is the call's: the arguments come normalized)
            NODES[p].h = 0;
            list_push(p);
        }
        if extra != 0 {
            list_push(extra);
        }
        list_end(g, mark);
        g
    }
}

// f's `$pre` companion: `fn f$pre(?site: i64, <params>) { checks }`.
fn make_pre(f: i64) -> i64 {
    unsafe {
        let pos = NODES[f].start;
        let site = new_node(NodeKind::Param, pos, pos);
        NODES[site].a = SYM_SITE;
        let ty = new_node(NodeKind::TyName, pos, pos);
        NODES[ty].a = SYM_I64;
        NODES[site].b = ty;
        let pre = signature_copy(f, suffixed(NODES[f].a, c"$pre"), site, 0);
        NODES[pre].b = 0;
        NODES[pre].p |= FN_INLINE;
        let body = new_node(NodeKind::Block, pos, pos);
        let mark = list_begin();
        for k in 0..CLAUSE_OWNER.count {
            if CLAUSE_OWNER.data[k] == f && clause_on(k)
                && (CLAUSE_KIND.data[k] & ~CLAUSE_DEBUG) == CLAUSE_REQUIRES
                && find_ident(CLAUSE_COND.data[k], SYM_RESULT) == 0 {
                let check = add_check(CHK_REQUIRES, CLAUSE_COND.data[k], CLAUSE_MESSAGE.data[k], f,
                    CLAUSE_POS.data[k]);
                let cond = clone_node(CLAUSE_COND.data[k]);
                list_push(expr_stmt(check_call(cond, ident(SYM_SITE, NODES[cond].start), check,
                    CLAUSE_MESSAGE.data[k])));
            }
        }
        list_end(body, mark);
        NODES[pre].c = body;
        pre
    }
}

// f's ensures: its body moved to `f$body`, which it calls and checks the
// result of. Returns the new function (0: none made).
fn make_body(f: i64) -> i64 {
    unsafe {
        let ret = NODES[f].b;
        let unit = ret == 0 || NODES[ret].kind == NodeKind::TyUnit;
        if ret != 0 && NODES[ret].kind == NodeKind::TyNever {
            return 0;
        }
        let pos = NODES[f].start;
        let inner = signature_copy(f, suffixed(NODES[f].a, c"$body"), 0, 0);
        NODES[inner].c = NODES[f].c;
        // The call of the body: f$body(<params>), Self::f$body(..) in an impl,
        // with f's own type parameters written.
        let call = new_node(NodeKind::Call, pos, pos);
        let mut own = 0;
        let g = NODES[f].g;
        if g != 0 && NODES[g].count > NODES[g].a {
            own = new_node(NodeKind::Generics, pos, pos);
            let gm = list_begin();
            for i in NODES[g].a..NODES[g].count {
                let t = new_node(NodeKind::TyName, pos, pos);
                NODES[t].a = NODES[child(g, i)].a;
                list_push(t);
            }
            list_end(own, gm);
        }
        if NODES[f].h != 0 {
            let path = new_node(NodeKind::Path, pos, pos);
            NODES[path].a = SYM_SELF_TYPE;
            NODES[path].b = NODES[inner].a;
            NODES[path].h = own;
            NODES[call].a = path;
        } else {
            let callee = ident(NODES[inner].a, pos);
            NODES[callee].g = own;
            NODES[call].a = callee;
        }
        let am = list_begin();
        for i in 0..NODES[f].count {
            list_push(ident(NODES[child(f, i)].a, pos));
        }
        list_end(call, am);
        let block = new_node(NodeKind::Block, NODES[NODES[f].c].start, NODES[NODES[f].c].end);
        let mark = list_begin();
        let mut olds = 0;
        // (the checks first, apart: their `old(e)` become lets before the call)
        let check_mark = list_begin();
        for k in 0..CLAUSE_OWNER.count {
            if CLAUSE_OWNER.data[k] == f && clause_on(k)
                && (CLAUSE_KIND.data[k] & ~CLAUSE_DEBUG) == CLAUSE_ENSURES {
                if unit {
                    let r = find_ident(CLAUSE_COND.data[k], SYM_RESULT);
                    if r != 0 {
                        err_begin(NODES[r].start);
                        err_str(c"'result' in an 'ensures' of a function that returns nothing");
                        err_help(
                            c"state the promise on what the function changes, or return a value");
                        end_with_code(CONTRACT_RESULT);
                        continue;
                    }
                }
                let check = add_check(CHK_ENSURES, CLAUSE_COND.data[k], CLAUSE_MESSAGE.data[k], f,
                    CLAUSE_POS.data[k]);
                let cond = clone_node(CLAUSE_COND.data[k]);
                let site = int_lit(site_at(CLAUSE_POS.data[k]), NODES[cond].start);
                list_push(expr_stmt(check_call(cond, site, check, CLAUSE_MESSAGE.data[k])));
            }
        }
        let check_count = crate::front::ast::SCRATCH.count - check_mark;
        let stmts = crate::base::alloc_array::<i64>(check_count + 1);
        for j in 0..check_count {
            stmts[j] = crate::front::ast::SCRATCH.data[check_mark + j];
        }
        crate::front::ast::SCRATCH.count = check_mark;
        // old(e): `let ?oldN = e;` at entry.
        for j in 0..check_count {
            olds = replace_olds(stmts[j], olds);
        }
        if unit {
            list_push(expr_stmt(call));
        } else {
            list_push(let_stmt(SYM_RESULT, call, pos));
        }
        for j in 0..check_count {
            list_push(stmts[j]);
        }
        list_end(block, mark);
        if !unit {
            NODES[block].a = ident(SYM_RESULT, pos);
        }
        NODES[f].c = block;
        inner
    }
}

// The `old(e)` calls in the tree at n replaced by `?oldN`, each with its
// `let ?oldN = e;` pushed to the list being built; returns the count.
fn replace_olds(n: i64, count: i64) -> i64 {
    unsafe {
        if n == 0 {
            return count;
        }
        let kind = NODES[n].kind;
        if kind == NodeKind::Closure || kind == NodeKind::Fn {
            return count;
        }
        let mut c = count;
        if kind == NodeKind::Call && NODES[n].count == 1 {
            let callee = NODES[n].a;
            if NODES[callee].kind == NodeKind::Ident && NODES[callee].a == SYM_OLD {
                let e = child(n, 0);
                c = replace_olds(e, c);
                buf_clear(NAME_BUF);
                buf_str(NAME_BUF, c"?old");
                crate::base::buf_int(NAME_BUF, c);
                let sym = intern(buf_slice(NAME_BUF));
                list_push(let_stmt(sym, e, NODES[n].start));
                let start = NODES[n].start;
                let end = NODES[n].end;
                NODES[n] = NODES[callee];
                NODES[n].kind = NodeKind::Ident;
                NODES[n].a = sym;
                NODES[n].start = start;
                NODES[n].end = end;
                NODES[n].count = 0;
                NODES[n].list = 0;
                return c + 1;
            }
        }
        for k in 0..3 {
            let e = subtree(n, k);
            if e > 0 {
                c = replace_olds(e, c);
            }
        }
        for i in 0..NODES[n].count {
            c = replace_olds(child(n, i), c);
        }
        c
    }
}
