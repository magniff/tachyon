// The clauses as checked AST (0.18 T1, design §5 "Desugaring"): a direct
// call's requires checked at the call, each return's ensures, the
// invariant at a module's boundary. Both back ends then lower the checks
// through `lower_check` with the site's number. Phase 0: no-ops.

// A direct call `n` of a function with requires: the arguments bound to
// temporaries, the clauses checked, then the call.
pub fn desugar_call(n: i64) -> i64 {
    n
}

// A `return` (or a tail, or `?`'s return) `n` of a function with ensures.
pub fn desugar_return(n: i64) -> i64 {
    n
}

// The boundary checks of function `f` of a module whose type has an
// invariant.
pub fn desugar_boundary(f: i64) {}
