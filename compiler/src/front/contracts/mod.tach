// Contracts (0.18, docs/design/contracts-verification.md §2.1-§2.3,
// §2.10): what the parser read of `requires`, `ensures` and `invariant`
// clauses, `type X = distinct T`, and the test attributes, kept in side
// tables keyed by the item's node, so that the AST's Node is unchanged.
// Phase 0: read and kept, not checked (`check_contracts` is T1's; the
// test items are T2's; distinct types T4's).

pub mod checks;
pub mod expand;
pub mod desugar;
pub mod sites;
pub mod diag;
pub mod flags;

use crate::base::{IntVec, buf_fmt, buf_new, buf_slice, cstr, free, sym_text};
use crate::base::diag::{err_begin, err_fmt, err_help, err_str, err_try_tool};
use crate::front::ast::{NODES, NodeKind, child};
use crate::front::check::Res;
use crate::front::contracts::checks::{
    CHECK_FN, CHECK_KIND, CHECK_OWNER, CHK_ENSURES, CHK_INVARIANT, CHK_REQUIRES,
};
use crate::front::contracts::diag::{CONTRACT_EFFECT, end_with_code};
use crate::front::contracts::expand::subtree;
use crate::front::effects::{
    ALLOC_ANY, EFF_GLOBAL, EFF_IO, EFF_UNKNOWN, FN_EFFECTS_COUNT, fn_effects,
};
use crate::front::types::FNS;

// A clause's kind (CLAUSE_KIND), with CLAUSE_DEBUG for `debug requires ...`.
pub const CLAUSE_REQUIRES: i64 = 1;
pub const CLAUSE_ENSURES: i64 = 2;
pub const CLAUSE_INVARIANT: i64 = 3;
pub const CLAUSE_DEBUG: i64 = 16;

// The clauses, in source order: the item (a Fn, Struct, Enum or TypeAlias
// node), the kind, the condition (an expression node, not checked in
// Phase 0), the `else` message (a Str or Interp node, or 0), the position
// of the clause's first word.
pub static mut CLAUSE_OWNER: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut CLAUSE_KIND: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut CLAUSE_COND: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut CLAUSE_MESSAGE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut CLAUSE_POS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The TypeAlias nodes written `type X = distinct T` (§2.10). Phase 0: a
// distinct type is checked as a transparent alias (T4 makes it distinct).
pub static mut DISTINCT_ALIASES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The test items (§2.6-§2.8): the node and its kind (TEST_FN for
// `#[test]`, TEST_PROPERTY, TEST_FUZZ, TEST_CFG for an item under
// `#[cfg(test)]`). Phase 0: they are compiled as ordinary items (T2 leaves
// them out of builds that are not tests, and scopes test modules).
pub const TEST_FN: i64 = 1;
pub const TEST_PROPERTY: i64 = 2;
pub const TEST_FUZZ: i64 = 3;
pub const TEST_CFG: i64 = 4;
pub static mut TEST_ITEM: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut TEST_KIND: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

pub fn add_clause(owner: i64, kind: i64, cond: i64, message: i64, pos: i64) {
    unsafe {
        CLAUSE_OWNER.push(owner);
        CLAUSE_KIND.push(kind);
        CLAUSE_COND.push(cond);
        CLAUSE_MESSAGE.push(message);
        CLAUSE_POS.push(pos);
    }
}

// How many clauses item `owner` has.
pub fn clause_count(owner: i64) -> i64 {
    let mut n = 0;
    unsafe {
        for i in 0..CLAUSE_OWNER.count {
            if CLAUSE_OWNER.data[i] == owner {
                n += 1;
            }
        }
    }
    n
}

pub fn mark_distinct(alias: i64) {
    unsafe {
        DISTINCT_ALIASES.push(alias);
    }
}

pub fn is_distinct(alias: i64) -> bool {
    unsafe {
        for i in 0..DISTINCT_ALIASES.count {
            if DISTINCT_ALIASES.data[i] == alias {
                return true;
            }
        }
    }
    false
}

pub fn add_test_item(item: i64, kind: i64) {
    unsafe {
        TEST_ITEM.push(item);
        TEST_KIND.push(kind);
    }
}

// The test kind of an item (TEST_FN, ...), or 0. An item under
// `#[cfg(test)]` that is also `#[test]` answers TEST_FN.
pub fn test_kind(item: i64) -> i64 {
    let mut kind = 0;
    unsafe {
        for i in 0..TEST_ITEM.count {
            if TEST_ITEM.data[i] == item && (kind == 0 || kind == TEST_CFG) {
                kind = TEST_KIND.data[i];
            }
        }
    }
    kind
}

// The clauses checked (T1): each condition pure (no alloc, io or global:
// a passing check must not change what the program does, and turning
// `debug` clauses on and off must not either), from the inferred effects
// of what it calls (contract.effect). Called by check_program after the
// effects. (The conditions' types and names were checked with the
// functions expand.tach made of them.)
pub fn check_contracts() {
    unsafe {
        if CHECK_CALLS.count == 0 || FN_EFFECTS_COUNT == 0 {
            return;
        }
        let mut seen = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..CHECK_CALLS.count {
            let call = CHECK_CALLS.data[i];
            if NODES[call].count < 3 {
                continue;
            }
            let check = NODES[child(call, 2)].a;
            if check < 0 || check >= CHECK_KIND.count
                || (0..seen.count).any(|j| seen.data[j] == check) {
                continue;
            }
            let kind = CHECK_KIND.data[check];
            if kind != CHK_REQUIRES && kind != CHK_ENSURES && kind != CHK_INVARIANT {
                continue;
            }
            if impure(child(call, 0), check) {
                seen.push(check);
            }
        }
        free(seen.data as *u8);
    }
}

// The calls of std::contract_check made from clauses, once checked
// (desugar_call), for check_contracts.
pub static mut CHECK_CALLS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Whether the condition at n (of check `check`) does io, allocates or
// touches a static; reported once.
fn impure(n: i64, check: i64) -> bool {
    unsafe {
        if n <= 0 {
            return false;
        }
        let kind = NODES[n].kind;
        if kind == NodeKind::Closure {
            return false;
        }
        if kind == NodeKind::Ident && NODES[n].res == Res::Static {
            effect_error(n, check, -1, EFF_GLOBAL);
            return true;
        }
        if kind == NodeKind::Call && NODES[n].x > 0 {
            let f = NODES[n].x - 1;
            let e = fn_effects(f);
            // (not inferred: a function that failed, a template checked with
            // errors in a query; not reported)
            if (e.bits & EFF_UNKNOWN) != 0 || e.allocs == ALLOC_ANY {
                return false;
            }
            let bad = if e.allocs != 0 { -2 } else if (e.bits & EFF_IO) != 0 { EFF_IO }
                else if (e.bits & EFF_GLOBAL) != 0 { EFF_GLOBAL } else { 0 };
            if bad != 0 && f != CHECK_FN {
                effect_error(n, check, f, bad);
                return true;
            }
        }
        for k in 0..3 {
            if impure(subtree(n, k), check) {
                return true;
            }
        }
        for i in 0..NODES[n].count {
            if impure(child(n, i), check) {
                return true;
            }
        }
        false
    }
}

// contract.effect at node n, a call of f (-1: a static read) that has
// effect `bit` (-2: alloc).
fn effect_error(n: i64, check: i64, f: i64, bit: i64) {
    unsafe {
        let what = if bit == -2 { c"allocates" } else if bit == EFF_IO { c"does io" }
            else { c"touches a static" };
        let word = if CHECK_KIND.data[check] == CHK_REQUIRES { c"requires" }
            else if CHECK_KIND.data[check] == CHK_ENSURES { c"ensures" } else { c"invariant" };
        let owner = CHECK_OWNER.data[check];
        err_begin(NODES[n].start);
        err_fmt(f"the '{cstr(word)}' of '{sym_text(NODES[owner].a)}' ");
        if f >= 0 {
            err_fmt(f"calls '{sym_text(FNS[f].display)}', which {cstr(what)}");
        } else {
            err_fmt(f"reads the static '{sym_text(NODES[n].a)}'");
        }
        err_str(c": a condition may not do io, allocate or touch statics");
        err_help(c"a check that passes must not change what the program does: compute the value in the body, or check it with assert there");
        if f >= 0 {
            let effect = if bit == -2 { "alloc" } else if bit == EFF_IO { "io" } else { "global" };
            let t = buf_new();
            buf_fmt(t, f"query effects {sym_text(FNS[f].display)} --why {effect}");
            err_try_tool(buf_slice(t), true);
        }
        end_with_code(CONTRACT_EFFECT);
    }
}
