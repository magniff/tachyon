// The compiler's options of 0.18 (design §2.1, §2.8, §4.3), read by main's
// option loop through `option018`.

use crate::base::{die2, streq};

// `--debug-contracts`: `debug` clauses and `debug_assert` checked (T1;
// test builds turn it on).
pub static mut DEBUG_CONTRACTS: bool = false;
// `-j N` (`-jN`): code generation on N threads (T7). Phase 0: read, and
// the compiler runs on one.
pub static mut JOBS: i64 = 1;

// How many of argv[i..] option `argv[i]` takes when it is one of 0.18's
// (1 or 2), or 0.
pub fn option018(argv: **u8, i: i64, argc: i64) -> i64 {
    unsafe {
        let arg = argv[i];
        if streq(arg, c"--debug-contracts") {
            DEBUG_CONTRACTS = true;
            return 1;
        }
        if streq(arg, c"--test-build") {
            // (T2: the tests, with a test main; what `tachyonc test` builds)
            crate::front::tests::TEST_BUILD = true;
            return 1;
        }
        if streq(arg, c"--coverage") {
            // (T3: an 8-bit counter per CFG edge, for `tachyonc fuzz`)
            die2(c"--coverage is 0.18's (T3), not implemented yet: ", arg);
        }
        if arg[0] == '-' && arg[1] == 'j' {
            if arg[2] != 0 {
                JOBS = jobs_count(&arg[2]);
                return 1;
            }
            if i + 1 >= argc {
                die2(c"-j takes a number of threads: ", arg);
            }
            JOBS = jobs_count(argv[i + 1]);
            return 2;
        }
        0
    }
}

fn jobs_count(s: *u8) -> i64 {
    unsafe {
        let mut n = 0;
        let mut k = 0;
        while s[k] >= '0' && s[k] <= '9' && n < 1024 {
            n = n * 10 + (s[k] - '0') as i64;
            k += 1;
        }
        if k == 0 || s[k] != 0 || n < 1 {
            die2(c"-j takes a number of threads (1 or more), not: ", s);
        }
        n
    }
}
