// The diagnostic codes of 0.18 (design §2.14), with their `explain`
// entries in tools/explain/v018_table.tach. Each task reports its own
// through these names, so that the codes and their entries stay one list.

pub const CONTRACT_EFFECT: *u8 = c"contract.effect";
pub const CONTRACT_OLD: *u8 = c"contract.old";
pub const CONTRACT_RESULT: *u8 = c"contract.result";
pub const CONTRACT_VIOLATED: *u8 = c"contract.violated";
pub const CONTRACT_SEALED: *u8 = c"contract.sealed";
pub const CONTRACT_IMPL_REQUIRES: *u8 = c"contract.impl-requires";
pub const DISTINCT_MIX: *u8 = c"distinct.mix";
pub const DISTINCT_METHOD: *u8 = c"distinct.method";
pub const DISTINCT_KIND: *u8 = c"distinct.kind";
pub const TEST_SIGNATURE: *u8 = c"test.signature";
pub const TEST_GENERATE: *u8 = c"test.generate";
pub const IMPORT_WILDCARD: *u8 = c"import.wildcard";
pub const MACRO_ARGS: *u8 = c"macro.args";
