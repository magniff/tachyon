        buf_str(out, c"// ---- Text: String (0.20) ----\n\n// UTF-8 text that owns its bytes, on allocator A (Rust's String):\n// `String::new_in(gpa)`, `s.push_str(\"..\")`, `s.push_fmt(f\"..\")`. It has\n// its `str`'s methods (`s.trim()`, `s.split(',')`: the compiler calls\n// them on `s.as_str()`), and `&s` goes where a `str` or `[u8]` does.\n// (its bytes are std's: #[sealed] keeps other code from changing them)\n#[sealed]\npub struct String<A: Allocator = Gpa> { pub bytes: Vec<u8, A> }\n\nimpl<A: Allocator> String<A> {\n    pub fn new_in(a: sink A) -> String<A> {\n        String { bytes: Vec::new_in(a) }\n    }\n\n    pub fn with_capacity_in(cap: i64, a: sink A) -> String<A> {\n        String { bytes: Vec::with_capacity_in(cap, a) }\n    }\n\n    // A String of s's text (Rust's `String::from(s)`).\n    pub fn from_in(s: str, a: sink A) -> String<A> {\n        let b = s as [u8];\n        var v: Vec<u8, A> = Vec::with_capacity_in(b.len, a);\n        v.extend_from_slice(b);\n        String { bytes: v }\n    }\n\n    // The String of bytes v when they are UTF-8 (they are dropped when not).\n    pub fn from_utf8(v: sink Vec<u8, A>) -> Result<String<A>, Utf8Error> {\n        match validate_utf8(v.as_slice()) {\n            Result::Ok(_) => Result::Ok(String { bytes: v }),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n\n    // The String of Buf b's bytes when they are UTF-8.\n    pub fn from_buf(b: sink Buf<A>) -> Result<String<A>, Utf8Error> {\n        var b = b;\n        let v = b.bytes.take();\n        String::from_utf8(v)\n    }\n\n    // The text of bytes b, U+FFFD in place of what is not UTF-8 (each\n    // maximal subpart, as Rust's from_utf8_lossy).\n    pub fn from_utf8_lossy_in(b: [u8], a: sink A) -> String<A> {\n        var out: String<A> = String::with_capacity_in(b.len, a);\n        var i = 0;\n        while i < b.len {\n            let start = i;\n            while i < b.len && b[i] < 0x80 {\n                i += 1;\n            }\n");
        buf_str(out, c"            out.bytes.extend_from_slice(b[start..i]);\n            if i < b.len {\n                let cp = lossy_next(b, &i);\n                out.push(cp);\n            }\n        }\n        out\n    }\n\n    #[inline]\n    pub fn len(self) -> i64 {\n        self.bytes.len\n    }\n\n    #[inline]\n    pub fn is_empty(self) -> bool {\n        self.bytes.len == 0\n    }\n\n    pub fn capacity(self) -> i64 {\n        self.bytes.capacity()\n    }\n\n    pub fn reserve(inout self, extra: i64) {\n        self.bytes.reserve(extra);\n    }\n\n    pub fn clear(inout self) {\n        self.bytes.clear();\n    }\n\n    // The text, a view (valid until the String changes).\n    #[inline]\n    pub fn as_str(self) -> str {\n        self.bytes.as_slice() as str\n    }\n\n    #[inline]\n    pub fn as_bytes(self) -> [u8] {\n        self.bytes.as_slice()\n    }\n\n    // Its bytes, as a Buf's `as_slice`.\n    #[inline]\n    pub fn as_slice(self) -> [u8] {\n        self.bytes.as_slice()\n    }\n\n    // Appends code point cp (U+FFFD for one that is not a scalar value).\n    pub fn push(inout self, cp: u32) {\n        if cp < 0x80 {\n            self.bytes.push(cp as u8);\n            return;\n        }\n        var buf: [u8; 4] = [0; 4];\n        let n = encode_utf8(cp, &buf);\n        self.bytes.extend_from_slice(buf[..n]);\n    }\n\n    // Appends s (`s.push_str(f\"..\")` writes the f-string in place).\n    #[inline]\n    pub fn push_str(inout self, s: str) {\n        self.bytes.extend_from_slice(s as [u8]);\n    }\n\n    // Appends x's Display: `s.push_fmt(f\"{k}={v};\")`.\n    pub fn push_fmt<T: Display>(inout self, x: sink T) {\n        var f = std::fmt::fmt_to_vec(&self.bytes);\n        loop {\n            x.fmt(&f);\n            if std::fmt::fmt_end_vec(&self.bytes, &f) {\n                return;\n            }\n        }\n    }\n\n    // The last code point, removed.\n    pub fn pop(inout self) -> Option<u32> {\n        let n = self.bytes.len;\n        if n == 0 {\n");
        buf_str(out, c"            return Option::None;\n        }\n        let (cp, k) = cp_before(self.bytes.as_slice(), n);\n        self.bytes.truncate(n - k);\n        Option::Some(cp)\n    }\n\n    // Keeps the first n bytes; n must be a char boundary.\n    pub fn truncate(inout self, n: i64) {\n        if n < self.bytes.len {\n            if !is_char_boundary(self.bytes.as_slice(), n) {\n                std::panic_str(\"String::truncate: not a char boundary\");\n            }\n            self.bytes.truncate(n);\n        }\n    }\n\n    // Inserts s at byte index i (a char boundary).\n    pub fn insert_str(inout self, i: i64, s: str) {\n        let b = s as [u8];\n        let len = self.bytes.len;\n        if i < 0 || i > len || !is_char_boundary(self.bytes.as_slice(), i) {\n            std::panic_str(\"String::insert_str: not a char boundary\");\n        }\n        for k in 0..b.len {\n            self.bytes.push(0);\n        }\n        let all = self.bytes.as_mut_slice();\n        var j = len;\n        while j > i {\n            j -= 1;\n            all[j + b.len] = all[j];\n        }\n        for k in 0..b.len {\n            all[i + k] = b[k];\n        }\n    }\n\n    // Inserts code point cp at byte index i.\n    pub fn insert(inout self, i: i64, cp: u32) {\n        var buf: [u8; 4] = [0; 4];\n        let n = encode_utf8(cp, &buf);\n        let t = buf[..n];\n        self.insert_str(i, t as str);\n    }\n\n    // Removes the code point at byte index i, returning it.\n    pub fn remove(inout self, i: i64) -> u32 {\n        let len = self.bytes.len;\n        if i < 0 || i >= len || !is_char_boundary(self.bytes.as_slice(), i) {\n            std::panic_str(\"String::remove: not a char boundary\");\n        }\n        let (cp, n) = cp_at(self.bytes.as_slice(), i);\n        let all = self.bytes.as_mut_slice();\n        for j in i..len - n {\n            all[j] = all[j + n];\n        }\n        self.bytes.truncate(len - n);\n        cp\n    }\n\n");
        buf_str(out, c"    // Keeps the code points f is true for.\n    pub fn retain<F: FnMut(u32) -> bool>(inout self, f: F) {\n        var f = f;\n        let len = self.bytes.len;\n        var w = 0;\n        var i = 0;\n        while i < len {\n            let (cp, n) = cp_at(self.bytes.as_slice(), i);\n            if f(cp) {\n                let all = self.bytes.as_mut_slice();\n                for k in 0..n {\n                    all[w + k] = all[i + k];\n                }\n                w += n;\n            }\n            i += n;\n        }\n        self.bytes.truncate(w);\n    }\n\n    // Its bytes, as a Vec (the String is gone).\n    pub fn into_bytes(sink self) -> Vec<u8, A> {\n        var s = self;\n        s.bytes.take()\n    }\n\n    // Its bytes, as a Buf.\n    pub fn into_buf(sink self) -> Buf<A> {\n        var s = self;\n        Buf { bytes: s.bytes.take() }\n    }\n\n    pub fn allocator(self) -> A {\n        self.bytes.allocator()\n    }\n}\n\nimpl<A: Allocator + Ambient> String<A> {\n    #[ambient(\"String::new_in(gpa)\")]\n    pub fn new() -> String<A> {\n        String { bytes: Vec::new_in(A::ambient()) }\n    }\n\n    #[ambient(\"String::with_capacity_in(cap, gpa)\")]\n    pub fn with_capacity(cap: i64) -> String<A> {\n        String { bytes: Vec::with_capacity_in(cap, A::ambient()) }\n    }\n\n    #[ambient(\"String::from_in(s, gpa)\")]\n    pub fn from(s: str) -> String<A> {\n        String::from_in(s, A::ambient())\n    }\n}\n\nimpl<A: Allocator> Display for String<A> {\n    fn fmt(self, f: inout Fmt) {\n        f.str(self.bytes.as_slice());\n    }\n}\n\nimpl<A: Allocator> Debug for String<A> {\n    fn fmt_debug(self, f: inout Fmt) {\n        let s = self.bytes.as_slice();\n        s.fmt_debug(&f);\n    }\n}\n\nimpl<A: Allocator> Eq for String<A> {\n    fn eq(self, other: String<A>) -> bool {\n        let a = self.bytes.as_slice();\n        let b = other.bytes.as_slice();\n        a == b\n    }\n}\n\nimpl<A: Allocator> Ord for String<A> {\n");
        buf_str(out, c"    fn cmp(self, other: String<A>) -> i64 {\n        let a = self.bytes.as_slice();\n        let b = other.bytes.as_slice();\n        a.cmp(b)\n    }\n}\n\nimpl<A: Allocator> Hash for String<A> {\n    fn hash(self) -> u64 {\n        let a = self.bytes.as_slice();\n        a.hash()\n    }\n}\n\nimpl<A: Allocator> Clone for String<A> {\n    fn clone(self) -> String<A> {\n        String { bytes: self.bytes.clone() }\n    }\n}\n\n// x's Display as a new String on allocator a: `to_string_in(n, gpa)`,\n// `to_string_in(f\"{a}-{b}\", gpa)` (Rust's `x.to_string()`, `format!`).\npub fn to_string_in<T: Display, A: Allocator>(x: sink T, a: sink A) -> String<A> {\n    var s: String<A> = String::new_in(a);\n    s.push_fmt(x);\n    s\n}\n// ---- end mod std::string ----\n}\n// ---- mod std::path ----\npub mod path {\n// std::path (0.20, docs/design/collections-text-io.md §2.6.3, task B6):\n// Path, a view of a path's bytes (Unix paths are bytes, as Rust's OsStr\n// is on Unix), and PathBuf, one that owns them, on an allocator. A string\n// literal is a Path where one goes, a Path goes where `[u8]` does, and\n// `&p` of a PathBuf where a Path or `[u8]` does.\n\nuse std::{Allocator, Debug, Display, Fmt, Gpa, Iterator, Option, Vec};\nuse std::str::validate_utf8;\nuse std::string::str;\n\n// ---- Paths (0.20) ----\n\n// A path: its bytes, '/' between its components.\npub type Path = distinct [u8];\n\n// The index of the last '/' in b, or -1.\nfn last_slash(b: [u8]) -> i64 {\n    var i = b.len;\n    while i > 0 {\n        i -= 1;\n        if b[i] == '/' {\n            return i;\n        }\n    }\n    -1\n}\n\n// b without the '/'s at its end (one stays for the root).\nfn trim_slashes(b: [u8]) -> [u8] {\n    var n = b.len;\n    while n > 1 && b[n - 1] == '/' {\n        n -= 1;\n    }\n    b[..n]\n}\n\nimpl Path {\n    // The path of bytes (or text) s: `Path::new(\"a/b.txt\")`.\n    #[inline]\n    pub fn new(s: [u8]) -> Path {\n        s as Path\n    }\n\n    #[inline]\n");
        buf_str(out, c"    pub fn as_bytes(self) -> [u8] {\n        self as [u8]\n    }\n\n    #[inline]\n    pub fn len(self) -> i64 {\n        (self as [u8]).len\n    }\n\n    // Its text, when its bytes are UTF-8.\n    pub fn to_str(self) -> Option<str> {\n        match str::from_utf8(self as [u8]) {\n            Ok(s) => Option::Some(s),\n            Err(_) => Option::None,\n        }\n    }\n\n    // What prints it (Path is Display itself: its bytes).\n    #[inline]\n    pub fn display(self) -> Path {\n        self\n    }\n\n    pub fn is_absolute(self) -> bool {\n        let b = self as [u8];\n        b.len > 0 && b[0] == '/'\n    }\n\n    pub fn is_relative(self) -> bool {\n        !self.is_absolute()\n    }\n\n    // The last component (None for \"/\", \"\", \"..\", or one ending in \"..\").\n    pub fn file_name(self) -> Option<Path> {\n        let b = trim_slashes(self as [u8]);\n        if b.len == 0 || b == \"/\" {\n            return Option::None;\n        }\n        let name = b[last_slash(b) + 1..];\n        if name == \"..\" || name == \".\" {\n            return Option::None;\n        }\n        Option::Some(name as Path)\n    }\n\n    // The path without its last component (\"\" for a single component, None\n    // for \"/\" and \"\").\n    pub fn parent(self) -> Option<Path> {\n        let b = trim_slashes(self as [u8]);\n        if b.len == 0 || b == \"/\" {\n            return Option::None;\n        }\n        let k = last_slash(b);\n        if k < 0 {\n            return Option::Some(\"\"[..0] as Path);\n        }\n        if k == 0 {\n            return Option::Some(b[..1] as Path);\n        }\n        Option::Some(trim_slashes(b[..k]) as Path)\n    }\n\n    // The file name after its last '.' (none for \".bashrc\" or \"a\").\n    pub fn extension(self) -> Option<Path> {\n        match self.file_name() {\n            Option::Some(n) => {\n                let b = n as [u8];\n                let k = last_dot(b);\n");
        buf_str(out, c"                if k <= 0 { Option::None } else { Option::Some(b[k + 1..] as Path) }\n            }\n            Option::None => Option::None,\n        }\n    }\n\n    // The file name before its last '.'.\n    pub fn file_stem(self) -> Option<Path> {\n        match self.file_name() {\n            Option::Some(n) => {\n                let b = n as [u8];\n                let k = last_dot(b);\n                if k <= 0 { Option::Some(n) } else { Option::Some(b[..k] as Path) }\n            }\n            Option::None => Option::None,\n        }\n    }\n\n    // Whether its first components are base's.\n    pub fn starts_with(self, base: Path) -> bool {\n        let a = self as [u8];\n        let b = trim_slashes(base as [u8]);\n        if b.len > a.len || a[..b.len] != b {\n            return false;\n        }\n        a.len == b.len || b == \"/\" || a[b.len] == '/'\n    }\n\n    // The components (\"/\" first for an absolute path; \".\" and empty ones\n    // left out, as Rust's).\n    #[inline]\n    pub fn components(self) -> Components {\n        Components { b: self as [u8], pos: 0 }\n    }\n\n    // The path with p after it, on allocator a (p absolute: p).\n    pub fn join_in<A: Allocator>(self, p: [u8], a: sink A) -> PathBuf<A> {\n        var out: PathBuf<A> = PathBuf::from_in(self as [u8], a);\n        out.push(p);\n        out\n    }\n\n    // An owned copy, on allocator a.\n    pub fn to_path_buf_in<A: Allocator>(self, a: sink A) -> PathBuf<A> {\n        PathBuf::from_in(self as [u8], a)\n    }\n\n    // Whether something is there (std::fs::metadata succeeds).\n    pub fn exists(self) -> bool {\n        std::fs::exists(self as [u8])\n    }\n\n    pub fn is_dir(self) -> bool {\n        match std::fs::metadata(self as [u8]) {\n            Ok(m) => m.is_dir(),\n            Err(_) => false,\n        }\n    }\n\n    pub fn is_file(self) -> bool {\n        match std::fs::metadata(self as [u8]) {\n            Ok(m) => m.is_file(),\n            Err(_) => false,\n");
        buf_str(out, c"        }\n    }\n}\n\n// The index of the last '.' in b, or -1.\nfn last_dot(b: [u8]) -> i64 {\n    var i = b.len;\n    while i > 0 {\n        i -= 1;\n        if b[i] == '.' {\n            return i;\n        }\n    }\n    -1\n}\n\n// `p.components()`.\npub struct Components { b: [u8], pos: i64 }\n\nimpl Iterator for Components {\n    type Item = Path;\n\n    fn next(inout self) -> Option<Path> {\n        let b = self.b;\n        if self.pos == 0 && b.len > 0 && b[0] == '/' {\n            self.pos = 1;\n            return Option::Some(b[..1] as Path);\n        }\n        loop {\n            while self.pos < b.len && b[self.pos] == '/' {\n                self.pos += 1;\n            }\n            if self.pos >= b.len {\n                return Option::None;\n            }\n            let start = self.pos;\n            while self.pos < b.len && b[self.pos] != '/' {\n                self.pos += 1;\n            }\n            let c = b[start..self.pos];\n            if c != \".\" {\n                return Option::Some(c as Path);\n            }\n        }\n    }\n}\n\n// An owned path, on allocator A.\n#[sealed]\npub struct PathBuf<A: Allocator = Gpa> { pub bytes: Vec<u8, A> }\n\nimpl<A: Allocator> PathBuf<A> {\n    pub fn new_in(a: sink A) -> PathBuf<A> {\n        PathBuf { bytes: Vec::new_in(a) }\n    }\n\n    // A PathBuf of p's bytes.\n    pub fn from_in(p: [u8], a: sink A) -> PathBuf<A> {\n        var v: Vec<u8, A> = Vec::with_capacity_in(p.len, a);\n        v.extend_from_slice(p);\n        PathBuf { bytes: v }\n    }\n\n    #[inline]\n    pub fn as_path(self) -> Path {\n        self.bytes.as_slice() as Path\n    }\n\n    #[inline]\n    pub fn as_bytes(self) -> [u8] {\n        self.bytes.as_slice()\n    }\n\n    // Appends p after a '/' (p absolute: p replaces the path).\n    pub fn push(inout self, p: [u8]) {\n        if p.len > 0 && p[0] == '/' {\n            self.bytes.clear();\n");
        buf_str(out, c"        } else if self.bytes.len > 0 && self.bytes.as_slice()[self.bytes.len - 1] != '/' {\n            self.bytes.push('/');\n        }\n        self.bytes.extend_from_slice(p);\n    }\n\n    // Removes the last component: false when there is none.\n    pub fn pop(inout self) -> bool {\n        match self.as_path().parent() {\n            Option::Some(q) => {\n                let n = (q as [u8]).len;\n                self.bytes.truncate(n);\n                true\n            }\n            Option::None => false,\n        }\n    }\n\n    // Its extension replaced by ext (added when it has none; ext \"\" removes\n    // it): false when it has no file name.\n    pub fn set_extension(inout self, ext: [u8]) -> bool {\n        let stem_end = match self.as_path().file_stem() {\n            Option::Some(s) => {\n                // (the stem starts the last component)\n                let b = trim_slashes(self.bytes.as_slice());\n                last_slash(b) + 1 + (s as [u8]).len\n            }\n            Option::None => return false,\n        };\n        self.bytes.truncate(stem_end);\n        if ext.len > 0 {\n            self.bytes.push('.');\n            self.bytes.extend_from_slice(ext);\n        }\n        true\n    }\n}\n\nimpl<A: Allocator> Display for PathBuf<A> {\n    fn fmt(self, f: inout Fmt) {\n        f.str(self.bytes.as_slice());\n    }\n}\n\nimpl<A: Allocator> Debug for PathBuf<A> {\n    fn fmt_debug(self, f: inout Fmt) {\n        let s = self.bytes.as_slice();\n        s.fmt_debug(&f);\n    }\n}\n// ---- end mod std::path ----\n}\n// ---- mod std::fs ----\npub mod fs {\n// std::fs (0.20, docs/design/collections-text-io.md §2.6.3, task B6):\n// files and directories with Rust's names. A path is any `[u8]`: a\n// literal, a `str`, a Path, `&s` of a String or PathBuf. It reaches C as a\n// NUL-ended copy on the stack (std::sys: InvalidInput when it is longer\n// than the system's PATH_MAX or holds a NUL), so nothing here allocates\n");
        buf_str(out, c"// but what returns a Vec or a String, on the allocator given.\n\nuse std::{Allocator, Drop, Iterator, Option, Vec};\nuse std::io::buffered::{Read, Write};\nuse std::io::error::{Error, ErrorKind, Result, __io_error, __os_error};\nuse std::path::{Path, PathBuf};\nuse std::str::validate_utf8;\nuse std::string::{String, str};\nuse std::sys::{\n    FileStat, SYS_DT_DIR, SYS_DT_LNK, SYS_DT_REG, SYS_DT_UNKNOWN, SYS_EEXIST, SYS_O_APPEND,\n    SYS_O_CLOEXEC, SYS_O_CREAT, SYS_O_EXCL, SYS_O_RDONLY, SYS_O_RDWR, SYS_O_TRUNC, SYS_O_WRONLY,\n    SYS_SEEK_CUR, SYS_SEEK_END, SYS_SEEK_SET, SysDir, sys_close, sys_closedir, sys_fstat, sys_fsync,\n    sys_ftruncate, sys_lseek, sys_lstat, sys_mkdir, sys_open, sys_opendir, sys_read,\n    sys_readdir_into, sys_rename, sys_rmdir, sys_stat, sys_unlink, sys_write,\n};\n\n// ---- Files (0.20) ----\n\n// An open file; dropping it closes it.\npub struct File { fd: i32 }\n\nimpl Drop for File {\n    fn drop(inout self) {\n        if self.fd >= 0 {\n            let _ = sys_close(self.fd);\n            self.fd = -1;\n        }\n    }\n}\n\n// The Result of a sys call, its errno an io::Error.\n#[inline]\nfn os<T>(r: sink std::Result<T, i32>) -> Result<T> {\n    match r {\n        Ok(v) => Ok(v),\n        Err(e) => Err(__os_error(e)),\n    }\n}\n\nimpl File {\n    // Opens path for reading.\n    pub fn open(path: [u8]) -> Result<File> {\n        let fd = os(sys_open(path, SYS_O_RDONLY | SYS_O_CLOEXEC, 0))?;\n        Ok(File { fd: fd })\n    }\n\n    // Opens path for writing: made if it is not there, emptied if it is.\n    pub fn create(path: [u8]) -> Result<File> {\n        let fd = os(sys_open(path, SYS_O_WRONLY | SYS_O_CREAT | SYS_O_TRUNC | SYS_O_CLOEXEC,\n            0x1b6))?;\n        Ok(File { fd: fd })\n    }\n\n    // Makes path and opens it for writing: AlreadyExists when it is there.\n    pub fn create_new(path: [u8]) -> Result<File> {\n        let fd = os(sys_open(path, SYS_O_WRONLY | SYS_O_CREAT | SYS_O_EXCL | SYS_O_CLOEXEC,\n");
        buf_str(out, c"            0x1b6))?;\n        Ok(File { fd: fd })\n    }\n\n    // The options to open a file with: `OpenOptions::new().append(true)`.\n    pub fn options() -> OpenOptions {\n        OpenOptions::new()\n    }\n\n    // Its file descriptor.\n    pub fn as_raw_fd(self) -> i32 {\n        self.fd\n    }\n\n    pub fn metadata(self) -> Result<Metadata> {\n        let st = os(sys_fstat(self.fd))?;\n        Ok(Metadata { st: st })\n    }\n\n    // Its length becomes n (cut, or zeros after).\n    pub fn set_len(self, n: i64) -> Result<()> {\n        os(sys_ftruncate(self.fd, n))\n    }\n\n    // Writes what the system holds of it to the disk.\n    pub fn sync_all(self) -> Result<()> {\n        os(sys_fsync(self.fd))\n    }\n\n    // Moves the position: to `off` from the start (Rust's\n    // `seek(SeekFrom::Start(off))`); the new position.\n    pub fn seek(inout self, pos: SeekFrom) -> Result<i64> {\n        let r = match pos {\n            SeekFrom::Start(o) => sys_lseek(self.fd, o, SYS_SEEK_SET),\n            SeekFrom::End(o) => sys_lseek(self.fd, o, SYS_SEEK_END),\n            SeekFrom::Current(o) => sys_lseek(self.fd, o, SYS_SEEK_CUR),\n        };\n        os(r)\n    }\n}\n\n// Where File::seek moves to.\n#[derive(Eq, Debug, Clone)]\npub enum SeekFrom { Start(i64), End(i64), Current(i64) }\n\nimpl Read for File {\n    fn read(inout self, buf: inout [u8]) -> Result<i64> {\n        os(sys_read(self.fd, buf))\n    }\n}\n\nimpl Write for File {\n    fn write(inout self, buf: [u8]) -> Result<i64> {\n        os(sys_write(self.fd, buf))\n    }\n\n    fn flush(inout self) -> Result<()> {\n        Ok(())\n    }\n}\n\n// How File::open... opens a file (Rust's OpenOptions):\n// `OpenOptions::new().append(true).create(true).open(p)?`.\n#[derive(Eq, Debug, Clone)]\npub struct OpenOptions {\n    read: bool, write: bool, append: bool, truncate: bool, create: bool, create_new: bool,\n    mode: i32,\n}\n\nimpl OpenOptions {\n    pub fn new() -> OpenOptions {\n");
        buf_str(out, c"        OpenOptions { read: false, write: false, append: false, truncate: false, create: false,\n            create_new: false, mode: 0x1b6 }\n    }\n\n    pub fn read(self, on: bool) -> OpenOptions {\n        var o = self;\n        o.read = on;\n        o\n    }\n\n    pub fn write(self, on: bool) -> OpenOptions {\n        var o = self;\n        o.write = on;\n        o\n    }\n\n    pub fn append(self, on: bool) -> OpenOptions {\n        var o = self;\n        o.append = on;\n        o\n    }\n\n    pub fn truncate(self, on: bool) -> OpenOptions {\n        var o = self;\n        o.truncate = on;\n        o\n    }\n\n    pub fn create(self, on: bool) -> OpenOptions {\n        var o = self;\n        o.create = on;\n        o\n    }\n\n    pub fn create_new(self, on: bool) -> OpenOptions {\n        var o = self;\n        o.create_new = on;\n        o\n    }\n\n    // The permission bits a file it makes gets (0x1b6 before the umask).\n    pub fn mode(self, bits: i32) -> OpenOptions {\n        var o = self;\n        o.mode = bits;\n        o\n    }\n\n    pub fn open(self, path: [u8]) -> Result<File> {\n        let writes = self.write || self.append;\n        var flags = if self.read && writes { SYS_O_RDWR } else if writes { SYS_O_WRONLY }\n            else { SYS_O_RDONLY };\n        if self.append {\n            flags |= SYS_O_APPEND;\n        }\n        if self.truncate {\n            flags |= SYS_O_TRUNC;\n        }\n        if self.create_new {\n            flags |= SYS_O_CREAT | SYS_O_EXCL;\n        } else if self.create {\n            flags |= SYS_O_CREAT;\n        }\n        let fd = os(sys_open(path, flags | SYS_O_CLOEXEC, self.mode))?;\n        Ok(File { fd: fd })\n    }\n}\n\n// What stat says of a file.\n#[derive(Eq, Debug)]\npub struct Metadata { st: FileStat }\n\nimpl Metadata {\n    // The size in bytes.\n    pub fn len(self) -> i64 {\n        self.st.size\n    }\n\n    pub fn is_dir(self) -> bool {\n        self.st.is_dir()\n    }\n\n");
        buf_str(out, c"    pub fn is_file(self) -> bool {\n        self.st.is_file()\n    }\n\n    pub fn is_symlink(self) -> bool {\n        self.st.is_symlink()\n    }\n\n    // The permission bits (0x1ed: 0o755, ...).\n    pub fn mode(self) -> u32 {\n        self.st.permissions()\n    }\n\n    // When it was last changed: since the Unix epoch.\n    pub fn modified(self) -> std::time::Duration {\n        std::time::Duration::new(self.st.mtime_sec as u64, self.st.mtime_nsec as u32)\n    }\n}\n\n// ---- Whole files (0.20) ----\n\n// The bytes of the file at path, in a new Vec on allocator a.\npub fn read_in<A: Allocator>(path: [u8], a: sink A) -> Result<Vec<u8, A>> {\n    var f = File::open(path)?;\n    let size = match f.metadata() {\n        Ok(m) => m.len(),\n        Err(_) => 0,\n    };\n    var v: Vec<u8, A> = Vec::with_capacity_in(size + 1, a);\n    f.read_to_end(&v)?;\n    Ok(v)\n}\n\n// The text of the file at path, in a new String on allocator a\n// (InvalidData when it is not UTF-8).\npub fn read_to_string_in<A: Allocator>(path: [u8], a: sink A) -> Result<String<A>> {\n    let v = read_in(path, a)?;\n    match String::from_utf8(v) {\n        Ok(s) => Ok(s),\n        Err(_) => Err(__io_error(ErrorKind::InvalidData, c\"stream did not contain valid UTF-8\")),\n    }\n}\n\n// The file at path holds data: made, or emptied first.\npub fn write(path: [u8], data: [u8]) -> Result<()> {\n    var f = File::create(path)?;\n    f.write_all(data)\n}\n\n// data at the end of the file at path (made when it is not there).\npub fn append(path: [u8], data: [u8]) -> Result<()> {\n    var f = OpenOptions::new().append(true).create(true).open(path)?;\n    f.write_all(data)\n}\n\n// Copies the file at `from` to `to` (made, or emptied): the bytes copied.\npub fn copy(from: [u8], to: [u8]) -> Result<i64> {\n    var src = File::open(from)?;\n    var dst = File::create(to)?;\n    var buf: [u8; 65536] = [0; 65536];\n    var total = 0;\n    loop {\n        let n = src.read(&buf[..])?;\n        if n == 0 {\n");
        buf_str(out, c"            return Ok(total);\n        }\n        dst.write_all(buf[..n])?;\n        total += n;\n    }\n}\n\n// What stat says of the file at path (through a symlink).\npub fn metadata(path: [u8]) -> Result<Metadata> {\n    let st = os(sys_stat(path))?;\n    Ok(Metadata { st: st })\n}\n\n// As metadata, of a symlink itself.\npub fn symlink_metadata(path: [u8]) -> Result<Metadata> {\n    let st = os(sys_lstat(path))?;\n    Ok(Metadata { st: st })\n}\n\n// Whether something is at path.\npub fn exists(path: [u8]) -> bool {\n    match sys_stat(path) {\n        Ok(_) => true,\n        Err(_) => false,\n    }\n}\n\npub fn remove_file(path: [u8]) -> Result<()> {\n    os(sys_unlink(path))\n}\n\n// Removes the empty directory at path.\npub fn remove_dir(path: [u8]) -> Result<()> {\n    os(sys_rmdir(path))\n}\n\npub fn rename(from: [u8], to: [u8]) -> Result<()> {\n    os(sys_rename(from, to))\n}\n\npub fn create_dir(path: [u8]) -> Result<()> {\n    os(sys_mkdir(path, 0x1ff))\n}\n\n// Makes the directory at path and the ones above it that are missing\n// (Ok when it is there).\npub fn create_dir_all(path: [u8]) -> Result<()> {\n    if path.len == 0 {\n        return Ok(());\n    }\n    match sys_mkdir(path, 0x1ff) {\n        Ok(_) => return Ok(()),\n        Err(e) => {\n            if e == SYS_EEXIST {\n                return if is_dir_at(path) { Ok(()) } else { Err(__os_error(e)) };\n            }\n        }\n    }\n    // (the parents first, then this one)\n    var end = path.len;\n    while end > 0 && path[end - 1] == '/' {\n        end -= 1;\n    }\n    var k = end;\n    while k > 0 && path[k - 1] != '/' {\n        k -= 1;\n    }\n    if k > 1 {\n        create_dir_all(path[..k - 1])?;\n    }\n    match sys_mkdir(path, 0x1ff) {\n        Ok(_) => Ok(()),\n        Err(e) => if e == SYS_EEXIST && is_dir_at(path) { Ok(()) } else { Err(__os_error(e)) },\n    }\n}\n\nfn is_dir_at(path: [u8]) -> bool {\n    match sys_stat(path) {\n        Ok(st) => st.is_dir(),\n");
        buf_str(out, c"        Err(_) => false,\n    }\n}\n\n// Removes the directory at path and all it holds (symlinks are removed,\n// not followed).\npub fn remove_dir_all(path: [u8]) -> Result<()> {\n    var stack: [u8; 4096] = [0; 4096];\n    if path.len >= 4096 {\n        return Err(__io_error(ErrorKind::InvalidInput, c\"path too long\"));\n    }\n    for i in 0..path.len {\n        stack[i] = path[i];\n    }\n    remove_tree(&stack, path.len)\n}\n\n// Removes the tree at buf[..n], which it extends with each entry's name.\nfn remove_tree(buf: inout [u8; 4096], n: i64) -> Result<()> {\n    let st = os(sys_lstat(buf[..n]))?;\n    if !st.is_dir() {\n        return os(sys_unlink(buf[..n]));\n    }\n    var dir = read_dir(buf[..n])?;\n    loop {\n        let e = match dir.next() {\n            Option::Some(r) => r?,\n            Option::None => break,\n        };\n        let name = e.name[..e.len];\n        if n + 1 + name.len >= 4096 {\n            return Err(__io_error(ErrorKind::InvalidInput, c\"path too long\"));\n        }\n        buf[n] = '/';\n        for i in 0..name.len {\n            buf[n + 1 + i] = name[i];\n        }\n        remove_tree(&buf, n + 1 + name.len)?;\n    }\n    os(sys_rmdir(buf[..n]))\n}\n\n// ---- Directories (0.20) ----\n\n// The entries of the directory at path (\".\" and \"..\" left out), in the\n// order the file system gives them.\npub fn read_dir(path: [u8]) -> Result<ReadDir> {\n    let d = os(sys_opendir(path))?;\n    Ok(ReadDir { dir: d })\n}\n\n// `fs::read_dir(p)?`: each item an io::Result<DirEntry>. Dropping it\n// closes the directory.\npub struct ReadDir { dir: SysDir }\n\nimpl Drop for ReadDir {\n    fn drop(inout self) {\n        let _ = sys_closedir(&self.dir);\n    }\n}\n\nimpl Iterator for ReadDir {\n    type Item = Result<DirEntry>;\n\n    fn next(inout self) -> Option<Result<DirEntry>> {\n        loop {\n            var e = DirEntry { name: [0; 256], len: 0, kind: 0 };\n            match sys_readdir_into(&self.dir, &e.name) {\n");
        buf_str(out, c"                Ok(Option::Some(x)) => {\n                    e.len = x.name_len;\n                    e.kind = x.kind;\n                    let nm = e.name[..e.len];\n                    if nm == \".\" || nm == \"..\" {\n                        continue;\n                    }\n                    return Option::Some(Ok(e));\n                }\n                Ok(Option::None) => return Option::None,\n                Err(err) => return Option::Some(Err(__os_error(err))),\n            }\n        }\n    }\n}\n\n// A directory's entry: its name (inline, up to 256 bytes) and kind.\npub struct DirEntry { name: [u8; 256], len: i64, kind: u8 }\n\nimpl DirEntry {\n    // Its name, a view of the entry.\n    pub fn file_name(self) -> Path {\n        self.name[..self.len] as Path\n    }\n\n    // dir's path with the name after it, on allocator a.\n    pub fn path_in<A: Allocator>(self, dir: [u8], a: sink A) -> PathBuf<A> {\n        var p: PathBuf<A> = PathBuf::from_in(dir, a);\n        p.push(self.name[..self.len]);\n        p\n    }\n\n    // Whether the file system says it is a directory (false when it does\n    // not say: fs::metadata knows).\n    pub fn is_dir(self) -> bool {\n        self.kind == SYS_DT_DIR\n    }\n\n    pub fn is_file(self) -> bool {\n        self.kind == SYS_DT_REG\n    }\n\n    pub fn is_symlink(self) -> bool {\n        self.kind == SYS_DT_LNK\n    }\n}\n// ---- end mod std::fs ----\n}\n// ---- mod std::env ----\npub mod env {\n// std::env (0.20, docs/design/collections-text-io.md §2.6.3, task B6):\n// the program's arguments and environment, with Rust's names. `args()`\n// yields views of argv, valid for the whole program (no allocation);\n// a variable's value is copied (`get_in`), since the environment can\n// change under a view. (Rust's `env::var` is `env::get` here: `var`\n// is a word, a keyword from 0.21.)\n\nuse std::{Allocator, Display, Fmt, Gpa, Iterator, Option, Result, Vec, sys_args};\n");
        buf_str(out, c"use std::io::error::{Error, ErrorKind, __io_error, __os_error};\nuse std::path::PathBuf;\nuse std::str::validate_utf8;\nuse std::string::{String, str};\nuse std::sys::{\n    sys_chdir, sys_cstr_view, sys_env_at, sys_env_count, sys_getcwd_into, sys_getenv, sys_setenv,\n    sys_unsetenv,\n};\n\n// ---- Arguments (0.20) ----\n\n// The i-th argument's bytes (i < count).\nfn arg_bytes(i: i64) -> [u8] {\n    let (n, argv) = sys_args();\n    if i < 0 || i >= n {\n        std::panic_str(\"env: argument index out of bounds\");\n    }\n    // (argv[0..argc] are crt's NUL-ended strings, for the whole program)\n    unsafe { sys_cstr_view(argv[i]) }\n}\n\n// The arguments, the program's name first: `for a in env::args()`,\n// `env::args().collect_in(gpa)`. One that is not UTF-8 stops the program\n// (as Rust's); `args_os()` yields bytes.\npub fn args() -> Args {\n    let (n, _) = sys_args();\n    Args { i: 0, n: n }\n}\n\n// The arguments as bytes.\npub fn args_os() -> ArgsOs {\n    let (n, _) = sys_args();\n    ArgsOs { i: 0, n: n }\n}\n\npub struct Args { i: i64, n: i64 }\n\nimpl Iterator for Args {\n    type Item = str;\n\n    fn next(inout self) -> Option<str> {\n        if self.i >= self.n {\n            return Option::None;\n        }\n        let b = arg_bytes(self.i);\n        self.i += 1;\n        match str::from_utf8(b) {\n            Ok(s) => Option::Some(s),\n            Err(_) => std::panic_str(\n                \"env::args: an argument is not UTF-8 (env::args_os yields bytes)\"),\n        }\n    }\n\n    fn exact_len(self) -> i64 {\n        self.n - self.i\n    }\n}\n\nimpl Args {\n    // The arguments left.\n    pub fn len(self) -> i64 {\n        self.n - self.i\n    }\n\n    // Skips the first n (`env::args().skip(1)`: the program's name).\n    pub fn skip(self, n: i64) -> Args {\n        var a = self;\n        a.i = if a.i + n < a.n { a.i + n } else { a.n };\n        a\n    }\n}\n\npub struct ArgsOs { i: i64, n: i64 }\n\nimpl Iterator for ArgsOs {\n");
        buf_str(out, c"    type Item = [u8];\n\n    fn next(inout self) -> Option<[u8]> {\n        if self.i >= self.n {\n            return Option::None;\n        }\n        let b = arg_bytes(self.i);\n        self.i += 1;\n        Option::Some(b)\n    }\n}\n\n// ---- The environment (0.20) ----\n\n// Why env::get_in failed: the variable is not set, or its value is not\n// UTF-8.\n#[derive(Eq, Debug, Clone)]\npub enum VarError { NotPresent, NotUnicode }\n\nimpl Display for VarError {\n    fn fmt(self, f: inout Fmt) {\n        match self {\n            VarError::NotPresent => f.str(\"environment variable not found\"),\n            VarError::NotUnicode => f.str(\"environment variable was not valid unicode\"),\n        }\n    }\n}\n\n// The value of variable name, copied into a new String on allocator a.\npub fn get_in<A: Allocator>(name: [u8], a: sink A) -> Result<String<A>, VarError> {\n    match sys_getenv(name) {\n        Option::Some(v) => match validate_utf8(v) {\n            Ok(_) => Ok(String::from_in(v as str, a)),\n            Err(_) => Err(VarError::NotUnicode),\n        },\n        Option::None => Err(VarError::NotPresent),\n    }\n}\n\n// (0.16: an error outside std, front/ambient.tach)\n#[ambient(\"get_in(name, gpa)\")]\npub fn get(name: [u8]) -> Result<String, VarError> {\n    get_in(name, Gpa::ambient())\n}\n\n// The value of variable name, its bytes copied into a new Vec on a.\npub fn var_os_in<A: Allocator>(name: [u8], a: sink A) -> Option<Vec<u8, A>> {\n    match sys_getenv(name) {\n        Option::Some(v) => {\n            var out: Vec<u8, A> = Vec::with_capacity_in(v.len, a);\n            out.extend_from_slice(v);\n            Option::Some(out)\n        }\n        Option::None => Option::None,\n    }\n}\n\n// Whether variable name is set.\npub fn var_is_set(name: [u8]) -> bool {\n    sys_getenv(name).is_some()\n}\n\n// Every variable, (name, value) copied into Strings on allocator a (the\n// ones that are not UTF-8 left out).\n");
        buf_str(out, c"pub fn vars_in<A: Allocator>(a: sink A) -> Vec<(String<A>, String<A>), A> {\n    var out: Vec<(String<A>, String<A>), A> = Vec::new_in(a);\n    for i in 0..sys_env_count() {\n        let kv = sys_env_at(i);\n        var eq = -1;\n        for k in 0..kv.len {\n            if kv[k] == '=' {\n                eq = k;\n                break;\n            }\n        }\n        if eq < 0 || validate_utf8(kv).is_err() {\n            continue;\n        }\n        let name: String<A> = String::from_in(kv[..eq] as str, a);\n        let value: String<A> = String::from_in(kv[eq + 1..] as str, a);\n        out.push((name, value));\n    }\n    out\n}\n\n// Sets variable name to value (Rust 2024's `unsafe fn`: no other thread\n// may read the environment meanwhile, and views of it end).\npub unsafe fn set_var(name: [u8], value: [u8]) {\n    let _ = sys_setenv(name, value);\n}\n\npub unsafe fn remove_var(name: [u8]) {\n    let _ = sys_unsetenv(name);\n}\n\n// ---- The working directory (0.20) ----\n\n// The current directory, in a new PathBuf on allocator a.\npub fn current_dir_in<A: Allocator>(a: sink A) -> std::io::Result<PathBuf<A>> {\n    var buf: [u8; 4096] = [0; 4096];\n    match sys_getcwd_into(&buf[..]) {\n        Ok(n) => Ok(PathBuf::from_in(buf[..n], a)),\n        Err(e) => Err(__os_error(e)),\n    }\n}\n\npub fn set_current_dir(path: [u8]) -> std::io::Result<()> {\n    match sys_chdir(path) {\n        Ok(_) => Ok(()),\n        Err(e) => Err(__os_error(e)),\n    }\n}\n// ---- end mod std::env ----\n}\n// ---- mod std::process ----\npub mod process {\n// std::process (0.20, docs/design/collections-text-io.md §2.6.3, task\n// B6): running programs, with Rust's names, through posix_spawnp\n// (std::sys). A Command keeps its program and up to 32 arguments as\n// views, inline, and builds argv on the stack when it runs (each argument\n// and the program's name up to 4 KB in all: InvalidInput beyond), so\n// `Command::new(p)` allocates nothing; `output_in(gpa)` puts what the\n");
        buf_str(out, c"// child writes in Vecs on gpa. `c.arg(x)` changes c in place (Rust's\n// `&mut Command`): `let mut c = Command::new(\"ls\"); c.arg(\"-l\");\n// let out = c.output_in(gpa)?;`.\n\nuse std::{Allocator, Display, Fmt, Option, Vec};\nuse std::io::error::{Error, ErrorKind, Result, __io_error, __os_error};\nuse std::sys::{\n    SYS_EINTR, SYS_O_RDWR, SYS_POLLHUP, SYS_POLLIN, SysPollFd, SysSpawnActions, sys_close,\n    sys_exit_code, sys_exit_signal, sys_kill, sys_open, sys_pipe, sys_poll, sys_read, sys_spawn,\n    sys_spawn_actions, sys_waitpid,\n};\n\n// ---- Processes (0.20) ----\n\nconst MAX_ARGS: i64 = 32;\nconst ARG_TEXT: i64 = 4096;\n\n// What a child's stdin, stdout or stderr is: this process's (inherit),\n// /dev/null (null), or a pipe to this process (piped: output_in's).\n#[derive(Eq, Debug, Clone)]\npub enum Stdio { Inherit, Null, Piped }\n\nimpl Stdio {\n    pub fn inherit() -> Stdio { Stdio::Inherit }\n    pub fn null() -> Stdio { Stdio::Null }\n    pub fn piped() -> Stdio { Stdio::Piped }\n}\n\n// A program to run, its arguments and its streams.\npub struct Command {\n    prog: [u8],\n    args: [[u8]; 32],\n    count: i64,\n    stdin: Stdio,\n    stdout: Stdio,\n    stderr: Stdio,\n}\n\n// How a child ended: its exit code, or the signal that ended it.\n#[derive(Eq, Debug, Clone)]\npub struct ExitStatus { status: i32 }\n\nimpl ExitStatus {\n    // Whether it exited with 0.\n    pub fn success(self) -> bool {\n        match sys_exit_code(self.status) {\n            Option::Some(c) => c == 0,\n            Option::None => false,\n        }\n    }\n\n    // Its exit code (None when a signal ended it).\n    pub fn code(self) -> Option<i32> {\n        sys_exit_code(self.status)\n    }\n\n    // The signal that ended it.\n    pub fn signal(self) -> Option<i32> {\n        sys_exit_signal(self.status)\n    }\n}\n\nimpl Display for ExitStatus {\n    fn fmt(self, f: inout Fmt) {\n        match sys_exit_code(self.status) {\n            Option::Some(c) => {\n");
        buf_str(out, c"                f.str(\"exit status: \");\n                f.int(c as i64);\n            }\n            Option::None => {\n                f.str(\"signal: \");\n                f.int(self.status as i64 & 0x7f);\n            }\n        }\n    }\n}\n\n// What output_in returns: how the child ended, and what it wrote.\npub struct Output<A: Allocator> {\n    pub status: ExitStatus, pub stdout: Vec<u8, A>, pub stderr: Vec<u8, A>\n}\n\n// A running child: wait for it (dropping it does not).\npub struct Child { pid: i32, done: bool, status: i32 }\n\nimpl Child {\n    pub fn id(self) -> i32 {\n        self.pid\n    }\n\n    // Waits for it to end.\n    pub fn wait(inout self) -> Result<ExitStatus> {\n        if self.done {\n            return Ok(ExitStatus { status: self.status });\n        }\n        let st = wait_pid(self.pid)?;\n        self.done = true;\n        self.status = st;\n        Ok(ExitStatus { status: st })\n    }\n\n    // How it ended, if it has: None while it runs.\n    pub fn try_wait(inout self) -> Result<Option<ExitStatus>> {\n        if self.done {\n            return Ok(Option::Some(ExitStatus { status: self.status }));\n        }\n        match sys_waitpid(self.pid, true) {\n            Ok((p, st)) => {\n                if p == 0 {\n                    return Ok(Option::None);\n                }\n                self.done = true;\n                self.status = st;\n                Ok(Option::Some(ExitStatus { status: st }))\n            }\n            Err(e) => Err(__os_error(e)),\n        }\n    }\n\n    // Sends it SIGKILL.\n    pub fn kill(inout self) -> Result<()> {\n        match sys_kill(self.pid, 9) {\n            Ok(_) => Ok(()),\n            Err(e) => Err(__os_error(e)),\n        }\n    }\n}\n\n// Waits for pid (again when a signal interrupts): its status.\nfn wait_pid(pid: i32) -> Result<i32> {\n    loop {\n        match sys_waitpid(pid, false) {\n            Ok((_, st)) => return Ok(st),\n            Err(e) => {\n");
        buf_str(out, c"                if e != SYS_EINTR {\n                    return Err(__os_error(e));\n                }\n            }\n        }\n    }\n}\n\n// The NUL-ended copies of a command's program and arguments, and argv.\nstruct Argv { text: [u8; 4096], ptrs: [*u8; 34] }\n\nimpl Command {\n    // Runs prog: a path, or a name looked up in PATH.\n    pub fn new(prog: [u8]) -> Command {\n        Command { prog: prog, args: [\"\"; 32], count: 0, stdin: Stdio::Inherit,\n            stdout: Stdio::Inherit, stderr: Stdio::Inherit }\n    }\n\n    // Adds an argument (up to 32).\n    pub fn arg(inout self, a: [u8]) {\n        if self.count >= MAX_ARGS {\n            std::panic_str(\"Command::arg: more than 32 arguments\");\n        }\n        self.args[self.count] = a;\n        self.count += 1;\n    }\n\n    // Adds each of list.\n    pub fn args(inout self, list: [[u8]]) {\n        for a in list {\n            self.arg(a);\n        }\n    }\n\n    pub fn stdin(inout self, s: Stdio) {\n        self.stdin = s;\n    }\n\n    pub fn stdout(inout self, s: Stdio) {\n        self.stdout = s;\n    }\n\n    pub fn stderr(inout self, s: Stdio) {\n        self.stderr = s;\n    }\n\n    // argv for C, in out: InvalidInput when it does not fit or holds a NUL.\n    fn build_argv(self, out: inout Argv) -> Result<()> {\n        var at = 0;\n        for k in 0..self.count + 1 {\n            let s = if k == 0 { self.prog } else { self.args[k - 1] };\n            if at + s.len + 1 > ARG_TEXT {\n                return Err(__io_error(ErrorKind::InvalidInput, c\"arguments over 4096 bytes\"));\n            }\n            for i in 0..s.len {\n                if s[i] == 0 {\n                    return Err(__io_error(ErrorKind::InvalidInput, c\"an argument holds a NUL\"));\n                }\n                out.text[at + i] = s[i];\n            }\n            out.text[at + s.len] = 0;\n            // (text is out's: it lives as long as ptrs does)\n            out.ptrs[k] = &out.text[at] as *u8;\n");
        buf_str(out, c"            at += s.len + 1;\n        }\n        out.ptrs[self.count + 1] = 0 as *u8;\n        Ok(())\n    }\n\n    // Starts it with the streams as set (piped ones are not supported\n    // here: output_in pipes stdout and stderr).\n    pub fn spawn(self) -> Result<Child> {\n        var acts = os(sys_spawn_actions())?;\n        var null: i32 = -1;\n        let r = self.spawn_with(&acts, &null, -1, -1);\n        acts.free();\n        if null >= 0 {\n            let _ = sys_close(null);\n        }\n        let pid = r?;\n        Ok(Child { pid: pid, done: false, status: 0 })\n    }\n\n    // Runs it, waits for it: how it ended.\n    pub fn status(self) -> Result<ExitStatus> {\n        var c = self.spawn()?;\n        c.wait()\n    }\n\n    // Runs it with stdout and stderr piped to this process (stdin\n    // inherited), and waits: how it ended and what it wrote, in Vecs on a.\n    pub fn output_in<A: Allocator>(self, a: sink A) -> Result<Output<A>> {\n        let (out_r, out_w) = os(sys_pipe())?;\n        let (err_r, err_w) = match sys_pipe() {\n            Ok(p) => p,\n            Err(e) => {\n                let _ = sys_close(out_r);\n                let _ = sys_close(out_w);\n                return Err(__os_error(e));\n            }\n        };\n        var acts = os(sys_spawn_actions())?;\n        var null: i32 = -1;\n        let r = self.spawn_with(&acts, &null, out_w, err_w);\n        acts.free();\n        let _ = sys_close(out_w);\n        let _ = sys_close(err_w);\n        if null >= 0 {\n            let _ = sys_close(null);\n        }\n        let pid = match r {\n            Ok(p) => p,\n            Err(e) => {\n                let _ = sys_close(out_r);\n                let _ = sys_close(err_r);\n                return Err(e);\n            }\n        };\n        var stdout: Vec<u8, A> = Vec::new_in(a);\n        var stderr: Vec<u8, A> = Vec::new_in(a);\n        let got = drain_two(out_r, err_r, &stdout, &stderr);\n        let _ = sys_close(out_r);\n");
        buf_str(out, c"        let _ = sys_close(err_r);\n        let st = wait_pid(pid)?;\n        got?;\n        Ok(Output { status: ExitStatus { status: st }, stdout: stdout, stderr: stderr })\n    }\n\n    // Spawns it with the file actions for its streams in acts (out_w,\n    // err_w: pipes for stdout and stderr, or -1); /dev/null, when one is\n    // Null, opened into *null.\n    fn spawn_with(self, acts: inout SysSpawnActions, null: inout i32, out_w: i32,\n        err_w: i32) -> Result<i32> {\n        let wants_null = self.stdin == Stdio::Null || self.stdout == Stdio::Null\n            || self.stderr == Stdio::Null;\n        if wants_null {\n            let fd = os(sys_open(\"/dev/null\", SYS_O_RDWR, 0))?;\n            null = fd;\n        }\n        let nfd = null;\n        if self.stdin == Stdio::Null {\n            os(acts.dup2(nfd, 0))?;\n        }\n        if out_w >= 0 {\n            os(acts.dup2(out_w, 1))?;\n        } else if self.stdout == Stdio::Null {\n            os(acts.dup2(nfd, 1))?;\n        }\n        if err_w >= 0 {\n            os(acts.dup2(err_w, 2))?;\n        } else if self.stderr == Stdio::Null {\n            os(acts.dup2(nfd, 2))?;\n        }\n        var argv = Argv { text: [0; 4096], ptrs: [0 as *u8; 34] };\n        self.build_argv(&argv)?;\n        let envp: [*u8; 0] = [];\n        // (argv's strings are NUL-ended and its pointers end with null:\n        // build_argv; prog is ptrs[0])\n        let r = unsafe { sys_spawn(argv.ptrs[0], argv.ptrs[..self.count + 2], envp[..], &acts) };\n        os(r)\n    }\n}\n\n// The Result of a sys call, its errno an io::Error.\n#[inline]\nfn os<T>(r: sink std::Result<T, i32>) -> Result<T> {\n    match r {\n        Ok(v) => Ok(v),\n        Err(e) => Err(__os_error(e)),\n    }\n}\n\n// Reads the pipes a and b to their ends, into va and vb (poll: neither\n// child stream blocks the other).\nfn drain_two<A: Allocator>(a: i32, b: i32, va: inout Vec<u8, A>, vb: inout Vec<u8, A>)\n    -> Result<()> {\n    var open_a = true;\n");
        buf_str(out, c"    var open_b = true;\n    while open_a || open_b {\n        var fds: [SysPollFd; 2] = [\n            SysPollFd { fd: if open_a { a } else { -1 }, events: SYS_POLLIN, revents: 0 },\n            SysPollFd { fd: if open_b { b } else { -1 }, events: SYS_POLLIN, revents: 0 },\n        ];\n        match sys_poll(fds[..], -1) {\n            Ok(_) => {}\n            Err(e) => {\n                if e == SYS_EINTR {\n                    continue;\n                }\n                return Err(__os_error(e));\n            }\n        }\n        if open_a && fds[0].revents != 0 {\n            open_a = read_some(a, &va)?;\n        }\n        if open_b && fds[1].revents != 0 {\n            open_b = read_some(b, &vb)?;\n        }\n    }\n    Ok(())\n}\n\n// Reads what fd has into v: false at its end.\nfn read_some<A: Allocator>(fd: i32, v: inout Vec<u8, A>) -> Result<bool> {\n    if v.cap - v.len < 4096 {\n        v.reserve(if v.cap < 8192 { 8192 } else { v.cap });\n    }\n    // (v's room: its capacity past its length)\n    let room = unsafe { v.ptr[v.len..v.cap] };\n    match sys_read(fd, &room) {\n        Ok(n) => {\n            v.len += n;\n            Ok(n > 0)\n        }\n        Err(e) => if e == SYS_EINTR { Ok(true) } else { Err(__os_error(e)) },\n    }\n}\n\n// Ends this process with code (Rust's `std::process::exit`); what print\n// buffered is written out first.\npub fn exit(code: i32) -> ! {\n    std::fmt::__flush_print();\n    unsafe { std::exit(code) }\n}\n\n// This process's id.\npub fn id() -> i32 {\n    std::sys::sys_getpid()\n}\n// ---- end mod std::process ----\n}\n");
    }
    std_alloc_tail(out);
}

// Gpa's implementation (0.16), the end of std's source unless
// --check-alloc (front/stdalloc.tach).
pub fn std_gpa_source(out: i64) {
    unsafe {
        buf_str(out, c"// ---- Gpa's implementation (0.16) ----\n\n// C's allocator; malloc's memory is aligned to 16, larger alignments go\n// through posix_memalign. (--check-alloc replaces this part of std with\n// alloc_check.tach.)\n\nextern \"C\" {\n    #[effects(alloc(extern))]\n    fn posix_memalign(out: **u8, align: u64, size: u64) -> i32;\n}\n\nconst GPA_MALLOC_ALIGN: i64 = 16;\n\nimpl Allocator for Gpa {\n    #[inline]\n    fn try_alloc(self: *Gpa, size: i64, align: i64) -> *u8 {\n        if size == 0 {\n            // (a pointer nothing is read through)\n            return unsafe { align as *u8 };\n        }\n        if align > GPA_MALLOC_ALIGN {\n            return gpa_aligned(size, align);\n        }\n        unsafe { malloc(size as u64) }\n    }\n\n    #[inline]\n    unsafe fn try_resize(self: *Gpa, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n        if align > GPA_MALLOC_ALIGN || new_size == 0 {\n            return gpa_resize_slow(p, old_size, new_size, align);\n        }\n        realloc(if old_size == 0 { 0 as *u8 } else { p }, new_size as u64)\n    }\n\n    #[inline]\n    unsafe fn free(self: *Gpa, p: *u8, size: i64, align: i64) {\n        if size != 0 {\n            free(p);\n        }\n    }\n}\n\n// size bytes (not 0) aligned to align (above malloc's), or null.\nfn gpa_aligned(size: i64, align: i64) -> *u8 {\n    var p = 0 as *u8;\n    if unsafe { posix_memalign(&p, align as u64, size as u64) } != 0 {\n        return 0 as *u8;\n    }\n    p\n}\n\n// Gpa::try_resize to 0 bytes, or above malloc's alignment.\n#[cold]\nunsafe fn gpa_resize_slow(p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n    if new_size == 0 {\n        if old_size != 0 {\n            free(p);\n        }\n        return align as *u8;\n    }\n    let q = gpa_aligned(new_size, align);\n    if q == 0 as *u8 {\n        return q;\n    }\n    let n = if old_size < new_size { old_size } else { new_size };\n    for i in 0..n {\n        q[i] = p[i];\n    }\n    if old_size != 0 {\n");
        buf_str(out, c"        free(p);\n    }\n    q\n}\n\n// ---- Gpa's leak checks (0.16) ----\n\nimpl Gpa {\n    // The blocks allocated and not freed: -1, unknown, unless --check-alloc\n    // (the checking allocator, compiler/std/alloc_check.tach).\n    pub fn live_blocks(self) -> i64 {\n        -1\n    }\n\n    // Whether no block is left allocated (with --check-alloc, which lists\n    // them); always true without.\n    pub fn check_leaks(self) -> bool {\n        true\n    }\n}\n\n// (0.18) The checking allocator's leaks since a mark (alloc_check.tach):\n// nothing to count without --check-alloc.\nfn check_alloc_leaks_since(mark: i64) -> i64 {\n    0\n}\n\n// ---- The checking allocator's hooks for arenas (0.16) ----\n\n// With --check-alloc (CHECK_ALLOC), arenas route each allocation to the\n// checking allocator's pages (compiler/std/alloc_check.tach); without, these\n// are never called.\n\n// A block of size bytes for the allocator whose state is at owner.\nfn check_alloc_block(owner: u64, size: i64, align: i64) -> *u8 {\n    0 as *u8\n}\n\n// p, a block of owner of old_size bytes, moved to new_size bytes.\nunsafe fn check_alloc_moved(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64)\n    -> *u8 {\n    0 as *u8\n}\n\n// The blocks allocated so far: a mark for check_alloc_release.\nfn check_alloc_mark() -> i64 {\n    0\n}\n\n// Every block of owner allocated after mark given back.\nfn check_alloc_release(owner: u64, mark: i64) {}\n\n// Whether p is the last live block of owner (an arena's last block grows\n// and is given back in place).\nfn check_alloc_is_last(owner: u64, p: *u8) -> bool {\n    false\n}\n\n// The site of the call being run, and that site set again (a scope's end\n// is its call's).\nfn check_alloc_site() -> *u8 {\n    0 as *u8\n}\n\nfn check_alloc_set_site(site: *u8) {}\n");
    }
}

// The checking Gpa (0.16), the end of std's source with --check-alloc
// (front/stdalloc.tach).
pub fn std_check_gpa_source(out: i64) {
    unsafe {
        buf_str(out, c"// ---- Gpa's leak checks (0.16) ----\n\nimpl Gpa {\n    // The blocks allocated and not freed: -1, unknown, unless --check-alloc.\n    pub fn live_blocks(self) -> i64 {\n        CHECK_LIVE\n    }\n\n    // Whether no block is left allocated (with --check-alloc, which lists\n    // them); always true without.\n    pub fn check_leaks(self) -> bool {\n        unsafe { check_alloc_list_leaks() }\n        CHECK_LIVE == 0\n    }\n}\n\n// (0.18) The blocks allocated from `mark` (check_alloc_mark) on and not\n// freed, listed as at exit (the first line names them a case's): a\n// property's case, or a fuzz run, leaks them (test_case, fuzz_exec);\n// their count.\nfn check_alloc_leaks_since(mark: i64) -> i64 {\n    var live = 0;\n    var bytes = 0;\n    unsafe {\n        for b in mark..CHECK_COUNT {\n            if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n                live += 1;\n                bytes += CHECK_BLOCKS[b].size;\n            }\n        }\n        if live == 0 {\n            return 0;\n        }\n        var m = check_msg();\n        m.text(\"check-alloc: \");\n        m.int(live);\n        m.text(if live == 1 { \" block\" } else { \" blocks\" });\n        m.text(\" of Gpa not freed by the case (\");\n        m.int(bytes);\n        m.text(\" bytes):\");\n        m.out();\n        var shown = 0;\n        for b in mark..CHECK_COUNT {\n            if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK\n                && shown < 20 {\n                var line = check_msg();\n                line.text(\"  \");\n                check_describe(&line, b);\n                line.out();\n                shown += 1;\n            }\n        }\n        CHECK_LISTED = CHECK_CHANGES;\n    }\n    live\n}\n\n// ---- Gpa's implementation: the checking allocator (0.16, --check-alloc) ----\n\n// With --check-alloc (docs/design/effects-allocation.md, §2.5), Gpa gives\n");
        buf_str(out, c"// every block pages of its own, at the cursor of a large reservation of\n// address space with no access: a block's pages are made readable and\n// writable when it is allocated, and are given back with no access when it\n// is freed, never to be handed out again; every resize moves. A later\n// access to a freed block faults, and the fault handler names the block,\n// where it was allocated and where freed (the compiler stores the site of\n// each call from the program that may allocate in CHECK_ALLOC_SITE). Frees\n// are checked: double, invalid and wrong-size frees stop the program; the\n// blocks left at exit are listed. Arenas route their allocations here too\n// (check_alloc_block, check_alloc_release). Block numbers count every\n// allocation from 1, the same each run: TACHYON_ALLOC_TRAP=N raises SIGTRAP\n// when block N is allocated, for a debugger.\n\n// (Its messages and stops are the allocator's misuse, the effect `alloc`:\n// not io, which an allocator may not do.)\nextern \"C\" {\n    #[effects(alloc(extern), global)]\n    fn mmap(addr: *u8, len: u64, prot: i32, flags: i32, fd: i32, offset: i64) -> *u8;\n    #[effects(alloc(extern), global)]\n    fn mprotect(addr: *u8, len: u64, prot: i32) -> i32;\n    #[effects(global)]\n    fn getpagesize() -> i32;\n    #[effects(global)]\n    fn getenv(name: *u8) -> *u8;\n    #[effects(global)]\n    fn raise(sig: i32) -> i32;\n    #[effects(global)]\n    fn atexit(f: extern \"C\" fn()) -> i32;\n    #[effects(global)]\n    fn sigaction(sig: i32, act: *CheckSigaction, old: *CheckSigaction) -> i32;\n    #[link_name = \"write\"]\n    #[effects(global)]\n    fn check_write(fd: i32, data: *u8, count: u64) -> i64;\n    #[effects(diverge)]\n    fn _exit(code: i32) -> !;\n}\n\n// The site of the program's call being run that may allocate (`main.tach:\n// 14:9`, a C string), stored by the compiled program before the call.\nstatic var CHECK_ALLOC_SITE: *u8 = 0 as *u8;\n\n");
        buf_str(out, c"// A block: its pages [start, start + span), its size, its allocator (0:\n// Gpa, else an arena's state), its state, and where it was allocated and\n// freed.\nstruct CheckBlock {\n    start: u64,\n    size: i64,\n    span: i64,\n    owner: u64,\n    state: i64,\n    alloc_site: *u8,\n    free_site: *u8,\n}\n\nconst CHECK_LIVE_BLOCK: i64 = 1;\nconst CHECK_FREED: i64 = 2;\nconst CHECK_RELEASED: i64 = 3;\n\n// Every block, in the order allocated (block #N is CHECK_BLOCKS[N - 1]).\nstatic var CHECK_BLOCKS: *CheckBlock = 0 as *CheckBlock;\nstatic var CHECK_COUNT: i64 = 0;\nstatic var CHECK_CAP: i64 = 0;\n// The live blocks of Gpa (arenas' blocks are not counted).\nstatic var CHECK_LIVE: i64 = 0;\n// The reservations of address space (regions): their bounds and their\n// first block; a region's blocks follow each other (blocks are never\n// placed in an earlier region), so the blocks are sorted by address within\n// one. The cursor is in the last region.\nconst CHECK_MAX_REGIONS: i64 = 256;\nstatic var CHECK_REGION_START: [u64; 256] = [0; 256];\nstatic var CHECK_REGION_END: [u64; 256] = [0; 256];\nstatic var CHECK_REGION_FIRST: [i64; 256] = [0; 256];\nstatic var CHECK_REGIONS: i64 = 0;\nstatic var CHECK_CURSOR: u64 = 0;\n// The page size, 0 until the first allocation.\nstatic var CHECK_PAGE: i64 = 0;\n// TACHYON_ALLOC_TRAP; TACHYON_ALLOC_MAX_LIVE (the map limit's message when\n// this many blocks are live: for tests, on any system); 0 when unset.\nstatic var CHECK_TRAP: i64 = 0;\nstatic var CHECK_MAX_LIVE: i64 = 0;\n// The changes to the blocks (allocations and frees), and their count when\n// check_leaks listed the leaks (the exit's list is left out then).\nstatic var CHECK_CHANGES: i64 = 0;\nstatic var CHECK_LISTED: i64 = -1;\n\nconst CHECK_REGION_BYTES: u64 = 68719476736;\nconst CHECK_PROT_NONE: i32 = 0;\nconst CHECK_PROT_RW: i32 = 3;\n\n// The system's constants: macOS (CHECK_ALLOC_OS 0) and Linux (1).\nfn check_map_flags() -> i32 {\n");
        buf_str(out, c"    // MAP_PRIVATE | MAP_ANON | MAP_NORESERVE\n    if CHECK_ALLOC_OS == 1 { 2 | 32 | 16384 } else { 2 | 4096 | 64 }\n}\n\nconst CHECK_MAP_FIXED: i32 = 16;\n\nfn check_sigbus() -> i32 {\n    if CHECK_ALLOC_OS == 1 { 7 } else { 10 }\n}\n\n// struct sigaction: the handler, then (macOS) a 4-byte mask and the flags,\n// or (glibc) a 128-byte mask and the flags.\n#[repr(C)]\nstruct CheckSigaction { handler: extern \"C\" fn(i32, *u8, *u8), words: [u64; 19] }\n\nfn check_sigaction() -> CheckSigaction {\n    var a = CheckSigaction { handler: unsafe { check_alloc_fault }, words: [0; 19] };\n    if CHECK_ALLOC_OS == 1 {\n        // SA_SIGINFO | SA_RESETHAND\n        a.words[16] = 4 | 2147483648;\n    } else {\n        a.words[0] = (64 | 4) << 32;\n    }\n    a\n}\n\n// The offset of si_addr in siginfo_t.\nfn check_si_addr() -> u64 {\n    if CHECK_ALLOC_OS == 1 { 16 } else { 24 }\n}\n\n// A message, written to stderr at once.\nstruct CheckMsg { len: i64, bytes: [u8; 2048] }\n\nimpl CheckMsg {\n    fn text(inout self, s: [u8]) {\n        for i in 0..s.len {\n            if self.len < 2048 {\n                self.bytes[self.len] = s[i];\n                self.len += 1;\n            }\n        }\n    }\n\n    unsafe fn cstr(inout self, s: *u8) {\n        var n = 0;\n        while s[n] != 0 {\n            n += 1;\n        }\n        self.text(s[0..n]);\n    }\n\n    fn int(inout self, v: i64) {\n        if v < 0 {\n            self.text(\"-\");\n            self.int(0 - v);\n            return;\n        }\n        if v >= 10 {\n            self.int(v / 10);\n        }\n        let d: [u8; 1] = [('0' as i64 + v % 10) as u8];\n        self.text(d[0..1]);\n    }\n\n    fn hex(inout self, v: u64) {\n        self.text(\"0x\");\n        let digits = \"0123456789abcdef\";\n        var started = false;\n        for k in 0..16 {\n            let d = (v >> ((15 - k) * 4) as u64) & 15;\n            if d != 0 || started || k == 15 {\n                started = true;\n");
        buf_str(out, c"                self.text(digits[d as i64..d as i64 + 1]);\n            }\n        }\n    }\n\n    unsafe fn site(inout self, s: *u8) {\n        if s == 0 as *u8 {\n            self.text(\"an unknown place\");\n        } else {\n            self.cstr(s);\n        }\n    }\n\n    // `block #N (48 bytes)`, ` of an arena`.\n    fn block(inout self, b: i64) {\n        unsafe {\n            self.text(\"block #\");\n            self.int(b + 1);\n            self.text(\" (\");\n            self.int(CHECK_BLOCKS[b].size);\n            self.text(if CHECK_BLOCKS[b].size == 1 { \" byte)\" } else { \" bytes)\" });\n            if CHECK_BLOCKS[b].owner != 0 {\n                self.text(\" of an arena\");\n            }\n        }\n    }\n\n    fn out(inout self) {\n        self.text(\"\\n\");\n        unsafe {\n            check_write(2, &self.bytes[0], self.len as u64);\n        }\n    }\n}\n\nfn check_msg() -> CheckMsg {\n    CheckMsg { len: 0, bytes: [0; 2048] }\n}\n\n// Stops the program with message m (exit 101, without the leaks' list).\nfn check_stop(m: inout CheckMsg) -> ! {\n    m.out();\n    unsafe { _exit(101) }\n}\n\n// `block #N (48 bytes), allocated at X[, freed at Y]`.\nunsafe fn check_describe(m: *CheckMsg, b: i64) {\n    m.block(b);\n    m.text(\", allocated at \");\n    m.site(CHECK_BLOCKS[b].alloc_site);\n    if CHECK_BLOCKS[b].state != CHECK_LIVE_BLOCK {\n        m.text(if CHECK_BLOCKS[b].state == CHECK_FREED { \", freed at \" } else { \", released at \" });\n        m.site(CHECK_BLOCKS[b].free_site);\n        if CHECK_BLOCKS[b].state == CHECK_RELEASED {\n            m.text(\" (the arena's reset or scope end)\");\n        }\n    }\n}\n\n// The decimal number in C string s (0 when null or none).\n// (0.21: VOLE_X wins over TACHYON_X, the name from 0.24)\nunsafe fn check_env_int(vole: *u8, name: *u8) -> i64 {\n    var s = getenv(vole);\n    if s == 0 as *u8 {\n        s = getenv(name);\n    }\n    if s == 0 as *u8 {\n        return 0;\n    }\n    var v = 0;\n");
        buf_str(out, c"    var i = 0;\n    while s[i] >= '0' && s[i] <= '9' {\n        v = v * 10 + (s[i] - '0') as i64;\n        i += 1;\n    }\n    v\n}\n\n// The first allocation: the page size, the fault handlers, the leaks'\n// list at exit, the environment.\nunsafe fn check_init() {\n    CHECK_PAGE = getpagesize() as i64;\n    let a = check_sigaction();\n    sigaction(11, &a, 0 as *CheckSigaction);\n    sigaction(check_sigbus(), &a, 0 as *CheckSigaction);\n    atexit(check_alloc_at_exit);\n    CHECK_TRAP = check_env_int(c\"VOLE_ALLOC_TRAP\", c\"TACHYON_ALLOC_TRAP\");\n    CHECK_MAX_LIVE = check_env_int(c\"VOLE_ALLOC_MAX_LIVE\", c\"TACHYON_ALLOC_MAX_LIVE\");\n}\n\n// The system refused to change a block's pages: on Linux, the limit of\n// memory maps (each run of live blocks between freed ones is a map).\nunsafe fn check_map_limit() -> ! {\n    var m = check_msg();\n    m.text(\"check-alloc: out of memory maps at block #\");\n    m.int(CHECK_COUNT + 1);\n    m.text(\", with \");\n    m.int(CHECK_LIVE);\n    m.text(\" blocks live: the kernel's vm.max_map_count is reached (every live block has pages of its own)\");\n    m.text(\"\\ntry: sudo sysctl vm.max_map_count=1048576\");\n    check_stop(&m)\n}\n\n// A new region of at least `bytes`, or false.\nunsafe fn check_reserve(bytes: u64) -> bool {\n    if CHECK_REGIONS == CHECK_MAX_REGIONS {\n        return false;\n    }\n    var size = CHECK_REGION_BYTES;\n    while size < bytes {\n        size = size * 2;\n    }\n    loop {\n        let p = mmap(0 as *u8, size, CHECK_PROT_NONE, check_map_flags(), -1, 0);\n        if p as i64 != -1 {\n            let r = CHECK_REGIONS;\n            CHECK_REGION_START[r] = p as u64;\n            CHECK_REGION_END[r] = p as u64 + size;\n            CHECK_REGION_FIRST[r] = CHECK_COUNT;\n            CHECK_REGIONS += 1;\n            CHECK_CURSOR = p as u64;\n            return true;\n        }\n        // (less address space: smaller reservations)\n        if size / 2 < bytes || size <= 1073741824 {\n");
        buf_str(out, c"            return false;\n        }\n        size = size / 2;\n    }\n}\n\n// A new block of size bytes on pages of its own, for allocator owner (0:\n// Gpa), or null when out of memory.\nunsafe fn check_new_block(owner: u64, size: i64) -> *u8 {\n    if CHECK_PAGE == 0 {\n        check_init();\n    }\n    if size < 0 || size > 4611686018427387904 {\n        return 0 as *u8;\n    }\n    let page = CHECK_PAGE as u64;\n    let span = (size as u64 + page - 1) / page * page;\n    if CHECK_REGIONS == 0 || CHECK_CURSOR + span > CHECK_REGION_END[CHECK_REGIONS - 1] {\n        if !check_reserve(span) {\n            return 0 as *u8;\n        }\n    }\n    if CHECK_MAX_LIVE > 0 && CHECK_LIVE >= CHECK_MAX_LIVE {\n        check_map_limit();\n    }\n    let p = CHECK_CURSOR as *u8;\n    if mprotect(p, span, CHECK_PROT_RW) != 0 {\n        if CHECK_ALLOC_OS == 1 {\n            check_map_limit();\n        }\n        return 0 as *u8;\n    }\n    CHECK_CURSOR += span;\n    if CHECK_COUNT == CHECK_CAP {\n        CHECK_CAP = if CHECK_CAP == 0 { 1024 } else { CHECK_CAP * 2 };\n        CHECK_BLOCKS = realloc(CHECK_BLOCKS as *u8, (CHECK_CAP * size_of(CheckBlock)) as u64)\n            as *CheckBlock;\n    }\n    CHECK_BLOCKS[CHECK_COUNT] = CheckBlock {\n        start: p as u64,\n        size: size,\n        span: span as i64,\n        owner: owner,\n        state: CHECK_LIVE_BLOCK,\n        alloc_site: CHECK_ALLOC_SITE,\n        free_site: 0 as *u8,\n    };\n    CHECK_COUNT += 1;\n    CHECK_CHANGES += 1;\n    if owner == 0 {\n        CHECK_LIVE += 1;\n    }\n    if CHECK_COUNT == CHECK_TRAP {\n        var m = check_msg();\n        m.text(\"check-alloc: \");\n        check_describe(&m, CHECK_COUNT - 1);\n        m.text(\" (TACHYON_ALLOC_TRAP): SIGTRAP\");\n        m.out();\n        raise(5);\n    }\n    p\n}\n\n// Block b's pages given back, with no access, never used again.\nunsafe fn check_drop_block(b: i64, state: i64) {\n    let p = CHECK_BLOCKS[b].start as *u8;\n");
        buf_str(out, c"    let span = CHECK_BLOCKS[b].span as u64;\n    let flags = check_map_flags() | CHECK_MAP_FIXED;\n    if mmap(p, span, CHECK_PROT_NONE, flags, -1, 0) != p {\n        if CHECK_ALLOC_OS == 1 {\n            check_map_limit();\n        }\n        // (the pages keep their contents, but no access)\n        mprotect(p, span, CHECK_PROT_NONE);\n    }\n    if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n        CHECK_LIVE -= 1;\n    }\n    CHECK_BLOCKS[b].state = state;\n    CHECK_BLOCKS[b].free_site = CHECK_ALLOC_SITE;\n    CHECK_CHANGES += 1;\n}\n\n// The block whose pages hold address a; -1 when a is outside the\n// reservations, -2 when in one but in no block.\nunsafe fn check_find(a: u64) -> i64 {\n    for r in 0..CHECK_REGIONS {\n        if a >= CHECK_REGION_START[r] && a < CHECK_REGION_END[r] {\n            var lo = CHECK_REGION_FIRST[r];\n            var hi = if r + 1 < CHECK_REGIONS { CHECK_REGION_FIRST[r + 1] }\n                else { CHECK_COUNT };\n            // the last block starting at or before a\n            while lo < hi {\n                let mid = (lo + hi) / 2;\n                if CHECK_BLOCKS[mid].start <= a {\n                    lo = mid + 1;\n                } else {\n                    hi = mid;\n                }\n            }\n            let b = lo - 1;\n            if b >= CHECK_REGION_FIRST[r]\n                && a < CHECK_BLOCKS[b].start + CHECK_BLOCKS[b].span as u64 {\n                return b;\n            }\n            return -2;\n        }\n    }\n    -1\n}\n\n// The live block p of `size` bytes from allocator owner, being freed or\n// resized: its index, or the program stops.\nunsafe fn check_owned(p: *u8, size: i64, owner: u64, freeing: bool) -> i64 {\n    let b = check_find(p as u64);\n    var m = check_msg();\n    if b < 0 || CHECK_BLOCKS[b].start != p as u64 {\n        m.text(if freeing { \"invalid free at \" } else { \"invalid resize at \" });\n        m.site(CHECK_ALLOC_SITE);\n");
        buf_str(out, c"        m.text(\": \");\n        m.hex(p as u64);\n        if b >= 0 {\n            m.text(\" is \");\n            m.int((p as u64 - CHECK_BLOCKS[b].start) as i64);\n            m.text(\" bytes into \");\n            check_describe(&m, b);\n        } else {\n            m.text(if owner == 0 { \" is not a block of Gpa\" }\n                else { \" is not a block of the arena\" });\n        }\n        check_stop(&m);\n    }\n    if CHECK_BLOCKS[b].state != CHECK_LIVE_BLOCK {\n        m.text(if freeing { \"double free: \" } else { \"resize after free: \" });\n        check_describe(&m, b);\n        m.text(if freeing { \", freed again at \" } else { \", resized at \" });\n        m.site(CHECK_ALLOC_SITE);\n        check_stop(&m);\n    }\n    if CHECK_BLOCKS[b].owner != owner {\n        m.text(if freeing { \"invalid free at \" } else { \"invalid resize at \" });\n        m.site(CHECK_ALLOC_SITE);\n        m.text(\": \");\n        check_describe(&m, b);\n        m.text(if owner == 0 { \", given to Gpa\" } else { \", given to another allocator\" });\n        check_stop(&m);\n    }\n    if CHECK_BLOCKS[b].size != size {\n        m.text(if freeing { \"wrong-size free: \" } else { \"wrong-size resize: \" });\n        check_describe(&m, b);\n        m.text(if freeing { \", freed as \" } else { \", resized as \" });\n        m.int(size);\n        m.text(if size == 1 { \" byte at \" } else { \" bytes at \" });\n        m.site(CHECK_ALLOC_SITE);\n        check_stop(&m);\n    }\n    b\n}\n\n// p (old_size bytes from owner) moved to a new block of new_size bytes, or\n// null (p untouched).\nunsafe fn check_move(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n    if old_size == 0 {\n        return check_alloc_block(owner, new_size, align);\n    }\n    let b = check_owned(p, old_size, owner, false);\n    if new_size == 0 {\n        check_drop_block(b, CHECK_FREED);\n        return align as *u8;\n    }\n    let q = check_new_block(owner, new_size);\n");
        buf_str(out, c"    if q == 0 as *u8 {\n        return q;\n    }\n    memcpy(q, p, (if old_size < new_size { old_size } else { new_size }) as u64);\n    check_drop_block(b, CHECK_FREED);\n    q\n}\n\n// (Arenas, with --check-alloc) A block of size bytes on pages of its own\n// for the allocator whose state is at owner (0: Gpa), or null; size 0: an\n// aligned pointer, no block.\nfn check_alloc_block(owner: u64, size: i64, align: i64) -> *u8 {\n    if size == 0 {\n        return unsafe { align as *u8 };\n    }\n    unsafe { check_new_block(owner, size) }\n}\n\n// (Arenas) p, a block of owner of old_size bytes, moved to new_size bytes.\nunsafe fn check_alloc_moved(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64)\n    -> *u8 {\n    check_move(owner, p, old_size, new_size, align)\n}\n\n// (Arenas) The blocks allocated so far: a mark for check_alloc_release.\nfn check_alloc_mark() -> i64 {\n    CHECK_COUNT\n}\n\n// (Arenas: a reset, a scope's end) Every block of owner allocated after\n// mark is given back: a later access faults.\nfn check_alloc_release(owner: u64, mark: i64) {\n    unsafe {\n        for b in mark..CHECK_COUNT {\n            if CHECK_BLOCKS[b].owner == owner && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n                check_drop_block(b, CHECK_RELEASED);\n            }\n        }\n    }\n}\n\n// (Arenas) The site of the call being run, and that site set again: a\n// scope's end is reported at the scope's call, not at the last call in it.\nfn check_alloc_site() -> *u8 {\n    unsafe { CHECK_ALLOC_SITE }\n}\n\nfn check_alloc_set_site(site: *u8) {\n    unsafe {\n        CHECK_ALLOC_SITE = site;\n    }\n}\n\n// (Arenas) Whether p starts the last live block of owner: the block an\n// arena grows, or gives back, in place.\nfn check_alloc_is_last(owner: u64, p: *u8) -> bool {\n    unsafe {\n        for k in 0..CHECK_COUNT {\n            let b = CHECK_COUNT - 1 - k;\n            if CHECK_BLOCKS[b].owner == owner && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"                return CHECK_BLOCKS[b].start == p as u64;\n            }\n        }\n        false\n    }\n}\n\n// (--check-unsafe with --check-alloc) The access of size bytes at p:\n// false when p is no memory of the checking allocator, true when it is in\n// bounds of a live block; else the program stops.\npub unsafe fn check_alloc_access(p: u64, size: u64, site: *u8) -> bool {\n    let b = check_find(p);\n    if b == -1 {\n        return false;\n    }\n    var m = check_msg();\n    if b >= 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n        if p + size <= CHECK_BLOCKS[b].start + CHECK_BLOCKS[b].size as u64 {\n            return true;\n        }\n        m.text(\"unsafe access out of bounds: \");\n    } else if b >= 0 {\n        m.text(\"unsafe access after free: \");\n    } else {\n        m.text(\"unsafe access outside every block: \");\n    }\n    m.int(size as i64);\n    m.text(if size == 1 { \" byte at \" } else { \" bytes at \" });\n    if b >= 0 {\n        m.text(\"offset \");\n        m.int((p - CHECK_BLOCKS[b].start) as i64);\n        m.text(\" of \");\n        check_describe(&m, b);\n    } else {\n        m.hex(p);\n    }\n    m.text(\"\\n --> \");\n    m.site(site);\n    check_stop(&m)\n}\n\n// SIGSEGV, SIGBUS: an access to a freed block (or to the pages after the\n// last one) is reported; any other fault happens again with the default\n// action (SA_RESETHAND), as without --check-alloc.\nextern \"C\" fn check_alloc_fault(sig: i32, info: *u8, context: *u8) {\n    unsafe {\n        let a = *((info as u64 + check_si_addr()) as *u64);\n        let b = check_find(a);\n        if b == -1 {\n            return;\n        }\n        var m = check_msg();\n        if b >= 0 {\n            m.text(if CHECK_BLOCKS[b].state == CHECK_RELEASED { \"use after release: \" }\n                else { \"use after free: \" });\n            check_describe(&m, b);\n        } else {\n            m.text(\"access outside every block: \");\n            m.hex(a);\n");
        buf_str(out, c"            m.text(\" (memory the checking allocator never handed out)\");\n        }\n        check_stop(&m);\n    }\n}\n\n// The live blocks of Gpa, listed (at most 20).\nunsafe fn check_alloc_list_leaks() {\n    CHECK_LISTED = CHECK_CHANGES;\n    if CHECK_LIVE <= 0 {\n        return;\n    }\n    var m = check_msg();\n    var bytes = 0;\n    for b in 0..CHECK_COUNT {\n        if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n            bytes += CHECK_BLOCKS[b].size;\n        }\n    }\n    m.text(\"check-alloc: \");\n    m.int(CHECK_LIVE);\n    m.text(if CHECK_LIVE == 1 { \" block\" } else { \" blocks\" });\n    m.text(\" of Gpa not freed (\");\n    m.int(bytes);\n    m.text(\" bytes):\");\n    m.out();\n    var shown = 0;\n    for b in 0..CHECK_COUNT {\n        if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n            if shown == 20 {\n                var more = check_msg();\n                more.text(\"  and \");\n                more.int(CHECK_LIVE - shown);\n                more.text(\" more\");\n                more.out();\n                return;\n            }\n            var line = check_msg();\n            line.text(\"  \");\n            check_describe(&line, b);\n            line.out();\n            shown += 1;\n        }\n    }\n}\n\n// At exit: the leaks, unless check_leaks listed them and nothing changed\n// since.\nextern \"C\" fn check_alloc_at_exit() {\n    unsafe {\n        if CHECK_LISTED != CHECK_CHANGES {\n            check_alloc_list_leaks();\n        }\n    }\n}\n\nimpl Allocator for Gpa {\n    fn try_alloc(self: *Gpa, size: i64, align: i64) -> *u8 {\n        check_alloc_block(0, size, align)\n    }\n\n    unsafe fn try_resize(self: *Gpa, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n        check_move(0, p, old_size, new_size, align)\n    }\n\n    unsafe fn free(self: *Gpa, p: *u8, size: i64, align: i64) {\n        if size == 0 && check_find(p as u64) == -1 {\n");
        buf_str(out, c"            return;\n        }\n        check_drop_block(check_owned(p, size, 0, true), CHECK_FREED);\n    }\n}\n");
    }
}

// (0.20) The end of std's text, after std::CHECK_ALLOC: the target's
// system, sys/linux.tach or sys/macos.tach (front/stdalloc.tach), the
// same length, std_sys_len bytes, so that one index holds for both.
pub fn std_sys_source(out: i64, linux: bool) {
    unsafe {
        if linux {
            buf_str(out, c"// ---- The target's system (0.20) ----\n\n// The end of std's text (front/stdalloc.tach, std_sys_source): what differs\n// between the targets' C libraries, for sys/unix.tach. sys/macos.tach has\n// the same items, in the same order, and the same length to the byte\n// (embed.sh checks it), so that std's index holds for every target; the\n// numbers are written as 8 hex digits for that.\n// (Linux's values, aarch64 glibc: <fcntl.h>, <errno.h>, <time.h>, ioctls\n// <asm/ioctls.h>, <signal.h>; errno: __errno_location().)\n\n// 0: macOS, 1: Linux.\npub const TARGET_OS: i64 = 0x00000001;\n\npub const SYS_O_CREAT: i32 = 0x00000040;\npub const SYS_O_TRUNC: i32 = 0x00000200;\npub const SYS_O_APPEND: i32 = 0x00000400;\npub const SYS_O_EXCL: i32 = 0x00000080;\npub const SYS_O_NONBLOCK: i32 = 0x00000800;\npub const SYS_O_CLOEXEC: i32 = 0x00080000;\npub const SYS_O_NOCTTY: i32 = 0x00000100;\npub const SYS_O_DIRECTORY: i32 = 0x00004000;\n\npub const SYS_EAGAIN: i32 = 0x0000000b;\npub const SYS_ENOTEMPTY: i32 = 0x00000027;\npub const SYS_ETIMEDOUT: i32 = 0x0000006e;\npub const SYS_ENOSYS: i32 = 0x00000026;\npub const SYS_ENOTSUP: i32 = 0x0000005f;\npub const SYS_ENAMETOOLONG: i32 = 0x00000024;\npub const SYS_ELOOP: i32 = 0x00000028;\n\npub const SYS_CLOCK_MONOTONIC: i32 = 0x00000001;\npub const SYS_PATH_MAX: i64 = 0x00001000;\npub const SYS_SIGCHLD: i32 = 0x00000011;\npub const SYS_TIOCSWINSZ: u64 = 0x00005414;\npub const SYS_TIOCGWINSZ: u64 = 0x00005413;\npub const SYS_TIOCSCTTY: u64 = 0x0000540e;\n\nextern \"C\" {\n    #[link_name = \"__errno_location\"]\n    #[effects(global)]\n    fn sys_errno_location() -> *i32;\n}\n\n// (0.20) The program's arguments (std::env::args): argc, and argv, its C\n// strings. Linux: /proc/self/cmdline, read once (up to 128 KB and 4096\n// arguments) into std's statics, its NULs ending each argument.\nstatic var SYS_ARG_TEXT: [u8; 131072] = [0; 131072];\nstatic var SYS_ARG_PTRS: [*u8; 4097] = [0 as *u8; 4097];\nstatic var SYS_ARG_COUNT: i64 = -1;\n");
            buf_str(out, c"\npub fn sys_args() -> (i64, **u8) {\n    if SYS_ARG_COUNT < 0 {\n        SYS_ARG_COUNT = 0;\n        var len = 0;\n        match std::sys::sys_open(\"/proc/self/cmdline\", 0, 0) {\n            Ok(fd) => {\n                loop {\n                    let n = match std::sys::sys_read(fd, &SYS_ARG_TEXT[len..131071]) {\n                        Ok(n) => n,\n                        Err(_) => 0,\n                    };\n                    if n <= 0 {\n                        break;\n                    }\n                    len += n;\n                }\n                let _ = std::sys::sys_close(fd);\n            }\n            Err(_) => {}\n        }\n        var start = 0;\n        for i in 0..len {\n            if SYS_ARG_TEXT[i] == 0 && SYS_ARG_COUNT < 4096 {\n                SYS_ARG_PTRS[SYS_ARG_COUNT] = &SYS_ARG_TEXT[start] as *u8;\n                SYS_ARG_COUNT += 1;\n                start = i + 1;\n            }\n        }\n    }\n    (SYS_ARG_COUNT, &SYS_ARG_PTRS[0] as **u8)\n}\n// (padding: the two systems' files are the same length)---------------\n");
        } else {
            buf_str(out, c"// ---- The target's system (0.20) ----\n\n// The end of std's text (front/stdalloc.tach, std_sys_source): what differs\n// between the targets' C libraries, for sys/unix.tach. sys/linux.tach has\n// the same items, in the same order, and the same length to the byte\n// (embed.sh checks it), so that std's index holds for every target; the\n// numbers are written as 8 hex digits for that.\n// (macOS's values: <sys/fcntl.h>, <sys/errno.h>, <time.h>, <sys/ttycom.h>,\n// <sys/signal.h>; errno is the int that __error() points to, C.)\n\n// 0: macOS, 1: Linux.\npub const TARGET_OS: i64 = 0x00000000;\n\npub const SYS_O_CREAT: i32 = 0x00000200;\npub const SYS_O_TRUNC: i32 = 0x00000400;\npub const SYS_O_APPEND: i32 = 0x00000008;\npub const SYS_O_EXCL: i32 = 0x00000800;\npub const SYS_O_NONBLOCK: i32 = 0x00000004;\npub const SYS_O_CLOEXEC: i32 = 0x01000000;\npub const SYS_O_NOCTTY: i32 = 0x00020000;\npub const SYS_O_DIRECTORY: i32 = 0x00100000;\n\npub const SYS_EAGAIN: i32 = 0x00000023;\npub const SYS_ENOTEMPTY: i32 = 0x00000042;\npub const SYS_ETIMEDOUT: i32 = 0x0000003c;\npub const SYS_ENOSYS: i32 = 0x0000004e;\npub const SYS_ENOTSUP: i32 = 0x0000002d;\npub const SYS_ENAMETOOLONG: i32 = 0x0000003f;\npub const SYS_ELOOP: i32 = 0x0000003e;\n\npub const SYS_CLOCK_MONOTONIC: i32 = 0x00000006;\npub const SYS_PATH_MAX: i64 = 0x00000400;\npub const SYS_SIGCHLD: i32 = 0x00000014;\npub const SYS_TIOCSWINSZ: u64 = 0x80087467;\npub const SYS_TIOCGWINSZ: u64 = 0x40087468;\npub const SYS_TIOCSCTTY: u64 = 0x20007461;\n\nextern \"C\" {\n    #[link_name = \"__error\"]\n    #[effects(global)]\n    fn sys_errno_location() -> *i32;\n}\n\n// (0.20) The program's arguments (std::env::args): argc, and argv, its C\n// strings. macOS: crt's own, which _NSGetArgc and _NSGetArgv point to.\npub fn sys_args() -> (i64, **u8) {\n    // (libSystem's pointers to crt's argc and argv, set before main)\n    unsafe { (*sys_argc_location() as i64, *sys_argv_location()) }\n}\n\nextern \"C\" {\n");
            buf_str(out, c"    #[link_name = \"_NSGetArgc\"]\n    #[effects(global)]\n    fn sys_argc_location() -> *i32;\n    #[link_name = \"_NSGetArgv\"]\n    #[effects(global)]\n    fn sys_argv_location() -> ***u8;\n}\n// (padding: the two systems' files are the same length)\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//--------------------------\n");
        }
    }
}

pub fn std_sys_len() -> i64 {
    2987
}

