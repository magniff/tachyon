        buf_str(out, c"];\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Numbers: the slow path's digits of 5^s (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// For each shift s from 0 to 64: (the decimal digits 2^s adds, at\n");
        buf_str(out, c"// most) << 11 | where 5^s's digits start in POW5_DIGITS (Rust's\n");
        buf_str(out, c"// number_of_digits_decimal_left_shift).\n");
        buf_str(out, c"pub static LSHIFT_TABLE: [u16; 65] = [\n");
        buf_str(out, c"    0, 2048, 2049, 2051, 4102, 4105, 4109, 6162,\n");
        buf_str(out, c"    6167, 6173, 8228, 8235, 8243, 8252, 10310, 10320,\n");
        buf_str(out, c"    10331, 12391, 12403, 12416, 14478, 14492, 14507, 14523,\n");
        buf_str(out, c"    16588, 16605, 16623, 18690, 18709, 18729, 20798, 20819,\n");
        buf_str(out, c"    20841, 20864, 22936, 22960, 22985, 25059, 25085, 25112,\n");
        buf_str(out, c"    27188, 27216, 27245, 27275, 29354, 29385, 29417, 31498,\n");
        buf_str(out, c"    31531, 31565, 33648, 33683, 33719, 33756, 35842, 35880,\n");
        buf_str(out, c"    35919, 38007, 38047, 38088, 40178, 1308, 1308, 1308,\n");
        buf_str(out, c"    1308,\n");
        buf_str(out, c"];\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The decimal digits of 5^1, 5^2, .. 5^60, one after the other, as text.\n");
        buf_str(out, c"pub const POW5_DIGITS: [u8] = \"\";\n");
        buf_str(out, c"// ---- end mod std::num::tables ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::num ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::convert ----\n");
        buf_str(out, c"pub mod convert {\n");
        buf_str(out, c"// std::convert: From and Into (0.20: from flat/convert.tach).\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `AppError::from(e)`; what `?` converts an error with.\n");
        buf_str(out, c"pub trait From<T> { fn from(x: T) -> Self; }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Implement From, not Into.\n");
        buf_str(out, c"pub trait Into<T> { fn into(self: Self) -> T; }\n");
        buf_str(out, c"// ---- end mod std::convert ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::clone ----\n");
        buf_str(out, c"pub mod clone {\n");
        buf_str(out, c"// std::clone: the Clone trait (0.20: from flat/clone.tach).\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A copy owning its memory (a Vec's elements are cloned).\n");
        buf_str(out, c"pub trait Clone { fn clone(self: &Self) -> Self; }\n");
        buf_str(out, c"// ---- end mod std::clone ----\n");
        buf_str(out, c"}\n");
    }
    std_alloc_tail(out);
}

// Gpa's implementation (0.16), the end of std's source unless
// --check-alloc (front/stdalloc.tach).
pub fn std_gpa_source(out: i64) {
    unsafe {
        buf_str(out, c"// ---- Gpa's implementation (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// C's allocator; malloc's memory is aligned to 16, larger alignments go\n");
        buf_str(out, c"// through posix_memalign. (--check-alloc replaces this part of std with\n");
        buf_str(out, c"// alloc_check.tach.)\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[effects(alloc(extern))]\n");
        buf_str(out, c"    fn posix_memalign(out: **u8, align: u64, size: u64) -> i32;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"const GPA_MALLOC_ALIGN: i64 = 16;\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Allocator for Gpa {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn try_alloc(self: *Gpa, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        if size == 0 {\n");
        buf_str(out, c"            // (a pointer nothing is read through)\n");
        buf_str(out, c"            return unsafe { align as *u8 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if align > GPA_MALLOC_ALIGN {\n");
        buf_str(out, c"            return gpa_aligned(size, align);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe { malloc(size as u64) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn try_resize(self: *Gpa, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        if align > GPA_MALLOC_ALIGN || new_size == 0 {\n");
        buf_str(out, c"            return gpa_resize_slow(p, old_size, new_size, align);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        realloc(if old_size == 0 { 0 as *u8 } else { p }, new_size as u64)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn free(self: *Gpa, p: *u8, size: i64, align: i64) {\n");
        buf_str(out, c"        if size != 0 {\n");
        buf_str(out, c"            free(p);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// size bytes (not 0) aligned to align (above malloc's), or null.\n");
        buf_str(out, c"fn gpa_aligned(size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    let mut p = 0 as *u8;\n");
        buf_str(out, c"    if unsafe { posix_memalign(&p, align as u64, size as u64) } != 0 {\n");
        buf_str(out, c"        return 0 as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    p\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Gpa::try_resize to 0 bytes, or above malloc's alignment.\n");
        buf_str(out, c"#[cold]\n");
        buf_str(out, c"unsafe fn gpa_resize_slow(p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    if new_size == 0 {\n");
        buf_str(out, c"        if old_size != 0 {\n");
        buf_str(out, c"            free(p);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return align as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let q = gpa_aligned(new_size, align);\n");
        buf_str(out, c"    if q == 0 as *u8 {\n");
        buf_str(out, c"        return q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let n = if old_size < new_size { old_size } else { new_size };\n");
        buf_str(out, c"    for i in 0..n {\n");
        buf_str(out, c"        q[i] = p[i];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if old_size != 0 {\n");
        buf_str(out, c"        free(p);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    q\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Gpa's leak checks (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Gpa {\n");
        buf_str(out, c"    // The blocks allocated and not freed: -1, unknown, unless --check-alloc\n");
        buf_str(out, c"    // (the checking allocator, compiler/std/alloc_check.tach).\n");
        buf_str(out, c"    pub fn live_blocks(self: &Gpa) -> i64 {\n");
        buf_str(out, c"        -1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether no block is left allocated (with --check-alloc, which lists\n");
        buf_str(out, c"    // them); always true without.\n");
        buf_str(out, c"    pub fn check_leaks(self: &Gpa) -> bool {\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) The checking allocator's leaks since a mark (alloc_check.tach):\n");
        buf_str(out, c"// nothing to count without --check-alloc.\n");
        buf_str(out, c"fn check_alloc_leaks_since(mark: i64) -> i64 {\n");
        buf_str(out, c"    0\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- The checking allocator's hooks for arenas (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// With --check-alloc (CHECK_ALLOC), arenas route each allocation to the\n");
        buf_str(out, c"// checking allocator's pages (compiler/std/alloc_check.tach); without, these\n");
        buf_str(out, c"// are never called.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A block of size bytes for the allocator whose state is at owner.\n");
        buf_str(out, c"fn check_alloc_block(owner: u64, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    0 as *u8\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// p, a block of owner of old_size bytes, moved to new_size bytes.\n");
        buf_str(out, c"unsafe fn check_alloc_moved(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"    -> *u8 {\n");
        buf_str(out, c"    0 as *u8\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The blocks allocated so far: a mark for check_alloc_release.\n");
        buf_str(out, c"fn check_alloc_mark() -> i64 {\n");
        buf_str(out, c"    0\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Every block of owner allocated after mark given back.\n");
        buf_str(out, c"fn check_alloc_release(owner: u64, mark: i64) {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether p is the last live block of owner (an arena's last block grows\n");
        buf_str(out, c"// and is given back in place).\n");
        buf_str(out, c"fn check_alloc_is_last(owner: u64, p: *u8) -> bool {\n");
        buf_str(out, c"    false\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The site of the call being run, and that site set again (a scope's end\n");
        buf_str(out, c"// is its call's).\n");
        buf_str(out, c"fn check_alloc_site() -> *u8 {\n");
        buf_str(out, c"    0 as *u8\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn check_alloc_set_site(site: *u8) {}\n");
    }
}

// The checking Gpa (0.16), the end of std's source with --check-alloc
// (front/stdalloc.tach).
pub fn std_check_gpa_source(out: i64) {
    unsafe {
        buf_str(out, c"// ---- Gpa's leak checks (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Gpa {\n");
        buf_str(out, c"    // The blocks allocated and not freed: -1, unknown, unless --check-alloc.\n");
        buf_str(out, c"    pub fn live_blocks(self: &Gpa) -> i64 {\n");
        buf_str(out, c"        CHECK_LIVE\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether no block is left allocated (with --check-alloc, which lists\n");
        buf_str(out, c"    // them); always true without.\n");
        buf_str(out, c"    pub fn check_leaks(self: &Gpa) -> bool {\n");
        buf_str(out, c"        unsafe { check_alloc_list_leaks() }\n");
        buf_str(out, c"        CHECK_LIVE == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) The blocks allocated from `mark` (check_alloc_mark) on and not\n");
        buf_str(out, c"// freed, listed as at exit (the first line names them a case's): a\n");
        buf_str(out, c"// property's case, or a fuzz run, leaks them (test_case, fuzz_exec);\n");
        buf_str(out, c"// their count.\n");
        buf_str(out, c"fn check_alloc_leaks_since(mark: i64) -> i64 {\n");
        buf_str(out, c"    let mut live = 0;\n");
        buf_str(out, c"    let mut bytes = 0;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        for b in mark..CHECK_COUNT {\n");
        buf_str(out, c"            if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"                live += 1;\n");
        buf_str(out, c"                bytes += CHECK_BLOCKS[b].size;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if live == 0 {\n");
        buf_str(out, c"            return 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let mut m = check_msg();\n");
        buf_str(out, c"        m.text(\"check-alloc: \");\n");
        buf_str(out, c"        m.int(live);\n");
        buf_str(out, c"        m.text(if live == 1 { \" block\" } else { \" blocks\" });\n");
        buf_str(out, c"        m.text(\" of Gpa not freed by the case (\");\n");
        buf_str(out, c"        m.int(bytes);\n");
        buf_str(out, c"        m.text(\" bytes):\");\n");
        buf_str(out, c"        m.out();\n");
        buf_str(out, c"        let mut shown = 0;\n");
        buf_str(out, c"        for b in mark..CHECK_COUNT {\n");
        buf_str(out, c"            if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK\n");
        buf_str(out, c"                && shown < 20 {\n");
        buf_str(out, c"                let mut line = check_msg();\n");
        buf_str(out, c"                line.text(\"  \");\n");
        buf_str(out, c"                check_describe(&line, b);\n");
        buf_str(out, c"                line.out();\n");
        buf_str(out, c"                shown += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        CHECK_LISTED = CHECK_CHANGES;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    live\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Gpa's implementation: the checking allocator (0.16, --check-alloc) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// With --check-alloc (docs/design/effects-allocation.md, §2.5), Gpa gives\n");
        buf_str(out, c"// every block pages of its own, at the cursor of a large reservation of\n");
        buf_str(out, c"// address space with no access: a block's pages are made readable and\n");
        buf_str(out, c"// writable when it is allocated, and are given back with no access when it\n");
        buf_str(out, c"// is freed, never to be handed out again; every resize moves. A later\n");
        buf_str(out, c"// access to a freed block faults, and the fault handler names the block,\n");
        buf_str(out, c"// where it was allocated and where freed (the compiler stores the site of\n");
        buf_str(out, c"// each call from the program that may allocate in CHECK_ALLOC_SITE). Frees\n");
        buf_str(out, c"// are checked: double, invalid and wrong-size frees stop the program; the\n");
        buf_str(out, c"// blocks left at exit are listed. Arenas route their allocations here too\n");
        buf_str(out, c"// (check_alloc_block, check_alloc_release). Block numbers count every\n");
        buf_str(out, c"// allocation from 1, the same each run: TACHYON_ALLOC_TRAP=N raises SIGTRAP\n");
        buf_str(out, c"// when block N is allocated, for a debugger.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Its messages and stops are the allocator's misuse, the effect `alloc`:\n");
        buf_str(out, c"// not io, which an allocator may not do.)\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[effects(alloc(extern), global)]\n");
        buf_str(out, c"    fn mmap(addr: *u8, len: u64, prot: i32, flags: i32, fd: i32, offset: i64) -> *u8;\n");
        buf_str(out, c"    #[effects(alloc(extern), global)]\n");
        buf_str(out, c"    fn mprotect(addr: *u8, len: u64, prot: i32) -> i32;\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn getpagesize() -> i32;\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn getenv(name: *u8) -> *u8;\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn raise(sig: i32) -> i32;\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn atexit(f: extern \"C\" fn()) -> i32;\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn sigaction(sig: i32, act: *CheckSigaction, old: *CheckSigaction) -> i32;\n");
        buf_str(out, c"    #[link_name = \"write\"]\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn check_write(fd: i32, data: *u8, count: u64) -> i64;\n");
        buf_str(out, c"    #[effects(diverge)]\n");
        buf_str(out, c"    fn _exit(code: i32) -> !;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The site of the program's call being run that may allocate (`main.tach:\n");
        buf_str(out, c"// 14:9`, a C string), stored by the compiled program before the call.\n");
        buf_str(out, c"static mut CHECK_ALLOC_SITE: *u8 = 0 as *u8;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A block: its pages [start, start + span), its size, its allocator (0:\n");
        buf_str(out, c"// Gpa, else an arena's state), its state, and where it was allocated and\n");
        buf_str(out, c"// freed.\n");
        buf_str(out, c"struct CheckBlock {\n");
        buf_str(out, c"    start: u64,\n");
        buf_str(out, c"    size: i64,\n");
        buf_str(out, c"    span: i64,\n");
        buf_str(out, c"    owner: u64,\n");
        buf_str(out, c"    state: i64,\n");
        buf_str(out, c"    alloc_site: *u8,\n");
        buf_str(out, c"    free_site: *u8,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"const CHECK_LIVE_BLOCK: i64 = 1;\n");
        buf_str(out, c"const CHECK_FREED: i64 = 2;\n");
        buf_str(out, c"const CHECK_RELEASED: i64 = 3;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Every block, in the order allocated (block #N is CHECK_BLOCKS[N - 1]).\n");
        buf_str(out, c"static mut CHECK_BLOCKS: *CheckBlock = 0 as *CheckBlock;\n");
        buf_str(out, c"static mut CHECK_COUNT: i64 = 0;\n");
        buf_str(out, c"static mut CHECK_CAP: i64 = 0;\n");
        buf_str(out, c"// The live blocks of Gpa (arenas' blocks are not counted).\n");
        buf_str(out, c"static mut CHECK_LIVE: i64 = 0;\n");
        buf_str(out, c"// The reservations of address space (regions): their bounds and their\n");
        buf_str(out, c"// first block; a region's blocks follow each other (blocks are never\n");
        buf_str(out, c"// placed in an earlier region), so the blocks are sorted by address within\n");
        buf_str(out, c"// one. The cursor is in the last region.\n");
        buf_str(out, c"const CHECK_MAX_REGIONS: i64 = 256;\n");
        buf_str(out, c"static mut CHECK_REGION_START: [u64; 256] = [0; 256];\n");
        buf_str(out, c"static mut CHECK_REGION_END: [u64; 256] = [0; 256];\n");
        buf_str(out, c"static mut CHECK_REGION_FIRST: [i64; 256] = [0; 256];\n");
        buf_str(out, c"static mut CHECK_REGIONS: i64 = 0;\n");
        buf_str(out, c"static mut CHECK_CURSOR: u64 = 0;\n");
        buf_str(out, c"// The page size, 0 until the first allocation.\n");
        buf_str(out, c"static mut CHECK_PAGE: i64 = 0;\n");
        buf_str(out, c"// TACHYON_ALLOC_TRAP; TACHYON_ALLOC_MAX_LIVE (the map limit's message when\n");
        buf_str(out, c"// this many blocks are live: for tests, on any system); 0 when unset.\n");
        buf_str(out, c"static mut CHECK_TRAP: i64 = 0;\n");
        buf_str(out, c"static mut CHECK_MAX_LIVE: i64 = 0;\n");
        buf_str(out, c"// The changes to the blocks (allocations and frees), and their count when\n");
        buf_str(out, c"// check_leaks listed the leaks (the exit's list is left out then).\n");
        buf_str(out, c"static mut CHECK_CHANGES: i64 = 0;\n");
        buf_str(out, c"static mut CHECK_LISTED: i64 = -1;\n");
        buf_str(out, c"\n");
        buf_str(out, c"const CHECK_REGION_BYTES: u64 = 68719476736;\n");
        buf_str(out, c"const CHECK_PROT_NONE: i32 = 0;\n");
        buf_str(out, c"const CHECK_PROT_RW: i32 = 3;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The system's constants: macOS (CHECK_ALLOC_OS 0) and Linux (1).\n");
        buf_str(out, c"fn check_map_flags() -> i32 {\n");
        buf_str(out, c"    // MAP_PRIVATE | MAP_ANON | MAP_NORESERVE\n");
        buf_str(out, c"    if CHECK_ALLOC_OS == 1 { 2 | 32 | 16384 } else { 2 | 4096 | 64 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"const CHECK_MAP_FIXED: i32 = 16;\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn check_sigbus() -> i32 {\n");
        buf_str(out, c"    if CHECK_ALLOC_OS == 1 { 7 } else { 10 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// struct sigaction: the handler, then (macOS) a 4-byte mask and the flags,\n");
        buf_str(out, c"// or (glibc) a 128-byte mask and the flags.\n");
        buf_str(out, c"#[repr(C)]\n");
        buf_str(out, c"struct CheckSigaction { handler: extern \"C\" fn(i32, *u8, *u8), words: [u64; 19] }\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn check_sigaction() -> CheckSigaction {\n");
        buf_str(out, c"    let mut a = CheckSigaction { handler: unsafe { check_alloc_fault }, words: [0; 19] };\n");
        buf_str(out, c"    if CHECK_ALLOC_OS == 1 {\n");
        buf_str(out, c"        // SA_SIGINFO | SA_RESETHAND\n");
        buf_str(out, c"        a.words[16] = 4 | 2147483648;\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        a.words[0] = (64 | 4) << 32;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    a\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The offset of si_addr in siginfo_t.\n");
        buf_str(out, c"fn check_si_addr() -> u64 {\n");
        buf_str(out, c"    if CHECK_ALLOC_OS == 1 { 16 } else { 24 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A message, written to stderr at once.\n");
        buf_str(out, c"struct CheckMsg { len: i64, bytes: [u8; 2048] }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl CheckMsg {\n");
        buf_str(out, c"    fn text(self: &mut CheckMsg, s: [u8]) {\n");
        buf_str(out, c"        for i in 0..s.len {\n");
        buf_str(out, c"            if self.len < 2048 {\n");
        buf_str(out, c"                self.bytes[self.len] = s[i];\n");
        buf_str(out, c"                self.len += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    unsafe fn cstr(self: &mut CheckMsg, s: *u8) {\n");
        buf_str(out, c"        let mut n = 0;\n");
        buf_str(out, c"        while s[n] != 0 {\n");
        buf_str(out, c"            n += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.text(s[0..n]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn int(self: &mut CheckMsg, v: i64) {\n");
        buf_str(out, c"        if v < 0 {\n");
        buf_str(out, c"            self.text(\"-\");\n");
        buf_str(out, c"            self.int(0 - v);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if v >= 10 {\n");
        buf_str(out, c"            self.int(v / 10);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let d: [u8; 1] = [('0' as i64 + v % 10) as u8];\n");
        buf_str(out, c"        self.text(d[0..1]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn hex(self: &mut CheckMsg, v: u64) {\n");
        buf_str(out, c"        self.text(\"0x\");\n");
        buf_str(out, c"        let digits = \"0123456789abcdef\";\n");
        buf_str(out, c"        let mut started = false;\n");
        buf_str(out, c"        for k in 0..16 {\n");
        buf_str(out, c"            let d = (v >> ((15 - k) * 4) as u64) & 15;\n");
        buf_str(out, c"            if d != 0 || started || k == 15 {\n");
        buf_str(out, c"                started = true;\n");
        buf_str(out, c"                self.text(digits[d as i64..d as i64 + 1]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    unsafe fn site(self: &mut CheckMsg, s: *u8) {\n");
        buf_str(out, c"        if s == 0 as *u8 {\n");
        buf_str(out, c"            self.text(\"an unknown place\");\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.cstr(s);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // `block #N (48 bytes)`, ` of an arena`.\n");
        buf_str(out, c"    fn block(self: &mut CheckMsg, b: i64) {\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.text(\"block #\");\n");
        buf_str(out, c"            self.int(b + 1);\n");
        buf_str(out, c"            self.text(\" (\");\n");
        buf_str(out, c"            self.int(CHECK_BLOCKS[b].size);\n");
        buf_str(out, c"            self.text(if CHECK_BLOCKS[b].size == 1 { \" byte)\" } else { \" bytes)\" });\n");
        buf_str(out, c"            if CHECK_BLOCKS[b].owner != 0 {\n");
        buf_str(out, c"                self.text(\" of an arena\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn out(self: &mut CheckMsg) {\n");
        buf_str(out, c"        self.text(\"\\n\");\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            check_write(2, &self.bytes[0], self.len as u64);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn check_msg() -> CheckMsg {\n");
        buf_str(out, c"    CheckMsg { len: 0, bytes: [0; 2048] }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Stops the program with message m (exit 101, without the leaks' list).\n");
        buf_str(out, c"fn check_stop(m: &mut CheckMsg) -> ! {\n");
        buf_str(out, c"    m.out();\n");
        buf_str(out, c"    unsafe { _exit(101) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `block #N (48 bytes), allocated at X[, freed at Y]`.\n");
        buf_str(out, c"unsafe fn check_describe(m: *CheckMsg, b: i64) {\n");
        buf_str(out, c"    m.block(b);\n");
        buf_str(out, c"    m.text(\", allocated at \");\n");
        buf_str(out, c"    m.site(CHECK_BLOCKS[b].alloc_site);\n");
        buf_str(out, c"    if CHECK_BLOCKS[b].state != CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"        m.text(if CHECK_BLOCKS[b].state == CHECK_FREED { \", freed at \" } else { \", released at \" });\n");
        buf_str(out, c"        m.site(CHECK_BLOCKS[b].free_site);\n");
        buf_str(out, c"        if CHECK_BLOCKS[b].state == CHECK_RELEASED {\n");
        buf_str(out, c"            m.text(\" (the arena's reset or scope end)\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The decimal number in C string s (0 when null or none).\n");
        buf_str(out, c"unsafe fn check_env_int(name: *u8) -> i64 {\n");
        buf_str(out, c"    let s = getenv(name);\n");
        buf_str(out, c"    if s == 0 as *u8 {\n");
        buf_str(out, c"        return 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut v = 0;\n");
        buf_str(out, c"    let mut i = 0;\n");
        buf_str(out, c"    while s[i] >= '0' && s[i] <= '9' {\n");
        buf_str(out, c"        v = v * 10 + (s[i] - '0') as i64;\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The first allocation: the page size, the fault handlers, the leaks'\n");
        buf_str(out, c"// list at exit, the environment.\n");
        buf_str(out, c"unsafe fn check_init() {\n");
        buf_str(out, c"    CHECK_PAGE = getpagesize() as i64;\n");
        buf_str(out, c"    let a = check_sigaction();\n");
        buf_str(out, c"    sigaction(11, &a, 0 as *CheckSigaction);\n");
        buf_str(out, c"    sigaction(check_sigbus(), &a, 0 as *CheckSigaction);\n");
        buf_str(out, c"    atexit(check_alloc_at_exit);\n");
        buf_str(out, c"    CHECK_TRAP = check_env_int(c\"TACHYON_ALLOC_TRAP\");\n");
        buf_str(out, c"    CHECK_MAX_LIVE = check_env_int(c\"TACHYON_ALLOC_MAX_LIVE\");\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The system refused to change a block's pages: on Linux, the limit of\n");
        buf_str(out, c"// memory maps (each run of live blocks between freed ones is a map).\n");
        buf_str(out, c"unsafe fn check_map_limit() -> ! {\n");
        buf_str(out, c"    let mut m = check_msg();\n");
        buf_str(out, c"    m.text(\"check-alloc: out of memory maps at block #\");\n");
        buf_str(out, c"    m.int(CHECK_COUNT + 1);\n");
        buf_str(out, c"    m.text(\", with \");\n");
        buf_str(out, c"    m.int(CHECK_LIVE);\n");
        buf_str(out, c"    m.text(\" blocks live: the kernel's vm.max_map_count is reached (every live block has pages of its own)\");\n");
        buf_str(out, c"    m.text(\"\\ntry: sudo sysctl vm.max_map_count=1048576\");\n");
        buf_str(out, c"    check_stop(&mut m)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A new region of at least `bytes`, or false.\n");
        buf_str(out, c"unsafe fn check_reserve(bytes: u64) -> bool {\n");
        buf_str(out, c"    if CHECK_REGIONS == CHECK_MAX_REGIONS {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut size = CHECK_REGION_BYTES;\n");
        buf_str(out, c"    while size < bytes {\n");
        buf_str(out, c"        size = size * 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        let p = mmap(0 as *u8, size, CHECK_PROT_NONE, check_map_flags(), -1, 0);\n");
        buf_str(out, c"        if p as i64 != -1 {\n");
        buf_str(out, c"            let r = CHECK_REGIONS;\n");
        buf_str(out, c"            CHECK_REGION_START[r] = p as u64;\n");
        buf_str(out, c"            CHECK_REGION_END[r] = p as u64 + size;\n");
        buf_str(out, c"            CHECK_REGION_FIRST[r] = CHECK_COUNT;\n");
        buf_str(out, c"            CHECK_REGIONS += 1;\n");
        buf_str(out, c"            CHECK_CURSOR = p as u64;\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // (less address space: smaller reservations)\n");
        buf_str(out, c"        if size / 2 < bytes || size <= 1073741824 {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        size = size / 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A new block of size bytes on pages of its own, for allocator owner (0:\n");
        buf_str(out, c"// Gpa), or null when out of memory.\n");
        buf_str(out, c"unsafe fn check_new_block(owner: u64, size: i64) -> *u8 {\n");
        buf_str(out, c"    if CHECK_PAGE == 0 {\n");
        buf_str(out, c"        check_init();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if size < 0 || size > 4611686018427387904 {\n");
        buf_str(out, c"        return 0 as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let page = CHECK_PAGE as u64;\n");
        buf_str(out, c"    let span = (size as u64 + page - 1) / page * page;\n");
        buf_str(out, c"    if CHECK_REGIONS == 0 || CHECK_CURSOR + span > CHECK_REGION_END[CHECK_REGIONS - 1] {\n");
        buf_str(out, c"        if !check_reserve(span) {\n");
        buf_str(out, c"            return 0 as *u8;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_MAX_LIVE > 0 && CHECK_LIVE >= CHECK_MAX_LIVE {\n");
        buf_str(out, c"        check_map_limit();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let p = CHECK_CURSOR as *u8;\n");
        buf_str(out, c"    if mprotect(p, span, CHECK_PROT_RW) != 0 {\n");
        buf_str(out, c"        if CHECK_ALLOC_OS == 1 {\n");
        buf_str(out, c"            check_map_limit();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return 0 as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    CHECK_CURSOR += span;\n");
        buf_str(out, c"    if CHECK_COUNT == CHECK_CAP {\n");
        buf_str(out, c"        CHECK_CAP = if CHECK_CAP == 0 { 1024 } else { CHECK_CAP * 2 };\n");
        buf_str(out, c"        CHECK_BLOCKS = realloc(CHECK_BLOCKS as *u8, (CHECK_CAP * size_of(CheckBlock)) as u64)\n");
        buf_str(out, c"            as *CheckBlock;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    CHECK_BLOCKS[CHECK_COUNT] = CheckBlock {\n");
        buf_str(out, c"        start: p as u64,\n");
        buf_str(out, c"        size: size,\n");
        buf_str(out, c"        span: span as i64,\n");
        buf_str(out, c"        owner: owner,\n");
        buf_str(out, c"        state: CHECK_LIVE_BLOCK,\n");
        buf_str(out, c"        alloc_site: CHECK_ALLOC_SITE,\n");
        buf_str(out, c"        free_site: 0 as *u8,\n");
        buf_str(out, c"    };\n");
        buf_str(out, c"    CHECK_COUNT += 1;\n");
        buf_str(out, c"    CHECK_CHANGES += 1;\n");
        buf_str(out, c"    if owner == 0 {\n");
        buf_str(out, c"        CHECK_LIVE += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_COUNT == CHECK_TRAP {\n");
        buf_str(out, c"        let mut m = check_msg();\n");
        buf_str(out, c"        m.text(\"check-alloc: \");\n");
        buf_str(out, c"        check_describe(&m, CHECK_COUNT - 1);\n");
        buf_str(out, c"        m.text(\" (TACHYON_ALLOC_TRAP): SIGTRAP\");\n");
        buf_str(out, c"        m.out();\n");
        buf_str(out, c"        raise(5);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    p\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Block b's pages given back, with no access, never used again.\n");
        buf_str(out, c"unsafe fn check_drop_block(b: i64, state: i64) {\n");
        buf_str(out, c"    let p = CHECK_BLOCKS[b].start as *u8;\n");
        buf_str(out, c"    let span = CHECK_BLOCKS[b].span as u64;\n");
        buf_str(out, c"    let flags = check_map_flags() | CHECK_MAP_FIXED;\n");
        buf_str(out, c"    if mmap(p, span, CHECK_PROT_NONE, flags, -1, 0) != p {\n");
        buf_str(out, c"        if CHECK_ALLOC_OS == 1 {\n");
        buf_str(out, c"            check_map_limit();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // (the pages keep their contents, but no access)\n");
        buf_str(out, c"        mprotect(p, span, CHECK_PROT_NONE);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"        CHECK_LIVE -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    CHECK_BLOCKS[b].state = state;\n");
        buf_str(out, c"    CHECK_BLOCKS[b].free_site = CHECK_ALLOC_SITE;\n");
        buf_str(out, c"    CHECK_CHANGES += 1;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The block whose pages hold address a; -1 when a is outside the\n");
        buf_str(out, c"// reservations, -2 when in one but in no block.\n");
        buf_str(out, c"unsafe fn check_find(a: u64) -> i64 {\n");
        buf_str(out, c"    for r in 0..CHECK_REGIONS {\n");
        buf_str(out, c"        if a >= CHECK_REGION_START[r] && a < CHECK_REGION_END[r] {\n");
        buf_str(out, c"            let mut lo = CHECK_REGION_FIRST[r];\n");
        buf_str(out, c"            let mut hi = if r + 1 < CHECK_REGIONS { CHECK_REGION_FIRST[r + 1] }\n");
        buf_str(out, c"                else { CHECK_COUNT };\n");
        buf_str(out, c"            // the last block starting at or before a\n");
        buf_str(out, c"            while lo < hi {\n");
        buf_str(out, c"                let mid = (lo + hi) / 2;\n");
        buf_str(out, c"                if CHECK_BLOCKS[mid].start <= a {\n");
        buf_str(out, c"                    lo = mid + 1;\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    hi = mid;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let b = lo - 1;\n");
        buf_str(out, c"            if b >= CHECK_REGION_FIRST[r]\n");
        buf_str(out, c"                && a < CHECK_BLOCKS[b].start + CHECK_BLOCKS[b].span as u64 {\n");
        buf_str(out, c"                return b;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return -2;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    -1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The live block p of `size` bytes from allocator owner, being freed or\n");
        buf_str(out, c"// resized: its index, or the program stops.\n");
        buf_str(out, c"unsafe fn check_owned(p: *u8, size: i64, owner: u64, freeing: bool) -> i64 {\n");
        buf_str(out, c"    let b = check_find(p as u64);\n");
        buf_str(out, c"    let mut m = check_msg();\n");
        buf_str(out, c"    if b < 0 || CHECK_BLOCKS[b].start != p as u64 {\n");
        buf_str(out, c"        m.text(if freeing { \"invalid free at \" } else { \"invalid resize at \" });\n");
        buf_str(out, c"        m.site(CHECK_ALLOC_SITE);\n");
        buf_str(out, c"        m.text(\": \");\n");
        buf_str(out, c"        m.hex(p as u64);\n");
        buf_str(out, c"        if b >= 0 {\n");
        buf_str(out, c"            m.text(\" is \");\n");
        buf_str(out, c"            m.int((p as u64 - CHECK_BLOCKS[b].start) as i64);\n");
        buf_str(out, c"            m.text(\" bytes into \");\n");
        buf_str(out, c"            check_describe(&m, b);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            m.text(if owner == 0 { \" is not a block of Gpa\" }\n");
        buf_str(out, c"                else { \" is not a block of the arena\" });\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        check_stop(&mut m);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_BLOCKS[b].state != CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"        m.text(if freeing { \"double free: \" } else { \"resize after free: \" });\n");
        buf_str(out, c"        check_describe(&m, b);\n");
        buf_str(out, c"        m.text(if freeing { \", freed again at \" } else { \", resized at \" });\n");
        buf_str(out, c"        m.site(CHECK_ALLOC_SITE);\n");
        buf_str(out, c"        check_stop(&mut m);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_BLOCKS[b].owner != owner {\n");
        buf_str(out, c"        m.text(if freeing { \"invalid free at \" } else { \"invalid resize at \" });\n");
        buf_str(out, c"        m.site(CHECK_ALLOC_SITE);\n");
        buf_str(out, c"        m.text(\": \");\n");
        buf_str(out, c"        check_describe(&m, b);\n");
        buf_str(out, c"        m.text(if owner == 0 { \", given to Gpa\" } else { \", given to another allocator\" });\n");
        buf_str(out, c"        check_stop(&mut m);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_BLOCKS[b].size != size {\n");
        buf_str(out, c"        m.text(if freeing { \"wrong-size free: \" } else { \"wrong-size resize: \" });\n");
        buf_str(out, c"        check_describe(&m, b);\n");
        buf_str(out, c"        m.text(if freeing { \", freed as \" } else { \", resized as \" });\n");
        buf_str(out, c"        m.int(size);\n");
        buf_str(out, c"        m.text(if size == 1 { \" byte at \" } else { \" bytes at \" });\n");
        buf_str(out, c"        m.site(CHECK_ALLOC_SITE);\n");
        buf_str(out, c"        check_stop(&mut m);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    b\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// p (old_size bytes from owner) moved to a new block of new_size bytes, or\n");
        buf_str(out, c"// null (p untouched).\n");
        buf_str(out, c"unsafe fn check_move(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    if old_size == 0 {\n");
        buf_str(out, c"        return check_alloc_block(owner, new_size, align);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let b = check_owned(p, old_size, owner, false);\n");
        buf_str(out, c"    if new_size == 0 {\n");
        buf_str(out, c"        check_drop_block(b, CHECK_FREED);\n");
        buf_str(out, c"        return align as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let q = check_new_block(owner, new_size);\n");
        buf_str(out, c"    if q == 0 as *u8 {\n");
        buf_str(out, c"        return q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    memcpy(q, p, (if old_size < new_size { old_size } else { new_size }) as u64);\n");
        buf_str(out, c"    check_drop_block(b, CHECK_FREED);\n");
        buf_str(out, c"    q\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas, with --check-alloc) A block of size bytes on pages of its own\n");
        buf_str(out, c"// for the allocator whose state is at owner (0: Gpa), or null; size 0: an\n");
        buf_str(out, c"// aligned pointer, no block.\n");
        buf_str(out, c"fn check_alloc_block(owner: u64, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    if size == 0 {\n");
        buf_str(out, c"        return unsafe { align as *u8 };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe { check_new_block(owner, size) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas) p, a block of owner of old_size bytes, moved to new_size bytes.\n");
        buf_str(out, c"unsafe fn check_alloc_moved(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"    -> *u8 {\n");
        buf_str(out, c"    check_move(owner, p, old_size, new_size, align)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas) The blocks allocated so far: a mark for check_alloc_release.\n");
        buf_str(out, c"fn check_alloc_mark() -> i64 {\n");
        buf_str(out, c"    CHECK_COUNT\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas: a reset, a scope's end) Every block of owner allocated after\n");
        buf_str(out, c"// mark is given back: a later access faults.\n");
        buf_str(out, c"fn check_alloc_release(owner: u64, mark: i64) {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        for b in mark..CHECK_COUNT {\n");
        buf_str(out, c"            if CHECK_BLOCKS[b].owner == owner && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"                check_drop_block(b, CHECK_RELEASED);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas) The site of the call being run, and that site set again: a\n");
        buf_str(out, c"// scope's end is reported at the scope's call, not at the last call in it.\n");
        buf_str(out, c"fn check_alloc_site() -> *u8 {\n");
        buf_str(out, c"    unsafe { CHECK_ALLOC_SITE }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn check_alloc_set_site(site: *u8) {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        CHECK_ALLOC_SITE = site;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas) Whether p starts the last live block of owner: the block an\n");
        buf_str(out, c"// arena grows, or gives back, in place.\n");
        buf_str(out, c"fn check_alloc_is_last(owner: u64, p: *u8) -> bool {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        for k in 0..CHECK_COUNT {\n");
        buf_str(out, c"            let b = CHECK_COUNT - 1 - k;\n");
        buf_str(out, c"            if CHECK_BLOCKS[b].owner == owner && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"                return CHECK_BLOCKS[b].start == p as u64;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (--check-unsafe with --check-alloc) The access of size bytes at p:\n");
        buf_str(out, c"// false when p is no memory of the checking allocator, true when it is in\n");
        buf_str(out, c"// bounds of a live block; else the program stops.\n");
        buf_str(out, c"pub unsafe fn check_alloc_access(p: u64, size: u64, site: *u8) -> bool {\n");
        buf_str(out, c"    let b = check_find(p);\n");
        buf_str(out, c"    if b == -1 {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut m = check_msg();\n");
        buf_str(out, c"    if b >= 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"        if p + size <= CHECK_BLOCKS[b].start + CHECK_BLOCKS[b].size as u64 {\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        m.text(\"unsafe access out of bounds: \");\n");
        buf_str(out, c"    } else if b >= 0 {\n");
        buf_str(out, c"        m.text(\"unsafe access after free: \");\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        m.text(\"unsafe access outside every block: \");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    m.int(size as i64);\n");
        buf_str(out, c"    m.text(if size == 1 { \" byte at \" } else { \" bytes at \" });\n");
        buf_str(out, c"    if b >= 0 {\n");
        buf_str(out, c"        m.text(\"offset \");\n");
        buf_str(out, c"        m.int((p - CHECK_BLOCKS[b].start) as i64);\n");
        buf_str(out, c"        m.text(\" of \");\n");
        buf_str(out, c"        check_describe(&m, b);\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        m.hex(p);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    m.text(\"\\n --> \");\n");
        buf_str(out, c"    m.site(site);\n");
        buf_str(out, c"    check_stop(&mut m)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// SIGSEGV, SIGBUS: an access to a freed block (or to the pages after the\n");
        buf_str(out, c"// last one) is reported; any other fault happens again with the default\n");
        buf_str(out, c"// action (SA_RESETHAND), as without --check-alloc.\n");
        buf_str(out, c"extern \"C\" fn check_alloc_fault(sig: i32, info: *u8, context: *u8) {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let a = *((info as u64 + check_si_addr()) as *u64);\n");
        buf_str(out, c"        let b = check_find(a);\n");
        buf_str(out, c"        if b == -1 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let mut m = check_msg();\n");
        buf_str(out, c"        if b >= 0 {\n");
        buf_str(out, c"            m.text(if CHECK_BLOCKS[b].state == CHECK_RELEASED { \"use after release: \" }\n");
        buf_str(out, c"                else { \"use after free: \" });\n");
        buf_str(out, c"            check_describe(&m, b);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            m.text(\"access outside every block: \");\n");
        buf_str(out, c"            m.hex(a);\n");
        buf_str(out, c"            m.text(\" (memory the checking allocator never handed out)\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        check_stop(&mut m);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The live blocks of Gpa, listed (at most 20).\n");
        buf_str(out, c"unsafe fn check_alloc_list_leaks() {\n");
        buf_str(out, c"    CHECK_LISTED = CHECK_CHANGES;\n");
        buf_str(out, c"    if CHECK_LIVE <= 0 {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut m = check_msg();\n");
        buf_str(out, c"    let mut bytes = 0;\n");
        buf_str(out, c"    for b in 0..CHECK_COUNT {\n");
        buf_str(out, c"        if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"            bytes += CHECK_BLOCKS[b].size;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    m.text(\"check-alloc: \");\n");
        buf_str(out, c"    m.int(CHECK_LIVE);\n");
        buf_str(out, c"    m.text(if CHECK_LIVE == 1 { \" block\" } else { \" blocks\" });\n");
        buf_str(out, c"    m.text(\" of Gpa not freed (\");\n");
        buf_str(out, c"    m.int(bytes);\n");
        buf_str(out, c"    m.text(\" bytes):\");\n");
        buf_str(out, c"    m.out();\n");
        buf_str(out, c"    let mut shown = 0;\n");
        buf_str(out, c"    for b in 0..CHECK_COUNT {\n");
        buf_str(out, c"        if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"            if shown == 20 {\n");
        buf_str(out, c"                let mut more = check_msg();\n");
        buf_str(out, c"                more.text(\"  and \");\n");
        buf_str(out, c"                more.int(CHECK_LIVE - shown);\n");
        buf_str(out, c"                more.text(\" more\");\n");
        buf_str(out, c"                more.out();\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let mut line = check_msg();\n");
        buf_str(out, c"            line.text(\"  \");\n");
        buf_str(out, c"            check_describe(&line, b);\n");
        buf_str(out, c"            line.out();\n");
        buf_str(out, c"            shown += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// At exit: the leaks, unless check_leaks listed them and nothing changed\n");
        buf_str(out, c"// since.\n");
        buf_str(out, c"extern \"C\" fn check_alloc_at_exit() {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        if CHECK_LISTED != CHECK_CHANGES {\n");
        buf_str(out, c"            check_alloc_list_leaks();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Allocator for Gpa {\n");
        buf_str(out, c"    fn try_alloc(self: *Gpa, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        check_alloc_block(0, size, align)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    unsafe fn try_resize(self: *Gpa, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        check_move(0, p, old_size, new_size, align)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    unsafe fn free(self: *Gpa, p: *u8, size: i64, align: i64) {\n");
        buf_str(out, c"        if size == 0 && check_find(p as u64) == -1 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        check_drop_block(check_owned(p, size, 0, true), CHECK_FREED);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
    }
}

