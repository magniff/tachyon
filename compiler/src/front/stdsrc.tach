        buf_str(out, c"    \\x0a\\x22\\x5f\\x0a\\x22=\\x0a\\x22\\x60\\x0a\\x22>\\x0a\\x22\\x61\\x0a\\x22?\\x0a\\x22\\x62\\x0a\\x22@\\x0a\\x22\\x63\\x0a\\x22\\x41\\x0a\\x22\\\n    \\x64\\x0a\\x22\\x42\\x0a\\x22\";\npub const UPPER_MULTI: [u8] = \"\\x74!!\\x74!!!!!\\x67!!\\x67!!!!!\\x67!!\\x6a!!!!!\\x67!!\\x6d!\\\n    !!!!\\x67!!\\x67!!\\x6a!!\\x67!!\\x67!!\\x6d!!\\x74!!\\x75!!!!!\\x74\\\n    !!\\x75!!!!!\\x74!!\\x74!!!!!\\x56&!\\x73&!!!!\\x65&!\\x67&!\\\n    !!!\\x65&!\\x56&!!!!\\x65&!\\x5c&!!!!\\x6f&!\\x67&!!!!\\x65&\\\n    !\\x5e&!!!!\\xdd#!\\x6f!!!!!\\xba$!)$!\\x22$!\\xc6$!)$!\\x22\\\n    $!\\x6b!!-$!!!!\\x69!!\\x52$!!!!\\x75!!)$!!!!\\x78!!\\\n    +$!!!!\\x7a!!+$!!!!\\x62!!\\xdf#!!!!\\xc6$!4$!!!\\\n    !\\xc6$!4$!!$!\\xc6$!4$!\\x22$!\\xc6$!4$!\\x63$!\\xb2$!\\x63\\\n    $!!!!\\xb8$!\\x63$!!!!\\xba$!)$!!$!\\xba$!)$!\\x22$!\\\n    \\xba$!\\x63$!!!!\\xba$!)$!\\x63$!\\xc6$!)$!!$!\\xc6$!)$\\\n    !\\x22$!\\xc2$!4$!!!!\\xc6$!\\x63$!!!!\\xc6$!)$!\\x63$!\\xca\\\n    $!\\x63$!!!!)@!\\xba$!!!!*@!\\xba$!!!!+@!\\xba$!\\\n    !!!,@!\\xba$!!!!-@!\\xba$!!!!.@!\\xba$!!!!/@\\\n    !\\xba$!!!!0@!\\xba$!!!!)@!\\xba$!!!!*@!\\xba$!!\\\n    !!+@!\\xba$!!!!,@!\\xba$!!!!-@!\\xba$!!!!.@!\\\n    \\xba$!!!!/@!\\xba$!!!!0@!\\xba$!!!!\\x49@!\\xba$!!!\\\n    !\\x4a@!\\xba$!!!!\\x4b@!\\xba$!!!!\\x4c@!\\xba$!!!!\\x4d@!\\xba\\\n    $!!!!\\x4e@!\\xba$!!!!\\x4f@!\\xba$!!!!\\x50@!\\xba$!!!!\\\n    \\x49@!\\xba$!!!!\\x4a@!\\xba$!!!!\\x4b@!\\xba$!!!!\\x4c@!\\xba$\\\n    !!!!\\x4d@!\\xba$!!!!\\x4e@!\\xba$!!!!\\x4f@!\\xba$!!!!\\x50\\\n    @!\\xba$!!!!\\x89@!\\xba$!!!!\\x8a@!\\xba$!!!!\\x8b@!\\xba$!\\\n    !!!\\x8c@!\\xba$!!!!\\x8d@!\\xba$!!!!\\x8e@!\\xba$!!!!\\x8f@\\\n    !\\xba$!!!!\\x90@!\\xba$!!!!\\x89@!\\xba$!!!!\\x8a@!\\xba$!!\\\n    !!\\x8b@!\\xba$!!!!\\x8c@!\\xba$!!!!\\x8d@!\\xba$!!!!\\x8e@!\\\n    \\xba$!!!!\\x8f@!\\xba$!!!!\\x90@!\\xba$!!!!\\xb2$!\\xba$!!!\\\n    !\\xb2$!\\xba$!!!!\\xb8$!\\xba$!!!!\\xb8$!\\xba$!!!!\\xca$!\\xba\\\n    $!!!!\\xca$!\\xba$!!!!\\xdb@!\\xba$!!!!\\xa7$!\\xba$!!!!\\\n");
        buf_str(out, c"    \\xeb@!\\xba$!!!!\\xaa$!\\xba$!!!!\\x1b@!\\xba$!!!!\\xb0$!\\xba$\\\n    !!!!\\xb2$!\\x63$!\\xba$!\\xb8$!\\x63$!\\xba$!\\xca$!\\x63$!\\xba$!\";\npub const LOWER_COUNT: i64 = 1508;\npub const UPPER_COUNT: i64 = 1601;\n// ---- end mod std::unicode::tables ----\n}\n// ---- end mod std::unicode ----\n}\n// ---- mod std::string ----\npub mod string {\n// std::string (0.20, docs/design/collections-text-io.md §2.5, task B5):\n// `str`, the view of UTF-8 text, and `String`, UTF-8 text that owns its\n// bytes, with Rust's names. A `str` is std::str's `[u8]` known to be\n// UTF-8: the compiler takes string literals as one where a `str` goes,\n// `&str` as `str`, and lets a `str` go where `[u8]` does; bytes become a\n// `str` only checked (`str::from_utf8`), outside std. What allocates takes\n// an allocator, the `_in` forms; the Rust forms (`to_uppercase()`,\n// `String::new()`) are errors naming them. A code point is a `u32` until\n// `char` exists.\n//\n// Searching takes a Pattern: a `str` or `[u8]` (a substring), a `u8` (an\n// ASCII byte: `','`) or a `u32` (a code point). Empty patterns match at\n// every char boundary, as Rust's do.\n\nuse std::{\n    Allocator, Ambient, Buf, Clone, Debug, Display, Eq, Fmt, Gpa, Hash, Iterator, Option, Ord,\n    ParseIntError, Result, Vec,\n};\nuse std::num::{ParseFloatError, parse_f32, parse_f64, parse_i64_radix, parse_u64_radix};\nuse std::str::{\n    Utf8Error, encode_utf8, is_char_boundary, lossy_next, memchr, memrchr, next_code_point,\n    next_code_point_reverse, utf8_char_width, validate_utf8,\n};\nuse std::unicode::{Graphemes, graphemes, is_whitespace, str_width, to_lower, to_upper};\n\n// ---- Text: str (0.20) ----\n\n// UTF-8 text, a view: `[u8]` whose bytes are UTF-8 (0.20). String literals\n// are `str` where one goes; `&str` is `str`; a `str` goes where `[u8]` does,\n// for free; bytes become one through `str::from_utf8(b)?`.\npub type str = distinct [u8];\n\n// Whether code point cp is White_Space (ASCII first).\n");
        buf_str(out, c"#[inline]\nfn is_space_cp(cp: u32) -> bool {\n    if cp < 0x80 {\n        return cp == 0x20 || (cp >= 0x09 && cp <= 0x0d);\n    }\n    is_whitespace(cp)\n}\n\n// The code point that starts at byte i of s (UTF-8), and its length.\n#[inline]\nfn cp_at(s: [u8], i: i64) -> (u32, i64) {\n    let b = s[i];\n    if b < 0x80 {\n        return (b as u32, 1);\n    }\n    var p = i;\n    let cp = lossy_next(s, &p);\n    (cp, p - i)\n}\n\n// The code point that ends at byte `end` of s, and its length.\n#[inline]\nfn cp_before(s: [u8], end: i64) -> (u32, i64) {\n    let b = s[end - 1];\n    if b < 0x80 {\n        return (b as u32, 1);\n    }\n    var start = end - 1;\n    while start > 0 && end - start < 4 && (s[start] & 0xc0) == 0x80 {\n        start -= 1;\n    }\n    var p = start;\n    let cp = lossy_next(s, &p);\n    if p != end {\n        return (0xfffd, 1);\n    }\n    (cp, end - start)\n}\n\n// The index of the first byte b in s at or after `from`, or -1: a plain\n// loop over a short span (a field, a line), std::str's memchr (NEON) over\n// a long one.\n#[inline]\nfn find_byte(b: u8, s: [u8], from: i64) -> i64 {\n    var i = from;\n    let short = if s.len - from < 32 { s.len } else { from + 32 };\n    while i < short {\n        if s[i] == b {\n            return i;\n        }\n        i += 1;\n    }\n    if i >= s.len {\n        return -1;\n    }\n    match memchr(b, s[i..]) {\n        Option::Some(k) => i + k,\n        Option::None => -1,\n    }\n}\n\n// Where `needle` first occurs in s at or after `from`, or -1.\nfn find_bytes(s: [u8], needle: [u8], from: i64) -> i64 {\n    let n = needle.len;\n    if n == 0 {\n        return if from <= s.len { from } else { -1 };\n    }\n    let first = needle[0];\n    if s.len < n {\n        return -1;\n    }\n    let hay = s[..s.len - n + 1];\n    var i = from;\n    while i < hay.len {\n        let at = find_byte(first, hay, i);\n        if at < 0 {\n            return -1;\n        }\n        var same = true;\n");
        buf_str(out, c"        for j in 1..n {\n            if s[at + j] != needle[j] {\n                same = false;\n                break;\n            }\n        }\n        if same {\n            return at;\n        }\n        i = at + 1;\n    }\n    -1\n}\n\n// Where `needle` last occurs in s[..to], or -1.\nfn rfind_bytes(s: [u8], needle: [u8], to: i64) -> i64 {\n    let n = needle.len;\n    if n == 0 {\n        return to;\n    }\n    if n > to {\n        return -1;\n    }\n    let last = needle[n - 1];\n    var end = to;\n    while end >= n {\n        match memrchr(last, s[n - 1..end]) {\n            Option::Some(k) => {\n                let at = k;\n                var same = true;\n                for j in 0..n - 1 {\n                    if s[at + j] != needle[j] {\n                        same = false;\n                        break;\n                    }\n                }\n                if same {\n                    return at;\n                }\n                end = at + n - 1;\n            }\n            Option::None => return -1,\n        }\n    }\n    -1\n}\n\n// What `split`, `find`, `trim_matches` and their kin look for: a `str` or\n// `[u8]` (a substring), a `u8` (a byte: `','`) or a `u32` (a code point).\npub trait Pattern {\n    // The first match in s at or after byte `from`: its start and end, or\n    // (-1, -1).\n    fn next_match(self, s: [u8], from: i64) -> (i64, i64);\n    // The last match in s[..to]: its start and end, or (-1, -1).\n    fn last_match(self, s: [u8], to: i64) -> (i64, i64);\n    // The length of a match at the start of s, or -1.\n    fn prefix_len(self, s: [u8]) -> i64;\n    // The length of a match at the end of s, or -1.\n    fn suffix_len(self, s: [u8]) -> i64;\n}\n\nimpl Pattern for [u8] {\n    fn next_match(self, s: [u8], from: i64) -> (i64, i64) {\n        let at = find_bytes(s, self, from);\n        if at < 0 { (-1, -1) } else { (at, at + self.len) }\n    }\n\n    fn last_match(self, s: [u8], to: i64) -> (i64, i64) {\n");
        buf_str(out, c"        let at = rfind_bytes(s, self, to);\n        if at < 0 { (-1, -1) } else { (at, at + self.len) }\n    }\n\n    fn prefix_len(self, s: [u8]) -> i64 {\n        let p = self;\n        if p.len <= s.len && s[..p.len] == p { p.len } else { -1 }\n    }\n\n    fn suffix_len(self, s: [u8]) -> i64 {\n        let p = self;\n        if p.len <= s.len && s[s.len - p.len..] == p { p.len } else { -1 }\n    }\n}\n\nimpl Pattern for str {\n    fn next_match(self, s: [u8], from: i64) -> (i64, i64) {\n        let p = self as [u8];\n        p.next_match(s, from)\n    }\n\n    fn last_match(self, s: [u8], to: i64) -> (i64, i64) {\n        let p = self as [u8];\n        p.last_match(s, to)\n    }\n\n    fn prefix_len(self, s: [u8]) -> i64 {\n        let p = self as [u8];\n        p.prefix_len(s)\n    }\n\n    fn suffix_len(self, s: [u8]) -> i64 {\n        let p = self as [u8];\n        p.suffix_len(s)\n    }\n}\n\nimpl Pattern for u8 {\n    fn next_match(self, s: [u8], from: i64) -> (i64, i64) {\n        let at = if from < s.len { find_byte(self, s, from) } else { -1 };\n        if at < 0 { (-1, -1) } else { (at, at + 1) }\n    }\n\n    fn last_match(self, s: [u8], to: i64) -> (i64, i64) {\n        match memrchr(self, s[..to]) {\n            Option::Some(k) => (k, k + 1),\n            Option::None => (-1, -1),\n        }\n    }\n\n    fn prefix_len(self, s: [u8]) -> i64 {\n        if s.len > 0 && s[0] == self { 1 } else { -1 }\n    }\n\n    fn suffix_len(self, s: [u8]) -> i64 {\n        if s.len > 0 && s[s.len - 1] == self { 1 } else { -1 }\n    }\n}\n\nimpl Pattern for u32 {\n    fn next_match(self, s: [u8], from: i64) -> (i64, i64) {\n        var buf: [u8; 4] = [0; 4];\n        let n = encode_utf8(self, &buf);\n        let p = buf[..n];\n        p.next_match(s, from)\n    }\n\n    fn last_match(self, s: [u8], to: i64) -> (i64, i64) {\n        var buf: [u8; 4] = [0; 4];\n        let n = encode_utf8(self, &buf);\n        let p = buf[..n];\n        p.last_match(s, to)\n    }\n\n");
        buf_str(out, c"    fn prefix_len(self, s: [u8]) -> i64 {\n        var buf: [u8; 4] = [0; 4];\n        let n = encode_utf8(self, &buf);\n        let p = buf[..n];\n        p.prefix_len(s)\n    }\n\n    fn suffix_len(self, s: [u8]) -> i64 {\n        var buf: [u8; 4] = [0; 4];\n        let n = encode_utf8(self, &buf);\n        let p = buf[..n];\n        p.suffix_len(s)\n    }\n}\n\nimpl str {\n    // The text of bytes b, when they are UTF-8 (Rust's `str::from_utf8`).\n    pub fn from_utf8(b: [u8]) -> Result<str, Utf8Error> {\n        match validate_utf8(b) {\n            Result::Ok(_) => Result::Ok(b as str),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n\n    // The text of bytes b, which must be UTF-8 (not checked: text that is\n    // not decodes as U+FFFD, never out of bounds).\n    pub unsafe fn from_utf8_unchecked(b: [u8]) -> str {\n        b as str\n    }\n\n    // The length in bytes.\n    #[inline]\n    pub fn len(self) -> i64 {\n        (self as [u8]).len\n    }\n\n    #[inline]\n    pub fn is_empty(self) -> bool {\n        (self as [u8]).len == 0\n    }\n\n    // Its bytes.\n    #[inline]\n    pub fn as_bytes(self) -> [u8] {\n        self as [u8]\n    }\n\n    // Whether byte index i starts a code point (or is the end).\n    pub fn is_char_boundary(self, i: i64) -> bool {\n        is_char_boundary(self as [u8], i)\n    }\n\n    // Whether every byte is ASCII.\n    pub fn is_ascii(self) -> bool {\n        let b = self as [u8];\n        for i in 0..b.len {\n            if b[i] >= 0x80 {\n                return false;\n            }\n        }\n        true\n    }\n\n    // The code points (u32), front to back; `.rev()` back to front.\n    #[inline]\n    pub fn chars(self) -> Chars {\n        let b = self as [u8];\n        Chars { s: b, front: 0, back: b.len }\n    }\n\n    // (byte index, code point) pairs.\n    #[inline]\n    pub fn char_indices(self) -> CharIndices {\n        CharIndices { s: self as [u8], pos: 0 }\n    }\n\n");
        buf_str(out, c"    // The bytes, as `as_bytes().iter()`.\n    #[inline]\n    pub fn bytes(self) -> std::SliceIter<u8> {\n        (self as [u8]).iter()\n    }\n\n    // The lines: split at '\\n', a '\\r' before it dropped; no last empty\n    // line after a final '\\n'.\n    #[inline]\n    pub fn lines(self) -> Lines {\n        Lines { s: self as [u8], pos: 0 }\n    }\n\n    // The pieces between matches of p.\n    #[inline]\n    pub fn split<P: Pattern>(self, p: sink P) -> Split<P> {\n        Split { s: self as [u8], start: 0, pos: 0, pat: p, left: -1, done: false }\n    }\n\n    // At most n pieces: the last is the rest.\n    #[inline]\n    pub fn splitn<P: Pattern>(self, n: i64, p: sink P) -> Split<P> {\n        Split { s: self as [u8], start: 0, pos: 0, pat: p, left: n, done: n <= 0 }\n    }\n\n    // The pieces between runs of whitespace (Unicode White_Space), none\n    // empty.\n    #[inline]\n    pub fn split_whitespace(self) -> SplitWhitespace {\n        SplitWhitespace { s: self as [u8], pos: 0, ascii: false }\n    }\n\n    // As split_whitespace, ASCII whitespace only.\n    #[inline]\n    pub fn split_ascii_whitespace(self) -> SplitWhitespace {\n        SplitWhitespace { s: self as [u8], pos: 0, ascii: true }\n    }\n\n    // The parts before and after the first match of p.\n    pub fn split_once<P: Pattern>(self, p: sink P) -> Option<(str, str)> {\n        let b = self as [u8];\n        let (a, e) = p.next_match(b, 0);\n        if a < 0 {\n            return Option::None;\n        }\n        Option::Some((b[..a] as str, b[e..] as str))\n    }\n\n    // The parts before and after the last match of p.\n    pub fn rsplit_once<P: Pattern>(self, p: sink P) -> Option<(str, str)> {\n        let b = self as [u8];\n        let (a, e) = p.last_match(b, b.len);\n        if a < 0 {\n            return Option::None;\n        }\n        Option::Some((b[..a] as str, b[e..] as str))\n    }\n\n    // The matches of p, front to back.\n    #[inline]\n");
        buf_str(out, c"    pub fn matches<P: Pattern>(self, p: sink P) -> Matches<P> {\n        Matches { s: self as [u8], pos: 0, pat: p }\n    }\n\n    // The byte index of the first match of p.\n    pub fn find<P: Pattern>(self, p: sink P) -> Option<i64> {\n        let (a, _) = p.next_match(self as [u8], 0);\n        if a < 0 { Option::None } else { Option::Some(a) }\n    }\n\n    // The byte index of the last match of p.\n    pub fn rfind<P: Pattern>(self, p: sink P) -> Option<i64> {\n        let b = self as [u8];\n        let (a, _) = p.last_match(b, b.len);\n        if a < 0 { Option::None } else { Option::Some(a) }\n    }\n\n    pub fn contains<P: Pattern>(self, p: sink P) -> bool {\n        let (a, _) = p.next_match(self as [u8], 0);\n        a >= 0\n    }\n\n    pub fn starts_with<P: Pattern>(self, p: sink P) -> bool {\n        p.prefix_len(self as [u8]) >= 0\n    }\n\n    pub fn ends_with<P: Pattern>(self, p: sink P) -> bool {\n        p.suffix_len(self as [u8]) >= 0\n    }\n\n    // Without a match of p at its start.\n    pub fn strip_prefix<P: Pattern>(self, p: sink P) -> Option<str> {\n        let b = self as [u8];\n        let n = p.prefix_len(b);\n        if n < 0 { Option::None } else { Option::Some(b[n..] as str) }\n    }\n\n    // Without a match of p at its end.\n    pub fn strip_suffix<P: Pattern>(self, p: sink P) -> Option<str> {\n        let b = self as [u8];\n        let n = p.suffix_len(b);\n        if n < 0 { Option::None } else { Option::Some(b[..b.len - n] as str) }\n    }\n\n    // Without whitespace (Unicode White_Space) at either end.\n    pub fn trim(self) -> str {\n        self.trim_start().trim_end()\n    }\n\n    pub fn trim_start(self) -> str {\n        let b = self as [u8];\n        var i = 0;\n        while i < b.len {\n            let (cp, n) = cp_at(b, i);\n            if !is_space_cp(cp) {\n                break;\n            }\n            i += n;\n        }\n        b[i..] as str\n    }\n\n    pub fn trim_end(self) -> str {\n");
        buf_str(out, c"        let b = self as [u8];\n        var end = b.len;\n        while end > 0 {\n            let (cp, n) = cp_before(b, end);\n            if !is_space_cp(cp) {\n                break;\n            }\n            end -= n;\n        }\n        b[..end] as str\n    }\n\n    // Without ASCII whitespace at either end.\n    pub fn trim_ascii(self) -> str {\n        let b = self as [u8];\n        var i = 0;\n        var end = b.len;\n        while i < end && is_space_cp(b[i] as u32) && b[i] < 0x80 {\n            i += 1;\n        }\n        while end > i && is_space_cp(b[end - 1] as u32) && b[end - 1] < 0x80 {\n            end -= 1;\n        }\n        b[i..end] as str\n    }\n\n    // Without the matches of p repeated at either end (an empty p: as it\n    // is).\n    pub fn trim_matches<P: Pattern>(self, p: sink P) -> str {\n        self.trim_start_matches(p).trim_end_matches(p)\n    }\n\n    pub fn trim_start_matches<P: Pattern>(self, p: sink P) -> str {\n        var b = self as [u8];\n        loop {\n            let n = p.prefix_len(b);\n            if n <= 0 {\n                break;\n            }\n            b = b[n..];\n        }\n        b as str\n    }\n\n    pub fn trim_end_matches<P: Pattern>(self, p: sink P) -> str {\n        var b = self as [u8];\n        loop {\n            let n = p.suffix_len(b);\n            if n <= 0 {\n                break;\n            }\n            b = b[..b.len - n];\n        }\n        b as str\n    }\n\n    // Whether the two are equal ignoring ASCII case.\n    pub fn eq_ignore_ascii_case(self, other: str) -> bool {\n        let a = self as [u8];\n        let b = other as [u8];\n        if a.len != b.len {\n            return false;\n        }\n        for i in 0..a.len {\n            if ascii_lower(a[i]) != ascii_lower(b[i]) {\n                return false;\n            }\n        }\n        true\n    }\n\n    // The number of code points.\n    pub fn char_count(self) -> i64 {\n        std::str::count_chars(self as [u8])\n");
        buf_str(out, c"    }\n\n    // Its value as a T: `s.trim().parse::<i64>()?` (Rust's FromStr: an\n    // optional sign, digits, no whitespace).\n    #[inline]\n    pub fn parse<T: FromStr>(self) -> Result<T, T::Err> {\n        T::from_str(self)\n    }\n\n    // Its display width in a terminal's columns (std::unicode: per grapheme\n    // cluster, East Asian Wide and emoji 2).\n    pub fn width(self) -> i64 {\n        str_width(self as [u8], false)\n    }\n\n    // As width, East Asian Ambiguous 2 (CJK contexts).\n    pub fn width_cjk(self) -> i64 {\n        str_width(self as [u8], true)\n    }\n\n    // The extended grapheme clusters (UAX #29): the unicode-segmentation\n    // crate's `graphemes(true)`; the flag is Rust's spelling (legacy\n    // clusters are not offered).\n    #[inline]\n    pub fn graphemes(self, extended: bool) -> StrGraphemes {\n        StrGraphemes { g: graphemes(self as [u8]) }\n    }\n\n    // ---- allocating, on allocator a ----\n\n    // A String of this text.\n    pub fn to_string_in<A: Allocator>(self, a: sink A) -> String<A> {\n        String::from_in(self, a)\n    }\n\n    pub fn to_owned_in<A: Allocator>(self, a: sink A) -> String<A> {\n        String::from_in(self, a)\n    }\n\n    // The text in lower case (Unicode's full mappings: 'İ' is two code\n    // points).\n    pub fn to_lowercase_in<A: Allocator>(self, a: sink A) -> String<A> {\n        let b = self as [u8];\n        var out: String<A> = String::with_capacity_in(b.len, a);\n        var i = 0;\n        while i < b.len {\n            let c = b[i];\n            if c < 0x80 {\n                out.bytes.push(ascii_lower(c));\n                i += 1;\n                continue;\n            }\n            let (cp, n) = cp_at(b, i);\n            let m = to_lower(cp);\n            for k in 0..3 {\n                if m[k] != 0 {\n                    out.push(m[k]);\n                }\n            }\n            i += n;\n        }\n        out\n    }\n\n");
        buf_str(out, c"    // The text in upper case (full mappings: 'ß' is \"SS\").\n    pub fn to_uppercase_in<A: Allocator>(self, a: sink A) -> String<A> {\n        let b = self as [u8];\n        var out: String<A> = String::with_capacity_in(b.len, a);\n        var i = 0;\n        while i < b.len {\n            let c = b[i];\n            if c < 0x80 {\n                out.bytes.push(ascii_upper(c));\n                i += 1;\n                continue;\n            }\n            let (cp, n) = cp_at(b, i);\n            let m = to_upper(cp);\n            for k in 0..3 {\n                if m[k] != 0 {\n                    out.push(m[k]);\n                }\n            }\n            i += n;\n        }\n        out\n    }\n\n    pub fn to_ascii_lowercase_in<A: Allocator>(self, a: sink A) -> String<A> {\n        let b = self as [u8];\n        var out: String<A> = String::with_capacity_in(b.len, a);\n        for i in 0..b.len {\n            out.bytes.push(ascii_lower(b[i]));\n        }\n        out\n    }\n\n    pub fn to_ascii_uppercase_in<A: Allocator>(self, a: sink A) -> String<A> {\n        let b = self as [u8];\n        var out: String<A> = String::with_capacity_in(b.len, a);\n        for i in 0..b.len {\n            out.bytes.push(ascii_upper(b[i]));\n        }\n        out\n    }\n\n    // The text with every match of `from` replaced by `to`.\n    pub fn replace_in<P: Pattern,\n        A: Allocator>(self, from: sink P, to: str, a: sink A) -> String<A> {\n        self.replacen_in(from, to, -1, a)\n    }\n\n    // The first n matches replaced (n < 0: all).\n    pub fn replacen_in<P: Pattern, A: Allocator>(self, from: sink P, to: str, n: i64, a: sink A)\n        -> String<A> {\n        let b = self as [u8];\n        var out: String<A> = String::with_capacity_in(b.len, a);\n        var start = 0;\n        var pos = 0;\n        var left = n;\n        while left != 0 && pos <= b.len {\n            let (m, e) = from.next_match(b, pos);\n            if m < 0 {\n                break;\n");
        buf_str(out, c"            }\n            out.bytes.extend_from_slice(b[start..m]);\n            out.bytes.extend_from_slice(to as [u8]);\n            start = e;\n            pos = if e == m { e + char_len_at(b, e) } else { e };\n            if left > 0 {\n                left -= 1;\n            }\n        }\n        out.bytes.extend_from_slice(b[start..]);\n        out\n    }\n\n    // The text n times.\n    pub fn repeat_in<A: Allocator>(self, n: i64, a: sink A) -> String<A> {\n        let b = self as [u8];\n        var out: String<A> = String::with_capacity_in(b.len * n, a);\n        for _ in 0..n {\n            out.bytes.extend_from_slice(b);\n        }\n        out\n    }\n\n    // ---- the Rust forms: errors naming the _in forms (front/ambient) ----\n\n    #[ambient(\"to_string_in(gpa)\")]\n    pub fn to_string(self) -> String {\n        self.to_string_in(Gpa::ambient())\n    }\n\n    #[ambient(\"to_owned_in(gpa)\")]\n    pub fn to_owned(self) -> String {\n        self.to_owned_in(Gpa::ambient())\n    }\n\n    #[ambient(\"to_lowercase_in(gpa)\")]\n    pub fn to_lowercase(self) -> String {\n        self.to_lowercase_in(Gpa::ambient())\n    }\n\n    #[ambient(\"to_uppercase_in(gpa)\")]\n    pub fn to_uppercase(self) -> String {\n        self.to_uppercase_in(Gpa::ambient())\n    }\n\n    #[ambient(\"replace_in(from, to, gpa)\")]\n    pub fn replace<P: Pattern>(self, from: sink P, to: str) -> String {\n        self.replace_in(from, to, Gpa::ambient())\n    }\n\n    #[ambient(\"repeat_in(n, gpa)\")]\n    pub fn repeat(self, n: i64) -> String {\n        self.repeat_in(n, Gpa::ambient())\n    }\n}\n\n#[inline]\nfn ascii_lower(c: u8) -> u8 {\n    if c >= 'A' && c <= 'Z' { c + 32 } else { c }\n}\n\n#[inline]\nfn ascii_upper(c: u8) -> u8 {\n    if c >= 'a' && c <= 'z' { c - 32 } else { c }\n}\n\n// The length of the code point at byte i (1 past the end).\n#[inline]\nfn char_len_at(s: [u8], i: i64) -> i64 {\n    if i >= s.len {\n        return 1;\n    }\n");
        buf_str(out, c"    let n = utf8_char_width(s[i]);\n    if n == 0 { 1 } else { n }\n}\n\n// ---- Text: str's iterators (0.20) ----\n\n// `s.chars()`: the code points, front to back (`next_back`, `rev()`: back\n// to front). Text that is not UTF-8 (std's own, from_utf8_unchecked)\n// yields U+FFFD for what is not.\npub struct Chars { s: [u8], front: i64, back: i64 }\n\nimpl Iterator for Chars {\n    type Item = u32;\n\n    #[inline]\n    fn next(inout self) -> Option<u32> {\n        if self.front >= self.back {\n            return Option::None;\n        }\n        let b = self.s[self.front];\n        if b < 0x80 {\n            self.front += 1;\n            return Option::Some(b as u32);\n        }\n        let s = self.s[..self.back];\n        Option::Some(lossy_next(s, &self.front))\n    }\n\n    // The code points left: the bytes that are not continuation bytes.\n    fn count(self) -> i64 {\n        std::str::count_chars(self.s[self.front..self.back])\n    }\n}\n\nimpl Chars {\n    // The last code point left.\n    pub fn next_back(inout self) -> Option<u32> {\n        if self.front >= self.back {\n            return Option::None;\n        }\n        let (cp, n) = cp_before(self.s[self.front..self.back], self.back - self.front);\n        self.back -= n;\n        Option::Some(cp)\n    }\n\n    // The code points back to front.\n    pub fn rev(self) -> RevChars {\n        RevChars { c: self }\n    }\n\n    // The text left.\n    pub fn as_str(self) -> str {\n        self.s[self.front..self.back] as str\n    }\n}\n\n// `s.chars().rev()`.\npub struct RevChars { c: Chars }\n\nimpl Iterator for RevChars {\n    type Item = u32;\n\n    #[inline]\n    fn next(inout self) -> Option<u32> {\n        self.c.next_back()\n    }\n}\n\n// `s.char_indices()`: (byte index, code point).\npub struct CharIndices { s: [u8], pos: i64 }\n\nimpl Iterator for CharIndices {\n    type Item = (i64, u32);\n\n    #[inline]\n    fn next(inout self) -> Option<(i64, u32)> {\n        if self.pos >= self.s.len {\n");
        buf_str(out, c"            return Option::None;\n        }\n        let at = self.pos;\n        let (cp, n) = cp_at(self.s, at);\n        self.pos = at + n;\n        Option::Some((at, cp))\n    }\n}\n\n// `s.lines()`.\npub struct Lines { s: [u8], pos: i64 }\n\nimpl Iterator for Lines {\n    type Item = str;\n\n    fn next(inout self) -> Option<str> {\n        let s = self.s;\n        let start = self.pos;\n        if start >= s.len {\n            return Option::None;\n        }\n        var end = find_byte('\\n', s, start);\n        if end >= 0 {\n            self.pos = end + 1;\n        } else {\n            end = s.len;\n            self.pos = s.len;\n        }\n        if end > start && s[end - 1] == '\\r' {\n            end -= 1;\n        }\n        Option::Some(s[start..end] as str)\n    }\n}\n\n// `s.split(p)`, `s.splitn(n, p)`.\npub struct Split<P> { s: [u8], start: i64, pos: i64, pat: P, left: i64, done: bool }\n\nimpl<P: Pattern> Iterator for Split<P> {\n    type Item = str;\n\n    fn next(inout self) -> Option<str> {\n        if self.done {\n            return Option::None;\n        }\n        let s = self.s;\n        if self.left == 1 {\n            self.done = true;\n            return Option::Some(s[self.start..] as str);\n        }\n        let (m, e) = if self.pos <= s.len { self.pat.next_match(s, self.pos) } else { (-1, -1) };\n        if m < 0 {\n            self.done = true;\n            return Option::Some(s[self.start..] as str);\n        }\n        let piece = s[self.start..m];\n        self.start = e;\n        self.pos = if e == m { e + char_len_at(s, e) } else { e };\n        if self.left > 0 {\n            self.left -= 1;\n        }\n        Option::Some(piece as str)\n    }\n}\n\n// `s.split_whitespace()`, `s.split_ascii_whitespace()`.\npub struct SplitWhitespace { s: [u8], pos: i64, ascii: bool }\n\nimpl Iterator for SplitWhitespace {\n    type Item = str;\n\n    fn next(inout self) -> Option<str> {\n        let s = self.s;\n        var i = self.pos;\n");
        buf_str(out, c"        // (the whitespace before the piece)\n        while i < s.len {\n            let c = s[i];\n            if c < 0x80 {\n                if !is_space_cp(c as u32) {\n                    break;\n                }\n                i += 1;\n            } else {\n                if self.ascii {\n                    break;\n                }\n                let (cp, n) = cp_at(s, i);\n                if !is_space_cp(cp) {\n                    break;\n                }\n                i += n;\n            }\n        }\n        if i >= s.len {\n            self.pos = s.len;\n            return Option::None;\n        }\n        let start = i;\n        while i < s.len {\n            let c = s[i];\n            if c < 0x80 {\n                if is_space_cp(c as u32) {\n                    break;\n                }\n                i += 1;\n            } else if self.ascii {\n                i += 1;\n            } else {\n                let (cp, n) = cp_at(s, i);\n                if is_space_cp(cp) {\n                    break;\n                }\n                i += n;\n            }\n        }\n        self.pos = i;\n        Option::Some(s[start..i] as str)\n    }\n}\n\n// `s.matches(p)`.\npub struct Matches<P> { s: [u8], pos: i64, pat: P }\n\nimpl<P: Pattern> Iterator for Matches<P> {\n    type Item = str;\n\n    fn next(inout self) -> Option<str> {\n        let s = self.s;\n        if self.pos > s.len {\n            return Option::None;\n        }\n        let (m, e) = self.pat.next_match(s, self.pos);\n        if m < 0 {\n            self.pos = s.len + 1;\n            return Option::None;\n        }\n        self.pos = if e == m { e + char_len_at(s, e) } else { e };\n        Option::Some(s[m..e] as str)\n    }\n}\n\n// `s.graphemes(true)`: the extended grapheme clusters.\npub struct StrGraphemes { g: Graphemes }\n\nimpl Iterator for StrGraphemes {\n    type Item = str;\n\n    #[inline]\n    fn next(inout self) -> Option<str> {\n        match self.g.next() {\n");
        buf_str(out, c"            Option::Some(b) => Option::Some(b as str),\n            Option::None => Option::None,\n        }\n    }\n}\n\n// ---- Text: parsing (0.20) ----\n\n// A type that text parses as: `s.parse::<T>()`, `T::from_str(s)` (Rust's).\npub trait FromStr {\n    type Err;\n    fn from_str(s: str) -> Result<Self, Self::Err>;\n}\n\n// Why `s.parse::<bool>()` failed: the text is not \"true\" or \"false\".\n#[derive(Eq, Debug, Clone)]\npub struct ParseBoolError { at: i64 }\n\nimpl Display for ParseBoolError {\n    fn fmt(self, f: inout Fmt) {\n        f.str(\"provided string was not `true` or `false`\");\n    }\n}\n\nimpl FromStr for bool {\n    type Err = ParseBoolError;\n\n    fn from_str(s: str) -> Result<bool, ParseBoolError> {\n        if s == \"true\" {\n            return Result::Ok(true);\n        }\n        if s == \"false\" {\n            return Result::Ok(false);\n        }\n        Result::Err(ParseBoolError { at: 0 })\n    }\n}\n\nimpl FromStr for i64 {\n    type Err = ParseIntError;\n\n    fn from_str(s: str) -> Result<i64, ParseIntError> {\n        parse_i64_radix(s as [u8], 10)\n    }\n}\n\nimpl FromStr for u64 {\n    type Err = ParseIntError;\n\n    fn from_str(s: str) -> Result<u64, ParseIntError> {\n        parse_u64_radix(s as [u8], 10)\n    }\n}\n\n// An i64 that fits in [lo, hi], else Overflow.\nfn parse_signed_in(s: str, lo: i64, hi: i64) -> Result<i64, ParseIntError> {\n    match parse_i64_radix(s as [u8], 10) {\n        Result::Ok(v) => if v < lo || v > hi { Result::Err(ParseIntError::Overflow) }\n            else { Result::Ok(v) },\n        Result::Err(e) => Result::Err(e),\n    }\n}\n\nfn parse_unsigned_in(s: str, hi: u64) -> Result<u64, ParseIntError> {\n    match parse_u64_radix(s as [u8], 10) {\n        Result::Ok(v) => if v > hi { Result::Err(ParseIntError::Overflow) } else { Result::Ok(v) },\n        Result::Err(e) => Result::Err(e),\n    }\n}\n\nimpl FromStr for i32 {\n    type Err = ParseIntError;\n\n");
