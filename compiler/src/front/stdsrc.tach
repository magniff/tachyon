k A) -> Vec<T, A> {\n");
        buf_str(out, c"        Vec { ptr: 0 as *T, len: 0, cap: 0, alloc: a }\n    }\n\n    // An empty Vec on allocator a with room for cap elements (0.16).\n    pub fn with_capacity_in(cap: i64, a: sink A) -> Vec<T, A> {\n        var v: Vec<T, A> = Vec::new_in(a);\n        v.reserve(cap);\n        v\n    }\n\n    pub fn len(self) -> i64 {\n        self.len\n    }\n\n    pub fn is_empty(self) -> bool {\n        self.len == 0\n    }\n\n    // Room for `extra` more elements.\n    pub fn reserve(inout self, extra: i64) {\n        if extra > self.cap - self.len && !self.reserve_more(extra) {\n            out_of_memory();\n        }\n    }\n\n    // Grows to room for `extra` (more than it has) more elements: twice the\n    // capacity, or more when needed; false when out of memory.\n    #[inline(never)]\n    fn reserve_more(inout self, extra: i64) -> bool {\n        if extra > ALLOC_LIMIT - self.len {\n            return false;\n        }\n        let cap = grown_cap(self.cap, self.len + extra);\n        let bytes = alloc_bytes(cap, size_of(T));\n        if bytes < 0 {\n            return false;\n        }\n        let p = unsafe {\n            self.alloc.try_resize(self.ptr as *u8, self.cap * size_of(T), bytes, align_of(T))\n        };\n        if p == 0 as *u8 {\n            return false;\n        }\n        self.ptr = p as *T;\n        self.cap = cap;\n        true\n    }\n\n    // Appends the elements of s, which may be a view of this Vec: when it\n    // grows, the elements are copied to the new memory before the old is\n    // freed.\n    #[stores(*s)]\n    pub fn extend_from_slice(inout self, s: [T]) {\n        let n = s.len;\n        var old = 0 as *T;\n        var old_cap = 0;\n        if n > self.cap - self.len {\n            var cap = -1;\n            if n <= ALLOC_LIMIT - self.len {\n                cap = grown_cap(self.cap, self.len + n);\n            }\n            let bytes = alloc_bytes(cap, size_of(T));\n            if bytes < 0 {\n                out_of_memory();\n");
        buf_str(out, c"            }\n            old = self.ptr;\n            old_cap = self.cap;\n            let p = self.alloc.try_alloc(bytes, align_of(T));\n            if p == 0 as *u8 {\n                out_of_memory();\n            }\n            unsafe {\n                self.ptr = p as *T;\n                for i in 0..self.len {\n                    self.ptr[i] = old[i];\n                }\n            }\n            self.cap = cap;\n        }\n        for i in 0..n {\n            unsafe {\n                self.ptr[self.len + i] = s[i];\n            }\n        }\n        self.len += n;\n        unsafe {\n            self.alloc.free(old as *u8, old_cap * size_of(T), align_of(T));\n        }\n    }\n\n    #[stores(x)]\n    pub fn push(inout self, x: sink T) {\n        if self.len == self.cap && !self.reserve_more(1) {\n            out_of_memory();\n        }\n        unsafe {\n            self.ptr[self.len] = x;\n        }\n        self.len += 1;\n    }\n\n    pub fn pop(inout self) -> Option<T> {\n        if self.len == 0 {\n            return Option::None;\n        }\n        self.len -= 1;\n        Option::Some(unsafe { self.ptr[self.len] })\n    }\n\n    // Element i (checked: out of bounds exits with 101).\n    pub fn get(self, i: i64) -> T\n        requires 0 <= i && i < self.len else f\"index out of bounds: index {i}, length {self.len}\"\n    {\n        self.as_slice()[i]\n    }\n\n    #[stores(x)]\n    pub fn set(inout self, i: i64, x: sink T)\n        requires 0 <= i && i < self.len else f\"index out of bounds: index {i}, length {self.len}\"\n    {\n        self.as_mut_slice()[i] = x;\n    }\n\n    // The last element, if there is one (the Vec keeps it; `pop` takes it).\n    pub fn last(self) -> Option<T> {\n        if self.len == 0 { Option::None } else { Option::Some(self.get(self.len - 1)) }\n    }\n\n    // Exchanges elements i and j (checked).\n    pub fn swap(inout self, i: i64, j: i64)\n");
