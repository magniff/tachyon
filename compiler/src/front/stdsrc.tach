        buf_str(out, c"\n");
        buf_str(out, c"    // A C string (up to its NUL).\n");
        buf_str(out, c"    pub unsafe fn push_cstr(self: *Buf, s: *u8) {\n");
        buf_str(out, c"        let mut n = 0;\n");
        buf_str(out, c"        while s[n] != 0 {\n");
        buf_str(out, c"            n += 1;\n");
        buf_str(out, c"        }\n");
