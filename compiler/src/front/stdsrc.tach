// Generated by compiler/std/embed.sh from compiler/std/std.tach,
// iter.tach, io.tach, fmt.tach, convert.tach, clone.tach, alloc.tach
// gpa.tach and alloc_check.tach (do not edit): the standard library's
// source (0.5), read when a program names `std` (modules.tach).

use crate::base::buf_str;
use crate::front::stdalloc::std_alloc_tail;

pub fn std_source(out: i64) {
    unsafe {
        buf_str(out, c"// The standard library (0.5): the module `std`, built into the compiler\n");
        buf_str(out, c"// (compiler/std/embed.sh makes compiler/src/front/stdsrc.tach from this file\n");
        buf_str(out, c"// and the ones it appends: iter.tach, io.tach, fmt.tach, convert.tach,\n");
        buf_str(out, c"// clone.tach, alloc.tach, then Gpa's implementation: gpa.tach). A program\n");
        buf_str(out, c"// that names `std` gets it: `std::Vec<i64>`, `use std::{Buf, Vec};`.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// This file, the core: Option and Result, a growable vector, a byte\n");
        buf_str(out, c"// buffer, the operator traits, sorting and a hash map.\n");
        buf_str(out, c"// Failures (unwrapping None, an index out of bounds) print a message on\n");
        buf_str(out, c"// stderr and exit with 101, like the language's own checks.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Allocation (0.16): Vec, Buf and HashMap take their memory from an\n");
        buf_str(out, c"// allocator, a type parameter (`Vec<T, A: Allocator = Gpa>`, alloc.tach),\n");
        buf_str(out, c"// every growth and free through it.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Unsafe code (0.9): the safe functions here have no undefined behaviour\n");
        buf_str(out, c"// as long as a Vec's and a Buf's fields are changed by their methods only\n");
        buf_str(out, c"// (0.16: #[sealed], checked from 0.16's T2), and a slice from `as_slice` (or a\n");
        buf_str(out, c"// HashMap's `get_mut`, `get_or_insert`) is not used after the Vec grows\n");
        buf_str(out, c"// (the map gets a new key) or is freed. The functions taking C strings\n");
        buf_str(out, c"// are `unsafe fn`: the string must end with a NUL.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.16) Their effects declared: allocation, I/O, none.\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[effects(alloc(extern))]\n");
        buf_str(out, c"    fn malloc(size: u64) -> *u8;\n");
        buf_str(out, c"    #[effects(alloc(extern))]\n");
        buf_str(out, c"    fn realloc(p: *u8, size: u64) -> *u8;\n");
        buf_str(out, c"    #[effects(alloc(extern))]\n");
        buf_str(out, c"    fn free(p: *u8);\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn write(fd: i32, data: *u8, count: u64) -> i64;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn read(fd: i32, data: *u8, count: u64) -> i64;\n");
        buf_str(out, c"    #[effects(io, diverge)]\n");
        buf_str(out, c"    fn exit(code: i32) -> !;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn memcpy(dst: *u8, src: *u8, n: u64) -> *u8;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn strlen(s: *u8) -> u64;\n");
        buf_str(out, c"    // (0.16) What std's panic calls: its effect is `panic`, not the io of\n");
        buf_str(out, c"    // writing a message and exiting (docs/design/effects-allocation.md\n");
        buf_str(out, c"    // §2.2).\n");
        buf_str(out, c"    #[link_name = \"write\"]\n");
        buf_str(out, c"    #[effects(panic)]\n");
        buf_str(out, c"    fn panic_write(fd: i32, data: *u8, count: u64) -> i64;\n");
        buf_str(out, c"    #[link_name = \"exit\"]\n");
        buf_str(out, c"    #[effects(panic)]\n");
        buf_str(out, c"    fn panic_exit(code: i32) -> !;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Prints `message` (a C string) on stderr and exits with 101.\n");
        buf_str(out, c"pub unsafe fn panic(message: *u8) -> ! {\n");
        buf_str(out, c"    panic_write(2, message, strlen(message));\n");
        buf_str(out, c"    panic_write(2, c\"\\n\", 1);\n");
        buf_str(out, c"    panic_note();\n");
        buf_str(out, c"    panic_exit(101)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.17) The line after a failure's message; a program built with\n");
        buf_str(out, c"// --trace prints the calls that led to the failure instead (the compiler\n");
        buf_str(out, c"// makes this call one of its trace runtime's, compiler/src/middle/trace.tach).\n");
        buf_str(out, c"// (0.18) Without --trace, nothing: a failure is one line.\n");
        buf_str(out, c"fn panic_note() {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Option and Result ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub enum Option<T> { None, Some(T) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Option<T> {\n");
        buf_str(out, c"    pub fn is_some(self: &Option<T>) -> bool {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            Option::Some(_) => true,\n");
        buf_str(out, c"            Option::None => false,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_none(self: &Option<T>) -> bool {\n");
        buf_str(out, c"        !self.is_some()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap(self: Option<T>) -> T\n");
        buf_str(out, c"        requires self.is_some() else \"called unwrap on None\"\n");
        buf_str(out, c"    {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => x,\n");
        buf_str(out, c"            Option::None => unsafe { panic(c\"called unwrap on None\") },\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap_or(self: Option<T>, other: T) -> T {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => x,\n");
        buf_str(out, c"            Option::None => other,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub enum Result<T, E> { Ok(T), Err(E) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, E> Result<T, E> {\n");
        buf_str(out, c"    pub fn is_ok(self: &Result<T, E>) -> bool {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            Result::Ok(_) => true,\n");
        buf_str(out, c"            Result::Err(_) => false,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_err(self: &Result<T, E>) -> bool {\n");
        buf_str(out, c"        !self.is_ok()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap(self: Result<T, E>) -> T\n");
        buf_str(out, c"        requires self.is_ok() else \"called unwrap on Err\"\n");
        buf_str(out, c"    {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => x,\n");
        buf_str(out, c"            Result::Err(_) => unsafe { panic(c\"called unwrap on Err\") },\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap_or(self: Result<T, E>, other: T) -> T {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => x,\n");
        buf_str(out, c"            Result::Err(_) => other,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn ok(self: Result<T, E>) -> Option<T> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => Option::Some(x),\n");
        buf_str(out, c"            Result::Err(_) => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Vec ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A growable vector of T, its memory from allocator A (0.16; Gpa, C's\n");
        buf_str(out, c"// malloc, by default); `free` gives its memory back.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct Vec<T, A: Allocator = Gpa> { ptr: *T, len: i64, cap: i64, alloc: A }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // An empty Vec on allocator a (0.16).\n");
        buf_str(out, c"    pub fn new_in(a: A) -> Vec<T, A> {\n");
        buf_str(out, c"        Vec { ptr: 0 as *T, len: 0, cap: 0, alloc: a }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An empty Vec on allocator a with room for cap elements (0.16).\n");
        buf_str(out, c"    pub fn with_capacity_in(cap: i64, a: A) -> Vec<T, A> {\n");
        buf_str(out, c"        let mut v: Vec<T, A> = Vec::new_in(a);\n");
        buf_str(out, c"        v.reserve(cap);\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn len(self: &Vec<T, A>) -> i64 {\n");
        buf_str(out, c"        self.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_empty(self: &Vec<T, A>) -> bool {\n");
        buf_str(out, c"        self.len == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Room for `extra` more elements.\n");
        buf_str(out, c"    pub fn reserve(self: &mut Vec<T, A>, extra: i64) {\n");
        buf_str(out, c"        if extra > self.cap - self.len && !self.reserve_more(extra) {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Grows to room for `extra` (more than it has) more elements: twice the\n");
        buf_str(out, c"    // capacity, or more when needed; false when out of memory.\n");
        buf_str(out, c"    #[inline(never)]\n");
        buf_str(out, c"    fn reserve_more(self: &mut Vec<T, A>, extra: i64) -> bool {\n");
        buf_str(out, c"        if extra > ALLOC_LIMIT - self.len {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let cap = grown_cap(self.cap, self.len + extra);\n");
        buf_str(out, c"        let bytes = alloc_bytes(cap, size_of(T));\n");
        buf_str(out, c"        if bytes < 0 {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let p = unsafe {\n");
        buf_str(out, c"            self.alloc.try_resize(self.ptr as *u8, self.cap * size_of(T), bytes, align_of(T))\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        if p == 0 as *u8 {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.ptr = p as *T;\n");
        buf_str(out, c"        self.cap = cap;\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Appends the elements of s, which may be a view of this Vec: when it\n");
        buf_str(out, c"    // grows, the elements are copied to the new memory before the old is\n");
        buf_str(out, c"    // freed.\n");
        buf_str(out, c"    #[stores(*s)]\n");
        buf_str(out, c"    pub fn extend_from_slice(self: &mut Vec<T, A>, s: [T]) {\n");
        buf_str(out, c"        let n = s.len;\n");
        buf_str(out, c"        let mut old = 0 as *T;\n");
        buf_str(out, c"        let mut old_cap = 0;\n");
        buf_str(out, c"        if n > self.cap - self.len {\n");
        buf_str(out, c"            let mut cap = -1;\n");
        buf_str(out, c"            if n <= ALLOC_LIMIT - self.len {\n");
        buf_str(out, c"                cap = grown_cap(self.cap, self.len + n);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let bytes = alloc_bytes(cap, size_of(T));\n");
        buf_str(out, c"            if bytes < 0 {\n");
        buf_str(out, c"                out_of_memory();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            old = self.ptr;\n");
        buf_str(out, c"            old_cap = self.cap;\n");
        buf_str(out, c"            let p = self.alloc.try_alloc(bytes, align_of(T));\n");
        buf_str(out, c"            if p == 0 as *u8 {\n");
        buf_str(out, c"                out_of_memory();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                self.ptr = p as *T;\n");
        buf_str(out, c"                for i in 0..self.len {\n");
        buf_str(out, c"                    self.ptr[i] = old[i];\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.cap = cap;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for i in 0..n {\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                self.ptr[self.len + i] = s[i];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len += n;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.alloc.free(old as *u8, old_cap * size_of(T), align_of(T));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[stores(x)]\n");
        buf_str(out, c"    pub fn push(self: &mut Vec<T, A>, x: T) {\n");
        buf_str(out, c"        if self.len == self.cap && !self.reserve_more(1) {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.ptr[self.len] = x;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn pop(self: &mut Vec<T, A>) -> Option<T> {\n");
        buf_str(out, c"        if self.len == 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len -= 1;\n");
        buf_str(out, c"        Option::Some(unsafe { self.ptr[self.len] })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Element i (checked: out of bounds exits with 101).\n");
        buf_str(out, c"    pub fn get(self: &Vec<T, A>, i: i64) -> T\n");
        buf_str(out, c"        requires 0 <= i && i < self.len else f\"index out of bounds: index {i}, length {self.len}\"\n");
        buf_str(out, c"    {\n");
        buf_str(out, c"        self.as_slice()[i]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[stores(x)]\n");
        buf_str(out, c"    pub fn set(self: &mut Vec<T, A>, i: i64, x: T)\n");
        buf_str(out, c"        requires 0 <= i && i < self.len else f\"index out of bounds: index {i}, length {self.len}\"\n");
        buf_str(out, c"    {\n");
        buf_str(out, c"        self.as_mut_slice()[i] = x;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The last element, if there is one (the Vec keeps it; `pop` takes it).\n");
        buf_str(out, c"    pub fn last(self: &Vec<T, A>) -> Option<T> {\n");
        buf_str(out, c"        if self.len == 0 { Option::None } else { Option::Some(self.get(self.len - 1)) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Exchanges elements i and j (checked).\n");
        buf_str(out, c"    pub fn swap(self: &mut Vec<T, A>, i: i64, j: i64)\n");
        buf_str(out, c"        requires 0 <= i && i < self.len else f\"index out of bounds: index {i}, length {self.len}\"\n");
        buf_str(out, c"        requires 0 <= j && j < self.len else f\"index out of bounds: index {j}, length {self.len}\"\n");
        buf_str(out, c"    {\n");
        buf_str(out, c"        swap_at::<T>(self.as_mut_slice(), i, j);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Puts x at index i, 0 to len (checked), moving the elements from i\n");
        buf_str(out, c"    // on up by one.\n");
        buf_str(out, c"    #[stores(x)]\n");
        buf_str(out, c"    pub fn insert(self: &mut Vec<T, A>, i: i64, x: T)\n");
        buf_str(out, c"        requires 0 <= i && i <= self.len\n");
        buf_str(out, c"        else f\"Vec::insert: index {i} out of bounds, length {self.len}\"\n");
        buf_str(out, c"        {\n");
        buf_str(out, c"        if i < 0 || i > self.len {\n");
        buf_str(out, c"            unsafe { panic(c\"Vec::insert: index out of bounds\") }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.reserve(1);\n");
        buf_str(out, c"        // (0.17: the elements moved up as bits, not as values)\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let p = self.ptr;\n");
        buf_str(out, c"            let last = self.len;\n");
        buf_str(out, c"            for d in 0..last - i {\n");
        buf_str(out, c"                let k = last - d;\n");
        buf_str(out, c"                p[k] = p[k - 1];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            p[i] = x;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Takes element i out (checked) and returns it, moving the elements\n");
        buf_str(out, c"    // after it down by one.\n");
        buf_str(out, c"    pub fn remove(self: &mut Vec<T, A>, i: i64) -> T\n");
        buf_str(out, c"        requires 0 <= i && i < self.len else f\"index out of bounds: index {i}, length {self.len}\"\n");
        buf_str(out, c"    {\n");
        buf_str(out, c"        // (checked; 0.17: the elements moved down as bits, not as values)\n");
        buf_str(out, c"        let at: *T = &self.as_slice()[i];\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let x = *at;\n");
        buf_str(out, c"            let p = self.ptr;\n");
        buf_str(out, c"            for k in i..self.len - 1 {\n");
        buf_str(out, c"                p[k] = p[k + 1];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.len -= 1;\n");
        buf_str(out, c"            x\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Keeps the first n elements (all of them when there are fewer); 0.17:\n");
        buf_str(out, c"    // the others are dropped.\n");
        buf_str(out, c"    pub fn truncate(self: &mut Vec<T, A>, n: i64) {\n");
        buf_str(out, c"        if n >= 0 && n < self.len {\n");
        buf_str(out, c"            let len = self.len;\n");
        buf_str(out, c"            self.len = n;\n");
        buf_str(out, c"            if needs_drop::<T>() {\n");
        buf_str(out, c"                for i in n..len {\n");
        buf_str(out, c"                    drop(unsafe { self.ptr[i] });\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements, a view (0.17: valid while the Vec is not changed).\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn as_slice(self: &Vec<T, A>) -> [T] {\n");
        buf_str(out, c"        unsafe { self.ptr[0..self.len] }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements, to change in place (0.17): `sort(v.as_mut_slice())`.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn as_mut_slice(self: &mut Vec<T, A>) -> &mut [T] {\n");
        buf_str(out, c"        unsafe { &mut self.ptr[0..self.len] }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Drops the elements (0.17); the room stays.\n");
        buf_str(out, c"    pub fn clear(self: &mut Vec<T, A>) {\n");
        buf_str(out, c"        self.truncate(0);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements dropped and its memory given back; it is left empty, to\n");
        buf_str(out, c"    // use again (0.17: a Vec is dropped at the end of its scope without\n");
        buf_str(out, c"    // it; `self.items.free()` through a reference still works, and a\n");
        buf_str(out, c"    // second free frees nothing).\n");
        buf_str(out, c"    pub fn free(self: &mut Vec<T, A>) {\n");
        buf_str(out, c"        self.release();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements, in a Vec on the same allocator; it is left empty\n");
        buf_str(out, c"    // (0.17: `std::take` for a container, which keeps its allocator).\n");
        buf_str(out, c"    pub fn take(self: &mut Vec<T, A>) -> Vec<T, A> {\n");
        buf_str(out, c"        let empty: Vec<T, A> = Vec::new_in(self.alloc);\n");
        buf_str(out, c"        replace(self, empty)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The elements dropped and the memory given back: empty, with no memory\n");
        buf_str(out, c"    // (0.17: drop and free).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn release(self: &mut Vec<T, A>) {\n");
        buf_str(out, c"        self.truncate(0);\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.alloc.free(self.ptr as *u8, self.cap * size_of(T), align_of(T));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.ptr = 0 as *T;\n");
        buf_str(out, c"        self.cap = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.17) A Vec's drop: its elements' drops, then its memory given back.\n");
        buf_str(out, c"impl<T, A: Allocator> Drop for Vec<T, A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn drop(self: &mut Vec<T, A>) {\n");
        buf_str(out, c"        self.release();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.16) The ambient constructors of 0.15, errors outside std: allocation\n");
        buf_str(out, c"// is explicit (front/ambient.tach; fix --only alloc016 reads them).\n");
        buf_str(out, c"impl<T, A: Allocator + Ambient> Vec<T, A> {\n");
        buf_str(out, c"    #[ambient(\"Vec::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> Vec<T, A> {\n");
        buf_str(out, c"        Vec { ptr: 0 as *T, len: 0, cap: 0, alloc: A::ambient() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"Vec::with_capacity_in(cap, gpa)\")]\n");
        buf_str(out, c"    pub fn with_capacity(cap: i64) -> Vec<T, A> {\n");
        buf_str(out, c"        Vec::with_capacity_in(cap, A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"Vec::filled_in(n, x, gpa)\")]\n");
        buf_str(out, c"    pub fn filled(n: i64, x: T) -> Vec<T, A> {\n");
        buf_str(out, c"        Vec::filled_in(n, x, A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Vec's room and allocator (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // The elements it has room for (0.16).\n");
        buf_str(out, c"    pub fn capacity(self: &Vec<T, A>) -> i64 {\n");
        buf_str(out, c"        self.cap\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its allocator (0.16): a copy of the handle.\n");
        buf_str(out, c"    pub fn allocator(self: &Vec<T, A>) -> A {\n");
        buf_str(out, c"        self.alloc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Room for `extra` more elements, or Err when out of memory, the Vec\n");
        buf_str(out, c"    // as it was (0.16).\n");
        buf_str(out, c"    pub fn try_reserve(self: &mut Vec<T, A>, extra: i64) -> Result<(), AllocError> {\n");
        buf_str(out, c"        if extra > self.cap - self.len && !self.reserve_more(extra) {\n");
        buf_str(out, c"            return Result::Err(AllocError::OutOfMemory);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Result::Ok(())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // push, or Err when out of memory, the Vec as it was (0.16).\n");
        buf_str(out, c"    #[stores(x)]\n");
        buf_str(out, c"    pub fn try_push(self: &mut Vec<T, A>, x: T) -> Result<(), AllocError> {\n");
        buf_str(out, c"        if self.len == self.cap && !self.reserve_more(1) {\n");
        buf_str(out, c"            return Result::Err(AllocError::OutOfMemory);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.ptr[self.len] = x;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len += 1;\n");
        buf_str(out, c"        Result::Ok(())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Buf ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A growable buffer of bytes, for building text (0.16: on allocator A).\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct Buf<A: Allocator = Gpa> { bytes: Vec<u8, A> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Buf<A> {\n");
        buf_str(out, c"    // An empty Buf on allocator a (0.16).\n");
        buf_str(out, c"    pub fn new_in(a: A) -> Buf<A> {\n");
        buf_str(out, c"        Buf { bytes: Vec::new_in(a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn len(self: &Buf<A>) -> i64 {\n");
        buf_str(out, c"        self.bytes.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn push(self: &mut Buf<A>, b: u8) {\n");
        buf_str(out, c"        self.bytes.push(b);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Appends s, which may be a view of this Buf.\n");
        buf_str(out, c"    pub fn push_str(self: &mut Buf<A>, s: [u8]) {\n");
        buf_str(out, c"        self.bytes.extend_from_slice(s);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A C string (up to its NUL).\n");
        buf_str(out, c"    pub unsafe fn push_cstr(self: &mut Buf<A>, s: *u8) {\n");
        buf_str(out, c"        self.bytes.extend_from_slice(s[0..strlen(s) as i64]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The decimal digits of v.\n");
        buf_str(out, c"    pub fn push_int(self: &mut Buf<A>, v: i64) {\n");
        buf_str(out, c"        let negative = v < 0;\n");
        buf_str(out, c"        let u = if negative { (-(v + 1)) as u64 + 1 } else { v as u64 };\n");
        buf_str(out, c"        let n = if negative { decimal_len(u) + 1 } else { decimal_len(u) };\n");
        buf_str(out, c"        if n > self.bytes.cap - self.bytes.len {\n");
        buf_str(out, c"            self.bytes.reserve(n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            put_decimal(&self.bytes.ptr[self.bytes.len], n, u, negative);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.bytes.len += n;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its bytes, a view (0.17: valid while the Buf is not changed).\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn as_slice(self: &Buf<A>) -> [u8] {\n");
        buf_str(out, c"        self.bytes.as_slice()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its bytes, to change in place (0.17).\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn as_mut_slice(self: &mut Buf<A>) -> &mut [u8] {\n");
        buf_str(out, c"        self.bytes.as_mut_slice()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn clear(self: &mut Buf<A>) {\n");
        buf_str(out, c"        self.bytes.clear();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its memory given back; it is left empty, to use again (0.17: a Buf is\n");
        buf_str(out, c"    // dropped at the end of its scope without it).\n");
        buf_str(out, c"    pub fn free(self: &mut Buf<A>) {\n");
        buf_str(out, c"        self.bytes.release();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its bytes, in a Buf on the same allocator; it is left empty (0.17:\n");
        buf_str(out, c"    // `std::take` for a container, which keeps its allocator).\n");
        buf_str(out, c"    pub fn take(self: &mut Buf<A>) -> Buf<A> {\n");
        buf_str(out, c"        Buf { bytes: self.bytes.take() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.17) A Buf's drop: its memory given back.\n");
        buf_str(out, c"impl<A: Allocator> Drop for Buf<A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn drop(self: &mut Buf<A>) {\n");
        buf_str(out, c"        self.bytes.release();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Buf<A> {\n");
        buf_str(out, c"    // A new Buf of the bytes of s on allocator a (0.17): text that must\n");
        buf_str(out, c"    // outlive the slice it came from.\n");
        buf_str(out, c"    pub fn from_in(s: [u8], a: A) -> Buf<A> {\n");
        buf_str(out, c"        let mut b: Buf<A> = Buf::with_capacity_in(s.len, a);\n");
        buf_str(out, c"        b.push_str(s);\n");
        buf_str(out, c"        b\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator + Ambient> Buf<A> {\n");
        buf_str(out, c"    #[ambient(\"Buf::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> Buf<A> {\n");
        buf_str(out, c"        Buf { bytes: Vec::new_in(A::ambient()) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The number of decimal digits of u.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn decimal_len(u: u64) -> i64 {\n");
        buf_str(out, c"    let mut n = 1;\n");
        buf_str(out, c"    let mut ten: u64 = 10;\n");
        buf_str(out, c"    for _ in 1..20 {\n");
        buf_str(out, c"        if u < ten {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        n += 1;\n");
        buf_str(out, c"        ten *= 10;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    n\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// u's decimal digits in p[0..n] (n: decimal_len(u), one more when\n");
        buf_str(out, c"// negative: after a '-'), two at a time. Unsafe: p has n bytes.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn put_decimal(p: *u8, n: i64, u: u64, negative: bool) {\n");
        buf_str(out, c"    let pairs = \"00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899\";\n");
        buf_str(out, c"    let mut x = u;\n");
        buf_str(out, c"    let mut i = n;\n");
        buf_str(out, c"    for _ in 0..10 {\n");
        buf_str(out, c"        if x < 100 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let q = x / 100;\n");
        buf_str(out, c"        let r = (x - q * 100) as i64 * 2;\n");
        buf_str(out, c"        i -= 2;\n");
        buf_str(out, c"        p[i] = pairs.ptr[r];\n");
        buf_str(out, c"        p[i + 1] = pairs.ptr[r + 1];\n");
        buf_str(out, c"        x = q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if x >= 10 {\n");
        buf_str(out, c"        let r = x as i64 * 2;\n");
        buf_str(out, c"        p[i - 2] = pairs.ptr[r];\n");
        buf_str(out, c"        p[i - 1] = pairs.ptr[r + 1];\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        p[i - 1] = '0' + x as u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if negative {\n");
        buf_str(out, c"        p[0] = '-';\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Buf's room and allocator (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Buf<A> {\n");
        buf_str(out, c"    // An empty Buf on allocator a with room for cap bytes (0.16).\n");
        buf_str(out, c"    pub fn with_capacity_in(cap: i64, a: A) -> Buf<A> {\n");
        buf_str(out, c"        Buf { bytes: Vec::with_capacity_in(cap, a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The bytes it has room for (0.16).\n");
        buf_str(out, c"    pub fn capacity(self: &Buf<A>) -> i64 {\n");
        buf_str(out, c"        self.bytes.cap\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Room for `extra` more bytes (0.16).\n");
        buf_str(out, c"    pub fn reserve(self: &mut Buf<A>, extra: i64) {\n");
        buf_str(out, c"        self.bytes.reserve(extra);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its allocator (0.16): a copy of the handle.\n");
        buf_str(out, c"    pub fn allocator(self: &Buf<A>) -> A {\n");
        buf_str(out, c"        self.bytes.alloc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Traits (0.9) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The operators: `a + b` on a type implementing Add is `a.add(b)`, and so\n");
        buf_str(out, c"// on; `-a` is `a.neg()`; `a == b` is `a.eq(&b)` (an impl wins over the\n");
        buf_str(out, c"// structural ==); `a < b` is `a.cmp(&b) < 0`. Numbers implement them all\n");
        buf_str(out, c"// without impl blocks, every type with == implements Eq, and numbers,\n");
        buf_str(out, c"// pointers and fieldless enums Ord.\n");
        buf_str(out, c"pub trait Add { fn add(self: Self, other: Self) -> Self; }\n");
        buf_str(out, c"pub trait Sub { fn sub(self: Self, other: Self) -> Self; }\n");
        buf_str(out, c"pub trait Mul { fn mul(self: Self, other: Self) -> Self; }\n");
        buf_str(out, c"pub trait Div { fn div(self: Self, other: Self) -> Self; }\n");
        buf_str(out, c"pub trait Neg { fn neg(self: Self) -> Self; }\n");
        buf_str(out, c"pub trait Eq { #[pure] fn eq(self: &Self, other: &Self) -> bool; }\n");
        buf_str(out, c"// Negative, zero or positive: self before, like or after other.\n");
        buf_str(out, c"pub trait Ord { #[pure] fn cmp(self: &Self, other: &Self) -> i64; }\n");
        buf_str(out, c"pub trait Hash { #[pure] fn hash(self: &Self) -> u64; }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A 64-bit mix of x (splitmix64's finalizer): the hash of the integers.\n");
        buf_str(out, c"pub fn hash_u64(x: u64) -> u64 {\n");
        buf_str(out, c"    let mut z = x + 0x9e3779b97f4a7c15u64;\n");
        buf_str(out, c"    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9u64;\n");
        buf_str(out, c"    z = (z ^ (z >> 27)) * 0x94d049bb133111ebu64;\n");
        buf_str(out, c"    z ^ (z >> 31)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for i8 {\n");
        buf_str(out, c"    fn eq(self: &i8, other: &i8) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for i8 {\n");
        buf_str(out, c"    fn cmp(self: &i8, other: &i8) -> i64 {\n");
        buf_str(out, c"        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for i8 {\n");
        buf_str(out, c"    fn hash(self: &i8) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for i16 {\n");
        buf_str(out, c"    fn eq(self: &i16, other: &i16) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for i16 {\n");
        buf_str(out, c"    fn cmp(self: &i16, other: &i16) -> i64 {\n");
        buf_str(out, c"        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for i16 {\n");
        buf_str(out, c"    fn hash(self: &i16) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for i32 {\n");
        buf_str(out, c"    fn eq(self: &i32, other: &i32) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for i32 {\n");
        buf_str(out, c"    fn cmp(self: &i32, other: &i32) -> i64 {\n");
        buf_str(out, c"        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for i32 {\n");
        buf_str(out, c"    fn hash(self: &i32) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for i64 {\n");
        buf_str(out, c"    fn eq(self: &i64, other: &i64) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for i64 {\n");
        buf_str(out, c"    fn cmp(self: &i64, other: &i64) -> i64 {\n");
        buf_str(out, c"        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for i64 {\n");
        buf_str(out, c"    fn hash(self: &i64) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for u8 {\n");
        buf_str(out, c"    fn eq(self: &u8, other: &u8) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for u8 {\n");
        buf_str(out, c"    fn cmp(self: &u8, other: &u8) -> i64 {\n");
        buf_str(out, c"        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for u8 {\n");
        buf_str(out, c"    fn hash(self: &u8) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for u16 {\n");
        buf_str(out, c"    fn eq(self: &u16, other: &u16) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for u16 {\n");
        buf_str(out, c"    fn cmp(self: &u16, other: &u16) -> i64 {\n");
        buf_str(out, c"        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for u16 {\n");
        buf_str(out, c"    fn hash(self: &u16) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for u32 {\n");
        buf_str(out, c"    fn eq(self: &u32, other: &u32) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for u32 {\n");
        buf_str(out, c"    fn cmp(self: &u32, other: &u32) -> i64 {\n");
        buf_str(out, c"        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for u32 {\n");
        buf_str(out, c"    fn hash(self: &u32) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for u64 {\n");
        buf_str(out, c"    fn eq(self: &u64, other: &u64) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for u64 {\n");
        buf_str(out, c"    fn cmp(self: &u64, other: &u64) -> i64 {\n");
        buf_str(out, c"        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for u64 {\n");
        buf_str(out, c"    fn hash(self: &u64) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for bool {\n");
        buf_str(out, c"    fn eq(self: &bool, other: &bool) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for bool {\n");
        buf_str(out, c"    fn cmp(self: &bool, other: &bool) -> i64 {\n");
        buf_str(out, c"        if !*self && *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for bool {\n");
        buf_str(out, c"    fn hash(self: &bool) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Byte strings: compared by bytes, ordered lexicographically, hashed with\n");
        buf_str(out, c"// FNV-1a.\n");
        buf_str(out, c"impl Eq for [u8] {\n");
        buf_str(out, c"    fn eq(self: &Self, other: &Self) -> bool {\n");
        buf_str(out, c"        let a = *self;\n");
        buf_str(out, c"        let b = *other;\n");
        buf_str(out, c"        if a.len != b.len {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for i in 0..a.len {\n");
        buf_str(out, c"            if a[i] != b[i] {\n");
        buf_str(out, c"                return false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for [u8] {\n");
        buf_str(out, c"    fn cmp(self: &Self, other: &Self) -> i64 {\n");
        buf_str(out, c"        let a = *self;\n");
        buf_str(out, c"        let b = *other;\n");
        buf_str(out, c"        let n = if a.len < b.len { a.len } else { b.len };\n");
        buf_str(out, c"        for i in 0..n {\n");
        buf_str(out, c"            if a[i] != b[i] {\n");
        buf_str(out, c"                return if a[i] < b[i] { -1 } else { 1 };\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if a.len < b.len { -1 } else if a.len == b.len { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for [u8] {\n");
        buf_str(out, c"    fn hash(self: &Self) -> u64 {\n");
        buf_str(out, c"        let mut h = 14695981039346656037u64;\n");
        buf_str(out, c"        for b in *self {\n");
        buf_str(out, c"            h = (h ^ b as u64) * 1099511628211u64;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        h\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place, smallest first; not stable (equal elements may change\n");
        buf_str(out, c"// order). An introsort: quicksort around the median of three, insertion\n");
        buf_str(out, c"// sort for short runs, heapsort where the quicksort goes too deep, so\n");
        buf_str(out, c"// O(n log n) comparisons at worst. A `cmp` that is not a total order\n");
        buf_str(out, c"// leaves s in some order, never out of bounds. (0.16: its loops are\n");
        buf_str(out, c"// counted, and the ranges left to sort are on a stack, not recursion: it\n");
        buf_str(out, c"// does not have the effect diverge.) (0.17) `sort(&mut a[..])`,\n");
        buf_str(out, c"// `sort(v.as_mut_slice())`, `v.sort()`; the elements move as bits, so any\n");
        buf_str(out, c"// T: Ord sorts, owned ones too.\n");
        buf_str(out, c"pub fn sort<T: Ord>(s: &mut [T]) {\n");
        buf_str(out, c"    let mut depth = 0;\n");
        buf_str(out, c"    for k in 0..64 {\n");
        buf_str(out, c"        if (s.len >> k) <= 1 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        depth += 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        quicksort::<T>(s.ptr, 0, s.len, depth);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Ord, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // Sorts it in place, smallest first (0.17; see sort).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn sort(self: &mut Vec<T, A>) {\n");
        buf_str(out, c"        sort(self.as_mut_slice());\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Ord>[T] {\n");
        buf_str(out, c"    // Sorts it in place, smallest first (0.17; see sort).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn sort(self: &mut [T]) {\n");
        buf_str(out, c"        sort(self);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Short runs are sorted by insertion.\n");
        buf_str(out, c"const SORT_SMALL: i64 = 24;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts p[lo..hi]; below `depth` more partitions, by heapsort. Each\n");
        buf_str(out, c"// partition puts its pivot in place, sorts the shorter side next and\n");
        buf_str(out, c"// keeps the longer for later (at most 64 kept: each is at least twice as\n");
        buf_str(out, c"// long as the one sorted next). (0.17) Unsafe: p has hi elements; every\n");
        buf_str(out, c"// index below stays in lo..hi by the loops' counts.\n");
        buf_str(out, c"// (not inlined into sort's caller: its loops keep their registers)\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"unsafe fn quicksort<T: Ord>(p: *T, lo: i64, hi: i64, depth: i64) {\n");
        buf_str(out, c"    let mut lo = lo;\n");
        buf_str(out, c"    let mut hi = hi;\n");
        buf_str(out, c"    let mut depth = depth;\n");
        buf_str(out, c"    let mut kept_lo: [i64; 64] = [0; 64];\n");
        buf_str(out, c"    let mut kept_hi: [i64; 64] = [0; 64];\n");
        buf_str(out, c"    let mut kept_depth: [i64; 64] = [0; 64];\n");
        buf_str(out, c"    let mut kept = 0;\n");
        buf_str(out, c"    // (each round places a pivot or finishes a range: 2n + 1 at most)\n");
        buf_str(out, c"    for _ in 0..2 * (hi - lo) + 1 {\n");
        buf_str(out, c"        if hi - lo <= SORT_SMALL || depth == 0 {\n");
        buf_str(out, c"            if hi - lo <= SORT_SMALL {\n");
        buf_str(out, c"                insertion_sort::<T>(p, lo, hi);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                heapsort::<T>(&p[lo], hi - lo);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if kept == 0 {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            kept -= 1;\n");
        buf_str(out, c"            lo = kept_lo[kept];\n");
        buf_str(out, c"            hi = kept_hi[kept];\n");
        buf_str(out, c"            depth = kept_depth[kept];\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        depth -= 1;\n");
        buf_str(out, c"        // The median of the first, middle and last elements, at lo.\n");
        buf_str(out, c"        let mid = lo + (hi - lo) / 2;\n");
        buf_str(out, c"        if p[mid] < p[lo] {\n");
        buf_str(out, c"            swap_raw::<T>(p, mid, lo);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if p[hi - 1] < p[mid] {\n");
        buf_str(out, c"            swap_raw::<T>(p, hi - 1, mid);\n");
        buf_str(out, c"            if p[mid] < p[lo] {\n");
        buf_str(out, c"                swap_raw::<T>(p, mid, lo);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        swap_raw::<T>(p, lo, mid);\n");
        buf_str(out, c"        // Hoare's partition: p[lo..q] <= pivot <= p[q + 1..hi]. Equal\n");
        buf_str(out, c"        // elements stop both scans, so many equal keys split evenly.\n");
        buf_str(out, c"        let pivot = p[lo];\n");
        buf_str(out, c"        let mut i = lo;\n");
        buf_str(out, c"        let mut j = hi;\n");
        buf_str(out, c"        // (i < hi and lo < j <= hi - 1 by the scans' counts)\n");
        buf_str(out, c"        for _ in lo..hi {\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"            for _ in i..hi {\n");
        buf_str(out, c"                if !(p[i] < pivot) {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                i += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            j -= 1;\n");
        buf_str(out, c"            for _ in lo..j {\n");
        buf_str(out, c"                if !(pivot < p[j]) {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                j -= 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if i >= j {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            swap_raw::<T>(p, i, j);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        swap_raw::<T>(p, lo, j);\n");
        buf_str(out, c"        // The shorter side next, the longer kept.\n");
        buf_str(out, c"        if kept == 64 {\n");
        buf_str(out, c"            // (not reached: see above)\n");
        buf_str(out, c"            heapsort::<T>(&p[lo], hi - lo);\n");
        buf_str(out, c"            hi = lo;\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        kept_depth[kept] = depth;\n");
        buf_str(out, c"        if j - lo < hi - j - 1 {\n");
        buf_str(out, c"            kept_lo[kept] = j + 1;\n");
        buf_str(out, c"            kept_hi[kept] = hi;\n");
        buf_str(out, c"            hi = j;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            kept_lo[kept] = lo;\n");
        buf_str(out, c"            kept_hi[kept] = j;\n");
        buf_str(out, c"            lo = j + 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        kept += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Unsafe: p has hi elements.\n");
        buf_str(out, c"unsafe fn insertion_sort<T: Ord>(p: *T, lo: i64, hi: i64) {\n");
        buf_str(out, c"    for i in lo + 1..hi {\n");
        buf_str(out, c"        let x = p[i];\n");
        buf_str(out, c"        let mut at = lo;\n");
        buf_str(out, c"        for d in 0..i - lo {\n");
        buf_str(out, c"            let j = i - d;\n");
        buf_str(out, c"            if !(x < p[j - 1]) {\n");
        buf_str(out, c"                at = j;\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            p[j] = p[j - 1];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        p[at] = x;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Exchanges s[i] and s[j] (checked), as bits: any T, owned ones too.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn swap_at<T>(s: &mut [T], i: i64, j: i64) {\n");
        buf_str(out, c"    let a: *T = &s[i];\n");
        buf_str(out, c"    let b: *T = &s[j];\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let t = *a;\n");
        buf_str(out, c"        *a = *b;\n");
        buf_str(out, c"        *b = t;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Exchanges p[i] and p[j], as bits. Unsafe: both are in p's elements.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn swap_raw<T>(p: *T, i: i64, j: i64) {\n");
        buf_str(out, c"    let t = p[i];\n");
        buf_str(out, c"    p[i] = p[j];\n");
        buf_str(out, c"    p[j] = t;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Unsafe: p has n elements.\n");
        buf_str(out, c"unsafe fn heapsort<T: Ord>(p: *T, n: i64) {\n");
        buf_str(out, c"    for k in 0..n / 2 {\n");
        buf_str(out, c"        sift_down::<T>(p, n / 2 - 1 - k, n);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for k in 1..n {\n");
        buf_str(out, c"        let end = n - k;\n");
        buf_str(out, c"        swap_raw::<T>(p, 0, end);\n");
        buf_str(out, c"        sift_down::<T>(p, 0, end);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (the root's index at least doubles each round: 64 at most) Unsafe: p\n");
        buf_str(out, c"// has `end` elements.\n");
        buf_str(out, c"unsafe fn sift_down<T: Ord>(p: *T, start: i64, end: i64) {\n");
        buf_str(out, c"    let mut root = start;\n");
        buf_str(out, c"    for _ in 0..64 {\n");
        buf_str(out, c"        let mut child = 2 * root + 1;\n");
        buf_str(out, c"        if child >= end {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if child + 1 < end && p[child] < p[child + 1] {\n");
        buf_str(out, c"            child += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if !(p[root] < p[child]) {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        swap_raw::<T>(p, root, child);\n");
        buf_str(out, c"        root = child;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Stable sort (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place, smallest first, keeping equal elements in the order\n");
        buf_str(out, c"// they had (0.15), with a buffer from allocator a (0.16):\n");
        buf_str(out, c"// `sort_stable_by_in` with `|a, b| a.cmp(b)`.\n");
        buf_str(out, c"pub fn sort_stable_in<T: Ord, A: Allocator>(s: &mut [T], a: A) {\n");
        buf_str(out, c"    sort_stable_by_in(s, |x: &T, y: &T| x.cmp(y), a);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"sort_stable_in(s, gpa)\")]\n");
        buf_str(out, c"pub fn sort_stable<T: Ord>(s: &mut [T]) {\n");
        buf_str(out, c"    sort_stable_in(s, Gpa::ambient());\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"sort_stable_by_in(s, f, gpa)\")]\n");
        buf_str(out, c"pub fn sort_stable_by<T, F: FnMut(&T, &T) -> i64>(s: &mut [T], f: F) {\n");
        buf_str(out, c"    sort_stable_by_in(s, f, Gpa::ambient());\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The runs sort_stable_by sorts by insertion before merging them.\n");
        buf_str(out, c"const STABLE_RUN: i64 = 16;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place by f (as sort_by: f(a, b) negative when *a goes before\n");
        buf_str(out, c"// *b), keeping equal elements in the order they had (0.15). A merge sort:\n");
        buf_str(out, c"// runs of 16 sorted by insertion, then merged in pairs through a buffer of\n");
        buf_str(out, c"// s.len elements from allocator a (0.16), so O(n log n) comparisons. A\n");
        buf_str(out, c"// `f` that is not a total order leaves s in some order, never out of\n");
        buf_str(out, c"// bounds. (0.17) The elements move as bits, between s and the buffer\n");
        buf_str(out, c"// through raw pointers (the buffer's elements are never its own: its\n");
        buf_str(out, c"// length stays 0).\n");
        buf_str(out, c"pub fn sort_stable_by_in<T, F: FnMut(&T, &T) -> i64, A: Allocator>(s: &mut [T], f: F, a: A) {\n");
        buf_str(out, c"    let mut g = f;\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    let p = s.ptr;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        for r in 0..(n + STABLE_RUN - 1) / STABLE_RUN {\n");
        buf_str(out, c"            let lo = r * STABLE_RUN;\n");
        buf_str(out, c"            let hi = if lo + STABLE_RUN < n { lo + STABLE_RUN } else { n };\n");
        buf_str(out, c"            for i in lo + 1..hi {\n");
        buf_str(out, c"                let x = p[i];\n");
        buf_str(out, c"                let mut j = i;\n");
        buf_str(out, c"                for _ in lo..i {\n");
        buf_str(out, c"                    if !(g(&x, &*(&p[j - 1])) < 0) {\n");
        buf_str(out, c"                        break;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    p[j] = p[j - 1];\n");
        buf_str(out, c"                    j -= 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                p[j] = x;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if n <= STABLE_RUN {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut buf: Vec<T, A> = Vec::with_capacity_in(n, a);\n");
        buf_str(out, c"    // (every element of `to` is written before it is read)\n");
        buf_str(out, c"    let mut from = p;\n");
        buf_str(out, c"    let mut to = buf.ptr;\n");
        buf_str(out, c"    let mut width = STABLE_RUN;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        // (the width doubles each round: 62 at most)\n");
        buf_str(out, c"        for _ in 0..62 {\n");
        buf_str(out, c"            if width >= n {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for q in 0..(n + 2 * width - 1) / (2 * width) {\n");
        buf_str(out, c"                let lo = q * 2 * width;\n");
        buf_str(out, c"                let mid = if lo + width < n { lo + width } else { n };\n");
        buf_str(out, c"                let hi = if mid + width < n { mid + width } else { n };\n");
        buf_str(out, c"                let mut i = lo;\n");
        buf_str(out, c"                let mut j = mid;\n");
        buf_str(out, c"                let mut k = lo;\n");
        buf_str(out, c"                for _ in lo..hi {\n");
        buf_str(out, c"                    if i >= mid || j >= hi {\n");
        buf_str(out, c"                        break;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    // (the left run's element first when they are equal)\n");
        buf_str(out, c"                    if g(&*(&from[j]), &*(&from[i])) < 0 {\n");
        buf_str(out, c"                        to[k] = from[j];\n");
        buf_str(out, c"                        j += 1;\n");
        buf_str(out, c"                    } else {\n");
        buf_str(out, c"                        to[k] = from[i];\n");
        buf_str(out, c"                        i += 1;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    k += 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                for ii in i..mid {\n");
        buf_str(out, c"                    to[k] = from[ii];\n");
        buf_str(out, c"                    k += 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                for jj in j..hi {\n");
        buf_str(out, c"                    to[k] = from[jj];\n");
        buf_str(out, c"                    k += 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let t = from;\n");
        buf_str(out, c"            from = to;\n");
        buf_str(out, c"            to = t;\n");
        buf_str(out, c"            width *= 2;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if from != p {\n");
        buf_str(out, c"            for i in 0..n {\n");
        buf_str(out, c"                p[i] = from[i];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    buf.free();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- HashMap ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A hash table (open addressing, linear probing) from K to V. Slots are\n");
        buf_str(out, c"// numbered 0..slots(); `key_at(i)` and `value_at(i)` give an occupied\n");
        buf_str(out, c"// slot's entry (None for a free one), which is how the map is iterated.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct HashMap<K: Hash + Eq, V, A: Allocator = Gpa> {\n");
        buf_str(out, c"    keys: *K, values: *V, states: *u8, cap: i64, len: i64, used: i64, alloc: A,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Slot states.\n");
        buf_str(out, c"const SLOT_FREE: u8 = 0;\n");
        buf_str(out, c"const SLOT_FULL: u8 = 1;\n");
        buf_str(out, c"const SLOT_GONE: u8 = 2;\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Hash + Eq, V, A: Allocator> HashMap<K, V, A> {\n");
        buf_str(out, c"    // An empty map on allocator a (0.16).\n");
        buf_str(out, c"    pub fn new_in(a: A) -> HashMap<K, V, A> {\n");
        buf_str(out, c"        HashMap {\n");
        buf_str(out, c"            keys: 0 as *K, values: 0 as *V, states: 0 as *u8, cap: 0, len: 0, used: 0, alloc: a\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn len(self: &HashMap<K, V, A>) -> i64 {\n");
        buf_str(out, c"        self.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_empty(self: &HashMap<K, V, A>) -> bool {\n");
        buf_str(out, c"        self.len == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The slot holding `key`, or -1.\n");
        buf_str(out, c"    fn slot_of(self: &HashMap<K, V, A>, key: &K) -> i64 {\n");
        buf_str(out, c"        if self.cap == 0 {\n");
        buf_str(out, c"            return -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let mask = self.cap - 1;\n");
        buf_str(out, c"        let mut i = (key.hash() & mask as u64) as i64;\n");
        buf_str(out, c"        // (a quarter of the slots at least are free: one ends the search)\n");
        buf_str(out, c"        for _ in 0..self.cap {\n");
        buf_str(out, c"            let state = unsafe { self.states[i] };\n");
        buf_str(out, c"            if state == SLOT_FREE {\n");
        buf_str(out, c"                return -1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if state == SLOT_FULL && unsafe { self.keys[i] } == *key {\n");
        buf_str(out, c"                return i;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i = (i + 1) & mask;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        -1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn contains(self: &HashMap<K, V, A>, key: K) -> bool {\n");
        buf_str(out, c"        self.slot_of(&key) >= 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The same as `contains` (Rust's name).\n");
        buf_str(out, c"    pub fn contains_key(self: &HashMap<K, V, A>, key: K) -> bool {\n");
        buf_str(out, c"        self.slot_of(&key) >= 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A copy of the value of `key`, if it has one (`get_mut` changes it).\n");
        buf_str(out, c"    pub fn get(self: &HashMap<K, V, A>, key: K) -> Option<V> {\n");
        buf_str(out, c"        let i = self.slot_of(&key);\n");
        buf_str(out, c"        if i < 0 { Option::None } else { Option::Some(unsafe { self.values[i] }) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The value of `key` in place, as a writable view of one element, if\n");
        buf_str(out, c"    // it has one: `if let Some(a) = m.get_mut(k) { a[0].balance += 10; }`.\n");
        buf_str(out, c"    // The view is valid until the map's next insert, remove or free (like\n");
        buf_str(out, c"    // a Vec's `as_mut_slice()`).\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn get_mut(self: &mut HashMap<K, V, A>, key: K) -> Option<&mut [V]> {\n");
        buf_str(out, c"        let i = self.slot_of(&key);\n");
        buf_str(out, c"        if i < 0 { Option::None } else { Option::Some(unsafe { &mut self.values[i..i + 1] }) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The value of `key` in place (a writable view of one element, as `get_mut`),\n");
        buf_str(out, c"    // inserted as `default` first if the key has none; Rust's\n");
        buf_str(out, c"    // `entry(k).or_insert(d)`. Counting: `counts.get_or_insert(w, 0)[0] += 1;`.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    #[stores(key, default)]\n");
        buf_str(out, c"    pub fn get_or_insert(self: &mut HashMap<K, V, A>, key: K, default: V) -> &mut [V] {\n");
        buf_str(out, c"        let mut i = self.slot_of(&key);\n");
        buf_str(out, c"        if i < 0 {\n");
        buf_str(out, c"            i = self.insert_new(key, default);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe { &mut self.values[i..i + 1] }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Sets the value of `key`; returns its old value, if it had one.\n");
        buf_str(out, c"    #[stores(key, value)]\n");
        buf_str(out, c"    pub fn insert(self: &mut HashMap<K, V, A>, key: K, value: V) -> Option<V> {\n");
        buf_str(out, c"        let i = self.slot_of(&key);\n");
        buf_str(out, c"        if i >= 0 {\n");
        buf_str(out, c"            let old = unsafe { self.values[i] };\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                self.values[i] = value;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return Option::Some(old);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.insert_new(key, value);\n");
        buf_str(out, c"        Option::None\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Adds `key`, which the map does not have; returns its slot.\n");
        buf_str(out, c"    fn insert_new(self: &mut HashMap<K, V, A>, key: K, value: V) -> i64 {\n");
        buf_str(out, c"        if (self.used + 1) * 4 > self.cap * 3 {\n");
        buf_str(out, c"            self.rehash();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let mask = self.cap - 1;\n");
        buf_str(out, c"        let mut j = (key.hash() & mask as u64) as i64;\n");
        buf_str(out, c"        for _ in 0..self.cap {\n");
        buf_str(out, c"            if unsafe { self.states[j] } != SLOT_FULL {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            j = (j + 1) & mask;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            if self.states[j] == SLOT_FREE {\n");
        buf_str(out, c"                self.used += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.states[j] = SLOT_FULL;\n");
        buf_str(out, c"            self.keys[j] = key;\n");
        buf_str(out, c"            self.values[j] = value;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len += 1;\n");
        buf_str(out, c"        j\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes `key`; returns its value, if it had one.\n");
        buf_str(out, c"    pub fn remove(self: &mut HashMap<K, V, A>, key: K) -> Option<V> {\n");
        buf_str(out, c"        let i = self.slot_of(&key);\n");
        buf_str(out, c"        if i < 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len -= 1;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.states[i] = SLOT_GONE;\n");
        buf_str(out, c"            // (0.17: the key goes with its entry)\n");
        buf_str(out, c"            if needs_drop::<K>() {\n");
        buf_str(out, c"                drop(self.keys[i]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Option::Some(self.values[i])\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn slots(self: &HashMap<K, V, A>) -> i64 {\n");
        buf_str(out, c"        self.cap\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn key_at(self: &HashMap<K, V, A>, i: i64) -> Option<K> {\n");
        buf_str(out, c"        if i < 0 || i >= self.cap || unsafe { self.states[i] } != SLOT_FULL {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some(unsafe { self.keys[i] })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn value_at(self: &HashMap<K, V, A>, i: i64) -> Option<V> {\n");
        buf_str(out, c"        if i < 0 || i >= self.cap || unsafe { self.states[i] } != SLOT_FULL {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some(unsafe { self.values[i] })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Twice the room (at least 8 slots), the entries moved over and the\n");
        buf_str(out, c"    // removed ones dropped.\n");
        buf_str(out, c"    fn rehash(self: &mut HashMap<K, V, A>) {\n");
        buf_str(out, c"        self.rehash_to(if self.cap == 0 { 8 } else { self.cap * 2 });\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The entries moved to `cap` slots (a power of two, more than 4/3 of\n");
        buf_str(out, c"    // len), the removed ones dropped.\n");
        buf_str(out, c"    fn rehash_to(self: &mut HashMap<K, V, A>, cap: i64) {\n");
        buf_str(out, c"        let old_cap = self.cap;\n");
        buf_str(out, c"        let old_keys = self.keys;\n");
        buf_str(out, c"        let old_values = self.values;\n");
        buf_str(out, c"        let old_states = self.states;\n");
        buf_str(out, c"        let key_bytes = alloc_bytes(cap, size_of(K));\n");
        buf_str(out, c"        let value_bytes = alloc_bytes(cap, size_of(V));\n");
        buf_str(out, c"        if key_bytes < 0 || value_bytes < 0 || cap > ALLOC_LIMIT {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.keys = self.alloc.try_alloc(key_bytes, align_of(K)) as *K;\n");
        buf_str(out, c"            self.values = self.alloc.try_alloc(value_bytes, align_of(V)) as *V;\n");
        buf_str(out, c"            self.states = self.alloc.try_alloc(cap, 1);\n");
        buf_str(out, c"            if self.keys == 0 as *K || self.values == 0 as *V || self.states == 0 as *u8 {\n");
        buf_str(out, c"                out_of_memory();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for i in 0..cap {\n");
        buf_str(out, c"                self.states[i] = SLOT_FREE;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.cap = cap;\n");
        buf_str(out, c"        self.used = self.len;\n");
        buf_str(out, c"        let mask = cap - 1;\n");
        buf_str(out, c"        for i in 0..old_cap {\n");
        buf_str(out, c"            if unsafe { old_states[i] } != SLOT_FULL {\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let key = unsafe { old_keys[i] };\n");
        buf_str(out, c"            let mut j = (key.hash() & mask as u64) as i64;\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                for _ in 0..cap {\n");
        buf_str(out, c"                    if self.states[j] != SLOT_FULL {\n");
        buf_str(out, c"                        break;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    j = (j + 1) & mask;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.states[j] = SLOT_FULL;\n");
        buf_str(out, c"                self.keys[j] = key;\n");
        buf_str(out, c"                self.values[j] = old_values[i];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if old_cap > 0 {\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                self.alloc.free(old_keys as *u8, old_cap * size_of(K), align_of(K));\n");
        buf_str(out, c"                self.alloc.free(old_values as *u8, old_cap * size_of(V), align_of(V));\n");
        buf_str(out, c"                self.alloc.free(old_states, old_cap, 1);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its entries dropped and its memory given back; it is left empty, to\n");
        buf_str(out, c"    // use again (0.17: a map is dropped at the end of its scope without\n");
        buf_str(out, c"    // it).\n");
        buf_str(out, c"    pub fn free(self: &mut HashMap<K, V, A>) {\n");
        buf_str(out, c"        self.release();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its entries, in a map on the same allocator; it is left empty (0.17:\n");
        buf_str(out, c"    // `std::take` for a container, which keeps its allocator).\n");
        buf_str(out, c"    pub fn take(self: &mut HashMap<K, V, A>) -> HashMap<K, V, A> {\n");
        buf_str(out, c"        let empty: HashMap<K, V, A> = HashMap::new_in(self.alloc);\n");
        buf_str(out, c"        replace(self, empty)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The entries dropped and the memory given back: empty, with no memory\n");
        buf_str(out, c"    // (0.17: drop and free).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn release(self: &mut HashMap<K, V, A>) {\n");
        buf_str(out, c"        if self.cap > 0 {\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                if needs_drop::<K>() || needs_drop::<V>() {\n");
        buf_str(out, c"                    for i in 0..self.cap {\n");
        buf_str(out, c"                        if self.states[i] == SLOT_FULL {\n");
        buf_str(out, c"                            drop(self.keys[i]);\n");
        buf_str(out, c"                            drop(self.values[i]);\n");
        buf_str(out, c"                        }\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.alloc.free(self.keys as *u8, self.cap * size_of(K), align_of(K));\n");
        buf_str(out, c"                self.alloc.free(self.values as *u8, self.cap * size_of(V), align_of(V));\n");
        buf_str(out, c"                self.alloc.free(self.states, self.cap, 1);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.cap = 0;\n");
        buf_str(out, c"        self.len = 0;\n");
        buf_str(out, c"        self.used = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.17) A map's drop: its entries' drops, then its memory given back.\n");
        buf_str(out, c"impl<K: Hash + Eq, V, A: Allocator> Drop for HashMap<K, V, A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn drop(self: &mut HashMap<K, V, A>) {\n");
        buf_str(out, c"        self.release();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Hash + Eq, V, A: Allocator + Ambient> HashMap<K, V, A> {\n");
        buf_str(out, c"    #[ambient(\"HashMap::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> HashMap<K, V, A> {\n");
        buf_str(out, c"        HashMap::new_in(A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- HashMap's room (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Hash + Eq, V, A: Allocator> HashMap<K, V, A> {\n");
        buf_str(out, c"    // Its allocator (0.16): a copy of the handle.\n");
        buf_str(out, c"    pub fn allocator(self: &HashMap<K, V, A>) -> A {\n");
        buf_str(out, c"        self.alloc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An empty map on allocator a with room for n entries (0.16).\n");
        buf_str(out, c"    pub fn with_capacity_in(n: i64, a: A) -> HashMap<K, V, A> {\n");
        buf_str(out, c"        let mut m: HashMap<K, V, A> = HashMap::new_in(a);\n");
        buf_str(out, c"        if n > 0 {\n");
        buf_str(out, c"            if n > ALLOC_LIMIT / 8 {\n");
        buf_str(out, c"                out_of_memory();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            // (slots: a power of two, 8 at least, n at most 3/4 of them)\n");
        buf_str(out, c"            let mut cap = 8;\n");
        buf_str(out, c"            for _ in 0..62 {\n");
        buf_str(out, c"                if n * 4 <= cap * 3 {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                cap *= 2;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            m.rehash_to(cap);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        m\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Contract checks: the implementation (0.18) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) A contract or assertion check, which the compiler makes (from a\n");
        buf_str(out, c"// `requires` or `ensures` clause, `assert`, `assert_eq`, ...): both back\n");
        buf_str(out, c"// ends branch to the run-time failure when `ok` is false, whose line the\n");
        buf_str(out, c"// compiler writes from `check` (front/contracts/checks.tach) and `site`\n");
        buf_str(out, c"// (the position it blames); a, b, c: the values of the holes of an\n");
        buf_str(out, c"// f-string message (`else f\"index {i}\"`), evaluated only when `ok` is\n");
        buf_str(out, c"// false. Not called by programs.\n");
        buf_str(out, c"pub fn contract_check(ok: bool, site: i64, check: i64, a: i64 = 0, b: i64 = 0, c: i64 = 0) {\n");
        buf_str(out, c"    if !ok {\n");
        buf_str(out, c"        unsafe { panic(c\"contract check failed\") }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Iterators (0.14) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach: the same module,\n");
        buf_str(out, c"// `std`. The Iterator trait (in the prelude), its sources and adapters;\n");
        buf_str(out, c"// `for x in it` iterates any type implementing it\n");
        buf_str(out, c"// (docs/design/closures-iterators.md).\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Every method is #[inline], so that a chain becomes one loop: the\n");
        buf_str(out, c"// consumers are written on `fold`, and the sources and adapters override\n");
        buf_str(out, c"// `fold` with a counted loop (internal iteration). `exact_len` and `at`\n");
        buf_str(out, c"// let zip and enumerate index both sides when they know their length.\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub trait Iterator {\n");
        buf_str(out, c"    type Item;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The next item, or None when there are no more.\n");
        buf_str(out, c"    fn next(self: &mut Self) -> Option<Self::Item>;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The number of items left, or -1 when it is not known.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: &Self) -> i64 {\n");
        buf_str(out, c"        -1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The k-th item left: only when exact_len() > k, with k increasing\n");
        buf_str(out, c"    // (0, 1, 2, ...) and no other use of the iterator in between.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: &Self, k: i64) -> Self::Item {\n");
        buf_str(out, c"        self.next().unwrap()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn map<B, F: FnMut(Self::Item) -> B>(self: Self, f: F) -> Map<Self, F> {\n");
        buf_str(out, c"        Map { it: self, f: f }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn filter<F: FnMut(Self::Item) -> bool>(self: Self, f: F) -> Filter<Self, F> {\n");
        buf_str(out, c"        Filter { it: self, f: f }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Items (i64, Self::Item): each with its index.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn enumerate(self: Self) -> Enumerate<Self> {\n");
        buf_str(out, c"        Enumerate { it: self, k: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Items (Self::Item, J::Item), as long as both have one.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn zip<J: Iterator>(self: Self, other: J) -> Zip<Self, J> {\n");
        buf_str(out, c"        Zip { a: self, b: other }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The first n items.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn take(self: Self, n: i64) -> Take<Self> {\n");
        buf_str(out, c"        Take { it: self, n: n }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // f(...f(f(init, x0), x1)..., xn): the loop every consumer is.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, Self::Item) -> B>(self: Self, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut it = self;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        while let Option::Some(x) = it.next() {\n");
        buf_str(out, c"            acc = g(acc, x);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn for_each<F: FnMut(Self::Item)>(self: Self, f: F) {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        self.fold((), |u: (), x| g(x));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn count(self: Self) -> i64 {\n");
        buf_str(out, c"        self.fold(0i64, |n, x| n + 1)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The sum of the items, from `0 as Self::Item`.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn sum(self: Self) -> Self::Item {\n");
        buf_str(out, c"        self.fold(0 as Self::Item, |s, x| s + x)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn min(self: Self) -> Option<Self::Item> {\n");
        buf_str(out, c"        let mut it = self;\n");
        buf_str(out, c"        match it.next() {\n");
        buf_str(out, c"            Option::Some(first) => Option::Some(it.fold(first, |m, x| if x < m { x } else { m })),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn max(self: Self) -> Option<Self::Item> {\n");
        buf_str(out, c"        let mut it = self;\n");
        buf_str(out, c"        match it.next() {\n");
        buf_str(out, c"            Option::Some(first) => Option::Some(it.fold(first, |m, x| if x > m { x } else { m })),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A new Vec of the items on allocator a (0.16; the caller frees it).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn collect_in<A: Allocator>(self: Self, a: A) -> Vec<Self::Item, A> {\n");
        buf_str(out, c"        let mut it = self;\n");
        buf_str(out, c"        let mut v: Vec<Self::Item, A> = Vec::new_in(a);\n");
        buf_str(out, c"        let n = it.exact_len();\n");
        buf_str(out, c"        if n > 0 {\n");
        buf_str(out, c"            v.reserve(n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        it.for_each(|x| v.push(x));\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // (0.16: an error outside std, front/ambient.tach)\n");
        buf_str(out, c"    #[ambient(\"collect_in(gpa)\")]\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn collect(self: Self) -> Vec<Self::Item> {\n");
        buf_str(out, c"        self.collect_in(Gpa::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Searches (0.15) ----\n");
        buf_str(out, c"    // They call `next` and stop at the first item that decides: the items\n");
        buf_str(out, c"    // after it are not reached.\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether f is true for some item.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn any<F: FnMut(Self::Item) -> bool>(self: Self, f: F) -> bool {\n");
        buf_str(out, c"        let mut it = self;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        while let Option::Some(x) = it.next() {\n");
        buf_str(out, c"            if g(x) {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether f is true for every item (true when there is none).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn all<F: FnMut(Self::Item) -> bool>(self: Self, f: F) -> bool {\n");
        buf_str(out, c"        let mut it = self;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        while let Option::Some(x) = it.next() {\n");
        buf_str(out, c"            if !g(x) {\n");
        buf_str(out, c"                return false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The index (counting from 0) of the first item f is true for.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn position<F: FnMut(Self::Item) -> bool>(self: Self, f: F) -> Option<i64> {\n");
        buf_str(out, c"        let mut it = self;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut k = 0;\n");
        buf_str(out, c"        while let Option::Some(x) = it.next() {\n");
        buf_str(out, c"            if g(x) {\n");
        buf_str(out, c"                return Option::Some(k);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            k += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::None\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The first item f is true for.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn find<F: FnMut(Self::Item) -> bool>(self: Self, f: F) -> Option<Self::Item> {\n");
        buf_str(out, c"        let mut it = self;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        while let Option::Some(x) = it.next() {\n");
        buf_str(out, c"            if g(x) {\n");
        buf_str(out, c"                return Option::Some(x);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::None\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Adapters ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Map<I, F> { it: I, f: F }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<I: Iterator, M> Iterator for Map<I, M> {\n");
        buf_str(out, c"    type Item = M::Output;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: &mut Map<I, M>) -> Option<M::Output> {\n");
        buf_str(out, c"        match self.it.next() {\n");
        buf_str(out, c"            Option::Some(x) => Option::Some((self.f)(x)),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: &Map<I, M>) -> i64 {\n");
        buf_str(out, c"        self.it.exact_len()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: &Map<I, M>, k: i64) -> M::Output {\n");
        buf_str(out, c"        (self.f)(self.it.at(k))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, M::Output) -> B>(self: Map<I, M>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut m = self.f;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        self.it.fold(init, |acc, x| g(acc, m(x)))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Filter<I, F> { it: I, f: F }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<I: Iterator, P> Iterator for Filter<I, P> {\n");
        buf_str(out, c"    type Item = I::Item;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: &mut Filter<I, P>) -> Option<I::Item> {\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            match self.it.next() {\n");
        buf_str(out, c"                Option::Some(x) => {\n");
        buf_str(out, c"                    if (self.f)(x) {\n");
        buf_str(out, c"                        return Option::Some(x);\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                Option::None => return Option::None,\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, I::Item) -> B>(self: Filter<I, P>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut p = self.f;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        self.it.fold(init, |acc, x| if p(x) { g(acc, x) } else { acc })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Enumerate<I> { it: I, k: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<I: Iterator> Iterator for Enumerate<I> {\n");
        buf_str(out, c"    type Item = (i64, I::Item);\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: &mut Enumerate<I>) -> Option<(i64, I::Item)> {\n");
        buf_str(out, c"        match self.it.next() {\n");
        buf_str(out, c"            Option::Some(x) => {\n");
        buf_str(out, c"                let k = self.k;\n");
        buf_str(out, c"                self.k = k + 1;\n");
        buf_str(out, c"                Option::Some((k, x))\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: &Enumerate<I>) -> i64 {\n");
        buf_str(out, c"        self.it.exact_len()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: &Enumerate<I>, k: i64) -> (i64, I::Item) {\n");
        buf_str(out, c"        (self.k + k, self.it.at(k))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, (i64, I::Item)) -> B>(self: Enumerate<I>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut e = self;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        let n = e.it.exact_len();\n");
        buf_str(out, c"        if n >= 0 {\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                acc = g(acc, (e.k + k, e.it.at(k)));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            while let Option::Some(p) = e.next() {\n");
        buf_str(out, c"                acc = g(acc, p);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Zip<I, J> { a: I, b: J }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Iterator, J: Iterator> Iterator for Zip<A, J> {\n");
        buf_str(out, c"    type Item = (A::Item, J::Item);\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: &mut Zip<A, J>) -> Option<(A::Item, J::Item)> {\n");
        buf_str(out, c"        match self.a.next() {\n");
        buf_str(out, c"            Option::Some(x) => match self.b.next() {\n");
        buf_str(out, c"                Option::Some(y) => Option::Some((x, y)),\n");
        buf_str(out, c"                Option::None => Option::None,\n");
        buf_str(out, c"            },\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: &Zip<A, J>) -> i64 {\n");
        buf_str(out, c"        let n = self.a.exact_len();\n");
        buf_str(out, c"        let m = self.b.exact_len();\n");
        buf_str(out, c"        if n < 0 || m < 0 {\n");
        buf_str(out, c"            -1\n");
        buf_str(out, c"        } else if n < m {\n");
        buf_str(out, c"            n\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            m\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: &Zip<A, J>, k: i64) -> (A::Item, J::Item) {\n");
        buf_str(out, c"        (self.a.at(k), self.b.at(k))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, (A::Item, J::Item)) -> B>(self: Zip<A, J>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut z = self;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        let n = z.exact_len();\n");
        buf_str(out, c"        if n >= 0 {\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                acc = g(acc, (z.a.at(k), z.b.at(k)));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            while let Option::Some(p) = z.next() {\n");
        buf_str(out, c"                acc = g(acc, p);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Take<I> { it: I, n: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<I: Iterator> Iterator for Take<I> {\n");
        buf_str(out, c"    type Item = I::Item;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: &mut Take<I>) -> Option<I::Item> {\n");
        buf_str(out, c"        if self.n <= 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.n -= 1;\n");
        buf_str(out, c"        self.it.next()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: &Take<I>) -> i64 {\n");
        buf_str(out, c"        let m = self.it.exact_len();\n");
        buf_str(out, c"        if m < 0 {\n");
        buf_str(out, c"            -1\n");
        buf_str(out, c"        } else if self.n <= 0 {\n");
        buf_str(out, c"            0\n");
        buf_str(out, c"        } else if m < self.n {\n");
        buf_str(out, c"            m\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.n\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: &Take<I>, k: i64) -> I::Item {\n");
        buf_str(out, c"        self.it.at(k)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, I::Item) -> B>(self: Take<I>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut t = self;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        let n = t.exact_len();\n");
        buf_str(out, c"        if n >= 0 {\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                acc = g(acc, t.it.at(k));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            while t.n > 0 {\n");
        buf_str(out, c"                match t.it.next() {\n");
        buf_str(out, c"                    Option::Some(x) => {\n");
        buf_str(out, c"                        t.n -= 1;\n");
        buf_str(out, c"                        acc = g(acc, x);\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    Option::None => break,\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Sources ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// `for` over a SliceIter, a Range or a RangeInclusive is a counted loop\n");
        buf_str(out, c"// (front/check/iterate.tach); their `fold` is one too.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `a..b` as a value: start, start + 1, ..., up to end, end excluded.\n");
        buf_str(out, c"pub struct Range<T> { pub start: T, pub end: T }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Iterator for Range<T> {\n");
        buf_str(out, c"    type Item = T;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: &mut Range<T>) -> Option<T> {\n");
        buf_str(out, c"        if self.start < self.end {\n");
        buf_str(out, c"            let x = self.start;\n");
        buf_str(out, c"            self.start = x + 1;\n");
        buf_str(out, c"            Option::Some(x)\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            Option::None\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: &Range<T>) -> i64 {\n");
        buf_str(out, c"        if self.start < self.end { (self.end - self.start) as i64 } else { 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: &Range<T>, k: i64) -> T {\n");
        buf_str(out, c"        self.start + k as T\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, T) -> B>(self: Range<T>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        for x in self.start..self.end {\n");
        buf_str(out, c"            acc = g(acc, x);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `a..=b` as a value: end included; `done` once `next` gave end.\n");
        buf_str(out, c"pub struct RangeInclusive<T> { pub start: T, pub end: T, pub done: bool }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Iterator for RangeInclusive<T> {\n");
        buf_str(out, c"    type Item = T;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: &mut RangeInclusive<T>) -> Option<T> {\n");
        buf_str(out, c"        if self.done || self.start > self.end {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let x = self.start;\n");
        buf_str(out, c"        if x == self.end {\n");
        buf_str(out, c"            self.done = true;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.start = x + 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some(x)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: &RangeInclusive<T>) -> i64 {\n");
        buf_str(out, c"        if self.done || self.start > self.end { 0 } else { (self.end - self.start) as i64 + 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: &RangeInclusive<T>, k: i64) -> T {\n");
        buf_str(out, c"        self.start + k as T\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, T) -> B>(self: RangeInclusive<T>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        if !self.done {\n");
        buf_str(out, c"            for x in self.start..=self.end {\n");
        buf_str(out, c"                acc = g(acc, x);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The items of a slice, by value: `v.iter()`, `s.iter()`.\n");
        buf_str(out, c"pub struct SliceIter<T> { s: [T], pos: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Iterator for SliceIter<T> {\n");
        buf_str(out, c"    type Item = T;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: &mut SliceIter<T>) -> Option<T> {\n");
        buf_str(out, c"        if self.pos < self.s.len {\n");
        buf_str(out, c"            let x = self.s[self.pos];\n");
        buf_str(out, c"            self.pos += 1;\n");
        buf_str(out, c"            Option::Some(x)\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            Option::None\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: &SliceIter<T>) -> i64 {\n");
        buf_str(out, c"        self.s.len - self.pos\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: &SliceIter<T>, k: i64) -> T {\n");
        buf_str(out, c"        self.s[self.pos + k]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, T) -> B>(self: SliceIter<T>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        let s = self.s;\n");
        buf_str(out, c"        for k in self.pos..s.len {\n");
        buf_str(out, c"            acc = g(acc, s[k]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> SliceIter<T> {\n");
        buf_str(out, c"    // The items left, as a slice.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(*self)]\n");
        buf_str(out, c"    pub fn as_slice(self: &SliceIter<T>) -> [T] {\n");
        buf_str(out, c"        self.s[self.pos..self.s.len]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T>[T] {\n");
        buf_str(out, c"    // Its items, by value.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn iter(self: [T]) -> SliceIter<T> {\n");
        buf_str(out, c"        SliceIter { s: self, pos: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its items, by reference (0.17): `for x in s.iter_ref()`, x a `&T`,\n");
        buf_str(out, c"    // the elements neither copied nor moved.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn iter_ref(self: [T]) -> SliceRefIter<T> {\n");
        buf_str(out, c"        SliceRefIter { s: self, pos: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Sorts it in place by f (see sort_by).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn sort_by<F: FnMut(&T, &T) -> i64>(self: &mut [T], f: F) {\n");
        buf_str(out, c"        sort_by(self, f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Exchanges elements i and j (checked; 0.17).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn swap(self: &mut [T], i: i64, j: i64) {\n");
        buf_str(out, c"        swap_at::<T>(self, i, j);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // Its items, by value (a view: valid until the vector grows or is\n");
        buf_str(out, c"    // freed).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn iter(self: &Vec<T, A>) -> SliceIter<T> {\n");
        buf_str(out, c"        SliceIter { s: self.as_slice(), pos: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its items, by reference (0.17): `for x in v.iter_ref()`, x a `&T`.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn iter_ref(self: &Vec<T, A>) -> SliceRefIter<T> {\n");
        buf_str(out, c"        SliceRefIter { s: self.as_slice(), pos: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Sorts it in place by f (see sort_by).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn sort_by<F: FnMut(&T, &T) -> i64>(self: &mut Vec<T, A>, f: F) {\n");
        buf_str(out, c"        sort_by(self.as_mut_slice(), f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The items of a slice, by reference (0.17): `v.iter_ref()`,\n");
        buf_str(out, c"// `s.iter_ref()`; a view of the slice.\n");
        buf_str(out, c"pub struct SliceRefIter<T> { s: [T], pos: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Iterator for SliceRefIter<T> {\n");
        buf_str(out, c"    type Item = &T;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: &mut SliceRefIter<T>) -> Option<&T> {\n");
        buf_str(out, c"        if self.pos < self.s.len {\n");
        buf_str(out, c"            let x = &self.s[self.pos];\n");
        buf_str(out, c"            self.pos += 1;\n");
        buf_str(out, c"            Option::Some(x)\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            Option::None\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: &SliceRefIter<T>) -> i64 {\n");
        buf_str(out, c"        self.s.len - self.pos\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: &SliceRefIter<T>, k: i64) -> &T {\n");
        buf_str(out, c"        &self.s[self.pos + k]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `m.iter()`: (key, value) in slot order, until the map changes. (0.17) A\n");
        buf_str(out, c"// view of the map: `states` is its slots' states.\n");
        buf_str(out, c"pub struct HashMapIter<K, V> { keys: *K, values: *V, states: [u8], pos: i64, left: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K, V> Iterator for HashMapIter<K, V> {\n");
        buf_str(out, c"    type Item = (K, V);\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: &mut HashMapIter<K, V>) -> Option<(K, V)> {\n");
        buf_str(out, c"        for i in self.pos..self.states.len {\n");
        buf_str(out, c"            self.pos = i + 1;\n");
        buf_str(out, c"            if unsafe { self.states.ptr[i] } == SLOT_FULL {\n");
        buf_str(out, c"                self.left -= 1;\n");
        buf_str(out, c"                return Option::Some((unsafe { self.keys[i] }, unsafe { self.values[i] }));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::None\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: &HashMapIter<K, V>) -> i64 {\n");
        buf_str(out, c"        self.left\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, (K, V)) -> B>(self: HashMapIter<K, V>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        for i in self.pos..self.states.len {\n");
        buf_str(out, c"            if unsafe { self.states.ptr[i] } == SLOT_FULL {\n");
        buf_str(out, c"                acc = g(acc, (unsafe { self.keys[i] }, unsafe { self.values[i] }));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Keys<K, V> { it: HashMapIter<K, V> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K, V> Iterator for Keys<K, V> {\n");
        buf_str(out, c"    type Item = K;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: &mut Keys<K, V>) -> Option<K> {\n");
        buf_str(out, c"        match self.it.next() {\n");
        buf_str(out, c"            Option::Some(e) => Option::Some(e.0),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: &Keys<K, V>) -> i64 {\n");
        buf_str(out, c"        self.it.left\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, K) -> B>(self: Keys<K, V>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        self.it.fold(init, |acc, e| g(acc, e.0))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Values<K, V> { it: HashMapIter<K, V> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K, V> Iterator for Values<K, V> {\n");
        buf_str(out, c"    type Item = V;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: &mut Values<K, V>) -> Option<V> {\n");
        buf_str(out, c"        match self.it.next() {\n");
        buf_str(out, c"            Option::Some(e) => Option::Some(e.1),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: &Values<K, V>) -> i64 {\n");
        buf_str(out, c"        self.it.left\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, V) -> B>(self: Values<K, V>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        self.it.fold(init, |acc, e| g(acc, e.1))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Hash + Eq, V, A: Allocator> HashMap<K, V, A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn iter(self: &HashMap<K, V, A>) -> HashMapIter<K, V> {\n");
        buf_str(out, c"        HashMapIter {\n");
        buf_str(out, c"            keys: self.keys, values: self.values, states: unsafe { self.states[0..self.cap] },\n");
        buf_str(out, c"            pos: 0, left: self.len,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn keys(self: &HashMap<K, V, A>) -> Keys<K, V> {\n");
        buf_str(out, c"        Keys { it: self.iter() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn values(self: &HashMap<K, V, A>) -> Values<K, V> {\n");
        buf_str(out, c"        Values { it: self.iter() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place by f: f(a, b) is negative, zero or positive as *a goes\n");
        buf_str(out, c"// before, with or after *b (`|a, b| a.cmp(b)`: smallest first). A\n");
        buf_str(out, c"// heapsort: not stable. (0.17) f takes references; the elements move as\n");
        buf_str(out, c"// bits, so any T sorts, owned ones too.\n");
        buf_str(out, c"pub fn sort_by<T, F: FnMut(&T, &T) -> i64>(s: &mut [T], f: F) {\n");
        buf_str(out, c"    let mut g = f;\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    let p = s.ptr;\n");
        buf_str(out, c"    let mut start = n / 2;\n");
        buf_str(out, c"    let mut end = n;\n");
        buf_str(out, c"    // (each round takes one from start or end: n / 2 + n at most; 0.16:\n");
        buf_str(out, c"    // counted loops, no effect diverge; every index is below end <= n)\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        for _ in 0..n / 2 + n + 1 {\n");
        buf_str(out, c"            // Build the heap from n/2 down, then move its top behind it.\n");
        buf_str(out, c"            if start > 0 {\n");
        buf_str(out, c"                start -= 1;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                end -= 1;\n");
        buf_str(out, c"                if end <= 0 {\n");
        buf_str(out, c"                    return;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                swap_raw::<T>(p, 0, end);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let mut root = start;\n");
        buf_str(out, c"            for _ in 0..64 {\n");
        buf_str(out, c"                let mut child = 2 * root + 1;\n");
        buf_str(out, c"                if child >= end {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if child + 1 < end && g(&*(&p[child]), &*(&p[child + 1])) < 0 {\n");
        buf_str(out, c"                    child += 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if g(&*(&p[root]), &*(&p[child])) >= 0 {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                swap_raw::<T>(p, root, child);\n");
        buf_str(out, c"                root = child;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Slices (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T>[T] {\n");
        buf_str(out, c"    // Element i, or None when i is out of bounds (0.16: `s[i]` stops the\n");
        buf_str(out, c"    // program then, this does not).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn get(self: [T], i: i64) -> Option<T> {\n");
        buf_str(out, c"        if (i as u64) >= (self.len as u64) {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some(unsafe { self.ptr[i] })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Reading stdin and text (0.14) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach (0.15: split from\n");
        buf_str(out, c"// it): the same module, `std`. Reading stdin by lines or whole, trimming,\n");
        buf_str(out, c"// splitting and parsing text, and a Scanner of tokens and numbers.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// (0.15) The convention: an Option means absence (the end of the input,\n");
        buf_str(out, c"// nothing found), a Result with an error enum a failure: `read_line` and\n");
        buf_str(out, c"// `read_stdin` fail with an IoError, `parse_int` with a ParseIntError,\n");
        buf_str(out, c"// `Scanner::next_int` with a ScanError.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Reading stdin (0.14) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `read_line` and `read_stdin` share one buffer: they can be mixed, but\n");
        buf_str(out, c"// not with C's stdio reading (getchar, scanf, fgets), which has its own.\n");
        buf_str(out, c"static mut STDIN_BUF: *u8 = 0 as *u8;\n");
        buf_str(out, c"static mut STDIN_POS: i64 = 0;\n");
        buf_str(out, c"static mut STDIN_LEN: i64 = 0;\n");
        buf_str(out, c"const STDIN_BLOCK: i64 = 65536;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Bytes in STDIN_BUF[STDIN_POS..STDIN_LEN], read if there were none: 1;\n");
        buf_str(out, c"// 0 at the end of input, -1 when reading failed.\n");
        buf_str(out, c"fn stdin_fill() -> i64 {\n");
        buf_str(out, c"    if STDIN_POS < STDIN_LEN {\n");
        buf_str(out, c"        return 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if STDIN_BUF == 0 as *u8 {\n");
        buf_str(out, c"        STDIN_BUF = unsafe { malloc(STDIN_BLOCK as u64) };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let n = unsafe { read(0, STDIN_BUF, STDIN_BLOCK as u64) };\n");
        buf_str(out, c"    STDIN_POS = 0;\n");
        buf_str(out, c"    STDIN_LEN = if n > 0 { n } else { 0 };\n");
        buf_str(out, c"    if n > 0 { 1 } else if n == 0 { 0 } else { -1 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The next line of stdin into `line` (emptied first; 0.16: a Buf on any\n");
        buf_str(out, c"// allocator, which it grows), without its '\\n'; Ok(false) at the end of\n");
        buf_str(out, c"// input.\n");
        buf_str(out, c"pub fn read_line<A: Allocator>(line: &mut Buf<A>) -> Result<bool, IoError> {\n");
        buf_str(out, c"    line.clear();\n");
        buf_str(out, c"    let mut any = false;\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        let filled = stdin_fill();\n");
        buf_str(out, c"        if filled < 0 {\n");
        buf_str(out, c"            return Result::Err(IoError::Read);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if filled == 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        any = true;\n");
        buf_str(out, c"        let block = unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] };\n");
        buf_str(out, c"        for i in 0..block.len {\n");
        buf_str(out, c"            if block[i] == '\\n' {\n");
        buf_str(out, c"                line.push_str(block[..i]);\n");
        buf_str(out, c"                STDIN_POS += i + 1;\n");
        buf_str(out, c"                return Result::Ok(true);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        line.push_str(block);\n");
        buf_str(out, c"        STDIN_POS = STDIN_LEN;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    Result::Ok(any)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// All of stdin that is left, in a new Buf on allocator a (the caller\n");
        buf_str(out, c"// frees it). It shares a buffer with read_line, not with C's getchar or\n");
        buf_str(out, c"// scanf.\n");
        buf_str(out, c"pub fn read_stdin_in<A: Allocator>(a: A) -> Result<Buf<A>, IoError> {\n");
        buf_str(out, c"    let mut b: Buf<A> = Buf::new_in(a);\n");
        buf_str(out, c"    if STDIN_POS < STDIN_LEN {\n");
        buf_str(out, c"        b.push_str(unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] });\n");
        buf_str(out, c"        STDIN_POS = STDIN_LEN;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        b.bytes.reserve(STDIN_BLOCK);\n");
        buf_str(out, c"        let room = b.bytes.cap - b.bytes.len;\n");
        buf_str(out, c"        let n = unsafe { read(0, &b.bytes.ptr[b.bytes.len], room as u64) };\n");
        buf_str(out, c"        if n == 0 {\n");
        buf_str(out, c"            return Result::Ok(b);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if n < 0 {\n");
        buf_str(out, c"            b.free();\n");
        buf_str(out, c"            return Result::Err(IoError::Read);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b.bytes.len += n;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Text (0.14) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ASCII whitespace: ' ', '\\t', '\\n', '\\r', vertical tab, form feed.\n");
        buf_str(out, c"pub fn is_space(b: u8) -> bool {\n");
        buf_str(out, c"    b == ' ' || b == '\\t' || b == '\\n' || b == '\\r' || b == 11 || b == 12\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// '0' to '9'.\n");
        buf_str(out, c"pub fn is_digit(b: u8) -> bool {\n");
        buf_str(out, c"    b >= '0' && b <= '9'\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// s without the whitespace (`is_space`) at its start and end.\n");
        buf_str(out, c"#[views(s)]\n");
        buf_str(out, c"pub fn trim(s: [u8]) -> [u8] {\n");
        buf_str(out, c"    let mut a = 0;\n");
        buf_str(out, c"    let mut b = s.len;\n");
        buf_str(out, c"    for _ in 0..s.len {\n");
        buf_str(out, c"        if !(a < b && is_space(s[a])) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        a += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for _ in 0..s.len {\n");
        buf_str(out, c"        if !(b > a && is_space(s[b - 1])) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    s[a..b]\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// s as an integer: an optional '-' or '+', then decimal digits, nothing\n");
        buf_str(out, c"// else (no spaces); Err if s is not one or does not fit in an i64.\n");
        buf_str(out, c"pub fn parse_int(s: [u8]) -> Result<i64, ParseIntError> {\n");
        buf_str(out, c"    let mut i = 0;\n");
        buf_str(out, c"    if s.len > 0 && (s[0] == '-' || s[0] == '+') {\n");
        buf_str(out, c"        i = 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if i == s.len {\n");
        buf_str(out, c"        return Result::Err(ParseIntError::Empty);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // Summed as a negative number, which reaches the smallest i64.\n");
        buf_str(out, c"    let min = -9223372036854775807 - 1;\n");
        buf_str(out, c"    let mut n = 0;\n");
        buf_str(out, c"    for _ in i..s.len {\n");
        buf_str(out, c"        if !is_digit(s[i]) {\n");
        buf_str(out, c"            return Result::Err(ParseIntError::InvalidDigit(i));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let d = (s[i] - '0') as i64;\n");
        buf_str(out, c"        if n < min / 10 || (n == min / 10 && d > -(min % 10)) {\n");
        buf_str(out, c"            // (a later byte that is not a digit is still that error)\n");
        buf_str(out, c"            for k in i..s.len {\n");
        buf_str(out, c"                if !is_digit(s[k]) {\n");
        buf_str(out, c"                    return Result::Err(ParseIntError::InvalidDigit(k));\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return Result::Err(ParseIntError::Overflow);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        n = n * 10 - d;\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if s[0] == '-' {\n");
        buf_str(out, c"        Result::Ok(n)\n");
        buf_str(out, c"    } else if n == min {\n");
        buf_str(out, c"        Result::Err(ParseIntError::Overflow)\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        Result::Ok(-n)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"read_stdin_in(gpa)\")]\n");
        buf_str(out, c"pub fn read_stdin() -> Result<Buf, IoError> {\n");
        buf_str(out, c"    read_stdin_in(Gpa::ambient())\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The parts of s between `sep` bytes, empty ones too, as views of s\n");
        buf_str(out, c"// (`split_in(\"a,,b\", ',', gpa)`: \"a\", \"\", \"b\"), in a Vec on allocator a.\n");
        buf_str(out, c"// The caller frees the Vec. (0.17: the Vec views s.)\n");
        buf_str(out, c"#[views(s)]\n");
        buf_str(out, c"pub fn split_in<A: Allocator>(s: [u8], sep: u8, a: A) -> Vec<[u8], A> {\n");
        buf_str(out, c"    let mut parts: Vec<[u8], A> = Vec::new_in(a);\n");
        buf_str(out, c"    let mut start = 0;\n");
        buf_str(out, c"    for i in 0..s.len {\n");
        buf_str(out, c"        if s[i] == sep {\n");
        buf_str(out, c"            parts.push(s[start..i]);\n");
        buf_str(out, c"            start = i + 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    parts.push(s[start..]);\n");
        buf_str(out, c"    parts\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"split_in(s, sep, gpa)\")]\n");
        buf_str(out, c"#[views(s)]\n");
        buf_str(out, c"pub fn split(s: [u8], sep: u8) -> Vec<[u8]> {\n");
        buf_str(out, c"    split_in(s, sep, Gpa::ambient())\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"split_whitespace_in(s, gpa)\")]\n");
        buf_str(out, c"#[views(s)]\n");
        buf_str(out, c"pub fn split_whitespace(s: [u8]) -> Vec<[u8]> {\n");
        buf_str(out, c"    split_whitespace_in(s, Gpa::ambient())\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The runs of non-whitespace in s, as views of s, in a Vec on allocator a.\n");
        buf_str(out, c"// The caller frees it. (0.17: the Vec views s.)\n");
        buf_str(out, c"#[views(s)]\n");
        buf_str(out, c"pub fn split_whitespace_in<A: Allocator>(s: [u8], a: A) -> Vec<[u8], A> {\n");
        buf_str(out, c"    let mut words: Vec<[u8], A> = Vec::new_in(a);\n");
        buf_str(out, c"    let mut sc = Scanner::new(s);\n");
        buf_str(out, c"    while let Option::Some(w) = sc.next_token() {\n");
        buf_str(out, c"        words.push(w);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    words\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Reads a text (`read_stdin().as_slice()`) front to back, by tokens\n");
        buf_str(out, c"// (runs of non-whitespace) and lines, as views of the text. (0.17) A view\n");
        buf_str(out, c"// of the text: the tokens it gives view the text, not the Scanner, so\n");
        buf_str(out, c"// several can be kept while it reads on.\n");
        buf_str(out, c"pub struct Scanner { text: [u8], pos: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Scanner {\n");
        buf_str(out, c"    #[views(text)]\n");
        buf_str(out, c"    pub fn new(text: [u8]) -> Scanner {\n");
        buf_str(out, c"        Scanner { text: text, pos: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The next token; None when only whitespace is left.\n");
        buf_str(out, c"    #[views(*self)]\n");
        buf_str(out, c"    pub fn next_token(self: &mut Scanner) -> Option<[u8]> {\n");
        buf_str(out, c"        let s = self.text;\n");
        buf_str(out, c"        let mut i = self.pos;\n");
        buf_str(out, c"        for _ in i..s.len {\n");
        buf_str(out, c"            if !is_space(s[i]) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if i >= s.len {\n");
        buf_str(out, c"            self.pos = i;\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let start = i;\n");
        buf_str(out, c"        for _ in i..s.len {\n");
        buf_str(out, c"            if is_space(s[i]) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.pos = i;\n");
        buf_str(out, c"        Option::Some(s[start..i])\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The next token as an integer (`parse_int`); Err at the end, or if\n");
        buf_str(out, c"    // it is not one (it is consumed all the same).\n");
        buf_str(out, c"    pub fn next_int(self: &mut Scanner) -> Result<i64, ScanError> {\n");
        buf_str(out, c"        match self.next_token() {\n");
        buf_str(out, c"            Option::Some(t) => match parse_int(t) {\n");
        buf_str(out, c"                Result::Ok(n) => Result::Ok(n),\n");
        buf_str(out, c"                Result::Err(e) => Result::Err(ScanError::Parse(e)),\n");
        buf_str(out, c"            },\n");
        buf_str(out, c"            Option::None => Result::Err(ScanError::End),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The rest of the line, without its '\\n'; None at the end of the\n");
        buf_str(out, c"    // text (\"a\\n\\nb\": \"a\", \"\", \"b\"; \"a\\n\": \"a\").\n");
        buf_str(out, c"    #[views(*self)]\n");
        buf_str(out, c"    pub fn next_line(self: &mut Scanner) -> Option<[u8]> {\n");
        buf_str(out, c"        let s = self.text;\n");
        buf_str(out, c"        if self.pos >= s.len {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let start = self.pos;\n");
        buf_str(out, c"        let mut i = start;\n");
        buf_str(out, c"        for _ in i..s.len {\n");
        buf_str(out, c"            if s[i] == '\\n' {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.pos = if i < s.len { i + 1 } else { i };\n");
        buf_str(out, c"        Option::Some(s[start..i])\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether nothing but whitespace is left.\n");
        buf_str(out, c"    pub fn is_done(self: &Scanner) -> bool {\n");
        buf_str(out, c"        let s = self.text;\n");
        buf_str(out, c"        let mut i = self.pos;\n");
        buf_str(out, c"        for _ in i..s.len {\n");
        buf_str(out, c"            if !is_space(s[i]) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i >= s.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // What is left of the text.\n");
        buf_str(out, c"    #[views(*self)]\n");
        buf_str(out, c"    pub fn rest(self: &Scanner) -> [u8] {\n");
        buf_str(out, c"        self.text[self.pos..]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Errors of reading and parsing (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Reading stdin failed (read_line, read_stdin).\n");
        buf_str(out, c"pub enum IoError { Read, Write }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Why parse_int failed: no digits; the byte at this index is not a digit;\n");
        buf_str(out, c"// the number does not fit in an i64.\n");
        buf_str(out, c"pub enum ParseIntError { Empty, InvalidDigit(i64), Overflow }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Why Scanner::next_int failed: no token left; the token is not a number.\n");
        buf_str(out, c"pub enum ScanError { End, Parse(ParseIntError) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for IoError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &IoError, f: &mut Fmt) {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            IoError::Read => f.str(\"cannot read the input\"),\n");
        buf_str(out, c"            IoError::Write => f.str(\"cannot write the output\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for IoError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: &IoError, f: &mut Fmt) {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            IoError::Read => f.str(\"Read\"),\n");
        buf_str(out, c"            IoError::Write => f.str(\"Write\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for ParseIntError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &ParseIntError, f: &mut Fmt) {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            ParseIntError::Empty => f.str(\"cannot parse an integer from an empty text\"),\n");
        buf_str(out, c"            ParseIntError::InvalidDigit(i) => {\n");
        buf_str(out, c"                f.str(\"invalid digit at byte \");\n");
        buf_str(out, c"                f.display(&i);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            ParseIntError::Overflow => f.str(\"the number does not fit in an i64\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for ParseIntError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: &ParseIntError, f: &mut Fmt) {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            ParseIntError::Empty => f.str(\"Empty\"),\n");
        buf_str(out, c"            ParseIntError::InvalidDigit(i) => {\n");
        buf_str(out, c"                f.str(\"InvalidDigit(\");\n");
        buf_str(out, c"                f.debug(&i);\n");
        buf_str(out, c"                f.str(\")\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            ParseIntError::Overflow => f.str(\"Overflow\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for ScanError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &ScanError, f: &mut Fmt) {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            ScanError::End => f.str(\"no number left: the end of the input\"),\n");
        buf_str(out, c"            ScanError::Parse(e) => f.display(&e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for ScanError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: &ScanError, f: &mut Fmt) {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            ScanError::End => f.str(\"End\"),\n");
        buf_str(out, c"            ScanError::Parse(e) => {\n");
        buf_str(out, c"                f.str(\"Parse(\");\n");
        buf_str(out, c"                f.debug(&e);\n");
        buf_str(out, c"                f.str(\")\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Integer limits (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The smallest and largest values of the integer types: the same as the\n");
        buf_str(out, c"// builtin `i32::MAX`, `u8::MIN`, ... (aliases, from before those).\n");
        buf_str(out, c"pub const I8_MIN: i8 = i8::MIN;\n");
        buf_str(out, c"pub const I8_MAX: i8 = i8::MAX;\n");
        buf_str(out, c"pub const I16_MIN: i16 = i16::MIN;\n");
        buf_str(out, c"pub const I16_MAX: i16 = i16::MAX;\n");
        buf_str(out, c"pub const I32_MIN: i32 = i32::MIN;\n");
        buf_str(out, c"pub const I32_MAX: i32 = i32::MAX;\n");
        buf_str(out, c"pub const I64_MIN: i64 = i64::MIN;\n");
        buf_str(out, c"pub const I64_MAX: i64 = i64::MAX;\n");
        buf_str(out, c"pub const U8_MAX: u8 = u8::MAX;\n");
        buf_str(out, c"pub const U16_MAX: u16 = u16::MAX;\n");
        buf_str(out, c"pub const U32_MAX: u32 = u32::MAX;\n");
        buf_str(out, c"pub const U64_MAX: u64 = u64::MAX;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Bits (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The number of 1 bits of x (a narrower unsigned value widens: `count_ones(m)`\n");
        buf_str(out, c"// of a u32 m). On AArch64 these three are instructions (cnt, clz, rbit\n");
        buf_str(out, c"// and clz); elsewhere these bodies, a few operations each.\n");
        buf_str(out, c"pub fn count_ones(x: u64) -> i64 {\n");
        buf_str(out, c"    let a = x - ((x >> 1) & 0x5555555555555555);\n");
        buf_str(out, c"    let b = (a & 0x3333333333333333) + ((a >> 2) & 0x3333333333333333);\n");
        buf_str(out, c"    let c = (b + (b >> 4)) & 0x0f0f0f0f0f0f0f0f;\n");
        buf_str(out, c"    ((c * 0x0101010101010101) >> 56) as i64\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The number of 0 bits above the highest 1 bit of x: 64 for 0, 0 when the\n");
        buf_str(out, c"// top bit is set.\n");
        buf_str(out, c"pub fn leading_zeros(x: u64) -> i64 {\n");
        buf_str(out, c"    // (the highest bit smeared down, then the ones it leaves counted)\n");
        buf_str(out, c"    let mut y = x | (x >> 1);\n");
        buf_str(out, c"    y = y | (y >> 2);\n");
        buf_str(out, c"    y = y | (y >> 4);\n");
        buf_str(out, c"    y = y | (y >> 8);\n");
        buf_str(out, c"    y = y | (y >> 16);\n");
        buf_str(out, c"    y = y | (y >> 32);\n");
        buf_str(out, c"    64 - count_ones(y)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The number of 0 bits below the lowest 1 bit of x: 64 for 0. For x != 0,\n");
        buf_str(out, c"// 1 << trailing_zeros(x) is x & -x, its lowest set bit.\n");
        buf_str(out, c"pub fn trailing_zeros(x: u64) -> i64 {\n");
        buf_str(out, c"    count_ones(~x & (x - 1))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Printing and formatting ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach (its printing was\n");
        buf_str(out, c"// split from it): the same module, `std`. Printing; the traits Display\n");
        buf_str(out, c"// (`{x}`, print) and Debug (`{x:?}`), the formatter Fmt they write to, and\n");
        buf_str(out, c"// Interp, the value of an f-string (docs/design/errors-formatting.md).\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Output to stdout and stderr goes through one static buffer of 4 KB\n");
        buf_str(out, c"// (not the heap), written out at the end of each print call: one `write`\n");
        buf_str(out, c"// per print, whatever its argument is made of. A Fmt to a file descriptor\n");
        buf_str(out, c"// only fills that buffer: `flush` writes it out.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// (0.16) Formatting allocates nothing: a Fmt to a Buf writes into the\n");
        buf_str(out, c"// room the Buf has, and counts what does not fit; then `push_fmt` grows\n");
        buf_str(out, c"// the Buf to the count and runs the Display again (twice only when the\n");
        buf_str(out, c"// text did not fit). So print's effects have no `alloc`.\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn snprintf(buf: *u8, n: u64, format: *u8, ...) -> i32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn strtod(s: *u8, end: **u8) -> f64;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn strtof(s: *u8, end: **u8) -> f32;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Printing ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// x's Display (`print(\"text\")`, `print(f\"{a} {b:?}\")`): one `write`.\n");
        buf_str(out, c"pub fn print<T: Display>(x: T) {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(1);\n");
        buf_str(out, c"    x.fmt(&mut f);\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn println<T: Display>(x: T) {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(1);\n");
        buf_str(out, c"    x.fmt(&mut f);\n");
        buf_str(out, c"    f.byte('\\n');\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"pub fn print_int(v: i64) {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(1);\n");
        buf_str(out, c"    // (decimal only: not Fmt::int, whose hex and binary every program\n");
        buf_str(out, c"    // using print_int would compile)\n");
        buf_str(out, c"    let negative = v < 0;\n");
        buf_str(out, c"    fmt_decimal(&mut f, if negative { (-(v + 1)) as u64 + 1 } else { v as u64 }, negative);\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A C string (up to its NUL).\n");
        buf_str(out, c"pub unsafe fn print_cstr(s: *u8) {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(1);\n");
        buf_str(out, c"    f.str(s[0..strlen(s) as i64]);\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Display, Debug and Fmt (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// x's Display on stderr.\n");
        buf_str(out, c"pub fn eprint<T: Display>(x: T) {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(2);\n");
        buf_str(out, c"    x.fmt(&mut f);\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn eprintln<T: Display>(x: T) {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(2);\n");
        buf_str(out, c"    x.fmt(&mut f);\n");
        buf_str(out, c"    f.byte('\\n');\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// x's Display in a new Buf on allocator a, of its length (the caller frees\n");
        buf_str(out, c"// it): `format_in(f\"{x:>8}\", gpa)`. (0.16: up to 256 bytes, x's Display\n");
        buf_str(out, c"// runs once, into a buffer on the stack.)\n");
        buf_str(out, c"pub fn format_in<T: Display, A: Allocator>(x: T, a: A) -> Buf<A> {\n");
        buf_str(out, c"    let mut b: Buf<A> = Buf::new_in(a);\n");
        buf_str(out, c"    let mut tmp: [u8; 256] = [0; 256];\n");
        buf_str(out, c"    let mut f = __fmt_tmp(&mut tmp);\n");
        buf_str(out, c"    // (one call of x's Display in the code: first to tmp, then, when the\n");
        buf_str(out, c"    // text did not fit, to b's room)\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        x.fmt(&mut f);\n");
        buf_str(out, c"        if __fmt_in_end(&mut b, &mut f, &tmp) {\n");
        buf_str(out, c"            return b;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.17) What the compiler writes for an f-string passed straight to\n");
        buf_str(out, c"// format_in, push_fmt, print, println, eprint or eprintln\n");
        buf_str(out, c"// (front/check/interp.tach): the holes' values, then the writes of\n");
        buf_str(out, c"// the text in place, with no closure. `format_in(f\"..\", a)` is\n");
        buf_str(out, c"//\n");
        buf_str(out, c"//   { let __f0 = e0; ...; let __a = a; let mut __b = std::Buf::new_in(__a);\n");
        buf_str(out, c"//     let mut __t = [0u8; 256]; let mut __out = std::__fmt_tmp(&mut __t);\n");
        buf_str(out, c"//     loop { WRITES; if std::__fmt_in_end(&mut __b, &mut __out, &__t) { break; } }\n");
        buf_str(out, c"//     __b }\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// and `b.push_fmt(f\"..\")` is `{ let __r = &b; let __f0 = e0; ...; let mut\n");
        buf_str(out, c"// __out = std::__buf_fmt(&mut *__r); loop { WRITES; if\n");
        buf_str(out, c"// std::__buf_fmt_end(&mut *__r, &mut __out) { break; } } }`. Not for programs to call.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A Fmt writing into tmp (format_in's first pass).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"#[views(tmp)]\n");
        buf_str(out, c"pub fn __fmt_tmp(tmp: &mut [u8; 256]) -> Fmt {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(-1);\n");
        buf_str(out, c"    f.out = (*tmp)[..];\n");
        buf_str(out, c"    f\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The end of a pass of format_in: the text written to tmp, when it fits,\n");
        buf_str(out, c"// copied to b, of its length (true); else b reserves the length and f\n");
        buf_str(out, c"// writes into b's room (false); after that pass, as __buf_fmt_end.\n");
        buf_str(out, c"pub fn __fmt_in_end<A: Allocator>(b: &mut Buf<A>, f: &mut Fmt, tmp: &[u8; 256]) -> bool {\n");
        buf_str(out, c"    if f.out.ptr != (*tmp)[..].ptr {\n");
        buf_str(out, c"        return fmt_end_vec(&mut b.bytes, f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if f.need == 0 {\n");
        buf_str(out, c"        b.bytes.reserve(f.len);\n");
        buf_str(out, c"        b.bytes.extend_from_slice((*tmp)[0..f.len]);\n");
        buf_str(out, c"        return true;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    b.bytes.reserve(f.need);\n");
        buf_str(out, c"    *f = fmt_to_vec(&mut b.bytes);\n");
        buf_str(out, c"    false\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A Fmt writing into b's room (push_fmt).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"#[views(b)]\n");
        buf_str(out, c"pub fn __buf_fmt<A: Allocator>(b: &mut Buf<A>) -> Fmt {\n");
        buf_str(out, c"    fmt_to_vec(&mut b.bytes)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The text f wrote is b's (true), or did not fit: b grows, f starts again.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn __buf_fmt_end<A: Allocator>(b: &mut Buf<A>, f: &mut Fmt) -> bool {\n");
        buf_str(out, c"    fmt_end_vec(&mut b.bytes, f)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"format_in(x, gpa)\")]\n");
        buf_str(out, c"pub fn format<T: Display>(x: T) -> Buf {\n");
        buf_str(out, c"    format_in(x, Gpa::ambient())\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Buf<A> {\n");
        buf_str(out, c"    // Appends x's Display: `b.push_fmt(f\"{k}={v};\")`. (0.16: into the room\n");
        buf_str(out, c"    // the Buf has; when the text does not fit, the Buf grows and x's\n");
        buf_str(out, c"    // Display runs again.)\n");
        buf_str(out, c"    pub fn push_fmt<T: Display>(self: &mut Buf<A>, x: T) {\n");
        buf_str(out, c"        let mut f = __buf_fmt(self);\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            x.fmt(&mut f);\n");
        buf_str(out, c"            if __buf_fmt_end(self, &mut f) {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A Fmt writing into v's room.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_to_vec<A: Allocator>(v: &mut Vec<u8, A>) -> Fmt {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(-1);\n");
        buf_str(out, c"    f.out = unsafe { v.ptr[0..v.cap] };\n");
        buf_str(out, c"    f.len = v.len;\n");
        buf_str(out, c"    f\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The text f wrote into v's room is v's (true), or did not fit: v grows to\n");
        buf_str(out, c"// fit it, f starts again (false).\n");
        buf_str(out, c"fn fmt_end_vec<A: Allocator>(v: &mut Vec<u8, A>, f: &mut Fmt) -> bool {\n");
        buf_str(out, c"    if f.need == 0 {\n");
        buf_str(out, c"        v.len = f.len;\n");
        buf_str(out, c"        return true;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v.reserve(f.need - v.len);\n");
        buf_str(out, c"    *f = fmt_to_vec(v);\n");
        buf_str(out, c"    false\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `{x}` in an f-string, and what print writes.\n");
        buf_str(out, c"pub trait Display { fn fmt(self: &Self, f: &mut Fmt); }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `{x:?}`: as the code that makes it.\n");
        buf_str(out, c"pub trait Debug { fn fmt_debug(self: &Self, f: &mut Fmt); }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A spec's flags (front/ast.tach's FMT_*): `<`, `>`, `0`, `x`, `X`, `b`,\n");
        buf_str(out, c"// `c`; spec adds FMT_PAD to a hole with a width or a precision, and a\n");
        buf_str(out, c"// number written first in such a hole adds FMT_NUM (right-aligned,\n");
        buf_str(out, c"// zero-padded after its sign, not cut by the precision).\n");
        buf_str(out, c"const FMT_LEFT: i64 = 1;\n");
        buf_str(out, c"const FMT_RIGHT: i64 = 2;\n");
        buf_str(out, c"const FMT_ZERO: i64 = 4;\n");
        buf_str(out, c"const FMT_HEX: i64 = 8;\n");
        buf_str(out, c"const FMT_UPPER: i64 = 16;\n");
        buf_str(out, c"const FMT_BIN: i64 = 32;\n");
        buf_str(out, c"const FMT_CHAR: i64 = 64;\n");
        buf_str(out, c"const FMT_NUM: i64 = 128;\n");
        buf_str(out, c"const FMT_PAD: i64 = 256;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The buffer of stdout and stderr: FMT_LEN bytes for FMT_FD; FMT_DONE\n");
        buf_str(out, c"// bytes were written out before them (FMT_DONE + FMT_LEN: the position a\n");
        buf_str(out, c"// spec marks).\n");
        buf_str(out, c"const FMT_CAP: i64 = 4096;\n");
        buf_str(out, c"static mut FMT_OUT: [u8; 4096] = [0; 4096];\n");
        buf_str(out, c"static mut FMT_LEN: i64 = 0;\n");
        buf_str(out, c"static mut FMT_FD: i32 = 1;\n");
        buf_str(out, c"static mut FMT_DONE: i64 = 0;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Writes the buffer out.\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_flush() {\n");
        buf_str(out, c"    let mut i = 0;\n");
        buf_str(out, c"    // (each round writes a byte at least)\n");
        buf_str(out, c"    for _ in 0..FMT_LEN {\n");
        buf_str(out, c"        if i >= FMT_LEN {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let rest = FMT_OUT[i..FMT_LEN];\n");
        buf_str(out, c"        let n = unsafe { write(FMT_FD, rest.ptr, rest.len as u64) };\n");
        buf_str(out, c"        if n <= 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i += n;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    FMT_DONE += FMT_LEN;\n");
        buf_str(out, c"    FMT_LEN = 0;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The next n bytes of f's destination, taken, when they fit (the Buf has\n");
        buf_str(out, c"// the room, the buffer holds FMT_FD's bytes); else an empty slice.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_room(f: &mut Fmt, n: i64) -> [u8] {\n");
        buf_str(out, c"    let at = f.len;\n");
        buf_str(out, c"    if at + n <= f.out.len {\n");
        buf_str(out, c"        f.len = at + n;\n");
        buf_str(out, c"        return unsafe { f.out.ptr[at..at + n] };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if f.fd == FMT_FD && FMT_LEN + n <= FMT_CAP {\n");
        buf_str(out, c"        let at = FMT_LEN;\n");
        buf_str(out, c"        FMT_LEN = at + n;\n");
        buf_str(out, c"        return FMT_OUT[at..at + n];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    \"\"\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// fmt_room when they do not fit (n: at most FMT_CAP): the buffer written\n");
        buf_str(out, c"// out first; to a Buf, an empty slice, the n bytes counted (fmt_lost). (A\n");
        buf_str(out, c"// Fmt's file descriptor or Buf is chosen inline, so that print compiles\n");
        buf_str(out, c"// only the file descriptor's functions.)\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_make_room(f: &mut Fmt, n: i64) -> [u8] {\n");
        buf_str(out, c"    if f.fd >= 0 { fmt_fd_room(f.fd, n) } else { fmt_lost(f, n) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_fd_room(fd: i32, n: i64) -> [u8] {\n");
        buf_str(out, c"    if fd != FMT_FD || FMT_LEN + n > FMT_CAP {\n");
        buf_str(out, c"        fmt_flush();\n");
        buf_str(out, c"        FMT_FD = fd;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let at = FMT_LEN;\n");
        buf_str(out, c"    FMT_LEN = at + n;\n");
        buf_str(out, c"    FMT_OUT[at..at + n]\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// n bytes to a Buf that has no room for them: counted, not written (the\n");
        buf_str(out, c"// text is written again, push_fmt).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_lost(f: &mut Fmt, n: i64) -> [u8] {\n");
        buf_str(out, c"    let end = f.len + n;\n");
        buf_str(out, c"    if end > f.need {\n");
        buf_str(out, c"        f.need = end;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    f.len = end;\n");
        buf_str(out, c"    \"\"\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fmt::str (a call: an f-string's text is one).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_str(f: &mut Fmt, s: [u8]) {\n");
        buf_str(out, c"    if f.fd >= 0 {\n");
        buf_str(out, c"        fmt_str_fd(f.fd, s);\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        fmt_str_buf(f, s);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_str_fd(fd: i32, s: [u8]) {\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    let mut out: [u8] = \"\";\n");
        buf_str(out, c"    if fd == FMT_FD && FMT_LEN + n <= FMT_CAP {\n");
        buf_str(out, c"        let at = FMT_LEN;\n");
        buf_str(out, c"        FMT_LEN = at + n;\n");
        buf_str(out, c"        out = FMT_OUT[at..at + n];\n");
        buf_str(out, c"    } else if n > FMT_CAP {\n");
        buf_str(out, c"        // (written directly)\n");
        buf_str(out, c"        fmt_flush();\n");
        buf_str(out, c"        FMT_FD = fd;\n");
        buf_str(out, c"        let mut i = 0;\n");
        buf_str(out, c"        for _ in 0..n {\n");
        buf_str(out, c"            if i >= n {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let rest = s[i..n];\n");
        buf_str(out, c"            let k = unsafe { write(fd, rest.ptr, rest.len as u64) };\n");
        buf_str(out, c"            if k <= 0 {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += k;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        FMT_DONE += n;\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        out = fmt_fd_room(fd, n);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        memcpy(out.ptr, s.ptr, n as u64);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_str_buf(f: &mut Fmt, s: [u8]) {\n");
        buf_str(out, c"    let at = f.len;\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    if at + n <= f.out.len {\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            memcpy(&f.out.ptr[at], s.ptr, n as u64);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.len = at + n;\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        fmt_lost(f, n);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fmt::byte when it does not fit.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_byte(f: &mut Fmt, b: u8) {\n");
        buf_str(out, c"    let out = fmt_make_room(f, 1);\n");
        buf_str(out, c"    if out.len == 1 {\n");
        buf_str(out, c"        out[0] = b;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// u's decimal digits, after a '-' when negative.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_decimal(f: &mut Fmt, u: u64, negative: bool) {\n");
        buf_str(out, c"    let len = if negative { decimal_len(u) + 1 } else { decimal_len(u) };\n");
        buf_str(out, c"    let mut out = fmt_room(f, len);\n");
        buf_str(out, c"    if out.len != len {\n");
        buf_str(out, c"        out = fmt_make_room(f, len);\n");
        buf_str(out, c"        if out.len != len {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        put_decimal(out.ptr, len, u, negative);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What Display and Debug write to: a file descriptor `fd` (through std's\n");
        buf_str(out, c"// buffer: `flush` writes it out), or (fd -1) the room out[len..] of a\n");
        buf_str(out, c"// Buf, `need` the length the text reached when it did not fit (0: it\n");
        buf_str(out, c"// fits). (0.17) A view: `out`, the Buf's room, so a Buf cannot change while\n");
        buf_str(out, c"// a Fmt writes into it. `width`, `prec` (-1: none) and `flags` are the spec of the hole\n");
        buf_str(out, c"// being written, `mark` the position it started at. (0.16: sealed; std's\n");
        buf_str(out, c"// functions make one.)\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct Fmt {\n");
        buf_str(out, c"    out: [u8], len: i64, need: i64, fd: i32, width: i64, prec: i64, flags: i64,\n");
        buf_str(out, c"    mark: i64,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Fmt {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views()]\n");
        buf_str(out, c"    pub fn to_fd(fd: i32) -> Fmt {\n");
        buf_str(out, c"        Fmt {\n");
        buf_str(out, c"            out: \"\", len: 0, need: 0, fd: fd, width: -1, prec: -1, flags: 0, mark: 0\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn str(self: &mut Fmt, s: [u8]) {\n");
        buf_str(out, c"        fmt_str(self, s);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn byte(self: &mut Fmt, b: u8) {\n");
        buf_str(out, c"        let at = self.len;\n");
        buf_str(out, c"        if at < self.out.len {\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                self.out.ptr[at] = b;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.len = at + 1;\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.fd == FMT_FD && FMT_LEN < FMT_CAP {\n");
        buf_str(out, c"            let out: *u8 = &FMT_OUT[0];\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                out[FMT_LEN] = b;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            FMT_LEN += 1;\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        fmt_byte(self, b);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Writes out what a Fmt to a file descriptor has buffered (print does).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn flush(self: &mut Fmt) {\n");
        buf_str(out, c"        if self.fd >= 0 {\n");
        buf_str(out, c"            fmt_flush();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // x's Display: `f.write(f\"({self.x}, {self.y})\")` in a Display impl.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn write<T: Display>(self: &mut Fmt, x: T) {\n");
        buf_str(out, c"        x.fmt(self);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn display<T: Display>(self: &mut Fmt, x: &T) {\n");
        buf_str(out, c"        x.fmt(self);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn debug<T: Debug>(self: &mut Fmt, x: &T) {\n");
        buf_str(out, c"        x.fmt_debug(self);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The position written to.\n");
        buf_str(out, c"    fn pos(self: &mut Fmt) -> i64 {\n");
        buf_str(out, c"        if self.fd >= 0 { FMT_DONE + FMT_LEN } else { self.len }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Starts a hole with a spec (width w, precision p, -1: none; FMT_*\n");
        buf_str(out, c"    // flags): what is written up to end_spec, given the result, is padded\n");
        buf_str(out, c"    // to w. The buffer is first written out unless w bytes fit in it, so\n");
        buf_str(out, c"    // the hole's text is either all in it or at least w long.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn spec(self: &mut Fmt, w: i64, p: i64, flags: i64) -> FmtSpec {\n");
        buf_str(out, c"        let old = FmtSpec {\n");
        buf_str(out, c"            width: self.width, prec: self.prec, flags: self.flags, mark: self.mark\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        self.flags = flags;\n");
        buf_str(out, c"        if w > 0 || p >= 0 {\n");
        buf_str(out, c"            if self.fd >= 0 && (self.fd != FMT_FD || FMT_CAP - FMT_LEN < w) {\n");
        buf_str(out, c"                fmt_flush();\n");
        buf_str(out, c"                FMT_FD = self.fd;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.width = w;\n");
        buf_str(out, c"            self.prec = p;\n");
        buf_str(out, c"            self.flags = flags | FMT_PAD;\n");
        buf_str(out, c"            self.mark = self.pos();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        old\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Ends the hole `spec` started (`old`: what it returned).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn end_spec(self: &mut Fmt, old: FmtSpec) {\n");
        buf_str(out, c"        if (self.flags & FMT_PAD) != 0 {\n");
        buf_str(out, c"            fmt_pad(self);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.width = old.width;\n");
        buf_str(out, c"        self.prec = old.prec;\n");
        buf_str(out, c"        self.flags = old.flags;\n");
        buf_str(out, c"        self.mark = old.mark;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // v in decimal (x, X, b: in hex or binary, as a u64; c: its low byte).\n");
        buf_str(out, c"    #[inline(never)]\n");
        buf_str(out, c"    pub fn int(self: &mut Fmt, v: i64) {\n");
        buf_str(out, c"        if self.flags != 0 {\n");
        buf_str(out, c"            if (self.flags & (FMT_HEX | FMT_BIN | FMT_CHAR)) != 0 {\n");
        buf_str(out, c"                fmt_radix(self, v as u64);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                let negative = v < 0;\n");
        buf_str(out, c"                fmt_spec_decimal(self, if negative { (-(v + 1)) as u64 + 1 } else { v as u64 },\n");
        buf_str(out, c"                    negative);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let negative = v < 0;\n");
        buf_str(out, c"        fmt_decimal(self, if negative { (-(v + 1)) as u64 + 1 } else { v as u64 }, negative);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // v in decimal, hex (x, X), binary (b), or as a byte (c).\n");
        buf_str(out, c"    #[inline(never)]\n");
        buf_str(out, c"    pub fn uint(self: &mut Fmt, v: u64) {\n");
        buf_str(out, c"        if self.flags != 0 {\n");
        buf_str(out, c"            if (self.flags & (FMT_HEX | FMT_BIN | FMT_CHAR)) != 0 {\n");
        buf_str(out, c"                fmt_radix(self, v);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                fmt_spec_decimal(self, v, false);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        fmt_decimal(self, v, false);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // v as Display writes it: the shortest decimal that reads back as v,\n");
        buf_str(out, c"    // never with an exponent; with a precision, that many decimals.\n");
        buf_str(out, c"    pub fn float(self: &mut Fmt, v: f64) {\n");
        buf_str(out, c"        fmt_float(self, v, false, false);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fmt::int and Fmt::uint with a spec of a decimal: u, after a '-' when\n");
        buf_str(out, c"// negative.\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_spec_decimal(f: &mut Fmt, u: u64, negative: bool) {\n");
        buf_str(out, c"    fmt_number_start(f);\n");
        buf_str(out, c"    fmt_decimal(f, u, negative);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A number starts here: when nothing of the hole is written yet, the hole\n");
        buf_str(out, c"// is a number's (right-aligned, zero-padded after the sign).\n");
        buf_str(out, c"fn fmt_number_start(f: &mut Fmt) {\n");
        buf_str(out, c"    if (f.flags & FMT_PAD) != 0 && f.pos() == f.mark {\n");
        buf_str(out, c"        f.flags |= FMT_NUM;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// v in hex or binary, or its low byte (c).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_radix(f: &mut Fmt, v: u64) {\n");
        buf_str(out, c"    let flags = f.flags;\n");
        buf_str(out, c"    if (flags & FMT_CHAR) != 0 {\n");
        buf_str(out, c"        f.byte(v as u8);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    fmt_number_start(f);\n");
        buf_str(out, c"    let shift: u64 = if (flags & FMT_HEX) != 0 { 4 } else { 1 };\n");
        buf_str(out, c"    let mask = (1u64 << shift) - 1;\n");
        buf_str(out, c"    let digits = if (flags & FMT_UPPER) != 0 { \"0123456789ABCDEF\" } else { \"0123456789abcdef\" };\n");
        buf_str(out, c"    let mut n = 1;\n");
        buf_str(out, c"    let mut bits = shift;\n");
        buf_str(out, c"    for _ in 0..64 {\n");
        buf_str(out, c"        if bits >= 64 || (v >> bits) == 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        n += 1;\n");
        buf_str(out, c"        bits += shift;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut out = fmt_room(f, n);\n");
        buf_str(out, c"    if out.len != n {\n");
        buf_str(out, c"        out = fmt_make_room(f, n);\n");
        buf_str(out, c"        if out.len != n {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut u = v;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let p = out.ptr;\n");
        buf_str(out, c"        for k in 0..n {\n");
        buf_str(out, c"            p[n - 1 - k] = digits.ptr[(u & mask) as i64];\n");
        buf_str(out, c"            u = u >> shift;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A signed integer of `bits` bits: in hex or binary as its unsigned value\n");
        buf_str(out, c"// of that size (Rust's `{:x}` of -1i8 is ff).\n");
        buf_str(out, c"fn fmt_signed(f: &mut Fmt, v: i64, bits: u64) {\n");
        buf_str(out, c"    if v < 0 && (f.flags & (FMT_HEX | FMT_BIN)) != 0 {\n");
        buf_str(out, c"        f.uint((v as u64) & ((1u64 << bits) - 1));\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        f.int(v);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The padding and truncation of the hole f.spec started.\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_pad(f: &mut Fmt) {\n");
        buf_str(out, c"    let flags = f.flags;\n");
        buf_str(out, c"    let start = f.mark;\n");
        buf_str(out, c"    let mut end = f.pos();\n");
        buf_str(out, c"    let number = (flags & FMT_NUM) != 0;\n");
        buf_str(out, c"    let reach = if f.fd >= 0 { start >= FMT_DONE && f.fd == FMT_FD } else { true };\n");
        buf_str(out, c"    // (a precision cuts text)\n");
        buf_str(out, c"    if f.prec >= 0 && !number && end - start > f.prec && reach {\n");
        buf_str(out, c"        end = start + f.prec;\n");
        buf_str(out, c"        if f.fd >= 0 {\n");
        buf_str(out, c"            FMT_LEN = end - FMT_DONE;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            f.len = end;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let pad = f.width - (end - start);\n");
        buf_str(out, c"    if pad <= 0 {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if (flags & FMT_LEFT) != 0 || (flags & FMT_RIGHT) == 0 && !number {\n");
        buf_str(out, c"        for i in 0..pad {\n");
        buf_str(out, c"            f.byte(' ');\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if !reach {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // Right-aligned: the text moves right by pad, after the sign when zeros\n");
        buf_str(out, c"    // fill.\n");
        buf_str(out, c"    let zeros = number && (flags & FMT_ZERO) != 0;\n");
        buf_str(out, c"    let mut text: *u8 = 0 as *u8;\n");
        buf_str(out, c"    let mut base = 0;\n");
        buf_str(out, c"    if f.fd >= 0 {\n");
        buf_str(out, c"        // (spec made room for the width)\n");
        buf_str(out, c"        text = &FMT_OUT[0];\n");
        buf_str(out, c"        base = FMT_DONE;\n");
        buf_str(out, c"        FMT_LEN += pad;\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        // (when the text was lost or the room is short: counted)\n");
        buf_str(out, c"        if f.need != 0 || f.len + pad > f.out.len {\n");
        buf_str(out, c"            fmt_lost(f, pad);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        text = f.out.ptr;\n");
        buf_str(out, c"        f.len += pad;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut at = start - base;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        if zeros && end > start && (text[at] == '-' || text[at] == '+') {\n");
        buf_str(out, c"            at += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let count = end - base - at;\n");
        buf_str(out, c"        for k in 0..count {\n");
        buf_str(out, c"            let i = count - 1 - k;\n");
        buf_str(out, c"            text[at + pad + i] = text[at + i];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for k in 0..pad {\n");
        buf_str(out, c"            text[at + k] = if zeros { '0' } else { ' ' };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// v in decimal (single: an f32's value): the shortest digits that read\n");
        buf_str(out, c"// back as v (15 to 17 of them, 6 to 9 for an f32), never with an exponent\n");
        buf_str(out, c"// for Display; Debug as Rust writes it (`1.0`, `1e16`, `1e-7`). With a\n");
        buf_str(out, c"// precision, that many decimals (C's %.Nf).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_float(f: &mut Fmt, v: f64, single: bool, debug: bool) {\n");
        buf_str(out, c"    if f.flags != 0 {\n");
        buf_str(out, c"        fmt_number_start(f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if v != v {\n");
        buf_str(out, c"        f.str(\"NaN\");\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if v - v != 0.0 {\n");
        buf_str(out, c"        f.str(if v > 0.0 { \"inf\" } else { \"-inf\" });\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut tmp: [u8; 64] = [0; 64];\n");
        buf_str(out, c"    if f.prec >= 0 {\n");
        buf_str(out, c"        let n = unsafe { snprintf(&tmp[0], 64, c\"%.*f\", f.prec as i32, v) } as i64;\n");
        buf_str(out, c"        if n < 64 {\n");
        buf_str(out, c"            f.str(tmp[0..n]);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            fmt_fixed_long(f, v);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut digits = if single { 6 } else { 15 };\n");
        buf_str(out, c"    let last = if single { 9 } else { 17 };\n");
        buf_str(out, c"    let mut n = 0;\n");
        buf_str(out, c"    // (from 6 or 15 digits to 9 or 17)\n");
        buf_str(out, c"    for _ in 0..4 {\n");
        buf_str(out, c"        n = unsafe { snprintf(&tmp[0], 64, c\"%.*e\", (digits - 1) as i32, v) } as i64;\n");
        buf_str(out, c"        if digits == last {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let same = if single {\n");
        buf_str(out, c"            let back = unsafe { strtof(&tmp[0], 0 as **u8) };\n");
        buf_str(out, c"            back == v as f32\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            let back = unsafe { strtod(&tmp[0], 0 as **u8) };\n");
        buf_str(out, c"            back == v\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        if same {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        digits += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // tmp: [-]d[.ddd]e(+|-)dd: the digits (without the point) and the\n");
        buf_str(out, c"    // exponent of the first.\n");
        buf_str(out, c"    let mut i = 0;\n");
        buf_str(out, c"    let negative = tmp[0] == '-';\n");
        buf_str(out, c"    if negative {\n");
        buf_str(out, c"        i = 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut ds: [u8; 24] = [0; 24];\n");
        buf_str(out, c"    let mut k = 0;\n");
        buf_str(out, c"    for _ in i..n {\n");
        buf_str(out, c"        if tmp[i] == 'e' {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if tmp[i] != '.' {\n");
        buf_str(out, c"            ds[k] = tmp[i];\n");
        buf_str(out, c"            k += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for _ in 1..k {\n");
        buf_str(out, c"        if ds[k - 1] != '0' {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        k -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    i += 1;\n");
        buf_str(out, c"    let exp_negative = tmp[i] == '-';\n");
        buf_str(out, c"    i += 1;\n");
        buf_str(out, c"    let mut exp = 0;\n");
        buf_str(out, c"    for _ in i..n {\n");
        buf_str(out, c"        exp = exp * 10 + (tmp[i] - '0') as i64;\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if exp_negative {\n");
        buf_str(out, c"        exp = -exp;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if negative {\n");
        buf_str(out, c"        f.byte('-');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if debug && (exp < -4 || exp >= 16) {\n");
        buf_str(out, c"        f.byte(ds[0]);\n");
        buf_str(out, c"        if k > 1 {\n");
        buf_str(out, c"            f.byte('.');\n");
        buf_str(out, c"            f.str(ds[1..k]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.byte('e');\n");
        buf_str(out, c"        f.int(exp);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if exp < 0 {\n");
        buf_str(out, c"        f.str(\"0.\");\n");
        buf_str(out, c"        for z in 0..-exp - 1 {\n");
        buf_str(out, c"            f.byte('0');\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.str(ds[0..k]);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if k <= exp + 1 {\n");
        buf_str(out, c"        f.str(ds[0..k]);\n");
        buf_str(out, c"        for z in 0..exp + 1 - k {\n");
        buf_str(out, c"            f.byte('0');\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if debug {\n");
        buf_str(out, c"            f.str(\".0\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    f.str(ds[0..exp + 1]);\n");
        buf_str(out, c"    f.byte('.');\n");
        buf_str(out, c"    f.str(ds[exp + 1..k]);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// v with f's precision, of 64 bytes or more: C's %.*f into a buffer on\n");
        buf_str(out, c"// the stack (a double has at most 309 digits before the point and 1074\n");
        buf_str(out, c"// after it: from 1100 decimals on they are zeros, written after).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_fixed_long(f: &mut Fmt, v: f64) {\n");
        buf_str(out, c"    let prec = if f.prec > 1100 { 1100 } else { f.prec };\n");
        buf_str(out, c"    let mut tmp: [u8; 1424] = [0; 1424];\n");
        buf_str(out, c"    let n = unsafe { snprintf(&tmp[0], 1424, c\"%.*f\", prec as i32, v) } as i64;\n");
        buf_str(out, c"    f.str(tmp[0..if n < 1424 { n } else { 1423 }]);\n");
        buf_str(out, c"    for _ in prec..f.prec {\n");
        buf_str(out, c"        f.byte('0');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Text in quotes, escaped as Rust's Debug of a str does.\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_quoted(f: &mut Fmt, s: [u8]) {\n");
        buf_str(out, c"    f.byte('\"');\n");
        buf_str(out, c"    let mut from = 0;\n");
        buf_str(out, c"    for i in 0..s.len {\n");
        buf_str(out, c"        let c = s[i];\n");
        buf_str(out, c"        if c == '\"' || c == '\\\\' || c < 32 || c == 127 {\n");
        buf_str(out, c"            f.str(s[from..i]);\n");
        buf_str(out, c"            from = i + 1;\n");
        buf_str(out, c"            f.byte('\\\\');\n");
        buf_str(out, c"            if c == '\\n' {\n");
        buf_str(out, c"                f.byte('n');\n");
        buf_str(out, c"            } else if c == '\\t' {\n");
        buf_str(out, c"                f.byte('t');\n");
        buf_str(out, c"            } else if c == '\\r' {\n");
        buf_str(out, c"                f.byte('r');\n");
        buf_str(out, c"            } else if c == 0 {\n");
        buf_str(out, c"                f.byte('0');\n");
        buf_str(out, c"            } else if c == '\"' || c == '\\\\' {\n");
        buf_str(out, c"                f.byte(c);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                let hex = \"0123456789abcdef\";\n");
        buf_str(out, c"                f.str(\"u{\");\n");
        buf_str(out, c"                if c >= 16 {\n");
        buf_str(out, c"                    f.byte(hex[(c >> 4) as i64]);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                f.byte(hex[(c & 15) as i64]);\n");
        buf_str(out, c"                f.byte('}');\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    f.str(s[from..s.len]);\n");
        buf_str(out, c"    f.byte('\"');\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The elements of s, as Debug writes a Vec: `[1, 2, 3]`.\n");
        buf_str(out, c"pub fn debug_list<T: Debug>(f: &mut Fmt, s: [T]) {\n");
        buf_str(out, c"    f.byte('[');\n");
        buf_str(out, c"    for i in 0..s.len {\n");
        buf_str(out, c"        if i > 0 {\n");
        buf_str(out, c"            f.str(\", \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.debug(&s[i]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    f.byte(']');\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An f-string's value: its holes' values, and a closure that writes the\n");
        buf_str(out, c"// text.\n");
        buf_str(out, c"pub struct Interp<F> { f: F }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<F: Fn(&mut Fmt)> Display for Interp<F> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &Interp<F>, out: &mut Fmt) {\n");
        buf_str(out, c"        (self.f)(out);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Fmt's holes (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The spec of the hole a Fmt was writing, which Fmt::spec saves and\n");
        buf_str(out, c"// end_spec puts back (0.16).\n");
        buf_str(out, c"pub struct FmtSpec { width: i64, prec: i64, flags: i64, mark: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Fmt {\n");
        buf_str(out, c"    // An f-string's hole of a decimal integer with a spec of width w and\n");
        buf_str(out, c"    // flags (`{n:>5}`, `{n:05}`): what spec, int and end_spec write, in one\n");
        buf_str(out, c"    // pass (0.16).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn int_hole(self: &mut Fmt, v: i64, w: i64, flags: i64) {\n");
        buf_str(out, c"        let negative = v < 0;\n");
        buf_str(out, c"        fmt_hole(self, if negative { (-(v + 1)) as u64 + 1 } else { v as u64 }, negative, w,\n");
        buf_str(out, c"            flags);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn uint_hole(self: &mut Fmt, v: u64, w: i64, flags: i64) {\n");
        buf_str(out, c"        fmt_hole(self, v, false, w, flags);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fmt::int_hole: u (after a '-' when negative) padded to w: with spaces\n");
        buf_str(out, c"// before it (after it: FMT_LEFT), or zeros after its sign (FMT_ZERO).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_hole(f: &mut Fmt, u: u64, negative: bool, w: i64, flags: i64) {\n");
        buf_str(out, c"    let n = if negative { decimal_len(u) + 1 } else { decimal_len(u) };\n");
        buf_str(out, c"    let pad = w - n;\n");
        buf_str(out, c"    if pad <= 0 {\n");
        buf_str(out, c"        fmt_decimal(f, u, negative);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if w > FMT_CAP {\n");
        buf_str(out, c"        // (as spec and end_spec do)\n");
        buf_str(out, c"        let old = f.spec(w, -1, flags);\n");
        buf_str(out, c"        fmt_number_start(f);\n");
        buf_str(out, c"        fmt_decimal(f, u, negative);\n");
        buf_str(out, c"        f.end_spec(old);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut out = fmt_room(f, w);\n");
        buf_str(out, c"    if out.len != w {\n");
        buf_str(out, c"        out = fmt_make_room(f, w);\n");
        buf_str(out, c"        if out.len != w {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let p = out.ptr;\n");
        buf_str(out, c"        if (flags & FMT_LEFT) != 0 {\n");
        buf_str(out, c"            put_decimal(p, n, u, negative);\n");
        buf_str(out, c"            for k in n..w {\n");
        buf_str(out, c"                p[k] = ' ';\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            put_decimal(&p[pad], n, u, negative);\n");
        buf_str(out, c"            let fill: u8 = if (flags & FMT_ZERO) != 0 { '0' } else { ' ' };\n");
        buf_str(out, c"            for k in 0..pad {\n");
        buf_str(out, c"                p[k] = fill;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if negative && fill == '0' {\n");
        buf_str(out, c"                p[0] = '-';\n");
        buf_str(out, c"                p[pad] = '0';\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Display and Debug of std's types (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for i8 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &i8, f: &mut Fmt) { fmt_signed(f, *self as i64, 8); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for i8 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: &i8, f: &mut Fmt) { fmt_signed(f, *self as i64, 8); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for i16 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &i16, f: &mut Fmt) { fmt_signed(f, *self as i64, 16); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for i16 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: &i16, f: &mut Fmt) { fmt_signed(f, *self as i64, 16); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for i32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &i32, f: &mut Fmt) { fmt_signed(f, *self as i64, 32); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for i32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: &i32, f: &mut Fmt) { fmt_signed(f, *self as i64, 32); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for i64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &i64, f: &mut Fmt) { f.int(*self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for i64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: &i64, f: &mut Fmt) { f.int(*self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (a number, as in Rust: `{c:c}` writes the byte)\n");
        buf_str(out, c"impl Display for u8 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &u8, f: &mut Fmt) { f.uint(*self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for u8 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: &u8, f: &mut Fmt) { f.uint(*self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for u16 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &u16, f: &mut Fmt) { f.uint(*self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for u16 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: &u16, f: &mut Fmt) { f.uint(*self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for u32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &u32, f: &mut Fmt) { f.uint(*self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for u32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: &u32, f: &mut Fmt) { f.uint(*self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for u64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &u64, f: &mut Fmt) { f.uint(*self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for u64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: &u64, f: &mut Fmt) { f.uint(*self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for f64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &f64, f: &mut Fmt) { fmt_float(f, *self, false, false); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for f64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: &f64, f: &mut Fmt) { fmt_float(f, *self, false, true); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for f32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &f32, f: &mut Fmt) { fmt_float(f, *self as f64, true, false); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for f32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: &f32, f: &mut Fmt) { fmt_float(f, *self as f64, true, true); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for bool {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &bool, f: &mut Fmt) { f.str(if *self { \"true\" } else { \"false\" }); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for bool {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: &bool, f: &mut Fmt) { f.str(if *self { \"true\" } else { \"false\" }); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for [u8] {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &Self, f: &mut Fmt) { f.str(*self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (quoted and escaped: `\"a\\n\"`)\n");
        buf_str(out, c"impl Debug for [u8] {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: &Self, f: &mut Fmt) { fmt_quoted(f, *self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Display for Buf<A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: &Buf<A>, f: &mut Fmt) { f.str(self.as_slice()); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Debug for Buf<A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: &Buf<A>, f: &mut Fmt) { fmt_quoted(f, self.as_slice()); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Debug> Debug for Option<T> {\n");
        buf_str(out, c"    fn fmt_debug(self: &Option<T>, f: &mut Fmt) {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            Option::Some(x) => {\n");
        buf_str(out, c"                f.str(\"Some(\");\n");
        buf_str(out, c"                f.debug(&x);\n");
        buf_str(out, c"                f.byte(')');\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Option::None => f.str(\"None\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Debug, E: Debug> Debug for Result<T, E> {\n");
        buf_str(out, c"    fn fmt_debug(self: &Result<T, E>, f: &mut Fmt) {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            Result::Ok(x) => {\n");
        buf_str(out, c"                f.str(\"Ok(\");\n");
        buf_str(out, c"                f.debug(&x);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Result::Err(e) => {\n");
        buf_str(out, c"                f.str(\"Err(\");\n");
        buf_str(out, c"                f.debug(&e);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.byte(')');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Debug, A: Allocator> Debug for Vec<T, A> {\n");
        buf_str(out, c"    fn fmt_debug(self: &Vec<T, A>, f: &mut Fmt) { debug_list(f, self.as_slice()); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.16: `Ok(())`)\n");
        buf_str(out, c"impl Debug for () {\n");
        buf_str(out, c"    fn fmt_debug(self: &(), f: &mut Fmt) {\n");
        buf_str(out, c"        f.str(\"()\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Debug of HashMap (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `{k: v, ...}`, in slot order.\n");
        buf_str(out, c"impl<K: Hash + Eq + Debug, V: Debug, A: Allocator> Debug for HashMap<K, V, A> {\n");
        buf_str(out, c"    fn fmt_debug(self: &HashMap<K, V, A>, f: &mut Fmt) {\n");
        buf_str(out, c"        f.byte('{');\n");
        buf_str(out, c"        let mut first = true;\n");
        buf_str(out, c"        for i in 0..self.slots() {\n");
        buf_str(out, c"            if let Option::Some(k) = self.key_at(i) {\n");
        buf_str(out, c"                if !first {\n");
        buf_str(out, c"                    f.str(\", \");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                first = false;\n");
        buf_str(out, c"                let v = self.value_at(i).unwrap();\n");
        buf_str(out, c"                f.debug(&k);\n");
        buf_str(out, c"                f.str(\": \");\n");
        buf_str(out, c"                f.debug(&v);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.byte('}');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Conversions (0.15) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach: the same module,\n");
        buf_str(out, c"// `std`. From and Into, the traits of conversions\n");
        buf_str(out, c"// (docs/design/errors-formatting.md). Every type converts from itself,\n");
        buf_str(out, c"// and an integer type from the integer types that widen to it, without\n");
        buf_str(out, c"// an impl; Into is the compiler's: `let y: U = x.into()` is `U::from(x)`.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `AppError::from(e)`; what `?` converts an error with.\n");
        buf_str(out, c"pub trait From<T> { fn from(x: T) -> Self; }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Implement From, not Into.\n");
        buf_str(out, c"pub trait Into<T> { fn into(self: Self) -> T; }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Option<T> {\n");
        buf_str(out, c"    // Some(x) is Ok(x), None the error `err`: `opt.ok_or(E::Missing)?`.\n");
        buf_str(out, c"    pub fn ok_or<E>(self: Option<T>, err: E) -> Result<T, E> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => Result::Ok(x),\n");
        buf_str(out, c"            Option::None => Result::Err(err),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn map<U, F: Fn(T) -> U>(self: Option<T>, f: F) -> Option<U> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => Option::Some(f(x)),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn and_then<U, F: Fn(T) -> Option<U>>(self: Option<T>, f: F) -> Option<U> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => f(x),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap_or_else<F: Fn() -> T>(self: Option<T>, f: F) -> T {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => x,\n");
        buf_str(out, c"            Option::None => f(),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, E> Result<T, E> {\n");
        buf_str(out, c"    pub fn map<U, F: Fn(T) -> U>(self: Result<T, E>, f: F) -> Result<U, E> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => Result::Ok(f(x)),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The error converted: `r.map_err(AppError::Io)?`, `r.map_err(|e| ...)`.\n");
        buf_str(out, c"    pub fn map_err<G, F: Fn(E) -> G>(self: Result<T, E>, f: F) -> Result<T, G> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => Result::Ok(x),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(f(e)),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn err(self: Result<T, E>) -> Option<E> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(_) => Option::None,\n");
        buf_str(out, c"            Result::Err(e) => Option::Some(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap_or_else<F: Fn(E) -> T>(self: Result<T, E>, f: F) -> T {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => x,\n");
        buf_str(out, c"            Result::Err(e) => f(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (No string literals below: std's literals are in every program that\n");
        buf_str(out, c"// loads std, used or not.)\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What a `main` returning `Result<(), E>` does with an Err: `Error: {e:?}` and\n");
        buf_str(out, c"// a newline on stderr, then exit status 1 (the compiler calls it).\n");
        buf_str(out, c"pub fn main_error<E: Debug>(e: E) -> i32 {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(2);\n");
        buf_str(out, c"    let head: [u8; 7] = ['E', 'r', 'r', 'o', 'r', ':', ' '];\n");
        buf_str(out, c"    f.str(head[..]);\n");
        buf_str(out, c"    f.debug(&e);\n");
        buf_str(out, c"    f.byte('\\n');\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"    1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Clone and hashing (0.15) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach: the same module,\n");
        buf_str(out, c"// `std`. Clone, and the helpers `#[derive(Eq, Ord, Hash, Clone)]` calls on\n");
        buf_str(out, c"// each field (docs/design/errors-formatting.md). Numbers, bool, pointers,\n");
        buf_str(out, c"// slices, fn types, fieldless enums, and tuples and arrays of them clone\n");
        buf_str(out, c"// by copying, without an impl; tuples of Eq, Ord, Hash or Clone types are\n");
        buf_str(out, c"// Eq, Ord (lexicographic), Hash and Clone (element-wise), through the\n");
        buf_str(out, c"// functions at the end of this file, which the compiler calls.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A copy owning its memory (a Vec's elements are cloned).\n");
        buf_str(out, c"pub trait Clone { fn clone(self: &Self) -> Self; }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Hash h of the fields so far, with the hash x of the next one mixed in.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn hash_mix(h: u64, x: u64) -> u64 {\n");
        buf_str(out, c"    hash_u64(h ^ (x + 0x9e3779b97f4a7c15u64 + (h << 6) + (h >> 2)))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `*a == *b`: structural, or the type's Eq impl (`[u8]`: by bytes).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn eq_of<T: Eq>(a: &T, b: &T) -> bool {\n");
        buf_str(out, c"    *a == *b\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `a.cmp(b)`: negative, zero or positive as *a goes before, with or after\n");
        buf_str(out, c"// *b.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn cmp_of<T: Ord>(a: &T, b: &T) -> i64 {\n");
        buf_str(out, c"    a.cmp(b)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `x.hash()`.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn hash_of<T: Hash>(x: &T) -> u64 {\n");
        buf_str(out, c"    x.hash()\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `x.clone()`.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn clone_of<T: Clone>(x: &T) -> T {\n");
        buf_str(out, c"    x.clone()\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A new Vec of clones of the elements, on the same allocator.\n");
        buf_str(out, c"impl<T: Clone, A: Allocator> Clone for Vec<T, A> {\n");
        buf_str(out, c"    fn clone(self: &Vec<T, A>) -> Vec<T, A> {\n");
        buf_str(out, c"        self.clone_in(self.alloc)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Clone, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // (0.15) n copies of x on allocator a: Rust's `vec![x; n]`. (0.17)\n");
        buf_str(out, c"    // Clones of x, then x itself: n Vecs from one Vec each own their\n");
        buf_str(out, c"    // elements (plain types clone by copying).\n");
        buf_str(out, c"    pub fn filled_in(n: i64, x: T, a: A) -> Vec<T, A> {\n");
        buf_str(out, c"        let mut v: Vec<T, A> = Vec::with_capacity_in(n, a);\n");
        buf_str(out, c"        if n > 0 {\n");
        buf_str(out, c"            for _ in 1..n {\n");
        buf_str(out, c"                v.push(x.clone());\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            v.push(x);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A new Vec of clones of the elements, on allocator b (0.16).\n");
        buf_str(out, c"    pub fn clone_in<B: Allocator>(self: &Vec<T, A>, b: B) -> Vec<T, B> {\n");
        buf_str(out, c"        let s = self.as_slice();\n");
        buf_str(out, c"        let mut v: Vec<T, B> = Vec::with_capacity_in(s.len, b);\n");
        buf_str(out, c"        for i in 0..s.len {\n");
        buf_str(out, c"            v.push(clone_of(&s[i]));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Clone for Buf<A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn clone(self: &Buf<A>) -> Buf<A> {\n");
        buf_str(out, c"        let mut b: Buf<A> = Buf::new_in(self.bytes.alloc);\n");
        buf_str(out, c"        b.push_str(self.as_slice());\n");
        buf_str(out, c"        b\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A new map of clones of the entries.\n");
        buf_str(out, c"impl<K: Hash + Eq + Clone, V: Clone, A: Allocator> Clone for HashMap<K, V, A> {\n");
        buf_str(out, c"    fn clone(self: &HashMap<K, V, A>) -> HashMap<K, V, A> {\n");
        buf_str(out, c"        let mut m: HashMap<K, V, A> = HashMap::new_in(self.alloc);\n");
        buf_str(out, c"        for i in 0..self.slots() {\n");
        buf_str(out, c"            if let Option::Some(k) = self.key_at(i) {\n");
        buf_str(out, c"                let v = self.value_at(i).unwrap();\n");
        buf_str(out, c"                m.insert(clone_of(&k), clone_of(&v));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        m\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Clone> Clone for Option<T> {\n");
        buf_str(out, c"    fn clone(self: &Option<T>) -> Option<T> {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            Option::Some(x) => Option::Some(clone_of(&x)),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Clone, E: Clone> Clone for Result<T, E> {\n");
        buf_str(out, c"    fn clone(self: &Result<T, E>) -> Result<T, E> {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            Result::Ok(x) => Result::Ok(clone_of(&x)),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(clone_of(&e)),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- == on Vec (0.15) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// `==` compares contents, as Rust's: Vecs element by element (so a Buf,\n");
        buf_str(out, c"// whose bytes are a Vec, by bytes), maps by their entries in any order.\n");
        buf_str(out, c"// Whether two values are the same Vec: `a.as_slice().ptr == b.as_slice().ptr`.\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Eq, A: Allocator> Eq for Vec<T, A> {\n");
        buf_str(out, c"    fn eq(self: &Vec<T, A>, other: &Vec<T, A>) -> bool {\n");
        buf_str(out, c"        self.as_slice() == other.as_slice()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- == on HashMap (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Hash + Eq, V: Eq, A: Allocator> Eq for HashMap<K, V, A> {\n");
        buf_str(out, c"    fn eq(self: &HashMap<K, V, A>, other: &HashMap<K, V, A>) -> bool {\n");
        buf_str(out, c"        if self.len() != other.len() {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for i in 0..self.slots() {\n");
        buf_str(out, c"            if let Option::Some(k) = self.key_at(i) {\n");
        buf_str(out, c"                let v = self.value_at(i).unwrap();\n");
        buf_str(out, c"                match other.get(k) {\n");
        buf_str(out, c"                    Option::Some(w) => if !(v == w) { return false; },\n");
        buf_str(out, c"                    Option::None => return false,\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Clone, Eq, Ord and Hash without an impl (0.15) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// `x.clone()` on a type that copies (a number, bool, pointer, slice, fn,\n");
        buf_str(out, c"// fieldless enum, or a tuple or array of them) is copy_clone; `x.cmp(&y)`\n");
        buf_str(out, c"// on a float, pointer or fieldless enum is scalar_cmp; on a tuple of 2 to\n");
        buf_str(out, c"// 6 elements, `eq` (== when the structural one does not apply), `cmp` (<),\n");
        buf_str(out, c"// `hash` and `clone` are tupleN_eq, tupleN_cmp, tupleN_hash and\n");
        buf_str(out, c"// tupleN_clone (front/derive/intrinsic.tach). They are private: the\n");
        buf_str(out, c"// compiler calls them.\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn copy_clone<T>(self: &T) -> T {\n");
        buf_str(out, c"    *self\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn scalar_cmp<T>(self: &T, other: &T) -> i64 {\n");
        buf_str(out, c"    if *self < *other { -1 } else if *other < *self { 1 } else { 0 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) The traits a distinct type T has from its underlying type B\n");
        buf_str(out, c"// without an impl (front/check/distinct.tach): through a pointer to B,\n");
        buf_str(out, c"// which has T's representation (so the unsafe blocks are sound: `self`\n");
        buf_str(out, c"// and `other` are borrows, and the cast keeps what they point to; the\n");
        buf_str(out, c"// traits take `&Self`, 0.17).\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn distinct_eq<T, B: Eq>(self: &T, other: &T) -> bool {\n");
        buf_str(out, c"    unsafe { eq_of(&*(self as *B), &*(other as *B)) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn distinct_cmp<T, B: Ord>(self: &T, other: &T) -> i64 {\n");
        buf_str(out, c"    unsafe { cmp_of(&*(self as *B), &*(other as *B)) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn distinct_hash<T, B: Hash>(self: &T) -> u64 {\n");
        buf_str(out, c"    unsafe { hash_of(&*(self as *B)) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn distinct_clone<T, B: Clone>(self: &T) -> T {\n");
        buf_str(out, c"    unsafe { (&*(self as *B)).clone() as T }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn distinct_fmt<T, B: Display>(self: &T, f: &mut Fmt) {\n");
        buf_str(out, c"    unsafe { (&*(self as *B)).fmt(f); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn distinct_fmt_debug<T, B: Debug>(self: &T, f: &mut Fmt) {\n");
        buf_str(out, c"    unsafe { (&*(self as *B)).fmt_debug(f); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple2_cmp<A: Ord, B: Ord>(self: &(A, B), other: &(A, B)) -> i64 {\n");
        buf_str(out, c"    let c = cmp_of(&(*self).0, &(*other).0);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    cmp_of(&(*self).1, &(*other).1)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple3_cmp<A: Ord, B: Ord, C: Ord>(self: &(A, B, C), other: &(A, B, C)) -> i64 {\n");
        buf_str(out, c"    let mut c = cmp_of(&(*self).0, &(*other).0);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).1, &(*other).1);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    cmp_of(&(*self).2, &(*other).2)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple4_cmp<A: Ord, B: Ord, C: Ord,\n");
        buf_str(out, c"    D: Ord>(self: &(A, B, C, D), other: &(A, B, C, D)) -> i64 {\n");
        buf_str(out, c"    let mut c = cmp_of(&(*self).0, &(*other).0);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).1, &(*other).1);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).2, &(*other).2);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    cmp_of(&(*self).3, &(*other).3)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple5_cmp<A: Ord, B: Ord, C: Ord, D: Ord, E: Ord>(self: &(A, B, C, D, E),\n");
        buf_str(out, c"    other: &(A, B, C, D, E)) -> i64 {\n");
        buf_str(out, c"    let mut c = cmp_of(&(*self).0, &(*other).0);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).1, &(*other).1);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).2, &(*other).2);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).3, &(*other).3);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    cmp_of(&(*self).4, &(*other).4)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple6_cmp<A: Ord, B: Ord, C: Ord, D: Ord, E: Ord, F: Ord>(self: &(A, B, C, D, E, F),\n");
        buf_str(out, c"    other: &(A, B, C, D, E, F)) -> i64 {\n");
        buf_str(out, c"    let mut c = cmp_of(&(*self).0, &(*other).0);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).1, &(*other).1);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).2, &(*other).2);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).3, &(*other).3);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).4, &(*other).4);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    cmp_of(&(*self).5, &(*other).5)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple2_eq<A: Eq, B: Eq>(self: &(A, B), other: &(A, B)) -> bool {\n");
        buf_str(out, c"    eq_of(&(*self).0, &(*other).0) && eq_of(&(*self).1, &(*other).1)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple3_eq<A: Eq, B: Eq, C: Eq>(self: &(A, B, C), other: &(A, B, C)) -> bool {\n");
        buf_str(out, c"    eq_of(&(*self).0, &(*other).0) && eq_of(&(*self).1, &(*other).1)\n");
        buf_str(out, c"        && eq_of(&(*self).2, &(*other).2)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple4_eq<A: Eq, B: Eq, C: Eq, D: Eq>(self: &(A, B, C, D), other: &(A, B, C, D)) -> bool {\n");
        buf_str(out, c"    eq_of(&(*self).0, &(*other).0) && eq_of(&(*self).1, &(*other).1)\n");
        buf_str(out, c"        && eq_of(&(*self).2, &(*other).2) && eq_of(&(*self).3, &(*other).3)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple5_eq<A: Eq, B: Eq, C: Eq, D: Eq, E: Eq>(self: &(A, B, C, D, E),\n");
        buf_str(out, c"    other: &(A, B, C, D, E)) -> bool {\n");
        buf_str(out, c"    eq_of(&(*self).0, &(*other).0) && eq_of(&(*self).1, &(*other).1)\n");
        buf_str(out, c"        && eq_of(&(*self).2, &(*other).2) && eq_of(&(*self).3, &(*other).3)\n");
        buf_str(out, c"        && eq_of(&(*self).4, &(*other).4)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple6_eq<A: Eq, B: Eq, C: Eq, D: Eq, E: Eq, F: Eq>(self: &(A, B, C, D, E, F),\n");
        buf_str(out, c"    other: &(A, B, C, D, E, F)) -> bool {\n");
        buf_str(out, c"    eq_of(&(*self).0, &(*other).0) && eq_of(&(*self).1, &(*other).1)\n");
        buf_str(out, c"        && eq_of(&(*self).2, &(*other).2) && eq_of(&(*self).3, &(*other).3)\n");
        buf_str(out, c"        && eq_of(&(*self).4, &(*other).4) && eq_of(&(*self).5, &(*other).5)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple2_hash<A: Hash, B: Hash>(self: &(A, B)) -> u64 {\n");
        buf_str(out, c"    hash_mix(hash_of(&(*self).0), hash_of(&(*self).1))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple3_hash<A: Hash, B: Hash, C: Hash>(self: &(A, B, C)) -> u64 {\n");
        buf_str(out, c"    let h = hash_mix(hash_of(&(*self).0), hash_of(&(*self).1));\n");
        buf_str(out, c"    hash_mix(h, hash_of(&(*self).2))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple4_hash<A: Hash, B: Hash, C: Hash, D: Hash>(self: &(A, B, C, D)) -> u64 {\n");
        buf_str(out, c"    let mut h = hash_mix(hash_of(&(*self).0), hash_of(&(*self).1));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(&(*self).2));\n");
        buf_str(out, c"    hash_mix(h, hash_of(&(*self).3))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple5_hash<A: Hash, B: Hash, C: Hash, D: Hash, E: Hash>(self: &(A, B, C, D, E)) -> u64 {\n");
        buf_str(out, c"    let mut h = hash_mix(hash_of(&(*self).0), hash_of(&(*self).1));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(&(*self).2));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(&(*self).3));\n");
        buf_str(out, c"    hash_mix(h, hash_of(&(*self).4))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple6_hash<A: Hash, B: Hash, C: Hash, D: Hash, E: Hash, F: Hash>(\n");
        buf_str(out, c"    self: &(A, B, C, D, E, F)) -> u64 {\n");
        buf_str(out, c"    let mut h = hash_mix(hash_of(&(*self).0), hash_of(&(*self).1));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(&(*self).2));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(&(*self).3));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(&(*self).4));\n");
        buf_str(out, c"    hash_mix(h, hash_of(&(*self).5))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple2_clone<A: Clone, B: Clone>(self: &(A, B)) -> (A, B) {\n");
        buf_str(out, c"    (clone_of(&(*self).0), clone_of(&(*self).1))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple3_clone<A: Clone, B: Clone, C: Clone>(self: &(A, B, C)) -> (A, B, C) {\n");
        buf_str(out, c"    (clone_of(&(*self).0), clone_of(&(*self).1), clone_of(&(*self).2))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple4_clone<A: Clone, B: Clone, C: Clone, D: Clone>(self: &(A, B, C, D)) -> (A, B, C, D) {\n");
        buf_str(out, c"    (clone_of(&(*self).0), clone_of(&(*self).1), clone_of(&(*self).2), clone_of(&(*self).3))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple5_clone<A: Clone, B: Clone, C: Clone, D: Clone, E: Clone>(self: &(A, B, C, D, E))\n");
        buf_str(out, c"    -> (A, B, C, D, E) {\n");
        buf_str(out, c"    (clone_of(&(*self).0), clone_of(&(*self).1), clone_of(&(*self).2), clone_of(&(*self).3),\n");
        buf_str(out, c"        clone_of(&(*self).4))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple6_clone<A: Clone, B: Clone, C: Clone, D: Clone, E: Clone, F: Clone>(\n");
        buf_str(out, c"    self: &(A, B, C, D, E, F)) -> (A, B, C, D, E, F) {\n");
        buf_str(out, c"    (clone_of(&(*self).0), clone_of(&(*self).1), clone_of(&(*self).2), clone_of(&(*self).3),\n");
        buf_str(out, c"        clone_of(&(*self).4), clone_of(&(*self).5))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Allocation (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Memory comes from allocators: a type implementing Allocator. Containers\n");
        buf_str(out, c"// carry theirs as a type parameter (`Vec<T, A: Allocator = Gpa>`), so an\n");
        buf_str(out, c"// allocation is a call std can see, and effects name it (`alloc(Gpa)`).\n");
        buf_str(out, c"// Allocation is explicit: nothing allocates without being given an\n");
        buf_str(out, c"// allocator, `Vec::new_in(a)`, `collect_in(a)`, `format_in(x, a)`. Gpa,\n");
        buf_str(out, c"// the general-purpose allocator (C's malloc), is the type parameters'\n");
        buf_str(out, c"// default, and a program has one when its main takes it (`gpa: Gpa`, its\n");
        buf_str(out, c"// parameter), passed down as a parameter.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Sizes and alignments are in bytes; an alignment is a power of two from 1\n");
        buf_str(out, c"// to 4096. Running out of memory, or misusing an allocator, stops the\n");
        buf_str(out, c"// program (exit 101): part of the effect `alloc`, not `panic`. A size\n");
        buf_str(out, c"// above ALLOC_LIMIT (2^62 bytes) is out of memory.\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub trait Allocator {\n");
        buf_str(out, c"    // size bytes aligned to align, null when out of memory; size 0: aligned,\n");
        buf_str(out, c"    // non-null, unreadable.\n");
        buf_str(out, c"    #[effects(alloc, global, panic, diverge, unsafe)]\n");
        buf_str(out, c"    fn try_alloc(self: *Self, size: i64, align: i64) -> *u8;\n");
        buf_str(out, c"    // p (old_size bytes, from this allocator) as new_size bytes, the first\n");
        buf_str(out, c"    // min(old_size, new_size) kept; may move; null: p is left as it was.\n");
        buf_str(out, c"    #[effects(alloc, global, panic, diverge, unsafe)]\n");
        buf_str(out, c"    unsafe fn try_resize(self: *Self, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8;\n");
        buf_str(out, c"    // Gives back p (size bytes, from this allocator).\n");
        buf_str(out, c"    #[effects(alloc, global, panic, diverge, unsafe)]\n");
        buf_str(out, c"    unsafe fn free(self: *Self, p: *u8, size: i64, align: i64);\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // try_alloc, stopping the program when out of memory.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn alloc(self: *Self, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        let p = self.try_alloc(size, align);\n");
        buf_str(out, c"        if p == 0 as *u8 {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        p\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // try_resize, stopping the program when out of memory.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn resize(self: *Self, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        let q = self.try_resize(p, old_size, new_size, align);\n");
        buf_str(out, c"        if q == 0 as *u8 {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        q\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What the try_ functions of containers return when out of memory\n");
        buf_str(out, c"// (`v.try_push(x)`, `v.try_reserve(n)`).\n");
        buf_str(out, c"pub enum AllocError { OutOfMemory }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for AllocError {\n");
        buf_str(out, c"    fn fmt(self: &AllocError, f: &mut Fmt) {\n");
        buf_str(out, c"        f.str(\"out of memory\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for AllocError {\n");
        buf_str(out, c"    fn fmt_debug(self: &AllocError, f: &mut Fmt) {\n");
        buf_str(out, c"        f.str(\"OutOfMemory\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The largest allocation: 2^62 bytes (a size above it is out of memory).\n");
        buf_str(out, c"pub const ALLOC_LIMIT: i64 = 4611686018427387904;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Stops the program: an allocator is out of memory.\n");
        buf_str(out, c"#[cold]\n");
        buf_str(out, c"fn out_of_memory() -> ! {\n");
        buf_str(out, c"    unsafe { panic(c\"out of memory\") }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// n elements of `size` bytes, in bytes; -1 when n is negative or that is\n");
        buf_str(out, c"// above ALLOC_LIMIT.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn alloc_bytes(n: i64, size: i64) -> i64 {\n");
        buf_str(out, c"    if n < 0 || size > 0 && n > ALLOC_LIMIT / size {\n");
        buf_str(out, c"        return -1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    n * size\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The capacity a container grows to from cap for at least need elements:\n");
        buf_str(out, c"// twice cap (4 at least), or need when that is more.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn grown_cap(cap: i64, need: i64) -> i64 {\n");
        buf_str(out, c"    let twice = if cap == 0 { 4 } else if cap < ALLOC_LIMIT / 2 { cap * 2 } else { ALLOC_LIMIT };\n");
        buf_str(out, c"    if twice < need { need } else { twice }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Gpa ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The general-purpose allocator: C's malloc, realloc and free (its\n");
        buf_str(out, c"// implementation follows std's source: gpa.tach, or the checking one of\n");
        buf_str(out, c"// --check-alloc). Zero-sized, copied freely: a Vec<T> on it is three\n");
        buf_str(out, c"// words. Sealed: only the runtime's entry makes one, main's parameter\n");
        buf_str(out, c"// `gpa: Gpa`; a static cannot hold one (no constant makes one), so a\n");
        buf_str(out, c"// program keeps its containers in main and passes them down.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct Gpa {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Arenas (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An arena: allocations bump a pointer through chunks taken from Gpa, and\n");
        buf_str(out, c"// are given back all at once: when a scope ends (`a.scope(|s| ...)`,\n");
        buf_str(out, c"// `arena_scope(gpa, |s| ...)`), or by `reset` and `free_all` (unsafe: what\n");
        buf_str(out, c"// was allocated must not be used after). A request above 32 KB gets a\n");
        buf_str(out, c"// chunk of its own; the last block grows and shrinks in place; `free`\n");
        buf_str(out, c"// gives back the last block, and a chunk of its own. A handle: copies\n");
        buf_str(out, c"// share the arena. `Arena::none()`, a constant (for statics), has no\n");
        buf_str(out, c"// memory: allocating from it stops the program.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// (--check-alloc, CHECK_ALLOC: each block is on pages of its own from the\n");
        buf_str(out, c"// checking Gpa, its owner the arena's state; the bump keeps the\n");
        buf_str(out, c"// accounting, so `used` and exhaustion are as without; a block given back\n");
        buf_str(out, c"// (free, a move, a reset, a scope's end, free_all) loses its pages.)\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct Arena { s: *ArenaState }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A chunk of an arena's memory, from Gpa: this header, then its bytes (the\n");
        buf_str(out, c"// first chunk's start with the arena's state).\n");
        buf_str(out, c"struct ArenaChunk { next: *ArenaChunk, size: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A block of its own (a request above ARENA_LARGE): this header, at\n");
        buf_str(out, c"// arena_large_head(align) bytes before the block, in a list both ways.\n");
        buf_str(out, c"struct ArenaLarge { next: *ArenaLarge, prev: *ArenaLarge, size: i64, align: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The state of an arena, in its first chunk, or of a scope, on the stack\n");
        buf_str(out, c"// of the scope's function. Addresses are i64s; ptr..limit is where the\n");
        buf_str(out, c"// next block goes (limit is 0 while the arena is lent to a scope).\n");
        buf_str(out, c"struct ArenaState {\n");
        buf_str(out, c"    ptr: i64,\n");
        buf_str(out, c"    limit: i64,\n");
        buf_str(out, c"    // the current chunk, its first byte and its end\n");
        buf_str(out, c"    chunk: *ArenaChunk,\n");
        buf_str(out, c"    start: i64,\n");
        buf_str(out, c"    end: i64,\n");
        buf_str(out, c"    // the last block (it grows in place), -1: none\n");
        buf_str(out, c"    last: i64,\n");
        buf_str(out, c"    // the bytes used in the chunks before the current one\n");
        buf_str(out, c"    before: i64,\n");
        buf_str(out, c"    lent: bool,\n");
        buf_str(out, c"    // the arena's own state (itself for an Arena; for a scope, its arena's)\n");
        buf_str(out, c"    root: *ArenaState,\n");
        buf_str(out, c"    // a scope's: the arena's blocks of their own when it started\n");
        buf_str(out, c"    large_mark: *ArenaLarge,\n");
        buf_str(out, c"    // the root's: its chunks, its blocks of their own, the bytes of these,\n");
        buf_str(out, c"    // the bytes taken from Gpa, the size of the next chunk\n");
        buf_str(out, c"    first: *ArenaChunk,\n");
        buf_str(out, c"    large: *ArenaLarge,\n");
        buf_str(out, c"    large_bytes: i64,\n");
        buf_str(out, c"    chunk_bytes: i64,\n");
        buf_str(out, c"    next_size: i64,\n");
        buf_str(out, c"    // a scope's, with --check-alloc: the checking Gpa's blocks when it\n");
        buf_str(out, c"    // started (check_alloc_mark)\n");
        buf_str(out, c"    check_mark: i64,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Requests above this get a chunk of their own.\n");
        buf_str(out, c"const ARENA_LARGE: i64 = 32768;\n");
        buf_str(out, c"// The first chunk's bytes (Arena::new_in), the first next chunk's (a\n");
        buf_str(out, c"// request up to ARENA_LARGE, aligned, fits in any), the largest.\n");
        buf_str(out, c"const ARENA_FIRST: i64 = 8192;\n");
        buf_str(out, c"const ARENA_NEXT: i64 = 65536;\n");
        buf_str(out, c"const ARENA_MAX_CHUNK: i64 = 4194304;\n");
        buf_str(out, c"const ARENA_CHUNK_HEAD: i64 = 16;\n");
        buf_str(out, c"const ARENA_ALIGN_MAX: i64 = 4096;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A block's bytes from state s: the bump (an Arena's and a ScopedArena's\n");
        buf_str(out, c"// try_alloc), inlined where they are called; the rest (a new chunk, a\n");
        buf_str(out, c"// block of its own, Arena::none(), a lent arena) out of line and cold.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn arena_alloc(s: *ArenaState, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        if s != 0 as *ArenaState {\n");
        buf_str(out, c"            let p = (s.ptr + align - 1) & -align;\n");
        buf_str(out, c"            let e = p + size;\n");
        buf_str(out, c"            if (size as u64) <= (ARENA_LARGE as u64) && p >= s.ptr && e <= s.limit {\n");
        buf_str(out, c"                s.ptr = e;\n");
        buf_str(out, c"                s.last = p;\n");
        buf_str(out, c"                if CHECK_ALLOC {\n");
        buf_str(out, c"                    // (the block's own pages; the bump keeps the count)\n");
        buf_str(out, c"                    return check_alloc_block(s.root as u64, size, align);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return p as *u8;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        arena_alloc_slow(s, size, align)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether align is an alignment: a power of two from 1 to 4096.\n");
        buf_str(out, c"fn arena_align_ok(align: i64) -> bool {\n");
        buf_str(out, c"    align >= 1 && align <= ARENA_ALIGN_MAX && (align & (align - 1)) == 0\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// arena_alloc when the bump does not fit: a block of its own, or the next\n");
        buf_str(out, c"// chunk (a new one when there is none).\n");
        buf_str(out, c"#[cold]\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"unsafe fn arena_alloc_slow(s: *ArenaState, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    arena_usable(s);\n");
        buf_str(out, c"    if size < 0 || size > ALLOC_LIMIT || !arena_align_ok(align) {\n");
        buf_str(out, c"        return 0 as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if size > ARENA_LARGE {\n");
        buf_str(out, c"        return arena_large_alloc(s.root, size, align);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut c = s.chunk.next;\n");
        buf_str(out, c"    if c == 0 as *ArenaChunk {\n");
        buf_str(out, c"        c = arena_new_chunk(s.root, s.chunk);\n");
        buf_str(out, c"        if c == 0 as *ArenaChunk {\n");
        buf_str(out, c"            return 0 as *u8;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    s.before += s.ptr - s.start;\n");
        buf_str(out, c"    s.chunk = c;\n");
        buf_str(out, c"    s.start = c as i64 + ARENA_CHUNK_HEAD;\n");
        buf_str(out, c"    s.end = c as i64 + c.size;\n");
        buf_str(out, c"    s.limit = s.end;\n");
        buf_str(out, c"    s.ptr = s.start;\n");
        buf_str(out, c"    s.last = -1;\n");
        buf_str(out, c"    // (a request up to ARENA_LARGE, aligned, fits in any next chunk)\n");
        buf_str(out, c"    arena_alloc(s, size, align)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Stops the program unless s is an arena that can allocate: not\n");
        buf_str(out, c"// Arena::none(), not lent to a scope.\n");
        buf_str(out, c"unsafe fn arena_usable(s: *ArenaState) {\n");
        buf_str(out, c"    if s == 0 as *ArenaState {\n");
        buf_str(out, c"        panic(c\"the arena has no memory: it is Arena::none()\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if s.lent {\n");
        buf_str(out, c"        panic(c\"the arena is lent to a scope: allocate from the scope's arena\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A new chunk from Gpa, after chunk `after` in root's list; null when out\n");
        buf_str(out, c"// of memory.\n");
        buf_str(out, c"unsafe fn arena_new_chunk(root: *ArenaState, after: *ArenaChunk) -> *ArenaChunk {\n");
        buf_str(out, c"    let size = root.next_size;\n");
        buf_str(out, c"    let g = Gpa {};\n");
        buf_str(out, c"    let c = g.try_alloc(size, 16) as *ArenaChunk;\n");
        buf_str(out, c"    if c == 0 as *ArenaChunk {\n");
        buf_str(out, c"        return c;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    c.size = size;\n");
        buf_str(out, c"    c.next = after.next;\n");
        buf_str(out, c"    after.next = c;\n");
        buf_str(out, c"    root.chunk_bytes += size;\n");
        buf_str(out, c"    if size < ARENA_MAX_CHUNK {\n");
        buf_str(out, c"        root.next_size = size * 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    c\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The bytes of a block of its own before it: its header, or the\n");
        buf_str(out, c"// alignment when that is more.\n");
        buf_str(out, c"fn arena_large_head(align: i64) -> i64 {\n");
        buf_str(out, c"    if align > 32 { align } else { 32 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A block of its own of size bytes from Gpa, at the front of root's list.\n");
        buf_str(out, c"unsafe fn arena_large_alloc(root: *ArenaState, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    let head = arena_large_head(align);\n");
        buf_str(out, c"    let g = Gpa {};\n");
        buf_str(out, c"    let c = g.try_alloc(head + size, if align > 16 { align } else { 16 });\n");
        buf_str(out, c"    if c == 0 as *u8 {\n");
        buf_str(out, c"        return c;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let p = &c[head];\n");
        buf_str(out, c"    let h = (&p[-32]) as *ArenaLarge;\n");
        buf_str(out, c"    h.size = size;\n");
        buf_str(out, c"    h.align = align;\n");
        buf_str(out, c"    h.prev = 0 as *ArenaLarge;\n");
        buf_str(out, c"    h.next = root.large;\n");
        buf_str(out, c"    if root.large != 0 as *ArenaLarge {\n");
        buf_str(out, c"        root.large.prev = h;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    root.large = h;\n");
        buf_str(out, c"    root.large_bytes += size;\n");
        buf_str(out, c"    root.chunk_bytes += head + size;\n");
        buf_str(out, c"    p\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Gives back block p, of its own, of root.\n");
        buf_str(out, c"unsafe fn arena_large_free(root: *ArenaState, p: *u8) {\n");
        buf_str(out, c"    let h = (&p[-32]) as *ArenaLarge;\n");
        buf_str(out, c"    let head = arena_large_head(h.align);\n");
        buf_str(out, c"    if h.prev == 0 as *ArenaLarge {\n");
        buf_str(out, c"        root.large = h.next;\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        h.prev.next = h.next;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if h.next != 0 as *ArenaLarge {\n");
        buf_str(out, c"        h.next.prev = h.prev;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    root.large_bytes -= h.size;\n");
        buf_str(out, c"    root.chunk_bytes -= head + h.size;\n");
        buf_str(out, c"    let g = Gpa {};\n");
        buf_str(out, c"    g.free(&p[-head], head + h.size, if h.align > 16 { h.align } else { 16 });\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Gives back the blocks of their own of root down to `mark` (the list's\n");
        buf_str(out, c"// front when a scope started), or all of them.\n");
        buf_str(out, c"unsafe fn arena_large_free_to(root: *ArenaState, mark: *ArenaLarge) {\n");
        buf_str(out, c"    for _ in 0..ALLOC_LIMIT {\n");
        buf_str(out, c"        let h = root.large;\n");
        buf_str(out, c"        if h == mark {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        arena_large_free(root, &(h as *u8)[32]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An Arena's or a ScopedArena's try_resize: the last block in place, a\n");
        buf_str(out, c"// block of its own with Gpa's resize, else moved.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn arena_resize(s: *ArenaState, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"    -> *u8 {\n");
        buf_str(out, c"    if CHECK_ALLOC {\n");
        buf_str(out, c"        return arena_resize_checked(s, p, old_size, new_size, align);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if s != 0 as *ArenaState && p as i64 == s.last && (new_size as u64) <= (ARENA_LARGE as u64)\n");
        buf_str(out, c"        && old_size <= ARENA_LARGE && p as i64 + new_size <= s.limit {\n");
        buf_str(out, c"        s.ptr = p as i64 + new_size;\n");
        buf_str(out, c"        return p;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    arena_resize_slow(s, p, old_size, new_size, align)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[cold]\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"unsafe fn arena_resize_slow(s: *ArenaState, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"    -> *u8 {\n");
        buf_str(out, c"    arena_usable(s);\n");
        buf_str(out, c"    if new_size < 0 || new_size > ALLOC_LIMIT || !arena_align_ok(align) {\n");
        buf_str(out, c"        return 0 as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if old_size > ARENA_LARGE && new_size > ARENA_LARGE {\n");
        buf_str(out, c"        // (a block of its own stays one: resized by Gpa, relinked)\n");
        buf_str(out, c"        let root = s.root;\n");
        buf_str(out, c"        let h = (&p[-32]) as *ArenaLarge;\n");
        buf_str(out, c"        let head = arena_large_head(align);\n");
        buf_str(out, c"        let g = Gpa {};\n");
        buf_str(out, c"        let c = g.try_resize(&p[-head], head + old_size, head + new_size,\n");
        buf_str(out, c"            if align > 16 { align } else { 16 });\n");
        buf_str(out, c"        if c == 0 as *u8 {\n");
        buf_str(out, c"            return c;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let q = &c[head];\n");
        buf_str(out, c"        let k = (&q[-32]) as *ArenaLarge;\n");
        buf_str(out, c"        if k.prev == 0 as *ArenaLarge {\n");
        buf_str(out, c"            root.large = k;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            k.prev.next = k;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k.next != 0 as *ArenaLarge {\n");
        buf_str(out, c"            k.next.prev = k;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        k.size = new_size;\n");
        buf_str(out, c"        root.large_bytes += new_size - old_size;\n");
        buf_str(out, c"        root.chunk_bytes += new_size - old_size;\n");
        buf_str(out, c"        return q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let q = arena_alloc(s, new_size, align);\n");
        buf_str(out, c"    if q == 0 as *u8 {\n");
        buf_str(out, c"        return q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let n = if old_size < new_size { old_size } else { new_size };\n");
        buf_str(out, c"    if n > 0 {\n");
        buf_str(out, c"        memcpy(q, p, n as u64);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    arena_free(s, p, old_size);\n");
        buf_str(out, c"    q\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// arena_resize with --check-alloc: the last block (the last live one of\n");
        buf_str(out, c"// the arena, as the bump's `last`) grows in place in the count and moves\n");
        buf_str(out, c"// to pages of its new size; any other as without.\n");
        buf_str(out, c"#[cold]\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"unsafe fn arena_resize_checked(s: *ArenaState, p: *u8, old_size: i64, new_size: i64,\n");
        buf_str(out, c"    align: i64) -> *u8 {\n");
        buf_str(out, c"    if s != 0 as *ArenaState && s.last != -1 && (new_size as u64) <= (ARENA_LARGE as u64)\n");
        buf_str(out, c"        && old_size <= ARENA_LARGE && s.last + new_size <= s.limit\n");
        buf_str(out, c"        && check_alloc_is_last(s.root as u64, p) {\n");
        buf_str(out, c"        let q = check_alloc_moved(s.root as u64, p, old_size, new_size, align);\n");
        buf_str(out, c"        if q != 0 as *u8 {\n");
        buf_str(out, c"            s.ptr = s.last + new_size;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    arena_resize_slow(s, p, old_size, new_size, align)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An Arena's or a ScopedArena's free: the last block goes back to the\n");
        buf_str(out, c"// bump, a block of its own to Gpa; any other waits for the arena's end.\n");
        buf_str(out, c"// Nothing while the arena is lent to a scope.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn arena_free(s: *ArenaState, p: *u8, size: i64) {\n");
        buf_str(out, c"    if s == 0 as *ArenaState || s.lent {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if size > ARENA_LARGE {\n");
        buf_str(out, c"        arena_large_free(s.root, p);\n");
        buf_str(out, c"    } else if CHECK_ALLOC {\n");
        buf_str(out, c"        // (the last live block of the arena is the bump's last; the block's\n");
        buf_str(out, c"        // pages go)\n");
        buf_str(out, c"        if s.last != -1 && check_alloc_is_last(s.root as u64, p) {\n");
        buf_str(out, c"            s.ptr = s.last;\n");
        buf_str(out, c"            s.last = -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        check_alloc_moved(s.root as u64, p, size, 0, 1);\n");
        buf_str(out, c"    } else if p as i64 == s.last {\n");
        buf_str(out, c"        s.ptr = s.last;\n");
        buf_str(out, c"        s.last = -1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The bytes allocated from state s (blocks of their own included).\n");
        buf_str(out, c"unsafe fn arena_used(s: *ArenaState) -> i64 {\n");
        buf_str(out, c"    s.before + s.ptr - s.start + s.root.large_bytes\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Allocator for Arena {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn try_alloc(self: *Arena, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        unsafe { arena_alloc(self.s, size, align) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn try_resize(self: *Arena, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        arena_resize(self.s, p, old_size, new_size, align)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn free(self: *Arena, p: *u8, size: i64, align: i64) {\n");
        buf_str(out, c"        arena_free(self.s, p, size);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arena {\n");
        buf_str(out, c"    // A new arena, its chunks from gpa: the first of 8 KB, the next\n");
        buf_str(out, c"    // ones twice as large each up to 4 MB.\n");
        buf_str(out, c"    pub fn new_in(gpa: Gpa) -> Arena {\n");
        buf_str(out, c"        Arena::with_capacity_in(ARENA_FIRST, gpa)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A new arena with room for `bytes` in its first chunk.\n");
        buf_str(out, c"    pub fn with_capacity_in(bytes: i64, gpa: Gpa) -> Arena {\n");
        buf_str(out, c"        let head = ARENA_CHUNK_HEAD + size_of(ArenaState);\n");
        buf_str(out, c"        let room = if bytes < 0 { 0 } else { bytes };\n");
        buf_str(out, c"        if room > ALLOC_LIMIT - head {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let size = head + room;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let c = gpa.alloc(size, 16) as *ArenaChunk;\n");
        buf_str(out, c"            c.next = 0 as *ArenaChunk;\n");
        buf_str(out, c"            c.size = size;\n");
        buf_str(out, c"            let s = (c as i64 + ARENA_CHUNK_HEAD) as *ArenaState;\n");
        buf_str(out, c"            s.start = c as i64 + head;\n");
        buf_str(out, c"            s.ptr = s.start;\n");
        buf_str(out, c"            s.end = c as i64 + size;\n");
        buf_str(out, c"            s.limit = s.end;\n");
        buf_str(out, c"            s.chunk = c;\n");
        buf_str(out, c"            s.last = -1;\n");
        buf_str(out, c"            s.before = 0;\n");
        buf_str(out, c"            s.lent = false;\n");
        buf_str(out, c"            s.root = s;\n");
        buf_str(out, c"            s.large_mark = 0 as *ArenaLarge;\n");
        buf_str(out, c"            s.first = c;\n");
        buf_str(out, c"            s.large = 0 as *ArenaLarge;\n");
        buf_str(out, c"            s.large_bytes = 0;\n");
        buf_str(out, c"            s.chunk_bytes = size;\n");
        buf_str(out, c"            s.next_size = ARENA_NEXT;\n");
        buf_str(out, c"            s.check_mark = 0;\n");
        buf_str(out, c"            Arena { s: s }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An arena that has no memory, a constant (for statics: `static mut\n");
        buf_str(out, c"    // V: Vec<i64, Arena> = Vec::new_in(Arena::none());`, set up in main\n");
        buf_str(out, c"    // with `Arena::new_in(gpa)`). Allocating from it stops the program.\n");
        buf_str(out, c"    pub fn none() -> Arena {\n");
        buf_str(out, c"        Arena { s: 0 as *ArenaState }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The bytes allocated from the arena since it was made or reset.\n");
        buf_str(out, c"    pub fn used(self: &Arena) -> i64 {\n");
        buf_str(out, c"        if self.s == 0 as *ArenaState { 0 } else { unsafe { arena_used(self.s) } }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The bytes the arena holds from Gpa: its chunks and blocks.\n");
        buf_str(out, c"    pub fn chunk_bytes(self: &Arena) -> i64 {\n");
        buf_str(out, c"        if self.s == 0 as *ArenaState { 0 } else { unsafe { self.s.chunk_bytes } }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Everything allocated from the arena is given back; its chunks are\n");
        buf_str(out, c"    // kept (blocks of their own go back to Gpa). Unsafe: what was\n");
        buf_str(out, c"    // allocated must not be used after.\n");
        buf_str(out, c"    pub unsafe fn reset(self: *Arena) {\n");
        buf_str(out, c"        let s = self.s;\n");
        buf_str(out, c"        if s == 0 as *ArenaState {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        arena_usable(s);\n");
        buf_str(out, c"        arena_large_free_to(s, 0 as *ArenaLarge);\n");
        buf_str(out, c"        if CHECK_ALLOC {\n");
        buf_str(out, c"            check_alloc_release(s as u64, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let c = s.first;\n");
        buf_str(out, c"        s.chunk = c;\n");
        buf_str(out, c"        s.start = c as i64 + ARENA_CHUNK_HEAD + size_of(ArenaState);\n");
        buf_str(out, c"        s.ptr = s.start;\n");
        buf_str(out, c"        s.end = c as i64 + c.size;\n");
        buf_str(out, c"        s.limit = s.end;\n");
        buf_str(out, c"        s.last = -1;\n");
        buf_str(out, c"        s.before = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The arena's memory, chunks included, given back to Gpa; this handle\n");
        buf_str(out, c"    // becomes Arena::none(). Unsafe: nothing allocated from it, and no\n");
        buf_str(out, c"    // copy of the handle, may be used after.\n");
        buf_str(out, c"    pub unsafe fn free_all(self: *Arena) {\n");
        buf_str(out, c"        let s = self.s;\n");
        buf_str(out, c"        if s == 0 as *ArenaState {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        arena_usable(s);\n");
        buf_str(out, c"        arena_large_free_to(s, 0 as *ArenaLarge);\n");
        buf_str(out, c"        if CHECK_ALLOC {\n");
        buf_str(out, c"            check_alloc_release(s as u64, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let g = Gpa {};\n");
        buf_str(out, c"        let mut c = s.first.next;\n");
        buf_str(out, c"        for _ in 0..ALLOC_LIMIT {\n");
        buf_str(out, c"            if c == 0 as *ArenaChunk {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let next = c.next;\n");
        buf_str(out, c"            g.free(c as *u8, c.size, 16);\n");
        buf_str(out, c"            c = next;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let first = s.first;\n");
        buf_str(out, c"        g.free(first as *u8, first.size, 16);\n");
        buf_str(out, c"        self.s = 0 as *ArenaState;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // f with a scope of this arena: what f allocates from the ScopedArena\n");
        buf_str(out, c"    // it is given is given back when f returns. The arena is lent\n");
        buf_str(out, c"    // meanwhile: allocating from it stops the program. Nothing on the\n");
        buf_str(out, c"    // ScopedArena can leave f (#[scoped]).\n");
        buf_str(out, c"    pub fn scope<R, F: FnMut(ScopedArena) -> R>(self: &Arena, f: F) -> R {\n");
        buf_str(out, c"        unsafe { arena_scope_of(self.s, f) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An arena lent to a scope (arena_scope, Arena::scope): what is allocated\n");
        buf_str(out, c"// from it is given back when the scope ends, so nothing holding it can\n");
        buf_str(out, c"// leave the scope (#[scoped]: not returned, not captured by another\n");
        buf_str(out, c"// scope, not in a static).\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"#[scoped]\n");
        buf_str(out, c"pub struct ScopedArena { s: *ArenaState, mark: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Allocator for ScopedArena {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn try_alloc(self: *ScopedArena, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        unsafe { arena_alloc(self.s, size, align) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn try_resize(self: *ScopedArena, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"        -> *u8 {\n");
        buf_str(out, c"        arena_resize(self.s, p, old_size, new_size, align)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn free(self: *ScopedArena, p: *u8, size: i64, align: i64) {\n");
        buf_str(out, c"        arena_free(self.s, p, size);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl ScopedArena {\n");
        buf_str(out, c"    // The bytes allocated from this scope.\n");
        buf_str(out, c"    pub fn used(self: &ScopedArena) -> i64 {\n");
        buf_str(out, c"        unsafe { arena_used(self.s) - self.mark }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // f with a scope of this one (lent meanwhile), as Arena::scope.\n");
        buf_str(out, c"    pub fn scope<R, F: FnMut(ScopedArena) -> R>(self: &ScopedArena, f: F) -> R {\n");
        buf_str(out, c"        unsafe { arena_scope_of(self.s, f) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// f with a new arena, its chunks from gpa, given back when f returns.\n");
        buf_str(out, c"pub fn arena_scope<R, F: FnMut(ScopedArena) -> R>(gpa: Gpa, f: F) -> R {\n");
        buf_str(out, c"    let mut a = Arena::new_in(gpa);\n");
        buf_str(out, c"    // (arena_scope_of, not a.scope: the scoped check of a function passed\n");
        buf_str(out, c"    // by name is at the call of arena_scope, once)\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let r = arena_scope_of(a.s, f);\n");
        buf_str(out, c"        a.free_all();\n");
        buf_str(out, c"        r\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// f with a scope of the arena of state p: the scope's state starts where\n");
        buf_str(out, c"// p's is, p is lent (its limit 0) until f returns, then p's blocks of\n");
        buf_str(out, c"// their own made meanwhile go back.\n");
        buf_str(out, c"fn arena_scope_of<R, F: FnMut(ScopedArena) -> R>(p: *ArenaState, f: F) -> R {\n");
        buf_str(out, c"    let mut st = ArenaState {\n");
        buf_str(out, c"        ptr: 0, limit: 0, chunk: 0 as *ArenaChunk, start: 0, end: 0, last: -1, before: 0,\n");
        buf_str(out, c"        lent: false, root: 0 as *ArenaState, large_mark: 0 as *ArenaLarge,\n");
        buf_str(out, c"        first: 0 as *ArenaChunk, large: 0 as *ArenaLarge, large_bytes: 0, chunk_bytes: 0,\n");
        buf_str(out, c"        next_size: 0, check_mark: 0,\n");
        buf_str(out, c"    };\n");
        buf_str(out, c"    let mark = unsafe { arena_lend(p, &st) };\n");
        buf_str(out, c"    let site = if CHECK_ALLOC { check_alloc_site() } else { 0 as *u8 };\n");
        buf_str(out, c"    let mut g = f;\n");
        buf_str(out, c"    let r = g(ScopedArena { s: &st, mark: mark });\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        if CHECK_ALLOC {\n");
        buf_str(out, c"            check_alloc_set_site(site);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        arena_unlend(p, &st);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    r\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Lends the arena of state p to a scope of state st: st starts at p's\n");
        buf_str(out, c"// position, p is locked. Returns the bytes used at the start.\n");
        buf_str(out, c"unsafe fn arena_lend(p: *ArenaState, st: *ArenaState) -> i64 {\n");
        buf_str(out, c"    arena_usable(p);\n");
        buf_str(out, c"    st.ptr = p.ptr;\n");
        buf_str(out, c"    st.limit = p.limit;\n");
        buf_str(out, c"    st.chunk = p.chunk;\n");
        buf_str(out, c"    st.start = p.start;\n");
        buf_str(out, c"    st.end = p.end;\n");
        buf_str(out, c"    st.before = p.before;\n");
        buf_str(out, c"    st.root = p.root;\n");
        buf_str(out, c"    st.large_mark = p.root.large;\n");
        buf_str(out, c"    if CHECK_ALLOC {\n");
        buf_str(out, c"        st.check_mark = check_alloc_mark();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    p.lent = true;\n");
        buf_str(out, c"    p.limit = 0;\n");
        buf_str(out, c"    arena_used(st)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The scope of state st is over: its blocks of their own go back, and p,\n");
        buf_str(out, c"// where it was, is no longer lent (st's chunks are p's next ones).\n");
        buf_str(out, c"unsafe fn arena_unlend(p: *ArenaState, st: *ArenaState) {\n");
        buf_str(out, c"    arena_large_free_to(p.root, st.large_mark);\n");
        buf_str(out, c"    if CHECK_ALLOC {\n");
        buf_str(out, c"        // (the scope's blocks, and its scopes': p was locked meanwhile)\n");
        buf_str(out, c"        check_alloc_release(p.root as u64, st.check_mark);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    st.lent = true;\n");
        buf_str(out, c"    st.limit = 0;\n");
        buf_str(out, c"    p.lent = false;\n");
        buf_str(out, c"    p.limit = p.end;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- FixedBuf (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An allocator in a fixed buffer of bytes: `FixedBuf::new(mem[..])` over an\n");
        buf_str(out, c"// array or a Vec's view, which must outlive it (not checked). Blocks bump\n");
        buf_str(out, c"// through it; when it is full, try_alloc is null (out of memory). Its\n");
        buf_str(out, c"// first 16 bytes (from the first one aligned to 8) hold the bytes used and\n");
        buf_str(out, c"// the last block, so copies of the handle share them.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct FixedBuf { base: *u8, cap: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"const FIXED_HEAD: i64 = 16;\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Allocator for FixedBuf {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn try_alloc(self: *FixedBuf, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        // (self: the trait's raw `*Self`)\n");
        buf_str(out, c"        if unsafe { self.cap } == 0 || !arena_align_ok(align) {\n");
        buf_str(out, c"            return 0 as *u8;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let h = (&self.base[-FIXED_HEAD]) as *i64;\n");
        buf_str(out, c"            let b = self.base as i64;\n");
        buf_str(out, c"            let p = (b + h[0] + align - 1) & -align;\n");
        buf_str(out, c"            if size < 0 || size > ALLOC_LIMIT || p + size > b + self.cap {\n");
        buf_str(out, c"                return 0 as *u8;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            h[0] = p + size - b;\n");
        buf_str(out, c"            h[1] = p;\n");
        buf_str(out, c"            if CHECK_ALLOC {\n");
        buf_str(out, c"                // (the block's own pages; the bump keeps the count)\n");
        buf_str(out, c"                return check_alloc_block(self.base as u64, size, align);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            p as *u8\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn try_resize(self: *FixedBuf, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"        -> *u8 {\n");
        buf_str(out, c"        if self.cap == 0 || new_size < 0 || new_size > ALLOC_LIMIT {\n");
        buf_str(out, c"            return 0 as *u8;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let h = (&self.base[-FIXED_HEAD]) as *i64;\n");
        buf_str(out, c"        let b = self.base as i64;\n");
        buf_str(out, c"        if CHECK_ALLOC {\n");
        buf_str(out, c"            // (h[1] is the last block's place in the count; the block moves\n");
        buf_str(out, c"            // to pages of its new size)\n");
        buf_str(out, c"            let owner = self.base as u64;\n");
        buf_str(out, c"            if h[1] != -1 && h[1] + new_size <= b + self.cap && check_alloc_is_last(owner, p) {\n");
        buf_str(out, c"                let q = check_alloc_moved(owner, p, old_size, new_size, align);\n");
        buf_str(out, c"                if q != 0 as *u8 {\n");
        buf_str(out, c"                    h[0] = h[1] + new_size - b;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return q;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let q = self.try_alloc(new_size, align);\n");
        buf_str(out, c"            if q == 0 as *u8 {\n");
        buf_str(out, c"                return q;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let n = if old_size < new_size { old_size } else { new_size };\n");
        buf_str(out, c"            if n > 0 {\n");
        buf_str(out, c"                memcpy(q, p, n as u64);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            check_alloc_moved(owner, p, old_size, 0, align);\n");
        buf_str(out, c"            return q;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if p as i64 == h[1] && p as i64 + new_size <= b + self.cap {\n");
        buf_str(out, c"            h[0] = p as i64 + new_size - b;\n");
        buf_str(out, c"            return p;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let q = self.try_alloc(new_size, align);\n");
        buf_str(out, c"        if q == 0 as *u8 {\n");
        buf_str(out, c"            return q;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let n = if old_size < new_size { old_size } else { new_size };\n");
        buf_str(out, c"        if n > 0 {\n");
        buf_str(out, c"            memcpy(q, p, n as u64);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        q\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn free(self: *FixedBuf, p: *u8, size: i64, align: i64) {\n");
        buf_str(out, c"        if self.cap == 0 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let h = (&self.base[-FIXED_HEAD]) as *i64;\n");
        buf_str(out, c"        if CHECK_ALLOC {\n");
        buf_str(out, c"            let owner = self.base as u64;\n");
        buf_str(out, c"            if h[1] != -1 && check_alloc_is_last(owner, p) {\n");
        buf_str(out, c"                h[0] = h[1] - self.base as i64;\n");
        buf_str(out, c"                h[1] = -1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            check_alloc_moved(owner, p, size, 0, align);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if p as i64 == h[1] {\n");
        buf_str(out, c"            h[0] = p as i64 - self.base as i64;\n");
        buf_str(out, c"            h[1] = -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl FixedBuf {\n");
        buf_str(out, c"    // An allocator in mem (its first 16 bytes, from the first one aligned\n");
        buf_str(out, c"    // to 8, are its own; a smaller mem has no room).\n");
        buf_str(out, c"    pub fn new(mem: [u8]) -> FixedBuf {\n");
        buf_str(out, c"        let at = mem.ptr as i64;\n");
        buf_str(out, c"        let skip = ((at + 7) & -8) - at + FIXED_HEAD;\n");
        buf_str(out, c"        if mem.len <= skip {\n");
        buf_str(out, c"            return FixedBuf { base: 0 as *u8, cap: 0 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let base = &mem.ptr[skip];\n");
        buf_str(out, c"            let h = (&base[-FIXED_HEAD]) as *i64;\n");
        buf_str(out, c"            h[0] = 0;\n");
        buf_str(out, c"            h[1] = -1;\n");
        buf_str(out, c"            FixedBuf { base: base, cap: mem.len - skip }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The bytes allocated from it.\n");
        buf_str(out, c"    pub fn used(self: &FixedBuf) -> i64 {\n");
        buf_str(out, c"        if self.cap == 0 { 0 } else { unsafe { ((&self.base[-FIXED_HEAD]) as *i64)[0] } }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its bytes, for allocating from it again. Unsafe: what was allocated\n");
        buf_str(out, c"    // must not be used after.\n");
        buf_str(out, c"    pub unsafe fn reset(self: *FixedBuf) {\n");
        buf_str(out, c"        if self.cap != 0 {\n");
        buf_str(out, c"            let h = (&self.base[-FIXED_HEAD]) as *i64;\n");
        buf_str(out, c"            h[0] = 0;\n");
        buf_str(out, c"            h[1] = -1;\n");
        buf_str(out, c"            if CHECK_ALLOC {\n");
        buf_str(out, c"                check_alloc_release(self.base as u64, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- The ambient Gpa of 0.15 (0.16, until the corpus is migrated) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// std's ambient constructors of 0.15 (`Vec::new()`, `collect()`...),\n");
        buf_str(out, c"// errors outside std, take their Gpa here, until `fix --only alloc016`\n");
        buf_str(out, c"// migrates the corpus (front/ambient.tach): not `pub`, it goes with them.\n");
        buf_str(out, c"trait Ambient { fn ambient() -> Self; }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ambient for Gpa {\n");
        buf_str(out, c"    #[ambient(\"a 'gpa: Gpa' parameter, from main's\")]\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn ambient() -> Gpa { Gpa {} }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Panic and unreachable, the prelude's (0.17) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The prelude's `panic(message)`: prints `message` on stderr and exits\n");
        buf_str(out, c"// with 101, as a failed check does; safe (the message is a slice, not the\n");
        buf_str(out, c"// C string of `std::panic`).\n");
        buf_str(out, c"pub fn panic_str(message: [u8]) -> ! {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        panic_write(2, message.ptr, message.len as u64);\n");
        buf_str(out, c"        panic_write(2, c\"\\n\", 1);\n");
        buf_str(out, c"        panic_exit(101)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The prelude's `unreachable()`: a place the program never reaches;\n");
        buf_str(out, c"// reached, it prints \"entered unreachable code\" and exits with 101.\n");
        buf_str(out, c"pub fn unreachable() -> ! {\n");
        buf_str(out, c"    panic_str(\"entered unreachable code\")\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) The prelude's `assert(c)`: `c` must hold; when it does not, the\n");
        buf_str(out, c"// program prints `FILE:LINE:COL: assertion failed: 'c'` with the values\n");
        buf_str(out, c"// of c's operands and exits with 101. `assert(c, \"message\")` prints the\n");
        buf_str(out, c"// message instead of c. The compiler makes each call a check.\n");
        buf_str(out, c"pub fn assert(ok: bool, message: [u8] = \"\") {\n");
        buf_str(out, c"    if !ok {\n");
        buf_str(out, c"        panic_str(message)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) The prelude's `assert_eq(a, b)`: `assert(a == b)`, which reports\n");
        buf_str(out, c"// both values.\n");
        buf_str(out, c"pub fn assert_eq<T: Eq>(a: T, b: T) {\n");
        buf_str(out, c"    if !(a == b) {\n");
        buf_str(out, c"        unreachable()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) The prelude's `assert_ne(a, b)`: `assert(a != b)`.\n");
        buf_str(out, c"pub fn assert_ne<T: Eq>(a: T, b: T) {\n");
        buf_str(out, c"    if a == b {\n");
        buf_str(out, c"        unreachable()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) The prelude's `debug_assert(c)`: `assert(c)` in test builds\n");
        buf_str(out, c"// (`tachyonc test`, --debug-contracts); nothing (c is not evaluated) in\n");
        buf_str(out, c"// others.\n");
        buf_str(out, c"pub fn debug_assert(ok: bool, message: [u8] = \"\") {\n");
        buf_str(out, c"    if !ok {\n");
        buf_str(out, c"        panic_str(message)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// std's values section (0.17): appended to std's text after alloc.tach\n");
        buf_str(out, c"// (compiler/std/embed.sh).\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Values (0.17) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Mutable value semantics (docs/design/value-semantics.md): the prelude's\n");
        buf_str(out, c"// Drop, drop, forget, needs_drop and Copy; std::take and std::replace.\n");
        buf_str(out, c"// (0.17: values move and drop, front/own; std's containers implement Drop\n");
        buf_str(out, c"// with T4.)\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What a value does when its owner goes out of scope: `impl Drop for T`.\n");
        buf_str(out, c"// Calling `x.drop()` yourself is an error; `drop(x)` ends x early.\n");
        buf_str(out, c"pub trait Drop {\n");
        buf_str(out, c"    fn drop(self: &mut Self);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Consumes x: its drop runs here, not at the end of its scope.\n");
        buf_str(out, c"pub fn drop<T>(x: T) {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Consumes x without running its drop: a leak, which is safe\n");
        buf_str(out, c"// (`--check-alloc` lists it).\n");
        buf_str(out, c"pub fn forget<T>(x: T) {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether a value of type T has a drop to run (a constant, folded where\n");
        buf_str(out, c"// it is called).\n");
        buf_str(out, c"pub fn needs_drop<T>() -> bool {\n");
        buf_str(out, c"    false\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `T: Copy` holds when T is plain: `=` copies it (numbers, bool, raw\n");
        buf_str(out, c"// pointers, fieldless enums, and aggregates of those). No type implements\n");
        buf_str(out, c"// it with an impl block.\n");
        buf_str(out, c"pub trait Copy {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A type's empty value: what std::take leaves behind.\n");
        buf_str(out, c"pub trait Default {\n");
        buf_str(out, c"    fn default() -> Self;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Exchanges *a and *b. (Bit for bit, as replace: a write through a raw\n");
        buf_str(out, c"// pointer drops nothing, so neither value is dropped or copied.)\n");
        buf_str(out, c"pub fn swap<T>(a: &mut T, b: &mut T) {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let pa: *T = a;\n");
        buf_str(out, c"        let pb: *T = b;\n");
        buf_str(out, c"        let t = *pa;\n");
        buf_str(out, c"        *pa = *pb;\n");
        buf_str(out, c"        *pb = t;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The value at *dest, replaced by value. (The old value moves out and the\n");
        buf_str(out, c"// new one in, bit for bit: a write through a raw pointer drops nothing.)\n");
        buf_str(out, c"pub fn replace<T>(dest: &mut T, value: T) -> T {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let p: *T = dest;\n");
        buf_str(out, c"        let old = *p;\n");
        buf_str(out, c"        *p = value;\n");
        buf_str(out, c"        old\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The value at *dest, replaced by T's empty value (`std::take(&mut\n");
        buf_str(out, c"// self.count)`). A container's empty value needs its allocator: Vec, Buf\n");
        buf_str(out, c"// and HashMap have `take` methods, `self.keys.take()`, which keep it.\n");
        buf_str(out, c"pub fn take<T: Default>(dest: &mut T) -> T {\n");
        buf_str(out, c"    let empty: T = T::default();\n");
        buf_str(out, c"    replace(dest, empty)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The empty values: 0, false, None.\n");
        buf_str(out, c"impl Default for i8 { fn default() -> i8 { 0 } }\n");
        buf_str(out, c"impl Default for i16 { fn default() -> i16 { 0 } }\n");
        buf_str(out, c"impl Default for i32 { fn default() -> i32 { 0 } }\n");
        buf_str(out, c"impl Default for i64 { fn default() -> i64 { 0 } }\n");
        buf_str(out, c"impl Default for u8 { fn default() -> u8 { 0 } }\n");
        buf_str(out, c"impl Default for u16 { fn default() -> u16 { 0 } }\n");
        buf_str(out, c"impl Default for u32 { fn default() -> u32 { 0 } }\n");
        buf_str(out, c"impl Default for u64 { fn default() -> u64 { 0 } }\n");
        buf_str(out, c"impl Default for f32 { fn default() -> f32 { 0.0 } }\n");
        buf_str(out, c"impl Default for f64 { fn default() -> f64 { 0.0 } }\n");
        buf_str(out, c"impl Default for bool { fn default() -> bool { false } }\n");
        buf_str(out, c"impl<T> Default for Option<T> { fn default() -> Option<T> { Option::None } }\n");
        buf_str(out, c"// ---- Testing (0.18) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What `#[property]` tests and `#[fuzz]` targets draw their values from,\n");
        buf_str(out, c"// and the runtime of a test build (docs/design/contracts-verification.md\n");
        buf_str(out, c"// §2.6, §2.7, 0.18 T2). `tachyonc test` builds the program with\n");
        buf_str(out, c"// `--test-build`: the compiler (front/tests) writes a `main` that runs the\n");
        buf_str(out, c"// test its arguments name, and a generator for each property's\n");
        buf_str(out, c"// parameters, built from their types (an `impl Arbitrary` where there is\n");
        buf_str(out, c"// one). A value is drawn from a choice sequence of u64s, and smaller\n");
        buf_str(out, c"// choices make simpler values (0: 0, false, empty, None, the first\n");
        buf_str(out, c"// variant): a failing case is shrunk by shortening and lowering its\n");
        buf_str(out, c"// sequence, then replaying it. Generators take `&mut Gen` (0.17).\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A type's own generator, used in place of the structural one.\n");
        buf_str(out, c"pub trait Arbitrary {\n");
        buf_str(out, c"    fn arbitrary(g: &mut Gen) -> Self;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Gen {\n");
        buf_str(out, c"    choices: *u64, count: i64, at: i64, size: i64, gpa: Gpa, depth: i64,\n");
        buf_str(out, c"    showing: bool, report: i32, raw: bool,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Gen {\n");
        buf_str(out, c"    // An integer: 0, -1, 1, -2, 2, ... as the choice grows (the edges,\n");
        buf_str(out, c"    // i64::MIN and i64::MAX, are the largest choices).\n");
        buf_str(out, c"    pub fn int(self: &mut Gen) -> i64 {\n");
        buf_str(out, c"        let c = self.draw();\n");
        buf_str(out, c"        ((c >> 1) as i64) ^ -((c & 1) as i64)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An integer in lo..=hi (lo first).\n");
        buf_str(out, c"    pub fn int_in(self: &mut Gen, lo: i64, hi: i64) -> i64 {\n");
        buf_str(out, c"        let c = self.draw();\n");
        buf_str(out, c"        if hi <= lo {\n");
        buf_str(out, c"            return lo;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let span = (hi - lo) as u64 + 1;\n");
        buf_str(out, c"        if span == 0 {\n");
        buf_str(out, c"            return lo + c as i64;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        lo + (c % span) as i64\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // One of 0..n.\n");
        buf_str(out, c"    pub fn choose(self: &mut Gen, n: i64) -> i64 {\n");
        buf_str(out, c"        let c = self.draw();\n");
        buf_str(out, c"        if n <= 1 { 0 } else { (c % n as u64) as i64 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn bool(self: &mut Gen) -> bool {\n");
        buf_str(out, c"        self.draw() % 2 == 1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The size this case may grow to (it grows with the case number).\n");
        buf_str(out, c"    pub fn size(self: &mut Gen) -> i64 {\n");
        buf_str(out, c"        self.size\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A text byte: letters and digits first, then spaces, punctuation,\n");
        buf_str(out, c"    // newlines and the rest.\n");
        buf_str(out, c"    pub fn text_byte(self: &mut Gen) -> u8 {\n");
        buf_str(out, c"        let c = self.draw();\n");
        buf_str(out, c"        let common = \"abcdefghijklmnopqrstuvwxyz0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ\\n.,-_:;()+*/=\";\n");
        buf_str(out, c"        if c < 200 {\n");
        buf_str(out, c"            return common[(c % common.len as u64) as i64];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        (c % 256) as u8\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// x's `{:?}` text against tests/snapshots/MODULE__TEST__N.snap: a missing\n");
        buf_str(out, c"// file is written (a new snapshot, the test passes), a different one\n");
        buf_str(out, c"// fails with its first differing line; `tachyonc test --accept` writes\n");
        buf_str(out, c"// the current text.\n");
        buf_str(out, c"pub fn assert_snapshot<T: Debug>(x: T) {\n");
        buf_str(out, c"    let gpa = Gpa {};\n");
        buf_str(out, c"    TEST_SNAP_COUNT += 1;\n");
        buf_str(out, c"    let mut text = format_in(f\"{x:?}\", gpa);\n");
        buf_str(out, c"    text.push('\\n');\n");
        buf_str(out, c"    let mut path = Buf::new_in(gpa);\n");
        buf_str(out, c"    let mut shown = Buf::new_in(gpa);\n");
        buf_str(out, c"    if TEST_SNAPSHOTS != 0 as *u8 {\n");
        buf_str(out, c"        unsafe { path.push_cstr(TEST_SNAPSHOTS) };\n");
        buf_str(out, c"        path.push('/');\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        path.push_str(\"tests/\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    shown.push_str(\"tests/\");\n");
        buf_str(out, c"    path.push_str(\"snapshots\");\n");
        buf_str(out, c"    // (the tests directory, then its snapshots/)\n");
        buf_str(out, c"    let mut dir = Buf::new_in(gpa);\n");
        buf_str(out, c"    let at = path.len() - 10;\n");
        buf_str(out, c"    dir.push_str(path.as_slice()[0..at]);\n");
        buf_str(out, c"    dir.push(0);\n");
        buf_str(out, c"    unsafe { mkdir(dir.as_slice().ptr, 493) };\n");
        buf_str(out, c"    dir.clear();\n");
        buf_str(out, c"    dir.push_str(path.as_slice());\n");
        buf_str(out, c"    dir.push(0);\n");
        buf_str(out, c"    unsafe { mkdir(dir.as_slice().ptr, 493) };\n");
        buf_str(out, c"    dir.free();\n");
        buf_str(out, c"    let mut file = Buf::new_in(gpa);\n");
        buf_str(out, c"    file.push_str(\"/\");\n");
        buf_str(out, c"    let module = TEST_MODULE;\n");
        buf_str(out, c"    let mut i = 0;\n");
        buf_str(out, c"    while i < module.len {\n");
        buf_str(out, c"        if module[i] == ':' {\n");
        buf_str(out, c"            file.push_str(\"__\");\n");
        buf_str(out, c"            i += 2;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            file.push(module[i]);\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if module.len > 0 {\n");
        buf_str(out, c"        file.push_str(\"__\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    file.push_str(TEST_NAME);\n");
        buf_str(out, c"    file.push_str(\"__\");\n");
        buf_str(out, c"    file.push_int(TEST_SNAP_COUNT);\n");
        buf_str(out, c"    file.push_str(\".snap\");\n");
        buf_str(out, c"    path.push_str(file.as_slice());\n");
        buf_str(out, c"    shown.push_str(\"snapshots\");\n");
        buf_str(out, c"    shown.push_str(file.as_slice());\n");
        buf_str(out, c"    path.push(0);\n");
        buf_str(out, c"    let cpath = path.as_slice().ptr;\n");
        buf_str(out, c"    let mut old = Buf::new_in(gpa);\n");
        buf_str(out, c"    let had = unsafe { test_read_file(cpath, &old) };\n");
        buf_str(out, c"    if had && old.as_slice() == text.as_slice() {\n");
        buf_str(out, c"    } else if !had || TEST_ACCEPT {\n");
        buf_str(out, c"        if !unsafe { test_write_file(cpath, text.as_slice()) } {\n");
        buf_str(out, c"            eprintln(f\"snapshot {shown.as_slice()}: cannot write {path.as_slice()}\");\n");
        buf_str(out, c"            unsafe { exit(101) };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        println(\n");
        buf_str(out, c"            f\"tachyon-test: snapshot {if had { \"accepted\" } else { \"new\" }} {shown.as_slice()}\");\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        let mut k = 0;\n");
        buf_str(out, c"        while test_line(old.as_slice(), k) == test_line(text.as_slice(), k) {\n");
        buf_str(out, c"            k += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        eprintln(\n");
        buf_str(out, c"            f\"snapshot differs: {shown.as_slice()} line {k + 1}: '{test_line(old.as_slice(), k)}' expected, got '{test_line(text.as_slice(), k)}'\");\n");
        buf_str(out, c"        unsafe { exit(101) };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    text.free();\n");
        buf_str(out, c"    path.free();\n");
        buf_str(out, c"    shown.free();\n");
        buf_str(out, c"    file.free();\n");
        buf_str(out, c"    old.free();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- The test runtime's implementation (0.18) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A test build's main (front/tests makes it) runs one test: a #[test]\n");
        buf_str(out, c"// in the process, a property's cases each in a child process; the\n");
        buf_str(out, c"// generators of the types a property takes; snapshots' files.\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn fork() -> i32;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn waitpid(pid: i32, status: *i32, options: i32) -> i32;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn pipe(fds: *i32) -> i32;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn dup2(from: i32, to: i32) -> i32;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn close(fd: i32) -> i32;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn open(path: *u8, flags: i32) -> i32;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn creat(path: *u8, mode: u32) -> i32;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn mkdir(path: *u8, mode: u32) -> i32;\n");
        buf_str(out, c"    #[link_name = \"atexit\"]\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn test_atexit(f: extern \"C\" fn()) -> i32;\n");
        buf_str(out, c"    #[link_name = \"_exit\"]\n");
        buf_str(out, c"    #[effects(io, diverge)]\n");
        buf_str(out, c"    fn test_exit_now(code: i32) -> !;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Gen {\n");
        buf_str(out, c"    // The next choice: 0 past the end of the sequence (the simplest).\n");
        buf_str(out, c"    pub fn draw(self: &mut Gen) -> u64 {\n");
        buf_str(out, c"        let k = self.at;\n");
        buf_str(out, c"        self.at += 1;\n");
        buf_str(out, c"        if k >= self.count {\n");
        buf_str(out, c"            return 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe { self.choices[k] }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether a collection of `len` elements gets one more.\n");
        buf_str(out, c"    pub fn more(self: &mut Gen, len: i64) -> bool {\n");
        buf_str(out, c"        if len >= self.size || self.depth > 4 {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.draw() % 4 != 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // How deep a recursive type's generator is.\n");
        buf_str(out, c"    pub fn depth(self: &mut Gen) -> i64 {\n");
        buf_str(out, c"        self.depth\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The allocator generated containers use.\n");
        buf_str(out, c"    pub fn gpa(self: &mut Gen) -> Gpa {\n");
        buf_str(out, c"        self.gpa\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether this run is the replay of a failure (its inputs printed).\n");
        buf_str(out, c"    pub fn showing(self: &mut Gen) -> bool {\n");
        buf_str(out, c"        self.showing\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The choices used so far, told to the runner (the generators are\n");
        buf_str(out, c"    // done; the property runs next).\n");
        buf_str(out, c"    pub fn generated(self: &mut Gen) {\n");
        buf_str(out, c"        if self.report >= 0 {\n");
        buf_str(out, c"            let mut used = self.at;\n");
        buf_str(out, c"            unsafe { write(self.report, &used as *u8, 8) };\n");
        buf_str(out, c"            unsafe { close(self.report) };\n");
        buf_str(out, c"            self.report = -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A recursive type's generator goes one level down (shallower values\n");
        buf_str(out, c"    // past a depth).\n");
        buf_str(out, c"    pub fn enter(self: &mut Gen) {\n");
        buf_str(out, c"        self.depth += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn leave(self: &mut Gen) {\n");
        buf_str(out, c"        self.depth -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The generator of T: its `impl Arbitrary` (std's for the numbers and\n");
        buf_str(out, c"// bool, the compiler's for a test's structs and enums).\n");
        buf_str(out, c"pub fn arbitrary_of<T: Arbitrary>(g: &mut Gen) -> T {\n");
        buf_str(out, c"    T::arbitrary(g)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn gen_vec<T, F: Fn(&mut Gen) -> T>(g: &mut Gen, f: F) -> Vec<T> {\n");
        buf_str(out, c"    let mut v: Vec<T> = Vec::new_in(g.gpa);\n");
        buf_str(out, c"    g.enter();\n");
        buf_str(out, c"    while g.more(v.len()) {\n");
        buf_str(out, c"        v.push(f(g));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    g.leave();\n");
        buf_str(out, c"    v\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn gen_option<T, F: Fn(&mut Gen) -> T>(g: &mut Gen, f: F) -> Option<T> {\n");
        buf_str(out, c"    if g.draw() % 2 == 0 { Option::None } else { Option::Some(f(g)) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn gen_result<T, E, F: Fn(&mut Gen) -> T,\n");
        buf_str(out, c"    G: Fn(&mut Gen) -> E>(g: &mut Gen, f: F, e: G) -> Result<T, E> {\n");
        buf_str(out, c"    if g.draw() % 2 == 0 { Result::Ok(f(g)) } else { Result::Err(e(g)) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn gen_text(g: &mut Gen) -> Vec<u8> {\n");
        buf_str(out, c"    let mut v: Vec<u8> = Vec::new_in(g.gpa);\n");
        buf_str(out, c"    while g.more(v.len()) {\n");
        buf_str(out, c"        v.push(g.text_byte());\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn gen_buf(g: &mut Gen) -> Buf {\n");
        buf_str(out, c"    let mut b = Buf::new_in(g.gpa);\n");
        buf_str(out, c"    while g.more(b.len()) {\n");
        buf_str(out, c"        b.push(g.text_byte());\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    b\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn gen_f64(g: &mut Gen) -> f64 {\n");
        buf_str(out, c"    let c = g.draw();\n");
        buf_str(out, c"    if c < 6 {\n");
        buf_str(out, c"        let edges = [0.0, 1.0, -1.0, -0.0, 1.0 / 0.0, -1.0 / 0.0];\n");
        buf_str(out, c"        return edges[c as i64];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let n = ((c >> 1) as i64) ^ -((c & 1) as i64);\n");
        buf_str(out, c"    (n as f64) / 8.0\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for i64 {\n");
        buf_str(out, c"    fn arbitrary(g: &mut Gen) -> i64 { g.int() }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for i32 {\n");
        buf_str(out, c"    fn arbitrary(g: &mut Gen) -> i32 { g.int() as i32 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for i16 {\n");
        buf_str(out, c"    fn arbitrary(g: &mut Gen) -> i16 { g.int() as i16 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for i8 {\n");
        buf_str(out, c"    fn arbitrary(g: &mut Gen) -> i8 { g.int() as i8 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for u64 {\n");
        buf_str(out, c"    fn arbitrary(g: &mut Gen) -> u64 { g.draw() }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for u32 {\n");
        buf_str(out, c"    fn arbitrary(g: &mut Gen) -> u32 { g.draw() as u32 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for u16 {\n");
        buf_str(out, c"    fn arbitrary(g: &mut Gen) -> u16 { g.draw() as u16 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for u8 {\n");
        buf_str(out, c"    fn arbitrary(g: &mut Gen) -> u8 { g.draw() as u8 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for bool {\n");
        buf_str(out, c"    fn arbitrary(g: &mut Gen) -> bool { g.bool() }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for f64 {\n");
        buf_str(out, c"    fn arbitrary(g: &mut Gen) -> f64 { gen_f64(g) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What `tachyonc test` passes to a test binary: `--tachyon-test NAME`\n");
        buf_str(out, c"// (else `--tachyon-list`), `--cases N`, `--seed S`, `--snapshots DIR`,\n");
        buf_str(out, c"// `--accept`.\n");
        buf_str(out, c"static mut TEST_CASES: i64 = 100;\n");
        buf_str(out, c"static mut TEST_SEED: u64 = 0;\n");
        buf_str(out, c"static mut TEST_SEED_SET: bool = false;\n");
        buf_str(out, c"static mut TEST_SNAPSHOTS: *u8 = 0 as *u8;\n");
        buf_str(out, c"static mut TEST_ACCEPT: bool = false;\n");
        buf_str(out, c"static mut TEST_MODULE: [u8] = \"\";\n");
        buf_str(out, c"static mut TEST_NAME: [u8] = \"\";\n");
        buf_str(out, c"static mut TEST_SNAP_COUNT: i64 = 0;\n");
        buf_str(out, c"// (fuzzing, std/fuzz.tach) `--fuzz-time S`, `--fuzz-dir DIR`, `--replay\n");
        buf_str(out, c"// FILE` (repeated); whether the choices are an input's bytes.\n");
        buf_str(out, c"static mut TEST_FUZZ_TIME: i64 = 0;\n");
        buf_str(out, c"static mut TEST_FUZZ_DIR: *u8 = 0 as *u8;\n");
        buf_str(out, c"static mut TEST_REPLAY: [*u8; 256] = [0 as *u8; 256];\n");
        buf_str(out, c"static mut TEST_REPLAYS: i64 = 0;\n");
        buf_str(out, c"static mut TEST_RAW: bool = false;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The exit status of a property case whose `requires` failed (discarded).\n");
        buf_str(out, c"const TEST_DISCARD: i32 = 77;\n");
        buf_str(out, c"\n");
        buf_str(out, c"unsafe fn test_arg(p: *u8) -> [u8] {\n");
        buf_str(out, c"    p[0..strlen(p) as i64]\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn test_number(s: [u8]) -> u64 {\n");
        buf_str(out, c"    let mut n: u64 = 0;\n");
        buf_str(out, c"    let mut i = 0;\n");
        buf_str(out, c"    let mut base: u64 = 10;\n");
        buf_str(out, c"    if s.len > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X') {\n");
        buf_str(out, c"        base = 16;\n");
        buf_str(out, c"        i = 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    while i < s.len {\n");
        buf_str(out, c"        let c = s[i];\n");
        buf_str(out, c"        let d = if c >= '0' && c <= '9' { (c - '0') as u64 }\n");
        buf_str(out, c"            else if c >= 'a' && c <= 'f' { (c - 'a') as u64 + 10 }\n");
        buf_str(out, c"            else if c >= 'A' && c <= 'F' { (c - 'A') as u64 + 10 }\n");
        buf_str(out, c"            else { 99 };\n");
        buf_str(out, c"        if d >= base {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        n = n * base + d;\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    n\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A test binary's arguments: the test to run (empty: list them).\n");
        buf_str(out, c"pub fn test_args(argc: i32, argv: **u8) -> [u8] {\n");
        buf_str(out, c"    let mut name: [u8] = \"\";\n");
        buf_str(out, c"    let mut i = 1;\n");
        buf_str(out, c"    while i < argc as i64 {\n");
        buf_str(out, c"        let a = unsafe { test_arg(argv[i]) };\n");
        buf_str(out, c"        let has_value = i + 1 < argc as i64;\n");
        buf_str(out, c"        if a == \"--tachyon-test\" && has_value {\n");
        buf_str(out, c"            name = unsafe { test_arg(argv[i + 1]) };\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        } else if a == \"--cases\" && has_value {\n");
        buf_str(out, c"            TEST_CASES = test_number(unsafe { test_arg(argv[i + 1]) }) as i64;\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        } else if a == \"--seed\" && has_value {\n");
        buf_str(out, c"            TEST_SEED = test_number(unsafe { test_arg(argv[i + 1]) });\n");
        buf_str(out, c"            TEST_SEED_SET = true;\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        } else if a == \"--snapshots\" && has_value {\n");
        buf_str(out, c"            TEST_SNAPSHOTS = unsafe { argv[i + 1] };\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        } else if a == \"--accept\" {\n");
        buf_str(out, c"            TEST_ACCEPT = true;\n");
        buf_str(out, c"        } else if a == \"--fuzz-time\" && has_value {\n");
        buf_str(out, c"            TEST_FUZZ_TIME = test_number(unsafe { test_arg(argv[i + 1]) }) as i64;\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        } else if a == \"--fuzz-dir\" && has_value {\n");
        buf_str(out, c"            TEST_FUZZ_DIR = unsafe { argv[i + 1] };\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        } else if a == \"--replay\" && has_value {\n");
        buf_str(out, c"            if TEST_REPLAYS < 256 {\n");
        buf_str(out, c"                TEST_REPLAY[TEST_REPLAYS] = unsafe { argv[i + 1] };\n");
        buf_str(out, c"                TEST_REPLAYS += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    name\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A test of module `module` (its path, `a::tests`) starts.\n");
        buf_str(out, c"pub fn test_begin(module: [u8], name: [u8], gpa: Gpa) {\n");
        buf_str(out, c"    TEST_MODULE = module;\n");
        buf_str(out, c"    TEST_NAME = name;\n");
        buf_str(out, c"    TEST_SNAP_COUNT = 0;\n");
        buf_str(out, c"    // (an allocation first: --check-alloc's handler at exit is then\n");
        buf_str(out, c"    // registered before test_at_exit, which runs before it)\n");
        buf_str(out, c"    let mut first: Vec<u8> = Vec::new_in(gpa);\n");
        buf_str(out, c"    first.push(0);\n");
        buf_str(out, c"    first.free();\n");
        buf_str(out, c"    test_running();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A test that ends the process (a failed check) ends it at once: the\n");
        buf_str(out, c"// leaks it leaves are not listed after its failure (exit 101).\n");
        buf_str(out, c"static mut TEST_RUNNING: bool = false;\n");
        buf_str(out, c"static mut TEST_HANDLER: bool = false;\n");
        buf_str(out, c"\n");
        buf_str(out, c"static mut TEST_EXIT_CODE: i32 = 101;\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" fn test_at_exit() {\n");
        buf_str(out, c"    if TEST_RUNNING {\n");
        buf_str(out, c"        unsafe { test_exit_now(TEST_EXIT_CODE) };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// This process ends with `code`, before --check-alloc lists what it\n");
        buf_str(out, c"// leaves allocated (a runner's, not the test's).\n");
        buf_str(out, c"fn test_exit(code: i32) -> ! {\n");
        buf_str(out, c"    test_running();\n");
        buf_str(out, c"    TEST_EXIT_CODE = code;\n");
        buf_str(out, c"    unsafe { exit(code) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn test_running() {\n");
        buf_str(out, c"    if !TEST_HANDLER {\n");
        buf_str(out, c"        unsafe { test_atexit(test_at_exit) };\n");
        buf_str(out, c"        TEST_HANDLER = true;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    TEST_RUNNING = true;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A #[test] returned.\n");
        buf_str(out, c"pub fn test_done() {\n");
        buf_str(out, c"    TEST_RUNNING = false;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A test left blocks allocated (with --check-alloc, which test builds\n");
        buf_str(out, c"// use; they are listed): it fails.\n");
        buf_str(out, c"pub fn test_leaked() -> ! {\n");
        buf_str(out, c"    unsafe { exit(101) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A `#[test]` that returned Err(e): the error, exit 101.\n");
        buf_str(out, c"pub fn test_err<E: Debug>(e: E) -> ! {\n");
        buf_str(out, c"    eprintln(f\"test returned Err({e:?})\");\n");
        buf_str(out, c"    unsafe { exit(101) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn test_unknown(name: [u8]) -> i32 {\n");
        buf_str(out, c"    eprintln(f\"no test '{name}' in this program (--tachyon-list lists them)\");\n");
        buf_str(out, c"    2\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A property case whose `requires` does not hold: not a failure.\n");
        buf_str(out, c"pub fn test_discard() -> ! {\n");
        buf_str(out, c"    unsafe { test_exit_now(TEST_DISCARD) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The line that begins an input's value, when a failure is replayed.\n");
        buf_str(out, c"pub fn test_input(name: [u8]) {\n");
        buf_str(out, c"    print(f\"tachyon-test: input {name} = \");\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn test_input_end() {\n");
        buf_str(out, c"    println(\"\");\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The choices of a case (splitmix64 from the state): mostly small, some\n");
        buf_str(out, c"// edges, some anything.\n");
        buf_str(out, c"fn test_next(state: &mut u64) -> u64 {\n");
        buf_str(out, c"    *state = *state + 0x9e3779b97f4a7c15;\n");
        buf_str(out, c"    let mut z = *state;\n");
        buf_str(out, c"    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9;\n");
        buf_str(out, c"    z = (z ^ (z >> 27)) * 0x94d049bb133111eb;\n");
        buf_str(out, c"    z ^ (z >> 31)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn test_choice(state: &mut u64, size: i64) -> u64 {\n");
        buf_str(out, c"    let r = test_next(state);\n");
        buf_str(out, c"    let pick = r % 20;\n");
        buf_str(out, c"    if pick == 0 {\n");
        buf_str(out, c"        // (the edges: i64::MIN, i64::MAX, u64::MAX, a byte's)\n");
        buf_str(out, c"        let e = test_next(state) % 5;\n");
        buf_str(out, c"        return if e == 0 { 0xffffffffffffffff } else if e == 1 { 0xfffffffffffffffe }\n");
        buf_str(out, c"            else if e == 2 { 255 } else if e == 3 { 256 } else { 0x8000000000000000 };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if pick < 3 {\n");
        buf_str(out, c"        return test_next(state);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    test_next(state) % (2 * size as u64 + 4)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn test_seed_of(name: [u8]) -> u64 {\n");
        buf_str(out, c"    if TEST_SEED_SET {\n");
        buf_str(out, c"        return TEST_SEED;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut h: u64 = 14695981039346656037;\n");
        buf_str(out, c"    for i in 0..name.len {\n");
        buf_str(out, c"        h = (h ^ name[i] as u64) * 1099511628211;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    h\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"struct CaseRun { status: i32, used: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Runs one case in a child process: its exit status (0 passed,\n");
        buf_str(out, c"// TEST_DISCARD discarded, else failed) and the choices it used.\n");
        buf_str(out, c"fn test_case<F: Fn(&mut Gen)>(f: F, gpa: Gpa, choices: &Vec<u64>, size: i64, quiet: bool) -> CaseRun {\n");
        buf_str(out, c"    let mut fds = [0 as i32, 0 as i32];\n");
        buf_str(out, c"    if unsafe { pipe(&fds[0]) } != 0 {\n");
        buf_str(out, c"        eprintln(\"tachyon-test: cannot make a pipe\");\n");
        buf_str(out, c"        unsafe { exit(2) };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let pid = unsafe { fork() };\n");
        buf_str(out, c"    if pid == 0 {\n");
        buf_str(out, c"        unsafe { close(fds[0]) };\n");
        buf_str(out, c"        if quiet {\n");
        buf_str(out, c"            let null = unsafe { open(c\"/dev/null\", 1) };\n");
        buf_str(out, c"            unsafe { dup2(null, 1) };\n");
        buf_str(out, c"            unsafe { dup2(null, 2) };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        test_running();\n");
        buf_str(out, c"        let s = choices.as_slice();\n");
        buf_str(out, c"        let mut g = Gen {\n");
        buf_str(out, c"            choices: s.ptr, count: s.len, at: 0, size: size, gpa: gpa, depth: 0,\n");
        buf_str(out, c"            showing: !quiet, report: fds[1], raw: TEST_RAW,\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        // (0.18 with 0.17's drops: the case's values are dropped by now, so\n");
        buf_str(out, c"        // a block it allocated and left is a leak; --check-alloc)\n");
        buf_str(out, c"        let mark = check_alloc_mark();\n");
        buf_str(out, c"        f(&mut g);\n");
        buf_str(out, c"        if check_alloc_leaks_since(mark) > 0 {\n");
        buf_str(out, c"            unsafe { test_exit_now(101) };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe { test_exit_now(0) };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe { close(fds[1]) };\n");
        buf_str(out, c"    let mut used: i64 = -1;\n");
        buf_str(out, c"    let n = unsafe { read(fds[0], &used as *u8, 8) };\n");
        buf_str(out, c"    unsafe { close(fds[0]) };\n");
        buf_str(out, c"    let mut status = 0 as i32;\n");
        buf_str(out, c"    unsafe { waitpid(pid, &status, 0) };\n");
        buf_str(out, c"    let s = status as i64;\n");
        buf_str(out, c"    let code = if (s & 127) == 0 { ((s >> 8) & 255) as i32 } else { 128 + (s & 127) as i32 };\n");
        buf_str(out, c"    CaseRun { status: code, used: if n == 8 && used >= 0 { used } else { choices.len() } }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn test_fails(r: CaseRun) -> bool {\n");
        buf_str(out, c"    r.status != 0 && r.status != TEST_DISCARD\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Candidate `c` replaces `best` when it fails too (cut to what it used).\n");
        buf_str(out, c"fn test_try<F: Fn(&mut Gen)>(f: F, gpa: Gpa, best: &mut Vec<u64>, c: &Vec<u64>, size: i64,\n");
        buf_str(out, c"    steps: &mut i64) -> bool {\n");
        buf_str(out, c"    let r = test_case(f, gpa, c, size, true);\n");
        buf_str(out, c"    if !test_fails(r) {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    *steps = *steps + 1;\n");
        buf_str(out, c"    best.clear();\n");
        buf_str(out, c"    let n = if r.used < c.len() { r.used } else { c.len() };\n");
        buf_str(out, c"    for i in 0..n {\n");
        buf_str(out, c"        best.push(c.get(i));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    true\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The failing choices `best` made smaller: chunks deleted, choices set to\n");
        buf_str(out, c"// zero, halved, lowered by one, neighbours put in order; to a fixpoint (or\n");
        buf_str(out, c"// 2000 candidates).\n");
        buf_str(out, c"fn test_shrink<F: Fn(&mut Gen)>(f: F, gpa: Gpa, best: &mut Vec<u64>, size: i64) -> i64 {\n");
        buf_str(out, c"    let mut steps = 0;\n");
        buf_str(out, c"    let mut tries = 0;\n");
        buf_str(out, c"    let mut c: Vec<u64> = Vec::new_in(gpa);\n");
        buf_str(out, c"    let mut changed = true;\n");
        buf_str(out, c"    while changed && tries < 2000 {\n");
        buf_str(out, c"        changed = false;\n");
        buf_str(out, c"        for k in [8, 4, 2, 1] {\n");
        buf_str(out, c"            let mut i = best.len() - k;\n");
        buf_str(out, c"            while i >= 0 && tries < 2000 {\n");
        buf_str(out, c"                c.clear();\n");
        buf_str(out, c"                for j in 0..best.len() {\n");
        buf_str(out, c"                    if j < i || j >= i + k {\n");
        buf_str(out, c"                        c.push(best.get(j));\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                tries += 1;\n");
        buf_str(out, c"                if test_try(f, gpa, best, &c, size, &mut steps) {\n");
        buf_str(out, c"                    changed = true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                i -= 1;\n");
        buf_str(out, c"                if i > best.len() - k {\n");
        buf_str(out, c"                    i = best.len() - k;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let mut i = 0;\n");
        buf_str(out, c"        while i < best.len() && tries < 2000 {\n");
        buf_str(out, c"            // lowered: to 0, else the smallest that still fails, by halves\n");
        buf_str(out, c"            let mut lo: u64 = 0;\n");
        buf_str(out, c"            let mut first = true;\n");
        buf_str(out, c"            while i < best.len() && best.get(i) > lo && tries < 2000 {\n");
        buf_str(out, c"                let v = best.get(i);\n");
        buf_str(out, c"                let w = if first { 0 } else { lo + (v - lo) / 2 };\n");
        buf_str(out, c"                first = false;\n");
        buf_str(out, c"                c.clear();\n");
        buf_str(out, c"                for j in 0..best.len() {\n");
        buf_str(out, c"                    c.push(if j == i { w } else { best.get(j) });\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                tries += 1;\n");
        buf_str(out, c"                if test_try(f, gpa, best, &c, size, &mut steps) {\n");
        buf_str(out, c"                    changed = true;\n");
        buf_str(out, c"                } else if w == lo {\n");
        buf_str(out, c"                    lo = w + 1;\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    lo = w;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if i + 1 < best.len() && best.get(i) > best.get(i + 1) {\n");
        buf_str(out, c"                c.clear();\n");
        buf_str(out, c"                for j in 0..best.len() {\n");
        buf_str(out, c"                    c.push(if j == i { best.get(i + 1) } else if j == i + 1 { best.get(i) }\n");
        buf_str(out, c"                        else { best.get(j) });\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                tries += 1;\n");
        buf_str(out, c"                if test_try(f, gpa, best, &c, size, &mut steps) {\n");
        buf_str(out, c"                    changed = true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    c.free();\n");
        buf_str(out, c"    steps\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A property: TEST_CASES cases (the first all zeros: the simplest\n");
        buf_str(out, c"// values), each in a child process; the first failure is shrunk, then\n");
        buf_str(out, c"// replayed with its inputs printed; exit 1. `tachyon-test:` lines on\n");
        buf_str(out, c"// stdout tell `tachyonc test` the case and the steps.\n");
        buf_str(out, c"pub fn run_property<F: Fn(&mut Gen)>(gpa: Gpa, name: [u8], f: F) {\n");
        buf_str(out, c"    // (the cases run in children; this process ends normally)\n");
        buf_str(out, c"    test_done();\n");
        buf_str(out, c"    let seed = test_seed_of(name);\n");
        buf_str(out, c"    let cases = if TEST_CASES > 0 { TEST_CASES } else { 1 };\n");
        buf_str(out, c"    let mut state = seed;\n");
        buf_str(out, c"    let mut choices: Vec<u64> = Vec::new_in(gpa);\n");
        buf_str(out, c"    let mut discarded = 0;\n");
        buf_str(out, c"    for case in 0..cases {\n");
        buf_str(out, c"        // (sizes grow over 100 cases, whatever --cases: -O0 runs the first\n");
        buf_str(out, c"        // 20 of -O2's)\n");
        buf_str(out, c"        let size = 1 + (if case < 100 { case } else { 99 }) * 30 / 100;\n");
        buf_str(out, c"        choices.clear();\n");
        buf_str(out, c"        if case > 0 {\n");
        buf_str(out, c"            for _ in 0..512 {\n");
        buf_str(out, c"                choices.push(test_choice(&mut state, size));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let r = test_case(f, gpa, &choices, size, true);\n");
        buf_str(out, c"        if r.status == TEST_DISCARD {\n");
        buf_str(out, c"            discarded += 1;\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if r.status != 0 {\n");
        buf_str(out, c"            choices.truncate(if r.used < choices.len() { r.used } else { choices.len() });\n");
        buf_str(out, c"            let steps = test_shrink(f, gpa, &mut choices, size);\n");
        buf_str(out, c"            println(\n");
        buf_str(out, c"                f\"tachyon-test: property case {case + 1} of {cases}, shrunk in {steps} {if steps == 1 { \"step\" } else { \"steps\" }}, seed {seed:x}\");\n");
        buf_str(out, c"            test_case(f, gpa, &choices, size, false);\n");
        buf_str(out, c"            test_exit(1);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if discarded * 10 > cases * 9 {\n");
        buf_str(out, c"        println(f\"tachyon-test: discarded {discarded} of {cases}\");\n");
        buf_str(out, c"        eprintln(\n");
        buf_str(out, c"            f\"the generator rarely satisfies the requires: {discarded} of {cases} cases discarded (write an impl Arbitrary for the parameter's type)\");\n");
        buf_str(out, c"        test_exit(1);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    choices.free();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (snapshots)\n");
        buf_str(out, c"\n");
        buf_str(out, c"unsafe fn test_read_file(path: *u8, b: *Buf) -> bool {\n");
        buf_str(out, c"    let fd = open(path, 0);\n");
        buf_str(out, c"    if fd < 0 {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut chunk = [0 as u8; 4096];\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        let n = unsafe { read(fd, &chunk[0], 4096) };\n");
        buf_str(out, c"        if n <= 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b.push_str(chunk[0..n]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe { close(fd) };\n");
        buf_str(out, c"    true\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"unsafe fn test_write_file(path: *u8, text: [u8]) -> bool {\n");
        buf_str(out, c"    let fd = creat(path, 420);\n");
        buf_str(out, c"    if fd < 0 {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe { write(fd, text.ptr, text.len as u64) };\n");
        buf_str(out, c"    unsafe { close(fd) };\n");
        buf_str(out, c"    true\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The line `k` (from 0) of s, and whether there is one.\n");
        buf_str(out, c"fn test_line(s: [u8], k: i64) -> [u8] {\n");
        buf_str(out, c"    let mut at = 0;\n");
        buf_str(out, c"    let mut line = 0;\n");
        buf_str(out, c"    while at <= s.len {\n");
        buf_str(out, c"        let mut e = at;\n");
        buf_str(out, c"        while e < s.len && s[e] != '\\n' {\n");
        buf_str(out, c"            e += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if line == k {\n");
        buf_str(out, c"            return s[at..e];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        line += 1;\n");
        buf_str(out, c"        at = e + 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    \"\"\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Non-null pointers (0.18) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A pointer that is never null (docs/design/contracts-verification.md\n");
        buf_str(out, c"// §2.11): a distinct type over `*T`. `p as *T` converts for free; `q as\n");
        buf_str(out, c"// NonNull<T>` checks q, a null q a run-time failure (exit 101), so that\n");
        buf_str(out, c"// the niche never reads `Some(q)` as None; NonNull::new is the\n");
        buf_str(out, c"// conversion that may fail. A C function's `_Nonnull` result is the C\n");
        buf_str(out, c"// side's promise: calling C is unsafe, and the caller vouches for it. `Option<NonNull<T>>`\n");
        buf_str(out, c"// is one pointer, None the null one, as C's nullable pointers are (the\n");
        buf_str(out, c"// null niche, front/distinct.tach); an `extern \"C\"` signature may take\n");
        buf_str(out, c"// either. Dereferencing stays unsafe, as for any raw pointer: NonNull is\n");
        buf_str(out, c"// for pointers that are stored (the fields of unsafe data structures) and\n");
        buf_str(out, c"// for C. `*T` has `is_null()`.\n");
        buf_str(out, c"pub type NonNull<T> = distinct *T invariant self as u64 != 0 else \"null pointer made NonNull\";\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> NonNull<T> {\n");
        buf_str(out, c"    // p, unless it is null (`mut`: a raw pointer, which may be null, not\n");
        buf_str(out, c"    // a borrow).\n");
        buf_str(out, c"    pub fn new(mut p: *T) -> Option<NonNull<T>> {\n");
        buf_str(out, c"        if p as u64 == 0 { Option::None } else { Option::Some(p as NonNull<T>) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The pointer, as a raw one.\n");
        buf_str(out, c"    pub fn as_ptr(self: NonNull<T>) -> *T {\n");
        buf_str(out, c"        self as *T\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- The fuzzer's implementation (0.18) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `#[fuzz]` functions (docs/design/contracts-verification.md §2.8, 0.18\n");
        buf_str(out, c"// T3): a property whose choice sequence is an input's bytes, one choice\n");
        buf_str(out, c"// per byte. `tachyonc fuzz NAME` runs it on inputs it mutates and keeps\n");
        buf_str(out, c"// those that reach new code (--coverage's counters, below); `tachyonc\n");
        buf_str(out, c"// test` runs it as a property and on its saved inputs. A `[u8]`\n");
        buf_str(out, c"// parameter is the input itself (gen_bytes).\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Coverage counters (T3, --coverage): the compiler (middle/coverage.tach)\n");
        buf_str(out, c"// makes each block of the program count in COVERAGE_MAP as it runs.\n");
        buf_str(out, c"pub static mut COVERAGE_MAP: [u8; 65536] = [0; 65536];\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The counters (all zero in a program built without --coverage).\n");
        buf_str(out, c"pub fn coverage() -> [u8] {\n");
        buf_str(out, c"    COVERAGE_MAP[0..65536]\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn coverage_reset() {\n");
        buf_str(out, c"    for i in 0..65536 {\n");
        buf_str(out, c"        COVERAGE_MAP[i] = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[link_name = \"time\"]\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn fuzz_time(t: *i64) -> i64;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An input's bytes: all of them when the choices are an input's\n");
        buf_str(out, c"// (fuzzing, a saved input), else a generated text of bytes.\n");
        buf_str(out, c"pub fn gen_bytes(g: &mut Gen) -> Vec<u8> {\n");
        buf_str(out, c"    let mut v: Vec<u8> = Vec::new_in(g.gpa);\n");
        buf_str(out, c"    if g.raw {\n");
        buf_str(out, c"        while g.at < g.count {\n");
        buf_str(out, c"            v.push(g.draw() as u8);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return v;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    while g.more(v.len()) {\n");
        buf_str(out, c"        v.push(g.draw() as u8);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A run of one input in a child process: its status, the choices it used,\n");
        buf_str(out, c"// and (when it returned) its coverage, into `cov`.\n");
        buf_str(out, c"fn fuzz_exec<F: Fn(&mut Gen)>(f: F, gpa: Gpa, input: &Vec<u64>, cov: [u8]) -> CaseRun {\n");
        buf_str(out, c"    let mut fds = [0 as i32, 0 as i32];\n");
        buf_str(out, c"    let mut cfds = [0 as i32, 0 as i32];\n");
        buf_str(out, c"    if unsafe { pipe(&fds[0]) } != 0 || unsafe { pipe(&cfds[0]) } != 0 {\n");
        buf_str(out, c"        eprintln(\"tachyon-test: cannot make a pipe\");\n");
        buf_str(out, c"        unsafe { exit(2) };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let pid = unsafe { fork() };\n");
        buf_str(out, c"    if pid == 0 {\n");
        buf_str(out, c"        unsafe { close(fds[0]) };\n");
        buf_str(out, c"        unsafe { close(cfds[0]) };\n");
        buf_str(out, c"        let null = unsafe { open(c\"/dev/null\", 1) };\n");
        buf_str(out, c"        unsafe { dup2(null, 1) };\n");
        buf_str(out, c"        unsafe { dup2(null, 2) };\n");
        buf_str(out, c"        test_running();\n");
        buf_str(out, c"        coverage_reset();\n");
        buf_str(out, c"        let s = input.as_slice();\n");
        buf_str(out, c"        let mut g = Gen {\n");
        buf_str(out, c"            choices: s.ptr, count: s.len, at: 0, size: 64, gpa: gpa, depth: 0, showing: false,\n");
        buf_str(out, c"            report: fds[1], raw: true,\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        // (0.18 with 0.17's drops: the case's values are dropped by now, so\n");
        buf_str(out, c"        // a block it allocated and left is a leak; --check-alloc)\n");
        buf_str(out, c"        let mark = check_alloc_mark();\n");
        buf_str(out, c"        f(&mut g);\n");
        buf_str(out, c"        if check_alloc_leaks_since(mark) > 0 {\n");
        buf_str(out, c"            unsafe { test_exit_now(101) };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe { write(cfds[1], &COVERAGE_MAP[0], 65536) };\n");
        buf_str(out, c"        unsafe { test_exit_now(0) };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe { close(fds[1]) };\n");
        buf_str(out, c"    unsafe { close(cfds[1]) };\n");
        buf_str(out, c"    let mut used: i64 = -1;\n");
        buf_str(out, c"    let n = unsafe { read(fds[0], &used as *u8, 8) };\n");
        buf_str(out, c"    unsafe { close(fds[0]) };\n");
        buf_str(out, c"    let mut got = 0;\n");
        buf_str(out, c"    for i in 0..65536 {\n");
        buf_str(out, c"        cov[i] = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        let k = unsafe { read(cfds[0], &cov[got], (65536 - got) as u64) };\n");
        buf_str(out, c"        if k <= 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        got += k;\n");
        buf_str(out, c"        if got >= 65536 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe { close(cfds[0]) };\n");
        buf_str(out, c"    let mut status = 0 as i32;\n");
        buf_str(out, c"    unsafe { waitpid(pid, &status, 0) };\n");
        buf_str(out, c"    let st = status as i64;\n");
        buf_str(out, c"    let code = if (st & 127) == 0 { ((st >> 8) & 255) as i32 } else { 128 + (st & 127) as i32 };\n");
        buf_str(out, c"    CaseRun { status: code, used: if n == 8 && used >= 0 { used } else { input.len() } }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// AFL's buckets of a count: 1, 2, 3, 4-7, 8-15, 16-31, 32-127, 128-255.\n");
        buf_str(out, c"fn fuzz_bucket(c: u8) -> u8 {\n");
        buf_str(out, c"    if c == 0 { 0 } else if c == 1 { 1 } else if c == 2 { 2 } else if c == 3 { 4 }\n");
        buf_str(out, c"    else if c < 8 { 8 } else if c < 16 { 16 } else if c < 32 { 32 } else if c < 128 { 64 }\n");
        buf_str(out, c"    else { 128 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether `cov` reaches a block (or a block's count) `seen` has not seen;\n");
        buf_str(out, c"// `seen` takes it in.\n");
        buf_str(out, c"fn fuzz_new_coverage(cov: [u8], seen: [u8]) -> bool {\n");
        buf_str(out, c"    let mut new = false;\n");
        buf_str(out, c"    for i in 0..65536 {\n");
        buf_str(out, c"        let c = cov[i];\n");
        buf_str(out, c"        if c != 0 {\n");
        buf_str(out, c"            let b = fuzz_bucket(c);\n");
        buf_str(out, c"            if (b & ~seen[i]) != 0 {\n");
        buf_str(out, c"                seen[i] = seen[i] | b;\n");
        buf_str(out, c"                new = true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    new\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The program's text constants a mutation may put in an input (the\n");
        buf_str(out, c"// compiler gives them, front/tests).\n");
        buf_str(out, c"static mut FUZZ_WORDS: [[u8]; 64] = [\"\"; 64];\n");
        buf_str(out, c"static mut FUZZ_WORD_COUNT: i64 = 0;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn fuzz_word(w: [u8]) {\n");
        buf_str(out, c"    if FUZZ_WORD_COUNT < 64 && w.len > 0 && w.len <= 32 {\n");
        buf_str(out, c"        FUZZ_WORDS[FUZZ_WORD_COUNT] = w;\n");
        buf_str(out, c"        FUZZ_WORD_COUNT += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// One mutation of `v` (bytes as choices), from the random state; `other`\n");
        buf_str(out, c"// is another input of the corpus (for a splice).\n");
        buf_str(out, c"fn fuzz_mutate(v: &mut Vec<u64>, other: &Vec<u64>, state: &mut u64) {\n");
        buf_str(out, c"    let len = v.len();\n");
        buf_str(out, c"    let r = test_next(state);\n");
        buf_str(out, c"    let how = r % 10;\n");
        buf_str(out, c"    let at = if len > 0 { ((r >> 8) % len as u64) as i64 } else { 0 };\n");
        buf_str(out, c"    if len == 0 || how == 0 {\n");
        buf_str(out, c"        // a byte inserted\n");
        buf_str(out, c"        let b = test_next(state) % 256;\n");
        buf_str(out, c"        if len >= 4096 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v.insert(if len > 0 { at } else { 0 }, b);\n");
        buf_str(out, c"    } else if how == 1 {\n");
        buf_str(out, c"        // a bit flipped\n");
        buf_str(out, c"        v.set(at, v.get(at) ^ (1 << (test_next(state) % 8)));\n");
        buf_str(out, c"    } else if how == 2 {\n");
        buf_str(out, c"        let interesting: [u64; 10] = [0, 1, 0x7f, 0x80, 0xff, 48, 97, 32, 10, 255];\n");
        buf_str(out, c"        v.set(at, interesting[(test_next(state) % 10) as i64]);\n");
        buf_str(out, c"    } else if how == 3 {\n");
        buf_str(out, c"        v.set(at, test_next(state) % 256);\n");
        buf_str(out, c"    } else if how == 4 {\n");
        buf_str(out, c"        // a run deleted\n");
        buf_str(out, c"        let n = 1 + (test_next(state) % 4) as i64;\n");
        buf_str(out, c"        let mut k = 0;\n");
        buf_str(out, c"        while k < n && at < v.len() {\n");
        buf_str(out, c"            v.remove(at);\n");
        buf_str(out, c"            k += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else if how == 5 {\n");
        buf_str(out, c"        // a byte changed by a little\n");
        buf_str(out, c"        let d = test_next(state) % 16;\n");
        buf_str(out, c"        v.set(at, (v.get(at) + d + 240) % 256);\n");
        buf_str(out, c"    } else if how == 6 && other.len() > 0 {\n");
        buf_str(out, c"        // a splice: this input's start, the other's end\n");
        buf_str(out, c"        let cut = (test_next(state) % other.len() as u64) as i64;\n");
        buf_str(out, c"        v.truncate(at);\n");
        buf_str(out, c"        for i in cut..other.len() {\n");
        buf_str(out, c"            if v.len() < 4096 {\n");
        buf_str(out, c"                v.push(other.get(i));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else if how == 7 && FUZZ_WORD_COUNT > 0 {\n");
        buf_str(out, c"        // a text constant of the program\n");
        buf_str(out, c"        let w = FUZZ_WORDS[(test_next(state) % FUZZ_WORD_COUNT as u64) as i64];\n");
        buf_str(out, c"        for i in 0..w.len {\n");
        buf_str(out, c"            if v.len() < 4096 {\n");
        buf_str(out, c"                v.insert(at + i, w[i] as u64);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else if how == 8 && len < 4096 {\n");
        buf_str(out, c"        // a run repeated\n");
        buf_str(out, c"        let n = 1 + (test_next(state) % 8) as i64;\n");
        buf_str(out, c"        let mut k = 0;\n");
        buf_str(out, c"        while k < n && at + k < len && v.len() < 4096 {\n");
        buf_str(out, c"            let to = if at + n + k < v.len() { at + n + k } else { v.len() };\n");
        buf_str(out, c"            v.insert(to, v.get(at + k));\n");
        buf_str(out, c"            k += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        v.set(at, test_next(state) % 256);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn fuzz_hash(v: &Vec<u64>) -> u64 {\n");
        buf_str(out, c"    let mut h: u64 = 14695981039346656037;\n");
        buf_str(out, c"    for i in 0..v.len() {\n");
        buf_str(out, c"        h = (h ^ v.get(i)) * 1099511628211;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    h\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Input v saved as DIR/PREFIXHASH (bytes): its path.\n");
        buf_str(out, c"fn fuzz_save(gpa: Gpa, v: &Vec<u64>, prefix: [u8]) -> Buf {\n");
        buf_str(out, c"    let mut path = Buf::new_in(gpa);\n");
        buf_str(out, c"    if TEST_FUZZ_DIR != 0 as *u8 {\n");
        buf_str(out, c"        unsafe { path.push_cstr(TEST_FUZZ_DIR) };\n");
        buf_str(out, c"        path.push('/');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    path.push_str(prefix);\n");
        buf_str(out, c"    let h = fuzz_hash(v);\n");
        buf_str(out, c"    let digits = \"0123456789abcdef\";\n");
        buf_str(out, c"    for k in 0..16 {\n");
        buf_str(out, c"        path.push(digits[((h >> (60 - 4 * k as u64)) & 15) as i64]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut bytes = Buf::new_in(gpa);\n");
        buf_str(out, c"    for i in 0..v.len() {\n");
        buf_str(out, c"        bytes.push(v.get(i) as u8);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut c = Buf::new_in(gpa);\n");
        buf_str(out, c"    c.push_str(path.as_slice());\n");
        buf_str(out, c"    c.push(0);\n");
        buf_str(out, c"    unsafe { test_write_file(c.as_slice().ptr, bytes.as_slice()) };\n");
        buf_str(out, c"    c.free();\n");
        buf_str(out, c"    bytes.free();\n");
        buf_str(out, c"    path\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"unsafe fn fuzz_load(gpa: Gpa, path: *u8, into: *Vec<u64>) -> bool {\n");
        buf_str(out, c"    let mut b = Buf::new_in(gpa);\n");
        buf_str(out, c"    let ok = test_read_file(path, &b);\n");
        buf_str(out, c"    into.clear();\n");
        buf_str(out, c"    let s = b.as_slice();\n");
        buf_str(out, c"    for i in 0..s.len {\n");
        buf_str(out, c"        into.push(s[i] as u64);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    b.free();\n");
        buf_str(out, c"    ok\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A failing input: shrunk, saved, replayed with its inputs printed; exit 1.\n");
        buf_str(out, c"fn fuzz_failed<F: Fn(&mut Gen)>(f: F, gpa: Gpa, input: &mut Vec<u64>, runs: i64) -> ! {\n");
        buf_str(out, c"    TEST_RAW = true;\n");
        buf_str(out, c"    let steps = test_shrink(f, gpa, input, 64);\n");
        buf_str(out, c"    let path = fuzz_save(gpa, input, \"crash-\");\n");
        buf_str(out, c"    println(\n");
        buf_str(out, c"        f\"tachyon-test: property after {runs} runs, shrunk in {steps} {if steps == 1 { \"step\" } else { \"steps\" }}\");\n");
        buf_str(out, c"    println(f\"tachyon-test: saved {path.as_slice()}\");\n");
        buf_str(out, c"    test_case(f, gpa, input, 64, false);\n");
        buf_str(out, c"    test_exit(1)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A fuzz target: fuzzed for --fuzz-time seconds (tachyonc fuzz), else run\n");
        buf_str(out, c"// on its saved inputs (--replay), then as a property.\n");
        buf_str(out, c"pub fn run_fuzz_target<F: Fn(&mut Gen)>(gpa: Gpa, name: [u8], f: F) {\n");
        buf_str(out, c"    test_done();\n");
        buf_str(out, c"    let mut input: Vec<u64> = Vec::new_in(gpa);\n");
        buf_str(out, c"    if TEST_FUZZ_TIME <= 0 {\n");
        buf_str(out, c"        TEST_RAW = true;\n");
        buf_str(out, c"        for k in 0..TEST_REPLAYS {\n");
        buf_str(out, c"            if !unsafe { fuzz_load(gpa, TEST_REPLAY[k], &input) } {\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let r = test_case(f, gpa, &input, 64, true);\n");
        buf_str(out, c"            if test_fails(r) {\n");
        buf_str(out, c"                let p = unsafe { test_arg(TEST_REPLAY[k]) };\n");
        buf_str(out, c"                println(f\"tachyon-test: property input {p}\");\n");
        buf_str(out, c"                test_case(f, gpa, &input, 64, false);\n");
        buf_str(out, c"                test_exit(1);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        TEST_RAW = false;\n");
        buf_str(out, c"        input.free();\n");
        buf_str(out, c"        run_property(gpa, name, f);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // the corpus: the saved inputs, and the empty one\n");
        buf_str(out, c"    let mut corpus: Vec<Vec<u64>> = Vec::new_in(gpa);\n");
        buf_str(out, c"    let mut seen = [0 as u8; 65536];\n");
        buf_str(out, c"    let mut cov = [0 as u8; 65536];\n");
        buf_str(out, c"    let empty: Vec<u64> = Vec::new_in(gpa);\n");
        buf_str(out, c"    corpus.push(empty);\n");
        buf_str(out, c"    for k in 0..TEST_REPLAYS {\n");
        buf_str(out, c"        let mut v: Vec<u64> = Vec::new_in(gpa);\n");
        buf_str(out, c"        if unsafe { fuzz_load(gpa, TEST_REPLAY[k], &v) } {\n");
        buf_str(out, c"            corpus.push(v);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut runs = 0;\n");
        buf_str(out, c"    for k in 0..corpus.len() {\n");
        buf_str(out, c"        let mut v = corpus.get(k);\n");
        buf_str(out, c"        let r = fuzz_exec(f, gpa, &v, cov[..]);\n");
        buf_str(out, c"        runs += 1;\n");
        buf_str(out, c"        if test_fails(r) {\n");
        buf_str(out, c"            fuzz_failed(f, gpa, &mut v, runs);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        fuzz_new_coverage(cov[..], seen[..]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut state = test_seed_of(name);\n");
        buf_str(out, c"    let start = unsafe { fuzz_time(0 as *i64) };\n");
        buf_str(out, c"    let mut kept = 0;\n");
        buf_str(out, c"    let mut child: Vec<u64> = Vec::new_in(gpa);\n");
        buf_str(out, c"    while unsafe { fuzz_time(0 as *i64) } - start < TEST_FUZZ_TIME {\n");
        buf_str(out, c"        let mut parent = corpus.get((test_next(&mut state) % corpus.len() as u64) as i64);\n");
        buf_str(out, c"        let mut other = corpus.get((test_next(&mut state) % corpus.len() as u64) as i64);\n");
        buf_str(out, c"        child.clear();\n");
        buf_str(out, c"        for i in 0..parent.len() {\n");
        buf_str(out, c"            child.push(parent.get(i));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let stack = 1 + test_next(&mut state) % 4;\n");
        buf_str(out, c"        for _ in 0..stack {\n");
        buf_str(out, c"            fuzz_mutate(&mut child, &other, &mut state);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let r = fuzz_exec(f, gpa, &child, cov[..]);\n");
        buf_str(out, c"        runs += 1;\n");
        buf_str(out, c"        if test_fails(r) {\n");
        buf_str(out, c"            fuzz_failed(f, gpa, &mut child, runs);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if r.status == 0 && fuzz_new_coverage(cov[..], seen[..]) {\n");
        buf_str(out, c"            let mut keep: Vec<u64> = Vec::new_in(gpa);\n");
        buf_str(out, c"            for i in 0..child.len() {\n");
        buf_str(out, c"                keep.push(child.get(i));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let path = fuzz_save(gpa, &keep, \"corpus-\");\n");
        buf_str(out, c"            let mut p = path;\n");
        buf_str(out, c"            p.free();\n");
        buf_str(out, c"            corpus.push(keep);\n");
        buf_str(out, c"            kept += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let _ = parent.len();\n");
        buf_str(out, c"        let _ = other.len();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    println(f\"tachyon-test: fuzz {runs} runs, {kept} inputs kept, {corpus.len()} in the corpus\");\n");
        buf_str(out, c"    test_exit(0)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach and the others\n");
        buf_str(out, c"// (0.18.1): the same module, `std`. Its sections are lazy: loaded when a\n");
        buf_str(out, c"// program names what they define.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Heaps (0.18.1) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A priority queue, a binary heap in a Vec: `push` in O(log n), `pop`\n");
        buf_str(out, c"// takes the largest element first (Rust's BinaryHeap, a max-heap), `peek`\n");
        buf_str(out, c"// reads it. For the smallest first (Dijkstra, a timer queue) use\n");
        buf_str(out, c"// `MinHeap`, the same API: no `Reverse` wrapper. `BinaryHeap::new_in(gpa)`,\n");
        buf_str(out, c"// `with_capacity_in(n, gpa)`, `from_vec(v)`; dropped with its elements.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct BinaryHeap<T: Ord, A: Allocator = Gpa> { data: Vec<T, A> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A priority queue whose `pop` takes the smallest element first: a\n");
        buf_str(out, c"// min-heap, with BinaryHeap's API (`MinHeap::new_in(gpa)`, `push`, `pop`,\n");
        buf_str(out, c"// `peek`). Rust spells it `BinaryHeap<Reverse<T>>`.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct MinHeap<T: Ord, A: Allocator = Gpa> { data: Vec<T, A> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Which of two elements a heap keeps nearer the root: the larger\n");
        buf_str(out, c"// (BinaryHeap) or the smaller (MinHeap). Unsafe: a and b point to\n");
        buf_str(out, c"// elements.\n");
        buf_str(out, c"trait HeapOrder { unsafe fn above<T: Ord>(a: *T, b: *T) -> bool; }\n");
        buf_str(out, c"\n");
        buf_str(out, c"struct HeapMax {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"struct HeapMin {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl HeapOrder for HeapMax {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn above<T: Ord>(a: *T, b: *T) -> bool {\n");
        buf_str(out, c"        *a > *b\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl HeapOrder for HeapMin {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn above<T: Ord>(a: *T, b: *T) -> bool {\n");
        buf_str(out, c"        *a < *b\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Puts x in the hole at p[pos], or nearer p[start] while it is above the\n");
        buf_str(out, c"// hole's parent: each step one move, not a swap; where it ends. (The\n");
        buf_str(out, c"// index at least halves each round: 64 rounds at most.) Unsafe: p has\n");
        buf_str(out, c"// pos + 1 elements at least; p[pos] holds nothing (its bits are x's or a\n");
        buf_str(out, c"// moved element's).\n");
        buf_str(out, c"unsafe fn heap_hole_up<T: Ord, O: HeapOrder>(p: *T, start: i64, pos: i64, x: T) -> i64 {\n");
        buf_str(out, c"    let mut i = pos;\n");
        buf_str(out, c"    for _ in 0..64 {\n");
        buf_str(out, c"        if i <= start {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let parent = (i - 1) >> 1;\n");
        buf_str(out, c"        if !O::above(&x, &p[parent]) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        p[i] = p[parent];\n");
        buf_str(out, c"        i = parent;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    p[i] = x;\n");
        buf_str(out, c"    i\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Moves p[pos] down until no child of it, in p[..end], is above it,\n");
        buf_str(out, c"// through a hole. Unsafe: p has `end` elements.\n");
        buf_str(out, c"unsafe fn heap_sift_down<T: Ord, O: HeapOrder>(p: *T, pos: i64, end: i64) {\n");
        buf_str(out, c"    let x = p[pos];\n");
        buf_str(out, c"    let mut i = pos;\n");
        buf_str(out, c"    let mut child = 2 * i + 1;\n");
        buf_str(out, c"    for _ in 0..64 {\n");
        buf_str(out, c"        if child > end - 2 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if !O::above(&p[child], &p[child + 1]) {\n");
        buf_str(out, c"            child += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if !O::above(&p[child], &x) {\n");
        buf_str(out, c"            p[i] = x;\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        p[i] = p[child];\n");
        buf_str(out, c"        i = child;\n");
        buf_str(out, c"        child = 2 * i + 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if child == end - 1 && O::above(&p[child], &x) {\n");
        buf_str(out, c"        p[i] = p[child];\n");
        buf_str(out, c"        i = child;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    p[i] = x;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `pop`'s sift: x, for the hole at the root, goes down to a leaf along\n");
        buf_str(out, c"// the path of the children above their siblings (one comparison a level),\n");
        buf_str(out, c"// then up to its place: fewer comparisons than heap_sift_down, as x, the\n");
        buf_str(out, c"// last leaf, usually belongs near the bottom. Unsafe: p has `end`\n");
        buf_str(out, c"// elements, at least one; p[0] holds nothing.\n");
        buf_str(out, c"unsafe fn heap_hole_down_to_bottom<T: Ord, O: HeapOrder>(p: *T, end: i64, x: T) {\n");
        buf_str(out, c"    let mut i = 0;\n");
        buf_str(out, c"    let mut child = 1;\n");
        buf_str(out, c"    for _ in 0..64 {\n");
        buf_str(out, c"        if child > end - 2 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // (the larger child without a branch: random data mispredicts one)\n");
        buf_str(out, c"        child += (!O::above(&p[child], &p[child + 1])) as i64;\n");
        buf_str(out, c"        p[i] = p[child];\n");
        buf_str(out, c"        i = child;\n");
        buf_str(out, c"        child = 2 * i + 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if child == end - 1 {\n");
        buf_str(out, c"        p[i] = p[child];\n");
        buf_str(out, c"        i = child;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    heap_hole_up::<T, O>(p, 0, i, x);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Makes p[..n] a heap, in O(n). Unsafe: p has n elements.\n");
        buf_str(out, c"unsafe fn heap_build<T: Ord, O: HeapOrder>(p: *T, n: i64) {\n");
        buf_str(out, c"    for k in 0..n / 2 {\n");
        buf_str(out, c"        heap_sift_down::<T, O>(p, n / 2 - 1 - k, n);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Adds x to the heap in v.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"#[stores(x)]\n");
        buf_str(out, c"fn heap_push<T: Ord, O: HeapOrder, A: Allocator>(v: &mut Vec<T, A>, x: T) {\n");
        buf_str(out, c"    v.reserve(1);\n");
        buf_str(out, c"    let n = v.len;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        heap_hole_up::<T, O>(v.ptr, 0, n, x);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v.len = n + 1;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Takes the root of the heap in v out.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn heap_pop<T: Ord, O: HeapOrder, A: Allocator>(v: &mut Vec<T, A>) -> Option<T> {\n");
        buf_str(out, c"    if v.len == 0 {\n");
        buf_str(out, c"        return None;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v.len -= 1;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let p = v.ptr;\n");
        buf_str(out, c"        let n = v.len;\n");
        buf_str(out, c"        let last = p[n];\n");
        buf_str(out, c"        if n == 0 {\n");
        buf_str(out, c"            return Some(last);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let top = p[0];\n");
        buf_str(out, c"        heap_hole_down_to_bottom::<T, O>(p, n, last);\n");
        buf_str(out, c"        Some(top)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The heap in v sorted in place: the root's end of the order last.\n");
        buf_str(out, c"fn heap_sort_vec<T: Ord, O: HeapOrder, A: Allocator>(v: &mut Vec<T, A>) {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let p = v.ptr;\n");
        buf_str(out, c"        let n = v.len;\n");
        buf_str(out, c"        for k in 1..n {\n");
        buf_str(out, c"            let end = n - k;\n");
        buf_str(out, c"            swap_raw::<T>(p, 0, end);\n");
        buf_str(out, c"            heap_sift_down::<T, O>(p, 0, end);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Ord, A: Allocator> BinaryHeap<T, A> {\n");
        buf_str(out, c"    // An empty heap on allocator a.\n");
        buf_str(out, c"    pub fn new_in(a: A) -> BinaryHeap<T, A> {\n");
        buf_str(out, c"        BinaryHeap { data: Vec::new_in(a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An empty heap on allocator a with room for cap elements.\n");
        buf_str(out, c"    pub fn with_capacity_in(cap: i64, a: A) -> BinaryHeap<T, A> {\n");
        buf_str(out, c"        BinaryHeap { data: Vec::with_capacity_in(cap, a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A heap of v's elements, in O(n), on v's memory: Rust's\n");
        buf_str(out, c"    // `BinaryHeap::from(v)`.\n");
        buf_str(out, c"    pub fn from_vec(v: Vec<T, A>) -> BinaryHeap<T, A> {\n");
        buf_str(out, c"        let mut data = v;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            heap_build::<T, HeapMax>(data.ptr, data.len);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        BinaryHeap { data: data }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn len(self: &BinaryHeap<T, A>) -> i64 {\n");
        buf_str(out, c"        self.data.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_empty(self: &BinaryHeap<T, A>) -> bool {\n");
        buf_str(out, c"        self.data.len == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Adds x, in O(log n).\n");
        buf_str(out, c"    #[stores(x)]\n");
        buf_str(out, c"    pub fn push(self: &mut BinaryHeap<T, A>, x: T) {\n");
        buf_str(out, c"        heap_push::<T, HeapMax, A>(&mut self.data, x);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Takes the largest element out (None when empty), in O(log n).\n");
        buf_str(out, c"    pub fn pop(self: &mut BinaryHeap<T, A>) -> Option<T> {\n");
        buf_str(out, c"        heap_pop::<T, HeapMax, A>(&mut self.data)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The largest element, which stays (`pop` takes it), as Vec's `last`.\n");
        buf_str(out, c"    pub fn peek(self: &BinaryHeap<T, A>) -> Option<T> {\n");
        buf_str(out, c"        if self.data.len == 0 { None } else { Some(self.data.get(0)) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Drops the elements; the room stays.\n");
        buf_str(out, c"    pub fn clear(self: &mut BinaryHeap<T, A>) {\n");
        buf_str(out, c"        self.data.clear();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn capacity(self: &BinaryHeap<T, A>) -> i64 {\n");
        buf_str(out, c"        self.data.cap\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Room for `extra` more elements.\n");
        buf_str(out, c"    pub fn reserve(self: &mut BinaryHeap<T, A>, extra: i64) {\n");
        buf_str(out, c"        self.data.reserve(extra);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its allocator: a copy of the handle.\n");
        buf_str(out, c"    pub fn allocator(self: &BinaryHeap<T, A>) -> A {\n");
        buf_str(out, c"        self.data.alloc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements in heap order (the largest first, the rest in no\n");
        buf_str(out, c"    // useful order), a view.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn as_slice(self: &BinaryHeap<T, A>) -> [T] {\n");
        buf_str(out, c"        self.data.as_slice()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements in a Vec, in heap order, on the same memory.\n");
        buf_str(out, c"    pub fn into_vec(self: BinaryHeap<T, A>) -> Vec<T, A> {\n");
        buf_str(out, c"        self.data\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements in a Vec, smallest first, on the same memory: a\n");
        buf_str(out, c"    // heapsort, in O(n log n).\n");
        buf_str(out, c"    pub fn into_sorted_vec(self: BinaryHeap<T, A>) -> Vec<T, A> {\n");
        buf_str(out, c"        let mut v = self.data;\n");
        buf_str(out, c"        heap_sort_vec::<T, HeapMax, A>(&mut v);\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Ord, A: Allocator + Ambient> BinaryHeap<T, A> {\n");
        buf_str(out, c"    #[ambient(\"BinaryHeap::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> BinaryHeap<T, A> {\n");
        buf_str(out, c"        BinaryHeap::new_in(A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"BinaryHeap::with_capacity_in(cap, gpa)\")]\n");
        buf_str(out, c"    pub fn with_capacity(cap: i64) -> BinaryHeap<T, A> {\n");
        buf_str(out, c"        BinaryHeap::with_capacity_in(cap, A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Ord, A: Allocator> MinHeap<T, A> {\n");
        buf_str(out, c"    // An empty heap on allocator a.\n");
        buf_str(out, c"    pub fn new_in(a: A) -> MinHeap<T, A> {\n");
        buf_str(out, c"        MinHeap { data: Vec::new_in(a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An empty heap on allocator a with room for cap elements.\n");
        buf_str(out, c"    pub fn with_capacity_in(cap: i64, a: A) -> MinHeap<T, A> {\n");
        buf_str(out, c"        MinHeap { data: Vec::with_capacity_in(cap, a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A heap of v's elements, in O(n), on v's memory.\n");
        buf_str(out, c"    pub fn from_vec(v: Vec<T, A>) -> MinHeap<T, A> {\n");
        buf_str(out, c"        let mut data = v;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            heap_build::<T, HeapMin>(data.ptr, data.len);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        MinHeap { data: data }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn len(self: &MinHeap<T, A>) -> i64 {\n");
        buf_str(out, c"        self.data.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_empty(self: &MinHeap<T, A>) -> bool {\n");
        buf_str(out, c"        self.data.len == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Adds x, in O(log n).\n");
        buf_str(out, c"    #[stores(x)]\n");
        buf_str(out, c"    pub fn push(self: &mut MinHeap<T, A>, x: T) {\n");
        buf_str(out, c"        heap_push::<T, HeapMin, A>(&mut self.data, x);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Takes the smallest element out (None when empty), in O(log n).\n");
        buf_str(out, c"    pub fn pop(self: &mut MinHeap<T, A>) -> Option<T> {\n");
        buf_str(out, c"        heap_pop::<T, HeapMin, A>(&mut self.data)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The smallest element, which stays (`pop` takes it), as Vec's `last`.\n");
        buf_str(out, c"    pub fn peek(self: &MinHeap<T, A>) -> Option<T> {\n");
        buf_str(out, c"        if self.data.len == 0 { None } else { Some(self.data.get(0)) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Drops the elements; the room stays.\n");
        buf_str(out, c"    pub fn clear(self: &mut MinHeap<T, A>) {\n");
        buf_str(out, c"        self.data.clear();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn capacity(self: &MinHeap<T, A>) -> i64 {\n");
        buf_str(out, c"        self.data.cap\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Room for `extra` more elements.\n");
        buf_str(out, c"    pub fn reserve(self: &mut MinHeap<T, A>, extra: i64) {\n");
        buf_str(out, c"        self.data.reserve(extra);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its allocator: a copy of the handle.\n");
        buf_str(out, c"    pub fn allocator(self: &MinHeap<T, A>) -> A {\n");
        buf_str(out, c"        self.data.alloc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements in heap order (the smallest first, the rest in no\n");
        buf_str(out, c"    // useful order), a view.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn as_slice(self: &MinHeap<T, A>) -> [T] {\n");
        buf_str(out, c"        self.data.as_slice()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements in a Vec, in heap order, on the same memory.\n");
        buf_str(out, c"    pub fn into_vec(self: MinHeap<T, A>) -> Vec<T, A> {\n");
        buf_str(out, c"        self.data\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements in a Vec, smallest first (as BinaryHeap's), on the same\n");
        buf_str(out, c"    // memory, in O(n log n).\n");
        buf_str(out, c"    pub fn into_sorted_vec(self: MinHeap<T, A>) -> Vec<T, A> {\n");
        buf_str(out, c"        let mut v = self.data;\n");
        buf_str(out, c"        heap_sort_vec::<T, HeapMin, A>(&mut v);\n");
        buf_str(out, c"        let s = v.as_mut_slice();\n");
        buf_str(out, c"        for k in 0..s.len / 2 {\n");
        buf_str(out, c"            swap_at::<T>(s, k, s.len - 1 - k);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Ord, A: Allocator + Ambient> MinHeap<T, A> {\n");
        buf_str(out, c"    #[ambient(\"MinHeap::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> MinHeap<T, A> {\n");
        buf_str(out, c"        MinHeap::new_in(A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"MinHeap::with_capacity_in(cap, gpa)\")]\n");
        buf_str(out, c"    pub fn with_capacity(cap: i64) -> MinHeap<T, A> {\n");
        buf_str(out, c"        MinHeap::with_capacity_in(cap, A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- More of Vec and Range (0.18.1) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Vec's first, retain, contains and sort_by_key, a slice's contains,\n");
        buf_str(out, c"// Range's rev.\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // The first element, if there is one (as `last`).\n");
        buf_str(out, c"    pub fn first(self: &Vec<T, A>) -> Option<T> {\n");
        buf_str(out, c"        if self.len == 0 { None } else { Some(self.get(0)) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Keeps the elements f is true of, in their order, and drops the\n");
        buf_str(out, c"    // others (Rust's `retain`): in place, O(n), f called once per element.\n");
        buf_str(out, c"    pub fn retain<F: FnMut(&T) -> bool>(self: &mut Vec<T, A>, f: F) {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let n = self.len;\n");
        buf_str(out, c"        let p = self.ptr;\n");
        buf_str(out, c"        let mut kept = 0;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            for i in 0..n {\n");
        buf_str(out, c"                if g(&*(&p[i])) {\n");
        buf_str(out, c"                    if kept != i {\n");
        buf_str(out, c"                        p[kept] = p[i];\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    kept += 1;\n");
        buf_str(out, c"                } else if needs_drop::<T>() {\n");
        buf_str(out, c"                    drop(p[i]);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len = kept;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Sorts it in place by the key f gives each element, smallest first,\n");
        buf_str(out, c"    // keeping equal keys in their order, as Rust's `sort_by_key`:\n");
        buf_str(out, c"    // sort_stable_by_in with the Vec's own allocator for its buffer. f\n");
        buf_str(out, c"    // runs twice per comparison: make it cheap (a field, a tuple of\n");
        buf_str(out, c"    // fields).\n");
        buf_str(out, c"    pub fn sort_by_key<K: Ord, F: FnMut(&T) -> K>(self: &mut Vec<T, A>, f: F) {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let a = self.alloc;\n");
        buf_str(out, c"        sort_stable_by_in(self.as_mut_slice(), |x: &T, y: &T| {\n");
        buf_str(out, c"            let kx = g(x);\n");
        buf_str(out, c"            let ky = g(y);\n");
        buf_str(out, c"            cmp_of(&kx, &ky)\n");
        buf_str(out, c"        }, a);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Eq>[T] {\n");
        buf_str(out, c"    // Whether x is one of its elements (Rust's `s.contains(&x)`; x by\n");
        buf_str(out, c"    // value, as HashMap's keys): a linear search.\n");
        buf_str(out, c"    pub fn contains(self: [T], x: T) -> bool {\n");
        buf_str(out, c"        for i in 0..self.len {\n");
        buf_str(out, c"            if self[i] == x {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Eq, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // Whether x is one of its elements: `v.contains(x)`.\n");
        buf_str(out, c"    pub fn contains(self: &Vec<T, A>, x: T) -> bool {\n");
        buf_str(out, c"        self.as_slice().contains(x)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Range<T> {\n");
        buf_str(out, c"    // Its items from the last down: `for i in (0..n).rev()` is n - 1,\n");
        buf_str(out, c"    // n - 2, ..., 0.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn rev(self: Range<T>) -> RevRange<T> {\n");
        buf_str(out, c"        RevRange { start: self.start, end: self.end }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `(a..b).rev()`: end - 1, end - 2, ..., down to start.\n");
        buf_str(out, c"pub struct RevRange<T> { pub start: T, pub end: T }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Iterator for RevRange<T> {\n");
        buf_str(out, c"    type Item = T;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: &mut RevRange<T>) -> Option<T> {\n");
        buf_str(out, c"        if self.start < self.end {\n");
        buf_str(out, c"            let x = self.end - 1 as T;\n");
        buf_str(out, c"            self.end = x;\n");
        buf_str(out, c"            Some(x)\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            None\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: &RevRange<T>) -> i64 {\n");
        buf_str(out, c"        if self.start < self.end { (self.end - self.start) as i64 } else { 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: &RevRange<T>, k: i64) -> T {\n");
        buf_str(out, c"        self.end - (k + 1) as T\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, T) -> B>(self: RevRange<T>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        let n = self.exact_len();\n");
        buf_str(out, c"        for k in 0..n {\n");
        buf_str(out, c"            acc = g(acc, self.end - (k + 1) as T);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Run-time CPU features (0.19) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// std::arch::detect's word (docs/design/arch.md §2.5): bit b is set when\n");
        buf_str(out, c"// the running CPU has feature b (the compiler's numbering: FT_* in\n");
        buf_str(out, c"// compiler/src/arch/features.tach), bit 63 once the word is filled. A\n");
        buf_str(out, c"// detect the build cannot fold loads it and tests one bit\n");
        buf_str(out, c"// (back/isel/arch.tach; gen0/gen/arch.tach at -O0). Its sources follow,\n");
        buf_str(out, c"// one section per system (the compiler names the target's: arch_init_*\n");
        buf_str(out, c"// and arch_word_*, front/modules/stdsections.tach); each init takes the\n");
        buf_str(out, c"// build's features, which it need not ask the system about.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Why there is no data race (no atomics before 0.21):\n");
        buf_str(out, c"// - A program with `main` fills the word once, as the first thing main\n");
        buf_str(out, c"//   does (back/isel/arch.tach; gen0 likewise), while it is the only\n");
        buf_str(out, c"//   thread: every later read, on any thread, comes after that write (a\n");
        buf_str(out, c"//   thread starts after what made it), and nothing writes it again.\n");
        buf_str(out, c"// - Code entered from C with no tachyon `main` (a library) fills it at its\n");
        buf_str(out, c"//   first detect (arch_word_*): two threads may both find 0 and both fill\n");
        buf_str(out, c"//   it. Each computes the same value from what the CPU and the system\n");
        buf_str(out, c"//   report, and stores it with one aligned 64-bit store, which AArch64 and\n");
        buf_str(out, c"//   x86-64 never tear (one str or mov from the compiler's own back end,\n");
        buf_str(out, c"//   which does not assume the absence of races: it never splits, repeats\n");
        buf_str(out, c"//   or invents a store to a static). A reader sees 0, and fills the word\n");
        buf_str(out, c"//   itself, or the whole word. That is a relaxed atomic load and store in\n");
        buf_str(out, c"//   0.21's terms, which the two become then, with the same instructions.\n");
        buf_str(out, c"// - TACHYON_ARCH_DISABLE (comma-separated feature names, or `all`) only\n");
        buf_str(out, c"//   clears bits, so no setting of it makes a missing instruction run: it\n");
        buf_str(out, c"//   makes detect take the fallback paths, for testing them.\n");
        buf_str(out, c"static mut ARCH_FEATURES: u64 = 0;\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[link_name = \"getenv\"]\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn arch_getenv(name: *u8) -> *u8;\n");
        buf_str(out, c"    #[link_name = \"strlen\"]\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn arch_strlen(s: *u8) -> u64;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn arch_bit(b: i64) -> u64 {\n");
        buf_str(out, c"    (1 as u64) << (b as u64)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The word from what the system reports: TACHYON_ARCH_DISABLE's features\n");
        buf_str(out, c"// cleared (`a64`: unqualified names are AArch64's), then those whose\n");
        buf_str(out, c"// requirements are gone, stored once.\n");
        buf_str(out, c"fn arch_store(found: u64, a64: bool) -> u64 {\n");
        buf_str(out, c"    let w = arch_consistent(found & ~arch_disabled(a64)) | 0x8000000000000000;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        ARCH_FEATURES = w;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    w\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// w without the features whose requirements it lacks (sha3 without sha2,\n");
        buf_str(out, c"// avx2 without avx), in the order of the implications, so that code under\n");
        buf_str(out, c"// `detect(\"sha3\")` never runs where the sha2 it may use is missing.\n");
        buf_str(out, c"fn arch_consistent(w: u64) -> u64 {\n");
        buf_str(out, c"    // (feature, what it needs) pairs: neon fp; crc aarch64; aes sha2\n");
        buf_str(out, c"    // dotprod rdm fp16 i8mm bf16 neon; sha3 sha2; sse2 .. sse4.2 the one\n");
        buf_str(out, c"    // before; avx sse4.2; avx2 and fma avx\n");
        buf_str(out, c"    let pairs: [i64; 36] = [\n");
        buf_str(out, c"        0, 1, 2, 15, 3, 0, 4, 0, 6, 0, 7, 0, 9, 0, 10, 0, 11, 0, 5, 4, 17, 16, 18, 17, 19, 18,\n");
        buf_str(out, c"        20, 19, 21, 20, 29, 21, 30, 29, 31, 29,\n");
        buf_str(out, c"    ];\n");
        buf_str(out, c"    let mut out = w;\n");
        buf_str(out, c"    let mut k = 0;\n");
        buf_str(out, c"    while k < 36 {\n");
        buf_str(out, c"        if (out & arch_bit(pairs[k])) != 0 && (out & arch_bit(pairs[k + 1])) == 0 {\n");
        buf_str(out, c"            out &= ~arch_bit(pairs[k]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        k += 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    out\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn arch_same(a: [u8], b: [u8]) -> bool {\n");
        buf_str(out, c"    if a.len != b.len {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for i in 0..a.len as i64 {\n");
        buf_str(out, c"        if a[i] != b[i] {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    true\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The bits TACHYON_ARCH_DISABLE names: features (`aarch64.aes`,\n");
        buf_str(out, c"// `x86_64.aes` qualified), `all` every one.\n");
        buf_str(out, c"fn arch_disabled(a64: bool) -> u64 {\n");
        buf_str(out, c"    let p = unsafe { arch_getenv(c\"TACHYON_ARCH_DISABLE\") };\n");
        buf_str(out, c"    if p == 0 as *u8 {\n");
        buf_str(out, c"        return 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let s = unsafe { p[0..arch_strlen(p) as i64] };\n");
        buf_str(out, c"    let mut out: u64 = 0;\n");
        buf_str(out, c"    let mut i = 0;\n");
        buf_str(out, c"    while i <= s.len as i64 {\n");
        buf_str(out, c"        let mut j = i;\n");
        buf_str(out, c"        while j < s.len as i64 && s[j] != ',' {\n");
        buf_str(out, c"            j += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out |= arch_named(s[i..j], a64);\n");
        buf_str(out, c"        i = j + 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    out\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn arch_named(name: [u8], a64: bool) -> u64 {\n");
        buf_str(out, c"    if arch_same(name, \"all\") {\n");
        buf_str(out, c"        return 0x7fffffffffffffff;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let a64_names: [[u8]; 12] = [\"neon\", \"fp\", \"crc\", \"aes\", \"sha2\", \"sha3\", \"dotprod\", \"rdm\",\n");
        buf_str(out, c"        \"lse\", \"fp16\", \"i8mm\", \"bf16\"];\n");
        buf_str(out, c"    let x86_names: [[u8]; 16] = [\"sse\", \"sse2\", \"sse3\", \"ssse3\", \"sse4.1\", \"sse4.2\", \"popcnt\",\n");
        buf_str(out, c"        \"lzcnt\", \"bmi1\", \"bmi2\", \"pclmulqdq\", \"aes\", \"sha\", \"avx\", \"avx2\", \"fma\"];\n");
        buf_str(out, c"    let mut n = name;\n");
        buf_str(out, c"    let mut on_a64 = a64;\n");
        buf_str(out, c"    if n.len > 8 && arch_same(n[0..8], \"aarch64.\") {\n");
        buf_str(out, c"        n = n[8..n.len as i64];\n");
        buf_str(out, c"        on_a64 = true;\n");
        buf_str(out, c"    } else if n.len > 7 && arch_same(n[0..7], \"x86_64.\") {\n");
        buf_str(out, c"        n = n[7..n.len as i64];\n");
        buf_str(out, c"        on_a64 = false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if on_a64 {\n");
        buf_str(out, c"        if arch_same(n, \"asimd\") {\n");
        buf_str(out, c"            return 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for k in 0..12 {\n");
        buf_str(out, c"            if arch_same(n, a64_names[k]) {\n");
        buf_str(out, c"                return arch_bit(k);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        for k in 0..16 {\n");
        buf_str(out, c"            if arch_same(n, x86_names[k]) {\n");
        buf_str(out, c"                return arch_bit(16 + k);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    0\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- CPU features on macOS (0.19) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// AArch64 macOS: sysctl's hw.optional.arm.FEAT_*, only for the features\n");
        buf_str(out, c"// the build does not assume (a default build, apple-m1, asks for two).\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[link_name = \"sysctlbyname\"]\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn arch_sysctlbyname(name: *u8, old: *u8, len: *u64, new: *u8, newlen: u64) -> i32;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether sysctl `name` (an int) is 1.\n");
        buf_str(out, c"fn arch_sysctl(name: *u8) -> bool {\n");
        buf_str(out, c"    let mut value: [u32; 2] = [0; 2];\n");
        buf_str(out, c"    let mut len: [u64; 1] = [8];\n");
        buf_str(out, c"    let r = unsafe { arch_sysctlbyname(name, &mut value as *u8, &mut len as *u64, 0 as *u8, 0) };\n");
        buf_str(out, c"    r == 0 && value[0] == 1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fills the word (`known`: the build's features): before main, or at a\n");
        buf_str(out, c"// library's first detect.\n");
        buf_str(out, c"fn arch_init_macos(known: u64) -> u64 {\n");
        buf_str(out, c"    let mut found: u64 = known | arch_bit(15) | arch_bit(0) | arch_bit(1);\n");
        buf_str(out, c"    // (bit, then the sysctls that must all be 1)\n");
        buf_str(out, c"    let names: [*u8; 13] = [\n");
        buf_str(out, c"        c\"hw.optional.arm.FEAT_CRC32\", c\"hw.optional.arm.FEAT_AES\", c\"hw.optional.arm.FEAT_PMULL\",\n");
        buf_str(out, c"        c\"hw.optional.arm.FEAT_SHA256\", c\"hw.optional.arm.FEAT_SHA3\",\n");
        buf_str(out, c"        c\"hw.optional.arm.FEAT_SHA512\", c\"hw.optional.arm.FEAT_DotProd\",\n");
        buf_str(out, c"        c\"hw.optional.arm.FEAT_RDM\", c\"hw.optional.arm.FEAT_LSE\", c\"hw.optional.arm.FEAT_FP16\",\n");
        buf_str(out, c"        c\"hw.optional.arm.FEAT_I8MM\", c\"hw.optional.arm.FEAT_BF16\", 0 as *u8,\n");
        buf_str(out, c"    ];\n");
        buf_str(out, c"    // (feature, its first name, how many)\n");
        buf_str(out, c"    let tests: [i64; 30] = [2, 0, 1, 3, 1, 2, 4, 3, 1, 5, 4, 2, 6, 6, 1, 7, 7, 1, 8, 8, 1, 9, 9, 1,\n");
        buf_str(out, c"        10, 10, 1, 11, 11, 1];\n");
        buf_str(out, c"    let mut k = 0;\n");
        buf_str(out, c"    while k < 30 {\n");
        buf_str(out, c"        if (found & arch_bit(tests[k])) == 0 {\n");
        buf_str(out, c"            let mut all = true;\n");
        buf_str(out, c"            for j in 0..tests[k + 2] {\n");
        buf_str(out, c"                if !arch_sysctl(names[tests[k + 1] + j]) {\n");
        buf_str(out, c"                    all = false;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if all {\n");
        buf_str(out, c"                found |= arch_bit(tests[k]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        k += 3;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    arch_store(found, true)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The word, filled at the first call (a library: no main filled it).\n");
        buf_str(out, c"fn arch_word_macos() -> u64 {\n");
        buf_str(out, c"    let w = unsafe { ARCH_FEATURES };\n");
        buf_str(out, c"    if w != 0 { w } else { arch_init_macos(0) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- CPU features on Linux (0.19) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// AArch64 Linux: getauxval's AT_HWCAP and AT_HWCAP2.\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[link_name = \"getauxval\"]\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn arch_getauxval(kind: u64) -> u64;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fills the word (`known`: the build's features): before main, or at a\n");
        buf_str(out, c"// library's first detect.\n");
        buf_str(out, c"fn arch_init_linux(known: u64) -> u64 {\n");
        buf_str(out, c"    let cap = unsafe { arch_getauxval(16) };\n");
        buf_str(out, c"    let cap2 = unsafe { arch_getauxval(26) };\n");
        buf_str(out, c"    // (HWCAP bits, all needed, then the feature: fp, asimd, crc32, aes and\n");
        buf_str(out, c"    // pmull, sha1 and sha2, sha3 and sha512, asimddp, asimdrdm, atomics,\n");
        buf_str(out, c"    // fphp and asimdhp)\n");
        buf_str(out, c"    let tests: [u64; 20] = [0x1, 1, 0x2, 0, 0x80, 2, 0x18, 3, 0x60, 4, 0x220000, 5, 0x100000, 6,\n");
        buf_str(out, c"        0x1000, 7, 0x100, 8, 0x600, 9];\n");
        buf_str(out, c"    let mut found: u64 = known | arch_bit(15);\n");
        buf_str(out, c"    let mut k = 0;\n");
        buf_str(out, c"    while k < 20 {\n");
        buf_str(out, c"        if (cap & tests[k]) == tests[k] {\n");
        buf_str(out, c"            found |= arch_bit(tests[k + 1] as i64);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        k += 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // (HWCAP2: i8mm, bf16)\n");
        buf_str(out, c"    if (cap2 & 0x2000) != 0 {\n");
        buf_str(out, c"        found |= arch_bit(10);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if (cap2 & 0x4000) != 0 {\n");
        buf_str(out, c"        found |= arch_bit(11);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    arch_store(found, true)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The word, filled at the first call (a library: no main filled it).\n");
        buf_str(out, c"fn arch_word_linux() -> u64 {\n");
        buf_str(out, c"    let w = unsafe { ARCH_FEATURES };\n");
        buf_str(out, c"    if w != 0 { w } else { arch_init_linux(0) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- CPU features on x86-64 (0.19) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// x86-64, either system: cpuid, and xgetbv for whether the system saves\n");
        buf_str(out, c"// the ymm registers (else no avx family: its state would be lost).\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    // (the compiler's run-time helpers, gen0/target.tach emit_arch_runtime)\n");
        buf_str(out, c"    #[link_name = \"tachyon_arch_cpuid\"]\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn arch_cpuid(leaf: u32, sub: u32, out: *u32);\n");
        buf_str(out, c"    #[link_name = \"tachyon_arch_xgetbv\"]\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn arch_xgetbv(index: u32) -> u64;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fills the word (`known`: the build's features): before main, or at a\n");
        buf_str(out, c"// library's first detect.\n");
        buf_str(out, c"fn arch_init_x86(known: u64) -> u64 {\n");
        buf_str(out, c"    let mut r: [u32; 4] = [0; 4];\n");
        buf_str(out, c"    unsafe { arch_cpuid(0, 0, &mut r as *u32); }\n");
        buf_str(out, c"    let max = r[0];\n");
        buf_str(out, c"    unsafe { arch_cpuid(1, 0, &mut r as *u32); }\n");
        buf_str(out, c"    let c1 = r[2];\n");
        buf_str(out, c"    let d1 = r[3];\n");
        buf_str(out, c"    let mut w: u64 = known | arch_bit(32);\n");
        buf_str(out, c"    // (register: 2 ecx, 3 edx; its bit; the feature: sse, sse2, sse3,\n");
        buf_str(out, c"    // ssse3, sse4.1, sse4.2, popcnt, pclmulqdq, aes)\n");
        buf_str(out, c"    let tests: [u32; 27] = [3, 25, 16, 3, 26, 17, 2, 0, 18, 2, 9, 19, 2, 19, 20, 2, 20, 21, 2,\n");
        buf_str(out, c"        23, 22, 2, 1, 26, 2, 25, 27];\n");
        buf_str(out, c"    let mut k = 0;\n");
        buf_str(out, c"    while k < 27 {\n");
        buf_str(out, c"        let reg = if tests[k] == 2 { c1 } else { d1 };\n");
        buf_str(out, c"        if (reg & ((1 as u32) << tests[k + 1])) != 0 {\n");
        buf_str(out, c"            w |= arch_bit(tests[k + 2] as i64);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        k += 3;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // osxsave, then XCR0: the system saves xmm and ymm\n");
        buf_str(out, c"    let ymm = (c1 & 0x8000000) != 0 && (unsafe { arch_xgetbv(0) } & 6) == 6;\n");
        buf_str(out, c"    if ymm && (c1 & 0x10000000) != 0 {\n");
        buf_str(out, c"        w |= arch_bit(29);\n");
        buf_str(out, c"        if (c1 & 0x1000) != 0 {\n");
        buf_str(out, c"            w |= arch_bit(31);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if max >= 7 {\n");
        buf_str(out, c"        unsafe { arch_cpuid(7, 0, &mut r as *u32); }\n");
        buf_str(out, c"        let b7 = r[1];\n");
        buf_str(out, c"        if (b7 & 0x8) != 0 {\n");
        buf_str(out, c"            w |= arch_bit(24);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if (b7 & 0x100) != 0 {\n");
        buf_str(out, c"            w |= arch_bit(25);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if (b7 & 0x20000000) != 0 {\n");
        buf_str(out, c"            w |= arch_bit(28);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if ymm && (b7 & 0x20) != 0 {\n");
        buf_str(out, c"            w |= arch_bit(30);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe { arch_cpuid(0x80000000, 0, &mut r as *u32); }\n");
        buf_str(out, c"    if r[0] >= 0x80000001 {\n");
        buf_str(out, c"        unsafe { arch_cpuid(0x80000001, 0, &mut r as *u32); }\n");
        buf_str(out, c"        if (r[2] & 0x20) != 0 {\n");
        buf_str(out, c"            w |= arch_bit(23);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    arch_store(w, false)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The word, filled at the first call (a library: no main filled it).\n");
        buf_str(out, c"fn arch_word_x86() -> u64 {\n");
        buf_str(out, c"    let w = unsafe { ARCH_FEATURES };\n");
        buf_str(out, c"    if w != 0 { w } else { arch_init_x86(0) }\n");
        buf_str(out, c"}\n");
    }
    std_alloc_tail(out);
}

// Gpa's implementation (0.16), the end of std's source unless
// --check-alloc (front/stdalloc.tach).
pub fn std_gpa_source(out: i64) {
    unsafe {
        buf_str(out, c"// ---- Gpa's implementation (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// C's allocator; malloc's memory is aligned to 16, larger alignments go\n");
        buf_str(out, c"// through posix_memalign. (--check-alloc replaces this part of std with\n");
        buf_str(out, c"// alloc_check.tach.)\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[effects(alloc(extern))]\n");
        buf_str(out, c"    fn posix_memalign(out: **u8, align: u64, size: u64) -> i32;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"const GPA_MALLOC_ALIGN: i64 = 16;\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Allocator for Gpa {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn try_alloc(self: *Gpa, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        if size == 0 {\n");
        buf_str(out, c"            // (a pointer nothing is read through)\n");
        buf_str(out, c"            return unsafe { align as *u8 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if align > GPA_MALLOC_ALIGN {\n");
        buf_str(out, c"            return gpa_aligned(size, align);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe { malloc(size as u64) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn try_resize(self: *Gpa, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        if align > GPA_MALLOC_ALIGN || new_size == 0 {\n");
        buf_str(out, c"            return gpa_resize_slow(p, old_size, new_size, align);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        realloc(if old_size == 0 { 0 as *u8 } else { p }, new_size as u64)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn free(self: *Gpa, p: *u8, size: i64, align: i64) {\n");
        buf_str(out, c"        if size != 0 {\n");
        buf_str(out, c"            free(p);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// size bytes (not 0) aligned to align (above malloc's), or null.\n");
        buf_str(out, c"fn gpa_aligned(size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    let mut p = 0 as *u8;\n");
        buf_str(out, c"    if unsafe { posix_memalign(&p, align as u64, size as u64) } != 0 {\n");
        buf_str(out, c"        return 0 as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    p\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Gpa::try_resize to 0 bytes, or above malloc's alignment.\n");
        buf_str(out, c"#[cold]\n");
        buf_str(out, c"unsafe fn gpa_resize_slow(p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    if new_size == 0 {\n");
        buf_str(out, c"        if old_size != 0 {\n");
        buf_str(out, c"            free(p);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return align as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let q = gpa_aligned(new_size, align);\n");
        buf_str(out, c"    if q == 0 as *u8 {\n");
        buf_str(out, c"        return q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let n = if old_size < new_size { old_size } else { new_size };\n");
        buf_str(out, c"    for i in 0..n {\n");
        buf_str(out, c"        q[i] = p[i];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if old_size != 0 {\n");
        buf_str(out, c"        free(p);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    q\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Gpa's leak checks (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Gpa {\n");
        buf_str(out, c"    // The blocks allocated and not freed: -1, unknown, unless --check-alloc\n");
        buf_str(out, c"    // (the checking allocator, compiler/std/alloc_check.tach).\n");
        buf_str(out, c"    pub fn live_blocks(self: &Gpa) -> i64 {\n");
        buf_str(out, c"        -1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether no block is left allocated (with --check-alloc, which lists\n");
        buf_str(out, c"    // them); always true without.\n");
        buf_str(out, c"    pub fn check_leaks(self: &Gpa) -> bool {\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) The checking allocator's leaks since a mark (alloc_check.tach):\n");
        buf_str(out, c"// nothing to count without --check-alloc.\n");
        buf_str(out, c"fn check_alloc_leaks_since(mark: i64) -> i64 {\n");
        buf_str(out, c"    0\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- The checking allocator's hooks for arenas (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// With --check-alloc (CHECK_ALLOC), arenas route each allocation to the\n");
        buf_str(out, c"// checking allocator's pages (compiler/std/alloc_check.tach); without, these\n");
        buf_str(out, c"// are never called.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A block of size bytes for the allocator whose state is at owner.\n");
        buf_str(out, c"fn check_alloc_block(owner: u64, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    0 as *u8\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// p, a block of owner of old_size bytes, moved to new_size bytes.\n");
        buf_str(out, c"unsafe fn check_alloc_moved(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"    -> *u8 {\n");
        buf_str(out, c"    0 as *u8\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The blocks allocated so far: a mark for check_alloc_release.\n");
        buf_str(out, c"fn check_alloc_mark() -> i64 {\n");
        buf_str(out, c"    0\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Every block of owner allocated after mark given back.\n");
        buf_str(out, c"fn check_alloc_release(owner: u64, mark: i64) {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether p is the last live block of owner (an arena's last block grows\n");
        buf_str(out, c"// and is given back in place).\n");
        buf_str(out, c"fn check_alloc_is_last(owner: u64, p: *u8) -> bool {\n");
        buf_str(out, c"    false\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The site of the call being run, and that site set again (a scope's end\n");
        buf_str(out, c"// is its call's).\n");
        buf_str(out, c"fn check_alloc_site() -> *u8 {\n");
        buf_str(out, c"    0 as *u8\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn check_alloc_set_site(site: *u8) {}\n");
    }
}

// The checking Gpa (0.16), the end of std's source with --check-alloc
// (front/stdalloc.tach).
pub fn std_check_gpa_source(out: i64) {
    unsafe {
        buf_str(out, c"// ---- Gpa's leak checks (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Gpa {\n");
        buf_str(out, c"    // The blocks allocated and not freed: -1, unknown, unless --check-alloc.\n");
        buf_str(out, c"    pub fn live_blocks(self: &Gpa) -> i64 {\n");
        buf_str(out, c"        CHECK_LIVE\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether no block is left allocated (with --check-alloc, which lists\n");
        buf_str(out, c"    // them); always true without.\n");
        buf_str(out, c"    pub fn check_leaks(self: &Gpa) -> bool {\n");
        buf_str(out, c"        unsafe { check_alloc_list_leaks() }\n");
        buf_str(out, c"        CHECK_LIVE == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) The blocks allocated from `mark` (check_alloc_mark) on and not\n");
        buf_str(out, c"// freed, listed as at exit (the first line names them a case's): a\n");
        buf_str(out, c"// property's case, or a fuzz run, leaks them (test_case, fuzz_exec);\n");
        buf_str(out, c"// their count.\n");
        buf_str(out, c"fn check_alloc_leaks_since(mark: i64) -> i64 {\n");
        buf_str(out, c"    let mut live = 0;\n");
        buf_str(out, c"    let mut bytes = 0;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        for b in mark..CHECK_COUNT {\n");
        buf_str(out, c"            if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"                live += 1;\n");
        buf_str(out, c"                bytes += CHECK_BLOCKS[b].size;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if live == 0 {\n");
        buf_str(out, c"            return 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let mut m = check_msg();\n");
        buf_str(out, c"        m.text(\"check-alloc: \");\n");
        buf_str(out, c"        m.int(live);\n");
        buf_str(out, c"        m.text(if live == 1 { \" block\" } else { \" blocks\" });\n");
        buf_str(out, c"        m.text(\" of Gpa not freed by the case (\");\n");
        buf_str(out, c"        m.int(bytes);\n");
        buf_str(out, c"        m.text(\" bytes):\");\n");
        buf_str(out, c"        m.out();\n");
        buf_str(out, c"        let mut shown = 0;\n");
        buf_str(out, c"        for b in mark..CHECK_COUNT {\n");
        buf_str(out, c"            if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK\n");
        buf_str(out, c"                && shown < 20 {\n");
        buf_str(out, c"                let mut line = check_msg();\n");
        buf_str(out, c"                line.text(\"  \");\n");
        buf_str(out, c"                check_describe(&line, b);\n");
        buf_str(out, c"                line.out();\n");
        buf_str(out, c"                shown += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        CHECK_LISTED = CHECK_CHANGES;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    live\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Gpa's implementation: the checking allocator (0.16, --check-alloc) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// With --check-alloc (docs/design/effects-allocation.md, §2.5), Gpa gives\n");
        buf_str(out, c"// every block pages of its own, at the cursor of a large reservation of\n");
        buf_str(out, c"// address space with no access: a block's pages are made readable and\n");
        buf_str(out, c"// writable when it is allocated, and are given back with no access when it\n");
        buf_str(out, c"// is freed, never to be handed out again; every resize moves. A later\n");
        buf_str(out, c"// access to a freed block faults, and the fault handler names the block,\n");
        buf_str(out, c"// where it was allocated and where freed (the compiler stores the site of\n");
        buf_str(out, c"// each call from the program that may allocate in CHECK_ALLOC_SITE). Frees\n");
        buf_str(out, c"// are checked: double, invalid and wrong-size frees stop the program; the\n");
        buf_str(out, c"// blocks left at exit are listed. Arenas route their allocations here too\n");
        buf_str(out, c"// (check_alloc_block, check_alloc_release). Block numbers count every\n");
        buf_str(out, c"// allocation from 1, the same each run: TACHYON_ALLOC_TRAP=N raises SIGTRAP\n");
        buf_str(out, c"// when block N is allocated, for a debugger.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Its messages and stops are the allocator's misuse, the effect `alloc`:\n");
        buf_str(out, c"// not io, which an allocator may not do.)\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[effects(alloc(extern), global)]\n");
        buf_str(out, c"    fn mmap(addr: *u8, len: u64, prot: i32, flags: i32, fd: i32, offset: i64) -> *u8;\n");
        buf_str(out, c"    #[effects(alloc(extern), global)]\n");
        buf_str(out, c"    fn mprotect(addr: *u8, len: u64, prot: i32) -> i32;\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn getpagesize() -> i32;\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn getenv(name: *u8) -> *u8;\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn raise(sig: i32) -> i32;\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn atexit(f: extern \"C\" fn()) -> i32;\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn sigaction(sig: i32, act: *CheckSigaction, old: *CheckSigaction) -> i32;\n");
        buf_str(out, c"    #[link_name = \"write\"]\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn check_write(fd: i32, data: *u8, count: u64) -> i64;\n");
        buf_str(out, c"    #[effects(diverge)]\n");
        buf_str(out, c"    fn _exit(code: i32) -> !;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The site of the program's call being run that may allocate (`main.tach:\n");
        buf_str(out, c"// 14:9`, a C string), stored by the compiled program before the call.\n");
        buf_str(out, c"static mut CHECK_ALLOC_SITE: *u8 = 0 as *u8;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A block: its pages [start, start + span), its size, its allocator (0:\n");
        buf_str(out, c"// Gpa, else an arena's state), its state, and where it was allocated and\n");
        buf_str(out, c"// freed.\n");
        buf_str(out, c"struct CheckBlock {\n");
        buf_str(out, c"    start: u64,\n");
        buf_str(out, c"    size: i64,\n");
        buf_str(out, c"    span: i64,\n");
        buf_str(out, c"    owner: u64,\n");
        buf_str(out, c"    state: i64,\n");
        buf_str(out, c"    alloc_site: *u8,\n");
        buf_str(out, c"    free_site: *u8,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"const CHECK_LIVE_BLOCK: i64 = 1;\n");
        buf_str(out, c"const CHECK_FREED: i64 = 2;\n");
        buf_str(out, c"const CHECK_RELEASED: i64 = 3;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Every block, in the order allocated (block #N is CHECK_BLOCKS[N - 1]).\n");
        buf_str(out, c"static mut CHECK_BLOCKS: *CheckBlock = 0 as *CheckBlock;\n");
        buf_str(out, c"static mut CHECK_COUNT: i64 = 0;\n");
        buf_str(out, c"static mut CHECK_CAP: i64 = 0;\n");
        buf_str(out, c"// The live blocks of Gpa (arenas' blocks are not counted).\n");
        buf_str(out, c"static mut CHECK_LIVE: i64 = 0;\n");
        buf_str(out, c"// The reservations of address space (regions): their bounds and their\n");
        buf_str(out, c"// first block; a region's blocks follow each other (blocks are never\n");
        buf_str(out, c"// placed in an earlier region), so the blocks are sorted by address within\n");
        buf_str(out, c"// one. The cursor is in the last region.\n");
        buf_str(out, c"const CHECK_MAX_REGIONS: i64 = 256;\n");
        buf_str(out, c"static mut CHECK_REGION_START: [u64; 256] = [0; 256];\n");
        buf_str(out, c"static mut CHECK_REGION_END: [u64; 256] = [0; 256];\n");
        buf_str(out, c"static mut CHECK_REGION_FIRST: [i64; 256] = [0; 256];\n");
        buf_str(out, c"static mut CHECK_REGIONS: i64 = 0;\n");
        buf_str(out, c"static mut CHECK_CURSOR: u64 = 0;\n");
        buf_str(out, c"// The page size, 0 until the first allocation.\n");
        buf_str(out, c"static mut CHECK_PAGE: i64 = 0;\n");
        buf_str(out, c"// TACHYON_ALLOC_TRAP; TACHYON_ALLOC_MAX_LIVE (the map limit's message when\n");
        buf_str(out, c"// this many blocks are live: for tests, on any system); 0 when unset.\n");
        buf_str(out, c"static mut CHECK_TRAP: i64 = 0;\n");
        buf_str(out, c"static mut CHECK_MAX_LIVE: i64 = 0;\n");
        buf_str(out, c"// The changes to the blocks (allocations and frees), and their count when\n");
        buf_str(out, c"// check_leaks listed the leaks (the exit's list is left out then).\n");
        buf_str(out, c"static mut CHECK_CHANGES: i64 = 0;\n");
        buf_str(out, c"static mut CHECK_LISTED: i64 = -1;\n");
        buf_str(out, c"\n");
        buf_str(out, c"const CHECK_REGION_BYTES: u64 = 68719476736;\n");
        buf_str(out, c"const CHECK_PROT_NONE: i32 = 0;\n");
        buf_str(out, c"const CHECK_PROT_RW: i32 = 3;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The system's constants: macOS (CHECK_ALLOC_OS 0) and Linux (1).\n");
        buf_str(out, c"fn check_map_flags() -> i32 {\n");
        buf_str(out, c"    // MAP_PRIVATE | MAP_ANON | MAP_NORESERVE\n");
        buf_str(out, c"    if CHECK_ALLOC_OS == 1 { 2 | 32 | 16384 } else { 2 | 4096 | 64 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"const CHECK_MAP_FIXED: i32 = 16;\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn check_sigbus() -> i32 {\n");
        buf_str(out, c"    if CHECK_ALLOC_OS == 1 { 7 } else { 10 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// struct sigaction: the handler, then (macOS) a 4-byte mask and the flags,\n");
        buf_str(out, c"// or (glibc) a 128-byte mask and the flags.\n");
        buf_str(out, c"#[repr(C)]\n");
        buf_str(out, c"struct CheckSigaction { handler: extern \"C\" fn(i32, *u8, *u8), words: [u64; 19] }\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn check_sigaction() -> CheckSigaction {\n");
        buf_str(out, c"    let mut a = CheckSigaction { handler: unsafe { check_alloc_fault }, words: [0; 19] };\n");
        buf_str(out, c"    if CHECK_ALLOC_OS == 1 {\n");
        buf_str(out, c"        // SA_SIGINFO | SA_RESETHAND\n");
        buf_str(out, c"        a.words[16] = 4 | 2147483648;\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        a.words[0] = (64 | 4) << 32;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    a\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The offset of si_addr in siginfo_t.\n");
        buf_str(out, c"fn check_si_addr() -> u64 {\n");
        buf_str(out, c"    if CHECK_ALLOC_OS == 1 { 16 } else { 24 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A message, written to stderr at once.\n");
        buf_str(out, c"struct CheckMsg { len: i64, bytes: [u8; 2048] }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl CheckMsg {\n");
        buf_str(out, c"    fn text(self: &mut CheckMsg, s: [u8]) {\n");
        buf_str(out, c"        for i in 0..s.len {\n");
        buf_str(out, c"            if self.len < 2048 {\n");
        buf_str(out, c"                self.bytes[self.len] = s[i];\n");
        buf_str(out, c"                self.len += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    unsafe fn cstr(self: &mut CheckMsg, s: *u8) {\n");
        buf_str(out, c"        let mut n = 0;\n");
        buf_str(out, c"        while s[n] != 0 {\n");
        buf_str(out, c"            n += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.text(s[0..n]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn int(self: &mut CheckMsg, v: i64) {\n");
        buf_str(out, c"        if v < 0 {\n");
        buf_str(out, c"            self.text(\"-\");\n");
        buf_str(out, c"            self.int(0 - v);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if v >= 10 {\n");
        buf_str(out, c"            self.int(v / 10);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let d: [u8; 1] = [('0' as i64 + v % 10) as u8];\n");
        buf_str(out, c"        self.text(d[0..1]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn hex(self: &mut CheckMsg, v: u64) {\n");
        buf_str(out, c"        self.text(\"0x\");\n");
        buf_str(out, c"        let digits = \"0123456789abcdef\";\n");
        buf_str(out, c"        let mut started = false;\n");
        buf_str(out, c"        for k in 0..16 {\n");
        buf_str(out, c"            let d = (v >> ((15 - k) * 4) as u64) & 15;\n");
        buf_str(out, c"            if d != 0 || started || k == 15 {\n");
        buf_str(out, c"                started = true;\n");
        buf_str(out, c"                self.text(digits[d as i64..d as i64 + 1]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    unsafe fn site(self: &mut CheckMsg, s: *u8) {\n");
        buf_str(out, c"        if s == 0 as *u8 {\n");
        buf_str(out, c"            self.text(\"an unknown place\");\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.cstr(s);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // `block #N (48 bytes)`, ` of an arena`.\n");
        buf_str(out, c"    fn block(self: &mut CheckMsg, b: i64) {\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.text(\"block #\");\n");
        buf_str(out, c"            self.int(b + 1);\n");
        buf_str(out, c"            self.text(\" (\");\n");
        buf_str(out, c"            self.int(CHECK_BLOCKS[b].size);\n");
        buf_str(out, c"            self.text(if CHECK_BLOCKS[b].size == 1 { \" byte)\" } else { \" bytes)\" });\n");
        buf_str(out, c"            if CHECK_BLOCKS[b].owner != 0 {\n");
        buf_str(out, c"                self.text(\" of an arena\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn out(self: &mut CheckMsg) {\n");
        buf_str(out, c"        self.text(\"\\n\");\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            check_write(2, &self.bytes[0], self.len as u64);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn check_msg() -> CheckMsg {\n");
        buf_str(out, c"    CheckMsg { len: 0, bytes: [0; 2048] }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Stops the program with message m (exit 101, without the leaks' list).\n");
        buf_str(out, c"fn check_stop(m: &mut CheckMsg) -> ! {\n");
        buf_str(out, c"    m.out();\n");
        buf_str(out, c"    unsafe { _exit(101) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `block #N (48 bytes), allocated at X[, freed at Y]`.\n");
        buf_str(out, c"unsafe fn check_describe(m: *CheckMsg, b: i64) {\n");
        buf_str(out, c"    m.block(b);\n");
        buf_str(out, c"    m.text(\", allocated at \");\n");
        buf_str(out, c"    m.site(CHECK_BLOCKS[b].alloc_site);\n");
        buf_str(out, c"    if CHECK_BLOCKS[b].state != CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"        m.text(if CHECK_BLOCKS[b].state == CHECK_FREED { \", freed at \" } else { \", released at \" });\n");
        buf_str(out, c"        m.site(CHECK_BLOCKS[b].free_site);\n");
        buf_str(out, c"        if CHECK_BLOCKS[b].state == CHECK_RELEASED {\n");
        buf_str(out, c"            m.text(\" (the arena's reset or scope end)\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The decimal number in C string s (0 when null or none).\n");
        buf_str(out, c"unsafe fn check_env_int(name: *u8) -> i64 {\n");
        buf_str(out, c"    let s = getenv(name);\n");
        buf_str(out, c"    if s == 0 as *u8 {\n");
        buf_str(out, c"        return 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut v = 0;\n");
        buf_str(out, c"    let mut i = 0;\n");
        buf_str(out, c"    while s[i] >= '0' && s[i] <= '9' {\n");
        buf_str(out, c"        v = v * 10 + (s[i] - '0') as i64;\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The first allocation: the page size, the fault handlers, the leaks'\n");
        buf_str(out, c"// list at exit, the environment.\n");
        buf_str(out, c"unsafe fn check_init() {\n");
        buf_str(out, c"    CHECK_PAGE = getpagesize() as i64;\n");
        buf_str(out, c"    let a = check_sigaction();\n");
        buf_str(out, c"    sigaction(11, &a, 0 as *CheckSigaction);\n");
        buf_str(out, c"    sigaction(check_sigbus(), &a, 0 as *CheckSigaction);\n");
        buf_str(out, c"    atexit(check_alloc_at_exit);\n");
        buf_str(out, c"    CHECK_TRAP = check_env_int(c\"TACHYON_ALLOC_TRAP\");\n");
        buf_str(out, c"    CHECK_MAX_LIVE = check_env_int(c\"TACHYON_ALLOC_MAX_LIVE\");\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The system refused to change a block's pages: on Linux, the limit of\n");
        buf_str(out, c"// memory maps (each run of live blocks between freed ones is a map).\n");
        buf_str(out, c"unsafe fn check_map_limit() -> ! {\n");
        buf_str(out, c"    let mut m = check_msg();\n");
        buf_str(out, c"    m.text(\"check-alloc: out of memory maps at block #\");\n");
        buf_str(out, c"    m.int(CHECK_COUNT + 1);\n");
        buf_str(out, c"    m.text(\", with \");\n");
        buf_str(out, c"    m.int(CHECK_LIVE);\n");
        buf_str(out, c"    m.text(\" blocks live: the kernel's vm.max_map_count is reached (every live block has pages of its own)\");\n");
        buf_str(out, c"    m.text(\"\\ntry: sudo sysctl vm.max_map_count=1048576\");\n");
        buf_str(out, c"    check_stop(&mut m)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A new region of at least `bytes`, or false.\n");
        buf_str(out, c"unsafe fn check_reserve(bytes: u64) -> bool {\n");
        buf_str(out, c"    if CHECK_REGIONS == CHECK_MAX_REGIONS {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut size = CHECK_REGION_BYTES;\n");
        buf_str(out, c"    while size < bytes {\n");
        buf_str(out, c"        size = size * 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        let p = mmap(0 as *u8, size, CHECK_PROT_NONE, check_map_flags(), -1, 0);\n");
        buf_str(out, c"        if p as i64 != -1 {\n");
        buf_str(out, c"            let r = CHECK_REGIONS;\n");
        buf_str(out, c"            CHECK_REGION_START[r] = p as u64;\n");
        buf_str(out, c"            CHECK_REGION_END[r] = p as u64 + size;\n");
        buf_str(out, c"            CHECK_REGION_FIRST[r] = CHECK_COUNT;\n");
        buf_str(out, c"            CHECK_REGIONS += 1;\n");
        buf_str(out, c"            CHECK_CURSOR = p as u64;\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // (less address space: smaller reservations)\n");
        buf_str(out, c"        if size / 2 < bytes || size <= 1073741824 {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        size = size / 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A new block of size bytes on pages of its own, for allocator owner (0:\n");
        buf_str(out, c"// Gpa), or null when out of memory.\n");
        buf_str(out, c"unsafe fn check_new_block(owner: u64, size: i64) -> *u8 {\n");
        buf_str(out, c"    if CHECK_PAGE == 0 {\n");
        buf_str(out, c"        check_init();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if size < 0 || size > 4611686018427387904 {\n");
        buf_str(out, c"        return 0 as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let page = CHECK_PAGE as u64;\n");
        buf_str(out, c"    let span = (size as u64 + page - 1) / page * page;\n");
        buf_str(out, c"    if CHECK_REGIONS == 0 || CHECK_CURSOR + span > CHECK_REGION_END[CHECK_REGIONS - 1] {\n");
        buf_str(out, c"        if !check_reserve(span) {\n");
        buf_str(out, c"            return 0 as *u8;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_MAX_LIVE > 0 && CHECK_LIVE >= CHECK_MAX_LIVE {\n");
        buf_str(out, c"        check_map_limit();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let p = CHECK_CURSOR as *u8;\n");
        buf_str(out, c"    if mprotect(p, span, CHECK_PROT_RW) != 0 {\n");
        buf_str(out, c"        if CHECK_ALLOC_OS == 1 {\n");
        buf_str(out, c"            check_map_limit();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return 0 as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    CHECK_CURSOR += span;\n");
        buf_str(out, c"    if CHECK_COUNT == CHECK_CAP {\n");
        buf_str(out, c"        CHECK_CAP = if CHECK_CAP == 0 { 1024 } else { CHECK_CAP * 2 };\n");
        buf_str(out, c"        CHECK_BLOCKS = realloc(CHECK_BLOCKS as *u8, (CHECK_CAP * size_of(CheckBlock)) as u64)\n");
        buf_str(out, c"            as *CheckBlock;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    CHECK_BLOCKS[CHECK_COUNT] = CheckBlock {\n");
        buf_str(out, c"        start: p as u64,\n");
        buf_str(out, c"        size: size,\n");
        buf_str(out, c"        span: span as i64,\n");
        buf_str(out, c"        owner: owner,\n");
        buf_str(out, c"        state: CHECK_LIVE_BLOCK,\n");
        buf_str(out, c"        alloc_site: CHECK_ALLOC_SITE,\n");
        buf_str(out, c"        free_site: 0 as *u8,\n");
        buf_str(out, c"    };\n");
        buf_str(out, c"    CHECK_COUNT += 1;\n");
        buf_str(out, c"    CHECK_CHANGES += 1;\n");
        buf_str(out, c"    if owner == 0 {\n");
        buf_str(out, c"        CHECK_LIVE += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_COUNT == CHECK_TRAP {\n");
        buf_str(out, c"        let mut m = check_msg();\n");
        buf_str(out, c"        m.text(\"check-alloc: \");\n");
        buf_str(out, c"        check_describe(&m, CHECK_COUNT - 1);\n");
        buf_str(out, c"        m.text(\" (TACHYON_ALLOC_TRAP): SIGTRAP\");\n");
        buf_str(out, c"        m.out();\n");
        buf_str(out, c"        raise(5);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    p\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Block b's pages given back, with no access, never used again.\n");
        buf_str(out, c"unsafe fn check_drop_block(b: i64, state: i64) {\n");
        buf_str(out, c"    let p = CHECK_BLOCKS[b].start as *u8;\n");
        buf_str(out, c"    let span = CHECK_BLOCKS[b].span as u64;\n");
        buf_str(out, c"    let flags = check_map_flags() | CHECK_MAP_FIXED;\n");
        buf_str(out, c"    if mmap(p, span, CHECK_PROT_NONE, flags, -1, 0) != p {\n");
        buf_str(out, c"        if CHECK_ALLOC_OS == 1 {\n");
        buf_str(out, c"            check_map_limit();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // (the pages keep their contents, but no access)\n");
        buf_str(out, c"        mprotect(p, span, CHECK_PROT_NONE);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"        CHECK_LIVE -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    CHECK_BLOCKS[b].state = state;\n");
        buf_str(out, c"    CHECK_BLOCKS[b].free_site = CHECK_ALLOC_SITE;\n");
        buf_str(out, c"    CHECK_CHANGES += 1;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The block whose pages hold address a; -1 when a is outside the\n");
        buf_str(out, c"// reservations, -2 when in one but in no block.\n");
        buf_str(out, c"unsafe fn check_find(a: u64) -> i64 {\n");
        buf_str(out, c"    for r in 0..CHECK_REGIONS {\n");
        buf_str(out, c"        if a >= CHECK_REGION_START[r] && a < CHECK_REGION_END[r] {\n");
        buf_str(out, c"            let mut lo = CHECK_REGION_FIRST[r];\n");
        buf_str(out, c"            let mut hi = if r + 1 < CHECK_REGIONS { CHECK_REGION_FIRST[r + 1] }\n");
        buf_str(out, c"                else { CHECK_COUNT };\n");
        buf_str(out, c"            // the last block starting at or before a\n");
        buf_str(out, c"            while lo < hi {\n");
        buf_str(out, c"                let mid = (lo + hi) / 2;\n");
        buf_str(out, c"                if CHECK_BLOCKS[mid].start <= a {\n");
        buf_str(out, c"                    lo = mid + 1;\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    hi = mid;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let b = lo - 1;\n");
        buf_str(out, c"            if b >= CHECK_REGION_FIRST[r]\n");
        buf_str(out, c"                && a < CHECK_BLOCKS[b].start + CHECK_BLOCKS[b].span as u64 {\n");
        buf_str(out, c"                return b;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return -2;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    -1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The live block p of `size` bytes from allocator owner, being freed or\n");
        buf_str(out, c"// resized: its index, or the program stops.\n");
        buf_str(out, c"unsafe fn check_owned(p: *u8, size: i64, owner: u64, freeing: bool) -> i64 {\n");
        buf_str(out, c"    let b = check_find(p as u64);\n");
        buf_str(out, c"    let mut m = check_msg();\n");
        buf_str(out, c"    if b < 0 || CHECK_BLOCKS[b].start != p as u64 {\n");
        buf_str(out, c"        m.text(if freeing { \"invalid free at \" } else { \"invalid resize at \" });\n");
        buf_str(out, c"        m.site(CHECK_ALLOC_SITE);\n");
        buf_str(out, c"        m.text(\": \");\n");
        buf_str(out, c"        m.hex(p as u64);\n");
        buf_str(out, c"        if b >= 0 {\n");
        buf_str(out, c"            m.text(\" is \");\n");
        buf_str(out, c"            m.int((p as u64 - CHECK_BLOCKS[b].start) as i64);\n");
        buf_str(out, c"            m.text(\" bytes into \");\n");
        buf_str(out, c"            check_describe(&m, b);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            m.text(if owner == 0 { \" is not a block of Gpa\" }\n");
        buf_str(out, c"                else { \" is not a block of the arena\" });\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        check_stop(&mut m);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_BLOCKS[b].state != CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"        m.text(if freeing { \"double free: \" } else { \"resize after free: \" });\n");
        buf_str(out, c"        check_describe(&m, b);\n");
        buf_str(out, c"        m.text(if freeing { \", freed again at \" } else { \", resized at \" });\n");
        buf_str(out, c"        m.site(CHECK_ALLOC_SITE);\n");
        buf_str(out, c"        check_stop(&mut m);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_BLOCKS[b].owner != owner {\n");
        buf_str(out, c"        m.text(if freeing { \"invalid free at \" } else { \"invalid resize at \" });\n");
        buf_str(out, c"        m.site(CHECK_ALLOC_SITE);\n");
        buf_str(out, c"        m.text(\": \");\n");
        buf_str(out, c"        check_describe(&m, b);\n");
        buf_str(out, c"        m.text(if owner == 0 { \", given to Gpa\" } else { \", given to another allocator\" });\n");
        buf_str(out, c"        check_stop(&mut m);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_BLOCKS[b].size != size {\n");
        buf_str(out, c"        m.text(if freeing { \"wrong-size free: \" } else { \"wrong-size resize: \" });\n");
        buf_str(out, c"        check_describe(&m, b);\n");
        buf_str(out, c"        m.text(if freeing { \", freed as \" } else { \", resized as \" });\n");
        buf_str(out, c"        m.int(size);\n");
        buf_str(out, c"        m.text(if size == 1 { \" byte at \" } else { \" bytes at \" });\n");
        buf_str(out, c"        m.site(CHECK_ALLOC_SITE);\n");
        buf_str(out, c"        check_stop(&mut m);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    b\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// p (old_size bytes from owner) moved to a new block of new_size bytes, or\n");
        buf_str(out, c"// null (p untouched).\n");
        buf_str(out, c"unsafe fn check_move(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    if old_size == 0 {\n");
        buf_str(out, c"        return check_alloc_block(owner, new_size, align);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let b = check_owned(p, old_size, owner, false);\n");
        buf_str(out, c"    if new_size == 0 {\n");
        buf_str(out, c"        check_drop_block(b, CHECK_FREED);\n");
        buf_str(out, c"        return align as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let q = check_new_block(owner, new_size);\n");
        buf_str(out, c"    if q == 0 as *u8 {\n");
        buf_str(out, c"        return q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    memcpy(q, p, (if old_size < new_size { old_size } else { new_size }) as u64);\n");
        buf_str(out, c"    check_drop_block(b, CHECK_FREED);\n");
        buf_str(out, c"    q\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas, with --check-alloc) A block of size bytes on pages of its own\n");
        buf_str(out, c"// for the allocator whose state is at owner (0: Gpa), or null; size 0: an\n");
        buf_str(out, c"// aligned pointer, no block.\n");
        buf_str(out, c"fn check_alloc_block(owner: u64, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    if size == 0 {\n");
        buf_str(out, c"        return unsafe { align as *u8 };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe { check_new_block(owner, size) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas) p, a block of owner of old_size bytes, moved to new_size bytes.\n");
        buf_str(out, c"unsafe fn check_alloc_moved(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"    -> *u8 {\n");
        buf_str(out, c"    check_move(owner, p, old_size, new_size, align)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas) The blocks allocated so far: a mark for check_alloc_release.\n");
        buf_str(out, c"fn check_alloc_mark() -> i64 {\n");
        buf_str(out, c"    CHECK_COUNT\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas: a reset, a scope's end) Every block of owner allocated after\n");
        buf_str(out, c"// mark is given back: a later access faults.\n");
        buf_str(out, c"fn check_alloc_release(owner: u64, mark: i64) {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        for b in mark..CHECK_COUNT {\n");
        buf_str(out, c"            if CHECK_BLOCKS[b].owner == owner && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"                check_drop_block(b, CHECK_RELEASED);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas) The site of the call being run, and that site set again: a\n");
        buf_str(out, c"// scope's end is reported at the scope's call, not at the last call in it.\n");
        buf_str(out, c"fn check_alloc_site() -> *u8 {\n");
        buf_str(out, c"    unsafe { CHECK_ALLOC_SITE }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn check_alloc_set_site(site: *u8) {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        CHECK_ALLOC_SITE = site;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas) Whether p starts the last live block of owner: the block an\n");
        buf_str(out, c"// arena grows, or gives back, in place.\n");
        buf_str(out, c"fn check_alloc_is_last(owner: u64, p: *u8) -> bool {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        for k in 0..CHECK_COUNT {\n");
        buf_str(out, c"            let b = CHECK_COUNT - 1 - k;\n");
        buf_str(out, c"            if CHECK_BLOCKS[b].owner == owner && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"                return CHECK_BLOCKS[b].start == p as u64;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (--check-unsafe with --check-alloc) The access of size bytes at p:\n");
        buf_str(out, c"// false when p is no memory of the checking allocator, true when it is in\n");
        buf_str(out, c"// bounds of a live block; else the program stops.\n");
        buf_str(out, c"pub unsafe fn check_alloc_access(p: u64, size: u64, site: *u8) -> bool {\n");
        buf_str(out, c"    let b = check_find(p);\n");
        buf_str(out, c"    if b == -1 {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut m = check_msg();\n");
        buf_str(out, c"    if b >= 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"        if p + size <= CHECK_BLOCKS[b].start + CHECK_BLOCKS[b].size as u64 {\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        m.text(\"unsafe access out of bounds: \");\n");
        buf_str(out, c"    } else if b >= 0 {\n");
        buf_str(out, c"        m.text(\"unsafe access after free: \");\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        m.text(\"unsafe access outside every block: \");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    m.int(size as i64);\n");
        buf_str(out, c"    m.text(if size == 1 { \" byte at \" } else { \" bytes at \" });\n");
        buf_str(out, c"    if b >= 0 {\n");
        buf_str(out, c"        m.text(\"offset \");\n");
        buf_str(out, c"        m.int((p - CHECK_BLOCKS[b].start) as i64);\n");
        buf_str(out, c"        m.text(\" of \");\n");
        buf_str(out, c"        check_describe(&m, b);\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        m.hex(p);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    m.text(\"\\n --> \");\n");
        buf_str(out, c"    m.site(site);\n");
        buf_str(out, c"    check_stop(&mut m)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// SIGSEGV, SIGBUS: an access to a freed block (or to the pages after the\n");
        buf_str(out, c"// last one) is reported; any other fault happens again with the default\n");
        buf_str(out, c"// action (SA_RESETHAND), as without --check-alloc.\n");
        buf_str(out, c"extern \"C\" fn check_alloc_fault(sig: i32, info: *u8, context: *u8) {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let a = *((info as u64 + check_si_addr()) as *u64);\n");
        buf_str(out, c"        let b = check_find(a);\n");
        buf_str(out, c"        if b == -1 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let mut m = check_msg();\n");
        buf_str(out, c"        if b >= 0 {\n");
        buf_str(out, c"            m.text(if CHECK_BLOCKS[b].state == CHECK_RELEASED { \"use after release: \" }\n");
        buf_str(out, c"                else { \"use after free: \" });\n");
        buf_str(out, c"            check_describe(&m, b);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            m.text(\"access outside every block: \");\n");
        buf_str(out, c"            m.hex(a);\n");
        buf_str(out, c"            m.text(\" (memory the checking allocator never handed out)\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        check_stop(&mut m);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The live blocks of Gpa, listed (at most 20).\n");
        buf_str(out, c"unsafe fn check_alloc_list_leaks() {\n");
        buf_str(out, c"    CHECK_LISTED = CHECK_CHANGES;\n");
        buf_str(out, c"    if CHECK_LIVE <= 0 {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut m = check_msg();\n");
        buf_str(out, c"    let mut bytes = 0;\n");
        buf_str(out, c"    for b in 0..CHECK_COUNT {\n");
        buf_str(out, c"        if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"            bytes += CHECK_BLOCKS[b].size;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    m.text(\"check-alloc: \");\n");
        buf_str(out, c"    m.int(CHECK_LIVE);\n");
        buf_str(out, c"    m.text(if CHECK_LIVE == 1 { \" block\" } else { \" blocks\" });\n");
        buf_str(out, c"    m.text(\" of Gpa not freed (\");\n");
        buf_str(out, c"    m.int(bytes);\n");
        buf_str(out, c"    m.text(\" bytes):\");\n");
        buf_str(out, c"    m.out();\n");
        buf_str(out, c"    let mut shown = 0;\n");
        buf_str(out, c"    for b in 0..CHECK_COUNT {\n");
        buf_str(out, c"        if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"            if shown == 20 {\n");
        buf_str(out, c"                let mut more = check_msg();\n");
        buf_str(out, c"                more.text(\"  and \");\n");
        buf_str(out, c"                more.int(CHECK_LIVE - shown);\n");
        buf_str(out, c"                more.text(\" more\");\n");
        buf_str(out, c"                more.out();\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let mut line = check_msg();\n");
        buf_str(out, c"            line.text(\"  \");\n");
        buf_str(out, c"            check_describe(&line, b);\n");
        buf_str(out, c"            line.out();\n");
        buf_str(out, c"            shown += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// At exit: the leaks, unless check_leaks listed them and nothing changed\n");
        buf_str(out, c"// since.\n");
        buf_str(out, c"extern \"C\" fn check_alloc_at_exit() {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        if CHECK_LISTED != CHECK_CHANGES {\n");
        buf_str(out, c"            check_alloc_list_leaks();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Allocator for Gpa {\n");
        buf_str(out, c"    fn try_alloc(self: *Gpa, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        check_alloc_block(0, size, align)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    unsafe fn try_resize(self: *Gpa, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        check_move(0, p, old_size, new_size, align)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    unsafe fn free(self: *Gpa, p: *u8, size: i64, align: i64) {\n");
        buf_str(out, c"        if size == 0 && check_find(p as u64) == -1 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        check_drop_block(check_owned(p, size, 0, true), CHECK_FREED);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
    }
}

// (0.15) The index of std's sections (compiler/std/index.awk): what
// each defines and needs, so that a program's loader lexes only the
// sections it can reach (front/modules: load_std_sections).
pub fn std_index(out: i64) {
    unsafe {
        buf_str(out, c"0 2691 1|panic panic_note|panic panic_note||\n");
        buf_str(out, c"2691 4330 1|Option Result|Option Result||0\n");
        buf_str(out, c"4330 12901 1|Vec|Vec|Drop Vec|0 1 6 32 33 36 38 49\n");
        buf_str(out, c"12901 13973 1|capacity allocator try_reserve try_push|||1 2 32\n");
        buf_str(out, c"13973 17865 1|Buf decimal_len put_decimal|Buf decimal_len put_decimal|Drop Buf|2 32 33 36 38 49\n");
        buf_str(out, c"17865 18502 1|with_capacity_in capacity reserve allocator|||2 4 32\n");
        buf_str(out, c"18502 29275 1|Add Sub Mul Div Neg Eq Ord Hash hash_u64 sort SORT_SMALL quicksort insertion_sort swap_at swap_raw heapsort sift_down sort|Add Sub Mul Div Neg Eq Ord Hash hash_u64 sort SORT_SMALL quicksort insertion_sort swap_at swap_raw heapsort sift_down|Eq * Ord * Hash * Eq * Ord * Hash * Eq * Ord * Hash * Eq * Ord * Hash * Eq * Ord * Hash * Eq * Ord * Hash * Eq * Ord * Hash * Eq * Ord * Hash * Eq bool Ord bool Hash bool Eq * Ord * Hash *|2 29 32\n");
        buf_str(out, c"29275 32958 0|sort_stable_in sort_stable sort_stable_by STABLE_RUN sort_stable_by_in|sort_stable_in sort_stable sort_stable_by STABLE_RUN sort_stable_by_in||2 6 32 33 49\n");
        buf_str(out, c"32958 42377 0|HashMap SLOT_FREE SLOT_FULL SLOT_GONE|HashMap SLOT_FREE SLOT_FULL SLOT_GONE|Drop HashMap|1 6 30 32 33 36 38 49\n");
        buf_str(out, c"42377 43204 0|allocator with_capacity_in|||6 8 30 32\n");
        buf_str(out, c"43204 43894 1|contract_check|contract_check||0\n");
        buf_str(out, c"43894 49143 0|Iterator Iterator IntoIterator|Iterator||1 2 12 32 33 38 49\n");
        buf_str(out, c"49143 54350 0|Map Filter Enumerate Zip Take|Map Filter Enumerate Zip Take|Iterator Map Iterator Filter Iterator Enumerate Iterator Zip Iterator Take|1 11\n");
        buf_str(out, c"54350 63980 0|Range RangeInclusive SliceIter SliceRefIter HashMapIter Keys Values sort_by iter iter_ref sort_by swap keys values|Range RangeInclusive SliceIter SliceRefIter HashMapIter Keys Values sort_by|Iterator Range Iterator RangeInclusive Iterator SliceIter Iterator SliceRefIter Iterator HashMapIter Iterator Keys Iterator Values|1 2 6 8 11 29 30 32 38\n");
        buf_str(out, c"63980 64336 0|get|||1\n");
        buf_str(out, c"64336 64862 1||||\n");
        buf_str(out, c"64862 67260 1|STDIN_BUF STDIN_POS STDIN_LEN STDIN_BLOCK stdin_fill read_line read_stdin_in|STDIN_BUF STDIN_POS STDIN_LEN STDIN_BLOCK stdin_fill read_line read_stdin_in||1 4 18 32\n");
        buf_str(out, c"67260 73031 0|is_space is_digit trim parse_int read_stdin split_in split split_whitespace split_whitespace_in Scanner|is_space is_digit trim parse_int read_stdin split_in split split_whitespace split_whitespace_in Scanner||1 2 4 16 18 32 33 49\n");
        buf_str(out, c"73031 75364 1|IoError ParseIntError ScanError|IoError ParseIntError ScanError|Display IoError Debug IoError Display ParseIntError Debug ParseIntError Display ScanError Debug ScanError|23 25\n");
        buf_str(out, c"75364 75953 0|I8_MIN I8_MAX I16_MIN I16_MAX I32_MIN I32_MAX I64_MIN I64_MAX U8_MAX U16_MAX U32_MAX U64_MAX|I8_MIN I8_MAX I16_MIN I16_MAX I32_MIN I32_MAX I64_MIN I64_MAX U8_MAX U16_MAX U32_MAX U64_MAX||\n");
        buf_str(out, c"75953 77016 0|count_ones leading_zeros trailing_zeros|count_ones leading_zeros trailing_zeros||\n");
        buf_str(out, c"77016 78108 1||||23\n");
        buf_str(out, c"78108 78893 1|print println print_int print_cstr|print println print_int print_cstr||23 25\n");
        buf_str(out, c"78893 100485 1|eprint eprintln format_in __fmt_tmp __fmt_in_end __buf_fmt __buf_fmt_end format fmt_to_vec fmt_end_vec Display Debug FMT_LEFT FMT_RIGHT FMT_ZERO FMT_HEX FMT_UPPER FMT_BIN FMT_CHAR FMT_NUM FMT_PAD FMT_CAP FMT_OUT FMT_LEN FMT_FD FMT_DONE fmt_flush fmt_room fmt_make_room fmt_fd_room fmt_lost fmt_str fmt_str_fd fmt_str_buf fmt_byte fmt_decimal Fmt fmt_spec_decimal fmt_number_start fmt_radix fmt_signed fmt_pad fmt_float fmt_fixed_long fmt_quoted debug_list Interp push_fmt|eprint eprintln format_in __fmt_tmp __fmt_in_end __buf_fmt __buf_fmt_end format fmt_to_vec fmt_end_vec Display Debug FMT_LEFT FMT_RIGHT FMT_ZERO FMT_HEX FMT_UPPER FMT_BIN FMT_CHAR FMT_NUM FMT_PAD FMT_CAP FMT_OUT FMT_LEN FMT_FD FMT_DONE fmt_flush fmt_room fmt_make_room fmt_fd_room fmt_lost fmt_str fmt_str_fd fmt_str_buf fmt_byte fmt_decimal Fmt fmt_spec_decimal fmt_number_start fmt_radix fmt_signed fmt_pad fmt_float fmt_fixed_long fmt_quoted debug_list Interp|Display Interp|2 4 24 25 32 33 49\n");
        buf_str(out, c"100485 102535 1|FmtSpec fmt_hole int_hole uint_hole|FmtSpec fmt_hole||4 23\n");
        buf_str(out, c"102535 106497 1|||Display * Debug * Display * Debug * Display * Debug * Display * Debug * Display * Debug * Display * Debug * Display * Debug * Display * Debug * Display * Debug * Display * Debug * Display bool Debug bool Display * Debug * Display Buf Debug Buf Debug Option Debug Result Debug Vec Debug *|1 2 4 23 32\n");
        buf_str(out, c"106497 107146 0|||Debug HashMap|1 6 8 23 25 30 32\n");
        buf_str(out, c"107146 109918 0|From Into main_error ok_or map and_then unwrap_or_else map_err err From Into main_error|From Into main_error||1 23 25\n");
        buf_str(out, c"109918 113428 0|Clone hash_mix eq_of cmp_of hash_of clone_of filled_in clone_in|Clone hash_mix eq_of cmp_of hash_of clone_of|Clone Vec Clone Buf Clone HashMap Clone Option Clone Result|1 2 4 6 8 29 30 31 32\n");
