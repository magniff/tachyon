        buf_str(out, c"    0xd64d3d9db981787d, 0x092cbbccdad5b108,\n");
        buf_str(out, c"    0x85f0468293f0eb4e, 0x25bbf56008c58ea5,\n");
        buf_str(out, c"    0xa76c582338ed2621, 0xaf2af2b80af6f24e,\n");
