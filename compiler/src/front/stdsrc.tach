// (0.20) std's files in std_source's text: a line `START PATH` for each
// (PATH under compiler/std), in the text's order, then a line with the
// end of the last module's text (std_alloc_tail's follows; front/stdtree).
pub fn std_files(out: i64) {
    unsafe {
        buf_str(out, c"0 std.tach\n");
        buf_str(out, c"25359 flat/iter.tach\n");
