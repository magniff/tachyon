        buf_str(out, c"pub const K_COSH: i64 = 156;\n");
        buf_str(out, c"pub const K_TANH: i64 = 157;\n");
        buf_str(out, c"pub const K_MIX: i64 = 158;\n");
        buf_str(out, c"pub const K_STEP: i64 = 159;\n");
        buf_str(out, c"pub const K_SMOOTHSTEP: i64 = 160;\n");
        buf_str(out, c"pub const K_FMA: i64 = 161;\n");
        buf_str(out, c"pub const K_LENGTH: i64 = 162;\n");
        buf_str(out, c"pub const K_DISTANCE: i64 = 163;\n");
        buf_str(out, c"pub const K_DOT: i64 = 164;\n");
        buf_str(out, c"pub const K_CROSS: i64 = 165;\n");
        buf_str(out, c"pub const K_NORMALIZE: i64 = 166;\n");
        buf_str(out, c"pub const K_REFLECT: i64 = 167;\n");
        buf_str(out, c"pub const K_DETERMINANT: i64 = 168;\n");
        buf_str(out, c"pub const K_TRANSPOSE: i64 = 169;\n");
        buf_str(out, c"pub const K_COUNT_ONE_BITS: i64 = 170;\n");
        buf_str(out, c"pub const K_COUNT_LEADING_ZEROS: i64 = 171;\n");
        buf_str(out, c"pub const K_COUNT_TRAILING_ZEROS: i64 = 172;\n");
        buf_str(out, c"pub const K_FIRST_LEADING_BIT: i64 = 173;\n");
        buf_str(out, c"pub const K_FIRST_TRAILING_BIT: i64 = 174;\n");
        buf_str(out, c"pub const K_REVERSE_BITS: i64 = 175;\n");
        buf_str(out, c"pub const K_EXTRACT_BITS: i64 = 176;\n");
        buf_str(out, c"pub const K_INSERT_BITS: i64 = 177;\n");
        buf_str(out, c"pub const K_ALL: i64 = 178;\n");
        buf_str(out, c"pub const K_ANY: i64 = 179;\n");
        buf_str(out, c"pub const K_DEGREES: i64 = 180;\n");
        buf_str(out, c"pub const K_RADIANS: i64 = 181;\n");
        buf_str(out, c"pub const K_SATURATE: i64 = 182;\n");
        buf_str(out, c"pub const K_PACK4X8UNORM: i64 = 183;\n");
        buf_str(out, c"pub const K_UNPACK4X8UNORM: i64 = 184;\n");
        buf_str(out, c"pub const K_PACK2X16FLOAT: i64 = 185;\n");
        buf_str(out, c"pub const K_UNPACK2X16FLOAT: i64 = 186;\n");
        buf_str(out, c"pub const K_ASINH: i64 = 187;\n");
        buf_str(out, c"pub const K_ACOSH: i64 = 188;\n");
        buf_str(out, c"pub const K_ATANH: i64 = 189;\n");
        buf_str(out, c"pub const K_FACE_FORWARD: i64 = 190;\n");
        buf_str(out, c"pub const K_LDEXP: i64 = 191;\n");
        buf_str(out, c"pub const K_PACK4X8SNORM: i64 = 192;\n");
        buf_str(out, c"pub const K_UNPACK4X8SNORM: i64 = 193;\n");
        buf_str(out, c"pub const K_PACK2X16UNORM: i64 = 194;\n");
        buf_str(out, c"pub const K_UNPACK2X16UNORM: i64 = 195;\n");
        buf_str(out, c"pub const K_PACK2X16SNORM: i64 = 196;\n");
        buf_str(out, c"pub const K_UNPACK2X16SNORM: i64 = 197;\n");
        buf_str(out, c"pub const K_MATH_FIRST: i64 = 131;\n");
        buf_str(out, c"pub const K_MATH_LAST: i64 = 197;\n");
        buf_str(out, c"// other builtins\n");
        buf_str(out, c"pub const K_SELECT: i64 = 198;\n");
        buf_str(out, c"pub const K_ARRAY_LENGTH: i64 = 199;\n");
        buf_str(out, c"pub const K_BITCAST: i64 = 200;\n");
        buf_str(out, c"pub const K_ATOMIC_LOAD: i64 = 201;\n");
        buf_str(out, c"pub const K_ATOMIC_STORE: i64 = 202;\n");
        buf_str(out, c"pub const K_ATOMIC_ADD: i64 = 203;\n");
        buf_str(out, c"pub const K_ATOMIC_SUB: i64 = 204;\n");
        buf_str(out, c"pub const K_ATOMIC_MAX: i64 = 205;\n");
        buf_str(out, c"pub const K_ATOMIC_MIN: i64 = 206;\n");
        buf_str(out, c"pub const K_ATOMIC_AND: i64 = 207;\n");
        buf_str(out, c"pub const K_ATOMIC_OR: i64 = 208;\n");
        buf_str(out, c"pub const K_ATOMIC_XOR: i64 = 209;\n");
        buf_str(out, c"pub const K_ATOMIC_EXCHANGE: i64 = 210;\n");
        buf_str(out, c"pub const K_ATOMIC_COMPARE_EXCHANGE_WEAK: i64 = 211;\n");
        buf_str(out, c"pub const K_WORKGROUP_BARRIER: i64 = 212;\n");
        buf_str(out, c"pub const K_STORAGE_BARRIER: i64 = 213;\n");
        buf_str(out, c"pub const K_WORKGROUP_UNIFORM_LOAD: i64 = 214;\n");
        buf_str(out, c"pub const K_DPDX: i64 = 215;\n");
        buf_str(out, c"pub const K_DPDY: i64 = 216;\n");
        buf_str(out, c"pub const K_FWIDTH: i64 = 217;\n");
        buf_str(out, c"pub const K_DPDX_COARSE: i64 = 218;\n");
        buf_str(out, c"pub const K_DPDY_COARSE: i64 = 219;\n");
        buf_str(out, c"pub const K_FWIDTH_COARSE: i64 = 220;\n");
        buf_str(out, c"pub const K_DPDX_FINE: i64 = 221;\n");
        buf_str(out, c"pub const K_DPDY_FINE: i64 = 222;\n");
        buf_str(out, c"pub const K_FWIDTH_FINE: i64 = 223;\n");
        buf_str(out, c"pub const K_TEXTURE_SAMPLE: i64 = 224;\n");
        buf_str(out, c"pub const K_TEXTURE_SAMPLE_BIAS: i64 = 225;\n");
        buf_str(out, c"pub const K_TEXTURE_SAMPLE_LEVEL: i64 = 226;\n");
        buf_str(out, c"pub const K_TEXTURE_SAMPLE_COMPARE: i64 = 227;\n");
        buf_str(out, c"pub const K_TEXTURE_SAMPLE_COMPARE_LEVEL: i64 = 228;\n");
        buf_str(out, c"pub const K_TEXTURE_LOAD: i64 = 229;\n");
        buf_str(out, c"pub const K_TEXTURE_STORE: i64 = 230;\n");
        buf_str(out, c"pub const K_TEXTURE_DIMENSIONS: i64 = 231;\n");
        buf_str(out, c"pub const K_TEXTURE_NUM_LEVELS: i64 = 232;\n");
        buf_str(out, c"pub const K_TEXTURE_NUM_LAYERS: i64 = 233;\n");
        buf_str(out, c"pub const K_COUNT: i64 = 234;\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl::names ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::gpu::wgsl::lex ----\n");
        buf_str(out, c"pub mod lex {\n");
        buf_str(out, c"// ---- Shader compiler implementation, lex (0.22) ----\n");
        buf_str(out, c"// The WGSL lexer: the whole source becomes arrays of tokens (kind, start,\n");
        buf_str(out, c"// end, and for an identifier its symbol). Identifiers are interned: the\n");
        buf_str(out, c"// predeclared names (names.tach) have fixed symbols, so the parser\n");
        buf_str(out, c"// compares integers. Comments (`//`, nesting `/* */`) and blanks are\n");
        buf_str(out, c"// skipped.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use ir::V;\n");
        buf_str(out, c"use names::PREDECLARED;\n");
        buf_str(out, c"use std::{HashMap, ScopedArena, Vec};\n");
        buf_str(out, c"use std::Option::{None, Some};\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const T_EOF: u8 = 0;\n");
        buf_str(out, c"pub const T_IDENT: u8 = 1;\n");
        buf_str(out, c"// an integer literal: its text is start .. end, the suffix included\n");
        buf_str(out, c"pub const T_INT: u8 = 2;\n");
        buf_str(out, c"pub const T_FLOAT: u8 = 3;\n");
        buf_str(out, c"pub const T_LPAREN: u8 = 4;\n");
        buf_str(out, c"pub const T_RPAREN: u8 = 5;\n");
        buf_str(out, c"pub const T_LBRACE: u8 = 6;\n");
        buf_str(out, c"pub const T_RBRACE: u8 = 7;\n");
        buf_str(out, c"pub const T_LBRACKET: u8 = 8;\n");
        buf_str(out, c"pub const T_RBRACKET: u8 = 9;\n");
        buf_str(out, c"pub const T_COMMA: u8 = 10;\n");
        buf_str(out, c"pub const T_SEMI: u8 = 11;\n");
        buf_str(out, c"pub const T_COLON: u8 = 12;\n");
        buf_str(out, c"pub const T_DOT: u8 = 13;\n");
        buf_str(out, c"pub const T_AT: u8 = 14;\n");
        buf_str(out, c"pub const T_ARROW: u8 = 15;\n");
        buf_str(out, c"pub const T_EQ: u8 = 16;\n");
        buf_str(out, c"pub const T_EQEQ: u8 = 17;\n");
        buf_str(out, c"pub const T_NE: u8 = 18;\n");
        buf_str(out, c"pub const T_LT: u8 = 19;\n");
        buf_str(out, c"pub const T_LE: u8 = 20;\n");
        buf_str(out, c"pub const T_GT: u8 = 21;\n");
        buf_str(out, c"pub const T_GE: u8 = 22;\n");
        buf_str(out, c"pub const T_PLUS: u8 = 23;\n");
        buf_str(out, c"pub const T_MINUS: u8 = 24;\n");
        buf_str(out, c"pub const T_STAR: u8 = 25;\n");
        buf_str(out, c"pub const T_SLASH: u8 = 26;\n");
        buf_str(out, c"pub const T_PERCENT: u8 = 27;\n");
        buf_str(out, c"pub const T_AMP: u8 = 28;\n");
        buf_str(out, c"pub const T_PIPE: u8 = 29;\n");
        buf_str(out, c"pub const T_CARET: u8 = 30;\n");
        buf_str(out, c"pub const T_TILDE: u8 = 31;\n");
        buf_str(out, c"pub const T_BANG: u8 = 32;\n");
        buf_str(out, c"pub const T_ANDAND: u8 = 33;\n");
        buf_str(out, c"pub const T_OROR: u8 = 34;\n");
        buf_str(out, c"pub const T_SHL: u8 = 35;\n");
        buf_str(out, c"pub const T_SHR: u8 = 36;\n");
        buf_str(out, c"pub const T_PLUSEQ: u8 = 37;\n");
        buf_str(out, c"pub const T_MINUSEQ: u8 = 38;\n");
        buf_str(out, c"pub const T_STAREQ: u8 = 39;\n");
        buf_str(out, c"pub const T_SLASHEQ: u8 = 40;\n");
        buf_str(out, c"pub const T_PERCENTEQ: u8 = 41;\n");
        buf_str(out, c"pub const T_AMPEQ: u8 = 42;\n");
        buf_str(out, c"pub const T_PIPEEQ: u8 = 43;\n");
        buf_str(out, c"pub const T_CARETEQ: u8 = 44;\n");
        buf_str(out, c"pub const T_SHLEQ: u8 = 45;\n");
        buf_str(out, c"pub const T_SHREQ: u8 = 46;\n");
        buf_str(out, c"pub const T_PLUSPLUS: u8 = 47;\n");
        buf_str(out, c"pub const T_MINUSMINUS: u8 = 48;\n");
        buf_str(out, c"pub const T_UNDERSCORE: u8 = 49;\n");
        buf_str(out, c"// a byte that starts no token\n");
        buf_str(out, c"pub const T_BAD: u8 = 50;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Tokens {\n");
        buf_str(out, c"    kinds: V<u8>,\n");
        buf_str(out, c"    starts: V<i64>,\n");
        buf_str(out, c"    ends: V<i64>,\n");
        buf_str(out, c"    // the symbol of an identifier, else -1\n");
        buf_str(out, c"    syms: V<i64>,\n");
        buf_str(out, c"    // symbol -> its text\n");
        buf_str(out, c"    names: V<[u8]>,\n");
        buf_str(out, c"    intern: HashMap<[u8], i64, ScopedArena>,\n");
        buf_str(out, c"    // a comment that is not closed: its start, else -1\n");
        buf_str(out, c"    open_comment: i64,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn is_ident_start(c: u8) -> bool { (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' }\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn is_ident_char(c: u8) -> bool { is_ident_start(c) || (c >= '0' && c <= '9') }\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn is_hex(c: u8) -> bool {\n");
        buf_str(out, c"    (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn is_dec(c: u8) -> bool { c >= '0' && c <= '9' }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Tokens {\n");
        buf_str(out, c"    pub fn sym(inout self, s: [u8]) -> i64 {\n");
        buf_str(out, c"        if let Some(h) = self.intern.get(s) {\n");
        buf_str(out, c"            return h;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let h = self.names.len();\n");
        buf_str(out, c"        self.names.push(s);\n");
        buf_str(out, c"        self.intern.insert(s, h);\n");
        buf_str(out, c"        h\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn push_token(inout self, k: u8, s: i64, e: i64, sym: i64) {\n");
        buf_str(out, c"        self.kinds.push(k);\n");
        buf_str(out, c"        self.starts.push(s);\n");
        buf_str(out, c"        self.ends.push(e);\n");
        buf_str(out, c"        self.syms.push(sym);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The length of the number at src[i ..], and whether it is a float.\n");
        buf_str(out, c"fn number_len(src: [u8], i: i64) -> (i64, bool) {\n");
        buf_str(out, c"    let n = src.len;\n");
        buf_str(out, c"    var j = i;\n");
        buf_str(out, c"    var float = false;\n");
        buf_str(out, c"    if src[j] == '0' && j + 1 < n && (src[j + 1] == 'x' || src[j + 1] == 'X') {\n");
        buf_str(out, c"        j += 2;\n");
        buf_str(out, c"        while j < n && is_hex(src[j]) {\n");
        buf_str(out, c"            j += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if j < n && src[j] == '.' {\n");
        buf_str(out, c"            float = true;\n");
        buf_str(out, c"            j += 1;\n");
        buf_str(out, c"            while j < n && is_hex(src[j]) {\n");
        buf_str(out, c"                j += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if j < n && (src[j] == 'p' || src[j] == 'P') {\n");
        buf_str(out, c"            float = true;\n");
        buf_str(out, c"            j += 1;\n");
        buf_str(out, c"            if j < n && (src[j] == '+' || src[j] == '-') {\n");
        buf_str(out, c"                j += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            while j < n && is_dec(src[j]) {\n");
        buf_str(out, c"                j += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if j < n && (src[j] == 'f' || src[j] == 'h') && float {\n");
        buf_str(out, c"            j += 1;\n");
        buf_str(out, c"        } else if j < n && (src[j] == 'i' || src[j] == 'u') && !float {\n");
        buf_str(out, c"            j += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return (j - i, float);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    while j < n && is_dec(src[j]) {\n");
        buf_str(out, c"        j += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if j < n && src[j] == '.' && !(j + 1 < n && src[j + 1] == '.') {\n");
        buf_str(out, c"        float = true;\n");
        buf_str(out, c"        j += 1;\n");
        buf_str(out, c"        while j < n && is_dec(src[j]) {\n");
        buf_str(out, c"            j += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if j < n && (src[j] == 'e' || src[j] == 'E') {\n");
        buf_str(out, c"        var k = j + 1;\n");
        buf_str(out, c"        if k < n && (src[k] == '+' || src[k] == '-') {\n");
        buf_str(out, c"            k += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k < n && is_dec(src[k]) {\n");
        buf_str(out, c"            float = true;\n");
        buf_str(out, c"            j = k;\n");
        buf_str(out, c"            while j < n && is_dec(src[j]) {\n");
        buf_str(out, c"                j += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if j < n && (src[j] == 'f' || src[j] == 'h') {\n");
        buf_str(out, c"        float = true;\n");
        buf_str(out, c"        j += 1;\n");
        buf_str(out, c"    } else if j < n && (src[j] == 'i' || src[j] == 'u') && !float {\n");
        buf_str(out, c"        j += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    (j - i, float)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn lex(src: [u8], a: ScopedArena) -> Tokens {\n");
        buf_str(out, c"    var t = Tokens {\n");
        buf_str(out, c"        kinds: Vec::with_capacity_in(src.len / 3 + 16, a),\n");
        buf_str(out, c"        starts: Vec::with_capacity_in(src.len / 3 + 16, a),\n");
        buf_str(out, c"        ends: Vec::with_capacity_in(src.len / 3 + 16, a),\n");
        buf_str(out, c"        syms: Vec::with_capacity_in(src.len / 3 + 16, a),\n");
        buf_str(out, c"        names: Vec::with_capacity_in(512, a),\n");
        buf_str(out, c"        intern: HashMap::with_capacity_in(512, a),\n");
        buf_str(out, c"        open_comment: -1,\n");
        buf_str(out, c"    };\n");
        buf_str(out, c"    for i in 0..PREDECLARED.len() {\n");
        buf_str(out, c"        t.sym(PREDECLARED[i]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let n = src.len;\n");
        buf_str(out, c"    var i = 0;\n");
        buf_str(out, c"    while i < n {\n");
        buf_str(out, c"        let c = src[i];\n");
        buf_str(out, c"        if c == ' ' || c == '\\n' || c == '\\t' || c == '\\r' || c == 11 || c == 12 {\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if c == '/' && i + 1 < n && src[i + 1] == '/' {\n");
        buf_str(out, c"            while i < n && src[i] != '\\n' {\n");
        buf_str(out, c"                i += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if c == '/' && i + 1 < n && src[i + 1] == '*' {\n");
        buf_str(out, c"            let start = i;\n");
        buf_str(out, c"            var depth = 1;\n");
        buf_str(out, c"            i += 2;\n");
        buf_str(out, c"            while i < n && depth > 0 {\n");
        buf_str(out, c"                if src[i] == '/' && i + 1 < n && src[i + 1] == '*' {\n");
        buf_str(out, c"                    depth += 1;\n");
        buf_str(out, c"                    i += 2;\n");
        buf_str(out, c"                } else if src[i] == '*' && i + 1 < n && src[i + 1] == '/' {\n");
        buf_str(out, c"                    depth -= 1;\n");
        buf_str(out, c"                    i += 2;\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    i += 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if depth > 0 {\n");
        buf_str(out, c"                t.open_comment = start;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if is_ident_start(c) {\n");
        buf_str(out, c"            let s = i;\n");
        buf_str(out, c"            while i < n && is_ident_char(src[i]) {\n");
        buf_str(out, c"                i += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if i - s == 1 && c == '_' {\n");
        buf_str(out, c"                t.push_token(T_UNDERSCORE, s, i, -1);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                let sym = t.sym(src[s..i]);\n");
        buf_str(out, c"                t.push_token(T_IDENT, s, i, sym);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if is_dec(c) || (c == '.' && i + 1 < n && is_dec(src[i + 1])) {\n");
        buf_str(out, c"            let (len, float) = number_len(src, i);\n");
        buf_str(out, c"            t.push_token(if float { T_FLOAT } else { T_INT }, i, i + len, -1);\n");
        buf_str(out, c"            i += len;\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let c1 = if i + 1 < n { src[i + 1] } else { 0 };\n");
        buf_str(out, c"        let c2 = if i + 2 < n { src[i + 2] } else { 0 };\n");
        buf_str(out, c"        var k = T_BAD;\n");
        buf_str(out, c"        var len = 1;\n");
        buf_str(out, c"        if c == '(' {\n");
        buf_str(out, c"            k = T_LPAREN;\n");
        buf_str(out, c"        } else if c == ')' {\n");
        buf_str(out, c"            k = T_RPAREN;\n");
        buf_str(out, c"        } else if c == '{' {\n");
        buf_str(out, c"            k = T_LBRACE;\n");
        buf_str(out, c"        } else if c == '}' {\n");
        buf_str(out, c"            k = T_RBRACE;\n");
        buf_str(out, c"        } else if c == '[' {\n");
        buf_str(out, c"            k = T_LBRACKET;\n");
        buf_str(out, c"        } else if c == ']' {\n");
        buf_str(out, c"            k = T_RBRACKET;\n");
        buf_str(out, c"        } else if c == ',' {\n");
        buf_str(out, c"            k = T_COMMA;\n");
        buf_str(out, c"        } else if c == ';' {\n");
        buf_str(out, c"            k = T_SEMI;\n");
        buf_str(out, c"        } else if c == ':' {\n");
        buf_str(out, c"            k = T_COLON;\n");
        buf_str(out, c"        } else if c == '.' {\n");
        buf_str(out, c"            k = T_DOT;\n");
        buf_str(out, c"        } else if c == '@' {\n");
        buf_str(out, c"            k = T_AT;\n");
        buf_str(out, c"        } else if c == '~' {\n");
        buf_str(out, c"            k = T_TILDE;\n");
        buf_str(out, c"        } else if c == '=' {\n");
        buf_str(out, c"            if c1 == '=' {\n");
        buf_str(out, c"                k = T_EQEQ;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                k = T_EQ;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if c == '!' {\n");
        buf_str(out, c"            if c1 == '=' {\n");
        buf_str(out, c"                k = T_NE;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                k = T_BANG;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if c == '<' {\n");
        buf_str(out, c"            if c1 == '<' && c2 == '=' {\n");
        buf_str(out, c"                k = T_SHLEQ;\n");
        buf_str(out, c"                len = 3;\n");
        buf_str(out, c"            } else if c1 == '<' {\n");
        buf_str(out, c"                k = T_SHL;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else if c1 == '=' {\n");
        buf_str(out, c"                k = T_LE;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                k = T_LT;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if c == '>' {\n");
        buf_str(out, c"            if c1 == '>' && c2 == '=' {\n");
        buf_str(out, c"                k = T_SHREQ;\n");
        buf_str(out, c"                len = 3;\n");
        buf_str(out, c"            } else if c1 == '>' {\n");
        buf_str(out, c"                k = T_SHR;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else if c1 == '=' {\n");
        buf_str(out, c"                k = T_GE;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                k = T_GT;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if c == '+' {\n");
        buf_str(out, c"            if c1 == '+' {\n");
        buf_str(out, c"                k = T_PLUSPLUS;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else if c1 == '=' {\n");
        buf_str(out, c"                k = T_PLUSEQ;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                k = T_PLUS;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if c == '-' {\n");
        buf_str(out, c"            if c1 == '>' {\n");
        buf_str(out, c"                k = T_ARROW;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else if c1 == '-' {\n");
        buf_str(out, c"                k = T_MINUSMINUS;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else if c1 == '=' {\n");
        buf_str(out, c"                k = T_MINUSEQ;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                k = T_MINUS;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if c == '*' {\n");
        buf_str(out, c"            if c1 == '=' {\n");
        buf_str(out, c"                k = T_STAREQ;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                k = T_STAR;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if c == '/' {\n");
        buf_str(out, c"            if c1 == '=' {\n");
        buf_str(out, c"                k = T_SLASHEQ;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                k = T_SLASH;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if c == '%' {\n");
        buf_str(out, c"            if c1 == '=' {\n");
        buf_str(out, c"                k = T_PERCENTEQ;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                k = T_PERCENT;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if c == '&' {\n");
        buf_str(out, c"            if c1 == '&' {\n");
        buf_str(out, c"                k = T_ANDAND;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else if c1 == '=' {\n");
        buf_str(out, c"                k = T_AMPEQ;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                k = T_AMP;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if c == '|' {\n");
        buf_str(out, c"            if c1 == '|' {\n");
        buf_str(out, c"                k = T_OROR;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else if c1 == '=' {\n");
        buf_str(out, c"                k = T_PIPEEQ;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                k = T_PIPE;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if c == '^' {\n");
        buf_str(out, c"            if c1 == '=' {\n");
        buf_str(out, c"                k = T_CARETEQ;\n");
        buf_str(out, c"                len = 2;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                k = T_CARET;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        t.push_token(k, i, i + len, -1);\n");
        buf_str(out, c"        i += len;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    t.push_token(T_EOF, n, n, -1);\n");
        buf_str(out, c"    t\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// How a token is written, for messages.\n");
        buf_str(out, c"pub fn token_text(k: u8) -> [u8] {\n");
        buf_str(out, c"    if k == T_EOF {\n");
        buf_str(out, c"        \"the end of the file\"\n");
        buf_str(out, c"    } else if k == T_IDENT {\n");
        buf_str(out, c"        \"an identifier\"\n");
        buf_str(out, c"    } else if k == T_INT || k == T_FLOAT {\n");
        buf_str(out, c"        \"a number\"\n");
        buf_str(out, c"    } else if k == T_LPAREN {\n");
        buf_str(out, c"        \"'('\"\n");
        buf_str(out, c"    } else if k == T_RPAREN {\n");
        buf_str(out, c"        \"')'\"\n");
        buf_str(out, c"    } else if k == T_LBRACE {\n");
        buf_str(out, c"        \"'{'\"\n");
        buf_str(out, c"    } else if k == T_RBRACE {\n");
        buf_str(out, c"        \"'}'\"\n");
        buf_str(out, c"    } else if k == T_LBRACKET {\n");
        buf_str(out, c"        \"'['\"\n");
        buf_str(out, c"    } else if k == T_RBRACKET {\n");
        buf_str(out, c"        \"']'\"\n");
        buf_str(out, c"    } else if k == T_COMMA {\n");
        buf_str(out, c"        \"','\"\n");
        buf_str(out, c"    } else if k == T_SEMI {\n");
        buf_str(out, c"        \"';'\"\n");
        buf_str(out, c"    } else if k == T_COLON {\n");
        buf_str(out, c"        \"':'\"\n");
        buf_str(out, c"    } else if k == T_DOT {\n");
        buf_str(out, c"        \"'.'\"\n");
        buf_str(out, c"    } else if k == T_AT {\n");
        buf_str(out, c"        \"'@'\"\n");
        buf_str(out, c"    } else if k == T_ARROW {\n");
        buf_str(out, c"        \"'->'\"\n");
        buf_str(out, c"    } else if k == T_EQ {\n");
        buf_str(out, c"        \"'='\"\n");
        buf_str(out, c"    } else if k == T_LT {\n");
        buf_str(out, c"        \"'<'\"\n");
        buf_str(out, c"    } else if k == T_GT {\n");
        buf_str(out, c"        \"'>'\"\n");
        buf_str(out, c"    } else if k == T_UNDERSCORE {\n");
        buf_str(out, c"        \"'_'\"\n");
        buf_str(out, c"    } else if k == T_BAD {\n");
        buf_str(out, c"        \"a character WGSL does not use\"\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        \"an operator\"\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl::lex ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::gpu::wgsl::front ----\n");
        buf_str(out, c"pub mod front {\n");
        buf_str(out, c"// ---- Shader compiler implementation, front (0.22) ----\n");
        buf_str(out, c"// The WGSL front end: parsing, name resolution and type checking in one\n");
        buf_str(out, c"// pass from tokens to IR (docs/design/gpu.md §2.10), with no syntax tree\n");
        buf_str(out, c"// in between.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// - A skim finds the module-scope declarations (any order is allowed);\n");
        buf_str(out, c"//   types, constants and function signatures are resolved on demand from\n");
        buf_str(out, c"//   their tokens, function bodies in source order.\n");
        buf_str(out, c"// - Expressions are lowered as they are parsed: a `Val` is an IR\n");
        buf_str(out, c"//   expression, a reference (a pointer the Load Rule reads), or a\n");
        buf_str(out, c"//   constant (abstract numbers included) not yet in the IR.\n");
        buf_str(out, c"// - The first error stops the translation: it is recorded, and from then\n");
        buf_str(out, c"//   on every token reads as the end of the file, so the parse unwinds.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use ir::{\n");
        buf_str(out, c"    ACC_READ, ACC_RW, ACC_WRITE, BIND_BUILTIN, BIND_LOCATION, BIND_NONE, Binding, E_ARG,\n");
        buf_str(out, c"    E_CALL_RESULT, E_GLOBAL, E_LOCAL, Entry, Function, Global, INTERP_FLAT, INTERP_LINEAR,\n");
        buf_str(out, c"    INTERP_PERSPECTIVE, Local, Module, Param, SK_BOOL, SK_F32, SK_I32, SK_U32, SP_FUNCTION,\n");
        buf_str(out, c"    SP_HANDLE, SP_PRIVATE, SP_STORAGE, SP_UNIFORM, SP_WORKGROUP, STAGE_COMPUTE, STAGE_FRAGMENT,\n");
        buf_str(out, c"    STAGE_VERTEX, S_BLOCK, S_BREAK, S_CALL, S_CONTINUE, S_EMIT, S_IF, S_KILL, S_LOOP, S_RETURN,\n");
        buf_str(out, c"    S_STORE, S_SWITCH, StructMember, TK_ARRAY, TK_ATOMIC, TK_MATRIX, TK_POINTER, TK_SAMPLER,\n");
        buf_str(out, c"    TK_SCALAR, TK_STRUCT, TK_TEXTURE, TK_VECTOR, T_BOOL, T_F32, T_I32, T_U32, V, new_function,\n");
        buf_str(out, c"    no_binding,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"use lex::{\n");
        buf_str(out, c"    T_ARROW, T_AT, T_COLON, T_COMMA, T_EOF, T_EQ, T_GT, T_IDENT, T_LBRACE, T_LBRACKET, T_LPAREN,\n");
        buf_str(out, c"    T_LT, T_MINUSMINUS, T_PLUSPLUS, T_RBRACE, T_RBRACKET, T_RPAREN, T_SEMI, T_SHR, T_UNDERSCORE,\n");
        buf_str(out, c"    Tokens, token_text,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"use names::{\n");
        buf_str(out, c"    K_ALIAS, K_ALIGN, K_BINDING, K_BREAK, K_BUILTIN, K_CASE, K_CENTER, K_CENTROID, K_COMPUTE,\n");
        buf_str(out, c"    K_CONST, K_CONST_ASSERT, K_CONTINUE, K_CONTINUING, K_DEFAULT, K_DIAGNOSTIC, K_DISCARD, K_ELSE,\n");
        buf_str(out, c"    K_ENABLE, K_FLAT, K_FN, K_FOR, K_FRAGMENT, K_GROUP, K_ID, K_IF, K_INTERPOLATE, K_INVARIANT,\n");
        buf_str(out, c"    K_LET, K_LINEAR, K_LOCATION, K_LOOP, K_MUST_USE, K_OVERRIDE, K_PERSPECTIVE, K_REQUIRES,\n");
        buf_str(out, c"    K_RETURN, K_SAMPLE, K_SIZE, K_STRUCT, K_SWITCH, K_VAR, K_VERTEX, K_WHILE, K_WORKGROUP_SIZE,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"use std::{Buf, ScopedArena, Vec};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Shader compiler implementation, front: Values (0.22) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// an IR expression's value\n");
        buf_str(out, c"pub const VK_VALUE: u8 = 0;\n");
        buf_str(out, c"// a reference: `e` is a pointer, read by the Load Rule where a value is needed\n");
        buf_str(out, c"pub const VK_REF: u8 = 1;\n");
        buf_str(out, c"// a constant scalar not yet in the IR: iv (bool, integers) or fv (floats);\n");
        buf_str(out, c"// sk may be abstract; ty is its type, -1 when abstract\n");
        buf_str(out, c"pub const VK_CONST: u8 = 2;\n");
        buf_str(out, c"// a module-scope or local name that is a type (in a constructor call)\n");
        buf_str(out, c"pub const VK_TYPE: u8 = 3;\n");
        buf_str(out, c"// no value (a call of a function without a result)\n");
        buf_str(out, c"pub const VK_VOID: u8 = 4;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Val { k: u8, sk: u8, e: i64, ty: i64, iv: i64, fv: f64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn val(e: i64, ty: i64) -> Val { Val { k: VK_VALUE, sk: 0, e: e, ty: ty, iv: 0, fv: 0.0 } }\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn cint(sk: u8, ty: i64, v: i64) -> Val {\n");
        buf_str(out, c"    Val { k: VK_CONST, sk: sk, e: -1, ty: ty, iv: v, fv: 0.0 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn cfloat(sk: u8, ty: i64, v: f64) -> Val {\n");
        buf_str(out, c"    Val { k: VK_CONST, sk: sk, e: -1, ty: ty, iv: 0, fv: v }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Shader compiler implementation, front: Declarations (0.22) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const D_FN: u8 = 0;\n");
        buf_str(out, c"pub const D_STRUCT: u8 = 1;\n");
        buf_str(out, c"pub const D_VAR: u8 = 2;\n");
        buf_str(out, c"pub const D_CONST: u8 = 3;\n");
        buf_str(out, c"pub const D_ALIAS: u8 = 4;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const DS_TODO: u8 = 0;\n");
        buf_str(out, c"pub const DS_BUSY: u8 = 1;\n");
        buf_str(out, c"pub const DS_DONE: u8 = 2;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// tok: the token after the attributes (the keyword); attr: the first\n");
        buf_str(out, c"// attribute's token; h: the type, global or function once resolved; cv:\n");
        buf_str(out, c"// a constant's value once known (scalars)\n");
        buf_str(out, c"pub struct Decl {\n");
        buf_str(out, c"    kind: u8, state: u8, sym: i64, tok: i64, attr: i64, h: i64, cv: Val, has_cv: bool\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A name in a function's scopes.\n");
        buf_str(out, c"pub struct ScopeEntry { sym: i64, v: Val, mutable: bool }\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Attrs {\n");
        buf_str(out, c"    stage: i64,\n");
        buf_str(out, c"    wg: [i64; 3],\n");
        buf_str(out, c"    group: i64,\n");
        buf_str(out, c"    binding: i64,\n");
        buf_str(out, c"    loc: i64,\n");
        buf_str(out, c"    builtin: i64,\n");
        buf_str(out, c"    interp: i64,\n");
        buf_str(out, c"    pos: i64,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Front {\n");
        buf_str(out, c"    src: [u8],\n");
        buf_str(out, c"    tk: Tokens,\n");
        buf_str(out, c"    p: i64,\n");
        buf_str(out, c"    m: Module,\n");
        buf_str(out, c"    a: ScopedArena,\n");
        buf_str(out, c"    failed: bool,\n");
        buf_str(out, c"    err_code: [u8],\n");
        buf_str(out, c"    err_pos: i64,\n");
        buf_str(out, c"    emsg: Buf<ScopedArena>,\n");
        buf_str(out, c"    ehelp: Buf<ScopedArena>,\n");
        buf_str(out, c"    decls: V<Decl>,\n");
        buf_str(out, c"    // symbol -> its declaration, or -1\n");
        buf_str(out, c"    decl_of: V<i64>,\n");
        buf_str(out, c"    // the function being lowered\n");
        buf_str(out, c"    f: Function,\n");
        buf_str(out, c"    fh: i64,\n");
        buf_str(out, c"    pending: V<i64>,\n");
        buf_str(out, c"    emit_start: i64,\n");
        buf_str(out, c"    scopes: V<ScopeEntry>,\n");
        buf_str(out, c"    scope_floor: i64,\n");
        buf_str(out, c"    // global -> its E_GLOBAL in f, or -1\n");
        buf_str(out, c"    gexpr: V<i64>,\n");
        buf_str(out, c"    loop_depth: i64,\n");
        buf_str(out, c"    switch_depth: i64,\n");
        buf_str(out, c"    in_continuing: bool,\n");
        buf_str(out, c"    // the start of each loop's body scope (for `continuing`'s check)\n");
        buf_str(out, c"    // the stage of the entry point being lowered (255: a plain function)\n");
        buf_str(out, c"    stage: i64,\n");
        buf_str(out, c"    // the compare-exchange result types: [i32's, u32's], -1 until made\n");
        buf_str(out, c"    cmpxchg_ty: [i64; 2],\n");
        buf_str(out, c"    tmp: Buf<ScopedArena>,\n");
        buf_str(out, c"    // the expected type of the expression being parsed (for inferred\n");
        buf_str(out, c"    // constructors of abstract numbers), or -1\n");
        buf_str(out, c"    hint: i64,\n");
        buf_str(out, c"    // the token after the last call's `)`, and whether a statement was one\n");
        buf_str(out, c"    last_call_end: i64,\n");
        buf_str(out, c"    last_was_call: bool,\n");
        buf_str(out, c"    // call arguments being parsed, with their positions; lowered ones\n");
        buf_str(out, c"    astack: V<Val>,\n");
        buf_str(out, c"    apos: V<i64>,\n");
        buf_str(out, c"    estack: V<i64>,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn new_front(src: [u8], a: ScopedArena) -> Front {\n");
        buf_str(out, c"    let tk = lex::lex(src, a);\n");
        buf_str(out, c"    Front {\n");
        buf_str(out, c"        src: src,\n");
        buf_str(out, c"        tk: tk,\n");
        buf_str(out, c"        p: 0,\n");
        buf_str(out, c"        m: Module::new(a),\n");
        buf_str(out, c"        a: a,\n");
        buf_str(out, c"        failed: false,\n");
        buf_str(out, c"        err_code: \"\",\n");
        buf_str(out, c"        err_pos: 0,\n");
        buf_str(out, c"        emsg: Buf::new_in(a),\n");
        buf_str(out, c"        ehelp: Buf::new_in(a),\n");
        buf_str(out, c"        decls: Vec::new_in(a),\n");
        buf_str(out, c"        decl_of: Vec::new_in(a),\n");
        buf_str(out, c"        f: new_function(\"\", a),\n");
        buf_str(out, c"        fh: -1,\n");
        buf_str(out, c"        pending: Vec::new_in(a),\n");
        buf_str(out, c"        emit_start: 0,\n");
        buf_str(out, c"        scopes: Vec::new_in(a),\n");
        buf_str(out, c"        scope_floor: 0,\n");
        buf_str(out, c"        gexpr: Vec::new_in(a),\n");
        buf_str(out, c"        loop_depth: 0,\n");
        buf_str(out, c"        switch_depth: 0,\n");
        buf_str(out, c"        in_continuing: false,\n");
        buf_str(out, c"        stage: 255,\n");
        buf_str(out, c"        cmpxchg_ty: [-1, -1],\n");
        buf_str(out, c"        tmp: Buf::new_in(a),\n");
        buf_str(out, c"        hint: -1,\n");
        buf_str(out, c"        last_call_end: -1,\n");
        buf_str(out, c"        last_was_call: false,\n");
        buf_str(out, c"        astack: Vec::new_in(a),\n");
        buf_str(out, c"        apos: Vec::new_in(a),\n");
        buf_str(out, c"        estack: Vec::new_in(a),\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Front {\n");
        buf_str(out, c"    // ---- Errors ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Records an error at byte `pos` with `code`; true when it is the\n");
        buf_str(out, c"    // first (the caller then writes the message into emsg).\n");
        buf_str(out, c"    pub fn err(inout self, pos: i64, code: [u8]) -> bool {\n");
        buf_str(out, c"        if self.failed {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.failed = true;\n");
        buf_str(out, c"        self.err_code = code;\n");
        buf_str(out, c"        self.err_pos = pos;\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn fail(inout self, pos: i64, code: [u8], msg: [u8]) {\n");
        buf_str(out, c"        if self.err(pos, code) {\n");
        buf_str(out, c"            self.emsg.push_str(msg);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn help(inout self, h: [u8]) {\n");
        buf_str(out, c"        if self.ehelp.len() == 0 {\n");
        buf_str(out, c"            self.ehelp.push_str(h);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn ty_str(inout self, t: i64) {\n");
        buf_str(out, c"        self.m.type_name(t, &self.emsg);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The type of a value as WGSL writes it, into emsg.\n");
        buf_str(out, c"    pub fn val_str(inout self, v: Val) {\n");
        buf_str(out, c"        if v.k == VK_CONST && v.ty < 0 {\n");
        buf_str(out, c"            self.emsg.push_str(ir::scalar_name(v.sk));\n");
        buf_str(out, c"        } else if v.k == VK_REF {\n");
        buf_str(out, c"            self.emsg.push_str(\"ref to \");\n");
        buf_str(out, c"            self.ty_str(self.m.pointee(v.ty));\n");
        buf_str(out, c"        } else if v.k == VK_VOID {\n");
        buf_str(out, c"            self.emsg.push_str(\"nothing (a call without a result)\");\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.ty_str(v.ty);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Tokens ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn kind(self) -> u8 {\n");
        buf_str(out, c"        if self.failed {\n");
        buf_str(out, c"            T_EOF\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.tk.kinds[self.p]\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn kind_at(self, i: i64) -> u8 {\n");
        buf_str(out, c"        if self.failed || i >= self.tk.kinds.len() {\n");
        buf_str(out, c"            T_EOF\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.tk.kinds[i]\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn sym(self) -> i64 {\n");
        buf_str(out, c"        if self.failed {\n");
        buf_str(out, c"            -1\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.tk.syms[self.p]\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn pos(self) -> i64 { self.tk.starts[self.p] }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn text(self, i: i64) -> [u8] { self.src[self.tk.starts[i]..self.tk.ends[i]] }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_kw(self, k: i64) -> bool {\n");
        buf_str(out, c"        self.kind() == T_IDENT && self.tk.syms[self.p] == k\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn eat(inout self, k: u8) -> bool {\n");
        buf_str(out, c"        if self.kind() == k {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            true\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            false\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn eat_kw(inout self, k: i64) -> bool {\n");
        buf_str(out, c"        if self.is_kw(k) {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            true\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            false\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn expect(inout self, k: u8) {\n");
        buf_str(out, c"        if self.kind() == k {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.failed {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let got = self.kind();\n");
        buf_str(out, c"        if self.err(self.pos(), \"wgsl.syntax\") {\n");
        buf_str(out, c"            self.emsg.push_fmt(f\"expected {token_text(k)}, got \");\n");
        buf_str(out, c"            if got == T_IDENT {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"'{self.text(self.p)}'\");\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.emsg.push_str(token_text(got));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // `>` closing a template list; a `>>` token gives one `>` and leaves one.\n");
        buf_str(out, c"    pub fn expect_gt(inout self) {\n");
        buf_str(out, c"        if self.kind() == T_SHR {\n");
        buf_str(out, c"            self.tk.kinds[self.p] = T_GT;\n");
        buf_str(out, c"            self.tk.starts[self.p] += 1;\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.expect(T_GT);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn ident(inout self) -> i64 {\n");
        buf_str(out, c"        if self.kind() == T_IDENT {\n");
        buf_str(out, c"            let s = self.tk.syms[self.p];\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            return s;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.expect(T_IDENT);\n");
        buf_str(out, c"        -1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn name_of(self, sym: i64) -> [u8] {\n");
        buf_str(out, c"        if sym < 0 {\n");
        buf_str(out, c"            \"_\"\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.tk.names[sym]\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Statements of the function being built ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn flush(inout self) {\n");
        buf_str(out, c"        let n = self.f.exprs.len();\n");
        buf_str(out, c"        if n > self.emit_start {\n");
        buf_str(out, c"            let s = self.f.stmt(S_EMIT, self.emit_start, n, 0, 0);\n");
        buf_str(out, c"            self.pending.push(s);\n");
        buf_str(out, c"            self.emit_start = n;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn push_stmt(inout self, op: u8, a: i64, b: i64, c: i64, d: i64) -> i64 {\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        let s = self.f.stmt(op, a, b, c, d);\n");
        buf_str(out, c"        self.pending.push(s);\n");
        buf_str(out, c"        s\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An expression made outside every emit range (a call's result).\n");
        buf_str(out, c"    pub fn unemitted(inout self, op: u8, ty: i64) -> i64 {\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        let e = self.f.expr(op, ty, 0, 0, 0);\n");
        buf_str(out, c"        self.emit_start = self.f.exprs.len();\n");
        buf_str(out, c"        e\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn global_expr(inout self, g: i64) -> i64 {\n");
        buf_str(out, c"        if self.gexpr[g] >= 0 {\n");
        buf_str(out, c"            return self.gexpr[g];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let gl = self.m.globals[g];\n");
        buf_str(out, c"        let ty = if gl.space == SP_HANDLE { gl.ty }\n");
        buf_str(out, c"            else { self.m.ptr_ty(gl.ty, gl.space, gl.access) };\n");
        buf_str(out, c"        let e = self.f.expr(E_GLOBAL, ty, g, 0, 0);\n");
        buf_str(out, c"        self.gexpr[g] = e;\n");
        buf_str(out, c"        e\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- The module ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Finds every module-scope declaration, without resolving any.\n");
        buf_str(out, c"    fn skim(inout self) {\n");
        buf_str(out, c"        for _ in 0..self.tk.names.len() {\n");
        buf_str(out, c"            self.decl_of.push(-1);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        while self.kind() != T_EOF {\n");
        buf_str(out, c"            let attr = self.p;\n");
        buf_str(out, c"            self.skip_attrs();\n");
        buf_str(out, c"            let tok = self.p;\n");
        buf_str(out, c"            if self.is_kw(K_ENABLE) || self.is_kw(K_REQUIRES) || self.is_kw(K_DIAGNOSTIC) {\n");
        buf_str(out, c"                let at = self.pos();\n");
        buf_str(out, c"                if self.is_kw(K_DIAGNOSTIC) {\n");
        buf_str(out, c"                    self.skip_to_semi();\n");
        buf_str(out, c"                    continue;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                let what = self.text(self.p);\n");
        buf_str(out, c"                if self.err(at, \"wgsl.unsupported\") {\n");
        buf_str(out, c"                    self.emsg.push_fmt(\n");
        buf_str(out, c"                        f\"'{what}' is not in the WGSL subset of this release (no extensions)\");\n");
        buf_str(out, c"                    self.help(\"remove the directive; f16 and the other extensions come later\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if self.is_kw(K_CONST_ASSERT) {\n");
        buf_str(out, c"                self.fail(self.pos(), \"wgsl.unsupported\",\n");
        buf_str(out, c"                    \"'const_assert' is not in the WGSL subset of this release\");\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if self.is_kw(K_OVERRIDE) {\n");
        buf_str(out, c"                self.fail(self.pos(), \"wgsl.unsupported\",\n");
        buf_str(out, c"                    \"'override' constants are not in the WGSL subset of this release\");\n");
        buf_str(out, c"                self.help(\"use a 'const', or a uniform buffer\");\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if self.eat(T_SEMI) {\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            var kind = D_FN;\n");
        buf_str(out, c"            if self.is_kw(K_FN) {\n");
        buf_str(out, c"                kind = D_FN;\n");
        buf_str(out, c"            } else if self.is_kw(K_STRUCT) {\n");
        buf_str(out, c"                kind = D_STRUCT;\n");
        buf_str(out, c"            } else if self.is_kw(K_VAR) {\n");
        buf_str(out, c"                kind = D_VAR;\n");
        buf_str(out, c"            } else if self.is_kw(K_CONST) {\n");
        buf_str(out, c"                kind = D_CONST;\n");
        buf_str(out, c"            } else if self.is_kw(K_ALIAS) {\n");
        buf_str(out, c"                kind = D_ALIAS;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                if self.kind() == T_IDENT && self.text(self.p) == \"let\" {\n");
        buf_str(out, c"                    self.fail(self.pos(), \"wgsl.syntax\", \"'let' is not allowed at module scope\");\n");
        buf_str(out, c"                    self.help(\"use 'const' for a module-scope constant\");\n");
        buf_str(out, c"                    return;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if self.err(self.pos(), \"wgsl.syntax\") {\n");
        buf_str(out, c"                    self.emsg.push_str(\n");
        buf_str(out, c"                        \"expected a declaration ('fn', 'struct', 'var', 'const', 'alias'), got \");\n");
        buf_str(out, c"                    if self.kind() == T_IDENT {\n");
        buf_str(out, c"                        self.emsg.push_fmt(f\"'{self.text(self.p)}'\");\n");
        buf_str(out, c"                    } else {\n");
        buf_str(out, c"                        self.emsg.push_str(token_text(self.kind()));\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            if kind == D_VAR && self.kind() == T_LT {\n");
        buf_str(out, c"                self.skip_template();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let at = self.pos();\n");
        buf_str(out, c"            let sym = self.ident();\n");
        buf_str(out, c"            if sym >= 0 {\n");
        buf_str(out, c"                if self.decl_of[sym] >= 0 {\n");
        buf_str(out, c"                    if self.err(at, \"wgsl.redefined\") {\n");
        buf_str(out, c"                        self.emsg.push_fmt(\n");
        buf_str(out, c"                            f\"'{self.name_of(sym)}' is declared twice at module scope\");\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    return;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.decl_of[sym] = self.decls.len();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.decls.push(Decl {\n");
        buf_str(out, c"                kind: kind, state: DS_TODO, sym: sym, tok: tok, attr: attr, h: -1,\n");
        buf_str(out, c"                cv: cint(0, -1, 0), has_cv: false\n");
        buf_str(out, c"            });\n");
        buf_str(out, c"            if kind == D_FN {\n");
        buf_str(out, c"                while self.kind() != T_LBRACE && self.kind() != T_EOF {\n");
        buf_str(out, c"                    self.p += 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.skip_balanced();\n");
        buf_str(out, c"            } else if kind == D_STRUCT {\n");
        buf_str(out, c"                self.skip_balanced();\n");
        buf_str(out, c"                self.eat(T_SEMI);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.skip_to_semi();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn skip_attrs(inout self) {\n");
        buf_str(out, c"        while self.kind() == T_AT {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            self.ident();\n");
        buf_str(out, c"            if self.kind() == T_LPAREN {\n");
        buf_str(out, c"                self.skip_balanced();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Skips a bracketed group from its opening token.\n");
        buf_str(out, c"    fn skip_balanced(inout self) {\n");
        buf_str(out, c"        var depth = 0;\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            let k = self.kind();\n");
        buf_str(out, c"            if k == T_EOF {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if k == T_LPAREN || k == T_LBRACE || k == T_LBRACKET {\n");
        buf_str(out, c"                depth += 1;\n");
        buf_str(out, c"            } else if k == T_RPAREN || k == T_RBRACE || k == T_RBRACKET {\n");
        buf_str(out, c"                depth -= 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            if depth <= 0 {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn skip_template(inout self) {\n");
        buf_str(out, c"        var depth = 0;\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            let k = self.kind();\n");
        buf_str(out, c"            if k == T_EOF {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if k == T_LT {\n");
        buf_str(out, c"                depth += 1;\n");
        buf_str(out, c"            } else if k == T_GT {\n");
        buf_str(out, c"                depth -= 1;\n");
        buf_str(out, c"            } else if k == T_SHR {\n");
        buf_str(out, c"                depth -= 2;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            if depth <= 0 {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn skip_to_semi(inout self) {\n");
        buf_str(out, c"        while self.kind() != T_SEMI && self.kind() != T_EOF {\n");
        buf_str(out, c"            let k = self.kind();\n");
        buf_str(out, c"            if k == T_LPAREN || k == T_LBRACE || k == T_LBRACKET {\n");
        buf_str(out, c"                self.skip_balanced();\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.eat(T_SEMI);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Resolves the whole module: types, globals, signatures, then bodies.\n");
        buf_str(out, c"    pub fn module(inout self) {\n");
        buf_str(out, c"        if self.tk.open_comment >= 0 {\n");
        buf_str(out, c"            self.fail(self.tk.open_comment, \"wgsl.syntax\", \"this block comment is not closed\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for i in 0..self.tk.kinds.len() {\n");
        buf_str(out, c"            if self.tk.kinds[i] == lex::T_BAD {\n");
        buf_str(out, c"                self.p = i;\n");
        buf_str(out, c"                if self.err(self.pos(), \"wgsl.syntax\") {\n");
        buf_str(out, c"                    self.emsg.push_fmt(f\"unexpected character '{self.text(i)}'\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.skim();\n");
        buf_str(out, c"        if self.failed {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // function handles, in declaration order\n");
        buf_str(out, c"        for i in 0..self.decls.len() {\n");
        buf_str(out, c"            if self.decls[i].kind == D_FN {\n");
        buf_str(out, c"                self.decls[i].h = self.m.functions.len();\n");
        buf_str(out, c"                let f = new_function(self.name_of(self.decls[i].sym), self.a);\n");
        buf_str(out, c"                self.m.functions.push(f);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.f = std::replace(&self.m.consts, new_function(\"\", self.a));\n");
        buf_str(out, c"        for i in 0..self.decls.len() {\n");
        buf_str(out, c"            let k = self.decls[i].kind;\n");
        buf_str(out, c"            if k == D_STRUCT || k == D_ALIAS {\n");
        buf_str(out, c"                self.resolve_type_decl(i);\n");
        buf_str(out, c"            } else if k == D_VAR {\n");
        buf_str(out, c"                self.resolve_global(i);\n");
        buf_str(out, c"            } else if k == D_CONST {\n");
        buf_str(out, c"                self.const_value(i);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if self.failed {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.m.consts = std::replace(&self.f, new_function(\"\", self.a));\n");
        buf_str(out, c"        for i in 0..self.decls.len() {\n");
        buf_str(out, c"            if self.decls[i].kind == D_FN {\n");
        buf_str(out, c"                self.signature(i);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if self.failed {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for i in 0..self.decls.len() {\n");
        buf_str(out, c"            if self.decls[i].kind == D_FN {\n");
        buf_str(out, c"                self.lower_fn(i);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if self.failed {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.check_calls();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Attributes ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn const_int_arg(inout self) -> i64 {\n");
        buf_str(out, c"        let at = self.pos();\n");
        buf_str(out, c"        let v = self.parse_expr();\n");
        buf_str(out, c"        if v.k != VK_CONST || v.sk == SK_F32 || v.sk == ir::SK_AFLOAT || v.sk == SK_BOOL {\n");
        buf_str(out, c"            self.fail(at, \"wgsl.type\", \"expected a constant integer\");\n");
        buf_str(out, c"            return 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v.iv\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn parse_attrs(inout self) -> Attrs {\n");
        buf_str(out, c"        var at = Attrs {\n");
        buf_str(out, c"            stage: -1, wg: [0, 0, 0], group: -1, binding: -1, loc: -1, builtin: -1, interp: -1,\n");
        buf_str(out, c"            pos: self.pos()\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        while self.kind() == T_AT {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let apos = self.pos();\n");
        buf_str(out, c"            let s = self.ident();\n");
        buf_str(out, c"            if s == K_VERTEX {\n");
        buf_str(out, c"                at.stage = STAGE_VERTEX as i64;\n");
        buf_str(out, c"            } else if s == K_FRAGMENT {\n");
        buf_str(out, c"                at.stage = STAGE_FRAGMENT as i64;\n");
        buf_str(out, c"            } else if s == K_COMPUTE {\n");
        buf_str(out, c"                at.stage = STAGE_COMPUTE as i64;\n");
        buf_str(out, c"            } else if s == K_WORKGROUP_SIZE {\n");
        buf_str(out, c"                self.expect(T_LPAREN);\n");
        buf_str(out, c"                at.wg = [1, 1, 1];\n");
        buf_str(out, c"                var i = 0;\n");
        buf_str(out, c"                while i < 3 && self.kind() != T_RPAREN && self.kind() != T_EOF {\n");
        buf_str(out, c"                    let p = self.pos();\n");
        buf_str(out, c"                    let n = self.const_int_arg();\n");
        buf_str(out, c"                    if n < 1 || n > 1024 {\n");
        buf_str(out, c"                        self.fail(p, \"wgsl.attr\", \"a workgroup size is 1 to 1024\");\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    at.wg[i] = n;\n");
        buf_str(out, c"                    i += 1;\n");
        buf_str(out, c"                    if !self.eat(T_COMMA) {\n");
        buf_str(out, c"                        break;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.expect(T_RPAREN);\n");
        buf_str(out, c"                if at.wg[0] * at.wg[1] * at.wg[2] > 1024 {\n");
        buf_str(out, c"                    self.fail(apos, \"wgsl.attr\", \"a workgroup has at most 1024 invocations\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else if s == K_GROUP || s == K_BINDING || s == K_LOCATION {\n");
        buf_str(out, c"                self.expect(T_LPAREN);\n");
        buf_str(out, c"                let p = self.pos();\n");
        buf_str(out, c"                let n = self.const_int_arg();\n");
        buf_str(out, c"                self.eat(T_COMMA);\n");
        buf_str(out, c"                self.expect(T_RPAREN);\n");
        buf_str(out, c"                if n < 0 {\n");
        buf_str(out, c"                    self.fail(p, \"wgsl.attr\", \"expected a non-negative integer\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if s == K_GROUP {\n");
        buf_str(out, c"                    at.group = n;\n");
        buf_str(out, c"                } else if s == K_BINDING {\n");
        buf_str(out, c"                    at.binding = n;\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    at.loc = n;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else if s == K_BUILTIN {\n");
        buf_str(out, c"                self.expect(T_LPAREN);\n");
        buf_str(out, c"                let bp = self.pos();\n");
        buf_str(out, c"                let b = self.ident();\n");
        buf_str(out, c"                self.eat(T_COMMA);\n");
        buf_str(out, c"                self.expect(T_RPAREN);\n");
        buf_str(out, c"                if b >= names::K_POSITION && b <= names::K_NUM_WORKGROUPS {\n");
        buf_str(out, c"                    at.builtin = b - names::K_POSITION;\n");
        buf_str(out, c"                } else if self.err(bp, \"wgsl.attr\") {\n");
        buf_str(out, c"                    self.emsg.push_fmt(f\"unknown builtin value '{self.name_of(b)}'\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else if s == K_INTERPOLATE {\n");
        buf_str(out, c"                self.expect(T_LPAREN);\n");
        buf_str(out, c"                let ip = self.pos();\n");
        buf_str(out, c"                let k = self.ident();\n");
        buf_str(out, c"                if k == K_FLAT {\n");
        buf_str(out, c"                    at.interp = INTERP_FLAT as i64;\n");
        buf_str(out, c"                } else if k == K_LINEAR {\n");
        buf_str(out, c"                    at.interp = INTERP_LINEAR as i64;\n");
        buf_str(out, c"                } else if k == K_PERSPECTIVE {\n");
        buf_str(out, c"                    at.interp = INTERP_PERSPECTIVE as i64;\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    self.fail(ip, \"wgsl.attr\", \"expected 'flat', 'linear' or 'perspective'\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if self.eat(T_COMMA) && self.kind() == T_IDENT {\n");
        buf_str(out, c"                    let smp = self.ident();\n");
        buf_str(out, c"                    if smp != K_CENTER {\n");
        buf_str(out, c"                        if smp == K_CENTROID || smp == K_SAMPLE {\n");
        buf_str(out, c"                            self.fail(ip, \"wgsl.unsupported\",\n");
        buf_str(out, c"                                \"only 'center' sampling is in the WGSL subset of this release\");\n");
        buf_str(out, c"                        }\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    self.eat(T_COMMA);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.expect(T_RPAREN);\n");
        buf_str(out, c"            } else if s == K_MUST_USE {\n");
        buf_str(out, c"            } else if s == K_INVARIANT || s == K_ALIGN || s == K_SIZE || s == K_ID {\n");
        buf_str(out, c"                if self.err(apos, \"wgsl.unsupported\") {\n");
        buf_str(out, c"                    self.emsg.push_fmt(\n");
        buf_str(out, c"                        f\"'@{self.name_of(s)}' is not in the WGSL subset of this release\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else if self.err(apos, \"wgsl.attr\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"unknown attribute '@{self.name_of(s)}'\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        at\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn binding_of(self, at: Attrs) -> Binding {\n");
        buf_str(out, c"        if at.builtin >= 0 {\n");
        buf_str(out, c"            return Binding { kind: BIND_BUILTIN, interp: INTERP_PERSPECTIVE, value: at.builtin };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if at.loc >= 0 {\n");
        buf_str(out, c"            let ip = if at.interp >= 0 { at.interp as u8 } else { INTERP_PERSPECTIVE };\n");
        buf_str(out, c"            return Binding { kind: BIND_LOCATION, interp: ip, value: at.loc };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        no_binding()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Types ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn resolve_type_decl(inout self, d: i64) -> i64 {\n");
        buf_str(out, c"        let dd = self.decls[d];\n");
        buf_str(out, c"        if dd.state == DS_DONE {\n");
        buf_str(out, c"            return dd.h;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if dd.state == DS_BUSY {\n");
        buf_str(out, c"            self.p = dd.tok;\n");
        buf_str(out, c"            if self.err(self.pos(), \"wgsl.cycle\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"'{self.name_of(dd.sym)}' refers to itself\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return T_I32;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.decls[d].state = DS_BUSY;\n");
        buf_str(out, c"        let saved = self.p;\n");
        buf_str(out, c"        self.p = dd.tok + 2;\n");
        buf_str(out, c"        var h = T_I32;\n");
        buf_str(out, c"        if dd.kind == D_ALIAS {\n");
        buf_str(out, c"            self.expect(T_EQ);\n");
        buf_str(out, c"            h = self.parse_type();\n");
        buf_str(out, c"            self.eat(T_SEMI);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            h = self.struct_body(dd.sym);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.p = saved;\n");
        buf_str(out, c"        self.decls[d].state = DS_DONE;\n");
        buf_str(out, c"        self.decls[d].h = h;\n");
        buf_str(out, c"        h\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn struct_body(inout self, sym: i64) -> i64 {\n");
        buf_str(out, c"        self.expect(T_LBRACE);\n");
        buf_str(out, c"        var list: V<StructMember> = Vec::new_in(self.a);\n");
        buf_str(out, c"        while self.kind() != T_RBRACE && self.kind() != T_EOF {\n");
        buf_str(out, c"            let at = self.parse_attrs();\n");
        buf_str(out, c"            let mpos = self.pos();\n");
        buf_str(out, c"            let ms = self.ident();\n");
        buf_str(out, c"            self.expect(T_COLON);\n");
        buf_str(out, c"            let tpos = self.pos();\n");
        buf_str(out, c"            let ty = self.parse_type();\n");
        buf_str(out, c"            for i in 0..list.len() {\n");
        buf_str(out, c"                if list[i].name == self.name_of(ms) {\n");
        buf_str(out, c"                    if self.err(mpos, \"wgsl.redefined\") {\n");
        buf_str(out, c"                        self.emsg.push_fmt(f\"member '{self.name_of(ms)}' is declared twice\");\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if self.m.is_runtime_sized(ty) && self.kind() != T_RBRACE\n");
        buf_str(out, c"                && !(self.kind() == T_COMMA && self.kind_at(self.p + 1) == T_RBRACE) {\n");
        buf_str(out, c"                self.fail(tpos, \"wgsl.type\",\n");
        buf_str(out, c"                    \"a runtime-sized array must be the last member of a struct\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if !self.storable(ty) {\n");
        buf_str(out, c"                if self.err(tpos, \"wgsl.type\") {\n");
        buf_str(out, c"                    self.emsg.push_str(\"a struct member cannot have type \");\n");
        buf_str(out, c"                    self.ty_str(ty);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            list.push(StructMember {\n");
        buf_str(out, c"                name: self.name_of(ms), ty: ty, offset: 0, binding: self.binding_of(at)\n");
        buf_str(out, c"            });\n");
        buf_str(out, c"            if !self.eat(T_COMMA) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.expect(T_RBRACE);\n");
        buf_str(out, c"        if list.len() == 0 {\n");
        buf_str(out, c"            self.fail(self.pos(), \"wgsl.type\", \"a struct has at least one member\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let start = self.m.members.len();\n");
        buf_str(out, c"        for i in 0..list.len() {\n");
        buf_str(out, c"            self.m.members.push(list[i]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.m.struct_ty(self.name_of(sym), start, list.len())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether values of t can live in memory (not pointers, textures, samplers).\n");
        buf_str(out, c"    pub fn storable(self, t: i64) -> bool {\n");
        buf_str(out, c"        let k = self.m.types[t].kind;\n");
        buf_str(out, c"        k != TK_POINTER && k != TK_TEXTURE && k != TK_SAMPLER\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An optional `<T>` after vecN / matCxR: T, else -1.\n");
        buf_str(out, c"    fn template_scalar(inout self) -> i64 {\n");
        buf_str(out, c"        if self.kind() != T_LT {\n");
        buf_str(out, c"            return -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.p += 1;\n");
        buf_str(out, c"        let t = self.parse_type();\n");
        buf_str(out, c"        self.expect_gt();\n");
        buf_str(out, c"        t\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether the identifier at the cursor starts a type (for `T(...)`\n");
        buf_str(out, c"    // constructors and template lists in expressions).\n");
        buf_str(out, c"    pub fn is_type_name(self, s: i64) -> bool {\n");
        buf_str(out, c"        if s >= names::K_BOOL && s <= names::K_TEXTURE_STORAGE_2D_ARRAY {\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s >= 0 && self.decl_of[s] >= 0 {\n");
        buf_str(out, c"            let k = self.decls[self.decl_of[s]].kind;\n");
        buf_str(out, c"            return k == D_STRUCT || k == D_ALIAS;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn parse_type(inout self) -> i64 {\n");
        buf_str(out, c"        let at = self.pos();\n");
        buf_str(out, c"        if self.kind() != T_IDENT {\n");
        buf_str(out, c"            self.expect(T_IDENT);\n");
        buf_str(out, c"            return T_I32;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let s = self.tk.syms[self.p];\n");
        buf_str(out, c"        self.p += 1;\n");
        buf_str(out, c"        if s == names::K_BOOL {\n");
        buf_str(out, c"            return T_BOOL;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == names::K_I32 {\n");
        buf_str(out, c"            return T_I32;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == names::K_U32 {\n");
        buf_str(out, c"            return T_U32;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == names::K_F32 {\n");
        buf_str(out, c"            return T_F32;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == names::K_F16 || (s >= names::K_VEC2H && s <= names::K_VEC4H) {\n");
        buf_str(out, c"            self.fail(at, \"wgsl.unsupported\", \"'f16' is not in the WGSL subset of this release\");\n");
        buf_str(out, c"            self.help(\"use f32\");\n");
        buf_str(out, c"            return T_F32;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s >= names::K_VEC2 && s <= names::K_VEC4 {\n");
        buf_str(out, c"            let n = s - names::K_VEC2 + 2;\n");
        buf_str(out, c"            if self.kind() != T_LT {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.type\",\n");
        buf_str(out, c"                    \"a vector type needs its component type, as in 'vec3<f32>' or 'vec3f'\");\n");
        buf_str(out, c"                return T_F32;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let c = self.template_scalar();\n");
        buf_str(out, c"            let k = self.m.types[c].kind;\n");
        buf_str(out, c"            if k != TK_SCALAR {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.type\", \"a vector's components are bool, i32, u32 or f32\");\n");
        buf_str(out, c"                return T_F32;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return ir::vec_ty(self.m.types[c].scalar, n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s >= names::K_VEC2I && s <= names::K_VEC4F {\n");
        buf_str(out, c"            let i = s - names::K_VEC2I;\n");
        buf_str(out, c"            let sk = if i < 3 { SK_I32 } else if i < 6 { SK_U32 } else { SK_F32 };\n");
        buf_str(out, c"            return ir::vec_ty(sk, i % 3 + 2);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s >= names::K_MAT2X2 && s <= names::K_MAT4X4F {\n");
        buf_str(out, c"            let i = (s - names::K_MAT2X2) % 9;\n");
        buf_str(out, c"            if s <= names::K_MAT4X4 {\n");
        buf_str(out, c"                if self.kind() != T_LT {\n");
        buf_str(out, c"                    self.fail(at, \"wgsl.type\",\n");
        buf_str(out, c"                        \"a matrix type needs its component type, as in 'mat4x4<f32>' or 'mat4x4f'\");\n");
        buf_str(out, c"                    return T_F32;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let c = self.template_scalar();\n");
        buf_str(out, c"                if c != T_F32 {\n");
        buf_str(out, c"                    self.fail(at, \"wgsl.type\",\n");
        buf_str(out, c"                        \"matrices have f32 components in the WGSL subset of this release\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return ir::mat_ty(i / 3 + 2, i % 3 + 2);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == names::K_ARRAY {\n");
        buf_str(out, c"            if self.kind() != T_LT {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.type\",\n");
        buf_str(out, c"                    \"an array type needs its element type, as in 'array<f32, 4>'\");\n");
        buf_str(out, c"                return T_I32;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let ep = self.pos();\n");
        buf_str(out, c"            let el = self.parse_type();\n");
        buf_str(out, c"            var n = 0;\n");
        buf_str(out, c"            if self.eat(T_COMMA) {\n");
        buf_str(out, c"                let np = self.pos();\n");
        buf_str(out, c"                let saved_f = self.save_scope_floor();\n");
        buf_str(out, c"                let v = self.parse_shift();\n");
        buf_str(out, c"                self.scope_floor = saved_f;\n");
        buf_str(out, c"                if v.k != VK_CONST || v.sk == SK_F32 || v.sk == ir::SK_AFLOAT || v.sk == SK_BOOL {\n");
        buf_str(out, c"                    self.fail(np, \"wgsl.type\", \"an array's length is a constant integer\");\n");
        buf_str(out, c"                    self.help(\n");
        buf_str(out, c"                        \"a runtime-sized array is written 'array<T>' and lives in a storage buffer\");\n");
        buf_str(out, c"                } else if v.iv < 1 {\n");
        buf_str(out, c"                    self.fail(np, \"wgsl.type\", \"an array's length is at least 1\");\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    n = v.iv;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.expect_gt();\n");
        buf_str(out, c"            if self.m.is_runtime_sized(el) {\n");
        buf_str(out, c"                self.fail(ep, \"wgsl.type\", \"an array's element cannot be runtime-sized\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if !self.storable(el) {\n");
        buf_str(out, c"                self.fail(ep, \"wgsl.type\",\n");
        buf_str(out, c"                    \"an array's element cannot be a pointer, texture or sampler\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return self.m.array_ty(el, n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == names::K_ATOMIC {\n");
        buf_str(out, c"            self.expect(T_LT);\n");
        buf_str(out, c"            let c = self.parse_type();\n");
        buf_str(out, c"            self.expect_gt();\n");
        buf_str(out, c"            if c != T_I32 && c != T_U32 {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.type\", \"an atomic holds an i32 or a u32\");\n");
        buf_str(out, c"                return self.m.atomic_ty(SK_U32);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return self.m.atomic_ty(self.m.types[c].scalar);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == names::K_PTR {\n");
        buf_str(out, c"            self.expect(T_LT);\n");
        buf_str(out, c"            let sp = self.address_space();\n");
        buf_str(out, c"            self.expect(T_COMMA);\n");
        buf_str(out, c"            let t = self.parse_type();\n");
        buf_str(out, c"            var acc = if sp == SP_STORAGE || sp == SP_UNIFORM { ACC_READ } else { ACC_RW };\n");
        buf_str(out, c"            if self.eat(T_COMMA) {\n");
        buf_str(out, c"                acc = self.access_mode();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.expect_gt();\n");
        buf_str(out, c"            if sp != SP_FUNCTION && sp != SP_PRIVATE {\n");
        buf_str(out, c"                // pointers to other spaces are values only (lets), never parameters\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return self.m.ptr_ty(t, sp, acc);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == names::K_SAMPLER {\n");
        buf_str(out, c"            return self.m.intern(TK_SAMPLER, 0, 0, 0, -1, 0, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == names::K_SAMPLER_COMPARISON {\n");
        buf_str(out, c"            return self.m.intern(TK_SAMPLER, 0, 1, 0, -1, 0, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == names::K_TEXTURE_2D || s == names::K_TEXTURE_2D_ARRAY {\n");
        buf_str(out, c"            self.expect(T_LT);\n");
        buf_str(out, c"            let c = self.parse_type();\n");
        buf_str(out, c"            self.expect_gt();\n");
        buf_str(out, c"            if c != T_F32 && c != T_I32 && c != T_U32 {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.type\", \"a texture's sampled type is f32, i32 or u32\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let dim = if s == names::K_TEXTURE_2D { ir::TEX_2D } else { ir::TEX_2D_ARRAY };\n");
        buf_str(out, c"            return self.m.intern(TK_TEXTURE, self.m.types[c].scalar, dim, 0, -1, 0, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == names::K_TEXTURE_DEPTH_2D {\n");
        buf_str(out, c"            return self.m.intern(TK_TEXTURE, SK_F32, ir::TEX_DEPTH_2D, 0, -1, 0, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == names::K_TEXTURE_STORAGE_2D {\n");
        buf_str(out, c"            self.expect(T_LT);\n");
        buf_str(out, c"            let fp = self.pos();\n");
        buf_str(out, c"            let f = self.ident();\n");
        buf_str(out, c"            var fmt = 0;\n");
        buf_str(out, c"            if f >= names::K_RGBA8UNORM && f <= names::K_RGBA32UINT {\n");
        buf_str(out, c"                fmt = f - names::K_RGBA8UNORM;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.fail(fp, \"wgsl.unsupported\", \"storage textures in this release are rgba8unorm, rgba32float, r32float, r32uint, r32sint or rgba32uint\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.expect(T_COMMA);\n");
        buf_str(out, c"            let ap = self.pos();\n");
        buf_str(out, c"            let acc = self.access_mode();\n");
        buf_str(out, c"            if acc != ACC_WRITE {\n");
        buf_str(out, c"                self.fail(ap, \"wgsl.unsupported\",\n");
        buf_str(out, c"                    \"storage textures are write-only in this release\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.expect_gt();\n");
        buf_str(out, c"            let sk = if fmt == ir::FMT_R32UINT || fmt == ir::FMT_RGBA32UINT {\n");
        buf_str(out, c"                SK_U32\n");
        buf_str(out, c"            } else if fmt == ir::FMT_R32SINT {\n");
        buf_str(out, c"                SK_I32\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                SK_F32\n");
        buf_str(out, c"            };\n");
        buf_str(out, c"            return self.m.intern(TK_TEXTURE, sk, ir::TEX_STORAGE_2D, fmt, -1, 0, ACC_WRITE);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s >= names::K_TEXTURE_1D && s <= names::K_TEXTURE_STORAGE_2D_ARRAY {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.unsupported\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(\n");
        buf_str(out, c"                    f\"'{self.name_of(s)}' is not in the WGSL subset of this release\");\n");
        buf_str(out, c"                self.help(\"2D textures are: texture_2d, texture_2d_array, texture_depth_2d, texture_storage_2d\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return T_F32;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.decl_of[s] >= 0 {\n");
        buf_str(out, c"            let d = self.decl_of[s];\n");
        buf_str(out, c"            let k = self.decls[d].kind;\n");
        buf_str(out, c"            if k == D_STRUCT || k == D_ALIAS {\n");
        buf_str(out, c"                return self.resolve_type_decl(d);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"'{self.name_of(s)}' is not a type\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return T_I32;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.err(at, \"wgsl.name\") {\n");
        buf_str(out, c"            self.emsg.push_fmt(f\"unknown type '{self.name_of(s)}'\");\n");
        buf_str(out, c"            self.help(\"the types are bool, i32, u32, f32, vecN<T>, matCxR<f32>, array<T, N>, atomic<T>, structs\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        T_I32\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn address_space(inout self) -> u8 {\n");
        buf_str(out, c"        let at = self.pos();\n");
        buf_str(out, c"        let s = self.ident();\n");
        buf_str(out, c"        if s == names::K_FUNCTION {\n");
        buf_str(out, c"            SP_FUNCTION\n");
        buf_str(out, c"        } else if s == names::K_PRIVATE {\n");
        buf_str(out, c"            SP_PRIVATE\n");
        buf_str(out, c"        } else if s == names::K_WORKGROUP {\n");
        buf_str(out, c"            SP_WORKGROUP\n");
        buf_str(out, c"        } else if s == names::K_UNIFORM {\n");
        buf_str(out, c"            SP_UNIFORM\n");
        buf_str(out, c"        } else if s == names::K_STORAGE {\n");
        buf_str(out, c"            SP_STORAGE\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.syntax\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"unknown address space '{self.name_of(s)}'\");\n");
        buf_str(out, c"                self.help(\"the address spaces are function, private, workgroup, uniform, storage\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            SP_PRIVATE\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn access_mode(inout self) -> u8 {\n");
        buf_str(out, c"        let at = self.pos();\n");
        buf_str(out, c"        let s = self.ident();\n");
        buf_str(out, c"        if s == names::K_READ {\n");
        buf_str(out, c"            ACC_READ\n");
        buf_str(out, c"        } else if s == names::K_WRITE {\n");
        buf_str(out, c"            ACC_WRITE\n");
        buf_str(out, c"        } else if s == names::K_READ_WRITE {\n");
        buf_str(out, c"            ACC_RW\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.syntax\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"unknown access mode '{self.name_of(s)}'\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            ACC_READ\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Globals and constants ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn resolve_global(inout self, d: i64) {\n");
        buf_str(out, c"        let dd = self.decls[d];\n");
        buf_str(out, c"        let saved = self.p;\n");
        buf_str(out, c"        self.p = dd.attr;\n");
        buf_str(out, c"        let at = self.parse_attrs();\n");
        buf_str(out, c"        self.p = dd.tok + 1;\n");
        buf_str(out, c"        var sp = SP_HANDLE;\n");
        buf_str(out, c"        var acc = ACC_READ;\n");
        buf_str(out, c"        var explicit_space = false;\n");
        buf_str(out, c"        if self.eat(T_LT) {\n");
        buf_str(out, c"            explicit_space = true;\n");
        buf_str(out, c"            sp = self.address_space();\n");
        buf_str(out, c"            acc = if sp == SP_STORAGE || sp == SP_UNIFORM { ACC_READ } else { ACC_RW };\n");
        buf_str(out, c"            if self.eat(T_COMMA) {\n");
        buf_str(out, c"                let ap = self.pos();\n");
        buf_str(out, c"                acc = self.access_mode();\n");
        buf_str(out, c"                if sp != SP_STORAGE {\n");
        buf_str(out, c"                    self.fail(ap, \"wgsl.type\", \"only storage variables have an access mode\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if acc == ACC_WRITE {\n");
        buf_str(out, c"                    self.fail(ap, \"wgsl.type\", \"storage variables are 'read' or 'read_write'\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.expect_gt();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let npos = self.pos();\n");
        buf_str(out, c"        self.ident();\n");
        buf_str(out, c"        var ty = T_I32;\n");
        buf_str(out, c"        var have_ty = false;\n");
        buf_str(out, c"        if self.eat(T_COLON) {\n");
        buf_str(out, c"            ty = self.parse_type();\n");
        buf_str(out, c"            have_ty = true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var init = -1;\n");
        buf_str(out, c"        if self.eat(T_EQ) {\n");
        buf_str(out, c"            let ip = self.pos();\n");
        buf_str(out, c"            if sp != SP_PRIVATE {\n");
        buf_str(out, c"                self.fail(ip, \"wgsl.type\",\n");
        buf_str(out, c"                    \"only 'var<private>' may have an initializer at module scope\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let v = self.parse_expr_hint(if have_ty { ty } else { -1 });\n");
        buf_str(out, c"            if !have_ty {\n");
        buf_str(out, c"                ty = self.concrete_type_of(v);\n");
        buf_str(out, c"                have_ty = true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            init = self.materialize(v, ty, ip);\n");
        buf_str(out, c"            if !self.is_const_expr(init) {\n");
        buf_str(out, c"                self.fail(ip, \"wgsl.type\",\n");
        buf_str(out, c"                    \"a module-scope initializer must be a constant expression\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.eat(T_SEMI);\n");
        buf_str(out, c"        if !have_ty {\n");
        buf_str(out, c"            self.fail(npos, \"wgsl.type\", \"a module-scope 'var' needs a type\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let tk = self.m.types[ty].kind;\n");
        buf_str(out, c"        if !explicit_space {\n");
        buf_str(out, c"            if tk != TK_TEXTURE && tk != TK_SAMPLER {\n");
        buf_str(out, c"                self.fail(npos, \"wgsl.type\", \"a module-scope 'var' needs an address space, as in 'var<private>' or 'var<storage, read_write>'\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if tk == TK_TEXTURE || tk == TK_SAMPLER {\n");
        buf_str(out, c"            self.fail(npos, \"wgsl.type\", \"a texture or sampler is declared without an address space: 'var t: texture_2d<f32>;'\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if sp == SP_UNIFORM || sp == SP_STORAGE || sp == SP_HANDLE {\n");
        buf_str(out, c"            if at.group < 0 || at.binding < 0 {\n");
        buf_str(out, c"                self.fail(npos, \"wgsl.binding\", \"a resource needs '@group(G) @binding(B)'\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if at.group >= 0 || at.binding >= 0 {\n");
        buf_str(out, c"            self.fail(npos, \"wgsl.binding\",\n");
        buf_str(out, c"                \"only uniform, storage, texture and sampler variables have a group and binding\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if sp == SP_UNIFORM && self.m.is_runtime_sized(ty) {\n");
        buf_str(out, c"            self.fail(npos, \"wgsl.type\", \"a uniform buffer cannot hold a runtime-sized array\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if sp != SP_STORAGE && self.m.is_runtime_sized(ty) {\n");
        buf_str(out, c"            self.fail(npos, \"wgsl.type\", \"a runtime-sized array lives only in a storage buffer\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.m.has_atomic(ty) && sp != SP_STORAGE && sp != SP_WORKGROUP {\n");
        buf_str(out, c"            self.fail(npos, \"wgsl.type\", \"atomics live in storage or workgroup memory\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.m.has_atomic(ty) && sp == SP_STORAGE && acc != ACC_RW {\n");
        buf_str(out, c"            self.fail(npos, \"wgsl.type\", \"atomics need 'var<storage, read_write>'\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if (sp == SP_UNIFORM || sp == SP_STORAGE) && !self.host_shareable(ty) {\n");
        buf_str(out, c"            self.fail(npos, \"wgsl.type\", \"a buffer's type cannot hold bool, pointers or textures\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if sp == SP_UNIFORM {\n");
        buf_str(out, c"            self.check_uniform_layout(ty, npos);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for i in 0..self.m.globals.len() {\n");
        buf_str(out, c"            let o = self.m.globals[i];\n");
        buf_str(out, c"            if o.group >= 0 && o.group == at.group && o.binding == at.binding {\n");
        buf_str(out, c"                if self.err(npos, \"wgsl.binding\") {\n");
        buf_str(out, c"                    self.emsg.push_fmt(\n");
        buf_str(out, c"                        f\"@group({at.group}) @binding({at.binding}) is also '{o.name}'\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let g = Global {\n");
        buf_str(out, c"            name: self.name_of(dd.sym),\n");
        buf_str(out, c"            space: sp,\n");
        buf_str(out, c"            access: acc,\n");
        buf_str(out, c"            ty: ty,\n");
        buf_str(out, c"            group: at.group,\n");
        buf_str(out, c"            binding: at.binding,\n");
        buf_str(out, c"            init: init,\n");
        buf_str(out, c"            pos: npos,\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        self.m.globals.push(g);\n");
        buf_str(out, c"        self.decls[d].h = self.m.globals.len() - 1;\n");
        buf_str(out, c"        self.decls[d].state = DS_DONE;\n");
        buf_str(out, c"        self.p = saved;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn host_shareable(self, t: i64) -> bool {\n");
        buf_str(out, c"        let ty = self.m.types[t];\n");
        buf_str(out, c"        if ty.kind == TK_SCALAR || ty.kind == TK_VECTOR {\n");
        buf_str(out, c"            return ty.scalar != SK_BOOL;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if ty.kind == TK_MATRIX || ty.kind == TK_ATOMIC {\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if ty.kind == TK_ARRAY {\n");
        buf_str(out, c"            return self.host_shareable(ty.base);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if ty.kind == TK_STRUCT {\n");
        buf_str(out, c"            for i in ty.mstart..ty.mstart + ty.mcount {\n");
        buf_str(out, c"                if !self.host_shareable(self.m.members[i].ty) {\n");
        buf_str(out, c"                    return false;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The uniform address space's extra rules: array strides and struct\n");
        buf_str(out, c"    // alignments are multiples of 16.\n");
        buf_str(out, c"    fn check_uniform_layout(inout self, t: i64, pos: i64) {\n");
        buf_str(out, c"        let ty = self.m.types[t];\n");
        buf_str(out, c"        if ty.kind == TK_ARRAY {\n");
        buf_str(out, c"            if ty.stride % 16 != 0 {\n");
        buf_str(out, c"                if self.err(pos, \"wgsl.layout\") {\n");
        buf_str(out, c"                    self.emsg.push_str(\n");
        buf_str(out, c"                        \"in a uniform buffer an array's stride is a multiple of 16; \");\n");
        buf_str(out, c"                    self.ty_str(t);\n");
        buf_str(out, c"                    self.emsg.push_fmt(f\" has {ty.stride}\");\n");
        buf_str(out, c"                    self.help(\"use vec4 elements, or a storage buffer\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.check_uniform_layout(ty.base, pos);\n");
        buf_str(out, c"        } else if ty.kind == TK_STRUCT {\n");
        buf_str(out, c"            for i in ty.mstart..ty.mstart + ty.mcount {\n");
        buf_str(out, c"                let mt = self.m.members[i].ty;\n");
        buf_str(out, c"                let mk = self.m.types[mt].kind;\n");
        buf_str(out, c"                if mk == TK_STRUCT && i > ty.mstart {\n");
        buf_str(out, c"                    let prev = self.m.members[i - 1];\n");
        buf_str(out, c"                    let prev_end = prev.offset + self.m.types[prev.ty].size;\n");
        buf_str(out, c"                    if self.m.members[i].offset - prev_end < 0\n");
        buf_str(out, c"                        || self.m.members[i].offset % 16 != 0 {\n");
        buf_str(out, c"                        if self.err(pos, \"wgsl.layout\") {\n");
        buf_str(out, c"                            self.emsg.push_fmt(\n");
        buf_str(out, c"                                f\"in a uniform buffer the struct member '{self.m.members[i].name}' must start at a multiple of 16\");\n");
        buf_str(out, c"                        }\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.check_uniform_layout(mt, pos);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A constant's value, evaluated once when it is a scalar; composites\n");
        buf_str(out, c"    // are re-made at each use, in the using function.\n");
        buf_str(out, c"    pub fn const_value(inout self, d: i64) -> Val {\n");
        buf_str(out, c"        let dd = self.decls[d];\n");
        buf_str(out, c"        if dd.has_cv {\n");
        buf_str(out, c"            return dd.cv;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if dd.state == DS_BUSY {\n");
        buf_str(out, c"            self.p = dd.tok;\n");
        buf_str(out, c"            if self.err(self.pos(), \"wgsl.cycle\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"'{self.name_of(dd.sym)}' refers to itself\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return cint(ir::SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.decls[d].state = DS_BUSY;\n");
        buf_str(out, c"        let saved = self.p;\n");
        buf_str(out, c"        let saved_floor = self.save_scope_floor();\n");
        buf_str(out, c"        self.p = dd.tok + 2;\n");
        buf_str(out, c"        var ty = -1;\n");
        buf_str(out, c"        if self.eat(T_COLON) {\n");
        buf_str(out, c"            ty = self.parse_type();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.expect(T_EQ);\n");
        buf_str(out, c"        let ip = self.pos();\n");
        buf_str(out, c"        var v = self.parse_expr_hint(ty);\n");
        buf_str(out, c"        if ty >= 0 {\n");
        buf_str(out, c"            v = self.convert_to(v, ty, ip);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if v.k == VK_REF {\n");
        buf_str(out, c"            self.fail(ip, \"wgsl.type\", \"a 'const' is a constant expression; this reads memory\");\n");
        buf_str(out, c"        } else if v.k == VK_VALUE && !self.is_const_expr(v.e) {\n");
        buf_str(out, c"            self.fail(ip, \"wgsl.type\", \"a 'const' is a constant expression\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.scope_floor = saved_floor;\n");
        buf_str(out, c"        self.p = saved;\n");
        buf_str(out, c"        self.decls[d].state = DS_DONE;\n");
        buf_str(out, c"        if v.k == VK_CONST {\n");
        buf_str(out, c"            self.decls[d].cv = v;\n");
        buf_str(out, c"            self.decls[d].has_cv = true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Lookups see only module-scope names until the floor is restored.\n");
        buf_str(out, c"    pub fn save_scope_floor(inout self) -> i64 {\n");
        buf_str(out, c"        let s = self.scope_floor;\n");
        buf_str(out, c"        self.scope_floor = self.scopes.len();\n");
        buf_str(out, c"        s\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether e is made of literals, zero values and compositions only.\n");
        buf_str(out, c"    pub fn is_const_expr(self, e: i64) -> bool {\n");
        buf_str(out, c"        if e < 0 {\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let x = self.f.exprs[e];\n");
        buf_str(out, c"        if x.op == ir::E_LITERAL || x.op == ir::E_ZERO {\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if x.op == ir::E_COMPOSE {\n");
        buf_str(out, c"            for i in x.a..x.a + x.b {\n");
        buf_str(out, c"                if !self.is_const_expr(self.f.args[i]) {\n");
        buf_str(out, c"                    return false;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if x.op == ir::E_SPLAT {\n");
        buf_str(out, c"            return self.is_const_expr(x.a);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Functions ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn signature(inout self, d: i64) {\n");
        buf_str(out, c"        let dd = self.decls[d];\n");
        buf_str(out, c"        let h = dd.h;\n");
        buf_str(out, c"        let saved = self.p;\n");
        buf_str(out, c"        self.p = dd.tok + 2;\n");
        buf_str(out, c"        self.expect(T_LPAREN);\n");
        buf_str(out, c"        var params: V<Param> = Vec::new_in(self.a);\n");
        buf_str(out, c"        while self.kind() != T_RPAREN && self.kind() != T_EOF {\n");
        buf_str(out, c"            let at = self.parse_attrs();\n");
        buf_str(out, c"            let ppos = self.pos();\n");
        buf_str(out, c"            let ps = self.ident();\n");
        buf_str(out, c"            self.expect(T_COLON);\n");
        buf_str(out, c"            let tp = self.pos();\n");
        buf_str(out, c"            let ty = self.parse_type();\n");
        buf_str(out, c"            let tk = self.m.types[ty].kind;\n");
        buf_str(out, c"            if tk == TK_POINTER {\n");
        buf_str(out, c"                let sp = self.m.types[ty].space;\n");
        buf_str(out, c"                if sp != SP_FUNCTION && sp != SP_PRIVATE {\n");
        buf_str(out, c"                    self.fail(tp, \"wgsl.unsupported\", \"pointer parameters are 'ptr<function, T>' or 'ptr<private, T>' in this release\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else if self.m.is_runtime_sized(ty) || self.m.has_atomic(ty) {\n");
        buf_str(out, c"                self.fail(tp, \"wgsl.type\",\n");
        buf_str(out, c"                    \"a parameter cannot hold a runtime-sized array or an atomic\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for i in 0..params.len() {\n");
        buf_str(out, c"                if params[i].name == self.name_of(ps) {\n");
        buf_str(out, c"                    if self.err(ppos, \"wgsl.redefined\") {\n");
        buf_str(out, c"                        self.emsg.push_fmt(f\"parameter '{self.name_of(ps)}' is declared twice\");\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            params.push(Param { name: self.name_of(ps), ty: ty, binding: self.binding_of(at) });\n");
        buf_str(out, c"            if !self.eat(T_COMMA) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.expect(T_RPAREN);\n");
        buf_str(out, c"        var result = -1;\n");
        buf_str(out, c"        var rb = no_binding();\n");
        buf_str(out, c"        if self.eat(T_ARROW) {\n");
        buf_str(out, c"            let at = self.parse_attrs();\n");
        buf_str(out, c"            let rp = self.pos();\n");
        buf_str(out, c"            result = self.parse_type();\n");
        buf_str(out, c"            rb = self.binding_of(at);\n");
        buf_str(out, c"            if !self.storable(result) || self.m.is_runtime_sized(result)\n");
        buf_str(out, c"                || self.m.has_atomic(result) {\n");
        buf_str(out, c"                self.fail(rp, \"wgsl.type\", \"a function cannot return a pointer, texture, sampler, atomic or runtime-sized array\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.m.functions[h].params = params;\n");
        buf_str(out, c"        self.m.functions[h].result = result;\n");
        buf_str(out, c"        self.m.functions[h].result_binding = rb;\n");
        buf_str(out, c"        self.m.functions[h].pos = self.tk.starts[dd.tok + 1];\n");
        buf_str(out, c"        // entry point?\n");
        buf_str(out, c"        self.p = dd.attr;\n");
        buf_str(out, c"        let at = self.parse_attrs();\n");
        buf_str(out, c"        if at.stage >= 0 {\n");
        buf_str(out, c"            if at.stage == STAGE_COMPUTE as i64 && at.wg[0] == 0 {\n");
        buf_str(out, c"                self.fail(self.tk.starts[dd.tok + 1], \"wgsl.entry\",\n");
        buf_str(out, c"                    \"a compute entry point needs '@workgroup_size(X, Y, Z)'\");\n");
        buf_str(out, c"                self.help(\"for example '@compute @workgroup_size(64)'\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let wg = if at.stage == STAGE_COMPUTE as i64 { at.wg } else { [0, 0, 0] };\n");
        buf_str(out, c"            self.m.entries.push(Entry {\n");
        buf_str(out, c"                stage: at.stage as u8, name: self.name_of(dd.sym), func: h, wg: wg,\n");
        buf_str(out, c"                early_depth: false\n");
        buf_str(out, c"            });\n");
        buf_str(out, c"            entry::check_interface(&self, self.m.entries.len() - 1);\n");
        buf_str(out, c"        } else if at.wg[0] != 0 {\n");
        buf_str(out, c"            self.fail(at.pos, \"wgsl.attr\", \"'@workgroup_size' belongs to a '@compute' entry point\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.p = saved;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn lower_fn(inout self, d: i64) {\n");
        buf_str(out, c"        let dd = self.decls[d];\n");
        buf_str(out, c"        let h = dd.h;\n");
        buf_str(out, c"        self.fh = h;\n");
        buf_str(out, c"        self.f = std::replace(&self.m.functions[h], new_function(\"\", self.a));\n");
        buf_str(out, c"        self.stage = 255;\n");
        buf_str(out, c"        for i in 0..self.m.entries.len() {\n");
        buf_str(out, c"            if self.m.entries[i].func == h {\n");
        buf_str(out, c"                self.stage = self.m.entries[i].stage as i64;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.gexpr.clear();\n");
        buf_str(out, c"        for _ in 0..self.m.globals.len() {\n");
        buf_str(out, c"            self.gexpr.push(-1);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.scopes.clear();\n");
        buf_str(out, c"        self.scope_floor = 0;\n");
        buf_str(out, c"        self.pending.clear();\n");
        buf_str(out, c"        self.emit_start = 0;\n");
        buf_str(out, c"        self.loop_depth = 0;\n");
        buf_str(out, c"        self.switch_depth = 0;\n");
        buf_str(out, c"        self.in_continuing = false;\n");
        buf_str(out, c"        // the parameters\n");
        buf_str(out, c"        self.p = dd.tok + 2;\n");
        buf_str(out, c"        self.expect(T_LPAREN);\n");
        buf_str(out, c"        var i = 0;\n");
        buf_str(out, c"        while self.kind() != T_RPAREN && self.kind() != T_EOF {\n");
        buf_str(out, c"            self.parse_attrs();\n");
        buf_str(out, c"            let ps = self.ident();\n");
        buf_str(out, c"            self.expect(T_COLON);\n");
        buf_str(out, c"            self.parse_type();\n");
        buf_str(out, c"            let ty = self.f.params[i].ty;\n");
        buf_str(out, c"            let e = self.f.expr(E_ARG, ty, i, 0, 0);\n");
        buf_str(out, c"            self.f.names[e] = self.name_of(ps);\n");
        buf_str(out, c"            self.scopes.push(ScopeEntry { sym: ps, v: val(e, ty), mutable: false });\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"            if !self.eat(T_COMMA) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.expect(T_RPAREN);\n");
        buf_str(out, c"        if self.eat(T_ARROW) {\n");
        buf_str(out, c"            self.parse_attrs();\n");
        buf_str(out, c"            self.parse_type();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let bpos = self.pos();\n");
        buf_str(out, c"        self.expect(T_LBRACE);\n");
        buf_str(out, c"        let base = self.pending.len();\n");
        buf_str(out, c"        self.statements();\n");
        buf_str(out, c"        let end = self.pos();\n");
        buf_str(out, c"        self.expect(T_RBRACE);\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        if self.f.result >= 0 && !self.block_returns(base) {\n");
        buf_str(out, c"            if self.err(end, \"wgsl.return\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(\n");
        buf_str(out, c"                    f\"function '{self.f.name}' can reach its end without returning a value\");\n");
        buf_str(out, c"                self.help(\"end it with a 'return'\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let _ = bpos;\n");
        buf_str(out, c"        self.f.body = self.f.block_of(&self.pending, base);\n");
        buf_str(out, c"        self.m.functions[h] = std::replace(&self.f, new_function(\"\", self.a));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether the statements pending[from ..] always return (or discard).\n");
        buf_str(out, c"    fn block_returns(self, from: i64) -> bool {\n");
        buf_str(out, c"        for i in from..self.pending.len() {\n");
        buf_str(out, c"            if self.stmt_returns(self.pending[i]) {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn list_returns(self, blk: i64) -> bool {\n");
        buf_str(out, c"        let b = self.f.blocks[blk];\n");
        buf_str(out, c"        for i in b.start..b.start + b.count {\n");
        buf_str(out, c"            if self.stmt_returns(self.f.items[i]) {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn stmt_returns(self, s: i64) -> bool {\n");
        buf_str(out, c"        let st = self.f.stmts[s];\n");
        buf_str(out, c"        if st.op == S_RETURN || st.op == S_KILL {\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if st.op == S_BLOCK {\n");
        buf_str(out, c"            return self.list_returns(st.a);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if st.op == S_IF {\n");
        buf_str(out, c"            return self.list_returns(st.b) && self.list_returns(st.c);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if st.op == S_SWITCH {\n");
        buf_str(out, c"            for i in st.b..st.b + st.c {\n");
        buf_str(out, c"                if !self.list_returns(self.f.cases[i].body) {\n");
        buf_str(out, c"                    return false;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if st.op == S_LOOP {\n");
        buf_str(out, c"            // a loop without a break of its own never ends but by returning\n");
        buf_str(out, c"            return !self.has_break(st.a, 0) && !self.has_break(st.b, 0) && st.c < 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn has_break(self, blk: i64, depth: i64) -> bool {\n");
        buf_str(out, c"        let b = self.f.blocks[blk];\n");
        buf_str(out, c"        for i in b.start..b.start + b.count {\n");
        buf_str(out, c"            let st = self.f.stmts[self.f.items[i]];\n");
        buf_str(out, c"            if st.op == S_BREAK && depth == 0 {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if st.op == S_BLOCK && self.has_break(st.a, depth) {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if st.op == S_IF && (self.has_break(st.b, depth) || self.has_break(st.c, depth)) {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if st.op == S_SWITCH {\n");
        buf_str(out, c"                for k in st.b..st.b + st.c {\n");
        buf_str(out, c"                    if self.has_break(self.f.cases[k].body, depth + 1) {\n");
        buf_str(out, c"                        return true;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if st.op == S_LOOP\n");
        buf_str(out, c"                && (self.has_break(st.a, depth + 1) || self.has_break(st.b, depth + 1)) {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // No recursion: WGSL's call graph is acyclic.\n");
        buf_str(out, c"    fn check_calls(inout self) {\n");
        buf_str(out, c"        let n = self.m.functions.len();\n");
        buf_str(out, c"        var state: V<u8> = Vec::filled_in(n, 0u8, self.a);\n");
        buf_str(out, c"        for i in 0..n {\n");
        buf_str(out, c"            if !self.visit_calls(i, &state) {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for e in 0..self.m.entries.len() {\n");
        buf_str(out, c"            let fh = self.m.entries[e].func;\n");
        buf_str(out, c"            for i in 0..n {\n");
        buf_str(out, c"                for s in 0..self.m.functions[i].stmts.len() {\n");
        buf_str(out, c"                    let st = self.m.functions[i].stmts[s];\n");
        buf_str(out, c"                    if st.op == S_CALL && st.a == fh {\n");
        buf_str(out, c"                        let pos = self.m.functions[i].pos;\n");
        buf_str(out, c"                        if self.err(pos, \"wgsl.call\") {\n");
        buf_str(out, c"                            self.emsg.push('\\'');\n");
        buf_str(out, c"                            self.emsg.push_str(self.m.functions[i].name);\n");
        buf_str(out, c"                            self.emsg.push_str(\"' calls the entry point '\");\n");
        buf_str(out, c"                            self.emsg.push_str(self.m.entries[e].name);\n");
        buf_str(out, c"                            self.emsg.push('\\'');\n");
        buf_str(out, c"                        }\n");
        buf_str(out, c"                        return;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn visit_calls(inout self, i: i64, state: inout V<u8>) -> bool {\n");
        buf_str(out, c"        if state[i] == 2 {\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if state[i] == 1 {\n");
        buf_str(out, c"            let pos = self.m.functions[i].pos;\n");
        buf_str(out, c"            if self.err(pos, \"wgsl.recursion\") {\n");
        buf_str(out, c"                self.emsg.push('\\'');\n");
        buf_str(out, c"                self.emsg.push_str(self.m.functions[i].name);\n");
        buf_str(out, c"                self.emsg.push_str(\"' calls itself, directly or through other functions\");\n");
        buf_str(out, c"                self.help(\"WGSL has no recursion: write it as a loop\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        state[i] = 1;\n");
        buf_str(out, c"        for s in 0..self.m.functions[i].stmts.len() {\n");
        buf_str(out, c"            let st = self.m.functions[i].stmts[s];\n");
        buf_str(out, c"            if st.op == S_CALL {\n");
        buf_str(out, c"                if !self.visit_calls(st.a, &state) {\n");
        buf_str(out, c"                    return false;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        state[i] = 2;\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Statements ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn lookup(self, sym: i64) -> i64 {\n");
        buf_str(out, c"        var i = self.scopes.len() - 1;\n");
        buf_str(out, c"        while i >= self.scope_floor {\n");
        buf_str(out, c"            if self.scopes[i].sym == sym {\n");
        buf_str(out, c"                return i;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i -= 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        -1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn statements(inout self) {\n");
        buf_str(out, c"        while self.kind() != T_RBRACE && self.kind() != T_EOF {\n");
        buf_str(out, c"            if self.in_continuing_end() {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.statement();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // In a loop body, `continuing` ends the body.\n");
        buf_str(out, c"    fn in_continuing_end(self) -> bool { self.is_kw(K_CONTINUING) && self.loop_depth > 0 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A `{ ... }` block with a scope of its own: its block handle.\n");
        buf_str(out, c"    fn compound(inout self) -> i64 {\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        let base = self.pending.len();\n");
        buf_str(out, c"        let scope = self.scopes.len();\n");
        buf_str(out, c"        self.expect(T_LBRACE);\n");
        buf_str(out, c"        self.statements_plain();\n");
        buf_str(out, c"        self.expect(T_RBRACE);\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        self.scopes.truncate(scope);\n");
        buf_str(out, c"        self.f.block_of(&self.pending, base)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn statements_plain(inout self) {\n");
        buf_str(out, c"        while self.kind() != T_RBRACE && self.kind() != T_EOF {\n");
        buf_str(out, c"            self.statement();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn statement(inout self) {\n");
        buf_str(out, c"        let at = self.pos();\n");
        buf_str(out, c"        let k = self.kind();\n");
        buf_str(out, c"        if k == T_SEMI {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k == T_LBRACE {\n");
        buf_str(out, c"            let b = self.compound();\n");
        buf_str(out, c"            self.push_stmt(S_BLOCK, b, 0, 0, 0);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k == T_AT {\n");
        buf_str(out, c"            self.fail(at, \"wgsl.unsupported\",\n");
        buf_str(out, c"                \"attributes on statements are not in the WGSL subset of this release\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k == T_IDENT {\n");
        buf_str(out, c"            let s = self.tk.syms[self.p];\n");
        buf_str(out, c"            if s == K_LET || s == K_CONST {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                self.let_decl(s == K_CONST);\n");
        buf_str(out, c"                self.expect(T_SEMI);\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if s == K_VAR {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                self.var_decl();\n");
        buf_str(out, c"                self.expect(T_SEMI);\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if s == K_IF {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                self.if_stmt();\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if s == K_RETURN {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                self.return_stmt(at);\n");
        buf_str(out, c"                self.expect(T_SEMI);\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if s == K_LOOP {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                self.loop_stmt();\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if s == K_FOR {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                self.for_stmt();\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if s == K_WHILE {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                self.while_stmt();\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if s == K_SWITCH {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                self.switch_stmt(at);\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if s == K_BREAK {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                if self.is_kw(K_IF) {\n");
        buf_str(out, c"                    self.fail(at, \"wgsl.syntax\",\n");
        buf_str(out, c"                        \"'break if' is the last statement of a 'continuing' block\");\n");
        buf_str(out, c"                    return;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if self.loop_depth == 0 && self.switch_depth == 0 {\n");
        buf_str(out, c"                    self.fail(at, \"wgsl.syntax\", \"'break' outside a loop or switch\");\n");
        buf_str(out, c"                } else if self.in_continuing && self.switch_depth == 0 {\n");
        buf_str(out, c"                    self.fail(at, \"wgsl.syntax\",\n");
        buf_str(out, c"                        \"'break' in 'continuing'; end it with 'break if COND;'\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.push_stmt(S_BREAK, 0, 0, 0, 0);\n");
        buf_str(out, c"                self.expect(T_SEMI);\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if s == K_CONTINUE {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                if self.loop_depth == 0 {\n");
        buf_str(out, c"                    self.fail(at, \"wgsl.syntax\", \"'continue' outside a loop\");\n");
        buf_str(out, c"                } else if self.in_continuing {\n");
        buf_str(out, c"                    self.fail(at, \"wgsl.syntax\", \"'continue' in a 'continuing' block\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.push_stmt(S_CONTINUE, 0, 0, 0, 0);\n");
        buf_str(out, c"                self.expect(T_SEMI);\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if s == K_DISCARD {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                if self.stage != STAGE_FRAGMENT as i64 && self.stage != 255 {\n");
        buf_str(out, c"                    self.fail(at, \"wgsl.stage\", \"'discard' is only for fragment shaders\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.push_stmt(S_KILL, 0, 0, 0, 0);\n");
        buf_str(out, c"                self.expect(T_SEMI);\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if s == K_CONST_ASSERT {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.unsupported\",\n");
        buf_str(out, c"                    \"'const_assert' is not in the WGSL subset of this release\");\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if s == K_CONTINUING {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.syntax\", \"'continuing' belongs at the end of a 'loop'\");\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if s == K_ELSE {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.syntax\", \"'else' without 'if'\");\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if s == K_CASE || s == K_DEFAULT {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.syntax\", \"'case' outside a 'switch'\");\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.simple_stmt();\n");
        buf_str(out, c"        self.expect(T_SEMI);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An assignment, increment, call or phony assignment (no `;`).\n");
        buf_str(out, c"    fn simple_stmt(inout self) {\n");
        buf_str(out, c"        let at = self.pos();\n");
        buf_str(out, c"        if self.kind() == T_UNDERSCORE {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            self.expect(T_EQ);\n");
        buf_str(out, c"            let v = self.parse_expr();\n");
        buf_str(out, c"            if v.k == VK_VOID {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.type\", \"a function without a result has no value to assign\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let _ = self.value(v, at);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let start_exprs = self.f.exprs.len();\n");
        buf_str(out, c"        let start_stmts = self.pending.len();\n");
        buf_str(out, c"        let lhs = self.parse_unary_for_stmt();\n");
        buf_str(out, c"        let k = self.kind();\n");
        buf_str(out, c"        if k == T_EQ {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let rp = self.pos();\n");
        buf_str(out, c"            let ptr = self.lhs_ptr(lhs, at);\n");
        buf_str(out, c"            let pointee = self.m.pointee(self.f.exprs[ptr].ty);\n");
        buf_str(out, c"            let rhs = self.parse_expr_hint(pointee);\n");
        buf_str(out, c"            let e = self.materialize(rhs, pointee, rp);\n");
        buf_str(out, c"            self.push_stmt(S_STORE, ptr, e, 0, 0);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k >= lex::T_PLUSEQ && k <= lex::T_SHREQ {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let op = compound_op(k);\n");
        buf_str(out, c"            let rp = self.pos();\n");
        buf_str(out, c"            let ptr = self.lhs_ptr(lhs, at);\n");
        buf_str(out, c"            let pointee = self.m.pointee(self.f.exprs[ptr].ty);\n");
        buf_str(out, c"            let cur = self.value(Val {\n");
        buf_str(out, c"                k: VK_REF, sk: 0, e: ptr, ty: self.f.exprs[ptr].ty, iv: 0, fv: 0.0\n");
        buf_str(out, c"            }, at);\n");
        buf_str(out, c"            let rhs = self.parse_expr();\n");
        buf_str(out, c"            let r = self.binary(op, cur, rhs, rp);\n");
        buf_str(out, c"            let e = self.materialize(r, pointee, rp);\n");
        buf_str(out, c"            self.push_stmt(S_STORE, ptr, e, 0, 0);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k == T_PLUSPLUS || k == T_MINUSMINUS {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let ptr = self.lhs_ptr(lhs, at);\n");
        buf_str(out, c"            let pointee = self.m.pointee(self.f.exprs[ptr].ty);\n");
        buf_str(out, c"            if pointee != T_I32 && pointee != T_U32 {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.type\", \"'++' and '--' apply to i32 and u32 variables\");\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let cur = self.value(Val {\n");
        buf_str(out, c"                k: VK_REF, sk: 0, e: ptr, ty: self.f.exprs[ptr].ty, iv: 0, fv: 0.0\n");
        buf_str(out, c"            }, at);\n");
        buf_str(out, c"            let one = cint(ir::SK_AINT, -1, 1);\n");
        buf_str(out, c"            let r = self.binary(if k == T_PLUSPLUS { ir::OP_ADD } else { ir::OP_SUB }, cur, one,\n");
        buf_str(out, c"                at);\n");
        buf_str(out, c"            let e = self.materialize(r, pointee, at);\n");
        buf_str(out, c"            self.push_stmt(S_STORE, ptr, e, 0, 0);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // a call statement: its result, if any, is dropped\n");
        buf_str(out, c"        let _ = start_exprs;\n");
        buf_str(out, c"        let _ = start_stmts;\n");
        buf_str(out, c"        if !self.last_was_call {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.syntax\") {\n");
        buf_str(out, c"                self.emsg.push_str(\n");
        buf_str(out, c"                    \"expected a statement: an assignment, a call, 'let', 'var', 'if', 'for', ...\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The pointer an assignment writes through.\n");
        buf_str(out, c"    fn lhs_ptr(inout self, lhs: Val, at: i64) -> i64 {\n");
        buf_str(out, c"        if lhs.k != VK_REF {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.assign\") {\n");
        buf_str(out, c"                self.emsg.push_str(\"cannot assign to this: it is a value, not a variable\");\n");
        buf_str(out, c"                self.help(\n");
        buf_str(out, c"                    \"assign to a 'var' (a 'let' is immutable), a member or element of one, or '*p'\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return self.dummy_ptr();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let pt = self.m.types[lhs.ty];\n");
        buf_str(out, c"        if pt.access & ACC_WRITE == 0 {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.access\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(\n");
        buf_str(out, c"                    f\"cannot write to a read-only {ir::space_name(pt.space)} variable\");\n");
        buf_str(out, c"                if pt.space == SP_STORAGE {\n");
        buf_str(out, c"                    self.help(\"declare it 'var<storage, read_write>'\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.m.has_atomic(pt.base) {\n");
        buf_str(out, c"            self.fail(at, \"wgsl.type\", \"an atomic is written with atomicStore\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        lhs.e\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn dummy_ptr(inout self) -> i64 {\n");
        buf_str(out, c"        let ty = self.m.ptr_ty(T_I32, SP_FUNCTION, ACC_RW);\n");
        buf_str(out, c"        self.f.expr(ir::E_ZERO, ty, 0, 0, 0)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn let_decl(inout self, is_const: bool) {\n");
        buf_str(out, c"        let npos = self.pos();\n");
        buf_str(out, c"        let s = self.ident();\n");
        buf_str(out, c"        var ty = -1;\n");
        buf_str(out, c"        if self.eat(T_COLON) {\n");
        buf_str(out, c"            ty = self.parse_type();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.expect(T_EQ);\n");
        buf_str(out, c"        let ip = self.pos();\n");
        buf_str(out, c"        if is_const {\n");
        buf_str(out, c"            var v = self.parse_expr_hint(ty);\n");
        buf_str(out, c"            if ty >= 0 {\n");
        buf_str(out, c"                v = self.convert_to(v, ty, ip);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if v.k == VK_REF || (v.k == VK_VALUE && !self.is_const_expr(v.e)) {\n");
        buf_str(out, c"                self.fail(ip, \"wgsl.type\", \"a 'const' is a constant expression\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.scopes.push(ScopeEntry { sym: s, v: v, mutable: false });\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let v = self.parse_expr_hint(ty);\n");
        buf_str(out, c"        if v.k == VK_VOID {\n");
        buf_str(out, c"            self.fail(ip, \"wgsl.type\", \"this call has no result to bind\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let t = if ty >= 0 { ty } else { self.concrete_type_of(v) };\n");
        buf_str(out, c"        if self.m.has_atomic(t) || self.m.is_runtime_sized(t) {\n");
        buf_str(out, c"            self.fail(ip, \"wgsl.type\", \"a 'let' cannot hold an atomic or a runtime-sized array\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let e = self.materialize(v, t, ip);\n");
        buf_str(out, c"        let _ = npos;\n");
        buf_str(out, c"        let eop = self.f.exprs[e].op;\n");
        buf_str(out, c"        if self.f.names[e].len == 0 && eop != E_ARG && eop != E_LOCAL && eop != E_GLOBAL {\n");
        buf_str(out, c"            self.f.names[e] = self.name_of(s);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.scopes.push(ScopeEntry { sym: s, v: val(e, t), mutable: false });\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn var_decl(inout self) {\n");
        buf_str(out, c"        if self.kind() == T_LT {\n");
        buf_str(out, c"            let ap = self.pos();\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let sp = self.address_space();\n");
        buf_str(out, c"            self.expect_gt();\n");
        buf_str(out, c"            if sp != SP_FUNCTION {\n");
        buf_str(out, c"                self.fail(ap, \"wgsl.type\", \"a variable in a function is 'var' or 'var<function>'\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let npos = self.pos();\n");
        buf_str(out, c"        let s = self.ident();\n");
        buf_str(out, c"        var ty = -1;\n");
        buf_str(out, c"        if self.eat(T_COLON) {\n");
        buf_str(out, c"            ty = self.parse_type();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var init = -1;\n");
        buf_str(out, c"        if self.eat(T_EQ) {\n");
        buf_str(out, c"            let ip = self.pos();\n");
        buf_str(out, c"            let v = self.parse_expr_hint(ty);\n");
        buf_str(out, c"            if v.k == VK_VOID {\n");
        buf_str(out, c"                self.fail(ip, \"wgsl.type\", \"this call has no result\");\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if ty < 0 {\n");
        buf_str(out, c"                ty = self.concrete_type_of(v);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            init = self.materialize(v, ty, ip);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if ty < 0 {\n");
        buf_str(out, c"            self.fail(npos, \"wgsl.type\", \"a 'var' needs a type or an initializer\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if !self.storable(ty) || self.m.has_atomic(ty) || self.m.is_runtime_sized(ty) {\n");
        buf_str(out, c"            if self.err(npos, \"wgsl.type\") {\n");
        buf_str(out, c"                self.emsg.push_str(\"a function variable cannot have type \");\n");
        buf_str(out, c"                self.ty_str(ty);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let l = self.f.locals.len();\n");
        buf_str(out, c"        self.f.locals.push(Local { name: self.name_of(s), ty: ty });\n");
        buf_str(out, c"        let pty = self.m.ptr_ty(ty, SP_FUNCTION, ACC_RW);\n");
        buf_str(out, c"        let e = self.f.expr(E_LOCAL, pty, l, 0, 0);\n");
        buf_str(out, c"        if init >= 0 {\n");
        buf_str(out, c"            self.push_stmt(S_STORE, e, init, 0, 0);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            // a variable is zero each time its declaration runs\n");
        buf_str(out, c"            let z = self.f.expr(ir::E_ZERO, ty, 0, 0, 0);\n");
        buf_str(out, c"            self.push_stmt(S_STORE, e, z, 0, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.scopes.push(ScopeEntry {\n");
        buf_str(out, c"            sym: s, v: Val { k: VK_REF, sk: 0, e: e, ty: pty, iv: 0, fv: 0.0 }, mutable: true\n");
        buf_str(out, c"        });\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn condition(inout self) -> i64 {\n");
        buf_str(out, c"        let at = self.pos();\n");
        buf_str(out, c"        let v = self.parse_expr();\n");
        buf_str(out, c"        if self.concrete_type_of(v) != T_BOOL {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                self.emsg.push_str(\"a condition is a bool, not \");\n");
        buf_str(out, c"                self.val_str(v);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return self.f.expr(ir::E_LITERAL, T_BOOL, 0, 0, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.materialize(v, T_BOOL, at)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn if_stmt(inout self) {\n");
        buf_str(out, c"        let c = self.condition();\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        let then_b = self.compound();\n");
        buf_str(out, c"        var else_b = -1;\n");
        buf_str(out, c"        if self.eat_kw(K_ELSE) {\n");
        buf_str(out, c"            if self.eat_kw(K_IF) {\n");
        buf_str(out, c"                let base = self.pending.len();\n");
        buf_str(out, c"                self.if_stmt();\n");
        buf_str(out, c"                self.flush();\n");
        buf_str(out, c"                else_b = self.f.block_of(&self.pending, base);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                else_b = self.compound();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            else_b = self.f.empty_block();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.push_stmt(S_IF, c, then_b, else_b, 0);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn return_stmt(inout self, at: i64) {\n");
        buf_str(out, c"        let rt = self.f.result;\n");
        buf_str(out, c"        if self.kind() == T_SEMI {\n");
        buf_str(out, c"            if rt >= 0 {\n");
        buf_str(out, c"                if self.err(at, \"wgsl.return\") {\n");
        buf_str(out, c"                    self.emsg.push_str(\"this function returns \");\n");
        buf_str(out, c"                    self.ty_str(rt);\n");
        buf_str(out, c"                    self.emsg.push_str(\": 'return' needs a value\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.push_stmt(S_RETURN, -1, 0, 0, 0);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let vp = self.pos();\n");
        buf_str(out, c"        let v = self.parse_expr_hint(rt);\n");
        buf_str(out, c"        if rt < 0 {\n");
        buf_str(out, c"            self.fail(vp, \"wgsl.return\", \"this function has no result: 'return;'\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let e = self.materialize(v, rt, vp);\n");
        buf_str(out, c"        self.push_stmt(S_RETURN, e, 0, 0, 0);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The body of a loop (from its `{`), then `continuing` and `break if`.\n");
        buf_str(out, c"    fn loop_stmt(inout self) {\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        let base = self.pending.len();\n");
        buf_str(out, c"        let scope = self.scopes.len();\n");
        buf_str(out, c"        self.expect(T_LBRACE);\n");
        buf_str(out, c"        self.loop_depth += 1;\n");
        buf_str(out, c"        let saved_switch = self.switch_depth;\n");
        buf_str(out, c"        self.switch_depth = 0;\n");
        buf_str(out, c"        self.statements();\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        let body = self.f.block_of(&self.pending, base);\n");
        buf_str(out, c"        var cont = -1;\n");
        buf_str(out, c"        var break_if = -1;\n");
        buf_str(out, c"        if self.eat_kw(K_CONTINUING) {\n");
        buf_str(out, c"            // the continuing block sees the body's names\n");
        buf_str(out, c"            let cbase = self.pending.len();\n");
        buf_str(out, c"            let saved_cont = self.in_continuing;\n");
        buf_str(out, c"            self.in_continuing = true;\n");
        buf_str(out, c"            self.expect(T_LBRACE);\n");
        buf_str(out, c"            while self.kind() != T_RBRACE && self.kind() != T_EOF {\n");
        buf_str(out, c"                if self.is_kw(K_BREAK) && self.kind_at(self.p + 1) == T_IDENT\n");
        buf_str(out, c"                    && self.tk.syms[self.p + 1] == K_IF {\n");
        buf_str(out, c"                    self.p += 2;\n");
        buf_str(out, c"                    break_if = self.condition();\n");
        buf_str(out, c"                    self.expect(T_SEMI);\n");
        buf_str(out, c"                    if self.kind() != T_RBRACE {\n");
        buf_str(out, c"                        self.fail(self.pos(), \"wgsl.syntax\",\n");
        buf_str(out, c"                            \"'break if' is the last statement of 'continuing'\");\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.statement();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.expect(T_RBRACE);\n");
        buf_str(out, c"            self.flush();\n");
        buf_str(out, c"            self.in_continuing = saved_cont;\n");
        buf_str(out, c"            cont = self.f.block_of(&self.pending, cbase);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            cont = self.f.empty_block();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.expect(T_RBRACE);\n");
        buf_str(out, c"        self.loop_depth -= 1;\n");
        buf_str(out, c"        self.switch_depth = saved_switch;\n");
        buf_str(out, c"        self.scopes.truncate(scope);\n");
        buf_str(out, c"        self.push_stmt(S_LOOP, body, cont, break_if, 0);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // `if !cond { break; }` at the head of a loop body.\n");
        buf_str(out, c"    fn break_unless(inout self, c: i64) {\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        let then_b = self.f.empty_block();\n");
        buf_str(out, c"        let base = self.pending.len();\n");
        buf_str(out, c"        let s = self.f.stmt(S_BREAK, 0, 0, 0, 0);\n");
        buf_str(out, c"        self.pending.push(s);\n");
        buf_str(out, c"        let else_b = self.f.block_of(&self.pending, base);\n");
        buf_str(out, c"        self.push_stmt(S_IF, c, then_b, else_b, 0);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn for_stmt(inout self) {\n");
        buf_str(out, c"        self.expect(T_LPAREN);\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        let outer = self.pending.len();\n");
        buf_str(out, c"        let scope = self.scopes.len();\n");
        buf_str(out, c"        // init\n");
        buf_str(out, c"        if self.kind() != T_SEMI {\n");
        buf_str(out, c"            if self.is_kw(K_VAR) {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                self.var_decl();\n");
        buf_str(out, c"            } else if self.is_kw(K_LET) || self.is_kw(K_CONST) {\n");
        buf_str(out, c"                let c = self.is_kw(K_CONST);\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                self.let_decl(c);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.simple_stmt();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.expect(T_SEMI);\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        // the loop: its body starts with the condition\n");
        buf_str(out, c"        let base = self.pending.len();\n");
        buf_str(out, c"        self.loop_depth += 1;\n");
        buf_str(out, c"        let saved_switch = self.switch_depth;\n");
        buf_str(out, c"        self.switch_depth = 0;\n");
        buf_str(out, c"        if self.kind() != T_SEMI {\n");
        buf_str(out, c"            let c = self.condition();\n");
        buf_str(out, c"            self.break_unless(c);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.expect(T_SEMI);\n");
        buf_str(out, c"        // the update is parsed after the body, so remember where it is\n");
        buf_str(out, c"        let upd = self.p;\n");
        buf_str(out, c"        var depth = 0;\n");
        buf_str(out, c"        while self.kind() != T_EOF {\n");
        buf_str(out, c"            let k = self.kind();\n");
        buf_str(out, c"            if k == T_LPAREN {\n");
        buf_str(out, c"                depth += 1;\n");
        buf_str(out, c"            } else if k == T_RPAREN {\n");
        buf_str(out, c"                if depth == 0 {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                depth -= 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.expect(T_RPAREN);\n");
        buf_str(out, c"        let b = self.compound();\n");
        buf_str(out, c"        self.push_stmt(S_BLOCK, b, 0, 0, 0);\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        let body = self.f.block_of(&self.pending, base);\n");
        buf_str(out, c"        let after = self.p;\n");
        buf_str(out, c"        self.p = upd;\n");
        buf_str(out, c"        let cbase = self.pending.len();\n");
        buf_str(out, c"        let saved_cont = self.in_continuing;\n");
        buf_str(out, c"        self.in_continuing = true;\n");
        buf_str(out, c"        if self.kind() != T_RPAREN {\n");
        buf_str(out, c"            self.simple_stmt();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.in_continuing = saved_cont;\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        let cont = self.f.block_of(&self.pending, cbase);\n");
        buf_str(out, c"        self.p = after;\n");
        buf_str(out, c"        self.loop_depth -= 1;\n");
        buf_str(out, c"        self.switch_depth = saved_switch;\n");
        buf_str(out, c"        self.push_stmt(S_LOOP, body, cont, -1, 0);\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        self.scopes.truncate(scope);\n");
        buf_str(out, c"        let blk = self.f.block_of(&self.pending, outer);\n");
        buf_str(out, c"        self.push_stmt(S_BLOCK, blk, 0, 0, 0);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn while_stmt(inout self) {\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        let base = self.pending.len();\n");
        buf_str(out, c"        self.loop_depth += 1;\n");
        buf_str(out, c"        let saved_switch = self.switch_depth;\n");
        buf_str(out, c"        self.switch_depth = 0;\n");
        buf_str(out, c"        let c = self.condition();\n");
        buf_str(out, c"        self.break_unless(c);\n");
        buf_str(out, c"        let b = self.compound();\n");
        buf_str(out, c"        self.push_stmt(S_BLOCK, b, 0, 0, 0);\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        let body = self.f.block_of(&self.pending, base);\n");
        buf_str(out, c"        self.loop_depth -= 1;\n");
        buf_str(out, c"        self.switch_depth = saved_switch;\n");
        buf_str(out, c"        let cont = self.f.empty_block();\n");
        buf_str(out, c"        self.push_stmt(S_LOOP, body, cont, -1, 0);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn switch_stmt(inout self, at: i64) {\n");
        buf_str(out, c"        let sp = self.pos();\n");
        buf_str(out, c"        let sel = self.parse_expr();\n");
        buf_str(out, c"        let st = self.concrete_type_of(sel);\n");
        buf_str(out, c"        if st != T_I32 && st != T_U32 {\n");
        buf_str(out, c"            if self.err(sp, \"wgsl.type\") {\n");
        buf_str(out, c"                self.emsg.push_str(\"a switch selector is an i32 or a u32, not \");\n");
        buf_str(out, c"                self.val_str(sel);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let se = self.materialize(sel, st, sp);\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        self.expect(T_LBRACE);\n");
        buf_str(out, c"        var clauses: V<ir::Case> = Vec::new_in(self.a);\n");
        buf_str(out, c"        var seen: V<i64> = Vec::new_in(self.a);\n");
        buf_str(out, c"        var defaults = 0;\n");
        buf_str(out, c"        self.switch_depth += 1;\n");
        buf_str(out, c"        while self.kind() != T_RBRACE && self.kind() != T_EOF {\n");
        buf_str(out, c"            let cp = self.pos();\n");
        buf_str(out, c"            var is_default = false;\n");
        buf_str(out, c"            let vstart = self.f.vals.len();\n");
        buf_str(out, c"            if self.eat_kw(K_DEFAULT) {\n");
        buf_str(out, c"                is_default = true;\n");
        buf_str(out, c"            } else if self.eat_kw(K_CASE) {\n");
        buf_str(out, c"                while self.kind() != T_LBRACE && self.kind() != T_COLON && self.kind() != T_EOF {\n");
        buf_str(out, c"                    if self.eat_kw(K_DEFAULT) {\n");
        buf_str(out, c"                        is_default = true;\n");
        buf_str(out, c"                    } else {\n");
        buf_str(out, c"                        let vp = self.pos();\n");
        buf_str(out, c"                        let v = self.parse_expr();\n");
        buf_str(out, c"                        let c = self.convert_to(v, st, vp);\n");
        buf_str(out, c"                        if c.k != VK_CONST {\n");
        buf_str(out, c"                            self.fail(vp, \"wgsl.type\", \"a case selector is a constant\");\n");
        buf_str(out, c"                        }\n");
        buf_str(out, c"                        for i in 0..seen.len() {\n");
        buf_str(out, c"                            if seen[i] == c.iv {\n");
        buf_str(out, c"                                if self.err(vp, \"wgsl.switch\") {\n");
        buf_str(out, c"                                    self.emsg.push_fmt(f\"case {c.iv} appears twice\");\n");
        buf_str(out, c"                                }\n");
        buf_str(out, c"                            }\n");
        buf_str(out, c"                        }\n");
        buf_str(out, c"                        seen.push(c.iv);\n");
        buf_str(out, c"                        self.f.vals.push(c.iv);\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    if !self.eat(T_COMMA) {\n");
        buf_str(out, c"                        break;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                if self.err(cp, \"wgsl.syntax\") {\n");
        buf_str(out, c"                    self.emsg.push_str(\"expected 'case' or 'default' in a switch\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if is_default {\n");
        buf_str(out, c"                defaults += 1;\n");
        buf_str(out, c"                if defaults > 1 {\n");
        buf_str(out, c"                    self.fail(cp, \"wgsl.switch\", \"a switch has one 'default'\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.eat(T_COLON);\n");
        buf_str(out, c"            let body = self.compound();\n");
        buf_str(out, c"            clauses.push(ir::Case {\n");
        buf_str(out, c"                vstart: vstart, vcount: self.f.vals.len() - vstart, is_default: is_default,\n");
        buf_str(out, c"                body: body\n");
        buf_str(out, c"            });\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.switch_depth -= 1;\n");
        buf_str(out, c"        self.expect(T_RBRACE);\n");
        buf_str(out, c"        if defaults == 0 {\n");
        buf_str(out, c"            self.fail(at, \"wgsl.switch\", \"a switch needs a 'default' clause\");\n");
        buf_str(out, c"            self.help(\"add 'default: {}'\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let cstart = self.f.cases.len();\n");
        buf_str(out, c"        for i in 0..clauses.len() {\n");
        buf_str(out, c"            self.f.cases.push(clauses[i]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.push_stmt(S_SWITCH, se, cstart, clauses.len(), 0);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A call as a statement: S_CALL is pushed by the call's lowering.\n");
        buf_str(out, c"    pub fn call_stmt(inout self, fh: i64, args_start: i64, n: i64) -> Val {\n");
        buf_str(out, c"        let rt = if fh == self.fh { self.f.result } else { self.m.functions[fh].result };\n");
        buf_str(out, c"        if rt < 0 {\n");
        buf_str(out, c"            self.push_stmt(S_CALL, fh, args_start, n, -1);\n");
        buf_str(out, c"            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let r = self.unemitted(E_CALL_RESULT, rt);\n");
        buf_str(out, c"        self.push_stmt(S_CALL, fh, args_start, n, r);\n");
        buf_str(out, c"        val(r, rt)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn compound_op(k: u8) -> i64 {\n");
        buf_str(out, c"    if k == lex::T_PLUSEQ {\n");
        buf_str(out, c"        ir::OP_ADD\n");
        buf_str(out, c"    } else if k == lex::T_MINUSEQ {\n");
        buf_str(out, c"        ir::OP_SUB\n");
        buf_str(out, c"    } else if k == lex::T_STAREQ {\n");
        buf_str(out, c"        ir::OP_MUL\n");
        buf_str(out, c"    } else if k == lex::T_SLASHEQ {\n");
        buf_str(out, c"        ir::OP_DIV\n");
        buf_str(out, c"    } else if k == lex::T_PERCENTEQ {\n");
        buf_str(out, c"        ir::OP_MOD\n");
        buf_str(out, c"    } else if k == lex::T_AMPEQ {\n");
        buf_str(out, c"        ir::OP_AND\n");
        buf_str(out, c"    } else if k == lex::T_PIPEEQ {\n");
        buf_str(out, c"        ir::OP_OR\n");
        buf_str(out, c"    } else if k == lex::T_CARETEQ {\n");
        buf_str(out, c"        ir::OP_XOR\n");
        buf_str(out, c"    } else if k == lex::T_SHLEQ {\n");
        buf_str(out, c"        ir::OP_SHL\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        ir::OP_SHR\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl::front ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::gpu::wgsl::expr ----\n");
        buf_str(out, c"pub mod expr {\n");
        buf_str(out, c"// ---- Shader compiler implementation, expr (0.22) ----\n");
        buf_str(out, c"// Expressions: WGSL's grammar, the Load Rule, abstract numbers and their\n");
        buf_str(out, c"// conversions, constant folding, operators and their types, indexing and\n");
        buf_str(out, c"// member access. Calls and constructors are in builtins.tach.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use front::{\n");
        buf_str(out, c"    Front, ScopeEntry, VK_CONST, VK_REF, VK_TYPE, VK_VALUE, VK_VOID, Val, cfloat, cint, val,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"use ir::{\n");
        buf_str(out, c"    E_ACCESS, E_ACCESS_INDEX, E_BINARY, E_CONVERT, E_LITERAL, E_LOAD, E_SPLAT, E_SWIZZLE, E_UNARY,\n");
        buf_str(out, c"    E_ZERO, OP_ADD, OP_AND, OP_DIV, OP_EQ, OP_GE, OP_GT, OP_LAND, OP_LE, OP_LOR, OP_LT, OP_MOD,\n");
        buf_str(out, c"    OP_MUL, OP_NE, OP_OR, OP_SHL, OP_SHR, OP_SUB, OP_XOR, SK_AFLOAT, SK_AINT, SK_BOOL, SK_F32,\n");
        buf_str(out, c"    SK_I32, SK_U32, SP_FUNCTION, S_IF, S_STORE, TK_ARRAY, TK_MATRIX, TK_POINTER, TK_SCALAR,\n");
        buf_str(out, c"    TK_STRUCT, TK_VECTOR, T_BOOL, T_F32, T_I32, T_U32, UN_BITNOT, UN_NEG, UN_NOT, f32_bits, mat_ty,\n");
        buf_str(out, c"    vec_ty,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"use lex::{\n");
        buf_str(out, c"    T_AMP, T_ANDAND, T_BANG, T_CARET, T_DOT, T_EQEQ, T_FLOAT, T_GE, T_GT, T_IDENT, T_INT,\n");
        buf_str(out, c"    T_LBRACKET, T_LE, T_LPAREN, T_LT, T_MINUS, T_NE, T_OROR, T_PERCENT, T_PIPE, T_PLUS, T_RBRACKET,\n");
        buf_str(out, c"    T_RPAREN, T_SHL, T_SHR, T_SLASH, T_STAR, T_TILDE,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"use names::{K_FALSE, K_TRUE};\n");
        buf_str(out, c"\n");
        buf_str(out, c"const I32_MIN: i64 = -2147483648;\n");
        buf_str(out, c"const I32_MAX: i64 = 2147483647;\n");
        buf_str(out, c"const U32_MAX: i64 = 4294967295;\n");
        buf_str(out, c"const F32_MAX: f64 = 340282346638528859811704183484516925440.0;\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Front {\n");
        buf_str(out, c"    pub fn parse_expr(inout self) -> Val { self.parse_expr_hint(-1) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An expression; `hint` (a type or -1) is the type the context\n");
        buf_str(out, c"    // expects, which an inferred constructor of abstract numbers takes.\n");
        buf_str(out, c"    pub fn parse_expr_hint(inout self, hint: i64) -> Val {\n");
        buf_str(out, c"        let saved = self.hint;\n");
        buf_str(out, c"        self.hint = hint;\n");
        buf_str(out, c"        let at = self.pos();\n");
        buf_str(out, c"        let l = self.parse_relational();\n");
        buf_str(out, c"        let k = self.kind();\n");
        buf_str(out, c"        if k != T_ANDAND && k != T_OROR {\n");
        buf_str(out, c"            self.hint = saved;\n");
        buf_str(out, c"            return l;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var acc = l;\n");
        buf_str(out, c"        while self.kind() == k {\n");
        buf_str(out, c"            let op_at = self.pos();\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            acc = self.short_circuit(k == T_ANDAND, acc, op_at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let k2 = self.kind();\n");
        buf_str(out, c"        if k2 == T_ANDAND || k2 == T_OROR {\n");
        buf_str(out, c"            self.fail(self.pos(), \"wgsl.syntax\", \"mixing '&&' and '||' needs parentheses\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let _ = at;\n");
        buf_str(out, c"        self.hint = saved;\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // `l && r` or `l || r`: r is evaluated only when needed. Without\n");
        buf_str(out, c"    // effects in r this is a plain operator; else it is an `if` writing a\n");
        buf_str(out, c"    // temporary variable.\n");
        buf_str(out, c"    fn short_circuit(inout self, and: bool, l: Val, at: i64) -> Val {\n");
        buf_str(out, c"        let lc = self.concrete_type_of(l);\n");
        buf_str(out, c"        if lc != T_BOOL {\n");
        buf_str(out, c"            self.bad_operands(if and { \"&&\" } else { \"||\" }, l, l, at);\n");
        buf_str(out, c"            return cint(SK_BOOL, T_BOOL, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if l.k == VK_CONST {\n");
        buf_str(out, c"            // a constant left side decides\n");
        buf_str(out, c"            let r = self.parse_relational();\n");
        buf_str(out, c"            if self.concrete_type_of(r) != T_BOOL {\n");
        buf_str(out, c"                self.bad_operands(if and { \"&&\" } else { \"||\" }, l, r, at);\n");
        buf_str(out, c"                return l;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if and && l.iv == 0 {\n");
        buf_str(out, c"                return l;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if !and && l.iv != 0 {\n");
        buf_str(out, c"                return l;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return self.value(r, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let le = self.materialize(l, T_BOOL, at);\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        let before = self.pending.len();\n");
        buf_str(out, c"        let rp = self.pos();\n");
        buf_str(out, c"        let r = self.parse_relational();\n");
        buf_str(out, c"        if self.concrete_type_of(r) != T_BOOL {\n");
        buf_str(out, c"            self.bad_operands(if and { \"&&\" } else { \"||\" }, l, r, at);\n");
        buf_str(out, c"            return l;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let re = self.materialize(r, T_BOOL, rp);\n");
        buf_str(out, c"        if self.pending.len() == before {\n");
        buf_str(out, c"            let e = self.f.expr(E_BINARY, T_BOOL, if and { OP_LAND } else { OP_LOR }, le, re);\n");
        buf_str(out, c"            return val(e, T_BOOL);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // r made statements (calls): t = l; if (l == and) { r's statements; t = r }\n");
        buf_str(out, c"        self.flush();\n");
        buf_str(out, c"        let lt = self.f.locals.len();\n");
        buf_str(out, c"        self.f.locals.push(ir::Local { name: \"\", ty: T_BOOL });\n");
        buf_str(out, c"        let pty = self.m.ptr_ty(T_BOOL, SP_FUNCTION, ir::ACC_RW);\n");
        buf_str(out, c"        let tv = self.f.expr(ir::E_LOCAL, pty, lt, 0, 0);\n");
        buf_str(out, c"        let st = self.f.stmt(S_STORE, tv, re, 0, 0);\n");
        buf_str(out, c"        self.pending.push(st);\n");
        buf_str(out, c"        let inner = self.f.block_of(&self.pending, before);\n");
        buf_str(out, c"        let empty = self.f.empty_block();\n");
        buf_str(out, c"        let st0 = self.f.stmt(S_STORE, tv, le, 0, 0);\n");
        buf_str(out, c"        self.pending.push(st0);\n");
        buf_str(out, c"        if and {\n");
        buf_str(out, c"            self.push_stmt(S_IF, le, inner, empty, 0);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.push_stmt(S_IF, le, empty, inner, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let e = self.f.expr(E_LOAD, T_BOOL, tv, 0, 0);\n");
        buf_str(out, c"        val(e, T_BOOL)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn parse_relational(inout self) -> Val {\n");
        buf_str(out, c"        let l = self.parse_shift();\n");
        buf_str(out, c"        let k = self.kind();\n");
        buf_str(out, c"        var op = -1;\n");
        buf_str(out, c"        if k == T_LT {\n");
        buf_str(out, c"            op = OP_LT;\n");
        buf_str(out, c"        } else if k == T_LE {\n");
        buf_str(out, c"            op = OP_LE;\n");
        buf_str(out, c"        } else if k == T_GT {\n");
        buf_str(out, c"            op = OP_GT;\n");
        buf_str(out, c"        } else if k == T_GE {\n");
        buf_str(out, c"            op = OP_GE;\n");
        buf_str(out, c"        } else if k == T_EQEQ {\n");
        buf_str(out, c"            op = OP_EQ;\n");
        buf_str(out, c"        } else if k == T_NE {\n");
        buf_str(out, c"            op = OP_NE;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op < 0 {\n");
        buf_str(out, c"            return l;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let at = self.pos();\n");
        buf_str(out, c"        self.p += 1;\n");
        buf_str(out, c"        let r = self.parse_shift();\n");
        buf_str(out, c"        let v = self.binary(op, l, r, at);\n");
        buf_str(out, c"        let k2 = self.kind();\n");
        buf_str(out, c"        if k2 == T_LT || k2 == T_LE || k2 == T_GT || k2 == T_GE || k2 == T_EQEQ || k2 == T_NE {\n");
        buf_str(out, c"            self.fail(self.pos(), \"wgsl.syntax\", \"comparisons do not chain: 'a < b && b < c'\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A shift, a bitwise expression, or an additive one.\n");
        buf_str(out, c"    pub fn parse_shift(inout self) -> Val {\n");
        buf_str(out, c"        let u = self.parse_unary();\n");
        buf_str(out, c"        let k = self.kind();\n");
        buf_str(out, c"        if k == T_SHL || k == T_SHR {\n");
        buf_str(out, c"            let at = self.pos();\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let r = self.parse_unary();\n");
        buf_str(out, c"            return self.binary(if k == T_SHL { OP_SHL } else { OP_SHR }, u, r, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k == T_AMP || k == T_PIPE || k == T_CARET {\n");
        buf_str(out, c"            let op = if k == T_AMP { OP_AND } else if k == T_PIPE { OP_OR } else { OP_XOR };\n");
        buf_str(out, c"            var acc = u;\n");
        buf_str(out, c"            while self.kind() == k {\n");
        buf_str(out, c"                let at = self.pos();\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                let r = self.parse_unary();\n");
        buf_str(out, c"                acc = self.binary(op, acc, r, at);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let k2 = self.kind();\n");
        buf_str(out, c"            if k2 == T_AMP || k2 == T_PIPE || k2 == T_CARET || k2 == T_PLUS || k2 == T_MINUS\n");
        buf_str(out, c"                || k2 == T_STAR || k2 == T_SLASH || k2 == T_PERCENT {\n");
        buf_str(out, c"                self.fail(self.pos(), \"wgsl.syntax\",\n");
        buf_str(out, c"                    \"mixing bitwise operators with other operators needs parentheses\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return acc;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var l = self.parse_mult_from(u);\n");
        buf_str(out, c"        while self.kind() == T_PLUS || self.kind() == T_MINUS {\n");
        buf_str(out, c"            let op = if self.kind() == T_PLUS { OP_ADD } else { OP_SUB };\n");
        buf_str(out, c"            let at = self.pos();\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let r0 = self.parse_unary();\n");
        buf_str(out, c"            let r = self.parse_mult_from(r0);\n");
        buf_str(out, c"            l = self.binary(op, l, r, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let k3 = self.kind();\n");
        buf_str(out, c"        if k3 == T_AMP || k3 == T_PIPE || k3 == T_CARET || k3 == T_SHL || k3 == T_SHR {\n");
        buf_str(out, c"            self.fail(self.pos(), \"wgsl.syntax\",\n");
        buf_str(out, c"                \"mixing bitwise or shift operators with arithmetic needs parentheses\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        l\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn parse_mult_from(inout self, u: Val) -> Val {\n");
        buf_str(out, c"        var l = u;\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            let k = self.kind();\n");
        buf_str(out, c"            let op = if k == T_STAR {\n");
        buf_str(out, c"                OP_MUL\n");
        buf_str(out, c"            } else if k == T_SLASH {\n");
        buf_str(out, c"                OP_DIV\n");
        buf_str(out, c"            } else if k == T_PERCENT {\n");
        buf_str(out, c"                OP_MOD\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                return l;\n");
        buf_str(out, c"            };\n");
        buf_str(out, c"            let at = self.pos();\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let r = self.parse_unary();\n");
        buf_str(out, c"            l = self.binary(op, l, r, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A statement's left side or call: a unary expression; remembers\n");
        buf_str(out, c"    // whether it ended in a user call.\n");
        buf_str(out, c"    pub fn parse_unary_for_stmt(inout self) -> Val {\n");
        buf_str(out, c"        self.last_call_end = -1;\n");
        buf_str(out, c"        let v = self.parse_unary();\n");
        buf_str(out, c"        if self.last_call_end != self.p {\n");
        buf_str(out, c"            self.last_was_call = false;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.last_was_call = true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn parse_unary(inout self) -> Val {\n");
        buf_str(out, c"        let at = self.pos();\n");
        buf_str(out, c"        let k = self.kind();\n");
        buf_str(out, c"        if k == T_MINUS {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let v = self.parse_unary();\n");
        buf_str(out, c"            return self.unary(UN_NEG, v, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k == T_BANG {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let v = self.parse_unary();\n");
        buf_str(out, c"            return self.unary(UN_NOT, v, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k == T_TILDE {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let v = self.parse_unary();\n");
        buf_str(out, c"            return self.unary(UN_BITNOT, v, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k == T_STAR {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let v = self.parse_unary();\n");
        buf_str(out, c"            let pv = self.value(v, at);\n");
        buf_str(out, c"            if pv.k != VK_VALUE || self.m.types[pv.ty].kind != TK_POINTER {\n");
        buf_str(out, c"                if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                    self.emsg.push_str(\"'*' dereferences a pointer, not \");\n");
        buf_str(out, c"                    self.val_str(v);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return Val { k: VK_REF, sk: 0, e: pv.e, ty: pv.ty, iv: 0, fv: 0.0 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k == T_AMP {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let v = self.parse_unary();\n");
        buf_str(out, c"            if v.k != VK_REF {\n");
        buf_str(out, c"                if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                    self.emsg.push_str(\"'&' takes the address of a variable (or a member or element of one), not of \");\n");
        buf_str(out, c"                    self.val_str(v);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if self.m.types[self.f.exprs[v.e].ty].kind == TK_POINTER\n");
        buf_str(out, c"                && self.f.exprs[v.e].op == ir::E_ACCESS_INDEX && self.is_vector_component(v.e) {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.type\", \"cannot take the address of a vector component\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return val(v.e, v.ty);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let p = self.parse_primary();\n");
        buf_str(out, c"        self.parse_postfix(p)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn is_vector_component(self, e: i64) -> bool {\n");
        buf_str(out, c"        let base = self.f.exprs[e].a;\n");
        buf_str(out, c"        let bt = self.m.pointee(self.f.exprs[base].ty);\n");
        buf_str(out, c"        bt >= 0 && self.m.types[bt].kind == TK_VECTOR\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn parse_postfix(inout self, v0: Val) -> Val {\n");
        buf_str(out, c"        var v = v0;\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            let k = self.kind();\n");
        buf_str(out, c"            if k == T_LBRACKET {\n");
        buf_str(out, c"                let at = self.pos();\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                let ip = self.pos();\n");
        buf_str(out, c"                let i = self.parse_expr();\n");
        buf_str(out, c"                self.expect(T_RBRACKET);\n");
        buf_str(out, c"                v = self.index(v, i, at, ip);\n");
        buf_str(out, c"            } else if k == T_DOT {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                let at = self.pos();\n");
        buf_str(out, c"                if self.kind() != T_IDENT {\n");
        buf_str(out, c"                    self.expect(T_IDENT);\n");
        buf_str(out, c"                    return v;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let name = self.text(self.p);\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                v = self.member(v, name, at);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                return v;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Primaries ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn parse_primary(inout self) -> Val {\n");
        buf_str(out, c"        let at = self.pos();\n");
        buf_str(out, c"        let k = self.kind();\n");
        buf_str(out, c"        let hint = self.hint;\n");
        buf_str(out, c"        self.hint = -1;\n");
        buf_str(out, c"        if k == T_INT {\n");
        buf_str(out, c"            return self.int_literal(self.p);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k == T_FLOAT {\n");
        buf_str(out, c"            return self.float_literal(self.p);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k == T_LPAREN {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let v = self.parse_expr_hint(hint);\n");
        buf_str(out, c"            self.expect(T_RPAREN);\n");
        buf_str(out, c"            return v;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k != T_IDENT {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.syntax\") {\n");
        buf_str(out, c"                self.emsg.push_str(\"expected an expression, got \");\n");
        buf_str(out, c"                self.emsg.push_str(lex::token_text(k));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let s = self.tk.syms[self.p];\n");
        buf_str(out, c"        if s == K_TRUE || s == K_FALSE {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            return cint(SK_BOOL, T_BOOL, if s == K_TRUE { 1 } else { 0 });\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // local names\n");
        buf_str(out, c"        let li = self.lookup_name(s);\n");
        buf_str(out, c"        if li >= 0 {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let ent = self.scopes[li];\n");
        buf_str(out, c"            if self.kind() == T_LPAREN {\n");
        buf_str(out, c"                if self.err(at, \"wgsl.call\") {\n");
        buf_str(out, c"                    self.emsg.push_fmt(f\"'{self.name_of(s)}' is a value, not a function\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return ent.v;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // module-scope names\n");
        buf_str(out, c"        if self.decl_of[s] >= 0 {\n");
        buf_str(out, c"            let d = self.decl_of[s];\n");
        buf_str(out, c"            let kind = self.decls[d].kind;\n");
        buf_str(out, c"            if kind == front::D_CONST {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                if self.decls[d].has_cv {\n");
        buf_str(out, c"                    return self.decls[d].cv;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let saved = self.p;\n");
        buf_str(out, c"                let v = self.const_value(d);\n");
        buf_str(out, c"                self.p = saved;\n");
        buf_str(out, c"                return v;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if kind == front::D_VAR {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                let g = self.decls[d].h;\n");
        buf_str(out, c"                if g < 0 {\n");
        buf_str(out, c"                    // a global used by another module-scope declaration\n");
        buf_str(out, c"                    if self.err(at, \"wgsl.name\") {\n");
        buf_str(out, c"                        self.emsg.push_fmt(\n");
        buf_str(out, c"                            f\"'{self.name_of(s)}' is a variable; a module-scope declaration cannot use it\");\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if self.fh < 0 {\n");
        buf_str(out, c"                    if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                        self.emsg.push_fmt(\n");
        buf_str(out, c"                            f\"'{self.name_of(s)}' is a variable; a constant expression cannot read it\");\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let e = self.global_expr(g);\n");
        buf_str(out, c"                let ty = self.f.exprs[e].ty;\n");
        buf_str(out, c"                if self.m.globals[g].space == ir::SP_HANDLE {\n");
        buf_str(out, c"                    return val(e, ty);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return Val { k: VK_REF, sk: 0, e: e, ty: ty, iv: 0, fv: 0.0 };\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if kind == front::D_FN {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                if self.kind() != T_LPAREN {\n");
        buf_str(out, c"                    if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                        self.emsg.push_fmt(\n");
        buf_str(out, c"                            f\"'{self.name_of(s)}' is a function: call it, '{self.name_of(s)}(...)'\");\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return self.user_call(self.decls[d].h, at);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            // a struct or alias: a constructor\n");
        buf_str(out, c"            let ty = self.parse_type();\n");
        buf_str(out, c"            return self.construct(ty, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.builtin_primary(s, at, hint)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn lookup_name(self, s: i64) -> i64 {\n");
        buf_str(out, c"        var i = self.scopes.len() - 1;\n");
        buf_str(out, c"        while i >= self.scope_floor {\n");
        buf_str(out, c"            if self.scopes[i].sym == s {\n");
        buf_str(out, c"                return i;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i -= 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        -1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Literals ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn int_literal(inout self, t: i64) -> Val {\n");
        buf_str(out, c"        let s = self.text(t);\n");
        buf_str(out, c"        let at = self.pos();\n");
        buf_str(out, c"        self.p += 1;\n");
        buf_str(out, c"        var end = s.len;\n");
        buf_str(out, c"        let last = s[end - 1];\n");
        buf_str(out, c"        var sk = SK_AINT;\n");
        buf_str(out, c"        if last == 'i' {\n");
        buf_str(out, c"            sk = SK_I32;\n");
        buf_str(out, c"            end -= 1;\n");
        buf_str(out, c"        } else if last == 'u' {\n");
        buf_str(out, c"            sk = SK_U32;\n");
        buf_str(out, c"            end -= 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var v: i64 = 0;\n");
        buf_str(out, c"        var overflow = false;\n");
        buf_str(out, c"        if end > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X') {\n");
        buf_str(out, c"            for i in 2..end {\n");
        buf_str(out, c"                let c = s[i];\n");
        buf_str(out, c"                let d = if c >= '0' && c <= '9' { c - '0' }\n");
        buf_str(out, c"                    else if c >= 'a' && c <= 'f' { c - 'a' + 10 } else { c - 'A' + 10 };\n");
        buf_str(out, c"                if v > 576460752303423487 {\n");
        buf_str(out, c"                    overflow = true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                v = v * 16 + d as i64;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            if end > 1 && s[0] == '0' {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.syntax\", \"a decimal integer does not start with 0\");\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for i in 0..end {\n");
        buf_str(out, c"                let d = (s[i] - '0') as i64;\n");
        buf_str(out, c"                if v > 922337203685477580 || (v == 922337203685477580 && d > 7) {\n");
        buf_str(out, c"                    overflow = true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                v = v * 10 + d;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if overflow {\n");
        buf_str(out, c"            self.fail(at, \"wgsl.const\", \"this integer does not fit in 64 bits\");\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if sk == SK_I32 && v > I32_MAX {\n");
        buf_str(out, c"            self.fail(at, \"wgsl.const\", \"this i32 literal is above 2147483647\");\n");
        buf_str(out, c"            self.help(\"negate a smaller literal, or use an abstract integer: -2147483648\");\n");
        buf_str(out, c"            return cint(SK_I32, T_I32, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if sk == SK_U32 && v > U32_MAX {\n");
        buf_str(out, c"            self.fail(at, \"wgsl.const\", \"this u32 literal is above 4294967295\");\n");
        buf_str(out, c"            return cint(SK_U32, T_U32, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let ty = if sk == SK_I32 { T_I32 } else if sk == SK_U32 { T_U32 } else { -1 };\n");
        buf_str(out, c"        cint(sk, ty, v)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn float_literal(inout self, t: i64) -> Val {\n");
        buf_str(out, c"        let s = self.text(t);\n");
        buf_str(out, c"        let at = self.pos();\n");
        buf_str(out, c"        self.p += 1;\n");
        buf_str(out, c"        var end = s.len;\n");
        buf_str(out, c"        var sk = SK_AFLOAT;\n");
        buf_str(out, c"        let last = s[end - 1];\n");
        buf_str(out, c"        let hex = s.len > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X');\n");
        buf_str(out, c"        if last == 'h' {\n");
        buf_str(out, c"            self.fail(at, \"wgsl.unsupported\",\n");
        buf_str(out, c"                \"'f16' literals are not in the WGSL subset of this release\");\n");
        buf_str(out, c"            return cfloat(SK_F32, T_F32, 0.0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if last == 'f' && !hex {\n");
        buf_str(out, c"            sk = SK_F32;\n");
        buf_str(out, c"            end -= 1;\n");
        buf_str(out, c"        } else if last == 'f' && hex && s.len > 2 {\n");
        buf_str(out, c"            // hex floats end in f only after an exponent\n");
        buf_str(out, c"            var has_p = false;\n");
        buf_str(out, c"            for i in 0..s.len {\n");
        buf_str(out, c"                if s[i] == 'p' || s[i] == 'P' {\n");
        buf_str(out, c"                    has_p = true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if has_p {\n");
        buf_str(out, c"                sk = SK_F32;\n");
        buf_str(out, c"                end -= 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let v = if hex { hex_float(s[0..end]) }\n");
        buf_str(out, c"            else { std::num::parse_f64(s[0..end]).unwrap_or(0.0) };\n");
        buf_str(out, c"        if sk == SK_F32 {\n");
        buf_str(out, c"            let f = v as f32;\n");
        buf_str(out, c"            if f as f64 > F32_MAX || -(f as f64) > F32_MAX {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.const\", \"this f32 literal is out of range\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return cfloat(SK_F32, T_F32, f as f64);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        cfloat(SK_AFLOAT, -1, v)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- The Load Rule and conversions ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A value: a reference is read (E_LOAD).\n");
        buf_str(out, c"    pub fn value(inout self, v: Val, at: i64) -> Val {\n");
        buf_str(out, c"        if v.k == VK_REF {\n");
        buf_str(out, c"            let t = self.m.pointee(v.ty);\n");
        buf_str(out, c"            if self.m.has_atomic(t) {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.type\", \"an atomic is read with atomicLoad\");\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if self.m.is_runtime_sized(t) {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.type\", \"a runtime-sized array cannot be read whole; index it\");\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let e = self.f.expr(E_LOAD, t, v.e, 0, 0);\n");
        buf_str(out, c"            return val(e, t);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if v.k == VK_VOID {\n");
        buf_str(out, c"            self.fail(at, \"wgsl.type\", \"this call has no result to use\");\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if v.k == VK_TYPE {\n");
        buf_str(out, c"            self.fail(at, \"wgsl.type\", \"a type is not a value\");\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The type v has once concrete (abstract ints become i32, floats f32).\n");
        buf_str(out, c"    pub fn concrete_type_of(self, v: Val) -> i64 {\n");
        buf_str(out, c"        if v.k == VK_CONST {\n");
        buf_str(out, c"            if v.ty >= 0 {\n");
        buf_str(out, c"                return v.ty;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return if v.sk == SK_AFLOAT { T_F32 } else { T_I32 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if v.k == VK_REF {\n");
        buf_str(out, c"            return self.m.pointee(v.ty);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if v.k == VK_VOID || v.e < 0 && v.ty < 0 {\n");
        buf_str(out, c"            return T_I32;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v.ty\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // v as type ty: abstract constants convert, references load; any\n");
        buf_str(out, c"    // other difference is an error.\n");
        buf_str(out, c"    pub fn convert_to(inout self, v0: Val, ty: i64, at: i64) -> Val {\n");
        buf_str(out, c"        let v = self.value(v0, at);\n");
        buf_str(out, c"        if self.failed {\n");
        buf_str(out, c"            return if v.k == VK_CONST { v } else { self.dummy(ty) };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if v.k == VK_CONST {\n");
        buf_str(out, c"            if v.ty == ty {\n");
        buf_str(out, c"                return v;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let t = self.m.types[ty];\n");
        buf_str(out, c"            if v.ty < 0 && t.kind == TK_SCALAR {\n");
        buf_str(out, c"                return self.const_cast(v, t.scalar, at, false);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.mismatch(ty, v, at);\n");
        buf_str(out, c"            return v;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if v.ty != ty {\n");
        buf_str(out, c"            self.mismatch(ty, v, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn mismatch(inout self, want: i64, got: Val, at: i64) {\n");
        buf_str(out, c"        if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"            self.emsg.push_str(\"expected \");\n");
        buf_str(out, c"            self.ty_str(want);\n");
        buf_str(out, c"            self.emsg.push_str(\", got \");\n");
        buf_str(out, c"            self.val_str(got);\n");
        buf_str(out, c"            let gt = self.concrete_type_of(got);\n");
        buf_str(out, c"            if gt >= 0 && self.m.types[gt].kind == TK_SCALAR\n");
        buf_str(out, c"                && self.m.types[want].kind == TK_SCALAR {\n");
        buf_str(out, c"                self.tmp.clear();\n");
        buf_str(out, c"                self.m.type_name(want, &self.tmp);\n");
        buf_str(out, c"                self.ehelp.push_fmt(f\"convert it: {self.tmp.as_slice()}(...)\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A dummy value of type ty, after an error.\n");
        buf_str(out, c"    pub fn dummy(inout self, ty: i64) -> Val {\n");
        buf_str(out, c"        let e = self.f.expr(E_ZERO, ty, 0, 0, 0);\n");
        buf_str(out, c"        val(e, ty)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // v as an IR expression of type ty.\n");
        buf_str(out, c"    pub fn materialize(inout self, v0: Val, ty: i64, at: i64) -> i64 {\n");
        buf_str(out, c"        let v = self.convert_to(v0, ty, at);\n");
        buf_str(out, c"        if self.failed {\n");
        buf_str(out, c"            return self.f.expr(E_ZERO, ty, 0, 0, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if v.k == VK_CONST {\n");
        buf_str(out, c"            return self.literal(v, ty);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v.e\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // v (a value of any concrete type) as an IR expression, its type\n");
        buf_str(out, c"    // concrete.\n");
        buf_str(out, c"    pub fn emit_val(inout self, v: Val, at: i64) -> i64 {\n");
        buf_str(out, c"        let t = self.concrete_type_of(v);\n");
        buf_str(out, c"        self.materialize(v, t, at)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn literal(inout self, v: Val, ty: i64) -> i64 {\n");
        buf_str(out, c"        let sk = self.m.types[ty].scalar;\n");
        buf_str(out, c"        let bits = if sk == SK_F32 { f32_bits(v.fv as f32) as i64 } else { v.iv & 4294967295 };\n");
        buf_str(out, c"        self.f.expr(E_LITERAL, ty, bits, 0, 0)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A constant as scalar kind `to`: an automatic conversion of an\n");
        buf_str(out, c"    // abstract number (`explicit` false), or a value constructor's.\n");
        buf_str(out, c"    pub fn const_cast(inout self, v: Val, to: u8, at: i64, explicit: bool) -> Val {\n");
        buf_str(out, c"        let ty = to as i64;\n");
        buf_str(out, c"        let from = v.sk;\n");
        buf_str(out, c"        if from == to {\n");
        buf_str(out, c"            return Val { k: VK_CONST, sk: to, e: -1, ty: ty, iv: v.iv, fv: v.fv };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let is_float = from == SK_F32 || from == SK_AFLOAT;\n");
        buf_str(out, c"        if !explicit {\n");
        buf_str(out, c"            let ok = (from == SK_AINT && (to == SK_I32 || to == SK_U32 || to == SK_F32))\n");
        buf_str(out, c"                || (from == SK_AFLOAT && to == SK_F32);\n");
        buf_str(out, c"            if !ok {\n");
        buf_str(out, c"                if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                    self.emsg.push_fmt(\n");
        buf_str(out, c"                        f\"expected {ir::scalar_name(to)}, got {ir::scalar_name(from)}\");\n");
        buf_str(out, c"                    if from == SK_AFLOAT && (to == SK_I32 || to == SK_U32) {\n");
        buf_str(out, c"                        self.ehelp.push_fmt(f\"convert it: {ir::scalar_name(to)}(...)\");\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return cint(to, ty, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if to == SK_BOOL {\n");
        buf_str(out, c"            let nz = if is_float { v.fv != 0.0 } else { v.iv != 0 };\n");
        buf_str(out, c"            return cint(SK_BOOL, T_BOOL, if nz { 1 } else { 0 });\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if to == SK_F32 || to == SK_AFLOAT {\n");
        buf_str(out, c"            let x = if is_float { v.fv } else { v.iv as f64 };\n");
        buf_str(out, c"            if to == SK_F32 {\n");
        buf_str(out, c"                if x > F32_MAX || x < -F32_MAX {\n");
        buf_str(out, c"                    self.fail(at, \"wgsl.const\", \"this value is out of f32's range\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return cfloat(SK_F32, T_F32, (x as f32) as f64);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return cfloat(SK_AFLOAT, -1, x);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // to an integer\n");
        buf_str(out, c"        var x = v.iv;\n");
        buf_str(out, c"        if is_float {\n");
        buf_str(out, c"            if explicit {\n");
        buf_str(out, c"                // value conversion: truncate, then saturate\n");
        buf_str(out, c"                let f = v.fv;\n");
        buf_str(out, c"                if to == SK_I32 {\n");
        buf_str(out, c"                    x = if f != f { 0 } else if f <= -2147483648.0 { I32_MIN }\n");
        buf_str(out, c"                        else if f >= 2147483520.0 { 2147483520 } else { f as i64 };\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    x = if f != f { 0 } else if f <= 0.0 { 0 }\n");
        buf_str(out, c"                        else if f >= 4294967040.0 { 4294967040 } else { f as i64 };\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return cint(to, ty, x);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if from == SK_BOOL {\n");
        buf_str(out, c"            return cint(to, ty, x);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if explicit && from != SK_AINT {\n");
        buf_str(out, c"            // between i32 and u32: the bits\n");
        buf_str(out, c"            if to == SK_U32 {\n");
        buf_str(out, c"                x = x & U32_MAX;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                x = (x & U32_MAX) as i32 as i64;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return cint(to, ty, x);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if to == SK_I32 && (x < I32_MIN || x > I32_MAX) {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.const\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"{x} does not fit in an i32\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if to == SK_U32 && (x < 0 || x > U32_MAX) {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.const\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"{x} does not fit in a u32\");\n");
        buf_str(out, c"                if x < 0 {\n");
        buf_str(out, c"                    self.help(\"a u32 is never negative; use an i32, or bitcast<u32>(...)\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        cint(to, ty, x)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Operators ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn bad_operands(inout self, op: [u8], l: Val, r: Val, at: i64) {\n");
        buf_str(out, c"        if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"            self.emsg.push_fmt(f\"'{op}' cannot take \");\n");
        buf_str(out, c"            self.val_str(l);\n");
        buf_str(out, c"            self.emsg.push_str(\" and \");\n");
        buf_str(out, c"            self.val_str(r);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unary(inout self, op: i64, v0: Val, at: i64) -> Val {\n");
        buf_str(out, c"        let v = self.value(v0, at);\n");
        buf_str(out, c"        if self.failed {\n");
        buf_str(out, c"            return v;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let t = self.concrete_type_of(v);\n");
        buf_str(out, c"        let tt = self.m.types[t];\n");
        buf_str(out, c"        let sk = if v.k == VK_CONST { v.sk } else { tt.scalar };\n");
        buf_str(out, c"        let numeric = tt.kind == TK_SCALAR || tt.kind == TK_VECTOR;\n");
        buf_str(out, c"        if op == UN_NEG {\n");
        buf_str(out, c"            if !(numeric || tt.kind == TK_MATRIX) || sk == SK_BOOL || sk == SK_U32 {\n");
        buf_str(out, c"                if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                    self.emsg.push_str(\"'-' cannot take \");\n");
        buf_str(out, c"                    self.val_str(v);\n");
        buf_str(out, c"                    if sk == SK_U32 {\n");
        buf_str(out, c"                        self.help(\"a u32 is never negative: 0u - x wraps, or use an i32\");\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return v;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if v.k == VK_CONST {\n");
        buf_str(out, c"                if sk == SK_AFLOAT || sk == SK_F32 {\n");
        buf_str(out, c"                    return cfloat(sk, v.ty, -v.fv);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if sk == SK_I32 && v.iv == I32_MIN {\n");
        buf_str(out, c"                    self.fail(at, \"wgsl.const\", \"-(-2147483648i) does not fit in an i32\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return cint(sk, v.ty, -v.iv);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if tt.kind == TK_MATRIX {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.unsupported\",\n");
        buf_str(out, c"                    \"negating a matrix is not in this release; multiply by -1.0\");\n");
        buf_str(out, c"                return v;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == UN_NOT {\n");
        buf_str(out, c"            if !numeric || sk != SK_BOOL {\n");
        buf_str(out, c"                if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                    self.emsg.push_str(\"'!' takes a bool, not \");\n");
        buf_str(out, c"                    self.val_str(v);\n");
        buf_str(out, c"                    if sk == SK_I32 || sk == SK_U32 {\n");
        buf_str(out, c"                        self.help(\"'~' is the bitwise not of an integer\");\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return v;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if v.k == VK_CONST {\n");
        buf_str(out, c"                return cint(SK_BOOL, T_BOOL, if v.iv == 0 { 1 } else { 0 });\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            if !numeric || !(sk == SK_I32 || sk == SK_U32 || sk == SK_AINT) {\n");
        buf_str(out, c"                if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                    self.emsg.push_str(\"'~' takes an integer, not \");\n");
        buf_str(out, c"                    self.val_str(v);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return v;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if v.k == VK_CONST {\n");
        buf_str(out, c"                let x = ~v.iv;\n");
        buf_str(out, c"                return cint(sk, v.ty, if sk == SK_U32 { x & U32_MAX } else { x });\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let e = self.f.expr(E_UNARY, t, op, v.e, 0);\n");
        buf_str(out, c"        val(e, t)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn op_text(self, op: i64) -> [u8] {\n");
        buf_str(out, c"        if op == OP_ADD {\n");
        buf_str(out, c"            \"+\"\n");
        buf_str(out, c"        } else if op == OP_SUB {\n");
        buf_str(out, c"            \"-\"\n");
        buf_str(out, c"        } else if op == OP_MUL {\n");
        buf_str(out, c"            \"*\"\n");
        buf_str(out, c"        } else if op == OP_DIV {\n");
        buf_str(out, c"            \"/\"\n");
        buf_str(out, c"        } else if op == OP_MOD {\n");
        buf_str(out, c"            \"%\"\n");
        buf_str(out, c"        } else if op == OP_EQ {\n");
        buf_str(out, c"            \"==\"\n");
        buf_str(out, c"        } else if op == OP_NE {\n");
        buf_str(out, c"            \"!=\"\n");
        buf_str(out, c"        } else if op == OP_LT {\n");
        buf_str(out, c"            \"<\"\n");
        buf_str(out, c"        } else if op == OP_LE {\n");
        buf_str(out, c"            \"<=\"\n");
        buf_str(out, c"        } else if op == OP_GT {\n");
        buf_str(out, c"            \">\"\n");
        buf_str(out, c"        } else if op == OP_GE {\n");
        buf_str(out, c"            \">=\"\n");
        buf_str(out, c"        } else if op == OP_AND {\n");
        buf_str(out, c"            \"&\"\n");
        buf_str(out, c"        } else if op == OP_OR {\n");
        buf_str(out, c"            \"|\"\n");
        buf_str(out, c"        } else if op == OP_XOR {\n");
        buf_str(out, c"            \"^\"\n");
        buf_str(out, c"        } else if op == OP_SHL {\n");
        buf_str(out, c"            \"<<\"\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            \">>\"\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether e is a constant (a literal, or a vector of literals) with a\n");
        buf_str(out, c"    // lane of n or more (unsigned).\n");
        buf_str(out, c"    fn const_lanes_at_least(self, e: i64, n: i64) -> bool {\n");
        buf_str(out, c"        let x = self.f.exprs[e];\n");
        buf_str(out, c"        if x.op == E_LITERAL {\n");
        buf_str(out, c"            return x.a >= n;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if x.op == E_SPLAT {\n");
        buf_str(out, c"            return self.const_lanes_at_least(x.a, n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if x.op == ir::E_COMPOSE {\n");
        buf_str(out, c"            for i in x.a..x.a + x.b {\n");
        buf_str(out, c"                if self.const_lanes_at_least(self.f.args[i], n) {\n");
        buf_str(out, c"                    return true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn binary(inout self, op: i64, l0: Val, r0: Val, at: i64) -> Val {\n");
        buf_str(out, c"        var l = self.value(l0, at);\n");
        buf_str(out, c"        var r = self.value(r0, at);\n");
        buf_str(out, c"        if self.failed {\n");
        buf_str(out, c"            return l;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if l.k == VK_CONST && r.k == VK_CONST {\n");
        buf_str(out, c"            return self.fold(op, l, r, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let shift = op == OP_SHL || op == OP_SHR;\n");
        buf_str(out, c"        // the abstract side takes the other side's scalar\n");
        buf_str(out, c"        if shift {\n");
        buf_str(out, c"            let rt0 = if r.k == VK_CONST { -1 } else { r.ty };\n");
        buf_str(out, c"            if r.k == VK_CONST {\n");
        buf_str(out, c"                if r.ty < 0 || r.sk == SK_U32 {\n");
        buf_str(out, c"                    r = self.const_cast(r, SK_U32, at, false);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if l.k == VK_CONST && l.ty < 0 {\n");
        buf_str(out, c"                let rk = self.m.types[self.concrete_type_of(r)];\n");
        buf_str(out, c"                let _ = rk;\n");
        buf_str(out, c"                l = self.const_cast(l, SK_I32, at, false);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let _ = rt0;\n");
        buf_str(out, c"        } else if l.k == VK_CONST && l.ty < 0 {\n");
        buf_str(out, c"            let rs = self.m.types[r.ty].scalar;\n");
        buf_str(out, c"            l = self.const_cast(l, rs, at, false);\n");
        buf_str(out, c"        } else if r.k == VK_CONST && r.ty < 0 {\n");
        buf_str(out, c"            let ls = self.m.types[l.ty].scalar;\n");
        buf_str(out, c"            r = self.const_cast(r, ls, at, false);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.failed {\n");
        buf_str(out, c"            return l;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let lt = self.concrete_type_of(l);\n");
        buf_str(out, c"        let rt = self.concrete_type_of(r);\n");
        buf_str(out, c"        let a = self.m.types[lt];\n");
        buf_str(out, c"        let b = self.m.types[rt];\n");
        buf_str(out, c"        let ln = if a.kind == TK_SCALAR { 1 } else if a.kind == TK_VECTOR { a.n } else { 0 };\n");
        buf_str(out, c"        let rn = if b.kind == TK_SCALAR { 1 } else if b.kind == TK_VECTOR { b.n } else { 0 };\n");
        buf_str(out, c"        // matrices\n");
        buf_str(out, c"        if a.kind == TK_MATRIX || b.kind == TK_MATRIX {\n");
        buf_str(out, c"            return self.matrix_op(op, l, r, lt, rt, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if ln == 0 || rn == 0 {\n");
        buf_str(out, c"            self.bad_operands(self.op_text(op), l, r, at);\n");
        buf_str(out, c"            return l;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let sk = a.scalar;\n");
        buf_str(out, c"        if shift {\n");
        buf_str(out, c"            if (sk != SK_I32 && sk != SK_U32) || b.scalar != SK_U32 || (ln != rn && rn != 1)\n");
        buf_str(out, c"                || (rn != 1 && ln == 1) {\n");
        buf_str(out, c"                if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                    self.emsg.push_fmt(\n");
        buf_str(out, c"                        f\"'{self.op_text(op)}' shifts an integer by a u32 (of the same width); got \");\n");
        buf_str(out, c"                    self.val_str(l);\n");
        buf_str(out, c"                    self.emsg.push_str(\" and \");\n");
        buf_str(out, c"                    self.val_str(r);\n");
        buf_str(out, c"                    if b.scalar == SK_I32 {\n");
        buf_str(out, c"                        self.help(\"convert the amount: u32(...)\");\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return l;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let le = self.materialize(l, lt, at);\n");
        buf_str(out, c"            var re = self.materialize(r, rt, at);\n");
        buf_str(out, c"            if ln != rn {\n");
        buf_str(out, c"                re = self.f.expr(E_SPLAT, vec_ty(SK_U32, ln), re, 0, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if (r.k == VK_CONST && r.iv >= 32) || self.const_lanes_at_least(re, 32) {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.const\", \"a constant shift amount is below 32\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let e = self.f.expr(E_BINARY, lt, op, le, re);\n");
        buf_str(out, c"            return val(e, lt);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if sk != b.scalar {\n");
        buf_str(out, c"            self.bad_operands(self.op_text(op), l, r, at);\n");
        buf_str(out, c"            if (sk == SK_I32 && b.scalar == SK_U32) || (sk == SK_U32 && b.scalar == SK_I32) {\n");
        buf_str(out, c"                self.help(\"convert one side: u32(...) or i32(...)\");\n");
        buf_str(out, c"            } else if sk == SK_F32 || b.scalar == SK_F32 {\n");
        buf_str(out, c"                self.help(\"convert one side: f32(...)\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return l;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let arith = op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_DIV || op == OP_MOD;\n");
        buf_str(out, c"        let cmp = op >= OP_EQ && op <= OP_GE;\n");
        buf_str(out, c"        let bits = op == OP_AND || op == OP_OR || op == OP_XOR;\n");
        buf_str(out, c"        if ln != rn && !(arith && (ln == 1 || rn == 1)) {\n");
        buf_str(out, c"            self.bad_operands(self.op_text(op), l, r, at);\n");
        buf_str(out, c"            return l;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if arith && sk == SK_BOOL {\n");
        buf_str(out, c"            self.bad_operands(self.op_text(op), l, r, at);\n");
        buf_str(out, c"            return l;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if bits && sk == SK_F32 {\n");
        buf_str(out, c"            self.bad_operands(self.op_text(op), l, r, at);\n");
        buf_str(out, c"            return l;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if cmp && sk == SK_BOOL && op != OP_EQ && op != OP_NE {\n");
        buf_str(out, c"            self.bad_operands(self.op_text(op), l, r, at);\n");
        buf_str(out, c"            return l;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let n = if ln > rn { ln } else { rn };\n");
        buf_str(out, c"        let vt = vec_ty(sk, n);\n");
        buf_str(out, c"        var le = self.materialize(l, lt, at);\n");
        buf_str(out, c"        var re = self.materialize(r, rt, at);\n");
        buf_str(out, c"        if ln < n {\n");
        buf_str(out, c"            le = self.f.expr(E_SPLAT, vt, le, 0, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if rn < n {\n");
        buf_str(out, c"            re = self.f.expr(E_SPLAT, vt, re, 0, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let ty = if cmp { vec_ty(SK_BOOL, n) } else { vt };\n");
        buf_str(out, c"        let e = self.f.expr(E_BINARY, ty, op, le, re);\n");
        buf_str(out, c"        val(e, ty)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn matrix_op(inout self, op: i64, l: Val, r: Val, lt: i64, rt: i64, at: i64) -> Val {\n");
        buf_str(out, c"        let a = self.m.types[lt];\n");
        buf_str(out, c"        let b = self.m.types[rt];\n");
        buf_str(out, c"        var ty = -1;\n");
        buf_str(out, c"        if op == OP_ADD || op == OP_SUB {\n");
        buf_str(out, c"            if lt == rt {\n");
        buf_str(out, c"                ty = lt;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == OP_MUL {\n");
        buf_str(out, c"            if a.kind == TK_MATRIX && b.kind == TK_SCALAR && b.scalar == SK_F32 {\n");
        buf_str(out, c"                ty = lt;\n");
        buf_str(out, c"            } else if a.kind == TK_SCALAR && a.scalar == SK_F32 && b.kind == TK_MATRIX {\n");
        buf_str(out, c"                ty = rt;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            else if a.kind == TK_MATRIX && b.kind == TK_VECTOR && b.scalar == SK_F32 && b.n == a.n {\n");
        buf_str(out, c"                ty = vec_ty(SK_F32, a.m);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            else if a.kind == TK_VECTOR && a.scalar == SK_F32 && b.kind == TK_MATRIX && a.n == b.m {\n");
        buf_str(out, c"                ty = vec_ty(SK_F32, b.n);\n");
        buf_str(out, c"            } else if a.kind == TK_MATRIX && b.kind == TK_MATRIX && a.n == b.m {\n");
        buf_str(out, c"                ty = mat_ty(b.n, a.m);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if ty < 0 {\n");
        buf_str(out, c"            self.bad_operands(self.op_text(op), l, r, at);\n");
        buf_str(out, c"            return l;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let le = self.materialize(l, lt, at);\n");
        buf_str(out, c"        let re = self.materialize(r, rt, at);\n");
        buf_str(out, c"        let e = self.f.expr(E_BINARY, ty, op, le, re);\n");
        buf_str(out, c"        val(e, ty)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Both sides constant scalars: the result, computed as WGSL's\n");
        buf_str(out, c"    // constant evaluation does (errors where it overflows or divides by\n");
        buf_str(out, c"    // zero).\n");
        buf_str(out, c"    fn fold(inout self, op: i64, l0: Val, r0: Val, at: i64) -> Val {\n");
        buf_str(out, c"        var l = l0;\n");
        buf_str(out, c"        var r = r0;\n");
        buf_str(out, c"        let shift = op == OP_SHL || op == OP_SHR;\n");
        buf_str(out, c"        // the common kind\n");
        buf_str(out, c"        if shift {\n");
        buf_str(out, c"            if r.sk == SK_AINT {\n");
        buf_str(out, c"                r = self.const_cast(r, SK_U32, at, false);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if r.sk != SK_U32 {\n");
        buf_str(out, c"                self.bad_operands(self.op_text(op), l, r, at);\n");
        buf_str(out, c"                return l;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if l.sk != r.sk {\n");
        buf_str(out, c"            if l.ty < 0 && r.ty < 0 {\n");
        buf_str(out, c"                // abstract int and abstract float: float\n");
        buf_str(out, c"                if l.sk == SK_AINT {\n");
        buf_str(out, c"                    l = cfloat(SK_AFLOAT, -1, l.iv as f64);\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    r = cfloat(SK_AFLOAT, -1, r.iv as f64);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else if l.ty < 0 {\n");
        buf_str(out, c"                l = self.const_cast(l, r.sk, at, false);\n");
        buf_str(out, c"            } else if r.ty < 0 {\n");
        buf_str(out, c"                r = self.const_cast(r, l.sk, at, false);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.bad_operands(self.op_text(op), l, r, at);\n");
        buf_str(out, c"                return l;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.failed {\n");
        buf_str(out, c"            return l;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let sk = l.sk;\n");
        buf_str(out, c"        let ty = l.ty;\n");
        buf_str(out, c"        if op == OP_LAND || op == OP_LOR {\n");
        buf_str(out, c"            let x = if op == OP_LAND { l.iv != 0 && r.iv != 0 } else { l.iv != 0 || r.iv != 0 };\n");
        buf_str(out, c"            return cint(SK_BOOL, T_BOOL, if x { 1 } else { 0 });\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op >= OP_EQ && op <= OP_GE {\n");
        buf_str(out, c"            var c = 0;\n");
        buf_str(out, c"            if sk == SK_F32 || sk == SK_AFLOAT {\n");
        buf_str(out, c"                let x = l.fv;\n");
        buf_str(out, c"                let y = r.fv;\n");
        buf_str(out, c"                c = if op == OP_EQ { (x == y) as i64 } else if op == OP_NE { (x != y) as i64 }\n");
        buf_str(out, c"                    else if op == OP_LT { (x < y) as i64 } else if op == OP_LE { (x <= y) as i64 }\n");
        buf_str(out, c"                    else if op == OP_GT { (x > y) as i64 } else { (x >= y) as i64 };\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                if sk == SK_BOOL && op != OP_EQ && op != OP_NE {\n");
        buf_str(out, c"                    self.bad_operands(self.op_text(op), l, r, at);\n");
        buf_str(out, c"                    return l;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let x = l.iv;\n");
        buf_str(out, c"                let y = r.iv;\n");
        buf_str(out, c"                c = if op == OP_EQ { (x == y) as i64 } else if op == OP_NE { (x != y) as i64 }\n");
        buf_str(out, c"                    else if op == OP_LT { (x < y) as i64 } else if op == OP_LE { (x <= y) as i64 }\n");
        buf_str(out, c"                    else if op == OP_GT { (x > y) as i64 } else { (x >= y) as i64 };\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return cint(SK_BOOL, T_BOOL, c);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if sk == SK_BOOL {\n");
        buf_str(out, c"            if op == OP_AND || op == OP_OR || op == OP_XOR {\n");
        buf_str(out, c"                let x = if op == OP_AND { l.iv & r.iv } else if op == OP_OR { l.iv | r.iv }\n");
        buf_str(out, c"                    else { l.iv ^ r.iv };\n");
        buf_str(out, c"                return cint(SK_BOOL, T_BOOL, x);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.bad_operands(self.op_text(op), l, r, at);\n");
        buf_str(out, c"            return l;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if sk == SK_F32 || sk == SK_AFLOAT {\n");
        buf_str(out, c"            if op == OP_AND || op == OP_OR || op == OP_XOR || shift {\n");
        buf_str(out, c"                self.bad_operands(self.op_text(op), l, r, at);\n");
        buf_str(out, c"                return l;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let x = l.fv;\n");
        buf_str(out, c"            let y = r.fv;\n");
        buf_str(out, c"            var z = 0.0;\n");
        buf_str(out, c"            if sk == SK_F32 {\n");
        buf_str(out, c"                let a = x as f32;\n");
        buf_str(out, c"                let b = y as f32;\n");
        buf_str(out, c"                let zz = if op == OP_ADD { a + b } else if op == OP_SUB { a - b }\n");
        buf_str(out, c"                    else if op == OP_MUL { a * b } else if op == OP_DIV { a / b }\n");
        buf_str(out, c"                    else { a - b * trunc32(a / b) };\n");
        buf_str(out, c"                z = zz as f64;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                z = if op == OP_ADD { x + y } else if op == OP_SUB { x - y }\n");
        buf_str(out, c"                    else if op == OP_MUL { x * y } else if op == OP_DIV { x / y }\n");
        buf_str(out, c"                    else { x - y * trunc64(x / y) };\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if z != z || z > 1.7976931348623157e308 || z < -1.7976931348623157e308\n");
        buf_str(out, c"                || (sk == SK_F32 && (z > F32_MAX || z < -F32_MAX)) {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.const\",\n");
        buf_str(out, c"                    \"this constant expression overflows or is not a number\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return cfloat(sk, ty, z);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // integers: i32, u32, abstract (i64)\n");
        buf_str(out, c"        let x = l.iv;\n");
        buf_str(out, c"        let y = r.iv;\n");
        buf_str(out, c"        var z: i64 = 0;\n");
        buf_str(out, c"        if op == OP_ADD {\n");
        buf_str(out, c"            z = x + y;\n");
        buf_str(out, c"            if sk == SK_AINT && ((x > 0 && y > 0 && z < 0) || (x < 0 && y < 0 && z >= 0)) {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.const\", \"this constant overflows 64 bits\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == OP_SUB {\n");
        buf_str(out, c"            z = x - y;\n");
        buf_str(out, c"            if sk == SK_AINT && ((x >= 0 && y < 0 && z < 0) || (x < 0 && y > 0 && z >= 0)) {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.const\", \"this constant overflows 64 bits\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == OP_MUL {\n");
        buf_str(out, c"            z = x * y;\n");
        buf_str(out, c"            if sk == SK_AINT && x != 0\n");
        buf_str(out, c"                && (z / x != y || (x == -1 && y == -9223372036854775807 - 1)) {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.const\", \"this constant overflows 64 bits\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == OP_DIV || op == OP_MOD {\n");
        buf_str(out, c"            if y == 0 {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.const\", \"a constant expression divides by zero\");\n");
        buf_str(out, c"                return l;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            z = if op == OP_DIV { x / y } else { x % y };\n");
        buf_str(out, c"        } else if op == OP_AND {\n");
        buf_str(out, c"            z = x & y;\n");
        buf_str(out, c"        } else if op == OP_OR {\n");
        buf_str(out, c"            z = x | y;\n");
        buf_str(out, c"        } else if op == OP_XOR {\n");
        buf_str(out, c"            z = x ^ y;\n");
        buf_str(out, c"        } else if op == OP_SHL || op == OP_SHR {\n");
        buf_str(out, c"            let width = if sk == SK_AINT { 64 } else { 32 };\n");
        buf_str(out, c"            if y >= width {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.const\",\n");
        buf_str(out, c"                    \"a constant shift amount is below the width of the shifted type\");\n");
        buf_str(out, c"                return l;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if op == OP_SHL {\n");
        buf_str(out, c"                z = x << y;\n");
        buf_str(out, c"            } else if sk == SK_U32 {\n");
        buf_str(out, c"                z = (x & U32_MAX) >> y;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                z = x >> y;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if sk == SK_I32 {\n");
        buf_str(out, c"            if op == OP_SHL {\n");
        buf_str(out, c"                z = (z & U32_MAX) as i32 as i64;\n");
        buf_str(out, c"            } else if z < I32_MIN || z > I32_MAX {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.const\", \"this constant expression overflows an i32\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if sk == SK_U32 {\n");
        buf_str(out, c"            if op == OP_SHL {\n");
        buf_str(out, c"                z = z & U32_MAX;\n");
        buf_str(out, c"            } else if z < 0 || z > U32_MAX {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.const\", \"this constant expression overflows a u32\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        cint(sk, ty, z)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Indexing and members ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn index(inout self, base: Val, i0: Val, at: i64, ip: i64) -> Val {\n");
        buf_str(out, c"        if self.failed {\n");
        buf_str(out, c"            return base;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let i = self.value(i0, ip);\n");
        buf_str(out, c"        let it = self.concrete_type_of(i);\n");
        buf_str(out, c"        if it != T_I32 && it != T_U32 {\n");
        buf_str(out, c"            if self.err(ip, \"wgsl.type\") {\n");
        buf_str(out, c"                self.emsg.push_str(\"an index is an i32 or a u32, not \");\n");
        buf_str(out, c"                self.val_str(i);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return base;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let is_ref = base.k == VK_REF;\n");
        buf_str(out, c"        let bv = if is_ref { base } else { self.value(base, at) };\n");
        buf_str(out, c"        if bv.k == VK_CONST {\n");
        buf_str(out, c"            self.fail(at, \"wgsl.type\", \"a scalar cannot be indexed\");\n");
        buf_str(out, c"            return base;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let bt = if is_ref { self.m.pointee(bv.ty) } else { bv.ty };\n");
        buf_str(out, c"        let t = self.m.types[bt];\n");
        buf_str(out, c"        if t.kind != TK_ARRAY && t.kind != TK_VECTOR && t.kind != TK_MATRIX {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                self.emsg.push_str(\"cannot index \");\n");
        buf_str(out, c"                self.val_str(bv);\n");
        buf_str(out, c"                if t.kind == TK_POINTER {\n");
        buf_str(out, c"                    self.help(\"dereference the pointer first: (*p)[i]\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return base;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let el = self.m.elem_of(bt);\n");
        buf_str(out, c"        let n = self.m.index_len(bt);\n");
        buf_str(out, c"        let rty = if is_ref {\n");
        buf_str(out, c"            let pt = self.m.types[bv.ty];\n");
        buf_str(out, c"            self.m.ptr_ty(el, pt.space, pt.access)\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            el\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        if i.k == VK_CONST && n > 0 {\n");
        buf_str(out, c"            if i.iv < 0 || i.iv >= n {\n");
        buf_str(out, c"                if self.err(ip, \"wgsl.index\") {\n");
        buf_str(out, c"                    self.emsg.push_fmt(f\"index {i.iv} is out of range: the length is {n}\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return base;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let e = self.f.expr(E_ACCESS_INDEX, rty, bv.e, i.iv, 0);\n");
        buf_str(out, c"            return Val {\n");
        buf_str(out, c"                k: if is_ref { VK_REF } else { VK_VALUE }, sk: 0, e: e, ty: rty, iv: 0, fv: 0.0\n");
        buf_str(out, c"            };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let ie = self.materialize(i, it, ip);\n");
        buf_str(out, c"        let e = self.f.expr(E_ACCESS, rty, bv.e, ie, ir::CK_PENDING);\n");
        buf_str(out, c"        Val { k: if is_ref { VK_REF } else { VK_VALUE }, sk: 0, e: e, ty: rty, iv: 0, fv: 0.0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn member(inout self, base: Val, name: [u8], at: i64) -> Val {\n");
        buf_str(out, c"        if self.failed {\n");
        buf_str(out, c"            return base;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let is_ref = base.k == VK_REF;\n");
        buf_str(out, c"        let bv = if is_ref { base } else { self.value(base, at) };\n");
        buf_str(out, c"        if bv.k == VK_CONST {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"a scalar has no member '{name}'\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return base;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let bt = if is_ref { self.m.pointee(bv.ty) } else { bv.ty };\n");
        buf_str(out, c"        let t = self.m.types[bt];\n");
        buf_str(out, c"        if t.kind == TK_STRUCT {\n");
        buf_str(out, c"            for i in 0..t.mcount {\n");
        buf_str(out, c"                let mem = self.m.members[t.mstart + i];\n");
        buf_str(out, c"                if mem.name == name {\n");
        buf_str(out, c"                    let rty = if is_ref {\n");
        buf_str(out, c"                        let pt = self.m.types[bv.ty];\n");
        buf_str(out, c"                        self.m.ptr_ty(mem.ty, pt.space, pt.access)\n");
        buf_str(out, c"                    } else {\n");
        buf_str(out, c"                        mem.ty\n");
        buf_str(out, c"                    };\n");
        buf_str(out, c"                    let e = self.f.expr(E_ACCESS_INDEX, rty, bv.e, i, 0);\n");
        buf_str(out, c"                    return Val {\n");
        buf_str(out, c"                        k: if is_ref { VK_REF } else { VK_VALUE }, sk: 0, e: e, ty: rty, iv: 0,\n");
        buf_str(out, c"                        fv: 0.0\n");
        buf_str(out, c"                    };\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if self.err(at, \"wgsl.member\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"'{t.name}' has no member '{name}'\");\n");
        buf_str(out, c"                self.ehelp.push_str(\"its members are \");\n");
        buf_str(out, c"                for i in 0..t.mcount {\n");
        buf_str(out, c"                    if i > 0 {\n");
        buf_str(out, c"                        self.ehelp.push_str(\", \");\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    self.ehelp.push_str(self.m.members[t.mstart + i].name);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return base;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if t.kind == TK_VECTOR {\n");
        buf_str(out, c"            var pat = 0;\n");
        buf_str(out, c"            let n = name.len;\n");
        buf_str(out, c"            var set = -1;\n");
        buf_str(out, c"            if n > 4 {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.member\", \"a swizzle has at most 4 components\");\n");
        buf_str(out, c"                return base;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for i in 0..n {\n");
        buf_str(out, c"                let c = name[i];\n");
        buf_str(out, c"                let (comp, s) = if c == 'x' {\n");
        buf_str(out, c"                    (0, 0)\n");
        buf_str(out, c"                } else if c == 'y' {\n");
        buf_str(out, c"                    (1, 0)\n");
        buf_str(out, c"                } else if c == 'z' {\n");
        buf_str(out, c"                    (2, 0)\n");
        buf_str(out, c"                } else if c == 'w' {\n");
        buf_str(out, c"                    (3, 0)\n");
        buf_str(out, c"                } else if c == 'r' {\n");
        buf_str(out, c"                    (0, 1)\n");
        buf_str(out, c"                } else if c == 'g' {\n");
        buf_str(out, c"                    (1, 1)\n");
        buf_str(out, c"                } else if c == 'b' {\n");
        buf_str(out, c"                    (2, 1)\n");
        buf_str(out, c"                } else if c == 'a' {\n");
        buf_str(out, c"                    (3, 1)\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    (-1, -1)\n");
        buf_str(out, c"                };\n");
        buf_str(out, c"                if comp < 0 || comp >= t.n || (set >= 0 && s != set) {\n");
        buf_str(out, c"                    if self.err(at, \"wgsl.member\") {\n");
        buf_str(out, c"                        self.emsg.push_fmt(f\"'.{name}' is not a component of a vec{t.n}\");\n");
        buf_str(out, c"                        self.help(\"components are x y z w (or r g b a), not mixed\");\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    return base;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                set = s;\n");
        buf_str(out, c"                pat = pat | (comp << (2 * i));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if n == 1 {\n");
        buf_str(out, c"                let rty = if is_ref {\n");
        buf_str(out, c"                    let pt = self.m.types[bv.ty];\n");
        buf_str(out, c"                    self.m.ptr_ty(t.scalar as i64, pt.space, pt.access)\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    t.scalar as i64\n");
        buf_str(out, c"                };\n");
        buf_str(out, c"                let e = self.f.expr(E_ACCESS_INDEX, rty, bv.e, pat, 0);\n");
        buf_str(out, c"                return Val {\n");
        buf_str(out, c"                    k: if is_ref { VK_REF } else { VK_VALUE }, sk: 0, e: e, ty: rty, iv: 0, fv: 0.0\n");
        buf_str(out, c"                };\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let v = self.value(bv, at);\n");
        buf_str(out, c"            let rty = vec_ty(t.scalar, n);\n");
        buf_str(out, c"            let e = self.f.expr(E_SWIZZLE, rty, v.e, pat, n);\n");
        buf_str(out, c"            return val(e, rty);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.err(at, \"wgsl.member\") {\n");
        buf_str(out, c"            self.emsg.push_fmt(f\"'.{name}': \");\n");
        buf_str(out, c"            self.val_str(bv);\n");
        buf_str(out, c"            self.emsg.push_str(\" has no members\");\n");
        buf_str(out, c"            if t.kind == TK_POINTER {\n");
        buf_str(out, c"                self.help(\"dereference the pointer first: (*p).member\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        base\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn trunc32(x: f32) -> f32 {\n");
        buf_str(out, c"    if x != x || x > 8388608.0 || x < -8388608.0 {\n");
        buf_str(out, c"        return x;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    (x as i64) as f32\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn trunc64(x: f64) -> f64 {\n");
        buf_str(out, c"    if x != x || x > 4503599627370496.0 || x < -4503599627370496.0 {\n");
        buf_str(out, c"        return x;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    (x as i64) as f64\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A hexadecimal float literal's value, `0x1.8p3` (WGSL's: mantissa digits,\n");
        buf_str(out, c"// an optional point, `p` and a decimal exponent of two), exact while the\n");
        buf_str(out, c"// mantissa fits in 53 bits.\n");
        buf_str(out, c"fn hex_float(s: [u8]) -> f64 {\n");
        buf_str(out, c"    var man: f64 = 0.0;\n");
        buf_str(out, c"    var e: i64 = 0;\n");
        buf_str(out, c"    var i = 2;\n");
        buf_str(out, c"    var after_point = false;\n");
        buf_str(out, c"    while i < s.len && s[i] != 'p' && s[i] != 'P' {\n");
        buf_str(out, c"        let c = s[i];\n");
        buf_str(out, c"        if c == '.' {\n");
        buf_str(out, c"            after_point = true;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            let d = if c >= '0' && c <= '9' { c - '0' }\n");
        buf_str(out, c"                else if c >= 'a' && c <= 'f' { c - 'a' + 10 } else { c - 'A' + 10 };\n");
        buf_str(out, c"            man = man * 16.0 + d as f64;\n");
        buf_str(out, c"            if after_point {\n");
        buf_str(out, c"                e -= 4;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if i < s.len {\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"        var neg = false;\n");
        buf_str(out, c"        if i < s.len && (s[i] == '+' || s[i] == '-') {\n");
        buf_str(out, c"            neg = s[i] == '-';\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var x: i64 = 0;\n");
        buf_str(out, c"        while i < s.len && s[i] >= '0' && s[i] <= '9' && x < 100000 {\n");
        buf_str(out, c"            x = x * 10 + (s[i] - '0') as i64;\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        e += if neg { -x } else { x };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // times 2^e, by exact steps\n");
        buf_str(out, c"    var v = man;\n");
        buf_str(out, c"    while e > 0 && v < 1.0e300 {\n");
        buf_str(out, c"        v = v * 2.0;\n");
        buf_str(out, c"        e -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    while e < 0 && v != 0.0 {\n");
        buf_str(out, c"        v = v * 0.5;\n");
        buf_str(out, c"        e += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl::expr ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::gpu::wgsl::builtins ----\n");
        buf_str(out, c"pub mod builtins {\n");
        buf_str(out, c"// ---- Shader compiler implementation, builtins (0.22) ----\n");
        buf_str(out, c"// Calls: user functions, value constructors (`vec3<f32>(...)`, `S(...)`,\n");
        buf_str(out, c"// inferred `vec3(...)` and `array(...)`), and WGSL's builtin functions\n");
        buf_str(out, c"// with their overloads.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use front::{Front, VK_CONST, VK_REF, VK_VALUE, VK_VOID, Val, cint, val};\n");
        buf_str(out, c"use ir::{\n");
        buf_str(out, c"    ACC_RW, AT_ADD, AT_AND, AT_CMPXCHG, AT_EXCHANGE, AT_LOAD, AT_MAX, AT_MIN, AT_OR, AT_STORE,\n");
        buf_str(out, c"    AT_SUB, AT_XOR, BARRIER_STORAGE, BARRIER_WORKGROUP, E_ARRAY_LENGTH, E_ATOMIC_RESULT, E_BITCAST,\n");
        buf_str(out, c"    E_COMPOSE, E_CONVERT, E_DERIVATIVE, E_GLOBAL, E_IMAGE_LOAD, E_IMAGE_QUERY, E_IMAGE_SAMPLE,\n");
        buf_str(out, c"    E_MATH, E_SELECT, E_SPLAT, E_WG_UNIFORM_RESULT, E_ZERO, IMG_SAMPLE, IMG_SAMPLE_BIAS,\n");
        buf_str(out, c"    IMG_SAMPLE_COMPARE, IMG_SAMPLE_COMPARE_LEVEL, IMG_SAMPLE_LEVEL, IQ_LAYERS, IQ_LEVELS, IQ_SIZE,\n");
        buf_str(out, c"    MF_ALL, MF_ANY, MF_CROSS, MF_DETERMINANT, MF_DISTANCE, MF_DOT, MF_EXTRACT_BITS, MF_INSERT_BITS,\n");
        buf_str(out, c"    MF_LDEXP, MF_LENGTH, MF_TRANSPOSE, SK_AFLOAT, SK_AINT, SK_BOOL, SK_F32, SK_I32, SK_U32,\n");
        buf_str(out, c"    SP_HANDLE, SP_STORAGE, SP_WORKGROUP, STAGE_COMPUTE, STAGE_FRAGMENT, S_ATOMIC, S_BARRIER,\n");
        buf_str(out, c"    S_IMAGE_STORE, S_WG_UNIFORM_LOAD, StructMember, TEX_2D_ARRAY, TEX_DEPTH_2D, TEX_STORAGE_2D,\n");
        buf_str(out, c"    TK_ARRAY, TK_ATOMIC, TK_MATRIX, TK_POINTER, TK_SAMPLER, TK_SCALAR, TK_STRUCT, TK_TEXTURE,\n");
        buf_str(out, c"    TK_VECTOR, T_BOOL, T_F32, T_I32, T_U32, mat_ty, vec_ty,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"use lex::{T_COMMA, T_EOF, T_LPAREN, T_LT, T_RPAREN};\n");
        buf_str(out, c"use names::{\n");
        buf_str(out, c"    K_ARRAY, K_ARRAY_LENGTH, K_ATOMIC_ADD, K_ATOMIC_AND, K_ATOMIC_COMPARE_EXCHANGE_WEAK,\n");
        buf_str(out, c"    K_ATOMIC_EXCHANGE, K_ATOMIC_LOAD, K_ATOMIC_MAX, K_ATOMIC_MIN, K_ATOMIC_OR, K_ATOMIC_STORE,\n");
        buf_str(out, c"    K_ATOMIC_SUB, K_ATOMIC_XOR, K_BITCAST, K_DPDX, K_FWIDTH_FINE, K_MAT2X2, K_MAT4X4, K_MATH_FIRST,\n");
        buf_str(out, c"    K_MATH_LAST, K_SELECT, K_STORAGE_BARRIER, K_TEXTURE_DIMENSIONS, K_TEXTURE_LOAD,\n");
        buf_str(out, c"    K_TEXTURE_NUM_LAYERS, K_TEXTURE_NUM_LEVELS, K_TEXTURE_SAMPLE, K_TEXTURE_SAMPLE_BIAS,\n");
        buf_str(out, c"    K_TEXTURE_SAMPLE_COMPARE, K_TEXTURE_SAMPLE_COMPARE_LEVEL, K_TEXTURE_SAMPLE_LEVEL,\n");
        buf_str(out, c"    K_TEXTURE_STORE, K_VEC2, K_VEC4, K_WORKGROUP_BARRIER, K_WORKGROUP_UNIFORM_LOAD,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Front {\n");
        buf_str(out, c"    // The arguments of a call, from its `(`: pushed on astack (positions\n");
        buf_str(out, c"    // on apos); returns their first index. `hint`: each argument's\n");
        buf_str(out, c"    // expected type, or -1.\n");
        buf_str(out, c"    fn args(inout self, hint: i64) -> i64 {\n");
        buf_str(out, c"        let base = self.astack.len();\n");
        buf_str(out, c"        self.expect(T_LPAREN);\n");
        buf_str(out, c"        while self.kind() != T_RPAREN && self.kind() != T_EOF {\n");
        buf_str(out, c"            let p = self.pos();\n");
        buf_str(out, c"            let v = self.parse_expr_hint(hint);\n");
        buf_str(out, c"            self.apos.push(p);\n");
        buf_str(out, c"            self.astack.push(v);\n");
        buf_str(out, c"            if !self.eat(T_COMMA) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.expect(T_RPAREN);\n");
        buf_str(out, c"        self.last_call_end = self.p;\n");
        buf_str(out, c"        base\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn drop_args(inout self, base: i64) {\n");
        buf_str(out, c"        self.astack.truncate(base);\n");
        buf_str(out, c"        self.apos.truncate(base);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn arg_count_error(inout self, at: i64, name: [u8], want: [u8], got: i64) {\n");
        buf_str(out, c"        if self.err(at, \"wgsl.call\") {\n");
        buf_str(out, c"            self.emsg.push_fmt(f\"'{name}' takes {want}, got {got}\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- User functions ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn user_call(inout self, fh: i64, at: i64) -> Val {\n");
        buf_str(out, c"        // the function being lowered has its signature in self.f\n");
        buf_str(out, c"        let nparams = if fh == self.fh { self.f.params.len() }\n");
        buf_str(out, c"            else { self.m.functions[fh].params.len() };\n");
        buf_str(out, c"        let base = self.estack.len();\n");
        buf_str(out, c"        self.expect(T_LPAREN);\n");
        buf_str(out, c"        var n = 0;\n");
        buf_str(out, c"        while self.kind() != T_RPAREN && self.kind() != T_EOF {\n");
        buf_str(out, c"            let ap = self.pos();\n");
        buf_str(out, c"            let hint = if n < nparams { self.param_ty(fh, n) } else { -1 };\n");
        buf_str(out, c"            let v = self.parse_expr_hint(hint);\n");
        buf_str(out, c"            if n < nparams {\n");
        buf_str(out, c"                let pt = self.param_ty(fh, n);\n");
        buf_str(out, c"                var ok = true;\n");
        buf_str(out, c"                if self.m.types[pt].kind == TK_POINTER && v.k == VK_REF {\n");
        buf_str(out, c"                    ok = false;\n");
        buf_str(out, c"                    if self.err(ap, \"wgsl.type\") {\n");
        buf_str(out, c"                        self.emsg.push_str(\"expected a pointer, got a reference\");\n");
        buf_str(out, c"                        self.help(\"pass its address: &x\");\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if ok {\n");
        buf_str(out, c"                    let e = self.materialize(v, pt, ap);\n");
        buf_str(out, c"                    self.estack.push(e);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            n += 1;\n");
        buf_str(out, c"            if !self.eat(T_COMMA) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.expect(T_RPAREN);\n");
        buf_str(out, c"        if n != nparams {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.call\") {\n");
        buf_str(out, c"                self.emsg.push('\\'');\n");
        buf_str(out, c"                if fh == self.fh {\n");
        buf_str(out, c"                    self.emsg.push_str(self.f.name);\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    self.emsg.push_str(self.m.functions[fh].name);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"' takes {nparams} argument\");\n");
        buf_str(out, c"                if nparams != 1 {\n");
        buf_str(out, c"                    self.emsg.push('s');\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.emsg.push_fmt(f\", got {n}\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.estack.truncate(base);\n");
        buf_str(out, c"            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let start = self.f.args.len();\n");
        buf_str(out, c"        for i in base..self.estack.len() {\n");
        buf_str(out, c"            self.f.args.push(self.estack[i]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.estack.truncate(base);\n");
        buf_str(out, c"        let r = self.call_stmt(fh, start, n);\n");
        buf_str(out, c"        self.last_call_end = self.p;\n");
        buf_str(out, c"        r\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn param_ty(self, fh: i64, i: i64) -> i64 {\n");
        buf_str(out, c"        if fh == self.fh {\n");
        buf_str(out, c"            self.f.params[i].ty\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.m.functions[fh].params[i].ty\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Constructors ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // `T(args)` for a known type T, from the `(`.\n");
        buf_str(out, c"    pub fn construct(inout self, ty: i64, at: i64) -> Val {\n");
        buf_str(out, c"        if self.kind() != T_LPAREN {\n");
        buf_str(out, c"            if self.err(self.pos(), \"wgsl.syntax\") {\n");
        buf_str(out, c"                self.emsg.push_str(\"a type here is a constructor: '\");\n");
        buf_str(out, c"                self.ty_str(ty);\n");
        buf_str(out, c"                self.emsg.push_str(\"(...)'\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let t = self.m.types[ty];\n");
        buf_str(out, c"        let hint = if t.kind == TK_VECTOR || t.kind == TK_MATRIX {\n");
        buf_str(out, c"            t.scalar as i64\n");
        buf_str(out, c"        } else if t.kind == TK_ARRAY {\n");
        buf_str(out, c"            t.base\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            -1\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        let base = self.args(hint);\n");
        buf_str(out, c"        let n = self.astack.len() - base;\n");
        buf_str(out, c"        let r = self.construct_from(ty, base, n, at);\n");
        buf_str(out, c"        self.drop_args(base);\n");
        buf_str(out, c"        r\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn construct_from(inout self, ty: i64, base: i64, n: i64, at: i64) -> Val {\n");
        buf_str(out, c"        let t = self.m.types[ty];\n");
        buf_str(out, c"        if n == 0 {\n");
        buf_str(out, c"            if !self.storable(ty) || self.m.has_atomic(ty) || self.m.is_runtime_sized(ty) {\n");
        buf_str(out, c"                if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                    self.emsg.push_str(\"cannot construct \");\n");
        buf_str(out, c"                    self.ty_str(ty);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if t.kind == TK_SCALAR {\n");
        buf_str(out, c"                return if t.scalar == SK_F32 { front::cfloat(SK_F32, ty, 0.0) }\n");
        buf_str(out, c"                    else { cint(t.scalar, ty, 0) };\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let e = self.f.expr(E_ZERO, ty, 0, 0, 0);\n");
        buf_str(out, c"            return val(e, ty);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if t.kind == TK_SCALAR {\n");
        buf_str(out, c"            if n != 1 {\n");
        buf_str(out, c"                self.arg_count_error(at, \"a scalar constructor\", \"one argument\", n);\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return self.convert_value(self.astack[base], ty, self.apos[base]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if t.kind == TK_VECTOR {\n");
        buf_str(out, c"            return self.construct_vector(t.scalar, t.n, base, n, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if t.kind == TK_MATRIX {\n");
        buf_str(out, c"            return self.construct_matrix(t.n, t.m, base, n, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if t.kind == TK_ARRAY {\n");
        buf_str(out, c"            if t.n == 0 {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.type\", \"a runtime-sized array cannot be constructed\");\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if n != t.n {\n");
        buf_str(out, c"                if self.err(at, \"wgsl.call\") {\n");
        buf_str(out, c"                    self.emsg.push_fmt(f\"this array has {t.n} elements, got {n}\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return self.compose_args(ty, t.base, base, n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if t.kind == TK_STRUCT {\n");
        buf_str(out, c"            if n != t.mcount {\n");
        buf_str(out, c"                if self.err(at, \"wgsl.call\") {\n");
        buf_str(out, c"                    self.emsg.push_fmt(f\"'{t.name}' has {t.mcount} members, got {n} arguments\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let start = self.estack.len();\n");
        buf_str(out, c"            for i in 0..n {\n");
        buf_str(out, c"                let mt = self.m.members[t.mstart + i].ty;\n");
        buf_str(out, c"                let e = self.materialize(self.astack[base + i], mt, self.apos[base + i]);\n");
        buf_str(out, c"                self.estack.push(e);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return self.compose_from_estack(ty, start);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"            self.emsg.push_str(\"cannot construct \");\n");
        buf_str(out, c"            self.ty_str(ty);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        cint(SK_AINT, -1, 0)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn compose_args(inout self, ty: i64, el: i64, base: i64, n: i64) -> Val {\n");
        buf_str(out, c"        let start = self.estack.len();\n");
        buf_str(out, c"        for i in 0..n {\n");
        buf_str(out, c"            let e = self.materialize(self.astack[base + i], el, self.apos[base + i]);\n");
        buf_str(out, c"            self.estack.push(e);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.compose_from_estack(ty, start)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn compose_from_estack(inout self, ty: i64, start: i64) -> Val {\n");
        buf_str(out, c"        let a = self.f.args.len();\n");
        buf_str(out, c"        for i in start..self.estack.len() {\n");
        buf_str(out, c"            self.f.args.push(self.estack[i]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let n = self.estack.len() - start;\n");
        buf_str(out, c"        self.estack.truncate(start);\n");
        buf_str(out, c"        let e = self.f.expr(E_COMPOSE, ty, a, n, 0);\n");
        buf_str(out, c"        val(e, ty)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A value conversion `T(v)`: scalar to scalar, or vector to vector of\n");
        buf_str(out, c"    // the same width.\n");
        buf_str(out, c"    fn convert_value(inout self, v0: Val, ty: i64, at: i64) -> Val {\n");
        buf_str(out, c"        let v = self.value(v0, at);\n");
        buf_str(out, c"        let t = self.m.types[ty];\n");
        buf_str(out, c"        if v.k == VK_CONST {\n");
        buf_str(out, c"            if t.kind == TK_SCALAR {\n");
        buf_str(out, c"                return self.const_cast(v, t.scalar, at, true);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return self.convert_to(v, ty, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.failed {\n");
        buf_str(out, c"            return v;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let vt = self.m.types[v.ty];\n");
        buf_str(out, c"        if v.ty == ty {\n");
        buf_str(out, c"            return v;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let w = self.m.width_of(v.ty);\n");
        buf_str(out, c"        if w == 0 || w != self.m.width_of(ty) {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                self.emsg.push_str(\"cannot convert \");\n");
        buf_str(out, c"                self.val_str(v);\n");
        buf_str(out, c"                self.emsg.push_str(\" to \");\n");
        buf_str(out, c"                self.ty_str(ty);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return v;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let _ = vt;\n");
        buf_str(out, c"        let e = self.f.expr(E_CONVERT, ty, v.e, 0, 0);\n");
        buf_str(out, c"        val(e, ty)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The scalar kind of a value's components (abstract kinds included).\n");
        buf_str(out, c"    fn comp_kind(self, v: Val) -> u8 {\n");
        buf_str(out, c"        if v.k == VK_CONST {\n");
        buf_str(out, c"            return v.sk;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let t = self.concrete_type_of(v);\n");
        buf_str(out, c"        self.m.types[t].scalar\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The concrete scalar the arguments base .. base + n share: a\n");
        buf_str(out, c"    // concrete argument's, else (all abstract) the hint's, else f32 when\n");
        buf_str(out, c"    // one is a float, else `dflt`.\n");
        buf_str(out, c"    fn common_scalar(self, base: i64, n: i64, hint_sk: i64, dflt: u8) -> u8 {\n");
        buf_str(out, c"        var any_float = false;\n");
        buf_str(out, c"        for i in base..base + n {\n");
        buf_str(out, c"            let v = self.astack[i];\n");
        buf_str(out, c"            if v.k == VK_CONST && v.ty < 0 {\n");
        buf_str(out, c"                if v.sk == SK_AFLOAT {\n");
        buf_str(out, c"                    any_float = true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return self.comp_kind(v);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if hint_sk >= 0 && hint_sk <= 3 {\n");
        buf_str(out, c"            let h = hint_sk as u8;\n");
        buf_str(out, c"            if !(any_float && h != SK_F32) {\n");
        buf_str(out, c"                return h;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if any_float { SK_F32 } else { dflt }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn construct_vector(inout self, sk: u8, n: i64, base: i64, count: i64, at: i64) -> Val {\n");
        buf_str(out, c"        let ty = vec_ty(sk, n);\n");
        buf_str(out, c"        if count == 1 {\n");
        buf_str(out, c"            let v = self.value(self.astack[base], self.apos[base]);\n");
        buf_str(out, c"            let w = if v.k == VK_CONST { 1 } else { self.m.width_of(v.ty) };\n");
        buf_str(out, c"            if w == 1 {\n");
        buf_str(out, c"                let e = self.materialize(v, sk as i64, self.apos[base]);\n");
        buf_str(out, c"                let s = self.f.expr(E_SPLAT, ty, e, 0, 0);\n");
        buf_str(out, c"                return val(s, ty);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if w == n {\n");
        buf_str(out, c"                return self.convert_value(v, ty, self.apos[base]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let start = self.estack.len();\n");
        buf_str(out, c"        var total = 0;\n");
        buf_str(out, c"        for i in base..base + count {\n");
        buf_str(out, c"            let v = self.value(self.astack[i], self.apos[i]);\n");
        buf_str(out, c"            if v.k == VK_CONST {\n");
        buf_str(out, c"                let e = self.materialize(v, sk as i64, self.apos[i]);\n");
        buf_str(out, c"                self.estack.push(e);\n");
        buf_str(out, c"                total += 1;\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let vt = self.m.types[v.ty];\n");
        buf_str(out, c"            if vt.kind == TK_SCALAR {\n");
        buf_str(out, c"                let e = self.materialize(v, sk as i64, self.apos[i]);\n");
        buf_str(out, c"                self.estack.push(e);\n");
        buf_str(out, c"                total += 1;\n");
        buf_str(out, c"            } else if vt.kind == TK_VECTOR {\n");
        buf_str(out, c"                let e = self.materialize(v, vec_ty(sk, vt.n), self.apos[i]);\n");
        buf_str(out, c"                self.estack.push(e);\n");
        buf_str(out, c"                total += vt.n;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                if self.err(self.apos[i], \"wgsl.type\") {\n");
        buf_str(out, c"                    self.emsg.push_str(\"a vector is made of scalars and vectors, not \");\n");
        buf_str(out, c"                    self.val_str(v);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.estack.truncate(start);\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if total != n {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.call\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"a vec{n} needs {n} components, got {total}\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.estack.truncate(start);\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.compose_from_estack(ty, start)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn construct_matrix(inout self, c: i64, r: i64, base: i64, count: i64, at: i64) -> Val {\n");
        buf_str(out, c"        let ty = mat_ty(c, r);\n");
        buf_str(out, c"        let col = vec_ty(SK_F32, r);\n");
        buf_str(out, c"        if count == 1 {\n");
        buf_str(out, c"            let v = self.value(self.astack[base], self.apos[base]);\n");
        buf_str(out, c"            if v.k == VK_VALUE && v.ty == ty {\n");
        buf_str(out, c"                return v;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let start = self.estack.len();\n");
        buf_str(out, c"        if count == c {\n");
        buf_str(out, c"            for i in base..base + count {\n");
        buf_str(out, c"                let e = self.materialize(self.astack[i], col, self.apos[i]);\n");
        buf_str(out, c"                self.estack.push(e);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return self.compose_from_estack(ty, start);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if count == c * r {\n");
        buf_str(out, c"            for k in 0..c {\n");
        buf_str(out, c"                let cs = self.estack.len();\n");
        buf_str(out, c"                for j in 0..r {\n");
        buf_str(out, c"                    let i = base + k * r + j;\n");
        buf_str(out, c"                    let e = self.materialize(self.astack[i], T_F32, self.apos[i]);\n");
        buf_str(out, c"                    self.estack.push(e);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let colv = self.compose_from_estack(col, cs);\n");
        buf_str(out, c"                self.estack.push(colv.e);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return self.compose_from_estack(ty, start);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.err(at, \"wgsl.call\") {\n");
        buf_str(out, c"            self.emsg.push_fmt(\n");
        buf_str(out, c"                f\"a mat{c}x{r} is made of {c} columns or {c * r} scalars, got {count} arguments\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        cint(SK_AINT, -1, 0)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Builtins ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn builtin_primary(inout self, s: i64, at: i64, hint: i64) -> Val {\n");
        buf_str(out, c"        // inferred constructors\n");
        buf_str(out, c"        if s >= K_VEC2 && s <= K_VEC4 && self.kind_at(self.p + 1) == T_LPAREN {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let n = s - K_VEC2 + 2;\n");
        buf_str(out, c"            let hs = if hint >= 0 { self.m.types[hint].scalar as i64 } else { -1 };\n");
        buf_str(out, c"            let hk = if hint >= 0 { self.m.types[hint].kind } else { 255 };\n");
        buf_str(out, c"            let base = self.args(if hk == TK_VECTOR || hk == TK_SCALAR { hs } else { -1 });\n");
        buf_str(out, c"            let cnt = self.astack.len() - base;\n");
        buf_str(out, c"            let sk = self.common_scalar(base, cnt,\n");
        buf_str(out, c"                if hk == TK_VECTOR || hk == TK_SCALAR { hs } else { -1 }, SK_I32);\n");
        buf_str(out, c"            let r = if cnt == 0 { self.construct_from(vec_ty(sk, n), base, 0, at) }\n");
        buf_str(out, c"                else { self.construct_vector(sk, n, base, cnt, at) };\n");
        buf_str(out, c"            self.drop_args(base);\n");
        buf_str(out, c"            return r;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s >= K_MAT2X2 && s <= K_MAT4X4 && self.kind_at(self.p + 1) == T_LPAREN {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let i = s - K_MAT2X2;\n");
        buf_str(out, c"            let base = self.args(T_F32);\n");
        buf_str(out, c"            let cnt = self.astack.len() - base;\n");
        buf_str(out, c"            let r = if cnt == 0 {\n");
        buf_str(out, c"                self.construct_from(mat_ty(i / 3 + 2, i % 3 + 2), base, 0, at)\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.construct_matrix(i / 3 + 2, i % 3 + 2, base, cnt, at)\n");
        buf_str(out, c"            };\n");
        buf_str(out, c"            self.drop_args(base);\n");
        buf_str(out, c"            return r;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == K_ARRAY && self.kind_at(self.p + 1) == T_LPAREN {\n");
        buf_str(out, c"            self.p += 1;\n");
        buf_str(out, c"            let he = if hint >= 0 && self.m.types[hint].kind == TK_ARRAY { self.m.types[hint].base }\n");
        buf_str(out, c"                else { -1 };\n");
        buf_str(out, c"            let base = self.args(he);\n");
        buf_str(out, c"            let cnt = self.astack.len() - base;\n");
        buf_str(out, c"            if cnt == 0 {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.call\",\n");
        buf_str(out, c"                    \"'array()' needs its elements, or a type: 'array<f32, 4>()'\");\n");
        buf_str(out, c"                self.drop_args(base);\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            // the element type: a concrete element's, else the hint's, else the default\n");
        buf_str(out, c"            var el = -1;\n");
        buf_str(out, c"            for i in base..base + cnt {\n");
        buf_str(out, c"                let v = self.astack[i];\n");
        buf_str(out, c"                if !(v.k == VK_CONST && v.ty < 0) {\n");
        buf_str(out, c"                    el = self.concrete_type_of(v);\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if el < 0 {\n");
        buf_str(out, c"                el = if he >= 0 { he } else { self.concrete_type_of(self.astack[base]) };\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let ty = self.m.array_ty(el, cnt);\n");
        buf_str(out, c"            let r = self.compose_args(ty, el, base, cnt);\n");
        buf_str(out, c"            self.drop_args(base);\n");
        buf_str(out, c"            return r;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.is_type_name(s) {\n");
        buf_str(out, c"            let ty = self.parse_type();\n");
        buf_str(out, c"            return self.construct(ty, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.p += 1;\n");
        buf_str(out, c"        if self.kind() != T_LPAREN {\n");
        buf_str(out, c"            if s == K_BITCAST && self.kind() == T_LT {\n");
        buf_str(out, c"                self.p += 1;\n");
        buf_str(out, c"                let ty = self.parse_type();\n");
        buf_str(out, c"                self.expect_gt();\n");
        buf_str(out, c"                return self.bitcast(ty, at);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if self.err(at, \"wgsl.name\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"unknown name '{self.name_of(s)}'\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s >= K_MATH_FIRST && s <= K_MATH_LAST {\n");
        buf_str(out, c"            return self.math(s - K_MATH_FIRST, s, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == K_SELECT {\n");
        buf_str(out, c"            return self.select(at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == K_ARRAY_LENGTH {\n");
        buf_str(out, c"            return self.array_length(at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s >= K_ATOMIC_LOAD && s <= K_ATOMIC_COMPARE_EXCHANGE_WEAK {\n");
        buf_str(out, c"            return self.atomic(s, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == K_WORKGROUP_BARRIER || s == K_STORAGE_BARRIER {\n");
        buf_str(out, c"            let base = self.args(-1);\n");
        buf_str(out, c"            let n = self.astack.len() - base;\n");
        buf_str(out, c"            self.drop_args(base);\n");
        buf_str(out, c"            if n != 0 {\n");
        buf_str(out, c"                self.arg_count_error(at, self.name_of(s), \"no arguments\", n);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if self.stage != STAGE_COMPUTE as i64 && self.stage != 255 {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.stage\", \"barriers are for compute shaders\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.push_stmt(S_BARRIER,\n");
        buf_str(out, c"                if s == K_WORKGROUP_BARRIER { BARRIER_WORKGROUP } else { BARRIER_STORAGE }, 0, 0,\n");
        buf_str(out, c"                0);\n");
        buf_str(out, c"            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == K_WORKGROUP_UNIFORM_LOAD {\n");
        buf_str(out, c"            let base = self.args(-1);\n");
        buf_str(out, c"            let n = self.astack.len() - base;\n");
        buf_str(out, c"            if n != 1 {\n");
        buf_str(out, c"                self.drop_args(base);\n");
        buf_str(out, c"                self.arg_count_error(at, \"workgroupUniformLoad\", \"one pointer\", n);\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let p = self.value(self.astack[base], self.apos[base]);\n");
        buf_str(out, c"            self.drop_args(base);\n");
        buf_str(out, c"            let pt = if p.k == VK_VALUE { self.m.types[p.ty] } else { self.m.types[T_I32] };\n");
        buf_str(out, c"            if pt.kind != TK_POINTER || pt.space != SP_WORKGROUP || self.m.has_atomic(pt.base) {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.type\",\n");
        buf_str(out, c"                    \"workgroupUniformLoad takes a pointer to workgroup memory (not an atomic): &x\");\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let r = self.unemitted(E_WG_UNIFORM_RESULT, pt.base);\n");
        buf_str(out, c"            self.push_stmt(S_WG_UNIFORM_LOAD, p.e, r, 0, 0);\n");
        buf_str(out, c"            return val(r, pt.base);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s >= K_DPDX && s <= K_FWIDTH_FINE {\n");
        buf_str(out, c"            let k = (s - K_DPDX) % 3;\n");
        buf_str(out, c"            let base = self.args(-1);\n");
        buf_str(out, c"            let n = self.astack.len() - base;\n");
        buf_str(out, c"            if n != 1 {\n");
        buf_str(out, c"                self.drop_args(base);\n");
        buf_str(out, c"                self.arg_count_error(at, self.name_of(s), \"one argument\", n);\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if self.stage != STAGE_FRAGMENT as i64 && self.stage != 255 {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.stage\", \"derivatives are for fragment shaders\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let ty = self.float_type(self.astack[base], self.apos[base]);\n");
        buf_str(out, c"            let e0 = self.materialize(self.astack[base], ty, self.apos[base]);\n");
        buf_str(out, c"            self.drop_args(base);\n");
        buf_str(out, c"            let e = self.f.expr(E_DERIVATIVE, ty, k, e0, 0);\n");
        buf_str(out, c"            return val(e, ty);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s >= K_TEXTURE_SAMPLE && s <= K_TEXTURE_NUM_LAYERS {\n");
        buf_str(out, c"            return self.texture_call(s, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.err(at, \"wgsl.name\") {\n");
        buf_str(out, c"            self.emsg.push_fmt(f\"unknown function '{self.name_of(s)}'\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        cint(SK_AINT, -1, 0)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An f32 scalar or vector type for v (abstract numbers become f32).\n");
        buf_str(out, c"    fn float_type(inout self, v: Val, at: i64) -> i64 {\n");
        buf_str(out, c"        if v.k == VK_CONST && v.ty < 0 {\n");
        buf_str(out, c"            return T_F32;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let t = self.concrete_type_of(v);\n");
        buf_str(out, c"        let tt = self.m.types[t];\n");
        buf_str(out, c"        if (tt.kind != TK_SCALAR && tt.kind != TK_VECTOR) || tt.scalar != SK_F32 {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                self.emsg.push_str(\"expected f32 or vecN<f32>, got \");\n");
        buf_str(out, c"                self.val_str(v);\n");
        buf_str(out, c"                if tt.scalar == SK_I32 || tt.scalar == SK_U32 {\n");
        buf_str(out, c"                    self.help(\"convert it: f32(...)\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return T_F32;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        t\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn bitcast(inout self, ty: i64, at: i64) -> Val {\n");
        buf_str(out, c"        let base = self.args(-1);\n");
        buf_str(out, c"        let n = self.astack.len() - base;\n");
        buf_str(out, c"        if n != 1 {\n");
        buf_str(out, c"            self.drop_args(base);\n");
        buf_str(out, c"            self.arg_count_error(at, \"bitcast\", \"one argument\", n);\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var v = self.value(self.astack[base], self.apos[base]);\n");
        buf_str(out, c"        let ap = self.apos[base];\n");
        buf_str(out, c"        self.drop_args(base);\n");
        buf_str(out, c"        if v.k == VK_CONST && v.ty < 0 {\n");
        buf_str(out, c"            v = if v.sk == SK_AINT && v.iv > 2147483647 { self.const_cast(v, SK_U32, ap, false) }\n");
        buf_str(out, c"                else {\n");
        buf_str(out, c"                    self.const_cast(v, if v.sk == SK_AINT { SK_I32 } else { SK_F32 }, ap, false)\n");
        buf_str(out, c"                };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let vt = self.concrete_type_of(v);\n");
        buf_str(out, c"        let w = self.m.width_of(vt);\n");
        buf_str(out, c"        let tw = self.m.width_of(ty);\n");
        buf_str(out, c"        if w == 0 || w != tw || self.m.types[vt].scalar == SK_BOOL\n");
        buf_str(out, c"            || self.m.types[ty].scalar == SK_BOOL {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"                self.emsg.push_str(\n");
        buf_str(out, c"                    \"bitcast converts between 32-bit numbers and vectors of them of one width; got \");\n");
        buf_str(out, c"                self.val_str(v);\n");
        buf_str(out, c"                self.emsg.push_str(\" to \");\n");
        buf_str(out, c"                self.ty_str(ty);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return v;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let e0 = self.materialize(v, vt, ap);\n");
        buf_str(out, c"        if vt == ty {\n");
        buf_str(out, c"            return val(e0, ty);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let e = self.f.expr(E_BITCAST, ty, e0, 0, 0);\n");
        buf_str(out, c"        val(e, ty)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn select(inout self, at: i64) -> Val {\n");
        buf_str(out, c"        let base = self.args(-1);\n");
        buf_str(out, c"        let n = self.astack.len() - base;\n");
        buf_str(out, c"        if n != 3 {\n");
        buf_str(out, c"            self.drop_args(base);\n");
        buf_str(out, c"            self.arg_count_error(at, \"select\", \"3 arguments (if false, if true, condition)\", n);\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let sk = self.common_scalar(base, 2, -1, SK_I32);\n");
        buf_str(out, c"        var ty = -1;\n");
        buf_str(out, c"        for i in base..base + 2 {\n");
        buf_str(out, c"            let v = self.astack[i];\n");
        buf_str(out, c"            if !(v.k == VK_CONST && v.ty < 0) {\n");
        buf_str(out, c"                ty = self.concrete_type_of(v);\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if ty < 0 {\n");
        buf_str(out, c"            ty = sk as i64;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let tt = self.m.types[ty];\n");
        buf_str(out, c"        if tt.kind != TK_SCALAR && tt.kind != TK_VECTOR {\n");
        buf_str(out, c"            self.drop_args(base);\n");
        buf_str(out, c"            self.fail(at, \"wgsl.type\", \"select chooses between scalars or vectors\");\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let f = self.materialize(self.astack[base], ty, self.apos[base]);\n");
        buf_str(out, c"        let t = self.materialize(self.astack[base + 1], ty, self.apos[base + 1]);\n");
        buf_str(out, c"        let cv = self.value(self.astack[base + 2], self.apos[base + 2]);\n");
        buf_str(out, c"        let ct = self.concrete_type_of(cv);\n");
        buf_str(out, c"        let w = self.m.width_of(ty);\n");
        buf_str(out, c"        if ct != T_BOOL && ct != vec_ty(SK_BOOL, w) {\n");
        buf_str(out, c"            if self.err(self.apos[base + 2], \"wgsl.type\") {\n");
        buf_str(out, c"                self.emsg.push_str(\n");
        buf_str(out, c"                    \"select's condition is a bool (or a vector of bool as wide as the values), not \");\n");
        buf_str(out, c"                self.val_str(cv);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let c = self.materialize(cv, ct, self.apos[base + 2]);\n");
        buf_str(out, c"        self.drop_args(base);\n");
        buf_str(out, c"        let e = self.f.expr(E_SELECT, ty, c, t, f);\n");
        buf_str(out, c"        val(e, ty)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn array_length(inout self, at: i64) -> Val {\n");
        buf_str(out, c"        let base = self.args(-1);\n");
        buf_str(out, c"        let n = self.astack.len() - base;\n");
        buf_str(out, c"        if n != 1 {\n");
        buf_str(out, c"            self.drop_args(base);\n");
        buf_str(out, c"            self.arg_count_error(at, \"arrayLength\", \"one pointer\", n);\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let p = self.astack[base];\n");
        buf_str(out, c"        self.drop_args(base);\n");
        buf_str(out, c"        let ok = p.k == VK_VALUE && self.m.types[p.ty].kind == TK_POINTER\n");
        buf_str(out, c"            && self.m.types[p.ty].space == SP_STORAGE;\n");
        buf_str(out, c"        if ok {\n");
        buf_str(out, c"            let pe = self.f.exprs[p.e];\n");
        buf_str(out, c"            let pointee = self.m.pointee(p.ty);\n");
        buf_str(out, c"            let t = self.m.types[pointee];\n");
        buf_str(out, c"            if t.kind == TK_ARRAY && t.n == 0 {\n");
        buf_str(out, c"                if pe.op == E_GLOBAL {\n");
        buf_str(out, c"                    let e = self.f.expr(E_ARRAY_LENGTH, T_U32, pe.a, -1, 0);\n");
        buf_str(out, c"                    self.f.exprs[e].d = t.stride;\n");
        buf_str(out, c"                    return val(e, T_U32);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if pe.op == ir::E_ACCESS_INDEX && self.f.exprs[pe.a].op == E_GLOBAL {\n");
        buf_str(out, c"                    let g = self.f.exprs[pe.a].a;\n");
        buf_str(out, c"                    let st = self.m.types[self.m.globals[g].ty];\n");
        buf_str(out, c"                    let off = self.m.members[st.mstart + pe.b].offset;\n");
        buf_str(out, c"                    let e = self.f.expr(E_ARRAY_LENGTH, T_U32, g, pe.b, off);\n");
        buf_str(out, c"                    self.f.exprs[e].d = t.stride;\n");
        buf_str(out, c"                    return val(e, T_U32);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"            self.emsg.push_str(\"arrayLength takes a pointer to a runtime-sized array in a storage buffer: arrayLength(&buf) or arrayLength(&buf.items)\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        cint(SK_AINT, -1, 0)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn atomic(inout self, s: i64, at: i64) -> Val {\n");
        buf_str(out, c"        let base = self.args(-1);\n");
        buf_str(out, c"        let n = self.astack.len() - base;\n");
        buf_str(out, c"        let want = if s == K_ATOMIC_LOAD { 1 } else if s == K_ATOMIC_COMPARE_EXCHANGE_WEAK { 3 }\n");
        buf_str(out, c"            else { 2 };\n");
        buf_str(out, c"        if n != want {\n");
        buf_str(out, c"            self.drop_args(base);\n");
        buf_str(out, c"            if self.err(at, \"wgsl.call\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"'{self.name_of(s)}' takes {want} argument\");\n");
        buf_str(out, c"                if want != 1 {\n");
        buf_str(out, c"                    self.emsg.push('s');\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.emsg.push_fmt(f\", got {n}\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let p = self.astack[base];\n");
        buf_str(out, c"        let pt = if p.k == VK_VALUE && p.ty >= 0 { self.m.types[p.ty] }\n");
        buf_str(out, c"            else { self.m.types[T_I32] };\n");
        buf_str(out, c"        if pt.kind != TK_POINTER || self.m.types[pt.base].kind != TK_ATOMIC {\n");
        buf_str(out, c"            self.drop_args(base);\n");
        buf_str(out, c"            if self.err(self.apos[base], \"wgsl.type\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"'{self.name_of(s)}' takes a pointer to an atomic, got \");\n");
        buf_str(out, c"                self.val_str(p);\n");
        buf_str(out, c"                if p.k == VK_REF {\n");
        buf_str(out, c"                    self.help(\"pass its address: &x\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let sk = self.m.types[pt.base].scalar;\n");
        buf_str(out, c"        let st = sk as i64;\n");
        buf_str(out, c"        let fun = if s == K_ATOMIC_LOAD {\n");
        buf_str(out, c"            AT_LOAD\n");
        buf_str(out, c"        } else if s == K_ATOMIC_STORE {\n");
        buf_str(out, c"            AT_STORE\n");
        buf_str(out, c"        } else if s == K_ATOMIC_ADD {\n");
        buf_str(out, c"            AT_ADD\n");
        buf_str(out, c"        } else if s == K_ATOMIC_SUB {\n");
        buf_str(out, c"            AT_SUB\n");
        buf_str(out, c"        } else if s == K_ATOMIC_MAX {\n");
        buf_str(out, c"            AT_MAX\n");
        buf_str(out, c"        } else if s == K_ATOMIC_MIN {\n");
        buf_str(out, c"            AT_MIN\n");
        buf_str(out, c"        } else if s == K_ATOMIC_AND {\n");
        buf_str(out, c"            AT_AND\n");
        buf_str(out, c"        } else if s == K_ATOMIC_OR {\n");
        buf_str(out, c"            AT_OR\n");
        buf_str(out, c"        } else if s == K_ATOMIC_XOR {\n");
        buf_str(out, c"            AT_XOR\n");
        buf_str(out, c"        } else if s == K_ATOMIC_EXCHANGE {\n");
        buf_str(out, c"            AT_EXCHANGE\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            AT_CMPXCHG\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        var v = -1;\n");
        buf_str(out, c"        var cmp = -1;\n");
        buf_str(out, c"        if fun == AT_CMPXCHG {\n");
        buf_str(out, c"            cmp = self.materialize(self.astack[base + 1], st, self.apos[base + 1]);\n");
        buf_str(out, c"            v = self.materialize(self.astack[base + 2], st, self.apos[base + 2]);\n");
        buf_str(out, c"        } else if fun != AT_LOAD {\n");
        buf_str(out, c"            v = self.materialize(self.astack[base + 1], st, self.apos[base + 1]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.drop_args(base);\n");
        buf_str(out, c"        if fun == AT_STORE {\n");
        buf_str(out, c"            let s0 = self.push_stmt(S_ATOMIC, p.e, fun, v, -1);\n");
        buf_str(out, c"            self.f.stmts[s0].e = -1;\n");
        buf_str(out, c"            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let rty = if fun == AT_CMPXCHG { self.cmpxchg_type(sk) } else { st };\n");
        buf_str(out, c"        let r = self.unemitted(E_ATOMIC_RESULT, rty);\n");
        buf_str(out, c"        let s0 = self.push_stmt(S_ATOMIC, p.e, fun, v, r);\n");
        buf_str(out, c"        self.f.stmts[s0].e = cmp;\n");
        buf_str(out, c"        val(r, rty)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // __atomic_compare_exchange_result<T>: { old_value: T, exchanged: bool }\n");
        buf_str(out, c"    pub fn cmpxchg_type(inout self, sk: u8) -> i64 {\n");
        buf_str(out, c"        let i = if sk == SK_I32 { 0 } else { 1 };\n");
        buf_str(out, c"        if self.cmpxchg_ty[i] >= 0 {\n");
        buf_str(out, c"            return self.cmpxchg_ty[i];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let start = self.m.members.len();\n");
        buf_str(out, c"        self.m.members.push(StructMember {\n");
        buf_str(out, c"            name: \"old_value\", ty: sk as i64, offset: 0, binding: ir::no_binding()\n");
        buf_str(out, c"        });\n");
        buf_str(out, c"        self.m.members.push(StructMember {\n");
        buf_str(out, c"            name: \"exchanged\", ty: T_BOOL, offset: 0, binding: ir::no_binding()\n");
        buf_str(out, c"        });\n");
        buf_str(out, c"        let name = if sk == SK_I32 { \"__atomic_compare_exchange_result_i32\" }\n");
        buf_str(out, c"            else { \"__atomic_compare_exchange_result_u32\" };\n");
        buf_str(out, c"        let h = self.m.struct_ty(name, start, 2);\n");
        buf_str(out, c"        self.cmpxchg_ty[i] = h;\n");
        buf_str(out, c"        h\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Math ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn math(inout self, fun: i64, s: i64, at: i64) -> Val {\n");
        buf_str(out, c"        let base = self.args(-1);\n");
        buf_str(out, c"        let n = self.astack.len() - base;\n");
        buf_str(out, c"        let name = self.name_of(s);\n");
        buf_str(out, c"        let want = math_arity(fun);\n");
        buf_str(out, c"        if n != want {\n");
        buf_str(out, c"            self.drop_args(base);\n");
        buf_str(out, c"            if self.err(at, \"wgsl.call\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"'{name}' takes {want} argument\");\n");
        buf_str(out, c"                if want != 1 {\n");
        buf_str(out, c"                    self.emsg.push('s');\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.emsg.push_fmt(f\", got {n}\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let r = self.math_typed(fun, name, base, n, at);\n");
        buf_str(out, c"        self.drop_args(base);\n");
        buf_str(out, c"        r\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn math_fail(inout self, at: i64, name: [u8], what: [u8], base: i64, n: i64) -> Val {\n");
        buf_str(out, c"        if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"            self.emsg.push_fmt(f\"'{name}' takes {what}; got \");\n");
        buf_str(out, c"            for i in base..base + n {\n");
        buf_str(out, c"                if i > base {\n");
        buf_str(out, c"                    self.emsg.push_str(\", \");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.val_str(self.astack[i]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        cint(SK_AINT, -1, 0)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The common type of args[base .. base + n] (abstract ones take the\n");
        buf_str(out, c"    // others' scalar; all abstract: f32 when `float`, else by their kind).\n");
        buf_str(out, c"    fn common_type(self, base: i64, n: i64, float: bool) -> i64 {\n");
        buf_str(out, c"        for i in base..base + n {\n");
        buf_str(out, c"            let v = self.astack[i];\n");
        buf_str(out, c"            if !(v.k == VK_CONST && v.ty < 0) {\n");
        buf_str(out, c"                return self.concrete_type_of(v);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var any_float = float;\n");
        buf_str(out, c"        for i in base..base + n {\n");
        buf_str(out, c"            if self.astack[i].sk == SK_AFLOAT {\n");
        buf_str(out, c"                any_float = true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if any_float { T_F32 } else { T_I32 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn math_typed(inout self, fun: i64, name: [u8], base: i64, n: i64, at: i64) -> Val {\n");
        buf_str(out, c"        let float_only = is_float_fun(fun);\n");
        buf_str(out, c"        if fun == MF_ALL || fun == MF_ANY {\n");
        buf_str(out, c"            let v = self.value(self.astack[base], self.apos[base]);\n");
        buf_str(out, c"            let t = self.concrete_type_of(v);\n");
        buf_str(out, c"            if self.m.types[t].scalar != SK_BOOL || self.m.width_of(t) == 0 {\n");
        buf_str(out, c"                return self.math_fail(at, name, \"a bool or a vector of bool\", base, n);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if t == T_BOOL {\n");
        buf_str(out, c"                return v;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let e0 = self.materialize(v, t, self.apos[base]);\n");
        buf_str(out, c"            return self.math_expr(fun, T_BOOL, [e0, 0, 0, 0], 1);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun >= ir::MF_PACK4X8UNORM && fun <= ir::MF_UNPACK2X16FLOAT\n");
        buf_str(out, c"            || fun >= ir::MF_PACK4X8SNORM {\n");
        buf_str(out, c"            return self.packing(fun, name, base, at);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == MF_LDEXP {\n");
        buf_str(out, c"            let t = self.float_type(self.astack[base], self.apos[base]);\n");
        buf_str(out, c"            let w = self.m.width_of(t);\n");
        buf_str(out, c"            let e0 = self.materialize(self.astack[base], t, self.apos[base]);\n");
        buf_str(out, c"            let e1 = self.materialize(self.astack[base + 1], vec_ty(SK_I32, w),\n");
        buf_str(out, c"                self.apos[base + 1]);\n");
        buf_str(out, c"            return self.math_expr(fun, t, [e0, e1, 0, 0], 2);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == MF_EXTRACT_BITS || fun == MF_INSERT_BITS {\n");
        buf_str(out, c"            let k = if fun == MF_EXTRACT_BITS { 1 } else { 2 };\n");
        buf_str(out, c"            let t = self.common_type(base, k, false);\n");
        buf_str(out, c"            let sk = self.m.types[t].scalar;\n");
        buf_str(out, c"            if (sk != SK_I32 && sk != SK_U32) || self.m.width_of(t) == 0 {\n");
        buf_str(out, c"                return self.math_fail(at, name, \"i32 or u32 values and u32 offset and count\", base,\n");
        buf_str(out, c"                    n);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            var es: [i64; 4] = [0; 4];\n");
        buf_str(out, c"            for i in 0..k {\n");
        buf_str(out, c"                es[i] = self.materialize(self.astack[base + i], t, self.apos[base + i]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            es[k] = self.materialize(self.astack[base + k], T_U32, self.apos[base + k]);\n");
        buf_str(out, c"            es[k + 1] = self.materialize(self.astack[base + k + 1], T_U32, self.apos[base + k + 1]);\n");
        buf_str(out, c"            return self.math_expr(fun, t, es, k + 2);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_MIX {\n");
        buf_str(out, c"            // mix(a, b, t): t is the same type, or a scalar\n");
        buf_str(out, c"            let t = self.common_type(base, 2, true);\n");
        buf_str(out, c"            if self.m.types[t].scalar != SK_F32 || self.m.width_of(t) == 0 {\n");
        buf_str(out, c"                return self.math_fail(at, name, \"f32 values\", base, n);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let e0 = self.materialize(self.astack[base], t, self.apos[base]);\n");
        buf_str(out, c"            let e1 = self.materialize(self.astack[base + 1], t, self.apos[base + 1]);\n");
        buf_str(out, c"            let tv = self.value(self.astack[base + 2], self.apos[base + 2]);\n");
        buf_str(out, c"            let tt = if tv.k == VK_CONST { T_F32 } else { tv.ty };\n");
        buf_str(out, c"            var e2 = self.materialize(tv, if tt == T_F32 { T_F32 } else { t },\n");
        buf_str(out, c"                self.apos[base + 2]);\n");
        buf_str(out, c"            if tt == T_F32 && t != T_F32 {\n");
        buf_str(out, c"                e2 = self.f.expr(E_SPLAT, t, e2, 0, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return self.math_expr(fun, t, [e0, e1, e2, 0], 3);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let t = self.common_type(base, n, float_only);\n");
        buf_str(out, c"        let tt = self.m.types[t];\n");
        buf_str(out, c"        let sk = tt.scalar;\n");
        buf_str(out, c"        if fun == MF_DETERMINANT || fun == MF_TRANSPOSE {\n");
        buf_str(out, c"            if tt.kind != TK_MATRIX || (fun == MF_DETERMINANT && tt.n != tt.m) {\n");
        buf_str(out, c"                return self.math_fail(at, name,\n");
        buf_str(out, c"                    if fun == MF_DETERMINANT { \"a square matrix\" } else { \"a matrix\" }, base, n);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let e0 = self.materialize(self.astack[base], t, self.apos[base]);\n");
        buf_str(out, c"            let rt = if fun == MF_DETERMINANT { T_F32 } else { mat_ty(tt.m, tt.n) };\n");
        buf_str(out, c"            return self.math_expr(fun, rt, [e0, 0, 0, 0], 1);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let w = self.m.width_of(t);\n");
        buf_str(out, c"        if w == 0 || sk == SK_BOOL {\n");
        buf_str(out, c"            return self.math_fail(at, name,\n");
        buf_str(out, c"                if float_only { \"f32 or vecN<f32>\" } else { \"numbers or vectors of them\" }, base,\n");
        buf_str(out, c"                n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if float_only && sk != SK_F32 {\n");
        buf_str(out, c"            let r = self.math_fail(at, name, \"f32 or vecN<f32>\", base, n);\n");
        buf_str(out, c"            self.help(\"convert it: f32(...)\");\n");
        buf_str(out, c"            return r;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if is_int_fun(fun) && sk == SK_F32 {\n");
        buf_str(out, c"            return self.math_fail(at, name, \"i32 or u32 (or vectors of them)\", base, n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_SIGN && sk == SK_U32 {\n");
        buf_str(out, c"            return self.math_fail(at, name, \"i32 or f32 (or vectors of them)\", base, n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let vector_only = fun == MF_CROSS || fun == ir::MF_NORMALIZE || fun == ir::MF_REFLECT\n");
        buf_str(out, c"            || fun == ir::MF_FACE_FORWARD || fun == MF_DOT || fun == MF_DISTANCE && false;\n");
        buf_str(out, c"        if vector_only && w == 1 {\n");
        buf_str(out, c"            return self.math_fail(at, name, \"vectors\", base, n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == MF_CROSS && (w != 3 || sk != SK_F32) {\n");
        buf_str(out, c"            return self.math_fail(at, name, \"two vec3<f32>\", base, n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var es: [i64; 4] = [0; 4];\n");
        buf_str(out, c"        for i in 0..n {\n");
        buf_str(out, c"            es[i] = self.materialize(self.astack[base + i], t, self.apos[base + i]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let rt = if fun == MF_LENGTH || fun == MF_DISTANCE || fun == MF_DOT { sk as i64 }\n");
        buf_str(out, c"            else { t };\n");
        buf_str(out, c"        // constants fold when they are scalars of the simple kind\n");
        buf_str(out, c"        self.math_expr(fun, rt, es, n)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn math_expr(inout self, fun: i64, ty: i64, es: [i64; 4], n: i64) -> Val {\n");
        buf_str(out, c"        let a = self.f.args.len();\n");
        buf_str(out, c"        for i in 0..n {\n");
        buf_str(out, c"            self.f.args.push(es[i]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let e = self.f.expr(E_MATH, ty, fun, a, n);\n");
        buf_str(out, c"        val(e, ty)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn packing(inout self, fun: i64, name: [u8], base: i64, at: i64) -> Val {\n");
        buf_str(out, c"        let unpack = fun == ir::MF_UNPACK4X8UNORM || fun == ir::MF_UNPACK2X16FLOAT\n");
        buf_str(out, c"            || fun == ir::MF_UNPACK4X8SNORM || fun == ir::MF_UNPACK2X16UNORM\n");
        buf_str(out, c"            || fun == ir::MF_UNPACK2X16SNORM;\n");
        buf_str(out, c"        let four = fun == ir::MF_PACK4X8UNORM || fun == ir::MF_UNPACK4X8UNORM\n");
        buf_str(out, c"            || fun == ir::MF_PACK4X8SNORM || fun == ir::MF_UNPACK4X8SNORM;\n");
        buf_str(out, c"        let vt = vec_ty(SK_F32, if four { 4 } else { 2 });\n");
        buf_str(out, c"        if unpack {\n");
        buf_str(out, c"            let e0 = self.materialize(self.astack[base], T_U32, self.apos[base]);\n");
        buf_str(out, c"            return self.math_expr(fun, vt, [e0, 0, 0, 0], 1);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let v = self.value(self.astack[base], self.apos[base]);\n");
        buf_str(out, c"        if self.concrete_type_of(v) != vt {\n");
        buf_str(out, c"            return self.math_fail(at, name, if four { \"a vec4<f32>\" } else { \"a vec2<f32>\" }, base,\n");
        buf_str(out, c"                1);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let e0 = self.materialize(v, vt, self.apos[base]);\n");
        buf_str(out, c"        self.math_expr(fun, T_U32, [e0, 0, 0, 0], 1)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Textures ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn texture_arg(inout self, i: i64, sampler: bool) -> i64 {\n");
        buf_str(out, c"        let v = self.astack[i];\n");
        buf_str(out, c"        let want = if sampler { TK_SAMPLER } else { TK_TEXTURE };\n");
        buf_str(out, c"        if v.k != VK_VALUE || self.m.types[v.ty].kind != want {\n");
        buf_str(out, c"            if self.err(self.apos[i], \"wgsl.type\") {\n");
        buf_str(out, c"                self.emsg.push_str(if sampler { \"expected a sampler, got \" }\n");
        buf_str(out, c"                    else { \"expected a texture, got \" });\n");
        buf_str(out, c"                self.val_str(v);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v.e\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn texture_call(inout self, s: i64, at: i64) -> Val {\n");
        buf_str(out, c"        let base = self.args(-1);\n");
        buf_str(out, c"        let n = self.astack.len() - base;\n");
        buf_str(out, c"        let r = self.texture_typed(s, base, n, at);\n");
        buf_str(out, c"        self.drop_args(base);\n");
        buf_str(out, c"        r\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn texture_typed(inout self, s: i64, base: i64, n: i64, at: i64) -> Val {\n");
        buf_str(out, c"        let name = self.name_of(s);\n");
        buf_str(out, c"        if n < 1 {\n");
        buf_str(out, c"            self.arg_count_error(at, name, \"a texture first\", n);\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let te = self.texture_arg(base, false);\n");
        buf_str(out, c"        if te < 0 {\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let tt = self.m.types[self.f.exprs[te].ty];\n");
        buf_str(out, c"        let arrayed = tt.n == TEX_2D_ARRAY;\n");
        buf_str(out, c"        let depth = tt.n == TEX_DEPTH_2D;\n");
        buf_str(out, c"        let storage = tt.n == TEX_STORAGE_2D;\n");
        buf_str(out, c"        let texel = if depth { T_F32 } else { vec_ty(tt.scalar, 4) };\n");
        buf_str(out, c"        if s == K_TEXTURE_DIMENSIONS || s == K_TEXTURE_NUM_LEVELS || s == K_TEXTURE_NUM_LAYERS {\n");
        buf_str(out, c"            if s == K_TEXTURE_NUM_LAYERS && !arrayed {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.type\", \"textureNumLayers takes an array texture\");\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if s == K_TEXTURE_NUM_LEVELS && storage {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.type\", \"a storage texture has one level\");\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            var lvl = -1;\n");
        buf_str(out, c"            if s == K_TEXTURE_DIMENSIONS && n == 2 && !storage {\n");
        buf_str(out, c"                let lt = self.int_arg_type(base + 1);\n");
        buf_str(out, c"                lvl = self.materialize(self.astack[base + 1], lt, self.apos[base + 1]);\n");
        buf_str(out, c"            } else if n != 1 {\n");
        buf_str(out, c"                self.arg_count_error(at, name, \"the texture (and for textureDimensions a level)\",\n");
        buf_str(out, c"                    n);\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let q = if s == K_TEXTURE_DIMENSIONS { IQ_SIZE }\n");
        buf_str(out, c"                else if s == K_TEXTURE_NUM_LEVELS { IQ_LEVELS } else { IQ_LAYERS };\n");
        buf_str(out, c"            let rt = if q == IQ_SIZE { vec_ty(SK_U32, 2) } else { T_U32 };\n");
        buf_str(out, c"            let e = self.f.expr(E_IMAGE_QUERY, rt, te, q, lvl);\n");
        buf_str(out, c"            return val(e, rt);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == K_TEXTURE_STORE {\n");
        buf_str(out, c"            if !storage {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.type\", \"textureStore writes a texture_storage_2d\");\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if n != 3 {\n");
        buf_str(out, c"                self.arg_count_error(at, name, \"3 arguments (texture, coordinates, value)\", n);\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let ct = self.coords_type(base + 1);\n");
        buf_str(out, c"            let ce = self.materialize(self.astack[base + 1], ct, self.apos[base + 1]);\n");
        buf_str(out, c"            let ve = self.materialize(self.astack[base + 2], texel, self.apos[base + 2]);\n");
        buf_str(out, c"            self.push_stmt(S_IMAGE_STORE, te, ce, ve, -1);\n");
        buf_str(out, c"            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == K_TEXTURE_LOAD {\n");
        buf_str(out, c"            if storage {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.unsupported\",\n");
        buf_str(out, c"                    \"storage textures are write-only in this release\");\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let want = if arrayed { 4 } else { 3 };\n");
        buf_str(out, c"            if n != want {\n");
        buf_str(out, c"                self.arg_count_error(at, name,\n");
        buf_str(out, c"                    if arrayed { \"4 arguments (texture, coordinates, layer, level)\" }\n");
        buf_str(out, c"                    else { \"3 arguments (texture, coordinates, level)\" }, n);\n");
        buf_str(out, c"                return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let ct = self.coords_type(base + 1);\n");
        buf_str(out, c"            let a = self.f.args.len();\n");
        buf_str(out, c"            let ce = self.materialize(self.astack[base + 1], ct, self.apos[base + 1]);\n");
        buf_str(out, c"            var extra: [i64; 2] = [0; 2];\n");
        buf_str(out, c"            for i in 2..n {\n");
        buf_str(out, c"                let it = self.int_arg_type(base + i);\n");
        buf_str(out, c"                extra[i - 2] = self.materialize(self.astack[base + i], it, self.apos[base + i]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let a2 = self.f.args.len();\n");
        buf_str(out, c"            let _ = a;\n");
        buf_str(out, c"            self.f.args.push(ce);\n");
        buf_str(out, c"            for i in 2..n {\n");
        buf_str(out, c"                self.f.args.push(extra[i - 2]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let e = self.f.expr(E_IMAGE_LOAD, texel, te, 0, a2);\n");
        buf_str(out, c"            self.f.exprs[e].d = n - 1;\n");
        buf_str(out, c"            return val(e, texel);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // the sampling functions\n");
        buf_str(out, c"        if storage {\n");
        buf_str(out, c"            self.fail(at, \"wgsl.type\", \"a storage texture cannot be sampled\");\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let kind = if s == K_TEXTURE_SAMPLE {\n");
        buf_str(out, c"            IMG_SAMPLE\n");
        buf_str(out, c"        } else if s == K_TEXTURE_SAMPLE_BIAS {\n");
        buf_str(out, c"            IMG_SAMPLE_BIAS\n");
        buf_str(out, c"        } else if s == K_TEXTURE_SAMPLE_LEVEL {\n");
        buf_str(out, c"            IMG_SAMPLE_LEVEL\n");
        buf_str(out, c"        } else if s == K_TEXTURE_SAMPLE_COMPARE {\n");
        buf_str(out, c"            IMG_SAMPLE_COMPARE\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            IMG_SAMPLE_COMPARE_LEVEL\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        let compare = kind == IMG_SAMPLE_COMPARE || kind == IMG_SAMPLE_COMPARE_LEVEL;\n");
        buf_str(out, c"        if compare != depth && (compare || kind == IMG_SAMPLE_BIAS) {\n");
        buf_str(out, c"            self.fail(at, \"wgsl.type\",\n");
        buf_str(out, c"                if compare { \"textureSampleCompare takes a texture_depth_2d\" }\n");
        buf_str(out, c"                else { \"textureSampleBias takes a texture_2d<f32>\" });\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if !depth && tt.scalar != SK_F32 {\n");
        buf_str(out, c"            self.fail(at, \"wgsl.type\",\n");
        buf_str(out, c"                \"only f32 textures are sampled; use textureLoad for i32 and u32\");\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if (kind == IMG_SAMPLE || kind == IMG_SAMPLE_BIAS || kind == IMG_SAMPLE_COMPARE)\n");
        buf_str(out, c"            && self.stage != STAGE_FRAGMENT as i64 && self.stage != 255 {\n");
        buf_str(out, c"            if self.err(at, \"wgsl.stage\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"'{name}' computes derivatives: it is for fragment shaders\");\n");
        buf_str(out, c"                self.help(\"use textureSampleLevel elsewhere\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let has_aux = kind != IMG_SAMPLE;\n");
        buf_str(out, c"        let want = 3 + (if arrayed { 1 } else { 0 }) + (if has_aux { 1 } else { 0 });\n");
        buf_str(out, c"        if n != want {\n");
        buf_str(out, c"            self.arg_count_error(at, name, \"a texture, a sampler, coordinates, then a layer for an array texture and the bias, level or depth reference\", n);\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let se = self.texture_arg(base + 1, true);\n");
        buf_str(out, c"        if se < 0 {\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let sm = self.m.types[self.f.exprs[se].ty];\n");
        buf_str(out, c"        if (sm.n == 1) != compare {\n");
        buf_str(out, c"            self.fail(self.apos[base + 1], \"wgsl.type\",\n");
        buf_str(out, c"                if compare { \"comparisons take a sampler_comparison\" }\n");
        buf_str(out, c"                else { \"this takes a sampler, not a sampler_comparison\" });\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var es: [i64; 3] = [0; 3];\n");
        buf_str(out, c"        es[0] = self.materialize(self.astack[base + 2], vec_ty(SK_F32, 2), self.apos[base + 2]);\n");
        buf_str(out, c"        var k = 1;\n");
        buf_str(out, c"        if arrayed {\n");
        buf_str(out, c"            let it = self.int_arg_type(base + 3);\n");
        buf_str(out, c"            es[1] = self.materialize(self.astack[base + 3], it, self.apos[base + 3]);\n");
        buf_str(out, c"            k = 2;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if has_aux {\n");
        buf_str(out, c"            let ai = base + n - 1;\n");
        buf_str(out, c"            let at2 = if kind == IMG_SAMPLE_LEVEL && depth { self.int_arg_type(ai) } else { T_F32 };\n");
        buf_str(out, c"            es[k] = self.materialize(self.astack[ai], at2, self.apos[ai]);\n");
        buf_str(out, c"            k += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let a = self.f.args.len();\n");
        buf_str(out, c"        for i in 0..k {\n");
        buf_str(out, c"            self.f.args.push(es[i]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let e = self.f.expr(E_IMAGE_SAMPLE, texel, te, se, a);\n");
        buf_str(out, c"        self.f.exprs[e].d = kind | (k << 8);\n");
        buf_str(out, c"        val(e, texel)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // vec2<i32> or vec2<u32>, as the argument has it.\n");
        buf_str(out, c"    fn coords_type(inout self, i: i64) -> i64 {\n");
        buf_str(out, c"        let v = self.astack[i];\n");
        buf_str(out, c"        let t = self.concrete_type_of(v);\n");
        buf_str(out, c"        if t == vec_ty(SK_U32, 2) || t == vec_ty(SK_I32, 2) {\n");
        buf_str(out, c"            return t;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.err(self.apos[i], \"wgsl.type\") {\n");
        buf_str(out, c"            self.emsg.push_str(\"texel coordinates are a vec2<i32> or vec2<u32>, not \");\n");
        buf_str(out, c"            self.val_str(v);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        vec_ty(SK_I32, 2)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn int_arg_type(inout self, i: i64) -> i64 {\n");
        buf_str(out, c"        let v = self.astack[i];\n");
        buf_str(out, c"        let t = self.concrete_type_of(v);\n");
        buf_str(out, c"        if t == T_U32 || t == T_I32 {\n");
        buf_str(out, c"            return t;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.err(self.apos[i], \"wgsl.type\") {\n");
        buf_str(out, c"            self.emsg.push_str(\"expected an i32 or a u32, got \");\n");
        buf_str(out, c"            self.val_str(v);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        T_I32\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn math_arity(fun: i64) -> i64 {\n");
        buf_str(out, c"    if fun == ir::MF_MIN || fun == ir::MF_MAX || fun == ir::MF_POW || fun == ir::MF_ATAN2\n");
        buf_str(out, c"        || fun == ir::MF_STEP || fun == MF_DISTANCE || fun == MF_DOT || fun == MF_CROSS\n");
        buf_str(out, c"        || fun == ir::MF_REFLECT || fun == MF_LDEXP {\n");
        buf_str(out, c"        2\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    else if fun == ir::MF_CLAMP || fun == ir::MF_MIX || fun == ir::MF_SMOOTHSTEP\n");
        buf_str(out, c"        || fun == ir::MF_FMA || fun == ir::MF_FACE_FORWARD || fun == MF_EXTRACT_BITS {\n");
        buf_str(out, c"        3\n");
        buf_str(out, c"    } else if fun == MF_INSERT_BITS {\n");
        buf_str(out, c"        4\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn is_float_fun(fun: i64) -> bool {\n");
        buf_str(out, c"    (fun >= ir::MF_FLOOR && fun <= ir::MF_FMA) || fun == MF_LENGTH || fun == MF_DISTANCE\n");
        buf_str(out, c"        || fun == MF_CROSS || fun == ir::MF_NORMALIZE || fun == ir::MF_REFLECT\n");
        buf_str(out, c"        || fun == ir::MF_DEGREES || fun == ir::MF_RADIANS || fun == ir::MF_SATURATE\n");
        buf_str(out, c"        || fun == ir::MF_ASINH || fun == ir::MF_ACOSH || fun == ir::MF_ATANH\n");
        buf_str(out, c"        || fun == ir::MF_FACE_FORWARD\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn is_int_fun(fun: i64) -> bool { fun >= ir::MF_COUNT_ONE_BITS && fun <= MF_INSERT_BITS }\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl::builtins ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::gpu::wgsl::entry ----\n");
        buf_str(out, c"pub mod entry {\n");
        buf_str(out, c"// ---- Shader compiler implementation, entry (0.22) ----\n");
        buf_str(out, c"// Entry-point interfaces: what each stage's parameters and result may be\n");
        buf_str(out, c"// bound to, and with which types (WGSL §\"Entry Point Declaration\").\n");
        buf_str(out, c"\n");
        buf_str(out, c"use front::Front;\n");
        buf_str(out, c"use ir::{\n");
        buf_str(out, c"    BIND_BUILTIN, BIND_LOCATION, BIND_NONE, BI_FRAG_DEPTH, BI_FRONT_FACING, BI_GLOBAL_INVOCATION_ID,\n");
        buf_str(out, c"    BI_INSTANCE_INDEX, BI_LOCAL_INVOCATION_ID, BI_LOCAL_INVOCATION_INDEX, BI_NUM_WORKGROUPS,\n");
        buf_str(out, c"    BI_POSITION, BI_SAMPLE_INDEX, BI_SAMPLE_MASK, BI_VERTEX_INDEX, BI_WORKGROUP_ID, Binding,\n");
        buf_str(out, c"    INTERP_FLAT, SK_BOOL, SK_F32, SK_U32, STAGE_COMPUTE, STAGE_FRAGMENT, STAGE_VERTEX, TK_SCALAR,\n");
        buf_str(out, c"    TK_STRUCT, TK_VECTOR, T_BOOL, T_F32, T_U32, V, vec_ty,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"use std::Vec;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn builtin_name(b: i64) -> [u8] {\n");
        buf_str(out, c"    if b == BI_POSITION {\n");
        buf_str(out, c"        \"position\"\n");
        buf_str(out, c"    } else if b == BI_VERTEX_INDEX {\n");
        buf_str(out, c"        \"vertex_index\"\n");
        buf_str(out, c"    } else if b == BI_INSTANCE_INDEX {\n");
        buf_str(out, c"        \"instance_index\"\n");
        buf_str(out, c"    } else if b == BI_FRONT_FACING {\n");
        buf_str(out, c"        \"front_facing\"\n");
        buf_str(out, c"    } else if b == BI_FRAG_DEPTH {\n");
        buf_str(out, c"        \"frag_depth\"\n");
        buf_str(out, c"    } else if b == BI_SAMPLE_INDEX {\n");
        buf_str(out, c"        \"sample_index\"\n");
        buf_str(out, c"    } else if b == BI_SAMPLE_MASK {\n");
        buf_str(out, c"        \"sample_mask\"\n");
        buf_str(out, c"    } else if b == BI_LOCAL_INVOCATION_ID {\n");
        buf_str(out, c"        \"local_invocation_id\"\n");
        buf_str(out, c"    } else if b == BI_LOCAL_INVOCATION_INDEX {\n");
        buf_str(out, c"        \"local_invocation_index\"\n");
        buf_str(out, c"    } else if b == BI_GLOBAL_INVOCATION_ID {\n");
        buf_str(out, c"        \"global_invocation_id\"\n");
        buf_str(out, c"    } else if b == BI_WORKGROUP_ID {\n");
        buf_str(out, c"        \"workgroup_id\"\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        \"num_workgroups\"\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The type a builtin has.\n");
        buf_str(out, c"pub fn builtin_type(b: i64) -> i64 {\n");
        buf_str(out, c"    if b == BI_POSITION {\n");
        buf_str(out, c"        vec_ty(SK_F32, 4)\n");
        buf_str(out, c"    } else if b == BI_FRONT_FACING {\n");
        buf_str(out, c"        T_BOOL\n");
        buf_str(out, c"    } else if b == BI_FRAG_DEPTH {\n");
        buf_str(out, c"        T_F32\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    else if b == BI_LOCAL_INVOCATION_ID || b == BI_GLOBAL_INVOCATION_ID || b == BI_WORKGROUP_ID\n");
        buf_str(out, c"        || b == BI_NUM_WORKGROUPS {\n");
        buf_str(out, c"        vec_ty(SK_U32, 3)\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        T_U32\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether builtin b may be an input (or, `output`, an output) of stage.\n");
        buf_str(out, c"fn builtin_allowed(b: i64, stage: u8, output: bool) -> bool {\n");
        buf_str(out, c"    if stage == STAGE_COMPUTE {\n");
        buf_str(out, c"        return !output && b >= BI_LOCAL_INVOCATION_ID;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if stage == STAGE_VERTEX {\n");
        buf_str(out, c"        if output {\n");
        buf_str(out, c"            return b == BI_POSITION;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return b == BI_VERTEX_INDEX || b == BI_INSTANCE_INDEX;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if output {\n");
        buf_str(out, c"        return b == BI_FRAG_DEPTH || b == BI_SAMPLE_MASK;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    b == BI_POSITION || b == BI_FRONT_FACING || b == BI_SAMPLE_INDEX || b == BI_SAMPLE_MASK\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"struct Seen { locs: V<i64>, builtins: V<i64>, position: bool }\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn check_binding(fr: inout Front, b: Binding, ty: i64, stage: u8, output: bool, what: [u8],\n");
        buf_str(out, c"    seen: inout Seen) {\n");
        buf_str(out, c"    let at = fr.m.functions[fr.m.entries[fr.m.entries.len() - 1].func].pos;\n");
        buf_str(out, c"    if b.kind == BIND_NONE {\n");
        buf_str(out, c"        if fr.err(at, \"wgsl.entry\") {\n");
        buf_str(out, c"            fr.emsg.push_fmt(f\"{what} of an entry point needs '@location(N)' or '@builtin(NAME)'\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if b.kind == BIND_BUILTIN {\n");
        buf_str(out, c"        if !builtin_allowed(b.value, stage, output) {\n");
        buf_str(out, c"            let io = if output { \"output\" } else { \"input\" };\n");
        buf_str(out, c"            if fr.err(at, \"wgsl.entry\") {\n");
        buf_str(out, c"                fr.emsg.push_fmt(\n");
        buf_str(out, c"                    f\"'@builtin({builtin_name(b.value)})' is not an {io} of a {stage_name(stage)} shader\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if builtin_type(b.value) != ty {\n");
        buf_str(out, c"            if fr.err(at, \"wgsl.entry\") {\n");
        buf_str(out, c"                fr.emsg.push_fmt(f\"'@builtin({builtin_name(b.value)})' has type \");\n");
        buf_str(out, c"                fr.ty_str(builtin_type(b.value));\n");
        buf_str(out, c"                fr.emsg.push_str(\", not \");\n");
        buf_str(out, c"                fr.ty_str(ty);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for i in 0..seen.builtins.len() {\n");
        buf_str(out, c"            if seen.builtins[i] == b.value {\n");
        buf_str(out, c"                if fr.err(at, \"wgsl.entry\") {\n");
        buf_str(out, c"                    fr.emsg.push_fmt(f\"'@builtin({builtin_name(b.value)})' appears twice\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        seen.builtins.push(b.value);\n");
        buf_str(out, c"        if b.value == BI_POSITION {\n");
        buf_str(out, c"            seen.position = true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // a location\n");
        buf_str(out, c"    if stage == STAGE_COMPUTE {\n");
        buf_str(out, c"        if fr.err(at, \"wgsl.entry\") {\n");
        buf_str(out, c"            fr.emsg.push_str(\"a compute shader has no '@location' inputs\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let t = fr.m.types[ty];\n");
        buf_str(out, c"    if (t.kind != TK_SCALAR && t.kind != TK_VECTOR) || t.scalar == SK_BOOL {\n");
        buf_str(out, c"        if fr.err(at, \"wgsl.entry\") {\n");
        buf_str(out, c"            fr.emsg.push_fmt(f\"'@location({b.value})' holds a number or a vector of numbers, not \");\n");
        buf_str(out, c"            fr.ty_str(ty);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let interpolated = (stage == STAGE_VERTEX && output) || (stage == STAGE_FRAGMENT && !output);\n");
        buf_str(out, c"    if interpolated && t.scalar != SK_F32 && b.interp != INTERP_FLAT {\n");
        buf_str(out, c"        if fr.err(at, \"wgsl.entry\") {\n");
        buf_str(out, c"            fr.emsg.push_fmt(\n");
        buf_str(out, c"                f\"'@location({b.value})' is an integer: it needs '@interpolate(flat)'\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for i in 0..seen.locs.len() {\n");
        buf_str(out, c"        if seen.locs[i] == b.value {\n");
        buf_str(out, c"            if fr.err(at, \"wgsl.entry\") {\n");
        buf_str(out, c"                fr.emsg.push_fmt(f\"'@location({b.value})' appears twice\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    seen.locs.push(b.value);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn stage_name(s: u8) -> [u8] {\n");
        buf_str(out, c"    if s == STAGE_VERTEX {\n");
        buf_str(out, c"        \"vertex\"\n");
        buf_str(out, c"    } else if s == STAGE_FRAGMENT {\n");
        buf_str(out, c"        \"fragment\"\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        \"compute\"\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A parameter or result: a bound value, or a struct of bound members.\n");
        buf_str(out, c"fn check_io(fr: inout Front, b: Binding, ty: i64, stage: u8, output: bool, what: [u8],\n");
        buf_str(out, c"    seen: inout Seen) {\n");
        buf_str(out, c"    let t = fr.m.types[ty];\n");
        buf_str(out, c"    if t.kind == TK_STRUCT && b.kind == BIND_NONE {\n");
        buf_str(out, c"        for i in t.mstart..t.mstart + t.mcount {\n");
        buf_str(out, c"            let mem = fr.m.members[i];\n");
        buf_str(out, c"            if fr.m.types[mem.ty].kind == TK_STRUCT {\n");
        buf_str(out, c"                let at = fr.m.functions[fr.m.entries[fr.m.entries.len() - 1].func].pos;\n");
        buf_str(out, c"                fr.fail(at, \"wgsl.entry\", \"an entry point's IO struct cannot nest structs\");\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            check_binding(&fr, mem.binding, mem.ty, stage, output, \"a member of an IO struct\",\n");
        buf_str(out, c"                &seen);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    check_binding(&fr, b, ty, stage, output, what, &seen);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn check_interface(fr: inout Front, ei: i64) {\n");
        buf_str(out, c"    let stage = fr.m.entries[ei].stage;\n");
        buf_str(out, c"    let fh = fr.m.entries[ei].func;\n");
        buf_str(out, c"    let pos = fr.m.functions[fh].pos;\n");
        buf_str(out, c"    var ins = Seen { locs: Vec::new_in(fr.a), builtins: Vec::new_in(fr.a), position: false };\n");
        buf_str(out, c"    for i in 0..fr.m.functions[fh].params.len() {\n");
        buf_str(out, c"        let b = fr.m.functions[fh].params[i].binding;\n");
        buf_str(out, c"        let t = fr.m.functions[fh].params[i].ty;\n");
        buf_str(out, c"        check_io(&fr, b, t, stage, false, \"a parameter\", &ins);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var outs = Seen { locs: Vec::new_in(fr.a), builtins: Vec::new_in(fr.a), position: false };\n");
        buf_str(out, c"    let result = fr.m.functions[fh].result;\n");
        buf_str(out, c"    if result >= 0 {\n");
        buf_str(out, c"        if stage == STAGE_COMPUTE {\n");
        buf_str(out, c"            fr.fail(pos, \"wgsl.entry\", \"a compute shader returns nothing\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let rb = fr.m.functions[fh].result_binding;\n");
        buf_str(out, c"        check_io(&fr, rb, result, stage, true, \"the result\", &outs);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if stage == STAGE_VERTEX && !outs.position && !fr.failed {\n");
        buf_str(out, c"        fr.fail(pos, \"wgsl.entry\", \"a vertex shader returns '@builtin(position)' (a vec4<f32>)\");\n");
        buf_str(out, c"        fr.help(\"for example: fn vs(...) -> @builtin(position) vec4<f32>\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl::entry ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::gpu::wgsl::bounds ----\n");
        buf_str(out, c"pub mod bounds {\n");
        buf_str(out, c"// ---- Shader compiler implementation, bounds (0.22) ----\n");
        buf_str(out, c"// Bounds checks (D15: no undefined behaviour in shaders). Every E_ACCESS\n");
        buf_str(out, c"// gets its check: a clamp for vectors, matrices and fixed-size arrays\n");
        buf_str(out, c"// (naga's Restrict), read-zero-skip-write for runtime-sized arrays. A\n");
        buf_str(out, c"// check is dropped only where a dominating comparison proves the index in\n");
        buf_str(out, c"// range: the head of a counted loop, `for (var i = 0u; i < N; i++)`,\n");
        buf_str(out, c"// whose body indexes something of length N or more with `i`.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use ir::{\n");
        buf_str(out, c"    CK_CLAMP, CK_NONE, CK_PENDING, CK_RZSW, E_ACCESS, E_BINARY, E_LITERAL, E_LOAD, E_LOCAL,\n");
        buf_str(out, c"    Function, Module, OP_LT, S_BLOCK, S_BREAK, S_CALL, S_EMIT, S_IF, S_LOOP, S_STORE, S_SWITCH,\n");
        buf_str(out, c"    TK_ARRAY, TK_POINTER, T_I32, T_U32, V,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"use std::{ScopedArena, Vec};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A fact: local `l` is below `n` (and not negative) while it holds.\n");
        buf_str(out, c"struct Fact { local: i64, n: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn insert_checks(m: inout Module, a: ScopedArena, prove: bool) {\n");
        buf_str(out, c"    for h in 0..m.functions.len() {\n");
        buf_str(out, c"        var f = std::replace(&m.functions[h], ir::new_function(\"\", m.a));\n");
        buf_str(out, c"        for e in 0..f.exprs.len() {\n");
        buf_str(out, c"            let x = f.exprs[e];\n");
        buf_str(out, c"            if x.op != E_ACCESS || x.c != CK_PENDING {\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let bt0 = f.exprs[x.a].ty;\n");
        buf_str(out, c"            let bt = if m.types[bt0].kind == TK_POINTER { m.types[bt0].base } else { bt0 };\n");
        buf_str(out, c"            let t = m.types[bt];\n");
        buf_str(out, c"            if t.kind == TK_ARRAY && t.n == 0 {\n");
        buf_str(out, c"                f.exprs[e].c = CK_RZSW;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                f.exprs[e].c = CK_CLAMP;\n");
        buf_str(out, c"                f.exprs[e].d = t.n;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if prove && f.body >= 0 {\n");
        buf_str(out, c"            var facts: V<Fact> = Vec::new_in(a);\n");
        buf_str(out, c"            prove_block(m, &f, f.body, &facts);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        m.functions[h] = f;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var c = std::replace(&m.consts, ir::new_function(\"\", m.a));\n");
        buf_str(out, c"    for e in 0..c.exprs.len() {\n");
        buf_str(out, c"        if c.exprs[e].op == E_ACCESS && c.exprs[e].c == CK_PENDING {\n");
        buf_str(out, c"            c.exprs[e].c = CK_CLAMP;\n");
        buf_str(out, c"            c.exprs[e].d = m.types[c.exprs[c.exprs[e].a].ty].n;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    m.consts = c;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The local an expression loads, or -1.\n");
        buf_str(out, c"fn loaded_local(f: Function, e: i64) -> i64 {\n");
        buf_str(out, c"    let x = f.exprs[e];\n");
        buf_str(out, c"    if x.op == E_LOAD && f.exprs[x.a].op == E_LOCAL {\n");
        buf_str(out, c"        return f.exprs[x.a].a;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    -1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether the block (or what it calls) may store to local l.\n");
        buf_str(out, c"fn stores_local(f: Function, blk: i64, l: i64) -> bool {\n");
        buf_str(out, c"    let b = f.blocks[blk];\n");
        buf_str(out, c"    for i in b.start..b.start + b.count {\n");
        buf_str(out, c"        let st = f.stmts[f.items[i]];\n");
        buf_str(out, c"        if st.op == S_STORE {\n");
        buf_str(out, c"            let p = f.exprs[st.a];\n");
        buf_str(out, c"            // a store through any pointer derived from the local\n");
        buf_str(out, c"            if p.op == E_LOCAL && p.a == l {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if p.op != E_LOCAL && reaches_local(f, st.a, l) {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if st.op == S_CALL {\n");
        buf_str(out, c"            // a pointer to the local passed to a function\n");
        buf_str(out, c"            for k in st.b..st.b + st.c {\n");
        buf_str(out, c"                if reaches_local(f, f.args[k], l) {\n");
        buf_str(out, c"                    return true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if st.op == S_BLOCK {\n");
        buf_str(out, c"            if stores_local(f, st.a, l) {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if st.op == S_IF {\n");
        buf_str(out, c"            if stores_local(f, st.b, l) || stores_local(f, st.c, l) {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if st.op == S_SWITCH {\n");
        buf_str(out, c"            for k in st.b..st.b + st.c {\n");
        buf_str(out, c"                if stores_local(f, f.cases[k].body, l) {\n");
        buf_str(out, c"                    return true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if st.op == S_LOOP {\n");
        buf_str(out, c"            if stores_local(f, st.a, l) || stores_local(f, st.b, l) {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if st.op == ir::S_ATOMIC {\n");
        buf_str(out, c"            if reaches_local(f, st.a, l) {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    false\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether pointer expression e is local l or derived from it.\n");
        buf_str(out, c"fn reaches_local(f: Function, e: i64, l: i64) -> bool {\n");
        buf_str(out, c"    let x = f.exprs[e];\n");
        buf_str(out, c"    if x.op == E_LOCAL {\n");
        buf_str(out, c"        return x.a == l;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if x.op == E_ACCESS || x.op == ir::E_ACCESS_INDEX {\n");
        buf_str(out, c"        return reaches_local(f, x.a, l);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    false\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The facts the head of a loop body establishes: `if (load(l) < N) {}\n");
        buf_str(out, c"// else { break; }`, with l an unsigned local or a signed one that starts\n");
        buf_str(out, c"// at a non-negative value and is only increased (checked by the caller).\n");
        buf_str(out, c"fn head_fact(m: Module, f: Function, body: i64) -> Fact {\n");
        buf_str(out, c"    let b = f.blocks[body];\n");
        buf_str(out, c"    let none = Fact { local: -1, n: 0 };\n");
        buf_str(out, c"    for i in b.start..b.start + b.count {\n");
        buf_str(out, c"        let st = f.stmts[f.items[i]];\n");
        buf_str(out, c"        if st.op == S_EMIT {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if st.op != S_IF {\n");
        buf_str(out, c"            return none;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let then_b = f.blocks[st.b];\n");
        buf_str(out, c"        let else_b = f.blocks[st.c];\n");
        buf_str(out, c"        if then_b.count != 0 || else_b.count != 1 || f.stmts[f.items[else_b.start]].op != S_BREAK {\n");
        buf_str(out, c"            return none;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let c = f.exprs[st.a];\n");
        buf_str(out, c"        if c.op != E_BINARY || c.a != OP_LT {\n");
        buf_str(out, c"            return none;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let l = loaded_local(f, c.b);\n");
        buf_str(out, c"        let lim = f.exprs[c.c];\n");
        buf_str(out, c"        if l < 0 || lim.op != E_LITERAL {\n");
        buf_str(out, c"            return none;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let lt = f.locals[l].ty;\n");
        buf_str(out, c"        if lt != T_U32 && lt != T_I32 {\n");
        buf_str(out, c"            return none;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let n = if lt == T_I32 { lim.a as u32 as i32 as i64 } else { lim.a };\n");
        buf_str(out, c"        if n <= 0 {\n");
        buf_str(out, c"            return none;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return Fact { local: l, n: n };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    none\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether local l (an i32) is never negative at the loop: it was stored a\n");
        buf_str(out, c"// non-negative literal just before the loop, and the loop's continuing\n");
        buf_str(out, c"// block only adds a positive literal to it.\n");
        buf_str(out, c"fn nonneg_counter(f: Function, items: V<i64>, pos: i64, l: i64, cont: i64, n: i64) -> bool {\n");
        buf_str(out, c"    // the statement before the loop (skipping emits) stores a literal\n");
        buf_str(out, c"    var k = pos - 1;\n");
        buf_str(out, c"    var ok = false;\n");
        buf_str(out, c"    while k >= 0 {\n");
        buf_str(out, c"        let st = f.stmts[items[k]];\n");
        buf_str(out, c"        if st.op == S_EMIT {\n");
        buf_str(out, c"            k -= 1;\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if st.op == S_STORE && f.exprs[st.a].op == E_LOCAL && f.exprs[st.a].a == l {\n");
        buf_str(out, c"            let v = f.exprs[st.b];\n");
        buf_str(out, c"            ok = v.op == E_LITERAL && (v.a as u32 as i32) >= 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        break;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if !ok {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // continuing: only `l = load(l) + positive literal`\n");
        buf_str(out, c"    let cb = f.blocks[cont];\n");
        buf_str(out, c"    for i in cb.start..cb.start + cb.count {\n");
        buf_str(out, c"        let st = f.stmts[f.items[i]];\n");
        buf_str(out, c"        if st.op == S_STORE && reaches_local(f, st.a, l) {\n");
        buf_str(out, c"            let v = f.exprs[st.b];\n");
        buf_str(out, c"            if v.op != E_BINARY || v.a != ir::OP_ADD || loaded_local(f, v.b) != l {\n");
        buf_str(out, c"                return false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let inc = f.exprs[v.c];\n");
        buf_str(out, c"            // positive, and i + inc cannot wrap past i32's top while i < n\n");
        buf_str(out, c"            if inc.op != E_LITERAL || (inc.a as u32 as i32) <= 0\n");
        buf_str(out, c"                || n + (inc.a as u32 as i32) as i64 > 2147483647 {\n");
        buf_str(out, c"                return false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if st.op != S_EMIT {\n");
        buf_str(out, c"            if st.op == S_CALL || st.op == S_BLOCK || st.op == S_IF || st.op == S_LOOP\n");
        buf_str(out, c"                || st.op == S_SWITCH {\n");
        buf_str(out, c"                if stores_local(f, cont, l) {\n");
        buf_str(out, c"                    return false;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    true\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn prove_block(m: Module, f: inout Function, blk: i64, facts: inout V<Fact>) {\n");
        buf_str(out, c"    let b = f.blocks[blk];\n");
        buf_str(out, c"    // the block's items, so nonneg_counter can look back\n");
        buf_str(out, c"    var items: V<i64> = Vec::new_in(f.items.allocator());\n");
        buf_str(out, c"    for i in b.start..b.start + b.count {\n");
        buf_str(out, c"        items.push(f.items[i]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for i in 0..items.len() {\n");
        buf_str(out, c"        let s = items[i];\n");
        buf_str(out, c"        let st = f.stmts[s];\n");
        buf_str(out, c"        if st.op == S_EMIT {\n");
        buf_str(out, c"            for e in st.a..st.b {\n");
        buf_str(out, c"                prove_expr(m, &f, e, facts);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if st.op == S_BLOCK {\n");
        buf_str(out, c"            prove_block(m, &f, st.a, &facts);\n");
        buf_str(out, c"        } else if st.op == S_IF {\n");
        buf_str(out, c"            prove_block(m, &f, st.b, &facts);\n");
        buf_str(out, c"            prove_block(m, &f, st.c, &facts);\n");
        buf_str(out, c"        } else if st.op == S_SWITCH {\n");
        buf_str(out, c"            for k in st.b..st.b + st.c {\n");
        buf_str(out, c"                prove_block(m, &f, f.cases[k].body, &facts);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if st.op == S_LOOP {\n");
        buf_str(out, c"            let base = facts.len();\n");
        buf_str(out, c"            // facts from outside the loop hold inside only when it keeps them\n");
        buf_str(out, c"            var kept = 0;\n");
        buf_str(out, c"            for k in 0..base {\n");
        buf_str(out, c"                if !stores_local(f, st.a, facts[k].local)\n");
        buf_str(out, c"                    && !stores_local(f, st.b, facts[k].local) {\n");
        buf_str(out, c"                    kept += 1;\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    facts[k].n = -facts[k].n - 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let _ = kept;\n");
        buf_str(out, c"            let fact = head_fact(m, f, st.a);\n");
        buf_str(out, c"            var added = false;\n");
        buf_str(out, c"            if fact.local >= 0 && !stores_local(f, st.a, fact.local) {\n");
        buf_str(out, c"                let lt = f.locals[fact.local].ty;\n");
        buf_str(out, c"                if lt == T_U32 || nonneg_counter(f, items, i, fact.local, st.b, fact.n) {\n");
        buf_str(out, c"                    facts.push(fact);\n");
        buf_str(out, c"                    added = true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            prove_block(m, &f, st.a, &facts);\n");
        buf_str(out, c"            if added {\n");
        buf_str(out, c"                facts.truncate(base);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            prove_block(m, &f, st.b, &facts);\n");
        buf_str(out, c"            for k in 0..base {\n");
        buf_str(out, c"                if facts[k].n < 0 {\n");
        buf_str(out, c"                    facts[k].n = -facts[k].n - 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn prove_expr(m: Module, f: inout Function, e: i64, facts: V<Fact>) {\n");
        buf_str(out, c"    let x = f.exprs[e];\n");
        buf_str(out, c"    if x.op != E_ACCESS || x.c != CK_CLAMP {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let l = loaded_local(f, x.b);\n");
        buf_str(out, c"    if l < 0 {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for k in 0..facts.len() {\n");
        buf_str(out, c"        if facts[k].local == l && facts[k].n > 0 && facts[k].n <= x.d {\n");
        buf_str(out, c"            f.exprs[e].c = CK_NONE;\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Bench only: every check off (CK_NONE), to measure what checks cost.\n");
        buf_str(out, c"pub fn insert_no_checks(m: inout Module) {\n");
        buf_str(out, c"    for h in 0..m.functions.len() {\n");
        buf_str(out, c"        var f = std::replace(&m.functions[h], ir::new_function(\"\", m.a));\n");
        buf_str(out, c"        for e in 0..f.exprs.len() {\n");
        buf_str(out, c"            if f.exprs[e].op == E_ACCESS {\n");
        buf_str(out, c"                f.exprs[e].c = CK_NONE;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        m.functions[h] = f;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl::bounds ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::gpu::wgsl::uniformity ----\n");
        buf_str(out, c"pub mod uniformity {\n");
        buf_str(out, c"// ---- Shader compiler implementation, uniformity (0.22) ----\n");
        buf_str(out, c"// The uniformity analysis.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use front::Front;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn check(fr: Front) {\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl::uniformity ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::gpu::wgsl::msl ----\n");
        buf_str(out, c"pub mod msl {\n");
        buf_str(out, c"// ---- Shader compiler implementation, msl (0.22) ----\n");
        buf_str(out, c"// The MSL writer (docs/design/gpu.md §2.10): MSL 3.0 text for Metal's\n");
        buf_str(out, c"// run-time compiler, with WGSL's semantics kept where MSL's differ.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// - Layout: structs get explicit padding and `packed_` vec3 members, so\n");
        buf_str(out, c"//   every struct has WGSL's offsets and size; fixed-size arrays are\n");
        buf_str(out, c"//   wrapped in a struct (`_w_arrN { T inner[N]; }`) to be values.\n");
        buf_str(out, c"// - No undefined behaviour: signed + - * and negation go through uint;\n");
        buf_str(out, c"//   integer / and % through helpers (by zero, MIN / -1); shift amounts are\n");
        buf_str(out, c"//   masked; float to int conversions saturate; every index is clamped or,\n");
        buf_str(out, c"//   for runtime-sized arrays, guarded against the binding's size from the\n");
        buf_str(out, c"//   hidden sizes buffer (`[[buffer(30)]]`).\n");
        buf_str(out, c"// - Bindings: buffers take slots 0.. in declaration order, textures and\n");
        buf_str(out, c"//   samplers theirs; `reflect` gives the slots.\n");
        buf_str(out, c"// - Values: an expression is written where it is used, except loads,\n");
        buf_str(out, c"//   results, `let`s and those used more than once, which get a name where\n");
        buf_str(out, c"//   they are evaluated (their S_EMIT).\n");
        buf_str(out, c"\n");
        buf_str(out, c"use entry::builtin_name;\n");
        buf_str(out, c"use ir::{\n");
        buf_str(out, c"    ACC_WRITE, AT_ADD, AT_AND, AT_CMPXCHG, AT_EXCHANGE, AT_LOAD, AT_MAX, AT_MIN, AT_OR, AT_STORE,\n");
        buf_str(out, c"    AT_SUB, AT_XOR, BARRIER_WORKGROUP, BIND_BUILTIN, BIND_LOCATION, BI_FRAG_DEPTH, BI_FRONT_FACING,\n");
        buf_str(out, c"    BI_GLOBAL_INVOCATION_ID, BI_INSTANCE_INDEX, BI_LOCAL_INVOCATION_ID, BI_LOCAL_INVOCATION_INDEX,\n");
        buf_str(out, c"    BI_NUM_WORKGROUPS, BI_POSITION, BI_SAMPLE_INDEX, BI_SAMPLE_MASK, BI_VERTEX_INDEX,\n");
        buf_str(out, c"    BI_WORKGROUP_ID, Binding, CK_CLAMP, CK_RZSW, E_ACCESS, E_ACCESS_INDEX, E_ARG, E_ARRAY_LENGTH,\n");
        buf_str(out, c"    E_ATOMIC_RESULT, E_BINARY, E_BITCAST, E_CALL_RESULT, E_COMPOSE, E_CONVERT, E_DERIVATIVE,\n");
        buf_str(out, c"    E_GLOBAL, E_IMAGE_LOAD, E_IMAGE_QUERY, E_IMAGE_SAMPLE, E_LITERAL, E_LOAD, E_LOCAL, E_MATH,\n");
        buf_str(out, c"    E_SELECT, E_SPLAT, E_SWIZZLE, E_UNARY, E_WG_UNIFORM_RESULT, E_ZERO, Function, IMG_SAMPLE_BIAS,\n");
        buf_str(out, c"    IMG_SAMPLE_COMPARE, IMG_SAMPLE_COMPARE_LEVEL, IMG_SAMPLE_LEVEL, INTERP_FLAT, INTERP_LINEAR,\n");
        buf_str(out, c"    IQ_LAYERS, IQ_LEVELS, Module, OP_ADD, OP_AND, OP_DIV, OP_EQ, OP_GE, OP_GT, OP_LAND, OP_LE,\n");
        buf_str(out, c"    OP_LOR, OP_LT, OP_MOD, OP_MUL, OP_NE, OP_OR, OP_SHL, OP_SHR, OP_SUB, OP_XOR, SK_BOOL, SK_F32,\n");
        buf_str(out, c"    SK_I32, SK_U32, SP_FUNCTION, SP_HANDLE, SP_PRIVATE, SP_STORAGE, SP_UNIFORM, SP_WORKGROUP,\n");
        buf_str(out, c"    STAGE_COMPUTE, STAGE_FRAGMENT, STAGE_VERTEX, S_ATOMIC, S_BARRIER, S_BLOCK, S_BREAK, S_CALL,\n");
        buf_str(out, c"    S_CONTINUE, S_EMIT, S_IF, S_IMAGE_STORE, S_KILL, S_LOOP, S_RETURN, S_STORE, S_SWITCH,\n");
        buf_str(out, c"    S_WG_UNIFORM_LOAD, TEX_2D_ARRAY, TEX_DEPTH_2D, TEX_STORAGE_2D, TK_ARRAY, TK_ATOMIC, TK_MATRIX,\n");
        buf_str(out, c"    TK_POINTER, TK_SAMPLER, TK_SCALAR, TK_STRUCT, TK_TEXTURE, TK_VECTOR, Type, UN_BITNOT, UN_NEG,\n");
        buf_str(out, c"    UN_NOT, V, bits_f32,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"use std::{Allocator, Buf, Clone, ScopedArena, Vec};\n");
        buf_str(out, c"\n");
        buf_str(out, c"const RESERVED: [[u8]; 103] = [\n");
        buf_str(out, c"    \"main\", \"kernel\", \"vertex\", \"fragment\", \"device\", \"constant\", \"thread\", \"threadgroup\",\n");
        buf_str(out, c"    \"threadgroup_imageblock\", \"ray_data\", \"object_data\", \"metal\", \"using\", \"namespace\",\n");
        buf_str(out, c"    \"template\", \"typename\", \"class\", \"struct\", \"union\", \"enum\", \"public\", \"private\", \"protected\",\n");
        buf_str(out, c"    \"virtual\", \"operator\", \"new\", \"delete\", \"this\", \"auto\", \"register\", \"static\", \"extern\",\n");
        buf_str(out, c"    \"inline\", \"volatile\", \"const\", \"constexpr\", \"explicit\", \"friend\", \"mutable\", \"goto\",\n");
        buf_str(out, c"    \"sizeof\", \"typedef\", \"typeid\", \"signed\", \"unsigned\", \"short\", \"long\", \"int\", \"uint\", \"char\",\n");
        buf_str(out, c"    \"uchar\", \"float\", \"half\", \"double\", \"bool\", \"void\", \"true\", \"false\", \"nullptr\", \"do\",\n");
        buf_str(out, c"    \"while\", \"for\", \"if\", \"else\", \"switch\", \"case\", \"default\", \"break\", \"continue\", \"return\",\n");
        buf_str(out, c"    \"try\", \"catch\", \"throw\", \"and\", \"or\", \"not\", \"xor\", \"bitand\", \"bitor\", \"compl\", \"not_eq\",\n");
        buf_str(out, c"    \"and_eq\", \"or_eq\", \"xor_eq\", \"asm\", \"export\", \"alignas\", \"alignof\", \"decltype\", \"noexcept\",\n");
        buf_str(out, c"    \"static_assert\", \"static_cast\", \"dynamic_cast\", \"const_cast\", \"reinterpret_cast\", \"wchar_t\",\n");
        buf_str(out, c"    \"char16_t\", \"char32_t\", \"int8_t\", \"uint8_t\", \"int16_t\", \"size_t\", \"ptrdiff_t\",\n");
        buf_str(out, c"];\n");
        buf_str(out, c"\n");
        buf_str(out, c"const MATH_NAMES: [[u8]; 39] = [\n");
        buf_str(out, c"    \"abs\", \"min\", \"max\", \"clamp\", \"sign\", \"floor\", \"ceil\", \"rint\", \"fract\", \"trunc\", \"sqrt\",\n");
        buf_str(out, c"    \"rsqrt\", \"exp\", \"exp2\", \"log\", \"log2\", \"pow\", \"sin\", \"cos\", \"tan\", \"asin\", \"acos\", \"atan\",\n");
        buf_str(out, c"    \"atan2\", \"sinh\", \"cosh\", \"tanh\", \"mix\", \"step\", \"smoothstep\", \"fma\", \"length\", \"distance\",\n");
        buf_str(out, c"    \"dot\", \"cross\", \"normalize\", \"reflect\", \"determinant\", \"transpose\",\n");
        buf_str(out, c"];\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Where the resources are bound. Per stage (vertex, fragment, compute),\n");
        buf_str(out, c"// buffers, textures and samplers each take slots from 0 in (group,\n");
        buf_str(out, c"// binding) order over the bindings the stage's entry points use; the\n");
        buf_str(out, c"// Metal hal binds what the reflection says. The sizes buffer (the byte\n");
        buf_str(out, c"// sizes of the runtime-sized storage buffers, for bounds checks) takes the\n");
        buf_str(out, c"// stage's next buffer slot; it has one u32 per runtime-sized storage\n");
        buf_str(out, c"// binding of the module, in (group, binding) order.\n");
        buf_str(out, c"pub struct Slots {\n");
        buf_str(out, c"    // slot[stage * globals + g], or -1\n");
        buf_str(out, c"    slot: V<i64>,\n");
        buf_str(out, c"    // per global: its index in the sizes buffer, or -1\n");
        buf_str(out, c"    size_index: V<i64>,\n");
        buf_str(out, c"    sizes_count: i64,\n");
        buf_str(out, c"    // per stage: the sizes buffer's slot, or -1 when the stage needs none\n");
        buf_str(out, c"    sizes_slot: [i64; 3],\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The globals in (group, binding) order (the others after, as declared).\n");
        buf_str(out, c"pub fn binding_order(m: Module, a: ScopedArena) -> V<i64> {\n");
        buf_str(out, c"    var order: V<i64> = Vec::new_in(a);\n");
        buf_str(out, c"    for g in 0..m.globals.len() {\n");
        buf_str(out, c"        order.push(g);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // an insertion sort: modules have few bindings\n");
        buf_str(out, c"    for i in 1..order.len() {\n");
        buf_str(out, c"        var j = i;\n");
        buf_str(out, c"        while j > 0 && binding_key(m, order[j - 1]) > binding_key(m, order[j]) {\n");
        buf_str(out, c"            order.swap(j - 1, j);\n");
        buf_str(out, c"            j -= 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    order\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn binding_key(m: Module, g: i64) -> i64 {\n");
        buf_str(out, c"    let gl = m.globals[g];\n");
        buf_str(out, c"    if gl.group < 0 {\n");
        buf_str(out, c"        return 9223372036854775807 - (m.globals.len() - g);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    gl.group * 1048576 + gl.binding\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn slots(m: Module, uses: V<V<bool>>, a: ScopedArena) -> Slots {\n");
        buf_str(out, c"    let ng = m.globals.len();\n");
        buf_str(out, c"    var s = Slots {\n");
        buf_str(out, c"        slot: Vec::filled_in(3 * ng, -1, a), size_index: Vec::filled_in(ng, -1, a), sizes_count: 0,\n");
        buf_str(out, c"        sizes_slot: [-1, -1, -1]\n");
        buf_str(out, c"    };\n");
        buf_str(out, c"    let order = binding_order(m, a);\n");
        buf_str(out, c"    for k in 0..order.len() {\n");
        buf_str(out, c"        let g = order[k];\n");
        buf_str(out, c"        if m.globals[g].space == SP_STORAGE && m.is_runtime_sized(m.globals[g].ty) {\n");
        buf_str(out, c"            s.size_index[g] = s.sizes_count;\n");
        buf_str(out, c"            s.sizes_count += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for st in 0..3 {\n");
        buf_str(out, c"        var visible: V<bool> = Vec::filled_in(ng, false, a);\n");
        buf_str(out, c"        for e in 0..m.entries.len() {\n");
        buf_str(out, c"            if m.entries[e].stage as i64 == st {\n");
        buf_str(out, c"                let h = m.entries[e].func;\n");
        buf_str(out, c"                for g in 0..ng {\n");
        buf_str(out, c"                    if uses[h][g] {\n");
        buf_str(out, c"                        visible[g] = true;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var nb = 0;\n");
        buf_str(out, c"        var nt = 0;\n");
        buf_str(out, c"        var ns = 0;\n");
        buf_str(out, c"        var sized = false;\n");
        buf_str(out, c"        for k in 0..order.len() {\n");
        buf_str(out, c"            let g = order[k];\n");
        buf_str(out, c"            if !visible[g] {\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let gl = m.globals[g];\n");
        buf_str(out, c"            let kind = m.types[gl.ty].kind;\n");
        buf_str(out, c"            if gl.space == SP_UNIFORM || gl.space == SP_STORAGE {\n");
        buf_str(out, c"                s.slot[st * ng + g] = nb;\n");
        buf_str(out, c"                nb += 1;\n");
        buf_str(out, c"                if s.size_index[g] >= 0 {\n");
        buf_str(out, c"                    sized = true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else if kind == TK_TEXTURE {\n");
        buf_str(out, c"                s.slot[st * ng + g] = nt;\n");
        buf_str(out, c"                nt += 1;\n");
        buf_str(out, c"            } else if kind == TK_SAMPLER {\n");
        buf_str(out, c"                s.slot[st * ng + g] = ns;\n");
        buf_str(out, c"                ns += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if sized {\n");
        buf_str(out, c"            s.sizes_slot[st] = nb;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    s\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A name the writer made: text in its pool (W.pool).\n");
        buf_str(out, c"#[derive(Clone)]\n");
        buf_str(out, c"struct Nm { start: i64, len: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn nm(pool: Buf<ScopedArena>, n: Nm) -> [u8] { pool.as_slice()[n.start..n.start + n.len] }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Appends s's bytes. (A Buf<ScopedArena> holds a view, of its arena, so\n");
        buf_str(out, c"// the checker takes `dst.push_str(local.as_slice())` into a field as\n");
        buf_str(out, c"// keeping a view of `local`; bytes pushed one by one are plain values.)\n");
        buf_str(out, c"fn copy_into(dst: inout Buf<ScopedArena>, s: [u8]) {\n");
        buf_str(out, c"    for i in 0..s.len {\n");
        buf_str(out, c"        dst.push(s[i]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"struct W {\n");
        buf_str(out, c"    a: ScopedArena,\n");
        buf_str(out, c"    out: Buf<ScopedArena>,\n");
        buf_str(out, c"    // the text of every name the writer made\n");
        buf_str(out, c"    pool: Buf<ScopedArena>,\n");
        buf_str(out, c"    // the types' MSL names, made on first use\n");
        buf_str(out, c"    tname: V<Nm>,\n");
        buf_str(out, c"    tdone: V<bool>,\n");
        buf_str(out, c"    types_out: Buf<ScopedArena>,\n");
        buf_str(out, c"    // helpers used\n");
        buf_str(out, c"    need_div: bool,\n");
        buf_str(out, c"    need_f2i: bool,\n");
        buf_str(out, c"    need_sign: bool,\n");
        buf_str(out, c"    need_flb: bool,\n");
        buf_str(out, c"    need_ftb: bool,\n");
        buf_str(out, c"    need_cmpxchg: V<Nm>,\n");
        buf_str(out, c"    sl: Slots,\n");
        buf_str(out, c"    // per function: the globals it uses (directly or through calls)\n");
        buf_str(out, c"    uses: V<V<bool>>,\n");
        buf_str(out, c"    fnames: V<Nm>,\n");
        buf_str(out, c"    gnames: V<Nm>,\n");
        buf_str(out, c"    // the function being written\n");
        buf_str(out, c"    fh: i64,\n");
        buf_str(out, c"    refc: V<i64>,\n");
        buf_str(out, c"    baked: V<bool>,\n");
        buf_str(out, c"    // a name per local, parameter and baked expression of the function\n");
        buf_str(out, c"    lnames: V<Nm>,\n");
        buf_str(out, c"    enames: V<Nm>,\n");
        buf_str(out, c"    used: V<Nm>,\n");
        buf_str(out, c"    indent: i64,\n");
        buf_str(out, c"    loop_n: i64,\n");
        buf_str(out, c"    // entry points: the stage being written (255: a plain function), and\n");
        buf_str(out, c"    // its output struct's name\n");
        buf_str(out, c"    stage: i64,\n");
        buf_str(out, c"    out_name: Nm,\n");
        buf_str(out, c"    ret_ty: i64,\n");
        buf_str(out, c"    // each type's kind\n");
        buf_str(out, c"    kinds: V<u8>,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn is_reserved(s: [u8]) -> bool {\n");
        buf_str(out, c"    for i in 0..RESERVED.len() {\n");
        buf_str(out, c"        if RESERVED[i] == s {\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    false\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl W {\n");
        buf_str(out, c"    fn p(inout self, s: [u8]) { self.out.push_str(s); }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A pooled name into the output.\n");
        buf_str(out, c"    fn pn(inout self, n: Nm) { self.out.push_str(nm(self.pool, n)); }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A type's name into the output.\n");
        buf_str(out, c"    fn pty(inout self, m: Module, t: i64) {\n");
        buf_str(out, c"        let n = self.ty(m, t);\n");
        buf_str(out, c"        self.pn(n);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn s(self, n: Nm) -> [u8] { nm(self.pool, n) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Text into the pool: a name.\n");
        buf_str(out, c"    fn intern(inout self, s: [u8]) -> Nm {\n");
        buf_str(out, c"        let st = self.pool.len();\n");
        buf_str(out, c"        copy_into(&self.pool, s);\n");
        buf_str(out, c"        Nm { start: st, len: s.len }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The pool's text from `st` on, as a name.\n");
        buf_str(out, c"    fn since(self, st: i64) -> Nm { Nm { start: st, len: self.pool.len() - st } }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn line(inout self) {\n");
        buf_str(out, c"        self.out.push('\\n');\n");
        buf_str(out, c"        for _ in 0..self.indent {\n");
        buf_str(out, c"            self.out.push_str(\"    \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A WGSL identifier as an MSL one: reserved words get a `_`, names\n");
        buf_str(out, c"    // starting with `_` a `u` (the writer's own names start with `_`).\n");
        buf_str(out, c"    fn escape(inout self, s: [u8]) -> Nm {\n");
        buf_str(out, c"        if s.len == 0 {\n");
        buf_str(out, c"            return self.intern(\"_w_t\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let st = self.pool.len();\n");
        buf_str(out, c"        if s[0] == '_' {\n");
        buf_str(out, c"            self.pool.push('u');\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        copy_into(&self.pool, s);\n");
        buf_str(out, c"        if is_reserved(s) || s.len > 3 && s[0..3] == \"_w_\" {\n");
        buf_str(out, c"            self.pool.push('_');\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.since(st)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn is_used(self, n: Nm) -> bool {\n");
        buf_str(out, c"        let t = nm(self.pool, n);\n");
        buf_str(out, c"        for i in 0..self.used.len() {\n");
        buf_str(out, c"            if nm(self.pool, self.used[i]) == t {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A name unique in the function being written.\n");
        buf_str(out, c"    fn unique(inout self, base: [u8]) -> Nm {\n");
        buf_str(out, c"        let n = self.escape(base);\n");
        buf_str(out, c"        if !self.is_used(n) {\n");
        buf_str(out, c"            self.used.push(n);\n");
        buf_str(out, c"            return n;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var k = 1;\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            let st = self.pool.len();\n");
        buf_str(out, c"            var i = 0;\n");
        buf_str(out, c"            while i < n.len {\n");
        buf_str(out, c"                let c = self.pool.as_slice()[n.start + i];\n");
        buf_str(out, c"                self.pool.push(c);\n");
        buf_str(out, c"                i += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.pool.push_fmt(f\"_{k}\");\n");
        buf_str(out, c"            let t = self.since(st);\n");
        buf_str(out, c"            if !self.is_used(t) {\n");
        buf_str(out, c"                self.used.push(t);\n");
        buf_str(out, c"                return t;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            k += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Types ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn scalar(sk: u8) -> [u8] {\n");
        buf_str(out, c"        if sk == SK_BOOL {\n");
        buf_str(out, c"            \"bool\"\n");
        buf_str(out, c"        } else if sk == SK_I32 {\n");
        buf_str(out, c"            \"int\"\n");
        buf_str(out, c"        } else if sk == SK_U32 {\n");
        buf_str(out, c"            \"uint\"\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            \"float\"\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The MSL name of type t (declaring structs and array wrappers once).\n");
        buf_str(out, c"    fn ty(inout self, m: Module, t: i64) -> Nm {\n");
        buf_str(out, c"        if self.tdone[t] {\n");
        buf_str(out, c"            return self.tname[t];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let ty = m.types[t];\n");
        buf_str(out, c"        var n = Nm { start: 0, len: 0 };\n");
        buf_str(out, c"        if ty.kind == TK_SCALAR {\n");
        buf_str(out, c"            n = self.intern(W::scalar(ty.scalar));\n");
        buf_str(out, c"        } else if ty.kind == TK_VECTOR {\n");
        buf_str(out, c"            let st = self.pool.len();\n");
        buf_str(out, c"            self.pool.push_fmt(f\"metal::{W::scalar(ty.scalar)}{ty.n}\");\n");
        buf_str(out, c"            n = self.since(st);\n");
        buf_str(out, c"        } else if ty.kind == TK_MATRIX {\n");
        buf_str(out, c"            let st = self.pool.len();\n");
        buf_str(out, c"            self.pool.push_fmt(f\"metal::float{ty.n}x{ty.m}\");\n");
        buf_str(out, c"            n = self.since(st);\n");
        buf_str(out, c"        } else if ty.kind == TK_ATOMIC {\n");
        buf_str(out, c"            n = self.intern(if ty.scalar == SK_I32 { \"metal::atomic_int\" }\n");
        buf_str(out, c"                else { \"metal::atomic_uint\" });\n");
        buf_str(out, c"        } else if ty.kind == TK_ARRAY {\n");
        buf_str(out, c"            let el = self.ty(m, ty.base);\n");
        buf_str(out, c"            let st = self.pool.len();\n");
        buf_str(out, c"            self.pool.push_fmt(f\"_w_arr{t}\");\n");
        buf_str(out, c"            n = self.since(st);\n");
        buf_str(out, c"            if ty.n > 0 {\n");
        buf_str(out, c"                self.types_out.push_fmt(\n");
        buf_str(out, c"                    f\"struct _w_arr{t} {{\\n    {nm(self.pool, el)} inner[{ty.n}];\\n}};\\n\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if ty.kind == TK_STRUCT {\n");
        buf_str(out, c"            n = self.escape(ty.name);\n");
        buf_str(out, c"            self.struct_def(m, t, n);\n");
        buf_str(out, c"        } else if ty.kind == TK_TEXTURE {\n");
        buf_str(out, c"            let sc = W::scalar(ty.scalar);\n");
        buf_str(out, c"            let st = self.pool.len();\n");
        buf_str(out, c"            if ty.n == TEX_DEPTH_2D {\n");
        buf_str(out, c"                self.pool.push_str(\"metal::depth2d<float, metal::access::sample>\");\n");
        buf_str(out, c"            } else if ty.n == TEX_2D_ARRAY {\n");
        buf_str(out, c"                self.pool.push_fmt(f\"metal::texture2d_array<{sc}, metal::access::sample>\");\n");
        buf_str(out, c"            } else if ty.n == TEX_STORAGE_2D {\n");
        buf_str(out, c"                self.pool.push_fmt(f\"metal::texture2d<{sc}, metal::access::write>\");\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.pool.push_fmt(f\"metal::texture2d<{sc}, metal::access::sample>\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            n = self.since(st);\n");
        buf_str(out, c"        } else if ty.kind == TK_SAMPLER {\n");
        buf_str(out, c"            n = self.intern(\"metal::sampler\");\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            n = self.intern(\"void\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.tname[t] = n;\n");
        buf_str(out, c"        self.tdone[t] = true;\n");
        buf_str(out, c"        n\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A member's MSL type: vec3 members are packed (12 bytes, as WGSL's).\n");
        buf_str(out, c"    fn member_ty(inout self, m: Module, t: i64) -> Nm {\n");
        buf_str(out, c"        let ty = m.types[t];\n");
        buf_str(out, c"        if ty.kind == TK_VECTOR && ty.n == 3 {\n");
        buf_str(out, c"            let st = self.pool.len();\n");
        buf_str(out, c"            self.pool.push_fmt(f\"metal::packed_{W::scalar(ty.scalar)}3\");\n");
        buf_str(out, c"            return self.since(st);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if ty.kind == TK_ARRAY && ty.n == 0 {\n");
        buf_str(out, c"            return self.ty(m, ty.base);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.ty(m, t)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn struct_def(inout self, m: Module, t: i64, name: Nm) {\n");
        buf_str(out, c"        let ty = m.types[t];\n");
        buf_str(out, c"        // member types first: they must be declared before\n");
        buf_str(out, c"        for i in ty.mstart..ty.mstart + ty.mcount {\n");
        buf_str(out, c"            self.member_ty(m, m.members[i].ty);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var b = Buf::new_in(self.a);\n");
        buf_str(out, c"        b.push_fmt(f\"struct {nm(self.pool, name)} {{\\n\");\n");
        buf_str(out, c"        var off = 0;\n");
        buf_str(out, c"        var pad = 0;\n");
        buf_str(out, c"        for i in ty.mstart..ty.mstart + ty.mcount {\n");
        buf_str(out, c"            let mem = m.members[i];\n");
        buf_str(out, c"            if mem.offset > off {\n");
        buf_str(out, c"                b.push_fmt(f\"    char _pad{pad}[{mem.offset - off}];\\n\");\n");
        buf_str(out, c"                pad += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let mt = m.types[mem.ty];\n");
        buf_str(out, c"            let mty = self.member_ty(m, mem.ty);\n");
        buf_str(out, c"            let mn = self.escape(mem.name);\n");
        buf_str(out, c"            if mt.kind == TK_ARRAY && mt.n == 0 {\n");
        buf_str(out, c"                b.push_fmt(f\"    {nm(self.pool, mty)} {nm(self.pool, mn)}[1];\\n\");\n");
        buf_str(out, c"                off = mem.offset + mt.stride;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                b.push_fmt(f\"    {nm(self.pool, mty)} {nm(self.pool, mn)};\\n\");\n");
        buf_str(out, c"                off = mem.offset + mt.size;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if ty.size > off\n");
        buf_str(out, c"            && !(ty.mcount > 0 && m.is_runtime_sized(m.members[ty.mstart + ty.mcount - 1].ty)) {\n");
        buf_str(out, c"            b.push_fmt(f\"    char _pad{pad}[{ty.size - off}];\\n\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b.push_str(\"};\\n\");\n");
        buf_str(out, c"        copy_into(&self.types_out, b.as_slice());\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The padding members before member k of struct t (for aggregate\n");
        buf_str(out, c"    // initialization), and after the last.\n");
        buf_str(out, c"    fn pads_before(m: Module, t: i64, k: i64) -> bool {\n");
        buf_str(out, c"        let ty = m.types[t];\n");
        buf_str(out, c"        let mem = m.members[ty.mstart + k];\n");
        buf_str(out, c"        if k == 0 {\n");
        buf_str(out, c"            return mem.offset > 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let prev = m.members[ty.mstart + k - 1];\n");
        buf_str(out, c"        mem.offset > prev.offset + m.types[prev.ty].size\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn space(sp: u8, access: u8) -> [u8] {\n");
        buf_str(out, c"        if sp == SP_STORAGE {\n");
        buf_str(out, c"            if access & ACC_WRITE != 0 { \"device\" } else { \"const device\" }\n");
        buf_str(out, c"        } else if sp == SP_UNIFORM {\n");
        buf_str(out, c"            \"constant\"\n");
        buf_str(out, c"        } else if sp == SP_WORKGROUP {\n");
        buf_str(out, c"            \"threadgroup\"\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            \"thread\"\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Shader compiler implementation, msl: Analysis (0.22) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn calls_of(f: Function, list: inout V<i64>) {\n");
        buf_str(out, c"    for s in 0..f.stmts.len() {\n");
        buf_str(out, c"        if f.stmts[s].op == S_CALL {\n");
        buf_str(out, c"            list.push(f.stmts[s].a);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Functions in an order where each comes after those it calls.\n");
        buf_str(out, c"pub fn call_order(m: Module, a: ScopedArena) -> V<i64> {\n");
        buf_str(out, c"    let n = m.functions.len();\n");
        buf_str(out, c"    var state: V<u8> = Vec::filled_in(n, 0u8, a);\n");
        buf_str(out, c"    var order: V<i64> = Vec::new_in(a);\n");
        buf_str(out, c"    for i in 0..n {\n");
        buf_str(out, c"        visit(m, i, &state, &order, a);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    order\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn visit(m: Module, i: i64, state: inout V<u8>, order: inout V<i64>, a: ScopedArena) {\n");
        buf_str(out, c"    if state[i] != 0 {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    state[i] = 1;\n");
        buf_str(out, c"    var cs: V<i64> = Vec::new_in(a);\n");
        buf_str(out, c"    calls_of(m.functions[i], &cs);\n");
        buf_str(out, c"    for k in 0..cs.len() {\n");
        buf_str(out, c"        visit(m, cs[k], &state, &order, a);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    order.push(i);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Which globals each function uses, through its calls too (order: callees first).\n");
        buf_str(out, c"pub fn global_uses(m: Module, order: V<i64>, a: ScopedArena) -> V<V<bool>> {\n");
        buf_str(out, c"    let ng = m.globals.len();\n");
        buf_str(out, c"    var uses: V<V<bool>> = Vec::new_in(a);\n");
        buf_str(out, c"    for _ in 0..m.functions.len() {\n");
        buf_str(out, c"        uses.push(Vec::filled_in(ng, false, a));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for oi in 0..order.len() {\n");
        buf_str(out, c"        let h = order[oi];\n");
        buf_str(out, c"        let f = m.functions[h];\n");
        buf_str(out, c"        for e in 0..f.exprs.len() {\n");
        buf_str(out, c"            if f.exprs[e].op == E_GLOBAL || f.exprs[e].op == E_ARRAY_LENGTH {\n");
        buf_str(out, c"                uses[h][f.exprs[e].a] = true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for s in 0..f.stmts.len() {\n");
        buf_str(out, c"            if f.stmts[s].op == S_CALL {\n");
        buf_str(out, c"                let callee = f.stmts[s].a;\n");
        buf_str(out, c"                for g in 0..ng {\n");
        buf_str(out, c"                    if uses[callee][g] {\n");
        buf_str(out, c"                        uses[h][g] = true;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    uses\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether function h needs the sizes buffer (a runtime-sized array it or a\n");
        buf_str(out, c"// callee reads).\n");
        buf_str(out, c"fn needs_sizes(w: W, m: Module, h: i64) -> bool {\n");
        buf_str(out, c"    for g in 0..m.globals.len() {\n");
        buf_str(out, c"        if w.uses[h][g] && w.sl.size_index[g] >= 0 {\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    false\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The module as MSL; the reflection's Metal names and slots too.\n");
        buf_str(out, c"pub fn write(m: Module, a: ScopedArena, out: inout Buf, refl: inout api::Reflection) {\n");
        buf_str(out, c"    var w = new_writer(m, a);\n");
        buf_str(out, c"    let order = call_order(m, a);\n");
        buf_str(out, c"    w.uses = global_uses(m, order, a);\n");
        buf_str(out, c"    w.sl = slots(m, w.uses, a);\n");
        buf_str(out, c"    for oi in 0..order.len() {\n");
        buf_str(out, c"        let h = order[oi];\n");
        buf_str(out, c"        var is_entry = false;\n");
        buf_str(out, c"        for e in 0..m.entries.len() {\n");
        buf_str(out, c"            if m.entries[e].func == h {\n");
        buf_str(out, c"                is_entry = true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if !is_entry {\n");
        buf_str(out, c"            write_fn(&w, m, h);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for e in 0..m.entries.len() {\n");
        buf_str(out, c"        write_entry(&w, m, e);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    finish(w, &out);\n");
        buf_str(out, c"    // the Metal side of the reflection\n");
        buf_str(out, c"    for e in 0..refl.entries.len() {\n");
        buf_str(out, c"        refl.entries[e].target_name.clear();\n");
        buf_str(out, c"        refl.entries[e].target_name.push_str(nm(w.pool, w.fnames[m.entries[e].func]));\n");
        buf_str(out, c"        refl.entries[e].sizes_slot = w.sl.sizes_slot[m.entries[e].stage as i64];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let ng = m.globals.len();\n");
        buf_str(out, c"    for b in 0..refl.bindings.len() {\n");
        buf_str(out, c"        let g = refl.bindings[b].global;\n");
        buf_str(out, c"        for st in 0..3 {\n");
        buf_str(out, c"            refl.bindings[b].slots[st] = w.sl.slot[st * ng + g];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn new_writer(m: Module, a: ScopedArena) -> W {\n");
        buf_str(out, c"    var w = W {\n");
        buf_str(out, c"        a: a,\n");
        buf_str(out, c"        out: Buf::with_capacity_in(16384, a),\n");
        buf_str(out, c"        tname: Vec::new_in(a),\n");
        buf_str(out, c"        tdone: Vec::new_in(a),\n");
        buf_str(out, c"        types_out: Buf::new_in(a),\n");
        buf_str(out, c"        need_div: false,\n");
        buf_str(out, c"        need_f2i: false,\n");
        buf_str(out, c"        need_sign: false,\n");
        buf_str(out, c"        need_flb: false,\n");
        buf_str(out, c"        need_ftb: false,\n");
        buf_str(out, c"        need_cmpxchg: Vec::new_in(a),\n");
        buf_str(out, c"        sl: Slots {\n");
        buf_str(out, c"            slot: Vec::new_in(a), size_index: Vec::new_in(a), sizes_count: 0,\n");
        buf_str(out, c"            sizes_slot: [-1, -1, -1]\n");
        buf_str(out, c"        },\n");
        buf_str(out, c"        uses: Vec::new_in(a),\n");
        buf_str(out, c"        fnames: Vec::new_in(a),\n");
        buf_str(out, c"        gnames: Vec::new_in(a),\n");
        buf_str(out, c"        fh: -1,\n");
        buf_str(out, c"        refc: Vec::new_in(a),\n");
        buf_str(out, c"        baked: Vec::new_in(a),\n");
        buf_str(out, c"        lnames: Vec::new_in(a),\n");
        buf_str(out, c"        enames: Vec::new_in(a),\n");
        buf_str(out, c"        used: Vec::new_in(a),\n");
        buf_str(out, c"        indent: 0,\n");
        buf_str(out, c"        loop_n: 0,\n");
        buf_str(out, c"        stage: 255,\n");
        buf_str(out, c"        out_name: Nm { start: 0, len: 0 },\n");
        buf_str(out, c"        pool: Buf::with_capacity_in(4096, a),\n");
        buf_str(out, c"        ret_ty: -1,\n");
        buf_str(out, c"        kinds: Vec::new_in(a),\n");
        buf_str(out, c"    };\n");
        buf_str(out, c"    for t in 0..m.types.len() {\n");
        buf_str(out, c"        w.tname.push(Nm { start: 0, len: 0 });\n");
        buf_str(out, c"        w.tdone.push(false);\n");
        buf_str(out, c"        w.kinds.push(m.types[t].kind);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // module-scope names: functions and globals, unique among themselves\n");
        buf_str(out, c"    for h in 0..m.functions.len() {\n");
        buf_str(out, c"        let n = w.unique(m.functions[h].name);\n");
        buf_str(out, c"        w.fnames.push(n);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for g in 0..m.globals.len() {\n");
        buf_str(out, c"        let n = w.unique(m.globals[g].name);\n");
        buf_str(out, c"        w.gnames.push(n);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    w\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn helpers<A: Allocator>(w: W, out: inout Buf<A>) {\n");
        buf_str(out, c"    if w.need_div {\n");
        buf_str(out, c"        out.push_str(\"static inline int _w_div(int a, int b) { return a / metal::select(b, 1, b == 0 || (a == (-2147483647 - 1) && b == -1)); }\\n\");\n");
        buf_str(out, c"        out.push_str(\"static inline uint _w_div(uint a, uint b) { return a / metal::select(b, 1u, b == 0u); }\\n\");\n");
        buf_str(out, c"        out.push_str(\"static inline int _w_mod(int a, int b) { int c = metal::select(b, 1, b == 0 || (a == (-2147483647 - 1) && b == -1)); return a - (a / c) * c; }\\n\");\n");
        buf_str(out, c"        out.push_str(\"static inline uint _w_mod(uint a, uint b) { return metal::select(a % metal::select(b, 1u, b == 0u), 0u, b == 0u); }\\n\");\n");
        buf_str(out, c"        for n in 2..5 {\n");
        buf_str(out, c"            for k in 0..2 {\n");
        buf_str(out, c"                let t = if k == 0 { \"int\" } else { \"uint\" };\n");
        buf_str(out, c"                out.push_fmt(\n");
        buf_str(out, c"                    f\"static inline metal::{t}{n} _w_div(metal::{t}{n} a, metal::{t}{n} b) {{ metal::{t}{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_div(a[i], b[i]); return r; }}\\n\");\n");
        buf_str(out, c"                out.push_fmt(\n");
        buf_str(out, c"                    f\"static inline metal::{t}{n} _w_mod(metal::{t}{n} a, metal::{t}{n} b) {{ metal::{t}{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_mod(a[i], b[i]); return r; }}\\n\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if w.need_f2i {\n");
        buf_str(out, c"        out.push_str(\"static inline int _w_f2i(float x) { return metal::isnan(x) ? 0 : int(metal::clamp(x, -2147483648.0f, 2147483520.0f)); }\\n\");\n");
        buf_str(out, c"        out.push_str(\"static inline uint _w_f2u(float x) { return metal::isnan(x) ? 0u : uint(metal::clamp(x, 0.0f, 4294967040.0f)); }\\n\");\n");
        buf_str(out, c"        for n in 2..5 {\n");
        buf_str(out, c"            out.push_fmt(\n");
        buf_str(out, c"                f\"static inline metal::int{n} _w_f2i(metal::float{n} x) {{ metal::int{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_f2i(x[i]); return r; }}\\n\");\n");
        buf_str(out, c"            out.push_fmt(\n");
        buf_str(out, c"                f\"static inline metal::uint{n} _w_f2u(metal::float{n} x) {{ metal::uint{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_f2u(x[i]); return r; }}\\n\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if w.need_sign {\n");
        buf_str(out, c"        out.push_str(\"template <typename T> static inline T _w_isign(T x) { return metal::select(metal::select(T(0), T(-1), x < T(0)), T(1), x > T(0)); }\\n\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if w.need_flb {\n");
        buf_str(out, c"        out.push_str(\"static inline uint _w_flb(uint x) { return metal::select(31u - metal::clz(x), 4294967295u, x == 0u); }\\n\");\n");
        buf_str(out, c"        out.push_str(\"static inline int _w_flb(int x) { uint y = as_type<uint>(metal::select(x, ~x, x < 0)); return as_type<int>(metal::select(31u - metal::clz(y), 4294967295u, y == 0u)); }\\n\");\n");
        buf_str(out, c"        for n in 2..5 {\n");
        buf_str(out, c"            for k in 0..2 {\n");
        buf_str(out, c"                let t = if k == 0 { \"int\" } else { \"uint\" };\n");
        buf_str(out, c"                out.push_fmt(\n");
        buf_str(out, c"                    f\"static inline metal::{t}{n} _w_flb(metal::{t}{n} x) {{ metal::{t}{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_flb(x[i]); return r; }}\\n\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if w.need_ftb {\n");
        buf_str(out, c"        out.push_str(\"template <typename T> static inline T _w_ftb(T x) { return metal::select(metal::ctz(x), T(4294967295u), x == T(0)); }\\n\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for i in 0..w.need_cmpxchg.len() {\n");
        buf_str(out, c"        out.push_str(w.s(w.need_cmpxchg[i]));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn finish(w: W, out: inout Buf) {\n");
        buf_str(out, c"    out.push_str(\n");
        buf_str(out, c"        \"// Generated by wgslc (MSL 3.0).\\n#include <metal_stdlib>\\n#include <simd/simd.h>\\n\\n\");\n");
        buf_str(out, c"    helpers(w, &out);\n");
        buf_str(out, c"    out.push('\\n');\n");
        buf_str(out, c"    out.push_str(w.types_out.as_slice());\n");
        buf_str(out, c"    out.push_str(w.out.as_slice());\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Shader compiler implementation, msl: Functions (0.22) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn count_refs(w: inout W, f: Function) {\n");
        buf_str(out, c"    w.refc.clear();\n");
        buf_str(out, c"    w.baked.clear();\n");
        buf_str(out, c"    for _ in 0..f.exprs.len() {\n");
        buf_str(out, c"        w.refc.push(0);\n");
        buf_str(out, c"        w.baked.push(false);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for e in 0..f.exprs.len() {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        let op = x.op;\n");
        buf_str(out, c"        if op == E_ACCESS || op == E_BINARY {\n");
        buf_str(out, c"            if op == E_ACCESS {\n");
        buf_str(out, c"                w.refc[x.a] += 1;\n");
        buf_str(out, c"                w.refc[x.b] += 1;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                w.refc[x.b] += 1;\n");
        buf_str(out, c"                w.refc[x.c] += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        else if op == E_ACCESS_INDEX || op == E_SPLAT || op == E_SWIZZLE || op == E_LOAD\n");
        buf_str(out, c"            || op == E_CONVERT || op == E_BITCAST {\n");
        buf_str(out, c"            w.refc[x.a] += 1;\n");
        buf_str(out, c"        } else if op == E_UNARY || op == E_DERIVATIVE {\n");
        buf_str(out, c"            w.refc[x.b] += 1;\n");
        buf_str(out, c"        } else if op == E_SELECT {\n");
        buf_str(out, c"            w.refc[x.a] += 1;\n");
        buf_str(out, c"            w.refc[x.b] += 1;\n");
        buf_str(out, c"            w.refc[x.c] += 1;\n");
        buf_str(out, c"        } else if op == E_COMPOSE {\n");
        buf_str(out, c"            for k in x.a..x.a + x.b {\n");
        buf_str(out, c"                w.refc[f.args[k]] += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == E_MATH {\n");
        buf_str(out, c"            for k in x.b..x.b + x.c {\n");
        buf_str(out, c"                w.refc[f.args[k]] += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == E_IMAGE_SAMPLE {\n");
        buf_str(out, c"            for k in x.c..x.c + (x.d >> 8) {\n");
        buf_str(out, c"                w.refc[f.args[k]] += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == E_IMAGE_LOAD {\n");
        buf_str(out, c"            for k in x.c..x.c + x.d {\n");
        buf_str(out, c"                w.refc[f.args[k]] += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == E_IMAGE_QUERY {\n");
        buf_str(out, c"            if x.c >= 0 {\n");
        buf_str(out, c"                w.refc[x.c] += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for s in 0..f.stmts.len() {\n");
        buf_str(out, c"        let st = f.stmts[s];\n");
        buf_str(out, c"        if st.op == S_IF || st.op == S_SWITCH {\n");
        buf_str(out, c"            w.refc[st.a] += 1;\n");
        buf_str(out, c"        } else if st.op == S_STORE {\n");
        buf_str(out, c"            w.refc[st.a] += 1;\n");
        buf_str(out, c"            w.refc[st.b] += 1;\n");
        buf_str(out, c"        } else if st.op == S_RETURN && st.a >= 0 {\n");
        buf_str(out, c"            w.refc[st.a] += 1;\n");
        buf_str(out, c"        } else if st.op == S_LOOP && st.c >= 0 {\n");
        buf_str(out, c"            w.refc[st.c] += 1;\n");
        buf_str(out, c"        } else if st.op == S_CALL {\n");
        buf_str(out, c"            for k in st.b..st.b + st.c {\n");
        buf_str(out, c"                w.refc[f.args[k]] += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if st.op == S_ATOMIC {\n");
        buf_str(out, c"            if st.c >= 0 {\n");
        buf_str(out, c"                w.refc[st.c] += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if st.e >= 0 {\n");
        buf_str(out, c"                w.refc[st.e] += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if st.op == S_IMAGE_STORE {\n");
        buf_str(out, c"            w.refc[st.b] += 1;\n");
        buf_str(out, c"            w.refc[st.c] += 1;\n");
        buf_str(out, c"            if st.d >= 0 {\n");
        buf_str(out, c"                w.refc[st.d] += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for e in 0..f.exprs.len() {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        let op = x.op;\n");
        buf_str(out, c"        let leaf = op == E_LITERAL || op == E_ARG || op == E_GLOBAL || op == E_LOCAL\n");
        buf_str(out, c"            || op == E_CALL_RESULT || op == E_ATOMIC_RESULT || op == E_WG_UNIFORM_RESULT;\n");
        buf_str(out, c"        if leaf {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let k = w.kinds[f.exprs[e].ty];\n");
        buf_str(out, c"        if k == TK_POINTER {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_LOAD || op == E_IMAGE_SAMPLE || op == E_IMAGE_LOAD || op == E_DERIVATIVE\n");
        buf_str(out, c"            || w.refc[e] > 1 || f.names[e].len > 0 {\n");
        buf_str(out, c"            w.baked[e] = true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Shader compiler implementation, msl: Expressions (0.22) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl W {\n");
        buf_str(out, c"    fn lit(inout self, m: Module, f: Function, e: i64) {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        let sk = m.types[x.ty].scalar;\n");
        buf_str(out, c"        if sk == SK_BOOL {\n");
        buf_str(out, c"            self.p(if x.a != 0 { \"true\" } else { \"false\" });\n");
        buf_str(out, c"        } else if sk == SK_U32 {\n");
        buf_str(out, c"            self.out.push_fmt(f\"{x.a}u\");\n");
        buf_str(out, c"        } else if sk == SK_I32 {\n");
        buf_str(out, c"            let v = x.a as u32 as i32 as i64;\n");
        buf_str(out, c"            if v == -2147483648 {\n");
        buf_str(out, c"                self.p(\"(-2147483647 - 1)\");\n");
        buf_str(out, c"            } else if v < 0 {\n");
        buf_str(out, c"                self.out.push_fmt(f\"({v})\");\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.out.push_fmt(f\"{v}\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            let v = bits_f32(x.a as u32);\n");
        buf_str(out, c"            let ex = (x.a >> 23) & 255;\n");
        buf_str(out, c"            if ex == 255 {\n");
        buf_str(out, c"                self.out.push_fmt(f\"as_type<float>({x.a}u)\");\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            var b = Buf::new_in(self.a);\n");
        buf_str(out, c"            b.push_fmt(f\"{v}\");\n");
        buf_str(out, c"            let s = b.as_slice();\n");
        buf_str(out, c"            var has_dot = false;\n");
        buf_str(out, c"            for i in 0..s.len {\n");
        buf_str(out, c"                if s[i] == '.' || s[i] == 'e' || s[i] == 'E' || s[i] == 'n' || s[i] == 'i' {\n");
        buf_str(out, c"                    has_dot = true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if s[0] == '-' {\n");
        buf_str(out, c"                self.p(\"(\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.p(s);\n");
        buf_str(out, c"            if !has_dot {\n");
        buf_str(out, c"                self.p(\".0\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.p(\"f\");\n");
        buf_str(out, c"            if s[0] == '-' {\n");
        buf_str(out, c"                self.p(\")\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // e as a value: its name, or its text.\n");
        buf_str(out, c"    fn val(inout self, m: Module, f: Function, e: i64) {\n");
        buf_str(out, c"        let op = f.exprs[e].op;\n");
        buf_str(out, c"        if self.baked[e] || op == E_CALL_RESULT || op == E_ATOMIC_RESULT\n");
        buf_str(out, c"            || op == E_WG_UNIFORM_RESULT {\n");
        buf_str(out, c"            self.pn(self.enames[e]);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_ARG {\n");
        buf_str(out, c"            self.pn(self.enames[e]);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.render(m, f, e);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The unsigned type of the same shape as t (i32 -> uint, int3 -> uint3).\n");
        buf_str(out, c"    fn utype(inout self, m: Module, t: i64) -> Nm {\n");
        buf_str(out, c"        let ty = m.types[t];\n");
        buf_str(out, c"        if ty.kind == TK_VECTOR {\n");
        buf_str(out, c"            let st = self.pool.len();\n");
        buf_str(out, c"            self.pool.push_fmt(f\"metal::uint{ty.n}\");\n");
        buf_str(out, c"            return self.since(st);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.intern(\"uint\")\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The index of an E_ACCESS, clamped when its check says so.\n");
        buf_str(out, c"    fn index(inout self, m: Module, f: Function, e: i64) {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        if x.c == CK_CLAMP {\n");
        buf_str(out, c"            self.p(\"metal::min(uint(\");\n");
        buf_str(out, c"            self.val(m, f, x.b);\n");
        buf_str(out, c"            self.out.push_fmt(f\"), {x.d - 1}u)\");\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.val(m, f, x.b);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A pointer expression as an lvalue.\n");
        buf_str(out, c"    fn lval(inout self, m: Module, f: Function, e: i64) {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        if x.op == E_GLOBAL {\n");
        buf_str(out, c"            self.pn(self.gnames[x.a]);\n");
        buf_str(out, c"        } else if x.op == E_LOCAL {\n");
        buf_str(out, c"            self.pn(self.lnames[x.a]);\n");
        buf_str(out, c"        } else if x.op == E_ARG {\n");
        buf_str(out, c"            self.out.push_fmt(f\"(*{nm(self.pool, self.enames[e])})\");\n");
        buf_str(out, c"        } else if x.op == E_ACCESS || x.op == E_ACCESS_INDEX {\n");
        buf_str(out, c"            let bt = m.types[m.pointee(f.exprs[x.a].ty)];\n");
        buf_str(out, c"            self.lval(m, f, x.a);\n");
        buf_str(out, c"            self.selector(m, f, e, bt);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.p(\"/* not a pointer */\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // `.member`, `[i]` or `.inner[i]` after a base of type bt.\n");
        buf_str(out, c"    fn selector(inout self, m: Module, f: Function, e: i64, bt: Type) {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        if x.op == E_ACCESS_INDEX {\n");
        buf_str(out, c"            if bt.kind == TK_STRUCT {\n");
        buf_str(out, c"                self.p(\".\");\n");
        buf_str(out, c"                let n = self.escape(m.members[bt.mstart + x.b].name);\n");
        buf_str(out, c"                self.pn(n);\n");
        buf_str(out, c"            } else if bt.kind == TK_ARRAY && bt.n > 0 {\n");
        buf_str(out, c"                self.out.push_fmt(f\".inner[{x.b}]\");\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.out.push_fmt(f\"[{x.b}]\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if bt.kind == TK_ARRAY && bt.n > 0 {\n");
        buf_str(out, c"            self.p(\".inner\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.p(\"[\");\n");
        buf_str(out, c"        self.index(m, f, e);\n");
        buf_str(out, c"        self.p(\"]\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether e (a pointer, or a member value) is a struct's vec3 member,\n");
        buf_str(out, c"    // which MSL holds packed.\n");
        buf_str(out, c"    fn is_packed_member(self, m: Module, f: Function, e: i64) -> bool {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        if x.op != E_ACCESS_INDEX {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let bt0 = f.exprs[x.a].ty;\n");
        buf_str(out, c"        let bt = if m.types[bt0].kind == TK_POINTER { m.types[bt0].base } else { bt0 };\n");
        buf_str(out, c"        if m.types[bt].kind != TK_STRUCT {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let mt = m.types[m.members[m.types[bt].mstart + x.b].ty];\n");
        buf_str(out, c"        mt.kind == TK_VECTOR && mt.n == 3\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The conditions under which the pointer e is in range (runtime-sized\n");
        buf_str(out, c"    // arrays); false when there are none.\n");
        buf_str(out, c"    fn guards(inout self, m: Module, f: Function, e: i64, any: bool) -> bool {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        var a = any;\n");
        buf_str(out, c"        if x.op == E_ACCESS || x.op == E_ACCESS_INDEX {\n");
        buf_str(out, c"            a = self.guards(m, f, x.a, a);\n");
        buf_str(out, c"            if x.op == E_ACCESS && x.c == CK_RZSW {\n");
        buf_str(out, c"                if a {\n");
        buf_str(out, c"                    self.p(\" && \");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.p(\"uint(\");\n");
        buf_str(out, c"                self.val(m, f, x.b);\n");
        buf_str(out, c"                self.p(\") < \");\n");
        buf_str(out, c"                self.runtime_len(m, f, x.a);\n");
        buf_str(out, c"                a = true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        a\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn has_guards(self, f: Function, e: i64) -> bool {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        if x.op == E_ACCESS && x.c == CK_RZSW {\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if x.op == E_ACCESS || x.op == E_ACCESS_INDEX {\n");
        buf_str(out, c"            return self.has_guards(f, x.a);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The length of the runtime-sized array pointer `base` points to.\n");
        buf_str(out, c"    fn runtime_len(inout self, m: Module, f: Function, base: i64) {\n");
        buf_str(out, c"        let b = f.exprs[base];\n");
        buf_str(out, c"        var g = -1;\n");
        buf_str(out, c"        var off = 0;\n");
        buf_str(out, c"        if b.op == E_GLOBAL {\n");
        buf_str(out, c"            g = b.a;\n");
        buf_str(out, c"        } else if b.op == E_ACCESS_INDEX && f.exprs[b.a].op == E_GLOBAL {\n");
        buf_str(out, c"            g = f.exprs[b.a].a;\n");
        buf_str(out, c"            let st = m.types[m.globals[g].ty];\n");
        buf_str(out, c"            off = m.members[st.mstart + b.b].offset;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let stride = m.types[m.pointee(b.ty)].stride;\n");
        buf_str(out, c"        self.len_text(g, off, stride);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn len_text(inout self, g: i64, off: i64, stride: i64) {\n");
        buf_str(out, c"        if g < 0 {\n");
        buf_str(out, c"            self.p(\"0u\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let k = self.sl.size_index[g];\n");
        buf_str(out, c"        if off == 0 {\n");
        buf_str(out, c"            self.out.push_fmt(f\"(_w_sizes[{k}] / {stride}u)\");\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.out.push_fmt(\n");
        buf_str(out, c"                f\"(_w_sizes[{k}] >= {off}u ? (_w_sizes[{k}] - {off}u) / {stride}u : 0u)\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn render(inout self, m: Module, f: Function, e: i64) {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        let op = x.op;\n");
        buf_str(out, c"        let t = m.types[x.ty];\n");
        buf_str(out, c"        if op == E_LITERAL {\n");
        buf_str(out, c"            self.lit(m, f, e);\n");
        buf_str(out, c"        } else if op == E_ZERO {\n");
        buf_str(out, c"            self.pty(m, x.ty);\n");
        buf_str(out, c"            self.p(\" {}\");\n");
        buf_str(out, c"        } else if op == E_COMPOSE {\n");
        buf_str(out, c"            let tn = self.ty(m, x.ty);\n");
        buf_str(out, c"            self.pn(tn);\n");
        buf_str(out, c"            if t.kind == TK_VECTOR || t.kind == TK_MATRIX {\n");
        buf_str(out, c"                self.p(\"(\");\n");
        buf_str(out, c"            } else if t.kind == TK_ARRAY {\n");
        buf_str(out, c"                self.p(\" {{\");\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.p(\" {\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for k in 0..x.b {\n");
        buf_str(out, c"                if k > 0 {\n");
        buf_str(out, c"                    self.p(\", \");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if t.kind == TK_STRUCT && W::pads_before(m, x.ty, k) {\n");
        buf_str(out, c"                    self.p(\"{}, \");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.val(m, f, f.args[x.a + k]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if t.kind == TK_VECTOR || t.kind == TK_MATRIX {\n");
        buf_str(out, c"                self.p(\")\");\n");
        buf_str(out, c"            } else if t.kind == TK_ARRAY {\n");
        buf_str(out, c"                self.p(\"}}\");\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.p(\"}\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == E_SPLAT {\n");
        buf_str(out, c"            self.pty(m, x.ty);\n");
        buf_str(out, c"            self.p(\"(\");\n");
        buf_str(out, c"            self.val(m, f, x.a);\n");
        buf_str(out, c"            self.p(\")\");\n");
        buf_str(out, c"        } else if op == E_SWIZZLE {\n");
        buf_str(out, c"            self.p(\"(\");\n");
        buf_str(out, c"            self.val(m, f, x.a);\n");
        buf_str(out, c"            self.p(\").\");\n");
        buf_str(out, c"            for k in 0..x.c {\n");
        buf_str(out, c"                self.out.push(\"xyzw\"[(x.b >> (2 * k)) & 3]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == E_ACCESS || op == E_ACCESS_INDEX {\n");
        buf_str(out, c"            let bt = m.types[f.exprs[x.a].ty];\n");
        buf_str(out, c"            let packed = op == E_ACCESS_INDEX && self.is_packed_member(m, f, e);\n");
        buf_str(out, c"            if packed {\n");
        buf_str(out, c"                self.pty(m, x.ty);\n");
        buf_str(out, c"                self.p(\"(\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.p(\"(\");\n");
        buf_str(out, c"            self.val(m, f, x.a);\n");
        buf_str(out, c"            self.p(\")\");\n");
        buf_str(out, c"            self.selector(m, f, e, bt);\n");
        buf_str(out, c"            if packed {\n");
        buf_str(out, c"                self.p(\")\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == E_LOAD {\n");
        buf_str(out, c"            let pe = x.a;\n");
        buf_str(out, c"            let g = self.has_guards(f, pe);\n");
        buf_str(out, c"            if g {\n");
        buf_str(out, c"                self.p(\"(\");\n");
        buf_str(out, c"                self.guards(m, f, pe, false);\n");
        buf_str(out, c"                self.p(\" ? \");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let packed = self.is_packed_member(m, f, pe);\n");
        buf_str(out, c"            if packed {\n");
        buf_str(out, c"                self.pty(m, x.ty);\n");
        buf_str(out, c"                self.p(\"(\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.lval(m, f, pe);\n");
        buf_str(out, c"            if packed {\n");
        buf_str(out, c"                self.p(\")\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if g {\n");
        buf_str(out, c"                self.p(\" : \");\n");
        buf_str(out, c"                self.pty(m, x.ty);\n");
        buf_str(out, c"                self.p(\" {})\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == E_UNARY {\n");
        buf_str(out, c"            let sk = t.scalar;\n");
        buf_str(out, c"            if x.a == UN_NEG && sk == SK_I32 {\n");
        buf_str(out, c"                let _n1 = self.ty(m, x.ty);\n");
        buf_str(out, c"                let _n2 = self.utype(m, x.ty);\n");
        buf_str(out, c"                self.out.push_fmt(\n");
        buf_str(out, c"                    f\"as_type<{nm(self.pool, _n1)}>(-as_type<{nm(self.pool, _n2)}>(\");\n");
        buf_str(out, c"                self.val(m, f, x.b);\n");
        buf_str(out, c"                self.p(\"))\");\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.p(if x.a == UN_NEG { \"(-\" } else if x.a == UN_NOT { \"(!\" } else { \"(~\" });\n");
        buf_str(out, c"                self.val(m, f, x.b);\n");
        buf_str(out, c"                self.p(\")\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == E_BINARY {\n");
        buf_str(out, c"            self.binary(m, f, e);\n");
        buf_str(out, c"        } else if op == E_SELECT {\n");
        buf_str(out, c"            let ct = m.types[f.exprs[x.a].ty];\n");
        buf_str(out, c"            if ct.kind == TK_SCALAR {\n");
        buf_str(out, c"                self.p(\"(\");\n");
        buf_str(out, c"                self.val(m, f, x.a);\n");
        buf_str(out, c"                self.p(\" ? \");\n");
        buf_str(out, c"                self.val(m, f, x.b);\n");
        buf_str(out, c"                self.p(\" : \");\n");
        buf_str(out, c"                self.val(m, f, x.c);\n");
        buf_str(out, c"                self.p(\")\");\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.p(\"metal::select(\");\n");
        buf_str(out, c"                self.val(m, f, x.c);\n");
        buf_str(out, c"                self.p(\", \");\n");
        buf_str(out, c"                self.val(m, f, x.b);\n");
        buf_str(out, c"                self.p(\", \");\n");
        buf_str(out, c"                self.val(m, f, x.a);\n");
        buf_str(out, c"                self.p(\")\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == E_CONVERT {\n");
        buf_str(out, c"            let from = m.types[f.exprs[x.a].ty].scalar;\n");
        buf_str(out, c"            if from == SK_F32 && (t.scalar == SK_I32 || t.scalar == SK_U32) {\n");
        buf_str(out, c"                self.need_f2i = true;\n");
        buf_str(out, c"                self.p(if t.scalar == SK_I32 { \"_w_f2i(\" } else { \"_w_f2u(\" });\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.pty(m, x.ty);\n");
        buf_str(out, c"                self.p(\"(\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.val(m, f, x.a);\n");
        buf_str(out, c"            self.p(\")\");\n");
        buf_str(out, c"        } else if op == E_BITCAST {\n");
        buf_str(out, c"            let _n3 = self.ty(m, x.ty);\n");
        buf_str(out, c"            self.out.push_fmt(f\"as_type<{nm(self.pool, _n3)}>(\");\n");
        buf_str(out, c"            self.val(m, f, x.a);\n");
        buf_str(out, c"            self.p(\")\");\n");
        buf_str(out, c"        } else if op == E_MATH {\n");
        buf_str(out, c"            self.math(m, f, e);\n");
        buf_str(out, c"        } else if op == E_ARRAY_LENGTH {\n");
        buf_str(out, c"            self.len_text(x.a, x.c, x.d);\n");
        buf_str(out, c"        } else if op == E_DERIVATIVE {\n");
        buf_str(out, c"            self.p(if x.a == 0 { \"metal::dfdx(\" } else if x.a == 1 { \"metal::dfdy(\" }\n");
        buf_str(out, c"                else { \"metal::fwidth(\" });\n");
        buf_str(out, c"            self.val(m, f, x.b);\n");
        buf_str(out, c"            self.p(\")\");\n");
        buf_str(out, c"        } else if op == E_IMAGE_SAMPLE {\n");
        buf_str(out, c"            self.sample(m, f, e);\n");
        buf_str(out, c"        } else if op == E_IMAGE_LOAD {\n");
        buf_str(out, c"            self.image_load(m, f, e);\n");
        buf_str(out, c"        } else if op == E_IMAGE_QUERY {\n");
        buf_str(out, c"            let tex = self.enames_or_global(m, f, x.a);\n");
        buf_str(out, c"            if x.b == IQ_LEVELS {\n");
        buf_str(out, c"                self.out.push_fmt(f\"{nm(self.pool, tex)}.get_num_mip_levels()\");\n");
        buf_str(out, c"            } else if x.b == IQ_LAYERS {\n");
        buf_str(out, c"                self.out.push_fmt(f\"{nm(self.pool, tex)}.get_array_size()\");\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                let tt = m.types[f.exprs[x.a].ty];\n");
        buf_str(out, c"                if x.c >= 0 && tt.n != TEX_STORAGE_2D {\n");
        buf_str(out, c"                    self.out.push_fmt(f\"metal::uint2({nm(self.pool, tex)}.get_width(\");\n");
        buf_str(out, c"                    self.val(m, f, x.c);\n");
        buf_str(out, c"                    self.out.push_fmt(f\"), {nm(self.pool, tex)}.get_height(\");\n");
        buf_str(out, c"                    self.val(m, f, x.c);\n");
        buf_str(out, c"                    self.p(\"))\");\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    self.out.push_fmt(\n");
        buf_str(out, c"                        f\"metal::uint2({nm(self.pool, tex)}.get_width(), {nm(self.pool, tex)}.get_height())\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.p(\"/* ? */\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn enames_or_global(self, m: Module, f: Function, e: i64) -> Nm {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        if x.op == E_GLOBAL {\n");
        buf_str(out, c"            return self.gnames[x.a];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.enames[e]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn binary(inout self, m: Module, f: Function, e: i64) {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        let op = x.a;\n");
        buf_str(out, c"        let lt = m.types[f.exprs[x.b].ty];\n");
        buf_str(out, c"        let sk = lt.scalar;\n");
        buf_str(out, c"        let int = (sk == SK_I32 || sk == SK_U32) && lt.kind != TK_MATRIX;\n");
        buf_str(out, c"        if int && (op == OP_DIV || op == OP_MOD) {\n");
        buf_str(out, c"            // a literal divisor other than 0 (and -1 for i32) needs no helper\n");
        buf_str(out, c"            let r = f.exprs[x.c];\n");
        buf_str(out, c"            let lit_ok = r.op == E_LITERAL && r.a != 0 && !(sk == SK_I32 && r.a == 4294967295);\n");
        buf_str(out, c"            if lit_ok && !(sk == SK_I32 && op == OP_MOD) {\n");
        buf_str(out, c"                self.p(\"(\");\n");
        buf_str(out, c"                self.val(m, f, x.b);\n");
        buf_str(out, c"                self.p(if op == OP_DIV { \" / \" } else { \" % \" });\n");
        buf_str(out, c"                self.val(m, f, x.c);\n");
        buf_str(out, c"                self.p(\")\");\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.need_div = true;\n");
        buf_str(out, c"            self.p(if op == OP_DIV { \"_w_div(\" } else { \"_w_mod(\" });\n");
        buf_str(out, c"            self.val(m, f, x.b);\n");
        buf_str(out, c"            self.p(\", \");\n");
        buf_str(out, c"            self.val(m, f, x.c);\n");
        buf_str(out, c"            self.p(\")\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if sk == SK_I32 && (op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_SHL) {\n");
        buf_str(out, c"            let tn = self.ty(m, f.exprs[x.b].ty);\n");
        buf_str(out, c"            let un = self.utype(m, f.exprs[x.b].ty);\n");
        buf_str(out, c"            self.out.push_fmt(f\"as_type<{nm(self.pool, tn)}>(as_type<{nm(self.pool, un)}>(\");\n");
        buf_str(out, c"            self.val(m, f, x.b);\n");
        buf_str(out, c"            self.p(if op == OP_ADD { \") + as_type<\" } else if op == OP_SUB { \") - as_type<\" }\n");
        buf_str(out, c"                else if op == OP_MUL { \") * as_type<\" } else { \") << (\" });\n");
        buf_str(out, c"            if op == OP_SHL {\n");
        buf_str(out, c"                self.val(m, f, x.c);\n");
        buf_str(out, c"                self.p(\" & 31u))\");\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.out.push_fmt(f\"{nm(self.pool, un)}>(\");\n");
        buf_str(out, c"                self.val(m, f, x.c);\n");
        buf_str(out, c"                self.p(\"))\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == OP_MOD && sk == SK_F32 {\n");
        buf_str(out, c"            self.p(\"metal::fmod(\");\n");
        buf_str(out, c"            self.val(m, f, x.b);\n");
        buf_str(out, c"            self.p(\", \");\n");
        buf_str(out, c"            self.val(m, f, x.c);\n");
        buf_str(out, c"            self.p(\")\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.p(\"(\");\n");
        buf_str(out, c"        self.val(m, f, x.b);\n");
        buf_str(out, c"        let s = if op == OP_ADD {\n");
        buf_str(out, c"            \" + \"\n");
        buf_str(out, c"        } else if op == OP_SUB {\n");
        buf_str(out, c"            \" - \"\n");
        buf_str(out, c"        } else if op == OP_MUL {\n");
        buf_str(out, c"            \" * \"\n");
        buf_str(out, c"        } else if op == OP_DIV {\n");
        buf_str(out, c"            \" / \"\n");
        buf_str(out, c"        } else if op == OP_EQ {\n");
        buf_str(out, c"            \" == \"\n");
        buf_str(out, c"        } else if op == OP_NE {\n");
        buf_str(out, c"            \" != \"\n");
        buf_str(out, c"        } else if op == OP_LT {\n");
        buf_str(out, c"            \" < \"\n");
        buf_str(out, c"        } else if op == OP_LE {\n");
        buf_str(out, c"            \" <= \"\n");
        buf_str(out, c"        } else if op == OP_GT {\n");
        buf_str(out, c"            \" > \"\n");
        buf_str(out, c"        } else if op == OP_GE {\n");
        buf_str(out, c"            \" >= \"\n");
        buf_str(out, c"        } else if op == OP_AND {\n");
        buf_str(out, c"            if sk == SK_BOOL && lt.kind == TK_SCALAR { \" && \" } else { \" & \" }\n");
        buf_str(out, c"        } else if op == OP_OR {\n");
        buf_str(out, c"            if sk == SK_BOOL && lt.kind == TK_SCALAR { \" || \" } else { \" | \" }\n");
        buf_str(out, c"        } else if op == OP_XOR {\n");
        buf_str(out, c"            if sk == SK_BOOL { \" != \" } else { \" ^ \" }\n");
        buf_str(out, c"        } else if op == OP_SHL {\n");
        buf_str(out, c"            \" << (\"\n");
        buf_str(out, c"        } else if op == OP_SHR {\n");
        buf_str(out, c"            \" >> (\"\n");
        buf_str(out, c"        } else if op == OP_LAND {\n");
        buf_str(out, c"            \" && \"\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            \" || \"\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        self.p(s);\n");
        buf_str(out, c"        self.val(m, f, x.c);\n");
        buf_str(out, c"        if op == OP_SHL || op == OP_SHR {\n");
        buf_str(out, c"            self.p(\" & 31u)\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.p(\")\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn math(inout self, m: Module, f: Function, e: i64) {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        let fun = x.a;\n");
        buf_str(out, c"        let a0 = f.args[x.b];\n");
        buf_str(out, c"        let at = m.types[f.exprs[a0].ty];\n");
        buf_str(out, c"        let sk = at.scalar;\n");
        buf_str(out, c"        let int = sk == SK_I32 || sk == SK_U32;\n");
        buf_str(out, c"        if fun == ir::MF_ABS && sk == SK_I32 {\n");
        buf_str(out, c"            // abs(MIN) is MIN: through uint\n");
        buf_str(out, c"            let _n4 = self.ty(m, x.ty);\n");
        buf_str(out, c"            let _n5 = self.utype(m, x.ty);\n");
        buf_str(out, c"            self.out.push_fmt(\n");
        buf_str(out, c"                f\"as_type<{nm(self.pool, _n4)}>(metal::select(as_type<{nm(self.pool, _n5)}>(\");\n");
        buf_str(out, c"            self.val(m, f, a0);\n");
        buf_str(out, c"            let _n6 = self.utype(m, x.ty);\n");
        buf_str(out, c"            self.out.push_fmt(f\"), -as_type<{nm(self.pool, _n6)}>(\");\n");
        buf_str(out, c"            self.val(m, f, a0);\n");
        buf_str(out, c"            self.p(\"), \");\n");
        buf_str(out, c"            self.val(m, f, a0);\n");
        buf_str(out, c"            let _n7 = self.ty(m, x.ty);\n");
        buf_str(out, c"            self.out.push_fmt(f\" < {nm(self.pool, _n7)}(0)))\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_ABS && sk == SK_U32 {\n");
        buf_str(out, c"            self.val(m, f, a0);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_SIGN && int {\n");
        buf_str(out, c"            self.need_sign = true;\n");
        buf_str(out, c"            self.p(\"_w_isign(\");\n");
        buf_str(out, c"            self.val(m, f, a0);\n");
        buf_str(out, c"            self.p(\")\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_DOT && int {\n");
        buf_str(out, c"            // wrapping: as the sum of products, through uint\n");
        buf_str(out, c"            let n = at.n;\n");
        buf_str(out, c"            self.out.push_fmt(f\"as_type<{W::scalar(sk)}>(\");\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                if k > 0 {\n");
        buf_str(out, c"                    self.p(\" + \");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.p(\"as_type<uint>(\");\n");
        buf_str(out, c"                self.val(m, f, a0);\n");
        buf_str(out, c"                self.out.push_fmt(f\"[{k}]) * as_type<uint>(\");\n");
        buf_str(out, c"                self.val(m, f, f.args[x.b + 1]);\n");
        buf_str(out, c"                self.out.push_fmt(f\"[{k}])\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.p(\")\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_FIRST_LEADING_BIT {\n");
        buf_str(out, c"            self.need_flb = true;\n");
        buf_str(out, c"            self.p(\"_w_flb(\");\n");
        buf_str(out, c"            self.val(m, f, a0);\n");
        buf_str(out, c"            self.p(\")\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_FIRST_TRAILING_BIT {\n");
        buf_str(out, c"            self.need_ftb = true;\n");
        buf_str(out, c"            self.p(\"_w_ftb(\");\n");
        buf_str(out, c"            self.val(m, f, a0);\n");
        buf_str(out, c"            self.p(\")\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_EXTRACT_BITS || fun == ir::MF_INSERT_BITS {\n");
        buf_str(out, c"            // WGSL clamps offset and count; Metal leaves them undefined\n");
        buf_str(out, c"            let k = if fun == ir::MF_EXTRACT_BITS { 1 } else { 2 };\n");
        buf_str(out, c"            self.p(if fun == ir::MF_EXTRACT_BITS { \"metal::extract_bits(\" }\n");
        buf_str(out, c"                else { \"metal::insert_bits(\" });\n");
        buf_str(out, c"            for i in 0..k {\n");
        buf_str(out, c"                self.val(m, f, f.args[x.b + i]);\n");
        buf_str(out, c"                self.p(\", \");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.p(\"metal::min(\");\n");
        buf_str(out, c"            self.val(m, f, f.args[x.b + k]);\n");
        buf_str(out, c"            self.p(\", 32u), metal::min(\");\n");
        buf_str(out, c"            self.val(m, f, f.args[x.b + k + 1]);\n");
        buf_str(out, c"            self.p(\", 32u - metal::min(\");\n");
        buf_str(out, c"            self.val(m, f, f.args[x.b + k]);\n");
        buf_str(out, c"            self.p(\", 32u)))\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_DEGREES || fun == ir::MF_RADIANS {\n");
        buf_str(out, c"            self.p(\"(\");\n");
        buf_str(out, c"            self.val(m, f, a0);\n");
        buf_str(out, c"            self.p(if fun == ir::MF_DEGREES { \" * 57.2957795131f)\" }\n");
        buf_str(out, c"                else { \" * 0.0174532925199f)\" });\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_PACK2X16FLOAT {\n");
        buf_str(out, c"            self.p(\"as_type<uint>(metal::half2(\");\n");
        buf_str(out, c"            self.val(m, f, a0);\n");
        buf_str(out, c"            self.p(\"))\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_UNPACK2X16FLOAT {\n");
        buf_str(out, c"            self.p(\"metal::float2(as_type<metal::half2>(\");\n");
        buf_str(out, c"            self.val(m, f, a0);\n");
        buf_str(out, c"            self.p(\"))\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let name = if fun < MATH_NAMES.len() {\n");
        buf_str(out, c"            MATH_NAMES[fun]\n");
        buf_str(out, c"        } else if fun == ir::MF_COUNT_ONE_BITS {\n");
        buf_str(out, c"            \"popcount\"\n");
        buf_str(out, c"        } else if fun == ir::MF_COUNT_LEADING_ZEROS {\n");
        buf_str(out, c"            \"clz\"\n");
        buf_str(out, c"        } else if fun == ir::MF_COUNT_TRAILING_ZEROS {\n");
        buf_str(out, c"            \"ctz\"\n");
        buf_str(out, c"        } else if fun == ir::MF_REVERSE_BITS {\n");
        buf_str(out, c"            \"reverse_bits\"\n");
        buf_str(out, c"        } else if fun == ir::MF_ALL {\n");
        buf_str(out, c"            \"all\"\n");
        buf_str(out, c"        } else if fun == ir::MF_ANY {\n");
        buf_str(out, c"            \"any\"\n");
        buf_str(out, c"        } else if fun == ir::MF_SATURATE {\n");
        buf_str(out, c"            \"saturate\"\n");
        buf_str(out, c"        } else if fun == ir::MF_ASINH {\n");
        buf_str(out, c"            \"asinh\"\n");
        buf_str(out, c"        } else if fun == ir::MF_ACOSH {\n");
        buf_str(out, c"            \"acosh\"\n");
        buf_str(out, c"        } else if fun == ir::MF_ATANH {\n");
        buf_str(out, c"            \"atanh\"\n");
        buf_str(out, c"        } else if fun == ir::MF_FACE_FORWARD {\n");
        buf_str(out, c"            \"faceforward\"\n");
        buf_str(out, c"        } else if fun == ir::MF_LDEXP {\n");
        buf_str(out, c"            \"ldexp\"\n");
        buf_str(out, c"        } else if fun == ir::MF_PACK4X8UNORM {\n");
        buf_str(out, c"            \"pack_float_to_unorm4x8\"\n");
        buf_str(out, c"        } else if fun == ir::MF_UNPACK4X8UNORM {\n");
        buf_str(out, c"            \"unpack_unorm4x8_to_float\"\n");
        buf_str(out, c"        } else if fun == ir::MF_PACK4X8SNORM {\n");
        buf_str(out, c"            \"pack_float_to_snorm4x8\"\n");
        buf_str(out, c"        } else if fun == ir::MF_UNPACK4X8SNORM {\n");
        buf_str(out, c"            \"unpack_snorm4x8_to_float\"\n");
        buf_str(out, c"        } else if fun == ir::MF_PACK2X16UNORM {\n");
        buf_str(out, c"            \"pack_float_to_unorm2x16\"\n");
        buf_str(out, c"        } else if fun == ir::MF_UNPACK2X16UNORM {\n");
        buf_str(out, c"            \"unpack_unorm2x16_to_float\"\n");
        buf_str(out, c"        } else if fun == ir::MF_PACK2X16SNORM {\n");
        buf_str(out, c"            \"pack_float_to_snorm2x16\"\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            \"unpack_snorm2x16_to_float\"\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        self.p(\"metal::\");\n");
        buf_str(out, c"        self.p(name);\n");
        buf_str(out, c"        self.p(\"(\");\n");
        buf_str(out, c"        for k in 0..x.c {\n");
        buf_str(out, c"            if k > 0 {\n");
        buf_str(out, c"                self.p(\", \");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.val(m, f, f.args[x.b + k]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.p(\")\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn sample(inout self, m: Module, f: Function, e: i64) {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        let kind = x.d & 255;\n");
        buf_str(out, c"        let n = x.d >> 8;\n");
        buf_str(out, c"        let tt = m.types[f.exprs[x.a].ty];\n");
        buf_str(out, c"        let tex = self.enames_or_global(m, f, x.a);\n");
        buf_str(out, c"        let smp = self.enames_or_global(m, f, x.b);\n");
        buf_str(out, c"        let compare = kind == IMG_SAMPLE_COMPARE || kind == IMG_SAMPLE_COMPARE_LEVEL;\n");
        buf_str(out, c"        self.out.push_fmt(\n");
        buf_str(out, c"            f\"{nm(self.pool, tex)}.{if compare { \"sample_compare\" } else { \"sample\" }}({nm(self.pool, smp)}, \");\n");
        buf_str(out, c"        self.val(m, f, f.args[x.c]);\n");
        buf_str(out, c"        var k = 1;\n");
        buf_str(out, c"        if tt.n == TEX_2D_ARRAY {\n");
        buf_str(out, c"            self.p(\", \");\n");
        buf_str(out, c"            self.val(m, f, f.args[x.c + 1]);\n");
        buf_str(out, c"            k = 2;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if kind == IMG_SAMPLE_BIAS {\n");
        buf_str(out, c"            self.p(\", metal::bias(\");\n");
        buf_str(out, c"            self.val(m, f, f.args[x.c + k]);\n");
        buf_str(out, c"            self.p(\")\");\n");
        buf_str(out, c"        } else if kind == IMG_SAMPLE_LEVEL {\n");
        buf_str(out, c"            self.p(\", metal::level(\");\n");
        buf_str(out, c"            self.val(m, f, f.args[x.c + k]);\n");
        buf_str(out, c"            self.p(\")\");\n");
        buf_str(out, c"        } else if compare {\n");
        buf_str(out, c"            self.p(\", \");\n");
        buf_str(out, c"            self.val(m, f, f.args[x.c + k]);\n");
        buf_str(out, c"            if kind == IMG_SAMPLE_COMPARE_LEVEL {\n");
        buf_str(out, c"                self.p(\", metal::level(0)\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let _ = n;\n");
        buf_str(out, c"        self.p(\")\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // textureLoad: the level, layer and coordinates clamped into range.\n");
        buf_str(out, c"    fn image_load(inout self, m: Module, f: Function, e: i64) {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        let tt = m.types[f.exprs[x.a].ty];\n");
        buf_str(out, c"        let tex = self.enames_or_global(m, f, x.a);\n");
        buf_str(out, c"        let arrayed = tt.n == TEX_2D_ARRAY;\n");
        buf_str(out, c"        let lvl = f.args[x.c + x.d - 1];\n");
        buf_str(out, c"        let saved = std::replace(&self.out, Buf::new_in(self.a));\n");
        buf_str(out, c"        self.out.push_fmt(f\"metal::min(uint(\");\n");
        buf_str(out, c"        self.val(m, f, lvl);\n");
        buf_str(out, c"        self.out.push_fmt(f\"), {nm(self.pool, tex)}.get_num_mip_levels() - 1u)\");\n");
        buf_str(out, c"        let lb = std::replace(&self.out, saved);\n");
        buf_str(out, c"        let l = lb.as_slice();\n");
        buf_str(out, c"        self.out.push_fmt(f\"{nm(self.pool, tex)}.read(metal::min(metal::uint2(\");\n");
        buf_str(out, c"        self.val(m, f, f.args[x.c]);\n");
        buf_str(out, c"        self.out.push_fmt(\n");
        buf_str(out, c"            f\"), metal::uint2({nm(self.pool, tex)}.get_width({l}) - 1u, {nm(self.pool, tex)}.get_height({l}) - 1u))\");\n");
        buf_str(out, c"        if arrayed {\n");
        buf_str(out, c"            self.p(\", metal::min(uint(\");\n");
        buf_str(out, c"            self.val(m, f, f.args[x.c + 1]);\n");
        buf_str(out, c"            self.out.push_fmt(f\"), {nm(self.pool, tex)}.get_array_size() - 1u)\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.out.push_fmt(f\", {l})\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Shader compiler implementation, msl: Statements (0.22) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl W {\n");
        buf_str(out, c"    fn block(inout self, m: Module, f: Function, blk: i64) {\n");
        buf_str(out, c"        let b = f.blocks[blk];\n");
        buf_str(out, c"        for i in b.start..b.start + b.count {\n");
        buf_str(out, c"            self.stmt(m, f, f.items[i]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn braced(inout self, m: Module, f: Function, blk: i64) {\n");
        buf_str(out, c"        self.p(\"{\");\n");
        buf_str(out, c"        self.indent += 1;\n");
        buf_str(out, c"        self.block(m, f, blk);\n");
        buf_str(out, c"        self.indent -= 1;\n");
        buf_str(out, c"        self.line();\n");
        buf_str(out, c"        self.p(\"}\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn atomic_fn(fun: i64) -> [u8] {\n");
        buf_str(out, c"        if fun == AT_ADD {\n");
        buf_str(out, c"            \"metal::atomic_fetch_add_explicit\"\n");
        buf_str(out, c"        } else if fun == AT_SUB {\n");
        buf_str(out, c"            \"metal::atomic_fetch_sub_explicit\"\n");
        buf_str(out, c"        } else if fun == AT_AND {\n");
        buf_str(out, c"            \"metal::atomic_fetch_and_explicit\"\n");
        buf_str(out, c"        } else if fun == AT_OR {\n");
        buf_str(out, c"            \"metal::atomic_fetch_or_explicit\"\n");
        buf_str(out, c"        } else if fun == AT_XOR {\n");
        buf_str(out, c"            \"metal::atomic_fetch_xor_explicit\"\n");
        buf_str(out, c"        } else if fun == AT_MIN {\n");
        buf_str(out, c"            \"metal::atomic_fetch_min_explicit\"\n");
        buf_str(out, c"        } else if fun == AT_MAX {\n");
        buf_str(out, c"            \"metal::atomic_fetch_max_explicit\"\n");
        buf_str(out, c"        } else if fun == AT_EXCHANGE {\n");
        buf_str(out, c"            \"metal::atomic_exchange_explicit\"\n");
        buf_str(out, c"        } else if fun == AT_LOAD {\n");
        buf_str(out, c"            \"metal::atomic_load_explicit\"\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            \"metal::atomic_store_explicit\"\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn stmt(inout self, m: Module, f: Function, s: i64) {\n");
        buf_str(out, c"        let st = f.stmts[s];\n");
        buf_str(out, c"        let op = st.op;\n");
        buf_str(out, c"        if op == S_EMIT {\n");
        buf_str(out, c"            for e in st.a..st.b {\n");
        buf_str(out, c"                if self.baked[e] {\n");
        buf_str(out, c"                    self.line();\n");
        buf_str(out, c"                    self.pty(m, f.exprs[e].ty);\n");
        buf_str(out, c"                    self.p(\" \");\n");
        buf_str(out, c"                    self.pn(self.enames[e]);\n");
        buf_str(out, c"                    self.p(\" = \");\n");
        buf_str(out, c"                    self.render(m, f, e);\n");
        buf_str(out, c"                    self.p(\";\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.line();\n");
        buf_str(out, c"        if op == S_STORE {\n");
        buf_str(out, c"            let g = self.has_guards(f, st.a);\n");
        buf_str(out, c"            if g {\n");
        buf_str(out, c"                self.p(\"if (\");\n");
        buf_str(out, c"                self.guards(m, f, st.a, false);\n");
        buf_str(out, c"                self.p(\") { \");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.lval(m, f, st.a);\n");
        buf_str(out, c"            self.p(\" = \");\n");
        buf_str(out, c"            self.val(m, f, st.b);\n");
        buf_str(out, c"            self.p(\";\");\n");
        buf_str(out, c"            if g {\n");
        buf_str(out, c"                self.p(\" }\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == S_BLOCK {\n");
        buf_str(out, c"            self.braced(m, f, st.a);\n");
        buf_str(out, c"        } else if op == S_IF {\n");
        buf_str(out, c"            self.p(\"if (\");\n");
        buf_str(out, c"            self.val(m, f, st.a);\n");
        buf_str(out, c"            self.p(\") \");\n");
        buf_str(out, c"            self.braced(m, f, st.b);\n");
        buf_str(out, c"            if f.blocks[st.c].count > 0 {\n");
        buf_str(out, c"                self.p(\" else \");\n");
        buf_str(out, c"                self.braced(m, f, st.c);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if op == S_SWITCH {\n");
        buf_str(out, c"            self.p(\"switch (\");\n");
        buf_str(out, c"            self.val(m, f, st.a);\n");
        buf_str(out, c"            self.p(\") {\");\n");
        buf_str(out, c"            for k in st.b..st.b + st.c {\n");
        buf_str(out, c"                let c = f.cases[k];\n");
        buf_str(out, c"                self.line();\n");
        buf_str(out, c"                for j in c.vstart..c.vstart + c.vcount {\n");
        buf_str(out, c"                    let sel_t = m.types[f.exprs[st.a].ty].scalar;\n");
        buf_str(out, c"                    if sel_t == SK_U32 {\n");
        buf_str(out, c"                        self.out.push_fmt(f\"case {f.vals[j] & 4294967295}u: \");\n");
        buf_str(out, c"                    } else {\n");
        buf_str(out, c"                        let v = f.vals[j] as u32 as i32 as i64;\n");
        buf_str(out, c"                        if v == -2147483648 {\n");
        buf_str(out, c"                            self.p(\"case (-2147483647 - 1): \");\n");
        buf_str(out, c"                        } else {\n");
        buf_str(out, c"                            self.out.push_fmt(f\"case {v}: \");\n");
        buf_str(out, c"                        }\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if c.is_default {\n");
        buf_str(out, c"                    self.p(\"default: \");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.p(\"{\");\n");
        buf_str(out, c"                self.indent += 1;\n");
        buf_str(out, c"                self.block(m, f, c.body);\n");
        buf_str(out, c"                self.line();\n");
        buf_str(out, c"                self.p(\"break;\");\n");
        buf_str(out, c"                self.indent -= 1;\n");
        buf_str(out, c"                self.line();\n");
        buf_str(out, c"                self.p(\"}\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.line();\n");
        buf_str(out, c"            self.p(\"}\");\n");
        buf_str(out, c"        } else if op == S_LOOP {\n");
        buf_str(out, c"            let has_cont = f.blocks[st.b].count > 0 || st.c >= 0;\n");
        buf_str(out, c"            if !has_cont {\n");
        buf_str(out, c"                self.p(\"while (true) \");\n");
        buf_str(out, c"                self.braced(m, f, st.a);\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let li = self.loop_n;\n");
        buf_str(out, c"            self.loop_n += 1;\n");
        buf_str(out, c"            self.out.push_fmt(f\"bool _w_loop{li} = true;\");\n");
        buf_str(out, c"            self.line();\n");
        buf_str(out, c"            self.p(\"while (true) {\");\n");
        buf_str(out, c"            self.indent += 1;\n");
        buf_str(out, c"            self.line();\n");
        buf_str(out, c"            self.out.push_fmt(f\"if (!_w_loop{li}) {{\");\n");
        buf_str(out, c"            self.indent += 1;\n");
        buf_str(out, c"            self.block(m, f, st.b);\n");
        buf_str(out, c"            if st.c >= 0 {\n");
        buf_str(out, c"                self.line();\n");
        buf_str(out, c"                self.p(\"if (\");\n");
        buf_str(out, c"                self.val(m, f, st.c);\n");
        buf_str(out, c"                self.p(\") { break; }\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.indent -= 1;\n");
        buf_str(out, c"            self.line();\n");
        buf_str(out, c"            self.p(\"}\");\n");
        buf_str(out, c"            self.line();\n");
        buf_str(out, c"            self.out.push_fmt(f\"_w_loop{li} = false;\");\n");
        buf_str(out, c"            self.block(m, f, st.a);\n");
        buf_str(out, c"            self.indent -= 1;\n");
        buf_str(out, c"            self.line();\n");
        buf_str(out, c"            self.p(\"}\");\n");
        buf_str(out, c"        } else if op == S_BREAK {\n");
        buf_str(out, c"            self.p(\"break;\");\n");
        buf_str(out, c"        } else if op == S_CONTINUE {\n");
        buf_str(out, c"            self.p(\"continue;\");\n");
        buf_str(out, c"        } else if op == S_RETURN {\n");
        buf_str(out, c"            self.ret(m, f, st.a);\n");
        buf_str(out, c"        } else if op == S_KILL {\n");
        buf_str(out, c"            self.p(if self.stage == TEST_KERNEL { \"return;\" }\n");
        buf_str(out, c"                else { \"metal::discard_fragment();\" });\n");
        buf_str(out, c"        } else if op == S_BARRIER {\n");
        buf_str(out, c"            self.p(if st.a\n");
        buf_str(out, c"                == BARRIER_WORKGROUP {\n");
        buf_str(out, c"                \"metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);\"\n");
        buf_str(out, c"            } else { \"metal::threadgroup_barrier(metal::mem_flags::mem_device);\" });\n");
        buf_str(out, c"        } else if op == S_WG_UNIFORM_LOAD {\n");
        buf_str(out, c"            self.p(\"metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);\");\n");
        buf_str(out, c"            self.line();\n");
        buf_str(out, c"            self.pty(m, f.exprs[st.b].ty);\n");
        buf_str(out, c"            self.out.push_fmt(f\" {nm(self.pool, self.enames[st.b])} = \");\n");
        buf_str(out, c"            self.lval(m, f, st.a);\n");
        buf_str(out, c"            self.p(\";\");\n");
        buf_str(out, c"            self.line();\n");
        buf_str(out, c"            self.p(\"metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);\");\n");
        buf_str(out, c"        } else if op == S_CALL {\n");
        buf_str(out, c"            if st.d >= 0 {\n");
        buf_str(out, c"                self.pty(m, f.exprs[st.d].ty);\n");
        buf_str(out, c"                self.out.push_fmt(f\" {nm(self.pool, self.enames[st.d])} = \");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.call(m, f, st.a, st.b, st.c);\n");
        buf_str(out, c"            self.p(\";\");\n");
        buf_str(out, c"        } else if op == S_ATOMIC {\n");
        buf_str(out, c"            self.atomic(m, f, s);\n");
        buf_str(out, c"        } else if op == S_IMAGE_STORE {\n");
        buf_str(out, c"            let tex = self.enames_or_global(m, f, st.a);\n");
        buf_str(out, c"            self.p(\"if (metal::all(metal::uint2(\");\n");
        buf_str(out, c"            self.val(m, f, st.b);\n");
        buf_str(out, c"            self.out.push_fmt(\n");
        buf_str(out, c"                f\") < metal::uint2({nm(self.pool, tex)}.get_width(), {nm(self.pool, tex)}.get_height()))) {{ {nm(self.pool, tex)}.write(\");\n");
        buf_str(out, c"            self.val(m, f, st.c);\n");
        buf_str(out, c"            self.p(\", metal::uint2(\");\n");
        buf_str(out, c"            self.val(m, f, st.b);\n");
        buf_str(out, c"            self.p(\")); }\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn atomic(inout self, m: Module, f: Function, s: i64) {\n");
        buf_str(out, c"        let st = f.stmts[s];\n");
        buf_str(out, c"        let g = self.has_guards(f, st.a);\n");
        buf_str(out, c"        let pt = m.types[f.exprs[st.a].ty];\n");
        buf_str(out, c"        let sk = m.types[pt.base].scalar;\n");
        buf_str(out, c"        let tn = W::scalar(sk);\n");
        buf_str(out, c"        let sp = W::space(pt.space, pt.access);\n");
        buf_str(out, c"        if st.b == AT_CMPXCHG {\n");
        buf_str(out, c"            let rty = self.ty(m, f.exprs[st.d].ty);\n");
        buf_str(out, c"            var rb = Buf::new_in(self.a);\n");
        buf_str(out, c"            rb.push_str(nm(self.pool, rty));\n");
        buf_str(out, c"            let rn = rb.as_slice();\n");
        buf_str(out, c"            let hst = self.pool.len();\n");
        buf_str(out, c"            var h = Buf::new_in(self.a);\n");
        buf_str(out, c"            h.push_fmt(f\"static inline {rn} _w_cmpxchg({sp} metal::atomic_{tn}* p, {tn} cmp, {tn} v) {{ {tn} old = cmp; bool ok = metal::atomic_compare_exchange_weak_explicit(p, &old, v, metal::memory_order_relaxed, metal::memory_order_relaxed); return {rn} {{old, ok}}; }}\\n\");\n");
        buf_str(out, c"            copy_into(&self.pool, h.as_slice());\n");
        buf_str(out, c"            let hs = self.since(hst);\n");
        buf_str(out, c"            var have = false;\n");
        buf_str(out, c"            for i in 0..self.need_cmpxchg.len() {\n");
        buf_str(out, c"                if nm(self.pool, self.need_cmpxchg[i]) == nm(self.pool, hs) {\n");
        buf_str(out, c"                    have = true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if !have {\n");
        buf_str(out, c"                self.need_cmpxchg.push(hs);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.out.push_fmt(f\"{nm(self.pool, rty)} {nm(self.pool, self.enames[st.d])} = \");\n");
        buf_str(out, c"            if g {\n");
        buf_str(out, c"                self.p(\"(\");\n");
        buf_str(out, c"                self.guards(m, f, st.a, false);\n");
        buf_str(out, c"                self.p(\") ? \");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.p(\"_w_cmpxchg(&\");\n");
        buf_str(out, c"            self.lval(m, f, st.a);\n");
        buf_str(out, c"            self.p(\", \");\n");
        buf_str(out, c"            self.val(m, f, st.e);\n");
        buf_str(out, c"            self.p(\", \");\n");
        buf_str(out, c"            self.val(m, f, st.c);\n");
        buf_str(out, c"            self.p(\")\");\n");
        buf_str(out, c"            if g {\n");
        buf_str(out, c"                self.out.push_fmt(f\" : {nm(self.pool, rty)} {{}}\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.p(\";\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if st.d >= 0 {\n");
        buf_str(out, c"            self.out.push_fmt(f\"{tn} {nm(self.pool, self.enames[st.d])} = \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if g {\n");
        buf_str(out, c"            if st.d >= 0 {\n");
        buf_str(out, c"                self.p(\"(\");\n");
        buf_str(out, c"                self.guards(m, f, st.a, false);\n");
        buf_str(out, c"                self.p(\") ? \");\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.p(\"if (\");\n");
        buf_str(out, c"                self.guards(m, f, st.a, false);\n");
        buf_str(out, c"                self.p(\") \");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.p(W::atomic_fn(st.b));\n");
        buf_str(out, c"        self.p(\"(&\");\n");
        buf_str(out, c"        self.lval(m, f, st.a);\n");
        buf_str(out, c"        if st.c >= 0 {\n");
        buf_str(out, c"            self.p(\", \");\n");
        buf_str(out, c"            self.val(m, f, st.c);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.p(\", metal::memory_order_relaxed)\");\n");
        buf_str(out, c"        if g && st.d >= 0 {\n");
        buf_str(out, c"            self.out.push_fmt(f\" : {tn}(0)\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.p(\";\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn call(inout self, m: Module, f: Function, callee: i64, start: i64, n: i64) {\n");
        buf_str(out, c"        self.pn(self.fnames[callee]);\n");
        buf_str(out, c"        self.p(\"(\");\n");
        buf_str(out, c"        var first = true;\n");
        buf_str(out, c"        for k in start..start + n {\n");
        buf_str(out, c"            if !first {\n");
        buf_str(out, c"                self.p(\", \");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            first = false;\n");
        buf_str(out, c"            let a = f.args[k];\n");
        buf_str(out, c"            if m.types[f.exprs[a].ty].kind == TK_POINTER {\n");
        buf_str(out, c"                self.p(\"&\");\n");
        buf_str(out, c"                self.lval(m, f, a);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.val(m, f, a);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for g in 0..m.globals.len() {\n");
        buf_str(out, c"            if self.uses[callee][g] {\n");
        buf_str(out, c"                if !first {\n");
        buf_str(out, c"                    self.p(\", \");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                first = false;\n");
        buf_str(out, c"                self.pn(self.gnames[g]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if needs_sizes(self, m, callee) {\n");
        buf_str(out, c"            if !first {\n");
        buf_str(out, c"                self.p(\", \");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.p(\"_w_sizes\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.p(\")\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn ret(inout self, m: Module, f: Function, e: i64) {\n");
        buf_str(out, c"        if e < 0 {\n");
        buf_str(out, c"            self.p(\"return;\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.stage == TEST_KERNEL {\n");
        buf_str(out, c"            // a test kernel: the result into its output record\n");
        buf_str(out, c"            self.p(\"{ _w_out[_w_tid] = \");\n");
        buf_str(out, c"            self.val(m, f, e);\n");
        buf_str(out, c"            self.p(\"; return; }\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.stage == 255 || self.stage == STAGE_COMPUTE as i64 {\n");
        buf_str(out, c"            self.p(\"return \");\n");
        buf_str(out, c"            self.val(m, f, e);\n");
        buf_str(out, c"            self.p(\";\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // an entry point's result: into its output struct\n");
        buf_str(out, c"        let rt = m.types[self.ret_ty];\n");
        buf_str(out, c"        self.p(\"{ const auto _w_r = \");\n");
        buf_str(out, c"        self.val(m, f, e);\n");
        buf_str(out, c"        self.out.push_fmt(f\"; return {nm(self.pool, self.out_name)} {{ \");\n");
        buf_str(out, c"        if rt.kind == TK_STRUCT && f.result_binding.kind == ir::BIND_NONE {\n");
        buf_str(out, c"            for k in 0..rt.mcount {\n");
        buf_str(out, c"                if k > 0 {\n");
        buf_str(out, c"                    self.p(\", \");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let _n8 = self.escape(m.members[rt.mstart + k].name);\n");
        buf_str(out, c"                self.out.push_fmt(f\"_w_r.{nm(self.pool, _n8)}\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.p(\"_w_r\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.p(\" }; }\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Shader compiler implementation, msl: Functions and entry points (0.22) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn start_fn(w: inout W, m: Module, h: i64) {\n");
        buf_str(out, c"    let f = m.functions[h];\n");
        buf_str(out, c"    w.fh = h;\n");
        buf_str(out, c"    w.used.clear();\n");
        buf_str(out, c"    w.loop_n = 0;\n");
        buf_str(out, c"    // the module-scope names stay reserved\n");
        buf_str(out, c"    for k in 0..w.fnames.len() {\n");
        buf_str(out, c"        let n = w.fnames[k];\n");
        buf_str(out, c"        w.used.push(n);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for k in 0..w.gnames.len() {\n");
        buf_str(out, c"        let n = w.gnames[k];\n");
        buf_str(out, c"        w.used.push(n);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    count_refs(&w, f);\n");
        buf_str(out, c"    w.enames.clear();\n");
        buf_str(out, c"    for e in 0..f.exprs.len() {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        if x.op == E_ARG {\n");
        buf_str(out, c"            let n = w.unique(f.params[x.a].name);\n");
        buf_str(out, c"            w.enames.push(n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        else if w.baked[e] || x.op == E_CALL_RESULT || x.op == E_ATOMIC_RESULT\n");
        buf_str(out, c"            || x.op == E_WG_UNIFORM_RESULT {\n");
        buf_str(out, c"            if f.names[e].len > 0 {\n");
        buf_str(out, c"                let n = w.unique(f.names[e]);\n");
        buf_str(out, c"                w.enames.push(n);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                let st = w.pool.len();\n");
        buf_str(out, c"                w.pool.push_fmt(f\"_e{e}\");\n");
        buf_str(out, c"                let n = w.since(st);\n");
        buf_str(out, c"                w.enames.push(n);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            w.enames.push(Nm { start: 0, len: 0 });\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    w.lnames.clear();\n");
        buf_str(out, c"    for l in 0..f.locals.len() {\n");
        buf_str(out, c"        let n = w.unique(f.locals[l].name);\n");
        buf_str(out, c"        w.lnames.push(n);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The parameter list's global part: each global the function uses.\n");
        buf_str(out, c"fn global_params(w: inout W, m: Module, h: i64, first: bool) -> bool {\n");
        buf_str(out, c"    var fst = first;\n");
        buf_str(out, c"    for g in 0..m.globals.len() {\n");
        buf_str(out, c"        if !w.uses[h][g] {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if !fst {\n");
        buf_str(out, c"            w.p(\", \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        fst = false;\n");
        buf_str(out, c"        let gl = m.globals[g];\n");
        buf_str(out, c"        let tk = m.types[gl.ty].kind;\n");
        buf_str(out, c"        if gl.space == SP_HANDLE {\n");
        buf_str(out, c"            w.pty(m, gl.ty);\n");
        buf_str(out, c"            w.p(\" \");\n");
        buf_str(out, c"        } else if tk == TK_ARRAY && m.types[gl.ty].n == 0 {\n");
        buf_str(out, c"            let _n9 = w.ty(m, m.types[gl.ty].base);\n");
        buf_str(out, c"            w.out.push_fmt(f\"{W::space(gl.space, gl.access)} {nm(w.pool, _n9)}* \");\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            let _n10 = w.ty(m, gl.ty);\n");
        buf_str(out, c"            w.out.push_fmt(f\"{W::space(gl.space, gl.access)} {nm(w.pool, _n10)}& \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        w.pn(w.gnames[g]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if needs_sizes(w, m, h) {\n");
        buf_str(out, c"        if !fst {\n");
        buf_str(out, c"            w.p(\", \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        fst = false;\n");
        buf_str(out, c"        w.p(\"constant uint* _w_sizes\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    fst\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn declare_locals(w: inout W, m: Module, f: Function) {\n");
        buf_str(out, c"    for l in 0..f.locals.len() {\n");
        buf_str(out, c"        w.line();\n");
        buf_str(out, c"        let _n11 = w.ty(m, f.locals[l].ty);\n");
        buf_str(out, c"        w.out.push_fmt(f\"{nm(w.pool, _n11)} {nm(w.pool, w.lnames[l])} = {{}};\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn write_fn(w: inout W, m: Module, h: i64) {\n");
        buf_str(out, c"    let f = m.functions[h];\n");
        buf_str(out, c"    start_fn(&w, m, h);\n");
        buf_str(out, c"    w.stage = 255;\n");
        buf_str(out, c"    w.p(\"\\n\");\n");
        buf_str(out, c"    if f.result >= 0 {\n");
        buf_str(out, c"        w.pty(m, f.result);\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        w.p(\"void\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    w.out.push_fmt(f\" {nm(w.pool, w.fnames[h])}(\");\n");
        buf_str(out, c"    var first = true;\n");
        buf_str(out, c"    for k in 0..f.params.len() {\n");
        buf_str(out, c"        if !first {\n");
        buf_str(out, c"            w.p(\", \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        first = false;\n");
        buf_str(out, c"        let pt = m.types[f.params[k].ty];\n");
        buf_str(out, c"        let ae = arg_expr(f, k);\n");
        buf_str(out, c"        let pname = if ae >= 0 { w.enames[ae] } else { w.unique(f.params[k].name) };\n");
        buf_str(out, c"        if pt.kind == TK_POINTER {\n");
        buf_str(out, c"            let _n12 = w.ty(m, pt.base);\n");
        buf_str(out, c"            w.out.push_fmt(f\"thread {nm(w.pool, _n12)}* {nm(w.pool, pname)}\");\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            let _n13 = w.ty(m, f.params[k].ty);\n");
        buf_str(out, c"            w.out.push_fmt(f\"{nm(w.pool, _n13)} {nm(w.pool, pname)}\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    global_params(&w, m, h, first);\n");
        buf_str(out, c"    w.p(\") {\");\n");
        buf_str(out, c"    w.indent = 1;\n");
        buf_str(out, c"    declare_locals(&w, m, f);\n");
        buf_str(out, c"    w.block(m, f, f.body);\n");
        buf_str(out, c"    w.indent = 0;\n");
        buf_str(out, c"    w.p(\"\\n}\\n\");\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn arg_expr(f: Function, k: i64) -> i64 {\n");
        buf_str(out, c"    for e in 0..f.exprs.len() {\n");
        buf_str(out, c"        if f.exprs[e].op == E_ARG && f.exprs[e].a == k {\n");
        buf_str(out, c"            return e;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    -1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn builtin_attr(b: i64) -> [u8] {\n");
        buf_str(out, c"    if b == BI_POSITION {\n");
        buf_str(out, c"        \"position\"\n");
        buf_str(out, c"    } else if b == BI_VERTEX_INDEX {\n");
        buf_str(out, c"        \"vertex_id\"\n");
        buf_str(out, c"    } else if b == BI_INSTANCE_INDEX {\n");
        buf_str(out, c"        \"instance_id\"\n");
        buf_str(out, c"    } else if b == BI_FRONT_FACING {\n");
        buf_str(out, c"        \"front_facing\"\n");
        buf_str(out, c"    } else if b == BI_FRAG_DEPTH {\n");
        buf_str(out, c"        \"depth(any)\"\n");
        buf_str(out, c"    } else if b == BI_SAMPLE_INDEX {\n");
        buf_str(out, c"        \"sample_id\"\n");
        buf_str(out, c"    } else if b == BI_SAMPLE_MASK {\n");
        buf_str(out, c"        \"sample_mask\"\n");
        buf_str(out, c"    } else if b == BI_LOCAL_INVOCATION_ID {\n");
        buf_str(out, c"        \"thread_position_in_threadgroup\"\n");
        buf_str(out, c"    } else if b == BI_LOCAL_INVOCATION_INDEX {\n");
        buf_str(out, c"        \"thread_index_in_threadgroup\"\n");
        buf_str(out, c"    } else if b == BI_GLOBAL_INVOCATION_ID {\n");
        buf_str(out, c"        \"thread_position_in_grid\"\n");
        buf_str(out, c"    } else if b == BI_WORKGROUP_ID {\n");
        buf_str(out, c"        \"threadgroup_position_in_grid\"\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        \"threadgroups_per_grid\"\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn interp_attr(b: Binding) -> [u8] {\n");
        buf_str(out, c"    if b.interp == INTERP_FLAT {\n");
        buf_str(out, c"        \", flat\"\n");
        buf_str(out, c"    } else if b.interp == INTERP_LINEAR {\n");
        buf_str(out, c"        \", center_no_perspective\"\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        \"\"\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// One IO value of an entry point: as a stage_in member (`in_struct`) or a\n");
        buf_str(out, c"// parameter.\n");
        buf_str(out, c"fn io_decl(w: inout W, m: Module, stage: u8, ty: i64, b: Binding, name: [u8], output: bool) {\n");
        buf_str(out, c"    w.pty(m, ty);\n");
        buf_str(out, c"    w.out.push_fmt(f\" {name} [[\");\n");
        buf_str(out, c"    if b.kind == BIND_BUILTIN {\n");
        buf_str(out, c"        w.p(builtin_attr(b.value));\n");
        buf_str(out, c"    } else if stage == STAGE_VERTEX && !output {\n");
        buf_str(out, c"        w.out.push_fmt(f\"attribute({b.value})\");\n");
        buf_str(out, c"    } else if stage == STAGE_FRAGMENT && output {\n");
        buf_str(out, c"        w.out.push_fmt(f\"color({b.value})\");\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        w.out.push_fmt(f\"user(loc{b.value}){interp_attr(b)}\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    w.p(\"]]\");\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn uses_workgroup(w: W, m: Module, h: i64) -> bool {\n");
        buf_str(out, c"    for g in 0..m.globals.len() {\n");
        buf_str(out, c"        if w.uses[h][g] && m.globals[g].space == SP_WORKGROUP {\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    false\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Zeroes a workgroup variable (atomics by atomic stores).\n");
        buf_str(out, c"fn zero_workgroup(w: inout W, m: Module, lv: [u8], t: i64, depth: i64) {\n");
        buf_str(out, c"    if !m.has_atomic(t) {\n");
        buf_str(out, c"        w.line();\n");
        buf_str(out, c"        let _n14 = w.ty(m, t);\n");
        buf_str(out, c"        w.out.push_fmt(f\"{lv} = {nm(w.pool, _n14)} {{}};\");\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let ty = m.types[t];\n");
        buf_str(out, c"    if ty.kind == TK_ATOMIC {\n");
        buf_str(out, c"        w.line();\n");
        buf_str(out, c"        w.out.push_fmt(f\"metal::atomic_store_explicit(&{lv}, 0, metal::memory_order_relaxed);\");\n");
        buf_str(out, c"    } else if ty.kind == TK_ARRAY {\n");
        buf_str(out, c"        w.line();\n");
        buf_str(out, c"        w.out.push_fmt(f\"for (uint _w_i{depth} = 0u; _w_i{depth} < {ty.n}u; _w_i{depth}++) {{\");\n");
        buf_str(out, c"        w.indent += 1;\n");
        buf_str(out, c"        var b = Buf::new_in(w.a);\n");
        buf_str(out, c"        b.push_fmt(f\"{lv}.inner[_w_i{depth}]\");\n");
        buf_str(out, c"        zero_workgroup(&w, m, b.as_slice(), ty.base, depth + 1);\n");
        buf_str(out, c"        w.indent -= 1;\n");
        buf_str(out, c"        w.line();\n");
        buf_str(out, c"        w.p(\"}\");\n");
        buf_str(out, c"    } else if ty.kind == TK_STRUCT {\n");
        buf_str(out, c"        for k in ty.mstart..ty.mstart + ty.mcount {\n");
        buf_str(out, c"            var b = Buf::new_in(w.a);\n");
        buf_str(out, c"            let _n15 = w.escape(m.members[k].name);\n");
        buf_str(out, c"            b.push_fmt(f\"{lv}.{nm(w.pool, _n15)}\");\n");
        buf_str(out, c"            zero_workgroup(&w, m, b.as_slice(), m.members[k].ty, depth);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn write_entry(w: inout W, m: Module, ei: i64) {\n");
        buf_str(out, c"    let en = m.entries[ei];\n");
        buf_str(out, c"    let h = en.func;\n");
        buf_str(out, c"    let f = m.functions[h];\n");
        buf_str(out, c"    start_fn(&w, m, h);\n");
        buf_str(out, c"    w.stage = en.stage as i64;\n");
        buf_str(out, c"    w.ret_ty = f.result;\n");
        buf_str(out, c"    let ename = w.fnames[h];\n");
        buf_str(out, c"    // the stage_in struct: location inputs of vertex and fragment shaders\n");
        buf_str(out, c"    var in_buf = Buf::new_in(w.a);\n");
        buf_str(out, c"    if en.stage != STAGE_COMPUTE {\n");
        buf_str(out, c"        var any = false;\n");
        buf_str(out, c"        let saved = std::replace(&w.out, Buf::new_in(w.a));\n");
        buf_str(out, c"        for k in 0..f.params.len() {\n");
        buf_str(out, c"            let pt = m.types[f.params[k].ty];\n");
        buf_str(out, c"            if pt.kind == TK_STRUCT && f.params[k].binding.kind == ir::BIND_NONE {\n");
        buf_str(out, c"                for j in pt.mstart..pt.mstart + pt.mcount {\n");
        buf_str(out, c"                    let mem = m.members[j];\n");
        buf_str(out, c"                    if mem.binding.kind == BIND_LOCATION\n");
        buf_str(out, c"                        || (mem.binding.kind == BIND_BUILTIN && mem.binding.value == BI_POSITION\n");
        buf_str(out, c"                            && en.stage == STAGE_FRAGMENT) {\n");
        buf_str(out, c"                        w.p(\"\\n    \");\n");
        buf_str(out, c"                        var nb = Buf::new_in(w.a);\n");
        buf_str(out, c"                        nb.push_fmt(f\"_w_p{k}_{j - pt.mstart}\");\n");
        buf_str(out, c"                        io_decl(&w, m, en.stage, mem.ty, mem.binding, nb.as_slice(), false);\n");
        buf_str(out, c"                        w.p(\";\");\n");
        buf_str(out, c"                        any = true;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            else if f.params[k].binding.kind == BIND_LOCATION\n");
        buf_str(out, c"                || (f.params[k].binding.kind == BIND_BUILTIN\n");
        buf_str(out, c"                    && f.params[k].binding.value == BI_POSITION && en.stage == STAGE_FRAGMENT) {\n");
        buf_str(out, c"                w.p(\"\\n    \");\n");
        buf_str(out, c"                var nb = Buf::new_in(w.a);\n");
        buf_str(out, c"                nb.push_fmt(f\"_w_p{k}\");\n");
        buf_str(out, c"                io_decl(&w, m, en.stage, f.params[k].ty, f.params[k].binding, nb.as_slice(), false);\n");
        buf_str(out, c"                w.p(\";\");\n");
        buf_str(out, c"                any = true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let sb = std::replace(&w.out, saved);\n");
        buf_str(out, c"        if any {\n");
        buf_str(out, c"            in_buf.push_str(nm(w.pool, ename));\n");
        buf_str(out, c"            in_buf.push_str(\"_Input\");\n");
        buf_str(out, c"            w.out.push_str(\"\\nstruct \");\n");
        buf_str(out, c"            copy_into(&w.out, in_buf.as_slice());\n");
        buf_str(out, c"            w.out.push_str(\" {\");\n");
        buf_str(out, c"            copy_into(&w.out, sb.as_slice());\n");
        buf_str(out, c"            w.out.push_str(\"\\n};\\n\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // the output struct\n");
        buf_str(out, c"        if f.result >= 0 {\n");
        buf_str(out, c"            var nb = Buf::new_in(w.a);\n");
        buf_str(out, c"            nb.push_str(nm(w.pool, ename));\n");
        buf_str(out, c"            nb.push_str(\"_Output\");\n");
        buf_str(out, c"            w.out_name = w.intern(nb.as_slice());\n");
        buf_str(out, c"            w.out.push_fmt(f\"\\nstruct {nm(w.pool, w.out_name)} {{\");\n");
        buf_str(out, c"            let rt = m.types[f.result];\n");
        buf_str(out, c"            if rt.kind == TK_STRUCT && f.result_binding.kind == ir::BIND_NONE {\n");
        buf_str(out, c"                for j in rt.mstart..rt.mstart + rt.mcount {\n");
        buf_str(out, c"                    let mem = m.members[j];\n");
        buf_str(out, c"                    w.p(\"\\n    \");\n");
        buf_str(out, c"                    var mb = Buf::new_in(w.a);\n");
        buf_str(out, c"                    mb.push_fmt(f\"m{j - rt.mstart}\");\n");
        buf_str(out, c"                    io_decl(&w, m, en.stage, mem.ty, mem.binding, mb.as_slice(), true);\n");
        buf_str(out, c"                    w.p(\";\");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                w.p(\"\\n    \");\n");
        buf_str(out, c"                io_decl(&w, m, en.stage, f.result, f.result_binding, \"m0\", true);\n");
        buf_str(out, c"                w.p(\";\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            w.p(\"\\n};\\n\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let kw = if en.stage == STAGE_COMPUTE { \"kernel void\" }\n");
        buf_str(out, c"        else if en.stage == STAGE_VERTEX { \"vertex\" } else { \"fragment\" };\n");
        buf_str(out, c"    w.out.push_fmt(f\"\\n{kw} \");\n");
        buf_str(out, c"    if en.stage != STAGE_COMPUTE {\n");
        buf_str(out, c"        if f.result >= 0 {\n");
        buf_str(out, c"            w.out.push_fmt(f\"{nm(w.pool, w.out_name)} \");\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            w.p(\"void \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    w.out.push_fmt(f\"{nm(w.pool, ename)}(\");\n");
        buf_str(out, c"    var first = true;\n");
        buf_str(out, c"    if in_buf.len() > 0 {\n");
        buf_str(out, c"        w.out.push_fmt(f\"{in_buf.as_slice()} _w_in [[stage_in]]\");\n");
        buf_str(out, c"        first = false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // builtin inputs as parameters\n");
        buf_str(out, c"    var has_lid = false;\n");
        buf_str(out, c"    for k in 0..f.params.len() {\n");
        buf_str(out, c"        let pt = m.types[f.params[k].ty];\n");
        buf_str(out, c"        if pt.kind == TK_STRUCT && f.params[k].binding.kind == ir::BIND_NONE {\n");
        buf_str(out, c"            for j in pt.mstart..pt.mstart + pt.mcount {\n");
        buf_str(out, c"                let mem = m.members[j];\n");
        buf_str(out, c"                if mem.binding.kind == BIND_BUILTIN\n");
        buf_str(out, c"                    && !(mem.binding.value == BI_POSITION && en.stage == STAGE_FRAGMENT) {\n");
        buf_str(out, c"                    if !first {\n");
        buf_str(out, c"                        w.p(\", \");\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    first = false;\n");
        buf_str(out, c"                    var nb = Buf::new_in(w.a);\n");
        buf_str(out, c"                    nb.push_fmt(f\"_w_p{k}_{j - pt.mstart}\");\n");
        buf_str(out, c"                    io_decl(&w, m, en.stage, mem.ty, mem.binding, nb.as_slice(), false);\n");
        buf_str(out, c"                    if mem.binding.value == BI_LOCAL_INVOCATION_INDEX {\n");
        buf_str(out, c"                        has_lid = true;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        else if f.params[k].binding.kind == BIND_BUILTIN\n");
        buf_str(out, c"            && !(f.params[k].binding.value == BI_POSITION && en.stage == STAGE_FRAGMENT) {\n");
        buf_str(out, c"            if !first {\n");
        buf_str(out, c"                w.p(\", \");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            first = false;\n");
        buf_str(out, c"            var nb = Buf::new_in(w.a);\n");
        buf_str(out, c"            nb.push_fmt(f\"_w_p{k}\");\n");
        buf_str(out, c"            io_decl(&w, m, en.stage, f.params[k].ty, f.params[k].binding, nb.as_slice(), false);\n");
        buf_str(out, c"            if f.params[k].binding.value == BI_LOCAL_INVOCATION_INDEX {\n");
        buf_str(out, c"                has_lid = true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let wg = en.stage == STAGE_COMPUTE && uses_workgroup(w, m, h);\n");
        buf_str(out, c"    if wg && !has_lid {\n");
        buf_str(out, c"        if !first {\n");
        buf_str(out, c"            w.p(\", \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        first = false;\n");
        buf_str(out, c"        w.p(\"uint _w_lindex [[thread_index_in_threadgroup]]\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // resources\n");
        buf_str(out, c"    for g in 0..m.globals.len() {\n");
        buf_str(out, c"        if !w.uses[h][g] {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let gl = m.globals[g];\n");
        buf_str(out, c"        if gl.space == SP_PRIVATE || gl.space == SP_WORKGROUP {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if !first {\n");
        buf_str(out, c"            w.p(\", \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        first = false;\n");
        buf_str(out, c"        let tk = m.types[gl.ty].kind;\n");
        buf_str(out, c"        let slot = w.sl.slot[en.stage as i64 * m.globals.len() + g];\n");
        buf_str(out, c"        if gl.space == SP_HANDLE {\n");
        buf_str(out, c"            let _n16 = w.ty(m, gl.ty);\n");
        buf_str(out, c"            w.out.push_fmt(\n");
        buf_str(out, c"                f\"{nm(w.pool, _n16)} {nm(w.pool, w.gnames[g])} [[{if tk == TK_TEXTURE { \"texture\" } else { \"sampler\" }}({slot})]]\");\n");
        buf_str(out, c"        } else if tk == TK_ARRAY && m.types[gl.ty].n == 0 {\n");
        buf_str(out, c"            let _n17 = w.ty(m, m.types[gl.ty].base);\n");
        buf_str(out, c"            w.out.push_fmt(\n");
        buf_str(out, c"                f\"{W::space(gl.space, gl.access)} {nm(w.pool, _n17)}* {nm(w.pool, w.gnames[g])} [[buffer({slot})]]\");\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            let _n18 = w.ty(m, gl.ty);\n");
        buf_str(out, c"            w.out.push_fmt(\n");
        buf_str(out, c"                f\"{W::space(gl.space, gl.access)} {nm(w.pool, _n18)}& {nm(w.pool, w.gnames[g])} [[buffer({slot})]]\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if needs_sizes(w, m, h) {\n");
        buf_str(out, c"        if !first {\n");
        buf_str(out, c"            w.p(\", \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        w.out.push_fmt(f\"constant uint* _w_sizes [[buffer({w.sl.sizes_slot[en.stage as i64]})]]\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    w.p(\") {\");\n");
        buf_str(out, c"    w.indent = 1;\n");
        buf_str(out, c"    // private and workgroup variables\n");
        buf_str(out, c"    for g in 0..m.globals.len() {\n");
        buf_str(out, c"        if !w.uses[h][g] {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let gl = m.globals[g];\n");
        buf_str(out, c"        if gl.space == SP_PRIVATE {\n");
        buf_str(out, c"            w.line();\n");
        buf_str(out, c"            let _n19 = w.ty(m, gl.ty);\n");
        buf_str(out, c"            w.out.push_fmt(f\"{nm(w.pool, _n19)} {nm(w.pool, w.gnames[g])} = \");\n");
        buf_str(out, c"            if gl.init >= 0 {\n");
        buf_str(out, c"                write_const(&w, m, gl.init);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                let _n20 = w.ty(m, gl.ty);\n");
        buf_str(out, c"                w.out.push_fmt(f\"{nm(w.pool, _n20)} {{}}\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            w.p(\";\");\n");
        buf_str(out, c"        } else if gl.space == SP_WORKGROUP {\n");
        buf_str(out, c"            w.line();\n");
        buf_str(out, c"            let _n21 = w.ty(m, gl.ty);\n");
        buf_str(out, c"            w.out.push_fmt(f\"threadgroup {nm(w.pool, _n21)} {nm(w.pool, w.gnames[g])};\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if wg {\n");
        buf_str(out, c"        let lid = if has_lid { lid_name(&w, m, f) } else { w.intern(\"_w_lindex\") };\n");
        buf_str(out, c"        w.line();\n");
        buf_str(out, c"        w.out.push_fmt(f\"if ({nm(w.pool, lid)} == 0u) {{\");\n");
        buf_str(out, c"        w.indent += 1;\n");
        buf_str(out, c"        for g in 0..m.globals.len() {\n");
        buf_str(out, c"            if w.uses[h][g] && m.globals[g].space == SP_WORKGROUP {\n");
        buf_str(out, c"                var lb = Buf::new_in(w.a);\n");
        buf_str(out, c"                lb.push_str(nm(w.pool, w.gnames[g]));\n");
        buf_str(out, c"                zero_workgroup(&w, m, lb.as_slice(), m.globals[g].ty, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        w.indent -= 1;\n");
        buf_str(out, c"        w.line();\n");
        buf_str(out, c"        w.p(\"}\");\n");
        buf_str(out, c"        w.line();\n");
        buf_str(out, c"        w.p(\"metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // the parameters as WGSL sees them\n");
        buf_str(out, c"    for k in 0..f.params.len() {\n");
        buf_str(out, c"        let ae = arg_expr(f, k);\n");
        buf_str(out, c"        if ae < 0 {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let pt = m.types[f.params[k].ty];\n");
        buf_str(out, c"        w.line();\n");
        buf_str(out, c"        if pt.kind == TK_STRUCT && f.params[k].binding.kind == ir::BIND_NONE {\n");
        buf_str(out, c"            let _n22 = w.ty(m, f.params[k].ty);\n");
        buf_str(out, c"            w.out.push_fmt(f\"{nm(w.pool, _n22)} {nm(w.pool, w.enames[ae])} = {{}};\");\n");
        buf_str(out, c"            for j in pt.mstart..pt.mstart + pt.mcount {\n");
        buf_str(out, c"                let mem = m.members[j];\n");
        buf_str(out, c"                let from_in = mem.binding.kind == BIND_LOCATION\n");
        buf_str(out, c"                    || (mem.binding.kind == BIND_BUILTIN && mem.binding.value == BI_POSITION\n");
        buf_str(out, c"                        && en.stage == STAGE_FRAGMENT);\n");
        buf_str(out, c"                w.line();\n");
        buf_str(out, c"                let _n23 = w.escape(mem.name);\n");
        buf_str(out, c"                w.out.push_fmt(\n");
        buf_str(out, c"                    f\"{nm(w.pool, w.enames[ae])}.{nm(w.pool, _n23)} = {if from_in { \"_w_in.\" } else { \"\" }}_w_p{k}_{j - pt.mstart};\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            let from_in = f.params[k].binding.kind == BIND_LOCATION\n");
        buf_str(out, c"                || (f.params[k].binding.kind == BIND_BUILTIN\n");
        buf_str(out, c"                    && f.params[k].binding.value == BI_POSITION && en.stage == STAGE_FRAGMENT);\n");
        buf_str(out, c"            let _n24 = w.ty(m, f.params[k].ty);\n");
        buf_str(out, c"            w.out.push_fmt(\n");
        buf_str(out, c"                f\"{nm(w.pool, _n24)} {nm(w.pool, w.enames[ae])} = {if from_in { \"_w_in.\" } else { \"\" }}_w_p{k};\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    declare_locals(&w, m, f);\n");
        buf_str(out, c"    w.block(m, f, f.body);\n");
        buf_str(out, c"    w.indent = 0;\n");
        buf_str(out, c"    w.p(\"\\n}\\n\");\n");
        buf_str(out, c"    w.stage = 255;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn lid_name(w: inout W, m: Module, f: Function) -> Nm {\n");
        buf_str(out, c"    for k in 0..f.params.len() {\n");
        buf_str(out, c"        let pt = m.types[f.params[k].ty];\n");
        buf_str(out, c"        if pt.kind == TK_STRUCT && f.params[k].binding.kind == ir::BIND_NONE {\n");
        buf_str(out, c"            for j in pt.mstart..pt.mstart + pt.mcount {\n");
        buf_str(out, c"                let mem = m.members[j];\n");
        buf_str(out, c"                if mem.binding.kind == BIND_BUILTIN\n");
        buf_str(out, c"                    && mem.binding.value == BI_LOCAL_INVOCATION_INDEX {\n");
        buf_str(out, c"                    let st = w.pool.len();\n");
        buf_str(out, c"                    w.pool.push_fmt(f\"_w_p{k}_{j - pt.mstart}\");\n");
        buf_str(out, c"                    return w.since(st);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        else if f.params[k].binding.kind == BIND_BUILTIN\n");
        buf_str(out, c"            && f.params[k].binding.value == BI_LOCAL_INVOCATION_INDEX {\n");
        buf_str(out, c"            let st = w.pool.len();\n");
        buf_str(out, c"            w.pool.push_fmt(f\"_w_p{k}\");\n");
        buf_str(out, c"            return w.since(st);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    w.intern(\"_w_lindex\")\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A private global's initializer: an expression of the module's constants.\n");
        buf_str(out, c"fn write_const(w: inout W, m: Module, e: i64) {\n");
        buf_str(out, c"    let nb: V<bool> = Vec::filled_in(m.consts.exprs.len(), false, w.a);\n");
        buf_str(out, c"    let nn: V<Nm> = Vec::filled_in(m.consts.exprs.len(), Nm { start: 0, len: 0 }, w.a);\n");
        buf_str(out, c"    let saved_baked = std::replace(&w.baked, nb);\n");
        buf_str(out, c"    let saved_names = std::replace(&w.enames, nn);\n");
        buf_str(out, c"    w.render(m, m.consts, e);\n");
        buf_str(out, c"    w.baked = saved_baked;\n");
        buf_str(out, c"    w.enames = saved_names;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Shader compiler implementation, msl: Test kernels (0.22) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The stage of a test kernel being written.\n");
        buf_str(out, c"const TEST_KERNEL: i64 = 254;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Entry point ei (a vertex or fragment one) as a kernel, `NAME_w_test`:\n");
        buf_str(out, c"// invocation i reads its parameters from input record i (their record\n");
        buf_str(out, c"// offsets: ir::record_offsets) and writes its result into output record\n");
        buf_str(out, c"// i, so its body runs on Metal as the interpreter runs it alone. Its\n");
        buf_str(out, c"// slots: buffers from 0 in (group, binding) order, then the input, the\n");
        buf_str(out, c"// output and the sizes buffer; textures and samplers from 0.\n");
        buf_str(out, c"fn write_test_kernel(w: inout W, m: Module, ei: i64) -> [i64; 3] {\n");
        buf_str(out, c"    let en = m.entries[ei];\n");
        buf_str(out, c"    let h = en.func;\n");
        buf_str(out, c"    let f = m.functions[h];\n");
        buf_str(out, c"    start_fn(&w, m, h);\n");
        buf_str(out, c"    w.stage = TEST_KERNEL;\n");
        buf_str(out, c"    w.ret_ty = f.result;\n");
        buf_str(out, c"    let ename = w.fnames[h];\n");
        buf_str(out, c"    let offs = ir::record_offsets(m, h, w.a);\n");
        buf_str(out, c"    // the input record\n");
        buf_str(out, c"    var rec = Buf::new_in(w.a);\n");
        buf_str(out, c"    rec.push_str(nm(w.pool, ename));\n");
        buf_str(out, c"    rec.push_str(\"_w_In\");\n");
        buf_str(out, c"    let rn = w.intern(rec.as_slice());\n");
        buf_str(out, c"    var b = Buf::new_in(w.a);\n");
        buf_str(out, c"    b.push_str(\"struct \");\n");
        buf_str(out, c"    b.push_str(nm(w.pool, rn));\n");
        buf_str(out, c"    b.push_str(\" {\\n\");\n");
        buf_str(out, c"    var off = 0;\n");
        buf_str(out, c"    for k in 0..f.params.len() {\n");
        buf_str(out, c"        if offs[k] > off {\n");
        buf_str(out, c"            b.push_fmt(f\"    char _pad{k}[{offs[k] - off}];\\n\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let mt = w.member_ty(m, f.params[k].ty);\n");
        buf_str(out, c"        b.push_fmt(f\"    {nm(w.pool, mt)} p{k};\\n\");\n");
        buf_str(out, c"        off = offs[k] + m.types[f.params[k].ty].size;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let stride = offs[f.params.len()];\n");
        buf_str(out, c"    if stride > off {\n");
        buf_str(out, c"        b.push_fmt(f\"    char _padend[{stride - off}];\\n\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    b.push_str(\"};\\n\");\n");
        buf_str(out, c"    copy_into(&w.types_out, b.as_slice());\n");
        buf_str(out, c"    let rt = if f.result >= 0 { w.ty(m, f.result) } else { w.intern(\"uint\") };\n");
        buf_str(out, c"    w.out.push_fmt(\n");
        buf_str(out, c"        f\"\\nkernel void {nm(w.pool, ename)}_w_test(uint _w_tid [[threadgroup_position_in_grid]]\");\n");
        buf_str(out, c"    let order = binding_order(m, w.a);\n");
        buf_str(out, c"    var nb = 0;\n");
        buf_str(out, c"    var nt = 0;\n");
        buf_str(out, c"    var ns = 0;\n");
        buf_str(out, c"    for k in 0..order.len() {\n");
        buf_str(out, c"        let g = order[k];\n");
        buf_str(out, c"        if !w.uses[h][g] {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let gl = m.globals[g];\n");
        buf_str(out, c"        if gl.space == SP_PRIVATE || gl.space == SP_WORKGROUP {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        w.p(\", \");\n");
        buf_str(out, c"        let kind = m.types[gl.ty].kind;\n");
        buf_str(out, c"        if gl.space == SP_HANDLE {\n");
        buf_str(out, c"            let tn = w.ty(m, gl.ty);\n");
        buf_str(out, c"            let tex = kind == TK_TEXTURE;\n");
        buf_str(out, c"            let slot = if tex { nt } else { ns };\n");
        buf_str(out, c"            w.out.push_fmt(\n");
        buf_str(out, c"                f\"{nm(w.pool, tn)} {nm(w.pool, w.gnames[g])} [[{if tex { \"texture\" } else { \"sampler\" }}({slot})]]\");\n");
        buf_str(out, c"            if tex {\n");
        buf_str(out, c"                nt += 1;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                ns += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if kind == TK_ARRAY && m.types[gl.ty].n == 0 {\n");
        buf_str(out, c"            let tn = w.ty(m, m.types[gl.ty].base);\n");
        buf_str(out, c"            w.out.push_fmt(\n");
        buf_str(out, c"                f\"{W::space(gl.space, gl.access)} {nm(w.pool, tn)}* {nm(w.pool, w.gnames[g])} [[buffer({nb})]]\");\n");
        buf_str(out, c"            nb += 1;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            let tn = w.ty(m, gl.ty);\n");
        buf_str(out, c"            w.out.push_fmt(\n");
        buf_str(out, c"                f\"{W::space(gl.space, gl.access)} {nm(w.pool, tn)}& {nm(w.pool, w.gnames[g])} [[buffer({nb})]]\");\n");
        buf_str(out, c"            nb += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    w.out.push_fmt(\n");
        buf_str(out, c"        f\", const device {nm(w.pool, rn)}* _w_in [[buffer({nb})]], device {nm(w.pool, rt)}* _w_out [[buffer({nb + 1})]]\");\n");
        buf_str(out, c"    var sizes = -1;\n");
        buf_str(out, c"    if needs_sizes(w, m, h) {\n");
        buf_str(out, c"        sizes = nb + 2;\n");
        buf_str(out, c"        w.out.push_fmt(f\", constant uint* _w_sizes [[buffer({sizes})]]\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    w.p(\") {\");\n");
        buf_str(out, c"    w.indent = 1;\n");
        buf_str(out, c"    for g in 0..m.globals.len() {\n");
        buf_str(out, c"        if w.uses[h][g] && m.globals[g].space == SP_PRIVATE {\n");
        buf_str(out, c"            let gl = m.globals[g];\n");
        buf_str(out, c"            w.line();\n");
        buf_str(out, c"            let tn = w.ty(m, gl.ty);\n");
        buf_str(out, c"            w.out.push_fmt(f\"{nm(w.pool, tn)} {nm(w.pool, w.gnames[g])} = \");\n");
        buf_str(out, c"            if gl.init >= 0 {\n");
        buf_str(out, c"                write_const(&w, m, gl.init);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                w.out.push_fmt(f\"{nm(w.pool, tn)} {{}}\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            w.p(\";\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for k in 0..f.params.len() {\n");
        buf_str(out, c"        let ae = arg_expr(f, k);\n");
        buf_str(out, c"        if ae < 0 {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        w.line();\n");
        buf_str(out, c"        let tn = w.ty(m, f.params[k].ty);\n");
        buf_str(out, c"        w.out.push_fmt(f\"{nm(w.pool, tn)} {nm(w.pool, w.enames[ae])} = _w_in[_w_tid].p{k};\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    declare_locals(&w, m, f);\n");
        buf_str(out, c"    w.block(m, f, f.body);\n");
        buf_str(out, c"    w.indent = 0;\n");
        buf_str(out, c"    w.p(\"\\n}\\n\");\n");
        buf_str(out, c"    w.stage = 255;\n");
        buf_str(out, c"    [nb, nb + 1, sizes]\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Shader compiler implementation, msl: Jobs for tests/wgsl/metalrun (0.22) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The MSL text of the module, for a job.\n");
        buf_str(out, c"fn module_text(m: Module, a: ScopedArena, w: inout W) -> Buf<ScopedArena> {\n");
        buf_str(out, c"    let order = call_order(m, a);\n");
        buf_str(out, c"    w.uses = global_uses(m, order, a);\n");
        buf_str(out, c"    w.sl = slots(m, w.uses, a);\n");
        buf_str(out, c"    for oi in 0..order.len() {\n");
        buf_str(out, c"        let h = order[oi];\n");
        buf_str(out, c"        var is_entry = false;\n");
        buf_str(out, c"        for e in 0..m.entries.len() {\n");
        buf_str(out, c"            if m.entries[e].func == h {\n");
        buf_str(out, c"                is_entry = true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if !is_entry {\n");
        buf_str(out, c"            write_fn(&w, m, h);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for e in 0..m.entries.len() {\n");
        buf_str(out, c"        write_entry(&w, m, e);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var text = Buf::new_in(a);\n");
        buf_str(out, c"    finish_into(w, &text);\n");
        buf_str(out, c"    text\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A job that only compiles the MSL and finds each entry point.\n");
        buf_str(out, c"pub fn metal_compile_job<A: Allocator>(m: Module, a: ScopedArena, out: inout Buf<A>) {\n");
        buf_str(out, c"    var w = new_writer(m, a);\n");
        buf_str(out, c"    let text = module_text(m, a, &w);\n");
        buf_str(out, c"    out.push_fmt(f\"msl {text.len()}\\n\");\n");
        buf_str(out, c"    out.push_str(text.as_slice());\n");
        buf_str(out, c"    out.push_str(\"\\nfunctions\");\n");
        buf_str(out, c"    for e in 0..m.entries.len() {\n");
        buf_str(out, c"        out.push_fmt(f\" {nm(w.pool, w.fnames[m.entries[e].func])}\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    out.push('\\n');\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The MSL of the module, then what metalrun needs: the entry point's\n");
        buf_str(out, c"// name, workgroup size, dispatch, and each buffer's slot and words.\n");
        buf_str(out, c"pub fn metal_job<A: Allocator>(m: Module, a: ScopedArena, ei: i64, job: job::Job,\n");
        buf_str(out, c"    out: inout Buf<A>) {\n");
        buf_str(out, c"    if job.call_n >= 0 {\n");
        buf_str(out, c"        metal_call_job(m, a, ei, job, &out);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var w = new_writer(m, a);\n");
        buf_str(out, c"    let text = module_text(m, a, &w);\n");
        buf_str(out, c"    let en = m.entries[ei];\n");
        buf_str(out, c"    out.push_fmt(f\"msl {text.len()}\\n\");\n");
        buf_str(out, c"    out.push_str(text.as_slice());\n");
        buf_str(out, c"    out.push_fmt(f\"\\nentry {nm(w.pool, w.fnames[en.func])}\\n\");\n");
        buf_str(out, c"    out.push_fmt(f\"tg {en.wg[0]} {en.wg[1]} {en.wg[2]}\\n\");\n");
        buf_str(out, c"    out.push_fmt(f\"dispatch {job.groups[0]} {job.groups[1]} {job.groups[2]}\\n\");\n");
        buf_str(out, c"    var sizes: V<i64> = Vec::filled_in(w.sl.sizes_count, 0, a);\n");
        buf_str(out, c"    for i in 0..job.buffers.len() {\n");
        buf_str(out, c"        let b = job.buffers[i];\n");
        buf_str(out, c"        let g = job::find_global(m, b.group, b.binding);\n");
        buf_str(out, c"        if w.sl.size_index[g] >= 0 {\n");
        buf_str(out, c"            sizes[w.sl.size_index[g]] = b.bytes;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out.push_fmt(\n");
        buf_str(out, c"            f\"buffer {b.group} {b.binding} {w.sl.slot[2 * m.globals.len() + g]} {b.bytes}\");\n");
        buf_str(out, c"        for k in 0..b.words.len() {\n");
        buf_str(out, c"            out.push_fmt(f\" {b.words[k]}\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out.push('\\n');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if w.sl.sizes_slot[2] >= 0 {\n");
        buf_str(out, c"        out.push_fmt(f\"sizes {w.sl.sizes_slot[2]} {sizes.len()}\");\n");
        buf_str(out, c"        for k in 0..sizes.len() {\n");
        buf_str(out, c"            out.push_fmt(f\" {sizes[k]}\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out.push('\\n');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn finish_into(w: W, out: inout Buf<ScopedArena>) {\n");
        buf_str(out, c"    var tmp = Buf::new_in(w.a);\n");
        buf_str(out, c"    let _ = tmp;\n");
        buf_str(out, c"    // finish writes to a gpa Buf in `write`; here the same text into an arena one\n");
        buf_str(out, c"    out.push_str(\n");
        buf_str(out, c"        \"// Generated by wgslc (MSL 3.0).\\n#include <metal_stdlib>\\n#include <simd/simd.h>\\n\\n\");\n");
        buf_str(out, c"    var h = Buf::new_in(w.a);\n");
        buf_str(out, c"    helpers(w, &h);\n");
        buf_str(out, c"    copy_into(&out, h.as_slice());\n");
        buf_str(out, c"    out.push('\\n');\n");
        buf_str(out, c"    copy_into(&out, w.types_out.as_slice());\n");
        buf_str(out, c"    copy_into(&out, w.out.as_slice());\n");
        buf_str(out, c"    tmp = h;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A call job: the module's MSL plus entry ei's test kernel, run once per\n");
        buf_str(out, c"// input record (one thread per threadgroup), its resources at the\n");
        buf_str(out, c"// kernel's slots.\n");
        buf_str(out, c"fn metal_call_job<A: Allocator>(m: Module, a: ScopedArena, ei: i64, job: job::Job,\n");
        buf_str(out, c"    out: inout Buf<A>) {\n");
        buf_str(out, c"    var w = new_writer(m, a);\n");
        buf_str(out, c"    let order = call_order(m, a);\n");
        buf_str(out, c"    w.uses = global_uses(m, order, a);\n");
        buf_str(out, c"    w.sl = slots(m, w.uses, a);\n");
        buf_str(out, c"    for oi in 0..order.len() {\n");
        buf_str(out, c"        let h = order[oi];\n");
        buf_str(out, c"        var is_entry = false;\n");
        buf_str(out, c"        for e in 0..m.entries.len() {\n");
        buf_str(out, c"            if m.entries[e].func == h {\n");
        buf_str(out, c"                is_entry = true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if !is_entry {\n");
        buf_str(out, c"            write_fn(&w, m, h);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for e in 0..m.entries.len() {\n");
        buf_str(out, c"        write_entry(&w, m, e);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let io = write_test_kernel(&w, m, ei);\n");
        buf_str(out, c"    var text = Buf::new_in(a);\n");
        buf_str(out, c"    finish_into(w, &text);\n");
        buf_str(out, c"    let h = m.entries[ei].func;\n");
        buf_str(out, c"    out.push_fmt(f\"msl {text.len()}\\n\");\n");
        buf_str(out, c"    out.push_str(text.as_slice());\n");
        buf_str(out, c"    out.push_fmt(\n");
        buf_str(out, c"        f\"\\nentry {nm(w.pool, w.fnames[h])}_w_test\\ntg 1 1 1\\ndispatch {job.call_n} 1 1\\n\");\n");
        buf_str(out, c"    // the kernel's slots: (group, binding) order over what it uses\n");
        buf_str(out, c"    let border = binding_order(m, a);\n");
        buf_str(out, c"    let ng = m.globals.len();\n");
        buf_str(out, c"    var kslot: V<i64> = Vec::filled_in(ng, -1, a);\n");
        buf_str(out, c"    var nb = 0;\n");
        buf_str(out, c"    var nt = 0;\n");
        buf_str(out, c"    for k in 0..border.len() {\n");
        buf_str(out, c"        let g = border[k];\n");
        buf_str(out, c"        if !w.uses[h][g] {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let gl = m.globals[g];\n");
        buf_str(out, c"        if gl.space == ir::SP_UNIFORM || gl.space == SP_STORAGE {\n");
        buf_str(out, c"            kslot[g] = nb;\n");
        buf_str(out, c"            nb += 1;\n");
        buf_str(out, c"        } else if m.types[gl.ty].kind == TK_TEXTURE {\n");
        buf_str(out, c"            kslot[g] = nt;\n");
        buf_str(out, c"            nt += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var sizes: V<i64> = Vec::filled_in(w.sl.sizes_count, 0, a);\n");
        buf_str(out, c"    for i in 0..job.buffers.len() {\n");
        buf_str(out, c"        let b = job.buffers[i];\n");
        buf_str(out, c"        let g = job::find_global(m, b.group, b.binding);\n");
        buf_str(out, c"        if w.sl.size_index[g] >= 0 {\n");
        buf_str(out, c"            sizes[w.sl.size_index[g]] = b.bytes;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out.push_fmt(f\"buffer {b.group} {b.binding} {kslot[g]} {b.bytes}\");\n");
        buf_str(out, c"        for j in 0..b.words.len() {\n");
        buf_str(out, c"            out.push_fmt(f\" {b.words[j]}\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out.push('\\n');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for i in 0..job.textures.len() {\n");
        buf_str(out, c"        let t = job.textures[i];\n");
        buf_str(out, c"        let g = job::find_global(m, t.group, t.binding);\n");
        buf_str(out, c"        out.push_fmt(f\"texture {kslot[g]} {t.format} {t.w} {t.h}\");\n");
        buf_str(out, c"        for j in 0..t.words.len() {\n");
        buf_str(out, c"            out.push_fmt(f\" {t.words[j]}\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out.push('\\n');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let f = m.functions[h];\n");
        buf_str(out, c"    let in_stride = ir::record_offsets(m, h, a)[f.params.len()];\n");
        buf_str(out, c"    let out_stride = if f.result >= 0 { ir::stride_of(m, f.result) } else { 4 };\n");
        buf_str(out, c"    out.push_fmt(f\"buffer -1 0 {io[0]} {job.call_n * in_stride}\");\n");
        buf_str(out, c"    for j in 0..job.input.len() {\n");
        buf_str(out, c"        out.push_fmt(f\" {job.input[j]}\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    out.push_fmt(f\"\\nbuffer -2 0 {io[1]} {job.call_n * out_stride}\\n\");\n");
        buf_str(out, c"    if io[2] >= 0 {\n");
        buf_str(out, c"        out.push_fmt(f\"sizes {io[2]} {sizes.len()}\");\n");
        buf_str(out, c"        for k in 0..sizes.len() {\n");
        buf_str(out, c"            out.push_fmt(f\" {sizes[k]}\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out.push('\\n');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl::msl ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::gpu::wgsl::spirv ----\n");
        buf_str(out, c"pub mod spirv {\n");
        buf_str(out, c"// ---- Shader compiler implementation, spirv (0.22) ----\n");
        buf_str(out, c"// The SPIR-V writer (G6).\n");
        buf_str(out, c"\n");
        buf_str(out, c"use ir::Module;\n");
        buf_str(out, c"use std::{Buf, ScopedArena};\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn write(m: Module, a: ScopedArena, out: inout Buf) {\n");
        buf_str(out, c"    let _ = a;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl::spirv ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::gpu::wgsl::interp ----\n");
        buf_str(out, c"pub mod interp {\n");
        buf_str(out, c"// ---- Shader compiler implementation, interp (0.22) ----\n");
        buf_str(out, c"// The CPU interpreter (docs/design/gpu.md §2.10, §4): the third back end\n");
        buf_str(out, c"// over the IR and the oracle of the tests and the shader fuzzer. It runs\n");
        buf_str(out, c"// compute entry points with WGSL's semantics, the checked ones included:\n");
        buf_str(out, c"// wrapping integers, division by zero, shifts modulo 32, clamped indices,\n");
        buf_str(out, c"// runtime-sized arrays that read zero and skip writes out of range.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Values are 32-bit words in WGSL's memory layout, everywhere: an\n");
        buf_str(out, c"// expression's value lives in its register (words of the frame), so a\n");
        buf_str(out, c"// load or store is a copy. Each invocation keeps its own call and control\n");
        buf_str(out, c"// stacks, so a workgroup barrier suspends it: the invocations of a\n");
        buf_str(out, c"// workgroup run in turn until each reaches the barrier, then all resume.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use ir::{\n");
        buf_str(out, c"    AT_ADD, AT_AND, AT_CMPXCHG, AT_EXCHANGE, AT_LOAD, AT_MAX, AT_MIN, AT_OR, AT_STORE, AT_SUB,\n");
        buf_str(out, c"    AT_XOR, BIND_BUILTIN, BI_GLOBAL_INVOCATION_ID, BI_LOCAL_INVOCATION_ID,\n");
        buf_str(out, c"    BI_LOCAL_INVOCATION_INDEX, BI_NUM_WORKGROUPS, BI_WORKGROUP_ID, CK_CLAMP, CK_RZSW, E_ACCESS,\n");
        buf_str(out, c"    E_ACCESS_INDEX, E_ARG, E_ARRAY_LENGTH, E_ATOMIC_RESULT, E_BINARY, E_BITCAST, E_CALL_RESULT,\n");
        buf_str(out, c"    E_COMPOSE, E_CONVERT, E_DERIVATIVE, E_GLOBAL, E_IMAGE_LOAD, E_IMAGE_QUERY, E_IMAGE_SAMPLE,\n");
        buf_str(out, c"    E_LITERAL, E_LOAD, E_LOCAL, E_MATH, E_SELECT, E_SPLAT, E_SWIZZLE, E_UNARY, E_WG_UNIFORM_RESULT,\n");
        buf_str(out, c"    E_ZERO, Function, Module, OP_ADD, OP_AND, OP_DIV, OP_EQ, OP_GE, OP_GT, OP_LAND, OP_LE, OP_LOR,\n");
        buf_str(out, c"    OP_LT, OP_MOD, OP_MUL, OP_NE, OP_OR, OP_SHL, OP_SHR, OP_SUB, OP_XOR, SK_BOOL, SK_F32, SK_I32,\n");
        buf_str(out, c"    SK_U32, SP_HANDLE, SP_PRIVATE, SP_STORAGE, SP_UNIFORM, SP_WORKGROUP, S_ATOMIC, S_BARRIER,\n");
        buf_str(out, c"    S_BLOCK, S_BREAK, S_CALL, S_CONTINUE, S_EMIT, S_IF, S_IMAGE_STORE, S_KILL, S_LOOP, S_RETURN,\n");
        buf_str(out, c"    S_STORE, S_SWITCH, S_WG_UNIFORM_LOAD, TK_ARRAY, TK_MATRIX, TK_POINTER, TK_SAMPLER, TK_SCALAR,\n");
        buf_str(out, c"    TK_STRUCT, TK_TEXTURE, TK_VECTOR, UN_BITNOT, UN_NEG, UN_NOT, V, bits_f32, f32_bits,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"use std::{Buf, ScopedArena, Vec};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The C library's f32 math (libm): a C boundary, so each call is in\n");
        buf_str(out, c"// `unsafe`; none has effects (no errno is read).\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn acosf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn acoshf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn asinf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn asinhf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn atan2f(x: f32, y: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn atanf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn atanhf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn ceilf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn cosf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn coshf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn exp2f(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn expf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn floorf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn fmaf(x: f32, y: f32, z: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn fmaxf(x: f32, y: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn fminf(x: f32, y: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn fmodf(x: f32, y: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn ldexpf(x: f32, e: i32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn log2f(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn logf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn powf(x: f32, y: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn rintf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn sinf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn sinhf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn sqrtf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn tanf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn tanhf(x: f32) -> f32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn truncf(x: f32) -> f32;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Pointer spaces (bits 48..55 of a pointer); bit 56: out of range (RZSW).\n");
        buf_str(out, c"const PS_FUNC: i64 = 1;\n");
        buf_str(out, c"const PS_PRIVATE: i64 = 2;\n");
        buf_str(out, c"const PS_WORKGROUP: i64 = 3;\n");
        buf_str(out, c"const PS_BUFFER: i64 = 4;\n");
        buf_str(out, c"const PTR_INVALID: i64 = 72057594037927936;\n");
        buf_str(out, c"const OFF_MASK: i64 = 4294967295;\n");
        buf_str(out, c"\n");
        buf_str(out, c"const CT_BLOCK: u8 = 0;\n");
        buf_str(out, c"const CT_BODY: u8 = 1;\n");
        buf_str(out, c"const CT_CONT: u8 = 2;\n");
        buf_str(out, c"const CT_SWITCH: u8 = 3;\n");
        buf_str(out, c"\n");
        buf_str(out, c"const ST_RUN: u8 = 0;\n");
        buf_str(out, c"const ST_BARRIER: u8 = 1;\n");
        buf_str(out, c"const ST_DONE: u8 = 2;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct FnInfo {\n");
        buf_str(out, c"    // each expression's register: a word offset in the frame\n");
        buf_str(out, c"    regs: V<i64>,\n");
        buf_str(out, c"    // each local's offset in the frame\n");
        buf_str(out, c"    locals: V<i64>,\n");
        buf_str(out, c"    size: i64,\n");
        buf_str(out, c"    // the E_ARG expression of each parameter, or -1\n");
        buf_str(out, c"    arg_exprs: V<i64>,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"struct Frame { func: i64, base: i64, ctl_base: i64, ret: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A position in a block; for loops `s` is the S_LOOP statement.\n");
        buf_str(out, c"struct Ctl { kind: u8, blk: i64, pos: i64, s: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Inv {\n");
        buf_str(out, c"    mem: V<u32>,\n");
        buf_str(out, c"    privm: V<u32>,\n");
        buf_str(out, c"    frames: V<Frame>,\n");
        buf_str(out, c"    ctl: V<Ctl>,\n");
        buf_str(out, c"    state: u8,\n");
        buf_str(out, c"    // workgroupUniformLoad's two barriers\n");
        buf_str(out, c"    phase: i64,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Interp {\n");
        buf_str(out, c"    a: ScopedArena,\n");
        buf_str(out, c"    fns: V<FnInfo>,\n");
        buf_str(out, c"    // per global: its words (buffers), and offsets in private or workgroup memory\n");
        buf_str(out, c"    bufs: V<V<u32>>,\n");
        buf_str(out, c"    goff: V<i64>,\n");
        buf_str(out, c"    priv_words: i64,\n");
        buf_str(out, c"    wg_words: i64,\n");
        buf_str(out, c"    priv_init: V<u32>,\n");
        buf_str(out, c"    wg: V<u32>,\n");
        buf_str(out, c"    failed: bool,\n");
        buf_str(out, c"    err: Buf<ScopedArena>,\n");
        buf_str(out, c"    steps: i64,\n");
        buf_str(out, c"    max_steps: i64,\n");
        buf_str(out, c"    // builtins of the invocation being started\n");
        buf_str(out, c"    wg_size: [i64; 3],\n");
        buf_str(out, c"    groups: [i64; 3],\n");
        buf_str(out, c"    // per global: a texture's size and texels (4 words each: f32 bits for\n");
        buf_str(out, c"    // float textures, the integers for i32 and u32 ones), once set\n");
        buf_str(out, c"    tex_w: V<i64>,\n");
        buf_str(out, c"    tex_h: V<i64>,\n");
        buf_str(out, c"    texels: V<V<u32>>,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn words_of(m: Module, t: i64) -> i64 {\n");
        buf_str(out, c"    let ty = m.types[t];\n");
        buf_str(out, c"    if ty.kind == TK_POINTER {\n");
        buf_str(out, c"        return 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if ty.kind == TK_TEXTURE || ty.kind == TK_SAMPLER {\n");
        buf_str(out, c"        return 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    ty.size / 4\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn new_interp(m: Module, a: ScopedArena) -> Interp {\n");
        buf_str(out, c"    var it = Interp {\n");
        buf_str(out, c"        a: a,\n");
        buf_str(out, c"        fns: Vec::new_in(a),\n");
        buf_str(out, c"        bufs: Vec::new_in(a),\n");
        buf_str(out, c"        goff: Vec::new_in(a),\n");
        buf_str(out, c"        priv_words: 0,\n");
        buf_str(out, c"        wg_words: 0,\n");
        buf_str(out, c"        priv_init: Vec::new_in(a),\n");
        buf_str(out, c"        wg: Vec::new_in(a),\n");
        buf_str(out, c"        failed: false,\n");
        buf_str(out, c"        err: Buf::new_in(a),\n");
        buf_str(out, c"        steps: 0,\n");
        buf_str(out, c"        max_steps: 2000000000,\n");
        buf_str(out, c"        wg_size: [1, 1, 1],\n");
        buf_str(out, c"        groups: [1, 1, 1],\n");
        buf_str(out, c"        tex_w: Vec::new_in(a),\n");
        buf_str(out, c"        tex_h: Vec::new_in(a),\n");
        buf_str(out, c"        texels: Vec::new_in(a),\n");
        buf_str(out, c"    };\n");
        buf_str(out, c"    for h in 0..m.functions.len() {\n");
        buf_str(out, c"        let f = m.functions[h];\n");
        buf_str(out, c"        var fi = FnInfo {\n");
        buf_str(out, c"            regs: Vec::with_capacity_in(f.exprs.len(), a), locals: Vec::new_in(a), size: 0,\n");
        buf_str(out, c"            arg_exprs: Vec::filled_in(f.params.len(), -1, a)\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        var off = 0;\n");
        buf_str(out, c"        for l in 0..f.locals.len() {\n");
        buf_str(out, c"            fi.locals.push(off);\n");
        buf_str(out, c"            off += words_of(m, f.locals[l].ty);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for e in 0..f.exprs.len() {\n");
        buf_str(out, c"            fi.regs.push(off);\n");
        buf_str(out, c"            off += words_of(m, f.exprs[e].ty);\n");
        buf_str(out, c"            if f.exprs[e].op == E_ARG {\n");
        buf_str(out, c"                fi.arg_exprs[f.exprs[e].a] = e;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        fi.size = off;\n");
        buf_str(out, c"        it.fns.push(fi);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for g in 0..m.globals.len() {\n");
        buf_str(out, c"        let gl = m.globals[g];\n");
        buf_str(out, c"        it.bufs.push(Vec::new_in(a));\n");
        buf_str(out, c"        it.tex_w.push(0);\n");
        buf_str(out, c"        it.tex_h.push(0);\n");
        buf_str(out, c"        it.texels.push(Vec::new_in(a));\n");
        buf_str(out, c"        if gl.space == SP_PRIVATE {\n");
        buf_str(out, c"            it.goff.push(it.priv_words);\n");
        buf_str(out, c"            it.priv_words += words_of(m, gl.ty);\n");
        buf_str(out, c"        } else if gl.space == SP_WORKGROUP {\n");
        buf_str(out, c"            it.goff.push(it.wg_words);\n");
        buf_str(out, c"            it.wg_words += words_of(m, gl.ty);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            it.goff.push(0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // private globals' initial values, from the module's constant expressions\n");
        buf_str(out, c"    for _ in 0..it.priv_words {\n");
        buf_str(out, c"        it.priv_init.push(0);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var cf = FnInfo {\n");
        buf_str(out, c"        regs: Vec::new_in(a), locals: Vec::new_in(a), size: 0, arg_exprs: Vec::new_in(a)\n");
        buf_str(out, c"    };\n");
        buf_str(out, c"    var off = 0;\n");
        buf_str(out, c"    for e in 0..m.consts.exprs.len() {\n");
        buf_str(out, c"        cf.regs.push(off);\n");
        buf_str(out, c"        off += words_of(m, m.consts.exprs[e].ty);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    cf.size = off;\n");
        buf_str(out, c"    if off > 0 {\n");
        buf_str(out, c"        var tmp = Inv {\n");
        buf_str(out, c"            mem: Vec::filled_in(off, 0u32, a), privm: Vec::new_in(a), frames: Vec::new_in(a),\n");
        buf_str(out, c"            ctl: Vec::new_in(a), state: ST_RUN, phase: 0\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        for g in 0..m.globals.len() {\n");
        buf_str(out, c"            let gl = m.globals[g];\n");
        buf_str(out, c"            if gl.space == SP_PRIVATE && gl.init >= 0 {\n");
        buf_str(out, c"                const_eval(m, cf, &tmp, gl.init);\n");
        buf_str(out, c"                let w = words_of(m, gl.ty);\n");
        buf_str(out, c"                for k in 0..w {\n");
        buf_str(out, c"                    it.priv_init[it.goff[g] + k] = tmp.mem[cf.regs[gl.init] + k];\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    it\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Evaluates a constant expression of the module's init function (and its\n");
        buf_str(out, c"// operands) into tmp's registers.\n");
        buf_str(out, c"fn const_eval(m: Module, cf: FnInfo, tmp: inout Inv, e: i64) {\n");
        buf_str(out, c"    let x = m.consts.exprs[e];\n");
        buf_str(out, c"    let dst = cf.regs[e];\n");
        buf_str(out, c"    let w = words_of(m, x.ty);\n");
        buf_str(out, c"    if x.op == E_LITERAL {\n");
        buf_str(out, c"        tmp.mem[dst] = x.a as u32;\n");
        buf_str(out, c"    } else if x.op == E_ZERO {\n");
        buf_str(out, c"        for k in 0..w {\n");
        buf_str(out, c"            tmp.mem[dst + k] = 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else if x.op == E_SPLAT {\n");
        buf_str(out, c"        const_eval(m, cf, &tmp, x.a);\n");
        buf_str(out, c"        for k in 0..w {\n");
        buf_str(out, c"            tmp.mem[dst + k] = tmp.mem[cf.regs[x.a]];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else if x.op == E_COMPOSE {\n");
        buf_str(out, c"        let t = m.types[x.ty];\n");
        buf_str(out, c"        var at = 0;\n");
        buf_str(out, c"        for i in 0..x.b {\n");
        buf_str(out, c"            let a = m.consts.args[x.a + i];\n");
        buf_str(out, c"            const_eval(m, cf, &tmp, a);\n");
        buf_str(out, c"            let aw = words_of(m, m.consts.exprs[a].ty);\n");
        buf_str(out, c"            let o = compose_offset(m, t, i, at);\n");
        buf_str(out, c"            for k in 0..aw {\n");
        buf_str(out, c"                tmp.mem[dst + o + k] = tmp.mem[cf.regs[a] + k];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            at += aw;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Where the i-th argument of a composition of type t goes (`at`: the\n");
        buf_str(out, c"// words the earlier arguments filled, for vectors).\n");
        buf_str(out, c"fn compose_offset(m: Module, t: ir::Type, i: i64, at: i64) -> i64 {\n");
        buf_str(out, c"    if t.kind == TK_VECTOR {\n");
        buf_str(out, c"        at\n");
        buf_str(out, c"    } else if t.kind == TK_MATRIX {\n");
        buf_str(out, c"        i * t.stride / 4\n");
        buf_str(out, c"    } else if t.kind == TK_ARRAY {\n");
        buf_str(out, c"        i * t.stride / 4\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        m.members[t.mstart + i].offset / 4\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn fl(x: u32) -> f32 { bits_f32(x) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn ub(x: f32) -> u32 { f32_bits(x) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn si(x: u32) -> i64 { x as i32 as i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Interp {\n");
        buf_str(out, c"    pub fn fail(inout self, msg: [u8]) {\n");
        buf_str(out, c"        if !self.failed {\n");
        buf_str(out, c"            self.failed = true;\n");
        buf_str(out, c"            self.err.push_str(msg);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A buffer's binding: its words (sized to the binding).\n");
        buf_str(out, c"    pub fn set_buffer(inout self, g: i64, words: [u32]) {\n");
        buf_str(out, c"        var v: V<u32> = Vec::with_capacity_in(words.len, self.a);\n");
        buf_str(out, c"        v.extend_from_slice(words);\n");
        buf_str(out, c"        self.bufs[g] = v;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A texture's texels: w x h, 4 words each (see `texels`).\n");
        buf_str(out, c"    pub fn set_texture(inout self, g: i64, w: i64, h: i64, texels: [u32]) {\n");
        buf_str(out, c"        self.tex_w[g] = w;\n");
        buf_str(out, c"        self.tex_h[g] = h;\n");
        buf_str(out, c"        var v: V<u32> = Vec::with_capacity_in(texels.len, self.a);\n");
        buf_str(out, c"        v.extend_from_slice(texels);\n");
        buf_str(out, c"        self.texels[g] = v;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Runs entry point ei once per input record (stride_in bytes each,\n");
        buf_str(out, c"    // its parameters at their record offsets, ir::record_offsets), the\n");
        buf_str(out, c"    // results in `out`, stride_out bytes each. Vertex and fragment entry\n");
        buf_str(out, c"    // points so run alone: their builtins come from the records too.\n");
        buf_str(out, c"    pub fn call(inout self, m: Module, ei: i64, input: [u32], stride_in: i64, n: i64,\n");
        buf_str(out, c"        out: inout V<u32>, stride_out: i64) -> bool {\n");
        buf_str(out, c"        let fi = m.entries[ei].func;\n");
        buf_str(out, c"        let size = self.fns[fi].size;\n");
        buf_str(out, c"        let rw = if m.functions[fi].result >= 0 { words_of(m, m.functions[fi].result) } else { 0 };\n");
        buf_str(out, c"        let offs = ir::record_offsets(m, fi, self.a);\n");
        buf_str(out, c"        self.wg = Vec::filled_in(self.wg_words, 0u32, self.a);\n");
        buf_str(out, c"        for _ in 0..n * stride_out / 4 {\n");
        buf_str(out, c"            out.push(0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for i in 0..n {\n");
        buf_str(out, c"            var inv = Inv {\n");
        buf_str(out, c"                mem: Vec::filled_in(size + rw, 0u32, self.a),\n");
        buf_str(out, c"                privm: Vec::filled_in(self.priv_words, 0u32, self.a),\n");
        buf_str(out, c"                frames: Vec::new_in(self.a),\n");
        buf_str(out, c"                ctl: Vec::new_in(self.a),\n");
        buf_str(out, c"                state: ST_RUN,\n");
        buf_str(out, c"                phase: 0,\n");
        buf_str(out, c"            };\n");
        buf_str(out, c"            for k in 0..self.priv_words {\n");
        buf_str(out, c"                inv.privm[k] = self.priv_init[k];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let fr = Frame { func: fi, base: 0, ctl_base: 0, ret: size };\n");
        buf_str(out, c"            inv.frames.push(fr);\n");
        buf_str(out, c"            self.enter(m, &inv, fr);\n");
        buf_str(out, c"            inv.ctl.push(Ctl { kind: CT_BLOCK, blk: m.functions[fi].body, pos: 0, s: -1 });\n");
        buf_str(out, c"            for k in 0..m.functions[fi].params.len() {\n");
        buf_str(out, c"                let e = self.fns[fi].arg_exprs[k];\n");
        buf_str(out, c"                if e < 0 {\n");
        buf_str(out, c"                    continue;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let w = words_of(m, m.functions[fi].params[k].ty);\n");
        buf_str(out, c"                let src = i * stride_in / 4 + offs[k] / 4;\n");
        buf_str(out, c"                for j in 0..w {\n");
        buf_str(out, c"                    if src + j < input.len {\n");
        buf_str(out, c"                        inv.mem[self.fns[fi].regs[e] + j] = input[src + j];\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.run(m, &inv);\n");
        buf_str(out, c"            if self.failed {\n");
        buf_str(out, c"                return false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if inv.state != ST_DONE {\n");
        buf_str(out, c"                self.fail(\"a barrier in an entry point run alone\");\n");
        buf_str(out, c"                return false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for j in 0..rw {\n");
        buf_str(out, c"                out[i * stride_out / 4 + j] = inv.mem[size + j];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Memory ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn read(self, inv: Inv, ptr: i64, k: i64) -> u32 {\n");
        buf_str(out, c"        let sp = (ptr >> 48) & 255;\n");
        buf_str(out, c"        let off = (ptr & OFF_MASK) + k;\n");
        buf_str(out, c"        if ptr & PTR_INVALID != 0 {\n");
        buf_str(out, c"            return 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if sp == PS_FUNC {\n");
        buf_str(out, c"            inv.mem[off]\n");
        buf_str(out, c"        } else if sp == PS_PRIVATE {\n");
        buf_str(out, c"            inv.privm[off]\n");
        buf_str(out, c"        } else if sp == PS_WORKGROUP {\n");
        buf_str(out, c"            self.wg[off]\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            let b = (ptr >> 32) & 65535;\n");
        buf_str(out, c"            if off >= self.bufs[b].len() {\n");
        buf_str(out, c"                // a fixed-size part beyond a too-small binding reads zero\n");
        buf_str(out, c"                return 0;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.bufs[b][off]\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn write(inout self, inv: inout Inv, ptr: i64, k: i64, v: u32) {\n");
        buf_str(out, c"        let sp = (ptr >> 48) & 255;\n");
        buf_str(out, c"        let off = (ptr & OFF_MASK) + k;\n");
        buf_str(out, c"        if ptr & PTR_INVALID != 0 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if sp == PS_FUNC {\n");
        buf_str(out, c"            inv.mem[off] = v;\n");
        buf_str(out, c"        } else if sp == PS_PRIVATE {\n");
        buf_str(out, c"            inv.privm[off] = v;\n");
        buf_str(out, c"        } else if sp == PS_WORKGROUP {\n");
        buf_str(out, c"            self.wg[off] = v;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            let b = (ptr >> 32) & 65535;\n");
        buf_str(out, c"            if off < self.bufs[b].len() {\n");
        buf_str(out, c"                self.bufs[b][off] = v;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn get_ptr(self, inv: Inv, addr: i64) -> i64 {\n");
        buf_str(out, c"        (inv.mem[addr] as i64) | ((inv.mem[addr + 1] as i64) << 32)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn put_ptr(self, inv: inout Inv, addr: i64, p: i64) {\n");
        buf_str(out, c"        inv.mem[addr] = (p & OFF_MASK) as u32;\n");
        buf_str(out, c"        inv.mem[addr + 1] = ((p >> 32) & OFF_MASK) as u32;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The length of the runtime-sized array at byte `offset` of global g.\n");
        buf_str(out, c"    fn runtime_len(self, g: i64, offset: i64, stride: i64) -> i64 {\n");
        buf_str(out, c"        let bytes = self.bufs[g].len() * 4 - offset;\n");
        buf_str(out, c"        if bytes <= 0 || stride <= 0 {\n");
        buf_str(out, c"            return 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        bytes / stride\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The global a pointer expression starts from, or -1.\n");
        buf_str(out, c"    fn root_global(self, f: Function, e: i64) -> i64 {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        if x.op == E_GLOBAL {\n");
        buf_str(out, c"            return x.a;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if x.op == E_ACCESS || x.op == E_ACCESS_INDEX {\n");
        buf_str(out, c"            return self.root_global(f, x.a);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        -1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Running a dispatch ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Runs entry point `ei` over groups[0] x groups[1] x groups[2] workgroups.\n");
        buf_str(out, c"    pub fn dispatch(inout self, m: Module, ei: i64, groups: [i64; 3]) -> bool {\n");
        buf_str(out, c"        let en = m.entries[ei];\n");
        buf_str(out, c"        let n = en.wg[0] * en.wg[1] * en.wg[2];\n");
        buf_str(out, c"        self.wg_size = en.wg;\n");
        buf_str(out, c"        self.groups = groups;\n");
        buf_str(out, c"        let fi = en.func;\n");
        buf_str(out, c"        let size = self.fns[fi].size;\n");
        buf_str(out, c"        var invs: V<Inv> = Vec::with_capacity_in(n, self.a);\n");
        buf_str(out, c"        for _ in 0..n {\n");
        buf_str(out, c"            invs.push(Inv {\n");
        buf_str(out, c"                mem: Vec::filled_in(size + 64, 0u32, self.a),\n");
        buf_str(out, c"                privm: Vec::filled_in(self.priv_words, 0u32, self.a),\n");
        buf_str(out, c"                frames: Vec::new_in(self.a),\n");
        buf_str(out, c"                ctl: Vec::new_in(self.a),\n");
        buf_str(out, c"                state: ST_RUN,\n");
        buf_str(out, c"                phase: 0,\n");
        buf_str(out, c"            });\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.wg = Vec::filled_in(self.wg_words, 0u32, self.a);\n");
        buf_str(out, c"        for gz in 0..groups[2] {\n");
        buf_str(out, c"            for gy in 0..groups[1] {\n");
        buf_str(out, c"                for gx in 0..groups[0] {\n");
        buf_str(out, c"                    for k in 0..self.wg_words {\n");
        buf_str(out, c"                        self.wg[k] = 0;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    for li in 0..n {\n");
        buf_str(out, c"                        let lx = li % en.wg[0];\n");
        buf_str(out, c"                        let ly = (li / en.wg[0]) % en.wg[1];\n");
        buf_str(out, c"                        let lz = li / (en.wg[0] * en.wg[1]);\n");
        buf_str(out, c"                        inout inv = &invs[li];\n");
        buf_str(out, c"                        inv.mem.truncate(0);\n");
        buf_str(out, c"                        for _ in 0..size {\n");
        buf_str(out, c"                            inv.mem.push(0);\n");
        buf_str(out, c"                        }\n");
        buf_str(out, c"                        for k in 0..self.priv_words {\n");
        buf_str(out, c"                            inv.privm[k] = self.priv_init[k];\n");
        buf_str(out, c"                        }\n");
        buf_str(out, c"                        inv.frames.clear();\n");
        buf_str(out, c"                        inv.ctl.clear();\n");
        buf_str(out, c"                        inv.state = ST_RUN;\n");
        buf_str(out, c"                        inv.phase = 0;\n");
        buf_str(out, c"                        inv.frames.push(Frame { func: fi, base: 0, ctl_base: 0, ret: -1 });\n");
        buf_str(out, c"                        let fr0 = inv.frames[0];\n");
        buf_str(out, c"                        self.enter(m, &inv, fr0);\n");
        buf_str(out, c"                        let body = m.functions[fi].body;\n");
        buf_str(out, c"                        inv.ctl.push(Ctl { kind: CT_BLOCK, blk: body, pos: 0, s: -1 });\n");
        buf_str(out, c"                        self.set_builtins(m, &inv, fi, [lx, ly, lz], [gx, gy, gz], li);\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    // run the workgroup's invocations, barrier to barrier\n");
        buf_str(out, c"                    loop {\n");
        buf_str(out, c"                        var running = 0;\n");
        buf_str(out, c"                        var at_barrier = 0;\n");
        buf_str(out, c"                        for li in 0..n {\n");
        buf_str(out, c"                            if invs[li].state == ST_DONE {\n");
        buf_str(out, c"                                continue;\n");
        buf_str(out, c"                            }\n");
        buf_str(out, c"                            invs[li].state = ST_RUN;\n");
        buf_str(out, c"                            self.run(m, &invs[li]);\n");
        buf_str(out, c"                            if self.failed {\n");
        buf_str(out, c"                                return false;\n");
        buf_str(out, c"                            }\n");
        buf_str(out, c"                            if invs[li].state == ST_BARRIER {\n");
        buf_str(out, c"                                at_barrier += 1;\n");
        buf_str(out, c"                            }\n");
        buf_str(out, c"                            running += 1;\n");
        buf_str(out, c"                        }\n");
        buf_str(out, c"                        if running == 0 {\n");
        buf_str(out, c"                            break;\n");
        buf_str(out, c"                        }\n");
        buf_str(out, c"                        if at_barrier != 0 && at_barrier != running {\n");
        buf_str(out, c"                            self.fail(\"a barrier was reached by some invocations of a workgroup and not others (non-uniform control flow)\");\n");
        buf_str(out, c"                            return false;\n");
        buf_str(out, c"                        }\n");
        buf_str(out, c"                        if at_barrier == 0 {\n");
        buf_str(out, c"                            break;\n");
        buf_str(out, c"                        }\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn set_builtins(self, m: Module, inv: inout Inv, fi: i64, l: [i64; 3], g: [i64; 3],\n");
        buf_str(out, c"        li: i64) {\n");
        buf_str(out, c"        let f = m.functions[fi];\n");
        buf_str(out, c"        for p in 0..f.params.len() {\n");
        buf_str(out, c"            let e = self.fns[fi].arg_exprs[p];\n");
        buf_str(out, c"            if e < 0 {\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let dst = self.fns[fi].regs[e];\n");
        buf_str(out, c"            let pt = m.types[f.params[p].ty];\n");
        buf_str(out, c"            if pt.kind == TK_STRUCT {\n");
        buf_str(out, c"                for k in 0..pt.mcount {\n");
        buf_str(out, c"                    let mem = m.members[pt.mstart + k];\n");
        buf_str(out, c"                    self.put_builtin(&inv, mem.binding.value, dst + mem.offset / 4, l, g, li);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else if f.params[p].binding.kind == BIND_BUILTIN {\n");
        buf_str(out, c"                self.put_builtin(&inv, f.params[p].binding.value, dst, l, g, li);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn put_builtin(self, inv: inout Inv, b: i64, dst: i64, l: [i64; 3], g: [i64; 3],\n");
        buf_str(out, c"        li: i64) {\n");
        buf_str(out, c"        for k in 0..3 {\n");
        buf_str(out, c"            let v = if b == BI_LOCAL_INVOCATION_ID {\n");
        buf_str(out, c"                l[k]\n");
        buf_str(out, c"            } else if b == BI_GLOBAL_INVOCATION_ID {\n");
        buf_str(out, c"                g[k] * self.wg_size[k] + l[k]\n");
        buf_str(out, c"            } else if b == BI_WORKGROUP_ID {\n");
        buf_str(out, c"                g[k]\n");
        buf_str(out, c"            } else if b == BI_NUM_WORKGROUPS {\n");
        buf_str(out, c"                self.groups[k]\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                li\n");
        buf_str(out, c"            };\n");
        buf_str(out, c"            inv.mem[dst + k] = v as u32;\n");
        buf_str(out, c"            if b == BI_LOCAL_INVOCATION_INDEX {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Statements ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Runs an invocation until it ends, reaches a barrier or fails.\n");
        buf_str(out, c"    fn run(inout self, m: Module, inv: inout Inv) {\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            if self.failed {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if inv.frames.len() == 0 {\n");
        buf_str(out, c"                inv.state = ST_DONE;\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let fr = inv.frames[inv.frames.len() - 1];\n");
        buf_str(out, c"            if inv.ctl.len() == fr.ctl_base {\n");
        buf_str(out, c"                // the function ran off its end: return nothing\n");
        buf_str(out, c"                self.ret(m, &inv, -1);\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let ci = inv.ctl.len() - 1;\n");
        buf_str(out, c"            let c = inv.ctl[ci];\n");
        buf_str(out, c"            let f = m.functions[fr.func];\n");
        buf_str(out, c"            let blk = f.blocks[c.blk];\n");
        buf_str(out, c"            if c.pos >= blk.count {\n");
        buf_str(out, c"                self.end_block(m, &inv, f, ci);\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            inv.ctl[ci].pos += 1;\n");
        buf_str(out, c"            let s = f.items[blk.start + c.pos];\n");
        buf_str(out, c"            if !self.exec(m, &inv, f, fr, s) {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The block at ctl[ci] finished.\n");
        buf_str(out, c"    fn end_block(inout self, m: Module, inv: inout Inv, f: Function, ci: i64) {\n");
        buf_str(out, c"        let c = inv.ctl[ci];\n");
        buf_str(out, c"        if c.kind == CT_BODY {\n");
        buf_str(out, c"            let st = f.stmts[c.s];\n");
        buf_str(out, c"            inv.ctl[ci] = Ctl { kind: CT_CONT, blk: st.b, pos: 0, s: c.s };\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if c.kind == CT_CONT {\n");
        buf_str(out, c"            let st = f.stmts[c.s];\n");
        buf_str(out, c"            if st.c >= 0 {\n");
        buf_str(out, c"                let fr = inv.frames[inv.frames.len() - 1];\n");
        buf_str(out, c"                if inv.mem[fr.base + self.fns[fr.func].regs[st.c]] != 0 {\n");
        buf_str(out, c"                    inv.ctl.truncate(ci);\n");
        buf_str(out, c"                    return;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.steps += 1;\n");
        buf_str(out, c"            if self.steps > self.max_steps {\n");
        buf_str(out, c"                self.fail(\"the step limit was reached (an endless loop?)\");\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            inv.ctl[ci] = Ctl { kind: CT_BODY, blk: st.a, pos: 0, s: c.s };\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        inv.ctl.truncate(ci);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Returns from the current function with the value at register `src`\n");
        buf_str(out, c"    // of its frame (or none).\n");
        buf_str(out, c"    fn ret(self, m: Module, inv: inout Inv, src_e: i64) {\n");
        buf_str(out, c"        let fr = inv.frames.pop().unwrap();\n");
        buf_str(out, c"        if fr.ret >= 0 && src_e >= 0 {\n");
        buf_str(out, c"            let w = words_of(m, m.functions[fr.func].exprs[src_e].ty);\n");
        buf_str(out, c"            let src = fr.base + self.fns[fr.func].regs[src_e];\n");
        buf_str(out, c"            for k in 0..w {\n");
        buf_str(out, c"                inv.mem[fr.ret + k] = inv.mem[src + k];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        inv.ctl.truncate(fr.ctl_base);\n");
        buf_str(out, c"        if inv.frames.len() == 0 {\n");
        buf_str(out, c"            inv.state = ST_DONE;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            inv.mem.truncate(fr.base);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Runs statement s; false when the invocation stops (a barrier, the\n");
        buf_str(out, c"    // end, an error).\n");
        buf_str(out, c"    fn exec(inout self, m: Module, inv: inout Inv, f: Function, fr: Frame, s: i64) -> bool {\n");
        buf_str(out, c"        let st = f.stmts[s];\n");
        buf_str(out, c"        let op = st.op;\n");
        buf_str(out, c"        if op == S_EMIT {\n");
        buf_str(out, c"            for e in st.a..st.b {\n");
        buf_str(out, c"                self.eval_expr(m, &inv, f, fr, e);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return !self.failed;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == S_STORE {\n");
        buf_str(out, c"            let p = self.get_ptr(inv, fr.base + self.fns[fr.func].regs[st.a]);\n");
        buf_str(out, c"            let w = words_of(m, f.exprs[st.b].ty);\n");
        buf_str(out, c"            let src = fr.base + self.fns[fr.func].regs[st.b];\n");
        buf_str(out, c"            for k in 0..w {\n");
        buf_str(out, c"                self.write(&inv, p, k, inv.mem[src + k]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == S_BLOCK {\n");
        buf_str(out, c"            inv.ctl.push(Ctl { kind: CT_BLOCK, blk: st.a, pos: 0, s: -1 });\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == S_IF {\n");
        buf_str(out, c"            let c = inv.mem[fr.base + self.fns[fr.func].regs[st.a]];\n");
        buf_str(out, c"            inv.ctl.push(Ctl {\n");
        buf_str(out, c"                kind: CT_BLOCK, blk: if c != 0 { st.b } else { st.c }, pos: 0, s: -1\n");
        buf_str(out, c"            });\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == S_LOOP {\n");
        buf_str(out, c"            inv.ctl.push(Ctl { kind: CT_BODY, blk: st.a, pos: 0, s: s });\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == S_SWITCH {\n");
        buf_str(out, c"            let v = inv.mem[fr.base + self.fns[fr.func].regs[st.a]] as i64;\n");
        buf_str(out, c"            var body = -1;\n");
        buf_str(out, c"            for k in st.b..st.b + st.c {\n");
        buf_str(out, c"                let cs = f.cases[k];\n");
        buf_str(out, c"                for j in cs.vstart..cs.vstart + cs.vcount {\n");
        buf_str(out, c"                    if (f.vals[j] & OFF_MASK) == v {\n");
        buf_str(out, c"                        body = cs.body;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if cs.is_default && body < 0 {\n");
        buf_str(out, c"                    // remembered, but a later case may still match\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if body < 0 {\n");
        buf_str(out, c"                for k in st.b..st.b + st.c {\n");
        buf_str(out, c"                    if f.cases[k].is_default {\n");
        buf_str(out, c"                        body = f.cases[k].body;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            inv.ctl.push(Ctl { kind: CT_SWITCH, blk: body, pos: 0, s: s });\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == S_BREAK {\n");
        buf_str(out, c"            loop {\n");
        buf_str(out, c"                let c = inv.ctl.pop().unwrap();\n");
        buf_str(out, c"                if c.kind == CT_BODY || c.kind == CT_CONT || c.kind == CT_SWITCH {\n");
        buf_str(out, c"                    return true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == S_CONTINUE {\n");
        buf_str(out, c"            loop {\n");
        buf_str(out, c"                let ci = inv.ctl.len() - 1;\n");
        buf_str(out, c"                let c = inv.ctl[ci];\n");
        buf_str(out, c"                if c.kind == CT_BODY {\n");
        buf_str(out, c"                    let ls = f.stmts[c.s];\n");
        buf_str(out, c"                    inv.ctl[ci] = Ctl { kind: CT_CONT, blk: ls.b, pos: 0, s: c.s };\n");
        buf_str(out, c"                    return true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                inv.ctl.truncate(ci);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == S_RETURN {\n");
        buf_str(out, c"            self.ret(m, &inv, st.a);\n");
        buf_str(out, c"            return inv.state != ST_DONE;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == S_KILL {\n");
        buf_str(out, c"            inv.frames.clear();\n");
        buf_str(out, c"            inv.ctl.clear();\n");
        buf_str(out, c"            inv.state = ST_DONE;\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == S_BARRIER {\n");
        buf_str(out, c"            inv.state = ST_BARRIER;\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == S_WG_UNIFORM_LOAD {\n");
        buf_str(out, c"            if inv.phase == 0 {\n");
        buf_str(out, c"                inv.phase = 1;\n");
        buf_str(out, c"                let ci = inv.ctl.len() - 1;\n");
        buf_str(out, c"                inv.ctl[ci].pos -= 1;\n");
        buf_str(out, c"                inv.state = ST_BARRIER;\n");
        buf_str(out, c"                return false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            inv.phase = 0;\n");
        buf_str(out, c"            let p = self.get_ptr(inv, fr.base + self.fns[fr.func].regs[st.a]);\n");
        buf_str(out, c"            let w = words_of(m, f.exprs[st.b].ty);\n");
        buf_str(out, c"            let dst = fr.base + self.fns[fr.func].regs[st.b];\n");
        buf_str(out, c"            for k in 0..w {\n");
        buf_str(out, c"                inv.mem[dst + k] = self.read(inv, p, k);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            inv.state = ST_BARRIER;\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == S_CALL {\n");
        buf_str(out, c"            let callee = st.a;\n");
        buf_str(out, c"            let base = inv.mem.len();\n");
        buf_str(out, c"            for _ in 0..self.fns[callee].size {\n");
        buf_str(out, c"                inv.mem.push(0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for k in 0..st.c {\n");
        buf_str(out, c"                let ae = f.args[st.b + k];\n");
        buf_str(out, c"                let pe = self.fns[callee].arg_exprs[k];\n");
        buf_str(out, c"                if pe < 0 {\n");
        buf_str(out, c"                    continue;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let w = words_of(m, m.functions[callee].params[k].ty);\n");
        buf_str(out, c"                let src = fr.base + self.fns[fr.func].regs[ae];\n");
        buf_str(out, c"                let dst = base + self.fns[callee].regs[pe];\n");
        buf_str(out, c"                for j in 0..w {\n");
        buf_str(out, c"                    inv.mem[dst + j] = inv.mem[src + j];\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let ret = if st.d >= 0 { fr.base + self.fns[fr.func].regs[st.d] } else { -1 };\n");
        buf_str(out, c"            let nf = Frame { func: callee, base: base, ctl_base: inv.ctl.len(), ret: ret };\n");
        buf_str(out, c"            inv.frames.push(nf);\n");
        buf_str(out, c"            self.enter(m, &inv, nf);\n");
        buf_str(out, c"            inv.ctl.push(Ctl { kind: CT_BLOCK, blk: m.functions[callee].body, pos: 0, s: -1 });\n");
        buf_str(out, c"            if inv.frames.len() > 64 {\n");
        buf_str(out, c"                self.fail(\"calls nest too deep\");\n");
        buf_str(out, c"                return false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == S_ATOMIC {\n");
        buf_str(out, c"            let p = self.get_ptr(inv, fr.base + self.fns[fr.func].regs[st.a]);\n");
        buf_str(out, c"            let sk = m.types[m.pointee(f.exprs[st.a].ty)].scalar;\n");
        buf_str(out, c"            let old = self.read(inv, p, 0);\n");
        buf_str(out, c"            let v = if st.c >= 0 { inv.mem[fr.base + self.fns[fr.func].regs[st.c]] } else { 0 };\n");
        buf_str(out, c"            let fun = st.b;\n");
        buf_str(out, c"            var new = old;\n");
        buf_str(out, c"            if fun == AT_ADD {\n");
        buf_str(out, c"                new = old + v;\n");
        buf_str(out, c"            } else if fun == AT_SUB {\n");
        buf_str(out, c"                new = old - v;\n");
        buf_str(out, c"            } else if fun == AT_AND {\n");
        buf_str(out, c"                new = old & v;\n");
        buf_str(out, c"            } else if fun == AT_OR {\n");
        buf_str(out, c"                new = old | v;\n");
        buf_str(out, c"            } else if fun == AT_XOR {\n");
        buf_str(out, c"                new = old ^ v;\n");
        buf_str(out, c"            } else if fun == AT_MIN {\n");
        buf_str(out, c"                new = if sk == SK_I32 { if si(v) < si(old) { v } else { old } }\n");
        buf_str(out, c"                    else { if v < old { v } else { old } };\n");
        buf_str(out, c"            } else if fun == AT_MAX {\n");
        buf_str(out, c"                new = if sk == SK_I32 { if si(v) > si(old) { v } else { old } }\n");
        buf_str(out, c"                    else { if v > old { v } else { old } };\n");
        buf_str(out, c"            } else if fun == AT_EXCHANGE || fun == AT_STORE {\n");
        buf_str(out, c"                new = v;\n");
        buf_str(out, c"            } else if fun == AT_CMPXCHG {\n");
        buf_str(out, c"                let cmp = inv.mem[fr.base + self.fns[fr.func].regs[st.e]];\n");
        buf_str(out, c"                if old == cmp {\n");
        buf_str(out, c"                    new = v;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if fun != AT_LOAD {\n");
        buf_str(out, c"                self.write(&inv, p, 0, new);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if st.d >= 0 {\n");
        buf_str(out, c"                let dst = fr.base + self.fns[fr.func].regs[st.d];\n");
        buf_str(out, c"                inv.mem[dst] = old;\n");
        buf_str(out, c"                if fun == AT_CMPXCHG {\n");
        buf_str(out, c"                    let cmp = inv.mem[fr.base + self.fns[fr.func].regs[st.e]];\n");
        buf_str(out, c"                    // exchanged: the member at offset 4\n");
        buf_str(out, c"                    inv.mem[dst + 1] = if old == cmp && p & PTR_INVALID == 0 { 1 } else { 0 };\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == S_IMAGE_STORE {\n");
        buf_str(out, c"            self.fail(\"textureStore is not run by the interpreter\");\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.fail(\"unknown statement\");\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A new frame: the registers of its globals and locals hold their\n");
        buf_str(out, c"    // addresses from the start (they are leaves: an S_EMIT may cover one\n");
        buf_str(out, c"    // in a branch the invocation does not take).\n");
        buf_str(out, c"    fn enter(inout self, m: Module, inv: inout Inv, fr: Frame) {\n");
        buf_str(out, c"        let f = m.functions[fr.func];\n");
        buf_str(out, c"        for e in 0..f.exprs.len() {\n");
        buf_str(out, c"            let op = f.exprs[e].op;\n");
        buf_str(out, c"            if op == E_GLOBAL || op == E_LOCAL {\n");
        buf_str(out, c"                self.eval_expr(m, &inv, f, fr, e);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Expressions ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn eval_expr(inout self, m: Module, inv: inout Inv, f: Function, fr: Frame, e: i64) {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        let dst = fr.base + self.fns[fr.func].regs[e];\n");
        buf_str(out, c"        let op = x.op;\n");
        buf_str(out, c"        if op == E_LITERAL {\n");
        buf_str(out, c"            inv.mem[dst] = x.a as u32;\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_ZERO {\n");
        buf_str(out, c"            let w = words_of(m, x.ty);\n");
        buf_str(out, c"            for k in 0..w {\n");
        buf_str(out, c"                inv.mem[dst + k] = 0;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_ARG || op == E_CALL_RESULT || op == E_ATOMIC_RESULT\n");
        buf_str(out, c"            || op == E_WG_UNIFORM_RESULT {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_GLOBAL {\n");
        buf_str(out, c"            let g = x.a;\n");
        buf_str(out, c"            let gl = m.globals[g];\n");
        buf_str(out, c"            let p = if gl.space == SP_PRIVATE {\n");
        buf_str(out, c"                (PS_PRIVATE << 48) | self.goff[g]\n");
        buf_str(out, c"            } else if gl.space == SP_WORKGROUP {\n");
        buf_str(out, c"                (PS_WORKGROUP << 48) | self.goff[g]\n");
        buf_str(out, c"            } else if gl.space == SP_HANDLE {\n");
        buf_str(out, c"                g\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                (PS_BUFFER << 48) | (g << 32)\n");
        buf_str(out, c"            };\n");
        buf_str(out, c"            if gl.space == SP_HANDLE {\n");
        buf_str(out, c"                inv.mem[dst] = g as u32;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                self.put_ptr(&inv, dst, p);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_LOCAL {\n");
        buf_str(out, c"            let off = fr.base + self.fns[fr.func].locals[x.a];\n");
        buf_str(out, c"            self.put_ptr(&inv, dst, (PS_FUNC << 48) | off);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_LOAD {\n");
        buf_str(out, c"            let p = self.get_ptr(inv, fr.base + self.fns[fr.func].regs[x.a]);\n");
        buf_str(out, c"            let w = words_of(m, x.ty);\n");
        buf_str(out, c"            for k in 0..w {\n");
        buf_str(out, c"                inv.mem[dst + k] = self.read(inv, p, k);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_ACCESS || op == E_ACCESS_INDEX {\n");
        buf_str(out, c"            let bt0 = f.exprs[x.a].ty;\n");
        buf_str(out, c"            let is_ptr = m.types[bt0].kind == TK_POINTER;\n");
        buf_str(out, c"            let bt = if is_ptr { m.types[bt0].base } else { bt0 };\n");
        buf_str(out, c"            let t = m.types[bt];\n");
        buf_str(out, c"            var idx = 0;\n");
        buf_str(out, c"            var invalid = false;\n");
        buf_str(out, c"            if op == E_ACCESS_INDEX {\n");
        buf_str(out, c"                idx = x.b;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                let iv = inv.mem[fr.base + self.fns[fr.func].regs[x.b]] as i64;\n");
        buf_str(out, c"                idx = iv;\n");
        buf_str(out, c"                if x.c == CK_CLAMP {\n");
        buf_str(out, c"                    if idx > x.d - 1 {\n");
        buf_str(out, c"                        idx = x.d - 1;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                } else if x.c == CK_RZSW {\n");
        buf_str(out, c"                    let g = self.root_global(f, x.a);\n");
        buf_str(out, c"                    let bp = self.get_ptr(inv, fr.base + self.fns[fr.func].regs[x.a]);\n");
        buf_str(out, c"                    let start = (bp & OFF_MASK) * 4;\n");
        buf_str(out, c"                    let len = if g >= 0 { self.runtime_len(g, start, t.stride) } else { 0 };\n");
        buf_str(out, c"                    if idx >= len {\n");
        buf_str(out, c"                        invalid = true;\n");
        buf_str(out, c"                        idx = 0;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                } else if x.c == ir::CK_PENDING {\n");
        buf_str(out, c"                    self.fail(\"an index has no bounds check (internal error)\");\n");
        buf_str(out, c"                    return;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                // CK_NONE: proven in range\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            // the word offset of the component\n");
        buf_str(out, c"            let off = if t.kind == TK_STRUCT {\n");
        buf_str(out, c"                m.members[t.mstart + idx].offset / 4\n");
        buf_str(out, c"            } else if t.kind == TK_VECTOR {\n");
        buf_str(out, c"                idx\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                idx * t.stride / 4\n");
        buf_str(out, c"            };\n");
        buf_str(out, c"            if is_ptr {\n");
        buf_str(out, c"                var p = self.get_ptr(inv, fr.base + self.fns[fr.func].regs[x.a]) + off;\n");
        buf_str(out, c"                if invalid {\n");
        buf_str(out, c"                    p = p | PTR_INVALID;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.put_ptr(&inv, dst, p);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                let w = words_of(m, x.ty);\n");
        buf_str(out, c"                let src = fr.base + self.fns[fr.func].regs[x.a] + off;\n");
        buf_str(out, c"                for k in 0..w {\n");
        buf_str(out, c"                    inv.mem[dst + k] = inv.mem[src + k];\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_COMPOSE {\n");
        buf_str(out, c"            let t = m.types[x.ty];\n");
        buf_str(out, c"            var at = 0;\n");
        buf_str(out, c"            for k in 0..x.b {\n");
        buf_str(out, c"                let a = f.args[x.a + k];\n");
        buf_str(out, c"                let aw = words_of(m, f.exprs[a].ty);\n");
        buf_str(out, c"                let o = compose_offset(m, t, k, at);\n");
        buf_str(out, c"                let src = fr.base + self.fns[fr.func].regs[a];\n");
        buf_str(out, c"                for j in 0..aw {\n");
        buf_str(out, c"                    inv.mem[dst + o + j] = inv.mem[src + j];\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                at += aw;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_SPLAT {\n");
        buf_str(out, c"            let v = inv.mem[fr.base + self.fns[fr.func].regs[x.a]];\n");
        buf_str(out, c"            let n = m.types[x.ty].n;\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                inv.mem[dst + k] = v;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_SWIZZLE {\n");
        buf_str(out, c"            let src = fr.base + self.fns[fr.func].regs[x.a];\n");
        buf_str(out, c"            // through a temporary: the source may be read after the first write\n");
        buf_str(out, c"            var tmp: [u32; 4] = [0; 4];\n");
        buf_str(out, c"            for k in 0..x.c {\n");
        buf_str(out, c"                tmp[k] = inv.mem[src + ((x.b >> (2 * k)) & 3)];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for k in 0..x.c {\n");
        buf_str(out, c"                inv.mem[dst + k] = tmp[k];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_UNARY {\n");
        buf_str(out, c"            let t = m.types[x.ty];\n");
        buf_str(out, c"            let n = if t.kind == TK_VECTOR { t.n } else { 1 };\n");
        buf_str(out, c"            let src = fr.base + self.fns[fr.func].regs[x.b];\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                let v = inv.mem[src + k];\n");
        buf_str(out, c"                inv.mem[dst + k] = if x.a == UN_NEG {\n");
        buf_str(out, c"                    if t.scalar == SK_F32 { ub(-fl(v)) } else { 0 - v }\n");
        buf_str(out, c"                } else if x.a == UN_NOT {\n");
        buf_str(out, c"                    if v == 0 { 1 } else { 0 }\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    ~v\n");
        buf_str(out, c"                };\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_BINARY {\n");
        buf_str(out, c"            self.binary(m, &inv, f, fr, e);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_SELECT {\n");
        buf_str(out, c"            let t = m.types[x.ty];\n");
        buf_str(out, c"            let w = words_of(m, x.ty);\n");
        buf_str(out, c"            let ct = m.types[f.exprs[x.a].ty];\n");
        buf_str(out, c"            let c = fr.base + self.fns[fr.func].regs[x.a];\n");
        buf_str(out, c"            let tsrc = fr.base + self.fns[fr.func].regs[x.b];\n");
        buf_str(out, c"            let fsrc = fr.base + self.fns[fr.func].regs[x.c];\n");
        buf_str(out, c"            for k in 0..w {\n");
        buf_str(out, c"                let ck = if ct.kind == TK_VECTOR { inv.mem[c + k] } else { inv.mem[c] };\n");
        buf_str(out, c"                inv.mem[dst + k] = if ck != 0 { inv.mem[tsrc + k] } else { inv.mem[fsrc + k] };\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let _ = t;\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_CONVERT {\n");
        buf_str(out, c"            let t = m.types[x.ty];\n");
        buf_str(out, c"            let from = m.types[f.exprs[x.a].ty].scalar;\n");
        buf_str(out, c"            let n = if t.kind == TK_VECTOR { t.n } else { 1 };\n");
        buf_str(out, c"            let src = fr.base + self.fns[fr.func].regs[x.a];\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                inv.mem[dst + k] = convert(inv.mem[src + k], from, t.scalar);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_BITCAST {\n");
        buf_str(out, c"            let w = words_of(m, x.ty);\n");
        buf_str(out, c"            let src = fr.base + self.fns[fr.func].regs[x.a];\n");
        buf_str(out, c"            for k in 0..w {\n");
        buf_str(out, c"                inv.mem[dst + k] = inv.mem[src + k];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_MATH {\n");
        buf_str(out, c"            self.math(m, &inv, f, fr, e);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_ARRAY_LENGTH {\n");
        buf_str(out, c"            inv.mem[dst] = self.runtime_len(x.a, x.c, x.d) as u32;\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_DERIVATIVE {\n");
        buf_str(out, c"            // one invocation alone: its derivatives are zero\n");
        buf_str(out, c"            let w = words_of(m, x.ty);\n");
        buf_str(out, c"            for k in 0..w {\n");
        buf_str(out, c"                inv.mem[dst + k] = 0;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_IMAGE_LOAD || op == E_IMAGE_QUERY {\n");
        buf_str(out, c"            let g = inv.mem[fr.base + self.fns[fr.func].regs[x.a]] as i64;\n");
        buf_str(out, c"            let tt = m.types[f.exprs[x.a].ty];\n");
        buf_str(out, c"            if tt.n == ir::TEX_2D_ARRAY {\n");
        buf_str(out, c"                self.fail(\"array textures are not run by the interpreter\");\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let w = self.tex_w[g];\n");
        buf_str(out, c"            let h = self.tex_h[g];\n");
        buf_str(out, c"            if op == E_IMAGE_QUERY {\n");
        buf_str(out, c"                if x.b == ir::IQ_SIZE {\n");
        buf_str(out, c"                    inv.mem[dst] = w as u32;\n");
        buf_str(out, c"                    inv.mem[dst + 1] = h as u32;\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    inv.mem[dst] = 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            // the coordinates clamped (as unsigned) into the one level\n");
        buf_str(out, c"            let c = fr.base + self.fns[fr.func].regs[f.args[x.c]];\n");
        buf_str(out, c"            var cx = inv.mem[c] as i64;\n");
        buf_str(out, c"            var cy = inv.mem[c + 1] as i64;\n");
        buf_str(out, c"            if cx > w - 1 {\n");
        buf_str(out, c"                cx = w - 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if cy > h - 1 {\n");
        buf_str(out, c"                cy = h - 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if w <= 0 || h <= 0 {\n");
        buf_str(out, c"                self.fail(\"a texture the job does not set is read\");\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let t = (cy * w + cx) * 4;\n");
        buf_str(out, c"            let n = words_of(m, x.ty);\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                inv.mem[dst + k] = self.texels[g][t + k];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == E_IMAGE_SAMPLE {\n");
        buf_str(out, c"            self.fail(\"sampling is not run by the interpreter\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.fail(\"unknown expression\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn binary(self, m: Module, inv: inout Inv, f: Function, fr: Frame, e: i64) {\n");
        buf_str(out, c"        let x = f.exprs[e];\n");
        buf_str(out, c"        let dst = fr.base + self.fns[fr.func].regs[e];\n");
        buf_str(out, c"        let lt = m.types[f.exprs[x.b].ty];\n");
        buf_str(out, c"        let rt = m.types[f.exprs[x.c].ty];\n");
        buf_str(out, c"        let l = fr.base + self.fns[fr.func].regs[x.b];\n");
        buf_str(out, c"        let r = fr.base + self.fns[fr.func].regs[x.c];\n");
        buf_str(out, c"        let op = x.a;\n");
        buf_str(out, c"        if lt.kind == TK_MATRIX || rt.kind == TK_MATRIX {\n");
        buf_str(out, c"            self.matrix_binary(m, &inv, op, lt, rt, x.ty, l, r, dst);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let n = if lt.kind == TK_VECTOR { lt.n } else { 1 };\n");
        buf_str(out, c"        let sk = lt.scalar;\n");
        buf_str(out, c"        // the result first in a temporary: dst never overlaps l or r, but stay simple\n");
        buf_str(out, c"        for k in 0..n {\n");
        buf_str(out, c"            let a = inv.mem[l + k];\n");
        buf_str(out, c"            let b = inv.mem[r + k];\n");
        buf_str(out, c"            inv.mem[dst + k] = scalar_binary(op, sk, a, b);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn matrix_binary(self, m: Module, inv: inout Inv, op: i64, lt: ir::Type, rt: ir::Type,\n");
        buf_str(out, c"        ty: i64, l: i64, r: i64, dst: i64) {\n");
        buf_str(out, c"        let res = m.types[ty];\n");
        buf_str(out, c"        if op == OP_ADD || op == OP_SUB {\n");
        buf_str(out, c"            let cs = lt.stride / 4;\n");
        buf_str(out, c"            for c in 0..lt.n {\n");
        buf_str(out, c"                for k in 0..lt.m {\n");
        buf_str(out, c"                    let a = fl(inv.mem[l + c * cs + k]);\n");
        buf_str(out, c"                    let b = fl(inv.mem[r + c * cs + k]);\n");
        buf_str(out, c"                    inv.mem[dst + c * cs + k] = ub(if op == OP_ADD { a + b } else { a - b });\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // multiplication\n");
        buf_str(out, c"        if lt.kind == TK_MATRIX && rt.kind == TK_SCALAR {\n");
        buf_str(out, c"            let cs = lt.stride / 4;\n");
        buf_str(out, c"            let s = fl(inv.mem[r]);\n");
        buf_str(out, c"            for c in 0..lt.n {\n");
        buf_str(out, c"                for k in 0..lt.m {\n");
        buf_str(out, c"                    inv.mem[dst + c * cs + k] = ub(fl(inv.mem[l + c * cs + k]) * s);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if lt.kind == TK_SCALAR {\n");
        buf_str(out, c"            let cs = rt.stride / 4;\n");
        buf_str(out, c"            let s = fl(inv.mem[l]);\n");
        buf_str(out, c"            for c in 0..rt.n {\n");
        buf_str(out, c"                for k in 0..rt.m {\n");
        buf_str(out, c"                    inv.mem[dst + c * cs + k] = ub(s * fl(inv.mem[r + c * cs + k]));\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if lt.kind == TK_MATRIX && rt.kind == TK_VECTOR {\n");
        buf_str(out, c"            // (C x R) * vecC -> vecR\n");
        buf_str(out, c"            let cs = lt.stride / 4;\n");
        buf_str(out, c"            var out: [f32; 4] = [0.0; 4];\n");
        buf_str(out, c"            for k in 0..lt.m {\n");
        buf_str(out, c"                var acc: f32 = 0.0;\n");
        buf_str(out, c"                for c in 0..lt.n {\n");
        buf_str(out, c"                    acc = acc + fl(inv.mem[l + c * cs + k]) * fl(inv.mem[r + c]);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                out[k] = acc;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for k in 0..lt.m {\n");
        buf_str(out, c"                inv.mem[dst + k] = ub(out[k]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if lt.kind == TK_VECTOR {\n");
        buf_str(out, c"            // vecR * (C x R) -> vecC\n");
        buf_str(out, c"            let cs = rt.stride / 4;\n");
        buf_str(out, c"            var out: [f32; 4] = [0.0; 4];\n");
        buf_str(out, c"            for c in 0..rt.n {\n");
        buf_str(out, c"                var acc: f32 = 0.0;\n");
        buf_str(out, c"                for k in 0..rt.m {\n");
        buf_str(out, c"                    acc = acc + fl(inv.mem[l + k]) * fl(inv.mem[r + c * cs + k]);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                out[c] = acc;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for c in 0..rt.n {\n");
        buf_str(out, c"                inv.mem[dst + c] = ub(out[c]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // (K x R) * (C x K) -> (C x R)\n");
        buf_str(out, c"        let ls = lt.stride / 4;\n");
        buf_str(out, c"        let rs = rt.stride / 4;\n");
        buf_str(out, c"        let ds = res.stride / 4;\n");
        buf_str(out, c"        var out: [f32; 16] = [0.0; 16];\n");
        buf_str(out, c"        for c in 0..rt.n {\n");
        buf_str(out, c"            for k in 0..lt.m {\n");
        buf_str(out, c"                var acc: f32 = 0.0;\n");
        buf_str(out, c"                for j in 0..lt.n {\n");
        buf_str(out, c"                    acc = acc + fl(inv.mem[l + j * ls + k]) * fl(inv.mem[r + c * rs + j]);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                out[c * 4 + k] = acc;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for c in 0..rt.n {\n");
        buf_str(out, c"            for k in 0..lt.m {\n");
        buf_str(out, c"                inv.mem[dst + c * ds + k] = ub(out[c * 4 + k]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn math(self, m: Module, inv: inout Inv, fx: Function, fr: Frame, e: i64) {\n");
        buf_str(out, c"        let x = fx.exprs[e];\n");
        buf_str(out, c"        let dst = fr.base + self.fns[fr.func].regs[e];\n");
        buf_str(out, c"        let fun = x.a;\n");
        buf_str(out, c"        let nargs = x.c;\n");
        buf_str(out, c"        var a: [i64; 4] = [0; 4];\n");
        buf_str(out, c"        for k in 0..nargs {\n");
        buf_str(out, c"            a[k] = fr.base + self.fns[fr.func].regs[fx.args[x.b + k]];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let at = m.types[fx.exprs[fx.args[x.b]].ty];\n");
        buf_str(out, c"        let n = if at.kind == TK_VECTOR { at.n } else { 1 };\n");
        buf_str(out, c"        let sk = at.scalar;\n");
        buf_str(out, c"        if fun == ir::MF_DOT {\n");
        buf_str(out, c"            var accf: f32 = 0.0;\n");
        buf_str(out, c"            var acci: u32 = 0;\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                let p = inv.mem[a[0] + k];\n");
        buf_str(out, c"                let q = inv.mem[a[1] + k];\n");
        buf_str(out, c"                if sk == SK_F32 {\n");
        buf_str(out, c"                    accf = accf + fl(p) * fl(q);\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    acci = acci + p * q;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            inv.mem[dst] = if sk == SK_F32 { ub(accf) } else { acci };\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_LENGTH || fun == ir::MF_DISTANCE || fun == ir::MF_NORMALIZE {\n");
        buf_str(out, c"            var acc: f32 = 0.0;\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                var v = fl(inv.mem[a[0] + k]);\n");
        buf_str(out, c"                if fun == ir::MF_DISTANCE {\n");
        buf_str(out, c"                    v = v - fl(inv.mem[a[1] + k]);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                acc = acc + v * v;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let len = unsafe { sqrtf(acc) };\n");
        buf_str(out, c"            if fun == ir::MF_NORMALIZE {\n");
        buf_str(out, c"                for k in 0..n {\n");
        buf_str(out, c"                    inv.mem[dst + k] = ub(fl(inv.mem[a[0] + k]) / len);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                inv.mem[dst] = ub(len);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_CROSS {\n");
        buf_str(out, c"            let p = [fl(inv.mem[a[0]]), fl(inv.mem[a[0] + 1]), fl(inv.mem[a[0] + 2])];\n");
        buf_str(out, c"            let q = [fl(inv.mem[a[1]]), fl(inv.mem[a[1] + 1]), fl(inv.mem[a[1] + 2])];\n");
        buf_str(out, c"            inv.mem[dst] = ub(p[1] * q[2] - p[2] * q[1]);\n");
        buf_str(out, c"            inv.mem[dst + 1] = ub(p[2] * q[0] - p[0] * q[2]);\n");
        buf_str(out, c"            inv.mem[dst + 2] = ub(p[0] * q[1] - p[1] * q[0]);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_REFLECT || fun == ir::MF_FACE_FORWARD {\n");
        buf_str(out, c"            // reflect(e1, e2) = e1 - 2 * dot(e2, e1) * e2\n");
        buf_str(out, c"            // faceForward(e1, e2, e3) = if dot(e2, e3) < 0 { e1 } else { -e1 }\n");
        buf_str(out, c"            let p = if fun == ir::MF_REFLECT { a[1] } else { a[1] };\n");
        buf_str(out, c"            let q = if fun == ir::MF_REFLECT { a[0] } else { a[2] };\n");
        buf_str(out, c"            var d: f32 = 0.0;\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                d = d + fl(inv.mem[p + k]) * fl(inv.mem[q + k]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                let e1 = fl(inv.mem[a[0] + k]);\n");
        buf_str(out, c"                inv.mem[dst + k] = if fun\n");
        buf_str(out, c"                    == ir::MF_REFLECT { ub(e1 - 2.0 * d * fl(inv.mem[a[1] + k])) }\n");
        buf_str(out, c"                    else if d < 0.0 { ub(e1) } else { ub(-e1) };\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_ALL || fun == ir::MF_ANY {\n");
        buf_str(out, c"            var r = if fun == ir::MF_ALL { 1u32 } else { 0u32 };\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                let v = inv.mem[a[0] + k];\n");
        buf_str(out, c"                if fun == ir::MF_ALL && v == 0 {\n");
        buf_str(out, c"                    r = 0;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if fun == ir::MF_ANY && v != 0 {\n");
        buf_str(out, c"                    r = 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            inv.mem[dst] = r;\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_DETERMINANT || fun == ir::MF_TRANSPOSE {\n");
        buf_str(out, c"            let cs = at.stride / 4;\n");
        buf_str(out, c"            if fun == ir::MF_TRANSPOSE {\n");
        buf_str(out, c"                let rt = m.types[x.ty];\n");
        buf_str(out, c"                let rs = rt.stride / 4;\n");
        buf_str(out, c"                for c in 0..at.n {\n");
        buf_str(out, c"                    for k in 0..at.m {\n");
        buf_str(out, c"                        inv.mem[dst + k * rs + c] = inv.mem[a[0] + c * cs + k];\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            var mm: [f32; 16] = [0.0; 16];\n");
        buf_str(out, c"            for c in 0..at.n {\n");
        buf_str(out, c"                for k in 0..at.m {\n");
        buf_str(out, c"                    mm[c * 4 + k] = fl(inv.mem[a[0] + c * cs + k]);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            inv.mem[dst] = ub(determinant(mm, at.n));\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun >= ir::MF_PACK4X8UNORM && fun <= ir::MF_UNPACK2X16FLOAT\n");
        buf_str(out, c"            || fun >= ir::MF_PACK4X8SNORM {\n");
        buf_str(out, c"            self.packing(&inv, fun, a[0], dst);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // component-wise\n");
        buf_str(out, c"        let mix_scalar = false;\n");
        buf_str(out, c"        let _ = mix_scalar;\n");
        buf_str(out, c"        for k in 0..n {\n");
        buf_str(out, c"            let p = inv.mem[a[0] + k];\n");
        buf_str(out, c"            let q = if nargs > 1 { inv.mem[a[1] + k] } else { 0 };\n");
        buf_str(out, c"            let r = if nargs > 2 { inv.mem[a[2] + k] } else { 0 };\n");
        buf_str(out, c"            let s = if nargs > 3 { inv.mem[a[3] + k] } else { 0 };\n");
        buf_str(out, c"            if fun == ir::MF_EXTRACT_BITS {\n");
        buf_str(out, c"                inv.mem[dst + k] = extract_bits(p, inv.mem[a[1]], inv.mem[a[2]], sk == SK_I32);\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if fun == ir::MF_INSERT_BITS {\n");
        buf_str(out, c"                inv.mem[dst + k] = insert_bits(p, q, inv.mem[a[2]], inv.mem[a[3]]);\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let _ = s;\n");
        buf_str(out, c"            inv.mem[dst + k] = component_math(fun, sk, p, q, r);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn packing(self, inv: inout Inv, fun: i64, src: i64, dst: i64) {\n");
        buf_str(out, c"        if fun == ir::MF_PACK4X8UNORM || fun == ir::MF_PACK4X8SNORM {\n");
        buf_str(out, c"            var r: u32 = 0;\n");
        buf_str(out, c"            for k in 0..4 {\n");
        buf_str(out, c"                let v = fl(inv.mem[src + k]);\n");
        buf_str(out, c"                let q = if fun == ir::MF_PACK4X8UNORM {\n");
        buf_str(out, c"                    (round_even(clampf(v, 0.0, 1.0) * 255.0) as i64) & 255\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    (round_even(clampf(v, -1.0, 1.0) * 127.0) as i64) & 255\n");
        buf_str(out, c"                };\n");
        buf_str(out, c"                r = r | ((q as u32) << (8 * k) as u32);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            inv.mem[dst] = r;\n");
        buf_str(out, c"        } else if fun == ir::MF_UNPACK4X8UNORM || fun == ir::MF_UNPACK4X8SNORM {\n");
        buf_str(out, c"            let v = inv.mem[src];\n");
        buf_str(out, c"            for k in 0..4 {\n");
        buf_str(out, c"                let b = (v >> (8 * k) as u32) & 255;\n");
        buf_str(out, c"                inv.mem[dst + k] = if fun == ir::MF_UNPACK4X8UNORM {\n");
        buf_str(out, c"                    ub(b as f32 / 255.0)\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    let sb = if b >= 128 { b as i64 - 256 } else { b as i64 };\n");
        buf_str(out, c"                    ub(maxf(sb as f32 / 127.0, -1.0))\n");
        buf_str(out, c"                };\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if fun == ir::MF_PACK2X16UNORM || fun == ir::MF_PACK2X16SNORM {\n");
        buf_str(out, c"            var r: u32 = 0;\n");
        buf_str(out, c"            for k in 0..2 {\n");
        buf_str(out, c"                let v = fl(inv.mem[src + k]);\n");
        buf_str(out, c"                let q = if fun == ir::MF_PACK2X16UNORM {\n");
        buf_str(out, c"                    (round_even(clampf(v, 0.0, 1.0) * 65535.0) as i64) & 65535\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    (round_even(clampf(v, -1.0, 1.0) * 32767.0) as i64) & 65535\n");
        buf_str(out, c"                };\n");
        buf_str(out, c"                r = r | ((q as u32) << (16 * k) as u32);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            inv.mem[dst] = r;\n");
        buf_str(out, c"        } else if fun == ir::MF_UNPACK2X16UNORM || fun == ir::MF_UNPACK2X16SNORM {\n");
        buf_str(out, c"            let v = inv.mem[src];\n");
        buf_str(out, c"            for k in 0..2 {\n");
        buf_str(out, c"                let b = (v >> (16 * k) as u32) & 65535;\n");
        buf_str(out, c"                inv.mem[dst + k] = if fun == ir::MF_UNPACK2X16UNORM {\n");
        buf_str(out, c"                    ub(b as f32 / 65535.0)\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    let sb = if b >= 32768 { b as i64 - 65536 } else { b as i64 };\n");
        buf_str(out, c"                    ub(maxf(sb as f32 / 32767.0, -1.0))\n");
        buf_str(out, c"                };\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if fun == ir::MF_PACK2X16FLOAT {\n");
        buf_str(out, c"            let lo = f32_to_f16(fl(inv.mem[src]));\n");
        buf_str(out, c"            let hi = f32_to_f16(fl(inv.mem[src + 1]));\n");
        buf_str(out, c"            inv.mem[dst] = lo | (hi << 16);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            let v = inv.mem[src];\n");
        buf_str(out, c"            inv.mem[dst] = ub(f16_to_f32(v & 65535));\n");
        buf_str(out, c"            inv.mem[dst + 1] = ub(f16_to_f32(v >> 16));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn clampf(x: f32, lo: f32, hi: f32) -> f32 { if x < lo { lo } else if x > hi { hi } else { x } }\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn maxf(a: f32, b: f32) -> f32 { if a > b { a } else { b } }\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn round_even(x: f32) -> f32 { unsafe { rintf(x) } }\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn f32_to_f16(x: f32) -> u32 {\n");
        buf_str(out, c"    let b = ub(x);\n");
        buf_str(out, c"    let sign = (b >> 16) & 32768;\n");
        buf_str(out, c"    let exp = ((b >> 23) & 255) as i64 - 127 + 15;\n");
        buf_str(out, c"    let man = b & 8388607;\n");
        buf_str(out, c"    if ((b >> 23) & 255) == 255 {\n");
        buf_str(out, c"        return sign | 31744 | (if man != 0 { 512 } else { 0 });\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if exp >= 31 {\n");
        buf_str(out, c"        return sign | 31744;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if exp <= 0 {\n");
        buf_str(out, c"        if exp < -10 {\n");
        buf_str(out, c"            return sign;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let m2 = man | 8388608;\n");
        buf_str(out, c"        let shift = (14 - exp) as u32;\n");
        buf_str(out, c"        var h = m2 >> shift;\n");
        buf_str(out, c"        let rem = m2 & ((1u32 << shift) - 1);\n");
        buf_str(out, c"        let half = 1u32 << (shift - 1);\n");
        buf_str(out, c"        if rem > half || (rem == half && (h & 1) != 0) {\n");
        buf_str(out, c"            h += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return sign | h;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var h = sign | ((exp as u32) << 10) | (man >> 13);\n");
        buf_str(out, c"    let rem = man & 8191;\n");
        buf_str(out, c"    if rem > 4096 || (rem == 4096 && (h & 1) != 0) {\n");
        buf_str(out, c"        h += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    h\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn f16_to_f32(h: u32) -> f32 {\n");
        buf_str(out, c"    let sign = (h & 32768) << 16;\n");
        buf_str(out, c"    let exp = (h >> 10) & 31;\n");
        buf_str(out, c"    let man = h & 1023;\n");
        buf_str(out, c"    if exp == 0 {\n");
        buf_str(out, c"        let v = man as f32 / 16777216.0;\n");
        buf_str(out, c"        return if sign != 0 { -v } else { v };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if exp == 31 {\n");
        buf_str(out, c"        return fl(sign | 2139095040 | (man << 13));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    fl(sign | ((exp + 112) << 23) | (man << 13))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn determinant(m: [f32; 16], n: i64) -> f32 {\n");
        buf_str(out, c"    if n == 2 {\n");
        buf_str(out, c"        return m[0] * m[5] - m[4] * m[1];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if n == 3 {\n");
        buf_str(out, c"        return m[0] * (m[5] * m[10] - m[9] * m[6]) - m[4] * (m[1] * m[10] - m[9] * m[2]) + m[8] * (\n");
        buf_str(out, c"            m[1] * m[6] - m[5] * m[2]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var det: f32 = 0.0;\n");
        buf_str(out, c"    for c in 0..4 {\n");
        buf_str(out, c"        var sub: [f32; 16] = [0.0; 16];\n");
        buf_str(out, c"        var sc = 0;\n");
        buf_str(out, c"        for j in 0..4 {\n");
        buf_str(out, c"            if j == c {\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for k in 1..4 {\n");
        buf_str(out, c"                sub[sc * 4 + k - 1] = m[j * 4 + k];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            sc += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let d = determinant(sub, 3);\n");
        buf_str(out, c"        det = if c % 2 == 0 { det + m[c * 4] * d } else { det - m[c * 4] * d };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    det\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn convert(v: u32, from: u8, to: u8) -> u32 {\n");
        buf_str(out, c"    if from == to {\n");
        buf_str(out, c"        return v;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if to == SK_BOOL {\n");
        buf_str(out, c"        return if from == SK_F32 { if fl(v) != 0.0 { 1 } else { 0 } } else if v != 0 { 1 }\n");
        buf_str(out, c"            else { 0 };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if from == SK_BOOL {\n");
        buf_str(out, c"        return if to == SK_F32 { if v != 0 { ub(1.0) } else { 0 } } else { v };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if to == SK_F32 {\n");
        buf_str(out, c"        return if from == SK_I32 { ub(si(v) as f32) } else { ub(v as i64 as f32) };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if from == SK_F32 {\n");
        buf_str(out, c"        let x = fl(v);\n");
        buf_str(out, c"        if x != x {\n");
        buf_str(out, c"            return 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if to == SK_I32 {\n");
        buf_str(out, c"            if x <= -2147483648.0 {\n");
        buf_str(out, c"                return 2147483648;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            // WGSL: the nearest value representable in both i32 and f32\n");
        buf_str(out, c"            if x >= 2147483520.0 {\n");
        buf_str(out, c"                return 2147483520;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return (x as i64) as u32;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if x <= 0.0 {\n");
        buf_str(out, c"            return 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if x >= 4294967040.0 {\n");
        buf_str(out, c"            return 4294967040;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return (x as i64) as u32;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // i32 <-> u32: the bits\n");
        buf_str(out, c"    v\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn scalar_binary(op: i64, sk: u8, a: u32, b: u32) -> u32 {\n");
        buf_str(out, c"    if sk == SK_F32 {\n");
        buf_str(out, c"        let x = fl(a);\n");
        buf_str(out, c"        let y = fl(b);\n");
        buf_str(out, c"        if op == OP_ADD {\n");
        buf_str(out, c"            return ub(x + y);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == OP_SUB {\n");
        buf_str(out, c"            return ub(x - y);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == OP_MUL {\n");
        buf_str(out, c"            return ub(x * y);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == OP_DIV {\n");
        buf_str(out, c"            return ub(x / y);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if op == OP_MOD {\n");
        buf_str(out, c"            // WGSL: x - y * trunc(x / y)\n");
        buf_str(out, c"            return ub(unsafe { fmodf(x, y) });\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let c = if op == OP_EQ { x == y } else if op == OP_NE { x != y }\n");
        buf_str(out, c"            else if op == OP_LT { x < y } else if op == OP_LE { x <= y }\n");
        buf_str(out, c"            else if op == OP_GT { x > y } else { x >= y };\n");
        buf_str(out, c"        return if c { 1 } else { 0 };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if op == OP_ADD {\n");
        buf_str(out, c"        return a + b;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if op == OP_SUB {\n");
        buf_str(out, c"        return a - b;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if op == OP_MUL {\n");
        buf_str(out, c"        return a * b;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if op == OP_DIV {\n");
        buf_str(out, c"        if b == 0 {\n");
        buf_str(out, c"            return a;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if sk == SK_I32 {\n");
        buf_str(out, c"            if a == 2147483648 && b == 4294967295 {\n");
        buf_str(out, c"                return a;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return (si(a) / si(b)) as u32;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return a / b;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if op == OP_MOD {\n");
        buf_str(out, c"        if b == 0 {\n");
        buf_str(out, c"            return 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if sk == SK_I32 {\n");
        buf_str(out, c"            if a == 2147483648 && b == 4294967295 {\n");
        buf_str(out, c"                return 0;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return (si(a) % si(b)) as u32;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return a % b;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if op == OP_AND || op == OP_LAND {\n");
        buf_str(out, c"        return a & b;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if op == OP_OR || op == OP_LOR {\n");
        buf_str(out, c"        return a | b;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if op == OP_XOR {\n");
        buf_str(out, c"        return a ^ b;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if op == OP_SHL {\n");
        buf_str(out, c"        return a << (b & 31);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if op == OP_SHR {\n");
        buf_str(out, c"        if sk == SK_I32 {\n");
        buf_str(out, c"            return (si(a) >> (b & 31) as i64) as u32;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return a >> (b & 31);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let c = if sk == SK_I32 {\n");
        buf_str(out, c"        let x = si(a);\n");
        buf_str(out, c"        let y = si(b);\n");
        buf_str(out, c"        if op == OP_EQ { x == y } else if op == OP_NE { x != y } else if op == OP_LT { x < y }\n");
        buf_str(out, c"        else if op == OP_LE { x <= y } else if op == OP_GT { x > y } else { x >= y }\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        if op == OP_EQ { a == b } else if op == OP_NE { a != b } else if op == OP_LT { a < b }\n");
        buf_str(out, c"        else if op == OP_LE { a <= b } else if op == OP_GT { a > b } else { a >= b }\n");
        buf_str(out, c"    };\n");
        buf_str(out, c"    if c { 1 } else { 0 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn extract_bits(e: u32, offset: u32, count: u32, signed: bool) -> u32 {\n");
        buf_str(out, c"    let o = if offset > 32 { 32 } else { offset };\n");
        buf_str(out, c"    let c = if count > 32 - o { 32 - o } else { count };\n");
        buf_str(out, c"    if c == 0 {\n");
        buf_str(out, c"        return 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let v = if o == 32 { 0 } else { e >> o };\n");
        buf_str(out, c"    if c == 32 {\n");
        buf_str(out, c"        return v;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mask = (1u32 << c) - 1;\n");
        buf_str(out, c"    let r = v & mask;\n");
        buf_str(out, c"    if signed && (r >> (c - 1)) & 1 != 0 {\n");
        buf_str(out, c"        return r | ~mask;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    r\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn insert_bits(e: u32, nb: u32, offset: u32, count: u32) -> u32 {\n");
        buf_str(out, c"    let o = if offset > 32 { 32 } else { offset };\n");
        buf_str(out, c"    let c = if count > 32 - o { 32 - o } else { count };\n");
        buf_str(out, c"    if c == 0 {\n");
        buf_str(out, c"        return e;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mask = if c == 32 { 4294967295u32 } else { ((1u32 << c) - 1) << o };\n");
        buf_str(out, c"    (e & ~mask) | ((nb << o) & mask)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn clz(x: u32) -> u32 {\n");
        buf_str(out, c"    if x == 0 {\n");
        buf_str(out, c"        return 32;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    std::leading_zeros(x as u64) as u32 - 32\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn ctz(x: u32) -> u32 {\n");
        buf_str(out, c"    if x == 0 {\n");
        buf_str(out, c"        return 32;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    std::trailing_zeros(x as u64) as u32\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn component_math(fun: i64, sk: u8, p: u32, q: u32, r: u32) -> u32 {\n");
        buf_str(out, c"    if sk != SK_F32 {\n");
        buf_str(out, c"        let signed = sk == SK_I32;\n");
        buf_str(out, c"        if fun == ir::MF_ABS {\n");
        buf_str(out, c"            return if signed && si(p) < 0 { 0 - p } else { p };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_MIN {\n");
        buf_str(out, c"            return if (signed && si(q) < si(p)) || (!signed && q < p) { q } else { p };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_MAX {\n");
        buf_str(out, c"            return if (signed && si(q) > si(p)) || (!signed && q > p) { q } else { p };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_CLAMP {\n");
        buf_str(out, c"            let lo = component_math(ir::MF_MAX, sk, p, q, 0);\n");
        buf_str(out, c"            return component_math(ir::MF_MIN, sk, lo, r, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_SIGN {\n");
        buf_str(out, c"            return if si(p) > 0 { 1 } else if si(p) < 0 { 4294967295 } else { 0 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_COUNT_ONE_BITS {\n");
        buf_str(out, c"            var c: u32 = 0;\n");
        buf_str(out, c"            var x = p;\n");
        buf_str(out, c"            while x != 0 {\n");
        buf_str(out, c"                c += x & 1;\n");
        buf_str(out, c"                x = x >> 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return c;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_COUNT_LEADING_ZEROS {\n");
        buf_str(out, c"            return clz(p);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_COUNT_TRAILING_ZEROS {\n");
        buf_str(out, c"            return ctz(p);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_FIRST_LEADING_BIT {\n");
        buf_str(out, c"            let x = if signed && si(p) < 0 { ~p } else { p };\n");
        buf_str(out, c"            if x == 0 {\n");
        buf_str(out, c"                return 4294967295;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return 31 - clz(x);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_FIRST_TRAILING_BIT {\n");
        buf_str(out, c"            if p == 0 {\n");
        buf_str(out, c"                return 4294967295;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return ctz(p);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fun == ir::MF_REVERSE_BITS {\n");
        buf_str(out, c"            var x = p;\n");
        buf_str(out, c"            var rr: u32 = 0;\n");
        buf_str(out, c"            for _ in 0..32 {\n");
        buf_str(out, c"                rr = (rr << 1) | (x & 1);\n");
        buf_str(out, c"                x = x >> 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return rr;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let x = fl(p);\n");
        buf_str(out, c"    let y = fl(q);\n");
        buf_str(out, c"    let z = fl(r);\n");
        buf_str(out, c"    let v: f32 = if fun == ir::MF_ABS {\n");
        buf_str(out, c"        if x < 0.0 { -x } else if x == 0.0 { 0.0 } else { x }\n");
        buf_str(out, c"    } else if fun == ir::MF_MIN {\n");
        buf_str(out, c"        unsafe { fminf(x, y) }\n");
        buf_str(out, c"    } else if fun == ir::MF_MAX {\n");
        buf_str(out, c"        unsafe { fmaxf(x, y) }\n");
        buf_str(out, c"    } else if fun == ir::MF_CLAMP {\n");
        buf_str(out, c"        unsafe { fminf(fmaxf(x, y), z) }\n");
        buf_str(out, c"    } else if fun == ir::MF_SIGN {\n");
        buf_str(out, c"        if x > 0.0 { 1.0 } else if x < 0.0 { -1.0 } else { 0.0 }\n");
        buf_str(out, c"    } else if fun == ir::MF_FLOOR {\n");
        buf_str(out, c"        unsafe { floorf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_CEIL {\n");
        buf_str(out, c"        unsafe { ceilf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_ROUND {\n");
        buf_str(out, c"        unsafe { rintf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_FRACT {\n");
        buf_str(out, c"        x - unsafe { floorf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_TRUNC {\n");
        buf_str(out, c"        unsafe { truncf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_SQRT {\n");
        buf_str(out, c"        unsafe { sqrtf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_INVERSE_SQRT {\n");
        buf_str(out, c"        1.0 / unsafe { sqrtf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_EXP {\n");
        buf_str(out, c"        unsafe { expf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_EXP2 {\n");
        buf_str(out, c"        unsafe { exp2f(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_LOG {\n");
        buf_str(out, c"        unsafe { logf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_LOG2 {\n");
        buf_str(out, c"        unsafe { log2f(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_POW {\n");
        buf_str(out, c"        unsafe { powf(x, y) }\n");
        buf_str(out, c"    } else if fun == ir::MF_SIN {\n");
        buf_str(out, c"        unsafe { sinf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_COS {\n");
        buf_str(out, c"        unsafe { cosf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_TAN {\n");
        buf_str(out, c"        unsafe { tanf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_ASIN {\n");
        buf_str(out, c"        unsafe { asinf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_ACOS {\n");
        buf_str(out, c"        unsafe { acosf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_ATAN {\n");
        buf_str(out, c"        unsafe { atanf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_ATAN2 {\n");
        buf_str(out, c"        unsafe { atan2f(x, y) }\n");
        buf_str(out, c"    } else if fun == ir::MF_SINH {\n");
        buf_str(out, c"        unsafe { sinhf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_COSH {\n");
        buf_str(out, c"        unsafe { coshf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_TANH {\n");
        buf_str(out, c"        unsafe { tanhf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_ASINH {\n");
        buf_str(out, c"        unsafe { asinhf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_ACOSH {\n");
        buf_str(out, c"        unsafe { acoshf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_ATANH {\n");
        buf_str(out, c"        unsafe { atanhf(x) }\n");
        buf_str(out, c"    } else if fun == ir::MF_MIX {\n");
        buf_str(out, c"        x * (1.0 - z) + y * z\n");
        buf_str(out, c"    } else if fun == ir::MF_STEP {\n");
        buf_str(out, c"        if y >= x { 1.0 } else { 0.0 }\n");
        buf_str(out, c"    } else if fun == ir::MF_SMOOTHSTEP {\n");
        buf_str(out, c"        let t = clampf((z - x) / (y - x), 0.0, 1.0);\n");
        buf_str(out, c"        t * t * (3.0 - 2.0 * t)\n");
        buf_str(out, c"    } else if fun == ir::MF_FMA {\n");
        buf_str(out, c"        unsafe { fmaf(x, y, z) }\n");
        buf_str(out, c"    } else if fun == ir::MF_DEGREES {\n");
        buf_str(out, c"        x * 57.295779513082322865\n");
        buf_str(out, c"    } else if fun == ir::MF_RADIANS {\n");
        buf_str(out, c"        x * 0.017453292519943295\n");
        buf_str(out, c"    } else if fun == ir::MF_SATURATE {\n");
        buf_str(out, c"        clampf(x, 0.0, 1.0)\n");
        buf_str(out, c"    } else if fun == ir::MF_LDEXP {\n");
        buf_str(out, c"        unsafe { ldexpf(x, q as i32) }\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        0.0\n");
        buf_str(out, c"    };\n");
        buf_str(out, c"    ub(v)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl::interp ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::gpu::wgsl::dump ----\n");
        buf_str(out, c"pub mod dump {\n");
        buf_str(out, c"// ---- Shader compiler implementation, dump (0.22) ----\n");
        buf_str(out, c"// The IR as text: `wgslc ir FILE`, and the front end's golden tests.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use ir::{\n");
        buf_str(out, c"    E_ACCESS, E_ACCESS_INDEX, E_ARG, E_ARRAY_LENGTH, E_ATOMIC_RESULT, E_BINARY, E_BITCAST,\n");
        buf_str(out, c"    E_CALL_RESULT, E_COMPOSE, E_CONVERT, E_DERIVATIVE, E_GLOBAL, E_IMAGE_LOAD, E_IMAGE_QUERY,\n");
        buf_str(out, c"    E_IMAGE_SAMPLE, E_LITERAL, E_LOAD, E_LOCAL, E_MATH, E_SELECT, E_SPLAT, E_SWIZZLE, E_UNARY,\n");
        buf_str(out, c"    E_WG_UNIFORM_RESULT, E_ZERO, Function, Module, SK_BOOL, SK_F32, SK_I32, S_ATOMIC, S_BARRIER,\n");
        buf_str(out, c"    S_BLOCK, S_BREAK, S_CALL, S_CONTINUE, S_EMIT, S_IF, S_IMAGE_STORE, S_KILL, S_LOOP, S_RETURN,\n");
        buf_str(out, c"    S_STORE, S_SWITCH, S_WG_UNIFORM_LOAD, bits_f32,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"use std::{Allocator, Buf};\n");
        buf_str(out, c"\n");
        buf_str(out, c"const UN: [[u8]; 3] = [\"neg\", \"not\", \"bitnot\"];\n");
        buf_str(out, c"const BIN: [[u8]; 18] = [\"add\", \"sub\", \"mul\", \"div\", \"mod\", \"eq\", \"ne\", \"lt\", \"le\", \"gt\", \"ge\",\n");
        buf_str(out, c"    \"and\", \"or\", \"xor\", \"shl\", \"shr\", \"land\", \"lor\"];\n");
        buf_str(out, c"const ATOM: [[u8]; 11] = [\"add\", \"sub\", \"and\", \"or\", \"xor\", \"min\", \"max\", \"exchange\", \"load\",\n");
        buf_str(out, c"    \"store\", \"cmpxchg\"];\n");
        buf_str(out, c"const CK: [[u8]; 4] = [\"pending\", \"none\", \"clamp\", \"rzsw\"];\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn dump<A: Allocator>(m: Module, b: inout Buf<A>) {\n");
        buf_str(out, c"    for t in ir::T_FIXED_COUNT..m.types.len() {\n");
        buf_str(out, c"        let ty = m.types[t];\n");
        buf_str(out, c"        if ty.kind == ir::TK_STRUCT {\n");
        buf_str(out, c"            b.push_fmt(f\"struct {ty.name} (size {ty.size}, align {ty.align}) {{\");\n");
        buf_str(out, c"            for i in ty.mstart..ty.mstart + ty.mcount {\n");
        buf_str(out, c"                let mem = m.members[i];\n");
        buf_str(out, c"                b.push_fmt(f\" {mem.name}: \");\n");
        buf_str(out, c"                m.type_name(mem.ty, &b);\n");
        buf_str(out, c"                b.push_fmt(f\" @{mem.offset};\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            b.push_str(\" }\\n\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for g in 0..m.globals.len() {\n");
        buf_str(out, c"        let gl = m.globals[g];\n");
        buf_str(out, c"        b.push_fmt(f\"global {g} {gl.name}: {ir::space_name(gl.space)}\");\n");
        buf_str(out, c"        if gl.space == ir::SP_STORAGE {\n");
        buf_str(out, c"            b.push_str(if gl.access == ir::ACC_RW { \" read_write\" } else { \" read\" });\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b.push(' ');\n");
        buf_str(out, c"        m.type_name(gl.ty, &b);\n");
        buf_str(out, c"        if gl.group >= 0 {\n");
        buf_str(out, c"            b.push_fmt(f\" @group({gl.group}) @binding({gl.binding})\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if gl.init >= 0 {\n");
        buf_str(out, c"            b.push_str(\" = \");\n");
        buf_str(out, c"            expr_text(m, m.consts, gl.init, &b);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b.push('\\n');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for e in 0..m.entries.len() {\n");
        buf_str(out, c"        let en = m.entries[e];\n");
        buf_str(out, c"        b.push_fmt(f\"entry {entry::stage_name(en.stage)} {en.name} = fn {en.func}\");\n");
        buf_str(out, c"        if en.stage == ir::STAGE_COMPUTE {\n");
        buf_str(out, c"            b.push_fmt(f\" workgroup_size({en.wg[0]}, {en.wg[1]}, {en.wg[2]})\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b.push('\\n');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for i in 0..m.functions.len() {\n");
        buf_str(out, c"        dump_fn(m, i, &b);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn binding_text<A: Allocator>(bd: ir::Binding, b: inout Buf<A>) {\n");
        buf_str(out, c"    if bd.kind == ir::BIND_BUILTIN {\n");
        buf_str(out, c"        b.push_fmt(f\" @builtin({entry::builtin_name(bd.value)})\");\n");
        buf_str(out, c"    } else if bd.kind == ir::BIND_LOCATION {\n");
        buf_str(out, c"        b.push_fmt(f\" @location({bd.value})\");\n");
        buf_str(out, c"        if bd.interp == ir::INTERP_FLAT {\n");
        buf_str(out, c"            b.push_str(\" @interpolate(flat)\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn dump_fn<A: Allocator>(m: Module, h: i64, b: inout Buf<A>) {\n");
        buf_str(out, c"    let f = m.functions[h];\n");
        buf_str(out, c"    b.push_fmt(f\"fn {h} {f.name}(\");\n");
        buf_str(out, c"    for i in 0..f.params.len() {\n");
        buf_str(out, c"        if i > 0 {\n");
        buf_str(out, c"            b.push_str(\", \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b.push_fmt(f\"{f.params[i].name}: \");\n");
        buf_str(out, c"        m.type_name(f.params[i].ty, &b);\n");
        buf_str(out, c"        binding_text(f.params[i].binding, &b);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    b.push_str(\") -> \");\n");
        buf_str(out, c"    m.type_name(f.result, &b);\n");
        buf_str(out, c"    binding_text(f.result_binding, &b);\n");
        buf_str(out, c"    b.push('\\n');\n");
        buf_str(out, c"    for i in 0..f.locals.len() {\n");
        buf_str(out, c"        b.push_fmt(f\"  local {i} {f.locals[i].name}: \");\n");
        buf_str(out, c"        m.type_name(f.locals[i].ty, &b);\n");
        buf_str(out, c"        b.push('\\n');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for e in 0..f.exprs.len() {\n");
        buf_str(out, c"        b.push_fmt(f\"  e{e}: \");\n");
        buf_str(out, c"        m.type_name(f.exprs[e].ty, &b);\n");
        buf_str(out, c"        b.push_str(\" = \");\n");
        buf_str(out, c"        expr_text(m, f, e, &b);\n");
        buf_str(out, c"        if f.names[e].len > 0 {\n");
        buf_str(out, c"            b.push_fmt(f\"  // {f.names[e]}\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b.push('\\n');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if f.body >= 0 {\n");
        buf_str(out, c"        block_text(m, f, f.body, 1, &b);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn indent<A: Allocator>(n: i64, b: inout Buf<A>) {\n");
        buf_str(out, c"    for _ in 0..n {\n");
        buf_str(out, c"        b.push_str(\"  \");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn block_text<A: Allocator>(m: Module, f: Function, blk: i64, depth: i64, b: inout Buf<A>) {\n");
        buf_str(out, c"    let bl = f.blocks[blk];\n");
        buf_str(out, c"    for i in bl.start..bl.start + bl.count {\n");
        buf_str(out, c"        stmt_text(m, f, f.items[i], depth, &b);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn stmt_text<A: Allocator>(m: Module, f: Function, s: i64, depth: i64, b: inout Buf<A>) {\n");
        buf_str(out, c"    let st = f.stmts[s];\n");
        buf_str(out, c"    indent(depth, &b);\n");
        buf_str(out, c"    if st.op == S_EMIT {\n");
        buf_str(out, c"        b.push_fmt(f\"emit e{st.a}..e{st.b}\\n\");\n");
        buf_str(out, c"    } else if st.op == S_BLOCK {\n");
        buf_str(out, c"        b.push_str(\"block\\n\");\n");
        buf_str(out, c"        block_text(m, f, st.a, depth + 1, &b);\n");
        buf_str(out, c"    } else if st.op == S_IF {\n");
        buf_str(out, c"        b.push_fmt(f\"if e{st.a}\\n\");\n");
        buf_str(out, c"        block_text(m, f, st.b, depth + 1, &b);\n");
        buf_str(out, c"        if f.blocks[st.c].count > 0 {\n");
        buf_str(out, c"            indent(depth, &b);\n");
        buf_str(out, c"            b.push_str(\"else\\n\");\n");
        buf_str(out, c"            block_text(m, f, st.c, depth + 1, &b);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else if st.op == S_SWITCH {\n");
        buf_str(out, c"        b.push_fmt(f\"switch e{st.a}\\n\");\n");
        buf_str(out, c"        for i in st.b..st.b + st.c {\n");
        buf_str(out, c"            let c = f.cases[i];\n");
        buf_str(out, c"            indent(depth, &b);\n");
        buf_str(out, c"            b.push_str(\"case\");\n");
        buf_str(out, c"            for k in c.vstart..c.vstart + c.vcount {\n");
        buf_str(out, c"                b.push_fmt(f\" {f.vals[k]}\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if c.is_default {\n");
        buf_str(out, c"                b.push_str(\" default\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            b.push('\\n');\n");
        buf_str(out, c"            block_text(m, f, c.body, depth + 1, &b);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else if st.op == S_LOOP {\n");
        buf_str(out, c"        b.push_str(\"loop\\n\");\n");
        buf_str(out, c"        block_text(m, f, st.a, depth + 1, &b);\n");
        buf_str(out, c"        if f.blocks[st.b].count > 0 || st.c >= 0 {\n");
        buf_str(out, c"            indent(depth, &b);\n");
        buf_str(out, c"            b.push_str(\"continuing\\n\");\n");
        buf_str(out, c"            block_text(m, f, st.b, depth + 1, &b);\n");
        buf_str(out, c"            if st.c >= 0 {\n");
        buf_str(out, c"                indent(depth + 1, &b);\n");
        buf_str(out, c"                b.push_fmt(f\"break if e{st.c}\\n\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else if st.op == S_BREAK {\n");
        buf_str(out, c"        b.push_str(\"break\\n\");\n");
        buf_str(out, c"    } else if st.op == S_CONTINUE {\n");
        buf_str(out, c"        b.push_str(\"continue\\n\");\n");
        buf_str(out, c"    } else if st.op == S_RETURN {\n");
        buf_str(out, c"        if st.a >= 0 {\n");
        buf_str(out, c"            b.push_fmt(f\"return e{st.a}\\n\");\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            b.push_str(\"return\\n\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else if st.op == S_KILL {\n");
        buf_str(out, c"        b.push_str(\"discard\\n\");\n");
        buf_str(out, c"    } else if st.op == S_BARRIER {\n");
        buf_str(out, c"        b.push_str(if st.a == ir::BARRIER_WORKGROUP { \"barrier workgroup\\n\" }\n");
        buf_str(out, c"            else { \"barrier storage\\n\" });\n");
        buf_str(out, c"    } else if st.op == S_STORE {\n");
        buf_str(out, c"        b.push_fmt(f\"store e{st.a} <- e{st.b}\\n\");\n");
        buf_str(out, c"    } else if st.op == S_CALL {\n");
        buf_str(out, c"        if st.d >= 0 {\n");
        buf_str(out, c"            b.push_fmt(f\"e{st.d} = \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b.push_fmt(f\"call fn {st.a}(\");\n");
        buf_str(out, c"        for i in st.b..st.b + st.c {\n");
        buf_str(out, c"            if i > st.b {\n");
        buf_str(out, c"                b.push_str(\", \");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            b.push_fmt(f\"e{f.args[i]}\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b.push_str(\")\\n\");\n");
        buf_str(out, c"    } else if st.op == S_ATOMIC {\n");
        buf_str(out, c"        if st.d >= 0 {\n");
        buf_str(out, c"            b.push_fmt(f\"e{st.d} = \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b.push_fmt(f\"atomic {ATOM[st.b]} e{st.a}\");\n");
        buf_str(out, c"        if st.e >= 0 {\n");
        buf_str(out, c"            b.push_fmt(f\" cmp e{st.e}\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if st.c >= 0 {\n");
        buf_str(out, c"            b.push_fmt(f\" e{st.c}\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b.push('\\n');\n");
        buf_str(out, c"    } else if st.op == S_IMAGE_STORE {\n");
        buf_str(out, c"        b.push_fmt(f\"image_store e{st.a} at e{st.b} <- e{st.c}\\n\");\n");
        buf_str(out, c"    } else if st.op == S_WG_UNIFORM_LOAD {\n");
        buf_str(out, c"        b.push_fmt(f\"e{st.b} = workgroup_uniform_load e{st.a}\\n\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn expr_text<A: Allocator>(m: Module, f: Function, e: i64, b: inout Buf<A>) {\n");
        buf_str(out, c"    let x = f.exprs[e];\n");
        buf_str(out, c"    let op = x.op;\n");
        buf_str(out, c"    if op == E_LITERAL {\n");
        buf_str(out, c"        let sk = m.types[x.ty].scalar;\n");
        buf_str(out, c"        if sk == SK_BOOL {\n");
        buf_str(out, c"            b.push_str(if x.a != 0 { \"true\" } else { \"false\" });\n");
        buf_str(out, c"        } else if sk == SK_F32 {\n");
        buf_str(out, c"            b.push_fmt(f\"{bits_f32(x.a as u32)}\");\n");
        buf_str(out, c"        } else if sk == SK_I32 {\n");
        buf_str(out, c"            b.push_fmt(f\"{x.a as u32 as i32}i\");\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            b.push_fmt(f\"{x.a}u\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else if op == E_ZERO {\n");
        buf_str(out, c"        b.push_str(\"zero\");\n");
        buf_str(out, c"    } else if op == E_COMPOSE {\n");
        buf_str(out, c"        b.push_str(\"compose(\");\n");
        buf_str(out, c"        args_text(f, x.a, x.b, &b);\n");
        buf_str(out, c"        b.push(')');\n");
        buf_str(out, c"    } else if op == E_SPLAT {\n");
        buf_str(out, c"        b.push_fmt(f\"splat(e{x.a})\");\n");
        buf_str(out, c"    } else if op == E_SWIZZLE {\n");
        buf_str(out, c"        b.push_fmt(f\"e{x.a}.\");\n");
        buf_str(out, c"        for i in 0..x.c {\n");
        buf_str(out, c"            b.push(\"xyzw\"[(x.b >> (2 * i)) & 3]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else if op == E_ACCESS {\n");
        buf_str(out, c"        b.push_fmt(f\"e{x.a}[e{x.b}] check {CK[x.c]}\");\n");
        buf_str(out, c"        if x.c == ir::CK_CLAMP {\n");
        buf_str(out, c"            b.push_fmt(f\" {x.d}\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else if op == E_ACCESS_INDEX {\n");
        buf_str(out, c"        b.push_fmt(f\"e{x.a}.{x.b}\");\n");
        buf_str(out, c"    } else if op == E_ARG {\n");
        buf_str(out, c"        b.push_fmt(f\"arg {x.a}\");\n");
        buf_str(out, c"    } else if op == E_GLOBAL {\n");
        buf_str(out, c"        b.push_fmt(f\"global {x.a}\");\n");
        buf_str(out, c"    } else if op == E_LOCAL {\n");
        buf_str(out, c"        b.push_fmt(f\"local {x.a}\");\n");
        buf_str(out, c"    } else if op == E_LOAD {\n");
        buf_str(out, c"        b.push_fmt(f\"load e{x.a}\");\n");
        buf_str(out, c"    } else if op == E_UNARY {\n");
        buf_str(out, c"        b.push_fmt(f\"{UN[x.a]} e{x.b}\");\n");
        buf_str(out, c"    } else if op == E_BINARY {\n");
        buf_str(out, c"        b.push_fmt(f\"{BIN[x.a]} e{x.b} e{x.c}\");\n");
        buf_str(out, c"    } else if op == E_SELECT {\n");
        buf_str(out, c"        b.push_fmt(f\"select e{x.a} ? e{x.b} : e{x.c}\");\n");
        buf_str(out, c"    } else if op == E_MATH {\n");
        buf_str(out, c"        b.push_str(names::PREDECLARED[names::K_MATH_FIRST + x.a]);\n");
        buf_str(out, c"        b.push('(');\n");
        buf_str(out, c"        args_text(f, x.b, x.c, &b);\n");
        buf_str(out, c"        b.push(')');\n");
        buf_str(out, c"    } else if op == E_CONVERT {\n");
        buf_str(out, c"        b.push_fmt(f\"convert e{x.a}\");\n");
        buf_str(out, c"    } else if op == E_BITCAST {\n");
        buf_str(out, c"        b.push_fmt(f\"bitcast e{x.a}\");\n");
        buf_str(out, c"    } else if op == E_CALL_RESULT {\n");
        buf_str(out, c"        b.push_str(\"call result\");\n");
        buf_str(out, c"    } else if op == E_ATOMIC_RESULT {\n");
        buf_str(out, c"        b.push_str(\"atomic result\");\n");
        buf_str(out, c"    } else if op == E_WG_UNIFORM_RESULT {\n");
        buf_str(out, c"        b.push_str(\"workgroup uniform load result\");\n");
        buf_str(out, c"    } else if op == E_ARRAY_LENGTH {\n");
        buf_str(out, c"        b.push_fmt(f\"array_length global {x.a} member {x.b} offset {x.c} stride {x.d}\");\n");
        buf_str(out, c"    } else if op == E_DERIVATIVE {\n");
        buf_str(out, c"        b.push_fmt(f\"derivative {x.a} e{x.b}\");\n");
        buf_str(out, c"    } else if op == E_IMAGE_SAMPLE {\n");
        buf_str(out, c"        b.push_fmt(f\"sample {x.d & 255} e{x.a} e{x.b} (\");\n");
        buf_str(out, c"        args_text(f, x.c, x.d >> 8, &b);\n");
        buf_str(out, c"        b.push(')');\n");
        buf_str(out, c"    } else if op == E_IMAGE_LOAD {\n");
        buf_str(out, c"        b.push_fmt(f\"image_load e{x.a} (\");\n");
        buf_str(out, c"        args_text(f, x.c, x.d, &b);\n");
        buf_str(out, c"        b.push(')');\n");
        buf_str(out, c"    } else if op == E_IMAGE_QUERY {\n");
        buf_str(out, c"        b.push_fmt(f\"image_query {x.b} e{x.a}\");\n");
        buf_str(out, c"        if x.c >= 0 {\n");
        buf_str(out, c"            b.push_fmt(f\" level e{x.c}\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn args_text<A: Allocator>(f: Function, start: i64, n: i64, b: inout Buf<A>) {\n");
        buf_str(out, c"    for i in start..start + n {\n");
        buf_str(out, c"        if i > start {\n");
        buf_str(out, c"            b.push_str(\", \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b.push_fmt(f\"e{f.args[i]}\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl::dump ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::gpu::wgsl::job ----\n");
        buf_str(out, c"pub mod job {\n");
        buf_str(out, c"// ---- Shader compiler implementation, job (0.22) ----\n");
        buf_str(out, c"// Jobs: a compute dispatch with its buffers, run by the interpreter\n");
        buf_str(out, c"// (`wgslc run`) or turned into the input of tests/wgsl/metalrun\n");
        buf_str(out, c"// (`wgslc metal-job`), whose output has the same form, so the two compare\n");
        buf_str(out, c"// as text. A job file:\n");
        buf_str(out, c"//\n");
        buf_str(out, c"//   entry NAME                  the entry point (default: the first compute one)\n");
        buf_str(out, c"//   dispatch X Y Z              workgroups\n");
        buf_str(out, c"//   buffer G B BYTES [random SEED | WORD...]   a binding's size and contents\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Words are decimal or 0x hex; missing words are zero. The output is each\n");
        buf_str(out, c"// buffer, in the job's order: `buffer G B`, then its words in hex.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use api::{fill_error, new_error};\n");
        buf_str(out, c"use front::new_front;\n");
        buf_str(out, c"use interp::new_interp;\n");
        buf_str(out, c"use ir::{Module, STAGE_COMPUTE, V};\n");
        buf_str(out, c"use std::{Allocator, Buf, Option, Scanner, ScopedArena, Vec, parse_int, split_whitespace_in};\n");
        buf_str(out, c"use std::Option::{None, Some};\n");
        buf_str(out, c"use std::Result::{Err, Ok};\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct JobBuffer { group: i64, binding: i64, bytes: i64, words: V<u32> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A texture: its format (`rgba8unorm`, `r8unorm`, `rgba32float`,\n");
        buf_str(out, c"// `rgba32uint`) and texels as words (rgba8unorm: one a texel; r8unorm:\n");
        buf_str(out, c"// four texels a word; the 32-bit formats: four words a texel).\n");
        buf_str(out, c"pub struct JobTexture { group: i64, binding: i64, format: [u8], w: i64, h: i64, words: V<u32> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// call_n >= 0: a call job (`call ENTRY N`): the entry runs once per input\n");
        buf_str(out, c"// record (`input BYTES ...`), its results printed as `buffer -2 0`.\n");
        buf_str(out, c"pub struct Job {\n");
        buf_str(out, c"    entry: [u8], groups: [i64; 3], buffers: V<JobBuffer>, call_n: i64, input: V<u32>,\n");
        buf_str(out, c"    textures: V<JobTexture>\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn xorshift(s: inout u32) -> u32 {\n");
        buf_str(out, c"    var x = s;\n");
        buf_str(out, c"    x = x ^ (x << 13);\n");
        buf_str(out, c"    x = x ^ (x >> 17);\n");
        buf_str(out, c"    x = x ^ (x << 5);\n");
        buf_str(out, c"    s = x;\n");
        buf_str(out, c"    x\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A job word: decimal, 0x hex, or a float with a point (its f32 bits).\n");
        buf_str(out, c"fn parse_word(t: [u8]) -> Option<u32> {\n");
        buf_str(out, c"    for i in 0..t.len {\n");
        buf_str(out, c"        if t[i] == '.' {\n");
        buf_str(out, c"            return match std::num::parse_f64(t) {\n");
        buf_str(out, c"                Ok(v) => Some(ir::f32_bits(v as f32)),\n");
        buf_str(out, c"                Err(_) => None,\n");
        buf_str(out, c"            };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if t.len > 2 && t[0] == '0' && (t[1] == 'x' || t[1] == 'X') {\n");
        buf_str(out, c"        var v: u64 = 0;\n");
        buf_str(out, c"        for i in 2..t.len {\n");
        buf_str(out, c"            let c = t[i];\n");
        buf_str(out, c"            let d = if c >= '0' && c <= '9' { c - '0' }\n");
        buf_str(out, c"                else if c >= 'a' && c <= 'f' { c - 'a' + 10 }\n");
        buf_str(out, c"                else if c >= 'A' && c <= 'F' { c - 'A' + 10 } else { return None; };\n");
        buf_str(out, c"            v = v * 16 + d as u64;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return Some(v as u32);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    match parse_int(t) {\n");
        buf_str(out, c"        Ok(v) => Some(v as u32),\n");
        buf_str(out, c"        Err(_) => None,\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// words[from ..]: `random SEED` or the words themselves.\n");
        buf_str(out, c"fn fill_words<B: Allocator>(v: inout V<u32>, words: Vec<[u8], ScopedArena>, from: i64,\n");
        buf_str(out, c"    err: inout Buf<B>) -> bool {\n");
        buf_str(out, c"    if words.len() >= from + 2 && words[from] == \"random\" {\n");
        buf_str(out, c"        var s = parse_word(words[from + 1]).unwrap_or(1);\n");
        buf_str(out, c"        if s == 0 {\n");
        buf_str(out, c"            s = 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for k in 0..v.len() {\n");
        buf_str(out, c"            v[k] = xorshift(&s);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return true;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for k in from..words.len() {\n");
        buf_str(out, c"        if k - from >= v.len() {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        match parse_word(words[k]) {\n");
        buf_str(out, c"            Some(x) => v[k - from] = x,\n");
        buf_str(out, c"            None => {\n");
        buf_str(out, c"                err.push_fmt(f\"not a word: '{words[k]}'\");\n");
        buf_str(out, c"                return false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    true\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A job texture's texels as the interpreter holds them: four words each,\n");
        buf_str(out, c"// f32 bits for the unorm and float formats (unorm: n / 255).\n");
        buf_str(out, c"pub fn texels(t: JobTexture, a: ScopedArena) -> V<u32> {\n");
        buf_str(out, c"    let n = t.w * t.h;\n");
        buf_str(out, c"    var v: V<u32> = Vec::filled_in(4 * n, 0u32, a);\n");
        buf_str(out, c"    for i in 0..n {\n");
        buf_str(out, c"        if t.format == \"rgba8unorm\" {\n");
        buf_str(out, c"            let x = t.words[i];\n");
        buf_str(out, c"            for c in 0..4 {\n");
        buf_str(out, c"                let b = (x >> (8 * c) as u32) & 255;\n");
        buf_str(out, c"                v[4 * i + c] = ir::f32_bits(b as f32 / 255.0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if t.format == \"r8unorm\" {\n");
        buf_str(out, c"            let b = (t.words[i / 4] >> (8 * (i % 4)) as u32) & 255;\n");
        buf_str(out, c"            v[4 * i] = ir::f32_bits(b as f32 / 255.0);\n");
        buf_str(out, c"            v[4 * i + 3] = ir::f32_bits(1.0);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            for c in 0..4 {\n");
        buf_str(out, c"                v[4 * i + c] = t.words[4 * i + c];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn parse_job<B: Allocator>(text: [u8], a: ScopedArena, err: inout Buf<B>) -> Option<Job> {\n");
        buf_str(out, c"    var job = Job {\n");
        buf_str(out, c"        entry: \"\", groups: [1, 1, 1], buffers: Vec::new_in(a), call_n: -1, input: Vec::new_in(a),\n");
        buf_str(out, c"        textures: Vec::new_in(a)\n");
        buf_str(out, c"    };\n");
        buf_str(out, c"    var sc = Scanner::new(text);\n");
        buf_str(out, c"    while let Some(line) = sc.next_line() {\n");
        buf_str(out, c"        let words = split_whitespace_in(line, a);\n");
        buf_str(out, c"        if words.len() == 0 || words[0][0] == '#' {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let kw = words[0];\n");
        buf_str(out, c"        if kw == \"entry\" && words.len() == 2 {\n");
        buf_str(out, c"            job.entry = words[1];\n");
        buf_str(out, c"        } else if kw == \"dispatch\" && words.len() == 4 {\n");
        buf_str(out, c"            for k in 0..3 {\n");
        buf_str(out, c"                job.groups[k] = parse_int(words[k + 1]).unwrap_or(1);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if kw == \"call\" && words.len() == 3 {\n");
        buf_str(out, c"            job.entry = words[1];\n");
        buf_str(out, c"            job.call_n = parse_int(words[2]).unwrap_or(0);\n");
        buf_str(out, c"        } else if kw == \"input\" && words.len() >= 2 {\n");
        buf_str(out, c"            let bytes = parse_int(words[1]).unwrap_or(0);\n");
        buf_str(out, c"            job.input = Vec::filled_in(bytes / 4, 0u32, a);\n");
        buf_str(out, c"            if !fill_words(&job.input, words, 2, &err) {\n");
        buf_str(out, c"                return None;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if kw == \"texture\" && words.len() >= 6 {\n");
        buf_str(out, c"            let w = parse_int(words[4]).unwrap_or(0);\n");
        buf_str(out, c"            let h = parse_int(words[5]).unwrap_or(0);\n");
        buf_str(out, c"            let fm = words[3];\n");
        buf_str(out, c"            let n = if fm == \"rgba8unorm\" { w * h } else if fm == \"r8unorm\" { (w * h + 3) / 4 }\n");
        buf_str(out, c"                else if fm == \"rgba32float\" || fm == \"rgba32uint\" { 4 * w * h } else { -1 };\n");
        buf_str(out, c"            if n < 0 || w <= 0 || h <= 0 {\n");
        buf_str(out, c"                err.push_fmt(f\"a texture is FORMAT W H with a format of rgba8unorm, r8unorm, rgba32float, rgba32uint: {line}\");\n");
        buf_str(out, c"                return None;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            var t = JobTexture {\n");
        buf_str(out, c"                group: parse_int(words[1]).unwrap_or(0), binding: parse_int(words[2]).unwrap_or(0),\n");
        buf_str(out, c"                format: fm, w: w, h: h, words: Vec::filled_in(n, 0u32, a)\n");
        buf_str(out, c"            };\n");
        buf_str(out, c"            if !fill_words(&t.words, words, 6, &err) {\n");
        buf_str(out, c"                return None;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            job.textures.push(t);\n");
        buf_str(out, c"        } else if kw == \"buffer\" && words.len() >= 4 {\n");
        buf_str(out, c"            let bytes = parse_int(words[3]).unwrap_or(0);\n");
        buf_str(out, c"            if bytes <= 0 || bytes % 4 != 0 {\n");
        buf_str(out, c"                err.push_fmt(f\"a buffer's size is a positive multiple of 4: {line}\");\n");
        buf_str(out, c"                return None;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            var b = JobBuffer {\n");
        buf_str(out, c"                group: parse_int(words[1]).unwrap_or(0), binding: parse_int(words[2]).unwrap_or(0),\n");
        buf_str(out, c"                bytes: bytes, words: Vec::filled_in(bytes / 4, 0u32, a)\n");
        buf_str(out, c"            };\n");
        buf_str(out, c"            if words.len() >= 6 && words[4] == \"random\" {\n");
        buf_str(out, c"                var s = parse_word(words[5]).unwrap_or(1);\n");
        buf_str(out, c"                if s == 0 {\n");
        buf_str(out, c"                    s = 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                for k in 0..bytes / 4 {\n");
        buf_str(out, c"                    b.words[k] = xorshift(&s);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                for k in 4..words.len() {\n");
        buf_str(out, c"                    if k - 4 >= bytes / 4 {\n");
        buf_str(out, c"                        break;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    match parse_word(words[k]) {\n");
        buf_str(out, c"                        Some(w) => b.words[k - 4] = w,\n");
        buf_str(out, c"                        None => {\n");
        buf_str(out, c"                            err.push_fmt(f\"not a word: '{words[k]}'\");\n");
        buf_str(out, c"                            return None;\n");
        buf_str(out, c"                        }\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            job.buffers.push(b);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            err.push_fmt(f\"cannot read this job line: {line}\");\n");
        buf_str(out, c"            return None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    Some(job)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The entry point a job names (or the first compute one), or -1.\n");
        buf_str(out, c"pub fn find_entry(m: Module, name: [u8]) -> i64 {\n");
        buf_str(out, c"    for e in 0..m.entries.len() {\n");
        buf_str(out, c"        if m.entries[e].stage == STAGE_COMPUTE && (name.len == 0 || m.entries[e].name == name) {\n");
        buf_str(out, c"            return e;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    -1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The entry point of any stage named `name`, or -1.\n");
        buf_str(out, c"pub fn find_any_entry(m: Module, name: [u8]) -> i64 {\n");
        buf_str(out, c"    for e in 0..m.entries.len() {\n");
        buf_str(out, c"        if m.entries[e].name == name {\n");
        buf_str(out, c"            return e;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    -1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The global bound at (group, binding), or -1.\n");
        buf_str(out, c"pub fn find_global(m: Module, g: i64, b: i64) -> i64 {\n");
        buf_str(out, c"    for i in 0..m.globals.len() {\n");
        buf_str(out, c"        if m.globals[i].group == g && m.globals[i].binding == b {\n");
        buf_str(out, c"            return i;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    -1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn print_words<A: Allocator>(group: i64, w: V<u32>, out: inout Buf<A>) {\n");
        buf_str(out, c"    out.push_fmt(f\"buffer {group} 0\\n\");\n");
        buf_str(out, c"    for k in 0..w.len() {\n");
        buf_str(out, c"        out.push_fmt(f\"{w[k]:08x}\");\n");
        buf_str(out, c"        out.push(if k % 8 == 7 || k == w.len() - 1 { '\\n' } else { ' ' });\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Each job buffer's words: words[idx[i]] for the job's i-th buffer.\n");
        buf_str(out, c"pub fn print_buffers<A: Allocator>(job: Job, words: V<V<u32>>, idx: V<i64>, out: inout Buf<A>) {\n");
        buf_str(out, c"    for i in 0..job.buffers.len() {\n");
        buf_str(out, c"        let b = job.buffers[i];\n");
        buf_str(out, c"        out.push_fmt(f\"buffer {b.group} {b.binding}\\n\");\n");
        buf_str(out, c"        let w = words[idx[i]];\n");
        buf_str(out, c"        for k in 0..w.len() {\n");
        buf_str(out, c"            out.push_fmt(f\"{w[k]:08x}\");\n");
        buf_str(out, c"            out.push(if k % 8 == 7 || k == w.len() - 1 { '\\n' } else { ' ' });\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl::job ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::gpu::wgsl::api ----\n");
        buf_str(out, c"pub mod api {\n");
        buf_str(out, c"// ---- Shader compiler implementation, translate (0.22) ----\n");
        buf_str(out, c"// The translator's entry: WGSL source to an output (the IR as text, MSL,\n");
        buf_str(out, c"// SPIR-V), on an arena of its own (docs/design/gpu.md §2.10: everything a\n");
        buf_str(out, c"// translation allocates is freed when it ends; no io, no globals).\n");
        buf_str(out, c"\n");
        buf_str(out, c"use front::new_front;\n");
        buf_str(out, c"use std::{Buf, Gpa, ScopedArena, Vec, arena_scope};\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const TARGET_CHECK: i64 = 0;\n");
        buf_str(out, c"pub const TARGET_IR: i64 = 1;\n");
        buf_str(out, c"pub const TARGET_MSL: i64 = 2;\n");
        buf_str(out, c"pub const TARGET_SPIRV: i64 = 3;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Options {\n");
        buf_str(out, c"    target: i64,\n");
        buf_str(out, c"    // bench only: no bounds checks (the cost of the checks is measured\n");
        buf_str(out, c"    // against this; never shipped)\n");
        buf_str(out, c"    no_checks: bool,\n");
        buf_str(out, c"    // drop checks proven unneeded by a dominating loop condition\n");
        buf_str(out, c"    prove: bool,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn options(target: i64) -> Options { Options { target: target, no_checks: false, prove: true } }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Shader compiler implementation, translate: Reflection (0.22) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What a binding holds (WebGPU's binding types).\n");
        buf_str(out, c"pub const BK_UNIFORM: u8 = 0;\n");
        buf_str(out, c"pub const BK_STORAGE: u8 = 1;\n");
        buf_str(out, c"pub const BK_READ_ONLY_STORAGE: u8 = 2;\n");
        buf_str(out, c"pub const BK_TEXTURE: u8 = 3;\n");
        buf_str(out, c"pub const BK_STORAGE_TEXTURE: u8 = 4;\n");
        buf_str(out, c"pub const BK_SAMPLER: u8 = 5;\n");
        buf_str(out, c"pub const BK_COMPARISON_SAMPLER: u8 = 6;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// One `@group(g) @binding(b)`: its kind, the smallest buffer it accepts\n");
        buf_str(out, c"// (a runtime-sized array counts one element), and, for the target, its\n");
        buf_str(out, c"// slot in each stage (vertex, fragment, compute; -1: not used there).\n");
        buf_str(out, c"pub struct BindingInfo {\n");
        buf_str(out, c"    group: i64, binding: i64, kind: u8, min_size: i64, slots: [i64; 3], global: i64\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An entry point: its WGSL name, its name in the output, its stage\n");
        buf_str(out, c"// (ir::STAGE_*), a compute entry's workgroup size, and the slot of the\n");
        buf_str(out, c"// sizes buffer it needs (-1: none; Metal only).\n");
        buf_str(out, c"pub struct EntryInfo {\n");
        buf_str(out, c"    name: Buf, target_name: Buf, stage: u8, workgroup: [i64; 3], sizes_slot: i64\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A vertex entry's input at @location(n): its scalar (ir::SK_*) and\n");
        buf_str(out, c"// component count, as WebGPU's vertex formats (`float32x3`: f32, 3).\n");
        buf_str(out, c"pub struct InputInfo { location: i64, scalar: u8, components: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A translated module's interface, in (group, binding) order; `sizes`\n");
        buf_str(out, c"// lists the runtime-sized storage bindings (indices into `bindings`) in\n");
        buf_str(out, c"// the order of the sizes buffer.\n");
        buf_str(out, c"pub struct Reflection {\n");
        buf_str(out, c"    entries: Vec<EntryInfo>, bindings: Vec<BindingInfo>, inputs: Vec<InputInfo>, sizes: Vec<i64>\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn new_reflection(gpa: Gpa) -> Reflection {\n");
        buf_str(out, c"    Reflection {\n");
        buf_str(out, c"        entries: Vec::new_in(gpa), bindings: Vec::new_in(gpa), inputs: Vec::new_in(gpa),\n");
        buf_str(out, c"        sizes: Vec::new_in(gpa)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The target-neutral part of the reflection, from the IR.\n");
        buf_str(out, c"pub fn reflect(m: ir::Module, a: ScopedArena, refl: inout Reflection, gpa: Gpa) {\n");
        buf_str(out, c"    refl.entries.clear();\n");
        buf_str(out, c"    refl.bindings.clear();\n");
        buf_str(out, c"    refl.inputs.clear();\n");
        buf_str(out, c"    refl.sizes.clear();\n");
        buf_str(out, c"    for e in 0..m.entries.len() {\n");
        buf_str(out, c"        let en = m.entries[e];\n");
        buf_str(out, c"        var name = Buf::new_in(gpa);\n");
        buf_str(out, c"        name.push_str(en.name);\n");
        buf_str(out, c"        refl.entries.push(EntryInfo {\n");
        buf_str(out, c"            name: name, target_name: Buf::new_in(gpa), stage: en.stage, workgroup: en.wg,\n");
        buf_str(out, c"            sizes_slot: -1\n");
        buf_str(out, c"        });\n");
        buf_str(out, c"        if en.stage == ir::STAGE_VERTEX {\n");
        buf_str(out, c"            let f = m.functions[en.func];\n");
        buf_str(out, c"            for k in 0..f.params.len() {\n");
        buf_str(out, c"                let pt = m.types[f.params[k].ty];\n");
        buf_str(out, c"                if pt.kind == ir::TK_STRUCT && f.params[k].binding.kind == ir::BIND_NONE {\n");
        buf_str(out, c"                    for j in pt.mstart..pt.mstart + pt.mcount {\n");
        buf_str(out, c"                        let mem = m.members[j];\n");
        buf_str(out, c"                        if mem.binding.kind == ir::BIND_LOCATION {\n");
        buf_str(out, c"                            refl.inputs.push(InputInfo {\n");
        buf_str(out, c"                                location: mem.binding.value, scalar: m.types[mem.ty].scalar,\n");
        buf_str(out, c"                                components: m.width_of(mem.ty)\n");
        buf_str(out, c"                            });\n");
        buf_str(out, c"                        }\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                } else if f.params[k].binding.kind == ir::BIND_LOCATION {\n");
        buf_str(out, c"                    refl.inputs.push(InputInfo {\n");
        buf_str(out, c"                        location: f.params[k].binding.value, scalar: pt.scalar,\n");
        buf_str(out, c"                        components: m.width_of(f.params[k].ty)\n");
        buf_str(out, c"                    });\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let order = msl::binding_order(m, a);\n");
        buf_str(out, c"    for k in 0..order.len() {\n");
        buf_str(out, c"        let g = order[k];\n");
        buf_str(out, c"        let gl = m.globals[g];\n");
        buf_str(out, c"        if gl.group < 0 {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let t = m.types[gl.ty];\n");
        buf_str(out, c"        let kind = if gl.space == ir::SP_UNIFORM {\n");
        buf_str(out, c"            BK_UNIFORM\n");
        buf_str(out, c"        } else if gl.space == ir::SP_STORAGE {\n");
        buf_str(out, c"            if gl.access == ir::ACC_RW { BK_STORAGE } else { BK_READ_ONLY_STORAGE }\n");
        buf_str(out, c"        } else if t.kind == ir::TK_TEXTURE {\n");
        buf_str(out, c"            if t.n == ir::TEX_STORAGE_2D { BK_STORAGE_TEXTURE } else { BK_TEXTURE }\n");
        buf_str(out, c"        } else if t.n == 1 {\n");
        buf_str(out, c"            BK_COMPARISON_SAMPLER\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            BK_SAMPLER\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        let min = if gl.space == ir::SP_UNIFORM || gl.space == ir::SP_STORAGE { t.size } else { 0 };\n");
        buf_str(out, c"        if gl.space == ir::SP_STORAGE && m.is_runtime_sized(gl.ty) {\n");
        buf_str(out, c"            refl.sizes.push(refl.bindings.len());\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        refl.bindings.push(BindingInfo {\n");
        buf_str(out, c"            group: gl.group, binding: gl.binding, kind: kind, min_size: min, slots: [-1, -1, -1],\n");
        buf_str(out, c"            global: g\n");
        buf_str(out, c"        });\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The sizes buffer (Metal; the bounds checks of runtime-sized arrays): an\n");
        buf_str(out, c"// entry point whose `sizes_slot` is >= 0 reads one u32 per binding of\n");
        buf_str(out, c"// `refl.sizes`, in that order, the bytes the buffer bound there exposes\n");
        buf_str(out, c"// (its size minus the binding's offset, or the binding's size when one is\n");
        buf_str(out, c"// given), and the backend gives them with setBytes(words, 4 * len,\n");
        buf_str(out, c"// sizes_slot) before each dispatch or draw, in that entry's stage. `bound`\n");
        buf_str(out, c"// says it for a (group, binding), 0 when nothing is bound. A runtime-sized\n");
        buf_str(out, c"// array then has (bytes - its offset in the binding) / stride elements;\n");
        buf_str(out, c"// past them a load reads zero and a store is skipped.\n");
        buf_str(out, c"pub fn sizes_words<F: FnMut(i64, i64) -> i64>(refl: Reflection, bound: F, out: inout Vec<u32>) {\n");
        buf_str(out, c"    var f = bound;\n");
        buf_str(out, c"    out.clear();\n");
        buf_str(out, c"    for i in 0..refl.sizes.len() {\n");
        buf_str(out, c"        let b = refl.bindings[refl.sizes[i]];\n");
        buf_str(out, c"        let n = f(b.group, b.binding);\n");
        buf_str(out, c"        out.push(if n < 0 { 0 } else if n > 4294967295 { 4294967295u32 } else { n as u32 });\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A shader the translator rejects: its first error.\n");
        buf_str(out, c"pub struct ShaderError { code: [u8], pos: i64, line: i64, col: i64, msg: Buf, help: Buf }\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn new_error(gpa: Gpa) -> ShaderError {\n");
        buf_str(out, c"    ShaderError { code: \"\", pos: 0, line: 0, col: 0, msg: Buf::new_in(gpa), help: Buf::new_in(gpa) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl ShaderError {\n");
        buf_str(out, c"    pub fn free(inout self) {\n");
        buf_str(out, c"        self.msg.free();\n");
        buf_str(out, c"        self.help.free();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The 1-based line and column of byte `pos`.\n");
        buf_str(out, c"pub fn line_col(src: [u8], pos: i64) -> (i64, i64) {\n");
        buf_str(out, c"    var line = 1;\n");
        buf_str(out, c"    var col = 1;\n");
        buf_str(out, c"    let end = if pos < src.len { pos } else { src.len };\n");
        buf_str(out, c"    for i in 0..end {\n");
        buf_str(out, c"        if src[i] == '\\n' {\n");
        buf_str(out, c"            line += 1;\n");
        buf_str(out, c"            col = 1;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            col += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    (line, col)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn fill_error(fr: front::Front, err: inout ShaderError) {\n");
        buf_str(out, c"    err.code = fr.err_code;\n");
        buf_str(out, c"    err.pos = fr.err_pos;\n");
        buf_str(out, c"    let (l, c) = line_col(fr.src, fr.err_pos);\n");
        buf_str(out, c"    err.line = l;\n");
        buf_str(out, c"    err.col = c;\n");
        buf_str(out, c"    err.msg.clear();\n");
        buf_str(out, c"    err.msg.push_str(fr.emsg.as_slice());\n");
        buf_str(out, c"    err.help.clear();\n");
        buf_str(out, c"    err.help.push_str(fr.ehelp.as_slice());\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Translates src; the output is appended to `out` (SPIR-V: its words,\n");
        buf_str(out, c"// little-endian). False, with err filled, when the shader is rejected.\n");
        buf_str(out, c"pub fn translate(src: [u8], opts: Options, out: inout Buf, refl: inout Reflection,\n");
        buf_str(out, c"    err: inout ShaderError, gpa: Gpa) -> bool {\n");
        buf_str(out, c"    // (0.20: the closure reaches out, refl and err through their addresses:\n");
        buf_str(out, c"    // a closure given to arena_scope's let F cannot capture an inout\n");
        buf_str(out, c"    // parameter yet; they outlive it)\n");
        buf_str(out, c"    let po = &out as *Buf;\n");
        buf_str(out, c"    let pr = &refl as *Reflection;\n");
        buf_str(out, c"    let pe = &err as *ShaderError;\n");
        buf_str(out, c"    arena_scope(gpa, |a| -> bool {\n");
        buf_str(out, c"        var fr = new_front(src, a);\n");
        buf_str(out, c"        fr.module();\n");
        buf_str(out, c"        if !fr.failed {\n");
        buf_str(out, c"            uniformity::check(fr);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if fr.failed {\n");
        buf_str(out, c"            unsafe { fill_error(fr, &*pe); }\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if !opts.no_checks {\n");
        buf_str(out, c"            bounds::insert_checks(&fr.m, a, opts.prove);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            bounds::insert_no_checks(&fr.m);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe { reflect(fr.m, a, &*pr, gpa); }\n");
        buf_str(out, c"        if opts.target == TARGET_IR {\n");
        buf_str(out, c"            unsafe { dump::dump(fr.m, &*po); }\n");
        buf_str(out, c"        } else if opts.target == TARGET_MSL {\n");
        buf_str(out, c"            unsafe { msl::write(fr.m, a, &*po, &*pr); }\n");
        buf_str(out, c"        } else if opts.target == TARGET_SPIRV {\n");
        buf_str(out, c"            unsafe { spirv::write(fr.m, a, &*po); }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    })\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl::api ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::gpu ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::string ----\n");
        buf_str(out, c"pub mod string {\n");
        buf_str(out, c"// std::string (0.20, docs/design/collections-text-io.md §2.5, task B5):\n");
        buf_str(out, c"// `str`, the view of UTF-8 text, and `String`, UTF-8 text that owns its\n");
        buf_str(out, c"// bytes, with Rust's names. A `str` is std::str's `[u8]` known to be\n");
        buf_str(out, c"// UTF-8: the compiler takes string literals as one where a `str` goes,\n");
        buf_str(out, c"// `&str` as `str`, and lets a `str` go where `[u8]` does; bytes become a\n");
        buf_str(out, c"// `str` only checked (`str::from_utf8`), outside std. What allocates takes\n");
        buf_str(out, c"// an allocator, the `_in` forms; the Rust forms (`to_uppercase()`,\n");
        buf_str(out, c"// `String::new()`) are errors naming them. A code point is a `u32` until\n");
        buf_str(out, c"// `char` exists.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Searching takes a Pattern: a `str` or `[u8]` (a substring), a `u8` (an\n");
        buf_str(out, c"// ASCII byte: `','`) or a `u32` (a code point). Empty patterns match at\n");
        buf_str(out, c"// every char boundary, as Rust's do.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{\n");
        buf_str(out, c"    Allocator, Ambient, Buf, Clone, Debug, Display, Eq, Fmt, Gpa, Hash, Iterator, Option, Ord,\n");
        buf_str(out, c"    ParseIntError, Result, Vec,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"use std::num::{ParseFloatError, parse_f32, parse_f64, parse_i64_radix, parse_u64_radix};\n");
        buf_str(out, c"use std::str::{\n");
        buf_str(out, c"    Utf8Error, encode_utf8, is_char_boundary, lossy_next, memchr, memrchr, next_code_point,\n");
        buf_str(out, c"    next_code_point_reverse, utf8_char_width, validate_utf8,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"use std::unicode::{Graphemes, graphemes, is_whitespace, str_width, to_lower, to_upper};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Text: str (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// UTF-8 text, a view: `[u8]` whose bytes are UTF-8 (0.20). String literals\n");
        buf_str(out, c"// are `str` where one goes; `&str` is `str`; a `str` goes where `[u8]` does,\n");
        buf_str(out, c"// for free; bytes become one through `str::from_utf8(b)?`.\n");
        buf_str(out, c"pub type str = distinct [u8];\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether code point cp is White_Space (ASCII first).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn is_space_cp(cp: u32) -> bool {\n");
        buf_str(out, c"    if cp < 0x80 {\n");
        buf_str(out, c"        return cp == 0x20 || (cp >= 0x09 && cp <= 0x0d);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    is_whitespace(cp)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The code point that starts at byte i of s (UTF-8), and its length.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn cp_at(s: [u8], i: i64) -> (u32, i64) {\n");
        buf_str(out, c"    let b = s[i];\n");
        buf_str(out, c"    if b < 0x80 {\n");
        buf_str(out, c"        return (b as u32, 1);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var p = i;\n");
        buf_str(out, c"    let cp = lossy_next(s, &p);\n");
        buf_str(out, c"    (cp, p - i)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The code point that ends at byte `end` of s, and its length.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn cp_before(s: [u8], end: i64) -> (u32, i64) {\n");
        buf_str(out, c"    let b = s[end - 1];\n");
        buf_str(out, c"    if b < 0x80 {\n");
        buf_str(out, c"        return (b as u32, 1);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var start = end - 1;\n");
        buf_str(out, c"    while start > 0 && end - start < 4 && (s[start] & 0xc0) == 0x80 {\n");
        buf_str(out, c"        start -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var p = start;\n");
        buf_str(out, c"    let cp = lossy_next(s, &p);\n");
        buf_str(out, c"    if p != end {\n");
        buf_str(out, c"        return (0xfffd, 1);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    (cp, end - start)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The index of the first byte b in s at or after `from`, or -1: a plain\n");
        buf_str(out, c"// loop over a short span (a field, a line), std::str's memchr (NEON) over\n");
        buf_str(out, c"// a long one.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn find_byte(b: u8, s: [u8], from: i64) -> i64 {\n");
        buf_str(out, c"    var i = from;\n");
        buf_str(out, c"    let short = if s.len - from < 32 { s.len } else { from + 32 };\n");
        buf_str(out, c"    while i < short {\n");
        buf_str(out, c"        if s[i] == b {\n");
        buf_str(out, c"            return i;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if i >= s.len {\n");
        buf_str(out, c"        return -1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    match memchr(b, s[i..]) {\n");
        buf_str(out, c"        Option::Some(k) => i + k,\n");
        buf_str(out, c"        Option::None => -1,\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Where `needle` first occurs in s at or after `from`, or -1.\n");
        buf_str(out, c"fn find_bytes(s: [u8], needle: [u8], from: i64) -> i64 {\n");
        buf_str(out, c"    let n = needle.len;\n");
        buf_str(out, c"    if n == 0 {\n");
        buf_str(out, c"        return if from <= s.len { from } else { -1 };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let first = needle[0];\n");
        buf_str(out, c"    if s.len < n {\n");
        buf_str(out, c"        return -1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let hay = s[..s.len - n + 1];\n");
        buf_str(out, c"    var i = from;\n");
        buf_str(out, c"    while i < hay.len {\n");
        buf_str(out, c"        let at = find_byte(first, hay, i);\n");
        buf_str(out, c"        if at < 0 {\n");
        buf_str(out, c"            return -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var same = true;\n");
        buf_str(out, c"        for j in 1..n {\n");
        buf_str(out, c"            if s[at + j] != needle[j] {\n");
        buf_str(out, c"                same = false;\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if same {\n");
        buf_str(out, c"            return at;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i = at + 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    -1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Where `needle` last occurs in s[..to], or -1.\n");
        buf_str(out, c"fn rfind_bytes(s: [u8], needle: [u8], to: i64) -> i64 {\n");
        buf_str(out, c"    let n = needle.len;\n");
        buf_str(out, c"    if n == 0 {\n");
        buf_str(out, c"        return to;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if n > to {\n");
        buf_str(out, c"        return -1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let last = needle[n - 1];\n");
        buf_str(out, c"    var end = to;\n");
        buf_str(out, c"    while end >= n {\n");
        buf_str(out, c"        match memrchr(last, s[n - 1..end]) {\n");
        buf_str(out, c"            Option::Some(k) => {\n");
        buf_str(out, c"                let at = k;\n");
        buf_str(out, c"                var same = true;\n");
        buf_str(out, c"                for j in 0..n - 1 {\n");
        buf_str(out, c"                    if s[at + j] != needle[j] {\n");
        buf_str(out, c"                        same = false;\n");
        buf_str(out, c"                        break;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if same {\n");
        buf_str(out, c"                    return at;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                end = at + n - 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Option::None => return -1,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    -1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What `split`, `find`, `trim_matches` and their kin look for: a `str` or\n");
        buf_str(out, c"// `[u8]` (a substring), a `u8` (a byte: `','`) or a `u32` (a code point).\n");
        buf_str(out, c"pub trait Pattern {\n");
        buf_str(out, c"    // The first match in s at or after byte `from`: its start and end, or\n");
        buf_str(out, c"    // (-1, -1).\n");
        buf_str(out, c"    fn next_match(self, s: [u8], from: i64) -> (i64, i64);\n");
        buf_str(out, c"    // The last match in s[..to]: its start and end, or (-1, -1).\n");
        buf_str(out, c"    fn last_match(self, s: [u8], to: i64) -> (i64, i64);\n");
        buf_str(out, c"    // The length of a match at the start of s, or -1.\n");
        buf_str(out, c"    fn prefix_len(self, s: [u8]) -> i64;\n");
        buf_str(out, c"    // The length of a match at the end of s, or -1.\n");
        buf_str(out, c"    fn suffix_len(self, s: [u8]) -> i64;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Pattern for [u8] {\n");
        buf_str(out, c"    fn next_match(self, s: [u8], from: i64) -> (i64, i64) {\n");
        buf_str(out, c"        let at = find_bytes(s, self, from);\n");
        buf_str(out, c"        if at < 0 { (-1, -1) } else { (at, at + self.len) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn last_match(self, s: [u8], to: i64) -> (i64, i64) {\n");
        buf_str(out, c"        let at = rfind_bytes(s, self, to);\n");
        buf_str(out, c"        if at < 0 { (-1, -1) } else { (at, at + self.len) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn prefix_len(self, s: [u8]) -> i64 {\n");
        buf_str(out, c"        let p = self;\n");
        buf_str(out, c"        if p.len <= s.len && s[..p.len] == p { p.len } else { -1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn suffix_len(self, s: [u8]) -> i64 {\n");
        buf_str(out, c"        let p = self;\n");
        buf_str(out, c"        if p.len <= s.len && s[s.len - p.len..] == p { p.len } else { -1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Pattern for str {\n");
        buf_str(out, c"    fn next_match(self, s: [u8], from: i64) -> (i64, i64) {\n");
        buf_str(out, c"        let p = self as [u8];\n");
        buf_str(out, c"        p.next_match(s, from)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn last_match(self, s: [u8], to: i64) -> (i64, i64) {\n");
        buf_str(out, c"        let p = self as [u8];\n");
        buf_str(out, c"        p.last_match(s, to)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn prefix_len(self, s: [u8]) -> i64 {\n");
        buf_str(out, c"        let p = self as [u8];\n");
        buf_str(out, c"        p.prefix_len(s)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn suffix_len(self, s: [u8]) -> i64 {\n");
        buf_str(out, c"        let p = self as [u8];\n");
        buf_str(out, c"        p.suffix_len(s)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Pattern for u8 {\n");
        buf_str(out, c"    fn next_match(self, s: [u8], from: i64) -> (i64, i64) {\n");
        buf_str(out, c"        let at = if from < s.len { find_byte(self, s, from) } else { -1 };\n");
        buf_str(out, c"        if at < 0 { (-1, -1) } else { (at, at + 1) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn last_match(self, s: [u8], to: i64) -> (i64, i64) {\n");
        buf_str(out, c"        match memrchr(self, s[..to]) {\n");
        buf_str(out, c"            Option::Some(k) => (k, k + 1),\n");
        buf_str(out, c"            Option::None => (-1, -1),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn prefix_len(self, s: [u8]) -> i64 {\n");
        buf_str(out, c"        if s.len > 0 && s[0] == self { 1 } else { -1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn suffix_len(self, s: [u8]) -> i64 {\n");
        buf_str(out, c"        if s.len > 0 && s[s.len - 1] == self { 1 } else { -1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Pattern for u32 {\n");
        buf_str(out, c"    fn next_match(self, s: [u8], from: i64) -> (i64, i64) {\n");
        buf_str(out, c"        var buf: [u8; 4] = [0; 4];\n");
        buf_str(out, c"        let n = encode_utf8(self, &buf);\n");
        buf_str(out, c"        let p = buf[..n];\n");
        buf_str(out, c"        p.next_match(s, from)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn last_match(self, s: [u8], to: i64) -> (i64, i64) {\n");
        buf_str(out, c"        var buf: [u8; 4] = [0; 4];\n");
        buf_str(out, c"        let n = encode_utf8(self, &buf);\n");
        buf_str(out, c"        let p = buf[..n];\n");
        buf_str(out, c"        p.last_match(s, to)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn prefix_len(self, s: [u8]) -> i64 {\n");
        buf_str(out, c"        var buf: [u8; 4] = [0; 4];\n");
        buf_str(out, c"        let n = encode_utf8(self, &buf);\n");
        buf_str(out, c"        let p = buf[..n];\n");
        buf_str(out, c"        p.prefix_len(s)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn suffix_len(self, s: [u8]) -> i64 {\n");
        buf_str(out, c"        var buf: [u8; 4] = [0; 4];\n");
        buf_str(out, c"        let n = encode_utf8(self, &buf);\n");
        buf_str(out, c"        let p = buf[..n];\n");
        buf_str(out, c"        p.suffix_len(s)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl str {\n");
        buf_str(out, c"    // The text of bytes b, when they are UTF-8 (Rust's `str::from_utf8`).\n");
        buf_str(out, c"    pub fn from_utf8(b: [u8]) -> Result<str, Utf8Error> {\n");
        buf_str(out, c"        match validate_utf8(b) {\n");
        buf_str(out, c"            Result::Ok(_) => Result::Ok(b as str),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The text of bytes b, which must be UTF-8 (not checked: text that is\n");
        buf_str(out, c"    // not decodes as U+FFFD, never out of bounds).\n");
        buf_str(out, c"    pub unsafe fn from_utf8_unchecked(b: [u8]) -> str {\n");
        buf_str(out, c"        b as str\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The length in bytes.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn len(self) -> i64 {\n");
        buf_str(out, c"        (self as [u8]).len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn is_empty(self) -> bool {\n");
        buf_str(out, c"        (self as [u8]).len == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its bytes.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn as_bytes(self) -> [u8] {\n");
        buf_str(out, c"        self as [u8]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether byte index i starts a code point (or is the end).\n");
        buf_str(out, c"    pub fn is_char_boundary(self, i: i64) -> bool {\n");
        buf_str(out, c"        is_char_boundary(self as [u8], i)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether every byte is ASCII.\n");
        buf_str(out, c"    pub fn is_ascii(self) -> bool {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        for i in 0..b.len {\n");
        buf_str(out, c"            if b[i] >= 0x80 {\n");
        buf_str(out, c"                return false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The code points (u32), front to back; `.rev()` back to front.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn chars(self) -> Chars {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        Chars { s: b, front: 0, back: b.len }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // (byte index, code point) pairs.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn char_indices(self) -> CharIndices {\n");
        buf_str(out, c"        CharIndices { s: self as [u8], pos: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The bytes, as `as_bytes().iter()`.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn bytes(self) -> std::SliceIter<u8> {\n");
        buf_str(out, c"        (self as [u8]).iter()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The lines: split at '\\n', a '\\r' before it dropped; no last empty\n");
        buf_str(out, c"    // line after a final '\\n'.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn lines(self) -> Lines {\n");
        buf_str(out, c"        Lines { s: self as [u8], pos: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The pieces between matches of p.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn split<P: Pattern>(self, p: sink P) -> Split<P> {\n");
        buf_str(out, c"        Split { s: self as [u8], start: 0, pos: 0, pat: p, left: -1, done: false }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // At most n pieces: the last is the rest.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn splitn<P: Pattern>(self, n: i64, p: sink P) -> Split<P> {\n");
        buf_str(out, c"        Split { s: self as [u8], start: 0, pos: 0, pat: p, left: n, done: n <= 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The pieces between runs of whitespace (Unicode White_Space), none\n");
        buf_str(out, c"    // empty.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn split_whitespace(self) -> SplitWhitespace {\n");
        buf_str(out, c"        SplitWhitespace { s: self as [u8], pos: 0, ascii: false }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // As split_whitespace, ASCII whitespace only.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn split_ascii_whitespace(self) -> SplitWhitespace {\n");
        buf_str(out, c"        SplitWhitespace { s: self as [u8], pos: 0, ascii: true }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The parts before and after the first match of p.\n");
        buf_str(out, c"    pub fn split_once<P: Pattern>(self, p: sink P) -> Option<(str, str)> {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        let (a, e) = p.next_match(b, 0);\n");
        buf_str(out, c"        if a < 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some((b[..a] as str, b[e..] as str))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The parts before and after the last match of p.\n");
        buf_str(out, c"    pub fn rsplit_once<P: Pattern>(self, p: sink P) -> Option<(str, str)> {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        let (a, e) = p.last_match(b, b.len);\n");
        buf_str(out, c"        if a < 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some((b[..a] as str, b[e..] as str))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The matches of p, front to back.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn matches<P: Pattern>(self, p: sink P) -> Matches<P> {\n");
        buf_str(out, c"        Matches { s: self as [u8], pos: 0, pat: p }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The byte index of the first match of p.\n");
        buf_str(out, c"    pub fn find<P: Pattern>(self, p: sink P) -> Option<i64> {\n");
        buf_str(out, c"        let (a, _) = p.next_match(self as [u8], 0);\n");
        buf_str(out, c"        if a < 0 { Option::None } else { Option::Some(a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The byte index of the last match of p.\n");
        buf_str(out, c"    pub fn rfind<P: Pattern>(self, p: sink P) -> Option<i64> {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        let (a, _) = p.last_match(b, b.len);\n");
        buf_str(out, c"        if a < 0 { Option::None } else { Option::Some(a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn contains<P: Pattern>(self, p: sink P) -> bool {\n");
        buf_str(out, c"        let (a, _) = p.next_match(self as [u8], 0);\n");
        buf_str(out, c"        a >= 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn starts_with<P: Pattern>(self, p: sink P) -> bool {\n");
        buf_str(out, c"        p.prefix_len(self as [u8]) >= 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn ends_with<P: Pattern>(self, p: sink P) -> bool {\n");
        buf_str(out, c"        p.suffix_len(self as [u8]) >= 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Without a match of p at its start.\n");
        buf_str(out, c"    pub fn strip_prefix<P: Pattern>(self, p: sink P) -> Option<str> {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        let n = p.prefix_len(b);\n");
        buf_str(out, c"        if n < 0 { Option::None } else { Option::Some(b[n..] as str) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Without a match of p at its end.\n");
        buf_str(out, c"    pub fn strip_suffix<P: Pattern>(self, p: sink P) -> Option<str> {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        let n = p.suffix_len(b);\n");
        buf_str(out, c"        if n < 0 { Option::None } else { Option::Some(b[..b.len - n] as str) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Without whitespace (Unicode White_Space) at either end.\n");
        buf_str(out, c"    pub fn trim(self) -> str {\n");
        buf_str(out, c"        self.trim_start().trim_end()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn trim_start(self) -> str {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        var i = 0;\n");
        buf_str(out, c"        while i < b.len {\n");
        buf_str(out, c"            let (cp, n) = cp_at(b, i);\n");
        buf_str(out, c"            if !is_space_cp(cp) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += n;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b[i..] as str\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn trim_end(self) -> str {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        var end = b.len;\n");
        buf_str(out, c"        while end > 0 {\n");
        buf_str(out, c"            let (cp, n) = cp_before(b, end);\n");
        buf_str(out, c"            if !is_space_cp(cp) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            end -= n;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b[..end] as str\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Without ASCII whitespace at either end.\n");
        buf_str(out, c"    pub fn trim_ascii(self) -> str {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        var i = 0;\n");
        buf_str(out, c"        var end = b.len;\n");
        buf_str(out, c"        while i < end && is_space_cp(b[i] as u32) && b[i] < 0x80 {\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        while end > i && is_space_cp(b[end - 1] as u32) && b[end - 1] < 0x80 {\n");
        buf_str(out, c"            end -= 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b[i..end] as str\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Without the matches of p repeated at either end (an empty p: as it\n");
        buf_str(out, c"    // is).\n");
        buf_str(out, c"    pub fn trim_matches<P: Pattern>(self, p: sink P) -> str {\n");
        buf_str(out, c"        self.trim_start_matches(p).trim_end_matches(p)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn trim_start_matches<P: Pattern>(self, p: sink P) -> str {\n");
        buf_str(out, c"        var b = self as [u8];\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            let n = p.prefix_len(b);\n");
        buf_str(out, c"            if n <= 0 {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            b = b[n..];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b as str\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn trim_end_matches<P: Pattern>(self, p: sink P) -> str {\n");
        buf_str(out, c"        var b = self as [u8];\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            let n = p.suffix_len(b);\n");
        buf_str(out, c"            if n <= 0 {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            b = b[..b.len - n];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b as str\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether the two are equal ignoring ASCII case.\n");
        buf_str(out, c"    pub fn eq_ignore_ascii_case(self, other: str) -> bool {\n");
        buf_str(out, c"        let a = self as [u8];\n");
        buf_str(out, c"        let b = other as [u8];\n");
        buf_str(out, c"        if a.len != b.len {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for i in 0..a.len {\n");
        buf_str(out, c"            if ascii_lower(a[i]) != ascii_lower(b[i]) {\n");
        buf_str(out, c"                return false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The number of code points.\n");
        buf_str(out, c"    pub fn char_count(self) -> i64 {\n");
        buf_str(out, c"        std::str::count_chars(self as [u8])\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its value as a T: `s.trim().parse::<i64>()?` (Rust's FromStr: an\n");
        buf_str(out, c"    // optional sign, digits, no whitespace).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn parse<T: FromStr>(self) -> Result<T, T::Err> {\n");
        buf_str(out, c"        T::from_str(self)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its display width in a terminal's columns (std::unicode: per grapheme\n");
        buf_str(out, c"    // cluster, East Asian Wide and emoji 2).\n");
        buf_str(out, c"    pub fn width(self) -> i64 {\n");
        buf_str(out, c"        str_width(self as [u8], false)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // As width, East Asian Ambiguous 2 (CJK contexts).\n");
        buf_str(out, c"    pub fn width_cjk(self) -> i64 {\n");
        buf_str(out, c"        str_width(self as [u8], true)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The extended grapheme clusters (UAX #29): the unicode-segmentation\n");
        buf_str(out, c"    // crate's `graphemes(true)`; the flag is Rust's spelling (legacy\n");
        buf_str(out, c"    // clusters are not offered).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn graphemes(self, extended: bool) -> StrGraphemes {\n");
        buf_str(out, c"        StrGraphemes { g: graphemes(self as [u8]) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- allocating, on allocator a ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A String of this text.\n");
        buf_str(out, c"    pub fn to_string_in<A: Allocator>(self, a: sink A) -> String<A> {\n");
        buf_str(out, c"        String::from_in(self, a)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn to_owned_in<A: Allocator>(self, a: sink A) -> String<A> {\n");
        buf_str(out, c"        String::from_in(self, a)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The text in lower case (Unicode's full mappings: 'İ' is two code\n");
        buf_str(out, c"    // points).\n");
        buf_str(out, c"    pub fn to_lowercase_in<A: Allocator>(self, a: sink A) -> String<A> {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        var out: String<A> = String::with_capacity_in(b.len, a);\n");
        buf_str(out, c"        var i = 0;\n");
        buf_str(out, c"        while i < b.len {\n");
        buf_str(out, c"            let c = b[i];\n");
        buf_str(out, c"            if c < 0x80 {\n");
        buf_str(out, c"                out.bytes.push(ascii_lower(c));\n");
        buf_str(out, c"                i += 1;\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let (cp, n) = cp_at(b, i);\n");
        buf_str(out, c"            let m = to_lower(cp);\n");
        buf_str(out, c"            for k in 0..3 {\n");
        buf_str(out, c"                if m[k] != 0 {\n");
        buf_str(out, c"                    out.push(m[k]);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += n;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The text in upper case (full mappings: 'ß' is \"SS\").\n");
        buf_str(out, c"    pub fn to_uppercase_in<A: Allocator>(self, a: sink A) -> String<A> {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        var out: String<A> = String::with_capacity_in(b.len, a);\n");
        buf_str(out, c"        var i = 0;\n");
        buf_str(out, c"        while i < b.len {\n");
        buf_str(out, c"            let c = b[i];\n");
        buf_str(out, c"            if c < 0x80 {\n");
        buf_str(out, c"                out.bytes.push(ascii_upper(c));\n");
        buf_str(out, c"                i += 1;\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let (cp, n) = cp_at(b, i);\n");
        buf_str(out, c"            let m = to_upper(cp);\n");
        buf_str(out, c"            for k in 0..3 {\n");
        buf_str(out, c"                if m[k] != 0 {\n");
        buf_str(out, c"                    out.push(m[k]);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += n;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn to_ascii_lowercase_in<A: Allocator>(self, a: sink A) -> String<A> {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        var out: String<A> = String::with_capacity_in(b.len, a);\n");
        buf_str(out, c"        for i in 0..b.len {\n");
        buf_str(out, c"            out.bytes.push(ascii_lower(b[i]));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn to_ascii_uppercase_in<A: Allocator>(self, a: sink A) -> String<A> {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        var out: String<A> = String::with_capacity_in(b.len, a);\n");
        buf_str(out, c"        for i in 0..b.len {\n");
        buf_str(out, c"            out.bytes.push(ascii_upper(b[i]));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The text with every match of `from` replaced by `to`.\n");
        buf_str(out, c"    pub fn replace_in<P: Pattern,\n");
        buf_str(out, c"        A: Allocator>(self, from: sink P, to: str, a: sink A) -> String<A> {\n");
        buf_str(out, c"        self.replacen_in(from, to, -1, a)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The first n matches replaced (n < 0: all).\n");
        buf_str(out, c"    pub fn replacen_in<P: Pattern, A: Allocator>(self, from: sink P, to: str, n: i64, a: sink A)\n");
        buf_str(out, c"        -> String<A> {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        var out: String<A> = String::with_capacity_in(b.len, a);\n");
        buf_str(out, c"        var start = 0;\n");
        buf_str(out, c"        var pos = 0;\n");
        buf_str(out, c"        var left = n;\n");
        buf_str(out, c"        while left != 0 && pos <= b.len {\n");
        buf_str(out, c"            let (m, e) = from.next_match(b, pos);\n");
        buf_str(out, c"            if m < 0 {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            out.bytes.extend_from_slice(b[start..m]);\n");
        buf_str(out, c"            out.bytes.extend_from_slice(to as [u8]);\n");
        buf_str(out, c"            start = e;\n");
        buf_str(out, c"            pos = if e == m { e + char_len_at(b, e) } else { e };\n");
        buf_str(out, c"            if left > 0 {\n");
        buf_str(out, c"                left -= 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out.bytes.extend_from_slice(b[start..]);\n");
        buf_str(out, c"        out\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The text n times.\n");
        buf_str(out, c"    pub fn repeat_in<A: Allocator>(self, n: i64, a: sink A) -> String<A> {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        var out: String<A> = String::with_capacity_in(b.len * n, a);\n");
        buf_str(out, c"        for _ in 0..n {\n");
        buf_str(out, c"            out.bytes.extend_from_slice(b);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- the Rust forms: errors naming the _in forms (front/ambient) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"to_string_in(gpa)\")]\n");
        buf_str(out, c"    pub fn to_string(self) -> String {\n");
        buf_str(out, c"        self.to_string_in(Gpa::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"to_owned_in(gpa)\")]\n");
        buf_str(out, c"    pub fn to_owned(self) -> String {\n");
        buf_str(out, c"        self.to_owned_in(Gpa::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"to_lowercase_in(gpa)\")]\n");
        buf_str(out, c"    pub fn to_lowercase(self) -> String {\n");
        buf_str(out, c"        self.to_lowercase_in(Gpa::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"to_uppercase_in(gpa)\")]\n");
        buf_str(out, c"    pub fn to_uppercase(self) -> String {\n");
        buf_str(out, c"        self.to_uppercase_in(Gpa::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"replace_in(from, to, gpa)\")]\n");
        buf_str(out, c"    pub fn replace<P: Pattern>(self, from: sink P, to: str) -> String {\n");
        buf_str(out, c"        self.replace_in(from, to, Gpa::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"repeat_in(n, gpa)\")]\n");
        buf_str(out, c"    pub fn repeat(self, n: i64) -> String {\n");
        buf_str(out, c"        self.repeat_in(n, Gpa::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn ascii_lower(c: u8) -> u8 {\n");
        buf_str(out, c"    if c >= 'A' && c <= 'Z' { c + 32 } else { c }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn ascii_upper(c: u8) -> u8 {\n");
        buf_str(out, c"    if c >= 'a' && c <= 'z' { c - 32 } else { c }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The length of the code point at byte i (1 past the end).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn char_len_at(s: [u8], i: i64) -> i64 {\n");
        buf_str(out, c"    if i >= s.len {\n");
        buf_str(out, c"        return 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let n = utf8_char_width(s[i]);\n");
        buf_str(out, c"    if n == 0 { 1 } else { n }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Text: str's iterators (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `s.chars()`: the code points, front to back (`next_back`, `rev()`: back\n");
        buf_str(out, c"// to front). Text that is not UTF-8 (std's own, from_utf8_unchecked)\n");
        buf_str(out, c"// yields U+FFFD for what is not.\n");
        buf_str(out, c"pub struct Chars { s: [u8], front: i64, back: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Iterator for Chars {\n");
        buf_str(out, c"    type Item = u32;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<u32> {\n");
        buf_str(out, c"        if self.front >= self.back {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let b = self.s[self.front];\n");
        buf_str(out, c"        if b < 0x80 {\n");
        buf_str(out, c"            self.front += 1;\n");
        buf_str(out, c"            return Option::Some(b as u32);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let s = self.s[..self.back];\n");
        buf_str(out, c"        Option::Some(lossy_next(s, &self.front))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The code points left: the bytes that are not continuation bytes.\n");
        buf_str(out, c"    fn count(self) -> i64 {\n");
        buf_str(out, c"        std::str::count_chars(self.s[self.front..self.back])\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Chars {\n");
        buf_str(out, c"    // The last code point left.\n");
        buf_str(out, c"    pub fn next_back(inout self) -> Option<u32> {\n");
        buf_str(out, c"        if self.front >= self.back {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let (cp, n) = cp_before(self.s[self.front..self.back], self.back - self.front);\n");
        buf_str(out, c"        self.back -= n;\n");
        buf_str(out, c"        Option::Some(cp)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The code points back to front.\n");
        buf_str(out, c"    pub fn rev(self) -> RevChars {\n");
        buf_str(out, c"        RevChars { c: self }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The text left.\n");
        buf_str(out, c"    pub fn as_str(self) -> str {\n");
        buf_str(out, c"        self.s[self.front..self.back] as str\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `s.chars().rev()`.\n");
        buf_str(out, c"pub struct RevChars { c: Chars }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Iterator for RevChars {\n");
        buf_str(out, c"    type Item = u32;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<u32> {\n");
        buf_str(out, c"        self.c.next_back()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `s.char_indices()`: (byte index, code point).\n");
        buf_str(out, c"pub struct CharIndices { s: [u8], pos: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Iterator for CharIndices {\n");
        buf_str(out, c"    type Item = (i64, u32);\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<(i64, u32)> {\n");
        buf_str(out, c"        if self.pos >= self.s.len {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let at = self.pos;\n");
        buf_str(out, c"        let (cp, n) = cp_at(self.s, at);\n");
        buf_str(out, c"        self.pos = at + n;\n");
        buf_str(out, c"        Option::Some((at, cp))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `s.lines()`.\n");
        buf_str(out, c"pub struct Lines { s: [u8], pos: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Iterator for Lines {\n");
        buf_str(out, c"    type Item = str;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn next(inout self) -> Option<str> {\n");
        buf_str(out, c"        let s = self.s;\n");
        buf_str(out, c"        let start = self.pos;\n");
        buf_str(out, c"        if start >= s.len {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var end = find_byte('\\n', s, start);\n");
        buf_str(out, c"        if end >= 0 {\n");
        buf_str(out, c"            self.pos = end + 1;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            end = s.len;\n");
        buf_str(out, c"            self.pos = s.len;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if end > start && s[end - 1] == '\\r' {\n");
        buf_str(out, c"            end -= 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some(s[start..end] as str)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `s.split(p)`, `s.splitn(n, p)`.\n");
        buf_str(out, c"pub struct Split<P> { s: [u8], start: i64, pos: i64, pat: P, left: i64, done: bool }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<P: Pattern> Iterator for Split<P> {\n");
        buf_str(out, c"    type Item = str;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn next(inout self) -> Option<str> {\n");
        buf_str(out, c"        if self.done {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let s = self.s;\n");
        buf_str(out, c"        if self.left == 1 {\n");
        buf_str(out, c"            self.done = true;\n");
        buf_str(out, c"            return Option::Some(s[self.start..] as str);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let (m, e) = if self.pos <= s.len { self.pat.next_match(s, self.pos) } else { (-1, -1) };\n");
        buf_str(out, c"        if m < 0 {\n");
        buf_str(out, c"            self.done = true;\n");
        buf_str(out, c"            return Option::Some(s[self.start..] as str);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let piece = s[self.start..m];\n");
        buf_str(out, c"        self.start = e;\n");
        buf_str(out, c"        self.pos = if e == m { e + char_len_at(s, e) } else { e };\n");
        buf_str(out, c"        if self.left > 0 {\n");
        buf_str(out, c"            self.left -= 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some(piece as str)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `s.split_whitespace()`, `s.split_ascii_whitespace()`.\n");
        buf_str(out, c"pub struct SplitWhitespace { s: [u8], pos: i64, ascii: bool }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Iterator for SplitWhitespace {\n");
        buf_str(out, c"    type Item = str;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn next(inout self) -> Option<str> {\n");
        buf_str(out, c"        let s = self.s;\n");
        buf_str(out, c"        var i = self.pos;\n");
        buf_str(out, c"        // (the whitespace before the piece)\n");
        buf_str(out, c"        while i < s.len {\n");
        buf_str(out, c"            let c = s[i];\n");
        buf_str(out, c"            if c < 0x80 {\n");
        buf_str(out, c"                if !is_space_cp(c as u32) {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                i += 1;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                if self.ascii {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let (cp, n) = cp_at(s, i);\n");
        buf_str(out, c"                if !is_space_cp(cp) {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                i += n;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if i >= s.len {\n");
        buf_str(out, c"            self.pos = s.len;\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let start = i;\n");
        buf_str(out, c"        while i < s.len {\n");
        buf_str(out, c"            let c = s[i];\n");
        buf_str(out, c"            if c < 0x80 {\n");
        buf_str(out, c"                if is_space_cp(c as u32) {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                i += 1;\n");
        buf_str(out, c"            } else if self.ascii {\n");
        buf_str(out, c"                i += 1;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                let (cp, n) = cp_at(s, i);\n");
        buf_str(out, c"                if is_space_cp(cp) {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                i += n;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.pos = i;\n");
        buf_str(out, c"        Option::Some(s[start..i] as str)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `s.matches(p)`.\n");
        buf_str(out, c"pub struct Matches<P> { s: [u8], pos: i64, pat: P }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<P: Pattern> Iterator for Matches<P> {\n");
        buf_str(out, c"    type Item = str;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn next(inout self) -> Option<str> {\n");
        buf_str(out, c"        let s = self.s;\n");
        buf_str(out, c"        if self.pos > s.len {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let (m, e) = self.pat.next_match(s, self.pos);\n");
        buf_str(out, c"        if m < 0 {\n");
        buf_str(out, c"            self.pos = s.len + 1;\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.pos = if e == m { e + char_len_at(s, e) } else { e };\n");
        buf_str(out, c"        Option::Some(s[m..e] as str)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `s.graphemes(true)`: the extended grapheme clusters.\n");
        buf_str(out, c"pub struct StrGraphemes { g: Graphemes }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Iterator for StrGraphemes {\n");
        buf_str(out, c"    type Item = str;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<str> {\n");
        buf_str(out, c"        match self.g.next() {\n");
        buf_str(out, c"            Option::Some(b) => Option::Some(b as str),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Text: parsing (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A type that text parses as: `s.parse::<T>()`, `T::from_str(s)` (Rust's).\n");
        buf_str(out, c"pub trait FromStr {\n");
        buf_str(out, c"    type Err;\n");
        buf_str(out, c"    fn from_str(s: str) -> Result<Self, Self::Err>;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Why `s.parse::<bool>()` failed: the text is not \"true\" or \"false\".\n");
        buf_str(out, c"#[derive(Eq, Debug, Clone)]\n");
        buf_str(out, c"pub struct ParseBoolError { at: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for ParseBoolError {\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) {\n");
        buf_str(out, c"        f.str(\"provided string was not `true` or `false`\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl FromStr for bool {\n");
        buf_str(out, c"    type Err = ParseBoolError;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn from_str(s: str) -> Result<bool, ParseBoolError> {\n");
        buf_str(out, c"        if s == \"true\" {\n");
        buf_str(out, c"            return Result::Ok(true);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s == \"false\" {\n");
        buf_str(out, c"            return Result::Ok(false);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Result::Err(ParseBoolError { at: 0 })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl FromStr for i64 {\n");
        buf_str(out, c"    type Err = ParseIntError;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn from_str(s: str) -> Result<i64, ParseIntError> {\n");
        buf_str(out, c"        parse_i64_radix(s as [u8], 10)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl FromStr for u64 {\n");
        buf_str(out, c"    type Err = ParseIntError;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn from_str(s: str) -> Result<u64, ParseIntError> {\n");
        buf_str(out, c"        parse_u64_radix(s as [u8], 10)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An i64 that fits in [lo, hi], else Overflow.\n");
        buf_str(out, c"fn parse_signed_in(s: str, lo: i64, hi: i64) -> Result<i64, ParseIntError> {\n");
        buf_str(out, c"    match parse_i64_radix(s as [u8], 10) {\n");
        buf_str(out, c"        Result::Ok(v) => if v < lo || v > hi { Result::Err(ParseIntError::Overflow) }\n");
        buf_str(out, c"            else { Result::Ok(v) },\n");
        buf_str(out, c"        Result::Err(e) => Result::Err(e),\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn parse_unsigned_in(s: str, hi: u64) -> Result<u64, ParseIntError> {\n");
        buf_str(out, c"    match parse_u64_radix(s as [u8], 10) {\n");
        buf_str(out, c"        Result::Ok(v) => if v > hi { Result::Err(ParseIntError::Overflow) } else { Result::Ok(v) },\n");
        buf_str(out, c"        Result::Err(e) => Result::Err(e),\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl FromStr for i32 {\n");
        buf_str(out, c"    type Err = ParseIntError;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn from_str(s: str) -> Result<i32, ParseIntError> {\n");
        buf_str(out, c"        match parse_signed_in(s, -2147483648, 2147483647) {\n");
        buf_str(out, c"            Result::Ok(v) => Result::Ok(v as i32),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl FromStr for i16 {\n");
        buf_str(out, c"    type Err = ParseIntError;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn from_str(s: str) -> Result<i16, ParseIntError> {\n");
        buf_str(out, c"        match parse_signed_in(s, -32768, 32767) {\n");
        buf_str(out, c"            Result::Ok(v) => Result::Ok(v as i16),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl FromStr for i8 {\n");
        buf_str(out, c"    type Err = ParseIntError;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn from_str(s: str) -> Result<i8, ParseIntError> {\n");
        buf_str(out, c"        match parse_signed_in(s, -128, 127) {\n");
        buf_str(out, c"            Result::Ok(v) => Result::Ok(v as i8),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl FromStr for u32 {\n");
        buf_str(out, c"    type Err = ParseIntError;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn from_str(s: str) -> Result<u32, ParseIntError> {\n");
        buf_str(out, c"        match parse_unsigned_in(s, 4294967295) {\n");
        buf_str(out, c"            Result::Ok(v) => Result::Ok(v as u32),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl FromStr for u16 {\n");
        buf_str(out, c"    type Err = ParseIntError;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn from_str(s: str) -> Result<u16, ParseIntError> {\n");
        buf_str(out, c"        match parse_unsigned_in(s, 65535) {\n");
        buf_str(out, c"            Result::Ok(v) => Result::Ok(v as u16),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl FromStr for u8 {\n");
        buf_str(out, c"    type Err = ParseIntError;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn from_str(s: str) -> Result<u8, ParseIntError> {\n");
        buf_str(out, c"        match parse_unsigned_in(s, 255) {\n");
        buf_str(out, c"            Result::Ok(v) => Result::Ok(v as u8),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl FromStr for f64 {\n");
        buf_str(out, c"    type Err = ParseFloatError;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn from_str(s: str) -> Result<f64, ParseFloatError> {\n");
        buf_str(out, c"        parse_f64(s as [u8])\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl FromStr for f32 {\n");
        buf_str(out, c"    type Err = ParseFloatError;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn from_str(s: str) -> Result<f32, ParseFloatError> {\n");
        buf_str(out, c"        parse_f32(s as [u8])\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Text: String (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// UTF-8 text that owns its bytes, on allocator A (Rust's String):\n");
        buf_str(out, c"// `String::new_in(gpa)`, `s.push_str(\"..\")`, `s.push_fmt(f\"..\")`. It has\n");
        buf_str(out, c"// its `str`'s methods (`s.trim()`, `s.split(',')`: the compiler calls\n");
        buf_str(out, c"// them on `s.as_str()`), and `&s` goes where a `str` or `[u8]` does.\n");
        buf_str(out, c"// (its bytes are std's: #[sealed] keeps other code from changing them)\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct String<A: Allocator = Gpa> { pub bytes: Vec<u8, A> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> String<A> {\n");
        buf_str(out, c"    pub fn new_in(a: sink A) -> String<A> {\n");
        buf_str(out, c"        String { bytes: Vec::new_in(a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn with_capacity_in(cap: i64, a: sink A) -> String<A> {\n");
        buf_str(out, c"        String { bytes: Vec::with_capacity_in(cap, a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A String of s's text (Rust's `String::from(s)`).\n");
        buf_str(out, c"    pub fn from_in(s: str, a: sink A) -> String<A> {\n");
        buf_str(out, c"        let b = s as [u8];\n");
        buf_str(out, c"        var v: Vec<u8, A> = Vec::with_capacity_in(b.len, a);\n");
        buf_str(out, c"        v.extend_from_slice(b);\n");
        buf_str(out, c"        String { bytes: v }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The String of bytes v when they are UTF-8 (they are dropped when not).\n");
        buf_str(out, c"    pub fn from_utf8(v: sink Vec<u8, A>) -> Result<String<A>, Utf8Error> {\n");
        buf_str(out, c"        match validate_utf8(v.as_slice()) {\n");
        buf_str(out, c"            Result::Ok(_) => Result::Ok(String { bytes: v }),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The String of Buf b's bytes when they are UTF-8.\n");
        buf_str(out, c"    pub fn from_buf(b: sink Buf<A>) -> Result<String<A>, Utf8Error> {\n");
        buf_str(out, c"        var b = b;\n");
        buf_str(out, c"        let v = b.bytes.take();\n");
        buf_str(out, c"        String::from_utf8(v)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The text of bytes b, U+FFFD in place of what is not UTF-8 (each\n");
        buf_str(out, c"    // maximal subpart, as Rust's from_utf8_lossy).\n");
        buf_str(out, c"    pub fn from_utf8_lossy_in(b: [u8], a: sink A) -> String<A> {\n");
        buf_str(out, c"        var out: String<A> = String::with_capacity_in(b.len, a);\n");
        buf_str(out, c"        var i = 0;\n");
        buf_str(out, c"        while i < b.len {\n");
        buf_str(out, c"            let start = i;\n");
        buf_str(out, c"            while i < b.len && b[i] < 0x80 {\n");
        buf_str(out, c"                i += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            out.bytes.extend_from_slice(b[start..i]);\n");
        buf_str(out, c"            if i < b.len {\n");
        buf_str(out, c"                let cp = lossy_next(b, &i);\n");
        buf_str(out, c"                out.push(cp);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn len(self) -> i64 {\n");
        buf_str(out, c"        self.bytes.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn is_empty(self) -> bool {\n");
        buf_str(out, c"        self.bytes.len == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn capacity(self) -> i64 {\n");
        buf_str(out, c"        self.bytes.capacity()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn reserve(inout self, extra: i64) {\n");
        buf_str(out, c"        self.bytes.reserve(extra);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn clear(inout self) {\n");
        buf_str(out, c"        self.bytes.clear();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The text, a view (valid until the String changes).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn as_str(self) -> str {\n");
        buf_str(out, c"        self.bytes.as_slice() as str\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn as_bytes(self) -> [u8] {\n");
        buf_str(out, c"        self.bytes.as_slice()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its bytes, as a Buf's `as_slice`.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn as_slice(self) -> [u8] {\n");
        buf_str(out, c"        self.bytes.as_slice()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Appends code point cp (U+FFFD for one that is not a scalar value).\n");
        buf_str(out, c"    pub fn push(inout self, cp: u32) {\n");
        buf_str(out, c"        if cp < 0x80 {\n");
        buf_str(out, c"            self.bytes.push(cp as u8);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var buf: [u8; 4] = [0; 4];\n");
        buf_str(out, c"        let n = encode_utf8(cp, &buf);\n");
        buf_str(out, c"        self.bytes.extend_from_slice(buf[..n]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Appends s (`s.push_str(f\"..\")` writes the f-string in place).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn push_str(inout self, s: str) {\n");
        buf_str(out, c"        self.bytes.extend_from_slice(s as [u8]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Appends x's Display: `s.push_fmt(f\"{k}={v};\")`.\n");
        buf_str(out, c"    pub fn push_fmt<T: Display>(inout self, x: sink T) {\n");
        buf_str(out, c"        var f = std::fmt::fmt_to_vec(&self.bytes);\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            x.fmt(&f);\n");
        buf_str(out, c"            if std::fmt::fmt_end_vec(&self.bytes, &f) {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The last code point, removed.\n");
        buf_str(out, c"    pub fn pop(inout self) -> Option<u32> {\n");
        buf_str(out, c"        let n = self.bytes.len;\n");
        buf_str(out, c"        if n == 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let (cp, k) = cp_before(self.bytes.as_slice(), n);\n");
        buf_str(out, c"        self.bytes.truncate(n - k);\n");
        buf_str(out, c"        Option::Some(cp)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Keeps the first n bytes; n must be a char boundary.\n");
        buf_str(out, c"    pub fn truncate(inout self, n: i64) {\n");
        buf_str(out, c"        if n < self.bytes.len {\n");
        buf_str(out, c"            if !is_char_boundary(self.bytes.as_slice(), n) {\n");
        buf_str(out, c"                std::panic_str(\"String::truncate: not a char boundary\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.bytes.truncate(n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Inserts s at byte index i (a char boundary).\n");
        buf_str(out, c"    pub fn insert_str(inout self, i: i64, s: str) {\n");
        buf_str(out, c"        let b = s as [u8];\n");
        buf_str(out, c"        let len = self.bytes.len;\n");
        buf_str(out, c"        if i < 0 || i > len || !is_char_boundary(self.bytes.as_slice(), i) {\n");
        buf_str(out, c"            std::panic_str(\"String::insert_str: not a char boundary\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for k in 0..b.len {\n");
        buf_str(out, c"            self.bytes.push(0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let all = self.bytes.as_mut_slice();\n");
        buf_str(out, c"        var j = len;\n");
        buf_str(out, c"        while j > i {\n");
        buf_str(out, c"            j -= 1;\n");
        buf_str(out, c"            all[j + b.len] = all[j];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for k in 0..b.len {\n");
        buf_str(out, c"            all[i + k] = b[k];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Inserts code point cp at byte index i.\n");
        buf_str(out, c"    pub fn insert(inout self, i: i64, cp: u32) {\n");
        buf_str(out, c"        var buf: [u8; 4] = [0; 4];\n");
        buf_str(out, c"        let n = encode_utf8(cp, &buf);\n");
        buf_str(out, c"        let t = buf[..n];\n");
        buf_str(out, c"        self.insert_str(i, t as str);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes the code point at byte index i, returning it.\n");
        buf_str(out, c"    pub fn remove(inout self, i: i64) -> u32 {\n");
        buf_str(out, c"        let len = self.bytes.len;\n");
        buf_str(out, c"        if i < 0 || i >= len || !is_char_boundary(self.bytes.as_slice(), i) {\n");
        buf_str(out, c"            std::panic_str(\"String::remove: not a char boundary\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let (cp, n) = cp_at(self.bytes.as_slice(), i);\n");
        buf_str(out, c"        let all = self.bytes.as_mut_slice();\n");
        buf_str(out, c"        for j in i..len - n {\n");
        buf_str(out, c"            all[j] = all[j + n];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.bytes.truncate(len - n);\n");
        buf_str(out, c"        cp\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Keeps the code points f is true for.\n");
        buf_str(out, c"    pub fn retain<F: FnMut(u32) -> bool>(inout self, f: F) {\n");
        buf_str(out, c"        var f = f;\n");
        buf_str(out, c"        let len = self.bytes.len;\n");
        buf_str(out, c"        var w = 0;\n");
        buf_str(out, c"        var i = 0;\n");
        buf_str(out, c"        while i < len {\n");
        buf_str(out, c"            let (cp, n) = cp_at(self.bytes.as_slice(), i);\n");
        buf_str(out, c"            if f(cp) {\n");
        buf_str(out, c"                let all = self.bytes.as_mut_slice();\n");
        buf_str(out, c"                for k in 0..n {\n");
        buf_str(out, c"                    all[w + k] = all[i + k];\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                w += n;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += n;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.bytes.truncate(w);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its bytes, as a Vec (the String is gone).\n");
        buf_str(out, c"    pub fn into_bytes(sink self) -> Vec<u8, A> {\n");
        buf_str(out, c"        var s = self;\n");
        buf_str(out, c"        s.bytes.take()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its bytes, as a Buf.\n");
        buf_str(out, c"    pub fn into_buf(sink self) -> Buf<A> {\n");
        buf_str(out, c"        var s = self;\n");
        buf_str(out, c"        Buf { bytes: s.bytes.take() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn allocator(self) -> A {\n");
        buf_str(out, c"        self.bytes.allocator()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator + Ambient> String<A> {\n");
        buf_str(out, c"    #[ambient(\"String::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> String<A> {\n");
        buf_str(out, c"        String { bytes: Vec::new_in(A::ambient()) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"String::with_capacity_in(cap, gpa)\")]\n");
        buf_str(out, c"    pub fn with_capacity(cap: i64) -> String<A> {\n");
        buf_str(out, c"        String { bytes: Vec::with_capacity_in(cap, A::ambient()) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"String::from_in(s, gpa)\")]\n");
        buf_str(out, c"    pub fn from(s: str) -> String<A> {\n");
        buf_str(out, c"        String::from_in(s, A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Display for String<A> {\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) {\n");
        buf_str(out, c"        f.str(self.bytes.as_slice());\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Debug for String<A> {\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) {\n");
        buf_str(out, c"        let s = self.bytes.as_slice();\n");
        buf_str(out, c"        s.fmt_debug(&f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Eq for String<A> {\n");
        buf_str(out, c"    fn eq(self, other: String<A>) -> bool {\n");
        buf_str(out, c"        let a = self.bytes.as_slice();\n");
        buf_str(out, c"        let b = other.bytes.as_slice();\n");
        buf_str(out, c"        a == b\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Ord for String<A> {\n");
        buf_str(out, c"    fn cmp(self, other: String<A>) -> i64 {\n");
        buf_str(out, c"        let a = self.bytes.as_slice();\n");
        buf_str(out, c"        let b = other.bytes.as_slice();\n");
        buf_str(out, c"        a.cmp(b)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Hash for String<A> {\n");
        buf_str(out, c"    fn hash(self) -> u64 {\n");
        buf_str(out, c"        let a = self.bytes.as_slice();\n");
        buf_str(out, c"        a.hash()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Clone for String<A> {\n");
        buf_str(out, c"    fn clone(self) -> String<A> {\n");
        buf_str(out, c"        String { bytes: self.bytes.clone() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// x's Display as a new String on allocator a: `to_string_in(n, gpa)`,\n");
        buf_str(out, c"// `to_string_in(f\"{a}-{b}\", gpa)` (Rust's `x.to_string()`, `format!`).\n");
        buf_str(out, c"pub fn to_string_in<T: Display, A: Allocator>(x: sink T, a: sink A) -> String<A> {\n");
        buf_str(out, c"    var s: String<A> = String::new_in(a);\n");
        buf_str(out, c"    s.push_fmt(x);\n");
        buf_str(out, c"    s\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::string ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::path ----\n");
        buf_str(out, c"pub mod path {\n");
        buf_str(out, c"// std::path (0.20, docs/design/collections-text-io.md §2.6.3, task B6):\n");
        buf_str(out, c"// Path, a view of a path's bytes (Unix paths are bytes, as Rust's OsStr\n");
        buf_str(out, c"// is on Unix), and PathBuf, one that owns them, on an allocator. A string\n");
        buf_str(out, c"// literal is a Path where one goes, a Path goes where `[u8]` does, and\n");
        buf_str(out, c"// `&p` of a PathBuf where a Path or `[u8]` does.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Allocator, Debug, Display, Fmt, Gpa, Iterator, Option, Vec};\n");
        buf_str(out, c"use std::str::validate_utf8;\n");
        buf_str(out, c"use std::string::str;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Paths (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A path: its bytes, '/' between its components.\n");
        buf_str(out, c"pub type Path = distinct [u8];\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The index of the last '/' in b, or -1.\n");
        buf_str(out, c"fn last_slash(b: [u8]) -> i64 {\n");
        buf_str(out, c"    var i = b.len;\n");
        buf_str(out, c"    while i > 0 {\n");
        buf_str(out, c"        i -= 1;\n");
        buf_str(out, c"        if b[i] == '/' {\n");
        buf_str(out, c"            return i;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    -1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// b without the '/'s at its end (one stays for the root).\n");
        buf_str(out, c"fn trim_slashes(b: [u8]) -> [u8] {\n");
        buf_str(out, c"    var n = b.len;\n");
        buf_str(out, c"    while n > 1 && b[n - 1] == '/' {\n");
        buf_str(out, c"        n -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    b[..n]\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Path {\n");
        buf_str(out, c"    // The path of bytes (or text) s: `Path::new(\"a/b.txt\")`.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn new(s: [u8]) -> Path {\n");
        buf_str(out, c"        s as Path\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn as_bytes(self) -> [u8] {\n");
        buf_str(out, c"        self as [u8]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn len(self) -> i64 {\n");
        buf_str(out, c"        (self as [u8]).len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its text, when its bytes are UTF-8.\n");
        buf_str(out, c"    pub fn to_str(self) -> Option<str> {\n");
        buf_str(out, c"        match str::from_utf8(self as [u8]) {\n");
        buf_str(out, c"            Ok(s) => Option::Some(s),\n");
        buf_str(out, c"            Err(_) => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // What prints it (Path is Display itself: its bytes).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn display(self) -> Path {\n");
        buf_str(out, c"        self\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_absolute(self) -> bool {\n");
        buf_str(out, c"        let b = self as [u8];\n");
        buf_str(out, c"        b.len > 0 && b[0] == '/'\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_relative(self) -> bool {\n");
        buf_str(out, c"        !self.is_absolute()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The last component (None for \"/\", \"\", \"..\", or one ending in \"..\").\n");
        buf_str(out, c"    pub fn file_name(self) -> Option<Path> {\n");
        buf_str(out, c"        let b = trim_slashes(self as [u8]);\n");
        buf_str(out, c"        if b.len == 0 || b == \"/\" {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let name = b[last_slash(b) + 1..];\n");
        buf_str(out, c"        if name == \"..\" || name == \".\" {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some(name as Path)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The path without its last component (\"\" for a single component, None\n");
        buf_str(out, c"    // for \"/\" and \"\").\n");
        buf_str(out, c"    pub fn parent(self) -> Option<Path> {\n");
        buf_str(out, c"        let b = trim_slashes(self as [u8]);\n");
        buf_str(out, c"        if b.len == 0 || b == \"/\" {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let k = last_slash(b);\n");
        buf_str(out, c"        if k < 0 {\n");
        buf_str(out, c"            return Option::Some(\"\"[..0] as Path);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k == 0 {\n");
        buf_str(out, c"            return Option::Some(b[..1] as Path);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some(trim_slashes(b[..k]) as Path)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The file name after its last '.' (none for \".bashrc\" or \"a\").\n");
        buf_str(out, c"    pub fn extension(self) -> Option<Path> {\n");
        buf_str(out, c"        match self.file_name() {\n");
        buf_str(out, c"            Option::Some(n) => {\n");
        buf_str(out, c"                let b = n as [u8];\n");
        buf_str(out, c"                let k = last_dot(b);\n");
        buf_str(out, c"                if k <= 0 { Option::None } else { Option::Some(b[k + 1..] as Path) }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The file name before its last '.'.\n");
        buf_str(out, c"    pub fn file_stem(self) -> Option<Path> {\n");
        buf_str(out, c"        match self.file_name() {\n");
        buf_str(out, c"            Option::Some(n) => {\n");
        buf_str(out, c"                let b = n as [u8];\n");
        buf_str(out, c"                let k = last_dot(b);\n");
        buf_str(out, c"                if k <= 0 { Option::Some(n) } else { Option::Some(b[..k] as Path) }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether its first components are base's.\n");
        buf_str(out, c"    pub fn starts_with(self, base: Path) -> bool {\n");
        buf_str(out, c"        let a = self as [u8];\n");
        buf_str(out, c"        let b = trim_slashes(base as [u8]);\n");
        buf_str(out, c"        if b.len > a.len || a[..b.len] != b {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        a.len == b.len || b == \"/\" || a[b.len] == '/'\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The components (\"/\" first for an absolute path; \".\" and empty ones\n");
        buf_str(out, c"    // left out, as Rust's).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn components(self) -> Components {\n");
        buf_str(out, c"        Components { b: self as [u8], pos: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The path with p after it, on allocator a (p absolute: p).\n");
        buf_str(out, c"    pub fn join_in<A: Allocator>(self, p: [u8], a: sink A) -> PathBuf<A> {\n");
        buf_str(out, c"        var out: PathBuf<A> = PathBuf::from_in(self as [u8], a);\n");
        buf_str(out, c"        out.push(p);\n");
        buf_str(out, c"        out\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An owned copy, on allocator a.\n");
        buf_str(out, c"    pub fn to_path_buf_in<A: Allocator>(self, a: sink A) -> PathBuf<A> {\n");
        buf_str(out, c"        PathBuf::from_in(self as [u8], a)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether something is there (std::fs::metadata succeeds).\n");
        buf_str(out, c"    pub fn exists(self) -> bool {\n");
        buf_str(out, c"        std::fs::exists(self as [u8])\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_dir(self) -> bool {\n");
        buf_str(out, c"        match std::fs::metadata(self as [u8]) {\n");
        buf_str(out, c"            Ok(m) => m.is_dir(),\n");
        buf_str(out, c"            Err(_) => false,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_file(self) -> bool {\n");
        buf_str(out, c"        match std::fs::metadata(self as [u8]) {\n");
        buf_str(out, c"            Ok(m) => m.is_file(),\n");
        buf_str(out, c"            Err(_) => false,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The index of the last '.' in b, or -1.\n");
        buf_str(out, c"fn last_dot(b: [u8]) -> i64 {\n");
        buf_str(out, c"    var i = b.len;\n");
        buf_str(out, c"    while i > 0 {\n");
        buf_str(out, c"        i -= 1;\n");
        buf_str(out, c"        if b[i] == '.' {\n");
        buf_str(out, c"            return i;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    -1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `p.components()`.\n");
        buf_str(out, c"pub struct Components { b: [u8], pos: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Iterator for Components {\n");
        buf_str(out, c"    type Item = Path;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn next(inout self) -> Option<Path> {\n");
        buf_str(out, c"        let b = self.b;\n");
        buf_str(out, c"        if self.pos == 0 && b.len > 0 && b[0] == '/' {\n");
        buf_str(out, c"            self.pos = 1;\n");
        buf_str(out, c"            return Option::Some(b[..1] as Path);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            while self.pos < b.len && b[self.pos] == '/' {\n");
        buf_str(out, c"                self.pos += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if self.pos >= b.len {\n");
        buf_str(out, c"                return Option::None;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let start = self.pos;\n");
        buf_str(out, c"            while self.pos < b.len && b[self.pos] != '/' {\n");
        buf_str(out, c"                self.pos += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let c = b[start..self.pos];\n");
        buf_str(out, c"            if c != \".\" {\n");
        buf_str(out, c"                return Option::Some(c as Path);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An owned path, on allocator A.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct PathBuf<A: Allocator = Gpa> { pub bytes: Vec<u8, A> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> PathBuf<A> {\n");
        buf_str(out, c"    pub fn new_in(a: sink A) -> PathBuf<A> {\n");
        buf_str(out, c"        PathBuf { bytes: Vec::new_in(a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A PathBuf of p's bytes.\n");
        buf_str(out, c"    pub fn from_in(p: [u8], a: sink A) -> PathBuf<A> {\n");
        buf_str(out, c"        var v: Vec<u8, A> = Vec::with_capacity_in(p.len, a);\n");
        buf_str(out, c"        v.extend_from_slice(p);\n");
        buf_str(out, c"        PathBuf { bytes: v }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn as_path(self) -> Path {\n");
        buf_str(out, c"        self.bytes.as_slice() as Path\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn as_bytes(self) -> [u8] {\n");
        buf_str(out, c"        self.bytes.as_slice()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Appends p after a '/' (p absolute: p replaces the path).\n");
        buf_str(out, c"    pub fn push(inout self, p: [u8]) {\n");
        buf_str(out, c"        if p.len > 0 && p[0] == '/' {\n");
        buf_str(out, c"            self.bytes.clear();\n");
        buf_str(out, c"        } else if self.bytes.len > 0 && self.bytes.as_slice()[self.bytes.len - 1] != '/' {\n");
        buf_str(out, c"            self.bytes.push('/');\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.bytes.extend_from_slice(p);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes the last component: false when there is none.\n");
        buf_str(out, c"    pub fn pop(inout self) -> bool {\n");
        buf_str(out, c"        match self.as_path().parent() {\n");
        buf_str(out, c"            Option::Some(q) => {\n");
        buf_str(out, c"                let n = (q as [u8]).len;\n");
        buf_str(out, c"                self.bytes.truncate(n);\n");
        buf_str(out, c"                true\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Option::None => false,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its extension replaced by ext (added when it has none; ext \"\" removes\n");
        buf_str(out, c"    // it): false when it has no file name.\n");
        buf_str(out, c"    pub fn set_extension(inout self, ext: [u8]) -> bool {\n");
        buf_str(out, c"        let stem_end = match self.as_path().file_stem() {\n");
        buf_str(out, c"            Option::Some(s) => {\n");
        buf_str(out, c"                // (the stem starts the last component)\n");
        buf_str(out, c"                let b = trim_slashes(self.bytes.as_slice());\n");
        buf_str(out, c"                last_slash(b) + 1 + (s as [u8]).len\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Option::None => return false,\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        self.bytes.truncate(stem_end);\n");
        buf_str(out, c"        if ext.len > 0 {\n");
        buf_str(out, c"            self.bytes.push('.');\n");
        buf_str(out, c"            self.bytes.extend_from_slice(ext);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Display for PathBuf<A> {\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) {\n");
        buf_str(out, c"        f.str(self.bytes.as_slice());\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Debug for PathBuf<A> {\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) {\n");
        buf_str(out, c"        let s = self.bytes.as_slice();\n");
        buf_str(out, c"        s.fmt_debug(&f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::path ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::fs ----\n");
        buf_str(out, c"pub mod fs {\n");
        buf_str(out, c"// std::fs (0.20, docs/design/collections-text-io.md §2.6.3, task B6):\n");
        buf_str(out, c"// files and directories with Rust's names. A path is any `[u8]`: a\n");
        buf_str(out, c"// literal, a `str`, a Path, `&s` of a String or PathBuf. It reaches C as a\n");
        buf_str(out, c"// NUL-ended copy on the stack (std::sys: InvalidInput when it is longer\n");
        buf_str(out, c"// than the system's PATH_MAX or holds a NUL), so nothing here allocates\n");
        buf_str(out, c"// but what returns a Vec or a String, on the allocator given.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Allocator, Drop, Iterator, Option, Vec};\n");
        buf_str(out, c"use std::io::buffered::{Read, Write};\n");
        buf_str(out, c"use std::io::error::{Error, ErrorKind, Result, __io_error, __os_error};\n");
        buf_str(out, c"use std::path::{Path, PathBuf};\n");
        buf_str(out, c"use std::str::validate_utf8;\n");
        buf_str(out, c"use std::string::{String, str};\n");
        buf_str(out, c"use std::sys::{\n");
        buf_str(out, c"    FileStat, SYS_DT_DIR, SYS_DT_LNK, SYS_DT_REG, SYS_DT_UNKNOWN, SYS_EEXIST, SYS_O_APPEND,\n");
        buf_str(out, c"    SYS_O_CLOEXEC, SYS_O_CREAT, SYS_O_EXCL, SYS_O_RDONLY, SYS_O_RDWR, SYS_O_TRUNC, SYS_O_WRONLY,\n");
        buf_str(out, c"    SYS_SEEK_CUR, SYS_SEEK_END, SYS_SEEK_SET, SysDir, sys_close, sys_closedir, sys_fstat, sys_fsync,\n");
        buf_str(out, c"    sys_ftruncate, sys_lseek, sys_lstat, sys_mkdir, sys_open, sys_opendir, sys_read,\n");
        buf_str(out, c"    sys_readdir_into, sys_rename, sys_rmdir, sys_stat, sys_unlink, sys_write,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Files (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An open file; dropping it closes it.\n");
        buf_str(out, c"pub struct File { fd: i32 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Drop for File {\n");
        buf_str(out, c"    fn drop(inout self) {\n");
        buf_str(out, c"        if self.fd >= 0 {\n");
        buf_str(out, c"            let _ = sys_close(self.fd);\n");
        buf_str(out, c"            self.fd = -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The Result of a sys call, its errno an io::Error.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn os<T>(r: sink std::Result<T, i32>) -> Result<T> {\n");
        buf_str(out, c"    match r {\n");
        buf_str(out, c"        Ok(v) => Ok(v),\n");
        buf_str(out, c"        Err(e) => Err(__os_error(e)),\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl File {\n");
        buf_str(out, c"    // Opens path for reading.\n");
        buf_str(out, c"    pub fn open(path: [u8]) -> Result<File> {\n");
        buf_str(out, c"        let fd = os(sys_open(path, SYS_O_RDONLY | SYS_O_CLOEXEC, 0))?;\n");
        buf_str(out, c"        Ok(File { fd: fd })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Opens path for writing: made if it is not there, emptied if it is.\n");
        buf_str(out, c"    pub fn create(path: [u8]) -> Result<File> {\n");
        buf_str(out, c"        let fd = os(sys_open(path, SYS_O_WRONLY | SYS_O_CREAT | SYS_O_TRUNC | SYS_O_CLOEXEC,\n");
        buf_str(out, c"            0x1b6))?;\n");
        buf_str(out, c"        Ok(File { fd: fd })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Makes path and opens it for writing: AlreadyExists when it is there.\n");
        buf_str(out, c"    pub fn create_new(path: [u8]) -> Result<File> {\n");
        buf_str(out, c"        let fd = os(sys_open(path, SYS_O_WRONLY | SYS_O_CREAT | SYS_O_EXCL | SYS_O_CLOEXEC,\n");
        buf_str(out, c"            0x1b6))?;\n");
        buf_str(out, c"        Ok(File { fd: fd })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The options to open a file with: `OpenOptions::new().append(true)`.\n");
        buf_str(out, c"    pub fn options() -> OpenOptions {\n");
        buf_str(out, c"        OpenOptions::new()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its file descriptor.\n");
        buf_str(out, c"    pub fn as_raw_fd(self) -> i32 {\n");
        buf_str(out, c"        self.fd\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn metadata(self) -> Result<Metadata> {\n");
        buf_str(out, c"        let st = os(sys_fstat(self.fd))?;\n");
        buf_str(out, c"        Ok(Metadata { st: st })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its length becomes n (cut, or zeros after).\n");
        buf_str(out, c"    pub fn set_len(self, n: i64) -> Result<()> {\n");
        buf_str(out, c"        os(sys_ftruncate(self.fd, n))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Writes what the system holds of it to the disk.\n");
        buf_str(out, c"    pub fn sync_all(self) -> Result<()> {\n");
        buf_str(out, c"        os(sys_fsync(self.fd))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Moves the position: to `off` from the start (Rust's\n");
        buf_str(out, c"    // `seek(SeekFrom::Start(off))`); the new position.\n");
        buf_str(out, c"    pub fn seek(inout self, pos: SeekFrom) -> Result<i64> {\n");
        buf_str(out, c"        let r = match pos {\n");
        buf_str(out, c"            SeekFrom::Start(o) => sys_lseek(self.fd, o, SYS_SEEK_SET),\n");
        buf_str(out, c"            SeekFrom::End(o) => sys_lseek(self.fd, o, SYS_SEEK_END),\n");
        buf_str(out, c"            SeekFrom::Current(o) => sys_lseek(self.fd, o, SYS_SEEK_CUR),\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        os(r)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Where File::seek moves to.\n");
        buf_str(out, c"#[derive(Eq, Debug, Clone)]\n");
        buf_str(out, c"pub enum SeekFrom { Start(i64), End(i64), Current(i64) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Read for File {\n");
        buf_str(out, c"    fn read(inout self, buf: inout [u8]) -> Result<i64> {\n");
        buf_str(out, c"        os(sys_read(self.fd, buf))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Write for File {\n");
        buf_str(out, c"    fn write(inout self, buf: [u8]) -> Result<i64> {\n");
        buf_str(out, c"        os(sys_write(self.fd, buf))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn flush(inout self) -> Result<()> {\n");
        buf_str(out, c"        Ok(())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// How File::open... opens a file (Rust's OpenOptions):\n");
        buf_str(out, c"// `OpenOptions::new().append(true).create(true).open(p)?`.\n");
        buf_str(out, c"#[derive(Eq, Debug, Clone)]\n");
        buf_str(out, c"pub struct OpenOptions {\n");
        buf_str(out, c"    read: bool, write: bool, append: bool, truncate: bool, create: bool, create_new: bool,\n");
        buf_str(out, c"    mode: i32,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl OpenOptions {\n");
        buf_str(out, c"    pub fn new() -> OpenOptions {\n");
        buf_str(out, c"        OpenOptions { read: false, write: false, append: false, truncate: false, create: false,\n");
        buf_str(out, c"            create_new: false, mode: 0x1b6 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn read(self, on: bool) -> OpenOptions {\n");
        buf_str(out, c"        var o = self;\n");
        buf_str(out, c"        o.read = on;\n");
        buf_str(out, c"        o\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn write(self, on: bool) -> OpenOptions {\n");
        buf_str(out, c"        var o = self;\n");
        buf_str(out, c"        o.write = on;\n");
        buf_str(out, c"        o\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn append(self, on: bool) -> OpenOptions {\n");
        buf_str(out, c"        var o = self;\n");
        buf_str(out, c"        o.append = on;\n");
        buf_str(out, c"        o\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn truncate(self, on: bool) -> OpenOptions {\n");
        buf_str(out, c"        var o = self;\n");
        buf_str(out, c"        o.truncate = on;\n");
        buf_str(out, c"        o\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn create(self, on: bool) -> OpenOptions {\n");
        buf_str(out, c"        var o = self;\n");
        buf_str(out, c"        o.create = on;\n");
        buf_str(out, c"        o\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn create_new(self, on: bool) -> OpenOptions {\n");
        buf_str(out, c"        var o = self;\n");
        buf_str(out, c"        o.create_new = on;\n");
        buf_str(out, c"        o\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The permission bits a file it makes gets (0x1b6 before the umask).\n");
        buf_str(out, c"    pub fn mode(self, bits: i32) -> OpenOptions {\n");
        buf_str(out, c"        var o = self;\n");
        buf_str(out, c"        o.mode = bits;\n");
        buf_str(out, c"        o\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn open(self, path: [u8]) -> Result<File> {\n");
        buf_str(out, c"        let writes = self.write || self.append;\n");
        buf_str(out, c"        var flags = if self.read && writes { SYS_O_RDWR } else if writes { SYS_O_WRONLY }\n");
        buf_str(out, c"            else { SYS_O_RDONLY };\n");
        buf_str(out, c"        if self.append {\n");
        buf_str(out, c"            flags |= SYS_O_APPEND;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.truncate {\n");
        buf_str(out, c"            flags |= SYS_O_TRUNC;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.create_new {\n");
        buf_str(out, c"            flags |= SYS_O_CREAT | SYS_O_EXCL;\n");
        buf_str(out, c"        } else if self.create {\n");
        buf_str(out, c"            flags |= SYS_O_CREAT;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let fd = os(sys_open(path, flags | SYS_O_CLOEXEC, self.mode))?;\n");
        buf_str(out, c"        Ok(File { fd: fd })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What stat says of a file.\n");
        buf_str(out, c"#[derive(Eq, Debug)]\n");
        buf_str(out, c"pub struct Metadata { st: FileStat }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Metadata {\n");
        buf_str(out, c"    // The size in bytes.\n");
        buf_str(out, c"    pub fn len(self) -> i64 {\n");
        buf_str(out, c"        self.st.size\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_dir(self) -> bool {\n");
        buf_str(out, c"        self.st.is_dir()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_file(self) -> bool {\n");
        buf_str(out, c"        self.st.is_file()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_symlink(self) -> bool {\n");
        buf_str(out, c"        self.st.is_symlink()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The permission bits (0x1ed: 0o755, ...).\n");
        buf_str(out, c"    pub fn mode(self) -> u32 {\n");
        buf_str(out, c"        self.st.permissions()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // When it was last changed: since the Unix epoch.\n");
        buf_str(out, c"    pub fn modified(self) -> std::time::Duration {\n");
        buf_str(out, c"        std::time::Duration::new(self.st.mtime_sec as u64, self.st.mtime_nsec as u32)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Whole files (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The bytes of the file at path, in a new Vec on allocator a.\n");
        buf_str(out, c"pub fn read_in<A: Allocator>(path: [u8], a: sink A) -> Result<Vec<u8, A>> {\n");
        buf_str(out, c"    var f = File::open(path)?;\n");
        buf_str(out, c"    let size = match f.metadata() {\n");
        buf_str(out, c"        Ok(m) => m.len(),\n");
        buf_str(out, c"        Err(_) => 0,\n");
        buf_str(out, c"    };\n");
        buf_str(out, c"    var v: Vec<u8, A> = Vec::with_capacity_in(size + 1, a);\n");
        buf_str(out, c"    f.read_to_end(&v)?;\n");
        buf_str(out, c"    Ok(v)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The text of the file at path, in a new String on allocator a\n");
        buf_str(out, c"// (InvalidData when it is not UTF-8).\n");
        buf_str(out, c"pub fn read_to_string_in<A: Allocator>(path: [u8], a: sink A) -> Result<String<A>> {\n");
        buf_str(out, c"    let v = read_in(path, a)?;\n");
        buf_str(out, c"    match String::from_utf8(v) {\n");
        buf_str(out, c"        Ok(s) => Ok(s),\n");
        buf_str(out, c"        Err(_) => Err(__io_error(ErrorKind::InvalidData, c\"stream did not contain valid UTF-8\")),\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The file at path holds data: made, or emptied first.\n");
        buf_str(out, c"pub fn write(path: [u8], data: [u8]) -> Result<()> {\n");
        buf_str(out, c"    var f = File::create(path)?;\n");
        buf_str(out, c"    f.write_all(data)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// data at the end of the file at path (made when it is not there).\n");
        buf_str(out, c"pub fn append(path: [u8], data: [u8]) -> Result<()> {\n");
        buf_str(out, c"    var f = OpenOptions::new().append(true).create(true).open(path)?;\n");
        buf_str(out, c"    f.write_all(data)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Copies the file at `from` to `to` (made, or emptied): the bytes copied.\n");
        buf_str(out, c"pub fn copy(from: [u8], to: [u8]) -> Result<i64> {\n");
        buf_str(out, c"    var src = File::open(from)?;\n");
        buf_str(out, c"    var dst = File::create(to)?;\n");
        buf_str(out, c"    var buf: [u8; 65536] = [0; 65536];\n");
        buf_str(out, c"    var total = 0;\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        let n = src.read(&buf[..])?;\n");
        buf_str(out, c"        if n == 0 {\n");
        buf_str(out, c"            return Ok(total);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        dst.write_all(buf[..n])?;\n");
        buf_str(out, c"        total += n;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What stat says of the file at path (through a symlink).\n");
        buf_str(out, c"pub fn metadata(path: [u8]) -> Result<Metadata> {\n");
        buf_str(out, c"    let st = os(sys_stat(path))?;\n");
        buf_str(out, c"    Ok(Metadata { st: st })\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// As metadata, of a symlink itself.\n");
        buf_str(out, c"pub fn symlink_metadata(path: [u8]) -> Result<Metadata> {\n");
        buf_str(out, c"    let st = os(sys_lstat(path))?;\n");
        buf_str(out, c"    Ok(Metadata { st: st })\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether something is at path.\n");
        buf_str(out, c"pub fn exists(path: [u8]) -> bool {\n");
        buf_str(out, c"    match sys_stat(path) {\n");
        buf_str(out, c"        Ok(_) => true,\n");
        buf_str(out, c"        Err(_) => false,\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn remove_file(path: [u8]) -> Result<()> {\n");
        buf_str(out, c"    os(sys_unlink(path))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Removes the empty directory at path.\n");
        buf_str(out, c"pub fn remove_dir(path: [u8]) -> Result<()> {\n");
        buf_str(out, c"    os(sys_rmdir(path))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn rename(from: [u8], to: [u8]) -> Result<()> {\n");
        buf_str(out, c"    os(sys_rename(from, to))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn create_dir(path: [u8]) -> Result<()> {\n");
        buf_str(out, c"    os(sys_mkdir(path, 0x1ff))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Makes the directory at path and the ones above it that are missing\n");
        buf_str(out, c"// (Ok when it is there).\n");
        buf_str(out, c"pub fn create_dir_all(path: [u8]) -> Result<()> {\n");
        buf_str(out, c"    if path.len == 0 {\n");
        buf_str(out, c"        return Ok(());\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    match sys_mkdir(path, 0x1ff) {\n");
        buf_str(out, c"        Ok(_) => return Ok(()),\n");
        buf_str(out, c"        Err(e) => {\n");
        buf_str(out, c"            if e == SYS_EEXIST {\n");
        buf_str(out, c"                return if is_dir_at(path) { Ok(()) } else { Err(__os_error(e)) };\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // (the parents first, then this one)\n");
        buf_str(out, c"    var end = path.len;\n");
        buf_str(out, c"    while end > 0 && path[end - 1] == '/' {\n");
        buf_str(out, c"        end -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var k = end;\n");
        buf_str(out, c"    while k > 0 && path[k - 1] != '/' {\n");
        buf_str(out, c"        k -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if k > 1 {\n");
        buf_str(out, c"        create_dir_all(path[..k - 1])?;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    match sys_mkdir(path, 0x1ff) {\n");
        buf_str(out, c"        Ok(_) => Ok(()),\n");
        buf_str(out, c"        Err(e) => if e == SYS_EEXIST && is_dir_at(path) { Ok(()) } else { Err(__os_error(e)) },\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn is_dir_at(path: [u8]) -> bool {\n");
        buf_str(out, c"    match sys_stat(path) {\n");
        buf_str(out, c"        Ok(st) => st.is_dir(),\n");
        buf_str(out, c"        Err(_) => false,\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Removes the directory at path and all it holds (symlinks are removed,\n");
        buf_str(out, c"// not followed).\n");
        buf_str(out, c"pub fn remove_dir_all(path: [u8]) -> Result<()> {\n");
        buf_str(out, c"    var stack: [u8; 4096] = [0; 4096];\n");
        buf_str(out, c"    if path.len >= 4096 {\n");
        buf_str(out, c"        return Err(__io_error(ErrorKind::InvalidInput, c\"path too long\"));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for i in 0..path.len {\n");
        buf_str(out, c"        stack[i] = path[i];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    remove_tree(&stack, path.len)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Removes the tree at buf[..n], which it extends with each entry's name.\n");
        buf_str(out, c"fn remove_tree(buf: inout [u8; 4096], n: i64) -> Result<()> {\n");
        buf_str(out, c"    let st = os(sys_lstat(buf[..n]))?;\n");
        buf_str(out, c"    if !st.is_dir() {\n");
        buf_str(out, c"        return os(sys_unlink(buf[..n]));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var dir = read_dir(buf[..n])?;\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        let e = match dir.next() {\n");
        buf_str(out, c"            Option::Some(r) => r?,\n");
        buf_str(out, c"            Option::None => break,\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        let name = e.name[..e.len];\n");
        buf_str(out, c"        if n + 1 + name.len >= 4096 {\n");
        buf_str(out, c"            return Err(__io_error(ErrorKind::InvalidInput, c\"path too long\"));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        buf[n] = '/';\n");
        buf_str(out, c"        for i in 0..name.len {\n");
        buf_str(out, c"            buf[n + 1 + i] = name[i];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        remove_tree(&buf, n + 1 + name.len)?;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    os(sys_rmdir(buf[..n]))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Directories (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The entries of the directory at path (\".\" and \"..\" left out), in the\n");
        buf_str(out, c"// order the file system gives them.\n");
        buf_str(out, c"pub fn read_dir(path: [u8]) -> Result<ReadDir> {\n");
        buf_str(out, c"    let d = os(sys_opendir(path))?;\n");
        buf_str(out, c"    Ok(ReadDir { dir: d })\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `fs::read_dir(p)?`: each item an io::Result<DirEntry>. Dropping it\n");
        buf_str(out, c"// closes the directory.\n");
        buf_str(out, c"pub struct ReadDir { dir: SysDir }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Drop for ReadDir {\n");
        buf_str(out, c"    fn drop(inout self) {\n");
        buf_str(out, c"        let _ = sys_closedir(&self.dir);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Iterator for ReadDir {\n");
        buf_str(out, c"    type Item = Result<DirEntry>;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn next(inout self) -> Option<Result<DirEntry>> {\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            var e = DirEntry { name: [0; 256], len: 0, kind: 0 };\n");
        buf_str(out, c"            match sys_readdir_into(&self.dir, &e.name) {\n");
        buf_str(out, c"                Ok(Option::Some(x)) => {\n");
        buf_str(out, c"                    e.len = x.name_len;\n");
        buf_str(out, c"                    e.kind = x.kind;\n");
        buf_str(out, c"                    let nm = e.name[..e.len];\n");
        buf_str(out, c"                    if nm == \".\" || nm == \"..\" {\n");
        buf_str(out, c"                        continue;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    return Option::Some(Ok(e));\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                Ok(Option::None) => return Option::None,\n");
        buf_str(out, c"                Err(err) => return Option::Some(Err(__os_error(err))),\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A directory's entry: its name (inline, up to 256 bytes) and kind.\n");
        buf_str(out, c"pub struct DirEntry { name: [u8; 256], len: i64, kind: u8 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl DirEntry {\n");
        buf_str(out, c"    // Its name, a view of the entry.\n");
        buf_str(out, c"    pub fn file_name(self) -> Path {\n");
        buf_str(out, c"        self.name[..self.len] as Path\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // dir's path with the name after it, on allocator a.\n");
        buf_str(out, c"    pub fn path_in<A: Allocator>(self, dir: [u8], a: sink A) -> PathBuf<A> {\n");
        buf_str(out, c"        var p: PathBuf<A> = PathBuf::from_in(dir, a);\n");
        buf_str(out, c"        p.push(self.name[..self.len]);\n");
        buf_str(out, c"        p\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether the file system says it is a directory (false when it does\n");
        buf_str(out, c"    // not say: fs::metadata knows).\n");
        buf_str(out, c"    pub fn is_dir(self) -> bool {\n");
        buf_str(out, c"        self.kind == SYS_DT_DIR\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_file(self) -> bool {\n");
        buf_str(out, c"        self.kind == SYS_DT_REG\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_symlink(self) -> bool {\n");
        buf_str(out, c"        self.kind == SYS_DT_LNK\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::fs ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::env ----\n");
        buf_str(out, c"pub mod env {\n");
        buf_str(out, c"// std::env (0.20, docs/design/collections-text-io.md §2.6.3, task B6):\n");
        buf_str(out, c"// the program's arguments and environment, with Rust's names. `args()`\n");
        buf_str(out, c"// yields views of argv, valid for the whole program (no allocation);\n");
        buf_str(out, c"// a variable's value is copied (`get_in`), since the environment can\n");
        buf_str(out, c"// change under a view. (Rust's `env::var` is `env::get` here: `var`\n");
        buf_str(out, c"// is a word, a keyword from 0.21.)\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Allocator, Display, Fmt, Gpa, Iterator, Option, Result, Vec, sys_args};\n");
        buf_str(out, c"use std::io::error::{Error, ErrorKind, __io_error, __os_error};\n");
        buf_str(out, c"use std::path::PathBuf;\n");
        buf_str(out, c"use std::str::validate_utf8;\n");
        buf_str(out, c"use std::string::{String, str};\n");
        buf_str(out, c"use std::sys::{\n");
        buf_str(out, c"    sys_chdir, sys_cstr_view, sys_env_at, sys_env_count, sys_getcwd_into, sys_getenv, sys_setenv,\n");
        buf_str(out, c"    sys_unsetenv,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Arguments (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The i-th argument's bytes (i < count).\n");
        buf_str(out, c"fn arg_bytes(i: i64) -> [u8] {\n");
        buf_str(out, c"    let (n, argv) = sys_args();\n");
        buf_str(out, c"    if i < 0 || i >= n {\n");
        buf_str(out, c"        std::panic_str(\"env: argument index out of bounds\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // (argv[0..argc] are crt's NUL-ended strings, for the whole program)\n");
        buf_str(out, c"    unsafe { sys_cstr_view(argv[i]) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The arguments, the program's name first: `for a in env::args()`,\n");
        buf_str(out, c"// `env::args().collect_in(gpa)`. One that is not UTF-8 stops the program\n");
        buf_str(out, c"// (as Rust's); `args_os()` yields bytes.\n");
        buf_str(out, c"pub fn args() -> Args {\n");
        buf_str(out, c"    let (n, _) = sys_args();\n");
        buf_str(out, c"    Args { i: 0, n: n }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The arguments as bytes.\n");
        buf_str(out, c"pub fn args_os() -> ArgsOs {\n");
        buf_str(out, c"    let (n, _) = sys_args();\n");
        buf_str(out, c"    ArgsOs { i: 0, n: n }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Args { i: i64, n: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Iterator for Args {\n");
        buf_str(out, c"    type Item = str;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn next(inout self) -> Option<str> {\n");
        buf_str(out, c"        if self.i >= self.n {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let b = arg_bytes(self.i);\n");
        buf_str(out, c"        self.i += 1;\n");
        buf_str(out, c"        match str::from_utf8(b) {\n");
        buf_str(out, c"            Ok(s) => Option::Some(s),\n");
        buf_str(out, c"            Err(_) => std::panic_str(\n");
        buf_str(out, c"                \"env::args: an argument is not UTF-8 (env::args_os yields bytes)\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn exact_len(self) -> i64 {\n");
        buf_str(out, c"        self.n - self.i\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Args {\n");
        buf_str(out, c"    // The arguments left.\n");
        buf_str(out, c"    pub fn len(self) -> i64 {\n");
        buf_str(out, c"        self.n - self.i\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Skips the first n (`env::args().skip(1)`: the program's name).\n");
        buf_str(out, c"    pub fn skip(self, n: i64) -> Args {\n");
        buf_str(out, c"        var a = self;\n");
        buf_str(out, c"        a.i = if a.i + n < a.n { a.i + n } else { a.n };\n");
        buf_str(out, c"        a\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct ArgsOs { i: i64, n: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Iterator for ArgsOs {\n");
        buf_str(out, c"    type Item = [u8];\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn next(inout self) -> Option<[u8]> {\n");
        buf_str(out, c"        if self.i >= self.n {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let b = arg_bytes(self.i);\n");
        buf_str(out, c"        self.i += 1;\n");
        buf_str(out, c"        Option::Some(b)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- The environment (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Why env::get_in failed: the variable is not set, or its value is not\n");
        buf_str(out, c"// UTF-8.\n");
        buf_str(out, c"#[derive(Eq, Debug, Clone)]\n");
        buf_str(out, c"pub enum VarError { NotPresent, NotUnicode }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for VarError {\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            VarError::NotPresent => f.str(\"environment variable not found\"),\n");
        buf_str(out, c"            VarError::NotUnicode => f.str(\"environment variable was not valid unicode\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The value of variable name, copied into a new String on allocator a.\n");
        buf_str(out, c"pub fn get_in<A: Allocator>(name: [u8], a: sink A) -> Result<String<A>, VarError> {\n");
        buf_str(out, c"    match sys_getenv(name) {\n");
        buf_str(out, c"        Option::Some(v) => match validate_utf8(v) {\n");
        buf_str(out, c"            Ok(_) => Ok(String::from_in(v as str, a)),\n");
        buf_str(out, c"            Err(_) => Err(VarError::NotUnicode),\n");
        buf_str(out, c"        },\n");
        buf_str(out, c"        Option::None => Err(VarError::NotPresent),\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.16: an error outside std, front/ambient.tach)\n");
        buf_str(out, c"#[ambient(\"get_in(name, gpa)\")]\n");
        buf_str(out, c"pub fn get(name: [u8]) -> Result<String, VarError> {\n");
        buf_str(out, c"    get_in(name, Gpa::ambient())\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The value of variable name, its bytes copied into a new Vec on a.\n");
        buf_str(out, c"pub fn var_os_in<A: Allocator>(name: [u8], a: sink A) -> Option<Vec<u8, A>> {\n");
        buf_str(out, c"    match sys_getenv(name) {\n");
        buf_str(out, c"        Option::Some(v) => {\n");
        buf_str(out, c"            var out: Vec<u8, A> = Vec::with_capacity_in(v.len, a);\n");
        buf_str(out, c"            out.extend_from_slice(v);\n");
        buf_str(out, c"            Option::Some(out)\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::None => Option::None,\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether variable name is set.\n");
        buf_str(out, c"pub fn var_is_set(name: [u8]) -> bool {\n");
        buf_str(out, c"    sys_getenv(name).is_some()\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Every variable, (name, value) copied into Strings on allocator a (the\n");
        buf_str(out, c"// ones that are not UTF-8 left out).\n");
        buf_str(out, c"pub fn vars_in<A: Allocator>(a: sink A) -> Vec<(String<A>, String<A>), A> {\n");
        buf_str(out, c"    var out: Vec<(String<A>, String<A>), A> = Vec::new_in(a);\n");
        buf_str(out, c"    for i in 0..sys_env_count() {\n");
        buf_str(out, c"        let kv = sys_env_at(i);\n");
        buf_str(out, c"        var eq = -1;\n");
        buf_str(out, c"        for k in 0..kv.len {\n");
        buf_str(out, c"            if kv[k] == '=' {\n");
        buf_str(out, c"                eq = k;\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if eq < 0 || validate_utf8(kv).is_err() {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let name: String<A> = String::from_in(kv[..eq] as str, a);\n");
        buf_str(out, c"        let value: String<A> = String::from_in(kv[eq + 1..] as str, a);\n");
        buf_str(out, c"        out.push((name, value));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    out\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sets variable name to value (Rust 2024's `unsafe fn`: no other thread\n");
        buf_str(out, c"// may read the environment meanwhile, and views of it end).\n");
        buf_str(out, c"pub unsafe fn set_var(name: [u8], value: [u8]) {\n");
        buf_str(out, c"    let _ = sys_setenv(name, value);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub unsafe fn remove_var(name: [u8]) {\n");
        buf_str(out, c"    let _ = sys_unsetenv(name);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- The working directory (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The current directory, in a new PathBuf on allocator a.\n");
        buf_str(out, c"pub fn current_dir_in<A: Allocator>(a: sink A) -> std::io::Result<PathBuf<A>> {\n");
        buf_str(out, c"    var buf: [u8; 4096] = [0; 4096];\n");
        buf_str(out, c"    match sys_getcwd_into(&buf[..]) {\n");
        buf_str(out, c"        Ok(n) => Ok(PathBuf::from_in(buf[..n], a)),\n");
        buf_str(out, c"        Err(e) => Err(__os_error(e)),\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn set_current_dir(path: [u8]) -> std::io::Result<()> {\n");
        buf_str(out, c"    match sys_chdir(path) {\n");
        buf_str(out, c"        Ok(_) => Ok(()),\n");
        buf_str(out, c"        Err(e) => Err(__os_error(e)),\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::env ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::process ----\n");
        buf_str(out, c"pub mod process {\n");
        buf_str(out, c"// std::process (0.20, docs/design/collections-text-io.md §2.6.3, task\n");
        buf_str(out, c"// B6): running programs, with Rust's names, through posix_spawnp\n");
        buf_str(out, c"// (std::sys). A Command keeps its program and up to 32 arguments as\n");
        buf_str(out, c"// views, inline, and builds argv on the stack when it runs (each argument\n");
        buf_str(out, c"// and the program's name up to 4 KB in all: InvalidInput beyond), so\n");
        buf_str(out, c"// `Command::new(p)` allocates nothing; `output_in(gpa)` puts what the\n");
        buf_str(out, c"// child writes in Vecs on gpa. `c.arg(x)` changes c in place (Rust's\n");
        buf_str(out, c"// `&mut Command`): `let mut c = Command::new(\"ls\"); c.arg(\"-l\");\n");
        buf_str(out, c"// let out = c.output_in(gpa)?;`.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Allocator, Display, Fmt, Option, Vec};\n");
        buf_str(out, c"use std::io::error::{Error, ErrorKind, Result, __io_error, __os_error};\n");
        buf_str(out, c"use std::sys::{\n");
        buf_str(out, c"    SYS_EINTR, SYS_O_RDWR, SYS_POLLHUP, SYS_POLLIN, SysPollFd, SysSpawnActions, sys_close,\n");
        buf_str(out, c"    sys_exit_code, sys_exit_signal, sys_kill, sys_open, sys_pipe, sys_poll, sys_read, sys_spawn,\n");
        buf_str(out, c"    sys_spawn_actions, sys_waitpid,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Processes (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"const MAX_ARGS: i64 = 32;\n");
        buf_str(out, c"const ARG_TEXT: i64 = 4096;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What a child's stdin, stdout or stderr is: this process's (inherit),\n");
        buf_str(out, c"// /dev/null (null), or a pipe to this process (piped: output_in's).\n");
        buf_str(out, c"#[derive(Eq, Debug, Clone)]\n");
        buf_str(out, c"pub enum Stdio { Inherit, Null, Piped }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Stdio {\n");
        buf_str(out, c"    pub fn inherit() -> Stdio { Stdio::Inherit }\n");
        buf_str(out, c"    pub fn null() -> Stdio { Stdio::Null }\n");
        buf_str(out, c"    pub fn piped() -> Stdio { Stdio::Piped }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A program to run, its arguments and its streams.\n");
        buf_str(out, c"pub struct Command {\n");
        buf_str(out, c"    prog: [u8],\n");
        buf_str(out, c"    args: [[u8]; 32],\n");
        buf_str(out, c"    count: i64,\n");
        buf_str(out, c"    stdin: Stdio,\n");
        buf_str(out, c"    stdout: Stdio,\n");
        buf_str(out, c"    stderr: Stdio,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// How a child ended: its exit code, or the signal that ended it.\n");
        buf_str(out, c"#[derive(Eq, Debug, Clone)]\n");
        buf_str(out, c"pub struct ExitStatus { status: i32 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl ExitStatus {\n");
        buf_str(out, c"    // Whether it exited with 0.\n");
        buf_str(out, c"    pub fn success(self) -> bool {\n");
        buf_str(out, c"        match sys_exit_code(self.status) {\n");
        buf_str(out, c"            Option::Some(c) => c == 0,\n");
        buf_str(out, c"            Option::None => false,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its exit code (None when a signal ended it).\n");
        buf_str(out, c"    pub fn code(self) -> Option<i32> {\n");
        buf_str(out, c"        sys_exit_code(self.status)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The signal that ended it.\n");
        buf_str(out, c"    pub fn signal(self) -> Option<i32> {\n");
        buf_str(out, c"        sys_exit_signal(self.status)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for ExitStatus {\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) {\n");
        buf_str(out, c"        match sys_exit_code(self.status) {\n");
        buf_str(out, c"            Option::Some(c) => {\n");
        buf_str(out, c"                f.str(\"exit status: \");\n");
        buf_str(out, c"                f.int(c as i64);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Option::None => {\n");
        buf_str(out, c"                f.str(\"signal: \");\n");
        buf_str(out, c"                f.int(self.status as i64 & 0x7f);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What output_in returns: how the child ended, and what it wrote.\n");
        buf_str(out, c"pub struct Output<A: Allocator> {\n");
        buf_str(out, c"    pub status: ExitStatus, pub stdout: Vec<u8, A>, pub stderr: Vec<u8, A>\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A running child: wait for it (dropping it does not).\n");
        buf_str(out, c"pub struct Child { pid: i32, done: bool, status: i32 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Child {\n");
        buf_str(out, c"    pub fn id(self) -> i32 {\n");
        buf_str(out, c"        self.pid\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Waits for it to end.\n");
        buf_str(out, c"    pub fn wait(inout self) -> Result<ExitStatus> {\n");
        buf_str(out, c"        if self.done {\n");
        buf_str(out, c"            return Ok(ExitStatus { status: self.status });\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let st = wait_pid(self.pid)?;\n");
        buf_str(out, c"        self.done = true;\n");
        buf_str(out, c"        self.status = st;\n");
        buf_str(out, c"        Ok(ExitStatus { status: st })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // How it ended, if it has: None while it runs.\n");
        buf_str(out, c"    pub fn try_wait(inout self) -> Result<Option<ExitStatus>> {\n");
        buf_str(out, c"        if self.done {\n");
        buf_str(out, c"            return Ok(Option::Some(ExitStatus { status: self.status }));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        match sys_waitpid(self.pid, true) {\n");
        buf_str(out, c"            Ok((p, st)) => {\n");
        buf_str(out, c"                if p == 0 {\n");
        buf_str(out, c"                    return Ok(Option::None);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.done = true;\n");
        buf_str(out, c"                self.status = st;\n");
        buf_str(out, c"                Ok(Option::Some(ExitStatus { status: st }))\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Err(e) => Err(__os_error(e)),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Sends it SIGKILL.\n");
        buf_str(out, c"    pub fn kill(inout self) -> Result<()> {\n");
        buf_str(out, c"        match sys_kill(self.pid, 9) {\n");
        buf_str(out, c"            Ok(_) => Ok(()),\n");
        buf_str(out, c"            Err(e) => Err(__os_error(e)),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Waits for pid (again when a signal interrupts): its status.\n");
        buf_str(out, c"fn wait_pid(pid: i32) -> Result<i32> {\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        match sys_waitpid(pid, false) {\n");
        buf_str(out, c"            Ok((_, st)) => return Ok(st),\n");
        buf_str(out, c"            Err(e) => {\n");
        buf_str(out, c"                if e != SYS_EINTR {\n");
        buf_str(out, c"                    return Err(__os_error(e));\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The NUL-ended copies of a command's program and arguments, and argv.\n");
        buf_str(out, c"struct Argv { text: [u8; 4096], ptrs: [*u8; 34] }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Command {\n");
        buf_str(out, c"    // Runs prog: a path, or a name looked up in PATH.\n");
        buf_str(out, c"    pub fn new(prog: [u8]) -> Command {\n");
        buf_str(out, c"        Command { prog: prog, args: [\"\"; 32], count: 0, stdin: Stdio::Inherit,\n");
        buf_str(out, c"            stdout: Stdio::Inherit, stderr: Stdio::Inherit }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Adds an argument (up to 32).\n");
        buf_str(out, c"    pub fn arg(inout self, a: [u8]) {\n");
        buf_str(out, c"        if self.count >= MAX_ARGS {\n");
        buf_str(out, c"            std::panic_str(\"Command::arg: more than 32 arguments\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.args[self.count] = a;\n");
        buf_str(out, c"        self.count += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Adds each of list.\n");
        buf_str(out, c"    pub fn args(inout self, list: [[u8]]) {\n");
        buf_str(out, c"        for a in list {\n");
        buf_str(out, c"            self.arg(a);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn stdin(inout self, s: Stdio) {\n");
        buf_str(out, c"        self.stdin = s;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn stdout(inout self, s: Stdio) {\n");
        buf_str(out, c"        self.stdout = s;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn stderr(inout self, s: Stdio) {\n");
        buf_str(out, c"        self.stderr = s;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // argv for C, in out: InvalidInput when it does not fit or holds a NUL.\n");
        buf_str(out, c"    fn build_argv(self, out: inout Argv) -> Result<()> {\n");
        buf_str(out, c"        var at = 0;\n");
        buf_str(out, c"        for k in 0..self.count + 1 {\n");
        buf_str(out, c"            let s = if k == 0 { self.prog } else { self.args[k - 1] };\n");
        buf_str(out, c"            if at + s.len + 1 > ARG_TEXT {\n");
        buf_str(out, c"                return Err(__io_error(ErrorKind::InvalidInput, c\"arguments over 4096 bytes\"));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for i in 0..s.len {\n");
        buf_str(out, c"                if s[i] == 0 {\n");
        buf_str(out, c"                    return Err(__io_error(ErrorKind::InvalidInput, c\"an argument holds a NUL\"));\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                out.text[at + i] = s[i];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            out.text[at + s.len] = 0;\n");
        buf_str(out, c"            // (text is out's: it lives as long as ptrs does)\n");
        buf_str(out, c"            out.ptrs[k] = &out.text[at] as *u8;\n");
        buf_str(out, c"            at += s.len + 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out.ptrs[self.count + 1] = 0 as *u8;\n");
        buf_str(out, c"        Ok(())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Starts it with the streams as set (piped ones are not supported\n");
        buf_str(out, c"    // here: output_in pipes stdout and stderr).\n");
        buf_str(out, c"    pub fn spawn(self) -> Result<Child> {\n");
        buf_str(out, c"        var acts = os(sys_spawn_actions())?;\n");
        buf_str(out, c"        var null: i32 = -1;\n");
        buf_str(out, c"        let r = self.spawn_with(&acts, &null, -1, -1);\n");
        buf_str(out, c"        acts.free();\n");
        buf_str(out, c"        if null >= 0 {\n");
        buf_str(out, c"            let _ = sys_close(null);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let pid = r?;\n");
        buf_str(out, c"        Ok(Child { pid: pid, done: false, status: 0 })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Runs it, waits for it: how it ended.\n");
        buf_str(out, c"    pub fn status(self) -> Result<ExitStatus> {\n");
        buf_str(out, c"        var c = self.spawn()?;\n");
        buf_str(out, c"        c.wait()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Runs it with stdout and stderr piped to this process (stdin\n");
        buf_str(out, c"    // inherited), and waits: how it ended and what it wrote, in Vecs on a.\n");
        buf_str(out, c"    pub fn output_in<A: Allocator>(self, a: sink A) -> Result<Output<A>> {\n");
        buf_str(out, c"        let (out_r, out_w) = os(sys_pipe())?;\n");
        buf_str(out, c"        let (err_r, err_w) = match sys_pipe() {\n");
        buf_str(out, c"            Ok(p) => p,\n");
        buf_str(out, c"            Err(e) => {\n");
        buf_str(out, c"                let _ = sys_close(out_r);\n");
        buf_str(out, c"                let _ = sys_close(out_w);\n");
        buf_str(out, c"                return Err(__os_error(e));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        var acts = os(sys_spawn_actions())?;\n");
        buf_str(out, c"        var null: i32 = -1;\n");
        buf_str(out, c"        let r = self.spawn_with(&acts, &null, out_w, err_w);\n");
        buf_str(out, c"        acts.free();\n");
        buf_str(out, c"        let _ = sys_close(out_w);\n");
        buf_str(out, c"        let _ = sys_close(err_w);\n");
        buf_str(out, c"        if null >= 0 {\n");
        buf_str(out, c"            let _ = sys_close(null);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let pid = match r {\n");
        buf_str(out, c"            Ok(p) => p,\n");
        buf_str(out, c"            Err(e) => {\n");
        buf_str(out, c"                let _ = sys_close(out_r);\n");
        buf_str(out, c"                let _ = sys_close(err_r);\n");
        buf_str(out, c"                return Err(e);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        var stdout: Vec<u8, A> = Vec::new_in(a);\n");
        buf_str(out, c"        var stderr: Vec<u8, A> = Vec::new_in(a);\n");
        buf_str(out, c"        let got = drain_two(out_r, err_r, &stdout, &stderr);\n");
        buf_str(out, c"        let _ = sys_close(out_r);\n");
        buf_str(out, c"        let _ = sys_close(err_r);\n");
        buf_str(out, c"        let st = wait_pid(pid)?;\n");
        buf_str(out, c"        got?;\n");
        buf_str(out, c"        Ok(Output { status: ExitStatus { status: st }, stdout: stdout, stderr: stderr })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Spawns it with the file actions for its streams in acts (out_w,\n");
        buf_str(out, c"    // err_w: pipes for stdout and stderr, or -1); /dev/null, when one is\n");
        buf_str(out, c"    // Null, opened into *null.\n");
        buf_str(out, c"    fn spawn_with(self, acts: inout SysSpawnActions, null: inout i32, out_w: i32,\n");
        buf_str(out, c"        err_w: i32) -> Result<i32> {\n");
        buf_str(out, c"        let wants_null = self.stdin == Stdio::Null || self.stdout == Stdio::Null\n");
        buf_str(out, c"            || self.stderr == Stdio::Null;\n");
        buf_str(out, c"        if wants_null {\n");
        buf_str(out, c"            let fd = os(sys_open(\"/dev/null\", SYS_O_RDWR, 0))?;\n");
        buf_str(out, c"            null = fd;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let nfd = null;\n");
        buf_str(out, c"        if self.stdin == Stdio::Null {\n");
        buf_str(out, c"            os(acts.dup2(nfd, 0))?;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if out_w >= 0 {\n");
        buf_str(out, c"            os(acts.dup2(out_w, 1))?;\n");
        buf_str(out, c"        } else if self.stdout == Stdio::Null {\n");
        buf_str(out, c"            os(acts.dup2(nfd, 1))?;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if err_w >= 0 {\n");
        buf_str(out, c"            os(acts.dup2(err_w, 2))?;\n");
        buf_str(out, c"        } else if self.stderr == Stdio::Null {\n");
        buf_str(out, c"            os(acts.dup2(nfd, 2))?;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var argv = Argv { text: [0; 4096], ptrs: [0 as *u8; 34] };\n");
        buf_str(out, c"        self.build_argv(&argv)?;\n");
        buf_str(out, c"        let envp: [*u8; 0] = [];\n");
        buf_str(out, c"        // (argv's strings are NUL-ended and its pointers end with null:\n");
        buf_str(out, c"        // build_argv; prog is ptrs[0])\n");
        buf_str(out, c"        let r = unsafe { sys_spawn(argv.ptrs[0], argv.ptrs[..self.count + 2], envp[..], &acts) };\n");
        buf_str(out, c"        os(r)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The Result of a sys call, its errno an io::Error.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn os<T>(r: sink std::Result<T, i32>) -> Result<T> {\n");
        buf_str(out, c"    match r {\n");
        buf_str(out, c"        Ok(v) => Ok(v),\n");
        buf_str(out, c"        Err(e) => Err(__os_error(e)),\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Reads the pipes a and b to their ends, into va and vb (poll: neither\n");
        buf_str(out, c"// child stream blocks the other).\n");
        buf_str(out, c"fn drain_two<A: Allocator>(a: i32, b: i32, va: inout Vec<u8, A>, vb: inout Vec<u8, A>)\n");
        buf_str(out, c"    -> Result<()> {\n");
        buf_str(out, c"    var open_a = true;\n");
        buf_str(out, c"    var open_b = true;\n");
        buf_str(out, c"    while open_a || open_b {\n");
        buf_str(out, c"        var fds: [SysPollFd; 2] = [\n");
        buf_str(out, c"            SysPollFd { fd: if open_a { a } else { -1 }, events: SYS_POLLIN, revents: 0 },\n");
        buf_str(out, c"            SysPollFd { fd: if open_b { b } else { -1 }, events: SYS_POLLIN, revents: 0 },\n");
        buf_str(out, c"        ];\n");
        buf_str(out, c"        match sys_poll(fds[..], -1) {\n");
        buf_str(out, c"            Ok(_) => {}\n");
        buf_str(out, c"            Err(e) => {\n");
        buf_str(out, c"                if e == SYS_EINTR {\n");
        buf_str(out, c"                    continue;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return Err(__os_error(e));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if open_a && fds[0].revents != 0 {\n");
        buf_str(out, c"            open_a = read_some(a, &va)?;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if open_b && fds[1].revents != 0 {\n");
        buf_str(out, c"            open_b = read_some(b, &vb)?;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    Ok(())\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Reads what fd has into v: false at its end.\n");
        buf_str(out, c"fn read_some<A: Allocator>(fd: i32, v: inout Vec<u8, A>) -> Result<bool> {\n");
        buf_str(out, c"    if v.cap - v.len < 4096 {\n");
        buf_str(out, c"        v.reserve(if v.cap < 8192 { 8192 } else { v.cap });\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // (v's room: its capacity past its length)\n");
        buf_str(out, c"    let room = unsafe { v.ptr[v.len..v.cap] };\n");
        buf_str(out, c"    match sys_read(fd, &room) {\n");
        buf_str(out, c"        Ok(n) => {\n");
        buf_str(out, c"            v.len += n;\n");
        buf_str(out, c"            Ok(n > 0)\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Err(e) => if e == SYS_EINTR { Ok(true) } else { Err(__os_error(e)) },\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Ends this process with code (Rust's `std::process::exit`); what print\n");
        buf_str(out, c"// buffered is written out first.\n");
        buf_str(out, c"pub fn exit(code: i32) -> ! {\n");
        buf_str(out, c"    std::fmt::__flush_print();\n");
        buf_str(out, c"    unsafe { std::exit(code) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// This process's id.\n");
        buf_str(out, c"pub fn id() -> i32 {\n");
        buf_str(out, c"    std::sys::sys_getpid()\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::process ----\n");
        buf_str(out, c"}\n");
    }
    std_alloc_tail(out);
}

// Gpa's implementation (0.16), the end of std's source unless
// --check-alloc (front/stdalloc.tach).
pub fn std_gpa_source(out: i64) {
    unsafe {
        buf_str(out, c"// ---- Gpa's implementation (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// C's allocator; malloc's memory is aligned to 16, larger alignments go\n");
        buf_str(out, c"// through posix_memalign. (--check-alloc replaces this part of std with\n");
        buf_str(out, c"// alloc_check.tach.)\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[effects(alloc(extern))]\n");
        buf_str(out, c"    fn posix_memalign(out: **u8, align: u64, size: u64) -> i32;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"const GPA_MALLOC_ALIGN: i64 = 16;\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Allocator for Gpa {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn try_alloc(self: *Gpa, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        if size == 0 {\n");
        buf_str(out, c"            // (a pointer nothing is read through)\n");
        buf_str(out, c"            return unsafe { align as *u8 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if align > GPA_MALLOC_ALIGN {\n");
        buf_str(out, c"            return gpa_aligned(size, align);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe { malloc(size as u64) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn try_resize(self: *Gpa, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        if align > GPA_MALLOC_ALIGN || new_size == 0 {\n");
        buf_str(out, c"            return gpa_resize_slow(p, old_size, new_size, align);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        realloc(if old_size == 0 { 0 as *u8 } else { p }, new_size as u64)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn free(self: *Gpa, p: *u8, size: i64, align: i64) {\n");
        buf_str(out, c"        if size != 0 {\n");
        buf_str(out, c"            free(p);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// size bytes (not 0) aligned to align (above malloc's), or null.\n");
        buf_str(out, c"fn gpa_aligned(size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    var p = 0 as *u8;\n");
        buf_str(out, c"    if unsafe { posix_memalign(&p, align as u64, size as u64) } != 0 {\n");
        buf_str(out, c"        return 0 as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    p\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Gpa::try_resize to 0 bytes, or above malloc's alignment.\n");
        buf_str(out, c"#[cold]\n");
        buf_str(out, c"unsafe fn gpa_resize_slow(p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    if new_size == 0 {\n");
        buf_str(out, c"        if old_size != 0 {\n");
        buf_str(out, c"            free(p);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return align as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let q = gpa_aligned(new_size, align);\n");
        buf_str(out, c"    if q == 0 as *u8 {\n");
        buf_str(out, c"        return q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let n = if old_size < new_size { old_size } else { new_size };\n");
        buf_str(out, c"    for i in 0..n {\n");
        buf_str(out, c"        q[i] = p[i];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if old_size != 0 {\n");
        buf_str(out, c"        free(p);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    q\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Gpa's leak checks (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Gpa {\n");
        buf_str(out, c"    // The blocks allocated and not freed: -1, unknown, unless --check-alloc\n");
        buf_str(out, c"    // (the checking allocator, compiler/std/alloc_check.tach).\n");
        buf_str(out, c"    pub fn live_blocks(self) -> i64 {\n");
        buf_str(out, c"        -1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether no block is left allocated (with --check-alloc, which lists\n");
        buf_str(out, c"    // them); always true without.\n");
        buf_str(out, c"    pub fn check_leaks(self) -> bool {\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) The checking allocator's leaks since a mark (alloc_check.tach):\n");
        buf_str(out, c"// nothing to count without --check-alloc.\n");
        buf_str(out, c"fn check_alloc_leaks_since(mark: i64) -> i64 {\n");
        buf_str(out, c"    0\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- The checking allocator's hooks for arenas (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// With --check-alloc (CHECK_ALLOC), arenas route each allocation to the\n");
        buf_str(out, c"// checking allocator's pages (compiler/std/alloc_check.tach); without, these\n");
        buf_str(out, c"// are never called.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A block of size bytes for the allocator whose state is at owner.\n");
        buf_str(out, c"fn check_alloc_block(owner: u64, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    0 as *u8\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// p, a block of owner of old_size bytes, moved to new_size bytes.\n");
        buf_str(out, c"unsafe fn check_alloc_moved(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"    -> *u8 {\n");
        buf_str(out, c"    0 as *u8\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The blocks allocated so far: a mark for check_alloc_release.\n");
        buf_str(out, c"fn check_alloc_mark() -> i64 {\n");
        buf_str(out, c"    0\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Every block of owner allocated after mark given back.\n");
        buf_str(out, c"fn check_alloc_release(owner: u64, mark: i64) {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether p is the last live block of owner (an arena's last block grows\n");
        buf_str(out, c"// and is given back in place).\n");
        buf_str(out, c"fn check_alloc_is_last(owner: u64, p: *u8) -> bool {\n");
        buf_str(out, c"    false\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The site of the call being run, and that site set again (a scope's end\n");
        buf_str(out, c"// is its call's).\n");
        buf_str(out, c"fn check_alloc_site() -> *u8 {\n");
        buf_str(out, c"    0 as *u8\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn check_alloc_set_site(site: *u8) {}\n");
    }
}

// The checking Gpa (0.16), the end of std's source with --check-alloc
// (front/stdalloc.tach).
pub fn std_check_gpa_source(out: i64) {
    unsafe {
        buf_str(out, c"// ---- Gpa's leak checks (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Gpa {\n");
        buf_str(out, c"    // The blocks allocated and not freed: -1, unknown, unless --check-alloc.\n");
        buf_str(out, c"    pub fn live_blocks(self) -> i64 {\n");
        buf_str(out, c"        CHECK_LIVE\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether no block is left allocated (with --check-alloc, which lists\n");
        buf_str(out, c"    // them); always true without.\n");
        buf_str(out, c"    pub fn check_leaks(self) -> bool {\n");
        buf_str(out, c"        unsafe { check_alloc_list_leaks() }\n");
        buf_str(out, c"        CHECK_LIVE == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) The blocks allocated from `mark` (check_alloc_mark) on and not\n");
        buf_str(out, c"// freed, listed as at exit (the first line names them a case's): a\n");
        buf_str(out, c"// property's case, or a fuzz run, leaks them (test_case, fuzz_exec);\n");
        buf_str(out, c"// their count.\n");
        buf_str(out, c"fn check_alloc_leaks_since(mark: i64) -> i64 {\n");
        buf_str(out, c"    var live = 0;\n");
        buf_str(out, c"    var bytes = 0;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        for b in mark..CHECK_COUNT {\n");
        buf_str(out, c"            if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"                live += 1;\n");
        buf_str(out, c"                bytes += CHECK_BLOCKS[b].size;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if live == 0 {\n");
        buf_str(out, c"            return 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var m = check_msg();\n");
        buf_str(out, c"        m.text(\"check-alloc: \");\n");
        buf_str(out, c"        m.int(live);\n");
        buf_str(out, c"        m.text(if live == 1 { \" block\" } else { \" blocks\" });\n");
        buf_str(out, c"        m.text(\" of Gpa not freed by the case (\");\n");
        buf_str(out, c"        m.int(bytes);\n");
        buf_str(out, c"        m.text(\" bytes):\");\n");
        buf_str(out, c"        m.out();\n");
        buf_str(out, c"        var shown = 0;\n");
        buf_str(out, c"        for b in mark..CHECK_COUNT {\n");
        buf_str(out, c"            if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK\n");
        buf_str(out, c"                && shown < 20 {\n");
        buf_str(out, c"                var line = check_msg();\n");
        buf_str(out, c"                line.text(\"  \");\n");
        buf_str(out, c"                check_describe(&line, b);\n");
        buf_str(out, c"                line.out();\n");
        buf_str(out, c"                shown += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        CHECK_LISTED = CHECK_CHANGES;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    live\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Gpa's implementation: the checking allocator (0.16, --check-alloc) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// With --check-alloc (docs/design/effects-allocation.md, §2.5), Gpa gives\n");
        buf_str(out, c"// every block pages of its own, at the cursor of a large reservation of\n");
        buf_str(out, c"// address space with no access: a block's pages are made readable and\n");
        buf_str(out, c"// writable when it is allocated, and are given back with no access when it\n");
        buf_str(out, c"// is freed, never to be handed out again; every resize moves. A later\n");
        buf_str(out, c"// access to a freed block faults, and the fault handler names the block,\n");
        buf_str(out, c"// where it was allocated and where freed (the compiler stores the site of\n");
        buf_str(out, c"// each call from the program that may allocate in CHECK_ALLOC_SITE). Frees\n");
        buf_str(out, c"// are checked: double, invalid and wrong-size frees stop the program; the\n");
        buf_str(out, c"// blocks left at exit are listed. Arenas route their allocations here too\n");
        buf_str(out, c"// (check_alloc_block, check_alloc_release). Block numbers count every\n");
        buf_str(out, c"// allocation from 1, the same each run: TACHYON_ALLOC_TRAP=N raises SIGTRAP\n");
        buf_str(out, c"// when block N is allocated, for a debugger.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Its messages and stops are the allocator's misuse, the effect `alloc`:\n");
        buf_str(out, c"// not io, which an allocator may not do.)\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[effects(alloc(extern), global)]\n");
        buf_str(out, c"    fn mmap(addr: *u8, len: u64, prot: i32, flags: i32, fd: i32, offset: i64) -> *u8;\n");
        buf_str(out, c"    #[effects(alloc(extern), global)]\n");
        buf_str(out, c"    fn mprotect(addr: *u8, len: u64, prot: i32) -> i32;\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn getpagesize() -> i32;\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn getenv(name: *u8) -> *u8;\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn raise(sig: i32) -> i32;\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn atexit(f: extern \"C\" fn()) -> i32;\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn sigaction(sig: i32, act: *CheckSigaction, old: *CheckSigaction) -> i32;\n");
        buf_str(out, c"    #[link_name = \"write\"]\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn check_write(fd: i32, data: *u8, count: u64) -> i64;\n");
        buf_str(out, c"    #[effects(diverge)]\n");
        buf_str(out, c"    fn _exit(code: i32) -> !;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The site of the program's call being run that may allocate (`main.tach:\n");
        buf_str(out, c"// 14:9`, a C string), stored by the compiled program before the call.\n");
        buf_str(out, c"static var CHECK_ALLOC_SITE: *u8 = 0 as *u8;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A block: its pages [start, start + span), its size, its allocator (0:\n");
        buf_str(out, c"// Gpa, else an arena's state), its state, and where it was allocated and\n");
        buf_str(out, c"// freed.\n");
        buf_str(out, c"struct CheckBlock {\n");
        buf_str(out, c"    start: u64,\n");
        buf_str(out, c"    size: i64,\n");
        buf_str(out, c"    span: i64,\n");
        buf_str(out, c"    owner: u64,\n");
        buf_str(out, c"    state: i64,\n");
        buf_str(out, c"    alloc_site: *u8,\n");
        buf_str(out, c"    free_site: *u8,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"const CHECK_LIVE_BLOCK: i64 = 1;\n");
        buf_str(out, c"const CHECK_FREED: i64 = 2;\n");
        buf_str(out, c"const CHECK_RELEASED: i64 = 3;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Every block, in the order allocated (block #N is CHECK_BLOCKS[N - 1]).\n");
        buf_str(out, c"static var CHECK_BLOCKS: *CheckBlock = 0 as *CheckBlock;\n");
        buf_str(out, c"static var CHECK_COUNT: i64 = 0;\n");
        buf_str(out, c"static var CHECK_CAP: i64 = 0;\n");
        buf_str(out, c"// The live blocks of Gpa (arenas' blocks are not counted).\n");
        buf_str(out, c"static var CHECK_LIVE: i64 = 0;\n");
        buf_str(out, c"// The reservations of address space (regions): their bounds and their\n");
        buf_str(out, c"// first block; a region's blocks follow each other (blocks are never\n");
        buf_str(out, c"// placed in an earlier region), so the blocks are sorted by address within\n");
        buf_str(out, c"// one. The cursor is in the last region.\n");
        buf_str(out, c"const CHECK_MAX_REGIONS: i64 = 256;\n");
        buf_str(out, c"static var CHECK_REGION_START: [u64; 256] = [0; 256];\n");
        buf_str(out, c"static var CHECK_REGION_END: [u64; 256] = [0; 256];\n");
        buf_str(out, c"static var CHECK_REGION_FIRST: [i64; 256] = [0; 256];\n");
        buf_str(out, c"static var CHECK_REGIONS: i64 = 0;\n");
        buf_str(out, c"static var CHECK_CURSOR: u64 = 0;\n");
        buf_str(out, c"// The page size, 0 until the first allocation.\n");
        buf_str(out, c"static var CHECK_PAGE: i64 = 0;\n");
        buf_str(out, c"// TACHYON_ALLOC_TRAP; TACHYON_ALLOC_MAX_LIVE (the map limit's message when\n");
        buf_str(out, c"// this many blocks are live: for tests, on any system); 0 when unset.\n");
        buf_str(out, c"static var CHECK_TRAP: i64 = 0;\n");
        buf_str(out, c"static var CHECK_MAX_LIVE: i64 = 0;\n");
        buf_str(out, c"// The changes to the blocks (allocations and frees), and their count when\n");
        buf_str(out, c"// check_leaks listed the leaks (the exit's list is left out then).\n");
        buf_str(out, c"static var CHECK_CHANGES: i64 = 0;\n");
        buf_str(out, c"static var CHECK_LISTED: i64 = -1;\n");
        buf_str(out, c"\n");
        buf_str(out, c"const CHECK_REGION_BYTES: u64 = 68719476736;\n");
        buf_str(out, c"const CHECK_PROT_NONE: i32 = 0;\n");
        buf_str(out, c"const CHECK_PROT_RW: i32 = 3;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The system's constants: macOS (CHECK_ALLOC_OS 0) and Linux (1).\n");
        buf_str(out, c"fn check_map_flags() -> i32 {\n");
        buf_str(out, c"    // MAP_PRIVATE | MAP_ANON | MAP_NORESERVE\n");
        buf_str(out, c"    if CHECK_ALLOC_OS == 1 { 2 | 32 | 16384 } else { 2 | 4096 | 64 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"const CHECK_MAP_FIXED: i32 = 16;\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn check_sigbus() -> i32 {\n");
        buf_str(out, c"    if CHECK_ALLOC_OS == 1 { 7 } else { 10 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// struct sigaction: the handler, then (macOS) a 4-byte mask and the flags,\n");
        buf_str(out, c"// or (glibc) a 128-byte mask and the flags.\n");
        buf_str(out, c"#[repr(C)]\n");
        buf_str(out, c"struct CheckSigaction { handler: extern \"C\" fn(i32, *u8, *u8), words: [u64; 19] }\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn check_sigaction() -> CheckSigaction {\n");
        buf_str(out, c"    var a = CheckSigaction { handler: unsafe { check_alloc_fault }, words: [0; 19] };\n");
        buf_str(out, c"    if CHECK_ALLOC_OS == 1 {\n");
        buf_str(out, c"        // SA_SIGINFO | SA_RESETHAND\n");
        buf_str(out, c"        a.words[16] = 4 | 2147483648;\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        a.words[0] = (64 | 4) << 32;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    a\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The offset of si_addr in siginfo_t.\n");
        buf_str(out, c"fn check_si_addr() -> u64 {\n");
        buf_str(out, c"    if CHECK_ALLOC_OS == 1 { 16 } else { 24 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A message, written to stderr at once.\n");
        buf_str(out, c"struct CheckMsg { len: i64, bytes: [u8; 2048] }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl CheckMsg {\n");
        buf_str(out, c"    fn text(inout self, s: [u8]) {\n");
        buf_str(out, c"        for i in 0..s.len {\n");
        buf_str(out, c"            if self.len < 2048 {\n");
        buf_str(out, c"                self.bytes[self.len] = s[i];\n");
        buf_str(out, c"                self.len += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    unsafe fn cstr(inout self, s: *u8) {\n");
        buf_str(out, c"        var n = 0;\n");
        buf_str(out, c"        while s[n] != 0 {\n");
        buf_str(out, c"            n += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.text(s[0..n]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn int(inout self, v: i64) {\n");
        buf_str(out, c"        if v < 0 {\n");
        buf_str(out, c"            self.text(\"-\");\n");
        buf_str(out, c"            self.int(0 - v);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if v >= 10 {\n");
        buf_str(out, c"            self.int(v / 10);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let d: [u8; 1] = [('0' as i64 + v % 10) as u8];\n");
        buf_str(out, c"        self.text(d[0..1]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn hex(inout self, v: u64) {\n");
        buf_str(out, c"        self.text(\"0x\");\n");
        buf_str(out, c"        let digits = \"0123456789abcdef\";\n");
        buf_str(out, c"        var started = false;\n");
        buf_str(out, c"        for k in 0..16 {\n");
        buf_str(out, c"            let d = (v >> ((15 - k) * 4) as u64) & 15;\n");
        buf_str(out, c"            if d != 0 || started || k == 15 {\n");
        buf_str(out, c"                started = true;\n");
        buf_str(out, c"                self.text(digits[d as i64..d as i64 + 1]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    unsafe fn site(inout self, s: *u8) {\n");
        buf_str(out, c"        if s == 0 as *u8 {\n");
        buf_str(out, c"            self.text(\"an unknown place\");\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.cstr(s);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // `block #N (48 bytes)`, ` of an arena`.\n");
        buf_str(out, c"    fn block(inout self, b: i64) {\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.text(\"block #\");\n");
        buf_str(out, c"            self.int(b + 1);\n");
        buf_str(out, c"            self.text(\" (\");\n");
        buf_str(out, c"            self.int(CHECK_BLOCKS[b].size);\n");
        buf_str(out, c"            self.text(if CHECK_BLOCKS[b].size == 1 { \" byte)\" } else { \" bytes)\" });\n");
        buf_str(out, c"            if CHECK_BLOCKS[b].owner != 0 {\n");
        buf_str(out, c"                self.text(\" of an arena\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn out(inout self) {\n");
        buf_str(out, c"        self.text(\"\\n\");\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            check_write(2, &self.bytes[0], self.len as u64);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn check_msg() -> CheckMsg {\n");
        buf_str(out, c"    CheckMsg { len: 0, bytes: [0; 2048] }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Stops the program with message m (exit 101, without the leaks' list).\n");
        buf_str(out, c"fn check_stop(m: inout CheckMsg) -> ! {\n");
        buf_str(out, c"    m.out();\n");
        buf_str(out, c"    unsafe { _exit(101) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `block #N (48 bytes), allocated at X[, freed at Y]`.\n");
        buf_str(out, c"unsafe fn check_describe(m: *CheckMsg, b: i64) {\n");
        buf_str(out, c"    m.block(b);\n");
        buf_str(out, c"    m.text(\", allocated at \");\n");
        buf_str(out, c"    m.site(CHECK_BLOCKS[b].alloc_site);\n");
        buf_str(out, c"    if CHECK_BLOCKS[b].state != CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"        m.text(if CHECK_BLOCKS[b].state == CHECK_FREED { \", freed at \" } else { \", released at \" });\n");
        buf_str(out, c"        m.site(CHECK_BLOCKS[b].free_site);\n");
        buf_str(out, c"        if CHECK_BLOCKS[b].state == CHECK_RELEASED {\n");
        buf_str(out, c"            m.text(\" (the arena's reset or scope end)\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The decimal number in C string s (0 when null or none).\n");
        buf_str(out, c"unsafe fn check_env_int(name: *u8) -> i64 {\n");
        buf_str(out, c"    let s = getenv(name);\n");
        buf_str(out, c"    if s == 0 as *u8 {\n");
        buf_str(out, c"        return 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var v = 0;\n");
        buf_str(out, c"    var i = 0;\n");
        buf_str(out, c"    while s[i] >= '0' && s[i] <= '9' {\n");
        buf_str(out, c"        v = v * 10 + (s[i] - '0') as i64;\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The first allocation: the page size, the fault handlers, the leaks'\n");
        buf_str(out, c"// list at exit, the environment.\n");
        buf_str(out, c"unsafe fn check_init() {\n");
        buf_str(out, c"    CHECK_PAGE = getpagesize() as i64;\n");
        buf_str(out, c"    let a = check_sigaction();\n");
        buf_str(out, c"    sigaction(11, &a, 0 as *CheckSigaction);\n");
        buf_str(out, c"    sigaction(check_sigbus(), &a, 0 as *CheckSigaction);\n");
        buf_str(out, c"    atexit(check_alloc_at_exit);\n");
        buf_str(out, c"    CHECK_TRAP = check_env_int(c\"TACHYON_ALLOC_TRAP\");\n");
        buf_str(out, c"    CHECK_MAX_LIVE = check_env_int(c\"TACHYON_ALLOC_MAX_LIVE\");\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The system refused to change a block's pages: on Linux, the limit of\n");
        buf_str(out, c"// memory maps (each run of live blocks between freed ones is a map).\n");
        buf_str(out, c"unsafe fn check_map_limit() -> ! {\n");
        buf_str(out, c"    var m = check_msg();\n");
        buf_str(out, c"    m.text(\"check-alloc: out of memory maps at block #\");\n");
        buf_str(out, c"    m.int(CHECK_COUNT + 1);\n");
        buf_str(out, c"    m.text(\", with \");\n");
        buf_str(out, c"    m.int(CHECK_LIVE);\n");
        buf_str(out, c"    m.text(\" blocks live: the kernel's vm.max_map_count is reached (every live block has pages of its own)\");\n");
        buf_str(out, c"    m.text(\"\\ntry: sudo sysctl vm.max_map_count=1048576\");\n");
        buf_str(out, c"    check_stop(&m)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A new region of at least `bytes`, or false.\n");
        buf_str(out, c"unsafe fn check_reserve(bytes: u64) -> bool {\n");
        buf_str(out, c"    if CHECK_REGIONS == CHECK_MAX_REGIONS {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var size = CHECK_REGION_BYTES;\n");
        buf_str(out, c"    while size < bytes {\n");
        buf_str(out, c"        size = size * 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        let p = mmap(0 as *u8, size, CHECK_PROT_NONE, check_map_flags(), -1, 0);\n");
        buf_str(out, c"        if p as i64 != -1 {\n");
        buf_str(out, c"            let r = CHECK_REGIONS;\n");
        buf_str(out, c"            CHECK_REGION_START[r] = p as u64;\n");
        buf_str(out, c"            CHECK_REGION_END[r] = p as u64 + size;\n");
        buf_str(out, c"            CHECK_REGION_FIRST[r] = CHECK_COUNT;\n");
        buf_str(out, c"            CHECK_REGIONS += 1;\n");
        buf_str(out, c"            CHECK_CURSOR = p as u64;\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // (less address space: smaller reservations)\n");
        buf_str(out, c"        if size / 2 < bytes || size <= 1073741824 {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        size = size / 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A new block of size bytes on pages of its own, for allocator owner (0:\n");
        buf_str(out, c"// Gpa), or null when out of memory.\n");
        buf_str(out, c"unsafe fn check_new_block(owner: u64, size: i64) -> *u8 {\n");
        buf_str(out, c"    if CHECK_PAGE == 0 {\n");
        buf_str(out, c"        check_init();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if size < 0 || size > 4611686018427387904 {\n");
        buf_str(out, c"        return 0 as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let page = CHECK_PAGE as u64;\n");
        buf_str(out, c"    let span = (size as u64 + page - 1) / page * page;\n");
        buf_str(out, c"    if CHECK_REGIONS == 0 || CHECK_CURSOR + span > CHECK_REGION_END[CHECK_REGIONS - 1] {\n");
        buf_str(out, c"        if !check_reserve(span) {\n");
        buf_str(out, c"            return 0 as *u8;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_MAX_LIVE > 0 && CHECK_LIVE >= CHECK_MAX_LIVE {\n");
        buf_str(out, c"        check_map_limit();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let p = CHECK_CURSOR as *u8;\n");
        buf_str(out, c"    if mprotect(p, span, CHECK_PROT_RW) != 0 {\n");
        buf_str(out, c"        if CHECK_ALLOC_OS == 1 {\n");
        buf_str(out, c"            check_map_limit();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return 0 as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    CHECK_CURSOR += span;\n");
        buf_str(out, c"    if CHECK_COUNT == CHECK_CAP {\n");
        buf_str(out, c"        CHECK_CAP = if CHECK_CAP == 0 { 1024 } else { CHECK_CAP * 2 };\n");
        buf_str(out, c"        CHECK_BLOCKS = realloc(CHECK_BLOCKS as *u8, (CHECK_CAP * size_of(CheckBlock)) as u64)\n");
        buf_str(out, c"            as *CheckBlock;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    CHECK_BLOCKS[CHECK_COUNT] = CheckBlock {\n");
        buf_str(out, c"        start: p as u64,\n");
        buf_str(out, c"        size: size,\n");
        buf_str(out, c"        span: span as i64,\n");
        buf_str(out, c"        owner: owner,\n");
        buf_str(out, c"        state: CHECK_LIVE_BLOCK,\n");
        buf_str(out, c"        alloc_site: CHECK_ALLOC_SITE,\n");
        buf_str(out, c"        free_site: 0 as *u8,\n");
        buf_str(out, c"    };\n");
        buf_str(out, c"    CHECK_COUNT += 1;\n");
        buf_str(out, c"    CHECK_CHANGES += 1;\n");
        buf_str(out, c"    if owner == 0 {\n");
        buf_str(out, c"        CHECK_LIVE += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_COUNT == CHECK_TRAP {\n");
        buf_str(out, c"        var m = check_msg();\n");
        buf_str(out, c"        m.text(\"check-alloc: \");\n");
        buf_str(out, c"        check_describe(&m, CHECK_COUNT - 1);\n");
        buf_str(out, c"        m.text(\" (TACHYON_ALLOC_TRAP): SIGTRAP\");\n");
        buf_str(out, c"        m.out();\n");
        buf_str(out, c"        raise(5);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    p\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Block b's pages given back, with no access, never used again.\n");
        buf_str(out, c"unsafe fn check_drop_block(b: i64, state: i64) {\n");
        buf_str(out, c"    let p = CHECK_BLOCKS[b].start as *u8;\n");
        buf_str(out, c"    let span = CHECK_BLOCKS[b].span as u64;\n");
        buf_str(out, c"    let flags = check_map_flags() | CHECK_MAP_FIXED;\n");
        buf_str(out, c"    if mmap(p, span, CHECK_PROT_NONE, flags, -1, 0) != p {\n");
        buf_str(out, c"        if CHECK_ALLOC_OS == 1 {\n");
        buf_str(out, c"            check_map_limit();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // (the pages keep their contents, but no access)\n");
        buf_str(out, c"        mprotect(p, span, CHECK_PROT_NONE);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"        CHECK_LIVE -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    CHECK_BLOCKS[b].state = state;\n");
        buf_str(out, c"    CHECK_BLOCKS[b].free_site = CHECK_ALLOC_SITE;\n");
        buf_str(out, c"    CHECK_CHANGES += 1;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The block whose pages hold address a; -1 when a is outside the\n");
        buf_str(out, c"// reservations, -2 when in one but in no block.\n");
        buf_str(out, c"unsafe fn check_find(a: u64) -> i64 {\n");
        buf_str(out, c"    for r in 0..CHECK_REGIONS {\n");
        buf_str(out, c"        if a >= CHECK_REGION_START[r] && a < CHECK_REGION_END[r] {\n");
        buf_str(out, c"            var lo = CHECK_REGION_FIRST[r];\n");
        buf_str(out, c"            var hi = if r + 1 < CHECK_REGIONS { CHECK_REGION_FIRST[r + 1] }\n");
        buf_str(out, c"                else { CHECK_COUNT };\n");
        buf_str(out, c"            // the last block starting at or before a\n");
        buf_str(out, c"            while lo < hi {\n");
        buf_str(out, c"                let mid = (lo + hi) / 2;\n");
        buf_str(out, c"                if CHECK_BLOCKS[mid].start <= a {\n");
        buf_str(out, c"                    lo = mid + 1;\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    hi = mid;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let b = lo - 1;\n");
        buf_str(out, c"            if b >= CHECK_REGION_FIRST[r]\n");
        buf_str(out, c"                && a < CHECK_BLOCKS[b].start + CHECK_BLOCKS[b].span as u64 {\n");
        buf_str(out, c"                return b;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return -2;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    -1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The live block p of `size` bytes from allocator owner, being freed or\n");
        buf_str(out, c"// resized: its index, or the program stops.\n");
        buf_str(out, c"unsafe fn check_owned(p: *u8, size: i64, owner: u64, freeing: bool) -> i64 {\n");
        buf_str(out, c"    let b = check_find(p as u64);\n");
        buf_str(out, c"    var m = check_msg();\n");
        buf_str(out, c"    if b < 0 || CHECK_BLOCKS[b].start != p as u64 {\n");
        buf_str(out, c"        m.text(if freeing { \"invalid free at \" } else { \"invalid resize at \" });\n");
        buf_str(out, c"        m.site(CHECK_ALLOC_SITE);\n");
        buf_str(out, c"        m.text(\": \");\n");
        buf_str(out, c"        m.hex(p as u64);\n");
        buf_str(out, c"        if b >= 0 {\n");
        buf_str(out, c"            m.text(\" is \");\n");
        buf_str(out, c"            m.int((p as u64 - CHECK_BLOCKS[b].start) as i64);\n");
        buf_str(out, c"            m.text(\" bytes into \");\n");
        buf_str(out, c"            check_describe(&m, b);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            m.text(if owner == 0 { \" is not a block of Gpa\" }\n");
        buf_str(out, c"                else { \" is not a block of the arena\" });\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        check_stop(&m);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_BLOCKS[b].state != CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"        m.text(if freeing { \"double free: \" } else { \"resize after free: \" });\n");
        buf_str(out, c"        check_describe(&m, b);\n");
        buf_str(out, c"        m.text(if freeing { \", freed again at \" } else { \", resized at \" });\n");
        buf_str(out, c"        m.site(CHECK_ALLOC_SITE);\n");
        buf_str(out, c"        check_stop(&m);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_BLOCKS[b].owner != owner {\n");
        buf_str(out, c"        m.text(if freeing { \"invalid free at \" } else { \"invalid resize at \" });\n");
        buf_str(out, c"        m.site(CHECK_ALLOC_SITE);\n");
        buf_str(out, c"        m.text(\": \");\n");
        buf_str(out, c"        check_describe(&m, b);\n");
        buf_str(out, c"        m.text(if owner == 0 { \", given to Gpa\" } else { \", given to another allocator\" });\n");
        buf_str(out, c"        check_stop(&m);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if CHECK_BLOCKS[b].size != size {\n");
        buf_str(out, c"        m.text(if freeing { \"wrong-size free: \" } else { \"wrong-size resize: \" });\n");
        buf_str(out, c"        check_describe(&m, b);\n");
        buf_str(out, c"        m.text(if freeing { \", freed as \" } else { \", resized as \" });\n");
        buf_str(out, c"        m.int(size);\n");
        buf_str(out, c"        m.text(if size == 1 { \" byte at \" } else { \" bytes at \" });\n");
        buf_str(out, c"        m.site(CHECK_ALLOC_SITE);\n");
        buf_str(out, c"        check_stop(&m);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    b\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// p (old_size bytes from owner) moved to a new block of new_size bytes, or\n");
        buf_str(out, c"// null (p untouched).\n");
        buf_str(out, c"unsafe fn check_move(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    if old_size == 0 {\n");
        buf_str(out, c"        return check_alloc_block(owner, new_size, align);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let b = check_owned(p, old_size, owner, false);\n");
        buf_str(out, c"    if new_size == 0 {\n");
        buf_str(out, c"        check_drop_block(b, CHECK_FREED);\n");
        buf_str(out, c"        return align as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let q = check_new_block(owner, new_size);\n");
        buf_str(out, c"    if q == 0 as *u8 {\n");
        buf_str(out, c"        return q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    memcpy(q, p, (if old_size < new_size { old_size } else { new_size }) as u64);\n");
        buf_str(out, c"    check_drop_block(b, CHECK_FREED);\n");
        buf_str(out, c"    q\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas, with --check-alloc) A block of size bytes on pages of its own\n");
        buf_str(out, c"// for the allocator whose state is at owner (0: Gpa), or null; size 0: an\n");
        buf_str(out, c"// aligned pointer, no block.\n");
        buf_str(out, c"fn check_alloc_block(owner: u64, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    if size == 0 {\n");
        buf_str(out, c"        return unsafe { align as *u8 };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe { check_new_block(owner, size) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas) p, a block of owner of old_size bytes, moved to new_size bytes.\n");
        buf_str(out, c"unsafe fn check_alloc_moved(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"    -> *u8 {\n");
        buf_str(out, c"    check_move(owner, p, old_size, new_size, align)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas) The blocks allocated so far: a mark for check_alloc_release.\n");
        buf_str(out, c"fn check_alloc_mark() -> i64 {\n");
        buf_str(out, c"    CHECK_COUNT\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas: a reset, a scope's end) Every block of owner allocated after\n");
        buf_str(out, c"// mark is given back: a later access faults.\n");
        buf_str(out, c"fn check_alloc_release(owner: u64, mark: i64) {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        for b in mark..CHECK_COUNT {\n");
        buf_str(out, c"            if CHECK_BLOCKS[b].owner == owner && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"                check_drop_block(b, CHECK_RELEASED);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas) The site of the call being run, and that site set again: a\n");
        buf_str(out, c"// scope's end is reported at the scope's call, not at the last call in it.\n");
        buf_str(out, c"fn check_alloc_site() -> *u8 {\n");
        buf_str(out, c"    unsafe { CHECK_ALLOC_SITE }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn check_alloc_set_site(site: *u8) {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        CHECK_ALLOC_SITE = site;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (Arenas) Whether p starts the last live block of owner: the block an\n");
        buf_str(out, c"// arena grows, or gives back, in place.\n");
        buf_str(out, c"fn check_alloc_is_last(owner: u64, p: *u8) -> bool {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        for k in 0..CHECK_COUNT {\n");
        buf_str(out, c"            let b = CHECK_COUNT - 1 - k;\n");
        buf_str(out, c"            if CHECK_BLOCKS[b].owner == owner && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"                return CHECK_BLOCKS[b].start == p as u64;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (--check-unsafe with --check-alloc) The access of size bytes at p:\n");
        buf_str(out, c"// false when p is no memory of the checking allocator, true when it is in\n");
        buf_str(out, c"// bounds of a live block; else the program stops.\n");
        buf_str(out, c"pub unsafe fn check_alloc_access(p: u64, size: u64, site: *u8) -> bool {\n");
        buf_str(out, c"    let b = check_find(p);\n");
        buf_str(out, c"    if b == -1 {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var m = check_msg();\n");
        buf_str(out, c"    if b >= 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"        if p + size <= CHECK_BLOCKS[b].start + CHECK_BLOCKS[b].size as u64 {\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        m.text(\"unsafe access out of bounds: \");\n");
        buf_str(out, c"    } else if b >= 0 {\n");
        buf_str(out, c"        m.text(\"unsafe access after free: \");\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        m.text(\"unsafe access outside every block: \");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    m.int(size as i64);\n");
        buf_str(out, c"    m.text(if size == 1 { \" byte at \" } else { \" bytes at \" });\n");
        buf_str(out, c"    if b >= 0 {\n");
        buf_str(out, c"        m.text(\"offset \");\n");
        buf_str(out, c"        m.int((p - CHECK_BLOCKS[b].start) as i64);\n");
        buf_str(out, c"        m.text(\" of \");\n");
        buf_str(out, c"        check_describe(&m, b);\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        m.hex(p);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    m.text(\"\\n --> \");\n");
        buf_str(out, c"    m.site(site);\n");
        buf_str(out, c"    check_stop(&m)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// SIGSEGV, SIGBUS: an access to a freed block (or to the pages after the\n");
        buf_str(out, c"// last one) is reported; any other fault happens again with the default\n");
        buf_str(out, c"// action (SA_RESETHAND), as without --check-alloc.\n");
        buf_str(out, c"extern \"C\" fn check_alloc_fault(sig: i32, info: *u8, context: *u8) {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let a = *((info as u64 + check_si_addr()) as *u64);\n");
        buf_str(out, c"        let b = check_find(a);\n");
        buf_str(out, c"        if b == -1 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var m = check_msg();\n");
        buf_str(out, c"        if b >= 0 {\n");
        buf_str(out, c"            m.text(if CHECK_BLOCKS[b].state == CHECK_RELEASED { \"use after release: \" }\n");
        buf_str(out, c"                else { \"use after free: \" });\n");
        buf_str(out, c"            check_describe(&m, b);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            m.text(\"access outside every block: \");\n");
        buf_str(out, c"            m.hex(a);\n");
        buf_str(out, c"            m.text(\" (memory the checking allocator never handed out)\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        check_stop(&m);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The live blocks of Gpa, listed (at most 20).\n");
        buf_str(out, c"unsafe fn check_alloc_list_leaks() {\n");
        buf_str(out, c"    CHECK_LISTED = CHECK_CHANGES;\n");
        buf_str(out, c"    if CHECK_LIVE <= 0 {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var m = check_msg();\n");
        buf_str(out, c"    var bytes = 0;\n");
        buf_str(out, c"    for b in 0..CHECK_COUNT {\n");
        buf_str(out, c"        if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"            bytes += CHECK_BLOCKS[b].size;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    m.text(\"check-alloc: \");\n");
        buf_str(out, c"    m.int(CHECK_LIVE);\n");
        buf_str(out, c"    m.text(if CHECK_LIVE == 1 { \" block\" } else { \" blocks\" });\n");
        buf_str(out, c"    m.text(\" of Gpa not freed (\");\n");
        buf_str(out, c"    m.int(bytes);\n");
        buf_str(out, c"    m.text(\" bytes):\");\n");
        buf_str(out, c"    m.out();\n");
        buf_str(out, c"    var shown = 0;\n");
        buf_str(out, c"    for b in 0..CHECK_COUNT {\n");
        buf_str(out, c"        if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"            if shown == 20 {\n");
        buf_str(out, c"                var more = check_msg();\n");
        buf_str(out, c"                more.text(\"  and \");\n");
        buf_str(out, c"                more.int(CHECK_LIVE - shown);\n");
        buf_str(out, c"                more.text(\" more\");\n");
        buf_str(out, c"                more.out();\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            var line = check_msg();\n");
        buf_str(out, c"            line.text(\"  \");\n");
        buf_str(out, c"            check_describe(&line, b);\n");
        buf_str(out, c"            line.out();\n");
        buf_str(out, c"            shown += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// At exit: the leaks, unless check_leaks listed them and nothing changed\n");
        buf_str(out, c"// since.\n");
        buf_str(out, c"extern \"C\" fn check_alloc_at_exit() {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        if CHECK_LISTED != CHECK_CHANGES {\n");
        buf_str(out, c"            check_alloc_list_leaks();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Allocator for Gpa {\n");
        buf_str(out, c"    fn try_alloc(self: *Gpa, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        check_alloc_block(0, size, align)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    unsafe fn try_resize(self: *Gpa, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        check_move(0, p, old_size, new_size, align)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    unsafe fn free(self: *Gpa, p: *u8, size: i64, align: i64) {\n");
        buf_str(out, c"        if size == 0 && check_find(p as u64) == -1 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        check_drop_block(check_owned(p, size, 0, true), CHECK_FREED);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
    }
}

// (0.20) The end of std's text, after std::CHECK_ALLOC: the target's
// system, sys/linux.tach or sys/macos.tach (front/stdalloc.tach), the
// same length, std_sys_len bytes, so that one index holds for both.
pub fn std_sys_source(out: i64, linux: bool) {
    unsafe {
        if linux {
            buf_str(out, c"// ---- The target's system (0.20) ----\n");
            buf_str(out, c"\n");
            buf_str(out, c"// The end of std's text (front/stdalloc.tach, std_sys_source): what differs\n");
            buf_str(out, c"// between the targets' C libraries, for sys/unix.tach. sys/macos.tach has\n");
            buf_str(out, c"// the same items, in the same order, and the same length to the byte\n");
            buf_str(out, c"// (embed.sh checks it), so that std's index holds for every target; the\n");
            buf_str(out, c"// numbers are written as 8 hex digits for that.\n");
            buf_str(out, c"// (Linux's values, aarch64 glibc: <fcntl.h>, <errno.h>, <time.h>, ioctls\n");
            buf_str(out, c"// <asm/ioctls.h>, <signal.h>; errno: __errno_location().)\n");
            buf_str(out, c"\n");
            buf_str(out, c"// 0: macOS, 1: Linux.\n");
            buf_str(out, c"pub const TARGET_OS: i64 = 0x00000001;\n");
            buf_str(out, c"\n");
            buf_str(out, c"pub const SYS_O_CREAT: i32 = 0x00000040;\n");
            buf_str(out, c"pub const SYS_O_TRUNC: i32 = 0x00000200;\n");
            buf_str(out, c"pub const SYS_O_APPEND: i32 = 0x00000400;\n");
            buf_str(out, c"pub const SYS_O_EXCL: i32 = 0x00000080;\n");
            buf_str(out, c"pub const SYS_O_NONBLOCK: i32 = 0x00000800;\n");
            buf_str(out, c"pub const SYS_O_CLOEXEC: i32 = 0x00080000;\n");
            buf_str(out, c"pub const SYS_O_NOCTTY: i32 = 0x00000100;\n");
            buf_str(out, c"pub const SYS_O_DIRECTORY: i32 = 0x00004000;\n");
            buf_str(out, c"\n");
            buf_str(out, c"pub const SYS_EAGAIN: i32 = 0x0000000b;\n");
            buf_str(out, c"pub const SYS_ENOTEMPTY: i32 = 0x00000027;\n");
            buf_str(out, c"pub const SYS_ETIMEDOUT: i32 = 0x0000006e;\n");
            buf_str(out, c"pub const SYS_ENOSYS: i32 = 0x00000026;\n");
            buf_str(out, c"pub const SYS_ENOTSUP: i32 = 0x0000005f;\n");
            buf_str(out, c"pub const SYS_ENAMETOOLONG: i32 = 0x00000024;\n");
            buf_str(out, c"pub const SYS_ELOOP: i32 = 0x00000028;\n");
            buf_str(out, c"\n");
            buf_str(out, c"pub const SYS_CLOCK_MONOTONIC: i32 = 0x00000001;\n");
            buf_str(out, c"pub const SYS_PATH_MAX: i64 = 0x00001000;\n");
            buf_str(out, c"pub const SYS_SIGCHLD: i32 = 0x00000011;\n");
            buf_str(out, c"pub const SYS_TIOCSWINSZ: u64 = 0x00005414;\n");
            buf_str(out, c"pub const SYS_TIOCGWINSZ: u64 = 0x00005413;\n");
            buf_str(out, c"pub const SYS_TIOCSCTTY: u64 = 0x0000540e;\n");
            buf_str(out, c"\n");
            buf_str(out, c"extern \"C\" {\n");
            buf_str(out, c"    #[link_name = \"__errno_location\"]\n");
            buf_str(out, c"    #[effects(global)]\n");
            buf_str(out, c"    fn sys_errno_location() -> *i32;\n");
            buf_str(out, c"}\n");
            buf_str(out, c"\n");
            buf_str(out, c"// (0.20) The program's arguments (std::env::args): argc, and argv, its C\n");
            buf_str(out, c"// strings. Linux: /proc/self/cmdline, read once (up to 128 KB and 4096\n");
            buf_str(out, c"// arguments) into std's statics, its NULs ending each argument.\n");
            buf_str(out, c"static mut SYS_ARG_TEXT: [u8; 131072] = [0; 131072];\n");
            buf_str(out, c"static mut SYS_ARG_PTRS: [*u8; 4097] = [0 as *u8; 4097];\n");
            buf_str(out, c"static mut SYS_ARG_COUNT: i64 = -1;\n");
            buf_str(out, c"\n");
            buf_str(out, c"pub fn sys_args() -> (i64, **u8) {\n");
            buf_str(out, c"    if SYS_ARG_COUNT < 0 {\n");
            buf_str(out, c"        SYS_ARG_COUNT = 0;\n");
            buf_str(out, c"        var len = 0;\n");
            buf_str(out, c"        match std::sys::sys_open(\"/proc/self/cmdline\", 0, 0) {\n");
            buf_str(out, c"            Ok(fd) => {\n");
            buf_str(out, c"                loop {\n");
            buf_str(out, c"                    let n = match std::sys::sys_read(fd, &SYS_ARG_TEXT[len..131071]) {\n");
            buf_str(out, c"                        Ok(n) => n,\n");
            buf_str(out, c"                        Err(_) => 0,\n");
            buf_str(out, c"                    };\n");
            buf_str(out, c"                    if n <= 0 {\n");
            buf_str(out, c"                        break;\n");
            buf_str(out, c"                    }\n");
            buf_str(out, c"                    len += n;\n");
            buf_str(out, c"                }\n");
            buf_str(out, c"                let _ = std::sys::sys_close(fd);\n");
            buf_str(out, c"            }\n");
            buf_str(out, c"            Err(_) => {}\n");
            buf_str(out, c"        }\n");
            buf_str(out, c"        var start = 0;\n");
            buf_str(out, c"        for i in 0..len {\n");
            buf_str(out, c"            if SYS_ARG_TEXT[i] == 0 && SYS_ARG_COUNT < 4096 {\n");
            buf_str(out, c"                SYS_ARG_PTRS[SYS_ARG_COUNT] = &SYS_ARG_TEXT[start] as *u8;\n");
            buf_str(out, c"                SYS_ARG_COUNT += 1;\n");
            buf_str(out, c"                start = i + 1;\n");
            buf_str(out, c"            }\n");
            buf_str(out, c"        }\n");
            buf_str(out, c"    }\n");
            buf_str(out, c"    (SYS_ARG_COUNT, &SYS_ARG_PTRS[0] as **u8)\n");
            buf_str(out, c"}\n");
            buf_str(out, c"// (padding: the two systems' files are the same length)---------------\n");
        } else {
            buf_str(out, c"// ---- The target's system (0.20) ----\n");
            buf_str(out, c"\n");
            buf_str(out, c"// The end of std's text (front/stdalloc.tach, std_sys_source): what differs\n");
            buf_str(out, c"// between the targets' C libraries, for sys/unix.tach. sys/linux.tach has\n");
            buf_str(out, c"// the same items, in the same order, and the same length to the byte\n");
            buf_str(out, c"// (embed.sh checks it), so that std's index holds for every target; the\n");
            buf_str(out, c"// numbers are written as 8 hex digits for that.\n");
            buf_str(out, c"// (macOS's values: <sys/fcntl.h>, <sys/errno.h>, <time.h>, <sys/ttycom.h>,\n");
            buf_str(out, c"// <sys/signal.h>; errno is the int that __error() points to, C.)\n");
            buf_str(out, c"\n");
            buf_str(out, c"// 0: macOS, 1: Linux.\n");
            buf_str(out, c"pub const TARGET_OS: i64 = 0x00000000;\n");
            buf_str(out, c"\n");
            buf_str(out, c"pub const SYS_O_CREAT: i32 = 0x00000200;\n");
            buf_str(out, c"pub const SYS_O_TRUNC: i32 = 0x00000400;\n");
            buf_str(out, c"pub const SYS_O_APPEND: i32 = 0x00000008;\n");
            buf_str(out, c"pub const SYS_O_EXCL: i32 = 0x00000800;\n");
            buf_str(out, c"pub const SYS_O_NONBLOCK: i32 = 0x00000004;\n");
            buf_str(out, c"pub const SYS_O_CLOEXEC: i32 = 0x01000000;\n");
            buf_str(out, c"pub const SYS_O_NOCTTY: i32 = 0x00020000;\n");
            buf_str(out, c"pub const SYS_O_DIRECTORY: i32 = 0x00100000;\n");
            buf_str(out, c"\n");
            buf_str(out, c"pub const SYS_EAGAIN: i32 = 0x00000023;\n");
            buf_str(out, c"pub const SYS_ENOTEMPTY: i32 = 0x00000042;\n");
            buf_str(out, c"pub const SYS_ETIMEDOUT: i32 = 0x0000003c;\n");
            buf_str(out, c"pub const SYS_ENOSYS: i32 = 0x0000004e;\n");
            buf_str(out, c"pub const SYS_ENOTSUP: i32 = 0x0000002d;\n");
            buf_str(out, c"pub const SYS_ENAMETOOLONG: i32 = 0x0000003f;\n");
            buf_str(out, c"pub const SYS_ELOOP: i32 = 0x0000003e;\n");
            buf_str(out, c"\n");
            buf_str(out, c"pub const SYS_CLOCK_MONOTONIC: i32 = 0x00000006;\n");
            buf_str(out, c"pub const SYS_PATH_MAX: i64 = 0x00000400;\n");
            buf_str(out, c"pub const SYS_SIGCHLD: i32 = 0x00000014;\n");
            buf_str(out, c"pub const SYS_TIOCSWINSZ: u64 = 0x80087467;\n");
            buf_str(out, c"pub const SYS_TIOCGWINSZ: u64 = 0x40087468;\n");
            buf_str(out, c"pub const SYS_TIOCSCTTY: u64 = 0x20007461;\n");
            buf_str(out, c"\n");
            buf_str(out, c"extern \"C\" {\n");
            buf_str(out, c"    #[link_name = \"__error\"]\n");
            buf_str(out, c"    #[effects(global)]\n");
            buf_str(out, c"    fn sys_errno_location() -> *i32;\n");
            buf_str(out, c"}\n");
            buf_str(out, c"\n");
            buf_str(out, c"// (0.20) The program's arguments (std::env::args): argc, and argv, its C\n");
            buf_str(out, c"// strings. macOS: crt's own, which _NSGetArgc and _NSGetArgv point to.\n");
            buf_str(out, c"pub fn sys_args() -> (i64, **u8) {\n");
            buf_str(out, c"    // (libSystem's pointers to crt's argc and argv, set before main)\n");
            buf_str(out, c"    unsafe { (*sys_argc_location() as i64, *sys_argv_location()) }\n");
            buf_str(out, c"}\n");
            buf_str(out, c"\n");
            buf_str(out, c"extern \"C\" {\n");
            buf_str(out, c"    #[link_name = \"_NSGetArgc\"]\n");
            buf_str(out, c"    #[effects(global)]\n");
            buf_str(out, c"    fn sys_argc_location() -> *i32;\n");
            buf_str(out, c"    #[link_name = \"_NSGetArgv\"]\n");
            buf_str(out, c"    #[effects(global)]\n");
            buf_str(out, c"    fn sys_argv_location() -> ***u8;\n");
            buf_str(out, c"}\n");
            buf_str(out, c"// (padding: the two systems' files are the same length)\n");
            buf_str(out, c"//----------------------------------------------------------------------------\n");
            buf_str(out, c"//----------------------------------------------------------------------------\n");
            buf_str(out, c"//----------------------------------------------------------------------------\n");
            buf_str(out, c"//----------------------------------------------------------------------------\n");
            buf_str(out, c"//----------------------------------------------------------------------------\n");
            buf_str(out, c"//----------------------------------------------------------------------------\n");
            buf_str(out, c"//----------------------------------------------------------------------------\n");
            buf_str(out, c"//----------------------------------------------------------------------------\n");
            buf_str(out, c"//----------------------------------------------------------------------------\n");
            buf_str(out, c"//----------------------------------------------------------------------------\n");
            buf_str(out, c"//--------------------------\n");
        }
    }
}

pub fn std_sys_len() -> i64 {
    2987
}

