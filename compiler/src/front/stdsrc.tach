    unsafe {
        buf_str(out, c"0 std.tach\n23943 flat/iter.tach\n24859 flat/io.tach\n32719 flat/fmt.tach\n37453 flat/convert.tach\n40039 flat/clone.tach\n50560 flat/alloc.tach\n80045 flat/values.tach\n82864 flat/test.tach\n105821 flat/nonnull.tach\n107076 flat/fuzz.tach\n118536 flat/collections.tach\n132024 flat/arch.tach\n143189 ops.tach\n143928 iter.tach\n162962 slice.tach\n182823 slice/unstable.tach\n196672 slice/stable.tach\n221487 slice/search.tach\n223911 slice/algo.tach\n230284 collections/mod.tach\n230830 collections/hash_map.tach\n237814 collections/hash_set.tach\n241256 collections/raw_table.tach\n267269 collections/btree_node.tach\n297073 collections/btree_map.tach\n307541 collections/group.tach\n311735 io.tach\n315212 io/error.tach\n321377 io/buffered.tach\n333672 fmt.tach\n359484 num.tach\n404010 num/tables.tach\n436281 convert.tach\n436599 clone.tach\n436844 random.tach\n443951 sys.tach\n480487 time.tach\n490001 hash/mod.tach\n490823 hash/fold.tach\n501274 hash/sip.tach\n505369 hash/state.tach\n509133 str.tach\n545356 unicode/mod.tach\n565727 unicode/tables.tach\n675971 string.tach\n714592 path.tach\n722882 fs.tach\n736147 env.tach\n741933 process.tach\n753511\n");
