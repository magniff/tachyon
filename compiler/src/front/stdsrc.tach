        buf_str(out, c"    0x82cca4db847945ca, 0x50d98d9fc890ed4d,\n");
        buf_str(out, c"    0xa37fce126597973c, 0xe50ff107bab528a0,\n");
        buf_str(out, c"    0xcc5fc196fefd7d0c, 0x1e53ed49a96272c8,\n");
        buf_str(out, c"    0xff77b1fcbebcdc4f, 0x25e8e89c13bb0f7a,\n");
        buf_str(out, c"    0x9faacf3df73609b1, 0x77b191618c54e9ac,\n");
        buf_str(out, c"    0xc795830d75038c1d, 0xd59df5b9ef6a2417,\n");
