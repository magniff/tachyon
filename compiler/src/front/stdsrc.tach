// Generated by compiler/std/embed.sh from compiler/std/ (std.tach, the
// files appended to it and std's modules), gpa.tach and alloc_check.tach
// (do not edit): the standard library's source (0.5), read when a
// program names `std` (modules.tach).

use crate::base::buf_str;
use crate::front::stdalloc::std_alloc_tail;

pub fn std_source(out: i64) {
    unsafe {
        buf_str(out, c"// The standard library (0.5): the module `std`, built into the compiler\n");
        buf_str(out, c"// (compiler/std/embed.sh makes compiler/src/front/stdsrc.tach from this file,\n");
        buf_str(out, c"// the files it appends and std's modules, std::gpu among them (0.22)). A\n");
        buf_str(out, c"// program that names `std` gets it: `std::Vec<i64>`, `use std::{Buf, Vec};`.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// This file, the core: Option and Result, a growable vector, a byte\n");
        buf_str(out, c"// buffer, the operator traits, sorting and a hash map.\n");
        buf_str(out, c"// Failures (unwrapping None, an index out of bounds) print a message on\n");
        buf_str(out, c"// stderr and exit with 101, like the language's own checks.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Allocation (0.16): Vec, Buf and HashMap take their memory from an\n");
        buf_str(out, c"// allocator, a type parameter (`Vec<T, A: Allocator = Gpa>`, alloc.tach),\n");
        buf_str(out, c"// every growth and free through it.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Unsafe code (0.9): the safe functions here have no undefined behaviour\n");
        buf_str(out, c"// as long as a Vec's and a Buf's fields are changed by their methods only\n");
        buf_str(out, c"// (0.16: #[sealed], checked from 0.16's T2), and a slice from `as_slice` (or a\n");
        buf_str(out, c"// HashMap's `get_mut`, `get_or_insert`) is not used after the Vec grows\n");
        buf_str(out, c"// (the map gets a new key) or is freed. The functions taking C strings\n");
        buf_str(out, c"// are `unsafe fn`: the string must end with a NUL.\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub mod ops;\n");
        buf_str(out, c"pub mod iter;\n");
        buf_str(out, c"pub mod slice;\n");
        buf_str(out, c"pub mod collections;\n");
        buf_str(out, c"pub mod io;\n");
        buf_str(out, c"pub mod fmt;\n");
        buf_str(out, c"pub mod num;\n");
        buf_str(out, c"pub mod convert;\n");
        buf_str(out, c"pub mod clone;\n");
        buf_str(out, c"pub mod random;\n");
        buf_str(out, c"pub mod sys;\n");
        buf_str(out, c"pub mod time;\n");
        buf_str(out, c"pub mod hash;\n");
        buf_str(out, c"pub mod str;\n");
        buf_str(out, c"pub mod unicode;\n");
        buf_str(out, c"pub mod gpu;\n");
        buf_str(out, c"pub mod string;\n");
        buf_str(out, c"pub mod path;\n");
        buf_str(out, c"pub mod fs;\n");
        buf_str(out, c"pub mod env;\n");
        buf_str(out, c"pub mod process;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub use clone::Clone;\n");
        buf_str(out, c"pub use collections::{BTreeMap, BTreeSet, HashMap, HashSet};\n");
        buf_str(out, c"pub use convert::{From, Into};\n");
        buf_str(out, c"use fmt::{fmt_quoted, fmt_signed};\n");
        buf_str(out, c"pub use fmt::{\n");
        buf_str(out, c"    Debug, Display, Fmt, FmtSpec, Interp, __buf_fmt, __buf_fmt_end, __fmt_in_end, __fmt_tmp,\n");
        buf_str(out, c"    debug_list, eprint, eprintln, format, format_in, print, print_cstr, print_int, println,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"pub use io::{read_line, read_stdin_in};\n");
        buf_str(out, c"pub use iter::{\n");
        buf_str(out, c"    Enumerate, Filter, HashMapIter, Iterator, Keys, Map, Range, RangeInclusive, SliceIter,\n");
        buf_str(out, c"    SliceRefIter, Take, Values, Zip, sort_by,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"pub use num::{\n");
        buf_str(out, c"    I16_MAX, I16_MIN, I32_MAX, I32_MIN, I64_MAX, I64_MIN, I8_MAX, I8_MIN, U16_MAX, U32_MAX, U64_MAX,\n");
        buf_str(out, c"    U8_MAX, count_ones, leading_zeros, trailing_zeros,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"pub use ops::{Add, Div, Mul, Neg, Sub};\n");
        buf_str(out, c"use slice::{swap_at, swap_raw};\n");
        buf_str(out, c"pub use slice::{sort, sort_stable, sort_stable_by, sort_stable_by_in, sort_stable_in};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.16) Their effects declared: allocation, I/O, none.\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[effects(alloc(extern))]\n");
        buf_str(out, c"    fn malloc(size: u64) -> *u8;\n");
        buf_str(out, c"    #[effects(alloc(extern))]\n");
        buf_str(out, c"    fn realloc(p: *u8, size: u64) -> *u8;\n");
        buf_str(out, c"    #[effects(alloc(extern))]\n");
        buf_str(out, c"    fn free(p: *u8);\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn write(fd: i32, data: *u8, count: u64) -> i64;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn read(fd: i32, data: *u8, count: u64) -> i64;\n");
        buf_str(out, c"    #[effects(io, diverge)]\n");
        buf_str(out, c"    fn exit(code: i32) -> !;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn memcpy(dst: *u8, src: *u8, n: u64) -> *u8;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn strlen(s: *u8) -> u64;\n");
        buf_str(out, c"    // (0.16) What std's panic calls: its effect is `panic`, not the io of\n");
        buf_str(out, c"    // writing a message and exiting (docs/design/effects-allocation.md\n");
        buf_str(out, c"    // §2.2).\n");
        buf_str(out, c"    #[link_name = \"write\"]\n");
        buf_str(out, c"    #[effects(panic)]\n");
        buf_str(out, c"    fn panic_write(fd: i32, data: *u8, count: u64) -> i64;\n");
        buf_str(out, c"    #[link_name = \"exit\"]\n");
        buf_str(out, c"    #[effects(panic)]\n");
        buf_str(out, c"    fn panic_exit(code: i32) -> !;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Prints `message` (a C string) on stderr and exits with 101.\n");
        buf_str(out, c"pub unsafe fn panic(message: *u8) -> ! {\n");
        buf_str(out, c"    panic_write(2, message, strlen(message));\n");
        buf_str(out, c"    panic_write(2, c\"\\n\", 1);\n");
        buf_str(out, c"    panic_note();\n");
        buf_str(out, c"    panic_exit(101)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.17) The line after a failure's message; a program built with\n");
        buf_str(out, c"// --trace prints the calls that led to the failure instead (the compiler\n");
        buf_str(out, c"// makes this call one of its trace runtime's, compiler/src/middle/trace.tach).\n");
        buf_str(out, c"// (0.18) Without --trace, nothing: a failure is one line.\n");
        buf_str(out, c"fn panic_note() {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Option and Result ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub enum Option<T> { None, Some(T) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Option<T> {\n");
        buf_str(out, c"    pub fn is_some(self) -> bool {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(_) => true,\n");
        buf_str(out, c"            Option::None => false,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_none(self) -> bool {\n");
        buf_str(out, c"        !self.is_some()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap(sink self) -> T\n");
        buf_str(out, c"        requires self.is_some() else \"called unwrap on None\"\n");
        buf_str(out, c"    {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => x,\n");
        buf_str(out, c"            Option::None => unsafe { panic(c\"called unwrap on None\") },\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap_or(sink self, other: sink T) -> T {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => x,\n");
        buf_str(out, c"            Option::None => other,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub enum Result<T, E> { Ok(T), Err(E) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, E> Result<T, E> {\n");
        buf_str(out, c"    pub fn is_ok(self) -> bool {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(_) => true,\n");
        buf_str(out, c"            Result::Err(_) => false,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_err(self) -> bool {\n");
        buf_str(out, c"        !self.is_ok()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap(sink self) -> T\n");
        buf_str(out, c"        requires self.is_ok() else \"called unwrap on Err\"\n");
        buf_str(out, c"    {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => x,\n");
        buf_str(out, c"            Result::Err(_) => unsafe { panic(c\"called unwrap on Err\") },\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap_or(sink self, other: sink T) -> T {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => x,\n");
        buf_str(out, c"            Result::Err(_) => other,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn ok(sink self) -> Option<T> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => Option::Some(x),\n");
        buf_str(out, c"            Result::Err(_) => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Vec ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A growable vector of T, its memory from allocator A (0.16; Gpa, C's\n");
        buf_str(out, c"// malloc, by default); `free` gives its memory back.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct Vec<T, A: Allocator = Gpa> { ptr: *T, len: i64, cap: i64, alloc: A }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // An empty Vec on allocator a (0.16).\n");
        buf_str(out, c"    pub fn new_in(a: sink A) -> Vec<T, A> {\n");
        buf_str(out, c"        Vec { ptr: 0 as *T, len: 0, cap: 0, alloc: a }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An empty Vec on allocator a with room for cap elements (0.16).\n");
        buf_str(out, c"    pub fn with_capacity_in(cap: i64, a: sink A) -> Vec<T, A> {\n");
        buf_str(out, c"        var v: Vec<T, A> = Vec::new_in(a);\n");
        buf_str(out, c"        v.reserve(cap);\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn len(self) -> i64 {\n");
        buf_str(out, c"        self.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_empty(self) -> bool {\n");
        buf_str(out, c"        self.len == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Room for `extra` more elements.\n");
        buf_str(out, c"    pub fn reserve(inout self, extra: i64) {\n");
        buf_str(out, c"        if extra > self.cap - self.len && !self.reserve_more(extra) {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Grows to room for `extra` (more than it has) more elements: twice the\n");
        buf_str(out, c"    // capacity, or more when needed; false when out of memory.\n");
        buf_str(out, c"    #[inline(never)]\n");
        buf_str(out, c"    fn reserve_more(inout self, extra: i64) -> bool {\n");
        buf_str(out, c"        if extra > ALLOC_LIMIT - self.len {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let cap = grown_cap(self.cap, self.len + extra);\n");
        buf_str(out, c"        let bytes = alloc_bytes(cap, size_of(T));\n");
        buf_str(out, c"        if bytes < 0 {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let p = unsafe {\n");
        buf_str(out, c"            self.alloc.try_resize(self.ptr as *u8, self.cap * size_of(T), bytes, align_of(T))\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        if p == 0 as *u8 {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.ptr = p as *T;\n");
        buf_str(out, c"        self.cap = cap;\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Appends the elements of s, which may be a view of this Vec: when it\n");
        buf_str(out, c"    // grows, the elements are copied to the new memory before the old is\n");
        buf_str(out, c"    // freed.\n");
        buf_str(out, c"    #[stores(*s)]\n");
        buf_str(out, c"    pub fn extend_from_slice(inout self, s: [T]) {\n");
        buf_str(out, c"        let n = s.len;\n");
        buf_str(out, c"        var old = 0 as *T;\n");
        buf_str(out, c"        var old_cap = 0;\n");
        buf_str(out, c"        if n > self.cap - self.len {\n");
        buf_str(out, c"            var cap = -1;\n");
        buf_str(out, c"            if n <= ALLOC_LIMIT - self.len {\n");
        buf_str(out, c"                cap = grown_cap(self.cap, self.len + n);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let bytes = alloc_bytes(cap, size_of(T));\n");
        buf_str(out, c"            if bytes < 0 {\n");
        buf_str(out, c"                out_of_memory();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            old = self.ptr;\n");
        buf_str(out, c"            old_cap = self.cap;\n");
        buf_str(out, c"            let p = self.alloc.try_alloc(bytes, align_of(T));\n");
        buf_str(out, c"            if p == 0 as *u8 {\n");
        buf_str(out, c"                out_of_memory();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                self.ptr = p as *T;\n");
        buf_str(out, c"                for i in 0..self.len {\n");
        buf_str(out, c"                    self.ptr[i] = old[i];\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.cap = cap;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for i in 0..n {\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                self.ptr[self.len + i] = s[i];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len += n;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.alloc.free(old as *u8, old_cap * size_of(T), align_of(T));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[stores(x)]\n");
        buf_str(out, c"    pub fn push(inout self, x: sink T) {\n");
        buf_str(out, c"        if self.len == self.cap && !self.reserve_more(1) {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.ptr[self.len] = x;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn pop(inout self) -> Option<T> {\n");
        buf_str(out, c"        if self.len == 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len -= 1;\n");
        buf_str(out, c"        Option::Some(unsafe { self.ptr[self.len] })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Element i (checked: out of bounds exits with 101).\n");
        buf_str(out, c"    pub fn get(self, i: i64) -> T\n");
        buf_str(out, c"        requires 0 <= i && i < self.len else f\"index out of bounds: index {i}, length {self.len}\"\n");
        buf_str(out, c"    {\n");
        buf_str(out, c"        self.as_slice()[i]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[stores(x)]\n");
        buf_str(out, c"    pub fn set(inout self, i: i64, x: sink T)\n");
        buf_str(out, c"        requires 0 <= i && i < self.len else f\"index out of bounds: index {i}, length {self.len}\"\n");
        buf_str(out, c"    {\n");
        buf_str(out, c"        self.as_mut_slice()[i] = x;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The last element, if there is one (the Vec keeps it; `pop` takes it).\n");
        buf_str(out, c"    pub fn last(self) -> Option<T> {\n");
        buf_str(out, c"        if self.len == 0 { Option::None } else { Option::Some(self.get(self.len - 1)) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Exchanges elements i and j (checked).\n");
        buf_str(out, c"    pub fn swap(inout self, i: i64, j: i64)\n");
        buf_str(out, c"        requires 0 <= i && i < self.len else f\"index out of bounds: index {i}, length {self.len}\"\n");
        buf_str(out, c"        requires 0 <= j && j < self.len else f\"index out of bounds: index {j}, length {self.len}\"\n");
        buf_str(out, c"    {\n");
        buf_str(out, c"        swap_at::<T>(self.as_mut_slice(), i, j);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Puts x at index i, 0 to len (checked), moving the elements from i\n");
        buf_str(out, c"    // on up by one.\n");
        buf_str(out, c"    #[stores(x)]\n");
        buf_str(out, c"    pub fn insert(inout self, i: i64, x: sink T)\n");
        buf_str(out, c"        requires 0 <= i && i <= self.len\n");
        buf_str(out, c"        else f\"Vec::insert: index {i} out of bounds, length {self.len}\"\n");
        buf_str(out, c"        {\n");
        buf_str(out, c"        if i < 0 || i > self.len {\n");
        buf_str(out, c"            unsafe { panic(c\"Vec::insert: index out of bounds\") }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.reserve(1);\n");
        buf_str(out, c"        // (0.17: the elements moved up as bits, not as values)\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let p = self.ptr;\n");
        buf_str(out, c"            let last = self.len;\n");
        buf_str(out, c"            for d in 0..last - i {\n");
        buf_str(out, c"                let k = last - d;\n");
        buf_str(out, c"                p[k] = p[k - 1];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            p[i] = x;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Takes element i out (checked) and returns it, moving the elements\n");
        buf_str(out, c"    // after it down by one.\n");
        buf_str(out, c"    pub fn remove(inout self, i: i64) -> T\n");
        buf_str(out, c"        requires 0 <= i && i < self.len else f\"index out of bounds: index {i}, length {self.len}\"\n");
        buf_str(out, c"    {\n");
        buf_str(out, c"        // (checked; 0.17: the elements moved down as bits, not as values)\n");
        buf_str(out, c"        let at: *T = &self.as_slice()[i];\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let x = *at;\n");
        buf_str(out, c"            let p = self.ptr;\n");
        buf_str(out, c"            for k in i..self.len - 1 {\n");
        buf_str(out, c"                p[k] = p[k + 1];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.len -= 1;\n");
        buf_str(out, c"            x\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Keeps the first n elements (all of them when there are fewer); 0.17:\n");
        buf_str(out, c"    // the others are dropped.\n");
        buf_str(out, c"    pub fn truncate(inout self, n: i64) {\n");
        buf_str(out, c"        if n >= 0 && n < self.len {\n");
        buf_str(out, c"            let len = self.len;\n");
        buf_str(out, c"            self.len = n;\n");
        buf_str(out, c"            if needs_drop::<T>() {\n");
        buf_str(out, c"                for i in n..len {\n");
        buf_str(out, c"                    drop(unsafe { self.ptr[i] });\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements, a view (0.17: valid while the Vec is not changed).\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn as_slice(self) -> [T] {\n");
        buf_str(out, c"        unsafe { self.ptr[0..self.len] }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements, to change in place (0.17): `sort(v.as_mut_slice())`.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn as_mut_slice(inout self) -> inout [T] {\n");
        buf_str(out, c"        unsafe { &self.ptr[0..self.len] }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Drops the elements (0.17); the room stays.\n");
        buf_str(out, c"    pub fn clear(inout self) {\n");
        buf_str(out, c"        self.truncate(0);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements dropped and its memory given back; it is left empty, to\n");
        buf_str(out, c"    // use again (0.17: a Vec is dropped at the end of its scope without\n");
        buf_str(out, c"    // it; `self.items.free()` through a reference still works, and a\n");
        buf_str(out, c"    // second free frees nothing).\n");
        buf_str(out, c"    pub fn free(inout self) {\n");
        buf_str(out, c"        self.release();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements, in a Vec on the same allocator; it is left empty\n");
        buf_str(out, c"    // (0.17: `std::take` for a container, which keeps its allocator).\n");
        buf_str(out, c"    pub fn take(inout self) -> Vec<T, A> {\n");
        buf_str(out, c"        let empty: Vec<T, A> = Vec::new_in(self.alloc);\n");
        buf_str(out, c"        replace(&self, empty)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The elements dropped and the memory given back: empty, with no memory\n");
        buf_str(out, c"    // (0.17: drop and free).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn release(inout self) {\n");
        buf_str(out, c"        self.truncate(0);\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.alloc.free(self.ptr as *u8, self.cap * size_of(T), align_of(T));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.ptr = 0 as *T;\n");
        buf_str(out, c"        self.cap = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.17) A Vec's drop: its elements' drops, then its memory given back.\n");
        buf_str(out, c"impl<T, A: Allocator> Drop for Vec<T, A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn drop(inout self) {\n");
        buf_str(out, c"        self.release();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.16) The ambient constructors of 0.15, errors outside std: allocation\n");
        buf_str(out, c"// is explicit (front/ambient.tach; fix --only alloc016 reads them).\n");
        buf_str(out, c"impl<T, A: Allocator + Ambient> Vec<T, A> {\n");
        buf_str(out, c"    #[ambient(\"Vec::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> Vec<T, A> {\n");
        buf_str(out, c"        Vec { ptr: 0 as *T, len: 0, cap: 0, alloc: A::ambient() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"Vec::with_capacity_in(cap, gpa)\")]\n");
        buf_str(out, c"    pub fn with_capacity(cap: i64) -> Vec<T, A> {\n");
        buf_str(out, c"        Vec::with_capacity_in(cap, A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"Vec::filled_in(n, x, gpa)\")]\n");
        buf_str(out, c"    pub fn filled(n: i64, x: sink T) -> Vec<T, A> {\n");
        buf_str(out, c"        Vec::filled_in(n, x, A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Vec's room and allocator (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // The elements it has room for (0.16).\n");
        buf_str(out, c"    pub fn capacity(self) -> i64 {\n");
        buf_str(out, c"        self.cap\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its allocator (0.16): a copy of the handle.\n");
        buf_str(out, c"    pub fn allocator(self) -> A {\n");
        buf_str(out, c"        self.alloc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Room for `extra` more elements, or Err when out of memory, the Vec\n");
        buf_str(out, c"    // as it was (0.16).\n");
        buf_str(out, c"    pub fn try_reserve(inout self, extra: i64) -> Result<(), AllocError> {\n");
        buf_str(out, c"        if extra > self.cap - self.len && !self.reserve_more(extra) {\n");
        buf_str(out, c"            return Result::Err(AllocError::OutOfMemory);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Result::Ok(())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // push, or Err when out of memory, the Vec as it was (0.16).\n");
        buf_str(out, c"    #[stores(x)]\n");
        buf_str(out, c"    pub fn try_push(inout self, x: sink T) -> Result<(), AllocError> {\n");
        buf_str(out, c"        if self.len == self.cap && !self.reserve_more(1) {\n");
        buf_str(out, c"            return Result::Err(AllocError::OutOfMemory);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.ptr[self.len] = x;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len += 1;\n");
        buf_str(out, c"        Result::Ok(())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Buf ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A growable buffer of bytes, for building text (0.16: on allocator A).\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct Buf<A: Allocator = Gpa> { bytes: Vec<u8, A> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Buf<A> {\n");
        buf_str(out, c"    // An empty Buf on allocator a (0.16).\n");
        buf_str(out, c"    pub fn new_in(a: sink A) -> Buf<A> {\n");
        buf_str(out, c"        Buf { bytes: Vec::new_in(a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn len(self) -> i64 {\n");
        buf_str(out, c"        self.bytes.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn push(inout self, b: u8) {\n");
        buf_str(out, c"        self.bytes.push(b);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Appends s, which may be a view of this Buf.\n");
        buf_str(out, c"    pub fn push_str(inout self, s: [u8]) {\n");
        buf_str(out, c"        self.bytes.extend_from_slice(s);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A C string (up to its NUL).\n");
        buf_str(out, c"    pub unsafe fn push_cstr(inout self, s: *u8) {\n");
        buf_str(out, c"        self.bytes.extend_from_slice(s[0..strlen(s) as i64]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The decimal digits of v.\n");
        buf_str(out, c"    pub fn push_int(inout self, v: i64) {\n");
        buf_str(out, c"        let negative = v < 0;\n");
        buf_str(out, c"        let u = if negative { (-(v + 1)) as u64 + 1 } else { v as u64 };\n");
        buf_str(out, c"        let n = if negative { decimal_len(u) + 1 } else { decimal_len(u) };\n");
        buf_str(out, c"        if n > self.bytes.cap - self.bytes.len {\n");
        buf_str(out, c"            self.bytes.reserve(n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            put_decimal(&self.bytes.ptr[self.bytes.len], n, u, negative);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.bytes.len += n;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its bytes, a view (0.17: valid while the Buf is not changed).\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn as_slice(self) -> [u8] {\n");
        buf_str(out, c"        self.bytes.as_slice()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its bytes, to change in place (0.17).\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn as_mut_slice(inout self) -> inout [u8] {\n");
        buf_str(out, c"        self.bytes.as_mut_slice()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn clear(inout self) {\n");
        buf_str(out, c"        self.bytes.clear();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its memory given back; it is left empty, to use again (0.17: a Buf is\n");
        buf_str(out, c"    // dropped at the end of its scope without it).\n");
        buf_str(out, c"    pub fn free(inout self) {\n");
        buf_str(out, c"        self.bytes.release();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its bytes, in a Buf on the same allocator; it is left empty (0.17:\n");
        buf_str(out, c"    // `std::take` for a container, which keeps its allocator).\n");
        buf_str(out, c"    pub fn take(inout self) -> Buf<A> {\n");
        buf_str(out, c"        Buf { bytes: self.bytes.take() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.17) A Buf's drop: its memory given back.\n");
        buf_str(out, c"impl<A: Allocator> Drop for Buf<A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn drop(inout self) {\n");
        buf_str(out, c"        self.bytes.release();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Buf<A> {\n");
        buf_str(out, c"    // A new Buf of the bytes of s on allocator a (0.17): text that must\n");
        buf_str(out, c"    // outlive the slice it came from.\n");
        buf_str(out, c"    pub fn from_in(s: [u8], a: sink A) -> Buf<A> {\n");
        buf_str(out, c"        var b: Buf<A> = Buf::with_capacity_in(s.len, a);\n");
        buf_str(out, c"        b.push_str(s);\n");
        buf_str(out, c"        b\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator + Ambient> Buf<A> {\n");
        buf_str(out, c"    #[ambient(\"Buf::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> Buf<A> {\n");
        buf_str(out, c"        Buf { bytes: Vec::new_in(A::ambient()) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The number of decimal digits of u.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn decimal_len(u: u64) -> i64 {\n");
        buf_str(out, c"    var n = 1;\n");
        buf_str(out, c"    var ten: u64 = 10;\n");
        buf_str(out, c"    for _ in 1..20 {\n");
        buf_str(out, c"        if u < ten {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        n += 1;\n");
        buf_str(out, c"        ten *= 10;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    n\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// u's decimal digits in p[0..n] (n: decimal_len(u), one more when\n");
        buf_str(out, c"// negative: after a '-'), two at a time. Unsafe: p has n bytes.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn put_decimal(p: *u8, n: i64, u: u64, negative: bool) {\n");
        buf_str(out, c"    let pairs = \"00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899\";\n");
        buf_str(out, c"    var x = u;\n");
        buf_str(out, c"    var i = n;\n");
        buf_str(out, c"    for _ in 0..10 {\n");
        buf_str(out, c"        if x < 100 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let q = x / 100;\n");
        buf_str(out, c"        let r = (x - q * 100) as i64 * 2;\n");
        buf_str(out, c"        i -= 2;\n");
        buf_str(out, c"        p[i] = pairs.ptr[r];\n");
        buf_str(out, c"        p[i + 1] = pairs.ptr[r + 1];\n");
        buf_str(out, c"        x = q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if x >= 10 {\n");
        buf_str(out, c"        let r = x as i64 * 2;\n");
        buf_str(out, c"        p[i - 2] = pairs.ptr[r];\n");
        buf_str(out, c"        p[i - 1] = pairs.ptr[r + 1];\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        p[i - 1] = '0' + x as u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if negative {\n");
        buf_str(out, c"        p[0] = '-';\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Buf's room and allocator (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Buf<A> {\n");
        buf_str(out, c"    // An empty Buf on allocator a with room for cap bytes (0.16).\n");
        buf_str(out, c"    pub fn with_capacity_in(cap: i64, a: sink A) -> Buf<A> {\n");
        buf_str(out, c"        Buf { bytes: Vec::with_capacity_in(cap, a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The bytes it has room for (0.16).\n");
        buf_str(out, c"    pub fn capacity(self) -> i64 {\n");
        buf_str(out, c"        self.bytes.cap\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Room for `extra` more bytes (0.16).\n");
        buf_str(out, c"    pub fn reserve(inout self, extra: i64) {\n");
        buf_str(out, c"        self.bytes.reserve(extra);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its allocator (0.16): a copy of the handle.\n");
        buf_str(out, c"    pub fn allocator(self) -> A {\n");
        buf_str(out, c"        self.bytes.alloc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Eq, Ord and Hash (0.9) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub trait Eq { #[pure] fn eq(self, other: Self) -> bool; }\n");
        buf_str(out, c"// Negative, zero or positive: self before, like or after other.\n");
        buf_str(out, c"pub trait Ord { #[pure] fn cmp(self, other: Self) -> i64; }\n");
        buf_str(out, c"pub trait Hash { #[pure] fn hash(self) -> u64; }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The hash of the integers (0.20): FixedState's, foldhash with fixed\n");
        buf_str(out, c"// seeds, one folded multiply (std::hash).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn hash_u64(x: u64) -> u64 {\n");
        buf_str(out, c"    hash::fold_hash_u64_fixed(x)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for i8 {\n");
        buf_str(out, c"    fn eq(self, other: i8) -> bool { self == other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for i8 {\n");
        buf_str(out, c"    fn cmp(self, other: i8) -> i64 {\n");
        buf_str(out, c"        if self < other { -1 } else if self == other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for i8 {\n");
        buf_str(out, c"    fn hash(self) -> u64 { hash_u64(self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for i16 {\n");
        buf_str(out, c"    fn eq(self, other: i16) -> bool { self == other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for i16 {\n");
        buf_str(out, c"    fn cmp(self, other: i16) -> i64 {\n");
        buf_str(out, c"        if self < other { -1 } else if self == other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for i16 {\n");
        buf_str(out, c"    fn hash(self) -> u64 { hash_u64(self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for i32 {\n");
        buf_str(out, c"    fn eq(self, other: i32) -> bool { self == other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for i32 {\n");
        buf_str(out, c"    fn cmp(self, other: i32) -> i64 {\n");
        buf_str(out, c"        if self < other { -1 } else if self == other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for i32 {\n");
        buf_str(out, c"    fn hash(self) -> u64 { hash_u64(self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for i64 {\n");
        buf_str(out, c"    fn eq(self, other: i64) -> bool { self == other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for i64 {\n");
        buf_str(out, c"    fn cmp(self, other: i64) -> i64 {\n");
        buf_str(out, c"        if self < other { -1 } else if self == other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for i64 {\n");
        buf_str(out, c"    fn hash(self) -> u64 { hash_u64(self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for u8 {\n");
        buf_str(out, c"    fn eq(self, other: u8) -> bool { self == other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for u8 {\n");
        buf_str(out, c"    fn cmp(self, other: u8) -> i64 {\n");
        buf_str(out, c"        if self < other { -1 } else if self == other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for u8 {\n");
        buf_str(out, c"    fn hash(self) -> u64 { hash_u64(self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for u16 {\n");
        buf_str(out, c"    fn eq(self, other: u16) -> bool { self == other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for u16 {\n");
        buf_str(out, c"    fn cmp(self, other: u16) -> i64 {\n");
        buf_str(out, c"        if self < other { -1 } else if self == other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for u16 {\n");
        buf_str(out, c"    fn hash(self) -> u64 { hash_u64(self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for u32 {\n");
        buf_str(out, c"    fn eq(self, other: u32) -> bool { self == other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for u32 {\n");
        buf_str(out, c"    fn cmp(self, other: u32) -> i64 {\n");
        buf_str(out, c"        if self < other { -1 } else if self == other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for u32 {\n");
        buf_str(out, c"    fn hash(self) -> u64 { hash_u64(self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for u64 {\n");
        buf_str(out, c"    fn eq(self, other: u64) -> bool { self == other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for u64 {\n");
        buf_str(out, c"    fn cmp(self, other: u64) -> i64 {\n");
        buf_str(out, c"        if self < other { -1 } else if self == other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for u64 {\n");
        buf_str(out, c"    fn hash(self) -> u64 { hash_u64(self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for bool {\n");
        buf_str(out, c"    fn eq(self, other: bool) -> bool { self == other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for bool {\n");
        buf_str(out, c"    fn cmp(self, other: bool) -> i64 {\n");
        buf_str(out, c"        if !self && other { -1 } else if self == other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for bool {\n");
        buf_str(out, c"    fn hash(self) -> u64 { hash_u64(self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Byte strings: compared by bytes, ordered lexicographically, hashed with\n");
        buf_str(out, c"// foldhash (0.20; FNV-1a before).\n");
        buf_str(out, c"impl Eq for [u8] {\n");
        buf_str(out, c"    fn eq(self, other: Self) -> bool {\n");
        buf_str(out, c"        let a = self;\n");
        buf_str(out, c"        let b = other;\n");
        buf_str(out, c"        if a.len != b.len {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for i in 0..a.len {\n");
        buf_str(out, c"            if a[i] != b[i] {\n");
        buf_str(out, c"                return false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for [u8] {\n");
        buf_str(out, c"    fn cmp(self, other: Self) -> i64 {\n");
        buf_str(out, c"        let a = self;\n");
        buf_str(out, c"        let b = other;\n");
        buf_str(out, c"        let n = if a.len < b.len { a.len } else { b.len };\n");
        buf_str(out, c"        for i in 0..n {\n");
        buf_str(out, c"            if a[i] != b[i] {\n");
        buf_str(out, c"                return if a[i] < b[i] { -1 } else { 1 };\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if a.len < b.len { -1 } else if a.len == b.len { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for [u8] {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn hash(self) -> u64 {\n");
        buf_str(out, c"        // (0.20: FixedState's, foldhash: the length, then the bytes)\n");
        buf_str(out, c"        hash::fold_hash_bytes_fixed(0x082efa98ec4e6c89, self)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Contract checks: the implementation (0.18) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) A contract or assertion check, which the compiler makes (from a\n");
        buf_str(out, c"// `requires` or `ensures` clause, `assert`, `assert_eq`, ...): both back\n");
        buf_str(out, c"// ends branch to the run-time failure when `ok` is false, whose line the\n");
        buf_str(out, c"// compiler writes from `check` (front/contracts/checks.tach) and `site`\n");
        buf_str(out, c"// (the position it blames); a, b, c: the values of the holes of an\n");
        buf_str(out, c"// f-string message (`else f\"index {i}\"`), evaluated only when `ok` is\n");
        buf_str(out, c"// false. Not called by programs.\n");
        buf_str(out, c"pub fn contract_check(ok: bool, site: i64, check: i64, a: i64 = 0, b: i64 = 0, c: i64 = 0) {\n");
        buf_str(out, c"    if !ok {\n");
        buf_str(out, c"        unsafe { panic(c\"contract check failed\") }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Iterators (0.14) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach: the same module,\n");
        buf_str(out, c"// `std`. The Iterator trait (in the prelude), its sources and adapters;\n");
        buf_str(out, c"// `for x in it` iterates any type implementing it\n");
        buf_str(out, c"// (docs/design/closures-iterators.md).\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Every method is #[inline], so that a chain becomes one loop: the\n");
        buf_str(out, c"// consumers are written on `fold`, and the sources and adapters override\n");
        buf_str(out, c"// `fold` with a counted loop (internal iteration). `exact_len` and `at`\n");
        buf_str(out, c"// let zip and enumerate index both sides when they know their length.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Slices (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T>[T] {\n");
        buf_str(out, c"    // Element i, or None when i is out of bounds (0.16: `s[i]` stops the\n");
        buf_str(out, c"    // program then, this does not).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn get(self: [T], i: i64) -> Option<T> {\n");
        buf_str(out, c"        if (i as u64) >= (self.len as u64) {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some(unsafe { self.ptr[i] })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Reading stdin and text (0.14) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach (0.15: split from\n");
        buf_str(out, c"// it): the same module, `std`. Reading stdin by lines or whole, trimming,\n");
        buf_str(out, c"// splitting and parsing text, and a Scanner of tokens and numbers.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// (0.15) The convention: an Option means absence (the end of the input,\n");
        buf_str(out, c"// nothing found), a Result with an error enum a failure: `read_line` and\n");
        buf_str(out, c"// `read_stdin` fail with an IoError, `parse_int` with a ParseIntError,\n");
        buf_str(out, c"// `Scanner::next_int` with a ScanError.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Reading stdin (0.14) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Text (0.14) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ASCII whitespace: ' ', '\\t', '\\n', '\\r', vertical tab, form feed.\n");
        buf_str(out, c"pub fn is_space(b: u8) -> bool {\n");
        buf_str(out, c"    b == ' ' || b == '\\t' || b == '\\n' || b == '\\r' || b == 11 || b == 12\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// '0' to '9'.\n");
        buf_str(out, c"pub fn is_digit(b: u8) -> bool {\n");
        buf_str(out, c"    b >= '0' && b <= '9'\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// s without the whitespace (`is_space`) at its start and end.\n");
        buf_str(out, c"#[views(s)]\n");
        buf_str(out, c"pub fn trim(s: [u8]) -> [u8] {\n");
        buf_str(out, c"    var a = 0;\n");
        buf_str(out, c"    var b = s.len;\n");
        buf_str(out, c"    for _ in 0..s.len {\n");
        buf_str(out, c"        if !(a < b && is_space(s[a])) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        a += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for _ in 0..s.len {\n");
        buf_str(out, c"        if !(b > a && is_space(s[b - 1])) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    s[a..b]\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// s as an integer: an optional '-' or '+', then decimal digits, nothing\n");
        buf_str(out, c"// else (no spaces); Err if s is not one or does not fit in an i64.\n");
        buf_str(out, c"// (0.20: std::num's parse_i64_radix, 8 digits at a time, but a lone sign\n");
        buf_str(out, c"// is Empty, not InvalidDigit(0); a byte that is no digit is reported\n");
        buf_str(out, c"// before an overflow.)\n");
        buf_str(out, c"pub fn parse_int(s: [u8]) -> Result<i64, ParseIntError> {\n");
        buf_str(out, c"    if s.len == 1 && (s[0] == '-' || s[0] == '+') {\n");
        buf_str(out, c"        return Result::Err(ParseIntError::Empty);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    num::parse_i64_radix(s, 10)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"read_stdin_in(gpa)\")]\n");
        buf_str(out, c"pub fn read_stdin() -> Result<Buf, IoError> {\n");
        buf_str(out, c"    read_stdin_in(Gpa::ambient())\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The parts of s between `sep` bytes, empty ones too, as views of s\n");
        buf_str(out, c"// (`split_in(\"a,,b\", ',', gpa)`: \"a\", \"\", \"b\"), in a Vec on allocator a.\n");
        buf_str(out, c"// The caller frees the Vec. (0.17: the Vec views s.)\n");
        buf_str(out, c"#[views(s)]\n");
        buf_str(out, c"pub fn split_in<A: Allocator>(s: [u8], sep: u8, a: sink A) -> Vec<[u8], A> {\n");
        buf_str(out, c"    var parts: Vec<[u8], A> = Vec::new_in(a);\n");
        buf_str(out, c"    var start = 0;\n");
        buf_str(out, c"    for i in 0..s.len {\n");
        buf_str(out, c"        if s[i] == sep {\n");
        buf_str(out, c"            parts.push(s[start..i]);\n");
        buf_str(out, c"            start = i + 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    parts.push(s[start..]);\n");
        buf_str(out, c"    parts\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"split_in(s, sep, gpa)\")]\n");
        buf_str(out, c"#[views(s)]\n");
        buf_str(out, c"pub fn split(s: [u8], sep: u8) -> Vec<[u8]> {\n");
        buf_str(out, c"    split_in(s, sep, Gpa::ambient())\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"split_whitespace_in(s, gpa)\")]\n");
        buf_str(out, c"#[views(s)]\n");
        buf_str(out, c"pub fn split_whitespace(s: [u8]) -> Vec<[u8]> {\n");
        buf_str(out, c"    split_whitespace_in(s, Gpa::ambient())\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The runs of non-whitespace in s, as views of s, in a Vec on allocator a.\n");
        buf_str(out, c"// The caller frees it. (0.17: the Vec views s.)\n");
        buf_str(out, c"#[views(s)]\n");
        buf_str(out, c"pub fn split_whitespace_in<A: Allocator>(s: [u8], a: sink A) -> Vec<[u8], A> {\n");
        buf_str(out, c"    var words: Vec<[u8], A> = Vec::new_in(a);\n");
        buf_str(out, c"    var sc = Scanner::new(s);\n");
        buf_str(out, c"    while let Option::Some(w) = sc.next_token() {\n");
        buf_str(out, c"        words.push(w);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    words\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Reads a text (`read_stdin().as_slice()`) front to back, by tokens\n");
        buf_str(out, c"// (runs of non-whitespace) and lines, as views of the text. (0.17) A view\n");
        buf_str(out, c"// of the text: the tokens it gives view the text, not the Scanner, so\n");
        buf_str(out, c"// several can be kept while it reads on.\n");
        buf_str(out, c"pub struct Scanner { text: [u8], pos: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Scanner {\n");
        buf_str(out, c"    #[views(text)]\n");
        buf_str(out, c"    pub fn new(text: [u8]) -> Scanner {\n");
        buf_str(out, c"        Scanner { text: text, pos: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The next token; None when only whitespace is left.\n");
        buf_str(out, c"    #[views(*self)]\n");
        buf_str(out, c"    pub fn next_token(inout self) -> Option<[u8]> {\n");
        buf_str(out, c"        let s = self.text;\n");
        buf_str(out, c"        var i = self.pos;\n");
        buf_str(out, c"        for _ in i..s.len {\n");
        buf_str(out, c"            if !is_space(s[i]) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if i >= s.len {\n");
        buf_str(out, c"            self.pos = i;\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let start = i;\n");
        buf_str(out, c"        for _ in i..s.len {\n");
        buf_str(out, c"            if is_space(s[i]) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.pos = i;\n");
        buf_str(out, c"        Option::Some(s[start..i])\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The next token as an integer (`parse_int`); Err at the end, or if\n");
        buf_str(out, c"    // it is not one (it is consumed all the same).\n");
        buf_str(out, c"    pub fn next_int(inout self) -> Result<i64, ScanError> {\n");
        buf_str(out, c"        match self.next_token() {\n");
        buf_str(out, c"            Option::Some(t) => match parse_int(t) {\n");
        buf_str(out, c"                Result::Ok(n) => Result::Ok(n),\n");
        buf_str(out, c"                Result::Err(e) => Result::Err(ScanError::Parse(e)),\n");
        buf_str(out, c"            },\n");
        buf_str(out, c"            Option::None => Result::Err(ScanError::End),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The rest of the line, without its '\\n'; None at the end of the\n");
        buf_str(out, c"    // text (\"a\\n\\nb\": \"a\", \"\", \"b\"; \"a\\n\": \"a\").\n");
        buf_str(out, c"    #[views(*self)]\n");
        buf_str(out, c"    pub fn next_line(inout self) -> Option<[u8]> {\n");
        buf_str(out, c"        let s = self.text;\n");
        buf_str(out, c"        if self.pos >= s.len {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let start = self.pos;\n");
        buf_str(out, c"        var i = start;\n");
        buf_str(out, c"        for _ in i..s.len {\n");
        buf_str(out, c"            if s[i] == '\\n' {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.pos = if i < s.len { i + 1 } else { i };\n");
        buf_str(out, c"        Option::Some(s[start..i])\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether nothing but whitespace is left.\n");
        buf_str(out, c"    pub fn is_done(self) -> bool {\n");
        buf_str(out, c"        let s = self.text;\n");
        buf_str(out, c"        var i = self.pos;\n");
        buf_str(out, c"        for _ in i..s.len {\n");
        buf_str(out, c"            if !is_space(s[i]) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i >= s.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // What is left of the text.\n");
        buf_str(out, c"    // (0.20: self is a copy of the view; what it views is its level 1)\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn rest(self) -> [u8] {\n");
        buf_str(out, c"        self.text[self.pos..]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Errors of reading and parsing (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Reading stdin failed (read_line, read_stdin).\n");
        buf_str(out, c"pub enum IoError { Read, Write }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Why parse_int failed: no digits; the byte at this index is not a digit;\n");
        buf_str(out, c"// the number does not fit in an i64.\n");
        buf_str(out, c"pub enum ParseIntError { Empty, InvalidDigit(i64), Overflow }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Why Scanner::next_int failed: no token left; the token is not a number.\n");
        buf_str(out, c"pub enum ScanError { End, Parse(ParseIntError) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for IoError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            IoError::Read => f.str(\"cannot read the input\"),\n");
        buf_str(out, c"            IoError::Write => f.str(\"cannot write the output\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for IoError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            IoError::Read => f.str(\"Read\"),\n");
        buf_str(out, c"            IoError::Write => f.str(\"Write\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for ParseIntError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            ParseIntError::Empty => f.str(\"cannot parse an integer from an empty text\"),\n");
        buf_str(out, c"            ParseIntError::InvalidDigit(i) => {\n");
        buf_str(out, c"                f.str(\"invalid digit at byte \");\n");
        buf_str(out, c"                f.display(i);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            ParseIntError::Overflow => f.str(\"the number does not fit in an i64\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for ParseIntError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            ParseIntError::Empty => f.str(\"Empty\"),\n");
        buf_str(out, c"            ParseIntError::InvalidDigit(i) => {\n");
        buf_str(out, c"                f.str(\"InvalidDigit(\");\n");
        buf_str(out, c"                f.debug(i);\n");
        buf_str(out, c"                f.str(\")\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            ParseIntError::Overflow => f.str(\"Overflow\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for ScanError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            ScanError::End => f.str(\"no number left: the end of the input\"),\n");
        buf_str(out, c"            ScanError::Parse(e) => f.display(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for ScanError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            ScanError::End => f.str(\"End\"),\n");
        buf_str(out, c"            ScanError::Parse(e) => {\n");
        buf_str(out, c"                f.str(\"Parse(\");\n");
        buf_str(out, c"                f.debug(e);\n");
        buf_str(out, c"                f.str(\")\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Printing and formatting ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach (its printing was\n");
        buf_str(out, c"// split from it): the same module, `std`. Printing; the traits Display\n");
        buf_str(out, c"// (`{x}`, print) and Debug (`{x:?}`), the formatter Fmt they write to, and\n");
        buf_str(out, c"// Interp, the value of an f-string (docs/design/errors-formatting.md).\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Output to stdout and stderr goes through one static buffer of 4 KB\n");
        buf_str(out, c"// (not the heap), written out at the end of each print call: one `write`\n");
        buf_str(out, c"// per print, whatever its argument is made of. A Fmt to a file descriptor\n");
        buf_str(out, c"// only fills that buffer: `flush` writes it out.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// (0.16) Formatting allocates nothing: a Fmt to a Buf writes into the\n");
        buf_str(out, c"// room the Buf has, and counts what does not fit; then `push_fmt` grows\n");
        buf_str(out, c"// the Buf to the count and runs the Display again (twice only when the\n");
        buf_str(out, c"// text did not fit). So print's effects have no `alloc`.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Display and Debug of std's types (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for i8 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) { fmt_signed(&f, self as i64, 8); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for i8 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) { fmt_signed(&f, self as i64, 8); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for i16 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) { fmt_signed(&f, self as i64, 16); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for i16 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) { fmt_signed(&f, self as i64, 16); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for i32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) { fmt_signed(&f, self as i64, 32); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for i32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) { fmt_signed(&f, self as i64, 32); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for i64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) { f.int(self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for i64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) { f.int(self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (a number, as in Rust: `{c:c}` writes the byte)\n");
        buf_str(out, c"impl Display for u8 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) { f.uint(self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for u8 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) { f.uint(self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for u16 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) { f.uint(self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for u16 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) { f.uint(self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for u32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) { f.uint(self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for u32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) { f.uint(self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for u64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) { f.uint(self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for u64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) { f.uint(self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for bool {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) { f.str(if self { \"true\" } else { \"false\" }); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for bool {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) { f.str(if self { \"true\" } else { \"false\" }); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for [u8] {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) { f.str(self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (quoted and escaped: `\"a\\n\"`)\n");
        buf_str(out, c"impl Debug for [u8] {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) { fmt_quoted(&f, self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Display for Buf<A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) { f.str(self.as_slice()); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Debug for Buf<A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) { fmt_quoted(&f, self.as_slice()); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Debug> Debug for Option<T> {\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => {\n");
        buf_str(out, c"                f.str(\"Some(\");\n");
        buf_str(out, c"                f.debug(x);\n");
        buf_str(out, c"                f.byte(')');\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Option::None => f.str(\"None\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Debug, E: Debug> Debug for Result<T, E> {\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => {\n");
        buf_str(out, c"                f.str(\"Ok(\");\n");
        buf_str(out, c"                f.debug(x);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Result::Err(e) => {\n");
        buf_str(out, c"                f.str(\"Err(\");\n");
        buf_str(out, c"                f.debug(e);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.byte(')');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Debug, A: Allocator> Debug for Vec<T, A> {\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) { debug_list(&f, self.as_slice()); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.16: `Ok(())`)\n");
        buf_str(out, c"impl Debug for () {\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) {\n");
        buf_str(out, c"        f.str(\"()\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Debug of HashMap (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `{k: v, ...}`, in slot order.\n");
        buf_str(out, c"impl<K: Hash + Eq + Debug, V: Debug, A: Allocator> Debug for HashMap<K, V, A> {\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) {\n");
        buf_str(out, c"        f.byte('{');\n");
        buf_str(out, c"        var first = true;\n");
        buf_str(out, c"        let t = self.raw_table();\n");
        buf_str(out, c"        for i in t.iter() {\n");
        buf_str(out, c"            if !first {\n");
        buf_str(out, c"                f.str(\", \");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            first = false;\n");
        buf_str(out, c"            let e = t.get(i);\n");
        buf_str(out, c"            f.debug(e.0);\n");
        buf_str(out, c"            f.str(\": \");\n");
        buf_str(out, c"            f.debug(e.1);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.byte('}');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Conversions (0.15) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach: the same module,\n");
        buf_str(out, c"// `std`. From and Into, the traits of conversions\n");
        buf_str(out, c"// (docs/design/errors-formatting.md). Every type converts from itself,\n");
        buf_str(out, c"// and an integer type from the integer types that widen to it, without\n");
        buf_str(out, c"// an impl; Into is the compiler's: `let y: U = x.into()` is `U::from(x)`.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Option and Result's adapters (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Option<T> {\n");
        buf_str(out, c"    // Some(x) is Ok(x), None the error `err`: `opt.ok_or(E::Missing)?`.\n");
        buf_str(out, c"    pub fn ok_or<E>(sink self, err: sink E) -> Result<T, E> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => Result::Ok(x),\n");
        buf_str(out, c"            Option::None => Result::Err(err),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn map<U, F: Fn(T) -> U>(sink self, f: F) -> Option<U> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => Option::Some(f(x)),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn and_then<U, F: Fn(T) -> Option<U>>(sink self, f: F) -> Option<U> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => f(x),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap_or_else<F: Fn() -> T>(sink self, f: F) -> T {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => x,\n");
        buf_str(out, c"            Option::None => f(),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, E> Result<T, E> {\n");
        buf_str(out, c"    pub fn map<U, F: Fn(T) -> U>(sink self, f: F) -> Result<U, E> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => Result::Ok(f(x)),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The error converted: `r.map_err(AppError::Io)?`, `r.map_err(|e| ...)`.\n");
        buf_str(out, c"    pub fn map_err<G, F: Fn(E) -> G>(sink self, f: F) -> Result<T, G> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => Result::Ok(x),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(f(e)),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn err(sink self) -> Option<E> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(_) => Option::None,\n");
        buf_str(out, c"            Result::Err(e) => Option::Some(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap_or_else<F: Fn(E) -> T>(sink self, f: F) -> T {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => x,\n");
        buf_str(out, c"            Result::Err(e) => f(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (No string literals below: std's literals are in every program that\n");
        buf_str(out, c"// loads std, used or not.)\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What a `main` returning `Result<(), E>` does with an Err: `Error: {e:?}` and\n");
        buf_str(out, c"// a newline on stderr, then exit status 1 (the compiler calls it).\n");
        buf_str(out, c"pub fn main_error<E: Debug>(e: sink E) -> i32 {\n");
        buf_str(out, c"    var f = Fmt::to_fd(2);\n");
        buf_str(out, c"    let head: [u8; 7] = ['E', 'r', 'r', 'o', 'r', ':', ' '];\n");
        buf_str(out, c"    f.str(head[..]);\n");
        buf_str(out, c"    f.debug(e);\n");
        buf_str(out, c"    f.byte('\\n');\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"    1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Clone and hashing (0.15) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach: the same module,\n");
        buf_str(out, c"// `std`. Clone, and the helpers `#[derive(Eq, Ord, Hash, Clone)]` calls on\n");
        buf_str(out, c"// each field (docs/design/errors-formatting.md). Numbers, bool, pointers,\n");
        buf_str(out, c"// slices, fn types, fieldless enums, and tuples and arrays of them clone\n");
        buf_str(out, c"// by copying, without an impl; tuples of Eq, Ord, Hash or Clone types are\n");
        buf_str(out, c"// Eq, Ord (lexicographic), Hash and Clone (element-wise), through the\n");
        buf_str(out, c"// functions at the end of this file, which the compiler calls.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Hashing and comparing helpers (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Hash h of the fields so far, with the hash x of the next one mixed in.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn hash_mix(h: u64, x: u64) -> u64 {\n");
        buf_str(out, c"    hash_u64(h ^ (x + 0x9e3779b97f4a7c15u64 + (h << 6) + (h >> 2)))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `*a == *b`: structural, or the type's Eq impl (`[u8]`: by bytes).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn eq_of<T: Eq>(a: T, b: T) -> bool {\n");
        buf_str(out, c"    a == b\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `a.cmp(b)`: negative, zero or positive as *a goes before, with or after\n");
        buf_str(out, c"// *b.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn cmp_of<T: Ord>(a: T, b: T) -> i64 {\n");
        buf_str(out, c"    a.cmp(b)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `x.hash()`.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn hash_of<T: Hash>(x: T) -> u64 {\n");
        buf_str(out, c"    x.hash()\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `x.clone()`.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn clone_of<T: Clone>(x: T) -> T {\n");
        buf_str(out, c"    x.clone()\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A new Vec of clones of the elements, on the same allocator.\n");
        buf_str(out, c"impl<T: Clone, A: Allocator> Clone for Vec<T, A> {\n");
        buf_str(out, c"    fn clone(self) -> Vec<T, A> {\n");
        buf_str(out, c"        self.clone_in(self.alloc)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Clone, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // (0.15) n copies of x on allocator a: Rust's `vec![x; n]`. (0.17)\n");
        buf_str(out, c"    // Clones of x, then x itself: n Vecs from one Vec each own their\n");
        buf_str(out, c"    // elements (plain types clone by copying).\n");
        buf_str(out, c"    pub fn filled_in(n: i64, x: sink T, a: sink A) -> Vec<T, A> {\n");
        buf_str(out, c"        var v: Vec<T, A> = Vec::with_capacity_in(n, a);\n");
        buf_str(out, c"        if n > 0 {\n");
        buf_str(out, c"            for _ in 1..n {\n");
        buf_str(out, c"                v.push(x.clone());\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            v.push(x);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A new Vec of clones of the elements, on allocator b (0.16).\n");
        buf_str(out, c"    pub fn clone_in<B: Allocator>(self, b: sink B) -> Vec<T, B> {\n");
        buf_str(out, c"        let s = self.as_slice();\n");
        buf_str(out, c"        var v: Vec<T, B> = Vec::with_capacity_in(s.len, b);\n");
        buf_str(out, c"        for i in 0..s.len {\n");
        buf_str(out, c"            v.push(clone_of(s[i]));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Clone for Buf<A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn clone(self) -> Buf<A> {\n");
        buf_str(out, c"        var b: Buf<A> = Buf::new_in(self.bytes.alloc);\n");
        buf_str(out, c"        b.push_str(self.as_slice());\n");
        buf_str(out, c"        b\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A new map of clones of the entries.\n");
        buf_str(out, c"impl<K: Hash + Eq + Clone, V: Clone, A: Allocator> Clone for HashMap<K, V, A> {\n");
        buf_str(out, c"    fn clone(self) -> HashMap<K, V, A> {\n");
        buf_str(out, c"        var m: HashMap<K, V, A> = HashMap::with_capacity_in(self.len(), self.allocator());\n");
        buf_str(out, c"        let t = self.raw_table();\n");
        buf_str(out, c"        for i in t.iter() {\n");
        buf_str(out, c"            let e = t.get(i);\n");
        buf_str(out, c"            m.insert(clone_of(e.0), clone_of(e.1));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        m\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Clone> Clone for Option<T> {\n");
        buf_str(out, c"    fn clone(self) -> Option<T> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => Option::Some(clone_of(x)),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Clone, E: Clone> Clone for Result<T, E> {\n");
        buf_str(out, c"    fn clone(self) -> Result<T, E> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => Result::Ok(clone_of(x)),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(clone_of(e)),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- == on Vec (0.15) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// `==` compares contents, as Rust's: Vecs element by element (so a Buf,\n");
        buf_str(out, c"// whose bytes are a Vec, by bytes), maps by their entries in any order.\n");
        buf_str(out, c"// Whether two values are the same Vec: `a.as_slice().ptr == b.as_slice().ptr`.\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Eq, A: Allocator> Eq for Vec<T, A> {\n");
        buf_str(out, c"    fn eq(self, other: Vec<T, A>) -> bool {\n");
        buf_str(out, c"        self.as_slice() == other.as_slice()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- == on HashMap (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Hash + Eq, V: Eq, A: Allocator> Eq for HashMap<K, V, A> {\n");
        buf_str(out, c"    fn eq(self, other: HashMap<K, V, A>) -> bool {\n");
        buf_str(out, c"        if self.len() != other.len() {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let t = self.raw_table();\n");
        buf_str(out, c"        let u = other.raw_table();\n");
        buf_str(out, c"        for i in t.iter() {\n");
        buf_str(out, c"            let e = t.get(i);\n");
        buf_str(out, c"            let j = u.find(e.0.hash(), |f: (K, V)| f.0 == e.0);\n");
        buf_str(out, c"            if j < 0 || !(u.get(j).1 == e.1) {\n");
        buf_str(out, c"                return false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Clone, Eq, Ord and Hash without an impl (0.15) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// `x.clone()` on a type that copies (a number, bool, pointer, slice, fn,\n");
        buf_str(out, c"// fieldless enum, or a tuple or array of them) is copy_clone; `x.cmp(&y)`\n");
        buf_str(out, c"// on a float, pointer or fieldless enum is scalar_cmp; on a tuple of 2 to\n");
        buf_str(out, c"// 6 elements, `eq` (== when the structural one does not apply), `cmp` (<),\n");
        buf_str(out, c"// `hash` and `clone` are tupleN_eq, tupleN_cmp, tupleN_hash and\n");
        buf_str(out, c"// tupleN_clone (front/derive/intrinsic.tach). They are private: the\n");
        buf_str(out, c"// compiler calls them.\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn copy_clone<T>(self: T) -> T {\n");
        buf_str(out, c"    self\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn scalar_cmp<T>(self: T, other: T) -> i64 {\n");
        buf_str(out, c"    if self < other { -1 } else if other < self { 1 } else { 0 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) The traits a distinct type T has from its underlying type B\n");
        buf_str(out, c"// without an impl (front/check/distinct.tach): through a pointer to B,\n");
        buf_str(out, c"// which has T's representation (so the unsafe blocks are sound: `self`\n");
        buf_str(out, c"// and `other` are borrows, and the cast keeps what they point to; the\n");
        buf_str(out, c"// traits take `&Self`, 0.17).\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn distinct_eq<T, B: Eq>(self: T, other: T) -> bool {\n");
        buf_str(out, c"    unsafe { eq_of(*(&self as *B), *(&other as *B)) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn distinct_cmp<T, B: Ord>(self: T, other: T) -> i64 {\n");
        buf_str(out, c"    unsafe { cmp_of(*(&self as *B), *(&other as *B)) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn distinct_hash<T, B: Hash>(self: T) -> u64 {\n");
        buf_str(out, c"    unsafe { hash_of(*(&self as *B)) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn distinct_clone<T, B: Clone>(self: T) -> T {\n");
        buf_str(out, c"    unsafe { (*(&self as *B)).clone() as T }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn distinct_fmt<T, B: Display>(self: T, f: inout Fmt) {\n");
        buf_str(out, c"    unsafe { (*(&self as *B)).fmt(&f); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn distinct_fmt_debug<T, B: Debug>(self: T, f: inout Fmt) {\n");
        buf_str(out, c"    unsafe { (*(&self as *B)).fmt_debug(&f); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple2_cmp<A: Ord, B: Ord>(self: (A, B), other: (A, B)) -> i64 {\n");
        buf_str(out, c"    let c = cmp_of(self.0, other.0);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    cmp_of(self.1, other.1)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple3_cmp<A: Ord, B: Ord, C: Ord>(self: (A, B, C), other: (A, B, C)) -> i64 {\n");
        buf_str(out, c"    var c = cmp_of(self.0, other.0);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(self.1, other.1);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    cmp_of(self.2, other.2)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple4_cmp<A: Ord, B: Ord, C: Ord,\n");
        buf_str(out, c"    D: Ord>(self: (A, B, C, D), other: (A, B, C, D)) -> i64 {\n");
        buf_str(out, c"    var c = cmp_of(self.0, other.0);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(self.1, other.1);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(self.2, other.2);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    cmp_of(self.3, other.3)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple5_cmp<A: Ord, B: Ord, C: Ord, D: Ord, E: Ord>(self: (A, B, C, D, E),\n");
        buf_str(out, c"    other: (A, B, C, D, E)) -> i64 {\n");
        buf_str(out, c"    var c = cmp_of(self.0, other.0);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(self.1, other.1);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(self.2, other.2);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(self.3, other.3);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    cmp_of(self.4, other.4)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple6_cmp<A: Ord, B: Ord, C: Ord, D: Ord, E: Ord, F: Ord>(self: (A, B, C, D, E, F),\n");
        buf_str(out, c"    other: (A, B, C, D, E, F)) -> i64 {\n");
        buf_str(out, c"    var c = cmp_of(self.0, other.0);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(self.1, other.1);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(self.2, other.2);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(self.3, other.3);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(self.4, other.4);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    cmp_of(self.5, other.5)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple2_eq<A: Eq, B: Eq>(self: (A, B), other: (A, B)) -> bool {\n");
        buf_str(out, c"    eq_of(self.0, other.0) && eq_of(self.1, other.1)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple3_eq<A: Eq, B: Eq, C: Eq>(self: (A, B, C), other: (A, B, C)) -> bool {\n");
        buf_str(out, c"    eq_of(self.0, other.0) && eq_of(self.1, other.1)\n");
        buf_str(out, c"        && eq_of(self.2, other.2)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple4_eq<A: Eq, B: Eq, C: Eq, D: Eq>(self: (A, B, C, D), other: (A, B, C, D)) -> bool {\n");
        buf_str(out, c"    eq_of(self.0, other.0) && eq_of(self.1, other.1)\n");
        buf_str(out, c"        && eq_of(self.2, other.2) && eq_of(self.3, other.3)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple5_eq<A: Eq, B: Eq, C: Eq, D: Eq, E: Eq>(self: (A, B, C, D, E),\n");
        buf_str(out, c"    other: (A, B, C, D, E)) -> bool {\n");
        buf_str(out, c"    eq_of(self.0, other.0) && eq_of(self.1, other.1)\n");
        buf_str(out, c"        && eq_of(self.2, other.2) && eq_of(self.3, other.3)\n");
        buf_str(out, c"        && eq_of(self.4, other.4)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple6_eq<A: Eq, B: Eq, C: Eq, D: Eq, E: Eq, F: Eq>(self: (A, B, C, D, E, F),\n");
        buf_str(out, c"    other: (A, B, C, D, E, F)) -> bool {\n");
        buf_str(out, c"    eq_of(self.0, other.0) && eq_of(self.1, other.1)\n");
        buf_str(out, c"        && eq_of(self.2, other.2) && eq_of(self.3, other.3)\n");
        buf_str(out, c"        && eq_of(self.4, other.4) && eq_of(self.5, other.5)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple2_hash<A: Hash, B: Hash>(self: (A, B)) -> u64 {\n");
        buf_str(out, c"    hash_mix(hash_of(self.0), hash_of(self.1))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple3_hash<A: Hash, B: Hash, C: Hash>(self: (A, B, C)) -> u64 {\n");
        buf_str(out, c"    let h = hash_mix(hash_of(self.0), hash_of(self.1));\n");
        buf_str(out, c"    hash_mix(h, hash_of(self.2))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple4_hash<A: Hash, B: Hash, C: Hash, D: Hash>(self: (A, B, C, D)) -> u64 {\n");
        buf_str(out, c"    var h = hash_mix(hash_of(self.0), hash_of(self.1));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(self.2));\n");
        buf_str(out, c"    hash_mix(h, hash_of(self.3))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple5_hash<A: Hash, B: Hash, C: Hash, D: Hash, E: Hash>(self: (A, B, C, D, E)) -> u64 {\n");
        buf_str(out, c"    var h = hash_mix(hash_of(self.0), hash_of(self.1));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(self.2));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(self.3));\n");
        buf_str(out, c"    hash_mix(h, hash_of(self.4))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple6_hash<A: Hash, B: Hash, C: Hash, D: Hash, E: Hash, F: Hash>(\n");
        buf_str(out, c"    self: (A, B, C, D, E, F)) -> u64 {\n");
        buf_str(out, c"    var h = hash_mix(hash_of(self.0), hash_of(self.1));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(self.2));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(self.3));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(self.4));\n");
        buf_str(out, c"    hash_mix(h, hash_of(self.5))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple2_clone<A: Clone, B: Clone>(self: (A, B)) -> (A, B) {\n");
        buf_str(out, c"    (clone_of(self.0), clone_of(self.1))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple3_clone<A: Clone, B: Clone, C: Clone>(self: (A, B, C)) -> (A, B, C) {\n");
        buf_str(out, c"    (clone_of(self.0), clone_of(self.1), clone_of(self.2))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple4_clone<A: Clone, B: Clone, C: Clone, D: Clone>(self: (A, B, C, D)) -> (A, B, C, D) {\n");
        buf_str(out, c"    (clone_of(self.0), clone_of(self.1), clone_of(self.2), clone_of(self.3))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple5_clone<A: Clone, B: Clone, C: Clone, D: Clone, E: Clone>(self: (A, B, C, D, E))\n");
        buf_str(out, c"    -> (A, B, C, D, E) {\n");
        buf_str(out, c"    (clone_of(self.0), clone_of(self.1), clone_of(self.2), clone_of(self.3),\n");
        buf_str(out, c"        clone_of(self.4))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple6_clone<A: Clone, B: Clone, C: Clone, D: Clone, E: Clone, F: Clone>(\n");
        buf_str(out, c"    self: (A, B, C, D, E, F)) -> (A, B, C, D, E, F) {\n");
        buf_str(out, c"    (clone_of(self.0), clone_of(self.1), clone_of(self.2), clone_of(self.3),\n");
        buf_str(out, c"        clone_of(self.4), clone_of(self.5))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Allocation (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Memory comes from allocators: a type implementing Allocator. Containers\n");
        buf_str(out, c"// carry theirs as a type parameter (`Vec<T, A: Allocator = Gpa>`), so an\n");
        buf_str(out, c"// allocation is a call std can see, and effects name it (`alloc(Gpa)`).\n");
        buf_str(out, c"// Allocation is explicit: nothing allocates without being given an\n");
        buf_str(out, c"// allocator, `Vec::new_in(a)`, `collect_in(a)`, `format_in(x, a)`. Gpa,\n");
        buf_str(out, c"// the general-purpose allocator (C's malloc), is the type parameters'\n");
        buf_str(out, c"// default, and a program has one when its main takes it (`gpa: Gpa`, its\n");
        buf_str(out, c"// parameter), passed down as a parameter.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Sizes and alignments are in bytes; an alignment is a power of two from 1\n");
        buf_str(out, c"// to 4096. Running out of memory, or misusing an allocator, stops the\n");
        buf_str(out, c"// program (exit 101): part of the effect `alloc`, not `panic`. A size\n");
        buf_str(out, c"// above ALLOC_LIMIT (2^62 bytes) is out of memory.\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub trait Allocator {\n");
        buf_str(out, c"    // size bytes aligned to align, null when out of memory; size 0: aligned,\n");
        buf_str(out, c"    // non-null, unreadable.\n");
        buf_str(out, c"    #[effects(alloc, global, panic, diverge, unsafe)]\n");
        buf_str(out, c"    fn try_alloc(self: *Self, size: i64, align: i64) -> *u8;\n");
        buf_str(out, c"    // p (old_size bytes, from this allocator) as new_size bytes, the first\n");
        buf_str(out, c"    // min(old_size, new_size) kept; may move; null: p is left as it was.\n");
        buf_str(out, c"    #[effects(alloc, global, panic, diverge, unsafe)]\n");
        buf_str(out, c"    unsafe fn try_resize(self: *Self, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8;\n");
        buf_str(out, c"    // Gives back p (size bytes, from this allocator).\n");
        buf_str(out, c"    #[effects(alloc, global, panic, diverge, unsafe)]\n");
        buf_str(out, c"    unsafe fn free(self: *Self, p: *u8, size: i64, align: i64);\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // try_alloc, stopping the program when out of memory.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn alloc(self: *Self, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        let p = self.try_alloc(size, align);\n");
        buf_str(out, c"        if p == 0 as *u8 {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        p\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // try_resize, stopping the program when out of memory.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn resize(self: *Self, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        let q = self.try_resize(p, old_size, new_size, align);\n");
        buf_str(out, c"        if q == 0 as *u8 {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        q\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What the try_ functions of containers return when out of memory\n");
        buf_str(out, c"// (`v.try_push(x)`, `v.try_reserve(n)`).\n");
        buf_str(out, c"pub enum AllocError { OutOfMemory }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for AllocError {\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) {\n");
        buf_str(out, c"        f.str(\"out of memory\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for AllocError {\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) {\n");
        buf_str(out, c"        f.str(\"OutOfMemory\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The largest allocation: 2^62 bytes (a size above it is out of memory).\n");
        buf_str(out, c"pub const ALLOC_LIMIT: i64 = 4611686018427387904;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Stops the program: an allocator is out of memory.\n");
        buf_str(out, c"#[cold]\n");
        buf_str(out, c"fn out_of_memory() -> ! {\n");
        buf_str(out, c"    unsafe { panic(c\"out of memory\") }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// n elements of `size` bytes, in bytes; -1 when n is negative or that is\n");
        buf_str(out, c"// above ALLOC_LIMIT.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn alloc_bytes(n: i64, size: i64) -> i64 {\n");
        buf_str(out, c"    if n < 0 || size > 0 && n > ALLOC_LIMIT / size {\n");
        buf_str(out, c"        return -1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    n * size\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The capacity a container grows to from cap for at least need elements:\n");
        buf_str(out, c"// twice cap (4 at least), or need when that is more.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn grown_cap(cap: i64, need: i64) -> i64 {\n");
        buf_str(out, c"    let twice = if cap == 0 { 4 } else if cap < ALLOC_LIMIT / 2 { cap * 2 } else { ALLOC_LIMIT };\n");
        buf_str(out, c"    if twice < need { need } else { twice }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Gpa ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The general-purpose allocator: C's malloc, realloc and free (its\n");
        buf_str(out, c"// implementation follows std's source: gpa.tach, or the checking one of\n");
        buf_str(out, c"// --check-alloc). Zero-sized, copied freely: a Vec<T> on it is three\n");
        buf_str(out, c"// words. Sealed: only the runtime's entry makes one, main's parameter\n");
        buf_str(out, c"// `gpa: Gpa`; a static cannot hold one (no constant makes one), so a\n");
        buf_str(out, c"// program keeps its containers in main and passes them down.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct Gpa {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Arenas (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An arena: allocations bump a pointer through chunks taken from Gpa, and\n");
        buf_str(out, c"// are given back all at once: when a scope ends (`a.scope(|s| ...)`,\n");
        buf_str(out, c"// `arena_scope(gpa, |s| ...)`), or by `reset` and `free_all` (unsafe: what\n");
        buf_str(out, c"// was allocated must not be used after). A request above 32 KB gets a\n");
        buf_str(out, c"// chunk of its own; the last block grows and shrinks in place; `free`\n");
        buf_str(out, c"// gives back the last block, and a chunk of its own. A handle: copies\n");
        buf_str(out, c"// share the arena. `Arena::none()`, a constant (for statics), has no\n");
        buf_str(out, c"// memory: allocating from it stops the program.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// (--check-alloc, CHECK_ALLOC: each block is on pages of its own from the\n");
        buf_str(out, c"// checking Gpa, its owner the arena's state; the bump keeps the\n");
        buf_str(out, c"// accounting, so `used` and exhaustion are as without; a block given back\n");
        buf_str(out, c"// (free, a move, a reset, a scope's end, free_all) loses its pages.)\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct Arena { s: *ArenaState }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A chunk of an arena's memory, from Gpa: this header, then its bytes (the\n");
        buf_str(out, c"// first chunk's start with the arena's state).\n");
        buf_str(out, c"struct ArenaChunk { next: *ArenaChunk, size: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A block of its own (a request above ARENA_LARGE): this header, at\n");
        buf_str(out, c"// arena_large_head(align) bytes before the block, in a list both ways.\n");
        buf_str(out, c"struct ArenaLarge { next: *ArenaLarge, prev: *ArenaLarge, size: i64, align: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The state of an arena, in its first chunk, or of a scope, on the stack\n");
        buf_str(out, c"// of the scope's function. Addresses are i64s; ptr..limit is where the\n");
        buf_str(out, c"// next block goes (limit is 0 while the arena is lent to a scope).\n");
        buf_str(out, c"struct ArenaState {\n");
        buf_str(out, c"    ptr: i64,\n");
        buf_str(out, c"    limit: i64,\n");
        buf_str(out, c"    // the current chunk, its first byte and its end\n");
        buf_str(out, c"    chunk: *ArenaChunk,\n");
        buf_str(out, c"    start: i64,\n");
        buf_str(out, c"    end: i64,\n");
        buf_str(out, c"    // the last block (it grows in place), -1: none\n");
        buf_str(out, c"    last: i64,\n");
        buf_str(out, c"    // the bytes used in the chunks before the current one\n");
        buf_str(out, c"    before: i64,\n");
        buf_str(out, c"    lent: bool,\n");
        buf_str(out, c"    // the arena's own state (itself for an Arena; for a scope, its arena's)\n");
        buf_str(out, c"    root: *ArenaState,\n");
        buf_str(out, c"    // a scope's: the arena's blocks of their own when it started\n");
        buf_str(out, c"    large_mark: *ArenaLarge,\n");
        buf_str(out, c"    // the root's: its chunks, its blocks of their own, the bytes of these,\n");
        buf_str(out, c"    // the bytes taken from Gpa, the size of the next chunk\n");
        buf_str(out, c"    first: *ArenaChunk,\n");
        buf_str(out, c"    large: *ArenaLarge,\n");
        buf_str(out, c"    large_bytes: i64,\n");
        buf_str(out, c"    chunk_bytes: i64,\n");
        buf_str(out, c"    next_size: i64,\n");
        buf_str(out, c"    // a scope's, with --check-alloc: the checking Gpa's blocks when it\n");
        buf_str(out, c"    // started (check_alloc_mark)\n");
        buf_str(out, c"    check_mark: i64,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Requests above this get a chunk of their own.\n");
        buf_str(out, c"const ARENA_LARGE: i64 = 32768;\n");
        buf_str(out, c"// The first chunk's bytes (Arena::new_in), the first next chunk's (a\n");
        buf_str(out, c"// request up to ARENA_LARGE, aligned, fits in any), the largest.\n");
        buf_str(out, c"const ARENA_FIRST: i64 = 8192;\n");
        buf_str(out, c"const ARENA_NEXT: i64 = 65536;\n");
        buf_str(out, c"const ARENA_MAX_CHUNK: i64 = 4194304;\n");
        buf_str(out, c"const ARENA_CHUNK_HEAD: i64 = 16;\n");
        buf_str(out, c"const ARENA_ALIGN_MAX: i64 = 4096;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A block's bytes from state s: the bump (an Arena's and a ScopedArena's\n");
        buf_str(out, c"// try_alloc), inlined where they are called; the rest (a new chunk, a\n");
        buf_str(out, c"// block of its own, Arena::none(), a lent arena) out of line and cold.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn arena_alloc(s: *ArenaState, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        if s != 0 as *ArenaState {\n");
        buf_str(out, c"            let p = (s.ptr + align - 1) & -align;\n");
        buf_str(out, c"            let e = p + size;\n");
        buf_str(out, c"            if (size as u64) <= (ARENA_LARGE as u64) && p >= s.ptr && e <= s.limit {\n");
        buf_str(out, c"                s.ptr = e;\n");
        buf_str(out, c"                s.last = p;\n");
        buf_str(out, c"                if CHECK_ALLOC {\n");
        buf_str(out, c"                    // (the block's own pages; the bump keeps the count)\n");
        buf_str(out, c"                    return check_alloc_block(s.root as u64, size, align);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return p as *u8;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        arena_alloc_slow(s, size, align)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether align is an alignment: a power of two from 1 to 4096.\n");
        buf_str(out, c"fn arena_align_ok(align: i64) -> bool {\n");
        buf_str(out, c"    align >= 1 && align <= ARENA_ALIGN_MAX && (align & (align - 1)) == 0\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// arena_alloc when the bump does not fit: a block of its own, or the next\n");
        buf_str(out, c"// chunk (a new one when there is none).\n");
        buf_str(out, c"#[cold]\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"unsafe fn arena_alloc_slow(s: *ArenaState, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    arena_usable(s);\n");
        buf_str(out, c"    if size < 0 || size > ALLOC_LIMIT || !arena_align_ok(align) {\n");
        buf_str(out, c"        return 0 as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if size > ARENA_LARGE {\n");
        buf_str(out, c"        return arena_large_alloc(s.root, size, align);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var c = s.chunk.next;\n");
        buf_str(out, c"    if c == 0 as *ArenaChunk {\n");
        buf_str(out, c"        c = arena_new_chunk(s.root, s.chunk);\n");
        buf_str(out, c"        if c == 0 as *ArenaChunk {\n");
        buf_str(out, c"            return 0 as *u8;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    s.before += s.ptr - s.start;\n");
        buf_str(out, c"    s.chunk = c;\n");
        buf_str(out, c"    s.start = c as i64 + ARENA_CHUNK_HEAD;\n");
        buf_str(out, c"    s.end = c as i64 + c.size;\n");
        buf_str(out, c"    s.limit = s.end;\n");
        buf_str(out, c"    s.ptr = s.start;\n");
        buf_str(out, c"    s.last = -1;\n");
        buf_str(out, c"    // (a request up to ARENA_LARGE, aligned, fits in any next chunk)\n");
        buf_str(out, c"    arena_alloc(s, size, align)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Stops the program unless s is an arena that can allocate: not\n");
        buf_str(out, c"// Arena::none(), not lent to a scope.\n");
        buf_str(out, c"unsafe fn arena_usable(s: *ArenaState) {\n");
        buf_str(out, c"    if s == 0 as *ArenaState {\n");
        buf_str(out, c"        panic(c\"the arena has no memory: it is Arena::none()\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if s.lent {\n");
        buf_str(out, c"        panic(c\"the arena is lent to a scope: allocate from the scope's arena\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A new chunk from Gpa, after chunk `after` in root's list; null when out\n");
        buf_str(out, c"// of memory.\n");
        buf_str(out, c"unsafe fn arena_new_chunk(root: *ArenaState, after: *ArenaChunk) -> *ArenaChunk {\n");
        buf_str(out, c"    let size = root.next_size;\n");
        buf_str(out, c"    let g = Gpa {};\n");
        buf_str(out, c"    let c = g.try_alloc(size, 16) as *ArenaChunk;\n");
        buf_str(out, c"    if c == 0 as *ArenaChunk {\n");
        buf_str(out, c"        return c;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    c.size = size;\n");
        buf_str(out, c"    c.next = after.next;\n");
        buf_str(out, c"    after.next = c;\n");
        buf_str(out, c"    root.chunk_bytes += size;\n");
        buf_str(out, c"    if size < ARENA_MAX_CHUNK {\n");
        buf_str(out, c"        root.next_size = size * 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    c\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The bytes of a block of its own before it: its header, or the\n");
        buf_str(out, c"// alignment when that is more.\n");
        buf_str(out, c"fn arena_large_head(align: i64) -> i64 {\n");
        buf_str(out, c"    if align > 32 { align } else { 32 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A block of its own of size bytes from Gpa, at the front of root's list.\n");
        buf_str(out, c"unsafe fn arena_large_alloc(root: *ArenaState, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    let head = arena_large_head(align);\n");
        buf_str(out, c"    let g = Gpa {};\n");
        buf_str(out, c"    let c = g.try_alloc(head + size, if align > 16 { align } else { 16 });\n");
        buf_str(out, c"    if c == 0 as *u8 {\n");
        buf_str(out, c"        return c;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let p = &c[head];\n");
        buf_str(out, c"    let h = (&p[-32]) as *ArenaLarge;\n");
        buf_str(out, c"    h.size = size;\n");
        buf_str(out, c"    h.align = align;\n");
        buf_str(out, c"    h.prev = 0 as *ArenaLarge;\n");
        buf_str(out, c"    h.next = root.large;\n");
        buf_str(out, c"    if root.large != 0 as *ArenaLarge {\n");
        buf_str(out, c"        root.large.prev = h;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    root.large = h;\n");
        buf_str(out, c"    root.large_bytes += size;\n");
        buf_str(out, c"    root.chunk_bytes += head + size;\n");
        buf_str(out, c"    p\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Gives back block p, of its own, of root.\n");
        buf_str(out, c"unsafe fn arena_large_free(root: *ArenaState, p: *u8) {\n");
        buf_str(out, c"    let h = (&p[-32]) as *ArenaLarge;\n");
        buf_str(out, c"    let head = arena_large_head(h.align);\n");
        buf_str(out, c"    if h.prev == 0 as *ArenaLarge {\n");
        buf_str(out, c"        root.large = h.next;\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        h.prev.next = h.next;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if h.next != 0 as *ArenaLarge {\n");
        buf_str(out, c"        h.next.prev = h.prev;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    root.large_bytes -= h.size;\n");
        buf_str(out, c"    root.chunk_bytes -= head + h.size;\n");
        buf_str(out, c"    let g = Gpa {};\n");
        buf_str(out, c"    g.free(&p[-head], head + h.size, if h.align > 16 { h.align } else { 16 });\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Gives back the blocks of their own of root down to `mark` (the list's\n");
        buf_str(out, c"// front when a scope started), or all of them.\n");
        buf_str(out, c"unsafe fn arena_large_free_to(root: *ArenaState, mark: *ArenaLarge) {\n");
        buf_str(out, c"    for _ in 0..ALLOC_LIMIT {\n");
        buf_str(out, c"        let h = root.large;\n");
        buf_str(out, c"        if h == mark {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        arena_large_free(root, &(h as *u8)[32]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An Arena's or a ScopedArena's try_resize: the last block in place, a\n");
        buf_str(out, c"// block of its own with Gpa's resize, else moved.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn arena_resize(s: *ArenaState, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"    -> *u8 {\n");
        buf_str(out, c"    if CHECK_ALLOC {\n");
        buf_str(out, c"        return arena_resize_checked(s, p, old_size, new_size, align);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if s != 0 as *ArenaState && p as i64 == s.last && (new_size as u64) <= (ARENA_LARGE as u64)\n");
        buf_str(out, c"        && old_size <= ARENA_LARGE && p as i64 + new_size <= s.limit {\n");
        buf_str(out, c"        s.ptr = p as i64 + new_size;\n");
        buf_str(out, c"        return p;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    arena_resize_slow(s, p, old_size, new_size, align)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[cold]\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"unsafe fn arena_resize_slow(s: *ArenaState, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"    -> *u8 {\n");
        buf_str(out, c"    arena_usable(s);\n");
        buf_str(out, c"    if new_size < 0 || new_size > ALLOC_LIMIT || !arena_align_ok(align) {\n");
        buf_str(out, c"        return 0 as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if old_size > ARENA_LARGE && new_size > ARENA_LARGE {\n");
        buf_str(out, c"        // (a block of its own stays one: resized by Gpa, relinked)\n");
        buf_str(out, c"        let root = s.root;\n");
        buf_str(out, c"        let h = (&p[-32]) as *ArenaLarge;\n");
        buf_str(out, c"        let head = arena_large_head(align);\n");
        buf_str(out, c"        let g = Gpa {};\n");
        buf_str(out, c"        let c = g.try_resize(&p[-head], head + old_size, head + new_size,\n");
        buf_str(out, c"            if align > 16 { align } else { 16 });\n");
        buf_str(out, c"        if c == 0 as *u8 {\n");
        buf_str(out, c"            return c;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let q = &c[head];\n");
        buf_str(out, c"        let k = (&q[-32]) as *ArenaLarge;\n");
        buf_str(out, c"        if k.prev == 0 as *ArenaLarge {\n");
        buf_str(out, c"            root.large = k;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            k.prev.next = k;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k.next != 0 as *ArenaLarge {\n");
        buf_str(out, c"            k.next.prev = k;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        k.size = new_size;\n");
        buf_str(out, c"        root.large_bytes += new_size - old_size;\n");
        buf_str(out, c"        root.chunk_bytes += new_size - old_size;\n");
        buf_str(out, c"        return q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let q = arena_alloc(s, new_size, align);\n");
        buf_str(out, c"    if q == 0 as *u8 {\n");
        buf_str(out, c"        return q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let n = if old_size < new_size { old_size } else { new_size };\n");
        buf_str(out, c"    if n > 0 {\n");
        buf_str(out, c"        memcpy(q, p, n as u64);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    arena_free(s, p, old_size);\n");
        buf_str(out, c"    q\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// arena_resize with --check-alloc: the last block (the last live one of\n");
        buf_str(out, c"// the arena, as the bump's `last`) grows in place in the count and moves\n");
        buf_str(out, c"// to pages of its new size; any other as without.\n");
        buf_str(out, c"#[cold]\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"unsafe fn arena_resize_checked(s: *ArenaState, p: *u8, old_size: i64, new_size: i64,\n");
        buf_str(out, c"    align: i64) -> *u8 {\n");
        buf_str(out, c"    if s != 0 as *ArenaState && s.last != -1 && (new_size as u64) <= (ARENA_LARGE as u64)\n");
        buf_str(out, c"        && old_size <= ARENA_LARGE && s.last + new_size <= s.limit\n");
        buf_str(out, c"        && check_alloc_is_last(s.root as u64, p) {\n");
        buf_str(out, c"        let q = check_alloc_moved(s.root as u64, p, old_size, new_size, align);\n");
        buf_str(out, c"        if q != 0 as *u8 {\n");
        buf_str(out, c"            s.ptr = s.last + new_size;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    arena_resize_slow(s, p, old_size, new_size, align)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An Arena's or a ScopedArena's free: the last block goes back to the\n");
        buf_str(out, c"// bump, a block of its own to Gpa; any other waits for the arena's end.\n");
        buf_str(out, c"// Nothing while the arena is lent to a scope.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn arena_free(s: *ArenaState, p: *u8, size: i64) {\n");
        buf_str(out, c"    if s == 0 as *ArenaState || s.lent {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if size > ARENA_LARGE {\n");
        buf_str(out, c"        arena_large_free(s.root, p);\n");
        buf_str(out, c"    } else if CHECK_ALLOC {\n");
        buf_str(out, c"        // (the last live block of the arena is the bump's last; the block's\n");
        buf_str(out, c"        // pages go)\n");
        buf_str(out, c"        if s.last != -1 && check_alloc_is_last(s.root as u64, p) {\n");
        buf_str(out, c"            s.ptr = s.last;\n");
        buf_str(out, c"            s.last = -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        check_alloc_moved(s.root as u64, p, size, 0, 1);\n");
        buf_str(out, c"    } else if p as i64 == s.last {\n");
        buf_str(out, c"        s.ptr = s.last;\n");
        buf_str(out, c"        s.last = -1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The bytes allocated from state s (blocks of their own included).\n");
        buf_str(out, c"unsafe fn arena_used(s: *ArenaState) -> i64 {\n");
        buf_str(out, c"    s.before + s.ptr - s.start + s.root.large_bytes\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Allocator for Arena {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn try_alloc(self: *Arena, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        unsafe { arena_alloc(self.s, size, align) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn try_resize(self: *Arena, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        arena_resize(self.s, p, old_size, new_size, align)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn free(self: *Arena, p: *u8, size: i64, align: i64) {\n");
        buf_str(out, c"        arena_free(self.s, p, size);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arena {\n");
        buf_str(out, c"    // A new arena, its chunks from gpa: the first of 8 KB, the next\n");
        buf_str(out, c"    // ones twice as large each up to 4 MB.\n");
        buf_str(out, c"    pub fn new_in(gpa: Gpa) -> Arena {\n");
        buf_str(out, c"        Arena::with_capacity_in(ARENA_FIRST, gpa)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A new arena with room for `bytes` in its first chunk.\n");
        buf_str(out, c"    pub fn with_capacity_in(bytes: i64, gpa: Gpa) -> Arena {\n");
        buf_str(out, c"        let head = ARENA_CHUNK_HEAD + size_of(ArenaState);\n");
        buf_str(out, c"        let room = if bytes < 0 { 0 } else { bytes };\n");
        buf_str(out, c"        if room > ALLOC_LIMIT - head {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let size = head + room;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let c = gpa.alloc(size, 16) as *ArenaChunk;\n");
        buf_str(out, c"            c.next = 0 as *ArenaChunk;\n");
        buf_str(out, c"            c.size = size;\n");
        buf_str(out, c"            let s = (c as i64 + ARENA_CHUNK_HEAD) as *ArenaState;\n");
        buf_str(out, c"            s.start = c as i64 + head;\n");
        buf_str(out, c"            s.ptr = s.start;\n");
        buf_str(out, c"            s.end = c as i64 + size;\n");
        buf_str(out, c"            s.limit = s.end;\n");
        buf_str(out, c"            s.chunk = c;\n");
        buf_str(out, c"            s.last = -1;\n");
        buf_str(out, c"            s.before = 0;\n");
        buf_str(out, c"            s.lent = false;\n");
        buf_str(out, c"            s.root = s;\n");
        buf_str(out, c"            s.large_mark = 0 as *ArenaLarge;\n");
        buf_str(out, c"            s.first = c;\n");
        buf_str(out, c"            s.large = 0 as *ArenaLarge;\n");
        buf_str(out, c"            s.large_bytes = 0;\n");
        buf_str(out, c"            s.chunk_bytes = size;\n");
        buf_str(out, c"            s.next_size = ARENA_NEXT;\n");
        buf_str(out, c"            s.check_mark = 0;\n");
        buf_str(out, c"            Arena { s: s }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An arena that has no memory, a constant (for statics: `static mut\n");
        buf_str(out, c"    // V: Vec<i64, Arena> = Vec::new_in(Arena::none());`, set up in main\n");
        buf_str(out, c"    // with `Arena::new_in(gpa)`). Allocating from it stops the program.\n");
        buf_str(out, c"    pub fn none() -> Arena {\n");
        buf_str(out, c"        Arena { s: 0 as *ArenaState }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The bytes allocated from the arena since it was made or reset.\n");
        buf_str(out, c"    pub fn used(self) -> i64 {\n");
        buf_str(out, c"        if self.s == 0 as *ArenaState { 0 } else { unsafe { arena_used(self.s) } }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The bytes the arena holds from Gpa: its chunks and blocks.\n");
        buf_str(out, c"    pub fn chunk_bytes(self) -> i64 {\n");
        buf_str(out, c"        if self.s == 0 as *ArenaState { 0 } else { unsafe { self.s.chunk_bytes } }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Everything allocated from the arena is given back; its chunks are\n");
        buf_str(out, c"    // kept (blocks of their own go back to Gpa). Unsafe: what was\n");
        buf_str(out, c"    // allocated must not be used after.\n");
        buf_str(out, c"    pub unsafe fn reset(self: *Arena) {\n");
        buf_str(out, c"        let s = self.s;\n");
        buf_str(out, c"        if s == 0 as *ArenaState {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        arena_usable(s);\n");
        buf_str(out, c"        arena_large_free_to(s, 0 as *ArenaLarge);\n");
        buf_str(out, c"        if CHECK_ALLOC {\n");
        buf_str(out, c"            check_alloc_release(s as u64, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let c = s.first;\n");
        buf_str(out, c"        s.chunk = c;\n");
        buf_str(out, c"        s.start = c as i64 + ARENA_CHUNK_HEAD + size_of(ArenaState);\n");
        buf_str(out, c"        s.ptr = s.start;\n");
        buf_str(out, c"        s.end = c as i64 + c.size;\n");
        buf_str(out, c"        s.limit = s.end;\n");
        buf_str(out, c"        s.last = -1;\n");
        buf_str(out, c"        s.before = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The arena's memory, chunks included, given back to Gpa; this handle\n");
        buf_str(out, c"    // becomes Arena::none(). Unsafe: nothing allocated from it, and no\n");
        buf_str(out, c"    // copy of the handle, may be used after.\n");
        buf_str(out, c"    pub unsafe fn free_all(self: *Arena) {\n");
        buf_str(out, c"        let s = self.s;\n");
        buf_str(out, c"        if s == 0 as *ArenaState {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        arena_usable(s);\n");
        buf_str(out, c"        arena_large_free_to(s, 0 as *ArenaLarge);\n");
        buf_str(out, c"        if CHECK_ALLOC {\n");
        buf_str(out, c"            check_alloc_release(s as u64, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let g = Gpa {};\n");
        buf_str(out, c"        var c = s.first.next;\n");
        buf_str(out, c"        for _ in 0..ALLOC_LIMIT {\n");
        buf_str(out, c"            if c == 0 as *ArenaChunk {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let next = c.next;\n");
        buf_str(out, c"            g.free(c as *u8, c.size, 16);\n");
        buf_str(out, c"            c = next;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let first = s.first;\n");
        buf_str(out, c"        g.free(first as *u8, first.size, 16);\n");
        buf_str(out, c"        self.s = 0 as *ArenaState;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // f with a scope of this arena: what f allocates from the ScopedArena\n");
        buf_str(out, c"    // it is given is given back when f returns. The arena is lent\n");
        buf_str(out, c"    // meanwhile: allocating from it stops the program. Nothing on the\n");
        buf_str(out, c"    // ScopedArena can leave f (#[scoped]).\n");
        buf_str(out, c"    pub fn scope<R, F: FnMut(ScopedArena) -> R>(self, f: F) -> R {\n");
        buf_str(out, c"        unsafe { arena_scope_of(self.s, f) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An arena lent to a scope (arena_scope, Arena::scope): what is allocated\n");
        buf_str(out, c"// from it is given back when the scope ends, so nothing holding it can\n");
        buf_str(out, c"// leave the scope (#[scoped]: not returned, not captured by another\n");
        buf_str(out, c"// scope, not in a static).\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"#[scoped]\n");
        buf_str(out, c"pub struct ScopedArena { s: *ArenaState, mark: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Allocator for ScopedArena {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn try_alloc(self: *ScopedArena, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        unsafe { arena_alloc(self.s, size, align) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn try_resize(self: *ScopedArena, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"        -> *u8 {\n");
        buf_str(out, c"        arena_resize(self.s, p, old_size, new_size, align)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn free(self: *ScopedArena, p: *u8, size: i64, align: i64) {\n");
        buf_str(out, c"        arena_free(self.s, p, size);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl ScopedArena {\n");
        buf_str(out, c"    // The bytes allocated from this scope.\n");
        buf_str(out, c"    pub fn used(self) -> i64 {\n");
        buf_str(out, c"        unsafe { arena_used(self.s) - self.mark }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // f with a scope of this one (lent meanwhile), as Arena::scope.\n");
        buf_str(out, c"    pub fn scope<R, F: FnMut(ScopedArena) -> R>(self, f: F) -> R {\n");
        buf_str(out, c"        unsafe { arena_scope_of(self.s, f) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// f with a new arena, its chunks from gpa, given back when f returns.\n");
        buf_str(out, c"pub fn arena_scope<R, F: FnMut(ScopedArena) -> R>(gpa: Gpa, f: F) -> R {\n");
        buf_str(out, c"    var a = Arena::new_in(gpa);\n");
        buf_str(out, c"    // (arena_scope_of, not a.scope: the scoped check of a function passed\n");
        buf_str(out, c"    // by name is at the call of arena_scope, once)\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let r = arena_scope_of(a.s, f);\n");
        buf_str(out, c"        a.free_all();\n");
        buf_str(out, c"        r\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// f with a scope of the arena of state p: the scope's state starts where\n");
        buf_str(out, c"// p's is, p is lent (its limit 0) until f returns, then p's blocks of\n");
        buf_str(out, c"// their own made meanwhile go back.\n");
        buf_str(out, c"fn arena_scope_of<R, F: FnMut(ScopedArena) -> R>(p: *ArenaState, f: F) -> R {\n");
        buf_str(out, c"    var st = ArenaState {\n");
        buf_str(out, c"        ptr: 0, limit: 0, chunk: 0 as *ArenaChunk, start: 0, end: 0, last: -1, before: 0,\n");
        buf_str(out, c"        lent: false, root: 0 as *ArenaState, large_mark: 0 as *ArenaLarge,\n");
        buf_str(out, c"        first: 0 as *ArenaChunk, large: 0 as *ArenaLarge, large_bytes: 0, chunk_bytes: 0,\n");
        buf_str(out, c"        next_size: 0, check_mark: 0,\n");
        buf_str(out, c"    };\n");
        buf_str(out, c"    let mark = unsafe { arena_lend(p, &st) };\n");
        buf_str(out, c"    let site = if CHECK_ALLOC { check_alloc_site() } else { 0 as *u8 };\n");
        buf_str(out, c"    var g = f;\n");
        buf_str(out, c"    let r = g(ScopedArena { s: &st, mark: mark });\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        if CHECK_ALLOC {\n");
        buf_str(out, c"            check_alloc_set_site(site);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        arena_unlend(p, &st);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    r\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Lends the arena of state p to a scope of state st: st starts at p's\n");
        buf_str(out, c"// position, p is locked. Returns the bytes used at the start.\n");
        buf_str(out, c"unsafe fn arena_lend(p: *ArenaState, st: *ArenaState) -> i64 {\n");
        buf_str(out, c"    arena_usable(p);\n");
        buf_str(out, c"    st.ptr = p.ptr;\n");
        buf_str(out, c"    st.limit = p.limit;\n");
        buf_str(out, c"    st.chunk = p.chunk;\n");
        buf_str(out, c"    st.start = p.start;\n");
        buf_str(out, c"    st.end = p.end;\n");
        buf_str(out, c"    st.before = p.before;\n");
        buf_str(out, c"    st.root = p.root;\n");
        buf_str(out, c"    st.large_mark = p.root.large;\n");
        buf_str(out, c"    if CHECK_ALLOC {\n");
        buf_str(out, c"        st.check_mark = check_alloc_mark();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    p.lent = true;\n");
        buf_str(out, c"    p.limit = 0;\n");
        buf_str(out, c"    arena_used(st)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The scope of state st is over: its blocks of their own go back, and p,\n");
        buf_str(out, c"// where it was, is no longer lent (st's chunks are p's next ones).\n");
        buf_str(out, c"unsafe fn arena_unlend(p: *ArenaState, st: *ArenaState) {\n");
        buf_str(out, c"    arena_large_free_to(p.root, st.large_mark);\n");
        buf_str(out, c"    if CHECK_ALLOC {\n");
        buf_str(out, c"        // (the scope's blocks, and its scopes': p was locked meanwhile)\n");
        buf_str(out, c"        check_alloc_release(p.root as u64, st.check_mark);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    st.lent = true;\n");
        buf_str(out, c"    st.limit = 0;\n");
        buf_str(out, c"    p.lent = false;\n");
        buf_str(out, c"    p.limit = p.end;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- FixedBuf (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An allocator in a fixed buffer of bytes: `FixedBuf::new(mem[..])` over an\n");
        buf_str(out, c"// array or a Vec's view, which must outlive it (not checked). Blocks bump\n");
        buf_str(out, c"// through it; when it is full, try_alloc is null (out of memory). Its\n");
        buf_str(out, c"// first 16 bytes (from the first one aligned to 8) hold the bytes used and\n");
        buf_str(out, c"// the last block, so copies of the handle share them.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct FixedBuf { base: *u8, cap: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"const FIXED_HEAD: i64 = 16;\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Allocator for FixedBuf {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn try_alloc(self: *FixedBuf, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        // (self: the trait's raw `*Self`)\n");
        buf_str(out, c"        if unsafe { self.cap } == 0 || !arena_align_ok(align) {\n");
        buf_str(out, c"            return 0 as *u8;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let h = (&self.base[-FIXED_HEAD]) as *i64;\n");
        buf_str(out, c"            let b = self.base as i64;\n");
        buf_str(out, c"            let p = (b + h[0] + align - 1) & -align;\n");
        buf_str(out, c"            if size < 0 || size > ALLOC_LIMIT || p + size > b + self.cap {\n");
        buf_str(out, c"                return 0 as *u8;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            h[0] = p + size - b;\n");
        buf_str(out, c"            h[1] = p;\n");
        buf_str(out, c"            if CHECK_ALLOC {\n");
        buf_str(out, c"                // (the block's own pages; the bump keeps the count)\n");
        buf_str(out, c"                return check_alloc_block(self.base as u64, size, align);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            p as *u8\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn try_resize(self: *FixedBuf, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"        -> *u8 {\n");
        buf_str(out, c"        if self.cap == 0 || new_size < 0 || new_size > ALLOC_LIMIT {\n");
        buf_str(out, c"            return 0 as *u8;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let h = (&self.base[-FIXED_HEAD]) as *i64;\n");
        buf_str(out, c"        let b = self.base as i64;\n");
        buf_str(out, c"        if CHECK_ALLOC {\n");
        buf_str(out, c"            // (h[1] is the last block's place in the count; the block moves\n");
        buf_str(out, c"            // to pages of its new size)\n");
        buf_str(out, c"            let owner = self.base as u64;\n");
        buf_str(out, c"            if h[1] != -1 && h[1] + new_size <= b + self.cap && check_alloc_is_last(owner, p) {\n");
        buf_str(out, c"                let q = check_alloc_moved(owner, p, old_size, new_size, align);\n");
        buf_str(out, c"                if q != 0 as *u8 {\n");
        buf_str(out, c"                    h[0] = h[1] + new_size - b;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return q;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let q = self.try_alloc(new_size, align);\n");
        buf_str(out, c"            if q == 0 as *u8 {\n");
        buf_str(out, c"                return q;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let n = if old_size < new_size { old_size } else { new_size };\n");
        buf_str(out, c"            if n > 0 {\n");
        buf_str(out, c"                memcpy(q, p, n as u64);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            check_alloc_moved(owner, p, old_size, 0, align);\n");
        buf_str(out, c"            return q;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if p as i64 == h[1] && p as i64 + new_size <= b + self.cap {\n");
        buf_str(out, c"            h[0] = p as i64 + new_size - b;\n");
        buf_str(out, c"            return p;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let q = self.try_alloc(new_size, align);\n");
        buf_str(out, c"        if q == 0 as *u8 {\n");
        buf_str(out, c"            return q;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let n = if old_size < new_size { old_size } else { new_size };\n");
        buf_str(out, c"        if n > 0 {\n");
        buf_str(out, c"            memcpy(q, p, n as u64);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        q\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn free(self: *FixedBuf, p: *u8, size: i64, align: i64) {\n");
        buf_str(out, c"        if self.cap == 0 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let h = (&self.base[-FIXED_HEAD]) as *i64;\n");
        buf_str(out, c"        if CHECK_ALLOC {\n");
        buf_str(out, c"            let owner = self.base as u64;\n");
        buf_str(out, c"            if h[1] != -1 && check_alloc_is_last(owner, p) {\n");
        buf_str(out, c"                h[0] = h[1] - self.base as i64;\n");
        buf_str(out, c"                h[1] = -1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            check_alloc_moved(owner, p, size, 0, align);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if p as i64 == h[1] {\n");
        buf_str(out, c"            h[0] = p as i64 - self.base as i64;\n");
        buf_str(out, c"            h[1] = -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl FixedBuf {\n");
        buf_str(out, c"    // An allocator in mem (its first 16 bytes, from the first one aligned\n");
        buf_str(out, c"    // to 8, are its own; a smaller mem has no room).\n");
        buf_str(out, c"    pub fn new(mem: [u8]) -> FixedBuf {\n");
        buf_str(out, c"        let at = mem.ptr as i64;\n");
        buf_str(out, c"        let skip = ((at + 7) & -8) - at + FIXED_HEAD;\n");
        buf_str(out, c"        if mem.len <= skip {\n");
        buf_str(out, c"            return FixedBuf { base: 0 as *u8, cap: 0 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let base = &mem.ptr[skip];\n");
        buf_str(out, c"            let h = (&base[-FIXED_HEAD]) as *i64;\n");
        buf_str(out, c"            h[0] = 0;\n");
        buf_str(out, c"            h[1] = -1;\n");
        buf_str(out, c"            FixedBuf { base: base, cap: mem.len - skip }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The bytes allocated from it.\n");
        buf_str(out, c"    pub fn used(self) -> i64 {\n");
        buf_str(out, c"        if self.cap == 0 { 0 } else { unsafe { ((&self.base[-FIXED_HEAD]) as *i64)[0] } }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its bytes, for allocating from it again. Unsafe: what was allocated\n");
        buf_str(out, c"    // must not be used after.\n");
        buf_str(out, c"    pub unsafe fn reset(self: *FixedBuf) {\n");
        buf_str(out, c"        if self.cap != 0 {\n");
        buf_str(out, c"            let h = (&self.base[-FIXED_HEAD]) as *i64;\n");
        buf_str(out, c"            h[0] = 0;\n");
        buf_str(out, c"            h[1] = -1;\n");
        buf_str(out, c"            if CHECK_ALLOC {\n");
        buf_str(out, c"                check_alloc_release(self.base as u64, 0);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- The ambient Gpa of 0.15 (0.16, until the corpus is migrated) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// std's ambient constructors of 0.15 (`Vec::new()`, `collect()`...),\n");
        buf_str(out, c"// errors outside std, take their Gpa here, until `fix --only alloc016`\n");
        buf_str(out, c"// migrates the corpus (front/ambient.tach): not `pub`, it goes with them.\n");
        buf_str(out, c"trait Ambient { fn ambient() -> Self; }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ambient for Gpa {\n");
        buf_str(out, c"    #[ambient(\"a 'gpa: Gpa' parameter, from main's\")]\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn ambient() -> Gpa { Gpa {} }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Panic and unreachable, the prelude's (0.17) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The prelude's `panic(message)`: prints `message` on stderr and exits\n");
        buf_str(out, c"// with 101, as a failed check does; safe (the message is a slice, not the\n");
        buf_str(out, c"// C string of `std::panic`).\n");
        buf_str(out, c"pub fn panic_str(message: [u8]) -> ! {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        panic_write(2, message.ptr, message.len as u64);\n");
        buf_str(out, c"        panic_write(2, c\"\\n\", 1);\n");
        buf_str(out, c"        panic_exit(101)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The prelude's `unreachable()`: a place the program never reaches;\n");
        buf_str(out, c"// reached, it prints \"entered unreachable code\" and exits with 101.\n");
        buf_str(out, c"pub fn unreachable() -> ! {\n");
        buf_str(out, c"    panic_str(\"entered unreachable code\")\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) The prelude's `assert(c)`: `c` must hold; when it does not, the\n");
        buf_str(out, c"// program prints `FILE:LINE:COL: assertion failed: 'c'` with the values\n");
        buf_str(out, c"// of c's operands and exits with 101. `assert(c, \"message\")` prints the\n");
        buf_str(out, c"// message instead of c. The compiler makes each call a check.\n");
        buf_str(out, c"pub fn assert(ok: bool, message: [u8] = \"\") {\n");
        buf_str(out, c"    if !ok {\n");
        buf_str(out, c"        panic_str(message)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) The prelude's `assert_eq(a, b)`: `assert(a == b)`, which reports\n");
        buf_str(out, c"// both values.\n");
        buf_str(out, c"pub fn assert_eq<T: Eq>(a: sink T, b: sink T) {\n");
        buf_str(out, c"    if !(a == b) {\n");
        buf_str(out, c"        unreachable()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) The prelude's `assert_ne(a, b)`: `assert(a != b)`.\n");
        buf_str(out, c"pub fn assert_ne<T: Eq>(a: sink T, b: sink T) {\n");
        buf_str(out, c"    if a == b {\n");
        buf_str(out, c"        unreachable()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.18) The prelude's `debug_assert(c)`: `assert(c)` in test builds\n");
        buf_str(out, c"// (`tachyonc test`, --debug-contracts); nothing (c is not evaluated) in\n");
        buf_str(out, c"// others.\n");
        buf_str(out, c"pub fn debug_assert(ok: bool, message: [u8] = \"\") {\n");
        buf_str(out, c"    if !ok {\n");
        buf_str(out, c"        panic_str(message)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// std's values section (0.17): appended to std's text after alloc.tach\n");
        buf_str(out, c"// (compiler/std/embed.sh).\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Values (0.17) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Mutable value semantics (docs/design/value-semantics.md): the prelude's\n");
        buf_str(out, c"// Drop, drop, forget, needs_drop and Copy; std::take and std::replace.\n");
        buf_str(out, c"// (0.17: values move and drop, front/own; std's containers implement Drop\n");
        buf_str(out, c"// with T4.)\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What a value does when its owner goes out of scope: `impl Drop for T`.\n");
        buf_str(out, c"// Calling `x.drop()` yourself is an error; `drop(x)` ends x early.\n");
        buf_str(out, c"pub trait Drop {\n");
        buf_str(out, c"    fn drop(inout self);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Consumes x: its drop runs here, not at the end of its scope.\n");
        buf_str(out, c"pub fn drop<T>(x: sink T) {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Consumes x without running its drop: a leak, which is safe\n");
        buf_str(out, c"// (`--check-alloc` lists it).\n");
        buf_str(out, c"pub fn forget<T>(x: sink T) {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether a value of type T has a drop to run (a constant, folded where\n");
        buf_str(out, c"// it is called).\n");
        buf_str(out, c"pub fn needs_drop<T>() -> bool {\n");
        buf_str(out, c"    false\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `T: Copy` holds when T is plain: `=` copies it (numbers, bool, raw\n");
        buf_str(out, c"// pointers, fieldless enums, and aggregates of those). No type implements\n");
        buf_str(out, c"// it with an impl block.\n");
        buf_str(out, c"pub trait Copy {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A type's empty value: what std::take leaves behind.\n");
        buf_str(out, c"pub trait Default {\n");
        buf_str(out, c"    fn default() -> Self;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Exchanges *a and *b. (Bit for bit, as replace: a write through a raw\n");
        buf_str(out, c"// pointer drops nothing, so neither value is dropped or copied.)\n");
        buf_str(out, c"pub fn swap<T>(a: inout T, b: inout T) {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let pa: *T = &a;\n");
        buf_str(out, c"        let pb: *T = &b;\n");
        buf_str(out, c"        let t = *pa;\n");
        buf_str(out, c"        *pa = *pb;\n");
        buf_str(out, c"        *pb = t;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The value at *dest, replaced by value. (The old value moves out and the\n");
        buf_str(out, c"// new one in, bit for bit: a write through a raw pointer drops nothing.)\n");
        buf_str(out, c"pub fn replace<T>(dest: inout T, value: sink T) -> T {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let p: *T = &dest;\n");
        buf_str(out, c"        let old = *p;\n");
        buf_str(out, c"        *p = value;\n");
        buf_str(out, c"        old\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The value at *dest, replaced by T's empty value (`std::take(&mut\n");
        buf_str(out, c"// self.count)`). A container's empty value needs its allocator: Vec, Buf\n");
        buf_str(out, c"// and HashMap have `take` methods, `self.keys.take()`, which keep it.\n");
        buf_str(out, c"pub fn take<T: Default>(dest: inout T) -> T {\n");
        buf_str(out, c"    let empty: T = T::default();\n");
        buf_str(out, c"    replace(&dest, empty)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The empty values: 0, false, None.\n");
        buf_str(out, c"impl Default for i8 { fn default() -> i8 { 0 } }\n");
        buf_str(out, c"impl Default for i16 { fn default() -> i16 { 0 } }\n");
        buf_str(out, c"impl Default for i32 { fn default() -> i32 { 0 } }\n");
        buf_str(out, c"impl Default for i64 { fn default() -> i64 { 0 } }\n");
        buf_str(out, c"impl Default for u8 { fn default() -> u8 { 0 } }\n");
        buf_str(out, c"impl Default for u16 { fn default() -> u16 { 0 } }\n");
        buf_str(out, c"impl Default for u32 { fn default() -> u32 { 0 } }\n");
        buf_str(out, c"impl Default for u64 { fn default() -> u64 { 0 } }\n");
        buf_str(out, c"impl Default for f32 { fn default() -> f32 { 0.0 } }\n");
        buf_str(out, c"impl Default for f64 { fn default() -> f64 { 0.0 } }\n");
        buf_str(out, c"impl Default for bool { fn default() -> bool { false } }\n");
        buf_str(out, c"impl<T> Default for Option<T> { fn default() -> Option<T> { Option::None } }\n");
        buf_str(out, c"// ---- Testing (0.18) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What `#[property]` tests and `#[fuzz]` targets draw their values from,\n");
        buf_str(out, c"// and the runtime of a test build (docs/design/contracts-verification.md\n");
        buf_str(out, c"// §2.6, §2.7, 0.18 T2). `tachyonc test` builds the program with\n");
        buf_str(out, c"// `--test-build`: the compiler (front/tests) writes a `main` that runs the\n");
        buf_str(out, c"// test its arguments name, and a generator for each property's\n");
        buf_str(out, c"// parameters, built from their types (an `impl Arbitrary` where there is\n");
        buf_str(out, c"// one). A value is drawn from a choice sequence of u64s, and smaller\n");
        buf_str(out, c"// choices make simpler values (0: 0, false, empty, None, the first\n");
        buf_str(out, c"// variant): a failing case is shrunk by shortening and lowering its\n");
        buf_str(out, c"// sequence, then replaying it. Generators take `&mut Gen` (0.17).\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A type's own generator, used in place of the structural one.\n");
        buf_str(out, c"pub trait Arbitrary {\n");
        buf_str(out, c"    fn arbitrary(g: inout Gen) -> Self;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Gen {\n");
        buf_str(out, c"    choices: *u64, count: i64, at: i64, size: i64, gpa: Gpa, depth: i64,\n");
        buf_str(out, c"    showing: bool, report: i32, raw: bool,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Gen {\n");
        buf_str(out, c"    // An integer: 0, -1, 1, -2, 2, ... as the choice grows (the edges,\n");
        buf_str(out, c"    // i64::MIN and i64::MAX, are the largest choices).\n");
        buf_str(out, c"    pub fn int(inout self) -> i64 {\n");
        buf_str(out, c"        let c = self.draw();\n");
        buf_str(out, c"        ((c >> 1) as i64) ^ -((c & 1) as i64)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An integer in lo..=hi (lo first).\n");
        buf_str(out, c"    pub fn int_in(inout self, lo: i64, hi: i64) -> i64 {\n");
        buf_str(out, c"        let c = self.draw();\n");
        buf_str(out, c"        if hi <= lo {\n");
        buf_str(out, c"            return lo;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let span = (hi - lo) as u64 + 1;\n");
        buf_str(out, c"        if span == 0 {\n");
        buf_str(out, c"            return lo + c as i64;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        lo + (c % span) as i64\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // One of 0..n.\n");
        buf_str(out, c"    pub fn choose(inout self, n: i64) -> i64 {\n");
        buf_str(out, c"        let c = self.draw();\n");
        buf_str(out, c"        if n <= 1 { 0 } else { (c % n as u64) as i64 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn bool(inout self) -> bool {\n");
        buf_str(out, c"        self.draw() % 2 == 1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The size this case may grow to (it grows with the case number).\n");
        buf_str(out, c"    pub fn size(inout self) -> i64 {\n");
        buf_str(out, c"        self.size\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A text byte: letters and digits first, then spaces, punctuation,\n");
        buf_str(out, c"    // newlines and the rest.\n");
        buf_str(out, c"    pub fn text_byte(inout self) -> u8 {\n");
        buf_str(out, c"        let c = self.draw();\n");
        buf_str(out, c"        let common = \"abcdefghijklmnopqrstuvwxyz0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ\\n.,-_:;()+*/=\";\n");
        buf_str(out, c"        if c < 200 {\n");
        buf_str(out, c"            return common[(c % common.len as u64) as i64];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        (c % 256) as u8\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// x's `{:?}` text against tests/snapshots/MODULE__TEST__N.snap: a missing\n");
        buf_str(out, c"// file is written (a new snapshot, the test passes), a different one\n");
        buf_str(out, c"// fails with its first differing line; `tachyonc test --accept` writes\n");
        buf_str(out, c"// the current text.\n");
        buf_str(out, c"pub fn assert_snapshot<T: Debug>(x: sink T) {\n");
        buf_str(out, c"    let gpa = Gpa {};\n");
        buf_str(out, c"    TEST_SNAP_COUNT += 1;\n");
        buf_str(out, c"    var text = format_in(f\"{x:?}\", gpa);\n");
        buf_str(out, c"    text.push('\\n');\n");
        buf_str(out, c"    var path = Buf::new_in(gpa);\n");
        buf_str(out, c"    var shown = Buf::new_in(gpa);\n");
        buf_str(out, c"    if TEST_SNAPSHOTS != 0 as *u8 {\n");
        buf_str(out, c"        unsafe { path.push_cstr(TEST_SNAPSHOTS) };\n");
        buf_str(out, c"        path.push('/');\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        path.push_str(\"tests/\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    shown.push_str(\"tests/\");\n");
        buf_str(out, c"    path.push_str(\"snapshots\");\n");
        buf_str(out, c"    // (the tests directory, then its snapshots/)\n");
        buf_str(out, c"    var dir = Buf::new_in(gpa);\n");
        buf_str(out, c"    let at = path.len() - 10;\n");
        buf_str(out, c"    dir.push_str(path.as_slice()[0..at]);\n");
        buf_str(out, c"    dir.push(0);\n");
        buf_str(out, c"    unsafe { mkdir(dir.as_slice().ptr, 493) };\n");
        buf_str(out, c"    dir.clear();\n");
        buf_str(out, c"    dir.push_str(path.as_slice());\n");
        buf_str(out, c"    dir.push(0);\n");
        buf_str(out, c"    unsafe { mkdir(dir.as_slice().ptr, 493) };\n");
        buf_str(out, c"    dir.free();\n");
        buf_str(out, c"    var file = Buf::new_in(gpa);\n");
        buf_str(out, c"    file.push_str(\"/\");\n");
        buf_str(out, c"    let module = TEST_MODULE;\n");
        buf_str(out, c"    var i = 0;\n");
        buf_str(out, c"    while i < module.len {\n");
        buf_str(out, c"        if module[i] == ':' {\n");
        buf_str(out, c"            file.push_str(\"__\");\n");
        buf_str(out, c"            i += 2;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            file.push(module[i]);\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if module.len > 0 {\n");
        buf_str(out, c"        file.push_str(\"__\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    file.push_str(TEST_NAME);\n");
        buf_str(out, c"    file.push_str(\"__\");\n");
        buf_str(out, c"    file.push_int(TEST_SNAP_COUNT);\n");
        buf_str(out, c"    file.push_str(\".snap\");\n");
        buf_str(out, c"    path.push_str(file.as_slice());\n");
        buf_str(out, c"    shown.push_str(\"snapshots\");\n");
        buf_str(out, c"    shown.push_str(file.as_slice());\n");
        buf_str(out, c"    path.push(0);\n");
        buf_str(out, c"    let cpath = path.as_slice().ptr;\n");
        buf_str(out, c"    var old = Buf::new_in(gpa);\n");
        buf_str(out, c"    let had = unsafe { test_read_file(cpath, &old) };\n");
        buf_str(out, c"    if had && old.as_slice() == text.as_slice() {\n");
        buf_str(out, c"    } else if !had || TEST_ACCEPT {\n");
        buf_str(out, c"        if !unsafe { test_write_file(cpath, text.as_slice()) } {\n");
        buf_str(out, c"            eprintln(f\"snapshot {shown.as_slice()}: cannot write {path.as_slice()}\");\n");
        buf_str(out, c"            unsafe { exit(101) };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        println(\n");
        buf_str(out, c"            f\"tachyon-test: snapshot {if had { \"accepted\" } else { \"new\" }} {shown.as_slice()}\");\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        var k = 0;\n");
        buf_str(out, c"        while test_line(old.as_slice(), k) == test_line(text.as_slice(), k) {\n");
        buf_str(out, c"            k += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        eprintln(\n");
        buf_str(out, c"            f\"snapshot differs: {shown.as_slice()} line {k + 1}: '{test_line(old.as_slice(), k)}' expected, got '{test_line(text.as_slice(), k)}'\");\n");
        buf_str(out, c"        unsafe { exit(101) };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    text.free();\n");
        buf_str(out, c"    path.free();\n");
        buf_str(out, c"    shown.free();\n");
        buf_str(out, c"    file.free();\n");
        buf_str(out, c"    old.free();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- The test runtime's implementation (0.18) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A test build's main (front/tests makes it) runs one test: a #[test]\n");
        buf_str(out, c"// in the process, a property's cases each in a child process; the\n");
        buf_str(out, c"// generators of the types a property takes; snapshots' files.\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn fork() -> i32;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn waitpid(pid: i32, status: *i32, options: i32) -> i32;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn pipe(fds: *i32) -> i32;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn dup2(from: i32, to: i32) -> i32;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn close(fd: i32) -> i32;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn open(path: *u8, flags: i32) -> i32;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn creat(path: *u8, mode: u32) -> i32;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn mkdir(path: *u8, mode: u32) -> i32;\n");
        buf_str(out, c"    #[link_name = \"atexit\"]\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn test_atexit(f: extern \"C\" fn()) -> i32;\n");
        buf_str(out, c"    #[link_name = \"_exit\"]\n");
        buf_str(out, c"    #[effects(io, diverge)]\n");
        buf_str(out, c"    fn test_exit_now(code: i32) -> !;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Gen {\n");
        buf_str(out, c"    // The next choice: 0 past the end of the sequence (the simplest).\n");
        buf_str(out, c"    pub fn draw(inout self) -> u64 {\n");
        buf_str(out, c"        let k = self.at;\n");
        buf_str(out, c"        self.at += 1;\n");
        buf_str(out, c"        if k >= self.count {\n");
        buf_str(out, c"            return 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe { self.choices[k] }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether a collection of `len` elements gets one more.\n");
        buf_str(out, c"    pub fn more(inout self, len: i64) -> bool {\n");
        buf_str(out, c"        if len >= self.size || self.depth > 4 {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.draw() % 4 != 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // How deep a recursive type's generator is.\n");
        buf_str(out, c"    pub fn depth(inout self) -> i64 {\n");
        buf_str(out, c"        self.depth\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The allocator generated containers use.\n");
        buf_str(out, c"    pub fn gpa(inout self) -> Gpa {\n");
        buf_str(out, c"        self.gpa\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether this run is the replay of a failure (its inputs printed).\n");
        buf_str(out, c"    pub fn showing(inout self) -> bool {\n");
        buf_str(out, c"        self.showing\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The choices used so far, told to the runner (the generators are\n");
        buf_str(out, c"    // done; the property runs next).\n");
        buf_str(out, c"    pub fn generated(inout self) {\n");
        buf_str(out, c"        if self.report >= 0 {\n");
        buf_str(out, c"            var used = self.at;\n");
        buf_str(out, c"            unsafe { write(self.report, &used as *u8, 8) };\n");
        buf_str(out, c"            unsafe { close(self.report) };\n");
        buf_str(out, c"            self.report = -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A recursive type's generator goes one level down (shallower values\n");
        buf_str(out, c"    // past a depth).\n");
        buf_str(out, c"    pub fn enter(inout self) {\n");
        buf_str(out, c"        self.depth += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn leave(inout self) {\n");
        buf_str(out, c"        self.depth -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The generator of T: its `impl Arbitrary` (std's for the numbers and\n");
        buf_str(out, c"// bool, the compiler's for a test's structs and enums).\n");
        buf_str(out, c"pub fn arbitrary_of<T: Arbitrary>(g: inout Gen) -> T {\n");
        buf_str(out, c"    T::arbitrary(&g)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn gen_vec<T, F: Fn(inout Gen) -> T>(g: inout Gen, f: F) -> Vec<T> {\n");
        buf_str(out, c"    var v: Vec<T> = Vec::new_in(g.gpa);\n");
        buf_str(out, c"    g.enter();\n");
        buf_str(out, c"    while g.more(v.len()) {\n");
        buf_str(out, c"        v.push(f(g));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    g.leave();\n");
        buf_str(out, c"    v\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn gen_option<T, F: Fn(inout Gen) -> T>(g: inout Gen, f: F) -> Option<T> {\n");
        buf_str(out, c"    if g.draw() % 2 == 0 { Option::None } else { Option::Some(f(g)) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn gen_result<T, E, F: Fn(inout Gen) -> T,\n");
        buf_str(out, c"    G: Fn(inout Gen) -> E>(g: inout Gen, f: F, e: G) -> Result<T, E> {\n");
        buf_str(out, c"    if g.draw() % 2 == 0 { Result::Ok(f(g)) } else { Result::Err(e(g)) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn gen_text(g: inout Gen) -> Vec<u8> {\n");
        buf_str(out, c"    var v: Vec<u8> = Vec::new_in(g.gpa);\n");
        buf_str(out, c"    while g.more(v.len()) {\n");
        buf_str(out, c"        v.push(g.text_byte());\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn gen_buf(g: inout Gen) -> Buf {\n");
        buf_str(out, c"    var b = Buf::new_in(g.gpa);\n");
        buf_str(out, c"    while g.more(b.len()) {\n");
        buf_str(out, c"        b.push(g.text_byte());\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    b\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn gen_f64(g: inout Gen) -> f64 {\n");
        buf_str(out, c"    let c = g.draw();\n");
        buf_str(out, c"    if c < 6 {\n");
        buf_str(out, c"        let edges = [0.0, 1.0, -1.0, -0.0, 1.0 / 0.0, -1.0 / 0.0];\n");
        buf_str(out, c"        return edges[c as i64];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let n = ((c >> 1) as i64) ^ -((c & 1) as i64);\n");
        buf_str(out, c"    (n as f64) / 8.0\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for i64 {\n");
        buf_str(out, c"    fn arbitrary(g: inout Gen) -> i64 { g.int() }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for i32 {\n");
        buf_str(out, c"    fn arbitrary(g: inout Gen) -> i32 { g.int() as i32 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for i16 {\n");
        buf_str(out, c"    fn arbitrary(g: inout Gen) -> i16 { g.int() as i16 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for i8 {\n");
        buf_str(out, c"    fn arbitrary(g: inout Gen) -> i8 { g.int() as i8 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for u64 {\n");
        buf_str(out, c"    fn arbitrary(g: inout Gen) -> u64 { g.draw() }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for u32 {\n");
        buf_str(out, c"    fn arbitrary(g: inout Gen) -> u32 { g.draw() as u32 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for u16 {\n");
        buf_str(out, c"    fn arbitrary(g: inout Gen) -> u16 { g.draw() as u16 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for u8 {\n");
        buf_str(out, c"    fn arbitrary(g: inout Gen) -> u8 { g.draw() as u8 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for bool {\n");
        buf_str(out, c"    fn arbitrary(g: inout Gen) -> bool { g.bool() }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arbitrary for f64 {\n");
        buf_str(out, c"    fn arbitrary(g: inout Gen) -> f64 { gen_f64(&g) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What `tachyonc test` passes to a test binary: `--tachyon-test NAME`\n");
        buf_str(out, c"// (else `--tachyon-list`), `--cases N`, `--seed S`, `--snapshots DIR`,\n");
        buf_str(out, c"// `--accept`.\n");
        buf_str(out, c"static var TEST_CASES: i64 = 100;\n");
        buf_str(out, c"static var TEST_SEED: u64 = 0;\n");
        buf_str(out, c"static var TEST_SEED_SET: bool = false;\n");
        buf_str(out, c"static var TEST_SNAPSHOTS: *u8 = 0 as *u8;\n");
        buf_str(out, c"static var TEST_ACCEPT: bool = false;\n");
        buf_str(out, c"static var TEST_MODULE: [u8] = \"\";\n");
        buf_str(out, c"static var TEST_NAME: [u8] = \"\";\n");
        buf_str(out, c"static var TEST_SNAP_COUNT: i64 = 0;\n");
        buf_str(out, c"// (fuzzing, std/fuzz.tach) `--fuzz-time S`, `--fuzz-dir DIR`, `--replay\n");
        buf_str(out, c"// FILE` (repeated); whether the choices are an input's bytes.\n");
        buf_str(out, c"static var TEST_FUZZ_TIME: i64 = 0;\n");
        buf_str(out, c"static var TEST_FUZZ_DIR: *u8 = 0 as *u8;\n");
        buf_str(out, c"static var TEST_REPLAY: [*u8; 256] = [0 as *u8; 256];\n");
        buf_str(out, c"static var TEST_REPLAYS: i64 = 0;\n");
        buf_str(out, c"static var TEST_RAW: bool = false;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The exit status of a property case whose `requires` failed (discarded).\n");
        buf_str(out, c"const TEST_DISCARD: i32 = 77;\n");
        buf_str(out, c"\n");
        buf_str(out, c"unsafe fn test_arg(p: *u8) -> [u8] {\n");
        buf_str(out, c"    p[0..strlen(p) as i64]\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn test_number(s: [u8]) -> u64 {\n");
        buf_str(out, c"    var n: u64 = 0;\n");
        buf_str(out, c"    var i = 0;\n");
        buf_str(out, c"    var base: u64 = 10;\n");
        buf_str(out, c"    if s.len > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X') {\n");
        buf_str(out, c"        base = 16;\n");
        buf_str(out, c"        i = 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    while i < s.len {\n");
        buf_str(out, c"        let c = s[i];\n");
        buf_str(out, c"        let d = if c >= '0' && c <= '9' { (c - '0') as u64 }\n");
        buf_str(out, c"            else if c >= 'a' && c <= 'f' { (c - 'a') as u64 + 10 }\n");
        buf_str(out, c"            else if c >= 'A' && c <= 'F' { (c - 'A') as u64 + 10 }\n");
        buf_str(out, c"            else { 99 };\n");
        buf_str(out, c"        if d >= base {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        n = n * base + d;\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    n\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A test binary's arguments: the test to run (empty: list them).\n");
        buf_str(out, c"pub fn test_args(argc: i32, argv: **u8) -> [u8] {\n");
        buf_str(out, c"    var name: [u8] = \"\";\n");
        buf_str(out, c"    var i = 1;\n");
        buf_str(out, c"    while i < argc as i64 {\n");
        buf_str(out, c"        let a = unsafe { test_arg(argv[i]) };\n");
        buf_str(out, c"        let has_value = i + 1 < argc as i64;\n");
        buf_str(out, c"        if a == \"--tachyon-test\" && has_value {\n");
        buf_str(out, c"            name = unsafe { test_arg(argv[i + 1]) };\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        } else if a == \"--cases\" && has_value {\n");
        buf_str(out, c"            TEST_CASES = test_number(unsafe { test_arg(argv[i + 1]) }) as i64;\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        } else if a == \"--seed\" && has_value {\n");
        buf_str(out, c"            TEST_SEED = test_number(unsafe { test_arg(argv[i + 1]) });\n");
        buf_str(out, c"            TEST_SEED_SET = true;\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        } else if a == \"--snapshots\" && has_value {\n");
        buf_str(out, c"            TEST_SNAPSHOTS = unsafe { argv[i + 1] };\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        } else if a == \"--accept\" {\n");
        buf_str(out, c"            TEST_ACCEPT = true;\n");
        buf_str(out, c"        } else if a == \"--fuzz-time\" && has_value {\n");
        buf_str(out, c"            TEST_FUZZ_TIME = test_number(unsafe { test_arg(argv[i + 1]) }) as i64;\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        } else if a == \"--fuzz-dir\" && has_value {\n");
        buf_str(out, c"            TEST_FUZZ_DIR = unsafe { argv[i + 1] };\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        } else if a == \"--replay\" && has_value {\n");
        buf_str(out, c"            if TEST_REPLAYS < 256 {\n");
        buf_str(out, c"                TEST_REPLAY[TEST_REPLAYS] = unsafe { argv[i + 1] };\n");
        buf_str(out, c"                TEST_REPLAYS += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    name\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A test of module `module` (its path, `a::tests`) starts.\n");
        buf_str(out, c"pub fn test_begin(module: [u8], name: [u8], gpa: Gpa) {\n");
        buf_str(out, c"    TEST_MODULE = module;\n");
        buf_str(out, c"    TEST_NAME = name;\n");
        buf_str(out, c"    TEST_SNAP_COUNT = 0;\n");
        buf_str(out, c"    // (an allocation first: --check-alloc's handler at exit is then\n");
        buf_str(out, c"    // registered before test_at_exit, which runs before it)\n");
        buf_str(out, c"    var first: Vec<u8> = Vec::new_in(gpa);\n");
        buf_str(out, c"    first.push(0);\n");
        buf_str(out, c"    first.free();\n");
        buf_str(out, c"    test_running();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A test that ends the process (a failed check) ends it at once: the\n");
        buf_str(out, c"// leaks it leaves are not listed after its failure (exit 101).\n");
        buf_str(out, c"static var TEST_RUNNING: bool = false;\n");
        buf_str(out, c"static var TEST_HANDLER: bool = false;\n");
        buf_str(out, c"\n");
        buf_str(out, c"static var TEST_EXIT_CODE: i32 = 101;\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" fn test_at_exit() {\n");
        buf_str(out, c"    if TEST_RUNNING {\n");
        buf_str(out, c"        unsafe { test_exit_now(TEST_EXIT_CODE) };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// This process ends with `code`, before --check-alloc lists what it\n");
        buf_str(out, c"// leaves allocated (a runner's, not the test's).\n");
        buf_str(out, c"fn test_exit(code: i32) -> ! {\n");
        buf_str(out, c"    test_running();\n");
        buf_str(out, c"    TEST_EXIT_CODE = code;\n");
        buf_str(out, c"    unsafe { exit(code) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn test_running() {\n");
        buf_str(out, c"    if !TEST_HANDLER {\n");
        buf_str(out, c"        unsafe { test_atexit(test_at_exit) };\n");
        buf_str(out, c"        TEST_HANDLER = true;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    TEST_RUNNING = true;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A #[test] returned.\n");
        buf_str(out, c"pub fn test_done() {\n");
        buf_str(out, c"    TEST_RUNNING = false;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A test left blocks allocated (with --check-alloc, which test builds\n");
        buf_str(out, c"// use; they are listed): it fails.\n");
        buf_str(out, c"pub fn test_leaked() -> ! {\n");
        buf_str(out, c"    unsafe { exit(101) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A `#[test]` that returned Err(e): the error, exit 101.\n");
        buf_str(out, c"pub fn test_err<E: Debug>(e: sink E) -> ! {\n");
        buf_str(out, c"    eprintln(f\"test returned Err({e:?})\");\n");
        buf_str(out, c"    unsafe { exit(101) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn test_unknown(name: [u8]) -> i32 {\n");
        buf_str(out, c"    eprintln(f\"no test '{name}' in this program (--tachyon-list lists them)\");\n");
        buf_str(out, c"    2\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A property case whose `requires` does not hold: not a failure.\n");
        buf_str(out, c"pub fn test_discard() -> ! {\n");
        buf_str(out, c"    unsafe { test_exit_now(TEST_DISCARD) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The line that begins an input's value, when a failure is replayed.\n");
        buf_str(out, c"pub fn test_input(name: [u8]) {\n");
        buf_str(out, c"    print(f\"tachyon-test: input {name} = \");\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn test_input_end() {\n");
        buf_str(out, c"    println(\"\");\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The choices of a case (splitmix64 from the state): mostly small, some\n");
        buf_str(out, c"// edges, some anything.\n");
        buf_str(out, c"fn test_next(state: inout u64) -> u64 {\n");
        buf_str(out, c"    state = state + 0x9e3779b97f4a7c15;\n");
        buf_str(out, c"    var z = state;\n");
        buf_str(out, c"    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9;\n");
        buf_str(out, c"    z = (z ^ (z >> 27)) * 0x94d049bb133111eb;\n");
        buf_str(out, c"    z ^ (z >> 31)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn test_choice(state: inout u64, size: i64) -> u64 {\n");
        buf_str(out, c"    let r = test_next(&state);\n");
        buf_str(out, c"    let pick = r % 20;\n");
        buf_str(out, c"    if pick == 0 {\n");
        buf_str(out, c"        // (the edges: i64::MIN, i64::MAX, u64::MAX, a byte's)\n");
        buf_str(out, c"        let e = test_next(&state) % 5;\n");
        buf_str(out, c"        return if e == 0 { 0xffffffffffffffff } else if e == 1 { 0xfffffffffffffffe }\n");
        buf_str(out, c"            else if e == 2 { 255 } else if e == 3 { 256 } else { 0x8000000000000000 };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if pick < 3 {\n");
        buf_str(out, c"        return test_next(&state);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    test_next(&state) % (2 * size as u64 + 4)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn test_seed_of(name: [u8]) -> u64 {\n");
        buf_str(out, c"    if TEST_SEED_SET {\n");
        buf_str(out, c"        return TEST_SEED;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var h: u64 = 14695981039346656037;\n");
        buf_str(out, c"    for i in 0..name.len {\n");
        buf_str(out, c"        h = (h ^ name[i] as u64) * 1099511628211;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    h\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"struct CaseRun { status: i32, used: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Runs one case in a child process: its exit status (0 passed,\n");
        buf_str(out, c"// TEST_DISCARD discarded, else failed) and the choices it used.\n");
        buf_str(out, c"fn test_case<F: Fn(inout Gen)>(f: F, gpa: Gpa, choices: Vec<u64>, size: i64, quiet: bool) -> CaseRun {\n");
        buf_str(out, c"    var fds = [0 as i32, 0 as i32];\n");
        buf_str(out, c"    if unsafe { pipe(&fds[0]) } != 0 {\n");
        buf_str(out, c"        eprintln(\"tachyon-test: cannot make a pipe\");\n");
        buf_str(out, c"        unsafe { exit(2) };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let pid = unsafe { fork() };\n");
        buf_str(out, c"    if pid == 0 {\n");
        buf_str(out, c"        unsafe { close(fds[0]) };\n");
        buf_str(out, c"        if quiet {\n");
        buf_str(out, c"            let null = unsafe { open(c\"/dev/null\", 1) };\n");
        buf_str(out, c"            unsafe { dup2(null, 1) };\n");
        buf_str(out, c"            unsafe { dup2(null, 2) };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        test_running();\n");
        buf_str(out, c"        let s = choices.as_slice();\n");
        buf_str(out, c"        var g = Gen {\n");
        buf_str(out, c"            choices: s.ptr, count: s.len, at: 0, size: size, gpa: gpa, depth: 0,\n");
        buf_str(out, c"            showing: !quiet, report: fds[1], raw: TEST_RAW,\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        // (0.18 with 0.17's drops: the case's values are dropped by now, so\n");
        buf_str(out, c"        // a block it allocated and left is a leak; --check-alloc)\n");
        buf_str(out, c"        let mark = check_alloc_mark();\n");
        buf_str(out, c"        f(&g);\n");
        buf_str(out, c"        if check_alloc_leaks_since(mark) > 0 {\n");
        buf_str(out, c"            unsafe { test_exit_now(101) };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe { test_exit_now(0) };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe { close(fds[1]) };\n");
        buf_str(out, c"    var used: i64 = -1;\n");
        buf_str(out, c"    let n = unsafe { read(fds[0], &used as *u8, 8) };\n");
        buf_str(out, c"    unsafe { close(fds[0]) };\n");
        buf_str(out, c"    var status = 0 as i32;\n");
        buf_str(out, c"    unsafe { waitpid(pid, &status, 0) };\n");
        buf_str(out, c"    let s = status as i64;\n");
        buf_str(out, c"    let code = if (s & 127) == 0 { ((s >> 8) & 255) as i32 } else { 128 + (s & 127) as i32 };\n");
        buf_str(out, c"    CaseRun { status: code, used: if n == 8 && used >= 0 { used } else { choices.len() } }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn test_fails(r: CaseRun) -> bool {\n");
        buf_str(out, c"    r.status != 0 && r.status != TEST_DISCARD\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Candidate `c` replaces `best` when it fails too (cut to what it used).\n");
        buf_str(out, c"fn test_try<F: Fn(inout Gen)>(f: F, gpa: Gpa, best: inout Vec<u64>, c: Vec<u64>, size: i64,\n");
        buf_str(out, c"    steps: inout i64) -> bool {\n");
        buf_str(out, c"    let r = test_case(f, gpa, c, size, true);\n");
        buf_str(out, c"    if !test_fails(r) {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    steps = steps + 1;\n");
        buf_str(out, c"    best.clear();\n");
        buf_str(out, c"    let n = if r.used < c.len() { r.used } else { c.len() };\n");
        buf_str(out, c"    for i in 0..n {\n");
        buf_str(out, c"        best.push(c.get(i));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    true\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The failing choices `best` made smaller: chunks deleted, choices set to\n");
        buf_str(out, c"// zero, halved, lowered by one, neighbours put in order; to a fixpoint (or\n");
        buf_str(out, c"// 2000 candidates).\n");
        buf_str(out, c"fn test_shrink<F: Fn(inout Gen)>(f: F, gpa: Gpa, best: inout Vec<u64>, size: i64) -> i64 {\n");
        buf_str(out, c"    var steps = 0;\n");
        buf_str(out, c"    var tries = 0;\n");
        buf_str(out, c"    var c: Vec<u64> = Vec::new_in(gpa);\n");
        buf_str(out, c"    var changed = true;\n");
        buf_str(out, c"    while changed && tries < 2000 {\n");
        buf_str(out, c"        changed = false;\n");
        buf_str(out, c"        for k in [8, 4, 2, 1] {\n");
        buf_str(out, c"            var i = best.len() - k;\n");
        buf_str(out, c"            while i >= 0 && tries < 2000 {\n");
        buf_str(out, c"                c.clear();\n");
        buf_str(out, c"                for j in 0..best.len() {\n");
        buf_str(out, c"                    if j < i || j >= i + k {\n");
        buf_str(out, c"                        c.push(best.get(j));\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                tries += 1;\n");
        buf_str(out, c"                if test_try(f, gpa, &best, c, size, &steps) {\n");
        buf_str(out, c"                    changed = true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                i -= 1;\n");
        buf_str(out, c"                if i > best.len() - k {\n");
        buf_str(out, c"                    i = best.len() - k;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var i = 0;\n");
        buf_str(out, c"        while i < best.len() && tries < 2000 {\n");
        buf_str(out, c"            // lowered: to 0, else the smallest that still fails, by halves\n");
        buf_str(out, c"            var lo: u64 = 0;\n");
        buf_str(out, c"            var first = true;\n");
        buf_str(out, c"            while i < best.len() && best.get(i) > lo && tries < 2000 {\n");
        buf_str(out, c"                let v = best.get(i);\n");
        buf_str(out, c"                let w = if first { 0 } else { lo + (v - lo) / 2 };\n");
        buf_str(out, c"                first = false;\n");
        buf_str(out, c"                c.clear();\n");
        buf_str(out, c"                for j in 0..best.len() {\n");
        buf_str(out, c"                    c.push(if j == i { w } else { best.get(j) });\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                tries += 1;\n");
        buf_str(out, c"                if test_try(f, gpa, &best, c, size, &steps) {\n");
        buf_str(out, c"                    changed = true;\n");
        buf_str(out, c"                } else if w == lo {\n");
        buf_str(out, c"                    lo = w + 1;\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    lo = w;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if i + 1 < best.len() && best.get(i) > best.get(i + 1) {\n");
        buf_str(out, c"                c.clear();\n");
        buf_str(out, c"                for j in 0..best.len() {\n");
        buf_str(out, c"                    c.push(if j == i { best.get(i + 1) } else if j == i + 1 { best.get(i) }\n");
        buf_str(out, c"                        else { best.get(j) });\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                tries += 1;\n");
        buf_str(out, c"                if test_try(f, gpa, &best, c, size, &steps) {\n");
        buf_str(out, c"                    changed = true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    c.free();\n");
        buf_str(out, c"    steps\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A property: TEST_CASES cases (the first all zeros: the simplest\n");
        buf_str(out, c"// values), each in a child process; the first failure is shrunk, then\n");
        buf_str(out, c"// replayed with its inputs printed; exit 1. `tachyon-test:` lines on\n");
        buf_str(out, c"// stdout tell `tachyonc test` the case and the steps.\n");
        buf_str(out, c"pub fn run_property<F: Fn(inout Gen)>(gpa: Gpa, name: [u8], f: F) {\n");
        buf_str(out, c"    // (the cases run in children; this process ends normally)\n");
        buf_str(out, c"    test_done();\n");
        buf_str(out, c"    let seed = test_seed_of(name);\n");
        buf_str(out, c"    let cases = if TEST_CASES > 0 { TEST_CASES } else { 1 };\n");
        buf_str(out, c"    var state = seed;\n");
        buf_str(out, c"    var choices: Vec<u64> = Vec::new_in(gpa);\n");
        buf_str(out, c"    var discarded = 0;\n");
        buf_str(out, c"    for case in 0..cases {\n");
        buf_str(out, c"        // (sizes grow over 100 cases, whatever --cases: -O0 runs the first\n");
        buf_str(out, c"        // 20 of -O2's)\n");
        buf_str(out, c"        let size = 1 + (if case < 100 { case } else { 99 }) * 30 / 100;\n");
        buf_str(out, c"        choices.clear();\n");
        buf_str(out, c"        if case > 0 {\n");
        buf_str(out, c"            for _ in 0..512 {\n");
        buf_str(out, c"                choices.push(test_choice(&state, size));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let r = test_case(f, gpa, choices, size, true);\n");
        buf_str(out, c"        if r.status == TEST_DISCARD {\n");
        buf_str(out, c"            discarded += 1;\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if r.status != 0 {\n");
        buf_str(out, c"            choices.truncate(if r.used < choices.len() { r.used } else { choices.len() });\n");
        buf_str(out, c"            let steps = test_shrink(f, gpa, &choices, size);\n");
        buf_str(out, c"            println(\n");
        buf_str(out, c"                f\"tachyon-test: property case {case + 1} of {cases}, shrunk in {steps} {if steps == 1 { \"step\" } else { \"steps\" }}, seed {seed:x}\");\n");
        buf_str(out, c"            test_case(f, gpa, choices, size, false);\n");
        buf_str(out, c"            test_exit(1);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if discarded * 10 > cases * 9 {\n");
        buf_str(out, c"        println(f\"tachyon-test: discarded {discarded} of {cases}\");\n");
        buf_str(out, c"        eprintln(\n");
        buf_str(out, c"            f\"the generator rarely satisfies the requires: {discarded} of {cases} cases discarded (write an impl Arbitrary for the parameter's type)\");\n");
        buf_str(out, c"        test_exit(1);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    choices.free();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (snapshots)\n");
        buf_str(out, c"\n");
        buf_str(out, c"unsafe fn test_read_file(path: *u8, b: *Buf) -> bool {\n");
        buf_str(out, c"    let fd = open(path, 0);\n");
        buf_str(out, c"    if fd < 0 {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var chunk = [0 as u8; 4096];\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        let n = unsafe { read(fd, &chunk[0], 4096) };\n");
        buf_str(out, c"        if n <= 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b.push_str(chunk[0..n]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe { close(fd) };\n");
        buf_str(out, c"    true\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"unsafe fn test_write_file(path: *u8, text: [u8]) -> bool {\n");
        buf_str(out, c"    let fd = creat(path, 420);\n");
        buf_str(out, c"    if fd < 0 {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe { write(fd, text.ptr, text.len as u64) };\n");
        buf_str(out, c"    unsafe { close(fd) };\n");
        buf_str(out, c"    true\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The line `k` (from 0) of s, and whether there is one.\n");
        buf_str(out, c"fn test_line(s: [u8], k: i64) -> [u8] {\n");
        buf_str(out, c"    var at = 0;\n");
        buf_str(out, c"    var line = 0;\n");
        buf_str(out, c"    while at <= s.len {\n");
        buf_str(out, c"        var e = at;\n");
        buf_str(out, c"        while e < s.len && s[e] != '\\n' {\n");
        buf_str(out, c"            e += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if line == k {\n");
        buf_str(out, c"            return s[at..e];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        line += 1;\n");
        buf_str(out, c"        at = e + 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    \"\"\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Non-null pointers (0.18) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A pointer that is never null (docs/design/contracts-verification.md\n");
        buf_str(out, c"// §2.11): a distinct type over `*T`. `p as *T` converts for free; `q as\n");
        buf_str(out, c"// NonNull<T>` checks q, a null q a run-time failure (exit 101), so that\n");
        buf_str(out, c"// the niche never reads `Some(q)` as None; NonNull::new is the\n");
        buf_str(out, c"// conversion that may fail. A C function's `_Nonnull` result is the C\n");
        buf_str(out, c"// side's promise: calling C is unsafe, and the caller vouches for it. `Option<NonNull<T>>`\n");
        buf_str(out, c"// is one pointer, None the null one, as C's nullable pointers are (the\n");
        buf_str(out, c"// null niche, front/distinct.tach); an `extern \"C\"` signature may take\n");
        buf_str(out, c"// either. Dereferencing stays unsafe, as for any raw pointer: NonNull is\n");
        buf_str(out, c"// for pointers that are stored (the fields of unsafe data structures) and\n");
        buf_str(out, c"// for C. `*T` has `is_null()`.\n");
        buf_str(out, c"pub type NonNull<T> = distinct *T invariant self as u64 != 0 else \"null pointer made NonNull\";\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> NonNull<T> {\n");
        buf_str(out, c"    // p, unless it is null (`mut`: a raw pointer, which may be null, not\n");
        buf_str(out, c"    // a borrow).\n");
        buf_str(out, c"    pub fn new(p: sink * T) -> Option<NonNull<T>> {\n");
        buf_str(out, c"        if p as u64 == 0 { Option::None } else { Option::Some(p as NonNull<T>) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The pointer, as a raw one.\n");
        buf_str(out, c"    pub fn as_ptr(sink self) -> *T {\n");
        buf_str(out, c"        self as *T\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- The fuzzer's implementation (0.18) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `#[fuzz]` functions (docs/design/contracts-verification.md §2.8, 0.18\n");
        buf_str(out, c"// T3): a property whose choice sequence is an input's bytes, one choice\n");
        buf_str(out, c"// per byte. `tachyonc fuzz NAME` runs it on inputs it mutates and keeps\n");
        buf_str(out, c"// those that reach new code (--coverage's counters, below); `tachyonc\n");
        buf_str(out, c"// test` runs it as a property and on its saved inputs. A `[u8]`\n");
        buf_str(out, c"// parameter is the input itself (gen_bytes).\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Coverage counters (T3, --coverage): the compiler (middle/coverage.tach)\n");
        buf_str(out, c"// makes each block of the program count in COVERAGE_MAP as it runs.\n");
        buf_str(out, c"pub static var COVERAGE_MAP: [u8; 65536] = [0; 65536];\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The counters (all zero in a program built without --coverage).\n");
        buf_str(out, c"pub fn coverage() -> [u8] {\n");
        buf_str(out, c"    COVERAGE_MAP[0..65536]\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn coverage_reset() {\n");
        buf_str(out, c"    for i in 0..65536 {\n");
        buf_str(out, c"        COVERAGE_MAP[i] = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[link_name = \"time\"]\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn fuzz_time(t: *i64) -> i64;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An input's bytes: all of them when the choices are an input's\n");
        buf_str(out, c"// (fuzzing, a saved input), else a generated text of bytes.\n");
        buf_str(out, c"pub fn gen_bytes(g: inout Gen) -> Vec<u8> {\n");
        buf_str(out, c"    var v: Vec<u8> = Vec::new_in(g.gpa);\n");
        buf_str(out, c"    if g.raw {\n");
        buf_str(out, c"        while g.at < g.count {\n");
        buf_str(out, c"            v.push(g.draw() as u8);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return v;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    while g.more(v.len()) {\n");
        buf_str(out, c"        v.push(g.draw() as u8);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A run of one input in a child process: its status, the choices it used,\n");
        buf_str(out, c"// and (when it returned) its coverage, into `cov`.\n");
        buf_str(out, c"fn fuzz_exec<F: Fn(inout Gen)>(f: F, gpa: Gpa, input: Vec<u64>, cov: [u8]) -> CaseRun {\n");
        buf_str(out, c"    var fds = [0 as i32, 0 as i32];\n");
        buf_str(out, c"    var cfds = [0 as i32, 0 as i32];\n");
        buf_str(out, c"    if unsafe { pipe(&fds[0]) } != 0 || unsafe { pipe(&cfds[0]) } != 0 {\n");
        buf_str(out, c"        eprintln(\"tachyon-test: cannot make a pipe\");\n");
        buf_str(out, c"        unsafe { exit(2) };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let pid = unsafe { fork() };\n");
        buf_str(out, c"    if pid == 0 {\n");
        buf_str(out, c"        unsafe { close(fds[0]) };\n");
        buf_str(out, c"        unsafe { close(cfds[0]) };\n");
        buf_str(out, c"        let null = unsafe { open(c\"/dev/null\", 1) };\n");
        buf_str(out, c"        unsafe { dup2(null, 1) };\n");
        buf_str(out, c"        unsafe { dup2(null, 2) };\n");
        buf_str(out, c"        test_running();\n");
        buf_str(out, c"        coverage_reset();\n");
        buf_str(out, c"        let s = input.as_slice();\n");
        buf_str(out, c"        var g = Gen {\n");
        buf_str(out, c"            choices: s.ptr, count: s.len, at: 0, size: 64, gpa: gpa, depth: 0, showing: false,\n");
        buf_str(out, c"            report: fds[1], raw: true,\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        // (0.18 with 0.17's drops: the case's values are dropped by now, so\n");
        buf_str(out, c"        // a block it allocated and left is a leak; --check-alloc)\n");
        buf_str(out, c"        let mark = check_alloc_mark();\n");
        buf_str(out, c"        f(&g);\n");
        buf_str(out, c"        if check_alloc_leaks_since(mark) > 0 {\n");
        buf_str(out, c"            unsafe { test_exit_now(101) };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe { write(cfds[1], &COVERAGE_MAP[0], 65536) };\n");
        buf_str(out, c"        unsafe { test_exit_now(0) };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe { close(fds[1]) };\n");
        buf_str(out, c"    unsafe { close(cfds[1]) };\n");
        buf_str(out, c"    var used: i64 = -1;\n");
        buf_str(out, c"    let n = unsafe { read(fds[0], &used as *u8, 8) };\n");
        buf_str(out, c"    unsafe { close(fds[0]) };\n");
        buf_str(out, c"    var got = 0;\n");
        buf_str(out, c"    for i in 0..65536 {\n");
        buf_str(out, c"        cov[i] = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        let k = unsafe { read(cfds[0], &cov[got], (65536 - got) as u64) };\n");
        buf_str(out, c"        if k <= 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        got += k;\n");
        buf_str(out, c"        if got >= 65536 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe { close(cfds[0]) };\n");
        buf_str(out, c"    var status = 0 as i32;\n");
        buf_str(out, c"    unsafe { waitpid(pid, &status, 0) };\n");
        buf_str(out, c"    let st = status as i64;\n");
        buf_str(out, c"    let code = if (st & 127) == 0 { ((st >> 8) & 255) as i32 } else { 128 + (st & 127) as i32 };\n");
        buf_str(out, c"    CaseRun { status: code, used: if n == 8 && used >= 0 { used } else { input.len() } }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// AFL's buckets of a count: 1, 2, 3, 4-7, 8-15, 16-31, 32-127, 128-255.\n");
        buf_str(out, c"fn fuzz_bucket(c: u8) -> u8 {\n");
        buf_str(out, c"    if c == 0 { 0 } else if c == 1 { 1 } else if c == 2 { 2 } else if c == 3 { 4 }\n");
        buf_str(out, c"    else if c < 8 { 8 } else if c < 16 { 16 } else if c < 32 { 32 } else if c < 128 { 64 }\n");
        buf_str(out, c"    else { 128 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether `cov` reaches a block (or a block's count) `seen` has not seen;\n");
        buf_str(out, c"// `seen` takes it in.\n");
        buf_str(out, c"fn fuzz_new_coverage(cov: [u8], seen: [u8]) -> bool {\n");
        buf_str(out, c"    var new = false;\n");
        buf_str(out, c"    for i in 0..65536 {\n");
        buf_str(out, c"        let c = cov[i];\n");
        buf_str(out, c"        if c != 0 {\n");
        buf_str(out, c"            let b = fuzz_bucket(c);\n");
        buf_str(out, c"            if (b & ~seen[i]) != 0 {\n");
        buf_str(out, c"                seen[i] = seen[i] | b;\n");
        buf_str(out, c"                new = true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    new\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The program's text constants a mutation may put in an input (the\n");
        buf_str(out, c"// compiler gives them, front/tests).\n");
        buf_str(out, c"static var FUZZ_WORDS: [[u8]; 64] = [\"\"; 64];\n");
        buf_str(out, c"static var FUZZ_WORD_COUNT: i64 = 0;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn fuzz_word(w: [u8]) {\n");
        buf_str(out, c"    if FUZZ_WORD_COUNT < 64 && w.len > 0 && w.len <= 32 {\n");
        buf_str(out, c"        FUZZ_WORDS[FUZZ_WORD_COUNT] = w;\n");
        buf_str(out, c"        FUZZ_WORD_COUNT += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// One mutation of `v` (bytes as choices), from the random state; `other`\n");
        buf_str(out, c"// is another input of the corpus (for a splice).\n");
        buf_str(out, c"fn fuzz_mutate(v: inout Vec<u64>, other: Vec<u64>, state: inout u64) {\n");
        buf_str(out, c"    let len = v.len();\n");
        buf_str(out, c"    let r = test_next(&state);\n");
        buf_str(out, c"    let how = r % 10;\n");
        buf_str(out, c"    let at = if len > 0 { ((r >> 8) % len as u64) as i64 } else { 0 };\n");
        buf_str(out, c"    if len == 0 || how == 0 {\n");
        buf_str(out, c"        // a byte inserted\n");
        buf_str(out, c"        let b = test_next(&state) % 256;\n");
        buf_str(out, c"        if len >= 4096 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        &v.insert(if len > 0 { at } else { 0 }, b);\n");
        buf_str(out, c"    } else if how == 1 {\n");
        buf_str(out, c"        // a bit flipped\n");
        buf_str(out, c"        &v.set(at, v.get(at) ^ (1 << (test_next(&state) % 8)));\n");
        buf_str(out, c"    } else if how == 2 {\n");
        buf_str(out, c"        let interesting: [u64; 10] = [0, 1, 0x7f, 0x80, 0xff, 48, 97, 32, 10, 255];\n");
        buf_str(out, c"        &v.set(at, interesting[(test_next(&state) % 10) as i64]);\n");
        buf_str(out, c"    } else if how == 3 {\n");
        buf_str(out, c"        &v.set(at, test_next(&state) % 256);\n");
        buf_str(out, c"    } else if how == 4 {\n");
        buf_str(out, c"        // a run deleted\n");
        buf_str(out, c"        let n = 1 + (test_next(&state) % 4) as i64;\n");
        buf_str(out, c"        var k = 0;\n");
        buf_str(out, c"        while k < n && at < v.len() {\n");
        buf_str(out, c"            &v.remove(at);\n");
        buf_str(out, c"            k += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else if how == 5 {\n");
        buf_str(out, c"        // a byte changed by a little\n");
        buf_str(out, c"        let d = test_next(&state) % 16;\n");
        buf_str(out, c"        &v.set(at, (v.get(at) + d + 240) % 256);\n");
        buf_str(out, c"    } else if how == 6 && other.len() > 0 {\n");
        buf_str(out, c"        // a splice: this input's start, the other's end\n");
        buf_str(out, c"        let cut = (test_next(&state) % other.len() as u64) as i64;\n");
        buf_str(out, c"        v.truncate(at);\n");
        buf_str(out, c"        for i in cut..other.len() {\n");
        buf_str(out, c"            if v.len() < 4096 {\n");
        buf_str(out, c"                v.push(other.get(i));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else if how == 7 && FUZZ_WORD_COUNT > 0 {\n");
        buf_str(out, c"        // a text constant of the program\n");
        buf_str(out, c"        let w = FUZZ_WORDS[(test_next(&state) % FUZZ_WORD_COUNT as u64) as i64];\n");
        buf_str(out, c"        for i in 0..w.len {\n");
        buf_str(out, c"            if v.len() < 4096 {\n");
        buf_str(out, c"                &v.insert(at + i, w[i] as u64);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else if how == 8 && len < 4096 {\n");
        buf_str(out, c"        // a run repeated\n");
        buf_str(out, c"        let n = 1 + (test_next(&state) % 8) as i64;\n");
        buf_str(out, c"        var k = 0;\n");
        buf_str(out, c"        while k < n && at + k < len && v.len() < 4096 {\n");
        buf_str(out, c"            let to = if at + n + k < v.len() { at + n + k } else { v.len() };\n");
        buf_str(out, c"            &v.insert(to, v.get(at + k));\n");
        buf_str(out, c"            k += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        &v.set(at, test_next(&state) % 256);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn fuzz_hash(v: Vec<u64>) -> u64 {\n");
        buf_str(out, c"    var h: u64 = 14695981039346656037;\n");
        buf_str(out, c"    for i in 0..v.len() {\n");
        buf_str(out, c"        h = (h ^ v.get(i)) * 1099511628211;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    h\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Input v saved as DIR/PREFIXHASH (bytes): its path.\n");
        buf_str(out, c"fn fuzz_save(gpa: Gpa, v: Vec<u64>, prefix: [u8]) -> Buf {\n");
        buf_str(out, c"    var path = Buf::new_in(gpa);\n");
        buf_str(out, c"    if TEST_FUZZ_DIR != 0 as *u8 {\n");
        buf_str(out, c"        unsafe { path.push_cstr(TEST_FUZZ_DIR) };\n");
        buf_str(out, c"        path.push('/');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    path.push_str(prefix);\n");
        buf_str(out, c"    let h = fuzz_hash(v);\n");
        buf_str(out, c"    let digits = \"0123456789abcdef\";\n");
        buf_str(out, c"    for k in 0..16 {\n");
        buf_str(out, c"        path.push(digits[((h >> (60 - 4 * k as u64)) & 15) as i64]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var bytes = Buf::new_in(gpa);\n");
        buf_str(out, c"    for i in 0..v.len() {\n");
        buf_str(out, c"        bytes.push(v.get(i) as u8);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var c = Buf::new_in(gpa);\n");
        buf_str(out, c"    c.push_str(path.as_slice());\n");
        buf_str(out, c"    c.push(0);\n");
        buf_str(out, c"    unsafe { test_write_file(c.as_slice().ptr, bytes.as_slice()) };\n");
        buf_str(out, c"    c.free();\n");
        buf_str(out, c"    bytes.free();\n");
        buf_str(out, c"    path\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"unsafe fn fuzz_load(gpa: Gpa, path: *u8, into: *Vec<u64>) -> bool {\n");
        buf_str(out, c"    var b = Buf::new_in(gpa);\n");
        buf_str(out, c"    let ok = test_read_file(path, &b);\n");
        buf_str(out, c"    into.clear();\n");
        buf_str(out, c"    let s = b.as_slice();\n");
        buf_str(out, c"    for i in 0..s.len {\n");
        buf_str(out, c"        into.push(s[i] as u64);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    b.free();\n");
        buf_str(out, c"    ok\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A failing input: shrunk, saved, replayed with its inputs printed; exit 1.\n");
        buf_str(out, c"fn fuzz_failed<F: Fn(inout Gen)>(f: F, gpa: Gpa, input: inout Vec<u64>, runs: i64) -> ! {\n");
        buf_str(out, c"    TEST_RAW = true;\n");
        buf_str(out, c"    let steps = test_shrink(f, gpa, &input, 64);\n");
        buf_str(out, c"    let path = fuzz_save(gpa, input, \"crash-\");\n");
        buf_str(out, c"    println(\n");
        buf_str(out, c"        f\"tachyon-test: property after {runs} runs, shrunk in {steps} {if steps == 1 { \"step\" } else { \"steps\" }}\");\n");
        buf_str(out, c"    println(f\"tachyon-test: saved {path.as_slice()}\");\n");
        buf_str(out, c"    test_case(f, gpa, input, 64, false);\n");
        buf_str(out, c"    test_exit(1)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A fuzz target: fuzzed for --fuzz-time seconds (tachyonc fuzz), else run\n");
        buf_str(out, c"// on its saved inputs (--replay), then as a property.\n");
        buf_str(out, c"pub fn run_fuzz_target<F: Fn(inout Gen)>(gpa: Gpa, name: [u8], f: F) {\n");
        buf_str(out, c"    test_done();\n");
        buf_str(out, c"    var input: Vec<u64> = Vec::new_in(gpa);\n");
        buf_str(out, c"    if TEST_FUZZ_TIME <= 0 {\n");
        buf_str(out, c"        TEST_RAW = true;\n");
        buf_str(out, c"        for k in 0..TEST_REPLAYS {\n");
        buf_str(out, c"            if !unsafe { fuzz_load(gpa, TEST_REPLAY[k], &input) } {\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let r = test_case(f, gpa, input, 64, true);\n");
        buf_str(out, c"            if test_fails(r) {\n");
        buf_str(out, c"                let p = unsafe { test_arg(TEST_REPLAY[k]) };\n");
        buf_str(out, c"                println(f\"tachyon-test: property input {p}\");\n");
        buf_str(out, c"                test_case(f, gpa, input, 64, false);\n");
        buf_str(out, c"                test_exit(1);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        TEST_RAW = false;\n");
        buf_str(out, c"        input.free();\n");
        buf_str(out, c"        run_property(gpa, name, f);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // the corpus: the saved inputs, and the empty one\n");
        buf_str(out, c"    var corpus: Vec<Vec<u64>> = Vec::new_in(gpa);\n");
        buf_str(out, c"    var seen = [0 as u8; 65536];\n");
        buf_str(out, c"    var cov = [0 as u8; 65536];\n");
        buf_str(out, c"    let empty: Vec<u64> = Vec::new_in(gpa);\n");
        buf_str(out, c"    corpus.push(empty);\n");
        buf_str(out, c"    for k in 0..TEST_REPLAYS {\n");
        buf_str(out, c"        var v: Vec<u64> = Vec::new_in(gpa);\n");
        buf_str(out, c"        if unsafe { fuzz_load(gpa, TEST_REPLAY[k], &v) } {\n");
        buf_str(out, c"            corpus.push(v);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var runs = 0;\n");
        buf_str(out, c"    for k in 0..corpus.len() {\n");
        buf_str(out, c"        var v = corpus.get(k);\n");
        buf_str(out, c"        let r = fuzz_exec(f, gpa, v, cov[..]);\n");
        buf_str(out, c"        runs += 1;\n");
        buf_str(out, c"        if test_fails(r) {\n");
        buf_str(out, c"            fuzz_failed(f, gpa, &v, runs);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        fuzz_new_coverage(cov[..], seen[..]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var state = test_seed_of(name);\n");
        buf_str(out, c"    let start = unsafe { fuzz_time(0 as *i64) };\n");
        buf_str(out, c"    var kept = 0;\n");
        buf_str(out, c"    var child: Vec<u64> = Vec::new_in(gpa);\n");
        buf_str(out, c"    while unsafe { fuzz_time(0 as *i64) } - start < TEST_FUZZ_TIME {\n");
        buf_str(out, c"        var parent = corpus.get((test_next(&state) % corpus.len() as u64) as i64);\n");
        buf_str(out, c"        var other = corpus.get((test_next(&state) % corpus.len() as u64) as i64);\n");
        buf_str(out, c"        child.clear();\n");
        buf_str(out, c"        for i in 0..parent.len() {\n");
        buf_str(out, c"            child.push(parent.get(i));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let stack = 1 + test_next(&state) % 4;\n");
        buf_str(out, c"        for _ in 0..stack {\n");
        buf_str(out, c"            fuzz_mutate(&child, other, &state);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let r = fuzz_exec(f, gpa, child, cov[..]);\n");
        buf_str(out, c"        runs += 1;\n");
        buf_str(out, c"        if test_fails(r) {\n");
        buf_str(out, c"            fuzz_failed(f, gpa, &child, runs);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if r.status == 0 && fuzz_new_coverage(cov[..], seen[..]) {\n");
        buf_str(out, c"            var keep: Vec<u64> = Vec::new_in(gpa);\n");
        buf_str(out, c"            for i in 0..child.len() {\n");
        buf_str(out, c"                keep.push(child.get(i));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let path = fuzz_save(gpa, keep, \"corpus-\");\n");
        buf_str(out, c"            var p = path;\n");
        buf_str(out, c"            p.free();\n");
        buf_str(out, c"            corpus.push(keep);\n");
        buf_str(out, c"            kept += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let _ = parent.len();\n");
        buf_str(out, c"        let _ = other.len();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    println(f\"tachyon-test: fuzz {runs} runs, {kept} inputs kept, {corpus.len()} in the corpus\");\n");
        buf_str(out, c"    test_exit(0)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach and the others\n");
        buf_str(out, c"// (0.18.1): the same module, `std`. Its sections are lazy: loaded when a\n");
        buf_str(out, c"// program names what they define.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Heaps (0.18.1) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A priority queue, a binary heap in a Vec: `push` in O(log n), `pop`\n");
        buf_str(out, c"// takes the largest element first (Rust's BinaryHeap, a max-heap), `peek`\n");
        buf_str(out, c"// reads it. For the smallest first (Dijkstra, a timer queue) use\n");
        buf_str(out, c"// `MinHeap`, the same API: no `Reverse` wrapper. `BinaryHeap::new_in(gpa)`,\n");
        buf_str(out, c"// `with_capacity_in(n, gpa)`, `from_vec(v)`; dropped with its elements.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct BinaryHeap<T: Ord, A: Allocator = Gpa> { data: Vec<T, A> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A priority queue whose `pop` takes the smallest element first: a\n");
        buf_str(out, c"// min-heap, with BinaryHeap's API (`MinHeap::new_in(gpa)`, `push`, `pop`,\n");
        buf_str(out, c"// `peek`). Rust spells it `BinaryHeap<Reverse<T>>`.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct MinHeap<T: Ord, A: Allocator = Gpa> { data: Vec<T, A> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Which of two elements a heap keeps nearer the root: the larger\n");
        buf_str(out, c"// (BinaryHeap) or the smaller (MinHeap). Unsafe: a and b point to\n");
        buf_str(out, c"// elements.\n");
        buf_str(out, c"trait HeapOrder { unsafe fn above<T: Ord>(a: *T, b: *T) -> bool; }\n");
        buf_str(out, c"\n");
        buf_str(out, c"struct HeapMax {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"struct HeapMin {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl HeapOrder for HeapMax {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn above<T: Ord>(a: *T, b: *T) -> bool {\n");
        buf_str(out, c"        *a > *b\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl HeapOrder for HeapMin {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn above<T: Ord>(a: *T, b: *T) -> bool {\n");
        buf_str(out, c"        *a < *b\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Puts x in the hole at p[pos], or nearer p[start] while it is above the\n");
        buf_str(out, c"// hole's parent: each step one move, not a swap; where it ends. (The\n");
        buf_str(out, c"// index at least halves each round: 64 rounds at most.) Unsafe: p has\n");
        buf_str(out, c"// pos + 1 elements at least; p[pos] holds nothing (its bits are x's or a\n");
        buf_str(out, c"// moved element's).\n");
        buf_str(out, c"unsafe fn heap_hole_up<T: Ord, O: HeapOrder>(p: *T, start: i64, pos: i64, x: sink T) -> i64 {\n");
        buf_str(out, c"    var i = pos;\n");
        buf_str(out, c"    for _ in 0..64 {\n");
        buf_str(out, c"        if i <= start {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let parent = (i - 1) >> 1;\n");
        buf_str(out, c"        if !O::above(&x, &p[parent]) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        p[i] = p[parent];\n");
        buf_str(out, c"        i = parent;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    p[i] = x;\n");
        buf_str(out, c"    i\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Moves p[pos] down until no child of it, in p[..end], is above it,\n");
        buf_str(out, c"// through a hole. Unsafe: p has `end` elements.\n");
        buf_str(out, c"unsafe fn heap_sift_down<T: Ord, O: HeapOrder>(p: *T, pos: i64, end: i64) {\n");
        buf_str(out, c"    let x = p[pos];\n");
        buf_str(out, c"    var i = pos;\n");
        buf_str(out, c"    var child = 2 * i + 1;\n");
        buf_str(out, c"    for _ in 0..64 {\n");
        buf_str(out, c"        if child > end - 2 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if !O::above(&p[child], &p[child + 1]) {\n");
        buf_str(out, c"            child += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if !O::above(&p[child], &x) {\n");
        buf_str(out, c"            p[i] = x;\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        p[i] = p[child];\n");
        buf_str(out, c"        i = child;\n");
        buf_str(out, c"        child = 2 * i + 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if child == end - 1 && O::above(&p[child], &x) {\n");
        buf_str(out, c"        p[i] = p[child];\n");
        buf_str(out, c"        i = child;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    p[i] = x;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `pop`'s sift: x, for the hole at the root, goes down to a leaf along\n");
        buf_str(out, c"// the path of the children above their siblings (one comparison a level),\n");
        buf_str(out, c"// then up to its place: fewer comparisons than heap_sift_down, as x, the\n");
        buf_str(out, c"// last leaf, usually belongs near the bottom. Unsafe: p has `end`\n");
        buf_str(out, c"// elements, at least one; p[0] holds nothing.\n");
        buf_str(out, c"unsafe fn heap_hole_down_to_bottom<T: Ord, O: HeapOrder>(p: *T, end: i64, x: sink T) {\n");
        buf_str(out, c"    var i = 0;\n");
        buf_str(out, c"    var child = 1;\n");
        buf_str(out, c"    for _ in 0..64 {\n");
        buf_str(out, c"        if child > end - 2 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // (the larger child without a branch: random data mispredicts one)\n");
        buf_str(out, c"        child += (!O::above(&p[child], &p[child + 1])) as i64;\n");
        buf_str(out, c"        p[i] = p[child];\n");
        buf_str(out, c"        i = child;\n");
        buf_str(out, c"        child = 2 * i + 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if child == end - 1 {\n");
        buf_str(out, c"        p[i] = p[child];\n");
        buf_str(out, c"        i = child;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    heap_hole_up::<T, O>(p, 0, i, x);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Makes p[..n] a heap, in O(n). Unsafe: p has n elements.\n");
        buf_str(out, c"unsafe fn heap_build<T: Ord, O: HeapOrder>(p: *T, n: i64) {\n");
        buf_str(out, c"    for k in 0..n / 2 {\n");
        buf_str(out, c"        heap_sift_down::<T, O>(p, n / 2 - 1 - k, n);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Adds x to the heap in v.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"#[stores(x)]\n");
        buf_str(out, c"fn heap_push<T: Ord, O: HeapOrder, A: Allocator>(v: inout Vec<T, A>, x: sink T) {\n");
        buf_str(out, c"    v.reserve(1);\n");
        buf_str(out, c"    let n = v.len;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        heap_hole_up::<T, O>(v.ptr, 0, n, x);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v.len = n + 1;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Takes the root of the heap in v out.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn heap_pop<T: Ord, O: HeapOrder, A: Allocator>(v: inout Vec<T, A>) -> Option<T> {\n");
        buf_str(out, c"    if v.len == 0 {\n");
        buf_str(out, c"        return None;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v.len -= 1;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let p = v.ptr;\n");
        buf_str(out, c"        let n = v.len;\n");
        buf_str(out, c"        let last = p[n];\n");
        buf_str(out, c"        if n == 0 {\n");
        buf_str(out, c"            return Some(last);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let top = p[0];\n");
        buf_str(out, c"        heap_hole_down_to_bottom::<T, O>(p, n, last);\n");
        buf_str(out, c"        Some(top)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The heap in v sorted in place: the root's end of the order last.\n");
        buf_str(out, c"fn heap_sort_vec<T: Ord, O: HeapOrder, A: Allocator>(v: inout Vec<T, A>) {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let p = v.ptr;\n");
        buf_str(out, c"        let n = v.len;\n");
        buf_str(out, c"        for k in 1..n {\n");
        buf_str(out, c"            let end = n - k;\n");
        buf_str(out, c"            swap_raw::<T>(p, 0, end);\n");
        buf_str(out, c"            heap_sift_down::<T, O>(p, 0, end);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Ord, A: Allocator> BinaryHeap<T, A> {\n");
        buf_str(out, c"    // An empty heap on allocator a.\n");
        buf_str(out, c"    pub fn new_in(a: sink A) -> BinaryHeap<T, A> {\n");
        buf_str(out, c"        BinaryHeap { data: Vec::new_in(a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An empty heap on allocator a with room for cap elements.\n");
        buf_str(out, c"    pub fn with_capacity_in(cap: i64, a: sink A) -> BinaryHeap<T, A> {\n");
        buf_str(out, c"        BinaryHeap { data: Vec::with_capacity_in(cap, a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A heap of v's elements, in O(n), on v's memory: Rust's\n");
        buf_str(out, c"    // `BinaryHeap::from(v)`.\n");
        buf_str(out, c"    pub fn from_vec(v: sink Vec<T, A>) -> BinaryHeap<T, A> {\n");
        buf_str(out, c"        var data = v;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            heap_build::<T, HeapMax>(data.ptr, data.len);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        BinaryHeap { data: data }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn len(self) -> i64 {\n");
        buf_str(out, c"        self.data.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_empty(self) -> bool {\n");
        buf_str(out, c"        self.data.len == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Adds x, in O(log n).\n");
        buf_str(out, c"    #[stores(x)]\n");
        buf_str(out, c"    pub fn push(inout self, x: sink T) {\n");
        buf_str(out, c"        heap_push::<T, HeapMax, A>(&self.data, x);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Takes the largest element out (None when empty), in O(log n).\n");
        buf_str(out, c"    pub fn pop(inout self) -> Option<T> {\n");
        buf_str(out, c"        heap_pop::<T, HeapMax, A>(&self.data)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The largest element, which stays (`pop` takes it), as Vec's `last`.\n");
        buf_str(out, c"    pub fn peek(self) -> Option<T> {\n");
        buf_str(out, c"        if self.data.len == 0 { None } else { Some(self.data.get(0)) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Drops the elements; the room stays.\n");
        buf_str(out, c"    pub fn clear(inout self) {\n");
        buf_str(out, c"        self.data.clear();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn capacity(self) -> i64 {\n");
        buf_str(out, c"        self.data.cap\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Room for `extra` more elements.\n");
        buf_str(out, c"    pub fn reserve(inout self, extra: i64) {\n");
        buf_str(out, c"        self.data.reserve(extra);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its allocator: a copy of the handle.\n");
        buf_str(out, c"    pub fn allocator(self) -> A {\n");
        buf_str(out, c"        self.data.alloc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements in heap order (the largest first, the rest in no\n");
        buf_str(out, c"    // useful order), a view.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn as_slice(self) -> [T] {\n");
        buf_str(out, c"        self.data.as_slice()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements in a Vec, in heap order, on the same memory.\n");
        buf_str(out, c"    pub fn into_vec(sink self) -> Vec<T, A> {\n");
        buf_str(out, c"        self.data\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements in a Vec, smallest first, on the same memory: a\n");
        buf_str(out, c"    // heapsort, in O(n log n).\n");
        buf_str(out, c"    pub fn into_sorted_vec(sink self) -> Vec<T, A> {\n");
        buf_str(out, c"        var v = self.data;\n");
        buf_str(out, c"        heap_sort_vec::<T, HeapMax, A>(&v);\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Ord, A: Allocator + Ambient> BinaryHeap<T, A> {\n");
        buf_str(out, c"    #[ambient(\"BinaryHeap::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> BinaryHeap<T, A> {\n");
        buf_str(out, c"        BinaryHeap::new_in(A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"BinaryHeap::with_capacity_in(cap, gpa)\")]\n");
        buf_str(out, c"    pub fn with_capacity(cap: i64) -> BinaryHeap<T, A> {\n");
        buf_str(out, c"        BinaryHeap::with_capacity_in(cap, A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Ord, A: Allocator> MinHeap<T, A> {\n");
        buf_str(out, c"    // An empty heap on allocator a.\n");
        buf_str(out, c"    pub fn new_in(a: sink A) -> MinHeap<T, A> {\n");
        buf_str(out, c"        MinHeap { data: Vec::new_in(a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An empty heap on allocator a with room for cap elements.\n");
        buf_str(out, c"    pub fn with_capacity_in(cap: i64, a: sink A) -> MinHeap<T, A> {\n");
        buf_str(out, c"        MinHeap { data: Vec::with_capacity_in(cap, a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A heap of v's elements, in O(n), on v's memory.\n");
        buf_str(out, c"    pub fn from_vec(v: sink Vec<T, A>) -> MinHeap<T, A> {\n");
        buf_str(out, c"        var data = v;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            heap_build::<T, HeapMin>(data.ptr, data.len);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        MinHeap { data: data }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn len(self) -> i64 {\n");
        buf_str(out, c"        self.data.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_empty(self) -> bool {\n");
        buf_str(out, c"        self.data.len == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Adds x, in O(log n).\n");
        buf_str(out, c"    #[stores(x)]\n");
        buf_str(out, c"    pub fn push(inout self, x: sink T) {\n");
        buf_str(out, c"        heap_push::<T, HeapMin, A>(&self.data, x);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Takes the smallest element out (None when empty), in O(log n).\n");
        buf_str(out, c"    pub fn pop(inout self) -> Option<T> {\n");
        buf_str(out, c"        heap_pop::<T, HeapMin, A>(&self.data)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The smallest element, which stays (`pop` takes it), as Vec's `last`.\n");
        buf_str(out, c"    pub fn peek(self) -> Option<T> {\n");
        buf_str(out, c"        if self.data.len == 0 { None } else { Some(self.data.get(0)) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Drops the elements; the room stays.\n");
        buf_str(out, c"    pub fn clear(inout self) {\n");
        buf_str(out, c"        self.data.clear();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn capacity(self) -> i64 {\n");
        buf_str(out, c"        self.data.cap\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Room for `extra` more elements.\n");
        buf_str(out, c"    pub fn reserve(inout self, extra: i64) {\n");
        buf_str(out, c"        self.data.reserve(extra);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its allocator: a copy of the handle.\n");
        buf_str(out, c"    pub fn allocator(self) -> A {\n");
        buf_str(out, c"        self.data.alloc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements in heap order (the smallest first, the rest in no\n");
        buf_str(out, c"    // useful order), a view.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn as_slice(self) -> [T] {\n");
        buf_str(out, c"        self.data.as_slice()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements in a Vec, in heap order, on the same memory.\n");
        buf_str(out, c"    pub fn into_vec(sink self) -> Vec<T, A> {\n");
        buf_str(out, c"        self.data\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its elements in a Vec, smallest first (as BinaryHeap's), on the same\n");
        buf_str(out, c"    // memory, in O(n log n).\n");
        buf_str(out, c"    pub fn into_sorted_vec(sink self) -> Vec<T, A> {\n");
        buf_str(out, c"        var v = self.data;\n");
        buf_str(out, c"        heap_sort_vec::<T, HeapMin, A>(&v);\n");
        buf_str(out, c"        let s = v.as_mut_slice();\n");
        buf_str(out, c"        for k in 0..s.len / 2 {\n");
        buf_str(out, c"            swap_at::<T>(s, k, s.len - 1 - k);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Ord, A: Allocator + Ambient> MinHeap<T, A> {\n");
        buf_str(out, c"    #[ambient(\"MinHeap::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> MinHeap<T, A> {\n");
        buf_str(out, c"        MinHeap::new_in(A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"MinHeap::with_capacity_in(cap, gpa)\")]\n");
        buf_str(out, c"    pub fn with_capacity(cap: i64) -> MinHeap<T, A> {\n");
        buf_str(out, c"        MinHeap::with_capacity_in(cap, A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- More of Vec and Range (0.18.1) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Vec's first, retain, contains and sort_by_key, a slice's contains,\n");
        buf_str(out, c"// Range's rev.\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // The first element, if there is one (as `last`).\n");
        buf_str(out, c"    pub fn first(self) -> Option<T> {\n");
        buf_str(out, c"        if self.len == 0 { None } else { Some(self.get(0)) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Keeps the elements f is true of, in their order, and drops the\n");
        buf_str(out, c"    // others (Rust's `retain`): in place, O(n), f called once per element.\n");
        buf_str(out, c"    pub fn retain<F: FnMut(let T) -> bool>(inout self, f: F) {\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        let n = self.len;\n");
        buf_str(out, c"        let p = self.ptr;\n");
        buf_str(out, c"        var kept = 0;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            for i in 0..n {\n");
        buf_str(out, c"                if g(*(&p[i])) {\n");
        buf_str(out, c"                    if kept != i {\n");
        buf_str(out, c"                        p[kept] = p[i];\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    kept += 1;\n");
        buf_str(out, c"                } else if needs_drop::<T>() {\n");
        buf_str(out, c"                    drop(p[i]);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len = kept;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Sorts it in place by the key f gives each element, smallest first,\n");
        buf_str(out, c"    // keeping equal keys in their order, as Rust's `sort_by_key`:\n");
        buf_str(out, c"    // sort_stable_by_in with the Vec's own allocator for its buffer. f\n");
        buf_str(out, c"    // runs twice per comparison: make it cheap (a field, a tuple of\n");
        buf_str(out, c"    // fields).\n");
        buf_str(out, c"    pub fn sort_by_key<K: Ord, F: FnMut(let T) -> K>(inout self, f: F) {\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        let a = self.alloc;\n");
        buf_str(out, c"        sort_stable_by_in(self.as_mut_slice(), |x: T, y: T| {\n");
        buf_str(out, c"            let kx = g(x);\n");
        buf_str(out, c"            let ky = g(y);\n");
        buf_str(out, c"            cmp_of(kx, ky)\n");
        buf_str(out, c"        }, a);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Eq>[T] {\n");
        buf_str(out, c"    // Whether x is one of its elements (Rust's `s.contains(&x)`; x by\n");
        buf_str(out, c"    // value, as HashMap's keys): a linear search.\n");
        buf_str(out, c"    pub fn contains(self: [T], x: sink T) -> bool {\n");
        buf_str(out, c"        for i in 0..self.len {\n");
        buf_str(out, c"            if self[i] == x {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Eq, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // Whether x is one of its elements: `v.contains(x)`.\n");
        buf_str(out, c"    pub fn contains(self, x: sink T) -> bool {\n");
        buf_str(out, c"        self.as_slice().contains(x)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Range<T> {\n");
        buf_str(out, c"    // Its items from the last down: `for i in (0..n).rev()` is n - 1,\n");
        buf_str(out, c"    // n - 2, ..., 0.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn rev(sink self) -> RevRange<T> {\n");
        buf_str(out, c"        RevRange { start: self.start, end: self.end }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `(a..b).rev()`: end - 1, end - 2, ..., down to start.\n");
        buf_str(out, c"pub struct RevRange<T> { pub start: T, pub end: T }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Iterator for RevRange<T> {\n");
        buf_str(out, c"    type Item = T;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<T> {\n");
        buf_str(out, c"        if self.start < self.end {\n");
        buf_str(out, c"            let x = self.end - 1 as T;\n");
        buf_str(out, c"            self.end = x;\n");
        buf_str(out, c"            Some(x)\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            None\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self) -> i64 {\n");
        buf_str(out, c"        if self.start < self.end { (self.end - self.start) as i64 } else { 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(inout self, k: i64) -> T {\n");
        buf_str(out, c"        self.end - (k + 1) as T\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, T) -> B>(self, init: sink B, f: F) -> B {\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        var acc = init;\n");
        buf_str(out, c"        let n = self.exact_len();\n");
        buf_str(out, c"        for k in 0..n {\n");
        buf_str(out, c"            acc = g(acc, self.end - (k + 1) as T);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Run-time CPU features (0.19) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// std::arch::detect's word (docs/design/arch.md §2.5): bit b is set when\n");
        buf_str(out, c"// the running CPU has feature b (the compiler's numbering: FT_* in\n");
        buf_str(out, c"// compiler/src/arch/features.tach), bit 63 once the word is filled. A\n");
        buf_str(out, c"// detect the build cannot fold loads it and tests one bit\n");
        buf_str(out, c"// (back/isel/arch.tach; gen0/gen/arch.tach at -O0). Its sources follow,\n");
        buf_str(out, c"// one section per system (the compiler names the target's: arch_init_*\n");
        buf_str(out, c"// and arch_word_*, front/modules/stdsections.tach); each init takes the\n");
        buf_str(out, c"// build's features, which it need not ask the system about.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Why there is no data race (no atomics before 0.21):\n");
        buf_str(out, c"// - A program with `main` fills the word once, as the first thing main\n");
        buf_str(out, c"//   does (back/isel/arch.tach; gen0 likewise), while it is the only\n");
        buf_str(out, c"//   thread: every later read, on any thread, comes after that write (a\n");
        buf_str(out, c"//   thread starts after what made it), and nothing writes it again.\n");
        buf_str(out, c"// - Code entered from C with no tachyon `main` (a library) fills it at its\n");
        buf_str(out, c"//   first detect (arch_word_*): two threads may both find 0 and both fill\n");
        buf_str(out, c"//   it. Each computes the same value from what the CPU and the system\n");
        buf_str(out, c"//   report, and stores it with one aligned 64-bit store, which AArch64 and\n");
        buf_str(out, c"//   x86-64 never tear (one str or mov from the compiler's own back end,\n");
        buf_str(out, c"//   which does not assume the absence of races: it never splits, repeats\n");
        buf_str(out, c"//   or invents a store to a static). A reader sees 0, and fills the word\n");
        buf_str(out, c"//   itself, or the whole word. That is a relaxed atomic load and store in\n");
        buf_str(out, c"//   0.21's terms, which the two become then, with the same instructions.\n");
        buf_str(out, c"// - TACHYON_ARCH_DISABLE (comma-separated feature names, or `all`) only\n");
        buf_str(out, c"//   clears bits, so no setting of it makes a missing instruction run: it\n");
        buf_str(out, c"//   makes detect take the fallback paths, for testing them.\n");
        buf_str(out, c"static var ARCH_FEATURES: u64 = 0;\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[link_name = \"getenv\"]\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn arch_getenv(name: *u8) -> *u8;\n");
        buf_str(out, c"    #[link_name = \"strlen\"]\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn arch_strlen(s: *u8) -> u64;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn arch_bit(b: i64) -> u64 {\n");
        buf_str(out, c"    (1 as u64) << (b as u64)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The word from what the system reports: TACHYON_ARCH_DISABLE's features\n");
        buf_str(out, c"// cleared (`a64`: unqualified names are AArch64's), then those whose\n");
        buf_str(out, c"// requirements are gone, stored once.\n");
        buf_str(out, c"fn arch_store(found: u64, a64: bool) -> u64 {\n");
        buf_str(out, c"    let w = arch_consistent(found & ~arch_disabled(a64)) | 0x8000000000000000;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        ARCH_FEATURES = w;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    w\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// w without the features whose requirements it lacks (sha3 without sha2,\n");
        buf_str(out, c"// avx2 without avx), in the order of the implications, so that code under\n");
        buf_str(out, c"// `detect(\"sha3\")` never runs where the sha2 it may use is missing.\n");
        buf_str(out, c"fn arch_consistent(w: u64) -> u64 {\n");
        buf_str(out, c"    // (feature, what it needs) pairs: neon fp; crc aarch64; aes sha2\n");
        buf_str(out, c"    // dotprod rdm fp16 i8mm bf16 neon; sha3 sha2; sse2 .. sse4.2 the one\n");
        buf_str(out, c"    // before; avx sse4.2; avx2 and fma avx\n");
        buf_str(out, c"    let pairs: [i64; 36] = [\n");
        buf_str(out, c"        0, 1, 2, 15, 3, 0, 4, 0, 6, 0, 7, 0, 9, 0, 10, 0, 11, 0, 5, 4, 17, 16, 18, 17, 19, 18,\n");
        buf_str(out, c"        20, 19, 21, 20, 29, 21, 30, 29, 31, 29,\n");
        buf_str(out, c"    ];\n");
        buf_str(out, c"    var out = w;\n");
        buf_str(out, c"    var k = 0;\n");
        buf_str(out, c"    while k < 36 {\n");
        buf_str(out, c"        if (out & arch_bit(pairs[k])) != 0 && (out & arch_bit(pairs[k + 1])) == 0 {\n");
        buf_str(out, c"            out &= ~arch_bit(pairs[k]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        k += 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    out\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn arch_same(a: [u8], b: [u8]) -> bool {\n");
        buf_str(out, c"    if a.len != b.len {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for i in 0..a.len as i64 {\n");
        buf_str(out, c"        if a[i] != b[i] {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    true\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The bits TACHYON_ARCH_DISABLE names: features (`aarch64.aes`,\n");
        buf_str(out, c"// `x86_64.aes` qualified), `all` every one.\n");
        buf_str(out, c"fn arch_disabled(a64: bool) -> u64 {\n");
        buf_str(out, c"    let p = unsafe { arch_getenv(c\"TACHYON_ARCH_DISABLE\") };\n");
        buf_str(out, c"    if p == 0 as *u8 {\n");
        buf_str(out, c"        return 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let s = unsafe { p[0..arch_strlen(p) as i64] };\n");
        buf_str(out, c"    var out: u64 = 0;\n");
        buf_str(out, c"    var i = 0;\n");
        buf_str(out, c"    while i <= s.len as i64 {\n");
        buf_str(out, c"        var j = i;\n");
        buf_str(out, c"        while j < s.len as i64 && s[j] != ',' {\n");
        buf_str(out, c"            j += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out |= arch_named(s[i..j], a64);\n");
        buf_str(out, c"        i = j + 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    out\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn arch_named(name: [u8], a64: bool) -> u64 {\n");
        buf_str(out, c"    if arch_same(name, \"all\") {\n");
        buf_str(out, c"        return 0x7fffffffffffffff;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let a64_names: [[u8]; 12] = [\"neon\", \"fp\", \"crc\", \"aes\", \"sha2\", \"sha3\", \"dotprod\", \"rdm\",\n");
        buf_str(out, c"        \"lse\", \"fp16\", \"i8mm\", \"bf16\"];\n");
        buf_str(out, c"    let x86_names: [[u8]; 16] = [\"sse\", \"sse2\", \"sse3\", \"ssse3\", \"sse4.1\", \"sse4.2\", \"popcnt\",\n");
        buf_str(out, c"        \"lzcnt\", \"bmi1\", \"bmi2\", \"pclmulqdq\", \"aes\", \"sha\", \"avx\", \"avx2\", \"fma\"];\n");
        buf_str(out, c"    var n = name;\n");
        buf_str(out, c"    var on_a64 = a64;\n");
        buf_str(out, c"    if n.len > 8 && arch_same(n[0..8], \"aarch64.\") {\n");
        buf_str(out, c"        n = n[8..n.len as i64];\n");
        buf_str(out, c"        on_a64 = true;\n");
        buf_str(out, c"    } else if n.len > 7 && arch_same(n[0..7], \"x86_64.\") {\n");
        buf_str(out, c"        n = n[7..n.len as i64];\n");
        buf_str(out, c"        on_a64 = false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if on_a64 {\n");
        buf_str(out, c"        if arch_same(n, \"asimd\") {\n");
        buf_str(out, c"            return 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for k in 0..12 {\n");
        buf_str(out, c"            if arch_same(n, a64_names[k]) {\n");
        buf_str(out, c"                return arch_bit(k);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        for k in 0..16 {\n");
        buf_str(out, c"            if arch_same(n, x86_names[k]) {\n");
        buf_str(out, c"                return arch_bit(16 + k);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    0\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- CPU features on macOS (0.19) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// AArch64 macOS: sysctl's hw.optional.arm.FEAT_*, only for the features\n");
        buf_str(out, c"// the build does not assume (a default build, apple-m1, asks for two).\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[link_name = \"sysctlbyname\"]\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn arch_sysctlbyname(name: *u8, old: *u8, len: *u64, new: *u8, newlen: u64) -> i32;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether sysctl `name` (an int) is 1.\n");
        buf_str(out, c"fn arch_sysctl(name: *u8) -> bool {\n");
        buf_str(out, c"    var value: [u32; 2] = [0; 2];\n");
        buf_str(out, c"    var len: [u64; 1] = [8];\n");
        buf_str(out, c"    let r = unsafe { arch_sysctlbyname(name, &value as *u8, &len as *u64, 0 as *u8, 0) };\n");
        buf_str(out, c"    r == 0 && value[0] == 1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fills the word (`known`: the build's features): before main, or at a\n");
        buf_str(out, c"// library's first detect.\n");
        buf_str(out, c"fn arch_init_macos(known: u64) -> u64 {\n");
        buf_str(out, c"    var found: u64 = known | arch_bit(15) | arch_bit(0) | arch_bit(1);\n");
        buf_str(out, c"    // (bit, then the sysctls that must all be 1)\n");
        buf_str(out, c"    let names: [*u8; 13] = [\n");
        buf_str(out, c"        c\"hw.optional.arm.FEAT_CRC32\", c\"hw.optional.arm.FEAT_AES\", c\"hw.optional.arm.FEAT_PMULL\",\n");
        buf_str(out, c"        c\"hw.optional.arm.FEAT_SHA256\", c\"hw.optional.arm.FEAT_SHA3\",\n");
        buf_str(out, c"        c\"hw.optional.arm.FEAT_SHA512\", c\"hw.optional.arm.FEAT_DotProd\",\n");
        buf_str(out, c"        c\"hw.optional.arm.FEAT_RDM\", c\"hw.optional.arm.FEAT_LSE\", c\"hw.optional.arm.FEAT_FP16\",\n");
        buf_str(out, c"        c\"hw.optional.arm.FEAT_I8MM\", c\"hw.optional.arm.FEAT_BF16\", 0 as *u8,\n");
        buf_str(out, c"    ];\n");
        buf_str(out, c"    // (feature, its first name, how many)\n");
        buf_str(out, c"    let tests: [i64; 30] = [2, 0, 1, 3, 1, 2, 4, 3, 1, 5, 4, 2, 6, 6, 1, 7, 7, 1, 8, 8, 1, 9, 9, 1,\n");
        buf_str(out, c"        10, 10, 1, 11, 11, 1];\n");
        buf_str(out, c"    var k = 0;\n");
        buf_str(out, c"    while k < 30 {\n");
        buf_str(out, c"        if (found & arch_bit(tests[k])) == 0 {\n");
        buf_str(out, c"            var all = true;\n");
        buf_str(out, c"            for j in 0..tests[k + 2] {\n");
        buf_str(out, c"                if !arch_sysctl(names[tests[k + 1] + j]) {\n");
        buf_str(out, c"                    all = false;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if all {\n");
        buf_str(out, c"                found |= arch_bit(tests[k]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        k += 3;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    arch_store(found, true)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The word, filled at the first call (a library: no main filled it).\n");
        buf_str(out, c"fn arch_word_macos() -> u64 {\n");
        buf_str(out, c"    let w = unsafe { ARCH_FEATURES };\n");
        buf_str(out, c"    if w != 0 { w } else { arch_init_macos(0) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- CPU features on Linux (0.19) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// AArch64 Linux: getauxval's AT_HWCAP and AT_HWCAP2.\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[link_name = \"getauxval\"]\n");
        buf_str(out, c"    #[effects(global)]\n");
        buf_str(out, c"    fn arch_getauxval(kind: u64) -> u64;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fills the word (`known`: the build's features): before main, or at a\n");
        buf_str(out, c"// library's first detect.\n");
        buf_str(out, c"fn arch_init_linux(known: u64) -> u64 {\n");
        buf_str(out, c"    let cap = unsafe { arch_getauxval(16) };\n");
        buf_str(out, c"    let cap2 = unsafe { arch_getauxval(26) };\n");
        buf_str(out, c"    // (HWCAP bits, all needed, then the feature: fp, asimd, crc32, aes and\n");
        buf_str(out, c"    // pmull, sha1 and sha2, sha3 and sha512, asimddp, asimdrdm, atomics,\n");
        buf_str(out, c"    // fphp and asimdhp)\n");
        buf_str(out, c"    let tests: [u64; 20] = [0x1, 1, 0x2, 0, 0x80, 2, 0x18, 3, 0x60, 4, 0x220000, 5, 0x100000, 6,\n");
        buf_str(out, c"        0x1000, 7, 0x100, 8, 0x600, 9];\n");
        buf_str(out, c"    var found: u64 = known | arch_bit(15);\n");
        buf_str(out, c"    var k = 0;\n");
        buf_str(out, c"    while k < 20 {\n");
        buf_str(out, c"        if (cap & tests[k]) == tests[k] {\n");
        buf_str(out, c"            found |= arch_bit(tests[k + 1] as i64);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        k += 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // (HWCAP2: i8mm, bf16)\n");
        buf_str(out, c"    if (cap2 & 0x2000) != 0 {\n");
        buf_str(out, c"        found |= arch_bit(10);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if (cap2 & 0x4000) != 0 {\n");
        buf_str(out, c"        found |= arch_bit(11);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    arch_store(found, true)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The word, filled at the first call (a library: no main filled it).\n");
        buf_str(out, c"fn arch_word_linux() -> u64 {\n");
        buf_str(out, c"    let w = unsafe { ARCH_FEATURES };\n");
        buf_str(out, c"    if w != 0 { w } else { arch_init_linux(0) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- CPU features on x86-64 (0.19) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// x86-64, either system: cpuid, and xgetbv for whether the system saves\n");
        buf_str(out, c"// the ymm registers (else no avx family: its state would be lost).\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    // (the compiler's run-time helpers, gen0/target.tach emit_arch_runtime)\n");
        buf_str(out, c"    #[link_name = \"tachyon_arch_cpuid\"]\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn arch_cpuid(leaf: u32, sub: u32, out: *u32);\n");
        buf_str(out, c"    #[link_name = \"tachyon_arch_xgetbv\"]\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn arch_xgetbv(index: u32) -> u64;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fills the word (`known`: the build's features): before main, or at a\n");
        buf_str(out, c"// library's first detect.\n");
        buf_str(out, c"fn arch_init_x86(known: u64) -> u64 {\n");
        buf_str(out, c"    var r: [u32; 4] = [0; 4];\n");
        buf_str(out, c"    unsafe { arch_cpuid(0, 0, &r as *u32); }\n");
        buf_str(out, c"    let max = r[0];\n");
        buf_str(out, c"    unsafe { arch_cpuid(1, 0, &r as *u32); }\n");
        buf_str(out, c"    let c1 = r[2];\n");
        buf_str(out, c"    let d1 = r[3];\n");
        buf_str(out, c"    var w: u64 = known | arch_bit(32);\n");
        buf_str(out, c"    // (register: 2 ecx, 3 edx; its bit; the feature: sse, sse2, sse3,\n");
        buf_str(out, c"    // ssse3, sse4.1, sse4.2, popcnt, pclmulqdq, aes)\n");
        buf_str(out, c"    let tests: [u32; 27] = [3, 25, 16, 3, 26, 17, 2, 0, 18, 2, 9, 19, 2, 19, 20, 2, 20, 21, 2,\n");
        buf_str(out, c"        23, 22, 2, 1, 26, 2, 25, 27];\n");
        buf_str(out, c"    var k = 0;\n");
        buf_str(out, c"    while k < 27 {\n");
        buf_str(out, c"        let reg = if tests[k] == 2 { c1 } else { d1 };\n");
        buf_str(out, c"        if (reg & ((1 as u32) << tests[k + 1])) != 0 {\n");
        buf_str(out, c"            w |= arch_bit(tests[k + 2] as i64);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        k += 3;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // osxsave, then XCR0: the system saves xmm and ymm\n");
        buf_str(out, c"    let ymm = (c1 & 0x8000000) != 0 && (unsafe { arch_xgetbv(0) } & 6) == 6;\n");
        buf_str(out, c"    if ymm && (c1 & 0x10000000) != 0 {\n");
        buf_str(out, c"        w |= arch_bit(29);\n");
        buf_str(out, c"        if (c1 & 0x1000) != 0 {\n");
        buf_str(out, c"            w |= arch_bit(31);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if max >= 7 {\n");
        buf_str(out, c"        unsafe { arch_cpuid(7, 0, &r as *u32); }\n");
        buf_str(out, c"        let b7 = r[1];\n");
        buf_str(out, c"        if (b7 & 0x8) != 0 {\n");
        buf_str(out, c"            w |= arch_bit(24);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if (b7 & 0x100) != 0 {\n");
        buf_str(out, c"            w |= arch_bit(25);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if (b7 & 0x20000000) != 0 {\n");
        buf_str(out, c"            w |= arch_bit(28);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if ymm && (b7 & 0x20) != 0 {\n");
        buf_str(out, c"            w |= arch_bit(30);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe { arch_cpuid(0x80000000, 0, &r as *u32); }\n");
        buf_str(out, c"    if r[0] >= 0x80000001 {\n");
        buf_str(out, c"        unsafe { arch_cpuid(0x80000001, 0, &r as *u32); }\n");
        buf_str(out, c"        if (r[2] & 0x20) != 0 {\n");
        buf_str(out, c"            w |= arch_bit(23);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    arch_store(w, false)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The word, filled at the first call (a library: no main filled it).\n");
        buf_str(out, c"fn arch_word_x86() -> u64 {\n");
        buf_str(out, c"    let w = unsafe { ARCH_FEATURES };\n");
        buf_str(out, c"    if w != 0 { w } else { arch_init_x86(0) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::ops ----\n");
        buf_str(out, c"pub mod ops {\n");
        buf_str(out, c"// std::ops: the operator traits (0.20: from std.tach).\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Traits (0.9) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The operators: `a + b` on a type implementing Add is `a.add(b)`, and so\n");
        buf_str(out, c"// on; `-a` is `a.neg()`; `a == b` is `a.eq(&b)` (an impl wins over the\n");
        buf_str(out, c"// structural ==); `a < b` is `a.cmp(&b) < 0`. Numbers implement them all\n");
        buf_str(out, c"// without impl blocks, every type with == implements Eq, and numbers,\n");
        buf_str(out, c"// pointers and fieldless enums Ord.\n");
        buf_str(out, c"pub trait Add { fn add(self, other: Self) -> Self; }\n");
        buf_str(out, c"pub trait Sub { fn sub(self, other: Self) -> Self; }\n");
        buf_str(out, c"pub trait Mul { fn mul(self, other: Self) -> Self; }\n");
        buf_str(out, c"pub trait Div { fn div(self, other: Self) -> Self; }\n");
        buf_str(out, c"pub trait Neg { fn neg(self) -> Self; }\n");
        buf_str(out, c"// ---- end mod std::ops ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::iter ----\n");
        buf_str(out, c"pub mod iter {\n");
        buf_str(out, c"// std::iter: the Iterator trait, its adapters and its sources (0.20: from flat/iter.tach).\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Allocator, Eq, Gpa, Hash, Option, Vec};\n");
        buf_str(out, c"use std::collections::{HashMap, RawIter};\n");
        buf_str(out, c"use std::slice::{swap_at, swap_raw};\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub trait Iterator {\n");
        buf_str(out, c"    type Item;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The next item, or None when there are no more.\n");
        buf_str(out, c"    fn next(inout self) -> Option<Self::Item>;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The number of items left, or -1 when it is not known.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self) -> i64 {\n");
        buf_str(out, c"        -1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The k-th item left: only when exact_len() > k, with k increasing\n");
        buf_str(out, c"    // (0, 1, 2, ...) and no other use of the iterator in between.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(inout self, k: i64) -> Self::Item {\n");
        buf_str(out, c"        self.next().unwrap()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn map<B, F: FnMut(Self::Item) -> B>(self, f: F) -> Map<Self, F> {\n");
        buf_str(out, c"        Map { it: self, f: f }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn filter<F: FnMut(Self::Item) -> bool>(self, f: F) -> Filter<Self, F> {\n");
        buf_str(out, c"        Filter { it: self, f: f }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Items (i64, Self::Item): each with its index.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn enumerate(self) -> Enumerate<Self> {\n");
        buf_str(out, c"        Enumerate { it: self, k: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Items (Self::Item, J::Item), as long as both have one.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn zip<J: Iterator>(self, other: sink J) -> Zip<Self, J> {\n");
        buf_str(out, c"        Zip { a: self, b: other }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The first n items.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn take(self, n: i64) -> Take<Self> {\n");
        buf_str(out, c"        Take { it: self, n: n }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // f(...f(f(init, x0), x1)..., xn): the loop every consumer is.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, Self::Item) -> B>(self, init: sink B, f: F) -> B {\n");
        buf_str(out, c"        var it = self;\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        var acc = init;\n");
        buf_str(out, c"        while let Option::Some(x) = it.next() {\n");
        buf_str(out, c"            acc = g(acc, x);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn for_each<F: FnMut(Self::Item)>(self, f: F) {\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        self.fold((), |u: (), x| g(x));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn count(self) -> i64 {\n");
        buf_str(out, c"        self.fold(0i64, |n, x| n + 1)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The sum of the items, from `0 as Self::Item`.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn sum(self) -> Self::Item {\n");
        buf_str(out, c"        self.fold(0 as Self::Item, |s, x| s + x)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn min(self) -> Option<Self::Item> {\n");
        buf_str(out, c"        var it = self;\n");
        buf_str(out, c"        match it.next() {\n");
        buf_str(out, c"            Option::Some(first) => Option::Some(it.fold(first, |m, x| if x < m { x } else { m })),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn max(self) -> Option<Self::Item> {\n");
        buf_str(out, c"        var it = self;\n");
        buf_str(out, c"        match it.next() {\n");
        buf_str(out, c"            Option::Some(first) => Option::Some(it.fold(first, |m, x| if x > m { x } else { m })),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A new Vec of the items on allocator a (0.16; the caller frees it).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn collect_in<A: Allocator>(self, a: sink A) -> Vec<Self::Item, A> {\n");
        buf_str(out, c"        var it = self;\n");
        buf_str(out, c"        var v: Vec<Self::Item, A> = Vec::new_in(a);\n");
        buf_str(out, c"        let n = it.exact_len();\n");
        buf_str(out, c"        if n > 0 {\n");
        buf_str(out, c"            v.reserve(n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        it.for_each(|x| v.push(x));\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // (0.16: an error outside std, front/ambient.tach)\n");
        buf_str(out, c"    #[ambient(\"collect_in(gpa)\")]\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn collect(self) -> Vec<Self::Item> {\n");
        buf_str(out, c"        self.collect_in(Gpa::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Searches (0.15) ----\n");
        buf_str(out, c"    // They call `next` and stop at the first item that decides: the items\n");
        buf_str(out, c"    // after it are not reached.\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether f is true for some item.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn any<F: FnMut(Self::Item) -> bool>(self, f: F) -> bool {\n");
        buf_str(out, c"        var it = self;\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        while let Option::Some(x) = it.next() {\n");
        buf_str(out, c"            if g(x) {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether f is true for every item (true when there is none).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn all<F: FnMut(Self::Item) -> bool>(self, f: F) -> bool {\n");
        buf_str(out, c"        var it = self;\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        while let Option::Some(x) = it.next() {\n");
        buf_str(out, c"            if !g(x) {\n");
        buf_str(out, c"                return false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The index (counting from 0) of the first item f is true for.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn position<F: FnMut(Self::Item) -> bool>(self, f: F) -> Option<i64> {\n");
        buf_str(out, c"        var it = self;\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        var k = 0;\n");
        buf_str(out, c"        while let Option::Some(x) = it.next() {\n");
        buf_str(out, c"            if g(x) {\n");
        buf_str(out, c"                return Option::Some(k);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            k += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::None\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The first item f is true for.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn find<F: FnMut(Self::Item) -> bool>(self, f: F) -> Option<Self::Item> {\n");
        buf_str(out, c"        var it = self;\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        while let Option::Some(x) = it.next() {\n");
        buf_str(out, c"            if g(x) {\n");
        buf_str(out, c"                return Option::Some(x);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::None\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Adapters ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Map<I, F> { it: I, f: F }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<I: Iterator, M> Iterator for Map<I, M> {\n");
        buf_str(out, c"    type Item = M::Output;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<M::Output> {\n");
        buf_str(out, c"        match self.it.next() {\n");
        buf_str(out, c"            Option::Some(x) => Option::Some((self.f)(x)),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self) -> i64 {\n");
        buf_str(out, c"        self.it.exact_len()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(inout self, k: i64) -> M::Output {\n");
        buf_str(out, c"        (self.f)(self.it.at(k))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, M::Output) -> B>(self, init: sink B, f: F) -> B {\n");
        buf_str(out, c"        var m = self.f;\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        self.it.fold(init, |acc, x| g(acc, m(x)))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Filter<I, F> { it: I, f: F }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<I: Iterator, P> Iterator for Filter<I, P> {\n");
        buf_str(out, c"    type Item = I::Item;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<I::Item> {\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            match self.it.next() {\n");
        buf_str(out, c"                Option::Some(x) => {\n");
        buf_str(out, c"                    if (self.f)(x) {\n");
        buf_str(out, c"                        return Option::Some(x);\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                Option::None => return Option::None,\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, I::Item) -> B>(self, init: sink B, f: F) -> B {\n");
        buf_str(out, c"        var p = self.f;\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        self.it.fold(init, |acc, x| if p(x) { g(acc, x) } else { acc })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Enumerate<I> { it: I, k: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<I: Iterator> Iterator for Enumerate<I> {\n");
        buf_str(out, c"    type Item = (i64, I::Item);\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<(i64, I::Item)> {\n");
        buf_str(out, c"        match self.it.next() {\n");
        buf_str(out, c"            Option::Some(x) => {\n");
        buf_str(out, c"                let k = self.k;\n");
        buf_str(out, c"                self.k = k + 1;\n");
        buf_str(out, c"                Option::Some((k, x))\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self) -> i64 {\n");
        buf_str(out, c"        self.it.exact_len()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(inout self, k: i64) -> (i64, I::Item) {\n");
        buf_str(out, c"        (self.k + k, self.it.at(k))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, (i64, I::Item)) -> B>(self, init: sink B, f: F) -> B {\n");
        buf_str(out, c"        var e = self;\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        var acc = init;\n");
        buf_str(out, c"        let n = e.it.exact_len();\n");
        buf_str(out, c"        if n >= 0 {\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                acc = g(acc, (e.k + k, e.it.at(k)));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            while let Option::Some(p) = e.next() {\n");
        buf_str(out, c"                acc = g(acc, p);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Zip<I, J> { a: I, b: J }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Iterator, J: Iterator> Iterator for Zip<A, J> {\n");
        buf_str(out, c"    type Item = (A::Item, J::Item);\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<(A::Item, J::Item)> {\n");
        buf_str(out, c"        match self.a.next() {\n");
        buf_str(out, c"            Option::Some(x) => match self.b.next() {\n");
        buf_str(out, c"                Option::Some(y) => Option::Some((x, y)),\n");
        buf_str(out, c"                Option::None => Option::None,\n");
        buf_str(out, c"            },\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self) -> i64 {\n");
        buf_str(out, c"        let n = self.a.exact_len();\n");
        buf_str(out, c"        let m = self.b.exact_len();\n");
        buf_str(out, c"        if n < 0 || m < 0 {\n");
        buf_str(out, c"            -1\n");
        buf_str(out, c"        } else if n < m {\n");
        buf_str(out, c"            n\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            m\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(inout self, k: i64) -> (A::Item, J::Item) {\n");
        buf_str(out, c"        (self.a.at(k), self.b.at(k))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, (A::Item, J::Item)) -> B>(self, init: sink B, f: F) -> B {\n");
        buf_str(out, c"        var z = self;\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        var acc = init;\n");
        buf_str(out, c"        let n = z.exact_len();\n");
        buf_str(out, c"        if n >= 0 {\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                acc = g(acc, (z.a.at(k), z.b.at(k)));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            while let Option::Some(p) = z.next() {\n");
        buf_str(out, c"                acc = g(acc, p);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Take<I> { it: I, n: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<I: Iterator> Iterator for Take<I> {\n");
        buf_str(out, c"    type Item = I::Item;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<I::Item> {\n");
        buf_str(out, c"        if self.n <= 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.n -= 1;\n");
        buf_str(out, c"        self.it.next()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self) -> i64 {\n");
        buf_str(out, c"        let m = self.it.exact_len();\n");
        buf_str(out, c"        if m < 0 {\n");
        buf_str(out, c"            -1\n");
        buf_str(out, c"        } else if self.n <= 0 {\n");
        buf_str(out, c"            0\n");
        buf_str(out, c"        } else if m < self.n {\n");
        buf_str(out, c"            m\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.n\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(inout self, k: i64) -> I::Item {\n");
        buf_str(out, c"        self.it.at(k)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, I::Item) -> B>(self, init: sink B, f: F) -> B {\n");
        buf_str(out, c"        var t = self;\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        var acc = init;\n");
        buf_str(out, c"        let n = t.exact_len();\n");
        buf_str(out, c"        if n >= 0 {\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                acc = g(acc, t.it.at(k));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            while t.n > 0 {\n");
        buf_str(out, c"                match t.it.next() {\n");
        buf_str(out, c"                    Option::Some(x) => {\n");
        buf_str(out, c"                        t.n -= 1;\n");
        buf_str(out, c"                        acc = g(acc, x);\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    Option::None => break,\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Sources ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// `for` over a SliceIter, a Range or a RangeInclusive is a counted loop\n");
        buf_str(out, c"// (front/check/iterate.tach); their `fold` is one too.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `a..b` as a value: start, start + 1, ..., up to end, end excluded.\n");
        buf_str(out, c"pub struct Range<T> { pub start: T, pub end: T }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Iterator for Range<T> {\n");
        buf_str(out, c"    type Item = T;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<T> {\n");
        buf_str(out, c"        if self.start < self.end {\n");
        buf_str(out, c"            let x = self.start;\n");
        buf_str(out, c"            self.start = x + 1;\n");
        buf_str(out, c"            Option::Some(x)\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            Option::None\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self) -> i64 {\n");
        buf_str(out, c"        if self.start < self.end { (self.end - self.start) as i64 } else { 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(inout self, k: i64) -> T {\n");
        buf_str(out, c"        self.start + k as T\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, T) -> B>(self, init: sink B, f: F) -> B {\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        var acc = init;\n");
        buf_str(out, c"        for x in self.start..self.end {\n");
        buf_str(out, c"            acc = g(acc, x);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `a..=b` as a value: end included; `done` once `next` gave end.\n");
        buf_str(out, c"pub struct RangeInclusive<T> { pub start: T, pub end: T, pub done: bool }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Iterator for RangeInclusive<T> {\n");
        buf_str(out, c"    type Item = T;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<T> {\n");
        buf_str(out, c"        if self.done || self.start > self.end {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let x = self.start;\n");
        buf_str(out, c"        if x == self.end {\n");
        buf_str(out, c"            self.done = true;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.start = x + 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some(x)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self) -> i64 {\n");
        buf_str(out, c"        if self.done || self.start > self.end { 0 } else { (self.end - self.start) as i64 + 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(inout self, k: i64) -> T {\n");
        buf_str(out, c"        self.start + k as T\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, T) -> B>(self, init: sink B, f: F) -> B {\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        var acc = init;\n");
        buf_str(out, c"        if !self.done {\n");
        buf_str(out, c"            for x in self.start..=self.end {\n");
        buf_str(out, c"                acc = g(acc, x);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The items of a slice, by value: `v.iter()`, `s.iter()`.\n");
        buf_str(out, c"pub struct SliceIter<T> { s: [T], pos: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Iterator for SliceIter<T> {\n");
        buf_str(out, c"    type Item = T;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<T> {\n");
        buf_str(out, c"        if self.pos < self.s.len {\n");
        buf_str(out, c"            let x = self.s[self.pos];\n");
        buf_str(out, c"            self.pos += 1;\n");
        buf_str(out, c"            Option::Some(x)\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            Option::None\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self) -> i64 {\n");
        buf_str(out, c"        self.s.len - self.pos\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(inout self, k: i64) -> T {\n");
        buf_str(out, c"        self.s[self.pos + k]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, T) -> B>(self, init: sink B, f: F) -> B {\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        var acc = init;\n");
        buf_str(out, c"        let s = self.s;\n");
        buf_str(out, c"        for k in self.pos..s.len {\n");
        buf_str(out, c"            acc = g(acc, s[k]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> SliceIter<T> {\n");
        buf_str(out, c"    // The items left, as a slice.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    // (0.20: self is a copy of the view; what it views is its level 1)\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn as_slice(self) -> [T] {\n");
        buf_str(out, c"        self.s[self.pos..self.s.len]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T>[T] {\n");
        buf_str(out, c"    // Its items, by value.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn iter(self: [T]) -> SliceIter<T> {\n");
        buf_str(out, c"        SliceIter { s: self, pos: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its items, by reference (0.17): `for x in s.iter_ref()`, x a `&T`,\n");
        buf_str(out, c"    // the elements neither copied nor moved.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn iter_ref(self: [T]) -> SliceRefIter<T> {\n");
        buf_str(out, c"        SliceRefIter { s: self, pos: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Sorts it in place by f (see sort_by).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn sort_by<F: FnMut(let T, let T) -> i64>(self: inout [T], f: F) {\n");
        buf_str(out, c"        sort_by(self, f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Exchanges elements i and j (checked; 0.17).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn swap(self: inout [T], i: i64, j: i64) {\n");
        buf_str(out, c"        swap_at::<T>(self, i, j);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // Its items, by value (a view: valid until the vector grows or is\n");
        buf_str(out, c"    // freed).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn iter(self) -> SliceIter<T> {\n");
        buf_str(out, c"        SliceIter { s: self.as_slice(), pos: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its items, by reference (0.17): `for x in v.iter_ref()`, x a `&T`.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn iter_ref(self) -> SliceRefIter<T> {\n");
        buf_str(out, c"        SliceRefIter { s: self.as_slice(), pos: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Sorts it in place by f (see sort_by).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn sort_by<F: FnMut(let T, let T) -> i64>(inout self, f: F) {\n");
        buf_str(out, c"        sort_by(self.as_mut_slice(), f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The items of a slice, by reference (0.17): `v.iter_ref()`,\n");
        buf_str(out, c"// `s.iter_ref()`; a view of the slice.\n");
        buf_str(out, c"pub struct SliceRefIter<T> { s: [T], pos: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Iterator for SliceRefIter<T> {\n");
        buf_str(out, c"    type Item = let T;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<let T> {\n");
        buf_str(out, c"        if self.pos < self.s.len {\n");
        buf_str(out, c"            let x = &self.s[self.pos];\n");
        buf_str(out, c"            self.pos += 1;\n");
        buf_str(out, c"            Option::Some(x)\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            Option::None\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self) -> i64 {\n");
        buf_str(out, c"        self.s.len - self.pos\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(inout self, k: i64) -> let T {\n");
        buf_str(out, c"        self.s[self.pos + k]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `m.iter()`: (key, value) in slot order, until the map changes. (0.17) A\n");
        buf_str(out, c"// view of the map: (0.20) its table's iterator, a view of its control\n");
        buf_str(out, c"// bytes, and its buckets.\n");
        buf_str(out, c"pub struct HashMapIter<K, V> { it: RawIter, data: *(K, V), left: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K, V> Iterator for HashMapIter<K, V> {\n");
        buf_str(out, c"    type Item = (K, V);\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<(K, V)> {\n");
        buf_str(out, c"        let i = self.it.next_index();\n");
        buf_str(out, c"        if i < 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.left -= 1;\n");
        buf_str(out, c"        let e = unsafe { &self.data[i] };\n");
        buf_str(out, c"        Option::Some((unsafe { (*e).0 }, unsafe { (*e).1 }))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self) -> i64 {\n");
        buf_str(out, c"        self.left\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, (K, V)) -> B>(self, init: sink B, f: F) -> B {\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        var acc = init;\n");
        buf_str(out, c"        var it = self.it;\n");
        buf_str(out, c"        for _ in 0..self.left {\n");
        buf_str(out, c"            let i = it.next_index();\n");
        buf_str(out, c"            let e = unsafe { &self.data[i] };\n");
        buf_str(out, c"            acc = g(acc, (unsafe { (*e).0 }, unsafe { (*e).1 }));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Keys<K, V> { it: HashMapIter<K, V> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K, V> Iterator for Keys<K, V> {\n");
        buf_str(out, c"    type Item = K;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<K> {\n");
        buf_str(out, c"        match self.it.next() {\n");
        buf_str(out, c"            Option::Some(e) => Option::Some(e.0),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self) -> i64 {\n");
        buf_str(out, c"        self.it.left\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, K) -> B>(self, init: sink B, f: F) -> B {\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        self.it.fold(init, |acc, e| g(acc, e.0))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Values<K, V> { it: HashMapIter<K, V> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K, V> Iterator for Values<K, V> {\n");
        buf_str(out, c"    type Item = V;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<V> {\n");
        buf_str(out, c"        match self.it.next() {\n");
        buf_str(out, c"            Option::Some(e) => Option::Some(e.1),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self) -> i64 {\n");
        buf_str(out, c"        self.it.left\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, V) -> B>(self, init: sink B, f: F) -> B {\n");
        buf_str(out, c"        var g = f;\n");
        buf_str(out, c"        self.it.fold(init, |acc, e| g(acc, e.1))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Hash + Eq, V, A: Allocator> HashMap<K, V, A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn iter(self) -> HashMapIter<K, V> {\n");
        buf_str(out, c"        let t = self.raw_table();\n");
        buf_str(out, c"        let data = if t.len() == 0 { 0 as *(K, V) } else { t.bucket_ptr() };\n");
        buf_str(out, c"        HashMapIter { it: t.iter(), data: data, left: t.len() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn keys(self) -> Keys<K, V> {\n");
        buf_str(out, c"        Keys { it: self.iter() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn values(self) -> Values<K, V> {\n");
        buf_str(out, c"        Values { it: self.iter() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place by f: f(a, b) is negative, zero or positive as *a goes\n");
        buf_str(out, c"// before, with or after *b (`|a, b| a.cmp(b)`: smallest first). A\n");
        buf_str(out, c"// heapsort: not stable. (0.17) f takes references; the elements move as\n");
        buf_str(out, c"// bits, so any T sorts, owned ones too.\n");
        buf_str(out, c"pub fn sort_by<T, F: FnMut(let T, let T) -> i64>(s: inout [T], f: F) {\n");
        buf_str(out, c"    var g = f;\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    let p = s.ptr;\n");
        buf_str(out, c"    var start = n / 2;\n");
        buf_str(out, c"    var end = n;\n");
        buf_str(out, c"    // (each round takes one from start or end: n / 2 + n at most; 0.16:\n");
        buf_str(out, c"    // counted loops, no effect diverge; every index is below end <= n)\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        for _ in 0..n / 2 + n + 1 {\n");
        buf_str(out, c"            // Build the heap from n/2 down, then move its top behind it.\n");
        buf_str(out, c"            if start > 0 {\n");
        buf_str(out, c"                start -= 1;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                end -= 1;\n");
        buf_str(out, c"                if end <= 0 {\n");
        buf_str(out, c"                    return;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                swap_raw::<T>(p, 0, end);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            var root = start;\n");
        buf_str(out, c"            for _ in 0..64 {\n");
        buf_str(out, c"                var child = 2 * root + 1;\n");
        buf_str(out, c"                if child >= end {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if child + 1 < end && g(*(&p[child]), *(&p[child + 1])) < 0 {\n");
        buf_str(out, c"                    child += 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if g(*(&p[root]), *(&p[child])) >= 0 {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                swap_raw::<T>(p, root, child);\n");
        buf_str(out, c"                root = child;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::iter ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::slice ----\n");
        buf_str(out, c"pub mod slice {\n");
        buf_str(out, c"// std::slice: sorting, searching and the slice algorithms (0.20: from\n");
        buf_str(out, c"// std.tach; the 0.20 sorts, after Rust's ipnsort and driftsort, in\n");
        buf_str(out, c"// the kernels below, slice/unstable.tach and slice/stable.tach; binary\n");
        buf_str(out, c"// search in slice/search.tach; reverse, rotations, fill, dedup, retain\n");
        buf_str(out, c"// and the heap sifts in slice/algo.tach).\n");
        buf_str(out, c"\n");
        buf_str(out, c"mod unstable;\n");
        buf_str(out, c"mod stable;\n");
        buf_str(out, c"mod search;\n");
        buf_str(out, c"mod algo;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub use algo::{\n");
        buf_str(out, c"    dedup, dedup_by, dedup_by_key, fill, heap_sift_down_less, heap_sift_down_to_bottom_less,\n");
        buf_str(out, c"    heap_sift_up_less, retain_by, reverse, rotate_left, rotate_right,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"pub use search::{binary_search, binary_search_by, binary_search_by_key, partition_point};\n");
        buf_str(out, c"pub use stable::{\n");
        buf_str(out, c"    sort_stable_less, sort_stable_less_with, sort_stable_noalloc, sort_stable_scratch_len,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"pub use unstable::{\n");
        buf_str(out, c"    select_nth_unstable, select_nth_unstable_by, select_nth_unstable_by_key,\n");
        buf_str(out, c"    select_nth_unstable_less, sort_unstable, sort_unstable_by, sort_unstable_by_key,\n");
        buf_str(out, c"    sort_unstable_less,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Allocator, Gpa, Ord, Vec};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Sorting (0.9) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place, smallest first; not stable (equal elements may change\n");
        buf_str(out, c"// order): the unstable sort, `sort_unstable` (0.20: ipnsort; before, an\n");
        buf_str(out, c"// introsort). O(n log n) comparisons at worst, O(n) when s is one run up\n");
        buf_str(out, c"// or down. A `cmp` that is not a total order leaves s a permutation of\n");
        buf_str(out, c"// itself in some order, never out of bounds. The sorts' loops are counted\n");
        buf_str(out, c"// and nothing recurses: no effect diverge. (0.17) `sort(&mut a[..])`,\n");
        buf_str(out, c"// `sort(v.as_mut_slice())`, `v.sort()`; the elements move as bits, so any\n");
        buf_str(out, c"// T: Ord sorts, owned ones too.\n");
        buf_str(out, c"pub fn sort<T: Ord>(s: inout [T]) {\n");
        buf_str(out, c"    sort_unstable_less(s, |a: T, b: T| a < b);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Ord, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // Sorts it in place, smallest first (0.17; see sort).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn sort(inout self) {\n");
        buf_str(out, c"        sort(self.as_mut_slice());\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Ord>[T] {\n");
        buf_str(out, c"    // Sorts it in place, smallest first (0.17; see sort).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn sort(self: inout [T]) {\n");
        buf_str(out, c"        sort(self);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Swapping (0.17) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Exchanges s[i] and s[j] (checked), as bits: any T, owned ones too.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn swap_at<T>(s: inout [T], i: i64, j: i64) {\n");
        buf_str(out, c"    let a: *T = &s[i];\n");
        buf_str(out, c"    let b: *T = &s[j];\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let t = *a;\n");
        buf_str(out, c"        *a = *b;\n");
        buf_str(out, c"        *b = t;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Exchanges p[i] and p[j], as bits. Unsafe: both are in p's elements.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub unsafe fn swap_raw<T>(p: *T, i: i64, j: i64) {\n");
        buf_str(out, c"    let t = p[i];\n");
        buf_str(out, c"    p[i] = p[j];\n");
        buf_str(out, c"    p[j] = t;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Stable sort (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place, smallest first, keeping equal elements in the order\n");
        buf_str(out, c"// they had (0.15), with a buffer from allocator a (0.16):\n");
        buf_str(out, c"// `sort_stable_by_in` with `|a, b| a.cmp(b)`.\n");
        buf_str(out, c"pub fn sort_stable_in<T: Ord, A: Allocator>(s: inout [T], a: sink A) {\n");
        buf_str(out, c"    sort_stable_less_in(s, |x: T, y: T| x < y, a);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"sort_stable_in(s, gpa)\")]\n");
        buf_str(out, c"pub fn sort_stable<T: Ord>(s: inout [T]) {\n");
        buf_str(out, c"    sort_stable_in(s, Gpa::ambient());\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"sort_stable_by_in(s, f, gpa)\")]\n");
        buf_str(out, c"pub fn sort_stable_by<T, F: FnMut(let T, let T) -> i64>(s: inout [T], f: F) {\n");
        buf_str(out, c"    sort_stable_by_in(s, f, Gpa::ambient());\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place by f (as sort_by: f(a, b) negative when *a goes before\n");
        buf_str(out, c"// *b), keeping equal elements in the order they had (0.15). The stable\n");
        buf_str(out, c"// sort (0.20: driftsort; before, a merge sort) with its scratch from\n");
        buf_str(out, c"// allocator a (0.16): none up to 20 elements, else all of s up to 8 MB\n");
        buf_str(out, c"// and half beyond (`sort_stable_scratch_len`). O(n log n) comparisons. A\n");
        buf_str(out, c"// `f` that is not a total order leaves s a permutation of itself in some\n");
        buf_str(out, c"// order, never out of bounds.\n");
        buf_str(out, c"pub fn sort_stable_by_in<T, F: FnMut(let T, let T) -> i64, A: Allocator>(s: inout [T], f: F,\n");
        buf_str(out, c"    a: sink A) {\n");
        buf_str(out, c"    var g = f;\n");
        buf_str(out, c"    sort_stable_less_in(s, |x: T, y: T| g(x, y) < 0, a);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The stable sort by is_less with its scratch from a. (0.17) The elements\n");
        buf_str(out, c"// move as bits between s and the buffer through raw pointers (the\n");
        buf_str(out, c"// buffer's elements are never its own: its length stays 0).\n");
        buf_str(out, c"pub fn sort_stable_less_in<T, F: FnMut(let T, let T) -> bool,\n");
        buf_str(out, c"    A: Allocator>(s: inout [T], is_less: F, a: sink A) {\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    if n <= 20 {\n");
        buf_str(out, c"        // (no scratch: insertion sort)\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            sort_stable_less_with(s, 0 as *T, 0, is_less);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let len = sort_stable_scratch_len::<T>(n);\n");
        buf_str(out, c"    var buf: Vec<T, A> = Vec::with_capacity_in(len, a);\n");
        buf_str(out, c"    // (the buffer has room for len elements, outside s)\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        sort_stable_less_with(s, buf.ptr, len, is_less);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    buf.free();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Sort kernels (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What both sorts (0.20) use on short slices, after Rust's\n");
        buf_str(out, c"// slice::sort::shared::smallsort: insertion sort, a branchless stable\n");
        buf_str(out, c"// sort of 4 elements, the bidirectional merge, and the general small sort\n");
        buf_str(out, c"// built from them (two halves presorted in 8s or 4s, completed by\n");
        buf_str(out, c"// insertion, then merged from both ends at once). Every one is stable.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Unsafe code: as the sorts' (Sort, unstable): each kernel takes raw\n");
        buf_str(out, c"// pointers to slots its caller owns, with their lengths in the contract\n");
        buf_str(out, c"// at it; every index is bounded by those lengths whatever the comparator\n");
        buf_str(out, c"// answers. Elements move as bits; with no unwinding (a panic ends the\n");
        buf_str(out, c"// process) a half-done kernel is never observed and nothing is dropped\n");
        buf_str(out, c"// twice.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts v[0..n] by insertion, v[0..offset] being sorted (1 <= offset).\n");
        buf_str(out, c"// Stable: an element moves left only past greater ones.\n");
        buf_str(out, c"unsafe fn insertion_sort_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, offset: i64,\n");
        buf_str(out, c"    is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    for i in offset..n {\n");
        buf_str(out, c"        insert_tail_raw(v, i, f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Inserts v[i] into the sorted v[0..i] (i >= 1), after the elements\n");
        buf_str(out, c"// equal to it.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn insert_tail_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, i: i64, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    if f(*(&v[i]), *(&v[i - 1])) {\n");
        buf_str(out, c"        let x = v[i];\n");
        buf_str(out, c"        v[i] = v[i - 1];\n");
        buf_str(out, c"        var j = i - 1;\n");
        buf_str(out, c"        // (j >= 1 inside the loop: it runs i - 1 times at most)\n");
        buf_str(out, c"        for _ in 0..i - 1 {\n");
        buf_str(out, c"            if !f(x, *(&v[j - 1])) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            v[j] = v[j - 1];\n");
        buf_str(out, c"            j -= 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v[j] = x;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// dst[0..4] = v[0..4] sorted, stably, with five comparisons and no\n");
        buf_str(out, c"// branch on them (Rust's sort4_stable). v and dst do not overlap.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn sort4_stable_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, dst: *T, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    // Two ordered pairs, a <= b and c <= d.\n");
        buf_str(out, c"    let c1 = f(*(&v[1]), *(&v[0])) as i64;\n");
        buf_str(out, c"    let c2 = f(*(&v[3]), *(&v[2])) as i64;\n");
        buf_str(out, c"    let a: *T = &v[c1];\n");
        buf_str(out, c"    let b: *T = &v[1 - c1];\n");
        buf_str(out, c"    let c: *T = &v[2 + c2];\n");
        buf_str(out, c"    let d: *T = &v[3 - c2];\n");
        buf_str(out, c"    // The least and the greatest, and the two left, in their order.\n");
        buf_str(out, c"    let c3 = f(*c, *a);\n");
        buf_str(out, c"    let c4 = f(*d, *b);\n");
        buf_str(out, c"    let min = if c3 { c } else { a };\n");
        buf_str(out, c"    let max = if c4 { b } else { d };\n");
        buf_str(out, c"    let unknown_left = if c3 { a } else if c4 { c } else { b };\n");
        buf_str(out, c"    let unknown_right = if c4 { d } else if c3 { b } else { c };\n");
        buf_str(out, c"    let c5 = f(*unknown_right, *unknown_left);\n");
        buf_str(out, c"    let lo = if c5 { unknown_right } else { unknown_left };\n");
        buf_str(out, c"    let hi = if c5 { unknown_left } else { unknown_right };\n");
        buf_str(out, c"    dst[0] = *min;\n");
        buf_str(out, c"    dst[1] = *lo;\n");
        buf_str(out, c"    dst[2] = *hi;\n");
        buf_str(out, c"    dst[3] = *max;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// dst[0..8] = v[0..8] sorted, stably, through tmp[0..8]. None overlap.\n");
        buf_str(out, c"unsafe fn sort8_stable_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, dst: *T, tmp: *T, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    sort4_stable_raw(v, tmp, f);\n");
        buf_str(out, c"    sort4_stable_raw(&v[4], &tmp[4], f);\n");
        buf_str(out, c"    bidirectional_merge_raw(tmp, 8, dst, f);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Merges the sorted halves src[0..len/2] and src[len/2..len] (len >= 2)\n");
        buf_str(out, c"// into dst[0..len], stably, from both ends at once: each round takes the\n");
        buf_str(out, c"// least of the two fronts and the greatest of the two backs, with no\n");
        buf_str(out, c"// branch on the comparisons. src and dst do not overlap. Every read stays\n");
        buf_str(out, c"// in src[0..len] whatever the comparator answers (Rust's argument: each\n");
        buf_str(out, c"// end moves at most len / 2 times); when the ends do not meet as they\n");
        buf_str(out, c"// must for a total order, dst gets src back as it was, so it holds a\n");
        buf_str(out, c"// permutation of src either way.\n");
        buf_str(out, c"unsafe fn bidirectional_merge_raw<T, F: FnMut(let T, let T) -> bool>(src: *T, len: i64, dst: *T,\n");
        buf_str(out, c"    is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    let half = len / 2;\n");
        buf_str(out, c"    var left = 0;\n");
        buf_str(out, c"    var right = half;\n");
        buf_str(out, c"    var out = 0;\n");
        buf_str(out, c"    var left_rev = half - 1;\n");
        buf_str(out, c"    var right_rev = len - 1;\n");
        buf_str(out, c"    var out_rev = len - 1;\n");
        buf_str(out, c"    for _ in 0..half {\n");
        buf_str(out, c"        let take_left = !f(*(&src[right]), *(&src[left]));\n");
        buf_str(out, c"        let p: *T = if take_left { &src[left] } else { &src[right] };\n");
        buf_str(out, c"        left += take_left as i64;\n");
        buf_str(out, c"        right += (!take_left) as i64;\n");
        buf_str(out, c"        dst[out] = *p;\n");
        buf_str(out, c"        out += 1;\n");
        buf_str(out, c"        let take_left_rev = f(*(&src[right_rev]), *(&src[left_rev]));\n");
        buf_str(out, c"        let q: *T = if take_left_rev { &src[left_rev] } else { &src[right_rev] };\n");
        buf_str(out, c"        left_rev -= take_left_rev as i64;\n");
        buf_str(out, c"        right_rev -= (!take_left_rev) as i64;\n");
        buf_str(out, c"        dst[out_rev] = *q;\n");
        buf_str(out, c"        out_rev -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if len % 2 != 0 {\n");
        buf_str(out, c"        let left_nonempty = left <= left_rev;\n");
        buf_str(out, c"        let p: *T = if left_nonempty { &src[left] } else { &src[right] };\n");
        buf_str(out, c"        dst[out] = *p;\n");
        buf_str(out, c"        left += left_nonempty as i64;\n");
        buf_str(out, c"        right += (!left_nonempty) as i64;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if left != left_rev + 1 || right != right_rev + 1 {\n");
        buf_str(out, c"        // (not a total order)\n");
        buf_str(out, c"        for i in 0..len {\n");
        buf_str(out, c"            dst[i] = src[i];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Puts v[a] and v[b] (a < b) in order, with no branch on the comparison.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn swap_if_less_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, a: i64, b: i64, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    let pa: *T = &v[a];\n");
        buf_str(out, c"    let pb: *T = &v[b];\n");
        buf_str(out, c"    let sw = f(*pb, *pa);\n");
        buf_str(out, c"    if size_of(T) == 8 {\n");
        buf_str(out, c"        // (8-byte elements: their bits selected in registers, csel, not\n");
        buf_str(out, c"        // through a selected address; no T is moved, so owned ones too)\n");
        buf_str(out, c"        let x = *(pa as *u64);\n");
        buf_str(out, c"        let y = *(pb as *u64);\n");
        buf_str(out, c"        *(pa as *u64) = if sw { y } else { x };\n");
        buf_str(out, c"        *(pb as *u64) = if sw { x } else { y };\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let l = if sw { pb } else { pa };\n");
        buf_str(out, c"    let r = if sw { pa } else { pb };\n");
        buf_str(out, c"    let x = *l;\n");
        buf_str(out, c"    let y = *r;\n");
        buf_str(out, c"    v[a] = x;\n");
        buf_str(out, c"    v[b] = y;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts v[0..9] with an optimal sorting network (25 comparators, depth 7;\n");
        buf_str(out, c"// Bert Dobbelaere's list, as Rust's sort9_optimal). Not stable.\n");
        buf_str(out, c"unsafe fn sort9_network_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    swap_if_less_raw(v, 0, 3, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 1, 7, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 2, 5, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 4, 8, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 0, 7, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 2, 4, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 3, 8, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 5, 6, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 0, 2, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 1, 3, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 4, 5, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 7, 8, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 1, 4, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 3, 6, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 5, 7, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 0, 1, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 2, 4, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 3, 5, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 6, 8, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 2, 3, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 4, 5, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 6, 7, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 1, 2, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 3, 4, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 5, 6, f);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts v[0..13] with an optimal sorting network (45 comparators, depth\n");
        buf_str(out, c"// 10; as Rust's sort13_optimal). Not stable.\n");
        buf_str(out, c"unsafe fn sort13_network_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    swap_if_less_raw(v, 0, 12, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 1, 10, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 2, 9, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 3, 7, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 5, 11, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 6, 8, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 1, 6, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 2, 3, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 4, 11, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 7, 9, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 8, 10, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 0, 4, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 1, 2, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 3, 6, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 7, 8, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 9, 10, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 11, 12, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 4, 6, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 5, 9, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 8, 11, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 10, 12, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 0, 5, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 3, 8, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 4, 7, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 6, 11, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 9, 10, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 0, 1, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 2, 5, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 6, 9, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 7, 8, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 10, 11, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 1, 3, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 2, 4, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 5, 6, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 9, 10, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 1, 2, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 3, 4, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 5, 7, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 6, 8, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 2, 3, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 4, 5, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 6, 7, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 8, 9, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 3, 4, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 5, 6, f);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts v[0..len] (len <= 32) with scratch[0..len], not stably (Rust's\n");
        buf_str(out, c"// small_sort_network, for elements of 8 bytes or less): each half (the\n");
        buf_str(out, c"// whole below 18) presorted by a network of 13 or 9, completed by\n");
        buf_str(out, c"// insertion, and the halves merged through the scratch.\n");
        buf_str(out, c"unsafe fn small_sort_network_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, scratch: *T,\n");
        buf_str(out, c"    is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    if len < 2 {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let half = len / 2;\n");
        buf_str(out, c"    let whole = len < 18;\n");
        buf_str(out, c"    let first = if whole { len } else { half };\n");
        buf_str(out, c"    presort_network_raw(v, first, f);\n");
        buf_str(out, c"    if whole {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    presort_network_raw(&v[half], len - half, f);\n");
        buf_str(out, c"    for i in 0..len {\n");
        buf_str(out, c"        scratch[i] = v[i];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    bidirectional_merge_raw(scratch, len, v, f);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts v[0..len] (len <= 17): a network over its first 13 or 9, then\n");
        buf_str(out, c"// insertion.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn presort_network_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    var presorted = 1;\n");
        buf_str(out, c"    if len >= 13 {\n");
        buf_str(out, c"        sort13_network_raw(v, f);\n");
        buf_str(out, c"        presorted = 13;\n");
        buf_str(out, c"    } else if len >= 9 {\n");
        buf_str(out, c"        sort9_network_raw(v, f);\n");
        buf_str(out, c"        presorted = 9;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    insertion_sort_raw(v, len, presorted, f);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts v[0..len] (len <= 32), stably, with scratch[0..len + 16] (Rust's\n");
        buf_str(out, c"// small_sort_general_with_scratch): each half is presorted in 8s (or 4s)\n");
        buf_str(out, c"// into the scratch, completed there by insertion, and the halves are\n");
        buf_str(out, c"// merged back into v.\n");
        buf_str(out, c"unsafe fn small_sort_raw<T,\n");
        buf_str(out, c"    F: FnMut(let T, let T) -> bool>(v: *T, len: i64, scratch: *T, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    if len < 2 {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let half = len / 2;\n");
        buf_str(out, c"    var presorted = 1;\n");
        buf_str(out, c"    if len >= 16 {\n");
        buf_str(out, c"        sort8_stable_raw(v, scratch, &scratch[len], f);\n");
        buf_str(out, c"        sort8_stable_raw(&v[half], &scratch[half], &scratch[len + 8], f);\n");
        buf_str(out, c"        presorted = 8;\n");
        buf_str(out, c"    } else if len >= 8 {\n");
        buf_str(out, c"        sort4_stable_raw(v, scratch, f);\n");
        buf_str(out, c"        sort4_stable_raw(&v[half], &scratch[half], f);\n");
        buf_str(out, c"        presorted = 4;\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        scratch[0] = v[0];\n");
        buf_str(out, c"        scratch[half] = v[half];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for i in presorted..half {\n");
        buf_str(out, c"        scratch[i] = v[i];\n");
        buf_str(out, c"        insert_tail_raw(scratch, i, f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let w: *T = &scratch[half];\n");
        buf_str(out, c"    let src: *T = &v[half];\n");
        buf_str(out, c"    for i in presorted..len - half {\n");
        buf_str(out, c"        w[i] = src[i];\n");
        buf_str(out, c"        insert_tail_raw(w, i, f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    bidirectional_merge_raw(scratch, len, v, f);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The length of the run that starts v[0..n] (n >= 2), and whether it is\n");
        buf_str(out, c"// strictly descending (else non-descending).\n");
        buf_str(out, c"unsafe fn existing_run_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, is_less: F) -> (i64,\n");
        buf_str(out, c"    bool) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    let desc = f(*(&v[1]), *(&v[0]));\n");
        buf_str(out, c"    var run = 2;\n");
        buf_str(out, c"    // (run < n inside each loop)\n");
        buf_str(out, c"    if desc {\n");
        buf_str(out, c"        for _ in 2..n {\n");
        buf_str(out, c"            if !f(*(&v[run]), *(&v[run - 1])) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            run += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        for _ in 2..n {\n");
        buf_str(out, c"            if f(*(&v[run]), *(&v[run - 1])) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            run += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    (run, desc)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Reverses v[0..n].\n");
        buf_str(out, c"unsafe fn reverse_raw<T>(v: *T, n: i64) {\n");
        buf_str(out, c"    for i in 0..n / 2 {\n");
        buf_str(out, c"        let t = v[i];\n");
        buf_str(out, c"        v[i] = v[n - 1 - i];\n");
        buf_str(out, c"        v[n - 1 - i] = t;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The index of a pivot for v[0..len] (len >= 8): the median of three\n");
        buf_str(out, c"// elements at 0, 4/8 and 7/8 of it, each of them, from 64 elements, the\n");
        buf_str(out, c"// median of three spread the same way over its eighth (ipnsort's\n");
        buf_str(out, c"// recursive pseudo-median, which samples about n^0.53 elements).\n");
        buf_str(out, c"unsafe fn choose_pivot_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, is_less: F) -> i64 {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    let n8 = len / 8;\n");
        buf_str(out, c"    let a = 0;\n");
        buf_str(out, c"    let b = n8 * 4;\n");
        buf_str(out, c"    let c = n8 * 7;\n");
        buf_str(out, c"    if n8 < 8 {\n");
        buf_str(out, c"        return median3_raw(v, a, b, c, f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if n8 < 64 {\n");
        buf_str(out, c"        let m = n8 / 8;\n");
        buf_str(out, c"        let x = median3_raw(v, a, a + m * 4, a + m * 7, f);\n");
        buf_str(out, c"        let y = median3_raw(v, b, b + m * 4, b + m * 7, f);\n");
        buf_str(out, c"        let z = median3_raw(v, c, c + m * 4, c + m * 7, f);\n");
        buf_str(out, c"        return median3_raw(v, x, y, z, f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    median3_rec_raw(v, n8, f)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The pseudo-median of v for n = len / 8 >= 64, on an explicit stack of\n");
        buf_str(out, c"// frames (positions x, y, z, their spread n, the children done and their\n");
        buf_str(out, c"// medians): a frame with n >= 8 replaces each position by the median of\n");
        buf_str(out, c"// a frame over its eighth. The depth is log8(len) <= 21.\n");
        buf_str(out, c"unsafe fn median3_rec_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, is_less: F) -> i64 {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    var pos: [i64; 72] = [0; 72];\n");
        buf_str(out, c"    var res: [i64; 72] = [0; 72];\n");
        buf_str(out, c"    var spread: [i64; 24] = [0; 24];\n");
        buf_str(out, c"    var done: [i64; 24] = [0; 24];\n");
        buf_str(out, c"    var d = 0;\n");
        buf_str(out, c"    pos[0] = 0;\n");
        buf_str(out, c"    pos[1] = n * 4;\n");
        buf_str(out, c"    pos[2] = n * 7;\n");
        buf_str(out, c"    spread[0] = n;\n");
        buf_str(out, c"    // (each frame is visited once per child and once more: fewer rounds\n");
        buf_str(out, c"    // than 4n + 4 for any n)\n");
        buf_str(out, c"    var result = 0;\n");
        buf_str(out, c"    for _ in 0..4 * n + 4 {\n");
        buf_str(out, c"        let k = done[d];\n");
        buf_str(out, c"        if spread[d] < 8 || k == 3 {\n");
        buf_str(out, c"            result = if spread[d] < 8 {\n");
        buf_str(out, c"                median3_raw(v, pos[3 * d], pos[3 * d + 1], pos[3 * d + 2], f)\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                median3_raw(v, res[3 * d], res[3 * d + 1], res[3 * d + 2], f)\n");
        buf_str(out, c"            };\n");
        buf_str(out, c"            if d == 0 {\n");
        buf_str(out, c"                return result;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            d -= 1;\n");
        buf_str(out, c"            res[3 * d + done[d]] = result;\n");
        buf_str(out, c"            done[d] += 1;\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let p = pos[3 * d + k];\n");
        buf_str(out, c"        let m = spread[d] / 8;\n");
        buf_str(out, c"        d += 1;\n");
        buf_str(out, c"        pos[3 * d] = p;\n");
        buf_str(out, c"        pos[3 * d + 1] = p + m * 4;\n");
        buf_str(out, c"        pos[3 * d + 2] = p + m * 7;\n");
        buf_str(out, c"        spread[d] = m;\n");
        buf_str(out, c"        done[d] = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    result\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The index of the median of v[a], v[b], v[c], with no branch on the\n");
        buf_str(out, c"// comparisons (three of them, always).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn median3_raw<T,\n");
        buf_str(out, c"    F: FnMut(let T, let T) -> bool>(v: *T, a: i64, b: i64, c: i64, is_less: F) -> i64 {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    let x = f(*(&v[a]), *(&v[b]));\n");
        buf_str(out, c"    let y = f(*(&v[a]), *(&v[c]));\n");
        buf_str(out, c"    let z = f(*(&v[b]), *(&v[c]));\n");
        buf_str(out, c"    // x == y: v[a] is the least or the greatest, and the median is the\n");
        buf_str(out, c"    // greater of v[b], v[c] (x) or the lesser (!x)\n");
        buf_str(out, c"    let bc = if z != x { c } else { b };\n");
        buf_str(out, c"    if x == y { bc } else { a }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The sorts' scratch on the stack: 4 KB, 16-aligned, written before it is\n");
        buf_str(out, c"// read (bytes, not elements: nothing in it is ever dropped).\n");
        buf_str(out, c"#[repr(C, align(16))]\n");
        buf_str(out, c"struct SortStackBuf { words: [u64; 512] }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// How many elements of T fit in a SortStackBuf (0 for an alignment over\n");
        buf_str(out, c"// 16, or a T of no size).\n");
        buf_str(out, c"fn sort_stack_cap<T>() -> i64 {\n");
        buf_str(out, c"    if align_of(T) <= 16 && size_of(T) > 0 { 4096 / size_of(T) } else { 0 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Rotates v[0..n] left by k (0 <= k <= n): v[k..n] then v[0..k], by\n");
        buf_str(out, c"// three reversals.\n");
        buf_str(out, c"unsafe fn rotate_raw<T>(v: *T, n: i64, k: i64) {\n");
        buf_str(out, c"    if k == 0 || k == n {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    reverse_raw(v, k);\n");
        buf_str(out, c"    reverse_raw(&v[k], n - k);\n");
        buf_str(out, c"    reverse_raw(v, n);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::slice::unstable ----\n");
        buf_str(out, c"mod unstable {\n");
        buf_str(out, c"// std::slice::unstable: the unstable sort, ipnsort (0.20).\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Ord, forget};\n");
        buf_str(out, c"use super::{\n");
        buf_str(out, c"    SortStackBuf, choose_pivot_raw, existing_run_raw, insertion_sort_raw, reverse_raw,\n");
        buf_str(out, c"    small_sort_network_raw, small_sort_raw, sort_stack_cap,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Sort, unstable (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The unstable sort (0.20; docs/design/collections-text-io.md §2.4.6),\n");
        buf_str(out, c"// after Rust's ipnsort: a slice that is one run, ascending or strictly\n");
        buf_str(out, c"// descending, costs n - 1 comparisons; otherwise a quicksort with the\n");
        buf_str(out, c"// small sort (Sort kernels) up to 32 elements, a branchless cyclic Lomuto\n");
        buf_str(out, c"// partition, the median of three as the pivot (a recursive pseudo-median\n");
        buf_str(out, c"// from 64 elements), heapsort below a depth of 2·log2(n), and a partition\n");
        buf_str(out, c"// that puts the elements equal to the pivot in place at once when the\n");
        buf_str(out, c"// pivot is no greater than the one before it, so that input with k\n");
        buf_str(out, c"// distinct values costs O(n log k).\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Unsafe code: the kernels work on a raw pointer `v` and a length `n`\n");
        buf_str(out, c"// taken from one slice (`s.ptr`, `s.len`, by the safe entry points). Each\n");
        buf_str(out, c"// index they form lies in 0..n by the loop bounds noted at it, whatever\n");
        buf_str(out, c"// the comparator answers: a comparator that is not a total order leaves\n");
        buf_str(out, c"// the slice a permutation of what it held, in some order, and never reads\n");
        buf_str(out, c"// or writes outside it. Elements move as bits, so any T sorts, owned\n");
        buf_str(out, c"// ones too: an element read out through the pointer (the lifted one, the\n");
        buf_str(out, c"// one in transit) is written back exactly once, and a copy kept only to\n");
        buf_str(out, c"// compare with (the pivot) is forgotten, never dropped; raw writes drop\n");
        buf_str(out, c"// nothing. Nothing unwinds: a comparator that panics ends the process, so\n");
        buf_str(out, c"// a slice caught mid-partition (an element in two places, one in none) is\n");
        buf_str(out, c"// never observed and no drop runs twice. No loop is uncounted and nothing\n");
        buf_str(out, c"// recurses: the sorts do not have the effect diverge.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Slices up to this long are sorted by the small sort.\n");
        buf_str(out, c"const SORT_UNSTABLE_SMALL: i64 = 32;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place, smallest first; not stable (equal elements may change\n");
        buf_str(out, c"// order). Rust's `sort_unstable`.\n");
        buf_str(out, c"pub fn sort_unstable<T: Ord>(s: inout [T]) {\n");
        buf_str(out, c"    sort_unstable_less(s, |a: T, b: T| a < b);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place by f (`f(a, b)` negative, zero or positive as *a goes\n");
        buf_str(out, c"// before, with or after *b); not stable.\n");
        buf_str(out, c"pub fn sort_unstable_by<T, F: FnMut(let T, let T) -> i64>(s: inout [T], f: F) {\n");
        buf_str(out, c"    var g = f;\n");
        buf_str(out, c"    sort_unstable_less(s, |a: T, b: T| g(a, b) < 0);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place by the key f gives each element, smallest first; not\n");
        buf_str(out, c"// stable. f runs on both sides of every comparison.\n");
        buf_str(out, c"pub fn sort_unstable_by_key<T, K: Ord, F: FnMut(let T) -> K>(s: inout [T], f: F) {\n");
        buf_str(out, c"    var g = f;\n");
        buf_str(out, c"    sort_unstable_less(s, |a: T, b: T| g(a) < g(b));\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place by is_less (`is_less(a, b)`: *a goes strictly before\n");
        buf_str(out, c"// *b); not stable. The core the other unstable sorts call.\n");
        buf_str(out, c"pub fn sort_unstable_less<T, F: FnMut(let T, let T) -> bool>(s: inout [T], is_less: F) {\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    if n < 2 {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // (s.ptr and s.len are one slice's)\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        ipnsort_raw(s.ptr, n, is_less);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// v[0..n], n >= 2.\n");
        buf_str(out, c"unsafe fn ipnsort_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    if n <= SORT_UNSTABLE_SMALL {\n");
        buf_str(out, c"        var buf: SortStackBuf = SortStackBuf { words: [0; 512] };\n");
        buf_str(out, c"        if sort_stack_cap::<T>() >= n + 16 {\n");
        buf_str(out, c"            small_sort_raw(v, n, &buf as *T, f);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            insertion_sort_raw(v, n, 1, f);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let (run, desc) = existing_run_raw(v, n, f);\n");
        buf_str(out, c"    if run == n {\n");
        buf_str(out, c"        if desc {\n");
        buf_str(out, c"            reverse_raw(v, n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // 2·log2(n) levels of partitions before heapsort\n");
        buf_str(out, c"    var limit = 0;\n");
        buf_str(out, c"    for k in 1..63 {\n");
        buf_str(out, c"        if (n >> k) == 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        limit += 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    quicksort_raw(v, n, limit, f);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts v[0..n] by heapsort: O(n log n) whatever the input.\n");
        buf_str(out, c"unsafe fn heapsort_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    for k in 0..n / 2 {\n");
        buf_str(out, c"        sift_down_raw(v, n / 2 - 1 - k, n, f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for k in 1..n {\n");
        buf_str(out, c"        let end = n - k;\n");
        buf_str(out, c"        let t = v[0];\n");
        buf_str(out, c"        v[0] = v[end];\n");
        buf_str(out, c"        v[end] = t;\n");
        buf_str(out, c"        sift_down_raw(v, 0, end, f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Moves v[node] down the max-heap v[0..end] (node < end).\n");
        buf_str(out, c"// (the node's index at least doubles each round: 64 at most)\n");
        buf_str(out, c"unsafe fn sift_down_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, node: i64, end: i64, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    var at = node;\n");
        buf_str(out, c"    for _ in 0..64 {\n");
        buf_str(out, c"        var child = 2 * at + 1;\n");
        buf_str(out, c"        if child >= end {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if child + 1 < end {\n");
        buf_str(out, c"            child += f(*(&v[child]), *(&v[child + 1])) as i64;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if !f(*(&v[at]), *(&v[child])) {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let t = v[at];\n");
        buf_str(out, c"        v[at] = v[child];\n");
        buf_str(out, c"        v[child] = t;\n");
        buf_str(out, c"        at = child;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The quicksort of v[0..n] (n > SORT_UNSTABLE_SMALL). The ranges left to\n");
        buf_str(out, c"// sort are kept on a stack, not recursion: the shorter side of each\n");
        buf_str(out, c"// partition is sorted next and the longer kept, so at most log2(n) <= 63\n");
        buf_str(out, c"// are kept at once. A range's ancestor pivot, when it has one, is the\n");
        buf_str(out, c"// element just before it (it was placed by the partition that made the\n");
        buf_str(out, c"// range).\n");
        buf_str(out, c"unsafe fn quicksort_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, limit0: i64, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    // (the small sort.s scratch)\n");
        buf_str(out, c"    var buf: SortStackBuf = SortStackBuf { words: [0; 512] };\n");
        buf_str(out, c"    let sp = &buf as *T;\n");
        buf_str(out, c"    let cap = sort_stack_cap::<T>();\n");
        buf_str(out, c"    var kept_lo: [i64; 64] = [0; 64];\n");
        buf_str(out, c"    var kept_hi: [i64; 64] = [0; 64];\n");
        buf_str(out, c"    var kept_limit: [i64; 64] = [0; 64];\n");
        buf_str(out, c"    var kept_anc: [bool; 64] = [false; 64];\n");
        buf_str(out, c"    var kept = 0;\n");
        buf_str(out, c"    var lo = 0;\n");
        buf_str(out, c"    var hi = n;\n");
        buf_str(out, c"    var limit = limit0;\n");
        buf_str(out, c"    var anc = false;\n");
        buf_str(out, c"    // (each round places a pivot or finishes a range: 2n + 1 at most)\n");
        buf_str(out, c"    for _ in 0..2 * n + 2 {\n");
        buf_str(out, c"        let len = hi - lo;\n");
        buf_str(out, c"        if len <= SORT_UNSTABLE_SMALL || limit == 0 {\n");
        buf_str(out, c"            if len <= SORT_UNSTABLE_SMALL {\n");
        buf_str(out, c"                // (size_of is a constant: one of the two is compiled)\n");
        buf_str(out, c"                if len < 2 {\n");
        buf_str(out, c"                    // (nothing to sort; v[lo] may be past the end)\n");
        buf_str(out, c"                } else if cap < len + 16 {\n");
        buf_str(out, c"                    insertion_sort_raw(&v[lo], len, 1, f);\n");
        buf_str(out, c"                } else if size_of(T) <= 8 {\n");
        buf_str(out, c"                    small_sort_network_raw(&v[lo], len, sp, f);\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    small_sort_raw(&v[lo], len, sp, f);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                heapsort_raw(&v[lo], len, f);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if kept == 0 {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            kept -= 1;\n");
        buf_str(out, c"            lo = kept_lo[kept];\n");
        buf_str(out, c"            hi = kept_hi[kept];\n");
        buf_str(out, c"            limit = kept_limit[kept];\n");
        buf_str(out, c"            anc = kept_anc[kept];\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        limit -= 1;\n");
        buf_str(out, c"        let w: *T = &v[lo];\n");
        buf_str(out, c"        let p = choose_pivot_raw(w, len, f);\n");
        buf_str(out, c"        // A pivot no greater than the ancestor (which is no greater than\n");
        buf_str(out, c"        // anything here) equals it: the elements equal to it go left, in\n");
        buf_str(out, c"        // place, and only the greater ones are left to sort.\n");
        buf_str(out, c"        if anc && !f(*(&v[lo - 1]), *(&w[p])) {\n");
        buf_str(out, c"            let num_le = partition_raw(w, len, p, |a: T, b: T| !f(b, a));\n");
        buf_str(out, c"            lo += num_le + 1;\n");
        buf_str(out, c"            anc = false;\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let num_lt = partition_raw(w, len, p, f);\n");
        buf_str(out, c"        let mid = lo + num_lt;\n");
        buf_str(out, c"        if kept == 64 {\n");
        buf_str(out, c"            // (not reached: see above)\n");
        buf_str(out, c"            heapsort_raw(w, len, f);\n");
        buf_str(out, c"            hi = lo;\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // [lo, mid) keeps the ancestor; [mid + 1, hi) has v[mid]\n");
        buf_str(out, c"        kept_limit[kept] = limit;\n");
        buf_str(out, c"        if mid - lo < hi - mid - 1 {\n");
        buf_str(out, c"            kept_lo[kept] = mid + 1;\n");
        buf_str(out, c"            kept_hi[kept] = hi;\n");
        buf_str(out, c"            kept_anc[kept] = true;\n");
        buf_str(out, c"            hi = mid;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            kept_lo[kept] = lo;\n");
        buf_str(out, c"            kept_hi[kept] = mid;\n");
        buf_str(out, c"            kept_anc[kept] = anc;\n");
        buf_str(out, c"            lo = mid + 1;\n");
        buf_str(out, c"            anc = true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        kept += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Partitions v[0..len] around v[p] (len >= 1): the elements for which\n");
        buf_str(out, c"// is_less(x, pv) first, then the pivot, then the others. Returns the\n");
        buf_str(out, c"// pivot's new index, the number of the first kind.\n");
        buf_str(out, c"unsafe fn partition_raw<T,\n");
        buf_str(out, c"    F: FnMut(let T, let T) -> bool>(v: *T, len: i64, p: i64, is_less: F) -> i64 {\n");
        buf_str(out, c"    let t = v[0];\n");
        buf_str(out, c"    v[0] = v[p];\n");
        buf_str(out, c"    v[p] = t;\n");
        buf_str(out, c"    let pivot = v[0];\n");
        buf_str(out, c"    let num_lt = lomuto_cyclic_raw(&v[1], len - 1, &pivot, is_less);\n");
        buf_str(out, c"    // (a copy of the element at v[0]: not dropped here)\n");
        buf_str(out, c"    forget(pivot);\n");
        buf_str(out, c"    let u = v[0];\n");
        buf_str(out, c"    v[0] = v[num_lt];\n");
        buf_str(out, c"    v[num_lt] = u;\n");
        buf_str(out, c"    num_lt\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The branchless cyclic Lomuto partition of v[0..len] around *pivot\n");
        buf_str(out, c"// (ipnsort's): v[0] is lifted out, leaving a gap; each step moves the\n");
        buf_str(out, c"// element at the boundary into the gap and the next element onto the\n");
        buf_str(out, c"// boundary, which advances when that element is less than the pivot.\n");
        buf_str(out, c"// No branch depends on the comparison. Returns how many are less.\n");
        buf_str(out, c"// (num_lt <= gap < right < len throughout; not inlined: the loop gets\n");
        buf_str(out, c"// the registers to itself)\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"unsafe fn lomuto_cyclic_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, pivot_at: *T,\n");
        buf_str(out, c"    is_less: F) -> i64 {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    if len == 0 {\n");
        buf_str(out, c"        return 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // (a local copy: the stores below cannot change it, so it stays in a\n");
        buf_str(out, c"    // register)\n");
        buf_str(out, c"    let pv = *pivot_at;\n");
        buf_str(out, c"    let lifted = v[0];\n");
        buf_str(out, c"    // The gap is always just before `right` (v[0] at first).\n");
        buf_str(out, c"    var num_lt = 0;\n");
        buf_str(out, c"    var right = 1;\n");
        buf_str(out, c"    // Four steps a round, through a pointer to the first (its loads and\n");
        buf_str(out, c"    // stores at fixed offsets), then the rest.\n");
        buf_str(out, c"    for _ in 0..(len - 1) / 4 {\n");
        buf_str(out, c"        let src: *T = &v[right];\n");
        buf_str(out, c"        let x0 = src[0];\n");
        buf_str(out, c"        let l0 = f(x0, pv);\n");
        buf_str(out, c"        let at0 = num_lt;\n");
        buf_str(out, c"        num_lt += l0 as i64;\n");
        buf_str(out, c"        src[-1] = v[at0];\n");
        buf_str(out, c"        v[at0] = x0;\n");
        buf_str(out, c"        let x1 = src[1];\n");
        buf_str(out, c"        let l1 = f(x1, pv);\n");
        buf_str(out, c"        let at1 = num_lt;\n");
        buf_str(out, c"        num_lt += l1 as i64;\n");
        buf_str(out, c"        src[0] = v[at1];\n");
        buf_str(out, c"        v[at1] = x1;\n");
        buf_str(out, c"        let x2 = src[2];\n");
        buf_str(out, c"        let l2 = f(x2, pv);\n");
        buf_str(out, c"        let at2 = num_lt;\n");
        buf_str(out, c"        num_lt += l2 as i64;\n");
        buf_str(out, c"        src[1] = v[at2];\n");
        buf_str(out, c"        v[at2] = x2;\n");
        buf_str(out, c"        let x3 = src[3];\n");
        buf_str(out, c"        let l3 = f(x3, pv);\n");
        buf_str(out, c"        let at3 = num_lt;\n");
        buf_str(out, c"        num_lt += l3 as i64;\n");
        buf_str(out, c"        src[2] = v[at3];\n");
        buf_str(out, c"        v[at3] = x3;\n");
        buf_str(out, c"        right += 4;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for _ in right..len {\n");
        buf_str(out, c"        let x = v[right];\n");
        buf_str(out, c"        let lt = f(x, pv);\n");
        buf_str(out, c"        let at = num_lt;\n");
        buf_str(out, c"        num_lt += lt as i64;\n");
        buf_str(out, c"        v[right - 1] = v[at];\n");
        buf_str(out, c"        v[at] = x;\n");
        buf_str(out, c"        right += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // The lifted element closes the gap, v[len - 1].\n");
        buf_str(out, c"    let lt = f(lifted, pv);\n");
        buf_str(out, c"    v[len - 1] = v[num_lt];\n");
        buf_str(out, c"    v[num_lt] = lifted;\n");
        buf_str(out, c"    // (pv copies the pivot, which stays where it is: not dropped here)\n");
        buf_str(out, c"    forget(pv);\n");
        buf_str(out, c"    num_lt + lt as i64\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Reorders s so that s[k] is the element a sort would put there, those\n");
        buf_str(out, c"// before it no greater and those after no less (k < s.len, checked). Not\n");
        buf_str(out, c"// stable. Rust's `select_nth_unstable`.\n");
        buf_str(out, c"pub fn select_nth_unstable<T: Ord>(s: inout [T], k: i64) {\n");
        buf_str(out, c"    select_nth_unstable_less(s, k, |a: T, b: T| a < b);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// select_nth_unstable by f, a comparator returning a sign (sort_by's).\n");
        buf_str(out, c"pub fn select_nth_unstable_by<T, F: FnMut(let T, let T) -> i64>(s: inout [T], k: i64, f: F) {\n");
        buf_str(out, c"    var g = f;\n");
        buf_str(out, c"    select_nth_unstable_less(s, k, |a: T, b: T| g(a, b) < 0);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// select_nth_unstable on the key f gives each element.\n");
        buf_str(out, c"pub fn select_nth_unstable_by_key<T, K: Ord, F: FnMut(let T) -> K>(s: inout [T], k: i64, f: F) {\n");
        buf_str(out, c"    var g = f;\n");
        buf_str(out, c"    select_nth_unstable_less(s, k, |a: T, b: T| g(a) < g(b));\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// select_nth_unstable by is_less: introselect, Rust's (the unstable sort's\n");
        buf_str(out, c"// pivots and partition on the side holding k, insertion sort from 16\n");
        buf_str(out, c"// elements down); after 16 poor pivots, the unstable sort of what is left\n");
        buf_str(out, c"// (O(n log n) at worst, where Rust's median of medians is O(n)).\n");
        buf_str(out, c"pub fn select_nth_unstable_less<T,\n");
        buf_str(out, c"    F: FnMut(let T, let T) -> bool>(s: inout [T], k: i64, is_less: F) {\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    // (the check: s[k] panics unless 0 <= k < n)\n");
        buf_str(out, c"    let _ = &s[k];\n");
        buf_str(out, c"    // (s.ptr and s.len are one slice's, k < n)\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        select_raw(s.ptr, n, k, is_less);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"unsafe fn select_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, k: i64, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    if k == 0 || k == n - 1 {\n");
        buf_str(out, c"        // The least (or greatest) to its end, in one pass.\n");
        buf_str(out, c"        var at = 0;\n");
        buf_str(out, c"        for i in 1..n {\n");
        buf_str(out, c"            let better = if k == 0 { f(*(&v[i]), *(&v[at])) } else { !f(*(&v[i]), *(&v[at])) };\n");
        buf_str(out, c"            at = if better { i } else { at };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let t = v[at];\n");
        buf_str(out, c"        v[at] = v[k];\n");
        buf_str(out, c"        v[k] = t;\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var lo = 0;\n");
        buf_str(out, c"    var hi = n;\n");
        buf_str(out, c"    var limit = 16;\n");
        buf_str(out, c"    var anc = false;\n");
        buf_str(out, c"    // (each round shrinks the range by its pivot at least)\n");
        buf_str(out, c"    for _ in 0..n + 1 {\n");
        buf_str(out, c"        let len = hi - lo;\n");
        buf_str(out, c"        if len <= 16 {\n");
        buf_str(out, c"            if len >= 2 {\n");
        buf_str(out, c"                insertion_sort_raw(&v[lo], len, 1, f);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if limit == 0 {\n");
        buf_str(out, c"            ipnsort_raw(&v[lo], len, f);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        limit -= 1;\n");
        buf_str(out, c"        let w: *T = &v[lo];\n");
        buf_str(out, c"        let p = choose_pivot_raw(w, len, f);\n");
        buf_str(out, c"        if anc && !f(*(&v[lo - 1]), *(&w[p])) {\n");
        buf_str(out, c"            // all of w[0..=num_le] equal the pivot\n");
        buf_str(out, c"            let num_le = partition_raw(w, len, p, |a: T, b: T| !f(b, a));\n");
        buf_str(out, c"            if lo + num_le >= k {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            lo += num_le + 1;\n");
        buf_str(out, c"            anc = false;\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let mid = lo + partition_raw(w, len, p, f);\n");
        buf_str(out, c"        if mid < k {\n");
        buf_str(out, c"            lo = mid + 1;\n");
        buf_str(out, c"            anc = true;\n");
        buf_str(out, c"        } else if mid > k {\n");
        buf_str(out, c"            hi = mid;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::slice::unstable ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::slice::stable ----\n");
        buf_str(out, c"mod stable {\n");
        buf_str(out, c"// std::slice::stable: the stable sort, driftsort (0.20).\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Ord, forget, memcpy, needs_drop};\n");
        buf_str(out, c"use std::num::leading_zeros;\n");
        buf_str(out, c"use super::{\n");
        buf_str(out, c"    SortStackBuf, choose_pivot_raw, existing_run_raw, insertion_sort_raw, reverse_raw, rotate_raw,\n");
        buf_str(out, c"    small_sort_raw, sort_stack_cap,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Sort, stable (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The stable sort (0.20; docs/design/collections-text-io.md §2.4.6), after\n");
        buf_str(out, c"// Rust's driftsort: the slice is cut into runs, which are merged in\n");
        buf_str(out, c"// powersort's order (the depth of each boundary in the merge tree of the\n");
        buf_str(out, c"// run midpoints). A run is a natural one when the input has one of\n");
        buf_str(out, c"// sqrt(n) elements or more there (ascending, or strictly descending and\n");
        buf_str(out, c"// reversed); elsewhere a run of sqrt(n) elements is left unsorted, and\n");
        buf_str(out, c"// two neighbouring unsorted runs merge by just becoming one, as long as\n");
        buf_str(out, c"// it fits in the scratch. An unsorted run is sorted when it must be\n");
        buf_str(out, c"// merged with a sorted one, or at the end, by a stable quicksort: a\n");
        buf_str(out, c"// branchless partition through the scratch, the elements equal to the\n");
        buf_str(out, c"// pivot put in place at once when it is the least (O(n log k) for k\n");
        buf_str(out, c"// distinct values), the small sort (Sort kernels) up to 32 elements, and\n");
        buf_str(out, c"// the merge sort below a depth of 2·log2(n). A merge copies its shorter\n");
        buf_str(out, c"// side into the scratch and merges with no branch on the comparisons.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Scratch: `sort_stable_scratch_len(n)` elements (n up to 8 MB, then\n");
        buf_str(out, c"// n / 2) give the full speed; with less (the 4 KB of the slice form), a\n");
        buf_str(out, c"// merge whose shorter side does not fit is split by binary searches and\n");
        buf_str(out, c"// rotations until its pieces do, in place (O(n log² n) at worst), and\n");
        buf_str(out, c"// only runs that fit are sorted by quicksort.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Unsafe code: as the unstable sort's (Sort, unstable). The scratch is\n");
        buf_str(out, c"// slots of T that are written before they are read; it never overlaps\n");
        buf_str(out, c"// the slice, and holds bit copies only (bytes, or an allocator's block\n");
        buf_str(out, c"// whose Vec keeps length 0): nothing in it is ever dropped, and every\n");
        buf_str(out, c"// element ends up in the slice exactly once, whatever the comparator\n");
        buf_str(out, c"// answers (a merge that finds no total order copies the scratch back).\n");
        buf_str(out, c"// Elements of a type with a drop keep no ancestor copies\n");
        buf_str(out, c"// (stable_quicksort_plain_raw). Nothing recurses: the merge sort the quicksort falls back\n");
        buf_str(out, c"// on is a separate function (drift_eager_raw) that never sorts by\n");
        buf_str(out, c"// quicksort.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place, smallest first, keeping equal elements in the order\n");
        buf_str(out, c"// they had, with no allocation: the scratch is 4 KB on the stack, and\n");
        buf_str(out, c"// larger merges are done in place (slower: `sort_stable_in` takes an\n");
        buf_str(out, c"// allocator for the scratch).\n");
        buf_str(out, c"pub fn sort_stable_noalloc<T: Ord>(s: inout [T]) {\n");
        buf_str(out, c"    sort_stable_less(s, |a: T, b: T| a < b);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s stably by is_less (`is_less(a, b)`: *a goes strictly before\n");
        buf_str(out, c"// *b) with a 4 KB scratch on the stack (`sort_stable_noalloc`).\n");
        buf_str(out, c"pub fn sort_stable_less<T, F: FnMut(let T, let T) -> bool>(s: inout [T], is_less: F) {\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    if n < 2 || size_of(T) == 0 {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var buf: SortStackBuf = SortStackBuf { words: [0; 512] };\n");
        buf_str(out, c"    let cap = sort_stack_cap::<T>();\n");
        buf_str(out, c"    // (s.ptr and s.len are one slice's; the buffer has cap slots and is\n");
        buf_str(out, c"    // not s)\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        sort_stable_raw(s.ptr, n, &buf as *T, cap, is_less);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s stably by is_less, with scratch[0..scratch_len]\n");
        buf_str(out, c"// (`sort_stable_scratch_len(s.len)` for the full speed; any length\n");
        buf_str(out, c"// works). The caller promises that scratch points to scratch_len slots\n");
        buf_str(out, c"// of T it owns, outside s; their contents are overwritten.\n");
        buf_str(out, c"pub unsafe fn sort_stable_less_with<T, F: FnMut(let T, let T) -> bool>(s: inout [T], scratch: *T,\n");
        buf_str(out, c"    scratch_len: i64, is_less: F) {\n");
        buf_str(out, c"    if s.len < 2 || size_of(T) == 0 {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    sort_stable_raw(s.ptr, s.len, scratch, scratch_len, is_less);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The scratch the stable sort wants for n elements of T: all n up to\n");
        buf_str(out, c"// 8 MB, n / 2 beyond (driftsort's), and at least 48 (the small sort's).\n");
        buf_str(out, c"pub fn sort_stable_scratch_len<T>(n: i64) -> i64 {\n");
        buf_str(out, c"    let full = if size_of(T) == 0 { n } else { 8000000 / size_of(T) };\n");
        buf_str(out, c"    var len = n - n / 2;\n");
        buf_str(out, c"    if len < n && n <= full {\n");
        buf_str(out, c"        len = n;\n");
        buf_str(out, c"    } else if len < full && full < n {\n");
        buf_str(out, c"        len = full;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if len < 48 { 48 } else { len }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// v[0..n] (n >= 2), scratch[0..cap].\n");
        buf_str(out, c"unsafe fn sort_stable_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, scratch: *T, cap: i64,\n");
        buf_str(out, c"    is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    if n <= 20 {\n");
        buf_str(out, c"        insertion_sort_raw(v, n, 1, f);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // Short slices: a small sort or two and a merge beat the quicksort.\n");
        buf_str(out, c"    if n <= 64 {\n");
        buf_str(out, c"        drift_eager_raw(v, n, scratch, cap, f);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    drift_lazy_raw(v, n, scratch, cap, f);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The runs of 32 the merge sort makes where the input has none.\n");
        buf_str(out, c"const SORT_STABLE_RUN: i64 = 32;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// sqrt(n) roughly: 2^((1 + floor(log2 n)) / 2), then a Newton step.\n");
        buf_str(out, c"fn sort_sqrt_approx(n: i64) -> i64 {\n");
        buf_str(out, c"    var lg = 0;\n");
        buf_str(out, c"    for k in 1..63 {\n");
        buf_str(out, c"        if ((n | 1) >> k) == 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        lg += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let shift = (1 + lg) / 2;\n");
        buf_str(out, c"    ((1 << shift) + (n >> shift)) / 2\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The natural runs a merge takes as they are: sqrt(n) long at least\n");
        buf_str(out, c"// (from 4096 elements; below, 64 or half the slice).\n");
        buf_str(out, c"fn sort_min_good_run(n: i64) -> i64 {\n");
        buf_str(out, c"    if n <= 64 * 64 {\n");
        buf_str(out, c"        if n - n / 2 < 64 { n - n / 2 } else { 64 }\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        sort_sqrt_approx(n)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The depth in the merge tree of the boundary between the runs\n");
        buf_str(out, c"// [left, mid) and [mid, right) (powersort's node power, with scale =\n");
        buf_str(out, c"// 2^62 / n rounded up).\n");
        buf_str(out, c"fn sort_merge_depth(left: i64, mid: i64, right: i64, scale: u64) -> i64 {\n");
        buf_str(out, c"    let x = (left + mid) as u64;\n");
        buf_str(out, c"    let y = (mid + right) as u64;\n");
        buf_str(out, c"    leading_zeros((scale * x) ^ (scale * y))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Driftsort with lazy runs, v[0..n] (n >= 2): unsorted runs of sqrt(n)\n");
        buf_str(out, c"// are sorted by the stable quicksort when they meet a sorted one or\n");
        buf_str(out, c"// grow past the scratch.\n");
        buf_str(out, c"unsafe fn drift_lazy_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, scratch: *T, cap: i64,\n");
        buf_str(out, c"    is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    let scale = ((1u64 << 62) + n as u64 - 1u64) / n as u64;\n");
        buf_str(out, c"    let min_good = sort_min_good_run(n);\n");
        buf_str(out, c"    // The stack of runs below the previous one; boundary depths increase\n");
        buf_str(out, c"    // up it (below 64), so it holds 65 runs at most and a first, empty\n");
        buf_str(out, c"    // one.\n");
        buf_str(out, c"    var run_len: [i64; 66] = [0; 66];\n");
        buf_str(out, c"    var run_sorted: [bool; 66] = [false; 66];\n");
        buf_str(out, c"    var run_depth: [i64; 66] = [0; 66];\n");
        buf_str(out, c"    var kept = 0;\n");
        buf_str(out, c"    var prev_len = 0;\n");
        buf_str(out, c"    var prev_sorted = true;\n");
        buf_str(out, c"    var scan = 0;\n");
        buf_str(out, c"    // (each round takes a run of at least 1: n + 1 rounds at most)\n");
        buf_str(out, c"    for _ in 0..n + 2 {\n");
        buf_str(out, c"        var next_len = 0;\n");
        buf_str(out, c"        var next_sorted = true;\n");
        buf_str(out, c"        var depth = 0;\n");
        buf_str(out, c"        if scan < n {\n");
        buf_str(out, c"            // A natural run long enough, else an unsorted one.\n");
        buf_str(out, c"            let rest = n - scan;\n");
        buf_str(out, c"            next_len = if rest < min_good { rest } else { min_good };\n");
        buf_str(out, c"            next_sorted = false;\n");
        buf_str(out, c"            if rest >= min_good {\n");
        buf_str(out, c"                let (run, desc) = existing_run_raw(&v[scan], rest, f);\n");
        buf_str(out, c"                if run >= min_good {\n");
        buf_str(out, c"                    if desc {\n");
        buf_str(out, c"                        reverse_raw(&v[scan], run);\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    next_len = run;\n");
        buf_str(out, c"                    next_sorted = true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            depth = sort_merge_depth(scan - prev_len, scan, scan + next_len, scale);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for _ in 0..66 {\n");
        buf_str(out, c"            if kept <= 1 || run_depth[kept - 1] < depth {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let left = run_len[kept - 1];\n");
        buf_str(out, c"            let left_sorted = run_sorted[kept - 1];\n");
        buf_str(out, c"            let merged = left + prev_len;\n");
        buf_str(out, c"            let w: *T = &v[scan - merged];\n");
        buf_str(out, c"            // Two unsorted runs that fit in the scratch just join; else\n");
        buf_str(out, c"            // each is sorted and they are merged.\n");
        buf_str(out, c"            if merged > cap || left_sorted || prev_sorted {\n");
        buf_str(out, c"                if !left_sorted {\n");
        buf_str(out, c"                    stable_quicksort_raw(w, left, scratch, cap, f);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if !prev_sorted {\n");
        buf_str(out, c"                    stable_quicksort_raw(&w[left], prev_len, scratch, cap, f);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                merge_any_raw(w, merged, left, scratch, cap, f);\n");
        buf_str(out, c"                prev_sorted = true;\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                prev_sorted = false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            prev_len = merged;\n");
        buf_str(out, c"            kept -= 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if kept == 66 {\n");
        buf_str(out, c"            // (not reached: see above)\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        run_len[kept] = prev_len;\n");
        buf_str(out, c"        run_sorted[kept] = prev_sorted;\n");
        buf_str(out, c"        run_depth[kept] = depth;\n");
        buf_str(out, c"        kept += 1;\n");
        buf_str(out, c"        if scan >= n {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        scan += next_len;\n");
        buf_str(out, c"        prev_len = next_len;\n");
        buf_str(out, c"        prev_sorted = next_sorted;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if !prev_sorted {\n");
        buf_str(out, c"        stable_quicksort_raw(v, n, scratch, cap, f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Driftsort with eager runs (no quicksort): v[0..n] (n >= 2), every run\n");
        buf_str(out, c"// sorted when it is made, then merged. The stable quicksort's fallback.\n");
        buf_str(out, c"unsafe fn drift_eager_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, scratch: *T, cap: i64,\n");
        buf_str(out, c"    is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    let scale = ((1u64 << 62) + n as u64 - 1u64) / n as u64;\n");
        buf_str(out, c"    let min_good = sort_min_good_run(n);\n");
        buf_str(out, c"    var run_len: [i64; 66] = [0; 66];\n");
        buf_str(out, c"    var run_depth: [i64; 66] = [0; 66];\n");
        buf_str(out, c"    var kept = 0;\n");
        buf_str(out, c"    var prev_len = 0;\n");
        buf_str(out, c"    var scan = 0;\n");
        buf_str(out, c"    for _ in 0..n + 2 {\n");
        buf_str(out, c"        var next_len = 0;\n");
        buf_str(out, c"        var depth = 0;\n");
        buf_str(out, c"        if scan < n {\n");
        buf_str(out, c"            next_len = eager_run_raw(&v[scan], n - scan, min_good, scratch, cap, f);\n");
        buf_str(out, c"            depth = sort_merge_depth(scan - prev_len, scan, scan + next_len, scale);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for _ in 0..66 {\n");
        buf_str(out, c"            if kept <= 1 || run_depth[kept - 1] < depth {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let left = run_len[kept - 1];\n");
        buf_str(out, c"            let merged = left + prev_len;\n");
        buf_str(out, c"            merge_any_raw(&v[scan - merged], merged, left, scratch, cap, f);\n");
        buf_str(out, c"            prev_len = merged;\n");
        buf_str(out, c"            kept -= 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if kept == 66 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        run_len[kept] = prev_len;\n");
        buf_str(out, c"        run_depth[kept] = depth;\n");
        buf_str(out, c"        kept += 1;\n");
        buf_str(out, c"        if scan >= n {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        scan += next_len;\n");
        buf_str(out, c"        prev_len = next_len;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Makes a sorted run at the start of v[0..n] (n >= 1) and returns its\n");
        buf_str(out, c"// length: the natural run there when it has min_good elements or more,\n");
        buf_str(out, c"// else the first SORT_STABLE_RUN (or n) sorted by the small sort.\n");
        buf_str(out, c"unsafe fn eager_run_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, min_good: i64,\n");
        buf_str(out, c"    scratch: *T, cap: i64, is_less: F) -> i64 {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    if n >= min_good && n >= 2 {\n");
        buf_str(out, c"        let (run, desc) = existing_run_raw(v, n, f);\n");
        buf_str(out, c"        if run >= min_good {\n");
        buf_str(out, c"            if desc {\n");
        buf_str(out, c"                reverse_raw(v, run);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return run;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let len = if n < SORT_STABLE_RUN { n } else { SORT_STABLE_RUN };\n");
        buf_str(out, c"    stable_small_sort_raw(v, len, scratch, cap, f);\n");
        buf_str(out, c"    len\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts v[0..len] (len <= 32) stably: the small sort when the scratch has\n");
        buf_str(out, c"// its len + 16 slots, else insertion sort.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn stable_small_sort_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, scratch: *T,\n");
        buf_str(out, c"    cap: i64, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    if len < 2 {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if cap >= len + 16 {\n");
        buf_str(out, c"        small_sort_raw(v, len, scratch, f);\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        insertion_sort_raw(v, len, 1, f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The stable quicksort of v[0..n] (n <= cap). The left side of each\n");
        buf_str(out, c"// partition is sorted next and the right side kept; every partition\n");
        buf_str(out, c"// lowers the depth left (2·log2(n) <= 126), so at most 126 are kept.\n");
        buf_str(out, c"// A range's ancestor is the pivot of the partition that made it its\n");
        buf_str(out, c"// right side (a copy: the partition moves elements); when a new pivot is\n");
        buf_str(out, c"// no greater than it, the pivot equals the least elements, which go left\n");
        buf_str(out, c"// in place, and only the greater ones are left to sort (also when nothing\n");
        buf_str(out, c"// is less than the pivot). Elements over 128 bytes keep no copies: only\n");
        buf_str(out, c"// the second way applies.\n");
        buf_str(out, c"unsafe fn stable_quicksort_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, scratch: *T,\n");
        buf_str(out, c"    cap: i64, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    if size_of(T) > 128 || needs_drop::<T>() {\n");
        buf_str(out, c"        stable_quicksort_plain_raw(v, n, scratch, cap, f);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var kept_lo: [i64; 128] = [0; 128];\n");
        buf_str(out, c"    var kept_hi: [i64; 128] = [0; 128];\n");
        buf_str(out, c"    var kept_limit: [i64; 128] = [0; 128];\n");
        buf_str(out, c"    var kept_has_anc: [bool; 128] = [false; 128];\n");
        buf_str(out, c"    var kept_anc: [T; 128] = [v[0]; 128];\n");
        buf_str(out, c"    var kept = 0;\n");
        buf_str(out, c"    var limit = 0;\n");
        buf_str(out, c"    for k in 1..63 {\n");
        buf_str(out, c"        if ((n | 1) >> k) == 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        limit += 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var lo = 0;\n");
        buf_str(out, c"    var hi = n;\n");
        buf_str(out, c"    var anc = v[0];\n");
        buf_str(out, c"    var has_anc = false;\n");
        buf_str(out, c"    // (each round finishes a range, or partitions one into two shorter\n");
        buf_str(out, c"    // ones or puts some of it in place: 2n + 2 rounds at most)\n");
        buf_str(out, c"    for _ in 0..2 * n + 2 {\n");
        buf_str(out, c"        let len = hi - lo;\n");
        buf_str(out, c"        if len <= SORT_STABLE_RUN || limit == 0 || len > cap || kept == 128 {\n");
        buf_str(out, c"            if len <= SORT_STABLE_RUN {\n");
        buf_str(out, c"                if len >= 2 {\n");
        buf_str(out, c"                    stable_small_sort_raw(&v[lo], len, scratch, cap, f);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                drift_eager_raw(&v[lo], len, scratch, cap, f);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if kept == 0 {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            kept -= 1;\n");
        buf_str(out, c"            lo = kept_lo[kept];\n");
        buf_str(out, c"            hi = kept_hi[kept];\n");
        buf_str(out, c"            limit = kept_limit[kept];\n");
        buf_str(out, c"            has_anc = kept_has_anc[kept];\n");
        buf_str(out, c"            anc = kept_anc[kept];\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        limit -= 1;\n");
        buf_str(out, c"        let w: *T = &v[lo];\n");
        buf_str(out, c"        let p = choose_pivot_raw(w, len, f);\n");
        buf_str(out, c"        let pv = w[p];\n");
        buf_str(out, c"        var num_lt = 0;\n");
        buf_str(out, c"        let equal = has_anc && !f(anc, pv);\n");
        buf_str(out, c"        if !equal {\n");
        buf_str(out, c"            num_lt = stable_partition_raw(w, len, scratch, p, false, f);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if equal || num_lt == 0 {\n");
        buf_str(out, c"            // (nothing moved when num_lt == 0: v[p] is still the pivot)\n");
        buf_str(out, c"            let num_le = stable_partition_raw(w, len, scratch, p, true, |a: T, b: T| !f(b, a));\n");
        buf_str(out, c"            lo += num_le;\n");
        buf_str(out, c"            has_anc = false;\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        kept_lo[kept] = lo + num_lt;\n");
        buf_str(out, c"        kept_hi[kept] = hi;\n");
        buf_str(out, c"        kept_limit[kept] = limit;\n");
        buf_str(out, c"        kept_has_anc[kept] = true;\n");
        buf_str(out, c"        kept_anc[kept] = pv;\n");
        buf_str(out, c"        kept += 1;\n");
        buf_str(out, c"        hi = lo + num_lt;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The stable quicksort without ancestor copies (elements over 128 bytes).\n");
        buf_str(out, c"unsafe fn stable_quicksort_plain_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, scratch: *T,\n");
        buf_str(out, c"    cap: i64, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    var kept_lo: [i64; 128] = [0; 128];\n");
        buf_str(out, c"    var kept_hi: [i64; 128] = [0; 128];\n");
        buf_str(out, c"    var kept_limit: [i64; 128] = [0; 128];\n");
        buf_str(out, c"    var kept = 0;\n");
        buf_str(out, c"    var limit = 0;\n");
        buf_str(out, c"    for k in 1..63 {\n");
        buf_str(out, c"        if ((n | 1) >> k) == 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        limit += 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var lo = 0;\n");
        buf_str(out, c"    var hi = n;\n");
        buf_str(out, c"    for _ in 0..2 * n + 2 {\n");
        buf_str(out, c"        let len = hi - lo;\n");
        buf_str(out, c"        if len <= SORT_STABLE_RUN || limit == 0 || len > cap || kept == 128 {\n");
        buf_str(out, c"            if len <= SORT_STABLE_RUN {\n");
        buf_str(out, c"                if len >= 2 {\n");
        buf_str(out, c"                    stable_small_sort_raw(&v[lo], len, scratch, cap, f);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                drift_eager_raw(&v[lo], len, scratch, cap, f);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if kept == 0 {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            kept -= 1;\n");
        buf_str(out, c"            lo = kept_lo[kept];\n");
        buf_str(out, c"            hi = kept_hi[kept];\n");
        buf_str(out, c"            limit = kept_limit[kept];\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        limit -= 1;\n");
        buf_str(out, c"        let w: *T = &v[lo];\n");
        buf_str(out, c"        let p = choose_pivot_raw(w, len, f);\n");
        buf_str(out, c"        let num_lt = stable_partition_raw(w, len, scratch, p, false, f);\n");
        buf_str(out, c"        if num_lt == 0 {\n");
        buf_str(out, c"            let num_le = stable_partition_raw(w, len, scratch, p, true, |a: T, b: T| !f(b, a));\n");
        buf_str(out, c"            lo += num_le;\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        kept_lo[kept] = lo + num_lt;\n");
        buf_str(out, c"        kept_hi[kept] = hi;\n");
        buf_str(out, c"        kept_limit[kept] = limit;\n");
        buf_str(out, c"        kept += 1;\n");
        buf_str(out, c"        hi = lo + num_lt;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Partitions v[0..len] stably around the pivot v[p] (len <= the scratch's\n");
        buf_str(out, c"// length): the elements x with is_less(x, pv) first, then the others,\n");
        buf_str(out, c"// each side in its old order; the pivot itself goes left when\n");
        buf_str(out, c"// pivot_goes_left. Returns how many went left. Each element is copied\n");
        buf_str(out, c"// into the scratch, to the front for the left side and to the back\n");
        buf_str(out, c"// (reversed) for the right, with no branch on the comparison, then both\n");
        buf_str(out, c"// are copied back. (at step i: left slots num_left <= i, right slots\n");
        buf_str(out, c"// len - 1 - (i - num_left) <= len - 1)\n");
        buf_str(out, c"unsafe fn stable_partition_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, scratch: *T,\n");
        buf_str(out, c"    p: i64, pivot_goes_left: bool, is_less: F) -> i64 {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    let pv = v[p];\n");
        buf_str(out, c"    // (the right side's base: element i goes to rev[num_left], rev being\n");
        buf_str(out, c"    // &scratch[len - 1 - i])\n");
        buf_str(out, c"    let rev: *T = &scratch[len - 1];\n");
        buf_str(out, c"    var num_left = stable_partition_scan_raw(v, 0, p, scratch, rev, 0, &pv, f);\n");
        buf_str(out, c"    let pivot_at = if pivot_goes_left { num_left } else { len - 1 - p + num_left };\n");
        buf_str(out, c"    num_left += pivot_goes_left as i64;\n");
        buf_str(out, c"    num_left = stable_partition_scan_raw(v, p + 1, len, scratch, &rev[-(p + 1)], num_left, &pv, f);\n");
        buf_str(out, c"    // (the pivot last: the scans compared with it)\n");
        buf_str(out, c"    scratch[pivot_at] = pv;\n");
        buf_str(out, c"    copy_raw(v, scratch, num_left);\n");
        buf_str(out, c"    for i in 0..len - num_left {\n");
        buf_str(out, c"        v[num_left + i] = scratch[len - 1 - i];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    num_left\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// stable_partition_raw's scan of v[from..to], with rev the right side's\n");
        buf_str(out, c"// base for element `from` and num_left so far; returns num_left after.\n");
        buf_str(out, c"// Four steps a round, then the rest.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn stable_partition_scan_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, from: i64, to: i64,\n");
        buf_str(out, c"    scratch: *T, rev0: *T, num_left0: i64, pivot_at: *T, is_less: F) -> i64 {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    let pv = *pivot_at;\n");
        buf_str(out, c"    var rev = rev0;\n");
        buf_str(out, c"    var num_left = num_left0;\n");
        buf_str(out, c"    var i = from;\n");
        buf_str(out, c"    for _ in 0..(to - from) / 4 {\n");
        buf_str(out, c"        let src: *T = &v[i];\n");
        buf_str(out, c"        let x0 = src[0];\n");
        buf_str(out, c"        let l0 = f(x0, pv);\n");
        buf_str(out, c"        let b0 = if l0 { scratch } else { rev };\n");
        buf_str(out, c"        let at = num_left;\n");
        buf_str(out, c"        num_left += l0 as i64;\n");
        buf_str(out, c"        b0[at] = x0;\n");
        buf_str(out, c"        let x1 = src[1];\n");
        buf_str(out, c"        let l1 = f(x1, pv);\n");
        buf_str(out, c"        let b1 = if l1 { scratch } else { &rev[-1] };\n");
        buf_str(out, c"        let at = num_left;\n");
        buf_str(out, c"        num_left += l1 as i64;\n");
        buf_str(out, c"        b1[at] = x1;\n");
        buf_str(out, c"        let x2 = src[2];\n");
        buf_str(out, c"        let l2 = f(x2, pv);\n");
        buf_str(out, c"        let b2 = if l2 { scratch } else { &rev[-2] };\n");
        buf_str(out, c"        let at = num_left;\n");
        buf_str(out, c"        num_left += l2 as i64;\n");
        buf_str(out, c"        b2[at] = x2;\n");
        buf_str(out, c"        let x3 = src[3];\n");
        buf_str(out, c"        let l3 = f(x3, pv);\n");
        buf_str(out, c"        let b3 = if l3 { scratch } else { &rev[-3] };\n");
        buf_str(out, c"        let at = num_left;\n");
        buf_str(out, c"        num_left += l3 as i64;\n");
        buf_str(out, c"        b3[at] = x3;\n");
        buf_str(out, c"        rev = &rev[-4];\n");
        buf_str(out, c"        i += 4;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for _ in i..to {\n");
        buf_str(out, c"        let x = v[i];\n");
        buf_str(out, c"        let l = f(x, pv);\n");
        buf_str(out, c"        let b = if l { scratch } else { rev };\n");
        buf_str(out, c"        let at = num_left;\n");
        buf_str(out, c"        num_left += l as i64;\n");
        buf_str(out, c"        b[at] = x;\n");
        buf_str(out, c"        rev = &rev[-1];\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // (a copy of the pivot, which stays where it is: not dropped here)\n");
        buf_str(out, c"    forget(pv);\n");
        buf_str(out, c"    num_left\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Merges the sorted v[0..mid] and v[mid..len], stably: through the\n");
        buf_str(out, c"// scratch when the shorter side fits in it, else split in place (the\n");
        buf_str(out, c"// halves found by binary search, the middle rotated) into merges that\n");
        buf_str(out, c"// do, kept on a stack.\n");
        buf_str(out, c"unsafe fn merge_any_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, mid: i64, scratch: *T,\n");
        buf_str(out, c"    cap: i64, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    let shorter = if mid < len - mid { mid } else { len - mid };\n");
        buf_str(out, c"    if shorter <= cap {\n");
        buf_str(out, c"        merge_raw(v, len, mid, scratch, f);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // Pending merges (lo, mid, hi). A split leaves two merges of at most\n");
        buf_str(out, c"    // 5/6 of its elements each, so the splits nest at most\n");
        buf_str(out, c"    // log(6/5)(2^63) < 240 deep and fewer than 320 are pending at once.\n");
        buf_str(out, c"    var p_lo: [i64; 320] = [0; 320];\n");
        buf_str(out, c"    var p_mid: [i64; 320] = [0; 320];\n");
        buf_str(out, c"    var p_hi: [i64; 320] = [0; 320];\n");
        buf_str(out, c"    p_lo[0] = 0;\n");
        buf_str(out, c"    p_mid[0] = mid;\n");
        buf_str(out, c"    p_hi[0] = len;\n");
        buf_str(out, c"    var pending = 1;\n");
        buf_str(out, c"    // (each round finishes a merge or splits one: far fewer rounds than\n");
        buf_str(out, c"    // this bound)\n");
        buf_str(out, c"    for _ in 0..512 * (len + 1) {\n");
        buf_str(out, c"        if pending == 0 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        pending -= 1;\n");
        buf_str(out, c"        let lo = p_lo[pending];\n");
        buf_str(out, c"        let m = p_mid[pending];\n");
        buf_str(out, c"        let hi = p_hi[pending];\n");
        buf_str(out, c"        let l1 = m - lo;\n");
        buf_str(out, c"        let l2 = hi - m;\n");
        buf_str(out, c"        if l1 == 0 || l2 == 0 {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if l1 <= cap || l2 <= cap {\n");
        buf_str(out, c"            merge_raw(&v[lo], hi - lo, l1, scratch, f);\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if l1 + l2 == 2 {\n");
        buf_str(out, c"            // (no scratch at all)\n");
        buf_str(out, c"            if f(*(&v[m]), *(&v[lo])) {\n");
        buf_str(out, c"                let t = v[lo];\n");
        buf_str(out, c"                v[lo] = v[m];\n");
        buf_str(out, c"                v[m] = t;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if pending + 2 > 320 {\n");
        buf_str(out, c"            // (not reached: see above)\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // Cut the longer side in half; the other side's elements that go\n");
        buf_str(out, c"        // before the cut element are found by binary search.\n");
        buf_str(out, c"        var cut1 = 0;\n");
        buf_str(out, c"        var cut2 = 0;\n");
        buf_str(out, c"        if l1 >= l2 {\n");
        buf_str(out, c"            cut1 = lo + l1 / 2;\n");
        buf_str(out, c"            // the first in v[m..hi] not less than v[cut1]\n");
        buf_str(out, c"            cut2 = m + lower_bound_raw(&v[m], l2, &v[cut1], f);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            cut2 = m + l2 / 2;\n");
        buf_str(out, c"            // the first in v[lo..m] greater than v[cut2]\n");
        buf_str(out, c"            cut1 = lo + upper_bound_raw(&v[lo], l1, &v[cut2], f);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        rotate_raw(&v[cut1], cut2 - cut1, m - cut1);\n");
        buf_str(out, c"        let new_mid = cut1 + (cut2 - m);\n");
        buf_str(out, c"        p_lo[pending] = new_mid;\n");
        buf_str(out, c"        p_mid[pending] = cut2;\n");
        buf_str(out, c"        p_hi[pending] = hi;\n");
        buf_str(out, c"        p_lo[pending + 1] = lo;\n");
        buf_str(out, c"        p_mid[pending + 1] = cut1;\n");
        buf_str(out, c"        p_hi[pending + 1] = new_mid;\n");
        buf_str(out, c"        pending += 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The number of elements of the sorted v[0..n] that are less than *x.\n");
        buf_str(out, c"unsafe fn lower_bound_raw<T,\n");
        buf_str(out, c"    F: FnMut(let T, let T) -> bool>(v: *T, n: i64, x: *T, is_less: F) -> i64 {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    var lo = 0;\n");
        buf_str(out, c"    var size = n;\n");
        buf_str(out, c"    // (size halves each round)\n");
        buf_str(out, c"    for _ in 0..64 {\n");
        buf_str(out, c"        if size == 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let half = size / 2;\n");
        buf_str(out, c"        let mid = lo + half;\n");
        buf_str(out, c"        if f(*(&v[mid]), *x) {\n");
        buf_str(out, c"            lo = mid + 1;\n");
        buf_str(out, c"            size -= half + 1;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            size = half;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    lo\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The number of elements of the sorted v[0..n] that are not greater than\n");
        buf_str(out, c"// *x.\n");
        buf_str(out, c"unsafe fn upper_bound_raw<T,\n");
        buf_str(out, c"    F: FnMut(let T, let T) -> bool>(v: *T, n: i64, x: *T, is_less: F) -> i64 {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    var lo = 0;\n");
        buf_str(out, c"    var size = n;\n");
        buf_str(out, c"    for _ in 0..64 {\n");
        buf_str(out, c"        if size == 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let half = size / 2;\n");
        buf_str(out, c"        let mid = lo + half;\n");
        buf_str(out, c"        if !f(*x, *(&v[mid])) {\n");
        buf_str(out, c"            lo = mid + 1;\n");
        buf_str(out, c"            size -= half + 1;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            size = half;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    lo\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Merges the sorted v[0..mid] and v[mid..len] (both nonempty), stably,\n");
        buf_str(out, c"// with the shorter side copied into scratch (room for it): from the\n");
        buf_str(out, c"// front when the left side is the shorter, else from the back. No branch\n");
        buf_str(out, c"// on the comparisons; every index stays in its range whatever they\n");
        buf_str(out, c"// answer, and what is left of the scratch's side is copied back after.\n");
        buf_str(out, c"unsafe fn merge_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, mid: i64, scratch: *T,\n");
        buf_str(out, c"    is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    let right_len = len - mid;\n");
        buf_str(out, c"    if mid <= right_len {\n");
        buf_str(out, c"        copy_raw(scratch, v, mid);\n");
        buf_str(out, c"        // left in scratch[l..mid], right in v[r..len], out = l + r - mid\n");
        buf_str(out, c"        // < r: nothing unread is overwritten\n");
        buf_str(out, c"        var l = 0;\n");
        buf_str(out, c"        var r = mid;\n");
        buf_str(out, c"        var out = 0;\n");
        buf_str(out, c"        for _ in 0..len {\n");
        buf_str(out, c"            if l >= mid || r >= len {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let take_left = !f(*(&v[r]), *(&scratch[l]));\n");
        buf_str(out, c"            let p: *T = if take_left { &scratch[l] } else { &v[r] };\n");
        buf_str(out, c"            l += take_left as i64;\n");
        buf_str(out, c"            r += (!take_left) as i64;\n");
        buf_str(out, c"            v[out] = *p;\n");
        buf_str(out, c"            out += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if l < mid {\n");
        buf_str(out, c"            copy_raw(&v[out], &scratch[l], mid - l);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        copy_raw(scratch, &v[mid], right_len);\n");
        buf_str(out, c"        // left in v[0..l], right in scratch[0..r], written at l + r - 1\n");
        buf_str(out, c"        // >= l: nothing unread is overwritten\n");
        buf_str(out, c"        var l = mid;\n");
        buf_str(out, c"        var r = right_len;\n");
        buf_str(out, c"        for _ in 0..len {\n");
        buf_str(out, c"            if l <= 0 || r <= 0 {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let take_left = f(*(&scratch[r - 1]), *(&v[l - 1]));\n");
        buf_str(out, c"            let p: *T = if take_left { &v[l - 1] } else { &scratch[r - 1] };\n");
        buf_str(out, c"            let at = l + r - 1;\n");
        buf_str(out, c"            l -= take_left as i64;\n");
        buf_str(out, c"            r -= (!take_left) as i64;\n");
        buf_str(out, c"            v[at] = *p;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        copy_raw(&v[l], scratch, r);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// dst[0..n] = src[0..n] (not overlapping).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn copy_raw<T>(dst: *T, src: *T, n: i64) {\n");
        buf_str(out, c"    if n > 0 {\n");
        buf_str(out, c"        memcpy(dst as *u8, src as *u8, (n * size_of(T)) as u64);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::slice::stable ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::slice::search ----\n");
        buf_str(out, c"mod search {\n");
        buf_str(out, c"// std::slice::search: binary search and partition_point (0.20).\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Ord, Result};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Slice searches (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Binary search and partition_point (0.20; docs/design/collections-text-io.md\n");
        buf_str(out, c"// §2.4.6), Rust's: the loop runs a number of rounds that depends only on\n");
        buf_str(out, c"// the length, each choosing its half with no branch on the comparison, and\n");
        buf_str(out, c"// a match is not returned early. With equal elements, which of them a\n");
        buf_str(out, c"// match finds is unspecified, as in Rust. Comparators follow sort_by's\n");
        buf_str(out, c"// sign convention until std has Ordering (0.20's A0): `f(x)` negative,\n");
        buf_str(out, c"// zero or positive as the element x goes before, with or after the one\n");
        buf_str(out, c"// looked for.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Searches the sorted s for *x: Ok(index of a match), or Err(the index\n");
        buf_str(out, c"// where *x would go to keep s sorted). Rust's `binary_search`.\n");
        buf_str(out, c"pub fn binary_search<T: Ord>(s: [T], x: T) -> Result<i64, i64> {\n");
        buf_str(out, c"    binary_search_by(s, |e: T| e.cmp(x))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Searches s, sorted by f, for the element f places at 0 (`f(e)`: the\n");
        buf_str(out, c"// sign of comparing e with what is looked for): Ok(index of a match), or\n");
        buf_str(out, c"// Err(the index where it would go).\n");
        buf_str(out, c"pub fn binary_search_by<T, F: FnMut(let T) -> i64>(s: [T], f: F) -> Result<i64, i64> {\n");
        buf_str(out, c"    var g = f;\n");
        buf_str(out, c"    var size = s.len;\n");
        buf_str(out, c"    if size == 0 {\n");
        buf_str(out, c"        return Err(0);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var base = 0;\n");
        buf_str(out, c"    // (size halves each round, base + size <= s.len: 63 rounds at most)\n");
        buf_str(out, c"    for _ in 0..64 {\n");
        buf_str(out, c"        if size <= 1 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let half = size / 2;\n");
        buf_str(out, c"        let mid = base + half;\n");
        buf_str(out, c"        let c = g(s[mid]);\n");
        buf_str(out, c"        base = if c > 0 { base } else { mid };\n");
        buf_str(out, c"        size -= half;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let c = g(s[base]);\n");
        buf_str(out, c"    if c == 0 {\n");
        buf_str(out, c"        Ok(base)\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        Err(base + (c < 0) as i64)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Searches s, sorted by the key f gives, for *key: as binary_search.\n");
        buf_str(out, c"pub fn binary_search_by_key<T, B: Ord, F: FnMut(let T) -> B>(s: [T], key: B, f: F) -> Result<i64,\n");
        buf_str(out, c"    i64> {\n");
        buf_str(out, c"    var g = f;\n");
        buf_str(out, c"    binary_search_by(s, |e: T| {\n");
        buf_str(out, c"        let k = g(e);\n");
        buf_str(out, c"        k.cmp(key)\n");
        buf_str(out, c"    })\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The index of the first element for which pred is false, s being\n");
        buf_str(out, c"// partitioned (pred true for a prefix, false after). Rust's\n");
        buf_str(out, c"// `partition_point`.\n");
        buf_str(out, c"pub fn partition_point<T, P: FnMut(let T) -> bool>(s: [T], pred: P) -> i64 {\n");
        buf_str(out, c"    var g = pred;\n");
        buf_str(out, c"    match binary_search_by(s, |e: T| if g(e) { -1 } else { 1 }) {\n");
        buf_str(out, c"        Ok(i) => i,\n");
        buf_str(out, c"        Err(i) => i,\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::slice::search ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::slice::algo ----\n");
        buf_str(out, c"mod algo {\n");
        buf_str(out, c"// std::slice::algo: reverse, rotations, fill, dedup, retain, selection, heap sifts (0.20).\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Clone, Eq};\n");
        buf_str(out, c"use super::{reverse_raw, rotate_raw, swap_at};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Slice algorithms (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Rust's slice algorithms as functions over slices (0.20;\n");
        buf_str(out, c"// docs/design/collections-text-io.md §2.4.1 and §2.4.6, task A1): reverse,\n");
        buf_str(out, c"// rotations, fill, dedup and retain (which compact a slice and return its\n");
        buf_str(out, c"// new length, for Vec's methods to truncate to), selection of the k-th\n");
        buf_str(out, c"// element, and the sift functions of a binary max-heap. Comparators take\n");
        buf_str(out, c"// `*T`, and those returning a sign follow sort_by's convention until std\n");
        buf_str(out, c"// has Ordering.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Unsafe code: reverse and rotate work through the slice's own pointer\n");
        buf_str(out, c"// and length (the kernels of Sort kernels); selection runs the unstable\n");
        buf_str(out, c"// sort's kernels on s.ptr and s.len, whose contract they keep.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Reverses s in place. Rust's `reverse`.\n");
        buf_str(out, c"pub fn reverse<T>(s: inout [T]) {\n");
        buf_str(out, c"    // (s.ptr and s.len are one slice's)\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        reverse_raw(s.ptr, s.len);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Rotates s in place so that s[k] comes first and s[0..k] goes to the end\n");
        buf_str(out, c"// (k <= s.len, checked). Rust's `rotate_left`.\n");
        buf_str(out, c"pub fn rotate_left<T>(s: inout [T], k: i64) {\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    // (the check: s[k..] panics when k > n)\n");
        buf_str(out, c"    let _ = &s[k..];\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        rotate_raw(s.ptr, n, k);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Rotates s in place so that its last k elements come first (k <= s.len,\n");
        buf_str(out, c"// checked). Rust's `rotate_right`.\n");
        buf_str(out, c"pub fn rotate_right<T>(s: inout [T], k: i64) {\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    let _ = &s[k..];\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        rotate_raw(s.ptr, n, n - k);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sets every element of s to a clone of x. Rust's `fill`.\n");
        buf_str(out, c"pub fn fill<T: Clone>(s: inout [T], x: sink T) {\n");
        buf_str(out, c"    for i in 0..s.len {\n");
        buf_str(out, c"        s[i] = x.clone();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Removes the elements of s for which same(e, kept) is true, kept being\n");
        buf_str(out, c"// the last element kept before e, keeping the order of the rest at the\n");
        buf_str(out, c"// front of s; returns how many are kept (s[n..] holds the others, in\n");
        buf_str(out, c"// some order: Vec's `dedup_by` drops them). Rust's `dedup_by`.\n");
        buf_str(out, c"pub fn dedup_by<T, F: FnMut(let T, let T) -> bool>(s: inout [T], same: F) -> i64 {\n");
        buf_str(out, c"    var g = same;\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    if n < 2 {\n");
        buf_str(out, c"        return n;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var w = 1;\n");
        buf_str(out, c"    for r in 1..n {\n");
        buf_str(out, c"        if !g(s[r], s[w - 1]) {\n");
        buf_str(out, c"            if r != w {\n");
        buf_str(out, c"                swap_at(s, w, r);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            w += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    w\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// dedup_by with ==: consecutive equal elements kept once.\n");
        buf_str(out, c"pub fn dedup<T: Eq>(s: inout [T]) -> i64 {\n");
        buf_str(out, c"    dedup_by(s, |a: T, b: T| a == b)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// dedup_by on the key f gives each element.\n");
        buf_str(out, c"pub fn dedup_by_key<T, K: Eq, F: FnMut(let T) -> K>(s: inout [T], f: F) -> i64 {\n");
        buf_str(out, c"    var g = f;\n");
        buf_str(out, c"    dedup_by(s, |a: T, b: T| g(a) == g(b))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Keeps the elements of s for which keep is true at the front of s, in\n");
        buf_str(out, c"// their order, and returns how many (s[n..] holds the others, in some\n");
        buf_str(out, c"// order); keep sees each element once, in order. Rust's `retain` (Vec's\n");
        buf_str(out, c"// drops the others).\n");
        buf_str(out, c"pub fn retain_by<T, F: FnMut(let T) -> bool>(s: inout [T], keep: F) -> i64 {\n");
        buf_str(out, c"    var g = keep;\n");
        buf_str(out, c"    var w = 0;\n");
        buf_str(out, c"    for r in 0..s.len {\n");
        buf_str(out, c"        if g(s[r]) {\n");
        buf_str(out, c"            if r != w {\n");
        buf_str(out, c"                swap_at(s, w, r);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            w += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    w\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Binary max-heap helpers (for BinaryHeap, 0.20): s[0..end] is a heap\n");
        buf_str(out, c"// when no element is less than its children, s[2i + 1] and s[2i + 2],\n");
        buf_str(out, c"// by is_less. The element moves as bits through s's pointer (any T, owned\n");
        buf_str(out, c"// ones too); pos < end <= s.len, checked.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Moves s[pos] up toward s[start] while it is greater than its parent;\n");
        buf_str(out, c"// returns where it stops. Rust's BinaryHeap::sift_up.\n");
        buf_str(out, c"pub fn heap_sift_up_less<T,\n");
        buf_str(out, c"    F: FnMut(let T, let T) -> bool>(s: inout [T], start: i64, pos: i64, is_less: F) -> i64 {\n");
        buf_str(out, c"    let _ = &s[pos];\n");
        buf_str(out, c"    // (pos < s.len; every index below is at most pos)\n");
        buf_str(out, c"    unsafe { heap_sift_up_raw(s.ptr, start, pos, is_less) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"unsafe fn heap_sift_up_raw<T,\n");
        buf_str(out, c"    F: FnMut(let T, let T) -> bool>(p: *T, start: i64, pos: i64, is_less: F) -> i64 {\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    let x = p[pos];\n");
        buf_str(out, c"    var at = pos;\n");
        buf_str(out, c"    // (at at least halves each round)\n");
        buf_str(out, c"    for _ in 0..64 {\n");
        buf_str(out, c"        if at <= start {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let parent = (at - 1) / 2;\n");
        buf_str(out, c"        if !f(*(&p[parent]), x) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        p[at] = p[parent];\n");
        buf_str(out, c"        at = parent;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    p[at] = x;\n");
        buf_str(out, c"    at\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Moves s[pos] down the heap s[0..end] while a child is greater, taking\n");
        buf_str(out, c"// the greater child each time (the right one when they are equal, as\n");
        buf_str(out, c"// Rust); returns where it stops. Rust's BinaryHeap::sift_down_range.\n");
        buf_str(out, c"pub fn heap_sift_down_less<T,\n");
        buf_str(out, c"    F: FnMut(let T, let T) -> bool>(s: inout [T], pos: i64, end: i64, is_less: F) -> i64 {\n");
        buf_str(out, c"    let _ = &s[pos];\n");
        buf_str(out, c"    let _ = &s[end - 1];\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    // (pos < end <= s.len: every index below is under end)\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let p = s.ptr;\n");
        buf_str(out, c"        let x = p[pos];\n");
        buf_str(out, c"        var at = pos;\n");
        buf_str(out, c"        // (at at least doubles each round)\n");
        buf_str(out, c"        for _ in 0..64 {\n");
        buf_str(out, c"            var child = 2 * at + 1;\n");
        buf_str(out, c"            if child >= end {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if child + 1 < end && !f(*(&p[child + 1]), *(&p[child])) {\n");
        buf_str(out, c"                child += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if !f(x, *(&p[child])) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            p[at] = p[child];\n");
        buf_str(out, c"            at = child;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        p[at] = x;\n");
        buf_str(out, c"        at\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Moves s[pos] all the way down the heap s[0..end] along the greater\n");
        buf_str(out, c"// children, then up to where it belongs: fewer comparisons when it\n");
        buf_str(out, c"// belongs low, as after a pop moves the last element to the root. Rust's\n");
        buf_str(out, c"// BinaryHeap::sift_down_to_bottom.\n");
        buf_str(out, c"pub fn heap_sift_down_to_bottom_less<T, F: FnMut(let T, let T) -> bool>(s: inout [T], pos: i64,\n");
        buf_str(out, c"    end: i64, is_less: F) {\n");
        buf_str(out, c"    let _ = &s[pos];\n");
        buf_str(out, c"    let _ = &s[end - 1];\n");
        buf_str(out, c"    var f = is_less;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let p = s.ptr;\n");
        buf_str(out, c"        let x = p[pos];\n");
        buf_str(out, c"        var at = pos;\n");
        buf_str(out, c"        for _ in 0..64 {\n");
        buf_str(out, c"            var child = 2 * at + 1;\n");
        buf_str(out, c"            if child >= end {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if child + 1 < end && !f(*(&p[child + 1]), *(&p[child])) {\n");
        buf_str(out, c"                child += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            p[at] = p[child];\n");
        buf_str(out, c"            at = child;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        p[at] = x;\n");
        buf_str(out, c"        heap_sift_up_raw(p, pos, at, f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::slice::algo ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::slice ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::collections ----\n");
        buf_str(out, c"pub mod collections {\n");
        buf_str(out, c"// std::collections: the hash map and set (0.20: on the Swiss table,\n");
        buf_str(out, c"// raw_table.tach), the B-tree map and set (btree_node.tach).\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub mod hash_map;\n");
        buf_str(out, c"pub mod hash_set;\n");
        buf_str(out, c"pub mod raw_table;\n");
        buf_str(out, c"pub mod btree_node;\n");
        buf_str(out, c"pub mod btree_map;\n");
        buf_str(out, c"pub mod group;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub use btree_map::{BTreeMap, BTreeSet, BTreeSetIter};\n");
        buf_str(out, c"pub use btree_node::{BHandle, BTreeIter, BTreeRaw};\n");
        buf_str(out, c"pub use hash_map::{HashMap, SLOT_FULL};\n");
        buf_str(out, c"pub use hash_set::{HashSet, HashSetIter};\n");
        buf_str(out, c"pub use raw_table::{ProbeStats, RawIter, RawTable};\n");
        buf_str(out, c"// ---- mod std::collections::hash_map ----\n");
        buf_str(out, c"pub mod hash_map {\n");
        buf_str(out, c"// std::collections::hash_map: HashMap (0.20: on the Swiss table).\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{ALLOC_LIMIT, Allocator, Ambient, Drop, Eq, Gpa, Hash, Option, out_of_memory, replace};\n");
        buf_str(out, c"use super::raw_table::RawTable;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- HashMap ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A hash table from K to V: hashbrown's Swiss table (RawTable), its\n");
        buf_str(out, c"// entries (key, value) pairs in buckets, matched 8 control bytes at a\n");
        buf_str(out, c"// time; keys hashed by their Hash impl (std's: foldhash with fixed seeds,\n");
        buf_str(out, c"// so a map iterates in the same order in every run and on every target).\n");
        buf_str(out, c"// Slots are numbered 0..slots(); `key_at(i)` and `value_at(i)` give an\n");
        buf_str(out, c"// occupied slot's entry (None for a free one); `iter()` is the same in\n");
        buf_str(out, c"// slot order.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct HashMap<K: Hash + Eq, V, A: Allocator = Gpa> {\n");
        buf_str(out, c"    table: RawTable<(K, V), A>,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.20: the old table's slot state of an entry; kept for code that names\n");
        buf_str(out, c"// it)\n");
        buf_str(out, c"pub const SLOT_FULL: u8 = 1;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The hash of an entry's key.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn entry_hash<K: Hash, V>(e: (K, V)) -> u64 {\n");
        buf_str(out, c"    e.0.hash()\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Hash + Eq, V, A: Allocator> HashMap<K, V, A> {\n");
        buf_str(out, c"    // An empty map on allocator a (0.16).\n");
        buf_str(out, c"    pub fn new_in(a: sink A) -> HashMap<K, V, A> {\n");
        buf_str(out, c"        HashMap { table: RawTable::new_in(a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn len(self) -> i64 {\n");
        buf_str(out, c"        self.table.len()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn is_empty(self) -> bool {\n");
        buf_str(out, c"        self.table.len() == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The slot holding `key`, or -1.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn slot_of(self, key: K) -> i64 {\n");
        buf_str(out, c"        self.table.find(key.hash(), |e: (K, V)| e.0 == key)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn contains(self, key: sink K) -> bool {\n");
        buf_str(out, c"        self.slot_of(key) >= 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The same as `contains` (Rust's name).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn contains_key(self, key: sink K) -> bool {\n");
        buf_str(out, c"        self.slot_of(key) >= 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A copy of the value of `key`, if it has one (`get_mut` changes it).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn get(self, key: sink K) -> Option<V> {\n");
        buf_str(out, c"        let i = self.slot_of(key);\n");
        buf_str(out, c"        // (i from find: FULL)\n");
        buf_str(out, c"        if i < 0 { Option::None }\n");
        buf_str(out, c"        else { Option::Some(unsafe { (*self.table.bucket_unchecked(i)).1 }) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The value of `key` in place, as a writable view of one element, if\n");
        buf_str(out, c"    // it has one: `if let Some(a) = m.get_mut(k) { a[0].balance += 10; }`.\n");
        buf_str(out, c"    // The view is valid until the map's next insert, remove or free (like\n");
        buf_str(out, c"    // a Vec's `as_mut_slice()`).\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn get_mut(inout self, key: sink K) -> Option<inout [V]> {\n");
        buf_str(out, c"        let i = self.slot_of(key);\n");
        buf_str(out, c"        if i < 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let p = unsafe { &(*self.table.bucket_unchecked(i)).1 as *V };\n");
        buf_str(out, c"        Option::Some(unsafe { &p[0..1] })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The value of `key` in place (a writable view of one element, as `get_mut`),\n");
        buf_str(out, c"    // inserted as `default` first if the key has none; Rust's\n");
        buf_str(out, c"    // `entry(k).or_insert(d)`. Counting: `counts.get_or_insert(w, 0)[0] += 1;`.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    #[stores(key, default)]\n");
        buf_str(out, c"    pub fn get_or_insert(inout self, key: sink K, default: sink V) -> inout [V] {\n");
        buf_str(out, c"        let h = key.hash();\n");
        buf_str(out, c"        self.table.reserve(1, |e: (K, V)| entry_hash(e));\n");
        buf_str(out, c"        let r = self.table.find_or_find_insert_slot(h, |e: (K, V)| e.0 == key);\n");
        buf_str(out, c"        let i = if r >= 0 { r } else { self.table.insert_in_slot(h, ~r, (key, default)) };\n");
        buf_str(out, c"        // (i found or just filled: FULL)\n");
        buf_str(out, c"        let p = unsafe { &(*self.table.bucket_unchecked(i)).1 as *V };\n");
        buf_str(out, c"        unsafe { &p[0..1] }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Sets the value of `key`; returns its old value, if it had one.\n");
        buf_str(out, c"    #[stores(key, value)]\n");
        buf_str(out, c"    pub fn insert(inout self, key: sink K, value: sink V) -> Option<V> {\n");
        buf_str(out, c"        let h = key.hash();\n");
        buf_str(out, c"        self.table.reserve(1, |e: (K, V)| entry_hash(e));\n");
        buf_str(out, c"        let r = self.table.find_or_find_insert_slot(h, |e: (K, V)| e.0 == key);\n");
        buf_str(out, c"        if r >= 0 {\n");
        buf_str(out, c"            // (the old value moves out, the new one in: neither is dropped)\n");
        buf_str(out, c"            let p = unsafe { self.table.bucket_unchecked(r) };\n");
        buf_str(out, c"            let old = unsafe { (*p).1 };\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                (*p).1 = value;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return Option::Some(old);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.table.insert_in_slot(h, ~r, (key, value));\n");
        buf_str(out, c"        Option::None\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes `key`; returns its value, if it had one (the stored key is\n");
        buf_str(out, c"    // dropped).\n");
        buf_str(out, c"    pub fn remove(inout self, key: sink K) -> Option<V> {\n");
        buf_str(out, c"        let i = self.slot_of(key);\n");
        buf_str(out, c"        if i < 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let e = self.table.take(i);\n");
        buf_str(out, c"        Option::Some(e.1)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The slots: what `key_at` and `value_at` take.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn slots(self) -> i64 {\n");
        buf_str(out, c"        if self.table.len() == 0 { 0 } else { self.table.buckets() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn key_at(self, i: i64) -> Option<K> {\n");
        buf_str(out, c"        if !self.table.is_full(i) {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some(unsafe { (*self.table.bucket(i)).0 })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn value_at(self, i: i64) -> Option<V> {\n");
        buf_str(out, c"        if !self.table.is_full(i) {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some(unsafe { (*self.table.bucket(i)).1 })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // (std's iterators) The table.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn raw_table(self) -> let RawTable<(K, V), A> {\n");
        buf_str(out, c"        self.table\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its entries dropped and its memory given back; it is left empty, to\n");
        buf_str(out, c"    // use again (0.17: a map is dropped at the end of its scope without\n");
        buf_str(out, c"    // it).\n");
        buf_str(out, c"    pub fn free(inout self) {\n");
        buf_str(out, c"        self.table.free();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes every entry; keeps the memory.\n");
        buf_str(out, c"    pub fn clear(inout self) {\n");
        buf_str(out, c"        self.table.clear();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its entries, in a map on the same allocator; it is left empty (0.17:\n");
        buf_str(out, c"    // `std::take` for a container, which keeps its allocator).\n");
        buf_str(out, c"    pub fn take(inout self) -> HashMap<K, V, A> {\n");
        buf_str(out, c"        let empty: HashMap<K, V, A> = HashMap::new_in(self.table.allocator());\n");
        buf_str(out, c"        replace(&self, empty)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its allocator (0.16): a copy of the handle.\n");
        buf_str(out, c"    pub fn allocator(self) -> A {\n");
        buf_str(out, c"        self.table.allocator()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An empty map on allocator a with room for n entries (0.16).\n");
        buf_str(out, c"    pub fn with_capacity_in(n: i64, a: sink A) -> HashMap<K, V, A> {\n");
        buf_str(out, c"        if n > ALLOC_LIMIT / 16 {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        HashMap { table: RawTable::with_capacity_in(n, a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The entries it holds before it grows.\n");
        buf_str(out, c"    pub fn capacity(self) -> i64 {\n");
        buf_str(out, c"        self.table.capacity()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Room for n more entries without growing.\n");
        buf_str(out, c"    pub fn reserve(inout self, n: i64) {\n");
        buf_str(out, c"        self.table.reserve(n, |e: (K, V)| entry_hash(e));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.17) A map's drop: its entries' drops, then its memory given back.\n");
        buf_str(out, c"impl<K: Hash + Eq, V, A: Allocator> Drop for HashMap<K, V, A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn drop(inout self) {\n");
        buf_str(out, c"        self.table.free();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Hash + Eq, V, A: Allocator + Ambient> HashMap<K, V, A> {\n");
        buf_str(out, c"    #[ambient(\"HashMap::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> HashMap<K, V, A> {\n");
        buf_str(out, c"        HashMap::new_in(A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::collections::hash_map ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::collections::hash_set ----\n");
        buf_str(out, c"pub mod hash_set {\n");
        buf_str(out, c"// std::collections::hash_set: HashSet (0.20), a set of T on the Swiss\n");
        buf_str(out, c"// table (RawTable), as HashMap is.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Allocator, Ambient, Drop, Eq, Gpa, Hash, Iterator, Option};\n");
        buf_str(out, c"use super::raw_table::{RawIter, RawTable};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- HashSet (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A set of values of T: `insert` adds one (false when it was there),\n");
        buf_str(out, c"// `contains`, `remove`; `iter()` gives them in slot order, the same in\n");
        buf_str(out, c"// every run.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct HashSet<T: Hash + Eq, A: Allocator = Gpa> {\n");
        buf_str(out, c"    table: RawTable<T, A>,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The hash of an element.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn elem_hash<T: Hash>(x: T) -> u64 {\n");
        buf_str(out, c"    x.hash()\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Hash + Eq, A: Allocator> HashSet<T, A> {\n");
        buf_str(out, c"    // An empty set on allocator a.\n");
        buf_str(out, c"    pub fn new_in(a: sink A) -> HashSet<T, A> {\n");
        buf_str(out, c"        HashSet { table: RawTable::new_in(a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An empty set on allocator a with room for n values.\n");
        buf_str(out, c"    pub fn with_capacity_in(n: i64, a: sink A) -> HashSet<T, A> {\n");
        buf_str(out, c"        HashSet { table: RawTable::with_capacity_in(n, a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn len(self) -> i64 {\n");
        buf_str(out, c"        self.table.len()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn is_empty(self) -> bool {\n");
        buf_str(out, c"        self.table.len() == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn contains(self, x: sink T) -> bool {\n");
        buf_str(out, c"        self.table.find(x.hash(), |e: T| e == x) >= 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Adds x; false when the set had it already (x is dropped then).\n");
        buf_str(out, c"    #[stores(x)]\n");
        buf_str(out, c"    pub fn insert(inout self, x: sink T) -> bool {\n");
        buf_str(out, c"        let h = x.hash();\n");
        buf_str(out, c"        self.table.reserve(1, |e: T| elem_hash(e));\n");
        buf_str(out, c"        let r = self.table.find_or_find_insert_slot(h, |e: T| e == x);\n");
        buf_str(out, c"        if r >= 0 {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.table.insert_in_slot(h, ~r, x);\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes x; false when the set did not have it.\n");
        buf_str(out, c"    pub fn remove(inout self, x: sink T) -> bool {\n");
        buf_str(out, c"        let i = self.table.find(x.hash(), |e: T| e == x);\n");
        buf_str(out, c"        if i < 0 {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.table.erase(i);\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The values, in slot order, until the set changes.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn iter(self) -> HashSetIter<T> {\n");
        buf_str(out, c"        let data = if self.table.len() == 0 { 0 as *T } else { self.table.bucket_ptr() };\n");
        buf_str(out, c"        HashSetIter { it: self.table.iter(), data: data, left: self.table.len() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes every value; keeps the memory.\n");
        buf_str(out, c"    pub fn clear(inout self) {\n");
        buf_str(out, c"        self.table.clear();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Drops the values and gives the memory back; the set is empty.\n");
        buf_str(out, c"    pub fn free(inout self) {\n");
        buf_str(out, c"        self.table.free();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn allocator(self) -> A {\n");
        buf_str(out, c"        self.table.allocator()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Hash + Eq, A: Allocator> Drop for HashSet<T, A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn drop(inout self) {\n");
        buf_str(out, c"        self.table.free();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Hash + Eq, A: Allocator + Ambient> HashSet<T, A> {\n");
        buf_str(out, c"    #[ambient(\"HashSet::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> HashSet<T, A> {\n");
        buf_str(out, c"        HashSet::new_in(A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `s.iter()`: the values (copies), a view of the set.\n");
        buf_str(out, c"pub struct HashSetIter<T> { it: RawIter, data: *T, left: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Iterator for HashSetIter<T> {\n");
        buf_str(out, c"    type Item = T;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<T> {\n");
        buf_str(out, c"        let i = self.it.next_index();\n");
        buf_str(out, c"        if i < 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.left -= 1;\n");
        buf_str(out, c"        Option::Some(unsafe { self.data[i] })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self) -> i64 {\n");
        buf_str(out, c"        self.left\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::collections::hash_set ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::collections::raw_table ----\n");
        buf_str(out, c"pub mod raw_table {\n");
        buf_str(out, c"// std::collections::raw_table: RawTable<T, A>, the Swiss table (0.20),\n");
        buf_str(out, c"// the engine of HashMap and HashSet, hashbrown's design. It stores\n");
        buf_str(out, c"// elements of T in buckets and never hashes: the caller gives each\n");
        buf_str(out, c"// operation the element's hash and closures, `eq` (is this the element?)\n");
        buf_str(out, c"// and `hasher` (an element's hash, to move it when the table grows), so\n");
        buf_str(out, c"// one table serves maps and sets and its code is made once per element\n");
        buf_str(out, c"// type.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Layout: one allocation from A, the buckets (`buckets` elements of T)\n");
        buf_str(out, c"// then, 8-aligned, the control bytes (group.tach): `buckets + GROUP` of\n");
        buf_str(out, c"// them, the last GROUP a copy of the first (so a group read at any bucket\n");
        buf_str(out, c"// is in bounds). `buckets` is a power of two, 4 at least; a table that has\n");
        buf_str(out, c"// never allocated has bucket_mask 0 and no control bytes (a constant\n");
        buf_str(out, c"// constructor: a static may hold one); its methods check that first. A\n");
        buf_str(out, c"// hash's low bits pick the first group probed (h1), its top 7 its tag (ctrl_tag);\n");
        buf_str(out, c"// probing goes over groups by triangular steps (stride GROUP, 2 GROUP, ...),\n");
        buf_str(out, c"// which visit every group of a power-of-two table. At most 7/8 of the\n");
        buf_str(out, c"// buckets are FULL (all but one below 8 buckets): a search always ends at\n");
        buf_str(out, c"// an EMPTY byte.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Elements are owned by the table: `erase`, `clear` and the drop drop\n");
        buf_str(out, c"// them, `take` moves one out, `get` and `get_mut` are views of one.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Safety: every unsafe block below reads or writes a control byte below\n");
        buf_str(out, c"// buckets + GROUP or a bucket below `buckets` of the live allocation, or\n");
        buf_str(out, c"// an element in a FULL bucket (initialized). Raw writes drop nothing\n");
        buf_str(out, c"// (ptr::write), raw reads move out (ptr::read). An index a caller gives\n");
        buf_str(out, c"// is checked (`erase`, `take`, `get`, `insert_in_slot`, ...); the\n");
        buf_str(out, c"// iterator is a view of the control bytes.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{\n");
        buf_str(out, c"    ALLOC_LIMIT, Allocator, Drop, Gpa, Iterator, Option, drop, leading_zeros, needs_drop,\n");
        buf_str(out, c"    out_of_memory, panic,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"use super::group::{\n");
        buf_str(out, c"    BitMask, CTRL_DELETED, CTRL_EMPTY, GROUP, bitmask_leading, bitmask_lowest,\n");
        buf_str(out, c"    bitmask_remove_lowest, bitmask_trailing, convert_special_to_empty_and_full_to_deleted, ctrl_tag,\n");
        buf_str(out, c"    group_load, group_store, match_empty, match_empty_or_deleted, match_full, match_tag,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Swiss table (0.20 implementation) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct RawTable<T, A: Allocator = Gpa> {\n");
        buf_str(out, c"    // the control bytes (buckets + GROUP)\n");
        buf_str(out, c"    ctrl: *u8,\n");
        buf_str(out, c"    // the buckets\n");
        buf_str(out, c"    data: *T,\n");
        buf_str(out, c"    // buckets - 1 (0: not allocated)\n");
        buf_str(out, c"    bucket_mask: i64,\n");
        buf_str(out, c"    // insertions left before the table grows: EMPTY buckets that may\n");
        buf_str(out, c"    // still be filled under the load factor\n");
        buf_str(out, c"    growth_left: i64,\n");
        buf_str(out, c"    // FULL buckets\n");
        buf_str(out, c"    items: i64,\n");
        buf_str(out, c"    alloc: A,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The iterator over a table's FULL buckets, in bucket order (`iter()`):\n");
        buf_str(out, c"// their indices. A view of the table's control bytes.\n");
        buf_str(out, c"pub struct RawIter {\n");
        buf_str(out, c"    ctrl: [u8],\n");
        buf_str(out, c"    // the group being read and its FULL buckets not yet given\n");
        buf_str(out, c"    pos: i64,\n");
        buf_str(out, c"    bits: BitMask,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// How far elements are from where their search starts (`probe_stats`):\n");
        buf_str(out, c"// groups probed past the first, in total and at most.\n");
        buf_str(out, c"pub struct ProbeStats {\n");
        buf_str(out, c"    pub total: i64,\n");
        buf_str(out, c"    pub max: i64,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The elements a table of bucket_mask + 1 buckets may hold: 7/8 of them,\n");
        buf_str(out, c"// all but one below 8.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn raw_capacity(bucket_mask: i64) -> i64 {\n");
        buf_str(out, c"    if bucket_mask < 8 {\n");
        buf_str(out, c"        bucket_mask\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        ((bucket_mask + 1) / 8) * 7\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The buckets for cap elements (cap > 0): a power of two, 4 at least.\n");
        buf_str(out, c"fn raw_buckets_for(cap: i64) -> i64 {\n");
        buf_str(out, c"    if cap < 4 {\n");
        buf_str(out, c"        return 4;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if cap < 8 {\n");
        buf_str(out, c"        return 8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if cap < 15 {\n");
        buf_str(out, c"        return 16;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if cap > ALLOC_LIMIT / 8 {\n");
        buf_str(out, c"        out_of_memory();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let adjusted = cap * 8 / 7;\n");
        buf_str(out, c"    // (the next power of two)\n");
        buf_str(out, c"    1 << (64 - leading_zeros((adjusted - 1) as u64))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sets n control bytes at ctrl to EMPTY; the caller guarantees that they\n");
        buf_str(out, c"// are writable.\n");
        buf_str(out, c"unsafe fn raw_fill_empty(ctrl: *u8, n: i64) {\n");
        buf_str(out, c"    for g in 0..n / GROUP {\n");
        buf_str(out, c"        group_store(ctrl, g * GROUP, 0xffffffffffffffffu64);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for k in n / GROUP * GROUP..n {\n");
        buf_str(out, c"        ctrl[k] = CTRL_EMPTY;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, A: Allocator> RawTable<T, A> {\n");
        buf_str(out, c"    // An empty table on allocator a; it allocates at the first insertion.\n");
        buf_str(out, c"    pub fn new_in(a: sink A) -> RawTable<T, A> {\n");
        buf_str(out, c"        RawTable {\n");
        buf_str(out, c"            ctrl: 0 as *u8, data: 0 as *T, bucket_mask: 0, growth_left: 0,\n");
        buf_str(out, c"            items: 0, alloc: a\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An empty table on allocator a with room for n elements.\n");
        buf_str(out, c"    pub fn with_capacity_in(n: i64, a: sink A) -> RawTable<T, A> {\n");
        buf_str(out, c"        var t: RawTable<T, A> = RawTable::new_in(a);\n");
        buf_str(out, c"        if n > 0 {\n");
        buf_str(out, c"            t.alloc_buckets(raw_buckets_for(n));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        t\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The elements in the table.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn len(self) -> i64 {\n");
        buf_str(out, c"        self.items\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn is_empty(self) -> bool {\n");
        buf_str(out, c"        self.items == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The elements it holds before it grows.\n");
        buf_str(out, c"    pub fn capacity(self) -> i64 {\n");
        buf_str(out, c"        self.items + self.growth_left\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The buckets (1 before the first allocation).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn buckets(self) -> i64 {\n");
        buf_str(out, c"        self.bucket_mask + 1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn allocator(self) -> A {\n");
        buf_str(out, c"        self.alloc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The allocation's size and alignment for `buckets` buckets, and where\n");
        buf_str(out, c"    // its control bytes start.\n");
        buf_str(out, c"    fn raw_layout(buckets: i64) -> (i64, i64, i64) {\n");
        buf_str(out, c"        let size = size_of(T);\n");
        buf_str(out, c"        if size > 0 && buckets > (ALLOC_LIMIT - 2 * GROUP) / size {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let ctrl_at = (buckets * size + GROUP - 1) & ~(GROUP - 1);\n");
        buf_str(out, c"        let align = if align_of(T) > GROUP { align_of(T) } else { GROUP };\n");
        buf_str(out, c"        (ctrl_at + buckets + GROUP, align, ctrl_at)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Allocates `buckets` empty buckets for an empty table.\n");
        buf_str(out, c"    fn alloc_buckets(inout self, buckets: i64) {\n");
        buf_str(out, c"        let (size, align, ctrl_at) = RawTable::<T, A>::raw_layout(buckets);\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let p = self.alloc.alloc(size, align);\n");
        buf_str(out, c"            self.data = p as *T;\n");
        buf_str(out, c"            self.ctrl = &p[ctrl_at];\n");
        buf_str(out, c"            raw_fill_empty(self.ctrl, buckets + GROUP);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.bucket_mask = buckets - 1;\n");
        buf_str(out, c"        self.growth_left = raw_capacity(buckets - 1);\n");
        buf_str(out, c"        self.items = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Is bucket i FULL? (false for an i out of range)\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn is_full(self, i: i64) -> bool {\n");
        buf_str(out, c"        if i < 0 || i > self.bucket_mask || self.bucket_mask == 0 {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe { self.ctrl[i] & 0x80 == 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Stops the program unless bucket i is FULL.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn check_full(self, i: i64) {\n");
        buf_str(out, c"        if !self.is_full(i) {\n");
        buf_str(out, c"            unsafe { panic(c\"RawTable: the bucket is not full\") }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The FULL bucket holding the element for which eq is true, among\n");
        buf_str(out, c"    // those whose hash is `hash`, or -1.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn find<F: FnMut(let T) -> bool>(self, hash: u64, eq: sink F) -> i64 {\n");
        buf_str(out, c"        let mask = self.bucket_mask;\n");
        buf_str(out, c"        if mask == 0 {\n");
        buf_str(out, c"            return -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let tag = ctrl_tag(hash);\n");
        buf_str(out, c"        var pos = hash as i64 & mask;\n");
        buf_str(out, c"        var stride = 0;\n");
        buf_str(out, c"        // (triangular steps visit every group: the loop ends by then)\n");
        buf_str(out, c"        for _ in 0..(mask >> 3) + 1 {\n");
        buf_str(out, c"            let g = unsafe { group_load(self.ctrl, pos) };\n");
        buf_str(out, c"            var m = match_tag(g, tag);\n");
        buf_str(out, c"            for _ in 0..GROUP {\n");
        buf_str(out, c"                if m == 0 {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let i = (pos + bitmask_lowest(m)) & mask;\n");
        buf_str(out, c"                if unsafe { eq(*(&self.data[i])) } {\n");
        buf_str(out, c"                    return i;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                m = bitmask_remove_lowest(m);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if match_empty(g) != 0 {\n");
        buf_str(out, c"                return -1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            stride += GROUP;\n");
        buf_str(out, c"            pos = (pos + stride) & mask;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        -1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // One probe for an insertion of a possibly present element, after\n");
        buf_str(out, c"    // `reserve(1, hasher)`: the FULL bucket holding the element for which\n");
        buf_str(out, c"    // eq is true (>= 0), else `~slot` (< 0), the bucket to give\n");
        buf_str(out, c"    // `insert_in_slot`, which holds until the table changes.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn find_or_find_insert_slot<F: FnMut(let T) -> bool>(self, hash: u64, eq: sink F) -> i64 {\n");
        buf_str(out, c"        let mask = self.bucket_mask;\n");
        buf_str(out, c"        if mask == 0 {\n");
        buf_str(out, c"            // (no buckets: insert_in_slot refuses it, reserve first)\n");
        buf_str(out, c"            return ~0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let tag = ctrl_tag(hash);\n");
        buf_str(out, c"        var pos = hash as i64 & mask;\n");
        buf_str(out, c"        var stride = 0;\n");
        buf_str(out, c"        var slot = -1;\n");
        buf_str(out, c"        for _ in 0..(mask >> 3) + 1 {\n");
        buf_str(out, c"            let g = unsafe { group_load(self.ctrl, pos) };\n");
        buf_str(out, c"            var m = match_tag(g, tag);\n");
        buf_str(out, c"            for _ in 0..GROUP {\n");
        buf_str(out, c"                if m == 0 {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let i = (pos + bitmask_lowest(m)) & mask;\n");
        buf_str(out, c"                if unsafe { eq(*(&self.data[i])) } {\n");
        buf_str(out, c"                    return i;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                m = bitmask_remove_lowest(m);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if slot < 0 {\n");
        buf_str(out, c"                let e = match_empty_or_deleted(g);\n");
        buf_str(out, c"                if e != 0 {\n");
        buf_str(out, c"                    slot = (pos + bitmask_lowest(e)) & mask;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if match_empty(g) != 0 {\n");
        buf_str(out, c"                return ~self.fix_insert_slot(slot);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            stride += GROUP;\n");
        buf_str(out, c"            pos = (pos + stride) & mask;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // (an EMPTY byte is always reached first: the load factor)\n");
        buf_str(out, c"        ~self.fix_insert_slot(slot)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Puts x, whose hash is `hash`, in bucket `slot`, the `~result` of\n");
        buf_str(out, c"    // find_or_find_insert_slot with no change to the table since; returns\n");
        buf_str(out, c"    // slot.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn insert_in_slot(inout self, hash: u64, slot: i64, x: sink T) -> i64 {\n");
        buf_str(out, c"        if slot < 0 || slot > self.bucket_mask || self.bucket_mask == 0 {\n");
        buf_str(out, c"            unsafe { panic(c\"RawTable::insert_in_slot: no such bucket\") }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let old = unsafe { self.ctrl[slot] };\n");
        buf_str(out, c"        // (a FULL bucket, or an EMPTY one with no growth left, is no slot)\n");
        buf_str(out, c"        if old & 0x80 == 0 || (old == CTRL_EMPTY && self.growth_left == 0) {\n");
        buf_str(out, c"            unsafe { panic(c\"RawTable::insert_in_slot: not a free slot\") }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.record_insert(slot, old, hash);\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.data[slot] = x;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        slot\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Inserts x, whose hash is `hash`, without looking for an equal\n");
        buf_str(out, c"    // element; returns its bucket. hasher(e) is the hash of element e,\n");
        buf_str(out, c"    // for those the table moves when it grows.\n");
        buf_str(out, c"    pub fn insert<H: FnMut(let T) -> u64>(inout self, hash: u64, x: sink T, hasher: H) -> i64 {\n");
        buf_str(out, c"        var i = if self.bucket_mask == 0 { -1 } else { self.find_insert_slot(hash) };\n");
        buf_str(out, c"        if i < 0 || (self.growth_left == 0 && unsafe { self.ctrl[i] } == CTRL_EMPTY) {\n");
        buf_str(out, c"            self.reserve_rehash(1, hasher);\n");
        buf_str(out, c"            i = self.find_insert_slot(hash);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let old = unsafe { self.ctrl[i] };\n");
        buf_str(out, c"        self.record_insert(i, old, hash);\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.data[i] = x;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn record_insert(inout self, i: i64, old: u8, hash: u64) {\n");
        buf_str(out, c"        // (an EMPTY byte has its low bit set, a DELETED one not)\n");
        buf_str(out, c"        self.growth_left -= (old & 1) as i64;\n");
        buf_str(out, c"        self.set_ctrl(i, ctrl_tag(hash));\n");
        buf_str(out, c"        self.items += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The first EMPTY or DELETED bucket of hash's probe sequence.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn find_insert_slot(self, hash: u64) -> i64 {\n");
        buf_str(out, c"        let mask = self.bucket_mask;\n");
        buf_str(out, c"        var pos = hash as i64 & mask;\n");
        buf_str(out, c"        var stride = 0;\n");
        buf_str(out, c"        for _ in 0..(mask >> 3) + 1 {\n");
        buf_str(out, c"            let e = match_empty_or_deleted(unsafe { group_load(self.ctrl, pos) });\n");
        buf_str(out, c"            if e != 0 {\n");
        buf_str(out, c"                return self.fix_insert_slot((pos + bitmask_lowest(e)) & mask);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            stride += GROUP;\n");
        buf_str(out, c"            pos = (pos + stride) & mask;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe { panic(c\"RawTable: no free bucket\") }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // In a table of fewer buckets than GROUP, a group read past the last\n");
        buf_str(out, c"    // bucket sees the EMPTY bytes after it, which stand for the FULL\n");
        buf_str(out, c"    // buckets of the group's start: then the slot is the first free one\n");
        buf_str(out, c"    // from bucket 0.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fix_insert_slot(self, i: i64) -> i64 {\n");
        buf_str(out, c"        if unsafe { self.ctrl[i] } & 0x80 == 0 {\n");
        buf_str(out, c"            return bitmask_lowest(match_empty_or_deleted(unsafe { group_load(self.ctrl, 0) }));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Sets bucket i's control byte, and its copy past the end.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn set_ctrl(inout self, i: i64, c: u8) {\n");
        buf_str(out, c"        let mirror = ((i - GROUP) & self.bucket_mask) + GROUP;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.ctrl[i] = c;\n");
        buf_str(out, c"            self.ctrl[mirror] = c;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The element in FULL bucket i (checked): a view of it.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn get(self, i: i64) -> let T {\n");
        buf_str(out, c"        self.check_full(i);\n");
        buf_str(out, c"        unsafe { *(&self.data[i]) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The element in FULL bucket i (checked), to change in place (its hash\n");
        buf_str(out, c"    // must stay the same).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn get_mut(inout self, i: i64) -> inout T {\n");
        buf_str(out, c"        self.check_full(i);\n");
        buf_str(out, c"        unsafe { &*(&self.data[i]) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A raw pointer to bucket i's element, unchecked: the caller\n");
        buf_str(out, c"    // guarantees that i is FULL (a result of find).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub unsafe fn bucket_unchecked(self, i: i64) -> *T {\n");
        buf_str(out, c"        &self.data[i]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A raw pointer to FULL bucket i's element (checked), valid until the\n");
        buf_str(out, c"    // table changes: for code that keeps it past a view's rules.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn bucket(self, i: i64) -> *T {\n");
        buf_str(out, c"        self.check_full(i);\n");
        buf_str(out, c"        unsafe { &self.data[i] }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The buckets' memory (null before the first allocation): raw, for\n");
        buf_str(out, c"    // iterators that pair it with `iter()`'s indices.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn bucket_ptr(self) -> *T {\n");
        buf_str(out, c"        self.data\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Replaces the element in FULL bucket i (checked) with x, which must\n");
        buf_str(out, c"    // have the same hash; the old one is dropped.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn write(inout self, i: i64, x: sink T) {\n");
        buf_str(out, c"        self.check_full(i);\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            if needs_drop::<T>() {\n");
        buf_str(out, c"                drop(self.data[i]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.data[i] = x;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes the element in FULL bucket i (checked) and returns it. Its\n");
        buf_str(out, c"    // control byte becomes EMPTY when no search can have gone past it (an\n");
        buf_str(out, c"    // EMPTY byte within GROUP buckets on both sides spans no full group),\n");
        buf_str(out, c"    // else DELETED.\n");
        buf_str(out, c"    pub fn take(inout self, i: i64) -> T {\n");
        buf_str(out, c"        self.check_full(i);\n");
        buf_str(out, c"        let mask = self.bucket_mask;\n");
        buf_str(out, c"        let before = (i - GROUP) & mask;\n");
        buf_str(out, c"        let empty_before = match_empty(unsafe { group_load(self.ctrl, before) });\n");
        buf_str(out, c"        let empty_after = match_empty(unsafe { group_load(self.ctrl, i) });\n");
        buf_str(out, c"        if bitmask_leading(empty_before) + bitmask_trailing(empty_after) >= GROUP {\n");
        buf_str(out, c"            self.set_ctrl(i, CTRL_DELETED);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.growth_left += 1;\n");
        buf_str(out, c"            self.set_ctrl(i, CTRL_EMPTY);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.items -= 1;\n");
        buf_str(out, c"        unsafe { self.data[i] }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes and drops the element in FULL bucket i (checked).\n");
        buf_str(out, c"    pub fn erase(inout self, i: i64) {\n");
        buf_str(out, c"        let x = self.take(i);\n");
        buf_str(out, c"        drop(x);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Room for n more elements without growing; hasher as for insert.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn reserve<H: FnMut(let T) -> u64>(inout self, n: i64, hasher: H) {\n");
        buf_str(out, c"        if n > self.growth_left {\n");
        buf_str(out, c"            self.reserve_rehash(n, hasher);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Makes room for n more elements: rehashes in place when that frees\n");
        buf_str(out, c"    // enough (at most half the capacity is in use), else moves to a table\n");
        buf_str(out, c"    // of twice the room at least.\n");
        buf_str(out, c"    #[cold]\n");
        buf_str(out, c"    fn reserve_rehash<H: FnMut(let T) -> u64>(inout self, n: i64, hasher: H) {\n");
        buf_str(out, c"        if n > ALLOC_LIMIT / 16 - self.items {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let new_items = self.items + n;\n");
        buf_str(out, c"        let full = raw_capacity(self.bucket_mask);\n");
        buf_str(out, c"        if new_items <= full / 2 {\n");
        buf_str(out, c"            self.rehash_in_place(hasher);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.resize(if new_items > full + 1 { new_items } else { full + 1 }, hasher);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Moves every element to a new allocation with room for cap.\n");
        buf_str(out, c"    fn resize<H: FnMut(let T) -> u64>(inout self, cap: i64, hasher: sink H) {\n");
        buf_str(out, c"        let old_ctrl = self.ctrl;\n");
        buf_str(out, c"        let old_data = self.data;\n");
        buf_str(out, c"        let old_mask = self.bucket_mask;\n");
        buf_str(out, c"        let items = self.items;\n");
        buf_str(out, c"        self.alloc_buckets(raw_buckets_for(cap));\n");
        buf_str(out, c"        if old_mask != 0 {\n");
        buf_str(out, c"            for g in 0..(old_mask >> 3) + 1 {\n");
        buf_str(out, c"                let pos = g * GROUP;\n");
        buf_str(out, c"                var m = match_full(unsafe { group_load(old_ctrl, pos) });\n");
        buf_str(out, c"                for _ in 0..GROUP {\n");
        buf_str(out, c"                    if m == 0 {\n");
        buf_str(out, c"                        break;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    let i = pos + bitmask_lowest(m);\n");
        buf_str(out, c"                    m = bitmask_remove_lowest(m);\n");
        buf_str(out, c"                    let hash = unsafe { hasher(*(&old_data[i])) };\n");
        buf_str(out, c"                    let j = self.find_insert_slot(hash);\n");
        buf_str(out, c"                    self.set_ctrl(j, ctrl_tag(hash));\n");
        buf_str(out, c"                    unsafe {\n");
        buf_str(out, c"                        self.data[j] = old_data[i];\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let (size, align, _) = RawTable::<T, A>::raw_layout(old_mask + 1);\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                self.alloc.free(old_data as *u8, size, align);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.items = items;\n");
        buf_str(out, c"        self.growth_left -= items;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Rehashes in place, turning the DELETED buckets back into EMPTY ones\n");
        buf_str(out, c"    // (hashbrown's algorithm): FULL bytes become DELETED, EMPTY and DELETED\n");
        buf_str(out, c"    // become EMPTY, then each element marked DELETED is moved to the first\n");
        buf_str(out, c"    // free bucket of its probe sequence, swapping with an element there\n");
        buf_str(out, c"    // still to be moved.\n");
        buf_str(out, c"    fn rehash_in_place<H: FnMut(let T) -> u64>(inout self, hasher: sink H) {\n");
        buf_str(out, c"        let buckets = self.bucket_mask + 1;\n");
        buf_str(out, c"        for g in 0..(buckets + GROUP - 1) / GROUP {\n");
        buf_str(out, c"            let i = g * GROUP;\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                group_store(self.ctrl, i,\n");
        buf_str(out, c"                    convert_special_to_empty_and_full_to_deleted(group_load(self.ctrl, i)));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // (the copy past the end)\n");
        buf_str(out, c"        if buckets < GROUP {\n");
        buf_str(out, c"            for k in 0..buckets {\n");
        buf_str(out, c"                unsafe {\n");
        buf_str(out, c"                    self.ctrl[GROUP + k] = self.ctrl[k];\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                group_store(self.ctrl, buckets, group_load(self.ctrl, 0));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for i in 0..buckets {\n");
        buf_str(out, c"            if unsafe { self.ctrl[i] } != CTRL_DELETED {\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            // (each round places one element for good: buckets rounds at most)\n");
        buf_str(out, c"            for _ in 0..buckets {\n");
        buf_str(out, c"                let hash = unsafe { hasher(*(&self.data[i])) };\n");
        buf_str(out, c"                let j = self.find_insert_slot(hash);\n");
        buf_str(out, c"                // (in the same group as its probe's start: it stays)\n");
        buf_str(out, c"                let start = hash as i64 & self.bucket_mask;\n");
        buf_str(out, c"                if ((i - start) & self.bucket_mask) / GROUP\n");
        buf_str(out, c"                    == ((j - start) & self.bucket_mask) / GROUP {\n");
        buf_str(out, c"                    self.set_ctrl(i, ctrl_tag(hash));\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let prev = unsafe { self.ctrl[j] };\n");
        buf_str(out, c"                self.set_ctrl(j, ctrl_tag(hash));\n");
        buf_str(out, c"                if prev == CTRL_EMPTY {\n");
        buf_str(out, c"                    self.set_ctrl(i, CTRL_EMPTY);\n");
        buf_str(out, c"                    unsafe {\n");
        buf_str(out, c"                        self.data[j] = self.data[i];\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                // (j held an element still to move: swap, go on with it)\n");
        buf_str(out, c"                unsafe {\n");
        buf_str(out, c"                    let x = self.data[j];\n");
        buf_str(out, c"                    self.data[j] = self.data[i];\n");
        buf_str(out, c"                    self.data[i] = x;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.growth_left = raw_capacity(self.bucket_mask) - self.items;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Drops every element.\n");
        buf_str(out, c"    fn drop_elements(inout self) {\n");
        buf_str(out, c"        if needs_drop::<T>() && self.items > 0 {\n");
        buf_str(out, c"            for g in 0..(self.bucket_mask >> 3) + 1 {\n");
        buf_str(out, c"                let pos = g * GROUP;\n");
        buf_str(out, c"                var m = match_full(unsafe { group_load(self.ctrl, pos) });\n");
        buf_str(out, c"                for _ in 0..GROUP {\n");
        buf_str(out, c"                    if m == 0 {\n");
        buf_str(out, c"                        break;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    let i = pos + bitmask_lowest(m);\n");
        buf_str(out, c"                    m = bitmask_remove_lowest(m);\n");
        buf_str(out, c"                    unsafe {\n");
        buf_str(out, c"                        drop(self.data[i]);\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes (and drops) every element; keeps the memory.\n");
        buf_str(out, c"    pub fn clear(inout self) {\n");
        buf_str(out, c"        if self.bucket_mask == 0 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.drop_elements();\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            raw_fill_empty(self.ctrl, self.bucket_mask + 1 + GROUP);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.items = 0;\n");
        buf_str(out, c"        self.growth_left = raw_capacity(self.bucket_mask);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The FULL buckets, in bucket order.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn iter(self) -> RawIter {\n");
        buf_str(out, c"        if self.bucket_mask == 0 {\n");
        buf_str(out, c"            return RawIter { ctrl: \"\", pos: 0, bits: 0 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let ctrl = unsafe { self.ctrl[0..self.bucket_mask + 1 + GROUP] };\n");
        buf_str(out, c"        RawIter { ctrl: ctrl, pos: 0, bits: match_full(unsafe { group_load(ctrl.ptr, 0) }) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Drops the elements and gives the memory back; the table is empty,\n");
        buf_str(out, c"    // and may be used again.\n");
        buf_str(out, c"    pub fn free(inout self) {\n");
        buf_str(out, c"        self.drop_elements();\n");
        buf_str(out, c"        if self.bucket_mask != 0 {\n");
        buf_str(out, c"            let (size, align, _) = RawTable::<T, A>::raw_layout(self.bucket_mask + 1);\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                self.alloc.free(self.data as *u8, size, align);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.ctrl = 0 as *u8;\n");
        buf_str(out, c"            self.data = 0 as *T;\n");
        buf_str(out, c"            self.bucket_mask = 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.growth_left = 0;\n");
        buf_str(out, c"        self.items = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // (tests) How far the elements are from where their search starts,\n");
        buf_str(out, c"    // in groups; hasher as for insert.\n");
        buf_str(out, c"    pub fn probe_stats<H: FnMut(let T) -> u64>(self, hasher: sink H) -> ProbeStats {\n");
        buf_str(out, c"        var stats = ProbeStats { total: 0, max: 0 };\n");
        buf_str(out, c"        let mask = self.bucket_mask;\n");
        buf_str(out, c"        for i in self.iter() {\n");
        buf_str(out, c"            let hash = unsafe { hasher(*(&self.data[i])) };\n");
        buf_str(out, c"            var pos = hash as i64 & mask;\n");
        buf_str(out, c"            var stride = 0;\n");
        buf_str(out, c"            var steps = 0;\n");
        buf_str(out, c"            for _ in 0..(mask >> 3) + 1 {\n");
        buf_str(out, c"                if ((i - pos) & mask) < GROUP {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                stride += GROUP;\n");
        buf_str(out, c"                pos = (pos + stride) & mask;\n");
        buf_str(out, c"                steps += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            stats.total += steps;\n");
        buf_str(out, c"            if steps > stats.max {\n");
        buf_str(out, c"                stats.max = steps;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        stats\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // (tests) The table's invariants, with every element found again by\n");
        buf_str(out, c"    // its hash: \"\" when they hold, else the first broken.\n");
        buf_str(out, c"    pub fn check<H: FnMut(let T) -> u64>(self, hasher: sink H) -> [u8] {\n");
        buf_str(out, c"        let buckets = self.bucket_mask + 1;\n");
        buf_str(out, c"        if self.bucket_mask == 0 {\n");
        buf_str(out, c"            if self.items != 0 || self.growth_left != 0 {\n");
        buf_str(out, c"                return \"an unallocated table holds elements\";\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return \"\";\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var full = 0;\n");
        buf_str(out, c"        var deleted = 0;\n");
        buf_str(out, c"        for i in 0..buckets {\n");
        buf_str(out, c"            let c = unsafe { self.ctrl[i] };\n");
        buf_str(out, c"            if c & 0x80 == 0 {\n");
        buf_str(out, c"                full += 1;\n");
        buf_str(out, c"                let hash = unsafe { hasher(*(&self.data[i])) };\n");
        buf_str(out, c"                if ctrl_tag(hash) != c {\n");
        buf_str(out, c"                    return \"a control byte is not its element's tag\";\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                // (the search for its hash finds an element: 0.20's let\n");
        buf_str(out, c"                // parameters copy a plain element, so the bucket is not\n");
        buf_str(out, c"                // known by its address)\n");
        buf_str(out, c"                if self.find(hash, |_p: T| true) < 0 {\n");
        buf_str(out, c"                    return \"an element is not found by its hash\";\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else if c == CTRL_DELETED {\n");
        buf_str(out, c"                deleted += 1;\n");
        buf_str(out, c"            } else if c != CTRL_EMPTY {\n");
        buf_str(out, c"                return \"a control byte is neither FULL, EMPTY nor DELETED\";\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for k in 0..GROUP {\n");
        buf_str(out, c"            let mirror = if buckets < GROUP {\n");
        buf_str(out, c"                if k < buckets { unsafe { self.ctrl[k] } } else { CTRL_EMPTY }\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                unsafe { self.ctrl[k] }\n");
        buf_str(out, c"            };\n");
        buf_str(out, c"            let at = if buckets < GROUP { if k < buckets { GROUP + k } else { k } }\n");
        buf_str(out, c"                else { buckets + k };\n");
        buf_str(out, c"            if unsafe { self.ctrl[at] } != mirror {\n");
        buf_str(out, c"                return \"the control bytes past the end are not a copy\";\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if full != self.items {\n");
        buf_str(out, c"            return \"items is not the number of FULL buckets\";\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.growth_left != raw_capacity(self.bucket_mask) - full - deleted {\n");
        buf_str(out, c"            return \"growth_left is not the capacity left\";\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.growth_left < 0 {\n");
        buf_str(out, c"            return \"more elements than the capacity\";\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        \"\"\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The table's drop: its elements' drops, then its memory given back.\n");
        buf_str(out, c"impl<T, A: Allocator> Drop for RawTable<T, A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn drop(inout self) {\n");
        buf_str(out, c"        self.free();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl RawIter {\n");
        buf_str(out, c"    // The next FULL bucket, or -1 at the end.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn next_index(inout self) -> i64 {\n");
        buf_str(out, c"        // (at most the groups left)\n");
        buf_str(out, c"        for _ in 0..self.ctrl.len / GROUP + 1 {\n");
        buf_str(out, c"            if self.bits != 0 {\n");
        buf_str(out, c"                let i = self.pos + bitmask_lowest(self.bits);\n");
        buf_str(out, c"                self.bits = bitmask_remove_lowest(self.bits);\n");
        buf_str(out, c"                return i;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.pos += GROUP;\n");
        buf_str(out, c"            // (ctrl has buckets + GROUP bytes: a group starts before buckets)\n");
        buf_str(out, c"            if self.pos + GROUP >= self.ctrl.len {\n");
        buf_str(out, c"                return -1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.bits = match_full(unsafe { group_load(self.ctrl.ptr, self.pos) });\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        -1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Iterator for RawIter {\n");
        buf_str(out, c"    type Item = i64;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(inout self) -> Option<i64> {\n");
        buf_str(out, c"        let i = self.next_index();\n");
        buf_str(out, c"        if i < 0 { Option::None } else { Option::Some(i) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::collections::raw_table ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::collections::btree_node ----\n");
        buf_str(out, c"pub mod btree_node {\n");
        buf_str(out, c"// std::collections::btree_node: BTreeRaw<K, V, A>, the B-tree (0.20),\n");
        buf_str(out, c"// the engine of BTreeMap and BTreeSet (0.20), Rust's\n");
        buf_str(out, c"// B-tree. Nodes hold up to 11 keys and values inline (B = 6), internal\n");
        buf_str(out, c"// nodes 12 child pointers too; every node points at its parent and knows\n");
        buf_str(out, c"// its index there, so iteration needs no stack. Leaves and internal nodes\n");
        buf_str(out, c"// are allocated through A at their own sizes. The engine never compares\n");
        buf_str(out, c"// keys itself: a search takes `cmp`, a closure that compares the key\n");
        buf_str(out, c"// sought with the key it is given (negative: the sought one is smaller,\n");
        buf_str(out, c"// 0: equal, positive: larger), so one tree serves maps and sets, and\n");
        buf_str(out, c"// lookups by a borrowed form of the key.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Positions are BHandles: a key-value pair (`idx` < the node's len) or an\n");
        buf_str(out, c"// edge, the place between two pairs (`idx` <= len; in a leaf, where an\n");
        buf_str(out, c"// insertion goes). A handle is valid until the tree changes, except the\n");
        buf_str(out, c"// one `insert_at` and `search` return for the next step.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Insertion splits a full node around its middle (Rust's split points)\n");
        buf_str(out, c"// and passes the middle pair up, growing a new root at the top. Removal\n");
        buf_str(out, c"// swaps a pair of an internal node with its predecessor, a leaf's last,\n");
        buf_str(out, c"// and removes it there; a node left with fewer than 5 pairs takes one\n");
        buf_str(out, c"// from a sibling or merges with it (through the pair between them in the\n");
        buf_str(out, c"// parent), up the tree, and an empty root gives way to its only child.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Safety: the methods taking a handle are `unsafe fn`: the caller\n");
        buf_str(out, c"// guarantees that the handle comes from this tree with no change to it\n");
        buf_str(out, c"// since (BTreeMap and BTreeSet keep to that). Nodes come only from\n");
        buf_str(out, c"// `node_alloc`; every pointer followed below\n");
        buf_str(out, c"// is the root, a child below its node's len + 1, or a parent, all live;\n");
        buf_str(out, c"// every key and value read is below its node's len (initialized). Node\n");
        buf_str(out, c"// fields are reached through raw pointers in `unsafe` blocks; the arrays\n");
        buf_str(out, c"// are indexed with checks; `read_key`, `read_val` and `write_val` check\n");
        buf_str(out, c"// that a handle is a pair.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Allocator, Drop, Eq, Gpa, Iterator, Option, drop, needs_drop, panic};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- B-tree nodes (0.20 implementation) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The pairs of a node, at most (2B - 1).\n");
        buf_str(out, c"pub const BTREE_CAPACITY: i64 = 11;\n");
        buf_str(out, c"// The pairs of a node other than the root, at least (B - 1).\n");
        buf_str(out, c"const BTREE_MIN_LEN: i64 = 5;\n");
        buf_str(out, c"// More than the height of any tree (6^40 pairs): the bound of the loops\n");
        buf_str(out, c"// that climb or descend it.\n");
        buf_str(out, c"const BTREE_MAX_HEIGHT: i64 = 64;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A leaf; also the first part of an internal node (repr(C): an internal\n");
        buf_str(out, c"// node's pointer is its leaf part's).\n");
        buf_str(out, c"#[repr(C)]\n");
        buf_str(out, c"pub struct BLeaf<K, V> {\n");
        buf_str(out, c"    parent: *BInternal<K, V>,\n");
        buf_str(out, c"    // its index among its parent's edges\n");
        buf_str(out, c"    parent_idx: i32,\n");
        buf_str(out, c"    len: i32,\n");
        buf_str(out, c"    keys: [K; 11],\n");
        buf_str(out, c"    vals: [V; 11],\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[repr(C)]\n");
        buf_str(out, c"pub struct BInternal<K, V> {\n");
        buf_str(out, c"    data: BLeaf<K, V>,\n");
        buf_str(out, c"    edges: [*BLeaf<K, V>; 12],\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A position in the tree: pair or edge `idx` of `node`, at `height` (0:\n");
        buf_str(out, c"// a leaf).\n");
        buf_str(out, c"pub struct BHandle<K, V> {\n");
        buf_str(out, c"    node: *BLeaf<K, V>,\n");
        buf_str(out, c"    height: i64,\n");
        buf_str(out, c"    idx: i64,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct BTreeRaw<K, V, A: Allocator = Gpa> {\n");
        buf_str(out, c"    // null for an empty tree\n");
        buf_str(out, c"    root: *BLeaf<K, V>,\n");
        buf_str(out, c"    // the root's height (leaves are 0)\n");
        buf_str(out, c"    height: i64,\n");
        buf_str(out, c"    len: i64,\n");
        buf_str(out, c"    alloc: A,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K, V> BHandle<K, V> {\n");
        buf_str(out, c"    // The handle of nothing: what a search of an empty tree, or a step\n");
        buf_str(out, c"    // past the end, gives.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn none() -> BHandle<K, V> {\n");
        buf_str(out, c"        BHandle { node: 0 as *BLeaf<K, V>, height: 0, idx: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn is_none(self) -> bool {\n");
        buf_str(out, c"        self.node == 0 as *BLeaf<K, V>\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Stops the program unless self is a pair of a node.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn check_kv(self) {\n");
        buf_str(out, c"        if self.node == 0 as *BLeaf<K, V> || self.idx < 0\n");
        buf_str(out, c"            || self.idx >= unsafe { bt_len(self.node) } {\n");
        buf_str(out, c"            unsafe { panic(c\"BTreeRaw: the handle is not a key-value pair\") }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The pair after leaf edge self, or none at the end.\n");
        buf_str(out, c"    pub unsafe fn next_kv(sink self) -> BHandle<K, V> {\n");
        buf_str(out, c"        let e = self;\n");
        buf_str(out, c"        if e.node == 0 as *BLeaf<K, V> {\n");
        buf_str(out, c"            return e;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var n = e.node;\n");
        buf_str(out, c"        var h = e.height;\n");
        buf_str(out, c"        var i = e.idx;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            for _ in 0..BTREE_MAX_HEIGHT {\n");
        buf_str(out, c"                if i < bt_len(n) {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let p = n.parent as *BLeaf<K, V>;\n");
        buf_str(out, c"                if p == 0 as *BLeaf<K, V> {\n");
        buf_str(out, c"                    return BHandle::none();\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                i = n.parent_idx as i64;\n");
        buf_str(out, c"                n = p;\n");
        buf_str(out, c"                h += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        BHandle { node: n, height: h, idx: i }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The pair before leaf edge self, or none at the start.\n");
        buf_str(out, c"    pub unsafe fn next_back_kv(sink self) -> BHandle<K, V> {\n");
        buf_str(out, c"        let e = self;\n");
        buf_str(out, c"        if e.node == 0 as *BLeaf<K, V> {\n");
        buf_str(out, c"            return e;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var n = e.node;\n");
        buf_str(out, c"        var h = e.height;\n");
        buf_str(out, c"        var i = e.idx;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            for _ in 0..BTREE_MAX_HEIGHT {\n");
        buf_str(out, c"                if i != 0 {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let p = n.parent as *BLeaf<K, V>;\n");
        buf_str(out, c"                if p == 0 as *BLeaf<K, V> {\n");
        buf_str(out, c"                    return BHandle::none();\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                i = n.parent_idx as i64;\n");
        buf_str(out, c"                n = p;\n");
        buf_str(out, c"                h += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        BHandle { node: n, height: h, idx: i - 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The leaf edge just after pair self (checked).\n");
        buf_str(out, c"    pub unsafe fn next_leaf_edge(sink self) -> BHandle<K, V> {\n");
        buf_str(out, c"        let kv = self;\n");
        buf_str(out, c"        kv.check_kv();\n");
        buf_str(out, c"        if kv.height == 0 {\n");
        buf_str(out, c"            return BHandle { node: kv.node, height: 0, idx: kv.idx + 1 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        BHandle {\n");
        buf_str(out, c"            node: unsafe { bt_first_leaf(bt_edge(kv.node, kv.idx + 1), kv.height - 1) }, height: 0,\n");
        buf_str(out, c"            idx: 0\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The leaf edge just before pair self (checked).\n");
        buf_str(out, c"    pub unsafe fn prev_leaf_edge(sink self) -> BHandle<K, V> {\n");
        buf_str(out, c"        let kv = self;\n");
        buf_str(out, c"        kv.check_kv();\n");
        buf_str(out, c"        if kv.height == 0 {\n");
        buf_str(out, c"            return BHandle { node: kv.node, height: 0, idx: kv.idx };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let n = unsafe { bt_last_leaf(bt_edge(kv.node, kv.idx), kv.height - 1) };\n");
        buf_str(out, c"        BHandle { node: n, height: 0, idx: unsafe { bt_len(n) } }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K, V> Eq for BHandle<K, V> {\n");
        buf_str(out, c"    fn eq(self, other: BHandle<K, V>) -> bool {\n");
        buf_str(out, c"        self.node == other.node && self.idx == other.idx\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (the node of a handle as an internal node, and its fields: raw)\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn bt_int<K, V>(n: *BLeaf<K, V>) -> *BInternal<K, V> {\n");
        buf_str(out, c"    n as *BInternal<K, V>\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn bt_len<K, V>(n: *BLeaf<K, V>) -> i64 {\n");
        buf_str(out, c"    n.len as i64\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn bt_edge<K, V>(n: *BLeaf<K, V>, i: i64) -> *BLeaf<K, V> {\n");
        buf_str(out, c"    bt_int(n).edges[i]\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sets edge i of internal node n to child c, and c's parent link.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn bt_set_edge<K, V>(n: *BLeaf<K, V>, i: i64, c: *BLeaf<K, V>) {\n");
        buf_str(out, c"    bt_int(n).edges[i] = c;\n");
        buf_str(out, c"    c.parent = bt_int(n);\n");
        buf_str(out, c"    c.parent_idx = i as i32;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The leftmost leaf of the subtree of n, at height h.\n");
        buf_str(out, c"unsafe fn bt_first_leaf<K, V>(n: *BLeaf<K, V>, h: i64) -> *BLeaf<K, V> {\n");
        buf_str(out, c"    var m = n;\n");
        buf_str(out, c"    for _ in 0..h {\n");
        buf_str(out, c"        m = bt_edge(m, 0);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    m\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The rightmost leaf of the subtree of n, at height h.\n");
        buf_str(out, c"unsafe fn bt_last_leaf<K, V>(n: *BLeaf<K, V>, h: i64) -> *BLeaf<K, V> {\n");
        buf_str(out, c"    var m = n;\n");
        buf_str(out, c"    for _ in 0..h {\n");
        buf_str(out, c"        m = bt_edge(m, bt_len(m));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    m\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K, V, A: Allocator> BTreeRaw<K, V, A> {\n");
        buf_str(out, c"    // An empty tree on allocator a; it allocates at the first insertion.\n");
        buf_str(out, c"    pub fn new_in(a: sink A) -> BTreeRaw<K, V, A> {\n");
        buf_str(out, c"        BTreeRaw { root: 0 as *BLeaf<K, V>, height: 0, len: 0, alloc: a }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn len(self) -> i64 {\n");
        buf_str(out, c"        self.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn is_empty(self) -> bool {\n");
        buf_str(out, c"        self.len == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The height of the root (0: one leaf, or none).\n");
        buf_str(out, c"    pub fn height(self) -> i64 {\n");
        buf_str(out, c"        self.height\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn allocator(self) -> A {\n");
        buf_str(out, c"        self.alloc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A new empty node of height h (a leaf when 0).\n");
        buf_str(out, c"    fn node_alloc(inout self, h: i64) -> *BLeaf<K, V> {\n");
        buf_str(out, c"        let n = if h == 0 {\n");
        buf_str(out, c"            self.alloc.alloc(size_of(BLeaf<K, V>), align_of(BLeaf<K, V>)) as *BLeaf<K, V>\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.alloc.alloc(size_of(BInternal<K, V>), align_of(BInternal<K, V>)) as *BLeaf<K, V>\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            n.parent = 0 as *BInternal<K, V>;\n");
        buf_str(out, c"            n.parent_idx = 0;\n");
        buf_str(out, c"            n.len = 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        n\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Gives back node n of height h.\n");
        buf_str(out, c"    unsafe fn node_free(inout self, n: *BLeaf<K, V>, h: i64) {\n");
        buf_str(out, c"        if h == 0 {\n");
        buf_str(out, c"            self.alloc.free(n as *u8, size_of(BLeaf<K, V>), align_of(BLeaf<K, V>));\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.alloc.free(n as *u8, size_of(BInternal<K, V>), align_of(BInternal<K, V>));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The pair whose key cmp finds equal, as (true, its handle), else\n");
        buf_str(out, c"    // (false, the leaf edge where it would be inserted): one descent,\n");
        buf_str(out, c"    // each node searched linearly. An empty tree gives (false, none).\n");
        buf_str(out, c"    pub fn search<F: FnMut(let K) -> i64>(self, cmp: sink F) -> (bool, BHandle<K, V>) {\n");
        buf_str(out, c"        var n = self.root;\n");
        buf_str(out, c"        if n == 0 as *BLeaf<K, V> {\n");
        buf_str(out, c"            return (false, BHandle::none());\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var h = self.height;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            for _ in 0..self.height + 1 {\n");
        buf_str(out, c"                let len = bt_len(n);\n");
        buf_str(out, c"                var i = 0;\n");
        buf_str(out, c"                for _ in 0..len {\n");
        buf_str(out, c"                    let c = cmp(*(&n.keys[i] as *K));\n");
        buf_str(out, c"                    if c == 0 {\n");
        buf_str(out, c"                        return (true, BHandle { node: n, height: h, idx: i });\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    if c < 0 {\n");
        buf_str(out, c"                        break;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    i += 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if h == 0 {\n");
        buf_str(out, c"                    return (false, BHandle { node: n, height: 0, idx: i });\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                n = bt_edge(n, i);\n");
        buf_str(out, c"                h -= 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        (false, BHandle::none())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Stops the program unless h is a pair.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn check_kv(self, h: BHandle<K, V>) {\n");
        buf_str(out, c"        h.check_kv();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The key of pair h (checked).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub unsafe fn read_key(self, h: sink BHandle<K, V>) -> K {\n");
        buf_str(out, c"        self.check_kv(h);\n");
        buf_str(out, c"        unsafe { h.node.keys[h.idx] }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The value of pair h (checked).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub unsafe fn read_val(self, h: sink BHandle<K, V>) -> V {\n");
        buf_str(out, c"        self.check_kv(h);\n");
        buf_str(out, c"        unsafe { h.node.vals[h.idx] }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Replaces the value of pair h (checked).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub unsafe fn write_val(inout self, h: sink BHandle<K, V>, v: sink V) {\n");
        buf_str(out, c"        self.check_kv(h);\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            h.node.vals[h.idx] = v;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A pointer to the value of pair h (checked); raw, valid until the\n");
        buf_str(out, c"    // tree changes.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub unsafe fn val_ptr(self, h: sink BHandle<K, V>) -> *V {\n");
        buf_str(out, c"        self.check_kv(h);\n");
        buf_str(out, c"        unsafe { &h.node.vals[h.idx] }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Inserts the pair (k, v) at leaf edge `edge` (from `search`, which\n");
        buf_str(out, c"    // found no equal key, with no change to the tree since); returns the\n");
        buf_str(out, c"    // handle of the new pair.\n");
        buf_str(out, c"    pub unsafe fn insert_at(inout self, edge: sink BHandle<K, V>, k: sink K, v: sink V) -> BHandle<K, V> {\n");
        buf_str(out, c"        if self.root == 0 as *BLeaf<K, V> {\n");
        buf_str(out, c"            let n = self.node_alloc(0);\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                n.keys[0] = k;\n");
        buf_str(out, c"                n.vals[0] = v;\n");
        buf_str(out, c"                n.len = 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.root = n;\n");
        buf_str(out, c"            self.height = 0;\n");
        buf_str(out, c"            self.len = 1;\n");
        buf_str(out, c"            return BHandle { node: n, height: 0, idx: 0 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if edge.node == 0 as *BLeaf<K, V> || edge.height != 0 || edge.idx < 0\n");
        buf_str(out, c"            || edge.idx > unsafe { bt_len(edge.node) } {\n");
        buf_str(out, c"            unsafe { panic(c\"BTreeRaw::insert_at: the handle is not a leaf edge\") }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len += 1;\n");
        buf_str(out, c"        let leaf = edge.node;\n");
        buf_str(out, c"        let at = edge.idx;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            if bt_len(leaf) < BTREE_CAPACITY {\n");
        buf_str(out, c"                bt_insert_fit(leaf, at, k, v);\n");
        buf_str(out, c"                return BHandle { node: leaf, height: 0, idx: at };\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            // (full: split, then the middle pair and the new right node\n");
        buf_str(out, c"            // go up)\n");
        buf_str(out, c"            let (mid, place) = bt_splitpoint(at);\n");
        buf_str(out, c"            let right = self.node_alloc(0);\n");
        buf_str(out, c"            let (mk, mv) = bt_split_kvs(leaf, right, mid);\n");
        buf_str(out, c"            let result = if place < 0 {\n");
        buf_str(out, c"                bt_insert_fit(leaf, at, k, v);\n");
        buf_str(out, c"                BHandle { node: leaf, height: 0, idx: at }\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                bt_insert_fit(right, place, k, v);\n");
        buf_str(out, c"                BHandle { node: right, height: 0, idx: place }\n");
        buf_str(out, c"            };\n");
        buf_str(out, c"            self.insert_up(leaf, 0, mk, mv, right);\n");
        buf_str(out, c"            result\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Puts pair (k, v) and the node `right` (of height h) into the parent\n");
        buf_str(out, c"    // of `left` (h), just after left, splitting full parents up to a new\n");
        buf_str(out, c"    // root.\n");
        buf_str(out, c"    unsafe fn insert_up(inout self, left: *BLeaf<K, V>, h: i64, k: sink K, v: sink V,\n");
        buf_str(out, c"        right: *BLeaf<K, V>) {\n");
        buf_str(out, c"        var l = left;\n");
        buf_str(out, c"        var r = right;\n");
        buf_str(out, c"        var kk = k;\n");
        buf_str(out, c"        var vv = v;\n");
        buf_str(out, c"        var height = h;\n");
        buf_str(out, c"        for _ in 0..BTREE_MAX_HEIGHT {\n");
        buf_str(out, c"            let p = l.parent as *BLeaf<K, V>;\n");
        buf_str(out, c"            if p == 0 as *BLeaf<K, V> {\n");
        buf_str(out, c"                // (l was the root: a new root over l and r)\n");
        buf_str(out, c"                let root = self.node_alloc(height + 1);\n");
        buf_str(out, c"                root.keys[0] = kk;\n");
        buf_str(out, c"                root.vals[0] = vv;\n");
        buf_str(out, c"                root.len = 1;\n");
        buf_str(out, c"                bt_set_edge(root, 0, l);\n");
        buf_str(out, c"                bt_set_edge(root, 1, r);\n");
        buf_str(out, c"                self.root = root;\n");
        buf_str(out, c"                self.height = height + 1;\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let at = l.parent_idx as i64;\n");
        buf_str(out, c"            if bt_len(p) < BTREE_CAPACITY {\n");
        buf_str(out, c"                bt_insert_fit_internal(p, at, kk, vv, r);\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let (mid, place) = bt_splitpoint(at);\n");
        buf_str(out, c"            let pr = self.node_alloc(height + 1);\n");
        buf_str(out, c"            let (mk, mv) = bt_split_kvs(p, pr, mid);\n");
        buf_str(out, c"            // (the edges after the middle pair move to the new node)\n");
        buf_str(out, c"            let plen = bt_len(pr);\n");
        buf_str(out, c"            for j in 0..plen + 1 {\n");
        buf_str(out, c"                bt_set_edge(pr, j, bt_edge(p, mid + 1 + j));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if place < 0 {\n");
        buf_str(out, c"                bt_insert_fit_internal(p, at, kk, vv, r);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                bt_insert_fit_internal(pr, place, kk, vv, r);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            l = p;\n");
        buf_str(out, c"            r = pr;\n");
        buf_str(out, c"            kk = mk;\n");
        buf_str(out, c"            vv = mv;\n");
        buf_str(out, c"            height += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes pair h (checked) and returns it.\n");
        buf_str(out, c"    pub unsafe fn remove_kv(inout self, h: sink BHandle<K, V>) -> (K, V) {\n");
        buf_str(out, c"        self.check_kv(h);\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            var leaf = h.node;\n");
        buf_str(out, c"            var idx = h.idx;\n");
        buf_str(out, c"            if h.height > 0 {\n");
        buf_str(out, c"                // (its predecessor, the last pair of the left subtree's\n");
        buf_str(out, c"                // last leaf, takes its place; then that leaf loses its\n");
        buf_str(out, c"                // last pair, the one removed)\n");
        buf_str(out, c"                let pred = bt_last_leaf(bt_edge(h.node, h.idx), h.height - 1);\n");
        buf_str(out, c"                let pi = bt_len(pred) - 1;\n");
        buf_str(out, c"                let k = h.node.keys[h.idx];\n");
        buf_str(out, c"                let v = h.node.vals[h.idx];\n");
        buf_str(out, c"                h.node.keys[h.idx] = pred.keys[pi];\n");
        buf_str(out, c"                h.node.vals[h.idx] = pred.vals[pi];\n");
        buf_str(out, c"                pred.keys[pi] = k;\n");
        buf_str(out, c"                pred.vals[pi] = v;\n");
        buf_str(out, c"                leaf = pred;\n");
        buf_str(out, c"                idx = pi;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let k = leaf.keys[idx];\n");
        buf_str(out, c"            let v = leaf.vals[idx];\n");
        buf_str(out, c"            let len = bt_len(leaf);\n");
        buf_str(out, c"            for j in idx..len - 1 {\n");
        buf_str(out, c"                leaf.keys[j] = leaf.keys[j + 1];\n");
        buf_str(out, c"                leaf.vals[j] = leaf.vals[j + 1];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            leaf.len = (len - 1) as i32;\n");
        buf_str(out, c"            self.len -= 1;\n");
        buf_str(out, c"            self.rebalance(leaf, 0);\n");
        buf_str(out, c"            (k, v)\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Restores the minimum length from node n (height h) up: a node below\n");
        buf_str(out, c"    // it takes a pair from a sibling or merges with it; an empty root\n");
        buf_str(out, c"    // gives way to its child, or the tree becomes empty.\n");
        buf_str(out, c"    unsafe fn rebalance(inout self, node: *BLeaf<K, V>, height: i64) {\n");
        buf_str(out, c"        var n = node;\n");
        buf_str(out, c"        var h = height;\n");
        buf_str(out, c"        for _ in 0..BTREE_MAX_HEIGHT {\n");
        buf_str(out, c"            let p = n.parent as *BLeaf<K, V>;\n");
        buf_str(out, c"            if p == 0 as *BLeaf<K, V> {\n");
        buf_str(out, c"                if bt_len(n) == 0 {\n");
        buf_str(out, c"                    if h > 0 {\n");
        buf_str(out, c"                        let child = bt_edge(n, 0);\n");
        buf_str(out, c"                        child.parent = 0 as *BInternal<K, V>;\n");
        buf_str(out, c"                        child.parent_idx = 0;\n");
        buf_str(out, c"                        self.root = child;\n");
        buf_str(out, c"                        self.height = h - 1;\n");
        buf_str(out, c"                    } else {\n");
        buf_str(out, c"                        self.root = 0 as *BLeaf<K, V>;\n");
        buf_str(out, c"                        self.height = 0;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    self.node_free(n, h);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if bt_len(n) >= BTREE_MIN_LEN {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let i = n.parent_idx as i64;\n");
        buf_str(out, c"            if i > 0 {\n");
        buf_str(out, c"                let left = bt_edge(p, i - 1);\n");
        buf_str(out, c"                if bt_len(left) + 1 + bt_len(n) <= BTREE_CAPACITY {\n");
        buf_str(out, c"                    self.merge(p, i - 1, h);\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    bt_steal_left(p, i, h);\n");
        buf_str(out, c"                    return;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                let right = bt_edge(p, 1);\n");
        buf_str(out, c"                if bt_len(n) + 1 + bt_len(right) <= BTREE_CAPACITY {\n");
        buf_str(out, c"                    self.merge(p, 0, h);\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    bt_steal_right(p, 0, h);\n");
        buf_str(out, c"                    return;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            n = p;\n");
        buf_str(out, c"            h += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Merges children i and i + 1 of internal node p (their height h) and\n");
        buf_str(out, c"    // the pair between them into child i; frees child i + 1.\n");
        buf_str(out, c"    unsafe fn merge(inout self, p: *BLeaf<K, V>, i: i64, h: i64) {\n");
        buf_str(out, c"        let l = bt_edge(p, i);\n");
        buf_str(out, c"        let r = bt_edge(p, i + 1);\n");
        buf_str(out, c"        let ll = bt_len(l);\n");
        buf_str(out, c"        let rl = bt_len(r);\n");
        buf_str(out, c"        l.keys[ll] = p.keys[i];\n");
        buf_str(out, c"        l.vals[ll] = p.vals[i];\n");
        buf_str(out, c"        for j in 0..rl {\n");
        buf_str(out, c"            l.keys[ll + 1 + j] = r.keys[j];\n");
        buf_str(out, c"            l.vals[ll + 1 + j] = r.vals[j];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if h > 0 {\n");
        buf_str(out, c"            for j in 0..rl + 1 {\n");
        buf_str(out, c"                bt_set_edge(l, ll + 1 + j, bt_edge(r, j));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        l.len = (ll + 1 + rl) as i32;\n");
        buf_str(out, c"        let pl = bt_len(p);\n");
        buf_str(out, c"        for j in i..pl - 1 {\n");
        buf_str(out, c"            p.keys[j] = p.keys[j + 1];\n");
        buf_str(out, c"            p.vals[j] = p.vals[j + 1];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for j in i + 1..pl {\n");
        buf_str(out, c"            bt_set_edge(p, j, bt_edge(p, j + 1));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        p.len = (pl - 1) as i32;\n");
        buf_str(out, c"        self.node_free(r, h);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The leaf edge before the first pair, or none.\n");
        buf_str(out, c"    pub fn first_leaf_edge(self) -> BHandle<K, V> {\n");
        buf_str(out, c"        if self.root == 0 as *BLeaf<K, V> {\n");
        buf_str(out, c"            return BHandle::none();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        BHandle { node: unsafe { bt_first_leaf(self.root, self.height) }, height: 0, idx: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The leaf edge after the last pair, or none.\n");
        buf_str(out, c"    pub fn last_leaf_edge(self) -> BHandle<K, V> {\n");
        buf_str(out, c"        if self.root == 0 as *BLeaf<K, V> {\n");
        buf_str(out, c"            return BHandle::none();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let n = unsafe { bt_last_leaf(self.root, self.height) };\n");
        buf_str(out, c"        BHandle { node: n, height: 0, idx: unsafe { bt_len(n) } }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The leaf edge before the first pair whose key is not below a bound\n");
        buf_str(out, c"    // (cmp compares the bound with a key); with `strict`, before the first\n");
        buf_str(out, c"    // pair whose key is above it. A range search is two: the pairs of\n");
        buf_str(out, c"    // a..b lie from lower_edge(a, false) to lower_edge(b, false) (a..=b:\n");
        buf_str(out, c"    // to lower_edge(b, true)), stepped through with the handles' next_kv\n");
        buf_str(out, c"    // and next_leaf_edge until the front edge is the back one.\n");
        buf_str(out, c"    pub fn lower_edge<F: FnMut(let K) -> i64>(self, cmp: sink F, strict: bool) -> BHandle<K, V> {\n");
        buf_str(out, c"        var n = self.root;\n");
        buf_str(out, c"        if n == 0 as *BLeaf<K, V> {\n");
        buf_str(out, c"            return BHandle::none();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var h = self.height;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            for _ in 0..self.height + 1 {\n");
        buf_str(out, c"                let len = bt_len(n);\n");
        buf_str(out, c"                var i = 0;\n");
        buf_str(out, c"                for _ in 0..len {\n");
        buf_str(out, c"                    let c = cmp(*(&n.keys[i] as *K));\n");
        buf_str(out, c"                    if c < 0 || (c == 0 && !strict) {\n");
        buf_str(out, c"                        break;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    i += 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if h == 0 {\n");
        buf_str(out, c"                    return BHandle { node: n, height: 0, idx: i };\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                n = bt_edge(n, i);\n");
        buf_str(out, c"                h -= 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        BHandle::none()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The pairs in order (copies), from both ends: a view of the tree.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn iter(self) -> BTreeIter<K, V, A> {\n");
        buf_str(out, c"        BTreeIter { tree: self, front: self.first_leaf_edge(), back: self.last_leaf_edge() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The pairs between leaf edges front and back (front first, as\n");
        buf_str(out, c"    // lower_edge gives them): a view of the tree. The caller guarantees\n");
        buf_str(out, c"    // that both come from this tree with no change since.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub unsafe fn iter_between(self, front: sink BHandle<K, V>, back: sink BHandle<K, V>) -> BTreeIter<K, V, A> {\n");
        buf_str(out, c"        BTreeIter { tree: self, front: front, back: back }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Frees every node (post-order, through the parent links: no\n");
        buf_str(out, c"    // recursion, no stack); the tree is empty, and may be used again.\n");
        buf_str(out, c"    pub fn free(inout self) {\n");
        buf_str(out, c"        if self.root == 0 as *BLeaf<K, V> {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            var n = bt_first_leaf(self.root, self.height);\n");
        buf_str(out, c"            var h = 0;\n");
        buf_str(out, c"            // (one node freed a round; a node holds a pair at least)\n");
        buf_str(out, c"            for _ in 0..self.len + 1 {\n");
        buf_str(out, c"                let p = n.parent as *BLeaf<K, V>;\n");
        buf_str(out, c"                let i = n.parent_idx as i64;\n");
        buf_str(out, c"                if needs_drop::<K>() || needs_drop::<V>() {\n");
        buf_str(out, c"                    for j in 0..bt_len(n) {\n");
        buf_str(out, c"                        drop(n.keys[j]);\n");
        buf_str(out, c"                        drop(n.vals[j]);\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.node_free(n, h);\n");
        buf_str(out, c"                if p == 0 as *BLeaf<K, V> {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                n = p;\n");
        buf_str(out, c"                h += 1;\n");
        buf_str(out, c"                if i < bt_len(n) {\n");
        buf_str(out, c"                    // (the next child's subtree, from its first leaf)\n");
        buf_str(out, c"                    n = bt_first_leaf(bt_edge(n, i + 1), h - 1);\n");
        buf_str(out, c"                    h = 0;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.root = 0 as *BLeaf<K, V>;\n");
        buf_str(out, c"        self.height = 0;\n");
        buf_str(out, c"        self.len = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // (tests) The tree's invariants: \"\" when they hold, else the first\n");
        buf_str(out, c"    // broken. Lengths (5 to 11 below the root, 1 to 11 at it), parent\n");
        buf_str(out, c"    // links, every leaf at the same depth, keys in increasing order\n");
        buf_str(out, c"    // (`less(a, b)`: a's key below b's), the count.\n");
        buf_str(out, c"    pub fn check<F: FnMut(let K, let K) -> bool>(self, less: sink F) -> [u8] {\n");
        buf_str(out, c"        if self.root == 0 as *BLeaf<K, V> {\n");
        buf_str(out, c"            return if self.len == 0 { \"\" } else { \"an empty tree has a length\" };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            if self.root.parent != 0 as *BInternal<K, V> {\n");
        buf_str(out, c"                return \"the root has a parent\";\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            // (every pair in order, through the leaf edges; each node's\n");
        buf_str(out, c"            // checks at its first pair, or at its leaf edge when empty)\n");
        buf_str(out, c"            var count = 0;\n");
        buf_str(out, c"            var e = self.first_leaf_edge();\n");
        buf_str(out, c"            var prev: BHandle<K, V> = BHandle::none();\n");
        buf_str(out, c"            for _ in 0..self.len + 1 {\n");
        buf_str(out, c"                if e.node.len == 0 && e.node != self.root {\n");
        buf_str(out, c"                    return \"an empty node below the root\";\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let kv = e.next_kv();\n");
        buf_str(out, c"                if kv.is_none() {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let n = kv.node;\n");
        buf_str(out, c"                let len = bt_len(n);\n");
        buf_str(out, c"                if len > BTREE_CAPACITY || (n != self.root && len < BTREE_MIN_LEN) || len < 1 {\n");
        buf_str(out, c"                    return \"a node's length is out of bounds\";\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if kv.height > 0 {\n");
        buf_str(out, c"                    for j in 0..len + 1 {\n");
        buf_str(out, c"                        let c = bt_edge(n, j);\n");
        buf_str(out, c"                        if c.parent as *BLeaf<K, V> != n || c.parent_idx as i64 != j {\n");
        buf_str(out, c"                            return \"a child's parent link is wrong\";\n");
        buf_str(out, c"                        }\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if !prev.is_none()\n");
        buf_str(out, c"                    && !less(*(&prev.node.keys[prev.idx] as *K), *(&n.keys[kv.idx] as *K)) {\n");
        buf_str(out, c"                    return \"keys out of order\";\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                // (the depth of every leaf is the root's height)\n");
        buf_str(out, c"                var d = 0;\n");
        buf_str(out, c"                var m = e.node;\n");
        buf_str(out, c"                for _ in 0..BTREE_MAX_HEIGHT {\n");
        buf_str(out, c"                    if m.parent == 0 as *BInternal<K, V> {\n");
        buf_str(out, c"                        break;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    m = m.parent as *BLeaf<K, V>;\n");
        buf_str(out, c"                    d += 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                if d != self.height || e.height != 0 {\n");
        buf_str(out, c"                    return \"a leaf is not at the bottom\";\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                count += 1;\n");
        buf_str(out, c"                prev = kv;\n");
        buf_str(out, c"                e = kv.next_leaf_edge();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if count != self.len {\n");
        buf_str(out, c"                return \"the length is not the number of pairs\";\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        \"\"\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The tree's drop: its pairs' drops, then its nodes given back.\n");
        buf_str(out, c"impl<K, V, A: Allocator> Drop for BTreeRaw<K, V, A> {\n");
        buf_str(out, c"    fn drop(inout self) {\n");
        buf_str(out, c"        self.free();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The pairs of a tree in order, as (key, value) copies (`iter`,\n");
        buf_str(out, c"// `iter_between`); both ends move (`next`, `next_back`) until they meet.\n");
        buf_str(out, c"// A view of the tree: its handles stay valid while it lives.\n");
        buf_str(out, c"pub struct BTreeIter<K, V, A: Allocator> {\n");
        buf_str(out, c"    tree: let BTreeRaw<K, V, A>,\n");
        buf_str(out, c"    front: BHandle<K, V>,\n");
        buf_str(out, c"    back: BHandle<K, V>,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K, V, A: Allocator> BTreeIter<K, V, A> {\n");
        buf_str(out, c"    // The last pair not yet given, or none.\n");
        buf_str(out, c"    pub fn next_back(inout self) -> Option<(K, V)> {\n");
        buf_str(out, c"        if self.front == self.back || self.back.is_none() {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // (the handles are the viewed tree's, which cannot change)\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let kv = self.back.next_back_kv();\n");
        buf_str(out, c"            self.back = kv.prev_leaf_edge();\n");
        buf_str(out, c"            Option::Some((kv.node.keys[kv.idx], kv.node.vals[kv.idx]))\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K, V, A: Allocator> Iterator for BTreeIter<K, V, A> {\n");
        buf_str(out, c"    type Item = (K, V);\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn next(inout self) -> Option<(K, V)> {\n");
        buf_str(out, c"        if self.front == self.back || self.front.is_none() {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // (the handles are the viewed tree's, which cannot change)\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let kv = self.front.next_kv();\n");
        buf_str(out, c"            self.front = kv.next_leaf_edge();\n");
        buf_str(out, c"            Option::Some((kv.node.keys[kv.idx], kv.node.vals[kv.idx]))\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Rust's split points: splitting a full node to insert at edge `at`, the\n");
        buf_str(out, c"// pair that goes up (`mid`) and where the insertion goes: edge `at` of\n");
        buf_str(out, c"// the left node (-1), or the edge of the right node (>= 0).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn bt_splitpoint(at: i64) -> (i64, i64) {\n");
        buf_str(out, c"    if at < 5 {\n");
        buf_str(out, c"        (4, -1)\n");
        buf_str(out, c"    } else if at == 5 {\n");
        buf_str(out, c"        (5, -1)\n");
        buf_str(out, c"    } else if at == 6 {\n");
        buf_str(out, c"        (5, 0)\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        (6, at - 7)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Moves the pairs after `mid` of full node n into the empty node r and\n");
        buf_str(out, c"// returns pair mid; n keeps the pairs before it.\n");
        buf_str(out, c"unsafe fn bt_split_kvs<K, V>(n: *BLeaf<K, V>, r: *BLeaf<K, V>, mid: i64) -> (K, V) {\n");
        buf_str(out, c"    let len = bt_len(n);\n");
        buf_str(out, c"    let rl = len - mid - 1;\n");
        buf_str(out, c"    for j in 0..rl {\n");
        buf_str(out, c"        r.keys[j] = n.keys[mid + 1 + j];\n");
        buf_str(out, c"        r.vals[j] = n.vals[mid + 1 + j];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    r.len = rl as i32;\n");
        buf_str(out, c"    n.len = mid as i32;\n");
        buf_str(out, c"    (n.keys[mid], n.vals[mid])\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Inserts (k, v) at edge `at` of leaf n, which has room.\n");
        buf_str(out, c"unsafe fn bt_insert_fit<K, V>(n: *BLeaf<K, V>, at: i64, k: sink K, v: sink V) {\n");
        buf_str(out, c"    let len = bt_len(n);\n");
        buf_str(out, c"    for t in 0..len - at {\n");
        buf_str(out, c"        let j = len - t;\n");
        buf_str(out, c"        n.keys[j] = n.keys[j - 1];\n");
        buf_str(out, c"        n.vals[j] = n.vals[j - 1];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    n.keys[at] = k;\n");
        buf_str(out, c"    n.vals[at] = v;\n");
        buf_str(out, c"    n.len = (len + 1) as i32;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Inserts (k, v) at pair `at` of internal node n, which has room, and\n");
        buf_str(out, c"// child r at edge at + 1.\n");
        buf_str(out, c"unsafe fn bt_insert_fit_internal<K, V>(n: *BLeaf<K, V>, at: i64, k: sink K, v: sink V,\n");
        buf_str(out, c"    r: *BLeaf<K, V>) {\n");
        buf_str(out, c"    let len = bt_len(n);\n");
        buf_str(out, c"    for t in 0..len - at {\n");
        buf_str(out, c"        let j = len + 1 - t;\n");
        buf_str(out, c"        bt_set_edge(n, j, bt_edge(n, j - 1));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    bt_insert_fit(n, at, k, v);\n");
        buf_str(out, c"    bt_set_edge(n, at + 1, r);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Child i of p (height h) takes the last pair of child i - 1 through the\n");
        buf_str(out, c"// pair between them (a rotation to the right).\n");
        buf_str(out, c"unsafe fn bt_steal_left<K, V>(p: *BLeaf<K, V>, i: i64, h: i64) {\n");
        buf_str(out, c"    let l = bt_edge(p, i - 1);\n");
        buf_str(out, c"    let n = bt_edge(p, i);\n");
        buf_str(out, c"    let ll = bt_len(l);\n");
        buf_str(out, c"    let nl = bt_len(n);\n");
        buf_str(out, c"    for t in 0..nl {\n");
        buf_str(out, c"        let j = nl - t;\n");
        buf_str(out, c"        n.keys[j] = n.keys[j - 1];\n");
        buf_str(out, c"        n.vals[j] = n.vals[j - 1];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    n.keys[0] = p.keys[i - 1];\n");
        buf_str(out, c"    n.vals[0] = p.vals[i - 1];\n");
        buf_str(out, c"    p.keys[i - 1] = l.keys[ll - 1];\n");
        buf_str(out, c"    p.vals[i - 1] = l.vals[ll - 1];\n");
        buf_str(out, c"    if h > 0 {\n");
        buf_str(out, c"        for t in 0..nl + 1 {\n");
        buf_str(out, c"            let j = nl + 1 - t;\n");
        buf_str(out, c"            bt_set_edge(n, j, bt_edge(n, j - 1));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        bt_set_edge(n, 0, bt_edge(l, ll));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    l.len = (ll - 1) as i32;\n");
        buf_str(out, c"    n.len = (nl + 1) as i32;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Child i of p (height h) takes the first pair of child i + 1 through the\n");
        buf_str(out, c"// pair between them (a rotation to the left).\n");
        buf_str(out, c"unsafe fn bt_steal_right<K, V>(p: *BLeaf<K, V>, i: i64, h: i64) {\n");
        buf_str(out, c"    let n = bt_edge(p, i);\n");
        buf_str(out, c"    let r = bt_edge(p, i + 1);\n");
        buf_str(out, c"    let nl = bt_len(n);\n");
        buf_str(out, c"    let rl = bt_len(r);\n");
        buf_str(out, c"    n.keys[nl] = p.keys[i];\n");
        buf_str(out, c"    n.vals[nl] = p.vals[i];\n");
        buf_str(out, c"    p.keys[i] = r.keys[0];\n");
        buf_str(out, c"    p.vals[i] = r.vals[0];\n");
        buf_str(out, c"    for j in 0..rl - 1 {\n");
        buf_str(out, c"        r.keys[j] = r.keys[j + 1];\n");
        buf_str(out, c"        r.vals[j] = r.vals[j + 1];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if h > 0 {\n");
        buf_str(out, c"        bt_set_edge(n, nl + 1, bt_edge(r, 0));\n");
        buf_str(out, c"        for j in 0..rl {\n");
        buf_str(out, c"            bt_set_edge(r, j, bt_edge(r, j + 1));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    n.len = (nl + 1) as i32;\n");
        buf_str(out, c"    r.len = (rl - 1) as i32;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::collections::btree_node ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::collections::btree_map ----\n");
        buf_str(out, c"pub mod btree_map {\n");
        buf_str(out, c"// std::collections::btree_map: BTreeMap and BTreeSet (0.20), ordered by\n");
        buf_str(out, c"// their keys' Ord, on the B-tree engine (btree_node.tach).\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Allocator, Ambient, Debug, Drop, Fmt, Gpa, Iterator, Option, Ord};\n");
        buf_str(out, c"use super::btree_node::{BTreeIter, BTreeRaw};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- BTreeMap and BTreeSet (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A map from K to V kept in key order (Rust's BTreeMap: 11 pairs a node,\n");
        buf_str(out, c"// a linear search in each). `iter()` and `range(lo, hi)` give the pairs\n");
        buf_str(out, c"// in order; `first_key_value`, `pop_first` and their `last` forms the\n");
        buf_str(out, c"// ends.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct BTreeMap<K: Ord, V, A: Allocator = Gpa> {\n");
        buf_str(out, c"    tree: BTreeRaw<K, V, A>,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Ord, V, A: Allocator> BTreeMap<K, V, A> {\n");
        buf_str(out, c"    // An empty map on allocator a.\n");
        buf_str(out, c"    pub fn new_in(a: sink A) -> BTreeMap<K, V, A> {\n");
        buf_str(out, c"        BTreeMap { tree: BTreeRaw::new_in(a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn len(self) -> i64 {\n");
        buf_str(out, c"        self.tree.len()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn is_empty(self) -> bool {\n");
        buf_str(out, c"        self.tree.len() == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The value of key, as a copy, if it has one.\n");
        buf_str(out, c"    pub fn get(self, key: sink K) -> Option<V> {\n");
        buf_str(out, c"        let (found, h) = self.tree.search(|k: K| key.cmp(k));\n");
        buf_str(out, c"        // (h: from this search)\n");
        buf_str(out, c"        if found { Option::Some(unsafe { self.tree.read_val(h) }) } else { Option::None }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn contains_key(self, key: sink K) -> bool {\n");
        buf_str(out, c"        self.tree.search(|k: K| key.cmp(k)).0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The value of key in place, a writable view of one element (as\n");
        buf_str(out, c"    // HashMap's get_mut), until the map's next insert or remove.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn get_mut(inout self, key: sink K) -> Option<inout [V]> {\n");
        buf_str(out, c"        let (found, h) = self.tree.search(|k: K| key.cmp(k));\n");
        buf_str(out, c"        if !found {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let p = unsafe { self.tree.val_ptr(h) };\n");
        buf_str(out, c"        Option::Some(unsafe { &p[0..1] })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Sets the value of key; returns its old value, if it had one.\n");
        buf_str(out, c"    #[stores(key, value)]\n");
        buf_str(out, c"    pub fn insert(inout self, key: sink K, value: sink V) -> Option<V> {\n");
        buf_str(out, c"        let (found, h) = self.tree.search(|k: K| key.cmp(k));\n");
        buf_str(out, c"        if found {\n");
        buf_str(out, c"            // (the old value moves out, the new one in)\n");
        buf_str(out, c"            let p = unsafe { self.tree.val_ptr(h) };\n");
        buf_str(out, c"            let old = unsafe { *p };\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                *p = value;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return Option::Some(old);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.tree.insert_at(h, key, value);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::None\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes key; returns its value, if it had one (the stored key is\n");
        buf_str(out, c"    // dropped).\n");
        buf_str(out, c"    pub fn remove(inout self, key: sink K) -> Option<V> {\n");
        buf_str(out, c"        let (found, h) = self.tree.search(|k: K| key.cmp(k));\n");
        buf_str(out, c"        if !found {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let (_, v) = unsafe { self.tree.remove_kv(h) };\n");
        buf_str(out, c"        Option::Some(v)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The smallest key and its value (copies).\n");
        buf_str(out, c"    pub fn first_key_value(self) -> Option<(K, V)> {\n");
        buf_str(out, c"        self.iter().next()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The largest key and its value (copies).\n");
        buf_str(out, c"    pub fn last_key_value(self) -> Option<(K, V)> {\n");
        buf_str(out, c"        self.iter().next_back()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes the pair with the smallest key and returns it.\n");
        buf_str(out, c"    pub fn pop_first(inout self) -> Option<(K, V)> {\n");
        buf_str(out, c"        if self.tree.len() == 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // (the first pair of the tree as it is)\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let kv = self.tree.first_leaf_edge().next_kv();\n");
        buf_str(out, c"            Option::Some(self.tree.remove_kv(kv))\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes the pair with the largest key and returns it.\n");
        buf_str(out, c"    pub fn pop_last(inout self) -> Option<(K, V)> {\n");
        buf_str(out, c"        if self.tree.len() == 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let kv = self.tree.last_leaf_edge().next_back_kv();\n");
        buf_str(out, c"            Option::Some(self.tree.remove_kv(kv))\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The pairs in key order (copies): a view of the map; `next_back`\n");
        buf_str(out, c"    // from the end.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn iter(self) -> BTreeIter<K, V, A> {\n");
        buf_str(out, c"        self.tree.iter()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The pairs whose keys are in [lo, hi), in order (Rust's\n");
        buf_str(out, c"    // `range(lo..hi)`; `range_inclusive` for [lo, hi]).\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn range(self, lo: sink K, hi: sink K) -> BTreeIter<K, V, A> {\n");
        buf_str(out, c"        let front = self.tree.lower_edge(|k: K| lo.cmp(k), false);\n");
        buf_str(out, c"        let back = self.tree.lower_edge(|k: K| hi.cmp(k), false);\n");
        buf_str(out, c"        let ok = !(lo.cmp(hi) > 0);\n");
        buf_str(out, c"        // (both from this tree, as it is)\n");
        buf_str(out, c"        unsafe { self.tree.iter_between(front, if ok { back } else { front }) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The pairs whose keys are in [lo, hi], in order.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn range_inclusive(self, lo: sink K, hi: sink K) -> BTreeIter<K, V, A> {\n");
        buf_str(out, c"        let front = self.tree.lower_edge(|k: K| lo.cmp(k), false);\n");
        buf_str(out, c"        let back = self.tree.lower_edge(|k: K| hi.cmp(k), true);\n");
        buf_str(out, c"        let ok = !(lo.cmp(hi) > 0);\n");
        buf_str(out, c"        unsafe { self.tree.iter_between(front, if ok { back } else { front }) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes every pair (dropped) and gives the memory back.\n");
        buf_str(out, c"    pub fn clear(inout self) {\n");
        buf_str(out, c"        self.tree.free();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The same as clear.\n");
        buf_str(out, c"    pub fn free(inout self) {\n");
        buf_str(out, c"        self.tree.free();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn allocator(self) -> A {\n");
        buf_str(out, c"        self.tree.allocator()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // (tests) The tree's invariants: \"\" when they hold.\n");
        buf_str(out, c"    pub fn check(self) -> [u8] {\n");
        buf_str(out, c"        self.tree.check(|a: K, b: K| a.cmp(b) < 0)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // (tests) The tree's height.\n");
        buf_str(out, c"    pub fn height(self) -> i64 {\n");
        buf_str(out, c"        self.tree.height()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Ord, V, A: Allocator> Drop for BTreeMap<K, V, A> {\n");
        buf_str(out, c"    fn drop(inout self) {\n");
        buf_str(out, c"        self.tree.free();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Ord, V, A: Allocator + Ambient> BTreeMap<K, V, A> {\n");
        buf_str(out, c"    #[ambient(\"BTreeMap::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> BTreeMap<K, V, A> {\n");
        buf_str(out, c"        BTreeMap::new_in(A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `{k: v, ...}` in key order.\n");
        buf_str(out, c"impl<K: Ord + Debug, V: Debug, A: Allocator> Debug for BTreeMap<K, V, A> {\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) {\n");
        buf_str(out, c"        f.byte('{');\n");
        buf_str(out, c"        var first = true;\n");
        buf_str(out, c"        for (k, v) in self.iter() {\n");
        buf_str(out, c"            if !first {\n");
        buf_str(out, c"                f.str(\", \");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            first = false;\n");
        buf_str(out, c"            f.debug(k);\n");
        buf_str(out, c"            f.str(\": \");\n");
        buf_str(out, c"            f.debug(v);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.byte('}');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A set of T kept in order (Rust's BTreeSet), a BTreeMap<T, ()>.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct BTreeSet<T: Ord, A: Allocator = Gpa> {\n");
        buf_str(out, c"    tree: BTreeRaw<T, (), A>,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Ord, A: Allocator> BTreeSet<T, A> {\n");
        buf_str(out, c"    pub fn new_in(a: sink A) -> BTreeSet<T, A> {\n");
        buf_str(out, c"        BTreeSet { tree: BTreeRaw::new_in(a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn len(self) -> i64 {\n");
        buf_str(out, c"        self.tree.len()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn is_empty(self) -> bool {\n");
        buf_str(out, c"        self.tree.len() == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn contains(self, x: sink T) -> bool {\n");
        buf_str(out, c"        self.tree.search(|k: T| x.cmp(k)).0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Adds x; false when the set had it already (x is dropped then).\n");
        buf_str(out, c"    #[stores(x)]\n");
        buf_str(out, c"    pub fn insert(inout self, x: sink T) -> bool {\n");
        buf_str(out, c"        let (found, h) = self.tree.search(|k: T| x.cmp(k));\n");
        buf_str(out, c"        if found {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.tree.insert_at(h, x, ());\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes x; false when the set did not have it.\n");
        buf_str(out, c"    pub fn remove(inout self, x: sink T) -> bool {\n");
        buf_str(out, c"        let (found, h) = self.tree.search(|k: T| x.cmp(k));\n");
        buf_str(out, c"        if !found {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.tree.remove_kv(h);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The smallest value (a copy).\n");
        buf_str(out, c"    pub fn first(self) -> Option<T> {\n");
        buf_str(out, c"        match self.tree.iter().next() {\n");
        buf_str(out, c"            Option::Some(e) => Option::Some(e.0),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The largest value (a copy).\n");
        buf_str(out, c"    pub fn last(self) -> Option<T> {\n");
        buf_str(out, c"        match self.tree.iter().next_back() {\n");
        buf_str(out, c"            Option::Some(e) => Option::Some(e.0),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn pop_first(inout self) -> Option<T> {\n");
        buf_str(out, c"        if self.tree.len() == 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let kv = self.tree.first_leaf_edge().next_kv();\n");
        buf_str(out, c"            Option::Some(self.tree.remove_kv(kv).0)\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn pop_last(inout self) -> Option<T> {\n");
        buf_str(out, c"        if self.tree.len() == 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let kv = self.tree.last_leaf_edge().next_back_kv();\n");
        buf_str(out, c"            Option::Some(self.tree.remove_kv(kv).0)\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The values in order (copies): a view of the set.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn iter(self) -> BTreeSetIter<T, A> {\n");
        buf_str(out, c"        BTreeSetIter { it: self.tree.iter() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The values in [lo, hi), in order.\n");
        buf_str(out, c"    #[views(self)]\n");
        buf_str(out, c"    pub fn range(self, lo: sink T, hi: sink T) -> BTreeSetIter<T, A> {\n");
        buf_str(out, c"        let front = self.tree.lower_edge(|k: T| lo.cmp(k), false);\n");
        buf_str(out, c"        let back = self.tree.lower_edge(|k: T| hi.cmp(k), false);\n");
        buf_str(out, c"        let ok = !(lo.cmp(hi) > 0);\n");
        buf_str(out, c"        BTreeSetIter { it: unsafe { self.tree.iter_between(front, if ok { back } else { front }) } }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn clear(inout self) {\n");
        buf_str(out, c"        self.tree.free();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn free(inout self) {\n");
        buf_str(out, c"        self.tree.free();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Ord, A: Allocator> Drop for BTreeSet<T, A> {\n");
        buf_str(out, c"    fn drop(inout self) {\n");
        buf_str(out, c"        self.tree.free();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Ord, A: Allocator + Ambient> BTreeSet<T, A> {\n");
        buf_str(out, c"    #[ambient(\"BTreeSet::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> BTreeSet<T, A> {\n");
        buf_str(out, c"        BTreeSet::new_in(A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A set's values in order: a view of the set.\n");
        buf_str(out, c"pub struct BTreeSetIter<T, A: Allocator> {\n");
        buf_str(out, c"    it: BTreeIter<T, (), A>,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, A: Allocator> BTreeSetIter<T, A> {\n");
        buf_str(out, c"    pub fn next_back(inout self) -> Option<T> {\n");
        buf_str(out, c"        match self.it.next_back() {\n");
        buf_str(out, c"            Option::Some(e) => Option::Some(e.0),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, A: Allocator> Iterator for BTreeSetIter<T, A> {\n");
        buf_str(out, c"    type Item = T;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn next(inout self) -> Option<T> {\n");
        buf_str(out, c"        match self.it.next() {\n");
        buf_str(out, c"            Option::Some(e) => Option::Some(e.0),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `{a, b, ...}` in order.\n");
        buf_str(out, c"impl<T: Ord + Debug, A: Allocator> Debug for BTreeSet<T, A> {\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) {\n");
        buf_str(out, c"        f.byte('{');\n");
        buf_str(out, c"        var first = true;\n");
        buf_str(out, c"        for x in self.iter() {\n");
        buf_str(out, c"            if !first {\n");
        buf_str(out, c"                f.str(\", \");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            first = false;\n");
        buf_str(out, c"            f.debug(x);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.byte('}');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::collections::btree_map ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::collections::group ----\n");
        buf_str(out, c"pub mod group {\n");
        buf_str(out, c"// std::collections::group: the control bytes of a Swiss table (0.20).\n");
        buf_str(out, c"// The control bytes of a RawTable (raw_table.tach) are read GROUP at a\n");
        buf_str(out, c"// time and matched all at once: one byte per bucket, EMPTY (0xff),\n");
        buf_str(out, c"// DELETED (0x80) or FULL (0x00-0x7f: the top 7 bits of the hash, its\n");
        buf_str(out, c"// tag). A Group is GROUP control bytes; a BitMask is the result of a\n");
        buf_str(out, c"// match, the top bit of each byte that matched (0x80 lanes, the lowest\n");
        buf_str(out, c"// byte the first bucket). SWAR on a u64 (hashbrown's generic.rs), with\n");
        buf_str(out, c"// match_tag a NEON compare on AArch64 (0.20 D1). GROUP is 8 on every\n");
        buf_str(out, c"// target and in every version, so a table's layout, and its iteration\n");
        buf_str(out, c"// order, is the same everywhere.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{leading_zeros, trailing_zeros};\n");
        buf_str(out, c"use std::arch::has;\n");
        buf_str(out, c"use std::arch::aarch64::{\n");
        buf_str(out, c"    vceq_u8, vdup_n_u64, vdup_n_u8, vget_lane_u64, vreinterpret_u64_u8, vreinterpret_u8_u64,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Swiss-table groups (0.20 implementation) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub type Group = u64;\n");
        buf_str(out, c"pub type BitMask = u64;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Control bytes per group.\n");
        buf_str(out, c"pub const GROUP: i64 = 8;\n");
        buf_str(out, c"// A bucket never used since the table was made or cleared: a search ends\n");
        buf_str(out, c"// at a group that has one.\n");
        buf_str(out, c"pub const CTRL_EMPTY: u8 = 0xff;\n");
        buf_str(out, c"// A bucket whose element was erased (a tombstone): a search goes past it.\n");
        buf_str(out, c"pub const CTRL_DELETED: u8 = 0x80;\n");
        buf_str(out, c"\n");
        buf_str(out, c"const GROUP_LSB: u64 = 0x0101010101010101;\n");
        buf_str(out, c"const GROUP_MSB: u64 = 0x8080808080808080;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The tag of a hash: its top 7 bits, a FULL control byte.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn ctrl_tag(hash: u64) -> u8 {\n");
        buf_str(out, c"    (hash >> 57) as u8\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The GROUP control bytes at ctrl[pos..pos + GROUP] (an unaligned load).\n");
        buf_str(out, c"// The caller guarantees that those bytes are readable.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub unsafe fn group_load(ctrl: *u8, pos: i64) -> Group {\n");
        buf_str(out, c"    // (AArch64 and x86_64, every target of tachyon, load from any address;\n");
        buf_str(out, c"    // the compiler emits one 8-byte load)\n");
        buf_str(out, c"    *(&ctrl[pos] as *u64)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Stores g at ctrl[pos..pos + GROUP]; the caller guarantees that those\n");
        buf_str(out, c"// bytes are writable.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub unsafe fn group_store(ctrl: *u8, pos: i64, g: Group) {\n");
        buf_str(out, c"    *(&ctrl[pos] as *u64) = g;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The buckets of g whose control byte is tag (a FULL byte). (0.20 D1) On\n");
        buf_str(out, c"// AArch64 one NEON compare (cmeq on the 8 bytes): exact. Elsewhere\n");
        buf_str(out, c"// match_tag_swar, which may also report false positives; either way the\n");
        buf_str(out, c"// table's layout is the same (a match only decides which keys are\n");
        buf_str(out, c"// compared).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn match_tag(g: Group, tag: u8) -> BitMask {\n");
        buf_str(out, c"    if has(\"neon\") {\n");
        buf_str(out, c"        let v = vreinterpret_u8_u64(vdup_n_u64(g));\n");
        buf_str(out, c"        let eq = vceq_u8(v, vdup_n_u8(tag));\n");
        buf_str(out, c"        return vget_lane_u64(vreinterpret_u64_u8(eq), 0) & GROUP_MSB;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    match_tag_swar(g, tag)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// match_tag in SWAR on a u64 (hashbrown's generic.rs): may report a false\n");
        buf_str(out, c"// positive, always a FULL byte above a true match, which the caller's key\n");
        buf_str(out, c"// comparison rejects.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn match_tag_swar(g: Group, tag: u8) -> BitMask {\n");
        buf_str(out, c"    let cmp = g ^ (tag as u64 * GROUP_LSB);\n");
        buf_str(out, c"    (cmp - GROUP_LSB) & ~cmp & GROUP_MSB\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The EMPTY buckets of g.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn match_empty(g: Group) -> BitMask {\n");
        buf_str(out, c"    g & (g << 1) & GROUP_MSB\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The EMPTY and DELETED buckets of g: where an insertion may go.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn match_empty_or_deleted(g: Group) -> BitMask {\n");
        buf_str(out, c"    g & GROUP_MSB\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The FULL buckets of g.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn match_full(g: Group) -> BitMask {\n");
        buf_str(out, c"    ~g & GROUP_MSB\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// g with EMPTY and DELETED bytes made EMPTY and FULL ones DELETED: the\n");
        buf_str(out, c"// first step of rehashing a table in place.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn convert_special_to_empty_and_full_to_deleted(g: Group) -> Group {\n");
        buf_str(out, c"    let full = ~g & GROUP_MSB;\n");
        buf_str(out, c"    ~full + (full >> 7)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The first bucket of m (m != 0), 0 to GROUP - 1.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn bitmask_lowest(m: BitMask) -> i64 {\n");
        buf_str(out, c"    trailing_zeros(m) >> 3\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// m without its first bucket.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn bitmask_remove_lowest(m: BitMask) -> BitMask {\n");
        buf_str(out, c"    m & (m - 1)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The buckets before the first of m (GROUP when m is 0).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn bitmask_trailing(m: BitMask) -> i64 {\n");
        buf_str(out, c"    trailing_zeros(m) >> 3\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The buckets after the last of m (GROUP when m is 0).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn bitmask_leading(m: BitMask) -> i64 {\n");
        buf_str(out, c"    leading_zeros(m) >> 3\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::collections::group ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::collections ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::io ----\n");
        buf_str(out, c"pub mod io {\n");
        buf_str(out, c"// std::io: reading stdin (0.20: from flat/io.tach); (0.20, B6) io::Error\n");
        buf_str(out, c"// and io::Result, Read, Write, BufReader, BufWriter and the standard\n");
        buf_str(out, c"// streams (io/error.tach, io/buffered.tach).\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub mod error;\n");
        buf_str(out, c"pub mod buffered;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub use buffered::{\n");
        buf_str(out, c"    BufRead, BufReader, BufWriter, Lines, Read, Stderr, Stdin, Stdout, Write, stderr, stdin, stdout,\n");
        buf_str(out, c"    writeln,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"pub use error::{Error, ErrorKind, Result};\n");
        buf_str(out, c"use std::{Allocator, Buf, IoError, malloc, read};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `read_line` and `read_stdin` share one buffer: they can be mixed, but\n");
        buf_str(out, c"// not with C's stdio reading (getchar, scanf, fgets), which has its own.\n");
        buf_str(out, c"static var STDIN_BUF: *u8 = 0 as *u8;\n");
        buf_str(out, c"static var STDIN_POS: i64 = 0;\n");
        buf_str(out, c"static var STDIN_LEN: i64 = 0;\n");
        buf_str(out, c"const STDIN_BLOCK: i64 = 65536;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Bytes in STDIN_BUF[STDIN_POS..STDIN_LEN], read if there were none: 1;\n");
        buf_str(out, c"// 0 at the end of input, -1 when reading failed.\n");
        buf_str(out, c"fn stdin_fill() -> i64 {\n");
        buf_str(out, c"    if STDIN_POS < STDIN_LEN {\n");
        buf_str(out, c"        return 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if STDIN_BUF == 0 as *u8 {\n");
        buf_str(out, c"        STDIN_BUF = unsafe { malloc(STDIN_BLOCK as u64) };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let n = unsafe { read(0, STDIN_BUF, STDIN_BLOCK as u64) };\n");
        buf_str(out, c"    STDIN_POS = 0;\n");
        buf_str(out, c"    STDIN_LEN = if n > 0 { n } else { 0 };\n");
        buf_str(out, c"    if n > 0 { 1 } else if n == 0 { 0 } else { -1 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The next line of stdin into `line` (emptied first; 0.16: a Buf on any\n");
        buf_str(out, c"// allocator, which it grows), without its '\\n'; Ok(false) at the end of\n");
        buf_str(out, c"// input.\n");
        buf_str(out, c"pub fn read_line<A: Allocator>(line: inout Buf<A>) -> std::Result<bool, IoError> {\n");
        buf_str(out, c"    line.clear();\n");
        buf_str(out, c"    var any = false;\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        let filled = stdin_fill();\n");
        buf_str(out, c"        if filled < 0 {\n");
        buf_str(out, c"            return std::Result::Err(IoError::Read);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if filled == 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        any = true;\n");
        buf_str(out, c"        let block = unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] };\n");
        buf_str(out, c"        for i in 0..block.len {\n");
        buf_str(out, c"            if block[i] == '\\n' {\n");
        buf_str(out, c"                line.push_str(block[..i]);\n");
        buf_str(out, c"                STDIN_POS += i + 1;\n");
        buf_str(out, c"                return std::Result::Ok(true);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        line.push_str(block);\n");
        buf_str(out, c"        STDIN_POS = STDIN_LEN;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    std::Result::Ok(any)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// All of stdin that is left, in a new Buf on allocator a (the caller\n");
        buf_str(out, c"// frees it). It shares a buffer with read_line, not with C's getchar or\n");
        buf_str(out, c"// scanf.\n");
        buf_str(out, c"pub fn read_stdin_in<A: Allocator>(a: sink A) -> std::Result<Buf<A>, IoError> {\n");
        buf_str(out, c"    var b: Buf<A> = Buf::new_in(a);\n");
        buf_str(out, c"    if STDIN_POS < STDIN_LEN {\n");
        buf_str(out, c"        b.push_str(unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] });\n");
        buf_str(out, c"        STDIN_POS = STDIN_LEN;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        b.bytes.reserve(STDIN_BLOCK);\n");
        buf_str(out, c"        let room = b.bytes.cap - b.bytes.len;\n");
        buf_str(out, c"        let n = unsafe { read(0, &b.bytes.ptr[b.bytes.len], room as u64) };\n");
        buf_str(out, c"        if n == 0 {\n");
        buf_str(out, c"            return std::Result::Ok(b);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if n < 0 {\n");
        buf_str(out, c"            b.free();\n");
        buf_str(out, c"            return std::Result::Err(IoError::Read);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b.bytes.len += n;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.20) Reads up to buf.len bytes of stdin into buf, what read_line has\n");
        buf_str(out, c"// buffered first: how many (0 at the end), -1 when reading failed\n");
        buf_str(out, c"// (std::io::Stdin).\n");
        buf_str(out, c"pub fn __stdin_read(buf: inout [u8]) -> i64 {\n");
        buf_str(out, c"    if STDIN_POS < STDIN_LEN {\n");
        buf_str(out, c"        let block = unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] };\n");
        buf_str(out, c"        let n = if block.len < buf.len { block.len } else { buf.len };\n");
        buf_str(out, c"        for i in 0..n {\n");
        buf_str(out, c"            buf[i] = block[i];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        STDIN_POS += n;\n");
        buf_str(out, c"        return n;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let n = unsafe { read(0, buf.ptr, buf.len as u64) };\n");
        buf_str(out, c"    if n < 0 { -1 } else { n }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::io::error ----\n");
        buf_str(out, c"pub mod error {\n");
        buf_str(out, c"// std::io::error (0.20, docs/design/collections-text-io.md §2.6.2, task\n");
        buf_str(out, c"// B6): io::Error, Rust's shape without its Box (a kind, the OS's errno or\n");
        buf_str(out, c"// 0, and a static message of std's), ErrorKind, and io::Result<T>.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Debug, Display, Eq, Fmt, From, Option};\n");
        buf_str(out, c"use std::str::Utf8Error;\n");
        buf_str(out, c"use std::sys::{SysErrorKind, sys_errno, sys_errno_kind, sys_strerror_into};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- I/O errors (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The kinds of io::Error (Rust's names; those std can produce).\n");
        buf_str(out, c"#[derive(Eq, Debug, Clone)]\n");
        buf_str(out, c"pub enum ErrorKind {\n");
        buf_str(out, c"    NotFound,\n");
        buf_str(out, c"    PermissionDenied,\n");
        buf_str(out, c"    AlreadyExists,\n");
        buf_str(out, c"    WouldBlock,\n");
        buf_str(out, c"    InvalidInput,\n");
        buf_str(out, c"    InvalidData,\n");
        buf_str(out, c"    TimedOut,\n");
        buf_str(out, c"    WriteZero,\n");
        buf_str(out, c"    Interrupted,\n");
        buf_str(out, c"    UnexpectedEof,\n");
        buf_str(out, c"    BrokenPipe,\n");
        buf_str(out, c"    NotADirectory,\n");
        buf_str(out, c"    IsADirectory,\n");
        buf_str(out, c"    DirectoryNotEmpty,\n");
        buf_str(out, c"    Unsupported,\n");
        buf_str(out, c"    OutOfMemory,\n");
        buf_str(out, c"    Other,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl ErrorKind {\n");
        buf_str(out, c"    // Rust's description of the kind (\"entity not found\", ...).\n");
        buf_str(out, c"    pub fn as_str(self) -> [u8] {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            ErrorKind::NotFound => \"entity not found\",\n");
        buf_str(out, c"            ErrorKind::PermissionDenied => \"permission denied\",\n");
        buf_str(out, c"            ErrorKind::AlreadyExists => \"entity already exists\",\n");
        buf_str(out, c"            ErrorKind::WouldBlock => \"operation would block\",\n");
        buf_str(out, c"            ErrorKind::InvalidInput => \"invalid input parameter\",\n");
        buf_str(out, c"            ErrorKind::InvalidData => \"invalid data\",\n");
        buf_str(out, c"            ErrorKind::TimedOut => \"timed out\",\n");
        buf_str(out, c"            ErrorKind::WriteZero => \"write zero\",\n");
        buf_str(out, c"            ErrorKind::Interrupted => \"operation interrupted\",\n");
        buf_str(out, c"            ErrorKind::UnexpectedEof => \"unexpected end of file\",\n");
        buf_str(out, c"            ErrorKind::BrokenPipe => \"broken pipe\",\n");
        buf_str(out, c"            ErrorKind::NotADirectory => \"not a directory\",\n");
        buf_str(out, c"            ErrorKind::IsADirectory => \"is a directory\",\n");
        buf_str(out, c"            ErrorKind::DirectoryNotEmpty => \"directory not empty\",\n");
        buf_str(out, c"            ErrorKind::Unsupported => \"unsupported\",\n");
        buf_str(out, c"            ErrorKind::OutOfMemory => \"out of memory\",\n");
        buf_str(out, c"            ErrorKind::Other => \"other error\",\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for ErrorKind {\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) {\n");
        buf_str(out, c"        f.str(self.as_str());\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn kind_of_sys(k: SysErrorKind) -> ErrorKind {\n");
        buf_str(out, c"    match k {\n");
        buf_str(out, c"        SysErrorKind::NotFound => ErrorKind::NotFound,\n");
        buf_str(out, c"        SysErrorKind::PermissionDenied => ErrorKind::PermissionDenied,\n");
        buf_str(out, c"        SysErrorKind::AlreadyExists => ErrorKind::AlreadyExists,\n");
        buf_str(out, c"        SysErrorKind::WouldBlock => ErrorKind::WouldBlock,\n");
        buf_str(out, c"        SysErrorKind::InvalidInput => ErrorKind::InvalidInput,\n");
        buf_str(out, c"        SysErrorKind::InvalidData => ErrorKind::InvalidData,\n");
        buf_str(out, c"        SysErrorKind::TimedOut => ErrorKind::TimedOut,\n");
        buf_str(out, c"        SysErrorKind::WriteZero => ErrorKind::WriteZero,\n");
        buf_str(out, c"        SysErrorKind::Interrupted => ErrorKind::Interrupted,\n");
        buf_str(out, c"        SysErrorKind::UnexpectedEof => ErrorKind::UnexpectedEof,\n");
        buf_str(out, c"        SysErrorKind::BrokenPipe => ErrorKind::BrokenPipe,\n");
        buf_str(out, c"        SysErrorKind::NotADirectory => ErrorKind::NotADirectory,\n");
        buf_str(out, c"        SysErrorKind::IsADirectory => ErrorKind::IsADirectory,\n");
        buf_str(out, c"        SysErrorKind::DirectoryNotEmpty => ErrorKind::DirectoryNotEmpty,\n");
        buf_str(out, c"        SysErrorKind::Unsupported => ErrorKind::Unsupported,\n");
        buf_str(out, c"        SysErrorKind::OutOfMemory => ErrorKind::OutOfMemory,\n");
        buf_str(out, c"        SysErrorKind::Other => ErrorKind::Other,\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An I/O error: its kind, the OS's error number (0: none) and std's\n");
        buf_str(out, c"// message for it (a C string of std's, or null). Display: the OS's text\n");
        buf_str(out, c"// and `(os error N)`, as Rust's; else the message, else the kind's text.\n");
        buf_str(out, c"#[derive(Eq, Clone)]\n");
        buf_str(out, c"pub struct Error { kind: ErrorKind, code: i32, msg: *u8 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `Result<T, io::Error>`: what std's I/O functions return (`?` passes the\n");
        buf_str(out, c"// error on).\n");
        buf_str(out, c"pub type Result<T> = std::Result<T, Error>;\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Error {\n");
        buf_str(out, c"    // The error of errno e.\n");
        buf_str(out, c"    pub fn from_raw_os_error(e: i32) -> Error {\n");
        buf_str(out, c"        Error { kind: kind_of_sys(sys_errno_kind(e)), code: e, msg: 0 as *u8 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The error errno says now.\n");
        buf_str(out, c"    pub fn last_os_error() -> Error {\n");
        buf_str(out, c"        Error::from_raw_os_error(sys_errno())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An error of kind k with no OS error (Rust's `Error::from(kind)`).\n");
        buf_str(out, c"    pub fn new(k: ErrorKind) -> Error {\n");
        buf_str(out, c"        Error { kind: k, code: 0, msg: 0 as *u8 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn kind(self) -> ErrorKind {\n");
        buf_str(out, c"        self.kind\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The OS's error number, when there is one.\n");
        buf_str(out, c"    pub fn raw_os_error(self) -> Option<i32> {\n");
        buf_str(out, c"        if self.code != 0 { Option::Some(self.code) } else { Option::None }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// std's own error, with a static message.\n");
        buf_str(out, c"pub fn __io_error(k: ErrorKind, msg: *u8) -> Error {\n");
        buf_str(out, c"    Error { kind: k, code: 0, msg: msg }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for Error {\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) {\n");
        buf_str(out, c"        if self.code != 0 {\n");
        buf_str(out, c"            var buf: [u8; 128] = [0; 128];\n");
        buf_str(out, c"            let n = sys_strerror_into(self.code, &buf[..]);\n");
        buf_str(out, c"            f.str(buf[..n]);\n");
        buf_str(out, c"            f.str(\" (os error \");\n");
        buf_str(out, c"            f.int(self.code as i64);\n");
        buf_str(out, c"            f.str(\")\");\n");
        buf_str(out, c"        } else if self.msg != 0 as *u8 {\n");
        buf_str(out, c"            // (a C string literal of std's: NUL-ended, static)\n");
        buf_str(out, c"            f.str(unsafe { std::sys::sys_cstr_view(self.msg) });\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            f.str(self.kind.as_str());\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for Error {\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) {\n");
        buf_str(out, c"        if self.code != 0 {\n");
        buf_str(out, c"            f.str(\"Os { code: \");\n");
        buf_str(out, c"            f.int(self.code as i64);\n");
        buf_str(out, c"            f.str(\", kind: \");\n");
        buf_str(out, c"            self.kind.fmt_debug(&f);\n");
        buf_str(out, c"            f.str(\", message: \\\"\");\n");
        buf_str(out, c"            var buf: [u8; 128] = [0; 128];\n");
        buf_str(out, c"            let n = sys_strerror_into(self.code, &buf[..]);\n");
        buf_str(out, c"            f.str(buf[..n]);\n");
        buf_str(out, c"            f.str(\"\\\" }\");\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            f.str(\"Custom { kind: \");\n");
        buf_str(out, c"            self.kind.fmt_debug(&f);\n");
        buf_str(out, c"            f.str(\", error: \\\"\");\n");
        buf_str(out, c"            self.fmt(&f);\n");
        buf_str(out, c"            f.str(\"\\\" }\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl From<ErrorKind> for Error {\n");
        buf_str(out, c"    fn from(k: ErrorKind) -> Error {\n");
        buf_str(out, c"        Error::new(k)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (text that is not UTF-8, read where a String goes: InvalidData)\n");
        buf_str(out, c"impl From<Utf8Error> for Error {\n");
        buf_str(out, c"    fn from(e: Utf8Error) -> Error {\n");
        buf_str(out, c"        __io_error(ErrorKind::InvalidData, c\"stream did not contain valid UTF-8\")\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The error of a sys call's errno.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn __os_error(e: i32) -> Error {\n");
        buf_str(out, c"    Error::from_raw_os_error(e)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::io::error ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::io::buffered ----\n");
        buf_str(out, c"pub mod buffered {\n");
        buf_str(out, c"// std::io::buffered (0.20, docs/design/collections-text-io.md §2.6.3,\n");
        buf_str(out, c"// task B6): the Read and Write traits, BufReader and BufWriter with their\n");
        buf_str(out, c"// 8 KB buffers inline (`BufReader::new(f)` allocates nothing), the\n");
        buf_str(out, c"// standard streams, and writeln. What grows a Vec or a String (read_to_end,\n");
        buf_str(out, c"// read_line, lines_in) grows it on its own allocator.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Allocator, Display, Drop, Iterator, Option, Vec};\n");
        buf_str(out, c"use std::io::error::{Error, ErrorKind, Result, __io_error, __os_error};\n");
        buf_str(out, c"use std::str::{memchr, validate_utf8};\n");
        buf_str(out, c"use std::string::String;\n");
        buf_str(out, c"use std::sys::{sys_read, sys_write};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Reading and writing (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A source of bytes: a File, a BufReader, stdin(), a ChildStdout.\n");
        buf_str(out, c"pub trait Read {\n");
        buf_str(out, c"    // Reads up to buf.len bytes into buf: how many (0 at the end).\n");
        buf_str(out, c"    fn read(inout self, buf: inout [u8]) -> Result<i64>;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Fills buf, or UnexpectedEof.\n");
        buf_str(out, c"    fn read_exact(inout self, buf: inout [u8]) -> Result<()> {\n");
        buf_str(out, c"        var at = 0;\n");
        buf_str(out, c"        while at < buf.len {\n");
        buf_str(out, c"            let n = self.read(&buf[at..])?;\n");
        buf_str(out, c"            if n == 0 {\n");
        buf_str(out, c"                return Err(__io_error(ErrorKind::UnexpectedEof, c\"failed to fill whole buffer\"));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            at += n;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Ok(())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Appends all that is left to v: how many bytes.\n");
        buf_str(out, c"    fn read_to_end<A: Allocator>(inout self, v: inout Vec<u8, A>) -> Result<i64> {\n");
        buf_str(out, c"        let start = v.len;\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            if v.cap - v.len < 4096 {\n");
        buf_str(out, c"                v.reserve(if v.cap < 8192 { 8192 } else { v.cap });\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            // (v's room: its capacity past its length, written before it\n");
        buf_str(out, c"            // counts)\n");
        buf_str(out, c"            let room = unsafe { v.ptr[v.len..v.cap] };\n");
        buf_str(out, c"            let n = self.read(&room)?;\n");
        buf_str(out, c"            if n == 0 {\n");
        buf_str(out, c"                return Ok(v.len - start);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            v.len += n;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Appends all that is left to s, which must be UTF-8 (InvalidData, s\n");
        buf_str(out, c"    // as it was, when not): how many bytes.\n");
        buf_str(out, c"    fn read_to_string<A: Allocator>(inout self, s: inout String<A>) -> Result<i64> {\n");
        buf_str(out, c"        let start = s.bytes.len;\n");
        buf_str(out, c"        let n = self.read_to_end(&s.bytes)?;\n");
        buf_str(out, c"        match validate_utf8(s.bytes.as_slice()[start..]) {\n");
        buf_str(out, c"            Ok(_) => Ok(n),\n");
        buf_str(out, c"            Err(_) => {\n");
        buf_str(out, c"                s.bytes.truncate(start);\n");
        buf_str(out, c"                Err(__io_error(ErrorKind::InvalidData, c\"stream did not contain valid UTF-8\"))\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A sink of bytes: a File, a BufWriter, stdout(), stderr().\n");
        buf_str(out, c"pub trait Write {\n");
        buf_str(out, c"    // Writes some of buf: how many bytes.\n");
        buf_str(out, c"    fn write(inout self, buf: [u8]) -> Result<i64>;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Writes out what is buffered.\n");
        buf_str(out, c"    fn flush(inout self) -> Result<()>;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Writes all of buf (WriteZero when the sink takes none).\n");
        buf_str(out, c"    fn write_all(inout self, buf: [u8]) -> Result<()> {\n");
        buf_str(out, c"        var at = 0;\n");
        buf_str(out, c"        while at < buf.len {\n");
        buf_str(out, c"            let n = self.write(buf[at..])?;\n");
        buf_str(out, c"            if n == 0 {\n");
        buf_str(out, c"                return Err(__io_error(ErrorKind::WriteZero, c\"failed to write whole buffer\"));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            at += n;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Ok(())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Writes x's Display: `w.write_fmt(f\"{a} {b}\\n\")?` (writeln). Text of\n");
        buf_str(out, c"    // up to 4 KB per call (InvalidInput above: a BufWriter takes 8 KB).\n");
        buf_str(out, c"    fn write_fmt<T: Display>(inout self, x: sink T) -> Result<()> {\n");
        buf_str(out, c"        var tmp: [u8; 4096] = [0; 4096];\n");
        buf_str(out, c"        let n = std::fmt::__fmt_into_len(&tmp[..], x);\n");
        buf_str(out, c"        if n < 0 {\n");
        buf_str(out, c"            return Err(__io_error(ErrorKind::InvalidInput, c\"formatted text over 4096 bytes\"));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.write_all(tmp[..n])\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Writes x's Display and a '\\n' to w (Rust's `writeln!(w, ..)`):\n");
        buf_str(out, c"// `writeln(&mut out, f\"{k} {v}\")?`.\n");
        buf_str(out, c"pub fn writeln<W: Write, T: Display>(w: inout W, x: sink T) -> Result<()> {\n");
        buf_str(out, c"    w.write_fmt(x)?;\n");
        buf_str(out, c"    w.write_all(\"\\n\")\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Buffered reading and writing (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"const BUF_SIZE: i64 = 8192;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Reads its inner reader 8 KB at a time (the buffer is inline: `new`\n");
        buf_str(out, c"// allocates nothing); lines and read_line split what it holds.\n");
        buf_str(out, c"pub struct BufReader<R> { inner: R, buf: [u8; 8192], pos: i64, len: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<R: Read> BufReader<R> {\n");
        buf_str(out, c"    pub fn new(inner: sink R) -> BufReader<R> {\n");
        buf_str(out, c"        BufReader { inner: inner, buf: [0; 8192], pos: 0, len: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Appends the bytes up to and including the next `byte` (or the end)\n");
        buf_str(out, c"    // to v: how many (0 at the end).\n");
        buf_str(out, c"    pub fn read_until<A: Allocator>(inout self, byte: u8, v: inout Vec<u8, A>)\n");
        buf_str(out, c"        -> Result<i64> {\n");
        buf_str(out, c"        var total = 0;\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            if self.pos >= self.len {\n");
        buf_str(out, c"                self.pos = 0;\n");
        buf_str(out, c"                self.len = 0;\n");
        buf_str(out, c"                let n = self.inner.read(&self.buf[..])?;\n");
        buf_str(out, c"                if n == 0 {\n");
        buf_str(out, c"                    return Ok(total);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.len = n;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let avail = self.buf[self.pos..self.len];\n");
        buf_str(out, c"            match memchr(byte, avail) {\n");
        buf_str(out, c"                Option::Some(k) => {\n");
        buf_str(out, c"                    push_bytes(&v, avail[..k + 1]);\n");
        buf_str(out, c"                    self.pos += k + 1;\n");
        buf_str(out, c"                    return Ok(total + k + 1);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                Option::None => {\n");
        buf_str(out, c"                    push_bytes(&v, avail);\n");
        buf_str(out, c"                    total += avail.len;\n");
        buf_str(out, c"                    self.pos = self.len;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Appends the next line to s, its '\\n' included (Rust's read_line):\n");
        buf_str(out, c"    // how many bytes, 0 at the end. InvalidData when it is not UTF-8.\n");
        buf_str(out, c"    pub fn read_line<A: Allocator>(inout self, s: inout String<A>) -> Result<i64> {\n");
        buf_str(out, c"        let start = s.bytes.len;\n");
        buf_str(out, c"        let n = self.read_until('\\n', &s.bytes)?;\n");
        buf_str(out, c"        match validate_utf8(s.bytes.as_slice()[start..]) {\n");
        buf_str(out, c"            Ok(_) => Ok(n),\n");
        buf_str(out, c"            Err(_) => {\n");
        buf_str(out, c"                s.bytes.truncate(start);\n");
        buf_str(out, c"                Err(__io_error(ErrorKind::InvalidData, c\"stream did not contain valid UTF-8\"))\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The lines, each a new String on allocator a without its '\\n' (or\n");
        buf_str(out, c"    // \"\\r\\n\"): Rust's `lines()`, which allocates each one too.\n");
        buf_str(out, c"    pub fn lines_in<A: Allocator>(sink self, a: sink A) -> Lines<R, A> {\n");
        buf_str(out, c"        Lines { r: self, a: a }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The reader inside (what is buffered is lost).\n");
        buf_str(out, c"    pub fn into_inner(sink self) -> R {\n");
        buf_str(out, c"        self.inner\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<R: Read> Read for BufReader<R> {\n");
        buf_str(out, c"    fn read(inout self, buf: inout [u8]) -> Result<i64> {\n");
        buf_str(out, c"        if self.pos >= self.len && buf.len >= BUF_SIZE {\n");
        buf_str(out, c"            return self.inner.read(buf);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let avail = self.fill_buf()?;\n");
        buf_str(out, c"        let n = if avail.len < buf.len { avail.len } else { buf.len };\n");
        buf_str(out, c"        for i in 0..n {\n");
        buf_str(out, c"            buf[i] = avail[i];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.consume(n);\n");
        buf_str(out, c"        Ok(n)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A reader with a buffer (Rust's BufRead): BufReader. Its read_line,\n");
        buf_str(out, c"// read_until and lines_in are BufReader's own (no `use` needed).\n");
        buf_str(out, c"pub trait BufRead {\n");
        buf_str(out, c"    // The bytes buffered, read if there are none (empty at the end).\n");
        buf_str(out, c"    fn fill_buf(inout self) -> Result<[u8]>;\n");
        buf_str(out, c"    // Marks n of the buffered bytes read.\n");
        buf_str(out, c"    fn consume(inout self, n: i64);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<R: Read> BufRead for BufReader<R> {\n");
        buf_str(out, c"    fn fill_buf(inout self) -> Result<[u8]> {\n");
        buf_str(out, c"        if self.pos >= self.len {\n");
        buf_str(out, c"            self.pos = 0;\n");
        buf_str(out, c"            self.len = 0;\n");
        buf_str(out, c"            let n = self.inner.read(&self.buf[..])?;\n");
        buf_str(out, c"            self.len = n;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Ok(self.buf[self.pos..self.len])\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn consume(inout self, n: i64) {\n");
        buf_str(out, c"        self.pos = if self.pos + n < self.len { self.pos + n } else { self.len };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Appends s to v with one memcpy; s is not a view of v (the reader's\n");
        buf_str(out, c"// buffer, or the room it reads into).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn push_bytes<A: Allocator>(v: inout Vec<u8, A>, s: [u8]) {\n");
        buf_str(out, c"    v.reserve(s.len);\n");
        buf_str(out, c"    // (after reserve, v.ptr[v.len..v.len + s.len] is v's room: memory v\n");
        buf_str(out, c"    // owns, apart from s's)\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        std::memcpy(&v.ptr[v.len], s.ptr, s.len as u64);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v.len += s.len;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `r.lines_in(gpa)`: each line, a String.\n");
        buf_str(out, c"pub struct Lines<R, A> { r: BufReader<R>, a: A }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<R: Read, A: Allocator> Iterator for Lines<R, A> {\n");
        buf_str(out, c"    type Item = Result<String<A>>;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn next(inout self) -> Option<Result<String<A>>> {\n");
        buf_str(out, c"        var s: String<A> = String::new_in(self.a);\n");
        buf_str(out, c"        match self.r.read_line(&s) {\n");
        buf_str(out, c"            Ok(n) => {\n");
        buf_str(out, c"                if n == 0 {\n");
        buf_str(out, c"                    return Option::None;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                let len = s.bytes.len;\n");
        buf_str(out, c"                if len > 0 && s.bytes.as_slice()[len - 1] == '\\n' {\n");
        buf_str(out, c"                    s.bytes.truncate(len - 1);\n");
        buf_str(out, c"                    let len2 = s.bytes.len;\n");
        buf_str(out, c"                    if len2 > 0 && s.bytes.as_slice()[len2 - 1] == '\\r' {\n");
        buf_str(out, c"                        s.bytes.truncate(len2 - 1);\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                Option::Some(Ok(s))\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Err(e) => Option::Some(Err(e)),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Writes to its inner writer 8 KB at a time (inline; `new` allocates\n");
        buf_str(out, c"// nothing). Dropping it flushes it (errors lost there: flush first to see\n");
        buf_str(out, c"// them).\n");
        buf_str(out, c"pub struct BufWriter<W: Write> { inner: W, buf: [u8; 8192], len: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<W: Write> BufWriter<W> {\n");
        buf_str(out, c"    pub fn new(inner: sink W) -> BufWriter<W> {\n");
        buf_str(out, c"        BufWriter { inner: inner, buf: [0; 8192], len: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn flush_buf(inout self) -> Result<()> {\n");
        buf_str(out, c"        let n = self.len;\n");
        buf_str(out, c"        self.len = 0;\n");
        buf_str(out, c"        if n > 0 {\n");
        buf_str(out, c"            self.inner.write_all(self.buf[..n])?;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Ok(())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<W: Write> Write for BufWriter<W> {\n");
        buf_str(out, c"    fn write(inout self, buf: [u8]) -> Result<i64> {\n");
        buf_str(out, c"        if self.len + buf.len > BUF_SIZE {\n");
        buf_str(out, c"            self.flush_buf()?;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if buf.len >= BUF_SIZE {\n");
        buf_str(out, c"            return self.inner.write(buf);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let at = self.len;\n");
        buf_str(out, c"        for i in 0..buf.len {\n");
        buf_str(out, c"            self.buf[at + i] = buf[i];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len = at + buf.len;\n");
        buf_str(out, c"        Ok(buf.len)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn write_all(inout self, buf: [u8]) -> Result<()> {\n");
        buf_str(out, c"        if self.len + buf.len > BUF_SIZE {\n");
        buf_str(out, c"            self.flush_buf()?;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if buf.len >= BUF_SIZE {\n");
        buf_str(out, c"            return self.inner.write_all(buf);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let at = self.len;\n");
        buf_str(out, c"        for i in 0..buf.len {\n");
        buf_str(out, c"            self.buf[at + i] = buf[i];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len = at + buf.len;\n");
        buf_str(out, c"        Ok(())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn flush(inout self) -> Result<()> {\n");
        buf_str(out, c"        self.flush_buf()?;\n");
        buf_str(out, c"        self.inner.flush()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // x's Display written into the buffer's room (up to 8 KB of text).\n");
        buf_str(out, c"    fn write_fmt<T: Display>(inout self, x: sink T) -> Result<()> {\n");
        buf_str(out, c"        let at = self.len;\n");
        buf_str(out, c"        let n = std::fmt::__fmt_into_len(&self.buf[at..], x);\n");
        buf_str(out, c"        if n >= 0 {\n");
        buf_str(out, c"            self.len = at + n;\n");
        buf_str(out, c"            return Ok(());\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.flush_buf()?;\n");
        buf_str(out, c"        let m = std::fmt::__fmt_into_len(&self.buf[..], x);\n");
        buf_str(out, c"        if m < 0 {\n");
        buf_str(out, c"            return Err(__io_error(ErrorKind::InvalidInput, c\"formatted text over 8192 bytes\"));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len = m;\n");
        buf_str(out, c"        Ok(())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<W: Write> Drop for BufWriter<W> {\n");
        buf_str(out, c"    fn drop(inout self) {\n");
        buf_str(out, c"        let _ = self.flush_buf();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- The standard streams (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Standard output: print's buffer is written out before what is written\n");
        buf_str(out, c"// here, so the two keep their order.\n");
        buf_str(out, c"pub struct Stdout { fd: i32 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Standard error.\n");
        buf_str(out, c"pub struct Stderr { fd: i32 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Standard input: what read_line has buffered is read first.\n");
        buf_str(out, c"pub struct Stdin { fd: i32 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn stdout() -> Stdout {\n");
        buf_str(out, c"    Stdout { fd: 1 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn stderr() -> Stderr {\n");
        buf_str(out, c"    Stderr { fd: 2 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn stdin() -> Stdin {\n");
        buf_str(out, c"    Stdin { fd: 0 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Writes some of buf to fd.\n");
        buf_str(out, c"fn fd_write(fd: i32, buf: [u8]) -> Result<i64> {\n");
        buf_str(out, c"    match sys_write(fd, buf) {\n");
        buf_str(out, c"        Ok(n) => Ok(n),\n");
        buf_str(out, c"        Err(e) => Err(__os_error(e)),\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Write for Stdout {\n");
        buf_str(out, c"    fn write(inout self, buf: [u8]) -> Result<i64> {\n");
        buf_str(out, c"        std::fmt::__flush_print();\n");
        buf_str(out, c"        fd_write(self.fd, buf)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn flush(inout self) -> Result<()> {\n");
        buf_str(out, c"        std::fmt::__flush_print();\n");
        buf_str(out, c"        Ok(())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Write for Stderr {\n");
        buf_str(out, c"    fn write(inout self, buf: [u8]) -> Result<i64> {\n");
        buf_str(out, c"        fd_write(self.fd, buf)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn flush(inout self) -> Result<()> {\n");
        buf_str(out, c"        Ok(())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Read for Stdin {\n");
        buf_str(out, c"    fn read(inout self, buf: inout [u8]) -> Result<i64> {\n");
        buf_str(out, c"        let n = std::io::__stdin_read(buf);\n");
        buf_str(out, c"        if n < 0 {\n");
        buf_str(out, c"            return Err(Error::last_os_error());\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Ok(n)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::io::buffered ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::io ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::fmt ----\n");
        buf_str(out, c"pub mod fmt {\n");
        buf_str(out, c"// std::fmt: printing, Display and Debug, and Fmt, the formatter (0.20: from flat/fmt.tach).\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Allocator, Buf, Gpa, Vec, decimal_len, memcpy, put_decimal, strlen, write};\n");
        buf_str(out, c"use std::num::{FloatFmt, write_f32, write_f64};\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn snprintf(buf: *u8, n: u64, format: *u8, ...) -> i32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn strtod(s: *u8, end: **u8) -> f64;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn strtof(s: *u8, end: **u8) -> f32;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Printing ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// x's Display (`print(\"text\")`, `print(f\"{a} {b:?}\")`): one `write`.\n");
        buf_str(out, c"pub fn print<T: Display>(x: sink T) {\n");
        buf_str(out, c"    var f = Fmt::to_fd(1);\n");
        buf_str(out, c"    x.fmt(&f);\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn println<T: Display>(x: sink T) {\n");
        buf_str(out, c"    var f = Fmt::to_fd(1);\n");
        buf_str(out, c"    x.fmt(&f);\n");
        buf_str(out, c"    f.byte('\\n');\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"pub fn print_int(v: i64) {\n");
        buf_str(out, c"    var f = Fmt::to_fd(1);\n");
        buf_str(out, c"    // (decimal only: not Fmt::int, whose hex and binary every program\n");
        buf_str(out, c"    // using print_int would compile)\n");
        buf_str(out, c"    let negative = v < 0;\n");
        buf_str(out, c"    fmt_decimal(&f, if negative { (-(v + 1)) as u64 + 1 } else { v as u64 }, negative);\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A C string (up to its NUL).\n");
        buf_str(out, c"pub unsafe fn print_cstr(s: *u8) {\n");
        buf_str(out, c"    var f = Fmt::to_fd(1);\n");
        buf_str(out, c"    f.str(s[0..strlen(s) as i64]);\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Display, Debug and Fmt (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// x's Display on stderr.\n");
        buf_str(out, c"pub fn eprint<T: Display>(x: sink T) {\n");
        buf_str(out, c"    var f = Fmt::to_fd(2);\n");
        buf_str(out, c"    x.fmt(&f);\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn eprintln<T: Display>(x: sink T) {\n");
        buf_str(out, c"    var f = Fmt::to_fd(2);\n");
        buf_str(out, c"    x.fmt(&f);\n");
        buf_str(out, c"    f.byte('\\n');\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// x's Display in a new Buf on allocator a, of its length (the caller frees\n");
        buf_str(out, c"// it): `format_in(f\"{x:>8}\", gpa)`. (0.16: up to 256 bytes, x's Display\n");
        buf_str(out, c"// runs once, into a buffer on the stack.)\n");
        buf_str(out, c"pub fn format_in<T: Display, A: Allocator>(x: sink T, a: sink A) -> Buf<A> {\n");
        buf_str(out, c"    var b: Buf<A> = Buf::new_in(a);\n");
        buf_str(out, c"    var tmp: [u8; 256] = [0; 256];\n");
        buf_str(out, c"    var f = __fmt_tmp(&tmp);\n");
        buf_str(out, c"    // (one call of x's Display in the code: first to tmp, then, when the\n");
        buf_str(out, c"    // text did not fit, to b's room)\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        x.fmt(&f);\n");
        buf_str(out, c"        if __fmt_in_end(&b, &f, &tmp) {\n");
        buf_str(out, c"            return b;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.17) What the compiler writes for an f-string passed straight to\n");
        buf_str(out, c"// format_in, push_fmt, print, println, eprint or eprintln\n");
        buf_str(out, c"// (front/check/interp.tach): the holes' values, then the writes of\n");
        buf_str(out, c"// the text in place, with no closure. `format_in(f\"..\", a)` is\n");
        buf_str(out, c"//\n");
        buf_str(out, c"//   { let __f0 = e0; ...; let __a = a; let mut __b = std::Buf::new_in(__a);\n");
        buf_str(out, c"//     let mut __t = [0u8; 256]; let mut __out = std::__fmt_tmp(&mut __t);\n");
        buf_str(out, c"//     loop { WRITES; if std::__fmt_in_end(&mut __b, &mut __out, &__t) { break; } }\n");
        buf_str(out, c"//     __b }\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// and `b.push_fmt(f\"..\")` is `{ let __r = &b; let __f0 = e0; ...; let mut\n");
        buf_str(out, c"// __out = std::__buf_fmt(&mut *__r); loop { WRITES; if\n");
        buf_str(out, c"// std::__buf_fmt_end(&mut *__r, &mut __out) { break; } } }`. Not for programs to call.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A Fmt writing into tmp (format_in's first pass).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"#[views(tmp)]\n");
        buf_str(out, c"pub fn __fmt_tmp(tmp: inout [u8; 256]) -> Fmt {\n");
        buf_str(out, c"    var f = Fmt::to_fd(-1);\n");
        buf_str(out, c"    f.out = tmp[..];\n");
        buf_str(out, c"    f\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The end of a pass of format_in: the text written to tmp, when it fits,\n");
        buf_str(out, c"// copied to b, of its length (true); else b reserves the length and f\n");
        buf_str(out, c"// writes into b's room (false); after that pass, as __buf_fmt_end.\n");
        buf_str(out, c"// (0.20: tmp is format_in's buffer itself, compared by its address: a raw\n");
        buf_str(out, c"// pointer, as a let parameter would copy it)\n");
        buf_str(out, c"pub fn __fmt_in_end<A: Allocator>(b: inout Buf<A>, f: inout Fmt, tmp: *[u8; 256]) -> bool {\n");
        buf_str(out, c"    if f.out.ptr != unsafe { (*tmp)[..].ptr } {\n");
        buf_str(out, c"        return fmt_end_vec(&b.bytes, &f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if f.need == 0 {\n");
        buf_str(out, c"        b.bytes.reserve(f.len);\n");
        buf_str(out, c"        b.bytes.extend_from_slice(unsafe { (*tmp)[0..f.len] });\n");
        buf_str(out, c"        return true;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    b.bytes.reserve(f.need);\n");
        buf_str(out, c"    f = fmt_to_vec(&b.bytes);\n");
        buf_str(out, c"    false\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A Fmt writing into b's room (push_fmt).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"#[views(b)]\n");
        buf_str(out, c"pub fn __buf_fmt<A: Allocator>(b: inout Buf<A>) -> Fmt {\n");
        buf_str(out, c"    fmt_to_vec(&b.bytes)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The text f wrote is b's (true), or did not fit: b grows, f starts again.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn __buf_fmt_end<A: Allocator>(b: inout Buf<A>, f: inout Fmt) -> bool {\n");
        buf_str(out, c"    fmt_end_vec(&b.bytes, &f)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"format_in(x, gpa)\")]\n");
        buf_str(out, c"pub fn format<T: Display>(x: sink T) -> Buf {\n");
        buf_str(out, c"    format_in(x, Gpa::ambient())\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Buf<A> {\n");
        buf_str(out, c"    // Appends x's Display: `b.push_fmt(f\"{k}={v};\")`. (0.16: into the room\n");
        buf_str(out, c"    // the Buf has; when the text does not fit, the Buf grows and x's\n");
        buf_str(out, c"    // Display runs again.)\n");
        buf_str(out, c"    pub fn push_fmt<T: Display>(inout self, x: sink T) {\n");
        buf_str(out, c"        var f = __buf_fmt(&self);\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            x.fmt(&f);\n");
        buf_str(out, c"            if __buf_fmt_end(&self, &f) {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A Fmt writing into v's room.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn fmt_to_vec<A: Allocator>(v: inout Vec<u8, A>) -> Fmt {\n");
        buf_str(out, c"    var f = Fmt::to_fd(-1);\n");
        buf_str(out, c"    f.out = unsafe { v.ptr[0..v.cap] };\n");
        buf_str(out, c"    f.len = v.len;\n");
        buf_str(out, c"    f\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The text f wrote into v's room is v's (true), or did not fit: v grows to\n");
        buf_str(out, c"// fit it, f starts again (false).\n");
        buf_str(out, c"pub fn fmt_end_vec<A: Allocator>(v: inout Vec<u8, A>, f: inout Fmt) -> bool {\n");
        buf_str(out, c"    if f.need == 0 {\n");
        buf_str(out, c"        v.len = f.len;\n");
        buf_str(out, c"        return true;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v.reserve(f.need - v.len);\n");
        buf_str(out, c"    f = fmt_to_vec(&v);\n");
        buf_str(out, c"    false\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.20) x's Display written into out: its length, or -1 when it did not\n");
        buf_str(out, c"// fit (std::io's write_fmt).\n");
        buf_str(out, c"pub fn __fmt_into_len<T: Display>(out: inout [u8], x: T) -> i64 {\n");
        buf_str(out, c"    var f = Fmt::to_fd(-1);\n");
        buf_str(out, c"    f.out = out;\n");
        buf_str(out, c"    x.fmt(&f);\n");
        buf_str(out, c"    if f.need == 0 { f.len } else { -1 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.20) Writes out what print and println have buffered (std::io's\n");
        buf_str(out, c"// stdout() writes after it).\n");
        buf_str(out, c"pub fn __flush_print() {\n");
        buf_str(out, c"    fmt_flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `{x}` in an f-string, and what print writes.\n");
        buf_str(out, c"pub trait Display { fn fmt(self, f: inout Fmt); }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `{x:?}`: as the code that makes it.\n");
        buf_str(out, c"pub trait Debug { fn fmt_debug(self, f: inout Fmt); }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A spec's flags (front/ast.tach's FMT_*): `<`, `>`, `0`, `x`, `X`, `b`,\n");
        buf_str(out, c"// `c`; spec adds FMT_PAD to a hole with a width or a precision, and a\n");
        buf_str(out, c"// number written first in such a hole adds FMT_NUM (right-aligned,\n");
        buf_str(out, c"// zero-padded after its sign, not cut by the precision).\n");
        buf_str(out, c"const FMT_LEFT: i64 = 1;\n");
        buf_str(out, c"const FMT_RIGHT: i64 = 2;\n");
        buf_str(out, c"const FMT_ZERO: i64 = 4;\n");
        buf_str(out, c"const FMT_HEX: i64 = 8;\n");
        buf_str(out, c"const FMT_UPPER: i64 = 16;\n");
        buf_str(out, c"const FMT_BIN: i64 = 32;\n");
        buf_str(out, c"const FMT_CHAR: i64 = 64;\n");
        buf_str(out, c"const FMT_NUM: i64 = 128;\n");
        buf_str(out, c"const FMT_PAD: i64 = 256;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The buffer of stdout and stderr: FMT_LEN bytes for FMT_FD; FMT_DONE\n");
        buf_str(out, c"// bytes were written out before them (FMT_DONE + FMT_LEN: the position a\n");
        buf_str(out, c"// spec marks).\n");
        buf_str(out, c"const FMT_CAP: i64 = 4096;\n");
        buf_str(out, c"static var FMT_OUT: [u8; 4096] = [0; 4096];\n");
        buf_str(out, c"static var FMT_LEN: i64 = 0;\n");
        buf_str(out, c"static var FMT_FD: i32 = 1;\n");
        buf_str(out, c"static var FMT_DONE: i64 = 0;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Writes the buffer out.\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_flush() {\n");
        buf_str(out, c"    var i = 0;\n");
        buf_str(out, c"    // (each round writes a byte at least)\n");
        buf_str(out, c"    for _ in 0..FMT_LEN {\n");
        buf_str(out, c"        if i >= FMT_LEN {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let rest = FMT_OUT[i..FMT_LEN];\n");
        buf_str(out, c"        let n = unsafe { write(FMT_FD, rest.ptr, rest.len as u64) };\n");
        buf_str(out, c"        if n <= 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i += n;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    FMT_DONE += FMT_LEN;\n");
        buf_str(out, c"    FMT_LEN = 0;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The next n bytes of f's destination, taken, when they fit (the Buf has\n");
        buf_str(out, c"// the room, the buffer holds FMT_FD's bytes); else an empty slice.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_room(f: inout Fmt, n: i64) -> [u8] {\n");
        buf_str(out, c"    let at = f.len;\n");
        buf_str(out, c"    if at + n <= f.out.len {\n");
        buf_str(out, c"        f.len = at + n;\n");
        buf_str(out, c"        return unsafe { f.out.ptr[at..at + n] };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if f.fd == FMT_FD && FMT_LEN + n <= FMT_CAP {\n");
        buf_str(out, c"        let at = FMT_LEN;\n");
        buf_str(out, c"        FMT_LEN = at + n;\n");
        buf_str(out, c"        return FMT_OUT[at..at + n];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    \"\"\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// fmt_room when they do not fit (n: at most FMT_CAP): the buffer written\n");
        buf_str(out, c"// out first; to a Buf, an empty slice, the n bytes counted (fmt_lost). (A\n");
        buf_str(out, c"// Fmt's file descriptor or Buf is chosen inline, so that print compiles\n");
        buf_str(out, c"// only the file descriptor's functions.)\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_make_room(f: inout Fmt, n: i64) -> [u8] {\n");
        buf_str(out, c"    if f.fd >= 0 { fmt_fd_room(f.fd, n) } else { fmt_lost(&f, n) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_fd_room(fd: i32, n: i64) -> [u8] {\n");
        buf_str(out, c"    if fd != FMT_FD || FMT_LEN + n > FMT_CAP {\n");
        buf_str(out, c"        fmt_flush();\n");
        buf_str(out, c"        FMT_FD = fd;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let at = FMT_LEN;\n");
        buf_str(out, c"    FMT_LEN = at + n;\n");
        buf_str(out, c"    FMT_OUT[at..at + n]\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// n bytes to a Buf that has no room for them: counted, not written (the\n");
        buf_str(out, c"// text is written again, push_fmt).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_lost(f: inout Fmt, n: i64) -> [u8] {\n");
        buf_str(out, c"    let end = f.len + n;\n");
        buf_str(out, c"    if end > f.need {\n");
        buf_str(out, c"        f.need = end;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    f.len = end;\n");
        buf_str(out, c"    \"\"\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fmt::str (a call: an f-string's text is one).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_str(f: inout Fmt, s: [u8]) {\n");
        buf_str(out, c"    if f.fd >= 0 {\n");
        buf_str(out, c"        fmt_str_fd(f.fd, s);\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        fmt_str_buf(&f, s);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_str_fd(fd: i32, s: [u8]) {\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    var out: [u8] = \"\";\n");
        buf_str(out, c"    if fd == FMT_FD && FMT_LEN + n <= FMT_CAP {\n");
        buf_str(out, c"        let at = FMT_LEN;\n");
        buf_str(out, c"        FMT_LEN = at + n;\n");
        buf_str(out, c"        out = FMT_OUT[at..at + n];\n");
        buf_str(out, c"    } else if n > FMT_CAP {\n");
        buf_str(out, c"        // (written directly)\n");
        buf_str(out, c"        fmt_flush();\n");
        buf_str(out, c"        FMT_FD = fd;\n");
        buf_str(out, c"        var i = 0;\n");
        buf_str(out, c"        for _ in 0..n {\n");
        buf_str(out, c"            if i >= n {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let rest = s[i..n];\n");
        buf_str(out, c"            let k = unsafe { write(fd, rest.ptr, rest.len as u64) };\n");
        buf_str(out, c"            if k <= 0 {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += k;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        FMT_DONE += n;\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        out = fmt_fd_room(fd, n);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        memcpy(out.ptr, s.ptr, n as u64);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_str_buf(f: inout Fmt, s: [u8]) {\n");
        buf_str(out, c"    let at = f.len;\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    if at + n <= f.out.len {\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            memcpy(&f.out.ptr[at], s.ptr, n as u64);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.len = at + n;\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        fmt_lost(&f, n);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fmt::byte when it does not fit.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_byte(f: inout Fmt, b: u8) {\n");
        buf_str(out, c"    let out = fmt_make_room(&f, 1);\n");
        buf_str(out, c"    if out.len == 1 {\n");
        buf_str(out, c"        out[0] = b;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// u's decimal digits, after a '-' when negative.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_decimal(f: inout Fmt, u: u64, negative: bool) {\n");
        buf_str(out, c"    let len = if negative { decimal_len(u) + 1 } else { decimal_len(u) };\n");
        buf_str(out, c"    var out = fmt_room(&f, len);\n");
        buf_str(out, c"    if out.len != len {\n");
        buf_str(out, c"        out = fmt_make_room(&f, len);\n");
        buf_str(out, c"        if out.len != len {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        put_decimal(out.ptr, len, u, negative);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What Display and Debug write to: a file descriptor `fd` (through std's\n");
        buf_str(out, c"// buffer: `flush` writes it out), or (fd -1) the room out[len..] of a\n");
        buf_str(out, c"// Buf, `need` the length the text reached when it did not fit (0: it\n");
        buf_str(out, c"// fits). (0.17) A view: `out`, the Buf's room, so a Buf cannot change while\n");
        buf_str(out, c"// a Fmt writes into it. `width`, `prec` (-1: none) and `flags` are the spec of the hole\n");
        buf_str(out, c"// being written, `mark` the position it started at. (0.16: sealed; std's\n");
        buf_str(out, c"// functions make one.)\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct Fmt {\n");
        buf_str(out, c"    out: [u8], len: i64, need: i64, fd: i32, width: i64, prec: i64, flags: i64,\n");
        buf_str(out, c"    mark: i64,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Fmt {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    #[views()]\n");
        buf_str(out, c"    pub fn to_fd(fd: i32) -> Fmt {\n");
        buf_str(out, c"        Fmt {\n");
        buf_str(out, c"            out: \"\", len: 0, need: 0, fd: fd, width: -1, prec: -1, flags: 0, mark: 0\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn str(inout self, s: [u8]) {\n");
        buf_str(out, c"        fmt_str(&self, s);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn byte(inout self, b: u8) {\n");
        buf_str(out, c"        let at = self.len;\n");
        buf_str(out, c"        if at < self.out.len {\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                self.out.ptr[at] = b;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.len = at + 1;\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.fd == FMT_FD && FMT_LEN < FMT_CAP {\n");
        buf_str(out, c"            let out: *u8 = &FMT_OUT[0];\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                out[FMT_LEN] = b;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            FMT_LEN += 1;\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        fmt_byte(&self, b);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Writes out what a Fmt to a file descriptor has buffered (print does).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn flush(inout self) {\n");
        buf_str(out, c"        if self.fd >= 0 {\n");
        buf_str(out, c"            fmt_flush();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // x's Display: `f.write(f\"({self.x}, {self.y})\")` in a Display impl.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn write<T: Display>(inout self, x: sink T) {\n");
        buf_str(out, c"        x.fmt(&self);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn display<T: Display>(inout self, x: T) {\n");
        buf_str(out, c"        x.fmt(&self);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn debug<T: Debug>(inout self, x: T) {\n");
        buf_str(out, c"        x.fmt_debug(&self);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The position written to.\n");
        buf_str(out, c"    fn pos(inout self) -> i64 {\n");
        buf_str(out, c"        if self.fd >= 0 { FMT_DONE + FMT_LEN } else { self.len }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Starts a hole with a spec (width w, precision p, -1: none; FMT_*\n");
        buf_str(out, c"    // flags): what is written up to end_spec, given the result, is padded\n");
        buf_str(out, c"    // to w. The buffer is first written out unless w bytes fit in it, so\n");
        buf_str(out, c"    // the hole's text is either all in it or at least w long.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn spec(inout self, w: i64, p: i64, flags: i64) -> FmtSpec {\n");
        buf_str(out, c"        let old = FmtSpec {\n");
        buf_str(out, c"            width: self.width, prec: self.prec, flags: self.flags, mark: self.mark\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        self.flags = flags;\n");
        buf_str(out, c"        if w > 0 || p >= 0 {\n");
        buf_str(out, c"            if self.fd >= 0 && (self.fd != FMT_FD || FMT_CAP - FMT_LEN < w) {\n");
        buf_str(out, c"                fmt_flush();\n");
        buf_str(out, c"                FMT_FD = self.fd;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.width = w;\n");
        buf_str(out, c"            self.prec = p;\n");
        buf_str(out, c"            self.flags = flags | FMT_PAD;\n");
        buf_str(out, c"            self.mark = self.pos();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        old\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Ends the hole `spec` started (`old`: what it returned).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn end_spec(inout self, old: FmtSpec) {\n");
        buf_str(out, c"        if (self.flags & FMT_PAD) != 0 {\n");
        buf_str(out, c"            fmt_pad(&self);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.width = old.width;\n");
        buf_str(out, c"        self.prec = old.prec;\n");
        buf_str(out, c"        self.flags = old.flags;\n");
        buf_str(out, c"        self.mark = old.mark;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // v in decimal (x, X, b: in hex or binary, as a u64; c: its low byte).\n");
        buf_str(out, c"    #[inline(never)]\n");
        buf_str(out, c"    pub fn int(inout self, v: i64) {\n");
        buf_str(out, c"        if self.flags != 0 {\n");
        buf_str(out, c"            if (self.flags & (FMT_HEX | FMT_BIN | FMT_CHAR)) != 0 {\n");
        buf_str(out, c"                fmt_radix(&self, v as u64);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                let negative = v < 0;\n");
        buf_str(out, c"                fmt_spec_decimal(&self, if negative { (-(v + 1)) as u64 + 1 } else { v as u64 },\n");
        buf_str(out, c"                    negative);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let negative = v < 0;\n");
        buf_str(out, c"        fmt_decimal(&self, if negative { (-(v + 1)) as u64 + 1 } else { v as u64 }, negative);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // v in decimal, hex (x, X), binary (b), or as a byte (c).\n");
        buf_str(out, c"    #[inline(never)]\n");
        buf_str(out, c"    pub fn uint(inout self, v: u64) {\n");
        buf_str(out, c"        if self.flags != 0 {\n");
        buf_str(out, c"            if (self.flags & (FMT_HEX | FMT_BIN | FMT_CHAR)) != 0 {\n");
        buf_str(out, c"                fmt_radix(&self, v);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                fmt_spec_decimal(&self, v, false);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        fmt_decimal(&self, v, false);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fmt::int and Fmt::uint with a spec of a decimal: u, after a '-' when\n");
        buf_str(out, c"// negative.\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_spec_decimal(f: inout Fmt, u: u64, negative: bool) {\n");
        buf_str(out, c"    fmt_number_start(&f);\n");
        buf_str(out, c"    fmt_decimal(&f, u, negative);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A number starts here: when nothing of the hole is written yet, the hole\n");
        buf_str(out, c"// is a number's (right-aligned, zero-padded after the sign).\n");
        buf_str(out, c"fn fmt_number_start(f: inout Fmt) {\n");
        buf_str(out, c"    if (f.flags & FMT_PAD) != 0 && f.pos() == f.mark {\n");
        buf_str(out, c"        f.flags |= FMT_NUM;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// v in hex or binary, or its low byte (c).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_radix(f: inout Fmt, v: u64) {\n");
        buf_str(out, c"    let flags = f.flags;\n");
        buf_str(out, c"    if (flags & FMT_CHAR) != 0 {\n");
        buf_str(out, c"        f.byte(v as u8);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    fmt_number_start(&f);\n");
        buf_str(out, c"    let shift: u64 = if (flags & FMT_HEX) != 0 { 4 } else { 1 };\n");
        buf_str(out, c"    let mask = (1u64 << shift) - 1;\n");
        buf_str(out, c"    let digits = if (flags & FMT_UPPER) != 0 { \"0123456789ABCDEF\" } else { \"0123456789abcdef\" };\n");
        buf_str(out, c"    var n = 1;\n");
        buf_str(out, c"    var bits = shift;\n");
        buf_str(out, c"    for _ in 0..64 {\n");
        buf_str(out, c"        if bits >= 64 || (v >> bits) == 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        n += 1;\n");
        buf_str(out, c"        bits += shift;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var out = fmt_room(&f, n);\n");
        buf_str(out, c"    if out.len != n {\n");
        buf_str(out, c"        out = fmt_make_room(&f, n);\n");
        buf_str(out, c"        if out.len != n {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var u = v;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let p = out.ptr;\n");
        buf_str(out, c"        for k in 0..n {\n");
        buf_str(out, c"            p[n - 1 - k] = digits.ptr[(u & mask) as i64];\n");
        buf_str(out, c"            u = u >> shift;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A signed integer of `bits` bits: in hex or binary as its unsigned value\n");
        buf_str(out, c"// of that size (Rust's `{:x}` of -1i8 is ff).\n");
        buf_str(out, c"pub fn fmt_signed(f: inout Fmt, v: i64, bits: u64) {\n");
        buf_str(out, c"    if v < 0 && (f.flags & (FMT_HEX | FMT_BIN)) != 0 {\n");
        buf_str(out, c"        f.uint((v as u64) & ((1u64 << bits) - 1));\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        f.int(v);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The padding and truncation of the hole f.spec started.\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_pad(f: inout Fmt) {\n");
        buf_str(out, c"    let flags = f.flags;\n");
        buf_str(out, c"    let start = f.mark;\n");
        buf_str(out, c"    var end = f.pos();\n");
        buf_str(out, c"    let number = (flags & FMT_NUM) != 0;\n");
        buf_str(out, c"    let reach = if f.fd >= 0 { start >= FMT_DONE && f.fd == FMT_FD } else { true };\n");
        buf_str(out, c"    // (a precision cuts text)\n");
        buf_str(out, c"    if f.prec >= 0 && !number && end - start > f.prec && reach {\n");
        buf_str(out, c"        end = start + f.prec;\n");
        buf_str(out, c"        if f.fd >= 0 {\n");
        buf_str(out, c"            FMT_LEN = end - FMT_DONE;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            f.len = end;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let pad = f.width - (end - start);\n");
        buf_str(out, c"    if pad <= 0 {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if (flags & FMT_LEFT) != 0 || (flags & FMT_RIGHT) == 0 && !number {\n");
        buf_str(out, c"        for i in 0..pad {\n");
        buf_str(out, c"            f.byte(' ');\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if !reach {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // Right-aligned: the text moves right by pad, after the sign when zeros\n");
        buf_str(out, c"    // fill.\n");
        buf_str(out, c"    let zeros = number && (flags & FMT_ZERO) != 0;\n");
        buf_str(out, c"    var text: *u8 = 0 as *u8;\n");
        buf_str(out, c"    var base = 0;\n");
        buf_str(out, c"    if f.fd >= 0 {\n");
        buf_str(out, c"        // (spec made room for the width)\n");
        buf_str(out, c"        text = &FMT_OUT[0];\n");
        buf_str(out, c"        base = FMT_DONE;\n");
        buf_str(out, c"        FMT_LEN += pad;\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        // (when the text was lost or the room is short: counted)\n");
        buf_str(out, c"        if f.need != 0 || f.len + pad > f.out.len {\n");
        buf_str(out, c"            fmt_lost(&f, pad);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        text = f.out.ptr;\n");
        buf_str(out, c"        f.len += pad;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var at = start - base;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        if zeros && end > start && (text[at] == '-' || text[at] == '+') {\n");
        buf_str(out, c"            at += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let count = end - base - at;\n");
        buf_str(out, c"        for k in 0..count {\n");
        buf_str(out, c"            let i = count - 1 - k;\n");
        buf_str(out, c"            text[at + pad + i] = text[at + i];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for k in 0..pad {\n");
        buf_str(out, c"            text[at + k] = if zeros { '0' } else { ' ' };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Text in quotes, escaped as Rust's Debug of a str does.\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"pub fn fmt_quoted(f: inout Fmt, s: [u8]) {\n");
        buf_str(out, c"    f.byte('\"');\n");
        buf_str(out, c"    var from = 0;\n");
        buf_str(out, c"    for i in 0..s.len {\n");
        buf_str(out, c"        let c = s[i];\n");
        buf_str(out, c"        if c == '\"' || c == '\\\\' || c < 32 || c == 127 {\n");
        buf_str(out, c"            f.str(s[from..i]);\n");
        buf_str(out, c"            from = i + 1;\n");
        buf_str(out, c"            f.byte('\\\\');\n");
        buf_str(out, c"            if c == '\\n' {\n");
        buf_str(out, c"                f.byte('n');\n");
        buf_str(out, c"            } else if c == '\\t' {\n");
        buf_str(out, c"                f.byte('t');\n");
        buf_str(out, c"            } else if c == '\\r' {\n");
        buf_str(out, c"                f.byte('r');\n");
        buf_str(out, c"            } else if c == 0 {\n");
        buf_str(out, c"                f.byte('0');\n");
        buf_str(out, c"            } else if c == '\"' || c == '\\\\' {\n");
        buf_str(out, c"                f.byte(c);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                let hex = \"0123456789abcdef\";\n");
        buf_str(out, c"                f.str(\"u{\");\n");
        buf_str(out, c"                if c >= 16 {\n");
        buf_str(out, c"                    f.byte(hex[(c >> 4) as i64]);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                f.byte(hex[(c & 15) as i64]);\n");
        buf_str(out, c"                f.byte('}');\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    f.str(s[from..s.len]);\n");
        buf_str(out, c"    f.byte('\"');\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The elements of s, as Debug writes a Vec: `[1, 2, 3]`.\n");
        buf_str(out, c"pub fn debug_list<T: Debug>(f: inout Fmt, s: [T]) {\n");
        buf_str(out, c"    f.byte('[');\n");
        buf_str(out, c"    for i in 0..s.len {\n");
        buf_str(out, c"        if i > 0 {\n");
        buf_str(out, c"            f.str(\", \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.debug(s[i]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    f.byte(']');\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An f-string's value: its holes' values, and a closure that writes the\n");
        buf_str(out, c"// text.\n");
        buf_str(out, c"pub struct Interp<F> { f: F }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<F: Fn(inout Fmt)> Display for Interp<F> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, out: inout Fmt) {\n");
        buf_str(out, c"        (self.f)(&out);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Fmt's holes (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The spec of the hole a Fmt was writing, which Fmt::spec saves and\n");
        buf_str(out, c"// end_spec puts back (0.16).\n");
        buf_str(out, c"pub struct FmtSpec { width: i64, prec: i64, flags: i64, mark: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Fmt {\n");
        buf_str(out, c"    // An f-string's hole of a decimal integer with a spec of width w and\n");
        buf_str(out, c"    // flags (`{n:>5}`, `{n:05}`): what spec, int and end_spec write, in one\n");
        buf_str(out, c"    // pass (0.16).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn int_hole(inout self, v: i64, w: i64, flags: i64) {\n");
        buf_str(out, c"        let negative = v < 0;\n");
        buf_str(out, c"        fmt_hole(&self, if negative { (-(v + 1)) as u64 + 1 } else { v as u64 }, negative, w,\n");
        buf_str(out, c"            flags);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn uint_hole(inout self, v: u64, w: i64, flags: i64) {\n");
        buf_str(out, c"        fmt_hole(&self, v, false, w, flags);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fmt::int_hole: u (after a '-' when negative) padded to w: with spaces\n");
        buf_str(out, c"// before it (after it: FMT_LEFT), or zeros after its sign (FMT_ZERO).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_hole(f: inout Fmt, u: u64, negative: bool, w: i64, flags: i64) {\n");
        buf_str(out, c"    let n = if negative { decimal_len(u) + 1 } else { decimal_len(u) };\n");
        buf_str(out, c"    let pad = w - n;\n");
        buf_str(out, c"    if pad <= 0 {\n");
        buf_str(out, c"        fmt_decimal(&f, u, negative);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if w > FMT_CAP {\n");
        buf_str(out, c"        // (as spec and end_spec do)\n");
        buf_str(out, c"        let old = f.spec(w, -1, flags);\n");
        buf_str(out, c"        fmt_number_start(&f);\n");
        buf_str(out, c"        fmt_decimal(&f, u, negative);\n");
        buf_str(out, c"        f.end_spec(old);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var out = fmt_room(&f, w);\n");
        buf_str(out, c"    if out.len != w {\n");
        buf_str(out, c"        out = fmt_make_room(&f, w);\n");
        buf_str(out, c"        if out.len != w {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let p = out.ptr;\n");
        buf_str(out, c"        if (flags & FMT_LEFT) != 0 {\n");
        buf_str(out, c"            put_decimal(p, n, u, negative);\n");
        buf_str(out, c"            for k in n..w {\n");
        buf_str(out, c"                p[k] = ' ';\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            put_decimal(&p[pad], n, u, negative);\n");
        buf_str(out, c"            let fill: u8 = if (flags & FMT_ZERO) != 0 { '0' } else { ' ' };\n");
        buf_str(out, c"            for k in 0..pad {\n");
        buf_str(out, c"                p[k] = fill;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if negative && fill == '0' {\n");
        buf_str(out, c"                p[0] = '-';\n");
        buf_str(out, c"                p[pad] = '0';\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Display and Debug of floats (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (A section of its own, read only by programs that have floats: a float\n");
        buf_str(out, c"// literal, `f64` or `f32`, an `import` (front/modules/stdsections.tach);\n");
        buf_str(out, c"// with it the shortest digits and the powers of ten.)\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for f64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) { fmt_float(&f, self, false, false); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for f64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) { fmt_float(&f, self, false, true); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for f32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) { fmt_float(&f, self as f64, true, false); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for f32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) { fmt_float(&f, self as f64, true, true); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Fmt {\n");
        buf_str(out, c"    // v as Display writes it: the shortest decimal that reads back as v,\n");
        buf_str(out, c"    // never with an exponent; with a precision, that many decimals.\n");
        buf_str(out, c"    pub fn float(inout self, v: f64) {\n");
        buf_str(out, c"        fmt_float(&self, v, false, false);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.20) `{:e}`, `{:E}` (with FMT_UPPER; fmt.tach's FMT_ flags): a\n");
        buf_str(out, c"// float's exponent form (fmt_float).\n");
        buf_str(out, c"const FMT_EXP: i64 = 512;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// v in decimal (single: an f32's value): the shortest digits that read\n");
        buf_str(out, c"// back as v (Schubfach, 0.20), never with an exponent for Display; Debug\n");
        buf_str(out, c"// as Rust writes it (`1.0`, `1e16`, `1e-7`); `{:e}`, `{:E}` (FMT_EXP) as\n");
        buf_str(out, c"// Rust's LowerExp and UpperExp (`1.5e3`). With a precision, that many\n");
        buf_str(out, c"// decimals (C's %.Nf; with `e`, %.Ne in Rust's layout).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_float(f: inout Fmt, v: f64, single: bool, debug: bool) {\n");
        buf_str(out, c"    if f.flags != 0 {\n");
        buf_str(out, c"        fmt_number_start(&f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if f.prec >= 0 && v == v && v - v == 0.0 {\n");
        buf_str(out, c"        fmt_float_prec(&f, v);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var mode = if debug { FloatFmt::Debug } else { FloatFmt::Display };\n");
        buf_str(out, c"    if (f.flags & FMT_EXP) != 0 {\n");
        buf_str(out, c"        mode = if (f.flags & FMT_UPPER) != 0 { FloatFmt::UpperExp } else { FloatFmt::LowerExp };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var tmp: [u8; 48] = [0; 48];\n");
        buf_str(out, c"    let n = if single { write_f32(v as f32, mode, tmp[..]) } else { write_f64(v, mode, tmp[..]) };\n");
        buf_str(out, c"    if n <= 48 {\n");
        buf_str(out, c"        f.str(tmp[0..n]);\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        fmt_float_long(&f, v, single, mode);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// fmt_float's text of more than 48 bytes (Display of 1e300).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_float_long(f: inout Fmt, v: f64, single: bool, mode: FloatFmt) {\n");
        buf_str(out, c"    var tmp: [u8; 336] = [0; 336];\n");
        buf_str(out, c"    let n = if single { write_f32(v as f32, mode, tmp[..]) } else { write_f64(v, mode, tmp[..]) };\n");
        buf_str(out, c"    f.str(tmp[0..n]);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// fmt_float with a precision, v finite: C's %.*f (FMT_EXP: %.*e, its\n");
        buf_str(out, c"// exponent then written as Rust's, `1.50e3`).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_float_prec(f: inout Fmt, v: f64) {\n");
        buf_str(out, c"    if (f.flags & FMT_EXP) == 0 {\n");
        buf_str(out, c"        var tmp: [u8; 64] = [0; 64];\n");
        buf_str(out, c"        let n = unsafe { snprintf(&tmp[0], 64, c\"%.*f\", f.prec as i32, v) } as i64;\n");
        buf_str(out, c"        if n < 64 {\n");
        buf_str(out, c"            f.str(tmp[0..n]);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            fmt_fixed_long(&f, v);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // (a double's exact digits end before the 770th: zeros after 1100)\n");
        buf_str(out, c"    let prec = if f.prec > 1100 { 1100 } else { f.prec };\n");
        buf_str(out, c"    var tmp: [u8; 1200] = [0; 1200];\n");
        buf_str(out, c"    let n = unsafe { snprintf(&tmp[0], 1200, c\"%.*e\", prec as i32, v) } as i64;\n");
        buf_str(out, c"    var i = 0;\n");
        buf_str(out, c"    while i < n && tmp[i] != 'e' {\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    f.str(tmp[0..i]);\n");
        buf_str(out, c"    for _ in prec..f.prec {\n");
        buf_str(out, c"        f.byte('0');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    f.byte(if (f.flags & FMT_UPPER) != 0 { 'E' } else { 'e' });\n");
        buf_str(out, c"    // e+05 is 5, e-05 is -5\n");
        buf_str(out, c"    var j = i + 1;\n");
        buf_str(out, c"    if j < n && tmp[j] == '-' {\n");
        buf_str(out, c"        f.byte('-');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    j += 1;\n");
        buf_str(out, c"    while j + 1 < n && tmp[j] == '0' {\n");
        buf_str(out, c"        j += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    f.str(tmp[j..n]);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// v with f's precision, of 64 bytes or more: C's %.*f into a buffer on\n");
        buf_str(out, c"// the stack (a double has at most 309 digits before the point and 1074\n");
        buf_str(out, c"// after it: from 1100 decimals on they are zeros, written after).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_fixed_long(f: inout Fmt, v: f64) {\n");
        buf_str(out, c"    let prec = if f.prec > 1100 { 1100 } else { f.prec };\n");
        buf_str(out, c"    var tmp: [u8; 1424] = [0; 1424];\n");
        buf_str(out, c"    let n = unsafe { snprintf(&tmp[0], 1424, c\"%.*f\", prec as i32, v) } as i64;\n");
        buf_str(out, c"    f.str(tmp[0..if n < 1424 { n } else { 1423 }]);\n");
        buf_str(out, c"    for _ in prec..f.prec {\n");
        buf_str(out, c"        f.byte('0');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::fmt ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::num ----\n");
        buf_str(out, c"pub mod num {\n");
        buf_str(out, c"// std::num: integer limits and bits (0.20: from flat/io.tach), and number\n");
        buf_str(out, c"// conversion (0.20): integers to and from text, the shortest digits of a\n");
        buf_str(out, c"// float, float text in Rust's formats, float parsing. The tables are\n");
        buf_str(out, c"// std::num::tables', made by tools/numtables/gen.tach.\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Debug, Display, Fmt, ParseIntError, decimal_len, panic_str};\n");
        buf_str(out, c"use tables::{LSHIFT_TABLE, POW10_128, POW10_MIN, POW5_DIGITS};\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub mod tables;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Integer limits (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The smallest and largest values of the integer types: the same as the\n");
        buf_str(out, c"// builtin `i32::MAX`, `u8::MIN`, ... (aliases, from before those).\n");
        buf_str(out, c"pub const I8_MIN: i8 = i8::MIN;\n");
        buf_str(out, c"pub const I8_MAX: i8 = i8::MAX;\n");
        buf_str(out, c"pub const I16_MIN: i16 = i16::MIN;\n");
        buf_str(out, c"pub const I16_MAX: i16 = i16::MAX;\n");
        buf_str(out, c"pub const I32_MIN: i32 = i32::MIN;\n");
        buf_str(out, c"pub const I32_MAX: i32 = i32::MAX;\n");
        buf_str(out, c"pub const I64_MIN: i64 = i64::MIN;\n");
        buf_str(out, c"pub const I64_MAX: i64 = i64::MAX;\n");
        buf_str(out, c"pub const U8_MAX: u8 = u8::MAX;\n");
        buf_str(out, c"pub const U16_MAX: u16 = u16::MAX;\n");
        buf_str(out, c"pub const U32_MAX: u32 = u32::MAX;\n");
        buf_str(out, c"pub const U64_MAX: u64 = u64::MAX;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Bits (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The number of 1 bits of x (a narrower unsigned value widens: `count_ones(m)`\n");
        buf_str(out, c"// of a u32 m). On AArch64 these three are instructions (cnt, clz, rbit\n");
        buf_str(out, c"// and clz); elsewhere these bodies, a few operations each.\n");
        buf_str(out, c"pub fn count_ones(x: u64) -> i64 {\n");
        buf_str(out, c"    let a = x - ((x >> 1) & 0x5555555555555555);\n");
        buf_str(out, c"    let b = (a & 0x3333333333333333) + ((a >> 2) & 0x3333333333333333);\n");
        buf_str(out, c"    let c = (b + (b >> 4)) & 0x0f0f0f0f0f0f0f0f;\n");
        buf_str(out, c"    ((c * 0x0101010101010101) >> 56) as i64\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The number of 0 bits above the highest 1 bit of x: 64 for 0, 0 when the\n");
        buf_str(out, c"// top bit is set.\n");
        buf_str(out, c"pub fn leading_zeros(x: u64) -> i64 {\n");
        buf_str(out, c"    // (the highest bit smeared down, then the ones it leaves counted)\n");
        buf_str(out, c"    var y = x | (x >> 1);\n");
        buf_str(out, c"    y = y | (y >> 2);\n");
        buf_str(out, c"    y = y | (y >> 4);\n");
        buf_str(out, c"    y = y | (y >> 8);\n");
        buf_str(out, c"    y = y | (y >> 16);\n");
        buf_str(out, c"    y = y | (y >> 32);\n");
        buf_str(out, c"    64 - count_ones(y)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The number of 0 bits below the lowest 1 bit of x: 64 for 0. For x != 0,\n");
        buf_str(out, c"// 1 << trailing_zeros(x) is x & -x, its lowest set bit.\n");
        buf_str(out, c"pub fn trailing_zeros(x: u64) -> i64 {\n");
        buf_str(out, c"    count_ones(~x & (x - 1))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Numbers: bits and wide products (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Number conversion (0.20, docs/design/collections-text-io.md §2.5.5):\n");
        buf_str(out, c"// integers to and from text, the shortest digits of a float (Schubfach),\n");
        buf_str(out, c"// float text in Rust's formats, and float parsing (Rust's dec2flt: Clinger's\n");
        buf_str(out, c"// fast path, Eisel and Lemire, the simple-decimal fallback). The tables are\n");
        buf_str(out, c"// numtables.tach's, made by tools/numtables/gen.tach. Every routine is a\n");
        buf_str(out, c"// function of its arguments and those immutable tables, and allocates\n");
        buf_str(out, c"// nothing.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// unsafe: only the bit casts below (a union read: both fields are 8 (or 4)\n");
        buf_str(out, c"// plain bytes, and every bit pattern is a valid f64 and u64).\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[repr(C)]\n");
        buf_str(out, c"union NumF64Bits { f: f64, u: u64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[repr(C)]\n");
        buf_str(out, c"union NumF32Bits { f: f32, u: u32 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// v's IEEE 754 bits (Rust's f64::to_bits).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn f64_to_bits(v: f64) -> u64 {\n");
        buf_str(out, c"    let b = NumF64Bits { f: v };\n");
        buf_str(out, c"    // (see the header: any bits are a valid u64)\n");
        buf_str(out, c"    unsafe { b.u }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The f64 with these IEEE 754 bits (Rust's f64::from_bits).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn f64_from_bits(u: u64) -> f64 {\n");
        buf_str(out, c"    let b = NumF64Bits { u: u };\n");
        buf_str(out, c"    // (see the header: any bits are a valid f64)\n");
        buf_str(out, c"    unsafe { b.f }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// v's IEEE 754 bits (Rust's f32::to_bits).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn f32_to_bits(v: f32) -> u32 {\n");
        buf_str(out, c"    let b = NumF32Bits { f: v };\n");
        buf_str(out, c"    // (see the header: any bits are a valid u32)\n");
        buf_str(out, c"    unsafe { b.u }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The f32 with these IEEE 754 bits (Rust's f32::from_bits).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn f32_from_bits(u: u32) -> f32 {\n");
        buf_str(out, c"    let b = NumF32Bits { u: u };\n");
        buf_str(out, c"    // (see the header: any bits are a valid f32)\n");
        buf_str(out, c"    unsafe { b.f }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The high 64 bits of the 128-bit product a * b.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn mul_hi(a: u64, b: u64) -> u64 {\n");
        buf_str(out, c"    let a0 = a & 0xffffffff;\n");
        buf_str(out, c"    let a1 = a >> 32;\n");
        buf_str(out, c"    let b0 = b & 0xffffffff;\n");
        buf_str(out, c"    let b1 = b >> 32;\n");
        buf_str(out, c"    let p01 = a0 * b1;\n");
        buf_str(out, c"    let p10 = a1 * b0;\n");
        buf_str(out, c"    let mid = ((a0 * b0) >> 32) + (p01 & 0xffffffff) + (p10 & 0xffffffff);\n");
        buf_str(out, c"    a1 * b1 + (p01 >> 32) + (p10 >> 32) + (mid >> 32)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The 128-bit product a * b as (high, low) (Rust: (a as u128) * (b as u128)).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn wide_mul(a: u64, b: u64) -> (u64, u64) {\n");
        buf_str(out, c"    (mul_hi(a, b), a * b)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Numbers: digits (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The digit pairs \"00\" to \"99\".\n");
        buf_str(out, c"const NUM_PAIRS: [u8] = \"00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899\";\n");
        buf_str(out, c"\n");
        buf_str(out, c"// x's decimal digits in out[at..at + n], n its number of digits\n");
        buf_str(out, c"// (decimal_len(x)), two at a time from the end.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn num_put_digits(out: [u8], at: i64, n: i64, x: u64) {\n");
        buf_str(out, c"    var i = at + n;\n");
        buf_str(out, c"    var v = x;\n");
        buf_str(out, c"    for _ in 0..5 {\n");
        buf_str(out, c"        if !(v >= 10000) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let q = v / 10000;\n");
        buf_str(out, c"        let r = v - q * 10000;\n");
        buf_str(out, c"        let hi = (r / 100) as i64 * 2;\n");
        buf_str(out, c"        let lo = (r % 100) as i64 * 2;\n");
        buf_str(out, c"        out[i - 4] = NUM_PAIRS[hi];\n");
        buf_str(out, c"        out[i - 3] = NUM_PAIRS[hi + 1];\n");
        buf_str(out, c"        out[i - 2] = NUM_PAIRS[lo];\n");
        buf_str(out, c"        out[i - 1] = NUM_PAIRS[lo + 1];\n");
        buf_str(out, c"        i -= 4;\n");
        buf_str(out, c"        v = q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if v >= 100 {\n");
        buf_str(out, c"        let q = v / 100;\n");
        buf_str(out, c"        let r = (v - q * 100) as i64 * 2;\n");
        buf_str(out, c"        out[i - 2] = NUM_PAIRS[r];\n");
        buf_str(out, c"        out[i - 1] = NUM_PAIRS[r + 1];\n");
        buf_str(out, c"        i -= 2;\n");
        buf_str(out, c"        v = q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if v >= 10 {\n");
        buf_str(out, c"        let r = v as i64 * 2;\n");
        buf_str(out, c"        out[i - 2] = NUM_PAIRS[r];\n");
        buf_str(out, c"        out[i - 1] = NUM_PAIRS[r + 1];\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        out[i - 1] = '0' + v as u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// s[i..i + 8] as a little-endian u64 (i + 8 <= s.len).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn num_load8(s: [u8], i: i64) -> u64 {\n");
        buf_str(out, c"    if i < 0 || i + 8 > s.len {\n");
        buf_str(out, c"        panic_str(\"num_load8: out of the slice\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // (unsafe: s[i..i + 8] is in the slice, checked above; an 8-byte load\n");
        buf_str(out, c"    // at any address is defined on AArch64 and x86-64, both little-endian,\n");
        buf_str(out, c"    // and the compiler assumes no alignment of a *u64 read)\n");
        buf_str(out, c"    unsafe { *(&s.ptr[i] as *u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether the 8 bytes of v are ASCII digits.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn num_is_8digits(v: u64) -> bool {\n");
        buf_str(out, c"    (((v + 0x4646464646464646) | (v - 0x3030303030303030)) & 0x8080808080808080) == 0\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The number the 8 ASCII digits of v spell, the first in the lowest byte\n");
        buf_str(out, c"// (SWAR: pairs, then fours, then the eight).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn num_parse_8digits(v: u64) -> u64 {\n");
        buf_str(out, c"    let x = v - 0x3030303030303030;\n");
        buf_str(out, c"    let y = x * 10 + (x >> 8);\n");
        buf_str(out, c"    (((y & 0x000000ff000000ff) * 0x000f424000000064)\n");
        buf_str(out, c"        + (((y >> 16) & 0x000000ff000000ff) * 0x0000271000000001)) >> 32\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Numbers: integer text (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// v's decimal digits at the end of out, out[start..20]: the start (Rust's\n");
        buf_str(out, c"// itoa; Display of a u64 is that text).\n");
        buf_str(out, c"pub fn fmt_u64(v: u64, out: inout [u8; 20]) -> i64 {\n");
        buf_str(out, c"    let n = decimal_len(v);\n");
        buf_str(out, c"    num_put_digits(out[..], 20 - n, n, v);\n");
        buf_str(out, c"    20 - n\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// v in decimal at the end of out, after a '-' when negative: the start.\n");
        buf_str(out, c"pub fn fmt_i64(v: i64, out: inout [u8; 20]) -> i64 {\n");
        buf_str(out, c"    let negative = v < 0;\n");
        buf_str(out, c"    let u = if negative { (-(v + 1)) as u64 + 1 } else { v as u64 };\n");
        buf_str(out, c"    let n = decimal_len(u);\n");
        buf_str(out, c"    num_put_digits(out[..], 20 - n, n, u);\n");
        buf_str(out, c"    if negative {\n");
        buf_str(out, c"        out[19 - n] = '-';\n");
        buf_str(out, c"        return 19 - n;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    20 - n\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The value of byte c as a digit of radix (2 to 36): 0-9, then a-z or\n");
        buf_str(out, c"// A-Z; radix or more when it is none.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn num_digit_value(c: u8, radix: u32) -> u32 {\n");
        buf_str(out, c"    let d = (c - '0') as u32;\n");
        buf_str(out, c"    if radix <= 10 || d < 10 {\n");
        buf_str(out, c"        return d;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let l = ((c | 0x20) - 'a') as u32;\n");
        buf_str(out, c"    if l < 26 { l + 10 } else { 36 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The first byte of s[i..] that is no digit of radix, as the error (an\n");
        buf_str(out, c"// overflow when there is none).\n");
        buf_str(out, c"fn num_overflow_or_digit(s: [u8], i: i64, radix: u32) -> ParseIntError {\n");
        buf_str(out, c"    for k in i..s.len {\n");
        buf_str(out, c"        if num_digit_value(s[k], radix) >= radix {\n");
        buf_str(out, c"            return ParseIntError::InvalidDigit(k);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    ParseIntError::Overflow\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The digits s[i..] in radix, as a u64 that may be at most `max`; Err as\n");
        buf_str(out, c"// parse_int reports them: the first byte that is no digit, else Overflow.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn num_parse_digits_u64(s: [u8], start: i64, radix: u32, max: u64) -> Result<u64, ParseIntError> {\n");
        buf_str(out, c"    var i = start;\n");
        buf_str(out, c"    let len = s.len;\n");
        buf_str(out, c"    var v: u64 = 0;\n");
        buf_str(out, c"    if radix == 10 && len - i <= 18 {\n");
        buf_str(out, c"        // (at most 18 digits: no overflow; 8 at a time)\n");
        buf_str(out, c"        for _ in 0..s.len + 1 {\n");
        buf_str(out, c"            if !(i + 8 <= len) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let w = num_load8(s, i);\n");
        buf_str(out, c"            if !num_is_8digits(w) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            v = v * 100000000 + num_parse_8digits(w);\n");
        buf_str(out, c"            i += 8;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for _ in 0..s.len + 1 {\n");
        buf_str(out, c"            if !(i < len) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let d = s[i] - '0';\n");
        buf_str(out, c"            if d >= 10 {\n");
        buf_str(out, c"                return Result::Err(ParseIntError::InvalidDigit(i));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            v = v * 10 + d as u64;\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if v > max {\n");
        buf_str(out, c"            return Result::Err(ParseIntError::Overflow);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return Result::Ok(v);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let r = radix as u64;\n");
        buf_str(out, c"    let limit = max / r;\n");
        buf_str(out, c"    for _ in 0..s.len + 1 {\n");
        buf_str(out, c"        if !(i < len) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let d = num_digit_value(s[i], radix);\n");
        buf_str(out, c"        if d >= radix {\n");
        buf_str(out, c"            return Result::Err(ParseIntError::InvalidDigit(i));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if v > limit || v * r > max - d as u64 {\n");
        buf_str(out, c"            return Result::Err(num_overflow_or_digit(s, i, radix));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v = v * r + d as u64;\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    Result::Ok(v)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn num_check_radix(radix: u32) {\n");
        buf_str(out, c"    if radix < 2 || radix > 36 {\n");
        buf_str(out, c"        panic_str(\"from_str_radix_int: must lie in the range `[2, 36]`\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// s as a u64 in radix (2 to 36; else a panic): Rust's u64::from_str_radix:\n");
        buf_str(out, c"// an optional '+', then digits (0-9, a-z or A-Z), nothing else. Err: Empty;\n");
        buf_str(out, c"// InvalidDigit(i), the index of the first byte that is no digit (a lone\n");
        buf_str(out, c"// '+' too); Overflow.\n");
        buf_str(out, c"pub fn parse_u64_radix(s: [u8], radix: u32) -> Result<u64, ParseIntError> {\n");
        buf_str(out, c"    num_check_radix(radix);\n");
        buf_str(out, c"    if s.len == 0 {\n");
        buf_str(out, c"        return Result::Err(ParseIntError::Empty);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let start = if s[0] == '+' { 1 } else { 0 };\n");
        buf_str(out, c"    if start == s.len {\n");
        buf_str(out, c"        return Result::Err(ParseIntError::InvalidDigit(0));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    num_parse_digits_u64(s, start, radix, 0xffffffffffffffff)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// s as an i64 in radix (2 to 36; else a panic): Rust's i64::from_str_radix:\n");
        buf_str(out, c"// an optional '+' or '-', then digits, nothing else; errors as\n");
        buf_str(out, c"// parse_u64_radix's (Overflow on either side).\n");
        buf_str(out, c"pub fn parse_i64_radix(s: [u8], radix: u32) -> Result<i64, ParseIntError> {\n");
        buf_str(out, c"    num_check_radix(radix);\n");
        buf_str(out, c"    if s.len == 0 {\n");
        buf_str(out, c"        return Result::Err(ParseIntError::Empty);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let negative = s[0] == '-';\n");
        buf_str(out, c"    let start = if negative || s[0] == '+' { 1 } else { 0 };\n");
        buf_str(out, c"    if start == s.len {\n");
        buf_str(out, c"        return Result::Err(ParseIntError::InvalidDigit(0));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    num_parse_i64_from(s, start, radix, negative)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// parse_i64_radix after the sign (s[start..] not empty).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn num_parse_i64_from(s: [u8], start: i64, radix: u32, negative: bool) -> Result<i64,\n");
        buf_str(out, c"    ParseIntError> {\n");
        buf_str(out, c"    let max: u64 = if negative { 0x8000000000000000 } else { 0x7fffffffffffffff };\n");
        buf_str(out, c"    match num_parse_digits_u64(s, start, radix, max) {\n");
        buf_str(out, c"        Result::Ok(u) => Result::Ok(if negative { (0 - u) as i64 } else { u as i64 }),\n");
        buf_str(out, c"        Result::Err(e) => Result::Err(e),\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Numbers: the shortest digits of a float (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Schubfach (Giulietti, \"The Schubfach way to render doubles\", 2020; the\n");
        buf_str(out, c"// layout of Bolz's C++ port): the shortest decimal d * 10^k in v's rounding\n");
        buf_str(out, c"// interval, the closest to v of those (ties to an even d). Rust's Display\n");
        buf_str(out, c"// and Debug write the same digits (Grisu with Dragon4's fallback finds\n");
        buf_str(out, c"// them too).\n");
        buf_str(out, c"\n");
        buf_str(out, c"// g * cp / 2^128 rounded to odd (g = (ghi, glo), 128 bits).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn num_round_to_odd64(ghi: u64, glo: u64, cp: u64) -> u64 {\n");
        buf_str(out, c"    let x1 = mul_hi(glo, cp);\n");
        buf_str(out, c"    let y1 = mul_hi(ghi, cp);\n");
        buf_str(out, c"    let y0 = ghi * cp;\n");
        buf_str(out, c"    let z = y0 + x1;\n");
        buf_str(out, c"    let hi = if z < x1 { y1 + 1 } else { y1 };\n");
        buf_str(out, c"    if z > 1 { hi | 1 } else { hi }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The shortest decimal of a positive finite double given as its fields\n");
        buf_str(out, c"// (significand bits f, biased exponent e): (d, k), d possibly with\n");
        buf_str(out, c"// trailing zeros.\n");
        buf_str(out, c"fn num_schubfach64(f: u64, e: i64) -> (u64, i64) {\n");
        buf_str(out, c"    var c = f;\n");
        buf_str(out, c"    var q: i64 = -1074;\n");
        buf_str(out, c"    if e != 0 {\n");
        buf_str(out, c"        c = f | 0x10000000000000;\n");
        buf_str(out, c"        q = e - 1075;\n");
        buf_str(out, c"        // (an integer: itself)\n");
        buf_str(out, c"        if q <= 0 && q > -53 && (c & ((1 << (-q) as u64) - 1)) == 0 {\n");
        buf_str(out, c"            return (c >> (-q) as u64, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let even = (c & 1) == 0;\n");
        buf_str(out, c"    let closer = f == 0 && e > 1;\n");
        buf_str(out, c"    let cbl = if closer { 4 * c - 1 } else { 4 * c - 2 };\n");
        buf_str(out, c"    let cb = 4 * c;\n");
        buf_str(out, c"    let cbr = 4 * c + 2;\n");
        buf_str(out, c"    // k = floor(log10(2^q)), or floor(log10(3/4 2^q)) when the lower\n");
        buf_str(out, c"    // boundary is closer; h = q + floor(log2(10^-k)) + 1, from 1 to 4\n");
        buf_str(out, c"    let k = (q * 1262611 - (if closer { 524031 } else { 0 })) >> 22;\n");
        buf_str(out, c"    let h = (q + ((-k * 1741647) >> 19) + 1) as u64;\n");
        buf_str(out, c"    let at = 2 * (-k - POW10_MIN);\n");
        buf_str(out, c"    let ghi0 = POW10_128[at];\n");
        buf_str(out, c"    let glo = POW10_128[at + 1] + 1;\n");
        buf_str(out, c"    let ghi = if glo == 0 { ghi0 + 1 } else { ghi0 };\n");
        buf_str(out, c"    let vbl = num_round_to_odd64(ghi, glo, cbl << h);\n");
        buf_str(out, c"    let vb = num_round_to_odd64(ghi, glo, cb << h);\n");
        buf_str(out, c"    let vbr = num_round_to_odd64(ghi, glo, cbr << h);\n");
        buf_str(out, c"    let lower = if even { vbl } else { vbl + 1 };\n");
        buf_str(out, c"    let upper = if even { vbr } else { vbr - 1 };\n");
        buf_str(out, c"    let s = vb / 4;\n");
        buf_str(out, c"    if s >= 10 {\n");
        buf_str(out, c"        // (one digit fewer: at most one of u' and w' is inside)\n");
        buf_str(out, c"        let sp = s / 10;\n");
        buf_str(out, c"        let up_inside = lower <= 40 * sp;\n");
        buf_str(out, c"        let wp_inside = 40 * sp + 40 <= upper;\n");
        buf_str(out, c"        if up_inside != wp_inside {\n");
        buf_str(out, c"            return (if wp_inside { sp + 1 } else { sp }, k + 1);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let u_inside = lower <= 4 * s;\n");
        buf_str(out, c"    let w_inside = 4 * s + 4 <= upper;\n");
        buf_str(out, c"    if u_inside != w_inside {\n");
        buf_str(out, c"        return (if w_inside { s + 1 } else { s }, k);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // (vb, odd when inexact, equals mid only on an exact tie: up, as Rust's\n");
        buf_str(out, c"    // Grisu and Dragon4 round it, where Schubfach's paper rounds to even)\n");
        buf_str(out, c"    let mid = 4 * s + 2;\n");
        buf_str(out, c"    (if vb >= mid { s + 1 } else { s }, k)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// g * cp / 2^64 rounded to odd (g 64 bits, cp less than 2^32).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn num_round_to_odd32(g: u64, cp: u64) -> u64 {\n");
        buf_str(out, c"    let b01 = cp * (g & 0xffffffff);\n");
        buf_str(out, c"    let b11 = cp * (g >> 32);\n");
        buf_str(out, c"    let hi = b11 + (b01 >> 32);\n");
        buf_str(out, c"    let y1 = hi >> 32;\n");
        buf_str(out, c"    if (hi & 0xffffffff) > 1 { y1 | 1 } else { y1 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// num_schubfach64 for a float (f: 23 bits, e: 8).\n");
        buf_str(out, c"fn num_schubfach32(f: u64, e: i64) -> (u64, i64) {\n");
        buf_str(out, c"    var c = f;\n");
        buf_str(out, c"    var q: i64 = -149;\n");
        buf_str(out, c"    if e != 0 {\n");
        buf_str(out, c"        c = f | 0x800000;\n");
        buf_str(out, c"        q = e - 150;\n");
        buf_str(out, c"        if q <= 0 && q > -24 && (c & ((1 << (-q) as u64) - 1)) == 0 {\n");
        buf_str(out, c"            return (c >> (-q) as u64, 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let even = (c & 1) == 0;\n");
        buf_str(out, c"    let closer = f == 0 && e > 1;\n");
        buf_str(out, c"    let cbl = if closer { 4 * c - 1 } else { 4 * c - 2 };\n");
        buf_str(out, c"    let cb = 4 * c;\n");
        buf_str(out, c"    let cbr = 4 * c + 2;\n");
        buf_str(out, c"    let k = (q * 1262611 - (if closer { 524031 } else { 0 })) >> 22;\n");
        buf_str(out, c"    let h = (q + ((-k * 1741647) >> 19) + 1) as u64;\n");
        buf_str(out, c"    let g = POW10_128[2 * (-k - POW10_MIN)] + 1;\n");
        buf_str(out, c"    let vbl = num_round_to_odd32(g, cbl << h);\n");
        buf_str(out, c"    let vb = num_round_to_odd32(g, cb << h);\n");
        buf_str(out, c"    let vbr = num_round_to_odd32(g, cbr << h);\n");
        buf_str(out, c"    let lower = if even { vbl } else { vbl + 1 };\n");
        buf_str(out, c"    let upper = if even { vbr } else { vbr - 1 };\n");
        buf_str(out, c"    let s = vb / 4;\n");
        buf_str(out, c"    if s >= 10 {\n");
        buf_str(out, c"        let sp = s / 10;\n");
        buf_str(out, c"        let up_inside = lower <= 40 * sp;\n");
        buf_str(out, c"        let wp_inside = 40 * sp + 40 <= upper;\n");
        buf_str(out, c"        if up_inside != wp_inside {\n");
        buf_str(out, c"            return (if wp_inside { sp + 1 } else { sp }, k + 1);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let u_inside = lower <= 4 * s;\n");
        buf_str(out, c"    let w_inside = 4 * s + 4 <= upper;\n");
        buf_str(out, c"    if u_inside != w_inside {\n");
        buf_str(out, c"        return (if w_inside { s + 1 } else { s }, k);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // (vb, odd when inexact, equals mid only on an exact tie: up, as Rust's\n");
        buf_str(out, c"    // Grisu and Dragon4 round it, where Schubfach's paper rounds to even)\n");
        buf_str(out, c"    let mid = 4 * s + 2;\n");
        buf_str(out, c"    (if vb >= mid { s + 1 } else { s }, k)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (d, k) without d's trailing zeros (d != 0).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn num_trim_zeros(d: u64, k: i64) -> (u64, i64) {\n");
        buf_str(out, c"    var x = d;\n");
        buf_str(out, c"    var e = k;\n");
        buf_str(out, c"    for _ in 0..20 {\n");
        buf_str(out, c"        if !(x % 10 == 0) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        x = x / 10;\n");
        buf_str(out, c"        e += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    (x, e)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The shortest decimal of |v|, finite: (d, k), |v| reads back from d *\n");
        buf_str(out, c"// 10^k, d without trailing zeros (0 for a zero: (0, 0)). Those are the\n");
        buf_str(out, c"// digits Rust prints. Not finite: (0, 0).\n");
        buf_str(out, c"pub fn f64_shortest(v: f64) -> (u64, i32) {\n");
        buf_str(out, c"    let bits = f64_to_bits(v);\n");
        buf_str(out, c"    let f = bits & 0xfffffffffffff;\n");
        buf_str(out, c"    let e = ((bits >> 52) & 0x7ff) as i64;\n");
        buf_str(out, c"    if e == 0x7ff || (e == 0 && f == 0) {\n");
        buf_str(out, c"        return (0, 0);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let (d, k) = num_schubfach64(f, e);\n");
        buf_str(out, c"    let (d2, k2) = num_trim_zeros(d, k);\n");
        buf_str(out, c"    (d2, k2 as i32)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// f64_shortest for an f32: the shortest digits that read back as v as an f32.\n");
        buf_str(out, c"pub fn f32_shortest(v: f32) -> (u64, i32) {\n");
        buf_str(out, c"    let bits = f32_to_bits(v) as u64;\n");
        buf_str(out, c"    let f = bits & 0x7fffff;\n");
        buf_str(out, c"    let e = ((bits >> 23) & 0xff) as i64;\n");
        buf_str(out, c"    if e == 0xff || (e == 0 && f == 0) {\n");
        buf_str(out, c"        return (0, 0);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let (d, k) = num_schubfach32(f, e);\n");
        buf_str(out, c"    let (d2, k2) = num_trim_zeros(d, k);\n");
        buf_str(out, c"    (d2, k2 as i32)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Numbers: float text (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// How write_f64 and write_f32 lay a float out, as Rust's formats do:\n");
        buf_str(out, c"// Display (`{}`) never with an exponent (`1e16` is `10000000000000000`,\n");
        buf_str(out, c"// `1e-7` is `0.0000001`); Debug (`{:?}`): `1.0`, and an exponent below\n");
        buf_str(out, c"// 1e-4 and from 1e16 on (`1e16`, `1e-7`); LowerExp (`{:e}`): `1.5e3`,\n");
        buf_str(out, c"// `0e0`; UpperExp (`{:E}`): `1.5E3`. All with the shortest digits that\n");
        buf_str(out, c"// read back as the value; `NaN`, `inf`, `-inf`.\n");
        buf_str(out, c"pub enum FloatFmt { Display, Debug, LowerExp, UpperExp }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The longest text write_f64 writes: 330 bytes (a sign, `0.`, 323 zeros\n");
        buf_str(out, c"// and digits; Display of the smallest subnormal).\n");
        buf_str(out, c"pub const FLOAT_TEXT_MAX: i64 = 330;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The text of (a '-' when negative) d * 10^k in mode, d without trailing\n");
        buf_str(out, c"// zeros (0: zero), into out[0..len] when it fits: len.\n");
        buf_str(out, c"fn num_float_text(out: [u8], negative: bool, d: u64, k: i64, mode: FloatFmt) -> i64 {\n");
        buf_str(out, c"    let n = decimal_len(d);\n");
        buf_str(out, c"    let e = k + n - 1;\n");
        buf_str(out, c"    let i = if negative { 1 } else { 0 };\n");
        buf_str(out, c"    let debug = mode == FloatFmt::Debug;\n");
        buf_str(out, c"    if mode == FloatFmt::LowerExp || mode == FloatFmt::UpperExp\n");
        buf_str(out, c"        || (debug && d != 0 && (e < -4 || e >= 16)) {\n");
        buf_str(out, c"        // d[.ddd]e[-]x\n");
        buf_str(out, c"        let ae = if e < 0 { -e } else { e };\n");
        buf_str(out, c"        let elen = decimal_len(ae as u64);\n");
        buf_str(out, c"        let point = if n > 1 { 1 } else { 0 };\n");
        buf_str(out, c"        let minus = if e < 0 { 1 } else { 0 };\n");
        buf_str(out, c"        let len = i + n + point + 1 + minus + elen;\n");
        buf_str(out, c"        if len > out.len {\n");
        buf_str(out, c"            return len;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if negative {\n");
        buf_str(out, c"            out[0] = '-';\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        num_put_digits(out, i + 1, n, d);\n");
        buf_str(out, c"        out[i] = out[i + 1];\n");
        buf_str(out, c"        var j = i + 1;\n");
        buf_str(out, c"        if n > 1 {\n");
        buf_str(out, c"            out[i + 1] = '.';\n");
        buf_str(out, c"            j = i + n + 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out[j] = if mode == FloatFmt::UpperExp { 'E' } else { 'e' };\n");
        buf_str(out, c"        if e < 0 {\n");
        buf_str(out, c"            out[j + 1] = '-';\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        num_put_digits(out, j + 1 + minus, elen, ae as u64);\n");
        buf_str(out, c"        return len;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if e < 0 {\n");
        buf_str(out, c"        // 0.000ddd\n");
        buf_str(out, c"        let zeros = -e - 1;\n");
        buf_str(out, c"        let len = i + 2 + zeros + n;\n");
        buf_str(out, c"        if len > out.len {\n");
        buf_str(out, c"            return len;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if negative {\n");
        buf_str(out, c"            out[0] = '-';\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out[i] = '0';\n");
        buf_str(out, c"        out[i + 1] = '.';\n");
        buf_str(out, c"        for z in 0..zeros {\n");
        buf_str(out, c"            out[i + 2 + z] = '0';\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        num_put_digits(out, i + 2 + zeros, n, d);\n");
        buf_str(out, c"        return len;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if k >= 0 {\n");
        buf_str(out, c"        // ddd000 (Debug: ddd000.0)\n");
        buf_str(out, c"        let len = i + n + k + (if debug { 2 } else { 0 });\n");
        buf_str(out, c"        if len > out.len {\n");
        buf_str(out, c"            return len;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if negative {\n");
        buf_str(out, c"            out[0] = '-';\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        num_put_digits(out, i, n, d);\n");
        buf_str(out, c"        for z in 0..k {\n");
        buf_str(out, c"            out[i + n + z] = '0';\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if debug {\n");
        buf_str(out, c"            out[i + n + k] = '.';\n");
        buf_str(out, c"            out[i + n + k + 1] = '0';\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return len;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // dd.ddd: the digits one further, then the integer part moved back\n");
        buf_str(out, c"    let len = i + n + 1;\n");
        buf_str(out, c"    if len > out.len {\n");
        buf_str(out, c"        return len;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if negative {\n");
        buf_str(out, c"        out[0] = '-';\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    num_put_digits(out, i + 1, n, d);\n");
        buf_str(out, c"    for j in i..i + e + 1 {\n");
        buf_str(out, c"        out[j] = out[j + 1];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    out[i + e + 1] = '.';\n");
        buf_str(out, c"    len\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The text of NaN or an infinity in out, when it fits: its length.\n");
        buf_str(out, c"fn num_float_special(out: [u8], nan: bool, negative: bool) -> i64 {\n");
        buf_str(out, c"    let t = if nan { \"NaN\" } else if negative { \"-inf\" } else { \"inf\" };\n");
        buf_str(out, c"    if t.len <= out.len {\n");
        buf_str(out, c"        for j in 0..t.len {\n");
        buf_str(out, c"            out[j] = t[j];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    t.len\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// v's text in mode (FloatFmt) into out when it fits (FLOAT_TEXT_MAX bytes\n");
        buf_str(out, c"// always do): its length. As Rust's `{}`, `{:?}`, `{:e}`, `{:E}`.\n");
        buf_str(out, c"pub fn write_f64(v: f64, mode: FloatFmt, out: [u8]) -> i64 {\n");
        buf_str(out, c"    let bits = f64_to_bits(v);\n");
        buf_str(out, c"    let negative = (bits >> 63) != 0;\n");
        buf_str(out, c"    let f = bits & 0xfffffffffffff;\n");
        buf_str(out, c"    let e = ((bits >> 52) & 0x7ff) as i64;\n");
        buf_str(out, c"    if e == 0x7ff {\n");
        buf_str(out, c"        return num_float_special(out, f != 0, negative);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if e == 0 && f == 0 {\n");
        buf_str(out, c"        return num_float_text(out, negative, 0, 0, mode);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let (d, k) = num_schubfach64(f, e);\n");
        buf_str(out, c"    let (d2, k2) = num_trim_zeros(d, k);\n");
        buf_str(out, c"    num_float_text(out, negative, d2, k2, mode)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// write_f64 for an f32: its own shortest digits (0.1f32 is `0.1`).\n");
        buf_str(out, c"pub fn write_f32(v: f32, mode: FloatFmt, out: [u8]) -> i64 {\n");
        buf_str(out, c"    let bits = f32_to_bits(v) as u64;\n");
        buf_str(out, c"    let negative = (bits >> 31) != 0;\n");
        buf_str(out, c"    let f = bits & 0x7fffff;\n");
        buf_str(out, c"    let e = ((bits >> 23) & 0xff) as i64;\n");
        buf_str(out, c"    if e == 0xff {\n");
        buf_str(out, c"        return num_float_special(out, f != 0, negative);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if e == 0 && f == 0 {\n");
        buf_str(out, c"        return num_float_text(out, negative, 0, 0, mode);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let (d, k) = num_schubfach32(f, e);\n");
        buf_str(out, c"    let (d2, k2) = num_trim_zeros(d, k);\n");
        buf_str(out, c"    num_float_text(out, negative, d2, k2, mode)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Numbers: float parsing (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Why parse_f64 failed (Rust's ParseFloatError): the text is empty, or it\n");
        buf_str(out, c"// is no float.\n");
        buf_str(out, c"pub enum ParseFloatError { Empty, Invalid }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for ParseFloatError {\n");
        buf_str(out, c"    fn fmt(self, f: inout Fmt) {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            ParseFloatError::Empty => f.str(\"cannot parse float from empty string\"),\n");
        buf_str(out, c"            ParseFloatError::Invalid => f.str(\"invalid float literal\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for ParseFloatError {\n");
        buf_str(out, c"    fn fmt_debug(self, f: inout Fmt) {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            ParseFloatError::Empty => f.str(\"Empty\"),\n");
        buf_str(out, c"            ParseFloatError::Invalid => f.str(\"Invalid\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// s as the nearest f64 (ties to even): Rust's f64::from_str. An optional\n");
        buf_str(out, c"// '+' or '-', then digits with an optional '.' (`1.`, `.5`; at least one\n");
        buf_str(out, c"// digit), then an optional exponent (`e` or `E`, an optional sign,\n");
        buf_str(out, c"// digits); or `inf`, `infinity`, `nan` in any case. Nothing else: no\n");
        buf_str(out, c"// spaces, no `_`, no hex. Too large is an infinity, too small a zero.\n");
        buf_str(out, c"pub fn parse_f64(s: [u8]) -> Result<f64, ParseFloatError> {\n");
        buf_str(out, c"    match num_dec2flt(s, false) {\n");
        buf_str(out, c"        Result::Ok(bits) => Result::Ok(f64_from_bits(bits)),\n");
        buf_str(out, c"        Result::Err(e) => Result::Err(e),\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// parse_f64 for an f32: rounded once, to the nearest f32 (not through f64).\n");
        buf_str(out, c"pub fn parse_f32(s: [u8]) -> Result<f32, ParseFloatError> {\n");
        buf_str(out, c"    match num_dec2flt(s, true) {\n");
        buf_str(out, c"        Result::Ok(bits) => Result::Ok(f32_from_bits(bits as u32)),\n");
        buf_str(out, c"        Result::Err(e) => Result::Err(e),\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The decimal a text spells: mantissa * 10^exponent, the mantissa its\n");
        buf_str(out, c"// first 19 significant digits when there are more (many_digits).\n");
        buf_str(out, c"struct NumDecimalParts { mantissa: u64, exponent: i64, many_digits: bool }\n");
        buf_str(out, c"\n");
        buf_str(out, c"const NUM_MIN_19DIGIT: u64 = 1000000000000000000;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The digits at s[i..] appended to *m (wrapping), 8 at a time while they\n");
        buf_str(out, c"// last: the index after them.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn num_take_digits(s: [u8], start: i64, m: inout u64) -> i64 {\n");
        buf_str(out, c"    var i = start;\n");
        buf_str(out, c"    let len = s.len;\n");
        buf_str(out, c"    var v = m;\n");
        buf_str(out, c"    for _ in 0..s.len + 1 {\n");
        buf_str(out, c"        if !(i + 8 <= len) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let w = num_load8(s, i);\n");
        buf_str(out, c"        if !num_is_8digits(w) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v = v * 100000000 + num_parse_8digits(w);\n");
        buf_str(out, c"        i += 8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for _ in 0..s.len + 1 {\n");
        buf_str(out, c"        if !(i < len) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let d = s[i] - '0';\n");
        buf_str(out, c"        if d >= 10 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v = v * 10 + d as u64;\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    m = v;\n");
        buf_str(out, c"    i\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// num_take_digits until *m has 19 digits.\n");
        buf_str(out, c"fn num_take_19digits(s: [u8], start: i64, m: inout u64) -> i64 {\n");
        buf_str(out, c"    var i = start;\n");
        buf_str(out, c"    var v = m;\n");
        buf_str(out, c"    for _ in 0..s.len + 1 {\n");
        buf_str(out, c"        if !(v < NUM_MIN_19DIGIT && i < s.len) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let d = s[i] - '0';\n");
        buf_str(out, c"        if d >= 10 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v = v * 10 + d as u64;\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    m = v;\n");
        buf_str(out, c"    i\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// s (without its sign) as a decimal (Rust's parse_number); false when it\n");
        buf_str(out, c"// is not one.\n");
        buf_str(out, c"fn num_parse_number(s: [u8], out: inout NumDecimalParts) -> bool {\n");
        buf_str(out, c"    let len = s.len;\n");
        buf_str(out, c"    var mantissa: u64 = 0;\n");
        buf_str(out, c"    var i = num_take_digits(s, 0, &mantissa);\n");
        buf_str(out, c"    let int_end = i;\n");
        buf_str(out, c"    var n_digits = i;\n");
        buf_str(out, c"    var exponent: i64 = 0;\n");
        buf_str(out, c"    if i < len && s[i] == '.' {\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"        let before = i;\n");
        buf_str(out, c"        i = num_take_digits(s, i, &mantissa);\n");
        buf_str(out, c"        n_digits += i - before;\n");
        buf_str(out, c"        exponent = before - i;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if n_digits == 0 {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var exp_number: i64 = 0;\n");
        buf_str(out, c"    if i < len && (s[i] == 'e' || s[i] == 'E') {\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"        var negative = false;\n");
        buf_str(out, c"        if i < len && (s[i] == '-' || s[i] == '+') {\n");
        buf_str(out, c"            negative = s[i] == '-';\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if i >= len || s[i] - '0' >= 10 {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for _ in 0..s.len + 1 {\n");
        buf_str(out, c"            if !(i < len && s[i] - '0' < 10) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if exp_number < 0x10000 {\n");
        buf_str(out, c"                exp_number = 10 * exp_number + (s[i] - '0') as i64;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if negative {\n");
        buf_str(out, c"            exp_number = -exp_number;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        exponent += exp_number;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if i != len {\n");
        buf_str(out, c"        return false;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    out.mantissa = mantissa;\n");
        buf_str(out, c"    out.exponent = exponent;\n");
        buf_str(out, c"    out.many_digits = false;\n");
        buf_str(out, c"    if n_digits <= 19 {\n");
        buf_str(out, c"        return true;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // More than 19 digits, but maybe leading zeros\n");
        buf_str(out, c"    n_digits -= 19;\n");
        buf_str(out, c"    var p = 0;\n");
        buf_str(out, c"    for _ in 0..s.len + 1 {\n");
        buf_str(out, c"        if !(p < len && (s[p] == '.' || s[p] == '0')) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s[p] == '0' {\n");
        buf_str(out, c"            n_digits -= 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        p += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if n_digits > 0 {\n");
        buf_str(out, c"        // 19 significant digits, then the exponent of what follows them\n");
        buf_str(out, c"        out.many_digits = true;\n");
        buf_str(out, c"        var m: u64 = 0;\n");
        buf_str(out, c"        var j = num_take_19digits(s, 0, &m);\n");
        buf_str(out, c"        if m >= NUM_MIN_19DIGIT {\n");
        buf_str(out, c"            out.exponent = int_end - j + exp_number;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            // (stopped at the point)\n");
        buf_str(out, c"            j += 1;\n");
        buf_str(out, c"            let before = j;\n");
        buf_str(out, c"            j = num_take_19digits(s, j, &m);\n");
        buf_str(out, c"            out.exponent = before - j + exp_number;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        out.mantissa = m;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    true\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `inf`, `infinity` or `nan` in any case: (true, their bits); (false, 0)\n");
        buf_str(out, c"// when s is none.\n");
        buf_str(out, c"fn num_parse_inf_nan(s: [u8], negative: bool, single: bool) -> (bool, u64) {\n");
        buf_str(out, c"    var r: u64 = 0;\n");
        buf_str(out, c"    if s.len == 8 {\n");
        buf_str(out, c"        r = num_load8(s, 0);\n");
        buf_str(out, c"    } else if s.len == 3 {\n");
        buf_str(out, c"        r = (s[0] as u64) | ((s[1] as u64) << 8) | ((s[2] as u64) << 16);\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        return (false, 0);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // (upper case: bit 5 cleared; only a letter maps to a letter)\n");
        buf_str(out, c"    r = r & 0xdfdfdfdfdfdfdfdf;\n");
        buf_str(out, c"    let inf = (s.len == 3 && r == 0x464e49) || (s.len == 8 && r == 0x5954494e49464e49);\n");
        buf_str(out, c"    let nan = s.len == 3 && r == 0x4e414e;\n");
        buf_str(out, c"    if !inf && !nan {\n");
        buf_str(out, c"        return (false, 0);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var bits: u64 = if single { 0x7f800000 } else { 0x7ff0000000000000 };\n");
        buf_str(out, c"    if nan {\n");
        buf_str(out, c"        bits = if single { 0x7fc00000 } else { 0x7ff8000000000000 };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if negative {\n");
        buf_str(out, c"        bits |= if single { 0x80000000 } else { 0x8000000000000000 };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    (true, bits)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The exact powers of ten of f64 (10^0 to 10^22) and f32 (to 10^10), and\n");
        buf_str(out, c"// of u64 for the disguised fast path.\n");
        buf_str(out, c"const NUM_F64_POW10: [f64; 23] = [1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11,\n");
        buf_str(out, c"    1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22];\n");
        buf_str(out, c"const NUM_F32_POW10: [f32; 11] = [1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10];\n");
        buf_str(out, c"const NUM_U64_POW10: [u64; 16] = [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000,\n");
        buf_str(out, c"    100000000, 1000000000, 10000000000, 100000000000, 1000000000000, 10000000000000,\n");
        buf_str(out, c"    100000000000000, 1000000000000000];\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Clinger's fast path (with Rust's disguised one): the exact float of m *\n");
        buf_str(out, c"// 10^e when m and 10^e are exact floats, as bits; -1 when it does not\n");
        buf_str(out, c"// apply.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn num_fast_path(m: u64, e: i64, single: bool) -> i64 {\n");
        buf_str(out, c"    let max_exp = if single { 10 } else { 22 };\n");
        buf_str(out, c"    let max_disguised = if single { 17 } else { 37 };\n");
        buf_str(out, c"    let max_mantissa: u64 = if single { 2 << 23 } else { 2 << 52 };\n");
        buf_str(out, c"    if e < -max_exp || e > max_disguised || m > max_mantissa {\n");
        buf_str(out, c"        return -1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var mm = m;\n");
        buf_str(out, c"    var ee = e;\n");
        buf_str(out, c"    if e > max_exp {\n");
        buf_str(out, c"        // (m * 10^(e - max_exp) still exact)\n");
        buf_str(out, c"        let p = NUM_U64_POW10[e - max_exp];\n");
        buf_str(out, c"        if mul_hi(mm, p) != 0 {\n");
        buf_str(out, c"            return -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        mm = mm * p;\n");
        buf_str(out, c"        if mm > max_mantissa {\n");
        buf_str(out, c"            return -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        ee = max_exp;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if single {\n");
        buf_str(out, c"        let x = mm as f32;\n");
        buf_str(out, c"        let v = if ee < 0 { x / NUM_F32_POW10[-ee] } else { x * NUM_F32_POW10[ee] };\n");
        buf_str(out, c"        return f32_to_bits(v) as i64;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let x = mm as f64;\n");
        buf_str(out, c"    let v = if ee < 0 { x / NUM_F64_POW10[-ee] } else { x * NUM_F64_POW10[ee] };\n");
        buf_str(out, c"    f64_to_bits(v) as i64\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The table's 128-bit 5^q (normalized; Rust's POWER_OF_FIVE_128) for q from\n");
        buf_str(out, c"// -342 to 308: (high, low).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn num_lemire_power(q: i64) -> (u64, u64) {\n");
        buf_str(out, c"    let at = 2 * (q - POW10_MIN);\n");
        buf_str(out, c"    let hi = POW10_128[at];\n");
        buf_str(out, c"    let lo = POW10_128[at + 1];\n");
        buf_str(out, c"    if q >= -27 && q <= -1 {\n");
        buf_str(out, c"        // (rounded up there)\n");
        buf_str(out, c"        let lo1 = lo + 1;\n");
        buf_str(out, c"        return (if lo1 == 0 { hi + 1 } else { hi }, lo1);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    (hi, lo)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A float's fields, (significand bits, biased exponent); a negative\n");
        buf_str(out, c"// exponent: Eisel-Lemire could not decide.\n");
        buf_str(out, c"struct NumBiasedFp { f: u64, e: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Eisel and Lemire (Rust's compute_float): w * 10^q rounded to a float of\n");
        buf_str(out, c"// mbits significand bits (52 or 23).\n");
        buf_str(out, c"fn num_compute_float(q: i64, w0: u64, single: bool) -> NumBiasedFp {\n");
        buf_str(out, c"    let mbits: i64 = if single { 23 } else { 52 };\n");
        buf_str(out, c"    let min_exponent: i64 = if single { -127 } else { -1023 };\n");
        buf_str(out, c"    let inf_power: i64 = if single { 0xff } else { 0x7ff };\n");
        buf_str(out, c"    let smallest: i64 = if single { -65 } else { -342 };\n");
        buf_str(out, c"    let largest: i64 = if single { 38 } else { 308 };\n");
        buf_str(out, c"    let min_round_even: i64 = if single { -17 } else { -4 };\n");
        buf_str(out, c"    let max_round_even: i64 = if single { 10 } else { 23 };\n");
        buf_str(out, c"    if w0 == 0 || q < smallest {\n");
        buf_str(out, c"        return NumBiasedFp { f: 0, e: 0 };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if q > largest {\n");
        buf_str(out, c"        return NumBiasedFp { f: 0, e: inf_power };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let lz = leading_zeros(w0);\n");
        buf_str(out, c"    let w = w0 << lz as u64;\n");
        buf_str(out, c"    // w * 5^q, approximately (compute_product_approx, precision mbits + 3)\n");
        buf_str(out, c"    let (hi5, lo5) = num_lemire_power(q);\n");
        buf_str(out, c"    let mask: u64 = 0xffffffffffffffff >> (mbits + 3) as u64;\n");
        buf_str(out, c"    var first_hi = mul_hi(w, hi5);\n");
        buf_str(out, c"    var first_lo = w * hi5;\n");
        buf_str(out, c"    if (first_hi & mask) == mask {\n");
        buf_str(out, c"        let second_hi = mul_hi(w, lo5);\n");
        buf_str(out, c"        first_lo = first_lo + second_hi;\n");
        buf_str(out, c"        if second_hi > first_lo {\n");
        buf_str(out, c"            first_hi += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let lo = first_lo;\n");
        buf_str(out, c"    let hi = first_hi;\n");
        buf_str(out, c"    if lo == 0xffffffffffffffff && (q < -27 || q > 55) {\n");
        buf_str(out, c"        return NumBiasedFp { f: 0, e: -1 };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let upperbit = (hi >> 63) as i64;\n");
        buf_str(out, c"    let shift = (upperbit + 64 - mbits - 3) as u64;\n");
        buf_str(out, c"    var mantissa = hi >> shift;\n");
        buf_str(out, c"    var power2 = (((q * (152170 + 65536)) >> 16) + 63) + upperbit - lz - min_exponent;\n");
        buf_str(out, c"    if power2 <= 0 {\n");
        buf_str(out, c"        if -power2 + 1 >= 64 {\n");
        buf_str(out, c"            return NumBiasedFp { f: 0, e: 0 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        // a subnormal\n");
        buf_str(out, c"        mantissa = mantissa >> (-power2 + 1) as u64;\n");
        buf_str(out, c"        mantissa += mantissa & 1;\n");
        buf_str(out, c"        mantissa = mantissa >> 1;\n");
        buf_str(out, c"        let e = if mantissa >= (1 << mbits as u64) { 1 } else { 0 };\n");
        buf_str(out, c"        return NumBiasedFp { f: mantissa, e: e };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // (exactly halfway, between two floats: to even)\n");
        buf_str(out, c"    if lo <= 1 && q >= min_round_even && q <= max_round_even && (mantissa & 3) == 1\n");
        buf_str(out, c"        && (mantissa << shift) == hi {\n");
        buf_str(out, c"        mantissa &= ~1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    mantissa += mantissa & 1;\n");
        buf_str(out, c"    mantissa = mantissa >> 1;\n");
        buf_str(out, c"    if mantissa >= (2 << mbits as u64) {\n");
        buf_str(out, c"        mantissa = 1 << mbits as u64;\n");
        buf_str(out, c"        power2 += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    mantissa &= ~(1 << mbits as u64);\n");
        buf_str(out, c"    if power2 >= inf_power {\n");
        buf_str(out, c"        return NumBiasedFp { f: 0, e: inf_power };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    NumBiasedFp { f: mantissa, e: power2 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// s as a float's bits (single: an f32's), or the error (Rust's dec2flt).\n");
        buf_str(out, c"fn num_dec2flt(s: [u8], single: bool) -> Result<u64, ParseFloatError> {\n");
        buf_str(out, c"    if s.len == 0 {\n");
        buf_str(out, c"        return Result::Err(ParseFloatError::Empty);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let negative = s[0] == '-';\n");
        buf_str(out, c"    let t = if negative || s[0] == '+' { s[1..] } else { s };\n");
        buf_str(out, c"    if t.len == 0 {\n");
        buf_str(out, c"        return Result::Err(ParseFloatError::Invalid);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let sign: u64 = if !negative { 0 } else if single { 0x80000000 } else { 0x8000000000000000 };\n");
        buf_str(out, c"    var num = NumDecimalParts { mantissa: 0, exponent: 0, many_digits: false };\n");
        buf_str(out, c"    if !num_parse_number(t, &num) {\n");
        buf_str(out, c"        let (ok, special) = num_parse_inf_nan(t, negative, single);\n");
        buf_str(out, c"        if !ok {\n");
        buf_str(out, c"            return Result::Err(ParseFloatError::Invalid);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return Result::Ok(special);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if !num.many_digits {\n");
        buf_str(out, c"        let fast = num_fast_path(num.mantissa, num.exponent, single);\n");
        buf_str(out, c"        if fast >= 0 {\n");
        buf_str(out, c"            return Result::Ok(fast as u64 | sign);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var fp = num_compute_float(num.exponent, num.mantissa, single);\n");
        buf_str(out, c"    if num.many_digits && fp.e >= 0 {\n");
        buf_str(out, c"        // (the digits after the 19th could round it up)\n");
        buf_str(out, c"        let up = num_compute_float(num.exponent, num.mantissa + 1, single);\n");
        buf_str(out, c"        if up.f != fp.f || up.e != fp.e {\n");
        buf_str(out, c"            fp.e = -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if fp.e < 0 {\n");
        buf_str(out, c"        fp = num_slow_path(t, single);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mbits: u64 = if single { 23 } else { 52 };\n");
        buf_str(out, c"    Result::Ok((fp.f | ((fp.e as u64) << mbits)) | sign)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Numbers: float parsing's slow path (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The simple-decimal algorithm (Nigel Tao's; Rust's decimal.rs and\n");
        buf_str(out, c"// slow.rs) for the inputs Eisel and Lemire cannot round: the decimal's\n");
        buf_str(out, c"// first 768 digits, shifted by powers of two to [1/2, 1], then rounded.\n");
        buf_str(out, c"\n");
        buf_str(out, c"const NUM_DEC_MAX_DIGITS: i64 = 768;\n");
        buf_str(out, c"const NUM_DEC_POINT_RANGE: i64 = 2047;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A decimal 0.d1d2d3... * 10^decimal_point (digits 0 to 9, not ASCII);\n");
        buf_str(out, c"// truncated: digits were dropped after the 768th.\n");
        buf_str(out, c"struct NumDecimal { num_digits: i64, decimal_point: i64, truncated: bool, digits: [u8; 768] }\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn num_dec_add_digit(d: inout NumDecimal, digit: u8) {\n");
        buf_str(out, c"    if d.num_digits < NUM_DEC_MAX_DIGITS {\n");
        buf_str(out, c"        d.digits[d.num_digits] = digit;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    d.num_digits += 1;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn num_dec_trim(d: inout NumDecimal) {\n");
        buf_str(out, c"    for _ in 0..NUM_DEC_MAX_DIGITS + 1 {\n");
        buf_str(out, c"        if !(d.num_digits != 0 && d.digits[d.num_digits - 1] == 0) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        d.num_digits -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The integer part, rounded to nearest (ties to even), at most 2^64 - 1.\n");
        buf_str(out, c"fn num_dec_round(d: inout NumDecimal) -> u64 {\n");
        buf_str(out, c"    if d.num_digits == 0 || d.decimal_point < 0 {\n");
        buf_str(out, c"        return 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if d.decimal_point > 18 {\n");
        buf_str(out, c"        return 0xffffffffffffffff;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let dp = d.decimal_point;\n");
        buf_str(out, c"    var n: u64 = 0;\n");
        buf_str(out, c"    for i in 0..dp {\n");
        buf_str(out, c"        n = n * 10;\n");
        buf_str(out, c"        if i < d.num_digits {\n");
        buf_str(out, c"            n += d.digits[i] as u64;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var round_up = false;\n");
        buf_str(out, c"    if dp < d.num_digits {\n");
        buf_str(out, c"        round_up = d.digits[dp] >= 5;\n");
        buf_str(out, c"        if d.digits[dp] == 5 && dp + 1 == d.num_digits {\n");
        buf_str(out, c"            round_up = d.truncated || (dp != 0 && (d.digits[dp - 1] & 1) != 0);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if round_up {\n");
        buf_str(out, c"        n += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    n\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// How many digits shifting left by `shift` adds (Rust's\n");
        buf_str(out, c"// number_of_digits_decimal_left_shift).\n");
        buf_str(out, c"fn num_dec_new_digits(d: inout NumDecimal, shift: i64) -> i64 {\n");
        buf_str(out, c"    let s = shift & 63;\n");
        buf_str(out, c"    let x_a = LSHIFT_TABLE[s] as i64;\n");
        buf_str(out, c"    let x_b = LSHIFT_TABLE[s + 1] as i64;\n");
        buf_str(out, c"    let num_new_digits = x_a >> 11;\n");
        buf_str(out, c"    let pow5_a = 0x7ff & x_a;\n");
        buf_str(out, c"    let pow5_b = 0x7ff & x_b;\n");
        buf_str(out, c"    for i in 0..pow5_b - pow5_a {\n");
        buf_str(out, c"        let p5 = POW5_DIGITS[pow5_a + i] - '0';\n");
        buf_str(out, c"        if i >= d.num_digits {\n");
        buf_str(out, c"            return num_new_digits - 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if d.digits[i] == p5 {\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if d.digits[i] < p5 {\n");
        buf_str(out, c"            return num_new_digits - 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return num_new_digits;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    num_new_digits\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// d * 2^shift (shift at most 60).\n");
        buf_str(out, c"fn num_dec_left_shift(d: inout NumDecimal, shift: i64) {\n");
        buf_str(out, c"    if d.num_digits == 0 {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let num_new_digits = num_dec_new_digits(&d, shift);\n");
        buf_str(out, c"    var read_index = d.num_digits;\n");
        buf_str(out, c"    var write_index = d.num_digits + num_new_digits;\n");
        buf_str(out, c"    var n: u64 = 0;\n");
        buf_str(out, c"    for _ in 0..NUM_DEC_MAX_DIGITS + 1 {\n");
        buf_str(out, c"        if !(read_index != 0) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        read_index -= 1;\n");
        buf_str(out, c"        write_index -= 1;\n");
        buf_str(out, c"        n += (d.digits[read_index] as u64) << shift as u64;\n");
        buf_str(out, c"        let quotient = n / 10;\n");
        buf_str(out, c"        let remainder = n - 10 * quotient;\n");
        buf_str(out, c"        if write_index < NUM_DEC_MAX_DIGITS {\n");
        buf_str(out, c"            d.digits[write_index] = remainder as u8;\n");
        buf_str(out, c"        } else if remainder > 0 {\n");
        buf_str(out, c"            d.truncated = true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        n = quotient;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for _ in 0..20 {\n");
        buf_str(out, c"        if !(n > 0) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        write_index -= 1;\n");
        buf_str(out, c"        let quotient = n / 10;\n");
        buf_str(out, c"        let remainder = n - 10 * quotient;\n");
        buf_str(out, c"        if write_index < NUM_DEC_MAX_DIGITS {\n");
        buf_str(out, c"            d.digits[write_index] = remainder as u8;\n");
        buf_str(out, c"        } else if remainder > 0 {\n");
        buf_str(out, c"            d.truncated = true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        n = quotient;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    d.num_digits += num_new_digits;\n");
        buf_str(out, c"    if d.num_digits > NUM_DEC_MAX_DIGITS {\n");
        buf_str(out, c"        d.num_digits = NUM_DEC_MAX_DIGITS;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    d.decimal_point += num_new_digits;\n");
        buf_str(out, c"    num_dec_trim(&d);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// d / 2^shift (shift at most 60).\n");
        buf_str(out, c"fn num_dec_right_shift(d: inout NumDecimal, shift: i64) {\n");
        buf_str(out, c"    let sh = shift as u64;\n");
        buf_str(out, c"    var read_index = 0;\n");
        buf_str(out, c"    var write_index = 0;\n");
        buf_str(out, c"    var n: u64 = 0;\n");
        buf_str(out, c"    for _ in 0..NUM_DEC_MAX_DIGITS + 40 {\n");
        buf_str(out, c"        if !((n >> sh) == 0) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if read_index < d.num_digits {\n");
        buf_str(out, c"            n = 10 * n + d.digits[read_index] as u64;\n");
        buf_str(out, c"            read_index += 1;\n");
        buf_str(out, c"        } else if n == 0 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            for _ in 0..20 {\n");
        buf_str(out, c"                if !((n >> sh) == 0) {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                n = n * 10;\n");
        buf_str(out, c"                read_index += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    d.decimal_point -= read_index - 1;\n");
        buf_str(out, c"    if d.decimal_point < -NUM_DEC_POINT_RANGE {\n");
        buf_str(out, c"        d.num_digits = 0;\n");
        buf_str(out, c"        d.decimal_point = 0;\n");
        buf_str(out, c"        d.truncated = false;\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mask: u64 = (1 << sh) - 1;\n");
        buf_str(out, c"    for _ in 0..NUM_DEC_MAX_DIGITS + 1 {\n");
        buf_str(out, c"        if !(read_index < d.num_digits) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let new_digit = (n >> sh) as u8;\n");
        buf_str(out, c"        n = 10 * (n & mask) + d.digits[read_index] as u64;\n");
        buf_str(out, c"        read_index += 1;\n");
        buf_str(out, c"        d.digits[write_index] = new_digit;\n");
        buf_str(out, c"        write_index += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for _ in 0..200 {\n");
        buf_str(out, c"        if !(n > 0) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let new_digit = (n >> sh) as u8;\n");
        buf_str(out, c"        n = 10 * (n & mask);\n");
        buf_str(out, c"        if write_index < NUM_DEC_MAX_DIGITS {\n");
        buf_str(out, c"            d.digits[write_index] = new_digit;\n");
        buf_str(out, c"            write_index += 1;\n");
        buf_str(out, c"        } else if new_digit > 0 {\n");
        buf_str(out, c"            d.truncated = true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    d.num_digits = write_index;\n");
        buf_str(out, c"    num_dec_trim(&d);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// s, a valid float text without its sign, as a NumDecimal (Rust's\n");
        buf_str(out, c"// parse_decimal).\n");
        buf_str(out, c"fn num_parse_decimal(s: [u8], d: inout NumDecimal) {\n");
        buf_str(out, c"    let len = s.len;\n");
        buf_str(out, c"    var i = 0;\n");
        buf_str(out, c"    for _ in 0..s.len + 1 {\n");
        buf_str(out, c"        if !(i < len && s[i] == '0') {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for _ in 0..s.len + 1 {\n");
        buf_str(out, c"        if !(i < len && s[i] - '0' < 10) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        num_dec_add_digit(&d, s[i] - '0');\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if i < len && s[i] == '.' {\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"        let first = i;\n");
        buf_str(out, c"        if d.num_digits == 0 {\n");
        buf_str(out, c"            for _ in 0..s.len + 1 {\n");
        buf_str(out, c"                if !(i < len && s[i] == '0') {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                i += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for _ in 0..s.len + 1 {\n");
        buf_str(out, c"            if !(i < len && s[i] - '0' < 10) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            num_dec_add_digit(&d, s[i] - '0');\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        d.decimal_point = first - i;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if d.num_digits != 0 {\n");
        buf_str(out, c"        // (trailing zeros are no digits)\n");
        buf_str(out, c"        var zeros = 0;\n");
        buf_str(out, c"        var j = i;\n");
        buf_str(out, c"        for _ in 0..s.len + 1 {\n");
        buf_str(out, c"            if !(j > 0) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            j -= 1;\n");
        buf_str(out, c"            let c = s[j];\n");
        buf_str(out, c"            if c == '0' {\n");
        buf_str(out, c"                zeros += 1;\n");
        buf_str(out, c"            } else if c != '.' {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        d.decimal_point += zeros;\n");
        buf_str(out, c"        d.num_digits -= zeros;\n");
        buf_str(out, c"        d.decimal_point += d.num_digits;\n");
        buf_str(out, c"        if d.num_digits > NUM_DEC_MAX_DIGITS {\n");
        buf_str(out, c"            d.truncated = true;\n");
        buf_str(out, c"            d.num_digits = NUM_DEC_MAX_DIGITS;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if i < len && (s[i] == 'e' || s[i] == 'E') {\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"        var negative = false;\n");
        buf_str(out, c"        if i < len && (s[i] == '-' || s[i] == '+') {\n");
        buf_str(out, c"            negative = s[i] == '-';\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var exp_num: i64 = 0;\n");
        buf_str(out, c"        for _ in 0..s.len + 1 {\n");
        buf_str(out, c"            if !(i < len && s[i] - '0' < 10) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if exp_num < 0x10000 {\n");
        buf_str(out, c"                exp_num = 10 * exp_num + (s[i] - '0') as i64;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        d.decimal_point += if negative { -exp_num } else { exp_num };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The shift that moves a decimal point of n toward 0 (Rust's get_shift).\n");
        buf_str(out, c"fn num_dec_shift(n: i64) -> i64 {\n");
        buf_str(out, c"    let powers = [0, 3, 6, 9, 13, 16, 19, 23, 26, 29, 33, 36, 39, 43, 46, 49, 53, 56, 59];\n");
        buf_str(out, c"    if n < 19 { powers[n] } else { 60 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// s (without its sign) rounded to a float (Rust's parse_long_mantissa).\n");
        buf_str(out, c"fn num_slow_path(s: [u8], single: bool) -> NumBiasedFp {\n");
        buf_str(out, c"    let mbits: i64 = if single { 23 } else { 52 };\n");
        buf_str(out, c"    let min_exponent: i64 = if single { -127 } else { -1023 };\n");
        buf_str(out, c"    let inf_power: i64 = if single { 0xff } else { 0x7ff };\n");
        buf_str(out, c"    var d = NumDecimal { num_digits: 0, decimal_point: 0, truncated: false, digits: [0; 768] };\n");
        buf_str(out, c"    num_parse_decimal(s, &d);\n");
        buf_str(out, c"    if d.num_digits == 0 || d.decimal_point < -324 {\n");
        buf_str(out, c"        return NumBiasedFp { f: 0, e: 0 };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if d.decimal_point >= 310 {\n");
        buf_str(out, c"        return NumBiasedFp { f: 0, e: inf_power };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var exp2: i64 = 0;\n");
        buf_str(out, c"    // to (1/2, 1]\n");
        buf_str(out, c"    for _ in 0..1000 {\n");
        buf_str(out, c"        if !(d.decimal_point > 0) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let shift = num_dec_shift(d.decimal_point);\n");
        buf_str(out, c"        num_dec_right_shift(&d, shift);\n");
        buf_str(out, c"        if d.decimal_point < -NUM_DEC_POINT_RANGE {\n");
        buf_str(out, c"            return NumBiasedFp { f: 0, e: 0 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        exp2 += shift;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for _ in 0..1000 {\n");
        buf_str(out, c"        if !(d.decimal_point <= 0) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var shift = 0;\n");
        buf_str(out, c"        if d.decimal_point == 0 {\n");
        buf_str(out, c"            let first = d.digits[0];\n");
        buf_str(out, c"            if first >= 5 {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            shift = if first == 0 || first == 1 { 2 } else { 1 };\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            shift = num_dec_shift(-d.decimal_point);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        num_dec_left_shift(&d, shift);\n");
        buf_str(out, c"        if d.decimal_point > NUM_DEC_POINT_RANGE {\n");
        buf_str(out, c"            return NumBiasedFp { f: 0, e: inf_power };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        exp2 -= shift;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // [1/2, 1] to [1, 2]\n");
        buf_str(out, c"    exp2 -= 1;\n");
        buf_str(out, c"    for _ in 0..1000 {\n");
        buf_str(out, c"        if !(min_exponent + 1 > exp2) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        var n = min_exponent + 1 - exp2;\n");
        buf_str(out, c"        if n > 60 {\n");
        buf_str(out, c"            n = 60;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        num_dec_right_shift(&d, n);\n");
        buf_str(out, c"        exp2 += n;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if exp2 - min_exponent >= inf_power {\n");
        buf_str(out, c"        return NumBiasedFp { f: 0, e: inf_power };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    num_dec_left_shift(&d, mbits + 1);\n");
        buf_str(out, c"    var mantissa = num_dec_round(&d);\n");
        buf_str(out, c"    if mantissa >= (1 << (mbits + 1) as u64) {\n");
        buf_str(out, c"        // (rounded up to the carry bit)\n");
        buf_str(out, c"        num_dec_right_shift(&d, 1);\n");
        buf_str(out, c"        exp2 += 1;\n");
        buf_str(out, c"        mantissa = num_dec_round(&d);\n");
        buf_str(out, c"        if exp2 - min_exponent >= inf_power {\n");
        buf_str(out, c"            return NumBiasedFp { f: 0, e: inf_power };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    var power2 = exp2 - min_exponent;\n");
        buf_str(out, c"    if mantissa < (1 << mbits as u64) {\n");
        buf_str(out, c"        power2 -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    mantissa &= (1 << mbits as u64) - 1;\n");
        buf_str(out, c"    NumBiasedFp { f: mantissa, e: power2 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::num::tables ----\n");
        buf_str(out, c"pub mod tables {\n");
        buf_str(out, c"// std::num::tables (0.20): generated by tools/numtables/gen.tach (do not\n");
        buf_str(out, c"// edit): the tables of std's number conversion (std::num), computed\n");
        buf_str(out, c"// there with big integers and checked against their definitions.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Numbers: powers of ten (0.20) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// For K from POW10_MIN (-342) to 324: 10^K's first 128 bits, truncated,\n");
        buf_str(out, c"// floor(10^K * 2^(127 - floor(log2(10^K)))), as (high, low) at 2 * (K -\n");
        buf_str(out, c"// POW10_MIN). Schubfach adds one (num.tach: f64_shortest, f32_shortest);\n");
        buf_str(out, c"// Eisel and Lemire use them as they are, one more for K from -27 to -1\n");
        buf_str(out, c"// (lemire_power).\n");
        buf_str(out, c"pub const POW10_MIN: i64 = -342;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub static POW10_128: [u64; 1334] = [\n");
        buf_str(out, c"    0xeef453d6923bd65a, 0x113faa2906a13b3f,\n");
        buf_str(out, c"    0x9558b4661b6565f8, 0x4ac7ca59a424c507,\n");
