        buf_str(out, c"                    drop(unsafe { self.ptr[i] });\n                }\n            }\n        }\n    }\n\n    // Its elements, a view (0.17: valid while the Vec is not changed).\n    #[views(self)]\n    pub fn as_slice(self) -> [T] {\n        unsafe { self.ptr[0..self.len] }\n    }\n\n    // Its elements, to change in place (0.17): `sort(v.as_mut_slice())`.\n    #[views(self)]\n    pub fn as_mut_slice(inout self) -> inout [T] {\n        unsafe { &self.ptr[0..self.len] }\n    }\n\n    // Drops the elements (0.17); the room stays.\n    pub fn clear(inout self) {\n        self.truncate(0);\n    }\n\n    // Its elements dropped and its memory given back; it is left empty, to\n    // use again (0.17: a Vec is dropped at the end of its scope without\n    // it; `self.items.free()` through a reference still works, and a\n    // second free frees nothing).\n    pub fn free(inout self) {\n        self.release();\n    }\n\n    // Its elements, in a Vec on the same allocator; it is left empty\n    // (0.17: `std::take` for a container, which keeps its allocator).\n    pub fn take(inout self) -> Vec<T, A> {\n        let empty: Vec<T, A> = Vec::new_in(self.alloc);\n        replace(&self, empty)\n    }\n\n    // The elements dropped and the memory given back: empty, with no memory\n    // (0.17: drop and free).\n    #[inline]\n    fn release(inout self) {\n        self.truncate(0);\n        unsafe {\n            self.alloc.free(self.ptr as *u8, self.cap * size_of(T), align_of(T));\n        }\n        self.ptr = 0 as *T;\n        self.cap = 0;\n    }\n}\n\n// (0.17) A Vec's drop: its elements' drops, then its memory given back.\nimpl<T, A: Allocator> Drop for Vec<T, A> {\n    #[inline]\n    fn drop(inout self) {\n        self.release();\n    }\n}\n\n// (0.16) The ambient constructors of 0.15, errors outside std: allocation\n// is explicit (front/ambient.tach; fix --only alloc016 reads them).\nimpl<T, A: Allocator + Ambient> Vec<T, A> {\n    #[ambient(\"Vec::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> Vec<T, A> {\n        Vec { ptr: 0 as *T, len: 0, cap: 0, alloc: A::ambient() }\n    }\n\n    #[ambient(\"Vec::with_capacity_in(cap, gpa)\")]\n    pub fn with_capacity(cap: i64) -> Vec<T, A> {\n        Vec::with_capacity_in(cap, A::ambient())\n    }\n\n    #[ambient(\"Vec::filled_in(n, x, gpa)\")]\n    pub fn filled(n: i64, x: sink T) -> Vec<T, A> {\n        Vec::filled_in(n, x, A::ambient())\n    }\n}\n\n// ---- Vec's room and allocator (0.16) ----\n\nimpl<T, A: Allocator> Vec<T, A> {\n    // The elements it has room for (0.16).\n    pub fn capacity(self) -> i64 {\n        self.cap\n    }\n\n    // Its allocator (0.16): a copy of the handle.\n    pub fn allocator(self) -> A {\n        self.alloc\n    }\n\n    // Room for `extra` more elements, or Err when out of memory, the Vec\n    // as it was (0.16).\n    pub fn try_reserve(inout self, extra: i64) -> Result<(), AllocError> {\n        if extra > self.cap - self.len && !self.reserve_more(extra) {\n            return Result::Err(AllocError::OutOfMemory);\n        }\n        Result::Ok(())\n    }\n\n    // push, or Err when out of memory, the Vec as it was (0.16).\n    #[stores(x)]\n    pub fn try_push(inout self, x: sink T) -> Result<(), AllocError> {\n        if self.len == self.cap && !self.reserve_more(1) {\n            return Result::Err(AllocError::OutOfMemory);\n        }\n        unsafe {\n            self.ptr[self.len] = x;\n        }\n        self.len += 1;\n        Result::Ok(())\n    }\n}\n\n// ---- Buf ----\n\n// A growable buffer of bytes, for building text (0.16: on allocator A).\n#[sealed]\npub struct Buf<A: Allocator = Gpa> { bytes: Vec<u8, A> }\n\nimpl<A: Allocator> Buf<A> {\n    // An empty Buf on allocator a (0.16).\n    pub fn new_in(a: sink A) -> Buf<A> {\n        Buf { bytes: Vec::new_in(a) }\n    }\n\n    pub fn len(self) -> i64 {\n        self.bytes.len\n    }\n\n    pub fn push(inout self, b: u8) {\n        self.bytes.push(b);\n    }\n\n");
        buf_str(out, c"    // Appends s, which may be a view of this Buf.\n    pub fn push_str(inout self, s: [u8]) {\n        self.bytes.extend_from_slice(s);\n    }\n\n    // A C string (up to its NUL).\n    pub unsafe fn push_cstr(inout self, s: *u8) {\n        self.bytes.extend_from_slice(s[0..strlen(s) as i64]);\n    }\n\n    // The decimal digits of v.\n    pub fn push_int(inout self, v: i64) {\n        let negative = v < 0;\n        let u = if negative { (-(v + 1)) as u64 + 1 } else { v as u64 };\n        let n = if negative { decimal_len(u) + 1 } else { decimal_len(u) };\n        if n > self.bytes.cap - self.bytes.len {\n            self.bytes.reserve(n);\n        }\n        unsafe {\n            put_decimal(&self.bytes.ptr[self.bytes.len], n, u, negative);\n        }\n        self.bytes.len += n;\n    }\n\n    // Its bytes, a view (0.17: valid while the Buf is not changed).\n    #[views(self)]\n    pub fn as_slice(self) -> [u8] {\n        self.bytes.as_slice()\n    }\n\n    // Its bytes, to change in place (0.17).\n    #[views(self)]\n    pub fn as_mut_slice(inout self) -> inout [u8] {\n        self.bytes.as_mut_slice()\n    }\n\n    pub fn clear(inout self) {\n        self.bytes.clear();\n    }\n\n    // Its memory given back; it is left empty, to use again (0.17: a Buf is\n    // dropped at the end of its scope without it).\n    pub fn free(inout self) {\n        self.bytes.release();\n    }\n\n    // Its bytes, in a Buf on the same allocator; it is left empty (0.17:\n    // `std::take` for a container, which keeps its allocator).\n    pub fn take(inout self) -> Buf<A> {\n        Buf { bytes: self.bytes.take() }\n    }\n}\n\n// (0.17) A Buf's drop: its memory given back.\nimpl<A: Allocator> Drop for Buf<A> {\n    #[inline]\n    fn drop(inout self) {\n        self.bytes.release();\n    }\n}\n\nimpl<A: Allocator> Buf<A> {\n    // A new Buf of the bytes of s on allocator a (0.17): text that must\n    // outlive the slice it came from.\n");
        buf_str(out, c"    pub fn from_in(s: [u8], a: sink A) -> Buf<A> {\n        var b: Buf<A> = Buf::with_capacity_in(s.len, a);\n        b.push_str(s);\n        b\n    }\n}\n\nimpl<A: Allocator + Ambient> Buf<A> {\n    #[ambient(\"Buf::new_in(gpa)\")]\n    pub fn new() -> Buf<A> {\n        Buf { bytes: Vec::new_in(A::ambient()) }\n    }\n}\n\n// The number of decimal digits of u.\n#[inline]\nfn decimal_len(u: u64) -> i64 {\n    var n = 1;\n    var ten: u64 = 10;\n    for _ in 1..20 {\n        if u < ten {\n            break;\n        }\n        n += 1;\n        ten *= 10;\n    }\n    n\n}\n\n// u's decimal digits in p[0..n] (n: decimal_len(u), one more when\n// negative: after a '-'), two at a time. Unsafe: p has n bytes.\n#[inline]\nunsafe fn put_decimal(p: *u8, n: i64, u: u64, negative: bool) {\n    let pairs = \"00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899\";\n    var x = u;\n    var i = n;\n    for _ in 0..10 {\n        if x < 100 {\n            break;\n        }\n        let q = x / 100;\n        let r = (x - q * 100) as i64 * 2;\n        i -= 2;\n        p[i] = pairs.ptr[r];\n        p[i + 1] = pairs.ptr[r + 1];\n        x = q;\n    }\n    if x >= 10 {\n        let r = x as i64 * 2;\n        p[i - 2] = pairs.ptr[r];\n        p[i - 1] = pairs.ptr[r + 1];\n    } else {\n        p[i - 1] = '0' + x as u8;\n    }\n    if negative {\n        p[0] = '-';\n    }\n}\n\n// ---- Buf's room and allocator (0.16) ----\n\nimpl<A: Allocator> Buf<A> {\n    // An empty Buf on allocator a with room for cap bytes (0.16).\n    pub fn with_capacity_in(cap: i64, a: sink A) -> Buf<A> {\n        Buf { bytes: Vec::with_capacity_in(cap, a) }\n    }\n\n    // The bytes it has room for (0.16).\n    pub fn capacity(self) -> i64 {\n        self.bytes.cap\n    }\n\n    // Room for `extra` more bytes (0.16).\n    pub fn reserve(inout self, extra: i64) {\n");
        buf_str(out, c"        self.bytes.reserve(extra);\n    }\n\n    // Its allocator (0.16): a copy of the handle.\n    pub fn allocator(self) -> A {\n        self.bytes.alloc\n    }\n}\n\n// ---- Eq, Ord and Hash (0.9) ----\n\npub trait Eq { #[pure] fn eq(self, other: Self) -> bool; }\n// Negative, zero or positive: self before, like or after other.\npub trait Ord { #[pure] fn cmp(self, other: Self) -> i64; }\npub trait Hash { #[pure] fn hash(self) -> u64; }\n\n// The hash of the integers (0.20): FixedState's, foldhash with fixed\n// seeds, one folded multiply (std::hash).\n#[inline]\npub fn hash_u64(x: u64) -> u64 {\n    hash::fold_hash_u64_fixed(x)\n}\n\nimpl Eq for i8 {\n    fn eq(self, other: i8) -> bool { self == other }\n}\n\nimpl Ord for i8 {\n    fn cmp(self, other: i8) -> i64 {\n        if self < other { -1 } else if self == other { 0 } else { 1 }\n    }\n}\n\nimpl Hash for i8 {\n    fn hash(self) -> u64 { hash_u64(self as u64) }\n}\n\nimpl Eq for i16 {\n    fn eq(self, other: i16) -> bool { self == other }\n}\n\nimpl Ord for i16 {\n    fn cmp(self, other: i16) -> i64 {\n        if self < other { -1 } else if self == other { 0 } else { 1 }\n    }\n}\n\nimpl Hash for i16 {\n    fn hash(self) -> u64 { hash_u64(self as u64) }\n}\n\nimpl Eq for i32 {\n    fn eq(self, other: i32) -> bool { self == other }\n}\n\nimpl Ord for i32 {\n    fn cmp(self, other: i32) -> i64 {\n        if self < other { -1 } else if self == other { 0 } else { 1 }\n    }\n}\n\nimpl Hash for i32 {\n    fn hash(self) -> u64 { hash_u64(self as u64) }\n}\n\nimpl Eq for i64 {\n    fn eq(self, other: i64) -> bool { self == other }\n}\n\nimpl Ord for i64 {\n    fn cmp(self, other: i64) -> i64 {\n        if self < other { -1 } else if self == other { 0 } else { 1 }\n    }\n}\n\nimpl Hash for i64 {\n    fn hash(self) -> u64 { hash_u64(self as u64) }\n}\n\nimpl Eq for u8 {\n    fn eq(self, other: u8) -> bool { self == other }\n}\n\nimpl Ord for u8 {\n    fn cmp(self, other: u8) -> i64 {\n");
        buf_str(out, c"        if self < other { -1 } else if self == other { 0 } else { 1 }\n    }\n}\n\nimpl Hash for u8 {\n    fn hash(self) -> u64 { hash_u64(self as u64) }\n}\n\nimpl Eq for u16 {\n    fn eq(self, other: u16) -> bool { self == other }\n}\n\nimpl Ord for u16 {\n    fn cmp(self, other: u16) -> i64 {\n        if self < other { -1 } else if self == other { 0 } else { 1 }\n    }\n}\n\nimpl Hash for u16 {\n    fn hash(self) -> u64 { hash_u64(self as u64) }\n}\n\nimpl Eq for u32 {\n    fn eq(self, other: u32) -> bool { self == other }\n}\n\nimpl Ord for u32 {\n    fn cmp(self, other: u32) -> i64 {\n        if self < other { -1 } else if self == other { 0 } else { 1 }\n    }\n}\n\nimpl Hash for u32 {\n    fn hash(self) -> u64 { hash_u64(self as u64) }\n}\n\nimpl Eq for u64 {\n    fn eq(self, other: u64) -> bool { self == other }\n}\n\nimpl Ord for u64 {\n    fn cmp(self, other: u64) -> i64 {\n        if self < other { -1 } else if self == other { 0 } else { 1 }\n    }\n}\n\nimpl Hash for u64 {\n    fn hash(self) -> u64 { hash_u64(self as u64) }\n}\n\nimpl Eq for bool {\n    fn eq(self, other: bool) -> bool { self == other }\n}\n\nimpl Ord for bool {\n    fn cmp(self, other: bool) -> i64 {\n        if !self && other { -1 } else if self == other { 0 } else { 1 }\n    }\n}\n\nimpl Hash for bool {\n    fn hash(self) -> u64 { hash_u64(self as u64) }\n}\n\n// Byte strings: compared by bytes, ordered lexicographically, hashed with\n// foldhash (0.20; FNV-1a before).\nimpl Eq for [u8] {\n    fn eq(self, other: Self) -> bool {\n        let a = self;\n        let b = other;\n        if a.len != b.len {\n            return false;\n        }\n        for i in 0..a.len {\n            if a[i] != b[i] {\n                return false;\n            }\n        }\n        true\n    }\n}\n\nimpl Ord for [u8] {\n    fn cmp(self, other: Self) -> i64 {\n        let a = self;\n        let b = other;\n        let n = if a.len < b.len { a.len } else { b.len };\n        for i in 0..n {\n");
        buf_str(out, c"            if a[i] != b[i] {\n                return if a[i] < b[i] { -1 } else { 1 };\n            }\n        }\n        if a.len < b.len { -1 } else if a.len == b.len { 0 } else { 1 }\n    }\n}\n\nimpl Hash for [u8] {\n    #[inline]\n    fn hash(self) -> u64 {\n        // (0.20: FixedState's, foldhash: the length, then the bytes)\n        hash::fold_hash_bytes_fixed(0x082efa98ec4e6c89, self)\n    }\n}\n\n// ---- Contract checks: the implementation (0.18) ----\n\n// (0.18) A contract or assertion check, which the compiler makes (from a\n// `requires` or `ensures` clause, `assert`, `assert_eq`, ...): both back\n// ends branch to the run-time failure when `ok` is false, whose line the\n// compiler writes from `check` (front/contracts/checks.tach) and `site`\n// (the position it blames); a, b, c: the values of the holes of an\n// f-string message (`else f\"index {i}\"`), evaluated only when `ok` is\n// false. Not called by programs.\npub fn contract_check(ok: bool, site: i64, check: i64, a: i64 = 0, b: i64 = 0, c: i64 = 0) {\n    if !ok {\n        unsafe { panic(c\"contract check failed\") }\n    }\n}\n// ---- Iterators (0.14) ----\n//\n// compiler/std/embed.sh appends this file to std.tach: the same module,\n// `std`. The Iterator trait (in the prelude), its sources and adapters;\n// `for x in it` iterates any type implementing it\n// (docs/design/closures-iterators.md).\n//\n// Every method is #[inline], so that a chain becomes one loop: the\n// consumers are written on `fold`, and the sources and adapters override\n// `fold` with a counted loop (internal iteration). `exact_len` and `at`\n// let zip and enumerate index both sides when they know their length.\n\n// ---- Slices (0.16) ----\n\nimpl<T>[T] {\n    // Element i, or None when i is out of bounds (0.16: `s[i]` stops the\n    // program then, this does not).\n    #[inline]\n    pub fn get(self: [T], i: i64) -> Option<T> {\n        if (i as u64) >= (self.len as u64) {\n            return Option::None;\n");
        buf_str(out, c"        }\n        Option::Some(unsafe { self.ptr[i] })\n    }\n}\n// ---- Reading stdin and text (0.14) ----\n//\n// compiler/std/embed.sh appends this file to std.tach (0.15: split from\n// it): the same module, `std`. Reading stdin by lines or whole, trimming,\n// splitting and parsing text, and a Scanner of tokens and numbers.\n//\n// (0.15) The convention: an Option means absence (the end of the input,\n// nothing found), a Result with an error enum a failure: `read_line` and\n// `read_stdin` fail with an IoError, `parse_int` with a ParseIntError,\n// `Scanner::next_int` with a ScanError.\n\n// ---- Reading stdin (0.14) ----\n\n// ---- Text (0.14) ----\n\n// ASCII whitespace: ' ', '\\t', '\\n', '\\r', vertical tab, form feed.\npub fn is_space(b: u8) -> bool {\n    b == ' ' || b == '\\t' || b == '\\n' || b == '\\r' || b == 11 || b == 12\n}\n\n// '0' to '9'.\npub fn is_digit(b: u8) -> bool {\n    b >= '0' && b <= '9'\n}\n\n// s without the whitespace (`is_space`) at its start and end.\n#[views(s)]\npub fn trim(s: [u8]) -> [u8] {\n    var a = 0;\n    var b = s.len;\n    for _ in 0..s.len {\n        if !(a < b && is_space(s[a])) {\n            break;\n        }\n        a += 1;\n    }\n    for _ in 0..s.len {\n        if !(b > a && is_space(s[b - 1])) {\n            break;\n        }\n        b -= 1;\n    }\n    s[a..b]\n}\n\n// s as an integer: an optional '-' or '+', then decimal digits, nothing\n// else (no spaces); Err if s is not one or does not fit in an i64.\n// (0.20: std::num's parse_i64_radix, 8 digits at a time, but a lone sign\n// is Empty, not InvalidDigit(0); a byte that is no digit is reported\n// before an overflow.)\npub fn parse_int(s: [u8]) -> Result<i64, ParseIntError> {\n    if s.len == 1 && (s[0] == '-' || s[0] == '+') {\n        return Result::Err(ParseIntError::Empty);\n    }\n    num::parse_i64_radix(s, 10)\n}\n\n#[ambient(\"read_stdin_in(gpa)\")]\npub fn read_stdin() -> Result<Buf, IoError> {\n    read_stdin_in(Gpa::ambient())\n}\n\n");
        buf_str(out, c"// The parts of s between `sep` bytes, empty ones too, as views of s\n// (`split_in(\"a,,b\", ',', gpa)`: \"a\", \"\", \"b\"), in a Vec on allocator a.\n// The caller frees the Vec. (0.17: the Vec views s.)\n#[views(s)]\npub fn split_in<A: Allocator>(s: [u8], sep: u8, a: sink A) -> Vec<[u8], A> {\n    var parts: Vec<[u8], A> = Vec::new_in(a);\n    var start = 0;\n    for i in 0..s.len {\n        if s[i] == sep {\n            parts.push(s[start..i]);\n            start = i + 1;\n        }\n    }\n    parts.push(s[start..]);\n    parts\n}\n\n#[ambient(\"split_in(s, sep, gpa)\")]\n#[views(s)]\npub fn split(s: [u8], sep: u8) -> Vec<[u8]> {\n    split_in(s, sep, Gpa::ambient())\n}\n\n#[ambient(\"split_whitespace_in(s, gpa)\")]\n#[views(s)]\npub fn split_whitespace(s: [u8]) -> Vec<[u8]> {\n    split_whitespace_in(s, Gpa::ambient())\n}\n\n// The runs of non-whitespace in s, as views of s, in a Vec on allocator a.\n// The caller frees it. (0.17: the Vec views s.)\n#[views(s)]\npub fn split_whitespace_in<A: Allocator>(s: [u8], a: sink A) -> Vec<[u8], A> {\n    var words: Vec<[u8], A> = Vec::new_in(a);\n    var sc = Scanner::new(s);\n    while let Option::Some(w) = sc.next_token() {\n        words.push(w);\n    }\n    words\n}\n\n// Reads a text (`read_stdin().as_slice()`) front to back, by tokens\n// (runs of non-whitespace) and lines, as views of the text. (0.17) A view\n// of the text: the tokens it gives view the text, not the Scanner, so\n// several can be kept while it reads on.\npub struct Scanner { text: [u8], pos: i64 }\n\nimpl Scanner {\n    #[views(text)]\n    pub fn new(text: [u8]) -> Scanner {\n        Scanner { text: text, pos: 0 }\n    }\n\n    // The next token; None when only whitespace is left.\n    #[views(*self)]\n    pub fn next_token(inout self) -> Option<[u8]> {\n        let s = self.text;\n        var i = self.pos;\n        for _ in i..s.len {\n            if !is_space(s[i]) {\n                break;\n            }\n            i += 1;\n        }\n");
        buf_str(out, c"        if i >= s.len {\n            self.pos = i;\n            return Option::None;\n        }\n        let start = i;\n        for _ in i..s.len {\n            if is_space(s[i]) {\n                break;\n            }\n            i += 1;\n        }\n        self.pos = i;\n        Option::Some(s[start..i])\n    }\n\n    // The next token as an integer (`parse_int`); Err at the end, or if\n    // it is not one (it is consumed all the same).\n    pub fn next_int(inout self) -> Result<i64, ScanError> {\n        match self.next_token() {\n            Option::Some(t) => match parse_int(t) {\n                Result::Ok(n) => Result::Ok(n),\n                Result::Err(e) => Result::Err(ScanError::Parse(e)),\n            },\n            Option::None => Result::Err(ScanError::End),\n        }\n    }\n\n    // The rest of the line, without its '\\n'; None at the end of the\n    // text (\"a\\n\\nb\": \"a\", \"\", \"b\"; \"a\\n\": \"a\").\n    #[views(*self)]\n    pub fn next_line(inout self) -> Option<[u8]> {\n        let s = self.text;\n        if self.pos >= s.len {\n            return Option::None;\n        }\n        let start = self.pos;\n        var i = start;\n        for _ in i..s.len {\n            if s[i] == '\\n' {\n                break;\n            }\n            i += 1;\n        }\n        self.pos = if i < s.len { i + 1 } else { i };\n        Option::Some(s[start..i])\n    }\n\n    // Whether nothing but whitespace is left.\n    pub fn is_done(self) -> bool {\n        let s = self.text;\n        var i = self.pos;\n        for _ in i..s.len {\n            if !is_space(s[i]) {\n                break;\n            }\n            i += 1;\n        }\n        i >= s.len\n    }\n\n    // What is left of the text.\n    // (0.20: self is a copy of the view; what it views is its level 1)\n    #[views(self)]\n    pub fn rest(self) -> [u8] {\n        self.text[self.pos..]\n    }\n}\n\n// ---- Errors of reading and parsing (0.15) ----\n\n");
        buf_str(out, c"// Reading stdin failed (read_line, read_stdin).\npub enum IoError { Read, Write }\n\n// Why parse_int failed: no digits; the byte at this index is not a digit;\n// the number does not fit in an i64.\npub enum ParseIntError { Empty, InvalidDigit(i64), Overflow }\n\n// Why Scanner::next_int failed: no token left; the token is not a number.\npub enum ScanError { End, Parse(ParseIntError) }\n\nimpl Display for IoError {\n    #[inline]\n    fn fmt(self, f: inout Fmt) {\n        match self {\n            IoError::Read => f.str(\"cannot read the input\"),\n            IoError::Write => f.str(\"cannot write the output\"),\n        }\n    }\n}\n\nimpl Debug for IoError {\n    #[inline]\n    fn fmt_debug(self, f: inout Fmt) {\n        match self {\n            IoError::Read => f.str(\"Read\"),\n            IoError::Write => f.str(\"Write\"),\n        }\n    }\n}\n\nimpl Display for ParseIntError {\n    #[inline]\n    fn fmt(self, f: inout Fmt) {\n        match self {\n            ParseIntError::Empty => f.str(\"cannot parse an integer from an empty text\"),\n            ParseIntError::InvalidDigit(i) => {\n                f.str(\"invalid digit at byte \");\n                f.display(i);\n            }\n            ParseIntError::Overflow => f.str(\"the number does not fit in an i64\"),\n        }\n    }\n}\n\nimpl Debug for ParseIntError {\n    #[inline]\n    fn fmt_debug(self, f: inout Fmt) {\n        match self {\n            ParseIntError::Empty => f.str(\"Empty\"),\n            ParseIntError::InvalidDigit(i) => {\n                f.str(\"InvalidDigit(\");\n                f.debug(i);\n                f.str(\")\");\n            }\n            ParseIntError::Overflow => f.str(\"Overflow\"),\n        }\n    }\n}\n\nimpl Display for ScanError {\n    #[inline]\n    fn fmt(self, f: inout Fmt) {\n        match self {\n            ScanError::End => f.str(\"no number left: the end of the input\"),\n            ScanError::Parse(e) => f.display(e),\n        }\n    }\n}\n\n");
        buf_str(out, c"impl Debug for ScanError {\n    #[inline]\n    fn fmt_debug(self, f: inout Fmt) {\n        match self {\n            ScanError::End => f.str(\"End\"),\n            ScanError::Parse(e) => {\n                f.str(\"Parse(\");\n                f.debug(e);\n                f.str(\")\");\n            }\n        }\n    }\n}\n// ---- Printing and formatting ----\n//\n// compiler/std/embed.sh appends this file to std.tach (its printing was\n// split from it): the same module, `std`. Printing; the traits Display\n// (`{x}`, print) and Debug (`{x:?}`), the formatter Fmt they write to, and\n// Interp, the value of an f-string (docs/design/errors-formatting.md).\n//\n// Output to stdout and stderr goes through one static buffer of 4 KB\n// (not the heap), written out at the end of each print call: one `write`\n// per print, whatever its argument is made of. A Fmt to a file descriptor\n// only fills that buffer: `flush` writes it out.\n//\n// (0.16) Formatting allocates nothing: a Fmt to a Buf writes into the\n// room the Buf has, and counts what does not fit; then `push_fmt` grows\n// the Buf to the count and runs the Display again (twice only when the\n// text did not fit). So print's effects have no `alloc`.\n\n// ---- Display and Debug of std's types (0.15) ----\n\nimpl Display for i8 {\n    #[inline]\n    fn fmt(self, f: inout Fmt) { fmt_signed(&f, self as i64, 8); }\n}\n\nimpl Debug for i8 {\n    #[inline]\n    fn fmt_debug(self, f: inout Fmt) { fmt_signed(&f, self as i64, 8); }\n}\n\nimpl Display for i16 {\n    #[inline]\n    fn fmt(self, f: inout Fmt) { fmt_signed(&f, self as i64, 16); }\n}\n\nimpl Debug for i16 {\n    #[inline]\n    fn fmt_debug(self, f: inout Fmt) { fmt_signed(&f, self as i64, 16); }\n}\n\nimpl Display for i32 {\n    #[inline]\n    fn fmt(self, f: inout Fmt) { fmt_signed(&f, self as i64, 32); }\n}\n\nimpl Debug for i32 {\n    #[inline]\n    fn fmt_debug(self, f: inout Fmt) { fmt_signed(&f, self as i64, 32); }\n}\n\nimpl Display for i64 {\n");
        buf_str(out, c"    #[inline]\n    fn fmt(self, f: inout Fmt) { f.int(self); }\n}\n\nimpl Debug for i64 {\n    #[inline]\n    fn fmt_debug(self, f: inout Fmt) { f.int(self); }\n}\n\n// (a number, as in Rust: `{c:c}` writes the byte)\nimpl Display for u8 {\n    #[inline]\n    fn fmt(self, f: inout Fmt) { f.uint(self as u64); }\n}\n\nimpl Debug for u8 {\n    #[inline]\n    fn fmt_debug(self, f: inout Fmt) { f.uint(self as u64); }\n}\n\nimpl Display for u16 {\n    #[inline]\n    fn fmt(self, f: inout Fmt) { f.uint(self as u64); }\n}\n\nimpl Debug for u16 {\n    #[inline]\n    fn fmt_debug(self, f: inout Fmt) { f.uint(self as u64); }\n}\n\nimpl Display for u32 {\n    #[inline]\n    fn fmt(self, f: inout Fmt) { f.uint(self as u64); }\n}\n\nimpl Debug for u32 {\n    #[inline]\n    fn fmt_debug(self, f: inout Fmt) { f.uint(self as u64); }\n}\n\nimpl Display for u64 {\n    #[inline]\n    fn fmt(self, f: inout Fmt) { f.uint(self); }\n}\n\nimpl Debug for u64 {\n    #[inline]\n    fn fmt_debug(self, f: inout Fmt) { f.uint(self); }\n}\n\nimpl Display for bool {\n    #[inline]\n    fn fmt(self, f: inout Fmt) { f.str(if self { \"true\" } else { \"false\" }); }\n}\n\nimpl Debug for bool {\n    #[inline]\n    fn fmt_debug(self, f: inout Fmt) { f.str(if self { \"true\" } else { \"false\" }); }\n}\n\nimpl Display for [u8] {\n    #[inline]\n    fn fmt(self, f: inout Fmt) { f.str(self); }\n}\n\n// (quoted and escaped: `\"a\\n\"`)\nimpl Debug for [u8] {\n    #[inline]\n    fn fmt_debug(self, f: inout Fmt) { fmt_quoted(&f, self); }\n}\n\nimpl<A: Allocator> Display for Buf<A> {\n    #[inline]\n    fn fmt(self, f: inout Fmt) { f.str(self.as_slice()); }\n}\n\nimpl<A: Allocator> Debug for Buf<A> {\n    #[inline]\n    fn fmt_debug(self, f: inout Fmt) { fmt_quoted(&f, self.as_slice()); }\n}\n\nimpl<T: Debug> Debug for Option<T> {\n    fn fmt_debug(self, f: inout Fmt) {\n        match self {\n            Option::Some(x) => {\n                f.str(\"Some(\");\n                f.debug(x);\n");
        buf_str(out, c"                f.byte(')');\n            }\n            Option::None => f.str(\"None\"),\n        }\n    }\n}\n\nimpl<T: Debug, E: Debug> Debug for Result<T, E> {\n    fn fmt_debug(self, f: inout Fmt) {\n        match self {\n            Result::Ok(x) => {\n                f.str(\"Ok(\");\n                f.debug(x);\n            }\n            Result::Err(e) => {\n                f.str(\"Err(\");\n                f.debug(e);\n            }\n        }\n        f.byte(')');\n    }\n}\n\nimpl<T: Debug, A: Allocator> Debug for Vec<T, A> {\n    fn fmt_debug(self, f: inout Fmt) { debug_list(&f, self.as_slice()); }\n}\n\n// (0.16: `Ok(())`)\nimpl Debug for () {\n    fn fmt_debug(self, f: inout Fmt) {\n        f.str(\"()\");\n    }\n}\n\n// ---- Debug of HashMap (0.15) ----\n\n// `{k: v, ...}`, in slot order.\nimpl<K: Hash + Eq + Debug, V: Debug, A: Allocator> Debug for HashMap<K, V, A> {\n    fn fmt_debug(self, f: inout Fmt) {\n        f.byte('{');\n        var first = true;\n        let t = self.raw_table();\n        for i in t.iter() {\n            if !first {\n                f.str(\", \");\n            }\n            first = false;\n            let e = t.get(i);\n            f.debug(e.0);\n            f.str(\": \");\n            f.debug(e.1);\n        }\n        f.byte('}');\n    }\n}\n// ---- Conversions (0.15) ----\n//\n// compiler/std/embed.sh appends this file to std.tach: the same module,\n// `std`. From and Into, the traits of conversions\n// (docs/design/errors-formatting.md). Every type converts from itself,\n// and an integer type from the integer types that widen to it, without\n// an impl; Into is the compiler's: `let y: U = x.into()` is `U::from(x)`.\n\n// ---- Option and Result's adapters (0.15) ----\n\nimpl<T> Option<T> {\n    // Some(x) is Ok(x), None the error `err`: `opt.ok_or(E::Missing)?`.\n    pub fn ok_or<E>(sink self, err: sink E) -> Result<T, E> {\n        match self {\n            Option::Some(x) => Result::Ok(x),\n");
        buf_str(out, c"            Option::None => Result::Err(err),\n        }\n    }\n\n    pub fn map<U, F: Fn(T) -> U>(sink self, f: F) -> Option<U> {\n        match self {\n            Option::Some(x) => Option::Some(f(x)),\n            Option::None => Option::None,\n        }\n    }\n\n    pub fn and_then<U, F: Fn(T) -> Option<U>>(sink self, f: F) -> Option<U> {\n        match self {\n            Option::Some(x) => f(x),\n            Option::None => Option::None,\n        }\n    }\n\n    pub fn unwrap_or_else<F: Fn() -> T>(sink self, f: F) -> T {\n        match self {\n            Option::Some(x) => x,\n            Option::None => f(),\n        }\n    }\n}\n\nimpl<T, E> Result<T, E> {\n    pub fn map<U, F: Fn(T) -> U>(sink self, f: F) -> Result<U, E> {\n        match self {\n            Result::Ok(x) => Result::Ok(f(x)),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n\n    // The error converted: `r.map_err(AppError::Io)?`, `r.map_err(|e| ...)`.\n    pub fn map_err<G, F: Fn(E) -> G>(sink self, f: F) -> Result<T, G> {\n        match self {\n            Result::Ok(x) => Result::Ok(x),\n            Result::Err(e) => Result::Err(f(e)),\n        }\n    }\n\n    pub fn err(sink self) -> Option<E> {\n        match self {\n            Result::Ok(_) => Option::None,\n            Result::Err(e) => Option::Some(e),\n        }\n    }\n\n    pub fn unwrap_or_else<F: Fn(E) -> T>(sink self, f: F) -> T {\n        match self {\n            Result::Ok(x) => x,\n            Result::Err(e) => f(e),\n        }\n    }\n}\n\n// (No string literals below: std's literals are in every program that\n// loads std, used or not.)\n\n// What a `main` returning `Result<(), E>` does with an Err: `Error: {e:?}` and\n// a newline on stderr, then exit status 1 (the compiler calls it).\npub fn main_error<E: Debug>(e: sink E) -> i32 {\n    var f = Fmt::to_fd(2);\n    let head: [u8; 7] = ['E', 'r', 'r', 'o', 'r', ':', ' '];\n    f.str(head[..]);\n    f.debug(e);\n    f.byte('\\n');\n    f.flush();\n");
        buf_str(out, c"    1\n}\n// ---- Clone and hashing (0.15) ----\n//\n// compiler/std/embed.sh appends this file to std.tach: the same module,\n// `std`. Clone, and the helpers `#[derive(Eq, Ord, Hash, Clone)]` calls on\n// each field (docs/design/errors-formatting.md). Numbers, bool, pointers,\n// slices, fn types, fieldless enums, and tuples and arrays of them clone\n// by copying, without an impl; tuples of Eq, Ord, Hash or Clone types are\n// Eq, Ord (lexicographic), Hash and Clone (element-wise), through the\n// functions at the end of this file, which the compiler calls.\n\n// ---- Hashing and comparing helpers (0.15) ----\n\n// Hash h of the fields so far, with the hash x of the next one mixed in.\n#[inline]\npub fn hash_mix(h: u64, x: u64) -> u64 {\n    hash_u64(h ^ (x + 0x9e3779b97f4a7c15u64 + (h << 6) + (h >> 2)))\n}\n\n// `*a == *b`: structural, or the type's Eq impl (`[u8]`: by bytes).\n#[inline]\npub fn eq_of<T: Eq>(a: T, b: T) -> bool {\n    a == b\n}\n\n// `a.cmp(b)`: negative, zero or positive as *a goes before, with or after\n// *b.\n#[inline]\npub fn cmp_of<T: Ord>(a: T, b: T) -> i64 {\n    a.cmp(b)\n}\n\n// `x.hash()`.\n#[inline]\npub fn hash_of<T: Hash>(x: T) -> u64 {\n    x.hash()\n}\n\n// `x.clone()`.\n#[inline]\npub fn clone_of<T: Clone>(x: T) -> T {\n    x.clone()\n}\n\n// A new Vec of clones of the elements, on the same allocator.\nimpl<T: Clone, A: Allocator> Clone for Vec<T, A> {\n    fn clone(self) -> Vec<T, A> {\n        self.clone_in(self.alloc)\n    }\n}\n\nimpl<T: Clone, A: Allocator> Vec<T, A> {\n    // (0.15) n copies of x on allocator a: Rust's `vec![x; n]`. (0.17)\n    // Clones of x, then x itself: n Vecs from one Vec each own their\n    // elements (plain types clone by copying).\n    pub fn filled_in(n: i64, x: sink T, a: sink A) -> Vec<T, A> {\n        var v: Vec<T, A> = Vec::with_capacity_in(n, a);\n        if n > 0 {\n            for _ in 1..n {\n                v.push(x.clone());\n            }\n            v.push(x);\n        }\n        v\n");
        buf_str(out, c"    }\n\n    // A new Vec of clones of the elements, on allocator b (0.16).\n    pub fn clone_in<B: Allocator>(self, b: sink B) -> Vec<T, B> {\n        let s = self.as_slice();\n        var v: Vec<T, B> = Vec::with_capacity_in(s.len, b);\n        for i in 0..s.len {\n            v.push(clone_of(s[i]));\n        }\n        v\n    }\n}\n\nimpl<A: Allocator> Clone for Buf<A> {\n    #[inline]\n    fn clone(self) -> Buf<A> {\n        var b: Buf<A> = Buf::new_in(self.bytes.alloc);\n        b.push_str(self.as_slice());\n        b\n    }\n}\n\n// A new map of clones of the entries.\nimpl<K: Hash + Eq + Clone, V: Clone, A: Allocator> Clone for HashMap<K, V, A> {\n    fn clone(self) -> HashMap<K, V, A> {\n        var m: HashMap<K, V, A> = HashMap::with_capacity_in(self.len(), self.allocator());\n        let t = self.raw_table();\n        for i in t.iter() {\n            let e = t.get(i);\n            m.insert(clone_of(e.0), clone_of(e.1));\n        }\n        m\n    }\n}\n\nimpl<T: Clone> Clone for Option<T> {\n    fn clone(self) -> Option<T> {\n        match self {\n            Option::Some(x) => Option::Some(clone_of(x)),\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl<T: Clone, E: Clone> Clone for Result<T, E> {\n    fn clone(self) -> Result<T, E> {\n        match self {\n            Result::Ok(x) => Result::Ok(clone_of(x)),\n            Result::Err(e) => Result::Err(clone_of(e)),\n        }\n    }\n}\n\n// ---- == on Vec (0.15) ----\n//\n// `==` compares contents, as Rust's: Vecs element by element (so a Buf,\n// whose bytes are a Vec, by bytes), maps by their entries in any order.\n// Whether two values are the same Vec: `a.as_slice().ptr == b.as_slice().ptr`.\n\nimpl<T: Eq, A: Allocator> Eq for Vec<T, A> {\n    fn eq(self, other: Vec<T, A>) -> bool {\n        self.as_slice() == other.as_slice()\n    }\n}\n\n// ---- == on HashMap (0.15) ----\n\nimpl<K: Hash + Eq, V: Eq, A: Allocator> Eq for HashMap<K, V, A> {\n");
        buf_str(out, c"    fn eq(self, other: HashMap<K, V, A>) -> bool {\n        if self.len() != other.len() {\n            return false;\n        }\n        let t = self.raw_table();\n        let u = other.raw_table();\n        for i in t.iter() {\n            let e = t.get(i);\n            let j = u.find(e.0.hash(), |f: (K, V)| f.0 == e.0);\n            if j < 0 || !(u.get(j).1 == e.1) {\n                return false;\n            }\n        }\n        true\n    }\n}\n\n// ---- Clone, Eq, Ord and Hash without an impl (0.15) ----\n//\n// `x.clone()` on a type that copies (a number, bool, pointer, slice, fn,\n// fieldless enum, or a tuple or array of them) is copy_clone; `x.cmp(&y)`\n// on a float, pointer or fieldless enum is scalar_cmp; on a tuple of 2 to\n// 6 elements, `eq` (== when the structural one does not apply), `cmp` (<),\n// `hash` and `clone` are tupleN_eq, tupleN_cmp, tupleN_hash and\n// tupleN_clone (front/derive/intrinsic.tach). They are private: the\n// compiler calls them.\n\n#[inline]\nfn copy_clone<T>(self: T) -> T {\n    self\n}\n\n#[inline]\nfn scalar_cmp<T>(self: T, other: T) -> i64 {\n    if self < other { -1 } else if other < self { 1 } else { 0 }\n}\n\n// (0.18) The traits a distinct type T has from its underlying type B\n// without an impl (front/check/distinct.tach): through a pointer to B,\n// which has T's representation (so the unsafe blocks are sound: `self`\n// and `other` are borrows, and the cast keeps what they point to; the\n// traits take `&Self`, 0.17).\n\n#[inline]\nfn distinct_eq<T, B: Eq>(self: T, other: T) -> bool {\n    unsafe { eq_of(*(&self as *B), *(&other as *B)) }\n}\n\n#[inline]\nfn distinct_cmp<T, B: Ord>(self: T, other: T) -> i64 {\n    unsafe { cmp_of(*(&self as *B), *(&other as *B)) }\n}\n\n#[inline]\nfn distinct_hash<T, B: Hash>(self: T) -> u64 {\n    unsafe { hash_of(*(&self as *B)) }\n}\n\n#[inline]\nfn distinct_clone<T, B: Clone>(self: T) -> T {\n    unsafe { (*(&self as *B)).clone() as T }\n}\n\n");
        buf_str(out, c"fn distinct_fmt<T, B: Display>(self: T, f: inout Fmt) {\n    unsafe { (*(&self as *B)).fmt(&f); }\n}\n\nfn distinct_fmt_debug<T, B: Debug>(self: T, f: inout Fmt) {\n    unsafe { (*(&self as *B)).fmt_debug(&f); }\n}\n\nfn tuple2_cmp<A: Ord, B: Ord>(self: (A, B), other: (A, B)) -> i64 {\n    let c = cmp_of(self.0, other.0);\n    if c != 0 { return c; }\n    cmp_of(self.1, other.1)\n}\n\nfn tuple3_cmp<A: Ord, B: Ord, C: Ord>(self: (A, B, C), other: (A, B, C)) -> i64 {\n    var c = cmp_of(self.0, other.0);\n    if c != 0 { return c; }\n    c = cmp_of(self.1, other.1);\n    if c != 0 { return c; }\n    cmp_of(self.2, other.2)\n}\n\nfn tuple4_cmp<A: Ord, B: Ord, C: Ord,\n    D: Ord>(self: (A, B, C, D), other: (A, B, C, D)) -> i64 {\n    var c = cmp_of(self.0, other.0);\n    if c != 0 { return c; }\n    c = cmp_of(self.1, other.1);\n    if c != 0 { return c; }\n    c = cmp_of(self.2, other.2);\n    if c != 0 { return c; }\n    cmp_of(self.3, other.3)\n}\n\nfn tuple5_cmp<A: Ord, B: Ord, C: Ord, D: Ord, E: Ord>(self: (A, B, C, D, E),\n    other: (A, B, C, D, E)) -> i64 {\n    var c = cmp_of(self.0, other.0);\n    if c != 0 { return c; }\n    c = cmp_of(self.1, other.1);\n    if c != 0 { return c; }\n    c = cmp_of(self.2, other.2);\n    if c != 0 { return c; }\n    c = cmp_of(self.3, other.3);\n    if c != 0 { return c; }\n    cmp_of(self.4, other.4)\n}\n\nfn tuple6_cmp<A: Ord, B: Ord, C: Ord, D: Ord, E: Ord, F: Ord>(self: (A, B, C, D, E, F),\n    other: (A, B, C, D, E, F)) -> i64 {\n    var c = cmp_of(self.0, other.0);\n    if c != 0 { return c; }\n    c = cmp_of(self.1, other.1);\n    if c != 0 { return c; }\n    c = cmp_of(self.2, other.2);\n    if c != 0 { return c; }\n    c = cmp_of(self.3, other.3);\n    if c != 0 { return c; }\n    c = cmp_of(self.4, other.4);\n    if c != 0 { return c; }\n    cmp_of(self.5, other.5)\n}\n\nfn tuple2_eq<A: Eq, B: Eq>(self: (A, B), other: (A, B)) -> bool {\n    eq_of(self.0, other.0) && eq_of(self.1, other.1)\n}\n\n");
        buf_str(out, c"fn tuple3_eq<A: Eq, B: Eq, C: Eq>(self: (A, B, C), other: (A, B, C)) -> bool {\n    eq_of(self.0, other.0) && eq_of(self.1, other.1)\n        && eq_of(self.2, other.2)\n}\n\nfn tuple4_eq<A: Eq, B: Eq, C: Eq, D: Eq>(self: (A, B, C, D), other: (A, B, C, D)) -> bool {\n    eq_of(self.0, other.0) && eq_of(self.1, other.1)\n        && eq_of(self.2, other.2) && eq_of(self.3, other.3)\n}\n\nfn tuple5_eq<A: Eq, B: Eq, C: Eq, D: Eq, E: Eq>(self: (A, B, C, D, E),\n    other: (A, B, C, D, E)) -> bool {\n    eq_of(self.0, other.0) && eq_of(self.1, other.1)\n        && eq_of(self.2, other.2) && eq_of(self.3, other.3)\n        && eq_of(self.4, other.4)\n}\n\nfn tuple6_eq<A: Eq, B: Eq, C: Eq, D: Eq, E: Eq, F: Eq>(self: (A, B, C, D, E, F),\n    other: (A, B, C, D, E, F)) -> bool {\n    eq_of(self.0, other.0) && eq_of(self.1, other.1)\n        && eq_of(self.2, other.2) && eq_of(self.3, other.3)\n        && eq_of(self.4, other.4) && eq_of(self.5, other.5)\n}\n\nfn tuple2_hash<A: Hash, B: Hash>(self: (A, B)) -> u64 {\n    hash_mix(hash_of(self.0), hash_of(self.1))\n}\n\nfn tuple3_hash<A: Hash, B: Hash, C: Hash>(self: (A, B, C)) -> u64 {\n    let h = hash_mix(hash_of(self.0), hash_of(self.1));\n    hash_mix(h, hash_of(self.2))\n}\n\nfn tuple4_hash<A: Hash, B: Hash, C: Hash, D: Hash>(self: (A, B, C, D)) -> u64 {\n    var h = hash_mix(hash_of(self.0), hash_of(self.1));\n    h = hash_mix(h, hash_of(self.2));\n    hash_mix(h, hash_of(self.3))\n}\n\nfn tuple5_hash<A: Hash, B: Hash, C: Hash, D: Hash, E: Hash>(self: (A, B, C, D, E)) -> u64 {\n    var h = hash_mix(hash_of(self.0), hash_of(self.1));\n    h = hash_mix(h, hash_of(self.2));\n    h = hash_mix(h, hash_of(self.3));\n    hash_mix(h, hash_of(self.4))\n}\n\nfn tuple6_hash<A: Hash, B: Hash, C: Hash, D: Hash, E: Hash, F: Hash>(\n    self: (A, B, C, D, E, F)) -> u64 {\n    var h = hash_mix(hash_of(self.0), hash_of(self.1));\n    h = hash_mix(h, hash_of(self.2));\n    h = hash_mix(h, hash_of(self.3));\n    h = hash_mix(h, hash_of(self.4));\n");
        buf_str(out, c"    hash_mix(h, hash_of(self.5))\n}\n\nfn tuple2_clone<A: Clone, B: Clone>(self: (A, B)) -> (A, B) {\n    (clone_of(self.0), clone_of(self.1))\n}\n\nfn tuple3_clone<A: Clone, B: Clone, C: Clone>(self: (A, B, C)) -> (A, B, C) {\n    (clone_of(self.0), clone_of(self.1), clone_of(self.2))\n}\n\nfn tuple4_clone<A: Clone, B: Clone, C: Clone, D: Clone>(self: (A, B, C, D)) -> (A, B, C, D) {\n    (clone_of(self.0), clone_of(self.1), clone_of(self.2), clone_of(self.3))\n}\n\nfn tuple5_clone<A: Clone, B: Clone, C: Clone, D: Clone, E: Clone>(self: (A, B, C, D, E))\n    -> (A, B, C, D, E) {\n    (clone_of(self.0), clone_of(self.1), clone_of(self.2), clone_of(self.3),\n        clone_of(self.4))\n}\n\nfn tuple6_clone<A: Clone, B: Clone, C: Clone, D: Clone, E: Clone, F: Clone>(\n    self: (A, B, C, D, E, F)) -> (A, B, C, D, E, F) {\n    (clone_of(self.0), clone_of(self.1), clone_of(self.2), clone_of(self.3),\n        clone_of(self.4), clone_of(self.5))\n}\n// ---- Allocation (0.16) ----\n\n// Memory comes from allocators: a type implementing Allocator. Containers\n// carry theirs as a type parameter (`Vec<T, A: Allocator = Gpa>`), so an\n// allocation is a call std can see, and effects name it (`alloc(Gpa)`).\n// Allocation is explicit: nothing allocates without being given an\n// allocator, `Vec::new_in(a)`, `collect_in(a)`, `format_in(x, a)`. Gpa,\n// the general-purpose allocator (C's malloc), is the type parameters'\n// default, and a program has one when its main takes it (`gpa: Gpa`, its\n// parameter), passed down as a parameter.\n//\n// Sizes and alignments are in bytes; an alignment is a power of two from 1\n// to 4096. Running out of memory, or misusing an allocator, stops the\n// program (exit 101): part of the effect `alloc`, not `panic`. A size\n// above ALLOC_LIMIT (2^62 bytes) is out of memory.\n\npub trait Allocator {\n    // size bytes aligned to align, null when out of memory; size 0: aligned,\n    // non-null, unreadable.\n");
        buf_str(out, c"    #[effects(alloc, global, panic, diverge, unsafe)]\n    fn try_alloc(self: *Self, size: i64, align: i64) -> *u8;\n    // p (old_size bytes, from this allocator) as new_size bytes, the first\n    // min(old_size, new_size) kept; may move; null: p is left as it was.\n    #[effects(alloc, global, panic, diverge, unsafe)]\n    unsafe fn try_resize(self: *Self, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8;\n    // Gives back p (size bytes, from this allocator).\n    #[effects(alloc, global, panic, diverge, unsafe)]\n    unsafe fn free(self: *Self, p: *u8, size: i64, align: i64);\n\n    // try_alloc, stopping the program when out of memory.\n    #[inline]\n    fn alloc(self: *Self, size: i64, align: i64) -> *u8 {\n        let p = self.try_alloc(size, align);\n        if p == 0 as *u8 {\n            out_of_memory();\n        }\n        p\n    }\n\n    // try_resize, stopping the program when out of memory.\n    #[inline]\n    unsafe fn resize(self: *Self, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n        let q = self.try_resize(p, old_size, new_size, align);\n        if q == 0 as *u8 {\n            out_of_memory();\n        }\n        q\n    }\n}\n\n// What the try_ functions of containers return when out of memory\n// (`v.try_push(x)`, `v.try_reserve(n)`).\npub enum AllocError { OutOfMemory }\n\nimpl Display for AllocError {\n    fn fmt(self, f: inout Fmt) {\n        f.str(\"out of memory\");\n    }\n}\n\nimpl Debug for AllocError {\n    fn fmt_debug(self, f: inout Fmt) {\n        f.str(\"OutOfMemory\");\n    }\n}\n\n// The largest allocation: 2^62 bytes (a size above it is out of memory).\npub const ALLOC_LIMIT: i64 = 4611686018427387904;\n\n// Stops the program: an allocator is out of memory.\n#[cold]\nfn out_of_memory() -> ! {\n    unsafe { panic(c\"out of memory\") }\n}\n\n// n elements of `size` bytes, in bytes; -1 when n is negative or that is\n// above ALLOC_LIMIT.\n#[inline]\nfn alloc_bytes(n: i64, size: i64) -> i64 {\n");
        buf_str(out, c"    if n < 0 || size > 0 && n > ALLOC_LIMIT / size {\n        return -1;\n    }\n    n * size\n}\n\n// The capacity a container grows to from cap for at least need elements:\n// twice cap (4 at least), or need when that is more.\n#[inline]\nfn grown_cap(cap: i64, need: i64) -> i64 {\n    let twice = if cap == 0 { 4 } else if cap < ALLOC_LIMIT / 2 { cap * 2 } else { ALLOC_LIMIT };\n    if twice < need { need } else { twice }\n}\n\n// ---- Gpa ----\n\n// The general-purpose allocator: C's malloc, realloc and free (its\n// implementation follows std's source: gpa.tach, or the checking one of\n// --check-alloc). Zero-sized, copied freely: a Vec<T> on it is three\n// words. Sealed: only the runtime's entry makes one, main's parameter\n// `gpa: Gpa`; a static cannot hold one (no constant makes one), so a\n// program keeps its containers in main and passes them down.\n#[sealed]\npub struct Gpa {}\n\n// ---- Arenas (0.16) ----\n\n// An arena: allocations bump a pointer through chunks taken from Gpa, and\n// are given back all at once: when a scope ends (`a.scope(|s| ...)`,\n// `arena_scope(gpa, |s| ...)`), or by `reset` and `free_all` (unsafe: what\n// was allocated must not be used after). A request above 32 KB gets a\n// chunk of its own; the last block grows and shrinks in place; `free`\n// gives back the last block, and a chunk of its own. A handle: copies\n// share the arena. `Arena::none()`, a constant (for statics), has no\n// memory: allocating from it stops the program.\n//\n// (--check-alloc, CHECK_ALLOC: each block is on pages of its own from the\n// checking Gpa, its owner the arena's state; the bump keeps the\n// accounting, so `used` and exhaustion are as without; a block given back\n// (free, a move, a reset, a scope's end, free_all) loses its pages.)\n#[sealed]\npub struct Arena { s: *ArenaState }\n\n// A chunk of an arena's memory, from Gpa: this header, then its bytes (the\n// first chunk's start with the arena's state).\n");
        buf_str(out, c"struct ArenaChunk { next: *ArenaChunk, size: i64 }\n\n// A block of its own (a request above ARENA_LARGE): this header, at\n// arena_large_head(align) bytes before the block, in a list both ways.\nstruct ArenaLarge { next: *ArenaLarge, prev: *ArenaLarge, size: i64, align: i64 }\n\n// The state of an arena, in its first chunk, or of a scope, on the stack\n// of the scope's function. Addresses are i64s; ptr..limit is where the\n// next block goes (limit is 0 while the arena is lent to a scope).\nstruct ArenaState {\n    ptr: i64,\n    limit: i64,\n    // the current chunk, its first byte and its end\n    chunk: *ArenaChunk,\n    start: i64,\n    end: i64,\n    // the last block (it grows in place), -1: none\n    last: i64,\n    // the bytes used in the chunks before the current one\n    before: i64,\n    lent: bool,\n    // the arena's own state (itself for an Arena; for a scope, its arena's)\n    root: *ArenaState,\n    // a scope's: the arena's blocks of their own when it started\n    large_mark: *ArenaLarge,\n    // the root's: its chunks, its blocks of their own, the bytes of these,\n    // the bytes taken from Gpa, the size of the next chunk\n    first: *ArenaChunk,\n    large: *ArenaLarge,\n    large_bytes: i64,\n    chunk_bytes: i64,\n    next_size: i64,\n    // a scope's, with --check-alloc: the checking Gpa's blocks when it\n    // started (check_alloc_mark)\n    check_mark: i64,\n}\n\n// Requests above this get a chunk of their own.\nconst ARENA_LARGE: i64 = 32768;\n// The first chunk's bytes (Arena::new_in), the first next chunk's (a\n// request up to ARENA_LARGE, aligned, fits in any), the largest.\nconst ARENA_FIRST: i64 = 8192;\nconst ARENA_NEXT: i64 = 65536;\nconst ARENA_MAX_CHUNK: i64 = 4194304;\nconst ARENA_CHUNK_HEAD: i64 = 16;\nconst ARENA_ALIGN_MAX: i64 = 4096;\n\n// A block's bytes from state s: the bump (an Arena's and a ScopedArena's\n// try_alloc), inlined where they are called; the rest (a new chunk, a\n");
        buf_str(out, c"// block of its own, Arena::none(), a lent arena) out of line and cold.\n#[inline]\nfn arena_alloc(s: *ArenaState, size: i64, align: i64) -> *u8 {\n    unsafe {\n        if s != 0 as *ArenaState {\n            let p = (s.ptr + align - 1) & -align;\n            let e = p + size;\n            if (size as u64) <= (ARENA_LARGE as u64) && p >= s.ptr && e <= s.limit {\n                s.ptr = e;\n                s.last = p;\n                if CHECK_ALLOC {\n                    // (the block's own pages; the bump keeps the count)\n                    return check_alloc_block(s.root as u64, size, align);\n                }\n                return p as *u8;\n            }\n        }\n        arena_alloc_slow(s, size, align)\n    }\n}\n\n// Whether align is an alignment: a power of two from 1 to 4096.\nfn arena_align_ok(align: i64) -> bool {\n    align >= 1 && align <= ARENA_ALIGN_MAX && (align & (align - 1)) == 0\n}\n\n// arena_alloc when the bump does not fit: a block of its own, or the next\n// chunk (a new one when there is none).\n#[cold]\n#[inline(never)]\nunsafe fn arena_alloc_slow(s: *ArenaState, size: i64, align: i64) -> *u8 {\n    arena_usable(s);\n    if size < 0 || size > ALLOC_LIMIT || !arena_align_ok(align) {\n        return 0 as *u8;\n    }\n    if size > ARENA_LARGE {\n        return arena_large_alloc(s.root, size, align);\n    }\n    var c = s.chunk.next;\n    if c == 0 as *ArenaChunk {\n        c = arena_new_chunk(s.root, s.chunk);\n        if c == 0 as *ArenaChunk {\n            return 0 as *u8;\n        }\n    }\n    s.before += s.ptr - s.start;\n    s.chunk = c;\n    s.start = c as i64 + ARENA_CHUNK_HEAD;\n    s.end = c as i64 + c.size;\n    s.limit = s.end;\n    s.ptr = s.start;\n    s.last = -1;\n    // (a request up to ARENA_LARGE, aligned, fits in any next chunk)\n    arena_alloc(s, size, align)\n}\n\n// Stops the program unless s is an arena that can allocate: not\n// Arena::none(), not lent to a scope.\nunsafe fn arena_usable(s: *ArenaState) {\n");
        buf_str(out, c"    if s == 0 as *ArenaState {\n        panic(c\"the arena has no memory: it is Arena::none()\");\n    }\n    if s.lent {\n        panic(c\"the arena is lent to a scope: allocate from the scope's arena\");\n    }\n}\n\n// A new chunk from Gpa, after chunk `after` in root's list; null when out\n// of memory.\nunsafe fn arena_new_chunk(root: *ArenaState, after: *ArenaChunk) -> *ArenaChunk {\n    let size = root.next_size;\n    let g = Gpa {};\n    let c = g.try_alloc(size, 16) as *ArenaChunk;\n    if c == 0 as *ArenaChunk {\n        return c;\n    }\n    c.size = size;\n    c.next = after.next;\n    after.next = c;\n    root.chunk_bytes += size;\n    if size < ARENA_MAX_CHUNK {\n        root.next_size = size * 2;\n    }\n    c\n}\n\n// The bytes of a block of its own before it: its header, or the\n// alignment when that is more.\nfn arena_large_head(align: i64) -> i64 {\n    if align > 32 { align } else { 32 }\n}\n\n// A block of its own of size bytes from Gpa, at the front of root's list.\nunsafe fn arena_large_alloc(root: *ArenaState, size: i64, align: i64) -> *u8 {\n    let head = arena_large_head(align);\n    let g = Gpa {};\n    let c = g.try_alloc(head + size, if align > 16 { align } else { 16 });\n    if c == 0 as *u8 {\n        return c;\n    }\n    let p = &c[head];\n    let h = (&p[-32]) as *ArenaLarge;\n    h.size = size;\n    h.align = align;\n    h.prev = 0 as *ArenaLarge;\n    h.next = root.large;\n    if root.large != 0 as *ArenaLarge {\n        root.large.prev = h;\n    }\n    root.large = h;\n    root.large_bytes += size;\n    root.chunk_bytes += head + size;\n    p\n}\n\n// Gives back block p, of its own, of root.\nunsafe fn arena_large_free(root: *ArenaState, p: *u8) {\n    let h = (&p[-32]) as *ArenaLarge;\n    let head = arena_large_head(h.align);\n    if h.prev == 0 as *ArenaLarge {\n        root.large = h.next;\n    } else {\n        h.prev.next = h.next;\n    }\n    if h.next != 0 as *ArenaLarge {\n        h.next.prev = h.prev;\n    }\n");
        buf_str(out, c"    root.large_bytes -= h.size;\n    root.chunk_bytes -= head + h.size;\n    let g = Gpa {};\n    g.free(&p[-head], head + h.size, if h.align > 16 { h.align } else { 16 });\n}\n\n// Gives back the blocks of their own of root down to `mark` (the list's\n// front when a scope started), or all of them.\nunsafe fn arena_large_free_to(root: *ArenaState, mark: *ArenaLarge) {\n    for _ in 0..ALLOC_LIMIT {\n        let h = root.large;\n        if h == mark {\n            return;\n        }\n        arena_large_free(root, &(h as *u8)[32]);\n    }\n}\n\n// An Arena's or a ScopedArena's try_resize: the last block in place, a\n// block of its own with Gpa's resize, else moved.\n#[inline]\nunsafe fn arena_resize(s: *ArenaState, p: *u8, old_size: i64, new_size: i64, align: i64)\n    -> *u8 {\n    if CHECK_ALLOC {\n        return arena_resize_checked(s, p, old_size, new_size, align);\n    }\n    if s != 0 as *ArenaState && p as i64 == s.last && (new_size as u64) <= (ARENA_LARGE as u64)\n        && old_size <= ARENA_LARGE && p as i64 + new_size <= s.limit {\n        s.ptr = p as i64 + new_size;\n        return p;\n    }\n    arena_resize_slow(s, p, old_size, new_size, align)\n}\n\n#[cold]\n#[inline(never)]\nunsafe fn arena_resize_slow(s: *ArenaState, p: *u8, old_size: i64, new_size: i64, align: i64)\n    -> *u8 {\n    arena_usable(s);\n    if new_size < 0 || new_size > ALLOC_LIMIT || !arena_align_ok(align) {\n        return 0 as *u8;\n    }\n    if old_size > ARENA_LARGE && new_size > ARENA_LARGE {\n        // (a block of its own stays one: resized by Gpa, relinked)\n        let root = s.root;\n        let h = (&p[-32]) as *ArenaLarge;\n        let head = arena_large_head(align);\n        let g = Gpa {};\n        let c = g.try_resize(&p[-head], head + old_size, head + new_size,\n            if align > 16 { align } else { 16 });\n        if c == 0 as *u8 {\n            return c;\n        }\n        let q = &c[head];\n        let k = (&q[-32]) as *ArenaLarge;\n");
        buf_str(out, c"        if k.prev == 0 as *ArenaLarge {\n            root.large = k;\n        } else {\n            k.prev.next = k;\n        }\n        if k.next != 0 as *ArenaLarge {\n            k.next.prev = k;\n        }\n        k.size = new_size;\n        root.large_bytes += new_size - old_size;\n        root.chunk_bytes += new_size - old_size;\n        return q;\n    }\n    let q = arena_alloc(s, new_size, align);\n    if q == 0 as *u8 {\n        return q;\n    }\n    let n = if old_size < new_size { old_size } else { new_size };\n    if n > 0 {\n        memcpy(q, p, n as u64);\n    }\n    arena_free(s, p, old_size);\n    q\n}\n\n// arena_resize with --check-alloc: the last block (the last live one of\n// the arena, as the bump's `last`) grows in place in the count and moves\n// to pages of its new size; any other as without.\n#[cold]\n#[inline(never)]\nunsafe fn arena_resize_checked(s: *ArenaState, p: *u8, old_size: i64, new_size: i64,\n    align: i64) -> *u8 {\n    if s != 0 as *ArenaState && s.last != -1 && (new_size as u64) <= (ARENA_LARGE as u64)\n        && old_size <= ARENA_LARGE && s.last + new_size <= s.limit\n        && check_alloc_is_last(s.root as u64, p) {\n        let q = check_alloc_moved(s.root as u64, p, old_size, new_size, align);\n        if q != 0 as *u8 {\n            s.ptr = s.last + new_size;\n        }\n        return q;\n    }\n    arena_resize_slow(s, p, old_size, new_size, align)\n}\n\n// An Arena's or a ScopedArena's free: the last block goes back to the\n// bump, a block of its own to Gpa; any other waits for the arena's end.\n// Nothing while the arena is lent to a scope.\n#[inline]\nunsafe fn arena_free(s: *ArenaState, p: *u8, size: i64) {\n    if s == 0 as *ArenaState || s.lent {\n        return;\n    }\n    if size > ARENA_LARGE {\n        arena_large_free(s.root, p);\n    } else if CHECK_ALLOC {\n        // (the last live block of the arena is the bump's last; the block's\n        // pages go)\n");
        buf_str(out, c"        if s.last != -1 && check_alloc_is_last(s.root as u64, p) {\n            s.ptr = s.last;\n            s.last = -1;\n        }\n        check_alloc_moved(s.root as u64, p, size, 0, 1);\n    } else if p as i64 == s.last {\n        s.ptr = s.last;\n        s.last = -1;\n    }\n}\n\n// The bytes allocated from state s (blocks of their own included).\nunsafe fn arena_used(s: *ArenaState) -> i64 {\n    s.before + s.ptr - s.start + s.root.large_bytes\n}\n\nimpl Allocator for Arena {\n    #[inline]\n    fn try_alloc(self: *Arena, size: i64, align: i64) -> *u8 {\n        unsafe { arena_alloc(self.s, size, align) }\n    }\n\n    #[inline]\n    unsafe fn try_resize(self: *Arena, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n        arena_resize(self.s, p, old_size, new_size, align)\n    }\n\n    #[inline]\n    unsafe fn free(self: *Arena, p: *u8, size: i64, align: i64) {\n        arena_free(self.s, p, size);\n    }\n}\n\nimpl Arena {\n    // A new arena, its chunks from gpa: the first of 8 KB, the next\n    // ones twice as large each up to 4 MB.\n    pub fn new_in(gpa: Gpa) -> Arena {\n        Arena::with_capacity_in(ARENA_FIRST, gpa)\n    }\n\n    // A new arena with room for `bytes` in its first chunk.\n    pub fn with_capacity_in(bytes: i64, gpa: Gpa) -> Arena {\n        let head = ARENA_CHUNK_HEAD + size_of(ArenaState);\n        let room = if bytes < 0 { 0 } else { bytes };\n        if room > ALLOC_LIMIT - head {\n            out_of_memory();\n        }\n        let size = head + room;\n        unsafe {\n            let c = gpa.alloc(size, 16) as *ArenaChunk;\n            c.next = 0 as *ArenaChunk;\n            c.size = size;\n            let s = (c as i64 + ARENA_CHUNK_HEAD) as *ArenaState;\n            s.start = c as i64 + head;\n            s.ptr = s.start;\n            s.end = c as i64 + size;\n            s.limit = s.end;\n            s.chunk = c;\n            s.last = -1;\n            s.before = 0;\n            s.lent = false;\n");
        buf_str(out, c"            s.root = s;\n            s.large_mark = 0 as *ArenaLarge;\n            s.first = c;\n            s.large = 0 as *ArenaLarge;\n            s.large_bytes = 0;\n            s.chunk_bytes = size;\n            s.next_size = ARENA_NEXT;\n            s.check_mark = 0;\n            Arena { s: s }\n        }\n    }\n\n    // An arena that has no memory, a constant (for statics: `static var\n    // V: Vec<i64, Arena> = Vec::new_in(Arena::none());`, set up in main\n    // with `Arena::new_in(gpa)`). Allocating from it stops the program.\n    pub fn none() -> Arena {\n        Arena { s: 0 as *ArenaState }\n    }\n\n    // The bytes allocated from the arena since it was made or reset.\n    pub fn used(self) -> i64 {\n        if self.s == 0 as *ArenaState { 0 } else { unsafe { arena_used(self.s) } }\n    }\n\n    // The bytes the arena holds from Gpa: its chunks and blocks.\n    pub fn chunk_bytes(self) -> i64 {\n        if self.s == 0 as *ArenaState { 0 } else { unsafe { self.s.chunk_bytes } }\n    }\n\n    // Everything allocated from the arena is given back; its chunks are\n    // kept (blocks of their own go back to Gpa). Unsafe: what was\n    // allocated must not be used after.\n    pub unsafe fn reset(self: *Arena) {\n        let s = self.s;\n        if s == 0 as *ArenaState {\n            return;\n        }\n        arena_usable(s);\n        arena_large_free_to(s, 0 as *ArenaLarge);\n        if CHECK_ALLOC {\n            check_alloc_release(s as u64, 0);\n        }\n        let c = s.first;\n        s.chunk = c;\n        s.start = c as i64 + ARENA_CHUNK_HEAD + size_of(ArenaState);\n        s.ptr = s.start;\n        s.end = c as i64 + c.size;\n        s.limit = s.end;\n        s.last = -1;\n        s.before = 0;\n    }\n\n    // The arena's memory, chunks included, given back to Gpa; this handle\n    // becomes Arena::none(). Unsafe: nothing allocated from it, and no\n    // copy of the handle, may be used after.\n    pub unsafe fn free_all(self: *Arena) {\n");
        buf_str(out, c"        let s = self.s;\n        if s == 0 as *ArenaState {\n            return;\n        }\n        arena_usable(s);\n        arena_large_free_to(s, 0 as *ArenaLarge);\n        if CHECK_ALLOC {\n            check_alloc_release(s as u64, 0);\n        }\n        let g = Gpa {};\n        var c = s.first.next;\n        for _ in 0..ALLOC_LIMIT {\n            if c == 0 as *ArenaChunk {\n                break;\n            }\n            let next = c.next;\n            g.free(c as *u8, c.size, 16);\n            c = next;\n        }\n        let first = s.first;\n        g.free(first as *u8, first.size, 16);\n        self.s = 0 as *ArenaState;\n    }\n\n    // f with a scope of this arena: what f allocates from the ScopedArena\n    // it is given is given back when f returns. The arena is lent\n    // meanwhile: allocating from it stops the program. Nothing on the\n    // ScopedArena can leave f (#[scoped]).\n    pub fn scope<R, F: FnMut(ScopedArena) -> R>(self, f: F) -> R {\n        unsafe { arena_scope_of(self.s, f) }\n    }\n}\n\n// An arena lent to a scope (arena_scope, Arena::scope): what is allocated\n// from it is given back when the scope ends, so nothing holding it can\n// leave the scope (#[scoped]: not returned, not captured by another\n// scope, not in a static).\n#[sealed]\n#[scoped]\npub struct ScopedArena { s: *ArenaState, mark: i64 }\n\nimpl Allocator for ScopedArena {\n    #[inline]\n    fn try_alloc(self: *ScopedArena, size: i64, align: i64) -> *u8 {\n        unsafe { arena_alloc(self.s, size, align) }\n    }\n\n    #[inline]\n    unsafe fn try_resize(self: *ScopedArena, p: *u8, old_size: i64, new_size: i64, align: i64)\n        -> *u8 {\n        arena_resize(self.s, p, old_size, new_size, align)\n    }\n\n    #[inline]\n    unsafe fn free(self: *ScopedArena, p: *u8, size: i64, align: i64) {\n        arena_free(self.s, p, size);\n    }\n}\n\nimpl ScopedArena {\n    // The bytes allocated from this scope.\n    pub fn used(self) -> i64 {\n");
        buf_str(out, c"        unsafe { arena_used(self.s) - self.mark }\n    }\n\n    // f with a scope of this one (lent meanwhile), as Arena::scope.\n    pub fn scope<R, F: FnMut(ScopedArena) -> R>(self, f: F) -> R {\n        unsafe { arena_scope_of(self.s, f) }\n    }\n}\n\n// f with a new arena, its chunks from gpa, given back when f returns.\npub fn arena_scope<R, F: FnMut(ScopedArena) -> R>(gpa: Gpa, f: F) -> R {\n    var a = Arena::new_in(gpa);\n    // (arena_scope_of, not a.scope: the scoped check of a function passed\n    // by name is at the call of arena_scope, once)\n    unsafe {\n        let r = arena_scope_of(a.s, f);\n        a.free_all();\n        r\n    }\n}\n\n// f with a scope of the arena of state p: the scope's state starts where\n// p's is, p is lent (its limit 0) until f returns, then p's blocks of\n// their own made meanwhile go back.\nfn arena_scope_of<R, F: FnMut(ScopedArena) -> R>(p: *ArenaState, f: F) -> R {\n    var st = ArenaState {\n        ptr: 0, limit: 0, chunk: 0 as *ArenaChunk, start: 0, end: 0, last: -1, before: 0,\n        lent: false, root: 0 as *ArenaState, large_mark: 0 as *ArenaLarge,\n        first: 0 as *ArenaChunk, large: 0 as *ArenaLarge, large_bytes: 0, chunk_bytes: 0,\n        next_size: 0, check_mark: 0,\n    };\n    let mark = unsafe { arena_lend(p, &st) };\n    let site = if CHECK_ALLOC { check_alloc_site() } else { 0 as *u8 };\n    var g = f;\n    let r = g(ScopedArena { s: &st, mark: mark });\n    unsafe {\n        if CHECK_ALLOC {\n            check_alloc_set_site(site);\n        }\n        arena_unlend(p, &st);\n    }\n    r\n}\n\n// Lends the arena of state p to a scope of state st: st starts at p's\n// position, p is locked. Returns the bytes used at the start.\nunsafe fn arena_lend(p: *ArenaState, st: *ArenaState) -> i64 {\n    arena_usable(p);\n    st.ptr = p.ptr;\n    st.limit = p.limit;\n    st.chunk = p.chunk;\n    st.start = p.start;\n    st.end = p.end;\n    st.before = p.before;\n    st.root = p.root;\n");
        buf_str(out, c"    st.large_mark = p.root.large;\n    if CHECK_ALLOC {\n        st.check_mark = check_alloc_mark();\n    }\n    p.lent = true;\n    p.limit = 0;\n    arena_used(st)\n}\n\n// The scope of state st is over: its blocks of their own go back, and p,\n// where it was, is no longer lent (st's chunks are p's next ones).\nunsafe fn arena_unlend(p: *ArenaState, st: *ArenaState) {\n    arena_large_free_to(p.root, st.large_mark);\n    if CHECK_ALLOC {\n        // (the scope's blocks, and its scopes': p was locked meanwhile)\n        check_alloc_release(p.root as u64, st.check_mark);\n    }\n    st.lent = true;\n    st.limit = 0;\n    p.lent = false;\n    p.limit = p.end;\n}\n\n// ---- FixedBuf (0.16) ----\n\n// An allocator in a fixed buffer of bytes: `FixedBuf::new(mem[..])` over an\n// array or a Vec's view, which must outlive it (not checked). Blocks bump\n// through it; when it is full, try_alloc is null (out of memory). Its\n// first 16 bytes (from the first one aligned to 8) hold the bytes used and\n// the last block, so copies of the handle share them.\n#[sealed]\npub struct FixedBuf { base: *u8, cap: i64 }\n\nconst FIXED_HEAD: i64 = 16;\n\nimpl Allocator for FixedBuf {\n    #[inline]\n    fn try_alloc(self: *FixedBuf, size: i64, align: i64) -> *u8 {\n        // (self: the trait's raw `*Self`)\n        if unsafe { self.cap } == 0 || !arena_align_ok(align) {\n            return 0 as *u8;\n        }\n        unsafe {\n            let h = (&self.base[-FIXED_HEAD]) as *i64;\n            let b = self.base as i64;\n            let p = (b + h[0] + align - 1) & -align;\n            if size < 0 || size > ALLOC_LIMIT || p + size > b + self.cap {\n                return 0 as *u8;\n            }\n            h[0] = p + size - b;\n            h[1] = p;\n            if CHECK_ALLOC {\n                // (the block's own pages; the bump keeps the count)\n                return check_alloc_block(self.base as u64, size, align);\n            }\n            p as *u8\n        }\n    }\n\n");
        buf_str(out, c"    #[inline]\n    unsafe fn try_resize(self: *FixedBuf, p: *u8, old_size: i64, new_size: i64, align: i64)\n        -> *u8 {\n        if self.cap == 0 || new_size < 0 || new_size > ALLOC_LIMIT {\n            return 0 as *u8;\n        }\n        let h = (&self.base[-FIXED_HEAD]) as *i64;\n        let b = self.base as i64;\n        if CHECK_ALLOC {\n            // (h[1] is the last block's place in the count; the block moves\n            // to pages of its new size)\n            let owner = self.base as u64;\n            if h[1] != -1 && h[1] + new_size <= b + self.cap && check_alloc_is_last(owner, p) {\n                let q = check_alloc_moved(owner, p, old_size, new_size, align);\n                if q != 0 as *u8 {\n                    h[0] = h[1] + new_size - b;\n                }\n                return q;\n            }\n            let q = self.try_alloc(new_size, align);\n            if q == 0 as *u8 {\n                return q;\n            }\n            let n = if old_size < new_size { old_size } else { new_size };\n            if n > 0 {\n                memcpy(q, p, n as u64);\n            }\n            check_alloc_moved(owner, p, old_size, 0, align);\n            return q;\n        }\n        if p as i64 == h[1] && p as i64 + new_size <= b + self.cap {\n            h[0] = p as i64 + new_size - b;\n            return p;\n        }\n        let q = self.try_alloc(new_size, align);\n        if q == 0 as *u8 {\n            return q;\n        }\n        let n = if old_size < new_size { old_size } else { new_size };\n        if n > 0 {\n            memcpy(q, p, n as u64);\n        }\n        q\n    }\n\n    #[inline]\n    unsafe fn free(self: *FixedBuf, p: *u8, size: i64, align: i64) {\n        if self.cap == 0 {\n            return;\n        }\n        let h = (&self.base[-FIXED_HEAD]) as *i64;\n        if CHECK_ALLOC {\n            let owner = self.base as u64;\n            if h[1] != -1 && check_alloc_is_last(owner, p) {\n");
        buf_str(out, c"                h[0] = h[1] - self.base as i64;\n                h[1] = -1;\n            }\n            check_alloc_moved(owner, p, size, 0, align);\n            return;\n        }\n        if p as i64 == h[1] {\n            h[0] = p as i64 - self.base as i64;\n            h[1] = -1;\n        }\n    }\n}\n\nimpl FixedBuf {\n    // An allocator in mem (its first 16 bytes, from the first one aligned\n    // to 8, are its own; a smaller mem has no room).\n    pub fn new(mem: [u8]) -> FixedBuf {\n        let at = mem.ptr as i64;\n        let skip = ((at + 7) & -8) - at + FIXED_HEAD;\n        if mem.len <= skip {\n            return FixedBuf { base: 0 as *u8, cap: 0 };\n        }\n        unsafe {\n            let base = &mem.ptr[skip];\n            let h = (&base[-FIXED_HEAD]) as *i64;\n            h[0] = 0;\n            h[1] = -1;\n            FixedBuf { base: base, cap: mem.len - skip }\n        }\n    }\n\n    // The bytes allocated from it.\n    pub fn used(self) -> i64 {\n        if self.cap == 0 { 0 } else { unsafe { ((&self.base[-FIXED_HEAD]) as *i64)[0] } }\n    }\n\n    // Its bytes, for allocating from it again. Unsafe: what was allocated\n    // must not be used after.\n    pub unsafe fn reset(self: *FixedBuf) {\n        if self.cap != 0 {\n            let h = (&self.base[-FIXED_HEAD]) as *i64;\n            h[0] = 0;\n            h[1] = -1;\n            if CHECK_ALLOC {\n                check_alloc_release(self.base as u64, 0);\n            }\n        }\n    }\n}\n\n// ---- The ambient Gpa of 0.15 (0.16, until the corpus is migrated) ----\n\n// std's ambient constructors of 0.15 (`Vec::new()`, `collect()`...),\n// errors outside std, take their Gpa here, until `fix --only alloc016`\n// migrates the corpus (front/ambient.tach): not `pub`, it goes with them.\ntrait Ambient { fn ambient() -> Self; }\n\nimpl Ambient for Gpa {\n    #[ambient(\"a 'gpa: Gpa' parameter, from main's\")]\n    #[inline]\n    fn ambient() -> Gpa { Gpa {} }\n}\n\n");
        buf_str(out, c"// ---- Panic and unreachable, the prelude's (0.17) ----\n\n// The prelude's `panic(message)`: prints `message` on stderr and exits\n// with 101, as a failed check does; safe (the message is a slice, not the\n// C string of `std::panic`).\npub fn panic_str(message: [u8]) -> ! {\n    unsafe {\n        panic_write(2, message.ptr, message.len as u64);\n        panic_write(2, c\"\\n\", 1);\n        panic_exit(101)\n    }\n}\n\n// The prelude's `unreachable()`: a place the program never reaches;\n// reached, it prints \"entered unreachable code\" and exits with 101.\npub fn unreachable() -> ! {\n    panic_str(\"entered unreachable code\")\n}\n\n// (0.18) The prelude's `assert(c)`: `c` must hold; when it does not, the\n// program prints `FILE:LINE:COL: assertion failed: 'c'` with the values\n// of c's operands and exits with 101. `assert(c, \"message\")` prints the\n// message instead of c. The compiler makes each call a check.\npub fn assert(ok: bool, message: [u8] = \"\") {\n    if !ok {\n        panic_str(message)\n    }\n}\n\n// (0.18) The prelude's `assert_eq(a, b)`: `assert(a == b)`, which reports\n// both values.\npub fn assert_eq<T: Eq>(a: sink T, b: sink T) {\n    if !(a == b) {\n        unreachable()\n    }\n}\n\n// (0.18) The prelude's `assert_ne(a, b)`: `assert(a != b)`.\npub fn assert_ne<T: Eq>(a: sink T, b: sink T) {\n    if a == b {\n        unreachable()\n    }\n}\n\n// (0.18) The prelude's `debug_assert(c)`: `assert(c)` in test builds\n// (`tachyonc test`, --debug-contracts); nothing (c is not evaluated) in\n// others.\npub fn debug_assert(ok: bool, message: [u8] = \"\") {\n    if !ok {\n        panic_str(message)\n    }\n}\n// std's values section (0.17): appended to std's text after alloc.tach\n// (compiler/std/embed.sh).\n\n// ---- Values (0.17) ----\n\n// Mutable value semantics (docs/design/value-semantics.md): the prelude's\n// Drop, drop, forget, needs_drop and Copy; std::take and std::replace.\n");
        buf_str(out, c"// (0.17: values move and drop, front/own; std's containers implement Drop\n// with T4.)\n\n// What a value does when its owner goes out of scope: `impl Drop for T`.\n// Calling `x.drop()` yourself is an error; `drop(x)` ends x early.\npub trait Drop {\n    fn drop(inout self);\n}\n\n// Consumes x: its drop runs here, not at the end of its scope.\npub fn drop<T>(x: sink T) {}\n\n// Consumes x without running its drop: a leak, which is safe\n// (`--check-alloc` lists it).\npub fn forget<T>(x: sink T) {}\n\n// Whether a value of type T has a drop to run (a constant, folded where\n// it is called).\npub fn needs_drop<T>() -> bool {\n    false\n}\n\n// `T: Copy` holds when T is plain: `=` copies it (numbers, bool, raw\n// pointers, fieldless enums, and aggregates of those). No type implements\n// it with an impl block.\npub trait Copy {}\n\n// A type's empty value: what std::take leaves behind.\npub trait Default {\n    fn default() -> Self;\n}\n\n// Exchanges *a and *b. (Bit for bit, as replace: a write through a raw\n// pointer drops nothing, so neither value is dropped or copied.)\npub fn swap<T>(a: inout T, b: inout T) {\n    unsafe {\n        let pa: *T = &a;\n        let pb: *T = &b;\n        let t = *pa;\n        *pa = *pb;\n        *pb = t;\n    }\n}\n\n// The value at *dest, replaced by value. (The old value moves out and the\n// new one in, bit for bit: a write through a raw pointer drops nothing.)\npub fn replace<T>(dest: inout T, value: sink T) -> T {\n    unsafe {\n        let p: *T = &dest;\n        let old = *p;\n        *p = value;\n        old\n    }\n}\n\n// The value at *dest, replaced by T's empty value (`std::take(&mut\n// self.count)`). A container's empty value needs its allocator: Vec, Buf\n// and HashMap have `take` methods, `self.keys.take()`, which keep it.\npub fn take<T: Default>(dest: inout T) -> T {\n    let empty: T = T::default();\n    replace(&dest, empty)\n}\n\n// The empty values: 0, false, None.\n");
        buf_str(out, c"impl Default for i8 { fn default() -> i8 { 0 } }\nimpl Default for i16 { fn default() -> i16 { 0 } }\nimpl Default for i32 { fn default() -> i32 { 0 } }\nimpl Default for i64 { fn default() -> i64 { 0 } }\nimpl Default for u8 { fn default() -> u8 { 0 } }\nimpl Default for u16 { fn default() -> u16 { 0 } }\nimpl Default for u32 { fn default() -> u32 { 0 } }\nimpl Default for u64 { fn default() -> u64 { 0 } }\nimpl Default for f32 { fn default() -> f32 { 0.0 } }\nimpl Default for f64 { fn default() -> f64 { 0.0 } }\nimpl Default for bool { fn default() -> bool { false } }\nimpl<T> Default for Option<T> { fn default() -> Option<T> { Option::None } }\n// ---- Testing (0.18) ----\n\n// What `#[property]` tests and `#[fuzz]` targets draw their values from,\n// and the runtime of a test build (docs/design/contracts-verification.md\n// §2.6, §2.7, 0.18 T2). `tachyonc test` builds the program with\n// `--test-build`: the compiler (front/tests) writes a `main` that runs the\n// test its arguments name, and a generator for each property's\n// parameters, built from their types (an `impl Arbitrary` where there is\n// one). A value is drawn from a choice sequence of u64s, and smaller\n// choices make simpler values (0: 0, false, empty, None, the first\n// variant): a failing case is shrunk by shortening and lowering its\n// sequence, then replaying it. Generators take `&mut Gen` (0.17).\n\n// A type's own generator, used in place of the structural one.\npub trait Arbitrary {\n    fn arbitrary(g: inout Gen) -> Self;\n}\n\npub struct Gen {\n    choices: *u64, count: i64, at: i64, size: i64, gpa: Gpa, depth: i64,\n    showing: bool, report: i32, raw: bool,\n}\n\nimpl Gen {\n    // An integer: 0, -1, 1, -2, 2, ... as the choice grows (the edges,\n    // i64::MIN and i64::MAX, are the largest choices).\n    pub fn int(inout self) -> i64 {\n        let c = self.draw();\n        ((c >> 1) as i64) ^ -((c & 1) as i64)\n    }\n\n    // An integer in lo..=hi (lo first).\n");
        buf_str(out, c"    pub fn int_in(inout self, lo: i64, hi: i64) -> i64 {\n        let c = self.draw();\n        if hi <= lo {\n            return lo;\n        }\n        let span = (hi - lo) as u64 + 1;\n        if span == 0 {\n            return lo + c as i64;\n        }\n        lo + (c % span) as i64\n    }\n\n    // One of 0..n.\n    pub fn choose(inout self, n: i64) -> i64 {\n        let c = self.draw();\n        if n <= 1 { 0 } else { (c % n as u64) as i64 }\n    }\n\n    pub fn bool(inout self) -> bool {\n        self.draw() % 2 == 1\n    }\n\n    // The size this case may grow to (it grows with the case number).\n    pub fn size(inout self) -> i64 {\n        self.size\n    }\n\n    // A text byte: letters and digits first, then spaces, punctuation,\n    // newlines and the rest.\n    pub fn text_byte(inout self) -> u8 {\n        let c = self.draw();\n        let common = \"abcdefghijklmnopqrstuvwxyz0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ\\n.,-_:;()+*/=\";\n        if c < 200 {\n            return common[(c % common.len as u64) as i64];\n        }\n        (c % 256) as u8\n    }\n}\n\n// x's `{:?}` text against tests/snapshots/MODULE__TEST__N.snap: a missing\n// file is written (a new snapshot, the test passes), a different one\n// fails with its first differing line; `tachyonc test --accept` writes\n// the current text.\npub fn assert_snapshot<T: Debug>(x: sink T) {\n    let gpa = Gpa {};\n    TEST_SNAP_COUNT += 1;\n    var text = format_in(f\"{x:?}\", gpa);\n    text.push('\\n');\n    var path = Buf::new_in(gpa);\n    var shown = Buf::new_in(gpa);\n    if TEST_SNAPSHOTS != 0 as *u8 {\n        unsafe { path.push_cstr(TEST_SNAPSHOTS) };\n        path.push('/');\n    } else {\n        path.push_str(\"tests/\");\n    }\n    shown.push_str(\"tests/\");\n    path.push_str(\"snapshots\");\n    // (the tests directory, then its snapshots/)\n    var dir = Buf::new_in(gpa);\n    let at = path.len() - 10;\n    dir.push_str(path.as_slice()[0..at]);\n    dir.push(0);\n");
        buf_str(out, c"    unsafe { mkdir(dir.as_slice().ptr, 493) };\n    dir.clear();\n    dir.push_str(path.as_slice());\n    dir.push(0);\n    unsafe { mkdir(dir.as_slice().ptr, 493) };\n    dir.free();\n    var file = Buf::new_in(gpa);\n    file.push_str(\"/\");\n    let module = TEST_MODULE;\n    var i = 0;\n    while i < module.len {\n        if module[i] == ':' {\n            file.push_str(\"__\");\n            i += 2;\n        } else {\n            file.push(module[i]);\n            i += 1;\n        }\n    }\n    if module.len > 0 {\n        file.push_str(\"__\");\n    }\n    file.push_str(TEST_NAME);\n    file.push_str(\"__\");\n    file.push_int(TEST_SNAP_COUNT);\n    file.push_str(\".snap\");\n    path.push_str(file.as_slice());\n    shown.push_str(\"snapshots\");\n    shown.push_str(file.as_slice());\n    path.push(0);\n    let cpath = path.as_slice().ptr;\n    var old = Buf::new_in(gpa);\n    let had = unsafe { test_read_file(cpath, &old) };\n    if had && old.as_slice() == text.as_slice() {\n    } else if !had || TEST_ACCEPT {\n        if !unsafe { test_write_file(cpath, text.as_slice()) } {\n            eprintln(f\"snapshot {shown.as_slice()}: cannot write {path.as_slice()}\");\n            unsafe { exit(101) };\n        }\n        println(\n            f\"tachyon-test: snapshot {if had { \"accepted\" } else { \"new\" }} {shown.as_slice()}\");\n    } else {\n        var k = 0;\n        while test_line(old.as_slice(), k) == test_line(text.as_slice(), k) {\n            k += 1;\n        }\n        eprintln(\n            f\"snapshot differs: {shown.as_slice()} line {k + 1}: '{test_line(old.as_slice(), k)}' expected, got '{test_line(text.as_slice(), k)}'\");\n        unsafe { exit(101) };\n    }\n    text.free();\n    path.free();\n    shown.free();\n    file.free();\n    old.free();\n}\n\n// ---- The test runtime's implementation (0.18) ----\n\n// A test build's main (front/tests makes it) runs one test: a #[test]\n");
        buf_str(out, c"// in the process, a property's cases each in a child process; the\n// generators of the types a property takes; snapshots' files.\n\nextern \"C\" {\n    #[effects(io)]\n    fn fork() -> i32;\n    #[effects(io)]\n    fn waitpid(pid: i32, status: *i32, options: i32) -> i32;\n    #[effects(io)]\n    fn pipe(fds: *i32) -> i32;\n    #[effects(io)]\n    fn dup2(from: i32, to: i32) -> i32;\n    #[effects(io)]\n    fn close(fd: i32) -> i32;\n    #[effects(io)]\n    fn open(path: *u8, flags: i32) -> i32;\n    #[effects(io)]\n    fn creat(path: *u8, mode: u32) -> i32;\n    #[effects(io)]\n    fn mkdir(path: *u8, mode: u32) -> i32;\n    #[link_name = \"atexit\"]\n    #[effects(io)]\n    fn test_atexit(f: extern \"C\" fn()) -> i32;\n    #[link_name = \"_exit\"]\n    #[effects(io, diverge)]\n    fn test_exit_now(code: i32) -> !;\n}\n\nimpl Gen {\n    // The next choice: 0 past the end of the sequence (the simplest).\n    pub fn draw(inout self) -> u64 {\n        let k = self.at;\n        self.at += 1;\n        if k >= self.count {\n            return 0;\n        }\n        unsafe { self.choices[k] }\n    }\n\n    // Whether a collection of `len` elements gets one more.\n    pub fn more(inout self, len: i64) -> bool {\n        if len >= self.size || self.depth > 4 {\n            return false;\n        }\n        self.draw() % 4 != 0\n    }\n\n    // How deep a recursive type's generator is.\n    pub fn depth(inout self) -> i64 {\n        self.depth\n    }\n\n    // The allocator generated containers use.\n    pub fn gpa(inout self) -> Gpa {\n        self.gpa\n    }\n\n    // Whether this run is the replay of a failure (its inputs printed).\n    pub fn showing(inout self) -> bool {\n        self.showing\n    }\n\n    // The choices used so far, told to the runner (the generators are\n    // done; the property runs next).\n    pub fn generated(inout self) {\n        if self.report >= 0 {\n            var used = self.at;\n            unsafe { write(self.report, &used as *u8, 8) };\n");
        buf_str(out, c"            unsafe { close(self.report) };\n            self.report = -1;\n        }\n    }\n\n    // A recursive type's generator goes one level down (shallower values\n    // past a depth).\n    pub fn enter(inout self) {\n        self.depth += 1;\n    }\n\n    pub fn leave(inout self) {\n        self.depth -= 1;\n    }\n}\n\n// The generator of T: its `impl Arbitrary` (std's for the numbers and\n// bool, the compiler's for a test's structs and enums).\npub fn arbitrary_of<T: Arbitrary>(g: inout Gen) -> T {\n    T::arbitrary(&g)\n}\n\npub fn gen_vec<T, F: Fn(inout Gen) -> T>(g: inout Gen, f: F) -> Vec<T> {\n    var v: Vec<T> = Vec::new_in(g.gpa);\n    g.enter();\n    while g.more(v.len()) {\n        v.push(f(&g));\n    }\n    g.leave();\n    v\n}\n\npub fn gen_option<T, F: Fn(inout Gen) -> T>(g: inout Gen, f: F) -> Option<T> {\n    if g.draw() % 2 == 0 { Option::None } else { Option::Some(f(&g)) }\n}\n\npub fn gen_result<T, E, F: Fn(inout Gen) -> T,\n    G: Fn(inout Gen) -> E>(g: inout Gen, f: F, e: G) -> Result<T, E> {\n    if g.draw() % 2 == 0 { Result::Ok(f(&g)) } else { Result::Err(e(&g)) }\n}\n\npub fn gen_text(g: inout Gen) -> Vec<u8> {\n    var v: Vec<u8> = Vec::new_in(g.gpa);\n    while g.more(v.len()) {\n        v.push(g.text_byte());\n    }\n    v\n}\n\npub fn gen_buf(g: inout Gen) -> Buf {\n    var b = Buf::new_in(g.gpa);\n    while g.more(b.len()) {\n        b.push(g.text_byte());\n    }\n    b\n}\n\npub fn gen_f64(g: inout Gen) -> f64 {\n    let c = g.draw();\n    if c < 6 {\n        let edges = [0.0, 1.0, -1.0, -0.0, 1.0 / 0.0, -1.0 / 0.0];\n        return edges[c as i64];\n    }\n    let n = ((c >> 1) as i64) ^ -((c & 1) as i64);\n    (n as f64) / 8.0\n}\n\nimpl Arbitrary for i64 {\n    fn arbitrary(g: inout Gen) -> i64 { g.int() }\n}\n\nimpl Arbitrary for i32 {\n    fn arbitrary(g: inout Gen) -> i32 { g.int() as i32 }\n}\n\nimpl Arbitrary for i16 {\n    fn arbitrary(g: inout Gen) -> i16 { g.int() as i16 }\n}\n\nimpl Arbitrary for i8 {\n");
        buf_str(out, c"    fn arbitrary(g: inout Gen) -> i8 { g.int() as i8 }\n}\n\nimpl Arbitrary for u64 {\n    fn arbitrary(g: inout Gen) -> u64 { g.draw() }\n}\n\nimpl Arbitrary for u32 {\n    fn arbitrary(g: inout Gen) -> u32 { g.draw() as u32 }\n}\n\nimpl Arbitrary for u16 {\n    fn arbitrary(g: inout Gen) -> u16 { g.draw() as u16 }\n}\n\nimpl Arbitrary for u8 {\n    fn arbitrary(g: inout Gen) -> u8 { g.draw() as u8 }\n}\n\nimpl Arbitrary for bool {\n    fn arbitrary(g: inout Gen) -> bool { g.bool() }\n}\n\nimpl Arbitrary for f64 {\n    fn arbitrary(g: inout Gen) -> f64 { gen_f64(&g) }\n}\n\n// What `tachyonc test` passes to a test binary: `--tachyon-test NAME`\n// (else `--tachyon-list`), `--cases N`, `--seed S`, `--snapshots DIR`,\n// `--accept`.\nstatic var TEST_CASES: i64 = 100;\nstatic var TEST_SEED: u64 = 0;\nstatic var TEST_SEED_SET: bool = false;\nstatic var TEST_SNAPSHOTS: *u8 = 0 as *u8;\nstatic var TEST_ACCEPT: bool = false;\nstatic var TEST_MODULE: [u8] = \"\";\nstatic var TEST_NAME: [u8] = \"\";\nstatic var TEST_SNAP_COUNT: i64 = 0;\n// (fuzzing, std/fuzz.tach) `--fuzz-time S`, `--fuzz-dir DIR`, `--replay\n// FILE` (repeated); whether the choices are an input's bytes.\nstatic var TEST_FUZZ_TIME: i64 = 0;\nstatic var TEST_FUZZ_DIR: *u8 = 0 as *u8;\nstatic var TEST_REPLAY: [*u8; 256] = [0 as *u8; 256];\nstatic var TEST_REPLAYS: i64 = 0;\nstatic var TEST_RAW: bool = false;\n\n// The exit status of a property case whose `requires` failed (discarded).\nconst TEST_DISCARD: i32 = 77;\n\nunsafe fn test_arg(p: *u8) -> [u8] {\n    p[0..strlen(p) as i64]\n}\n\nfn test_number(s: [u8]) -> u64 {\n    var n: u64 = 0;\n    var i = 0;\n    var base: u64 = 10;\n    if s.len > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X') {\n        base = 16;\n        i = 2;\n    }\n    while i < s.len {\n        let c = s[i];\n        let d = if c >= '0' && c <= '9' { (c - '0') as u64 }\n            else if c >= 'a' && c <= 'f' { (c - 'a') as u64 + 10 }\n");
        buf_str(out, c"            else if c >= 'A' && c <= 'F' { (c - 'A') as u64 + 10 }\n            else { 99 };\n        if d >= base {\n            break;\n        }\n        n = n * base + d;\n        i += 1;\n    }\n    n\n}\n\n// A test binary's arguments: the test to run (empty: list them).\npub fn test_args(argc: i32, argv: **u8) -> [u8] {\n    var name: [u8] = \"\";\n    var i = 1;\n    while i < argc as i64 {\n        let a = unsafe { test_arg(argv[i]) };\n        let has_value = i + 1 < argc as i64;\n        if a == \"--tachyon-test\" && has_value {\n            name = unsafe { test_arg(argv[i + 1]) };\n            i += 1;\n        } else if a == \"--cases\" && has_value {\n            TEST_CASES = test_number(unsafe { test_arg(argv[i + 1]) }) as i64;\n            i += 1;\n        } else if a == \"--seed\" && has_value {\n            TEST_SEED = test_number(unsafe { test_arg(argv[i + 1]) });\n            TEST_SEED_SET = true;\n            i += 1;\n        } else if a == \"--snapshots\" && has_value {\n            TEST_SNAPSHOTS = unsafe { argv[i + 1] };\n            i += 1;\n        } else if a == \"--accept\" {\n            TEST_ACCEPT = true;\n        } else if a == \"--fuzz-time\" && has_value {\n            TEST_FUZZ_TIME = test_number(unsafe { test_arg(argv[i + 1]) }) as i64;\n            i += 1;\n        } else if a == \"--fuzz-dir\" && has_value {\n            TEST_FUZZ_DIR = unsafe { argv[i + 1] };\n            i += 1;\n        } else if a == \"--replay\" && has_value {\n            if TEST_REPLAYS < 256 {\n                TEST_REPLAY[TEST_REPLAYS] = unsafe { argv[i + 1] };\n                TEST_REPLAYS += 1;\n            }\n            i += 1;\n        }\n        i += 1;\n    }\n    name\n}\n\n// A test of module `module` (its path, `a::tests`) starts.\npub fn test_begin(module: [u8], name: [u8], gpa: Gpa) {\n    TEST_MODULE = module;\n    TEST_NAME = name;\n    TEST_SNAP_COUNT = 0;\n    // (an allocation first: --check-alloc's handler at exit is then\n");
        buf_str(out, c"    // registered before test_at_exit, which runs before it)\n    var first: Vec<u8> = Vec::new_in(gpa);\n    first.push(0);\n    first.free();\n    test_running();\n}\n\n// A test that ends the process (a failed check) ends it at once: the\n// leaks it leaves are not listed after its failure (exit 101).\nstatic var TEST_RUNNING: bool = false;\nstatic var TEST_HANDLER: bool = false;\n\nstatic var TEST_EXIT_CODE: i32 = 101;\n\nextern \"C\" fn test_at_exit() {\n    if TEST_RUNNING {\n        unsafe { test_exit_now(TEST_EXIT_CODE) };\n    }\n}\n\n// This process ends with `code`, before --check-alloc lists what it\n// leaves allocated (a runner's, not the test's).\nfn test_exit(code: i32) -> ! {\n    test_running();\n    TEST_EXIT_CODE = code;\n    unsafe { exit(code) }\n}\n\nfn test_running() {\n    if !TEST_HANDLER {\n        unsafe { test_atexit(test_at_exit) };\n        TEST_HANDLER = true;\n    }\n    TEST_RUNNING = true;\n}\n\n// A #[test] returned.\npub fn test_done() {\n    TEST_RUNNING = false;\n}\n\n// A test left blocks allocated (with --check-alloc, which test builds\n// use; they are listed): it fails.\npub fn test_leaked() -> ! {\n    unsafe { exit(101) }\n}\n\n// A `#[test]` that returned Err(e): the error, exit 101.\npub fn test_err<E: Debug>(e: sink E) -> ! {\n    eprintln(f\"test returned Err({e:?})\");\n    unsafe { exit(101) }\n}\n\npub fn test_unknown(name: [u8]) -> i32 {\n    eprintln(f\"no test '{name}' in this program (--tachyon-list lists them)\");\n    2\n}\n\n// A property case whose `requires` does not hold: not a failure.\npub fn test_discard() -> ! {\n    unsafe { test_exit_now(TEST_DISCARD) }\n}\n\n// The line that begins an input's value, when a failure is replayed.\npub fn test_input(name: [u8]) {\n    print(f\"tachyon-test: input {name} = \");\n}\n\npub fn test_input_end() {\n    println(\"\");\n}\n\n// The choices of a case (splitmix64 from the state): mostly small, some\n// edges, some anything.\n");
        buf_str(out, c"fn test_next(state: inout u64) -> u64 {\n    state = state + 0x9e3779b97f4a7c15;\n    var z = state;\n    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9;\n    z = (z ^ (z >> 27)) * 0x94d049bb133111eb;\n    z ^ (z >> 31)\n}\n\nfn test_choice(state: inout u64, size: i64) -> u64 {\n    let r = test_next(&state);\n    let pick = r % 20;\n    if pick == 0 {\n        // (the edges: i64::MIN, i64::MAX, u64::MAX, a byte's)\n        let e = test_next(&state) % 5;\n        return if e == 0 { 0xffffffffffffffff } else if e == 1 { 0xfffffffffffffffe }\n            else if e == 2 { 255 } else if e == 3 { 256 } else { 0x8000000000000000 };\n    }\n    if pick < 3 {\n        return test_next(&state);\n    }\n    test_next(&state) % (2 * size as u64 + 4)\n}\n\nfn test_seed_of(name: [u8]) -> u64 {\n    if TEST_SEED_SET {\n        return TEST_SEED;\n    }\n    var h: u64 = 14695981039346656037;\n    for i in 0..name.len {\n        h = (h ^ name[i] as u64) * 1099511628211;\n    }\n    h\n}\n\nstruct CaseRun { status: i32, used: i64 }\n\n// Runs one case in a child process: its exit status (0 passed,\n// TEST_DISCARD discarded, else failed) and the choices it used.\nfn test_case<F: Fn(inout Gen)>(f: F, gpa: Gpa, choices: Vec<u64>, size: i64, quiet: bool) -> CaseRun {\n    var fds = [0 as i32, 0 as i32];\n    if unsafe { pipe(&fds[0]) } != 0 {\n        eprintln(\"tachyon-test: cannot make a pipe\");\n        unsafe { exit(2) };\n    }\n    let pid = unsafe { fork() };\n    if pid == 0 {\n        unsafe { close(fds[0]) };\n        if quiet {\n            let null = unsafe { open(c\"/dev/null\", 1) };\n            unsafe { dup2(null, 1) };\n            unsafe { dup2(null, 2) };\n        }\n        test_running();\n        let s = choices.as_slice();\n        var g = Gen {\n            choices: s.ptr, count: s.len, at: 0, size: size, gpa: gpa, depth: 0,\n            showing: !quiet, report: fds[1], raw: TEST_RAW,\n        };\n");
        buf_str(out, c"        // (0.18 with 0.17's drops: the case's values are dropped by now, so\n        // a block it allocated and left is a leak; --check-alloc)\n        let mark = check_alloc_mark();\n        f(&g);\n        if check_alloc_leaks_since(mark) > 0 {\n            unsafe { test_exit_now(101) };\n        }\n        unsafe { test_exit_now(0) };\n    }\n    unsafe { close(fds[1]) };\n    var used: i64 = -1;\n    let n = unsafe { read(fds[0], &used as *u8, 8) };\n    unsafe { close(fds[0]) };\n    var status = 0 as i32;\n    unsafe { waitpid(pid, &status, 0) };\n    let s = status as i64;\n    let code = if (s & 127) == 0 { ((s >> 8) & 255) as i32 } else { 128 + (s & 127) as i32 };\n    CaseRun { status: code, used: if n == 8 && used >= 0 { used } else { choices.len() } }\n}\n\nfn test_fails(r: CaseRun) -> bool {\n    r.status != 0 && r.status != TEST_DISCARD\n}\n\n// Candidate `c` replaces `best` when it fails too (cut to what it used).\nfn test_try<F: Fn(inout Gen)>(f: F, gpa: Gpa, best: inout Vec<u64>, c: Vec<u64>, size: i64,\n    steps: inout i64) -> bool {\n    let r = test_case(f, gpa, c, size, true);\n    if !test_fails(r) {\n        return false;\n    }\n    steps = steps + 1;\n    best.clear();\n    let n = if r.used < c.len() { r.used } else { c.len() };\n    for i in 0..n {\n        best.push(c.get(i));\n    }\n    true\n}\n\n// The failing choices `best` made smaller: chunks deleted, choices set to\n// zero, halved, lowered by one, neighbours put in order; to a fixpoint (or\n// 2000 candidates).\nfn test_shrink<F: Fn(inout Gen)>(f: F, gpa: Gpa, best: inout Vec<u64>, size: i64) -> i64 {\n    var steps = 0;\n    var tries = 0;\n    var c: Vec<u64> = Vec::new_in(gpa);\n    var changed = true;\n    while changed && tries < 2000 {\n        changed = false;\n        for k in [8, 4, 2, 1] {\n            var i = best.len() - k;\n            while i >= 0 && tries < 2000 {\n                c.clear();\n                for j in 0..best.len() {\n");
        buf_str(out, c"                    if j < i || j >= i + k {\n                        c.push(best.get(j));\n                    }\n                }\n                tries += 1;\n                if test_try(f, gpa, &best, c, size, &steps) {\n                    changed = true;\n                }\n                i -= 1;\n                if i > best.len() - k {\n                    i = best.len() - k;\n                }\n            }\n        }\n        var i = 0;\n        while i < best.len() && tries < 2000 {\n            // lowered: to 0, else the smallest that still fails, by halves\n            var lo: u64 = 0;\n            var first = true;\n            while i < best.len() && best.get(i) > lo && tries < 2000 {\n                let v = best.get(i);\n                let w = if first { 0 } else { lo + (v - lo) / 2 };\n                first = false;\n                c.clear();\n                for j in 0..best.len() {\n                    c.push(if j == i { w } else { best.get(j) });\n                }\n                tries += 1;\n                if test_try(f, gpa, &best, c, size, &steps) {\n                    changed = true;\n                } else if w == lo {\n                    lo = w + 1;\n                } else {\n                    lo = w;\n                }\n            }\n            if i + 1 < best.len() && best.get(i) > best.get(i + 1) {\n                c.clear();\n                for j in 0..best.len() {\n                    c.push(if j == i { best.get(i + 1) } else if j == i + 1 { best.get(i) }\n                        else { best.get(j) });\n                }\n                tries += 1;\n                if test_try(f, gpa, &best, c, size, &steps) {\n                    changed = true;\n                }\n            }\n            i += 1;\n        }\n    }\n    c.free();\n    steps\n}\n\n// A property: TEST_CASES cases (the first all zeros: the simplest\n// values), each in a child process; the first failure is shrunk, then\n");
        buf_str(out, c"// replayed with its inputs printed; exit 1. `tachyon-test:` lines on\n// stdout tell `tachyonc test` the case and the steps.\npub fn run_property<F: Fn(inout Gen)>(gpa: Gpa, name: [u8], f: F) {\n    // (the cases run in children; this process ends normally)\n    test_done();\n    let seed = test_seed_of(name);\n    let cases = if TEST_CASES > 0 { TEST_CASES } else { 1 };\n    var state = seed;\n    var choices: Vec<u64> = Vec::new_in(gpa);\n    var discarded = 0;\n    for case in 0..cases {\n        // (sizes grow over 100 cases, whatever --cases: -O0 runs the first\n        // 20 of -O2's)\n        let size = 1 + (if case < 100 { case } else { 99 }) * 30 / 100;\n        choices.clear();\n        if case > 0 {\n            for _ in 0..512 {\n                choices.push(test_choice(&state, size));\n            }\n        }\n        let r = test_case(f, gpa, choices, size, true);\n        if r.status == TEST_DISCARD {\n            discarded += 1;\n            continue;\n        }\n        if r.status != 0 {\n            choices.truncate(if r.used < choices.len() { r.used } else { choices.len() });\n            let steps = test_shrink(f, gpa, &choices, size);\n            println(\n                f\"tachyon-test: property case {case + 1} of {cases}, shrunk in {steps} {if steps == 1 { \"step\" } else { \"steps\" }}, seed {seed:x}\");\n            test_case(f, gpa, choices, size, false);\n            test_exit(1);\n        }\n    }\n    if discarded * 10 > cases * 9 {\n        println(f\"tachyon-test: discarded {discarded} of {cases}\");\n        eprintln(\n            f\"the generator rarely satisfies the requires: {discarded} of {cases} cases discarded (write an impl Arbitrary for the parameter's type)\");\n        test_exit(1);\n    }\n    choices.free();\n}\n\n// (snapshots)\n\nunsafe fn test_read_file(path: *u8, b: *Buf) -> bool {\n    let fd = open(path, 0);\n    if fd < 0 {\n        return false;\n    }\n    var chunk = [0 as u8; 4096];\n    loop {\n");
        buf_str(out, c"        let n = unsafe { read(fd, &chunk[0], 4096) };\n        if n <= 0 {\n            break;\n        }\n        b.push_str(chunk[0..n]);\n    }\n    unsafe { close(fd) };\n    true\n}\n\nunsafe fn test_write_file(path: *u8, text: [u8]) -> bool {\n    let fd = creat(path, 420);\n    if fd < 0 {\n        return false;\n    }\n    unsafe { write(fd, text.ptr, text.len as u64) };\n    unsafe { close(fd) };\n    true\n}\n\n// The line `k` (from 0) of s, and whether there is one.\nfn test_line(s: [u8], k: i64) -> [u8] {\n    var at = 0;\n    var line = 0;\n    while at <= s.len {\n        var e = at;\n        while e < s.len && s[e] != '\\n' {\n            e += 1;\n        }\n        if line == k {\n            return s[at..e];\n        }\n        line += 1;\n        at = e + 1;\n    }\n    \"\"\n}\n// ---- Non-null pointers (0.18) ----\n\n// A pointer that is never null (docs/design/contracts-verification.md\n// §2.11): a distinct type over `*T`. `p as *T` converts for free; `q as\n// NonNull<T>` checks q, a null q a run-time failure (exit 101), so that\n// the niche never reads `Some(q)` as None; NonNull::new is the\n// conversion that may fail. A C function's `_Nonnull` result is the C\n// side's promise: calling C is unsafe, and the caller vouches for it. `Option<NonNull<T>>`\n// is one pointer, None the null one, as C's nullable pointers are (the\n// null niche, front/distinct.tach); an `extern \"C\"` signature may take\n// either. Dereferencing stays unsafe, as for any raw pointer: NonNull is\n// for pointers that are stored (the fields of unsafe data structures) and\n// for C. `*T` has `is_null()`.\npub type NonNull<T> = distinct *T invariant self as u64 != 0 else \"null pointer made NonNull\";\n\nimpl<T> NonNull<T> {\n    // p, unless it is null (`mut`: a raw pointer, which may be null, not\n    // a borrow).\n    pub fn new(p: sink *T) -> Option<NonNull<T>> {\n        if p as u64 == 0 { Option::None } else { Option::Some(p as NonNull<T>) }\n    }\n\n");
        buf_str(out, c"    // The pointer, as a raw one.\n    pub fn as_ptr(sink self) -> *T {\n        self as *T\n    }\n}\n// ---- The fuzzer's implementation (0.18) ----\n\n// `#[fuzz]` functions (docs/design/contracts-verification.md §2.8, 0.18\n// T3): a property whose choice sequence is an input's bytes, one choice\n// per byte. `tachyonc fuzz NAME` runs it on inputs it mutates and keeps\n// those that reach new code (--coverage's counters, below); `tachyonc\n// test` runs it as a property and on its saved inputs. A `[u8]`\n// parameter is the input itself (gen_bytes).\n\n// Coverage counters (T3, --coverage): the compiler (middle/coverage.tach)\n// makes each block of the program count in COVERAGE_MAP as it runs.\npub static var COVERAGE_MAP: [u8; 65536] = [0; 65536];\n\n// The counters (all zero in a program built without --coverage).\npub fn coverage() -> [u8] {\n    COVERAGE_MAP[0..65536]\n}\n\npub fn coverage_reset() {\n    for i in 0..65536 {\n        COVERAGE_MAP[i] = 0;\n    }\n}\n\nextern \"C\" {\n    #[link_name = \"time\"]\n    #[effects(io)]\n    fn fuzz_time(t: *i64) -> i64;\n}\n\n// An input's bytes: all of them when the choices are an input's\n// (fuzzing, a saved input), else a generated text of bytes.\npub fn gen_bytes(g: inout Gen) -> Vec<u8> {\n    var v: Vec<u8> = Vec::new_in(g.gpa);\n    if g.raw {\n        while g.at < g.count {\n            v.push(g.draw() as u8);\n        }\n        return v;\n    }\n    while g.more(v.len()) {\n        v.push(g.draw() as u8);\n    }\n    v\n}\n\n// A run of one input in a child process: its status, the choices it used,\n// and (when it returned) its coverage, into `cov`.\nfn fuzz_exec<F: Fn(inout Gen)>(f: F, gpa: Gpa, input: Vec<u64>, cov: [u8]) -> CaseRun {\n    var fds = [0 as i32, 0 as i32];\n    var cfds = [0 as i32, 0 as i32];\n    if unsafe { pipe(&fds[0]) } != 0 || unsafe { pipe(&cfds[0]) } != 0 {\n        eprintln(\"tachyon-test: cannot make a pipe\");\n        unsafe { exit(2) };\n    }\n");
        buf_str(out, c"    let pid = unsafe { fork() };\n    if pid == 0 {\n        unsafe { close(fds[0]) };\n        unsafe { close(cfds[0]) };\n        let null = unsafe { open(c\"/dev/null\", 1) };\n        unsafe { dup2(null, 1) };\n        unsafe { dup2(null, 2) };\n        test_running();\n        coverage_reset();\n        let s = input.as_slice();\n        var g = Gen {\n            choices: s.ptr, count: s.len, at: 0, size: 64, gpa: gpa, depth: 0, showing: false,\n            report: fds[1], raw: true,\n        };\n        // (0.18 with 0.17's drops: the case's values are dropped by now, so\n        // a block it allocated and left is a leak; --check-alloc)\n        let mark = check_alloc_mark();\n        f(&g);\n        if check_alloc_leaks_since(mark) > 0 {\n            unsafe { test_exit_now(101) };\n        }\n        unsafe { write(cfds[1], &COVERAGE_MAP[0], 65536) };\n        unsafe { test_exit_now(0) };\n    }\n    unsafe { close(fds[1]) };\n    unsafe { close(cfds[1]) };\n    var used: i64 = -1;\n    let n = unsafe { read(fds[0], &used as *u8, 8) };\n    unsafe { close(fds[0]) };\n    var got = 0;\n    for i in 0..65536 {\n        cov[i] = 0;\n    }\n    loop {\n        let k = unsafe { read(cfds[0], &cov[got], (65536 - got) as u64) };\n        if k <= 0 {\n            break;\n        }\n        got += k;\n        if got >= 65536 {\n            break;\n        }\n    }\n    unsafe { close(cfds[0]) };\n    var status = 0 as i32;\n    unsafe { waitpid(pid, &status, 0) };\n    let st = status as i64;\n    let code = if (st & 127) == 0 { ((st >> 8) & 255) as i32 } else { 128 + (st & 127) as i32 };\n    CaseRun { status: code, used: if n == 8 && used >= 0 { used } else { input.len() } }\n}\n\n// AFL's buckets of a count: 1, 2, 3, 4-7, 8-15, 16-31, 32-127, 128-255.\nfn fuzz_bucket(c: u8) -> u8 {\n    if c == 0 { 0 } else if c == 1 { 1 } else if c == 2 { 2 } else if c == 3 { 4 }\n    else if c < 8 { 8 } else if c < 16 { 16 } else if c < 32 { 32 } else if c < 128 { 64 }\n");
        buf_str(out, c"    else { 128 }\n}\n\n// Whether `cov` reaches a block (or a block's count) `seen` has not seen;\n// `seen` takes it in.\nfn fuzz_new_coverage(cov: [u8], seen: [u8]) -> bool {\n    var new = false;\n    for i in 0..65536 {\n        let c = cov[i];\n        if c != 0 {\n            let b = fuzz_bucket(c);\n            if (b & ~seen[i]) != 0 {\n                seen[i] = seen[i] | b;\n                new = true;\n            }\n        }\n    }\n    new\n}\n\n// The program's text constants a mutation may put in an input (the\n// compiler gives them, front/tests).\nstatic var FUZZ_WORDS: [[u8]; 64] = [\"\"; 64];\nstatic var FUZZ_WORD_COUNT: i64 = 0;\n\npub fn fuzz_word(w: [u8]) {\n    if FUZZ_WORD_COUNT < 64 && w.len > 0 && w.len <= 32 {\n        FUZZ_WORDS[FUZZ_WORD_COUNT] = w;\n        FUZZ_WORD_COUNT += 1;\n    }\n}\n\n// One mutation of `v` (bytes as choices), from the random state; `other`\n// is another input of the corpus (for a splice).\nfn fuzz_mutate(v: inout Vec<u64>, other: Vec<u64>, state: inout u64) {\n    let len = v.len();\n    let r = test_next(&state);\n    let how = r % 10;\n    let at = if len > 0 { ((r >> 8) % len as u64) as i64 } else { 0 };\n    if len == 0 || how == 0 {\n        // a byte inserted\n        let b = test_next(&state) % 256;\n        if len >= 4096 {\n            return;\n        }\n        &v.insert(if len > 0 { at } else { 0 }, b);\n    } else if how == 1 {\n        // a bit flipped\n        &v.set(at, v.get(at) ^ (1 << (test_next(&state) % 8)));\n    } else if how == 2 {\n        let interesting: [u64; 10] = [0, 1, 0x7f, 0x80, 0xff, 48, 97, 32, 10, 255];\n        &v.set(at, interesting[(test_next(&state) % 10) as i64]);\n    } else if how == 3 {\n        &v.set(at, test_next(&state) % 256);\n    } else if how == 4 {\n        // a run deleted\n        let n = 1 + (test_next(&state) % 4) as i64;\n        var k = 0;\n        while k < n && at < v.len() {\n            &v.remove(at);\n            k += 1;\n        }\n");
        buf_str(out, c"    } else if how == 5 {\n        // a byte changed by a little\n        let d = test_next(&state) % 16;\n        &v.set(at, (v.get(at) + d + 240) % 256);\n    } else if how == 6 && other.len() > 0 {\n        // a splice: this input's start, the other's end\n        let cut = (test_next(&state) % other.len() as u64) as i64;\n        v.truncate(at);\n        for i in cut..other.len() {\n            if v.len() < 4096 {\n                v.push(other.get(i));\n            }\n        }\n    } else if how == 7 && FUZZ_WORD_COUNT > 0 {\n        // a text constant of the program\n        let w = FUZZ_WORDS[(test_next(&state) % FUZZ_WORD_COUNT as u64) as i64];\n        for i in 0..w.len {\n            if v.len() < 4096 {\n                &v.insert(at + i, w[i] as u64);\n            }\n        }\n    } else if how == 8 && len < 4096 {\n        // a run repeated\n        let n = 1 + (test_next(&state) % 8) as i64;\n        var k = 0;\n        while k < n && at + k < len && v.len() < 4096 {\n            let to = if at + n + k < v.len() { at + n + k } else { v.len() };\n            &v.insert(to, v.get(at + k));\n            k += 1;\n        }\n    } else {\n        &v.set(at, test_next(&state) % 256);\n    }\n}\n\nfn fuzz_hash(v: Vec<u64>) -> u64 {\n    var h: u64 = 14695981039346656037;\n    for i in 0..v.len() {\n        h = (h ^ v.get(i)) * 1099511628211;\n    }\n    h\n}\n\n// Input v saved as DIR/PREFIXHASH (bytes): its path.\nfn fuzz_save(gpa: Gpa, v: Vec<u64>, prefix: [u8]) -> Buf {\n    var path = Buf::new_in(gpa);\n    if TEST_FUZZ_DIR != 0 as *u8 {\n        unsafe { path.push_cstr(TEST_FUZZ_DIR) };\n        path.push('/');\n    }\n    path.push_str(prefix);\n    let h = fuzz_hash(v);\n    let digits = \"0123456789abcdef\";\n    for k in 0..16 {\n        path.push(digits[((h >> (60 - 4 * k as u64)) & 15) as i64]);\n    }\n    var bytes = Buf::new_in(gpa);\n    for i in 0..v.len() {\n        bytes.push(v.get(i) as u8);\n    }\n    var c = Buf::new_in(gpa);\n");
        buf_str(out, c"    c.push_str(path.as_slice());\n    c.push(0);\n    unsafe { test_write_file(c.as_slice().ptr, bytes.as_slice()) };\n    c.free();\n    bytes.free();\n    path\n}\n\nunsafe fn fuzz_load(gpa: Gpa, path: *u8, into: *Vec<u64>) -> bool {\n    var b = Buf::new_in(gpa);\n    let ok = test_read_file(path, &b);\n    into.clear();\n    let s = b.as_slice();\n    for i in 0..s.len {\n        into.push(s[i] as u64);\n    }\n    b.free();\n    ok\n}\n\n// A failing input: shrunk, saved, replayed with its inputs printed; exit 1.\nfn fuzz_failed<F: Fn(inout Gen)>(f: F, gpa: Gpa, input: inout Vec<u64>, runs: i64) -> ! {\n    TEST_RAW = true;\n    let steps = test_shrink(f, gpa, &input, 64);\n    let path = fuzz_save(gpa, input, \"crash-\");\n    println(\n        f\"tachyon-test: property after {runs} runs, shrunk in {steps} {if steps == 1 { \"step\" } else { \"steps\" }}\");\n    println(f\"tachyon-test: saved {path.as_slice()}\");\n    test_case(f, gpa, input, 64, false);\n    test_exit(1)\n}\n\n// A fuzz target: fuzzed for --fuzz-time seconds (tachyonc fuzz), else run\n// on its saved inputs (--replay), then as a property.\npub fn run_fuzz_target<F: Fn(inout Gen)>(gpa: Gpa, name: [u8], f: F) {\n    test_done();\n    var input: Vec<u64> = Vec::new_in(gpa);\n    if TEST_FUZZ_TIME <= 0 {\n        TEST_RAW = true;\n        for k in 0..TEST_REPLAYS {\n            if !unsafe { fuzz_load(gpa, TEST_REPLAY[k], &input) } {\n                continue;\n            }\n            let r = test_case(f, gpa, input, 64, true);\n            if test_fails(r) {\n                let p = unsafe { test_arg(TEST_REPLAY[k]) };\n                println(f\"tachyon-test: property input {p}\");\n                test_case(f, gpa, input, 64, false);\n                test_exit(1);\n            }\n        }\n        TEST_RAW = false;\n        input.free();\n        run_property(gpa, name, f);\n        return;\n    }\n    // the corpus: the saved inputs, and the empty one\n");
        buf_str(out, c"    var corpus: Vec<Vec<u64>> = Vec::new_in(gpa);\n    var seen = [0 as u8; 65536];\n    var cov = [0 as u8; 65536];\n    let empty: Vec<u64> = Vec::new_in(gpa);\n    corpus.push(empty);\n    for k in 0..TEST_REPLAYS {\n        var v: Vec<u64> = Vec::new_in(gpa);\n        if unsafe { fuzz_load(gpa, TEST_REPLAY[k], &v) } {\n            corpus.push(v);\n        }\n    }\n    var runs = 0;\n    for k in 0..corpus.len() {\n        var v = corpus.get(k);\n        let r = fuzz_exec(f, gpa, v, cov[..]);\n        runs += 1;\n        if test_fails(r) {\n            fuzz_failed(f, gpa, &v, runs);\n        }\n        fuzz_new_coverage(cov[..], seen[..]);\n    }\n    var state = test_seed_of(name);\n    let start = unsafe { fuzz_time(0 as *i64) };\n    var kept = 0;\n    var child: Vec<u64> = Vec::new_in(gpa);\n    while unsafe { fuzz_time(0 as *i64) } - start < TEST_FUZZ_TIME {\n        var parent = corpus.get((test_next(&state) % corpus.len() as u64) as i64);\n        var other = corpus.get((test_next(&state) % corpus.len() as u64) as i64);\n        child.clear();\n        for i in 0..parent.len() {\n            child.push(parent.get(i));\n        }\n        let stack = 1 + test_next(&state) % 4;\n        for _ in 0..stack {\n            fuzz_mutate(&child, other, &state);\n        }\n        let r = fuzz_exec(f, gpa, child, cov[..]);\n        runs += 1;\n        if test_fails(r) {\n            fuzz_failed(f, gpa, &child, runs);\n        }\n        if r.status == 0 && fuzz_new_coverage(cov[..], seen[..]) {\n            var keep: Vec<u64> = Vec::new_in(gpa);\n            for i in 0..child.len() {\n                keep.push(child.get(i));\n            }\n            let path = fuzz_save(gpa, keep, \"corpus-\");\n            var p = path;\n            p.free();\n            corpus.push(keep);\n            kept += 1;\n        }\n        let _ = parent.len();\n        let _ = other.len();\n    }\n");
        buf_str(out, c"    println(f\"tachyon-test: fuzz {runs} runs, {kept} inputs kept, {corpus.len()} in the corpus\");\n    test_exit(0)\n}\n// compiler/std/embed.sh appends this file to std.tach and the others\n// (0.18.1): the same module, `std`. Its sections are lazy: loaded when a\n// program names what they define.\n\n// ---- Heaps (0.18.1) ----\n\n// A priority queue, a binary heap in a Vec: `push` in O(log n), `pop`\n// takes the largest element first (Rust's BinaryHeap, a max-heap), `peek`\n// reads it. For the smallest first (Dijkstra, a timer queue) use\n// `MinHeap`, the same API: no `Reverse` wrapper. `BinaryHeap::new_in(gpa)`,\n// `with_capacity_in(n, gpa)`, `from_vec(v)`; dropped with its elements.\n#[sealed]\npub struct BinaryHeap<T: Ord, A: Allocator = Gpa> { data: Vec<T, A> }\n\n// A priority queue whose `pop` takes the smallest element first: a\n// min-heap, with BinaryHeap's API (`MinHeap::new_in(gpa)`, `push`, `pop`,\n// `peek`). Rust spells it `BinaryHeap<Reverse<T>>`.\n#[sealed]\npub struct MinHeap<T: Ord, A: Allocator = Gpa> { data: Vec<T, A> }\n\n// Which of two elements a heap keeps nearer the root: the larger\n// (BinaryHeap) or the smaller (MinHeap). Unsafe: a and b point to\n// elements.\ntrait HeapOrder { unsafe fn above<T: Ord>(a: *T, b: *T) -> bool; }\n\nstruct HeapMax {}\n\nstruct HeapMin {}\n\nimpl HeapOrder for HeapMax {\n    #[inline]\n    unsafe fn above<T: Ord>(a: *T, b: *T) -> bool {\n        *a > *b\n    }\n}\n\nimpl HeapOrder for HeapMin {\n    #[inline]\n    unsafe fn above<T: Ord>(a: *T, b: *T) -> bool {\n        *a < *b\n    }\n}\n\n// Puts x in the hole at p[pos], or nearer p[start] while it is above the\n// hole's parent: each step one move, not a swap; where it ends. (The\n// index at least halves each round: 64 rounds at most.) Unsafe: p has\n// pos + 1 elements at least; p[pos] holds nothing (its bits are x's or a\n// moved element's).\nunsafe fn heap_hole_up<T: Ord, O: HeapOrder>(p: *T, start: i64, pos: i64, x: sink T) -> i64 {\n");
        buf_str(out, c"    var i = pos;\n    for _ in 0..64 {\n        if i <= start {\n            break;\n        }\n        let parent = (i - 1) >> 1;\n        if !O::above(&x, &p[parent]) {\n            break;\n        }\n        p[i] = p[parent];\n        i = parent;\n    }\n    p[i] = x;\n    i\n}\n\n// Moves p[pos] down until no child of it, in p[..end], is above it,\n// through a hole. Unsafe: p has `end` elements.\nunsafe fn heap_sift_down<T: Ord, O: HeapOrder>(p: *T, pos: i64, end: i64) {\n    let x = p[pos];\n    var i = pos;\n    var child = 2 * i + 1;\n    for _ in 0..64 {\n        if child > end - 2 {\n            break;\n        }\n        if !O::above(&p[child], &p[child + 1]) {\n            child += 1;\n        }\n        if !O::above(&p[child], &x) {\n            p[i] = x;\n            return;\n        }\n        p[i] = p[child];\n        i = child;\n        child = 2 * i + 1;\n    }\n    if child == end - 1 && O::above(&p[child], &x) {\n        p[i] = p[child];\n        i = child;\n    }\n    p[i] = x;\n}\n\n// `pop`'s sift: x, for the hole at the root, goes down to a leaf along\n// the path of the children above their siblings (one comparison a level),\n// then up to its place: fewer comparisons than heap_sift_down, as x, the\n// last leaf, usually belongs near the bottom. Unsafe: p has `end`\n// elements, at least one; p[0] holds nothing.\nunsafe fn heap_hole_down_to_bottom<T: Ord, O: HeapOrder>(p: *T, end: i64, x: sink T) {\n    var i = 0;\n    var child = 1;\n    for _ in 0..64 {\n        if child > end - 2 {\n            break;\n        }\n        // (the larger child without a branch: random data mispredicts one)\n        child += (!O::above(&p[child], &p[child + 1])) as i64;\n        p[i] = p[child];\n        i = child;\n        child = 2 * i + 1;\n    }\n    if child == end - 1 {\n        p[i] = p[child];\n        i = child;\n    }\n    heap_hole_up::<T, O>(p, 0, i, x);\n}\n\n// Makes p[..n] a heap, in O(n). Unsafe: p has n elements.\n");
        buf_str(out, c"unsafe fn heap_build<T: Ord, O: HeapOrder>(p: *T, n: i64) {\n    for k in 0..n / 2 {\n        heap_sift_down::<T, O>(p, n / 2 - 1 - k, n);\n    }\n}\n\n// Adds x to the heap in v.\n#[inline]\n#[stores(x)]\nfn heap_push<T: Ord, O: HeapOrder, A: Allocator>(v: inout Vec<T, A>, x: sink T) {\n    v.reserve(1);\n    let n = v.len;\n    unsafe {\n        heap_hole_up::<T, O>(v.ptr, 0, n, x);\n    }\n    v.len = n + 1;\n}\n\n// Takes the root of the heap in v out.\n#[inline]\nfn heap_pop<T: Ord, O: HeapOrder, A: Allocator>(v: inout Vec<T, A>) -> Option<T> {\n    if v.len == 0 {\n        return None;\n    }\n    v.len -= 1;\n    unsafe {\n        let p = v.ptr;\n        let n = v.len;\n        let last = p[n];\n        if n == 0 {\n            return Some(last);\n        }\n        let top = p[0];\n        heap_hole_down_to_bottom::<T, O>(p, n, last);\n        Some(top)\n    }\n}\n\n// The heap in v sorted in place: the root's end of the order last.\nfn heap_sort_vec<T: Ord, O: HeapOrder, A: Allocator>(v: inout Vec<T, A>) {\n    unsafe {\n        let p = v.ptr;\n        let n = v.len;\n        for k in 1..n {\n            let end = n - k;\n            swap_raw::<T>(p, 0, end);\n            heap_sift_down::<T, O>(p, 0, end);\n        }\n    }\n}\n\nimpl<T: Ord, A: Allocator> BinaryHeap<T, A> {\n    // An empty heap on allocator a.\n    pub fn new_in(a: sink A) -> BinaryHeap<T, A> {\n        BinaryHeap { data: Vec::new_in(a) }\n    }\n\n    // An empty heap on allocator a with room for cap elements.\n    pub fn with_capacity_in(cap: i64, a: sink A) -> BinaryHeap<T, A> {\n        BinaryHeap { data: Vec::with_capacity_in(cap, a) }\n    }\n\n    // A heap of v's elements, in O(n), on v's memory: Rust's\n    // `BinaryHeap::from(v)`.\n    pub fn from_vec(v: sink Vec<T, A>) -> BinaryHeap<T, A> {\n        var data = v;\n        unsafe {\n            heap_build::<T, HeapMax>(data.ptr, data.len);\n        }\n        BinaryHeap { data: data }\n    }\n\n    pub fn len(self) -> i64 {\n");
        buf_str(out, c"        self.data.len\n    }\n\n    pub fn is_empty(self) -> bool {\n        self.data.len == 0\n    }\n\n    // Adds x, in O(log n).\n    #[stores(x)]\n    pub fn push(inout self, x: sink T) {\n        heap_push::<T, HeapMax, A>(&self.data, x);\n    }\n\n    // Takes the largest element out (None when empty), in O(log n).\n    pub fn pop(inout self) -> Option<T> {\n        heap_pop::<T, HeapMax, A>(&self.data)\n    }\n\n    // The largest element, which stays (`pop` takes it), as Vec's `last`.\n    pub fn peek(self) -> Option<T> {\n        if self.data.len == 0 { None } else { Some(self.data.get(0)) }\n    }\n\n    // Drops the elements; the room stays.\n    pub fn clear(inout self) {\n        self.data.clear();\n    }\n\n    pub fn capacity(self) -> i64 {\n        self.data.cap\n    }\n\n    // Room for `extra` more elements.\n    pub fn reserve(inout self, extra: i64) {\n        self.data.reserve(extra);\n    }\n\n    // Its allocator: a copy of the handle.\n    pub fn allocator(self) -> A {\n        self.data.alloc\n    }\n\n    // Its elements in heap order (the largest first, the rest in no\n    // useful order), a view.\n    #[views(self)]\n    pub fn as_slice(self) -> [T] {\n        self.data.as_slice()\n    }\n\n    // Its elements in a Vec, in heap order, on the same memory.\n    pub fn into_vec(sink self) -> Vec<T, A> {\n        self.data\n    }\n\n    // Its elements in a Vec, smallest first, on the same memory: a\n    // heapsort, in O(n log n).\n    pub fn into_sorted_vec(sink self) -> Vec<T, A> {\n        var v = self.data;\n        heap_sort_vec::<T, HeapMax, A>(&v);\n        v\n    }\n}\n\nimpl<T: Ord, A: Allocator + Ambient> BinaryHeap<T, A> {\n    #[ambient(\"BinaryHeap::new_in(gpa)\")]\n    pub fn new() -> BinaryHeap<T, A> {\n        BinaryHeap::new_in(A::ambient())\n    }\n\n    #[ambient(\"BinaryHeap::with_capacity_in(cap, gpa)\")]\n    pub fn with_capacity(cap: i64) -> BinaryHeap<T, A> {\n        BinaryHeap::with_capacity_in(cap, A::ambient())\n");
        buf_str(out, c"    }\n}\n\nimpl<T: Ord, A: Allocator> MinHeap<T, A> {\n    // An empty heap on allocator a.\n    pub fn new_in(a: sink A) -> MinHeap<T, A> {\n        MinHeap { data: Vec::new_in(a) }\n    }\n\n    // An empty heap on allocator a with room for cap elements.\n    pub fn with_capacity_in(cap: i64, a: sink A) -> MinHeap<T, A> {\n        MinHeap { data: Vec::with_capacity_in(cap, a) }\n    }\n\n    // A heap of v's elements, in O(n), on v's memory.\n    pub fn from_vec(v: sink Vec<T, A>) -> MinHeap<T, A> {\n        var data = v;\n        unsafe {\n            heap_build::<T, HeapMin>(data.ptr, data.len);\n        }\n        MinHeap { data: data }\n    }\n\n    pub fn len(self) -> i64 {\n        self.data.len\n    }\n\n    pub fn is_empty(self) -> bool {\n        self.data.len == 0\n    }\n\n    // Adds x, in O(log n).\n    #[stores(x)]\n    pub fn push(inout self, x: sink T) {\n        heap_push::<T, HeapMin, A>(&self.data, x);\n    }\n\n    // Takes the smallest element out (None when empty), in O(log n).\n    pub fn pop(inout self) -> Option<T> {\n        heap_pop::<T, HeapMin, A>(&self.data)\n    }\n\n    // The smallest element, which stays (`pop` takes it), as Vec's `last`.\n    pub fn peek(self) -> Option<T> {\n        if self.data.len == 0 { None } else { Some(self.data.get(0)) }\n    }\n\n    // Drops the elements; the room stays.\n    pub fn clear(inout self) {\n        self.data.clear();\n    }\n\n    pub fn capacity(self) -> i64 {\n        self.data.cap\n    }\n\n    // Room for `extra` more elements.\n    pub fn reserve(inout self, extra: i64) {\n        self.data.reserve(extra);\n    }\n\n    // Its allocator: a copy of the handle.\n    pub fn allocator(self) -> A {\n        self.data.alloc\n    }\n\n    // Its elements in heap order (the smallest first, the rest in no\n    // useful order), a view.\n    #[views(self)]\n    pub fn as_slice(self) -> [T] {\n        self.data.as_slice()\n    }\n\n    // Its elements in a Vec, in heap order, on the same memory.\n");
        buf_str(out, c"    pub fn into_vec(sink self) -> Vec<T, A> {\n        self.data\n    }\n\n    // Its elements in a Vec, smallest first (as BinaryHeap's), on the same\n    // memory, in O(n log n).\n    pub fn into_sorted_vec(sink self) -> Vec<T, A> {\n        var v = self.data;\n        heap_sort_vec::<T, HeapMin, A>(&v);\n        let s = v.as_mut_slice();\n        for k in 0..s.len / 2 {\n            swap_at::<T>(s, k, s.len - 1 - k);\n        }\n        v\n    }\n}\n\nimpl<T: Ord, A: Allocator + Ambient> MinHeap<T, A> {\n    #[ambient(\"MinHeap::new_in(gpa)\")]\n    pub fn new() -> MinHeap<T, A> {\n        MinHeap::new_in(A::ambient())\n    }\n\n    #[ambient(\"MinHeap::with_capacity_in(cap, gpa)\")]\n    pub fn with_capacity(cap: i64) -> MinHeap<T, A> {\n        MinHeap::with_capacity_in(cap, A::ambient())\n    }\n}\n\n// ---- More of Vec and Range (0.18.1) ----\n//\n// Vec's first, retain, contains and sort_by_key, a slice's contains,\n// Range's rev.\n\nimpl<T, A: Allocator> Vec<T, A> {\n    // The first element, if there is one (as `last`).\n    pub fn first(self) -> Option<T> {\n        if self.len == 0 { None } else { Some(self.get(0)) }\n    }\n\n    // Keeps the elements f is true of, in their order, and drops the\n    // others (Rust's `retain`): in place, O(n), f called once per element.\n    pub fn retain<F: FnMut(let T) -> bool>(inout self, f: F) {\n        var g = f;\n        let n = self.len;\n        let p = self.ptr;\n        var kept = 0;\n        unsafe {\n            for i in 0..n {\n                if g(*(&p[i])) {\n                    if kept != i {\n                        p[kept] = p[i];\n                    }\n                    kept += 1;\n                } else if needs_drop::<T>() {\n                    drop(p[i]);\n                }\n            }\n        }\n        self.len = kept;\n    }\n\n    // Sorts it in place by the key f gives each element, smallest first,\n    // keeping equal keys in their order, as Rust's `sort_by_key`:\n");
        buf_str(out, c"    // sort_stable_by_in with the Vec's own allocator for its buffer. f\n    // runs twice per comparison: make it cheap (a field, a tuple of\n    // fields).\n    pub fn sort_by_key<K: Ord, F: FnMut(let T) -> K>(inout self, f: F) {\n        var g = f;\n        let a = self.alloc;\n        sort_stable_by_in(self.as_mut_slice(), |x: T, y: T| {\n            let kx = g(x);\n            let ky = g(y);\n            cmp_of(kx, ky)\n        }, a);\n    }\n}\n\nimpl<T: Eq>[T] {\n    // Whether x is one of its elements (Rust's `s.contains(&x)`; x by\n    // value, as HashMap's keys): a linear search.\n    pub fn contains(self: [T], x: sink T) -> bool {\n        for i in 0..self.len {\n            if self[i] == x {\n                return true;\n            }\n        }\n        false\n    }\n}\n\nimpl<T: Eq, A: Allocator> Vec<T, A> {\n    // Whether x is one of its elements: `v.contains(x)`.\n    pub fn contains(self, x: sink T) -> bool {\n        self.as_slice().contains(x)\n    }\n}\n\nimpl<T> Range<T> {\n    // Its items from the last down: `for i in (0..n).rev()` is n - 1,\n    // n - 2, ..., 0.\n    #[inline]\n    pub fn rev(sink self) -> RevRange<T> {\n        RevRange { start: self.start, end: self.end }\n    }\n}\n\n// `(a..b).rev()`: end - 1, end - 2, ..., down to start.\npub struct RevRange<T> { pub start: T, pub end: T }\n\nimpl<T> Iterator for RevRange<T> {\n    type Item = T;\n\n    #[inline]\n    fn next(inout self) -> Option<T> {\n        if self.start < self.end {\n            let x = self.end - 1 as T;\n            self.end = x;\n            Some(x)\n        } else {\n            None\n        }\n    }\n\n    #[inline]\n    fn exact_len(self) -> i64 {\n        if self.start < self.end { (self.end - self.start) as i64 } else { 0 }\n    }\n\n    #[inline]\n    fn at(inout self, k: i64) -> T {\n        self.end - (k + 1) as T\n    }\n\n    #[inline]\n    fn fold<B, F: FnMut(B, T) -> B>(self, init: sink B, f: F) -> B {\n        var g = f;\n");
        buf_str(out, c"        var acc = init;\n        let n = self.exact_len();\n        for k in 0..n {\n            acc = g(acc, self.end - (k + 1) as T);\n        }\n        acc\n    }\n}\n// ---- Run-time CPU features (0.19) ----\n\n// std::arch::detect's word (docs/design/arch.md §2.5): bit b is set when\n// the running CPU has feature b (the compiler's numbering: FT_* in\n// compiler/src/arch/features.tach), bit 63 once the word is filled. A\n// detect the build cannot fold loads it and tests one bit\n// (back/isel/arch.tach; gen0/gen/arch.tach at -O0). Its sources follow,\n// one section per system (the compiler names the target's: arch_init_*\n// and arch_word_*, front/modules/stdsections.tach); each init takes the\n// build's features, which it need not ask the system about.\n//\n// Why there is no data race (no atomics before 0.21):\n// - A program with `main` fills the word once, as the first thing main\n//   does (back/isel/arch.tach; gen0 likewise), while it is the only\n//   thread: every later read, on any thread, comes after that write (a\n//   thread starts after what made it), and nothing writes it again.\n// - Code entered from C with no tachyon `main` (a library) fills it at its\n//   first detect (arch_word_*): two threads may both find 0 and both fill\n//   it. Each computes the same value from what the CPU and the system\n//   report, and stores it with one aligned 64-bit store, which AArch64 and\n//   x86-64 never tear (one str or mov from the compiler's own back end,\n//   which does not assume the absence of races: it never splits, repeats\n//   or invents a store to a static). A reader sees 0, and fills the word\n//   itself, or the whole word. That is a relaxed atomic load and store in\n//   0.21's terms, which the two become then, with the same instructions.\n// - TACHYON_ARCH_DISABLE (comma-separated feature names, or `all`) only\n//   clears bits, so no setting of it makes a missing instruction run: it\n");
        buf_str(out, c"//   makes detect take the fallback paths, for testing them.\nstatic var ARCH_FEATURES: u64 = 0;\n\nextern \"C\" {\n    #[link_name = \"getenv\"]\n    #[effects(global)]\n    fn arch_getenv(name: *u8) -> *u8;\n    #[link_name = \"strlen\"]\n    #[effects()]\n    fn arch_strlen(s: *u8) -> u64;\n}\n\nfn arch_bit(b: i64) -> u64 {\n    (1 as u64) << (b as u64)\n}\n\n// The word from what the system reports: TACHYON_ARCH_DISABLE's features\n// cleared (`a64`: unqualified names are AArch64's), then those whose\n// requirements are gone, stored once.\nfn arch_store(found: u64, a64: bool) -> u64 {\n    let w = arch_consistent(found & ~arch_disabled(a64)) | 0x8000000000000000;\n    unsafe {\n        ARCH_FEATURES = w;\n    }\n    w\n}\n\n// w without the features whose requirements it lacks (sha3 without sha2,\n// avx2 without avx), in the order of the implications, so that code under\n// `detect(\"sha3\")` never runs where the sha2 it may use is missing.\nfn arch_consistent(w: u64) -> u64 {\n    // (feature, what it needs) pairs: neon fp; crc aarch64; aes sha2\n    // dotprod rdm fp16 i8mm bf16 neon; sha3 sha2; sse2 .. sse4.2 the one\n    // before; avx sse4.2; avx2 and fma avx\n    let pairs: [i64; 36] = [\n        0, 1, 2, 15, 3, 0, 4, 0, 6, 0, 7, 0, 9, 0, 10, 0, 11, 0, 5, 4, 17, 16, 18, 17, 19, 18,\n        20, 19, 21, 20, 29, 21, 30, 29, 31, 29,\n    ];\n    var out = w;\n    var k = 0;\n    while k < 36 {\n        if (out & arch_bit(pairs[k])) != 0 && (out & arch_bit(pairs[k + 1])) == 0 {\n            out &= ~arch_bit(pairs[k]);\n        }\n        k += 2;\n    }\n    out\n}\n\nfn arch_same(a: [u8], b: [u8]) -> bool {\n    if a.len != b.len {\n        return false;\n    }\n    for i in 0..a.len as i64 {\n        if a[i] != b[i] {\n            return false;\n        }\n    }\n    true\n}\n\n// The bits TACHYON_ARCH_DISABLE names: features (`aarch64.aes`,\n// `x86_64.aes` qualified), `all` every one.\nfn arch_disabled(a64: bool) -> u64 {\n");
        buf_str(out, c"    // (0.21: VOLE_ARCH_DISABLE wins, the name from 0.24)\n    var p = unsafe { arch_getenv(c\"VOLE_ARCH_DISABLE\") };\n    if p == 0 as *u8 {\n        p = unsafe { arch_getenv(c\"TACHYON_ARCH_DISABLE\") };\n    }\n    if p == 0 as *u8 {\n        return 0;\n    }\n    let s = unsafe { p[0..arch_strlen(p) as i64] };\n    var out: u64 = 0;\n    var i = 0;\n    while i <= s.len as i64 {\n        var j = i;\n        while j < s.len as i64 && s[j] != ',' {\n            j += 1;\n        }\n        out |= arch_named(s[i..j], a64);\n        i = j + 1;\n    }\n    out\n}\n\nfn arch_named(name: [u8], a64: bool) -> u64 {\n    if arch_same(name, \"all\") {\n        return 0x7fffffffffffffff;\n    }\n    let a64_names: [[u8]; 12] = [\"neon\", \"fp\", \"crc\", \"aes\", \"sha2\", \"sha3\", \"dotprod\", \"rdm\",\n        \"lse\", \"fp16\", \"i8mm\", \"bf16\"];\n    let x86_names: [[u8]; 16] = [\"sse\", \"sse2\", \"sse3\", \"ssse3\", \"sse4.1\", \"sse4.2\", \"popcnt\",\n        \"lzcnt\", \"bmi1\", \"bmi2\", \"pclmulqdq\", \"aes\", \"sha\", \"avx\", \"avx2\", \"fma\"];\n    var n = name;\n    var on_a64 = a64;\n    if n.len > 8 && arch_same(n[0..8], \"aarch64.\") {\n        n = n[8..n.len as i64];\n        on_a64 = true;\n    } else if n.len > 7 && arch_same(n[0..7], \"x86_64.\") {\n        n = n[7..n.len as i64];\n        on_a64 = false;\n    }\n    if on_a64 {\n        if arch_same(n, \"asimd\") {\n            return 1;\n        }\n        for k in 0..12 {\n            if arch_same(n, a64_names[k]) {\n                return arch_bit(k);\n            }\n        }\n    } else {\n        for k in 0..16 {\n            if arch_same(n, x86_names[k]) {\n                return arch_bit(16 + k);\n            }\n        }\n    }\n    0\n}\n\n// ---- CPU features on macOS (0.19) ----\n\n// AArch64 macOS: sysctl's hw.optional.arm.FEAT_*, only for the features\n// the build does not assume (a default build, apple-m1, asks for two).\n\nextern \"C\" {\n    #[link_name = \"sysctlbyname\"]\n");
        buf_str(out, c"    #[effects(global)]\n    fn arch_sysctlbyname(name: *u8, old: *u8, len: *u64, new: *u8, newlen: u64) -> i32;\n}\n\n// Whether sysctl `name` (an int) is 1.\nfn arch_sysctl(name: *u8) -> bool {\n    var value: [u32; 2] = [0; 2];\n    var len: [u64; 1] = [8];\n    let r = unsafe { arch_sysctlbyname(name, &value as *u8, &len as *u64, 0 as *u8, 0) };\n    r == 0 && value[0] == 1\n}\n\n// Fills the word (`known`: the build's features): before main, or at a\n// library's first detect.\nfn arch_init_macos(known: u64) -> u64 {\n    var found: u64 = known | arch_bit(15) | arch_bit(0) | arch_bit(1);\n    // (bit, then the sysctls that must all be 1)\n    let names: [*u8; 13] = [\n        c\"hw.optional.arm.FEAT_CRC32\", c\"hw.optional.arm.FEAT_AES\", c\"hw.optional.arm.FEAT_PMULL\",\n        c\"hw.optional.arm.FEAT_SHA256\", c\"hw.optional.arm.FEAT_SHA3\",\n        c\"hw.optional.arm.FEAT_SHA512\", c\"hw.optional.arm.FEAT_DotProd\",\n        c\"hw.optional.arm.FEAT_RDM\", c\"hw.optional.arm.FEAT_LSE\", c\"hw.optional.arm.FEAT_FP16\",\n        c\"hw.optional.arm.FEAT_I8MM\", c\"hw.optional.arm.FEAT_BF16\", 0 as *u8,\n    ];\n    // (feature, its first name, how many)\n    let tests: [i64; 30] = [2, 0, 1, 3, 1, 2, 4, 3, 1, 5, 4, 2, 6, 6, 1, 7, 7, 1, 8, 8, 1, 9, 9, 1,\n        10, 10, 1, 11, 11, 1];\n    var k = 0;\n    while k < 30 {\n        if (found & arch_bit(tests[k])) == 0 {\n            var all = true;\n            for j in 0..tests[k + 2] {\n                if !arch_sysctl(names[tests[k + 1] + j]) {\n                    all = false;\n                }\n            }\n            if all {\n                found |= arch_bit(tests[k]);\n            }\n        }\n        k += 3;\n    }\n    arch_store(found, true)\n}\n\n// The word, filled at the first call (a library: no main filled it).\nfn arch_word_macos() -> u64 {\n    let w = unsafe { ARCH_FEATURES };\n    if w != 0 { w } else { arch_init_macos(0) }\n}\n\n// ---- CPU features on Linux (0.19) ----\n\n");
        buf_str(out, c"// AArch64 Linux: getauxval's AT_HWCAP and AT_HWCAP2.\n\nextern \"C\" {\n    #[link_name = \"getauxval\"]\n    #[effects(global)]\n    fn arch_getauxval(kind: u64) -> u64;\n}\n\n// Fills the word (`known`: the build's features): before main, or at a\n// library's first detect.\nfn arch_init_linux(known: u64) -> u64 {\n    let cap = unsafe { arch_getauxval(16) };\n    let cap2 = unsafe { arch_getauxval(26) };\n    // (HWCAP bits, all needed, then the feature: fp, asimd, crc32, aes and\n    // pmull, sha1 and sha2, sha3 and sha512, asimddp, asimdrdm, atomics,\n    // fphp and asimdhp)\n    let tests: [u64; 20] = [0x1, 1, 0x2, 0, 0x80, 2, 0x18, 3, 0x60, 4, 0x220000, 5, 0x100000, 6,\n        0x1000, 7, 0x100, 8, 0x600, 9];\n    var found: u64 = known | arch_bit(15);\n    var k = 0;\n    while k < 20 {\n        if (cap & tests[k]) == tests[k] {\n            found |= arch_bit(tests[k + 1] as i64);\n        }\n        k += 2;\n    }\n    // (HWCAP2: i8mm, bf16)\n    if (cap2 & 0x2000) != 0 {\n        found |= arch_bit(10);\n    }\n    if (cap2 & 0x4000) != 0 {\n        found |= arch_bit(11);\n    }\n    arch_store(found, true)\n}\n\n// The word, filled at the first call (a library: no main filled it).\nfn arch_word_linux() -> u64 {\n    let w = unsafe { ARCH_FEATURES };\n    if w != 0 { w } else { arch_init_linux(0) }\n}\n\n// ---- CPU features on x86-64 (0.19) ----\n\n// x86-64, either system: cpuid, and xgetbv for whether the system saves\n// the ymm registers (else no avx family: its state would be lost).\n\nextern \"C\" {\n    // (the compiler's run-time helpers, gen0/target.tach emit_arch_runtime)\n    #[link_name = \"tachyon_arch_cpuid\"]\n    #[effects()]\n    fn arch_cpuid(leaf: u32, sub: u32, out: *u32);\n    #[link_name = \"tachyon_arch_xgetbv\"]\n    #[effects()]\n    fn arch_xgetbv(index: u32) -> u64;\n}\n\n// Fills the word (`known`: the build's features): before main, or at a\n// library's first detect.\nfn arch_init_x86(known: u64) -> u64 {\n");
        buf_str(out, c"    var r: [u32; 4] = [0; 4];\n    unsafe { arch_cpuid(0, 0, &r as *u32); }\n    let max = r[0];\n    unsafe { arch_cpuid(1, 0, &r as *u32); }\n    let c1 = r[2];\n    let d1 = r[3];\n    var w: u64 = known | arch_bit(32);\n    // (register: 2 ecx, 3 edx; its bit; the feature: sse, sse2, sse3,\n    // ssse3, sse4.1, sse4.2, popcnt, pclmulqdq, aes)\n    let tests: [u32; 27] = [3, 25, 16, 3, 26, 17, 2, 0, 18, 2, 9, 19, 2, 19, 20, 2, 20, 21, 2,\n        23, 22, 2, 1, 26, 2, 25, 27];\n    var k = 0;\n    while k < 27 {\n        let reg = if tests[k] == 2 { c1 } else { d1 };\n        if (reg & ((1 as u32) << tests[k + 1])) != 0 {\n            w |= arch_bit(tests[k + 2] as i64);\n        }\n        k += 3;\n    }\n    // osxsave, then XCR0: the system saves xmm and ymm\n    let ymm = (c1 & 0x8000000) != 0 && (unsafe { arch_xgetbv(0) } & 6) == 6;\n    if ymm && (c1 & 0x10000000) != 0 {\n        w |= arch_bit(29);\n        if (c1 & 0x1000) != 0 {\n            w |= arch_bit(31);\n        }\n    }\n    if max >= 7 {\n        unsafe { arch_cpuid(7, 0, &r as *u32); }\n        let b7 = r[1];\n        if (b7 & 0x8) != 0 {\n            w |= arch_bit(24);\n        }\n        if (b7 & 0x100) != 0 {\n            w |= arch_bit(25);\n        }\n        if (b7 & 0x20000000) != 0 {\n            w |= arch_bit(28);\n        }\n        if ymm && (b7 & 0x20) != 0 {\n            w |= arch_bit(30);\n        }\n    }\n    unsafe { arch_cpuid(0x80000000, 0, &r as *u32); }\n    if r[0] >= 0x80000001 {\n        unsafe { arch_cpuid(0x80000001, 0, &r as *u32); }\n        if (r[2] & 0x20) != 0 {\n            w |= arch_bit(23);\n        }\n    }\n    arch_store(w, false)\n}\n\n// The word, filled at the first call (a library: no main filled it).\nfn arch_word_x86() -> u64 {\n    let w = unsafe { ARCH_FEATURES };\n    if w != 0 { w } else { arch_init_x86(0) }\n}\n// ---- mod std::ops ----\npub mod ops {\n// std::ops: the operator traits (0.20: from std.tach).\n\n// ---- Traits (0.9) ----\n\n");
        buf_str(out, c"// The operators: `a + b` on a type implementing Add is `a.add(b)`, and so\n// on; `-a` is `a.neg()`; `a == b` is `a.eq(&b)` (an impl wins over the\n// structural ==); `a < b` is `a.cmp(&b) < 0`. Numbers implement them all\n// without impl blocks, every type with == implements Eq, and numbers,\n// pointers and fieldless enums Ord.\npub trait Add { fn add(self, other: Self) -> Self; }\npub trait Sub { fn sub(self, other: Self) -> Self; }\npub trait Mul { fn mul(self, other: Self) -> Self; }\npub trait Div { fn div(self, other: Self) -> Self; }\npub trait Neg { fn neg(self) -> Self; }\n// ---- end mod std::ops ----\n}\n// ---- mod std::iter ----\npub mod iter {\n// std::iter: the Iterator trait, its adapters and its sources (0.20: from flat/iter.tach).\n\nuse std::{Allocator, Eq, Gpa, Hash, Option, Vec};\nuse std::collections::{HashMap, RawIter};\nuse std::slice::{swap_at, swap_raw};\n\npub trait Iterator {\n    type Item;\n\n    // The next item, or None when there are no more.\n    fn next(inout self) -> Option<Self::Item>;\n\n    // The number of items left, or -1 when it is not known.\n    #[inline]\n    fn exact_len(self) -> i64 {\n        -1\n    }\n\n    // The k-th item left: only when exact_len() > k, with k increasing\n    // (0, 1, 2, ...) and no other use of the iterator in between.\n    #[inline]\n    fn at(inout self, k: i64) -> Self::Item {\n        self.next().unwrap()\n    }\n\n    #[inline]\n    fn map<B, F: FnMut(Self::Item) -> B>(self, f: F) -> Map<Self, F> {\n        Map { it: self, f: f }\n    }\n\n    #[inline]\n    fn filter<F: FnMut(Self::Item) -> bool>(self, f: F) -> Filter<Self, F> {\n        Filter { it: self, f: f }\n    }\n\n    // Items (i64, Self::Item): each with its index.\n    #[inline]\n    fn enumerate(self) -> Enumerate<Self> {\n        Enumerate { it: self, k: 0 }\n    }\n\n    // Items (Self::Item, J::Item), as long as both have one.\n    #[inline]\n    fn zip<J: Iterator>(self, other: sink J) -> Zip<Self, J> {\n");
        buf_str(out, c"        Zip { a: self, b: other }\n    }\n\n    // The first n items.\n    #[inline]\n    fn take(self, n: i64) -> Take<Self> {\n        Take { it: self, n: n }\n    }\n\n    // f(...f(f(init, x0), x1)..., xn): the loop every consumer is.\n    #[inline]\n    fn fold<B, F: FnMut(B, Self::Item) -> B>(self, init: sink B, f: F) -> B {\n        var it = self;\n        var g = f;\n        var acc = init;\n        while let Option::Some(x) = it.next() {\n            acc = g(acc, x);\n        }\n        acc\n    }\n\n    #[inline]\n    fn for_each<F: FnMut(Self::Item)>(self, f: F) {\n        var g = f;\n        self.fold((), |u: (), x| g(x));\n    }\n\n    #[inline]\n    fn count(self) -> i64 {\n        self.fold(0i64, |n, x| n + 1)\n    }\n\n    // The sum of the items, from `0 as Self::Item`.\n    #[inline]\n    fn sum(self) -> Self::Item {\n        self.fold(0 as Self::Item, |s, x| s + x)\n    }\n\n    #[inline]\n    fn min(self) -> Option<Self::Item> {\n        var it = self;\n        match it.next() {\n            Option::Some(first) => Option::Some(it.fold(first, |m, x| if x < m { x } else { m })),\n            Option::None => Option::None,\n        }\n    }\n\n    #[inline]\n    fn max(self) -> Option<Self::Item> {\n        var it = self;\n        match it.next() {\n            Option::Some(first) => Option::Some(it.fold(first, |m, x| if x > m { x } else { m })),\n            Option::None => Option::None,\n        }\n    }\n\n    // A new Vec of the items on allocator a (0.16; the caller frees it).\n    #[inline]\n    fn collect_in<A: Allocator>(self, a: sink A) -> Vec<Self::Item, A> {\n        var it = self;\n        var v: Vec<Self::Item, A> = Vec::new_in(a);\n        let n = it.exact_len();\n        if n > 0 {\n            v.reserve(n);\n        }\n        it.for_each(|x| v.push(x));\n        v\n    }\n\n    // (0.16: an error outside std, front/ambient.tach)\n    #[ambient(\"collect_in(gpa)\")]\n    #[inline]\n    fn collect(self) -> Vec<Self::Item> {\n");
        buf_str(out, c"        self.collect_in(Gpa::ambient())\n    }\n\n    // ---- Searches (0.15) ----\n    // They call `next` and stop at the first item that decides: the items\n    // after it are not reached.\n\n    // Whether f is true for some item.\n    #[inline]\n    fn any<F: FnMut(Self::Item) -> bool>(self, f: F) -> bool {\n        var it = self;\n        var g = f;\n        while let Option::Some(x) = it.next() {\n            if g(x) {\n                return true;\n            }\n        }\n        false\n    }\n\n    // Whether f is true for every item (true when there is none).\n    #[inline]\n    fn all<F: FnMut(Self::Item) -> bool>(self, f: F) -> bool {\n        var it = self;\n        var g = f;\n        while let Option::Some(x) = it.next() {\n            if !g(x) {\n                return false;\n            }\n        }\n        true\n    }\n\n    // The index (counting from 0) of the first item f is true for.\n    #[inline]\n    fn position<F: FnMut(Self::Item) -> bool>(self, f: F) -> Option<i64> {\n        var it = self;\n        var g = f;\n        var k = 0;\n        while let Option::Some(x) = it.next() {\n            if g(x) {\n                return Option::Some(k);\n            }\n            k += 1;\n        }\n        Option::None\n    }\n\n    // The first item f is true for.\n    #[inline]\n    fn find<F: FnMut(Self::Item) -> bool>(self, f: F) -> Option<Self::Item> {\n        var it = self;\n        var g = f;\n        while let Option::Some(x) = it.next() {\n            if g(x) {\n                return Option::Some(x);\n            }\n        }\n        Option::None\n    }\n}\n\n// ---- Adapters ----\n\npub struct Map<I, F> { it: I, f: F }\n\nimpl<I: Iterator, M> Iterator for Map<I, M> {\n    type Item = M::Output;\n\n    #[inline]\n    fn next(inout self) -> Option<M::Output> {\n        match self.it.next() {\n            Option::Some(x) => Option::Some((self.f)(x)),\n            Option::None => Option::None,\n        }\n    }\n\n    #[inline]\n");
        buf_str(out, c"    fn exact_len(self) -> i64 {\n        self.it.exact_len()\n    }\n\n    #[inline]\n    fn at(inout self, k: i64) -> M::Output {\n        (self.f)(self.it.at(k))\n    }\n\n    #[inline]\n    fn fold<B, F: FnMut(B, M::Output) -> B>(self, init: sink B, f: F) -> B {\n        var m = self.f;\n        var g = f;\n        self.it.fold(init, |acc, x| g(acc, m(x)))\n    }\n}\n\npub struct Filter<I, F> { it: I, f: F }\n\nimpl<I: Iterator, P> Iterator for Filter<I, P> {\n    type Item = I::Item;\n\n    #[inline]\n    fn next(inout self) -> Option<I::Item> {\n        loop {\n            match self.it.next() {\n                Option::Some(x) => {\n                    if (self.f)(x) {\n                        return Option::Some(x);\n                    }\n                }\n                Option::None => return Option::None,\n            }\n        }\n    }\n\n    #[inline]\n    fn fold<B, F: FnMut(B, I::Item) -> B>(self, init: sink B, f: F) -> B {\n        var p = self.f;\n        var g = f;\n        self.it.fold(init, |acc, x| if p(x) { g(acc, x) } else { acc })\n    }\n}\n\npub struct Enumerate<I> { it: I, k: i64 }\n\nimpl<I: Iterator> Iterator for Enumerate<I> {\n    type Item = (i64, I::Item);\n\n    #[inline]\n    fn next(inout self) -> Option<(i64, I::Item)> {\n        match self.it.next() {\n            Option::Some(x) => {\n                let k = self.k;\n                self.k = k + 1;\n                Option::Some((k, x))\n            }\n            Option::None => Option::None,\n        }\n    }\n\n    #[inline]\n    fn exact_len(self) -> i64 {\n        self.it.exact_len()\n    }\n\n    #[inline]\n    fn at(inout self, k: i64) -> (i64, I::Item) {\n        (self.k + k, self.it.at(k))\n    }\n\n    #[inline]\n    fn fold<B, F: FnMut(B, (i64, I::Item)) -> B>(self, init: sink B, f: F) -> B {\n        var e = self;\n        var g = f;\n        var acc = init;\n        let n = e.it.exact_len();\n        if n >= 0 {\n            for k in 0..n {\n");
        buf_str(out, c"                acc = g(acc, (e.k + k, e.it.at(k)));\n            }\n        } else {\n            while let Option::Some(p) = e.next() {\n                acc = g(acc, p);\n            }\n        }\n        acc\n    }\n}\n\npub struct Zip<I, J> { a: I, b: J }\n\nimpl<A: Iterator, J: Iterator> Iterator for Zip<A, J> {\n    type Item = (A::Item, J::Item);\n\n    #[inline]\n    fn next(inout self) -> Option<(A::Item, J::Item)> {\n        match self.a.next() {\n            Option::Some(x) => match self.b.next() {\n                Option::Some(y) => Option::Some((x, y)),\n                Option::None => Option::None,\n            },\n            Option::None => Option::None,\n        }\n    }\n\n    #[inline]\n    fn exact_len(self) -> i64 {\n        let n = self.a.exact_len();\n        let m = self.b.exact_len();\n        if n < 0 || m < 0 {\n            -1\n        } else if n < m {\n            n\n        } else {\n            m\n        }\n    }\n\n    #[inline]\n    fn at(inout self, k: i64) -> (A::Item, J::Item) {\n        (self.a.at(k), self.b.at(k))\n    }\n\n    #[inline]\n    fn fold<B, F: FnMut(B, (A::Item, J::Item)) -> B>(self, init: sink B, f: F) -> B {\n        var z = self;\n        var g = f;\n        var acc = init;\n        let n = z.exact_len();\n        if n >= 0 {\n            for k in 0..n {\n                acc = g(acc, (z.a.at(k), z.b.at(k)));\n            }\n        } else {\n            while let Option::Some(p) = z.next() {\n                acc = g(acc, p);\n            }\n        }\n        acc\n    }\n}\n\npub struct Take<I> { it: I, n: i64 }\n\nimpl<I: Iterator> Iterator for Take<I> {\n    type Item = I::Item;\n\n    #[inline]\n    fn next(inout self) -> Option<I::Item> {\n        if self.n <= 0 {\n            return Option::None;\n        }\n        self.n -= 1;\n        self.it.next()\n    }\n\n    #[inline]\n    fn exact_len(self) -> i64 {\n        let m = self.it.exact_len();\n        if m < 0 {\n            -1\n");
        buf_str(out, c"        } else if self.n <= 0 {\n            0\n        } else if m < self.n {\n            m\n        } else {\n            self.n\n        }\n    }\n\n    #[inline]\n    fn at(inout self, k: i64) -> I::Item {\n        self.it.at(k)\n    }\n\n    #[inline]\n    fn fold<B, F: FnMut(B, I::Item) -> B>(self, init: sink B, f: F) -> B {\n        var t = self;\n        var g = f;\n        var acc = init;\n        let n = t.exact_len();\n        if n >= 0 {\n            for k in 0..n {\n                acc = g(acc, t.it.at(k));\n            }\n        } else {\n            while t.n > 0 {\n                match t.it.next() {\n                    Option::Some(x) => {\n                        t.n -= 1;\n                        acc = g(acc, x);\n                    }\n                    Option::None => break,\n                }\n            }\n        }\n        acc\n    }\n}\n\n// ---- Sources ----\n//\n// `for` over a SliceIter, a Range or a RangeInclusive is a counted loop\n// (front/check/iterate.tach); their `fold` is one too.\n\n// `a..b` as a value: start, start + 1, ..., up to end, end excluded.\npub struct Range<T> { pub start: T, pub end: T }\n\nimpl<T> Iterator for Range<T> {\n    type Item = T;\n\n    #[inline]\n    fn next(inout self) -> Option<T> {\n        if self.start < self.end {\n            let x = self.start;\n            self.start = x + 1;\n            Option::Some(x)\n        } else {\n            Option::None\n        }\n    }\n\n    #[inline]\n    fn exact_len(self) -> i64 {\n        if self.start < self.end { (self.end - self.start) as i64 } else { 0 }\n    }\n\n    #[inline]\n    fn at(inout self, k: i64) -> T {\n        self.start + k as T\n    }\n\n    #[inline]\n    fn fold<B, F: FnMut(B, T) -> B>(self, init: sink B, f: F) -> B {\n        var g = f;\n        var acc = init;\n        for x in self.start..self.end {\n            acc = g(acc, x);\n        }\n        acc\n    }\n}\n\n// `a..=b` as a value: end included; `done` once `next` gave end.\n");
        buf_str(out, c"pub struct RangeInclusive<T> { pub start: T, pub end: T, pub done: bool }\n\nimpl<T> Iterator for RangeInclusive<T> {\n    type Item = T;\n\n    #[inline]\n    fn next(inout self) -> Option<T> {\n        if self.done || self.start > self.end {\n            return Option::None;\n        }\n        let x = self.start;\n        if x == self.end {\n            self.done = true;\n        } else {\n            self.start = x + 1;\n        }\n        Option::Some(x)\n    }\n\n    #[inline]\n    fn exact_len(self) -> i64 {\n        if self.done || self.start > self.end { 0 } else { (self.end - self.start) as i64 + 1 }\n    }\n\n    #[inline]\n    fn at(inout self, k: i64) -> T {\n        self.start + k as T\n    }\n\n    #[inline]\n    fn fold<B, F: FnMut(B, T) -> B>(self, init: sink B, f: F) -> B {\n        var g = f;\n        var acc = init;\n        if !self.done {\n            for x in self.start..=self.end {\n                acc = g(acc, x);\n            }\n        }\n        acc\n    }\n}\n\n// The items of a slice, by value: `v.iter()`, `s.iter()`.\npub struct SliceIter<T> { s: [T], pos: i64 }\n\nimpl<T> Iterator for SliceIter<T> {\n    type Item = T;\n\n    #[inline]\n    fn next(inout self) -> Option<T> {\n        if self.pos < self.s.len {\n            let x = self.s[self.pos];\n            self.pos += 1;\n            Option::Some(x)\n        } else {\n            Option::None\n        }\n    }\n\n    #[inline]\n    fn exact_len(self) -> i64 {\n        self.s.len - self.pos\n    }\n\n    #[inline]\n    fn at(inout self, k: i64) -> T {\n        self.s[self.pos + k]\n    }\n\n    #[inline]\n    fn fold<B, F: FnMut(B, T) -> B>(self, init: sink B, f: F) -> B {\n        var g = f;\n        var acc = init;\n        let s = self.s;\n        for k in self.pos..s.len {\n            acc = g(acc, s[k]);\n        }\n        acc\n    }\n}\n\nimpl<T> SliceIter<T> {\n    // The items left, as a slice.\n    #[inline]\n");
        buf_str(out, c"    // (0.20: self is a copy of the view; what it views is its level 1)\n    #[views(self)]\n    pub fn as_slice(self) -> [T] {\n        self.s[self.pos..self.s.len]\n    }\n}\n\nimpl<T>[T] {\n    // Its items, by value.\n    #[inline]\n    #[views(self)]\n    pub fn iter(self: [T]) -> SliceIter<T> {\n        SliceIter { s: self, pos: 0 }\n    }\n\n    // Its items, by reference (0.17): `for x in s.iter_ref()`, x a `&T`,\n    // the elements neither copied nor moved.\n    #[inline]\n    #[views(self)]\n    pub fn iter_ref(self: [T]) -> SliceRefIter<T> {\n        SliceRefIter { s: self, pos: 0 }\n    }\n\n    // Sorts it in place by f (see sort_by).\n    #[inline]\n    pub fn sort_by<F: FnMut(let T, let T) -> i64>(self: inout [T], f: F) {\n        sort_by(self, f);\n    }\n\n    // Exchanges elements i and j (checked; 0.17).\n    #[inline]\n    pub fn swap(self: inout [T], i: i64, j: i64) {\n        swap_at::<T>(self, i, j);\n    }\n}\n\nimpl<T, A: Allocator> Vec<T, A> {\n    // Its items, by value (a view: valid until the vector grows or is\n    // freed).\n    #[inline]\n    #[views(self)]\n    pub fn iter(self) -> SliceIter<T> {\n        SliceIter { s: self.as_slice(), pos: 0 }\n    }\n\n    // Its items, by reference (0.17): `for x in v.iter_ref()`, x a `&T`.\n    #[inline]\n    #[views(self)]\n    pub fn iter_ref(self) -> SliceRefIter<T> {\n        SliceRefIter { s: self.as_slice(), pos: 0 }\n    }\n\n    // Sorts it in place by f (see sort_by).\n    #[inline]\n    pub fn sort_by<F: FnMut(let T, let T) -> i64>(inout self, f: F) {\n        sort_by(self.as_mut_slice(), f);\n    }\n}\n\n// The items of a slice, by reference (0.17): `v.iter_ref()`,\n// `s.iter_ref()`; a view of the slice.\npub struct SliceRefIter<T> { s: [T], pos: i64 }\n\nimpl<T> Iterator for SliceRefIter<T> {\n    type Item = let T;\n\n    #[inline]\n    fn next(inout self) -> Option<let T> {\n        if self.pos < self.s.len {\n            let x = &self.s[self.pos];\n            self.pos += 1;\n");
        buf_str(out, c"            Option::Some(x)\n        } else {\n            Option::None\n        }\n    }\n\n    #[inline]\n    fn exact_len(self) -> i64 {\n        self.s.len - self.pos\n    }\n\n    #[inline]\n    fn at(inout self, k: i64) -> let T {\n        self.s[self.pos + k]\n    }\n}\n\n// `m.iter()`: (key, value) in slot order, until the map changes. (0.17) A\n// view of the map: (0.20) its table's iterator, a view of its control\n// bytes, and its buckets.\npub struct HashMapIter<K, V> { it: RawIter, data: *(K, V), left: i64 }\n\nimpl<K, V> Iterator for HashMapIter<K, V> {\n    type Item = (K, V);\n\n    #[inline]\n    fn next(inout self) -> Option<(K, V)> {\n        let i = self.it.next_index();\n        if i < 0 {\n            return Option::None;\n        }\n        self.left -= 1;\n        let e = unsafe { &self.data[i] };\n        Option::Some((unsafe { (*e).0 }, unsafe { (*e).1 }))\n    }\n\n    #[inline]\n    fn exact_len(self) -> i64 {\n        self.left\n    }\n\n    #[inline]\n    fn fold<B, F: FnMut(B, (K, V)) -> B>(self, init: sink B, f: F) -> B {\n        var g = f;\n        var acc = init;\n        var it = self.it;\n        for _ in 0..self.left {\n            let i = it.next_index();\n            let e = unsafe { &self.data[i] };\n            acc = g(acc, (unsafe { (*e).0 }, unsafe { (*e).1 }));\n        }\n        acc\n    }\n}\n\npub struct Keys<K, V> { it: HashMapIter<K, V> }\n\nimpl<K, V> Iterator for Keys<K, V> {\n    type Item = K;\n\n    #[inline]\n    fn next(inout self) -> Option<K> {\n        match self.it.next() {\n            Option::Some(e) => Option::Some(e.0),\n            Option::None => Option::None,\n        }\n    }\n\n    #[inline]\n    fn exact_len(self) -> i64 {\n        self.it.left\n    }\n\n    #[inline]\n    fn fold<B, F: FnMut(B, K) -> B>(self, init: sink B, f: F) -> B {\n        var g = f;\n        self.it.fold(init, |acc, e| g(acc, e.0))\n    }\n}\n\npub struct Values<K, V> { it: HashMapIter<K, V> }\n\n");
        buf_str(out, c"impl<K, V> Iterator for Values<K, V> {\n    type Item = V;\n\n    #[inline]\n    fn next(inout self) -> Option<V> {\n        match self.it.next() {\n            Option::Some(e) => Option::Some(e.1),\n            Option::None => Option::None,\n        }\n    }\n\n    #[inline]\n    fn exact_len(self) -> i64 {\n        self.it.left\n    }\n\n    #[inline]\n    fn fold<B, F: FnMut(B, V) -> B>(self, init: sink B, f: F) -> B {\n        var g = f;\n        self.it.fold(init, |acc, e| g(acc, e.1))\n    }\n}\n\nimpl<K: Hash + Eq, V, A: Allocator> HashMap<K, V, A> {\n    #[inline]\n    #[views(self)]\n    pub fn iter(self) -> HashMapIter<K, V> {\n        let t = self.raw_table();\n        let data = if t.len() == 0 { 0 as *(K, V) } else { t.bucket_ptr() };\n        HashMapIter { it: t.iter(), data: data, left: t.len() }\n    }\n\n    #[inline]\n    #[views(self)]\n    pub fn keys(self) -> Keys<K, V> {\n        Keys { it: self.iter() }\n    }\n\n    #[inline]\n    #[views(self)]\n    pub fn values(self) -> Values<K, V> {\n        Values { it: self.iter() }\n    }\n}\n\n// Sorts s in place by f: f(a, b) is negative, zero or positive as *a goes\n// before, with or after *b (`|a, b| a.cmp(b)`: smallest first). A\n// heapsort: not stable. (0.17) f takes references; the elements move as\n// bits, so any T sorts, owned ones too.\npub fn sort_by<T, F: FnMut(let T, let T) -> i64>(s: inout [T], f: F) {\n    var g = f;\n    let n = s.len;\n    let p = s.ptr;\n    var start = n / 2;\n    var end = n;\n    // (each round takes one from start or end: n / 2 + n at most; 0.16:\n    // counted loops, no effect diverge; every index is below end <= n)\n    unsafe {\n        for _ in 0..n / 2 + n + 1 {\n            // Build the heap from n/2 down, then move its top behind it.\n            if start > 0 {\n                start -= 1;\n            } else {\n                end -= 1;\n                if end <= 0 {\n                    return;\n                }\n");
        buf_str(out, c"                swap_raw::<T>(p, 0, end);\n            }\n            var root = start;\n            for _ in 0..64 {\n                var child = 2 * root + 1;\n                if child >= end {\n                    break;\n                }\n                if child + 1 < end && g(*(&p[child]), *(&p[child + 1])) < 0 {\n                    child += 1;\n                }\n                if g(*(&p[root]), *(&p[child])) >= 0 {\n                    break;\n                }\n                swap_raw::<T>(p, root, child);\n                root = child;\n            }\n        }\n    }\n}\n// ---- end mod std::iter ----\n}\n// ---- mod std::slice ----\npub mod slice {\n// std::slice: sorting, searching and the slice algorithms (0.20: from\n// std.tach; the 0.20 sorts, after Rust's ipnsort and driftsort, in\n// the kernels below, slice/unstable.tach and slice/stable.tach; binary\n// search in slice/search.tach; reverse, rotations, fill, dedup, retain\n// and the heap sifts in slice/algo.tach).\n\nmod unstable;\nmod stable;\nmod search;\nmod algo;\n\npub use algo::{\n    dedup, dedup_by, dedup_by_key, fill, heap_sift_down_less, heap_sift_down_to_bottom_less,\n    heap_sift_up_less, retain_by, reverse, rotate_left, rotate_right,\n};\npub use search::{binary_search, binary_search_by, binary_search_by_key, partition_point};\npub use stable::{\n    sort_stable_less, sort_stable_less_with, sort_stable_noalloc, sort_stable_scratch_len,\n};\npub use unstable::{\n    select_nth_unstable, select_nth_unstable_by, select_nth_unstable_by_key,\n    select_nth_unstable_less, sort_unstable, sort_unstable_by, sort_unstable_by_key,\n    sort_unstable_less,\n};\n\nuse std::{Allocator, Gpa, Ord, Vec};\n\n// ---- Sorting (0.9) ----\n\n// Sorts s in place, smallest first; not stable (equal elements may change\n// order): the unstable sort, `sort_unstable` (0.20: ipnsort; before, an\n// introsort). O(n log n) comparisons at worst, O(n) when s is one run up\n");
        buf_str(out, c"// or down. A `cmp` that is not a total order leaves s a permutation of\n// itself in some order, never out of bounds. The sorts' loops are counted\n// and nothing recurses: no effect diverge. (0.17) `sort(&mut a[..])`,\n// `sort(v.as_mut_slice())`, `v.sort()`; the elements move as bits, so any\n// T: Ord sorts, owned ones too.\npub fn sort<T: Ord>(s: inout [T]) {\n    sort_unstable_less(s, |a: T, b: T| a < b);\n}\n\nimpl<T: Ord, A: Allocator> Vec<T, A> {\n    // Sorts it in place, smallest first (0.17; see sort).\n    #[inline]\n    pub fn sort(inout self) {\n        sort(self.as_mut_slice());\n    }\n}\n\nimpl<T: Ord>[T] {\n    // Sorts it in place, smallest first (0.17; see sort).\n    #[inline]\n    pub fn sort(self: inout [T]) {\n        sort(self);\n    }\n}\n\n// ---- Swapping (0.17) ----\n\n// Exchanges s[i] and s[j] (checked), as bits: any T, owned ones too.\n#[inline]\npub fn swap_at<T>(s: inout [T], i: i64, j: i64) {\n    let a: *T = &s[i];\n    let b: *T = &s[j];\n    unsafe {\n        let t = *a;\n        *a = *b;\n        *b = t;\n    }\n}\n\n// Exchanges p[i] and p[j], as bits. Unsafe: both are in p's elements.\n#[inline]\npub unsafe fn swap_raw<T>(p: *T, i: i64, j: i64) {\n    let t = p[i];\n    p[i] = p[j];\n    p[j] = t;\n}\n\n// ---- Stable sort (0.15) ----\n\n// Sorts s in place, smallest first, keeping equal elements in the order\n// they had (0.15), with a buffer from allocator a (0.16):\n// `sort_stable_by_in` with `|a, b| a.cmp(b)`.\npub fn sort_stable_in<T: Ord, A: Allocator>(s: inout [T], a: sink A) {\n    sort_stable_less_in(s, |x: T, y: T| x < y, a);\n}\n\n#[ambient(\"sort_stable_in(s, gpa)\")]\npub fn sort_stable<T: Ord>(s: inout [T]) {\n    sort_stable_in(s, Gpa::ambient());\n}\n\n#[ambient(\"sort_stable_by_in(s, f, gpa)\")]\npub fn sort_stable_by<T, F: FnMut(let T, let T) -> i64>(s: inout [T], f: F) {\n    sort_stable_by_in(s, f, Gpa::ambient());\n}\n\n// Sorts s in place by f (as sort_by: f(a, b) negative when *a goes before\n");
        buf_str(out, c"// *b), keeping equal elements in the order they had (0.15). The stable\n// sort (0.20: driftsort; before, a merge sort) with its scratch from\n// allocator a (0.16): none up to 20 elements, else all of s up to 8 MB\n// and half beyond (`sort_stable_scratch_len`). O(n log n) comparisons. A\n// `f` that is not a total order leaves s a permutation of itself in some\n// order, never out of bounds.\npub fn sort_stable_by_in<T, F: FnMut(let T, let T) -> i64, A: Allocator>(s: inout [T], f: F,\n    a: sink A) {\n    var g = f;\n    sort_stable_less_in(s, |x: T, y: T| g(x, y) < 0, a);\n}\n\n// The stable sort by is_less with its scratch from a. (0.17) The elements\n// move as bits between s and the buffer through raw pointers (the\n// buffer's elements are never its own: its length stays 0).\npub fn sort_stable_less_in<T, F: FnMut(let T, let T) -> bool,\n    A: Allocator>(s: inout [T], is_less: F, a: sink A) {\n    let n = s.len;\n    if n <= 20 {\n        // (no scratch: insertion sort)\n        unsafe {\n            sort_stable_less_with(s, 0 as *T, 0, is_less);\n        }\n        return;\n    }\n    let len = sort_stable_scratch_len::<T>(n);\n    var buf: Vec<T, A> = Vec::with_capacity_in(len, a);\n    // (the buffer has room for len elements, outside s)\n    unsafe {\n        sort_stable_less_with(s, buf.ptr, len, is_less);\n    }\n    buf.free();\n}\n\n// ---- Sort kernels (0.20) ----\n\n// What both sorts (0.20) use on short slices, after Rust's\n// slice::sort::shared::smallsort: insertion sort, a branchless stable\n// sort of 4 elements, the bidirectional merge, and the general small sort\n// built from them (two halves presorted in 8s or 4s, completed by\n// insertion, then merged from both ends at once). Every one is stable.\n//\n// Unsafe code: as the sorts' (Sort, unstable): each kernel takes raw\n// pointers to slots its caller owns, with their lengths in the contract\n// at it; every index is bounded by those lengths whatever the comparator\n");
        buf_str(out, c"// answers. Elements move as bits; with no unwinding (a panic ends the\n// process) a half-done kernel is never observed and nothing is dropped\n// twice.\n\n// Sorts v[0..n] by insertion, v[0..offset] being sorted (1 <= offset).\n// Stable: an element moves left only past greater ones.\nunsafe fn insertion_sort_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, offset: i64,\n    is_less: F) {\n    var f = is_less;\n    for i in offset..n {\n        insert_tail_raw(v, i, f);\n    }\n}\n\n// Inserts v[i] into the sorted v[0..i] (i >= 1), after the elements\n// equal to it.\n#[inline]\nunsafe fn insert_tail_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, i: i64, is_less: F) {\n    var f = is_less;\n    if f(*(&v[i]), *(&v[i - 1])) {\n        let x = v[i];\n        v[i] = v[i - 1];\n        var j = i - 1;\n        // (j >= 1 inside the loop: it runs i - 1 times at most)\n        for _ in 0..i - 1 {\n            if !f(x, *(&v[j - 1])) {\n                break;\n            }\n            v[j] = v[j - 1];\n            j -= 1;\n        }\n        v[j] = x;\n    }\n}\n\n// dst[0..4] = v[0..4] sorted, stably, with five comparisons and no\n// branch on them (Rust's sort4_stable). v and dst do not overlap.\n#[inline]\nunsafe fn sort4_stable_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, dst: *T, is_less: F) {\n    var f = is_less;\n    // Two ordered pairs, a <= b and c <= d.\n    let c1 = f(*(&v[1]), *(&v[0])) as i64;\n    let c2 = f(*(&v[3]), *(&v[2])) as i64;\n    let a: *T = &v[c1];\n    let b: *T = &v[1 - c1];\n    let c: *T = &v[2 + c2];\n    let d: *T = &v[3 - c2];\n    // The least and the greatest, and the two left, in their order.\n    let c3 = f(*c, *a);\n    let c4 = f(*d, *b);\n    let min = if c3 { c } else { a };\n    let max = if c4 { b } else { d };\n    let unknown_left = if c3 { a } else if c4 { c } else { b };\n    let unknown_right = if c4 { d } else if c3 { b } else { c };\n    let c5 = f(*unknown_right, *unknown_left);\n");
        buf_str(out, c"    let lo = if c5 { unknown_right } else { unknown_left };\n    let hi = if c5 { unknown_left } else { unknown_right };\n    dst[0] = *min;\n    dst[1] = *lo;\n    dst[2] = *hi;\n    dst[3] = *max;\n}\n\n// dst[0..8] = v[0..8] sorted, stably, through tmp[0..8]. None overlap.\nunsafe fn sort8_stable_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, dst: *T, tmp: *T, is_less: F) {\n    var f = is_less;\n    sort4_stable_raw(v, tmp, f);\n    sort4_stable_raw(&v[4], &tmp[4], f);\n    bidirectional_merge_raw(tmp, 8, dst, f);\n}\n\n// Merges the sorted halves src[0..len/2] and src[len/2..len] (len >= 2)\n// into dst[0..len], stably, from both ends at once: each round takes the\n// least of the two fronts and the greatest of the two backs, with no\n// branch on the comparisons. src and dst do not overlap. Every read stays\n// in src[0..len] whatever the comparator answers (Rust's argument: each\n// end moves at most len / 2 times); when the ends do not meet as they\n// must for a total order, dst gets src back as it was, so it holds a\n// permutation of src either way.\nunsafe fn bidirectional_merge_raw<T, F: FnMut(let T, let T) -> bool>(src: *T, len: i64, dst: *T,\n    is_less: F) {\n    var f = is_less;\n    let half = len / 2;\n    var left = 0;\n    var right = half;\n    var out = 0;\n    var left_rev = half - 1;\n    var right_rev = len - 1;\n    var out_rev = len - 1;\n    for _ in 0..half {\n        let take_left = !f(*(&src[right]), *(&src[left]));\n        let p: *T = if take_left { &src[left] } else { &src[right] };\n        left += take_left as i64;\n        right += (!take_left) as i64;\n        dst[out] = *p;\n        out += 1;\n        let take_left_rev = f(*(&src[right_rev]), *(&src[left_rev]));\n        let q: *T = if take_left_rev { &src[left_rev] } else { &src[right_rev] };\n        left_rev -= take_left_rev as i64;\n        right_rev -= (!take_left_rev) as i64;\n        dst[out_rev] = *q;\n        out_rev -= 1;\n    }\n    if len % 2 != 0 {\n");
        buf_str(out, c"        let left_nonempty = left <= left_rev;\n        let p: *T = if left_nonempty { &src[left] } else { &src[right] };\n        dst[out] = *p;\n        left += left_nonempty as i64;\n        right += (!left_nonempty) as i64;\n    }\n    if left != left_rev + 1 || right != right_rev + 1 {\n        // (not a total order)\n        for i in 0..len {\n            dst[i] = src[i];\n        }\n    }\n}\n\n// Puts v[a] and v[b] (a < b) in order, with no branch on the comparison.\n#[inline]\nunsafe fn swap_if_less_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, a: i64, b: i64, is_less: F) {\n    var f = is_less;\n    let pa: *T = &v[a];\n    let pb: *T = &v[b];\n    let sw = f(*pb, *pa);\n    if size_of(T) == 8 {\n        // (8-byte elements: their bits selected in registers, csel, not\n        // through a selected address; no T is moved, so owned ones too)\n        let x = *(pa as *u64);\n        let y = *(pb as *u64);\n        *(pa as *u64) = if sw { y } else { x };\n        *(pb as *u64) = if sw { x } else { y };\n        return;\n    }\n    let l = if sw { pb } else { pa };\n    let r = if sw { pa } else { pb };\n    let x = *l;\n    let y = *r;\n    v[a] = x;\n    v[b] = y;\n}\n\n// Sorts v[0..9] with an optimal sorting network (25 comparators, depth 7;\n// Bert Dobbelaere's list, as Rust's sort9_optimal). Not stable.\nunsafe fn sort9_network_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, is_less: F) {\n    var f = is_less;\n    swap_if_less_raw(v, 0, 3, f);\n    swap_if_less_raw(v, 1, 7, f);\n    swap_if_less_raw(v, 2, 5, f);\n    swap_if_less_raw(v, 4, 8, f);\n    swap_if_less_raw(v, 0, 7, f);\n    swap_if_less_raw(v, 2, 4, f);\n    swap_if_less_raw(v, 3, 8, f);\n    swap_if_less_raw(v, 5, 6, f);\n    swap_if_less_raw(v, 0, 2, f);\n    swap_if_less_raw(v, 1, 3, f);\n    swap_if_less_raw(v, 4, 5, f);\n    swap_if_less_raw(v, 7, 8, f);\n    swap_if_less_raw(v, 1, 4, f);\n    swap_if_less_raw(v, 3, 6, f);\n    swap_if_less_raw(v, 5, 7, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 0, 1, f);\n    swap_if_less_raw(v, 2, 4, f);\n    swap_if_less_raw(v, 3, 5, f);\n    swap_if_less_raw(v, 6, 8, f);\n    swap_if_less_raw(v, 2, 3, f);\n    swap_if_less_raw(v, 4, 5, f);\n    swap_if_less_raw(v, 6, 7, f);\n    swap_if_less_raw(v, 1, 2, f);\n    swap_if_less_raw(v, 3, 4, f);\n    swap_if_less_raw(v, 5, 6, f);\n}\n\n// Sorts v[0..13] with an optimal sorting network (45 comparators, depth\n// 10; as Rust's sort13_optimal). Not stable.\nunsafe fn sort13_network_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, is_less: F) {\n    var f = is_less;\n    swap_if_less_raw(v, 0, 12, f);\n    swap_if_less_raw(v, 1, 10, f);\n    swap_if_less_raw(v, 2, 9, f);\n    swap_if_less_raw(v, 3, 7, f);\n    swap_if_less_raw(v, 5, 11, f);\n    swap_if_less_raw(v, 6, 8, f);\n    swap_if_less_raw(v, 1, 6, f);\n    swap_if_less_raw(v, 2, 3, f);\n    swap_if_less_raw(v, 4, 11, f);\n    swap_if_less_raw(v, 7, 9, f);\n    swap_if_less_raw(v, 8, 10, f);\n    swap_if_less_raw(v, 0, 4, f);\n    swap_if_less_raw(v, 1, 2, f);\n    swap_if_less_raw(v, 3, 6, f);\n    swap_if_less_raw(v, 7, 8, f);\n    swap_if_less_raw(v, 9, 10, f);\n    swap_if_less_raw(v, 11, 12, f);\n    swap_if_less_raw(v, 4, 6, f);\n    swap_if_less_raw(v, 5, 9, f);\n    swap_if_less_raw(v, 8, 11, f);\n    swap_if_less_raw(v, 10, 12, f);\n    swap_if_less_raw(v, 0, 5, f);\n    swap_if_less_raw(v, 3, 8, f);\n    swap_if_less_raw(v, 4, 7, f);\n    swap_if_less_raw(v, 6, 11, f);\n    swap_if_less_raw(v, 9, 10, f);\n    swap_if_less_raw(v, 0, 1, f);\n    swap_if_less_raw(v, 2, 5, f);\n    swap_if_less_raw(v, 6, 9, f);\n    swap_if_less_raw(v, 7, 8, f);\n    swap_if_less_raw(v, 10, 11, f);\n    swap_if_less_raw(v, 1, 3, f);\n    swap_if_less_raw(v, 2, 4, f);\n    swap_if_less_raw(v, 5, 6, f);\n    swap_if_less_raw(v, 9, 10, f);\n    swap_if_less_raw(v, 1, 2, f);\n    swap_if_less_raw(v, 3, 4, f);\n    swap_if_less_raw(v, 5, 7, f);\n    swap_if_less_raw(v, 6, 8, f);\n    swap_if_less_raw(v, 2, 3, f);\n");
        buf_str(out, c"    swap_if_less_raw(v, 4, 5, f);\n    swap_if_less_raw(v, 6, 7, f);\n    swap_if_less_raw(v, 8, 9, f);\n    swap_if_less_raw(v, 3, 4, f);\n    swap_if_less_raw(v, 5, 6, f);\n}\n\n// Sorts v[0..len] (len <= 32) with scratch[0..len], not stably (Rust's\n// small_sort_network, for elements of 8 bytes or less): each half (the\n// whole below 18) presorted by a network of 13 or 9, completed by\n// insertion, and the halves merged through the scratch.\nunsafe fn small_sort_network_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, scratch: *T,\n    is_less: F) {\n    var f = is_less;\n    if len < 2 {\n        return;\n    }\n    let half = len / 2;\n    let whole = len < 18;\n    let first = if whole { len } else { half };\n    presort_network_raw(v, first, f);\n    if whole {\n        return;\n    }\n    presort_network_raw(&v[half], len - half, f);\n    for i in 0..len {\n        scratch[i] = v[i];\n    }\n    bidirectional_merge_raw(scratch, len, v, f);\n}\n\n// Sorts v[0..len] (len <= 17): a network over its first 13 or 9, then\n// insertion.\n#[inline]\nunsafe fn presort_network_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, is_less: F) {\n    var f = is_less;\n    var presorted = 1;\n    if len >= 13 {\n        sort13_network_raw(v, f);\n        presorted = 13;\n    } else if len >= 9 {\n        sort9_network_raw(v, f);\n        presorted = 9;\n    }\n    insertion_sort_raw(v, len, presorted, f);\n}\n\n// Sorts v[0..len] (len <= 32), stably, with scratch[0..len + 16] (Rust's\n// small_sort_general_with_scratch): each half is presorted in 8s (or 4s)\n// into the scratch, completed there by insertion, and the halves are\n// merged back into v.\nunsafe fn small_sort_raw<T,\n    F: FnMut(let T, let T) -> bool>(v: *T, len: i64, scratch: *T, is_less: F) {\n    var f = is_less;\n    if len < 2 {\n        return;\n    }\n    let half = len / 2;\n    var presorted = 1;\n    if len >= 16 {\n        sort8_stable_raw(v, scratch, &scratch[len], f);\n");
        buf_str(out, c"        sort8_stable_raw(&v[half], &scratch[half], &scratch[len + 8], f);\n        presorted = 8;\n    } else if len >= 8 {\n        sort4_stable_raw(v, scratch, f);\n        sort4_stable_raw(&v[half], &scratch[half], f);\n        presorted = 4;\n    } else {\n        scratch[0] = v[0];\n        scratch[half] = v[half];\n    }\n    for i in presorted..half {\n        scratch[i] = v[i];\n        insert_tail_raw(scratch, i, f);\n    }\n    let w: *T = &scratch[half];\n    let src: *T = &v[half];\n    for i in presorted..len - half {\n        w[i] = src[i];\n        insert_tail_raw(w, i, f);\n    }\n    bidirectional_merge_raw(scratch, len, v, f);\n}\n\n// The length of the run that starts v[0..n] (n >= 2), and whether it is\n// strictly descending (else non-descending).\nunsafe fn existing_run_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, is_less: F) -> (i64,\n    bool) {\n    var f = is_less;\n    let desc = f(*(&v[1]), *(&v[0]));\n    var run = 2;\n    // (run < n inside each loop)\n    if desc {\n        for _ in 2..n {\n            if !f(*(&v[run]), *(&v[run - 1])) {\n                break;\n            }\n            run += 1;\n        }\n    } else {\n        for _ in 2..n {\n            if f(*(&v[run]), *(&v[run - 1])) {\n                break;\n            }\n            run += 1;\n        }\n    }\n    (run, desc)\n}\n\n// Reverses v[0..n].\nunsafe fn reverse_raw<T>(v: *T, n: i64) {\n    for i in 0..n / 2 {\n        let t = v[i];\n        v[i] = v[n - 1 - i];\n        v[n - 1 - i] = t;\n    }\n}\n\n// The index of a pivot for v[0..len] (len >= 8): the median of three\n// elements at 0, 4/8 and 7/8 of it, each of them, from 64 elements, the\n// median of three spread the same way over its eighth (ipnsort's\n// recursive pseudo-median, which samples about n^0.53 elements).\nunsafe fn choose_pivot_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, is_less: F) -> i64 {\n    var f = is_less;\n    let n8 = len / 8;\n    let a = 0;\n    let b = n8 * 4;\n");
        buf_str(out, c"    let c = n8 * 7;\n    if n8 < 8 {\n        return median3_raw(v, a, b, c, f);\n    }\n    if n8 < 64 {\n        let m = n8 / 8;\n        let x = median3_raw(v, a, a + m * 4, a + m * 7, f);\n        let y = median3_raw(v, b, b + m * 4, b + m * 7, f);\n        let z = median3_raw(v, c, c + m * 4, c + m * 7, f);\n        return median3_raw(v, x, y, z, f);\n    }\n    median3_rec_raw(v, n8, f)\n}\n\n// The pseudo-median of v for n = len / 8 >= 64, on an explicit stack of\n// frames (positions x, y, z, their spread n, the children done and their\n// medians): a frame with n >= 8 replaces each position by the median of\n// a frame over its eighth. The depth is log8(len) <= 21.\nunsafe fn median3_rec_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, is_less: F) -> i64 {\n    var f = is_less;\n    var pos: [i64; 72] = [0; 72];\n    var res: [i64; 72] = [0; 72];\n    var spread: [i64; 24] = [0; 24];\n    var done: [i64; 24] = [0; 24];\n    var d = 0;\n    pos[0] = 0;\n    pos[1] = n * 4;\n    pos[2] = n * 7;\n    spread[0] = n;\n    // (each frame is visited once per child and once more: fewer rounds\n    // than 4n + 4 for any n)\n    var result = 0;\n    for _ in 0..4 * n + 4 {\n        let k = done[d];\n        if spread[d] < 8 || k == 3 {\n            result = if spread[d] < 8 {\n                median3_raw(v, pos[3 * d], pos[3 * d + 1], pos[3 * d + 2], f)\n            } else {\n                median3_raw(v, res[3 * d], res[3 * d + 1], res[3 * d + 2], f)\n            };\n            if d == 0 {\n                return result;\n            }\n            d -= 1;\n            res[3 * d + done[d]] = result;\n            done[d] += 1;\n            continue;\n        }\n        let p = pos[3 * d + k];\n        let m = spread[d] / 8;\n        d += 1;\n        pos[3 * d] = p;\n        pos[3 * d + 1] = p + m * 4;\n        pos[3 * d + 2] = p + m * 7;\n        spread[d] = m;\n        done[d] = 0;\n    }\n    result\n}\n\n");
        buf_str(out, c"// The index of the median of v[a], v[b], v[c], with no branch on the\n// comparisons (three of them, always).\n#[inline]\nunsafe fn median3_raw<T,\n    F: FnMut(let T, let T) -> bool>(v: *T, a: i64, b: i64, c: i64, is_less: F) -> i64 {\n    var f = is_less;\n    let x = f(*(&v[a]), *(&v[b]));\n    let y = f(*(&v[a]), *(&v[c]));\n    let z = f(*(&v[b]), *(&v[c]));\n    // x == y: v[a] is the least or the greatest, and the median is the\n    // greater of v[b], v[c] (x) or the lesser (!x)\n    let bc = if z != x { c } else { b };\n    if x == y { bc } else { a }\n}\n\n// The sorts' scratch on the stack: 4 KB, 16-aligned, written before it is\n// read (bytes, not elements: nothing in it is ever dropped).\n#[repr(C, align(16))]\nstruct SortStackBuf { words: [u64; 512] }\n\n// How many elements of T fit in a SortStackBuf (0 for an alignment over\n// 16, or a T of no size).\nfn sort_stack_cap<T>() -> i64 {\n    if align_of(T) <= 16 && size_of(T) > 0 { 4096 / size_of(T) } else { 0 }\n}\n\n// Rotates v[0..n] left by k (0 <= k <= n): v[k..n] then v[0..k], by\n// three reversals.\nunsafe fn rotate_raw<T>(v: *T, n: i64, k: i64) {\n    if k == 0 || k == n {\n        return;\n    }\n    reverse_raw(v, k);\n    reverse_raw(&v[k], n - k);\n    reverse_raw(v, n);\n}\n// ---- mod std::slice::unstable ----\nmod unstable {\n// std::slice::unstable: the unstable sort, ipnsort (0.20).\n\nuse std::{Ord, forget};\nuse super::{\n    SortStackBuf, choose_pivot_raw, existing_run_raw, insertion_sort_raw, reverse_raw,\n    small_sort_network_raw, small_sort_raw, sort_stack_cap,\n};\n\n// ---- Sort, unstable (0.20) ----\n\n// The unstable sort (0.20; docs/design/collections-text-io.md §2.4.6),\n// after Rust's ipnsort: a slice that is one run, ascending or strictly\n// descending, costs n - 1 comparisons; otherwise a quicksort with the\n// small sort (Sort kernels) up to 32 elements, a branchless cyclic Lomuto\n// partition, the median of three as the pivot (a recursive pseudo-median\n");
        buf_str(out, c"// from 64 elements), heapsort below a depth of 2·log2(n), and a partition\n// that puts the elements equal to the pivot in place at once when the\n// pivot is no greater than the one before it, so that input with k\n// distinct values costs O(n log k).\n//\n// Unsafe code: the kernels work on a raw pointer `v` and a length `n`\n// taken from one slice (`s.ptr`, `s.len`, by the safe entry points). Each\n// index they form lies in 0..n by the loop bounds noted at it, whatever\n// the comparator answers: a comparator that is not a total order leaves\n// the slice a permutation of what it held, in some order, and never reads\n// or writes outside it. Elements move as bits, so any T sorts, owned\n// ones too: an element read out through the pointer (the lifted one, the\n// one in transit) is written back exactly once, and a copy kept only to\n// compare with (the pivot) is forgotten, never dropped; raw writes drop\n// nothing. Nothing unwinds: a comparator that panics ends the process, so\n// a slice caught mid-partition (an element in two places, one in none) is\n// never observed and no drop runs twice. No loop is uncounted and nothing\n// recurses: the sorts do not have the effect diverge.\n\n// Slices up to this long are sorted by the small sort.\nconst SORT_UNSTABLE_SMALL: i64 = 32;\n\n// Sorts s in place, smallest first; not stable (equal elements may change\n// order). Rust's `sort_unstable`.\npub fn sort_unstable<T: Ord>(s: inout [T]) {\n    sort_unstable_less(s, |a: T, b: T| a < b);\n}\n\n// Sorts s in place by f (`f(a, b)` negative, zero or positive as *a goes\n// before, with or after *b); not stable.\npub fn sort_unstable_by<T, F: FnMut(let T, let T) -> i64>(s: inout [T], f: F) {\n    var g = f;\n    sort_unstable_less(s, |a: T, b: T| g(a, b) < 0);\n}\n\n// Sorts s in place by the key f gives each element, smallest first; not\n// stable. f runs on both sides of every comparison.\n");
        buf_str(out, c"pub fn sort_unstable_by_key<T, K: Ord, F: FnMut(let T) -> K>(s: inout [T], f: F) {\n    var g = f;\n    sort_unstable_less(s, |a: T, b: T| g(a) < g(b));\n}\n\n// Sorts s in place by is_less (`is_less(a, b)`: *a goes strictly before\n// *b); not stable. The core the other unstable sorts call.\npub fn sort_unstable_less<T, F: FnMut(let T, let T) -> bool>(s: inout [T], is_less: F) {\n    let n = s.len;\n    if n < 2 {\n        return;\n    }\n    // (s.ptr and s.len are one slice's)\n    unsafe {\n        ipnsort_raw(s.ptr, n, is_less);\n    }\n}\n\n// v[0..n], n >= 2.\nunsafe fn ipnsort_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, is_less: F) {\n    var f = is_less;\n    if n <= SORT_UNSTABLE_SMALL {\n        var buf: SortStackBuf = SortStackBuf { words: [0; 512] };\n        if sort_stack_cap::<T>() >= n + 16 {\n            small_sort_raw(v, n, &buf as *T, f);\n        } else {\n            insertion_sort_raw(v, n, 1, f);\n        }\n        return;\n    }\n    let (run, desc) = existing_run_raw(v, n, f);\n    if run == n {\n        if desc {\n            reverse_raw(v, n);\n        }\n        return;\n    }\n    // 2·log2(n) levels of partitions before heapsort\n    var limit = 0;\n    for k in 1..63 {\n        if (n >> k) == 0 {\n            break;\n        }\n        limit += 2;\n    }\n    quicksort_raw(v, n, limit, f);\n}\n\n// Sorts v[0..n] by heapsort: O(n log n) whatever the input.\nunsafe fn heapsort_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, is_less: F) {\n    var f = is_less;\n    for k in 0..n / 2 {\n        sift_down_raw(v, n / 2 - 1 - k, n, f);\n    }\n    for k in 1..n {\n        let end = n - k;\n        let t = v[0];\n        v[0] = v[end];\n        v[end] = t;\n        sift_down_raw(v, 0, end, f);\n    }\n}\n\n// Moves v[node] down the max-heap v[0..end] (node < end).\n// (the node's index at least doubles each round: 64 at most)\nunsafe fn sift_down_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, node: i64, end: i64, is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n    var at = node;\n    for _ in 0..64 {\n        var child = 2 * at + 1;\n        if child >= end {\n            return;\n        }\n        if child + 1 < end {\n            child += f(*(&v[child]), *(&v[child + 1])) as i64;\n        }\n        if !f(*(&v[at]), *(&v[child])) {\n            return;\n        }\n        let t = v[at];\n        v[at] = v[child];\n        v[child] = t;\n        at = child;\n    }\n}\n\n// The quicksort of v[0..n] (n > SORT_UNSTABLE_SMALL). The ranges left to\n// sort are kept on a stack, not recursion: the shorter side of each\n// partition is sorted next and the longer kept, so at most log2(n) <= 63\n// are kept at once. A range's ancestor pivot, when it has one, is the\n// element just before it (it was placed by the partition that made the\n// range).\nunsafe fn quicksort_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, limit0: i64, is_less: F) {\n    var f = is_less;\n    // (the small sort.s scratch)\n    var buf: SortStackBuf = SortStackBuf { words: [0; 512] };\n    let sp = &buf as *T;\n    let cap = sort_stack_cap::<T>();\n    var kept_lo: [i64; 64] = [0; 64];\n    var kept_hi: [i64; 64] = [0; 64];\n    var kept_limit: [i64; 64] = [0; 64];\n    var kept_anc: [bool; 64] = [false; 64];\n    var kept = 0;\n    var lo = 0;\n    var hi = n;\n    var limit = limit0;\n    var anc = false;\n    // (each round places a pivot or finishes a range: 2n + 1 at most)\n    for _ in 0..2 * n + 2 {\n        let len = hi - lo;\n        if len <= SORT_UNSTABLE_SMALL || limit == 0 {\n            if len <= SORT_UNSTABLE_SMALL {\n                // (size_of is a constant: one of the two is compiled)\n                if len < 2 {\n                    // (nothing to sort; v[lo] may be past the end)\n                } else if cap < len + 16 {\n                    insertion_sort_raw(&v[lo], len, 1, f);\n                } else if size_of(T) <= 8 {\n                    small_sort_network_raw(&v[lo], len, sp, f);\n");
        buf_str(out, c"                } else {\n                    small_sort_raw(&v[lo], len, sp, f);\n                }\n            } else {\n                heapsort_raw(&v[lo], len, f);\n            }\n            if kept == 0 {\n                return;\n            }\n            kept -= 1;\n            lo = kept_lo[kept];\n            hi = kept_hi[kept];\n            limit = kept_limit[kept];\n            anc = kept_anc[kept];\n            continue;\n        }\n        limit -= 1;\n        let w: *T = &v[lo];\n        let p = choose_pivot_raw(w, len, f);\n        // A pivot no greater than the ancestor (which is no greater than\n        // anything here) equals it: the elements equal to it go left, in\n        // place, and only the greater ones are left to sort.\n        if anc && !f(*(&v[lo - 1]), *(&w[p])) {\n            let num_le = partition_raw(w, len, p, |a: T, b: T| !f(b, a));\n            lo += num_le + 1;\n            anc = false;\n            continue;\n        }\n        let num_lt = partition_raw(w, len, p, f);\n        let mid = lo + num_lt;\n        if kept == 64 {\n            // (not reached: see above)\n            heapsort_raw(w, len, f);\n            hi = lo;\n            continue;\n        }\n        // [lo, mid) keeps the ancestor; [mid + 1, hi) has v[mid]\n        kept_limit[kept] = limit;\n        if mid - lo < hi - mid - 1 {\n            kept_lo[kept] = mid + 1;\n            kept_hi[kept] = hi;\n            kept_anc[kept] = true;\n            hi = mid;\n        } else {\n            kept_lo[kept] = lo;\n            kept_hi[kept] = mid;\n            kept_anc[kept] = anc;\n            lo = mid + 1;\n            anc = true;\n        }\n        kept += 1;\n    }\n}\n\n// Partitions v[0..len] around v[p] (len >= 1): the elements for which\n// is_less(x, pv) first, then the pivot, then the others. Returns the\n// pivot's new index, the number of the first kind.\nunsafe fn partition_raw<T,\n");
        buf_str(out, c"    F: FnMut(let T, let T) -> bool>(v: *T, len: i64, p: i64, is_less: F) -> i64 {\n    let t = v[0];\n    v[0] = v[p];\n    v[p] = t;\n    let pivot = v[0];\n    let num_lt = lomuto_cyclic_raw(&v[1], len - 1, &pivot, is_less);\n    // (a copy of the element at v[0]: not dropped here)\n    forget(pivot);\n    let u = v[0];\n    v[0] = v[num_lt];\n    v[num_lt] = u;\n    num_lt\n}\n\n// The branchless cyclic Lomuto partition of v[0..len] around *pivot\n// (ipnsort's): v[0] is lifted out, leaving a gap; each step moves the\n// element at the boundary into the gap and the next element onto the\n// boundary, which advances when that element is less than the pivot.\n// No branch depends on the comparison. Returns how many are less.\n// (num_lt <= gap < right < len throughout; not inlined: the loop gets\n// the registers to itself)\n#[inline(never)]\nunsafe fn lomuto_cyclic_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, pivot_at: *T,\n    is_less: F) -> i64 {\n    var f = is_less;\n    if len == 0 {\n        return 0;\n    }\n    // (a local copy: the stores below cannot change it, so it stays in a\n    // register)\n    let pv = *pivot_at;\n    let lifted = v[0];\n    // The gap is always just before `right` (v[0] at first).\n    var num_lt = 0;\n    var right = 1;\n    // Four steps a round, through a pointer to the first (its loads and\n    // stores at fixed offsets), then the rest.\n    for _ in 0..(len - 1) / 4 {\n        let src: *T = &v[right];\n        let x0 = src[0];\n        let l0 = f(x0, pv);\n        let at0 = num_lt;\n        num_lt += l0 as i64;\n        src[-1] = v[at0];\n        v[at0] = x0;\n        let x1 = src[1];\n        let l1 = f(x1, pv);\n        let at1 = num_lt;\n        num_lt += l1 as i64;\n        src[0] = v[at1];\n        v[at1] = x1;\n        let x2 = src[2];\n        let l2 = f(x2, pv);\n        let at2 = num_lt;\n        num_lt += l2 as i64;\n        src[1] = v[at2];\n        v[at2] = x2;\n        let x3 = src[3];\n");
        buf_str(out, c"        let l3 = f(x3, pv);\n        let at3 = num_lt;\n        num_lt += l3 as i64;\n        src[2] = v[at3];\n        v[at3] = x3;\n        right += 4;\n    }\n    for _ in right..len {\n        let x = v[right];\n        let lt = f(x, pv);\n        let at = num_lt;\n        num_lt += lt as i64;\n        v[right - 1] = v[at];\n        v[at] = x;\n        right += 1;\n    }\n    // The lifted element closes the gap, v[len - 1].\n    let lt = f(lifted, pv);\n    v[len - 1] = v[num_lt];\n    v[num_lt] = lifted;\n    // (pv copies the pivot, which stays where it is: not dropped here)\n    forget(pv);\n    num_lt + lt as i64\n}\n\n// Reorders s so that s[k] is the element a sort would put there, those\n// before it no greater and those after no less (k < s.len, checked). Not\n// stable. Rust's `select_nth_unstable`.\npub fn select_nth_unstable<T: Ord>(s: inout [T], k: i64) {\n    select_nth_unstable_less(s, k, |a: T, b: T| a < b);\n}\n\n// select_nth_unstable by f, a comparator returning a sign (sort_by's).\npub fn select_nth_unstable_by<T, F: FnMut(let T, let T) -> i64>(s: inout [T], k: i64, f: F) {\n    var g = f;\n    select_nth_unstable_less(s, k, |a: T, b: T| g(a, b) < 0);\n}\n\n// select_nth_unstable on the key f gives each element.\npub fn select_nth_unstable_by_key<T, K: Ord, F: FnMut(let T) -> K>(s: inout [T], k: i64, f: F) {\n    var g = f;\n    select_nth_unstable_less(s, k, |a: T, b: T| g(a) < g(b));\n}\n\n// select_nth_unstable by is_less: introselect, Rust's (the unstable sort's\n// pivots and partition on the side holding k, insertion sort from 16\n// elements down); after 16 poor pivots, the unstable sort of what is left\n// (O(n log n) at worst, where Rust's median of medians is O(n)).\npub fn select_nth_unstable_less<T,\n    F: FnMut(let T, let T) -> bool>(s: inout [T], k: i64, is_less: F) {\n    let n = s.len;\n    // (the check: s[k] panics unless 0 <= k < n)\n    let _ = &s[k];\n    // (s.ptr and s.len are one slice's, k < n)\n    unsafe {\n");
        buf_str(out, c"        select_raw(s.ptr, n, k, is_less);\n    }\n}\n\nunsafe fn select_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, k: i64, is_less: F) {\n    var f = is_less;\n    if k == 0 || k == n - 1 {\n        // The least (or greatest) to its end, in one pass.\n        var at = 0;\n        for i in 1..n {\n            let better = if k == 0 { f(*(&v[i]), *(&v[at])) } else { !f(*(&v[i]), *(&v[at])) };\n            at = if better { i } else { at };\n        }\n        let t = v[at];\n        v[at] = v[k];\n        v[k] = t;\n        return;\n    }\n    var lo = 0;\n    var hi = n;\n    var limit = 16;\n    var anc = false;\n    // (each round shrinks the range by its pivot at least)\n    for _ in 0..n + 1 {\n        let len = hi - lo;\n        if len <= 16 {\n            if len >= 2 {\n                insertion_sort_raw(&v[lo], len, 1, f);\n            }\n            return;\n        }\n        if limit == 0 {\n            ipnsort_raw(&v[lo], len, f);\n            return;\n        }\n        limit -= 1;\n        let w: *T = &v[lo];\n        let p = choose_pivot_raw(w, len, f);\n        if anc && !f(*(&v[lo - 1]), *(&w[p])) {\n            // all of w[0..=num_le] equal the pivot\n            let num_le = partition_raw(w, len, p, |a: T, b: T| !f(b, a));\n            if lo + num_le >= k {\n                return;\n            }\n            lo += num_le + 1;\n            anc = false;\n            continue;\n        }\n        let mid = lo + partition_raw(w, len, p, f);\n        if mid < k {\n            lo = mid + 1;\n            anc = true;\n        } else if mid > k {\n            hi = mid;\n        } else {\n            return;\n        }\n    }\n}\n// ---- end mod std::slice::unstable ----\n}\n// ---- mod std::slice::stable ----\nmod stable {\n// std::slice::stable: the stable sort, driftsort (0.20).\n\nuse std::{Ord, forget, memcpy, needs_drop};\nuse std::num::leading_zeros;\nuse super::{\n");
        buf_str(out, c"    SortStackBuf, choose_pivot_raw, existing_run_raw, insertion_sort_raw, reverse_raw, rotate_raw,\n    small_sort_raw, sort_stack_cap,\n};\n\n// ---- Sort, stable (0.20) ----\n\n// The stable sort (0.20; docs/design/collections-text-io.md §2.4.6), after\n// Rust's driftsort: the slice is cut into runs, which are merged in\n// powersort's order (the depth of each boundary in the merge tree of the\n// run midpoints). A run is a natural one when the input has one of\n// sqrt(n) elements or more there (ascending, or strictly descending and\n// reversed); elsewhere a run of sqrt(n) elements is left unsorted, and\n// two neighbouring unsorted runs merge by just becoming one, as long as\n// it fits in the scratch. An unsorted run is sorted when it must be\n// merged with a sorted one, or at the end, by a stable quicksort: a\n// branchless partition through the scratch, the elements equal to the\n// pivot put in place at once when it is the least (O(n log k) for k\n// distinct values), the small sort (Sort kernels) up to 32 elements, and\n// the merge sort below a depth of 2·log2(n). A merge copies its shorter\n// side into the scratch and merges with no branch on the comparisons.\n//\n// Scratch: `sort_stable_scratch_len(n)` elements (n up to 8 MB, then\n// n / 2) give the full speed; with less (the 4 KB of the slice form), a\n// merge whose shorter side does not fit is split by binary searches and\n// rotations until its pieces do, in place (O(n log² n) at worst), and\n// only runs that fit are sorted by quicksort.\n//\n// Unsafe code: as the unstable sort's (Sort, unstable). The scratch is\n// slots of T that are written before they are read; it never overlaps\n// the slice, and holds bit copies only (bytes, or an allocator's block\n// whose Vec keeps length 0): nothing in it is ever dropped, and every\n// element ends up in the slice exactly once, whatever the comparator\n// answers (a merge that finds no total order copies the scratch back).\n");
        buf_str(out, c"// Elements of a type with a drop keep no ancestor copies\n// (stable_quicksort_plain_raw). Nothing recurses: the merge sort the quicksort falls back\n// on is a separate function (drift_eager_raw) that never sorts by\n// quicksort.\n\n// Sorts s in place, smallest first, keeping equal elements in the order\n// they had, with no allocation: the scratch is 4 KB on the stack, and\n// larger merges are done in place (slower: `sort_stable_in` takes an\n// allocator for the scratch).\npub fn sort_stable_noalloc<T: Ord>(s: inout [T]) {\n    sort_stable_less(s, |a: T, b: T| a < b);\n}\n\n// Sorts s stably by is_less (`is_less(a, b)`: *a goes strictly before\n// *b) with a 4 KB scratch on the stack (`sort_stable_noalloc`).\npub fn sort_stable_less<T, F: FnMut(let T, let T) -> bool>(s: inout [T], is_less: F) {\n    let n = s.len;\n    if n < 2 || size_of(T) == 0 {\n        return;\n    }\n    var buf: SortStackBuf = SortStackBuf { words: [0; 512] };\n    let cap = sort_stack_cap::<T>();\n    // (s.ptr and s.len are one slice's; the buffer has cap slots and is\n    // not s)\n    unsafe {\n        sort_stable_raw(s.ptr, n, &buf as *T, cap, is_less);\n    }\n}\n\n// Sorts s stably by is_less, with scratch[0..scratch_len]\n// (`sort_stable_scratch_len(s.len)` for the full speed; any length\n// works). The caller promises that scratch points to scratch_len slots\n// of T it owns, outside s; their contents are overwritten.\npub unsafe fn sort_stable_less_with<T, F: FnMut(let T, let T) -> bool>(s: inout [T], scratch: *T,\n    scratch_len: i64, is_less: F) {\n    if s.len < 2 || size_of(T) == 0 {\n        return;\n    }\n    sort_stable_raw(s.ptr, s.len, scratch, scratch_len, is_less);\n}\n\n// The scratch the stable sort wants for n elements of T: all n up to\n// 8 MB, n / 2 beyond (driftsort's), and at least 48 (the small sort's).\npub fn sort_stable_scratch_len<T>(n: i64) -> i64 {\n    let full = if size_of(T) == 0 { n } else { 8000000 / size_of(T) };\n    var len = n - n / 2;\n");
        buf_str(out, c"    if len < n && n <= full {\n        len = n;\n    } else if len < full && full < n {\n        len = full;\n    }\n    if len < 48 { 48 } else { len }\n}\n\n// v[0..n] (n >= 2), scratch[0..cap].\nunsafe fn sort_stable_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, scratch: *T, cap: i64,\n    is_less: F) {\n    var f = is_less;\n    if n <= 20 {\n        insertion_sort_raw(v, n, 1, f);\n        return;\n    }\n    // Short slices: a small sort or two and a merge beat the quicksort.\n    if n <= 64 {\n        drift_eager_raw(v, n, scratch, cap, f);\n        return;\n    }\n    drift_lazy_raw(v, n, scratch, cap, f);\n}\n\n// The runs of 32 the merge sort makes where the input has none.\nconst SORT_STABLE_RUN: i64 = 32;\n\n// sqrt(n) roughly: 2^((1 + floor(log2 n)) / 2), then a Newton step.\nfn sort_sqrt_approx(n: i64) -> i64 {\n    var lg = 0;\n    for k in 1..63 {\n        if ((n | 1) >> k) == 0 {\n            break;\n        }\n        lg += 1;\n    }\n    let shift = (1 + lg) / 2;\n    ((1 << shift) + (n >> shift)) / 2\n}\n\n// The natural runs a merge takes as they are: sqrt(n) long at least\n// (from 4096 elements; below, 64 or half the slice).\nfn sort_min_good_run(n: i64) -> i64 {\n    if n <= 64 * 64 {\n        if n - n / 2 < 64 { n - n / 2 } else { 64 }\n    } else {\n        sort_sqrt_approx(n)\n    }\n}\n\n// The depth in the merge tree of the boundary between the runs\n// [left, mid) and [mid, right) (powersort's node power, with scale =\n// 2^62 / n rounded up).\nfn sort_merge_depth(left: i64, mid: i64, right: i64, scale: u64) -> i64 {\n    let x = (left + mid) as u64;\n    let y = (mid + right) as u64;\n    leading_zeros((scale * x) ^ (scale * y))\n}\n\n// Driftsort with lazy runs, v[0..n] (n >= 2): unsorted runs of sqrt(n)\n// are sorted by the stable quicksort when they meet a sorted one or\n// grow past the scratch.\nunsafe fn drift_lazy_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, scratch: *T, cap: i64,\n    is_less: F) {\n");
        buf_str(out, c"    var f = is_less;\n    let scale = ((1u64 << 62) + n as u64 - 1u64) / n as u64;\n    let min_good = sort_min_good_run(n);\n    // The stack of runs below the previous one; boundary depths increase\n    // up it (below 64), so it holds 65 runs at most and a first, empty\n    // one.\n    var run_len: [i64; 66] = [0; 66];\n    var run_sorted: [bool; 66] = [false; 66];\n    var run_depth: [i64; 66] = [0; 66];\n    var kept = 0;\n    var prev_len = 0;\n    var prev_sorted = true;\n    var scan = 0;\n    // (each round takes a run of at least 1: n + 1 rounds at most)\n    for _ in 0..n + 2 {\n        var next_len = 0;\n        var next_sorted = true;\n        var depth = 0;\n        if scan < n {\n            // A natural run long enough, else an unsorted one.\n            let rest = n - scan;\n            next_len = if rest < min_good { rest } else { min_good };\n            next_sorted = false;\n            if rest >= min_good {\n                let (run, desc) = existing_run_raw(&v[scan], rest, f);\n                if run >= min_good {\n                    if desc {\n                        reverse_raw(&v[scan], run);\n                    }\n                    next_len = run;\n                    next_sorted = true;\n                }\n            }\n            depth = sort_merge_depth(scan - prev_len, scan, scan + next_len, scale);\n        }\n        for _ in 0..66 {\n            if kept <= 1 || run_depth[kept - 1] < depth {\n                break;\n            }\n            let left = run_len[kept - 1];\n            let left_sorted = run_sorted[kept - 1];\n            let merged = left + prev_len;\n            let w: *T = &v[scan - merged];\n            // Two unsorted runs that fit in the scratch just join; else\n            // each is sorted and they are merged.\n            if merged > cap || left_sorted || prev_sorted {\n                if !left_sorted {\n                    stable_quicksort_raw(w, left, scratch, cap, f);\n                }\n");
        buf_str(out, c"                if !prev_sorted {\n                    stable_quicksort_raw(&w[left], prev_len, scratch, cap, f);\n                }\n                merge_any_raw(w, merged, left, scratch, cap, f);\n                prev_sorted = true;\n            } else {\n                prev_sorted = false;\n            }\n            prev_len = merged;\n            kept -= 1;\n        }\n        if kept == 66 {\n            // (not reached: see above)\n            return;\n        }\n        run_len[kept] = prev_len;\n        run_sorted[kept] = prev_sorted;\n        run_depth[kept] = depth;\n        kept += 1;\n        if scan >= n {\n            break;\n        }\n        scan += next_len;\n        prev_len = next_len;\n        prev_sorted = next_sorted;\n    }\n    if !prev_sorted {\n        stable_quicksort_raw(v, n, scratch, cap, f);\n    }\n}\n\n// Driftsort with eager runs (no quicksort): v[0..n] (n >= 2), every run\n// sorted when it is made, then merged. The stable quicksort's fallback.\nunsafe fn drift_eager_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, scratch: *T, cap: i64,\n    is_less: F) {\n    var f = is_less;\n    let scale = ((1u64 << 62) + n as u64 - 1u64) / n as u64;\n    let min_good = sort_min_good_run(n);\n    var run_len: [i64; 66] = [0; 66];\n    var run_depth: [i64; 66] = [0; 66];\n    var kept = 0;\n    var prev_len = 0;\n    var scan = 0;\n    for _ in 0..n + 2 {\n        var next_len = 0;\n        var depth = 0;\n        if scan < n {\n            next_len = eager_run_raw(&v[scan], n - scan, min_good, scratch, cap, f);\n            depth = sort_merge_depth(scan - prev_len, scan, scan + next_len, scale);\n        }\n        for _ in 0..66 {\n            if kept <= 1 || run_depth[kept - 1] < depth {\n                break;\n            }\n            let left = run_len[kept - 1];\n            let merged = left + prev_len;\n            merge_any_raw(&v[scan - merged], merged, left, scratch, cap, f);\n            prev_len = merged;\n");
        buf_str(out, c"            kept -= 1;\n        }\n        if kept == 66 {\n            return;\n        }\n        run_len[kept] = prev_len;\n        run_depth[kept] = depth;\n        kept += 1;\n        if scan >= n {\n            return;\n        }\n        scan += next_len;\n        prev_len = next_len;\n    }\n}\n\n// Makes a sorted run at the start of v[0..n] (n >= 1) and returns its\n// length: the natural run there when it has min_good elements or more,\n// else the first SORT_STABLE_RUN (or n) sorted by the small sort.\nunsafe fn eager_run_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, min_good: i64,\n    scratch: *T, cap: i64, is_less: F) -> i64 {\n    var f = is_less;\n    if n >= min_good && n >= 2 {\n        let (run, desc) = existing_run_raw(v, n, f);\n        if run >= min_good {\n            if desc {\n                reverse_raw(v, run);\n            }\n            return run;\n        }\n    }\n    let len = if n < SORT_STABLE_RUN { n } else { SORT_STABLE_RUN };\n    stable_small_sort_raw(v, len, scratch, cap, f);\n    len\n}\n\n// Sorts v[0..len] (len <= 32) stably: the small sort when the scratch has\n// its len + 16 slots, else insertion sort.\n#[inline]\nunsafe fn stable_small_sort_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, scratch: *T,\n    cap: i64, is_less: F) {\n    var f = is_less;\n    if len < 2 {\n        return;\n    }\n    if cap >= len + 16 {\n        small_sort_raw(v, len, scratch, f);\n    } else {\n        insertion_sort_raw(v, len, 1, f);\n    }\n}\n\n// The stable quicksort of v[0..n] (n <= cap). The left side of each\n// partition is sorted next and the right side kept; every partition\n// lowers the depth left (2·log2(n) <= 126), so at most 126 are kept.\n// A range's ancestor is the pivot of the partition that made it its\n// right side (a copy: the partition moves elements); when a new pivot is\n// no greater than it, the pivot equals the least elements, which go left\n");
        buf_str(out, c"// in place, and only the greater ones are left to sort (also when nothing\n// is less than the pivot). Elements over 128 bytes keep no copies: only\n// the second way applies.\nunsafe fn stable_quicksort_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, scratch: *T,\n    cap: i64, is_less: F) {\n    var f = is_less;\n    if size_of(T) > 128 || needs_drop::<T>() {\n        stable_quicksort_plain_raw(v, n, scratch, cap, f);\n        return;\n    }\n    var kept_lo: [i64; 128] = [0; 128];\n    var kept_hi: [i64; 128] = [0; 128];\n    var kept_limit: [i64; 128] = [0; 128];\n    var kept_has_anc: [bool; 128] = [false; 128];\n    var kept_anc: [T; 128] = [v[0]; 128];\n    var kept = 0;\n    var limit = 0;\n    for k in 1..63 {\n        if ((n | 1) >> k) == 0 {\n            break;\n        }\n        limit += 2;\n    }\n    var lo = 0;\n    var hi = n;\n    var anc = v[0];\n    var has_anc = false;\n    // (each round finishes a range, or partitions one into two shorter\n    // ones or puts some of it in place: 2n + 2 rounds at most)\n    for _ in 0..2 * n + 2 {\n        let len = hi - lo;\n        if len <= SORT_STABLE_RUN || limit == 0 || len > cap || kept == 128 {\n            if len <= SORT_STABLE_RUN {\n                if len >= 2 {\n                    stable_small_sort_raw(&v[lo], len, scratch, cap, f);\n                }\n            } else {\n                drift_eager_raw(&v[lo], len, scratch, cap, f);\n            }\n            if kept == 0 {\n                return;\n            }\n            kept -= 1;\n            lo = kept_lo[kept];\n            hi = kept_hi[kept];\n            limit = kept_limit[kept];\n            has_anc = kept_has_anc[kept];\n            anc = kept_anc[kept];\n            continue;\n        }\n        limit -= 1;\n        let w: *T = &v[lo];\n        let p = choose_pivot_raw(w, len, f);\n        let pv = w[p];\n        var num_lt = 0;\n        let equal = has_anc && !f(anc, pv);\n        if !equal {\n");
        buf_str(out, c"            num_lt = stable_partition_raw(w, len, scratch, p, false, f);\n        }\n        if equal || num_lt == 0 {\n            // (nothing moved when num_lt == 0: v[p] is still the pivot)\n            let num_le = stable_partition_raw(w, len, scratch, p, true, |a: T, b: T| !f(b, a));\n            lo += num_le;\n            has_anc = false;\n            continue;\n        }\n        kept_lo[kept] = lo + num_lt;\n        kept_hi[kept] = hi;\n        kept_limit[kept] = limit;\n        kept_has_anc[kept] = true;\n        kept_anc[kept] = pv;\n        kept += 1;\n        hi = lo + num_lt;\n    }\n}\n\n// The stable quicksort without ancestor copies (elements over 128 bytes).\nunsafe fn stable_quicksort_plain_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, n: i64, scratch: *T,\n    cap: i64, is_less: F) {\n    var f = is_less;\n    var kept_lo: [i64; 128] = [0; 128];\n    var kept_hi: [i64; 128] = [0; 128];\n    var kept_limit: [i64; 128] = [0; 128];\n    var kept = 0;\n    var limit = 0;\n    for k in 1..63 {\n        if ((n | 1) >> k) == 0 {\n            break;\n        }\n        limit += 2;\n    }\n    var lo = 0;\n    var hi = n;\n    for _ in 0..2 * n + 2 {\n        let len = hi - lo;\n        if len <= SORT_STABLE_RUN || limit == 0 || len > cap || kept == 128 {\n            if len <= SORT_STABLE_RUN {\n                if len >= 2 {\n                    stable_small_sort_raw(&v[lo], len, scratch, cap, f);\n                }\n            } else {\n                drift_eager_raw(&v[lo], len, scratch, cap, f);\n            }\n            if kept == 0 {\n                return;\n            }\n            kept -= 1;\n            lo = kept_lo[kept];\n            hi = kept_hi[kept];\n            limit = kept_limit[kept];\n            continue;\n        }\n        limit -= 1;\n        let w: *T = &v[lo];\n        let p = choose_pivot_raw(w, len, f);\n        let num_lt = stable_partition_raw(w, len, scratch, p, false, f);\n        if num_lt == 0 {\n");
        buf_str(out, c"            let num_le = stable_partition_raw(w, len, scratch, p, true, |a: T, b: T| !f(b, a));\n            lo += num_le;\n            continue;\n        }\n        kept_lo[kept] = lo + num_lt;\n        kept_hi[kept] = hi;\n        kept_limit[kept] = limit;\n        kept += 1;\n        hi = lo + num_lt;\n    }\n}\n\n// Partitions v[0..len] stably around the pivot v[p] (len <= the scratch's\n// length): the elements x with is_less(x, pv) first, then the others,\n// each side in its old order; the pivot itself goes left when\n// pivot_goes_left. Returns how many went left. Each element is copied\n// into the scratch, to the front for the left side and to the back\n// (reversed) for the right, with no branch on the comparison, then both\n// are copied back. (at step i: left slots num_left <= i, right slots\n// len - 1 - (i - num_left) <= len - 1)\nunsafe fn stable_partition_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, scratch: *T,\n    p: i64, pivot_goes_left: bool, is_less: F) -> i64 {\n    var f = is_less;\n    let pv = v[p];\n    // (the right side's base: element i goes to rev[num_left], rev being\n    // &scratch[len - 1 - i])\n    let rev: *T = &scratch[len - 1];\n    var num_left = stable_partition_scan_raw(v, 0, p, scratch, rev, 0, &pv, f);\n    let pivot_at = if pivot_goes_left { num_left } else { len - 1 - p + num_left };\n    num_left += pivot_goes_left as i64;\n    num_left = stable_partition_scan_raw(v, p + 1, len, scratch, &rev[-(p + 1)], num_left, &pv, f);\n    // (the pivot last: the scans compared with it)\n    scratch[pivot_at] = pv;\n    copy_raw(v, scratch, num_left);\n    for i in 0..len - num_left {\n        v[num_left + i] = scratch[len - 1 - i];\n    }\n    num_left\n}\n\n// stable_partition_raw's scan of v[from..to], with rev the right side's\n// base for element `from` and num_left so far; returns num_left after.\n// Four steps a round, then the rest.\n#[inline]\n");
        buf_str(out, c"unsafe fn stable_partition_scan_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, from: i64, to: i64,\n    scratch: *T, rev0: *T, num_left0: i64, pivot_at: *T, is_less: F) -> i64 {\n    var f = is_less;\n    let pv = *pivot_at;\n    var rev = rev0;\n    var num_left = num_left0;\n    var i = from;\n    for _ in 0..(to - from) / 4 {\n        let src: *T = &v[i];\n        let x0 = src[0];\n        let l0 = f(x0, pv);\n        let b0 = if l0 { scratch } else { rev };\n        let at = num_left;\n        num_left += l0 as i64;\n        b0[at] = x0;\n        let x1 = src[1];\n        let l1 = f(x1, pv);\n        let b1 = if l1 { scratch } else { &rev[-1] };\n        let at = num_left;\n        num_left += l1 as i64;\n        b1[at] = x1;\n        let x2 = src[2];\n        let l2 = f(x2, pv);\n        let b2 = if l2 { scratch } else { &rev[-2] };\n        let at = num_left;\n        num_left += l2 as i64;\n        b2[at] = x2;\n        let x3 = src[3];\n        let l3 = f(x3, pv);\n        let b3 = if l3 { scratch } else { &rev[-3] };\n        let at = num_left;\n        num_left += l3 as i64;\n        b3[at] = x3;\n        rev = &rev[-4];\n        i += 4;\n    }\n    for _ in i..to {\n        let x = v[i];\n        let l = f(x, pv);\n        let b = if l { scratch } else { rev };\n        let at = num_left;\n        num_left += l as i64;\n        b[at] = x;\n        rev = &rev[-1];\n        i += 1;\n    }\n    // (a copy of the pivot, which stays where it is: not dropped here)\n    forget(pv);\n    num_left\n}\n\n// Merges the sorted v[0..mid] and v[mid..len], stably: through the\n// scratch when the shorter side fits in it, else split in place (the\n// halves found by binary search, the middle rotated) into merges that\n// do, kept on a stack.\nunsafe fn merge_any_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, mid: i64, scratch: *T,\n    cap: i64, is_less: F) {\n    var f = is_less;\n    let shorter = if mid < len - mid { mid } else { len - mid };\n");
        buf_str(out, c"    if shorter <= cap {\n        merge_raw(v, len, mid, scratch, f);\n        return;\n    }\n    // Pending merges (lo, mid, hi). A split leaves two merges of at most\n    // 5/6 of its elements each, so the splits nest at most\n    // log(6/5)(2^63) < 240 deep and fewer than 320 are pending at once.\n    var p_lo: [i64; 320] = [0; 320];\n    var p_mid: [i64; 320] = [0; 320];\n    var p_hi: [i64; 320] = [0; 320];\n    p_lo[0] = 0;\n    p_mid[0] = mid;\n    p_hi[0] = len;\n    var pending = 1;\n    // (each round finishes a merge or splits one: far fewer rounds than\n    // this bound)\n    for _ in 0..512 * (len + 1) {\n        if pending == 0 {\n            return;\n        }\n        pending -= 1;\n        let lo = p_lo[pending];\n        let m = p_mid[pending];\n        let hi = p_hi[pending];\n        let l1 = m - lo;\n        let l2 = hi - m;\n        if l1 == 0 || l2 == 0 {\n            continue;\n        }\n        if l1 <= cap || l2 <= cap {\n            merge_raw(&v[lo], hi - lo, l1, scratch, f);\n            continue;\n        }\n        if l1 + l2 == 2 {\n            // (no scratch at all)\n            if f(*(&v[m]), *(&v[lo])) {\n                let t = v[lo];\n                v[lo] = v[m];\n                v[m] = t;\n            }\n            continue;\n        }\n        if pending + 2 > 320 {\n            // (not reached: see above)\n            return;\n        }\n        // Cut the longer side in half; the other side's elements that go\n        // before the cut element are found by binary search.\n        var cut1 = 0;\n        var cut2 = 0;\n        if l1 >= l2 {\n            cut1 = lo + l1 / 2;\n            // the first in v[m..hi] not less than v[cut1]\n            cut2 = m + lower_bound_raw(&v[m], l2, &v[cut1], f);\n        } else {\n            cut2 = m + l2 / 2;\n            // the first in v[lo..m] greater than v[cut2]\n            cut1 = lo + upper_bound_raw(&v[lo], l1, &v[cut2], f);\n        }\n");
        buf_str(out, c"        rotate_raw(&v[cut1], cut2 - cut1, m - cut1);\n        let new_mid = cut1 + (cut2 - m);\n        p_lo[pending] = new_mid;\n        p_mid[pending] = cut2;\n        p_hi[pending] = hi;\n        p_lo[pending + 1] = lo;\n        p_mid[pending + 1] = cut1;\n        p_hi[pending + 1] = new_mid;\n        pending += 2;\n    }\n}\n\n// The number of elements of the sorted v[0..n] that are less than *x.\nunsafe fn lower_bound_raw<T,\n    F: FnMut(let T, let T) -> bool>(v: *T, n: i64, x: *T, is_less: F) -> i64 {\n    var f = is_less;\n    var lo = 0;\n    var size = n;\n    // (size halves each round)\n    for _ in 0..64 {\n        if size == 0 {\n            break;\n        }\n        let half = size / 2;\n        let mid = lo + half;\n        if f(*(&v[mid]), *x) {\n            lo = mid + 1;\n            size -= half + 1;\n        } else {\n            size = half;\n        }\n    }\n    lo\n}\n\n// The number of elements of the sorted v[0..n] that are not greater than\n// *x.\nunsafe fn upper_bound_raw<T,\n    F: FnMut(let T, let T) -> bool>(v: *T, n: i64, x: *T, is_less: F) -> i64 {\n    var f = is_less;\n    var lo = 0;\n    var size = n;\n    for _ in 0..64 {\n        if size == 0 {\n            break;\n        }\n        let half = size / 2;\n        let mid = lo + half;\n        if !f(*x, *(&v[mid])) {\n            lo = mid + 1;\n            size -= half + 1;\n        } else {\n            size = half;\n        }\n    }\n    lo\n}\n\n// Merges the sorted v[0..mid] and v[mid..len] (both nonempty), stably,\n// with the shorter side copied into scratch (room for it): from the\n// front when the left side is the shorter, else from the back. No branch\n// on the comparisons; every index stays in its range whatever they\n// answer, and what is left of the scratch's side is copied back after.\nunsafe fn merge_raw<T, F: FnMut(let T, let T) -> bool>(v: *T, len: i64, mid: i64, scratch: *T,\n    is_less: F) {\n    var f = is_less;\n    let right_len = len - mid;\n");
        buf_str(out, c"    if mid <= right_len {\n        copy_raw(scratch, v, mid);\n        // left in scratch[l..mid], right in v[r..len], out = l + r - mid\n        // < r: nothing unread is overwritten\n        var l = 0;\n        var r = mid;\n        var out = 0;\n        for _ in 0..len {\n            if l >= mid || r >= len {\n                break;\n            }\n            let take_left = !f(*(&v[r]), *(&scratch[l]));\n            let p: *T = if take_left { &scratch[l] } else { &v[r] };\n            l += take_left as i64;\n            r += (!take_left) as i64;\n            v[out] = *p;\n            out += 1;\n        }\n        if l < mid {\n            copy_raw(&v[out], &scratch[l], mid - l);\n        }\n    } else {\n        copy_raw(scratch, &v[mid], right_len);\n        // left in v[0..l], right in scratch[0..r], written at l + r - 1\n        // >= l: nothing unread is overwritten\n        var l = mid;\n        var r = right_len;\n        for _ in 0..len {\n            if l <= 0 || r <= 0 {\n                break;\n            }\n            let take_left = f(*(&scratch[r - 1]), *(&v[l - 1]));\n            let p: *T = if take_left { &v[l - 1] } else { &scratch[r - 1] };\n            let at = l + r - 1;\n            l -= take_left as i64;\n            r -= (!take_left) as i64;\n            v[at] = *p;\n        }\n        copy_raw(&v[l], scratch, r);\n    }\n}\n\n// dst[0..n] = src[0..n] (not overlapping).\n#[inline]\nunsafe fn copy_raw<T>(dst: *T, src: *T, n: i64) {\n    if n > 0 {\n        memcpy(dst as *u8, src as *u8, (n * size_of(T)) as u64);\n    }\n}\n// ---- end mod std::slice::stable ----\n}\n// ---- mod std::slice::search ----\nmod search {\n// std::slice::search: binary search and partition_point (0.20).\n\nuse std::{Ord, Result};\n\n// ---- Slice searches (0.20) ----\n\n// Binary search and partition_point (0.20; docs/design/collections-text-io.md\n// §2.4.6), Rust's: the loop runs a number of rounds that depends only on\n");
        buf_str(out, c"// the length, each choosing its half with no branch on the comparison, and\n// a match is not returned early. With equal elements, which of them a\n// match finds is unspecified, as in Rust. Comparators follow sort_by's\n// sign convention until std has Ordering (0.20's A0): `f(x)` negative,\n// zero or positive as the element x goes before, with or after the one\n// looked for.\n\n// Searches the sorted s for *x: Ok(index of a match), or Err(the index\n// where *x would go to keep s sorted). Rust's `binary_search`.\npub fn binary_search<T: Ord>(s: [T], x: T) -> Result<i64, i64> {\n    binary_search_by(s, |e: T| e.cmp(x))\n}\n\n// Searches s, sorted by f, for the element f places at 0 (`f(e)`: the\n// sign of comparing e with what is looked for): Ok(index of a match), or\n// Err(the index where it would go).\npub fn binary_search_by<T, F: FnMut(let T) -> i64>(s: [T], f: F) -> Result<i64, i64> {\n    var g = f;\n    var size = s.len;\n    if size == 0 {\n        return Err(0);\n    }\n    var base = 0;\n    // (size halves each round, base + size <= s.len: 63 rounds at most)\n    for _ in 0..64 {\n        if size <= 1 {\n            break;\n        }\n        let half = size / 2;\n        let mid = base + half;\n        let c = g(s[mid]);\n        base = if c > 0 { base } else { mid };\n        size -= half;\n    }\n    let c = g(s[base]);\n    if c == 0 {\n        Ok(base)\n    } else {\n        Err(base + (c < 0) as i64)\n    }\n}\n\n// Searches s, sorted by the key f gives, for *key: as binary_search.\npub fn binary_search_by_key<T, B: Ord, F: FnMut(let T) -> B>(s: [T], key: B, f: F) -> Result<i64,\n    i64> {\n    var g = f;\n    binary_search_by(s, |e: T| {\n        let k = g(e);\n        k.cmp(key)\n    })\n}\n\n// The index of the first element for which pred is false, s being\n// partitioned (pred true for a prefix, false after). Rust's\n// `partition_point`.\npub fn partition_point<T, P: FnMut(let T) -> bool>(s: [T], pred: P) -> i64 {\n    var g = pred;\n");
        buf_str(out, c"    match binary_search_by(s, |e: T| if g(e) { -1 } else { 1 }) {\n        Ok(i) => i,\n        Err(i) => i,\n    }\n}\n// ---- end mod std::slice::search ----\n}\n// ---- mod std::slice::algo ----\nmod algo {\n// std::slice::algo: reverse, rotations, fill, dedup, retain, selection, heap sifts (0.20).\n\nuse std::{Clone, Eq};\nuse super::{reverse_raw, rotate_raw, swap_at};\n\n// ---- Slice algorithms (0.20) ----\n\n// Rust's slice algorithms as functions over slices (0.20;\n// docs/design/collections-text-io.md §2.4.1 and §2.4.6, task A1): reverse,\n// rotations, fill, dedup and retain (which compact a slice and return its\n// new length, for Vec's methods to truncate to), selection of the k-th\n// element, and the sift functions of a binary max-heap. Comparators take\n// `*T`, and those returning a sign follow sort_by's convention until std\n// has Ordering.\n//\n// Unsafe code: reverse and rotate work through the slice's own pointer\n// and length (the kernels of Sort kernels); selection runs the unstable\n// sort's kernels on s.ptr and s.len, whose contract they keep.\n\n// Reverses s in place. Rust's `reverse`.\npub fn reverse<T>(s: inout [T]) {\n    // (s.ptr and s.len are one slice's)\n    unsafe {\n        reverse_raw(s.ptr, s.len);\n    }\n}\n\n// Rotates s in place so that s[k] comes first and s[0..k] goes to the end\n// (k <= s.len, checked). Rust's `rotate_left`.\npub fn rotate_left<T>(s: inout [T], k: i64) {\n    let n = s.len;\n    // (the check: s[k..] panics when k > n)\n    let _ = &s[k..];\n    unsafe {\n        rotate_raw(s.ptr, n, k);\n    }\n}\n\n// Rotates s in place so that its last k elements come first (k <= s.len,\n// checked). Rust's `rotate_right`.\npub fn rotate_right<T>(s: inout [T], k: i64) {\n    let n = s.len;\n    let _ = &s[k..];\n    unsafe {\n        rotate_raw(s.ptr, n, n - k);\n    }\n}\n\n// Sets every element of s to a clone of x. Rust's `fill`.\npub fn fill<T: Clone>(s: inout [T], x: sink T) {\n    for i in 0..s.len {\n");
        buf_str(out, c"        s[i] = x.clone();\n    }\n}\n\n// Removes the elements of s for which same(e, kept) is true, kept being\n// the last element kept before e, keeping the order of the rest at the\n// front of s; returns how many are kept (s[n..] holds the others, in\n// some order: Vec's `dedup_by` drops them). Rust's `dedup_by`.\npub fn dedup_by<T, F: FnMut(let T, let T) -> bool>(s: inout [T], same: F) -> i64 {\n    var g = same;\n    let n = s.len;\n    if n < 2 {\n        return n;\n    }\n    var w = 1;\n    for r in 1..n {\n        if !g(s[r], s[w - 1]) {\n            if r != w {\n                swap_at(s, w, r);\n            }\n            w += 1;\n        }\n    }\n    w\n}\n\n// dedup_by with ==: consecutive equal elements kept once.\npub fn dedup<T: Eq>(s: inout [T]) -> i64 {\n    dedup_by(s, |a: T, b: T| a == b)\n}\n\n// dedup_by on the key f gives each element.\npub fn dedup_by_key<T, K: Eq, F: FnMut(let T) -> K>(s: inout [T], f: F) -> i64 {\n    var g = f;\n    dedup_by(s, |a: T, b: T| g(a) == g(b))\n}\n\n// Keeps the elements of s for which keep is true at the front of s, in\n// their order, and returns how many (s[n..] holds the others, in some\n// order); keep sees each element once, in order. Rust's `retain` (Vec's\n// drops the others).\npub fn retain_by<T, F: FnMut(let T) -> bool>(s: inout [T], keep: F) -> i64 {\n    var g = keep;\n    var w = 0;\n    for r in 0..s.len {\n        if g(s[r]) {\n            if r != w {\n                swap_at(s, w, r);\n            }\n            w += 1;\n        }\n    }\n    w\n}\n\n// Binary max-heap helpers (for BinaryHeap, 0.20): s[0..end] is a heap\n// when no element is less than its children, s[2i + 1] and s[2i + 2],\n// by is_less. The element moves as bits through s's pointer (any T, owned\n// ones too); pos < end <= s.len, checked.\n\n// Moves s[pos] up toward s[start] while it is greater than its parent;\n// returns where it stops. Rust's BinaryHeap::sift_up.\npub fn heap_sift_up_less<T,\n");
        buf_str(out, c"    F: FnMut(let T, let T) -> bool>(s: inout [T], start: i64, pos: i64, is_less: F) -> i64 {\n    let _ = &s[pos];\n    // (pos < s.len; every index below is at most pos)\n    unsafe { heap_sift_up_raw(s.ptr, start, pos, is_less) }\n}\n\nunsafe fn heap_sift_up_raw<T,\n    F: FnMut(let T, let T) -> bool>(p: *T, start: i64, pos: i64, is_less: F) -> i64 {\n    var f = is_less;\n    let x = p[pos];\n    var at = pos;\n    // (at at least halves each round)\n    for _ in 0..64 {\n        if at <= start {\n            break;\n        }\n        let parent = (at - 1) / 2;\n        if !f(*(&p[parent]), x) {\n            break;\n        }\n        p[at] = p[parent];\n        at = parent;\n    }\n    p[at] = x;\n    at\n}\n\n// Moves s[pos] down the heap s[0..end] while a child is greater, taking\n// the greater child each time (the right one when they are equal, as\n// Rust); returns where it stops. Rust's BinaryHeap::sift_down_range.\npub fn heap_sift_down_less<T,\n    F: FnMut(let T, let T) -> bool>(s: inout [T], pos: i64, end: i64, is_less: F) -> i64 {\n    let _ = &s[pos];\n    let _ = &s[end - 1];\n    var f = is_less;\n    // (pos < end <= s.len: every index below is under end)\n    unsafe {\n        let p = s.ptr;\n        let x = p[pos];\n        var at = pos;\n        // (at at least doubles each round)\n        for _ in 0..64 {\n            var child = 2 * at + 1;\n            if child >= end {\n                break;\n            }\n            if child + 1 < end && !f(*(&p[child + 1]), *(&p[child])) {\n                child += 1;\n            }\n            if !f(x, *(&p[child])) {\n                break;\n            }\n            p[at] = p[child];\n            at = child;\n        }\n        p[at] = x;\n        at\n    }\n}\n\n// Moves s[pos] all the way down the heap s[0..end] along the greater\n// children, then up to where it belongs: fewer comparisons when it\n// belongs low, as after a pop moves the last element to the root. Rust's\n");
        buf_str(out, c"// BinaryHeap::sift_down_to_bottom.\npub fn heap_sift_down_to_bottom_less<T, F: FnMut(let T, let T) -> bool>(s: inout [T], pos: i64,\n    end: i64, is_less: F) {\n    let _ = &s[pos];\n    let _ = &s[end - 1];\n    var f = is_less;\n    unsafe {\n        let p = s.ptr;\n        let x = p[pos];\n        var at = pos;\n        for _ in 0..64 {\n            var child = 2 * at + 1;\n            if child >= end {\n                break;\n            }\n            if child + 1 < end && !f(*(&p[child + 1]), *(&p[child])) {\n                child += 1;\n            }\n            p[at] = p[child];\n            at = child;\n        }\n        p[at] = x;\n        heap_sift_up_raw(p, pos, at, f);\n    }\n}\n// ---- end mod std::slice::algo ----\n}\n// ---- end mod std::slice ----\n}\n// ---- mod std::collections ----\npub mod collections {\n// std::collections: the hash map and set (0.20: on the Swiss table,\n// raw_table.tach), the B-tree map and set (btree_node.tach).\n\npub mod hash_map;\npub mod hash_set;\npub mod raw_table;\npub mod btree_node;\npub mod btree_map;\npub mod group;\n\npub use btree_map::{BTreeMap, BTreeSet, BTreeSetIter};\npub use btree_node::{BHandle, BTreeIter, BTreeRaw};\npub use hash_map::{HashMap, SLOT_FULL};\npub use hash_set::{HashSet, HashSetIter};\npub use raw_table::{ProbeStats, RawIter, RawTable};\n// ---- mod std::collections::hash_map ----\npub mod hash_map {\n// std::collections::hash_map: HashMap (0.20: on the Swiss table).\n\nuse std::{ALLOC_LIMIT, Allocator, Ambient, Drop, Eq, Gpa, Hash, Option, out_of_memory, replace};\nuse super::raw_table::RawTable;\n\n// ---- HashMap ----\n\n// A hash table from K to V: hashbrown's Swiss table (RawTable), its\n// entries (key, value) pairs in buckets, matched 8 control bytes at a\n// time; keys hashed by their Hash impl (std's: foldhash with fixed seeds,\n// so a map iterates in the same order in every run and on every target).\n// Slots are numbered 0..slots(); `key_at(i)` and `value_at(i)` give an\n");
        buf_str(out, c"// occupied slot's entry (None for a free one); `iter()` is the same in\n// slot order.\n#[sealed]\npub struct HashMap<K: Hash + Eq, V, A: Allocator = Gpa> {\n    table: RawTable<(K, V), A>,\n}\n\n// (0.20: the old table's slot state of an entry; kept for code that names\n// it)\npub const SLOT_FULL: u8 = 1;\n\n// The hash of an entry's key.\n#[inline]\nfn entry_hash<K: Hash, V>(e: (K, V)) -> u64 {\n    e.0.hash()\n}\n\nimpl<K: Hash + Eq, V, A: Allocator> HashMap<K, V, A> {\n    // An empty map on allocator a (0.16).\n    pub fn new_in(a: sink A) -> HashMap<K, V, A> {\n        HashMap { table: RawTable::new_in(a) }\n    }\n\n    #[inline]\n    pub fn len(self) -> i64 {\n        self.table.len()\n    }\n\n    #[inline]\n    pub fn is_empty(self) -> bool {\n        self.table.len() == 0\n    }\n\n    // The slot holding `key`, or -1.\n    #[inline]\n    fn slot_of(self, key: K) -> i64 {\n        self.table.find(key.hash(), |e: (K, V)| e.0 == key)\n    }\n\n    pub fn contains(self, key: sink K) -> bool {\n        self.slot_of(key) >= 0\n    }\n\n    // The same as `contains` (Rust's name).\n    #[inline]\n    pub fn contains_key(self, key: sink K) -> bool {\n        self.slot_of(key) >= 0\n    }\n\n    // A copy of the value of `key`, if it has one (`get_mut` changes it).\n    #[inline]\n    pub fn get(self, key: sink K) -> Option<V> {\n        let i = self.slot_of(key);\n        // (i from find: FULL)\n        if i < 0 { Option::None }\n        else { Option::Some(unsafe { (*self.table.bucket_unchecked(i)).1 }) }\n    }\n\n    // The value of `key` in place, as a writable view of one element, if\n    // it has one: `if let Some(a) = m.get_mut(k) { a[0].balance += 10; }`.\n    // The view is valid until the map's next insert, remove or free (like\n    // a Vec's `as_mut_slice()`).\n    #[views(self)]\n    pub fn get_mut(inout self, key: sink K) -> Option<inout [V]> {\n        let i = self.slot_of(key);\n        if i < 0 {\n            return Option::None;\n        }\n");
        buf_str(out, c"        let p = unsafe { &(*self.table.bucket_unchecked(i)).1 as *V };\n        Option::Some(unsafe { &p[0..1] })\n    }\n\n    // The value of `key` in place (a writable view of one element, as `get_mut`),\n    // inserted as `default` first if the key has none; Rust's\n    // `entry(k).or_insert(d)`. Counting: `counts.get_or_insert(w, 0)[0] += 1;`.\n    #[views(self)]\n    #[stores(key, default)]\n    pub fn get_or_insert(inout self, key: sink K, default: sink V) -> inout [V] {\n        let h = key.hash();\n        self.table.reserve(1, |e: (K, V)| entry_hash(e));\n        let r = self.table.find_or_find_insert_slot(h, |e: (K, V)| e.0 == key);\n        let i = if r >= 0 { r } else { self.table.insert_in_slot(h, ~r, (key, default)) };\n        // (i found or just filled: FULL)\n        let p = unsafe { &(*self.table.bucket_unchecked(i)).1 as *V };\n        unsafe { &p[0..1] }\n    }\n\n    // Sets the value of `key`; returns its old value, if it had one.\n    #[stores(key, value)]\n    pub fn insert(inout self, key: sink K, value: sink V) -> Option<V> {\n        let h = key.hash();\n        self.table.reserve(1, |e: (K, V)| entry_hash(e));\n        let r = self.table.find_or_find_insert_slot(h, |e: (K, V)| e.0 == key);\n        if r >= 0 {\n            // (the old value moves out, the new one in: neither is dropped)\n            let p = unsafe { self.table.bucket_unchecked(r) };\n            let old = unsafe { (*p).1 };\n            unsafe {\n                (*p).1 = value;\n            }\n            return Option::Some(old);\n        }\n        self.table.insert_in_slot(h, ~r, (key, value));\n        Option::None\n    }\n\n    // Removes `key`; returns its value, if it had one (the stored key is\n    // dropped).\n    pub fn remove(inout self, key: sink K) -> Option<V> {\n        let i = self.slot_of(key);\n        if i < 0 {\n            return Option::None;\n        }\n        let e = self.table.take(i);\n        Option::Some(e.1)\n    }\n\n");
        buf_str(out, c"    // The slots: what `key_at` and `value_at` take.\n    #[inline]\n    pub fn slots(self) -> i64 {\n        if self.table.len() == 0 { 0 } else { self.table.buckets() }\n    }\n\n    pub fn key_at(self, i: i64) -> Option<K> {\n        if !self.table.is_full(i) {\n            return Option::None;\n        }\n        Option::Some(unsafe { (*self.table.bucket(i)).0 })\n    }\n\n    pub fn value_at(self, i: i64) -> Option<V> {\n        if !self.table.is_full(i) {\n            return Option::None;\n        }\n        Option::Some(unsafe { (*self.table.bucket(i)).1 })\n    }\n\n    // (std's iterators) The table.\n    #[inline]\n    #[views(self)]\n    pub fn raw_table(self) -> let RawTable<(K, V), A> {\n        self.table\n    }\n\n    // Its entries dropped and its memory given back; it is left empty, to\n    // use again (0.17: a map is dropped at the end of its scope without\n    // it).\n    pub fn free(inout self) {\n        self.table.free();\n    }\n\n    // Removes every entry; keeps the memory.\n    pub fn clear(inout self) {\n        self.table.clear();\n    }\n\n    // Its entries, in a map on the same allocator; it is left empty (0.17:\n    // `std::take` for a container, which keeps its allocator).\n    pub fn take(inout self) -> HashMap<K, V, A> {\n        let empty: HashMap<K, V, A> = HashMap::new_in(self.table.allocator());\n        replace(&self, empty)\n    }\n\n    // Its allocator (0.16): a copy of the handle.\n    pub fn allocator(self) -> A {\n        self.table.allocator()\n    }\n\n    // An empty map on allocator a with room for n entries (0.16).\n    pub fn with_capacity_in(n: i64, a: sink A) -> HashMap<K, V, A> {\n        if n > ALLOC_LIMIT / 16 {\n            out_of_memory();\n        }\n        HashMap { table: RawTable::with_capacity_in(n, a) }\n    }\n\n    // The entries it holds before it grows.\n    pub fn capacity(self) -> i64 {\n        self.table.capacity()\n    }\n\n    // Room for n more entries without growing.\n");
        buf_str(out, c"    pub fn reserve(inout self, n: i64) {\n        self.table.reserve(n, |e: (K, V)| entry_hash(e));\n    }\n}\n\n// (0.17) A map's drop: its entries' drops, then its memory given back.\nimpl<K: Hash + Eq, V, A: Allocator> Drop for HashMap<K, V, A> {\n    #[inline]\n    fn drop(inout self) {\n        self.table.free();\n    }\n}\n\nimpl<K: Hash + Eq, V, A: Allocator + Ambient> HashMap<K, V, A> {\n    #[ambient(\"HashMap::new_in(gpa)\")]\n    pub fn new() -> HashMap<K, V, A> {\n        HashMap::new_in(A::ambient())\n    }\n}\n// ---- end mod std::collections::hash_map ----\n}\n// ---- mod std::collections::hash_set ----\npub mod hash_set {\n// std::collections::hash_set: HashSet (0.20), a set of T on the Swiss\n// table (RawTable), as HashMap is.\n\nuse std::{Allocator, Ambient, Drop, Eq, Gpa, Hash, Iterator, Option};\nuse super::raw_table::{RawIter, RawTable};\n\n// ---- HashSet (0.20) ----\n\n// A set of values of T: `insert` adds one (false when it was there),\n// `contains`, `remove`; `iter()` gives them in slot order, the same in\n// every run.\n#[sealed]\npub struct HashSet<T: Hash + Eq, A: Allocator = Gpa> {\n    table: RawTable<T, A>,\n}\n\n// The hash of an element.\n#[inline]\nfn elem_hash<T: Hash>(x: T) -> u64 {\n    x.hash()\n}\n\nimpl<T: Hash + Eq, A: Allocator> HashSet<T, A> {\n    // An empty set on allocator a.\n    pub fn new_in(a: sink A) -> HashSet<T, A> {\n        HashSet { table: RawTable::new_in(a) }\n    }\n\n    // An empty set on allocator a with room for n values.\n    pub fn with_capacity_in(n: i64, a: sink A) -> HashSet<T, A> {\n        HashSet { table: RawTable::with_capacity_in(n, a) }\n    }\n\n    #[inline]\n    pub fn len(self) -> i64 {\n        self.table.len()\n    }\n\n    #[inline]\n    pub fn is_empty(self) -> bool {\n        self.table.len() == 0\n    }\n\n    pub fn contains(self, x: sink T) -> bool {\n        self.table.find(x.hash(), |e: T| e == x) >= 0\n    }\n\n");
        buf_str(out, c"    // Adds x; false when the set had it already (x is dropped then).\n    #[stores(x)]\n    pub fn insert(inout self, x: sink T) -> bool {\n        let h = x.hash();\n        self.table.reserve(1, |e: T| elem_hash(e));\n        let r = self.table.find_or_find_insert_slot(h, |e: T| e == x);\n        if r >= 0 {\n            return false;\n        }\n        self.table.insert_in_slot(h, ~r, x);\n        true\n    }\n\n    // Removes x; false when the set did not have it.\n    pub fn remove(inout self, x: sink T) -> bool {\n        let i = self.table.find(x.hash(), |e: T| e == x);\n        if i < 0 {\n            return false;\n        }\n        self.table.erase(i);\n        true\n    }\n\n    // The values, in slot order, until the set changes.\n    #[views(self)]\n    pub fn iter(self) -> HashSetIter<T> {\n        let data = if self.table.len() == 0 { 0 as *T } else { self.table.bucket_ptr() };\n        HashSetIter { it: self.table.iter(), data: data, left: self.table.len() }\n    }\n\n    // Removes every value; keeps the memory.\n    pub fn clear(inout self) {\n        self.table.clear();\n    }\n\n    // Drops the values and gives the memory back; the set is empty.\n    pub fn free(inout self) {\n        self.table.free();\n    }\n\n    pub fn allocator(self) -> A {\n        self.table.allocator()\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator> Drop for HashSet<T, A> {\n    #[inline]\n    fn drop(inout self) {\n        self.table.free();\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator + Ambient> HashSet<T, A> {\n    #[ambient(\"HashSet::new_in(gpa)\")]\n    pub fn new() -> HashSet<T, A> {\n        HashSet::new_in(A::ambient())\n    }\n}\n\n// `s.iter()`: the values (copies), a view of the set.\npub struct HashSetIter<T> { it: RawIter, data: *T, left: i64 }\n\nimpl<T> Iterator for HashSetIter<T> {\n    type Item = T;\n\n    #[inline]\n    fn next(inout self) -> Option<T> {\n        let i = self.it.next_index();\n        if i < 0 {\n            return Option::None;\n");
        buf_str(out, c"        }\n        self.left -= 1;\n        Option::Some(unsafe { self.data[i] })\n    }\n\n    #[inline]\n    fn exact_len(self) -> i64 {\n        self.left\n    }\n}\n// ---- end mod std::collections::hash_set ----\n}\n// ---- mod std::collections::raw_table ----\npub mod raw_table {\n// std::collections::raw_table: RawTable<T, A>, the Swiss table (0.20),\n// the engine of HashMap and HashSet, hashbrown's design. It stores\n// elements of T in buckets and never hashes: the caller gives each\n// operation the element's hash and closures, `eq` (is this the element?)\n// and `hasher` (an element's hash, to move it when the table grows), so\n// one table serves maps and sets and its code is made once per element\n// type.\n//\n// Layout: one allocation from A, the buckets (`buckets` elements of T)\n// then, 8-aligned, the control bytes (group.tach): `buckets + GROUP` of\n// them, the last GROUP a copy of the first (so a group read at any bucket\n// is in bounds). `buckets` is a power of two, 4 at least; a table that has\n// never allocated has bucket_mask 0 and no control bytes (a constant\n// constructor: a static may hold one); its methods check that first. A\n// hash's low bits pick the first group probed (h1), its top 7 its tag (ctrl_tag);\n// probing goes over groups by triangular steps (stride GROUP, 2 GROUP, ...),\n// which visit every group of a power-of-two table. At most 7/8 of the\n// buckets are FULL (all but one below 8 buckets): a search always ends at\n// an EMPTY byte.\n//\n// Elements are owned by the table: `erase`, `clear` and the drop drop\n// them, `take` moves one out, `get` and `get_mut` are views of one.\n//\n// Safety: every unsafe block below reads or writes a control byte below\n// buckets + GROUP or a bucket below `buckets` of the live allocation, or\n// an element in a FULL bucket (initialized). Raw writes drop nothing\n// (ptr::write), raw reads move out (ptr::read). An index a caller gives\n");
        buf_str(out, c"// is checked (`erase`, `take`, `get`, `insert_in_slot`, ...); the\n// iterator is a view of the control bytes.\n\nuse std::{\n    ALLOC_LIMIT, Allocator, Drop, Gpa, Iterator, Option, drop, leading_zeros, needs_drop,\n    out_of_memory, panic,\n};\nuse super::group::{\n    BitMask, CTRL_DELETED, CTRL_EMPTY, GROUP, bitmask_leading, bitmask_lowest,\n    bitmask_remove_lowest, bitmask_trailing, convert_special_to_empty_and_full_to_deleted, ctrl_tag,\n    group_load, group_store, match_empty, match_empty_or_deleted, match_full, match_tag,\n};\n\n// ---- Swiss table (0.20 implementation) ----\n\n#[sealed]\npub struct RawTable<T, A: Allocator = Gpa> {\n    // the control bytes (buckets + GROUP)\n    ctrl: *u8,\n    // the buckets\n    data: *T,\n    // buckets - 1 (0: not allocated)\n    bucket_mask: i64,\n    // insertions left before the table grows: EMPTY buckets that may\n    // still be filled under the load factor\n    growth_left: i64,\n    // FULL buckets\n    items: i64,\n    alloc: A,\n}\n\n// The iterator over a table's FULL buckets, in bucket order (`iter()`):\n// their indices. A view of the table's control bytes.\npub struct RawIter {\n    ctrl: [u8],\n    // the group being read and its FULL buckets not yet given\n    pos: i64,\n    bits: BitMask,\n}\n\n// How far elements are from where their search starts (`probe_stats`):\n// groups probed past the first, in total and at most.\npub struct ProbeStats {\n    pub total: i64,\n    pub max: i64,\n}\n\n// The elements a table of bucket_mask + 1 buckets may hold: 7/8 of them,\n// all but one below 8.\n#[inline]\nfn raw_capacity(bucket_mask: i64) -> i64 {\n    if bucket_mask < 8 {\n        bucket_mask\n    } else {\n        ((bucket_mask + 1) / 8) * 7\n    }\n}\n\n// The buckets for cap elements (cap > 0): a power of two, 4 at least.\nfn raw_buckets_for(cap: i64) -> i64 {\n    if cap < 4 {\n        return 4;\n    }\n    if cap < 8 {\n        return 8;\n    }\n    if cap < 15 {\n        return 16;\n    }\n");
        buf_str(out, c"    if cap > ALLOC_LIMIT / 8 {\n        out_of_memory();\n    }\n    let adjusted = cap * 8 / 7;\n    // (the next power of two)\n    1 << (64 - leading_zeros((adjusted - 1) as u64))\n}\n\n// Sets n control bytes at ctrl to EMPTY; the caller guarantees that they\n// are writable.\nunsafe fn raw_fill_empty(ctrl: *u8, n: i64) {\n    for g in 0..n / GROUP {\n        group_store(ctrl, g * GROUP, 0xffffffffffffffffu64);\n    }\n    for k in n / GROUP * GROUP..n {\n        ctrl[k] = CTRL_EMPTY;\n    }\n}\n\nimpl<T, A: Allocator> RawTable<T, A> {\n    // An empty table on allocator a; it allocates at the first insertion.\n    pub fn new_in(a: sink A) -> RawTable<T, A> {\n        RawTable {\n            ctrl: 0 as *u8, data: 0 as *T, bucket_mask: 0, growth_left: 0,\n            items: 0, alloc: a\n        }\n    }\n\n    // An empty table on allocator a with room for n elements.\n    pub fn with_capacity_in(n: i64, a: sink A) -> RawTable<T, A> {\n        var t: RawTable<T, A> = RawTable::new_in(a);\n        if n > 0 {\n            t.alloc_buckets(raw_buckets_for(n));\n        }\n        t\n    }\n\n    // The elements in the table.\n    #[inline]\n    pub fn len(self) -> i64 {\n        self.items\n    }\n\n    #[inline]\n    pub fn is_empty(self) -> bool {\n        self.items == 0\n    }\n\n    // The elements it holds before it grows.\n    pub fn capacity(self) -> i64 {\n        self.items + self.growth_left\n    }\n\n    // The buckets (1 before the first allocation).\n    #[inline]\n    pub fn buckets(self) -> i64 {\n        self.bucket_mask + 1\n    }\n\n    pub fn allocator(self) -> A {\n        self.alloc\n    }\n\n    // The allocation's size and alignment for `buckets` buckets, and where\n    // its control bytes start.\n    fn raw_layout(buckets: i64) -> (i64, i64, i64) {\n        let size = size_of(T);\n        if size > 0 && buckets > (ALLOC_LIMIT - 2 * GROUP) / size {\n            out_of_memory();\n        }\n");
        buf_str(out, c"        let ctrl_at = (buckets * size + GROUP - 1) & ~(GROUP - 1);\n        let align = if align_of(T) > GROUP { align_of(T) } else { GROUP };\n        (ctrl_at + buckets + GROUP, align, ctrl_at)\n    }\n\n    // Allocates `buckets` empty buckets for an empty table.\n    fn alloc_buckets(inout self, buckets: i64) {\n        let (size, align, ctrl_at) = RawTable::<T, A>::raw_layout(buckets);\n        unsafe {\n            let p = self.alloc.alloc(size, align);\n            self.data = p as *T;\n            self.ctrl = &p[ctrl_at];\n            raw_fill_empty(self.ctrl, buckets + GROUP);\n        }\n        self.bucket_mask = buckets - 1;\n        self.growth_left = raw_capacity(buckets - 1);\n        self.items = 0;\n    }\n\n    // Is bucket i FULL? (false for an i out of range)\n    #[inline]\n    pub fn is_full(self, i: i64) -> bool {\n        if i < 0 || i > self.bucket_mask || self.bucket_mask == 0 {\n            return false;\n        }\n        unsafe { self.ctrl[i] & 0x80 == 0 }\n    }\n\n    // Stops the program unless bucket i is FULL.\n    #[inline]\n    fn check_full(self, i: i64) {\n        if !self.is_full(i) {\n            unsafe { panic(c\"RawTable: the bucket is not full\") }\n        }\n    }\n\n    // The FULL bucket holding the element for which eq is true, among\n    // those whose hash is `hash`, or -1.\n    #[inline]\n    pub fn find<F: FnMut(let T) -> bool>(self, hash: u64, eq: sink F) -> i64 {\n        let mask = self.bucket_mask;\n        if mask == 0 {\n            return -1;\n        }\n        let tag = ctrl_tag(hash);\n        var pos = hash as i64 & mask;\n        var stride = 0;\n        // (triangular steps visit every group: the loop ends by then)\n        for _ in 0..(mask >> 3) + 1 {\n            let g = unsafe { group_load(self.ctrl, pos) };\n            var m = match_tag(g, tag);\n            for _ in 0..GROUP {\n                if m == 0 {\n                    break;\n                }\n");
        buf_str(out, c"                let i = (pos + bitmask_lowest(m)) & mask;\n                if unsafe { eq(*(&self.data[i])) } {\n                    return i;\n                }\n                m = bitmask_remove_lowest(m);\n            }\n            if match_empty(g) != 0 {\n                return -1;\n            }\n            stride += GROUP;\n            pos = (pos + stride) & mask;\n        }\n        -1\n    }\n\n    // One probe for an insertion of a possibly present element, after\n    // `reserve(1, hasher)`: the FULL bucket holding the element for which\n    // eq is true (>= 0), else `~slot` (< 0), the bucket to give\n    // `insert_in_slot`, which holds until the table changes.\n    #[inline]\n    pub fn find_or_find_insert_slot<F: FnMut(let T) -> bool>(self, hash: u64, eq: sink F) -> i64 {\n        let mask = self.bucket_mask;\n        if mask == 0 {\n            // (no buckets: insert_in_slot refuses it, reserve first)\n            return ~0;\n        }\n        let tag = ctrl_tag(hash);\n        var pos = hash as i64 & mask;\n        var stride = 0;\n        var slot = -1;\n        for _ in 0..(mask >> 3) + 1 {\n            let g = unsafe { group_load(self.ctrl, pos) };\n            var m = match_tag(g, tag);\n            for _ in 0..GROUP {\n                if m == 0 {\n                    break;\n                }\n                let i = (pos + bitmask_lowest(m)) & mask;\n                if unsafe { eq(*(&self.data[i])) } {\n                    return i;\n                }\n                m = bitmask_remove_lowest(m);\n            }\n            if slot < 0 {\n                let e = match_empty_or_deleted(g);\n                if e != 0 {\n                    slot = (pos + bitmask_lowest(e)) & mask;\n                }\n            }\n            if match_empty(g) != 0 {\n                return ~self.fix_insert_slot(slot);\n            }\n            stride += GROUP;\n            pos = (pos + stride) & mask;\n        }\n");
        buf_str(out, c"        // (an EMPTY byte is always reached first: the load factor)\n        ~self.fix_insert_slot(slot)\n    }\n\n    // Puts x, whose hash is `hash`, in bucket `slot`, the `~result` of\n    // find_or_find_insert_slot with no change to the table since; returns\n    // slot.\n    #[inline]\n    pub fn insert_in_slot(inout self, hash: u64, slot: i64, x: sink T) -> i64 {\n        if slot < 0 || slot > self.bucket_mask || self.bucket_mask == 0 {\n            unsafe { panic(c\"RawTable::insert_in_slot: no such bucket\") }\n        }\n        let old = unsafe { self.ctrl[slot] };\n        // (a FULL bucket, or an EMPTY one with no growth left, is no slot)\n        if old & 0x80 == 0 || (old == CTRL_EMPTY && self.growth_left == 0) {\n            unsafe { panic(c\"RawTable::insert_in_slot: not a free slot\") }\n        }\n        self.record_insert(slot, old, hash);\n        unsafe {\n            self.data[slot] = x;\n        }\n        slot\n    }\n\n    // Inserts x, whose hash is `hash`, without looking for an equal\n    // element; returns its bucket. hasher(e) is the hash of element e,\n    // for those the table moves when it grows.\n    pub fn insert<H: FnMut(let T) -> u64>(inout self, hash: u64, x: sink T, hasher: H) -> i64 {\n        var i = if self.bucket_mask == 0 { -1 } else { self.find_insert_slot(hash) };\n        if i < 0 || (self.growth_left == 0 && unsafe { self.ctrl[i] } == CTRL_EMPTY) {\n            self.reserve_rehash(1, hasher);\n            i = self.find_insert_slot(hash);\n        }\n        let old = unsafe { self.ctrl[i] };\n        self.record_insert(i, old, hash);\n        unsafe {\n            self.data[i] = x;\n        }\n        i\n    }\n\n    #[inline]\n    fn record_insert(inout self, i: i64, old: u8, hash: u64) {\n        // (an EMPTY byte has its low bit set, a DELETED one not)\n        self.growth_left -= (old & 1) as i64;\n        self.set_ctrl(i, ctrl_tag(hash));\n        self.items += 1;\n    }\n\n");
        buf_str(out, c"    // The first EMPTY or DELETED bucket of hash's probe sequence.\n    #[inline]\n    fn find_insert_slot(self, hash: u64) -> i64 {\n        let mask = self.bucket_mask;\n        var pos = hash as i64 & mask;\n        var stride = 0;\n        for _ in 0..(mask >> 3) + 1 {\n            let e = match_empty_or_deleted(unsafe { group_load(self.ctrl, pos) });\n            if e != 0 {\n                return self.fix_insert_slot((pos + bitmask_lowest(e)) & mask);\n            }\n            stride += GROUP;\n            pos = (pos + stride) & mask;\n        }\n        unsafe { panic(c\"RawTable: no free bucket\") }\n    }\n\n    // In a table of fewer buckets than GROUP, a group read past the last\n    // bucket sees the EMPTY bytes after it, which stand for the FULL\n    // buckets of the group's start: then the slot is the first free one\n    // from bucket 0.\n    #[inline]\n    fn fix_insert_slot(self, i: i64) -> i64 {\n        if unsafe { self.ctrl[i] } & 0x80 == 0 {\n            return bitmask_lowest(match_empty_or_deleted(unsafe { group_load(self.ctrl, 0) }));\n        }\n        i\n    }\n\n    // Sets bucket i's control byte, and its copy past the end.\n    #[inline]\n    fn set_ctrl(inout self, i: i64, c: u8) {\n        let mirror = ((i - GROUP) & self.bucket_mask) + GROUP;\n        unsafe {\n            self.ctrl[i] = c;\n            self.ctrl[mirror] = c;\n        }\n    }\n\n    // The element in FULL bucket i (checked): a view of it.\n    #[inline]\n    #[views(self)]\n    pub fn get(self, i: i64) -> let T {\n        self.check_full(i);\n        unsafe { *(&self.data[i]) }\n    }\n\n    // The element in FULL bucket i (checked), to change in place (its hash\n    // must stay the same).\n    #[inline]\n    #[views(self)]\n    pub fn get_mut(inout self, i: i64) -> inout T {\n        self.check_full(i);\n        unsafe { &*(&self.data[i]) }\n    }\n\n    // A raw pointer to bucket i's element, unchecked: the caller\n");
        buf_str(out, c"    // guarantees that i is FULL (a result of find).\n    #[inline]\n    pub unsafe fn bucket_unchecked(self, i: i64) -> *T {\n        &self.data[i]\n    }\n\n    // A raw pointer to FULL bucket i's element (checked), valid until the\n    // table changes: for code that keeps it past a view's rules.\n    #[inline]\n    pub fn bucket(self, i: i64) -> *T {\n        self.check_full(i);\n        unsafe { &self.data[i] }\n    }\n\n    // The buckets' memory (null before the first allocation): raw, for\n    // iterators that pair it with `iter()`'s indices.\n    #[inline]\n    pub fn bucket_ptr(self) -> *T {\n        self.data\n    }\n\n    // Replaces the element in FULL bucket i (checked) with x, which must\n    // have the same hash; the old one is dropped.\n    #[inline]\n    pub fn write(inout self, i: i64, x: sink T) {\n        self.check_full(i);\n        unsafe {\n            if needs_drop::<T>() {\n                drop(self.data[i]);\n            }\n            self.data[i] = x;\n        }\n    }\n\n    // Removes the element in FULL bucket i (checked) and returns it. Its\n    // control byte becomes EMPTY when no search can have gone past it (an\n    // EMPTY byte within GROUP buckets on both sides spans no full group),\n    // else DELETED.\n    pub fn take(inout self, i: i64) -> T {\n        self.check_full(i);\n        let mask = self.bucket_mask;\n        let before = (i - GROUP) & mask;\n        let empty_before = match_empty(unsafe { group_load(self.ctrl, before) });\n        let empty_after = match_empty(unsafe { group_load(self.ctrl, i) });\n        if bitmask_leading(empty_before) + bitmask_trailing(empty_after) >= GROUP {\n            self.set_ctrl(i, CTRL_DELETED);\n        } else {\n            self.growth_left += 1;\n            self.set_ctrl(i, CTRL_EMPTY);\n        }\n        self.items -= 1;\n        unsafe { self.data[i] }\n    }\n\n    // Removes and drops the element in FULL bucket i (checked).\n    pub fn erase(inout self, i: i64) {\n");
        buf_str(out, c"        let x = self.take(i);\n        drop(x);\n    }\n\n    // Room for n more elements without growing; hasher as for insert.\n    #[inline]\n    pub fn reserve<H: FnMut(let T) -> u64>(inout self, n: i64, hasher: H) {\n        if n > self.growth_left {\n            self.reserve_rehash(n, hasher);\n        }\n    }\n\n    // Makes room for n more elements: rehashes in place when that frees\n    // enough (at most half the capacity is in use), else moves to a table\n    // of twice the room at least.\n    #[cold]\n    fn reserve_rehash<H: FnMut(let T) -> u64>(inout self, n: i64, hasher: H) {\n        if n > ALLOC_LIMIT / 16 - self.items {\n            out_of_memory();\n        }\n        let new_items = self.items + n;\n        let full = raw_capacity(self.bucket_mask);\n        if new_items <= full / 2 {\n            self.rehash_in_place(hasher);\n        } else {\n            self.resize(if new_items > full + 1 { new_items } else { full + 1 }, hasher);\n        }\n    }\n\n    // Moves every element to a new allocation with room for cap.\n    fn resize<H: FnMut(let T) -> u64>(inout self, cap: i64, hasher: sink H) {\n        let old_ctrl = self.ctrl;\n        let old_data = self.data;\n        let old_mask = self.bucket_mask;\n        let items = self.items;\n        self.alloc_buckets(raw_buckets_for(cap));\n        if old_mask != 0 {\n            for g in 0..(old_mask >> 3) + 1 {\n                let pos = g * GROUP;\n                var m = match_full(unsafe { group_load(old_ctrl, pos) });\n                for _ in 0..GROUP {\n                    if m == 0 {\n                        break;\n                    }\n                    let i = pos + bitmask_lowest(m);\n                    m = bitmask_remove_lowest(m);\n                    let hash = unsafe { hasher(*(&old_data[i])) };\n                    let j = self.find_insert_slot(hash);\n                    self.set_ctrl(j, ctrl_tag(hash));\n                    unsafe {\n");
        buf_str(out, c"                        self.data[j] = old_data[i];\n                    }\n                }\n            }\n            let (size, align, _) = RawTable::<T, A>::raw_layout(old_mask + 1);\n            unsafe {\n                self.alloc.free(old_data as *u8, size, align);\n            }\n        }\n        self.items = items;\n        self.growth_left -= items;\n    }\n\n    // Rehashes in place, turning the DELETED buckets back into EMPTY ones\n    // (hashbrown's algorithm): FULL bytes become DELETED, EMPTY and DELETED\n    // become EMPTY, then each element marked DELETED is moved to the first\n    // free bucket of its probe sequence, swapping with an element there\n    // still to be moved.\n    fn rehash_in_place<H: FnMut(let T) -> u64>(inout self, hasher: sink H) {\n        let buckets = self.bucket_mask + 1;\n        for g in 0..(buckets + GROUP - 1) / GROUP {\n            let i = g * GROUP;\n            unsafe {\n                group_store(self.ctrl, i,\n                    convert_special_to_empty_and_full_to_deleted(group_load(self.ctrl, i)));\n            }\n        }\n        // (the copy past the end)\n        if buckets < GROUP {\n            for k in 0..buckets {\n                unsafe {\n                    self.ctrl[GROUP + k] = self.ctrl[k];\n                }\n            }\n        } else {\n            unsafe {\n                group_store(self.ctrl, buckets, group_load(self.ctrl, 0));\n            }\n        }\n        for i in 0..buckets {\n            if unsafe { self.ctrl[i] } != CTRL_DELETED {\n                continue;\n            }\n            // (each round places one element for good: buckets rounds at most)\n            for _ in 0..buckets {\n                let hash = unsafe { hasher(*(&self.data[i])) };\n                let j = self.find_insert_slot(hash);\n                // (in the same group as its probe's start: it stays)\n                let start = hash as i64 & self.bucket_mask;\n");
        buf_str(out, c"                if ((i - start) & self.bucket_mask) / GROUP\n                    == ((j - start) & self.bucket_mask) / GROUP {\n                    self.set_ctrl(i, ctrl_tag(hash));\n                    break;\n                }\n                let prev = unsafe { self.ctrl[j] };\n                self.set_ctrl(j, ctrl_tag(hash));\n                if prev == CTRL_EMPTY {\n                    self.set_ctrl(i, CTRL_EMPTY);\n                    unsafe {\n                        self.data[j] = self.data[i];\n                    }\n                    break;\n                }\n                // (j held an element still to move: swap, go on with it)\n                unsafe {\n                    let x = self.data[j];\n                    self.data[j] = self.data[i];\n                    self.data[i] = x;\n                }\n            }\n        }\n        self.growth_left = raw_capacity(self.bucket_mask) - self.items;\n    }\n\n    // Drops every element.\n    fn drop_elements(inout self) {\n        if needs_drop::<T>() && self.items > 0 {\n            for g in 0..(self.bucket_mask >> 3) + 1 {\n                let pos = g * GROUP;\n                var m = match_full(unsafe { group_load(self.ctrl, pos) });\n                for _ in 0..GROUP {\n                    if m == 0 {\n                        break;\n                    }\n                    let i = pos + bitmask_lowest(m);\n                    m = bitmask_remove_lowest(m);\n                    unsafe {\n                        drop(self.data[i]);\n                    }\n                }\n            }\n        }\n    }\n\n    // Removes (and drops) every element; keeps the memory.\n    pub fn clear(inout self) {\n        if self.bucket_mask == 0 {\n            return;\n        }\n        self.drop_elements();\n        unsafe {\n            raw_fill_empty(self.ctrl, self.bucket_mask + 1 + GROUP);\n        }\n        self.items = 0;\n        self.growth_left = raw_capacity(self.bucket_mask);\n    }\n\n");
        buf_str(out, c"    // The FULL buckets, in bucket order.\n    #[views(self)]\n    pub fn iter(self) -> RawIter {\n        if self.bucket_mask == 0 {\n            return RawIter { ctrl: \"\", pos: 0, bits: 0 };\n        }\n        let ctrl = unsafe { self.ctrl[0..self.bucket_mask + 1 + GROUP] };\n        RawIter { ctrl: ctrl, pos: 0, bits: match_full(unsafe { group_load(ctrl.ptr, 0) }) }\n    }\n\n    // Drops the elements and gives the memory back; the table is empty,\n    // and may be used again.\n    pub fn free(inout self) {\n        self.drop_elements();\n        if self.bucket_mask != 0 {\n            let (size, align, _) = RawTable::<T, A>::raw_layout(self.bucket_mask + 1);\n            unsafe {\n                self.alloc.free(self.data as *u8, size, align);\n            }\n            self.ctrl = 0 as *u8;\n            self.data = 0 as *T;\n            self.bucket_mask = 0;\n        }\n        self.growth_left = 0;\n        self.items = 0;\n    }\n\n    // (tests) How far the elements are from where their search starts,\n    // in groups; hasher as for insert.\n    pub fn probe_stats<H: FnMut(let T) -> u64>(self, hasher: sink H) -> ProbeStats {\n        var stats = ProbeStats { total: 0, max: 0 };\n        let mask = self.bucket_mask;\n        for i in self.iter() {\n            let hash = unsafe { hasher(*(&self.data[i])) };\n            var pos = hash as i64 & mask;\n            var stride = 0;\n            var steps = 0;\n            for _ in 0..(mask >> 3) + 1 {\n                if ((i - pos) & mask) < GROUP {\n                    break;\n                }\n                stride += GROUP;\n                pos = (pos + stride) & mask;\n                steps += 1;\n            }\n            stats.total += steps;\n            if steps > stats.max {\n                stats.max = steps;\n            }\n        }\n        stats\n    }\n\n    // (tests) The table's invariants, with every element found again by\n    // its hash: \"\" when they hold, else the first broken.\n");
        buf_str(out, c"    pub fn check<H: FnMut(let T) -> u64>(self, hasher: sink H) -> [u8] {\n        let buckets = self.bucket_mask + 1;\n        if self.bucket_mask == 0 {\n            if self.items != 0 || self.growth_left != 0 {\n                return \"an unallocated table holds elements\";\n            }\n            return \"\";\n        }\n        var full = 0;\n        var deleted = 0;\n        for i in 0..buckets {\n            let c = unsafe { self.ctrl[i] };\n            if c & 0x80 == 0 {\n                full += 1;\n                let hash = unsafe { hasher(*(&self.data[i])) };\n                if ctrl_tag(hash) != c {\n                    return \"a control byte is not its element's tag\";\n                }\n                // (the search for its hash finds an element: 0.20's let\n                // parameters copy a plain element, so the bucket is not\n                // known by its address)\n                if self.find(hash, |_p: T| true) < 0 {\n                    return \"an element is not found by its hash\";\n                }\n            } else if c == CTRL_DELETED {\n                deleted += 1;\n            } else if c != CTRL_EMPTY {\n                return \"a control byte is neither FULL, EMPTY nor DELETED\";\n            }\n        }\n        for k in 0..GROUP {\n            let mirror = if buckets < GROUP {\n                if k < buckets { unsafe { self.ctrl[k] } } else { CTRL_EMPTY }\n            } else {\n                unsafe { self.ctrl[k] }\n            };\n            let at = if buckets < GROUP { if k < buckets { GROUP + k } else { k } }\n                else { buckets + k };\n            if unsafe { self.ctrl[at] } != mirror {\n                return \"the control bytes past the end are not a copy\";\n            }\n        }\n        if full != self.items {\n            return \"items is not the number of FULL buckets\";\n        }\n        if self.growth_left != raw_capacity(self.bucket_mask) - full - deleted {\n");
        buf_str(out, c"            return \"growth_left is not the capacity left\";\n        }\n        if self.growth_left < 0 {\n            return \"more elements than the capacity\";\n        }\n        \"\"\n    }\n}\n\n// The table's drop: its elements' drops, then its memory given back.\nimpl<T, A: Allocator> Drop for RawTable<T, A> {\n    #[inline]\n    fn drop(inout self) {\n        self.free();\n    }\n}\n\nimpl RawIter {\n    // The next FULL bucket, or -1 at the end.\n    #[inline]\n    pub fn next_index(inout self) -> i64 {\n        // (at most the groups left)\n        for _ in 0..self.ctrl.len / GROUP + 1 {\n            if self.bits != 0 {\n                let i = self.pos + bitmask_lowest(self.bits);\n                self.bits = bitmask_remove_lowest(self.bits);\n                return i;\n            }\n            self.pos += GROUP;\n            // (ctrl has buckets + GROUP bytes: a group starts before buckets)\n            if self.pos + GROUP >= self.ctrl.len {\n                return -1;\n            }\n            self.bits = match_full(unsafe { group_load(self.ctrl.ptr, self.pos) });\n        }\n        -1\n    }\n}\n\nimpl Iterator for RawIter {\n    type Item = i64;\n\n    #[inline]\n    fn next(inout self) -> Option<i64> {\n        let i = self.next_index();\n        if i < 0 { Option::None } else { Option::Some(i) }\n    }\n}\n// ---- end mod std::collections::raw_table ----\n}\n// ---- mod std::collections::btree_node ----\npub mod btree_node {\n// std::collections::btree_node: BTreeRaw<K, V, A>, the B-tree (0.20),\n// the engine of BTreeMap and BTreeSet (0.20), Rust's\n// B-tree. Nodes hold up to 11 keys and values inline (B = 6), internal\n// nodes 12 child pointers too; every node points at its parent and knows\n// its index there, so iteration needs no stack. Leaves and internal nodes\n// are allocated through A at their own sizes. The engine never compares\n// keys itself: a search takes `cmp`, a closure that compares the key\n");
        buf_str(out, c"// sought with the key it is given (negative: the sought one is smaller,\n// 0: equal, positive: larger), so one tree serves maps and sets, and\n// lookups by a borrowed form of the key.\n//\n// Positions are BHandles: a key-value pair (`idx` < the node's len) or an\n// edge, the place between two pairs (`idx` <= len; in a leaf, where an\n// insertion goes). A handle is valid until the tree changes, except the\n// one `insert_at` and `search` return for the next step.\n//\n// Insertion splits a full node around its middle (Rust's split points)\n// and passes the middle pair up, growing a new root at the top. Removal\n// swaps a pair of an internal node with its predecessor, a leaf's last,\n// and removes it there; a node left with fewer than 5 pairs takes one\n// from a sibling or merges with it (through the pair between them in the\n// parent), up the tree, and an empty root gives way to its only child.\n//\n// Safety: the methods taking a handle are `unsafe fn`: the caller\n// guarantees that the handle comes from this tree with no change to it\n// since (BTreeMap and BTreeSet keep to that). Nodes come only from\n// `node_alloc`; every pointer followed below\n// is the root, a child below its node's len + 1, or a parent, all live;\n// every key and value read is below its node's len (initialized). Node\n// fields are reached through raw pointers in `unsafe` blocks; the arrays\n// are indexed with checks; `read_key`, `read_val` and `write_val` check\n// that a handle is a pair.\n\nuse std::{Allocator, Drop, Eq, Gpa, Iterator, Option, drop, needs_drop, panic};\n\n// ---- B-tree nodes (0.20 implementation) ----\n\n// The pairs of a node, at most (2B - 1).\npub const BTREE_CAPACITY: i64 = 11;\n// The pairs of a node other than the root, at least (B - 1).\nconst BTREE_MIN_LEN: i64 = 5;\n// More than the height of any tree (6^40 pairs): the bound of the loops\n// that climb or descend it.\nconst BTREE_MAX_HEIGHT: i64 = 64;\n\n");
        buf_str(out, c"// A leaf; also the first part of an internal node (repr(C): an internal\n// node's pointer is its leaf part's).\n#[repr(C)]\npub struct BLeaf<K, V> {\n    parent: *BInternal<K, V>,\n    // its index among its parent's edges\n    parent_idx: i32,\n    len: i32,\n    keys: [K; 11],\n    vals: [V; 11],\n}\n\n#[repr(C)]\npub struct BInternal<K, V> {\n    data: BLeaf<K, V>,\n    edges: [*BLeaf<K, V>; 12],\n}\n\n// A position in the tree: pair or edge `idx` of `node`, at `height` (0:\n// a leaf).\npub struct BHandle<K, V> {\n    node: *BLeaf<K, V>,\n    height: i64,\n    idx: i64,\n}\n\n#[sealed]\npub struct BTreeRaw<K, V, A: Allocator = Gpa> {\n    // null for an empty tree\n    root: *BLeaf<K, V>,\n    // the root's height (leaves are 0)\n    height: i64,\n    len: i64,\n    alloc: A,\n}\n\nimpl<K, V> BHandle<K, V> {\n    // The handle of nothing: what a search of an empty tree, or a step\n    // past the end, gives.\n    #[inline]\n    pub fn none() -> BHandle<K, V> {\n        BHandle { node: 0 as *BLeaf<K, V>, height: 0, idx: 0 }\n    }\n\n    #[inline]\n    pub fn is_none(self) -> bool {\n        self.node == 0 as *BLeaf<K, V>\n    }\n\n    // Stops the program unless self is a pair of a node.\n    #[inline]\n    fn check_kv(self) {\n        if self.node == 0 as *BLeaf<K, V> || self.idx < 0\n            || self.idx >= unsafe { bt_len(self.node) } {\n            unsafe { panic(c\"BTreeRaw: the handle is not a key-value pair\") }\n        }\n    }\n\n    // The pair after leaf edge self, or none at the end.\n    pub unsafe fn next_kv(sink self) -> BHandle<K, V> {\n        let e = self;\n        if e.node == 0 as *BLeaf<K, V> {\n            return e;\n        }\n        var n = e.node;\n        var h = e.height;\n        var i = e.idx;\n        unsafe {\n            for _ in 0..BTREE_MAX_HEIGHT {\n                if i < bt_len(n) {\n                    break;\n                }\n                let p = n.parent as *BLeaf<K, V>;\n");
        buf_str(out, c"                if p == 0 as *BLeaf<K, V> {\n                    return BHandle::none();\n                }\n                i = n.parent_idx as i64;\n                n = p;\n                h += 1;\n            }\n        }\n        BHandle { node: n, height: h, idx: i }\n    }\n\n    // The pair before leaf edge self, or none at the start.\n    pub unsafe fn next_back_kv(sink self) -> BHandle<K, V> {\n        let e = self;\n        if e.node == 0 as *BLeaf<K, V> {\n            return e;\n        }\n        var n = e.node;\n        var h = e.height;\n        var i = e.idx;\n        unsafe {\n            for _ in 0..BTREE_MAX_HEIGHT {\n                if i != 0 {\n                    break;\n                }\n                let p = n.parent as *BLeaf<K, V>;\n                if p == 0 as *BLeaf<K, V> {\n                    return BHandle::none();\n                }\n                i = n.parent_idx as i64;\n                n = p;\n                h += 1;\n            }\n        }\n        BHandle { node: n, height: h, idx: i - 1 }\n    }\n\n    // The leaf edge just after pair self (checked).\n    pub unsafe fn next_leaf_edge(sink self) -> BHandle<K, V> {\n        let kv = self;\n        kv.check_kv();\n        if kv.height == 0 {\n            return BHandle { node: kv.node, height: 0, idx: kv.idx + 1 };\n        }\n        BHandle {\n            node: unsafe { bt_first_leaf(bt_edge(kv.node, kv.idx + 1), kv.height - 1) }, height: 0,\n            idx: 0\n        }\n    }\n\n    // The leaf edge just before pair self (checked).\n    pub unsafe fn prev_leaf_edge(sink self) -> BHandle<K, V> {\n        let kv = self;\n        kv.check_kv();\n        if kv.height == 0 {\n            return BHandle { node: kv.node, height: 0, idx: kv.idx };\n        }\n        let n = unsafe { bt_last_leaf(bt_edge(kv.node, kv.idx), kv.height - 1) };\n        BHandle { node: n, height: 0, idx: unsafe { bt_len(n) } }\n    }\n}\n\nimpl<K, V> Eq for BHandle<K, V> {\n");
        buf_str(out, c"    fn eq(self, other: BHandle<K, V>) -> bool {\n        self.node == other.node && self.idx == other.idx\n    }\n}\n\n// (the node of a handle as an internal node, and its fields: raw)\n#[inline]\nunsafe fn bt_int<K, V>(n: *BLeaf<K, V>) -> *BInternal<K, V> {\n    n as *BInternal<K, V>\n}\n\n#[inline]\nunsafe fn bt_len<K, V>(n: *BLeaf<K, V>) -> i64 {\n    n.len as i64\n}\n\n#[inline]\nunsafe fn bt_edge<K, V>(n: *BLeaf<K, V>, i: i64) -> *BLeaf<K, V> {\n    bt_int(n).edges[i]\n}\n\n// Sets edge i of internal node n to child c, and c's parent link.\n#[inline]\nunsafe fn bt_set_edge<K, V>(n: *BLeaf<K, V>, i: i64, c: *BLeaf<K, V>) {\n    bt_int(n).edges[i] = c;\n    c.parent = bt_int(n);\n    c.parent_idx = i as i32;\n}\n\n// The leftmost leaf of the subtree of n, at height h.\nunsafe fn bt_first_leaf<K, V>(n: *BLeaf<K, V>, h: i64) -> *BLeaf<K, V> {\n    var m = n;\n    for _ in 0..h {\n        m = bt_edge(m, 0);\n    }\n    m\n}\n\n// The rightmost leaf of the subtree of n, at height h.\nunsafe fn bt_last_leaf<K, V>(n: *BLeaf<K, V>, h: i64) -> *BLeaf<K, V> {\n    var m = n;\n    for _ in 0..h {\n        m = bt_edge(m, bt_len(m));\n    }\n    m\n}\n\nimpl<K, V, A: Allocator> BTreeRaw<K, V, A> {\n    // An empty tree on allocator a; it allocates at the first insertion.\n    pub fn new_in(a: sink A) -> BTreeRaw<K, V, A> {\n        BTreeRaw { root: 0 as *BLeaf<K, V>, height: 0, len: 0, alloc: a }\n    }\n\n    #[inline]\n    pub fn len(self) -> i64 {\n        self.len\n    }\n\n    #[inline]\n    pub fn is_empty(self) -> bool {\n        self.len == 0\n    }\n\n    // The height of the root (0: one leaf, or none).\n    pub fn height(self) -> i64 {\n        self.height\n    }\n\n    pub fn allocator(self) -> A {\n        self.alloc\n    }\n\n    // A new empty node of height h (a leaf when 0).\n    fn node_alloc(inout self, h: i64) -> *BLeaf<K, V> {\n        let n = if h == 0 {\n            self.alloc.alloc(size_of(BLeaf<K, V>), align_of(BLeaf<K, V>)) as *BLeaf<K, V>\n");
        buf_str(out, c"        } else {\n            self.alloc.alloc(size_of(BInternal<K, V>), align_of(BInternal<K, V>)) as *BLeaf<K, V>\n        };\n        unsafe {\n            n.parent = 0 as *BInternal<K, V>;\n            n.parent_idx = 0;\n            n.len = 0;\n        }\n        n\n    }\n\n    // Gives back node n of height h.\n    unsafe fn node_free(inout self, n: *BLeaf<K, V>, h: i64) {\n        if h == 0 {\n            self.alloc.free(n as *u8, size_of(BLeaf<K, V>), align_of(BLeaf<K, V>));\n        } else {\n            self.alloc.free(n as *u8, size_of(BInternal<K, V>), align_of(BInternal<K, V>));\n        }\n    }\n\n    // The pair whose key cmp finds equal, as (true, its handle), else\n    // (false, the leaf edge where it would be inserted): one descent,\n    // each node searched linearly. An empty tree gives (false, none).\n    pub fn search<F: FnMut(let K) -> i64>(self, cmp: sink F) -> (bool, BHandle<K, V>) {\n        var n = self.root;\n        if n == 0 as *BLeaf<K, V> {\n            return (false, BHandle::none());\n        }\n        var h = self.height;\n        unsafe {\n            for _ in 0..self.height + 1 {\n                let len = bt_len(n);\n                var i = 0;\n                for _ in 0..len {\n                    let c = cmp(*(&n.keys[i] as *K));\n                    if c == 0 {\n                        return (true, BHandle { node: n, height: h, idx: i });\n                    }\n                    if c < 0 {\n                        break;\n                    }\n                    i += 1;\n                }\n                if h == 0 {\n                    return (false, BHandle { node: n, height: 0, idx: i });\n                }\n                n = bt_edge(n, i);\n                h -= 1;\n            }\n        }\n        (false, BHandle::none())\n    }\n\n    // Stops the program unless h is a pair.\n    #[inline]\n    fn check_kv(self, h: BHandle<K, V>) {\n        h.check_kv();\n    }\n\n    // The key of pair h (checked).\n");
        buf_str(out, c"    #[inline]\n    pub unsafe fn read_key(self, h: sink BHandle<K, V>) -> K {\n        self.check_kv(h);\n        unsafe { h.node.keys[h.idx] }\n    }\n\n    // The value of pair h (checked).\n    #[inline]\n    pub unsafe fn read_val(self, h: sink BHandle<K, V>) -> V {\n        self.check_kv(h);\n        unsafe { h.node.vals[h.idx] }\n    }\n\n    // Replaces the value of pair h (checked).\n    #[inline]\n    pub unsafe fn write_val(inout self, h: sink BHandle<K, V>, v: sink V) {\n        self.check_kv(h);\n        unsafe {\n            h.node.vals[h.idx] = v;\n        }\n    }\n\n    // A pointer to the value of pair h (checked); raw, valid until the\n    // tree changes.\n    #[inline]\n    pub unsafe fn val_ptr(self, h: sink BHandle<K, V>) -> *V {\n        self.check_kv(h);\n        unsafe { &h.node.vals[h.idx] }\n    }\n\n    // Inserts the pair (k, v) at leaf edge `edge` (from `search`, which\n    // found no equal key, with no change to the tree since); returns the\n    // handle of the new pair.\n    pub unsafe fn insert_at(inout self, edge: sink BHandle<K, V>, k: sink K, v: sink V) -> BHandle<K, V> {\n        if self.root == 0 as *BLeaf<K, V> {\n            let n = self.node_alloc(0);\n            unsafe {\n                n.keys[0] = k;\n                n.vals[0] = v;\n                n.len = 1;\n            }\n            self.root = n;\n            self.height = 0;\n            self.len = 1;\n            return BHandle { node: n, height: 0, idx: 0 };\n        }\n        if edge.node == 0 as *BLeaf<K, V> || edge.height != 0 || edge.idx < 0\n            || edge.idx > unsafe { bt_len(edge.node) } {\n            unsafe { panic(c\"BTreeRaw::insert_at: the handle is not a leaf edge\") }\n        }\n        self.len += 1;\n        let leaf = edge.node;\n        let at = edge.idx;\n        unsafe {\n            if bt_len(leaf) < BTREE_CAPACITY {\n                bt_insert_fit(leaf, at, k, v);\n                return BHandle { node: leaf, height: 0, idx: at };\n");
        buf_str(out, c"            }\n            // (full: split, then the middle pair and the new right node\n            // go up)\n            let (mid, place) = bt_splitpoint(at);\n            let right = self.node_alloc(0);\n            let (mk, mv) = bt_split_kvs(leaf, right, mid);\n            let result = if place < 0 {\n                bt_insert_fit(leaf, at, k, v);\n                BHandle { node: leaf, height: 0, idx: at }\n            } else {\n                bt_insert_fit(right, place, k, v);\n                BHandle { node: right, height: 0, idx: place }\n            };\n            self.insert_up(leaf, 0, mk, mv, right);\n            result\n        }\n    }\n\n    // Puts pair (k, v) and the node `right` (of height h) into the parent\n    // of `left` (h), just after left, splitting full parents up to a new\n    // root.\n    unsafe fn insert_up(inout self, left: *BLeaf<K, V>, h: i64, k: sink K, v: sink V,\n        right: *BLeaf<K, V>) {\n        var l = left;\n        var r = right;\n        var kk = k;\n        var vv = v;\n        var height = h;\n        for _ in 0..BTREE_MAX_HEIGHT {\n            let p = l.parent as *BLeaf<K, V>;\n            if p == 0 as *BLeaf<K, V> {\n                // (l was the root: a new root over l and r)\n                let root = self.node_alloc(height + 1);\n                root.keys[0] = kk;\n                root.vals[0] = vv;\n                root.len = 1;\n                bt_set_edge(root, 0, l);\n                bt_set_edge(root, 1, r);\n                self.root = root;\n                self.height = height + 1;\n                return;\n            }\n            let at = l.parent_idx as i64;\n            if bt_len(p) < BTREE_CAPACITY {\n                bt_insert_fit_internal(p, at, kk, vv, r);\n                return;\n            }\n            let (mid, place) = bt_splitpoint(at);\n            let pr = self.node_alloc(height + 1);\n            let (mk, mv) = bt_split_kvs(p, pr, mid);\n");
        buf_str(out, c"            // (the edges after the middle pair move to the new node)\n            let plen = bt_len(pr);\n            for j in 0..plen + 1 {\n                bt_set_edge(pr, j, bt_edge(p, mid + 1 + j));\n            }\n            if place < 0 {\n                bt_insert_fit_internal(p, at, kk, vv, r);\n            } else {\n                bt_insert_fit_internal(pr, place, kk, vv, r);\n            }\n            l = p;\n            r = pr;\n            kk = mk;\n            vv = mv;\n            height += 1;\n        }\n    }\n\n    // Removes pair h (checked) and returns it.\n    pub unsafe fn remove_kv(inout self, h: sink BHandle<K, V>) -> (K, V) {\n        self.check_kv(h);\n        unsafe {\n            var leaf = h.node;\n            var idx = h.idx;\n            if h.height > 0 {\n                // (its predecessor, the last pair of the left subtree's\n                // last leaf, takes its place; then that leaf loses its\n                // last pair, the one removed)\n                let pred = bt_last_leaf(bt_edge(h.node, h.idx), h.height - 1);\n                let pi = bt_len(pred) - 1;\n                let k = h.node.keys[h.idx];\n                let v = h.node.vals[h.idx];\n                h.node.keys[h.idx] = pred.keys[pi];\n                h.node.vals[h.idx] = pred.vals[pi];\n                pred.keys[pi] = k;\n                pred.vals[pi] = v;\n                leaf = pred;\n                idx = pi;\n            }\n            let k = leaf.keys[idx];\n            let v = leaf.vals[idx];\n            let len = bt_len(leaf);\n            for j in idx..len - 1 {\n                leaf.keys[j] = leaf.keys[j + 1];\n                leaf.vals[j] = leaf.vals[j + 1];\n            }\n            leaf.len = (len - 1) as i32;\n            self.len -= 1;\n            self.rebalance(leaf, 0);\n            (k, v)\n        }\n    }\n\n    // Restores the minimum length from node n (height h) up: a node below\n");
        buf_str(out, c"    // it takes a pair from a sibling or merges with it; an empty root\n    // gives way to its child, or the tree becomes empty.\n    unsafe fn rebalance(inout self, node: *BLeaf<K, V>, height: i64) {\n        var n = node;\n        var h = height;\n        for _ in 0..BTREE_MAX_HEIGHT {\n            let p = n.parent as *BLeaf<K, V>;\n            if p == 0 as *BLeaf<K, V> {\n                if bt_len(n) == 0 {\n                    if h > 0 {\n                        let child = bt_edge(n, 0);\n                        child.parent = 0 as *BInternal<K, V>;\n                        child.parent_idx = 0;\n                        self.root = child;\n                        self.height = h - 1;\n                    } else {\n                        self.root = 0 as *BLeaf<K, V>;\n                        self.height = 0;\n                    }\n                    self.node_free(n, h);\n                }\n                return;\n            }\n            if bt_len(n) >= BTREE_MIN_LEN {\n                return;\n            }\n            let i = n.parent_idx as i64;\n            if i > 0 {\n                let left = bt_edge(p, i - 1);\n                if bt_len(left) + 1 + bt_len(n) <= BTREE_CAPACITY {\n                    self.merge(p, i - 1, h);\n                } else {\n                    bt_steal_left(p, i, h);\n                    return;\n                }\n            } else {\n                let right = bt_edge(p, 1);\n                if bt_len(n) + 1 + bt_len(right) <= BTREE_CAPACITY {\n                    self.merge(p, 0, h);\n                } else {\n                    bt_steal_right(p, 0, h);\n                    return;\n                }\n            }\n            n = p;\n            h += 1;\n        }\n    }\n\n    // Merges children i and i + 1 of internal node p (their height h) and\n    // the pair between them into child i; frees child i + 1.\n    unsafe fn merge(inout self, p: *BLeaf<K, V>, i: i64, h: i64) {\n        let l = bt_edge(p, i);\n");
        buf_str(out, c"        let r = bt_edge(p, i + 1);\n        let ll = bt_len(l);\n        let rl = bt_len(r);\n        l.keys[ll] = p.keys[i];\n        l.vals[ll] = p.vals[i];\n        for j in 0..rl {\n            l.keys[ll + 1 + j] = r.keys[j];\n            l.vals[ll + 1 + j] = r.vals[j];\n        }\n        if h > 0 {\n            for j in 0..rl + 1 {\n                bt_set_edge(l, ll + 1 + j, bt_edge(r, j));\n            }\n        }\n        l.len = (ll + 1 + rl) as i32;\n        let pl = bt_len(p);\n        for j in i..pl - 1 {\n            p.keys[j] = p.keys[j + 1];\n            p.vals[j] = p.vals[j + 1];\n        }\n        for j in i + 1..pl {\n            bt_set_edge(p, j, bt_edge(p, j + 1));\n        }\n        p.len = (pl - 1) as i32;\n        self.node_free(r, h);\n    }\n\n    // The leaf edge before the first pair, or none.\n    pub fn first_leaf_edge(self) -> BHandle<K, V> {\n        if self.root == 0 as *BLeaf<K, V> {\n            return BHandle::none();\n        }\n        BHandle { node: unsafe { bt_first_leaf(self.root, self.height) }, height: 0, idx: 0 }\n    }\n\n    // The leaf edge after the last pair, or none.\n    pub fn last_leaf_edge(self) -> BHandle<K, V> {\n        if self.root == 0 as *BLeaf<K, V> {\n            return BHandle::none();\n        }\n        let n = unsafe { bt_last_leaf(self.root, self.height) };\n        BHandle { node: n, height: 0, idx: unsafe { bt_len(n) } }\n    }\n\n    // The leaf edge before the first pair whose key is not below a bound\n    // (cmp compares the bound with a key); with `strict`, before the first\n    // pair whose key is above it. A range search is two: the pairs of\n    // a..b lie from lower_edge(a, false) to lower_edge(b, false) (a..=b:\n    // to lower_edge(b, true)), stepped through with the handles' next_kv\n    // and next_leaf_edge until the front edge is the back one.\n    pub fn lower_edge<F: FnMut(let K) -> i64>(self, cmp: sink F, strict: bool) -> BHandle<K, V> {\n        var n = self.root;\n");
        buf_str(out, c"        if n == 0 as *BLeaf<K, V> {\n            return BHandle::none();\n        }\n        var h = self.height;\n        unsafe {\n            for _ in 0..self.height + 1 {\n                let len = bt_len(n);\n                var i = 0;\n                for _ in 0..len {\n                    let c = cmp(*(&n.keys[i] as *K));\n                    if c < 0 || (c == 0 && !strict) {\n                        break;\n                    }\n                    i += 1;\n                }\n                if h == 0 {\n                    return BHandle { node: n, height: 0, idx: i };\n                }\n                n = bt_edge(n, i);\n                h -= 1;\n            }\n        }\n        BHandle::none()\n    }\n\n    // The pairs in order (copies), from both ends: a view of the tree.\n    #[views(self)]\n    pub fn iter(self) -> BTreeIter<K, V, A> {\n        BTreeIter { tree: self, front: self.first_leaf_edge(), back: self.last_leaf_edge() }\n    }\n\n    // The pairs between leaf edges front and back (front first, as\n    // lower_edge gives them): a view of the tree. The caller guarantees\n    // that both come from this tree with no change since.\n    #[views(self)]\n    pub unsafe fn iter_between(self, front: sink BHandle<K, V>, back: sink BHandle<K, V>) -> BTreeIter<K, V, A> {\n        BTreeIter { tree: self, front: front, back: back }\n    }\n\n    // Frees every node (post-order, through the parent links: no\n    // recursion, no stack); the tree is empty, and may be used again.\n    pub fn free(inout self) {\n        if self.root == 0 as *BLeaf<K, V> {\n            return;\n        }\n        unsafe {\n            var n = bt_first_leaf(self.root, self.height);\n            var h = 0;\n            // (one node freed a round; a node holds a pair at least)\n            for _ in 0..self.len + 1 {\n                let p = n.parent as *BLeaf<K, V>;\n                let i = n.parent_idx as i64;\n                if needs_drop::<K>() || needs_drop::<V>() {\n");
        buf_str(out, c"                    for j in 0..bt_len(n) {\n                        drop(n.keys[j]);\n                        drop(n.vals[j]);\n                    }\n                }\n                self.node_free(n, h);\n                if p == 0 as *BLeaf<K, V> {\n                    break;\n                }\n                n = p;\n                h += 1;\n                if i < bt_len(n) {\n                    // (the next child's subtree, from its first leaf)\n                    n = bt_first_leaf(bt_edge(n, i + 1), h - 1);\n                    h = 0;\n                }\n            }\n        }\n        self.root = 0 as *BLeaf<K, V>;\n        self.height = 0;\n        self.len = 0;\n    }\n\n    // (tests) The tree's invariants: \"\" when they hold, else the first\n    // broken. Lengths (5 to 11 below the root, 1 to 11 at it), parent\n    // links, every leaf at the same depth, keys in increasing order\n    // (`less(a, b)`: a's key below b's), the count.\n    pub fn check<F: FnMut(let K, let K) -> bool>(self, less: sink F) -> [u8] {\n        if self.root == 0 as *BLeaf<K, V> {\n            return if self.len == 0 { \"\" } else { \"an empty tree has a length\" };\n        }\n        unsafe {\n            if self.root.parent != 0 as *BInternal<K, V> {\n                return \"the root has a parent\";\n            }\n            // (every pair in order, through the leaf edges; each node's\n            // checks at its first pair, or at its leaf edge when empty)\n            var count = 0;\n            var e = self.first_leaf_edge();\n            var prev: BHandle<K, V> = BHandle::none();\n            for _ in 0..self.len + 1 {\n                if e.node.len == 0 && e.node != self.root {\n                    return \"an empty node below the root\";\n                }\n                let kv = e.next_kv();\n                if kv.is_none() {\n                    break;\n                }\n                let n = kv.node;\n                let len = bt_len(n);\n");
        buf_str(out, c"                if len > BTREE_CAPACITY || (n != self.root && len < BTREE_MIN_LEN) || len < 1 {\n                    return \"a node's length is out of bounds\";\n                }\n                if kv.height > 0 {\n                    for j in 0..len + 1 {\n                        let c = bt_edge(n, j);\n                        if c.parent as *BLeaf<K, V> != n || c.parent_idx as i64 != j {\n                            return \"a child's parent link is wrong\";\n                        }\n                    }\n                }\n                if !prev.is_none()\n                    && !less(*(&prev.node.keys[prev.idx] as *K), *(&n.keys[kv.idx] as *K)) {\n                    return \"keys out of order\";\n                }\n                // (the depth of every leaf is the root's height)\n                var d = 0;\n                var m = e.node;\n                for _ in 0..BTREE_MAX_HEIGHT {\n                    if m.parent == 0 as *BInternal<K, V> {\n                        break;\n                    }\n                    m = m.parent as *BLeaf<K, V>;\n                    d += 1;\n                }\n                if d != self.height || e.height != 0 {\n                    return \"a leaf is not at the bottom\";\n                }\n                count += 1;\n                prev = kv;\n                e = kv.next_leaf_edge();\n            }\n            if count != self.len {\n                return \"the length is not the number of pairs\";\n            }\n        }\n        \"\"\n    }\n}\n\n// The tree's drop: its pairs' drops, then its nodes given back.\nimpl<K, V, A: Allocator> Drop for BTreeRaw<K, V, A> {\n    fn drop(inout self) {\n        self.free();\n    }\n}\n\n// The pairs of a tree in order, as (key, value) copies (`iter`,\n// `iter_between`); both ends move (`next`, `next_back`) until they meet.\n// A view of the tree: its handles stay valid while it lives.\npub struct BTreeIter<K, V, A: Allocator> {\n    tree: let BTreeRaw<K, V, A>,\n");
        buf_str(out, c"    front: BHandle<K, V>,\n    back: BHandle<K, V>,\n}\n\nimpl<K, V, A: Allocator> BTreeIter<K, V, A> {\n    // The last pair not yet given, or none.\n    pub fn next_back(inout self) -> Option<(K, V)> {\n        if self.front == self.back || self.back.is_none() {\n            return Option::None;\n        }\n        // (the handles are the viewed tree's, which cannot change)\n        unsafe {\n            let kv = self.back.next_back_kv();\n            self.back = kv.prev_leaf_edge();\n            Option::Some((kv.node.keys[kv.idx], kv.node.vals[kv.idx]))\n        }\n    }\n}\n\nimpl<K, V, A: Allocator> Iterator for BTreeIter<K, V, A> {\n    type Item = (K, V);\n\n    fn next(inout self) -> Option<(K, V)> {\n        if self.front == self.back || self.front.is_none() {\n            return Option::None;\n        }\n        // (the handles are the viewed tree's, which cannot change)\n        unsafe {\n            let kv = self.front.next_kv();\n            self.front = kv.next_leaf_edge();\n            Option::Some((kv.node.keys[kv.idx], kv.node.vals[kv.idx]))\n        }\n    }\n}\n\n// Rust's split points: splitting a full node to insert at edge `at`, the\n// pair that goes up (`mid`) and where the insertion goes: edge `at` of\n// the left node (-1), or the edge of the right node (>= 0).\n#[inline]\nfn bt_splitpoint(at: i64) -> (i64, i64) {\n    if at < 5 {\n        (4, -1)\n    } else if at == 5 {\n        (5, -1)\n    } else if at == 6 {\n        (5, 0)\n    } else {\n        (6, at - 7)\n    }\n}\n\n// Moves the pairs after `mid` of full node n into the empty node r and\n// returns pair mid; n keeps the pairs before it.\nunsafe fn bt_split_kvs<K, V>(n: *BLeaf<K, V>, r: *BLeaf<K, V>, mid: i64) -> (K, V) {\n    let len = bt_len(n);\n    let rl = len - mid - 1;\n    for j in 0..rl {\n        r.keys[j] = n.keys[mid + 1 + j];\n        r.vals[j] = n.vals[mid + 1 + j];\n    }\n    r.len = rl as i32;\n    n.len = mid as i32;\n    (n.keys[mid], n.vals[mid])\n}\n\n");
        buf_str(out, c"// Inserts (k, v) at edge `at` of leaf n, which has room.\nunsafe fn bt_insert_fit<K, V>(n: *BLeaf<K, V>, at: i64, k: sink K, v: sink V) {\n    let len = bt_len(n);\n    for t in 0..len - at {\n        let j = len - t;\n        n.keys[j] = n.keys[j - 1];\n        n.vals[j] = n.vals[j - 1];\n    }\n    n.keys[at] = k;\n    n.vals[at] = v;\n    n.len = (len + 1) as i32;\n}\n\n// Inserts (k, v) at pair `at` of internal node n, which has room, and\n// child r at edge at + 1.\nunsafe fn bt_insert_fit_internal<K, V>(n: *BLeaf<K, V>, at: i64, k: sink K, v: sink V,\n    r: *BLeaf<K, V>) {\n    let len = bt_len(n);\n    for t in 0..len - at {\n        let j = len + 1 - t;\n        bt_set_edge(n, j, bt_edge(n, j - 1));\n    }\n    bt_insert_fit(n, at, k, v);\n    bt_set_edge(n, at + 1, r);\n}\n\n// Child i of p (height h) takes the last pair of child i - 1 through the\n// pair between them (a rotation to the right).\nunsafe fn bt_steal_left<K, V>(p: *BLeaf<K, V>, i: i64, h: i64) {\n    let l = bt_edge(p, i - 1);\n    let n = bt_edge(p, i);\n    let ll = bt_len(l);\n    let nl = bt_len(n);\n    for t in 0..nl {\n        let j = nl - t;\n        n.keys[j] = n.keys[j - 1];\n        n.vals[j] = n.vals[j - 1];\n    }\n    n.keys[0] = p.keys[i - 1];\n    n.vals[0] = p.vals[i - 1];\n    p.keys[i - 1] = l.keys[ll - 1];\n    p.vals[i - 1] = l.vals[ll - 1];\n    if h > 0 {\n        for t in 0..nl + 1 {\n            let j = nl + 1 - t;\n            bt_set_edge(n, j, bt_edge(n, j - 1));\n        }\n        bt_set_edge(n, 0, bt_edge(l, ll));\n    }\n    l.len = (ll - 1) as i32;\n    n.len = (nl + 1) as i32;\n}\n\n// Child i of p (height h) takes the first pair of child i + 1 through the\n// pair between them (a rotation to the left).\nunsafe fn bt_steal_right<K, V>(p: *BLeaf<K, V>, i: i64, h: i64) {\n    let n = bt_edge(p, i);\n    let r = bt_edge(p, i + 1);\n    let nl = bt_len(n);\n    let rl = bt_len(r);\n    n.keys[nl] = p.keys[i];\n    n.vals[nl] = p.vals[i];\n");
        buf_str(out, c"    p.keys[i] = r.keys[0];\n    p.vals[i] = r.vals[0];\n    for j in 0..rl - 1 {\n        r.keys[j] = r.keys[j + 1];\n        r.vals[j] = r.vals[j + 1];\n    }\n    if h > 0 {\n        bt_set_edge(n, nl + 1, bt_edge(r, 0));\n        for j in 0..rl {\n            bt_set_edge(r, j, bt_edge(r, j + 1));\n        }\n    }\n    n.len = (nl + 1) as i32;\n    r.len = (rl - 1) as i32;\n}\n// ---- end mod std::collections::btree_node ----\n}\n// ---- mod std::collections::btree_map ----\npub mod btree_map {\n// std::collections::btree_map: BTreeMap and BTreeSet (0.20), ordered by\n// their keys' Ord, on the B-tree engine (btree_node.tach).\n\nuse std::{Allocator, Ambient, Debug, Drop, Fmt, Gpa, Iterator, Option, Ord};\nuse super::btree_node::{BTreeIter, BTreeRaw};\n\n// ---- BTreeMap and BTreeSet (0.20) ----\n\n// A map from K to V kept in key order (Rust's BTreeMap: 11 pairs a node,\n// a linear search in each). `iter()` and `range(lo, hi)` give the pairs\n// in order; `first_key_value`, `pop_first` and their `last` forms the\n// ends.\n#[sealed]\npub struct BTreeMap<K: Ord, V, A: Allocator = Gpa> {\n    tree: BTreeRaw<K, V, A>,\n}\n\nimpl<K: Ord, V, A: Allocator> BTreeMap<K, V, A> {\n    // An empty map on allocator a.\n    pub fn new_in(a: sink A) -> BTreeMap<K, V, A> {\n        BTreeMap { tree: BTreeRaw::new_in(a) }\n    }\n\n    #[inline]\n    pub fn len(self) -> i64 {\n        self.tree.len()\n    }\n\n    #[inline]\n    pub fn is_empty(self) -> bool {\n        self.tree.len() == 0\n    }\n\n    // The value of key, as a copy, if it has one.\n    pub fn get(self, key: sink K) -> Option<V> {\n        let (found, h) = self.tree.search(|k: K| key.cmp(k));\n        // (h: from this search)\n        if found { Option::Some(unsafe { self.tree.read_val(h) }) } else { Option::None }\n    }\n\n    pub fn contains_key(self, key: sink K) -> bool {\n        self.tree.search(|k: K| key.cmp(k)).0\n    }\n\n    // The value of key in place, a writable view of one element (as\n");
        buf_str(out, c"    // HashMap's get_mut), until the map's next insert or remove.\n    #[views(self)]\n    pub fn get_mut(inout self, key: sink K) -> Option<inout [V]> {\n        let (found, h) = self.tree.search(|k: K| key.cmp(k));\n        if !found {\n            return Option::None;\n        }\n        let p = unsafe { self.tree.val_ptr(h) };\n        Option::Some(unsafe { &p[0..1] })\n    }\n\n    // Sets the value of key; returns its old value, if it had one.\n    #[stores(key, value)]\n    pub fn insert(inout self, key: sink K, value: sink V) -> Option<V> {\n        let (found, h) = self.tree.search(|k: K| key.cmp(k));\n        if found {\n            // (the old value moves out, the new one in)\n            let p = unsafe { self.tree.val_ptr(h) };\n            let old = unsafe { *p };\n            unsafe {\n                *p = value;\n            }\n            return Option::Some(old);\n        }\n        unsafe {\n            self.tree.insert_at(h, key, value);\n        }\n        Option::None\n    }\n\n    // Removes key; returns its value, if it had one (the stored key is\n    // dropped).\n    pub fn remove(inout self, key: sink K) -> Option<V> {\n        let (found, h) = self.tree.search(|k: K| key.cmp(k));\n        if !found {\n            return Option::None;\n        }\n        let (_, v) = unsafe { self.tree.remove_kv(h) };\n        Option::Some(v)\n    }\n\n    // The smallest key and its value (copies).\n    pub fn first_key_value(self) -> Option<(K, V)> {\n        self.iter().next()\n    }\n\n    // The largest key and its value (copies).\n    pub fn last_key_value(self) -> Option<(K, V)> {\n        self.iter().next_back()\n    }\n\n    // Removes the pair with the smallest key and returns it.\n    pub fn pop_first(inout self) -> Option<(K, V)> {\n        if self.tree.len() == 0 {\n            return Option::None;\n        }\n        // (the first pair of the tree as it is)\n        unsafe {\n            let kv = self.tree.first_leaf_edge().next_kv();\n");
        buf_str(out, c"            Option::Some(self.tree.remove_kv(kv))\n        }\n    }\n\n    // Removes the pair with the largest key and returns it.\n    pub fn pop_last(inout self) -> Option<(K, V)> {\n        if self.tree.len() == 0 {\n            return Option::None;\n        }\n        unsafe {\n            let kv = self.tree.last_leaf_edge().next_back_kv();\n            Option::Some(self.tree.remove_kv(kv))\n        }\n    }\n\n    // The pairs in key order (copies): a view of the map; `next_back`\n    // from the end.\n    #[views(self)]\n    pub fn iter(self) -> BTreeIter<K, V, A> {\n        self.tree.iter()\n    }\n\n    // The pairs whose keys are in [lo, hi), in order (Rust's\n    // `range(lo..hi)`; `range_inclusive` for [lo, hi]).\n    #[views(self)]\n    pub fn range(self, lo: sink K, hi: sink K) -> BTreeIter<K, V, A> {\n        let front = self.tree.lower_edge(|k: K| lo.cmp(k), false);\n        let back = self.tree.lower_edge(|k: K| hi.cmp(k), false);\n        let ok = !(lo.cmp(hi) > 0);\n        // (both from this tree, as it is)\n        unsafe { self.tree.iter_between(front, if ok { back } else { front }) }\n    }\n\n    // The pairs whose keys are in [lo, hi], in order.\n    #[views(self)]\n    pub fn range_inclusive(self, lo: sink K, hi: sink K) -> BTreeIter<K, V, A> {\n        let front = self.tree.lower_edge(|k: K| lo.cmp(k), false);\n        let back = self.tree.lower_edge(|k: K| hi.cmp(k), true);\n        let ok = !(lo.cmp(hi) > 0);\n        unsafe { self.tree.iter_between(front, if ok { back } else { front }) }\n    }\n\n    // Removes every pair (dropped) and gives the memory back.\n    pub fn clear(inout self) {\n        self.tree.free();\n    }\n\n    // The same as clear.\n    pub fn free(inout self) {\n        self.tree.free();\n    }\n\n    pub fn allocator(self) -> A {\n        self.tree.allocator()\n    }\n\n    // (tests) The tree's invariants: \"\" when they hold.\n    pub fn check(self) -> [u8] {\n        self.tree.check(|a: K, b: K| a.cmp(b) < 0)\n");
        buf_str(out, c"    }\n\n    // (tests) The tree's height.\n    pub fn height(self) -> i64 {\n        self.tree.height()\n    }\n}\n\nimpl<K: Ord, V, A: Allocator> Drop for BTreeMap<K, V, A> {\n    fn drop(inout self) {\n        self.tree.free();\n    }\n}\n\nimpl<K: Ord, V, A: Allocator + Ambient> BTreeMap<K, V, A> {\n    #[ambient(\"BTreeMap::new_in(gpa)\")]\n    pub fn new() -> BTreeMap<K, V, A> {\n        BTreeMap::new_in(A::ambient())\n    }\n}\n\n// `{k: v, ...}` in key order.\nimpl<K: Ord + Debug, V: Debug, A: Allocator> Debug for BTreeMap<K, V, A> {\n    fn fmt_debug(self, f: inout Fmt) {\n        f.byte('{');\n        var first = true;\n        for (k, v) in self.iter() {\n            if !first {\n                f.str(\", \");\n            }\n            first = false;\n            f.debug(k);\n            f.str(\": \");\n            f.debug(v);\n        }\n        f.byte('}');\n    }\n}\n\n// A set of T kept in order (Rust's BTreeSet), a BTreeMap<T, ()>.\n#[sealed]\npub struct BTreeSet<T: Ord, A: Allocator = Gpa> {\n    tree: BTreeRaw<T, (), A>,\n}\n\nimpl<T: Ord, A: Allocator> BTreeSet<T, A> {\n    pub fn new_in(a: sink A) -> BTreeSet<T, A> {\n        BTreeSet { tree: BTreeRaw::new_in(a) }\n    }\n\n    #[inline]\n    pub fn len(self) -> i64 {\n        self.tree.len()\n    }\n\n    #[inline]\n    pub fn is_empty(self) -> bool {\n        self.tree.len() == 0\n    }\n\n    pub fn contains(self, x: sink T) -> bool {\n        self.tree.search(|k: T| x.cmp(k)).0\n    }\n\n    // Adds x; false when the set had it already (x is dropped then).\n    #[stores(x)]\n    pub fn insert(inout self, x: sink T) -> bool {\n        let (found, h) = self.tree.search(|k: T| x.cmp(k));\n        if found {\n            return false;\n        }\n        unsafe {\n            self.tree.insert_at(h, x, ());\n        }\n        true\n    }\n\n    // Removes x; false when the set did not have it.\n    pub fn remove(inout self, x: sink T) -> bool {\n");
        buf_str(out, c"        let (found, h) = self.tree.search(|k: T| x.cmp(k));\n        if !found {\n            return false;\n        }\n        unsafe {\n            self.tree.remove_kv(h);\n        }\n        true\n    }\n\n    // The smallest value (a copy).\n    pub fn first(self) -> Option<T> {\n        match self.tree.iter().next() {\n            Option::Some(e) => Option::Some(e.0),\n            Option::None => Option::None,\n        }\n    }\n\n    // The largest value (a copy).\n    pub fn last(self) -> Option<T> {\n        match self.tree.iter().next_back() {\n            Option::Some(e) => Option::Some(e.0),\n            Option::None => Option::None,\n        }\n    }\n\n    pub fn pop_first(inout self) -> Option<T> {\n        if self.tree.len() == 0 {\n            return Option::None;\n        }\n        unsafe {\n            let kv = self.tree.first_leaf_edge().next_kv();\n            Option::Some(self.tree.remove_kv(kv).0)\n        }\n    }\n\n    pub fn pop_last(inout self) -> Option<T> {\n        if self.tree.len() == 0 {\n            return Option::None;\n        }\n        unsafe {\n            let kv = self.tree.last_leaf_edge().next_back_kv();\n            Option::Some(self.tree.remove_kv(kv).0)\n        }\n    }\n\n    // The values in order (copies): a view of the set.\n    #[views(self)]\n    pub fn iter(self) -> BTreeSetIter<T, A> {\n        BTreeSetIter { it: self.tree.iter() }\n    }\n\n    // The values in [lo, hi), in order.\n    #[views(self)]\n    pub fn range(self, lo: sink T, hi: sink T) -> BTreeSetIter<T, A> {\n        let front = self.tree.lower_edge(|k: T| lo.cmp(k), false);\n        let back = self.tree.lower_edge(|k: T| hi.cmp(k), false);\n        let ok = !(lo.cmp(hi) > 0);\n        BTreeSetIter { it: unsafe { self.tree.iter_between(front, if ok { back } else { front }) } }\n    }\n\n    pub fn clear(inout self) {\n        self.tree.free();\n    }\n\n    pub fn free(inout self) {\n        self.tree.free();\n    }\n}\n\n");
        buf_str(out, c"impl<T: Ord, A: Allocator> Drop for BTreeSet<T, A> {\n    fn drop(inout self) {\n        self.tree.free();\n    }\n}\n\nimpl<T: Ord, A: Allocator + Ambient> BTreeSet<T, A> {\n    #[ambient(\"BTreeSet::new_in(gpa)\")]\n    pub fn new() -> BTreeSet<T, A> {\n        BTreeSet::new_in(A::ambient())\n    }\n}\n\n// A set's values in order: a view of the set.\npub struct BTreeSetIter<T, A: Allocator> {\n    it: BTreeIter<T, (), A>,\n}\n\nimpl<T, A: Allocator> BTreeSetIter<T, A> {\n    pub fn next_back(inout self) -> Option<T> {\n        match self.it.next_back() {\n            Option::Some(e) => Option::Some(e.0),\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl<T, A: Allocator> Iterator for BTreeSetIter<T, A> {\n    type Item = T;\n\n    fn next(inout self) -> Option<T> {\n        match self.it.next() {\n            Option::Some(e) => Option::Some(e.0),\n            Option::None => Option::None,\n        }\n    }\n}\n\n// `{a, b, ...}` in order.\nimpl<T: Ord + Debug, A: Allocator> Debug for BTreeSet<T, A> {\n    fn fmt_debug(self, f: inout Fmt) {\n        f.byte('{');\n        var first = true;\n        for x in self.iter() {\n            if !first {\n                f.str(\", \");\n            }\n            first = false;\n            f.debug(x);\n        }\n        f.byte('}');\n    }\n}\n// ---- end mod std::collections::btree_map ----\n}\n// ---- mod std::collections::group ----\npub mod group {\n// std::collections::group: the control bytes of a Swiss table (0.20).\n// The control bytes of a RawTable (raw_table.tach) are read GROUP at a\n// time and matched all at once: one byte per bucket, EMPTY (0xff),\n// DELETED (0x80) or FULL (0x00-0x7f: the top 7 bits of the hash, its\n// tag). A Group is GROUP control bytes; a BitMask is the result of a\n// match, the top bit of each byte that matched (0x80 lanes, the lowest\n// byte the first bucket). SWAR on a u64 (hashbrown's generic.rs), with\n");
        buf_str(out, c"// match_tag a NEON compare on AArch64 (0.20 D1). GROUP is 8 on every\n// target and in every version, so a table's layout, and its iteration\n// order, is the same everywhere.\n\nuse std::{leading_zeros, trailing_zeros};\nuse std::arch::has;\nuse std::arch::aarch64::{\n    vceq_u8, vdup_n_u64, vdup_n_u8, vget_lane_u64, vreinterpret_u64_u8, vreinterpret_u8_u64,\n};\n\n// ---- Swiss-table groups (0.20 implementation) ----\n\npub type Group = u64;\npub type BitMask = u64;\n\n// Control bytes per group.\npub const GROUP: i64 = 8;\n// A bucket never used since the table was made or cleared: a search ends\n// at a group that has one.\npub const CTRL_EMPTY: u8 = 0xff;\n// A bucket whose element was erased (a tombstone): a search goes past it.\npub const CTRL_DELETED: u8 = 0x80;\n\nconst GROUP_LSB: u64 = 0x0101010101010101;\nconst GROUP_MSB: u64 = 0x8080808080808080;\n\n// The tag of a hash: its top 7 bits, a FULL control byte.\n#[inline]\npub fn ctrl_tag(hash: u64) -> u8 {\n    (hash >> 57) as u8\n}\n\n// The GROUP control bytes at ctrl[pos..pos + GROUP] (an unaligned load).\n// The caller guarantees that those bytes are readable.\n#[inline]\npub unsafe fn group_load(ctrl: *u8, pos: i64) -> Group {\n    // (AArch64 and x86_64, every target of tachyon, load from any address;\n    // the compiler emits one 8-byte load)\n    *(&ctrl[pos] as *u64)\n}\n\n// Stores g at ctrl[pos..pos + GROUP]; the caller guarantees that those\n// bytes are writable.\n#[inline]\npub unsafe fn group_store(ctrl: *u8, pos: i64, g: Group) {\n    *(&ctrl[pos] as *u64) = g;\n}\n\n// The buckets of g whose control byte is tag (a FULL byte). (0.20 D1) On\n// AArch64 one NEON compare (cmeq on the 8 bytes): exact. Elsewhere\n// match_tag_swar, which may also report false positives; either way the\n// table's layout is the same (a match only decides which keys are\n// compared).\n#[inline]\npub fn match_tag(g: Group, tag: u8) -> BitMask {\n    if has(\"neon\") {\n");
        buf_str(out, c"        let v = vreinterpret_u8_u64(vdup_n_u64(g));\n        let eq = vceq_u8(v, vdup_n_u8(tag));\n        return vget_lane_u64(vreinterpret_u64_u8(eq), 0) & GROUP_MSB;\n    }\n    match_tag_swar(g, tag)\n}\n\n// match_tag in SWAR on a u64 (hashbrown's generic.rs): may report a false\n// positive, always a FULL byte above a true match, which the caller's key\n// comparison rejects.\n#[inline]\npub fn match_tag_swar(g: Group, tag: u8) -> BitMask {\n    let cmp = g ^ (tag as u64 * GROUP_LSB);\n    (cmp - GROUP_LSB) & ~cmp & GROUP_MSB\n}\n\n// The EMPTY buckets of g.\n#[inline]\npub fn match_empty(g: Group) -> BitMask {\n    g & (g << 1) & GROUP_MSB\n}\n\n// The EMPTY and DELETED buckets of g: where an insertion may go.\n#[inline]\npub fn match_empty_or_deleted(g: Group) -> BitMask {\n    g & GROUP_MSB\n}\n\n// The FULL buckets of g.\n#[inline]\npub fn match_full(g: Group) -> BitMask {\n    ~g & GROUP_MSB\n}\n\n// g with EMPTY and DELETED bytes made EMPTY and FULL ones DELETED: the\n// first step of rehashing a table in place.\n#[inline]\npub fn convert_special_to_empty_and_full_to_deleted(g: Group) -> Group {\n    let full = ~g & GROUP_MSB;\n    ~full + (full >> 7)\n}\n\n// The first bucket of m (m != 0), 0 to GROUP - 1.\n#[inline]\npub fn bitmask_lowest(m: BitMask) -> i64 {\n    trailing_zeros(m) >> 3\n}\n\n// m without its first bucket.\n#[inline]\npub fn bitmask_remove_lowest(m: BitMask) -> BitMask {\n    m & (m - 1)\n}\n\n// The buckets before the first of m (GROUP when m is 0).\n#[inline]\npub fn bitmask_trailing(m: BitMask) -> i64 {\n    trailing_zeros(m) >> 3\n}\n\n// The buckets after the last of m (GROUP when m is 0).\n#[inline]\npub fn bitmask_leading(m: BitMask) -> i64 {\n    leading_zeros(m) >> 3\n}\n// ---- end mod std::collections::group ----\n}\n// ---- end mod std::collections ----\n}\n// ---- mod std::io ----\npub mod io {\n// std::io: reading stdin (0.20: from flat/io.tach); (0.20, B6) io::Error\n");
        buf_str(out, c"// and io::Result, Read, Write, BufReader, BufWriter and the standard\n// streams (io/error.tach, io/buffered.tach).\n\npub mod error;\npub mod buffered;\n\npub use buffered::{\n    BufRead, BufReader, BufWriter, Lines, Read, Stderr, Stdin, Stdout, Write, stderr, stdin, stdout,\n    writeln,\n};\npub use error::{Error, ErrorKind, Result};\nuse std::{Allocator, Buf, IoError, malloc, read};\n\n// `read_line` and `read_stdin` share one buffer: they can be mixed, but\n// not with C's stdio reading (getchar, scanf, fgets), which has its own.\nstatic var STDIN_BUF: *u8 = 0 as *u8;\nstatic var STDIN_POS: i64 = 0;\nstatic var STDIN_LEN: i64 = 0;\nconst STDIN_BLOCK: i64 = 65536;\n\n// Bytes in STDIN_BUF[STDIN_POS..STDIN_LEN], read if there were none: 1;\n// 0 at the end of input, -1 when reading failed.\nfn stdin_fill() -> i64 {\n    if STDIN_POS < STDIN_LEN {\n        return 1;\n    }\n    if STDIN_BUF == 0 as *u8 {\n        STDIN_BUF = unsafe { malloc(STDIN_BLOCK as u64) };\n    }\n    let n = unsafe { read(0, STDIN_BUF, STDIN_BLOCK as u64) };\n    STDIN_POS = 0;\n    STDIN_LEN = if n > 0 { n } else { 0 };\n    if n > 0 { 1 } else if n == 0 { 0 } else { -1 }\n}\n\n// The next line of stdin into `line` (emptied first; 0.16: a Buf on any\n// allocator, which it grows), without its '\\n'; Ok(false) at the end of\n// input.\npub fn read_line<A: Allocator>(line: inout Buf<A>) -> std::Result<bool, IoError> {\n    line.clear();\n    var any = false;\n    loop {\n        let filled = stdin_fill();\n        if filled < 0 {\n            return std::Result::Err(IoError::Read);\n        }\n        if filled == 0 {\n            break;\n        }\n        any = true;\n        let block = unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] };\n        for i in 0..block.len {\n            if block[i] == '\\n' {\n                line.push_str(block[..i]);\n                STDIN_POS += i + 1;\n                return std::Result::Ok(true);\n            }\n        }\n        line.push_str(block);\n");
        buf_str(out, c"        STDIN_POS = STDIN_LEN;\n    }\n    std::Result::Ok(any)\n}\n\n// All of stdin that is left, in a new Buf on allocator a (the caller\n// frees it). It shares a buffer with read_line, not with C's getchar or\n// scanf.\npub fn read_stdin_in<A: Allocator>(a: sink A) -> std::Result<Buf<A>, IoError> {\n    var b: Buf<A> = Buf::new_in(a);\n    if STDIN_POS < STDIN_LEN {\n        b.push_str(unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] });\n        STDIN_POS = STDIN_LEN;\n    }\n    loop {\n        b.bytes.reserve(STDIN_BLOCK);\n        let room = b.bytes.cap - b.bytes.len;\n        let n = unsafe { read(0, &b.bytes.ptr[b.bytes.len], room as u64) };\n        if n == 0 {\n            return std::Result::Ok(b);\n        }\n        if n < 0 {\n            b.free();\n            return std::Result::Err(IoError::Read);\n        }\n        b.bytes.len += n;\n    }\n}\n\n// (0.20) Reads up to buf.len bytes of stdin into buf, what read_line has\n// buffered first: how many (0 at the end), -1 when reading failed\n// (std::io::Stdin).\npub fn __stdin_read(buf: inout [u8]) -> i64 {\n    if STDIN_POS < STDIN_LEN {\n        let block = unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] };\n        let n = if block.len < buf.len { block.len } else { buf.len };\n        for i in 0..n {\n            buf[i] = block[i];\n        }\n        STDIN_POS += n;\n        return n;\n    }\n    let n = unsafe { read(0, buf.ptr, buf.len as u64) };\n    if n < 0 { -1 } else { n }\n}\n// ---- mod std::io::error ----\npub mod error {\n// std::io::error (0.20, docs/design/collections-text-io.md §2.6.2, task\n// B6): io::Error, Rust's shape without its Box (a kind, the OS's errno or\n// 0, and a static message of std's), ErrorKind, and io::Result<T>.\n\nuse std::{Debug, Display, Eq, Fmt, From, Option};\nuse std::str::Utf8Error;\nuse std::sys::{SysErrorKind, sys_errno, sys_errno_kind, sys_strerror_into};\n\n// ---- I/O errors (0.20) ----\n\n// The kinds of io::Error (Rust's names; those std can produce).\n");
        buf_str(out, c"#[derive(Eq, Debug, Clone)]\npub enum ErrorKind {\n    NotFound,\n    PermissionDenied,\n    AlreadyExists,\n    WouldBlock,\n    InvalidInput,\n    InvalidData,\n    TimedOut,\n    WriteZero,\n    Interrupted,\n    UnexpectedEof,\n    BrokenPipe,\n    NotADirectory,\n    IsADirectory,\n    DirectoryNotEmpty,\n    Unsupported,\n    OutOfMemory,\n    Other,\n}\n\nimpl ErrorKind {\n    // Rust's description of the kind (\"entity not found\", ...).\n    pub fn as_str(self) -> [u8] {\n        match self {\n            ErrorKind::NotFound => \"entity not found\",\n            ErrorKind::PermissionDenied => \"permission denied\",\n            ErrorKind::AlreadyExists => \"entity already exists\",\n            ErrorKind::WouldBlock => \"operation would block\",\n            ErrorKind::InvalidInput => \"invalid input parameter\",\n            ErrorKind::InvalidData => \"invalid data\",\n            ErrorKind::TimedOut => \"timed out\",\n            ErrorKind::WriteZero => \"write zero\",\n            ErrorKind::Interrupted => \"operation interrupted\",\n            ErrorKind::UnexpectedEof => \"unexpected end of file\",\n            ErrorKind::BrokenPipe => \"broken pipe\",\n            ErrorKind::NotADirectory => \"not a directory\",\n            ErrorKind::IsADirectory => \"is a directory\",\n            ErrorKind::DirectoryNotEmpty => \"directory not empty\",\n            ErrorKind::Unsupported => \"unsupported\",\n            ErrorKind::OutOfMemory => \"out of memory\",\n            ErrorKind::Other => \"other error\",\n        }\n    }\n}\n\nimpl Display for ErrorKind {\n    fn fmt(self, f: inout Fmt) {\n        f.str(self.as_str());\n    }\n}\n\nfn kind_of_sys(k: SysErrorKind) -> ErrorKind {\n    match k {\n        SysErrorKind::NotFound => ErrorKind::NotFound,\n        SysErrorKind::PermissionDenied => ErrorKind::PermissionDenied,\n        SysErrorKind::AlreadyExists => ErrorKind::AlreadyExists,\n        SysErrorKind::WouldBlock => ErrorKind::WouldBlock,\n");
        buf_str(out, c"        SysErrorKind::InvalidInput => ErrorKind::InvalidInput,\n        SysErrorKind::InvalidData => ErrorKind::InvalidData,\n        SysErrorKind::TimedOut => ErrorKind::TimedOut,\n        SysErrorKind::WriteZero => ErrorKind::WriteZero,\n        SysErrorKind::Interrupted => ErrorKind::Interrupted,\n        SysErrorKind::UnexpectedEof => ErrorKind::UnexpectedEof,\n        SysErrorKind::BrokenPipe => ErrorKind::BrokenPipe,\n        SysErrorKind::NotADirectory => ErrorKind::NotADirectory,\n        SysErrorKind::IsADirectory => ErrorKind::IsADirectory,\n        SysErrorKind::DirectoryNotEmpty => ErrorKind::DirectoryNotEmpty,\n        SysErrorKind::Unsupported => ErrorKind::Unsupported,\n        SysErrorKind::OutOfMemory => ErrorKind::OutOfMemory,\n        SysErrorKind::Other => ErrorKind::Other,\n    }\n}\n\n// An I/O error: its kind, the OS's error number (0: none) and std's\n// message for it (a C string of std's, or null). Display: the OS's text\n// and `(os error N)`, as Rust's; else the message, else the kind's text.\n#[derive(Eq, Clone)]\npub struct Error { kind: ErrorKind, code: i32, msg: *u8 }\n\n// `Result<T, io::Error>`: what std's I/O functions return (`?` passes the\n// error on).\npub type Result<T> = std::Result<T, Error>;\n\nimpl Error {\n    // The error of errno e.\n    pub fn from_raw_os_error(e: i32) -> Error {\n        Error { kind: kind_of_sys(sys_errno_kind(e)), code: e, msg: 0 as *u8 }\n    }\n\n    // The error errno says now.\n    pub fn last_os_error() -> Error {\n        Error::from_raw_os_error(sys_errno())\n    }\n\n    // An error of kind k with no OS error (Rust's `Error::from(kind)`).\n    pub fn new(k: ErrorKind) -> Error {\n        Error { kind: k, code: 0, msg: 0 as *u8 }\n    }\n\n    pub fn kind(self) -> ErrorKind {\n        self.kind\n    }\n\n    // The OS's error number, when there is one.\n    pub fn raw_os_error(self) -> Option<i32> {\n        if self.code != 0 { Option::Some(self.code) } else { Option::None }\n    }\n}\n\n");
        buf_str(out, c"// std's own error, with a static message.\npub fn __io_error(k: ErrorKind, msg: *u8) -> Error {\n    Error { kind: k, code: 0, msg: msg }\n}\n\nimpl Display for Error {\n    fn fmt(self, f: inout Fmt) {\n        if self.code != 0 {\n            var buf: [u8; 128] = [0; 128];\n            let n = sys_strerror_into(self.code, &buf[..]);\n            f.str(buf[..n]);\n            f.str(\" (os error \");\n            f.int(self.code as i64);\n            f.str(\")\");\n        } else if self.msg != 0 as *u8 {\n            // (a C string literal of std's: NUL-ended, static)\n            f.str(unsafe { std::sys::sys_cstr_view(self.msg) });\n        } else {\n            f.str(self.kind.as_str());\n        }\n    }\n}\n\nimpl Debug for Error {\n    fn fmt_debug(self, f: inout Fmt) {\n        if self.code != 0 {\n            f.str(\"Os { code: \");\n            f.int(self.code as i64);\n            f.str(\", kind: \");\n            self.kind.fmt_debug(&f);\n            f.str(\", message: \\\"\");\n            var buf: [u8; 128] = [0; 128];\n            let n = sys_strerror_into(self.code, &buf[..]);\n            f.str(buf[..n]);\n            f.str(\"\\\" }\");\n        } else {\n            f.str(\"Custom { kind: \");\n            self.kind.fmt_debug(&f);\n            f.str(\", error: \\\"\");\n            self.fmt(&f);\n            f.str(\"\\\" }\");\n        }\n    }\n}\n\nimpl From<ErrorKind> for Error {\n    fn from(k: ErrorKind) -> Error {\n        Error::new(k)\n    }\n}\n\n// (text that is not UTF-8, read where a String goes: InvalidData)\nimpl From<Utf8Error> for Error {\n    fn from(e: Utf8Error) -> Error {\n        __io_error(ErrorKind::InvalidData, c\"stream did not contain valid UTF-8\")\n    }\n}\n\n// The error of a sys call's errno.\n#[inline]\npub fn __os_error(e: i32) -> Error {\n    Error::from_raw_os_error(e)\n}\n// ---- end mod std::io::error ----\n}\n// ---- mod std::io::buffered ----\npub mod buffered {\n");
        buf_str(out, c"// std::io::buffered (0.20, docs/design/collections-text-io.md §2.6.3,\n// task B6): the Read and Write traits, BufReader and BufWriter with their\n// 8 KB buffers inline (`BufReader::new(f)` allocates nothing), the\n// standard streams, and writeln. What grows a Vec or a String (read_to_end,\n// read_line, lines_in) grows it on its own allocator.\n\nuse std::{Allocator, Display, Drop, Iterator, Option, Vec};\nuse std::io::error::{Error, ErrorKind, Result, __io_error, __os_error};\nuse std::str::{memchr, validate_utf8};\nuse std::string::String;\nuse std::sys::{sys_read, sys_write};\n\n// ---- Reading and writing (0.20) ----\n\n// A source of bytes: a File, a BufReader, stdin(), a ChildStdout.\npub trait Read {\n    // Reads up to buf.len bytes into buf: how many (0 at the end).\n    fn read(inout self, buf: inout [u8]) -> Result<i64>;\n\n    // Fills buf, or UnexpectedEof.\n    fn read_exact(inout self, buf: inout [u8]) -> Result<()> {\n        var at = 0;\n        while at < buf.len {\n            let n = self.read(&buf[at..])?;\n            if n == 0 {\n                return Err(__io_error(ErrorKind::UnexpectedEof, c\"failed to fill whole buffer\"));\n            }\n            at += n;\n        }\n        Ok(())\n    }\n\n    // Appends all that is left to v: how many bytes.\n    fn read_to_end<A: Allocator>(inout self, v: inout Vec<u8, A>) -> Result<i64> {\n        let start = v.len;\n        loop {\n            if v.cap - v.len < 4096 {\n                v.reserve(if v.cap < 8192 { 8192 } else { v.cap });\n            }\n            // (v's room: its capacity past its length, written before it\n            // counts)\n            let room = unsafe { v.ptr[v.len..v.cap] };\n            let n = self.read(&room)?;\n            if n == 0 {\n                return Ok(v.len - start);\n            }\n            v.len += n;\n        }\n    }\n\n    // Appends all that is left to s, which must be UTF-8 (InvalidData, s\n    // as it was, when not): how many bytes.\n");
        buf_str(out, c"    fn read_to_string<A: Allocator>(inout self, s: inout String<A>) -> Result<i64> {\n        let start = s.bytes.len;\n        let n = self.read_to_end(&s.bytes)?;\n        match validate_utf8(s.bytes.as_slice()[start..]) {\n            Ok(_) => Ok(n),\n            Err(_) => {\n                s.bytes.truncate(start);\n                Err(__io_error(ErrorKind::InvalidData, c\"stream did not contain valid UTF-8\"))\n            }\n        }\n    }\n}\n\n// A sink of bytes: a File, a BufWriter, stdout(), stderr().\npub trait Write {\n    // Writes some of buf: how many bytes.\n    fn write(inout self, buf: [u8]) -> Result<i64>;\n\n    // Writes out what is buffered.\n    fn flush(inout self) -> Result<()>;\n\n    // Writes all of buf (WriteZero when the sink takes none).\n    fn write_all(inout self, buf: [u8]) -> Result<()> {\n        var at = 0;\n        while at < buf.len {\n            let n = self.write(buf[at..])?;\n            if n == 0 {\n                return Err(__io_error(ErrorKind::WriteZero, c\"failed to write whole buffer\"));\n            }\n            at += n;\n        }\n        Ok(())\n    }\n\n    // Writes x's Display: `w.write_fmt(f\"{a} {b}\\n\")?` (writeln). Text of\n    // up to 4 KB per call (InvalidInput above: a BufWriter takes 8 KB).\n    fn write_fmt<T: Display>(inout self, x: sink T) -> Result<()> {\n        var tmp: [u8; 4096] = [0; 4096];\n        let n = std::fmt::__fmt_into_len(&tmp[..], x);\n        if n < 0 {\n            return Err(__io_error(ErrorKind::InvalidInput, c\"formatted text over 4096 bytes\"));\n        }\n        self.write_all(tmp[..n])\n    }\n}\n\n// Writes x's Display and a '\\n' to w (Rust's `writeln!(w, ..)`):\n// `writeln(&mut out, f\"{k} {v}\")?`.\npub fn writeln<W: Write, T: Display>(w: inout W, x: sink T) -> Result<()> {\n    w.write_fmt(x)?;\n    w.write_all(\"\\n\")\n}\n\n// ---- Buffered reading and writing (0.20) ----\n\nconst BUF_SIZE: i64 = 8192;\n\n");
        buf_str(out, c"// Reads its inner reader 8 KB at a time (the buffer is inline: `new`\n// allocates nothing); lines and read_line split what it holds.\npub struct BufReader<R> { inner: R, buf: [u8; 8192], pos: i64, len: i64 }\n\nimpl<R: Read> BufReader<R> {\n    pub fn new(inner: sink R) -> BufReader<R> {\n        BufReader { inner: inner, buf: [0; 8192], pos: 0, len: 0 }\n    }\n\n    // Appends the bytes up to and including the next `byte` (or the end)\n    // to v: how many (0 at the end).\n    pub fn read_until<A: Allocator>(inout self, byte: u8, v: inout Vec<u8, A>)\n        -> Result<i64> {\n        var total = 0;\n        loop {\n            if self.pos >= self.len {\n                self.pos = 0;\n                self.len = 0;\n                let n = self.inner.read(&self.buf[..])?;\n                if n == 0 {\n                    return Ok(total);\n                }\n                self.len = n;\n            }\n            let avail = self.buf[self.pos..self.len];\n            match memchr(byte, avail) {\n                Option::Some(k) => {\n                    push_bytes(&v, avail[..k + 1]);\n                    self.pos += k + 1;\n                    return Ok(total + k + 1);\n                }\n                Option::None => {\n                    push_bytes(&v, avail);\n                    total += avail.len;\n                    self.pos = self.len;\n                }\n            }\n        }\n    }\n\n    // Appends the next line to s, its '\\n' included (Rust's read_line):\n    // how many bytes, 0 at the end. InvalidData when it is not UTF-8.\n    pub fn read_line<A: Allocator>(inout self, s: inout String<A>) -> Result<i64> {\n        let start = s.bytes.len;\n        let n = self.read_until('\\n', &s.bytes)?;\n        match validate_utf8(s.bytes.as_slice()[start..]) {\n            Ok(_) => Ok(n),\n            Err(_) => {\n                s.bytes.truncate(start);\n                Err(__io_error(ErrorKind::InvalidData, c\"stream did not contain valid UTF-8\"))\n");
        buf_str(out, c"            }\n        }\n    }\n\n    // The lines, each a new String on allocator a without its '\\n' (or\n    // \"\\r\\n\"): Rust's `lines()`, which allocates each one too.\n    pub fn lines_in<A: Allocator>(sink self, a: sink A) -> Lines<R, A> {\n        Lines { r: self, a: a }\n    }\n\n    // The reader inside (what is buffered is lost).\n    pub fn into_inner(sink self) -> R {\n        self.inner\n    }\n}\n\nimpl<R: Read> Read for BufReader<R> {\n    fn read(inout self, buf: inout [u8]) -> Result<i64> {\n        if self.pos >= self.len && buf.len >= BUF_SIZE {\n            return self.inner.read(buf);\n        }\n        let avail = self.fill_buf()?;\n        let n = if avail.len < buf.len { avail.len } else { buf.len };\n        for i in 0..n {\n            buf[i] = avail[i];\n        }\n        self.consume(n);\n        Ok(n)\n    }\n}\n\n// A reader with a buffer (Rust's BufRead): BufReader. Its read_line,\n// read_until and lines_in are BufReader's own (no `use` needed).\npub trait BufRead {\n    // The bytes buffered, read if there are none (empty at the end).\n    fn fill_buf(inout self) -> Result<[u8]>;\n    // Marks n of the buffered bytes read.\n    fn consume(inout self, n: i64);\n}\n\nimpl<R: Read> BufRead for BufReader<R> {\n    fn fill_buf(inout self) -> Result<[u8]> {\n        if self.pos >= self.len {\n            self.pos = 0;\n            self.len = 0;\n            let n = self.inner.read(&self.buf[..])?;\n            self.len = n;\n        }\n        Ok(self.buf[self.pos..self.len])\n    }\n\n    fn consume(inout self, n: i64) {\n        self.pos = if self.pos + n < self.len { self.pos + n } else { self.len };\n    }\n}\n\n// Appends s to v with one memcpy; s is not a view of v (the reader's\n// buffer, or the room it reads into).\n#[inline]\nfn push_bytes<A: Allocator>(v: inout Vec<u8, A>, s: [u8]) {\n    v.reserve(s.len);\n    // (after reserve, v.ptr[v.len..v.len + s.len] is v's room: memory v\n    // owns, apart from s's)\n    unsafe {\n");
        buf_str(out, c"        std::memcpy(&v.ptr[v.len], s.ptr, s.len as u64);\n    }\n    v.len += s.len;\n}\n\n// `r.lines_in(gpa)`: each line, a String.\npub struct Lines<R, A> { r: BufReader<R>, a: A }\n\nimpl<R: Read, A: Allocator> Iterator for Lines<R, A> {\n    type Item = Result<String<A>>;\n\n    fn next(inout self) -> Option<Result<String<A>>> {\n        var s: String<A> = String::new_in(self.a);\n        match self.r.read_line(&s) {\n            Ok(n) => {\n                if n == 0 {\n                    return Option::None;\n                }\n                let len = s.bytes.len;\n                if len > 0 && s.bytes.as_slice()[len - 1] == '\\n' {\n                    s.bytes.truncate(len - 1);\n                    let len2 = s.bytes.len;\n                    if len2 > 0 && s.bytes.as_slice()[len2 - 1] == '\\r' {\n                        s.bytes.truncate(len2 - 1);\n                    }\n                }\n                Option::Some(Ok(s))\n            }\n            Err(e) => Option::Some(Err(e)),\n        }\n    }\n}\n\n// Writes to its inner writer 8 KB at a time (inline; `new` allocates\n// nothing). Dropping it flushes it (errors lost there: flush first to see\n// them).\npub struct BufWriter<W: Write> { inner: W, buf: [u8; 8192], len: i64 }\n\nimpl<W: Write> BufWriter<W> {\n    pub fn new(inner: sink W) -> BufWriter<W> {\n        BufWriter { inner: inner, buf: [0; 8192], len: 0 }\n    }\n\n    fn flush_buf(inout self) -> Result<()> {\n        let n = self.len;\n        self.len = 0;\n        if n > 0 {\n            self.inner.write_all(self.buf[..n])?;\n        }\n        Ok(())\n    }\n}\n\nimpl<W: Write> Write for BufWriter<W> {\n    fn write(inout self, buf: [u8]) -> Result<i64> {\n        if self.len + buf.len > BUF_SIZE {\n            self.flush_buf()?;\n        }\n        if buf.len >= BUF_SIZE {\n            return self.inner.write(buf);\n        }\n        let at = self.len;\n        for i in 0..buf.len {\n            self.buf[at + i] = buf[i];\n        }\n");
        buf_str(out, c"        self.len = at + buf.len;\n        Ok(buf.len)\n    }\n\n    fn write_all(inout self, buf: [u8]) -> Result<()> {\n        if self.len + buf.len > BUF_SIZE {\n            self.flush_buf()?;\n        }\n        if buf.len >= BUF_SIZE {\n            return self.inner.write_all(buf);\n        }\n        let at = self.len;\n        for i in 0..buf.len {\n            self.buf[at + i] = buf[i];\n        }\n        self.len = at + buf.len;\n        Ok(())\n    }\n\n    fn flush(inout self) -> Result<()> {\n        self.flush_buf()?;\n        self.inner.flush()\n    }\n\n    // x's Display written into the buffer's room (up to 8 KB of text).\n    fn write_fmt<T: Display>(inout self, x: sink T) -> Result<()> {\n        let at = self.len;\n        let n = std::fmt::__fmt_into_len(&self.buf[at..], x);\n        if n >= 0 {\n            self.len = at + n;\n            return Ok(());\n        }\n        self.flush_buf()?;\n        let m = std::fmt::__fmt_into_len(&self.buf[..], x);\n        if m < 0 {\n            return Err(__io_error(ErrorKind::InvalidInput, c\"formatted text over 8192 bytes\"));\n        }\n        self.len = m;\n        Ok(())\n    }\n}\n\nimpl<W: Write> Drop for BufWriter<W> {\n    fn drop(inout self) {\n        let _ = self.flush_buf();\n    }\n}\n\n// ---- The standard streams (0.20) ----\n\n// Standard output: print's buffer is written out before what is written\n// here, so the two keep their order.\npub struct Stdout { fd: i32 }\n\n// Standard error.\npub struct Stderr { fd: i32 }\n\n// Standard input: what read_line has buffered is read first.\npub struct Stdin { fd: i32 }\n\npub fn stdout() -> Stdout {\n    Stdout { fd: 1 }\n}\n\npub fn stderr() -> Stderr {\n    Stderr { fd: 2 }\n}\n\npub fn stdin() -> Stdin {\n    Stdin { fd: 0 }\n}\n\n// Writes some of buf to fd.\nfn fd_write(fd: i32, buf: [u8]) -> Result<i64> {\n    match sys_write(fd, buf) {\n        Ok(n) => Ok(n),\n        Err(e) => Err(__os_error(e)),\n    }\n}\n\nimpl Write for Stdout {\n");
        buf_str(out, c"    fn write(inout self, buf: [u8]) -> Result<i64> {\n        std::fmt::__flush_print();\n        fd_write(self.fd, buf)\n    }\n\n    fn flush(inout self) -> Result<()> {\n        std::fmt::__flush_print();\n        Ok(())\n    }\n}\n\nimpl Write for Stderr {\n    fn write(inout self, buf: [u8]) -> Result<i64> {\n        fd_write(self.fd, buf)\n    }\n\n    fn flush(inout self) -> Result<()> {\n        Ok(())\n    }\n}\n\nimpl Read for Stdin {\n    fn read(inout self, buf: inout [u8]) -> Result<i64> {\n        let n = std::io::__stdin_read(buf);\n        if n < 0 {\n            return Err(Error::last_os_error());\n        }\n        Ok(n)\n    }\n}\n// ---- end mod std::io::buffered ----\n}\n// ---- end mod std::io ----\n}\n// ---- mod std::fmt ----\npub mod fmt {\n// std::fmt: printing, Display and Debug, and Fmt, the formatter (0.20: from flat/fmt.tach).\n\nuse std::{Allocator, Buf, Gpa, Vec, decimal_len, memcpy, put_decimal, strlen, write};\nuse std::num::{FloatFmt, write_f32, write_f64};\n\nextern \"C\" {\n    #[effects()]\n    fn snprintf(buf: *u8, n: u64, format: *u8, ...) -> i32;\n    #[effects()]\n    fn strtod(s: *u8, end: **u8) -> f64;\n    #[effects()]\n    fn strtof(s: *u8, end: **u8) -> f32;\n}\n\n// ---- Printing ----\n\n// x's Display (`print(\"text\")`, `print(f\"{a} {b:?}\")`): one `write`.\npub fn print<T: Display>(x: sink T) {\n    var f = Fmt::to_fd(1);\n    x.fmt(&f);\n    f.flush();\n}\n\npub fn println<T: Display>(x: sink T) {\n    var f = Fmt::to_fd(1);\n    x.fmt(&f);\n    f.byte('\\n');\n    f.flush();\n}\n\n#[inline(never)]\npub fn print_int(v: i64) {\n    var f = Fmt::to_fd(1);\n    // (decimal only: not Fmt::int, whose hex and binary every program\n    // using print_int would compile)\n    let negative = v < 0;\n    fmt_decimal(&f, if negative { (-(v + 1)) as u64 + 1 } else { v as u64 }, negative);\n    f.flush();\n}\n\n// A C string (up to its NUL).\npub unsafe fn print_cstr(s: *u8) {\n    var f = Fmt::to_fd(1);\n");
        buf_str(out, c"    f.str(s[0..strlen(s) as i64]);\n    f.flush();\n}\n\n// ---- Display, Debug and Fmt (0.15) ----\n\n// x's Display on stderr.\npub fn eprint<T: Display>(x: sink T) {\n    var f = Fmt::to_fd(2);\n    x.fmt(&f);\n    f.flush();\n}\n\npub fn eprintln<T: Display>(x: sink T) {\n    var f = Fmt::to_fd(2);\n    x.fmt(&f);\n    f.byte('\\n');\n    f.flush();\n}\n\n// x's Display in a new Buf on allocator a, of its length (the caller frees\n// it): `format_in(f\"{x:>8}\", gpa)`. (0.16: up to 256 bytes, x's Display\n// runs once, into a buffer on the stack.)\npub fn format_in<T: Display, A: Allocator>(x: sink T, a: sink A) -> Buf<A> {\n    var b: Buf<A> = Buf::new_in(a);\n    var tmp: [u8; 256] = [0; 256];\n    var f = __fmt_tmp(&tmp);\n    // (one call of x's Display in the code: first to tmp, then, when the\n    // text did not fit, to b's room)\n    loop {\n        x.fmt(&f);\n        if __fmt_in_end(&b, &f, &tmp) {\n            return b;\n        }\n    }\n}\n\n// (0.17) What the compiler writes for an f-string passed straight to\n// format_in, push_fmt, print, println, eprint or eprintln\n// (front/check/interp.tach): the holes' values, then the writes of\n// the text in place, with no closure. `format_in(f\"..\", a)` is\n//\n//   { let __f0 = e0; ...; let __a = a; let mut __b = std::Buf::new_in(__a);\n//     let mut __t = [0u8; 256]; let mut __out = std::__fmt_tmp(&mut __t);\n//     loop { WRITES; if std::__fmt_in_end(&mut __b, &mut __out, &__t) { break; } }\n//     __b }\n//\n// and `b.push_fmt(f\"..\")` is `{ let __r = &b; let __f0 = e0; ...; let mut\n// __out = std::__buf_fmt(&mut *__r); loop { WRITES; if\n// std::__buf_fmt_end(&mut *__r, &mut __out) { break; } } }`. Not for programs to call.\n\n// A Fmt writing into tmp (format_in's first pass).\n#[inline]\n#[views(tmp)]\npub fn __fmt_tmp(tmp: inout [u8; 256]) -> Fmt {\n    var f = Fmt::to_fd(-1);\n    f.out = tmp[..];\n    f\n}\n\n// The end of a pass of format_in: the text written to tmp, when it fits,\n");
        buf_str(out, c"// copied to b, of its length (true); else b reserves the length and f\n// writes into b's room (false); after that pass, as __buf_fmt_end.\n// (0.20: tmp is format_in's buffer itself, compared by its address: a raw\n// pointer, as a let parameter would copy it)\npub fn __fmt_in_end<A: Allocator>(b: inout Buf<A>, f: inout Fmt, tmp: *[u8; 256]) -> bool {\n    if f.out.ptr != unsafe { (*tmp)[..].ptr } {\n        return fmt_end_vec(&b.bytes, &f);\n    }\n    if f.need == 0 {\n        b.bytes.reserve(f.len);\n        b.bytes.extend_from_slice(unsafe { (*tmp)[0..f.len] });\n        return true;\n    }\n    b.bytes.reserve(f.need);\n    f = fmt_to_vec(&b.bytes);\n    false\n}\n\n// A Fmt writing into b's room (push_fmt).\n#[inline]\n#[views(b)]\npub fn __buf_fmt<A: Allocator>(b: inout Buf<A>) -> Fmt {\n    fmt_to_vec(&b.bytes)\n}\n\n// The text f wrote is b's (true), or did not fit: b grows, f starts again.\n#[inline]\npub fn __buf_fmt_end<A: Allocator>(b: inout Buf<A>, f: inout Fmt) -> bool {\n    fmt_end_vec(&b.bytes, &f)\n}\n\n#[ambient(\"format_in(x, gpa)\")]\npub fn format<T: Display>(x: sink T) -> Buf {\n    format_in(x, Gpa::ambient())\n}\n\nimpl<A: Allocator> Buf<A> {\n    // Appends x's Display: `b.push_fmt(f\"{k}={v};\")`. (0.16: into the room\n    // the Buf has; when the text does not fit, the Buf grows and x's\n    // Display runs again.)\n    pub fn push_fmt<T: Display>(inout self, x: sink T) {\n        var f = __buf_fmt(&self);\n        loop {\n            x.fmt(&f);\n            if __buf_fmt_end(&self, &f) {\n                return;\n            }\n        }\n    }\n}\n\n// A Fmt writing into v's room.\n#[inline]\npub fn fmt_to_vec<A: Allocator>(v: inout Vec<u8, A>) -> Fmt {\n    var f = Fmt::to_fd(-1);\n    f.out = unsafe { v.ptr[0..v.cap] };\n    f.len = v.len;\n    f\n}\n\n// The text f wrote into v's room is v's (true), or did not fit: v grows to\n// fit it, f starts again (false).\n");
        buf_str(out, c"pub fn fmt_end_vec<A: Allocator>(v: inout Vec<u8, A>, f: inout Fmt) -> bool {\n    if f.need == 0 {\n        v.len = f.len;\n        return true;\n    }\n    v.reserve(f.need - v.len);\n    f = fmt_to_vec(&v);\n    false\n}\n\n// (0.20) x's Display written into out: its length, or -1 when it did not\n// fit (std::io's write_fmt).\npub fn __fmt_into_len<T: Display>(out: inout [u8], x: T) -> i64 {\n    var f = Fmt::to_fd(-1);\n    f.out = out;\n    x.fmt(&f);\n    if f.need == 0 { f.len } else { -1 }\n}\n\n// (0.20) Writes out what print and println have buffered (std::io's\n// stdout() writes after it).\npub fn __flush_print() {\n    fmt_flush();\n}\n\n// `{x}` in an f-string, and what print writes.\npub trait Display { fn fmt(self, f: inout Fmt); }\n\n// `{x:?}`: as the code that makes it.\npub trait Debug { fn fmt_debug(self, f: inout Fmt); }\n\n// A spec's flags (front/ast.tach's FMT_*): `<`, `>`, `0`, `x`, `X`, `b`,\n// `c`; spec adds FMT_PAD to a hole with a width or a precision, and a\n// number written first in such a hole adds FMT_NUM (right-aligned,\n// zero-padded after its sign, not cut by the precision).\nconst FMT_LEFT: i64 = 1;\nconst FMT_RIGHT: i64 = 2;\nconst FMT_ZERO: i64 = 4;\nconst FMT_HEX: i64 = 8;\nconst FMT_UPPER: i64 = 16;\nconst FMT_BIN: i64 = 32;\nconst FMT_CHAR: i64 = 64;\nconst FMT_NUM: i64 = 128;\nconst FMT_PAD: i64 = 256;\n\n// The buffer of stdout and stderr: FMT_LEN bytes for FMT_FD; FMT_DONE\n// bytes were written out before them (FMT_DONE + FMT_LEN: the position a\n// spec marks).\nconst FMT_CAP: i64 = 4096;\nstatic var FMT_OUT: [u8; 4096] = [0; 4096];\nstatic var FMT_LEN: i64 = 0;\nstatic var FMT_FD: i32 = 1;\nstatic var FMT_DONE: i64 = 0;\n\n// Writes the buffer out.\n#[inline(never)]\nfn fmt_flush() {\n    var i = 0;\n    // (each round writes a byte at least)\n    for _ in 0..FMT_LEN {\n        if i >= FMT_LEN {\n            break;\n        }\n        let rest = FMT_OUT[i..FMT_LEN];\n");
        buf_str(out, c"        let n = unsafe { write(FMT_FD, rest.ptr, rest.len as u64) };\n        if n <= 0 {\n            break;\n        }\n        i += n;\n    }\n    FMT_DONE += FMT_LEN;\n    FMT_LEN = 0;\n}\n\n// The next n bytes of f's destination, taken, when they fit (the Buf has\n// the room, the buffer holds FMT_FD's bytes); else an empty slice.\n#[inline]\nfn fmt_room(f: inout Fmt, n: i64) -> [u8] {\n    let at = f.len;\n    if at + n <= f.out.len {\n        f.len = at + n;\n        return unsafe { f.out.ptr[at..at + n] };\n    }\n    if f.fd == FMT_FD && FMT_LEN + n <= FMT_CAP {\n        let at = FMT_LEN;\n        FMT_LEN = at + n;\n        return FMT_OUT[at..at + n];\n    }\n    \"\"\n}\n\n// fmt_room when they do not fit (n: at most FMT_CAP): the buffer written\n// out first; to a Buf, an empty slice, the n bytes counted (fmt_lost). (A\n// Fmt's file descriptor or Buf is chosen inline, so that print compiles\n// only the file descriptor's functions.)\n#[inline]\nfn fmt_make_room(f: inout Fmt, n: i64) -> [u8] {\n    if f.fd >= 0 { fmt_fd_room(f.fd, n) } else { fmt_lost(&f, n) }\n}\n\n#[inline(never)]\nfn fmt_fd_room(fd: i32, n: i64) -> [u8] {\n    if fd != FMT_FD || FMT_LEN + n > FMT_CAP {\n        fmt_flush();\n        FMT_FD = fd;\n    }\n    let at = FMT_LEN;\n    FMT_LEN = at + n;\n    FMT_OUT[at..at + n]\n}\n\n// n bytes to a Buf that has no room for them: counted, not written (the\n// text is written again, push_fmt).\n#[inline(never)]\nfn fmt_lost(f: inout Fmt, n: i64) -> [u8] {\n    let end = f.len + n;\n    if end > f.need {\n        f.need = end;\n    }\n    f.len = end;\n    \"\"\n}\n\n// Fmt::str (a call: an f-string's text is one).\n#[inline]\nfn fmt_str(f: inout Fmt, s: [u8]) {\n    if f.fd >= 0 {\n        fmt_str_fd(f.fd, s);\n    } else {\n        fmt_str_buf(&f, s);\n    }\n}\n\n#[inline(never)]\nfn fmt_str_fd(fd: i32, s: [u8]) {\n    let n = s.len;\n    var out: [u8] = \"\";\n    if fd == FMT_FD && FMT_LEN + n <= FMT_CAP {\n        let at = FMT_LEN;\n");
        buf_str(out, c"        FMT_LEN = at + n;\n        out = FMT_OUT[at..at + n];\n    } else if n > FMT_CAP {\n        // (written directly)\n        fmt_flush();\n        FMT_FD = fd;\n        var i = 0;\n        for _ in 0..n {\n            if i >= n {\n                break;\n            }\n            let rest = s[i..n];\n            let k = unsafe { write(fd, rest.ptr, rest.len as u64) };\n            if k <= 0 {\n                break;\n            }\n            i += k;\n        }\n        FMT_DONE += n;\n        return;\n    } else {\n        out = fmt_fd_room(fd, n);\n    }\n    unsafe {\n        memcpy(out.ptr, s.ptr, n as u64);\n    }\n}\n\n#[inline(never)]\nfn fmt_str_buf(f: inout Fmt, s: [u8]) {\n    let at = f.len;\n    let n = s.len;\n    if at + n <= f.out.len {\n        unsafe {\n            memcpy(&f.out.ptr[at], s.ptr, n as u64);\n        }\n        f.len = at + n;\n    } else {\n        fmt_lost(&f, n);\n    }\n}\n\n// Fmt::byte when it does not fit.\n#[inline]\nfn fmt_byte(f: inout Fmt, b: u8) {\n    let out = fmt_make_room(&f, 1);\n    if out.len == 1 {\n        out[0] = b;\n    }\n}\n\n// u's decimal digits, after a '-' when negative.\n#[inline]\nfn fmt_decimal(f: inout Fmt, u: u64, negative: bool) {\n    let len = if negative { decimal_len(u) + 1 } else { decimal_len(u) };\n    var out = fmt_room(&f, len);\n    if out.len != len {\n        out = fmt_make_room(&f, len);\n        if out.len != len {\n            return;\n        }\n    }\n    unsafe {\n        put_decimal(out.ptr, len, u, negative);\n    }\n}\n\n// What Display and Debug write to: a file descriptor `fd` (through std's\n// buffer: `flush` writes it out), or (fd -1) the room out[len..] of a\n// Buf, `need` the length the text reached when it did not fit (0: it\n// fits). (0.17) A view: `out`, the Buf's room, so a Buf cannot change while\n// a Fmt writes into it. `width`, `prec` (-1: none) and `flags` are the spec of the hole\n// being written, `mark` the position it started at. (0.16: sealed; std's\n");
        buf_str(out, c"// functions make one.)\n#[sealed]\npub struct Fmt {\n    out: [u8], len: i64, need: i64, fd: i32, width: i64, prec: i64, flags: i64,\n    mark: i64,\n}\n\nimpl Fmt {\n    #[inline]\n    #[views()]\n    pub fn to_fd(fd: i32) -> Fmt {\n        Fmt {\n            out: \"\", len: 0, need: 0, fd: fd, width: -1, prec: -1, flags: 0, mark: 0\n        }\n    }\n\n    #[inline]\n    pub fn str(inout self, s: [u8]) {\n        fmt_str(&self, s);\n    }\n\n    #[inline]\n    pub fn byte(inout self, b: u8) {\n        let at = self.len;\n        if at < self.out.len {\n            unsafe {\n                self.out.ptr[at] = b;\n            }\n            self.len = at + 1;\n            return;\n        }\n        if self.fd == FMT_FD && FMT_LEN < FMT_CAP {\n            let out: *u8 = &FMT_OUT[0];\n            unsafe {\n                out[FMT_LEN] = b;\n            }\n            FMT_LEN += 1;\n            return;\n        }\n        fmt_byte(&self, b);\n    }\n\n    // Writes out what a Fmt to a file descriptor has buffered (print does).\n    #[inline]\n    pub fn flush(inout self) {\n        if self.fd >= 0 {\n            fmt_flush();\n        }\n    }\n\n    // x's Display: `f.write(f\"({self.x}, {self.y})\")` in a Display impl.\n    #[inline]\n    pub fn write<T: Display>(inout self, x: sink T) {\n        x.fmt(&self);\n    }\n\n    #[inline]\n    pub fn display<T: Display>(inout self, x: T) {\n        x.fmt(&self);\n    }\n\n    #[inline]\n    pub fn debug<T: Debug>(inout self, x: T) {\n        x.fmt_debug(&self);\n    }\n\n    // The position written to.\n    fn pos(inout self) -> i64 {\n        if self.fd >= 0 { FMT_DONE + FMT_LEN } else { self.len }\n    }\n\n    // Starts a hole with a spec (width w, precision p, -1: none; FMT_*\n    // flags): what is written up to end_spec, given the result, is padded\n    // to w. The buffer is first written out unless w bytes fit in it, so\n    // the hole's text is either all in it or at least w long.\n    #[inline]\n");
        buf_str(out, c"    pub fn spec(inout self, w: i64, p: i64, flags: i64) -> FmtSpec {\n        let old = FmtSpec {\n            width: self.width, prec: self.prec, flags: self.flags, mark: self.mark\n        };\n        self.flags = flags;\n        if w > 0 || p >= 0 {\n            if self.fd >= 0 && (self.fd != FMT_FD || FMT_CAP - FMT_LEN < w) {\n                fmt_flush();\n                FMT_FD = self.fd;\n            }\n            self.width = w;\n            self.prec = p;\n            self.flags = flags | FMT_PAD;\n            self.mark = self.pos();\n        }\n        old\n    }\n\n    // Ends the hole `spec` started (`old`: what it returned).\n    #[inline]\n    pub fn end_spec(inout self, old: FmtSpec) {\n        if (self.flags & FMT_PAD) != 0 {\n            fmt_pad(&self);\n        }\n        self.width = old.width;\n        self.prec = old.prec;\n        self.flags = old.flags;\n        self.mark = old.mark;\n    }\n\n    // v in decimal (x, X, b: in hex or binary, as a u64; c: its low byte).\n    #[inline(never)]\n    pub fn int(inout self, v: i64) {\n        if self.flags != 0 {\n            if (self.flags & (FMT_HEX | FMT_BIN | FMT_CHAR)) != 0 {\n                fmt_radix(&self, v as u64);\n            } else {\n                let negative = v < 0;\n                fmt_spec_decimal(&self, if negative { (-(v + 1)) as u64 + 1 } else { v as u64 },\n                    negative);\n            }\n            return;\n        }\n        let negative = v < 0;\n        fmt_decimal(&self, if negative { (-(v + 1)) as u64 + 1 } else { v as u64 }, negative);\n    }\n\n    // v in decimal, hex (x, X), binary (b), or as a byte (c).\n    #[inline(never)]\n    pub fn uint(inout self, v: u64) {\n        if self.flags != 0 {\n            if (self.flags & (FMT_HEX | FMT_BIN | FMT_CHAR)) != 0 {\n                fmt_radix(&self, v);\n            } else {\n                fmt_spec_decimal(&self, v, false);\n            }\n            return;\n        }\n");
        buf_str(out, c"        fmt_decimal(&self, v, false);\n    }\n}\n\n// Fmt::int and Fmt::uint with a spec of a decimal: u, after a '-' when\n// negative.\n#[inline(never)]\nfn fmt_spec_decimal(f: inout Fmt, u: u64, negative: bool) {\n    fmt_number_start(&f);\n    fmt_decimal(&f, u, negative);\n}\n\n// A number starts here: when nothing of the hole is written yet, the hole\n// is a number's (right-aligned, zero-padded after the sign).\nfn fmt_number_start(f: inout Fmt) {\n    if (f.flags & FMT_PAD) != 0 && f.pos() == f.mark {\n        f.flags |= FMT_NUM;\n    }\n}\n\n// v in hex or binary, or its low byte (c).\n#[inline(never)]\nfn fmt_radix(f: inout Fmt, v: u64) {\n    let flags = f.flags;\n    if (flags & FMT_CHAR) != 0 {\n        f.byte(v as u8);\n        return;\n    }\n    fmt_number_start(&f);\n    let shift: u64 = if (flags & FMT_HEX) != 0 { 4 } else { 1 };\n    let mask = (1u64 << shift) - 1;\n    let digits = if (flags & FMT_UPPER) != 0 { \"0123456789ABCDEF\" } else { \"0123456789abcdef\" };\n    var n = 1;\n    var bits = shift;\n    for _ in 0..64 {\n        if bits >= 64 || (v >> bits) == 0 {\n            break;\n        }\n        n += 1;\n        bits += shift;\n    }\n    var out = fmt_room(&f, n);\n    if out.len != n {\n        out = fmt_make_room(&f, n);\n        if out.len != n {\n            return;\n        }\n    }\n    var u = v;\n    unsafe {\n        let p = out.ptr;\n        for k in 0..n {\n            p[n - 1 - k] = digits.ptr[(u & mask) as i64];\n            u = u >> shift;\n        }\n    }\n}\n\n// A signed integer of `bits` bits: in hex or binary as its unsigned value\n// of that size (Rust's `{:x}` of -1i8 is ff).\npub fn fmt_signed(f: inout Fmt, v: i64, bits: u64) {\n    if v < 0 && (f.flags & (FMT_HEX | FMT_BIN)) != 0 {\n        f.uint((v as u64) & ((1u64 << bits) - 1));\n    } else {\n        f.int(v);\n    }\n}\n\n// The padding and truncation of the hole f.spec started.\n#[inline(never)]\nfn fmt_pad(f: inout Fmt) {\n    let flags = f.flags;\n");
        buf_str(out, c"    let start = f.mark;\n    var end = f.pos();\n    let number = (flags & FMT_NUM) != 0;\n    let reach = if f.fd >= 0 { start >= FMT_DONE && f.fd == FMT_FD } else { true };\n    // (a precision cuts text)\n    if f.prec >= 0 && !number && end - start > f.prec && reach {\n        end = start + f.prec;\n        if f.fd >= 0 {\n            FMT_LEN = end - FMT_DONE;\n        } else {\n            f.len = end;\n        }\n    }\n    let pad = f.width - (end - start);\n    if pad <= 0 {\n        return;\n    }\n    if (flags & FMT_LEFT) != 0 || (flags & FMT_RIGHT) == 0 && !number {\n        for i in 0..pad {\n            f.byte(' ');\n        }\n        return;\n    }\n    if !reach {\n        return;\n    }\n    // Right-aligned: the text moves right by pad, after the sign when zeros\n    // fill.\n    let zeros = number && (flags & FMT_ZERO) != 0;\n    var text: *u8 = 0 as *u8;\n    var base = 0;\n    if f.fd >= 0 {\n        // (spec made room for the width)\n        text = &FMT_OUT[0];\n        base = FMT_DONE;\n        FMT_LEN += pad;\n    } else {\n        // (when the text was lost or the room is short: counted)\n        if f.need != 0 || f.len + pad > f.out.len {\n            fmt_lost(&f, pad);\n            return;\n        }\n        text = f.out.ptr;\n        f.len += pad;\n    }\n    var at = start - base;\n    unsafe {\n        if zeros && end > start && (text[at] == '-' || text[at] == '+') {\n            at += 1;\n        }\n        let count = end - base - at;\n        for k in 0..count {\n            let i = count - 1 - k;\n            text[at + pad + i] = text[at + i];\n        }\n        for k in 0..pad {\n            text[at + k] = if zeros { '0' } else { ' ' };\n        }\n    }\n}\n\n// Text in quotes, escaped as Rust's Debug of a str does.\n#[inline(never)]\npub fn fmt_quoted(f: inout Fmt, s: [u8]) {\n    f.byte('\"');\n    var from = 0;\n    for i in 0..s.len {\n        let c = s[i];\n        if c == '\"' || c == '\\\\' || c < 32 || c == 127 {\n");
        buf_str(out, c"            f.str(s[from..i]);\n            from = i + 1;\n            f.byte('\\\\');\n            if c == '\\n' {\n                f.byte('n');\n            } else if c == '\\t' {\n                f.byte('t');\n            } else if c == '\\r' {\n                f.byte('r');\n            } else if c == 0 {\n                f.byte('0');\n            } else if c == '\"' || c == '\\\\' {\n                f.byte(c);\n            } else {\n                let hex = \"0123456789abcdef\";\n                f.str(\"u{\");\n                if c >= 16 {\n                    f.byte(hex[(c >> 4) as i64]);\n                }\n                f.byte(hex[(c & 15) as i64]);\n                f.byte('}');\n            }\n        }\n    }\n    f.str(s[from..s.len]);\n    f.byte('\"');\n}\n\n// The elements of s, as Debug writes a Vec: `[1, 2, 3]`.\npub fn debug_list<T: Debug>(f: inout Fmt, s: [T]) {\n    f.byte('[');\n    for i in 0..s.len {\n        if i > 0 {\n            f.str(\", \");\n        }\n        f.debug(s[i]);\n    }\n    f.byte(']');\n}\n\n// An f-string's value: its holes' values, and a closure that writes the\n// text.\npub struct Interp<F> { f: F }\n\nimpl<F: Fn(inout Fmt)> Display for Interp<F> {\n    #[inline]\n    fn fmt(self, out: inout Fmt) {\n        (self.f)(&out);\n    }\n}\n\n// ---- Fmt's holes (0.16) ----\n\n// The spec of the hole a Fmt was writing, which Fmt::spec saves and\n// end_spec puts back (0.16).\npub struct FmtSpec { width: i64, prec: i64, flags: i64, mark: i64 }\n\nimpl Fmt {\n    // An f-string's hole of a decimal integer with a spec of width w and\n    // flags (`{n:>5}`, `{n:05}`): what spec, int and end_spec write, in one\n    // pass (0.16).\n    #[inline]\n    pub fn int_hole(inout self, v: i64, w: i64, flags: i64) {\n        let negative = v < 0;\n        fmt_hole(&self, if negative { (-(v + 1)) as u64 + 1 } else { v as u64 }, negative, w,\n            flags);\n    }\n\n    #[inline]\n");
        buf_str(out, c"    pub fn uint_hole(inout self, v: u64, w: i64, flags: i64) {\n        fmt_hole(&self, v, false, w, flags);\n    }\n}\n\n// Fmt::int_hole: u (after a '-' when negative) padded to w: with spaces\n// before it (after it: FMT_LEFT), or zeros after its sign (FMT_ZERO).\n#[inline(never)]\nfn fmt_hole(f: inout Fmt, u: u64, negative: bool, w: i64, flags: i64) {\n    let n = if negative { decimal_len(u) + 1 } else { decimal_len(u) };\n    let pad = w - n;\n    if pad <= 0 {\n        fmt_decimal(&f, u, negative);\n        return;\n    }\n    if w > FMT_CAP {\n        // (as spec and end_spec do)\n        let old = f.spec(w, -1, flags);\n        fmt_number_start(&f);\n        fmt_decimal(&f, u, negative);\n        f.end_spec(old);\n        return;\n    }\n    var out = fmt_room(&f, w);\n    if out.len != w {\n        out = fmt_make_room(&f, w);\n        if out.len != w {\n            return;\n        }\n    }\n    unsafe {\n        let p = out.ptr;\n        if (flags & FMT_LEFT) != 0 {\n            put_decimal(p, n, u, negative);\n            for k in n..w {\n                p[k] = ' ';\n            }\n        } else {\n            put_decimal(&p[pad], n, u, negative);\n            let fill: u8 = if (flags & FMT_ZERO) != 0 { '0' } else { ' ' };\n            for k in 0..pad {\n                p[k] = fill;\n            }\n            if negative && fill == '0' {\n                p[0] = '-';\n                p[pad] = '0';\n            }\n        }\n    }\n}\n\n// ---- Display and Debug of floats (0.20) ----\n\n// (A section of its own, read only by programs that have floats: a float\n// literal, `f64` or `f32`, an `import` (front/modules/stdsections.tach);\n// with it the shortest digits and the powers of ten.)\n\nimpl Display for f64 {\n    #[inline]\n    fn fmt(self, f: inout Fmt) { fmt_float(&f, self, false, false); }\n}\n\nimpl Debug for f64 {\n    #[inline]\n    fn fmt_debug(self, f: inout Fmt) { fmt_float(&f, self, false, true); }\n}\n\nimpl Display for f32 {\n");
        buf_str(out, c"    #[inline]\n    fn fmt(self, f: inout Fmt) { fmt_float(&f, self as f64, true, false); }\n}\n\nimpl Debug for f32 {\n    #[inline]\n    fn fmt_debug(self, f: inout Fmt) { fmt_float(&f, self as f64, true, true); }\n}\n\nimpl Fmt {\n    // v as Display writes it: the shortest decimal that reads back as v,\n    // never with an exponent; with a precision, that many decimals.\n    pub fn float(inout self, v: f64) {\n        fmt_float(&self, v, false, false);\n    }\n}\n\n// (0.20) `{:e}`, `{:E}` (with FMT_UPPER; fmt.tach's FMT_ flags): a\n// float's exponent form (fmt_float).\nconst FMT_EXP: i64 = 512;\n\n// v in decimal (single: an f32's value): the shortest digits that read\n// back as v (Schubfach, 0.20), never with an exponent for Display; Debug\n// as Rust writes it (`1.0`, `1e16`, `1e-7`); `{:e}`, `{:E}` (FMT_EXP) as\n// Rust's LowerExp and UpperExp (`1.5e3`). With a precision, that many\n// decimals (C's %.Nf; with `e`, %.Ne in Rust's layout).\n#[inline(never)]\nfn fmt_float(f: inout Fmt, v: f64, single: bool, debug: bool) {\n    if f.flags != 0 {\n        fmt_number_start(&f);\n    }\n    if f.prec >= 0 && v == v && v - v == 0.0 {\n        fmt_float_prec(&f, v);\n        return;\n    }\n    var mode = if debug { FloatFmt::Debug } else { FloatFmt::Display };\n    if (f.flags & FMT_EXP) != 0 {\n        mode = if (f.flags & FMT_UPPER) != 0 { FloatFmt::UpperExp } else { FloatFmt::LowerExp };\n    }\n    var tmp: [u8; 48] = [0; 48];\n    let n = if single { write_f32(v as f32, mode, tmp[..]) } else { write_f64(v, mode, tmp[..]) };\n    if n <= 48 {\n        f.str(tmp[0..n]);\n    } else {\n        fmt_float_long(&f, v, single, mode);\n    }\n}\n\n// fmt_float's text of more than 48 bytes (Display of 1e300).\n#[inline(never)]\nfn fmt_float_long(f: inout Fmt, v: f64, single: bool, mode: FloatFmt) {\n    var tmp: [u8; 336] = [0; 336];\n    let n = if single { write_f32(v as f32, mode, tmp[..]) } else { write_f64(v, mode, tmp[..]) };\n    f.str(tmp[0..n]);\n}\n\n");
        buf_str(out, c"// fmt_float with a precision, v finite: C's %.*f (FMT_EXP: %.*e, its\n// exponent then written as Rust's, `1.50e3`).\n#[inline(never)]\nfn fmt_float_prec(f: inout Fmt, v: f64) {\n    if (f.flags & FMT_EXP) == 0 {\n        var tmp: [u8; 64] = [0; 64];\n        let n = unsafe { snprintf(&tmp[0], 64, c\"%.*f\", f.prec as i32, v) } as i64;\n        if n < 64 {\n            f.str(tmp[0..n]);\n        } else {\n            fmt_fixed_long(&f, v);\n        }\n        return;\n    }\n    // (a double's exact digits end before the 770th: zeros after 1100)\n    let prec = if f.prec > 1100 { 1100 } else { f.prec };\n    var tmp: [u8; 1200] = [0; 1200];\n    let n = unsafe { snprintf(&tmp[0], 1200, c\"%.*e\", prec as i32, v) } as i64;\n    var i = 0;\n    while i < n && tmp[i] != 'e' {\n        i += 1;\n    }\n    f.str(tmp[0..i]);\n    for _ in prec..f.prec {\n        f.byte('0');\n    }\n    f.byte(if (f.flags & FMT_UPPER) != 0 { 'E' } else { 'e' });\n    // e+05 is 5, e-05 is -5\n    var j = i + 1;\n    if j < n && tmp[j] == '-' {\n        f.byte('-');\n    }\n    j += 1;\n    while j + 1 < n && tmp[j] == '0' {\n        j += 1;\n    }\n    f.str(tmp[j..n]);\n}\n\n// v with f's precision, of 64 bytes or more: C's %.*f into a buffer on\n// the stack (a double has at most 309 digits before the point and 1074\n// after it: from 1100 decimals on they are zeros, written after).\n#[inline(never)]\nfn fmt_fixed_long(f: inout Fmt, v: f64) {\n    let prec = if f.prec > 1100 { 1100 } else { f.prec };\n    var tmp: [u8; 1424] = [0; 1424];\n    let n = unsafe { snprintf(&tmp[0], 1424, c\"%.*f\", prec as i32, v) } as i64;\n    f.str(tmp[0..if n < 1424 { n } else { 1423 }]);\n    for _ in prec..f.prec {\n        f.byte('0');\n    }\n}\n// ---- end mod std::fmt ----\n}\n// ---- mod std::num ----\npub mod num {\n// std::num: integer limits and bits (0.20: from flat/io.tach), and number\n// conversion (0.20): integers to and from text, the shortest digits of a\n");
        buf_str(out, c"// float, float text in Rust's formats, float parsing. The tables are\n// std::num::tables', made by tools/numtables/gen.tach.\n\nuse std::{Debug, Display, Fmt, ParseIntError, decimal_len, panic_str};\nuse tables::{LSHIFT_TABLE, POW10_128, POW10_MIN, POW5_DIGITS};\n\npub mod tables;\n\n// ---- Integer limits (0.15) ----\n\n// The smallest and largest values of the integer types: the same as the\n// builtin `i32::MAX`, `u8::MIN`, ... (aliases, from before those).\npub const I8_MIN: i8 = i8::MIN;\npub const I8_MAX: i8 = i8::MAX;\npub const I16_MIN: i16 = i16::MIN;\npub const I16_MAX: i16 = i16::MAX;\npub const I32_MIN: i32 = i32::MIN;\npub const I32_MAX: i32 = i32::MAX;\npub const I64_MIN: i64 = i64::MIN;\npub const I64_MAX: i64 = i64::MAX;\npub const U8_MAX: u8 = u8::MAX;\npub const U16_MAX: u16 = u16::MAX;\npub const U32_MAX: u32 = u32::MAX;\npub const U64_MAX: u64 = u64::MAX;\n\n// ---- Bits (0.16) ----\n\n// The number of 1 bits of x (a narrower unsigned value widens: `count_ones(m)`\n// of a u32 m). On AArch64 these three are instructions (cnt, clz, rbit\n// and clz); elsewhere these bodies, a few operations each.\npub fn count_ones(x: u64) -> i64 {\n    let a = x - ((x >> 1) & 0x5555555555555555);\n    let b = (a & 0x3333333333333333) + ((a >> 2) & 0x3333333333333333);\n    let c = (b + (b >> 4)) & 0x0f0f0f0f0f0f0f0f;\n    ((c * 0x0101010101010101) >> 56) as i64\n}\n\n// The number of 0 bits above the highest 1 bit of x: 64 for 0, 0 when the\n// top bit is set.\npub fn leading_zeros(x: u64) -> i64 {\n    // (the highest bit smeared down, then the ones it leaves counted)\n    var y = x | (x >> 1);\n    y = y | (y >> 2);\n    y = y | (y >> 4);\n    y = y | (y >> 8);\n    y = y | (y >> 16);\n    y = y | (y >> 32);\n    64 - count_ones(y)\n}\n\n// The number of 0 bits below the lowest 1 bit of x: 64 for 0. For x != 0,\n// 1 << trailing_zeros(x) is x & -x, its lowest set bit.\npub fn trailing_zeros(x: u64) -> i64 {\n    count_ones(~x & (x - 1))\n}\n\n");
        buf_str(out, c"// ---- Numbers: bits and wide products (0.20) ----\n\n// Number conversion (0.20, docs/design/collections-text-io.md §2.5.5):\n// integers to and from text, the shortest digits of a float (Schubfach),\n// float text in Rust's formats, and float parsing (Rust's dec2flt: Clinger's\n// fast path, Eisel and Lemire, the simple-decimal fallback). The tables are\n// numtables.tach's, made by tools/numtables/gen.tach. Every routine is a\n// function of its arguments and those immutable tables, and allocates\n// nothing.\n//\n// unsafe: only the bit casts below (a union read: both fields are 8 (or 4)\n// plain bytes, and every bit pattern is a valid f64 and u64).\n\n#[repr(C)]\nunion NumF64Bits { f: f64, u: u64 }\n\n#[repr(C)]\nunion NumF32Bits { f: f32, u: u32 }\n\n// v's IEEE 754 bits (Rust's f64::to_bits).\n#[inline]\npub fn f64_to_bits(v: f64) -> u64 {\n    let b = NumF64Bits { f: v };\n    // (see the header: any bits are a valid u64)\n    unsafe { b.u }\n}\n\n// The f64 with these IEEE 754 bits (Rust's f64::from_bits).\n#[inline]\npub fn f64_from_bits(u: u64) -> f64 {\n    let b = NumF64Bits { u: u };\n    // (see the header: any bits are a valid f64)\n    unsafe { b.f }\n}\n\n// v's IEEE 754 bits (Rust's f32::to_bits).\n#[inline]\npub fn f32_to_bits(v: f32) -> u32 {\n    let b = NumF32Bits { f: v };\n    // (see the header: any bits are a valid u32)\n    unsafe { b.u }\n}\n\n// The f32 with these IEEE 754 bits (Rust's f32::from_bits).\n#[inline]\npub fn f32_from_bits(u: u32) -> f32 {\n    let b = NumF32Bits { u: u };\n    // (see the header: any bits are a valid f32)\n    unsafe { b.f }\n}\n\n// The high 64 bits of the 128-bit product a * b.\n#[inline]\npub fn mul_hi(a: u64, b: u64) -> u64 {\n    let a0 = a & 0xffffffff;\n    let a1 = a >> 32;\n    let b0 = b & 0xffffffff;\n    let b1 = b >> 32;\n    let p01 = a0 * b1;\n    let p10 = a1 * b0;\n    let mid = ((a0 * b0) >> 32) + (p01 & 0xffffffff) + (p10 & 0xffffffff);\n");
        buf_str(out, c"    a1 * b1 + (p01 >> 32) + (p10 >> 32) + (mid >> 32)\n}\n\n// The 128-bit product a * b as (high, low) (Rust: (a as u128) * (b as u128)).\n#[inline]\npub fn wide_mul(a: u64, b: u64) -> (u64, u64) {\n    (mul_hi(a, b), a * b)\n}\n\n// ---- Numbers: digits (0.20) ----\n\n// The digit pairs \"00\" to \"99\".\nconst NUM_PAIRS: [u8] = \"00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899\";\n\n// x's decimal digits in out[at..at + n], n its number of digits\n// (decimal_len(x)), two at a time from the end.\n#[inline]\nfn num_put_digits(out: [u8], at: i64, n: i64, x: u64) {\n    var i = at + n;\n    var v = x;\n    for _ in 0..5 {\n        if !(v >= 10000) {\n            break;\n        }\n        let q = v / 10000;\n        let r = v - q * 10000;\n        let hi = (r / 100) as i64 * 2;\n        let lo = (r % 100) as i64 * 2;\n        out[i - 4] = NUM_PAIRS[hi];\n        out[i - 3] = NUM_PAIRS[hi + 1];\n        out[i - 2] = NUM_PAIRS[lo];\n        out[i - 1] = NUM_PAIRS[lo + 1];\n        i -= 4;\n        v = q;\n    }\n    if v >= 100 {\n        let q = v / 100;\n        let r = (v - q * 100) as i64 * 2;\n        out[i - 2] = NUM_PAIRS[r];\n        out[i - 1] = NUM_PAIRS[r + 1];\n        i -= 2;\n        v = q;\n    }\n    if v >= 10 {\n        let r = v as i64 * 2;\n        out[i - 2] = NUM_PAIRS[r];\n        out[i - 1] = NUM_PAIRS[r + 1];\n    } else {\n        out[i - 1] = '0' + v as u8;\n    }\n}\n\n// s[i..i + 8] as a little-endian u64 (i + 8 <= s.len).\n#[inline]\nfn num_load8(s: [u8], i: i64) -> u64 {\n    if i < 0 || i + 8 > s.len {\n        panic_str(\"num_load8: out of the slice\");\n    }\n    // (unsafe: s[i..i + 8] is in the slice, checked above; an 8-byte load\n    // at any address is defined on AArch64 and x86-64, both little-endian,\n    // and the compiler assumes no alignment of a *u64 read)\n");
        buf_str(out, c"    unsafe { *(&s.ptr[i] as *u64) }\n}\n\n// Whether the 8 bytes of v are ASCII digits.\n#[inline]\nfn num_is_8digits(v: u64) -> bool {\n    (((v + 0x4646464646464646) | (v - 0x3030303030303030)) & 0x8080808080808080) == 0\n}\n\n// The number the 8 ASCII digits of v spell, the first in the lowest byte\n// (SWAR: pairs, then fours, then the eight).\n#[inline]\nfn num_parse_8digits(v: u64) -> u64 {\n    let x = v - 0x3030303030303030;\n    let y = x * 10 + (x >> 8);\n    (((y & 0x000000ff000000ff) * 0x000f424000000064)\n        + (((y >> 16) & 0x000000ff000000ff) * 0x0000271000000001)) >> 32\n}\n\n// ---- Numbers: integer text (0.20) ----\n\n// v's decimal digits at the end of out, out[start..20]: the start (Rust's\n// itoa; Display of a u64 is that text).\npub fn fmt_u64(v: u64, out: inout [u8; 20]) -> i64 {\n    let n = decimal_len(v);\n    num_put_digits(out[..], 20 - n, n, v);\n    20 - n\n}\n\n// v in decimal at the end of out, after a '-' when negative: the start.\npub fn fmt_i64(v: i64, out: inout [u8; 20]) -> i64 {\n    let negative = v < 0;\n    let u = if negative { (-(v + 1)) as u64 + 1 } else { v as u64 };\n    let n = decimal_len(u);\n    num_put_digits(out[..], 20 - n, n, u);\n    if negative {\n        out[19 - n] = '-';\n        return 19 - n;\n    }\n    20 - n\n}\n\n// The value of byte c as a digit of radix (2 to 36): 0-9, then a-z or\n// A-Z; radix or more when it is none.\n#[inline]\nfn num_digit_value(c: u8, radix: u32) -> u32 {\n    let d = (c - '0') as u32;\n    if radix <= 10 || d < 10 {\n        return d;\n    }\n    let l = ((c | 0x20) - 'a') as u32;\n    if l < 26 { l + 10 } else { 36 }\n}\n\n// The first byte of s[i..] that is no digit of radix, as the error (an\n// overflow when there is none).\nfn num_overflow_or_digit(s: [u8], i: i64, radix: u32) -> ParseIntError {\n    for k in i..s.len {\n        if num_digit_value(s[k], radix) >= radix {\n            return ParseIntError::InvalidDigit(k);\n        }\n    }\n");
        buf_str(out, c"    ParseIntError::Overflow\n}\n\n// The digits s[i..] in radix, as a u64 that may be at most `max`; Err as\n// parse_int reports them: the first byte that is no digit, else Overflow.\n#[inline]\nfn num_parse_digits_u64(s: [u8], start: i64, radix: u32, max: u64) -> Result<u64, ParseIntError> {\n    var i = start;\n    let len = s.len;\n    var v: u64 = 0;\n    if radix == 10 && len - i <= 18 {\n        // (at most 18 digits: no overflow; 8 at a time)\n        for _ in 0..s.len + 1 {\n            if !(i + 8 <= len) {\n                break;\n            }\n            let w = num_load8(s, i);\n            if !num_is_8digits(w) {\n                break;\n            }\n            v = v * 100000000 + num_parse_8digits(w);\n            i += 8;\n        }\n        for _ in 0..s.len + 1 {\n            if !(i < len) {\n                break;\n            }\n            let d = s[i] - '0';\n            if d >= 10 {\n                return Result::Err(ParseIntError::InvalidDigit(i));\n            }\n            v = v * 10 + d as u64;\n            i += 1;\n        }\n        if v > max {\n            return Result::Err(ParseIntError::Overflow);\n        }\n        return Result::Ok(v);\n    }\n    let r = radix as u64;\n    let limit = max / r;\n    for _ in 0..s.len + 1 {\n        if !(i < len) {\n            break;\n        }\n        let d = num_digit_value(s[i], radix);\n        if d >= radix {\n            return Result::Err(ParseIntError::InvalidDigit(i));\n        }\n        if v > limit || v * r > max - d as u64 {\n            return Result::Err(num_overflow_or_digit(s, i, radix));\n        }\n        v = v * r + d as u64;\n        i += 1;\n    }\n    Result::Ok(v)\n}\n\nfn num_check_radix(radix: u32) {\n    if radix < 2 || radix > 36 {\n        panic_str(\"from_str_radix_int: must lie in the range `[2, 36]`\");\n    }\n}\n\n// s as a u64 in radix (2 to 36; else a panic): Rust's u64::from_str_radix:\n");
        buf_str(out, c"// an optional '+', then digits (0-9, a-z or A-Z), nothing else. Err: Empty;\n// InvalidDigit(i), the index of the first byte that is no digit (a lone\n// '+' too); Overflow.\npub fn parse_u64_radix(s: [u8], radix: u32) -> Result<u64, ParseIntError> {\n    num_check_radix(radix);\n    if s.len == 0 {\n        return Result::Err(ParseIntError::Empty);\n    }\n    let start = if s[0] == '+' { 1 } else { 0 };\n    if start == s.len {\n        return Result::Err(ParseIntError::InvalidDigit(0));\n    }\n    num_parse_digits_u64(s, start, radix, 0xffffffffffffffff)\n}\n\n// s as an i64 in radix (2 to 36; else a panic): Rust's i64::from_str_radix:\n// an optional '+' or '-', then digits, nothing else; errors as\n// parse_u64_radix's (Overflow on either side).\npub fn parse_i64_radix(s: [u8], radix: u32) -> Result<i64, ParseIntError> {\n    num_check_radix(radix);\n    if s.len == 0 {\n        return Result::Err(ParseIntError::Empty);\n    }\n    let negative = s[0] == '-';\n    let start = if negative || s[0] == '+' { 1 } else { 0 };\n    if start == s.len {\n        return Result::Err(ParseIntError::InvalidDigit(0));\n    }\n    num_parse_i64_from(s, start, radix, negative)\n}\n\n// parse_i64_radix after the sign (s[start..] not empty).\n#[inline]\nfn num_parse_i64_from(s: [u8], start: i64, radix: u32, negative: bool) -> Result<i64,\n    ParseIntError> {\n    let max: u64 = if negative { 0x8000000000000000 } else { 0x7fffffffffffffff };\n    match num_parse_digits_u64(s, start, radix, max) {\n        Result::Ok(u) => Result::Ok(if negative { (0 - u) as i64 } else { u as i64 }),\n        Result::Err(e) => Result::Err(e),\n    }\n}\n\n// ---- Numbers: the shortest digits of a float (0.20) ----\n\n// Schubfach (Giulietti, \"The Schubfach way to render doubles\", 2020; the\n// layout of Bolz's C++ port): the shortest decimal d * 10^k in v's rounding\n// interval, the closest to v of those (ties to an even d). Rust's Display\n");
        buf_str(out, c"// and Debug write the same digits (Grisu with Dragon4's fallback finds\n// them too).\n\n// g * cp / 2^128 rounded to odd (g = (ghi, glo), 128 bits).\n#[inline]\nfn num_round_to_odd64(ghi: u64, glo: u64, cp: u64) -> u64 {\n    let x1 = mul_hi(glo, cp);\n    let y1 = mul_hi(ghi, cp);\n    let y0 = ghi * cp;\n    let z = y0 + x1;\n    let hi = if z < x1 { y1 + 1 } else { y1 };\n    if z > 1 { hi | 1 } else { hi }\n}\n\n// The shortest decimal of a positive finite double given as its fields\n// (significand bits f, biased exponent e): (d, k), d possibly with\n// trailing zeros.\nfn num_schubfach64(f: u64, e: i64) -> (u64, i64) {\n    var c = f;\n    var q: i64 = -1074;\n    if e != 0 {\n        c = f | 0x10000000000000;\n        q = e - 1075;\n        // (an integer: itself)\n        if q <= 0 && q > -53 && (c & ((1 << (-q) as u64) - 1)) == 0 {\n            return (c >> (-q) as u64, 0);\n        }\n    }\n    let even = (c & 1) == 0;\n    let closer = f == 0 && e > 1;\n    let cbl = if closer { 4 * c - 1 } else { 4 * c - 2 };\n    let cb = 4 * c;\n    let cbr = 4 * c + 2;\n    // k = floor(log10(2^q)), or floor(log10(3/4 2^q)) when the lower\n    // boundary is closer; h = q + floor(log2(10^-k)) + 1, from 1 to 4\n    let k = (q * 1262611 - (if closer { 524031 } else { 0 })) >> 22;\n    let h = (q + ((-k * 1741647) >> 19) + 1) as u64;\n    let at = 2 * (-k - POW10_MIN);\n    let ghi0 = POW10_128[at];\n    let glo = POW10_128[at + 1] + 1;\n    let ghi = if glo == 0 { ghi0 + 1 } else { ghi0 };\n    let vbl = num_round_to_odd64(ghi, glo, cbl << h);\n    let vb = num_round_to_odd64(ghi, glo, cb << h);\n    let vbr = num_round_to_odd64(ghi, glo, cbr << h);\n    let lower = if even { vbl } else { vbl + 1 };\n    let upper = if even { vbr } else { vbr - 1 };\n    let s = vb / 4;\n    if s >= 10 {\n        // (one digit fewer: at most one of u' and w' is inside)\n        let sp = s / 10;\n        let up_inside = lower <= 40 * sp;\n        let wp_inside = 40 * sp + 40 <= upper;\n");
        buf_str(out, c"        if up_inside != wp_inside {\n            return (if wp_inside { sp + 1 } else { sp }, k + 1);\n        }\n    }\n    let u_inside = lower <= 4 * s;\n    let w_inside = 4 * s + 4 <= upper;\n    if u_inside != w_inside {\n        return (if w_inside { s + 1 } else { s }, k);\n    }\n    // (vb, odd when inexact, equals mid only on an exact tie: up, as Rust's\n    // Grisu and Dragon4 round it, where Schubfach's paper rounds to even)\n    let mid = 4 * s + 2;\n    (if vb >= mid { s + 1 } else { s }, k)\n}\n\n// g * cp / 2^64 rounded to odd (g 64 bits, cp less than 2^32).\n#[inline]\nfn num_round_to_odd32(g: u64, cp: u64) -> u64 {\n    let b01 = cp * (g & 0xffffffff);\n    let b11 = cp * (g >> 32);\n    let hi = b11 + (b01 >> 32);\n    let y1 = hi >> 32;\n    if (hi & 0xffffffff) > 1 { y1 | 1 } else { y1 }\n}\n\n// num_schubfach64 for a float (f: 23 bits, e: 8).\nfn num_schubfach32(f: u64, e: i64) -> (u64, i64) {\n    var c = f;\n    var q: i64 = -149;\n    if e != 0 {\n        c = f | 0x800000;\n        q = e - 150;\n        if q <= 0 && q > -24 && (c & ((1 << (-q) as u64) - 1)) == 0 {\n            return (c >> (-q) as u64, 0);\n        }\n    }\n    let even = (c & 1) == 0;\n    let closer = f == 0 && e > 1;\n    let cbl = if closer { 4 * c - 1 } else { 4 * c - 2 };\n    let cb = 4 * c;\n    let cbr = 4 * c + 2;\n    let k = (q * 1262611 - (if closer { 524031 } else { 0 })) >> 22;\n    let h = (q + ((-k * 1741647) >> 19) + 1) as u64;\n    let g = POW10_128[2 * (-k - POW10_MIN)] + 1;\n    let vbl = num_round_to_odd32(g, cbl << h);\n    let vb = num_round_to_odd32(g, cb << h);\n    let vbr = num_round_to_odd32(g, cbr << h);\n    let lower = if even { vbl } else { vbl + 1 };\n    let upper = if even { vbr } else { vbr - 1 };\n    let s = vb / 4;\n    if s >= 10 {\n        let sp = s / 10;\n        let up_inside = lower <= 40 * sp;\n        let wp_inside = 40 * sp + 40 <= upper;\n        if up_inside != wp_inside {\n");
        buf_str(out, c"            return (if wp_inside { sp + 1 } else { sp }, k + 1);\n        }\n    }\n    let u_inside = lower <= 4 * s;\n    let w_inside = 4 * s + 4 <= upper;\n    if u_inside != w_inside {\n        return (if w_inside { s + 1 } else { s }, k);\n    }\n    // (vb, odd when inexact, equals mid only on an exact tie: up, as Rust's\n    // Grisu and Dragon4 round it, where Schubfach's paper rounds to even)\n    let mid = 4 * s + 2;\n    (if vb >= mid { s + 1 } else { s }, k)\n}\n\n// (d, k) without d's trailing zeros (d != 0).\n#[inline]\nfn num_trim_zeros(d: u64, k: i64) -> (u64, i64) {\n    var x = d;\n    var e = k;\n    for _ in 0..20 {\n        if !(x % 10 == 0) {\n            break;\n        }\n        x = x / 10;\n        e += 1;\n    }\n    (x, e)\n}\n\n// The shortest decimal of |v|, finite: (d, k), |v| reads back from d *\n// 10^k, d without trailing zeros (0 for a zero: (0, 0)). Those are the\n// digits Rust prints. Not finite: (0, 0).\npub fn f64_shortest(v: f64) -> (u64, i32) {\n    let bits = f64_to_bits(v);\n    let f = bits & 0xfffffffffffff;\n    let e = ((bits >> 52) & 0x7ff) as i64;\n    if e == 0x7ff || (e == 0 && f == 0) {\n        return (0, 0);\n    }\n    let (d, k) = num_schubfach64(f, e);\n    let (d2, k2) = num_trim_zeros(d, k);\n    (d2, k2 as i32)\n}\n\n// f64_shortest for an f32: the shortest digits that read back as v as an f32.\npub fn f32_shortest(v: f32) -> (u64, i32) {\n    let bits = f32_to_bits(v) as u64;\n    let f = bits & 0x7fffff;\n    let e = ((bits >> 23) & 0xff) as i64;\n    if e == 0xff || (e == 0 && f == 0) {\n        return (0, 0);\n    }\n    let (d, k) = num_schubfach32(f, e);\n    let (d2, k2) = num_trim_zeros(d, k);\n    (d2, k2 as i32)\n}\n\n// ---- Numbers: float text (0.20) ----\n\n// How write_f64 and write_f32 lay a float out, as Rust's formats do:\n// Display (`{}`) never with an exponent (`1e16` is `10000000000000000`,\n// `1e-7` is `0.0000001`); Debug (`{:?}`): `1.0`, and an exponent below\n");
        buf_str(out, c"// 1e-4 and from 1e16 on (`1e16`, `1e-7`); LowerExp (`{:e}`): `1.5e3`,\n// `0e0`; UpperExp (`{:E}`): `1.5E3`. All with the shortest digits that\n// read back as the value; `NaN`, `inf`, `-inf`.\npub enum FloatFmt { Display, Debug, LowerExp, UpperExp }\n\n// The longest text write_f64 writes: 330 bytes (a sign, `0.`, 323 zeros\n// and digits; Display of the smallest subnormal).\npub const FLOAT_TEXT_MAX: i64 = 330;\n\n// The text of (a '-' when negative) d * 10^k in mode, d without trailing\n// zeros (0: zero), into out[0..len] when it fits: len.\nfn num_float_text(out: [u8], negative: bool, d: u64, k: i64, mode: FloatFmt) -> i64 {\n    let n = decimal_len(d);\n    let e = k + n - 1;\n    let i = if negative { 1 } else { 0 };\n    let debug = mode == FloatFmt::Debug;\n    if mode == FloatFmt::LowerExp || mode == FloatFmt::UpperExp\n        || (debug && d != 0 && (e < -4 || e >= 16)) {\n        // d[.ddd]e[-]x\n        let ae = if e < 0 { -e } else { e };\n        let elen = decimal_len(ae as u64);\n        let point = if n > 1 { 1 } else { 0 };\n        let minus = if e < 0 { 1 } else { 0 };\n        let len = i + n + point + 1 + minus + elen;\n        if len > out.len {\n            return len;\n        }\n        if negative {\n            out[0] = '-';\n        }\n        num_put_digits(out, i + 1, n, d);\n        out[i] = out[i + 1];\n        var j = i + 1;\n        if n > 1 {\n            out[i + 1] = '.';\n            j = i + n + 1;\n        }\n        out[j] = if mode == FloatFmt::UpperExp { 'E' } else { 'e' };\n        if e < 0 {\n            out[j + 1] = '-';\n        }\n        num_put_digits(out, j + 1 + minus, elen, ae as u64);\n        return len;\n    }\n    if e < 0 {\n        // 0.000ddd\n        let zeros = -e - 1;\n        let len = i + 2 + zeros + n;\n        if len > out.len {\n            return len;\n        }\n        if negative {\n            out[0] = '-';\n        }\n        out[i] = '0';\n        out[i + 1] = '.';\n");
        buf_str(out, c"        for z in 0..zeros {\n            out[i + 2 + z] = '0';\n        }\n        num_put_digits(out, i + 2 + zeros, n, d);\n        return len;\n    }\n    if k >= 0 {\n        // ddd000 (Debug: ddd000.0)\n        let len = i + n + k + (if debug { 2 } else { 0 });\n        if len > out.len {\n            return len;\n        }\n        if negative {\n            out[0] = '-';\n        }\n        num_put_digits(out, i, n, d);\n        for z in 0..k {\n            out[i + n + z] = '0';\n        }\n        if debug {\n            out[i + n + k] = '.';\n            out[i + n + k + 1] = '0';\n        }\n        return len;\n    }\n    // dd.ddd: the digits one further, then the integer part moved back\n    let len = i + n + 1;\n    if len > out.len {\n        return len;\n    }\n    if negative {\n        out[0] = '-';\n    }\n    num_put_digits(out, i + 1, n, d);\n    for j in i..i + e + 1 {\n        out[j] = out[j + 1];\n    }\n    out[i + e + 1] = '.';\n    len\n}\n\n// The text of NaN or an infinity in out, when it fits: its length.\nfn num_float_special(out: [u8], nan: bool, negative: bool) -> i64 {\n    let t = if nan { \"NaN\" } else if negative { \"-inf\" } else { \"inf\" };\n    if t.len <= out.len {\n        for j in 0..t.len {\n            out[j] = t[j];\n        }\n    }\n    t.len\n}\n\n// v's text in mode (FloatFmt) into out when it fits (FLOAT_TEXT_MAX bytes\n// always do): its length. As Rust's `{}`, `{:?}`, `{:e}`, `{:E}`.\npub fn write_f64(v: f64, mode: FloatFmt, out: [u8]) -> i64 {\n    let bits = f64_to_bits(v);\n    let negative = (bits >> 63) != 0;\n    let f = bits & 0xfffffffffffff;\n    let e = ((bits >> 52) & 0x7ff) as i64;\n    if e == 0x7ff {\n        return num_float_special(out, f != 0, negative);\n    }\n    if e == 0 && f == 0 {\n        return num_float_text(out, negative, 0, 0, mode);\n    }\n    let (d, k) = num_schubfach64(f, e);\n    let (d2, k2) = num_trim_zeros(d, k);\n    num_float_text(out, negative, d2, k2, mode)\n}\n\n");
        buf_str(out, c"// write_f64 for an f32: its own shortest digits (0.1f32 is `0.1`).\npub fn write_f32(v: f32, mode: FloatFmt, out: [u8]) -> i64 {\n    let bits = f32_to_bits(v) as u64;\n    let negative = (bits >> 31) != 0;\n    let f = bits & 0x7fffff;\n    let e = ((bits >> 23) & 0xff) as i64;\n    if e == 0xff {\n        return num_float_special(out, f != 0, negative);\n    }\n    if e == 0 && f == 0 {\n        return num_float_text(out, negative, 0, 0, mode);\n    }\n    let (d, k) = num_schubfach32(f, e);\n    let (d2, k2) = num_trim_zeros(d, k);\n    num_float_text(out, negative, d2, k2, mode)\n}\n\n// ---- Numbers: float parsing (0.20) ----\n\n// Why parse_f64 failed (Rust's ParseFloatError): the text is empty, or it\n// is no float.\npub enum ParseFloatError { Empty, Invalid }\n\nimpl Display for ParseFloatError {\n    fn fmt(self, f: inout Fmt) {\n        match self {\n            ParseFloatError::Empty => f.str(\"cannot parse float from empty string\"),\n            ParseFloatError::Invalid => f.str(\"invalid float literal\"),\n        }\n    }\n}\n\nimpl Debug for ParseFloatError {\n    fn fmt_debug(self, f: inout Fmt) {\n        match self {\n            ParseFloatError::Empty => f.str(\"Empty\"),\n            ParseFloatError::Invalid => f.str(\"Invalid\"),\n        }\n    }\n}\n\n// s as the nearest f64 (ties to even): Rust's f64::from_str. An optional\n// '+' or '-', then digits with an optional '.' (`1.`, `.5`; at least one\n// digit), then an optional exponent (`e` or `E`, an optional sign,\n// digits); or `inf`, `infinity`, `nan` in any case. Nothing else: no\n// spaces, no `_`, no hex. Too large is an infinity, too small a zero.\npub fn parse_f64(s: [u8]) -> Result<f64, ParseFloatError> {\n    match num_dec2flt(s, false) {\n        Result::Ok(bits) => Result::Ok(f64_from_bits(bits)),\n        Result::Err(e) => Result::Err(e),\n    }\n}\n\n// parse_f64 for an f32: rounded once, to the nearest f32 (not through f64).\n");
        buf_str(out, c"pub fn parse_f32(s: [u8]) -> Result<f32, ParseFloatError> {\n    match num_dec2flt(s, true) {\n        Result::Ok(bits) => Result::Ok(f32_from_bits(bits as u32)),\n        Result::Err(e) => Result::Err(e),\n    }\n}\n\n// The decimal a text spells: mantissa * 10^exponent, the mantissa its\n// first 19 significant digits when there are more (many_digits).\nstruct NumDecimalParts { mantissa: u64, exponent: i64, many_digits: bool }\n\nconst NUM_MIN_19DIGIT: u64 = 1000000000000000000;\n\n// The digits at s[i..] appended to *m (wrapping), 8 at a time while they\n// last: the index after them.\n#[inline]\nfn num_take_digits(s: [u8], start: i64, m: inout u64) -> i64 {\n    var i = start;\n    let len = s.len;\n    var v = m;\n    for _ in 0..s.len + 1 {\n        if !(i + 8 <= len) {\n            break;\n        }\n        let w = num_load8(s, i);\n        if !num_is_8digits(w) {\n            break;\n        }\n        v = v * 100000000 + num_parse_8digits(w);\n        i += 8;\n    }\n    for _ in 0..s.len + 1 {\n        if !(i < len) {\n            break;\n        }\n        let d = s[i] - '0';\n        if d >= 10 {\n            break;\n        }\n        v = v * 10 + d as u64;\n        i += 1;\n    }\n    m = v;\n    i\n}\n\n// num_take_digits until *m has 19 digits.\nfn num_take_19digits(s: [u8], start: i64, m: inout u64) -> i64 {\n    var i = start;\n    var v = m;\n    for _ in 0..s.len + 1 {\n        if !(v < NUM_MIN_19DIGIT && i < s.len) {\n            break;\n        }\n        let d = s[i] - '0';\n        if d >= 10 {\n            break;\n        }\n        v = v * 10 + d as u64;\n        i += 1;\n    }\n    m = v;\n    i\n}\n\n// s (without its sign) as a decimal (Rust's parse_number); false when it\n// is not one.\nfn num_parse_number(s: [u8], out: inout NumDecimalParts) -> bool {\n    let len = s.len;\n    var mantissa: u64 = 0;\n    var i = num_take_digits(s, 0, &mantissa);\n    let int_end = i;\n    var n_digits = i;\n    var exponent: i64 = 0;\n");
        buf_str(out, c"    if i < len && s[i] == '.' {\n        i += 1;\n        let before = i;\n        i = num_take_digits(s, i, &mantissa);\n        n_digits += i - before;\n        exponent = before - i;\n    }\n    if n_digits == 0 {\n        return false;\n    }\n    var exp_number: i64 = 0;\n    if i < len && (s[i] == 'e' || s[i] == 'E') {\n        i += 1;\n        var negative = false;\n        if i < len && (s[i] == '-' || s[i] == '+') {\n            negative = s[i] == '-';\n            i += 1;\n        }\n        if i >= len || s[i] - '0' >= 10 {\n            return false;\n        }\n        for _ in 0..s.len + 1 {\n            if !(i < len && s[i] - '0' < 10) {\n                break;\n            }\n            if exp_number < 0x10000 {\n                exp_number = 10 * exp_number + (s[i] - '0') as i64;\n            }\n            i += 1;\n        }\n        if negative {\n            exp_number = -exp_number;\n        }\n        exponent += exp_number;\n    }\n    if i != len {\n        return false;\n    }\n    out.mantissa = mantissa;\n    out.exponent = exponent;\n    out.many_digits = false;\n    if n_digits <= 19 {\n        return true;\n    }\n    // More than 19 digits, but maybe leading zeros\n    n_digits -= 19;\n    var p = 0;\n    for _ in 0..s.len + 1 {\n        if !(p < len && (s[p] == '.' || s[p] == '0')) {\n            break;\n        }\n        if s[p] == '0' {\n            n_digits -= 1;\n        }\n        p += 1;\n    }\n    if n_digits > 0 {\n        // 19 significant digits, then the exponent of what follows them\n        out.many_digits = true;\n        var m: u64 = 0;\n        var j = num_take_19digits(s, 0, &m);\n        if m >= NUM_MIN_19DIGIT {\n            out.exponent = int_end - j + exp_number;\n        } else {\n            // (stopped at the point)\n            j += 1;\n            let before = j;\n            j = num_take_19digits(s, j, &m);\n            out.exponent = before - j + exp_number;\n        }\n        out.mantissa = m;\n    }\n");
        buf_str(out, c"    true\n}\n\n// `inf`, `infinity` or `nan` in any case: (true, their bits); (false, 0)\n// when s is none.\nfn num_parse_inf_nan(s: [u8], negative: bool, single: bool) -> (bool, u64) {\n    var r: u64 = 0;\n    if s.len == 8 {\n        r = num_load8(s, 0);\n    } else if s.len == 3 {\n        r = (s[0] as u64) | ((s[1] as u64) << 8) | ((s[2] as u64) << 16);\n    } else {\n        return (false, 0);\n    }\n    // (upper case: bit 5 cleared; only a letter maps to a letter)\n    r = r & 0xdfdfdfdfdfdfdfdf;\n    let inf = (s.len == 3 && r == 0x464e49) || (s.len == 8 && r == 0x5954494e49464e49);\n    let nan = s.len == 3 && r == 0x4e414e;\n    if !inf && !nan {\n        return (false, 0);\n    }\n    var bits: u64 = if single { 0x7f800000 } else { 0x7ff0000000000000 };\n    if nan {\n        bits = if single { 0x7fc00000 } else { 0x7ff8000000000000 };\n    }\n    if negative {\n        bits |= if single { 0x80000000 } else { 0x8000000000000000 };\n    }\n    (true, bits)\n}\n\n// The exact powers of ten of f64 (10^0 to 10^22) and f32 (to 10^10), and\n// of u64 for the disguised fast path.\nconst NUM_F64_POW10: [f64; 23] = [1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11,\n    1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22];\nconst NUM_F32_POW10: [f32; 11] = [1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10];\nconst NUM_U64_POW10: [u64; 16] = [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000,\n    100000000, 1000000000, 10000000000, 100000000000, 1000000000000, 10000000000000,\n    100000000000000, 1000000000000000];\n\n// Clinger's fast path (with Rust's disguised one): the exact float of m *\n// 10^e when m and 10^e are exact floats, as bits; -1 when it does not\n// apply.\n#[inline]\nfn num_fast_path(m: u64, e: i64, single: bool) -> i64 {\n    let max_exp = if single { 10 } else { 22 };\n    let max_disguised = if single { 17 } else { 37 };\n    let max_mantissa: u64 = if single { 2 << 23 } else { 2 << 52 };\n");
        buf_str(out, c"    if e < -max_exp || e > max_disguised || m > max_mantissa {\n        return -1;\n    }\n    var mm = m;\n    var ee = e;\n    if e > max_exp {\n        // (m * 10^(e - max_exp) still exact)\n        let p = NUM_U64_POW10[e - max_exp];\n        if mul_hi(mm, p) != 0 {\n            return -1;\n        }\n        mm = mm * p;\n        if mm > max_mantissa {\n            return -1;\n        }\n        ee = max_exp;\n    }\n    if single {\n        let x = mm as f32;\n        let v = if ee < 0 { x / NUM_F32_POW10[-ee] } else { x * NUM_F32_POW10[ee] };\n        return f32_to_bits(v) as i64;\n    }\n    let x = mm as f64;\n    let v = if ee < 0 { x / NUM_F64_POW10[-ee] } else { x * NUM_F64_POW10[ee] };\n    f64_to_bits(v) as i64\n}\n\n// The table's 128-bit 5^q (normalized; Rust's POWER_OF_FIVE_128) for q from\n// -342 to 308: (high, low).\n#[inline]\nfn num_lemire_power(q: i64) -> (u64, u64) {\n    let at = 2 * (q - POW10_MIN);\n    let hi = POW10_128[at];\n    let lo = POW10_128[at + 1];\n    if q >= -27 && q <= -1 {\n        // (rounded up there)\n        let lo1 = lo + 1;\n        return (if lo1 == 0 { hi + 1 } else { hi }, lo1);\n    }\n    (hi, lo)\n}\n\n// A float's fields, (significand bits, biased exponent); a negative\n// exponent: Eisel-Lemire could not decide.\nstruct NumBiasedFp { f: u64, e: i64 }\n\n// Eisel and Lemire (Rust's compute_float): w * 10^q rounded to a float of\n// mbits significand bits (52 or 23).\nfn num_compute_float(q: i64, w0: u64, single: bool) -> NumBiasedFp {\n    let mbits: i64 = if single { 23 } else { 52 };\n    let min_exponent: i64 = if single { -127 } else { -1023 };\n    let inf_power: i64 = if single { 0xff } else { 0x7ff };\n    let smallest: i64 = if single { -65 } else { -342 };\n    let largest: i64 = if single { 38 } else { 308 };\n    let min_round_even: i64 = if single { -17 } else { -4 };\n    let max_round_even: i64 = if single { 10 } else { 23 };\n    if w0 == 0 || q < smallest {\n");
        buf_str(out, c"        return NumBiasedFp { f: 0, e: 0 };\n    }\n    if q > largest {\n        return NumBiasedFp { f: 0, e: inf_power };\n    }\n    let lz = leading_zeros(w0);\n    let w = w0 << lz as u64;\n    // w * 5^q, approximately (compute_product_approx, precision mbits + 3)\n    let (hi5, lo5) = num_lemire_power(q);\n    let mask: u64 = 0xffffffffffffffff >> (mbits + 3) as u64;\n    var first_hi = mul_hi(w, hi5);\n    var first_lo = w * hi5;\n    if (first_hi & mask) == mask {\n        let second_hi = mul_hi(w, lo5);\n        first_lo = first_lo + second_hi;\n        if second_hi > first_lo {\n            first_hi += 1;\n        }\n    }\n    let lo = first_lo;\n    let hi = first_hi;\n    if lo == 0xffffffffffffffff && (q < -27 || q > 55) {\n        return NumBiasedFp { f: 0, e: -1 };\n    }\n    let upperbit = (hi >> 63) as i64;\n    let shift = (upperbit + 64 - mbits - 3) as u64;\n    var mantissa = hi >> shift;\n    var power2 = (((q * (152170 + 65536)) >> 16) + 63) + upperbit - lz - min_exponent;\n    if power2 <= 0 {\n        if -power2 + 1 >= 64 {\n            return NumBiasedFp { f: 0, e: 0 };\n        }\n        // a subnormal\n        mantissa = mantissa >> (-power2 + 1) as u64;\n        mantissa += mantissa & 1;\n        mantissa = mantissa >> 1;\n        let e = if mantissa >= (1 << mbits as u64) { 1 } else { 0 };\n        return NumBiasedFp { f: mantissa, e: e };\n    }\n    // (exactly halfway, between two floats: to even)\n    if lo <= 1 && q >= min_round_even && q <= max_round_even && (mantissa & 3) == 1\n        && (mantissa << shift) == hi {\n        mantissa &= ~1;\n    }\n    mantissa += mantissa & 1;\n    mantissa = mantissa >> 1;\n    if mantissa >= (2 << mbits as u64) {\n        mantissa = 1 << mbits as u64;\n        power2 += 1;\n    }\n    mantissa &= ~(1 << mbits as u64);\n    if power2 >= inf_power {\n        return NumBiasedFp { f: 0, e: inf_power };\n    }\n    NumBiasedFp { f: mantissa, e: power2 }\n}\n\n");
        buf_str(out, c"// s as a float's bits (single: an f32's), or the error (Rust's dec2flt).\nfn num_dec2flt(s: [u8], single: bool) -> Result<u64, ParseFloatError> {\n    if s.len == 0 {\n        return Result::Err(ParseFloatError::Empty);\n    }\n    let negative = s[0] == '-';\n    let t = if negative || s[0] == '+' { s[1..] } else { s };\n    if t.len == 0 {\n        return Result::Err(ParseFloatError::Invalid);\n    }\n    let sign: u64 = if !negative { 0 } else if single { 0x80000000 } else { 0x8000000000000000 };\n    var num = NumDecimalParts { mantissa: 0, exponent: 0, many_digits: false };\n    if !num_parse_number(t, &num) {\n        let (ok, special) = num_parse_inf_nan(t, negative, single);\n        if !ok {\n            return Result::Err(ParseFloatError::Invalid);\n        }\n        return Result::Ok(special);\n    }\n    if !num.many_digits {\n        let fast = num_fast_path(num.mantissa, num.exponent, single);\n        if fast >= 0 {\n            return Result::Ok(fast as u64 | sign);\n        }\n    }\n    var fp = num_compute_float(num.exponent, num.mantissa, single);\n    if num.many_digits && fp.e >= 0 {\n        // (the digits after the 19th could round it up)\n        let up = num_compute_float(num.exponent, num.mantissa + 1, single);\n        if up.f != fp.f || up.e != fp.e {\n            fp.e = -1;\n        }\n    }\n    if fp.e < 0 {\n        fp = num_slow_path(t, single);\n    }\n    let mbits: u64 = if single { 23 } else { 52 };\n    Result::Ok((fp.f | ((fp.e as u64) << mbits)) | sign)\n}\n\n// ---- Numbers: float parsing's slow path (0.20) ----\n\n// The simple-decimal algorithm (Nigel Tao's; Rust's decimal.rs and\n// slow.rs) for the inputs Eisel and Lemire cannot round: the decimal's\n// first 768 digits, shifted by powers of two to [1/2, 1], then rounded.\n\nconst NUM_DEC_MAX_DIGITS: i64 = 768;\nconst NUM_DEC_POINT_RANGE: i64 = 2047;\n\n// A decimal 0.d1d2d3... * 10^decimal_point (digits 0 to 9, not ASCII);\n");
        buf_str(out, c"// truncated: digits were dropped after the 768th.\nstruct NumDecimal { num_digits: i64, decimal_point: i64, truncated: bool, digits: [u8; 768] }\n\nfn num_dec_add_digit(d: inout NumDecimal, digit: u8) {\n    if d.num_digits < NUM_DEC_MAX_DIGITS {\n        d.digits[d.num_digits] = digit;\n    }\n    d.num_digits += 1;\n}\n\nfn num_dec_trim(d: inout NumDecimal) {\n    for _ in 0..NUM_DEC_MAX_DIGITS + 1 {\n        if !(d.num_digits != 0 && d.digits[d.num_digits - 1] == 0) {\n            break;\n        }\n        d.num_digits -= 1;\n    }\n}\n\n// The integer part, rounded to nearest (ties to even), at most 2^64 - 1.\nfn num_dec_round(d: inout NumDecimal) -> u64 {\n    if d.num_digits == 0 || d.decimal_point < 0 {\n        return 0;\n    }\n    if d.decimal_point > 18 {\n        return 0xffffffffffffffff;\n    }\n    let dp = d.decimal_point;\n    var n: u64 = 0;\n    for i in 0..dp {\n        n = n * 10;\n        if i < d.num_digits {\n            n += d.digits[i] as u64;\n        }\n    }\n    var round_up = false;\n    if dp < d.num_digits {\n        round_up = d.digits[dp] >= 5;\n        if d.digits[dp] == 5 && dp + 1 == d.num_digits {\n            round_up = d.truncated || (dp != 0 && (d.digits[dp - 1] & 1) != 0);\n        }\n    }\n    if round_up {\n        n += 1;\n    }\n    n\n}\n\n// How many digits shifting left by `shift` adds (Rust's\n// number_of_digits_decimal_left_shift).\nfn num_dec_new_digits(d: inout NumDecimal, shift: i64) -> i64 {\n    let s = shift & 63;\n    let x_a = LSHIFT_TABLE[s] as i64;\n    let x_b = LSHIFT_TABLE[s + 1] as i64;\n    let num_new_digits = x_a >> 11;\n    let pow5_a = 0x7ff & x_a;\n    let pow5_b = 0x7ff & x_b;\n    for i in 0..pow5_b - pow5_a {\n        let p5 = POW5_DIGITS[pow5_a + i] - '0';\n        if i >= d.num_digits {\n            return num_new_digits - 1;\n        }\n        if d.digits[i] == p5 {\n            continue;\n        }\n        if d.digits[i] < p5 {\n            return num_new_digits - 1;\n        }\n");
        buf_str(out, c"        return num_new_digits;\n    }\n    num_new_digits\n}\n\n// d * 2^shift (shift at most 60).\nfn num_dec_left_shift(d: inout NumDecimal, shift: i64) {\n    if d.num_digits == 0 {\n        return;\n    }\n    let num_new_digits = num_dec_new_digits(&d, shift);\n    var read_index = d.num_digits;\n    var write_index = d.num_digits + num_new_digits;\n    var n: u64 = 0;\n    for _ in 0..NUM_DEC_MAX_DIGITS + 1 {\n        if !(read_index != 0) {\n            break;\n        }\n        read_index -= 1;\n        write_index -= 1;\n        n += (d.digits[read_index] as u64) << shift as u64;\n        let quotient = n / 10;\n        let remainder = n - 10 * quotient;\n        if write_index < NUM_DEC_MAX_DIGITS {\n            d.digits[write_index] = remainder as u8;\n        } else if remainder > 0 {\n            d.truncated = true;\n        }\n        n = quotient;\n    }\n    for _ in 0..20 {\n        if !(n > 0) {\n            break;\n        }\n        write_index -= 1;\n        let quotient = n / 10;\n        let remainder = n - 10 * quotient;\n        if write_index < NUM_DEC_MAX_DIGITS {\n            d.digits[write_index] = remainder as u8;\n        } else if remainder > 0 {\n            d.truncated = true;\n        }\n        n = quotient;\n    }\n    d.num_digits += num_new_digits;\n    if d.num_digits > NUM_DEC_MAX_DIGITS {\n        d.num_digits = NUM_DEC_MAX_DIGITS;\n    }\n    d.decimal_point += num_new_digits;\n    num_dec_trim(&d);\n}\n\n// d / 2^shift (shift at most 60).\nfn num_dec_right_shift(d: inout NumDecimal, shift: i64) {\n    let sh = shift as u64;\n    var read_index = 0;\n    var write_index = 0;\n    var n: u64 = 0;\n    for _ in 0..NUM_DEC_MAX_DIGITS + 40 {\n        if !((n >> sh) == 0) {\n            break;\n        }\n        if read_index < d.num_digits {\n            n = 10 * n + d.digits[read_index] as u64;\n            read_index += 1;\n        } else if n == 0 {\n            return;\n        } else {\n            for _ in 0..20 {\n");
        buf_str(out, c"                if !((n >> sh) == 0) {\n                    break;\n                }\n                n = n * 10;\n                read_index += 1;\n            }\n            break;\n        }\n    }\n    d.decimal_point -= read_index - 1;\n    if d.decimal_point < -NUM_DEC_POINT_RANGE {\n        d.num_digits = 0;\n        d.decimal_point = 0;\n        d.truncated = false;\n        return;\n    }\n    let mask: u64 = (1 << sh) - 1;\n    for _ in 0..NUM_DEC_MAX_DIGITS + 1 {\n        if !(read_index < d.num_digits) {\n            break;\n        }\n        let new_digit = (n >> sh) as u8;\n        n = 10 * (n & mask) + d.digits[read_index] as u64;\n        read_index += 1;\n        d.digits[write_index] = new_digit;\n        write_index += 1;\n    }\n    for _ in 0..200 {\n        if !(n > 0) {\n            break;\n        }\n        let new_digit = (n >> sh) as u8;\n        n = 10 * (n & mask);\n        if write_index < NUM_DEC_MAX_DIGITS {\n            d.digits[write_index] = new_digit;\n            write_index += 1;\n        } else if new_digit > 0 {\n            d.truncated = true;\n        }\n    }\n    d.num_digits = write_index;\n    num_dec_trim(&d);\n}\n\n// s, a valid float text without its sign, as a NumDecimal (Rust's\n// parse_decimal).\nfn num_parse_decimal(s: [u8], d: inout NumDecimal) {\n    let len = s.len;\n    var i = 0;\n    for _ in 0..s.len + 1 {\n        if !(i < len && s[i] == '0') {\n            break;\n        }\n        i += 1;\n    }\n    for _ in 0..s.len + 1 {\n        if !(i < len && s[i] - '0' < 10) {\n            break;\n        }\n        num_dec_add_digit(&d, s[i] - '0');\n        i += 1;\n    }\n    if i < len && s[i] == '.' {\n        i += 1;\n        let first = i;\n        if d.num_digits == 0 {\n            for _ in 0..s.len + 1 {\n                if !(i < len && s[i] == '0') {\n                    break;\n                }\n                i += 1;\n            }\n        }\n        for _ in 0..s.len + 1 {\n");
        buf_str(out, c"            if !(i < len && s[i] - '0' < 10) {\n                break;\n            }\n            num_dec_add_digit(&d, s[i] - '0');\n            i += 1;\n        }\n        d.decimal_point = first - i;\n    }\n    if d.num_digits != 0 {\n        // (trailing zeros are no digits)\n        var zeros = 0;\n        var j = i;\n        for _ in 0..s.len + 1 {\n            if !(j > 0) {\n                break;\n            }\n            j -= 1;\n            let c = s[j];\n            if c == '0' {\n                zeros += 1;\n            } else if c != '.' {\n                break;\n            }\n        }\n        d.decimal_point += zeros;\n        d.num_digits -= zeros;\n        d.decimal_point += d.num_digits;\n        if d.num_digits > NUM_DEC_MAX_DIGITS {\n            d.truncated = true;\n            d.num_digits = NUM_DEC_MAX_DIGITS;\n        }\n    }\n    if i < len && (s[i] == 'e' || s[i] == 'E') {\n        i += 1;\n        var negative = false;\n        if i < len && (s[i] == '-' || s[i] == '+') {\n            negative = s[i] == '-';\n            i += 1;\n        }\n        var exp_num: i64 = 0;\n        for _ in 0..s.len + 1 {\n            if !(i < len && s[i] - '0' < 10) {\n                break;\n            }\n            if exp_num < 0x10000 {\n                exp_num = 10 * exp_num + (s[i] - '0') as i64;\n            }\n            i += 1;\n        }\n        d.decimal_point += if negative { -exp_num } else { exp_num };\n    }\n}\n\n// The shift that moves a decimal point of n toward 0 (Rust's get_shift).\nfn num_dec_shift(n: i64) -> i64 {\n    let powers = [0, 3, 6, 9, 13, 16, 19, 23, 26, 29, 33, 36, 39, 43, 46, 49, 53, 56, 59];\n    if n < 19 { powers[n] } else { 60 }\n}\n\n// s (without its sign) rounded to a float (Rust's parse_long_mantissa).\nfn num_slow_path(s: [u8], single: bool) -> NumBiasedFp {\n    let mbits: i64 = if single { 23 } else { 52 };\n    let min_exponent: i64 = if single { -127 } else { -1023 };\n");
        buf_str(out, c"    let inf_power: i64 = if single { 0xff } else { 0x7ff };\n    var d = NumDecimal { num_digits: 0, decimal_point: 0, truncated: false, digits: [0; 768] };\n    num_parse_decimal(s, &d);\n    if d.num_digits == 0 || d.decimal_point < -324 {\n        return NumBiasedFp { f: 0, e: 0 };\n    }\n    if d.decimal_point >= 310 {\n        return NumBiasedFp { f: 0, e: inf_power };\n    }\n    var exp2: i64 = 0;\n    // to (1/2, 1]\n    for _ in 0..1000 {\n        if !(d.decimal_point > 0) {\n            break;\n        }\n        let shift = num_dec_shift(d.decimal_point);\n        num_dec_right_shift(&d, shift);\n        if d.decimal_point < -NUM_DEC_POINT_RANGE {\n            return NumBiasedFp { f: 0, e: 0 };\n        }\n        exp2 += shift;\n    }\n    for _ in 0..1000 {\n        if !(d.decimal_point <= 0) {\n            break;\n        }\n        var shift = 0;\n        if d.decimal_point == 0 {\n            let first = d.digits[0];\n            if first >= 5 {\n                break;\n            }\n            shift = if first == 0 || first == 1 { 2 } else { 1 };\n        } else {\n            shift = num_dec_shift(-d.decimal_point);\n        }\n        num_dec_left_shift(&d, shift);\n        if d.decimal_point > NUM_DEC_POINT_RANGE {\n            return NumBiasedFp { f: 0, e: inf_power };\n        }\n        exp2 -= shift;\n    }\n    // [1/2, 1] to [1, 2]\n    exp2 -= 1;\n    for _ in 0..1000 {\n        if !(min_exponent + 1 > exp2) {\n            break;\n        }\n        var n = min_exponent + 1 - exp2;\n        if n > 60 {\n            n = 60;\n        }\n        num_dec_right_shift(&d, n);\n        exp2 += n;\n    }\n    if exp2 - min_exponent >= inf_power {\n        return NumBiasedFp { f: 0, e: inf_power };\n    }\n    num_dec_left_shift(&d, mbits + 1);\n    var mantissa = num_dec_round(&d);\n    if mantissa >= (1 << (mbits + 1) as u64) {\n        // (rounded up to the carry bit)\n        num_dec_right_shift(&d, 1);\n        exp2 += 1;\n");
        buf_str(out, c"        mantissa = num_dec_round(&d);\n        if exp2 - min_exponent >= inf_power {\n            return NumBiasedFp { f: 0, e: inf_power };\n        }\n    }\n    var power2 = exp2 - min_exponent;\n    if mantissa < (1 << mbits as u64) {\n        power2 -= 1;\n    }\n    mantissa &= (1 << mbits as u64) - 1;\n    NumBiasedFp { f: mantissa, e: power2 }\n}\n// ---- mod std::num::tables ----\npub mod tables {\n// std::num::tables (0.20): generated by tools/numtables/gen.tach (do not\n// edit): the tables of std's number conversion (std::num), computed\n// there with big integers and checked against their definitions.\n\n// ---- Numbers: powers of ten (0.20) ----\n\n// For K from POW10_MIN (-342) to 324: 10^K's first 128 bits, truncated,\n// floor(10^K * 2^(127 - floor(log2(10^K)))), as (high, low) at 2 * (K -\n// POW10_MIN). Schubfach adds one (num.tach: f64_shortest, f32_shortest);\n// Eisel and Lemire use them as they are, one more for K from -27 to -1\n// (lemire_power).\npub const POW10_MIN: i64 = -342;\n\npub static POW10_128: [u64; 1334] = [\n    0xeef453d6923bd65a, 0x113faa2906a13b3f,\n    0x9558b4661b6565f8, 0x4ac7ca59a424c507,\n    0xbaaee17fa23ebf76, 0x5d79bcf00d2df649,\n    0xe95a99df8ace6f53, 0xf4d82c2c107973dc,\n    0x91d8a02bb6c10594, 0x79071b9b8a4be869,\n    0xb64ec836a47146f9, 0x9748e2826cdee284,\n    0xe3e27a444d8d98b7, 0xfd1b1b2308169b25,\n    0x8e6d8c6ab0787f72, 0xfe30f0f5e50e20f7,\n    0xb208ef855c969f4f, 0xbdbd2d335e51a935,\n    0xde8b2b66b3bc4723, 0xad2c788035e61382,\n    0x8b16fb203055ac76, 0x4c3bcb5021afcc31,\n    0xaddcb9e83c6b1793, 0xdf4abe242a1bbf3d,\n    0xd953e8624b85dd78, 0xd71d6dad34a2af0d,\n    0x87d4713d6f33aa6b, 0x8672648c40e5ad68,\n    0xa9c98d8ccb009506, 0x680efdaf511f18c2,\n    0xd43bf0effdc0ba48, 0x0212bd1b2566def2,\n    0x84a57695fe98746d, 0x014bb630f7604b57,\n    0xa5ced43b7e3e9188, 0x419ea3bd35385e2d,\n    0xcf42894a5dce35ea, 0x52064cac828675b9,\n    0x818995ce7aa0e1b2, 0x7343efebd1940993,\n");
