// Generated by compiler/std/embed.sh from compiler/std/std.tach,
// iter.tach, io.tach, fmt.tach, convert.tach, clone.tach, alloc.tach
// and gpa.tach (do not edit): the standard library's source (0.5),
// read when a program names `std` (modules.tach).

use crate::base::buf_str;
use crate::front::stdalloc::std_alloc_tail;

pub fn std_source(out: i64) {
    unsafe {
        buf_str(out, c"// The standard library (0.5): the module `std`, built into the compiler\n");
        buf_str(out, c"// (compiler/std/embed.sh makes compiler/src/front/stdsrc.tach from this file\n");
        buf_str(out, c"// and the ones it appends: iter.tach, io.tach, fmt.tach, convert.tach,\n");
        buf_str(out, c"// clone.tach, alloc.tach, then Gpa's implementation: gpa.tach). A program\n");
        buf_str(out, c"// that names `std` gets it: `std::Vec<i64>`, `use std::{Buf, Vec};`.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// This file, the core: Option and Result, a growable vector, a byte\n");
        buf_str(out, c"// buffer, the operator traits, sorting and a hash map.\n");
        buf_str(out, c"// Failures (unwrapping None, an index out of bounds) print a message on\n");
        buf_str(out, c"// stderr and exit with 101, like the language's own checks.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Allocation (0.16): Vec, Buf and HashMap take their memory from an\n");
        buf_str(out, c"// allocator, a type parameter (`Vec<T, A: Allocator = Gpa>`, alloc.tach),\n");
        buf_str(out, c"// every growth and free through it.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Unsafe code (0.9): the safe functions here have no undefined behaviour\n");
        buf_str(out, c"// as long as a Vec's and a Buf's fields are changed by their methods only\n");
        buf_str(out, c"// (0.16: #[sealed], checked from 0.16's T2), and a slice from `as_slice` (or a\n");
        buf_str(out, c"// HashMap's `get_mut`, `get_or_insert`) is not used after the Vec grows\n");
        buf_str(out, c"// (the map gets a new key) or is freed. The functions taking C strings\n");
        buf_str(out, c"// are `unsafe fn`: the string must end with a NUL.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.16) Their effects declared: allocation, I/O, none.\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[effects(alloc(extern))]\n");
        buf_str(out, c"    fn malloc(size: u64) -> *u8;\n");
        buf_str(out, c"    #[effects(alloc(extern))]\n");
        buf_str(out, c"    fn realloc(p: *u8, size: u64) -> *u8;\n");
        buf_str(out, c"    #[effects(alloc(extern))]\n");
        buf_str(out, c"    fn free(p: *u8);\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn write(fd: i32, data: *u8, count: u64) -> i64;\n");
        buf_str(out, c"    #[effects(io)]\n");
        buf_str(out, c"    fn read(fd: i32, data: *u8, count: u64) -> i64;\n");
        buf_str(out, c"    #[effects(io, diverge)]\n");
        buf_str(out, c"    fn exit(code: i32) -> !;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn memcpy(dst: *u8, src: *u8, n: u64) -> *u8;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn strlen(s: *u8) -> u64;\n");
        buf_str(out, c"    // (panic's: its message and its exit are the effect panic)\n");
        buf_str(out, c"    #[link_name = \"write\"]\n");
        buf_str(out, c"    #[effects(panic)]\n");
        buf_str(out, c"    fn panic_write(fd: i32, data: *u8, count: u64) -> i64;\n");
        buf_str(out, c"    #[link_name = \"exit\"]\n");
        buf_str(out, c"    #[effects(panic)]\n");
        buf_str(out, c"    fn panic_exit(code: i32) -> !;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Prints `message` (a C string) on stderr and exits with 101.\n");
        buf_str(out, c"pub unsafe fn panic(message: *u8) -> ! {\n");
        buf_str(out, c"    panic_write(2, message, strlen(message));\n");
        buf_str(out, c"    panic_write(2, c\"\\n\", 1);\n");
        buf_str(out, c"    panic_exit(101)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Option and Result ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub enum Option<T> { None, Some(T) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Option<T> {\n");
        buf_str(out, c"    pub fn is_some(self: *Option<T>) -> bool {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            Option::Some(_) => true,\n");
        buf_str(out, c"            Option::None => false,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_none(self: *Option<T>) -> bool {\n");
        buf_str(out, c"        !self.is_some()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap(self: Option<T>) -> T {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => x,\n");
        buf_str(out, c"            Option::None => unsafe { panic(c\"called unwrap on None\") },\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap_or(self: Option<T>, other: T) -> T {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => x,\n");
        buf_str(out, c"            Option::None => other,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub enum Result<T, E> { Ok(T), Err(E) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, E> Result<T, E> {\n");
        buf_str(out, c"    pub fn is_ok(self: *Result<T, E>) -> bool {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            Result::Ok(_) => true,\n");
        buf_str(out, c"            Result::Err(_) => false,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_err(self: *Result<T, E>) -> bool {\n");
        buf_str(out, c"        !self.is_ok()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap(self: Result<T, E>) -> T {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => x,\n");
        buf_str(out, c"            Result::Err(_) => unsafe { panic(c\"called unwrap on Err\") },\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap_or(self: Result<T, E>, other: T) -> T {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => x,\n");
        buf_str(out, c"            Result::Err(_) => other,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn ok(self: Result<T, E>) -> Option<T> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => Option::Some(x),\n");
        buf_str(out, c"            Result::Err(_) => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Vec ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A growable vector of T, its memory from allocator A (0.16; Gpa, C's\n");
        buf_str(out, c"// malloc, by default); `free` gives its memory back.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct Vec<T, A: Allocator = Gpa> { ptr: *T, len: i64, cap: i64, alloc: A }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // An empty Vec on allocator a (0.16).\n");
        buf_str(out, c"    pub fn new_in(a: A) -> Vec<T, A> {\n");
        buf_str(out, c"        Vec { ptr: 0 as *T, len: 0, cap: 0, alloc: a }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An empty Vec on allocator a with room for cap elements (0.16).\n");
        buf_str(out, c"    pub fn with_capacity_in(cap: i64, a: A) -> Vec<T, A> {\n");
        buf_str(out, c"        let mut v: Vec<T, A> = Vec::new_in(a);\n");
        buf_str(out, c"        v.reserve(cap);\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // (0.15) n copies of x on allocator a: Rust's `vec![x; n]`. x is copied\n");
        buf_str(out, c"    // as it is, not cloned: n Vecs from one non-empty Vec would share its\n");
        buf_str(out, c"    // elements (push `Vec::new_in(a)` n times instead).\n");
        buf_str(out, c"    pub fn filled_in(n: i64, x: T, a: A) -> Vec<T, A> {\n");
        buf_str(out, c"        let mut v: Vec<T, A> = Vec::with_capacity_in(n, a);\n");
        buf_str(out, c"        for _ in 0..n {\n");
        buf_str(out, c"            v.push(x);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn len(self: *Vec<T, A>) -> i64 {\n");
        buf_str(out, c"        self.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_empty(self: *Vec<T, A>) -> bool {\n");
        buf_str(out, c"        self.len == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Room for `extra` more elements.\n");
        buf_str(out, c"    pub fn reserve(self: *Vec<T, A>, extra: i64) {\n");
        buf_str(out, c"        if extra > self.cap - self.len && !self.reserve_more(extra) {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Grows to room for `extra` (more than it has) more elements: twice the\n");
        buf_str(out, c"    // capacity, or more when needed; false when out of memory.\n");
        buf_str(out, c"    #[inline(never)]\n");
        buf_str(out, c"    fn reserve_more(self: *Vec<T, A>, extra: i64) -> bool {\n");
        buf_str(out, c"        if extra > ALLOC_LIMIT - self.len {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let cap = grown_cap(self.cap, self.len + extra);\n");
        buf_str(out, c"        let bytes = alloc_bytes(cap, size_of(T));\n");
        buf_str(out, c"        if bytes < 0 {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let p = unsafe {\n");
        buf_str(out, c"            self.alloc.try_resize(self.ptr as *u8, self.cap * size_of(T), bytes, align_of(T))\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        if p == 0 as *u8 {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.ptr = p as *T;\n");
        buf_str(out, c"        self.cap = cap;\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Appends the elements of s, which may be a view of this Vec: when it\n");
        buf_str(out, c"    // grows, the elements are copied to the new memory before the old is\n");
        buf_str(out, c"    // freed.\n");
        buf_str(out, c"    pub fn extend_from_slice(self: *Vec<T, A>, s: [T]) {\n");
        buf_str(out, c"        let n = s.len;\n");
        buf_str(out, c"        let mut old = 0 as *T;\n");
        buf_str(out, c"        let mut old_cap = 0;\n");
        buf_str(out, c"        if n > self.cap - self.len {\n");
        buf_str(out, c"            let mut cap = -1;\n");
        buf_str(out, c"            if n <= ALLOC_LIMIT - self.len {\n");
        buf_str(out, c"                cap = grown_cap(self.cap, self.len + n);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let bytes = alloc_bytes(cap, size_of(T));\n");
        buf_str(out, c"            if bytes < 0 {\n");
        buf_str(out, c"                out_of_memory();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            old = self.ptr;\n");
        buf_str(out, c"            old_cap = self.cap;\n");
        buf_str(out, c"            let p = self.alloc.try_alloc(bytes, align_of(T));\n");
        buf_str(out, c"            if p == 0 as *u8 {\n");
        buf_str(out, c"                out_of_memory();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                self.ptr = p as *T;\n");
        buf_str(out, c"                for i in 0..self.len {\n");
        buf_str(out, c"                    self.ptr[i] = old[i];\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.cap = cap;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for i in 0..n {\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                self.ptr[self.len + i] = s[i];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len += n;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.alloc.free(old as *u8, old_cap * size_of(T), align_of(T));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn push(self: *Vec<T, A>, x: T) {\n");
        buf_str(out, c"        if self.len == self.cap && !self.reserve_more(1) {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.ptr[self.len] = x;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn pop(self: *Vec<T, A>) -> Option<T> {\n");
        buf_str(out, c"        if self.len == 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len -= 1;\n");
        buf_str(out, c"        Option::Some(unsafe { self.ptr[self.len] })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Element i (checked: out of bounds exits with 101).\n");
        buf_str(out, c"    pub fn get(self: *Vec<T, A>, i: i64) -> T {\n");
        buf_str(out, c"        self.as_slice()[i]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn set(self: *Vec<T, A>, i: i64, x: T) {\n");
        buf_str(out, c"        self.as_slice()[i] = x;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The last element, if there is one (the Vec keeps it; `pop` takes it).\n");
        buf_str(out, c"    pub fn last(self: *Vec<T, A>) -> Option<T> {\n");
        buf_str(out, c"        if self.len == 0 { Option::None } else { Option::Some(self.get(self.len - 1)) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Exchanges elements i and j (checked).\n");
        buf_str(out, c"    pub fn swap(self: *Vec<T, A>, i: i64, j: i64) {\n");
        buf_str(out, c"        let s = self.as_slice();\n");
        buf_str(out, c"        let t = s[i];\n");
        buf_str(out, c"        s[i] = s[j];\n");
        buf_str(out, c"        s[j] = t;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Puts x at index i, 0 to len (checked), moving the elements from i\n");
        buf_str(out, c"    // on up by one.\n");
        buf_str(out, c"    pub fn insert(self: *Vec<T, A>, i: i64, x: T) {\n");
        buf_str(out, c"        if i < 0 || i > self.len {\n");
        buf_str(out, c"            unsafe { panic(c\"Vec::insert: index out of bounds\") }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.push(x);\n");
        buf_str(out, c"        let s = self.as_slice();\n");
        buf_str(out, c"        let last = s.len - 1;\n");
        buf_str(out, c"        for d in 0..last - i {\n");
        buf_str(out, c"            let k = last - d;\n");
        buf_str(out, c"            s[k] = s[k - 1];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        s[i] = x;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Takes element i out (checked) and returns it, moving the elements\n");
        buf_str(out, c"    // after it down by one.\n");
        buf_str(out, c"    pub fn remove(self: *Vec<T, A>, i: i64) -> T {\n");
        buf_str(out, c"        let s = self.as_slice();\n");
        buf_str(out, c"        let x = s[i];\n");
        buf_str(out, c"        for k in i..s.len - 1 {\n");
        buf_str(out, c"            s[k] = s[k + 1];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len -= 1;\n");
        buf_str(out, c"        x\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Keeps the first n elements (all of them when there are fewer).\n");
        buf_str(out, c"    pub fn truncate(self: *Vec<T, A>, n: i64) {\n");
        buf_str(out, c"        if n >= 0 && n < self.len {\n");
        buf_str(out, c"            self.len = n;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn as_slice(self: *Vec<T, A>) -> [T] {\n");
        buf_str(out, c"        unsafe { self.ptr[0..self.len] }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn clear(self: *Vec<T, A>) {\n");
        buf_str(out, c"        self.len = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn free(self: *Vec<T, A>) {\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.alloc.free(self.ptr as *u8, self.cap * size_of(T), align_of(T));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.ptr = 0 as *T;\n");
        buf_str(out, c"        self.len = 0;\n");
        buf_str(out, c"        self.cap = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.16) The ambient constructors of 0.15, errors outside std: allocation\n");
        buf_str(out, c"// is explicit (front/ambient.tach; they go with --ambient-gpa).\n");
        buf_str(out, c"impl<T, A: Allocator + Ambient> Vec<T, A> {\n");
        buf_str(out, c"    #[ambient(\"Vec::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> Vec<T, A> {\n");
        buf_str(out, c"        Vec { ptr: 0 as *T, len: 0, cap: 0, alloc: A::ambient() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"Vec::with_capacity_in(cap, gpa)\")]\n");
        buf_str(out, c"    pub fn with_capacity(cap: i64) -> Vec<T, A> {\n");
        buf_str(out, c"        Vec::with_capacity_in(cap, A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[ambient(\"Vec::filled_in(n, x, gpa)\")]\n");
        buf_str(out, c"    pub fn filled(n: i64, x: T) -> Vec<T, A> {\n");
        buf_str(out, c"        Vec::filled_in(n, x, A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Vec's room and allocator (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // The elements it has room for (0.16).\n");
        buf_str(out, c"    pub fn capacity(self: *Vec<T, A>) -> i64 {\n");
        buf_str(out, c"        self.cap\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its allocator (0.16): a copy of the handle.\n");
        buf_str(out, c"    pub fn allocator(self: *Vec<T, A>) -> A {\n");
        buf_str(out, c"        self.alloc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Room for `extra` more elements, or Err when out of memory, the Vec\n");
        buf_str(out, c"    // as it was (0.16).\n");
        buf_str(out, c"    pub fn try_reserve(self: *Vec<T, A>, extra: i64) -> Result<(), AllocError> {\n");
        buf_str(out, c"        if extra > self.cap - self.len && !self.reserve_more(extra) {\n");
        buf_str(out, c"            return Result::Err(AllocError::OutOfMemory);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Result::Ok(())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // push, or Err when out of memory, the Vec as it was (0.16).\n");
        buf_str(out, c"    pub fn try_push(self: *Vec<T, A>, x: T) -> Result<(), AllocError> {\n");
        buf_str(out, c"        if self.len == self.cap && !self.reserve_more(1) {\n");
        buf_str(out, c"            return Result::Err(AllocError::OutOfMemory);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.ptr[self.len] = x;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len += 1;\n");
        buf_str(out, c"        Result::Ok(())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Buf ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A growable buffer of bytes, for building text (0.16: on allocator A).\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct Buf<A: Allocator = Gpa> { bytes: Vec<u8, A> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Buf<A> {\n");
        buf_str(out, c"    // An empty Buf on allocator a (0.16).\n");
        buf_str(out, c"    pub fn new_in(a: A) -> Buf<A> {\n");
        buf_str(out, c"        Buf { bytes: Vec::new_in(a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn len(self: *Buf<A>) -> i64 {\n");
        buf_str(out, c"        self.bytes.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn push(self: *Buf<A>, b: u8) {\n");
        buf_str(out, c"        self.bytes.push(b);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Appends s, which may be a view of this Buf.\n");
        buf_str(out, c"    pub fn push_str(self: *Buf<A>, s: [u8]) {\n");
        buf_str(out, c"        self.bytes.extend_from_slice(s);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A C string (up to its NUL).\n");
        buf_str(out, c"    pub unsafe fn push_cstr(self: *Buf<A>, s: *u8) {\n");
        buf_str(out, c"        self.bytes.extend_from_slice(s[0..strlen(s) as i64]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The decimal digits of v.\n");
        buf_str(out, c"    pub fn push_int(self: *Buf<A>, v: i64) {\n");
        buf_str(out, c"        let negative = v < 0;\n");
        buf_str(out, c"        let u = if negative { (-(v + 1)) as u64 + 1 } else { v as u64 };\n");
        buf_str(out, c"        let n = if negative { decimal_len(u) + 1 } else { decimal_len(u) };\n");
        buf_str(out, c"        if n > self.bytes.cap - self.bytes.len {\n");
        buf_str(out, c"            self.bytes.reserve(n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            put_decimal(&self.bytes.ptr[self.bytes.len], n, u, negative);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.bytes.len += n;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn as_slice(self: *Buf<A>) -> [u8] {\n");
        buf_str(out, c"        self.bytes.as_slice()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn clear(self: *Buf<A>) {\n");
        buf_str(out, c"        self.bytes.clear();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn free(self: *Buf<A>) {\n");
        buf_str(out, c"        self.bytes.free();\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator + Ambient> Buf<A> {\n");
        buf_str(out, c"    #[ambient(\"Buf::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> Buf<A> {\n");
        buf_str(out, c"        Buf { bytes: Vec::new_in(A::ambient()) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The number of decimal digits of u.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn decimal_len(u: u64) -> i64 {\n");
        buf_str(out, c"    let mut n = 1;\n");
        buf_str(out, c"    let mut ten: u64 = 10;\n");
        buf_str(out, c"    for _ in 1..20 {\n");
        buf_str(out, c"        if u < ten {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        n += 1;\n");
        buf_str(out, c"        ten *= 10;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    n\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// u's decimal digits in p[0..n] (n: decimal_len(u), one more when\n");
        buf_str(out, c"// negative: after a '-'), two at a time. Unsafe: p has n bytes.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn put_decimal(p: *u8, n: i64, u: u64, negative: bool) {\n");
        buf_str(out, c"    let pairs = \"00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899\";\n");
        buf_str(out, c"    let mut x = u;\n");
        buf_str(out, c"    let mut i = n;\n");
        buf_str(out, c"    for _ in 0..10 {\n");
        buf_str(out, c"        if x < 100 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let q = x / 100;\n");
        buf_str(out, c"        let r = (x - q * 100) as i64 * 2;\n");
        buf_str(out, c"        i -= 2;\n");
        buf_str(out, c"        p[i] = pairs.ptr[r];\n");
        buf_str(out, c"        p[i + 1] = pairs.ptr[r + 1];\n");
        buf_str(out, c"        x = q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if x >= 10 {\n");
        buf_str(out, c"        let r = x as i64 * 2;\n");
        buf_str(out, c"        p[i - 2] = pairs.ptr[r];\n");
        buf_str(out, c"        p[i - 1] = pairs.ptr[r + 1];\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        p[i - 1] = '0' + x as u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if negative {\n");
        buf_str(out, c"        p[0] = '-';\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Buf's room and allocator (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Buf<A> {\n");
        buf_str(out, c"    // An empty Buf on allocator a with room for cap bytes (0.16).\n");
        buf_str(out, c"    pub fn with_capacity_in(cap: i64, a: A) -> Buf<A> {\n");
        buf_str(out, c"        Buf { bytes: Vec::with_capacity_in(cap, a) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The bytes it has room for (0.16).\n");
        buf_str(out, c"    pub fn capacity(self: *Buf<A>) -> i64 {\n");
        buf_str(out, c"        self.bytes.cap\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Room for `extra` more bytes (0.16).\n");
        buf_str(out, c"    pub fn reserve(self: *Buf<A>, extra: i64) {\n");
        buf_str(out, c"        self.bytes.reserve(extra);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its allocator (0.16): a copy of the handle.\n");
        buf_str(out, c"    pub fn allocator(self: *Buf<A>) -> A {\n");
        buf_str(out, c"        self.bytes.alloc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Traits (0.9) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The operators: `a + b` on a type implementing Add is `a.add(b)`, and so\n");
        buf_str(out, c"// on; `-a` is `a.neg()`; `a == b` is `a.eq(&b)` (an impl wins over the\n");
        buf_str(out, c"// structural ==); `a < b` is `a.cmp(&b) < 0`. Numbers implement them all\n");
        buf_str(out, c"// without impl blocks, every type with == implements Eq, and numbers,\n");
        buf_str(out, c"// pointers and fieldless enums Ord.\n");
        buf_str(out, c"pub trait Add { fn add(self: Self, other: Self) -> Self; }\n");
        buf_str(out, c"pub trait Sub { fn sub(self: Self, other: Self) -> Self; }\n");
        buf_str(out, c"pub trait Mul { fn mul(self: Self, other: Self) -> Self; }\n");
        buf_str(out, c"pub trait Div { fn div(self: Self, other: Self) -> Self; }\n");
        buf_str(out, c"pub trait Neg { fn neg(self: Self) -> Self; }\n");
        buf_str(out, c"pub trait Eq { fn eq(self: *Self, other: *Self) -> bool; }\n");
        buf_str(out, c"// Negative, zero or positive: self before, like or after other.\n");
        buf_str(out, c"pub trait Ord { fn cmp(self: *Self, other: *Self) -> i64; }\n");
        buf_str(out, c"pub trait Hash { fn hash(self: *Self) -> u64; }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A 64-bit mix of x (splitmix64's finalizer): the hash of the integers.\n");
        buf_str(out, c"pub fn hash_u64(x: u64) -> u64 {\n");
        buf_str(out, c"    let mut z = x + 0x9e3779b97f4a7c15u64;\n");
        buf_str(out, c"    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9u64;\n");
        buf_str(out, c"    z = (z ^ (z >> 27)) * 0x94d049bb133111ebu64;\n");
        buf_str(out, c"    z ^ (z >> 31)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for i8 {\n");
        buf_str(out, c"    fn eq(self: *i8, other: *i8) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for i8 {\n");
        buf_str(out, c"    fn cmp(self: *i8, other: *i8) -> i64 {\n");
        buf_str(out, c"        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for i8 {\n");
        buf_str(out, c"    fn hash(self: *i8) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for i16 {\n");
        buf_str(out, c"    fn eq(self: *i16, other: *i16) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for i16 {\n");
        buf_str(out, c"    fn cmp(self: *i16, other: *i16) -> i64 {\n");
        buf_str(out, c"        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for i16 {\n");
        buf_str(out, c"    fn hash(self: *i16) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for i32 {\n");
        buf_str(out, c"    fn eq(self: *i32, other: *i32) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for i32 {\n");
        buf_str(out, c"    fn cmp(self: *i32, other: *i32) -> i64 {\n");
        buf_str(out, c"        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for i32 {\n");
        buf_str(out, c"    fn hash(self: *i32) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for i64 {\n");
        buf_str(out, c"    fn eq(self: *i64, other: *i64) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for i64 {\n");
        buf_str(out, c"    fn cmp(self: *i64, other: *i64) -> i64 {\n");
        buf_str(out, c"        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for i64 {\n");
        buf_str(out, c"    fn hash(self: *i64) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for u8 {\n");
        buf_str(out, c"    fn eq(self: *u8, other: *u8) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for u8 {\n");
        buf_str(out, c"    fn cmp(self: *u8, other: *u8) -> i64 {\n");
        buf_str(out, c"        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for u8 {\n");
        buf_str(out, c"    fn hash(self: *u8) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for u16 {\n");
        buf_str(out, c"    fn eq(self: *u16, other: *u16) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for u16 {\n");
        buf_str(out, c"    fn cmp(self: *u16, other: *u16) -> i64 {\n");
        buf_str(out, c"        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for u16 {\n");
        buf_str(out, c"    fn hash(self: *u16) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for u32 {\n");
        buf_str(out, c"    fn eq(self: *u32, other: *u32) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for u32 {\n");
        buf_str(out, c"    fn cmp(self: *u32, other: *u32) -> i64 {\n");
        buf_str(out, c"        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for u32 {\n");
        buf_str(out, c"    fn hash(self: *u32) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for u64 {\n");
        buf_str(out, c"    fn eq(self: *u64, other: *u64) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for u64 {\n");
        buf_str(out, c"    fn cmp(self: *u64, other: *u64) -> i64 {\n");
        buf_str(out, c"        if *self < *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for u64 {\n");
        buf_str(out, c"    fn hash(self: *u64) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Eq for bool {\n");
        buf_str(out, c"    fn eq(self: *bool, other: *bool) -> bool { *self == *other }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for bool {\n");
        buf_str(out, c"    fn cmp(self: *bool, other: *bool) -> i64 {\n");
        buf_str(out, c"        if !*self && *other { -1 } else if *self == *other { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for bool {\n");
        buf_str(out, c"    fn hash(self: *bool) -> u64 { hash_u64(*self as u64) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Byte strings: compared by bytes, ordered lexicographically, hashed with\n");
        buf_str(out, c"// FNV-1a.\n");
        buf_str(out, c"impl Eq for [u8] {\n");
        buf_str(out, c"    fn eq(self: *[u8], other: *[u8]) -> bool {\n");
        buf_str(out, c"        let a = *self;\n");
        buf_str(out, c"        let b = *other;\n");
        buf_str(out, c"        if a.len != b.len {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for i in 0..a.len {\n");
        buf_str(out, c"            if a[i] != b[i] {\n");
        buf_str(out, c"                return false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ord for [u8] {\n");
        buf_str(out, c"    fn cmp(self: *[u8], other: *[u8]) -> i64 {\n");
        buf_str(out, c"        let a = *self;\n");
        buf_str(out, c"        let b = *other;\n");
        buf_str(out, c"        let n = if a.len < b.len { a.len } else { b.len };\n");
        buf_str(out, c"        for i in 0..n {\n");
        buf_str(out, c"            if a[i] != b[i] {\n");
        buf_str(out, c"                return if a[i] < b[i] { -1 } else { 1 };\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if a.len < b.len { -1 } else if a.len == b.len { 0 } else { 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Hash for [u8] {\n");
        buf_str(out, c"    fn hash(self: *[u8]) -> u64 {\n");
        buf_str(out, c"        let mut h = 14695981039346656037u64;\n");
        buf_str(out, c"        for b in *self {\n");
        buf_str(out, c"            h = (h ^ b as u64) * 1099511628211u64;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        h\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place, smallest first; not stable (equal elements may change\n");
        buf_str(out, c"// order). An introsort: quicksort around the median of three, insertion\n");
        buf_str(out, c"// sort for short runs, heapsort where the quicksort goes too deep, so\n");
        buf_str(out, c"// O(n log n) comparisons at worst. A `cmp` that is not a total order\n");
        buf_str(out, c"// leaves s in some order, never out of bounds. (0.16: its loops are\n");
        buf_str(out, c"// counted, and the ranges left to sort are on a stack, not recursion: it\n");
        buf_str(out, c"// does not have the effect diverge.)\n");
        buf_str(out, c"pub fn sort<T: Ord>(s: [T]) {\n");
        buf_str(out, c"    let mut depth = 0;\n");
        buf_str(out, c"    for k in 0..64 {\n");
        buf_str(out, c"        if (s.len >> k) <= 1 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        depth += 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    quicksort::<T>(s, 0, s.len, depth);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Short runs are sorted by insertion.\n");
        buf_str(out, c"const SORT_SMALL: i64 = 24;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s[lo..hi]; below `depth` more partitions, by heapsort. Each\n");
        buf_str(out, c"// partition puts its pivot in place, sorts the shorter side next and\n");
        buf_str(out, c"// keeps the longer for later (at most 64 kept: each is at least twice as\n");
        buf_str(out, c"// long as the one sorted next).\n");
        buf_str(out, c"// (not inlined into sort's caller: its loops keep their registers)\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn quicksort<T: Ord>(s: [T], lo: i64, hi: i64, depth: i64) {\n");
        buf_str(out, c"    let mut lo = lo;\n");
        buf_str(out, c"    let mut hi = hi;\n");
        buf_str(out, c"    let mut depth = depth;\n");
        buf_str(out, c"    let mut kept_lo: [i64; 64] = [0; 64];\n");
        buf_str(out, c"    let mut kept_hi: [i64; 64] = [0; 64];\n");
        buf_str(out, c"    let mut kept_depth: [i64; 64] = [0; 64];\n");
        buf_str(out, c"    let mut kept = 0;\n");
        buf_str(out, c"    // (each round places a pivot or finishes a range: 2n + 1 at most)\n");
        buf_str(out, c"    for _ in 0..2 * (hi - lo) + 1 {\n");
        buf_str(out, c"        if hi - lo <= SORT_SMALL || depth == 0 {\n");
        buf_str(out, c"            if hi - lo <= SORT_SMALL {\n");
        buf_str(out, c"                insertion_sort::<T>(s, lo, hi);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                heapsort::<T>(s[lo..hi]);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if kept == 0 {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            kept -= 1;\n");
        buf_str(out, c"            lo = kept_lo[kept];\n");
        buf_str(out, c"            hi = kept_hi[kept];\n");
        buf_str(out, c"            depth = kept_depth[kept];\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        depth -= 1;\n");
        buf_str(out, c"        // The median of the first, middle and last elements, at lo.\n");
        buf_str(out, c"        let mid = lo + (hi - lo) / 2;\n");
        buf_str(out, c"        if s[mid] < s[lo] {\n");
        buf_str(out, c"            swap::<T>(s, mid, lo);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if s[hi - 1] < s[mid] {\n");
        buf_str(out, c"            swap::<T>(s, hi - 1, mid);\n");
        buf_str(out, c"            if s[mid] < s[lo] {\n");
        buf_str(out, c"                swap::<T>(s, mid, lo);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        swap::<T>(s, lo, mid);\n");
        buf_str(out, c"        // Hoare's partition: s[lo..p] <= pivot <= s[p + 1..hi]. Equal\n");
        buf_str(out, c"        // elements stop both scans, so many equal keys split evenly.\n");
        buf_str(out, c"        let pivot = s[lo];\n");
        buf_str(out, c"        let mut i = lo;\n");
        buf_str(out, c"        let mut j = hi;\n");
        buf_str(out, c"        // (the scans read s unchecked: i < hi and lo < j <= hi - 1 by their\n");
        buf_str(out, c"        // counts, and hi <= s.len)\n");
        buf_str(out, c"        for _ in lo..hi {\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"            for _ in i..hi {\n");
        buf_str(out, c"                if !(unsafe { s.ptr[i] } < pivot) {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                i += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            j -= 1;\n");
        buf_str(out, c"            for _ in lo..j {\n");
        buf_str(out, c"                if !(pivot < unsafe { s.ptr[j] }) {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                j -= 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if i >= j {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            swap::<T>(s, i, j);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        swap::<T>(s, lo, j);\n");
        buf_str(out, c"        // The shorter side next, the longer kept.\n");
        buf_str(out, c"        if kept == 64 {\n");
        buf_str(out, c"            // (not reached: see above)\n");
        buf_str(out, c"            heapsort::<T>(s[lo..hi]);\n");
        buf_str(out, c"            hi = lo;\n");
        buf_str(out, c"            continue;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        kept_depth[kept] = depth;\n");
        buf_str(out, c"        if j - lo < hi - j - 1 {\n");
        buf_str(out, c"            kept_lo[kept] = j + 1;\n");
        buf_str(out, c"            kept_hi[kept] = hi;\n");
        buf_str(out, c"            hi = j;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            kept_lo[kept] = lo;\n");
        buf_str(out, c"            kept_hi[kept] = j;\n");
        buf_str(out, c"            lo = j + 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        kept += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn insertion_sort<T: Ord>(s: [T], lo: i64, hi: i64) {\n");
        buf_str(out, c"    for i in lo + 1..hi {\n");
        buf_str(out, c"        let x = s[i];\n");
        buf_str(out, c"        let mut at = lo;\n");
        buf_str(out, c"        for d in 0..i - lo {\n");
        buf_str(out, c"            let j = i - d;\n");
        buf_str(out, c"            if !(x < s[j - 1]) {\n");
        buf_str(out, c"                at = j;\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            s[j] = s[j - 1];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        s[at] = x;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn swap<T>(s: [T], i: i64, j: i64) {\n");
        buf_str(out, c"    let t = s[i];\n");
        buf_str(out, c"    s[i] = s[j];\n");
        buf_str(out, c"    s[j] = t;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn heapsort<T: Ord>(s: [T]) {\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    for k in 0..n / 2 {\n");
        buf_str(out, c"        sift_down::<T>(s, n / 2 - 1 - k, n);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for k in 1..n {\n");
        buf_str(out, c"        let end = n - k;\n");
        buf_str(out, c"        let top = s[0];\n");
        buf_str(out, c"        s[0] = s[end];\n");
        buf_str(out, c"        s[end] = top;\n");
        buf_str(out, c"        sift_down::<T>(s, 0, end);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (the root's index at least doubles each round: 64 at most)\n");
        buf_str(out, c"fn sift_down<T: Ord>(s: [T], start: i64, end: i64) {\n");
        buf_str(out, c"    let mut root = start;\n");
        buf_str(out, c"    for _ in 0..64 {\n");
        buf_str(out, c"        let mut child = 2 * root + 1;\n");
        buf_str(out, c"        if child >= end {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if child + 1 < end && s[child] < s[child + 1] {\n");
        buf_str(out, c"            child += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if !(s[root] < s[child]) {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let t = s[root];\n");
        buf_str(out, c"        s[root] = s[child];\n");
        buf_str(out, c"        s[child] = t;\n");
        buf_str(out, c"        root = child;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Stable sort (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place, smallest first, keeping equal elements in the order\n");
        buf_str(out, c"// they had (0.15), with a buffer from allocator a (0.16):\n");
        buf_str(out, c"// `sort_stable_by_in` with `|a, b| a.cmp(b)`.\n");
        buf_str(out, c"pub fn sort_stable_in<T: Ord, A: Allocator>(s: [T], a: A) {\n");
        buf_str(out, c"    sort_stable_by_in(s, |x: *T, y: *T| x.cmp(y), a);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"sort_stable_in(s, gpa)\")]\n");
        buf_str(out, c"pub fn sort_stable<T: Ord>(s: [T]) {\n");
        buf_str(out, c"    sort_stable_in(s, Gpa::ambient());\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"sort_stable_by_in(s, f, gpa)\")]\n");
        buf_str(out, c"pub fn sort_stable_by<T, F: FnMut(*T, *T) -> i64>(s: [T], f: F) {\n");
        buf_str(out, c"    sort_stable_by_in(s, f, Gpa::ambient());\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The runs sort_stable_by sorts by insertion before merging them.\n");
        buf_str(out, c"const STABLE_RUN: i64 = 16;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place by f (as sort_by: f(a, b) negative when *a goes before\n");
        buf_str(out, c"// *b), keeping equal elements in the order they had (0.15). A merge sort:\n");
        buf_str(out, c"// runs of 16 sorted by insertion, then merged in pairs through a buffer of\n");
        buf_str(out, c"// s.len elements from allocator a (0.16), so O(n log n) comparisons. A\n");
        buf_str(out, c"// `f` that is not a total order leaves s in some order, never out of\n");
        buf_str(out, c"// bounds.\n");
        buf_str(out, c"pub fn sort_stable_by_in<T, F: FnMut(*T, *T) -> i64, A: Allocator>(s: [T], f: F, a: A) {\n");
        buf_str(out, c"    let mut g = f;\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    for r in 0..(n + STABLE_RUN - 1) / STABLE_RUN {\n");
        buf_str(out, c"        let lo = r * STABLE_RUN;\n");
        buf_str(out, c"        let hi = if lo + STABLE_RUN < n { lo + STABLE_RUN } else { n };\n");
        buf_str(out, c"        for i in lo + 1..hi {\n");
        buf_str(out, c"            let x = s[i];\n");
        buf_str(out, c"            let mut j = i;\n");
        buf_str(out, c"            for _ in lo..i {\n");
        buf_str(out, c"                if !(g(&x, &s[j - 1]) < 0) {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                s[j] = s[j - 1];\n");
        buf_str(out, c"                j -= 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            s[j] = x;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if n <= STABLE_RUN {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut buf: Vec<T, A> = Vec::with_capacity_in(n, a);\n");
        buf_str(out, c"    // (every element of `to` is written before it is read)\n");
        buf_str(out, c"    let mut from = s;\n");
        buf_str(out, c"    let mut to = unsafe { buf.ptr[0..n] };\n");
        buf_str(out, c"    let mut width = STABLE_RUN;\n");
        buf_str(out, c"    // (the width doubles each round: 62 at most)\n");
        buf_str(out, c"    for _ in 0..62 {\n");
        buf_str(out, c"        if width >= n {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for p in 0..(n + 2 * width - 1) / (2 * width) {\n");
        buf_str(out, c"            let lo = p * 2 * width;\n");
        buf_str(out, c"            let mid = if lo + width < n { lo + width } else { n };\n");
        buf_str(out, c"            let hi = if mid + width < n { mid + width } else { n };\n");
        buf_str(out, c"            let mut i = lo;\n");
        buf_str(out, c"            let mut j = mid;\n");
        buf_str(out, c"            let mut k = lo;\n");
        buf_str(out, c"            for _ in lo..hi {\n");
        buf_str(out, c"                if i >= mid || j >= hi {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                // (the left run's element first when they are equal)\n");
        buf_str(out, c"                if g(&from[j], &from[i]) < 0 {\n");
        buf_str(out, c"                    to[k] = from[j];\n");
        buf_str(out, c"                    j += 1;\n");
        buf_str(out, c"                } else {\n");
        buf_str(out, c"                    to[k] = from[i];\n");
        buf_str(out, c"                    i += 1;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                k += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for ii in i..mid {\n");
        buf_str(out, c"                to[k] = from[ii];\n");
        buf_str(out, c"                k += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for jj in j..hi {\n");
        buf_str(out, c"                to[k] = from[jj];\n");
        buf_str(out, c"                k += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let t = from;\n");
        buf_str(out, c"        from = to;\n");
        buf_str(out, c"        to = t;\n");
        buf_str(out, c"        width *= 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if from.ptr != s.ptr {\n");
        buf_str(out, c"        for i in 0..n {\n");
        buf_str(out, c"            s[i] = from[i];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    buf.free();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- HashMap ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A hash table (open addressing, linear probing) from K to V. Slots are\n");
        buf_str(out, c"// numbered 0..slots(); `key_at(i)` and `value_at(i)` give an occupied\n");
        buf_str(out, c"// slot's entry (None for a free one), which is how the map is iterated.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct HashMap<K: Hash + Eq, V, A: Allocator = Gpa> {\n");
        buf_str(out, c"    keys: *K, values: *V, states: *u8, cap: i64, len: i64, used: i64, alloc: A,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Slot states.\n");
        buf_str(out, c"const SLOT_FREE: u8 = 0;\n");
        buf_str(out, c"const SLOT_FULL: u8 = 1;\n");
        buf_str(out, c"const SLOT_GONE: u8 = 2;\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Hash + Eq, V, A: Allocator> HashMap<K, V, A> {\n");
        buf_str(out, c"    // An empty map on allocator a (0.16).\n");
        buf_str(out, c"    pub fn new_in(a: A) -> HashMap<K, V, A> {\n");
        buf_str(out, c"        HashMap {\n");
        buf_str(out, c"            keys: 0 as *K, values: 0 as *V, states: 0 as *u8, cap: 0, len: 0, used: 0, alloc: a\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn len(self: *HashMap<K, V, A>) -> i64 {\n");
        buf_str(out, c"        self.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn is_empty(self: *HashMap<K, V, A>) -> bool {\n");
        buf_str(out, c"        self.len == 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The slot holding `key`, or -1.\n");
        buf_str(out, c"    fn slot_of(self: *HashMap<K, V, A>, key: *K) -> i64 {\n");
        buf_str(out, c"        if self.cap == 0 {\n");
        buf_str(out, c"            return -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let mask = self.cap - 1;\n");
        buf_str(out, c"        let mut i = (key.hash() & mask as u64) as i64;\n");
        buf_str(out, c"        // (a quarter of the slots at least are free: one ends the search)\n");
        buf_str(out, c"        for _ in 0..self.cap {\n");
        buf_str(out, c"            let state = unsafe { self.states[i] };\n");
        buf_str(out, c"            if state == SLOT_FREE {\n");
        buf_str(out, c"                return -1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if state == SLOT_FULL && unsafe { self.keys[i] } == *key {\n");
        buf_str(out, c"                return i;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i = (i + 1) & mask;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        -1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn contains(self: *HashMap<K, V, A>, key: K) -> bool {\n");
        buf_str(out, c"        self.slot_of(&key) >= 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The same as `contains` (Rust's name).\n");
        buf_str(out, c"    pub fn contains_key(self: *HashMap<K, V, A>, key: K) -> bool {\n");
        buf_str(out, c"        self.slot_of(&key) >= 0\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A copy of the value of `key`, if it has one (`get_mut` changes it).\n");
        buf_str(out, c"    pub fn get(self: *HashMap<K, V, A>, key: K) -> Option<V> {\n");
        buf_str(out, c"        let i = self.slot_of(&key);\n");
        buf_str(out, c"        if i < 0 { Option::None } else { Option::Some(unsafe { self.values[i] }) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The value of `key` in place, as a view of one element, if it has\n");
        buf_str(out, c"    // one: `if let Some(a) = m.get_mut(k) { a[0].balance += 10; }`. The\n");
        buf_str(out, c"    // view is valid until the map's next insert, remove or free (like a\n");
        buf_str(out, c"    // Vec's `as_slice()`).\n");
        buf_str(out, c"    pub fn get_mut(self: *HashMap<K, V, A>, key: K) -> Option<[V]> {\n");
        buf_str(out, c"        let i = self.slot_of(&key);\n");
        buf_str(out, c"        if i < 0 { Option::None } else { Option::Some(unsafe { self.values[i..i + 1] }) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The value of `key` in place (a view of one element, as `get_mut`),\n");
        buf_str(out, c"    // inserted as `default` first if the key has none; Rust's\n");
        buf_str(out, c"    // `entry(k).or_insert(d)`. Counting: `counts.get_or_insert(w, 0)[0] += 1;`.\n");
        buf_str(out, c"    pub fn get_or_insert(self: *HashMap<K, V, A>, key: K, default: V) -> [V] {\n");
        buf_str(out, c"        let mut i = self.slot_of(&key);\n");
        buf_str(out, c"        if i < 0 {\n");
        buf_str(out, c"            i = self.insert_new(key, default);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe { self.values[i..i + 1] }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Sets the value of `key`; returns its old value, if it had one.\n");
        buf_str(out, c"    pub fn insert(self: *HashMap<K, V, A>, key: K, value: V) -> Option<V> {\n");
        buf_str(out, c"        let i = self.slot_of(&key);\n");
        buf_str(out, c"        if i >= 0 {\n");
        buf_str(out, c"            let old = unsafe { self.values[i] };\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                self.values[i] = value;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return Option::Some(old);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.insert_new(key, value);\n");
        buf_str(out, c"        Option::None\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Adds `key`, which the map does not have; returns its slot.\n");
        buf_str(out, c"    fn insert_new(self: *HashMap<K, V, A>, key: K, value: V) -> i64 {\n");
        buf_str(out, c"        if (self.used + 1) * 4 > self.cap * 3 {\n");
        buf_str(out, c"            self.rehash();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let mask = self.cap - 1;\n");
        buf_str(out, c"        let mut j = (key.hash() & mask as u64) as i64;\n");
        buf_str(out, c"        for _ in 0..self.cap {\n");
        buf_str(out, c"            if unsafe { self.states[j] } != SLOT_FULL {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            j = (j + 1) & mask;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            if self.states[j] == SLOT_FREE {\n");
        buf_str(out, c"                self.used += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.states[j] = SLOT_FULL;\n");
        buf_str(out, c"            self.keys[j] = key;\n");
        buf_str(out, c"            self.values[j] = value;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len += 1;\n");
        buf_str(out, c"        j\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Removes `key`; returns its value, if it had one.\n");
        buf_str(out, c"    pub fn remove(self: *HashMap<K, V, A>, key: K) -> Option<V> {\n");
        buf_str(out, c"        let i = self.slot_of(&key);\n");
        buf_str(out, c"        if i < 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.len -= 1;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.states[i] = SLOT_GONE;\n");
        buf_str(out, c"            Option::Some(self.values[i])\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn slots(self: *HashMap<K, V, A>) -> i64 {\n");
        buf_str(out, c"        self.cap\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn key_at(self: *HashMap<K, V, A>, i: i64) -> Option<K> {\n");
        buf_str(out, c"        if i < 0 || i >= self.cap || unsafe { self.states[i] } != SLOT_FULL {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some(unsafe { self.keys[i] })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn value_at(self: *HashMap<K, V, A>, i: i64) -> Option<V> {\n");
        buf_str(out, c"        if i < 0 || i >= self.cap || unsafe { self.states[i] } != SLOT_FULL {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some(unsafe { self.values[i] })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Twice the room (at least 8 slots), the entries moved over and the\n");
        buf_str(out, c"    // removed ones dropped.\n");
        buf_str(out, c"    fn rehash(self: *HashMap<K, V, A>) {\n");
        buf_str(out, c"        self.rehash_to(if self.cap == 0 { 8 } else { self.cap * 2 });\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The entries moved to `cap` slots (a power of two, more than 4/3 of\n");
        buf_str(out, c"    // len), the removed ones dropped.\n");
        buf_str(out, c"    fn rehash_to(self: *HashMap<K, V, A>, cap: i64) {\n");
        buf_str(out, c"        let old_cap = self.cap;\n");
        buf_str(out, c"        let old_keys = self.keys;\n");
        buf_str(out, c"        let old_values = self.values;\n");
        buf_str(out, c"        let old_states = self.states;\n");
        buf_str(out, c"        let key_bytes = alloc_bytes(cap, size_of(K));\n");
        buf_str(out, c"        let value_bytes = alloc_bytes(cap, size_of(V));\n");
        buf_str(out, c"        if key_bytes < 0 || value_bytes < 0 || cap > ALLOC_LIMIT {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            self.keys = self.alloc.try_alloc(key_bytes, align_of(K)) as *K;\n");
        buf_str(out, c"            self.values = self.alloc.try_alloc(value_bytes, align_of(V)) as *V;\n");
        buf_str(out, c"            self.states = self.alloc.try_alloc(cap, 1);\n");
        buf_str(out, c"            if self.keys == 0 as *K || self.values == 0 as *V || self.states == 0 as *u8 {\n");
        buf_str(out, c"                out_of_memory();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            for i in 0..cap {\n");
        buf_str(out, c"                self.states[i] = SLOT_FREE;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.cap = cap;\n");
        buf_str(out, c"        self.used = self.len;\n");
        buf_str(out, c"        let mask = cap - 1;\n");
        buf_str(out, c"        for i in 0..old_cap {\n");
        buf_str(out, c"            if unsafe { old_states[i] } != SLOT_FULL {\n");
        buf_str(out, c"                continue;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let key = unsafe { old_keys[i] };\n");
        buf_str(out, c"            let mut j = (key.hash() & mask as u64) as i64;\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                for _ in 0..cap {\n");
        buf_str(out, c"                    if self.states[j] != SLOT_FULL {\n");
        buf_str(out, c"                        break;\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    j = (j + 1) & mask;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                self.states[j] = SLOT_FULL;\n");
        buf_str(out, c"                self.keys[j] = key;\n");
        buf_str(out, c"                self.values[j] = old_values[i];\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if old_cap > 0 {\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                self.alloc.free(old_keys as *u8, old_cap * size_of(K), align_of(K));\n");
        buf_str(out, c"                self.alloc.free(old_values as *u8, old_cap * size_of(V), align_of(V));\n");
        buf_str(out, c"                self.alloc.free(old_states, old_cap, 1);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn free(self: *HashMap<K, V, A>) {\n");
        buf_str(out, c"        if self.cap > 0 {\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                self.alloc.free(self.keys as *u8, self.cap * size_of(K), align_of(K));\n");
        buf_str(out, c"                self.alloc.free(self.values as *u8, self.cap * size_of(V), align_of(V));\n");
        buf_str(out, c"                self.alloc.free(self.states, self.cap, 1);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.cap = 0;\n");
        buf_str(out, c"        self.len = 0;\n");
        buf_str(out, c"        self.used = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Hash + Eq, V, A: Allocator + Ambient> HashMap<K, V, A> {\n");
        buf_str(out, c"    #[ambient(\"HashMap::new_in(gpa)\")]\n");
        buf_str(out, c"    pub fn new() -> HashMap<K, V, A> {\n");
        buf_str(out, c"        HashMap::new_in(A::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- HashMap's room (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Hash + Eq, V, A: Allocator> HashMap<K, V, A> {\n");
        buf_str(out, c"    // Its allocator (0.16): a copy of the handle.\n");
        buf_str(out, c"    pub fn allocator(self: *HashMap<K, V, A>) -> A {\n");
        buf_str(out, c"        self.alloc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An empty map on allocator a with room for n entries (0.16).\n");
        buf_str(out, c"    pub fn with_capacity_in(n: i64, a: A) -> HashMap<K, V, A> {\n");
        buf_str(out, c"        let mut m: HashMap<K, V, A> = HashMap::new_in(a);\n");
        buf_str(out, c"        if n > 0 {\n");
        buf_str(out, c"            if n > ALLOC_LIMIT / 8 {\n");
        buf_str(out, c"                out_of_memory();\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            // (slots: a power of two, 8 at least, n at most 3/4 of them)\n");
        buf_str(out, c"            let mut cap = 8;\n");
        buf_str(out, c"            for _ in 0..62 {\n");
        buf_str(out, c"                if n * 4 <= cap * 3 {\n");
        buf_str(out, c"                    break;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                cap *= 2;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            m.rehash_to(cap);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        m\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Iterators (0.14) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach: the same module,\n");
        buf_str(out, c"// `std`. The Iterator trait (in the prelude), its sources and adapters;\n");
        buf_str(out, c"// `for x in it` iterates any type implementing it\n");
        buf_str(out, c"// (docs/design/closures-iterators.md).\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Every method is #[inline], so that a chain becomes one loop: the\n");
        buf_str(out, c"// consumers are written on `fold`, and the sources and adapters override\n");
        buf_str(out, c"// `fold` with a counted loop (internal iteration). `exact_len` and `at`\n");
        buf_str(out, c"// let zip and enumerate index both sides when they know their length.\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub trait Iterator {\n");
        buf_str(out, c"    type Item;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The next item, or None when there are no more.\n");
        buf_str(out, c"    fn next(self: *Self) -> Option<Self::Item>;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The number of items left, or -1 when it is not known.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: *Self) -> i64 {\n");
        buf_str(out, c"        -1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The k-th item left: only when exact_len() > k, with k increasing\n");
        buf_str(out, c"    // (0, 1, 2, ...) and no other use of the iterator in between.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: *Self, k: i64) -> Self::Item {\n");
        buf_str(out, c"        self.next().unwrap()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn map<B, F: FnMut(Self::Item) -> B>(self: Self, f: F) -> Map<Self, F> {\n");
        buf_str(out, c"        Map { it: self, f: f }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn filter<F: FnMut(Self::Item) -> bool>(self: Self, f: F) -> Filter<Self, F> {\n");
        buf_str(out, c"        Filter { it: self, f: f }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Items (i64, Self::Item): each with its index.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn enumerate(self: Self) -> Enumerate<Self> {\n");
        buf_str(out, c"        Enumerate { it: self, k: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Items (Self::Item, J::Item), as long as both have one.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn zip<J: Iterator>(self: Self, other: J) -> Zip<Self, J> {\n");
        buf_str(out, c"        Zip { a: self, b: other }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The first n items.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn take(self: Self, n: i64) -> Take<Self> {\n");
        buf_str(out, c"        Take { it: self, n: n }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // f(...f(f(init, x0), x1)..., xn): the loop every consumer is.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, Self::Item) -> B>(self: Self, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut it = self;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        while let Option::Some(x) = it.next() {\n");
        buf_str(out, c"            acc = g(acc, x);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn for_each<F: FnMut(Self::Item)>(self: Self, f: F) {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        self.fold((), |u: (), x| g(x));\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn count(self: Self) -> i64 {\n");
        buf_str(out, c"        self.fold(0i64, |n, x| n + 1)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The sum of the items, from `0 as Self::Item`.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn sum(self: Self) -> Self::Item {\n");
        buf_str(out, c"        self.fold(0 as Self::Item, |s, x| s + x)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn min(self: Self) -> Option<Self::Item> {\n");
        buf_str(out, c"        let mut it = self;\n");
        buf_str(out, c"        match it.next() {\n");
        buf_str(out, c"            Option::Some(first) => Option::Some(it.fold(first, |m, x| if x < m { x } else { m })),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn max(self: Self) -> Option<Self::Item> {\n");
        buf_str(out, c"        let mut it = self;\n");
        buf_str(out, c"        match it.next() {\n");
        buf_str(out, c"            Option::Some(first) => Option::Some(it.fold(first, |m, x| if x > m { x } else { m })),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A new Vec of the items on allocator a (0.16; the caller frees it).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn collect_in<A: Allocator>(self: Self, a: A) -> Vec<Self::Item, A> {\n");
        buf_str(out, c"        let mut it = self;\n");
        buf_str(out, c"        let mut v: Vec<Self::Item, A> = Vec::new_in(a);\n");
        buf_str(out, c"        let n = it.exact_len();\n");
        buf_str(out, c"        if n > 0 {\n");
        buf_str(out, c"            v.reserve(n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        it.for_each(|x| v.push(x));\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // (0.16: an error outside std, front/ambient.tach)\n");
        buf_str(out, c"    #[ambient(\"collect_in(gpa)\")]\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn collect(self: Self) -> Vec<Self::Item> {\n");
        buf_str(out, c"        self.collect_in(Gpa::ambient())\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // ---- Searches (0.15) ----\n");
        buf_str(out, c"    // They call `next` and stop at the first item that decides: the items\n");
        buf_str(out, c"    // after it are not reached.\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether f is true for some item.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn any<F: FnMut(Self::Item) -> bool>(self: Self, f: F) -> bool {\n");
        buf_str(out, c"        let mut it = self;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        while let Option::Some(x) = it.next() {\n");
        buf_str(out, c"            if g(x) {\n");
        buf_str(out, c"                return true;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether f is true for every item (true when there is none).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn all<F: FnMut(Self::Item) -> bool>(self: Self, f: F) -> bool {\n");
        buf_str(out, c"        let mut it = self;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        while let Option::Some(x) = it.next() {\n");
        buf_str(out, c"            if !g(x) {\n");
        buf_str(out, c"                return false;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The index (counting from 0) of the first item f is true for.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn position<F: FnMut(Self::Item) -> bool>(self: Self, f: F) -> Option<i64> {\n");
        buf_str(out, c"        let mut it = self;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut k = 0;\n");
        buf_str(out, c"        while let Option::Some(x) = it.next() {\n");
        buf_str(out, c"            if g(x) {\n");
        buf_str(out, c"                return Option::Some(k);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            k += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::None\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The first item f is true for.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn find<F: FnMut(Self::Item) -> bool>(self: Self, f: F) -> Option<Self::Item> {\n");
        buf_str(out, c"        let mut it = self;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        while let Option::Some(x) = it.next() {\n");
        buf_str(out, c"            if g(x) {\n");
        buf_str(out, c"                return Option::Some(x);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::None\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Adapters ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Map<I, F> { it: I, f: F }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<I: Iterator, M> Iterator for Map<I, M> {\n");
        buf_str(out, c"    type Item = M::Output;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: *Map<I, M>) -> Option<M::Output> {\n");
        buf_str(out, c"        match self.it.next() {\n");
        buf_str(out, c"            Option::Some(x) => Option::Some((self.f)(x)),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: *Map<I, M>) -> i64 {\n");
        buf_str(out, c"        self.it.exact_len()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: *Map<I, M>, k: i64) -> M::Output {\n");
        buf_str(out, c"        (self.f)(self.it.at(k))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, M::Output) -> B>(self: Map<I, M>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut m = self.f;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        self.it.fold(init, |acc, x| g(acc, m(x)))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Filter<I, F> { it: I, f: F }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<I: Iterator, P> Iterator for Filter<I, P> {\n");
        buf_str(out, c"    type Item = I::Item;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: *Filter<I, P>) -> Option<I::Item> {\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            match self.it.next() {\n");
        buf_str(out, c"                Option::Some(x) => {\n");
        buf_str(out, c"                    if (self.f)(x) {\n");
        buf_str(out, c"                        return Option::Some(x);\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                Option::None => return Option::None,\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, I::Item) -> B>(self: Filter<I, P>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut p = self.f;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        self.it.fold(init, |acc, x| if p(x) { g(acc, x) } else { acc })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Enumerate<I> { it: I, k: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<I: Iterator> Iterator for Enumerate<I> {\n");
        buf_str(out, c"    type Item = (i64, I::Item);\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: *Enumerate<I>) -> Option<(i64, I::Item)> {\n");
        buf_str(out, c"        match self.it.next() {\n");
        buf_str(out, c"            Option::Some(x) => {\n");
        buf_str(out, c"                let k = self.k;\n");
        buf_str(out, c"                self.k = k + 1;\n");
        buf_str(out, c"                Option::Some((k, x))\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: *Enumerate<I>) -> i64 {\n");
        buf_str(out, c"        self.it.exact_len()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: *Enumerate<I>, k: i64) -> (i64, I::Item) {\n");
        buf_str(out, c"        (self.k + k, self.it.at(k))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, (i64, I::Item)) -> B>(self: Enumerate<I>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut e = self;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        let n = e.it.exact_len();\n");
        buf_str(out, c"        if n >= 0 {\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                acc = g(acc, (e.k + k, e.it.at(k)));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            while let Option::Some(p) = e.next() {\n");
        buf_str(out, c"                acc = g(acc, p);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Zip<I, J> { a: I, b: J }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Iterator, J: Iterator> Iterator for Zip<A, J> {\n");
        buf_str(out, c"    type Item = (A::Item, J::Item);\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: *Zip<A, J>) -> Option<(A::Item, J::Item)> {\n");
        buf_str(out, c"        match self.a.next() {\n");
        buf_str(out, c"            Option::Some(x) => match self.b.next() {\n");
        buf_str(out, c"                Option::Some(y) => Option::Some((x, y)),\n");
        buf_str(out, c"                Option::None => Option::None,\n");
        buf_str(out, c"            },\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: *Zip<A, J>) -> i64 {\n");
        buf_str(out, c"        let n = self.a.exact_len();\n");
        buf_str(out, c"        let m = self.b.exact_len();\n");
        buf_str(out, c"        if n < 0 || m < 0 {\n");
        buf_str(out, c"            -1\n");
        buf_str(out, c"        } else if n < m {\n");
        buf_str(out, c"            n\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            m\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: *Zip<A, J>, k: i64) -> (A::Item, J::Item) {\n");
        buf_str(out, c"        (self.a.at(k), self.b.at(k))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, (A::Item, J::Item)) -> B>(self: Zip<A, J>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut z = self;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        let n = z.exact_len();\n");
        buf_str(out, c"        if n >= 0 {\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                acc = g(acc, (z.a.at(k), z.b.at(k)));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            while let Option::Some(p) = z.next() {\n");
        buf_str(out, c"                acc = g(acc, p);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Take<I> { it: I, n: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<I: Iterator> Iterator for Take<I> {\n");
        buf_str(out, c"    type Item = I::Item;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: *Take<I>) -> Option<I::Item> {\n");
        buf_str(out, c"        if self.n <= 0 {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.n -= 1;\n");
        buf_str(out, c"        self.it.next()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: *Take<I>) -> i64 {\n");
        buf_str(out, c"        let m = self.it.exact_len();\n");
        buf_str(out, c"        if m < 0 {\n");
        buf_str(out, c"            -1\n");
        buf_str(out, c"        } else if self.n <= 0 {\n");
        buf_str(out, c"            0\n");
        buf_str(out, c"        } else if m < self.n {\n");
        buf_str(out, c"            m\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.n\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: *Take<I>, k: i64) -> I::Item {\n");
        buf_str(out, c"        self.it.at(k)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, I::Item) -> B>(self: Take<I>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut t = self;\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        let n = t.exact_len();\n");
        buf_str(out, c"        if n >= 0 {\n");
        buf_str(out, c"            for k in 0..n {\n");
        buf_str(out, c"                acc = g(acc, t.it.at(k));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            while t.n > 0 {\n");
        buf_str(out, c"                match t.it.next() {\n");
        buf_str(out, c"                    Option::Some(x) => {\n");
        buf_str(out, c"                        t.n -= 1;\n");
        buf_str(out, c"                        acc = g(acc, x);\n");
        buf_str(out, c"                    }\n");
        buf_str(out, c"                    Option::None => break,\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Sources ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// `for` over a SliceIter, a Range or a RangeInclusive is a counted loop\n");
        buf_str(out, c"// (front/check/iterate.tach); their `fold` is one too.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `a..b` as a value: start, start + 1, ..., up to end, end excluded.\n");
        buf_str(out, c"pub struct Range<T> { pub start: T, pub end: T }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Iterator for Range<T> {\n");
        buf_str(out, c"    type Item = T;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: *Range<T>) -> Option<T> {\n");
        buf_str(out, c"        if self.start < self.end {\n");
        buf_str(out, c"            let x = self.start;\n");
        buf_str(out, c"            self.start = x + 1;\n");
        buf_str(out, c"            Option::Some(x)\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            Option::None\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: *Range<T>) -> i64 {\n");
        buf_str(out, c"        if self.start < self.end { (self.end - self.start) as i64 } else { 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: *Range<T>, k: i64) -> T {\n");
        buf_str(out, c"        self.start + k as T\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, T) -> B>(self: Range<T>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        for x in self.start..self.end {\n");
        buf_str(out, c"            acc = g(acc, x);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `a..=b` as a value: end included; `done` once `next` gave end.\n");
        buf_str(out, c"pub struct RangeInclusive<T> { pub start: T, pub end: T, pub done: bool }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Iterator for RangeInclusive<T> {\n");
        buf_str(out, c"    type Item = T;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: *RangeInclusive<T>) -> Option<T> {\n");
        buf_str(out, c"        if self.done || self.start > self.end {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let x = self.start;\n");
        buf_str(out, c"        if x == self.end {\n");
        buf_str(out, c"            self.done = true;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            self.start = x + 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some(x)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: *RangeInclusive<T>) -> i64 {\n");
        buf_str(out, c"        if self.done || self.start > self.end { 0 } else { (self.end - self.start) as i64 + 1 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: *RangeInclusive<T>, k: i64) -> T {\n");
        buf_str(out, c"        self.start + k as T\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, T) -> B>(self: RangeInclusive<T>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        if !self.done {\n");
        buf_str(out, c"            for x in self.start..=self.end {\n");
        buf_str(out, c"                acc = g(acc, x);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The items of a slice, by value: `v.iter()`, `s.iter()`.\n");
        buf_str(out, c"pub struct SliceIter<T> { s: [T], pos: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Iterator for SliceIter<T> {\n");
        buf_str(out, c"    type Item = T;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: *SliceIter<T>) -> Option<T> {\n");
        buf_str(out, c"        if self.pos < self.s.len {\n");
        buf_str(out, c"            let x = self.s[self.pos];\n");
        buf_str(out, c"            self.pos += 1;\n");
        buf_str(out, c"            Option::Some(x)\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            Option::None\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: *SliceIter<T>) -> i64 {\n");
        buf_str(out, c"        self.s.len - self.pos\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn at(self: *SliceIter<T>, k: i64) -> T {\n");
        buf_str(out, c"        self.s[self.pos + k]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, T) -> B>(self: SliceIter<T>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        let s = self.s;\n");
        buf_str(out, c"        for k in self.pos..s.len {\n");
        buf_str(out, c"            acc = g(acc, s[k]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> SliceIter<T> {\n");
        buf_str(out, c"    // The items left, as a slice.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn as_slice(self: *SliceIter<T>) -> [T] {\n");
        buf_str(out, c"        self.s[self.pos..self.s.len]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T>[T] {\n");
        buf_str(out, c"    // Its items, by value.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn iter(self: [T]) -> SliceIter<T> {\n");
        buf_str(out, c"        SliceIter { s: self, pos: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Sorts it in place by f (see sort_by).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn sort_by<F: FnMut(*T, *T) -> i64>(self: [T], f: F) {\n");
        buf_str(out, c"        sort_by(self, f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // Its items, by value (a view: valid until the vector grows or is\n");
        buf_str(out, c"    // freed).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn iter(self: *Vec<T, A>) -> SliceIter<T> {\n");
        buf_str(out, c"        SliceIter { s: self.as_slice(), pos: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Sorts it in place by f (see sort_by).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn sort_by<F: FnMut(*T, *T) -> i64>(self: *Vec<T, A>, f: F) {\n");
        buf_str(out, c"        sort_by(self.as_slice(), f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `m.iter()`: (key, value) in slot order, until the map changes.\n");
        buf_str(out, c"pub struct HashMapIter<K, V> { keys: *K, values: *V, states: *u8, cap: i64, pos: i64, left: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K, V> Iterator for HashMapIter<K, V> {\n");
        buf_str(out, c"    type Item = (K, V);\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: *HashMapIter<K, V>) -> Option<(K, V)> {\n");
        buf_str(out, c"        for i in self.pos..self.cap {\n");
        buf_str(out, c"            self.pos = i + 1;\n");
        buf_str(out, c"            if unsafe { self.states[i] } == SLOT_FULL {\n");
        buf_str(out, c"                self.left -= 1;\n");
        buf_str(out, c"                return Option::Some((unsafe { self.keys[i] }, unsafe { self.values[i] }));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::None\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: *HashMapIter<K, V>) -> i64 {\n");
        buf_str(out, c"        self.left\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, (K, V)) -> B>(self: HashMapIter<K, V>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        let mut acc = init;\n");
        buf_str(out, c"        for i in self.pos..self.cap {\n");
        buf_str(out, c"            if unsafe { self.states[i] } == SLOT_FULL {\n");
        buf_str(out, c"                acc = g(acc, (unsafe { self.keys[i] }, unsafe { self.values[i] }));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        acc\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Keys<K, V> { it: HashMapIter<K, V> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K, V> Iterator for Keys<K, V> {\n");
        buf_str(out, c"    type Item = K;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: *Keys<K, V>) -> Option<K> {\n");
        buf_str(out, c"        match self.it.next() {\n");
        buf_str(out, c"            Option::Some(e) => Option::Some(e.0),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: *Keys<K, V>) -> i64 {\n");
        buf_str(out, c"        self.it.left\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, K) -> B>(self: Keys<K, V>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        self.it.fold(init, |acc, e| g(acc, e.0))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Values<K, V> { it: HashMapIter<K, V> }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K, V> Iterator for Values<K, V> {\n");
        buf_str(out, c"    type Item = V;\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn next(self: *Values<K, V>) -> Option<V> {\n");
        buf_str(out, c"        match self.it.next() {\n");
        buf_str(out, c"            Option::Some(e) => Option::Some(e.1),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn exact_len(self: *Values<K, V>) -> i64 {\n");
        buf_str(out, c"        self.it.left\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fold<B, F: FnMut(B, V) -> B>(self: Values<K, V>, init: B, f: F) -> B {\n");
        buf_str(out, c"        let mut g = f;\n");
        buf_str(out, c"        self.it.fold(init, |acc, e| g(acc, e.1))\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Hash + Eq, V, A: Allocator> HashMap<K, V, A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn iter(self: *HashMap<K, V, A>) -> HashMapIter<K, V> {\n");
        buf_str(out, c"        HashMapIter {\n");
        buf_str(out, c"            keys: self.keys, values: self.values, states: self.states, cap: self.cap, pos: 0,\n");
        buf_str(out, c"            left: self.len,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn keys(self: *HashMap<K, V, A>) -> Keys<K, V> {\n");
        buf_str(out, c"        Keys { it: self.iter() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn values(self: *HashMap<K, V, A>) -> Values<K, V> {\n");
        buf_str(out, c"        Values { it: self.iter() }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Sorts s in place by f: f(a, b) is negative, zero or positive as *a goes\n");
        buf_str(out, c"// before, with or after *b (`|a, b| a.cmp(b)`: smallest first). A\n");
        buf_str(out, c"// heapsort: not stable.\n");
        buf_str(out, c"pub fn sort_by<T, F: FnMut(*T, *T) -> i64>(s: [T], f: F) {\n");
        buf_str(out, c"    let mut g = f;\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    let mut start = n / 2;\n");
        buf_str(out, c"    let mut end = n;\n");
        buf_str(out, c"    // (each round takes one from start or end: n / 2 + n at most; 0.16:\n");
        buf_str(out, c"    // counted loops, no effect diverge)\n");
        buf_str(out, c"    for _ in 0..n / 2 + n + 1 {\n");
        buf_str(out, c"        // Build the heap from n/2 down, then move its top behind it.\n");
        buf_str(out, c"        if start > 0 {\n");
        buf_str(out, c"            start -= 1;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            end -= 1;\n");
        buf_str(out, c"            if end <= 0 {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let top = s[0];\n");
        buf_str(out, c"            s[0] = s[end];\n");
        buf_str(out, c"            s[end] = top;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let mut root = start;\n");
        buf_str(out, c"        for _ in 0..64 {\n");
        buf_str(out, c"            let mut child = 2 * root + 1;\n");
        buf_str(out, c"            if child >= end {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if child + 1 < end && g(&s[child], &s[child + 1]) < 0 {\n");
        buf_str(out, c"                child += 1;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if g(&s[root], &s[child]) >= 0 {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let t = s[root];\n");
        buf_str(out, c"            s[root] = s[child];\n");
        buf_str(out, c"            s[child] = t;\n");
        buf_str(out, c"            root = child;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Slices (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T>[T] {\n");
        buf_str(out, c"    // Element i, or None when i is out of bounds (0.16: `s[i]` stops the\n");
        buf_str(out, c"    // program then, this does not).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn get(self: [T], i: i64) -> Option<T> {\n");
        buf_str(out, c"        if (i as u64) >= (self.len as u64) {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        Option::Some(unsafe { self.ptr[i] })\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Reading stdin and text (0.14) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach (0.15: split from\n");
        buf_str(out, c"// it): the same module, `std`. Reading stdin by lines or whole, trimming,\n");
        buf_str(out, c"// splitting and parsing text, and a Scanner of tokens and numbers.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// (0.15) The convention: an Option means absence (the end of the input,\n");
        buf_str(out, c"// nothing found), a Result with an error enum a failure: `read_line` and\n");
        buf_str(out, c"// `read_stdin` fail with an IoError, `parse_int` with a ParseIntError,\n");
        buf_str(out, c"// `Scanner::next_int` with a ScanError.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Reading stdin (0.14) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `read_line` and `read_stdin` share one buffer: they can be mixed, but\n");
        buf_str(out, c"// not with C's stdio reading (getchar, scanf, fgets), which has its own.\n");
        buf_str(out, c"static mut STDIN_BUF: *u8 = 0 as *u8;\n");
        buf_str(out, c"static mut STDIN_POS: i64 = 0;\n");
        buf_str(out, c"static mut STDIN_LEN: i64 = 0;\n");
        buf_str(out, c"const STDIN_BLOCK: i64 = 65536;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Bytes in STDIN_BUF[STDIN_POS..STDIN_LEN], read if there were none: 1;\n");
        buf_str(out, c"// 0 at the end of input, -1 when reading failed.\n");
        buf_str(out, c"fn stdin_fill() -> i64 {\n");
        buf_str(out, c"    if STDIN_POS < STDIN_LEN {\n");
        buf_str(out, c"        return 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if STDIN_BUF == 0 as *u8 {\n");
        buf_str(out, c"        STDIN_BUF = unsafe { malloc(STDIN_BLOCK as u64) };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let n = unsafe { read(0, STDIN_BUF, STDIN_BLOCK as u64) };\n");
        buf_str(out, c"    STDIN_POS = 0;\n");
        buf_str(out, c"    STDIN_LEN = if n > 0 { n } else { 0 };\n");
        buf_str(out, c"    if n > 0 { 1 } else if n == 0 { 0 } else { -1 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The next line of stdin into `line` (emptied first; 0.16: a Buf on any\n");
        buf_str(out, c"// allocator, which it grows), without its '\\n'; Ok(false) at the end of\n");
        buf_str(out, c"// input.\n");
        buf_str(out, c"pub fn read_line<A: Allocator>(line: *Buf<A>) -> Result<bool, IoError> {\n");
        buf_str(out, c"    line.clear();\n");
        buf_str(out, c"    let mut any = false;\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        let filled = stdin_fill();\n");
        buf_str(out, c"        if filled < 0 {\n");
        buf_str(out, c"            return Result::Err(IoError::Read);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if filled == 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        any = true;\n");
        buf_str(out, c"        let block = unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] };\n");
        buf_str(out, c"        for i in 0..block.len {\n");
        buf_str(out, c"            if block[i] == '\\n' {\n");
        buf_str(out, c"                line.push_str(block[..i]);\n");
        buf_str(out, c"                STDIN_POS += i + 1;\n");
        buf_str(out, c"                return Result::Ok(true);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        line.push_str(block);\n");
        buf_str(out, c"        STDIN_POS = STDIN_LEN;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    Result::Ok(any)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// All of stdin that is left, in a new Buf on allocator a (the caller\n");
        buf_str(out, c"// frees it). It shares a buffer with read_line, not with C's getchar or\n");
        buf_str(out, c"// scanf.\n");
        buf_str(out, c"pub fn read_stdin_in<A: Allocator>(a: A) -> Result<Buf<A>, IoError> {\n");
        buf_str(out, c"    let mut b: Buf<A> = Buf::new_in(a);\n");
        buf_str(out, c"    if STDIN_POS < STDIN_LEN {\n");
        buf_str(out, c"        b.push_str(unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] });\n");
        buf_str(out, c"        STDIN_POS = STDIN_LEN;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        b.bytes.reserve(STDIN_BLOCK);\n");
        buf_str(out, c"        let room = b.bytes.cap - b.bytes.len;\n");
        buf_str(out, c"        let n = unsafe { read(0, &b.bytes.ptr[b.bytes.len], room as u64) };\n");
        buf_str(out, c"        if n == 0 {\n");
        buf_str(out, c"            return Result::Ok(b);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if n < 0 {\n");
        buf_str(out, c"            b.free();\n");
        buf_str(out, c"            return Result::Err(IoError::Read);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b.bytes.len += n;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Text (0.14) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ASCII whitespace: ' ', '\\t', '\\n', '\\r', vertical tab, form feed.\n");
        buf_str(out, c"pub fn is_space(b: u8) -> bool {\n");
        buf_str(out, c"    b == ' ' || b == '\\t' || b == '\\n' || b == '\\r' || b == 11 || b == 12\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// '0' to '9'.\n");
        buf_str(out, c"pub fn is_digit(b: u8) -> bool {\n");
        buf_str(out, c"    b >= '0' && b <= '9'\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// s without the whitespace (`is_space`) at its start and end.\n");
        buf_str(out, c"pub fn trim(s: [u8]) -> [u8] {\n");
        buf_str(out, c"    let mut a = 0;\n");
        buf_str(out, c"    let mut b = s.len;\n");
        buf_str(out, c"    for _ in 0..s.len {\n");
        buf_str(out, c"        if !(a < b && is_space(s[a])) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        a += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for _ in 0..s.len {\n");
        buf_str(out, c"        if !(b > a && is_space(s[b - 1])) {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        b -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    s[a..b]\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// s as an integer: an optional '-' or '+', then decimal digits, nothing\n");
        buf_str(out, c"// else (no spaces); Err if s is not one or does not fit in an i64.\n");
        buf_str(out, c"pub fn parse_int(s: [u8]) -> Result<i64, ParseIntError> {\n");
        buf_str(out, c"    let mut i = 0;\n");
        buf_str(out, c"    if s.len > 0 && (s[0] == '-' || s[0] == '+') {\n");
        buf_str(out, c"        i = 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if i == s.len {\n");
        buf_str(out, c"        return Result::Err(ParseIntError::Empty);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // Summed as a negative number, which reaches the smallest i64.\n");
        buf_str(out, c"    let min = -9223372036854775807 - 1;\n");
        buf_str(out, c"    let mut n = 0;\n");
        buf_str(out, c"    for _ in i..s.len {\n");
        buf_str(out, c"        if !is_digit(s[i]) {\n");
        buf_str(out, c"            return Result::Err(ParseIntError::InvalidDigit(i));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let d = (s[i] - '0') as i64;\n");
        buf_str(out, c"        if n < min / 10 || (n == min / 10 && d > -(min % 10)) {\n");
        buf_str(out, c"            // (a later byte that is not a digit is still that error)\n");
        buf_str(out, c"            for k in i..s.len {\n");
        buf_str(out, c"                if !is_digit(s[k]) {\n");
        buf_str(out, c"                    return Result::Err(ParseIntError::InvalidDigit(k));\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return Result::Err(ParseIntError::Overflow);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        n = n * 10 - d;\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if s[0] == '-' {\n");
        buf_str(out, c"        Result::Ok(n)\n");
        buf_str(out, c"    } else if n == min {\n");
        buf_str(out, c"        Result::Err(ParseIntError::Overflow)\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        Result::Ok(-n)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"read_stdin_in(gpa)\")]\n");
        buf_str(out, c"pub fn read_stdin() -> Result<Buf, IoError> {\n");
        buf_str(out, c"    read_stdin_in(Gpa::ambient())\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The parts of s between `sep` bytes, empty ones too, as views of s\n");
        buf_str(out, c"// (`split_in(\"a,,b\", ',', gpa)`: \"a\", \"\", \"b\"), in a Vec on allocator a.\n");
        buf_str(out, c"// The caller frees the Vec.\n");
        buf_str(out, c"pub fn split_in<A: Allocator>(s: [u8], sep: u8, a: A) -> Vec<[u8], A> {\n");
        buf_str(out, c"    let mut parts: Vec<[u8], A> = Vec::new_in(a);\n");
        buf_str(out, c"    let mut start = 0;\n");
        buf_str(out, c"    for i in 0..s.len {\n");
        buf_str(out, c"        if s[i] == sep {\n");
        buf_str(out, c"            parts.push(s[start..i]);\n");
        buf_str(out, c"            start = i + 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    parts.push(s[start..]);\n");
        buf_str(out, c"    parts\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"split_in(s, sep, gpa)\")]\n");
        buf_str(out, c"pub fn split(s: [u8], sep: u8) -> Vec<[u8]> {\n");
        buf_str(out, c"    split_in(s, sep, Gpa::ambient())\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"split_whitespace_in(s, gpa)\")]\n");
        buf_str(out, c"pub fn split_whitespace(s: [u8]) -> Vec<[u8]> {\n");
        buf_str(out, c"    split_whitespace_in(s, Gpa::ambient())\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The runs of non-whitespace in s, as views of s, in a Vec on allocator a.\n");
        buf_str(out, c"// The caller frees it.\n");
        buf_str(out, c"pub fn split_whitespace_in<A: Allocator>(s: [u8], a: A) -> Vec<[u8], A> {\n");
        buf_str(out, c"    let mut words: Vec<[u8], A> = Vec::new_in(a);\n");
        buf_str(out, c"    let mut sc = Scanner::new(s);\n");
        buf_str(out, c"    while let Option::Some(w) = sc.next_token() {\n");
        buf_str(out, c"        words.push(w);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    words\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Reads a text (`read_stdin().as_slice()`) front to back, by tokens\n");
        buf_str(out, c"// (runs of non-whitespace) and lines, as views of the text.\n");
        buf_str(out, c"pub struct Scanner { text: [u8], pos: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Scanner {\n");
        buf_str(out, c"    pub fn new(text: [u8]) -> Scanner {\n");
        buf_str(out, c"        Scanner { text: text, pos: 0 }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The next token; None when only whitespace is left.\n");
        buf_str(out, c"    pub fn next_token(self: *Scanner) -> Option<[u8]> {\n");
        buf_str(out, c"        let s = self.text;\n");
        buf_str(out, c"        let mut i = self.pos;\n");
        buf_str(out, c"        for _ in i..s.len {\n");
        buf_str(out, c"            if !is_space(s[i]) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if i >= s.len {\n");
        buf_str(out, c"            self.pos = i;\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let start = i;\n");
        buf_str(out, c"        for _ in i..s.len {\n");
        buf_str(out, c"            if is_space(s[i]) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.pos = i;\n");
        buf_str(out, c"        Option::Some(s[start..i])\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The next token as an integer (`parse_int`); Err at the end, or if\n");
        buf_str(out, c"    // it is not one (it is consumed all the same).\n");
        buf_str(out, c"    pub fn next_int(self: *Scanner) -> Result<i64, ScanError> {\n");
        buf_str(out, c"        match self.next_token() {\n");
        buf_str(out, c"            Option::Some(t) => match parse_int(t) {\n");
        buf_str(out, c"                Result::Ok(n) => Result::Ok(n),\n");
        buf_str(out, c"                Result::Err(e) => Result::Err(ScanError::Parse(e)),\n");
        buf_str(out, c"            },\n");
        buf_str(out, c"            Option::None => Result::Err(ScanError::End),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The rest of the line, without its '\\n'; None at the end of the\n");
        buf_str(out, c"    // text (\"a\\n\\nb\": \"a\", \"\", \"b\"; \"a\\n\": \"a\").\n");
        buf_str(out, c"    pub fn next_line(self: *Scanner) -> Option<[u8]> {\n");
        buf_str(out, c"        let s = self.text;\n");
        buf_str(out, c"        if self.pos >= s.len {\n");
        buf_str(out, c"            return Option::None;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let start = self.pos;\n");
        buf_str(out, c"        let mut i = start;\n");
        buf_str(out, c"        for _ in i..s.len {\n");
        buf_str(out, c"            if s[i] == '\\n' {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.pos = if i < s.len { i + 1 } else { i };\n");
        buf_str(out, c"        Option::Some(s[start..i])\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether nothing but whitespace is left.\n");
        buf_str(out, c"    pub fn is_done(self: *Scanner) -> bool {\n");
        buf_str(out, c"        let s = self.text;\n");
        buf_str(out, c"        let mut i = self.pos;\n");
        buf_str(out, c"        for _ in i..s.len {\n");
        buf_str(out, c"            if !is_space(s[i]) {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i >= s.len\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // What is left of the text.\n");
        buf_str(out, c"    pub fn rest(self: *Scanner) -> [u8] {\n");
        buf_str(out, c"        self.text[self.pos..]\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Errors of reading and parsing (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Reading stdin failed (read_line, read_stdin).\n");
        buf_str(out, c"pub enum IoError { Read, Write }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Why parse_int failed: no digits; the byte at this index is not a digit;\n");
        buf_str(out, c"// the number does not fit in an i64.\n");
        buf_str(out, c"pub enum ParseIntError { Empty, InvalidDigit(i64), Overflow }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Why Scanner::next_int failed: no token left; the token is not a number.\n");
        buf_str(out, c"pub enum ScanError { End, Parse(ParseIntError) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for IoError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *IoError, f: *Fmt) {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            IoError::Read => f.str(\"cannot read the input\"),\n");
        buf_str(out, c"            IoError::Write => f.str(\"cannot write the output\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for IoError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: *IoError, f: *Fmt) {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            IoError::Read => f.str(\"Read\"),\n");
        buf_str(out, c"            IoError::Write => f.str(\"Write\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for ParseIntError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *ParseIntError, f: *Fmt) {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            ParseIntError::Empty => f.str(\"cannot parse an integer from an empty text\"),\n");
        buf_str(out, c"            ParseIntError::InvalidDigit(i) => {\n");
        buf_str(out, c"                f.str(\"invalid digit at byte \");\n");
        buf_str(out, c"                f.display(&i);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            ParseIntError::Overflow => f.str(\"the number does not fit in an i64\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for ParseIntError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: *ParseIntError, f: *Fmt) {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            ParseIntError::Empty => f.str(\"Empty\"),\n");
        buf_str(out, c"            ParseIntError::InvalidDigit(i) => {\n");
        buf_str(out, c"                f.str(\"InvalidDigit(\");\n");
        buf_str(out, c"                f.debug(&i);\n");
        buf_str(out, c"                f.str(\")\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            ParseIntError::Overflow => f.str(\"Overflow\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for ScanError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *ScanError, f: *Fmt) {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            ScanError::End => f.str(\"no number left: the end of the input\"),\n");
        buf_str(out, c"            ScanError::Parse(e) => f.display(&e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for ScanError {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: *ScanError, f: *Fmt) {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            ScanError::End => f.str(\"End\"),\n");
        buf_str(out, c"            ScanError::Parse(e) => {\n");
        buf_str(out, c"                f.str(\"Parse(\");\n");
        buf_str(out, c"                f.debug(&e);\n");
        buf_str(out, c"                f.str(\")\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Integer limits (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The smallest and largest values of the integer types: the same as the\n");
        buf_str(out, c"// builtin `i32::MAX`, `u8::MIN`, ... (aliases, from before those).\n");
        buf_str(out, c"pub const I8_MIN: i8 = i8::MIN;\n");
        buf_str(out, c"pub const I8_MAX: i8 = i8::MAX;\n");
        buf_str(out, c"pub const I16_MIN: i16 = i16::MIN;\n");
        buf_str(out, c"pub const I16_MAX: i16 = i16::MAX;\n");
        buf_str(out, c"pub const I32_MIN: i32 = i32::MIN;\n");
        buf_str(out, c"pub const I32_MAX: i32 = i32::MAX;\n");
        buf_str(out, c"pub const I64_MIN: i64 = i64::MIN;\n");
        buf_str(out, c"pub const I64_MAX: i64 = i64::MAX;\n");
        buf_str(out, c"pub const U8_MAX: u8 = u8::MAX;\n");
        buf_str(out, c"pub const U16_MAX: u16 = u16::MAX;\n");
        buf_str(out, c"pub const U32_MAX: u32 = u32::MAX;\n");
        buf_str(out, c"pub const U64_MAX: u64 = u64::MAX;\n");
        buf_str(out, c"// ---- Printing and formatting ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach (its printing was\n");
        buf_str(out, c"// split from it): the same module, `std`. Printing; the traits Display\n");
        buf_str(out, c"// (`{x}`, print) and Debug (`{x:?}`), the formatter Fmt they write to, and\n");
        buf_str(out, c"// Interp, the value of an f-string (docs/design/errors-formatting.md).\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Output to stdout and stderr goes through one static buffer of 4 KB\n");
        buf_str(out, c"// (not the heap), written out at the end of each print call: one `write`\n");
        buf_str(out, c"// per print, whatever its argument is made of. A Fmt to a file descriptor\n");
        buf_str(out, c"// only fills that buffer: `flush` writes it out.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// (0.16) Formatting allocates nothing: a Fmt to a Buf writes into the\n");
        buf_str(out, c"// room the Buf has, and counts what does not fit; then `push_fmt` grows\n");
        buf_str(out, c"// the Buf to the count and runs the Display again (twice only when the\n");
        buf_str(out, c"// text did not fit). So print's effects have no `alloc`.\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn snprintf(buf: *u8, n: u64, format: *u8, ...) -> i32;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn strtod(s: *u8, end: **u8) -> f64;\n");
        buf_str(out, c"    #[effects()]\n");
        buf_str(out, c"    fn strtof(s: *u8, end: **u8) -> f32;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Printing ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// x's Display (`print(\"text\")`, `print(f\"{a} {b:?}\")`): one `write`.\n");
        buf_str(out, c"pub fn print<T: Display>(x: T) {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(1);\n");
        buf_str(out, c"    x.fmt(&f);\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn println<T: Display>(x: T) {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(1);\n");
        buf_str(out, c"    x.fmt(&f);\n");
        buf_str(out, c"    f.byte('\\n');\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"pub fn print_int(v: i64) {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(1);\n");
        buf_str(out, c"    // (decimal only: not Fmt::int, whose hex and binary every program\n");
        buf_str(out, c"    // using print_int would compile)\n");
        buf_str(out, c"    let negative = v < 0;\n");
        buf_str(out, c"    fmt_decimal(&f, if negative { (-(v + 1)) as u64 + 1 } else { v as u64 }, negative);\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A C string (up to its NUL).\n");
        buf_str(out, c"pub unsafe fn print_cstr(s: *u8) {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(1);\n");
        buf_str(out, c"    f.str(s[0..strlen(s) as i64]);\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Display, Debug and Fmt (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// x's Display on stderr.\n");
        buf_str(out, c"pub fn eprint<T: Display>(x: T) {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(2);\n");
        buf_str(out, c"    x.fmt(&f);\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn eprintln<T: Display>(x: T) {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(2);\n");
        buf_str(out, c"    x.fmt(&f);\n");
        buf_str(out, c"    f.byte('\\n');\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// x's Display in a new Buf on allocator a, of its length (the caller frees\n");
        buf_str(out, c"// it): `format_in(f\"{x:>8}\", gpa)`. (0.16: up to 256 bytes, x's Display\n");
        buf_str(out, c"// runs once, into a buffer on the stack.)\n");
        buf_str(out, c"pub fn format_in<T: Display, A: Allocator>(x: T, a: A) -> Buf<A> {\n");
        buf_str(out, c"    let mut tmp: [u8; 256] = [0; 256];\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(-1);\n");
        buf_str(out, c"    f.out = &tmp[0];\n");
        buf_str(out, c"    f.cap = 256;\n");
        buf_str(out, c"    x.fmt(&f);\n");
        buf_str(out, c"    let mut b: Buf<A> = Buf::new_in(a);\n");
        buf_str(out, c"    if f.need == 0 {\n");
        buf_str(out, c"        b.bytes.reserve(f.len);\n");
        buf_str(out, c"        b.bytes.extend_from_slice(tmp[0..f.len]);\n");
        buf_str(out, c"        return b;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    b.bytes.reserve(f.need);\n");
        buf_str(out, c"    b.push_fmt(x);\n");
        buf_str(out, c"    b\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[ambient(\"format_in(x, gpa)\")]\n");
        buf_str(out, c"pub fn format<T: Display>(x: T) -> Buf {\n");
        buf_str(out, c"    format_in(x, Gpa::ambient())\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Buf<A> {\n");
        buf_str(out, c"    // Appends x's Display: `b.push_fmt(f\"{k}={v};\")`. (0.16: into the room\n");
        buf_str(out, c"    // the Buf has; when the text does not fit, the Buf grows and x's\n");
        buf_str(out, c"    // Display runs again.)\n");
        buf_str(out, c"    pub fn push_fmt<T: Display>(self: *Buf<A>, x: T) {\n");
        buf_str(out, c"        let mut f = fmt_to_vec(&self.bytes);\n");
        buf_str(out, c"        loop {\n");
        buf_str(out, c"            x.fmt(&f);\n");
        buf_str(out, c"            if fmt_end_vec(&self.bytes, &f) {\n");
        buf_str(out, c"                return;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A Fmt writing into v's room.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_to_vec<A: Allocator>(v: *Vec<u8, A>) -> Fmt {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(-1);\n");
        buf_str(out, c"    f.out = v.ptr;\n");
        buf_str(out, c"    f.len = v.len;\n");
        buf_str(out, c"    f.cap = v.cap;\n");
        buf_str(out, c"    f\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The text f wrote into v's room is v's (true), or did not fit: v grows to\n");
        buf_str(out, c"// fit it, f starts again (false).\n");
        buf_str(out, c"fn fmt_end_vec<A: Allocator>(v: *Vec<u8, A>, f: *Fmt) -> bool {\n");
        buf_str(out, c"    if f.need == 0 {\n");
        buf_str(out, c"        v.len = f.len;\n");
        buf_str(out, c"        return true;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    v.reserve(f.need - v.len);\n");
        buf_str(out, c"    *f = fmt_to_vec(v);\n");
        buf_str(out, c"    false\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `{x}` in an f-string, and what print writes.\n");
        buf_str(out, c"pub trait Display { fn fmt(self: *Self, f: *Fmt); }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `{x:?}`: as the code that makes it.\n");
        buf_str(out, c"pub trait Debug { fn fmt_debug(self: *Self, f: *Fmt); }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A spec's flags (front/ast.tach's FMT_*): `<`, `>`, `0`, `x`, `X`, `b`,\n");
        buf_str(out, c"// `c`; spec adds FMT_PAD to a hole with a width or a precision, and a\n");
        buf_str(out, c"// number written first in such a hole adds FMT_NUM (right-aligned,\n");
        buf_str(out, c"// zero-padded after its sign, not cut by the precision).\n");
        buf_str(out, c"const FMT_LEFT: i64 = 1;\n");
        buf_str(out, c"const FMT_RIGHT: i64 = 2;\n");
        buf_str(out, c"const FMT_ZERO: i64 = 4;\n");
        buf_str(out, c"const FMT_HEX: i64 = 8;\n");
        buf_str(out, c"const FMT_UPPER: i64 = 16;\n");
        buf_str(out, c"const FMT_BIN: i64 = 32;\n");
        buf_str(out, c"const FMT_CHAR: i64 = 64;\n");
        buf_str(out, c"const FMT_NUM: i64 = 128;\n");
        buf_str(out, c"const FMT_PAD: i64 = 256;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The buffer of stdout and stderr: FMT_LEN bytes for FMT_FD; FMT_DONE\n");
        buf_str(out, c"// bytes were written out before them (FMT_DONE + FMT_LEN: the position a\n");
        buf_str(out, c"// spec marks).\n");
        buf_str(out, c"const FMT_CAP: i64 = 4096;\n");
        buf_str(out, c"static mut FMT_OUT: [u8; 4096] = [0; 4096];\n");
        buf_str(out, c"static mut FMT_LEN: i64 = 0;\n");
        buf_str(out, c"static mut FMT_FD: i32 = 1;\n");
        buf_str(out, c"static mut FMT_DONE: i64 = 0;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Writes the buffer out.\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_flush() {\n");
        buf_str(out, c"    let mut i = 0;\n");
        buf_str(out, c"    // (each round writes a byte at least)\n");
        buf_str(out, c"    for _ in 0..FMT_LEN {\n");
        buf_str(out, c"        if i >= FMT_LEN {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let rest = FMT_OUT[i..FMT_LEN];\n");
        buf_str(out, c"        let n = unsafe { write(FMT_FD, rest.ptr, rest.len as u64) };\n");
        buf_str(out, c"        if n <= 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i += n;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    FMT_DONE += FMT_LEN;\n");
        buf_str(out, c"    FMT_LEN = 0;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The next n bytes of f's destination, taken, when they fit (the Buf has\n");
        buf_str(out, c"// the room, the buffer holds FMT_FD's bytes); else an empty slice.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_room(f: *Fmt, n: i64) -> [u8] {\n");
        buf_str(out, c"    let at = f.len;\n");
        buf_str(out, c"    if at + n <= f.cap {\n");
        buf_str(out, c"        f.len = at + n;\n");
        buf_str(out, c"        return unsafe { f.out[at..at + n] };\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if f.fd == FMT_FD && FMT_LEN + n <= FMT_CAP {\n");
        buf_str(out, c"        let at = FMT_LEN;\n");
        buf_str(out, c"        FMT_LEN = at + n;\n");
        buf_str(out, c"        return FMT_OUT[at..at + n];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    \"\"\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// fmt_room when they do not fit (n: at most FMT_CAP): the buffer written\n");
        buf_str(out, c"// out first; to a Buf, an empty slice, the n bytes counted (fmt_lost). (A\n");
        buf_str(out, c"// Fmt's file descriptor or Buf is chosen inline, so that print compiles\n");
        buf_str(out, c"// only the file descriptor's functions.)\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_make_room(f: *Fmt, n: i64) -> [u8] {\n");
        buf_str(out, c"    if f.fd >= 0 { fmt_fd_room(f.fd, n) } else { fmt_lost(f, n) }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_fd_room(fd: i32, n: i64) -> [u8] {\n");
        buf_str(out, c"    if fd != FMT_FD || FMT_LEN + n > FMT_CAP {\n");
        buf_str(out, c"        fmt_flush();\n");
        buf_str(out, c"        FMT_FD = fd;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let at = FMT_LEN;\n");
        buf_str(out, c"    FMT_LEN = at + n;\n");
        buf_str(out, c"    FMT_OUT[at..at + n]\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// n bytes to a Buf that has no room for them: counted, not written (the\n");
        buf_str(out, c"// text is written again, push_fmt).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_lost(f: *Fmt, n: i64) -> [u8] {\n");
        buf_str(out, c"    let end = f.len + n;\n");
        buf_str(out, c"    if end > f.need {\n");
        buf_str(out, c"        f.need = end;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    f.len = end;\n");
        buf_str(out, c"    \"\"\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fmt::str (a call: an f-string's text is one).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_str(f: *Fmt, s: [u8]) {\n");
        buf_str(out, c"    if f.fd >= 0 {\n");
        buf_str(out, c"        fmt_str_fd(f.fd, s);\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        fmt_str_buf(f, s);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_str_fd(fd: i32, s: [u8]) {\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    let mut out: [u8] = \"\";\n");
        buf_str(out, c"    if fd == FMT_FD && FMT_LEN + n <= FMT_CAP {\n");
        buf_str(out, c"        let at = FMT_LEN;\n");
        buf_str(out, c"        FMT_LEN = at + n;\n");
        buf_str(out, c"        out = FMT_OUT[at..at + n];\n");
        buf_str(out, c"    } else if n > FMT_CAP {\n");
        buf_str(out, c"        // (written directly)\n");
        buf_str(out, c"        fmt_flush();\n");
        buf_str(out, c"        FMT_FD = fd;\n");
        buf_str(out, c"        let mut i = 0;\n");
        buf_str(out, c"        for _ in 0..n {\n");
        buf_str(out, c"            if i >= n {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let rest = s[i..n];\n");
        buf_str(out, c"            let k = unsafe { write(fd, rest.ptr, rest.len as u64) };\n");
        buf_str(out, c"            if k <= 0 {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            i += k;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        FMT_DONE += n;\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        out = fmt_fd_room(fd, n);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        memcpy(out.ptr, s.ptr, n as u64);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_str_buf(f: *Fmt, s: [u8]) {\n");
        buf_str(out, c"    let at = f.len;\n");
        buf_str(out, c"    let n = s.len;\n");
        buf_str(out, c"    if at + n <= f.cap {\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            memcpy(&f.out[at], s.ptr, n as u64);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.len = at + n;\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        fmt_lost(f, n);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fmt::byte when it does not fit.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_byte(f: *Fmt, b: u8) {\n");
        buf_str(out, c"    let out = fmt_make_room(f, 1);\n");
        buf_str(out, c"    if out.len == 1 {\n");
        buf_str(out, c"        out[0] = b;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// u's decimal digits, after a '-' when negative.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn fmt_decimal(f: *Fmt, u: u64, negative: bool) {\n");
        buf_str(out, c"    let len = if negative { decimal_len(u) + 1 } else { decimal_len(u) };\n");
        buf_str(out, c"    let mut out = fmt_room(f, len);\n");
        buf_str(out, c"    if out.len != len {\n");
        buf_str(out, c"        out = fmt_make_room(f, len);\n");
        buf_str(out, c"        if out.len != len {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        put_decimal(out.ptr, len, u, negative);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What Display and Debug write to: a file descriptor `fd` (through std's\n");
        buf_str(out, c"// buffer: `flush` writes it out), or (fd -1) the room out[len..cap] of a\n");
        buf_str(out, c"// Buf, `need` the length the text reached when it did not fit (0: it\n");
        buf_str(out, c"// fits). `width`, `prec` (-1: none) and `flags` are the spec of the hole\n");
        buf_str(out, c"// being written, `mark` the position it started at. (0.16: sealed; std's\n");
        buf_str(out, c"// functions make one.)\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct Fmt {\n");
        buf_str(out, c"    out: *u8, len: i64, cap: i64, need: i64, fd: i32, width: i64, prec: i64, flags: i64,\n");
        buf_str(out, c"    mark: i64,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Fmt {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn to_fd(fd: i32) -> Fmt {\n");
        buf_str(out, c"        Fmt {\n");
        buf_str(out, c"            out: 0 as *u8, len: 0, cap: 0, need: 0, fd: fd, width: -1, prec: -1, flags: 0, mark: 0\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn str(self: *Fmt, s: [u8]) {\n");
        buf_str(out, c"        fmt_str(self, s);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn byte(self: *Fmt, b: u8) {\n");
        buf_str(out, c"        let at = self.len;\n");
        buf_str(out, c"        if at < self.cap {\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                self.out[at] = b;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.len = at + 1;\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if self.fd == FMT_FD && FMT_LEN < FMT_CAP {\n");
        buf_str(out, c"            let out: *u8 = &FMT_OUT[0];\n");
        buf_str(out, c"            unsafe {\n");
        buf_str(out, c"                out[FMT_LEN] = b;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            FMT_LEN += 1;\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        fmt_byte(self, b);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Writes out what a Fmt to a file descriptor has buffered (print does).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn flush(self: *Fmt) {\n");
        buf_str(out, c"        if self.fd >= 0 {\n");
        buf_str(out, c"            fmt_flush();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // x's Display: `f.write(f\"({self.x}, {self.y})\")` in a Display impl.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn write<T: Display>(self: *Fmt, x: T) {\n");
        buf_str(out, c"        x.fmt(self);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn display<T: Display>(self: *Fmt, x: *T) {\n");
        buf_str(out, c"        x.fmt(self);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn debug<T: Debug>(self: *Fmt, x: *T) {\n");
        buf_str(out, c"        x.fmt_debug(self);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The position written to.\n");
        buf_str(out, c"    fn pos(self: *Fmt) -> i64 {\n");
        buf_str(out, c"        if self.fd >= 0 { FMT_DONE + FMT_LEN } else { self.len }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Starts a hole with a spec (width w, precision p, -1: none; FMT_*\n");
        buf_str(out, c"    // flags): what is written up to end_spec, given the result, is padded\n");
        buf_str(out, c"    // to w. The buffer is first written out unless w bytes fit in it, so\n");
        buf_str(out, c"    // the hole's text is either all in it or at least w long.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn spec(self: *Fmt, w: i64, p: i64, flags: i64) -> FmtSpec {\n");
        buf_str(out, c"        let old = FmtSpec {\n");
        buf_str(out, c"            width: self.width, prec: self.prec, flags: self.flags, mark: self.mark\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        self.flags = flags;\n");
        buf_str(out, c"        if w > 0 || p >= 0 {\n");
        buf_str(out, c"            if self.fd >= 0 && (self.fd != FMT_FD || FMT_CAP - FMT_LEN < w) {\n");
        buf_str(out, c"                fmt_flush();\n");
        buf_str(out, c"                FMT_FD = self.fd;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            self.width = w;\n");
        buf_str(out, c"            self.prec = p;\n");
        buf_str(out, c"            self.flags = flags | FMT_PAD;\n");
        buf_str(out, c"            self.mark = self.pos();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        old\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Ends the hole `spec` started (`old`: what it returned).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn end_spec(self: *Fmt, old: FmtSpec) {\n");
        buf_str(out, c"        if (self.flags & FMT_PAD) != 0 {\n");
        buf_str(out, c"            fmt_pad(self);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.width = old.width;\n");
        buf_str(out, c"        self.prec = old.prec;\n");
        buf_str(out, c"        self.flags = old.flags;\n");
        buf_str(out, c"        self.mark = old.mark;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // v in decimal (x, X, b: in hex or binary, as a u64; c: its low byte).\n");
        buf_str(out, c"    #[inline(never)]\n");
        buf_str(out, c"    pub fn int(self: *Fmt, v: i64) {\n");
        buf_str(out, c"        if self.flags != 0 {\n");
        buf_str(out, c"            if (self.flags & (FMT_HEX | FMT_BIN | FMT_CHAR)) != 0 {\n");
        buf_str(out, c"                fmt_radix(self, v as u64);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                let negative = v < 0;\n");
        buf_str(out, c"                fmt_spec_decimal(self, if negative { (-(v + 1)) as u64 + 1 } else { v as u64 },\n");
        buf_str(out, c"                    negative);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let negative = v < 0;\n");
        buf_str(out, c"        fmt_decimal(self, if negative { (-(v + 1)) as u64 + 1 } else { v as u64 }, negative);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // v in decimal, hex (x, X), binary (b), or as a byte (c).\n");
        buf_str(out, c"    #[inline(never)]\n");
        buf_str(out, c"    pub fn uint(self: *Fmt, v: u64) {\n");
        buf_str(out, c"        if self.flags != 0 {\n");
        buf_str(out, c"            if (self.flags & (FMT_HEX | FMT_BIN | FMT_CHAR)) != 0 {\n");
        buf_str(out, c"                fmt_radix(self, v);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                fmt_spec_decimal(self, v, false);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        fmt_decimal(self, v, false);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // v as Display writes it: the shortest decimal that reads back as v,\n");
        buf_str(out, c"    // never with an exponent; with a precision, that many decimals.\n");
        buf_str(out, c"    pub fn float(self: *Fmt, v: f64) {\n");
        buf_str(out, c"        fmt_float(self, v, false, false);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fmt::int and Fmt::uint with a spec of a decimal: u, after a '-' when\n");
        buf_str(out, c"// negative.\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_spec_decimal(f: *Fmt, u: u64, negative: bool) {\n");
        buf_str(out, c"    fmt_number_start(f);\n");
        buf_str(out, c"    fmt_decimal(f, u, negative);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A number starts here: when nothing of the hole is written yet, the hole\n");
        buf_str(out, c"// is a number's (right-aligned, zero-padded after the sign).\n");
        buf_str(out, c"fn fmt_number_start(f: *Fmt) {\n");
        buf_str(out, c"    if (f.flags & FMT_PAD) != 0 && f.pos() == f.mark {\n");
        buf_str(out, c"        f.flags |= FMT_NUM;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// v in hex or binary, or its low byte (c).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_radix(f: *Fmt, v: u64) {\n");
        buf_str(out, c"    let flags = f.flags;\n");
        buf_str(out, c"    if (flags & FMT_CHAR) != 0 {\n");
        buf_str(out, c"        f.byte(v as u8);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    fmt_number_start(f);\n");
        buf_str(out, c"    let shift: u64 = if (flags & FMT_HEX) != 0 { 4 } else { 1 };\n");
        buf_str(out, c"    let mask = (1u64 << shift) - 1;\n");
        buf_str(out, c"    let digits = if (flags & FMT_UPPER) != 0 { \"0123456789ABCDEF\" } else { \"0123456789abcdef\" };\n");
        buf_str(out, c"    let mut n = 1;\n");
        buf_str(out, c"    let mut bits = shift;\n");
        buf_str(out, c"    for _ in 0..64 {\n");
        buf_str(out, c"        if bits >= 64 || (v >> bits) == 0 {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        n += 1;\n");
        buf_str(out, c"        bits += shift;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut out = fmt_room(f, n);\n");
        buf_str(out, c"    if out.len != n {\n");
        buf_str(out, c"        out = fmt_make_room(f, n);\n");
        buf_str(out, c"        if out.len != n {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut u = v;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let p = out.ptr;\n");
        buf_str(out, c"        for k in 0..n {\n");
        buf_str(out, c"            p[n - 1 - k] = digits.ptr[(u & mask) as i64];\n");
        buf_str(out, c"            u = u >> shift;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A signed integer of `bits` bits: in hex or binary as its unsigned value\n");
        buf_str(out, c"// of that size (Rust's `{:x}` of -1i8 is ff).\n");
        buf_str(out, c"fn fmt_signed(f: *Fmt, v: i64, bits: u64) {\n");
        buf_str(out, c"    if v < 0 && (f.flags & (FMT_HEX | FMT_BIN)) != 0 {\n");
        buf_str(out, c"        f.uint((v as u64) & ((1u64 << bits) - 1));\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        f.int(v);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The padding and truncation of the hole f.spec started.\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_pad(f: *Fmt) {\n");
        buf_str(out, c"    let flags = f.flags;\n");
        buf_str(out, c"    let start = f.mark;\n");
        buf_str(out, c"    let mut end = f.pos();\n");
        buf_str(out, c"    let number = (flags & FMT_NUM) != 0;\n");
        buf_str(out, c"    let reach = if f.fd >= 0 { start >= FMT_DONE && f.fd == FMT_FD } else { true };\n");
        buf_str(out, c"    // (a precision cuts text)\n");
        buf_str(out, c"    if f.prec >= 0 && !number && end - start > f.prec && reach {\n");
        buf_str(out, c"        end = start + f.prec;\n");
        buf_str(out, c"        if f.fd >= 0 {\n");
        buf_str(out, c"            FMT_LEN = end - FMT_DONE;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            f.len = end;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let pad = f.width - (end - start);\n");
        buf_str(out, c"    if pad <= 0 {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if (flags & FMT_LEFT) != 0 || (flags & FMT_RIGHT) == 0 && !number {\n");
        buf_str(out, c"        for i in 0..pad {\n");
        buf_str(out, c"            f.byte(' ');\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if !reach {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // Right-aligned: the text moves right by pad, after the sign when zeros\n");
        buf_str(out, c"    // fill.\n");
        buf_str(out, c"    let zeros = number && (flags & FMT_ZERO) != 0;\n");
        buf_str(out, c"    let mut text: *u8 = 0 as *u8;\n");
        buf_str(out, c"    let mut base = 0;\n");
        buf_str(out, c"    if f.fd >= 0 {\n");
        buf_str(out, c"        // (spec made room for the width)\n");
        buf_str(out, c"        text = &FMT_OUT[0];\n");
        buf_str(out, c"        base = FMT_DONE;\n");
        buf_str(out, c"        FMT_LEN += pad;\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        // (when the text was lost or the room is short: counted)\n");
        buf_str(out, c"        if f.need != 0 || f.len + pad > f.cap {\n");
        buf_str(out, c"            fmt_lost(f, pad);\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        text = f.out;\n");
        buf_str(out, c"        f.len += pad;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut at = start - base;\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        if zeros && end > start && (text[at] == '-' || text[at] == '+') {\n");
        buf_str(out, c"            at += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let count = end - base - at;\n");
        buf_str(out, c"        for k in 0..count {\n");
        buf_str(out, c"            let i = count - 1 - k;\n");
        buf_str(out, c"            text[at + pad + i] = text[at + i];\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for k in 0..pad {\n");
        buf_str(out, c"            text[at + k] = if zeros { '0' } else { ' ' };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// v in decimal (single: an f32's value): the shortest digits that read\n");
        buf_str(out, c"// back as v (15 to 17 of them, 6 to 9 for an f32), never with an exponent\n");
        buf_str(out, c"// for Display; Debug as Rust writes it (`1.0`, `1e16`, `1e-7`). With a\n");
        buf_str(out, c"// precision, that many decimals (C's %.Nf).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_float(f: *Fmt, v: f64, single: bool, debug: bool) {\n");
        buf_str(out, c"    if f.flags != 0 {\n");
        buf_str(out, c"        fmt_number_start(f);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if v != v {\n");
        buf_str(out, c"        f.str(\"NaN\");\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if v - v != 0.0 {\n");
        buf_str(out, c"        f.str(if v > 0.0 { \"inf\" } else { \"-inf\" });\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut tmp: [u8; 64] = [0; 64];\n");
        buf_str(out, c"    if f.prec >= 0 {\n");
        buf_str(out, c"        let n = unsafe { snprintf(&tmp[0], 64, c\"%.*f\", f.prec as i32, v) } as i64;\n");
        buf_str(out, c"        if n < 64 {\n");
        buf_str(out, c"            f.str(tmp[0..n]);\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            fmt_fixed_long(f, v);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut digits = if single { 6 } else { 15 };\n");
        buf_str(out, c"    let last = if single { 9 } else { 17 };\n");
        buf_str(out, c"    let mut n = 0;\n");
        buf_str(out, c"    // (from 6 or 15 digits to 9 or 17)\n");
        buf_str(out, c"    for _ in 0..4 {\n");
        buf_str(out, c"        n = unsafe { snprintf(&tmp[0], 64, c\"%.*e\", (digits - 1) as i32, v) } as i64;\n");
        buf_str(out, c"        if digits == last {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let same = if single {\n");
        buf_str(out, c"            let back = unsafe { strtof(&tmp[0], 0 as **u8) };\n");
        buf_str(out, c"            back == v as f32\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            let back = unsafe { strtod(&tmp[0], 0 as **u8) };\n");
        buf_str(out, c"            back == v\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        if same {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        digits += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    // tmp: [-]d[.ddd]e(+|-)dd: the digits (without the point) and the\n");
        buf_str(out, c"    // exponent of the first.\n");
        buf_str(out, c"    let mut i = 0;\n");
        buf_str(out, c"    let negative = tmp[0] == '-';\n");
        buf_str(out, c"    if negative {\n");
        buf_str(out, c"        i = 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut ds: [u8; 24] = [0; 24];\n");
        buf_str(out, c"    let mut k = 0;\n");
        buf_str(out, c"    for _ in i..n {\n");
        buf_str(out, c"        if tmp[i] == 'e' {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if tmp[i] != '.' {\n");
        buf_str(out, c"            ds[k] = tmp[i];\n");
        buf_str(out, c"            k += 1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    for _ in 1..k {\n");
        buf_str(out, c"        if ds[k - 1] != '0' {\n");
        buf_str(out, c"            break;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        k -= 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    i += 1;\n");
        buf_str(out, c"    let exp_negative = tmp[i] == '-';\n");
        buf_str(out, c"    i += 1;\n");
        buf_str(out, c"    let mut exp = 0;\n");
        buf_str(out, c"    for _ in i..n {\n");
        buf_str(out, c"        exp = exp * 10 + (tmp[i] - '0') as i64;\n");
        buf_str(out, c"        i += 1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if exp_negative {\n");
        buf_str(out, c"        exp = -exp;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if negative {\n");
        buf_str(out, c"        f.byte('-');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if debug && (exp < -4 || exp >= 16) {\n");
        buf_str(out, c"        f.byte(ds[0]);\n");
        buf_str(out, c"        if k > 1 {\n");
        buf_str(out, c"            f.byte('.');\n");
        buf_str(out, c"            f.str(ds[1..k]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.byte('e');\n");
        buf_str(out, c"        f.int(exp);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if exp < 0 {\n");
        buf_str(out, c"        f.str(\"0.\");\n");
        buf_str(out, c"        for z in 0..-exp - 1 {\n");
        buf_str(out, c"            f.byte('0');\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.str(ds[0..k]);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if k <= exp + 1 {\n");
        buf_str(out, c"        f.str(ds[0..k]);\n");
        buf_str(out, c"        for z in 0..exp + 1 - k {\n");
        buf_str(out, c"            f.byte('0');\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if debug {\n");
        buf_str(out, c"            f.str(\".0\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    f.str(ds[0..exp + 1]);\n");
        buf_str(out, c"    f.byte('.');\n");
        buf_str(out, c"    f.str(ds[exp + 1..k]);\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// v with f's precision, of 64 bytes or more: C's %.*f into a buffer on\n");
        buf_str(out, c"// the stack (a double has at most 309 digits before the point and 1074\n");
        buf_str(out, c"// after it: from 1100 decimals on they are zeros, written after).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_fixed_long(f: *Fmt, v: f64) {\n");
        buf_str(out, c"    let prec = if f.prec > 1100 { 1100 } else { f.prec };\n");
        buf_str(out, c"    let mut tmp: [u8; 1424] = [0; 1424];\n");
        buf_str(out, c"    let n = unsafe { snprintf(&tmp[0], 1424, c\"%.*f\", prec as i32, v) } as i64;\n");
        buf_str(out, c"    f.str(tmp[0..if n < 1424 { n } else { 1423 }]);\n");
        buf_str(out, c"    for _ in prec..f.prec {\n");
        buf_str(out, c"        f.byte('0');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Text in quotes, escaped as Rust's Debug of a str does.\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_quoted(f: *Fmt, s: [u8]) {\n");
        buf_str(out, c"    f.byte('\"');\n");
        buf_str(out, c"    let mut from = 0;\n");
        buf_str(out, c"    for i in 0..s.len {\n");
        buf_str(out, c"        let c = s[i];\n");
        buf_str(out, c"        if c == '\"' || c == '\\\\' || c < 32 || c == 127 {\n");
        buf_str(out, c"            f.str(s[from..i]);\n");
        buf_str(out, c"            from = i + 1;\n");
        buf_str(out, c"            f.byte('\\\\');\n");
        buf_str(out, c"            if c == '\\n' {\n");
        buf_str(out, c"                f.byte('n');\n");
        buf_str(out, c"            } else if c == '\\t' {\n");
        buf_str(out, c"                f.byte('t');\n");
        buf_str(out, c"            } else if c == '\\r' {\n");
        buf_str(out, c"                f.byte('r');\n");
        buf_str(out, c"            } else if c == 0 {\n");
        buf_str(out, c"                f.byte('0');\n");
        buf_str(out, c"            } else if c == '\"' || c == '\\\\' {\n");
        buf_str(out, c"                f.byte(c);\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                let hex = \"0123456789abcdef\";\n");
        buf_str(out, c"                f.str(\"u{\");\n");
        buf_str(out, c"                if c >= 16 {\n");
        buf_str(out, c"                    f.byte(hex[(c >> 4) as i64]);\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                f.byte(hex[(c & 15) as i64]);\n");
        buf_str(out, c"                f.byte('}');\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    f.str(s[from..s.len]);\n");
        buf_str(out, c"    f.byte('\"');\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The elements of s, as Debug writes a Vec: `[1, 2, 3]`.\n");
        buf_str(out, c"pub fn debug_list<T: Debug>(f: *Fmt, s: [T]) {\n");
        buf_str(out, c"    f.byte('[');\n");
        buf_str(out, c"    for i in 0..s.len {\n");
        buf_str(out, c"        if i > 0 {\n");
        buf_str(out, c"            f.str(\", \");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let x = s[i];\n");
        buf_str(out, c"        f.debug(&x);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    f.byte(']');\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An f-string's value: its holes' values, and a closure that writes the\n");
        buf_str(out, c"// text.\n");
        buf_str(out, c"pub struct Interp<F> { f: F }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<F: Fn(*Fmt)> Display for Interp<F> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *Interp<F>, out: *Fmt) {\n");
        buf_str(out, c"        (self.f)(out);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Fmt's holes (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The spec of the hole a Fmt was writing, which Fmt::spec saves and\n");
        buf_str(out, c"// end_spec puts back (0.16).\n");
        buf_str(out, c"pub struct FmtSpec { width: i64, prec: i64, flags: i64, mark: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Fmt {\n");
        buf_str(out, c"    // An f-string's hole of a decimal integer with a spec of width w and\n");
        buf_str(out, c"    // flags (`{n:>5}`, `{n:05}`): what spec, int and end_spec write, in one\n");
        buf_str(out, c"    // pass (0.16).\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn int_hole(self: *Fmt, v: i64, w: i64, flags: i64) {\n");
        buf_str(out, c"        let negative = v < 0;\n");
        buf_str(out, c"        fmt_hole(self, if negative { (-(v + 1)) as u64 + 1 } else { v as u64 }, negative, w,\n");
        buf_str(out, c"            flags);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    pub fn uint_hole(self: *Fmt, v: u64, w: i64, flags: i64) {\n");
        buf_str(out, c"        fmt_hole(self, v, false, w, flags);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Fmt::int_hole: u (after a '-' when negative) padded to w: with spaces\n");
        buf_str(out, c"// before it (after it: FMT_LEFT), or zeros after its sign (FMT_ZERO).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"fn fmt_hole(f: *Fmt, u: u64, negative: bool, w: i64, flags: i64) {\n");
        buf_str(out, c"    let n = if negative { decimal_len(u) + 1 } else { decimal_len(u) };\n");
        buf_str(out, c"    let pad = w - n;\n");
        buf_str(out, c"    if pad <= 0 {\n");
        buf_str(out, c"        fmt_decimal(f, u, negative);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if w > FMT_CAP {\n");
        buf_str(out, c"        // (as spec and end_spec do)\n");
        buf_str(out, c"        let old = f.spec(w, -1, flags);\n");
        buf_str(out, c"        fmt_number_start(f);\n");
        buf_str(out, c"        fmt_decimal(f, u, negative);\n");
        buf_str(out, c"        f.end_spec(old);\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut out = fmt_room(f, w);\n");
        buf_str(out, c"    if out.len != w {\n");
        buf_str(out, c"        out = fmt_make_room(f, w);\n");
        buf_str(out, c"        if out.len != w {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let p = out.ptr;\n");
        buf_str(out, c"        if (flags & FMT_LEFT) != 0 {\n");
        buf_str(out, c"            put_decimal(p, n, u, negative);\n");
        buf_str(out, c"            for k in n..w {\n");
        buf_str(out, c"                p[k] = ' ';\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            put_decimal(&p[pad], n, u, negative);\n");
        buf_str(out, c"            let fill: u8 = if (flags & FMT_ZERO) != 0 { '0' } else { ' ' };\n");
        buf_str(out, c"            for k in 0..pad {\n");
        buf_str(out, c"                p[k] = fill;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            if negative && fill == '0' {\n");
        buf_str(out, c"                p[0] = '-';\n");
        buf_str(out, c"                p[pad] = '0';\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Display and Debug of std's types (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for i8 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *i8, f: *Fmt) { fmt_signed(f, *self as i64, 8); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for i8 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: *i8, f: *Fmt) { fmt_signed(f, *self as i64, 8); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for i16 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *i16, f: *Fmt) { fmt_signed(f, *self as i64, 16); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for i16 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: *i16, f: *Fmt) { fmt_signed(f, *self as i64, 16); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for i32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *i32, f: *Fmt) { fmt_signed(f, *self as i64, 32); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for i32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: *i32, f: *Fmt) { fmt_signed(f, *self as i64, 32); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for i64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *i64, f: *Fmt) { f.int(*self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for i64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: *i64, f: *Fmt) { f.int(*self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (a number, as in Rust: `{c:c}` writes the byte)\n");
        buf_str(out, c"impl Display for u8 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *u8, f: *Fmt) { f.uint(*self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for u8 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: *u8, f: *Fmt) { f.uint(*self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for u16 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *u16, f: *Fmt) { f.uint(*self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for u16 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: *u16, f: *Fmt) { f.uint(*self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for u32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *u32, f: *Fmt) { f.uint(*self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for u32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: *u32, f: *Fmt) { f.uint(*self as u64); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for u64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *u64, f: *Fmt) { f.uint(*self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for u64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: *u64, f: *Fmt) { f.uint(*self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for f64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *f64, f: *Fmt) { fmt_float(f, *self, false, false); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for f64 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: *f64, f: *Fmt) { fmt_float(f, *self, false, true); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for f32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *f32, f: *Fmt) { fmt_float(f, *self as f64, true, false); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for f32 {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: *f32, f: *Fmt) { fmt_float(f, *self as f64, true, true); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for bool {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *bool, f: *Fmt) { f.str(if *self { \"true\" } else { \"false\" }); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for bool {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: *bool, f: *Fmt) { f.str(if *self { \"true\" } else { \"false\" }); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for [u8] {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *[u8], f: *Fmt) { f.str(*self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (quoted and escaped: `\"a\\n\"`)\n");
        buf_str(out, c"impl Debug for [u8] {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: *[u8], f: *Fmt) { fmt_quoted(f, *self); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Display for Buf<A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt(self: *Buf<A>, f: *Fmt) { f.str(self.as_slice()); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Debug for Buf<A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn fmt_debug(self: *Buf<A>, f: *Fmt) { fmt_quoted(f, self.as_slice()); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Debug> Debug for Option<T> {\n");
        buf_str(out, c"    fn fmt_debug(self: *Option<T>, f: *Fmt) {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            Option::Some(x) => {\n");
        buf_str(out, c"                f.str(\"Some(\");\n");
        buf_str(out, c"                f.debug(&x);\n");
        buf_str(out, c"                f.byte(')');\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Option::None => f.str(\"None\"),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Debug, E: Debug> Debug for Result<T, E> {\n");
        buf_str(out, c"    fn fmt_debug(self: *Result<T, E>, f: *Fmt) {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            Result::Ok(x) => {\n");
        buf_str(out, c"                f.str(\"Ok(\");\n");
        buf_str(out, c"                f.debug(&x);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            Result::Err(e) => {\n");
        buf_str(out, c"                f.str(\"Err(\");\n");
        buf_str(out, c"                f.debug(&e);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.byte(')');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Debug, A: Allocator> Debug for Vec<T, A> {\n");
        buf_str(out, c"    fn fmt_debug(self: *Vec<T, A>, f: *Fmt) { debug_list(f, self.as_slice()); }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (0.16: `Ok(())`)\n");
        buf_str(out, c"impl Debug for () {\n");
        buf_str(out, c"    fn fmt_debug(self: *(), f: *Fmt) {\n");
        buf_str(out, c"        f.str(\"()\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Debug of HashMap (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `{k: v, ...}`, in slot order.\n");
        buf_str(out, c"impl<K: Hash + Eq + Debug, V: Debug, A: Allocator> Debug for HashMap<K, V, A> {\n");
        buf_str(out, c"    fn fmt_debug(self: *HashMap<K, V, A>, f: *Fmt) {\n");
        buf_str(out, c"        f.byte('{');\n");
        buf_str(out, c"        let mut first = true;\n");
        buf_str(out, c"        for i in 0..self.slots() {\n");
        buf_str(out, c"            if let Option::Some(k) = self.key_at(i) {\n");
        buf_str(out, c"                if !first {\n");
        buf_str(out, c"                    f.str(\", \");\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"                first = false;\n");
        buf_str(out, c"                let v = self.value_at(i).unwrap();\n");
        buf_str(out, c"                f.debug(&k);\n");
        buf_str(out, c"                f.str(\": \");\n");
        buf_str(out, c"                f.debug(&v);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        f.byte('}');\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Conversions (0.15) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach: the same module,\n");
        buf_str(out, c"// `std`. From and Into, the traits of conversions\n");
        buf_str(out, c"// (docs/design/errors-formatting.md). Every type converts from itself,\n");
        buf_str(out, c"// and an integer type from the integer types that widen to it, without\n");
        buf_str(out, c"// an impl; Into is the compiler's: `let y: U = x.into()` is `U::from(x)`.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `AppError::from(e)`; what `?` converts an error with.\n");
        buf_str(out, c"pub trait From<T> { fn from(x: T) -> Self; }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Implement From, not Into.\n");
        buf_str(out, c"pub trait Into<T> { fn into(self: Self) -> T; }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T> Option<T> {\n");
        buf_str(out, c"    // Some(x) is Ok(x), None the error `err`: `opt.ok_or(E::Missing)?`.\n");
        buf_str(out, c"    pub fn ok_or<E>(self: Option<T>, err: E) -> Result<T, E> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => Result::Ok(x),\n");
        buf_str(out, c"            Option::None => Result::Err(err),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn map<U, F: Fn(T) -> U>(self: Option<T>, f: F) -> Option<U> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => Option::Some(f(x)),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn and_then<U, F: Fn(T) -> Option<U>>(self: Option<T>, f: F) -> Option<U> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => f(x),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap_or_else<F: Fn() -> T>(self: Option<T>, f: F) -> T {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Option::Some(x) => x,\n");
        buf_str(out, c"            Option::None => f(),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T, E> Result<T, E> {\n");
        buf_str(out, c"    pub fn map<U, F: Fn(T) -> U>(self: Result<T, E>, f: F) -> Result<U, E> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => Result::Ok(f(x)),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The error converted: `r.map_err(AppError::Io)?`, `r.map_err(|e| ...)`.\n");
        buf_str(out, c"    pub fn map_err<G, F: Fn(E) -> G>(self: Result<T, E>, f: F) -> Result<T, G> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => Result::Ok(x),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(f(e)),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn err(self: Result<T, E>) -> Option<E> {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(_) => Option::None,\n");
        buf_str(out, c"            Result::Err(e) => Option::Some(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn unwrap_or_else<F: Fn(E) -> T>(self: Result<T, E>, f: F) -> T {\n");
        buf_str(out, c"        match self {\n");
        buf_str(out, c"            Result::Ok(x) => x,\n");
        buf_str(out, c"            Result::Err(e) => f(e),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// (No string literals below: std's literals are in every program that\n");
        buf_str(out, c"// loads std, used or not.)\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What a `main` returning `Result<(), E>` does with an Err: `Error: {e:?}` and\n");
        buf_str(out, c"// a newline on stderr, then exit status 1 (the compiler calls it).\n");
        buf_str(out, c"pub fn main_error<E: Debug>(e: E) -> i32 {\n");
        buf_str(out, c"    let mut f = Fmt::to_fd(2);\n");
        buf_str(out, c"    let head: [u8; 7] = ['E', 'r', 'r', 'o', 'r', ':', ' '];\n");
        buf_str(out, c"    f.str(head[..]);\n");
        buf_str(out, c"    f.debug(&e);\n");
        buf_str(out, c"    f.byte('\\n');\n");
        buf_str(out, c"    f.flush();\n");
        buf_str(out, c"    1\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Clone and hashing (0.15) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// compiler/std/embed.sh appends this file to std.tach: the same module,\n");
        buf_str(out, c"// `std`. Clone, and the helpers `#[derive(Eq, Ord, Hash, Clone)]` calls on\n");
        buf_str(out, c"// each field (docs/design/errors-formatting.md). Numbers, bool, pointers,\n");
        buf_str(out, c"// slices, fn types, fieldless enums, and tuples and arrays of them clone\n");
        buf_str(out, c"// by copying, without an impl; tuples of Eq, Ord, Hash or Clone types are\n");
        buf_str(out, c"// Eq, Ord (lexicographic), Hash and Clone (element-wise), through the\n");
        buf_str(out, c"// functions at the end of this file, which the compiler calls.\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A copy owning its memory (a Vec's elements are cloned).\n");
        buf_str(out, c"pub trait Clone { fn clone(self: *Self) -> Self; }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Hash h of the fields so far, with the hash x of the next one mixed in.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn hash_mix(h: u64, x: u64) -> u64 {\n");
        buf_str(out, c"    hash_u64(h ^ (x + 0x9e3779b97f4a7c15u64 + (h << 6) + (h >> 2)))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `*a == *b`: structural, or the type's Eq impl (`[u8]`: by bytes).\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn eq_of<T: Eq>(a: *T, b: *T) -> bool {\n");
        buf_str(out, c"    *a == *b\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `a.cmp(b)`: negative, zero or positive as *a goes before, with or after\n");
        buf_str(out, c"// *b.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn cmp_of<T: Ord>(a: *T, b: *T) -> i64 {\n");
        buf_str(out, c"    a.cmp(b)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `x.hash()`.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn hash_of<T: Hash>(x: *T) -> u64 {\n");
        buf_str(out, c"    x.hash()\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// `x.clone()`.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"pub fn clone_of<T: Clone>(x: *T) -> T {\n");
        buf_str(out, c"    x.clone()\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A new Vec of clones of the elements, on the same allocator.\n");
        buf_str(out, c"impl<T: Clone, A: Allocator> Clone for Vec<T, A> {\n");
        buf_str(out, c"    fn clone(self: *Vec<T, A>) -> Vec<T, A> {\n");
        buf_str(out, c"        self.clone_in(self.alloc)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Clone, A: Allocator> Vec<T, A> {\n");
        buf_str(out, c"    // A new Vec of clones of the elements, on allocator b (0.16).\n");
        buf_str(out, c"    pub fn clone_in<B: Allocator>(self: *Vec<T, A>, b: B) -> Vec<T, B> {\n");
        buf_str(out, c"        let s = self.as_slice();\n");
        buf_str(out, c"        let mut v: Vec<T, B> = Vec::with_capacity_in(s.len, b);\n");
        buf_str(out, c"        for i in 0..s.len {\n");
        buf_str(out, c"            v.push(clone_of(&s[i]));\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        v\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<A: Allocator> Clone for Buf<A> {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn clone(self: *Buf<A>) -> Buf<A> {\n");
        buf_str(out, c"        let mut b: Buf<A> = Buf::new_in(self.bytes.alloc);\n");
        buf_str(out, c"        b.push_str(self.as_slice());\n");
        buf_str(out, c"        b\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A new map of clones of the entries.\n");
        buf_str(out, c"impl<K: Hash + Eq + Clone, V: Clone, A: Allocator> Clone for HashMap<K, V, A> {\n");
        buf_str(out, c"    fn clone(self: *HashMap<K, V, A>) -> HashMap<K, V, A> {\n");
        buf_str(out, c"        let mut m: HashMap<K, V, A> = HashMap::new_in(self.alloc);\n");
        buf_str(out, c"        for i in 0..self.slots() {\n");
        buf_str(out, c"            if let Option::Some(k) = self.key_at(i) {\n");
        buf_str(out, c"                let v = self.value_at(i).unwrap();\n");
        buf_str(out, c"                m.insert(clone_of(&k), clone_of(&v));\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        m\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Clone> Clone for Option<T> {\n");
        buf_str(out, c"    fn clone(self: *Option<T>) -> Option<T> {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            Option::Some(x) => Option::Some(clone_of(&x)),\n");
        buf_str(out, c"            Option::None => Option::None,\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Clone, E: Clone> Clone for Result<T, E> {\n");
        buf_str(out, c"    fn clone(self: *Result<T, E>) -> Result<T, E> {\n");
        buf_str(out, c"        match *self {\n");
        buf_str(out, c"            Result::Ok(x) => Result::Ok(clone_of(&x)),\n");
        buf_str(out, c"            Result::Err(e) => Result::Err(clone_of(&e)),\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- == on Vec (0.15) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// `==` compares contents, as Rust's: Vecs element by element (so a Buf,\n");
        buf_str(out, c"// whose bytes are a Vec, by bytes), maps by their entries in any order.\n");
        buf_str(out, c"// Whether two values are the same Vec: `a.as_slice().ptr == b.as_slice().ptr`.\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<T: Eq, A: Allocator> Eq for Vec<T, A> {\n");
        buf_str(out, c"    fn eq(self: *Vec<T, A>, other: *Vec<T, A>) -> bool {\n");
        buf_str(out, c"        self.as_slice() == other.as_slice()\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- == on HashMap (0.15) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl<K: Hash + Eq, V: Eq, A: Allocator> Eq for HashMap<K, V, A> {\n");
        buf_str(out, c"    fn eq(self: *HashMap<K, V, A>, other: *HashMap<K, V, A>) -> bool {\n");
        buf_str(out, c"        if self.len() != other.len() {\n");
        buf_str(out, c"            return false;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for i in 0..self.slots() {\n");
        buf_str(out, c"            if let Option::Some(k) = self.key_at(i) {\n");
        buf_str(out, c"                let v = self.value_at(i).unwrap();\n");
        buf_str(out, c"                match other.get(k) {\n");
        buf_str(out, c"                    Option::Some(w) => if !(v == w) { return false; },\n");
        buf_str(out, c"                    Option::None => return false,\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Clone, Eq, Ord and Hash without an impl (0.15) ----\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// `x.clone()` on a type that copies (a number, bool, pointer, slice, fn,\n");
        buf_str(out, c"// fieldless enum, or a tuple or array of them) is copy_clone; `x.cmp(&y)`\n");
        buf_str(out, c"// on a float, pointer or fieldless enum is scalar_cmp; on a tuple of 2 to\n");
        buf_str(out, c"// 6 elements, `eq` (== when the structural one does not apply), `cmp` (<),\n");
        buf_str(out, c"// `hash` and `clone` are tupleN_eq, tupleN_cmp, tupleN_hash and\n");
        buf_str(out, c"// tupleN_clone (front/derive/intrinsic.tach). They are private: the\n");
        buf_str(out, c"// compiler calls them.\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn copy_clone<T>(self: *T) -> T {\n");
        buf_str(out, c"    *self\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn scalar_cmp<T>(self: *T, other: *T) -> i64 {\n");
        buf_str(out, c"    if *self < *other { -1 } else if *other < *self { 1 } else { 0 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple2_cmp<A: Ord, B: Ord>(self: *(A, B), other: *(A, B)) -> i64 {\n");
        buf_str(out, c"    let c = cmp_of(&(*self).0, &(*other).0);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    cmp_of(&(*self).1, &(*other).1)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple3_cmp<A: Ord, B: Ord, C: Ord>(self: *(A, B, C), other: *(A, B, C)) -> i64 {\n");
        buf_str(out, c"    let mut c = cmp_of(&(*self).0, &(*other).0);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).1, &(*other).1);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    cmp_of(&(*self).2, &(*other).2)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple4_cmp<A: Ord, B: Ord, C: Ord,\n");
        buf_str(out, c"D: Ord>(self: *(A, B, C, D), other: *(A, B, C, D)) -> i64 {\n");
        buf_str(out, c"    let mut c = cmp_of(&(*self).0, &(*other).0);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).1, &(*other).1);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).2, &(*other).2);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    cmp_of(&(*self).3, &(*other).3)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple5_cmp<A: Ord, B: Ord, C: Ord, D: Ord, E: Ord>(self: *(A, B, C, D, E),\n");
        buf_str(out, c"    other: *(A, B, C, D, E)) -> i64 {\n");
        buf_str(out, c"    let mut c = cmp_of(&(*self).0, &(*other).0);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).1, &(*other).1);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).2, &(*other).2);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).3, &(*other).3);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    cmp_of(&(*self).4, &(*other).4)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple6_cmp<A: Ord, B: Ord, C: Ord, D: Ord, E: Ord, F: Ord>(self: *(A, B, C, D, E, F),\n");
        buf_str(out, c"    other: *(A, B, C, D, E, F)) -> i64 {\n");
        buf_str(out, c"    let mut c = cmp_of(&(*self).0, &(*other).0);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).1, &(*other).1);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).2, &(*other).2);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).3, &(*other).3);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    c = cmp_of(&(*self).4, &(*other).4);\n");
        buf_str(out, c"    if c != 0 { return c; }\n");
        buf_str(out, c"    cmp_of(&(*self).5, &(*other).5)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple2_eq<A: Eq, B: Eq>(self: *(A, B), other: *(A, B)) -> bool {\n");
        buf_str(out, c"    eq_of(&(*self).0, &(*other).0) && eq_of(&(*self).1, &(*other).1)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple3_eq<A: Eq, B: Eq, C: Eq>(self: *(A, B, C), other: *(A, B, C)) -> bool {\n");
        buf_str(out, c"    eq_of(&(*self).0, &(*other).0) && eq_of(&(*self).1, &(*other).1)\n");
        buf_str(out, c"        && eq_of(&(*self).2, &(*other).2)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple4_eq<A: Eq, B: Eq, C: Eq, D: Eq>(self: *(A, B, C, D), other: *(A, B, C, D)) -> bool {\n");
        buf_str(out, c"    eq_of(&(*self).0, &(*other).0) && eq_of(&(*self).1, &(*other).1)\n");
        buf_str(out, c"        && eq_of(&(*self).2, &(*other).2) && eq_of(&(*self).3, &(*other).3)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple5_eq<A: Eq, B: Eq, C: Eq, D: Eq, E: Eq>(self: *(A, B, C, D, E),\n");
        buf_str(out, c"    other: *(A, B, C, D, E)) -> bool {\n");
        buf_str(out, c"    eq_of(&(*self).0, &(*other).0) && eq_of(&(*self).1, &(*other).1)\n");
        buf_str(out, c"        && eq_of(&(*self).2, &(*other).2) && eq_of(&(*self).3, &(*other).3)\n");
        buf_str(out, c"        && eq_of(&(*self).4, &(*other).4)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple6_eq<A: Eq, B: Eq, C: Eq, D: Eq, E: Eq, F: Eq>(self: *(A, B, C, D, E, F),\n");
        buf_str(out, c"    other: *(A, B, C, D, E, F)) -> bool {\n");
        buf_str(out, c"    eq_of(&(*self).0, &(*other).0) && eq_of(&(*self).1, &(*other).1)\n");
        buf_str(out, c"        && eq_of(&(*self).2, &(*other).2) && eq_of(&(*self).3, &(*other).3)\n");
        buf_str(out, c"        && eq_of(&(*self).4, &(*other).4) && eq_of(&(*self).5, &(*other).5)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple2_hash<A: Hash, B: Hash>(self: *(A, B)) -> u64 {\n");
        buf_str(out, c"    hash_mix(hash_of(&(*self).0), hash_of(&(*self).1))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple3_hash<A: Hash, B: Hash, C: Hash>(self: *(A, B, C)) -> u64 {\n");
        buf_str(out, c"    let h = hash_mix(hash_of(&(*self).0), hash_of(&(*self).1));\n");
        buf_str(out, c"    hash_mix(h, hash_of(&(*self).2))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple4_hash<A: Hash, B: Hash, C: Hash, D: Hash>(self: *(A, B, C, D)) -> u64 {\n");
        buf_str(out, c"    let mut h = hash_mix(hash_of(&(*self).0), hash_of(&(*self).1));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(&(*self).2));\n");
        buf_str(out, c"    hash_mix(h, hash_of(&(*self).3))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple5_hash<A: Hash, B: Hash, C: Hash, D: Hash, E: Hash>(self: *(A, B, C, D, E)) -> u64 {\n");
        buf_str(out, c"    let mut h = hash_mix(hash_of(&(*self).0), hash_of(&(*self).1));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(&(*self).2));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(&(*self).3));\n");
        buf_str(out, c"    hash_mix(h, hash_of(&(*self).4))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple6_hash<A: Hash, B: Hash, C: Hash, D: Hash, E: Hash, F: Hash>(\n");
        buf_str(out, c"    self: *(A, B, C, D, E, F)) -> u64 {\n");
        buf_str(out, c"    let mut h = hash_mix(hash_of(&(*self).0), hash_of(&(*self).1));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(&(*self).2));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(&(*self).3));\n");
        buf_str(out, c"    h = hash_mix(h, hash_of(&(*self).4));\n");
        buf_str(out, c"    hash_mix(h, hash_of(&(*self).5))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple2_clone<A: Clone, B: Clone>(self: *(A, B)) -> (A, B) {\n");
        buf_str(out, c"    (clone_of(&(*self).0), clone_of(&(*self).1))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple3_clone<A: Clone, B: Clone, C: Clone>(self: *(A, B, C)) -> (A, B, C) {\n");
        buf_str(out, c"    (clone_of(&(*self).0), clone_of(&(*self).1), clone_of(&(*self).2))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple4_clone<A: Clone, B: Clone, C: Clone, D: Clone>(self: *(A, B, C, D)) -> (A, B, C, D) {\n");
        buf_str(out, c"    (clone_of(&(*self).0), clone_of(&(*self).1), clone_of(&(*self).2), clone_of(&(*self).3))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple5_clone<A: Clone, B: Clone, C: Clone, D: Clone, E: Clone>(self: *(A, B, C, D, E))\n");
        buf_str(out, c"    -> (A, B, C, D, E) {\n");
        buf_str(out, c"    (clone_of(&(*self).0), clone_of(&(*self).1), clone_of(&(*self).2), clone_of(&(*self).3),\n");
        buf_str(out, c"        clone_of(&(*self).4))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn tuple6_clone<A: Clone, B: Clone, C: Clone, D: Clone, E: Clone, F: Clone>(\n");
        buf_str(out, c"    self: *(A, B, C, D, E, F)) -> (A, B, C, D, E, F) {\n");
        buf_str(out, c"    (clone_of(&(*self).0), clone_of(&(*self).1), clone_of(&(*self).2), clone_of(&(*self).3),\n");
        buf_str(out, c"        clone_of(&(*self).4), clone_of(&(*self).5))\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- Allocation (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Memory comes from allocators: a type implementing Allocator. Containers\n");
        buf_str(out, c"// carry theirs as a type parameter (`Vec<T, A: Allocator = Gpa>`), so an\n");
        buf_str(out, c"// allocation is a call std can see, and effects name it (`alloc(Gpa)`).\n");
        buf_str(out, c"// Allocation is explicit: nothing allocates without being given an\n");
        buf_str(out, c"// allocator, `Vec::new_in(a)`, `collect_in(a)`, `format_in(x, a)`. Gpa,\n");
        buf_str(out, c"// the general-purpose allocator (C's malloc), is the type parameters'\n");
        buf_str(out, c"// default, and a program has one when its main takes it (`gpa: Gpa`, its\n");
        buf_str(out, c"// parameter), passed down as a parameter.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Sizes and alignments are in bytes; an alignment is a power of two from 1\n");
        buf_str(out, c"// to 4096. Running out of memory, or misusing an allocator, stops the\n");
        buf_str(out, c"// program (exit 101): part of the effect `alloc`, not `panic`. A size\n");
        buf_str(out, c"// above ALLOC_LIMIT (2^62 bytes) is out of memory.\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub trait Allocator {\n");
        buf_str(out, c"    // size bytes aligned to align, null when out of memory; size 0: aligned,\n");
        buf_str(out, c"    // non-null, unreadable.\n");
        buf_str(out, c"    #[effects(alloc, global, panic, diverge, unsafe)]\n");
        buf_str(out, c"    fn try_alloc(self: *Self, size: i64, align: i64) -> *u8;\n");
        buf_str(out, c"    // p (old_size bytes, from this allocator) as new_size bytes, the first\n");
        buf_str(out, c"    // min(old_size, new_size) kept; may move; null: p is left as it was.\n");
        buf_str(out, c"    #[effects(alloc, global, panic, diverge, unsafe)]\n");
        buf_str(out, c"    unsafe fn try_resize(self: *Self, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8;\n");
        buf_str(out, c"    // Gives back p (size bytes, from this allocator).\n");
        buf_str(out, c"    #[effects(alloc, global, panic, diverge, unsafe)]\n");
        buf_str(out, c"    unsafe fn free(self: *Self, p: *u8, size: i64, align: i64);\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // try_alloc, stopping the program when out of memory.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn alloc(self: *Self, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        let p = self.try_alloc(size, align);\n");
        buf_str(out, c"        if p == 0 as *u8 {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        p\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // try_resize, stopping the program when out of memory.\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn resize(self: *Self, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        let q = self.try_resize(p, old_size, new_size, align);\n");
        buf_str(out, c"        if q == 0 as *u8 {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        q\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What the try_ functions of containers return when out of memory\n");
        buf_str(out, c"// (`v.try_push(x)`, `v.try_reserve(n)`).\n");
        buf_str(out, c"pub enum AllocError { OutOfMemory }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Display for AllocError {\n");
        buf_str(out, c"    fn fmt(self: *AllocError, f: *Fmt) {\n");
        buf_str(out, c"        f.str(\"out of memory\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Debug for AllocError {\n");
        buf_str(out, c"    fn fmt_debug(self: *AllocError, f: *Fmt) {\n");
        buf_str(out, c"        f.str(\"OutOfMemory\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The largest allocation: 2^62 bytes (a size above it is out of memory).\n");
        buf_str(out, c"pub const ALLOC_LIMIT: i64 = 4611686018427387904;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Stops the program: an allocator is out of memory.\n");
        buf_str(out, c"#[cold]\n");
        buf_str(out, c"fn out_of_memory() -> ! {\n");
        buf_str(out, c"    unsafe { panic(c\"out of memory\") }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// n elements of `size` bytes, in bytes; -1 when n is negative or that is\n");
        buf_str(out, c"// above ALLOC_LIMIT.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn alloc_bytes(n: i64, size: i64) -> i64 {\n");
        buf_str(out, c"    if n < 0 || size > 0 && n > ALLOC_LIMIT / size {\n");
        buf_str(out, c"        return -1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    n * size\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The capacity a container grows to from cap for at least need elements:\n");
        buf_str(out, c"// twice cap (4 at least), or need when that is more.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn grown_cap(cap: i64, need: i64) -> i64 {\n");
        buf_str(out, c"    let twice = if cap == 0 { 4 } else if cap < ALLOC_LIMIT / 2 { cap * 2 } else { ALLOC_LIMIT };\n");
        buf_str(out, c"    if twice < need { need } else { twice }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Gpa ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The general-purpose allocator: C's malloc, realloc and free (its\n");
        buf_str(out, c"// implementation follows std's source: gpa.tach, or the checking one of\n");
        buf_str(out, c"// --check-alloc). Zero-sized, copied freely: a Vec<T> on it is three\n");
        buf_str(out, c"// words. Sealed: only the runtime's entry makes one, main's parameter\n");
        buf_str(out, c"// `gpa: Gpa`; a static cannot hold one (no constant makes one), so a\n");
        buf_str(out, c"// program keeps its containers in main and passes them down.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct Gpa {}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Arenas (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An arena: allocations bump a pointer through chunks taken from Gpa, and\n");
        buf_str(out, c"// are given back all at once: when a scope ends (`a.scope(|s| ...)`,\n");
        buf_str(out, c"// `arena_scope(gpa, |s| ...)`), or by `reset` and `free_all` (unsafe: what\n");
        buf_str(out, c"// was allocated must not be used after). A request above 32 KB gets a\n");
        buf_str(out, c"// chunk of its own; the last block grows and shrinks in place; `free`\n");
        buf_str(out, c"// gives back the last block, and a chunk of its own. A handle: copies\n");
        buf_str(out, c"// share the arena. `Arena::none()`, a constant (for statics), has no\n");
        buf_str(out, c"// memory: allocating from it stops the program.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// (--check-alloc routes each block to its own pages at the points marked\n");
        buf_str(out, c"// \"check-alloc\", keeping the accounting: T3.)\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct Arena { s: *ArenaState }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A chunk of an arena's memory, from Gpa: this header, then its bytes (the\n");
        buf_str(out, c"// first chunk's start with the arena's state).\n");
        buf_str(out, c"struct ArenaChunk { next: *ArenaChunk, size: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A block of its own (a request above ARENA_LARGE): this header, at\n");
        buf_str(out, c"// arena_large_head(align) bytes before the block, in a list both ways.\n");
        buf_str(out, c"struct ArenaLarge { next: *ArenaLarge, prev: *ArenaLarge, size: i64, align: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The state of an arena, in its first chunk, or of a scope, on the stack\n");
        buf_str(out, c"// of the scope's function. Addresses are i64s; ptr..limit is where the\n");
        buf_str(out, c"// next block goes (limit is 0 while the arena is lent to a scope).\n");
        buf_str(out, c"struct ArenaState {\n");
        buf_str(out, c"    ptr: i64,\n");
        buf_str(out, c"    limit: i64,\n");
        buf_str(out, c"    // the current chunk, its first byte and its end\n");
        buf_str(out, c"    chunk: *ArenaChunk,\n");
        buf_str(out, c"    start: i64,\n");
        buf_str(out, c"    end: i64,\n");
        buf_str(out, c"    // the last block (it grows in place), -1: none\n");
        buf_str(out, c"    last: i64,\n");
        buf_str(out, c"    // the bytes used in the chunks before the current one\n");
        buf_str(out, c"    before: i64,\n");
        buf_str(out, c"    lent: bool,\n");
        buf_str(out, c"    // the arena's own state (itself for an Arena; for a scope, its arena's)\n");
        buf_str(out, c"    root: *ArenaState,\n");
        buf_str(out, c"    // a scope's: the arena's blocks of their own when it started\n");
        buf_str(out, c"    large_mark: *ArenaLarge,\n");
        buf_str(out, c"    // the root's: its chunks, its blocks of their own, the bytes of these,\n");
        buf_str(out, c"    // the bytes taken from Gpa, the size of the next chunk\n");
        buf_str(out, c"    first: *ArenaChunk,\n");
        buf_str(out, c"    large: *ArenaLarge,\n");
        buf_str(out, c"    large_bytes: i64,\n");
        buf_str(out, c"    chunk_bytes: i64,\n");
        buf_str(out, c"    next_size: i64,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Requests above this get a chunk of their own.\n");
        buf_str(out, c"const ARENA_LARGE: i64 = 32768;\n");
        buf_str(out, c"// The first chunk's bytes (Arena::new_in), the first next chunk's (a\n");
        buf_str(out, c"// request up to ARENA_LARGE, aligned, fits in any), the largest.\n");
        buf_str(out, c"const ARENA_FIRST: i64 = 8192;\n");
        buf_str(out, c"const ARENA_NEXT: i64 = 65536;\n");
        buf_str(out, c"const ARENA_MAX_CHUNK: i64 = 4194304;\n");
        buf_str(out, c"const ARENA_CHUNK_HEAD: i64 = 16;\n");
        buf_str(out, c"const ARENA_ALIGN_MAX: i64 = 4096;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A block's bytes from state s: the bump (an Arena's and a ScopedArena's\n");
        buf_str(out, c"// try_alloc), the rest out of line.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"fn arena_alloc(s: *ArenaState, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        if s != 0 as *ArenaState {\n");
        buf_str(out, c"            let p = (s.ptr + align - 1) & -align;\n");
        buf_str(out, c"            let e = p + size;\n");
        buf_str(out, c"            if (size as u64) <= (ARENA_LARGE as u64) && p >= s.ptr && e <= s.limit {\n");
        buf_str(out, c"                s.ptr = e;\n");
        buf_str(out, c"                s.last = p;\n");
        buf_str(out, c"                // (check-alloc: the block's own pages here)\n");
        buf_str(out, c"                return p as *u8;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        arena_alloc_slow(s, size, align)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Whether align is an alignment: a power of two from 1 to 4096.\n");
        buf_str(out, c"fn arena_align_ok(align: i64) -> bool {\n");
        buf_str(out, c"    align >= 1 && align <= ARENA_ALIGN_MAX && (align & (align - 1)) == 0\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// arena_alloc when the bump does not fit: a block of its own, or the next\n");
        buf_str(out, c"// chunk (a new one when there is none).\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"unsafe fn arena_alloc_slow(s: *ArenaState, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    arena_usable(s);\n");
        buf_str(out, c"    if size < 0 || size > ALLOC_LIMIT || !arena_align_ok(align) {\n");
        buf_str(out, c"        return 0 as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if size > ARENA_LARGE {\n");
        buf_str(out, c"        return arena_large_alloc(s.root, size, align);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let mut c = s.chunk.next;\n");
        buf_str(out, c"    if c == 0 as *ArenaChunk {\n");
        buf_str(out, c"        c = arena_new_chunk(s.root, s.chunk);\n");
        buf_str(out, c"        if c == 0 as *ArenaChunk {\n");
        buf_str(out, c"            return 0 as *u8;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    s.before += s.ptr - s.start;\n");
        buf_str(out, c"    s.chunk = c;\n");
        buf_str(out, c"    s.start = c as i64 + ARENA_CHUNK_HEAD;\n");
        buf_str(out, c"    s.end = c as i64 + c.size;\n");
        buf_str(out, c"    s.limit = s.end;\n");
        buf_str(out, c"    s.ptr = s.start;\n");
        buf_str(out, c"    s.last = -1;\n");
        buf_str(out, c"    // (a request up to ARENA_LARGE, aligned, fits in any next chunk)\n");
        buf_str(out, c"    arena_alloc(s, size, align)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Stops the program unless s is an arena that can allocate: not\n");
        buf_str(out, c"// Arena::none(), not lent to a scope.\n");
        buf_str(out, c"unsafe fn arena_usable(s: *ArenaState) {\n");
        buf_str(out, c"    if s == 0 as *ArenaState {\n");
        buf_str(out, c"        panic(c\"the arena has no memory: it is Arena::none()\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if s.lent {\n");
        buf_str(out, c"        panic(c\"the arena is lent to a scope: allocate from the scope's arena\");\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A new chunk from Gpa, after chunk `after` in root's list; null when out\n");
        buf_str(out, c"// of memory.\n");
        buf_str(out, c"unsafe fn arena_new_chunk(root: *ArenaState, after: *ArenaChunk) -> *ArenaChunk {\n");
        buf_str(out, c"    let size = root.next_size;\n");
        buf_str(out, c"    let g = Gpa {};\n");
        buf_str(out, c"    let c = g.try_alloc(size, 16) as *ArenaChunk;\n");
        buf_str(out, c"    if c == 0 as *ArenaChunk {\n");
        buf_str(out, c"        return c;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    c.size = size;\n");
        buf_str(out, c"    c.next = after.next;\n");
        buf_str(out, c"    after.next = c;\n");
        buf_str(out, c"    root.chunk_bytes += size;\n");
        buf_str(out, c"    if size < ARENA_MAX_CHUNK {\n");
        buf_str(out, c"        root.next_size = size * 2;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    c\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The bytes of a block of its own before it: its header, or the\n");
        buf_str(out, c"// alignment when that is more.\n");
        buf_str(out, c"fn arena_large_head(align: i64) -> i64 {\n");
        buf_str(out, c"    if align > 32 { align } else { 32 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A block of its own of size bytes from Gpa, at the front of root's list.\n");
        buf_str(out, c"unsafe fn arena_large_alloc(root: *ArenaState, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    let head = arena_large_head(align);\n");
        buf_str(out, c"    let g = Gpa {};\n");
        buf_str(out, c"    let c = g.try_alloc(head + size, if align > 16 { align } else { 16 });\n");
        buf_str(out, c"    if c == 0 as *u8 {\n");
        buf_str(out, c"        return c;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let p = &c[head];\n");
        buf_str(out, c"    let h = (&p[-32]) as *ArenaLarge;\n");
        buf_str(out, c"    h.size = size;\n");
        buf_str(out, c"    h.align = align;\n");
        buf_str(out, c"    h.prev = 0 as *ArenaLarge;\n");
        buf_str(out, c"    h.next = root.large;\n");
        buf_str(out, c"    if root.large != 0 as *ArenaLarge {\n");
        buf_str(out, c"        root.large.prev = h;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    root.large = h;\n");
        buf_str(out, c"    root.large_bytes += size;\n");
        buf_str(out, c"    root.chunk_bytes += head + size;\n");
        buf_str(out, c"    p\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Gives back block p, of its own, of root.\n");
        buf_str(out, c"unsafe fn arena_large_free(root: *ArenaState, p: *u8) {\n");
        buf_str(out, c"    let h = (&p[-32]) as *ArenaLarge;\n");
        buf_str(out, c"    let head = arena_large_head(h.align);\n");
        buf_str(out, c"    if h.prev == 0 as *ArenaLarge {\n");
        buf_str(out, c"        root.large = h.next;\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        h.prev.next = h.next;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if h.next != 0 as *ArenaLarge {\n");
        buf_str(out, c"        h.next.prev = h.prev;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    root.large_bytes -= h.size;\n");
        buf_str(out, c"    root.chunk_bytes -= head + h.size;\n");
        buf_str(out, c"    let g = Gpa {};\n");
        buf_str(out, c"    g.free(&p[-head], head + h.size, if h.align > 16 { h.align } else { 16 });\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Gives back the blocks of their own of root down to `mark` (the list's\n");
        buf_str(out, c"// front when a scope started), or all of them.\n");
        buf_str(out, c"unsafe fn arena_large_free_to(root: *ArenaState, mark: *ArenaLarge) {\n");
        buf_str(out, c"    for _ in 0..ALLOC_LIMIT {\n");
        buf_str(out, c"        let h = root.large;\n");
        buf_str(out, c"        if h == mark {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        arena_large_free(root, &(h as *u8)[32]);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An Arena's or a ScopedArena's try_resize: the last block in place, a\n");
        buf_str(out, c"// block of its own with Gpa's resize, else moved.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn arena_resize(s: *ArenaState, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"    -> *u8 {\n");
        buf_str(out, c"    if s != 0 as *ArenaState && p as i64 == s.last && (new_size as u64) <= (ARENA_LARGE as u64)\n");
        buf_str(out, c"        && old_size <= ARENA_LARGE && p as i64 + new_size <= s.limit {\n");
        buf_str(out, c"        s.ptr = p as i64 + new_size;\n");
        buf_str(out, c"        return p;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    arena_resize_slow(s, p, old_size, new_size, align)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[inline(never)]\n");
        buf_str(out, c"unsafe fn arena_resize_slow(s: *ArenaState, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"    -> *u8 {\n");
        buf_str(out, c"    arena_usable(s);\n");
        buf_str(out, c"    if new_size < 0 || new_size > ALLOC_LIMIT || !arena_align_ok(align) {\n");
        buf_str(out, c"        return 0 as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if old_size > ARENA_LARGE && new_size > ARENA_LARGE {\n");
        buf_str(out, c"        // (a block of its own stays one: resized by Gpa, relinked)\n");
        buf_str(out, c"        let root = s.root;\n");
        buf_str(out, c"        let h = (&p[-32]) as *ArenaLarge;\n");
        buf_str(out, c"        let head = arena_large_head(align);\n");
        buf_str(out, c"        let g = Gpa {};\n");
        buf_str(out, c"        let c = g.try_resize(&p[-head], head + old_size, head + new_size,\n");
        buf_str(out, c"            if align > 16 { align } else { 16 });\n");
        buf_str(out, c"        if c == 0 as *u8 {\n");
        buf_str(out, c"            return c;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let q = &c[head];\n");
        buf_str(out, c"        let k = (&q[-32]) as *ArenaLarge;\n");
        buf_str(out, c"        if k.prev == 0 as *ArenaLarge {\n");
        buf_str(out, c"            root.large = k;\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            k.prev.next = k;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if k.next != 0 as *ArenaLarge {\n");
        buf_str(out, c"            k.next.prev = k;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        k.size = new_size;\n");
        buf_str(out, c"        root.large_bytes += new_size - old_size;\n");
        buf_str(out, c"        root.chunk_bytes += new_size - old_size;\n");
        buf_str(out, c"        return q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let q = arena_alloc(s, new_size, align);\n");
        buf_str(out, c"    if q == 0 as *u8 {\n");
        buf_str(out, c"        return q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let n = if old_size < new_size { old_size } else { new_size };\n");
        buf_str(out, c"    if n > 0 {\n");
        buf_str(out, c"        memcpy(q, p, n as u64);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    arena_free(s, p, old_size);\n");
        buf_str(out, c"    q\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An Arena's or a ScopedArena's free: the last block goes back to the\n");
        buf_str(out, c"// bump, a block of its own to Gpa; any other waits for the arena's end.\n");
        buf_str(out, c"// Nothing while the arena is lent to a scope.\n");
        buf_str(out, c"#[inline]\n");
        buf_str(out, c"unsafe fn arena_free(s: *ArenaState, p: *u8, size: i64) {\n");
        buf_str(out, c"    if s == 0 as *ArenaState || s.lent {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if size > ARENA_LARGE {\n");
        buf_str(out, c"        arena_large_free(s.root, p);\n");
        buf_str(out, c"    } else if p as i64 == s.last {\n");
        buf_str(out, c"        s.ptr = s.last;\n");
        buf_str(out, c"        s.last = -1;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The bytes allocated from state s (blocks of their own included).\n");
        buf_str(out, c"unsafe fn arena_used(s: *ArenaState) -> i64 {\n");
        buf_str(out, c"    s.before + s.ptr - s.start + s.root.large_bytes\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Allocator for Arena {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn try_alloc(self: *Arena, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        unsafe { arena_alloc(self.s, size, align) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn try_resize(self: *Arena, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        arena_resize(self.s, p, old_size, new_size, align)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn free(self: *Arena, p: *u8, size: i64, align: i64) {\n");
        buf_str(out, c"        arena_free(self.s, p, size);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Arena {\n");
        buf_str(out, c"    // A new arena, its chunks from gpa: the first of 8 KB, the next\n");
        buf_str(out, c"    // ones twice as large each up to 4 MB.\n");
        buf_str(out, c"    pub fn new_in(gpa: Gpa) -> Arena {\n");
        buf_str(out, c"        Arena::with_capacity_in(ARENA_FIRST, gpa)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A new arena with room for `bytes` in its first chunk.\n");
        buf_str(out, c"    pub fn with_capacity_in(bytes: i64, gpa: Gpa) -> Arena {\n");
        buf_str(out, c"        let head = ARENA_CHUNK_HEAD + size_of(ArenaState);\n");
        buf_str(out, c"        let room = if bytes < 0 { 0 } else { bytes };\n");
        buf_str(out, c"        if room > ALLOC_LIMIT - head {\n");
        buf_str(out, c"            out_of_memory();\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let size = head + room;\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let c = gpa.alloc(size, 16) as *ArenaChunk;\n");
        buf_str(out, c"            c.next = 0 as *ArenaChunk;\n");
        buf_str(out, c"            c.size = size;\n");
        buf_str(out, c"            let s = (c as i64 + ARENA_CHUNK_HEAD) as *ArenaState;\n");
        buf_str(out, c"            s.start = c as i64 + head;\n");
        buf_str(out, c"            s.ptr = s.start;\n");
        buf_str(out, c"            s.end = c as i64 + size;\n");
        buf_str(out, c"            s.limit = s.end;\n");
        buf_str(out, c"            s.chunk = c;\n");
        buf_str(out, c"            s.last = -1;\n");
        buf_str(out, c"            s.before = 0;\n");
        buf_str(out, c"            s.lent = false;\n");
        buf_str(out, c"            s.root = s;\n");
        buf_str(out, c"            s.large_mark = 0 as *ArenaLarge;\n");
        buf_str(out, c"            s.first = c;\n");
        buf_str(out, c"            s.large = 0 as *ArenaLarge;\n");
        buf_str(out, c"            s.large_bytes = 0;\n");
        buf_str(out, c"            s.chunk_bytes = size;\n");
        buf_str(out, c"            s.next_size = ARENA_NEXT;\n");
        buf_str(out, c"            Arena { s: s }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // An arena that has no memory, a constant (for statics: `static mut\n");
        buf_str(out, c"    // V: Vec<i64, Arena> = Vec::new_in(Arena::none());`, set up in main\n");
        buf_str(out, c"    // with `Arena::new_in(gpa)`). Allocating from it stops the program.\n");
        buf_str(out, c"    pub fn none() -> Arena {\n");
        buf_str(out, c"        Arena { s: 0 as *ArenaState }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The bytes allocated from the arena since it was made or reset.\n");
        buf_str(out, c"    pub fn used(self: *Arena) -> i64 {\n");
        buf_str(out, c"        if self.s == 0 as *ArenaState { 0 } else { unsafe { arena_used(self.s) } }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The bytes the arena holds from Gpa: its chunks and blocks.\n");
        buf_str(out, c"    pub fn chunk_bytes(self: *Arena) -> i64 {\n");
        buf_str(out, c"        if self.s == 0 as *ArenaState { 0 } else { unsafe { self.s.chunk_bytes } }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Everything allocated from the arena is given back; its chunks are\n");
        buf_str(out, c"    // kept (blocks of their own go back to Gpa). Unsafe: what was\n");
        buf_str(out, c"    // allocated must not be used after.\n");
        buf_str(out, c"    pub unsafe fn reset(self: *Arena) {\n");
        buf_str(out, c"        let s = self.s;\n");
        buf_str(out, c"        if s == 0 as *ArenaState {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        arena_usable(s);\n");
        buf_str(out, c"        arena_large_free_to(s, 0 as *ArenaLarge);\n");
        buf_str(out, c"        let c = s.first;\n");
        buf_str(out, c"        s.chunk = c;\n");
        buf_str(out, c"        s.start = c as i64 + ARENA_CHUNK_HEAD + size_of(ArenaState);\n");
        buf_str(out, c"        s.ptr = s.start;\n");
        buf_str(out, c"        s.end = c as i64 + c.size;\n");
        buf_str(out, c"        s.limit = s.end;\n");
        buf_str(out, c"        s.last = -1;\n");
        buf_str(out, c"        s.before = 0;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The arena's memory, chunks included, given back to Gpa; this handle\n");
        buf_str(out, c"    // becomes Arena::none(). Unsafe: nothing allocated from it, and no\n");
        buf_str(out, c"    // copy of the handle, may be used after.\n");
        buf_str(out, c"    pub unsafe fn free_all(self: *Arena) {\n");
        buf_str(out, c"        let s = self.s;\n");
        buf_str(out, c"        if s == 0 as *ArenaState {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        arena_usable(s);\n");
        buf_str(out, c"        arena_large_free_to(s, 0 as *ArenaLarge);\n");
        buf_str(out, c"        let g = Gpa {};\n");
        buf_str(out, c"        let mut c = s.first.next;\n");
        buf_str(out, c"        for _ in 0..ALLOC_LIMIT {\n");
        buf_str(out, c"            if c == 0 as *ArenaChunk {\n");
        buf_str(out, c"                break;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            let next = c.next;\n");
        buf_str(out, c"            g.free(c as *u8, c.size, 16);\n");
        buf_str(out, c"            c = next;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let first = s.first;\n");
        buf_str(out, c"        g.free(first as *u8, first.size, 16);\n");
        buf_str(out, c"        self.s = 0 as *ArenaState;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // f with a scope of this arena: what f allocates from the ScopedArena\n");
        buf_str(out, c"    // it is given is given back when f returns. The arena is lent\n");
        buf_str(out, c"    // meanwhile: allocating from it stops the program. Nothing on the\n");
        buf_str(out, c"    // ScopedArena can leave f (#[scoped]).\n");
        buf_str(out, c"    pub fn scope<R, F: FnMut(ScopedArena) -> R>(self: *Arena, f: F) -> R {\n");
        buf_str(out, c"        unsafe { arena_scope_of(self.s, f) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An arena lent to a scope (arena_scope, Arena::scope): what is allocated\n");
        buf_str(out, c"// from it is given back when the scope ends, so nothing holding it can\n");
        buf_str(out, c"// leave the scope (#[scoped]: not returned, not captured by another\n");
        buf_str(out, c"// scope, not in a static).\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"#[scoped]\n");
        buf_str(out, c"pub struct ScopedArena { s: *ArenaState, mark: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Allocator for ScopedArena {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn try_alloc(self: *ScopedArena, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        unsafe { arena_alloc(self.s, size, align) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn try_resize(self: *ScopedArena, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"        -> *u8 {\n");
        buf_str(out, c"        arena_resize(self.s, p, old_size, new_size, align)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn free(self: *ScopedArena, p: *u8, size: i64, align: i64) {\n");
        buf_str(out, c"        arena_free(self.s, p, size);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl ScopedArena {\n");
        buf_str(out, c"    // The bytes allocated from this scope.\n");
        buf_str(out, c"    pub fn used(self: *ScopedArena) -> i64 {\n");
        buf_str(out, c"        unsafe { arena_used(self.s) - self.mark }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // f with a scope of this one (lent meanwhile), as Arena::scope.\n");
        buf_str(out, c"    pub fn scope<R, F: FnMut(ScopedArena) -> R>(self: *ScopedArena, f: F) -> R {\n");
        buf_str(out, c"        unsafe { arena_scope_of(self.s, f) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// f with a new arena, its chunks from gpa, given back when f returns.\n");
        buf_str(out, c"pub fn arena_scope<R, F: FnMut(ScopedArena) -> R>(gpa: Gpa, f: F) -> R {\n");
        buf_str(out, c"    let mut a = Arena::new_in(gpa);\n");
        buf_str(out, c"    // (arena_scope_of, not a.scope: the scoped check of a function passed\n");
        buf_str(out, c"    // by name is at the call of arena_scope, once)\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        let r = arena_scope_of(a.s, f);\n");
        buf_str(out, c"        a.free_all();\n");
        buf_str(out, c"        r\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// f with a scope of the arena of state p: the scope's state starts where\n");
        buf_str(out, c"// p's is, p is lent (its limit 0) until f returns, then p's blocks of\n");
        buf_str(out, c"// their own made meanwhile go back.\n");
        buf_str(out, c"fn arena_scope_of<R, F: FnMut(ScopedArena) -> R>(p: *ArenaState, f: F) -> R {\n");
        buf_str(out, c"    let mut st = ArenaState {\n");
        buf_str(out, c"        ptr: 0, limit: 0, chunk: 0 as *ArenaChunk, start: 0, end: 0, last: -1, before: 0,\n");
        buf_str(out, c"        lent: false, root: 0 as *ArenaState, large_mark: 0 as *ArenaLarge,\n");
        buf_str(out, c"        first: 0 as *ArenaChunk, large: 0 as *ArenaLarge, large_bytes: 0, chunk_bytes: 0,\n");
        buf_str(out, c"        next_size: 0,\n");
        buf_str(out, c"    };\n");
        buf_str(out, c"    let mark = unsafe { arena_lend(p, &st) };\n");
        buf_str(out, c"    let mut g = f;\n");
        buf_str(out, c"    let r = g(ScopedArena { s: &st, mark: mark });\n");
        buf_str(out, c"    unsafe {\n");
        buf_str(out, c"        arena_unlend(p, &st);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    r\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Lends the arena of state p to a scope of state st: st starts at p's\n");
        buf_str(out, c"// position, p is locked. Returns the bytes used at the start.\n");
        buf_str(out, c"unsafe fn arena_lend(p: *ArenaState, st: *ArenaState) -> i64 {\n");
        buf_str(out, c"    arena_usable(p);\n");
        buf_str(out, c"    st.ptr = p.ptr;\n");
        buf_str(out, c"    st.limit = p.limit;\n");
        buf_str(out, c"    st.chunk = p.chunk;\n");
        buf_str(out, c"    st.start = p.start;\n");
        buf_str(out, c"    st.end = p.end;\n");
        buf_str(out, c"    st.before = p.before;\n");
        buf_str(out, c"    st.root = p.root;\n");
        buf_str(out, c"    st.large_mark = p.root.large;\n");
        buf_str(out, c"    p.lent = true;\n");
        buf_str(out, c"    p.limit = 0;\n");
        buf_str(out, c"    arena_used(st)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The scope of state st is over: its blocks of their own go back, and p,\n");
        buf_str(out, c"// where it was, is no longer lent (st's chunks are p's next ones).\n");
        buf_str(out, c"unsafe fn arena_unlend(p: *ArenaState, st: *ArenaState) {\n");
        buf_str(out, c"    arena_large_free_to(p.root, st.large_mark);\n");
        buf_str(out, c"    st.lent = true;\n");
        buf_str(out, c"    st.limit = 0;\n");
        buf_str(out, c"    p.lent = false;\n");
        buf_str(out, c"    p.limit = p.end;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- FixedBuf (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// An allocator in a fixed buffer of bytes: `FixedBuf::new(mem[..])` over an\n");
        buf_str(out, c"// array or a Vec's view, which must outlive it (not checked). Blocks bump\n");
        buf_str(out, c"// through it; when it is full, try_alloc is null (out of memory). Its\n");
        buf_str(out, c"// first 16 bytes (from the first one aligned to 8) hold the bytes used and\n");
        buf_str(out, c"// the last block, so copies of the handle share them.\n");
        buf_str(out, c"#[sealed]\n");
        buf_str(out, c"pub struct FixedBuf { base: *u8, cap: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"const FIXED_HEAD: i64 = 16;\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Allocator for FixedBuf {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn try_alloc(self: *FixedBuf, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        if self.cap == 0 || !arena_align_ok(align) {\n");
        buf_str(out, c"            return 0 as *u8;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let h = (&self.base[-FIXED_HEAD]) as *i64;\n");
        buf_str(out, c"            let b = self.base as i64;\n");
        buf_str(out, c"            let p = (b + h[0] + align - 1) & -align;\n");
        buf_str(out, c"            if size < 0 || size > ALLOC_LIMIT || p + size > b + self.cap {\n");
        buf_str(out, c"                return 0 as *u8;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            h[0] = p + size - b;\n");
        buf_str(out, c"            h[1] = p;\n");
        buf_str(out, c"            // (check-alloc: the block's own pages here)\n");
        buf_str(out, c"            p as *u8\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn try_resize(self: *FixedBuf, p: *u8, old_size: i64, new_size: i64, align: i64)\n");
        buf_str(out, c"        -> *u8 {\n");
        buf_str(out, c"        if self.cap == 0 || new_size < 0 || new_size > ALLOC_LIMIT {\n");
        buf_str(out, c"            return 0 as *u8;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let h = (&self.base[-FIXED_HEAD]) as *i64;\n");
        buf_str(out, c"        let b = self.base as i64;\n");
        buf_str(out, c"        if p as i64 == h[1] && p as i64 + new_size <= b + self.cap {\n");
        buf_str(out, c"            h[0] = p as i64 + new_size - b;\n");
        buf_str(out, c"            return p;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let q = self.try_alloc(new_size, align);\n");
        buf_str(out, c"        if q == 0 as *u8 {\n");
        buf_str(out, c"            return q;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let n = if old_size < new_size { old_size } else { new_size };\n");
        buf_str(out, c"        if n > 0 {\n");
        buf_str(out, c"            memcpy(q, p, n as u64);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        q\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn free(self: *FixedBuf, p: *u8, size: i64, align: i64) {\n");
        buf_str(out, c"        if self.cap == 0 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let h = (&self.base[-FIXED_HEAD]) as *i64;\n");
        buf_str(out, c"        if p as i64 == h[1] {\n");
        buf_str(out, c"            h[0] = p as i64 - self.base as i64;\n");
        buf_str(out, c"            h[1] = -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl FixedBuf {\n");
        buf_str(out, c"    // An allocator in mem (its first 16 bytes, from the first one aligned\n");
        buf_str(out, c"    // to 8, are its own; a smaller mem has no room).\n");
        buf_str(out, c"    pub fn new(mem: [u8]) -> FixedBuf {\n");
        buf_str(out, c"        let at = mem.ptr as i64;\n");
        buf_str(out, c"        let skip = ((at + 7) & -8) - at + FIXED_HEAD;\n");
        buf_str(out, c"        if mem.len <= skip {\n");
        buf_str(out, c"            return FixedBuf { base: 0 as *u8, cap: 0 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe {\n");
        buf_str(out, c"            let base = &mem.ptr[skip];\n");
        buf_str(out, c"            let h = (&base[-FIXED_HEAD]) as *i64;\n");
        buf_str(out, c"            h[0] = 0;\n");
        buf_str(out, c"            h[1] = -1;\n");
        buf_str(out, c"            FixedBuf { base: base, cap: mem.len - skip }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The bytes allocated from it.\n");
        buf_str(out, c"    pub fn used(self: *FixedBuf) -> i64 {\n");
        buf_str(out, c"        if self.cap == 0 { 0 } else { unsafe { ((&self.base[-FIXED_HEAD]) as *i64)[0] } }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Its bytes, for allocating from it again. Unsafe: what was allocated\n");
        buf_str(out, c"    // must not be used after.\n");
        buf_str(out, c"    pub unsafe fn reset(self: *FixedBuf) {\n");
        buf_str(out, c"        if self.cap != 0 {\n");
        buf_str(out, c"            let h = (&self.base[-FIXED_HEAD]) as *i64;\n");
        buf_str(out, c"            h[0] = 0;\n");
        buf_str(out, c"            h[1] = -1;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- The ambient Gpa of 0.15 (0.16, until the corpus is migrated) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// std's ambient constructors of 0.15 (`Vec::new()`, `collect()`...),\n");
        buf_str(out, c"// errors outside std, take their Gpa here, until `fix --only alloc016`\n");
        buf_str(out, c"// migrates the corpus (front/ambient.tach): not `pub`, it goes with them.\n");
        buf_str(out, c"trait Ambient { fn ambient() -> Self; }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Ambient for Gpa {\n");
        buf_str(out, c"    #[ambient(\"a 'gpa: Gpa' parameter, from main's\")]\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn ambient() -> Gpa { Gpa {} }\n");
        buf_str(out, c"}\n");
    }
    std_alloc_tail(out);
}

// Gpa's implementation (0.16), the end of std's source unless
// --check-alloc (front/stdalloc.tach).
pub fn std_gpa_source(out: i64) {
    unsafe {
        buf_str(out, c"// ---- Gpa's implementation (0.16) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// C's allocator; malloc's memory is aligned to 16, larger alignments go\n");
        buf_str(out, c"// through posix_memalign. (--check-alloc replaces this part of std with\n");
        buf_str(out, c"// alloc_check.tach.)\n");
        buf_str(out, c"\n");
        buf_str(out, c"extern \"C\" {\n");
        buf_str(out, c"    #[effects(alloc(extern))]\n");
        buf_str(out, c"    fn posix_memalign(out: **u8, align: u64, size: u64) -> i32;\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"const GPA_MALLOC_ALIGN: i64 = 16;\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Allocator for Gpa {\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    fn try_alloc(self: *Gpa, size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        if size == 0 {\n");
        buf_str(out, c"            // (a pointer nothing is read through)\n");
        buf_str(out, c"            return unsafe { align as *u8 };\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if align > GPA_MALLOC_ALIGN {\n");
        buf_str(out, c"            return gpa_aligned(size, align);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        unsafe { malloc(size as u64) }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn try_resize(self: *Gpa, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"        if align > GPA_MALLOC_ALIGN || new_size == 0 {\n");
        buf_str(out, c"            return gpa_resize_slow(p, old_size, new_size, align);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        realloc(if old_size == 0 { 0 as *u8 } else { p }, new_size as u64)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    #[inline]\n");
        buf_str(out, c"    unsafe fn free(self: *Gpa, p: *u8, size: i64, align: i64) {\n");
        buf_str(out, c"        if size != 0 {\n");
        buf_str(out, c"            free(p);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// size bytes (not 0) aligned to align (above malloc's), or null.\n");
        buf_str(out, c"fn gpa_aligned(size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    let mut p = 0 as *u8;\n");
        buf_str(out, c"    if unsafe { posix_memalign(&p, align as u64, size as u64) } != 0 {\n");
        buf_str(out, c"        return 0 as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    p\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Gpa::try_resize to 0 bytes, or above malloc's alignment.\n");
        buf_str(out, c"#[cold]\n");
        buf_str(out, c"unsafe fn gpa_resize_slow(p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n");
        buf_str(out, c"    if new_size == 0 {\n");
        buf_str(out, c"        if old_size != 0 {\n");
        buf_str(out, c"            free(p);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        return align as *u8;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let q = gpa_aligned(new_size, align);\n");
        buf_str(out, c"    if q == 0 as *u8 {\n");
        buf_str(out, c"        return q;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    let n = if old_size < new_size { old_size } else { new_size };\n");
        buf_str(out, c"    for i in 0..n {\n");
        buf_str(out, c"        q[i] = p[i];\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    if old_size != 0 {\n");
        buf_str(out, c"        free(p);\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    q\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Gpa's leak checks (0.16; not implemented yet: --check-alloc, T3) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Gpa {\n");
        buf_str(out, c"    // The blocks allocated and not freed: -1, unknown, unless --check-alloc.\n");
        buf_str(out, c"    pub fn live_blocks(self: *Gpa) -> i64 {\n");
        buf_str(out, c"        -1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether no block is left allocated (with --check-alloc, which lists\n");
        buf_str(out, c"    // them); always true without.\n");
        buf_str(out, c"    pub fn check_leaks(self: *Gpa) -> bool {\n");
        buf_str(out, c"        true\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
    }
}

// (0.15) The index of std's sections (compiler/std/index.awk): what
// each defines and needs, so that a program's loader lexes only the
// sections it can reach (front/modules: load_std_sections).
pub fn std_index(out: i64) {
    unsafe {
