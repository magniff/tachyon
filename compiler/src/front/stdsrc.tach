        buf_str(out, c"pub const UPPER_MULTI: [u8] = \"\\x74!!\\x74!!!!!\\x67!!\\x67!!!!!\\x67!!\\x6a!!!!!\\x67!!\\x6d!\\\n");
        buf_str(out, c"    !!!!\\x67!!\\x67!!\\x6a!!\\x67!!\\x67!!\\x6d!!\\x74!!\\x75!!!!!\\x74\\\n");
        buf_str(out, c"    !!\\x75!!!!!\\x74!!\\x74!!!!!\\x56&!\\x73&!!!!\\x65&!\\x67&!\\\n");
        buf_str(out, c"    !!!\\x65&!\\x56&!!!!\\x65&!\\x5c&!!!!\\x6f&!\\x67&!!!!\\x65&\\\n");
        buf_str(out, c"    !\\x5e&!!!!\\xdd#!\\x6f!!!!!\\xba$!)$!\\x22$!\\xc6$!)$!\\x22\\\n");
        buf_str(out, c"    $!\\x6b!!-$!!!!\\x69!!\\x52$!!!!\\x75!!)$!!!!\\x78!!\\\n");
        buf_str(out, c"    +$!!!!\\x7a!!+$!!!!\\x62!!\\xdf#!!!!\\xc6$!4$!!!\\\n");
        buf_str(out, c"    !\\xc6$!4$!!$!\\xc6$!4$!\\x22$!\\xc6$!4$!\\x63$!\\xb2$!\\x63\\\n");
        buf_str(out, c"    $!!!!\\xb8$!\\x63$!!!!\\xba$!)$!!$!\\xba$!)$!\\x22$!\\\n");
        buf_str(out, c"    \\xba$!\\x63$!!!!\\xba$!)$!\\x63$!\\xc6$!)$!!$!\\xc6$!)$\\\n");
        buf_str(out, c"    !\\x22$!\\xc2$!4$!!!!\\xc6$!\\x63$!!!!\\xc6$!)$!\\x63$!\\xca\\\n");
        buf_str(out, c"    $!\\x63$!!!!)@!\\xba$!!!!*@!\\xba$!!!!+@!\\xba$!\\\n");
        buf_str(out, c"    !!!,@!\\xba$!!!!-@!\\xba$!!!!.@!\\xba$!!!!/@\\\n");
        buf_str(out, c"    !\\xba$!!!!0@!\\xba$!!!!)@!\\xba$!!!!*@!\\xba$!!\\\n");
        buf_str(out, c"    !!+@!\\xba$!!!!,@!\\xba$!!!!-@!\\xba$!!!!.@!\\\n");
        buf_str(out, c"    \\xba$!!!!/@!\\xba$!!!!0@!\\xba$!!!!\\x49@!\\xba$!!!\\\n");
        buf_str(out, c"    !\\x4a@!\\xba$!!!!\\x4b@!\\xba$!!!!\\x4c@!\\xba$!!!!\\x4d@!\\xba\\\n");
        buf_str(out, c"    $!!!!\\x4e@!\\xba$!!!!\\x4f@!\\xba$!!!!\\x50@!\\xba$!!!!\\\n");
        buf_str(out, c"    \\x49@!\\xba$!!!!\\x4a@!\\xba$!!!!\\x4b@!\\xba$!!!!\\x4c@!\\xba$\\\n");
        buf_str(out, c"    !!!!\\x4d@!\\xba$!!!!\\x4e@!\\xba$!!!!\\x4f@!\\xba$!!!!\\x50\\\n");
        buf_str(out, c"    @!\\xba$!!!!\\x89@!\\xba$!!!!\\x8a@!\\xba$!!!!\\x8b@!\\xba$!\\\n");
        buf_str(out, c"    !!!\\x8c@!\\xba$!!!!\\x8d@!\\xba$!!!!\\x8e@!\\xba$!!!!\\x8f@\\\n");
        buf_str(out, c"    !\\xba$!!!!\\x90@!\\xba$!!!!\\x89@!\\xba$!!!!\\x8a@!\\xba$!!\\\n");
        buf_str(out, c"    !!\\x8b@!\\xba$!!!!\\x8c@!\\xba$!!!!\\x8d@!\\xba$!!!!\\x8e@!\\\n");
        buf_str(out, c"    \\xba$!!!!\\x8f@!\\xba$!!!!\\x90@!\\xba$!!!!\\xb2$!\\xba$!!!\\\n");
        buf_str(out, c"    !\\xb2$!\\xba$!!!!\\xb8$!\\xba$!!!!\\xb8$!\\xba$!!!!\\xca$!\\xba\\\n");
        buf_str(out, c"    $!!!!\\xca$!\\xba$!!!!\\xdb@!\\xba$!!!!\\xa7$!\\xba$!!!!\\\n");
        buf_str(out, c"    \\xeb@!\\xba$!!!!\\xaa$!\\xba$!!!!\\x1b@!\\xba$!!!!\\xb0$!\\xba$\\\n");
        buf_str(out, c"    !!!!\\xb2$!\\x63$!\\xba$!\\xb8$!\\x63$!\\xba$!\\xca$!\\x63$!\\xba$!\";\n");
        buf_str(out, c"pub const LOWER_COUNT: i64 = 1508;\n");
        buf_str(out, c"pub const UPPER_COUNT: i64 = 1601;\n");
        buf_str(out, c"// ---- end mod std::unicode::tables ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- end mod std::unicode ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::gpu ----\n");
        buf_str(out, c"pub mod gpu {\n");
        buf_str(out, c"// std::gpu (0.22, docs/design/gpu.md): GPU support. In this release:\n");
        buf_str(out, c"// `wgsl`, the shader compiler; the API, its core and the hals (Metal,\n");
        buf_str(out, c"// Vulkan) join it from their branches.\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub mod wgsl;\n");
        buf_str(out, c"// ---- mod std::gpu::wgsl ----\n");
        buf_str(out, c"pub mod wgsl {\n");
        buf_str(out, c"// std::gpu::wgsl (0.22, docs/design/gpu.md §2.10): the shader compiler.\n");
        buf_str(out, c"// WGSL (the subset of §2.10) is parsed, resolved and type-checked into a\n");
        buf_str(out, c"// target-neutral IR (ir.tach: types, expressions, structured statements,\n");
        buf_str(out, c"// entry points; nothing of any target), every index gets its bounds check\n");
        buf_str(out, c"// (bounds.tach), and a back end writes it: MSL for Metal (msl.tach), or\n");
        buf_str(out, c"// the CPU interpreter runs it (interp.tach: the tests' oracle). SPIR-V\n");
        buf_str(out, c"// (spirv.tach) and other targets (PTX) are back ends over the same IR.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"//   var out = Buf::new_in(gpa);\n");
        buf_str(out, c"//   var refl = wgsl::new_reflection(gpa);\n");
        buf_str(out, c"//   var err = wgsl::new_error(gpa);\n");
        buf_str(out, c"//   if !wgsl::translate(src, wgsl::options(wgsl::TARGET_MSL), &out, &refl, &err, gpa) {\n");
        buf_str(out, c"//       // err: code (wgsl.*), line, col, msg, help\n");
        buf_str(out, c"//   }\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// A translation allocates from an arena of its own, freed at its end, and\n");
        buf_str(out, c"// does no io. `tools/wgslc` is the command line; tests/wgsl/run.sh runs\n");
        buf_str(out, c"// the cases on the interpreter and on Metal.\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub mod ir;\n");
        buf_str(out, c"pub mod names;\n");
        buf_str(out, c"pub mod lex;\n");
        buf_str(out, c"pub mod front;\n");
        buf_str(out, c"pub mod expr;\n");
        buf_str(out, c"pub mod builtins;\n");
        buf_str(out, c"pub mod entry;\n");
        buf_str(out, c"pub mod bounds;\n");
        buf_str(out, c"pub mod uniformity;\n");
        buf_str(out, c"pub mod msl;\n");
        buf_str(out, c"pub mod spirv;\n");
        buf_str(out, c"pub mod interp;\n");
        buf_str(out, c"pub mod dump;\n");
        buf_str(out, c"pub mod job;\n");
        buf_str(out, c"pub mod api;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub use api::{\n");
        buf_str(out, c"    BK_COMPARISON_SAMPLER, BK_READ_ONLY_STORAGE, BK_SAMPLER, BK_STORAGE, BK_STORAGE_TEXTURE,\n");
        buf_str(out, c"    BK_TEXTURE, BK_UNIFORM, BindingInfo, EntryInfo, InputInfo, Options, Reflection, ShaderError,\n");
        buf_str(out, c"    TARGET_CHECK, TARGET_IR, TARGET_MSL, TARGET_SPIRV, line_col, new_error, new_reflection, options,\n");
        buf_str(out, c"    sizes_words, translate,\n");
        buf_str(out, c"};\n");
        buf_str(out, c"// ---- mod std::gpu::wgsl::ir ----\n");
        buf_str(out, c"pub mod ir {\n");
        buf_str(out, c"// ---- Shader compiler implementation, ir (0.22) ----\n");
        buf_str(out, c"// The shader IR (docs/design/gpu.md §2.10): what the front end makes\n");
        buf_str(out, c"// from WGSL and the back ends (MSL, SPIR-V, the interpreter) read. It is\n");
        buf_str(out, c"// plain data: i64 handles into Vecs, one arena per translation.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// - Types are module-wide and interned: a handle is equal for equal types.\n");
        buf_str(out, c"//   The scalar, vector and matrix types have fixed handles (`vec_ty`,\n");
        buf_str(out, c"//   `mat_ty`); the rest are found through `types_map`.\n");
        buf_str(out, c"// - A function has an expression arena, a statement arena and blocks\n");
        buf_str(out, c"//   (runs of statement handles in `items`). Expressions are evaluated\n");
        buf_str(out, c"//   where an `S_EMIT` statement covers them, in order, except the results\n");
        buf_str(out, c"//   of calls and atomics (made by their statement) and the leaves\n");
        buf_str(out, c"//   (literals, arguments, variables), which have no cost.\n");
        buf_str(out, c"// - Every index has a bounds check (D15): `E_ACCESS.c` is the check's\n");
        buf_str(out, c"//   kind, set by bounds.tach; a back end never sees `CK_PENDING`.\n");
        buf_str(out, c"//\n");
        buf_str(out, c"// Moves to compiler/std/gpu/wgsl/ir.tach with C2 (std submodules).\n");
        buf_str(out, c"\n");
        buf_str(out, c"use std::{Allocator, Buf, Eq, Hash, HashMap, ScopedArena, Vec};\n");
        buf_str(out, c"use std::Option::{None, Some};\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Shader compiler implementation, ir: Scalars (0.22) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const SK_BOOL: u8 = 0;\n");
        buf_str(out, c"pub const SK_I32: u8 = 1;\n");
        buf_str(out, c"pub const SK_U32: u8 = 2;\n");
        buf_str(out, c"pub const SK_F32: u8 = 3;\n");
        buf_str(out, c"// Abstract numbers exist only in the front end (const evaluation).\n");
        buf_str(out, c"pub const SK_AINT: u8 = 4;\n");
        buf_str(out, c"pub const SK_AFLOAT: u8 = 5;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Shader compiler implementation, ir: Types (0.22) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const TK_SCALAR: u8 = 0;\n");
        buf_str(out, c"pub const TK_VECTOR: u8 = 1;\n");
        buf_str(out, c"// n columns of m rows of f32\n");
        buf_str(out, c"pub const TK_MATRIX: u8 = 2;\n");
        buf_str(out, c"// base: the element; n: the length, 0 when runtime-sized\n");
        buf_str(out, c"pub const TK_ARRAY: u8 = 3;\n");
        buf_str(out, c"pub const TK_STRUCT: u8 = 4;\n");
        buf_str(out, c"pub const TK_ATOMIC: u8 = 5;\n");
        buf_str(out, c"// base: the pointee; space, access\n");
        buf_str(out, c"pub const TK_POINTER: u8 = 6;\n");
        buf_str(out, c"// scalar: the sampled kind; n: TEX_*; access for storage textures; m: the texel format\n");
        buf_str(out, c"pub const TK_TEXTURE: u8 = 7;\n");
        buf_str(out, c"// n: 1 for sampler_comparison\n");
        buf_str(out, c"pub const TK_SAMPLER: u8 = 8;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const TEX_2D: i64 = 0;\n");
        buf_str(out, c"pub const TEX_2D_ARRAY: i64 = 1;\n");
        buf_str(out, c"pub const TEX_DEPTH_2D: i64 = 2;\n");
        buf_str(out, c"pub const TEX_STORAGE_2D: i64 = 3;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Texel formats of storage textures (TK_TEXTURE.m).\n");
        buf_str(out, c"pub const FMT_RGBA8UNORM: i64 = 0;\n");
        buf_str(out, c"pub const FMT_RGBA32FLOAT: i64 = 1;\n");
        buf_str(out, c"pub const FMT_R32FLOAT: i64 = 2;\n");
        buf_str(out, c"pub const FMT_R32UINT: i64 = 3;\n");
        buf_str(out, c"pub const FMT_R32SINT: i64 = 4;\n");
        buf_str(out, c"pub const FMT_RGBA32UINT: i64 = 5;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Address spaces.\n");
        buf_str(out, c"pub const SP_FUNCTION: u8 = 0;\n");
        buf_str(out, c"pub const SP_PRIVATE: u8 = 1;\n");
        buf_str(out, c"pub const SP_WORKGROUP: u8 = 2;\n");
        buf_str(out, c"pub const SP_UNIFORM: u8 = 3;\n");
        buf_str(out, c"pub const SP_STORAGE: u8 = 4;\n");
        buf_str(out, c"// textures and samplers: no address space, the global is the value\n");
        buf_str(out, c"pub const SP_HANDLE: u8 = 5;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Access modes (bits).\n");
        buf_str(out, c"pub const ACC_READ: u8 = 1;\n");
        buf_str(out, c"pub const ACC_WRITE: u8 = 2;\n");
        buf_str(out, c"pub const ACC_RW: u8 = 3;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Type {\n");
        buf_str(out, c"    kind: u8,\n");
        buf_str(out, c"    scalar: u8,\n");
        buf_str(out, c"    space: u8,\n");
        buf_str(out, c"    access: u8,\n");
        buf_str(out, c"    n: i64,\n");
        buf_str(out, c"    m: i64,\n");
        buf_str(out, c"    base: i64,\n");
        buf_str(out, c"    // struct members: members[mstart .. mstart + mcount]\n");
        buf_str(out, c"    mstart: i64,\n");
        buf_str(out, c"    mcount: i64,\n");
        buf_str(out, c"    name: [u8],\n");
        buf_str(out, c"    // the WGSL memory layout, in bytes (every type, every address space)\n");
        buf_str(out, c"    size: i64,\n");
        buf_str(out, c"    align: i64,\n");
        buf_str(out, c"    // arrays: the element stride; matrices: the column stride\n");
        buf_str(out, c"    stride: i64,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// What an entry point's parameter, result or IO struct member is bound to.\n");
        buf_str(out, c"pub const BIND_NONE: u8 = 0;\n");
        buf_str(out, c"pub const BIND_BUILTIN: u8 = 1;\n");
        buf_str(out, c"pub const BIND_LOCATION: u8 = 2;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const INTERP_PERSPECTIVE: u8 = 0;\n");
        buf_str(out, c"pub const INTERP_LINEAR: u8 = 1;\n");
        buf_str(out, c"pub const INTERP_FLAT: u8 = 2;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Binding { kind: u8, interp: u8, value: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn no_binding() -> Binding {\n");
        buf_str(out, c"    Binding { kind: BIND_NONE, interp: INTERP_PERSPECTIVE, value: 0 }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const BI_POSITION: i64 = 0;\n");
        buf_str(out, c"pub const BI_VERTEX_INDEX: i64 = 1;\n");
        buf_str(out, c"pub const BI_INSTANCE_INDEX: i64 = 2;\n");
        buf_str(out, c"pub const BI_FRONT_FACING: i64 = 3;\n");
        buf_str(out, c"pub const BI_FRAG_DEPTH: i64 = 4;\n");
        buf_str(out, c"pub const BI_SAMPLE_INDEX: i64 = 5;\n");
        buf_str(out, c"pub const BI_SAMPLE_MASK: i64 = 6;\n");
        buf_str(out, c"pub const BI_LOCAL_INVOCATION_ID: i64 = 7;\n");
        buf_str(out, c"pub const BI_LOCAL_INVOCATION_INDEX: i64 = 8;\n");
        buf_str(out, c"pub const BI_GLOBAL_INVOCATION_ID: i64 = 9;\n");
        buf_str(out, c"pub const BI_WORKGROUP_ID: i64 = 10;\n");
        buf_str(out, c"pub const BI_NUM_WORKGROUPS: i64 = 11;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct StructMember { name: [u8], ty: i64, offset: i64, binding: Binding }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Shader compiler implementation, ir: Expressions (0.22) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// a: the bits (a u32 for i32, u32, f32; 0 or 1 for bool)\n");
        buf_str(out, c"pub const E_LITERAL: u8 = 0;\n");
        buf_str(out, c"pub const E_ZERO: u8 = 1;\n");
        buf_str(out, c"// a, b: args[a .. a + b]: scalars and vectors for a vector, columns for a\n");
        buf_str(out, c"// matrix, elements, members\n");
        buf_str(out, c"pub const E_COMPOSE: u8 = 2;\n");
        buf_str(out, c"// a: a scalar\n");
        buf_str(out, c"pub const E_SPLAT: u8 = 3;\n");
        buf_str(out, c"// a: the vector; b: the components, 2 bits each from bit 0; c: how many\n");
        buf_str(out, c"pub const E_SWIZZLE: u8 = 4;\n");
        buf_str(out, c"// a: base (a pointer or a value); b: the index expression; c: CK_*;\n");
        buf_str(out, c"// d: the length when the check is a clamp\n");
        buf_str(out, c"pub const E_ACCESS: u8 = 5;\n");
        buf_str(out, c"// a: base (a pointer or a value); b: the constant index (a member, or a\n");
        buf_str(out, c"// component of a vector, matrix or fixed-size array, checked statically)\n");
        buf_str(out, c"pub const E_ACCESS_INDEX: u8 = 6;\n");
        buf_str(out, c"// a: the parameter's index\n");
        buf_str(out, c"pub const E_ARG: u8 = 7;\n");
        buf_str(out, c"// a: the global; its type is a pointer (a texture or sampler: the handle)\n");
        buf_str(out, c"pub const E_GLOBAL: u8 = 8;\n");
        buf_str(out, c"// a: the local; a pointer<function>\n");
        buf_str(out, c"pub const E_LOCAL: u8 = 9;\n");
        buf_str(out, c"// a: the pointer\n");
        buf_str(out, c"pub const E_LOAD: u8 = 10;\n");
        buf_str(out, c"// a: UN_*; b: the operand\n");
        buf_str(out, c"pub const E_UNARY: u8 = 11;\n");
        buf_str(out, c"// a: OP_*; b, c: the operands\n");
        buf_str(out, c"pub const E_BINARY: u8 = 12;\n");
        buf_str(out, c"// a: the condition (bool, or a vector of bool); b: if true; c: if false\n");
        buf_str(out, c"pub const E_SELECT: u8 = 13;\n");
        buf_str(out, c"// a: MF_*; b, c: args[b .. b + c]\n");
        buf_str(out, c"pub const E_MATH: u8 = 14;\n");
        buf_str(out, c"// a: the operand; the type is the target (value conversion)\n");
        buf_str(out, c"pub const E_CONVERT: u8 = 15;\n");
        buf_str(out, c"// a: the operand; the type is the target (bits)\n");
        buf_str(out, c"pub const E_BITCAST: u8 = 16;\n");
        buf_str(out, c"// made by S_CALL\n");
        buf_str(out, c"pub const E_CALL_RESULT: u8 = 17;\n");
        buf_str(out, c"// made by S_ATOMIC\n");
        buf_str(out, c"pub const E_ATOMIC_RESULT: u8 = 18;\n");
        buf_str(out, c"// a: a pointer to a runtime-sized array (or a struct ending in one: b is\n");
        buf_str(out, c"// then the member index, else -1)\n");
        buf_str(out, c"pub const E_ARRAY_LENGTH: u8 = 19;\n");
        buf_str(out, c"// a: DV_*; b: the operand\n");
        buf_str(out, c"pub const E_DERIVATIVE: u8 = 20;\n");
        buf_str(out, c"// a: the texture; b: the sampler; c: args[c .. c + d] (coords, then\n");
        buf_str(out, c"// array index, bias/level/depth ref as `aux`): see IMG_*\n");
        buf_str(out, c"pub const E_IMAGE_SAMPLE: u8 = 21;\n");
        buf_str(out, c"// a: the texture; c: args (coords, array index, level)\n");
        buf_str(out, c"pub const E_IMAGE_LOAD: u8 = 22;\n");
        buf_str(out, c"// a: the texture; b: IQ_*; c: the level expression or -1\n");
        buf_str(out, c"pub const E_IMAGE_QUERY: u8 = 23;\n");
        buf_str(out, c"// a: the pointer; made by S_WG_UNIFORM_LOAD\n");
        buf_str(out, c"pub const E_WG_UNIFORM_RESULT: u8 = 24;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Bounds checks of E_ACCESS.\n");
        buf_str(out, c"pub const CK_PENDING: i64 = 0;\n");
        buf_str(out, c"// proven in range: no check\n");
        buf_str(out, c"pub const CK_NONE: i64 = 1;\n");
        buf_str(out, c"// fixed length d: index = min(index, d - 1)\n");
        buf_str(out, c"pub const CK_CLAMP: i64 = 2;\n");
        buf_str(out, c"// runtime-sized: out of range, a load reads zero and a store is skipped\n");
        buf_str(out, c"pub const CK_RZSW: i64 = 3;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const UN_NEG: i64 = 0;\n");
        buf_str(out, c"pub const UN_NOT: i64 = 1;\n");
        buf_str(out, c"pub const UN_BITNOT: i64 = 2;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const OP_ADD: i64 = 0;\n");
        buf_str(out, c"pub const OP_SUB: i64 = 1;\n");
        buf_str(out, c"pub const OP_MUL: i64 = 2;\n");
        buf_str(out, c"pub const OP_DIV: i64 = 3;\n");
        buf_str(out, c"pub const OP_MOD: i64 = 4;\n");
        buf_str(out, c"pub const OP_EQ: i64 = 5;\n");
        buf_str(out, c"pub const OP_NE: i64 = 6;\n");
        buf_str(out, c"pub const OP_LT: i64 = 7;\n");
        buf_str(out, c"pub const OP_LE: i64 = 8;\n");
        buf_str(out, c"pub const OP_GT: i64 = 9;\n");
        buf_str(out, c"pub const OP_GE: i64 = 10;\n");
        buf_str(out, c"// bitwise on integers; logical (both operands evaluated) on bool\n");
        buf_str(out, c"pub const OP_AND: i64 = 11;\n");
        buf_str(out, c"pub const OP_OR: i64 = 12;\n");
        buf_str(out, c"pub const OP_XOR: i64 = 13;\n");
        buf_str(out, c"pub const OP_SHL: i64 = 14;\n");
        buf_str(out, c"pub const OP_SHR: i64 = 15;\n");
        buf_str(out, c"// short-circuit forms are lowered to control flow when the right side\n");
        buf_str(out, c"// has effects; else they are these, on bool\n");
        buf_str(out, c"pub const OP_LAND: i64 = 16;\n");
        buf_str(out, c"pub const OP_LOR: i64 = 17;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Math functions (E_MATH). Component-wise unless noted.\n");
        buf_str(out, c"pub const MF_ABS: i64 = 0;\n");
        buf_str(out, c"pub const MF_MIN: i64 = 1;\n");
        buf_str(out, c"pub const MF_MAX: i64 = 2;\n");
        buf_str(out, c"pub const MF_CLAMP: i64 = 3;\n");
        buf_str(out, c"pub const MF_SIGN: i64 = 4;\n");
        buf_str(out, c"pub const MF_FLOOR: i64 = 5;\n");
        buf_str(out, c"pub const MF_CEIL: i64 = 6;\n");
        buf_str(out, c"pub const MF_ROUND: i64 = 7;\n");
        buf_str(out, c"pub const MF_FRACT: i64 = 8;\n");
        buf_str(out, c"pub const MF_TRUNC: i64 = 9;\n");
        buf_str(out, c"pub const MF_SQRT: i64 = 10;\n");
        buf_str(out, c"pub const MF_INVERSE_SQRT: i64 = 11;\n");
        buf_str(out, c"pub const MF_EXP: i64 = 12;\n");
        buf_str(out, c"pub const MF_EXP2: i64 = 13;\n");
        buf_str(out, c"pub const MF_LOG: i64 = 14;\n");
        buf_str(out, c"pub const MF_LOG2: i64 = 15;\n");
        buf_str(out, c"pub const MF_POW: i64 = 16;\n");
        buf_str(out, c"pub const MF_SIN: i64 = 17;\n");
        buf_str(out, c"pub const MF_COS: i64 = 18;\n");
        buf_str(out, c"pub const MF_TAN: i64 = 19;\n");
        buf_str(out, c"pub const MF_ASIN: i64 = 20;\n");
        buf_str(out, c"pub const MF_ACOS: i64 = 21;\n");
        buf_str(out, c"pub const MF_ATAN: i64 = 22;\n");
        buf_str(out, c"pub const MF_ATAN2: i64 = 23;\n");
        buf_str(out, c"pub const MF_SINH: i64 = 24;\n");
        buf_str(out, c"pub const MF_COSH: i64 = 25;\n");
        buf_str(out, c"pub const MF_TANH: i64 = 26;\n");
        buf_str(out, c"pub const MF_MIX: i64 = 27;\n");
        buf_str(out, c"pub const MF_STEP: i64 = 28;\n");
        buf_str(out, c"pub const MF_SMOOTHSTEP: i64 = 29;\n");
        buf_str(out, c"pub const MF_FMA: i64 = 30;\n");
        buf_str(out, c"// the rest reduce or are not component-wise\n");
        buf_str(out, c"pub const MF_LENGTH: i64 = 31;\n");
        buf_str(out, c"pub const MF_DISTANCE: i64 = 32;\n");
        buf_str(out, c"pub const MF_DOT: i64 = 33;\n");
        buf_str(out, c"pub const MF_CROSS: i64 = 34;\n");
        buf_str(out, c"pub const MF_NORMALIZE: i64 = 35;\n");
        buf_str(out, c"pub const MF_REFLECT: i64 = 36;\n");
        buf_str(out, c"pub const MF_DETERMINANT: i64 = 37;\n");
        buf_str(out, c"pub const MF_TRANSPOSE: i64 = 38;\n");
        buf_str(out, c"pub const MF_COUNT_ONE_BITS: i64 = 39;\n");
        buf_str(out, c"pub const MF_COUNT_LEADING_ZEROS: i64 = 40;\n");
        buf_str(out, c"pub const MF_COUNT_TRAILING_ZEROS: i64 = 41;\n");
        buf_str(out, c"pub const MF_FIRST_LEADING_BIT: i64 = 42;\n");
        buf_str(out, c"pub const MF_FIRST_TRAILING_BIT: i64 = 43;\n");
        buf_str(out, c"pub const MF_REVERSE_BITS: i64 = 44;\n");
        buf_str(out, c"pub const MF_EXTRACT_BITS: i64 = 45;\n");
        buf_str(out, c"pub const MF_INSERT_BITS: i64 = 46;\n");
        buf_str(out, c"pub const MF_ALL: i64 = 47;\n");
        buf_str(out, c"pub const MF_ANY: i64 = 48;\n");
        buf_str(out, c"pub const MF_DEGREES: i64 = 49;\n");
        buf_str(out, c"pub const MF_RADIANS: i64 = 50;\n");
        buf_str(out, c"pub const MF_SATURATE: i64 = 51;\n");
        buf_str(out, c"pub const MF_PACK4X8UNORM: i64 = 52;\n");
        buf_str(out, c"pub const MF_UNPACK4X8UNORM: i64 = 53;\n");
        buf_str(out, c"pub const MF_PACK2X16FLOAT: i64 = 54;\n");
        buf_str(out, c"pub const MF_UNPACK2X16FLOAT: i64 = 55;\n");
        buf_str(out, c"pub const MF_ASINH: i64 = 56;\n");
        buf_str(out, c"pub const MF_ACOSH: i64 = 57;\n");
        buf_str(out, c"pub const MF_ATANH: i64 = 58;\n");
        buf_str(out, c"pub const MF_FACE_FORWARD: i64 = 59;\n");
        buf_str(out, c"pub const MF_LDEXP: i64 = 60;\n");
        buf_str(out, c"pub const MF_PACK4X8SNORM: i64 = 61;\n");
        buf_str(out, c"pub const MF_UNPACK4X8SNORM: i64 = 62;\n");
        buf_str(out, c"pub const MF_PACK2X16UNORM: i64 = 63;\n");
        buf_str(out, c"pub const MF_UNPACK2X16UNORM: i64 = 64;\n");
        buf_str(out, c"pub const MF_PACK2X16SNORM: i64 = 65;\n");
        buf_str(out, c"pub const MF_UNPACK2X16SNORM: i64 = 66;\n");
        buf_str(out, c"pub const MF_COUNT: i64 = 67;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const DV_DPDX: i64 = 0;\n");
        buf_str(out, c"pub const DV_DPDY: i64 = 1;\n");
        buf_str(out, c"pub const DV_FWIDTH: i64 = 2;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// E_IMAGE_SAMPLE kinds (Expr.d's low byte) and its args: the coordinates,\n");
        buf_str(out, c"// then the array index when the texture is an array, then the kind's\n");
        buf_str(out, c"// operand (bias, level, depth reference).\n");
        buf_str(out, c"pub const IMG_SAMPLE: i64 = 0;\n");
        buf_str(out, c"pub const IMG_SAMPLE_BIAS: i64 = 1;\n");
        buf_str(out, c"pub const IMG_SAMPLE_LEVEL: i64 = 2;\n");
        buf_str(out, c"pub const IMG_SAMPLE_COMPARE: i64 = 3;\n");
        buf_str(out, c"pub const IMG_SAMPLE_COMPARE_LEVEL: i64 = 4;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const IQ_SIZE: i64 = 0;\n");
        buf_str(out, c"pub const IQ_LEVELS: i64 = 1;\n");
        buf_str(out, c"pub const IQ_LAYERS: i64 = 2;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Expr { op: u8, ty: i64, a: i64, b: i64, c: i64, d: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Shader compiler implementation, ir: Statements (0.22) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"// a .. b: the expressions evaluated here, in order\n");
        buf_str(out, c"pub const S_EMIT: u8 = 0;\n");
        buf_str(out, c"// a: the block\n");
        buf_str(out, c"pub const S_BLOCK: u8 = 1;\n");
        buf_str(out, c"// a: the condition; b: then; c: else (a block, possibly empty)\n");
        buf_str(out, c"pub const S_IF: u8 = 2;\n");
        buf_str(out, c"// a: the selector (i32 or u32); b, c: cases[b .. b + c]\n");
        buf_str(out, c"pub const S_SWITCH: u8 = 3;\n");
        buf_str(out, c"// a: body; b: continuing; c: the break-if expression, or -1 (evaluated\n");
        buf_str(out, c"// at the end of continuing, after its emits)\n");
        buf_str(out, c"pub const S_LOOP: u8 = 4;\n");
        buf_str(out, c"pub const S_BREAK: u8 = 5;\n");
        buf_str(out, c"pub const S_CONTINUE: u8 = 6;\n");
        buf_str(out, c"// a: the value, or -1\n");
        buf_str(out, c"pub const S_RETURN: u8 = 7;\n");
        buf_str(out, c"// discard\n");
        buf_str(out, c"pub const S_KILL: u8 = 8;\n");
        buf_str(out, c"// a: BARRIER_* bits\n");
        buf_str(out, c"pub const S_BARRIER: u8 = 9;\n");
        buf_str(out, c"// a: the pointer; b: the value\n");
        buf_str(out, c"pub const S_STORE: u8 = 10;\n");
        buf_str(out, c"// a: the function; b, c: args[b .. b + c]; d: the E_CALL_RESULT or -1\n");
        buf_str(out, c"pub const S_CALL: u8 = 11;\n");
        buf_str(out, c"// a: the pointer; b: AT_*; c: the value; d: the E_ATOMIC_RESULT or -1;\n");
        buf_str(out, c"// e: the comparand (AT_CMPXCHG) or -1\n");
        buf_str(out, c"pub const S_ATOMIC: u8 = 12;\n");
        buf_str(out, c"// a: the texture; b: the coordinates; c: the value; d: the array index or -1\n");
        buf_str(out, c"pub const S_IMAGE_STORE: u8 = 13;\n");
        buf_str(out, c"// a: the pointer; b: the E_WG_UNIFORM_RESULT\n");
        buf_str(out, c"pub const S_WG_UNIFORM_LOAD: u8 = 14;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const BARRIER_WORKGROUP: i64 = 1;\n");
        buf_str(out, c"pub const BARRIER_STORAGE: i64 = 2;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const AT_ADD: i64 = 0;\n");
        buf_str(out, c"pub const AT_SUB: i64 = 1;\n");
        buf_str(out, c"pub const AT_AND: i64 = 2;\n");
        buf_str(out, c"pub const AT_OR: i64 = 3;\n");
        buf_str(out, c"pub const AT_XOR: i64 = 4;\n");
        buf_str(out, c"pub const AT_MIN: i64 = 5;\n");
        buf_str(out, c"pub const AT_MAX: i64 = 6;\n");
        buf_str(out, c"pub const AT_EXCHANGE: i64 = 7;\n");
        buf_str(out, c"pub const AT_LOAD: i64 = 8;\n");
        buf_str(out, c"pub const AT_STORE: i64 = 9;\n");
        buf_str(out, c"// the result is __atomic_compare_exchange_result: { old_value, exchanged }\n");
        buf_str(out, c"pub const AT_CMPXCHG: i64 = 10;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Stmt { op: u8, a: i64, b: i64, c: i64, d: i64, e: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A switch clause: its selector values (vals[vstart .. vstart + vcount]),\n");
        buf_str(out, c"// whether it is the default, its body.\n");
        buf_str(out, c"pub struct Case { vstart: i64, vcount: i64, is_default: bool, body: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"// A run of statement handles: items[start .. start + count].\n");
        buf_str(out, c"pub struct Block { start: i64, count: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Param { name: [u8], ty: i64, binding: Binding }\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Local { name: [u8], ty: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub type V<T> = Vec<T, ScopedArena>;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Function {\n");
        buf_str(out, c"    name: [u8],\n");
        buf_str(out, c"    params: V<Param>,\n");
        buf_str(out, c"    // -1: no result\n");
        buf_str(out, c"    result: i64,\n");
        buf_str(out, c"    result_binding: Binding,\n");
        buf_str(out, c"    locals: V<Local>,\n");
        buf_str(out, c"    exprs: V<Expr>,\n");
        buf_str(out, c"    // the names of `let` declarations: names[e] for expression e, or \"\"\n");
        buf_str(out, c"    names: V<[u8]>,\n");
        buf_str(out, c"    stmts: V<Stmt>,\n");
        buf_str(out, c"    blocks: V<Block>,\n");
        buf_str(out, c"    items: V<i64>,\n");
        buf_str(out, c"    args: V<i64>,\n");
        buf_str(out, c"    cases: V<Case>,\n");
        buf_str(out, c"    vals: V<i64>,\n");
        buf_str(out, c"    body: i64,\n");
        buf_str(out, c"    // the source position of the declaration (a byte offset)\n");
        buf_str(out, c"    pos: i64,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Global {\n");
        buf_str(out, c"    name: [u8],\n");
        buf_str(out, c"    space: u8,\n");
        buf_str(out, c"    access: u8,\n");
        buf_str(out, c"    // the value's type (a texture, a sampler, or what the pointer points to)\n");
        buf_str(out, c"    ty: i64,\n");
        buf_str(out, c"    group: i64,\n");
        buf_str(out, c"    binding: i64,\n");
        buf_str(out, c"    // private globals: an expression of the module's init function, or -1\n");
        buf_str(out, c"    init: i64,\n");
        buf_str(out, c"    pos: i64,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const STAGE_VERTEX: u8 = 0;\n");
        buf_str(out, c"pub const STAGE_FRAGMENT: u8 = 1;\n");
        buf_str(out, c"pub const STAGE_COMPUTE: u8 = 2;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Entry { stage: u8, name: [u8], func: i64, wg: [i64; 3], early_depth: bool }\n");
        buf_str(out, c"\n");
        buf_str(out, c"#[derive(Eq, Hash)]\n");
        buf_str(out, c"pub struct TypeKey { kind: u8, scalar: u8, space: u8, access: u8, n: i64, m: i64, base: i64 }\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub struct Module {\n");
        buf_str(out, c"    types: V<Type>,\n");
        buf_str(out, c"    types_map: HashMap<TypeKey, i64, ScopedArena>,\n");
        buf_str(out, c"    members: V<StructMember>,\n");
        buf_str(out, c"    globals: V<Global>,\n");
        buf_str(out, c"    functions: V<Function>,\n");
        buf_str(out, c"    entries: V<Entry>,\n");
        buf_str(out, c"    // private globals' initializers live in this function's expressions\n");
        buf_str(out, c"    // (literals, zero, compose only)\n");
        buf_str(out, c"    consts: Function,\n");
        buf_str(out, c"    a: ScopedArena,\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Shader compiler implementation, ir: Fixed type handles (0.22) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const T_BOOL: i64 = 0;\n");
        buf_str(out, c"pub const T_I32: i64 = 1;\n");
        buf_str(out, c"pub const T_U32: i64 = 2;\n");
        buf_str(out, c"pub const T_F32: i64 = 3;\n");
        buf_str(out, c"\n");
        buf_str(out, c"// vecN<scalar>: 4 + (n - 2) * 4 + scalar, for n in 2..4 and the four\n");
        buf_str(out, c"// concrete scalars\n");
        buf_str(out, c"pub fn vec_ty(sk: u8, n: i64) -> i64 {\n");
        buf_str(out, c"    if n == 1 {\n");
        buf_str(out, c"        return sk as i64;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    4 + (n - 2) * 4 + sk as i64\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// matCxR<f32>: 16 + (c - 2) * 3 + (r - 2)\n");
        buf_str(out, c"pub fn mat_ty(c: i64, r: i64) -> i64 { 16 + (c - 2) * 3 + (r - 2) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const T_FIXED_COUNT: i64 = 25;\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn new_function(name: [u8], a: ScopedArena) -> Function {\n");
        buf_str(out, c"    Function {\n");
        buf_str(out, c"        name: name,\n");
        buf_str(out, c"        params: Vec::new_in(a),\n");
        buf_str(out, c"        result: -1,\n");
        buf_str(out, c"        result_binding: no_binding(),\n");
        buf_str(out, c"        locals: Vec::new_in(a),\n");
        buf_str(out, c"        exprs: Vec::new_in(a),\n");
        buf_str(out, c"        names: Vec::new_in(a),\n");
        buf_str(out, c"        stmts: Vec::new_in(a),\n");
        buf_str(out, c"        blocks: Vec::new_in(a),\n");
        buf_str(out, c"        items: Vec::new_in(a),\n");
        buf_str(out, c"        args: Vec::new_in(a),\n");
        buf_str(out, c"        cases: Vec::new_in(a),\n");
        buf_str(out, c"        vals: Vec::new_in(a),\n");
        buf_str(out, c"        body: -1,\n");
        buf_str(out, c"        pos: 0,\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"fn round_up(x: i64, a: i64) -> i64 { (x + a - 1) / a * a }\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Module {\n");
        buf_str(out, c"    pub fn new(a: ScopedArena) -> Module {\n");
        buf_str(out, c"        var m = Module {\n");
        buf_str(out, c"            types: Vec::new_in(a),\n");
        buf_str(out, c"            types_map: HashMap::new_in(a),\n");
        buf_str(out, c"            members: Vec::new_in(a),\n");
        buf_str(out, c"            globals: Vec::new_in(a),\n");
        buf_str(out, c"            functions: Vec::new_in(a),\n");
        buf_str(out, c"            entries: Vec::new_in(a),\n");
        buf_str(out, c"            consts: new_function(\"\", a),\n");
        buf_str(out, c"            a: a,\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        for sk in 0..4 {\n");
        buf_str(out, c"            m.push_type(TK_SCALAR, sk as u8, 1, 1, -1);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for n in 2..5 {\n");
        buf_str(out, c"            for sk in 0..4 {\n");
        buf_str(out, c"                m.push_type(TK_VECTOR, sk as u8, n, 1, -1);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        for c in 2..5 {\n");
        buf_str(out, c"            for r in 2..5 {\n");
        buf_str(out, c"                m.push_type(TK_MATRIX, SK_F32, c, r, -1);\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        m\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    fn push_type(inout self, kind: u8, sk: u8, n: i64, mm: i64, base: i64) -> i64 {\n");
        buf_str(out, c"        var t = Type {\n");
        buf_str(out, c"            kind: kind,\n");
        buf_str(out, c"            scalar: sk,\n");
        buf_str(out, c"            space: 0,\n");
        buf_str(out, c"            access: 0,\n");
        buf_str(out, c"            n: n,\n");
        buf_str(out, c"            m: mm,\n");
        buf_str(out, c"            base: base,\n");
        buf_str(out, c"            mstart: 0,\n");
        buf_str(out, c"            mcount: 0,\n");
        buf_str(out, c"            name: \"\",\n");
        buf_str(out, c"            size: 4,\n");
        buf_str(out, c"            align: 4,\n");
        buf_str(out, c"            stride: 0,\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        if kind == TK_VECTOR {\n");
        buf_str(out, c"            t.size = 4 * n;\n");
        buf_str(out, c"            t.align = if n == 2 { 8 } else { 16 };\n");
        buf_str(out, c"        } else if kind == TK_MATRIX {\n");
        buf_str(out, c"            let col_align = if mm == 2 { 8 } else { 16 };\n");
        buf_str(out, c"            t.align = col_align;\n");
        buf_str(out, c"            t.stride = round_up(4 * mm, col_align);\n");
        buf_str(out, c"            t.size = n * t.stride;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.types.push(t);\n");
        buf_str(out, c"        self.types.len() - 1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The handle of a type made of these parts, made once.\n");
        buf_str(out, c"    pub fn intern(inout self, kind: u8, sk: u8, n: i64, mm: i64, base: i64, space: u8,\n");
        buf_str(out, c"        access: u8) -> i64 {\n");
        buf_str(out, c"        if kind == TK_SCALAR {\n");
        buf_str(out, c"            return sk as i64;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if kind == TK_VECTOR {\n");
        buf_str(out, c"            return vec_ty(sk, n);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if kind == TK_MATRIX {\n");
        buf_str(out, c"            return mat_ty(n, mm);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let key = TypeKey {\n");
        buf_str(out, c"            kind: kind, scalar: sk, space: space, access: access, n: n, m: mm, base: base\n");
        buf_str(out, c"        };\n");
        buf_str(out, c"        if let Some(h) = self.types_map.get(key) {\n");
        buf_str(out, c"            return h;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let h = self.push_type(kind, sk, n, mm, base);\n");
        buf_str(out, c"        self.types[h].space = space;\n");
        buf_str(out, c"        self.types[h].access = access;\n");
        buf_str(out, c"        if kind == TK_ARRAY {\n");
        buf_str(out, c"            let el = self.types[base];\n");
        buf_str(out, c"            let stride = round_up(el.size, el.align);\n");
        buf_str(out, c"            self.types[h].align = el.align;\n");
        buf_str(out, c"            self.types[h].stride = stride;\n");
        buf_str(out, c"            self.types[h].size = if n == 0 { stride } else { stride * n };\n");
        buf_str(out, c"        } else if kind == TK_POINTER {\n");
        buf_str(out, c"            self.types[h].size = 8;\n");
        buf_str(out, c"            self.types[h].align = 8;\n");
        buf_str(out, c"        } else if kind == TK_TEXTURE || kind == TK_SAMPLER {\n");
        buf_str(out, c"            self.types[h].size = 8;\n");
        buf_str(out, c"            self.types[h].align = 8;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.types_map.insert(key, h);\n");
        buf_str(out, c"        h\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn array_ty(inout self, elem: i64, n: i64) -> i64 {\n");
        buf_str(out, c"        self.intern(TK_ARRAY, 0, n, 0, elem, 0, 0)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn ptr_ty(inout self, pointee: i64, space: u8, access: u8) -> i64 {\n");
        buf_str(out, c"        self.intern(TK_POINTER, 0, 0, 0, pointee, space, access)\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn atomic_ty(inout self, sk: u8) -> i64 { self.intern(TK_ATOMIC, sk, 0, 0, -1, 0, 0) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A struct type: a new handle for each declaration (structs are\n");
        buf_str(out, c"    // nominal); members[mstart ..] must already be pushed, offsets unset.\n");
        buf_str(out, c"    pub fn struct_ty(inout self, name: [u8], mstart: i64, mcount: i64) -> i64 {\n");
        buf_str(out, c"        let h = self.push_type(TK_STRUCT, 0, 0, 0, -1);\n");
        buf_str(out, c"        var off = 0;\n");
        buf_str(out, c"        var al = 4;\n");
        buf_str(out, c"        for i in mstart..mstart + mcount {\n");
        buf_str(out, c"            let t = self.types[self.members[i].ty];\n");
        buf_str(out, c"            off = round_up(off, t.align);\n");
        buf_str(out, c"            self.members[i].offset = off;\n");
        buf_str(out, c"            off += t.size;\n");
        buf_str(out, c"            if t.align > al {\n");
        buf_str(out, c"                al = t.align;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        self.types[h].name = name;\n");
        buf_str(out, c"        self.types[h].mstart = mstart;\n");
        buf_str(out, c"        self.types[h].mcount = mcount;\n");
        buf_str(out, c"        self.types[h].align = al;\n");
        buf_str(out, c"        self.types[h].size = round_up(off, al);\n");
        buf_str(out, c"        h\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The scalar kind of a scalar, vector, matrix or atomic type.\n");
        buf_str(out, c"    pub fn scalar_of(self, t: i64) -> u8 { self.types[t].scalar }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The component count of a scalar (1) or vector type, else 0.\n");
        buf_str(out, c"    pub fn width_of(self, t: i64) -> i64 {\n");
        buf_str(out, c"        let k = self.types[t].kind;\n");
        buf_str(out, c"        if k == TK_SCALAR {\n");
        buf_str(out, c"            1\n");
        buf_str(out, c"        } else if k == TK_VECTOR {\n");
        buf_str(out, c"            self.types[t].n\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            0\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The pointee of a pointer type, else -1.\n");
        buf_str(out, c"    pub fn pointee(self, t: i64) -> i64 {\n");
        buf_str(out, c"        if self.types[t].kind == TK_POINTER {\n");
        buf_str(out, c"            self.types[t].base\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            -1\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The type of a component of t when indexed: a vector's scalar, a\n");
        buf_str(out, c"    // matrix's column, an array's element; -1 for the others.\n");
        buf_str(out, c"    pub fn elem_of(self, t: i64) -> i64 {\n");
        buf_str(out, c"        let ty = self.types[t];\n");
        buf_str(out, c"        if ty.kind == TK_VECTOR {\n");
        buf_str(out, c"            ty.scalar as i64\n");
        buf_str(out, c"        } else if ty.kind == TK_MATRIX {\n");
        buf_str(out, c"            vec_ty(SK_F32, ty.m)\n");
        buf_str(out, c"        } else if ty.kind == TK_ARRAY {\n");
        buf_str(out, c"            ty.base\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            -1\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // How many components indexing t can reach: 0 for a runtime-sized array.\n");
        buf_str(out, c"    pub fn index_len(self, t: i64) -> i64 {\n");
        buf_str(out, c"        let ty = self.types[t];\n");
        buf_str(out, c"        if ty.kind == TK_VECTOR || ty.kind == TK_ARRAY {\n");
        buf_str(out, c"            ty.n\n");
        buf_str(out, c"        } else if ty.kind == TK_MATRIX {\n");
        buf_str(out, c"            ty.n\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            -1\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether t is or holds a runtime-sized array.\n");
        buf_str(out, c"    pub fn is_runtime_sized(self, t: i64) -> bool {\n");
        buf_str(out, c"        let ty = self.types[t];\n");
        buf_str(out, c"        if ty.kind == TK_ARRAY {\n");
        buf_str(out, c"            return ty.n == 0;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if ty.kind == TK_STRUCT && ty.mcount > 0 {\n");
        buf_str(out, c"            return self.is_runtime_sized(self.members[ty.mstart + ty.mcount - 1].ty);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // Whether t contains an atomic (such types cannot be loaded whole).\n");
        buf_str(out, c"    pub fn has_atomic(self, t: i64) -> bool {\n");
        buf_str(out, c"        let ty = self.types[t];\n");
        buf_str(out, c"        if ty.kind == TK_ATOMIC {\n");
        buf_str(out, c"            return true;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if ty.kind == TK_ARRAY {\n");
        buf_str(out, c"            return self.has_atomic(ty.base);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        if ty.kind == TK_STRUCT {\n");
        buf_str(out, c"            for i in ty.mstart..ty.mstart + ty.mcount {\n");
        buf_str(out, c"                if self.has_atomic(self.members[i].ty) {\n");
        buf_str(out, c"                    return true;\n");
        buf_str(out, c"                }\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        false\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // The type written as WGSL, for messages and the IR dump.\n");
        buf_str(out, c"    pub fn type_name<A: Allocator>(self, t: i64, b: inout Buf<A>) {\n");
        buf_str(out, c"        if t < 0 {\n");
        buf_str(out, c"            b.push_str(\"void\");\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let ty = self.types[t];\n");
        buf_str(out, c"        if ty.kind == TK_SCALAR {\n");
        buf_str(out, c"            b.push_str(scalar_name(ty.scalar));\n");
        buf_str(out, c"        } else if ty.kind == TK_VECTOR {\n");
        buf_str(out, c"            b.push_fmt(f\"vec{ty.n}<{scalar_name(ty.scalar)}>\");\n");
        buf_str(out, c"        } else if ty.kind == TK_MATRIX {\n");
        buf_str(out, c"            b.push_fmt(f\"mat{ty.n}x{ty.m}<f32>\");\n");
        buf_str(out, c"        } else if ty.kind == TK_ARRAY {\n");
        buf_str(out, c"            b.push_str(\"array<\");\n");
        buf_str(out, c"            self.type_name(ty.base, &b);\n");
        buf_str(out, c"            if ty.n > 0 {\n");
        buf_str(out, c"                b.push_fmt(f\", {ty.n}\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            b.push('>');\n");
        buf_str(out, c"        } else if ty.kind == TK_STRUCT {\n");
        buf_str(out, c"            b.push_str(ty.name);\n");
        buf_str(out, c"        } else if ty.kind == TK_ATOMIC {\n");
        buf_str(out, c"            b.push_fmt(f\"atomic<{scalar_name(ty.scalar)}>\");\n");
        buf_str(out, c"        } else if ty.kind == TK_POINTER {\n");
        buf_str(out, c"            b.push_fmt(f\"ptr<{space_name(ty.space)}, \");\n");
        buf_str(out, c"            self.type_name(ty.base, &b);\n");
        buf_str(out, c"            if ty.space == SP_STORAGE {\n");
        buf_str(out, c"                b.push_str(if ty.access == ACC_RW { \", read_write\" } else { \", read\" });\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"            b.push('>');\n");
        buf_str(out, c"        } else if ty.kind == TK_TEXTURE {\n");
        buf_str(out, c"            if ty.n == TEX_2D {\n");
        buf_str(out, c"                b.push_fmt(f\"texture_2d<{scalar_name(ty.scalar)}>\");\n");
        buf_str(out, c"            } else if ty.n == TEX_2D_ARRAY {\n");
        buf_str(out, c"                b.push_fmt(f\"texture_2d_array<{scalar_name(ty.scalar)}>\");\n");
        buf_str(out, c"            } else if ty.n == TEX_DEPTH_2D {\n");
        buf_str(out, c"                b.push_str(\"texture_depth_2d\");\n");
        buf_str(out, c"            } else {\n");
        buf_str(out, c"                b.push_fmt(f\"texture_storage_2d<{format_name(ty.m)}, write>\");\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        } else if ty.n == 1 {\n");
        buf_str(out, c"            b.push_str(\"sampler_comparison\");\n");
        buf_str(out, c"        } else {\n");
        buf_str(out, c"            b.push_str(\"sampler\");\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn scalar_name(sk: u8) -> [u8] {\n");
        buf_str(out, c"    if sk == SK_BOOL {\n");
        buf_str(out, c"        \"bool\"\n");
        buf_str(out, c"    } else if sk == SK_I32 {\n");
        buf_str(out, c"        \"i32\"\n");
        buf_str(out, c"    } else if sk == SK_U32 {\n");
        buf_str(out, c"        \"u32\"\n");
        buf_str(out, c"    } else if sk == SK_F32 {\n");
        buf_str(out, c"        \"f32\"\n");
        buf_str(out, c"    } else if sk == SK_AINT {\n");
        buf_str(out, c"        \"abstract-int\"\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        \"abstract-float\"\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn space_name(sp: u8) -> [u8] {\n");
        buf_str(out, c"    if sp == SP_FUNCTION {\n");
        buf_str(out, c"        \"function\"\n");
        buf_str(out, c"    } else if sp == SP_PRIVATE {\n");
        buf_str(out, c"        \"private\"\n");
        buf_str(out, c"    } else if sp == SP_WORKGROUP {\n");
        buf_str(out, c"        \"workgroup\"\n");
        buf_str(out, c"    } else if sp == SP_UNIFORM {\n");
        buf_str(out, c"        \"uniform\"\n");
        buf_str(out, c"    } else if sp == SP_STORAGE {\n");
        buf_str(out, c"        \"storage\"\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        \"handle\"\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn format_name(f: i64) -> [u8] {\n");
        buf_str(out, c"    if f == FMT_RGBA8UNORM {\n");
        buf_str(out, c"        \"rgba8unorm\"\n");
        buf_str(out, c"    } else if f == FMT_RGBA32FLOAT {\n");
        buf_str(out, c"        \"rgba32float\"\n");
        buf_str(out, c"    } else if f == FMT_R32FLOAT {\n");
        buf_str(out, c"        \"r32float\"\n");
        buf_str(out, c"    } else if f == FMT_R32UINT {\n");
        buf_str(out, c"        \"r32uint\"\n");
        buf_str(out, c"    } else if f == FMT_R32SINT {\n");
        buf_str(out, c"        \"r32sint\"\n");
        buf_str(out, c"    } else {\n");
        buf_str(out, c"        \"rgba32uint\"\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// ---- Shader compiler implementation, ir: Building functions (0.22) ----\n");
        buf_str(out, c"\n");
        buf_str(out, c"impl Function {\n");
        buf_str(out, c"    pub fn expr(inout self, op: u8, ty: i64, a: i64, b: i64, c: i64) -> i64 {\n");
        buf_str(out, c"        self.exprs.push(Expr { op: op, ty: ty, a: a, b: b, c: c, d: 0 });\n");
        buf_str(out, c"        self.names.push(\"\");\n");
        buf_str(out, c"        self.exprs.len() - 1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn stmt(inout self, op: u8, a: i64, b: i64, c: i64, d: i64) -> i64 {\n");
        buf_str(out, c"        self.stmts.push(Stmt { op: op, a: a, b: b, c: c, d: d, e: -1 });\n");
        buf_str(out, c"        self.stmts.len() - 1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    // A block of the statements pending[from ..], which are removed from\n");
        buf_str(out, c"    // pending.\n");
        buf_str(out, c"    pub fn block_of(inout self, pending: inout V<i64>, from: i64) -> i64 {\n");
        buf_str(out, c"        let start = self.items.len();\n");
        buf_str(out, c"        for i in from..pending.len() {\n");
        buf_str(out, c"            self.items.push(pending[i]);\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let count = pending.len() - from;\n");
        buf_str(out, c"        pending.truncate(from);\n");
        buf_str(out, c"        self.blocks.push(Block { start: start, count: count });\n");
        buf_str(out, c"        self.blocks.len() - 1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn empty_block(inout self) -> i64 {\n");
        buf_str(out, c"        self.blocks.push(Block { start: self.items.len(), count: 0 });\n");
        buf_str(out, c"        self.blocks.len() - 1\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn arg(self, i: i64) -> i64 { self.args[i] }\n");
        buf_str(out, c"\n");
        buf_str(out, c"    pub fn item(self, blk: i64, i: i64) -> i64 { self.items[self.blocks[blk].start + i] }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The byte offsets of function h's parameters in a record holding them\n");
        buf_str(out, c"// all, each at its alignment (WGSL's layout); the record's size, rounded\n");
        buf_str(out, c"// to 16, is the last element.\n");
        buf_str(out, c"pub fn record_offsets(m: Module, h: i64, a: ScopedArena) -> V<i64> {\n");
        buf_str(out, c"    var offs: V<i64> = Vec::new_in(a);\n");
        buf_str(out, c"    var off = 0;\n");
        buf_str(out, c"    let f = m.functions[h];\n");
        buf_str(out, c"    for k in 0..f.params.len() {\n");
        buf_str(out, c"        let t = m.types[f.params[k].ty];\n");
        buf_str(out, c"        off = round_up(off, t.align);\n");
        buf_str(out, c"        offs.push(off);\n");
        buf_str(out, c"        off += t.size;\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"    offs.push(round_up(off, 16));\n");
        buf_str(out, c"    offs\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The bytes a value of type t takes in an array of them (its stride).\n");
        buf_str(out, c"pub fn stride_of(m: Module, t: i64) -> i64 {\n");
        buf_str(out, c"    let ty = m.types[t];\n");
        buf_str(out, c"    round_up(ty.size, ty.align)\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// Statements and expressions that end a block's flow.\n");
        buf_str(out, c"pub fn is_terminator(op: u8) -> bool {\n");
        buf_str(out, c"    op == S_BREAK || op == S_CONTINUE || op == S_RETURN || op == S_KILL\n");
        buf_str(out, c"}\n");
        buf_str(out, c"\n");
        buf_str(out, c"// The bits of an f32, and back.\n");
        buf_str(out, c"pub fn f32_bits(f: f32) -> u32 { std::num::f32_to_bits(f) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn bits_f32(u: u32) -> f32 { std::num::f32_from_bits(u) }\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub fn f64_bits(f: f64) -> u64 { std::num::f64_to_bits(f) }\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl::ir ----\n");
        buf_str(out, c"}\n");
        buf_str(out, c"// ---- mod std::gpu::wgsl::names ----\n");
        buf_str(out, c"pub mod names {\n");
        buf_str(out, c"// ---- Shader compiler implementation, names (0.22) ----\n");
        buf_str(out, c"// The predeclared names of WGSL: keywords, types, attributes and builtins.\n");
        buf_str(out, c"// The lexer interns them first, so each has the fixed symbol below. The\n");
        buf_str(out, c"// math functions are in MF_* order (ir.tach): K_ABS + MF_x is MF_x's name.\n");
        buf_str(out, c"\n");
        buf_str(out, c"pub const PREDECLARED: [[u8]; 234] = [\n");
        buf_str(out, c"    \"fn\",\n");
        buf_str(out, c"    \"let\",\n");
        buf_str(out, c"    \"var\",\n");
        buf_str(out, c"    \"const\",\n");
        buf_str(out, c"    \"struct\",\n");
        buf_str(out, c"    \"return\",\n");
        buf_str(out, c"    \"if\",\n");
        buf_str(out, c"    \"else\",\n");
        buf_str(out, c"    \"for\",\n");
        buf_str(out, c"    \"while\",\n");
        buf_str(out, c"    \"loop\",\n");
        buf_str(out, c"    \"break\",\n");
        buf_str(out, c"    \"continue\",\n");
        buf_str(out, c"    \"continuing\",\n");
        buf_str(out, c"    \"switch\",\n");
        buf_str(out, c"    \"case\",\n");
        buf_str(out, c"    \"default\",\n");
        buf_str(out, c"    \"discard\",\n");
        buf_str(out, c"    \"true\",\n");
        buf_str(out, c"    \"false\",\n");
        buf_str(out, c"    \"alias\",\n");
        buf_str(out, c"    \"override\",\n");
        buf_str(out, c"    \"enable\",\n");
        buf_str(out, c"    \"requires\",\n");
        buf_str(out, c"    \"diagnostic\",\n");
        buf_str(out, c"    \"const_assert\",\n");
        buf_str(out, c"    \"fallthrough\",\n");
        buf_str(out, c"    \"bool\",\n");
        buf_str(out, c"    \"i32\",\n");
        buf_str(out, c"    \"u32\",\n");
        buf_str(out, c"    \"f32\",\n");
        buf_str(out, c"    \"f16\",\n");
        buf_str(out, c"    \"vec2\",\n");
        buf_str(out, c"    \"vec3\",\n");
        buf_str(out, c"    \"vec4\",\n");
        buf_str(out, c"    \"vec2i\",\n");
        buf_str(out, c"    \"vec3i\",\n");
