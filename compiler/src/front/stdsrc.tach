        buf_str(out, c"    0xb1442798f49ffb4a, 0x99cd11cfdf41779c,\n");
        buf_str(out, c"    0xdd95317f31c7fa1d, 0x40405643d711d583,\n");
        buf_str(out, c"    0x8a7d3eef7f1cfc52, 0x482835ea666b2572,\n");
