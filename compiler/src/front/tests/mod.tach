// Tests in the language (0.18, T2; docs/design/contracts-verification.md
// §2.6, §2.7): a `#[cfg(test)]` module sees its parent's items, test items
// are left out of other builds, and a test build (`--test-build`, what
// `tachyonc test` uses) gets a `main` that runs the test its arguments
// name, with a generator for each property's parameters made from their
// types. The test build's code is made from the tokens, before parsing,
// as the trace and profile runtimes are: one source per module that has
// tests (or a type a property generates), in that module, so that its
// names (private ones too) are in scope. The runtime is std's Testing
// section (compiler/std/test.tach).

use crate::base::{
    FILES, FILE_COUNT, IntVec, SRC, add_source, buf_byte, buf_bytes, buf_int, buf_new, buf_slice,
    buf_str, intern_c, out_path, sym_text,
};
use crate::base::diag::{ERR_KIND, err_begin, err_end_soft, err_try_tool, pos_line};
use crate::front::ast::{NODES, NodeKind, child, list_begin, list_end, list_push};
use crate::front::contracts::{
    TEST_CFG, TEST_FN, TEST_FUZZ, TEST_ITEM, TEST_KIND, TEST_PROPERTY, test_kind,
};
use crate::front::lexer::{TOKS, TOK_COUNT, Tok, lex_range};
use crate::front::modules::{MODULES, STD_MODULE, file_of_pos, module_at, module_of};

// `--test-build` (front/contracts/flags.tach): the program's tests, with
// a test main in place of its own.
pub static mut TEST_BUILD: bool = false;

// ---- A test module's view ----

// Whether module m is a `#[cfg(test)]` module, which sees its parent's
// items (private ones too) without an import, as a nested scope sees its
// parent's names (design §2.6; `use super::*` is not allowed).
pub fn is_test_module(m: i64) -> bool {
    unsafe {
        if TEST_ITEM.count == 0 || m <= 0 {
            return false;
        }
        for i in 0..TEST_ITEM.count {
            let n = TEST_ITEM.data[i];
            if TEST_KIND.data[i] == TEST_CFG && NODES[n].kind == NodeKind::Mod
                && NODES[n].a == MODULES[m].name && module_of(n) == MODULES[m].parent {
                return true;
            }
        }
        false
    }
}

// Whether item n is for tests only: `#[test]`, `#[property]`, `#[fuzz]`,
// under `#[cfg(test)]`, or in a `#[cfg(test)]` module.
fn test_only(n: i64) -> bool {
    unsafe {
        if test_kind(n) != 0 {
            return true;
        }
        let mut m = module_of(n);
        while m > 0 {
            if is_test_module(m) {
                return true;
            }
            m = MODULES[m].parent;
        }
        false
    }
}

// After parsing, in a build (compile_program; not `check` or a query,
// which check the tests too): a build that is not for tests leaves the
// test items out.
pub fn drop_test_items(program: i64) {
    unsafe {
        if TEST_BUILD || TEST_ITEM.count == 0 {
            return;
        }
        let mut kept = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..NODES[program].count {
            let item = child(program, i);
            if !test_only(item) {
                kept.push(item);
            }
        }
        if kept.count == NODES[program].count {
            return;
        }
        let mark = list_begin();
        for i in 0..kept.count {
            list_push(kept.data[i]);
        }
        list_end(program, mark);
    }
}

// ---- The tokens of a test build ----

fn kind(i: i64) -> Tok {
    unsafe {
        if i < 0 || i >= TOK_COUNT {
            return Tok::Eof;
        }
        TOKS[i].kind
    }
}

fn is_ident(i: i64, word: [u8]) -> bool {
    unsafe { kind(i) == Tok::Ident && sym_text(TOKS[i].value as i64) == word }
}

fn tok_text(i: i64) -> [u8] {
    unsafe { SRC[TOKS[i].start..TOKS[i].end] }
}

// The source text of tokens a..b (b excluded).
fn text_of(a: i64, b: i64) -> [u8] {
    unsafe {
        if b <= a {
            return "";
        }
        SRC[TOKS[a].start..TOKS[b - 1].end]
    }
}

// The token after the bracket at i that closes it (kinds open/close).
fn after_close(i: i64, open: Tok, close: Tok) -> i64 {
    let mut depth = 0;
    let mut j = i;
    while j < unsafe { TOK_COUNT } {
        let k = kind(j);
        if k == open {
            depth += 1;
        } else if k == close {
            depth -= 1;
            if depth == 0 {
                return j + 1;
            }
        } else if k == Tok::Eof {
            return j;
        }
        j += 1;
    }
    j
}

// Whether token i is in the program's own files (not std's, nor a made
// runtime's).
fn in_program(i: i64) -> bool {
    unsafe {
        let f = file_of_pos(TOKS[i].start);
        let m = FILES[f].module;
        FILES[f].path[0] != '<' && (STD_MODULE < 0 || m != STD_MODULE)
    }
}

// The end of a type's tokens from a: at a `,` or a closing bracket of the
// level it starts at, or `{`, `;`, `=` there.
fn type_end(a: i64) -> i64 {
    let mut depth = 0;
    let mut j = a;
    loop {
        let k = kind(j);
        if k == Tok::Eof {
            return j;
        }
        if depth == 0 && (k == Tok::Comma || k == Tok::RParen || k == Tok::RBracket
            || k == Tok::Gt || k == Tok::Shr || k == Tok::LBrace || k == Tok::RBrace
            || k == Tok::Semi || k == Tok::Eq) {
            return j;
        }
        if k == Tok::LParen || k == Tok::LBracket || k == Tok::Lt {
            depth += 1;
        } else if k == Tok::RParen || k == Tok::RBracket || k == Tok::Gt {
            depth -= 1;
        } else if k == Tok::Shr {
            depth -= 2;
            if depth < 0 {
                return j;
            }
        }
        j += 1;
    }
}

// A test found in the tokens.
struct Found {
    kind: i64, module: i64, name: i64, pos: i64, params: i64, close: i64,
    returns: i64, ret_end: i64, gpa: bool, label: i64,
}

static mut FOUND: *Found = 0 as *Found;
static mut FOUND_COUNT: i64 = 0;
static mut FOUND_CAP: i64 = 0;

// The kinds of a contract, tested as a property (a function with an
// `ensures`).
const TEST_CONTRACT: i64 = 5;

fn add_found(f: Found) {
    unsafe {
        if FOUND_COUNT == FOUND_CAP {
            let cap = if FOUND_CAP == 0 { 16 } else { FOUND_CAP * 2 };
            let bigger = crate::base::alloc_array::<Found>(cap);
            for i in 0..FOUND_COUNT {
                bigger[i] = FOUND[i];
            }
            FOUND = bigger;
            FOUND_CAP = cap;
        }
        FOUND[FOUND_COUNT] = f;
        FOUND_COUNT += 1;
    }
}

// The attribute `#[word]` at i (test, property, fuzz): its kind, else 0.
fn test_attribute_at(i: i64) -> i64 {
    if kind(i) != Tok::Hash || kind(i + 1) != Tok::LBracket || kind(i + 3) != Tok::RBracket {
        return 0;
    }
    if is_ident(i + 2, "test") {
        TEST_FN
    } else if is_ident(i + 2, "property") {
        TEST_PROPERTY
    } else if is_ident(i + 2, "fuzz") {
        TEST_FUZZ
    } else {
        0
    }
}

// The function after attribute tokens at i (more attributes, `pub`,
// `unsafe`): the index of its `fn`, else -1.
fn fn_after(i: i64) -> i64 {
    let mut j = i;
    loop {
        if kind(j) == Tok::Hash && kind(j + 1) == Tok::LBracket {
            j = after_close(j + 1, Tok::LBracket, Tok::RBracket);
        } else if kind(j) == Tok::Pub || kind(j) == Tok::Unsafe {
            j += 1;
        } else {
            break;
        }
    }
    if kind(j) == Tok::Fn && kind(j + 1) == Tok::Ident { j } else { -1 }
}

// The function at `fn` token f: its parameters' `(`, its result's tokens
// (-1: none) and where its signature ends (the body's `{`, or the first
// clause word).
fn read_signature(f: i64, kind_of: i64) -> Found {
    let mut open = f + 2;
    if kind(open) == Tok::Lt {
        open = -1;
    }
    let close = if open >= 0 { after_close(open, Tok::LParen, Tok::RParen) - 1 } else { -1 };
    let mut returns = -1;
    let mut ret_end = -1;
    if close >= 0 && kind(close + 1) == Tok::Arrow {
        returns = close + 2;
        ret_end = returns;
        while kind(ret_end) != Tok::LBrace && kind(ret_end) != Tok::Semi
            && kind(ret_end) != Tok::Eof && !is_ident(ret_end, "requires")
            && !is_ident(ret_end, "ensures")
            && !is_ident(ret_end, "debug") {
            ret_end += 1;
        }
    }
    unsafe {
        Found {
            kind: kind_of, module: module_at(TOKS[f].start), name: TOKS[f + 1].value as i64,
            pos: TOKS[f + 1].start, params: open, close, returns, ret_end, gpa: false,
            label: TOKS[f + 1].value as i64,
        }
    }
}

// The parameters of a found function: (name token, type start, type end)
// triples in `out`; false when one is not `name: T`.
fn params_of(t: Found, out: &mut IntVec) -> bool {
    unsafe {
        (*out).count = 0;
        if t.params < 0 {
            return false;
        }
        let mut j = t.params + 1;
        while j < t.close {
            if kind(j) == Tok::Mut {
                j += 1;
            }
            if kind(j) != Tok::Ident || kind(j + 1) != Tok::Colon {
                return false;
            }
            let a = j + 2;
            let b = type_end(a);
            (*out).push(j);
            (*out).push(a);
            (*out).push(b);
            j = b;
            if kind(j) == Tok::Comma {
                j += 1;
            } else if j != t.close {
                return false;
            }
        }
        true
    }
}

// ---- Generators, from the parameters' types ----

// The user types properties need generated (a struct or enum's name
// symbol), and the ones with an `impl Arbitrary` of their own.
static mut WANTED: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn want_type(name: i64) {
    unsafe {
        for i in 0..WANTED.count {
            if WANTED.data[i] == name {
                return;
            }
        }
        WANTED.push(name);
    }
}

fn int_type(s: [u8]) -> bool {
    s == "i64" || s == "i32" || s == "i16" || s == "i8" || s == "u64" || s == "u32"
        || s == "u16" || s == "u8" || s == "bool" || s == "f64"
}

// The expression that generates a value of the type at tokens a..b into
// out (`g` is the generator); false, with the reason in `why`, when it is
// not generable.
fn gen_expr(out: i64, a: i64, b: i64, why: i64) -> bool {
    unsafe {
        let k = kind(a);
        if k == Tok::Star || k == Tok::Fn || k == Tok::Amp || k == Tok::AmpAmp {
            buf_bytes(why, if k == Tok::Fn { "a function" } else { "a pointer" });
            return false;
        }
        if k == Tok::LParen {
            // a tuple: its elements in order
            buf_byte(out, '(');
            let mut j = a + 1;
            let mut n = 0;
            while j < b - 1 {
                let e = type_end(j);
                if n > 0 {
                    buf_bytes(out, ", ");
                }
                if !gen_expr(out, j, e, why) {
                    return false;
                }
                n += 1;
                j = if kind(e) == Tok::Comma { e + 1 } else { e };
            }
            if n == 1 {
                buf_byte(out, ',');
            }
            buf_byte(out, ')');
            return true;
        }
        if k == Tok::LBracket {
            let e = type_end(a + 1);
            if kind(e) == Tok::Semi {
                buf_bytes(why, "an array");
                return false;
            }
            // a slice: an owned Vec, lent (gen_param)
            if e == a + 2 && is_ident(a + 1, "u8") {
                buf_bytes(out, "std::gen_text(g)");
                return true;
            }
            buf_bytes(out, "std::gen_vec(g, |g: &mut std::Gen| ");
            if !gen_expr(out, a + 1, e, why) {
                return false;
            }
            buf_byte(out, ')');
            return true;
        }
        if k != Tok::Ident {
            buf_bytes(why, "this type");
            return false;
        }
        // a path: its last name, and its arguments
        let mut last = a;
        let mut j = a;
        while j + 2 < b && kind(j + 1) == Tok::ColonColon && kind(j + 2) == Tok::Ident {
            j += 2;
            last = j;
        }
        let name = tok_text(last);
        let args = if kind(last + 1) == Tok::Lt { last + 2 } else { -1 };
        if args < 0 && int_type(name) {
            buf_bytes(out, "std::arbitrary_of::<");
            buf_bytes(out, name);
            buf_bytes(out, ">(g)");
            return true;
        }
        if args < 0 && (name == "usize" || name == "isize" || name == "f32") {
            buf_bytes(out, if name == "f32" { "(std::gen_f64(g) as f32)" } else { "(g.int() as " });
            if name != "f32" {
                buf_bytes(out, name);
                buf_byte(out, ')');
            }
            return true;
        }
        if args < 0 && name == "Buf" {
            buf_bytes(out, "std::gen_buf(g)");
            return true;
        }
        if args >= 0 && (name == "Vec" || name == "Option" || name == "Result") {
            let e1 = type_end(args);
            if name == "Vec" && kind(e1) == Tok::Comma {
                buf_bytes(why, "a Vec on another allocator than Gpa");
                return false;
            }
            buf_bytes(out, if name == "Vec" { "std::gen_vec(g, |g: &mut std::Gen| " }
                else if name == "Option" { "std::gen_option(g, |g: &mut std::Gen| " }
                else { "std::gen_result(g, |g: &mut std::Gen| " });
            if !gen_expr(out, args, e1, why) {
                return false;
            }
            if name == "Result" {
                buf_bytes(out, ", |g: &mut std::Gen| ");
                if kind(e1) != Tok::Comma || !gen_expr(out, e1 + 1, type_end(e1 + 1), why) {
                    return false;
                }
            }
            buf_byte(out, ')');
            return true;
        }
        if name == "HashMap" || name == "Arena" || name == "Gpa" || name == "ScopedArena" {
            buf_bytes(why, "a ");
            buf_bytes(why, name);
            return false;
        }
        // any other type: its impl Arbitrary (std's, the program's, or one
        // made here for a struct or enum)
        if args < 0 && name.len == 1 && name[0] >= 'A' && name[0] <= 'Z' {
            // (a type parameter of a made impl: bound by Arbitrary)
        } else {
            want_type(TOKS[last].value as i64);
        }
        buf_bytes(out, "std::arbitrary_of::<");
        buf_bytes(out, text_of(a, b));
        buf_bytes(out, ">(g)");
        true
    }
}

// Whether the type at a..b is printed with `{:?}`: a struct or enum only
// when it derives or implements Debug.
fn debug_type(a: i64, b: i64) -> bool {
    unsafe {
        for j in a..b {
            if kind(j) == Tok::LParen {
                return false;
            }
            if kind(j) == Tok::Ident {
                let s = tok_text(j);
                if !int_type(s) && s != "Vec" && s != "Option" && s != "Result" && s != "Buf"
                    && s != "usize" && s != "isize" && s != "f32" && s != "std"
                    && !has_debug(TOKS[j].value as i64) {
                    return false;
                }
            }
        }
        true
    }
}

// Whether the program's type `name` derives or implements Debug.
fn has_debug(name: i64) -> bool {
    unsafe {
        for i in 0..TOK_COUNT {
            if kind(i) == Tok::Ident && TOKS[i].value as i64 == name && i > 0 && in_program(i) {
                let before = kind(i - 1);
                if before == Tok::Struct || before == Tok::Enum {
                    // `#[derive(..., Debug, ...)]` above it
                    let mut j = i - 2;
                    while j >= 0 && kind(j) != Tok::Semi && kind(j) != Tok::RBrace
                        && kind(j) != Tok::LBrace {
                        if is_ident(j, "Debug") {
                            return true;
                        }
                        j -= 1;
                    }
                }
                if before == Tok::For && i >= 3 && (is_ident(i - 2, "Debug")) {
                    return true;
                }
            }
        }
        false
    }
}

// Whether the program has `impl Arbitrary for name` (or std::Arbitrary).
fn has_arbitrary(name: i64) -> bool {
    unsafe {
        for i in 2..TOK_COUNT {
            if kind(i) == Tok::Ident && TOKS[i].value as i64 == name && kind(i - 1) == Tok::For
                && is_ident(i - 2, "Arbitrary") {
                return true;
            }
        }
        false
    }
}

// ---- The code of a test build ----

// Per module: the made source (a buffer, -1: none yet).
static mut MODULE_TEXT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Per module: whether it runs tests (its own or its children's).
static mut RUNS_TESTS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn text_for(m: i64) -> i64 {
    unsafe {
        while MODULE_TEXT.count <= m {
            MODULE_TEXT.push(-1);
            RUNS_TESTS.push(0);
        }
        if MODULE_TEXT.data[m] < 0 {
            MODULE_TEXT.data[m] = buf_new();
        }
        MODULE_TEXT.data[m]
    }
}

fn module_path(out: i64, m: i64) {
    unsafe {
        if m <= 0 {
            return;
        }
        let p = MODULES[m].parent;
        if p > 0 {
            module_path(out, p);
            buf_bytes(out, "::");
        }
        buf_bytes(out, sym_text(MODULES[m].name));
    }
}

fn test_error(pos: i64, code: *u8, message: [u8], help: [u8]) {
    unsafe {
        let kind_was = ERR_KIND;
        ERR_KIND = code;
        err_begin(pos);
        buf_bytes(crate::base::diag::ERR, message);
        if help.len > 0 {
            crate::base::diag::err_help_fmt(help);
        }
        err_end_soft();
        ERR_KIND = kind_was;
    }
}

// The lines of a test's call: `NAME(args)` for a #[test] (with gpa), a
// property's closure for the others.
fn put_test_case(out: i64, t: Found, ps: &IntVec) -> bool {
    unsafe {
        let name = sym_text(t.name);
        if t.kind == TEST_FN {
            let mut call = buf_new();
            buf_bytes(call, name);
            buf_byte(call, '(');
            let mut ok = true;
            let mut k = 0;
            while k < (*ps).count {
                let p = tok_text((*ps).data[k]);
                let ty = text_of((*ps).data[k + 1], (*ps).data[k + 2]);
                if ty != "Gpa" || k > 0 {
                    ok = false;
                }
                buf_bytes(call, p);
                buf_bytes(call, ": gpa");
                k += 3;
            }
            buf_byte(call, ')');
            if !ok {
                let m = buf_new();
                buf_bytes(m, "'");
                buf_bytes(m, name);
                buf_bytes(m,
                    "' is a #[test] with parameters: a #[test] takes nothing or `gpa: Gpa`");
                test_error(t.pos, c"test.signature", buf_slice(m),
                    "a function of generated arguments is a #[property]");
                return false;
            }
            let returns = if t.returns >= 0 { text_of(t.returns, t.ret_end) } else { "" };
            if returns.len > 0 && returns != "()" {
                buf_bytes(out, "        match ");
                buf_bytes(out, buf_slice(call));
                buf_bytes(out, " { Ok(_) => {}, Err(e) => std::test_err(e), }\n");
            } else {
                buf_bytes(out, "        ");
                buf_bytes(out, buf_slice(call));
                buf_bytes(out, ";\n");
            }
            buf_bytes(out, "        std::test_done();\n");
            if crate::front::stdalloc::CHECK_ALLOC_MODE {
                // (--check-alloc: a test that leaves blocks allocated fails)
                buf_bytes(out, "        let mut leak_gpa = gpa;\n        if leak_gpa.live_blocks() > 0 {\n            leak_gpa.check_leaks();\n            std::test_leaked();\n        }\n");
            }
            return true;
        }
        // a property, a fuzz target or a contract: the values, then the call
        if t.kind == TEST_FUZZ {
            put_fuzz_words(out);
        }
        buf_bytes(out, if t.kind == TEST_FUZZ { "        std::run_fuzz_target(gpa, \"" }
            else { "        std::run_property(gpa, \"" });
        buf_bytes(out, sym_text(t.label));
        buf_bytes(out, "\", |g: &mut std::Gen| {\n");
        let call = buf_new();
        buf_bytes(call, name);
        buf_byte(call, '(');
        let mut k = 0;
        while k < (*ps).count {
            let p = tok_text((*ps).data[k]);
            let a = (*ps).data[k + 1];
            let b = (*ps).data[k + 2];
            let why = buf_new();
            let gen = buf_new();
            let bytes = t.kind == TEST_FUZZ && b == a + 3 && kind(a) == Tok::LBracket
                && is_ident(a + 1, "u8");
            if bytes {
                // (a fuzz target's input, its bytes: std/fuzz.tach)
                buf_bytes(gen, "std::gen_bytes(g)");
            } else if !gen_expr(gen, a, b, why) {
                let m = buf_new();
                buf_bytes(m, "no generator for '");
                buf_bytes(m, text_of(a, b));
                buf_bytes(m, "' (");
                buf_bytes(m, buf_slice(why));
                buf_bytes(m, "), parameter '");
                buf_bytes(m, p);
                buf_bytes(m, "' of '");
                buf_bytes(m, name);
                buf_bytes(m, "'");
                test_error(TOKS[(*ps).data[k]].start, c"test.generate", buf_slice(m),
                    "parameters are generated from their types: numbers, bool, text, Vec, Option, Result, tuples, the program's structs and enums, a type with an `impl std::Arbitrary`");
                return false;
            }
            buf_bytes(out, "            let ");
            buf_bytes(out, p);
            let slice = kind(a) == Tok::LBracket;
            if slice {
                buf_bytes(out, "_owned");
            }
            buf_bytes(out, " = ");
            buf_bytes(out, buf_slice(gen));
            buf_bytes(out, ";\n");
            if slice {
                buf_bytes(out, "            let ");
                buf_bytes(out, p);
                buf_bytes(out, " = ");
                buf_bytes(out, p);
                buf_bytes(out, "_owned.as_slice();\n");
            }
            if k > 0 {
                buf_bytes(call, ", ");
            }
            buf_bytes(call, p);
            k += 3;
        }
        buf_byte(call, ')');
        // (a contract's requires: an input that fails it is discarded)
        if t.kind == TEST_CONTRACT {
            put_requires_filters(out, t);
        }
        buf_bytes(out, "            if g.showing() {\n");
        k = 0;
        while k < (*ps).count {
            let p = tok_text((*ps).data[k]);
            buf_bytes(out, "                std::test_input(\"");
            buf_bytes(out, p);
            buf_bytes(out, "\");\n");
            if debug_type((*ps).data[k + 1], (*ps).data[k + 2]) {
                buf_bytes(out, "                print(f\"{");
                buf_bytes(out, p);
                buf_bytes(out, ":?}\");\n");
            } else {
                buf_bytes(out, "                print(\"(no Debug)\");\n");
            }
            buf_bytes(out, "                std::test_input_end();\n");
            k += 3;
        }
        buf_bytes(out, "            }\n");
        buf_bytes(out, "            g.generated();\n");
        if t.kind == TEST_CONTRACT {
            buf_bytes(out, "            let _ = ");
        } else {
            buf_bytes(out, "            ");
        }
        buf_bytes(out, buf_slice(call));
        buf_bytes(out, ";\n");
        buf_bytes(out, "        });\n");
        true
    }
}

// A fuzz target's dictionary: the program's string constants (up to 64,
// of 32 bytes at most), which mutations put in its inputs.
fn put_fuzz_words(out: i64) {
    unsafe {
        let mut n = 0;
        for i in 0..TOK_COUNT {
            if n < 64 && kind(i) == Tok::Str && in_program(i) && TOKS[i].end - TOKS[i].start <= 34
                && TOKS[i].end - TOKS[i].start > 2 {
                buf_bytes(out, "        std::fuzz_word(");
                buf_bytes(out, tok_text(i));
                buf_bytes(out, ");\n");
                n += 1;
            }
        }
    }
}

// A contract's `requires` clauses, as filters of the generated values
// (bound to the parameters' names).
fn put_requires_filters(out: i64, t: Found) {
    let mut j = t.close + 1;
    while kind(j) != Tok::LBrace && kind(j) != Tok::Eof && kind(j) != Tok::Semi {
        if is_ident(j, "requires") {
            let a = j + 1;
            let mut e = a;
            let mut depth = 0;
            loop {
                let k = kind(e);
                if k == Tok::Eof || depth == 0 && (k == Tok::LBrace || k == Tok::Else
                    || is_ident(e, "requires") || is_ident(e, "ensures") || is_ident(e, "debug")) {
                    break;
                }
                if k == Tok::LParen || k == Tok::LBracket {
                    depth += 1;
                } else if k == Tok::RParen || k == Tok::RBracket {
                    depth -= 1;
                }
                e += 1;
            }
            buf_bytes(out, "            if !(");
            buf_bytes(out, text_of(a, e));
            buf_bytes(out, ") { std::test_discard(); }\n");
            j = e;
        } else {
            j += 1;
        }
    }
}

// The function at `fn` token f has an `ensures` (a contract tested as a
// property): a free function, not generic, without `self`.
fn contract_at(f: i64) -> bool {
    if kind(f + 2) != Tok::LParen || is_ident(f + 3, "self") {
        return false;
    }
    let close = after_close(f + 2, Tok::LParen, Tok::RParen);
    let mut j = close;
    while kind(j) != Tok::LBrace && kind(j) != Tok::Semi && kind(j) != Tok::Eof {
        if is_ident(j, "ensures") && !(kind(j - 1) == Tok::Ident && is_ident(j - 1, "debug")) {
            return true;
        }
        j += 1;
    }
    false
}

// Whether the `fn` at token f is inside an impl or trait block (a method).
fn in_impl(f: i64) -> bool {
    let mut depth = 0;
    let mut j = f - 1;
    while j >= 0 {
        let k = kind(j);
        if k == Tok::RBrace {
            depth += 1;
        } else if k == Tok::LBrace {
            if depth == 0 {
                // the block's head: `impl ... {` or `trait ... {`
                let mut h = j - 1;
                while h >= 0 && kind(h) != Tok::RBrace && kind(h) != Tok::LBrace
                    && kind(h) != Tok::Semi {
                    if kind(h) == Tok::Impl || kind(h) == Tok::Trait {
                        return true;
                    }
                    if kind(h) == Tok::Mod {
                        return false;
                    }
                    h -= 1;
                }
                return false;
            }
            depth -= 1;
        }
        j -= 1;
    }
    false
}

// A struct or enum's generator, an `impl std::Arbitrary`, into its
// module's text (structurally: its fields, or a variant then its fields).
fn put_arbitrary(name: i64) -> bool {
    unsafe {
        let mut at = -1;
        for i in 1..TOK_COUNT {
            if kind(i) == Tok::Ident && TOKS[i].value as i64 == name
                && (kind(i - 1) == Tok::Struct || kind(i - 1) == Tok::Enum) && in_program(i) {
                at = i;
                break;
            }
        }
        if at < 0 {
            return true;
        }
        let is_enum = kind(at - 1) == Tok::Enum;
        let out = text_for(module_at(TOKS[at].start));
        // generics: `<T, U>` (names only)
        let params = buf_new();
        let bounds = buf_new();
        let mut j = at + 1;
        if kind(j) == Tok::Lt {
            j += 1;
            buf_byte(params, '<');
            buf_byte(bounds, '<');
            let mut n = 0;
            while kind(j) != Tok::Gt && kind(j) != Tok::Eof {
                if kind(j) == Tok::Ident && (kind(j - 1) == Tok::Lt || kind(j - 1) == Tok::Comma) {
                    if n > 0 {
                        buf_bytes(params, ", ");
                        buf_bytes(bounds, ", ");
                    }
                    buf_bytes(params, tok_text(j));
                    buf_bytes(bounds, tok_text(j));
                    buf_bytes(bounds, ": std::Arbitrary");
                    n += 1;
                }
                j += 1;
            }
            j += 1;
            buf_byte(params, '>');
            buf_byte(bounds, '>');
        }
        let ty = buf_new();
        buf_bytes(ty, sym_text(name));
        buf_bytes(ty, buf_slice(params));
        buf_bytes(out, "impl");
        buf_bytes(out, buf_slice(bounds));
        buf_bytes(out, " std::Arbitrary for ");
        buf_bytes(out, buf_slice(ty));
        buf_bytes(out, " {\n    fn arbitrary(g: &mut std::Gen) -> ");
        buf_bytes(out, buf_slice(ty));
        buf_bytes(out, " {\n");
        let why = buf_new();
        if !is_enum {
            buf_bytes(out, "        ");
            buf_bytes(out, sym_text(name));
            buf_bytes(out, " {");
            if kind(j) == Tok::LBrace {
                if !put_fields(out, j, why) {
                    return false;
                }
            }
            buf_bytes(out, "}\n");
        } else {
            // the variants
            let mut count = 0;
            let mut k = j + 1;
            let end = after_close(j, Tok::LBrace, Tok::RBrace) - 1;
            let mut arm_list = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            while k < end {
                if kind(k) == Tok::Ident {
                    let arms = buf_new();
                    arm_list.push(arms);
                    buf_bytes(arms, sym_text(name));
                    buf_bytes(arms, "::");
                    buf_bytes(arms, tok_text(k));
                    k += 1;
                    if kind(k) == Tok::LParen {
                        buf_byte(arms, '(');
                        let mut e = k + 1;
                        let mut n = 0;
                        while kind(e) != Tok::RParen && e < end {
                            let te = type_end(e);
                            if n > 0 {
                                buf_bytes(arms, ", ");
                            }
                            if !gen_expr(arms, e, te, why) {
                                return false;
                            }
                            n += 1;
                            e = if kind(te) == Tok::Comma { te + 1 } else { te };
                        }
                        buf_byte(arms, ')');
                        k = e + 1;
                    } else if kind(k) == Tok::LBrace {
                        buf_bytes(arms, " {");
                        if !put_fields(arms, k, why) {
                            return false;
                        }
                        buf_byte(arms, '}');
                        k = after_close(k, Tok::LBrace, Tok::RBrace);
                    }
                    if kind(k) == Tok::Eq {
                        // (`A = 3`: the discriminant)
                        k += 2;
                    }
                    count += 1;
                }
                if kind(k) == Tok::Comma {
                    k += 1;
                } else if kind(k) != Tok::Ident {
                    k += 1;
                }
            }
            buf_bytes(out, "        g.enter();\n        let k = if g.depth() > 3 { g.choose(1) } else { g.choose(");
            buf_int(out, count);
            buf_bytes(out, ") };\n        let v = match k {\n");
            for a in 0..arm_list.count {
                buf_bytes(out, "            ");
                if a + 1 == arm_list.count {
                    buf_byte(out, '_');
                } else {
                    buf_int(out, a);
                }
                buf_bytes(out, " => ");
                buf_bytes(out, buf_slice(arm_list.data[a]));
                buf_bytes(out, ",\n");
            }
            buf_bytes(out, "        };\n        g.leave();\n        v\n");
        }
        buf_bytes(out, "    }\n}\n\n");
        true
    }
}

// The fields `{ a: T, b: U }` at the `{` token at j, generated.
fn put_fields(out: i64, j: i64, why: i64) -> bool {
    let end = after_close(j, Tok::LBrace, Tok::RBrace) - 1;
    let mut k = j + 1;
    let mut n = 0;
    while k < end {
        if kind(k) == Tok::Pub {
            k += 1;
        }
        if kind(k) != Tok::Ident || kind(k + 1) != Tok::Colon {
            k += 1;
            continue;
        }
        let a = k + 2;
        let b = type_end(a);
        if n > 0 {
            buf_byte(out, ',');
        }
        buf_byte(out, ' ');
        buf_bytes(out, tok_text(k));
        buf_bytes(out, ": ");
        if !gen_expr(out, a, b, why) {
            return false;
        }
        n += 1;
        k = if kind(b) == Tok::Comma { b + 1 } else { b };
    }
    if n > 0 {
        buf_byte(out, ' ');
    }
    true
}

// After the modules' files are read (load_modules), in a test build: the
// tests found in the tokens, their code made and lexed into their
// modules, the program's own `main` renamed.
pub fn add_test_code() {
    unsafe {
        plant_miscompile();
        if crate::middle::coverage::COVERAGE {
            // (--coverage counts the IR's blocks: -O1 at least; std's
            // counters in the program)
            if crate::middle::opt::OPT_LEVEL < 1 {
                crate::middle::opt::OPT_LEVEL = 1;
            }
            if !TEST_BUILD {
                let anchor = buf_new();
                buf_bytes(anchor,
                    "pub fn __tachyon_coverage() -> [u8] {\n    std::coverage()\n}\n");
                let start = add_source(c"<test>", anchor);
                lex_range(start, FILES[FILE_COUNT - 1].end, last: false);
            }
        }
        if !TEST_BUILD {
            return;
        }
        FOUND_COUNT = 0;
        WANTED.count = 0;
        MODULE_TEXT.count = 0;
        RUNS_TESTS.count = 0;
        let count = TOK_COUNT;
        for i in 0..count {
            let attr = test_attribute_at(i);
            if attr != 0 && in_program(i) {
                let f = fn_after(i);
                if f >= 0 {
                    add_found(read_signature(f, attr));
                }
            } else if kind(i) == Tok::Fn && kind(i + 1) == Tok::Ident && in_program(i)
                && contract_at(i) && !in_impl(i) {
                add_found(read_signature(i, TEST_CONTRACT));
            }
        }
        // the program's main: renamed (the test main replaces it)
        for i in 0..count {
            if kind(i) == Tok::Fn && is_ident(i + 1, "main") && in_program(i)
                && module_at(TOKS[i].start) == 0 {
                TOKS[i + 1].value = intern_c(c"__tachyon_program_main") as u64;
            }
        }
        // names: a test's own, else its path when two have it
        for t in 0..FOUND_COUNT {
            for u in 0..FOUND_COUNT {
                if u != t && FOUND[u].name == FOUND[t].name {
                    let b = buf_new();
                    module_path(b, FOUND[t].module);
                    if buf_slice(b).len > 0 {
                        buf_bytes(b, "::");
                    }
                    buf_bytes(b, sym_text(FOUND[t].name));
                    FOUND[t].label = crate::base::intern(buf_slice(b));
                }
            }
        }
        // each module's cases
        let mut params = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for t in 0..FOUND_COUNT {
            let found = FOUND[t];
            if !params_of(found, &mut params) && found.params >= 0 {
                test_error(found.pos, c"test.signature", "a test's parameters are `name: Type`",
                    "");
                continue;
            }
            if found.params < 0 {
                test_error(found.pos, c"test.signature", "a test is not generic", "");
                continue;
            }
            let body = buf_new();
            if !put_test_case(body, found, &params) {
                continue;
            }
            // (kept in the module's dispatcher, below)
            let label = sym_text(found.label);
            let d = dispatch_for(found.module);
            buf_bytes(d, "    if name == \"");
            buf_bytes(d, label);
            buf_bytes(d, "\" {\n        std::test_begin(\"");
            module_path(d, found.module);
            buf_bytes(d, "\", \"");
            buf_bytes(d, sym_text(found.name));
            buf_bytes(d, "\", gpa);\n");
            buf_bytes(d, buf_slice(body));
            buf_bytes(d, "        return true;\n    }\n");
            // the list: KIND NAME FILE:LINE
            let l = list_text();
            buf_bytes(l, "        println(\"tachyon-test: ");
            buf_bytes(l,
                if found.kind == TEST_FN { "test " }
                else if found.kind == TEST_PROPERTY { "property " }
                else if found.kind == TEST_FUZZ { "fuzz " } else { "contract " });
            buf_bytes(l, label);
            buf_byte(l, ' ');
            let f = file_of_pos(found.pos);
            put_c(l, out_path(f));
            buf_byte(l, ':');
            buf_int(l, pos_line(found.pos));
            buf_bytes(l, "\");\n");
        }
        // the types the properties generate
        let mut w = 0;
        while w < WANTED.count {
            if !has_arbitrary(WANTED.data[w]) {
                put_arbitrary(WANTED.data[w]);
            }
            w += 1;
        }
        // the dispatchers: a module's children first, then its own tests
        for m in 0..MODULE_TEXT.count {
            if m < DISPATCH.count && DISPATCH.data[m] >= 0 {
                mark_runs(m);
            }
        }
        for m in 0..MODULE_TEXT.count {
            if RUNS_TESTS.data[m] == 0 {
                continue;
            }
            let out = text_for(m);
            buf_bytes(out, "pub fn __tachyon_tests(name: [u8], gpa: Gpa) -> bool {\n");
            for c in 0..MODULE_TEXT.count {
                if c > 0 && RUNS_TESTS.data[c] != 0 && MODULES[c].parent == m {
                    buf_bytes(out, "    if ");
                    buf_bytes(out, sym_text(MODULES[c].name));
                    buf_bytes(out, "::__tachyon_tests(name, gpa) {\n        return true;\n    }\n");
                }
            }
            if m < DISPATCH.count && DISPATCH.data[m] >= 0 {
                buf_bytes(out, buf_slice(DISPATCH.data[m]));
            }
            buf_bytes(out, "    false\n}\n\n");
        }
        // the root's: the test main
        let root = text_for(0);
        buf_bytes(root, "fn main(argc: i32, argv: **u8, gpa: Gpa) -> i32 {\n");
        buf_bytes(root, "    let name = std::test_args(argc, argv);\n    if name.len == 0 {\n");
        if LIST >= 0 {
            buf_bytes(root, buf_slice(LIST));
        }
        buf_bytes(root, "        return 0;\n    }\n");
        if RUNS_TESTS.data[0] != 0 {
            buf_bytes(root, "    if __tachyon_tests(name, gpa) {\n        return 0;\n    }\n");
        }
        buf_bytes(root, "    std::test_unknown(name)\n}\n");
        // each module's text, lexed into it
        for m in 0..MODULE_TEXT.count {
            let b = MODULE_TEXT.data[m];
            if b < 0 || buf_slice(b).len == 0 {
                continue;
            }
            let start = add_source(c"<test>", b);
            FILES[FILE_COUNT - 1].module = m;
            lex_range(start, FILES[FILE_COUNT - 1].end, last: false);
        }
    }
}

extern "C" {
    fn getenv(name: *u8) -> *u8;
}

// A test-only switch (tests/testcmd): with TACHYON_PLANT_MISCOMPILE set, a
// build at -O1 or -O2 reads the literal 12345 as 12346, a difference
// between the levels for `tachyonc test` to catch and `reduce --differs`
// to narrow down.
fn plant_miscompile() {
    unsafe {
        if crate::middle::opt::OPT_LEVEL < 1 || getenv(c"TACHYON_PLANT_MISCOMPILE") == 0 as *u8 {
            return;
        }
        for i in 0..TOK_COUNT {
            if TOKS[i].kind == Tok::Int && TOKS[i].value == 12345 && in_program(i) {
                TOKS[i].value = 12346;
            }
        }
    }
}

// Per module: its tests' cases (a buffer, -1: none).
static mut DISPATCH: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut LIST: i64 = -1;

fn dispatch_for(m: i64) -> i64 {
    unsafe {
        while DISPATCH.count <= m {
            DISPATCH.push(-1);
        }
        if DISPATCH.data[m] < 0 {
            DISPATCH.data[m] = buf_new();
        }
        text_for(m);
        DISPATCH.data[m]
    }
}

fn list_text() -> i64 {
    unsafe {
        if LIST < 0 {
            LIST = buf_new();
        }
        LIST
    }
}

// Module m and its ancestors run tests.
fn mark_runs(m: i64) {
    unsafe {
        let mut k = m;
        while k >= 0 {
            text_for(k);
            RUNS_TESTS.data[k] = 1;
            if k == 0 {
                break;
            }
            k = MODULES[k].parent;
        }
    }
}

fn put_c(out: i64, s: *u8) {
    unsafe { buf_str(out, s) };
}
