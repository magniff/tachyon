// Names across modules: what a name stands for in a module's scope (a
// binding), the `use` declarations and their resolution, lookups with
// privacy, the names `*` imports and C header imports bring, the prelude,
// and paths (`a::b::c`) resolved to what they name.

use crate::base::{
    BUFS, FILES, IntVec, SRC, SYMS, SYM_COUNT, alloc_array, buf_bytes, buf_fmt, buf_new, buf_slice,
    buf_str, grow, intern_c, sym_table, sym_text,
};
use crate::base::diag::{
    ERR_HELP, buf_position, err_begin, err_end, err_end_soft, err_failed_name, err_fix, err_fixable,
    err_fmt, err_help, err_help_fmt, err_help_sym, err_str, err_sym, err_try, err_try_fmt,
    err_try_tool, error_at, fail_name, fix_at_ok,
};
use crate::front::ast::{NODES, NodeKind, child};
use crate::front::check::{PROGRAM, SELF_SYM, Try, attempt, name_error};
use crate::front::check::collect::template_variant_named;
use crate::front::check::names::{help_near_item, import_path_for};
use crate::front::lexer::is_ident_byte;
use crate::front::modules::{
    CUR_MOD, C_MODULE, MODULES, MODULE_COUNT, STD_MODULE, child_module, file_of_pos, is_within,
    module_of, qualified_if_known, qualify,
};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::types::{ENUMS, SYM_ENUM, VARIANTS, find_variant, item_node_of};
use crate::middle::lower::ssa::HMap;
use crate::tools::fix::note_private;
use crate::tools::query::QF_USE;
use crate::tools::query::command_line::{qnote, qnote_module};

// ---- Scopes ----

// What a name stands for in a scope: nothing, an item (by key), a module,
// a variant, or an item that is private there.
pub const B_NONE: i64 = 0;

pub const B_ITEM: i64 = 1;

pub const B_MODULE: i64 = 2;

pub const B_VARIANT: i64 = 3;

pub const B_PRIVATE: i64 = 4;

// A variant of a generic enum (0.6), by the enum's template (its ENUMS
// index): its type arguments are inferred where it is used.
pub const B_TVARIANT: i64 = 5;

// An ambiguous name (0.6): two `*` imports bring different things (code
// written for 0.7, being rewritten by --fix-imports).
pub const B_AMBIGUOUS: i64 = -4;

pub fn binding(kind: i64, value: i64) -> i64 {
    kind + value * 8
}

pub fn binding_kind(b: i64) -> i64 {
    b & 7
}

pub fn binding_value(b: i64) -> i64 {
    b >> 3
}

// `use` items: one entry per imported name, one per `*`.
struct UseEntry {
    module: i64, name: i64, item: i64, path: i64, glob: bool, public: bool,
    state: i64, result: i64, node: i64,
}

static mut USE_ENTRIES: *UseEntry = 0 as *UseEntry;

static mut USE_ENTRY_COUNT: i64 = 0;

static mut USE_ENTRY_CAP: i64 = 0;

// Lookups by (module, name), once the items are known.
static mut SCOPE_CACHE: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

static mut SCOPES_READY: bool = false;

// Per module (below USES_INDEXED), the indices of its use entries in order.
static mut MODULE_USES: *IntVec = 0 as *IntVec;

static mut USES_INDEXED: i64 = 0;

pub static mut SYM_CRATE: i64 = 0;

pub static mut SYM_SUPER: i64 = 0;

pub static mut SYM_STD: i64 = 0;

fn add_use_entry(module: i64, name: i64, item: i64, path: i64, glob: bool, public: bool, node: i64) {
    unsafe {
        USE_ENTRIES = grow(USE_ENTRIES, USE_ENTRY_COUNT, &USE_ENTRY_CAP);
        USE_ENTRIES[USE_ENTRY_COUNT] = UseEntry {
            module, name, item, path, glob, public, state: 0, result: 0, node,
        };
    }
    USE_ENTRY_COUNT += 1;
}

// The entries of the program's `use` and `import` items.
pub fn collect_uses() {
    unsafe {
        SYM_CRATE = intern_c(c"crate");
        SYM_SUPER = intern_c(c"super");
        SYM_STD = intern_c(c"std");
        for i in 0..NODES[PROGRAM].count {
            let item = child(PROGRAM, i);
            if NODES[item].kind != NodeKind::Use {
                continue;
            }
            let m = module_of(item);
            let public = (NODES[item].p & ITEM_PUBLIC) != 0;
            if NODES[item].d == 2 {
                // `import "h.h";` sees the C module's items; `import "h.h"
                // as c;` names the module.
                if C_MODULE < 0 {
                    continue;
                }
                let entry = USE_ENTRY_COUNT;
                if NODES[item].a == 0 {
                    LEGACY_IMPORTS = true;
                }
                add_use_entry(m, NODES[item].a, 0, 0, NODES[item].a == 0, public, item);
                USE_ENTRIES[entry].state = 2;
                USE_ENTRIES[entry].result = binding(B_MODULE, C_MODULE);
                continue;
            }
            let path = NODES[item].c;
            if NODES[item].b == 1 {
                LEGACY_IMPORTS = true;
                add_use_entry(m, -1, 0, path, true, public, item);
                continue;
            }
            for k in 0..NODES[item].count {
                let id = child(item, k);
                let name = if NODES[id].b != 0 { NODES[id].b } else { NODES[id].a };
                // (a counted loop, not `.any`: this one is quadratic in the
                // program's use entries, and a loop over a range's iterator
                // costs a move per element more at -O2)
                let mut twice = false;
                for e in 0..USE_ENTRY_COUNT {
                    if USE_ENTRIES[e].module == m && USE_ENTRIES[e].name == name
                        && !USE_ENTRIES[e].glob {
                        twice = true;
                        break;
                    }
                }
                if twice {
                    err_begin(NODES[id].start);
                    err_fmt(f"'{sym_text(name)}' is imported twice");
                    err_end_soft();
                    continue;
                }
                add_use_entry(m, name, id, path, false, public, item);
            }
        }
        MODULE_USES = alloc_array::<IntVec>(MODULE_COUNT);
        USES_INDEXED = MODULE_COUNT;
        for u in 0..USE_ENTRY_COUNT {
            MODULE_USES[USE_ENTRIES[u].module].push(u);
        }
        SCOPES_READY = true;
    }
}

// What use entry u imports: for `use p::x`, what x names in p; for `use
// p::*`, the module (or enum) p.
fn resolve_use(u: i64) -> i64 {
    unsafe {
        if USE_ENTRIES[u].state == 2 {
            return USE_ENTRIES[u].result;
        }
        if USE_ENTRIES[u].state == 1 {
            error_at(NODES[USE_ENTRIES[u].node].start, c"this import depends on itself");
        }
        USE_ENTRIES[u].state = 1;
        // (an import that fails imports nothing, and the errors saying
        // its name is unknown follow from it: 0.10)
        if !attempt(Try::Use, u) {
            USE_ENTRIES[u].result = B_NONE;
            if !USE_ENTRIES[u].glob {
                fail_name(USE_ENTRIES[u].name);
            }
        }
        USE_ENTRIES[u].state = 2;
        USE_ENTRIES[u].result
    }
}

pub fn resolve_use_of(u: i64) {
    unsafe {
        let m = USE_ENTRIES[u].module;
        let path = USE_ENTRIES[u].path;
        let prefix = resolve_path(m, path, NODES[path].count, u);
        let mut result = 0;
        if USE_ENTRIES[u].glob {
            if binding_kind(prefix) == B_MODULE {
                result = prefix;
            } else if binding_kind(prefix) == B_ITEM && SYM_ENUM[binding_value(prefix)] != 0 {
                result = prefix;
            } else {
                not_enum_or_module(path);
            }
        } else {
            let id = USE_ENTRIES[u].item;
            let name = NODES[id].a;
            if binding_kind(prefix) == B_MODULE {
                result = lookup_name(binding_value(prefix), name, m);
                if binding_kind(result) == B_PRIVATE {
                    access_error(result, NODES[id].start, name);
                }
                if result == B_NONE {
                    unresolved_import(id, path, prefix, m);
                }
            } else if binding_kind(prefix) == B_ITEM && SYM_ENUM[binding_value(prefix)] != 0 {
                let e = SYM_ENUM[binding_value(prefix)] - 1;
                let v = enum_variant_binding(e, name);
                if v == B_NONE {
                    err_begin(NODES[id].start);
                    err_fmt(f"enum '{sym_text(ENUMS[e].name)}' has no variant '{sym_text(name)}'");
                    err_end();
                }
                result = v;
            } else {
                not_enum_or_module(path);
            }
        }
        USE_ENTRIES[u].result = result;
        note_import(USE_ENTRIES[u].item, result);
    }
}

// `tachyonc query` (0.11): what the name `use` item `id` imports.
fn note_import(id: i64, b: i64) {
    unsafe {
        if id == 0 {
            return;
        }
        let pos = NODES[id].start;
        let name = NODES[id].a;
        let kind = binding_kind(b);
        if kind == B_ITEM {
            qnote(pos, name, item_node_of(binding_value(b)), QF_USE);
        } else if kind == B_VARIANT {
            qnote(pos, name, VARIANTS[binding_value(b)].node, QF_USE);
        } else if kind == B_TVARIANT {
            let item = ENUMS[binding_value(b)].node;
            for i in 0..NODES[item].count {
                if NODES[child(item, i)].a == name {
                    qnote(pos, name, child(item, i), QF_USE);
                }
            }
        } else if kind == B_MODULE {
            qnote_module(pos, name, binding_value(b), QF_USE);
        }
    }
}

fn not_enum_or_module(path: i64) -> ! {
    unsafe {
        let last = child(path, NODES[path].count - 1);
        name_error(NODES[last].start, c"'", NODES[last].a, c"' is not an enum or a module (use brings the variants of an enum, or the items of a module, into scope)")
    }
}

// Every use is resolved (once the enums' variants are known), so that
// unused imports are checked too.
pub fn resolve_all_uses() {
    for u in 0..USE_ENTRY_COUNT {
        resolve_use(u);
    }
}

// `use path::name;` where the module of path has no `name` (0.17: what
// std has instead, the nearest name there, or the module that has it).
fn unresolved_import(id: i64, path: i64, prefix: i64, from: i64) -> ! {
    unsafe {
        err_begin(NODES[id].start);
        err_str(c"unresolved import '");
        for i in 0..NODES[path].count {
            err_fmt(f"{sym_text(NODES[child(path, i)].a)}::");
        }
        let name = NODES[id].a;
        err_fmt(f"{sym_text(name)}'");
        let pm = binding_value(prefix);
        if name == SELF_SYM && NODES[path].count > 0 {
            // (0.17) Rust's `use m::{self, X};`
            let p = buf_new();
            for i in 0..NODES[path].count {
                if i > 0 {
                    buf_str(p, c"::");
                }
                buf_bytes(p, SYMS[NODES[child(path, i)].a].text);
            }
            err_help_fmt(
                f"`self` in a `use` list is not supported: import the module on a line of its own, `use {buf_slice(p)};`, and the rest from it");
            err_try_fmt(f"use {buf_slice(p)};");
            err_end();
        }
        if pm == STD_MODULE {
            if !help_std_path(name, 0, from, true) && SYMS[name].text == "gpa" {
                err_help(c"the allocator is main's parameter, `fn main(gpa: Gpa)`, passed down");
            }
        }
        help_near_item(pm, name);
        if BUFS[ERR_HELP].len == 0 {
            let other = import_path_for(name, true);
            let at = if other != 0 { other } else { import_path_for(name, false) };
            if at != 0 {
                err_help_fmt(f"'{sym_text(name)}' is in {buf_slice(at)}");
                err_try_fmt(f"use {buf_slice(at)}::{sym_text(name)};");
            }
        }
        err_end()
    }
}

pub fn private_error(pos: i64, name: i64, key: i64) -> ! {
    unsafe {
        err_begin(pos);
        err_fmt(f"'{sym_text(name)}' is private");
        help_make_public(key, name);
        err_end()
    }
}

// The help of a private item (by key): its declaration with `pub` (0.14),
// `make it public: `pub fn f` at FILE: line L, column C`: the text of its
// first line up to its name, where `tachyonc fix --only pub` writes `pub`.
fn help_make_public(key: i64, name: i64) {
    unsafe {
        let item = if key >= 0 && key < SYM_COUNT { item_node_of(key) } else { 0 };
        if item == 0 {
            if child_module_key(key) {
                err_help_fmt(f"make it public: `pub mod {sym_text(name)}`");
            }
            return;
        }
        let start = NODES[item].start;
        if FILES[file_of_pos(start)].path[0] == '<' {
            // (std's)
            return;
        }
        let text = SYMS[name].text;
        let mut e = start;
        while e < NODES[item].end && SRC[e] != '\n' {
            e += 1;
        }
        // The first whole word `name` on the line.
        let mut stop = -1;
        let mut i = start;
        while i + text.len <= e && stop < 0 {
            let same = (0..text.len).all(|k| SRC[i + k] == text[k]);
            if same && (i == start || !ident_byte(SRC[i - 1]))
                && (i + text.len == e || !ident_byte(SRC[i + text.len])) {
                stop = i + text.len;
            }
            i += 1;
        }
        err_help(c"make it public: `pub ");
        if stop > 0 {
            buf_bytes(ERR_HELP, SRC[start..stop]);
        } else {
            err_help_sym(name);
        }
        err_help(c"` at ");
        buf_position(ERR_HELP, start);
        // (0.18: `fix --suggested` adds it, as `fix --only pub`)
        err_fixable();
    }
}

fn ident_byte(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

// Whether key is a module's (`a::b` of `mod b;` in a).
fn child_module_key(key: i64) -> bool {
    unsafe {
        for m in 1..MODULE_COUNT {
            if MODULES[m].key == key {
                return true;
            }
        }
        false
    }
}

// The error for a binding that cannot be used: private, or (0.6) brought
// by two `*` imports.
pub fn access_error(b: i64, pos: i64, name: i64) -> ! {
    // (0.18: `fix --suggested --at FILE:LINE`, the error at that line)
    if fix_at_ok(pos) {
        note_private(b);
    }
    if b == B_AMBIGUOUS {
        unsafe {
            name_error(pos, c"'", name, c"' is ambiguous: more than one '*' import brings it (import it by name, or write its path)");
        }
    }
    private_error(pos, name, binding_value(b))
}

// What `name` stands for in module m, seen from code in module `from`.
pub fn lookup_name(m: i64, name: i64, from: i64) -> i64 {
    // (not while the imports are recorded: see LEGACY_IMPORTS)
    let cacheable = SCOPES_READY && m == from && !LEGACY_IMPORTS;
    let k = (name + 1) * 65536 + m;
    if cacheable {
        let known = SCOPE_CACHE.get(k);
        if known != 0 {
            return known - 1;
        }
    }
    let result = lookup_uncached(m, name, from, 0);
    if cacheable {
        SCOPE_CACHE.put(k, result + 1);
    }
    result
}

// What `name` stands for in module m, seen from `from`, where a value or a
// type is wanted (0.14): when m has a child module `name` and imports an
// item of that name too (`mod eval; use eval::eval;`), the item, as in
// Rust; paths (`eval::other`) still go through the module.
pub fn lookup_item(m: i64, name: i64, from: i64) -> i64 {
    unsafe {
        let b = lookup_name(m, name, from);
        if binding_kind(b) != B_MODULE || !SCOPES_READY {
            return b;
        }
        let inside = is_within(from, m);
        let count = if m < USES_INDEXED { MODULE_USES[m].count } else { 0 };
        for k in 0..count {
            let u = MODULE_USES[m].data[k];
            if USE_ENTRIES[u].name == name && !USE_ENTRIES[u].glob
                && (inside || USE_ENTRIES[u].public) {
                let item = resolve_use(u);
                if binding_kind(item) == B_ITEM || binding_kind(item) == B_PRIVATE {
                    return item;
                }
            }
        }
        b
    }
}

fn lookup_uncached(m: i64, name: i64, from: i64, depth: i64) -> i64 {
    unsafe {
        let inside = is_within(from, m);
        // (no symbol is made for the names looked for and not found)
        let key = qualified_if_known(m, name);
        let item = if key >= 0 { item_node_of(key) } else { 0 };
        if item != 0 {
            if inside || (NODES[item].p & ITEM_PUBLIC) != 0 || MODULES[m].is_c {
                return binding(B_ITEM, key);
            }
            return binding(B_PRIVATE, key);
        }
        let c = child_module(m, name);
        if c >= 0 {
            if inside || MODULES[c].public {
                return binding(B_MODULE, c);
            }
            return binding(B_PRIVATE, qualify(m, name));
        }
        if !SCOPES_READY || depth > 8 {
            return B_NONE;
        }
        // (only the module's own entries: its imports, then its `*` imports)
        let count = if m < USES_INDEXED { MODULE_USES[m].count } else { 0 };
        for k in 0..count {
            let u = MODULE_USES[m].data[k];
            if USE_ENTRIES[u].name == name && !USE_ENTRIES[u].glob
                && (inside || USE_ENTRIES[u].public) {
                return resolve_use(u);
            }
        }
        // `*` imports: two that bring different things make the name
        // ambiguous (an error where it is used; 0.6, before the first won).
        let mut globbed = B_NONE;
        let mut via = -1;
        for k in 0..count {
            let u = MODULE_USES[m].data[k];
            if !USE_ENTRIES[u].glob || !(inside || USE_ENTRIES[u].public) {
                continue;
            }
            let what = resolve_use(u);
            let mut found = B_NONE;
            if what == B_NONE {
                // (an import that failed)
                continue;
            }
            if binding_kind(what) == B_MODULE {
                let item = lookup_uncached(binding_value(what), name, m, depth + 1);
                let kind = binding_kind(item);
                if kind == B_ITEM || kind == B_MODULE || kind == B_VARIANT || kind == B_TVARIANT {
                    found = item;
                }
            } else {
                found = enum_variant_binding(SYM_ENUM[binding_value(what)] - 1, name);
            }
            if found != B_NONE {
                if globbed == B_NONE {
                    globbed = found;
                    via = u;
                } else if globbed != found {
                    return B_AMBIGUOUS;
                }
            }
        }
        if globbed != B_NONE {
            if LOOKUP_QUIET == 0 {
                note_glob_use(via, name, m == from && depth == 0);
            }
            return globbed;
        }
        if MODULES[m].is_c {
            // The imported declarations see the root's names (its types
            // replace the headers' of the same names).
            return lookup_uncached(0, name, 0, depth + 1);
        }
        // (0.18) A `#[cfg(test)]` module sees its parent's items, private
        // ones too, as a nested scope sees its parent's names (front/tests).
        if depth == 0 && m == from && crate::front::tests::is_test_module(m) {
            let up = lookup_uncached(MODULES[m].parent, name, m, depth + 1);
            if up != B_NONE {
                return up;
            }
        }
        // The prelude is part of the scope of the code being checked, not an
        // item of the modules its `*` imports and paths go through.
        // (0.17: std's own code too: `None`, `Some(x)`)
        if STD_MODULE >= 0 && depth == 0 && m == from {
            return prelude_lookup(name, m, depth);
        }
        B_NONE
    }
}

// ---- What the `*` imports and the plain header imports bring (0.8) ----
//
// 0.8 removed `use a::b::*;`, `use E::*;` and `import "h.h";` (without
// `as`). They are still parsed and resolved, so that `tachyonc
// --fix-imports` can turn code written for 0.7 into explicit imports, and
// the errors for them can name what replaces them. While a program has
// one (LEGACY_IMPORTS), every name a lookup finds through a `*` is
// recorded with the entry that brought it, and the scope cache is off
// (a lookup that only asks, LOOKUP_QUIET, records nothing; its caller
// repeats it with lookup_commit once the answer is used).

pub static mut LEGACY_IMPORTS: bool = false;

pub static mut LOOKUP_QUIET: i64 = 0;

// (entry, name) pairs, in the order found; GLOB_SEEN: the same, as keys.
pub static mut GLOB_USES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

static mut GLOB_SEEN: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

// The `*` entry (+ 1) a bare name of a module came through, by (module,
// name).
static mut GLOB_VIA: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

// The uses of C declarations through a plain `import "h.h";`: (position,
// entry, name) triples, to be written `c::name`; QUAL_SEEN: by position,
// and by (entry, name) for the names no longer imported by name.
pub static mut C_QUALS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

static mut QUAL_SEEN: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

static mut QUAL_NAMES: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

// The positions of patterns (a constant cannot be written with its path
// there), and the C declarations used in them: (entry, name) pairs, to be
// imported by name (`use c::EOF;`).
static mut PATTERN_POS: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

pub static mut C_BY_NAME: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

static mut BY_NAME_SEEN: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

// The name at `pos` is a pattern's.
pub fn note_pattern_pos(pos: i64) {
    if LEGACY_IMPORTS {
        PATTERN_POS.put(pos + 1, 1);
    }
}

fn glob_key(u: i64, name: i64) -> i64 {
    (u + 1) * 16777216 + name + 1
}

fn note_glob_use(u: i64, name: i64, bare: bool) {
    if bare {
        unsafe { GLOB_VIA.put((name + 1) * 65536 + USE_ENTRIES[u].module, u + 1); }
    }
    let k = glob_key(u, name);
    if GLOB_SEEN.get(k) == 0 {
        GLOB_SEEN.put(k, 1);
        GLOB_USES.push(u);
        GLOB_USES.push(name);
    }
}

// A lookup whose answer may go unused (records nothing).
pub fn lookup_quiet(m: i64, name: i64, from: i64) -> i64 {
    LOOKUP_QUIET += 1;
    let b = lookup_name(m, name, from);
    LOOKUP_QUIET -= 1;
    b
}

// Bare name `name` at `pos`, looked up quietly in the current module, is
// used.
pub fn lookup_commit(name: i64, pos: i64) {
    if LEGACY_IMPORTS {
        note_c_use(pos, name, lookup_name(CUR_MOD, name, CUR_MOD));
    }
}

// Bare name `name` at `pos` in the current module stands for b: when b is
// a C declaration found through a `*` entry (a plain import, or a `*`
// that leads to one), the use is recorded for --fix-imports.
pub fn note_c_use(pos: i64, name: i64, b: i64) {
    if !LEGACY_IMPORTS || LOOKUP_QUIET > 0 || C_MODULE < 0 || binding_kind(b) != B_ITEM {
        return;
    }
    let via = GLOB_VIA.get((name + 1) * 65536 + CUR_MOD) - 1;
    if via < 0 || qualified_if_known(C_MODULE, name) != binding_value(b)
        || QUAL_SEEN.get(pos + 1) != 0 {
        return;
    }
    QUAL_SEEN.put(pos + 1, 1);
    QUAL_NAMES.put(glob_key(via, name), 1);
    if PATTERN_POS.get(pos + 1) != 0 {
        if BY_NAME_SEEN.get(glob_key(via, name)) == 0 {
            BY_NAME_SEEN.put(glob_key(via, name), 1);
            C_BY_NAME.push(via);
            C_BY_NAME.push(name);
        }
        return;
    }
    C_QUALS.push(pos);
    C_QUALS.push(via);
    C_QUALS.push(name);
}

// Whether the C declaration `name`, found through entry u, is written
// with its path instead (so it is not imported by name).
pub fn glob_name_qualified(u: i64, name: i64) -> bool {
    QUAL_NAMES.get(glob_key(u, name)) != 0
}

pub fn use_entry_count() -> i64 {
    USE_ENTRY_COUNT
}

// Entry u: its `use`/`import` node, module, and whether it is a `*` (or a
// plain import, d = 2).
pub fn use_entry_node(u: i64) -> i64 {
    unsafe { USE_ENTRIES[u].node }
}

pub fn use_entry_module(u: i64) -> i64 {
    unsafe { USE_ENTRIES[u].module }
}

pub fn use_entry_glob(u: i64) -> bool {
    unsafe { USE_ENTRIES[u].glob }
}

// Variant `name` of enum e: B_VARIANT, or B_TVARIANT for a generic enum,
// or B_NONE.
pub fn enum_variant_binding(e: i64, name: i64) -> i64 {
    if unsafe { ENUMS[e].generic > 0 } {
        if template_variant_named(e, name) {
            return binding(B_TVARIANT, e);
        }
        return B_NONE;
    }
    let v = find_variant(e, name);
    if v >= 0 { binding(B_VARIANT, v) } else { B_NONE }
}

// ---- The prelude (0.6) ----
//
// Names every module sees without `use`, after everything else (its own
// items, its imports): std's Option, Some, None, Result, Ok, Err, Vec,
// print and println (0.9: the operator traits and Hash; 0.14: Iterator;
// 0.15: Display, Debug, Clone, From, Into, format, eprint, eprintln;
// 0.17: Buf, HashMap, read_line, trim, ..., panic, unreachable, see
// prelude_name): a fixed list, not a `*` import (it stays in 0.8). The
// standard library is loaded when a program names one of them (or `std`;
// 0.14: or uses a range as a value, see load_std_if_named). (0.17) std's
// own code sees the prelude too.

// The prelude's names, interned once (it is asked about every identifier
// while the modules load): Option, Some, None, Result, Ok, Err, Vec,
// print, println, ... (prelude_name). SYM_PRELUDE[sym] is a name's index
// in it plus one, 0 for a name not in it.
static mut PRELUDE_NAMES: [i64; PRELUDE_COUNT] = [0; PRELUDE_COUNT];

static mut SYM_PRELUDE: *i64 = 0 as *i64;

// The number of the prelude's names; those from PRELUDE_LATE on (0.15's,
// 0.16's and 0.17's) load std only where the program uses them
// (front::modules::uses_prelude015). (0.18) The one bound of the prelude's
// tables (its names here, PRELUDE_DECLARED): a name is added to
// prelude_name's list and counted here.
pub const PRELUDE_COUNT: i64 = 66;

pub const PRELUDE_LATE: i64 = 18;

// The index of `panic` (0.17), which is std's safe `panic_str`, not the
// `unsafe fn panic` of a C string that `std::panic` names.
const PRELUDE_PANIC: i64 = 49;

static mut PRELUDE_INTERNED: bool = false;

fn prelude_name(i: i64) -> i64 {
    if !PRELUDE_INTERNED {
        // (0.9: and the traits of the operators, and Hash; 0.14: Iterator;
        // 0.15: formatting, conversions, Clone; 0.16: allocators, format_in;
        // 0.17: what Rust has without a `use` or programs reach for first:
        // text and input, Buf, HashMap, sorting, cmp_of/eq_of, Fmt, a safe
        // panic and unreachable; the stable sorts; value semantics: Drop,
        // drop, forget, needs_drop, Copy; 0.18: the assertions; 0.18.1: the heaps)
        let names: [*u8; PRELUDE_COUNT] = [c"Option", c"Some", c"None", c"Result", c"Ok", c"Err",
            c"Vec", c"print", c"println", c"Add", c"Sub", c"Mul", c"Div", c"Neg", c"Eq", c"Ord",
            c"Hash", c"Iterator", c"Display", c"Debug", c"Clone", c"From", c"Into", c"format",
            c"eprint", c"eprintln", c"Allocator", c"Gpa", c"Arena", c"ScopedArena", c"arena_scope",
            c"format_in", c"Buf", c"HashMap", c"read_line", c"read_stdin_in", c"read_stdin",
            c"Scanner", c"parse_int", c"trim", c"split", c"split_in", c"split_whitespace",
            c"split_whitespace_in", c"cmp_of", c"eq_of", c"Fmt", c"sort", c"sort_by", c"panic",
            c"unreachable", c"sort_stable", c"sort_stable_by", c"sort_stable_in",
            c"sort_stable_by_in", c"Drop", c"drop", c"forget", c"needs_drop", c"Copy", c"assert",
            c"assert_eq", c"assert_ne", c"debug_assert", c"BinaryHeap", c"MinHeap"];
        unsafe {
            sym_table(&SYM_PRELUDE);
            for k in 0..PRELUDE_COUNT {
                let sym = intern_c(names[k]);
                PRELUDE_NAMES[k] = sym;
                SYM_PRELUDE[sym] = k + 1;
            }
        }
        PRELUDE_INTERNED = true;
    }
    PRELUDE_NAMES[i]
}

// The index of `name` in the prelude, -1 when it is not one of its names.
pub fn prelude_index(name: i64) -> i64 {
    prelude_name(0);
    unsafe { SYM_PRELUDE[name] - 1 }
}

pub fn is_prelude_name(name: i64) -> bool {
    prelude_index(name) >= 0
}

// Whether name is one the prelude gained in 0.15 or later (Display, Debug,
// Clone, From, Into, format, eprint, eprintln; 0.16's Allocator, Gpa,
// Arena, ScopedArena, arena_scope, format_in; 0.17's Buf, HashMap, trim,
// ...): load_std_if_named looks at how a program uses these before it
// loads std for them.
pub fn is_prelude015(name: i64) -> bool {
    prelude_index(name) >= PRELUDE_LATE
}

fn prelude_lookup(name: i64, m: i64, depth: i64) -> i64 {
    unsafe {
        let k = prelude_index(name);
        if k < 0 {
            return B_NONE;
        }
        let some = k == 1 || k == 2;
        let ok = k == 4 || k == 5;
        if some || ok {
            let e = lookup_uncached(STD_MODULE,
                if some { prelude_name(0) } else { prelude_name(3) }, m, depth + 1);
            if binding_kind(e) != B_ITEM || SYM_ENUM[binding_value(e)] == 0 {
                return B_NONE;
            }
            return enum_variant_binding(SYM_ENUM[binding_value(e)] - 1, name);
        }
        if k == PRELUDE_PANIC {
            return lookup_uncached(STD_MODULE, intern_c(c"panic_str"), m, depth + 1);
        }
        lookup_uncached(STD_MODULE, name, m, depth + 1)
    }
}

// The module (or the item, for the last segment) named by the first
// `count` segments of `path` (a Path node whose list holds Ident nodes),
// from module m: `crate`, `self` and `super` first; `std`. `entry`: the
// use entry whose path it is, or -1 (for the helps of its errors, 0.17).
pub fn resolve_path(m: i64, path: i64, count: i64, entry: i64) -> i64 {
    unsafe {
        let mut cur = binding(B_MODULE, m);
        for i in 0..count {
            let seg = child(path, i);
            let name = NODES[seg].a;
            if binding_kind(cur) != B_MODULE {
                name_error(NODES[seg].start, c"'", NODES[child(path, i - 1)].a,
                    c"' is not a module");
            }
            let here = binding_value(cur);
            if i == 0 && name == SYM_CRATE {
                cur = binding(B_MODULE, 0);
                continue;
            }
            if i == 0 && name == SELF_SYM {
                continue;
            }
            if name == SYM_SUPER && (i == 0 || NODES[child(path, i - 1)].a == SYM_SUPER) {
                if MODULES[here].parent < 0 {
                    error_at(NODES[seg].start, c"the root module has no 'super'");
                }
                cur = binding(B_MODULE, MODULES[here].parent);
                continue;
            }
            let found = lookup_name(here, name, m);
            if binding_kind(found) == B_PRIVATE {
                access_error(found, NODES[seg].start, name);
            }
            if found == B_NONE {
                if i == 0 && name == SYM_STD && STD_MODULE >= 0 {
                    cur = binding(B_MODULE, STD_MODULE);
                    continue;
                }
                if i == 0 {
                    let other = sibling_module(m, name, seg, path, entry);
                    if other >= 0 {
                        cur = binding(B_MODULE, other);
                        qnote_module(NODES[seg].start, name, other, 0);
                        continue;
                    }
                }
                err_begin(NODES[seg].start);
                err_failed_name(name);
                if i == 0 {
                    err_fmt(f"unknown module '{sym_text(name)}'");
                    help_unknown_module(m, name, path, entry);
                } else {
                    err_fmt(f"no '{sym_text(name)}' in module '");
                    if here == 0 {
                        err_str(c"crate");
                    } else {
                        err_sym(MODULES[here].key);
                    }
                    err_str(c"'");
                    if here == STD_MODULE {
                        let next = if i + 1 < NODES[path].count { NODES[child(path, i + 1)].a }
                            else if entry >= 0 && !USE_ENTRIES[entry].glob {
                                NODES[USE_ENTRIES[entry].item].a
                            } else { 0 };
                        help_std_path(name, next, m, entry >= 0);
                    }
                    help_near_item(here, name);
                }
                err_end();
            }
            cur = found;
            if binding_kind(found) == B_MODULE {
                qnote_module(NODES[seg].start, name, binding_value(found), 0);
            }
        }
        cur
    }
}

// (0.17) The module the first segment `name` (node seg) of a path names
// when module m, where it is written, has nothing of that name: a child
// of m's parent (a sibling: `use lexer::Tok;` or `lexer::next(..)` in
// parser.tach, where main.tach has `mod lexer;`), else a child of the
// root; -1: neither. A `use` path (its entry) and a path in code (entry
// -1: a type's, a literal's, an expression's, ending where node path
// ends) alike. Both, and different modules: an error, the two paths from
// the root its try: lines.
pub fn sibling_module(m: i64, name: i64, seg: i64, path: i64, entry: i64) -> i64 {
    unsafe {
        if m == 0 {
            return -1;
        }
        let parent = MODULES[m].parent;
        let mut sibling = -1;
        if parent >= 0 {
            sibling = child_module(parent, name);
        }
        let mut top = -1;
        if parent != 0 {
            top = child_module(0, name);
        }
        if sibling == STD_MODULE || sibling == C_MODULE {
            sibling = -1;
        }
        if top == STD_MODULE || top == C_MODULE {
            top = -1;
        }
        if sibling >= 0 && top >= 0 && sibling != top {
            err_begin(NODES[seg].start);
            err_failed_name(name);
            err_fmt(
                f"ambiguous module '{sym_text(name)}': crate::{sym_text(MODULES[sibling].key)} (beside this module) or crate::{sym_text(name)} (at the root)");
            err_help(c"a path that starts with neither `crate`, `self`, `super` nor a name of this module starts beside it, or at the root: name the one you mean");
            let a = buf_new();
            buf_str(a, c"crate::");
            buf_bytes(a, SYMS[MODULES[parent].key].text);
            path_try(entry, seg, path, buf_slice(a));
            path_try(entry, seg, path, "crate");
            err_end();
        }
        if sibling >= 0 { sibling } else { top }
    }
}

// (0.17) A try: line for use entry `entry`: its line with `prefix::`
// written before its path (`use crate::lexer::{Tok, mk};`).
fn use_line_try(entry: i64, path: i64, prefix: [u8]) {
    unsafe {
        let node = USE_ENTRIES[entry].node;
        let at = NODES[path].start;
        let t = buf_new();
        buf_bytes(t, SRC[NODES[node].start..at]);
        buf_bytes(t, prefix);
        buf_str(t, c"::");
        let mut e = NODES[node].end;
        while e > at && SRC[e - 1] != ';' {
            e -= 1;
        }
        let stop = if e > at { e } else { NODES[node].end };
        buf_bytes(t, SRC[at..stop]);
        err_try_fmt(buf_slice(t));
        // (0.18) the fix: the line so written
        err_fix(NODES[node].start, stop, buf_slice(t));
    }
}

// (0.17) A try: line for a path (its first segment, node seg) with
// `prefix::` written before it: a `use` entry's line (use_line_try), or the
// path in code, its names and `::`s (`crate::front::util::twice`).
fn path_try(entry: i64, seg: i64, path: i64, prefix: [u8]) {
    if entry >= 0 {
        use_line_try(entry, path, prefix);
        return;
    }
    unsafe {
        let start = NODES[seg].start;
        let mut end = start;
        while is_ident_byte(SRC[end]) || SRC[end] == ':' {
            end += 1;
        }
        while end > start && SRC[end - 1] == ':' {
            end -= 1;
        }
        let t = buf_new();
        buf_bytes(t, prefix);
        buf_str(t, c"::");
        buf_bytes(t, SRC[start..end]);
        err_try_fmt(buf_slice(t));
        // (0.18) the fix: the first segment so written
        let full = buf_new();
        buf_bytes(full, prefix);
        buf_str(full, c"::");
        buf_bytes(full, SYMS[NODES[seg].a].text);
        path_fix(start, NODES[seg].a, buf_slice(full));
    }
}

// (0.17) The help of `unknown module 'name'` at the start of path, from
// module m: a module of that name elsewhere in the crate is reached from
// the root (`crate::name::...`; for a `use`, its line so written is the
// try:); a Rust std module is std's item; else the nearest module.
fn help_unknown_module(m: i64, name: i64, path: i64, entry: i64) {
    unsafe {
        let mut found = -1;
        if m != 0 && MODULES[m].parent >= 0 {
            found = child_module(MODULES[m].parent, name);
        }
        if m != 0 && found < 0 {
            found = child_module(0, name);
        }
        if found == m || found == STD_MODULE || found == C_MODULE {
            found = -1;
        }
        if found < 0 {
            for k in 1..MODULE_COUNT {
                if MODULES[k].name == name && k != STD_MODULE && k != C_MODULE && k != m
                    && !is_within(k, STD_MODULE) {
                    found = k;
                    break;
                }
            }
        }
        if found >= 0 {
            let full = buf_new();
            buf_str(full, c"crate");
            if MODULES[found].parent != 0 {
                buf_str(full, c"::");
                buf_bytes(full, SYMS[MODULES[MODULES[found].parent].key].text);
            }
            err_help_fmt(
                f"'{sym_text(name)}' is the module {buf_slice(full)}::{sym_text(name)}; a path starts in this module, beside it or at the root: write `{buf_slice(full)}::{sym_text(name)}::...`");
            if entry >= 0 {
                use_line_try(entry, path, buf_slice(full));
            } else {
                // (a type or a literal's path: the module imported, as
                // module_as_path_error's for an expression)
                err_try_fmt(f"use {buf_slice(full)}::{sym_text(name)};");
                // (0.18) the fix: the path from the crate's root
                buf_str(full, c"::");
                buf_bytes(full, SYMS[name].text);
                path_fix(if path > 0 { NODES[path].start } else { -1 }, name, buf_slice(full));
            }
            return;
        }
        if help_std_path(name, 0, m, entry >= 0) {
            return;
        }
        help_near_item(m, name);
    }
}

// (0.17) `table::f(x)` in an expression (Path node path at `at`), where
// `table` is no name of module m nor a module beside it or at the root
// (those are found as a `use` path's are), but a module elsewhere in the
// crate: the error names it and its `use` line; returns when no module
// has that name.
pub fn module_as_path_error(m: i64, name: i64, at: i64, path: i64) {
    unsafe {
        let mut found = -1;
        for k in 1..MODULE_COUNT {
            if MODULES[k].name == name && k != STD_MODULE && k != C_MODULE && k != m
                && !is_within(k, STD_MODULE) {
                found = k;
                break;
            }
        }
        if found < 0 {
            return;
        }
        err_begin(at);
        err_failed_name(name);
        err_fmt(f"unknown module '{sym_text(name)}'");
        help_unknown_module(m, name, path, -1);
        err_end()
    }
}

// (0.18) The fix of a path whose first segment, module `name` at `at`
// (-1: unknown), is written from the crate's root: `full` in its place.
fn path_fix(at: i64, name: i64, full: [u8]) {
    unsafe {
        let text = SYMS[name].text;
        if at < 0 || SRC[at..at + text.len] != text || SRC[at + text.len] != ':' {
            return;
        }
        err_fix(at, at + text.len, full);
    }
}

// (0.17) The help of a path through `std::name` that std does not have,
// `next` the name after it (or 0), seen from module m: tachyon's std is
// one module, so a Rust path (`std::collections::HashMap`, `std::io`) is
// std's item itself (`std::HashMap`, the `use` line as try:), or what
// replaces that module (`in_use`: the path is a `use` item's; else the
// try: is the path to write). Whether there was a help.
pub fn help_std_path(name: i64, next: i64, m: i64, in_use: bool) -> bool {
    unsafe {
        let t = SYMS[name].text;
        if next != 0 && STD_MODULE >= 0
            && binding_kind(lookup_quiet(STD_MODULE, next, m)) == B_ITEM {
            err_help_fmt(f"tachyon's std is one module, without '{t}': its items are `std::NAME`");
            if in_use {
                err_try_fmt(f"use std::{sym_text(next)};");
            } else {
                err_try_fmt(f"std::{sym_text(next)}");
            }
            return true;
        }
        if t == "io" {
            err_help(c"tachyon's std is one module: stdin is `read_line(&buf)` (a line), `read_stdin_in(gpa)` (all of it, a Buf), `Scanner` (tokens); output is `print`, `println`");
            err_try(c"use std::{Scanner, read_line, read_stdin_in};");
        } else if t == "collections" {
            err_help(c"tachyon's std is one module: `HashMap<K, V>` (a set: `HashMap<K, bool>`), `Vec<T>` (in the prelude)");
            err_try(c"use std::HashMap;");
        } else if t == "fmt" {
            err_help(
                c"tachyon's std is one module: `Display` (`fn fmt(self: *T, f: *Fmt)`), `Fmt`");
            err_try(c"use std::{Display, Fmt};");
        } else if t == "string" || t == "str" || t == "char" {
            err_help(c"text is `[u8]` (string literals are one), built in a `std::Buf`; std's text functions are `std::trim`, `std::split_in`, `std::parse_int`, ...");
            err_try(c"use std::Buf;");
        } else if t == "vec" || t == "option" || t == "result" || t == "prelude" {
            err_help(
                c"`Vec`, `Option`, `Result` and their variants are in the prelude: no `use` needed");
        } else if t == "mem" || t == "cmp" || t == "iter" || t == "ops" || t == "convert"
            || t == "hash" || t == "process" || t == "env" || t == "fs" || t == "num"
            || t == "boxed" || t == "rc" || t == "cell" || t == "sync" || t == "thread"
            || t == "time" || t == "path" || t == "slice" || t == "error" || t == "core"
            || t == "alloc" {
            err_help(c"tachyon's std is one module, without submodules: its items are `std::NAME` (`tachyonc query items std` lists them)");
        } else {
            return false;
        }
        true
    }
}

// The item a node names through a path of modules (h of a StructLit or a
// PatVariant, the list of a TyName or a Path): the module after its
// segments, from the module being checked.
pub fn path_module(path: i64, count: i64) -> i64 {
    unsafe {
        let b = resolve_path(CUR_MOD, path, count, -1);
        if binding_kind(b) != B_MODULE {
            name_error(NODES[child(path, count - 1)].start, c"'", NODES[child(path, count - 1)].a,
                c"' is not a module");
        }
        binding_value(b)
    }
}
