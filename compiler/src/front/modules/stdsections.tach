// std in sections (0.15): the loader lexes only the sections of std a
// program can reach. compiler/std/index.awk makes their index (std_index):
// for each section its bytes in std's text, whether it is core (always
// loaded), the words that ask for a lazy one (the items it defines, the
// methods of its impls of other sections' types), its items, its trait
// impls and the sections it needs. A lazy section is loaded when the program names one
// of its words, or a construct names it for the compiler (seeds), or one
// of its impls may apply (trait and type both known); with what it needs.
// The sections keep their places in std's text: positions and line
// numbers are std's.

use crate::base::{IntVec, buf_new, buf_slice, intern, intern_c};
use crate::front::lexer::{TOKS, TOK_COUNT, Tok, lex_range};
use crate::front::modules::range_as_value;
use crate::front::stdalloc::CHECK_ALLOC_MODE;
use crate::front::stdsrc::{std_check_index, std_index};
use crate::middle::lower::ssa::HMap;

// The sections (from std_index): bytes, core, loaded; a section's words,
// items, impls (trait, type; type -1: any) and needs are the ranges
// SEC_WORDS[i]..SEC_WORDS[i + 1] of WORDS, and so on.
static mut SEC_COUNT: i64 = -1;
static mut SEC_START: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut SEC_END: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut SEC_CORE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut SEC_LOADED: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut SEC_WORDS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut SEC_ITEMS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut SEC_IMPLS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut SEC_DEPS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// (0.20) A section's gate (index.awk's GATES): a word the program must name
// for the section's words to ask for it, or -1.
static mut SEC_GATE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut WORDS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut ITEMS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut IMPLS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut DEPS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// std's text in SRC.
static mut STD_START: i64 = 0;
static mut STD_END: i64 = 0;

// The words known (+1 as keys): PROGRAM, the program's names and the
// seeds; DEFINED, the items of the loaded sections.
static mut KNOWN: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

const PROGRAM: i64 = 1;
const DEFINED: i64 = 2;

fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

// The index, read once.
fn read_index() {
    unsafe {
        let b = buf_new();
        if CHECK_ALLOC_MODE {
            std_check_index(b);
        } else {
            std_index(b);
        }
        let t = buf_slice(b);
        let mut i = 0;
        SEC_COUNT = 0;
        while i < t.len {
            // START END CORE|WORDS|ITEMS|IMPLS|DEPS
            let mut nums = [0, 0, 0];
            for k in 0..3 {
                let mut v = 0;
                while i < t.len && is_digit(t[i]) {
                    v = v * 10 + (t[i] - '0') as i64;
                    i += 1;
                }
                nums[k] = v;
                i += 1;
            }
            SEC_START.push(nums[0]);
            SEC_END.push(nums[1]);
            SEC_CORE.push(nums[2]);
            SEC_LOADED.push(0);
            SEC_WORDS.push(WORDS.count);
            SEC_ITEMS.push(ITEMS.count);
            SEC_IMPLS.push(IMPLS.count);
            SEC_DEPS.push(DEPS.count);
            SEC_GATE.push(-1);
            // four fields of words, up to the end of the line
            for field in 0..4 {
                loop {
                    while i < t.len && t[i] == ' ' {
                        i += 1;
                    }
                    if i >= t.len || t[i] == '|' || t[i] == '\n' {
                        break;
                    }
                    let w = i;
                    while i < t.len && t[i] != ' ' && t[i] != '|' && t[i] != '\n' {
                        i += 1;
                    }
                    let word = t[w..i];
                    if field == 0 && word.len > 1 && word[0] == '+' {
                        // (0.20) the gate: a word the program must name too
                        SEC_GATE.data[SEC_COUNT] = intern(word[1..word.len]);
                    } else if field == 0 {
                        WORDS.push(intern(word));
                    } else if field == 1 {
                        ITEMS.push(intern(word));
                    } else if field == 2 {
                        IMPLS.push(if word == "*" { -1 } else { intern(word) });
                    } else {
                        let mut v = 0;
                        for k in 0..word.len {
                            v = v * 10 + (word[k] - '0') as i64;
                        }
                        DEPS.push(v);
                    }
                }
                i += 1;
            }
            SEC_COUNT += 1;
        }
        SEC_WORDS.push(WORDS.count);
        SEC_ITEMS.push(ITEMS.count);
        SEC_IMPLS.push(IMPLS.count);
        SEC_DEPS.push(DEPS.count);
    }
}

fn know(sym: i64, how: i64) {
    unsafe {
        let known = KNOWN.get(sym + 1);
        KNOWN.put(sym + 1, known | how);
    }
}

// Whether sym is known as `how` (either: PROGRAM | DEFINED); -1 (any type)
// always.
fn known(sym: i64, how: i64) -> bool {
    unsafe { sym < 0 || (KNOWN.get(sym + 1) & how) != 0 }
}

fn know_c(name: [u8]) {
    know(intern(name), PROGRAM);
}

// Section s loaded, with what it needs; its items known.
fn mark(s: i64, now: &mut IntVec) {
    unsafe {
        if SEC_LOADED.data[s] != 0 {
            return;
        }
        SEC_LOADED.data[s] = 1;
        (*now).push(s);
        for k in SEC_ITEMS.data[s]..SEC_ITEMS.data[s + 1] {
            know(ITEMS.data[k], DEFINED);
        }
        for k in SEC_DEPS.data[s]..SEC_DEPS.data[s + 1] {
            mark(DEPS.data[k], now);
        }
    }
}

// Whether lazy section s is reached: the program names a word of it, or
// an impl of it may apply (its trait and type named or defined); (0.20)
// a section with a gate (SEC_GATE) asks for its words only when the
// program names the gate too.
fn reached(s: i64) -> bool {
    unsafe {
        // (0.20) a gated module's section: only for a program naming its gate
        let gated = SEC_GATE.data[s] >= 0 && !known(SEC_GATE.data[s], PROGRAM);
        for k in SEC_WORDS.data[s]..(if gated { SEC_WORDS.data[s] } else { SEC_WORDS.data[s + 1] }) {
            if known(WORDS.data[k], PROGRAM) {
                return true;
            }
        }
        let mut k = SEC_IMPLS.data[s];
        while k + 1 < SEC_IMPLS.data[s + 1] {
            if known(IMPLS.data[k], PROGRAM | DEFINED)
                && known(IMPLS.data[k + 1], PROGRAM | DEFINED) {
                return true;
            }
            k += 2;
        }
        false
    }
}

// The names of the program's tokens (not std's), and the seeds: what a
// construct makes the compiler use of std.
fn know_program() {
    unsafe {
        // (type arguments' brackets open: `Vec<i64>`, `fn f<T>`)
        let mut angles = 0;
        let detect = intern_c(c"detect");
        let multiversion = intern_c(c"multiversion");
        // (0.20) what makes floats: their Display and Debug are lazy
        // (std::fmt's `impl Display for f64`)
        let v2f64 = intern_c(c"v2f64");
        let v4f32 = intern_c(c"v4f32");
        for i in 0..TOK_COUNT {
            let at = TOKS[i].start;
            if at >= STD_START && at < STD_END {
                continue;
            }
            let k = TOKS[i].kind;
            if k == Tok::Ident {
                know(TOKS[i].value as i64, PROGRAM);
                if TOKS[i].value as i64 == v2f64 || TOKS[i].value as i64 == v4f32 {
                    know_c("f64");
                    know_c("f32");
                }
                // (0.17) `panic(..)`, the prelude's: std's panic_str (not
                // `effects(panic)`, `std::panic(..)` nor `fn panic(..)`)
                if i + 1 < TOK_COUNT && TOKS[i + 1].kind == Tok::LParen && i > 0
                    && TOKS[i - 1].kind != Tok::ColonColon && TOKS[i - 1].kind != Tok::Fn
                    && TOKS[i].value as i64 == intern_c(c"panic") {
                    know_c("panic_str");
                }
                // (0.19) std::arch::detect, #[multiversion]: the run-time
                // features of the target's system (std/arch.tach)
                if TOKS[i].value as i64 == detect && i + 1 < TOK_COUNT
                    && TOKS[i + 1].kind == Tok::LParen
                    || TOKS[i].value as i64 == multiversion && i >= 2
                    && TOKS[i - 1].kind == Tok::LBracket && TOKS[i - 2].kind == Tok::Hash {
                    know_c(if crate::base::target::X86 { "arch_init_x86" }
                        else if crate::base::target::ELF { "arch_init_linux" }
                        else { "arch_init_macos" });
                }
                // `#[derive(...)]`: the helpers the derived impls call
                if i >= 2 && TOKS[i - 1].kind == Tok::LBracket && TOKS[i - 2].kind == Tok::Hash {
                    know_c("Clone");
                    know_c("clone_of");
                    know_c("cmp_of");
                    know_c("hash_of");
                    know_c("eq_of");
                    know_c("hash_mix");
                }
            } else if k == Tok::Float || k == Tok::Import {
                // (0.20) a float literal or a C header: floats
                know_c("f64");
                know_c("f32");
            } else if k == Tok::Question {
                know_c("From");
            } else if k == Tok::EqEq || k == Tok::BangEq {
                know_c("Eq");
            } else if k == Tok::Lt && i > 0 && type_arguments(i) {
                angles += 1;
            } else if k == Tok::Gt && angles > 0 {
                angles -= 1;
            } else if k == Tok::Lt || k == Tok::Gt || k == Tok::LtEq || k == Tok::GtEq {
                // (a comparison)
                know_c("Ord");
            } else if k == Tok::For && iterates(i) {
                know_c("Iterator");
                know_c("IntoIterator");
            } else if (k == Tok::DotDot || k == Tok::DotDotEq) && range_as_value(i) {
                know_c("Range");
                know_c("RangeInclusive");
                know_c("Iterator");
            } else if k == Tok::Fn && i + 1 < TOK_COUNT && TOKS[i + 1].kind == Tok::Ident
                && TOKS[i + 1].value as i64 == intern_c(c"main") {
                // `fn main() -> Result<(), E>`: std::main_error
                let mut j = i + 2;
                while j < TOK_COUNT && TOKS[j].kind != Tok::LBrace && TOKS[j].kind != Tok::Semi {
                    if TOKS[j].kind == Tok::Ident && TOKS[j].value as i64 == intern_c(c"Result") {
                        know_c("main_error");
                    }
                    j += 1;
                }
            }
        }
    }
}

// Whether the `<` at token i opens type arguments or parameters, not a
// comparison: after `::`, `impl`, a capitalized name (a type), or the name
// an item declares (`fn f<T>`).
fn type_arguments(i: i64) -> bool {
    unsafe {
        let p = TOKS[i - 1].kind;
        if p == Tok::ColonColon || p == Tok::Impl {
            return true;
        }
        if p != Tok::Ident {
            return false;
        }
        let c = TOKS[i - 1].start;
        if crate::base::SRC[c] >= 'A' && crate::base::SRC[c] <= 'Z' {
            return true;
        }
        if i < 2 {
            return false;
        }
        let d = TOKS[i - 2].kind;
        d == Tok::Fn || d == Tok::Struct || d == Tok::Enum || d == Tok::Trait || d == Tok::Type
    }
}

// Whether the `for` at token i iterates something other than a range
// written in it (`for x in v`, not `for i in 0..n`).
fn iterates(i: i64) -> bool {
    unsafe {
        let mut j = i + 1;
        while j < TOK_COUNT && TOKS[j].kind != Tok::In && TOKS[j].kind != Tok::LBrace {
            j += 1;
        }
        let mut depth = 0;
        j += 1;
        while j < TOK_COUNT {
            let k = TOKS[j].kind;
            if k == Tok::LParen || k == Tok::LBracket {
                depth += 1;
            } else if k == Tok::RParen || k == Tok::RBracket {
                depth -= 1;
            } else if k == Tok::LBrace && depth == 0 {
                return true;
            } else if (k == Tok::DotDot || k == Tok::DotDotEq) && depth == 0 {
                return false;
            }
            j += 1;
        }
        true
    }
}

// Lexes the sections of std (its text at start..end in SRC) the program
// reaches, those not lexed yet (every one when `all`): at the first call,
// for the files read so far; again once the modules' files are read.
pub fn load_std_sections(start: i64, end: i64, all: bool) {
    unsafe {
        if SEC_COUNT < 0 {
            read_index();
        }
        STD_START = start;
        STD_END = end;
        let mut now = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for s in 0..SEC_COUNT {
            if SEC_CORE.data[s] != 0 || all {
                mark(s, &mut now);
            }
        }
        know_program();
        let mut changed = true;
        while changed {
            changed = false;
            for s in 0..SEC_COUNT {
                if SEC_LOADED.data[s] == 0 && reached(s) {
                    mark(s, &mut now);
                    changed = true;
                }
            }
        }
        // (in the text's order)
        for s in 0..SEC_COUNT {
            if (0..now.count).any(|k| now.data[k] == s) {
                lex_range(start + SEC_START.data[s], start + SEC_END.data[s], last: false);
            }
        }
    }
}
