// Modules (0.5): a file is a module. The files named on the command line
// make the root module (the crate); `mod name;` in a module's file loads
// name.tach (or name/mod.tach) as its child module `name`. The C headers
// of `import` make a module of their own.
//
// Every item has a key: its name qualified by its module's path
// (`util::Point`; an item of the root module is keyed by its bare name).
// The tables of declarations (types.tach) are indexed by keys. Code
// names an item through its module's scope: the module's own items, its
// child modules, what its `use` items import, and the prelude. (0.8: no
// `*` imports, which brought every item of a module, or every variant of
// an enum; they are still resolved, for --fix-imports and for the errors
// that replace them: see LEGACY_IMPORTS.)
//
// Items are private to their module (and its descendants) unless `pub`.
//
// Here: the table of modules, item keys, and loading the modules' files;
// in lookup.tach: scopes, `use` items, lookups and paths.

pub mod lookup;
mod stdsections;

use crate::arch::virtual::load_arch_modules;
use crate::base::{
    BUFS, FILES, FILE_COUNT, IntVec, SYMS, add_source, buf_byte, buf_bytes, buf_clear, buf_fmt,
    buf_new, buf_slice, buf_str, cstr, find_sym, grow, intern, intern_c, read_file, streq, strlen,
    sym_text,
};
use crate::base::diag::{
    err_begin, err_end_soft, err_fmt, err_help, err_help_fmt, err_try_tool, error_at_soft,
    fail_name,
};
use crate::front::ast::NODES;
use crate::front::cpp::directives::{file_exists, path_dir};
use crate::front::lexer::{TOKS, TOK_COUNT, Tok, lex_range};
use crate::front::modules::lookup::{PRELUDE_COUNT, is_prelude015, is_prelude_name, prelude_index};
use crate::front::modules::stdsections::load_std_sections;
use crate::front::stdsrc::std_source;
use crate::front::stdtree::{STD_TREE, add_std_tree};
use crate::middle::lower::ssa::HMap;
use crate::middle::profile::{PROFILE_GENERATE, PROFILE_MODULE, profile_runtime_source};
use crate::middle::trace::{TRACE, TRACE_MODULE, trace_runtime_source};
use crate::middle::unsafecheck::{CHECK_MODULE, CHECK_UNSAFE, check_runtime_source};
use crate::tools::query::command_line::QUERY;

// What other modules use of the parts.

// `key`: the module's path (`a::b`), `sym`: the same with dots (`a.b`),
// the prefix of its items' symbols in the assembly.
struct Module {
    name: i64, parent: i64, key: i64, sym: i64, public: bool, is_c: bool,
}

pub static var MODULES: *Module = 0 as *Module;
static var MODULE_COUNT: i64 = 0;
static var MODULE_CAP: i64 = 0;
// The module of the imported C declarations, and of the standard library
// (-1: none).
pub static var C_MODULE: i64 = -1;
pub static var STD_MODULE: i64 = -1;
// The module of the code being checked.
pub static var CUR_MOD: i64 = 0;

pub fn add_module(name: i64, parent: i64, public: bool) -> i64 {
    unsafe {
        MODULES = grow(MODULES, MODULE_COUNT, &MODULE_CAP);
        let m = MODULE_COUNT;
        var key = name;
        var sym = name;
        if parent > 0 {
            key = join_sym(MODULES[parent].key, c"::", name);
            sym = join_sym(MODULES[parent].sym, c".", name);
        }
        MODULES[m] = Module { name, parent, key, sym, public, is_c: false };
        MODULE_COUNT += 1;
        m
    }
}

pub fn init_modules() {
    if MODULE_COUNT == 0 {
        add_module(-1, -1, public: true);
    }
}

pub fn join_sym(a: i64, sep: *u8, b: i64) -> i64 {
    intern(joined(a, sep, b))
}

// The text of symbols a and b joined by sep, in a buffer reused by the
// next call.
static var JOIN_BUF: i64 = -1;

fn joined(a: i64, sep: *u8, b: i64) -> [u8] {
    unsafe {
        if JOIN_BUF < 0 {
            JOIN_BUF = buf_new();
        }
        buf_clear(JOIN_BUF);
        buf_bytes(JOIN_BUF, SYMS[a].text);
        buf_str(JOIN_BUF, sep);
        buf_bytes(JOIN_BUF, SYMS[b].text);
        buf_slice(JOIN_BUF)
    }
}

static var QUALIFIED: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

// The key of item `name` of module m.
pub fn qualify(m: i64, name: i64) -> i64 {
    if m <= 0 {
        return name;
    }
    let k = (name + 1) * 65536 + m;
    let known = QUALIFIED.get(k);
    if known != 0 {
        return known - 1;
    }
    let key = unsafe { join_sym(MODULES[m].key, c"::", name) };
    QUALIFIED.put(k, key + 1);
    key
}

// The key of item `name` of module m if it has been made (an item of that
// name exists there), else -1; makes no symbol.
fn qualified_if_known(m: i64, name: i64) -> i64 {
    if m <= 0 {
        return name;
    }
    let known = QUALIFIED.get((name + 1) * 65536 + m);
    if known != 0 {
        return known - 1;
    }
    unsafe { find_sym(joined(MODULES[m].key, c"::", name)) }
}

// The key of item `name` of module m, if it has one, else -1 (0.11:
// suggestions for unknown names).
pub fn item_key_if_known(m: i64, name: i64) -> i64 {
    qualified_if_known(m, name)
}

// The assembly symbol of item `name` of module m.
pub fn item_symbol(m: i64, name: i64) -> i64 {
    if m <= 0 { name } else { unsafe { join_sym(MODULES[m].sym, c".", name) } }
}

// The file holding position `pos`.
fn file_of(pos: i64) -> i64 {
    // (the files are in order of their start positions)
    var lo = 0;
    var hi = FILE_COUNT - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if unsafe { pos >= FILES[mid].start } {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    lo
}

pub fn module_of(n: i64) -> i64 {
    unsafe { module_at(NODES[n].start) }
}

// Inline modules (0.6): (start, end, module) for each `mod m { ... }`, the
// positions of its braces.
pub static var INLINE_MODS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The module of the code at position `pos`: the innermost inline module
// around it, else its file's. (0.22) By the index below: the entry with
// the last start at or before pos, else the nearest of its ancestors
// around pos (inline modules nest or are disjoint), in O(log n) rather
// than a scan of every inline module, std's included, for each token.
pub fn module_at(pos: i64) -> i64 {
    unsafe {
        if IM_INDEXED != INLINE_MODS.count {
            index_inline_mods();
        }
        var lo = 0;
        var hi = IM_ORDER.count;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if INLINE_MODS.data[3 * IM_ORDER.data[mid]] <= pos {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        var p = lo - 1;
        while p >= 0 {
            let e = 3 * IM_ORDER.data[p];
            if pos < INLINE_MODS.data[e + 1] {
                return INLINE_MODS.data[e + 2];
            }
            p = IM_PARENT.data[p];
        }
        FILES[file_of(pos)].module
    }
}

// (0.22) module_at's index of INLINE_MODS: the entries (their numbers) by
// start, each one's parent (the position in IM_ORDER of the innermost
// entry around it, or -1), and how many words of INLINE_MODS it covers
// (the table only grows: it is rebuilt when a module is added).
static var IM_ORDER: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var IM_PARENT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var IM_INDEXED: i64 = 0;

// (its scratch stack, kept between rebuilds)
static var IM_STACK: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn index_inline_mods() {
    unsafe {
        let n = INLINE_MODS.count / 3;
        IM_ORDER.count = 0;
        IM_PARENT.count = 0;
        for k in 0..n {
            IM_ORDER.push(k);
        }
        // by start (an insertion sort: stable, and the table is short and
        // already in order but for modules added out of it)
        for a in 1..n {
            var b = a;
            while b > 0
                && INLINE_MODS.data[3 * IM_ORDER.data[b - 1]]
                > INLINE_MODS.data[3 * IM_ORDER.data[b]] {
                let t = IM_ORDER.data[b - 1];
                IM_ORDER.data[b - 1] = IM_ORDER.data[b];
                IM_ORDER.data[b] = t;
                b -= 1;
            }
        }
        // parents: the open entries on a stack
        var stack = std::replace(&IM_STACK, IntVec { data: 0 as *i64, count: 0, cap: 0 });
        stack.count = 0;
        for p in 0..n {
            let start = INLINE_MODS.data[3 * IM_ORDER.data[p]];
            while stack.count > 0
                && INLINE_MODS.data[3 * IM_ORDER.data[stack.data[stack.count - 1]] + 1] <= start {
                stack.count -= 1;
            }
            IM_PARENT.push(if stack.count > 0 { stack.data[stack.count - 1] } else { -1 });
            stack.push(p);
        }
        IM_STACK = stack;
        IM_INDEXED = INLINE_MODS.count;
    }
}

pub fn module_count() -> i64 {
    MODULE_COUNT
}

pub fn child_module(m: i64, name: i64) -> i64 {
    for c in 1..MODULE_COUNT {
        if unsafe { MODULES[c].parent == m && MODULES[c].name == name } {
            return c;
        }
    }
    -1
}

// Whether module `inner` is `outer` or one of its descendants.
pub fn is_within(inner: i64, outer: i64) -> bool {
    var m = inner;
    while m >= 0 {
        if m == outer {
            return true;
        }
        unsafe { m = MODULES[m].parent; }
    }
    false
}

// (0.20) Whether module m is std or one of its modules (std is a tree:
// std::iter, std::collections::hash_map).
pub fn within_std(m: i64) -> bool {
    unsafe { STD_MODULE >= 0 && m >= 0 && is_within(m, STD_MODULE) }
}

// ---- Loading ----

// `mod name;` in the files read so far (and in the files they load): the
// child modules' files are read, lexed and appended. Done before parsing.
pub fn load_modules() {
    unsafe {
        init_modules();
        load_std_if_named();
        scan_modules(0);
        // (0.18: a test build's code, front/tests)
        crate::front::tests::add_test_code();
        // Named only in a module's file (fixed in 0.6: 0.5 looked at the files
        // of the command line alone; 0.20: then std's modules).
        let before = TOK_COUNT;
        load_std_if_named();
        scan_modules(before);
        // (0.19: std::arch's virtual modules, when the program names them)
        load_arch_modules();
        // (0.10: --check-unsafe's runtime)
        if CHECK_UNSAFE && CHECK_MODULE < 0 {
            let text = buf_new();
            check_runtime_source(text);
            let start = add_source(c"<check>", text);
            CHECK_MODULE = add_module(intern_c(c"__check"), 0, public: false);
            FILES[FILE_COUNT - 1].module = CHECK_MODULE;
            lex_range(start, FILES[FILE_COUNT - 1].end, last: false);
        }
        // (0.10: --profile-generate's runtime)
        if PROFILE_GENERATE != 0 as *u8 && PROFILE_MODULE < 0 {
            let text = buf_new();
            profile_runtime_source(text);
            let start = add_source(c"<profile>", text);
            PROFILE_MODULE = add_module(intern_c(c"__profile"), 0, public: false);
            FILES[FILE_COUNT - 1].module = PROFILE_MODULE;
            lex_range(start, FILES[FILE_COUNT - 1].end, last: false);
        }
        // (0.17: --trace's runtime)
        if TRACE && TRACE_MODULE < 0 {
            let text = buf_new();
            trace_runtime_source(text);
            let start = add_source(c"<trace>", text);
            TRACE_MODULE = add_module(intern_c(c"__trace"), 0, public: false);
            FILES[FILE_COUNT - 1].module = TRACE_MODULE;
            lex_range(start, FILES[FILE_COUNT - 1].end, last: false);
        }
    }
}

// One pass over the tokens from token i, in the order of the files (a
// module's file and its tokens are appended when it is loaded, so its own
// `mod` items come later in the pass).
fn scan_modules(from: i64) {
    unsafe {
        var i = from;
        while i + 2 < TOK_COUNT {
            if TOKS[i].kind == Tok::Mod && TOKS[i + 1].kind == Tok::Ident
                && TOKS[i + 2].kind == Tok::Semi {
                let f = file_of(TOKS[i].start);
                // (after an error, on with the next one: 0.10)
                if f == STD_FILE && STD_TREE == 0 as *u8 {
                    // (0.20) std's built-in text: its modules are there, as
                    // `mod name { }` after their parent's text (embed.sh)
                } else if module_at(TOKS[i].start) != FILES[f].module {
                    error_at_soft(TOKS[i].start, c"'mod name;' cannot be inside an inline module (a module's file is found from its file's module)");
                    fail_name(TOKS[i + 1].value as i64);
                } else {
                    load_module(f, i);
                }
            }
            if TOKS[i].kind == Tok::Mod && TOKS[i + 1].kind == Tok::Ident
                && TOKS[i + 2].kind == Tok::LBrace {
                add_inline_module(i);
            }
            i += 1;
        }
    }
}

// (0.15) The standard library whether the program names it or not:
// `tachyonc query` about std from a program that does not use it.
pub static var STD_ALWAYS: bool = false;

// (0.15) std's file, when it is loaded.
static var STD_FILE: i64 = -1;

// The standard library, when the program names it (`std::...`) or (0.6) a
// name of the prelude (0.14: or uses a range as a value; 0.15: or an
// f-string, `?` or `#[derive]`, or the query asks about std, STD_ALWAYS),
// once. (0.15) Only the sections of std the program reaches are lexed
// (stdsections); at the second call, once the modules' files are read,
// what they reach more.
fn load_std_if_named() {
    unsafe {
        if STD_MODULE >= 0 {
            if STD_TREE != 0 as *u8 {
                return;
            }
            let f = STD_FILE;
            load_std_sections(FILES[f].start, FILES[f].end, STD_ALWAYS || QUERY);
            return;
        }
        for i in 0..TOK_COUNT - 1 {
            if TOKS[i].kind == Tok::Ident
                && ((TOKS[i + 1].kind == Tok::ColonColon
                    && TOKS[i].value as i64 == intern_c(c"std"))
                    || is_prelude_name(TOKS[i].value as i64)
                    && (!is_prelude015(TOKS[i].value as i64) || uses_prelude015(i)))
                || (TOKS[i].kind == Tok::DotDot || TOKS[i].kind == Tok::DotDotEq)
                && range_as_value(i)
                || needs_std015(i) || STD_ALWAYS {
                // (0.17: from its files, every section; stdtree.tach)
                if STD_TREE != 0 as *u8 {
                    STD_MODULE = add_module(intern_c(c"std"), 0, public: true);
                    var start = 0;
                    var end = 0;
                    STD_FILE = add_std_tree(STD_MODULE, &start, &end);
                    lex_range(start, end, last: false);
                    return;
                }
                let text = buf_new();
                std_source(text);
                let start = add_source(c"<std>", text);
                STD_MODULE = add_module(intern_c(c"std"), 0, public: true);
                STD_FILE = FILE_COUNT - 1;
                FILES[STD_FILE].module = STD_MODULE;
                load_std_sections(start, FILES[STD_FILE].end, STD_ALWAYS || QUERY);
                return;
            }
        }
    }
}

// Whether token i is syntax of 0.15 that std's items implement: an
// f-string (std::Interp, Fmt), `?` (Option, Result, From) or the `derive`
// of `#[derive(...)]`.
fn needs_std015(i: i64) -> bool {
    unsafe {
        let k = TOKS[i].kind;
        k == Tok::FHead || k == Tok::Question
            || k == Tok::Ident && i >= 2 && TOKS[i - 1].kind == Tok::LBracket
            && TOKS[i - 2].kind == Tok::Hash && SYMS[TOKS[i].value as i64].text == "derive"
    }
}

// Whether identifier token i, a name the prelude gained in 0.15 or later,
// names std's item: not when it is declared (`let format`, `fn eprint`), a
// parameter, field or named argument (`format: *u8`), a member
// (`.format`), or a name the program declares itself (`fn eprint` at
// another token), so that programs of 0.14 using these names get no std.
fn uses_prelude015(i: i64) -> bool {
    unsafe {
        if i > 0 && (is_declaring(TOKS[i - 1].kind) || TOKS[i - 1].kind == Tok::Dot) {
            return false;
        }
        if TOKS[i + 1].kind == Tok::Colon {
            return false;
        }
        !declares_prelude_name(TOKS[i].value as i64)
    }
}

// Which of the prelude's names the program declares itself (`fn trim`,
// `let split`), over the tokens read so far (0.17: one pass, not one per
// use; more tokens come as the modules' files are read).
static var PRELUDE_DECLARED: [bool; PRELUDE_COUNT] = [false; PRELUDE_COUNT];

static var DECLARED_UPTO: i64 = 1;

fn declares_prelude_name(name: i64) -> bool {
    unsafe {
        while DECLARED_UPTO < TOK_COUNT {
            let j = DECLARED_UPTO;
            if TOKS[j].kind == Tok::Ident && is_declaring(TOKS[j - 1].kind) {
                let k = prelude_index(TOKS[j].value as i64);
                if k >= 0 {
                    PRELUDE_DECLARED[k] = true;
                }
            }
            DECLARED_UPTO += 1;
        }
        let k = prelude_index(name);
        k >= 0 && PRELUDE_DECLARED[k]
    }
}

// A token after which an identifier is declared.
fn is_declaring(k: Tok) -> bool {
    k == Tok::Fn || k == Tok::Struct || k == Tok::Enum || k == Tok::Trait || k == Tok::Type
        || k == Tok::Let || k == Tok::Mut || k == Tok::Const || k == Tok::Static || k == Tok::For
        || k == Tok::Mod || k == Tok::Union
}

// Whether the `..` or `..=` token at i makes a range used as a value
// (0.14: std's Range, so std is loaded), not the bounds of a `for` loop,
// a slicing or a pattern. Tokens only (it runs before parsing): after it,
// within its statement, no `=>` or `=` (a match arm's or an `if let`'s
// pattern); before it, no `for` loop's `in` and no `[` (a slicing), or
// the `in` of `for x in (a..b).m() {`.
pub fn range_as_value(i: i64) -> bool {
    unsafe {
        var depth = 0;
        var j = i + 1;
        while j < TOK_COUNT && j < i + 1000 {
            let k = TOKS[j].kind;
            if k == Tok::LParen || k == Tok::LBracket || k == Tok::LBrace && depth > 0 {
                depth += 1;
            } else if k == Tok::RParen || k == Tok::RBracket || k == Tok::RBrace {
                if depth == 0 && k == Tok::RBrace {
                    break;
                }
                // (an unmatched one: out of the group)
                if depth > 0 {
                    depth -= 1;
                }
            } else if depth == 0 && (k == Tok::FatArrow || k == Tok::Eq) {
                return false;
            } else if depth == 0 && (k == Tok::Semi || k == Tok::LBrace || k == Tok::Eof) {
                break;
            }
            j += 1;
        }
        depth = 0;
        j = i - 1;
        while j >= 0 && j > i - 1000 {
            let k = TOKS[j].kind;
            if depth == 0 && (k == Tok::Semi || k == Tok::RBrace) {
                // (the statement before ends)
                return true;
            } else if k == Tok::RParen || k == Tok::RBracket || k == Tok::RBrace {
                depth += 1;
            } else if k == Tok::LParen || k == Tok::LBracket || k == Tok::LBrace {
                if depth > 0 {
                    depth -= 1;
                } else if k == Tok::LParen {
                    // `for x in (a..b) {`, or a value: `f(a..b)`, `for x in
                    // (a..b).rev() {`
                    return j == 0 || TOKS[j - 1].kind != Tok::In || !closes_before_brace(j);
                } else {
                    return k == Tok::LBrace;
                }
            } else if depth == 0 && k == Tok::In {
                return false;
            }
            j -= 1;
        }
        true
    }
}

// Whether the `(` at j is closed by a `)` right before a `{`.
fn closes_before_brace(j: i64) -> bool {
    unsafe {
        var depth = 0;
        var k = j;
        while k < TOK_COUNT - 1 {
            let kind = TOKS[k].kind;
            if kind == Tok::LParen || kind == Tok::LBracket || kind == Tok::LBrace {
                depth += 1;
            } else if kind == Tok::RParen || kind == Tok::RBracket || kind == Tok::RBrace {
                depth -= 1;
                if depth == 0 {
                    return TOKS[k + 1].kind == Tok::LBrace;
                }
            }
            k += 1;
        }
        false
    }
}

// `mod name { ... }` at token i (0.6): a child module of the module around
// it, holding the code between the braces.
fn add_inline_module(i: i64) {
    unsafe {
        let parent = module_at(TOKS[i].start);
        let name = TOKS[i + 1].value as i64;
        if child_module(parent, name) >= 0 {
            err_begin(TOKS[i + 1].start);
            err_fmt(f"module '{sym_text(name)}' is declared twice");
            err_end_soft();
        }
        let public = i > 0 && TOKS[i - 1].kind == Tok::Pub;
        // The matching closing brace.
        var depth = 0;
        var j = i + 2;
        while j < TOK_COUNT {
            if TOKS[j].kind == Tok::LBrace {
                depth += 1;
            } else if TOKS[j].kind == Tok::RBrace {
                depth -= 1;
                if depth == 0 {
                    break;
                }
            }
            j += 1;
        }
        let m = add_module(name, parent, public);
        INLINE_MODS.push(TOKS[i + 2].start);
        INLINE_MODS.push(if j < TOK_COUNT { TOKS[j].start + 1 }
            else { TOKS[TOK_COUNT - 1].start + 1 });
        INLINE_MODS.push(m);
    }
}

fn load_module(f: i64, i: i64) {
    unsafe {
        let parent = FILES[f].module;
        let name = TOKS[i + 1].value as i64;
        if child_module(parent, name) >= 0 {
            err_begin(TOKS[i + 1].start);
            err_fmt(f"module '{sym_text(name)}' is declared twice");
            err_end_soft();
            return;
        }
        let public = i > 0 && TOKS[i - 1].kind == Tok::Pub;
        let path = module_file(f, name);
        if path == 0 as *u8 {
            err_begin(TOKS[i + 1].start);
            err_fmt(f"cannot find the file of module '{sym_text(name)}'");
            missing_module_help(f, name);
            err_end_soft();
            // (what it would have declared is unknown: no errors for it)
            fail_name(name);
            return;
        }
        if MODULE_CONFLICT != 0 as *u8 {
            // (0.21) `x.tach` and `x.vl` both: which one is the module
            err_begin(TOKS[i + 1].start);
            err_fmt(
                f"module '{sym_text(name)}' has two files, {cstr(path)} and {cstr(MODULE_CONFLICT)}");
            err_help(c"a module is one file: delete or rename one of them (`.vl` is the extension from 0.24)");
            err_end_soft();
        }
        let m = add_module(name, parent, public);
        let text = buf_new();
        read_file(path, text);
        let start = add_source(path, text);
        FILES[FILE_COUNT - 1].module = m;
        lex_range(start, FILES[FILE_COUNT - 1].end, last: false);
    }
}

// (0.17) The help of `mod name;` in file f without its file: when f is
// not the root and the file is next to f, it is the root's module (the
// `mod` line goes there, f imports it through `crate::`); else where the
// compiler looked, and the command that makes the file.
fn missing_module_help(f: i64, name: i64) {
    unsafe {
        // (0.21: the file f's own extension, `.tach` or `.vl`)
        let ext = if crate::base::source_ext_len(FILES[f].path[0..strlen(FILES[f].path) as i64])
            == 3 {
            c".vl"
        } else {
            c".tach"
        };
        let flat = module_candidate(f, name, nested: false, ext: ext);
        let shown = if flat[0] == '.' && flat[1] == '/' { &flat[2] } else { flat };
        if FILES[f].module > 0 && FILES[f].module != STD_MODULE
            && !is_mod_file(path_base(FILES[f].path)) {
            let side = buf_new();
            buf_fmt(side, f"{cstr(path_dir(FILES[f].path))}/{sym_text(name)}{cstr(ext)}");
            buf_byte(side, 0);
            let sp = BUFS[side].data;
            if file_exists(sp) {
                var r = 0;
                while r < FILE_COUNT && FILES[r].path[0] == '<' {
                    r += 1;
                }
                let root = if r < FILE_COUNT { FILES[r].path } else { c"main.tach" };
                err_help_fmt(
                    f"{cstr(if sp[0] == '.' && sp[1] == '/' { &sp[2] } else { sp })} is a module of the root: its `mod {sym_text(name)};` goes in {cstr(path_base(root))}, and this file imports it as `use crate::{sym_text(name)}::...;`");
                return;
            }
        }
        err_help(c"looked for ");
        err_help(shown);
        err_help(c" and ");
        let nested = module_candidate(f, name, nested: true, ext: ext);
        err_help(if nested[0] == '.' && nested[1] == '/' { &nested[2] } else { nested });
        err_help(c": write the file (`edit new-file` takes its text on stdin)");
        let args = buf_new();
        buf_fmt(args, f"edit new-file {cstr(shown)}");
        err_try_tool(buf_slice(args), true);
    }
}

// Where `mod name;` in file f looks: next to the file for a root file, one
// of std's root files (0.20: std is a crate of its own; compiler/std/NAME.tach
// is std::NAME) or a `mod.tach`, else in the directory named after the file
// (`a.tach`: `a/`); as `name.tach`, or `name/mod.tach` when `nested`.
// (0.21) ext is the extension, `.tach` or `.vl`: `a.vl`, `mod.vl` likewise.
fn module_candidate(f: i64, name: i64, nested: bool, ext: *u8) -> *u8 {
    unsafe {
        let path = FILES[f].path;
        let out = buf_new();
        buf_fmt(out, f"{cstr(path_dir(path))}/");
        let base = path_base(path);
        if FILES[f].module > 0 && FILES[f].module != STD_MODULE && !is_mod_file(base) {
            let n = strlen(base) as i64;
            let stem = n - crate::base::source_ext_len(base[0..n]);
            buf_fmt(out, f"{base[0..stem]}/");
        }
        buf_bytes(out, SYMS[name].text);
        buf_str(out, if nested { c"/mod" } else { c"" });
        buf_str(out, ext);
        buf_byte(out, 0);
        BUFS[out].data
    }
}

// (0.21) Whether a file's base name is a module's folder file, `mod.tach`
// or `mod.vl`.
fn is_mod_file(base: *u8) -> bool {
    streq(base, c"mod.tach") || streq(base, c"mod.vl")
}

// The files looked for and not found (the tools' cache, 0.13: the program
// is another once one of them exists).
pub static var MODULE_PROBES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The file of `mod name;` in file f (module_candidate), `.tach` or (0.21)
// `.vl`; 0 when there is none. Both of one candidate: MODULE_CONFLICT is
// the `.vl` one, which load_module reports, and the `.tach` one is read.
fn module_file(f: i64, name: i64) -> *u8 {
    unsafe {
        MODULE_CONFLICT = 0 as *u8;
        for k in 0..2 {
            let nested = k == 1;
            let tach = module_candidate(f, name, nested, c".tach");
            let vl = module_candidate(f, name, nested, c".vl");
            let has_tach = file_exists(tach);
            let has_vl = file_exists(vl);
            if has_tach && has_vl {
                MODULE_CONFLICT = vl;
            }
            // (the other extension, absent: a cached answer is stale once
            // it appears, MODULE_PROBES)
            if has_tach && !has_vl {
                MODULE_PROBES.push(vl as i64);
            }
            if has_vl && !has_tach {
                MODULE_PROBES.push(tach as i64);
            }
            if has_tach {
                return tach;
            }
            if has_vl {
                return vl;
            }
            MODULE_PROBES.push(tach as i64);
            MODULE_PROBES.push(vl as i64);
        }
        0 as *u8
    }
}

// (0.21) Set by module_file: the second file of a module that has both a
// `.tach` and a `.vl` file.
static var MODULE_CONFLICT: *u8 = 0 as *u8;

fn path_base(path: *u8) -> *u8 {
    unsafe {
        let n = strlen(path) as i64;
        var i = n - 1;
        while i >= 0 && path[i] != '/' {
            i -= 1;
        }
        &path[i + 1]
    }
}

pub fn file_of_pos(pos: i64) -> i64 {
    file_of(pos)
}
