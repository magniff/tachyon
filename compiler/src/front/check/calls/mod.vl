// Calls: direct calls and calls through a function value, their arguments
// against the parameters (generic functions instantiated), paths
// (`m::f`, `T::f`, `Enum::Variant`) and the calls through them, and
// method calls (`x.m()`, with `&x` or `*x` as its `self` needs).

pub mod paths;

use crate::base::{
    BUFS, SRC, SYMS, buf_byte, buf_bytes, buf_fmt, buf_new, buf_slice, buf_str, intern, intern_c,
    sym_text,
};
use crate::base::diag::{
    ERR_HELP, err_begin, err_end, err_failed_name, err_fix, err_help, err_help_fmt, err_help_sym,
    err_int, err_str, err_sym, err_try_fmt, err_try_tool,
};
use crate::front::ambient::has_local_gpa;
use crate::front::assoc::ensure_checked;
use crate::front::ast::{
    NODES, NODE_CHECKED, NodeKind, child, list_begin, list_end, list_push, new_node,
};
use crate::front::ast::NodeKind::{Call, Ident, Index, Range, Unary};
use crate::front::check::{LOCALS, Res, SELF_SYM, is_std_named, name_error};
use crate::front::check::args::{arity_help, int_limit_help, normalize_args};
use crate::front::check::assign::is_place;
use crate::front::check::collect::{GMETHODS, GMETHOD_COUNT, find_generic_method};
use crate::front::check::distinct::{distinct_method_error, is_utf8_text, null_test};
use crate::front::check::interp::{direct_call, direct_kind};
use crate::front::check::names::{NEAR_ALL, NEAR_COLLECT, Near, help_nearest, near_to, std_has};
use crate::front::check::synth_mode::synth_expr;
use crate::front::check::unsafety::{U_METHOD, check_call_safety, is_borrow, unsafe_through};
use crate::front::check::vectors::{sym_is_c, vector_method};
use crate::front::convert::generic_trait_call;
use crate::front::derive::intrinsic::{has_intrinsic_method, intrinsic_method};
use crate::front::distinct::{PATH_TYPE, STR_TYPE};
use crate::front::generics::{TPL_DISTINCT, TPL_SLICE, check_arg, template_name};
use crate::front::generics::instantiate::instantiate_call;
use crate::front::lexer::{SUF_I64, Tok};
use crate::front::modules::{CUR_MOD, STD_MODULE, within_std};
use crate::front::modules::lookup::is_prelude_name;
use crate::front::own::kinds::has_drop_impl;
use crate::front::traits::require_in_bounds;
use crate::front::types::{
    ENUMS, FNS, METHODS, METHOD_COUNT, STRUCTS, TYPES, TY_I64, TY_U8, TY_UNIT, TyKind, VARIANTS,
    buf_type, decay_ref, enum_variant, err_type, find_field, find_method, fn_param, is_compound,
    is_mut_slice, is_pointer, is_ref, is_vector, ptr_to, slice_of,
};

// ---- Paths, variants and methods ----

// The method or associated function `name` of type t: of its impl
// blocks, or a template of the generic impl blocks of its template.
pub fn method_of(t: i64, name: i64) -> i64 {
    unsafe {
        let f = find_method(t, name);
        if f >= 0 {
            return f;
        }
        let kind = TYPES[t].kind;
        if kind == TyKind::Struct && STRUCTS[TYPES[t].a].tmpl != 0 {
            return find_generic_method(STRUCTS[TYPES[t].a].tmpl, name);
        }
        if kind == TyKind::Enum && ENUMS[TYPES[t].a].tmpl != 0 {
            return find_generic_method(-ENUMS[TYPES[t].a].tmpl, name);
        }
        // (0.18: `impl<T> NonNull<T>`)
        if kind == TyKind::Distinct && TYPES[t].count > 0 {
            return find_generic_method(TPL_DISTINCT + TYPES[t].b, name);
        }
        // (0.14: `impl<T> [T]`)
        if kind == TyKind::Slice {
            return find_generic_method(TPL_SLICE, name);
        }
        -1
    }
}

// Offers near the names of type t's methods (with `self`; with
// associated functions too unless methods_only), of its impl blocks and of
// its template's (0.14: an unknown method's `did you mean`).
pub fn offer_methods(near: inout Near, t: i64, methods_only: bool) {
    unsafe {
        for i in 0..METHOD_COUNT {
            if METHODS[i].ty == t && (!methods_only || is_method(METHODS[i].f)) {
                near.offer(METHODS[i].name);
            }
        }
        let kind = TYPES[t].kind;
        var tpl = 0;
        if kind == TyKind::Struct && STRUCTS[TYPES[t].a].tmpl != 0 {
            tpl = STRUCTS[TYPES[t].a].tmpl;
        } else if kind == TyKind::Enum && ENUMS[TYPES[t].a].tmpl != 0 {
            tpl = -ENUMS[TYPES[t].a].tmpl;
        }
        if tpl != 0 {
            offer_template_methods(&near, tpl, methods_only);
        }
    }
}

// The same for the methods of template tpl (as find_generic_method).
pub fn offer_template_methods(near: inout Near, tpl: i64, methods_only: bool) {
    unsafe {
        for i in 0..GMETHOD_COUNT {
            if GMETHODS[i].ty == tpl && (!methods_only || is_method(GMETHODS[i].f)) {
                near.offer(GMETHODS[i].name);
            }
        }
    }
}

// The help of an unknown method a Rust programmer calls on a slice, an
// array or a Vec (0.14): what vole writes instead.
fn rust_method_help(t: i64, name: i64) {
    unsafe {
        let text = SYMS[name].text;
        let kind = TYPES[t].kind;
        let seq = kind == TyKind::Slice || kind == TyKind::Array;
        // (0.20) a method of `str` on bytes
        if kind == TyKind::Slice && TYPES[t].a == TY_U8 && STR_TYPE > 0
            && method_of(STR_TYPE, name) >= 0 {
            err_help(c"`[u8]` is bytes; text is `str` (UTF-8), which has it: a literal is a `str` where one goes (`let s: str = \"..\";`, `fn f(s: str)`); bytes become one by `str::from_utf8(b)?`");
            return;
        }
        // (0.14 has `iter`: only the names it lacks)
        let iter = text == "into_iter" || text == "chars" || text == "bytes";
        if seq && text == "len" {
            err_help(if kind == TyKind::Slice { c"`len` is a field of slices: `s.len`" }
                else { c"an array's length is its slice's field: `a[..].len`" });
        } else if (seq || is_std_vec(t)) && text == "iter_mut" {
            err_help(c"no `iter_mut`: change elements by index, `s[i] = x` (a Vec: `v.set(i, x)`)");
        } else if seq && iter {
            err_help(c"`s.iter()`, or `for x in s`, goes over a slice's elements (a [u8]'s bytes)");
        } else if seq && (text == "to_string" || text == "to_owned" || text == "to_vec"
            || text == "clone" || text == "as_str" || text == "as_bytes") {
            err_help(c"a string is a `[u8]` already; to copy it, push it into a `std::Buf` (`b.push_str(s)`)");
        } else if text == "is_empty" && (seq || is_std_vec(t) || is_std_named(t, c"Buf")) {
            err_help(if kind == TyKind::Slice { c"no `is_empty`: `s.len == 0`" }
                else { c"no `is_empty`: `x.len() == 0`" });
        } else if iter && is_std_vec(t) {
            err_help(c"`v.iter()`, or `for x in v`, goes over a Vec's elements");
        }
    }
}

// (0.17) The help of an unknown method that is a function of std
// (`s.trim()`: `std::trim(s)`; Rust's names for a few: `parse`,
// `is_ascii_digit`, `sort_unstable`): the call to write, as the try: line
// (with `gpa` for an allocating `_in` form).
fn std_function_help(n: i64, t: i64, name: i64) {
    unsafe {
        let text = SYMS[name].text;
        let mapped: [u8] = if text == "parse" { "parse_int" }
            else if text == "is_ascii_digit" { "is_digit" }
            else if text == "is_ascii_whitespace" || text == "is_whitespace" { "is_space" }
            else if text == "sort_unstable" { "sort" }
            else if text == "sort_unstable_by" { "sort_by" }
            else if text == "split_ascii_whitespace" { "split_whitespace" }
            else { text };
        var f = intern(mapped);
        let with_in = buf_new();
        buf_bytes(with_in, mapped);
        buf_str(with_in, c"_in");
        let fin = intern(buf_slice(with_in));
        let gpa = std_has(fin, true);
        if gpa {
            f = fin;
        } else if !std_has(f, true) {
            return;
        }
        if BUFS[ERR_HELP].len == 0 {
            err_help_fmt(
                f"'{text}' is no method: std's function `{sym_text(f)}` takes the value as its first argument");
        }
        let recv = NODES[n].a;
        if recv == 0 || NODES[recv].end <= NODES[recv].start {
            return;
        }
        let c = buf_new();
        // (0.17: a name of the prelude needs no `std::`)
        if !is_prelude_name(f) {
            buf_str(c, c"std::");
        }
        buf_fmt(c, f"{sym_text(f)}(");
        buf_bytes(c, SRC[NODES[recv].start..NODES[recv].end]);
        if is_std_vec(t) {
            buf_str(c, c".as_slice()");
        }
        for i in 0..NODES[n].count {
            let a = child(n, i);
            buf_str(c, c", ");
            buf_bytes(c, SRC[NODES[a].start..NODES[a].end]);
        }
        if gpa {
            buf_str(c, c", gpa");
        }
        buf_byte(c, ')');
        err_try_fmt(buf_slice(c));
        // (0.18) the fix, when the allocator it passes is this function's
        if !gpa || has_local_gpa() {
            err_fix(NODES[n].start, NODES[n].end, buf_slice(c));
        }
    }
}

// (0.17) The try: line that lists the methods of type t (a struct's or an
// enum's, std's or the program's): `volec query items TYPE ROOT`.
fn type_items_try(t: i64) {
    unsafe {
        let kind = TYPES[t].kind;
        if kind != TyKind::Struct && kind != TyKind::Enum {
            return;
        }
        let b = buf_new();
        buf_type(b, t);
        let s = buf_slice(b);
        var e = 0;
        while e < s.len && s[e] != '<' {
            e += 1;
        }
        let a = buf_new();
        buf_str(a, c"query items ");
        buf_bytes(a, s[0..e]);
        err_try_tool(buf_slice(a), true);
    }
}

// Whether t is a `Vec<T>` (std's), or a pointer to one.
pub fn is_std_vec(t: i64) -> bool {
    unsafe {
        var s = t;
        if TYPES[s].kind == TyKind::Ptr {
            s = TYPES[s].a;
        }
        TYPES[s].kind == TyKind::Struct && STRUCTS[TYPES[s].a].tmpl != 0
            && SYMS[template_name(STRUCTS[TYPES[s].a].tmpl)].text == "Vec"
    }
}

// `T::m` where type t has no `m` (0.17: when nothing is near, the nearest
// of its variants and functions, and the command that lists them).
fn path_member_error(n: i64, t: i64, member: i64) -> ! {
    unsafe {
        err_begin(NODES[n].start);
        if TYPES[t].kind == TyKind::Enum {
            err_str(c"no variant or associated function '");
        } else {
            err_str(c"no associated function '");
        }
        err_sym(member);
        err_failed_name(member);
        err_str(c"' in '");
        err_type(t);
        err_str(c"'");
        NEAR_ALL.count = 0;
        NEAR_COLLECT = true;
        var near = near_to(member);
        if TYPES[t].kind == TyKind::Enum {
            let e = TYPES[t].a;
            for i in 0..ENUMS[e].variant_count {
                near.offer(VARIANTS[enum_variant(e, i)].name);
            }
        }
        offer_methods(&near, t, false);
        NEAR_COLLECT = false;
        // (0.15: `i64::MAX()`, a constant)
        int_limit_help(t, member);
        near.help();
        if BUFS[ERR_HELP].len == 0 && NEAR_ALL.count > 0 {
            help_nearest(if TYPES[t].kind
                == TyKind::Enum { c"its nearest variants and functions: " }
                else { c"its nearest functions: " }, member);
        }
        type_items_try(t);
        err_end()
    }
}

// Whether function f is a method: its first parameter is named `self`.
fn is_method(f: i64) -> bool {
    unsafe {
        let item = FNS[f].node;
        NODES[item].count > 0 && NODES[child(item, 0)].a == SELF_SYM
    }
}

// (0.17) Method call n (of method f0 on type t) when it is std's
// `Buf::push_str(f"...")` outside std: Buf::push_fmt, which n then calls
// (an f-string is no `[u8]`; push_fmt writes it into the Buf without
// making the text apart); else -1.
fn push_str_interp(n: i64, f0: i64, t: i64) -> i64 {
    unsafe {
        if f0 < 0 || STD_MODULE < 0 || !within_std(FNS[f0].module) || within_std(CUR_MOD)
            || NODES[n].count != 1 || NODES[child(n, 0)].kind != NodeKind::Interp
            || SYMS[NODES[FNS[f0].node].a].text != "push_str" {
            return -1;
        }
        let push_fmt = intern_c(c"push_fmt");
        let f = method_of(t, push_fmt);
        if f >= 0 {
            NODES[n].b = push_fmt;
        }
        f
    }
}

// A new node for the checker: `op operand` (`&` or `*`) of type `ty`.
pub fn synthetic_unary(op: Tok, operand: i64, ty: i64) -> i64 {
    unsafe {
        let u = new_node(Unary, NODES[operand].start, NODES[operand].end);
        NODES[u].op = op;
        NODES[u].b = operand;
        NODES[u].ty = ty;
        // (0.17: the own pass's record, front/own/fast.vl)
        crate::front::own::fast::note_synthetic(u);
        u
    }
}

// (0.16) A new node for the checker: `place[..]`, the whole of an array
// place as a slice of type `ty`, as `a[..]` is checked.
pub fn whole_slice(place: i64, ty: i64) -> i64 {
    unsafe {
        let r = new_node(Range, NODES[place].start, NODES[place].end);
        NODES[r].ty = TY_UNIT;
        let s = new_node(Index, NODES[place].start, NODES[place].end);
        NODES[s].a = place;
        NODES[s].b = r;
        NODES[s].ty = ty;
        s
    }
}

// `x.m(args)`: a call of method m of x's type (or of the type x points
// to), with `&x` or `*x` as needed for its `self`; becomes an NodeKind::Call.
pub fn synth_method(n: i64) -> i64 {
    unsafe {
        var receiver = NODES[n].a;
        let name = NODES[n].b;
        var receiver_ty = synth_expr(receiver);
        // (0.20) a string literal has `str`'s methods, as Rust's `&str`:
        // `"a,b".split(',')`, `" 7 ".trim()`
        if NODES[receiver].kind == NodeKind::Str && STR_TYPE > 0 && method_of(STR_TYPE, name) >= 0
            && is_utf8_text(crate::front::lexer::str_at(NODES[receiver].a)) {
            receiver_ty = STR_TYPE;
            NODES[receiver].ty = STR_TYPE;
        }
        // (0.18.1) `tr.cell(i)` of a `tr: &&Table`, `s.len()` of an `s:
        // &[u8]`: read through to the reference (the slice) that has the
        // methods, as Rust does
        while is_ref(receiver_ty) && (is_ref(TYPES[receiver_ty].a)
            || TYPES[TYPES[receiver_ty].a].kind == TyKind::Slice) {
            receiver_ty = TYPES[receiver_ty].a;
            receiver = synthetic_unary(Tok::Star, receiver, receiver_ty);
            NODES[n].a = receiver;
        }
        // (0.17: a `&mut [T]` has `[T]`'s methods)
        if is_mut_slice(receiver_ty) {
            receiver_ty = decay_ref(receiver_ty);
        }
        // (0.16: an array place has its slice's methods: `a.iter()` is
        // `a[..].iter()`)
        if TYPES[receiver_ty].kind == TyKind::Array && method_of(receiver_ty, name) < 0
            && is_place(receiver) {
            let s = slice_of(TYPES[receiver_ty].a);
            if method_of(s, name) >= 0 {
                receiver = whole_slice(receiver, s);
                NODES[n].a = receiver;
                receiver_ty = s;
            }
        }
        if NODES[n].count == 0 && NODES[n].g == 0 && sym_is_c(name, c"len")
            && (TYPES[receiver_ty].kind == TyKind::Slice
                || TYPES[receiver_ty].kind == TyKind::Array && is_plain_place(receiver))
            && method_of(receiver_ty, name) < 0 {
            return len_method(n, receiver, receiver_ty);
        }
        if is_vector(receiver_ty) {
            return vector_method(n, name, receiver_ty);
        }
        // (0.18: `p.is_null()` of a raw pointer)
        if is_pointer(receiver_ty) && NODES[n].count == 0 && sym_is_c(name, c"is_null")
            && method_of(TYPES[receiver_ty].a, name) < 0 {
            return null_test(n);
        }
        var t = receiver_ty;
        var through_pointer = false;
        if is_pointer(t)
            && (TYPES[TYPES[t].a].kind == TyKind::Struct || TYPES[TYPES[t].a].kind == TyKind::Enum
                || (method_of(t, name) < 0 && (method_of(TYPES[t].a, name) >= 0
                    || has_intrinsic_method(TYPES[t].a, name)))) {
            t = TYPES[t].a;
            through_pointer = true;
        }
        // (0.9: a value of a bounded parameter's type has its bounds' methods)
        // (0.17: not a drop's glue, `x.drop()` of an instance whose T has
        // `impl Drop`, front/own/glue.vl)
        if NODES[receiver].kind == Ident && NODES[receiver].res == Res::Local
            && NODES[receiver].y >= 0
            && LOCALS[NODES[receiver].y].tparam != 0
            && !(name == intern_c(c"drop") && has_drop_impl(t)) {
            require_in_bounds(LOCALS[NODES[receiver].y].tparam, name, NODES[n].start);
        }
        var f0 = method_of(t, name);
        // (0.20) a String has its `str`'s methods (Rust's Deref): `s.trim()`
        // is `s.as_str().trim()`; a PathBuf its Path's (`p.as_path()`)
        let string = TYPES[t].kind == TyKind::Struct && is_std_named(t, c"String");
        let path_buf = TYPES[t].kind == TyKind::Struct && is_std_named(t, c"PathBuf");
        if f0 < 0 && (string || path_buf) {
            let view = if string { STR_TYPE } else { PATH_TYPE };
            if view > 0 && method_of(view, name) >= 0 {
                NODES[receiver].p |= NODE_CHECKED;
                let call = new_node(NodeKind::MethodCall, NODES[receiver].start,
                    NODES[receiver].end);
                NODES[call].a = receiver;
                NODES[call].b = intern_c(if string { c"as_str" } else { c"as_path" });
                let mark = list_begin();
                list_end(call, mark);
                NODES[n].a = call;
                receiver = call;
                receiver_ty = synth_expr(call);
                t = receiver_ty;
                through_pointer = false;
                f0 = method_of(t, name);
            }
        }
        // (0.17) `b.push_str(f"..")`: Buf::push_fmt's, the f-string written
        // straight into the Buf
        let pf = push_str_interp(n, f0, t);
        if pf >= 0 {
            f0 = pf;
        }
        var f = -1;
        if TYPES[t].kind == TyKind::Struct || TYPES[t].kind == TyKind::Enum || f0 >= 0 {
            f = f0;
        }
        // (0.15: `x.clone()`, `x.cmp(&y)`, `x.hash()` of a type that has
        // Clone, Ord or Hash without an impl: a copy, a float, a tuple...)
        if f < 0 {
            f = intrinsic_method(n, t, name);
        }
        if f < 0 {
            // (0.15: `x.into()`, `x.from(..)`: a function of a generic trait's impl)
            let r = generic_trait_call(n, t, name);
            if r >= 0 {
                return r;
            }
        }
        if f < 0 {
            // (0.18: a method of a distinct type's underlying type)
            distinct_method_error(n, receiver, t, name);
            err_begin(NODES[n].start);
            err_str(c"no method '");
            err_sym(name);
            err_failed_name(name);
            err_str(c"' on type '");
            err_type(receiver_ty);
            err_str(c"'");
            if TYPES[t].kind == TyKind::Struct && find_field(TYPES[t].a, name) >= 0 {
                err_help(c"to call a function stored in a field, write (s.f)(x)");
            }
            if TYPES[t].kind == TyKind::Array && method_of(slice_of(TYPES[t].a), name) >= 0 {
                err_help(c"an array has its slice's methods where it is a place: bind it to a variable first");
            }
            rust_method_help(t, name);
            std_function_help(n, t, name);
            NEAR_ALL.count = 0;
            NEAR_COLLECT = true;
            var near = near_to(name);
            offer_methods(&near, t, true);
            NEAR_COLLECT = false;
            near.help();
            if BUFS[ERR_HELP].len == 0 && NEAR_ALL.count > 0 {
                help_nearest(c"no method of that name; the nearest: ", name);
            }
            type_items_try(t);
            err_end();
        }
        if !is_method(f) {
            err_begin(NODES[n].start);
            err_str(c"'");
            err_type(t);
            err_str(c"::");
            err_sym(name);
            err_str(c"' is an associated function, not a method (it has no 'self' parameter)");
            err_help(c"call it as '");
            buf_type(ERR_HELP, t);
            err_help(c"::");
            err_help_sym(name);
            err_help(c"(...)'");
            err_end();
        }
        // (0.15: named arguments, defaults)
        normalize_args(n, f, 1);
        // (0.17: `b.push_fmt(f"..")`: the f-string written in place, the
        // receiver as push_fmt's `self: *Buf<A>` takes it)
        let direct = direct_kind(n, f, true);
        if direct != 0 && NODES[n].g == 0 {
            if through_pointer && !is_borrow(receiver) {
                unsafe_through(n, receiver, U_METHOD,
                    c"calling a method through a raw pointer is unsafe");
            }
            let arg = if through_pointer { receiver }
                else { synthetic_unary(Tok::Amp, receiver, ptr_to(t)) };
            return direct_call(n, f, direct, arg);
        }
        if FNS[f].generic > 0 {
            // A method template: its impl's parameters from the receiver's
            // type, its own from the arguments.
            // (0.24: a closure given a borrowing iterator's copied items
            // borrows them, own::drops::ITEM_BORROW)
            let w = SYMS[name].text;
            let item_at = if !crate::front::own::moves::copies_owned_items(t, 0) { -1 }
                else if w == "map" || w == "for_each" || w == "filter_map" { 0 }
                else if w == "fold" { 1 } else { -1 };
            crate::front::own::drops::ITEM_BORROW = item_at;
            f = instantiate_call(f, n, 1, t, NODES[n].g);
            crate::front::own::drops::ITEM_BORROW = -1;
        } else if NODES[n].g != 0 {
            name_error(NODES[n].start, c"method '", name, c"' is not generic");
        }
        let self_ty = fn_param(f, 0);
        var arg = receiver;
        // (0.18.1: a raw `self: *T` takes the pointer as it is: safe)
        if through_pointer && !is_borrow(receiver)
            && !(TYPES[self_ty].kind == TyKind::Ptr && TYPES[self_ty].b == 0) {
            unsafe_through(n, receiver, U_METHOD,
                c"calling a method through a raw pointer is unsafe");
        }
        if self_ty == t {
            if through_pointer {
                arg = synthetic_unary(Tok::Star, receiver, t);
            }
        } else if TYPES[self_ty].kind == TyKind::Ptr && TYPES[self_ty].a == t {
            // (`self: *T`, `self: &T`, `self: &mut T`)
            if !through_pointer {
                if !is_place(receiver) && !is_compound(t) {
                    err_begin(NODES[n].start);
                    err_str(c"method '");
                    err_sym(name);
                    err_str(c"' takes 'self: *");
                    err_type(t);
                    err_str(c"', but the receiver is a temporary value");
                    err_help(c"bind it to a variable first");
                    err_end();
                }
                arg = synthetic_unary(Tok::Amp, receiver, self_ty);
            }
        } else if TYPES[self_ty].kind == TyKind::Slice && TYPES[t].kind == TyKind::Slice
            && TYPES[self_ty].a == TYPES[t].a {
            // (0.17) `self: &mut [T]` on a slice, `self: [T]` on a `&mut
            // [T]`: a slice is its own view
        } else {
            err_begin(NODES[n].start);
            err_str(c"method '");
            err_sym(name);
            err_str(c"' has 'self' of type '");
            err_type(self_ty);
            err_str(c"'; a method's receiver is 'self', 'inout self', 'sink self' or 'self: *");
            err_type(t);
            err_str(c"'");
            err_end();
        }
        let count = NODES[n].count;
        if count + 1 != FNS[f].param_count {
            err_begin(NODES[n].start);
            err_str(c"method '");
            err_sym(name);
            err_str(c"' expects ");
            err_int(FNS[f].param_count - 1);
            err_str(c" arguments, got ");
            err_int(count);
            arity_help(n, f, count, FNS[f].param_count - 1);
            err_end();
        }
        let mark = list_begin();
        list_push(arg);
        for i in 0..count {
            let a = child(n, i);
            check_arg(a, fn_param(f, i + 1));
            list_push(a);
        }
        list_end(n, mark);
        NODES[n].kind = Call;
        NODES[n].a = 0;
        NODES[n].x = f + 1;
        ensure_checked(f, n);
        check_call_safety(n, f, 1);
        FNS[f].ret
    }
}

// (0.17) `s.len()` on a slice is its field `s.len`; on an array, its
// length (an i64), as Rust writes both.
fn len_method(n: i64, receiver: i64, ty: i64) -> i64 {
    unsafe {
        if TYPES[ty].kind == TyKind::Array {
            NODES[n].kind = NodeKind::Int;
            NODES[n].a = TYPES[ty].b;
            NODES[n].b = SUF_I64;
            NODES[n].count = 0;
            return TY_I64;
        }
        NODES[n].kind = NodeKind::FieldAccess;
        NODES[n].a = receiver;
        NODES[n].count = 0;
        NODES[n].y = 2;
        NODES[n].x = 1;
        TY_I64
    }
}

// Whether e is a variable, a constant, a static or a field of one: what
// can be left unevaluated (an array's `.len()` is its type's).
pub fn is_plain_place(e: i64) -> bool {
    unsafe {
        match NODES[e].kind {
            NodeKind::Ident | NodeKind::Path => true,
            NodeKind::FieldAccess | NodeKind::TupleField => is_plain_place(NODES[e].a),
            _ => false,
        }
    }
}
