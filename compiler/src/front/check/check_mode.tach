// Check mode: an expression checked against the type its context expects
// (check_expr). Integer literals take the expected type (and must fit it),
// tuples, arrays and struct literals pass it to their parts, branches and
// arithmetic operands are checked against it; everything else is
// synthesized and compared with it.

use crate::base::{
    BUFS, IntVec, SRC, SYMS, buf_bytes, buf_new, buf_slice, buf_str, buf_uint, intern_c,
};
use crate::base::diag::{
    ERR, ERR_KIND, err_begin, err_end, err_end_soft, err_fix, err_fmt, err_help, err_help_fmt,
    err_int, err_str, err_sym, err_try_fmt, err_try_tool,
};
use crate::front::ast::{NODES, NODE_REF_MUT, NodeKind, REPR_UNION, child, new_node};
use crate::front::ast::NodeKind::{
    Array, Binary, Block, Char, Closure, Float, If, Int, Loop, Match, Range, Repeat, StructLit,
    Tuple, Unary,
};
use crate::front::check::{
    CUR_FN, LOCALS, Res, SELF_TYPE, SELF_TYPE_SYM, lookup_local, mismatch_error, name_error,
    type_error_got,
};
use crate::front::check::args::check_shorthands;
use crate::front::check::assign::is_place;
use crate::front::check::body::{check_branch, check_if, check_loop};
use crate::front::check::distinct::{BINARY_NODE, distinct_literal};
use crate::front::check::interp::check_interp;
use crate::front::check::iterate::range_value;
use crate::front::check::names::unknown_name_error;
use crate::front::check::resolve::resolve_alias;
use crate::front::check::sealed::check_literal;
use crate::front::check::synth_mode::{fold_layout_query, help_near_field, synth_expr};
use crate::front::check::temps::NODE_TEMP;
use crate::front::check::try_op::check_try;
use crate::front::check::variant_fields::variant_literal;
use crate::front::check::vectors::sym_is_c;
use crate::front::check::widen::try_widen;
use crate::front::closures::{check_closure, coerce_closure};
use crate::front::consteval::eval_array_len;
use crate::front::contracts::desugar::desugar_call;
use crate::front::convert::into_call;
use crate::front::distinct::strip_distinct;
use crate::front::generics::{HINT_NODE, HINT_TY, check_arg, env_lookup};
use crate::front::generics::instantiate::infer_struct_literal;
use crate::front::lexer::{SUF_NONE, Tok, is_ident_byte};
use crate::front::modules::{CUR_MOD, STD_MODULE, within_std};
use crate::front::modules::lookup::{
    B_ITEM, B_PRIVATE, access_error, binding_kind, binding_value, lookup_item, note_c_use,
    path_module,
};
use crate::front::patterns::check_match;
use crate::front::types::{
    FNS, REF_MUT, REF_SHARED, STRUCTS, SYM_ALIAS, SYM_STRUCT, TYPES, TY_BOOL, TY_ERROR, TY_NEVER,
    TyKind, buf_type, err_type, find_field, int_max, is_float, is_integer, is_numeric, is_ref,
    is_signed, struct_field, struct_type, type_elem,
};

fn passes_expected_to_operands(op: Tok, ex: i64) -> bool {
    // (0.18: a distinct type over a number, as the number)
    let expected = strip_distinct(ex);
    if op == Tok::Plus || op == Tok::Minus || op == Tok::Star || op == Tok::Slash
        || op == Tok::Percent {
        return is_numeric(expected);
    }
    if op == Tok::Amp || op == Tok::Pipe || op == Tok::Caret {
        return is_integer(expected);
    }
    false
}

// Checks `n` against `expected`; returns `expected`, or `!` when the
// expression diverges.
pub fn check_expr(n: i64, expected: i64) -> i64 {
    // (0.20) `&x` where nothing changes it, in a 0.20 file: conv.marker_extra
    crate::front::conv::extra_marker(n, expected);
    fold_layout_query(n);
    HINT_NODE = n;
    HINT_TY = expected;
    // (0.17: the own pass's record of the types and loans a function has,
    // front/own/fast.tach; its fast path reads it instead of the nodes)
    let mark = crate::front::own::fast::expr_enter(n);
    crate::front::own::fast::check_node(n);
    unsafe {
        // (0.20) `&x` of a 0.20 or mixed file where an exclusive reference
        // is expected: the inout marker (front/conv), exclusive
        if expected > 0 && crate::front::conv::inout_marker(n) && TYPES[expected].b == REF_MUT
            && (TYPES[expected].kind == TyKind::Ptr || TYPES[expected].kind == TyKind::Slice) {
            NODES[n].p |= NODE_REF_MUT;
        }
    }
    let actual = check_expr_inner(n, expected);
    unsafe {
        NODES[n].ty = expected;
        // (0.18: as synth_expr's)
        if NODES[n].kind == NodeKind::Call {
            desugar_call(n);
        }
    }
    crate::front::own::fast::check_exit(n, expected, mark);
    actual
}

fn check_expr_inner(n: i64, expected: i64) -> i64 {
    unsafe {
        // (0.18: a literal where a distinct type over a number goes)
        if distinct_literal(n, expected) {
            return expected;
        }
        match NODES[n].kind {
            Int if NODES[n].b == SUF_NONE && is_integer(expected) => {
                check_int_fits(n, NODES[n].a as u64, expected);
                return expected;
            }
            Char if is_integer(expected) => {
                check_int_fits(n, NODES[n].a as u64, expected);
                return expected;
            }
            Float if NODES[n].b == SUF_NONE && is_float(expected) => {
                return expected;
            }
            Tuple if TYPES[expected].kind == TyKind::Tuple => {
                check_tuple(n, expected);
                return expected;
            }
            Array if TYPES[expected].kind == TyKind::Array => {
                check_array(n, expected);
                return expected;
            }
            Repeat if TYPES[expected].kind == TyKind::Array => {
                check_expr(NODES[n].a, TYPES[expected].a);
                let count = eval_array_len(NODES[n].b);
                if count != TYPES[expected].b {
                    err_begin(NODES[NODES[n].b].start);
                    err_str(c"array repeat count is ");
                    err_int(count);
                    err_str(c", expected ");
                    err_int(TYPES[expected].b);
                    err_end();
                }
                return expected;
            }
            StructLit => {
                // (0.17: `E::V { a: x }`, a struct-like variant's literal)
                if variant_literal(n) {
                    return check_expr_inner(n, expected);
                }
                check_struct_literal(n, expected);
                return expected;
            }
            Closure => return check_closure(n, expected),
            // (0.15)
            NodeKind::Try => return check_try(n, expected),
            NodeKind::Interp => return check_interp(n, expected),
            NodeKind::MethodCall if NODES[n].count == 0 && sym_is_c(NODES[n].b, c"into") => {
                let t = into_call(n, expected);
                if t >= 0 {
                    return t;
                }
            }
            Range => return range_value(n, expected),
            If => return check_if(n, expected),
            Match => return check_match(n, expected),
            Block => return check_branch(n, expected),
            Loop => return check_loop(n, expected),
            Binary if passes_expected_to_operands(NODES[n].op, expected) => {
                let saved = BINARY_NODE;
                BINARY_NODE = n;
                check_expr(NODES[n].b, expected);
                check_expr(NODES[n].c, expected);
                BINARY_NODE = saved;
                return expected;
            }
            Binary if (NODES[n].op == Tok::Shl || NODES[n].op == Tok::Shr)
                && is_integer(expected) => {
                check_expr(NODES[n].b, expected);
                check_shift_amount(NODES[n].c);
                return expected;
            }
            Unary if NODES[n].op == Tok::Minus && is_numeric(expected)
                && !suffixed_int(NODES[n].b) => {
                check_negation(n, expected);
                return expected;
            }
            Unary if NODES[n].op == Tok::Tilde && is_integer(expected) => {
                check_expr(NODES[n].b, expected);
                return expected;
            }
            _ => {}
        }
    }
    let actual = synth_expr(n);
    if actual == TY_NEVER {
        return actual;
    }
    // (a value of the error type, or one where it is expected, follows
    // from an earlier error: nothing to report)
    if actual != expected && actual != TY_ERROR && expected != TY_ERROR {
        // (0.15: a narrower integer)
        if try_widen(n, actual, expected) {
            return expected;
        }
        if coerce_closure(n, expected) {
            return expected;
        }
        // (0.17: references)
        if coerce_ref(n, actual, expected) {
            return expected;
        }
        mismatch_error(n, expected, actual);
    }
    expected
}

// (0.17, docs/design/value-semantics.md §2.3) Value n of type `actual`
// where `expected` is expected (they differ): whether a reference converts.
// `&T` and `&mut T` become a raw `*T` (dereferencing one stays unsafe),
// `&mut T` a `&T`, `&mut [T]` a `[T]`; a reference to a slice is the slice
// (`f(&s)` for `s: [T]`, `&mut s` for a `&mut [T]`), n rewritten to read it.
pub fn coerce_ref(n: i64, actual: i64, expected: i64) -> bool {
    unsafe {
        if actual <= 0 || expected <= 0 {
            return false;
        }
        let ak = TYPES[actual].kind;
        let ek = TYPES[expected].kind;
        if ak == TyKind::Slice && ek == TyKind::Slice {
            if TYPES[actual].a != TYPES[expected].a {
                return false;
            }
            if TYPES[actual].b == REF_MUT && TYPES[expected].b == 0 {
                return true;
            }
            // A `[T]` where `&mut [T]` is expected (`sort(a[..])`,
            // `sort(v.as_slice())`, `sort(s)`): own.readonly (0.19.1; 0.17's
            // legacy slice rule took it as the exclusive view), the call
            // checked as if it were one
            if TYPES[actual].b == 0 && TYPES[expected].b == REF_MUT {
                readonly_slice_arg(n, actual);
                return true;
            }
            return false;
        }
        if ek == TyKind::Ptr && TYPES[expected].b == REF_SHARED && TYPES[expected].a == actual
            && (is_place(n) || NODES[n].kind == NodeKind::Ident && (NODES[n].p & NODE_TEMP) != 0) {
            // (0.18.1) a place where `&T` is expected is borrowed, as a
            // `self: &T` receiver is: `f(it)` for `f(x: &Item)` with `it`
            // from `for it in v.iter()`; a temporary slice, `&x.text()`,
            // where `&[T]` is (`cmp_of(&a.text(), &b.text())`)
            wrap_unary(n, Tok::Amp, expected);
            return true;
        }
        if ek == TyKind::Ptr && TYPES[expected].b == REF_MUT && TYPES[expected].a == actual
            && NODES[n].start == NODES[n].end && crate::front::check::assign::is_place(n) {
            // (0.20) a place the checker passes on where an exclusive
            // reference is wanted (a contract's companion given an inout
            // parameter, which is the value it designates): lent again
            wrap_unary(n, Tok::Amp, expected);
            NODES[n].p |= NODE_REF_MUT;
            return true;
        }
        if ak != TyKind::Ptr || TYPES[actual].b == 0 {
            return false;
        }
        let pointee = TYPES[actual].a;
        if pointee == expected && (is_numeric(expected) || expected == TY_BOOL
            || crate::front::own::kinds::is_plain_type(expected)) {
            // (0.18.1) a reference to a plain value (a number, a struct of
            // numbers: a pattern's binding on a reference, a closure's
            // parameter) where the value is expected: read through it, as
            // `*n`, a copy
            wrap_unary(n, Tok::Star, expected);
            return true;
        }
        if ek == TyKind::Ptr && TYPES[expected].b != 0 && is_ref(pointee)
            && pointee_fits(TYPES[pointee].a, TYPES[expected].a)
            && (TYPES[expected].b == REF_SHARED || TYPES[pointee].b == REF_MUT) {
            // (0.18.1) `&&T` where `&T` is expected (`let tr = &t;` of a
            // `t: &T`): the reference it holds
            wrap_unary(n, Tok::Star, pointee);
            return true;
        }
        if ek == TyKind::Ptr && pointee_fits(pointee, TYPES[expected].a) {
            if TYPES[expected].b == 0 {
                // (0.20: a reference that converts to a raw pointer, for
                // `fix --only conventions`: an access is its value, so its
                // address is `&x` then)
                RAW_FROM_REF.push(n);
            }
            return TYPES[expected].b == 0 || TYPES[expected].b == REF_SHARED;
        }
        if ek == TyKind::Slice && TYPES[pointee].kind == TyKind::Slice
            && TYPES[pointee].a == TYPES[expected].a
            && (TYPES[expected].b == 0 || TYPES[actual].b == REF_MUT) {
            if NODES[n].kind == Unary && NODES[n].op == Tok::Amp {
                // `&s`: s itself
                let operand = NODES[n].b;
                let flags = NODES[n].p;
                NODES[n] = NODES[operand];
                NODES[n].p |= flags & NODE_REF_MUT;
            } else {
                // `*r`
                let inner = new_node(Unary, NODES[n].start, NODES[n].end);
                NODES[inner] = NODES[n];
                NODES[n].kind = Unary;
                NODES[n].op = Tok::Star;
                NODES[n].b = inner;
                NODES[n].a = 0;
                NODES[n].count = 0;
                NODES[n].p = 0;
            }
            return true;
        }
        false
    }
}

// (0.20) The values coerce_ref converted from a reference to a raw `*T`
// (tools/fixconv: the address of an access is written `&x`).
pub static mut RAW_FROM_REF: crate::base::IntVec = crate::base::IntVec {
    data: 0 as *i64, count: 0, cap: 0
};

// (0.19.1) own.readonly: `[T]` value n (a read-only view) where `&mut [T]`
// is expected, a parameter the callee writes through (`sort(v.as_slice())`,
// `vst1q_u8(out[..], ...)`): the view must be exclusive. The fix, exact
// where it is one (`fix --suggested`): `&mut a[..]`, `v.as_mut_slice()`;
// a `[T]` parameter passed on is retyped (`refactor signature`).
fn readonly_slice_arg(n: i64, actual: i64) {
    unsafe {
        let text = SRC[NODES[n].start..NODES[n].end];
        let saved = ERR_KIND;
        ERR_KIND = c"own.readonly";
        err_begin(NODES[n].start);
        err_fmt(f"'{text}', a '");
        err_type(actual);
        err_str(c"', is read-only where '&mut [");
        err_type(TYPES[actual].a);
        err_str(c"]' is expected: the callee writes through it");
        err_help(
            c"pass an exclusive view: '&mut a[..]', 'v.as_mut_slice()', or a '&mut [T]' parameter");
        let new = buf_new();
        // `sort(v.as_slice())`, `sort(a[..])`: the method, `v.sort()`
        let s = NODES[n].start;
        let e = NODES[n].end;
        let whole = if text.len > 11 && text[text.len - 11..text.len] == ".as_slice()" { 11 }
            else if text.len > 4 && text[text.len - 4..text.len] == "[..]" { 4 } else { 0 };
        if whole > 0 && s >= 5 && SRC[s - 5..s] == "sort(" && SRC[e] == ')'
            && (s == 5 || !is_ident_byte(SRC[s - 6]) && SRC[s - 6] != '.' && SRC[s - 6] != ':') {
            let call = buf_new();
            buf_bytes(call, text[0..text.len - whole]);
            buf_str(call, c".sort()");
            err_try_fmt(buf_slice(call));
            err_fix(s - 5, e + 1, buf_slice(call));
        } else if NODES[n].kind == NodeKind::Index && fresh_slice(n) {
            buf_str(new, c"&mut ");
            buf_bytes(new, text);
        } else if text.len > 11 && text[text.len - 11..text.len] == ".as_slice()" {
            buf_bytes(new, text[0..text.len - 10]);
            buf_str(new, c"as_mut_slice()");
        }
        if BUFS[new].len > 0 {
            err_try_fmt(buf_slice(new));
            err_fix(NODES[n].start, NODES[n].end, buf_slice(new));
        } else if NODES[n].kind == NodeKind::Ident && CUR_FN >= 0 {
            let l = lookup_local(NODES[n].a);
            if l.is_some() && LOCALS[l.unwrap()].is_param {
                let a = buf_new();
                buf_str(a, c"refactor signature ");
                // (a generic function's template: its name without `<...>`)
                let name = SYMS[FNS[CUR_FN].display].text;
                let mut cut = 0;
                while cut < name.len && name[cut] != '<' {
                    cut += 1;
                }
                buf_bytes(a, name[0..cut]);
                buf_str(a, c" --type ");
                buf_bytes(a, text);
                // (the parameter's type as written: `[T]` in a generic one)
                let fnode = FNS[CUR_FN].node;
                let mut written = 0;
                for i in 0..NODES[fnode].count {
                    let p = child(fnode, i);
                    if NODES[p].kind == NodeKind::Param && NODES[p].a == NODES[n].a
                        && NODES[p].b > 0 {
                        written = NODES[p].b;
                    }
                }
                if written == 0 {
                    // (a closure's parameter: no signature to retype)
                    err_end_soft();
                    ERR_KIND = saved;
                    return;
                }
                buf_str(a, c" '&mut ");
                if written > 0 {
                    buf_bytes(a, SRC[NODES[written].start..NODES[written].end]);
                } else {
                    buf_str(a, c"[");
                    buf_type(a, TYPES[actual].a);
                    buf_str(a, c"]");
                }
                buf_str(a, c"'");
                err_try_tool(buf_slice(a), false);
            }
        }
        err_end_soft();
        ERR_KIND = saved;
    }
}

// (0.18.1) Node n becomes `op n` (`&` or `*`) of type ty: what it was
// moves to a new node under it.
fn wrap_unary(n: i64, op: Tok, ty: i64) {
    unsafe {
        let inner = new_node(NodeKind::Ident, NODES[n].start, NODES[n].end);
        NODES[inner] = NODES[n];
        NODES[n].kind = Unary;
        NODES[n].op = op;
        NODES[n].b = inner;
        NODES[n].a = 0;
        NODES[n].c = 0;
        NODES[n].count = 0;
        NODES[n].p = 0;
        NODES[n].res = Res::None;
        NODES[n].x = 0;
        NODES[n].y = 0;
        NODES[n].ty = ty;
        crate::front::own::fast::note_synthetic(n);
    }
}

// (0.17) Whether n makes a slice of a place: `a[x..y]`, `v.as_slice()` (a
// call of std's as_slice, once checked) (coerce_ref's legacy slice rule).
fn fresh_slice(n: i64) -> bool {
    unsafe {
        if NODES[n].kind == NodeKind::Index {
            return NODES[NODES[n].b].kind == NodeKind::Range;
        }
        if NODES[n].kind == NodeKind::MethodCall {
            return NODES[n].count == 0 && NODES[n].b == intern_c(c"as_slice");
        }
        let f = NODES[n].x - 1;
        NODES[n].kind == NodeKind::Call && f >= 0 && within_std(FNS[f].module)
            && NODES[FNS[f].node].a == intern_c(c"as_slice")
    }
}

// Whether a pointer to `a` converts to a pointer to `e`: the same type, or
// pointers all the way where e's are raw (`&&T` to `**T`).
fn pointee_fits(a: i64, e: i64) -> bool {
    unsafe {
        if a == e {
            return true;
        }
        TYPES[a].kind == TyKind::Ptr && TYPES[e].kind == TyKind::Ptr && TYPES[e].b == 0
            && pointee_fits(TYPES[a].a, TYPES[e].a)
    }
}

fn check_int_fits(n: i64, value: u64, ty: i64) {
    unsafe {
        if value > int_max(ty) {
            err_begin(NODES[n].start);
            err_str(c"integer literal ");
            buf_uint(ERR, value);
            err_str(c" does not fit in type '");
            err_type(ty);
            err_str(c"'");
            int_range_help(ty);
            err_end();
        }
    }
}

// (0.17) The help of a literal out of integer type ty's range: the range,
// and what to write instead.
pub fn int_range_help(ty: i64) {
    unsafe {
        let max = int_max(ty);
        let b = buf_new();
        buf_type(b, ty);
        err_help(c"'");
        err_help_fmt(buf_slice(b));
        err_help(c"' holds ");
        if is_signed(ty) {
            err_help(c"-");
            err_help_fmt(max + 1);
        } else {
            err_help(c"0");
        }
        err_help(c"..=");
        err_help_fmt(max);
        err_help(c": a wider type (`i64`), or the literal's low bits with `as` (`LITERAL as ");
        err_help_fmt(buf_slice(b));
        err_help(c"`)");
    }
}

fn check_tuple(n: i64, expected: i64) {
    unsafe {
        let count = NODES[n].count;
        if count != TYPES[expected].count {
            err_begin(NODES[n].start);
            err_str(c"tuple has ");
            err_int(count);
            err_str(c" elements, expected ");
            err_int(TYPES[expected].count);
            err_end();
        }
        for i in 0..count {
            check_expr(child(n, i), type_elem(expected, i));
        }
    }
}

fn check_array(n: i64, expected: i64) {
    unsafe {
        let count = NODES[n].count;
        if count != TYPES[expected].b {
            err_begin(NODES[n].start);
            err_str(c"array has ");
            err_int(count);
            err_str(c" elements, expected ");
            err_int(TYPES[expected].b);
            err_end();
        }
        for i in 0..count {
            check_expr(child(n, i), TYPES[expected].a);
        }
    }
}

// The struct a struct literal names (`Self` included; through its module
// path, h), or -1. A generic struct's template is returned as it is.
fn struct_of_literal(n: i64) -> i64 {
    unsafe {
        let name = NODES[n].a;
        if NODES[n].h == 0 {
            if name == SELF_TYPE_SYM && SELF_TYPE != 0 && TYPES[SELF_TYPE].kind == TyKind::Struct {
                return TYPES[SELF_TYPE].a;
            }
            let param = env_lookup(name);
            if param != 0 && TYPES[param].kind == TyKind::Struct {
                return TYPES[param].a;
            }
        }
        let m = if NODES[n].h != 0 { path_module(NODES[n].h, NODES[NODES[n].h].count) }
            else { CUR_MOD };
        let b = lookup_item(m, name, CUR_MOD);
        if NODES[n].h == 0 {
            note_c_use(NODES[n].start, name, b);
        }
        if binding_kind(b) == B_PRIVATE {
            access_error(b, NODES[n].start, name);
        }
        if binding_kind(b) != B_ITEM {
            return -1;
        }
        let key = binding_value(b);
        if SYM_STRUCT[key] != 0 {
            return SYM_STRUCT[key] - 1;
        }
        if SYM_ALIAS[key] != 0 {
            let t = resolve_alias(key, NODES[n].start);
            if TYPES[t].kind == TyKind::Struct {
                return TYPES[t].a;
            }
        }
        -1
    }
}

fn check_struct_literal(n: i64, expected: i64) {
    unsafe {
        let actual = check_struct_fields(n, expected);
        if actual != expected {
            if TYPES[expected].kind == TyKind::Struct && TYPES[actual].kind == TyKind::Struct {
                err_begin(NODES[n].start);
                err_str(c"expected struct '");
                err_sym(STRUCTS[TYPES[expected].a].name);
                err_str(c"', got constructor for '");
                err_sym(STRUCTS[TYPES[actual].a].name);
                err_str(c"'");
                err_end();
            }
            mismatch_error(n, expected, actual);
        }
    }
}

// The fields of `Name { ... }`: each exactly once, with its declared type.
// `expected` (0: none) may give a generic struct's type arguments.
pub fn check_struct_fields(n: i64, expected: i64) -> i64 {
    unsafe {
        let name = NODES[n].a;
        // (0.15: `P { x }` with no `x`)
        check_shorthands(n);
        let mut s = struct_of_literal(n);
        if s < 0 {
            unknown_name_error(NODES[n].start, c"unknown struct '", name);
        }
        if STRUCTS[s].generic > 0 {
            s = infer_struct_literal(s, n, expected);
        } else if NODES[n].g != 0 {
            name_error(NODES[n].start, c"struct '", name, c"' is not generic");
        }
        // (0.16: a #[sealed] struct's literals)
        if !check_literal(n, s) {
            return struct_type(s);
        }
        for i in 0..NODES[n].count {
            let init = child(n, i);
            for j in 0..i {
                if NODES[child(n, j)].a == NODES[init].a {
                    name_error(NODES[init].start, c"duplicate field '", NODES[init].a,
                        c"' in constructor");
                }
            }
            let field = find_field(s, NODES[init].a);
            if field < 0 {
                err_begin(NODES[init].start);
                err_str(c"unknown field '");
                err_sym(NODES[init].a);
                err_str(c"' in struct '");
                err_sym(STRUCTS[s].name);
                err_str(c"'");
                help_near_field(s, NODES[init].a);
                err_end();
            }
            NODES[init].x = field;
            check_arg(NODES[init].b, (*struct_field(s, field)).ty);
        }
        if (STRUCTS[s].repr & REPR_UNION) != 0 {
            if NODES[n].count != 1 {
                err_begin(NODES[n].start);
                err_str(c"a literal of union '");
                err_sym(STRUCTS[s].name);
                err_str(c"' sets exactly one field");
                err_end();
            }
            return struct_type(s);
        }
        for f in 0..STRUCTS[s].field_count {
            let mut found = false;
            for i in 0..NODES[n].count {
                if NODES[child(n, i)].x == f {
                    found = true;
                }
            }
            if !found {
                err_begin(NODES[n].start);
                err_str(c"missing field '");
                err_sym((*struct_field(s, f)).name);
                err_str(c"' in struct '");
                err_sym(STRUCTS[s].name);
                err_str(c"' constructor");
                err_end();
            }
        }
        struct_type(s)
    }
}

fn check_negation(n: i64, expected: i64) {
    unsafe {
        let operand = NODES[n].b;
        if NODES[operand].kind == Int && NODES[operand].b == SUF_NONE && is_signed(expected) {
            let value = NODES[operand].a as u64;
            let magnitude: u64 = if value == 0 { 0 } else { value - 1 };
            if magnitude > int_max(expected) {
                err_begin(NODES[n].start);
                err_str(c"integer literal -");
                buf_uint(ERR, value);
                err_str(c" does not fit in type '");
                err_type(expected);
                err_str(c"'");
                int_range_help(expected);
                err_end();
            }
            NODES[operand].ty = expected;
            return;
        }
        check_expr(operand, expected);
    }
}

// Whether n is an integer literal with a suffix (`-128i8` is checked as
// written: synth_unary allows the negated literal its sign).
fn suffixed_int(n: i64) -> bool {
    unsafe { NODES[n].kind == Int && NODES[n].b != SUF_NONE }
}

pub fn check_shift_amount(amount: i64) {
    let ty = synth_expr(amount);
    if !is_integer(ty) {
        unsafe { type_error_got(amount, c"shift amount must be integer", ty); }
    }
}
