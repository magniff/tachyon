// `#[sealed]` structs (0.16; T2 makes the checks): the fields not marked
// `pub` are invisible outside the module that declares the struct, and so
// are its literals; std's Vec, Buf, HashMap, Arena, ScopedArena and
// FixedBuf are sealed (docs/design/effects-allocation.md §2.4).

// Field access n (a FieldAccess, x = the field) of struct s.
pub fn check_field(n: i64, s: i64) {}

// Struct literal n of struct s.
pub fn check_literal(n: i64, s: i64) {}
