// Names in expressions: what an identifier names (a local, a constant, a
// static, a function as a value, a variant), the scope lookups patterns
// share, and the unknown-name error with its suggestions (a near name in
// scope, or the `use` that would bring it).

use crate::base::{
    BUFS, IntVec, SRC, SYMS, SYM_COUNT, buf_bytes, buf_new, buf_slice, buf_str, free, intern,
};
use crate::base::diag::{
    ERR_HELP, edit_distance, err_begin, err_end, err_failed_name, err_fix, err_fix_word,
    err_fixable, err_help, err_help_sym, err_pos, err_str, err_sym, err_try,
};
use crate::front::assoc::ensure_checked;
use crate::front::ast::{CONV_NEW, FN_UNSAFE, NODES, NodeKind, new_node};
use crate::front::ast::NodeKind::{CStr, Path, Str};
use crate::front::check::{CHECK_UNCHECKED, LOCALS, Res, lookup_local, name_error};
use crate::front::check::synth_mode::synth_expr;
use crate::front::check::unsafety::{U_FN_VALUE, unsafe_op};
use crate::front::cimport::c_import_skip_reason;
use crate::front::closures::note_local_use;
use crate::front::generics::{TPL_NONE, env_lookup, instance_of, targ_count_error, template_of_key};
use crate::front::generics::instantiate::{fn_instance, push_written_targs};
use crate::front::lexer::Tok;
use crate::front::modules::{
    CUR_MOD, C_MODULE, MODULES, STD_MODULE, item_key_if_known, module_count, within_std,
};
use crate::front::modules::lookup::{
    B_ITEM, B_MODULE, B_PRIVATE, B_TVARIANT, B_VARIANT, access_error, binding, binding_kind,
    binding_value, help_std_path, is_prelude_name, lookup_item, lookup_name, lookup_quiet,
    note_c_use,
};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::stdsrc::std_source;
use crate::front::threadlocal::note_static_use;
use crate::front::types::{
    CONSTS, ENUMS, FNS, STATICS, SYM_ALIAS, SYM_CONST, SYM_ENUM, SYM_FN, SYM_PRIMITIVE, SYM_STATIC,
    SYM_STRUCT, TSCRATCH, TY_ERROR, TY_STRING, TyKind, VARIANTS, enum_type, err_type, fn_param,
    is_pointer, item_node_of, make_type,
};
use crate::tools::fix::note_missing_use;
use std::Option;

pub fn synth_name(n: i64) -> i64 {
    unsafe {
        let name = NODES[n].a;
        let resolved = (NODES[n].p & NODE_RESOLVED) != 0;
        if !resolved {
            match lookup_local(name) {
                Option::Some(local) => {
                    if NODES[n].g != 0 {
                        name_error(NODES[n].start, c"'", name,
                            c"' is a variable, not a generic function");
                    }
                    NODES[n].res = Res::Local;
                    NODES[n].y = local;
                    note_local_use(n, local);
                    if LOCALS[local].access && (NODES[n].p & CONV_NEW) == 0 {
                        // (0.20) an access is used as the value it designates:
                        // `x` is `*x` (`&x`: `&*x`, a reborrow), conventions.md D12
                        return access_use(n);
                    }
                    return LOCALS[local].ty;
                }
                Option::None => {}
            }
        }
        let b = if resolved { binding(B_ITEM, name) } else { lookup_item(CUR_MOD, name, CUR_MOD) };
        if !resolved {
            note_c_use(NODES[n].start, name, b);
        }
        let kind = binding_kind(b);
        if kind == B_PRIVATE {
            access_error(b, NODES[n].start, name);
        }
        if kind == B_VARIANT {
            // A variant brought into scope by `use E::...;`: `E::V`.
            let v = binding_value(b);
            NODES[n].kind = Path;
            NODES[n].a = VARIANTS[v].name;
            NODES[n].b = VARIANTS[v].name;
            NODES[n].y = enum_type(VARIANTS[v].enum_id);
            return synth_expr(n);
        }
        if kind == B_TVARIANT {
            // A variant of a generic enum (0.6): its type arguments inferred
            // (`y` < 0: the template; see path_target).
            NODES[n].kind = Path;
            NODES[n].b = name;
            NODES[n].y = -binding_value(b) - 1;
            return synth_expr(n);
        }
        if kind == B_MODULE {
            name_error(NODES[n].start, c"'", name, c"' is a module, not a value");
        }
        if kind != B_ITEM {
            if CHECK_UNCHECKED {
                // (a binding of what was not parsed: the rest goes on)
                return TY_ERROR;
            }
            unknown_name_error(NODES[n].start, c"undefined variable '", name);
        }
        let key = binding_value(b);
        if SYM_CONST[key] != 0 {
            let c = SYM_CONST[key] - 1;
            let init = NODES[CONSTS[c].node].c;
            if NODES[init].kind == CStr && is_pointer(CONSTS[c].ty) {
                // A C string constant: the literal itself.
                NODES[n].kind = CStr;
                NODES[n].a = NODES[init].a;
                return CONSTS[c].ty;
            }
            if NODES[init].kind == Str && CONSTS[c].ty == TY_STRING {
                // A string constant (0.14): the literal itself.
                NODES[n].kind = Str;
                NODES[n].a = NODES[init].a;
                NODES[n].b = NODES[init].b;
                return TY_STRING;
            }
            NODES[n].res = Res::Const;
            NODES[n].y = c;
            return CONSTS[NODES[n].y].ty;
        }
        if SYM_STATIC[key] != 0 {
            NODES[n].res = Res::Static;
            NODES[n].y = SYM_STATIC[key] - 1;
            // The code generators find statics by their symbol.
            NODES[n].a = NODES[STATICS[NODES[n].y].node].a;
            // (0.21: a thread-local brings std's __tls_addr)
            note_static_use(NODES[n].y, n);
            return STATICS[NODES[n].y].ty;
        }
        if SYM_FN[key] != 0 {
            let mut f = SYM_FN[key] - 1;
            if FNS[f].variadic {
                name_error(NODES[n].start, c"variadic function '", name,
                    c"' cannot be used as a value");
            }
            if FNS[f].generic > 0 {
                // `max::<i64>` as a value: the arguments must be written.
                if NODES[n].g == 0 {
                    name_error(NODES[n].start, c"generic function '", name,
                        c"' needs its type arguments to be used as a value ('f::<T>')");
                }
                if NODES[NODES[n].g].count != FNS[f].generic {
                    targ_count_error(NODES[n].start, c"function", FNS[f].display, FNS[f].generic,
                        NODES[NODES[n].g].count);
                }
                let mark = TSCRATCH.count;
                push_written_targs(NODES[n].g);
                f = fn_instance(f, mark, n);
            } else if NODES[n].g != 0 {
                name_error(NODES[n].start, c"function '", name, c"' is not generic");
            }
            NODES[n].res = Res::Fn;
            NODES[n].y = f;
            ensure_checked(f, n);
            if (FNS[f].attrs & FN_UNSAFE) != 0 {
                unsafe_op(n, U_FN_VALUE,
                    c"using an `unsafe fn` as a value is unsafe (its callers are not checked)");
            }
            return fn_value_type(f);
        }
        if SYM_STRUCT[key] != 0 || SYM_ENUM[key] != 0 || SYM_ALIAS[key] != 0 {
            name_error(NODES[n].start, c"'", name, c"' is a type, not a value");
        }
        unknown_name_error(NODES[n].start, c"undefined variable '", name)
    }
}

// (0.20) Ident n, a use of an access local (front/check: Local.access),
// becomes `*n`: the place it designates. (The Ident inside is flagged
// CONV_NEW, so that it is the reference.)
fn access_use(n: i64) -> i64 {
    unsafe {
        let inner = new_node(NodeKind::Ident, NODES[n].start, NODES[n].end);
        NODES[inner] = NODES[n];
        NODES[inner].p |= CONV_NEW;
        NODES[n].kind = NodeKind::Unary;
        NODES[n].op = Tok::Star;
        NODES[n].a = 0;
        NODES[n].b = inner;
        NODES[n].count = 0;
        NODES[n].list = 0;
        NODES[n].p = NODES[n].p & NODE_RESOLVED;
        synth_expr(n)
    }
}

// An Ident whose `a` is already a key (a path resolved to an item).
pub const NODE_RESOLVED: i64 = 2;

// The enum type of the variant `name` in scope, in a pattern (p) against
// a value of type `ty`, or 0 when `name` is no variant: a generic enum's
// variant (0.6) takes the instance `ty`.
pub fn used_variant_enum(name: i64, ty: i64, p: i64) -> i64 {
    unsafe {
        let b = lookup_quiet(CUR_MOD, name, CUR_MOD);
        if binding_kind(b) == B_VARIANT {
            return enum_type(VARIANTS[binding_value(b)].enum_id);
        }
        if binding_kind(b) != B_TVARIANT {
            return 0;
        }
        let e = binding_value(b);
        if !instance_of(ty, -e - 1) {
            err_begin(NODES[p].start);
            err_str(c"expected '");
            err_type(ty);
            err_str(c"', got a pattern of '");
            err_sym(ENUMS[e].name);
            err_str(c"'");
            err_end();
        }
        ty
    }
}

// Whether `name` is a constant in the current scope (its index + 1, or 0).
pub fn scope_const(name: i64) -> i64 {
    let b = lookup_quiet(CUR_MOD, name, CUR_MOD);
    if binding_kind(b) == B_ITEM { unsafe { SYM_CONST[binding_value(b)] } } else { 0 }
}

// The position of the callee being checked, when it is a name (0.14): an
// unknown one with no near name points to std's API.
pub static mut CALLEE_POS: i64 = -1;

// An unknown name; when a C header left it out, why.
pub fn unknown_name_error(pos: i64, before: *u8, name: i64) -> ! {
    unsafe {
        err_begin(pos);
        err_str(before);
        err_sym(name);
        err_str(c"'");
        err_failed_name(name);
        let reason = c_import_skip_reason(name);
        if reason != 0 as *u8 {
            err_help(c"'");
            err_help_sym(name);
            err_help(c"' was not imported from the C headers: ");
            err_help(reason);
        } else if before[0] == 'u' && before[1] == 'n' && (before[2] == 'd' || before[2] == 'k') {
            // (`undefined variable '`, `unknown type '`, `unknown struct '`)
            suggest_name(name, before[2] == 'd', pos == CALLEE_POS || before[2] == 'k');
        }
        err_end()
    }
}

// ---- Suggestions for unknown names (0.11) ----

// The help of an unknown name (a value, or a type): inside std, the
// variant the prelude would name (0.17); the item of that name
// another module has (`add `use crate::m::name;``), std's when std is not
// read (0.14), what replaces a Rust type, else the nearest name in scope or
// in std (`did you mean 'x'?`), what std reads input with, or where std's
// API is listed.
fn suggest_name(name: i64, value: bool, hint_std: bool) {
    unsafe {
        // (0.18.1: and `Reverse(x)`, a value, as a type)
        if (!value || SYMS[name].text == "Reverse") && rust_type_help(name) {
            return;
        }
        let mut path = import_path_for(name, value);
        if path == 0 && STD_MODULE < 0 && std_has(name, value) {
            path = buf_new();
            buf_str(path, c"std");
        }
        if path != 0 {
            note_missing_use(CUR_MOD, intern(buf_slice(path)), name);
            err_help(c"add `use ");
            buf_bytes(ERR_HELP, buf_slice(path));
            err_help(c"::");
            err_help_sym(name);
            err_help(c";`");
            // (0.18: `fix --suggested` adds it, as `fix --only imports`)
            err_fixable();
            return;
        }
        let mut tie = false;
        let near = nearest_name(name, value, &mut tie);
        if near >= 0 {
            err_help(c"did you mean '");
            err_help_sym(near);
            err_help(c"'?");
            if !tie {
                err_fix_word(err_pos(), SYMS[name].text, SYMS[near].text);
            }
            return;
        }
        if value && rust_input_help(name) {
            return;
        }
        let mut in_std = near_to(name);
        std_names();
        for i in 0..STD_NAMES.count / 2 {
            if (STD_NAMES.data[2 * i + 1] != 0) == value {
                in_std.offer(STD_NAMES.data[2 * i]);
            }
        }
        if in_std.best >= 0 && is_prelude_name(in_std.best) {
            // (0.17) a name of the prelude: no `use`
            err_help(c"did you mean '");
            err_help_sym(in_std.best);
            err_help(c"'?");
            if !in_std.tie {
                err_fix_word(err_pos(), SYMS[name].text, SYMS[in_std.best].text);
            }
            return;
        }
        if in_std.best >= 0 {
            err_help(c"did you mean 'std::");
            err_help_sym(in_std.best);
            err_help(c"'? (`use std::");
            err_help_sym(in_std.best);
            err_help(c";`)");
            if !in_std.tie {
                let b = buf_new();
                buf_str(b, c"std::");
                buf_bytes(b, SYMS[in_std.best].text);
                err_fix_word(err_pos(), SYMS[name].text, buf_slice(b));
            }
            return;
        }
        if hint_std && !crate::front::modules::within_std(CUR_MOD) && SYMS[name].text.len > 2 {
            err_help(c"std's names: `tachyonc guide std`");
        }
    }
}

// std's public items (0.14), read from its source once an unknown name asks
// for them (std is read only when a program names it): pairs (name, 1 for a
// value: fn, const, static; 0 for a type: struct, enum, trait, type).
static mut STD_NAMES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn std_names() {
    unsafe {
        if STD_NAMES.count > 0 {
            return;
        }
        let src = buf_new();
        std_source(src);
        let text = buf_slice(src);
        let mut start = 0;
        while start < text.len {
            let mut end = start;
            while end < text.len && text[end] != '\n' {
                end += 1;
            }
            let line = text[start..end];
            start = end + 1;
            if line.len < 8 || line[0..4] != "pub " {
                continue;
            }
            let mut rest = line[4..];
            if rest.len > 7 && rest[0..7] == "unsafe " {
                rest = rest[7..];
            }
            let mut value = -1;
            let mut skip = 0;
            if rest.len > 3 && rest[0..3] == "fn " {
                value = 1;
                skip = 3;
            } else if rest.len > 6 && (rest[0..6] == "const " || rest[0..6] == "trait ") {
                value = if rest[0] == 'c' { 1 } else { 0 };
                skip = 6;
            } else if rest.len > 7 && (rest[0..7] == "static " || rest[0..7] == "struct ") {
                value = if rest[1] == 't' && rest[2] == 'a' { 1 } else { 0 };
                skip = 7;
            } else if rest.len > 5 && (rest[0..5] == "enum " || rest[0..5] == "type ") {
                value = 0;
                skip = 5;
            }
            if value < 0 {
                continue;
            }
            rest = rest[skip..];
            if rest.len > 4 && rest[0..4] == "mut " {
                rest = rest[4..];
            }
            let mut n = 0;
            while n < rest.len && is_ident_byte(rest[n]) {
                n += 1;
            }
            if n > 0 {
                STD_NAMES.push(intern(rest[0..n]));
                STD_NAMES.push(value);
            }
        }
    }
}

fn is_ident_byte(x: u8) -> bool {
    (x >= 'a' && x <= 'z') || (x >= 'A' && x <= 'Z') || (x >= '0' && x <= '9') || x == '_'
}

// Whether std has a public value (or type) `name`.
pub fn std_has(name: i64, value: bool) -> bool {
    unsafe {
        std_names();
        for i in 0..STD_NAMES.count / 2 {
            if STD_NAMES.data[2 * i] == name && (STD_NAMES.data[2 * i + 1] != 0) == value {
                return true;
            }
        }
        false
    }
}

// The help of an unknown function a Rust or Python programmer reads input
// or parses numbers with (0.14).
fn rust_input_help(name: i64) -> bool {
    unsafe {
        let t = SYMS[name].text;
        if t == "read_to_string" || t == "read_all" || t == "stdin" || t == "input"
            || t == "read_input" || t == "read" || t == "lines" || t == "read_lines"
            || t == "getline" || t == "gets" || t == "scanf" {
            err_help(c"std reads stdin: `read_stdin_in(gpa)` (all of it, a Buf), `read_line(&mut buf)` (one line, Ok(false) at the end), `Scanner` (tokens)");
        } else if t == "parse" || t == "atoi" || t == "parse_i64" || t == "to_int"
            || t == "int" || t == "from_str" {
            err_help(
                c"`parse_int(s)` (a Result<i64, ParseIntError>); `split_whitespace_in(s, gpa)`, `trim(s)`");
        } else {
            return false;
        }
        true
    }
}

// The help of an unknown type a Rust programmer writes (0.14): what
// tachyon has instead, exactly (0.17: the type to write as the try: line
// when there is one); whether there was one. (0.18.1) `Reverse`, a value
// too (`Reverse(x)`).
fn rust_type_help(name: i64) -> bool {
    unsafe {
        let text = SYMS[name].text;
        if text == "String" {
            err_help(c"text is `[u8]`, a slice of bytes (string literals are one); text you build is a `std::Buf` (`Buf::new_in(gpa)`, `b.push_str(s)`, `b.as_slice()` is its `[u8]`)");
            err_try(c"[u8]");
            rust_type_fix(text, "[u8]");
        } else if text == "str" {
            err_help(c"`&str` and `str` are `[u8]`: a slice of bytes, as string literals are");
            err_try(c"[u8]");
            rust_type_fix(text, "[u8]");
        } else if text == "char" {
            err_help(c"`u8`: text is bytes, and 'a' is a u8");
            err_try(c"u8");
            rust_type_fix(text, "u8");
        } else if text == "usize" || text == "isize" {
            err_help(c"`i64`: lengths and indices are i64 (`s.len`, `v.len()`)");
            err_try(c"i64");
            rust_type_fix(text, "i64");
        } else if text == "Reverse" {
            // (0.18.1) Rust's min-heap, `BinaryHeap<Reverse<T>>`, and its
            // `Reverse(x)`: no tuple structs here
            err_help(c"a min-heap is `MinHeap<T>` (prelude): `h.push(x)`, `h.pop()` gives the smallest first, no wrapper; `BinaryHeap<T>` pops the largest");
            err_try(c"MinHeap<T>");
        } else if text == "VecDeque" || text == "LinkedList" {
            err_help(c"a `Vec<T>` (with a start index for a queue)");
            err_try(c"Vec<T>");
        } else if text == "Box" || text == "Rc" || text == "Arc" {
            err_help(c"`*T` points to a value (`&x`; a parameter `p: *T` is a borrow); a value owned on the heap is a `Vec<T>` of one");
            err_try(c"*T");
        } else if text == "RefCell" || text == "Cell" || text == "Mutex" {
            err_help(c"no interior mutability types: a `*T` writes through (`p.x = 1`), a `let mut` changes in place");
            err_try(c"*T");
        } else if STD_MODULE >= 0 && help_std_path(name, 0, CUR_MOD, false) {
            // (`std::cmp::max`: a Rust module of std read as a type)
        } else {
            return false;
        }
        true
    }
}

// (0.18) The fix of a Rust type that has one tachyon spelling: the name at
// the error respelled, with the `&` before it (`&str`, `&String`: `[u8]`).
fn rust_type_fix(old: [u8], new: [u8]) {
    unsafe {
        let pos = err_pos();
        if pos > 0 && SRC[pos - 1] == '&' && SRC[pos..pos + old.len] == old {
            err_fix(pos - 1, pos + old.len, new);
        } else {
            err_fix_word(pos, old, new);
        }
    }
}

// Whether key `key` (an item's) is a value (a function, constant or
// static) or, for !value, a type.
fn key_is(key: i64, value: bool) -> bool {
    unsafe {
        if value {
            SYM_FN[key] != 0 || SYM_CONST[key] != 0 || SYM_STATIC[key] != 0
        } else {
            SYM_STRUCT[key] != 0 || SYM_ENUM[key] != 0 || SYM_ALIAS[key] != 0
                || template_of_key(key) != TPL_NONE
        }
    }
}

// Whether `name` is a value (or a type) where the checker is.
fn name_in_scope(name: i64, value: bool) -> bool {
    unsafe {
        if value {
            match lookup_local(name) {
                Option::Some(_) => { return true; }
                Option::None => {}
            }
        } else if env_lookup(name) != 0 || SYM_PRIMITIVE[name] != 0 {
            return true;
        }
        let b = lookup_quiet(CUR_MOD, name, CUR_MOD);
        binding_kind(b) == B_ITEM && key_is(binding_value(b), value)
    }
}

// The name in scope nearest to `name` (see name_distance), or -1.
fn nearest_name(name: i64, value: bool, tie: &mut bool) -> i64 {
    unsafe {
        let mut near = near_to(name);
        for s in 0..SYM_COUNT {
            if near.close(s) && name_in_scope(s, value) {
                near.take(s);
            }
        }
        *tie = near.tie;
        near.best
    }
}

// The help of an unknown item `name` of module m: the nearest name the
// current module can use there (an item, a module, a variant).
pub fn help_near_item(m: i64, name: i64) {
    unsafe {
        let mut near = near_to(name);
        for s in 0..SYM_COUNT {
            if near.close(s) {
                let kind = binding_kind(lookup_quiet(m, s, CUR_MOD));
                if kind == B_ITEM || kind == B_MODULE || kind == B_VARIANT || kind == B_TVARIANT {
                    near.take(s);
                }
            }
        }
        near.help();
    }
}

// ---- Near names (0.14) ----
//
// The help of an unknown method, field, item or name: the closest known
// one, by name_distance, only computed once the error is made.

const NEAR_NONE: i64 = 1000000;

// The best candidate so far for an unknown name `want`, at distance d.
pub struct Near { pub want: i64, pub best: i64, pub d: i64, tie: bool }

// No candidate yet for unknown name `want`.
pub fn near_to(want: i64) -> Near {
    Near { want: want, best: -1, d: NEAR_NONE, tie: false }
}

// (0.17) While NEAR_COLLECT: every candidate offered, near or not (an
// unknown method's: the closest methods of its type, by closest_names).
pub static mut NEAR_ALL: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut NEAR_COLLECT: bool = false;

// (0.17) The `max` names of NEAR_ALL closest to `want`, into the help as
// `'a', 'b'`: all of them when there are at most `max`, else those
// related to it (a common prefix of 3, a shared `_` word, one inside the
// other, or an edit distance of at most half its length), closest first;
// how many.
pub fn help_closest_names(want: i64, max: i64) -> i64 {
    unsafe {
        let w = SYMS[want].text;
        let all = NEAR_ALL.count <= max;
        let mut score = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..NEAR_ALL.count {
            let c = SYMS[NEAR_ALL.data[i]].text;
            let d = edit_distance(w, c);
            let mut p = 0;
            while p < w.len && p < c.len && w[p] == c[p] {
                p += 1;
            }
            let inside = c.len >= w.len && (0..c.len - w.len + 1).any(|k| c[k..k + w.len] == w)
                || w.len >= c.len && c.len >= 3
                && (0..w.len - c.len + 1).any(|k| w[k..k + c.len] == c);
            let related = all || p >= 3 || inside || d * 2 <= w.len || shares_word(w, c);
            score.push(if related { d * 4 - p * 3 - (if inside { 8 } else { 0 }) }
                else { i64::MAX });
        }
        let mut shown = 0;
        while shown < max {
            let mut best = -1;
            for i in 0..NEAR_ALL.count {
                if score.data[i] != i64::MAX && (best < 0 || score.data[i] < score.data[best]
                    || score.data[i] == score.data[best]
                    && SYMS[NEAR_ALL.data[i]].text.len < SYMS[NEAR_ALL.data[best]].text.len) {
                    best = i;
                }
            }
            if best < 0 {
                break;
            }
            if shown > 0 {
                err_help(c", ");
            }
            err_help(c"'");
            err_help_sym(NEAR_ALL.data[best]);
            err_help(c"'");
            score.data[best] = i64::MAX;
            shown += 1;
        }
        free(score.data as *u8);
        shown
    }
}

// (0.17) `prefix` and the names of NEAR_ALL nearest to `want` as the help
// (help_closest_names); no help when none is near.
pub fn help_nearest(prefix: *u8, want: i64) {
    unsafe {
        let mark = BUFS[ERR_HELP].len;
        err_help(prefix);
        if help_closest_names(want, 4) == 0 {
            BUFS[ERR_HELP].len = mark;
        }
    }
}

// Whether names a and b share a word of 3 letters or more (words split at
// `_`: `push_string` and `push_str` share `push`).
fn shares_word(a: [u8], b: [u8]) -> bool {
    let mut i = 0;
    while i < a.len {
        let mut j = i;
        while j < a.len && a[j] != '_' {
            j += 1;
        }
        if j - i >= 3 {
            let word = a[i..j];
            let mut k = 0;
            while k < b.len {
                let mut e = k;
                while e < b.len && b[e] != '_' {
                    e += 1;
                }
                if b[k..e] == word {
                    return true;
                }
                k = e + 1;
            }
        }
        i = j + 1;
    }
    false
}

impl Near {
    // Whether candidate `cand` (a symbol) is closer than the best so far.
    pub fn close(self: &Near, cand: i64) -> bool {
        unsafe {
            if cand < 0 || cand == self.want {
                return false;
            }
            let d = name_distance(SYMS[self.want].text, SYMS[cand].text);
            // (0.18: as near as the best: a tie, which take notes)
            d >= 0 && (d < self.d || d == self.d && cand != self.best)
        }
    }

    pub fn take(self: &mut Near, cand: i64) {
        unsafe {
            let d = name_distance(SYMS[self.want].text, SYMS[cand].text);
            if d == self.d {
                // (0.18) another name as near as the best: the help keeps
                // the first, and there is no fix
                self.tie = self.tie || SYMS[cand].text != SYMS[self.best].text;
                return;
            }
            self.d = d;
            self.best = cand;
            self.tie = false;
        }
    }

    // Offers candidate `cand`.
    pub fn offer(self: &mut Near, cand: i64) {
        if NEAR_COLLECT && cand >= 0 && cand != self.want {
            unsafe {
                let mut seen = false;
                for i in 0..NEAR_ALL.count {
                    if NEAR_ALL.data[i] == cand {
                        seen = true;
                    }
                }
                if !seen {
                    NEAR_ALL.push(cand);
                }
            }
        }
        if self.close(cand) {
            self.take(cand);
        }
    }

    // The error's help, `did you mean 'x'?`, when there is a candidate and
    // no other help.
    pub fn help(self: &Near) {
        unsafe {
            if self.best >= 0 && BUFS[ERR_HELP].len == 0 {
                err_help(c"did you mean '");
                err_help_sym(self.best);
                err_help(c"'?");
                // (0.18) the only name that near: the fix renames it
                if !self.tie {
                    err_fix_word(err_pos(), SYMS[self.want].text, SYMS[self.best].text);
                }
            }
        }
    }
}

// How far candidate name `cand` is from `want`, or -1 when it is not close:
// 0 when they differ only in case and underscores (`pushStr`, `push_str`),
// else their edit distance, at most a third of want's length (at least 1)
// and less than either length (`y` is not near `f`). Only identifiers count.
pub fn name_distance(want: [u8], cand: [u8]) -> i64 {
    if cand.len == 0 || !is_ident_text(cand) {
        return -1;
    }
    if loosely_equal(want, cand) {
        return 0;
    }
    let mut limit = want.len / 3;
    if limit < 1 {
        limit = 1;
    }
    if cand.len > want.len + limit || cand.len + limit < want.len {
        return -1;
    }
    let d = edit_distance(want, cand);
    if d > limit || d >= want.len || d >= cand.len {
        return -1;
    }
    d
}

fn is_ident_text(t: [u8]) -> bool {
    let c = t[0];
    if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_') {
        return false;
    }
    for x in t {
        if !((x >= 'a' && x <= 'z') || (x >= 'A' && x <= 'Z') || (x >= '0' && x <= '9')
            || x == '_') {
            return false;
        }
    }
    true
}

// Whether a and b are the same name but for case and underscores.
fn loosely_equal(a: [u8], b: [u8]) -> bool {
    let mut i = 0;
    let mut j = 0;
    loop {
        while i < a.len && a[i] == '_' {
            i += 1;
        }
        while j < b.len && b[j] == '_' {
            j += 1;
        }
        if i == a.len || j == b.len {
            return i == a.len && j == b.len;
        }
        if lower(a[i]) != lower(b[j]) {
            return false;
        }
        i += 1;
        j += 1;
    }
}

fn lower(c: u8) -> u8 {
    if c >= 'A' && c <= 'Z' { c + 32 } else { c }
}

// The path of the module (`crate::a::b`, `std`) whose public item `name`
// is a value (or a type) the current module could import: a buffer, or 0.
pub fn import_path_for(name: i64, value: bool) -> i64 {
    unsafe {
        for m in 0..module_count() {
            if m == CUR_MOD || m == C_MODULE {
                continue;
            }
            let key = item_key_if_known(m, name);
            if key < 0 {
                continue;
            }
            let item = item_node_of(key);
            if item == 0 || (NODES[item].p & ITEM_PUBLIC) == 0 || !key_is(key, value) {
                continue;
            }
            let out = buf_new();
            // (0.20) std's modules: `std` when its root re-exports the item
            // (`use std::HashSet;`, not `std::collections::hash_set`)
            if m != STD_MODULE && within_std(m)
                && binding_kind(lookup_name(STD_MODULE, name, CUR_MOD)) == B_ITEM {
                buf_str(out, c"std");
                return out;
            }
            put_module_path(out, m);
            return out;
        }
        0
    }
}

fn put_module_path(out: i64, m: i64) {
    unsafe {
        if m == 0 {
            buf_str(out, c"crate");
        } else if m == STD_MODULE {
            buf_str(out, c"std");
        } else {
            put_module_path(out, MODULES[m].parent);
            buf_str(out, c"::");
            buf_bytes(out, SYMS[MODULES[m].name].text);
        }
    }
}

pub fn fn_value_type(f: i64) -> i64 {
    unsafe {
        let mark = TSCRATCH.count;
        for i in 0..FNS[f].param_count {
            TSCRATCH.push(fn_param(f, i));
        }
        if FNS[f].is_extern || FNS[f].export {
            return make_type(TyKind::Fn, FNS[f].ret, 1, mark);
        }
        make_type(TyKind::Fn, FNS[f].ret, 0, mark)
    }
}
