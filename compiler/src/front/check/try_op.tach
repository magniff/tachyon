// `e?` (0.15; docs/design/errors-formatting.md): with `e: Option<T>` it
// is the T, or returns None; with `e: Result<T, E>` the T, or returns
// `Err(conv(err))` (convert::error_conversion), from the function or the
// closure being checked (RETURN_TYPE). The Try node's `y` becomes a Match
// (`std::Option::Some(__t) => __t, _ => return ...`, the `_` arm
// ARM_SYNTHETIC), which the back ends lower.
//
// Phase 0: a stub.

use crate::front::ast::NODES;
use crate::front::closures::unimplemented;

// The type of `e?` node n; `expected` is the type it is checked against
// (0: synthesized).
pub fn check_try(n: i64, expected: i64) -> i64 {
    unsafe { unimplemented(NODES[n].end - 1, c"'?' expressions") }
}
