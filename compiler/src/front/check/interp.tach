// f-strings (0.15; docs/design/errors-formatting.md): an Interp node is
// checked as the block
//
//   { let __f0 = e0; ...; std::Interp { f: move |__out: *std::Fmt| {
//       __out.str("a "); __out.spec(w, p, flags); __out.display(&__f0);
//       __out.end_spec(); ... } } }
//
// (its `y`, which the back ends lower): the holes are evaluated where the
// f-string is written, left to right, once; a hole with `?` in its spec
// is written with `debug`.
//
// Phase 0: a stub.

use crate::front::ast::NODES;
use crate::front::closures::unimplemented;

// The type of f-string n; `expected` is the type it is checked against
// (0: synthesized).
pub fn check_interp(n: i64, expected: i64) -> i64 {
    unsafe { unimplemented(NODES[n].start, c"f-strings") }
}
