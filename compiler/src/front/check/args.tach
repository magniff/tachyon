// Named arguments and parameter defaults (0.15;
// docs/design/errors-formatting.md). At a call, the positional arguments
// come first, then `name: value` in parameter order (Swift's rule); a
// parameter not given takes its default, a copy of the default expression
// (`Param.h`) checked in the callee's module, per call. Defaults are on
// trailing parameters of fn items and inherent methods only.
//
// Phase 0: stubs, which report the feature unimplemented when a call uses
// it.

use crate::base::diag::{err_begin, err_end_soft, err_str};
use crate::front::ast::{CALL_ARGS_DONE, NODES, NodeKind, child};
use crate::front::check::FNS;
use crate::front::closures::unimplemented;

// The arguments of call n (a Call or MethodCall) of function f (a FNS
// index, a template before it is instantiated), whose list holds the
// arguments of the parameters from first_param on (1 for a method call:
// the receiver is apart): put in parameter order, the defaults of the
// parameters not given appended (clones of Param.h), and n flagged
// CALL_ARGS_DONE. Nothing to do when n has no named argument and gives
// every parameter.
pub fn normalize_args(n: i64, f: i64, first_param: i64) {
    unsafe {
        if f < 0 || (NODES[n].p & CALL_ARGS_DONE) != 0 {
            return;
        }
        for i in 0..NODES[n].count {
            let arg = child(n, i);
            if NODES[arg].kind == NodeKind::NamedArg {
                unimplemented(NODES[arg].start, c"named arguments");
            }
        }
        let node = FNS[f].node;
        let given = first_param + NODES[n].count;
        if NODES[node].kind == NodeKind::Fn && given < NODES[node].count
            && NODES[child(node, given)].h != 0 {
            unimplemented(NODES[n].start, c"parameter defaults");
        }
    }
}

// The defaults of function f's parameters (a FNS index; called once its
// signature is resolved): on trailing parameters only, of the parameter's
// type, naming no parameter or local.
pub fn check_param_defaults(f: i64) {
    unsafe {
        let node = FNS[f].node;
        if NODES[node].kind != NodeKind::Fn {
            return;
        }
        for i in 0..NODES[node].count {
            let p = child(node, i);
            if NODES[p].h != 0 {
                err_begin(NODES[NODES[p].h].start);
                err_str(c"parameter defaults are not implemented yet (check.unimplemented)");
                err_end_soft();
                return;
            }
        }
    }
}
