// `&e` of a value that is no place (0.18.1): a temporary. Before a block
// is checked, each of its statements (and its tail) that takes `&f(x)`
// where nothing evaluated before it in the statement can tell the
// difference gets `let f(x) = f(x);` in front of it, and the `&` takes
// that local: the temporary lives to the end of the block (Rust's
// temporary lifetime extension, for `let r = &f(x);`, and longer than
// Rust's end of the statement for a call's argument), is dropped there,
// and the own pass checks it as any local (its name is the expression's
// text; a literal, `&P { x: 1 }`, is hoisted from anywhere). Where the
// order could differ (a call, an assignment or an index
// evaluated before it, a condition's other side, a closure), it stays an
// error with a `try:` (synth_unary).

use crate::base::{IntVec, SRC, buf_bytes, buf_int, buf_new, buf_slice, intern};
use crate::front::ast::{
    NODES, NODE_REF_MUT, NodeKind, child, list_begin, list_end, list_push, new_node,
};
use crate::front::check::lookup_local;
use crate::front::lexer::Tok;
use crate::front::modules::CUR_MOD;
use crate::front::modules::lookup::{B_ITEM, binding_kind, binding_value, lookup_item};
use crate::front::types::{FNS, SYM_FN, TYPES, TyKind, fn_param};

// A flag of the Ident that names a temporary (on the `&`'s operand).
pub const NODE_TEMP: i64 = 1 << 52;

// The `let`s made for the statement being visited, in evaluation order.
static var LETS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The names given in this block (a second `&f(x)` is `f(x) #2`).
static var NAMES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Whether something evaluated so far in the statement could be told apart
// from what a temporary made before the statement evaluates.
static var IMPURE: bool = false;

// Whether e, written after `&`, is a value rather than a place: what the
// checker would call a non-lvalue (a slice or a function's value is
// handled where it is typed: synth_unary).
fn is_value_expr(e: i64) -> bool {
    unsafe {
        let k = NODES[e].kind;
        if k == NodeKind::Unary {
            return NODES[e].op != Tok::Star;
        }
        k == NodeKind::Call || k == NodeKind::MethodCall || k == NodeKind::StructLit
            || k == NodeKind::Tuple || k == NodeKind::Array || k == NodeKind::Int
            || k == NodeKind::Float || k == NodeKind::Char || k == NodeKind::Str
            || k == NodeKind::Bool || k == NodeKind::Binary || k == NodeKind::Cast
            || k == NodeKind::Try
    }
}

// Whether evaluating e could be told apart from evaluating it later: a
// call, an assignment, an index (it may stop the program), a block.
fn impure(e: i64) -> bool {
    unsafe {
        if e == 0 {
            return false;
        }
        let k = NODES[e].kind;
        if k == NodeKind::Ident || k == NodeKind::Path || k == NodeKind::Int
            || k == NodeKind::Float || k == NodeKind::Char || k == NodeKind::Str
            || k == NodeKind::CStr || k == NodeKind::Bool || k == NodeKind::Unit {
            return false;
        }
        if k == NodeKind::FieldAccess || k == NodeKind::TupleField || k == NodeKind::Cast {
            return impure(NODES[e].a);
        }
        if k == NodeKind::Unary {
            return impure(NODES[e].b);
        }
        if k == NodeKind::Binary {
            return impure(NODES[e].b) || impure(NODES[e].c);
        }
        if k == NodeKind::Tuple || k == NodeKind::Array {
            for i in 0..NODES[e].count {
                let c = child(e, i);
                if impure(c) {
                    return true;
                }
            }
            return false;
        }
        true
    }
}

// Whether e is made of literals only (`P { x: 1 }`, `(2, "a")`): the same
// whenever it is evaluated.
fn constant(e: i64) -> bool {
    unsafe {
        let k = NODES[e].kind;
        if k == NodeKind::Int || k == NodeKind::Float || k == NodeKind::Char
            || k == NodeKind::Str || k == NodeKind::CStr || k == NodeKind::Bool
            || k == NodeKind::Unit {
            return true;
        }
        if k == NodeKind::Unary {
            return NODES[e].op == Tok::Minus && constant(NODES[e].b);
        }
        if k == NodeKind::Tuple || k == NodeKind::Array || k == NodeKind::StructLit {
            for i in 0..NODES[e].count {
                let c = child(e, i);
                if !constant(if NODES[c].kind == NodeKind::FieldInit { NODES[c].b } else { c }) {
                    return false;
                }
            }
            return true;
        }
        false
    }
}

// The name of the temporary of e: its text (its first line), unique in
// the block.
fn temp_name(e: i64) -> i64 {
    unsafe {
        let s = NODES[e].start;
        var end = NODES[e].end;
        var i = s;
        while i < end {
            if SRC[i] == '\n' {
                end = i;
            }
            i += 1;
        }
        let base = SRC[s..end];
        var name = intern(base);
        var k = 1;
        while NAMES.items().any(|x| x == name) {
            k += 1;
            let b = buf_new();
            buf_bytes(b, base);
            buf_bytes(b, " #");
            buf_int(b, k);
            name = intern(buf_slice(b));
        }
        NAMES.push(name);
        name
    }
}

// `&e` (node amp): `let NAME = e;` onto LETS, and the operand made the
// Ident NAME (NODE_TEMP), with e's position.
fn hoist(amp: i64) {
    unsafe {
        let e = NODES[amp].b;
        let start = NODES[e].start;
        let end = NODES[e].end;
        let name = temp_name(e);
        let pat = new_node(NodeKind::PatBind, start, end);
        NODES[pat].a = name;
        // (`&mut f(x)`: a `mut` local)
        NODES[pat].b = if (NODES[amp].p & NODE_REF_MUT) != 0 { 1 } else { 0 };
        let st = new_node(NodeKind::Let, start, end);
        NODES[st].a = pat;
        NODES[st].c = e;
        LETS.push(st);
        let id = new_node(NodeKind::Ident, start, end);
        NODES[id].a = name;
        NODES[id].p |= NODE_TEMP;
        NODES[amp].b = id;
    }
}

// (0.22) Argument a of a call: `x?` becomes a temporary of the statement
// (`let NAME = x?;` before it), whatever the parameter takes: a let
// parameter borrows the temporary for the call, where the value `?` made
// was a binding of its desugaring's block, dropped before the call; a sink
// one moves it, a copy copies it. Not after an impure expression (the
// order of evaluation stays).
fn visit_arg(a: i64) {
    unsafe {
        if NODES[a].kind != NodeKind::Try || IMPURE {
            visit(a);
            return;
        }
        let before = IMPURE;
        visit(NODES[a].a);
        IMPURE = before;
        let start = NODES[a].start;
        let end = NODES[a].end;
        let inner = new_node(NodeKind::None, start, end);
        NODES[inner] = NODES[a];
        let name = temp_name(inner);
        let pat = new_node(NodeKind::PatBind, start, end);
        NODES[pat].a = name;
        let st = new_node(NodeKind::Let, start, end);
        NODES[st].a = pat;
        NODES[st].c = inner;
        LETS.push(st);
        NODES[a].kind = NodeKind::Ident;
        NODES[a].a = name;
        NODES[a].b = 0;
        NODES[a].c = 0;
        NODES[a].count = 0;
        NODES[a].list = 0;
        NODES[a].p = NODE_TEMP;
    }
}

// Whether the text of node n holds the word sym.
fn names_word(n: i64, sym: i64) -> bool {
    unsafe {
        let w = crate::base::SYMS[sym].text;
        var i = NODES[n].start;
        while i + w.len <= NODES[n].end {
            if SRC[i..i + w.len] == w && (i == 0 || !is_word_byte(SRC[i - 1]))
                && (i + w.len >= NODES[n].end || !is_word_byte(SRC[i + w.len])) {
                return true;
            }
            i += 1;
        }
        false
    }
}

fn is_word_byte(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_'
}

// Visits expression e in evaluation order, through the positions that are
// evaluated once and unconditionally with the statement.
fn visit(e: i64) {
    unsafe {
        if e == 0 {
            return;
        }
        let k = NODES[e].kind;
        if k == NodeKind::Unary && NODES[e].op == Tok::Amp {
            let o = NODES[e].b;
            // (0.18.1: `&pool[a..b]`, a slice, where `&[u8]` is expected)
            let slicing = NODES[o].kind == NodeKind::Index
                && NODES[NODES[o].b].kind == NodeKind::Range && (NODES[e].p & NODE_REF_MUT) == 0;
            if !is_value_expr(o) && !slicing {
                visit(o);
                return;
            }
            if IMPURE && !constant(o) {
                return;
            }
            // (what e evaluates moves with it into its `let`, in order; a
            // literal of literals may move before anything: constant)
            let before = IMPURE;
            visit(o);
            IMPURE = before;
            hoist(e);
            return;
        }
        if k == NodeKind::Call {
            let_temporaries(e);
            visit(NODES[e].a);
            for i in 0..NODES[e].count {
                visit_arg(child(e, i));
            }
            IMPURE = true;
        } else if k == NodeKind::MethodCall {
            visit(NODES[e].a);
            // (an argument that names the receiver's variable stays: the
            // receiver changed by it is own.conflict, `v.push(v.pop()?)`)
            var r = NODES[e].a;
            while r > 0 && NODES[r].kind != NodeKind::Ident
                && (NODES[r].kind == NodeKind::FieldAccess
                    || NODES[r].kind == NodeKind::Index || NODES[r].kind == NodeKind::TupleField) {
                r = NODES[r].a;
            }
            let recv = if r > 0 && NODES[r].kind == NodeKind::Ident { NODES[r].a } else { -1 };
            for i in 0..NODES[e].count {
                let a = child(e, i);
                if recv >= 0 && names_word(a, recv) {
                    visit(a);
                } else {
                    visit_arg(a);
                }
            }
            IMPURE = true;
        } else if k == NodeKind::NamedArg {
            visit(NODES[e].b);
        } else if k == NodeKind::Binary {
            visit(NODES[e].b);
            if NODES[e].op == Tok::AmpAmp || NODES[e].op == Tok::PipePipe {
                // (its right side is evaluated or not: its temporaries in a
                // block of its own, 0.18.1)
                NODES[e].c = visit_sub(NODES[e].c);
                IMPURE = true;
                return;
            }
            visit(NODES[e].c);
        } else if k == NodeKind::Unary || k == NodeKind::Return {
            visit(if k == NodeKind::Unary { NODES[e].b } else { NODES[e].a });
        } else if k == NodeKind::Cast || k == NodeKind::FieldAccess || k == NodeKind::TupleField
            || k == NodeKind::Try || k == NodeKind::Index {
            // (0.24: an Index's base, `f([1, 2])[0]`, first)
            visit(NODES[e].a);
        } else if k == NodeKind::Tuple || k == NodeKind::Array {
            for i in 0..NODES[e].count {
                visit(child(e, i));
            }
        } else if k == NodeKind::Interp {
            // (an f-string's holes, evaluated in order where it stands)
            for i in 0..NODES[e].count {
                let h = child(e, i);
                if NODES[h].kind == NodeKind::InterpHole {
                    visit(NODES[h].a);
                }
            }
        } else if k == NodeKind::StructLit {
            for i in 0..NODES[e].count {
                let f = child(e, i);
                if NODES[f].kind == NodeKind::FieldInit {
                    visit(NODES[f].b);
                }
            }
        } else if k == NodeKind::If || k == NodeKind::Match {
            // (the condition, the scrutinee; the rest is evaluated or not:
            // an arm's temporaries in a block of their own, 0.18.1)
            visit(NODES[e].a);
            if k == NodeKind::Match {
                for i in 0..NODES[e].count {
                    let arm = child(e, i);
                    NODES[arm].c = visit_sub(NODES[arm].c);
                }
            }
            IMPURE = true;
        } else if k == NodeKind::Closure {
            // (0.18.1: a body that is an expression, `|a, b| cmp(&f(a),
            // &f(b))`: its temporaries in a block of their own)
            NODES[e].a = visit_sub(NODES[e].a);
            // (0.20: a body that is an expression becomes the tail of a
            // block, so that its owned temporaries drop when the body
            // ends: front/own/drops)
            let body = NODES[e].a;
            if body != 0 && NODES[body].kind != NodeKind::Block {
                let b = new_node(NodeKind::Block, NODES[body].start, NODES[body].end);
                let m = list_begin();
                list_end(b, m);
                NODES[b].a = body;
                NODES[e].a = b;
            }
        } else if k == NodeKind::Assign {
            visit(NODES[e].c);
            IMPURE = true;
        } else if impure(e) {
            IMPURE = true;
        }
    }
}

// (0.20, conventions.md §2.1) The values that call e passes to let
// parameters which borrow (`total(make())` for `total(v: Vec<i64>)`):
// each becomes `&value`, so that it is a temporary of the statement (hoist).
// The callee must be a non-generic function named by an identifier (its
// signature is resolved before the bodies are checked).
fn let_temporaries(e: i64) {
    unsafe {
        let callee = NODES[e].a;
        if NODES[callee].kind != NodeKind::Ident || NODES[callee].g != 0
            || lookup_local(NODES[callee].a).is_some() || CUR_MOD < 0 {
            return;
        }
        let b = lookup_item(CUR_MOD, NODES[callee].a, CUR_MOD);
        if binding_kind(b) != B_ITEM {
            return;
        }
        let key = binding_value(b);
        if SYM_FN[key] == 0 {
            return;
        }
        let f = SYM_FN[key] - 1;
        if FNS[f].generic > 0 {
            return;
        }
        let n = if NODES[e].count < FNS[f].param_count { NODES[e].count }
            else { FNS[f].param_count };
        for i in 0..n {
            let arg = child(e, i);
            let t = fn_param(f, i);
            if NODES[arg].kind == NodeKind::NamedArg
                || NODES[arg].kind == NodeKind::Unary && NODES[arg].op == Tok::Amp
                || t <= 0 || TYPES[t].kind != TyKind::Ptr
                || TYPES[t].b != crate::front::types::REF_SHARED || !is_value_expr(arg)
                || crate::front::conv::fn_param_conv(f, i) != crate::front::conv::CONV_LET {
                continue;
            }
            let inner = new_node(NodeKind::None, NODES[arg].start, NODES[arg].end);
            NODES[inner] = NODES[arg];
            NODES[arg].kind = NodeKind::Unary;
            NODES[arg].op = Tok::Amp;
            NODES[arg].a = 0;
            NODES[arg].b = inner;
            NODES[arg].count = 0;
            NODES[arg].list = 0;
            NODES[arg].p = 0;
        }
    }
}

// (0.18.1) Expression e, evaluated or not with its statement (a
// condition's other side, a match arm's value, a closure's body): its
// temporaries go in a block made for it, `{ let f(x) = f(x); e }`; that
// block, or e when it has none.
fn visit_sub(e: i64) -> i64 {
    unsafe {
        if e == 0 || NODES[e].kind == NodeKind::Block {
            return e;
        }
        let mark = LETS.count;
        let saved = IMPURE;
        IMPURE = false;
        visit(e);
        IMPURE = saved;
        if LETS.count == mark {
            return e;
        }
        let b = new_node(NodeKind::Block, NODES[e].start, NODES[e].end);
        let m = list_begin();
        for j in mark..LETS.count {
            list_push(LETS.data[j]);
        }
        list_end(b, m);
        NODES[b].a = e;
        LETS.count = mark;
        b
    }
}

// The temporaries of the statements of block (a `let`'s initializer, an
// expression statement, the tail): their `let`s in front of each.
pub fn hoist_temporaries(block: i64) {
    unsafe {
        NAMES.count = 0;
        var any = false;
        let mark = list_begin();
        for i in 0..NODES[block].count {
            let s = child(block, i);
            LETS.count = 0;
            IMPURE = false;
            let k = NODES[s].kind;
            if k == NodeKind::Let {
                visit(NODES[s].c);
            } else if k == NodeKind::ExprStmt {
                visit(NODES[s].a);
            }
            for j in 0..LETS.count {
                list_push(LETS.data[j]);
                any = true;
            }
            list_push(s);
        }
        let tail = NODES[block].a;
        if tail != 0 {
            LETS.count = 0;
            IMPURE = false;
            visit(tail);
            for j in 0..LETS.count {
                list_push(LETS.data[j]);
                any = true;
            }
        }
        if any {
            list_end(block, mark);
        } else {
            crate::front::ast::SCRATCH.count = mark;
        }
    }
}
