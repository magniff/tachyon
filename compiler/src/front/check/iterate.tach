// `for` over iterators and ranges as values (0.14;
// docs/design/closures-iterators.md): `for p in e` where e is not a range
// literal, a slice or an array iterates `e` if it implements Iterator,
// else `e.iter()`; `a..b` and `a..=b` outside `for` and slicing are
// std's Range and RangeInclusive.
//
// Phase 0: the interface, with stubs (the desugaring is the iterators
// task's).

use crate::front::ast::NODES;
use crate::front::check::{type_error, type_error_got};

// `for` loop n whose sequence (NODES[n].c, checked: its `ty` is set) is
// not a range, a slice or an array: its type.
pub fn check_for_iter(n: i64) -> i64 {
    unsafe {
        let seq = NODES[n].c;
        type_error_got(seq, c"'for' loops iterate over integer ranges ('a..b'), slices and arrays",
            NODES[seq].ty)
    }
}

// Range n (`a..b`, `a..=b`) as a value (`expected`: 0 in synth mode): its
// type.
pub fn range_value(n: i64, expected: i64) -> i64 {
    unsafe { type_error(n, c"ranges can only be used as the bounds of a 'for' loop") }
}
