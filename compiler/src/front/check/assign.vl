// Places and assignment: which expressions are places, `=` and the
// compound assignments (`+=` and the others, on numbers and vectors), and
// the mutability a write to a place needs.

use crate::base::{IntVec, SRC, SYMS, buf_bytes, buf_new, buf_slice, buf_str};
use crate::base::diag::{
    ERR_HELP, ERR_KIND, err_begin, err_end, err_end_soft, err_fmt, err_help, err_help_sym, err_str,
    err_sym, err_try, err_try_fmt,
};
use crate::front::ast::NODES;
use crate::front::ast::NodeKind::{FieldAccess, Ident, Index, Range, TupleField, Unary};
use crate::front::check::{LOCALS, Res, lookup_local, name_error, type_error, type_error_got};
use crate::front::check::check_mode::{check_expr, check_shift_amount};
use crate::front::check::synth_mode::{MUT_PLACE, synth_expr};
use crate::front::check::unsafety::mark_no_read;
use crate::front::check::vectors::vector_operator_ok;
use crate::front::closures::note_local_write;
use crate::front::distinct::strip_distinct;
use crate::front::lexer::Tok;
use crate::front::types::{
    CONSTS, REF_MUT, STATICS, SYM_STATIC, TYPES, TyKind, buf_type, is_integer, is_numeric,
    is_pointer, is_slice, is_vector,
};

fn arith_token_of_assign(op: Tok) -> Tok {
    if op == Tok::PlusEq { return Tok::Plus; }
    if op == Tok::MinusEq { return Tok::Minus; }
    if op == Tok::StarEq { return Tok::Star; }
    if op == Tok::SlashEq { return Tok::Slash; }
    if op == Tok::PercentEq { return Tok::Percent; }
    if op == Tok::AmpEq { return Tok::Amp; }
    if op == Tok::PipeEq { return Tok::Pipe; }
    if op == Tok::CaretEq { return Tok::Caret; }
    op
}

// ---- Places and assignment ----

pub fn is_place(n: i64) -> bool {
    unsafe {
        match NODES[n].kind {
            Ident => {
                let name = NODES[n].a;
                lookup_local(name).is_some() || SYM_STATIC[name] != 0
            }
            Unary => NODES[n].op == Tok::Star,
            // Through a pointer.
            FieldAccess if NODES[n].y == 1 => true,
            FieldAccess | TupleField => is_place(NODES[n].a),
            Index => {
                let base = NODES[n].a;
                if NODES[NODES[n].b].kind == Range {
                    return false;
                }
                is_pointer(NODES[base].ty) || is_slice(NODES[base].ty) || is_place(base)
            }
            _ => false,
        }
    }
}

// (0.17) The assignment whose target is being checked (0 outside one):
// `p[0] = x`'s error names the statement written through the pointer.
pub static var ASSIGNING: i64 = 0;

pub fn check_assign(n: i64) {
    unsafe {
        let op = NODES[n].op;
        let target = NODES[n].b;
        let value = NODES[n].c;
        if op == Tok::Eq {
            // Writing a union's field reads nothing.
            mark_no_read(target);
        }
        let outer = ASSIGNING;
        ASSIGNING = n;
        let outer_place = MUT_PLACE;
        MUT_PLACE = target;
        let target_ty = synth_expr(target);
        MUT_PLACE = outer_place;
        ASSIGNING = outer;
        if !is_place(target) {
            let name = NODES[target].a;
            if NODES[target].kind == Ident && NODES[target].res == Res::Const {
                name_error(NODES[target].start, c"cannot assign to constant '",
                    NODES[CONSTS[NODES[target].y].node].a, c"'");
            }
            if NODES[target].kind == Ident && NODES[target].res == Res::Fn {
                name_error(NODES[target].start, c"cannot assign to function '", name, c"'");
            }
            type_error(target, c"invalid assignment target");
        }
        check_mutable_place(target);
        if op == Tok::Eq {
            check_expr(value, target_ty);
            return;
        }
        if op == Tok::ShlEq || op == Tok::ShrEq {
            // (0.18: a distinct type as its underlying type)
            if !is_integer(strip_distinct(target_ty)) {
                type_error_got(n, c"shift assignment requires integer type", target_ty);
            }
            check_shift_amount(value);
            return;
        }
        if is_vector(target_ty) {
            // (0.10: lanewise, as the operator)
            vector_operator_ok(n, arith_token_of_assign(op), target_ty);
            check_expr(value, target_ty);
            return;
        }
        if op == Tok::AmpEq || op == Tok::PipeEq || op == Tok::CaretEq {
            if !is_integer(strip_distinct(target_ty)) {
                type_error_got(n, c"bitwise assignment requires integer type", target_ty);
            }
        } else if !is_numeric(strip_distinct(target_ty)) {
            type_error_got(n, c"compound assignment requires numeric type", target_ty);
        }
        check_expr(value, target_ty);
    }
}

pub fn check_mutable_place(target: i64) {
    let root = place_root(target);
    if root > 0 {
        check_mutable_name(root, target);
    }
}

// The Ident a write to place `target` changes, through fields, tuple parts
// and the elements of an array (0: none to check, the place reached
// through a pointer, a reference or a slice, or not a place).
pub fn place_root(target: i64) -> i64 {
    var root = target;
    loop {
        unsafe {
            match NODES[root].kind {
                // Through a pointer: no `mut` needed.
                FieldAccess if NODES[root].y == 1 => return 0,
                FieldAccess | TupleField => root = NODES[root].a,
                Index if !is_pointer(NODES[NODES[root].a].ty)
                    && !is_slice(NODES[NODES[root].a].ty) => root = NODES[root].a,
                Ident => return root,
                _ => return 0,
            }
        }
    }
}

// (0.25) The rule of an inout access: `&place` taken exclusive (an inout
// argument, `inout r = &place`, `match &place`, `for inout x in &place`)
// and the receiver of an `inout self` method (`c.inc()`, `v.push(x)`,
// `v[i] = x` through `as_mut_slice`) need the place's root mutable: a
// `var` local, an inout parameter or `inout self`, a `static var`, or
// memory reached through a raw pointer (unsafe) or an inout access. A let
// binding, a let parameter, a let receiver and an immutable static (in
// read-only data) are read-only: own.readonly, naming the binding. (A let
// access to an owned value, a reference inside, is the own pass's:
// views::on_mut_loan.) `at` is the node reported: the `&`, the call.
// `&place` given where a raw `*T` is wanted is its address, not an
// access (unsafe code answers for writes through it): its check waits for
// the function's end (flush_inout_places), when the node's type says.
pub fn check_inout_place(target: i64, at: i64) {
    let kind = inout_root_kind(target);
    if kind != 0 {
        unsafe { inout_place_error(at, kind, NODES[INOUT_ROOT].a, INOUT_ROOT_TY); }
    }
}

// The same for `&place` (synth_unary): reported at the function's end
// unless the `&` became a raw pointer.
pub fn defer_inout_place(target: i64, at: i64) {
    let kind = inout_root_kind(target);
    if kind != 0 {
        unsafe {
            INOUT_PENDING.push(at);
            INOUT_PENDING.push(kind);
            INOUT_PENDING.push(NODES[INOUT_ROOT].a);
            INOUT_PENDING.push(INOUT_ROOT_TY);
        }
    }
}

// (0.25) `&value` of a temporary (check/temps.vl made its local): conv.place
// at the function's end if it was lent inout.
pub fn defer_conv_place(at: i64) {
    unsafe {
        INOUT_PENDING.push(at);
        INOUT_PENDING.push(5);
        INOUT_PENDING.push(0);
        INOUT_PENDING.push(0);
    }
}

// (`&x as *T`: the `&` nodes cast to a raw pointer, for flush_inout_places)
pub static var RAW_ADDRS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// (the pending `&place` errors: the node, the kind, the name, the type)
pub static var INOUT_PENDING: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// While the checker checks code it made that may change a let binding (a
// drop at the end of its life): no inout check.
pub static var INOUT_FREE: i64 = 0;
static var INOUT_ROOT: i64 = 0;
static var INOUT_ROOT_TY: i64 = 0;

pub fn clear_inout_places() {
    unsafe {
        INOUT_PENDING.count = 0;
        RAW_ADDRS.count = 0;
    }
}

pub fn flush_inout_places() {
    unsafe {
        var i = 0;
        while i + 3 < INOUT_PENDING.count {
            let at = INOUT_PENDING.data[i];
            let t = NODES[at].ty;
            // (a raw pointer, or a let `[T]`: no inout access)
            var raw = t > 0 && (TYPES[t].kind == TyKind::Ptr || TYPES[t].kind == TyKind::Slice)
                && TYPES[t].b == 0;
            for j in 0..RAW_ADDRS.count {
                if RAW_ADDRS.data[j] == at {
                    raw = true;
                }
            }
            if INOUT_PENDING.data[i + 1] == 5 {
                // (conv.place: only where the access is inout)
                if t > 0 && TYPES[t].kind == TyKind::Ptr && TYPES[t].b == REF_MUT {
                    conv_place_error(at);
                }
            } else if !raw {
                inout_place_error(at, INOUT_PENDING.data[i + 1], INOUT_PENDING.data[i + 2],
                    INOUT_PENDING.data[i + 3]);
            }
            i += 4;
        }
        clear_inout_places();
    }
}

// conv.place: `&make()` lent inout, a temporary whose change is lost.
fn conv_place_error(at: i64) {
    unsafe {
        let text = SRC[NODES[at].start..NODES[at].end];
        let value = if text.len > 1 && text[0] == '&' { text[1..text.len] } else { text };
        let m = buf_new();
        buf_str(m, c"'&' lends a place for the callee to change; '");
        buf_bytes(m, value);
        buf_str(m, c"' is a temporary, whose change would be lost");
        crate::front::conv::conv_error(crate::front::conv::CODE_PLACE, NODES[at].start,
            NODES[at].end, buf_slice(m), "name it first, then lend it: 'var t = VALUE;' and '&t'",
            "");
    }
}

// What the root of place `target` is when an inout access of it breaks the
// rule (0: nothing wrong): 1 a let binding, 2 a let parameter, 3 a let
// receiver, 4 an immutable static; INOUT_ROOT is the Ident, INOUT_ROOT_TY
// its type.
fn inout_root_kind(target: i64) -> i64 {
    unsafe {
        if INOUT_FREE > 0 {
            return 0;
        }
        let root = place_root(target);
        if root <= 0 {
            return 0;
        }
        INOUT_ROOT = root;
        if NODES[root].res == Res::Local {
            let local = NODES[root].y;
            if local < 0 {
                return 0;
            }
            let t = LOCALS[local].ty;
            INOUT_ROOT_TY = t;
            if LOCALS[local].mutable {
                // (a closure that changes it this way writes it)
                note_local_write(local);
            }
            // (an access, a reference: through it; a slice is a view,
            // whose writes the own pass checks: views::on_mut_loan)
            if LOCALS[local].mutable || LOCALS[local].access
                || t > 0 && TYPES[t].kind == TyKind::Ptr && TYPES[t].b != 0
                || t > 0 && TYPES[t].kind == TyKind::Slice {
                return 0;
            }
            if SYMS[NODES[root].a].text == "self" {
                return 3;
            }
            return if LOCALS[local].is_param { 2 } else { 1 };
        }
        if NODES[root].res == Res::Static && !STATICS[NODES[root].y].mutable {
            INOUT_ROOT_TY = STATICS[NODES[root].y].ty;
            return 4;
        }
        0
    }
}

fn inout_place_error(at: i64, kind: i64, name: i64, t: i64) {
    unsafe {
        let text = SRC[NODES[at].start..NODES[at].end];
        let saved = ERR_KIND;
        ERR_KIND = c"own.readonly";
        err_begin(NODES[at].start);
        err_fmt(f"'{text}' changes '");
        err_sym(name);
        let b = buf_new();
        if kind == 4 {
            err_str(c"', an immutable static: it is read-only (in read-only memory)");
            err_help(c"declare it `static var` to change it");
            buf_str(b, c"static var ");
            buf_bytes(b, SYMS[name].text);
        } else if kind == 3 {
            err_str(c"', a let receiver: it is read-only");
            err_help(c"take the receiver inout to change it");
            buf_str(b, c"inout self");
        } else if kind == 2 {
            err_str(c"', a let parameter: it is read-only");
            err_help(
                c"take it inout to change the caller's value, or `sink` for a copy of its own");
            buf_bytes(b, SYMS[name].text);
            buf_str(b, c": inout ");
            buf_type(b, t);
        } else {
            err_str(c"', a let binding: it is read-only");
            err_help(c"declare it `var` to change it");
            buf_str(b, c"var ");
            buf_bytes(b, SYMS[name].text);
            buf_str(b, c" = ...");
        }
        err_try_fmt(buf_slice(b));
        err_end_soft();
        ERR_KIND = saved;
    }
}

fn check_mutable_name(ident: i64, target: i64) {
    unsafe {
        let name = NODES[ident].a;
        let local = if NODES[ident].res == Res::Local { NODES[ident].y } else { -1 };
        if local >= 0 {
            note_local_write(local);
            if LOCALS[local].mutable {
                return;
            }
            err_begin(NODES[target].start);
            err_str(c"cannot assign to immutable variable '");
            err_sym(name);
            err_str(c"'");
            // (mixed files keep the 0.19 words until Phase M)
            let legacy = !crate::front::conv::strict_at(NODES[target].start);
            if LOCALS[local].is_param && !legacy {
                // (0.20, conventions.md §2.1: a let parameter is read-only)
                err_help(c"a parameter is read-only (let); to change the caller's value take it `");
                err_help_sym(name);
                err_help(c": inout ");
                buf_type(ERR_HELP, LOCALS[local].ty);
                err_help(c"` (called with `&x`); for a copy of its own, `");
                err_help_sym(name);
                err_help(c": sink ");
                buf_type(ERR_HELP, LOCALS[local].ty);
                err_help(c"`");
            } else if !legacy {
                err_help(c"make it mutable: `var ");
                err_help_sym(name);
                err_help(c"`");
            } else if LOCALS[local].is_param {
                err_help(c"make the parameter mutable: `mut ");
                err_help_sym(name);
                err_help(c": ");
                buf_type(ERR_HELP, LOCALS[local].ty);
                err_help(c"`");
            } else {
                err_help(c"make it mutable: `let mut ");
                err_help_sym(name);
                err_help(c"`");
            }
            err_end();
        }
        if NODES[ident].res == Res::Static && !STATICS[NODES[ident].y].mutable {
            err_begin(NODES[target].start);
            err_str(c"cannot assign to immutable static '");
            err_sym(name);
            err_str(c"'");
            err_help(
                if !crate::front::conv::strict_at(NODES[target].start) {
                    c"declare it `static var "
                }
                else { c"declare it `static var " });
            err_help_sym(name);
            err_help(c"`");
            err_end();
        }
    }
}
