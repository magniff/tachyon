// Unsafe code (0.9): the operations that need it, borrows, and the units
// --fix-unsafe wraps.
//
// Safe code has no undefined behaviour; the operations that can have it
// are allowed in unsafe code only: inside `unsafe { ... }` and in the body
// of an `unsafe fn` (UNSAFE_DEPTH > 0). They are dereferencing, indexing
// and slicing a raw pointer, casting an integer (other than the literal 0)
// to a pointer, calling C (an `extern "C"` declaration or function
// pointer), calling an `unsafe fn`, and reading a union's field.
//
// A *borrow* is a pointer known to point to live memory of its type: `&p`
// for a place p, or a parameter declared with a pointer type (and not
// `mut`), `self: *T` included. Dereferencing a borrow (`*b`, `b.f`, a
// method through it) is safe; any other pointer is raw. So that borrowed
// parameters can be trusted, passing a raw pointer where a function takes
// a pointer parameter is unsafe (and so is calling through a function
// pointer with one, or using such a function as a value).
//
// An unsafe operation outside unsafe code is an error (`error[unsafe]`;
// a warning in 0.9). `--fix-unsafe` wraps them in unsafe blocks
// (fixunsafe.tach).

use crate::base::{SRC, buf_fmt, buf_new, buf_slice, intern_c};
use crate::base::diag::{
    ERR_KIND, err_begin, err_end_soft, err_fix, err_fmt, err_help, err_help_fmt, err_str,
    err_try_fmt, err_try_tool, error_keyed, report_error_once,
};
use crate::front::ambient::check_ambient_call;
use crate::front::ast::{FN_UNSAFE, NODES, NODE_REF, NodeKind, child};
use crate::front::ast::NodeKind::{
    Call, Cast, FieldAccess, Ident, MethodCall, TupleField, TyName, TyPtr, TySlice, Unary,
};
use crate::front::check::{CONST_CONTEXT, LOCALS, Res};
use crate::front::check::assign::ASSIGNING;
use crate::front::check::check_mode::check_expr;
use crate::front::check::synth_mode::synth_expr;
use crate::front::generics::env_lookup;
use crate::front::lexer::Tok;
use crate::front::types::{
    FNS, STRUCTS, TYPES, TY_BOOL, TyKind, err_type, fn_param, is_numeric, is_ref,
};
use crate::tools::fixunsafe::{FIX_UNSAFE, note_unsafe_site};

pub static mut UNSAFE_DEPTH: i64 = 0;

// The innermost statement, block tail or condition being checked: what
// --fix-unsafe wraps (0: none).
pub static mut WRAP_NODE: i64 = 0;

// Flag of an expression whose value is not read (a place written, or
// whose address is taken): a union's field may be written so.
pub const NODE_NO_READ: i64 = 256;

// The kinds of unsafe operations (a warning is reported once per position
// and kind).
pub const U_DEREF: i64 = 1;

pub const U_FIELD: i64 = 2;

pub const U_METHOD: i64 = 3;

pub const U_INDEX: i64 = 4;

pub const U_SLICE: i64 = 5;

pub const U_INT_PTR: i64 = 6;

pub const U_C_CALL: i64 = 7;

const U_UNSAFE_CALL: i64 = 8;

pub const U_UNION: i64 = 9;

pub const U_PTR_ARG: i64 = 10;

pub const U_FN_VALUE: i64 = 11;

// Operation n, of kind `key`, needs unsafe code.
pub fn unsafe_op(n: i64, key: i64, message: *u8) {
    if UNSAFE_DEPTH > 0 || CONST_CONTEXT {
        return;
    }
    if FIX_UNSAFE && WRAP_NODE != 0 {
        note_unsafe_site(WRAP_NODE);
        return;
    }
    unsafe {
        report_error_once(NODES[n].start, key, c"unsafe", message,
            c"put it in an `unsafe { ... }` block, or the function's body in an `unsafe fn` (the try: line wraps every such place)",
            "fix --only unsafe");
    }
}

// (0.17) `p[i]` (`p[a..b]`) on a raw pointer p to a Vec, a Buf or a slice
// (pointee), outside unsafe code. It indexes the one p points to, checked,
// as through a borrow; reading through a raw pointer is what is unsafe, so
// `fix --only unsafe` wraps it (its meaning is the same in `unsafe`). For a
// local `let p = &v;` the try: indexes v itself.
pub fn unsafe_view_index(n: i64, base: i64, index: i64, pointee: i64, slicing: bool) {
    if UNSAFE_DEPTH > 0 || CONST_CONTEXT {
        return;
    }
    if FIX_UNSAFE && WRAP_NODE != 0 {
        note_unsafe_site(WRAP_NODE);
        return;
    }
    unsafe {
        let key = if slicing { U_SLICE } else { U_INDEX };
        if error_keyed(NODES[n].start, key) {
            return;
        }
        let saved = ERR_KIND;
        ERR_KIND = c"unsafe";
        err_begin(NODES[n].start);
        err_str(if slicing { c"slicing a '" } else { c"indexing a '" });
        err_type(pointee);
        err_str(c"' through a raw pointer is unsafe");
        let p = if NODES[base].end > NODES[base].start { SRC[NODES[base].start..NODES[base].end] }
            else { "p" };
        let mut what = "a raw pointer";
        let mut place = 0;
        if NODES[base].kind == Ident && NODES[base].res == Res::Local && NODES[base].y >= 0 {
            let local = NODES[base].y;
            place = LOCALS[local].init;
            what = if LOCALS[local].is_param { "a `mut` parameter" } else { "a local" };
        } else if NODES[base].kind == Ident && NODES[base].res == Res::Static {
            what = "a static";
        } else if NODES[base].kind == FieldAccess {
            what = "a field";
        }
        if place != 0 && (NODES[place].kind == Ident || NODES[place].kind == FieldAccess)
            && NODES[place].end > NODES[place].start {
            // `let p = &v;`: v itself, the rest of the statement after it
            // when it is assigned on one line
            let v = SRC[NODES[place].start..NODES[place].end];
            err_help_fmt(
                f"`{p}` is {what} holding `&{v}`, a raw pointer, not a borrow; `{v}` itself is indexed safely");
            let mut end = NODES[n].end;
            let assign = ASSIGNING;
            if assign != 0 && NODES[assign].b == n {
                end = NODES[assign].end;
                for c in SRC[NODES[n].end..end] {
                    if c == '\n' {
                        end = NODES[n].end;
                    }
                }
            }
            err_try_fmt(f"{v}{SRC[NODES[base].end..end]}");
            let t = buf_new();
            buf_fmt(t, f"{v}");
            err_fix(NODES[base].start, NODES[base].end, buf_slice(t));
        } else {
            err_help_fmt(f"`{p}` is {what}, a raw pointer, not a borrow: `{p}[i]` indexes what it points to, checked, in an `unsafe {{ ... }}` block (the try: line wraps every such place)");
            err_try_tool("fix --only unsafe", true);
        }
        err_end_soft();
        ERR_KIND = saved;
    }
}

// (0.17) `p[0]` on a pointer to anything but a Vec, a Buf or a slice,
// outside unsafe code: pointer arithmetic, where the value p points to,
// `*p`, was meant (eval iteration 10: `out[0] = acc` with `out: *i64` a
// parameter, which unsafe_op's try: wrapped in `unsafe`). Through a
// borrow `*p` is safe: the try: is the statement written with it (and
// `fix --suggested` makes it), or the read. Through a raw pointer `*p` is
// unsafe too: unsafe_op's error, its help naming `*p`.
pub fn unsafe_index_zero(n: i64, base: i64, pointee: i64) {
    if UNSAFE_DEPTH > 0 || CONST_CONTEXT {
        return;
    }
    if FIX_UNSAFE && WRAP_NODE != 0 {
        // `fix --only unsafe` makes the program check: it wraps `p[0]`,
        // which is `*p`'s value, so the code stays right
        note_unsafe_site(WRAP_NODE);
        return;
    }
    unsafe {
        if !is_borrow(base) {
            report_error_once(NODES[n].start, U_INDEX, c"unsafe",
                c"indexing a raw pointer is unsafe",
                c"`p[0]` is pointer arithmetic; the value p points to is `*p` (`*p = x` writes it), unsafe as well through a raw pointer (not a borrow: a `mut` parameter, a local, a field), so put it in an `unsafe { ... }` block (the try: line wraps every such place)",
                "fix --only unsafe");
            return;
        }
        if NODES[base].kind != Ident || NODES[base].end <= NODES[base].start {
            // `(&x)[0]`
            unsafe_op(n, U_INDEX, c"indexing a raw pointer is unsafe");
            return;
        }
        if error_keyed(NODES[n].start, U_INDEX) {
            return;
        }
        let b = SRC[NODES[base].start..NODES[base].end];
        let saved = ERR_KIND;
        ERR_KIND = c"unsafe";
        err_begin(NODES[n].start);
        err_fmt(
            f"indexing a pointer is unsafe pointer arithmetic; the value '{b}' points to is `*{b}`");
        err_help_fmt(f"`{b}[0]` indexes memory from {b}, unchecked (a borrow is one value, not an array); `*{b}` reads and writes the value it points to, safely through a borrow (a pointer parameter not `mut`, `&x`)");
        let assign = ASSIGNING;
        if assign != 0 && NODES[assign].b == n {
            let rest = SRC[NODES[n].end..NODES[assign].end];
            let mut one_line = true;
            for c in rest {
                if c == '\n' {
                    one_line = false;
                }
            }
            if one_line {
                err_try_fmt(f"*{b}{rest}");
            } else {
                err_try_fmt(f"*{b}");
            }
            let t = buf_new();
            buf_fmt(t, f"*{b}");
            err_fix(NODES[n].start, NODES[n].end, buf_slice(t));
        } else if is_numeric(pointee) || pointee == TY_BOOL {
            err_try_fmt(f"*{b}");
        } else {
            err_try_fmt(f"(*{b})");
        }
        err_end_soft();
        ERR_KIND = saved;
    }
}

// Checks expression e (synthesized when `expected` is 0) as a unit
// --fix-unsafe may wrap: a condition, a sequence, an arm's body.
pub fn check_wrapped(e: i64, expected: i64) -> i64 {
    let saved = WRAP_NODE;
    WRAP_NODE = e;
    let ty = if expected != 0 { check_expr(e, expected) } else { synth_expr(e) };
    WRAP_NODE = saved;
    ty
}

// Whether parameter node `param` is a borrow: a pointer type as written,
// not `mut`.
pub fn is_borrow_param(param: i64) -> bool {
    unsafe {
        let t = NODES[param].b;
        // (0.17: a reference parameter, `mut` or not)
        t != 0 && NODES[t].kind == TyPtr && (NODES[param].c == 0 || (NODES[t].p & NODE_REF) != 0)
    }
}

pub fn has_borrow_param(f: i64) -> bool {
    unsafe {
        if FNS[f].is_extern {
            return false;
        }
        let item = FNS[f].node;
        for i in 0..NODES[item].count {
            // (0.17: a `&T` or `&mut T` parameter is checked at the calls
            // through the value too, by its type)
            if is_borrow_param(child(item, i)) && !is_ref(fn_param(f, i)) {
                return true;
            }
        }
        false
    }
}

// Whether expression e (checked) is a borrow.
pub fn is_borrow(e: i64) -> bool {
    unsafe {
        let kind = NODES[e].kind;
        if kind == Unary && NODES[e].op == Tok::Amp {
            return true;
        }
        // (0.17) a reference: `let r = &x;`, a `&T` field or result
        if NODES[e].ty > 0 && is_ref(NODES[e].ty) {
            return true;
        }
        if kind == Ident && NODES[e].res == Res::Local && NODES[e].y >= 0 {
            return LOCALS[NODES[e].y].borrow;
        }
        false
    }
}

// (0.17, decided 2026-10-16) What type node t, as written, makes of a
// type parameter: 1 for `*P`, 2 for `[P]`, 0 otherwise. P is one of the
// parameters of Generics node `params`, or, for `params` -1, one in scope.
pub fn written_param(t: i64, params: i64) -> i64 {
    unsafe {
        if t == 0 || (NODES[t].kind != TyPtr && NODES[t].kind != TySlice) {
            return 0;
        }
        let inner = NODES[t].a;
        if inner == 0 || NODES[inner].kind != TyName || NODES[inner].g != 0
            || NODES[inner].count != 0 {
            return 0;
        }
        let name = NODES[inner].a;
        let mut found = false;
        if params < 0 {
            found = env_lookup(name) != 0;
        } else if params > 0 {
            for i in 0..NODES[params].count {
                if NODES[child(params, i)].a == name {
                    found = true;
                }
            }
        }
        if !found {
            0
        } else if NODES[t].kind == TyPtr {
            1
        } else {
            2
        }
    }
}

// (0.17, decided 2026-10-16) Whether pointer expression e (checked) points,
// as written, to a type parameter: a local or parameter `p: *T` (or one
// initialized from such an expression), a field declared `*T` in a generic
// struct, `x as *T`, the `ptr` of a local `s: [T]`. Then `p[i]` is pointer
// arithmetic for every T, a Vec's too: a generic body means one thing in
// every instance.
pub fn pointee_is_param(e: i64) -> bool {
    unsafe {
        let kind = NODES[e].kind;
        if kind == Ident && NODES[e].res == Res::Local && NODES[e].y >= 0 {
            return LOCALS[NODES[e].y].twritten == 1;
        }
        if kind == Cast {
            return written_param(NODES[e].b, -1) == 1;
        }
        if (kind == Call || kind == MethodCall) && NODES[e].x > 0 {
            // a call: its function's result as declared, `-> *T` with T a
            // parameter of the function or of its impl
            let f = NODES[e].x - 1;
            let tf = if FNS[f].tmpl > 0 { FNS[f].tmpl - 1 } else { f };
            let item = FNS[tf].node;
            return item > 0 && written_param(NODES[item].b, NODES[item].g) == 1;
        }
        if kind != FieldAccess {
            return false;
        }
        let base = NODES[e].a;
        let mut bt = NODES[base].ty;
        if bt <= 0 {
            return false;
        }
        if TYPES[bt].kind == TyKind::Slice {
            return NODES[e].b == intern_c(c"ptr") && NODES[base].kind == Ident
                && NODES[base].res == Res::Local && NODES[base].y >= 0
                && LOCALS[NODES[base].y].twritten == 2;
        }
        if TYPES[bt].kind == TyKind::Ptr {
            bt = TYPES[bt].a;
        }
        if TYPES[bt].kind != TyKind::Struct {
            return false;
        }
        let item = STRUCTS[TYPES[bt].a].node;
        if item <= 0 || NODES[item].kind != NodeKind::Struct {
            return false;
        }
        for i in 0..NODES[item].count {
            let field = child(item, i);
            if NODES[field].a == NODES[e].b {
                return written_param(NODES[field].b, NODES[item].g) == 1;
            }
        }
        false
    }
}

// Marks the place `target` (a chain of fields) as not read.
pub fn mark_no_read(target: i64) {
    unsafe {
        let mut e = target;
        while NODES[e].kind == FieldAccess || NODES[e].kind == TupleField {
            NODES[e].p |= NODE_NO_READ;
            e = NODES[e].a;
        }
    }
}

// A direct call n of function f (its arguments in n's list, from `first`
// on for the ones written after a method's receiver): calling C or an
// `unsafe fn`, and passing a raw pointer to a borrowed parameter, are
// unsafe.
pub fn check_call_safety(n: i64, f: i64, first: i64) {
    unsafe {
        // (0.16: std's functions of an ambient allocator)
        check_ambient_call(n, f);
        if FNS[f].is_extern {
            unsafe_op(n, U_C_CALL, c"calling a C function is unsafe");
            return;
        }
        if (FNS[f].attrs & FN_UNSAFE) != 0 {
            unsafe_op(n, U_UNSAFE_CALL, c"calling an `unsafe fn` is unsafe");
        }
        let item = FNS[f].node;
        let count = if NODES[n].count < NODES[item].count { NODES[n].count }
            else { NODES[item].count };
        for i in first..count {
            let arg = child(n, i);
            if is_borrow_param(child(item, i)) && !is_borrow(arg) {
                unsafe_op(arg, U_PTR_ARG, c"passing a raw pointer to a pointer parameter is unsafe (the function dereferences it as a borrow): pass `&place` or a pointer parameter");
            }
        }
    }
}
