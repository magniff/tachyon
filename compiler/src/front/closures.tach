// Closures (0.14; docs/design/closures-iterators.md): `|x| x + k`,
// `move |..| ..`, `F: Fn(A) -> R` and `F: FnMut(A) -> R` bounds.
//
// A closure is checked inline, in its enclosing function instance. Its
// type is a synthesized struct of its captures (its env, STRUCTS[s].closure
// = the closure's id + 1); its function is a synthesized Fn node (flag
// FN_CLOSURE) whose first parameter is `*Env` when it captures, appended
// to the program after the instances (CLOSURE_FNS). A call `f(x)` of a
// closure value is a direct call of that function; a non-capturing
// closure coerces to a plain `fn` type.
//
// Captures, per variable: an immutable binding by value (by reference
// above 32 bytes, or when the closure takes its address: `&x`, the
// receiver of a `self: *T` method), a `let mut` one by reference, and
// everything by value in a `move` closure. The uses of a captured variable
// in the body are rewritten, once the body is checked, to the env's field
// (`(*env).x`, or `*(*env).x` by reference), flagged NODE_CAPTURE with
// d = the local + 1.
//
// Escape: a value whose type holds a closure that borrows a variable may
// not leave the scope that variable is declared in (check_scope_exit);
// borrowed locals keep their frame slot for the whole function, so a
// borrow cannot dangle.

use crate::base::{
    FILES, FILE_COUNT, IntVec, SRC, SYMS, alloc_array, buf_byte, buf_bytes, buf_int, buf_new,
    buf_slice, buf_str, free, grow, intern, intern_c,
};
use crate::base::diag::{
    ERR_HELP, err_begin, err_end, err_help, err_help_sym, err_int, err_str, err_sym, errors_forget,
    errors_mark,
};
use crate::front::ast::{
    CLOSURE_MOVE, FN_CLOSURE, NODES, NODE_CAPTURE, NodeKind, child, list_begin, list_end, list_push,
    new_node,
};
use crate::front::check::{
    CONST_CONTEXT, CUR_FN, DEFER_LOOP_BASE, LOCALS, LOCAL_COUNT, LOOP_BASE, LOOP_STACK, RETURN_TYPE,
    Res, SELF_TYPE, TRY_RESULT, Try, attempt, check_block, define_local, mismatch_error, pop_scope,
    push_scope, type_error,
};
use crate::front::check::collect::{add_fn, new_struct};
use crate::front::check::resolve::resolve_type;
use crate::front::check::unsafety::{U_FN_VALUE, U_PTR_ARG, is_borrow, unsafe_op};
use crate::front::generics::{TP_BASE, TP_NAMES, TP_TYPES, check_arg, env_leave};
use crate::front::generics::instantiate::{UNIFY_SELF, mentions_unbound, tparam_index, unify};
use crate::front::lexer::Tok;
use crate::front::modules::{CUR_MOD, module_of};
use crate::front::parser::UNDERSCORE;
use crate::front::types::{
    ENUMS, FIELDS, FIELD_CAP, FIELD_COUNT, FNS, FN_COUNT, FieldInfo, STRUCTS, TLISTS, TSCRATCH,
    TYPES, TY_ERROR, TY_NEVER, TY_UNIT, TyKind, VARIANTS, buf_type, enum_variant, err_type,
    is_pointer, make_type, ptr_to, struct_type, type_elem, type_size,
};
use crate::middle::lower::ssa::HMap;
use std::Option;

// A closure: its Closure node, its function (FNS index), its env struct
// (STRUCTS index), the function it is in (FNS index: a function instance,
// or the function of the closure it is nested in), its captures
// (CAPTURE_LIST index of (local, by_ref) pairs, capture_count of them),
// whether it assigns a captured variable (or a part of one: not `Fn`;
// write_local is the first such variable), and the deepest local it
// borrows, directly or through what it captures (-1: none; see
// check_scope_exit).
// While its body is checked: `mark`, its first local (the env parameter;
// locals before it are captured), and where its uses and captures start
// in USES and CAPS. Once checked: its type and signature (a fn type).
pub struct ClosureInfo {
    node: i64, f: i64, env_struct: i64, encl_fn: i64, captures: i64, capture_count: i64,
    writes: bool, borrow_depth: i64, write_local: i64, mark: i64, uses: i64, caps: i64, ty: i64,
    sig: i64,
}

pub static mut CLOSURES: *ClosureInfo = 0 as *ClosureInfo;
pub static mut CLOSURE_COUNT: i64 = 0;
static mut CLOSURE_CAP: i64 = 0;
// The Fn nodes of the closures' functions, in check order: finish_program
// appends them to the program after the instances.
pub static mut CLOSURE_FNS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The closures whose bodies are being checked, innermost last (restored
// with the checker's state after an error).
pub static mut CLOSURE_STACK: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// (node, local) pairs: the uses of captured variables in the bodies being
// checked; (local, by_ref) pairs: their captures.
static mut USES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut CAPS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The captures of the closures checked, (local, by_ref) pairs.
pub static mut CAPTURE_LIST: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Whether some closure borrows a variable (check_scope_exit has work).
static mut ANY_BORROW: bool = false;
// type + 1 -> the deepest local a value of the type borrows + 2 (1 while
// being computed); see type_borrow.
static mut BORROWS: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
// The name of the env parameter, which no source can write.
static mut ENV_SYM: i64 = 0;

// What 0.14 parses but does not check yet: `error ... (check.unimplemented)`.
pub fn unimplemented(pos: i64, what: *u8) -> ! {
    err_begin(pos);
    unsafe {
        err_str(what);
        err_str(c" are not implemented yet (check.unimplemented)");
    }
    err_end()
}

// ---- Checking a closure ----

// Closure node n (in synth mode, expected = 0): its type, or `expected`
// when it is a fn type the closure coerces to.
pub fn check_closure(n: i64, expected: i64) -> i64 {
    unsafe {
        if NODES[n].x == 0 {
            if CONST_CONTEXT {
                type_error(n, c"a closure cannot be used in a constant expression");
            }
            let mark = TSCRATCH.count;
            let count = NODES[n].count;
            let mut ret = 0;
            let mut sig = 0;
            if expected != 0 && TYPES[expected].kind == TyKind::Fn && TYPES[expected].b == 0 {
                sig = expected;
            } else if expected != 0 && closure_of_type(expected) != 0 {
                sig = CLOSURES[closure_of_type(expected) - 1].sig;
            }
            if sig != 0 && TYPES[sig].count != count {
                err_begin(NODES[n].start);
                err_str(c"this closure takes ");
                err_int(count);
                err_str(if count == 1 { c" parameter, but '" } else { c" parameters, but '" });
                err_type(expected);
                err_str(c"' takes ");
                err_int(TYPES[sig].count);
                err_end();
            }
            for i in 0..count {
                TSCRATCH.push(if sig != 0 { type_elem(sig, i) } else { 0 });
            }
            if sig != 0 {
                ret = TYPES[sig].a;
            }
            check_closure_sig(n, mark, ret);
        }
        let t = CLOSURES[NODES[n].x - 1].ty;
        if expected == 0 || expected == t || expected == TY_ERROR {
            return t;
        }
        if coerce_closure(n, expected) {
            return expected;
        }
        mismatch_error(n, expected, t)
    }
}

// The signature of closure node n: its parameters' types pushed to
// TSCRATCH from `mark` (popped; 0: unknown, from the parameter's type
// written), its result `ret` (0: from the body); its fn type. The body is
// checked here, once.
pub fn check_closure_sig(n: i64, mark: i64, ret: i64) -> i64 {
    unsafe {
        if ENV_SYM == 0 {
            ENV_SYM = intern_c(c"{env}");
        }
        let count = NODES[n].count;
        let tys = alloc_array::<i64>(count + 1);
        for i in 0..count {
            let param = child(n, i);
            let wanted = if mark + i < TSCRATCH.count { TSCRATCH.data[mark + i] } else { 0 };
            let mut t = wanted;
            if NODES[param].b != 0 {
                t = resolve_type(NODES[param].b);
                if wanted != 0 && wanted != t && wanted != TY_ERROR && t != TY_ERROR {
                    mismatch_error(NODES[param].b, wanted, t);
                }
            } else if wanted == 0 {
                infer_param_error(param);
            }
            tys[i] = t;
        }
        TSCRATCH.count = mark;
        let mut result = ret;
        if NODES[n].b != 0 {
            let written = resolve_type(NODES[n].b);
            if ret != 0 && ret != written && ret != TY_ERROR && written != TY_ERROR {
                mismatch_error(NODES[n].b, ret, written);
            }
            result = written;
        }
        let body = NODES[n].a;
        if result == 0 {
            let r = find_return(body);
            if r != 0 {
                err_begin(NODES[r].start);
                err_str(c"a closure with 'return' needs its result type written");
                err_help(c"write it: '|...| -> T { ... }'");
                err_end();
            }
        }
        let id = new_closure(n);
        let f = CLOSURES[id].f;
        // The body, as the closure's function: its own result type, and no
        // loop or deferred statement around it to leave.
        CLOSURE_STACK.push(id);
        let saved_ret = RETURN_TYPE;
        let saved_defer = DEFER_LOOP_BASE;
        let saved_base = LOOP_BASE;
        RETURN_TYPE = if result != 0 { result } else { TY_UNIT };
        DEFER_LOOP_BASE = -1;
        LOOP_BASE = LOOP_STACK.count;
        push_scope();
        let env = define_local(ENV_SYM, 0, false, true);
        LOCALS[env].borrow = true;
        CLOSURES[id].mark = env;
        CLOSURES[id].uses = USES.count;
        CLOSURES[id].caps = CAPS.count;
        // The function's parameters: the closure's, a pattern bound by a
        // `let` at the start of the body from a hidden parameter.
        let params = alloc_array::<i64>(count + 1);
        let lets = list_begin();
        let mut has_lets = false;
        for i in 0..count {
            let param = child(n, i);
            if NODES[param].d == 0 {
                params[i] = param;
                if NODES[param].a == UNDERSCORE {
                    NODES[param].x = -1;
                    continue;
                }
                let mutable = NODES[param].c != 0;
                NODES[param].x = define_local(NODES[param].a, tys[i], mutable, true);
                LOCALS[NODES[param].x].borrow = !mutable && is_pointer(tys[i]);
                continue;
            }
            let start = NODES[param].start;
            let end = NODES[param].end;
            let out = buf_new();
            buf_str(out, c"{param");
            buf_int(out, i);
            buf_byte(out, '}');
            let name = intern(buf_slice(out));
            let hidden = new_node(NodeKind::Param, start, end);
            NODES[hidden].a = name;
            NODES[hidden].x = define_local(name, tys[i], false, true);
            params[i] = hidden;
            let init = new_node(NodeKind::Ident, start, end);
            NODES[init].a = name;
            let binding = new_node(NodeKind::Let, start, end);
            NODES[binding].a = NODES[param].d;
            NODES[binding].c = init;
            list_push(binding);
            has_lets = true;
        }
        let mut fn_body = body;
        if has_lets || NODES[body].kind != NodeKind::Block {
            fn_body = new_node(NodeKind::Block, NODES[body].start, NODES[body].end);
            NODES[fn_body].a = body;
            list_end(fn_body, lets);
        }
        let body_ty = check_block(fn_body, result);
        if result == 0 {
            result = if body_ty == TY_NEVER { TY_UNIT } else { body_ty };
        } else if body_ty != result && body_ty != TY_NEVER && body_ty != TY_ERROR
            && result != TY_ERROR {
            err_begin(NODES[body].start);
            err_str(c"the closure's body has type '");
            err_type(body_ty);
            err_str(c"', expected '");
            err_type(result);
            err_str(c"'");
            err_end();
        }
        pop_scope();
        RETURN_TYPE = saved_ret;
        DEFER_LOOP_BASE = saved_defer;
        LOOP_BASE = saved_base;
        CLOSURE_STACK.count -= 1;
        // (what it returns may not borrow its own locals)
        check_scope_exit(result, env, NODES[body].start);
        finish_closure(id, fn_body, params, tys, result);
        free(params as *u8);
        free(tys as *u8);
        CLOSURES[id].sig
    }
}

fn infer_param_error(param: i64) -> ! {
    unsafe {
        err_begin(NODES[param].start);
        if NODES[param].d == 0 {
            err_str(c"cannot infer the type of closure parameter '");
            err_sym(NODES[param].a);
            err_str(c"'");
            err_help(c"write its type: '|");
            err_help_sym(NODES[param].a);
            err_help(c": i64| ...'");
        } else {
            err_str(c"cannot infer the type of this closure parameter");
            err_help(c"write its type: '|(a, b): (i64, i64)| ...'");
        }
        err_end()
    }
}

// A new closure for node n, with its function (its signature is set by
// finish_closure).
fn new_closure(n: i64) -> i64 {
    unsafe {
        CLOSURES = grow(CLOSURES, CLOSURE_COUNT, &CLOSURE_CAP);
        let id = CLOSURE_COUNT;
        CLOSURE_COUNT += 1;
        let encl = if CLOSURE_STACK.count > 0 {
            CLOSURES[CLOSURE_STACK.data[CLOSURE_STACK.count - 1]].f
        } else {
            CUR_FN
        };
        // Its symbol: closure k of the function with symbol S is `S.k`.
        let mut k = 0;
        for i in 0..id {
            if CLOSURES[i].encl_fn == encl {
                k += 1;
            }
        }
        let out = buf_new();
        if encl >= 0 {
            buf_bytes(out, SYMS[FNS[encl].name].text);
        } else {
            buf_str(out, c"closure");
        }
        buf_byte(out, '.');
        buf_int(out, k);
        let sym = intern(buf_slice(out));
        let item = new_node(NodeKind::Fn, NODES[n].start, NODES[n].end);
        NODES[item].a = sym;
        NODES[item].p = FN_CLOSURE;
        add_fn(item, sym, sym);
        let f = FN_COUNT - 1;
        FNS[f].module = CUR_MOD;
        CLOSURES[id] = ClosureInfo {
            node: n, f: f, env_struct: -1, encl_fn: encl, captures: 0, capture_count: 0,
            writes: false, borrow_depth: -1, write_local: -1, mark: LOCAL_COUNT, uses: USES.count,
            caps: CAPS.count, ty: 0, sig: 0,
        };
        id
    }
}

// After the body of closure `id`: its captures and their modes, its env
// struct and type, the uses rewritten, the env literal its node lowers
// to, and its function's signature.
fn finish_closure(id: i64, fn_body: i64, params: *i64, tys: *i64, result: i64) {
    unsafe {
        let n = CLOSURES[id].node;
        let f = CLOSURES[id].f;
        let env = CLOSURES[id].mark;
        let is_move = (NODES[n].c & CLOSURE_MOVE) != 0;
        if !is_move {
            upgrade_captures(id, fn_body);
        }
        // The signature.
        let count = NODES[n].count;
        let sig_mark = TSCRATCH.count;
        for i in 0..count {
            TSCRATCH.push(tys[i]);
        }
        let sig = make_type(TyKind::Fn, result, 0, sig_mark);
        CLOSURES[id].sig = sig;
        // The captures, kept; the env struct.
        let caps = CLOSURES[id].caps;
        let capture_count = (CAPS.count - caps) / 2;
        CLOSURES[id].captures = CAPTURE_LIST.count;
        CLOSURES[id].capture_count = capture_count;
        for i in caps..CAPS.count {
            CAPTURE_LIST.push(CAPS.data[i]);
        }
        let s = new_struct(n, closure_name(n, sig), FNS[f].name, CUR_MOD);
        STRUCTS[s].repr = 0;
        STRUCTS[s].align = 0;
        STRUCTS[s].closure = id + 1;
        STRUCTS[s].fields = FIELD_COUNT;
        STRUCTS[s].field_count = capture_count;
        let mut borrow = -1;
        for j in 0..capture_count {
            let local = CAPTURE_LIST.data[CLOSURES[id].captures + 2 * j];
            let by_ref = CAPTURE_LIST.data[CLOSURES[id].captures + 2 * j + 1] != 0;
            let local_ty = LOCALS[local].ty;
            let field_ty = if by_ref { ptr_to(local_ty) } else { local_ty };
            FIELDS = grow(FIELDS, FIELD_COUNT, &FIELD_CAP);
            FIELDS[FIELD_COUNT] = FieldInfo { name: LOCALS[local].name, ty: field_ty, offset: 0 };
            FIELD_COUNT += 1;
            let b = if by_ref { local } else { type_borrow(local_ty) };
            if b > borrow {
                borrow = b;
            }
        }
        let ty = struct_type(s);
        CLOSURES[id].env_struct = s;
        CLOSURES[id].ty = ty;
        CLOSURES[id].borrow_depth = borrow;
        if borrow >= 0 {
            ANY_BORROW = true;
        }
        let env_ty = ptr_to(ty);
        LOCALS[env].ty = env_ty;
        // The uses, rewritten to the env's fields.
        let mut u = CLOSURES[id].uses;
        while u < USES.count {
            rewrite_use(id, USES.data[u], USES.data[u + 1], env, env_ty);
            u += 2;
        }
        // Done with the body: what is left on the stacks is the enclosing
        // closure's.
        USES.count = CLOSURES[id].uses;
        CAPS.count = caps;
        // The env literal, whose uses are the enclosing closure's.
        let start = NODES[n].start;
        let end = NODES[n].end;
        let lit = new_node(NodeKind::StructLit, start, end);
        let inits = list_begin();
        for j in 0..capture_count {
            let local = CAPTURE_LIST.data[CLOSURES[id].captures + 2 * j];
            let by_ref = CAPTURE_LIST.data[CLOSURES[id].captures + 2 * j + 1] != 0;
            let ident = new_node(NodeKind::Ident, start, end);
            NODES[ident].a = LOCALS[local].name;
            NODES[ident].res = Res::Local;
            NODES[ident].y = local;
            NODES[ident].ty = LOCALS[local].ty;
            let mut value = ident;
            if by_ref {
                value = new_node(NodeKind::Unary, start, end);
                NODES[value].op = Tok::Amp;
                NODES[value].b = ident;
                NODES[value].ty = ptr_to(LOCALS[local].ty);
            }
            let init = new_node(NodeKind::FieldInit, start, end);
            NODES[init].a = LOCALS[local].name;
            NODES[init].b = value;
            NODES[init].x = j;
            NODES[init].ty = (*struct_field_of(s, j)).ty;
            list_push(init);
            note_local_use(ident, local);
        }
        list_end(lit, inits);
        NODES[lit].ty = ty;
        NODES[n].x = id + 1;
        NODES[n].y = lit;
        NODES[n].ty = ty;
        // The function: [env: *Env] when it captures, then the parameters.
        let item = FNS[f].node;
        let mark = list_begin();
        let types = TSCRATCH.count;
        if capture_count > 0 {
            let env_param = new_node(NodeKind::Param, start, end);
            NODES[env_param].a = ENV_SYM;
            NODES[env_param].x = env;
            list_push(env_param);
            TSCRATCH.push(env_ty);
        }
        for i in 0..count {
            list_push(params[i]);
            TSCRATCH.push(tys[i]);
        }
        list_end(item, mark);
        FNS[f].params = TLISTS.count;
        FNS[f].param_count = TSCRATCH.count - types;
        for i in types..TSCRATCH.count {
            TLISTS.push(TSCRATCH.data[i]);
        }
        TSCRATCH.count = types;
        FNS[f].ret = result;
        FNS[f].display = STRUCTS[s].name;
        NODES[item].c = fn_body;
        CLOSURE_FNS.push(item);
    }
}

fn struct_field_of(s: i64, i: i64) -> *FieldInfo {
    unsafe { &FIELDS[STRUCTS[s].fields + i] }
}

// `closure(i64) -> i64 at f.tach:4:15`: the name of a closure's type.
fn closure_name(n: i64, sig: i64) -> i64 {
    unsafe {
        let out = buf_new();
        buf_str(out, c"closure(");
        for i in 0..TYPES[sig].count {
            if i > 0 {
                buf_str(out, c", ");
            }
            buf_type(out, type_elem(sig, i));
        }
        buf_str(out, c") -> ");
        buf_type(out, TYPES[sig].a);
        buf_str(out, c" at ");
        let pos = NODES[n].start;
        let mut file = 0;
        while file + 1 < FILE_COUNT && pos >= FILES[file + 1].start {
            file += 1;
        }
        let mut line = 1;
        let mut col = 1;
        let mut i = FILES[file].start;
        while i < pos {
            if SRC[i] == '\n' {
                line += 1;
                col = 1;
            } else {
                col += 1;
            }
            i += 1;
        }
        buf_str(out, FILES[file].path);
        buf_byte(out, ':');
        buf_int(out, line);
        buf_byte(out, ':');
        buf_int(out, col);
        intern(buf_slice(out))
    }
}

// A use of a captured local, Ident node `node`, becomes `(*env).x` (by
// value) or `*(*env).x` (by reference).
fn rewrite_use(id: i64, node: i64, local: i64, env: i64, env_ty: i64) {
    unsafe {
        if NODES[node].kind != NodeKind::Ident || NODES[node].res != Res::Local
            || NODES[node].y != local {
            return;
        }
        let mut j = 0;
        while j < CLOSURES[id].capture_count
            && CAPTURE_LIST.data[CLOSURES[id].captures + 2 * j] != local {
            j += 1;
        }
        let by_ref = CAPTURE_LIST.data[CLOSURES[id].captures + 2 * j + 1] != 0;
        let start = NODES[node].start;
        let end = NODES[node].end;
        let base = new_node(NodeKind::Ident, start, end);
        NODES[base].a = ENV_SYM;
        NODES[base].res = Res::Local;
        NODES[base].y = env;
        NODES[base].ty = env_ty;
        let name = LOCALS[local].name;
        let mut field = node;
        if by_ref {
            field = new_node(NodeKind::FieldAccess, start, end);
            NODES[field].ty = ptr_to(LOCALS[local].ty);
            NODES[node].kind = NodeKind::Unary;
            NODES[node].op = Tok::Star;
            NODES[node].a = 0;
            NODES[node].b = field;
        } else {
            NODES[node].kind = NodeKind::FieldAccess;
        }
        NODES[field].a = base;
        NODES[field].b = name;
        NODES[field].x = j;
        NODES[field].y = 1;
        NODES[node].res = Res::None;
        NODES[node].p |= NODE_CAPTURE;
        NODES[node].d = local + 1;
    }
}

// ---- Captures ----

// A use of local `local` by Ident n (synth_name): a capture when it is
// declared outside the closure being checked.
pub fn note_local_use(n: i64, local: i64) {
    unsafe {
        if CLOSURE_STACK.count == 0 {
            return;
        }
        let id = CLOSURE_STACK.data[CLOSURE_STACK.count - 1];
        if local >= CLOSURES[id].mark {
            return;
        }
        USES.push(n);
        USES.push(local);
        let mut i = CLOSURES[id].caps;
        while i < CAPS.count {
            if CAPS.data[i] == local {
                return;
            }
            i += 2;
        }
        CAPS.push(local);
        CAPS.push(if captured_by_ref(id, local) { 1 } else { 0 });
    }
}

// The mode of a capture, per variable: see the header.
fn captured_by_ref(id: i64, local: i64) -> bool {
    unsafe {
        if (NODES[CLOSURES[id].node].c & CLOSURE_MOVE) != 0 {
            return false;
        }
        if LOCALS[local].mutable {
            return true;
        }
        let t = LOCALS[local].ty;
        t != 0 && t != TY_ERROR && type_size(t) > 32
    }
}

// An assignment to local `local` or to a part of it (check_assign): the
// closures that capture it write it.
pub fn note_local_write(local: i64) {
    unsafe {
        for i in 0..CLOSURE_STACK.count {
            let id = CLOSURE_STACK.data[i];
            if local < CLOSURES[id].mark {
                CLOSURES[id].writes = true;
                if CLOSURES[id].write_local < 0 {
                    CLOSURES[id].write_local = local;
                }
            }
        }
    }
}

// An immutable variable the closure takes the address of (`&x`, `&x.f`,
// the receiver of a `self: *T` method) may be changed through it: it is
// captured by reference, so that the change is the variable's.
fn upgrade_captures(id: i64, n: i64) {
    unsafe {
        if n == 0 {
            return;
        }
        let kind = NODES[n].kind;
        // (not the `&f` of a call of a captured closure f that keeps no
        // state of its own: a copy is called the same)
        let operand = if kind == NodeKind::Unary { NODES[n].b } else { 0 };
        let callee = if operand != 0 { closure_of_type(NODES[operand].ty) } else { 0 };
        if kind == NodeKind::Unary && NODES[n].op == Tok::Amp
            && (callee == 0 || CLOSURES[callee - 1].writes) {
            let mut place = operand;
            while NODES[place].kind == NodeKind::FieldAccess && NODES[place].y == 0
                || NODES[place].kind == NodeKind::TupleField
                || NODES[place].kind == NodeKind::Index && NODES[NODES[place].a].ty != 0
                && TYPES[NODES[NODES[place].a].ty].kind == TyKind::Array {
                place = NODES[place].a;
            }
            if NODES[place].kind == NodeKind::Ident && NODES[place].res == Res::Local {
                let local = NODES[place].y;
                let mut i = CLOSURES[id].caps;
                while i < CAPS.count {
                    if CAPS.data[i] == local {
                        CAPS.data[i + 1] = 1;
                    }
                    i += 2;
                }
            }
        }
        if kind == NodeKind::Closure {
            // (its env literal: what it borrows, this closure must too)
            upgrade_captures(id, NODES[n].y);
            return;
        }
        walk_kids(n, id, false);
    }
}

// The first `return` in expression n, not inside a nested closure (0:
// none).
fn find_return(n: i64) -> i64 {
    unsafe {
        if n == 0 || NODES[n].kind == NodeKind::Closure {
            return 0;
        }
        if NODES[n].kind == NodeKind::Return {
            return n;
        }
        walk_kids(n, 0, true)
    }
}

// The expressions and statements under n (not its patterns or types):
// find_return for each (the first found), or upgrade_captures of closure
// `id`.
fn walk_kids(n: i64, id: i64, returns: bool) -> i64 {
    unsafe {
        let kind = NODES[n].kind;
        let mut kids: [i64; 4] = [0; 4];
        match kind {
            NodeKind::Cast | NodeKind::Return | NodeKind::ExprStmt
                | NodeKind::Call | NodeKind::Match | NodeKind::MethodCall | NodeKind::FieldAccess
                | NodeKind::TupleField | NodeKind::Block | NodeKind::EnumPanic | NodeKind::Defer
                | NodeKind::VecOp => kids[0] = NODES[n].a,
            NodeKind::Index | NodeKind::Repeat | NodeKind::Range => {
                kids[0] = NODES[n].a;
                kids[1] = NODES[n].b;
            }
            NodeKind::If => {
                kids[0] = NODES[n].a;
                kids[1] = NODES[n].b;
                kids[2] = NODES[n].c;
            }
            NodeKind::Loop | NodeKind::Break | NodeKind::Unary | NodeKind::FieldInit => {
                kids[0] = NODES[n].b;
            }
            NodeKind::While | NodeKind::Assign | NodeKind::Binary => {
                kids[0] = NODES[n].b;
                kids[1] = NODES[n].c;
            }
            NodeKind::Let => kids[0] = NODES[n].c,
            NodeKind::Arm => {
                kids[0] = NODES[n].b;
                kids[1] = NODES[n].c;
            }
            NodeKind::For => {
                kids[0] = NODES[n].c;
                kids[1] = NODES[n].d;
            }
            _ => {}
        }
        for k in 0..4 {
            if kids[k] != 0 {
                if returns {
                    let r = find_return(kids[k]);
                    if r != 0 {
                        return r;
                    }
                } else {
                    upgrade_captures(id, kids[k]);
                }
            }
        }
        match kind {
            NodeKind::Call | NodeKind::MethodCall | NodeKind::Block | NodeKind::Match
                | NodeKind::Tuple | NodeKind::Array | NodeKind::StructLit | NodeKind::VariantLit
                | NodeKind::VecOp => {
                for i in 0..NODES[n].count {
                    if returns {
                        let r = find_return(child(n, i));
                        if r != 0 {
                            return r;
                        }
                    } else {
                        upgrade_captures(id, child(n, i));
                    }
                }
            }
            _ => {}
        }
        0
    }
}

// ---- Types and calls ----

// The closure (its id + 1) whose type t is, or 0.
pub fn closure_of_type(t: i64) -> i64 {
    unsafe {
        if t <= 0 || TYPES[t].kind != TyKind::Struct {
            return 0;
        }
        STRUCTS[TYPES[t].a].closure
    }
}

// The fn type of closure c (its id): `fn(params) -> result`, without the
// env.
pub fn closure_sig(c: i64) -> i64 {
    unsafe { CLOSURES[c].sig }
}

// Call n of a value of closure type `ty` (synth_call): a direct call of
// the closure's function, with `&callee` first when it captures; its
// result type.
pub fn closure_call(n: i64, ty: i64) -> i64 {
    unsafe {
        let c = closure_of_type(ty) - 1;
        let sig = CLOSURES[c].sig;
        let f = CLOSURES[c].f;
        let count = NODES[n].count;
        if count != TYPES[sig].count {
            err_begin(NODES[n].start);
            err_str(c"this closure takes ");
            err_int(TYPES[sig].count);
            err_str(c" arguments, got ");
            err_int(count);
            err_end();
        }
        let callee = NODES[n].a;
        let mark = list_begin();
        if CLOSURES[c].capture_count > 0 {
            let env = new_node(NodeKind::Unary, NODES[callee].start, NODES[callee].end);
            NODES[env].op = Tok::Amp;
            NODES[env].b = callee;
            NODES[env].ty = ptr_to(ty);
            list_push(env);
        }
        let node = CLOSURES[c].node;
        for i in 0..count {
            let arg = child(n, i);
            let param_ty = type_elem(sig, i);
            check_arg(arg, param_ty);
            let param = child(node, i);
            if is_pointer(param_ty) && NODES[param].d == 0 && NODES[param].c == 0
                && !is_borrow(arg) {
                unsafe_op(arg, U_PTR_ARG, c"passing a raw pointer to a closure's pointer parameter is unsafe (the closure dereferences it as a borrow): pass `&place` or a pointer parameter");
            }
            list_push(arg);
        }
        list_end(n, mark);
        NODES[n].a = 0;
        NODES[n].x = f + 1;
        TYPES[sig].a
    }
}

// Expression n, of a closure type, where fn type `expected` is wanted:
// whether it coerces (a non-capturing closure becomes its function). A
// capturing closure is an error.
pub fn coerce_closure(n: i64, expected: i64) -> bool {
    unsafe {
        if expected <= 0 || TYPES[expected].kind != TyKind::Fn || TYPES[expected].b != 0 {
            return false;
        }
        let c = closure_of_type(NODES[n].ty) - 1;
        if c < 0 || CLOSURES[c].sig != expected {
            return false;
        }
        if CLOSURES[c].capture_count > 0 {
            err_begin(NODES[n].start);
            err_str(c"a closure that captures variables cannot be a '");
            err_type(expected);
            err_str(c"' (it captures '");
            err_sym(LOCALS[CAPTURE_LIST.data[CLOSURES[c].captures]].name);
            err_str(c"')");
            err_help(c"make the parameter generic: `fn apply<F: Fn(");
            for i in 0..TYPES[expected].count {
                if i > 0 {
                    err_help(c", ");
                }
                buf_type(ERR_HELP, type_elem(expected, i));
            }
            err_help(c") -> ");
            buf_type(ERR_HELP, TYPES[expected].a);
            err_help(c">(f: F)`");
            err_end();
        }
        let f = CLOSURES[c].f;
        let node = CLOSURES[c].node;
        for i in 0..NODES[node].count {
            let param = child(node, i);
            if is_pointer(type_elem(expected, i)) && NODES[param].d == 0 && NODES[param].c == 0 {
                unsafe_op(n, U_FN_VALUE, c"using a closure with pointer parameters as a 'fn' value is unsafe (its callers are not checked)");
                break;
            }
        }
        let value = new_node(NodeKind::Ident, NODES[n].start, NODES[n].end);
        NODES[value].a = FNS[f].name;
        NODES[value].res = Res::Fn;
        NODES[value].y = f;
        NODES[value].ty = expected;
        let kind = NODES[n].kind;
        if kind == NodeKind::Closure {
            NODES[n].y = value;
        } else if kind == NodeKind::Ident {
            // (a variable holding the closure: nothing to evaluate)
            NODES[n] = NODES[value];
        } else {
            // `{ n; f }`
            let copy = new_node(kind, NODES[n].start, NODES[n].end);
            NODES[copy] = NODES[n];
            let stmt = new_node(NodeKind::ExprStmt, NODES[n].start, NODES[n].end);
            NODES[stmt].a = copy;
            NODES[stmt].b = 1;
            let block = new_node(NodeKind::Block, NODES[n].start, NODES[n].end);
            let mark = list_begin();
            list_push(stmt);
            list_end(block, mark);
            NODES[block].a = value;
            NODES[block].ty = expected;
            NODES[n] = NODES[block];
        }
        true
    }
}

// ---- Fn bounds ----

// Type node n resolved, or 0 when it names nothing here (no error).
fn resolve_quietly(n: i64) -> i64 {
    let mark = errors_mark();
    if attempt(Try::Type, n) {
        return TRY_RESULT;
    }
    errors_forget(mark);
    0
}

// The fn type bound `bound` (a TyFn node) stands for, in the current
// scope of type parameters; 0 when a part of it is unknown.
fn bound_sig(bound: i64) -> i64 {
    unsafe {
        let saved = CUR_MOD;
        CUR_MOD = module_of(bound);
        let mark = TSCRATCH.count;
        let mut known = true;
        for i in 0..NODES[bound].count {
            let t = resolve_quietly(child(bound, i));
            known = known && t != 0;
            TSCRATCH.push(t);
        }
        let ret = resolve_quietly(NODES[bound].a);
        CUR_MOD = saved;
        if !known || ret == 0 {
            TSCRATCH.count = mark;
            return 0;
        }
        make_type(TyKind::Fn, ret, 0, mark)
    }
}

// The fn type of a value of type t a bound can take: a closure's
// signature, or a plain fn type; 0.
fn callable_sig(t: i64) -> i64 {
    unsafe {
        let c = closure_of_type(t);
        if c != 0 {
            return CLOSURES[c - 1].sig;
        }
        if t > 0 && TYPES[t].kind == TyKind::Fn && TYPES[t].b == 0 {
            return t;
        }
        0
    }
}

// Whether type t satisfies the bound `bound` (a TyFn node, d = 2 for
// `Fn`, 3 for `FnMut`), its type parameters in scope.
pub fn fn_bound_satisfied(bound: i64, t: i64) -> bool {
    unsafe {
        if t == TY_ERROR {
            return true;
        }
        let sig = callable_sig(t);
        if sig == 0 || TYPES[sig].count != NODES[bound].count {
            return false;
        }
        let c = closure_of_type(t);
        if NODES[bound].d == 2 && c != 0 && CLOSURES[c - 1].writes {
            return false;
        }
        let wanted = bound_sig(bound);
        wanted == 0 || wanted == sig
    }
}

// The error for a type t that does not satisfy bound `bound` of
// parameter `param` (a name) of generic item `what`, at pos.
pub fn fn_bound_error(bound: i64, t: i64, param: i64, what: i64, pos: i64) -> ! {
    unsafe {
        let c = closure_of_type(t);
        let sig = callable_sig(t);
        let wanted = bound_sig(bound);
        err_begin(pos);
        if c != 0 && NODES[bound].d == 2 && CLOSURES[c - 1].writes
            && (wanted == 0 || wanted == sig) {
            err_str(c"the closure assigns to '");
            err_sym(LOCALS[CLOSURES[c - 1].write_local].name);
            err_str(c"', so it is not 'Fn' as the bound of '");
            err_sym(param);
            err_str(c"' of '");
            err_sym(what);
            err_str(c"' asks");
            err_help(c"make the bound 'FnMut(...)', or do not assign to captured variables in the closure");
            err_end();
        }
        err_str(c"the type '");
        err_type(t);
        err_str(c"' does not satisfy the bound '");
        err_sym(param);
        err_str(if NODES[bound].d == 2 { c": Fn" } else { c": FnMut" });
        if wanted != 0 {
            err_str(c"(");
            for i in 0..TYPES[wanted].count {
                if i > 0 {
                    err_str(c", ");
                }
                err_type(type_elem(wanted, i));
            }
            err_str(c") -> ");
            err_type(TYPES[wanted].a);
        } else {
            err_str(c"(...)");
        }
        err_str(c"' of '");
        err_sym(what);
        err_str(c"'");
        if sig == 0 {
            err_help(c"pass a closure or a function");
        }
        err_end()
    }
}

// The Fn or FnMut bound of type parameter k of `params` (0: none).
fn fn_bound_of(params: i64, k: i64) -> i64 {
    unsafe {
        let bounds = NODES[child(params, k)].h;
        if bounds == 0 {
            return 0;
        }
        for i in 0..NODES[bounds].count {
            let b = child(bounds, i);
            if NODES[b].kind == NodeKind::TyFn && NODES[b].d >= 2 {
                return b;
            }
        }
        0
    }
}

// Whether argument `arg` is inferred last (infer_from's third pass): a
// closure, whose parameter types come from its parameter's bound.
pub fn is_deferred_arg(arg: i64) -> bool {
    unsafe { NODES[arg].kind == NodeKind::Closure && NODES[arg].x == 0 }
}

// infer_from's third pass (and infer_struct_literal's): closure `arg`
// against parameter type node `p` of a template declared in module `tmod`
// (bound[] holds what is inferred so far). Its parameter types (and
// result) come from p's `Fn` bound, as far as they are known; then it
// binds the parameter p names, and what the bound's types name.
pub fn infer_closure_arg(params: i64, bound: *i64, tmod: i64, arg: i64, p: i64) {
    unsafe {
        let mut fnb = 0;
        if NODES[p].kind == NodeKind::TyName && NODES[p].count == 0 && NODES[p].g == 0 {
            match tparam_index(params, NODES[p].a) {
                Option::Some(k) => fnb = fn_bound_of(params, k),
                Option::None => {}
            }
        }
        let count = NODES[arg].count;
        let mark = TSCRATCH.count;
        let mut ret = 0;
        if fnb != 0 && NODES[fnb].count != count {
            err_begin(NODES[arg].start);
            err_str(c"this closure takes ");
            err_int(count);
            err_str(if count == 1 { c" parameter, but the bound of '" }
                else { c" parameters, but the bound of '" });
            err_sym(NODES[p].a);
            err_str(c"' takes ");
            err_int(NODES[fnb].count);
            err_end();
        }
        if fnb != 0 {
            // The bound's types, in the template's scope: its parameters
            // bound so far, its module, its `Self`.
            let saved_base = TP_BASE;
            let saved_mod = CUR_MOD;
            let saved_self = SELF_TYPE;
            TP_BASE = TP_NAMES.count;
            for k in 0..NODES[params].count {
                if bound[k] != 0 {
                    TP_NAMES.push(NODES[child(params, k)].a);
                    TP_TYPES.push(bound[k]);
                }
            }
            CUR_MOD = tmod;
            SELF_TYPE = if UNIFY_SELF != 0
                && !mentions_unbound(params, bound, UNIFY_SELF) {
                resolve_quietly(UNIFY_SELF)
            } else {
                0
            };
            for i in 0..count {
                let q = child(fnb, i);
                TSCRATCH.push(if mentions_unbound(params, bound, q) { 0 }
                    else { resolve_quietly(q) });
            }
            if !mentions_unbound(params, bound, NODES[fnb].a) {
                ret = resolve_quietly(NODES[fnb].a);
            }
            env_leave(saved_base);
            CUR_MOD = saved_mod;
            SELF_TYPE = saved_self;
        } else {
            for _ in 0..count {
                TSCRATCH.push(0);
            }
        }
        let sig = check_closure_sig(arg, mark, ret);
        let t = NODES[arg].ty;
        if !unify(params, bound, tmod, p, t) {
            err_begin(NODES[arg].start);
            err_str(c"mismatched types: this is '");
            err_type(t);
            err_str(c"', which does not fit the type parameters inferred so far");
            err_end();
        }
        if fnb != 0 {
            unify_bound(params, bound, tmod, fnb, sig);
        }
    }
}

// What the types of Fn bound `fnb` name, bound from fn type `sig`.
fn unify_bound(params: i64, bound: *i64, tmod: i64, fnb: i64, sig: i64) {
    unsafe {
        if TYPES[sig].count != NODES[fnb].count {
            return;
        }
        for i in 0..NODES[fnb].count {
            unify(params, bound, tmod, child(fnb, i), type_elem(sig, i));
        }
        unify(params, bound, tmod, NODES[fnb].a, TYPES[sig].a);
    }
}

// After the arguments (infer_from): type parameter k, bound to a closure
// or fn type, binds what its Fn bound's types name (`B` of
// `F: FnMut(A) -> B` when a function is passed for F).
pub fn infer_from_fn_bound(params: i64, bound: *i64, tmod: i64, k: i64) {
    unsafe {
        if bound[k] == 0 {
            return;
        }
        let fnb = fn_bound_of(params, k);
        if fnb == 0 {
            return;
        }
        let sig = callable_sig(bound[k]);
        if sig != 0 {
            unify_bound(params, bound, tmod, fnb, sig);
        }
    }
}

// ---- Escape ----

// The deepest local a value of type t borrows through the closures it
// holds (-1: none); memoized.
fn type_borrow(t: i64) -> i64 {
    unsafe {
        if t <= 0 || t == TY_ERROR {
            return -1;
        }
        let known = BORROWS.get(t + 1);
        if known != 0 {
            return known - 2;
        }
        BORROWS.put(t + 1, 1);
        let mut b = -1;
        let kind = TYPES[t].kind;
        if kind == TyKind::Struct {
            let s = TYPES[t].a;
            if STRUCTS[s].closure != 0 {
                b = CLOSURES[STRUCTS[s].closure - 1].borrow_depth;
            } else {
                for i in 0..STRUCTS[s].field_count {
                    b = max_of(b, type_borrow((*struct_field_of(s, i)).ty));
                }
            }
        } else if kind == TyKind::Tuple {
            for i in 0..TYPES[t].count {
                b = max_of(b, type_borrow(type_elem(t, i)));
            }
        } else if kind == TyKind::Ptr || kind == TyKind::Slice || kind == TyKind::Array {
            b = type_borrow(TYPES[t].a);
        } else if kind == TyKind::Enum {
            let e = TYPES[t].a;
            for i in 0..ENUMS[e].variant_count {
                b = max_of(b, type_borrow(VARIANTS[enum_variant(e, i)].shape));
            }
        }
        BORROWS.put(t + 1, b + 2);
        b
    }
}

fn max_of(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

// A value of type ty leaves a scope (a block's tail, a `break` value, a
// match arm's value) whose locals are those numbered from `depth` (a
// LOCAL_COUNT mark): an error at pos if it holds a closure borrowing one.
pub fn check_scope_exit(ty: i64, depth: i64, pos: i64) {
    unsafe {
        if !ANY_BORROW {
            return;
        }
        let b = type_borrow(ty);
        if b < depth {
            return;
        }
        let name = LOCALS[b].name;
        err_begin(pos);
        err_str(c"this value holds a closure that borrows '");
        err_sym(name);
        err_str(c"', which does not live outside this block");
        err_help(c"write `move`, or declare '");
        err_help_sym(name);
        err_help(c"' outside the block");
        err_end();
    }
}
