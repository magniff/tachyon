// The preprocessor's input: C source files lexed into tokens, and the
// stack of files being read (include frames, with their open `#if`s),
// with the tokens pushed back to be read again.

use crate::base::{BUFS, IntVec, buf_byte, buf_new, grow, intern, read_file};
use crate::front::cpp::{CINTS, CTOKS, CTOK_COUNT, C_EOF, S_HASH, c_error2, ctok_is, ctok_new};
use crate::front::cpp::CK::{Char, Ident, Num, Punct, Str};
use crate::front::cpp::directives::directive;
use crate::front::lexer::{is_alpha, is_digit, is_ident_byte};

// ---- The lexer ----

// `dir`: the index in CDIRS of the directory the file was found in (-1:
// found otherwise), for #include_next.
struct CFile { path: *u8, dir: i64, first: i64, end: i64 }

pub static mut CFILES: *CFile = 0 as *CFile;
static mut CFILE_COUNT: i64 = 0;
static mut CFILE_CAP: i64 = 0;

fn c_ident_byte(c: u8) -> bool {
    is_ident_byte(c) || c == '$'
}

fn c_punct_len(p: *u8, n: i64) -> i64 {
    unsafe {
        let a = p[0];
        let b = if n > 1 { p[1] } else { 0 as u8 };
        let c = if n > 2 { p[2] } else { 0 as u8 };
        if (a == '.' && b == '.' && c == '.') || (a == '<' && b == '<' && c == '=')
            || (a == '>' && b == '>' && c == '=') {
            return 3;
        }
        if (a == '-' && (b == '>' || b == '-' || b == '=')) || (a == '+' && (b == '+' || b == '='))
            || (a == '<' && (b == '<' || b == '=')) || (a == '>' && (b == '>' || b == '='))
            || (a == '=' && b == '=') || (a == '!' && b == '=')
            || (a == '&' && (b == '&' || b == '=')) || (a == '|' && (b == '|' || b == '='))
            || ((a == '*' || a == '/' || a == '%' || a == '^') && b == '=')
            || (a == '#' && b == '#') {
            return 2;
        }
        1
    }
}

// Lexes `n` bytes at `p` (lines already spliced) into tokens of file `f`;
// returns the first token's index (the tokens end at CTOK_COUNT).
pub fn c_lex(p: *u8, n: i64, f: i64, first_line: i64) -> i64 {
    unsafe {
        let first = CTOK_COUNT;
        let mut i = 0;
        let mut line = first_line;
        let mut bol = true;
        let mut space = false;
        while i < n {
            let c = p[i];
            if c == '\n' {
                line += 1;
                bol = true;
                space = false;
                i += 1;
                continue;
            }
            if c == ' ' || c == '\t' || c == '\r' || c == 12 || c == 11 {
                space = true;
                i += 1;
                continue;
            }
            if c == '/' && i + 1 < n && p[i + 1] == '/' {
                while i < n && p[i] != '\n' {
                    i += 1;
                }
                space = true;
                continue;
            }
            if c == '/' && i + 1 < n && p[i + 1] == '*' {
                i += 2;
                while i < n && !(p[i] == '*' && i + 1 < n && p[i + 1] == '/') {
                    if p[i] == '\n' {
                        line += 1;
                    }
                    i += 1;
                }
                i += 2;
                space = true;
                continue;
            }
            let start = i;
            let mut kind = Punct;
            // Prefixed literals: L"", u8"", u"", U"".
            let mut prefix = 0;
            if (c == 'L' || c == 'U' || c == 'u') && i + 1 < n
                && (p[i + 1] == '"' || p[i + 1] == '\'') {
                prefix = 1;
            }
            else if c == 'u' && i + 2 < n && p[i + 1] == '8'
                && (p[i + 2] == '"' || p[i + 2] == '\'') {
                prefix = 2;
            }
            let q = p[i + prefix];
            if (prefix > 0 || c == '"' || c == '\'') && (q == '"' || q == '\'') {
                kind = if q == '"' { Str } else { Char };
                i += prefix + 1;
                while i < n && p[i] != q && p[i] != '\n' {
                    if p[i] == '\\' && i + 1 < n {
                        i += 1;
                    }
                    i += 1;
                }
                if i < n && p[i] == q {
                    i += 1;
                }
            } else if is_digit(c) || (c == '.' && i + 1 < n && is_digit(p[i + 1])) {
                kind = Num;
                i += 1;
                while i < n {
                    let d = p[i];
                    if (d == '+' || d == '-')
                        && (p[i - 1] == 'e' || p[i - 1] == 'E' || p[i - 1] == 'p'
                            || p[i - 1] == 'P') {
                        i += 1;
                    } else if c_ident_byte(d) || d == '.' {
                        i += 1;
                    } else {
                        break;
                    }
                }
            } else if c == '_' || is_alpha(c) || c == '$' {
                kind = Ident;
                while i < n && c_ident_byte(p[i]) {
                    i += 1;
                }
            } else {
                i += c_punct_len(&p[i], n - i);
            }
            ctok_new(kind, intern(p[start..i]), f, line, space, bol);
            bol = false;
            space = false;
        }
        first
    }
}

// Reads a file and lexes it; returns its CFILES index.
pub fn c_load_file(path: *u8, dir: i64) -> i64 {
    unsafe {
        let raw = buf_new();
        read_file(path, raw);
        // Splice lines (a backslash before a newline); a spliced line's
        // newline is kept, after the logical line, so lines keep their numbers.
        let text = buf_new();
        let data = BUFS[raw].data;
        let n = BUFS[raw].len;
        let mut pending = 0;
        let mut i = 0;
        while i < n {
            if data[i] == '\\' && i + 1 < n && data[i + 1] == '\n' {
                pending += 1;
                i += 2;
                continue;
            }
            if data[i] == '\\' && i + 2 < n && data[i + 1] == '\r' && data[i + 2] == '\n' {
                pending += 1;
                i += 3;
                continue;
            }
            buf_byte(text, data[i]);
            if data[i] == '\n' {
                while pending > 0 {
                    buf_byte(text, '\n');
                    pending -= 1;
                }
            }
            i += 1;
        }
        buf_byte(text, '\n');
        CFILES = grow(CFILES, CFILE_COUNT, &CFILE_CAP);
        let f = CFILE_COUNT;
        CFILE_COUNT += 1;
        let first = c_lex(BUFS[text].data, BUFS[text].len, f, 1);
        CFILES[f] = CFile { path, dir, first, end: CTOK_COUNT };
        f
    }
}

// ---- The input: include frames, and tokens pushed back ----

pub static mut FRAME_FILE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut FRAME_POS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut FRAME_COND: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Tokens to read before the file's: the next one last.
pub static mut CPP_PENDING: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Expanding a list on its own (macro arguments, #if lines): the end of
// CPP_PENDING is the end of the input.
pub static mut CPP_LIST_MODE: bool = false;

// Conditional inclusion: per open #if, COND_TAKEN (in the branch being
// read), COND_SEARCH (no branch taken yet), COND_DONE (a branch was taken).
pub static mut CPP_CONDS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

pub fn cur_frame() -> i64 {
    FRAME_FILE.count - 1
}

pub fn push_frame(f: i64) {
    unsafe {
        if FRAME_FILE.count > 200 {
            c_error2(0, c"#include nested too deeply: ", CFILES[f].path);
        }
        FRAME_FILE.push(f);
        FRAME_POS.push(CFILES[f].first);
        FRAME_COND.push(CPP_CONDS.count);
    }
}

// The next token of the current file, or -1 at its end (no frames: EOF).
pub fn file_tok() -> i64 {
    unsafe {
        let fr = cur_frame();
        let pos = FRAME_POS.data[fr];
        if pos >= CFILES[FRAME_FILE.data[fr]].end {
            return -1;
        }
        FRAME_POS.data[fr] = pos + 1;
        pos
    }
}

pub fn file_peek() -> i64 {
    unsafe {
        let fr = cur_frame();
        let pos = FRAME_POS.data[fr];
        if pos >= CFILES[FRAME_FILE.data[fr]].end { -1 } else { pos }
    }
}

// The rest of the directive's line, as a list in CINTS (start, count).
pub fn line_tokens() -> (i64, i64) {
    let start = CINTS.count;
    loop {
        let t = file_peek();
        if unsafe { t < 0 || CTOKS[t].bol } {
            break;
        }
        file_tok();
        CINTS.push(t);
    }
    (start, CINTS.count - start)
}

pub fn skip_line() {
    loop {
        let t = file_peek();
        if unsafe { t < 0 || CTOKS[t].bol } {
            return;
        }
        file_tok();
    }
}

// The next token before macro expansion; directives are carried out.
pub fn raw_next() -> i64 {
    unsafe {
        loop {
            if CPP_PENDING.count > 0 {
                return CPP_PENDING.pop();
            }
            if CPP_LIST_MODE || FRAME_FILE.count == 0 {
                return C_EOF;
            }
            let t = file_tok();
            if t < 0 {
                if CPP_CONDS.count != FRAME_COND.data[cur_frame()] {
                    c_error2(0, c"unterminated #if in ", CFILES[FRAME_FILE.data[cur_frame()]].path);
                }
                FRAME_FILE.pop();
                FRAME_POS.pop();
                FRAME_COND.pop();
                continue;
            }
            if CTOKS[t].bol && ctok_is(t, S_HASH) && CTOKS[t].kind == Punct {
                directive(t);
                continue;
            }
            return t;
        }
    }
}

pub fn push_back(t: i64) {
    CPP_PENDING.push(t);
}

// Pushes the tokens of a list (in CINTS or scratch) to be read next.
pub fn push_list(v: *IntVec) {
    let mut i = (*v).count - 1;
    while i >= 0 {
        unsafe { CPP_PENDING.push((*v).data[i]); }
        i -= 1;
    }
}

pub fn c_load_text(path: *u8, text: i64) -> i64 {
    unsafe {
        CFILES = grow(CFILES, CFILE_COUNT, &CFILE_CAP);
        let f = CFILE_COUNT;
        CFILE_COUNT += 1;
        let first = c_lex(BUFS[text].data, BUFS[text].len, f, 1);
        CFILES[f] = CFile { path, dir: -1, first, end: CTOK_COUNT };
        f
    }
}
