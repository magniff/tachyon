// Lexer: source text to tokens. Mirrors the reference lexer
// (seed/src/lexer, the Rust compiler) token for token; `volec --tokens`
// prints the same dump as `vole tokens`.

// ---- Token kinds ----

mod strings;

// (Numbered as in 0.3: the keywords and the punctuation are kept in the
// ranges the token dump of the seed expects.)
use Tok::{
    Amp, AmpAmp, AmpEq, Arrow, As, At, Bang, BangEq, Break, CStr, Caret, CaretEq, Char, Colon,
    ColonColon, Comma, Const, Continue, Defer, Dot, DotDot, DotDotEq, Ellipsis, Else, Enum, Eof, Eq,
    EqEq, Extern, False, FatArrow, Float, Fn, For, Gt, GtEq, Hash, Ident, If, Impl, Import, In, Int,
    LBrace, LBracket, LParen, Let, Loop, Lt, LtEq, Match, Minus, MinusEq, Mod, Mut, Percent,
    PercentEq, Pipe, PipeEq, PipePipe, Plus, PlusEq, Pub, Question, RBrace, RBracket, RParen,
    Reserved, Return, Semi, Shl, ShlEq, Shr, ShrEq, Slash, SlashEq, Star, StarEq, Static, Str,
    Struct, Tilde, Trait, True, Union, Unsafe, Use, While,
};
use crate::base::{
    BUFS, SRC, alloc_array, buf_byte, buf_clear, buf_fmt, buf_hex, buf_new, buf_str, cstr, elem_at,
    grow, intern, intern_c, strtod, sym_name, sym_text,
};
use crate::base::diag::error_at;
pub use strings::{add_string, hex_value, lex_char, lex_fstring, lex_string};

pub enum Tok {
    Eof = 0, Int = 1, Float = 2, Char = 3, Str = 4, CStr = 5, Ident = 6,
    // A reserved word (`trait`, `pub`, ...): an error wherever it is used.
    Reserved = 7,
    // Keywords.
    Fn = 10, Let = 11, Mut = 12, Struct = 13, If = 14, Else = 15, Loop = 16,
    While = 17, For = 18, In = 19, Break = 20, Continue = 21, True = 22,
    False = 23, As = 24, Return = 25, Extern = 26, Const = 27, Static = 28,
    Type = 29, Enum = 30, Match = 31, Impl = 32, Union = 33, Import = 34, Use = 35,
    Pub = 36, Mod = 37, Defer = 38, Unsafe = 39,
    // Punctuation.
    PlusEq = 40, MinusEq = 41, StarEq = 42, SlashEq = 43, PercentEq = 44,
    AmpEq = 45, PipeEq = 46, CaretEq = 47, BangEq = 48, EqEq = 49, GtEq = 50,
    LtEq = 51, AmpAmp = 52, PipePipe = 53, Arrow = 54, FatArrow = 55, Shl = 56,
    Shr = 57, ShlEq = 58, ShrEq = 59, DotDot = 60, DotDotEq = 61,
    Ellipsis = 62, ColonColon = 63, Eq = 64, Plus = 65, Minus = 66, Star = 67,
    Slash = 68, Percent = 69, Caret = 70, Amp = 71, Pipe = 72, Tilde = 73,
    Bang = 74, Lt = 75, Gt = 76, Dot = 77, Comma = 78, Semi = 79, Colon = 80,
    Hash = 81, Question = 82, At = 83, LParen = 84, RParen = 85, LBrace = 86,
    RBrace = 87, LBracket = 88, RBracket = 89,
    // Keywords of 0.9 (after the punctuation, which kept its numbers).
    Trait = 90,
    // Keywords of 0.14.
    Move = 91,
    // The pieces of an f-string (0.15), `f"a{x}b{y:>4}c"`: FHead `f"a{`,
    // the tokens of the hole `x`, FMid `}b{`, the tokens of `y`, FTail
    // `:>4}c"`. `value` is the text (a string id, `{{` and `}}` unescaped);
    // an FMid or FTail has the spec of the hole it closes in `suffix` (a
    // string id, -1: none); an FHead has `suffix` 1 when the f-string has
    // no hole (the token is the whole literal).
    FHead = 92, FMid = 93, FTail = 94,
    // Keywords of 0.21 (conventions.md D27; words by position in 0.20).
    Var = 95, Inout = 96, Sink = 97,
}

// Numeric literal suffixes (0: none).
pub const SUF_NONE: i64 = 0;
pub const SUF_I8: i64 = 1;
pub const SUF_I16: i64 = 2;
pub const SUF_I32: i64 = 3;
pub const SUF_I64: i64 = 4;
pub const SUF_ISIZE: i64 = 5;
pub const SUF_U8: i64 = 6;
pub const SUF_U16: i64 = 7;
pub const SUF_U32: i64 = 8;
pub const SUF_U64: i64 = 9;
pub const SUF_USIZE: i64 = 10;
pub const SUF_F32: i64 = 11;
const SUF_F64: i64 = 12;

// `value` is the integer value, the float's bits, the character, the
// string id (Tok::Str, Tok::CStr) or the symbol (Tok::Ident, Tok::Reserved).
struct Token { kind: Tok, start: i64, end: i64, value: u64, suffix: i64, joint: bool }

pub static var TOKS: *Token = 0 as *Token;
pub static var TOK_COUNT: i64 = 0;
static var TOK_CAP: i64 = 0;

// For each symbol: the keyword it spells, Tok::Reserved, or Tok::Eof.
static var SYM_KEYWORD: *Tok = 0 as *Tok;
static var SYM_KEYWORD_COUNT: i64 = 0;
static var SUFFIX_NAME: **u8 = 0 as **u8;
// Symbol of the first suffix name; the suffixes are interned in order.
static var SUFFIX_SYM_BASE: i64 = 0;

// String literals: their bytes, by id.
pub static var STRS: *[u8] = 0 as *[u8];
pub static var STR_COUNT: i64 = 0;
static var STR_CAP: i64 = 0;

// String literal id's bytes: STRS[id] by its address (0.17: `STRS[id]`
// would index the first slice).
pub fn str_at(id: i64) -> [u8] {
    unsafe { *elem_at(STRS, id) }
}

fn add_keyword(text: *u8, kind: Tok) {
    let sym = intern_c(text);
    unsafe { SYM_KEYWORD[sym] = kind; }
}

fn add_reserved(text: *u8) {
    let sym = intern_c(text);
    unsafe { SYM_KEYWORD[sym] = Reserved; }
}

// Interns the keywords first, so their symbols are small numbers.
pub fn init_lexer() {
    SYM_KEYWORD_COUNT = 64;
    SYM_KEYWORD = alloc_array::<Tok>(SYM_KEYWORD_COUNT);
    unsafe {
        add_keyword(c"fn", Fn);
        add_keyword(c"let", Let);
        add_keyword(c"mut", Mut);
        add_keyword(c"struct", Struct);
        add_keyword(c"if", If);
        add_keyword(c"else", Else);
        add_keyword(c"loop", Loop);
        add_keyword(c"while", While);
        add_keyword(c"for", For);
        add_keyword(c"in", In);
        add_keyword(c"break", Break);
        add_keyword(c"continue", Continue);
        add_keyword(c"true", True);
        add_keyword(c"false", False);
        add_keyword(c"as", As);
        add_keyword(c"return", Return);
        add_keyword(c"extern", Extern);
        add_keyword(c"const", Const);
        add_keyword(c"static", Static);
        add_keyword(c"type", Tok::Type);
        add_keyword(c"enum", Enum);
        add_keyword(c"match", Match);
        add_keyword(c"impl", Impl);
        add_keyword(c"union", Union);
        add_keyword(c"import", Import);
        add_keyword(c"use", Use);
        add_keyword(c"pub", Pub);
        add_keyword(c"mod", Mod);
        add_keyword(c"defer", Defer);
        add_keyword(c"unsafe", Unsafe);
        add_keyword(c"trait", Trait);
        add_reserved(c"where");
        add_reserved(c"dyn");
        add_keyword(c"move", Tok::Move);
        add_keyword(c"var", Tok::Var);
        add_keyword(c"inout", Tok::Inout);
        add_keyword(c"sink", Tok::Sink);
    }
    init_suffixes();
}

impl Tok {
    // The text of a keyword or punctuation token, for messages and the token
    // dump.
    fn text(self) -> *u8 {
        match self {
            Eof => c"EOF",
            Fn => c"fn",
            Let => c"let",
            Mut => c"mut",
            Struct => c"struct",
            If => c"if",
            Else => c"else",
            Loop => c"loop",
            While => c"while",
            For => c"for",
            In => c"in",
            Break => c"break",
            Continue => c"continue",
            True => c"true",
            False => c"false",
            As => c"as",
            Return => c"return",
            Extern => c"extern",
            Const => c"const",
            Static => c"static",
            Tok::Type => c"type",
            Enum => c"enum",
            Match => c"match",
            Impl => c"impl",
            Union => c"union",
            Import => c"import",
            Use => c"use",
            Pub => c"pub",
            Mod => c"mod",
            Defer => c"defer",
            Unsafe => c"unsafe",
            Trait => c"trait",
            Tok::Move => c"move",
            Tok::Var => c"var",
            Tok::Inout => c"inout",
            Tok::Sink => c"sink",
            Tok::FHead => c"f\"",
            Tok::FMid => c"}",
            Tok::FTail => c"}",
            PlusEq => c"+=",
            MinusEq => c"-=",
            StarEq => c"*=",
            SlashEq => c"/=",
            PercentEq => c"%=",
            AmpEq => c"&=",
            PipeEq => c"|=",
            CaretEq => c"^=",
            BangEq => c"!=",
            EqEq => c"==",
            GtEq => c">=",
            LtEq => c"<=",
            AmpAmp => c"&&",
            PipePipe => c"||",
            Arrow => c"->",
            FatArrow => c"=>",
            Shl => c"<<",
            Shr => c">>",
            ShlEq => c"<<=",
            ShrEq => c">>=",
            DotDot => c"..",
            DotDotEq => c"..=",
            Ellipsis => c"...",
            ColonColon => c"::",
            Eq => c"=",
            Plus => c"+",
            Minus => c"-",
            Star => c"*",
            Slash => c"/",
            Percent => c"%",
            Caret => c"^",
            Amp => c"&",
            Pipe => c"|",
            Tilde => c"~",
            Bang => c"!",
            Lt => c"<",
            Gt => c">",
            Dot => c".",
            Comma => c",",
            Semi => c";",
            Colon => c":",
            Hash => c"#",
            Question => c"?",
            At => c"@",
            LParen => c"(",
            RParen => c")",
            LBrace => c"{",
            RBrace => c"}",
            LBracket => c"[",
            RBracket => c"]",
            // Tokens with a value: printed with it, by their users.
            _ => c"",
        }
    }

    // Keywords: printed as the identifier they are spelled with.
    fn is_keyword(self) -> bool {
        let k = self as i64;
        k >= Fn as i64 && k <= Mod as i64 || k >= Tok::Var as i64 && k <= Tok::Sink as i64
    }
}

fn init_suffixes() {
    unsafe {
        SUFFIX_NAME = alloc_array::<*u8>(13);
        SUFFIX_NAME[SUF_I8] = c"i8";
        SUFFIX_NAME[SUF_I16] = c"i16";
        SUFFIX_NAME[SUF_I32] = c"i32";
        SUFFIX_NAME[SUF_I64] = c"i64";
        SUFFIX_NAME[SUF_ISIZE] = c"isize";
        SUFFIX_NAME[SUF_U8] = c"u8";
        SUFFIX_NAME[SUF_U16] = c"u16";
        SUFFIX_NAME[SUF_U32] = c"u32";
        SUFFIX_NAME[SUF_U64] = c"u64";
        SUFFIX_NAME[SUF_USIZE] = c"usize";
        SUFFIX_NAME[SUF_F32] = c"f32";
        SUFFIX_NAME[SUF_F64] = c"f64";
        // (the symbols they had when the tools' cache restored the table)
        SUFFIX_SYM_BASE = intern_c(SUFFIX_NAME[1]);
        for suffix in 2..13 {
            intern_c(SUFFIX_NAME[suffix]);
        }
    }
}

// The suffix a symbol names, or SUF_NONE.
fn suffix_of_sym(sym: i64) -> i64 {
    if sym >= SUFFIX_SYM_BASE && sym < SUFFIX_SYM_BASE + 12 {
        return sym - SUFFIX_SYM_BASE + 1;
    }
    SUF_NONE
}

fn is_float_suffix(suffix: i64) -> bool {
    suffix == SUF_F32 || suffix == SUF_F64
}

pub fn keyword_of_sym(sym: i64) -> Tok {
    if sym < SYM_KEYWORD_COUNT { unsafe { SYM_KEYWORD[sym] } } else { Eof }
}

// ---- The lexer ----

extern "C" {
    fn memchr(s: *u8, c: i32, n: u64) -> *u8;
}

static var LEX_POS: i64 = 0;
static var LEX_END: i64 = 0;
// The previous token was '.', so a number is a tuple index (`t.0.1`).
static var LEX_AFTER_DOT: bool = false;
static var LEX_SCRATCH: i64 = -1;

// (0.25) The hot loops' byte classes (CL_ bits, by byte), and the token of
// each byte that is a token by itself and starts no longer one (Eof: not
// such a byte); made by the first lex_range.
static var BYTE_CLASS: *u8 = 0 as *u8;
static var SINGLE_TOK: *Tok = 0 as *Tok;
// ' ', '\t', '\r', '\n'
const CL_SPACE: u8 = 1;
// '_', letters, digits
const CL_IDENT: u8 = 2;
// '_', letters: an identifier's first byte
const CL_ALPHA: u8 = 4;
const CL_DIGIT: u8 = 8;
// a byte that starts a two- or three-byte operator
const CL_OP: u8 = 16;

fn init_byte_classes() {
    unsafe {
        BYTE_CLASS = alloc_array::<u8>(256);
        SINGLE_TOK = alloc_array::<Tok>(256);
        for b in 0..256 {
            let c = b as u8;
            var k: u8 = 0;
            if is_whitespace(c) {
                k |= CL_SPACE;
            }
            if is_ident_byte(c) {
                k |= CL_IDENT;
            }
            if c == '_' || is_alpha(c) {
                k |= CL_ALPHA;
            }
            if is_digit(c) {
                k |= CL_DIGIT;
            }
            BYTE_CLASS[b] = k;
            // (the bytes no two- or three-byte operator starts with)
            if two_char_operator(c, '=') == Eof && c != '<' && c != '>' && c != '&' && c != '|'
                && c != '-' && c != '.' && c != ':' {
                SINGLE_TOK[b] = one_char_operator(c);
            } else if one_char_operator(c) != Eof {
                BYTE_CLASS[b] = k | CL_OP;
            }
        }
    }
}

pub fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

pub fn is_alpha(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

pub fn is_ident_byte(c: u8) -> bool {
    c == '_' || is_alpha(c) || is_digit(c)
}

fn is_whitespace(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

// The byte at `offset` from the lexer position, 0 past the end.
fn peek_at(offset: i64) -> u8 {
    if LEX_POS + offset < LEX_END { unsafe { SRC[LEX_POS + offset] } } else { 0 }
}

fn at_end() -> bool {
    LEX_POS >= LEX_END
}

fn push_token(kind: Tok, start: i64, value: u64, suffix: i64) {
    unsafe {
        add_token(kind, start, LEX_POS, value, suffix, joint_at(SRC, BYTE_CLASS, LEX_POS, LEX_END));
    }
    LEX_AFTER_DOT = kind == Dot;
}

fn add_token(kind: Tok, start: i64, end: i64, value: u64, suffix: i64, joint: bool) {
    unsafe {
        if TOK_COUNT >= TOK_CAP {
            TOKS = grow(TOKS, TOK_COUNT, &TOK_CAP);
        }
        TOKS[TOK_COUNT] = Token { kind, start, end, value, suffix, joint };
    }
    TOK_COUNT += 1;
}

// Nothing separates the token that ends at `pos` from the next one.
fn joint_at(src: *u8, classes: *u8, pos: i64, end: i64) -> bool {
    unsafe {
        if pos >= end {
            return false;
        }
        let c = src[pos];
        if (classes[c as i64] & CL_SPACE) != 0 {
            return false;
        }
        if c == '/' && pos + 1 < end {
            let next = src[pos + 1];
            return !(next == '/' || next == '*');
        }
        true
    }
}

fn skip_whitespace_and_comments() {
    unsafe { LEX_POS = skip_blank(SRC, BYTE_CLASS, LEX_POS, LEX_END); }
}

// The position of the first byte from `pos` that is neither whitespace nor
// in a comment (`end` when none is).
fn skip_blank(src: *u8, classes: *u8, pos: i64, end: i64) -> i64 {
    unsafe {
        var p = pos;
        loop {
            while p < end && (classes[src[p] as i64] & CL_SPACE) != 0 {
                p += 1;
            }
            if p + 1 >= end || src[p] != '/' {
                return p;
            }
            let next = src[p + 1];
            if next == '/' {
                // (to the end of the line, by memchr)
                let nl = memchr(&src[p], 10, (end - p) as u64);
                p = if nl == 0 as *u8 { end } else { p + (nl as i64 - (&src[p]) as i64) };
            } else if next == '*' {
                LEX_POS = p;
                skip_block_comment();
                p = LEX_POS;
            } else {
                return p;
            }
        }
        p
    }
}

// Block comments nest.
fn skip_block_comment() {
    let start = LEX_POS;
    var depth = 0;
    while !at_end() {
        if peek_at(0) == '/' && peek_at(1) == '*' {
            depth += 1;
            LEX_POS += 2;
        } else if peek_at(0) == '*' && peek_at(1) == '/' {
            depth -= 1;
            LEX_POS += 2;
            if depth == 0 {
                return;
            }
        } else {
            LEX_POS += 1;
        }
    }
    unsafe { error_at(start, c"unterminated block comment"); }
}

// Lexes SRC[start..end) and appends its tokens; `last` adds the EOF token.
pub fn lex_range(start: i64, end: i64, last: bool) {
    if LEX_SCRATCH < 0 {
        LEX_SCRATCH = buf_new();
        init_byte_classes();
    }
    LEX_POS = start;
    LEX_END = end;
    LEX_AFTER_DOT = false;
    lex_loop();
    if last {
        push_token(Eof, LEX_POS, 0, 0);
    }
}

// (0.25) The tokens of SRC[LEX_POS..LEX_END), the position in a local:
// identifiers, keywords, punctuation and plain decimal integers here,
// the rest (strings, characters, other numbers, errors) by lex_token
// (LEX_POS set around it).
fn lex_loop() {
    unsafe {
        let src = SRC;
        let classes = BYTE_CLASS;
        let singles = SINGLE_TOK;
        let end = LEX_END;
        var pos = LEX_POS;
        while pos < end {
            var c = src[pos];
            var class = classes[c as i64];
            if (class & CL_SPACE) != 0 || c == '/' {
                pos = skip_blank(src, classes, pos, end);
                if pos >= end {
                    break;
                }
                c = src[pos];
                class = classes[c as i64];
            }
            var kind = Eof;
            var p = pos + 1;
            var value: u64 = 0;
            if (class & CL_ALPHA) != 0 {
                let next = if p < end { src[p] } else { 0 };
                if !((c == 'c' || c == 'f') && next == '"') && !(c == 'r' && next == '#') {
                    while p < end && (classes[src[p] as i64] & CL_IDENT) != 0 {
                        p += 1;
                    }
                    let sym = intern(src[pos..p]);
                    kind = Ident;
                    if sym < SYM_KEYWORD_COUNT && SYM_KEYWORD[sym] != Eof {
                        kind = SYM_KEYWORD[sym];
                    }
                    value = sym as u64;
                }
            } else {
                kind = singles[c as i64];
                if kind == Eof && (class & CL_OP) != 0 {
                    // (lex_operator, here)
                    let b = if p < end { src[p] } else { 0 };
                    if pos + 2 < end && (c == '<' || c == '>' || c == '.') {
                        kind = three_char_operator(c, b, src[pos + 2]);
                        p = pos + 3;
                    }
                    if kind == Eof && pos + 1 < end {
                        kind = two_char_operator(c, b);
                        p = pos + 2;
                    }
                    if kind == Eof {
                        kind = one_char_operator(c);
                        p = pos + 1;
                    }
                } else if kind == Eof && (class & CL_DIGIT) != 0 {
                    let after = lex_plain_integer(src, classes, pos, end);
                    if after > pos {
                        pos = after;
                        continue;
                    }
                }
            }
            if kind == Eof {
                LEX_POS = pos;
                lex_token();
                pos = LEX_POS;
                continue;
            }
            // (joint_at, here)
            var joint = false;
            if p < end {
                let d = src[p];
                joint = (classes[d as i64] & CL_SPACE) == 0
                    && !(d == '/' && p + 1 < end && (src[p + 1] == '/' || src[p + 1] == '*'));
            }
            if TOK_COUNT >= TOK_CAP {
                TOKS = grow(TOKS, TOK_COUNT, &TOK_CAP);
            }
            TOKS[TOK_COUNT] = Token { kind, start: pos, end: p, value, suffix: 0, joint };
            TOK_COUNT += 1;
            LEX_AFTER_DOT = kind == Dot;
            pos = p;
        }
        LEX_POS = pos;
    }
}

// A decimal integer without '_' or a suffix at `pos`, not a float (or a
// tuple index): its token added, its end returned; else `pos`, nothing
// added (lex_number then lexes it, and reports its errors).
fn lex_plain_integer(src: *u8, classes: *u8, pos: i64, end: i64) -> i64 {
    unsafe {
        var p = pos;
        var value: u64 = 0;
        while p < end && (classes[src[p] as i64] & CL_DIGIT) != 0 {
            let digit = (src[p] - '0') as u64;
            if value > (0xffffffffffffffff - digit) / 10 {
                return pos;
            }
            value = value * 10 + digit;
            p += 1;
        }
        if p < end {
            let c = src[p];
            if (classes[c as i64] & CL_IDENT) != 0 {
                return pos;
            }
            if c == '.' && !LEX_AFTER_DOT && p + 1 < end
                && (classes[src[p + 1] as i64] & CL_DIGIT) != 0 {
                return pos;
            }
        }
        add_token(Int, pos, p, value, 0, joint_at(src, classes, p, end));
        LEX_AFTER_DOT = false;
        p
    }
}

fn lex_token() {
    let c = peek_at(0);
    if c == '"' {
        lex_string(LEX_POS, is_c: false);
    } else if c == 'c' && peek_at(1) == '"' {
        lex_string(LEX_POS, is_c: true);
    } else if c == 'f' && peek_at(1) == '"' {
        lex_fstring(LEX_POS);
    } else if c == '\'' {
        lex_char();
    } else if is_digit(c) {
        lex_number();
    } else if c == 'r' && peek_at(1) == '#' && (peek_at(2) == '_' || is_alpha(peek_at(2))) {
        lex_raw_ident();
    } else if c == '_' || is_alpha(c) {
        lex_ident();
    } else {
        lex_operator();
    }
}

fn lex_ident() {
    let start = LEX_POS;
    while !at_end() && is_ident_byte(peek_at(0)) {
        LEX_POS += 1;
    }
    let sym = unsafe { intern(SRC[start..LEX_POS]) };
    let keyword = keyword_of_sym(sym);
    if keyword == Eof {
        push_token(Ident, start, sym as u64, 0);
    } else {
        push_token(keyword, start, sym as u64, 0);
    }
}

// `r#name`: an identifier even when `name` is a keyword (C names imported
// by `import`, for instance a field named `type`).
fn lex_raw_ident() {
    let start = LEX_POS;
    LEX_POS += 2;
    let name_start = LEX_POS;
    while !at_end() && is_ident_byte(peek_at(0)) {
        LEX_POS += 1;
    }
    unsafe { push_token(Ident, start, intern(SRC[name_start..LEX_POS]) as u64, 0); }
}

// The operators spelled by the next bytes (Tok::Eof: none).
fn three_char_operator(a: u8, b: u8, c: u8) -> Tok {
    if a == '<' && b == '<' && c == '=' { return ShlEq; }
    if a == '>' && b == '>' && c == '=' { return ShrEq; }
    if a == '.' && b == '.' && c == '.' { return Ellipsis; }
    if a == '.' && b == '.' && c == '=' { return DotDotEq; }
    Eof
}

fn two_char_operator(a: u8, b: u8) -> Tok {
    if b == '=' {
        if a == '+' { return PlusEq; }
        if a == '-' { return MinusEq; }
        if a == '*' { return StarEq; }
        if a == '/' { return SlashEq; }
        if a == '%' { return PercentEq; }
        if a == '&' { return AmpEq; }
        if a == '|' { return PipeEq; }
        if a == '^' { return CaretEq; }
        if a == '!' { return BangEq; }
        if a == '=' { return EqEq; }
        if a == '>' { return GtEq; }
        if a == '<' { return LtEq; }
        return Eof;
    }
    if a == '<' && b == '<' { return Shl; }
    if a == '>' && b == '>' { return Shr; }
    if a == '&' && b == '&' { return AmpAmp; }
    if a == '|' && b == '|' { return PipePipe; }
    if a == '-' && b == '>' { return Arrow; }
    if a == '=' && b == '>' { return FatArrow; }
    if a == '.' && b == '.' { return DotDot; }
    if a == ':' && b == ':' { return ColonColon; }
    Eof
}

fn one_char_operator(c: u8) -> Tok {
    if c == '=' { return Eq; }
    if c == '+' { return Plus; }
    if c == '-' { return Minus; }
    if c == '*' { return Star; }
    if c == '/' { return Slash; }
    if c == '%' { return Percent; }
    if c == '^' { return Caret; }
    if c == '&' { return Amp; }
    if c == '|' { return Pipe; }
    if c == '~' { return Tilde; }
    if c == '!' { return Bang; }
    if c == '<' { return Lt; }
    if c == '>' { return Gt; }
    if c == '.' { return Dot; }
    if c == ',' { return Comma; }
    if c == ';' { return Semi; }
    if c == ':' { return Colon; }
    if c == '#' { return Hash; }
    if c == '?' { return Question; }
    if c == '@' { return At; }
    if c == '(' { return LParen; }
    if c == ')' { return RParen; }
    if c == '{' { return LBrace; }
    if c == '}' { return RBrace; }
    if c == '[' { return LBracket; }
    if c == ']' { return RBracket; }
    Eof
}

fn lex_operator() {
    let start = LEX_POS;
    let end = LEX_END;
    let src = SRC;
    let a = unsafe { src[start] };
    if start + 1 < end {
        let b = unsafe { src[start + 1] };
        if start + 2 < end {
            let kind = three_char_operator(a, b, unsafe { src[start + 2] });
            if kind != Eof {
                LEX_POS = start + 3;
                push_token(kind, start, 0, 0);
                return;
            }
        }
        let kind = two_char_operator(a, b);
        if kind != Eof {
            LEX_POS = start + 2;
            push_token(kind, start, 0, 0);
            return;
        }
    }
    let kind = one_char_operator(a);
    if kind == Eof {
        unsafe { error_at(start, c"unexpected character"); }
    }
    LEX_POS += 1;
    push_token(kind, start, 0, 0);
}

// ---- Numbers ----

// A '_' may end the digits only when a suffix follows (`1_u8`).
fn check_trailing_underscore(last_underscore: bool) {
    if last_underscore && !(!at_end() && is_alpha(peek_at(0))) {
        unsafe { error_at(LEX_POS - 1, c"trailing underscore in literal"); }
    }
}

fn lex_number() {
    let start = LEX_POS;
    let second = peek_at(1);
    if peek_at(0) == '0' && (second == 'x' || second == 'X' || second == 'b' || second == 'B') {
        let radix: u64 = if second == 'x' || second == 'X' { 16 } else { 2 };
        LEX_POS += 2;
        let value = lex_radix_digits(radix);
        lex_int_suffix(value, start, false);
        return;
    }
    lex_decimal_or_float(start);
}

fn digit_value(c: u8, radix: u64) -> i64 {
    let value = hex_value(c);
    if value < 0 || value as u64 >= radix { -1 } else { value }
}

fn lex_radix_digits(radix: u64) -> u64 {
    unsafe {
        if at_end() || digit_value(peek_at(0), radix) < 0 {
            error_at(LEX_POS,
                if radix == 16 { c"expected hex digit after '0x'" }
                else { c"expected binary digit after '0b'" });
        }
        var value: u64 = 0;
        var last_underscore = false;
        let src = SRC;
        let end = LEX_END;
        var p = LEX_POS;
        while p < end {
            let c = src[p];
            if c == '_' {
                last_underscore = true;
                p += 1;
                continue;
            }
            let digit = digit_value(c, radix);
            if digit < 0 {
                break;
            }
            last_underscore = false;
            if value > (0xffffffffffffffff - digit as u64) / radix {
                error_at(p, c"literal overflow");
            }
            value = value * radix + digit as u64;
            p += 1;
        }
        LEX_POS = p;
        check_trailing_underscore(last_underscore);
        value
    }
}

// An identifier glued to a literal: its symbol, or -1.
fn read_suffix() -> i64 {
    if at_end() || !is_ident_byte(peek_at(0)) {
        return -1;
    }
    let start = LEX_POS;
    while !at_end() && is_ident_byte(peek_at(0)) {
        LEX_POS += 1;
    }
    unsafe { intern(SRC[start..LEX_POS]) }
}

fn bits_of_f64(value: f64) -> u64 {
    let copy = value;
    unsafe { *(&copy as *u64) }
}

fn lex_int_suffix(value: u64, start: i64, decimal: bool) {
    let suffix_at = LEX_POS;
    let sym = read_suffix();
    if sym < 0 {
        push_token(Int, start, value, 0);
        return;
    }
    let suffix = suffix_of_sym(sym);
    if suffix != SUF_NONE && is_float_suffix(suffix) && decimal {
        push_token(Float, start, bits_of_f64(value as f64), suffix);
        return;
    }
    if suffix != SUF_NONE && !is_float_suffix(suffix) {
        push_token(Int, start, value, suffix);
        return;
    }
    unsafe { error_at(suffix_at, c"invalid suffix on integer literal"); }
}

// Decimal digits (without '_') appended to `out`.
fn read_decimal_digits(out: i64) {
    if at_end() || !is_digit(peek_at(0)) {
        unsafe { error_at(LEX_POS, c"expected digit"); }
    }
    var last_underscore = false;
    while !at_end() {
        let c = peek_at(0);
        if c == '_' {
            last_underscore = true;
            LEX_POS += 1;
            continue;
        }
        if !is_digit(c) {
            break;
        }
        last_underscore = false;
        buf_byte(out, c);
        LEX_POS += 1;
    }
    check_trailing_underscore(last_underscore);
}

// An exponent (`e5`, `E-3`) starts here.
fn at_exponent() -> bool {
    let e = peek_at(0);
    if at_end() || !(e == 'e' || e == 'E') || LEX_POS + 1 >= LEX_END {
        return false;
    }
    let sign = peek_at(1);
    if sign == '+' || sign == '-' {
        return LEX_POS + 2 < LEX_END && is_digit(peek_at(2));
    }
    is_digit(sign)
}

fn lex_decimal_or_float(start: i64) {
    unsafe {
        let text = LEX_SCRATCH;
        buf_clear(text);
        read_decimal_digits(text);
        let has_fraction = peek_at(0) == '.' && LEX_POS + 1 < LEX_END && is_digit(peek_at(1));
        let has_exponent = at_exponent();
        if LEX_AFTER_DOT || !(has_fraction || has_exponent) {
            var value: u64 = 0;
            for i in 0..BUFS[text].len {
                let digit = (BUFS[text].data[i] - '0') as u64;
                if value > (0xffffffffffffffff - digit) / 10 {
                    error_at(LEX_POS, c"integer overflow");
                }
                value = value * 10 + digit;
            }
            lex_int_suffix(value, start, !LEX_AFTER_DOT);
            return;
        }
        if has_fraction {
            LEX_POS += 1;
            buf_byte(text, '.');
            read_decimal_digits(text);
        }
        if !at_end() && (peek_at(0) == 'e' || peek_at(0) == 'E') {
            LEX_POS += 1;
            buf_byte(text, 'e');
            if !at_end() && (peek_at(0) == '+' || peek_at(0) == '-') {
                buf_byte(text, peek_at(0));
                LEX_POS += 1;
            }
            if at_end() || !is_digit(peek_at(0)) {
                error_at(LEX_POS, c"expected digit in exponent");
            }
            read_decimal_digits(text);
        }
        buf_byte(text, 0);
        let value = strtod(BUFS[text].data, 0 as **u8);
        let suffix_at = LEX_POS;
        let sym = read_suffix();
        if sym < 0 {
            push_token(Float, start, bits_of_f64(value), 0);
            return;
        }
        let suffix = suffix_of_sym(sym);
        if suffix == SUF_NONE || !is_float_suffix(suffix) {
            error_at(suffix_at, c"invalid suffix on float literal");
        }
        push_token(Float, start, bits_of_f64(value), suffix);
    }
}

// ---- The token dump (`--tokens`) ----

pub fn dump_tokens(out: i64, base: i64) {
    unsafe {
        for i in 0..TOK_COUNT {
            let tok = &TOKS[i];
            buf_fmt(out, f"{(*tok).start - base} {(*tok).end - base} ");
            buf_byte(out, if (*tok).joint { '1' } else { '0' });
            buf_byte(out, ' ');
            dump_token_text(out, *tok);
            buf_byte(out, '\n');
        }
    }
}

fn dump_hex_bytes(out: i64, id: i64) {
    unsafe {
        for i in 0..str_at(id).len as i64 {
            buf_hex(out, str_at(id).ptr[i], 2);
        }
    }
}

fn dump_token_text(out: i64, tok: Token) {
    unsafe {
        let kind = tok.kind;
        let value = tok.value;
        if kind == Int {
            buf_fmt(out, f"int {value}");
        } else if kind == Float {
            buf_str(out, c"float ");
            buf_hex(out, value, 16);
        } else if kind == Char {
            buf_fmt(out, f"char {value}");
        } else if kind == Str {
            buf_str(out, c"str ");
            dump_hex_bytes(out, value as i64);
        } else if kind == CStr {
            buf_str(out, c"cstr ");
            dump_hex_bytes(out, value as i64);
        } else if kind == Tok::FHead || kind == Tok::FMid || kind == Tok::FTail {
            // (0.15: an f-string's pieces, the spec after the text)
            buf_str(out, if kind == Tok::FHead { c"fhead " } else if kind == Tok::FMid { c"fmid " }
                else { c"ftail " });
            dump_hex_bytes(out, value as i64);
            if kind != Tok::FHead && tok.suffix >= 0 {
                buf_str(out, c" spec ");
                dump_hex_bytes(out, tok.suffix);
            }
            return;
        } else if kind == Ident {
            buf_fmt(out, f"ident {sym_text(value as i64)}");
        } else if kind == Reserved {
            buf_str(out, sym_name(value as i64));
        } else {
            buf_str(out, kind.text());
        }
        if tok.suffix != SUF_NONE {
            buf_fmt(out, f" {cstr(SUFFIX_NAME[tok.suffix])}");
        }
    }
}
