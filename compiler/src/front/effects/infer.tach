// Effect inference (0.16; T1 makes it): one walk per checked body (local
// effects and callee edges), Tarjan's SCCs over FNS, then a bottom-up
// union (docs/design/effects-allocation.md §3). Until then every function
// is ⊤, unknown.

use crate::base::alloc_array;
use crate::front::effects::{Effects, FN_EFFECTS, FN_EFFECTS_COUNT, effects_top};
use crate::front::types::FN_COUNT;

// Fills FN_EFFECTS, after the bodies and instances are checked (called by
// check_program, before exit_if_errors).
pub fn infer_effects() {
    unsafe {
        FN_EFFECTS = alloc_array::<Effects>(FN_COUNT + 1);
        FN_EFFECTS_COUNT = FN_COUNT;
        for f in 0..FN_COUNT {
            FN_EFFECTS[f] = effects_top();
        }
    }
}
