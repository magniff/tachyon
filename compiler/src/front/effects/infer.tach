// Effect inference (0.16; docs/design/effects-allocation.md §2.1, §3):
// one walk per checked body (its local effects, and its calls as edges of
// a call graph), Tarjan's strongly connected components over that graph,
// and the union of each component's sets, callees first. A separate walk
// after checking, not checker hooks: speculative checking (`attempt`)
// would add effects that are not there. No iteration: within a component
// every member reaches every other, so all have the same set.
//
// The graph's nodes are the functions (FNS indexes: items, instances,
// closures, C functions) and, after them, virtual nodes: one per fn type
// called through a value (closed world: its edges go to every function of
// that type whose address is taken, coerced closures included) and one for
// unknown C (`alloc(extern) io global panic diverge`, and an edge to each
// address-taken `extern "C" fn` of the program: the callbacks C may call).
// An edge is one of:
//   E_CALL   the callee's effects, but not its `unsafe` (a safe function
//            encapsulates its unsafety)
//   E_ALLOC  a call of a method of `impl Allocator for X`: alloc(X) is the
//            call's local effect, and through the edge come only the raw
//            panic and diverge (refills, internal loops and panics are the
//            allocator's business: the encapsulation rule)
//   E_SCOPE  a call of arena_scope, Arena::scope or ScopedArena::scope:
//            the callee's effects without alloc(ScopedArena) (its own
//            arena: #[scoped] keeps it from escaping), with the parent's
//            allocator (SCOPE_ADD): discharge
// A component with a cycle (recursion) also gets `diverge`.
//
// The local effects (walk): a `static mut` (or a C static) read, written
// or its address taken is global; a checked index or slicing (unless in
// bounds: in_bounds), a failed `as E`, a vector load, store or lane is
// panic; `while` and `loop` are diverge (`for` over a range is counted:
// the desugared `for` loops are); an operation that needs unsafe code is
// unsafe. A body that failed to check is ⊤, unknown (no cascade of
// declared-effect errors in its callers).
//
// why.tach walks a body again in search mode (find_step): the first
// local source or call that brings a given effect.

use crate::arch::{INTRS, intrinsic_effect_bits, intrinsic_of_fn};
use crate::base::{IntVec, alloc_array, intern_c};
use crate::base::timer::{T_CHECK, T_EFFECTS, timer_now, timer_sub};
use crate::front::ast::{
    FN_BODY_FAILED, FN_SIG_FAILED, FN_UNSAFE, NODES, NODE_IN_BOUNDS, NODE_RAW, NodeKind, REPR_UNION,
    VK_LANE, VK_LOAD, VK_STORE, VK_WITH, child,
};
use crate::front::check::{LOCALS, Res};
use crate::front::check::unsafety::{NODE_NO_READ, is_borrow, is_borrow_param};
use crate::front::closures::{CLOSURES, CLOSURE_COUNT};
use crate::front::effects::{
    ALLOC_ANY, EFF_ALLOC_EXTERN, EFF_DIVERGE, EFF_GLOBAL, EFF_PANIC, EFF_RAW_DIVERGE, EFF_RAW_PANIC,
    EFF_UNKNOWN, EFF_UNSAFE, Effects, FN_EFFECTS, FN_EFFECTS_COUNT, allocator_bit, effects_none,
    effects_top,
};
use crate::front::effects::builtin::unknown_c_effects;
use crate::front::effects::check::extern_effects;
use crate::front::modules::{STD_MODULE, qualify};
use crate::front::traits::{IMPLS, impl_of_fn, std_trait};
use crate::front::types::{
    FNS, FN_COUNT, STATICS, STRUCTS, SYM_STRUCT, TLISTS, TYPES, TY_ERROR, TyKind, struct_type,
    vec_lanes,
};
use crate::middle::lower::ssa::HMap;

// The kinds of edges (above).
pub const E_CALL: i64 = 0;
pub const E_ALLOC: i64 = 1;
pub const E_SCOPE: i64 = 2;

// The graph: GRAPH_SIZE nodes (FN_COUNT functions, then the virtual ones);
// the edges of node v are EDGES' entries (to * 4 + kind; an E_SCOPE's
// add in SCOPE_ADD, by its index + 1) from
// EDGE_START[v] to EDGE_START[v + 1].
pub static mut GRAPH_SIZE: i64 = 0;
pub static mut GRAPH_FNS: i64 = 0;
pub static mut EDGE_START: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut EDGES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut SCOPE_ADD: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
// Each node's local effects (a function's own; the virtual nodes': none,
// unknown C's for C_UNKNOWN), and its effects once inferred.
static mut LOCAL_FX: *Effects = 0 as *Effects;
pub static mut NODE_FX: *Effects = 0 as *Effects;
// The component of each node (for the chains: an edge inside one is
// recursion).
pub static mut COMPONENT: *i64 = 0 as *i64;
// The virtual nodes (node GRAPH_FNS + k): the fn type of k (-1: unknown C).
pub static mut VIRTUAL_TYPE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut DISPATCH: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
pub static mut C_UNKNOWN: i64 = -1;
// (fn type, function) pairs: the functions whose address is taken.
pub static mut ADDRESS_TAKEN: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The functions whose body failed to check (note_body_failed), and their
// flags once inference starts.
static mut FAILED_LIST: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut FAILED: *i64 = 0 as *i64;

// What a call of each function is (callee_info), 0 until its first call.
static mut CALLEE_INFO: *i64 = 0 as *i64;
const CALL_UNSAFE: i64 = 8;
const BORROW_SHIFT: i64 = 8;
const BORROW_PARAMS: i64 = 48;

// std's Allocator trait, the types Gpa and ScopedArena (0: none), the
// symbols the walk compares.
pub static mut ALLOCATOR_TRAIT: i64 = -1;
pub static mut GPA_TYPE: i64 = 0;
static mut SCOPED_TYPE: i64 = 0;
static mut ARENA_SYM: i64 = 0;
static mut SCOPED_SYM: i64 = 0;
static mut SCOPE_SYM: i64 = 0;
static mut ARENA_SCOPE_SYM: i64 = 0;
static mut LEN_SYM: i64 = 0;
// std's arena_unlend: a scope's end, whose frees to Gpa (the blocks of
// their own) are the arena's business, as its refills are.
static mut ARENA_UNLEND_SYM: i64 = 0;

// The walk: the node walked, what it found so far, the counted `for` loops
// around (in_bounds: (loop variable, kind, what) triples).
static mut WALK_NODE: i64 = 0;
static mut ACC: Effects = Effects { bits: 0, allocs: 0 };
static mut LOOPS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
const LOOP_SLICE: i64 = 1;
const LOOP_LENGTH: i64 = 2;

// Search mode (find_step): the effect looked for (an EFF_* bit, or 0 with
// SEARCH_ALLOC an allocator bit, ALLOC_ANY for any), what brings it first.
static mut SEARCH: bool = false;
static mut SEARCH_BIT: i64 = 0;
static mut SEARCH_ALLOC: i64 = 0;
pub static mut FOUND_NODE: i64 = 0;
pub static mut FOUND_CALLEE: i64 = -1;
pub static mut FOUND_KIND: i64 = 0;

// Function f's body failed to check (check_function_recovering): its
// effects are ⊤.
pub fn note_body_failed(f: i64) {
    FAILED_LIST.push(f);
}

// The template of instance f (f itself when not an instance).
pub fn template_of(f: i64) -> i64 {
    unsafe {
        if FNS[f].tmpl != 0 { FNS[f].tmpl - 1 } else { f }
    }
}

// The type of std's struct `name`, or 0.
pub fn std_struct_type(name: *u8) -> i64 {
    unsafe {
        if STD_MODULE < 0 {
            return 0;
        }
        let s = SYM_STRUCT[qualify(STD_MODULE, intern_c(name))] - 1;
        if s < 0 || STRUCTS[s].generic != 0 { 0 } else { struct_type(s) }
    }
}

// Whether function f is a method of an `impl Allocator for X` (X its
// self type).
pub fn is_allocator_method(f: i64) -> bool {
    unsafe {
        if ALLOCATOR_TRAIT < 0 || FNS[f].self_ty == 0 {
            return false;
        }
        let i = impl_of_fn(template_of(f));
        i >= 0 && IMPLS[i].tr == ALLOCATOR_TRAIT
    }
}

// Whether f is a part of std's arenas whose own allocation is the arena's
// business (a scope's end giving the blocks of their own back to Gpa): a
// call of it is masked as an Allocator method's is, and adds no allocator.
fn is_arena_internal(f: i64) -> bool {
    unsafe {
        FNS[f].module == STD_MODULE && STD_MODULE >= 0 && FNS[f].self_ty == 0
            && NODES[FNS[f].node].a == ARENA_UNLEND_SYM
    }
}

// The parent allocator type of a call of function f when f is one of std's
// arena scopes (arena_scope: Gpa; Arena::scope: Arena; ScopedArena::scope:
// ScopedArena), else 0.
pub fn scope_parent(f: i64) -> i64 {
    unsafe {
        let base = template_of(f);
        if FNS[base].module != STD_MODULE || STD_MODULE < 0 {
            return 0;
        }
        let name = NODES[FNS[base].node].a;
        let self_ty = FNS[f].self_ty;
        if name == ARENA_SCOPE_SYM && self_ty == 0 {
            return GPA_TYPE;
        }
        if name != SCOPE_SYM || self_ty <= 0 || TYPES[self_ty].kind != TyKind::Struct {
            return 0;
        }
        let s = STRUCTS[TYPES[self_ty].a].name;
        if s == ARENA_SYM || s == SCOPED_SYM { self_ty } else { 0 }
    }
}

// Effects e as seen through an edge of kind `kind` (add: E_SCOPE's parent
// allocator bits).
pub fn through(e: Effects, kind: i64, add: i64) -> Effects {
    if kind == E_ALLOC {
        return Effects { bits: e.bits & (EFF_RAW_PANIC | EFF_RAW_DIVERGE), allocs: 0 };
    }
    let mut allocs = e.allocs;
    if kind == E_SCOPE {
        if SCOPED_TYPE != 0 && (allocs & ALLOC_ANY) == 0 {
            allocs = allocs & ~allocator_bit(SCOPED_TYPE);
        }
        allocs = allocs | add;
    }
    Effects { bits: e.bits & ~EFF_UNSAFE, allocs: allocs }
}

// Whether e has the effect (bit, alloc): an EFF_* bit, or with bit 0 the
// allocator bit alloc (ALLOC_ANY: any allocation, C's too).
pub fn has_effect(e: Effects, bit: i64, alloc: i64) -> bool {
    if bit != 0 {
        return (e.bits & bit) != 0;
    }
    if alloc == ALLOC_ANY {
        return e.allocs != 0 || (e.bits & EFF_ALLOC_EXTERN) != 0;
    }
    (e.allocs & alloc) != 0 || (e.allocs & ALLOC_ANY) != 0
}

// ---- Inference ----

// Fills FN_EFFECTS, after the bodies and instances are checked (called by
// check_program, before exit_if_errors).
pub fn infer_effects() {
    let t = timer_now();
    unsafe {
        init_walk();
        let n = FN_COUNT;
        GRAPH_FNS = n;
        FAILED = alloc_array::<i64>(n + 1);
        for i in 0..FAILED_LIST.count {
            if FAILED_LIST.data[i] < n {
                FAILED[FAILED_LIST.data[i]] = 1;
            }
        }
        // (a closure of a function that failed is unknown too: its
        // enclosing function is made before it)
        for c in 0..CLOSURE_COUNT {
            let e = CLOSURES[c].encl_fn;
            let f = CLOSURES[c].f;
            if e >= 0 && e < n && f >= 0 && f < n && FAILED[e] != 0 {
                FAILED[f] = 1;
            }
        }
        LOCAL_FX = alloc_array::<Effects>(n + 1);
        CALLEE_INFO = alloc_array::<i64>(n + 1);
        for f in 0..n {
            EDGE_START.push(EDGES.count);
            LOCAL_FX[f] = node_locals(f);
        }
        // The virtual nodes' edges, in the order they were made.
        let addr = ADDRESS_TAKEN.count;
        for k in 0..VIRTUAL_TYPE.count {
            EDGE_START.push(EDGES.count);
            let vt = VIRTUAL_TYPE.data[k];
            let mut i = 0;
            while i < addr {
                let t = ADDRESS_TAKEN.data[i];
                let f = ADDRESS_TAKEN.data[i + 1];
                let callback = vt < 0 && TYPES[t].kind == TyKind::Fn && TYPES[t].b != 0;
                if t == vt || callback {
                    push_edge(f, E_CALL, 0);
                }
                i += 2;
            }
        }
        GRAPH_SIZE = n + VIRTUAL_TYPE.count;
        EDGE_START.push(EDGES.count);
        components();
        FN_EFFECTS = NODE_FX;
        FN_EFFECTS_COUNT = n;
    }
    timer_sub(T_CHECK, T_EFFECTS, t);
}

fn init_walk() {
    unsafe {
        EDGE_START.count = 0;
        EDGES.count = 0;
        SCOPE_ADD.clear();
        VIRTUAL_TYPE.count = 0;
        ADDRESS_TAKEN.count = 0;
        DISPATCH.clear();
        C_UNKNOWN = -1;
        ALLOCATOR_TRAIT = std_trait(c"Allocator");
        GPA_TYPE = std_struct_type(c"Gpa");
        SCOPED_TYPE = std_struct_type(c"ScopedArena");
        ARENA_SYM = intern_c(c"Arena");
        SCOPED_SYM = intern_c(c"ScopedArena");
        SCOPE_SYM = intern_c(c"scope");
        ARENA_SCOPE_SYM = intern_c(c"arena_scope");
        ARENA_UNLEND_SYM = intern_c(c"arena_unlend");
        LEN_SYM = intern_c(c"len");
        SEARCH = false;
    }
}

// Whether function f's body is walked: checked, not a template, not
// failed. (A lazy default never used was not checked: its body has no
// type.)
pub fn body_walked(f: i64) -> bool {
    unsafe {
        let node = FNS[f].node;
        if node == 0 || NODES[node].kind != NodeKind::Fn || FNS[f].generic > 0
            || (NODES[node].p & (FN_SIG_FAILED | FN_BODY_FAILED)) != 0 {
            return false;
        }
        let body = NODES[node].c;
        body != 0 && NODES[body].ty != 0
    }
}

// Whether function f's effects are ⊤: a template, a body that failed or
// was not checked, an instance of the error type (query mode).
fn is_top(f: i64) -> bool {
    unsafe {
        if FAILED[f] != 0 || FNS[f].node == 0 {
            return true;
        }
        if FNS[f].is_extern {
            return false;
        }
        if !body_walked(f) {
            return true;
        }
        for i in 0..FNS[f].targ_count {
            if TLISTS.data[FNS[f].targs + i] == TY_ERROR {
                return true;
            }
        }
        false
    }
}

// The local effects of function f, its edges pushed.
fn node_locals(f: i64) -> Effects {
    unsafe {
        // (0.19: a declaration of std::arch's has its table's effects)
        let intr = intrinsic_of_fn(f);
        if intr >= 0 && NODES[FNS[f].node].c == 0 {
            // (a raw:: pointer form, one parameter fewer, is unsafe)
            let raw = FNS[f].param_count < INTRS[intr].nparams;
            return Effects { bits: if raw { EFF_UNSAFE } else { intrinsic_effect_bits(intr) },
                allocs: 0 };
        }
        if is_top(f) {
            return effects_top();
        }
        if FNS[f].is_extern {
            let e = extern_effects(f);
            if (e.bits & EFF_UNKNOWN) != 0 {
                // (unknown C: its callbacks)
                push_edge(c_unknown_node(), E_CALL, 0);
                return Effects { bits: e.bits & ~EFF_UNKNOWN, allocs: e.allocs };
            }
            return e;
        }
        WALK_NODE = f;
        ACC = effects_none();
        if (FNS[f].attrs & FN_UNSAFE) != 0 {
            ACC.bits |= EFF_UNSAFE;
        }
        LOOPS.count = 0;
        walk(NODES[FNS[f].node].c);
        ACC
    }
}

// The virtual node of calls through values of fn type t.
fn dispatch_node(t: i64) -> i64 {
    unsafe {
        let v = DISPATCH.get(t + 1);
        if v != 0 {
            return v - 1;
        }
        let node = GRAPH_FNS + VIRTUAL_TYPE.count;
        VIRTUAL_TYPE.push(t);
        DISPATCH.put(t + 1, node + 1);
        node
    }
}

// The virtual node of unknown C.
fn c_unknown_node() -> i64 {
    unsafe {
        if C_UNKNOWN < 0 {
            C_UNKNOWN = GRAPH_FNS + VIRTUAL_TYPE.count;
            VIRTUAL_TYPE.push(-1);
        }
        C_UNKNOWN
    }
}

// The virtual node of fn type t, or -1 when nothing is called through it.
pub fn dispatch_of(t: i64) -> i64 {
    DISPATCH.get(t + 1) - 1
}

fn push_edge(to: i64, kind: i64, add: i64) {
    if kind == E_SCOPE {
        SCOPE_ADD.put(EDGES.count + 1, add);
    }
    EDGES.push(to * 4 + kind);
}

// The node edge e goes to, its kind, and what it adds.
fn edge_to(e: i64) -> i64 {
    unsafe { EDGES.data[e] >> 2 }
}

fn edge_through(e: i64) -> Effects {
    unsafe {
        let kind = EDGES.data[e] & 3;
        let add = if kind == E_SCOPE { SCOPE_ADD.get(e + 1) } else { 0 };
        through(NODE_FX[EDGES.data[e] >> 2], kind, add)
    }
}

// ---- The walk ----

// What n brings locally: bits and allocators.
fn local(n: i64, bits: i64, allocs: i64) {
    unsafe {
        let mut b = bits;
        if (b & EFF_PANIC) != 0 {
            b |= EFF_RAW_PANIC;
        }
        if (b & EFF_DIVERGE) != 0 {
            b |= EFF_RAW_DIVERGE;
        }
        if SEARCH {
            if FOUND_NODE == 0 && has_effect(Effects { bits: b, allocs: allocs }, SEARCH_BIT,
                SEARCH_ALLOC) {
                FOUND_NODE = n;
                FOUND_CALLEE = -1;
            }
            return;
        }
        ACC.bits |= b;
        ACC.allocs |= allocs;
    }
}

// Call n of graph node `to`, by an edge of kind `kind`.
fn call_edge(n: i64, to: i64, kind: i64, add: i64) {
    unsafe {
        if SEARCH {
            if FOUND_NODE != 0 || to < 0 || to >= GRAPH_SIZE {
                return;
            }
            let e = through(NODE_FX[to], kind, add);
            let recursive = SEARCH_BIT == EFF_DIVERGE && COMPONENT[to] == COMPONENT[WALK_NODE];
            if has_effect(e, SEARCH_BIT, SEARCH_ALLOC) || recursive {
                FOUND_NODE = n;
                FOUND_CALLEE = to;
                FOUND_KIND = kind;
            }
            return;
        }
        push_edge(to, kind, add);
    }
}

fn walk_list(n: i64) {
    unsafe {
        for i in 0..NODES[n].count {
            walk(child(n, i));
        }
    }
}

// Walks node n (0: none); a literal or a local brings nothing, and is
// passed over here, without a call (the walk's hottest path).
#[inline]
fn walk(n: i64) {
    unsafe {
        if n == 0 {
            return;
        }
        let kind = NODES[n].kind;
        if kind == NodeKind::Ident && NODES[n].res == Res::Local || kind == NodeKind::Int
            || kind == NodeKind::CStr || kind == NodeKind::Str || kind == NodeKind::Bool
            || kind == NodeKind::Char {
            return;
        }
        walk_node(n);
    }
}

fn walk_node(n: i64) {
    unsafe {
        match NODES[n].kind {
            NodeKind::Ident => walk_ident(n),
            NodeKind::Binary | NodeKind::Assign | NodeKind::While => {
                if NODES[n].kind == NodeKind::While && (NODES[n].p & NODE_IN_BOUNDS) == 0 {
                    local(n, EFF_DIVERGE, 0);
                }
                walk(NODES[n].b);
                walk(NODES[n].c);
            }
            NodeKind::Unary => {
                if (NODES[n].p & NODE_RAW) != 0 {
                    local(n, EFF_UNSAFE, 0);
                }
                walk(NODES[n].b);
            }
            NodeKind::Cast => {
                let operand = NODES[n].a;
                walk(operand);
                let from = NODES[operand].ty;
                if from > 0 && TYPES[from].kind == TyKind::Prim
                    && TYPES[NODES[n].ty].kind == TyKind::Ptr
                    && !(NODES[operand].kind == NodeKind::Int && NODES[operand].a == 0) {
                    local(n, EFF_UNSAFE, 0);
                }
            }
            NodeKind::Call => walk_call(n),
            NodeKind::MethodCall => {
                walk(NODES[n].a);
                walk_list(n);
            }
            NodeKind::Index => walk_index(n),
            NodeKind::FieldAccess => {
                if (NODES[n].p & NODE_RAW) != 0 || reads_union(n) {
                    local(n, EFF_UNSAFE, 0);
                }
                walk(NODES[n].a);
            }
            NodeKind::TupleField | NodeKind::ExprStmt | NodeKind::Return | NodeKind::Defer => {
                walk(NODES[n].a);
            }
            NodeKind::Tuple | NodeKind::Array | NodeKind::StructLit | NodeKind::VariantLit => {
                walk_list(n);
            }
            NodeKind::FieldInit | NodeKind::Break | NodeKind::NamedArg => walk(NODES[n].b),
            NodeKind::Repeat | NodeKind::Range => {
                walk(NODES[n].a);
                walk(NODES[n].b);
            }
            NodeKind::Block => {
                // (its statements' expressions directly: fewer calls)
                for i in 0..NODES[n].count {
                    let s = child(n, i);
                    let k = NODES[s].kind;
                    walk(if k == NodeKind::ExprStmt { NODES[s].a } else if k == NodeKind::Let {
                        NODES[s].c
                    } else { s });
                }
                walk(NODES[n].a);
            }
            NodeKind::Let => walk(NODES[n].c),
            NodeKind::If => {
                walk(NODES[n].a);
                walk(NODES[n].b);
                walk(NODES[n].c);
            }
            NodeKind::Loop => {
                if (NODES[n].p & NODE_IN_BOUNDS) == 0 {
                    local(n, EFF_DIVERGE, 0);
                }
                walk(NODES[n].b);
            }
            NodeKind::For => walk_for(n),
            NodeKind::Match => {
                walk(NODES[n].a);
                for i in 0..NODES[n].count {
                    let arm = child(n, i);
                    walk(NODES[arm].b);
                    walk(NODES[arm].c);
                }
            }
            NodeKind::EnumPanic => {
                local(n, EFF_PANIC, 0);
                walk(NODES[n].a);
            }
            NodeKind::VecOp => walk_vecop(n),
            // (0.14: its env, or its function as a value; the body is the
            // closure's function, walked as one)
            NodeKind::Interp if NODES[n].x > 0 => walk_direct(n),
            NodeKind::Closure | NodeKind::Try | NodeKind::Interp => walk(NODES[n].y),
            _ => {}
        }
    }
}

// (0.17) Call n of std's print, println, eprint, eprintln, format_in or
// Buf::push_fmt with its f-string written in place (an Interp node, x =
// the function + 1; front/check/interp.tach, direct_call): its receiver,
// holes and allocator, then the writes, which a search finds as the call
// (step_text: `'println(f"..")' calls 'std::println'`).
fn walk_direct(n: i64) {
    unsafe {
        let block = NODES[n].y;
        for i in 0..NODES[block].count {
            walk(NODES[child(block, i)].c);
        }
        let found = FOUND_NODE;
        walk(NODES[block].a);
        if SEARCH && found == 0 && FOUND_NODE != 0 {
            FOUND_NODE = n;
        }
    }
}

fn walk_ident(n: i64) {
    unsafe {
        let res = NODES[n].res;
        if res == Res::Static {
            let s = NODES[n].y;
            if s >= 0 && (STATICS[s].mutable || STATICS[s].linkage != 0) {
                local(n, EFF_GLOBAL, 0);
            }
            return;
        }
        if res != Res::Fn {
            return;
        }
        let f = NODES[n].y;
        if f < 0 {
            return;
        }
        if !SEARCH {
            ADDRESS_TAKEN.push(NODES[n].ty);
            ADDRESS_TAKEN.push(f);
        }
        if (FNS[f].attrs & FN_UNSAFE) != 0 {
            local(n, EFF_UNSAFE, 0);
        }
    }
}

// Whether field access n reads a field of a union (not an assignment's
// target, not `&u.f`).
fn reads_union(n: i64) -> bool {
    unsafe {
        let mut t = NODES[NODES[n].a].ty;
        if t > 0 && TYPES[t].kind == TyKind::Ptr {
            t = TYPES[t].a;
        }
        t > 0 && TYPES[t].kind == TyKind::Struct && (STRUCTS[TYPES[t].a].repr & REPR_UNION) != 0
            && (NODES[n].p & NODE_NO_READ) == 0
    }
}

fn walk_call(n: i64) {
    unsafe {
        let f = NODES[n].x - 1;
        if f >= 0 {
            walk_list(n);
            let info = callee_info(f);
            if (info & CALL_UNSAFE) != 0
                || (info >> BORROW_SHIFT) != 0 && raw_to_borrow(n, f, info) {
                local(n, EFF_UNSAFE, 0);
            }
            let kind = (info & 7) - 1;
            if kind == E_ALLOC && FNS[f].self_ty != 0 {
                local(n, 0, allocator_bit(FNS[f].self_ty));
            }
            call_edge(n, f, kind, if kind == E_SCOPE { allocator_bit(scope_parent(f)) } else { 0 });
            return;
        }
        let callee = NODES[n].a;
        walk(callee);
        walk_list(n);
        let t = NODES[callee].ty;
        if t <= 0 || TYPES[t].kind != TyKind::Fn {
            return;
        }
        if TYPES[t].b != 0 {
            // (an `extern "C" fn` value: C, unknown)
            local(n, EFF_UNSAFE, 0);
            if SEARCH {
                call_edge(n, C_UNKNOWN, E_CALL, 0);
            } else {
                call_edge(n, c_unknown_node(), E_CALL, 0);
            }
            return;
        }
        if SEARCH {
            call_edge(n, dispatch_of(t), E_CALL, 0);
        } else {
            call_edge(n, dispatch_node(t), E_CALL, 0);
        }
    }
}

// Whether direct call n of f (its callee_info `info`) passes a raw pointer
// to a borrowed parameter (unsafe; a method called through a raw pointer
// is one).
fn raw_to_borrow(n: i64, f: i64, info: i64) -> bool {
    unsafe {
        let item = FNS[f].node;
        let count = if NODES[n].count < NODES[item].count { NODES[n].count }
            else { NODES[item].count };
        let mask = info >> BORROW_SHIFT;
        for i in 0..count {
            let borrowed = if i < BORROW_PARAMS { ((mask >> i) & 1) != 0 }
                else { is_borrow_param(child(item, i)) };
            if !borrowed {
                continue;
            }
            let arg = child(n, i);
            let t = NODES[arg].ty;
            if t > 0 && TYPES[t].kind == TyKind::Ptr && !is_borrow(arg) {
                return true;
            }
        }
        false
    }
}

// What a call of function f is, computed at its first call: its edge kind
// + 1 (the low 3 bits), CALL_UNSAFE (C, or an `unsafe fn`), and from
// BORROW_SHIFT on the mask of its borrowed parameters (the first
// BORROW_PARAMS; past them all are, to look at).
fn callee_info(f: i64) -> i64 {
    unsafe {
        let known = CALLEE_INFO[f];
        if known != 0 {
            return known;
        }
        let kind = if is_allocator_method(f) || is_arena_internal(f) { E_ALLOC }
            else if scope_parent(f) != 0 { E_SCOPE } else { E_CALL };
        let mut info = kind + 1;
        if FNS[f].is_extern || (FNS[f].attrs & FN_UNSAFE) != 0 {
            info |= CALL_UNSAFE;
        }
        if !FNS[f].is_extern {
            let item = FNS[f].node;
            for i in 0..NODES[item].count {
                if i >= BORROW_PARAMS || is_borrow_param(child(item, i)) {
                    info |= 1 << (BORROW_SHIFT + if i < BORROW_PARAMS { i } else { BORROW_PARAMS });
                }
                if i >= BORROW_PARAMS {
                    break;
                }
            }
        }
        CALLEE_INFO[f] = info;
        info
    }
}

fn walk_index(n: i64) {
    unsafe {
        let base = NODES[n].a;
        let index = NODES[n].b;
        walk(base);
        let bt = NODES[base].ty;
        let raw = bt > 0 && TYPES[bt].kind == TyKind::Ptr;
        if NODES[index].kind == NodeKind::Range {
            walk(NODES[index].a);
            walk(NODES[index].b);
            if raw {
                local(n, EFF_UNSAFE, 0);
            } else if NODES[index].a == 0 && NODES[index].b == 0 {
                // (`s[..]`: the whole)
                NODES[n].p |= NODE_IN_BOUNDS;
            } else if (NODES[n].p & NODE_IN_BOUNDS) == 0 {
                local(n, EFF_PANIC, 0);
            }
            return;
        }
        walk(index);
        if raw {
            local(n, EFF_UNSAFE, 0);
            return;
        }
        if (NODES[n].p & NODE_IN_BOUNDS) != 0 || in_bounds(base, bt, index) {
            NODES[n].p |= NODE_IN_BOUNDS;
            return;
        }
        local(n, EFF_PANIC, 0);
    }
}

// Whether `base[index]` (base of type bt, a slice or an array) is in
// bounds by the syntax: a constant index below an array's length, or the
// variable of a counted loop `for i in 0..s.len` with `s` the same
// immutable slice binding, or `for i in 0..N` with N at most the array's
// length (which is how the `for` desugarings index).
fn in_bounds(base: i64, bt: i64, index: i64) -> bool {
    unsafe {
        let array = bt > 0 && TYPES[bt].kind == TyKind::Array;
        if NODES[index].kind == NodeKind::Int {
            return array && NODES[index].a >= 0 && NODES[index].a < TYPES[bt].b;
        }
        if NODES[index].kind != NodeKind::Ident || NODES[index].res != Res::Local {
            return false;
        }
        let i = NODES[index].y;
        let mut k = LOOPS.count - 3;
        while k >= 0 {
            if LOOPS.data[k] == i {
                let kind = LOOPS.data[k + 1];
                let what = LOOPS.data[k + 2];
                if kind == LOOP_SLICE {
                    return NODES[base].kind == NodeKind::Ident && NODES[base].res == Res::Local
                        && NODES[base].y == what;
                }
                return array && what <= TYPES[bt].b;
            }
            k -= 3;
        }
        false
    }
}

// `for p in a..b body` (counted): a in-bounds context for the body when
// it is `for i in 0..s.len` or `for i in 0..N`.
fn walk_for(n: i64) {
    unsafe {
        let range = NODES[n].c;
        if NODES[range].kind != NodeKind::Range {
            walk(range);
            walk(NODES[n].d);
            return;
        }
        walk(NODES[range].a);
        walk(NODES[range].b);
        let mark = LOOPS.count;
        let pattern = NODES[n].b;
        let low = NODES[range].a;
        let high = NODES[range].b;
        if NODES[pattern].kind == NodeKind::PatBind && NODES[pattern].b == 0
            && NODES[pattern].x >= 0 && low != 0 && NODES[low].kind == NodeKind::Int
            && NODES[low].a >= 0 && high != 0 {
            let inclusive = NODES[range].c != 0;
            if NODES[high].kind == NodeKind::Int {
                LOOPS.push(NODES[pattern].x);
                LOOPS.push(LOOP_LENGTH);
                LOOPS.push(NODES[high].a + inclusive as i64);
            } else if !inclusive && NODES[high].kind == NodeKind::FieldAccess
                && NODES[high].b == LEN_SYM {
                let s = NODES[high].a;
                if NODES[s].kind == NodeKind::Ident && NODES[s].res == Res::Local && NODES[s].y >= 0
                    && !LOCALS[NODES[s].y].mutable {
                    let st = NODES[s].ty;
                    if st > 0 && TYPES[st].kind == TyKind::Slice {
                        LOOPS.push(NODES[pattern].x);
                        LOOPS.push(LOOP_SLICE);
                        LOOPS.push(NODES[s].y);
                    }
                }
            }
        }
        walk(NODES[n].d);
        LOOPS.count = mark;
    }
}

fn walk_vecop(n: i64) {
    unsafe {
        let kind = NODES[n].x;
        if kind == VK_LOAD || kind == VK_STORE {
            local(n, EFF_PANIC, 0);
        } else if kind == VK_LANE || kind == VK_WITH {
            let lane = child(n, 0);
            if !(NODES[lane].kind == NodeKind::Int && NODES[lane].a >= 0
                && NODES[lane].a < vec_lanes(NODES[n].y)) {
                local(n, EFF_PANIC, 0);
            }
        }
        walk(NODES[n].a);
        walk_list(n);
    }
}

// ---- Components ----

// Tarjan's stack.
static mut STACK: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Tarjan's algorithm, iterative, over the graph; each component's effects
// as it completes (its callees' are known then).
fn components() {
    unsafe {
        let size = GRAPH_SIZE;
        NODE_FX = alloc_array::<Effects>(size + 1);
        COMPONENT = alloc_array::<i64>(size + 1);
        let index = alloc_array::<i64>(size + 1);
        let low = alloc_array::<i64>(size + 1);
        let on_stack = alloc_array::<i64>(size + 1);
        STACK.count = 0;
        let mut calls = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut counter = 0;
        let mut comp = 0;
        for root in 0..size {
            if index[root] != 0 {
                continue;
            }
            counter += 1;
            index[root] = counter;
            low[root] = counter;
            STACK.push(root);
            on_stack[root] = 1;
            calls.push(root);
            calls.push(EDGE_START.data[root]);
            while calls.count > 0 {
                let v = calls.data[calls.count - 2];
                let e = calls.data[calls.count - 1];
                if e < EDGE_START.data[v + 1] {
                    calls.data[calls.count - 1] = e + 1;
                    let w = edge_to(e);
                    if index[w] == 0 {
                        counter += 1;
                        index[w] = counter;
                        low[w] = counter;
                        STACK.push(w);
                        on_stack[w] = 1;
                        calls.push(w);
                        calls.push(EDGE_START.data[w]);
                    } else if on_stack[w] != 0 && index[w] < low[v] {
                        low[v] = index[w];
                    }
                    continue;
                }
                calls.count -= 2;
                if calls.count > 0 {
                    let p = calls.data[calls.count - 2];
                    if low[v] < low[p] {
                        low[p] = low[v];
                    }
                }
                if low[v] == index[v] {
                    let mut first = STACK.count - 1;
                    while STACK.data[first] != v {
                        first -= 1;
                    }
                    comp += 1;
                    for k in first..STACK.count {
                        on_stack[STACK.data[k]] = 0;
                        COMPONENT[STACK.data[k]] = comp;
                    }
                    component_effects(first, comp);
                    STACK.count = first;
                }
            }
        }
    }
}

// The local effects of graph node v.
fn local_of(v: i64) -> Effects {
    unsafe {
        if v < GRAPH_FNS {
            return LOCAL_FX[v];
        }
        if v == C_UNKNOWN { unknown_c_effects() } else { effects_none() }
    }
}

// The effects of component number comp, the nodes of STACK from first
// on.
fn component_effects(first: i64, comp: i64) {
    unsafe {
        let mut acc = effects_none();
        let mut cyclic = STACK.count - first > 1;
        for k in first..STACK.count {
            let m = STACK.data[k];
            let own = local_of(m);
            acc.bits |= own.bits & ~EFF_UNSAFE;
            acc.allocs |= own.allocs;
            for e in EDGE_START.data[m]..EDGE_START.data[m + 1] {
                let w = edge_to(e);
                if COMPONENT[w] == comp {
                    cyclic = true;
                    continue;
                }
                let t = edge_through(e);
                acc.bits |= t.bits;
                acc.allocs |= t.allocs;
            }
        }
        if cyclic {
            acc.bits |= EFF_DIVERGE | EFF_RAW_DIVERGE;
        }
        for k in first..STACK.count {
            let m = STACK.data[k];
            NODE_FX[m] = Effects { bits: acc.bits | (local_of(m).bits & EFF_UNSAFE),
                allocs: acc.allocs };
        }
    }
}

// ---- Search (why.tach) ----

// The first call or local source in function f's body that brings the
// effect (bit, alloc) (has_effect's): FOUND_NODE (0: none), FOUND_CALLEE
// (the graph node called, -1 for a local source) and FOUND_KIND.
pub fn find_step(f: i64, bit: i64, alloc: i64) {
    unsafe {
        FOUND_NODE = 0;
        FOUND_CALLEE = -1;
        FOUND_KIND = 0;
        if f < 0 || f >= GRAPH_FNS || NODE_FX == 0 as *Effects || !body_walked(f) {
            return;
        }
        SEARCH = true;
        SEARCH_BIT = bit;
        SEARCH_ALLOC = alloc;
        WALK_NODE = f;
        LOOPS.count = 0;
        if bit == EFF_UNSAFE && (FNS[f].attrs & FN_UNSAFE) != 0 {
            FOUND_NODE = FNS[f].node;
        }
        walk(NODES[FNS[f].node].c);
        SEARCH = false;
    }
}
