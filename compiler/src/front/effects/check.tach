// The declared effects (0.16; T1 makes the checks): a function's
// `#[effects(...)]`, `#[pure]`, `#[no_alloc]`, `#[no_io]`, `#[no_panic]`
// (FnInfo.effect_decl), a trait method's (binding every impl), and a type
// parameter's `effects(...)` bound, each an upper bound of the inferred
// set. Until then declarations are accepted silently.

// Checks every declaration against FN_EFFECTS (after infer_effects).
pub fn check_effects() {}

// Bound `bound` (an EffectSet in a type parameter's bounds) holds for type
// ty (a closure's or fn's type) bound to it at pos: recorded by
// check_bounds, checked by check_effects once effects are known.
pub fn note_effect_bound(bound: i64, ty: i64, pos: i64) {}
