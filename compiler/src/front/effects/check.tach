// The declared effects (0.16; docs/design/effects-allocation.md §2.2,
// §2.8): a function's `#[effects(...)]`, `#[pure]`, `#[no_alloc]`,
// `#[no_io]`, `#[no_panic]` (FnInfo.effect_decl, a chain: several
// intersect), a trait method's (binding every impl, derived ones too),
// and a type parameter's `effects(...)` bound, each an upper bound of the
// inferred set, checked once inference ran. A body whose effects are
// unknown (it failed to check, or calls one that did) is not checked: no
// cascade. On a C function a declaration is trusted (extern_effects).
//
// Their meanings as bounds (decl_bound): `#[pure]` allows panic, diverge
// and unsafe (Koka's pure); `#[no_alloc]`, `#[no_io]`, `#[no_panic]`
// everything but that effect; `#[effects(..)]` exactly the effects
// listed, `alloc` alone any allocator (C's too), `alloc(A, extern)` those.
// Allocator types are resolved where the declaration is (in an instance,
// with its type arguments; a trait method's with the impl's Self).

use crate::base::{IntVec, SRC, SYMS, buf_bytes, buf_str};
use crate::base::diag::{
    ERR, ERR_HELP, ERR_KIND, edit_distance, err_begin, err_end_soft, err_help, err_str,
    errors_forget, errors_mark,
};
use crate::base::timer::{T_CHECK, T_EFFECTS, timer_now, timer_sub};
use crate::front::ast::{
    EFFECTS_DECL, EFFECTS_NO_ALLOC, EFFECTS_NO_IO, EFFECTS_NO_PANIC, EFFECTS_PURE, NODES, NodeKind,
    child,
};
use crate::front::check::{SELF_TYPE, TRY_RESULT, Try, attempt};
use crate::front::closures::{CLOSURES, closure_of_type};
use crate::front::effects::{
    ALLOCATORS, ALLOC_ANY, EFFECT_BOUNDS, EFF_ALLOC_EXTERN, EFF_DIVERGE, EFF_GLOBAL, EFF_IO,
    EFF_PANIC, EFF_RAW_DIVERGE, EFF_RAW_PANIC, EFF_SYNC, EFF_THREAD, EFF_TLS, EFF_UNKNOWN,
    EFF_UNSAFE, EFF_VISIBLE, Effects, allocator_bit, effects_none, effects_subset, effects_text,
    fn_effects,
};
use crate::front::effects::builtin::{c_symbol, known_c_effects};
use crate::front::effects::infer::{E_CALL, NODE_FX, body_walked, dispatch_of, template_of, through};
use crate::front::effects::why::{effect_name, effect_phrase, step_text};
use crate::front::generics::{CUR_INST, env_enter, env_leave};
use crate::front::modules::{CUR_MOD, STD_MODULE, module_of, within_std};
use crate::front::traits::{
    IMPLS, IMPL_COUNT, TRAITS, TRAIT_COUNT, impl_of_fn, implements, std_trait, trait_fn,
};
use crate::front::types::{FNS, FN_COUNT, TYPES, TY_ERROR, TyKind, buf_type};

// The effect names, in display order, and their bits (alloc: 0).
const NAME_COUNT: i64 = 9;

// The `effects(...)` bounds met by check_bounds (note_effect_bound), a
// record of BOUND_WORDS each: the bound, the type, the position, the
// parameter (its TyName), the item's name, the allowed set (bits,
// allocs), the instance being checked then.
static mut BOUNDS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
const BOUND_WORDS: i64 = 8;

// The bit of effect name sym (EFF_*; -1 for alloc, 0 unknown).
fn effect_bit(sym: i64) -> i64 {
    unsafe {
        let text = SYMS[sym].text;
        if text == "alloc" {
            return -1;
        }
        if text == "io" { EFF_IO } else if text == "global" { EFF_GLOBAL }
        else if text == "panic" { EFF_PANIC } else if text == "diverge" { EFF_DIVERGE }
        else if text == "unsafe" { EFF_UNSAFE } else if text == "tls" { EFF_TLS }
        else if text == "thread" { EFF_THREAD } else if text == "sync" { EFF_SYNC } else { 0 }
    }
}

// The intersection of two bounds (any allocator: what the other allows).
fn intersect(a: Effects, b: Effects) -> Effects {
    let allocs = if (a.allocs & ALLOC_ANY) != 0 { b.allocs }
        else if (b.allocs & ALLOC_ANY) != 0 { a.allocs } else { a.allocs & b.allocs };
    Effects { bits: a.bits & b.bits, allocs: allocs }
}

fn everything() -> Effects {
    Effects { bits: EFF_VISIBLE, allocs: ALLOC_ANY }
}

// The allocator type node t of a declaration resolved (in the context
// set: CUR_MOD, the type parameters, SELF_TYPE), or TY_ERROR; quiet: an
// error resolving it is not reported.
fn alloc_type(t: i64, quiet: bool) -> i64 {
    let mark = errors_mark();
    let ok = attempt(Try::Type, t);
    if !ok && quiet {
        errors_forget(mark);
    }
    if ok { TRY_RESULT } else { TY_ERROR }
}

// The upper bound one EffectSet `set` means (allocator types resolved in
// the context set; quiet as alloc_type).
fn set_bound(set: i64, quiet: bool) -> Effects {
    unsafe {
        let form = NODES[set].c;
        if form == EFFECTS_PURE {
            return Effects { bits: EFF_PANIC | EFF_DIVERGE | EFF_UNSAFE, allocs: 0 };
        }
        if form == EFFECTS_NO_ALLOC {
            return Effects { bits: EFF_VISIBLE & ~EFF_ALLOC_EXTERN, allocs: 0 };
        }
        if form == EFFECTS_NO_IO {
            return Effects { bits: EFF_VISIBLE & ~EFF_IO, allocs: ALLOC_ANY };
        }
        if form == EFFECTS_NO_PANIC {
            return Effects { bits: EFF_VISIBLE & ~EFF_PANIC, allocs: ALLOC_ANY };
        }
        let mut e = effects_none();
        for i in 0..NODES[set].count {
            let item = child(set, i);
            let bit = effect_bit(NODES[item].a);
            if bit > 0 {
                e.bits |= bit;
                continue;
            }
            if bit == 0 {
                continue;
            }
            if NODES[item].count == 0 && NODES[item].b == 0 {
                e.bits |= EFF_ALLOC_EXTERN;
                e.allocs |= ALLOC_ANY;
                continue;
            }
            if NODES[item].b != 0 {
                e.bits |= EFF_ALLOC_EXTERN;
            }
            for k in 0..NODES[item].count {
                let t = alloc_type(child(item, k), quiet);
                if t == TY_ERROR {
                    // (reported; or a trait's type the impl cannot name)
                    e.allocs |= ALLOC_ANY;
                } else {
                    e.allocs |= allocator_bit(t);
                }
            }
        }
        e
    }
}

// The bound of the declaration chain starting at `set` (see set_bound).
fn chain_bound(set: i64, quiet: bool) -> Effects {
    unsafe {
        let mut e = everything();
        let mut s = set;
        while s != 0 {
            e = intersect(e, set_bound(s, quiet));
            s = NODES[s].b;
        }
        e
    }
}

// Sets the context of function f's declarations (its module, its type
// arguments, its Self); what leave_context restores.
fn enter_context(f: i64, module: i64) -> i64 {
    unsafe {
        CUR_MOD = module;
        SELF_TYPE = FNS[f].self_ty;
        if FNS[f].tmpl != 0 {
            return env_enter(NODES[FNS[FNS[f].tmpl - 1].node].g, FNS[f].targs, FNS[f].targ_count);
        }
        -1
    }
}

fn leave_context(saved: i64) {
    if saved >= 0 {
        env_leave(saved);
    }
    unsafe {
        CUR_MOD = 0;
        SELF_TYPE = 0;
    }
}

// The effects of C function f: its declarations, trusted (a list is the
// set; #[pure] and #[no_*] take from it, or from the default), else the
// builtin table's (EFF_UNKNOWN: unknown C, see infer.tach).
pub fn extern_effects(f: i64) -> Effects {
    unsafe {
        let mut e = known_c_effects(c_symbol(f));
        let decl = FNS[f].effect_decl;
        if decl == 0 {
            return e;
        }
        e.bits &= ~EFF_UNKNOWN;
        let saved = enter_context(f, FNS[f].module);
        let mut listed = false;
        let mut exact = everything();
        let mut limit = everything();
        let mut s = decl;
        while s != 0 {
            if NODES[s].c == EFFECTS_DECL {
                listed = true;
                exact = intersect(exact, set_bound(s, true));
            } else {
                limit = intersect(limit, set_bound(s, true));
            }
            s = NODES[s].b;
        }
        leave_context(saved);
        if listed {
            e = exact;
        }
        e = intersect(e, limit);
        e.bits &= ~EFF_UNSAFE;
        if (e.bits & EFF_PANIC) != 0 {
            e.bits |= EFF_RAW_PANIC;
        }
        if (e.bits & EFF_DIVERGE) != 0 {
            e.bits |= EFF_RAW_DIVERGE;
        }
        e
    }
}

// ---- The checks ----

// Checks every declaration against FN_EFFECTS (after infer_effects).
pub fn check_effects() {
    let t = timer_now();
    unsafe {
        let saved_kind = ERR_KIND;
        ERR_KIND = c"effect";
        let allocator = std_trait(c"Allocator");
        for f in 0..FN_COUNT {
            if FNS[f].tmpl == 0 && FNS[f].node != 0 {
                validate_fn(f, allocator);
            }
        }
        validate_traits();
        for f in 0..FN_COUNT {
            if !body_walked(f) {
                continue;
            }
            let e = fn_effects(f);
            if (e.bits & EFF_UNKNOWN) != 0 {
                continue;
            }
            let decl = FNS[f].effect_decl;
            if decl != 0 {
                let saved = enter_context(f, FNS[f].module);
                let bound = chain_bound(decl, true);
                leave_context(saved);
                if !effects_subset(e, bound) {
                    declared_error(f, e, bound, decl, -1);
                }
            }
            let i = impl_of_fn(template_of(f));
            if i >= 0 && IMPLS[i].tr >= 0 {
                let tr = IMPLS[i].tr;
                let tf = trait_fn(tr, NODES[FNS[f].node].a);
                if tf != 0 && NODES[tf].z != 0 && NODES[tf].z != decl {
                    let saved = enter_context(f, TRAITS[tr].module);
                    let bound = chain_bound(NODES[tf].z, true);
                    leave_context(saved);
                    if !effects_subset(e, bound) {
                        declared_error(f, e, bound, NODES[tf].z, tr);
                    }
                }
            }
        }
        check_noted_bounds();
        ERR_KIND = saved_kind;
    }
    timer_sub(T_CHECK, T_EFFECTS, t);
}

// (0.16) Whether the program outside std declares effects, so that a
// build at -O0 must infer and check them (EFFECTS_WANTED false): a
// function's declaration, a trait method's or an impl of a trait with
// one, an `effects(...)` bound (std's are its own, checked when the
// compiler is tested), a bound met at a call.
pub fn effects_declared() -> bool {
    unsafe {
        if BOUNDS.count > 0 {
            return true;
        }
        for i in 0..EFFECT_BOUNDS.count {
            if !within_std(module_of(EFFECT_BOUNDS.data[i])) {
                return true;
            }
        }
        for f in 0..FN_COUNT {
            if FNS[f].effect_decl != 0 && !within_std(FNS[f].module) {
                return true;
            }
        }
        for tr in 0..TRAIT_COUNT {
            if !within_std(TRAITS[tr].module) && trait_declares(tr) {
                return true;
            }
        }
        for i in 0..IMPL_COUNT {
            let tr = IMPLS[i].tr;
            if !within_std(IMPLS[i].module) && tr >= 0 && trait_declares(tr) {
                return true;
            }
        }
        false
    }
}

// Whether a method of trait tr declares its effects.
fn trait_declares(tr: i64) -> bool {
    unsafe {
        let node = TRAITS[tr].node;
        for i in 0..NODES[node].count {
            let tf = child(node, i);
            if NODES[tf].kind == NodeKind::Fn && NODES[tf].z != 0 {
                return true;
            }
        }
        false
    }
}

// Validates the declarations of function f (an item or template, not an
// instance) and the `effects(...)` bounds of its type parameters: the
// effect names, allocators given as types (not parameters) that are
// allocators.
fn validate_fn(f: i64, allocator: i64) {
    unsafe {
        let node = FNS[f].node;
        validate_bounds(node);
        let mut s = FNS[f].effect_decl;
        while s != 0 {
            validate_names(s);
            validate_allocators(f, node, s, allocator);
            s = NODES[s].b;
        }
    }
}

// The `effects(...)` bounds of the type parameters of item node `node`.
fn validate_bounds(node: i64) {
    unsafe {
        let g = NODES[node].g;
        if g == 0 || (NODES[node].kind != NodeKind::Fn && NODES[node].kind != NodeKind::Struct
            && NODES[node].kind != NodeKind::Enum) {
            return;
        }
        for i in 0..NODES[g].count {
            let bounds = NODES[child(g, i)].h;
            if bounds == 0 {
                continue;
            }
            for k in 0..NODES[bounds].count {
                let b = child(bounds, k);
                if NODES[b].kind == NodeKind::EffectSet {
                    validate_names(b);
                }
            }
        }
    }
}

// The declarations of the functions of every trait (their names, their
// allocators not parameters).
fn validate_traits() {
    unsafe {
        for tr in 0..TRAIT_COUNT {
            let node = TRAITS[tr].node;
            for i in 0..NODES[node].count {
                let tf = child(node, i);
                if NODES[tf].kind != NodeKind::Fn {
                    continue;
                }
                validate_bounds(tf);
                let mut s = NODES[tf].z;
                while s != 0 {
                    validate_names(s);
                    validate_allocators(-1, tf, s, -1);
                    s = NODES[s].b;
                }
            }
        }
    }
}

// The names of EffectSet s's effects are effects; only alloc takes
// allocators.
fn validate_names(s: i64) {
    unsafe {
        for i in 0..NODES[s].count {
            let item = child(s, i);
            let bit = effect_bit(NODES[item].a);
            if bit == 0 {
                let name = SYMS[NODES[item].a].text;
                err_begin(NODES[item].start);
                err_str(c"unknown effect '");
                buf_bytes(ERR, name);
                err_str(c"' (effects: alloc, io, global, panic, diverge, unsafe)");
                let near = nearest_effect(name);
                if near != 0 as *u8 {
                    err_help(c"did you mean '");
                    err_help(near);
                    err_help(c"'?");
                }
                err_end_soft();
            } else if bit > 0 && (NODES[item].count > 0 || NODES[item].b != 0) {
                err_begin(NODES[item].start);
                err_str(c"only 'alloc' names allocators: '");
                buf_bytes(ERR, SYMS[NODES[item].a].text);
                err_str(c"' takes none");
                err_end_soft();
            }
        }
    }
}

// The effect name nearest to `name` (a typo or a longer word), or null.
fn nearest_effect(name: [u8]) -> *u8 {
    let names: [*u8; 9] = [c"alloc", c"io", c"global", c"panic", c"diverge", c"unsafe", c"tls",
        c"thread", c"sync"];
    let texts: [[u8]; 9] = ["alloc", "io", "global", "panic", "diverge", "unsafe", "tls",
        "thread", "sync"];
    let mut best = -1;
    let mut best_d = 3;
    for i in 0..NAME_COUNT {
        let t = texts[i];
        let prefix = t.len >= 2 && name.len > t.len && name[0..t.len] == t;
        let d = if prefix { 1 } else { edit_distance(name, t) };
        if d < best_d {
            best_d = d;
            best = i;
        }
    }
    if best < 0 { 0 as *u8 } else { names[best] }
}

// The allocators of EffectSet s (of function f, node `node`; f -1 for a
// trait's) are types, not its parameters, and (when f is not generic)
// allocator types.
fn validate_allocators(f: i64, node: i64, s: i64, allocator: i64) {
    unsafe {
        for i in 0..NODES[s].count {
            let item = child(s, i);
            if effect_bit(NODES[item].a) != -1 {
                continue;
            }
            for k in 0..NODES[item].count {
                let t = child(item, k);
                let param = param_named(node, t);
                if param != 0 {
                    err_begin(NODES[t].start);
                    err_str(c"effects name allocator types: '");
                    buf_bytes(ERR, SYMS[NODES[t].a].text);
                    err_str(c"' is a parameter");
                    let pt = NODES[param].b;
                    if pt != 0 {
                        let mut ty = pt;
                        if NODES[ty].kind == NodeKind::TyPtr {
                            ty = NODES[ty].a;
                        }
                        err_help(c"name its type\n  = try: #[effects(alloc(");
                        buf_bytes(ERR_HELP, SRC[NODES[ty].start..NODES[ty].end]);
                        err_help(c"))]");
                    }
                    err_end_soft();
                    continue;
                }
                if f < 0 || FNS[f].generic > 0 {
                    continue;
                }
                let saved = enter_context(f, FNS[f].module);
                let ty = alloc_type(t, false);
                leave_context(saved);
                if ty != TY_ERROR && allocator >= 0 && !implements(allocator, ty) {
                    err_begin(NODES[t].start);
                    err_str(c"'");
                    buf_type(ERR, ty);
                    err_str(
                        c"' is not an allocator: effects name allocator types (an 'impl Allocator')");
                    err_help(
                        c"Gpa, Arena, ScopedArena, FixedBuf, or a type parameter 'A: Allocator'");
                    err_end_soft();
                }
            }
        }
    }
}

// The parameter of function node `node` that type node t (a plain name)
// names, or 0.
fn param_named(node: i64, t: i64) -> i64 {
    unsafe {
        if NODES[t].kind != NodeKind::TyName || NODES[t].g != 0 || NODES[t].count != 0 {
            return 0;
        }
        for i in 0..NODES[node].count {
            let p = child(node, i);
            if NODES[p].kind == NodeKind::Param && NODES[p].a == NODES[t].a {
                return p;
            }
        }
        0
    }
}

// The first effect of e that bound does not allow, as (bit, alloc): an
// EFF_* bit, or 0 and an allocator bit (EFF_ALLOC_EXTERN for C's).
fn first_excess(e: Effects, bound: Effects) -> (i64, i64) {
    if (bound.allocs & ALLOC_ANY) == 0 {
        let extra = e.allocs & ~bound.allocs;
        if extra != 0 {
            unsafe {
                for i in 0..ALLOCATORS.count {
                    if (extra & (1 << i)) != 0 {
                        return (0, 1 << i);
                    }
                }
            }
            return (0, ALLOC_ANY);
        }
    }
    let bits: [i64; 6] = [EFF_ALLOC_EXTERN, EFF_IO, EFF_GLOBAL, EFF_PANIC, EFF_DIVERGE, EFF_UNSAFE];
    for k in 0..6 {
        if (e.bits & bits[k]) != 0 && (bound.bits & bits[k]) == 0 {
            return (bits[k], 0);
        }
    }
    (0, 0)
}

// The first declaration of the chain at `set` that does not allow (bit,
// alloc) (quietly resolved in the context set), or `set`.
fn violated_set(set: i64, bit: i64, alloc: i64) -> i64 {
    unsafe {
        let mut s = set;
        while s != 0 {
            let b = set_bound(s, true);
            let allowed = if bit != 0 { (b.bits & bit) != 0 }
                else { (b.allocs & ALLOC_ANY) != 0 || (b.allocs & alloc) != 0 };
            if !allowed {
                return s;
            }
            s = NODES[s].b;
        }
        set
    }
}

// Appends declaration `set` as written: `#[no_alloc]`, `#[effects(io)]`.
pub fn buf_decl(out: i64, set: i64) {
    unsafe {
        // (an attribute's span starts at its `#[`, a bound's at `effects`)
        let start = NODES[set].start;
        if SRC[start] != '#' {
            buf_str(out, c"#[");
        }
        buf_bytes(out, SRC[start..NODES[set].end]);
        buf_str(out, c"]");
    }
}

// Appends the name of function f for messages (an instance's template's).
pub fn buf_fn_name(out: i64, f: i64) {
    unsafe {
        buf_bytes(out, SYMS[FNS[template_of(f)].display].text);
    }
}

// The error for function f, whose effects e exceed the bound of the
// declaration chain at decl (f's own, or with tr >= 0 its trait's).
fn declared_error(f: i64, e: Effects, bound: Effects, decl: i64, tr: i64) {
    unsafe {
        let (bit, alloc) = first_excess(e, bound);
        if bit == 0 && alloc == 0 {
            return;
        }
        let saved = enter_context(f, if tr >= 0 { TRAITS[tr].module } else { FNS[f].module });
        let set = violated_set(decl, bit, alloc);
        leave_context(saved);
        let saved_inst = CUR_INST;
        CUR_INST = if FNS[f].tmpl != 0 { f } else { -1 };
        err_begin(NODES[FNS[f].node].start);
        err_str(c"'");
        buf_fn_name(ERR, f);
        if tr >= 0 {
            err_str(c"' implements '");
            buf_bytes(ERR, SYMS[TRAITS[tr].name].text);
            err_str(c"::");
            buf_bytes(ERR, SYMS[NODES[FNS[f].node].a].text);
            err_str(c"', which is ");
        } else {
            err_str(c"' is ");
        }
        buf_decl(ERR, set);
        err_str(c", but it ");
        effect_phrase(ERR, bit, alloc);
        err_str(c": ");
        let source = step_text(ERR, f, bit, alloc, false);
        effect_help(bit, source);
        err_help(c", or ");
        if NODES[set].c == EFFECTS_DECL {
            err_help(c"add '");
            effect_name(ERR_HELP, bit, alloc);
            err_help(c"' to ");
        } else {
            err_help(c"remove ");
        }
        buf_decl(ERR_HELP, set);
        if tr >= 0 {
            err_help(c" (the trait's)");
        }
        err_help(c"\n  = try: tachyonc query effects ");
        buf_fn_name(ERR_HELP, f);
        err_help(c" --why ");
        effect_name(ERR_HELP, bit, alloc);
        err_end_soft();
        CUR_INST = saved_inst;
    }
}

// The help for an effect (bit, alloc) a declaration does not allow, whose
// source is node `source` (0: none).
fn effect_help(bit: i64, source: i64) {
    unsafe {
        if bit == 0 || bit == EFF_ALLOC_EXTERN {
            err_help(c"allocate in the caller and pass the memory in");
        } else if bit == EFF_IO {
            err_help(c"return the data and let the caller print it");
        } else if bit == EFF_GLOBAL {
            err_help(c"pass the state in as a parameter");
        } else if bit == EFF_PANIC {
            if source != 0 && NODES[source].kind == NodeKind::Index {
                err_help(c"iterate ('for x in s'), or 's.get(i)' (an Option)");
            } else {
                err_help(c"return an Option or a Result instead of stopping");
            }
        } else if bit == EFF_DIVERGE {
            err_help(c"loop with a counted 'for' (a range, a slice, a Vec)");
        } else {
            err_help(c"keep the unsafe code out of this function");
        }
    }
}

// ---- Bounds ----

// Bound `bound` (an EffectSet in the bounds of type parameter `param`, a
// TyName, of generic item `what`) holds for type ty (a closure's or fn's
// type) bound to it at pos: recorded by check_bounds (its type parameters
// bound, so the allocators resolve now), checked by check_effects once
// effects are known.
pub fn note_effect_bound(bound: i64, ty: i64, pos: i64, param: i64, what: i64) {
    unsafe {
        if ty <= 0 || ty == TY_ERROR {
            return;
        }
        let mut i = 0;
        while i < BOUNDS.count {
            if BOUNDS.data[i] == bound && BOUNDS.data[i + 1] == ty && BOUNDS.data[i + 2] == pos {
                return;
            }
            i += BOUND_WORDS;
        }
        let allowed = set_bound(bound, true);
        BOUNDS.push(bound);
        BOUNDS.push(ty);
        BOUNDS.push(pos);
        BOUNDS.push(param);
        BOUNDS.push(what);
        BOUNDS.push(allowed.bits);
        BOUNDS.push(allowed.allocs);
        BOUNDS.push(CUR_INST);
    }
}

// The effects of calling a value of type ty: a closure's, or (a fn type)
// those of the functions of that type whose address is taken; -1 in
// `bits` when unknown.
fn callable_effects(ty: i64) -> (Effects, i64) {
    unsafe {
        let c = closure_of_type(ty);
        if c != 0 {
            let f = CLOSURES[c - 1].f;
            return (through(fn_effects(f), E_CALL, 0), f);
        }
        if TYPES[ty].kind == TyKind::Fn {
            let v = dispatch_of(ty);
            if v < 0 || NODE_FX == 0 as *Effects {
                return (effects_none(), -1);
            }
            return (through(NODE_FX[v], E_CALL, 0), -1);
        }
        (Effects { bits: EFF_UNKNOWN, allocs: 0 }, -1)
    }
}

fn check_noted_bounds() {
    unsafe {
        let mut i = 0;
        while i < BOUNDS.count {
            let ty = BOUNDS.data[i + 1];
            let (e, f) = callable_effects(ty);
            let allowed = Effects { bits: BOUNDS.data[i + 5], allocs: BOUNDS.data[i + 6] };
            if (e.bits & EFF_UNKNOWN) == 0 && !effects_subset(e, allowed) {
                bound_error(i, e, allowed, f);
            }
            i += BOUND_WORDS;
        }
        BOUNDS.count = 0;
    }
}

// The error for the bound recorded at BOUNDS[i]: the closure (function
// f, or -1 for a fn type) has effects e, beyond `allowed`.
fn bound_error(i: i64, e: Effects, allowed: Effects, f: i64) {
    unsafe {
        let bound = BOUNDS.data[i];
        let ty = BOUNDS.data[i + 1];
        let param = BOUNDS.data[i + 3];
        let (bit, alloc) = first_excess(e, allowed);
        if bit == 0 && alloc == 0 {
            return;
        }
        let saved_inst = CUR_INST;
        CUR_INST = BOUNDS.data[i + 7];
        err_begin(BOUNDS.data[i + 2]);
        err_str(if f >= 0 { c"the closure for '" } else { c"the function for '" });
        buf_bytes(ERR, SYMS[NODES[param].a].text);
        err_str(c"' of '");
        buf_bytes(ERR, SYMS[BOUNDS.data[i + 4]].text);
        err_str(c"' ");
        effect_phrase(ERR, bit, alloc);
        if f >= 0 {
            err_str(c" (");
            step_text(ERR, f, bit, alloc, false);
            err_str(c")");
        } else {
            err_str(c" (a '");
            buf_type(ERR, ty);
            err_str(c"' whose address is taken)");
        }
        err_str(c"; '");
        let bounds = NODES[param].h;
        let last = child(bounds, NODES[bounds].count - 1);
        let mut end = NODES[last].end;
        if end < NODES[bound].end {
            end = NODES[bound].end;
        }
        buf_bytes(ERR, SRC[NODES[param].start..end]);
        err_str(c"' allows ");
        effects_text(ERR, allowed);
        err_str(c" only");
        err_help(c"do only what the bound allows in the closure, or allow '");
        effect_name(ERR_HELP, bit, alloc);
        err_help(c"' in the bound");
        err_end_soft();
        CUR_INST = saved_inst;
    }
}
