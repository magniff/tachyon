// Why a function has an effect (0.16; T1 makes it): the chain from the
// function down to a local source (`'v.push(x)' at sum.tach:7:9 grows a
// Vec<i64>`), rebuilt on demand by walking its body again.

use crate::base::buf_str;

// Appends to out why function f has effect bit `bit` (an EFF_* bit, or 0
// with `alloc` an allocator bit of `allocs`).
pub fn explain_effect(f: i64, bit: i64, alloc: i64, out: i64) {
    unsafe { buf_str(out, c"(effects are not inferred yet: 0.16 T1)"); }
}
