// The effects of C functions declared without effect declarations (0.16;
// T1 makes the table): libm, mem* and str* none; malloc, calloc, realloc,
// free, strdup `alloc(extern)`; stdio and POSIX I/O `io`; exit and abort
// `io diverge`; anything else unknown (docs/design/effects-allocation.md
// §2.2). It replaces middle's PURE_LIBM.

use crate::front::effects::{Effects, effects_top};

// The effects of the C function with symbol sym.
pub fn known_c_effects(sym: i64) -> Effects {
    effects_top()
}
