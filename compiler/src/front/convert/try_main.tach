// The support of `?` and `fn main() -> Result<(), E>` (0.15): std's
// Option and Result recognized, their variant patterns made, and main's
// body wrapped (main_result_wrapper). Part of front/convert.

use crate::base::intern_c;
use crate::base::diag::{ERR_HELP, err_begin, err_end_soft, err_help, err_str};
use crate::front::ast::{
    ARM_SYNTHETIC, CLOSURE_MOVE, FN_SIG_FAILED, NODES, NodeKind, list_begin, list_end, list_push,
    new_node,
};
use crate::front::check::has_error_type;
use crate::front::lexer::SUF_NONE;
use crate::front::modules::STD_MODULE;
use crate::front::traits::{implements, std_trait};
use crate::front::types::{
    ENUMS, FNS, FN_COUNT, TLISTS, TYPES, TY_I32, TY_UNIT, TyKind, buf_type, err_type,
};

// The name of std's generic enum (Option, Result) that t is an instance
// of, or 0; its type arguments in *targs (a TLISTS index).
pub fn std_enum_name(t: i64, targs: &mut i64) -> i64 {
    unsafe {
        if STD_MODULE < 0 || t <= 0 || TYPES[t].kind != TyKind::Enum {
            return 0;
        }
        let e = TYPES[t].a;
        if ENUMS[e].tmpl == 0 {
            return 0;
        }
        let tmpl = ENUMS[e].tmpl - 1;
        if ENUMS[tmpl].module != STD_MODULE {
            return 0;
        }
        *targs = ENUMS[e].targs;
        ENUMS[tmpl].name
    }
}

// A PatVariant `std::Enum::Variant(p)` (p a node; 0: `std::Enum::Variant`).
pub fn std_variant_pattern(enum_name: *u8, variant: *u8, p: i64, start: i64, end: i64) -> i64 {
    unsafe {
        let pat = new_node(NodeKind::PatVariant, start, end);
        let std_seg = new_node(NodeKind::Ident, start, end);
        NODES[std_seg].a = intern_c(c"std");
        let prefix = new_node(NodeKind::Path, start, end);
        let pmark = list_begin();
        list_push(std_seg);
        list_end(prefix, pmark);
        NODES[pat].h = prefix;
        NODES[pat].a = intern_c(enum_name);
        NODES[pat].b = intern_c(variant);
        NODES[pat].c = (p != 0) as i64;
        let mark = list_begin();
        if p != 0 {
            list_push(p);
        }
        list_end(pat, mark);
        pat
    }
}

// `fn main() -> Result<(), E>` (called once the signatures are resolved):
// its body becomes
//     match (move || -> Result<(), E> { body })() {
//         std::Result::Ok(_) => 0,
//         std::Result::Err(e) => std::main_error(e),
//     }
// and it returns i32: on Err, `Error: {e:?}` on stderr and exit status 1.
pub fn main_result_wrapper() {
    unsafe {
        let main = intern_c(c"main");
        for f in 0..FN_COUNT {
            let node = FNS[f].node;
            if FNS[f].name != main || NODES[node].kind != NodeKind::Fn || NODES[node].d != 0
                || NODES[node].h != 0 || (NODES[node].p & FN_SIG_FAILED) != 0
                || FNS[f].generic != 0 || FNS[f].tmpl != 0 {
                continue;
            }
            let mut targs = 0;
            let r = FNS[f].ret;
            if r <= 0 || has_error_type(r) || std_enum_name(r, &mut targs) != intern_c(c"Result") {
                continue;
            }
            let ok = TLISTS.data[targs];
            let e = TLISTS.data[targs + 1];
            if ok != TY_UNIT {
                err_begin(NODES[NODES[node].b].start);
                err_str(c"'main' returning a Result returns 'Result<(), E>', not '");
                err_type(r);
                err_str(c"'");
                err_help(c"return the value some other way, and 'Ok(())'");
                err_end_soft();
                continue;
            }
            let debug = std_trait(c"Debug");
            if debug >= 0 && !has_error_type(e) && !implements(debug, e) {
                err_begin(NODES[NODES[node].b].start);
                err_str(c"'main' returns 'Result<(), ");
                err_type(e);
                err_str(c">', and '");
                err_type(e);
                err_str(c"' has no Debug, to print the error with");
                err_help(c"derive it: '#[derive(Debug)]' before the type, or 'impl Debug for ");
                buf_type(ERR_HELP, e);
                err_help(c" { fn fmt_debug(self: &Self, f: &mut std::Fmt) { ... } }'");
                err_end_soft();
                continue;
            }
            let body = NODES[node].c;
            let (start, end) = (NODES[body].start, NODES[body].end);
            let closure = new_node(NodeKind::Closure, start, end);
            NODES[closure].a = body;
            NODES[closure].b = NODES[node].b;
            NODES[closure].c = CLOSURE_MOVE;
            let empty = list_begin();
            list_end(closure, empty);
            let call = new_node(NodeKind::Call, start, end);
            NODES[call].a = closure;
            let none = list_begin();
            list_end(call, none);
            let zero = new_node(NodeKind::Int, start, end);
            NODES[zero].b = SUF_NONE;
            let ok_arm = new_node(NodeKind::Arm, start, end);
            NODES[ok_arm].a = std_variant_pattern(c"Result", c"Ok",
                new_node(NodeKind::PatWild, start, end), start, end);
            NODES[ok_arm].c = zero;
            let sym = intern_c(c"?error");
            let bind = new_node(NodeKind::PatBind, start, end);
            NODES[bind].a = sym;
            let value = new_node(NodeKind::Ident, start, end);
            NODES[value].a = sym;
            let report = new_node(NodeKind::Path, start, end);
            NODES[report].a = intern_c(c"std");
            NODES[report].b = intern_c(c"main_error");
            let report_call = new_node(NodeKind::Call, start, end);
            NODES[report_call].a = report;
            let rmark = list_begin();
            list_push(value);
            list_end(report_call, rmark);
            let err_arm = new_node(NodeKind::Arm, start, end);
            NODES[err_arm].a = std_variant_pattern(c"Result", c"Err", bind, start, end);
            NODES[err_arm].c = report_call;
            NODES[err_arm].p = ARM_SYNTHETIC;
            let m = new_node(NodeKind::Match, start, end);
            NODES[m].a = call;
            let amark = list_begin();
            list_push(ok_arm);
            list_push(err_arm);
            list_end(m, amark);
            let block = new_node(NodeKind::Block, start, end);
            NODES[block].a = m;
            let bmark = list_begin();
            list_end(block, bmark);
            NODES[node].c = block;
            FNS[f].ret = TY_I32;
        }
    }
}
