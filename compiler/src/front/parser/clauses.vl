// The syntax of 0.18 (docs/design/contracts-verification.md §2.1-§2.3,
// §2.6-§2.10): `requires`/`ensures` clauses after a signature, an
// `invariant` after a struct or an enum, `type X = distinct T [invariant
// ...]`, and the attributes `#[test]`, `#[property]`, `#[fuzz]` and
// `#[cfg(test)]`. The words are contextual: an identifier is one of them
// only where a clause may stand. What is read goes to front/contracts's
// side tables; the AST's nodes are the ordinary ones (a condition is an
// expression, a message a string or an f-string).

use crate::base::intern_c;
use crate::front::ast::{NODES, SCRATCH};
use crate::front::contracts::{
    CLAUSE_DEBUG, CLAUSE_ENSURES, CLAUSE_INVARIANT, CLAUSE_REQUIRES, TEST_CFG, TEST_FN, TEST_FUZZ,
    TEST_PROPERTY, add_clause, add_test_item, mark_distinct,
};
use crate::front::lexer::TOKS;
use crate::front::lexer::Tok::{
    ColonColon, Else, Hash, Ident, LBracket, LParen, Lt, RBracket, RParen, Semi,
};
use crate::front::parser::{
    NO_STRUCT, P, advance, at, cur_start, eat, expect, syntax_error, tok_kind,
};
use crate::front::parser::exprs::parse_expr;
use crate::front::parser::items::parse_top_item;
use crate::front::parser::types::parse_type;

// A function's flag while its test attribute is pending (between the
// attribute and take_test_attrs); never left on a node.
pub const FN_TEST_ATTR: i64 = 1 << 48;

static var WORDS_READY: bool = false;
static var W_REQUIRES: i64 = 0;
static var W_ENSURES: i64 = 0;
static var W_INVARIANT: i64 = 0;
static var W_DEBUG: i64 = 0;
static var W_DISTINCT: i64 = 0;
static var W_TEST: i64 = 0;
static var W_PROPERTY: i64 = 0;
static var W_FUZZ: i64 = 0;
static var W_CFG: i64 = 0;
// The test attribute read for the function that follows (TEST_FN, ...).
static var PENDING_TEST: i64 = 0;

fn words() {
    unsafe {
        if WORDS_READY {
            return;
        }
        W_REQUIRES = intern_c(c"requires");
        W_ENSURES = intern_c(c"ensures");
        W_INVARIANT = intern_c(c"invariant");
        W_DEBUG = intern_c(c"debug");
        W_DISTINCT = intern_c(c"distinct");
        W_TEST = intern_c(c"test");
        W_PROPERTY = intern_c(c"property");
        W_FUZZ = intern_c(c"fuzz");
        W_CFG = intern_c(c"cfg");
        WORDS_READY = true;
    }
}

// Whether the token `offset` ahead is the identifier `word` (a symbol).
fn is_word(offset: i64, word: i64) -> bool {
    tok_kind(offset) == Ident && unsafe { TOKS[P + offset].value as i64 } == word
}

// An expression where a `{` ends it (a clause before a body).
fn clause_expr() -> i64 {
    unsafe {
        let saved = NO_STRUCT;
        NO_STRUCT = true;
        let e = parse_expr();
        NO_STRUCT = saved;
        e
    }
}

// `else "message"` (or an f-string) after a condition: its node, or 0.
fn clause_message() -> i64 {
    if eat(Else) { clause_expr() } else { 0 }
}

// The clauses after function f's signature: `[debug] requires COND [else
// MESSAGE]`, `[debug] ensures COND [else MESSAGE]`, any number, in order.
pub fn parse_clauses(f: i64) {
    if !at(Ident) {
        return;
    }
    words();
    unsafe {
        loop {
            let pos = cur_start();
            var flags = 0;
            if is_word(0, W_DEBUG) && (is_word(1, W_REQUIRES) || is_word(1, W_ENSURES)) {
                flags = CLAUSE_DEBUG;
                advance();
            }
            let kind = if is_word(0, W_REQUIRES) { CLAUSE_REQUIRES }
                else if is_word(0, W_ENSURES) { CLAUSE_ENSURES } else { 0 };
            if kind == 0 {
                return;
            }
            advance();
            let cond = clause_expr();
            let message = clause_message();
            add_clause(f, kind | flags, cond, message, pos);
        }
    }
}

// `[debug] invariant COND [else MESSAGE] [;]` after struct or enum `item`'s
// closing brace (or a distinct alias's type).
pub fn parse_type_invariant(item: i64) {
    if !at(Ident) {
        return;
    }
    words();
    unsafe {
        let pos = cur_start();
        var flags = 0;
        if is_word(0, W_DEBUG) && is_word(1, W_INVARIANT) {
            flags = CLAUSE_DEBUG;
            advance();
        } else if !is_word(0, W_INVARIANT) {
            return;
        }
        advance();
        let cond = clause_expr();
        let message = clause_message();
        add_clause(item, CLAUSE_INVARIANT | flags, cond, message, pos);
    }
}

// The type of `type X = ...` (alias node `alias`): `distinct T` marks it,
// and a distinct type may have an invariant before the `;`.
pub fn parse_alias_target(alias: i64) -> i64 {
    words();
    if is_word(0, W_DISTINCT) && tok_kind(1) != Semi && tok_kind(1) != Lt
        && tok_kind(1) != ColonColon {
        advance();
        mark_distinct(alias);
    }
    let ty = parse_type();
    parse_type_invariant(alias);
    ty
}

// After `#[` and the attribute's name: true when it is `test`,
// `property`, `fuzz` or `cfg(test)` (read, and pending for the function
// that follows), false for any other attribute.
pub fn test_attribute(name: i64) -> bool {
    words();
    unsafe {
        let kind = if name == W_TEST { TEST_FN } else if name == W_PROPERTY { TEST_PROPERTY }
            else if name == W_FUZZ { TEST_FUZZ } else if name == W_CFG { TEST_CFG } else { 0 };
        if kind == 0 {
            return false;
        }
        if kind == TEST_CFG {
            expect(LParen);
            if !is_word(0, W_TEST) {
                syntax_error(c"expected 'test': the one cfg vole has is #[cfg(test)]");
            }
            advance();
            expect(RParen);
        }
        if PENDING_TEST == 0 || PENDING_TEST == TEST_CFG {
            PENDING_TEST = kind;
        }
        true
    }
}

// Function f's pending test attribute, recorded; FN_TEST_ATTR cleared.
pub fn take_test_attrs(f: i64) {
    unsafe {
        if PENDING_TEST != 0 {
            add_test_item(f, PENDING_TEST);
            PENDING_TEST = 0;
        }
        NODES[f].p &= ~FN_TEST_ATTR;
    }
}

// At `#[cfg(test)]` (the whole attribute, which parse_top_item takes
// before any other).
pub fn at_cfg_test() -> bool {
    words();
    tok_kind(0) == Hash && tok_kind(1) == LBracket && is_word(2, W_CFG) && tok_kind(3) == LParen
        && is_word(4, W_TEST) && tok_kind(5) == RParen && tok_kind(6) == RBracket
}

// `#[cfg(test)]` and the item after it (a module with its items, a
// function, a struct, ...): each item it pushes to the program's list is
// marked TEST_CFG.
pub fn parse_cfg_test_item() {
    unsafe {
        for _ in 0..7 {
            advance();
        }
        let mark = SCRATCH.count;
        parse_top_item();
        for i in mark..SCRATCH.count {
            add_test_item(SCRATCH.data[i], TEST_CFG);
        }
    }
}
