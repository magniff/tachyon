// A function's parameter list: `self`, the named parameters with their
// defaults, a C function's `...` (split from items).

use crate::base::SYMS;
use crate::base::diag::{err_begin, err_end, err_help, err_str, error_at};
use crate::front::ast::{NODES, NodeKind, list_begin, list_end, list_push, new_node};
use crate::front::lexer::{TOKS, TOK_COUNT, Tok};
use crate::front::lexer::Tok::{Amp, Colon, Comma, Ellipsis, Eof, Eq, Mut, RParen};
use crate::front::parser::{
    P, advance, at, cur_start, eat, expect, expect_binding_name, expect_ident, prev_end,
};
use crate::front::parser::exprs::parse_expr;
use crate::front::parser::types::parse_type;

// The parameters of `n` up to `)`; whether they end with `...`.
pub fn parse_params(n: i64, allow_ellipsis: bool) -> bool {
    let mark = list_begin();
    let mut variadic = false;
    while !at(RParen) && !at(Eof) {
        if at(Ellipsis) {
            if !allow_ellipsis {
                unsafe { error_at(cur_start(), c"only extern functions can be variadic"); }
            }
            advance();
            variadic = true;
            eat(Comma);
            break;
        }
        list_push(parse_param());
        if !eat(Comma) {
            break;
        }
    }
    list_end(n, mark);
    variadic
}

fn parse_param() -> i64 {
    unsafe {
        let start = cur_start();
        if at(Amp) {
            self_param_error(c"expected identifier, got '&'");
        }
        let mutable = eat(Mut);
        let n = new_node(NodeKind::Param, start, 0);
        NODES[n].a = if mutable { expect_binding_name() } else { expect_ident() };
        if !at(Colon) && SYMS[NODES[n].a].text == "self" {
            self_param_error(c"expected ':' after 'self'");
        }
        expect(Colon);
        NODES[n].b = parse_type();
        NODES[n].c = mutable as i64;
        if eat(Eq) {
            // A default (0.15): checked by check_param_defaults
            NODES[n].h = parse_expr();
        }
        NODES[n].end = prev_end();
        n
    }
}

// `&self`, `&mut self`, `self` without a type (0.14): what tachyon writes.
// (0.15) Rust's `fmt(&self, f: &mut Formatter)`: Display's and Debug's.
fn self_param_error(message: *u8) -> ! {
    unsafe {
        err_begin(cur_start());
        err_str(message);
        let mut formatter = false;
        let mut i = P;
        while i < TOK_COUNT && i < P + 16 && TOKS[i].kind != Tok::RParen {
            if TOKS[i].kind == Tok::Ident && SYMS[TOKS[i].value as i64].text == "Formatter" {
                formatter = true;
            }
            i += 1;
        }
        if formatter {
            err_help(c"Display and Debug in tachyon: `fn fmt(self: *Self, f: *std::Fmt)` and `fn fmt_debug(self: *Self, f: *std::Fmt)`, with no result; write with `f.write(f\"({self.x}, {self.y})\")`, `f.str(s)`, `f.debug(&x)`");
        } else {
            err_help(c"write the type of self: `self: &Self` for `&self`, `self: &mut Self` for `&mut self`, or `self: Self` (a copy)");
        }
        err_end()
    }
}
