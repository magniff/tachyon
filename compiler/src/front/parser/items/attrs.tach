use crate::base::{intern, intern_c};
use crate::base::diag::error_at;
use crate::front::ambient::AMBIENT_TRY;
use crate::front::ast::{
    EFFECTS_DECL, EFFECTS_NO_ALLOC, EFFECTS_NO_IO, EFFECTS_NO_PANIC, EFFECTS_PURE, FN_AMBIENT,
    FN_COLD, FN_EFFECT_DECL, FN_INLINE, FN_NO_INLINE, FN_VIEWS_DECL, NODES, NodeKind, list_begin,
    list_end, list_push, new_node,
};
use crate::front::check::name_error;
use crate::front::lexer::{STRS, TOKS};
use crate::front::lexer::Tok::{Comma, Eof, Hash, LBracket, LParen, RBracket, RParen, Star, Str};
use crate::front::parser::{
    P, advance, at, cur_start, eat, expect, expect_ident, prev_end, syntax_error,
};
use crate::front::parser::types::parse_effect_list;
use crate::middle::lower::ssa::HMap;

// The effect declarations parsed before the function being parsed (0.16):
// the first EffectSet and the last (chained by b).
static mut EFFECT_DECLS: i64 = 0;
static mut EFFECT_DECLS_LAST: i64 = 0;

// The text of an #[ambient("...")] before the function being parsed (-1:
// none).
static mut AMBIENT_PENDING: i64 = -1;

// After `#[` and the name `name` (at pos): when it is an effect
// declaration (0.16), parses it as an EffectSet (its arguments, for
// `effects`), adds it to EFFECT_DECLS and returns true.
pub fn parse_effect_attribute(name: i64, pos: i64) -> bool {
    unsafe {
        let form = if name == intern_c(c"effects") { EFFECTS_DECL }
            else if name == intern_c(c"pure") { EFFECTS_PURE }
            else if name == intern_c(c"no_alloc") { EFFECTS_NO_ALLOC }
            else if name == intern_c(c"no_io") { EFFECTS_NO_IO }
            else if name == intern_c(c"no_panic") { EFFECTS_NO_PANIC }
            else { 0 };
        if form == 0 {
            return false;
        }
        let n = new_node(NodeKind::EffectSet, pos, prev_end());
        NODES[n].c = form;
        if form == EFFECTS_DECL {
            parse_effect_list(n);
        }
        if EFFECT_DECLS == 0 {
            EFFECT_DECLS = n;
        } else {
            NODES[EFFECT_DECLS_LAST].b = n;
        }
        EFFECT_DECLS_LAST = n;
        true
    }
}

// Gives function (or extern) node f the effect declarations parsed before
// it (0.16): its z, and FN_EFFECT_DECL. Called with f = 0, drops them.
pub fn take_effect_decls(f: i64) {
    unsafe {
        if f != 0 && EFFECT_DECLS != 0 {
            NODES[f].z = EFFECT_DECLS;
            NODES[f].p |= FN_EFFECT_DECL;
        }
        if f != 0 && AMBIENT_PENDING >= 0 {
            AMBIENT_TRY.put(NODES[f].start + 1, AMBIENT_PENDING + 1);
        }
        if f != 0 && VIEWS_PENDING != 0 {
            VIEWS_OF.put(f + 1, VIEWS_PENDING + 1);
        }
        VIEWS_PENDING = 0;
        VIEWS_PENDING_LAST = 0;
        EFFECT_DECLS = 0;
        EFFECT_DECLS_LAST = 0;
        AMBIENT_PENDING = -1;
    }
}

// Whether effect declarations wait for their function (0.16).
pub fn has_effect_decls() -> bool {
    unsafe { EFFECT_DECLS != 0 || VIEWS_PENDING != 0 }
}

// (0.17) `#[views(a, *b)]`, `#[stores(c)]` before a function
// (docs/design/value-semantics.md §2.4): the view summary it declares.
// Each is an EffectSet node of form VIEWS_FORM or STORES_FORM whose list is
// EffectItem nodes, a: the parameter's name, b: 1 for `*p`; chained by b.
// take_effect_decls gives them to the function (VIEWS_OF).
pub const VIEWS_FORM: i64 = 7;
pub const STORES_FORM: i64 = 8;
static mut VIEWS_PENDING: i64 = 0;
static mut VIEWS_PENDING_LAST: i64 = 0;
// Per function node + 1: its first views/stores node + 1.
pub static mut VIEWS_OF: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

pub fn parse_views_attribute(name: i64, pos: i64) -> bool {
    unsafe {
        let form = if name == intern_c(c"views") { VIEWS_FORM }
            else if name == intern_c(c"stores") { STORES_FORM }
            else { 0 };
        if form == 0 {
            return false;
        }
        let n = new_node(NodeKind::EffectSet, pos, 0);
        NODES[n].c = form;
        expect(LParen);
        let mark = list_begin();
        while !at(RParen) && !at(Eof) {
            let item = new_node(NodeKind::EffectItem, cur_start(), 0);
            if eat(Star) {
                NODES[item].b = 1;
            }
            NODES[item].a = expect_ident();
            NODES[item].end = prev_end();
            list_push(item);
            if !eat(Comma) {
                break;
            }
        }
        list_end(n, mark);
        expect(RParen);
        NODES[n].end = prev_end();
        if VIEWS_PENDING == 0 {
            VIEWS_PENDING = n;
        } else {
            NODES[VIEWS_PENDING_LAST].b = n;
        }
        VIEWS_PENDING_LAST = n;
        true
    }
}

// The first views/stores declaration of function node f, 0: none.
pub fn views_of(f: i64) -> i64 {
    unsafe {
        let v = VIEWS_OF.get(f + 1);
        if v == 0 { 0 } else { v - 1 }
    }
}

// `#[inline]`, `#[inline(never)]` or `#[cold]` (0.6) after `#[` and the
// name: its FN_ flag, or 0 when `name` is another attribute. (0.16) An
// effect declaration, `#[effects(...)]`, `#[pure]`, `#[no_alloc]`,
// `#[no_io]` or `#[no_panic]`: FN_EFFECT_DECL, its EffectSet added to
// those take_effect_decls gives the function.
pub fn parse_fn_attribute(name: i64, pos: i64) -> i64 {
    unsafe {
        if parse_effect_attribute(name, pos) {
            return FN_EFFECT_DECL;
        }
        // (0.17: a view summary, front/own/summary.tach)
        if parse_views_attribute(name, pos) {
            return FN_VIEWS_DECL;
        }
        // (0.16: std's `#[ambient("Vec::new_in(gpa)")]`, front/ambient.tach)
        if name == intern_c(c"ambient") {
            expect(LParen);
            if !at(Str) {
                syntax_error(c"expected the text to write instead, as a string");
            }
            AMBIENT_PENDING = intern(STRS[TOKS[P].value as i64]);
            advance();
            expect(RParen);
            return FN_AMBIENT;
        }
        if name == intern_c(c"cold") {
            return FN_COLD;
        }
        if name != intern_c(c"inline") {
            return 0;
        }
        if eat(LParen) {
            let arg = expect_ident();
            if arg != intern_c(c"never") {
                name_error(pos, c"unknown inline option '", arg,
                    c"' (expected #[inline] or #[inline(never)])");
            }
            expect(RParen);
            return FN_NO_INLINE;
        }
        FN_INLINE
    }
}

// The function attributes before a function in an impl block (0.6).
pub fn parse_fn_attributes() -> i64 {
    let mut flags = 0;
    let start = cur_start();
    take_effect_decls(0);
    while at(Hash) {
        let pos = cur_start();
        advance();
        expect(LBracket);
        let name = expect_ident();
        let flag = parse_fn_attribute(name, pos);
        if flag == 0 {
            unsafe {
                name_error(pos, c"unknown attribute '", name,
                    c"' before a function (expected inline, inline(never), cold, effects, pure, no_alloc, no_io, no_panic, views or stores)");
            }
        }
        flags |= flag;
        expect(RBracket);
    }
    check_fn_attributes(flags, start);
    flags
}

pub fn check_fn_attributes(flags: i64, pos: i64) {
    if (flags & FN_INLINE) != 0 && (flags & FN_NO_INLINE) != 0 {
        unsafe { error_at(pos, c"a function cannot be both #[inline] and #[inline(never)]"); }
    }
}
