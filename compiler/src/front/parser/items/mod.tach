// Items: functions, structs, enums, constants, statics, type aliases,
// impl blocks and traits with their generic parameters, `use` and
// `import` lines, and the attributes before an item (`#[repr]`,
// `#[inline]`, `#[cold]`).

pub mod params;
pub mod attrs;

use crate::base::{
    FILES, SRC, SYMS, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, intern_c, sym_text,
};
use crate::base::diag::{err_begin, err_end, err_help, err_help_fmt, err_str, err_try_fmt, error_at};
use crate::front::ast::{
    FN_BODY_FAILED, FN_EFFECT_DECL, FN_UNSAFE, NODES, NodeKind, REPR_C, REPR_INT, REPR_PACKED,
    REPR_UNION, SCRATCH, STRUCT_SCOPED, STRUCT_SEALED, child, list_begin, list_end, list_push,
    new_node,
};
use crate::front::check::name_error;
use crate::front::lexer::{TOKS, Tok};
use crate::front::lexer::Tok::{
    Arrow, As, Colon, ColonColon, Comma, Const, Enum, Eof, Eq, Extern, Fn, For, Gt, Hash, Impl,
    Import, Int, LBrace, LBracket, LParen, Lt, Mod, Mut, Plus, Pub, RBrace, RBracket, RParen,
    Reserved, Semi, Star, Static, Str, Struct, Trait, Type, Union, Unsafe, Use,
};
use crate::front::modules::file_of_pos;
use crate::front::parser::{
    BODY_FAILED, P, UNDERSCORE, advance, at, cur, cur_start, eat, expect, expect_binding_name,
    expect_ident, prev_end, reserved_error, syntax_error, tok_kind,
};
use crate::front::parser::exprs::parse_expr;
use crate::front::parser::foreign::parse_extern;
use crate::front::parser::items::attrs::{
    check_fn_attributes, parse_fn_attribute, parse_fn_attributes, take_effect_decls,
};
use crate::front::parser::items::params::parse_params;
use crate::front::parser::stmts::parse_block;
use crate::front::parser::types::{is_int_type_name, parse_bound, parse_type};

// One item (or the several items of an impl or extern block), pushed to
// the program's list.
pub fn parse_top_item() {
    unsafe {
        let public = eat(Pub);
        if at(Impl) {
            // The functions of an impl block are items of the program.
            parse_impl(false);
        } else if at(Trait) {
            let item = parse_trait();
            mark_public(item, public);
            list_push(item);
        } else if at(Extern) {
            let mark = SCRATCH.count;
            parse_extern();
            for i in mark..SCRATCH.count {
                mark_public(SCRATCH.data[i], public);
            }
        } else if at(Import) {
            parse_import(public);
        } else if at(Use) {
            parse_use(public);
        } else if at(Mod) {
            let start = cur_start();
            advance();
            let n = new_node(NodeKind::Mod, start, 0);
            NODES[n].a = expect_binding_name();
            if eat(LBrace) {
                // `mod name { items }` (0.6): its items are the program's, in
                // the module the loader made for the braces (modules.tach).
                NODES[n].end = prev_end();
                mark_public(n, public);
                list_push(n);
                while !at(RBrace) && !at(Eof) {
                    parse_top_item();
                }
                expect(RBrace);
                return;
            }
            expect(Semi);
            NODES[n].end = prev_end();
            mark_public(n, public);
            list_push(n);
        } else if at(Hash) {
            let item = parse_attributed_item(public);
            list_push(item);
        } else {
            let item = parse_item();
            mark_public(item, public);
            list_push(item);
        }
    }
}

pub const ITEM_PUBLIC: i64 = 1;

fn mark_public(item: i64, public: bool) {
    if public {
        unsafe { NODES[item].p |= ITEM_PUBLIC; }
    }
}

fn parse_item() -> i64 {
    match cur() {
        Fn | Unsafe => parse_function(),
        Struct | Union => parse_struct(),
        Const => parse_const_or_static(NodeKind::Const),
        Static => parse_const_or_static(NodeKind::Static),
        Type => parse_type_alias(),
        Enum => parse_enum(),
        Reserved => reserved_error(),
        _ => unsafe { syntax_error(c"expected an item ('fn', 'extern', 'struct', 'union', 'enum', 'impl', 'const', 'static' or 'type')") },
    }
}

// `impl T { fn ... }`, `impl<T> Vec<T> { ... }` or `impl Vec<i64> { ... }`:
// each function is pushed as an item, marked with the type's name (d) and
// the type (h); the impl's type parameters come first in its own (g).
fn parse_impl(public: bool) {
    unsafe {
        let impl_start = cur_start();
        expect(Impl);
        let params = parse_generic_params(false);
        let mut self_type = parse_type();
        // `impl Trait for Type` (0.9): any type.
        let mut trait_name = 0;
        if eat(For) {
            trait_name = self_type;
            if NODES[trait_name].kind != NodeKind::TyName {
                error_at(NODES[trait_name].start, c"expected a trait's name before 'for'");
            }
            self_type = parse_type();
        } else if NODES[self_type].kind != NodeKind::TyName
            && !(NODES[self_type].kind == NodeKind::TySlice && params != 0) {
            error_at(NODES[self_type].start,
                c"impl blocks are for named types (structs and enums)");
        }
        let fns = SCRATCH.count;
        expect(LBrace);
        while !at(RBrace) && !at(Eof) {
            if at(Type) {
                if trait_name == 0 {
                    error_at(cur_start(), c"associated types are declared in an impl of a trait");
                }
                list_push(parse_assoc_type(true));
                continue;
            }
            let attrs_start = cur_start();
            let flags = parse_fn_attributes();
            let item_public = eat(Pub) || public;
            if !at(Fn) && !(at(Unsafe) && tok_kind(1) == Fn) {
                if flags != 0 {
                    error_at(attrs_start, c"#[inline] and #[cold] go before a function");
                }
                syntax_error(if trait_name != 0 { c"expected 'fn', 'type' or '}' in an impl block" }
                    else { c"expected 'fn' or '}' in an impl block" });
            }
            let f = parse_function();
            if trait_name != 0 {
                no_param_defaults(f, c"a trait's function");
            }
            NODES[f].p |= flags;
            take_effect_decls(f);
            NODES[f].d = if NODES[self_type].kind == NodeKind::TyName { NODES[self_type].a }
                else { UNDERSCORE };
            NODES[f].h = self_type;
            if params != 0 {
                NODES[f].g = merge_generics(params, NODES[f].g);
            }
            // (a trait's methods are as visible as the trait)
            mark_public(f, item_public || trait_name != 0);
            list_push(f);
        }
        expect(RBrace);
        let assoc = take_assoc_types(fns, impl_start);
        if trait_name != 0 {
            let n = new_node(NodeKind::Impl, impl_start, prev_end());
            NODES[n].a = trait_name;
            NODES[n].b = self_type;
            NODES[n].g = params;
            NODES[n].c = assoc;
            let end = SCRATCH.count;
            let mark = list_begin();
            for i in fns..end {
                list_push(SCRATCH.data[i]);
            }
            list_end(n, mark);
            list_push(n);
        }
    }
}

// `type Name;` in a trait, `type Name = T;` in an impl (0.14): an
// AssocType node.
fn parse_assoc_type(in_impl: bool) -> i64 {
    unsafe {
        let start = cur_start();
        expect(Type);
        let n = new_node(NodeKind::AssocType, start, 0);
        NODES[n].a = expect_binding_name();
        if in_impl {
            expect(Eq);
            NODES[n].b = parse_type();
        } else if at(Eq) {
            error_at(cur_start(), c"an associated type has no default: write 'type Name;'");
        } else if at(Colon) {
            error_at(cur_start(), c"an associated type has no bounds: write 'type Name;'");
        }
        expect(Semi);
        NODES[n].end = prev_end();
        n
    }
}

// The AssocType nodes among SCRATCH[from..] moved to a holder node (a
// Generics node, 0.14), the others kept in order; 0 when there are none.
fn take_assoc_types(from: i64, pos: i64) -> i64 {
    unsafe {
        let end = SCRATCH.count;
        let mut found = false;
        for i in from..end {
            if NODES[SCRATCH.data[i]].kind == NodeKind::AssocType {
                found = true;
            }
        }
        if !found {
            return 0;
        }
        let holder = new_node(NodeKind::Generics, pos, prev_end());
        let mark = list_begin();
        for i in from..end {
            if NODES[SCRATCH.data[i]].kind == NodeKind::AssocType {
                list_push(SCRATCH.data[i]);
            }
        }
        list_end(holder, mark);
        let mut w = from;
        for i in from..end {
            let x = SCRATCH.data[i];
            if NODES[x].kind != NodeKind::AssocType {
                SCRATCH.data[w] = x;
                w += 1;
            }
        }
        SCRATCH.count = w;
        holder
    }
}

// `trait Name { fn m(self: *Self) -> T; fn d(self: *Self) { ... } }` (0.9;
// 0.15: `trait Name<T> { ... }`).
fn parse_trait() -> i64 {
    unsafe {
        let start = cur_start();
        expect(Trait);
        let n = new_node(NodeKind::Trait, start, 0);
        NODES[n].a = expect_binding_name();
        // (0.15: `trait From<T>`)
        NODES[n].g = parse_generic_params(false);
        expect(LBrace);
        let mark = list_begin();
        while !at(RBrace) && !at(Eof) {
            if at(Type) {
                list_push(parse_assoc_type(false));
                continue;
            }
            let attrs_start = cur_start();
            let flags = parse_fn_attributes();
            if at(Pub) {
                error_at(cur_start(),
                    c"the functions of a trait are as visible as the trait: no 'pub'");
            }
            if !at(Fn) && !(at(Unsafe) && tok_kind(1) == Fn) {
                if flags != 0 {
                    error_at(attrs_start, c"#[inline] and #[cold] go before a function");
                }
                syntax_error(c"expected 'fn', 'type' or '}' in a trait");
            }
            let fstart = cur_start();
            let is_unsafe = eat(Unsafe);
            expect(Fn);
            let f = new_node(NodeKind::Fn, fstart, 0);
            NODES[f].p |= flags;
            take_effect_decls(f);
            if is_unsafe {
                NODES[f].p |= FN_UNSAFE;
            }
            NODES[f].a = expect_binding_name();
            NODES[f].g = parse_generic_params(false);
            expect(LParen);
            parse_params(f, false);
            no_param_defaults(f, c"a trait function");
            expect(RParen);
            NODES[f].b = parse_return_type();
            if !eat(Semi) {
                NODES[f].c = parse_fn_body(f);
            }
            NODES[f].end = prev_end();
            list_push(f);
        }
        NODES[n].b = take_assoc_types(mark, start);
        list_end(n, mark);
        expect(RBrace);
        NODES[n].end = prev_end();
        n
    }
}

// The parameters of an impl block followed by those of one of its
// functions (`a` counts the impl's).
fn merge_generics(outer: i64, own: i64) -> i64 {
    unsafe {
        let n = new_node(NodeKind::Generics, NODES[outer].start, NODES[outer].end);
        let mark = list_begin();
        for i in 0..NODES[outer].count {
            list_push(child(outer, i));
        }
        if own != 0 {
            for i in 0..NODES[own].count {
                list_push(child(own, i));
            }
        }
        list_end(n, mark);
        NODES[n].a = NODES[outer].count;
        n
    }
}

// `<T, U>` after the name of a generic item (0.5); 0 when there is none.
// (0.16) A parameter may have a default, `A: Allocator = Gpa` (its b), in
// a struct or an enum (`defaults`), after those without one.
fn parse_generic_params(defaults: bool) -> i64 {
    unsafe {
        if !at(Lt) {
            return 0;
        }
        let n = new_node(NodeKind::Generics, cur_start(), 0);
        advance();
        let mark = list_begin();
        while !at(Gt) && !at(Eof) {
            let param = new_node(NodeKind::TyName, cur_start(), 0);
            NODES[param].a = expect_binding_name();
            NODES[param].end = prev_end();
            if eat(Colon) {
                // Bounds (0.9): `T: Hash + Eq`, a Generics node of trait names
                // (0.14: or `Fn(A) -> R`, `Iterator<Item = A>`: parse_bound).
                let bounds = new_node(NodeKind::Generics, cur_start(), 0);
                let bmark = list_begin();
                loop {
                    list_push(parse_bound());
                    if !eat(Plus) {
                        break;
                    }
                }
                list_end(bounds, bmark);
                NODES[bounds].end = prev_end();
                NODES[param].h = bounds;
            }
            if at(Eq) {
                let eq = cur_start();
                advance();
                NODES[param].b = parse_type();
                if !defaults {
                    error_at(eq, c"only the type parameters of a struct or an enum have defaults");
                }
            } else if defaults {
                for i in mark..SCRATCH.count {
                    if NODES[SCRATCH.data[i]].b != 0 {
                        name_error(NODES[param].start, c"type parameter '", NODES[param].a,
                            c"' needs a default: those after a parameter with a default have one");
                    }
                }
            }
            for i in mark..SCRATCH.count {
                if NODES[SCRATCH.data[i]].a == NODES[param].a {
                    name_error(NODES[param].start, c"duplicate type parameter '", NODES[param].a,
                        c"'");
                }
            }
            list_push(param);
            if !eat(Comma) {
                break;
            }
        }
        list_end(n, mark);
        if NODES[n].count == 0 {
            error_at(NODES[n].start, c"expected a type parameter");
        }
        expect(Gt);
        NODES[n].end = prev_end();
        n
    }
}

// `enum E { A, B(T, ...), C = expr, ... }`
fn parse_enum() -> i64 {
    unsafe {
        let start = cur_start();
        expect(Enum);
        let n = new_node(NodeKind::Enum, start, 0);
        NODES[n].a = expect_binding_name();
        NODES[n].g = parse_generic_params(true);
        expect(LBrace);
        let mark = list_begin();
        while !at(RBrace) && !at(Eof) {
            let variant = new_node(NodeKind::Variant, cur_start(), 0);
            NODES[variant].a = expect_binding_name();
            if at(LBrace) {
                struct_variant_error(cur_start(), NODES[variant].a, NODES[n].a);
            }
            if eat(LParen) {
                NODES[variant].c = 1;
                let types = list_begin();
                while !at(RParen) && !at(Eof) {
                    list_push(parse_type());
                    if !eat(Comma) {
                        break;
                    }
                }
                list_end(variant, types);
                expect(RParen);
            }
            if eat(Eq) {
                NODES[variant].b = parse_expr();
            }
            NODES[variant].end = prev_end();
            list_push(variant);
            if !eat(Comma) {
                break;
            }
        }
        list_end(n, mark);
        expect(RBrace);
        NODES[n].end = prev_end();
        n
    }
}

// (0.17) `V { a: A, b: B }` in an enum, at position `at` (its `{`): the
// error, with the tuple variant to write, `V(A, B)`, as the try: line.
fn struct_variant_error(at: i64, name: i64, owner: i64) -> ! {
    unsafe {
        err_begin(at);
        err_str(c"struct-like enum variants are not supported yet; use a tuple variant");
        let t = buf_new();
        buf_bytes(t, SYMS[name].text);
        buf_byte(t, '(');
        let mut i = at + 1;
        let mut depth = 0;
        let mut field = 0;
        let mut colon = -1;
        let mut start = i;
        let limit = FILES[file_of_pos(at)].end;
        while i + 1 < limit {
            let c = SRC[i];
            if c == '(' || c == '[' || c == '<' || c == '{' {
                depth += 1;
            } else if (c == ')' || c == ']' || c == '>' || c == '}') && depth > 0 {
                depth -= 1;
            } else if depth == 0 && c == ':' && colon < 0 && SRC[i + 1] != ':' {
                colon = i;
            } else if depth == 0 && (c == ',' || c == '}') {
                if colon > 0 {
                    let mut a = colon + 1;
                    while a < i && (SRC[a] == ' ' || SRC[a] == '\n') {
                        a += 1;
                    }
                    let mut e = i;
                    while e > a && (SRC[e - 1] == ' ' || SRC[e - 1] == '\n') {
                        e -= 1;
                    }
                    if field > 0 {
                        buf_str(t, c", ");
                    }
                    buf_bytes(t, SRC[a..e]);
                    field += 1;
                }
                colon = -1;
                start = i + 1;
                if c == '}' {
                    break;
                }
            }
            i += 1;
        }
        let _ = start;
        buf_byte(t, ')');
        err_help_fmt(
            f"the fields in order, without names: `{buf_slice(t)}`, matched as `{sym_text(owner)}::{sym_text(name)}(..)`");
        err_try_fmt(buf_slice(t));
        err_end()
    }
}

pub fn parse_function() -> i64 {
    unsafe {
        let start = cur_start();
        // `unsafe fn` (0.9).
        let is_unsafe = eat(Unsafe);
        expect(Fn);
        let n = new_node(NodeKind::Fn, start, 0);
        if is_unsafe {
            NODES[n].p |= FN_UNSAFE;
        }
        NODES[n].a = expect_binding_name();
        NODES[n].g = parse_generic_params(false);
        expect(LParen);
        parse_params(n, false);
        expect(RParen);
        NODES[n].b = parse_return_type();
        NODES[n].c = parse_fn_body(n);
        NODES[n].end = prev_end();
        n
    }
}

// The body of function n; one with a syntax error is marked so (the
// checker leaves it out).
fn parse_fn_body(n: i64) -> i64 {
    unsafe {
        let saved = BODY_FAILED;
        BODY_FAILED = false;
        let body = parse_block();
        if BODY_FAILED {
            NODES[n].p |= FN_BODY_FAILED;
        }
        BODY_FAILED = saved;
        body
    }
}

// `use a::b::c;`, `use a::b::{c, d as e};`, `use a::b as x;` (0.5; 0.4
// had `use E::{A, B};` for the variants of an enum). `use a::b::*;` and
// `use E::*;` are parsed for --fix-imports, and are an error otherwise
// (0.8). c = a Path node whose list is the segments before the braces (or
// the star), b = 1 for `*`, list = the imported names (Ident nodes: a =
// the name, b = its new name, 0 for none).
fn parse_use(public: bool) {
    unsafe {
        let start = cur_start();
        expect(Use);
        let n = new_node(NodeKind::Use, start, 0);
        let path = new_node(NodeKind::Path, cur_start(), 0);
        let segments = list_begin();
        let mark = list_begin();
        let mut last = 0;
        loop {
            let seg = new_node(NodeKind::Ident, cur_start(), 0);
            NODES[seg].a = expect_ident();
            NODES[seg].end = prev_end();
            if !eat(ColonColon) {
                last = seg;
                break;
            }
            list_push(seg);
            if at(Star) || at(LBrace) {
                break;
            }
        }
        list_end(path, segments);
        NODES[path].end = prev_end();
        NODES[n].c = path;
        let items = list_begin();
        if last != 0 {
            if eat(As) {
                NODES[last].b = expect_binding_name();
            }
            list_push(last);
        } else if eat(Star) {
            NODES[n].b = 1;
        } else {
            expect(LBrace);
            while !at(RBrace) && !at(Eof) {
                let item = new_node(NodeKind::Ident, cur_start(), 0);
                NODES[item].a = expect_ident();
                if eat(As) {
                    NODES[item].b = expect_binding_name();
                }
                NODES[item].end = prev_end();
                list_push(item);
                if !eat(Comma) {
                    break;
                }
            }
            expect(RBrace);
        }
        list_end(n, items);
        if NODES[path].count == 0 && NODES[n].b == 0 {
            error_at(start, c"a use names an item through a path: 'use module::item;'");
        }
        expect(Semi);
        NODES[n].end = prev_end();
        mark_public(n, public);
        let _ = mark;
        list_push(n);
    }
}

// `import "header.h" as c;`: the declarations of a C header become part
// of the program (cimport.tach; the driver reads the imports before
// parsing). They live in a module of their own, which the importing
// module names `c`: `c::printf`. `import "header.h";`, which brought
// them all into scope, is parsed for --fix-imports, and is an error
// otherwise (0.8). A Use node with d = 2 and a = that name (0: none).
fn parse_import(public: bool) {
    unsafe {
        let start = cur_start();
        expect(Import);
        if !at(Str) {
            syntax_error(c"expected the name of a C header as a string");
        }
        advance();
        let n = new_node(NodeKind::Use, start, 0);
        NODES[n].d = 2;
        if eat(As) {
            NODES[n].a = expect_binding_name();
        }
        expect(Semi);
        NODES[n].end = prev_end();
        mark_public(n, public);
        list_push(n);
    }
}

// Attributes, then the item: `#[repr(...)]` before a struct, union or
// enum; `#[derive(...)]` (0.15) before a struct or an enum; `#[inline]`, `#[inline(never)]`, `#[cold]` (0.6) before a function.
// `pub` may come before the attributes or (0.6) after them.
fn parse_attributed_item(public: bool) -> i64 {
    unsafe {
        let mut flags = 0;
        let mut fn_flags = 0;
        let mut repr = false;
        let mut align = 0;
        let mut pack = 0;
        let mut int_type = 0;
        let at_start = cur_start();
        let mut derives = 0;
        let mut derive_mark = 0;
        // (0.16: #[sealed], #[scoped])
        let mut struct_flags = 0;
        take_effect_decls(0);
        while at(Hash) {
            let attr_pos = cur_start();
            advance();
            expect(LBracket);
            let name = expect_ident();
            let fn_flag = parse_fn_attribute(name, attr_pos);
            if fn_flag != 0 {
                fn_flags |= fn_flag;
                expect(RBracket);
                continue;
            }
            if name == intern_c(c"derive") {
                // `#[derive(Eq, Ord, ...)]` (0.15): the traits, TyNames in a
                // holder (several derive attributes add to one)
                if derives == 0 {
                    derives = new_node(NodeKind::Generics, attr_pos, 0);
                    derive_mark = list_begin();
                }
                expect(LParen);
                while !at(RParen) && !at(Eof) {
                    list_push(parse_type());
                    if !eat(Comma) {
                        break;
                    }
                }
                expect(RParen);
                expect(RBracket);
                NODES[derives].end = prev_end();
                continue;
            }
            if name == intern_c(c"sealed") || name == intern_c(c"scoped") {
                struct_flags |= if name == intern_c(c"sealed") { STRUCT_SEALED }
                    else { STRUCT_SCOPED };
                expect(RBracket);
                continue;
            }
            if name != intern_c(c"repr") {
                name_error(TOKS[P - 1].start, c"unknown attribute '", name,
                    c"' (expected repr, derive, sealed, scoped, inline, inline(never), cold, effects, pure, no_alloc, no_io or no_panic)");
            }
            repr = true;
            expect(LParen);
            while !at(RParen) && !at(Eof) {
                let pos = cur_start();
                let arg = expect_ident();
                if arg == intern_c(c"C") {
                    flags |= REPR_C;
                } else if arg == intern_c(c"packed") {
                    flags |= REPR_PACKED;
                    pack = 1;
                    if eat(LParen) {
                        // packed(N): fields aligned to at most N (0.4; GCC's
                        // #pragma pack(N)).
                        if !at(Int) {
                            syntax_error(c"expected the packing");
                        }
                        pack = TOKS[P].value as i64;
                        advance();
                        expect(RParen);
                        if pack < 1 || pack > 16 || (pack & (pack - 1)) != 0 {
                            error_at(pos, c"packed(N) needs a power of two from 1 to 16");
                        }
                    }
                } else if arg == intern_c(c"align") {
                    expect(LParen);
                    if !at(Int) {
                        syntax_error(c"expected the alignment");
                    }
                    align = TOKS[P].value as i64;
                    advance();
                    expect(RParen);
                    if align < 1 || align > 4096 || (align & (align - 1)) != 0 {
                        error_at(pos, c"align(N) needs a power of two from 1 to 4096");
                    }
                } else if is_int_type_name(arg) {
                    flags |= REPR_INT;
                    int_type = arg;
                } else {
                    name_error(pos, c"unknown repr '", arg,
                        c"' (expected C, packed, align(N) or an integer type)");
                }
                if !eat(Comma) {
                    break;
                }
            }
            expect(RParen);
            expect(RBracket);
        }
        if derives != 0 {
            list_end(derives, derive_mark);
            if NODES[derives].count == 0 {
                error_at(NODES[derives].start,
                    c"expected the traits to derive: '#[derive(Eq, Ord, Hash, Debug, Clone)]'");
            }
            if !at(Struct) && !at(Enum)
                && !(at(Pub) && (tok_kind(1) == Struct || tok_kind(1) == Enum)) {
                error_at(NODES[derives].start, c"#[derive(...)] goes before a struct or an enum");
            }
        }
        let item_public = eat(Pub) || public;
        if fn_flags != 0 {
            if repr {
                error_at(at_start, c"#[repr(...)] and function attributes cannot be combined");
            }
            if struct_flags != 0 {
                error_at(at_start, c"#[sealed] and #[scoped] are for structs, not functions");
            }
            if !at(Fn) && !(at(Unsafe) && tok_kind(1) == Fn) {
                error_at(at_start, if fn_flags == FN_EFFECT_DECL {
                    c"effect declarations go before a function" }
                    else { c"#[inline] and #[cold] go before a function" });
            }
            check_fn_attributes(fn_flags, at_start);
            let f = parse_function();
            NODES[f].p |= fn_flags;
            take_effect_decls(f);
            mark_public(f, item_public);
            return f;
        }
        if struct_flags != 0 && !at(Struct) {
            error_at(at_start, c"#[sealed] and #[scoped] go before a struct");
        }
        if !at(Struct) && !at(Union) && !at(Enum) {
            error_at(at_start, c"#[repr(...)] goes before a struct, union or enum");
        }
        if ((flags & REPR_PACKED) != 0 || align != 0) && (flags & REPR_C) == 0 {
            error_at(at_start, c"packed and align(N) are only for #[repr(C, ...)] types");
        }
        if (flags & REPR_PACKED) != 0 && align != 0 {
            error_at(at_start, c"a type cannot be both packed and aligned");
        }
        let item = parse_item();
        NODES[item].h = derives;
        NODES[item].c |= struct_flags;
        if NODES[item].kind == NodeKind::Enum {
            if (flags & REPR_PACKED) != 0 || align != 0 {
                error_at(at_start, c"packed and align(N) are for structs and unions, not enums");
            }
            NODES[item].d = int_type;
        } else {
            if (flags & REPR_INT) != 0 {
                error_at(at_start, c"an integer repr is for enums only");
            }
            // For packed types, `d` is the packing (1 for plain packed).
            NODES[item].d = if pack != 0 { pack } else { align };
        }
        NODES[item].c = NODES[item].c | flags;
        mark_public(item, item_public);
        item
    }
}

// Function `f` (a Fn or ExternFn) is one whose parameters cannot have
// defaults (0.15: those of trait functions and extern functions): an
// error at the first one that has one.
pub fn no_param_defaults(f: i64, what: *u8) {
    unsafe {
        for i in 0..NODES[f].count {
            let p = child(f, i);
            if NODES[p].h != 0 {
                err_begin(NODES[NODES[p].h].start);
                err_str(c"a default value is for a parameter of a function or an inherent method, not of ");
                err_str(what);
                err_help(c"remove the '= value'; the callers pass the argument");
                err_end();
            }
        }
    }
}

pub fn parse_return_type() -> i64 {
    if eat(Arrow) { parse_type() } else { 0 }
}

fn parse_struct() -> i64 {
    unsafe {
        let start = cur_start();
        let is_union = at(Union);
        advance();
        let n = new_node(NodeKind::Struct, start, 0);
        if is_union {
            NODES[n].c = REPR_UNION;
        }
        NODES[n].a = expect_binding_name();
        NODES[n].g = parse_generic_params(true);
        expect(LBrace);
        let mark = list_begin();
        while !at(RBrace) && !at(Eof) {
            let field_start = cur_start();
            // `pub` (0.5) is allowed: a field is visible wherever its struct is
            // (0.16: of a #[sealed] struct, only the `pub` ones outside its module).
            let public = eat(Pub);
            let field = new_node(NodeKind::Field, field_start, 0);
            // (0.16: what a #[sealed] struct shows outside its module)
            mark_public(field, public);
            NODES[field].a = expect_binding_name();
            expect(Colon);
            NODES[field].b = parse_type();
            NODES[field].end = prev_end();
            list_push(field);
            if !eat(Comma) {
                break;
            }
        }
        list_end(n, mark);
        expect(RBrace);
        NODES[n].end = prev_end();
        n
    }
}

fn parse_const_or_static(kind: NodeKind) -> i64 {
    unsafe {
        let start = cur_start();
        advance();
        let n = new_node(kind, start, 0);
        if kind == NodeKind::Static {
            NODES[n].d = eat(Mut) as i64;
        }
        NODES[n].a = expect_binding_name();
        expect(Colon);
        NODES[n].b = parse_type();
        expect(Eq);
        NODES[n].c = parse_expr();
        expect(Semi);
        NODES[n].end = prev_end();
        n
    }
}

fn parse_type_alias() -> i64 {
    unsafe {
        let start = cur_start();
        expect(Type);
        let n = new_node(NodeKind::TypeAlias, start, 0);
        NODES[n].a = expect_binding_name();
        // `type Pair<T> = (T, T);` (0.6): generic, its parameters in `g`.
        NODES[n].g = parse_generic_params(false);
        expect(Eq);
        NODES[n].b = parse_type();
        expect(Semi);
        NODES[n].end = prev_end();
        n
    }
}
