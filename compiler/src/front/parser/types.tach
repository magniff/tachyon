// Types: names with type arguments, pointers, slices, arrays, tuples and
// function types; and the type arguments after a name (`Vec<T>`,
// `f::<T>`), splitting the `>` off `>>`.

use crate::base::intern_c;
use crate::base::diag::{err_begin, err_end, err_str, error_at};
use crate::front::ast::{
    EFFECTS_BOUND, NODES, NodeKind, SCRATCH, list_begin, list_end, list_push, new_node,
};
use crate::front::effects::EFFECT_BOUNDS;
use crate::front::lexer::{STRS, TOKS};
use crate::front::lexer::Tok::{
    Amp, AmpAmp, Arrow, Bang, ColonColon, Comma, Ellipsis, Eof, Eq, Extern, Fn, Gt, GtEq, Ident,
    LBracket, LParen, Lt, RBracket, RParen, Reserved, Semi, Shr, ShrEq, Star, Str, Unsafe,
};
use crate::front::parser::{
    NO_STRUCT, P, advance, at, cur, cur_start, eat, expect, expect_ident, help_ampersand_type,
    prev_end, reserved_error, syntax_error, tok_kind, with_no_struct,
};
use crate::front::parser::exprs::parse_expr;

// `<A, B>` type arguments (after a type's name, or `::` in an
// expression); the `>` of `>>` (and of `>=`, `>>=`) is split off.
pub fn parse_type_args() -> i64 {
    unsafe {
        let n = new_node(NodeKind::Generics, cur_start(), 0);
        expect(Lt);
        let mark = list_begin();
        while !at_gt() && !at(Eof) {
            list_push(parse_type());
            if !eat(Comma) {
                break;
            }
        }
        list_end(n, mark);
        if NODES[n].count == 0 {
            error_at(NODES[n].start, c"expected a type argument");
        }
        expect_gt();
        NODES[n].end = prev_end();
        n
    }
}

fn at_gt() -> bool {
    at(Gt) || at(Shr) || at(GtEq) || at(ShrEq)
}

fn expect_gt() {
    let kind = cur();
    if kind == Shr || kind == GtEq || kind == ShrEq {
        // Keep the rest of the token: `>`, `=` or `>=`.
        unsafe {
            TOKS[P].kind = if kind == Shr { Gt } else if kind == GtEq { Eq } else { GtEq };
            TOKS[P].start += 1;
        }
        return;
    }
    expect(Gt);
}

// Whether `name` is a primitive type's name: an integer's, a float's,
// bool.
fn is_primitive_name(name: i64) -> bool {
    unsafe {
        is_int_type_name(name) || name == intern_c(c"f64") || name == intern_c(c"f32")
            || name == intern_c(c"bool")
    }
}

// Whether `name` is an integer type's name (for #[repr(u8)] and so on).
pub fn is_int_type_name(name: i64) -> bool {
    let names: [*u8; 8] = [c"i8", c"i16", c"i32", c"i64", c"u8", c"u16", c"u32", c"u64"];
    for i in 0..8 {
        if unsafe { name == intern_c(names[i]) } {
            return true;
        }
    }
    false
}

// ---- Types ----

// A type's name, `T` or `a::b::T` (0.5: a type in a module; the segments
// before the name are the TyName's list; 0.14: also a projection, `I::Item`).
fn parse_type_name(start: i64) -> i64 {
    unsafe {
        let n = new_node(NodeKind::TyName, start, 0);
        NODES[n].a = expect_ident();
        if at(ColonColon) {
            let mark = list_begin();
            while eat(ColonColon) {
                let seg = new_node(NodeKind::Ident, NODES[n].start, prev_end());
                NODES[seg].a = NODES[n].a;
                list_push(seg);
                NODES[n].a = expect_ident();
            }
            list_end(n, mark);
        }
        n
    }
}

// A bound of a type parameter (0.9; 0.14: the built-in `Fn(A) -> R` and
// `FnMut(A) -> R`, a TyFn with d = 2 or 3, and a trait's associated-type
// constraints, `Iterator<Item = T>`: AssocType nodes in the holder `h`).
pub fn parse_bound() -> i64 {
    unsafe {
        let start = cur_start();
        if !at(Ident) {
            return parse_type();
        }
        // (0.16: `effects(panic)`, an upper bound of the effects of a
        // closure or fn bound to the parameter)
        if tok_kind(1) == LParen && TOKS[P].value as i64 == intern_c(c"effects") {
            advance();
            let n = new_node(NodeKind::EffectSet, start, 0);
            NODES[n].c = EFFECTS_BOUND;
            EFFECT_BOUNDS.push(n);
            parse_effect_list(n);
            return n;
        }
        if tok_kind(1) == LParen {
            let name = TOKS[P].value as i64;
            let d = if name == intern_c(c"Fn") { 2 }
                else if name == intern_c(c"FnMut") { 3 }
                else { 0 };
            if d != 0 {
                advance();
                let n = parse_fn_type_rest(start);
                NODES[n].d = d;
                return n;
            }
        }
        let n = parse_type_name(start);
        if at(Lt) {
            // Type arguments (0.15: `From<U>`) and constraints, `Name = T`
            let lt = cur_start();
            advance();
            let mark = list_begin();
            while !at_gt() && !at(Eof) {
                if at(Ident) && tok_kind(1) == Eq {
                    let c = new_node(NodeKind::AssocType, cur_start(), 0);
                    NODES[c].a = expect_ident();
                    expect(Eq);
                    NODES[c].b = parse_type();
                    NODES[c].end = prev_end();
                    list_push(c);
                } else {
                    list_push(parse_type());
                }
                if !eat(Comma) {
                    break;
                }
            }
            expect_gt();
            let end = SCRATCH.count;
            if end == mark {
                error_at(lt, c"expected a type argument");
            }
            // (the constraints to the holder h, the types to g)
            for pass in 0..2 {
                for i in mark..end {
                    if (NODES[SCRATCH.data[i]].kind == NodeKind::AssocType) == (pass == 0) {
                        list_push(SCRATCH.data[i]);
                    }
                }
                if SCRATCH.count > end {
                    let holder = new_node(NodeKind::Generics, lt, prev_end());
                    list_end(holder, end);
                    if pass == 0 {
                        NODES[n].h = holder;
                    } else {
                        NODES[n].g = holder;
                    }
                }
            }
            SCRATCH.count = mark;
        }
        NODES[n].end = prev_end();
        n
    }
}

// `(alloc(Gpa, extern), io, ...)` after `effects` (0.16), in an attribute
// or a bound: the EffectItem nodes, the list of EffectSet n. The names are
// any identifiers (and `unsafe`); front/effects checks them.
pub fn parse_effect_list(n: i64) {
    unsafe {
        expect(LParen);
        let mark = list_begin();
        while !at(RParen) && !at(Eof) {
            let item = new_node(NodeKind::EffectItem, cur_start(), 0);
            if eat(Unsafe) {
                NODES[item].a = intern_c(c"unsafe");
            } else {
                NODES[item].a = expect_ident();
            }
            if eat(LParen) {
                let imark = list_begin();
                while !at(RParen) && !at(Eof) {
                    if eat(Extern) {
                        NODES[item].b = 1;
                    } else {
                        list_push(parse_type());
                    }
                    if !eat(Comma) {
                        break;
                    }
                }
                list_end(item, imark);
                expect(RParen);
            }
            NODES[item].end = prev_end();
            list_push(item);
            if !eat(Comma) {
                break;
            }
        }
        list_end(n, mark);
        expect(RParen);
        NODES[n].end = prev_end();
    }
}

pub fn parse_type() -> i64 {
    unsafe {
        let start = cur_start();
        let kind = cur();
        if kind == Ident {
            let n = parse_type_name(start);
            // (a primitive type takes no type arguments: `x as i64 < n`
            // compares, 0.11)
            if at(Lt) && !(NODES[n].list == 0 && is_primitive_name(NODES[n].a)) {
                NODES[n].g = parse_type_args();
            }
            NODES[n].end = prev_end();
            return n;
        }
        if kind == Star {
            advance();
            let n = new_node(NodeKind::TyPtr, start, 0);
            NODES[n].a = parse_type();
            NODES[n].end = prev_end();
            return n;
        }
        if kind == Bang {
            advance();
            return new_node(NodeKind::TyNever, start, prev_end());
        }
        if kind == LParen {
            return parse_paren_type(start);
        }
        if kind == LBracket {
            return parse_array_type(start);
        }
        if kind == Fn {
            return parse_fn_type(start);
        }
        if kind == Extern {
            advance();
            if at(Str) {
                let abi = TOKS[P].value as i64;
                if !(STRS[abi].len == 1 && STRS[abi].ptr[0] == 'C') {
                    error_at(cur_start(), c"unsupported ABI; only \"C\" is supported");
                }
                advance();
            }
            let n = parse_fn_type(start);
            NODES[n].d = 1;
            return n;
        }
        if kind == Reserved {
            reserved_error();
        }
        if kind == Amp || kind == AmpAmp {
            err_begin(start);
            err_str(c"expected type, got '&'");
            help_ampersand_type();
            err_end();
        }
        syntax_error(c"expected type")
    }
}

fn parse_paren_type(start: i64) -> i64 {
    expect(LParen);
    if eat(RParen) {
        return new_node(NodeKind::TyUnit, start, prev_end());
    }
    let first = parse_type();
    if !eat(Comma) {
        expect(RParen);
        return first;
    }
    let n = new_node(NodeKind::TyTuple, start, 0);
    let mark = list_begin();
    list_push(first);
    while !at(RParen) && !at(Eof) {
        list_push(parse_type());
        if !eat(Comma) {
            break;
        }
    }
    list_end(n, mark);
    expect(RParen);
    unsafe { NODES[n].end = prev_end(); }
    n
}

fn parse_array_type(start: i64) -> i64 {
    unsafe {
        expect(LBracket);
        let n = new_node(NodeKind::TyArray, start, 0);
        NODES[n].a = parse_type();
        if eat(RBracket) {
            NODES[n].kind = NodeKind::TySlice;
            NODES[n].end = prev_end();
            return n;
        }
        expect(Semi);
        let saved = with_no_struct(false);
        NODES[n].b = parse_expr();
        NO_STRUCT = saved;
        expect(RBracket);
        NODES[n].end = prev_end();
        n
    }
}

fn parse_fn_type(start: i64) -> i64 {
    expect(Fn);
    parse_fn_type_rest(start)
}

// `(A, B) -> R` after `fn` (or a bound's `Fn`, 0.14).
fn parse_fn_type_rest(start: i64) -> i64 {
    unsafe {
        expect(LParen);
        let n = new_node(NodeKind::TyFn, start, 0);
        let mark = list_begin();
        while !at(RParen) && !at(Eof) {
            if at(Ellipsis) {
                error_at(cur_start(),
                    c"function pointer types cannot be variadic; call variadic functions directly");
            }
            list_push(parse_type());
            if !eat(Comma) {
                break;
            }
        }
        list_end(n, mark);
        expect(RParen);
        if eat(Arrow) {
            NODES[n].a = parse_type();
        } else {
            NODES[n].a = new_node(NodeKind::TyUnit, prev_end(), prev_end());
        }
        NODES[n].end = prev_end();
        n
    }
}
