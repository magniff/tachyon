// Blocks and statements (`let`, `defer`, expression statements, items in
// a block), with the recovery after a syntax error in a statement; and
// the patterns of `let`, `match`, `if let` and `for`.

use crate::base::{SYMS, _setjmp, alloc_array, buf_bytes, buf_new, buf_slice, free};
use crate::base::diag::{RECOVER_DEPTH, error_at, recover_enter, recover_leave};
use crate::front::ast::{
    ARM_LET_ELSE, ARM_SYNTHETIC, CONV_INOUT, CONV_NEW, FIELD_SHORTHAND, NODES, NODE_REF,
    NODE_REF_MUT, NodeKind, PAT_FIELDS, PAT_PARENS, PAT_REST, SCRATCH, child, list_begin, list_end,
    list_push, new_node,
};
use crate::front::conv::{rust_spelling, strict_at};
use crate::front::lexer::{TOKS, Tok};
use crate::front::lexer::Tok::{
    Char, Colon, ColonColon, Comma, Const, Defer, DotDot, DotDotEq, Enum, Eof, Eq, Extern, False,
    Float, Fn, For, Ident, If, Impl, Import, Int, LBrace, LParen, Let, Loop, Match, Minus, Mut,
    Pipe, RBrace, RParen, Reserved, Semi, Static, Struct, True, Type, Union, Unsafe, Use, While,
};
use crate::front::parser::{
    BODY_FAILED, NO_STRUCT, P, UNDERSCORE, advance, at, cur, cur_start, eat, expect,
    expect_binding_name, expect_ident, prev_end, reserved_error, skip_statement, syntax_error,
    tok_kind, with_no_struct,
};
use crate::front::parser::exprs::{make_unary, parse_expr, parse_primary};
use crate::front::parser::types::parse_type;

// ---- Blocks and statements ----

pub fn parse_block() -> i64 {
    unsafe {
        let start = cur_start();
        expect(LBrace);
        let saved = with_no_struct(false);
        let block = new_node(NodeKind::Block, start, 0);
        let mark = list_begin();
        var tail = 0;
        while !at(RBrace) && !at(Eof) {
            if eat(Semi) {
                continue;
            }
            if is_item_start(cur()) {
                syntax_error(c"expected '}' (items cannot be nested in blocks)");
            }
            // A recovery point: after an error, on at the next statement.
            let depth = RECOVER_DEPTH;
            let stmts = SCRATCH.count;
            let start = P;
            var stmt = 0;
            if _setjmp(recover_enter()) == 0 {
                if tail != 0 {
                    syntax_error(c"expected ';' or '}' after expression");
                }
                stmt = parse_stmt();
            } else {
                SCRATCH.count = stmts;
                NO_STRUCT = false;
                skip_statement(start);
                BODY_FAILED = true;
            }
            recover_leave(depth);
            if stmt == 0 {
                continue;
            }
            if NODES[stmt].kind == NodeKind::ExprStmt && NODES[stmt].b == 2 {
                // A tail expression.
                tail = NODES[stmt].a;
            } else {
                list_push(stmt);
            }
        }
        list_end(block, mark);
        NODES[block].a = tail;
        expect(RBrace);
        NO_STRUCT = saved;
        NODES[block].end = prev_end();
        block
    }
}

pub fn is_item_start(kind: Tok) -> bool {
    kind == Fn || kind == Extern || kind == Struct || kind == Const
        || kind == Static || kind == Type || kind == Enum || kind == Impl
        || kind == Union || kind == Import || kind == Use
}

// `name:` before `loop`, `while` or `for`.
pub fn at_label() -> bool {
    let after = tok_kind(2);
    at(Ident) && tok_kind(1) == Colon
        && (after == Loop || after == While || after == For)
}

pub fn at_block_like() -> bool {
    let kind = cur();
    kind == LBrace || kind == If || kind == Loop || kind == While
        || kind == For || kind == Match || at_label() || (kind == Unsafe && tok_kind(1) == LBrace)
}

fn expr_stmt(expr: i64, has_semi: i64, start: i64) -> i64 {
    let n = new_node(NodeKind::ExprStmt, start, prev_end());
    unsafe {
        NODES[n].a = expr;
        NODES[n].b = has_semi;
    }
    n
}

// A statement; an NodeKind::ExprStmt with b == 2 is the block's tail expression.
pub fn parse_stmt() -> i64 {
    let start = cur_start();
    if at(Let) || at_var_binding() {
        return parse_let();
    }
    if at(Defer) {
        return parse_defer();
    }
    if at_block_like() {
        // Ends at its closing brace; a `;` right after belongs to it.
        let expr = parse_primary();
        if at(RBrace) {
            return expr_stmt(expr, 2, start);
        }
        let has_semi = eat(Semi);
        return expr_stmt(expr, has_semi as i64, start);
    }
    let expr = parse_expr();
    if at(Semi) {
        advance();
        return expr_stmt(expr, 1, start);
    }
    if at(RBrace) {
        return expr_stmt(expr, 2, start);
    }
    unsafe { syntax_error(c"expected ';' or '}' after expression") }
}

// `defer expr;` or `defer { ... }` (0.6).
fn parse_defer() -> i64 {
    unsafe {
        let start = cur_start();
        expect(Defer);
        let n = new_node(NodeKind::Defer, start, 0);
        if at(LBrace) {
            NODES[n].a = parse_block();
            eat(Semi);
        } else {
            NODES[n].a = parse_expr();
            expect(Semi);
        }
        NODES[n].end = prev_end();
        n
    }
}

fn parse_let() -> i64 {
    unsafe {
        let start = cur_start();
        // (0.20) `var PAT = e;` (mutable bindings: `let mut`), `inout x = e;`
        // (an exclusive access: `let x = &mut place`), conventions.md §5.2
        let is_var = !at(Let);
        let is_inout = at(Tok::Inout);
        advance();
        let n = new_node(NodeKind::Let, start, 0);
        var let_mut = false;
        if strict_at(start) && !is_var && at(Mut) && tok_kind(1) == Ident {
            // (`let mut x`: one error, for both words)
            rust_spelling(start, TOKS[P].end, "a mutable binding is 'var x'", "var");
            advance();
            let_mut = true;
        }
        NODES[n].a = parse_pattern();
        if let_mut {
            mark_mutable(NODES[n].a);
        }
        if is_var {
            NODES[n].p |= CONV_NEW;
            if is_inout {
                NODES[n].p |= CONV_INOUT;
            } else {
                mark_mutable(NODES[n].a);
            }
        }
        if eat(Colon) {
            NODES[n].b = parse_type();
            if is_inout && NODES[NODES[n].b].kind != NodeKind::TySlice {
                // `inout x: T = ..`: x designates a T (until T1, `&mut T`)
                let t = new_node(NodeKind::TyPtr, NODES[NODES[n].b].start, NODES[NODES[n].b].end);
                NODES[t].a = NODES[n].b;
                NODES[t].p |= CONV_NEW | NODE_REF | NODE_REF_MUT;
                NODES[n].b = t;
            } else if is_inout {
                NODES[NODES[n].b].p |= CONV_NEW | NODE_REF_MUT;
            }
        }
        if at(Semi) {
            error_at(cur_start(),
                c"'let' without an initializer is not supported; give the binding a value");
        }
        expect(Eq);
        NODES[n].c = parse_expr();
        if is_inout {
            let c = NODES[n].c;
            if NODES[c].kind == NodeKind::Unary && NODES[c].op == Tok::Amp {
                // `inout x = &place`: the marker lends the place exclusively
                NODES[c].p |= NODE_REF_MUT;
            }
        }
        if at(Tok::Else) {
            let_else(n);
        }
        expect(Semi);
        NODES[n].end = prev_end();
        n
    }
}

// (0.20) The bindings of pattern p made mutable (`var (a, b) = t`).
fn mark_mutable(p: i64) {
    unsafe {
        if p <= 0 {
            return;
        }
        let k = NODES[p].kind;
        if k == NodeKind::PatBind {
            NODES[p].b = 1;
            return;
        }
        if k == NodeKind::FieldInit {
            mark_mutable(NODES[p].b);
            return;
        }
        for i in 0..NODES[p].count {
            mark_mutable(child(p, i));
        }
    }
}

// (0.20) Whether a statement starts here with `var PAT =` or `inout x =`
// (keywords from 0.21).
fn at_var_binding() -> bool {
    at(Tok::Var) || at(Tok::Inout)
}

// (0.18.1) `let PAT = e else { .. };` (n, at the `else`): `let (a, b) =
// match e { PAT => (a, b), _ => { .. } };` with PAT's bindings (one: `let
// a`; none: `let _`), the else block an arm that must not end normally
// (ARM_LET_ELSE). A binding is a name that starts with a lower-case
// letter or `_`, as Rust's; the nodes made have no text of their own.
fn let_else(n: i64) {
    unsafe {
        let else_at = cur_start();
        expect(Tok::Else);
        if NODES[n].b != 0 {
            error_at(else_at, c"a type on a 'let ... else' pattern is not supported: give the value its type ('e as T', or a typed 'let' before)");
        }
        if !at(LBrace) {
            error_at(cur_start(),
                c"'let ... else' takes a block: 'let Some(x) = e else { return; };'");
        }
        let block = parse_block();
        let pat = NODES[n].a;
        let init = NODES[n].c;
        let at0 = NODES[pat].start;
        let mark = list_begin();
        let_else_bindings(pat);
        let count = SCRATCH.count - mark;
        let names = alloc_array::<i64>(count + 1);
        for i in 0..count {
            names[i] = SCRATCH.data[mark + i];
        }
        SCRATCH.count = mark;
        // The value of the matching arm, and the outer pattern.
        var value = 0;
        var outer = 0;
        if count == 0 {
            value = new_node(NodeKind::Unit, at0, at0);
            outer = new_node(NodeKind::PatWild, at0, at0);
        } else if count == 1 {
            value = new_node(NodeKind::Ident, at0, at0);
            NODES[value].a = NODES[names[0]].a;
            outer = new_node(NodeKind::PatBind, at0, at0);
            NODES[outer].a = NODES[names[0]].a;
            NODES[outer].b = NODES[names[0]].b;
        } else {
            value = new_node(NodeKind::Tuple, at0, at0);
            outer = new_node(NodeKind::PatTuple, at0, at0);
            let vm = list_begin();
            for i in 0..count {
                let id = new_node(NodeKind::Ident, at0, at0);
                NODES[id].a = NODES[names[i]].a;
                list_push(id);
            }
            list_end(value, vm);
            let pm = list_begin();
            for i in 0..count {
                let b = new_node(NodeKind::PatBind, at0, at0);
                NODES[b].a = NODES[names[i]].a;
                NODES[b].b = NODES[names[i]].b;
                list_push(b);
            }
            list_end(outer, pm);
        }
        free(names as *u8);
        let arm = new_node(NodeKind::Arm, NODES[pat].start, NODES[pat].end);
        NODES[arm].a = pat;
        NODES[arm].c = value;
        let other = new_node(NodeKind::Arm, else_at, NODES[block].end);
        NODES[other].a = new_node(NodeKind::PatWild, else_at, else_at);
        NODES[other].c = block;
        NODES[other].p = ARM_LET_ELSE | ARM_SYNTHETIC;
        let m = new_node(NodeKind::Match, NODES[init].start, NODES[block].end);
        NODES[m].a = init;
        let am = list_begin();
        list_push(arm);
        list_push(other);
        list_end(m, am);
        NODES[n].a = outer;
        NODES[n].c = m;
    }
}

// The bindings of let-else pattern p (PatBind nodes) onto SCRATCH: names
// that start with a lower-case letter or `_` (the others name constants
// and variants).
fn let_else_bindings(p: i64) {
    unsafe {
        let k = NODES[p].kind;
        if k == NodeKind::PatBind {
            let t = SYMS[NODES[p].a].text;
            if t.len > 0 && (t[0] >= 'a' && t[0] <= 'z' || t[0] == '_') {
                list_push(p);
            }
            return;
        }
        if k == NodeKind::PatOr {
            if NODES[p].count > 0 {
                let_else_bindings(child(p, 0));
            }
            return;
        }
        if k == NodeKind::PatTuple || k == NodeKind::PatVariant {
            for i in 0..NODES[p].count {
                let c = child(p, i);
                let_else_bindings(if NODES[c].kind == NodeKind::FieldInit { NODES[c].b }
                    else { c });
            }
        }
    }
}

// ---- Patterns ----

// A pattern: alternatives separated by `|`.
pub fn parse_pattern() -> i64 {
    let start = cur_start();
    let first = parse_single_pattern();
    if !at(Pipe) {
        return first;
    }
    let n = new_node(NodeKind::PatOr, start, 0);
    let mark = list_begin();
    list_push(first);
    while eat(Pipe) {
        list_push(parse_single_pattern());
    }
    list_end(n, mark);
    unsafe { NODES[n].end = prev_end(); }
    n
}

fn at_literal_pattern() -> bool {
    let kind = cur();
    kind == Int || kind == Char || kind == True || kind == False
        || (kind == Minus && (tok_kind(1) == Int || tok_kind(1) == Float)) || kind == Float
}

// A literal (or a constant's name) in a pattern: an expression node.
fn parse_pattern_literal() -> i64 {
    let start = cur_start();
    if at(Minus) {
        advance();
        let operand = parse_primary();
        return make_unary(Minus, operand, start);
    }
    if at(Ident) && tok_kind(1) != ColonColon {
        let n = new_node(NodeKind::Ident, start, 0);
        unsafe {
            NODES[n].a = expect_ident();
            NODES[n].end = prev_end();
        }
        return n;
    }
    parse_primary()
}

// `lo ..= hi` after the low end has been parsed.
fn parse_range_pattern(start: i64, low: i64) -> i64 {
    unsafe {
        if at(DotDot) {
            error_at(cur_start(), c"exclusive range patterns are not supported; use 'a..=b'");
        }
        expect(DotDotEq);
        let n = new_node(NodeKind::PatRange, start, 0);
        NODES[n].a = low;
        if !(at_literal_pattern() || at(Ident)) {
            syntax_error(c"expected the end of the range pattern");
        }
        NODES[n].b = parse_pattern_literal();
        NODES[n].end = prev_end();
        n
    }
}

pub fn parse_single_pattern() -> i64 {
    unsafe {
        let start = cur_start();
        if at(Ident) && TOKS[P].value as i64 == UNDERSCORE {
            advance();
            return new_node(NodeKind::PatWild, start, prev_end());
        }
        if at(Tok::Inout) || at(Tok::Sink) {
            // (0.21: keywords, no names)
            crate::front::parser::convention_word_error();
        }
        if at(Mut) || at(Tok::Var) {
            // (0.20) `var x` (0.19: `mut x`; in 0.20's spelling conv.rust)
            if at(Mut) && strict_at(start) {
                mut_binding(start);
            }
            advance();
            let n = new_node(NodeKind::PatBind, start, 0);
            NODES[n].a = expect_binding_name();
            NODES[n].b = 1;
            NODES[n].end = prev_end();
            return n;
        }
        if at_literal_pattern() {
            let low = parse_pattern_literal();
            if at(DotDotEq) || at(DotDot) {
                return parse_range_pattern(start, low);
            }
            let n = new_node(NodeKind::PatLit, start, prev_end());
            NODES[n].a = low;
            return n;
        }
        if at(Ident) && tok_kind(1) == ColonColon {
            return parse_variant_pattern(start);
        }
        if at(Ident) && (tok_kind(1) == DotDotEq || tok_kind(1) == DotDot) {
            let low = parse_pattern_literal();
            return parse_range_pattern(start, low);
        }
        if at(Ident) && tok_kind(1) == LParen {
            // `V(p, ...)`: a variant brought into scope by `use` (0.4); its
            // enum is found by the checker (d = 1).
            let n = new_node(NodeKind::PatVariant, start, 0);
            NODES[n].b = expect_ident();
            NODES[n].d = 1;
            NODES[n].c = 1;
            NODES[n].p |= PAT_PARENS;
            expect(LParen);
            let mark = list_begin();
            while !at(RParen) && !at(Eof) {
                list_push(parse_pattern());
                if !eat(Comma) {
                    break;
                }
            }
            list_end(n, mark);
            expect(RParen);
            NODES[n].end = prev_end();
            return n;
        }
        if at(Ident) && tok_kind(1) == LBrace {
            // `V { a, .. }` (0.17): a variant brought into scope by `use`.
            let n = new_node(NodeKind::PatVariant, start, 0);
            NODES[n].b = expect_ident();
            NODES[n].d = 1;
            parse_pattern_fields(n);
            return n;
        }
        if at(Ident) {
            let n = new_node(NodeKind::PatBind, start, 0);
            NODES[n].a = expect_ident();
            NODES[n].end = prev_end();
            return n;
        }
        if at(LParen) {
            return parse_tuple_pattern(start);
        }
        if at(Reserved) {
            reserved_error();
        }
        syntax_error(c"expected a pattern")
    }
}

// `E::V` or `E::V(p, ...)`; `m::E::V` (0.5): h = a Path of the segments
// before the enum's name.
fn parse_variant_pattern(start: i64) -> i64 {
    unsafe {
        let n = new_node(NodeKind::PatVariant, start, 0);
        let mark = list_begin();
        var name = expect_ident();
        expect(ColonColon);
        var member = expect_ident();
        while at(ColonColon) {
            advance();
            let seg = new_node(NodeKind::Ident, start, prev_end());
            NODES[seg].a = name;
            list_push(seg);
            name = member;
            member = expect_ident();
        }
        if SCRATCH.count > mark {
            let prefix = new_node(NodeKind::Path, start, prev_end());
            list_end(prefix, mark);
            NODES[n].h = prefix;
        }
        NODES[n].a = name;
        NODES[n].b = member;
        if at(LBrace) {
            parse_pattern_fields(n);
        } else if eat(LParen) {
            NODES[n].c = 1;
            NODES[n].p |= PAT_PARENS;
            let mark = list_begin();
            while !at(RParen) && !at(Eof) {
                list_push(parse_pattern());
                if !eat(Comma) {
                    break;
                }
            }
            list_end(n, mark);
            expect(RParen);
        }
        NODES[n].end = prev_end();
        if NODES[n].c == 0 && (at(DotDotEq) || at(DotDot)) {
            // `E::A..=E::C` (0.4).
            if at(DotDot) {
                error_at(cur_start(), c"exclusive range patterns are not supported; use 'a..=b'");
            }
            advance();
            let r = new_node(NodeKind::PatRange, start, 0);
            NODES[r].a = n;
            if at(Ident) && tok_kind(1) == ColonColon {
                NODES[r].b = parse_variant_pattern(cur_start());
            } else {
                // (0.17) `i8::MIN..=-1`: a constant's path (made a Path
                // by the checker when the value is an integer)
                if !(at_literal_pattern() || at(Ident)) {
                    syntax_error(c"expected the end of the range pattern");
                }
                NODES[r].b = parse_pattern_literal();
            }
            NODES[r].end = prev_end();
            return r;
        }
        n
    }
}

// (0.17) The fields of a variant's pattern `{ a, b: p, mut c, .. }`, after
// its name: FieldInit nodes in n's list (a: the name, b: the pattern; `a`
// alone binds a), n flagged PAT_FIELDS (and PAT_REST with `..`).
fn parse_pattern_fields(n: i64) {
    unsafe {
        expect(LBrace);
        NODES[n].c = 1;
        NODES[n].p |= PAT_FIELDS;
        let mark = list_begin();
        while !at(RBrace) && !at(Eof) {
            if at(DotDot) {
                advance();
                NODES[n].p |= PAT_REST;
                if !at(RBrace) {
                    syntax_error(c"expected '}' after '..' (it comes last in a variant's pattern)");
                }
                break;
            }
            let start = cur_start();
            let field = new_node(NodeKind::FieldInit, start, 0);
            // (0.20) `var a` (0.19: `mut a`)
            if at(Mut) && strict_at(start) {
                mut_binding(start);
            }
            let mutable = eat(Mut)
                || eat(Tok::Var);
            NODES[field].a = expect_binding_name();
            if !mutable && eat(Colon) {
                NODES[field].b = parse_pattern();
            } else {
                // `a` (or `mut a`): `a: a`
                let bind = new_node(NodeKind::PatBind, start, prev_end());
                NODES[bind].a = NODES[field].a;
                NODES[bind].b = mutable as i64;
                NODES[field].b = bind;
                NODES[field].p |= FIELD_SHORTHAND;
            }
            NODES[field].end = prev_end();
            list_push(field);
            if !eat(Comma) {
                break;
            }
        }
        list_end(n, mark);
        expect(RBrace);
        NODES[n].end = prev_end();
    }
}

// (0.20) conv.rust for `mut x` in a pattern, at `mut`: `var x`.
fn mut_binding(start: i64) {
    unsafe {
        if tok_kind(1) != Ident {
            return;
        }
        let new = buf_new();
        buf_bytes(new, "var ");
        buf_bytes(new, SYMS[TOKS[P + 1].value as i64].text);
        rust_spelling(start, TOKS[P + 1].end, "a mutable binding is 'var x'", buf_slice(new));
    }
}

fn parse_tuple_pattern(start: i64) -> i64 {
    unsafe {
        expect(LParen);
        let n = new_node(NodeKind::PatTuple, start, 0);
        let mark = list_begin();
        var trailing_comma = false;
        while !at(RParen) && !at(Eof) {
            list_push(parse_pattern());
            trailing_comma = eat(Comma);
            if !trailing_comma {
                break;
            }
        }
        expect(RParen);
        if SCRATCH.count - mark == 1 && !trailing_comma {
            let only = SCRATCH.data[mark];
            SCRATCH.count = mark;
            return only;
        }
        list_end(n, mark);
        NODES[n].end = prev_end();
        n
    }
}
