// `extern "C"` items: blocks of C declarations (functions and statics,
// with their link names), functions with the C convention, and statics
// with a C symbol.

use crate::back::objfile::output::add_link_decl;
use crate::base::{IntVec, intern, intern_c, sym_name};
use crate::base::diag::error_at;
use crate::front::ast::{NODES, NodeKind, SCRATCH, list_push, new_node};
use crate::front::check::name_error;
use crate::front::lexer::{TOKS, str_at};
use crate::front::lexer::Tok::{
    Arrow, Colon, Comma, Eof, Eq, Extern, Fn, Hash, Ident, LBrace, LBracket, LParen, Pub, RBrace,
    RBracket, RParen, Semi, Static, Str,
};
use crate::front::parser::{
    P, advance, at, cur_start, eat, expect, expect_binding_name, expect_ident, prev_end,
    syntax_error, tok_kind,
};
use crate::front::parser::exprs::parse_expr;
use crate::front::parser::items::{no_param_defaults, parse_function, parse_return_type};
use crate::front::parser::items::attrs::{
    has_effect_decls, parse_effect_attribute, take_effect_decls,
};
use crate::front::parser::items::params::parse_params;
use crate::front::parser::types::parse_type;
use crate::gen0::target::LINK_NAMES;

// (0.25) At `#[link(...)]`.
pub fn at_link_attribute() -> bool {
    unsafe {
        tok_kind(0) == Hash && tok_kind(1) == LBracket && tok_kind(2) == Ident
            && TOKS[P + 2].value as i64 == intern_c(c"link") && tok_kind(3) == LParen
    }
}

// (0.25) The links of the `#[link]`s read, for the block that follows:
// a kind ('F' a framework, 'l' a library) and the name's string id, two
// words each.
static var LINK_PENDING: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// (0.25) `#[link(...)]`s before an extern block: what the program links
// when it calls into the block (back::objfile::output::add_link_decl), so
// a std module the program does not use links nothing. `framework =
// "Metal"` (macOS's; Linux leaves it out) or `lib = "objc"` (`-lobjc`);
// Rust's `name = "objc"`, with `kind = "framework"` for a framework, too.
// Several in one attribute, separated by commas, and several attributes.
// The block follows; link_block takes them when it is read.
pub fn parse_link_attributes() {
    unsafe {
        let start = cur_start();
        while at_link_attribute() {
            advance();
            advance();
            advance();
            advance();
            var name = 0 - 1;
            var framework = false;
            while !at(RParen) && !at(Eof) {
                let pos = cur_start();
                let key = expect_ident();
                expect(Eq);
                if !at(Str) {
                    syntax_error(c"expected a string: `#[link(framework = \"Metal\")]` or `#[link(lib = \"objc\")]`");
                }
                let value = TOKS[P].value as i64;
                advance();
                if key == intern_c(c"framework") || key == intern_c(c"lib") {
                    LINK_PENDING.push(if key == intern_c(c"framework") { 'F' } else { 'l' } as i64);
                    LINK_PENDING.push(value);
                } else if key == intern_c(c"name") {
                    name = value;
                } else if key == intern_c(c"kind") {
                    let kind = str_at(value);
                    if kind == "framework" {
                        framework = true;
                    } else if kind != "dylib" && kind != "static" {
                        error_at(pos, c"a link's kind is \"framework\", \"dylib\" or \"static\"");
                    }
                } else {
                    name_error(pos, c"unknown key '", key,
                        c"' in #[link] (expected framework, lib, name or kind)");
                }
                if !eat(Comma) {
                    break;
                }
            }
            expect(RParen);
            expect(RBracket);
            if name >= 0 {
                LINK_PENDING.push(if framework { 'F' } else { 'l' } as i64);
                LINK_PENDING.push(name);
            }
        }
        if !at(Extern) && !(at(Pub) && tok_kind(1) == Extern) {
            error_at(start, c"#[link] goes before an extern block: `#[link(lib = \"objc\")] extern \"C\" { ... }`");
        }
    }
}

// (0.25) The block of the `#[link]`s just read was read: its items are
// SCRATCH from `mark`. Each link is the program's when the program calls
// one of its functions or uses one of its statics (by their C symbols);
// a block of none links always.
pub fn link_block(mark: i64) {
    unsafe {
        var syms = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in mark..SCRATCH.count {
            let item = SCRATCH.data[i];
            if NODES[item].kind == NodeKind::ExternFn
                || (NODES[item].kind == NodeKind::Static && NODES[item].y == 1) {
                let link = LINK_NAMES.get(NODES[item].a + 1);
                syms.push(sym_name(if link > 0 { link - 1 } else { NODES[item].a }) as i64);
            }
        }
        var k = 0;
        while k < LINK_PENDING.count {
            add_link_decl(LINK_PENDING.data[k] as u8, str_at(LINK_PENDING.data[k + 1]), &syms);
            k += 2;
        }
        LINK_PENDING.count = 0;
    }
}

// After `extern "C"`: a block of C declarations, `extern "C" { fn f(...)
// -> T; static mut x: T; }`; a function with the C convention and an
// unmangled symbol, `extern "C" fn f(...) -> T { ... }`; or a static with
// a C symbol, `extern "C" static mut x: T = v;`. Items are pushed to the
// program's list. (0.2's single declarations, `extern fn f(...) -> T;`,
// were removed in 0.4.)
pub fn parse_extern() {
    unsafe {
        let start = cur_start();
        expect(Extern);
        if !at(Str) {
            error_at(start, c_fn_outside_block());
        }
        let abi = TOKS[P].value as i64;
        if !(str_at(abi).len == 1 && str_at(abi).ptr[0] == 'C') {
            error_at(cur_start(), c"unsupported ABI; only \"C\" is supported");
        }
        advance();
        if eat(LBrace) {
            while !at(RBrace) && !at(Eof) {
                let link = parse_link_name();
                let item = if at(Fn) {
                    parse_c_function(cur_start(), true)
                } else if at(Static) {
                    parse_c_static(cur_start(), false)
                } else {
                    syntax_error(c"expected 'fn', 'static' or '}' in an extern block")
                };
                if NODES[item].kind == NodeKind::Static {
                    if has_effect_decls() {
                        error_at(NODES[item].start, c"effect declarations are for functions");
                    }
                    take_effect_decls(0);
                } else {
                    take_effect_decls(item);
                }
                if link >= 0 {
                    if NODES[item].kind != NodeKind::ExternFn
                        && !(NODES[item].kind == NodeKind::Static && NODES[item].y == 1) {
                        error_at(NODES[item].start,
                            c"#[link_name] is for the functions and statics of an extern block");
                    }
                    LINK_NAMES.put(NODES[item].a + 1, link + 1);
                }
                list_push(item);
            }
            expect(RBrace);
            return;
        }
        if at(Static) {
            list_push(parse_c_static(start, true));
            return;
        }
        list_push(parse_c_function(start, false));
    }
}

fn c_fn_outside_block() -> *u8 {
    c"C functions are declared in an extern block: `extern \"C\" { fn f(...) -> T; }` (the 0.2 form `extern fn f(...) -> T;` was removed in 0.4)"
}

// `#[link_name = "symbol"]` before a declaration in an extern block: the
// C symbol it stands for, when that is not its name. -1: none. (0.16) Also
// effect declarations (`#[effects(io)]`, `#[pure]`, ...), left for
// take_effect_decls.
fn parse_link_name() -> i64 {
    unsafe {
        var sym = -1;
        take_effect_decls(0);
        while at(Hash) {
            advance();
            expect(LBracket);
            let pos = cur_start();
            let name = expect_ident();
            if parse_effect_attribute(name, pos) {
                expect(RBracket);
                continue;
            }
            if name != intern_c(c"link_name") {
                name_error(pos, c"unknown attribute '", name,
                    c"' in an extern block (expected link_name, effects, pure, no_alloc, no_io or no_panic)");
            }
            expect(Eq);
            if !at(Str) {
                syntax_error(c"expected the symbol's name as a string");
            }
            sym = intern(str_at(TOKS[P].value as i64));
            advance();
            expect(RBracket);
        }
        sym
    }
}

// `fn f(...) -> T;` (a C function, only in an extern block) or `fn
// f(...) -> T { ... }` (one with the C convention, defined here).
fn parse_c_function(start: i64, in_block: bool) -> i64 {
    unsafe {
        if tok_kind(2) == LParen {
            // Look past the parameters for the body.
            let saved = P;
            advance();
            advance();
            var depth = 0;
            while !at(Eof) {
                if at(LParen) {
                    depth += 1;
                } else if at(RParen) {
                    depth -= 1;
                    if depth == 0 {
                        break;
                    }
                }
                advance();
            }
            advance();
            // (the result type is skipped, not parsed: parse_type splits a
            // `>>` in place, which the parse after the rewind would not see)
            if eat(Arrow) {
                var nest = 0;
                while !at(Eof) && !(nest == 0 && (at(LBrace) || at(Semi))) {
                    if at(LBracket) || at(LParen) {
                        nest += 1;
                    } else if at(RBracket) || at(RParen) {
                        nest -= 1;
                    }
                    advance();
                }
            }
            let has_body = at(LBrace);
            P = saved;
            if has_body {
                let f = parse_function();
                no_param_defaults(f, c"an extern \"C\" function");
                NODES[f].start = start;
                NODES[f].y = 1;
                return f;
            }
        }
        if !in_block {
            error_at(start, c_fn_outside_block());
        }
        expect(Fn);
        let n = new_node(NodeKind::ExternFn, start, 0);
        NODES[n].a = expect_binding_name();
        expect(LParen);
        NODES[n].d = parse_params(n, true) as i64;
        no_param_defaults(n, c"an extern function");
        expect(RParen);
        NODES[n].b = parse_return_type();
        expect(Semi);
        NODES[n].end = prev_end();
        n
    }
}

// `static [mut] x: T;` (defined in C) or, when `defines`, also `static
// [mut] x: T = v;` (defined here, with a C symbol).
fn parse_c_static(start: i64, defines: bool) -> i64 {
    unsafe {
        expect(Static);
        let n = new_node(NodeKind::Static, start, 0);
        NODES[n].d = crate::front::parser::eat_static_mut(n) as i64;
        NODES[n].a = expect_binding_name();
        expect(Colon);
        NODES[n].b = parse_type();
        NODES[n].y = 1;
        if defines && eat(Eq) {
            NODES[n].c = parse_expr();
            NODES[n].y = 2;
        }
        expect(Semi);
        NODES[n].end = prev_end();
        n
    }
}
