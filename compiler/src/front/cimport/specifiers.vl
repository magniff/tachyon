// C declaration specifiers: `__attribute__` and `__asm__` labels, storage
// classes and qualifiers, the type specifiers (with the target's C types:
// long double, __builtin_va_list), and struct, union and enum
// definitions with their members.

use crate::base::{
    IntVec, SYMS, buf_bytes, buf_new, buf_slice, grow, intern, intern_c, streq, sym_name,
};
use crate::front::cimport::{
    CENUMERATORS, CENUMERATOR_CAP, CENUMERATOR_COUNT, CENUMS, CENUM_CAP, CENUM_COUNT, CEnum,
    CEnumerator, CFIELDS, CFIELD_CAP, CFIELD_COUNT, CField, CRECS, CTYPES, CTY_BOOL, CTY_F32,
    CTY_F64, CTY_VOID, D_N, D_POS, ENUMERATOR_OF, TAG_OF, TYPEDEF_OF, crec_new, cty_bad, cty_int,
    cty_integer, cty_new, cty_ptr, cty_signed, d_eat, d_expect, d_fail, d_is, d_is_at,
    d_skip_parens, dcur, dpeek,
};
use crate::front::cimport::CT::{Array, Bad, Enum, Named, Record};
use crate::front::cimport::decls::{D_PACK, d_declarator, d_pack_markers};
use crate::front::cpp::{CINTS, CK, CTOKS, C_EOF, ctok_text};
use crate::front::cpp::eval::{EV_FAIL, eval_tokens};

// ---- Attributes ----

// What `__attribute__((...))` and `__asm__("...")` said about the
// declaration being read.
pub static var A_PACKED: bool = false;
pub static var A_ALIGN: i64 = 0;
pub static var A_MODE: i64 = 0;
pub static var A_LINK: i64 = -1;
pub static var A_NORETURN: bool = false;
pub static var A_UNAVAILABLE: bool = false;
pub static var A_VECTOR: bool = false;

pub fn attrs_reset() {
    A_PACKED = false;
    A_ALIGN = 0;
    A_MODE = 0;
    A_LINK = -1;
    A_NORETURN = false;
    A_UNAVAILABLE = false;
    A_VECTOR = false;
}

// An attribute's name without GNU's underscores: __packed__ is packed.
fn attr_name(t: i64) -> *u8 {
    let s = unsafe { SYMS[CTOKS[t].text].text };
    var lo = 0;
    var hi = s.len as i64;
    if hi > 4 && s[0] == '_' && s[1] == '_' && s[hi - 1] == '_' && s[hi - 2] == '_' {
        lo = 2;
        hi -= 2;
    }
    sym_name(intern(s[lo..hi]))
}

// Attributes and asm labels, wherever they may appear.
pub fn d_attributes() {
    unsafe {
        loop {
            if d_is(c"__attribute__") || d_is(c"__attribute") {
                D_POS += 1;
                d_expect(c"(");
                d_expect(c"(");
                while !d_is(c")") && D_POS < D_N {
                    if d_is(c",") {
                        D_POS += 1;
                        continue;
                    }
                    let t = dcur();
                    D_POS += 1;
                    let name = attr_name(t);
                    if streq(name, c"packed") {
                        A_PACKED = true;
                    } else if streq(name, c"noreturn") {
                        A_NORETURN = true;
                    } else if streq(name, c"unavailable") {
                        A_UNAVAILABLE = true;
                    } else if streq(name, c"vector_size") || streq(name, c"ext_vector_type") {
                        A_VECTOR = true;
                    } else if streq(name, c"aligned") {
                        if d_is(c"(") {
                            let (v, ok) = d_paren_value();
                            if ok {
                                A_ALIGN = v;
                            }
                        } else {
                            A_ALIGN = 16;
                        }
                        continue;
                    } else if streq(name, c"mode") && d_is(c"(") {
                        D_POS += 1;
                        let m = attr_name(dcur());
                        A_MODE = if streq(m, c"QI") || streq(m, c"byte") { 8 }
                            else if streq(m, c"HI") { 16 } else if streq(m, c"SI") { 32 }
                            else if streq(m, c"DI") || streq(m, c"word")
                            || streq(m, c"pointer") { 64 } else { -1 };
                        D_POS += 1;
                        d_expect(c")");
                        continue;
                    }
                    if d_is(c"(") {
                        d_skip_parens();
                    }
                }
                d_expect(c")");
                d_expect(c")");
            } else if d_is(c"__asm__") || d_is(c"__asm") || d_is(c"asm") {
                D_POS += 1;
                d_expect(c"(");
                let b = buf_new();
                while dcur() != C_EOF && CTOKS[dcur()].kind == CK::Str {
                    let s = SYMS[CTOKS[dcur()].text].text;
                    buf_bytes(b, s[1..s.len as i64 - 1]);
                    D_POS += 1;
                }
                d_expect(c")");
                A_LINK = intern(buf_slice(b));
            } else if d_is(c"__declspec") {
                D_POS += 1;
                d_skip_parens();
            } else {
                return;
            }
        }
    }
}

// `( constant-expression )`: its value.
fn d_paren_value() -> (i64, bool) {
    unsafe {
        let open = dcur();
        if !d_eat(c"(") {
            return (0, false);
        }
        let list = d_collect_until(c")", c")");
        d_expect(c")");
        let (v, _) = eval_tokens(list, open, true);
        (v as i64, !EV_FAIL)
    }
}

// The tokens up to `a` or `b` at depth 0 (not consumed).
pub fn d_collect_until(a: *u8, b: *u8) -> IntVec {
    unsafe {
        var out = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var depth = 0;
        while D_POS < D_N {
            if depth == 0 && (d_is(a) || d_is(b)) {
                break;
            }
            if d_is(c"(") || d_is(c"[") || d_is(c"{") {
                depth += 1;
            } else if d_is(c")") || d_is(c"]") || d_is(c"}") {
                if depth == 0 {
                    break;
                }
                depth -= 1;
            }
            out.push(dcur());
            D_POS += 1;
        }
        out
    }
}

// ---- Specifiers ----

pub const SP_TYPEDEF: i64 = 1;

pub const SP_EXTERN: i64 = 2;

pub const SP_STATIC: i64 = 4;

pub const SP_INLINE: i64 = 8;

pub const SP_NORETURN: i64 = 16;

pub const SP_CONST: i64 = 32;

pub const SP_THREAD: i64 = 64;

pub fn is_qualifier(s: *u8) -> bool {
    let names: [*u8; 17] = [c"const", c"__const", c"volatile", c"__volatile", c"__volatile__",
        c"restrict", c"__restrict", c"__restrict__", c"_Nullable", c"_Nonnull",
        c"_Null_unspecified", c"_Nullable_result", c"__nullable", c"__nonnull",
        c"__unaligned", c"__ptr64", c"__ptr32"];
    for i in 0..17 {
        if unsafe { streq(s, names[i]) } {
            return true;
        }
    }
    false
}

pub fn is_type_keyword(s: *u8) -> bool {
    let names: [*u8; 33] = [c"void", c"char", c"short", c"int", c"long", c"float", c"double",
        c"signed", c"__signed", c"__signed__", c"unsigned", c"_Bool", c"_Complex", c"__complex__",
        c"__int128", c"__int128_t", c"__uint128_t", c"_Float16", c"_Float32", c"_Float64",
        c"_Float128", c"_Float32x", c"_Float64x", c"__float128", c"__fp16", c"__bf16",
        c"struct", c"union", c"enum", c"__builtin_va_list", c"__typeof__", c"__typeof", c"typeof"];
    for i in 0..33 {
        if unsafe { streq(s, names[i]) } {
            return true;
        }
    }
    false
}

pub fn is_storage_word(s: *u8) -> bool {
    unsafe {
        streq(s, c"typedef") || streq(s, c"extern") || streq(s, c"static") || streq(s, c"auto")
            || streq(s, c"register") || streq(s, c"_Thread_local") || streq(s, c"__thread")
            || streq(s, c"inline") || streq(s, c"__inline") || streq(s, c"__inline__")
            || streq(s, c"_Noreturn") || streq(s, c"__extension__") || streq(s, c"_Alignas")
            || streq(s, c"__attribute__") || streq(s, c"__attribute") || streq(s, c"_Atomic")
    }
}

pub fn typedef_of(sym: i64) -> i64 {
    TYPEDEF_OF.get(sym + 1) - 1
}

// Whether token k starts a type name (for casts, sizeof, parameters).
pub fn d_starts_type(k: i64) -> bool {
    unsafe {
        let t = dpeek(k);
        if t == C_EOF || CTOKS[t].kind != CK::Ident {
            return false;
        }
        let s = ctok_text(t);
        is_type_keyword(s) || is_qualifier(s) || is_storage_word(s)
            || typedef_of(CTOKS[t].text) >= 0
    }
}

// Declaration specifiers: the base type and SP_* flags.
pub fn d_specifiers() -> (i64, i64) {
    unsafe {
        var flags = 0;
        var other = 0;
        var n_void = 0;
        var n_char = 0;
        var n_short = 0;
        var n_int = 0;
        var n_long = 0;
        var n_float = 0;
        var n_double = 0;
        var n_signed = 0;
        var n_unsigned = 0;
        var n_bool = 0;
        var bad = -1;
        var seen = false;
        while D_POS < D_N {
            let t = dcur();
            if CTOKS[t].kind != CK::Ident {
                break;
            }
            let s = ctok_text(t);
            if streq(s, c"__attribute__") || streq(s, c"__attribute") || streq(s, c"__declspec") {
                d_attributes();
                continue;
            }
            if is_qualifier(s) {
                if streq(s, c"const") || streq(s, c"__const") {
                    flags |= SP_CONST;
                }
                D_POS += 1;
                continue;
            }
            if streq(s, c"_Atomic") {
                if d_is_at(1, c"(") {
                    d_fail(c"_Atomic");
                    break;
                }
                D_POS += 1;
                continue;
            }
            if streq(s, c"_Alignas") || streq(s, c"alignas") {
                D_POS += 1;
                let (v, ok) = d_paren_value();
                if ok {
                    A_ALIGN = v;
                }
                continue;
            }
            let storage = if streq(s, c"typedef") { SP_TYPEDEF }
                else if streq(s, c"extern") { SP_EXTERN } else if streq(s, c"static") { SP_STATIC }
                else if streq(s, c"inline") || streq(s, c"__inline")
                || streq(s, c"__inline__") { SP_INLINE }
                else if streq(s, c"_Noreturn") { SP_NORETURN }
                else if streq(s, c"_Thread_local") || streq(s, c"__thread") { SP_THREAD }
                else if streq(s, c"auto") || streq(s, c"register")
                || streq(s, c"__extension__") { -1 } else { 0 };
            if storage != 0 {
                if storage > 0 {
                    flags |= storage;
                }
                D_POS += 1;
                continue;
            }
            if streq(s, c"void") { n_void += 1; }
            else if streq(s, c"char") { n_char += 1; }
            else if streq(s, c"short") { n_short += 1; }
            else if streq(s, c"int") { n_int += 1; }
            else if streq(s, c"long") { n_long += 1; }
            else if streq(s, c"float") { n_float += 1; }
            else if streq(s, c"double") { n_double += 1; }
            else if streq(s, c"signed") || streq(s, c"__signed")
                || streq(s, c"__signed__") { n_signed += 1; }
            else if streq(s, c"unsigned") { n_unsigned += 1; }
            else if streq(s, c"_Bool") { n_bool += 1; }
            else if streq(s, c"_Complex")
                || streq(s, c"__complex__") { bad = intern_c(c"_Complex"); }
            else if streq(s, c"__int128") || streq(s, c"__int128_t")
                || streq(s, c"__uint128_t") { bad = intern_c(c"__int128"); }
            else if streq(s, c"_Float32") { other = CTY_F32; }
            else if streq(s, c"_Float64") || streq(s, c"_Float32x") { other = CTY_F64; }
            else if streq(s, c"_Float16") || streq(s, c"__fp16")
                || streq(s, c"__bf16") { bad = intern_c(c"a 16-bit float"); }
            else if streq(s, c"_Float128") || streq(s, c"_Float64x")
                || streq(s, c"__float128") { bad = intern_c(c"a 128-bit float"); }
            else if streq(s, c"__builtin_va_list") { other = c_va_list(); }
            else if streq(s, c"struct") || streq(s, c"union") {
                D_POS += 1;
                other = d_record(streq(s, c"union"));
                seen = true;
                continue;
            } else if streq(s, c"enum") {
                D_POS += 1;
                other = d_enum();
                seen = true;
                continue;
            } else if streq(s, c"__typeof__") || streq(s, c"__typeof") || streq(s, c"typeof") {
                D_POS += 1;
                d_skip_parens();
                bad = intern_c(c"typeof");
                seen = true;
                continue;
            } else if !seen && typedef_of(CTOKS[t].text) >= 0 {
                other = cty_new(Named, typedef_of(CTOKS[t].text), 0, 0, 0);
            } else {
                break;
            }
            seen = true;
            D_POS += 1;
        }
        if bad >= 0 {
            return (cty_new(Bad, bad, 0, 0, 0), flags);
        }
        if other != 0 {
            return (other, flags);
        }
        if n_void > 0 {
            return (CTY_VOID, flags);
        }
        if n_bool > 0 {
            return (CTY_BOOL, flags);
        }
        if n_float > 0 {
            return (CTY_F32, flags);
        }
        if n_double > 0 {
            if n_long > 0 {
                return (if C_LONG_DOUBLE_64 { CTY_F64 } else { cty_bad(c"long double") }, flags);
            }
            return (CTY_F64, flags);
        }
        if n_char > 0 {
            // Plain char is vole's byte, u8 (the type of c"..." strings).
            return (cty_int(8, n_signed > 0), flags);
        }
        let signed = n_unsigned == 0;
        if n_short > 0 {
            return (cty_int(16, signed), flags);
        }
        if n_long > 0 {
            return (cty_int(64, signed), flags);
        }
        if n_int > 0 || n_signed > 0 || n_unsigned > 0 || flags != 0 {
            return (cty_int(32, signed), flags);
        }
        d_fail(c"a declaration without a type");
        (cty_int(32, signed: true), flags)
    }
}

pub static var C_LONG_DOUBLE_64: bool = false;
static var C_VA_LIST: i64 = 0;
pub static var C_TARGET_X86: bool = false;
pub static var C_TARGET_A64_LINUX: bool = false;

// __builtin_va_list: `char *` on Apple's arm64, an array of one
// struct __va_list_tag on x86-64, struct __va_list on AArch64 Linux.
fn c_va_list() -> i64 {
    unsafe {
        if C_VA_LIST != 0 {
            return C_VA_LIST;
        }
        if C_TARGET_A64_LINUX {
            let r = crec_new(intern_c(c"__va_list"), is_union: false);
            TAG_OF.put(CRECS[r].tag + 1, r * 4 + 1);
            let names: [*u8; 5] = [c"__stack", c"__gr_top", c"__vr_top", c"__gr_offs",
                c"__vr_offs"];
            let start = CINTS.count;
            for i in 0..5 {
                let ty = if i < 3 { cty_ptr(CTY_VOID) } else { cty_int(32, signed: true) };
                CINTS.push(cfield_new(intern_c(names[i]), ty, -1, 0));
            }
            CRECS[r].fields = start;
            CRECS[r].field_count = 5;
            CRECS[r].complete = 1;
            C_VA_LIST = CRECS[r].ty;
            return C_VA_LIST;
        }
        if !C_TARGET_X86 {
            C_VA_LIST = cty_ptr(cty_int(8, signed: false));
            return C_VA_LIST;
        }
        let r = crec_new(intern_c(c"__va_list_tag"), is_union: false);
        TAG_OF.put(CRECS[r].tag + 1, r * 4 + 1);
        let names: [*u8; 4] = [c"gp_offset", c"fp_offset", c"overflow_arg_area", c"reg_save_area"];
        CRECS[r].fields = CINTS.count;
        let start = CINTS.count;
        for i in 0..4 {
            let ty = if i < 2 { cty_int(32, signed: false) } else { cty_ptr(CTY_VOID) };
            CINTS.push(cfield_new(intern_c(names[i]), ty, -1, 0));
        }
        CRECS[r].fields = start;
        CRECS[r].field_count = 4;
        CRECS[r].complete = 1;
        C_VA_LIST = cty_new(Array, CRECS[r].ty, 1, 0, 0);
        C_VA_LIST
    }
}

fn cfield_new(name: i64, ty: i64, bits: i64, align: i64) -> i64 {
    unsafe {
        CFIELDS = grow(CFIELDS, CFIELD_COUNT, &CFIELD_CAP);
        CFIELDS[CFIELD_COUNT] = CField {
            name, ty, bits, align_attr: align, offset: 0, bit_offset: 0
        };
    }
    CFIELD_COUNT += 1;
    CFIELD_COUNT - 1
}

// `struct` or `union` (already read) [attributes] [tag] [{ fields }].
fn d_record(is_union: bool) -> i64 {
    unsafe {
        let saved = (A_PACKED, A_ALIGN);
        A_PACKED = false;
        A_ALIGN = 0;
        d_attributes();
        var tag = -1;
        if dcur() != C_EOF && CTOKS[dcur()].kind == CK::Ident && !d_is(c"__attribute__") {
            tag = CTOKS[dcur()].text;
            D_POS += 1;
        }
        d_attributes();
        let kind = if is_union { 1 } else { 0 };
        var r = -1;
        if tag >= 0 {
            let found = TAG_OF.get(tag + 1) - 1;
            if found >= 0 && found % 4 == kind {
                r = found / 4;
            }
        }
        if !d_is(c"{") {
            if r < 0 {
                r = crec_new(tag, is_union);
                if tag >= 0 {
                    TAG_OF.put(tag + 1, r * 4 + kind + 1);
                }
            }
            let (p, a) = saved;
            A_PACKED = p;
            A_ALIGN = a;
            return CRECS[r].ty;
        }
        if r < 0 || CRECS[r].complete != 0 {
            r = crec_new(tag, is_union);
            if tag >= 0 {
                TAG_OF.put(tag + 1, r * 4 + kind + 1);
            }
        }
        let packed_before = A_PACKED;
        let align_before = A_ALIGN;
        D_POS += 1;
        CRECS[r].pack = D_PACK;
        var fields = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        while !d_is(c"}") && D_POS < D_N {
            d_pack_markers();
            if d_is(c"}") {
                break;
            }
            if d_eat(c";") {
                continue;
            }
            if d_is(c"_Static_assert") || d_is(c"static_assert") {
                while !d_is(c";") && D_POS < D_N {
                    D_POS += 1;
                }
                continue;
            }
            let outer = (A_PACKED, A_ALIGN, A_MODE, A_VECTOR);
            A_ALIGN = 0;
            A_MODE = 0;
            A_VECTOR = false;
            let (base, _) = d_specifiers();
            if d_is(c";") {
                // An anonymous struct or union member (C11).
                let rb = CTYPES[base].kind == Record && CRECS[CTYPES[base].a].tag < 0;
                if rb {
                    CRECS[CTYPES[base].a].parent = r;
                    fields.push(cfield_new(-1, base, -1, A_ALIGN));
                }
                D_POS += 1;
                let (p, a, m, v) = outer;
                A_PACKED = p;
                A_MODE = m;
                A_VECTOR = v;
                A_ALIGN = a;
                continue;
            }
            loop {
                let field_align_before = A_ALIGN;
                var name = -1;
                var ty = base;
                if !d_is(c":") {
                    let (n, t) = d_declarator(base);
                    name = n;
                    ty = t;
                }
                var bits = -1;
                if d_eat(c":") {
                    let at = dcur();
                    let list = d_collect_until(c",", c";");
                    let (v, _) = eval_tokens(list, at, true);
                    if EV_FAIL {
                        d_fail(c"a bit-field width");
                    }
                    bits = v as i64;
                }
                d_attributes();
                ty = apply_mode(ty);
                let fa = if A_ALIGN > field_align_before { A_ALIGN } else { field_align_before };
                fields.push(cfield_new(name, ty, bits, fa));
                A_ALIGN = 0;
                if !d_eat(c",") {
                    break;
                }
            }
            d_expect(c";");
            let (p, a, m, v) = outer;
            A_PACKED = p;
            A_MODE = m;
            A_VECTOR = v;
            A_ALIGN = a;
        }
        d_expect(c"}");
        A_PACKED = packed_before;
        A_ALIGN = align_before;
        d_attributes();
        CRECS[r].packed = A_PACKED as i64;
        CRECS[r].align_attr = A_ALIGN;
        CRECS[r].fields = CINTS.count;
        for i in 0..fields.count {
            CINTS.push(fields.data[i]);
        }
        CRECS[r].field_count = fields.count;
        CRECS[r].complete = 1;
        let (p, a) = saved;
        A_PACKED = p;
        A_ALIGN = a;
        CRECS[r].ty
    }
}

// `mode(...)` on an integer type: the integer of that width.
pub fn apply_mode(t: i64) -> i64 {
    unsafe {
        if A_VECTOR {
            return cty_bad(c"a vector type");
        }
        if A_MODE == 0 {
            return t;
        }
        if A_MODE < 0 {
            return cty_bad(c"an integer of that mode");
        }
        let r = cty_integer(t);
        if r == 0 {
            return t;
        }
        cty_int(A_MODE, CTYPES[r].b != 0)
    }
}

// `enum` (already read) [attributes] [tag] [: type] [{ enumerators }].
fn d_enum() -> i64 {
    unsafe {
        let packed_before = A_PACKED;
        A_PACKED = false;
        d_attributes();
        let leading_packed = A_PACKED;
        A_PACKED = packed_before;
        var tag = -1;
        if dcur() != C_EOF && CTOKS[dcur()].kind == CK::Ident {
            tag = CTOKS[dcur()].text;
            D_POS += 1;
        }
        d_attributes();
        var fixed = 0;
        if d_eat(c":") {
            let (t, _) = d_specifiers();
            fixed = t;
        }
        var e = -1;
        if tag >= 0 {
            let found = TAG_OF.get(tag + 1) - 1;
            if found >= 0 && found % 4 == 2 {
                e = found / 4;
            }
        }
        if e < 0 {
            CENUMS = grow(CENUMS, CENUM_COUNT, &CENUM_CAP);
            e = CENUM_COUNT;
            CENUM_COUNT += 1;
            CENUMS[e] = CEnum {
                tag, underlying: cty_int(32, signed: false), name: -1, ty: 0, has_values: 0
            };
            CENUMS[e].ty = cty_new(Enum, e, 0, 0, 0);
            if tag >= 0 {
                TAG_OF.put(tag + 1, e * 4 + 2 + 1);
            }
        }
        if fixed != 0 {
            CENUMS[e].underlying = fixed;
        }
        if !d_eat(c"{") {
            return CENUMS[e].ty;
        }
        CENUMS[e].has_values = 1;
        let first = CENUMERATOR_COUNT;
        var next: i64 = 0;
        var min: i64 = 0;
        var max: u64 = 0;
        while !d_is(c"}") && D_POS < D_N {
            let t = dcur();
            if CTOKS[t].kind != CK::Ident {
                d_fail(c"an enumerator");
                break;
            }
            D_POS += 1;
            d_attributes();
            var value = next;
            if d_eat(c"=") {
                let list = d_collect_until(c",", c"}");
                let (v, vt) = eval_tokens(list, t, true);
                if EV_FAIL {
                    d_fail(c"an enumerator's value");
                    break;
                }
                value = if cty_signed(vt) { v as i64 } else { v as i64 };
            }
            CENUMERATORS = grow(CENUMERATORS, CENUMERATOR_COUNT, &CENUMERATOR_CAP);
            CENUMERATORS[CENUMERATOR_COUNT] = CEnumerator {
                name: CTOKS[t].text, value, ty: e
            };
            ENUMERATOR_OF.put(CTOKS[t].text + 1, CENUMERATOR_COUNT + 1);
            CENUMERATOR_COUNT += 1;
            if value < min {
                min = value;
            }
            if value >= 0 && value as u64 > max {
                max = value as u64;
            }
            next = value + 1;
            if !d_eat(c",") {
                break;
            }
        }
        d_expect(c"}");
        let saved_packed = A_PACKED;
        A_PACKED = leading_packed;
        d_attributes();
        if fixed == 0 {
            // GCC and Clang: unsigned int when no value is negative, int
            // otherwise; wider when the values need it; the smallest with
            // `packed`.
            let neg = min < 0;
            var bits = 32;
            if A_PACKED {
                bits = 8;
                while bits < 64
                    && !(if neg {
                        min >= -(1 << (bits - 1) as u64)
                            && max <= ((1 << (bits - 1) as u64) - 1) as u64
                    } else { max <= ((1 << bits as u64) - 1) as u64 }) {
                        bits *= 2;
                    }
            } else if neg && (min < -2147483648 || max > 2147483647) {
                bits = 64;
            } else if !neg && max > 4294967295 {
                bits = 64;
            }
            CENUMS[e].underlying = cty_int(bits, neg);
        }
        A_PACKED = saved_packed;
        let _ = first;
        CENUMS[e].ty
    }
}
