// C declarations: declarators (pointers, arrays, functions, nested
// declarators), type names, the constant expressions of declarations
// (enumerators, sizeof, casts), and the external declarations of the
// headers read into the tables (typedefs, functions, variables).

use crate::base::{IntVec, grow, intern_c, streq};
use crate::front::cimport::{
    CENUMERATORS, CENUMS, CFUNCS, CFUNC_CAP, CFUNC_COUNT, CFunc, CTYPEDEFS, CTYPEDEF_CAP,
    CTYPEDEF_COUNT, CTYPES, CTypedef, CVARS, CVAR_CAP, CVAR_COUNT, CVar, D_BAD, D_N, D_POS, D_TOKS,
    ENUMERATOR_OF, FUNC_OF, TYPEDEF_OF, VAR_OF, cty_bad, cty_int, cty_integer, cty_new, cty_ptr,
    cty_resolve, d_eat, d_expect, d_is, d_is_at, d_skip_parens, dcur, dpeek, skip_reason,
};
use crate::front::cimport::CT::{Array, Func, Named};
use crate::front::cimport::layout::{c_align, c_size};
use crate::front::cimport::specifiers::{
    A_ALIGN, A_LINK, A_MODE, A_NORETURN, A_PACKED, A_UNAVAILABLE, A_VECTOR, SP_CONST, SP_EXTERN,
    SP_INLINE, SP_NORETURN, SP_STATIC, SP_THREAD, SP_TYPEDEF, apply_mode, attrs_reset, d_attributes,
    d_collect_until, d_specifiers, d_starts_type, is_qualifier, is_storage_word, is_type_keyword,
    typedef_of,
};
use crate::front::cpp::{CINTS, CK, CTOKS, C_EOF, ctok_text, strtoull};
use crate::front::cpp::eval::{
    EV_FAIL, EV_N, EV_POS, EV_TOKS, ev_convert, ev_peek, ev_unary, eval_tokens,
};

// ---- Declarators ----

fn skip_pointer_qualifiers() {
    unsafe {
        loop {
            let t = dcur();
            if t == C_EOF || CTOKS[t].kind != CK::Ident {
                return;
            }
            let s = ctok_text(t);
            if is_qualifier(s) || streq(s, c"_Atomic") {
                D_POS += 1;
            } else if streq(s, c"__attribute__") || streq(s, c"__attribute") {
                d_attributes();
            } else {
                return;
            }
        }
    }
}

// Whether `(` at the cursor opens a nested declarator (not parameters).
fn d_nested_declarator() -> bool {
    unsafe {
        let t = dpeek(1);
        if t == C_EOF {
            return false;
        }
        if d_is_at(1, c"*") || d_is_at(1, c"(") || d_is_at(1, c"^") || d_is_at(1, c"[") {
            return true;
        }
        if CTOKS[t].kind != CK::Ident {
            return false;
        }
        let s = ctok_text(t);
        if streq(s, c"__attribute__") || streq(s, c"__attribute") {
            return true;
        }
        !(is_type_keyword(s) || is_qualifier(s) || is_storage_word(s)
            || typedef_of(CTOKS[t].text) >= 0)
    }
}

// A declarator (abstract or not): the name (-1: none) and the type.
pub fn d_declarator(base: i64) -> (i64, i64) {
    unsafe {
        let mut ty = base;
        d_attributes();
        while d_eat(c"*") || d_eat(c"^") {
            ty = cty_ptr(ty);
            let first = D_POS;
            skip_pointer_qualifiers();
            // (0.18: clang's `_Nonnull` makes it std::NonNull: CType b = 1)
            for k in first..D_POS {
                let tok = D_TOKS[k];
                if CTOKS[tok].kind == CK::Ident && streq(ctok_text(tok), c"_Nonnull") {
                    CTYPES[ty].b = 1;
                }
            }
        }
        d_attributes();
        if d_is(c"(") && d_nested_declarator() {
            D_POS += 1;
            let inner = D_POS;
            let mut depth = 1;
            while depth > 0 && D_POS < D_N {
                if d_is(c"(") {
                    depth += 1;
                } else if d_is(c")") {
                    depth -= 1;
                }
                D_POS += 1;
            }
            let outer_ty = d_suffixes(ty);
            let end = D_POS;
            D_POS = inner;
            let (name, t) = d_declarator(outer_ty);
            d_expect(c")");
            D_POS = end;
            return (name, t);
        }
        let mut name = -1;
        let t = dcur();
        if t != C_EOF && CTOKS[t].kind == CK::Ident && !is_qualifier(ctok_text(t))
            && !d_is(c"__attribute__") && !d_is(c"__asm__") && !d_is(c"__asm") && !d_is(c"asm") {
            name = CTOKS[t].text;
            D_POS += 1;
        }
        (name, d_suffixes(ty))
    }
}

// Array and function suffixes.
fn d_suffixes(base: i64) -> i64 {
    unsafe {
        if d_eat(c"[") {
            skip_pointer_qualifiers();
            d_eat(c"static");
            skip_pointer_qualifiers();
            let mut len = -1;
            if !d_is(c"]") {
                let at = dcur();
                let list = d_collect_until(c"]", c"]");
                let (v, _) = eval_tokens(&list, at, true);
                if EV_FAIL {
                    d_expect(c"]");
                    let elem = d_suffixes(base);
                    let _ = elem;
                    return cty_bad(c"an array whose length is not a constant tachyon can compute");
                }
                len = v as i64;
            }
            d_expect(c"]");
            let elem = d_suffixes(base);
            return cty_new(Array, elem, len, 0, 0);
        }
        if d_is(c"(") {
            D_POS += 1;
            let saved = (A_PACKED, A_ALIGN, A_MODE, A_LINK, A_NORETURN, A_UNAVAILABLE, A_VECTOR);
            let params = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            let mut variadic = 0;
            if d_is(c"void") && d_is_at(1, c")") {
                D_POS += 1;
            }
            while !d_is(c")") && D_POS < D_N {
                if d_eat(c"...") {
                    variadic = 1;
                    break;
                }
                attrs_reset();
                let (pbase, _) = d_specifiers();
                let (_, pt) = d_declarator(pbase);
                d_attributes();
                params.push(param_adjust(apply_mode(pt)));
                if !d_eat(c",") {
                    break;
                }
            }
            d_expect(c")");
            let (p, a, m, l, nr, u, v) = saved;
            A_PACKED = p;
            A_ALIGN = a;
            A_MODE = m;
            A_LINK = l;
            A_NORETURN = nr;
            A_UNAVAILABLE = u;
            A_VECTOR = v;
            let start = CINTS.count;
            for i in 0..params.count {
                CINTS.push(params.data[i]);
            }
            return cty_new(Func, base, start, params.count, variadic);
        }
        base
    }
}

// Parameters of array and function type are pointers.
fn param_adjust(t: i64) -> i64 {
    unsafe {
        let r = cty_resolve(t);
        if CTYPES[r].kind == Array {
            return cty_ptr(CTYPES[r].a);
        }
        if CTYPES[r].kind == Func {
            return cty_ptr(t);
        }
        t
    }
}

// A type name (in casts and sizeof): specifiers and an abstract declarator.
fn d_type_name() -> i64 {
    let saved = (A_PACKED, A_ALIGN, A_MODE, A_LINK, A_NORETURN, A_UNAVAILABLE, A_VECTOR);
    let (base, _) = d_specifiers();
    let (_, t) = d_declarator(base);
    let (p, a, m, l, nr, u, v) = saved;
    A_PACKED = p;
    A_ALIGN = a;
    A_MODE = m;
    A_LINK = l;
    A_NORETURN = nr;
    A_UNAVAILABLE = u;
    A_VECTOR = v;
    t
}

// ---- Constant expressions in declarations ----

// Casts, sizeof and _Alignof, for cpp.tach's evaluator: whether one
// was read, and its value and type.
pub fn cdecl_eval_special() -> (bool, u64, i64) {
    unsafe {
        let t = ev_peek();
        if t == C_EOF {
            return (false, 0, 0);
        }
        let s = ctok_text(t);
        let is_sizeof = streq(s, c"sizeof");
        let is_alignof = streq(s, c"_Alignof") || streq(s, c"__alignof__") || streq(s, c"__alignof")
            || streq(s, c"alignof");
        let is_cast = CTOKS[t].kind == CK::Punct && streq(s, c"(");
        if !is_sizeof && !is_alignof && !is_cast {
            return (false, 0, 0);
        }
        // The type name is read by the declaration parser, at the
        // evaluator's position.
        let saved = (D_TOKS, D_N, D_POS, D_BAD);
        D_TOKS = EV_TOKS;
        D_N = EV_N;
        D_POS = EV_POS;
        D_BAD = -1;
        let mut ty = -1;
        if is_cast {
            if d_starts_type(1) {
                D_POS += 1;
                ty = d_type_name();
                d_expect(c")");
            }
        } else if d_is_at(1, c"(") && d_starts_type(2) {
            D_POS += 2;
            ty = d_type_name();
            d_expect(c")");
        }
        let after = D_POS;
        let bad = D_BAD >= 0;
        let (d_toks, d_n, d_pos, d_bad) = saved;
        D_TOKS = d_toks;
        D_N = d_n;
        D_POS = d_pos;
        D_BAD = d_bad;
        if ty < 0 {
            // A parenthesized expression, or sizeof of one.
            return (false, 0, 0);
        }
        EV_POS = after;
        if bad {
            EV_FAIL = true;
            return (true, 0, cty_int(32, signed: true));
        }
        if is_cast {
            let (v, _) = ev_unary();
            if cty_integer(ty) == 0 {
                EV_FAIL = true;
                return (true, 0, cty_int(32, signed: true));
            }
            return (true, ev_convert(v, ty), ty);
        }
        let v = if is_sizeof { c_size(ty) } else { c_align(ty) };
        if v < 0 {
            EV_FAIL = true;
        }
        (true, v as u64, cty_int(64, signed: false))
    }
}

// An identifier's value in a constant expression: an enumerator.
pub fn cdecl_ident_value(sym: i64) -> (bool, u64, i64) {
    let e = ENUMERATOR_OF.get(sym + 1) - 1;
    if e < 0 {
        return (false, 0, 0);
    }
    unsafe { (true, CENUMERATORS[e].value as u64, enumerator_type(e)) }
}

// C's type of an enumerator: int when its value fits, else the enum's.
pub fn enumerator_type(e: i64) -> i64 {
    unsafe {
        let v = CENUMERATORS[e].value;
        if v >= -2147483648 && v <= 2147483647 {
            return cty_int(32, signed: true);
        }
        CENUMS[CENUMERATORS[e].ty].underlying
    }
}

// ---- #pragma pack ----

// The packing in force (#pragma pack), from the `__tachyon_pack <n>`
// tokens of the preprocessor.
pub static mut D_PACK: i64 = 0;

pub fn d_pack_markers() {
    unsafe {
        while d_is(c"__tachyon_pack") {
            D_POS += 1;
            let mut end = 0 as *u8;
            D_PACK = strtoull(ctok_text(dcur()), &end, 10) as i64;
            D_POS += 1;
        }
    }
}

// ---- Reading the declarations ----

// Reads every external declaration of the token list.
pub fn cdecl_parse(toks: &IntVec) {
    unsafe {
        D_TOKS = (*toks).data;
        D_N = (*toks).count;
        D_POS = 0;
        while D_POS < D_N {
            d_pack_markers();
            if D_POS >= D_N {
                break;
            }
            if d_eat(c";") {
                continue;
            }
            if d_is(c"_Static_assert") || d_is(c"static_assert") || d_is(c"__asm__")
                || d_is(c"__asm") || d_is(c"asm") {
                D_POS += 1;
                d_skip_parens();
                d_eat(c";");
                continue;
            }
            let start = D_POS;
            let saved_n = D_N;
            D_BAD = -1;
            attrs_reset();
            let first_name = d_declaration();
            if D_BAD >= 0 {
                // Skip what remains of it: to `;` at depth 0, or past a body.
                D_N = saved_n;
                D_POS = start;
                skip_reason(first_name, D_BAD);
                skip_declaration();
            }
        }
    }
}

fn skip_declaration() {
    unsafe {
        let mut depth = 0;
        while D_POS < D_N {
            if d_is(c"(") || d_is(c"[") {
                depth += 1;
            } else if d_is(c")") || d_is(c"]") {
                depth -= 1;
            } else if d_is(c"{") {
                // A record's body, or a function's.
                let mut braces = 0;
                loop {
                    if d_is(c"{") {
                        braces += 1;
                    } else if d_is(c"}") {
                        braces -= 1;
                        if braces == 0 {
                            break;
                        }
                    }
                    D_POS += 1;
                    if D_POS >= D_N {
                        return;
                    }
                }
                D_POS += 1;
                if depth == 0 && D_POS < D_N && !d_is(c";") && !d_is(c",")
                    && !d_is(c"__attribute__")
                    && CTOKS[dcur()].kind != CK::Ident && !d_is(c"*") && !d_is(c"[") {
                    return;
                }
                continue;
            } else if d_is(c";") && depth == 0 {
                D_POS += 1;
                return;
            }
            D_POS += 1;
        }
    }
}

// One declaration; returns its first declared name (-1: none).
fn d_declaration() -> i64 {
    unsafe {
        let (base, flags) = d_specifiers();
        if D_BAD >= 0 {
            return -1;
        }
        if d_eat(c";") {
            return -1;
        }
        let mut first = -1;
        loop {
            let decl_attrs = (A_ALIGN, A_MODE, A_LINK, A_NORETURN, A_UNAVAILABLE, A_VECTOR);
            let (name, raw_ty) = d_declarator(base);
            d_attributes();
            if D_BAD >= 0 {
                return if first >= 0 { first } else { name };
            }
            if first < 0 {
                first = name;
            }
            let ty = apply_mode(raw_ty);
            let r = cty_resolve(ty);
            let is_func = CTYPES[r].kind == Func && CTYPES[ty].kind != Named;
            if name >= 0 {
                if (flags & SP_TYPEDEF) != 0 {
                    add_typedef(name, ty, A_ALIGN);
                } else if CTYPES[r].kind == Func {
                    if d_is(c"{") {
                        // A definition: imported when it has an external one.
                        skip_body();
                        if (flags & SP_STATIC) != 0
                            || ((flags & SP_INLINE) != 0 && (flags & SP_EXTERN) == 0) {
                            skip_reason(name,
                                intern_c(c"it is defined in the header (static or inline)"));
                        } else {
                            add_function(name, ty, flags);
                        }
                        return first;
                    }
                    if (flags & SP_STATIC) != 0 {
                        skip_reason(name, intern_c(c"it is static"));
                    } else {
                        add_function(name, ty, flags);
                    }
                } else if (flags & SP_THREAD) != 0 {
                    skip_reason(name, intern_c(c"it is thread-local"));
                } else if (flags & SP_EXTERN) != 0 {
                    add_variable(name, ty, flags);
                } else {
                    skip_reason(name, intern_c(c"it is defined in the header"));
                }
            }
            let _ = is_func;
            let (a, m, l, nr, u, v) = decl_attrs;
            A_ALIGN = a;
            A_MODE = m;
            A_LINK = l;
            A_NORETURN = nr;
            A_UNAVAILABLE = u;
            A_VECTOR = v;
            if d_eat(c"=") {
                d_collect_until(c",", c";");
            }
            if !d_eat(c",") {
                break;
            }
        }
        d_expect(c";");
        first
    }
}

fn skip_body() {
    unsafe {
        let mut depth = 0;
        while D_POS < D_N {
            if d_is(c"{") {
                depth += 1;
            } else if d_is(c"}") {
                depth -= 1;
                if depth == 0 {
                    D_POS += 1;
                    return;
                }
            }
            D_POS += 1;
        }
    }
}

fn add_typedef(name: i64, ty: i64, align: i64) {
    if typedef_of(name) >= 0 {
        return;
    }
    unsafe {
        CTYPEDEFS = grow(CTYPEDEFS, CTYPEDEF_COUNT, &CTYPEDEF_CAP);
        CTYPEDEFS[CTYPEDEF_COUNT] = CTypedef { name, ty, tname: -1, align_attr: align };
    }
    TYPEDEF_OF.put(name + 1, CTYPEDEF_COUNT + 1);
    CTYPEDEF_COUNT += 1;
}

fn add_function(name: i64, ty: i64, flags: i64) {
    unsafe {
        if FUNC_OF.get(name + 1) != 0 || VAR_OF.get(name + 1) != 0 {
            return;
        }
        if A_UNAVAILABLE {
            skip_reason(name, intern_c(c"it is marked unavailable"));
            return;
        }
        CFUNCS = grow(CFUNCS, CFUNC_COUNT, &CFUNC_CAP);
        let noreturn = (flags & SP_NORETURN) != 0 || A_NORETURN;
        CFUNCS[CFUNC_COUNT] = CFunc { name, ty, link: A_LINK, noreturn: noreturn as i64 };
        FUNC_OF.put(name + 1, CFUNC_COUNT + 1);
        CFUNC_COUNT += 1;
    }
}

fn add_variable(name: i64, ty: i64, flags: i64) {
    if FUNC_OF.get(name + 1) != 0 || VAR_OF.get(name + 1) != 0 {
        return;
    }
    unsafe {
        CVARS = grow(CVARS, CVAR_COUNT, &CVAR_CAP);
        CVARS[CVAR_COUNT] = CVar {
            name, ty, link: A_LINK, is_const: ((flags & SP_CONST) != 0) as i64
        };
    }
    VAR_OF.put(name + 1, CVAR_COUNT + 1);
    CVAR_COUNT += 1;
}
