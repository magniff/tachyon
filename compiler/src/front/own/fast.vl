// The own pass's fast path (0.17, docs/design/value-semantics.md §4,
// "Cost"; T2 owns it): a function with nothing to track is not walked.
//
// walk_fn asks needs_walk(f) first; a function that does not need it gets
// the summary views() (collect_begin, then collect_end with nothing
// collected) and no findings. A function needs the walk when:
// - a parameter, its result or any expression in it has an owned or a
//   view type (moves, drops, slots, results, `&T` loans, f-strings over
//   owned values: everything the events track hangs on one of them);
// - or a call in it takes a loan (`&place`, a borrowed pointer parameter
//   passed on) of a root that an earlier argument of the same call, or of
//   an enclosing one, also borrows, or that is assigned meanwhile: the only
//   findings left without views or owned values are argument conflicts
//   (`f(&a, &a)`, `a.f(g(&a))` with legacy `*T` parameters).
// The scan below visits what walk.vl's eval visits; a node kind the walk
// learns must be added here too.

use crate::base::{IntVec, alloc_array};
use crate::front::ast::{NODES, NODE_RAW, NodeKind, child};
use crate::front::check::{LOCALS, Res};
use crate::front::own::kinds::{K_OWNED, K_VIEW, type_kind};
use crate::front::types::{FNS, TYPES, TyKind};

// Functions skipped (for --values=report's count and the budget).
pub static var SKIPPED: i64 = 0;
// Set by `query own` (observe.vl): walk whatever the fast path says.
pub static var FORCE_WALK: bool = false;

static var NEED: bool = false;
// The roots borrowed by the pending arguments of the calls being scanned.
static var ROOTS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Pending views of statics (in ROOTS).
static var STATIC_VIEWS: i64 = 0;

static var MEMO: *u8 = 0 as *u8;
static var MEMO_CAP: i64 = 0;

static var KNOWN: *u8 = 0 as *u8;
static var KNOWN_CAP: i64 = 0;

// Whether type t is owned or a view (kinds.vl), memoized here per type
// id in one byte (the scan asks it of every node): 0 unknown, 1 no, 2
// owned, 3 a view only.
fn tracked(t: i64) -> bool {
    unsafe {
        if t <= 0 {
            return false;
        }
        if t < MEMO_CAP {
            let m = MEMO[t];
            if m != 0 {
                return m >= 2;
            }
        } else {
            let n = t * 2 + 1024;
            let a = alloc_array::<u8>(n);
            for i in 0..MEMO_CAP {
                a[i] = MEMO[i];
            }
            MEMO = a;
            MEMO_CAP = n;
        }
        let k = type_kind(t);
        MEMO[t] = if (k & K_OWNED) != 0 { 2 } else if (k & K_VIEW) != 0 { 3 } else { 1 };
        MEMO[t] >= 2
    }
}

// Whether expression e (of a view type) holds only views of static data
// or of what a raw pointer reaches (origin ∅: the walk gives it none): a
// string literal, a place reached through a raw pointer (`SYMS[s].text`).
fn raw_view(e: i64) -> bool {
    raw_view_of(e, true)
}

// raw_view; calls: a call given no loans and no views counts (it asks the
// kinds of its arguments' types: not during type checking).
fn raw_view_of(e: i64, calls: bool) -> bool {
    unsafe {
        let k = NODES[e].kind;
        if k == NodeKind::Str {
            return true;
        }
        if k == NodeKind::FieldAccess {
            if NODES[e].y == 1 {
                return !reference(NODES[e].a);
            }
            return raw_view_of(NODES[e].a, calls);
        }
        if k == NodeKind::Call && calls {
            // (a call given no loans and no views: its result has none)
            if NODES[e].x - 1 < 0 {
                return false;
            }
            for i in 0..NODES[e].count {
                let arg = child(e, i);
                let ak = NODES[arg].kind;
                if ak == NodeKind::Unary && NODES[arg].op == crate::front::lexer::Tok::Amp
                    || ak == NodeKind::Ident && NODES[arg].res == Res::Local && NODES[arg].y >= 0
                    && LOCALS[NODES[arg].y].borrow {
                    return false;
                }
                let at = NODES[arg].ty;
                if tracked(at) && !(MEMO[at] == 3 && raw_view(arg)) {
                    return false;
                }
            }
            return true;
        }
        if k == NodeKind::TupleField {
            return raw_view_of(NODES[e].a, calls);
        }
        if k == NodeKind::Unary && NODES[e].op == crate::front::lexer::Tok::Star {
            return !reference(NODES[e].b);
        }
        if k == NodeKind::Index && NODES[NODES[e].b].kind != NodeKind::Range {
            let bt = NODES[NODES[e].a].ty;
            if bt > 0 && TYPES[bt].kind == TyKind::Ptr {
                return (NODES[e].p & NODE_RAW) != 0 || !reference(NODES[e].a);
            }
            return raw_view_of(NODES[e].a, calls);
        }
        false
    }
}

// Whether pointer expression e is a reference or a borrow (walk.vl's
// is_reference).
fn reference(e: i64) -> bool {
    unsafe {
        let t = NODES[e].ty;
        if t > 0 && TYPES[t].kind == TyKind::Ptr && TYPES[t].b != 0 {
            return true;
        }
        NODES[e].kind == NodeKind::Ident && NODES[e].res == Res::Local && NODES[e].y >= 0
            && LOCALS[NODES[e].y].borrow
    }
}

// Whether function f has anything the walk tracks (memoized: the driver
// walks a recursive component's functions several times). A function the
// type checker recorded (check_begin) is decided by its record; another
// (a closure's function, checked inside its parent) by the scan.
pub fn needs_walk(f: i64) -> bool {
    unsafe {
        if f < KNOWN_CAP && KNOWN[f] != 0 {
            return KNOWN[f] == 2;
        }
        if f >= KNOWN_CAP {
            let n = f * 2 + 1024;
            let a = alloc_array::<u8>(n);
            for i in 0..KNOWN_CAP {
                a[i] = KNOWN[i];
            }
            KNOWN = a;
            KNOWN_CAP = n;
        }
        let need = if f < REC_CAP && (REC_FLAGS[f] & R_CHECKED) != 0 { record_says(f) }
            else { scan_fn(f) };
        KNOWN[f] = if need { 2 } else { 1 };
        need
    }
}

// ---------------------------------------------------------------------------
// The record the type checker keeps (check/ hooks, the contract): per
// function, the types of its expressions, locals and parameters (each once
// in a row: STAMP), and whether a call in it borrows one root twice (the
// loans of the pending arguments, as scan_call has them). Types only: the
// kinds are asked here, after the checker (a closure's kind is known once
// it is finished).

const R_CHECKED: u8 = 1;
const R_LOANS: u8 = 2;
// (function, type) pairs, in the order the checker meets them.
static var REC: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var REC_FLAGS: *u8 = 0 as *u8;
static var REC_CAP: i64 = 0;
// Per type: the function + 1 that recorded it last.
static var STAMP: *i64 = 0 as *i64;
static var STAMP_CAP: i64 = 0;
// The function being checked (front::check::CUR_FN, at check_begin), the
// node check_expr is checking (its synth is not recorded: check_expr
// records the type it ends with, after a coercion).
static var REC_F: i64 = -1;
static var CHK_NODE: i64 = 0;
// The pending loans' roots of the calls being checked.
static var CROOTS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The calls being checked (their frames in CROOTS).
static var CDEPTH: i64 = 0;

// The records of the functions whose checks enclose this one: REC_F,
// CDEPTH, CROOTS.count each.
static var SAVED: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The span of the function being checked: a node met outside it (a
// default argument's expression, shared with its declaration) or a
// closure (its type is made after it is checked) leaves the decision to
// the scan (R_SCAN).
static var SPAN_A: i64 = 0;
static var SPAN_B: i64 = 0;
const R_SCAN: u8 = 4;
static var CLOSURES_MARKED: bool = false;
// Per function: its records' range in BY_FN (built once, by_fn).
static var BY_START: *i64 = 0 as *i64;
static var BY_FN: *i64 = 0 as *i64;
static var BY_N: i64 = -1;

fn rec_flags(f: i64) -> *u8 {
    unsafe {
        if f >= REC_CAP {
            let n = f * 2 + 1024;
            let a = alloc_array::<u8>(n);
            for i in 0..REC_CAP {
                a[i] = REC_FLAGS[i];
            }
            REC_FLAGS = a;
            REC_CAP = n;
        }
        &REC_FLAGS[f]
    }
}

// The type checker starts function f (check_function; a function may be
// checked inside another's call: an instance, a lazy default). The
// enclosing record is saved, check_end restores it.
pub fn check_begin(f: i64) {
    unsafe {
        SAVED.push(REC_F);
        SAVED.push(CDEPTH);
        SAVED.push(CROOTS.count);
        REC_F = f;
        CDEPTH = 0;
        SPAN_A = if f >= 0 { NODES[FNS[f].node].start } else { 0 };
        SPAN_B = if f >= 0 { NODES[FNS[f].node].end } else { 0 };
        if f >= 0 {
            *rec_flags(f) |= R_CHECKED;
        }
        BY_N = -1;
    }
}

// The type checker ends the function check_begin started.
pub fn check_end() {
    unsafe {
        if SAVED.count < 3 {
            REC_F = -1;
            return;
        }
        CROOTS.count = SAVED.data[SAVED.count - 1];
        CDEPTH = SAVED.data[SAVED.count - 2];
        REC_F = SAVED.data[SAVED.count - 3];
        SPAN_A = if REC_F >= 0 { NODES[FNS[REC_F].node].start } else { 0 };
        SPAN_B = if REC_F >= 0 { NODES[FNS[REC_F].node].end } else { 0 };
        SAVED.count -= 3;
    }
}

// Type t is met in the function being checked.
#[inline]
pub fn note_type(t: i64) {
    unsafe {
        let f = REC_F;
        if f < 0 || t <= 0 || t < STAMP_CAP && STAMP[t] == f + 1 {
            return;
        }
        note_new(f, t);
    }
}

fn note_new(f: i64, t: i64) {
    unsafe {
        if t >= STAMP_CAP {
            let n = t * 2 + 1024;
            let a = alloc_array::<i64>(n);
            for i in 0..STAMP_CAP {
                a[i] = STAMP[i];
            }
            STAMP = a;
            STAMP_CAP = n;
        }
        STAMP[t] = f + 1;
        REC.push(f);
        REC.push(t);
    }
}

// check_expr or synth_expr enters node n: a call's frame of loans (its
// mark, -1 for another node).
#[inline]
pub fn expr_enter(n: i64) -> i64 {
    unsafe {
        let k = NODES[n].kind;
        if k == NodeKind::Call || k == NodeKind::MethodCall {
            CDEPTH += 1;
            return CROOTS.count;
        }
        if REC_F >= 0 && (k == NodeKind::Closure || NODES[n].start < SPAN_A
            || NODES[n].start > SPAN_B) {
            *rec_flags(REC_F) |= R_SCAN;
        }
        -1
    }
}

// check_expr leaves node n, of type t (expected), entered with mark m.
// (The checker's hottest path: a type the function has recorded already
// costs a lookup.)
#[inline]
pub fn check_exit(n: i64, t: i64, m: i64) {
    unsafe {
        if m >= 0 {
            CROOTS.count = m;
            CDEPTH -= 1;
        }
        if REC_F < 0 {
            return;
        }
        let k = NODES[n].kind;
        if (k == NodeKind::Unary || k == NodeKind::Ident
            || CDEPTH > 0 && (k == NodeKind::FieldAccess || k == NodeKind::Index))
            && check_loans(n, t, k) {
            return;
        }
        if t <= 0 || t < STAMP_CAP && STAMP[t] == REC_F + 1 {
            return;
        }
        if k == NodeKind::Str || raw_view_of(n, false) {
            return;
        }
        note_new(REC_F, t);
    }
}

// The loans of check_exit: `&place`, a borrowed pointer passed on, a view
// read out of a place inside a call (view_arg: then true, its type not
// recorded; ∅ when reached through a raw pointer).
fn check_loans(n: i64, t: i64, k: NodeKind) -> bool {
    unsafe {
        if k == NodeKind::Unary {
            if NODES[n].op == crate::front::lexer::Tok::Amp {
                check_loan(place_root(NODES[n].b), true);
            }
            return false;
        }
        if k == NodeKind::Ident && NODES[n].res == Res::Local && NODES[n].y >= 0
            && LOCALS[NODES[n].y].borrow && t > 0 && TYPES[t].kind == TyKind::Ptr {
            check_loan(2 * NODES[n].y, true);
            return false;
        }
        if CDEPTH > 0 && t > 0
            && (TYPES[t].kind == TyKind::Slice || TYPES[t].kind == TyKind::Ptr) {
            if raw_view_of(n, false) {
                return true;
            }
            let r = place_root(n);
            if r >= 0 {
                if (r & 1) == 1 {
                    *rec_flags(REC_F) |= R_LOANS;
                }
                check_loan(r, true);
                return true;
            }
        }
        false
    }
}

// synth_expr leaves node n, of type t, entered with mark m.
#[inline]
pub fn synth_exit(n: i64, t: i64, m: i64) {
    unsafe {
        if m >= 0 {
            CROOTS.count = m;
            CDEPTH -= 1;
        }
        if REC_F < 0 || n == CHK_NODE {
            return;
        }
        let k = NODES[n].kind;
        if k == NodeKind::Assign {
            check_loan(place_root(NODES[n].b), false);
        }
        if t <= 0 || t < STAMP_CAP && STAMP[t] == REC_F + 1 {
            return;
        }
        if k == NodeKind::Str || k == NodeKind::FieldAccess && raw_view_of(n, false) {
            return;
        }
        note_new(REC_F, t);
    }
}

// check_expr is checking node n (its own synth is not recorded).
#[inline]
pub fn check_node(n: i64) {
    unsafe { CHK_NODE = n; }
}

// The function being checked holds nodes its check does not type (a
// default argument's, args.vl): the scan decides it.
pub fn note_scan() {
    unsafe {
        if REC_F >= 0 {
            *rec_flags(REC_F) |= R_SCAN;
        }
    }
}

// The functions holding closures (a closure is typed when it is
// finished, not where it is checked): the scan decides them. Once.
fn mark_closures() {
    unsafe {
        if CLOSURES_MARKED {
            return;
        }
        CLOSURES_MARKED = true;
        for i in 0..crate::front::closures::CLOSURE_COUNT {
            let e = crate::front::closures::CLOSURES[i].encl_fn;
            if e >= 0 {
                *rec_flags(e) |= R_SCAN;
            }
        }
    }
}

// The checker made node u (a method's receiver `&recv`, or `*recv`) typed.
pub fn note_synthetic(u: i64) {
    unsafe {
        if REC_F < 0 {
            return;
        }
        if NODES[u].op == crate::front::lexer::Tok::Amp {
            check_loan(place_root(NODES[u].b), true);
        }
        note_type(NODES[u].ty);
    }
}

// A loan of root r (-1: none) in the call being checked: one an enclosing
// pending argument also holds is a possible conflict; pending: it stays
// pending for the call's later arguments.
fn check_loan(r: i64, pending: bool) {
    unsafe {
        if r < 0 || CDEPTH <= 0 {
            return;
        }
        for i in 0..CROOTS.count {
            if CROOTS.data[i] == r {
                *rec_flags(REC_F) |= R_LOANS;
                return;
            }
        }
        if pending {
            CROOTS.push(r);
        }
    }
}

// What f's record says (needs_walk).
fn record_says(f: i64) -> bool {
    unsafe {
        mark_closures();
        if (REC_FLAGS[f] & R_LOANS) != 0 {
            return true;
        }
        if (REC_FLAGS[f] & R_SCAN) != 0 {
            return scan_fn(f);
        }
        let item = FNS[f].node;
        if tracked(FNS[f].ret) || crate::front::own::drops::fn_has_drops(f) {
            return true;
        }
        for i in 0..NODES[item].count {
            let l = NODES[child(item, i)].x;
            if l < 0 {
                continue;
            }
            let t = LOCALS[l].ty;
            if tracked(t) || t > 0 && TYPES[t].kind == TyKind::Ptr && tracked(TYPES[t].a) {
                return true;
            }
        }
        by_fn();
        if f >= BY_N {
            return true;
        }
        for i in BY_START[f]..BY_START[f + 1] {
            if tracked(BY_FN[i]) {
                return true;
            }
        }
        false
    }
}

// The records by function (a counting sort of REC), once.
fn by_fn() {
    unsafe {
        if BY_N >= 0 {
            return;
        }
        let n = crate::front::types::FN_COUNT + 1;
        let start = alloc_array::<i64>(n + 1);
        let pairs = REC.count / 2;
        for i in 0..pairs {
            let f = REC.data[2 * i];
            if f < n {
                start[f + 1] += 1;
            }
        }
        for f in 0..n {
            start[f + 1] += start[f];
        }
        let fill = alloc_array::<i64>(n + 1);
        let out = alloc_array::<i64>(pairs + 1);
        for i in 0..pairs {
            let f = REC.data[2 * i];
            if f < n {
                out[start[f] + fill[f]] = REC.data[2 * i + 1];
                fill[f] += 1;
            }
        }
        BY_START = start;
        BY_FN = out;
        BY_N = n;
    }
}

fn scan_fn(f: i64) -> bool {
    unsafe {
        let item = FNS[f].node;
        // (T1's drops: owned locals)
        if tracked(FNS[f].ret) || crate::front::own::drops::fn_has_drops(f) {
            return true;
        }
        for i in 0..NODES[item].count {
            let l = NODES[child(item, i)].x;
            if l < 0 {
                continue;
            }
            let t = LOCALS[l].ty;
            // (a pointer parameter to what holds views: the stores)
            if tracked(t) || t > 0 && TYPES[t].kind == TyKind::Ptr && tracked(TYPES[t].a) {
                return true;
            }
        }
        NEED = false;
        ROOTS.count = 0;
        STATIC_VIEWS = 0;
        scan(NODES[item].c);
        NEED
    }
}

// The root of place expression e: 2 * local, 2 * static + 1; -1: not a
// place.
fn place_root(e: i64) -> i64 {
    unsafe {
        let k = NODES[e].kind;
        if k == NodeKind::Ident {
            if NODES[e].res == Res::Local && NODES[e].y >= 0 {
                return 2 * NODES[e].y;
            }
            if NODES[e].res == Res::Static && NODES[e].y >= 0 {
                return 2 * NODES[e].y + 1;
            }
            return -1;
        }
        if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
            return place_root(NODES[e].a);
        }
        if k == NodeKind::Unary && NODES[e].op == crate::front::lexer::Tok::Star {
            return place_root(NODES[e].b);
        }
        if k == NodeKind::Index && NODES[NODES[e].b].kind != NodeKind::Range {
            return place_root(NODES[e].a);
        }
        -1
    }
}

// A loan of root r is taken while the pending ones are ROOTS.
fn loan(r: i64) {
    unsafe {
        if r < 0 {
            return;
        }
        for i in 0..ROOTS.count {
            if ROOTS.data[i] == r {
                NEED = true;
                return;
            }
        }
    }
}

fn scan_list(n: i64) {
    unsafe {
        for i in 0..NODES[n].count {
            scan(child(n, i));
        }
    }
}

fn scan_pattern(p: i64) {
    unsafe {
        if p == 0 {
            return;
        }
        let k = NODES[p].kind;
        if k == NodeKind::PatBind {
            if NODES[p].x >= 0 && tracked(LOCALS[NODES[p].x].ty) {
                NEED = true;
            }
            return;
        }
        if k == NodeKind::PatTuple || k == NodeKind::PatVariant || k == NodeKind::PatOr {
            for i in 0..NODES[p].count {
                scan_pattern(child(p, i));
            }
        }
    }
}

// Node n: its type, then (not for a leaf: a local, a literal) its parts.
// Inlined: a leaf costs no call (the scan's hottest path).
#[inline]
fn scan(n: i64) {
    unsafe {
        if n == 0 || NEED {
            return;
        }
        let t = NODES[n].ty;
        if t > 0 {
            let m = if t < MEMO_CAP { MEMO[t] } else { 0 };
            if m != 1 && (m >= 2 || tracked(t)) && !(MEMO[t] == 3 && raw_view(n)) {
                NEED = true;
                return;
            }
        }
        let k = NODES[n].kind;
        if k == NodeKind::Ident || k == NodeKind::Int || k == NodeKind::Bool
            || k == NodeKind::Char || k == NodeKind::CStr || k == NodeKind::Str {
            return;
        }
        scan_node(n);
    }
}

fn scan_node(n: i64) {
    unsafe {
        match NODES[n].kind {
            NodeKind::FieldAccess | NodeKind::TupleField | NodeKind::Cast
                | NodeKind::Repeat | NodeKind::EnumPanic => scan(NODES[n].a),
            NodeKind::Unary => scan(NODES[n].b),
            NodeKind::Index | NodeKind::Range => {
                scan(NODES[n].b);
                scan(NODES[n].a);
            }
            NodeKind::Binary => {
                scan(NODES[n].b);
                scan(NODES[n].c);
            }
            NodeKind::Assign => {
                scan(NODES[n].c);
                scan(NODES[n].b);
                loan(place_root(NODES[n].b));
            }
            NodeKind::Call => scan_call(n),
            NodeKind::Block => {
                for i in 0..NODES[n].count {
                    let s = child(n, i);
                    let k = NODES[s].kind;
                    if k == NodeKind::Let {
                        scan_pattern(NODES[s].a);
                        scan(NODES[s].c);
                    } else if k == NodeKind::Defer || k == NodeKind::ExprStmt {
                        scan(NODES[s].a);
                    } else {
                        scan(s);
                    }
                }
                scan(NODES[n].a);
            }
            NodeKind::If => {
                scan(NODES[n].a);
                scan(NODES[n].b);
                scan(NODES[n].c);
            }
            NodeKind::Match => {
                scan(NODES[n].a);
                for i in 0..NODES[n].count {
                    let arm = child(n, i);
                    scan_pattern(NODES[arm].a);
                    scan(NODES[arm].b);
                    scan(NODES[arm].c);
                }
            }
            // (as walk.vl's eval_loop: a loop's other fields are no nodes)
            NodeKind::Loop => scan(NODES[n].b),
            NodeKind::While => {
                scan(NODES[n].b);
                scan(NODES[n].c);
            }
            NodeKind::For => {
                scan_pattern(NODES[n].b);
                scan(NODES[n].c);
                scan(NODES[n].d);
            }
            NodeKind::Break => scan(NODES[n].b),
            NodeKind::Return => scan(NODES[n].a),
            NodeKind::Tuple | NodeKind::Array | NodeKind::StructLit
                | NodeKind::VariantLit => scan_list(n),
            NodeKind::FieldInit | NodeKind::NamedArg => scan(NODES[n].b),
            NodeKind::Closure | NodeKind::Try | NodeKind::Interp => scan(NODES[n].y),
            NodeKind::VecOp => {
                scan(NODES[n].a);
                scan_list(n);
            }
            _ => {}
        }
    }
}

// A call: its arguments in order; a loan (`&place`, a borrowed pointer
// passed on, a view read out of a place: `p.text`) is checked against the
// pending ones, then pending itself. A view of a static pending while a
// nested call runs (it may write statics) needs the walk.
fn scan_call(n: i64) {
    unsafe {
        if STATIC_VIEWS > 0 {
            NEED = true;
            return;
        }
        if NODES[n].x - 1 < 0 {
            scan(NODES[n].a);
        }
        let mark = ROOTS.count;
        let statics = STATIC_VIEWS;
        for i in 0..NODES[n].count {
            let arg = child(n, i);
            let k = NODES[arg].kind;
            var r = -1;
            if k == NodeKind::Unary && NODES[arg].op == crate::front::lexer::Tok::Amp {
                scan(NODES[arg].b);
                r = place_root(NODES[arg].b);
            } else if k == NodeKind::Ident && NODES[arg].res == Res::Local && NODES[arg].y >= 0
                && LOCALS[NODES[arg].y].borrow && NODES[arg].ty > 0
                && TYPES[NODES[arg].ty].kind == TyKind::Ptr {
                r = 2 * NODES[arg].y;
            } else {
                r = view_arg(arg);
                if r == -2 {
                    scan(arg);
                    r = -1;
                } else if r >= 0 && (r & 1) == 1 {
                    STATIC_VIEWS += 1;
                }
            }
            if NEED {
                break;
            }
            if r >= 0 {
                loan(r);
                ROOTS.push(r);
            }
        }
        ROOTS.count = mark;
        STATIC_VIEWS = statics;
    }
}

// An argument that is a view (not owned) read out of a place, or one that
// holds no views of anything (raw_view): its parts scanned, then its root
// (a loan for the call: the walk's pending view), -1 for none; -2: another
// kind of argument.
fn view_arg(arg: i64) -> i64 {
    unsafe {
        let t = NODES[arg].ty;
        if t <= 0 || !tracked(t) || MEMO[t] != 3 {
            return -2;
        }
        if raw_view(arg) {
            scan_node(arg);
            return -1;
        }
        let r = place_root(arg);
        if r < 0 {
            return -2;
        }
        scan_node(arg);
        r
    }
}
