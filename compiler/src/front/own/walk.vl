// The own walk (0.17, docs/design/value-semantics.md §4 step 4): a forward
// abstract interpretation of one checked function body, in the grammar's
// evaluation order (left to right, the right-hand side before the place,
// an index before its base is read, a `&mut self` receiver after the
// arguments). It is the prototype's traversal (c17-proto, §8.1) with every
// rule taken out into the event hooks below:
//
//   ev_read    a place is read, or borrowed (T1: use after move; T2: an
//              invalidated view used)
//   ev_write   a place is written, or mutably borrowed (T2: invalidation)
//   ev_move    an owned place is moved (T1: the moved bits; T2: its views
//              invalidated)
//   ev_init    a place is (re)initialized (T1)
//   ev_drop    a local's drop runs at an exit (T1: drop states; T2)
//   ev_borrow  `&place`, `&mut place`: the loan and its origin (T2)
//   ev_value   the views a value read out of a place holds (T2)
//   ev_bind    a local is bound to a value (T1: initialized; T2: its slot)
//   ev_assign  an assignment's place, after its value (T1, T2)
//   ev_scope   a scope ends: its locals die (T2)
//   ev_call    a call, its arguments pending (T2: conflicts, stores,
//              statics, the result's origin through summary_of)
//   ev_result  the function's result, at a `return` or the tail (T2:
//              escapes; T3: the summary)
//
// moves.vl (T1) and views.vl/calls.vl (T2) implement the hooks;
// summary.vl (T3) collects the result's summary. The traversal (control
// flow: if and match join, loops iterate to a fixed point, break/continue/
// return feed their targets, defers and drops share one exit list) is the
// lead's: neither task changes it without the lead.
//
// Phase 0 contract: walk_fn and the ev_* signatures are fixed.

use crate::base::{IntVec, SYMS, intern_c};
use crate::front::ast::{
    CLOSURE_MOVE, DEFER_IMPLICIT, FN_CLOSURE, NODES, NODE_CAPTURE, NODE_IN_BOUNDS, NODE_RAW,
    NODE_REF_MUT, NodeKind, child,
};
use crate::front::check::{LOCALS, Res};
use crate::front::lexer::Tok;
use crate::front::modules::{STD_MODULE, within_std};
use crate::front::own::{calls, fast, moves, views};
use crate::front::own::kinds::{
    P_MUT, P_MUT_VIEW, P_RAW, P_SHARED, P_VALUE, P_VIEW, has_drop_impl, is_moved_type,
    is_owned_type, is_view_type, param_mode,
};
use crate::front::own::state::{
    CUR, LOC_CAP, LOC_PL, LOC_SLOT, MAXNW, NW, PE, PEND, PK_MUT, PK_MUT_VIEW, PK_NONE, PK_RAW,
    PK_RESERVE, PK_SHARED, PK_VIEW, PL_OVERFLOW, PL_PARENT, PL_RKIND, POOL, POOL_TOP, RK_STATIC,
    SLOT_CAP, SLOT_OVERFLOW, TUPLE_FIELD, alias_local, child_place, copy_state, is_empty,
    join_state, l1, l2, local_place, new_ov, new_state, or_into, ov_inner, ov_or, pend_push,
    reachable, reset_places, root_of, same_state, set_bit, set_unreachable, set_words, slot_for,
    static_has_place, static_place, variant_field_key,
};
use crate::front::own::summary::{
    ViewSummary, collect_begin, collect_end, collect_result, env_param,
};
use crate::front::patterns::binds_ref;
use crate::front::types::{FNS, REF_MUT, REF_SHARED, TYPES, TyKind};

// The value of an expression is read (a copy, or a borrow) or moved.
pub const CX_READ: i64 = 0;
pub const CX_MOVE: i64 = 1;

// How a move leaves its place (ev_move): a local or a field of one; out of
// an index, through a pointer or reference, out of a static (all errors,
// T1's own.move_out).
pub const MO_PLACE: i64 = 0;
pub const MO_INDEX: i64 = 1;
pub const MO_DEREF: i64 = 2;
pub const MO_STATIC: i64 = 3;

// How a write reaches its place (ev_write).
pub const W_WRITE: i64 = 0;
pub const W_MOVE: i64 = 1;
pub const W_DROP: i64 = 2;
pub const W_MUT_BORROW: i64 = 3;

// The function walked, and its parameters' locals (by index).
pub static var CUR_F: i64 = -1;
pub static var PARAM_LOCALS: crate::base::IntVec =
    crate::base::IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Loop frames: node, break state, continue state, defer mark.
static var LOOPF: crate::base::IntVec = crate::base::IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The defers (and drops) of the enclosing blocks, in order.
pub static var DEFS: crate::base::IntVec = crate::base::IntVec {
    data: 0 as *i64, count: 0, cap: 0
};
// The locals bound in the enclosing scopes, in order (ev_scope gets the
// ones that die).
pub static var BOUND: crate::base::IntVec = crate::base::IntVec {
    data: 0 as *i64, count: 0, cap: 0
};
// Inside a closure that borrows its captures, or an f-string's holes (they
// read, never move), and inside a defer.
pub static var NO_MOVE: i64 = 0;
pub static var IN_DEFER: i64 = 0;
// Node visits, and loop rounds (for --time-passes' report and the budget).
pub static var VISITS: i64 = 0;
pub static var LOOP_ROUNDS: i64 = 0;
pub static var WALKED: i64 = 0;

// What place_of found on the way: through a pointer or reference
// (PO_DEREF), a raw one (PO_RAW), an index (PO_INDEX), inside what a view
// points to (PO_INNER), into the elements of a slot's slice (PO_VIEWSLOT).
pub static var PO_DEREF: bool = false;
pub static var PO_INDEX: bool = false;
pub static var PO_RAW: bool = false;
pub static var PO_INNER: bool = false;
pub static var PO_VIEWSLOT: i64 = -1;

// (0.18.1) While `&place` is taken: the origin that gets the views of a
// value the place is reached through (`&v.as_slice()[i]`), place_rec.
static var PO_VALUE_DST: i64 = -1;
// (whether place_rec makes the places of plain locals and statics: where
// something borrows them)
static var PO_MAKE: bool = false;
static var SYM_FOR_SEQ: i64 = 0;

// ---------------------------------------------------------------------------
// The events

pub fn ev_read(p: i64, n: i64) {
    unsafe {
        if p < 0 || !reachable(CUR) {
            return;
        }
        moves::on_read(p, n);
        views::on_read(p, n);
    }
}

pub fn ev_write(p: i64, n: i64, how: i64) {
    unsafe {
        if p < 0 || !reachable(CUR) {
            return;
        }
        views::on_write(p, n, how);
    }
}

pub fn ev_move(p: i64, n: i64, how: i64) {
    unsafe {
        if p < 0 || !reachable(CUR) {
            return;
        }
        if NO_MOVE > 0 {
            ev_read(p, n);
            return;
        }
        moves::on_move(p, n, how);
        if how == MO_PLACE {
            views::on_write(p, n, W_MOVE);
        }
    }
}

pub fn ev_init(p: i64) {
    unsafe {
        if p < 0 || !reachable(CUR) {
            return;
        }
        moves::on_init(p);
    }
}

// The drop of local l (its implicit defer d) at an exit.
pub fn ev_drop(l: i64, d: i64) {
    unsafe {
        if l < 0 || !reachable(CUR) {
            return;
        }
        let p = local_place(l);
        moves::on_drop(p, l, d);
        views::on_write(p, d, W_DROP);
    }
}

// `&p` (kind REF_SHARED) or `&mut p` (REF_MUT) at node n; dst (an origin
// value, or -1) gets the loan. raw: p is reached through a raw pointer.
pub fn ev_borrow(p: i64, n: i64, kind: i64, raw: bool, dst: i64) {
    unsafe {
        if p < 0 || !reachable(CUR) {
            return;
        }
        ev_read(p, n);
        if kind == REF_MUT {
            views::on_write(p, n, W_MUT_BORROW);
        }
        views::on_borrow(p, n, kind, raw, dst);
    }
}

// The value read out of place p at node n, of type ty: dst gets the views
// it holds (PO_* say how p was reached).
pub fn ev_value(p: i64, n: i64, ty: i64, dst: i64) {
    unsafe {
        if p < 0 || dst < 0 || !reachable(CUR) {
            return;
        }
        views::on_value(p, n, ty, dst);
    }
}

// Local l bound at node n to a value of origin v (-1: none).
pub fn ev_bind(l: i64, n: i64, v: i64) {
    unsafe {
        if l < 0 || !reachable(CUR) {
            return;
        }
        BOUND.push(l);
        views::on_bind(l, n, v);
        if is_moved_type(LOCALS[l].ty) {
            ev_init(local_place(l));
        }
    }
}

// Assignment n (`=` or `op=`) to place p, its value's origin v.
pub fn ev_assign(p: i64, n: i64, v: i64) {
    unsafe {
        if p < 0 || !reachable(CUR) {
            return;
        }
        let compound = NODES[n].op != Tok::Eq;
        if PO_VIEWSLOT < 0 && !PO_RAW && compound {
            ev_read(p, n);
        }
        if !compound {
            // (0.18.1: an owned copy that borrows, replaced: its old value
            // dropped)
            moves::byref_change(p, n, NODES[NODES[n].b].ty);
        }
        views::on_assign(p, n, v);
        if !compound && !PO_INDEX && !PO_DEREF {
            ev_init(p);
        }
    }
}

// The end of a scope whose bindings are BOUND[mark..]: they die; v is the
// origin of the scope's value (-1: none), tail its node (0: none).
pub fn ev_scope(mark: i64, v: i64, tail: i64) {
    unsafe {
        if reachable(CUR) {
            views::on_scope_end(mark, v, tail);
        }
        BOUND.count = mark;
    }
}

// Call n of function f (-1: through a fn value), its arguments pending at
// PEND[base..]; dst gets the result's views.
pub fn ev_call(n: i64, f: i64, base: i64, dst: i64) {
    calls::on_call(n, f, base, dst);
}

// The function's result: e its node (a `return`'s value, the tail, or the
// return or body when there is none), v its origin (-1: none).
pub fn ev_result(e: i64, v: i64) {
    unsafe {
        if !reachable(CUR) {
            return;
        }
        views::on_result(e, v);
        collect_result(e, v);
    }
}

// ---------------------------------------------------------------------------
// Places

// A local whose place matters even unborrowed: it holds views or owns, or
// is a parameter (reads through it reach its roots).
fn relevant_local(l: i64) -> bool {
    unsafe {
        if l < 0 {
            return false;
        }
        if l < LOC_CAP && (LOC_PL[l] != 0 || LOC_SLOT[l] != 0) {
            return true;
        }
        LOCALS[l].is_param || is_moved_type(LOCALS[l].ty)
    }
}

fn clear_po(make: bool) {
    unsafe {
        PO_DEREF = false;
        PO_INDEX = false;
        PO_RAW = false;
        PO_INNER = false;
        PO_VIEWSLOT = -1;
        PO_MAKE = make;
    }
}

// The place expression e denotes (its index expressions evaluated), or -1;
// sets PO_*.
pub fn place_of(e: i64) -> i64 {
    clear_po(false);
    place_rec(e)
}

// place_of, making the places of plain locals and statics (a loan is taken
// on it).
pub fn place_of_make(e: i64) -> i64 {
    unsafe {
        clear_po(true);
        let p = place_rec(e);
        PO_MAKE = false;
        p
    }
}

// Whether pointer expression e is a reference or a borrow (safe to
// dereference), not raw.
fn is_reference(e: i64) -> bool {
    unsafe {
        if NODES[e].ty > 0 && TYPES[NODES[e].ty].kind == TyKind::Ptr && TYPES[NODES[e].ty].b != 0 {
            return true;
        }
        if NODES[e].kind == NodeKind::FieldAccess && NODES[e].y == 1 && NODES[e].a > 0
            && (NODES[e].p & NODE_CAPTURE) == 0 && env_local(NODES[e].a) {
            // (a closure's capture by reference, `(*env).x`: the captured
            // variable itself, env_ref_field)
            return true;
        }
        NODES[e].kind == NodeKind::Ident && NODES[e].res == Res::Local && NODES[e].y >= 0
            && (LOCALS[NODES[e].y].borrow || env_local(e))
    }
}

// Whether e names the walked closure's env parameter (summary::env_param):
// a reference to the closure's value, its captures.
pub fn env_local(e: i64) -> bool {
    unsafe {
        NODES[e].kind == NodeKind::Ident && NODES[e].res == Res::Local && PARAM_LOCALS.count > 0
            && NODES[e].y == PARAM_LOCALS.data[0] && env_param(CUR_F, 0)
    }
}

fn place_rec(e: i64) -> i64 {
    unsafe {
        let k = NODES[e].kind;
        if k == NodeKind::Ident {
            if NODES[e].res == Res::Local {
                let l = NODES[e].y;
                if !PO_MAKE && !relevant_local(l) {
                    return -1;
                }
                return local_place(l);
            }
            if NODES[e].res == Res::Static {
                let s = NODES[e].y;
                if !PO_MAKE && !static_has_place(s) {
                    return -1;
                }
                return static_place(s);
            }
            return -1;
        }
        if k == NodeKind::FieldAccess {
            let base = place_rec(NODES[e].a);
            if NODES[e].y == 1 {
                PO_DEREF = true;
                if !is_reference(NODES[e].a) {
                    PO_RAW = true;
                }
            }
            return child_place(base, NODES[e].b);
        }
        if k == NodeKind::TupleField {
            let base = place_rec(NODES[e].a);
            return child_place(base, TUPLE_FIELD + NODES[e].b);
        }
        if k == NodeKind::Unary && NODES[e].op == Tok::Star {
            PO_DEREF = true;
            if !is_reference(NODES[e].b) {
                PO_RAW = true;
            }
            return place_rec(NODES[e].b);
        }
        if k == NodeKind::Index {
            // (the index first: the 0.14 order)
            let deref = PO_DEREF;
            let index = PO_INDEX;
            let raw = PO_RAW;
            let inner = PO_INNER;
            let vs = PO_VIEWSLOT;
            let make = PO_MAKE;
            let vd = PO_VALUE_DST;
            PO_VALUE_DST = -1;
            eval(NODES[e].b, CX_READ, -1);
            PO_VALUE_DST = vd;
            PO_MAKE = make;
            PO_DEREF = deref;
            PO_INDEX = index;
            PO_RAW = raw;
            PO_INNER = inner;
            PO_VIEWSLOT = vs;
            let base = NODES[e].a;
            let bt = NODES[base].ty;
            let p = place_rec(base);
            PO_INDEX = true;
            if bt > 0 && TYPES[bt].kind == TyKind::Slice {
                PO_DEREF = true;
                PO_INNER = true;
                if p >= 0 && PL_PARENT[p] < 0 {
                    PO_VIEWSLOT = crate::front::own::state::slot_of_place(p);
                }
            } else if bt > 0 && TYPES[bt].kind == TyKind::Ptr {
                PO_DEREF = true;
                if (NODES[e].p & NODE_RAW) != 0 || !is_reference(base) {
                    PO_RAW = true;
                }
            }
            return p;
        }
        // (a value: a call's result, a literal; under `&`, what the
        // loan views: `&v[i]` of a Vec is `&v.as_slice()[i]`)
        let d = PO_VALUE_DST;
        PO_VALUE_DST = -1;
        // (0.25: what the value's own evaluation finds on its way is not this
        // place's: PO_* as they were)
        let deref = PO_DEREF;
        let index = PO_INDEX;
        let raw = PO_RAW;
        let inner = PO_INNER;
        let vs = PO_VIEWSLOT;
        let make = PO_MAKE;
        eval(e, CX_READ, d);
        PO_DEREF = deref;
        PO_INDEX = index;
        PO_RAW = raw;
        PO_INNER = inner;
        PO_VIEWSLOT = vs;
        PO_MAKE = make;
        -1
    }
}

fn is_place_expr(e: i64) -> bool {
    unsafe {
        let k = NODES[e].kind;
        if k == NodeKind::Ident {
            return NODES[e].res == Res::Local || NODES[e].res == Res::Static;
        }
        if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
            return NODES[e].y == 1 || is_place_expr(NODES[e].a);
        }
        if k == NodeKind::Unary {
            return NODES[e].op == Tok::Star;
        }
        if k == NodeKind::Index {
            return NODES[NODES[e].b].kind != NodeKind::Range;
        }
        false
    }
}

// ---------------------------------------------------------------------------
// Expressions

fn eval_list(n: i64, ctx: i64, dst: i64) {
    unsafe {
        for i in 0..NODES[n].count {
            eval(child(n, i), ctx, dst);
        }
    }
}

// The call whose value may be a borrowed copy (drops::borrowed_call)
// without an error: a `let`'s or a `match`'s, a raw or C argument, the
// receiver of `unwrap` and the like (eval_let, eval_match, eval_call).
static var BORROW_OK: i64 = 0;

// (0.25) The value of a let-else's matching arm on a borrowed copy, a
// tuple of its bindings, read (not moved): eval's Match.
static var LE_READ: i64 = 0;

// (0.25) The temporaries' places made in the statement being walked
// (state::temp_place), which die at its end.
pub static var TEMPS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// (0.25) Whether the value being bound is a borrowed copy (drops::
// borrowed_call: `let s = v.get(0)` of a Vec<String>): a binding of an
// owned type then views what the copy's container holds.
static var BIND_BORROWED: bool = false;

// Evaluates expression n (0: none); ctx says whether its value is moved;
// dst (an origin value, or -1) gets the views it holds.
pub fn eval(n: i64, ctx: i64, dst: i64) {
    unsafe {
        if n == 0 {
            return;
        }
        VISITS += 1;
        match NODES[n].kind {
            NodeKind::Ident | NodeKind::FieldAccess
                | NodeKind::TupleField => eval_place_value(n, ctx, dst),
            NodeKind::Unary => {
                let op = NODES[n].op;
                if op == Tok::Star {
                    eval_place_value(n, ctx, dst);
                } else if op == Tok::Amp {
                    let operand = NODES[n].b;
                    if is_place_expr(operand) {
                        PO_VALUE_DST = dst;
                        let p = place_of_make(operand);
                        PO_VALUE_DST = -1;
                        let kind = if (NODES[n].p & NODE_REF_MUT) != 0 { REF_MUT }
                            else { REF_SHARED };
                        ev_borrow(p, n, kind, PO_RAW, dst);
                    } else if dst >= 0 {
                        // (0.25) `&temp`: a loan on a value no place holds;
                        // what it holds is at both levels (a method of the
                        // temporary reads it through the loan, `*self`)
                        let t = new_ov();
                        eval(operand, CX_READ, t);
                        crate::front::own::calls::deep_into(dst, t);
                        POOL_TOP = t;
                        // and, when it has storage of its own (an owner, or
                        // plain data: not only views), the temporary itself,
                        // which dies at the end of the statement
                        let ot = NODES[operand].ty;
                        if ot > 0 && (is_owned_type(ot) || !is_view_type(ot)) {
                            let q = crate::front::own::state::temp_place(operand);
                            if q >= 0 {
                                set_bit(l1(dst), q);
                                TEMPS.push(q);
                            }
                        }
                    } else {
                        eval(operand, CX_READ, dst);
                    }
                } else {
                    eval(NODES[n].b, CX_READ, -1);
                }
            }
            NodeKind::Index => {
                if NODES[NODES[n].b].kind == NodeKind::Range {
                    eval_slicing(n, dst);
                } else {
                    eval_place_value(n, ctx, dst);
                }
            }
            NodeKind::Cast => eval(NODES[n].a, CX_READ, dst),
            NodeKind::Binary => {
                eval(NODES[n].b, CX_READ, -1);
                let op = NODES[n].op;
                if op == Tok::AmpAmp || op == Tok::PipePipe {
                    let saved = new_state();
                    copy_state(saved, CUR);
                    eval(NODES[n].c, CX_READ, -1);
                    join_state(CUR, saved);
                    POOL_TOP = saved;
                } else {
                    eval(NODES[n].c, CX_READ, -1);
                }
            }
            NodeKind::Assign => eval_assign(n),
            NodeKind::Call => {
                let ok = BORROW_OK == n;
                eval_call(n, dst);
                moves::drop_call(n);
                if ctx == CX_MOVE && !ok && !within_std(FNS[CUR_F].module)
                    && crate::front::own::drops::borrowed_call(n) {
                    // (a copy of an element a collection keeps, moved:
                    // returned, stored, passed by value)
                    crate::front::own::moves::borrowed_move(n);
                }
            }
            NodeKind::Block => eval_block(n, ctx, dst),
            NodeKind::If => {
                eval(NODES[n].a, CX_READ, -1);
                let saved = new_state();
                copy_state(saved, CUR);
                eval(NODES[n].b, ctx, dst);
                let then_state = new_state();
                copy_state(then_state, CUR);
                copy_state(CUR, saved);
                eval(NODES[n].c, ctx, dst);
                join_state(CUR, then_state);
                POOL_TOP = saved;
            }
            NodeKind::Match => {
                // (0.25: let-else on a borrowed copy, `let Some(t) = v.last()
                // else ..`: its bindings borrow, read as its value, as `?`'s)
                if crate::front::own::drops::borrowed_call(n) {
                    let ok = BORROW_OK == n;
                    let value = NODES[child(n, 0)].c;
                    let saved = LE_READ;
                    LE_READ = value;
                    eval_match(n, CX_READ, dst);
                    LE_READ = saved;
                    if ctx == CX_MOVE && !ok && !within_std(FNS[CUR_F].module) {
                        crate::front::own::moves::borrowed_move(n);
                    }
                } else {
                    eval_match(n, ctx, dst);
                }
            }
            NodeKind::Loop | NodeKind::While | NodeKind::For => eval_loop(n),
            NodeKind::Break => {
                let lp = NODES[n].x;
                eval(NODES[n].b, CX_MOVE, -1);
                let f = find_frame(lp);
                if f >= 0 {
                    run_defers(LOOPF.data[f + 3]);
                    join_state(LOOPF.data[f + 1], CUR);
                }
                set_unreachable(CUR);
            }
            NodeKind::Continue => {
                let f = find_frame(NODES[n].x);
                if f >= 0 {
                    run_defers(LOOPF.data[f + 3]);
                    join_state(LOOPF.data[f + 2], CUR);
                }
                set_unreachable(CUR);
            }
            NodeKind::Return => {
                let v = new_ov();
                eval(NODES[n].a, CX_MOVE, v);
                if NODES[n].a != 0 {
                    ev_result(NODES[n].a, v);
                } else {
                    ev_result(n, -1);
                }
                run_defers(0);
                set_unreachable(CUR);
                POOL_TOP = v;
            }
            NodeKind::Tuple | NodeKind::Array | NodeKind::StructLit | NodeKind::VariantLit => {
                eval_list(n, if LE_READ == n { CX_READ } else { CX_MOVE }, dst);
            }
            NodeKind::FieldInit | NodeKind::NamedArg => eval(NODES[n].b, ctx, dst),
            NodeKind::Repeat => eval(NODES[n].a, CX_MOVE, dst),
            NodeKind::Range => {
                eval(NODES[n].a, CX_READ, -1);
                eval(NODES[n].b, CX_READ, -1);
            }
            NodeKind::Closure => {
                let moving = (NODES[n].c & CLOSURE_MOVE) != 0;
                if !moving {
                    NO_MOVE += 1;
                } else {
                    moves::sink_borrowed_captures(n);
                }
                eval(NODES[n].y, CX_MOVE, dst);
                if !moving {
                    NO_MOVE -= 1;
                }
            }
            NodeKind::Try => {
                // (0.25: `v.last()?`, a borrowed copy, as the Call above)
                // (its match binds ?v by reference, drops::try_let_borrows:
                // the value is read there, and moved only as a whole, here)
                let ok = BORROW_OK == n;
                let borrowed = crate::front::own::drops::borrowed_call(n);
                eval(NODES[n].y, if borrowed { CX_READ } else { ctx }, dst);
                if borrowed && ctx == CX_MOVE && !ok && !within_std(FNS[CUR_F].module) {
                    crate::front::own::moves::borrowed_move(n);
                }
            }
            NodeKind::Interp => {
                // (the holes are shared borrows, §2.7: their lets, `let =fN
                // = eN`, read eN (eval_let); what eN moves inside, as
                // `E::A(w)`, it moves; the closure does not own them)
                eval(NODES[n].y, ctx, dst);
            }
            NodeKind::EnumPanic => eval(NODES[n].a, CX_READ, -1),
            NodeKind::VecOp => {
                eval(NODES[n].a, CX_READ, -1);
                eval_list(n, CX_READ, -1);
            }
            _ => {}
        }
    }
}

// The value of a place expression: a read, or a move of an owned value.
fn eval_place_value(n: i64, ctx: i64, dst: i64) {
    unsafe {
        let t = NODES[n].ty;
        if NODES[n].kind == NodeKind::Ident && NODES[n].res != Res::Local
            && NODES[n].res != Res::Static {
            return;
        }
        if !is_place_expr(n) {
            // (a field of a call's result: the value's; an element of a
            // collection a call views, `v[i]` of a Vec (`v.as_slice()[i]`),
            // or what a call's reference points to, moved: own.move_out)
            // (a raw pointer's `p[i]`, `*p`: unsafe code's bitwise read)
            if ctx == CX_MOVE && is_moved_type(t) && (NODES[n].p & NODE_RAW) == 0 {
                let k = NODES[n].kind;
                if k == NodeKind::Index {
                    crate::front::own::moves::move_out_value(n, MO_INDEX);
                } else if k == NodeKind::Unary
                    || k == NodeKind::FieldAccess && NODES[n].y == 1 {
                    crate::front::own::moves::move_out_value(n, MO_DEREF);
                } else if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
                    // (0.24: a field of a temporary whose type implements
                    // Drop, `make().v`: the drop needs all of it, as a
                    // local's, own.partial)
                    crate::front::own::moves::partial(n);
                }
            }
            // (0.25: a plain field of a borrowed copy, `v.last()?.id`, is read)
            let bctx = if ctx == CX_MOVE && !is_owned_type(t)
                && crate::front::own::drops::borrowed_call(NODES[n].a) { CX_READ } else { ctx };
            eval(NODES[n].a, bctx, dst);
            return;
        }
        // (0.25) a place reached through a value, `v[i]` of a Vec
        // (`v.as_slice()[i]`), `*r()`: tmp gets that value's views, and
        // the element read out of what it views gets their level 2
        let view = dst >= 0 && (is_view_type(t) || t > 0 && TYPES[t].kind == TyKind::Ptr);
        let tmp = if view { new_ov() } else { -1 };
        PO_VALUE_DST = tmp;
        let p = place_of(n);
        PO_VALUE_DST = -1;
        if tmp >= 0 {
            if p < 0 && !PO_RAW {
                if PO_INNER || PO_DEREF {
                    ov_inner(dst, tmp);
                } else {
                    ov_or(dst, tmp);
                }
            }
            POOL_TOP = tmp;
        }
        if p < 0 {
            // (`v[i]` of a Vec through a reference: no place, a copy of an
            // element the Vec keeps)
            // (0.25: a field or a tuple part of such an element too, `w[0].v`)
            if ctx == CX_MOVE && is_moved_type(t) && (NODES[n].p & NODE_RAW) == 0
                && part_of_index(n) {
                crate::front::own::moves::move_out_value(n, MO_INDEX);
            }
            return;
        }
        // (0.25: or one holding an inout access, move-only)
        if ctx == CX_MOVE && is_moved_type(t) {
            let r = root_of(p);
            let how = if PL_RKIND[r] == RK_STATIC { MO_STATIC } else if PO_INDEX { MO_INDEX }
                else if PO_DEREF { MO_DEREF } else { MO_PLACE };
            ev_move(p, n, how);
        } else {
            ev_read(p, n);
        }
        if is_view_type(t) || t > 0 && TYPES[t].kind == TyKind::Ptr
            || crate::front::own::glue::has_glue(t)
            && crate::front::own::state::slot_of_place(p) >= 0 {
            ev_value(p, n, t, dst);
        }
    }
}

// (0.25) Whether place expression n is an index, or a field or a tuple part
// of one (`w[0].v.1`).
fn part_of_index(n: i64) -> bool {
    unsafe {
        var e = n;
        while NODES[e].kind == NodeKind::FieldAccess && NODES[e].y != 1
            || NODES[e].kind == NodeKind::TupleField {
            e = NODES[e].a;
        }
        NODES[e].kind == NodeKind::Index
    }
}

// `base[a..b]`: an array's elements are a loan on it; a slice's (or a
// pointer's) are what the slice views.
fn eval_slicing(n: i64, dst: i64) {
    unsafe {
        let base = NODES[n].a;
        let range = NODES[n].b;
        eval(NODES[range].a, CX_READ, -1);
        eval(NODES[range].b, CX_READ, -1);
        let bt = NODES[base].ty;
        if bt > 0 && TYPES[bt].kind == TyKind::Array && is_place_expr(base) {
            let p = place_of_make(base);
            let kind = if (NODES[n].p & NODE_REF_MUT) != 0 { REF_MUT } else { REF_SHARED };
            ev_borrow(p, n, kind, PO_RAW, dst);
            return;
        }
        eval(base, CX_READ, dst);
    }
}

// (0.25) Whether local l is a statement temporary's pointer (drops::
// visit_temps: `__own_tp = &__own_tv`), which the walk follows: what it
// points to is the temporary, alive to the end of its statement.
fn tp_local(l: i64) -> bool {
    unsafe { l >= 0 && SYMS[LOCALS[l].name].text == "__own_tp" }
}

// (0.25) Whether place expression e is a part of a static (not through a
// pointer): an assignment to it needs its place, for statics hold only
// views of static data (views::static_store).
fn static_root(e: i64) -> bool {
    unsafe {
        let k = NODES[e].kind;
        if k == NodeKind::Ident {
            return NODES[e].res == Res::Static;
        }
        if k == NodeKind::FieldAccess && NODES[e].y == 0 || k == NodeKind::TupleField
            || k == NodeKind::Index {
            return static_root(NODES[e].a);
        }
        false
    }
}

fn eval_assign(n: i64) {
    unsafe {
        let target = NODES[n].b;
        let value = NODES[n].c;
        let v = new_ov();
        eval(value, if NODES[n].op == Tok::Eq { CX_MOVE } else { CX_READ }, v);
        // (0.25: a place reached through a view value, `v[i] = w` of a Vec:
        // its origin, what the write reaches)
        let t = new_ov();
        PO_VALUE_DST = t;
        let p = if static_root(target) { place_of_make(target) } else { place_of(target) };
        PO_VALUE_DST = -1;
        if p >= 0 && NODES[target].kind == NodeKind::Ident && NODES[target].res == Res::Local
            && tp_local(NODES[target].y) {
            // (0.25) `__own_tp = &__own_tv`: it points to the statement's
            // temporary (a place of its own, which dies with the statement,
            // views::kill_temps), which holds what __own_tv holds
            let w = new_ov();
            let q = crate::front::own::state::temp_place(n);
            if q >= 0 {
                set_bit(l1(w), q);
                TEMPS.push(q);
            }
            or_into(l2(w), l2(v));
            ev_assign(p, n, w);
        } else if p >= 0 {
            ev_assign(p, n, v);
        } else if !PO_RAW && reachable(CUR) {
            views::write_through_value(t, n, v);
        }
        POOL_TOP = v;
    }
}

// Binds pattern pat (at node n) to a value with origin v (-1: none).
fn bind(pat: i64, v: i64) {
    bind_at(pat, v, -1);
}

// bind, the matched value at place `place` (-1: none, or not followed):
// a binding that is a reference into it (0.18.1, PAT_REF) borrows its
// field's place, as `&(*e).f` does, so that references to two fields
// are apart; without a place it views what the value views.
fn bind_at(pat: i64, v: i64, place: i64) {
    unsafe {
        if pat == 0 {
            return;
        }
        let k = NODES[pat].kind;
        if k == NodeKind::PatBind {
            let l = NODES[pat].x;
            if l < 0 {
                return;
            }
            if place >= 0 && binds_ref(pat) {
                let o = new_ov();
                clear_po(false);
                PO_DEREF = true;
                let kind = if TYPES[LOCALS[l].ty].b == REF_MUT { REF_MUT } else { REF_SHARED };
                ev_borrow(place, pat, kind, false, o);
                slot_for(l, true);
                ev_bind(l, pat, o);
                POOL_TOP = o;
                return;
            }
            // (0.25: or a value of no view type that views something, a
            // borrowed copy of an element: `let x = v.get(0)` of a
            // Vec<String> is a view of v)
            slot_for(l, is_view_type(LOCALS[l].ty) || tp_local(l) || v >= 0 && BIND_BORROWED
                && crate::front::own::glue::has_glue(LOCALS[l].ty)
                && (!is_empty(l1(v)) || !is_empty(l2(v))));
            ev_bind(l, pat, v);
            return;
        }
        if k == NodeKind::PatTuple || k == NodeKind::PatVariant || k == NodeKind::PatOr {
            for i in 0..NODES[pat].count {
                var sub = -1;
                if place >= 0 && k == NodeKind::PatTuple {
                    sub = child_place(place, TUPLE_FIELD + i);
                } else if place >= 0 && k == NodeKind::PatVariant {
                    sub = child_place(place, variant_field_key(NODES[pat].x, i));
                }
                bind_at(child(pat, i), v, sub);
            }
        }
    }
}

// Whether pattern p binds a reference into the matched value (PAT_REF).
fn has_ref_binding(p: i64) -> bool {
    unsafe {
        if p == 0 {
            return false;
        }
        let k = NODES[p].kind;
        if k == NodeKind::PatBind {
            return binds_ref(p);
        }
        if k == NodeKind::PatTuple || k == NodeKind::PatVariant || k == NodeKind::PatOr {
            for i in 0..NODES[p].count {
                if has_ref_binding(child(p, i)) {
                    return true;
                }
            }
        }
        false
    }
}

// The place pattern pat's references borrow from, matched against e:
// e's, when pat has one and e is a path of locals, fields and `*` through
// references (an index is evaluated, a raw pointer is not followed); else
// -1.
fn ref_bind_place(e: i64, pat: i64) -> i64 {
    unsafe {
        if e == 0 || !has_ref_binding(pat) {
            return -1;
        }
        var x = e;
        loop {
            let k = NODES[x].kind;
            if k == NodeKind::Ident {
                break;
            }
            if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
                x = NODES[x].a;
            } else if k == NodeKind::Unary && NODES[x].op == Tok::Star {
                x = NODES[x].b;
            } else {
                return -1;
            }
        }
        if !is_place_expr(e) {
            return -1;
        }
        let p = place_of_make(e);
        if PO_RAW || PO_INDEX {
            return -1;
        }
        p
    }
}

pub fn pattern_binds_owned(p: i64) -> bool {
    unsafe {
        if p == 0 {
            return false;
        }
        let k = NODES[p].kind;
        if k == NodeKind::PatBind {
            return NODES[p].x >= 0 && is_moved_type(LOCALS[NODES[p].x].ty);
        }
        if k == NodeKind::PatTuple || k == NodeKind::PatVariant || k == NodeKind::PatOr {
            for i in 0..NODES[p].count {
                if pattern_binds_owned(child(p, i)) {
                    return true;
                }
            }
        }
        false
    }
}

fn eval_match(n: i64, ctx: i64, dst: i64) {
    unsafe {
        var moves = false;
        for i in 0..NODES[n].count {
            if pattern_binds_owned(NODES[child(n, i)].a) {
                moves = true;
            }
        }
        let v = new_ov();
        BORROW_OK = NODES[n].a;
        // (0.25: a local's place matched by value moves only the parts its
        // arms bind: the rest stays, dropped where the local is)
        let parts = moves && part_scrutinee(NODES[n].a);
        let sty = if NODES[n].a != 0 { NODES[NODES[n].a].ty } else { 0 };
        if moves && has_drop_impl(sty)
            && (NODES[NODES[n].a].p & crate::front::own::drops::MATCH_BYREF) == 0 {
            for i in 0..NODES[n].count {
                let p = NODES[child(n, i)].a;
                if NODES[p].kind != NodeKind::PatBind && pattern_binds_owned(p) {
                    moves::partial_pattern(p, sty);
                }
            }
        }
        eval(NODES[n].a, if moves && !parts { CX_MOVE } else { CX_READ }, v);
        let pp = if parts { part_place(NODES[n].a) } else { -1 };
        if parts && pp < 0 {
            // (no place for it: moved whole, as before)
            eval(NODES[n].a, CX_MOVE, -1);
        }
        let entry = new_state();
        copy_state(entry, CUR);
        let acc = new_state();
        for i in 0..NODES[n].count {
            let arm = child(n, i);
            copy_state(CUR, entry);
            let mark = BOUND.count;
            if parts && pp >= 0 {
                // (the arm's mark, drops::ARM_MARK: an expression evaluated
                // when the arm is taken, where its moves clear drop flags)
                let mk = crate::front::own::drops::ARM_MARK.get(arm + 1) - 1;
                moves::MOVE_AT = if mk > 0 { mk } else { NODES[arm].c };
                bind_parts(NODES[arm].a, v, pp);
                moves::MOVE_AT = 0;
            } else {
                // (a view bound out of the scrutinee reborrows what it
                // comes from: `if let Some(a) = m.get_mut(k)`, views::on_bind)
                views::BIND_FROM = NODES[n].a;
                BIND_BORROWED = crate::front::own::drops::borrowed_call(NODES[n].a);
                bind_at(NODES[arm].a, v, ref_bind_place(NODES[n].a, NODES[arm].a));
                BIND_BORROWED = false;
                views::BIND_FROM = 0;
            }
            eval(NODES[arm].b, CX_READ, -1);
            eval(NODES[arm].c, ctx, dst);
            ev_scope(mark, -1, 0);
            join_state(acc, CUR);
        }
        copy_state(CUR, acc);
        POOL_TOP = v;
    }
}

// (0.25, conventions.md "Partial moves") Whether match or `let` scrutinee
// e, matched by value with owned bindings, moves part by part: a path of
// a local's fields (`e`, `s.f`, `t.0`, no index, no `*`, no static), owned,
// not matched through a reference (MATCH_BYREF), with no Drop impl on the
// way (its drop needs all of it).
fn part_scrutinee(e: i64) -> bool {
    unsafe {
        if e == 0 || (NODES[e].p & crate::front::own::drops::MATCH_BYREF) != 0
            || !is_owned_type(NODES[e].ty) {
            return false;
        }
        var x = e;
        loop {
            if has_drop_impl(NODES[x].ty) || (NODES[x].p & NODE_RAW) != 0 {
                return false;
            }
            let k = NODES[x].kind;
            if k == NodeKind::Ident {
                return NODES[x].res == Res::Local && NODES[x].y >= 0
                    && crate::front::own::drops::BYREF.get(NODES[x].y + 1) == 0;
            }
            if k == NodeKind::FieldAccess && NODES[x].y != 1 || k == NodeKind::TupleField {
                x = NODES[x].a;
            } else {
                return false;
            }
        }
        false
    }
}

// The place of part_scrutinee e (evaluated already), or -1.
fn part_place(e: i64) -> i64 {
    unsafe {
        let p = place_of_make(e);
        if p < 0 || PO_RAW || PO_INDEX || PO_DEREF || PL_RKIND[root_of(p)] == RK_STATIC {
            return -1;
        }
        p
    }
}

// Pattern pat of a match (or `let`) by value on the value at place `place`
// (part_place; -1: none) binds: an owned binding moves its part only
// (moves::MOVE_AT, the arm's body, clears its drop flag), so the parts it
// leaves (`_`, `..`, other variants) stay in the place, and drop with it.
// A part without a place moves its parent whole.
fn bind_parts(pat: i64, v: i64, place: i64) {
    unsafe {
        if pat == 0 {
            return;
        }
        let k = NODES[pat].kind;
        if k == NodeKind::PatBind {
            let l = NODES[pat].x;
            if l < 0 {
                return;
            }
            if place >= 0 && is_owned_type(LOCALS[l].ty) {
                ev_move(place, pat, MO_PLACE);
            } else if place >= 0 {
                ev_read(place, pat);
            }
            slot_for(l, is_view_type(LOCALS[l].ty));
            ev_bind(l, pat, v);
            return;
        }
        if k == NodeKind::PatTuple || k == NodeKind::PatVariant || k == NodeKind::PatOr {
            for i in 0..NODES[pat].count {
                let c = child(pat, i);
                var sub = place;
                if place >= 0 && k == NodeKind::PatTuple {
                    sub = child_place(place, TUPLE_FIELD + i);
                } else if place >= 0 && k == NodeKind::PatVariant {
                    sub = child_place(place, variant_field_key(NODES[pat].x, i));
                }
                if place >= 0 && pattern_binds_owned(c)
                    && (sub < 0 || has_drop_impl(NODES[c].ty) && NODES[c].kind != NodeKind::PatBind) {
                    // (no place for the part, or a Drop impl's value taken
                    // apart, own.partial: the part moves whole)
                    if sub >= 0 {
                        moves::partial_pattern(c, NODES[c].ty);
                    }
                    ev_move(if sub >= 0 { sub } else { place }, pat, MO_PLACE);
                    sub = -1;
                }
                bind_parts(c, v, sub);
            }
        }
    }
}

fn find_frame(lp: i64) -> i64 {
    unsafe {
        var f = LOOPF.count - 4;
        while f >= 0 {
            if LOOPF.data[f] == lp {
                return f;
            }
            f -= 4;
        }
        -1
    }
}

// The rounds a loop is walked at most before its head is taken as stable.
const MAX_ROUNDS: i64 = 6;

fn eval_loop(n: i64) {
    unsafe {
        let k = NODES[n].kind;
        let mark = BOUND.count;
        if k == NodeKind::For {
            eval(NODES[n].c, CX_READ, -1);
            bind(NODES[n].b, -1);
        }
        let brk = new_state();
        let cont = new_state();
        let head = new_state();
        let exit = new_state();
        LOOPF.push(n);
        LOOPF.push(brk);
        LOOPF.push(cont);
        LOOPF.push(DEFS.count);
        var round = 0;
        while round < MAX_ROUNDS {
            copy_state(head, CUR);
            set_unreachable(brk);
            set_unreachable(cont);
            if k == NodeKind::While {
                eval(NODES[n].b, CX_READ, -1);
                copy_state(exit, CUR);
                eval(NODES[n].c, CX_READ, -1);
            } else if k == NodeKind::Loop {
                set_unreachable(exit);
                eval(NODES[n].b, CX_READ, -1);
            } else {
                copy_state(exit, CUR);
                eval(NODES[n].d, CX_READ, -1);
            }
            LOOP_ROUNDS += 1;
            join_state(CUR, cont);
            join_state(CUR, head);
            if same_state(CUR, head) {
                break;
            }
            round += 1;
        }
        join_state(exit, brk);
        copy_state(CUR, exit);
        LOOPF.count -= 4;
        BOUND.count = mark;
        POOL_TOP = brk;
    }
}

// The defers (and drops) registered since DEFS[mark], last first.
fn run_defers(mark: i64) {
    unsafe {
        if !reachable(CUR) {
            return;
        }
        var i = DEFS.count - 1;
        IN_DEFER += 1;
        while i >= mark {
            let d = DEFS.data[i];
            if (NODES[d].p & DEFER_IMPLICIT) != 0 {
                let b = NODES[d].b;
                ev_drop(if b != 0 { NODES[b].x } else { -1 }, d);
            } else {
                eval(NODES[d].a, CX_READ, -1);
            }
            i -= 1;
        }
        IN_DEFER -= 1;
    }
}

// `let __for_seq = v;` of a `for` over an owned place v: __for_seq is v
// (the loop borrows it), not a move.
fn for_alias(s: i64) -> bool {
    unsafe {
        let pat = NODES[s].a;
        let init = NODES[s].c;
        if pat == 0 || init == 0 || NODES[pat].kind != NodeKind::PatBind
            || NODES[pat].a != SYM_FOR_SEQ || NODES[pat].x < 0 {
            return false;
        }
        let t = NODES[init].ty;
        if !is_owned_type(t) || !is_place_expr(init) {
            return false;
        }
        let p = place_of(init);
        if p < 0 {
            return false;
        }
        ev_read(p, init);
        alias_local(NODES[pat].x, p);
        views::on_for_alias(NODES[pat].x, p, init);
        true
    }
}

fn eval_block(n: i64, ctx: i64, dst: i64) {
    unsafe {
        let mark = BOUND.count;
        let dmark = DEFS.count;
        // (0.18: a requires check's block whose call may be a borrowed copy)
        let tail_ok = BORROW_OK == n && crate::front::contracts::expand::requires_tail(n) > 0;
        // (0.25) a `let`'s temporaries, and the tail's, live to the block's
        // end (the `let` may keep a view of them); a statement's, to its own
        let bmark = TEMPS.count;
        for i in 0..NODES[n].count {
            if !reachable(CUR) {
                break;
            }
            let s = child(n, i);
            let k = NODES[s].kind;
            let tmark = TEMPS.count;
            if k == NodeKind::Let && for_alias(s) {
                // (`for x in v`: the loop borrows v)
            } else if k == NodeKind::Let {
                eval_let(s);
            } else if k == NodeKind::Defer {
                DEFS.push(s);
            } else if k == NodeKind::ExprStmt {
                eval(NODES[s].a, CX_READ, -1);
            } else {
                eval(s, CX_READ, -1);
            }
            if k != NodeKind::Let {
                views::kill_temps(tmark);
            }
        }
        let tail = NODES[n].a;
        if tail != 0 && reachable(CUR) {
            if tail_ok {
                BORROW_OK = tail;
            }
            eval(tail, ctx, dst);
        }
        run_defers(dmark);
        DEFS.count = dmark;
        views::kill_temps(bmark);
        if (NODES[n].p & crate::front::check::temps::NODE_TEMP) != 0 {
            // (0.25: a statement temporary's block, own/drops temp_make:
            // its __own_tv lives as long as the statement, the scope its
            // drop is in)
            return;
        }
        ev_scope(mark, dst, tail);
    }
}

// `let p = e;`. The checker's own lets read rather than move: structural
// equality's `let ==l = a;`, a `for` loop's element `let x =
// __for_seq[i];`. A tuple pattern over a tuple expression binds element by
// element.
fn eval_let(s: i64) {
    unsafe {
        let pat = NODES[s].a;
        let init = NODES[s].c;
        var ctx = CX_MOVE;
        if pat != 0 && NODES[pat].kind == NodeKind::PatBind {
            let name = NODES[pat].a;
            let text = SYMS[name].text;
            // (`=+l`: an arithmetic operator's operand, which moves)
            if text.len > 0 && text[0] == '=' && !(text.len > 1 && text[1] == '+') {
                ctx = CX_READ;
            }
        }
        // (a `for` loop's element, `__for_seq[i]`: not any index proved in
        // bounds, which the effects pass marks when it runs, at -O1 and
        // up: what is checked must not depend on the level)
        if init != 0 && NODES[init].kind == NodeKind::Index
            && (NODES[init].p & NODE_IN_BOUNDS) != 0 && for_seq_index(init) {
            ctx = CX_READ;
        }
        if pat != 0 && init != 0 && NODES[pat].kind == NodeKind::PatTuple
            && NODES[init].kind == NodeKind::Tuple && NODES[pat].count == NODES[init].count {
            for i in 0..NODES[init].count {
                let v = new_ov();
                eval(child(init, i), CX_MOVE, v);
                bind(child(pat, i), v);
                POOL_TOP = v;
            }
            return;
        }
        let v = new_ov();
        // (not the assignment desugaring's `let __own_new = rhs;`: what it
        // binds is stored)
        if !(pat != 0 && NODES[pat].kind == NodeKind::PatBind
            && SYMS[NODES[pat].a].text == "__own_new") {
            BORROW_OK = init;
        }
        if ctx == CX_MOVE && pat != 0 && init != 0
            && (NODES[pat].kind == NodeKind::PatTuple || NODES[pat].kind == NodeKind::PatVariant)
            && pattern_binds_owned(pat) && part_scrutinee(init) {
            // (0.25: `let (a, _) = t;` moves t.0 only, as a match does)
            eval(init, CX_READ, v);
            let pp = part_place(init);
            if pp >= 0 {
                moves::MOVE_AT = init;
                bind_parts(pat, v, pp);
                moves::MOVE_AT = 0;
                POOL_TOP = v;
                return;
            }
            eval(init, CX_MOVE, -1);
        } else {
            eval(init, ctx, v);
        }
        BIND_BORROWED = init != 0 && crate::front::own::drops::borrowed_call(init);
        bind_at(pat, v, ref_bind_place(init, pat));
        BIND_BORROWED = false;
        POOL_TOP = v;
        if pat != 0 && init != 0 && NODES[pat].kind == NodeKind::PatBind && NODES[pat].x >= 0 {
            views::on_let(NODES[pat].x, init);
        }
    }
}

// Whether index node n reads a `for` loop's sequence, `__for_seq[i]`
// (check/iterate.vl).
fn for_seq_index(n: i64) -> bool {
    unsafe {
        let base = NODES[n].a;
        base != 0 && NODES[base].kind == NodeKind::Ident && SYMS[NODES[base].a].text == "__for_seq"
    }
}

// ---------------------------------------------------------------------------
// Calls

// The mode of argument i of a call of f (-1: through a fn value: by the
// argument's type, a pointer taken as the legacy rule takes one).
fn arg_mode(f: i64, i: i64, arg: i64) -> i64 {
    unsafe {
        if f >= 0 {
            return param_mode(f, i);
        }
        let t = NODES[arg].ty;
        if t <= 0 {
            return P_VALUE;
        }
        if TYPES[t].kind == TyKind::Slice {
            return if TYPES[t].b == REF_MUT { P_MUT_VIEW } else { P_VIEW };
        }
        if TYPES[t].kind == TyKind::Ptr {
            return if TYPES[t].b == REF_SHARED { P_SHARED } else { P_MUT };
        }
        P_VALUE
    }
}

// Call n: its arguments left to right as pending entries, then ev_call.
// An argument `&place` (or a reference passed on) is a loan of the
// parameter's kind: `&x` and `&mut x` to a `&mut T` or a legacy `*T`
// parameter are exclusive (§2.3), a `&mut self` receiver is two-phase
// (PK_RESERVE).
fn eval_call(n: i64, dst: i64) {
    unsafe {
        let f = NODES[n].x - 1;
        if f < 0 {
            eval(NODES[n].a, CX_READ, -1);
        }
        let base = PEND.count;
        let mark = POOL_TOP;
        let c_callee = f >= 0 && FNS[f].is_extern;
        for i in 0..NODES[n].count {
            let arg = child(n, i);
            let at_ty = NODES[arg].ty;
            let mode = arg_mode(f, i, arg);
            if f >= 0 && mode == P_VALUE && at_ty > 0 && is_owned_type(at_ty) {
                // (0.20: for own.moved to name the parameter)
                crate::front::own::moves::note_move_arg(arg, n, i);
            }
            let o = new_ov();
            var pl = -1;
            var receiver = false;
            var raw = false;
            // (whether walk::PO_* describe pl: `&place`, not a reference
            // passed on)
            var made = false;
            let k = NODES[arg].kind;
            if k == NodeKind::Unary && NODES[arg].op == Tok::Amp && is_place_expr(NODES[arg].b) {
                let operand = NODES[arg].b;
                receiver = i == 0 && NODES[arg].start == NODES[operand].start;
                pl = place_of_make(operand);
                raw = PO_RAW;
                made = true;
            } else if k == NodeKind::Ident && is_reference(arg) && at_ty > 0
                && TYPES[at_ty].kind == TyKind::Ptr {
                // (a reference passed on: a reborrow)
                pl = local_place(NODES[arg].y);
                receiver = i == 0;
            }
            if pl >= 0 && !raw {
                var kind = PK_SHARED;
                if mode == P_MUT {
                    kind = if receiver { PK_RESERVE } else { PK_MUT };
                } else if mode == P_RAW || c_callee {
                    kind = PK_RAW;
                }
                if i == 0 && crate::front::closures::closure_of_type(NODES[NODES[arg].b].ty) > 0
                    && kind == PK_RAW {
                    // (0.25) a closure called or lent, `&g`: an access of its
                    // captures for the call (o holds them at level 2),
                    // inout where it changes one
                    kind = if views::holds_mut(NODES[NODES[arg].b].ty, 0) { PK_MUT_VIEW }
                        else { PK_VIEW };
                }
                if made && mode == P_MUT && f >= 0 && i < FNS[f].param_count {
                    // (a `&mut` parameter, not a legacy `*T` one: through a
                    // `&T` or a `[T]` it is own.readonly, as a write is)
                    let pt = crate::front::types::fn_param(f, i);
                    if pt > 0 && TYPES[pt].b == REF_MUT {
                        views::on_mut_loan(pl, arg);
                    }
                }
                ev_read(pl, arg);
                views::on_borrow(pl, arg, if kind == PK_SHARED { REF_SHARED } else { REF_MUT },
                    false, o);
                pend_push(kind, pl, o, arg, mode);
            } else if pl >= 0 {
                ev_read(pl, arg);
                pend_push(PK_RAW, -1, o, arg, mode);
            } else {
                // (a borrowed copy, `v.get(i)`, moves only into a raw or
                // C parameter, or as the receiver of `unwrap` and the like:
                // `out.push(v.get(i))` is own.move_out, eval)
                // (0.18: a requires check's companion reads the call's
                // arguments in place: contracts::expand::is_pre_fn)
                let pre = crate::front::contracts::expand::is_pre_fn(f);
                if mode != P_VALUE || c_callee || pre
                    || i == 0 && crate::front::own::drops::borrowed_call(n) {
                    BORROW_OK = arg;
                }
                // (std's iterators hand a closure the elements they read,
                // `g(acc, s[k])` in fold: borrowed copies, as a `for` loop's
                // element; a closure's by-value parameters drop nothing
                // in 0.17.0. Only an element read out of a slice: a value
                // std owns, `f(e)` in map_err, moves)
                let actx = if within_std(FNS[CUR_F].module) && NODES[arg].kind == NodeKind::Index
                    && (f < 0 || FNS[f].node > 0 && (NODES[FNS[f].node].p & FN_CLOSURE) != 0)
                    || pre
                    { CX_READ }
                    else { CX_MOVE };
                eval(arg, actx, o);
                var kind = PK_NONE;
                if c_callee || mode == P_RAW {
                    kind = PK_RAW;
                } else if mode == P_MUT_VIEW {
                    kind = PK_MUT_VIEW;
                } else if made && mode == P_MUT && !raw
                    || mode == P_MUT && k == NodeKind::Unary && NODES[arg].op == Tok::Amp
                    && through_exclusive_view(NODES[arg].b) {
                    // (0.25) `&mut v[i]` of a Vec, `v[i].push(w)`: a place
                    // inside what a view value points to, written by the
                    // call: its origin (the loans it holds) is written;
                    // `&v[i]` of a Vec, a Buf, a String: a loan of an
                    // element through the view `v.as_mut_slice()` makes (o
                    // holds it), exclusive as `&a[i]` of an array is
                    kind = PK_MUT;
                } else if is_view_type(at_ty) {
                    // (0.25) one holding an inout access (a closure that
                    // writes a capture, a struct with an inout field) may
                    // change what it views during the call
                    // (a closure lent to a let parameter, `&|| ..`, too: the
                    // callee calls it)
                    let inner = if TYPES[at_ty].kind == TyKind::Ptr { TYPES[at_ty].a } else { 0 };
                    // (a temporary lent, `&v.iter()`, writes itself: only a
                    // value that holds an inout access writes through it)
                    let held = if inner > 0 { views::holds_mut(inner, 0) }
                        else { views::holds_mut(at_ty, 0) };
                    kind = if held
                        || inner > 0 && crate::front::closures::closure_holds_inout(inner) {
                        PK_MUT_VIEW
                    } else {
                        PK_VIEW
                    };
                } else if at_ty > 0 && TYPES[at_ty].kind == TyKind::Ptr {
                    kind = PK_RAW;
                } else if crate::front::own::glue::has_glue(at_ty)
                    && (!is_empty(l1(o)) || !is_empty(l2(o))) {
                    // (0.25) a value of no view type that views something:
                    // a borrowed copy of an element (`m.get(k).unwrap()`)
                    kind = PK_VIEW;
                }
                pend_push(kind, -1, o, arg, mode);
            }
        }
        if f >= 0 && within_std(FNS[f].module) && !within_std(FNS[CUR_F].module) {
            // (0.24: a borrowing iterator's copied items kept: own.move_out)
            crate::front::own::moves::iter_item_copy(n, f);
        }
        if f >= 0 && within_std(FNS[f].module) && NODES[n].count == 2
            && !within_std(FNS[CUR_F].module) {
            // (std's bitwise extend_from_slice on owned elements)
            let s = child(n, 1);
            let st = NODES[s].ty;
            if st > 0 && TYPES[st].kind == TyKind::Slice
                && crate::front::own::glue::has_glue(TYPES[st].a)
                && crate::front::own::drops::method_word(SYMS[FNS[f].display].text)
                == "extend_from_slice" {
                crate::front::own::moves::bitwise_extend(s);
            }
        }
        if reachable(CUR) {
            ev_call(n, f, base, dst);
        }
        PEND.count = base;
        POOL_TOP = mark;
    }
}

// (0.25) Whether place e (`v.as_mut_slice()[i].x`) is reached through an
// exclusive view a call makes (an `inout [T]` or `inout T` result): a loan of
// it writes what that view points into. A temporary itself (`&v.iter()`)
// is not: its change is its own.
fn through_exclusive_view(e: i64) -> bool {
    unsafe {
        var p = e;
        var depth = 0;
        while depth < 64 {
            let k = NODES[p].kind;
            if k == NodeKind::Index || k == NodeKind::FieldAccess || k == NodeKind::TupleField {
                p = NODES[p].a;
            } else if k == NodeKind::Call || k == NodeKind::MethodCall {
                if depth == 0 {
                    return false;
                }
                // (a part of what a call returns a view of: `v[0]` as a
                // receiver is `v.as_slice()[0]`; a written element)
                let t = NODES[p].ty;
                return t > 0 && (TYPES[t].kind == TyKind::Slice || TYPES[t].kind == TyKind::Ptr);
            } else {
                return false;
            }
            depth += 1;
        }
        false
    }
}

// ---------------------------------------------------------------------------
// A function

fn walk_once(f: i64) {
    unsafe {
        CUR_F = f;
        WALKED += 1;
        PARAM_LOCALS.count = 0;
        POOL_TOP = 0;
        PEND.count = 0;
        LOOPF.count = 0;
        DEFS.count = 0;
        BOUND.count = 0;
        NO_MOVE = 0;
        IN_DEFER = 0;
        PL_OVERFLOW = false;
        SLOT_OVERFLOW = false;
        CUR = new_state();
        POOL[CUR] = 1;
        let item = FNS[f].node;
        for i in 0..NODES[item].count {
            let l = NODES[child(item, i)].x;
            PARAM_LOCALS.push(l);
            if l >= 0 {
                slot_for(l, is_view_type(LOCALS[l].ty));
            }
        }
        views::on_enter(f);
        let body = NODES[item].c;
        let v = new_ov();
        eval(body, CX_MOVE, v);
        if reachable(CUR) {
            let tail = NODES[body].a;
            ev_result(if tail != 0 { tail } else { body }, if tail != 0 { v } else { -1 });
        }
    }
}

// Walks function f (round: which round of its SCC's fixed point, T3) and
// returns the summary its body makes. A function with more places than
// one bitset word, or more slots than a state has room for, is walked
// again, wider; its findings are those of the last walk (diag.vl,
// own_discard and own_flush, are the driver's).
pub fn walk_fn(f: i64, round: i64) -> ViewSummary {
    unsafe {
        if SYM_FOR_SEQ == 0 {
            SYM_FOR_SEQ = intern_c(c"__for_seq");
        }
        if !fast::FORCE_WALK && !fast::needs_walk(f) {
            // (nothing to track: views() by type, no findings)
            fast::SKIPPED += 1;
            collect_begin(f, round);
            return collect_end(f);
        }
        set_words(1);
        SLOT_CAP = 8;
        var tries = 0;
        loop {
            collect_begin(f, round);
            moves::on_fn(f);
            walk_once(f);
            let wide = PL_OVERFLOW && NW == 1;
            let more = SLOT_OVERFLOW && SLOT_CAP < 1024;
            reset_places();
            if !(wide || more) || tries > 4 {
                break;
            }
            crate::front::own::diag::own_discard();
            if wide {
                set_words(MAXNW);
            }
            if more {
                SLOT_CAP = SLOT_CAP * 4;
            }
            tries += 1;
        }
        collect_end(f)
    }
}
