// Moves and drops: the walk's move events (0.17, docs/design/
// value-semantics.md §2.2, §4 steps 0 and 5). T1 owns this file, drops.vl
// and glue.vl.
//
// The state's moved bits (state.vl: moved_bits, dmoved_bits) hold, per
// place, whether it may have moved and whether it has moved on every path;
// PL_MOVED_BY the node that moved it. A use of a place that overlaps a
// moved one is own.moved; a move out of an index, through a reference
// (`*r`, `r.f`), out of a static, or out of a binding that borrows (a
// `for` loop's element, a match through a reference) is own.move_out
// (reads through a raw pointer move nothing: unsafe code's business); a
// move out of a field of a type with a Drop impl is own.partial. Every
// exit of an implicit defer records the state of its local
// (drops.vl: drop_state).

use crate::base::{
    FILES, FILE_COUNT, SRC, SYMS, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
};
use crate::base::diag::buf_tool_command;
use crate::front::ast::{FN_CLOSURE, NODES, NODE_CAPTURE, NodeKind, child};
use crate::front::check::LOCALS;
use crate::front::closures::{CLOSURES, CLOSURE_COUNT};
use crate::front::lexer::Tok;
use crate::front::modules::within_std;
use crate::front::own::diag::{
    OWN_MOVED, OWN_MOVE_OUT, OWN_PARTIAL, OWN_READONLY, own_begin, own_bytes, own_end, own_help,
    own_str, own_sym, own_try, own_type,
};
use crate::front::own::drops::{
    ASSIGN_OLD, BYREF, MATCH_BYREF, assign_read, drop_state, note_move, walk_begin,
};
use crate::front::own::kinds::{has_drop_impl, is_owned_type, owned_base_type};
use crate::front::own::state::{
    DEREF_FIELD, NW, PL_COUNT, PL_FIELD, PL_MASK, PL_MOVED_BY, PL_PARENT, PL_RID, PL_RKIND,
    RK_LOCAL, RK_STATIC, TUPLE_FIELD, any_and, dmoved_bits, field_number, get_bit, is_below,
    moved_bits, root_of, set_bit,
};
use crate::front::own::walk::{CUR_F, MO_DEREF, MO_INDEX, MO_STATIC, PO_DEREF, PO_INDEX, PO_RAW};
use crate::front::types::{FNS, STRUCTS, TLISTS, TYPES, TyKind};
use crate::middle::lower::ssa::HMap;

// The locals (+ 1) whose use after a move is reported already in this
// walk: one error per place.
static var REPORTED: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static var REPORTED_KEYS: crate::base::IntVec = crate::base::IntVec {
    data: 0 as *i64, count: 0, cap: 0
};

// The walk starts function f.
pub fn on_fn(f: i64) {
    unsafe {
        for i in 0..REPORTED_KEYS.count {
            REPORTED.put(REPORTED_KEYS.data[i], 0);
        }
        REPORTED_KEYS.count = 0;
        walk_begin(f);
    }
}

// Place p is read, or borrowed, at node n: a use of a moved value is
// own.moved.
pub fn on_read(p: i64, n: i64) {
    unsafe {
        if (NODES[n].p & ASSIGN_OLD) != 0 {
            // (the old value of an owned assignment: its drop's state)
            assign_read(p, n, PO_DEREF || PO_INDEX || PO_RAW);
            return;
        }
        check_moved(p, n);
    }
}

// Owned place p is moved at node n; how (walk::MO_*) says how it left its
// place: out of an index, a pointer or reference, or a static is
// own.move_out.
pub fn on_move(p: i64, n: i64, how: i64) {
    unsafe {
        if (NODES[n].p & MATCH_BYREF) != 0 {
            // (a match through a reference: its bindings borrow)
            check_moved(p, n);
            return;
        }
        let cap = captured_use(n);
        if cap > 0 {
            // (0.20: a closure's capture, reached through its env. A sink
            // closure's own one moves out under its flag; any other is
            // still its owner's, or the closure may run again)
            if cap != n || !sink_capture_move(n) {
                move_out(p, n, MO_CAPTURED);
            }
            return;
        }
        if how == crate::front::own::walk::MO_DEREF && !PO_RAW && let_param_view(n) {
            // (0.25) a move-only view a let parameter lends (a closure that
            // changes a capture: `var g = f;` to call it): the callee takes
            // it over for the rest of the call, the caller's waits; the
            // parameter is moved from here
            check_moved(p, n);
            set_bit(moved_bits(), p);
            PL_MOVED_BY[p] = n;
            note_move(p, n);
            return;
        }
        if how != 0 {
            if PO_RAW {
                return;
            }
            move_out(p, n, how);
            return;
        }
        let root = root_of(p);
        if PL_RKIND[root] == RK_LOCAL && BYREF.get(PL_RID[root] + 1) != 0 {
            move_out(p, n, -1);
            return;
        }
        partial(n);
        check_moved(p, n);
        set_bit(moved_bits(), p);
        set_bit(dmoved_bits(), p);
        PL_MOVED_BY[p] = n;
        note_move(p, n);
    }
}

// (0.25) Whether node n reads a let parameter whose value is a move-only
// view that owns nothing (kinds::holds_inout, not owned): a closure that
// changes a capture, a struct with an inout field.
fn let_param_view(n: i64) -> bool {
    unsafe {
        var e = n;
        if NODES[e].kind == NodeKind::Unary && NODES[e].op == crate::front::lexer::Tok::Star {
            e = NODES[e].b;
        }
        if NODES[e].kind != NodeKind::Ident || NODES[e].res != crate::front::check::Res::Local
            || NODES[e].y < 0 {
            return false;
        }
        let l = NODES[e].y;
        let t = NODES[n].ty;
        LOCALS[l].is_param && !LOCALS[l].is_sink && t > 0
            && !crate::front::own::kinds::is_owned_type(t)
            && crate::front::own::kinds::is_moved_type(t)
    }
}

// (0.20) How move_out says a capture was moved inside its closure.
const MO_CAPTURED: i64 = -2;

// The capture of a closure that place expression n reaches through the
// closure's env (closures::rewrite_use: NODE_CAPTURE), or 0.
fn captured_use(n: i64) -> i64 {
    unsafe {
        var e = n;
        while e > 0 {
            if (NODES[e].p & NODE_CAPTURE) != 0 {
                return e;
            }
            let k = NODES[e].kind;
            if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
                e = NODES[e].a;
            } else if k == NodeKind::Unary && NODES[e].op == Tok::Star {
                e = NODES[e].b;
            } else {
                return 0;
            }
        }
        0
    }
}

// Capture use n (`(*env).x`) moved in the body of the closure walked: when
// it is a sink closure's own capture with a flag (closures::finish_closure),
// the move is kept (drops::capture_move) and allowed.
fn sink_capture_move(n: i64) -> bool {
    unsafe {
        if NODES[n].kind != NodeKind::FieldAccess {
            return false;
        }
        var id = -1;
        for i in 0..CLOSURE_COUNT {
            if CLOSURES[i].f == CUR_F {
                id = i;
            }
        }
        if id < 0 || (NODES[CLOSURES[id].node].c & crate::front::ast::CLOSURE_MOVE) == 0 {
            return false;
        }
        let s = CLOSURES[id].env_struct;
        let flag = crate::front::own::glue::flag_field(s, NODES[n].b);
        if flag == 0 {
            return false;
        }
        crate::front::own::drops::capture_move(n, flag, s);
        true
    }
}

// Place p is (re)initialized: it and its parts are no longer moved.
pub fn on_init(p: i64) {
    unsafe {
        let moved = moved_bits();
        let dmoved = dmoved_bits();
        for q in p..PL_COUNT {
            if q == p || is_below(q, p) {
                let w = q >> 6;
                let bit = 1 << (q & 63);
                moved[w] = moved[w] & ~bit;
                dmoved[w] = dmoved[w] & ~bit;
            }
        }
    }
}

// The drop of local l (its place p) runs at an exit of implicit defer d:
// the state at each exit decides the drop (empty, flagged, or kept).
pub fn on_drop(p: i64, l: i64, d: i64) {
    drop_state(p, l, d);
}

// ---------------------------------------------------------------------------
// The findings

// A use of place p at node n: own.moved when a place overlapping it has
// moved (once per local).
fn check_moved(p: i64, n: i64) {
    unsafe {
        let moved = moved_bits();
        if !any_and(moved, &PL_MASK[p * NW]) {
            return;
        }
        let root = root_of(p);
        let key = PL_RID[root] * 4 + PL_RKIND[root] + 1;
        if REPORTED.get(key) != 0 {
            return;
        }
        REPORTED.put(key, 1);
        REPORTED_KEYS.push(key);
        // (the moved place: the last one found that overlaps p)
        var q = -1;
        for i in 0..PL_COUNT {
            if get_bit(moved, i) && get_bit(&PL_MASK[p * NW], i) {
                q = i;
            }
        }
        let definite = any_and(dmoved_bits(), &PL_MASK[p * NW]);
        let by = if q >= 0 { PL_MOVED_BY[q] } else { 0 };
        own_begin(n, OWN_MOVED);
        place_name(p);
        if q >= 0 && q != p {
            own_str(c" is used here after ");
            place_name(q);
            own_str(if definite { c" moved" } else { c" may have moved" });
        } else {
            own_str(if definite { c" is used here after it moved" }
                else { c" is used here after it may have moved" });
        }
        if by > 0 {
            moved_into(by);
            own_str(c" at ");
            line_col(NODES[by].start);
        }
        if !definite {
            own_str(c" (on some paths)");
        }
        own_help(if !crate::front::conv::strict_at(NODES[n].start) {
            c"use it before the move, pass a copy where it moves ('.clone()'), or take it by reference ('&')"
        } else {
            c"use it before the move, pass a copy where it moves ('.clone()'), or let the callee borrow it: a let parameter ('x: T'), not 'sink'"
        });
        if by > 0 {
            try_wrap(by, c"", c".clone()");
        }
        own_end();
    }
}

// (0.20) The calls owned arguments move into: argument node + 1 -> call
// node * 256 + the parameter's index (walk.vl: eval_call), so that
// own.moved names the parameter that took the value.
pub static var MOVE_CALL: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

pub fn note_move_arg(arg: i64, call: i64, i: i64) {
    unsafe {
        if i < 256 {
            MOVE_CALL.put(arg + 1, call * 256 + i);
        }
    }
}

// ` into 'f(sink x)'` (or `'f(x)'` for a by-value parameter in 0.19's
// spelling) for the move at node by, when it is an argument.
fn moved_into(by: i64) {
    unsafe {
        let v = MOVE_CALL.get(by + 1);
        if v <= 0 {
            return;
        }
        let call = v / 256;
        let i = v % 256;
        let f = NODES[call].x - 1;
        if f < 0 {
            return;
        }
        let p = crate::front::conv::param_node(f, i);
        // (a parameter written `sink`: one in 0.19's spelling keeps the
        // message it had)
        if p <= 0 || crate::front::conv::param_conv(p) != crate::front::conv::CONV_SINK_K {
            return;
        }
        let name = SYMS[FNS[if FNS[f].tmpl > 0 { FNS[f].tmpl - 1 } else { f }].display].text;
        var cut = 0;
        while cut < name.len && name[cut] != '<' {
            cut += 1;
        }
        own_str(c" into '");
        own_bytes(name[0..cut]);
        own_str(c"(");
        own_str(c"sink ");
        own_bytes(SYMS[NODES[p].a].text);
        own_str(c")'");
    }
}

// own.move_out: place p moved at node n out of an index, a reference, a
// static (how: MO_*), or a binding that borrows (-1).
fn move_out(p: i64, n: i64, how: i64) {
    unsafe {
        if within_std(FNS[CUR_F].module) {
            // (std's bodies copy elements as unsafe code does, for the
            // callers that borrow them (drops::borrowed_call); a copy that
            // would be owned twice is reported at the call:
            // bitwise_extend)
            return;
        }
        own_begin(n, OWN_MOVE_OUT);
        own_str(c"cannot move ");
        src_quoted(n);
        own_str(c" (");
        own_type(NODES[n].ty);
        own_str(c") ");
        if how == MO_INDEX {
            own_str(c"out of an index: the collection keeps its elements");
        } else if how == MO_STATIC {
            own_str(c"out of a static");
        } else if how == MO_DEREF {
            own_str(c"out of a reference: what it points to keeps its value");
        } else if how == MO_CAPTURED {
            own_str(c"out of the closure that captures it: the closure may be called again, and its drop, or its owner's, drops it");
        } else {
            let root = root_of(p);
            var at = BYREF.get(PL_RID[root] + 1) - 1;
            // (0.18: a requires check's block, through to its call)
            let wrapped = crate::front::contracts::expand::requires_tail(at);
            if wrapped > 0 {
                at = wrapped;
            }
            if at > 0 && NODES[at].kind == NodeKind::Index {
                own_str(c"out of ");
                own_sym(LOCALS[PL_RID[root]].name);
                own_str(c": it is a loop's element, which the loop borrows");
            } else if at > 0 && NODES[at].kind == NodeKind::Call {
                own_str(c"out of ");
                own_sym(LOCALS[PL_RID[root]].name);
                own_str(c": it is a copy of an element ");
                src_quoted(at);
                own_str(c" (");
                line_col(NODES[at].start);
                own_str(c") reads, which the collection keeps");
            } else if at > 0 && NODES[at].kind == NodeKind::Closure {
                own_str(c"out of ");
                own_sym(LOCALS[PL_RID[root]].name);
                own_str(c": the closure is given a borrowing iterator's item, a copy of an element the container keeps");
            } else if at > 0 && NODES[at].kind == NodeKind::Param {
                own_str(c"out of ");
                own_sym(LOCALS[PL_RID[root]].name);
                own_str(c": a contract's condition reads the parameters in place");
            } else if at > 0 {
                own_str(c"out of ");
                own_sym(LOCALS[PL_RID[root]].name);
                own_str(c": the match on ");
                src_quoted(at);
                own_str(c" (");
                line_col(NODES[at].start);
                own_str(c") binds it by reference");
            } else {
                own_str(c"out of a binding that borrows");
            }
        }
        if how == MO_INDEX {
            own_help(if !crate::front::conv::strict_at(NODES[n].start) {
                c"take it out with 'v.remove(i)' or 'std::take(&mut v[i])', or copy it ('.clone()')"
            } else {
                c"borrow it ('let x = v[i];' reads it in place), take it out with 'v.remove(i)' or 'std::take(&v[i])', or copy it ('.clone()')"
            });
            try_wrap(n, c"", c".clone()");
        } else if how == -1 {
            own_help(c"copy it ('.clone()'), or match (or loop over) a value the code owns");
            try_wrap(n, c"", c".clone()");
        } else if how == MO_CAPTURED {
            own_help(c"use a copy inside the closure ('.clone()'), or move the value out where the closure is made, not in its body");
            try_wrap(n, c"", c".clone()");
        } else if read_only_root(p) {
            // (0.24: through a let access, `fn add(self, ..) -> N { self }`:
            // nothing can be taken out of it)
            own_help(c"it is borrowed read-only (let): copy it ('.clone()'), or take the parameter 'sink' to own it ('sink self', 'x: sink T')");
            try_wrap(n, c"", c".clone()");
        } else {
            own_help(if !crate::front::conv::strict_at(NODES[n].start) {
                c"take it out and leave an empty value in its place ('x.take()' of a Vec, Buf or HashMap, 'std::take(&mut x)', 'std::replace(&mut x, v)'), copy it ('.clone()'), or borrow it ('&')"
            } else {
                c"take it out and leave an empty value in its place ('x.take()' of a Vec, Buf or HashMap, 'std::take(&x)', 'std::replace(&x, v)'), copy it ('.clone()'), or borrow it: pass it on let, or take the parameter 'sink' to own it"
            });
            if owned_base_type(NODES[n].ty) {
                // (a container keeps its allocator: T4's `take`)
                try_wrap(n, c"", c".take()");
            } else {
                try_wrap(n,
                    c"std::take(&", c")");
            }
            try_wrap(n, c"", c".clone()");
        }
        own_end();
    }
}

// Whether place p is reached through a let access (a let parameter or
// binding that borrows: read-only).
fn read_only_root(p: i64) -> bool {
    unsafe {
        if p < 0 {
            return false;
        }
        let root = root_of(p);
        if PL_RKIND[root] != RK_LOCAL {
            return false;
        }
        let l = PL_RID[root];
        let t = LOCALS[l].ty;
        LOCALS[l].access && t > 0 && TYPES[t].kind == TyKind::Ptr
            && TYPES[t].b == crate::front::types::REF_SHARED
    }
}

// own.move_out of value n, no place (`v[i]` of a Vec, a call's `*r`): out
// of an index or a reference (how: MO_INDEX, MO_DEREF).
pub fn move_out_value(n: i64, how: i64) {
    // (std's accessors make the copies callers borrow:
    // drops::borrowed_call)
    move_out(-1, n, how);
}

// (0.18.1) own.readonly: a `&mut` loan at node n of owned place p (of type
// t), or an assignment to one, that is part of a binding that borrows (BYREF: a match through a
// reference, a `for` loop's element, a copy `v.get(i)` reads): the binding
// is a bitwise copy, and a change to it (a push that moves the elements,
// a free) would leave the original pointing at memory that is gone.
pub fn byref_change(p: i64, n: i64, t: i64) {
    unsafe {
        if p < 0 || within_std(FNS[CUR_F].module) || PO_RAW || !is_owned_type(t) {
            return;
        }
        let root = root_of(p);
        if PL_RKIND[root] != RK_LOCAL {
            return;
        }
        let l = PL_RID[root];
        let at = BYREF.get(l + 1) - 1;
        if at <= 0 {
            return;
        }
        own_begin(n, OWN_READONLY);
        own_str(c"changes ");
        own_sym(LOCALS[l].name);
        own_str(c" (");
        own_type(LOCALS[l].ty);
        own_str(c"), ");
        let k = NODES[at].kind;
        if k == NodeKind::Index {
            own_str(c"a copy of a loop's element, which the loop borrows: ");
            own_str(c"the change would not reach the element, and could free memory it points to");
            own_help(c"loop over the indices and change the element in place ('for i in 0..v.len() { v[i]... }')");
        } else if crate::front::own::drops::borrowed_call(at) {
            own_str(c"a copy of an element ");
            src_quoted(at);
            own_str(c" reads: the change would not reach the element, and could free memory it points to");
            own_help(c"change the element in place ('v[i]...'), or work on a copy ('.clone()')");
        } else {
            own_str(c"a copy the match on ");
            src_quoted(at);
            own_str(c" (");
            line_col(NODES[at].start);
            own_str(c") binds: the change would not reach it, and could free memory it points to");
            own_help(c"match the access itself ('match e' for 'e: inout E', or 'match &x'): its bindings are inout accesses into the value");
        }
        own_end();
    }
}

// own.move_out: the value of call n, a copy of an element a collection
// keeps (drops::borrowed_call), moved at once: passed by value.
pub fn borrowed_move(n: i64) {
    unsafe {
        own_begin(n, OWN_MOVE_OUT);
        own_str(c"cannot move ");
        src_quoted(n);
        own_str(c" (");
        own_type(NODES[n].ty);
        own_str(c"): it is a copy of an element the collection keeps");
        own_help(c"copy it ('.clone()'), or pass the element by reference ('&v[i]')");
        try_wrap(n, c"", c".clone()");
        own_end();
    }
}

// own.move_out: argument n, a slice of owned elements, given to std's
// `extend_from_slice`, which copies them bit for bit (until 0.17.1 gives
// it a `T: Clone` bound): both would own them.
pub fn bitwise_extend(n: i64) {
    unsafe {
        own_begin(n, OWN_MOVE_OUT);
        own_str(c"cannot copy the elements of ");
        src_quoted(n);
        own_str(c" (");
        own_type(NODES[n].ty);
        own_str(c"): extend_from_slice copies them bit for bit, and the elements are owned");
        own_help(c"push clones: 'for x in s.iter() { v.push(x.clone()); }'");
        own_end();
    }
}

// (0.24, a stopgap until a borrowing iterator's items are views) Call n of
// std's f, in the program's code: when an argument (the receiver too) is
// an iterator that yields, by a bitwise copy, the non-copyable elements of
// a container it borrows (`w.iter()` of a Vec<Vec<i64>>, a HashMap's
// iter, keys, values; or an adapter of one), and f may keep, return or
// drop its items (collect, map, fold, for_each, next, find, extend...),
// own.move_out: they would be owned twice. Building adapters that only
// look at them (filter, take, zip...) and the counting and testing ones
// (count, any, all, position) are allowed, and so is a `for` loop (its
// items are borrowed).
pub fn iter_item_copy(n: i64, f: i64) {
    unsafe {
        let name = fn_word(SYMS[FNS[f].display].text);
        if name == "filter" || name == "skip" || name == "take" || name == "step_by"
            || name == "rev" || name == "enumerate" || name == "zip" || name == "chain"
            || name == "peekable" || name == "count" || name == "any" || name == "all"
            || name == "position" || name == "len" || name == "exact_len" || name == "is_empty"
            || name == "size_hint" || name == "as_slice" || name == "iter" || name == "iter_ref"
            // (their closures borrow the items, check::calls::synth_method)
            || (name == "map" || name == "for_each" || name == "filter_map")
            && NODES[n].count == 2 && NODES[child(n, 1)].kind == NodeKind::Closure
            || name == "fold" && NODES[n].count == 3
            && NODES[child(n, 2)].kind == NodeKind::Closure {
            return;
        }
        for i in 0..NODES[n].count {
            let arg = child(n, i);
            // (a `for` loop's own `next`: its items are borrowed)
            var r = arg;
            if NODES[r].kind == NodeKind::Unary && NODES[r].b > 0 {
                r = NODES[r].b;
            }
            if NODES[r].kind == NodeKind::Ident && SYMS[NODES[r].a].text == "__for_seq" {
                return;
            }
            var t = NODES[arg].ty;
            if t > 0 && TYPES[t].kind == TyKind::Ptr {
                t = TYPES[t].a;
            }
            if !copies_owned_items(t, 0) {
                continue;
            }
            own_begin(arg, OWN_MOVE_OUT);
            own_str(c"cannot take the items of ");
            src_quoted(arg);
            own_str(c": they are views of the elements of the container it iterates over, copied bit for bit, and '");
            own_str(SYMS[FNS[f].display].text.ptr);
            own_str(c"' may keep or drop them (each would be owned twice)");
            own_help(c"take copies, `.iter_ref().map(|x| x.clone())` (a Vec or a slice), or push clones in a loop, `for x in v.iter() { out.push(x.clone()); }`");
            own_end();
            return;
        }
    }
}

// The name of function display name d without its type arguments:
// `filter` of `SliceIter<Vec<i64>>::filter<closure(..) at f.vl:8:2>`.
fn fn_word(d: [u8]) -> [u8] {
    var depth = 0;
    var from = 0;
    var i = 0;
    while i < d.len {
        let c = d[i];
        if c == '<' || c == '(' {
            depth += 1;
        } else if c == '>' && (i == 0 || d[i - 1] != '-') || c == ')' {
            depth -= 1;
        } else if depth == 0 && c == ':' && i + 1 < d.len && d[i + 1] == ':' {
            from = i + 2;
            i += 1;
        }
        i += 1;
    }
    var to = from;
    while to < d.len && d[to] != '<' {
        to += 1;
    }
    d[from..to]
}

// Whether a value of type t is an iterator (or an adapter of one, to depth
// 4) that copies a borrowed container's non-copyable elements.
pub fn copies_owned_items(t: i64, depth: i64) -> bool {
    unsafe {
        if t <= 0 || depth > 4 || TYPES[t].kind != TyKind::Struct {
            return false;
        }
        let s = TYPES[t].a;
        if !within_std(STRUCTS[s].module) || STRUCTS[s].targ_count == 0 {
            return false;
        }
        let a0 = TLISTS.data[STRUCTS[s].targs];
        let a1 = if STRUCTS[s].targ_count > 1 { TLISTS.data[STRUCTS[s].targs + 1] } else { 0 };
        if crate::front::check::is_std_named(t, c"SliceIter")
            || crate::front::check::is_std_named(t, c"Keys") {
            return crate::front::own::glue::has_glue(a0);
        }
        if crate::front::check::is_std_named(t, c"Values") {
            return crate::front::own::glue::has_glue(a1);
        }
        if crate::front::check::is_std_named(t, c"HashMapIter") {
            return crate::front::own::glue::has_glue(a0) || crate::front::own::glue::has_glue(a1);
        }
        // (a map's items are its closure's results, made from borrowed ones)
        if crate::front::check::is_std_named(t, c"Map")
            || crate::front::check::is_std_named(t, c"FilterMap") {
            return false;
        }
        for i in 0..STRUCTS[s].targ_count {
            if copies_owned_items(TLISTS.data[STRUCTS[s].targs + i], depth + 1) {
                return true;
            }
        }
        false
    }
}

// own.partial: moving node n (a field) out of a value whose type has a
// Drop impl (its drop needs all of it).
pub fn partial(n: i64) {
    unsafe {
        var e = n;
        while NODES[e].kind == NodeKind::FieldAccess || NODES[e].kind == NodeKind::TupleField {
            if NODES[e].kind == NodeKind::FieldAccess && NODES[e].y == 1 {
                return;
            }
            let base = NODES[e].a;
            if has_drop_impl(NODES[base].ty) {
                own_begin(n, OWN_PARTIAL);
                own_str(c"cannot move ");
                src_quoted(n);
                own_str(c" out of ");
                src_quoted(base);
                own_str(c": '");
                own_type(NODES[base].ty);
                own_str(c"' implements Drop, which needs all of it");
                own_help(c"take the field out and leave a value in its place ('std::take(&x.f)', 'std::replace(&x.f, v)'), or copy it ('.clone()')");
                try_wrap(n, c"std::take(&", c")");
                own_end();
                return;
            }
            e = base;
        }
    }
}

// ---------------------------------------------------------------------------
// Positions and source text

// The file of position pos (an index in FILES).
fn file_of(pos: i64) -> i64 {
    unsafe {
        var f = 0;
        while f + 1 < FILE_COUNT && pos >= FILES[f + 1].start {
            f += 1;
        }
        f
    }
}

// The line of position pos, from 1.
fn line_of(pos: i64) -> i64 {
    unsafe {
        var line = 1;
        var i = FILES[file_of(pos)].start;
        while i < pos {
            if SRC[i] == '\n' {
                line += 1;
            }
            i += 1;
        }
        line
    }
}

// `LINE:COL` of position pos.
fn line_col(pos: i64) {
    unsafe {
        var col = 1;
        var i = pos;
        let start = FILES[file_of(pos)].start;
        while i > start && SRC[i - 1] != '\n' {
            col += 1;
            i -= 1;
        }
        let b = buf_new();
        buf_int(b, line_of(pos));
        buf_byte(b, ':');
        buf_int(b, col);
        crate::front::own::diag::own_bytes(buf_slice(b));
    }
}

// 'text' of node n's source.
fn src_quoted(n: i64) {
    unsafe {
        let b = buf_new();
        buf_byte(b, '\'');
        for i in NODES[n].start..NODES[n].end {
            buf_byte(b, SRC[i]);
        }
        buf_byte(b, '\'');
        crate::front::own::diag::own_bytes(buf_slice(b));
    }
}

// Appends s quoted for a shell (single quotes).
fn shell_quoted(out: i64, from: i64, to: i64, pre: i64, at: i64, end: i64, post: i64) {
    unsafe {
        buf_byte(out, '\'');
        var i = from;
        while i <= to {
            if i == at && pre >= 0 {
                quote_bytes(out, buf_slice(pre));
            }
            if i == end && post >= 0 {
                quote_bytes(out, buf_slice(post));
            }
            if i < to {
                quote_byte(out, SRC[i]);
            }
            i += 1;
        }
        buf_byte(out, '\'');
    }
}

fn quote_byte(out: i64, c: u8) {
    unsafe {
        if c == '\'' {
            buf_str(out, c"'\\''");
        } else {
            buf_byte(out, c);
        }
    }
}

fn quote_bytes(out: i64, s: [u8]) {
    for i in 0..s.len {
        quote_byte(out, s[i]);
    }
}

// The item (a function) that holds the code walked: a closure's enclosing
// function.
fn item_node() -> i64 {
    unsafe {
        var f = CUR_F;
        var guard = 0;
        while f >= 0 && (NODES[FNS[f].node].p & FN_CLOSURE) != 0 && guard < 64 {
            var outer = -1;
            for i in 0..CLOSURE_COUNT {
                if CLOSURES[i].f == f {
                    outer = CLOSURES[i].encl_fn;
                }
            }
            f = outer;
            guard += 1;
        }
        if f < 0 { 0 } else { FNS[f].node }
    }
}

// A `try:` line that rewrites node n's text t as `pre t post` on its line:
// `volec edit patch FILE:LINE --old 'LINE' --new 'LINE'`, the line's
// text without its indentation (with --nth when the item has it more than
// once). None in std, or for a node over several lines.
fn try_wrap(n: i64, pre: *u8, post: *u8) {
    unsafe {
        let start = NODES[n].start;
        let end = NODES[n].end;
        let f = file_of(start);
        let path = FILES[f].path;
        if path[0] == '<' || end <= start {
            return;
        }
        var ls = start;
        while ls > FILES[f].start && SRC[ls - 1] != '\n' {
            ls -= 1;
        }
        while ls < start && (SRC[ls] == ' ' || SRC[ls] == '\t') {
            ls += 1;
        }
        var le = start;
        while le < FILES[f].end && SRC[le] != '\n' {
            le += 1;
        }
        if end > le {
            return;
        }
        while le > end && (SRC[le - 1] == ' ' || SRC[le - 1] == '\t') {
            le -= 1;
        }
        let pre_b = buf_new();
        buf_str(pre_b, pre);
        let post_b = buf_new();
        buf_str(post_b, post);
        let args = buf_new();
        buf_str(args, c"edit patch ");
        buf_str(args, if path[0] == '.' && path[1] == '/' { &path[2] } else { path });
        buf_byte(args, ':');
        buf_int(args, line_of(start));
        buf_str(args, c" --old ");
        shell_quoted(args, ls, le, -1, -1, -1, -1);
        buf_str(args, c" --new ");
        shell_quoted(args, ls, le, pre_b, start, end, post_b);
        // (the line's text more than once in its item: which one)
        let item = item_node();
        if item != 0 {
            let len = le - ls;
            var seen = 0;
            var nth = 0;
            var i = NODES[item].start;
            while i + len <= NODES[item].end {
                var same = true;
                var j = 0;
                while j < len && same {
                    if SRC[i + j] != SRC[ls + j] {
                        same = false;
                    }
                    j += 1;
                }
                if same {
                    seen += 1;
                    if i == ls {
                        nth = seen;
                    }
                }
                i += 1;
            }
            if seen > 1 && nth > 0 {
                buf_str(args, c" --nth ");
                buf_int(args, nth);
            }
        }
        let out = buf_new();
        buf_tool_command(out, buf_slice(args), false);
        own_try(buf_slice(out));
    }
}

// The name of place p, quoted: 'v', 'p.a', 't.0'.
fn place_name(p: i64) {
    unsafe {
        let b = buf_new();
        buf_byte(b, '\'');
        place_text(b, p);
        buf_byte(b, '\'');
        crate::front::own::diag::own_bytes(buf_slice(b));
    }
}

fn place_text(b: i64, p: i64) {
    unsafe {
        if PL_PARENT[p] >= 0 {
            place_text(b, PL_PARENT[p]);
            let f = PL_FIELD[p];
            if f == DEREF_FIELD {
                return;
            }
            buf_byte(b, '.');
            if f >= TUPLE_FIELD {
                buf_int(b, field_number(f));
            } else {
                buf_bytes(b, SYMS[f].text);
            }
            return;
        }
        if PL_RKIND[p] == RK_STATIC {
            buf_bytes(b, SYMS[NODES[crate::front::types::STATICS[PL_RID[p]].node].a].text);
        } else {
            buf_bytes(b, SYMS[LOCALS[PL_RID[p]].name].text);
        }
    }
}
