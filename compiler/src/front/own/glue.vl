// Drop glue (0.17, docs/design/value-semantics.md §2.2, §4 step 0): what
// dropping a value of a type runs, as statements on a place, written as
// untyped AST that the checker then checks where the drop stands.
//
// - a type with a `Drop` impl: `place.drop()`, then its fields' glue;
// - std's containers (Vec, Buf, HashMap, Arena): their `Drop` impl only
//   (nothing before std implements it);
// - a struct or a tuple: its fields' glue, in declaration order;
// - an enum: `match place { E::V(__g0, _) => {}, _ => {} }`, a match whose
//   bindings are dropped as any owned binding of a match by value is
//   (drops.vl: arm_drops; the match is GLUE_MATCH);
// - an array: a loop over its elements (`let mut __gi0 = 0; while __gi0 <
//   N { glue of place[__gi0]; __gi0 += 1; }`);
// - a closure: the owned values a `move` closure captured (a closure that
//   borrows, or copies, owns nothing).
//
// Each top-level statement is an *entry* with the path of its place (the
// fields from the local): the moves decide per entry whether it runs
// (drops.vl). has_glue(t) is whether a value of type t has any glue: it
// is what `needs_drop::<T>()` folds to.

use crate::base::{IntVec, intern, intern_c};
use crate::front::ast::{
    CLOSURE_HOLES, CLOSURE_MOVE, NODES, NODE_IMPLICIT, NodeKind, list_begin, list_end, list_push,
    new_node,
};
use crate::front::closures::CLOSURES;
use crate::front::lexer::{SUF_I64, Tok};
use crate::front::own::kinds::{K_NEEDS_DROP, has_drop_impl, owned_base_type, type_kind};
use crate::front::own::state::{TUPLE_FIELD, variant_field_key};
use crate::front::types::{
    ENUMS, STRUCTS, TYPES, TyKind, VARIANTS, enum_variant, struct_field, type_elem, variant_field,
};
use crate::middle::lower::ssa::HMap;

// On a Match the glue makes: its bindings are owned (drops.vl drops
// them), whatever the scrutinee is reached through.
pub const GLUE_MATCH: i64 = 1 << 56;

// (0.25) On a Match the glue makes to reach a part of an enum's value past
// a variant step (wrap_variants): its bindings name the parts, nothing
// drops them (drops.vl: arm_drops).
pub const GLUE_REF: i64 = 1 << 59;
// A path step `[__giK]` (an array's element, K the loop's depth); other
// steps are a field's name or TUPLE_FIELD + i.
pub const INDEX_STEP: i64 = 1 << 48;

// Per type id + 1: 1 + whether it has glue (0: not known yet).
static var GLUE_MEMO: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

// Whether dropping a value of type t runs code: what `needs_drop::<T>()`
// is.
pub fn has_glue(t: i64) -> bool {
    unsafe {
        if t <= 0 || (type_kind(t) & K_NEEDS_DROP) == 0 {
            return false;
        }
        let known = GLUE_MEMO.get(t + 1);
        if known != 0 {
            return known == 2;
        }
        // (a type reached again while it is computed: none from there)
        GLUE_MEMO.put(t + 1, 1);
        let r = glue_of(t);
        GLUE_MEMO.put(t + 1, if r { 2 } else { 1 });
        r
    }
}

fn glue_of(t: i64) -> bool {
    unsafe {
        if has_drop_impl(t) {
            return true;
        }
        if owned_base_type(t) {
            return false;
        }
        let kind = TYPES[t].kind;
        if kind == TyKind::Struct {
            let s = TYPES[t].a;
            if STRUCTS[s].closure != 0 && !moving_closure(s) {
                return false;
            }
            for i in 0..STRUCTS[s].field_count {
                if has_glue((*struct_field(s, i)).ty) {
                    return true;
                }
            }
            return false;
        }
        if kind == TyKind::Tuple {
            for i in 0..TYPES[t].count {
                if has_glue(type_elem(t, i)) {
                    return true;
                }
            }
            return false;
        }
        if kind == TyKind::Array {
            return TYPES[t].b > 0 && has_glue(TYPES[t].a);
        }
        if kind == TyKind::Enum {
            let e = TYPES[t].a;
            for i in 0..ENUMS[e].variant_count {
                let v = enum_variant(e, i);
                for j in 0..VARIANTS[v].field_count {
                    if has_glue(variant_field(v, j)) {
                        return true;
                    }
                }
            }
        }
        false
    }
}

// Whether closure struct s is a `move` closure's (its captures are its
// own).
fn moving_closure(s: i64) -> bool {
    unsafe {
        let id = STRUCTS[s].closure - 1;
        let c = NODES[CLOSURES[id].node].c;
        (c & CLOSURE_MOVE) != 0 && (c & CLOSURE_HOLES) == 0
    }
}

// (0.20) The name of the flag of a sink closure's capture `name`:
// `__live_name`, true while the closure holds it.
pub fn live_flag(name: i64) -> i64 {
    unsafe {
        let b = crate::base::buf_new();
        crate::base::buf_str(b, c"__live_");
        crate::base::buf_bytes(b, crate::base::SYMS[name].text);
        intern(crate::base::buf_slice(b))
    }
}

// The flag field of capture `name` in closure struct s (its name), or 0.
pub fn flag_field(s: i64, name: i64) -> i64 {
    unsafe {
        let flag = live_flag(name);
        for i in 0..STRUCTS[s].field_count {
            if (*struct_field(s, i)).name == flag {
                return flag;
            }
        }
        0
    }
}

// ---------------------------------------------------------------------------
// The statements

// The place: a local's name, then G_PATH's steps; G_AT gives the nodes'
// positions.
static var G_ROOT: i64 = 0;
static var G_AT: i64 = 0;
static var G_PATH: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Inside an array's loop (its statements are not entries).
static var G_DEPTH: i64 = 0;
// (0.25) The variant steps of G_PATH, four numbers each: the step's index
// in G_PATH, the enum type, the variant (VARIANTS), the field. The part at
// step K is bound to `__gvK` (wrap_variants).
static var G_VS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The entries made: the statement, and its path at G_PATHS[G_PATH_AT[i]]
// (the count, then the steps).
pub static var G_STMTS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static var G_PATH_AT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static var G_PATHS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

static var SYM_DROP: i64 = 0;

fn node(kind: NodeKind) -> i64 {
    unsafe { new_node(kind, NODES[G_AT].start, NODES[G_AT].end) }
}

fn ident(sym: i64) -> i64 {
    unsafe {
        let n = node(NodeKind::Ident);
        NODES[n].a = sym;
        n
    }
}

fn int_lit(v: i64) -> i64 {
    unsafe {
        let n = node(NodeKind::Int);
        NODES[n].a = v;
        NODES[n].b = SUF_I64;
        n
    }
}

fn empty_block() -> i64 {
    let b = node(NodeKind::Block);
    let mark = list_begin();
    list_end(b, mark);
    b
}

// `__gK` (a binding of an enum's glue), `__giK` (an array loop's index).
fn numbered(prefix: *u8, k: i64) -> i64 {
    let b = crate::base::buf_new();
    crate::base::buf_str(b, prefix);
    crate::base::buf_int(b, k);
    intern(crate::base::buf_slice(b))
}

// The place expression: the root, then the path; past a variant step
// (G_VS), the innermost one's binding, then the steps after it.
fn path_expr() -> i64 {
    unsafe {
        let n = G_VS.count / 4;
        if n == 0 {
            return seg_expr(G_ROOT, 0, G_PATH.count);
        }
        seg_expr(numbered(c"__gv", n - 1), G_VS.data[(n - 1) * 4] + 1, G_PATH.count)
    }
}

// The expression of `root`, then the steps G_PATH[from..to].
fn seg_expr(root: i64, from: i64, to: i64) -> i64 {
    unsafe {
        var e = ident(root);
        for i in from..to {
            let step = G_PATH.data[i];
            if step >= INDEX_STEP {
                let x = node(NodeKind::Index);
                NODES[x].a = e;
                NODES[x].b = ident(numbered(c"__gi", step - INDEX_STEP));
                e = x;
            } else if step >= TUPLE_FIELD {
                let x = node(NodeKind::TupleField);
                NODES[x].a = e;
                NODES[x].b = step - TUPLE_FIELD;
                e = x;
            } else {
                let x = node(NodeKind::FieldAccess);
                NODES[x].a = e;
                NODES[x].b = step;
                // (0.18.1) the compiler's own read: a sealed struct's private
                // fields are dropped outside its module too (BinaryHeap)
                NODES[x].p = NODE_IMPLICIT;
                e = x;
            }
        }
        e
    }
}

// (0.25) Statement st of an entry past variant steps, inside the matches
// that reach its place: `match e { E::V(_, __gv0) => { st }, _ => {} }`,
// one per step, outermost first. Their bindings name the parts (GLUE_REF:
// nothing drops them).
fn wrap_variants(st: i64) -> i64 {
    unsafe {
        var inner = st;
        var k = G_VS.count / 4 - 1;
        while k >= 0 {
            let pos = G_VS.data[k * 4];
            let t = G_VS.data[k * 4 + 1];
            let v = G_VS.data[k * 4 + 2];
            let j = G_VS.data[k * 4 + 3];
            let root = if k == 0 { G_ROOT } else { numbered(c"__gv", k - 1) };
            let from = if k == 0 { 0 } else { G_VS.data[(k - 1) * 4] + 1 };
            let m = node(NodeKind::Match);
            NODES[m].a = seg_expr(root, from, pos);
            NODES[m].p |= GLUE_REF;
            let pat = node(NodeKind::PatVariant);
            NODES[pat].y = t;
            NODES[pat].b = VARIANTS[v].name;
            NODES[pat].c = 1;
            let pmark = list_begin();
            for i in 0..VARIANTS[v].field_count {
                if i == j {
                    let b = node(NodeKind::PatBind);
                    NODES[b].a = numbered(c"__gv", k);
                    list_push(b);
                } else {
                    list_push(node(NodeKind::PatWild));
                }
            }
            list_end(pat, pmark);
            let body = node(NodeKind::Block);
            let bmark = list_begin();
            list_push(inner);
            list_end(body, bmark);
            let mark = list_begin();
            let arm = node(NodeKind::Arm);
            NODES[arm].a = pat;
            NODES[arm].c = body;
            list_push(arm);
            if ENUMS[TYPES[t].a].variant_count > 1 {
                let other = node(NodeKind::Arm);
                NODES[other].a = node(NodeKind::PatWild);
                NODES[other].c = empty_block();
                list_push(other);
            }
            list_end(m, mark);
            let s = node(NodeKind::ExprStmt);
            NODES[s].a = m;
            NODES[s].b = 1;
            inner = s;
            k -= 1;
        }
        inner
    }
}

// Statement `e;` pushed on the list being built; an entry at top level
// (past variant steps, inside their matches: wrap_variants).
fn emit(e: i64) {
    unsafe {
        let st = node(NodeKind::ExprStmt);
        NODES[st].a = e;
        NODES[st].b = 1;
        let top = if G_DEPTH == 0 && G_VS.count > 0 { wrap_variants(st) } else { st };
        list_push(top);
        if G_DEPTH == 0 {
            G_STMTS.push(top);
            G_PATH_AT.push(G_PATHS.count);
            G_PATHS.push(G_PATH.count);
            for i in 0..G_PATH.count {
                G_PATHS.push(G_PATH.data[i]);
            }
        }
    }
}

// The glue of a value of type t at the place, its statements pushed on
// the list being built.
fn push_glue(t: i64) {
    unsafe {
        if !has_glue(t) {
            return;
        }
        if has_drop_impl(t) && G_VS.count > 0 && G_DEPTH == 0 {
            // (0.25: past a variant step the place is a binding's copy:
            // its drop and then its fields' glue, on that copy, are one
            // entry, as the drop needs all of it)
            let b = node(NodeKind::Block);
            G_DEPTH += 1;
            let m = list_begin();
            push_glue(t);
            list_end(b, m);
            G_DEPTH -= 1;
            emit(b);
            return;
        }
        if has_drop_impl(t) {
            let call = node(NodeKind::MethodCall);
            NODES[call].a = path_expr();
            NODES[call].b = SYM_DROP;
            let mark = list_begin();
            list_end(call, mark);
            emit(call);
        }
        if owned_base_type(t) {
            return;
        }
        let kind = TYPES[t].kind;
        if kind == TyKind::Struct {
            let s = TYPES[t].a;
            if STRUCTS[s].closure != 0 && !moving_closure(s) {
                return;
            }
            for i in 0..STRUCTS[s].field_count {
                let f = struct_field(s, i);
                let flag = if STRUCTS[s].closure != 0 { flag_field(s, (*f).name) } else { 0 };
                if flag == 0 {
                    G_PATH.push((*f).name);
                    push_glue((*f).ty);
                    G_PATH.count -= 1;
                    continue;
                }
                // (0.20: a sink closure's capture, if it still holds it:
                // `if place.__live_x { glue of place.x }`)
                let cond = node(NodeKind::FieldAccess);
                NODES[cond].a = path_expr();
                NODES[cond].b = flag;
                let body = node(NodeKind::Block);
                G_DEPTH += 1;
                G_PATH.push((*f).name);
                let m = list_begin();
                push_glue((*f).ty);
                list_end(body, m);
                G_PATH.count -= 1;
                G_DEPTH -= 1;
                let test = node(NodeKind::If);
                NODES[test].a = cond;
                NODES[test].b = body;
                emit(test);
            }
        } else if kind == TyKind::Tuple {
            for i in 0..TYPES[t].count {
                G_PATH.push(TUPLE_FIELD + i);
                push_glue(type_elem(t, i));
                G_PATH.count -= 1;
            }
        } else if kind == TyKind::Array {
            emit(array_loop(TYPES[t].a, TYPES[t].b));
        } else if kind == TyKind::Enum && (has_drop_impl(t) || G_DEPTH > 0) {
            // (a Drop impl's value is never taken apart: one entry)
            emit(enum_match(t));
        } else if kind == TyKind::Enum {
            // (0.25) an entry per field of a variant that has glue, its path
            // through the variant step: a match by value that moves some
            // parts leaves the others to drop with the value (bind_parts)
            let e = TYPES[t].a;
            for i in 0..ENUMS[e].variant_count {
                let v = enum_variant(e, i);
                for j in 0..VARIANTS[v].field_count {
                    let ft = variant_field(v, j);
                    if !has_glue(ft) {
                        continue;
                    }
                    G_VS.push(G_PATH.count);
                    G_VS.push(t);
                    G_VS.push(v);
                    G_VS.push(j);
                    G_PATH.push(variant_field_key(v, j));
                    push_glue(ft);
                    G_PATH.count -= 1;
                    G_VS.count -= 4;
                }
            }
        }
    }
}

// `{ let mut __giK = 0; while __giK < n { glue of place[__giK]; __giK +=
// 1; } }`.
fn array_loop(elem: i64, n: i64) -> i64 {
    unsafe {
        let k = G_DEPTH;
        let sym = numbered(c"__gi", k);
        let body = node(NodeKind::Block);
        G_DEPTH += 1;
        G_PATH.push(INDEX_STEP + k);
        let bmark = list_begin();
        push_glue(elem);
        let inc = node(NodeKind::Assign);
        NODES[inc].op = Tok::PlusEq;
        NODES[inc].b = ident(sym);
        NODES[inc].c = int_lit(1);
        let inc_st = node(NodeKind::ExprStmt);
        NODES[inc_st].a = inc;
        list_push(inc_st);
        list_end(body, bmark);
        G_PATH.count -= 1;
        G_DEPTH -= 1;
        let cond = node(NodeKind::Binary);
        NODES[cond].op = Tok::Lt;
        NODES[cond].b = ident(sym);
        NODES[cond].c = int_lit(n);
        let w = node(NodeKind::While);
        NODES[w].b = cond;
        NODES[w].c = body;
        let pat = node(NodeKind::PatBind);
        NODES[pat].a = sym;
        NODES[pat].b = 1;
        let init = node(NodeKind::Let);
        NODES[init].a = pat;
        NODES[init].c = int_lit(0);
        let w_st = node(NodeKind::ExprStmt);
        NODES[w_st].a = w;
        let block = node(NodeKind::Block);
        let mark = list_begin();
        list_push(init);
        list_push(w_st);
        list_end(block, mark);
        block
    }
}

// `match place { E::V(__g0, _, ..) => {}, ..., _ => {} }`: an arm per
// variant with fields that have glue, binding those.
fn enum_match(t: i64) -> i64 {
    unsafe {
        let e = TYPES[t].a;
        let m = node(NodeKind::Match);
        NODES[m].a = path_expr();
        NODES[m].p |= GLUE_MATCH;
        let mark = list_begin();
        var all = true;
        for i in 0..ENUMS[e].variant_count {
            let v = enum_variant(e, i);
            var any = false;
            for j in 0..VARIANTS[v].field_count {
                if has_glue(variant_field(v, j)) {
                    any = true;
                }
            }
            if !any {
                all = false;
                continue;
            }
            let pat = node(NodeKind::PatVariant);
            NODES[pat].y = t;
            NODES[pat].b = VARIANTS[v].name;
            NODES[pat].c = 1;
            let pmark = list_begin();
            for j in 0..VARIANTS[v].field_count {
                if has_glue(variant_field(v, j)) {
                    let b = node(NodeKind::PatBind);
                    NODES[b].a = numbered(c"__g", j);
                    list_push(b);
                } else {
                    list_push(node(NodeKind::PatWild));
                }
            }
            list_end(pat, pmark);
            let arm = node(NodeKind::Arm);
            NODES[arm].a = pat;
            NODES[arm].c = empty_block();
            list_push(arm);
        }
        if !all {
            let arm = node(NodeKind::Arm);
            NODES[arm].a = node(NodeKind::PatWild);
            NODES[arm].c = empty_block();
            list_push(arm);
        }
        list_end(m, mark);
        m
    }
}

// The glue of a value of type t in local `root` (a name), as a Block (not
// checked yet); its entries are G_STMTS[mark..] (glue_mark() before).
pub fn glue_block(root: i64, t: i64, at: i64) -> i64 {
    unsafe {
        if SYM_DROP == 0 {
            SYM_DROP = intern_c(c"drop");
        }
        G_ROOT = root;
        G_AT = at;
        G_PATH.count = 0;
        G_DEPTH = 0;
        G_VS.count = 0;
        let block = node(NodeKind::Block);
        let mark = list_begin();
        push_glue(t);
        list_end(block, mark);
        block
    }
}

pub fn glue_mark() -> i64 {
    unsafe { G_STMTS.count }
}

// Forgets the entries from mark on (the caller has copied them).
pub fn glue_reset(mark: i64) {
    unsafe {
        if mark < G_STMTS.count {
            G_PATHS.count = G_PATH_AT.data[mark];
        }
        G_STMTS.count = mark;
        G_PATH_AT.count = mark;
    }
}
