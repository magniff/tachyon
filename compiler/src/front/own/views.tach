// Views and exclusivity: the walk's view events (0.17, docs/design/
// value-semantics.md §2.4, §4 step 4). T2 owns this file and calls.tach.
//
// Phase 0: the hooks, empty. T2 fills them over state.tach's slots,
// origins, flags and pending arguments, and reports own.conflict,
// own.escape, own.static and own.readonly through diag.tach. The
// parameters' slots exist when on_enter runs (walk.tach made them, for
// the parameters of view types); their origins are T2's to set (level 1:
// root_place(l, false), level 2: root_place(l, true)).

// The walk starts function f, its parameters bound (walk::PARAM_LOCALS).
pub fn on_enter(f: i64) {}

// Place p is read, or borrowed, at node n: an invalidated slot used here
// is the conflict; a read of a place an explicit `&mut` argument of the
// call being walked holds is one too.
pub fn on_read(p: i64, n: i64) {}

// Place p is written, moved, dropped or mutably borrowed at node n (how:
// walk::W_*): the views of it are invalid from here.
pub fn on_write(p: i64, n: i64, how: i64) {}

// `&p` (kind REF_SHARED) or `&mut p` (REF_MUT) at node n; raw: reached
// through a raw pointer. dst (-1: none) gets the loan, and at level 2
// what p holds.
pub fn on_borrow(p: i64, n: i64, kind: i64, raw: bool, dst: i64) {}

// The value read out of place p at node n, of type ty: dst gets the views
// it holds (walk::PO_* say how p was reached: PO_INNER, an element inside
// what a view points to).
pub fn on_value(p: i64, n: i64, ty: i64, dst: i64) {}

// Local l bound at node n (a pattern) to a value of origin v (-1: none);
// its slot, if it holds views, exists.
pub fn on_bind(l: i64, n: i64, v: i64) {}

// `let l = init;` after the binding: a view taken from a view local is a
// reborrow of it (SLOT_PARENT).
pub fn on_let(l: i64, init: i64) {}

// A `for` over owned place p: the loop's sequence local l is p; the loop
// holds a shared loan on it.
pub fn on_for_alias(l: i64, p: i64, init: i64) {}

// Assignment n to place p, its value's origin v (walk::PO_* as the target
// left them: PO_VIEWSLOT, a write through a view).
pub fn on_assign(p: i64, n: i64, v: i64) {}

// A scope ends: the locals walk::BOUND[mark..] die. v is the origin of its
// value (-1: none), tail that value's node (0: none): a value viewing a
// dying local escapes.
pub fn on_scope_end(mark: i64, v: i64, tail: i64) {}

// The function's result at node e, origin v (-1: none): views of locals
// or of owned by-value parameters escape (own.escape).
pub fn on_result(e: i64, v: i64) {}
