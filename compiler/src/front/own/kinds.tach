// Kinds (0.17, docs/design/value-semantics.md §2.1, §4 step 1): what a
// type's values do when copied. They are computed structurally and
// memoized per type id:
// - plain: numbers, bool, fieldless enums, fn pointers, raw `*T`, and
//   aggregates of plain types; `=` copies the bits;
// - owned (K_OWNED): has a `Drop` impl (std's Vec, Buf, HashMap and Arena
//   count as owned before std implements Drop, T4), or a part that is
//   owned; `=` moves;
// - view (K_VIEW): holds a slice, a reference (`&T`, `&mut T`, `&mut
//   [T]`), a closure capturing by reference, a `#[scoped]` type, or a
//   part that is a view. A type can be owned and a view (`Vec<[u8]>`).
// K_NEEDS_DROP: dropping a value runs code (owned, today); K_LEVEL2: the
// type holds views of views (`[[u8]]`, `&Vec<[u8]>`, `[Tok]` with `Tok {
// text: [u8] }`): its origins need both levels (§2.4).
//
// param_mode is the parameter side of §2.3, with the legacy `*T` rule.
//
// Phase 0 contract: the signatures here are fixed; T1-T3 read them.

use crate::base::{alloc_array, intern_c};
use crate::front::ast::STRUCT_SCOPED;
use crate::front::closures::CLOSURES;
use crate::front::generics::{TPL_NONE, instance_of};
use crate::front::modules::{STD_MODULE, within_std};
use crate::front::traits::{IMPLS, IMPL_COUNT, has_impl, std_trait};
use crate::front::types::{
    ENUMS, FNS, REF_MUT, REF_SHARED, STRUCTS, TLISTS, TYPES, TY_ERROR, TyKind, VARIANTS,
    enum_variant, fn_param, struct_field, type_elem,
};
use crate::middle::lower::ssa::HMap;

pub const K_PLAIN: i64 = 0;
pub const K_OWNED: i64 = 1;
pub const K_VIEW: i64 = 2;
pub const K_NEEDS_DROP: i64 = 4;
pub const K_LEVEL2: i64 = 8;

// Per type id: its kind + 1 (0: not known yet), an array that grows with
// the types.
static var KIND_ARR: *i64 = 0 as *i64;
static var KIND_CAP: i64 = 0;

fn kind_put(t: i64, v: i64) {
    unsafe {
        if t >= KIND_CAP {
            let n = t * 2 + 1024;
            let a = alloc_array::<i64>(n);
            for i in 0..KIND_CAP {
                a[i] = KIND_ARR[i];
            }
            KIND_ARR = a;
            KIND_CAP = n;
        }
        KIND_ARR[t] = v;
    }
}

static var ELEM_MEMO: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static var SYM_VEC: i64 = 0;
static var SYM_BUF: i64 = 0;
static var SYM_HASHMAP: i64 = 0;
static var DROP_TRAIT: i64 = -2;
static var DROP_IMPLS: crate::base::IntVec = crate::base::IntVec {
    data: 0 as *i64, count: 0, cap: 0
};

// Whether struct s (an instance: its template's) is one of std's owning
// containers.
fn owned_base(s: i64) -> bool {
    unsafe {
        if SYM_VEC == 0 {
            SYM_VEC = intern_c(c"Vec");
            SYM_BUF = intern_c(c"Buf");
            SYM_HASHMAP = intern_c(c"HashMap");
        }
        let t = if STRUCTS[s].tmpl != 0 { STRUCTS[s].tmpl - 1 } else { s };
        if !within_std(STRUCTS[t].module) {
            return false;
        }
        let name = STRUCTS[t].name;
        // (Arena is a handle whose copies share the arena, with no Drop:
        // plain until 0.17.1 makes arena handles references, U3)
        name == SYM_VEC || name == SYM_BUF || name == SYM_HASHMAP
    }
}

// Whether type t is one of std's owning containers (Vec, Buf, HashMap).
pub fn owned_base_type(t: i64) -> bool {
    unsafe { t > 0 && TYPES[t].kind == TyKind::Struct && owned_base(TYPES[t].a) }
}

// Whether type t has an `impl Drop` (the prelude's trait). The impls of
// Drop are listed once (has_impl scans every impl block, and kinds ask
// for every struct and enum type): a type no listed impl names, or is an
// instance of, has none.
pub fn has_drop_impl(t: i64) -> bool {
    unsafe {
        if DROP_TRAIT == -2 {
            DROP_TRAIT = std_trait(c"Drop");
            DROP_IMPLS.count = 0;
            for i in 0..IMPL_COUNT {
                if IMPLS[i].tr == DROP_TRAIT && DROP_TRAIT >= 0 {
                    DROP_IMPLS.push(i);
                }
            }
        }
        if DROP_TRAIT < 0 || t <= 0
            || TYPES[t].kind != TyKind::Struct && TYPES[t].kind != TyKind::Enum {
            return false;
        }
        var named = false;
        for k in 0..DROP_IMPLS.count {
            let i = DROP_IMPLS.data[k];
            if IMPLS[i].ty != 0 && IMPLS[i].ty == t
                || IMPLS[i].tpl != TPL_NONE && instance_of(t, IMPLS[i].tpl) {
                named = true;
            }
        }
        named && has_impl(DROP_TRAIT, t)
    }
}

// The kind bits of type t (K_OWNED, K_VIEW, K_NEEDS_DROP, K_LEVEL2); 0:
// plain.
pub fn type_kind(t: i64) -> i64 {
    unsafe {
        if t <= 0 || t == TY_ERROR {
            return 0;
        }
        if t < KIND_CAP && KIND_ARR[t] != 0 {
            return KIND_ARR[t] - 1;
        }
        // (a recursive type through a raw pointer is plain there)
        kind_put(t, 1);
        var k = 0;
        let kind = TYPES[t].kind;
        if kind == TyKind::Slice {
            k = K_VIEW | level2_of(TYPES[t].a);
        } else if kind == TyKind::Ptr {
            if TYPES[t].b != 0 {
                k = K_VIEW | level2_of(TYPES[t].a);
            }
        } else if kind == TyKind::Struct {
            let s = TYPES[t].a;
            if owned_base(s) {
                k = K_OWNED;
                for i in 0..STRUCTS[s].targ_count {
                    k |= type_kind(TLISTS.data[STRUCTS[s].targs + i]) & (K_VIEW | K_LEVEL2);
                }
            } else {
                // (0.17, T1: a Drop impl owns; its fields may hold views)
                if has_drop_impl(t) {
                    k = K_OWNED;
                }
                if STRUCTS[s].closure != 0 && CLOSURES[STRUCTS[s].closure - 1].borrow_depth >= 0 {
                    k |= K_VIEW;
                }
                if (STRUCTS[s].repr & STRUCT_SCOPED) != 0 {
                    k |= K_VIEW;
                }
                for i in 0..STRUCTS[s].field_count {
                    let ft = (*struct_field(s, i)).ty;
                    if STRUCTS[s].closure != 0 && ft > 0 && TYPES[ft].kind == TyKind::Ptr {
                        // (a capture by reference)
                        k |= K_VIEW;
                    }
                    k |= type_kind(ft);
                }
            }
        } else if kind == TyKind::Tuple {
            for i in 0..TYPES[t].count {
                k |= type_kind(type_elem(t, i));
            }
        } else if kind == TyKind::Array {
            k = type_kind(TYPES[t].a);
        } else if kind == TyKind::Enum {
            let e = TYPES[t].a;
            if has_drop_impl(t) {
                k = K_OWNED;
            }
            for i in 0..ENUMS[e].variant_count {
                k |= type_kind(VARIANTS[enum_variant(e, i)].shape);
            }
        }
        if (k & K_OWNED) != 0 {
            k |= K_NEEDS_DROP;
        }
        kind_put(t, k + 1);
        k
    }
}

// K_LEVEL2 when what a view of `elem` points to holds views.
fn level2_of(elem: i64) -> i64 {
    if (type_kind(elem) & K_VIEW) != 0 { K_LEVEL2 } else { 0 }
}

pub fn is_plain_type(t: i64) -> bool {
    (type_kind(t) & (K_OWNED | K_VIEW)) == 0
}

pub fn is_owned_type(t: i64) -> bool {
    (type_kind(t) & K_OWNED) != 0
}

pub fn is_view_type(t: i64) -> bool {
    (type_kind(t) & K_VIEW) != 0
}

// The element type of the views a value of type t holds (`[E]`: E,
// `Vec<[E]>`: E, `&E`: E, a struct holding only views of E: E); 0: none;
// -1: several, or unknown (a closure). For the type filter (§2.4, T3).
pub fn view_elem(t: i64) -> i64 {
    unsafe {
        if t <= 0 || !is_view_type(t) {
            return 0;
        }
        let known = ELEM_MEMO.get(t + 1);
        if known != 0 {
            return known - 2;
        }
        ELEM_MEMO.put(t + 1, 1);
        let r = view_elem_of(t);
        ELEM_MEMO.put(t + 1, r + 2);
        r
    }
}

fn view_elem_of(t: i64) -> i64 {
    unsafe {
        let k = TYPES[t].kind;
        if k == TyKind::Slice || k == TyKind::Ptr {
            return TYPES[t].a;
        }
        var r = 0;
        if k == TyKind::Struct {
            let s = TYPES[t].a;
            if STRUCTS[s].closure != 0 {
                return -1;
            }
            if owned_base_type(t) {
                for i in 0..STRUCTS[s].targ_count {
                    r = join_elem(r, view_elem(TLISTS.data[STRUCTS[s].targs + i]));
                }
                return r;
            }
            for i in 0..STRUCTS[s].field_count {
                r = join_elem(r, view_elem((*struct_field(s, i)).ty));
            }
            return r;
        }
        if k == TyKind::Tuple {
            for i in 0..TYPES[t].count {
                r = join_elem(r, view_elem(type_elem(t, i)));
            }
            return r;
        }
        if k == TyKind::Array {
            return view_elem(TYPES[t].a);
        }
        if k == TyKind::Enum {
            let e = TYPES[t].a;
            for i in 0..ENUMS[e].variant_count {
                r = join_elem(r, view_elem(VARIANTS[enum_variant(e, i)].shape));
            }
            return r;
        }
        -1
    }
}

fn join_elem(a: i64, b: i64) -> i64 {
    if a == 0 { b } else if b == 0 || a == b { a } else { -1 }
}

// ---------------------------------------------------------------------------
// Parameters (§2.3, the legacy `*T` rule)

// How a function takes a parameter: by value (a move or a copy), by `&T`,
// by `&mut T`, raw, or a slice view (`[T]`: shared, `&mut [T]`:
// exclusive).
pub const P_VALUE: i64 = 0;
pub const P_SHARED: i64 = 1;
pub const P_MUT: i64 = 2;
pub const P_RAW: i64 = 3;
pub const P_VIEW: i64 = 4;
pub const P_MUT_VIEW: i64 = 5;

// How function f takes its parameter i: by value, a reference, a view, or
// raw (`*T`: since 0.18.1, docs/design/value-semantics.md §7 V4, every
// `*T` parameter is raw, `mut` or not; through 0.18.0 one written without
// `mut` in a safe function was `&mut T`).
pub fn param_mode(f: i64, i: i64) -> i64 {
    unsafe {
        if f < 0 || i >= FNS[f].param_count {
            return P_VALUE;
        }
        let t = fn_param(f, i);
        if t <= 0 {
            return P_VALUE;
        }
        let kind = TYPES[t].kind;
        if kind == TyKind::Slice {
            return if TYPES[t].b == REF_MUT { P_MUT_VIEW } else { P_VIEW };
        }
        if kind != TyKind::Ptr {
            return P_VALUE;
        }
        if TYPES[t].b == REF_SHARED {
            return P_SHARED;
        }
        if TYPES[t].b == REF_MUT { P_MUT } else { P_RAW }
    }
}

// Whether parameter mode m holds a loan on (or a view of) what the
// argument points into.
pub fn mode_borrows(m: i64) -> bool {
    m == P_SHARED || m == P_MUT || m == P_VIEW || m == P_MUT_VIEW
}

// Whether parameter mode m may write what the argument points into.
pub fn mode_writes(m: i64) -> bool {
    m == P_MUT || m == P_MUT_VIEW
}

// A kind as text, for `query` (one word, then the part that makes it):
// `plain`, `owned`, `view`, `owned view`.
pub fn kind_word(t: i64) -> *u8 {
    let k = type_kind(t);
    if (k & K_OWNED) != 0 && (k & K_VIEW) != 0 {
        return c"owned view";
    }
    if (k & K_OWNED) != 0 {
        return c"owned";
    }
    if (k & K_VIEW) != 0 {
        return c"view";
    }
    c"plain"
}
