// View summaries inferred (0.17, docs/design/value-semantics.md §2.4, §4
// step 2): the own pass's driver, the type filter, the collection of a
// walk's summary, indirect calls and the why-chains.
//
// The driver (infer_summaries) walks the functions callees first, in the
// order of the effects' strongly connected components (front/effects/
// infer.vl: Tarjan numbers a component when it completes, so a callee's
// number is below its callers'). A function that is not recursive is
// walked once; its summary is known before any caller is walked. A
// recursive component whose members have view-carrying summaries starts
// every member from its parametric floor (views() for a non-generic one)
// and walks them all until no summary grows (the masks only grow: each
// round joins the old summary and the new); its findings are those of one
// more walk, after the last round (own_flush only then).
//
// The type filter (§2.4): a level whose views are of type E points only
// into storage that can hold an E. holds(T, E): T's own storage (fields,
// elements, a Vec's or a HashMap's buffer; not through a view) can hold an
// E; deep(T, E): what T's views point to can (at any depth). A parameter's
// `p` is its referent (`&T`: holds(T, E)) or what its views point into (by
// value: a view of X in it, holds(X, E)); its `*p` is deeper (deep). A
// result whose type holds no views of views (no K_LEVEL2) has no level 2.
//
// Indirect calls (§2.4): a call through a fn value has the join of the
// summaries of every function of that type whose address the program takes
// (ADDRESS_TAKEN, as the effects use it). The effects graph has a virtual
// node per such type with edges to those functions, so they are summarized
// before the callers.
//
// The why-chains: per function, for each bit of its summary, the first
// exit (a `return`, the tail) whose value brought it; `query views --why`
// prints them, and a callee's summary when the value is a call.

use crate::base::{IntVec, SRC, SYMS, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, intern_c};
use crate::base::diag::{buf_position, put_short_positions};
use crate::front::ast::{FN_CLOSURE, NODES, NodeKind, child};
use crate::front::check::LOCALS;
use crate::front::effects::infer::{
    ADDRESS_TAKEN, COMPONENT, EDGES, EDGE_START, GRAPH_FNS, GRAPH_SIZE, body_walked, infer_effects,
};
use crate::front::modules::within_std;
use crate::front::own::diag::{
    OWN_VIEWS, own_begin, own_bytes, own_discard, own_end, own_flush, own_help, own_str, own_try,
};
use crate::front::own::kinds::{K_LEVEL2, is_view_type, owned_base_type, type_kind, view_elem};
use crate::front::own::state::{
    CUR, NW, PL_COUNT, PL_FIELD, PL_PARENT, PL_RID, PL_RKIND, POOL, RK_LOCAL, RK_ROOT, RK_STATIC,
    root_of, slot_of_local, slot_off,
};
use crate::front::own::summary::{
    S_L1_P, S_L1_STAR, S_L2_P, S_L2_STAR, ViewSummary, closure_param, decl_of, declared_summary,
    empty_summary, env_param, env_ref_field, floor_summary, has_mut_ref_param, join_summary,
    put_params, ret_parametric, same_summary, store_param, summary_inferred, summary_of,
    summary_store, summary_text, top_summary, view_fn,
};
use crate::front::own::views::CAPTURES_STORED;
use crate::front::own::walk::{PARAM_LOCALS, walk_fn};
use crate::front::types::{
    ENUMS, FNS, FN_COUNT, STRUCTS, TLISTS, TYPES, TyKind, VARIANTS, enum_variant, fn_param,
    struct_field, type_elem,
};
use crate::middle::lower::ssa::HMap;

// ---------------------------------------------------------------------------
// The type filter

static var HOLDS_MEMO: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static var DEEP_MEMO: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

fn pair_key(t: i64, e: i64) -> i64 {
    t * 16777216 + e + 1
}

// Whether types a and b are the same storage element (a `&mut [T]` is a
// `[T]`, a `&T` a `*T`).
fn same_elem(a0: i64, b0: i64) -> bool {
    unsafe {
        // (0.25: a distinct type is its base's storage, `str` a `[u8]`)
        let a = if a0 > 0 { crate::front::distinct::strip_distinct(a0) } else { a0 };
        let b = if b0 > 0 { crate::front::distinct::strip_distinct(b0) } else { b0 };
        if a == b {
            return true;
        }
        if a <= 0 || b <= 0 {
            return false;
        }
        let k = TYPES[a].kind;
        (k == TyKind::Slice || k == TyKind::Ptr) && TYPES[b].kind == k && TYPES[a].a == TYPES[b].a
    }
}

// Whether the storage of a value of type t (its fields, elements, a
// container's buffer; through raw pointers, not through views) can hold
// a value of type e.
pub fn holds(t: i64, e: i64) -> bool {
    unsafe {
        if t <= 0 || e <= 0 {
            return t > 0 && e < 0;
        }
        if same_elem(t, e) {
            return true;
        }
        let key = pair_key(t, e);
        let known = HOLDS_MEMO.get(key);
        if known != 0 {
            return known == 2;
        }
        // (a recursive type: the outer walk sees its other parts)
        HOLDS_MEMO.put(key, 1);
        let r = holds_of(t, e);
        HOLDS_MEMO.put(key, if r { 2 } else { 1 });
        r
    }
}

static var SYM_VEC_T: i64 = 0;
static var SYM_MAP_T: i64 = 0;

fn holds_of(t: i64, e: i64) -> bool {
    unsafe {
        let k = TYPES[t].kind;
        if k == TyKind::Distinct {
            // (0.25) its base's storage
            return holds(TYPES[t].a, e);
        }
        if k == TyKind::Ptr {
            // (raw: it may own what it points to; a reference does not)
            return TYPES[t].b == 0 && holds(TYPES[t].a, e);
        }
        if k == TyKind::Struct {
            let s = TYPES[t].a;
            // (0.25: a closure holds its captures, its env's fields: by
            // reference, nothing of its own; by value, what they hold)
            if owned_base_type(t) {
                let tpl = if STRUCTS[s].tmpl != 0 { STRUCTS[s].tmpl - 1 } else { s };
                if SYM_VEC_T == 0 {
                    SYM_VEC_T = intern_c(c"Vec");
                    SYM_MAP_T = intern_c(c"HashMap");
                }
                if STRUCTS[tpl].name != SYM_VEC_T && STRUCTS[tpl].name != SYM_MAP_T {
                    // (Buf holds bytes; Arena anything)
                    return true;
                }
                for i in 0..STRUCTS[s].targ_count {
                    if holds(TLISTS.data[STRUCTS[s].targs + i], e) {
                        return true;
                    }
                }
                for i in 0..STRUCTS[s].field_count {
                    // (0.25) a field itself: `-> let RawTable` of a HashMap
                    // (raw_table) is a view of its table
                    if same_elem((*struct_field(s, i)).ty, e) {
                        return true;
                    }
                }
                if STRUCTS[tpl].name == SYM_MAP_T {
                    // (0.25) a HashMap's table: its buckets, (K, V) pairs
                    let x = crate::front::distinct::strip_distinct(e);
                    if TYPES[x].kind == TyKind::Tuple {
                        var all = true;
                        for i in 0..TYPES[x].count {
                            if !holds(t, type_elem(x, i)) {
                                all = false;
                            }
                        }
                        return all;
                    }
                }
                return false;
            }
            for i in 0..STRUCTS[s].field_count {
                if holds((*struct_field(s, i)).ty, e) {
                    return true;
                }
            }
            return false;
        }
        if k == TyKind::Tuple {
            for i in 0..TYPES[t].count {
                if holds(type_elem(t, i), e) {
                    return true;
                }
            }
            return false;
        }
        if k == TyKind::Array {
            return holds(TYPES[t].a, e);
        }
        if k == TyKind::Enum {
            let en = TYPES[t].a;
            for i in 0..ENUMS[en].variant_count {
                if holds(VARIANTS[enum_variant(en, i)].shape, e) {
                    return true;
                }
            }
        }
        false
    }
}

// Whether what the views of a value of type t point to (at any depth)
// can hold an e.
pub fn deep(t: i64, e: i64) -> bool {
    unsafe {
        if t <= 0 || e <= 0 {
            return t > 0 && e < 0;
        }
        if !is_view_type(t) && TYPES[t].kind != TyKind::Ptr {
            return false;
        }
        let key = pair_key(t, e);
        let known = DEEP_MEMO.get(key);
        if known != 0 {
            return known == 2;
        }
        DEEP_MEMO.put(key, 1);
        let r = targets(t, e, true);
        DEEP_MEMO.put(key, if r { 2 } else { 1 });
        r
    }
}

// (the nesting of targets: a recursive type, `struct Node { text: [u8],
// kids: Vec<Node> }`, is cut at a depth, conservatively)
static var TARGETS_DEPTH: i64 = 0;

// Whether the views in the parts of a value of type t point to storage
// that can hold an e (with far: to storage whose views do, at any depth).
fn targets(t: i64, e: i64, far: bool) -> bool {
    unsafe {
        if TARGETS_DEPTH > 16 {
            return true;
        }
        TARGETS_DEPTH += 1;
        let r = targets_of(t, e, far);
        TARGETS_DEPTH -= 1;
        r
    }
}

fn targets_of(t: i64, e: i64, far: bool) -> bool {
    unsafe {
        if t <= 0 {
            return false;
        }
        let k = TYPES[t].kind;
        if k == TyKind::Slice || k == TyKind::Ptr {
            let y = TYPES[t].a;
            return holds(y, e) || far && deep(y, e);
        }
        if !is_view_type(t) {
            return false;
        }
        if k == TyKind::Struct {
            let s = TYPES[t].a;
            if STRUCTS[s].closure != 0 {
                return true;
            }
            if owned_base_type(t) {
                for i in 0..STRUCTS[s].targ_count {
                    if targets(TLISTS.data[STRUCTS[s].targs + i], e, far) {
                        return true;
                    }
                }
                return false;
            }
            for i in 0..STRUCTS[s].field_count {
                if targets((*struct_field(s, i)).ty, e, far) {
                    return true;
                }
            }
            return false;
        }
        if k == TyKind::Tuple {
            for i in 0..TYPES[t].count {
                if targets(type_elem(t, i), e, far) {
                    return true;
                }
            }
            return false;
        }
        if k == TyKind::Array {
            return targets(TYPES[t].a, e, far);
        }
        if k == TyKind::Enum {
            let en = TYPES[t].a;
            for i in 0..ENUMS[en].variant_count {
                if targets(VARIANTS[enum_variant(en, i)].shape, e, far) {
                    return true;
                }
            }
            return false;
        }
        // (a scoped arena, a closure: anything)
        true
    }
}

// Whether a parameter of type t can carry views or loans at all: a view,
// or a pointer (a reference, a legacy `*T` borrow).
pub fn param_carries(t: i64) -> bool {
    unsafe { t > 0 && (is_view_type(t) || TYPES[t].kind == TyKind::Ptr) }
}

// Whether parameter type t's `p` (star false) or `*p` (star true) can hold
// views of element type e.
fn root_can(t: i64, e: i64, star: bool) -> bool {
    unsafe {
        if !param_carries(t) {
            return false;
        }
        if e < 0 {
            return true;
        }
        if TYPES[t].kind == TyKind::Ptr {
            let x = TYPES[t].a;
            return if star { deep(x, e) } else { holds(x, e) };
        }
        if star {
            // (by value: what its views point to holds views of e)
            return targets_far_only(t, e);
        }
        targets(t, e, false)
    }
}

// The views in t's parts point to storage whose own views reach an e.
fn targets_far_only(t: i64, e: i64) -> bool {
    unsafe {
        let k = TYPES[t].kind;
        if k == TyKind::Slice || k == TyKind::Ptr {
            return deep(TYPES[t].a, e);
        }
        if !is_view_type(t) {
            return false;
        }
        if k == TyKind::Struct {
            let s = TYPES[t].a;
            if STRUCTS[s].closure != 0 {
                return true;
            }
            if owned_base_type(t) {
                for i in 0..STRUCTS[s].targ_count {
                    if targets_far_only(TLISTS.data[STRUCTS[s].targs + i], e) {
                        return true;
                    }
                }
                return false;
            }
            for i in 0..STRUCTS[s].field_count {
                if targets_far_only((*struct_field(s, i)).ty, e) {
                    return true;
                }
            }
            return false;
        }
        if k == TyKind::Tuple {
            for i in 0..TYPES[t].count {
                if targets_far_only(type_elem(t, i), e) {
                    return true;
                }
            }
            return false;
        }
        if k == TyKind::Array {
            return targets_far_only(TYPES[t].a, e);
        }
        if k == TyKind::Enum {
            let en = TYPES[t].a;
            for i in 0..ENUMS[en].variant_count {
                if targets_far_only(VARIANTS[enum_variant(en, i)].shape, e) {
                    return true;
                }
            }
            return false;
        }
        true
    }
}

// Per function: the masks the filter keeps (result level 1 from `p`, from
// `*p`; whether level 2 can be non-empty), computed once.
static var FILT: *i64 = 0 as *i64;
static var FILT_N: i64 = 0;

fn filter_masks(f: i64) -> i64 {
    unsafe {
        if FILT_N <= f {
            let n = FN_COUNT + 64;
            let a = crate::base::alloc_array::<i64>(n * 7);
            for i in 0..FILT_N * 7 {
                a[i] = FILT[i];
            }
            FILT = a;
            FILT_N = n;
        }
        let o = f * 7;
        if FILT[o + 4] != 0 {
            return o;
        }
        let r = FNS[f].ret;
        let e = view_elem(r);
        var p = 0;
        var s = 0;
        if FNS[f].param_count > 63 || e == 0 {
            p = -1;
            s = -1;
        } else {
            for i in 0..FNS[f].param_count {
                let t = fn_param(f, i);
                if root_can(t, e, false) {
                    p |= 1 << i;
                }
                if root_can(t, e, true) {
                    s |= 1 << i;
                }
            }
        }
        FILT[o] = p;
        FILT[o + 1] = s;
        FILT[o + 2] = if (type_kind(r) & K_LEVEL2) != 0 { -1 } else { 0 };
        // (level 2, when the result has exactly two levels: views of E2,
        // the element of the views an E holds)
        FILT[o + 5] = FILT[o + 2];
        FILT[o + 6] = FILT[o + 2];
        let e2 = if e > 0 { view_elem(e) } else { 0 };
        if FILT[o + 2] != 0 && e2 > 0 && !is_view_type(e2) && FNS[f].param_count <= 63 {
            var p2 = 0;
            var s2 = 0;
            for i in 0..FNS[f].param_count {
                let t = fn_param(f, i);
                if root_can(t, e2, false) {
                    p2 |= 1 << i;
                }
                if root_can(t, e2, true) {
                    s2 |= 1 << i;
                }
            }
            FILT[o + 5] = p2;
            FILT[o + 6] = s2;
        }
        // (the stores: a referent never gains what it holds already, so
        // with one `&mut` parameter its own bits go)
        var targets = 0;
        var only = -1;
        for i in 0..FNS[f].param_count {
            if store_param(f, i) {
                targets += 1;
                only = i;
            }
        }
        // (a closure's env, or a closure given: its own bits stay, as one
        // capture may come to view another)
        FILT[o + 3] = if targets == 1 && only < 63 && !env_param(f, only) && !closure_param(f, only)
            { ~(1 << only) } else { -1 };
        FILT[o + 4] = 1;
        o
    }
}

// Summary s of f narrowed by the type filter (summary_of's last step).
pub fn filter_summary(f: i64, s: ViewSummary) -> ViewSummary {
    unsafe {
        var r = s;
        let o = filter_masks(f);
        if !is_view_type(FNS[f].ret) {
            for k in 0..4 {
                r.ret[k] = 0;
            }
        } else {
            r.ret[S_L1_P] &= FILT[o];
            r.ret[S_L1_STAR] &= FILT[o + 1];
            r.ret[S_L2_P] &= FILT[o + 5];
            r.ret[S_L2_STAR] &= FILT[o + 6];
        }
        for k in 0..4 {
            r.sto[k] &= FILT[o + 3];
            if !has_mut_ref_param(f) {
                r.sto[k] = 0;
            }
        }
        r
    }
}

// ---------------------------------------------------------------------------
// Indirect calls

// The summary of a call through a value of fn type t: the join of the
// summaries of the functions of that type whose address is taken (none:
// views()).
pub fn indirect_summary(t: i64) -> ViewSummary {
    unsafe {
        var s = empty_summary();
        var i = 0;
        while i < ADDRESS_TAKEN.count {
            if ADDRESS_TAKEN.data[i] == t {
                s = join_summary(s, summary_of(ADDRESS_TAKEN.data[i + 1]));
            }
            i += 2;
        }
        s.declared = false;
        s
    }
}

// The summary call n uses: of f, or (f < 0) of every function its fn
// value may be (indirect_summary of the callee's type).
pub fn summary_at_call(n: i64, f: i64) -> ViewSummary {
    unsafe {
        if f >= 0 {
            return summary_of(f);
        }
        let callee = NODES[n].a;
        if callee == 0 || NODES[callee].ty <= 0 || TYPES[NODES[callee].ty].kind != TyKind::Fn {
            return top_summary();
        }
        indirect_summary(NODES[callee].ty)
    }
}

// ---------------------------------------------------------------------------
// Collection (summary.vl's collect_*, called by the walk)

static var COL_F: i64 = -1;
static var COL_ON: bool = false;
static var COL_REPORTED: bool = false;
static var COL_RET: [i64; 4] = [0, 0, 0, 0];
static var COL_STO: [i64; 4] = [0, 0, 0, 0];
static var COL_DECL: ViewSummary = ViewSummary {
    ret: [0, 0, 0, 0], sto: [0, 0, 0, 0], top: false, declared: false,
};
static var COL_DECLARED: bool = false;
// (the why of this walk: (mask, parameter, node, target) quadruples)
static var COL_WHY: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// (the parameters a callable's result views in this walk: col_call)
static var COL_CALL: i64 = 0;

pub fn col_begin(f: i64, round: i64) {
    unsafe {
        COL_F = f;
        COL_ON = f >= 0 && view_fn(f);
        COL_REPORTED = false;
        COL_WHY.count = 0;
        COL_CALL = 0;
        COL_STORED[0] = 0;
        COL_STORED[1] = 0;
        for k in 0..4 {
            COL_RET[k] = 0;
            COL_STO[k] = 0;
        }
        COL_DECLARED = COL_ON && decl_of(f) != 0;
        if COL_DECLARED {
            COL_DECL = declared_summary(f);
        }
    }
}

// The index of parameter local l (walk::PARAM_LOCALS), -1.
fn param_index(l: i64) -> i64 {
    unsafe {
        for i in 0..PARAM_LOCALS.count {
            if PARAM_LOCALS.data[i] == l {
                return i;
            }
        }
        -1
    }
}

// The parameter root place q comes from: parameter * 2 (+ 1 for `*p`), or
// -1 (a local, a static, a by-value parameter's own storage, or local
// skip's own roots).
fn root_param(q: i64, skip: i64) -> i64 {
    unsafe {
        let r = root_of(q);
        if PL_RKIND[r] == RK_STATIC {
            return -1;
        }
        let l = PL_RID[r];
        if l < 0 || l == skip || !LOCALS[l].is_param {
            return -1;
        }
        let i = param_index(l);
        if i < 0 {
            return -1;
        }
        if PL_RKIND[r] == RK_ROOT {
            return i * 2 + PL_FIELD[r];
        }
        // (a place reached through a reference parameter: its referent)
        let t = LOCALS[l].ty;
        if PL_RKIND[r] == RK_LOCAL && t > 0 && TYPES[t].kind == TyKind::Ptr {
            if q != r && env_param(COL_F, i) {
                // (a closure's capture by reference: the captured variable,
                // what the env's views point into)
                var a = q;
                while PL_PARENT[a] != r {
                    a = PL_PARENT[a];
                }
                if env_ref_field(COL_F, PL_FIELD[a]) {
                    return i * 2 + 1;
                }
            }
            return i * 2;
        }
        -1
    }
}

// Masks m[lv] (p) and m[lv + 1] (`*p`) get the parameter roots of bitset
// words POOL[w..w + NW].
fn add_roots(w: i64, skip: i64, m: *i64, lv: i64) {
    unsafe {
        for q in 0..PL_COUNT {
            if (POOL[w + (q >> 6)] & (1 << (q & 63))) == 0 {
                continue;
            }
            let pr = root_param(q, skip);
            if pr < 0 {
                continue;
            }
            let i = pr >> 1;
            let bit = if i >= 63 { -1 } else { 1 << i };
            m[lv + (pr & 1)] |= bit;
        }
    }
}

// The function's result at node e (origin v, -1: none): an exit. Its
// levels' parameter roots go to the result's masks; the `&mut`
// parameters' slots at this exit, to the stores'.
pub fn col_result(e: i64, v: i64) {
    unsafe {
        if !COL_ON {
            return;
        }
        let f = COL_F;
        var ret: [i64; 4] = [0, 0, 0, 0];
        var sto: [i64; 4] = [0, 0, 0, 0];
        if v >= 0 && is_view_type(FNS[f].ret) {
            add_roots(v, -1, &ret[0], S_L1_P);
            add_roots(v + NW, -1, &ret[0], S_L2_P);
        }
        var target: [i64; 4] = [-1, -1, -1, -1];
        for i in 0..PARAM_LOCALS.count {
            let l = PARAM_LOCALS.data[i];
            if l < 0 || i >= FNS[f].param_count || !store_param(f, i) {
                continue;
            }
            let s = slot_of_local(l);
            if s < 0 {
                continue;
            }
            let off = slot_off(CUR, s);
            var m: [i64; 2] = [0, 0];
            add_roots(off, l, &m[0], 0);
            add_roots(off + NW, l, &m[0], 0);
            if i < 63 && (CAPTURES_STORED & (1 << i)) != 0 {
                // (a closure stored into: one capture may now view another,
                // its own roots among what was stored, col_stored)
                m[0] |= COL_STORED[0];
                m[1] |= COL_STORED[1];
            }
            for k in 0..4 {
                let add = if k == S_L1_P || k == S_L2_P { m[0] } else { m[1] };
                if (add & ~sto[k]) != 0 && target[k] < 0 {
                    target[k] = i;
                }
                sto[k] |= add;
            }
        }
        note_why(ret, COL_RET, 0, e, -1);
        note_why_sto(sto, e, target);
        for k in 0..4 {
            COL_RET[k] |= ret[k];
            COL_STO[k] |= sto[k];
        }
        if COL_DECLARED && !COL_REPORTED {
            check_declared(f, e, ret, sto, target);
        }
    }
}

// Whether a call of f (-1: through a fn value) in the walked function is
// a callable's (a closure's, a fn value's, or a function outside std: what
// a type parameter's bound lets the body call) whose result's views the
// parametric floor does not cover: a generic body that calls its `F`
// makes a result that may view anything the callable views (col_end).
pub fn col_callable(f: i64) -> bool {
    unsafe {
        if !COL_ON || FNS[COL_F].tmpl == 0 || ret_parametric(COL_F) == 0 {
            return false;
        }
        f < 0 || !within_std(FNS[f].module) || FNS[f].node > 0
            && (NODES[FNS[f].node].p & FN_CLOSURE) != 0
    }
}

// The origin v of a callable's result (col_callable): the parameters it
// views, at any level.
pub fn col_call(v: i64) {
    unsafe {
        var m: [i64; 4] = [0, 0, 0, 0];
        add_roots(v, -1, &m[0], S_L1_P);
        add_roots(v + NW, -1, &m[0], S_L2_P);
        COL_CALL |= m[0] | m[1] | m[2] | m[3];
    }
}

// The parameters (`p`, `*p` masks) whose views the walk stored into a
// closure (views::note_env_store): its own captures among them, which
// col_result otherwise leaves out of a target's stores.
static var COL_STORED: [i64; 2] = [0, 0];

pub fn col_stored(v: i64) {
    unsafe {
        if !COL_ON {
            return;
        }
        add_roots(v, -1, &COL_STORED[0], 0);
        add_roots(v + NW, -1, &COL_STORED[0], 0);
    }
}

// The why of the bits of m that are new (not in old): (mask base + k,
// parameter, node e, target).
fn note_why(m: [i64; 4], old: [i64; 4], base: i64, e: i64, target: i64) {
    unsafe {
        for k in 0..4 {
            let new = m[k] & ~old[k];
            if new == 0 {
                continue;
            }
            for i in 0..63 {
                if (new & (1 << i)) != 0 {
                    COL_WHY.push(base + k);
                    COL_WHY.push(i);
                    COL_WHY.push(e);
                    COL_WHY.push(target);
                }
            }
        }
    }
}

fn note_why_sto(sto: [i64; 4], e: i64, target: [i64; 4]) {
    unsafe {
        for k in 0..4 {
            var one: [i64; 4] = [0, 0, 0, 0];
            one[k] = sto[k];
            note_why(one, COL_STO, 4, e, target[k]);
        }
    }
}

// The walk of f ended: the summary its body makes (a parametric result
// takes its floor's masks, by its type; the floor's stores are joined).
// Its why is kept for query views.
pub fn col_end(f: i64) -> ViewSummary {
    unsafe {
        var s = empty_summary();
        if !COL_ON {
            return s;
        }
        for k in 0..4 {
            s.ret[k] = COL_RET[k];
            s.sto[k] = COL_STO[k];
        }
        if FNS[f].tmpl != 0 {
            let floor = floor_summary(f);
            for k in 0..4 {
                if ret_parametric(f) != 0 {
                    // (and what its callables' results view, as the body
                    // passes them on: col_call)
                    s.ret[k] = floor.ret[k] | COL_RET[k] & COL_CALL;
                }
                s.sto[k] |= floor.sto[k];
            }
        }
        keep_why(f);
        s
    }
}

// ---------------------------------------------------------------------------
// #[views] checked against the body (own.views)

fn sym_text(f: i64, i: i64) -> [u8] {
    unsafe { SYMS[NODES[child(FNS[f].node, i)].a].text }
}

// The first parameter bit of m beyond d: parameter * 2 (+ 1 for `*p`),
// -1.
fn first_excess(m: [i64; 4], d: [i64; 4]) -> i64 {
    for k in 0..4 {
        let x = m[k] & ~d[k];
        if x == 0 {
            continue;
        }
        for i in 0..63 {
            if (x & (1 << i)) != 0 {
                let star = if k == S_L1_STAR || k == S_L2_STAR { 1 } else { 0 };
                return i * 2 + star;
            }
        }
        return 126;
    }
    -1
}

fn put_decl(f: i64, stores: bool) {
    unsafe {
        let b = buf_new();
        if stores {
            buf_str(b, c"#[stores(");
            put_params(b, f, COL_DECL.sto);
        } else {
            buf_str(b, c"#[views(");
            put_params(b, f, COL_DECL.ret);
        }
        buf_str(b, c")]");
        own_bytes(buf_slice(b));
    }
}

fn put_root(f: i64, x: i64) {
    unsafe {
        let i = x >> 1;
        if i >= FNS[f].param_count {
            own_str(c"its parameters");
            return;
        }
        if (x & 1) != 0 {
            own_str(c"what '");
            own_bytes(sym_text(f, i));
            own_str(c"' holds ('*");
            own_bytes(sym_text(f, i));
            own_str(c"')");
        } else {
            own_str(c"'");
            own_bytes(sym_text(f, i));
            own_str(c"'");
        }
    }
}

// Appends the source text of node n (its first line, shortened).
pub fn buf_node_source(out: i64, n: i64) {
    unsafe {
        let start = NODES[n].start;
        var end = start;
        while end < NODES[n].end && SRC[end] != '\n' {
            end += 1;
        }
        if end - start > 48 {
            buf_bytes(out, SRC[start..start + 44]);
            buf_str(out, c"..");
            return;
        }
        buf_bytes(out, SRC[start..end]);
        if end < NODES[n].end {
            buf_str(out, c" ..");
        }
    }
}

fn check_declared(f: i64, e: i64, ret: [i64; 4], sto: [i64; 4], target: [i64; 4]) {
    unsafe {
        let name = SYMS[FNS[f].display].text;
        let rx = first_excess(ret, COL_DECL.ret);
        let sx = first_excess(sto, COL_DECL.sto);
        if rx < 0 && sx < 0 {
            return;
        }
        COL_REPORTED = true;
        own_begin(e, OWN_VIEWS);
        own_str(c"'");
        own_bytes(name);
        own_str(c"' is ");
        var inferred = buf_new();
        if rx >= 0 {
            put_decl(f, false);
            own_str(c" but returns a view of ");
            put_root(f, rx);
            own_str(c": '");
            let src = buf_new();
            buf_node_source(src, e);
            own_bytes(buf_slice(src));
            own_str(c"'");
            buf_str(inferred, c"views(");
            var all = COL_DECL.ret;
            for k in 0..4 {
                all[k] |= ret[k] | COL_RET[k];
            }
            put_params(inferred, f, all);
            buf_str(inferred, c")");
        } else {
            put_decl(f, true);
            own_str(c" but ");
            var t = -1;
            for k in 0..4 {
                if t < 0 && (sto[k] & ~COL_DECL.sto[k]) != 0 {
                    t = target[k];
                }
            }
            if t >= 0 && t < FNS[f].param_count {
                own_str(c"'");
                own_bytes(sym_text(f, t));
                own_str(c"'");
            } else {
                own_str(c"an `inout` parameter");
            }
            own_str(c" may hold a view of ");
            put_root(f, sx);
            own_str(c" when it returns");
            buf_str(inferred, c"stores(");
            var all = COL_DECL.sto;
            for k in 0..4 {
                all[k] |= sto[k] | COL_STO[k];
            }
            put_params(inferred, f, all);
            buf_str(inferred, c")");
        }
        own_help(c"callers rely on the declaration: change the body to keep to it, or declare what it does: #[");
        crate::front::own::diag::own_help_bytes(buf_slice(inferred));
        own_help(c"]");
        let cmd = buf_new();
        buf_str(cmd, c"volec query views ");
        buf_bytes(cmd, name);
        buf_str(cmd, c" --why");
        own_try(buf_slice(cmd));
        own_end();
    }
}

// ---------------------------------------------------------------------------
// The why-chains

static var WHY_ALL: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var WHY_AT: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

fn keep_why(f: i64) {
    unsafe {
        let start = WHY_ALL.count;
        for i in 0..COL_WHY.count {
            WHY_ALL.push(COL_WHY.data[i]);
        }
        WHY_AT.put(f + 1, start * 65536 + COL_WHY.count / 4 + 1);
    }
}

// The call a result expression e makes its value with (through `Ok(..)`,
// `Some(..)`, a block's tail, `?`), or 0.
fn result_call(e: i64) -> i64 {
    unsafe {
        var n = e;
        var steps = 0;
        while n != 0 && steps < 8 {
            steps += 1;
            let k = NODES[n].kind;
            if k == NodeKind::Call {
                return n;
            }
            if k == NodeKind::VariantLit && NODES[n].count == 1 {
                n = child(n, 0);
            } else if k == NodeKind::Block {
                n = NODES[n].a;
            } else if k == NodeKind::Try {
                n = NODES[n].y;
            } else {
                return 0;
            }
        }
        0
    }
}

fn put_short_pos(out: i64, pos: i64) {
    let tmp = buf_new();
    buf_position(tmp, pos);
    put_short_positions(out, buf_slice(tmp));
}

// The why of a parametric result (by its type, whatever the body does).
fn put_parametric_why(out: i64, f: i64) {
    unsafe {
        let p = ret_parametric(f);
        if p == 1 {
            buf_str(out, c"  why: a generic result made of its type parameters: the T values its arguments hold (by its type)\n");
        } else if p == 2 {
            buf_str(out, c"  why: a generic result that views T storage: its arguments' storage, level by level (by its type)\n");
        }
    }
}

// The why of f's summary into out: a line for each source (`  why:
// FILE:L:C 'SOURCE' ...`), indented. Nothing when f was not walked.
pub fn views_why(out: i64, f: i64) {
    unsafe {
        let at = WHY_AT.get(f + 1);
        if decl_of(f) != 0 {
            buf_str(out, c"  why: declared (#[views], #[stores]): callers use the declaration, and the body is checked against it\n");
            return;
        }
        if at == 0 {
            if !summary_inferred(f) && view_fn(f) {
                if ret_parametric(f) != 0 {
                    put_parametric_why(out, f);
                } else {
                    buf_str(out, c"  why: its body was not walked (it did not check): every parameter assumed\n");
                }
            }
            return;
        }
        let start = (at - 1) / 65536;
        let n = (at - 1) % 65536;
        put_parametric_why(out, f);
        let fin = summary_of(f);
        let fin_p = fin.ret[S_L1_P] | fin.ret[S_L2_P];
        let sto_p = fin.sto[S_L1_P] | fin.sto[S_L2_P];
        // (a line per parameter as the text rounds it: shown[group * 2 +
        // star], parameter bits)
        var shown: [i64; 4] = [0, 0, 0, 0];
        for j in 0..n {
            let o = start + j * 4;
            let k = WHY_ALL.data[o];
            let i = WHY_ALL.data[o + 1];
            let e = WHY_ALL.data[o + 2];
            let target = WHY_ALL.data[o + 3];
            if i >= FNS[f].param_count {
                continue;
            }
            // (only the bits the summary keeps after the filter)
            let m = if k < 4 { fin.ret[k] } else { fin.sto[k - 4] };
            if (m & (1 << i)) == 0 || k >= 4 && ret_parametric(f) != 0 {
                continue;
            }
            let star = k == S_L1_STAR || k == S_L2_STAR || k == 4 + S_L1_STAR
                || k == 4 + S_L2_STAR;
            let level2 = k == S_L2_P || k == S_L2_STAR || k == 4 + S_L2_P || k == 4 + S_L2_STAR;
            let group = if k >= 4 { 1 } else { 0 };
            let p_bits = if k >= 4 { sto_p } else { fin_p };
            let g = group * 2 + if star { 1 } else { 0 };
            if star && (p_bits & (1 << i)) != 0 || (shown[g] & (1 << i)) != 0 {
                continue;
            }
            shown[g] |= 1 << i;
            buf_str(out, c"  why: ");
            put_short_pos(out, NODES[e].start);
            if e == NODES[FNS[f].node].c || k >= 4 {
                buf_str(out, c" (when '");
                buf_bytes(out, SYMS[FNS[f].display].text);
                buf_str(out, c"' returns)");
            } else {
                buf_str(out, c" '");
                buf_node_source(out, e);
                buf_str(out, c"'");
            }
            if k >= 4 {
                buf_str(out, c": '");
                if target >= 0 && target < FNS[f].param_count {
                    buf_bytes(out, sym_text(f, target));
                } else {
                    buf_str(out, c"an `inout` parameter");
                }
                buf_str(out, c"' may hold views of ");
            } else if level2 {
                buf_str(out, c": the views it points to view ");
            } else {
                buf_str(out, c": views ");
            }
            if star {
                buf_str(out, c"what '");
                buf_bytes(out, sym_text(f, i));
                buf_str(out, c"' holds");
            } else {
                buf_str(out, c"'");
                buf_bytes(out, sym_text(f, i));
                buf_str(out, c"'");
            }
            let call = if k < 4 { result_call(e) } else { 0 };
            if call != 0 && NODES[call].x > 0 {
                let g = NODES[call].x - 1;
                buf_str(out, c", through '");
                buf_bytes(out, SYMS[FNS[g].display].text);
                buf_str(out, c"' (");
                summary_text(out, g, summary_of(g));
                buf_str(out, c")");
            }
            buf_byte(out, '\n');
        }
    }
}

// ---------------------------------------------------------------------------
// The driver

// Whether function f is walked: it has a checked body (not C's, not a
// template).
pub fn walkable(f: i64) -> bool {
    unsafe { f >= 0 && f < FN_COUNT && !FNS[f].is_extern && body_walked(f) }
}

fn self_edge(v: i64) -> bool {
    unsafe {
        for e in EDGE_START.data[v]..EDGE_START.data[v + 1] {
            if (EDGES.data[e] >> 2) == v {
                return true;
            }
        }
        false
    }
}

// Where a recursive component's member starts: its floor's stores, and
// its result's when it is parametric; else views().
fn start_summary(f: i64) -> ViewSummary {
    unsafe {
        if FNS[f].tmpl == 0 {
            return empty_summary();
        }
        var s = floor_summary(f);
        if s.top {
            for k in 0..4 {
                s.ret[k] = 0;
            }
            s.top = false;
        }
        s
    }
}

// Rounds a recursive component is walked at most before its undecided
// summaries are taken as top.
const MAX_ROUNDS: i64 = 24;

// Walks f once, its findings kept; its summary stored.
fn walk_kept(f: i64, all: bool) {
    unsafe {
        if !all && !view_fn(f) {
            return;
        }
        let s = walk_fn(f, 0);
        own_flush();
        if view_fn(f) && decl_of(f) == 0 {
            summary_store(f, s);
        }
    }
}

// Every walkable function walked, callees first (all false: only those
// with view-carrying summaries, for the summaries alone: `query`,
// --print-views without --values). Rounds of recursive components.
pub static var SCC_ROUNDS: i64 = 0;

pub fn infer_summaries(all: bool) {
    unsafe {
        if COMPONENT == 0 as *i64 || GRAPH_FNS > FN_COUNT {
            infer_effects();
        }
        let size = GRAPH_SIZE;
        let n = GRAPH_FNS;
        // (the nodes by component, components in completion order:
        // counting sort)
        var ncomp = 0;
        for v in 0..size {
            if COMPONENT[v] > ncomp {
                ncomp = COMPONENT[v];
            }
        }
        let start = crate::base::alloc_array::<i64>(ncomp + 2);
        for v in 0..size {
            start[COMPONENT[v] + 1] += 1;
        }
        for c in 0..ncomp + 1 {
            start[c + 1] += start[c];
        }
        let order = crate::base::alloc_array::<i64>(size + 1);
        let fill = crate::base::alloc_array::<i64>(ncomp + 2);
        for v in 0..size {
            let c = COMPONENT[v];
            order[start[c] + fill[c]] = v;
            fill[c] += 1;
        }
        for c in 0..ncomp + 1 {
            let a = start[c];
            let b = start[c + 1];
            if a == b {
                continue;
            }
            // (iterated: a recursive component with a member whose
            // summary is inferred and can carry views)
            var iterate = false;
            for k in a..b {
                let f = order[k];
                if f < n && decl_of(f) == 0 && walkable(f) && view_fn(f)
                    && (b - a > 1 || self_edge(f)) {
                    iterate = true;
                }
            }
            if !iterate {
                for k in a..b {
                    let f = order[k];
                    if f < n && walkable(f) {
                        walk_kept(f, all);
                    }
                }
                continue;
            }
            // (a recursive component: from the floor, until nothing grows)
            for k in a..b {
                let f = order[k];
                if f < n && walkable(f) && view_fn(f) && decl_of(f) == 0 {
                    summary_store(f, start_summary(f));
                }
            }
            var round = 0;
            loop {
                var changed = false;
                for k in a..b {
                    let f = order[k];
                    if f >= n || !walkable(f) || !view_fn(f) {
                        continue;
                    }
                    let s = walk_fn(f, round);
                    own_discard();
                    if decl_of(f) == 0 {
                        let old = crate::front::own::summary::summary_stored(f);
                        let j = join_summary(old, s);
                        if !same_summary(j, old) {
                            summary_store(f, j);
                            changed = true;
                        }
                    }
                }
                round += 1;
                SCC_ROUNDS += 1;
                if !changed {
                    break;
                }
                if round >= MAX_ROUNDS {
                    for k in a..b {
                        let f = order[k];
                        if f < n && walkable(f) && view_fn(f) && decl_of(f) == 0 {
                            summary_store(f, top_summary());
                        }
                    }
                    break;
                }
            }
            // (the findings: one more walk of each, against the summaries
            // of the last round)
            for k in a..b {
                let f = order[k];
                if f >= n || !walkable(f) || !all && !view_fn(f) {
                    continue;
                }
                walk_fn(f, round);
                own_flush();
            }
        }
        // (functions made after the effects' graph: none, usually)
        for f in n..FN_COUNT {
            if walkable(f) {
                walk_kept(f, all);
            }
        }
    }
}

// ---------------------------------------------------------------------------
// --print-views

pub static var PRINT_VIEWS: bool = false;

// Every function's summary, a line each (`name: views(...)`), in FNS
// order: the program's functions, instances and closures (not templates,
// not std's own); like --print-effects.
pub fn print_views(out: i64) {
    unsafe {
        for f in 0..FN_COUNT {
            if FNS[f].generic > 0 || FNS[f].node == 0
                || FNS[f].module == crate::front::modules::STD_MODULE {
                continue;
            }
            if NODES[FNS[f].node].kind != NodeKind::Fn {
                continue;
            }
            buf_bytes(out, SYMS[FNS[f].display].text);
            buf_str(out, c": ");
            summary_text(out, f, summary_of(f));
            buf_str(out, c"\n");
        }
    }
}
