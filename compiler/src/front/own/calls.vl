// Calls (0.17, docs/design/value-semantics.md §4 step 4, "Calls"). T2 owns
// this file.
//
// The walk evaluates a call's arguments left to right as pending entries
// (state.vl PEND: a loan `&place`, a reference passed on, a view, a
// value); then on_call, in order:
// 1. an argument a later one changed (G2: `take(v.as_slice(), grow(&mut
//    v))`, a `&mut self` receiver changed by its own argument) is a
//    conflict at the later one;
// 2. an argument overlapping one the call writes is a conflict (`f(&mut a,
//    &a)`, `v.extend_from_slice(v.as_slice())`); a `&mut self` receiver is
//    two-phase: reads of it in the arguments are fine (`v.push(v.len())`);
// 3. what the call writes invalidates the views of it (not the slot it is
//    written through, nor that slot's parents);
// 4. the callee's summary (infer::summary_at_call: declared, inferred,
//    the parametric floor, or top, through the type filter; the join of the
//    address-taken functions' for a call through a fn value) gives what its
//    `&mut` arguments' referents come to hold (stores), and the result's
//    origin;
// 5. a callee whose effects include `global` invalidates the views of
//    statics (own.static at their use).
// A top summary (one region: every level from every argument) marks what
// it gives (state::mark_place): conflicts that come from it are warnings
// (§7 V3).

use crate::base::{SRC, SYMS, buf_bytes, buf_new, buf_slice, buf_str};
use crate::front::ast::{NODES, NodeKind, child};
use crate::front::check::{LOCALS, Res};
use crate::front::closures::{CAPTURE_LIST, CLOSURES, closure_of_type};
use crate::front::effects::{EFF_GLOBAL, effects_top, fn_effects};
use crate::front::modules::within_std;
use crate::front::own::diag::{
    OWN_CONFLICT, OWN_ESCAPE, OWN_STATIC, own_begin, own_end, own_help, own_pos, own_soft, own_str,
    own_sym, own_try,
};
use crate::front::own::infer::{col_callable, deep, holds, summary_at_call};
use crate::front::own::kinds::{is_view_type, view_elem};
use crate::front::own::state::{
    CUR, NSLOT, NW, PE, PEND, PE_BY, PE_INVALID, PE_NODE, PE_OV, PE_PLACE, PK_MUT, PK_MUT_VIEW,
    PK_NONE, PK_RAW, PK_RESERVE, PK_SHARED, PK_VIEW, PL_COUNT, PL_PARENT, PL_RID, PL_RKIND,
    POOL_TOP, RK_LOCAL, RK_STATIC, STATIC_MASK, at, clear_bit, get_bit, is_empty, l1, l2,
    local_place, mark_place, new_ov, or_expanded, or_into, ov_hits, ov_or, root_of, set_bit,
    slot_of_local, slot_off,
};
use crate::front::own::summary::{
    S_L1_P, S_L1_STAR, S_L2_P, S_L2_STAR, ViewSummary, captures_by_ref, env_param, store_param,
};
use crate::front::own::views::{
    H_CALL, H_GLOBAL, QUIET, close_mask, env_slot, first_place, hidden_place, invalidate,
    note_env_store, own_place, own_src, seen,
};
use crate::front::own::walk::CUR_F;
use crate::front::threads::is_interior_type;
use crate::front::types::{FNS, STATICS, STRUCTS, TYPES, TyKind, struct_field};

// Whether origin o holds the mark place (it came in part from a top
// summary).
pub fn any_mark(o: i64) -> bool {
    unsafe {
        if o < 0 {
            return false;
        }
        let p = mark_place();
        p >= 0 && (get_bit(l1(o), p) || get_bit(l2(o), p))
    }
}

fn set_mark(o: i64) {
    unsafe {
        let p = mark_place();
        if p >= 0 {
            set_bit(l1(o), p);
            set_bit(l2(o), p);
        }
    }
}

fn is_mut_kind(k: i64) -> bool {
    k == PK_MUT || k == PK_RESERVE || k == PK_MUT_VIEW
}

fn reporting(n: i64) -> bool {
    unsafe { !QUIET && !seen(n) }
}

// The slot an argument goes through (a slot local, a place under one, a
// reference passed on), or -1.
fn arg_slot(e: i64) -> i64 {
    unsafe {
        let k = NODES[e].kind;
        if k == NodeKind::Ident && NODES[e].res == Res::Local {
            return crate::front::own::state::slot_of_local(NODES[e].y);
        }
        if k == NodeKind::Index || k == NodeKind::Cast || k == NodeKind::FieldAccess
            || k == NodeKind::TupleField {
            return arg_slot(NODES[e].a);
        }
        if k == NodeKind::Unary {
            return arg_slot(NODES[e].b);
        }
        if k == NodeKind::Call && NODES[e].count > 0 && is_view_type(NODES[e].ty) {
            // (a view a method makes of its receiver: a reborrow of it,
            // views::root_slot)
            return arg_slot(child(e, 0));
        }
        -1
    }
}

// Whether the path of expression e goes through a pointer, a reference or
// a slice (its place is inside what something points to).
fn path_derefs(e: i64) -> bool {
    unsafe {
        let k = NODES[e].kind;
        if k == NodeKind::FieldAccess {
            return NODES[e].y == 1 || path_derefs(NODES[e].a);
        }
        if k == NodeKind::TupleField {
            return path_derefs(NODES[e].a);
        }
        if k == NodeKind::Unary {
            return NODES[e].op == crate::front::lexer::Tok::Star || path_derefs(NODES[e].b);
        }
        if k == NodeKind::Index {
            let bt = NODES[NODES[e].a].ty;
            if bt > 0 && (TYPES[bt].kind == TyKind::Ptr || TYPES[bt].kind == TyKind::Slice) {
                return true;
            }
            return path_derefs(NODES[e].a);
        }
        false
    }
}

// The mask of what pending entry e may write: what its level 1 points into,
// expanded, and the paths through references that reach it. (0.25) A
// closure, called (its env `&g`) or passed (`g`, `&g`, `|| ..`): the
// captures it changes, its inout accesses (conventions.md §5.4), and no
// more: its let captures are read.
fn write_mask(e: i64) -> i64 {
    unsafe {
        let m = new_ov();
        let t = NODES[PEND.data[e + PE_NODE]].ty;
        let inner = if t > 0 && TYPES[t].kind == TyKind::Ptr { TYPES[t].a } else { t };
        let c = crate::front::closures::closure_of_type(inner) - 1;
        if c >= 0 {
            let cl = crate::front::closures::CLOSURES[c];
            for j in 0..cl.capture_count {
                if crate::front::closures::CAPTURE_LIST.data[cl.captures + 2 * j + 1] == 2 {
                    let p = crate::front::own::state::local_place(
                        crate::front::closures::CAPTURE_LIST.data[cl.captures + 2 * j]);
                    if p >= 0 {
                        or_into(at(m), &crate::front::own::state::PL_MASK[p * NW]);
                    }
                }
            }
            close_mask(at(m));
            return m;
        }
        or_expanded(at(m), l1(PEND.data[e + PE_OV]));
        // (0.25) `&c` of a value holding an inout access (a struct with an
        // inout field): the callee may write through it, what c views at
        // level 2
        if t > 0 && TYPES[t].kind == TyKind::Ptr
            && crate::front::own::views::holds_mut(TYPES[t].a, 0) {
            or_expanded(at(m), l2(PEND.data[e + PE_OV]));
        }
        close_mask(at(m));
        m
    }
}

// ---------------------------------------------------------------------------
// Summaries applied (the type filter is in them: infer::summary_at_call)

// dst gets the levels argument j (origin o) gives through the summary
// masks m (S_* indexed).
fn apply(dst: i64, o: i64, j: i64, m: *i64) {
    unsafe {
        let bit = if j >= 63 { -1 } else { 1 << j };
        if (m[S_L1_P] & bit) != 0 {
            or_into(l1(dst), l1(o));
        }
        if (m[S_L1_STAR] & bit) != 0 {
            or_into(l1(dst), l2(o));
        }
        if (m[S_L2_P] & bit) != 0 {
            or_into(l2(dst), l2(o));
        }
        if (m[S_L2_STAR] & bit) != 0 {
            or_into(l2(dst), l2(o));
        }
    }
}

// (0.25) The type filter per place: a call's result of type rt, origin o,
// whose views are of E (kinds::view_elem) points at level 1 only into
// storage that can hold an E, so a loan on a whole local whose type holds
// no E, by itself or through its views, is dropped (a `[u8]` made by a
// closure an iterator over a `Vec<i64>` calls views none of the Vec).
fn type_narrow(o: i64, rt: i64) {
    unsafe {
        let e = view_elem(rt);
        if e <= 0 {
            return;
        }
        for q in 0..PL_COUNT {
            if PL_PARENT[q] >= 0 || PL_RKIND[q] != RK_LOCAL || !get_bit(l1(o), q) {
                continue;
            }
            let l = PL_RID[q];
            if l < 0 {
                continue;
            }
            let t = LOCALS[l].ty;
            if t > 0 && !holds(t, e) && !deep(t, e) {
                clear_bit(l1(o), q);
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The call

// Call n of function f (-1: through a fn value), its arguments pending at
// state::PEND[base..] (PE words each); dst (-1: none) gets the result's
// views.
pub fn on_call(n: i64, f: i64, base: i64, dst: i64) {
    unsafe {
        crate::front::own::observe::at(n);
        let end = PEND.count;
        let mark = POOL_TOP;
        // (whether a written argument's referent holds views: the stores)
        var stores = false;
        // 1. Arguments a later one changed.
        var e = base;
        while e < end {
            if PEND.data[e + PE_INVALID] != 0 {
                changed_by_later(e, n);
            }
            e += PE;
        }
        // 2. Arguments overlapping one the call writes; 3. what it writes.
        var a = base;
        while a < end {
            let ka = PEND.data[a];
            if is_mut_kind(ka) && PEND.data[a + PE_OV] >= 0 {
                let m = write_mask(a);
                var b = base;
                while b < end {
                    let kb = PEND.data[b];
                    let ob = PEND.data[b + PE_OV];
                    if b != a && kb != PK_NONE && kb != PK_RAW && ob >= 0
                        && !(is_mut_kind(kb) && b < a) && ov_hits(ob, at(m)) {
                        overlap(a, b, m);
                    } else if b < a && is_mut_kind(kb) && ob >= 0 && ov_hits(ob, at(m)) {
                        // (0.25) an earlier written argument that b's own pass
                        // missed: what a writes reaches what b views (`run(&g,
                        // &n)`, g a closure reading n)
                        let top = POOL_TOP;
                        let mb = write_mask(b);
                        if !ov_hits(PEND.data[a + PE_OV], at(mb)) {
                            overlap(a, b, m);
                        }
                        POOL_TOP = top;
                    }
                    b += PE;
                }
                if NSLOT > 0 || base > 0 {
                    invalidate(at(m), n, H_CALL, arg_slot(PEND.data[a + PE_NODE]), base);
                }
                POOL_TOP = m;
                if !stores && end - base > PE && NSLOT > 0 {
                    stores = arg_slot(PEND.data[a + PE_NODE]) >= 0;
                }
            }
            a += PE;
        }
        // (0.25) statics lent to a callee that reaches them by name
        if end > base && !is_empty(STATIC_MASK) {
            static_args(n, f, base, end);
        }
        // 5. Statics (before the stores and the result: they do not hold
        // views of statics that the call may have changed).
        if (NSLOT > 0 || base > 0) && !is_empty(STATIC_MASK) {
            let eff = if f >= 0 { fn_effects(f) } else { effects_top() };
            if (eff.bits & EFF_GLOBAL) != 0 {
                global_call(n, base);
            }
        }
        // (0.25) A closure given to the call (or called: its env) may
        // keep anything the other arguments view in what it captures by
        // reference, whatever the summary says (closure_stores)
        if NSLOT > 0 && end > base {
            var c = base;
            while c < end {
                if closure_arg(PEND.data[c + PE_NODE]) && PEND.data[c + PE_OV] >= 0 {
                    closure_stores(c, base, end);
                }
                c += PE;
            }
        }
        let rt = NODES[n].ty;
        // (0.25) a copy of an element the receiver keeps (drops::
        // borrowed_call: `v.get(i)` of a Vec<String>): its storage is the
        // receiver's, a view of all the receiver views
        if dst >= 0 && end > base && !is_view_type(rt)
            && crate::front::own::drops::borrowed_call(n) {
            deep_into(dst, PEND.data[base + PE_OV]);
        }
        let result = dst >= 0 && end > base && is_view_type(rt);
        // (a closure's captures written: its env given to its function, a
        // closure given to a function that calls it; store_captures)
        var captures = false;
        if f >= 0 && NSLOT > 0 {
            var a1 = base;
            var j1 = 0;
            while a1 < end {
                if closure_target(f, j1, PEND.data[a1 + PE_NODE]) {
                    captures = true;
                }
                a1 += PE;
                j1 += 1;
            }
        }
        if f >= 0 && within_std(FNS[f].module) && NSLOT > 0 {
            interior_stores(base, end);
        }
        if !stores && !result && !captures {
            return;
        }
        let s = summary_at_call(n, f);
        if FNS[CUR_F].tmpl != 0 && within_std(FNS[CUR_F].module)
            && (f < 0 || !within_std(FNS[f].module)) {
            lent_escape(n, f, base, end, s);
        }
        if captures && !s.top {
            var a3 = base;
            var j3 = 0;
            while a3 < end {
                if closure_target(f, j3, PEND.data[a3 + PE_NODE]) {
                    store_captures(a3, base, end, s.sto);
                }
                a3 += PE;
                j3 += 1;
            }
        }
        // 4. The stores into `&mut` arguments' referents (std's are pinned
        // by T4: an unpinned one assumes none, until its legacy `*T`
        // parameters are `&T` or `&mut T`)
        if stores && !(s.top && f >= 0 && within_std(FNS[f].module)) {
            var a2 = base;
            while a2 < end {
                if is_mut_kind(PEND.data[a2]) {
                    store(a2, base, end, s.sto, s.top);
                }
                a2 += PE;
            }
        }
        POOL_TOP = mark;
        // 6. The result.
        if result {
            // (a callable result in a generic body: what it views is kept
            // apart for the parametric result, infer::col_call)
            let callable = col_callable(f);
            let into = new_ov();
            var b = base;
            var j = 0;
            while b < end {
                let o = PEND.data[b + PE_OV];
                if o >= 0 && PEND.data[b] != PK_NONE {
                    apply(into, o, j, &s.ret[0]);
                }
                b += PE;
                j += 1;
            }
            type_narrow(into, rt);
            if callable {
                crate::front::own::infer::col_call(into);
            }
            or_into(l1(dst), l1(into));
            or_into(l2(dst), l2(into));
            POOL_TOP = into;
            if s.top && !is_empty(l1(dst)) {
                set_mark(dst);
            }
            // (0.25) and what a closure among the arguments views, at any
            // depth: its captures (a closure called, its env); a declared
            // summary (#[views], checked against the body) says it all
            var c = base;
            while c < end && !s.declared {
                let cn = PEND.data[c + PE_NODE];
                let co = PEND.data[c + PE_OV];
                if closure_arg(cn) && co >= 0 {
                    if NODES[cn].ty > 0 && TYPES[NODES[cn].ty].kind == TyKind::Ptr {
                        // (an env, `&c`: its level 1 is the loan on c, not
                        // what the closure gives; its captures are level 2)
                        or_into(l1(dst), l2(co));
                        or_into(l2(dst), l2(co));
                    } else {
                        // (its captures' loans, at level 1 only: the type
                        // filter below drops those that cannot hold the
                        // result's views)
                        or_into(l1(dst), l1(co));
                        or_into(l1(dst), l2(co));
                        or_into(l2(dst), l2(co));
                    }
                }
                c += PE;
            }
            filter_places(dst, rt);
        }
    }
}

// (0.25) The type filter place by place (§2.4): a result of type rt whose
// views are of element E points at level 1 only into storage that can
// hold an E, so a loan on a local whose own storage cannot (`order:
// Vec<i64>` for a Vec<[u8]> result) is dropped. Paths through a reference
// (DEREF), statics and the parameters' roots are kept.
fn filter_places(dst: i64, rt: i64) {
    unsafe {
        let e = crate::front::own::kinds::view_elem(rt);
        if e <= 0 || dst < 0 {
            return;
        }
        for q in 0..PL_COUNT {
            if !get_bit(l1(dst), q) {
                continue;
            }
            var through = false;
            var a = q;
            while a >= 0 {
                if crate::front::own::state::is_deref_place(a) {
                    through = true;
                }
                a = crate::front::own::state::PL_PARENT[a];
            }
            let r = root_of(q);
            let rk = crate::front::own::state::PL_RKIND[r];
            if through || rk != crate::front::own::state::RK_LOCAL
                && rk != crate::front::own::state::RK_TEMP {
                continue;
            }
            let rid = crate::front::own::state::PL_RID[r];
            let t = if rk == crate::front::own::state::RK_TEMP { NODES[rid].ty }
                else { crate::front::check::LOCALS[rid].ty };
            if t > 0 && TYPES[t].kind != TyKind::Ptr && !crate::front::own::infer::holds(t, e) {
                clear_bit(l1(dst), q);
            }
        }
    }
}

// (0.25) Whether argument node e is a closure, or a pointer to one (the env
// of a closure called): its origin is what its captures view.
fn closure_arg(e: i64) -> bool {
    unsafe { closure_type(NODES[e].ty) }
}

// (0.25) Whether type t is a closure's, or a pointer to one.
fn closure_type(t0: i64) -> bool {
    unsafe {
        var t = t0;
        if t > 0 && TYPES[t].kind == TyKind::Ptr {
            t = TYPES[t].a;
        }
        crate::front::closures::closure_of_type(t) != 0
    }
}

// (0.25) dst gets, at both levels, everything origin o views at any depth.
pub fn deep_into(dst: i64, o: i64) {
    unsafe {
        if dst < 0 || o < 0 {
            return;
        }
        or_into(l1(dst), l1(o));
        or_into(l1(dst), l2(o));
        or_into(l2(dst), l1(o));
        or_into(l2(dst), l2(o));
    }
}

// (0.25) Pending closure c (an argument, or the env of the closure called)
// may store what the other arguments view into the locals it captures by
// reference (the places at its level 1): no summary says what its body
// does with them, so each of those locals' slots gets all of it, at both
// levels, minus loans on the local itself.
fn closure_stores(c: i64, base: i64, end: i64) {
    unsafe {
        let oc = PEND.data[c + PE_OV];
        let u = new_ov();
        var b = base;
        while b < end {
            let o = PEND.data[b + PE_OV];
            if b != c && o >= 0 && PEND.data[b] != PK_NONE {
                deep_into(u, o);
            }
            b += PE;
        }
        // (the env of a closure called, `&c`: its captures are at level 2,
        // level 1 is the loan on c)
        let at_ty = NODES[PEND.data[c + PE_NODE]].ty;
        let env = at_ty > 0 && TYPES[at_ty].kind == TyKind::Ptr;
        let caps = if env { l2(oc) } else { l1(oc) };
        // and what the closure itself views: it may store one capture into
        // another (`|i| out.push(s)`)
        if env {
            or_into(l1(u), l2(oc));
            or_into(l2(u), l2(oc));
        } else {
            deep_into(u, oc);
        }
        if is_empty(l1(u)) {
            POOL_TOP = u;
            return;
        }
        for p in 0..PL_COUNT {
            if !get_bit(caps, p) || root_of(p) != p {
                continue;
            }
            let s = crate::front::own::state::slot_of_place(p);
            if s < 0 || closure_type(crate::front::check::LOCALS[
                crate::front::own::state::SLOT_LOCAL.data[s]].ty) {
                continue;
            }
            let t = new_ov();
            ov_or(t, u);
            for q in 0..PL_COUNT {
                if root_of(q) == p {
                    clear_bit(l1(t), q);
                    clear_bit(l2(t), q);
                }
            }
            crate::front::own::views::store_deep(s, t);
            crate::front::own::views::store_through_loans(s, t, 0);
            POOL_TOP = t;
        }
        POOL_TOP = u;
    }
}

// Pending entry a (written by the call) stores the other arguments' views
// as the summary's stores say (sto, top: a top summary).
fn store(a: i64, base: i64, end: i64, sto: [i64; 4], top: bool) {
    unsafe {
        let arg = PEND.data[a + PE_NODE];
        let ts = arg_slot(arg);
        if ts < 0 {
            return;
        }
        let at_ty = NODES[arg].ty;
        var rt = if at_ty > 0 && TYPES[at_ty].kind == TyKind::Ptr { TYPES[at_ty].a } else { at_ty };
        // (0.25) through a slice lent as a view (`inout [T]` passed on, not
        // `&s` of a slice variable, which may be replaced), what is stored
        // goes into its elements: a `[(i64, i64)]` sorted with a closure
        // holds no views
        if PEND.data[a] == PK_MUT_VIEW && rt > 0 && TYPES[rt].kind == TyKind::Slice {
            rt = TYPES[rt].a;
        }
        if rt <= 0 || !is_view_type(rt) {
            return;
        }
        let tmp = new_ov();
        var b = base;
        var j = 0;
        while b < end {
            let o = PEND.data[b + PE_OV];
            if b != a && o >= 0 && PEND.data[b] != PK_NONE {
                apply(tmp, o, j, &sto[0]);
            }
            b += PE;
            j += 1;
        }
        if is_empty(l1(tmp)) && is_empty(l2(tmp)) {
            POOL_TOP = tmp;
            return;
        }
        // (minus loans on the referent itself)
        let pa = PEND.data[a + PE_PLACE];
        if pa >= 0 {
            let r = root_of(pa);
            for q in 0..PL_COUNT {
                if root_of(q) == r {
                    clear_bit(l1(tmp), q);
                    clear_bit(l2(tmp), q);
                }
            }
        }
        if top {
            set_mark(tmp);
        }
        crate::front::own::views::note_env_store(ts, tmp);
        let off = slot_off(CUR, ts);
        let through = NODES[arg].kind == NodeKind::Ident || PEND.data[a] == PK_MUT_VIEW
            || NODES[arg].kind == NodeKind::Unary && path_derefs(NODES[arg].b);
        if through {
            // (what the slot points to now holds them)
            or_into(l2(off), l1(tmp));
            or_into(l2(off), l2(tmp));
        } else {
            or_into(l1(off), l1(tmp));
            or_into(l2(off), l2(tmp));
        }
        // (0.25) and what the slot holds loans on: `r = &mut v; r.push(w)`
        crate::front::own::views::store_through_loans(ts, tmp, 0);
        POOL_TOP = tmp;
    }
}

// Whether argument j (node arg) of a call of f holds a closure whose
// captures the call may store into: the env of a call of the closure's
// own function, or a closure given to a parameter that stores go into
// (summary::store_param: a generic function that calls it).
fn closure_target(f: i64, j: i64, arg: i64) -> bool {
    unsafe {
        if j == 0 && env_param(f, 0) {
            return true;
        }
        var t = NODES[arg].ty;
        if t <= 0 || closure_of_type(t) == 0 {
            return false;
        }
        j < FNS[f].param_count && store_param(f, j)
    }
}

// Pending entry a, a closure (its env or its value) the call may store
// into as the summary's stores say (sto): every argument's views, the
// closure's own among them (it may store one capture into another), go to
// the variables it captures by reference: their slots when they are this
// function's; else this closure's env, when it captures them too (a
// nested closure); and the closure's own slot.
fn store_captures(a: i64, base: i64, end: i64, sto: [i64; 4]) {
    unsafe {
        let arg = PEND.data[a + PE_NODE];
        var t = NODES[arg].ty;
        if t > 0 && TYPES[t].kind == TyKind::Ptr {
            t = TYPES[t].a;
        }
        let c = closure_of_type(t) - 1;
        if c < 0 {
            return;
        }
        let tmp = new_ov();
        var b = base;
        var j = 0;
        while b < end {
            let o = PEND.data[b + PE_OV];
            if o >= 0 && PEND.data[b] != PK_NONE {
                apply(tmp, o, j, &sto[0]);
            }
            b += PE;
            j += 1;
        }
        if is_empty(l1(tmp)) && is_empty(l2(tmp)) {
            POOL_TOP = tmp;
            return;
        }
        let env = env_slot();
        for k in 0..CLOSURES[c].capture_count {
            if CAPTURE_LIST.data[CLOSURES[c].captures + 2 * k + 1] == 0 {
                continue;
            }
            let l = CAPTURE_LIST.data[CLOSURES[c].captures + 2 * k];
            let s = slot_of_local(l);
            if s >= 0 {
                let off = slot_off(CUR, s);
                let r = local_place(l);
                let m = new_ov();
                or_into(l1(m), l1(tmp));
                or_into(l2(m), l2(tmp));
                // (minus loans on the variable itself)
                if r >= 0 {
                    for q in 0..PL_COUNT {
                        if root_of(q) == r {
                            clear_bit(l1(m), q);
                            clear_bit(l2(m), q);
                        }
                    }
                }
                or_into(l1(off), l1(m));
                or_into(l2(off), l2(m));
                POOL_TOP = m;
            } else if env >= 0 && captures_by_ref(CUR_F, l) {
                let off = slot_off(CUR, env);
                note_env_store(env, tmp);
                or_into(l2(off), l1(tmp));
                or_into(l2(off), l2(tmp));
            }
        }
        // (a parameter of the same closure type, of which the argument may
        // be a copy, `var g = f`: the same closure, so the same captures)
        for i in 0..crate::front::own::walk::PARAM_LOCALS.count {
            let pl = crate::front::own::walk::PARAM_LOCALS.data[i];
            if pl < 0 || i >= FNS[CUR_F].param_count
                || crate::front::types::fn_param(CUR_F, i) != t {
                continue;
            }
            let ps = slot_of_local(pl);
            if ps >= 0 && ps != arg_slot(arg) {
                let off = slot_off(CUR, ps);
                note_env_store(ps, tmp);
                or_into(l1(off), l1(tmp));
                or_into(l2(off), l2(tmp));
            }
        }
        let own = arg_slot(arg);
        if own >= 0 {
            let off = slot_off(CUR, own);
            note_env_store(own, tmp);
            if own == env {
                or_into(l2(off), l1(tmp));
            } else {
                or_into(l1(off), l1(tmp));
            }
            or_into(l2(off), l2(tmp));
        }
        POOL_TOP = tmp;
    }
}

// Whether type t lends what it locks (std's Mutex and what holds one; a
// MutexGuard's pointer to one): a function of it hands its callable a
// reference into memory that changes through shared references.
fn lends_interior(t: i64) -> bool {
    unsafe {
        if t <= 0 {
            return false;
        }
        let u = if TYPES[t].kind == TyKind::Ptr { TYPES[t].a } else { t };
        if is_interior_type(u) {
            return true;
        }
        if u > 0 && TYPES[u].kind == TyKind::Struct {
            let st = TYPES[u].a;
            for i in 0..STRUCTS[st].field_count {
                let ft = (*struct_field(st, i)).ty;
                if ft > 0 && TYPES[ft].kind == TyKind::Ptr && is_interior_type(TYPES[ft].a) {
                    return true;
                }
            }
        }
        false
    }
}

// Call n, in an instance of std's (Mutex::with: CUR_F), of the program's
// callable f (summary s): a reference the instance makes from a raw
// pointer into data it locks (`&*p`) must not be viewed by f's result nor
// stored by f, as the lock is released when the instance returns: own.escape
// at the call that made the instance.
fn lent_escape(n: i64, f: i64, base: i64, end: i64, s: ViewSummary) {
    unsafe {
        let origin = FNS[CUR_F].origin;
        if origin <= 0 {
            return;
        }
        var lends = false;
        for i in 0..FNS[CUR_F].param_count {
            if lends_interior(crate::front::types::fn_param(CUR_F, i)) {
                lends = true;
            }
        }
        if !lends {
            return;
        }
        var b = base;
        var j = 0;
        while b < end && j < 63 {
            let arg = PEND.data[b + PE_NODE];
            let t = NODES[arg].ty;
            let o = PEND.data[b + PE_OV];
            let raw = PEND.data[b] == PK_RAW || o < 0 || is_empty(l1(o)) && is_empty(l2(o));
            if raw && !(j == 0 && env_param(f, 0)) && t > 0 && TYPES[t].kind == TyKind::Ptr
                && (f < 0 || j < FNS[f].param_count) {
                let bit = 1 << j;
                let ret = (s.ret[S_L1_P] & bit) != 0;
                if ret || (s.sto[S_L1_P] & bit) != 0 {
                    if seen(origin) {
                        return;
                    }
                    own_begin(origin, OWN_ESCAPE);
                    if f < 0 {
                        own_str(if ret { c"the function's result views its argument" }
                            else { c"the function stores a view of its argument" });
                    } else {
                        let pl = NODES[child(FNS[f].node, j)].x;
                        own_str(if ret { c"the closure's result views " }
                            else { c"the closure stores a view of " });
                        if pl >= 0 {
                            own_sym(LOCALS[pl].name);
                        } else {
                            own_str(c"its argument");
                        }
                    }
                    own_str(c", the data ");
                    own_sym(NODES[FNS[CUR_F].node].a);
                    own_str(c" locks: the lock is released when ");
                    own_sym(NODES[FNS[CUR_F].node].a);
                    own_str(c" returns, and the view would outlive it");
                    own_help(c"copy what you need out inside the closure ('.to_vec()', an element), or do the work there");
                    own_end();
                    return;
                }
            }
            b += PE;
            j += 1;
        }
    }
}

// A call of std's with an argument that locks data holding views (a
// `Mutex<Vec<[u8]>>`, interior: changed through a shared reference, which
// no summary's stores can say): the closures given to it that store views
// (their summaries' stores) may store them into the data, so the argument
// comes to view everything those closures hold.
fn interior_stores(base: i64, end: i64) {
    unsafe {
        var a = base;
        while a < end {
            let arg = PEND.data[a + PE_NODE];
            let at_ty = NODES[arg].ty;
            let u = if at_ty > 0 && TYPES[at_ty].kind == TyKind::Ptr { TYPES[at_ty].a }
                else { at_ty };
            let ts = arg_slot(arg);
            if ts >= 0 && is_view_type(u) && lends_interior(at_ty) {
                let off = slot_off(CUR, ts);
                var b = base;
                while b < end {
                    let o = PEND.data[b + PE_OV];
                    let bt = NODES[PEND.data[b + PE_NODE]].ty;
                    let c = closure_of_type(bt) - 1;
                    if b != a && o >= 0 && c >= 0 && stores_any(CLOSURES[c].f) {
                        or_into(l1(off), l1(o));
                        or_into(l1(off), l2(o));
                        or_into(l2(off), l2(o));
                    }
                    b += PE;
                }
            }
            a += PE;
        }
    }
}

// Whether f's summary stores views.
fn stores_any(f: i64) -> bool {
    let s = crate::front::own::summary::summary_of(f);
    (s.sto[0] | s.sto[1] | s.sto[2] | s.sto[3]) != 0
}

// A call whose effects include `global`: the views of statics are invalid
// from here (slots, and pending views of enclosing calls; a loan on a
// static's own place stays: its address does not change).
fn global_call(n: i64, base: i64) {
    unsafe {
        let m = new_ov();
        or_expanded(at(m), STATIC_MASK);
        close_mask(at(m));
        // (the pending views only)
        var e = 0;
        while e < base {
            let k = PEND.data[e];
            let o = PEND.data[e + PE_OV];
            if (k == PK_VIEW || k == PK_MUT_VIEW) && o >= 0 && PEND.data[e + PE_INVALID] == 0
                && ov_hits(o, at(m)) {
                PEND.data[e + PE_INVALID] = H_GLOBAL;
                PEND.data[e + PE_BY] = n;
            }
            e += PE;
        }
        invalidate(at(m), n, H_GLOBAL, -1, 0);
        POOL_TOP = m;
    }
}

// (0.25) Statics lent to call n of f (-1: through a fn value): an
// argument that reaches mutable static S (`&S`, `&S.f`, a let `S`
// passed by reference, `S[..]`, a receiver `S.m()`, at level 1 or 2)
// conflicts with a callee that may change S by name, itself or through
// what it calls (effects::infer::static_access), and an inout one with a
// callee that reads it: the callee would see S through two names, which
// the optimizer takes to be apart (noalias). own.static, at the argument.
fn static_args(n: i64, f: i64, base: i64, end: i64) {
    unsafe {
        var e = base;
        while e < end {
            let k = PEND.data[e];
            let o = PEND.data[e + PE_OV];
            if k != PK_NONE && k != PK_RAW && o >= 0 {
                let arg = PEND.data[e + PE_NODE];
                for p in 0..PL_COUNT {
                    if !get_bit(l1(o), p) && !get_bit(l2(o), p) {
                        continue;
                    }
                    let r = root_of(p);
                    if PL_RKIND[r] != RK_STATIC {
                        continue;
                    }
                    let s = PL_RID[r];
                    let how = crate::front::effects::infer::static_access(f, s);
                    if (how & 2) != 0 || is_mut_kind(k) && how != 0 {
                        static_arg_error(n, f, arg, s, how);
                        break;
                    }
                }
            }
            e += PE;
        }
    }
}

fn static_arg_error(n: i64, f: i64, arg: i64, s: i64, how: i64) {
    unsafe {
        if !reporting(arg) {
            return;
        }
        let name = NODES[STATICS[s].node].a;
        own_begin(arg, OWN_STATIC);
        own_src(arg);
        own_str(c" lends the static ");
        own_sym(name);
        own_str(c" to ");
        own_src(n);
        if f >= 0 {
            own_str(c", and ");
            own_sym(FNS[f].display);
            own_str(if (how & 2) != 0 { c" changes " } else { c" reads " });
            own_sym(name);
            own_str(c" by name (itself or through what it calls)");
        } else {
            own_str(c", whose callee is not known and may reach it by name");
        }
        own_help(c"a static lent to a call must not be reached by name during the call (two names for one place, which the optimizer takes to be apart): lend a copy, then write it back");
        // the try: the call on a copy, `var copy = G; f(&copy); G = copy;`
        let at = SRC[NODES[arg].start..NODES[arg].end];
        let call = SRC[NODES[n].start..NODES[n].end];
        let amp = at.len > 1 && at[0] == '&';
        let whole = if amp { at[1..at.len] } else { at };
        // (`A[..]`: a copy of A, its elements lent)
        let sliced = whole.len > 4 && whole[whole.len - 4..whole.len] == "[..]";
        let place = if sliced { whole[0..whole.len - 4] } else { whole };
        var cut = 0;
        while cut + at.len <= call.len && call[cut..cut + at.len] != at {
            cut += 1;
        }
        if cut + at.len <= call.len && place.len > 0 {
            let t = buf_new();
            buf_str(t, c"var copy = ");
            buf_bytes(t, place);
            buf_str(t, c"; ");
            buf_bytes(t, call[0..cut]);
            buf_str(t, if amp { c"&copy" } else { c"copy" });
            if sliced {
                buf_str(t, c"[..]");
            }
            buf_bytes(t, call[cut + at.len..call.len]);
            buf_str(t, c"; ");
            buf_bytes(t, place);
            buf_str(t, c" = copy;");
            own_try(buf_slice(t));
        }
        own_end();
    }
}

// Pending entry e was changed by a later argument (PE_BY, how PE_INVALID)
// before call n: the finding, at the later argument.
fn changed_by_later(e: i64, n: i64) {
    unsafe {
        let arg = PEND.data[e + PE_NODE];
        let by = PEND.data[e + PE_BY];
        let k = PEND.data[e];
        // (the change at a node with no text of its own inside the call, a
        // drop or a scope's end: the finding is at the call, unnamed)
        let named = by > 0 && NODES[by].end > NODES[by].start
            && NODES[by].start >= NODES[n].start && NODES[by].end <= NODES[n].end;
        let at_node = if named { by } else { n };
        let pl = PEND.data[e + PE_PLACE];
        let o = PEND.data[e + PE_OV];
        if hidden_place(pl) || o >= 0 && hidden_place(first_place(o, 0 as *i64))
            || !reporting(at_node) {
            return;
        }
        own_begin(at_node, OWN_CONFLICT);
        if k == PK_RESERVE {
            own_str(c"the receiver ");
            own_src(arg);
            own_str(c" of ");
            own_src(n);
            if named {
                own_str(c" is changed by its own argument ");
                own_src(at_node);
            } else {
                own_str(c" is changed by its own arguments");
            }
            own_help(c"an 'inout self' receiver is lent when the call happens, after its arguments, and must not change in between: compute the argument into a 'let' before the call");
        } else {
            if named {
                own_src(at_node);
            } else {
                own_str(c"a later argument");
            }
            own_str(c" may change what argument ");
            own_src(arg);
            own_str(c" (");
            own_pos(arg);
            own_str(if k == PK_MUT || k == PK_SHARED { c") accesses, " } else { c") views, " });
            own_str(c"before ");
            own_src(n);
            own_str(c" uses it");
            own_help(c"evaluate the later argument into a 'let' before the call, then take the view (or the access) in the call");
        }
        if any_mark(PEND.data[e + PE_OV]) {
            own_soft();
        }
        own_end();
    }
}

// Pending entries a (written by the call) and b overlap (mask m: what a
// writes): the finding, at b.
fn overlap(a: i64, b: i64, m: i64) {
    unsafe {
        let an = PEND.data[a + PE_NODE];
        let bn = PEND.data[b + PE_NODE];
        let ob = PEND.data[b + PE_OV];
        var q = -1;
        for p in 0..PL_COUNT {
            if get_bit(at(m), p) && (get_bit(l1(ob), p) || get_bit(l2(ob), p))
                && crate::front::own::state::PL_RKIND[root_of(p)]
                != crate::front::own::state::RK_MARK {
                q = p;
                break;
            }
        }
        // (a desugaring's own temporaries: views::hidden_local)
        if hidden_place(q) || hidden_place(PEND.data[a + PE_PLACE]) || !reporting(bn) {
            return;
        }
        own_begin(bn, OWN_CONFLICT);
        if q >= 0 {
            own_place(q);
        } else {
            own_str(c"a place");
        }
        own_str(c" has an inout access, ");
        own_src(an);
        let kb = PEND.data[b];
        let named = is_mut_kind(kb) || kb == PK_VIEW;
        own_str(if is_mut_kind(kb) { c", and another one, " }
            else if kb == PK_VIEW { c", and a view, " } else { c", and is read by " });
        own_src(bn);
        own_str(if named { c", in the same call" } else { c" in the same call" });
        if PEND.data[a] == PK_RESERVE {
            own_help(c"the call changes its receiver while this argument still views it: copy what it views first ('.clone()'), or pass a part the receiver does not hold");
        } else {
            own_help(c"pass disjoint places ('&a.x, a.y'), copy the plain value out first, or for two elements of one Vec use 'v.swap(i, j)'");
        }
        if any_mark(ob) || any_mark(PEND.data[a + PE_OV]) {
            own_soft();
        }
        own_end();
    }
}
