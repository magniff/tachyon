// The end of std's source (0.16): the implementation of Gpa, the
// general-purpose allocator, and `std::CHECK_ALLOC`. Normally Gpa is C's
// malloc (compiler/std/gpa.tach); with --check-alloc, which sets
// CHECK_ALLOC_MODE, it is the checking allocator (compiler/std/
// alloc_check.tach, std_check_gpa_source), CHECK_ALLOC is true, and
// CHECK_ALLOC_OS gives the checking allocator its system (std_check_index
// is the index of this text).

use crate::base::buf_str;
use crate::front::stdsrc::{std_check_gpa_source, std_gpa_source, std_sys_source};

// --check-alloc (0.16): std's checking Gpa.
pub static mut CHECK_ALLOC_MODE: bool = false;
// With it: whether the target is Linux (the checking Gpa's system
// constants: CHECK_ALLOC_OS), set before std is loaded.
pub static mut CHECK_ALLOC_LINUX: bool = false;

// Appends the end of std's source to out (stdsrc.tach's std_source).
pub fn std_alloc_tail(out: i64) {
    unsafe {
        if CHECK_ALLOC_MODE {
            std_check_gpa_source(out);
            buf_str(out, c"pub const CHECK_ALLOC: bool = true;\n");
            // (one digit: std_check_index holds for every target)
            buf_str(out, if CHECK_ALLOC_LINUX { c"const CHECK_ALLOC_OS: i64 = 1;\n" }
                else { c"const CHECK_ALLOC_OS: i64 = 0;\n" });
        } else {
            std_gpa_source(out);
            buf_str(out, c"pub const CHECK_ALLOC: bool = false;\n");
        }
        // (0.20) then the target's system: sys/linux.tach or sys/macos.tach
        // (std::TARGET_OS and what differs between the C libraries)
        std_sys_source(out, CHECK_ALLOC_LINUX);
    }
}
