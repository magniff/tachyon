// The end of std's source (0.16): the implementation of Gpa, the
// general-purpose allocator, and `std::CHECK_ALLOC`. Normally Gpa is C's
// malloc (compiler/std/gpa.tach); with --check-alloc, which sets
// CHECK_ALLOC_MODE, it is the checking allocator (0.16 T3: its source
// goes here instead of std_gpa_source), and CHECK_ALLOC is true.

use crate::base::buf_str;
use crate::front::stdsrc::std_gpa_source;

// --check-alloc (0.16): std's checking Gpa.
pub static mut CHECK_ALLOC_MODE: bool = false;

// Appends the end of std's source to out (stdsrc.tach's std_source).
pub fn std_alloc_tail(out: i64) {
    unsafe {
        std_gpa_source(out);
        buf_str(out, if CHECK_ALLOC_MODE { c"pub const CHECK_ALLOC: bool = true;\n" }
            else { c"pub const CHECK_ALLOC: bool = false;\n" });
    }
}
