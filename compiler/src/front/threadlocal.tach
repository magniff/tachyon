// (0.21) Thread-local statics, `#[thread_local] static mut X: T = INIT;`
// (docs/design/concurrency.md §2.3, §4.6): each thread has its own X. In
// 0.21.0 an access of X is a call of std::thread::__tls_addr(&INIT's data,
// size), which keeps a copy per thread with the C library's
// thread-specific data (the Mach-O and ELF thread-local sections come
// later). Reading, writing or taking the address of one is the effect
// `tls`, not `global`.

use crate::base::intern_c;
use crate::front::assoc::ensure_checked;
use crate::front::ast::NODES;
use crate::front::types::{STATICS, SYM_FN, SYM_STATIC};

// On a Static item node (its `p`): declared #[thread_local].
pub const STATIC_THREAD_LOCAL: i64 = 1 << 55;

// Whether static s (a STATICS index) is a thread-local.
pub fn is_thread_local(s: i64) -> bool {
    unsafe { s >= 0 && (NODES[STATICS[s].node].p & STATIC_THREAD_LOCAL) != 0 }
}

// Whether the static of symbol sym is a thread-local.
pub fn symbol_is_thread_local(sym: i64) -> bool {
    unsafe { SYM_STATIC[sym] != 0 && is_thread_local(SYM_STATIC[sym] - 1) }
}

// std::thread::__tls_addr (a FNS index; -1 when std's thread module is not
// loaded).
pub fn tls_addr_fn() -> i64 {
    unsafe { SYM_FN[intern_c(c"std::thread::__tls_addr")] - 1 }
}

// Static s is used at node n: when it is a thread-local, __tls_addr is
// checked (compiled) with the program.
pub fn note_static_use(s: i64, n: i64) {
    if is_thread_local(s) {
        ensure_checked(tls_addr_fn(), n);
    }
}
