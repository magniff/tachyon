// `#[derive(Eq, Ord, Hash, Debug, Clone)]` (0.15;
// docs/design/errors-formatting.md): before the names are collected, each
// derive of a struct or enum (its `h`, a holder of TyNames) becomes an
// `impl` item appended to the program, whose functions (flagged
// FN_DERIVED, spans the derive attribute's) are syntactic: they call
// std's generic helpers (`eq_of`, `cmp_of`, `hash_of`, `clone_of`,
// `Fmt::debug`), so no type is needed to make them. On a generic type each
// parameter is bounded by the trait. Eq compares the fields with `==` (the
// structural `==` of the type, except that a `[u8]` field or one with an
// Eq impl compares through it).
//
// The impls are written as text (one source file, `<derive>`), parsed,
// and their nodes given the span of the derive's trait name, or, for the
// code of one field, the field's: an error in them points at the
// attribute or the field. Once the types are known, check_derives
// reports a field whose type lacks the trait (and leaves that impl's
// function unchecked).
//
// intrinsic.tach: the methods of the types that implement Clone, Ord or
// Hash without an impl block.

pub mod intrinsic;

use crate::base::{
    BUFS, IntVec, SRC, SYMS, _setjmp, add_source, buf_bytes, buf_clear, buf_int, buf_new, buf_str,
    cstr, intern_c, sym_name, sym_text,
};
use crate::base::diag::{
    ERR_HELP, RECOVER_DEPTH, edit_distance, err_begin, err_end_soft, err_fmt, err_help,
    err_help_fmt, err_str, recover_enter, recover_leave,
};
use crate::front::ast::{
    FN_BODY_FAILED, FN_DERIVED, NODES, NODE_COUNT, NODE_REF, NodeKind, SCRATCH, child, list_begin,
    list_end, list_push,
};
use crate::front::check::PROGRAM;
use crate::front::lexer::{TOK_COUNT, lex_range};
use crate::front::parser::parse_items_fragment;
use crate::front::traits::{implements, std_trait};
use crate::front::types::{
    ENUMS, ENUM_COUNT, STRUCTS, STRUCT_COUNT, TYPES, TyKind, VARIANTS, buf_type, enum_variant,
    err_type, is_float, struct_field, type_elem, variant_field,
};

// What a derive names (the D_* codes), by the name written.
const D_EQ: i64 = 1;
const D_ORD: i64 = 2;
const D_HASH: i64 = 3;
const D_DEBUG: i64 = 4;
const D_CLONE: i64 = 5;

// The text of the impls being made, and where its spans change: pairs
// (offset in GEN, node whose span the code from there on gets).
static mut GEN: i64 = -1;
static mut SPANS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The derives, in the order their impls are written: (item, the derive's
// TyName, D_* code, the Impl node once parsed; 0 for Eq).
static mut DERIVED: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// ---- Expansion ----

// The derives of the program's structs and enums, expanded into impls
// (after the modules are loaded, before collect_names).
pub fn expand_derives() {
    unsafe {
        if GEN < 0 {
            GEN = buf_new();
        }
        buf_clear(GEN);
        SPANS.count = 0;
        DERIVED.count = 0;
        for i in 0..NODES[PROGRAM].count {
            let item = child(PROGRAM, i);
            let kind = NODES[item].kind;
            if (kind == NodeKind::Struct || kind == NodeKind::Enum) && NODES[item].h != 0 {
                expand_item(item);
            }
        }
        if BUFS[GEN].len > 0 {
            parse_derived();
        }
    }
}

// The derives of struct or enum `item`.
fn expand_item(item: i64) {
    unsafe {
        let holder = NODES[item].h;
        for k in 0..NODES[holder].count {
            let d = child(holder, k);
            let code = derive_code(d, item);
            if code == 0 {
                continue;
            }
            if (0..k).any(|j| derive_code_quiet(child(holder, j)) == code) {
                err_begin(NODES[d].start);
                err_fmt(f"'{sym_text(NODES[d].a)}' is derived twice");
                err_help(c"remove one of them");
                err_end_soft();
                continue;
            }
            DERIVED.push(item);
            DERIVED.push(d);
            DERIVED.push(code);
            DERIVED.push(0);
            write_impl(item, d, code);
        }
    }
}

// The D_* code of derive `d` (a TyName), or 0 (after an error: not a
// trait that derives).
fn derive_code(d: i64, item: i64) -> i64 {
    unsafe {
        let code = derive_code_quiet(d);
        if code != 0 {
            return code;
        }
        let name = NODES[d].a;
        err_begin(NODES[d].start);
        if NODES[d].kind != NodeKind::TyName || NODES[d].g != 0 {
            err_str(c"#[derive] takes trait names: Eq, Ord, Hash, Debug, Clone");
            err_end_soft();
            return 0;
        }
        err_fmt(f"cannot derive '{sym_text(name)}' (derivable: Eq, Ord, Hash, Debug, Clone)");
        let text = SYMS[name].text;
        if text == "PartialEq" {
            err_help(c"tachyon's Eq is Rust's PartialEq: derive Eq");
        } else if text == "PartialOrd" {
            err_help(c"tachyon's Ord is Rust's PartialOrd and Ord: derive Ord");
        } else if text == "Copy" {
            err_help(c"every type copies on assignment: remove Copy");
        } else if text == "Display" {
            err_help_fmt(
                f"Display has no derive: write 'impl Display for {sym_text(NODES[item].a)}");
            if crate::front::conv::LEGACY_ROOT {
                err_help_fmt(f" {{ fn fmt(self: &{sym_text(NODES[item].a)}");
                err_help(c", f: &mut std::Fmt) { f.str(\"...\"); } }'");
            } else {
                err_help(c" { fn fmt(self, f: inout std::Fmt) { f.str(\"...\"); } }'");
            }
        } else if text == "Default" {
            err_help(c"there is no Default: write a 'fn new() -> T' in an impl");
        } else {
            let names = [c"Eq", c"Ord", c"Hash", c"Debug", c"Clone"];
            let mut best = -1;
            let mut best_d = 3;
            for i in 0..5 {
                let s = SYMS[intern_c(names[i])].text;
                let dist = edit_distance(text, s);
                if dist < best_d {
                    best = i;
                    best_d = dist;
                }
            }
            if best >= 0 {
                err_help_fmt(f"did you mean '{cstr(names[best])}'?");
            }
        }
        err_end_soft();
        0
    }
}

// The D_* code of derive `d`, or 0: Eq, Ord, Hash, Debug, Clone, or one
// of them as `std::Name`.
fn derive_code_quiet(d: i64) -> i64 {
    unsafe {
        if NODES[d].kind != NodeKind::TyName || NODES[d].g != 0 {
            return 0;
        }
        if NODES[d].count > 1
            || NODES[d].count == 1 && NODES[child(d, 0)].a != intern_c(c"std") {
            return 0;
        }
        let text = SYMS[NODES[d].a].text;
        if text == "Eq" {
            D_EQ
        } else if text == "Ord" {
            D_ORD
        } else if text == "Hash" {
            D_HASH
        } else if text == "Debug" {
            D_DEBUG
        } else if text == "Clone" {
            D_CLONE
        } else {
            0
        }
    }
}

// ---- Writing the impls ----

fn w(s: *u8) {
    unsafe { buf_str(GEN, s); }
}

fn w_sym(sym: i64) {
    unsafe { buf_str(GEN, sym_name(sym)); }
}

fn w_int(v: i64) {
    unsafe { buf_int(GEN, v); }
}

// The code written from here on has node n's span.
fn span_from(n: i64) {
    unsafe {
        SPANS.push(BUFS[GEN].len);
        SPANS.push(n);
    }
}

// `Name` or `Name<T, U>`: the type `item` declares.
fn w_self_type(item: i64) {
    unsafe {
        w_sym(NODES[item].a);
        w_type_args(item);
    }
}

// `<T, U>` of a generic item; nothing for another.
fn w_type_args(item: i64) {
    unsafe {
        let g = NODES[item].g;
        if g == 0 {
            return;
        }
        w(c"<");
        for i in 0..NODES[g].count {
            if i > 0 {
                w(c", ");
            }
            w_sym(NODES[child(g, i)].a);
        }
        w(c">");
    }
}

// `impl<T: B + Tr> Tr for Name<T> {`: the item's parameters with their
// bounds as written, and `trait_path` added to each.
fn w_impl_head(item: i64, trait_path: *u8) {
    unsafe {
        w(c"impl");
        let g = NODES[item].g;
        if g != 0 {
            w(c"<");
            for i in 0..NODES[g].count {
                let p = child(g, i);
                if i > 0 {
                    w(c", ");
                }
                w_sym(NODES[p].a);
                w(c": ");
                let bounds = NODES[p].h;
                if bounds != 0 {
                    buf_bytes(GEN, SRC[NODES[bounds].start..NODES[bounds].end]);
                    w(c" + ");
                }
                w(trait_path);
            }
            w(c">");
        }
        w(c" ");
        w(trait_path);
        w(c" for ");
        w_self_type(item);
        w(c" {\n");
    }
}

// The impl of derive `d` (D_* `code`) of `item`.
fn write_impl(item: i64, d: i64, code: i64) {
    unsafe {
        span_from(d);
        let is_struct = NODES[item].kind == NodeKind::Struct;
        if code == D_EQ {
            w_impl_head(item, c"std::Eq");
            w(c"    #[inline]\n    fn eq(self: &");
            w_self_type(item);
            w(c", other: &");
            w_self_type(item);
            w(c") -> bool {\n");
            if is_struct { struct_eq(item, d); } else { enum_eq(item, d); }
        } else if code == D_ORD {
            w_impl_head(item, c"std::Ord");
            w(c"    #[inline]\n    fn cmp(self: &");
            w_self_type(item);
            w(c", other: &");
            w_self_type(item);
            w(c") -> i64 {\n");
            if is_struct { struct_cmp(item, d); } else { enum_cmp(item, d); }
        } else if code == D_HASH {
            w_impl_head(item, c"std::Hash");
            w(c"    #[inline]\n    fn hash(self: &");
            w_self_type(item);
            w(c") -> u64 {\n");
            if is_struct { struct_hash(item, d); } else { enum_hash(item, d); }
        } else if code == D_DEBUG {
            w_impl_head(item, c"std::Debug");
            w(c"    fn fmt_debug(self: &");
            w_self_type(item);
            w(c", __f: &mut std::Fmt) {\n");
            if is_struct { struct_debug(item, d); } else { enum_debug(item, d); }
        } else {
            w_impl_head(item, c"std::Clone");
            w(c"    #[inline]\n    fn clone(self: &");
            w_self_type(item);
            w(c") -> ");
            w_self_type(item);
            w(c" {\n");
            if is_struct { struct_clone(item, d); } else { enum_clone(item, d); }
        }
        w(c"    }\n}\n");
    }
}

// Every field ==, through std::eq_of (so a `[u8]` field compares its
// bytes; `==` on the type itself would call this function).
fn struct_eq(item: i64, d: i64) {
    unsafe {
        for i in 0..NODES[item].count {
            let field = child(item, i);
            span_from(field);
            w(c"        if !std::eq_of(&self.");
            w_sym(NODES[field].a);
            w(c", &other.");
            w_sym(NODES[field].a);
            w(c") { return false; }\n");
        }
        span_from(d);
        w(c"        true\n");
    }
}

// Lexicographic over the fields, in their order.
fn struct_cmp(item: i64, d: i64) {
    unsafe {
        let count = NODES[item].count;
        for i in 0..count {
            let field = child(item, i);
            span_from(field);
            let name = NODES[field].a;
            if i + 1 < count {
                w(c"        let __c = std::cmp_of(&self.");
                w_sym(name);
                w(c", &other.");
                w_sym(name);
                w(c");\n        if __c != 0 { return __c; }\n");
            } else {
                w(c"        std::cmp_of(&self.");
                w_sym(name);
                w(c", &other.");
                w_sym(name);
                w(c")\n");
            }
        }
        span_from(d);
        if count == 0 {
            w(c"        0\n");
        }
    }
}

fn struct_hash(item: i64, d: i64) {
    unsafe {
        let count = NODES[item].count;
        if count == 0 {
            w(c"        0\n");
            return;
        }
        w(c"        let mut __h: u64 = 0;\n");
        for i in 0..count {
            let field = child(item, i);
            span_from(field);
            w(c"        __h = std::hash_mix(__h, std::hash_of(&self.");
            w_sym(NODES[field].a);
            w(c"));\n");
        }
        span_from(d);
        w(c"        __h\n");
    }
}

// Rust's text: `P { x: 1, y: 2 }`, `P` without fields.
fn struct_debug(item: i64, d: i64) {
    unsafe {
        let count = NODES[item].count;
        w(c"        __f.str(\"");
        w_sym(NODES[item].a);
        if count == 0 {
            w(c"\");\n");
            return;
        }
        for i in 0..count {
            let field = child(item, i);
            if i > 0 {
                w(c"        __f.str(\", ");
            } else {
                w(c" { ");
            }
            w_sym(NODES[field].a);
            w(c": \");\n");
            span_from(field);
            w(c"        __f.debug(&self.");
            w_sym(NODES[field].a);
            w(c");\n");
            span_from(d);
        }
        w(c"        __f.str(\" }\");\n");
    }
}

fn struct_clone(item: i64, d: i64) {
    unsafe {
        w(c"        ");
        w_sym(NODES[item].a);
        if NODES[item].g != 0 {
            w(c"::");
            w_type_args(item);
        }
        w(c" {");
        for i in 0..NODES[item].count {
            let field = child(item, i);
            if i > 0 {
                w(c",");
            }
            span_from(field);
            w(c" ");
            w_sym(NODES[field].a);
            // (a raw pointer field is copied: `clone_of` of a `*T` would
            // call T's clone through it, 0.20's let copying the pointer)
            let tn = NODES[field].b;
            if tn > 0 && NODES[tn].kind == NodeKind::TyPtr && (NODES[tn].p & NODE_REF) == 0
                && SRC[NODES[tn].start] == '*' {
                w(c": self.");
                w_sym(NODES[field].a);
            } else {
                w(c": std::clone_of(&self.");
                w_sym(NODES[field].a);
                w(c")");
            }
            span_from(d);
        }
        w(c" }\n");
    }
}

// Whether enum `item` has a variant with fields.
fn has_fields(item: i64) -> bool {
    unsafe {
        for i in 0..NODES[item].count {
            if NODES[child(item, i)].count > 0 {
                return true;
            }
        }
        false
    }
}

// `E::V`, `E::V(_, _)` (`binder` 0), or `E::V(__a0, __a1)` (`binder` the
// prefix, "__a"); `E::V { .. }`, `E::V { x: __a0, y: __a1 }` for a
// struct-like variant (0.17).
fn w_variant_pattern(item: i64, v: i64, binder: *u8) {
    unsafe {
        w_sym(NODES[item].a);
        w(c"::");
        w_sym(NODES[v].a);
        if NODES[v].count == 0 && NODES[v].c == 0 {
            return;
        }
        let names = NODES[v].d;
        if names != 0 {
            if binder == 0 as *u8 || NODES[v].count == 0 {
                w(c" { .. }");
                return;
            }
            w(c" { ");
            for k in 0..NODES[v].count {
                if k > 0 {
                    w(c", ");
                }
                w_sym(NODES[child(names, k)].a);
                w(c": ");
                w(binder);
                w_int(k);
            }
            w(c" }");
            return;
        }
        w(c"(");
        for k in 0..NODES[v].count {
            if k > 0 {
                w(c", ");
            }
            if binder == 0 as *u8 {
                w(c"_");
            } else {
                w(binder);
                w_int(k);
            }
        }
        w(c")");
    }
}

// The index of the variant `value` (text: `*self`) holds, as an i64
// expression: its discriminant when no variant has fields or a written
// discriminant (they are then 0, 1, ...), else a match.
fn w_variant_index(item: i64, value: *u8) {
    unsafe {
        let written = (0..NODES[item].count).any(|i| NODES[child(item, i)].b != 0);
        if !written && !has_fields(item) {
            w(c"(");
            w(value);
            w(c" as i64)");
            return;
        }
        w(c"match ");
        w(value);
        w(c" {");
        for i in 0..NODES[item].count {
            w(c" ");
            w_variant_pattern(item, child(item, i), 0 as *u8);
            w(c" => ");
            w_int(i);
            w(c",");
        }
        w(c" }");
    }
}

// The same variant, and its fields ==.
fn enum_eq(item: i64, d: i64) {
    unsafe {
        if !has_fields(item) {
            w(c"        (*self as i64) == (*other as i64)\n");
            return;
        }
        w(c"        match (*self, *other) {\n");
        for i in 0..NODES[item].count {
            let v = child(item, i);
            w(c"            (");
            w_variant_pattern(item, v, c"__a");
            w(c", ");
            w_variant_pattern(item, v, c"__b");
            w(c") => {\n");
            for k in 0..NODES[v].count {
                span_from(child(v, k));
                w(c"                if !std::eq_of(&__a");
                w_int(k);
                w(c", &__b");
                w_int(k);
                w(c") { return false; }\n");
            }
            span_from(d);
            w(c"                true\n            }\n");
        }
        if NODES[item].count > 1 {
            w(c"            _ => false,\n");
        }
        w(c"        }\n");
    }
}

// Variant order first, then the fields, lexicographic.
fn enum_cmp(item: i64, d: i64) {
    unsafe {
        w(c"        let __a: i64 = ");
        w_variant_index(item, c"*self");
        w(c";\n        let __b: i64 = ");
        w_variant_index(item, c"*other");
        w(c";\n        if __a != __b {\n            return if __a < __b { -1 } else { 1 };\n        }\n");
        if !has_fields(item) {
            w(c"        0\n");
            return;
        }
        w(c"        match (*self, *other) {\n");
        for i in 0..NODES[item].count {
            let v = child(item, i);
            let count = NODES[v].count;
            if count == 0 {
                continue;
            }
            w(c"            (");
            w_variant_pattern(item, v, c"__a");
            w(c", ");
            w_variant_pattern(item, v, c"__b");
            w(c") => {\n");
            for k in 0..count {
                span_from(child(v, k));
                if k + 1 < count {
                    w(c"                let __c = std::cmp_of(&__a");
                    w_int(k);
                    w(c", &__b");
                    w_int(k);
                    w(c");\n                if __c != 0 { return __c; }\n");
                } else {
                    w(c"                std::cmp_of(&__a");
                    w_int(k);
                    w(c", &__b");
                    w_int(k);
                    w(c")\n");
                }
            }
            span_from(d);
            w(c"            }\n");
        }
        if NODES[item].count > 1 {
            w(c"            _ => 0,\n");
        }
        w(c"        }\n");
    }
}

// The variant's index, then its fields.
fn enum_hash(item: i64, d: i64) {
    unsafe {
        if !has_fields(item) {
            w(c"        std::hash_mix(0, ");
            w_variant_index(item, c"*self");
            w(c" as u64)\n");
            return;
        }
        w(c"        match *self {\n");
        for i in 0..NODES[item].count {
            let v = child(item, i);
            w(c"            ");
            w_variant_pattern(item, v, c"__a");
            if NODES[v].count == 0 {
                w(c" => std::hash_mix(0, ");
                w_int(i);
                w(c"),\n");
                continue;
            }
            w(c" => {\n                let mut __h = std::hash_mix(0, ");
            w_int(i);
            w(c");\n");
            for k in 0..NODES[v].count {
                span_from(child(v, k));
                w(c"                __h = std::hash_mix(__h, std::hash_of(&__a");
                w_int(k);
                w(c"));\n");
            }
            span_from(d);
            w(c"                __h\n            }\n");
        }
        w(c"        }\n");
    }
}

// Rust's text: `V(1, 2)`, `V { x: 1, y: 2 }` (0.17), `V` without fields.
fn enum_debug(item: i64, d: i64) {
    unsafe {
        w(c"        match *self {\n");
        for i in 0..NODES[item].count {
            let v = child(item, i);
            let names = NODES[v].d;
            w(c"            ");
            w_variant_pattern(item, v, c"__a");
            w(c" => {\n                __f.str(\"");
            w_sym(NODES[v].a);
            if NODES[v].count == 0 {
                w(c"\");\n            }\n");
                continue;
            }
            if names != 0 {
                w(c" { ");
            } else {
                w(c"(");
            }
            w(c"\");\n");
            for k in 0..NODES[v].count {
                if k > 0 || names != 0 {
                    w(c"                __f.str(\"");
                    if k > 0 {
                        w(c", ");
                    }
                    if names != 0 {
                        w_sym(NODES[child(names, k)].a);
                        w(c": ");
                    }
                    w(c"\");\n");
                }
                span_from(child(v, k));
                w(c"                __f.debug(&__a");
                w_int(k);
                w(c");\n");
                span_from(d);
            }
            if names != 0 {
                w(c"                __f.str(\" }\");\n            }\n");
            } else {
                w(c"                __f.str(\")\");\n            }\n");
            }
        }
        w(c"        }\n");
    }
}

fn enum_clone(item: i64, d: i64) {
    unsafe {
        if !has_fields(item) {
            w(c"        *self\n");
            return;
        }
        w(c"        match *self {\n");
        for i in 0..NODES[item].count {
            let v = child(item, i);
            let names = NODES[v].d;
            w(c"            ");
            w_variant_pattern(item, v, c"__a");
            w(c" => ");
            w_sym(NODES[item].a);
            w(c"::");
            w_sym(NODES[v].a);
            if NODES[v].count > 0 || NODES[v].c != 0 {
                w(if names != 0 { c" { " } else { c"(" });
                for k in 0..NODES[v].count {
                    if k > 0 {
                        w(c", ");
                    }
                    if names != 0 {
                        w_sym(NODES[child(names, k)].a);
                        w(c": ");
                    }
                    span_from(child(v, k));
                    w(c"std::clone_of(&__a");
                    w_int(k);
                    w(c")");
                    span_from(d);
                }
                w(if names != 0 { c" }" } else { c")" });
            }
            w(c",\n");
        }
        w(c"        }\n");
    }
}

// ---- Parsing them ----

// Parses GEN as a source file `<derive>`, gives its nodes their spans,
// flags the impls and their functions FN_DERIVED, and appends them to the
// program.
fn parse_derived() {
    unsafe {
        let base = add_source(c"<derive>", GEN);
        let first = TOK_COUNT;
        let node_mark = NODE_COUNT;
        let mark = list_begin();
        let depth = RECOVER_DEPTH;
        if _setjmp(recover_enter()) == 0 {
            lex_range(base, base + BUFS[GEN].len, last: true);
            parse_items_fragment(first);
        } else {
            // (a syntax error in the made text: a compiler bug, reported)
            SCRATCH.count = mark;
        }
        recover_leave(depth);
        for k in node_mark..NODE_COUNT {
            let target = span_at(NODES[k].start - base);
            NODES[k].start = NODES[target].start;
            NODES[k].end = NODES[target].end;
        }
        // The impls come in the order of DERIVED's.
        let mut next = 0;
        for i in mark..SCRATCH.count {
            let n = SCRATCH.data[i];
            NODES[n].p |= FN_DERIVED;
            if NODES[n].kind == NodeKind::Impl {
                if next < DERIVED.count {
                    DERIVED.data[next + 3] = n;
                    next += 4;
                }
            }
        }
        let count = SCRATCH.count - mark;
        let all = list_begin();
        for i in 0..NODES[PROGRAM].count {
            list_push(child(PROGRAM, i));
        }
        for i in 0..count {
            list_push(SCRATCH.data[mark + i]);
        }
        list_end(PROGRAM, all);
        SCRATCH.count = mark;
    }
}

// The node whose span the code at `offset` of GEN has.
fn span_at(offset: i64) -> i64 {
    unsafe {
        let mut lo = 0;
        let mut hi = SPANS.count / 2 - 1;
        while lo < hi {
            let mid = (lo + hi + 1) / 2;
            if SPANS.data[2 * mid] <= offset {
                lo = mid;
            } else {
                hi = mid - 1;
            }
        }
        SPANS.data[2 * lo + 1]
    }
}

// ---- Checking the fields ----

// Once the types are known (after the collect phases): each field of a
// derived non-generic type has the trait (a generic type's fields are
// checked in its instances). An error leaves the impl's function
// unchecked.
pub fn check_derives() {
    unsafe {
        let mut i = 0;
        while i < DERIVED.count {
            let item = DERIVED.data[i];
            let d = DERIVED.data[i + 1];
            let code = DERIVED.data[i + 2];
            let imp = DERIVED.data[i + 3];
            i += 4;
            if NODES[item].g != 0 || imp == 0 {
                continue;
            }
            let ok = if NODES[item].kind == NodeKind::Struct { check_struct_fields(item, d, code) }
                else { check_enum_fields(item, d, code) };
            if !ok {
                for k in 0..NODES[imp].count {
                    NODES[child(imp, k)].p |= FN_BODY_FAILED;
                }
            }
        }
    }
}

fn check_struct_fields(item: i64, d: i64, code: i64) -> bool {
    unsafe {
        let mut s = -1;
        for k in 0..STRUCT_COUNT {
            if STRUCTS[k].node == item && STRUCTS[k].tmpl == 0 {
                s = k;
            }
        }
        if s < 0 || STRUCTS[s].field_count != NODES[item].count {
            return true;
        }
        let mut ok = true;
        for k in 0..STRUCTS[s].field_count {
            let field = child(item, k);
            let ty = (*struct_field(s, k)).ty;
            if !field_has(ty, code) {
                field_error(item, d, code, field, ty, -1, k);
                ok = false;
            }
        }
        ok
    }
}

fn check_enum_fields(item: i64, d: i64, code: i64) -> bool {
    unsafe {
        let mut e = -1;
        for k in 0..ENUM_COUNT {
            if ENUMS[k].node == item && ENUMS[k].tmpl == 0 {
                e = k;
            }
        }
        if e < 0 || ENUMS[e].variant_count != NODES[item].count {
            return true;
        }
        let mut ok = true;
        for i in 0..ENUMS[e].variant_count {
            let v = enum_variant(e, i);
            let vn = child(item, i);
            if VARIANTS[v].field_count != NODES[vn].count {
                continue;
            }
            for k in 0..VARIANTS[v].field_count {
                let ty = variant_field(v, k);
                if !field_has(ty, code) {
                    field_error(item, d, code, child(vn, k), ty, i, k);
                    ok = false;
                }
            }
        }
        ok
    }
}

// Whether type `ty` has the trait of D_* `code`.
fn field_has(ty: i64, code: i64) -> bool {
    let name = if code == D_EQ { c"Eq" } else if code == D_ORD { c"Ord" }
        else if code == D_HASH { c"Hash" } else if code == D_DEBUG { c"Debug" } else { c"Clone" };
    unsafe { implements(std_trait(name), ty) }
}

// "cannot derive Hash for 'P': field 'x' of type 'f64' has no Hash", at
// the field (`variant`: its index for field `index` of an enum's variant,
// else -1).
fn field_error(item: i64, d: i64, code: i64, field: i64, ty: i64, variant: i64, index: i64) {
    unsafe {
        err_begin(NODES[field].start);
        err_fmt(f"cannot derive {sym_text(NODES[d].a)} for '{sym_text(NODES[item].a)}': ");
        if variant >= 0 {
            err_fmt(f"field {index} of '{sym_text(NODES[item].a)}::");
            err_fmt(f"{sym_text(NODES[child(item, variant)].a)}'");
        } else {
            err_fmt(f"field '{sym_text(NODES[field].a)}'");
        }
        err_str(c" of type '");
        err_type(ty);
        err_str(c"' has no ");
        err_str(if code == D_EQ { c"==" } else { sym_name(NODES[d].a) });
        if code == D_HASH && (is_float(ty) || has_float(ty)) {
            err_help(c"floats have no Hash (NaN is not equal to itself): remove Hash from #[derive], or write the impl, hashing the field's bits");
        } else if code == D_EQ {
            err_help(c"remove Eq from #[derive], or give the field a type with ==");
        } else {
            err_help_fmt(f"remove {sym_text(NODES[d].a)} from #[derive], or implement it for '");
            buf_type(ERR_HELP, ty);
            err_help(c"'");
        }
        err_end_soft();
    }
}

// Whether a tuple or array type `ty` holds a float.
fn has_float(ty: i64) -> bool {
    unsafe {
        let kind = TYPES[ty].kind;
        if kind == TyKind::Array {
            return is_float(TYPES[ty].a) || has_float(TYPES[ty].a);
        }
        if kind == TyKind::Tuple {
            for i in 0..TYPES[ty].count {
                if is_float(type_elem(ty, i)) || has_float(type_elem(ty, i)) {
                    return true;
                }
            }
        }
        false
    }
}

// The help of a conflict between impl `node` and another impl of its
// trait for its type: when `node` is a derive's, remove the derive.
pub fn derive_conflict_help(node: i64) {
    unsafe {
        if (NODES[node].p & FN_DERIVED) == 0 {
            return;
        }
        err_help_fmt(f"remove {sym_text(NODES[NODES[node].a].a)}");
        err_help(c" from #[derive], or the impl written by hand");
    }
}
