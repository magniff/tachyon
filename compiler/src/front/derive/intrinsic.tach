// The methods of the types that implement Clone, Eq, Ord or Hash without
// an impl block (0.15): `x.clone()` on a type that copies, `x.cmp(&y)` on
// a float, pointer or fieldless enum, and `eq`, `cmp`, `hash`, `clone` on
// tuples of 2 to 6 elements, which call std's copy_clone, scalar_cmp and
// tupleN_* (std/clone.tach); and the intrinsic Eq, Ord, Hash and Clone of
// tuples and Clone of the types that copy (traits::intrinsic).

use crate::base::{SYMS, buf_clear, buf_fmt, buf_new, buf_slice, cstr, intern, intern_c};
use crate::front::check::distinct::distinct_helper;
use crate::front::check::equality::eq_unsupported;
use crate::front::distinct::is_distinct_type;
use crate::front::generics::instantiate::fn_instance;
use crate::front::modules::{STD_MODULE, qualify};
use crate::front::own::kinds::is_owned_type;
use crate::front::modules::lookup::std_item_key;
use crate::front::traits::{implements, std_trait};
use crate::front::types::{
    SYM_FN, TSCRATCH, TYPES, TY_BOOL, TY_UNIT, TyKind, is_fieldless_enum, is_fn_type, is_numeric,
    is_pointer, is_slice, is_vector, type_elem,
};

// ---- Clone, Ord and Hash without an impl ----

// Whether values of type t are copies that own nothing: numbers, bool,
// (), pointers, slices (a view), fn types, fieldless enums, vectors, and
// tuples and arrays of them. They implement Clone without an impl.
pub fn is_plain(t: i64) -> bool {
    unsafe {
        if is_numeric(t) || t == TY_BOOL || t == TY_UNIT || is_pointer(t) || is_fn_type(t)
            || is_fieldless_enum(t) || is_slice(t) || is_vector(t) {
            return true;
        }
        let kind = TYPES[t].kind;
        if kind == TyKind::Array {
            return is_plain(TYPES[t].a);
        }
        if kind == TyKind::Tuple {
            for i in 0..TYPES[t].count {
                if !is_plain(type_elem(t, i)) {
                    return false;
                }
            }
            return true;
        }
        false
    }
}

// (0.17) Whether t is a struct or an enum that owns nothing (plain, or a
// view): it clones by copying, without an impl.
pub fn copy_aggregate(t: i64) -> bool {
    unsafe {
        t > 0 && (TYPES[t].kind == TyKind::Struct || TYPES[t].kind == TyKind::Enum)
            && !is_owned_type(t)
    }
}

// Whether t is a tuple of 2 to 6 elements that each implement trait tr
// (it then implements tr: Eq, Ord, Hash or Clone, through std's
// tupleN_*).
pub fn tuple_implements(tr: i64, t: i64) -> bool {
    unsafe {
        if tr < 0 || TYPES[t].kind != TyKind::Tuple || TYPES[t].count < 2 || TYPES[t].count > 6 {
            return false;
        }
        for i in 0..TYPES[t].count {
            if !implements(tr, type_elem(t, i)) {
                return false;
            }
        }
        true
    }
}

// Whether operator trait tr (Eq: == and !=; Ord: < > <= >=) on values of
// tuple type t is a call of its function (tupleN_eq, tupleN_cmp): Ord
// when the elements are; Eq when they are but the structural == does
// not apply (a `[u8]` element compares its bytes).
pub fn tuple_operator(tr: i64, t: i64) -> bool {
    unsafe {
        if TYPES[t].kind != TyKind::Tuple {
            return false;
        }
        if tr == std_trait(c"Ord") {
            return tuple_implements(tr, t);
        }
        tr == std_trait(c"Eq") && eq_unsupported(t) != 0 && tuple_implements(tr, t)
    }
}

// Whether `x.name(..)` on a value of type t is one of the methods of
// intrinsic_method.
pub fn has_intrinsic_method(t: i64, name: i64) -> bool {
    intrinsic_helper(t, name) != 0
}

// std's function that `x.name(..)` calls, x of type t, when t implements
// Clone, Eq, Ord or Hash without an impl block (`name` is clone, eq, cmp
// or hash); 0 when none.
fn intrinsic_helper(t: i64, name: i64) -> i64 {
    unsafe {
        if STD_MODULE < 0 {
            return 0;
        }
        // (0.18: a distinct type's, through its underlying type)
        if is_distinct_type(t) {
            return distinct_helper(t, name);
        }
        let text = SYMS[name].text;
        if text == "clone" {
            if is_plain(t) || copy_aggregate(t) {
                return intern_c(c"copy_clone");
            }
            if tuple_implements(std_trait(c"Clone"), t) {
                return tuple_helper(t, c"clone");
            }
        } else if text == "cmp" {
            if is_numeric(t) || is_pointer(t) || is_fieldless_enum(t) {
                return intern_c(c"scalar_cmp");
            }
            if tuple_implements(std_trait(c"Ord"), t) {
                return tuple_helper(t, c"cmp");
            }
        } else if text == "eq" {
            if tuple_implements(std_trait(c"Eq"), t) {
                return tuple_helper(t, c"eq");
            }
        } else if text == "hash" {
            if tuple_implements(std_trait(c"Hash"), t) {
                return tuple_helper(t, c"hash");
            }
        }
        0
    }
}

// `tupleN_what`, N the number of t's elements.
fn tuple_helper(t: i64, what: *u8) -> i64 {
    unsafe {
        let b = buf_new_scratch();
        buf_fmt(b, f"tuple{TYPES[t].count}_{cstr(what)}");
        intern(buf_slice(b))
    }
}

static mut NAME_BUF: i64 = -1;

fn buf_new_scratch() -> i64 {
    unsafe {
        if NAME_BUF < 0 {
            NAME_BUF = buf_new();
        }
        buf_clear(NAME_BUF);
        NAME_BUF
    }
}

// The function `x.name(..)` (call node n, x of type t) calls when t has no
// method `name` but implements Clone, Eq, Ord or Hash without an impl: the
// instance of std's copy_clone, scalar_cmp or tupleN_* for t; -1 when
// there is none.
pub fn intrinsic_method(n: i64, t: i64, name: i64) -> i64 {
    unsafe {
        let helper = intrinsic_helper(t, name);
        if helper == 0 {
            return -1;
        }
        let key = std_item_key(helper);
        if key < 0 || SYM_FN[key] == 0 {
            return -1;
        }
        let tf = SYM_FN[key] - 1;
        let mark = TSCRATCH.count;
        if TYPES[t].kind == TyKind::Tuple && SYMS[helper].text[0..5] == "tuple" {
            for i in 0..TYPES[t].count {
                TSCRATCH.push(type_elem(t, i));
            }
        } else {
            TSCRATCH.push(t);
            // (0.18: distinct_*'s second argument, the underlying type)
            if is_distinct_type(t) {
                TSCRATCH.push(TYPES[t].a);
            }
        }
        fn_instance(tf, mark, n)
    }
}
