// Compile-time constants: `const` items, array lengths and the
// initializers of statics. A scalar constant is held as 64 bits: integers
// wrapped to their type (sign-extended when signed), floats as the bits of
// an f64 (rounded to f32 first for f32), bools as 0 or 1.

use crate::base::{BUFS, IntVec, buf_reserve, memset};
use crate::front::lexer::Tok;
use crate::front::ast::{NODES, NodeKind, VK_NEW, VK_SPLAT, child};
use crate::front::modules::{CUR_MOD, module_of};
use crate::front::types::{
    CONSTS, ENUMS, TYPES, TY_BOOL, TY_ERROR, TY_F32, TY_I64, TY_U64, TY_UNIT, VARIANTS,
    field_offset, int_bits, int_max, is_compound, is_float, is_integer, is_pointer, is_signed,
    scalar_type, struct_field, tuple_offset, type_elem, type_size, variant_field,
    variant_field_offset,
};
use crate::front::check::{
    CONST_CONTEXT, RETURN_TYPE, Res, Try, attempt, name_error, type_error, type_error_got,
};
use crate::front::check::check_mode::check_expr;
use crate::front::check::synth_mode::synth_expr;
use crate::front::generics::{env_enter, env_leave};
use crate::front::lexer::Tok::{
    Amp, AmpAmp, Bang, BangEq, Caret, EqEq, Gt, GtEq, Lt, LtEq, Minus, Percent, Pipe, PipePipe,
    Plus, Shl, Shr, Slash, Star, Tilde,
};

pub fn f64_of_bits(bits: i64) -> f64 {
    let copy = bits;
    unsafe { *(&copy as *f64) }
}

pub fn bits_of(value: f64) -> i64 {
    let copy = value;
    unsafe { *(&copy as *i64) }
}

pub fn f32_bits(value: f64) -> u32 {
    let narrow = value as f32;
    unsafe { *(&narrow as *u32) }
}

// `value` wrapped to the integer (or pointer) type `ty`.
pub fn wrap_int(value: i64, ty: i64) -> i64 {
    if !is_integer(ty) {
        return value;
    }
    let bits = int_bits(ty);
    if bits == 64 {
        return value;
    }
    let mask: i64 = (1 << bits as u64) - 1;
    let masked = value & mask;
    if is_signed(ty) && (masked >> (bits - 1) as u64) == 1 {
        return masked - (1 << bits as u64);
    }
    masked
}

pub fn float_const(value: f64, ty: i64) -> i64 {
    if ty == TY_F32 {
        return bits_of(value as f32 as f64);
    }
    bits_of(value)
}

fn not_constant(n: i64) -> ! {
    unsafe { type_error(n, c"expression is not a compile-time constant") }
}

// Type checks `n` against `ty` with no locals in scope.
pub fn check_const_expr(n: i64, ty: i64) {
    let saved_context = CONST_CONTEXT;
    let saved_return = RETURN_TYPE;
    CONST_CONTEXT = true;
    RETURN_TYPE = TY_UNIT;
    check_expr(n, ty);
    CONST_CONTEXT = saved_context;
    RETURN_TYPE = saved_return;
}

pub fn const_value(c: i64) -> i64 {
    unsafe {
        if CONSTS[c].state == 2 {
            return CONSTS[c].value;
        }
        let item = CONSTS[c].node;
        if CONSTS[c].state == 1 {
            name_error(NODES[item].start, c"constant '", NODES[item].a, c"' is defined in terms of itself");
        }
        CONSTS[c].state = 1;
        // (0.10: a constant whose type or initializer failed is 0, and the
        // checking goes on)
        CONSTS[c].value = 0;
        if CONSTS[c].ty != TY_ERROR {
            attempt(Try::Const, c);
        }
        CONSTS[c].state = 2;
        CONSTS[c].value
    }
}

pub fn const_value_of(c: i64) {
    unsafe {
        let item = CONSTS[c].node;
        // In the constant's module, without type parameters in scope.
        let saved_mod = CUR_MOD;
        CUR_MOD = module_of(item);
        let saved_env = env_enter(0, 0, 0);
        check_const_expr(NODES[item].c, CONSTS[c].ty);
        // A C string constant (0.4) has no value: its uses are the literal.
        let value = if NODES[NODES[item].c].kind == NodeKind::CStr { 0 } else { const_eval(NODES[item].c) };
        env_leave(saved_env);
        CUR_MOD = saved_mod;
        CONSTS[c].value = value;
    }
}

pub fn eval_array_len(n: i64) -> i64 {
    unsafe {
        let saved_context = CONST_CONTEXT;
        CONST_CONTEXT = true;
        let ty = synth_expr(n);
        if !is_integer(ty) {
            type_error_got(n, c"array length must be an integer", ty);
        }
        let value = const_eval(n);
        CONST_CONTEXT = saved_context;
        if is_signed(ty) && value < 0 {
            type_error(n, c"array length must not be negative");
        }
        value
    }
}

// The value of a scalar constant expression (already type checked).
pub fn const_eval(n: i64) -> i64 {
    unsafe {
        let ty = NODES[n].ty;
        match NODES[n].kind {
            NodeKind::Int | NodeKind::Char => wrap_int(NODES[n].a, ty),
            NodeKind::Float => float_const(f64_of_bits(NODES[n].a), ty),
            NodeKind::Bool => NODES[n].a,
            NodeKind::Unit => 0,
            NodeKind::Ident => {
                if NODES[n].res != Res::Const {
                    name_error(NODES[n].start, c"'", NODES[n].a, c"' is not a constant");
                }
                const_value(NODES[n].y)
            }
            NodeKind::Unary => const_unary(n, ty),
            NodeKind::Binary => const_binary(n, ty),
            NodeKind::Cast => {
                let operand = NODES[n].a;
                let value = const_eval(operand);
                const_cast(n, value, scalar_type(NODES[operand].ty), ty)
            }
            NodeKind::VariantLit if !is_compound(ty) => wrap_int(VARIANTS[NODES[n].a].discr, scalar_type(ty)),
            _ => not_constant(n),
        }
    }
}

fn const_unary(n: i64, ty: i64) -> i64 {
    unsafe {
        let value = const_eval(NODES[n].b);
        match NODES[n].op {
            Minus => if is_float(ty) {
                float_const(0.0 - f64_of_bits(value), ty)
            } else {
                wrap_int(0 - value, ty)
            },
            Bang => 1 - value,
            Tilde => wrap_int(~value, ty),
            _ => not_constant(n),
        }
    }
}

fn const_binary(n: i64, ty: i64) -> i64 {
    unsafe {
        let op = NODES[n].op;
        let lhs = NODES[n].b;
        let operand_ty = NODES[lhs].ty;
        let a = const_eval(lhs);
        if op == AmpAmp && a == 0 {
            return 0;
        }
        if op == PipePipe && a == 1 {
            return 1;
        }
        let b = const_eval(NODES[n].c);
        if operand_ty == TY_BOOL {
            if op == AmpAmp || op == PipePipe { return b; }
            if op == EqEq { return (a == b) as i64; }
            if op == BangEq { return (a != b) as i64; }
            type_error(n, c"invalid operator on bools");
        }
        if is_float(operand_ty) {
            return const_float_binary(n, op, f64_of_bits(a), f64_of_bits(b), ty);
        }
        const_int_binary(n, op, a, b, operand_ty, ty)
    }
}

fn const_float_binary(n: i64, op: Tok, a: f64, b: f64, ty: i64) -> i64 {
    match op {
        Plus => float_const(a + b, ty),
        Minus => float_const(a - b, ty),
        Star => float_const(a * b, ty),
        Slash => float_const(a / b, ty),
        Percent => float_const(a % b, ty),
        EqEq => (a == b) as i64,
        BangEq => (a != b) as i64,
        Lt => (a < b) as i64,
        Gt => (a > b) as i64,
        LtEq => (a <= b) as i64,
        GtEq => (a >= b) as i64,
        _ => unsafe { type_error(n, c"invalid operator on floats") },
    }
}

// `a < b` for values of an integer type.
pub fn const_less(a: i64, b: i64, ty: i64) -> bool {
    if is_signed(ty) { a < b } else { (a as u64) < (b as u64) }
}

fn const_int_binary(n: i64, op: Tok, a: i64, b: i64, operand_ty: i64, ty: i64) -> i64 {
    match op {
        Plus => wrap_int(a + b, ty),
        Minus => wrap_int(a - b, ty),
        Star => wrap_int(a * b, ty),
        Slash | Percent => {
            if b == 0 {
                unsafe { type_error(n, c"division by zero in constant expression"); }
            }
            if is_signed(operand_ty) {
                // -MIN / -1 overflows; computed by negation, which wraps.
                if b == -1 {
                    return if op == Slash { wrap_int(0 - a, ty) } else { 0 };
                }
                return wrap_int(if op == Slash { a / b } else { a % b }, ty);
            }
            let ua = a as u64;
            let ub = b as u64;
            wrap_int((if op == Slash { ua / ub } else { ua % ub }) as i64, ty)
        }
        Amp => wrap_int(a & b, ty),
        Pipe => wrap_int(a | b, ty),
        Caret => wrap_int(a ^ b, ty),
        Shl | Shr => {
            let amount = (b as u64 & 0xffffffff) % int_bits(operand_ty) as u64;
            if op == Shl {
                wrap_int(a << amount, ty)
            } else if is_signed(operand_ty) {
                wrap_int(a >> amount, ty)
            } else {
                wrap_int(((a as u64) >> amount) as i64, ty)
            }
        }
        EqEq => (a == b) as i64,
        BangEq => (a != b) as i64,
        Lt => const_less(a, b, operand_ty) as i64,
        Gt => const_less(b, a, operand_ty) as i64,
        LtEq => !const_less(b, a, operand_ty) as i64,
        GtEq => !const_less(a, b, operand_ty) as i64,
        _ => not_constant(n),
    }
}

fn int_to_f64(value: i64, from: i64) -> f64 {
    if is_signed(from) { value as f64 } else { (value as u64) as f64 }
}

fn const_cast(n: i64, value: i64, from: i64, to: i64) -> i64 {
    let from_float = is_float(from);
    if (is_integer(to) || is_pointer(to)) && !from_float {
        if from == TY_BOOL {
            return value;
        }
        return wrap_int(value, to);
    }
    if is_float(to) && from_float {
        return float_const(f64_of_bits(value), to);
    }
    if is_float(to) && (is_integer(from) || is_pointer(from)) {
        return float_const(int_to_f64(value, from), to);
    }
    if is_integer(to) && from_float {
        return float_to_int(f64_of_bits(value), to);
    }
    not_constant(n)
}

// A saturating float to integer conversion (NaN is 0), like Rust's `as`.
fn float_to_int(value: f64, to: i64) -> i64 {
    if value != value {
        return 0;
    }
    let bits = int_bits(to);
    if to == TY_U64 {
        if value <= 0.0 {
            return 0;
        }
        if value >= 18446744073709551616.0 {
            return -1;
        }
        if value >= 9223372036854775808.0 {
            return ((value - 9223372036854775808.0) as i64) ^ (1 << 63);
        }
        return value as i64;
    }
    let mut min = 0.0;
    let mut max = 0.0;
    if is_signed(to) {
        min = 0.0 - int_to_f64(1 << (bits - 1) as u64, TY_I64);
        max = int_to_f64(int_max(to) as i64, TY_I64);
    } else {
        max = int_to_f64(int_max(to) as i64, TY_I64);
    }
    if value <= min {
        return wrap_int(min as i64, to);
    }
    if value >= max {
        return int_max(to) as i64;
    }
    value as i64
}

// ---- Aggregate constants (the initializers of statics) ----

// Appends the bytes of the constant `n` of type `ty` to buffer `out`.
// The addresses in the last const_emit's bytes (0.9): (offset, string
// id) pairs, each 8 bytes holding the address of a string literal's
// bytes (a `[u8]` literal's pointer, or a `c"..."`).
pub static mut CONST_RELOCS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

pub fn const_emit(n: i64, ty: i64, out: i64) {
    unsafe {
        CONST_RELOCS.count = 0;
        let at = BUFS[out].len;
        let size = type_size(ty);
        buf_reserve(out, size);
        memset(&BUFS[out].data[at], 0, size as u64);
        BUFS[out].len += size;
        const_write(n, ty, out, at);
        // (by offset: a struct's fields are not in their order)
        let count = CONST_RELOCS.count / 2;
        for i in 1..count {
            let mut j = i;
            while j > 0 && CONST_RELOCS.data[2 * j] < CONST_RELOCS.data[2 * (j - 1)] {
                for k in 0..2 {
                    let t = CONST_RELOCS.data[2 * j + k];
                    CONST_RELOCS.data[2 * j + k] = CONST_RELOCS.data[2 * (j - 1) + k];
                    CONST_RELOCS.data[2 * (j - 1) + k] = t;
                }
                j -= 1;
            }
        }
    }
}

fn const_write(n: i64, ty: i64, out: i64, at: i64) {
    unsafe {
        match NODES[n].kind {
            NodeKind::StructLit => {
                let s = TYPES[ty].a;
                for i in 0..NODES[n].count {
                    let init = child(n, i);
                    let field = NODES[init].x;
                    const_write(NODES[init].b, (*struct_field(s, field)).ty, out, at + field_offset(s, field));
                }
            }
            NodeKind::Tuple => {
                for i in 0..NODES[n].count {
                    const_write(child(n, i), type_elem(ty, i), out, at + tuple_offset(ty, i));
                }
            }
            NodeKind::Array | NodeKind::Repeat => {
                let elem = TYPES[ty].a;
                let elem_size = type_size(elem);
                for i in 0..TYPES[ty].b {
                    let value = if NODES[n].kind == NodeKind::Array { child(n, i) } else { NODES[n].a };
                    const_write(value, elem, out, at + i * elem_size);
                }
            }
            NodeKind::VecOp if NODES[n].x == VK_NEW || NODES[n].x == VK_SPLAT => {
                // A vector of constant lanes (0.10).
                let elem = TYPES[ty].a;
                let elem_size = type_size(elem);
                for i in 0..TYPES[ty].b {
                    let value = if NODES[n].x == VK_NEW { child(n, i) } else { child(n, 0) };
                    const_write(value, elem, out, at + i * elem_size);
                }
            }
            NodeKind::Str => {
                // A string literal in an aggregate (0.9): its address, then
                // its length.
                CONST_RELOCS.push(at);
                CONST_RELOCS.push(NODES[n].a);
                write_scalar(out, at + 8, crate::front::lexer::STRS[NODES[n].a].len as i64, TY_I64);
            }
            NodeKind::CStr if is_pointer(ty) => {
                CONST_RELOCS.push(at);
                CONST_RELOCS.push(NODES[n].a);
            }
            NodeKind::VariantLit if is_compound(ty) => {
                let v = NODES[n].a;
                let tag = ENUMS[TYPES[ty].a].tag;
                write_scalar(out, at, wrap_int(VARIANTS[v].discr, tag), tag);
                for i in 0..NODES[n].count {
                    const_write(child(n, i), variant_field(v, i), out, at + variant_field_offset(v, i));
                }
            }
            _ => {
                if is_compound(ty) {
                    not_constant(n);
                }
                let value = const_eval(n);
                write_scalar(out, at, value, scalar_type(ty));
            }
        }
    }
}

// The bytes of a scalar constant, little-endian.
pub fn write_scalar(out: i64, at: i64, value: i64, ty: i64) {
    let size = type_size(ty);
    let mut bits = value as u64;
    if ty == TY_F32 {
        bits = f32_bits(f64_of_bits(value)) as u64;
    }
    for i in 0..size {
        unsafe { BUFS[out].data[at + i] = (bits >> (i * 8) as u64) as u8; }
    }
}
