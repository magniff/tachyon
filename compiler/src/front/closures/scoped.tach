// The `#[scoped]` rules (0.16; T2 makes them): no arena handle of a scope,
// and no container on it, outlives the scope. A closure taking a scoped
// parameter returns no type holding the scoped type (S2) and captures no
// variable whose type holds one (S3); statics and constants hold none
// (docs/design/effects-allocation.md §2.4).

// Checks closure c (its id, CLOSURES index) once its signature and
// captures are known (finish_closure).
pub fn check_closure(c: i64) {}
