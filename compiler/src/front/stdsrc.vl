        buf_str(out, c"        unsafe { msg_v(self.ptr, sel_152()); }\n    }\n}\n\nimpl MTLDrawableMethods for Ref<CAMetalDrawable> {\n    fn present(self) {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_v(self.ptr, sel_152()); }\n    }\n}\n\n/// The Objective-C protocol CAMetalDrawable.\npub struct CAMetalDrawable {}\n\npub trait CAMetalDrawableMethods {\n    // texture\n    fn texture(self) -> Ref<MTLTexture>;\n}\n\nimpl CAMetalDrawableMethods for Ref<CAMetalDrawable> {\n    fn texture(self) -> Ref<MTLTexture> {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { Ref::<MTLTexture>::from_raw(msg_p(self.ptr, sel_153()), &self.keep as *u8) }\n    }\n}\n\n/// The Objective-C class CAMetalLayer.\npub struct CAMetalLayer {}\n\npub trait CAMetalLayerMethods {\n    // setDevice:\n    fn set_device(self, device: Option<Ref<MTLDevice>>);\n    // setPixelFormat:\n    fn set_pixel_format(self, format: u64);\n    // setDrawableSize:\n    fn set_drawable_size(self, size: CGSize);\n    // drawableSize\n    fn drawable_size(self) -> CGSize;\n    // setFramebufferOnly:\n    fn set_framebuffer_only(self, only: bool);\n    // setMaximumDrawableCount:\n    fn set_maximum_drawable_count(self, count: u64);\n    // setDisplaySyncEnabled:\n    fn set_display_sync_enabled(self, enabled: bool);\n    // nextDrawable\n    fn next_drawable(self) -> Option<Ref<CAMetalDrawable>>;\n}\n\nimpl CAMetalLayerMethods for Ref<CAMetalLayer> {\n    fn set_device(self, device: Option<Ref<MTLDevice>>) {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_v_p(self.ptr, sel_154(), opt_ptr(device)); }\n    }\n    fn set_pixel_format(self, format: u64) {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_v_u64(self.ptr, sel_98(), format); }\n    }\n    fn set_drawable_size(self, size: CGSize) {\n");
        buf_str(out, c"        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_v_CGSize(self.ptr, sel_155(), size); }\n    }\n    fn drawable_size(self) -> CGSize {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_CGSize(self.ptr, sel_156()) }\n    }\n    fn set_framebuffer_only(self, only: bool) {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_v_bool(self.ptr, sel_157(), only); }\n    }\n    fn set_maximum_drawable_count(self, count: u64) {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_v_u64(self.ptr, sel_158(), count); }\n    }\n    fn set_display_sync_enabled(self, enabled: bool) {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_v_bool(self.ptr, sel_159(), enabled); }\n    }\n    fn next_drawable(self) -> Option<Ref<CAMetalDrawable>> {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { Ref::<CAMetalDrawable>::from_raw_opt(msg_p(self.ptr, sel_160()), &self.keep as *u8) }\n    }\n}\n\nimpl CAMetalLayer {\n    // +layer\n    pub fn layer() -> Ref<CAMetalLayer> {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { Ref::<CAMetalLayer>::from_global(msg_p(class_7(), sel_161())) }\n    }\n}\n\n// ---- end mod std::gpu::hal::metal::bindings ----\n}\n// ---- end mod std::gpu::hal::metal ----\n}\n// ---- end mod std::gpu::hal ----\n}\n// ---- mod std::gpu::shader ----\npub mod shader {\n// std::gpu::shader (0.22): what pipeline creation takes from the shader\n// compiler (docs/design/gpu.md §2.10): a module translated for one\n// backend, its code and its reflection. The WGSL compiler\n// (std::gpu::wgsl) produces a ShaderSource for the backend's ShaderKind\n");
        buf_str(out, c"// (`dev.caps().shader_kind`); programs that bring their own shaders write\n// both by hand.\n//\n// The reflection carries the native slots the writer chose, per stage\n// (Metal's [[buffer(n)]], [[texture(n)]], [[sampler(n)]]; a CUDA kernel's\n// parameter index): the hal binds what it is told and assumes no\n// numbering rule. The rule the MSL writer follows, so that compatible\n// layouts get the same slots: per stage, buffers, textures and samplers\n// each numbered from 0 in (group, binding) order over the bindings visible\n// in that stage; vertex buffers at Metal's 30 downward (vertex buffer i\n// at 30 - i).\n\nuse std::Buf;\nuse std::gpu::wgsl;\nuse std::gpu::types::{ShaderStage, VertexFormat};\n\n/// A (group, binding) pair.\npub type GroupBinding = [i64; 2];\n\n// ---- GPU shaders: sources and reflection (0.22) ----\n\n/// The form of a translated shader.\n#[derive(Eq, Debug, Clone)]\npub enum ShaderKind {\n    /// Metal Shading Language text (3.0), compiled by the driver.\n    Msl,\n    /// SPIR-V words (Vulkan).\n    Spirv,\n    /// PTX text (CUDA).\n    Ptx,\n}\n\n/// What a binding holds.\n#[derive(Eq, Debug, Clone)]\npub enum BindingType {\n    Uniform,\n    Storage,\n    ReadOnlyStorage,\n    Texture,\n    StorageTexture,\n    Sampler,\n    ComparisonSampler,\n}\n\nimpl BindingType {\n    #[pure]\n    pub fn is_buffer(self) -> bool {\n        match self {\n            BindingType::Uniform | BindingType::Storage | BindingType::ReadOnlyStorage => true,\n            _ => false,\n        }\n    }\n\n    #[pure]\n    pub fn is_texture(self) -> bool {\n        self == BindingType::Texture || self == BindingType::StorageTexture\n    }\n\n    #[pure]\n    pub fn is_sampler(self) -> bool {\n        self == BindingType::Sampler || self == BindingType::ComparisonSampler\n    }\n}\n\n/// One `@group(g) @binding(b)` of a shader, with its native slot in each\n/// stage (-1: not used there).\n#[derive(Eq, Debug, Clone)]\npub struct Binding {\n    pub group: i64,\n");
        buf_str(out, c"    pub binding: i64,\n    pub ty: BindingType,\n    pub slot_vertex: i64,\n    pub slot_fragment: i64,\n    pub slot_compute: i64,\n    pub min_size: i64,\n}\n\nimpl Binding {\n    #[pure]\n    pub fn visibility(self) -> u32 {\n        var v: u32 = 0;\n        if self.slot_vertex >= 0 { v = v | ShaderStage::VERTEX; }\n        if self.slot_fragment >= 0 { v = v | ShaderStage::FRAGMENT; }\n        if self.slot_compute >= 0 { v = v | ShaderStage::COMPUTE; }\n        v\n    }\n}\n\n/// An entry point: its WGSL name, its name in the translated code (MSL\n/// reserves some, `main` among them), its stage, a compute entry's\n/// workgroup size, and the native slot where it reads the sizes buffer\n/// (-1: it reads none; Reflection::sizes).\n#[derive(Eq)]\npub struct EntryPoint {\n    pub name: [u8],\n    pub native: [u8],\n    pub stage: u32,\n    pub workgroup: [i64; 3],\n    pub sizes_slot: i64,\n}\n\n/// A vertex entry point's input at `@location(n)`.\n#[derive(Eq, Debug, Clone)]\npub struct VertexInput {\n    pub location: i64,\n    pub format: VertexFormat,\n}\n\n/// A translated module's interface. Its names view the compiler's output\n/// (or the program's text); Device::shader copies what it keeps.\n///\n/// `sizes` is the sizes buffer's layout (Metal; the bounds checks of\n/// runtime-sized arrays, docs/design/gpu.md \"The sizes buffer\"): the\n/// (group, binding) of each runtime-sized storage binding, one u32 each in\n/// this order, the bytes the buffer bound there exposes. Before each\n/// dispatch or draw, std::gpu gives it (setBytes) at the `sizes_slot` of\n/// each stage's entry point that has one; the rule is wgsl::sizes_words's.\npub struct Reflection {\n    pub entries: Vec<EntryPoint>,\n    pub bindings: Vec<Binding>,\n    pub inputs: Vec<VertexInput>,\n    pub sizes: Vec<GroupBinding>,\n}\n\nimpl Reflection {\n    pub fn new_in(gpa: Gpa) -> Reflection {\n        Reflection {\n");
        buf_str(out, c"            entries: Vec::new_in(gpa), bindings: Vec::new_in(gpa), inputs: Vec::new_in(gpa),\n            sizes: Vec::new_in(gpa)\n        }\n    }\n\n    /// A compute entry point with its workgroup size.\n    pub fn compute(inout self, name: [u8], native: [u8], x: i64, y: i64 = 1, z: i64 = 1) {\n        self.entries.push(EntryPoint {\n            name: name, native: native, stage: ShaderStage::COMPUTE, workgroup: [x, y, z],\n            sizes_slot: -1\n        });\n    }\n\n    pub fn vertex(inout self, name: [u8], native: [u8]) {\n        self.entries.push(EntryPoint {\n            name: name, native: native, stage: ShaderStage::VERTEX, workgroup: [0, 0, 0],\n            sizes_slot: -1\n        });\n    }\n\n    pub fn fragment(inout self, name: [u8], native: [u8]) {\n        self.entries.push(EntryPoint {\n            name: name, native: native, stage: ShaderStage::FRAGMENT, workgroup: [0, 0, 0],\n            sizes_slot: -1\n        });\n    }\n\n    /// A binding and its slots (-1 where a stage does not use it).\n    pub fn bind(inout self, group: i64, binding: i64, ty: BindingType, vertex: i64 = -1,\n        fragment: i64 = -1, compute: i64 = -1, min_size: i64 = 0) {\n        self.bindings.push(Binding {\n            group: group, binding: binding, ty: ty, slot_vertex: vertex, slot_fragment: fragment,\n            slot_compute: compute, min_size: min_size\n        });\n    }\n\n    pub fn input(inout self, location: i64, format: VertexFormat) {\n        self.inputs.push(VertexInput { location: location, format: format });\n    }\n\n    /// The next word of the sizes buffer: the bytes bound at (group,\n    /// binding), a runtime-sized storage binding.\n    pub fn size_binding(inout self, group: i64, binding: i64) {\n        self.sizes.push([group, binding]);\n    }\n\n    /// The native slot where entry point `name` of `stage` reads the sizes\n    /// buffer (MSL: a `constant uint*` at [[buffer(slot)]]).\n");
        buf_str(out, c"    pub fn sizes_slot(inout self, name: [u8], stage: u32, slot: i64) {\n        for i in 0..self.entries.len() {\n            if self.entries[i].name == name && self.entries[i].stage == stage {\n                self.entries[i].sizes_slot = slot;\n            }\n        }\n    }\n}\n\n/// A module translated for one backend: its code (text or words, as\n/// bytes) and its reflection; the shader compiler's output.\npub struct ShaderSource {\n    pub kind: ShaderKind,\n    pub code: [u8],\n    pub reflection: Reflection,\n}\n\nimpl ShaderSource {\n    /// MSL text and its reflection.\n    pub fn msl(code: [u8], reflection: sink Reflection) -> ShaderSource {\n        ShaderSource { kind: ShaderKind::Msl, code: code, reflection: reflection }\n    }\n}\n\n// ---- GPU shaders: from std::gpu::wgsl (0.22) ----\n\n/// The VertexFormat of a WGSL vertex input of scalar `scalar`\n/// (wgsl::ir::SK_*) and `components` components; None where VertexFormat\n/// has no variant (vec3<u32>, vec2..4<i32>, bool). An input of f32s is\n/// also fed by Unorm8x4 (VertexFormat::shader_type).\npub fn wgsl_vertex_format(scalar: u8, components: i64) -> Option<VertexFormat> {\n    if scalar == wgsl::ir::SK_F32 {\n        if components == 1 { return Some(VertexFormat::Float32); }\n        if components == 2 { return Some(VertexFormat::Float32x2); }\n        if components == 3 { return Some(VertexFormat::Float32x3); }\n        if components == 4 { return Some(VertexFormat::Float32x4); }\n    } else if scalar == wgsl::ir::SK_U32 {\n        if components == 1 { return Some(VertexFormat::Uint32); }\n        if components == 2 { return Some(VertexFormat::Uint32x2); }\n        if components == 4 { return Some(VertexFormat::Uint32x4); }\n    } else if scalar == wgsl::ir::SK_I32 {\n        if components == 1 { return Some(VertexFormat::Sint32); }\n    }\n    None\n}\n\n/// The ShaderStage bit of a wgsl::ir::STAGE_*.\nfn wgsl_stage(stage: u8) -> u32 {\n    if stage == wgsl::ir::STAGE_VERTEX {\n");
        buf_str(out, c"        ShaderStage::VERTEX\n    } else if stage == wgsl::ir::STAGE_FRAGMENT {\n        ShaderStage::FRAGMENT\n    } else {\n        ShaderStage::COMPUTE\n    }\n}\n\n/// The BindingType of a wgsl::BK_* (the same order).\nfn wgsl_binding_type(kind: u8) -> BindingType {\n    match kind {\n        0 => BindingType::Uniform,\n        1 => BindingType::Storage,\n        2 => BindingType::ReadOnlyStorage,\n        3 => BindingType::Texture,\n        4 => BindingType::StorageTexture,\n        5 => BindingType::Sampler,\n        _ => BindingType::ComparisonSampler,\n    }\n}\n\n/// The reflection pipeline creation takes, from the WGSL compiler's\n/// (docs/design/gpu.md, \"Merging with std::gpu\"): the entry points (WGSL\n/// name, name in the translated code, stage, workgroup size, sizes buffer\n/// slot), the bindings (kind, slot per stage, minimum size), the vertex\n/// inputs, and the sizes buffer's layout. Its names view `refl`'s, which\n/// must outlive it. Err: the message for a vertex input no VertexFormat\n/// holds.\npub fn from_wgsl(refl: wgsl::Reflection, gpa: Gpa) -> Result<Reflection, Buf> {\n    var out = Reflection::new_in(gpa);\n    for i in 0..refl.entries.len() {\n        // (the names view refl.entries[i] itself, not a copy of it)\n        out.entries.push(EntryPoint {\n            name: refl.entries[i].name.as_slice(), native: refl.entries[i].target_name.as_slice(),\n            stage: wgsl_stage(refl.entries[i].stage), workgroup: refl.entries[i].workgroup,\n            sizes_slot: refl.entries[i].sizes_slot\n        });\n    }\n    for i in 0..refl.bindings.len() {\n        let b = refl.bindings[i];\n        out.bindings.push(Binding {\n            group: b.group, binding: b.binding, ty: wgsl_binding_type(b.kind),\n            slot_vertex: b.slots[0], slot_fragment: b.slots[1], slot_compute: b.slots[2],\n            min_size: b.min_size\n        });\n    }\n    for i in 0..refl.inputs.len() {\n        let v = refl.inputs[i];\n");
        buf_str(out, c"        match wgsl_vertex_format(v.scalar, v.components) {\n            Some(f) => out.input(v.location, f),\n            None => return Err(format_in(\n                f\"gpu: the vertex input at @location({v.location}) has no VertexFormat (f32 x1..4, u32 x1, x2, x4, i32 x1)\",\n                gpa)),\n        }\n    }\n    for i in 0..refl.sizes.len() {\n        let b = refl.bindings[refl.sizes[i]];\n        out.size_binding(b.group, b.binding);\n    }\n    Ok(out)\n}\n// ---- end mod std::gpu::shader ----\n}\n// ---- mod std::gpu::types ----\npub mod types {\n// std::gpu::types (0.22): flags, formats, descriptors (docs/design/gpu.md,\n// §2.2), re-exported by std::gpu. Flags are u32 constants in modules named\n// like the types the design makes them (`type BufferUsage = distinct\n// u32`): a distinct type cannot have named constants yet, so a BufferUsage\n// passed as a TextureUsage is not a type error until it can. Descriptors\n// are small plain structs with constructors for the common cases; their\n// fields are public, to change what differs.\n\n// ---- GPU types: flags, formats, descriptors (0.22) ----\n\n/// What a buffer may be used for (wgpu's values).\npub mod BufferUsage {\n    pub const MAP_READ: u32 = 1;\n    pub const MAP_WRITE: u32 = 2;\n    pub const COPY_SRC: u32 = 4;\n    pub const COPY_DST: u32 = 8;\n    pub const INDEX: u32 = 16;\n    pub const VERTEX: u32 = 32;\n    pub const UNIFORM: u32 = 64;\n    pub const STORAGE: u32 = 128;\n    pub const INDIRECT: u32 = 256;\n}\n\n/// What a texture may be used for (wgpu's values).\npub mod TextureUsage {\n    pub const COPY_SRC: u32 = 1;\n    pub const COPY_DST: u32 = 2;\n    pub const TEXTURE_BINDING: u32 = 4;\n    pub const STORAGE_BINDING: u32 = 8;\n    pub const RENDER_ATTACHMENT: u32 = 16;\n}\n\n/// The shader stages a binding is visible in.\npub mod ShaderStage {\n    pub const VERTEX: u32 = 1;\n    pub const FRAGMENT: u32 = 2;\n    pub const COMPUTE: u32 = 4;\n}\n\n");
        buf_str(out, c"/// Which adapter `Instance::adapter` prefers.\n#[derive(Eq, Debug, Clone)]\npub enum Power {\n    Low,\n    High,\n}\n\n/// Texture formats: the ones the backends and tests use.\n#[derive(Eq, Debug, Clone)]\npub enum Format {\n    R8Unorm,\n    R8Uint,\n    Rg8Unorm,\n    R16Float,\n    R32Uint,\n    R32Sint,\n    R32Float,\n    Rg16Float,\n    Rgba8Unorm,\n    Rgba8UnormSrgb,\n    Rgba8Uint,\n    Bgra8Unorm,\n    Bgra8UnormSrgb,\n    Rg32Float,\n    Rgba16Float,\n    Rgba32Uint,\n    Rgba32Float,\n    Depth32Float,\n}\n\nimpl Format {\n    /// Bytes per texel.\n    #[pure]\n    pub fn size(self) -> i64 {\n        match self {\n            Format::R8Unorm | Format::R8Uint => 1,\n            Format::Rg8Unorm | Format::R16Float => 2,\n            Format::R32Uint | Format::R32Sint | Format::R32Float | Format::Rg16Float => 4,\n            Format::Rgba8Unorm | Format::Rgba8UnormSrgb | Format::Rgba8Uint => 4,\n            Format::Bgra8Unorm | Format::Bgra8UnormSrgb | Format::Depth32Float => 4,\n            Format::Rg32Float | Format::Rgba16Float => 8,\n            Format::Rgba32Uint | Format::Rgba32Float => 16,\n        }\n    }\n\n    #[pure]\n    pub fn is_depth(self) -> bool {\n        self == Format::Depth32Float\n    }\n\n    /// Whether a render pass may draw into it.\n    #[pure]\n    pub fn is_renderable(self) -> bool {\n        true\n    }\n\n    /// Whether a compute or fragment shader may write it as a storage\n    /// texture (WebGPU's storage formats among these).\n    #[pure]\n    pub fn is_storable(self) -> bool {\n        match self {\n            Format::R32Uint | Format::R32Sint | Format::R32Float | Format::Rgba8Unorm\n                | Format::Rgba8Uint => true,\n            Format::Rg32Float | Format::Rgba16Float | Format::Rgba32Uint\n                | Format::Rgba32Float => true,\n            _ => false,\n        }\n    }\n}\n\n/// Formats of vertex attributes.\n#[derive(Eq, Debug, Clone)]\npub enum VertexFormat {\n    Float32,\n    Float32x2,\n");
        buf_str(out, c"    Float32x3,\n    Float32x4,\n    Uint32,\n    Uint32x2,\n    Uint32x4,\n    Sint32,\n    Unorm8x4,\n}\n\nimpl VertexFormat {\n    /// What the shader reads: the scalar (0 f32, 1 u32, 2 i32) times 8\n    /// plus the component count. Formats with one shader type feed the same\n    /// inputs (WebGPU's rule: Unorm8x4 feeds a vec4<f32>, as Float32x4 does).\n    #[pure]\n    pub fn shader_type(self) -> i64 {\n        match self {\n            VertexFormat::Float32 => 1,\n            VertexFormat::Float32x2 => 2,\n            VertexFormat::Float32x3 => 3,\n            VertexFormat::Float32x4 | VertexFormat::Unorm8x4 => 4,\n            VertexFormat::Uint32 => 9,\n            VertexFormat::Uint32x2 => 10,\n            VertexFormat::Uint32x4 => 12,\n            VertexFormat::Sint32 => 17,\n        }\n    }\n\n    #[pure]\n    pub fn size(self) -> i64 {\n        match self {\n            VertexFormat::Float32 | VertexFormat::Uint32 | VertexFormat::Sint32\n                | VertexFormat::Unorm8x4 => 4,\n            VertexFormat::Float32x2 | VertexFormat::Uint32x2 => 8,\n            VertexFormat::Float32x3 => 12,\n            VertexFormat::Float32x4 | VertexFormat::Uint32x4 => 16,\n        }\n    }\n}\n\n#[derive(Eq, Debug, Clone)]\npub enum StepMode {\n    Vertex,\n    Instance,\n}\n\n#[derive(Eq, Debug, Clone)]\npub enum IndexFormat {\n    Uint16,\n    Uint32,\n}\n\nimpl IndexFormat {\n    #[pure]\n    pub fn size(self) -> i64 {\n        match self {\n            IndexFormat::Uint16 => 2,\n            IndexFormat::Uint32 => 4,\n        }\n    }\n}\n\n#[derive(Eq, Debug, Clone)]\npub enum Topology {\n    PointList,\n    LineList,\n    LineStrip,\n    TriangleList,\n    TriangleStrip,\n}\n\n#[derive(Eq, Debug, Clone)]\npub enum Cull {\n    None,\n    Front,\n    Back,\n}\n\n#[derive(Eq, Debug, Clone)]\npub enum FrontFace {\n    Ccw,\n    Cw,\n}\n\n#[derive(Eq, Debug, Clone)]\npub enum Compare {\n    Never,\n    Less,\n    Equal,\n    LessEqual,\n    Greater,\n    NotEqual,\n");
        buf_str(out, c"    GreaterEqual,\n    Always,\n}\n\n#[derive(Eq, Debug, Clone)]\npub enum Filter {\n    Nearest,\n    Linear,\n}\n\n#[derive(Eq, Debug, Clone)]\npub enum AddressMode {\n    ClampToEdge,\n    Repeat,\n    MirrorRepeat,\n}\n\n#[derive(Eq, Debug, Clone)]\npub enum BlendFactor {\n    Zero,\n    One,\n    Src,\n    OneMinusSrc,\n    SrcAlpha,\n    OneMinusSrcAlpha,\n    Dst,\n    OneMinusDst,\n    DstAlpha,\n    OneMinusDstAlpha,\n}\n\n#[derive(Eq, Debug, Clone)]\npub enum BlendOp {\n    Add,\n    Subtract,\n    ReverseSubtract,\n    Min,\n    Max,\n}\n\n/// One blend equation: src * src_factor OP dst * dst_factor.\n#[derive(Eq, Debug, Clone)]\npub struct BlendComponent {\n    pub src: BlendFactor,\n    pub dst: BlendFactor,\n    pub op: BlendOp,\n}\n\n/// A color target's blending; `None` in ColorTarget writes the source.\n#[derive(Eq, Debug, Clone)]\npub struct Blend {\n    pub color: BlendComponent,\n    pub alpha: BlendComponent,\n}\n\nimpl Blend {\n    /// Source over destination, straight alpha (wgpu's ALPHA_BLENDING).\n    pub fn alpha() -> Blend {\n        Blend {\n            color: BlendComponent {\n                src: BlendFactor::SrcAlpha, dst: BlendFactor::OneMinusSrcAlpha, op: BlendOp::Add\n            },\n            alpha: BlendComponent {\n                src: BlendFactor::One, dst: BlendFactor::OneMinusSrcAlpha, op: BlendOp::Add\n            },\n        }\n    }\n\n    /// Premultiplied alpha.\n    pub fn premultiplied() -> Blend {\n        Blend {\n            color: BlendComponent {\n                src: BlendFactor::One, dst: BlendFactor::OneMinusSrcAlpha, op: BlendOp::Add\n            },\n            alpha: BlendComponent {\n                src: BlendFactor::One, dst: BlendFactor::OneMinusSrcAlpha, op: BlendOp::Add\n            },\n        }\n    }\n\n    /// src + dst.\n    pub fn additive() -> Blend {\n        Blend {\n            color: BlendComponent {\n                src: BlendFactor::One, dst: BlendFactor::One, op: BlendOp::Add\n");
        buf_str(out, c"            },\n            alpha: BlendComponent {\n                src: BlendFactor::One, dst: BlendFactor::One, op: BlendOp::Add\n            },\n        }\n    }\n}\n\n/// A clear color, components in 0..1 for normalized formats.\n#[derive(Eq, Debug, Clone)]\npub struct Color {\n    pub r: f64,\n    pub g: f64,\n    pub b: f64,\n    pub a: f64,\n}\n\nimpl Color {\n    pub fn rgba(r: f64, g: f64, b: f64, a: f64) -> Color {\n        Color { r: r, g: g, b: b, a: a }\n    }\n\n    pub fn black() -> Color {\n        Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }\n    }\n\n    pub fn transparent() -> Color {\n        Color { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }\n    }\n}\n\n/// A sampler's description; `SamplerDesc::nearest()` and `::linear()`\n/// are the common ones.\n#[derive(Eq, Debug, Clone)]\npub struct SamplerDesc {\n    pub mag: Filter,\n    pub min: Filter,\n    pub mip: Filter,\n    pub address_u: AddressMode,\n    pub address_v: AddressMode,\n    pub address_w: AddressMode,\n    pub lod_min: f32,\n    pub lod_max: f32,\n    pub compare: Option<Compare>,\n    pub anisotropy: i64,\n}\n\nimpl SamplerDesc {\n    pub fn nearest() -> SamplerDesc {\n        SamplerDesc {\n            mag: Filter::Nearest,\n            min: Filter::Nearest,\n            mip: Filter::Nearest,\n            address_u: AddressMode::ClampToEdge,\n            address_v: AddressMode::ClampToEdge,\n            address_w: AddressMode::ClampToEdge,\n            lod_min: 0.0,\n            lod_max: 32.0,\n            compare: None,\n            anisotropy: 1,\n        }\n    }\n\n    pub fn linear() -> SamplerDesc {\n        var d = SamplerDesc::nearest();\n        d.mag = Filter::Linear;\n        d.min = Filter::Linear;\n        d.mip = Filter::Linear;\n        d\n    }\n}\n\n/// A texture's description (2D, or a 2D array with layers > 1).\n#[derive(Eq, Debug, Clone)]\npub struct TextureDesc {\n    pub width: i64,\n    pub height: i64,\n    pub layers: i64,\n    pub mips: i64,\n    pub format: Format,\n");
        buf_str(out, c"    pub usage: u32,\n}\n\n/// The device's limits (wgpu's names; the defaults hold on Metal and on\n/// lavapipe).\n#[derive(Eq, Debug, Clone)]\npub struct Limits {\n    pub max_texture_dimension_2d: i64,\n    pub max_texture_array_layers: i64,\n    pub max_bind_groups: i64,\n    pub max_bindings_per_group: i64,\n    pub max_buffer_size: i64,\n    pub max_vertex_buffers: i64,\n    pub max_vertex_attributes: i64,\n    pub max_color_attachments: i64,\n    pub min_uniform_buffer_offset_alignment: i64,\n    pub min_storage_buffer_offset_alignment: i64,\n    pub max_compute_workgroup_size_x: i64,\n    pub max_compute_workgroup_size_y: i64,\n    pub max_compute_workgroup_size_z: i64,\n    pub max_compute_invocations_per_workgroup: i64,\n    pub max_compute_workgroups_per_dimension: i64,\n}\n\nimpl Limits {\n    pub fn default() -> Limits {\n        Limits {\n            max_texture_dimension_2d: 16384,\n            max_texture_array_layers: 2048,\n            max_bind_groups: 4,\n            max_bindings_per_group: 16,\n            max_buffer_size: 1 << 30,\n            max_vertex_buffers: 8,\n            max_vertex_attributes: 16,\n            max_color_attachments: 8,\n            min_uniform_buffer_offset_alignment: 256,\n            min_storage_buffer_offset_alignment: 256,\n            max_compute_workgroup_size_x: 1024,\n            max_compute_workgroup_size_y: 1024,\n            max_compute_workgroup_size_z: 64,\n            max_compute_invocations_per_workgroup: 1024,\n            max_compute_workgroups_per_dimension: 65535,\n        }\n    }\n}\n\n/// One attribute of a vertex buffer: `@location(location)` reads `format`\n/// at `offset` in each element.\n#[derive(Eq, Debug, Clone)]\npub struct VertexAttribute {\n    pub format: VertexFormat,\n    pub offset: i64,\n    pub location: i64,\n}\n\npub const MAX_VERTEX_ATTRIBUTES: i64 = 8;\npub const MAX_VERTEX_BUFFERS: i64 = 8;\npub const MAX_COLOR_TARGETS: i64 = 8;\npub const MAX_BIND_GROUPS: i64 = 4;\n\n");
        buf_str(out, c"/// A vertex buffer's layout: its stride, step mode and attributes (at most\n/// MAX_VERTEX_ATTRIBUTES, kept in a fixed array: no allocation).\n#[derive(Eq)]\npub struct VertexLayout {\n    pub stride: i64,\n    pub step: StepMode,\n    pub attributes: [VertexAttribute; 8],\n    pub count: i64,\n}\n\nimpl VertexLayout {\n    pub fn new(stride: i64, step: StepMode = StepMode::Vertex) -> VertexLayout {\n        VertexLayout {\n            stride: stride, step: step,\n            attributes: [VertexAttribute { format: VertexFormat::Float32, offset: 0, location: 0 };\n                8], count: 0\n        }\n    }\n\n    pub fn attribute(inout self, location: i64, format: VertexFormat, offset: i64)\n        requires self.count < MAX_VERTEX_ATTRIBUTES\n        else \"gpu.limits: at most 8 attributes in a vertex buffer\"\n        {\n        self.attributes[self.count] = VertexAttribute {\n            format: format, offset: offset, location: location\n        };\n        self.count += 1;\n    }\n}\n\n/// A color target of a render pipeline.\n#[derive(Eq, Debug, Clone)]\npub struct ColorTarget {\n    pub format: Format,\n    pub blend: Option<Blend>,\n    pub write_mask: u32,\n}\n\n/// The depth test of a render pipeline.\n#[derive(Eq, Debug, Clone)]\npub struct DepthState {\n    pub format: Format,\n    pub write: bool,\n    pub compare: Compare,\n}\n\n/// Everything about a render pipeline but its shaders: plain data, so\n/// that the hal takes it as it is.\n#[derive(Eq)]\npub struct PipelineState {\n    pub topology: Topology,\n    pub cull: Cull,\n    pub front_face: FrontFace,\n    pub buffers: [VertexLayout; 8],\n    pub buffer_count: i64,\n    pub targets: [ColorTarget; 8],\n    pub target_count: i64,\n    pub depth: Option<DepthState>,\n}\n\nimpl PipelineState {\n    pub fn new(format: Format) -> PipelineState {\n        let t = ColorTarget { format: format, blend: None, write_mask: 15 };\n        PipelineState {\n            topology: Topology::TriangleList,\n");
        buf_str(out, c"            cull: Cull::None,\n            front_face: FrontFace::Ccw,\n            buffers: [VertexLayout::new(0); 8],\n            buffer_count: 0,\n            targets: [t; 8],\n            target_count: 1,\n            depth: None,\n        }\n    }\n}\n\n/// How a render pass starts with an attachment.\n#[derive(Eq, Debug, Clone)]\npub enum Load {\n    Clear,\n    Keep,\n    DontCare,\n}\n// ---- end mod std::gpu::types ----\n}\n// ---- mod std::gpu::wgsl ----\npub mod wgsl {\n// std::gpu::wgsl (0.22, docs/design/gpu.md §2.10): the shader compiler.\n// WGSL (the subset of §2.10) is parsed, resolved and type-checked into a\n// target-neutral IR (ir.vl: types, expressions, structured statements,\n// entry points; nothing of any target), every index gets its bounds check\n// (bounds.vl), and a back end writes it: MSL for Metal (msl.vl), or\n// the CPU interpreter runs it (interp.vl: the tests' oracle). SPIR-V\n// (spirv.vl) and other targets (PTX) are back ends over the same IR.\n//\n//   var out = Buf::new_in(gpa);\n//   var refl = wgsl::new_reflection(gpa);\n//   var err = wgsl::new_error(gpa);\n//   if !wgsl::translate(src, wgsl::options(wgsl::TARGET_MSL), &out, &refl, &err, gpa) {\n//       // err: code (wgsl.*), line, col, msg, help\n//   }\n//\n// A translation allocates from an arena of its own, freed at its end, and\n// does no io. `tools/wgslc` is the command line; tests/wgsl/run.sh runs\n// the cases on the interpreter and on Metal.\n\npub mod ir;\npub mod names;\npub mod lex;\npub mod front;\npub mod expr;\npub mod builtins;\npub mod entry;\npub mod bounds;\npub mod uniformity;\npub mod msl;\npub mod spirv;\npub mod interp;\npub mod dump;\npub mod job;\npub mod api;\n\npub use api::{\n    BK_COMPARISON_SAMPLER, BK_READ_ONLY_STORAGE, BK_SAMPLER, BK_STORAGE, BK_STORAGE_TEXTURE,\n    BK_TEXTURE, BK_UNIFORM, BindingInfo, EntryInfo, InputInfo, Options, Reflection, ShaderError,\n");
        buf_str(out, c"    TARGET_CHECK, TARGET_IR, TARGET_MSL, TARGET_SPIRV, line_col, new_error, new_reflection, options,\n    sizes_words, translate,\n};\n// ---- mod std::gpu::wgsl::ir ----\npub mod ir {\n// ---- Shader compiler implementation, ir (0.22) ----\n// The shader IR (docs/design/gpu.md §2.10): what the front end makes\n// from WGSL and the back ends (MSL, SPIR-V, the interpreter) read. It is\n// plain data: i64 handles into Vecs, one arena per translation.\n//\n// - Types are module-wide and interned: a handle is equal for equal types.\n//   The scalar, vector and matrix types have fixed handles (`vec_ty`,\n//   `mat_ty`); the rest are found through `types_map`.\n// - A function has an expression arena, a statement arena and blocks\n//   (runs of statement handles in `items`). Expressions are evaluated\n//   where an `S_EMIT` statement covers them, in order, except the results\n//   of calls and atomics (made by their statement) and the leaves\n//   (literals, arguments, variables), which have no cost.\n// - Every index has a bounds check (D15): `E_ACCESS.c` is the check's\n//   kind, set by bounds.vl; a back end never sees `CK_PENDING`.\n//\n// Moves to compiler/std/gpu/wgsl/ir.vl with C2 (std submodules).\n\nuse std::{Allocator, Buf, Eq, Hash, HashMap, ScopedArena, Vec};\nuse std::Option::{None, Some};\n\n// ---- Shader compiler implementation, ir: Scalars (0.22) ----\n\npub const SK_BOOL: u8 = 0;\npub const SK_I32: u8 = 1;\npub const SK_U32: u8 = 2;\npub const SK_F32: u8 = 3;\n// Abstract numbers exist only in the front end (const evaluation).\npub const SK_AINT: u8 = 4;\npub const SK_AFLOAT: u8 = 5;\n\n// ---- Shader compiler implementation, ir: Types (0.22) ----\n\npub const TK_SCALAR: u8 = 0;\npub const TK_VECTOR: u8 = 1;\n// n columns of m rows of f32\npub const TK_MATRIX: u8 = 2;\n// base: the element; n: the length, 0 when runtime-sized\npub const TK_ARRAY: u8 = 3;\npub const TK_STRUCT: u8 = 4;\npub const TK_ATOMIC: u8 = 5;\n// base: the pointee; space, access\n");
        buf_str(out, c"pub const TK_POINTER: u8 = 6;\n// scalar: the sampled kind; n: TEX_*; access for storage textures; m: the texel format\npub const TK_TEXTURE: u8 = 7;\n// n: 1 for sampler_comparison\npub const TK_SAMPLER: u8 = 8;\n\npub const TEX_2D: i64 = 0;\npub const TEX_2D_ARRAY: i64 = 1;\npub const TEX_DEPTH_2D: i64 = 2;\npub const TEX_STORAGE_2D: i64 = 3;\n\n// Texel formats of storage textures (TK_TEXTURE.m).\npub const FMT_RGBA8UNORM: i64 = 0;\npub const FMT_RGBA32FLOAT: i64 = 1;\npub const FMT_R32FLOAT: i64 = 2;\npub const FMT_R32UINT: i64 = 3;\npub const FMT_R32SINT: i64 = 4;\npub const FMT_RGBA32UINT: i64 = 5;\n\n// Address spaces.\npub const SP_FUNCTION: u8 = 0;\npub const SP_PRIVATE: u8 = 1;\npub const SP_WORKGROUP: u8 = 2;\npub const SP_UNIFORM: u8 = 3;\npub const SP_STORAGE: u8 = 4;\n// textures and samplers: no address space, the global is the value\npub const SP_HANDLE: u8 = 5;\n\n// Access modes (bits).\npub const ACC_READ: u8 = 1;\npub const ACC_WRITE: u8 = 2;\npub const ACC_RW: u8 = 3;\n\npub struct Type {\n    kind: u8,\n    scalar: u8,\n    space: u8,\n    access: u8,\n    n: i64,\n    m: i64,\n    base: i64,\n    // struct members: members[mstart .. mstart + mcount]\n    mstart: i64,\n    mcount: i64,\n    name: [u8],\n    // the WGSL memory layout, in bytes (every type, every address space)\n    size: i64,\n    align: i64,\n    // arrays: the element stride; matrices: the column stride\n    stride: i64,\n}\n\n// What an entry point's parameter, result or IO struct member is bound to.\npub const BIND_NONE: u8 = 0;\npub const BIND_BUILTIN: u8 = 1;\npub const BIND_LOCATION: u8 = 2;\n\npub const INTERP_PERSPECTIVE: u8 = 0;\npub const INTERP_LINEAR: u8 = 1;\npub const INTERP_FLAT: u8 = 2;\n\npub struct Binding { kind: u8, interp: u8, value: i64 }\n\npub fn no_binding() -> Binding {\n    Binding { kind: BIND_NONE, interp: INTERP_PERSPECTIVE, value: 0 }\n}\n\npub const BI_POSITION: i64 = 0;\npub const BI_VERTEX_INDEX: i64 = 1;\npub const BI_INSTANCE_INDEX: i64 = 2;\n");
        buf_str(out, c"pub const BI_FRONT_FACING: i64 = 3;\npub const BI_FRAG_DEPTH: i64 = 4;\npub const BI_SAMPLE_INDEX: i64 = 5;\npub const BI_SAMPLE_MASK: i64 = 6;\npub const BI_LOCAL_INVOCATION_ID: i64 = 7;\npub const BI_LOCAL_INVOCATION_INDEX: i64 = 8;\npub const BI_GLOBAL_INVOCATION_ID: i64 = 9;\npub const BI_WORKGROUP_ID: i64 = 10;\npub const BI_NUM_WORKGROUPS: i64 = 11;\n\npub struct StructMember { name: [u8], ty: i64, offset: i64, binding: Binding }\n\n// ---- Shader compiler implementation, ir: Expressions (0.22) ----\n\n// a: the bits (a u32 for i32, u32, f32; 0 or 1 for bool)\npub const E_LITERAL: u8 = 0;\npub const E_ZERO: u8 = 1;\n// a, b: args[a .. a + b]: scalars and vectors for a vector, columns for a\n// matrix, elements, members\npub const E_COMPOSE: u8 = 2;\n// a: a scalar\npub const E_SPLAT: u8 = 3;\n// a: the vector; b: the components, 2 bits each from bit 0; c: how many\npub const E_SWIZZLE: u8 = 4;\n// a: base (a pointer or a value); b: the index expression; c: CK_*;\n// d: the length when the check is a clamp\npub const E_ACCESS: u8 = 5;\n// a: base (a pointer or a value); b: the constant index (a member, or a\n// component of a vector, matrix or fixed-size array, checked statically)\npub const E_ACCESS_INDEX: u8 = 6;\n// a: the parameter's index\npub const E_ARG: u8 = 7;\n// a: the global; its type is a pointer (a texture or sampler: the handle)\npub const E_GLOBAL: u8 = 8;\n// a: the local; a pointer<function>\npub const E_LOCAL: u8 = 9;\n// a: the pointer\npub const E_LOAD: u8 = 10;\n// a: UN_*; b: the operand\npub const E_UNARY: u8 = 11;\n// a: OP_*; b, c: the operands\npub const E_BINARY: u8 = 12;\n// a: the condition (bool, or a vector of bool); b: if true; c: if false\npub const E_SELECT: u8 = 13;\n// a: MF_*; b, c: args[b .. b + c]\npub const E_MATH: u8 = 14;\n// a: the operand; the type is the target (value conversion)\npub const E_CONVERT: u8 = 15;\n// a: the operand; the type is the target (bits)\npub const E_BITCAST: u8 = 16;\n// made by S_CALL\n");
        buf_str(out, c"pub const E_CALL_RESULT: u8 = 17;\n// made by S_ATOMIC\npub const E_ATOMIC_RESULT: u8 = 18;\n// a: a pointer to a runtime-sized array (or a struct ending in one: b is\n// then the member index, else -1)\npub const E_ARRAY_LENGTH: u8 = 19;\n// a: DV_*; b: the operand\npub const E_DERIVATIVE: u8 = 20;\n// a: the texture; b: the sampler; c: args[c .. c + d] (coords, then\n// array index, bias/level/depth ref as `aux`): see IMG_*\npub const E_IMAGE_SAMPLE: u8 = 21;\n// a: the texture; c: args (coords, array index, level)\npub const E_IMAGE_LOAD: u8 = 22;\n// a: the texture; b: IQ_*; c: the level expression or -1\npub const E_IMAGE_QUERY: u8 = 23;\n// a: the pointer; made by S_WG_UNIFORM_LOAD\npub const E_WG_UNIFORM_RESULT: u8 = 24;\n\n// Bounds checks of E_ACCESS.\npub const CK_PENDING: i64 = 0;\n// proven in range: no check\npub const CK_NONE: i64 = 1;\n// fixed length d: index = min(index, d - 1)\npub const CK_CLAMP: i64 = 2;\n// runtime-sized: out of range, a load reads zero and a store is skipped\npub const CK_RZSW: i64 = 3;\n\npub const UN_NEG: i64 = 0;\npub const UN_NOT: i64 = 1;\npub const UN_BITNOT: i64 = 2;\n\npub const OP_ADD: i64 = 0;\npub const OP_SUB: i64 = 1;\npub const OP_MUL: i64 = 2;\npub const OP_DIV: i64 = 3;\npub const OP_MOD: i64 = 4;\npub const OP_EQ: i64 = 5;\npub const OP_NE: i64 = 6;\npub const OP_LT: i64 = 7;\npub const OP_LE: i64 = 8;\npub const OP_GT: i64 = 9;\npub const OP_GE: i64 = 10;\n// bitwise on integers; logical (both operands evaluated) on bool\npub const OP_AND: i64 = 11;\npub const OP_OR: i64 = 12;\npub const OP_XOR: i64 = 13;\npub const OP_SHL: i64 = 14;\npub const OP_SHR: i64 = 15;\n// short-circuit forms are lowered to control flow when the right side\n// has effects; else they are these, on bool\npub const OP_LAND: i64 = 16;\npub const OP_LOR: i64 = 17;\n\n// Math functions (E_MATH). Component-wise unless noted.\npub const MF_ABS: i64 = 0;\npub const MF_MIN: i64 = 1;\npub const MF_MAX: i64 = 2;\npub const MF_CLAMP: i64 = 3;\n");
        buf_str(out, c"pub const MF_SIGN: i64 = 4;\npub const MF_FLOOR: i64 = 5;\npub const MF_CEIL: i64 = 6;\npub const MF_ROUND: i64 = 7;\npub const MF_FRACT: i64 = 8;\npub const MF_TRUNC: i64 = 9;\npub const MF_SQRT: i64 = 10;\npub const MF_INVERSE_SQRT: i64 = 11;\npub const MF_EXP: i64 = 12;\npub const MF_EXP2: i64 = 13;\npub const MF_LOG: i64 = 14;\npub const MF_LOG2: i64 = 15;\npub const MF_POW: i64 = 16;\npub const MF_SIN: i64 = 17;\npub const MF_COS: i64 = 18;\npub const MF_TAN: i64 = 19;\npub const MF_ASIN: i64 = 20;\npub const MF_ACOS: i64 = 21;\npub const MF_ATAN: i64 = 22;\npub const MF_ATAN2: i64 = 23;\npub const MF_SINH: i64 = 24;\npub const MF_COSH: i64 = 25;\npub const MF_TANH: i64 = 26;\npub const MF_MIX: i64 = 27;\npub const MF_STEP: i64 = 28;\npub const MF_SMOOTHSTEP: i64 = 29;\npub const MF_FMA: i64 = 30;\n// the rest reduce or are not component-wise\npub const MF_LENGTH: i64 = 31;\npub const MF_DISTANCE: i64 = 32;\npub const MF_DOT: i64 = 33;\npub const MF_CROSS: i64 = 34;\npub const MF_NORMALIZE: i64 = 35;\npub const MF_REFLECT: i64 = 36;\npub const MF_DETERMINANT: i64 = 37;\npub const MF_TRANSPOSE: i64 = 38;\npub const MF_COUNT_ONE_BITS: i64 = 39;\npub const MF_COUNT_LEADING_ZEROS: i64 = 40;\npub const MF_COUNT_TRAILING_ZEROS: i64 = 41;\npub const MF_FIRST_LEADING_BIT: i64 = 42;\npub const MF_FIRST_TRAILING_BIT: i64 = 43;\npub const MF_REVERSE_BITS: i64 = 44;\npub const MF_EXTRACT_BITS: i64 = 45;\npub const MF_INSERT_BITS: i64 = 46;\npub const MF_ALL: i64 = 47;\npub const MF_ANY: i64 = 48;\npub const MF_DEGREES: i64 = 49;\npub const MF_RADIANS: i64 = 50;\npub const MF_SATURATE: i64 = 51;\npub const MF_PACK4X8UNORM: i64 = 52;\npub const MF_UNPACK4X8UNORM: i64 = 53;\npub const MF_PACK2X16FLOAT: i64 = 54;\npub const MF_UNPACK2X16FLOAT: i64 = 55;\npub const MF_ASINH: i64 = 56;\npub const MF_ACOSH: i64 = 57;\npub const MF_ATANH: i64 = 58;\npub const MF_FACE_FORWARD: i64 = 59;\npub const MF_LDEXP: i64 = 60;\npub const MF_PACK4X8SNORM: i64 = 61;\n");
        buf_str(out, c"pub const MF_UNPACK4X8SNORM: i64 = 62;\npub const MF_PACK2X16UNORM: i64 = 63;\npub const MF_UNPACK2X16UNORM: i64 = 64;\npub const MF_PACK2X16SNORM: i64 = 65;\npub const MF_UNPACK2X16SNORM: i64 = 66;\npub const MF_COUNT: i64 = 67;\n\npub const DV_DPDX: i64 = 0;\npub const DV_DPDY: i64 = 1;\npub const DV_FWIDTH: i64 = 2;\n\n// E_IMAGE_SAMPLE kinds (Expr.d's low byte) and its args: the coordinates,\n// then the array index when the texture is an array, then the kind's\n// operand (bias, level, depth reference).\npub const IMG_SAMPLE: i64 = 0;\npub const IMG_SAMPLE_BIAS: i64 = 1;\npub const IMG_SAMPLE_LEVEL: i64 = 2;\npub const IMG_SAMPLE_COMPARE: i64 = 3;\npub const IMG_SAMPLE_COMPARE_LEVEL: i64 = 4;\n\npub const IQ_SIZE: i64 = 0;\npub const IQ_LEVELS: i64 = 1;\npub const IQ_LAYERS: i64 = 2;\n\npub struct Expr { op: u8, ty: i64, a: i64, b: i64, c: i64, d: i64 }\n\n// ---- Shader compiler implementation, ir: Statements (0.22) ----\n\n// a .. b: the expressions evaluated here, in order\npub const S_EMIT: u8 = 0;\n// a: the block\npub const S_BLOCK: u8 = 1;\n// a: the condition; b: then; c: else (a block, possibly empty)\npub const S_IF: u8 = 2;\n// a: the selector (i32 or u32); b, c: cases[b .. b + c]\npub const S_SWITCH: u8 = 3;\n// a: body; b: continuing; c: the break-if expression, or -1 (evaluated\n// at the end of continuing, after its emits)\npub const S_LOOP: u8 = 4;\npub const S_BREAK: u8 = 5;\npub const S_CONTINUE: u8 = 6;\n// a: the value, or -1\npub const S_RETURN: u8 = 7;\n// discard\npub const S_KILL: u8 = 8;\n// a: BARRIER_* bits\npub const S_BARRIER: u8 = 9;\n// a: the pointer; b: the value\npub const S_STORE: u8 = 10;\n// a: the function; b, c: args[b .. b + c]; d: the E_CALL_RESULT or -1\npub const S_CALL: u8 = 11;\n// a: the pointer; b: AT_*; c: the value; d: the E_ATOMIC_RESULT or -1;\n// e: the comparand (AT_CMPXCHG) or -1\npub const S_ATOMIC: u8 = 12;\n// a: the texture; b: the coordinates; c: the value; d: the array index or -1\n");
        buf_str(out, c"pub const S_IMAGE_STORE: u8 = 13;\n// a: the pointer; b: the E_WG_UNIFORM_RESULT\npub const S_WG_UNIFORM_LOAD: u8 = 14;\n\npub const BARRIER_WORKGROUP: i64 = 1;\npub const BARRIER_STORAGE: i64 = 2;\n\npub const AT_ADD: i64 = 0;\npub const AT_SUB: i64 = 1;\npub const AT_AND: i64 = 2;\npub const AT_OR: i64 = 3;\npub const AT_XOR: i64 = 4;\npub const AT_MIN: i64 = 5;\npub const AT_MAX: i64 = 6;\npub const AT_EXCHANGE: i64 = 7;\npub const AT_LOAD: i64 = 8;\npub const AT_STORE: i64 = 9;\n// the result is __atomic_compare_exchange_result: { old_value, exchanged }\npub const AT_CMPXCHG: i64 = 10;\n\npub struct Stmt { op: u8, a: i64, b: i64, c: i64, d: i64, e: i64 }\n\n// A switch clause: its selector values (vals[vstart .. vstart + vcount]),\n// whether it is the default, its body.\npub struct Case { vstart: i64, vcount: i64, is_default: bool, body: i64 }\n\n// A run of statement handles: items[start .. start + count].\npub struct Block { start: i64, count: i64 }\n\npub struct Param { name: [u8], ty: i64, binding: Binding }\n\npub struct Local { name: [u8], ty: i64 }\n\npub type V<T> = Vec<T, ScopedArena>;\n\npub struct Function {\n    name: [u8],\n    params: V<Param>,\n    // -1: no result\n    result: i64,\n    result_binding: Binding,\n    locals: V<Local>,\n    exprs: V<Expr>,\n    // the names of `let` declarations: names[e] for expression e, or \"\"\n    names: V<[u8]>,\n    stmts: V<Stmt>,\n    blocks: V<Block>,\n    items: V<i64>,\n    args: V<i64>,\n    cases: V<Case>,\n    vals: V<i64>,\n    body: i64,\n    // the source position of the declaration (a byte offset)\n    pos: i64,\n}\n\npub struct Global {\n    name: [u8],\n    space: u8,\n    access: u8,\n    // the value's type (a texture, a sampler, or what the pointer points to)\n    ty: i64,\n    group: i64,\n    binding: i64,\n    // private globals: an expression of the module's init function, or -1\n    init: i64,\n    pos: i64,\n}\n\npub const STAGE_VERTEX: u8 = 0;\npub const STAGE_FRAGMENT: u8 = 1;\n");
        buf_str(out, c"pub const STAGE_COMPUTE: u8 = 2;\n\npub struct Entry { stage: u8, name: [u8], func: i64, wg: [i64; 3], early_depth: bool }\n\n#[derive(Eq, Hash)]\npub struct TypeKey { kind: u8, scalar: u8, space: u8, access: u8, n: i64, m: i64, base: i64 }\n\npub struct Module {\n    types: V<Type>,\n    types_map: HashMap<TypeKey, i64, ScopedArena>,\n    members: V<StructMember>,\n    globals: V<Global>,\n    functions: V<Function>,\n    entries: V<Entry>,\n    // private globals' initializers live in this function's expressions\n    // (literals, zero, compose only)\n    consts: Function,\n    a: ScopedArena,\n}\n\n// ---- Shader compiler implementation, ir: Fixed type handles (0.22) ----\n\npub const T_BOOL: i64 = 0;\npub const T_I32: i64 = 1;\npub const T_U32: i64 = 2;\npub const T_F32: i64 = 3;\n\n// vecN<scalar>: 4 + (n - 2) * 4 + scalar, for n in 2..4 and the four\n// concrete scalars\npub fn vec_ty(sk: u8, n: i64) -> i64 {\n    if n == 1 {\n        return sk as i64;\n    }\n    4 + (n - 2) * 4 + sk as i64\n}\n\n// matCxR<f32>: 16 + (c - 2) * 3 + (r - 2)\npub fn mat_ty(c: i64, r: i64) -> i64 { 16 + (c - 2) * 3 + (r - 2) }\n\npub const T_FIXED_COUNT: i64 = 25;\n\npub fn new_function(name: [u8], a: ScopedArena) -> Function {\n    Function {\n        name: name,\n        params: Vec::new_in(a),\n        result: -1,\n        result_binding: no_binding(),\n        locals: Vec::new_in(a),\n        exprs: Vec::new_in(a),\n        names: Vec::new_in(a),\n        stmts: Vec::new_in(a),\n        blocks: Vec::new_in(a),\n        items: Vec::new_in(a),\n        args: Vec::new_in(a),\n        cases: Vec::new_in(a),\n        vals: Vec::new_in(a),\n        body: -1,\n        pos: 0,\n    }\n}\n\nfn round_up(x: i64, a: i64) -> i64 { (x + a - 1) / a * a }\n\nimpl Module {\n    pub fn new(a: ScopedArena) -> Module {\n        var m = Module {\n            types: Vec::new_in(a),\n            types_map: HashMap::new_in(a),\n            members: Vec::new_in(a),\n");
        buf_str(out, c"            globals: Vec::new_in(a),\n            functions: Vec::new_in(a),\n            entries: Vec::new_in(a),\n            consts: new_function(\"\", a),\n            a: a,\n        };\n        for sk in 0..4 {\n            m.push_type(TK_SCALAR, sk as u8, 1, 1, -1);\n        }\n        for n in 2..5 {\n            for sk in 0..4 {\n                m.push_type(TK_VECTOR, sk as u8, n, 1, -1);\n            }\n        }\n        for c in 2..5 {\n            for r in 2..5 {\n                m.push_type(TK_MATRIX, SK_F32, c, r, -1);\n            }\n        }\n        m\n    }\n\n    fn push_type(inout self, kind: u8, sk: u8, n: i64, mm: i64, base: i64) -> i64 {\n        var t = Type {\n            kind: kind,\n            scalar: sk,\n            space: 0,\n            access: 0,\n            n: n,\n            m: mm,\n            base: base,\n            mstart: 0,\n            mcount: 0,\n            name: \"\",\n            size: 4,\n            align: 4,\n            stride: 0,\n        };\n        if kind == TK_VECTOR {\n            t.size = 4 * n;\n            t.align = if n == 2 { 8 } else { 16 };\n        } else if kind == TK_MATRIX {\n            let col_align = if mm == 2 { 8 } else { 16 };\n            t.align = col_align;\n            t.stride = round_up(4 * mm, col_align);\n            t.size = n * t.stride;\n        }\n        self.types.push(t);\n        self.types.len() - 1\n    }\n\n    // The handle of a type made of these parts, made once.\n    pub fn intern(inout self, kind: u8, sk: u8, n: i64, mm: i64, base: i64, space: u8,\n        access: u8) -> i64 {\n        if kind == TK_SCALAR {\n            return sk as i64;\n        }\n        if kind == TK_VECTOR {\n            return vec_ty(sk, n);\n        }\n        if kind == TK_MATRIX {\n            return mat_ty(n, mm);\n        }\n        let key = TypeKey {\n            kind: kind, scalar: sk, space: space, access: access, n: n, m: mm, base: base\n        };\n");
        buf_str(out, c"        if let Some(h) = self.types_map.get(key) {\n            return h;\n        }\n        let h = self.push_type(kind, sk, n, mm, base);\n        self.types[h].space = space;\n        self.types[h].access = access;\n        if kind == TK_ARRAY {\n            let el = self.types[base];\n            let stride = round_up(el.size, el.align);\n            self.types[h].align = el.align;\n            self.types[h].stride = stride;\n            self.types[h].size = if n == 0 { stride } else { stride * n };\n        } else if kind == TK_POINTER {\n            self.types[h].size = 8;\n            self.types[h].align = 8;\n        } else if kind == TK_TEXTURE || kind == TK_SAMPLER {\n            self.types[h].size = 8;\n            self.types[h].align = 8;\n        }\n        self.types_map.insert(key, h);\n        h\n    }\n\n    pub fn array_ty(inout self, elem: i64, n: i64) -> i64 {\n        self.intern(TK_ARRAY, 0, n, 0, elem, 0, 0)\n    }\n\n    pub fn ptr_ty(inout self, pointee: i64, space: u8, access: u8) -> i64 {\n        self.intern(TK_POINTER, 0, 0, 0, pointee, space, access)\n    }\n\n    pub fn atomic_ty(inout self, sk: u8) -> i64 { self.intern(TK_ATOMIC, sk, 0, 0, -1, 0, 0) }\n\n    // A struct type: a new handle for each declaration (structs are\n    // nominal); members[mstart ..] must already be pushed, offsets unset.\n    pub fn struct_ty(inout self, name: [u8], mstart: i64, mcount: i64) -> i64 {\n        let h = self.push_type(TK_STRUCT, 0, 0, 0, -1);\n        var off = 0;\n        var al = 4;\n        for i in mstart..mstart + mcount {\n            let t = self.types[self.members[i].ty];\n            off = round_up(off, t.align);\n            self.members[i].offset = off;\n            off += t.size;\n            if t.align > al {\n                al = t.align;\n            }\n        }\n        self.types[h].name = name;\n        self.types[h].mstart = mstart;\n        self.types[h].mcount = mcount;\n        self.types[h].align = al;\n");
        buf_str(out, c"        self.types[h].size = round_up(off, al);\n        h\n    }\n\n    // The scalar kind of a scalar, vector, matrix or atomic type.\n    pub fn scalar_of(self, t: i64) -> u8 { self.types[t].scalar }\n\n    // The component count of a scalar (1) or vector type, else 0.\n    pub fn width_of(self, t: i64) -> i64 {\n        let k = self.types[t].kind;\n        if k == TK_SCALAR {\n            1\n        } else if k == TK_VECTOR {\n            self.types[t].n\n        } else {\n            0\n        }\n    }\n\n    // The pointee of a pointer type, else -1.\n    pub fn pointee(self, t: i64) -> i64 {\n        if self.types[t].kind == TK_POINTER {\n            self.types[t].base\n        } else {\n            -1\n        }\n    }\n\n    // The type of a component of t when indexed: a vector's scalar, a\n    // matrix's column, an array's element; -1 for the others.\n    pub fn elem_of(self, t: i64) -> i64 {\n        let ty = self.types[t];\n        if ty.kind == TK_VECTOR {\n            ty.scalar as i64\n        } else if ty.kind == TK_MATRIX {\n            vec_ty(SK_F32, ty.m)\n        } else if ty.kind == TK_ARRAY {\n            ty.base\n        } else {\n            -1\n        }\n    }\n\n    // How many components indexing t can reach: 0 for a runtime-sized array.\n    pub fn index_len(self, t: i64) -> i64 {\n        let ty = self.types[t];\n        if ty.kind == TK_VECTOR || ty.kind == TK_ARRAY {\n            ty.n\n        } else if ty.kind == TK_MATRIX {\n            ty.n\n        } else {\n            -1\n        }\n    }\n\n    // Whether t is or holds a runtime-sized array.\n    pub fn is_runtime_sized(self, t: i64) -> bool {\n        let ty = self.types[t];\n        if ty.kind == TK_ARRAY {\n            return ty.n == 0;\n        }\n        if ty.kind == TK_STRUCT && ty.mcount > 0 {\n            return self.is_runtime_sized(self.members[ty.mstart + ty.mcount - 1].ty);\n        }\n        false\n    }\n\n");
        buf_str(out, c"    // Whether t contains an atomic (such types cannot be loaded whole).\n    pub fn has_atomic(self, t: i64) -> bool {\n        let ty = self.types[t];\n        if ty.kind == TK_ATOMIC {\n            return true;\n        }\n        if ty.kind == TK_ARRAY {\n            return self.has_atomic(ty.base);\n        }\n        if ty.kind == TK_STRUCT {\n            for i in ty.mstart..ty.mstart + ty.mcount {\n                if self.has_atomic(self.members[i].ty) {\n                    return true;\n                }\n            }\n        }\n        false\n    }\n\n    // The type written as WGSL, for messages and the IR dump.\n    pub fn type_name<A: Allocator>(self, t: i64, b: inout Buf<A>) {\n        if t < 0 {\n            b.push_str(\"void\");\n            return;\n        }\n        let ty = self.types[t];\n        if ty.kind == TK_SCALAR {\n            b.push_str(scalar_name(ty.scalar));\n        } else if ty.kind == TK_VECTOR {\n            b.push_fmt(f\"vec{ty.n}<{scalar_name(ty.scalar)}>\");\n        } else if ty.kind == TK_MATRIX {\n            b.push_fmt(f\"mat{ty.n}x{ty.m}<f32>\");\n        } else if ty.kind == TK_ARRAY {\n            b.push_str(\"array<\");\n            self.type_name(ty.base, &b);\n            if ty.n > 0 {\n                b.push_fmt(f\", {ty.n}\");\n            }\n            b.push('>');\n        } else if ty.kind == TK_STRUCT {\n            b.push_str(ty.name);\n        } else if ty.kind == TK_ATOMIC {\n            b.push_fmt(f\"atomic<{scalar_name(ty.scalar)}>\");\n        } else if ty.kind == TK_POINTER {\n            b.push_fmt(f\"ptr<{space_name(ty.space)}, \");\n            self.type_name(ty.base, &b);\n            if ty.space == SP_STORAGE {\n                b.push_str(if ty.access == ACC_RW { \", read_write\" } else { \", read\" });\n            }\n            b.push('>');\n        } else if ty.kind == TK_TEXTURE {\n            if ty.n == TEX_2D {\n                b.push_fmt(f\"texture_2d<{scalar_name(ty.scalar)}>\");\n");
        buf_str(out, c"            } else if ty.n == TEX_2D_ARRAY {\n                b.push_fmt(f\"texture_2d_array<{scalar_name(ty.scalar)}>\");\n            } else if ty.n == TEX_DEPTH_2D {\n                b.push_str(\"texture_depth_2d\");\n            } else {\n                b.push_fmt(f\"texture_storage_2d<{format_name(ty.m)}, write>\");\n            }\n        } else if ty.n == 1 {\n            b.push_str(\"sampler_comparison\");\n        } else {\n            b.push_str(\"sampler\");\n        }\n    }\n}\n\npub fn scalar_name(sk: u8) -> [u8] {\n    if sk == SK_BOOL {\n        \"bool\"\n    } else if sk == SK_I32 {\n        \"i32\"\n    } else if sk == SK_U32 {\n        \"u32\"\n    } else if sk == SK_F32 {\n        \"f32\"\n    } else if sk == SK_AINT {\n        \"abstract-int\"\n    } else {\n        \"abstract-float\"\n    }\n}\n\npub fn space_name(sp: u8) -> [u8] {\n    if sp == SP_FUNCTION {\n        \"function\"\n    } else if sp == SP_PRIVATE {\n        \"private\"\n    } else if sp == SP_WORKGROUP {\n        \"workgroup\"\n    } else if sp == SP_UNIFORM {\n        \"uniform\"\n    } else if sp == SP_STORAGE {\n        \"storage\"\n    } else {\n        \"handle\"\n    }\n}\n\npub fn format_name(f: i64) -> [u8] {\n    if f == FMT_RGBA8UNORM {\n        \"rgba8unorm\"\n    } else if f == FMT_RGBA32FLOAT {\n        \"rgba32float\"\n    } else if f == FMT_R32FLOAT {\n        \"r32float\"\n    } else if f == FMT_R32UINT {\n        \"r32uint\"\n    } else if f == FMT_R32SINT {\n        \"r32sint\"\n    } else {\n        \"rgba32uint\"\n    }\n}\n\n// ---- Shader compiler implementation, ir: Building functions (0.22) ----\n\nimpl Function {\n    pub fn expr(inout self, op: u8, ty: i64, a: i64, b: i64, c: i64) -> i64 {\n        self.exprs.push(Expr { op: op, ty: ty, a: a, b: b, c: c, d: 0 });\n        self.names.push(\"\");\n        self.exprs.len() - 1\n    }\n\n    pub fn stmt(inout self, op: u8, a: i64, b: i64, c: i64, d: i64) -> i64 {\n");
        buf_str(out, c"        self.stmts.push(Stmt { op: op, a: a, b: b, c: c, d: d, e: -1 });\n        self.stmts.len() - 1\n    }\n\n    // A block of the statements pending[from ..], which are removed from\n    // pending.\n    pub fn block_of(inout self, pending: inout V<i64>, from: i64) -> i64 {\n        let start = self.items.len();\n        for i in from..pending.len() {\n            self.items.push(pending[i]);\n        }\n        let count = pending.len() - from;\n        pending.truncate(from);\n        self.blocks.push(Block { start: start, count: count });\n        self.blocks.len() - 1\n    }\n\n    pub fn empty_block(inout self) -> i64 {\n        self.blocks.push(Block { start: self.items.len(), count: 0 });\n        self.blocks.len() - 1\n    }\n\n    pub fn arg(self, i: i64) -> i64 { self.args[i] }\n\n    pub fn item(self, blk: i64, i: i64) -> i64 { self.items[self.blocks[blk].start + i] }\n}\n\n// The byte offsets of function h's parameters in a record holding them\n// all, each at its alignment (WGSL's layout); the record's size, rounded\n// to 16, is the last element.\npub fn record_offsets(m: Module, h: i64, a: ScopedArena) -> V<i64> {\n    var offs: V<i64> = Vec::new_in(a);\n    var off = 0;\n    let f = m.functions[h];\n    for k in 0..f.params.len() {\n        let t = m.types[f.params[k].ty];\n        off = round_up(off, t.align);\n        offs.push(off);\n        off += t.size;\n    }\n    offs.push(round_up(off, 16));\n    offs\n}\n\n// The bytes a value of type t takes in an array of them (its stride).\npub fn stride_of(m: Module, t: i64) -> i64 {\n    let ty = m.types[t];\n    round_up(ty.size, ty.align)\n}\n\n// Statements and expressions that end a block's flow.\npub fn is_terminator(op: u8) -> bool {\n    op == S_BREAK || op == S_CONTINUE || op == S_RETURN || op == S_KILL\n}\n\n// The bits of an f32, and back.\npub fn f32_bits(f: f32) -> u32 { std::num::f32_to_bits(f) }\n\npub fn bits_f32(u: u32) -> f32 { std::num::f32_from_bits(u) }\n\n");
        buf_str(out, c"pub fn f64_bits(f: f64) -> u64 { std::num::f64_to_bits(f) }\n// ---- end mod std::gpu::wgsl::ir ----\n}\n// ---- mod std::gpu::wgsl::names ----\npub mod names {\n// ---- Shader compiler implementation, names (0.22) ----\n// The predeclared names of WGSL: keywords, types, attributes and builtins.\n// The lexer interns them first, so each has the fixed symbol below. The\n// math functions are in MF_* order (ir.vl): K_ABS + MF_x is MF_x's name.\n\npub const PREDECLARED: [[u8]; 234] = [\n    \"fn\",\n    \"let\",\n    \"var\",\n    \"const\",\n    \"struct\",\n    \"return\",\n    \"if\",\n    \"else\",\n    \"for\",\n    \"while\",\n    \"loop\",\n    \"break\",\n    \"continue\",\n    \"continuing\",\n    \"switch\",\n    \"case\",\n    \"default\",\n    \"discard\",\n    \"true\",\n    \"false\",\n    \"alias\",\n    \"override\",\n    \"enable\",\n    \"requires\",\n    \"diagnostic\",\n    \"const_assert\",\n    \"fallthrough\",\n    \"bool\",\n    \"i32\",\n    \"u32\",\n    \"f32\",\n    \"f16\",\n    \"vec2\",\n    \"vec3\",\n    \"vec4\",\n    \"vec2i\",\n    \"vec3i\",\n    \"vec4i\",\n    \"vec2u\",\n    \"vec3u\",\n    \"vec4u\",\n    \"vec2f\",\n    \"vec3f\",\n    \"vec4f\",\n    \"vec2h\",\n    \"vec3h\",\n    \"vec4h\",\n    \"mat2x2\",\n    \"mat2x3\",\n    \"mat2x4\",\n    \"mat3x2\",\n    \"mat3x3\",\n    \"mat3x4\",\n    \"mat4x2\",\n    \"mat4x3\",\n    \"mat4x4\",\n    \"mat2x2f\",\n    \"mat2x3f\",\n    \"mat2x4f\",\n    \"mat3x2f\",\n    \"mat3x3f\",\n    \"mat3x4f\",\n    \"mat4x2f\",\n    \"mat4x3f\",\n    \"mat4x4f\",\n    \"array\",\n    \"atomic\",\n    \"ptr\",\n    \"sampler\",\n    \"sampler_comparison\",\n    \"texture_2d\",\n    \"texture_2d_array\",\n    \"texture_depth_2d\",\n    \"texture_storage_2d\",\n    \"texture_1d\",\n    \"texture_3d\",\n    \"texture_cube\",\n    \"texture_cube_array\",\n    \"texture_multisampled_2d\",\n    \"texture_depth_2d_array\",\n    \"texture_depth_cube\",\n    \"texture_external\",\n");
