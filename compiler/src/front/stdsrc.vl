        buf_str(out, c"    $!!!!\\xb8$!\\x63$!!!!\\xba$!)$!!$!\\xba$!)$!\\x22$!\\\n    \\xba$!\\x63$!!!!\\xba$!)$!\\x63$!\\xc6$!)$!!$!\\xc6$!)$\\\n    !\\x22$!\\xc2$!4$!!!!\\xc6$!\\x63$!!!!\\xc6$!)$!\\x63$!\\xca\\\n    $!\\x63$!!!!)@!\\xba$!!!!*@!\\xba$!!!!+@!\\xba$!\\\n    !!!,@!\\xba$!!!!-@!\\xba$!!!!.@!\\xba$!!!!/@\\\n    !\\xba$!!!!0@!\\xba$!!!!)@!\\xba$!!!!*@!\\xba$!!\\\n    !!+@!\\xba$!!!!,@!\\xba$!!!!-@!\\xba$!!!!.@!\\\n    \\xba$!!!!/@!\\xba$!!!!0@!\\xba$!!!!\\x49@!\\xba$!!!\\\n    !\\x4a@!\\xba$!!!!\\x4b@!\\xba$!!!!\\x4c@!\\xba$!!!!\\x4d@!\\xba\\\n    $!!!!\\x4e@!\\xba$!!!!\\x4f@!\\xba$!!!!\\x50@!\\xba$!!!!\\\n    \\x49@!\\xba$!!!!\\x4a@!\\xba$!!!!\\x4b@!\\xba$!!!!\\x4c@!\\xba$\\\n    !!!!\\x4d@!\\xba$!!!!\\x4e@!\\xba$!!!!\\x4f@!\\xba$!!!!\\x50\\\n    @!\\xba$!!!!\\x89@!\\xba$!!!!\\x8a@!\\xba$!!!!\\x8b@!\\xba$!\\\n    !!!\\x8c@!\\xba$!!!!\\x8d@!\\xba$!!!!\\x8e@!\\xba$!!!!\\x8f@\\\n    !\\xba$!!!!\\x90@!\\xba$!!!!\\x89@!\\xba$!!!!\\x8a@!\\xba$!!\\\n    !!\\x8b@!\\xba$!!!!\\x8c@!\\xba$!!!!\\x8d@!\\xba$!!!!\\x8e@!\\\n    \\xba$!!!!\\x8f@!\\xba$!!!!\\x90@!\\xba$!!!!\\xb2$!\\xba$!!!\\\n    !\\xb2$!\\xba$!!!!\\xb8$!\\xba$!!!!\\xb8$!\\xba$!!!!\\xca$!\\xba\\\n    $!!!!\\xca$!\\xba$!!!!\\xdb@!\\xba$!!!!\\xa7$!\\xba$!!!!\\\n    \\xeb@!\\xba$!!!!\\xaa$!\\xba$!!!!\\x1b@!\\xba$!!!!\\xb0$!\\xba$\\\n    !!!!\\xb2$!\\x63$!\\xba$!\\xb8$!\\x63$!\\xba$!\\xca$!\\x63$!\\xba$!\";\npub const LOWER_COUNT: i64 = 1508;\npub const UPPER_COUNT: i64 = 1601;\n// ---- end mod std::unicode::tables ----\n}\n// ---- end mod std::unicode ----\n}\n// ---- mod std::sync ----\npub mod sync {\n// std::sync: atomics, locks and channels (0.21; docs/design/concurrency.md).\n\npub mod atomic;\npub mod mpsc;\n\nuse std::{sys_futex_wait, sys_futex_wake};\nuse std::sync::atomic::{AtomicU32, Ordering};\n\n// ---- Locks (0.21) ----\n\n// The lock under Mutex and the channels (§2.6): a 32-bit word, 0 unlocked,\n// 1 locked, 2 locked with waiters (U. Drepper, \"Futexes are tricky\",\n");
        buf_str(out, c"// mutex 3); the waiters sleep on the word (std's sys_futex_wait: futex on\n// Linux, __ulock on macOS). Acquire on lock, release on unlock.\npub struct RawLock { state: AtomicU32 }\n\nimpl RawLock {\n    #[inline]\n    pub fn new() -> RawLock { RawLock { state: AtomicU32::new(0) } }\n\n    // Waits until the lock is free, and takes it.\n    #[inline]\n    pub fn lock(self) {\n        if self.state.compare_exchange(0, 1, Ordering::Acquire, Ordering::Relaxed).is_err() {\n            self.lock_contended();\n        }\n    }\n\n    // Takes the lock when it is free; whether it did.\n    #[inline]\n    pub fn try_lock(self) -> bool {\n        self.state.compare_exchange(0, 1, Ordering::Acquire, Ordering::Relaxed).is_ok()\n    }\n\n    fn lock_contended(self) {\n        // A short spin first: the holder may be about to let go.\n        for _ in 0..100 {\n            if self.state.load(Ordering::Relaxed) == 0\n                && self.state.compare_exchange(0, 1, Ordering::Acquire, Ordering::Relaxed).is_ok() {\n                return;\n            }\n        }\n        while self.state.swap(2, Ordering::Acquire) != 0 {\n            unsafe { sys_futex_wait(self.state.as_ptr(), 2); }\n        }\n    }\n\n    // Lets the lock go (the caller holds it), waking a waiter.\n    #[inline]\n    pub fn unlock(self) {\n        if self.state.swap(0, Ordering::Release) == 2 {\n            unsafe { sys_futex_wake(self.state.as_ptr(), false); }\n        }\n    }\n}\n\n// Data behind a lock: only the thread holding it reaches the data. `with`\n// locks, runs the closure on the data and unlocks; `lock` gives a guard\n// that unlocks when it is dropped. No poisoning: a panic stops the program.\n//\n//     let m = Mutex::new(0);\n//     m.with(|n| *n += 1);\npub struct Mutex<T> { raw: RawLock, data: T }\n\nimpl<T> Mutex<T> {\n    #[inline]\n    pub fn new(v: sink T) -> Mutex<T> { Mutex { raw: RawLock::new(), data: v } }\n\n    // The data, when nothing else can reach the mutex.\n");
        buf_str(out, c"    pub fn into_inner(sink self) -> T {\n        let m = self;\n        m.data\n    }\n\n    // Locks, runs f on the data, unlocks; f's result.\n    pub fn with<R, F: FnMut(inout T) -> R>(self, f: F) -> R {\n        self.raw.lock();\n        var g = f;\n        let p = &self.data as *T;\n        let r = g(unsafe { &*p });\n        self.raw.unlock();\n        r\n    }\n\n    // with, when the lock is free now: Some(f's result), else None.\n    pub fn try_with<R, F: FnMut(inout T) -> R>(self, f: F) -> Option<R> {\n        if !self.raw.try_lock() {\n            return None;\n        }\n        var g = f;\n        let p = &self.data as *T;\n        let r = g(unsafe { &*p });\n        self.raw.unlock();\n        Some(r)\n    }\n\n    // Locks; the guard unlocks when it is dropped. The caller keeps the\n    // guard inside the mutex's life (0.21.0 does not check it yet: the\n    // guard holds a raw pointer).\n    pub unsafe fn lock(self) -> MutexGuard<T> {\n        self.raw.lock();\n        MutexGuard { m: &self as *Mutex<T> }\n    }\n}\n\n// A held lock (Mutex::lock): `with` runs a closure on the data, `as_ptr`\n// gives its address; dropping the guard unlocks.\npub struct MutexGuard<T> { m: *Mutex<T> }\n\nimpl<T> MutexGuard<T> {\n    // Runs f on the data; f's result.\n    pub fn with<R, F: FnMut(inout T) -> R>(inout self, f: F) -> R {\n        var g = f;\n        unsafe {\n            let p = &(*self.m).data as *T;\n            g(&*p)\n        }\n    }\n\n    // A raw pointer to the data, valid while the guard is.\n    pub fn as_ptr(self) -> *T {\n        unsafe { &(*self.m).data as *T }\n    }\n}\n\nimpl<T> Drop for MutexGuard<T> {\n    fn drop(inout self) {\n        unsafe { (*self.m).raw.unlock(); }\n    }\n}\n\n// Runs a function once, whatever the threads calling it (`static INIT:\n// Once = Once::NEW;` is not written yet: `Once { state: AtomicU32 { v: 0\n// } }`). The first call_once runs f; the others wait until it is done.\npub struct Once { state: AtomicU32 }\n");
        buf_str(out, c"\nimpl Once {\n    #[inline]\n    pub fn new() -> Once { Once { state: AtomicU32::new(0) } }\n\n    // Runs f unless a call_once of this Once ran (or is running) already;\n    // returns when it is done.\n    pub fn call_once<F: FnMut()>(self, f: F) {\n        if self.state.load(Ordering::Acquire) == 2 {\n            return;\n        }\n        if self.state.compare_exchange(0, 1, Ordering::Acquire, Ordering::Acquire).is_ok() {\n            var g = f;\n            g();\n            self.state.store(2, Ordering::Release);\n            unsafe { sys_futex_wake(self.state.as_ptr(), true); }\n            return;\n        }\n        while self.state.load(Ordering::Acquire) != 2 {\n            unsafe { sys_futex_wait(self.state.as_ptr(), 1); }\n        }\n    }\n\n    // Whether a call_once has finished.\n    pub fn is_completed(self) -> bool {\n        self.state.load(Ordering::Acquire) == 2\n    }\n}\n\n// Waiting for a condition on a Mutex's data: `wait_then(&m, ready, then)`\n// locks m, sleeps (unlocked) until `ready(data)` holds, then runs\n// `then(data)` under the lock; a thread that changes the data notifies\n// (`notify_one`, `notify_all`). Spurious wakeups are allowed: `ready` is\n// asked again each time.\npub struct Condvar { seq: AtomicU32 }\n\nimpl Condvar {\n    #[inline]\n    pub fn new() -> Condvar { Condvar { seq: AtomicU32::new(0) } }\n\n    pub fn wait_then<T, R, P: FnMut(inout T) -> bool, G: FnMut(inout T) -> R>(self,\n        m: Mutex<T>, ready: P, then: G) -> R {\n        var ok = ready;\n        var run = then;\n        let p = &m.data as *T;\n        m.raw.lock();\n        loop {\n            if ok(unsafe { &*p }) {\n                break;\n            }\n            let seen = self.seq.load(Ordering::Acquire);\n            m.raw.unlock();\n            unsafe { sys_futex_wait(self.seq.as_ptr(), seen); }\n            m.raw.lock();\n        }\n        let r = run(unsafe { &*p });\n        m.raw.unlock();\n        r\n    }\n\n");
        buf_str(out, c"    // Wakes one waiting thread.\n    pub fn notify_one(self) {\n        self.seq.fetch_add(1, Ordering::Release);\n        unsafe { sys_futex_wake(self.seq.as_ptr(), false); }\n    }\n\n    // Wakes every waiting thread.\n    pub fn notify_all(self) {\n        self.seq.fetch_add(1, Ordering::Release);\n        unsafe { sys_futex_wake(self.seq.as_ptr(), true); }\n    }\n}\n// ---- mod std::sync::atomic ----\npub mod atomic {\n// std::sync::atomic: Atomic<T>, its orderings and fences (0.21).\n\n// ---- Atomics (0.21) ----\n\n// Atomic<T> and its orderings (docs/design/concurrency.md §2.2): C++20's\n// memory model, without Consume. `Atomic<T>` holds a T that threads read\n// and write at once without a data race, through its methods; T is an\n// integer of 1, 2, 4 or 8 bytes, a bool or a raw pointer. Rust's names are\n// aliases: AtomicI64 is Atomic<i64>.\n//\n//     static mut HITS: AtomicI64 = AtomicI64 { v: 0 };   // (std::sync::atomic)\n//     HITS.fetch_add(1, Ordering::Relaxed);\n//\n// An ordering an operation cannot have (a load with Release) is made\n// SeqCst, and so is one that is not a constant after inlining; weak\n// compare-exchange is the strong one. Integers wrap.\n\npub enum Ordering { Relaxed, Acquire, Release, AcqRel, SeqCst }\n\n// The intrinsics the lowering makes ATOMIC and FENCE instructions of\n// (middle/lower/atomic.vl, gen0/gen/atomic.vl): `order` is 0\n// Relaxed ... 4 SeqCst, a literal (else SeqCst). The caller promises that\n// p is valid and aligned to T's size, and that no non-atomic access of\n// *p races with this one. Their bodies are never compiled.\npub unsafe fn atomic_load<T>(p: *T, order: i64) -> T { unreachable() }\npub unsafe fn atomic_store<T>(p: *T, v: T, order: i64) { unreachable() }\npub unsafe fn atomic_swap<T>(p: *T, v: T, order: i64) -> T { unreachable() }\n\n// The old value; *p becomes `new` when it was `expected`.\npub unsafe fn atomic_cas<T>(p: *T, expected: T, new: T, order: i64) -> T {\n    unreachable()\n}\n\n");
        buf_str(out, c"pub unsafe fn atomic_add<T>(p: *T, v: T, order: i64) -> T { unreachable() }\npub unsafe fn atomic_sub<T>(p: *T, v: T, order: i64) -> T { unreachable() }\npub unsafe fn atomic_and<T>(p: *T, v: T, order: i64) -> T { unreachable() }\npub unsafe fn atomic_nand<T>(p: *T, v: T, order: i64) -> T { unreachable() }\npub unsafe fn atomic_or<T>(p: *T, v: T, order: i64) -> T { unreachable() }\npub unsafe fn atomic_xor<T>(p: *T, v: T, order: i64) -> T { unreachable() }\n// Signed or unsigned as T is.\npub unsafe fn atomic_max<T>(p: *T, v: T, order: i64) -> T { unreachable() }\npub unsafe fn atomic_min<T>(p: *T, v: T, order: i64) -> T { unreachable() }\npub unsafe fn atomic_fence(order: i64) { unreachable() }\npub unsafe fn atomic_compiler_fence(order: i64) { unreachable() }\n\n// The ordering of a compare-exchange: one for both outcomes, at least as\n// strong as each.\n#[inline]\nfn cas_order(success: Ordering, failure: Ordering) -> i64 {\n    let s = success as i64;\n    let f = failure as i64;\n    if s == 4 || f == 4 {\n        return 4;\n    }\n    if f == 1 && (s == 0 || s == 2) {\n        return if s == 0 { 1 } else { 3 };\n    }\n    s\n}\n\npub struct Atomic<T> { v: T }\n\npub type AtomicI8 = Atomic<i8>;\npub type AtomicI16 = Atomic<i16>;\npub type AtomicI32 = Atomic<i32>;\npub type AtomicI64 = Atomic<i64>;\npub type AtomicU8 = Atomic<u8>;\npub type AtomicU16 = Atomic<u16>;\npub type AtomicU32 = Atomic<u32>;\npub type AtomicU64 = Atomic<u64>;\npub type AtomicIsize = Atomic<isize>;\npub type AtomicUsize = Atomic<usize>;\npub type AtomicBool = Atomic<bool>;\npub type AtomicPtr<T> = Atomic<*T>;\n\n// An atomic is owned (move-only): a copy of one other threads use would\n// read it non-atomically.\nimpl<T> Drop for Atomic<T> {\n    #[inline]\n    fn drop(inout self) {}\n}\n\nimpl<T> Atomic<T> {\n    #[inline]\n    pub fn new(v: sink T) -> Atomic<T> { Atomic { v: v } }\n\n    // The value, when nothing else can reach the atomic.\n    #[inline]\n");
        buf_str(out, c"    pub fn into_inner(sink self) -> T {\n        let a = self;\n        unsafe { atomic_load(&a.v as *T, 0) }\n    }\n\n    // The value's address (accesses through it must not race with atomic ones).\n    #[inline]\n    pub fn as_ptr(self) -> *T { &self.v as *T }\n\n    #[inline]\n    pub fn load(self, order: Ordering) -> T {\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_load(&self.v as *T, 0),\n                Ordering::Acquire => atomic_load(&self.v as *T, 1),\n                _ => atomic_load(&self.v as *T, 4),\n            }\n        }\n    }\n\n    #[inline]\n    pub fn store(self, v: T, order: Ordering) {\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_store(&self.v as *T, v, 0),\n                Ordering::Release => atomic_store(&self.v as *T, v, 2),\n                _ => atomic_store(&self.v as *T, v, 4),\n            }\n        }\n    }\n\n    #[inline]\n    pub fn swap(self, v: T, order: Ordering) -> T {\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_swap(&self.v as *T, v, 0),\n                Ordering::Acquire => atomic_swap(&self.v as *T, v, 1),\n                Ordering::Release => atomic_swap(&self.v as *T, v, 2),\n                Ordering::AcqRel => atomic_swap(&self.v as *T, v, 3),\n                Ordering::SeqCst => atomic_swap(&self.v as *T, v, 4),\n            }\n        }\n    }\n\n    // Ok(the old value) when it was `current` (and is now `new`), else\n    // Err(the value found).\n    #[inline]\n    pub fn compare_exchange(self, current: T, new: T, success: Ordering,\n        failure: Ordering) -> Result<T, T> {\n        let order = cas_order(success, failure);\n        let old = unsafe {\n            if order == 0 {\n                atomic_cas(&self.v as *T, current, new, 0)\n            } else if order == 1 {\n                atomic_cas(&self.v as *T, current, new, 1)\n            } else if order == 2 {\n");
        buf_str(out, c"                atomic_cas(&self.v as *T, current, new, 2)\n            } else if order == 3 {\n                atomic_cas(&self.v as *T, current, new, 3)\n            } else {\n                atomic_cas(&self.v as *T, current, new, 4)\n            }\n        };\n        if old == current { Ok(old) } else { Err(old) }\n    }\n\n    // compare_exchange (it never fails spuriously here).\n    #[inline]\n    pub fn compare_exchange_weak(self, current: T, new: T, success: Ordering,\n        failure: Ordering) -> Result<T, T> {\n        self.compare_exchange(current, new, success, failure)\n    }\n\n    #[inline]\n    pub fn fetch_add(self, v: T, order: Ordering) -> T {\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_add(&self.v as *T, v, 0),\n                Ordering::Acquire => atomic_add(&self.v as *T, v, 1),\n                Ordering::Release => atomic_add(&self.v as *T, v, 2),\n                Ordering::AcqRel => atomic_add(&self.v as *T, v, 3),\n                Ordering::SeqCst => atomic_add(&self.v as *T, v, 4),\n            }\n        }\n    }\n\n    #[inline]\n    pub fn fetch_sub(self, v: T, order: Ordering) -> T {\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_sub(&self.v as *T, v, 0),\n                Ordering::Acquire => atomic_sub(&self.v as *T, v, 1),\n                Ordering::Release => atomic_sub(&self.v as *T, v, 2),\n                Ordering::AcqRel => atomic_sub(&self.v as *T, v, 3),\n                Ordering::SeqCst => atomic_sub(&self.v as *T, v, 4),\n            }\n        }\n    }\n\n    #[inline]\n    pub fn fetch_and(self, v: T, order: Ordering) -> T {\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_and(&self.v as *T, v, 0),\n                Ordering::Acquire => atomic_and(&self.v as *T, v, 1),\n                Ordering::Release => atomic_and(&self.v as *T, v, 2),\n");
        buf_str(out, c"                Ordering::AcqRel => atomic_and(&self.v as *T, v, 3),\n                Ordering::SeqCst => atomic_and(&self.v as *T, v, 4),\n            }\n        }\n    }\n\n    // !(old & v) (integers only).\n    #[inline]\n    pub fn fetch_nand(self, v: T, order: Ordering) -> T {\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_nand(&self.v as *T, v, 0),\n                Ordering::Acquire => atomic_nand(&self.v as *T, v, 1),\n                Ordering::Release => atomic_nand(&self.v as *T, v, 2),\n                Ordering::AcqRel => atomic_nand(&self.v as *T, v, 3),\n                Ordering::SeqCst => atomic_nand(&self.v as *T, v, 4),\n            }\n        }\n    }\n\n    #[inline]\n    pub fn fetch_or(self, v: T, order: Ordering) -> T {\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_or(&self.v as *T, v, 0),\n                Ordering::Acquire => atomic_or(&self.v as *T, v, 1),\n                Ordering::Release => atomic_or(&self.v as *T, v, 2),\n                Ordering::AcqRel => atomic_or(&self.v as *T, v, 3),\n                Ordering::SeqCst => atomic_or(&self.v as *T, v, 4),\n            }\n        }\n    }\n\n    #[inline]\n    pub fn fetch_xor(self, v: T, order: Ordering) -> T {\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_xor(&self.v as *T, v, 0),\n                Ordering::Acquire => atomic_xor(&self.v as *T, v, 1),\n                Ordering::Release => atomic_xor(&self.v as *T, v, 2),\n                Ordering::AcqRel => atomic_xor(&self.v as *T, v, 3),\n                Ordering::SeqCst => atomic_xor(&self.v as *T, v, 4),\n            }\n        }\n    }\n\n    #[inline]\n    pub fn fetch_max(self, v: T, order: Ordering) -> T {\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_max(&self.v as *T, v, 0),\n                Ordering::Acquire => atomic_max(&self.v as *T, v, 1),\n");
        buf_str(out, c"                Ordering::Release => atomic_max(&self.v as *T, v, 2),\n                Ordering::AcqRel => atomic_max(&self.v as *T, v, 3),\n                Ordering::SeqCst => atomic_max(&self.v as *T, v, 4),\n            }\n        }\n    }\n\n    #[inline]\n    pub fn fetch_min(self, v: T, order: Ordering) -> T {\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_min(&self.v as *T, v, 0),\n                Ordering::Acquire => atomic_min(&self.v as *T, v, 1),\n                Ordering::Release => atomic_min(&self.v as *T, v, 2),\n                Ordering::AcqRel => atomic_min(&self.v as *T, v, 3),\n                Ordering::SeqCst => atomic_min(&self.v as *T, v, 4),\n            }\n        }\n    }\n}\n\n// A memory fence: Acquire, Release, AcqRel or SeqCst (Relaxed is SeqCst).\n#[inline]\npub fn fence(order: Ordering) {\n    unsafe {\n        match order {\n            Ordering::Acquire => atomic_fence(1),\n            Ordering::Release => atomic_fence(2),\n            Ordering::AcqRel => atomic_fence(3),\n            _ => atomic_fence(4),\n        }\n    }\n}\n\n// A fence for the compiler only (no instruction): memory accesses are not\n// moved across it. For signal handlers.\n#[inline]\npub fn compiler_fence(order: Ordering) {\n    unsafe { atomic_compiler_fence(order as i64); }\n}\n// ---- end mod std::sync::atomic ----\n}\n// ---- mod std::sync::mpsc ----\npub mod mpsc {\n// std::sync::mpsc: channels between threads (0.21).\n\nuse std::{\n    Clone, Debug, Display, Fmt, Option, Result, Vec, out_of_memory, sys_futex_wait, sys_futex_wake,\n};\nuse std::sync::RawLock;\nuse std::sync::atomic::{AtomicU32, Ordering};\n\n// ---- Channels (0.21) ----\n\n// A channel (docs/design/concurrency.md §2.7): values sent through any of\n// its Senders come out of its Receiver in the order they were sent. Rust's\n// signatures: `send` fails (giving the value back) when the receiver is\n");
        buf_str(out, c"// gone, `recv` fails when every sender is gone and nothing is left. The\n// queue is two Vecs from the allocator given (an inbox the senders push\n// to, an outbox the receiver pops, refilled from the inbox reversed); the\n// shared state is a lock, counts and a word the receiver sleeps on (the\n// number of sends and sender drops so far), from C's allocator.\n//\n//     let (tx, rx) = mpsc::channel_in(gpa);\n//     tx.send(7).unwrap();\n//     let x = rx.recv().unwrap();\n\nstruct Chan<T> {\n    lock: RawLock,\n    inbox: Vec<T>,\n    outbox: Vec<T>,\n    senders: AtomicU32,\n    receiving: AtomicU32,\n    // Bumped (release) by each send and each last sender's drop.\n    seq: AtomicU32,\n    // The Senders and the Receiver alive: the last one frees the channel.\n    refs: AtomicU32,\n}\n\nextern \"C\" {\n    #[link_name = \"malloc\"]\n    fn chan_c_malloc(n: u64) -> *u8;\n    #[link_name = \"free\"]\n    fn chan_c_free(p: *u8);\n}\n\n// The sending end; clone it for more senders.\npub struct Sender<T> { c: *Chan<T> }\n\n// The receiving end.\npub struct Receiver<T> { c: *Chan<T> }\n\n// send's error: the receiver is gone; the value comes back.\npub struct SendError<T> { value: T }\n\nimpl<T> SendError<T> {\n    // The value that was not sent.\n    pub fn into_inner(sink self) -> T {\n        let e = self;\n        e.value\n    }\n}\n\nimpl<T> Debug for SendError<T> {\n    fn fmt_debug(self, f: inout Fmt) {\n        f.str(\"SendError(..)\");\n    }\n}\n\nimpl<T> Display for SendError<T> {\n    fn fmt(self, f: inout Fmt) {\n        f.str(\"sending on a channel whose receiver is gone\");\n    }\n}\n\n// recv's error: every sender is gone and the channel is empty.\npub struct RecvError {}\n\nimpl Debug for RecvError {\n    fn fmt_debug(self, f: inout Fmt) {\n        f.str(\"RecvError\");\n    }\n}\n\nimpl Display for RecvError {\n    fn fmt(self, f: inout Fmt) {\n        f.str(\"receiving on a channel whose senders are gone\");\n    }\n}\n\n");
        buf_str(out, c"// A channel; its two ends. The queue grows from gpa.\npub fn channel_in<T>(gpa: Gpa) -> (Sender<T>, Receiver<T>) {\n    unsafe {\n        let c = chan_c_malloc(size_of(Chan<T>) as u64) as *Chan<T>;\n        if c == 0 as *Chan<T> {\n            out_of_memory();\n        }\n        *c = Chan {\n            lock: RawLock::new(), inbox: Vec::new_in(gpa), outbox: Vec::new_in(gpa),\n            senders: AtomicU32::new(1), receiving: AtomicU32::new(1), seq: AtomicU32::new(0),\n            refs: AtomicU32::new(2),\n        };\n        (Sender { c: c }, Receiver { c: c })\n    }\n}\n\n// One end let go: the last one drops what is left and frees the channel.\nunsafe fn chan_release<T>(c: *Chan<T>) {\n    if (*c).refs.fetch_sub(1, Ordering::AcqRel) == 1 {\n        let gone = *c;\n        chan_c_free(c as *u8);\n        drop(gone);\n    }\n}\n\nimpl<T> Sender<T> {\n    // Sends x; Err(x back) when the receiver is gone.\n    pub fn send(self, x: sink T) -> Result<(), SendError<T>> {\n        unsafe {\n            let c = self.c;\n            (*c).lock.lock();\n            if (*c).receiving.load(Ordering::Relaxed) == 0 {\n                (*c).lock.unlock();\n                return Err(SendError { value: x });\n            }\n            (*c).inbox.push(x);\n            (*c).lock.unlock();\n            (*c).seq.fetch_add(1, Ordering::Release);\n            sys_futex_wake((*c).seq.as_ptr(), false);\n            Ok(())\n        }\n    }\n}\n\nimpl<T> Clone for Sender<T> {\n    fn clone(self) -> Sender<T> {\n        unsafe {\n            (*self.c).senders.fetch_add(1, Ordering::Relaxed);\n            (*self.c).refs.fetch_add(1, Ordering::Relaxed);\n        }\n        Sender { c: self.c }\n    }\n}\n\nimpl<T> Drop for Sender<T> {\n    fn drop(inout self) {\n        unsafe {\n            let c = self.c;\n            if (*c).senders.fetch_sub(1, Ordering::AcqRel) == 1 {\n                // (the last one: a waiting receiver learns it)\n                (*c).lock.lock();\n");
        buf_str(out, c"                (*c).seq.fetch_add(1, Ordering::Release);\n                (*c).lock.unlock();\n                sys_futex_wake((*c).seq.as_ptr(), true);\n            }\n            chan_release(c);\n        }\n    }\n}\n\nimpl<T> Receiver<T> {\n    // The next value, waiting for one; Err when every sender is gone and\n    // nothing is left.\n    pub fn recv(self) -> Result<T, RecvError> {\n        unsafe {\n            let c = self.c;\n            loop {\n                (*c).lock.lock();\n                match chan_pop(c) {\n                    Some(x) => {\n                        (*c).lock.unlock();\n                        return Ok(x);\n                    }\n                    None => {}\n                }\n                if (*c).senders.load(Ordering::Acquire) == 0 {\n                    (*c).lock.unlock();\n                    return Err(RecvError {});\n                }\n                let seen = (*c).seq.load(Ordering::Acquire);\n                (*c).lock.unlock();\n                sys_futex_wait((*c).seq.as_ptr(), seen);\n            }\n        }\n    }\n\n    // The next value if there is one now.\n    pub fn try_recv(self) -> Option<T> {\n        unsafe {\n            let c = self.c;\n            (*c).lock.lock();\n            let x = chan_pop(c);\n            (*c).lock.unlock();\n            x\n        }\n    }\n\n    // The values, until every sender is gone: `for x in rx.iter()`.\n    pub fn iter(self) -> RecvIter<T> {\n        RecvIter { c: self.c }\n    }\n}\n\n// The next value of the queue (the lock held).\nunsafe fn chan_pop<T>(c: *Chan<T>) -> Option<T> {\n    if (*c).outbox.is_empty() {\n        loop {\n            match (*c).inbox.pop() {\n                Some(x) => (*c).outbox.push(x),\n                None => break,\n            }\n        }\n    }\n    (*c).outbox.pop()\n}\n\nimpl<T> Drop for Receiver<T> {\n    fn drop(inout self) {\n        unsafe {\n            let c = self.c;\n            (*c).lock.lock();\n");
        buf_str(out, c"            (*c).receiving.store(0, Ordering::Relaxed);\n            (*c).lock.unlock();\n            chan_release(c);\n        }\n    }\n}\n\n// Receiver::iter's iterator: recv until it fails.\npub struct RecvIter<T> { c: *Chan<T> }\n\nimpl<T> Iterator for RecvIter<T> {\n    type Item = T;\n\n    fn next(inout self) -> Option<T> {\n        let r = Receiver { c: self.c };\n        let x = r.recv();\n        std::forget(r);\n        match x {\n            Ok(v) => Some(v),\n            Err(_) => None,\n        }\n    }\n}\n// ---- end mod std::sync::mpsc ----\n}\n// ---- end mod std::sync ----\n}\n// ---- mod std::thread ----\npub mod thread {\n// std::thread: threads of the operating system (0.21).\n\nuse std::{Option, out_of_memory, panic_str};\nuse std::sync::atomic::{AtomicU32, Ordering};\n\n// ---- Threads (0.21) ----\n\n// Threads (docs/design/concurrency.md §2.3): `spawn` runs a closure on a\n// new thread and `join` waits for it and gives its result; `scope` runs a\n// closure that may start threads borrowing the caller's values, all of\n// them joined before it returns. A panic in any thread stops the program\n// (exit 101), so `join` returns the result itself, not a Result. A thread's\n// stack (8 MiB) and its start record come from C's allocator:\n// `alloc(extern)`.\n//\n// What crosses threads is checked where they start (front/threads.vl,\n// `sync.*` diagnostics): spawn takes a `move` closure whose captures and\n// result are Send and hold no view, and that reaches no `static mut`;\n// scope's closure changes nothing it borrows from the caller while its\n// threads read it, and a scoped thread only reads what it borrows.\n//\n//     let h = thread::spawn(move || work(input));\n//     let r = h.join();\n\nextern \"C\" {\n    #[link_name = \"malloc\"]\n    fn thread_c_malloc(n: u64) -> *u8;\n    #[link_name = \"free\"]\n    fn thread_c_free(p: *u8);\n    #[link_name = \"pthread_create\"]\n");
        buf_str(out, c"    fn thread_c_create(t: *u64, attr: *u8, f: extern \"C\" fn(*u8) -> *u8, arg: *u8) -> i32;\n    #[link_name = \"pthread_join\"]\n    fn thread_c_join(t: u64, ret: *u64) -> i32;\n    #[link_name = \"pthread_detach\"]\n    fn thread_c_detach(t: u64) -> i32;\n    #[link_name = \"pthread_attr_init\"]\n    #[effects(sync)]\n    fn thread_c_attr_init(a: *u8) -> i32;\n    #[link_name = \"pthread_attr_setstacksize\"]\n    #[effects(sync)]\n    fn thread_c_attr_setstacksize(a: *u8, size: u64) -> i32;\n    #[link_name = \"pthread_attr_destroy\"]\n    #[effects(sync)]\n    fn thread_c_attr_destroy(a: *u8) -> i32;\n    #[link_name = \"sched_yield\"]\n    fn thread_c_yield() -> i32;\n    #[link_name = \"sysconf\"]\n    #[effects()]\n    fn thread_c_sysconf(name: i32) -> i64;\n}\n\n// What a new thread starts from: run(data).\nstruct Start { run: fn(*u8), data: *u8 }\n\n// The result's place, shared by the thread and its handle: `refs` is 2\n// until one of them is done with it; the last one frees it.\nstruct Out<R> { refs: AtomicU32, result: Option<R> }\n\n// The closure, moved to the thread.\nstruct Packet<F, R> { f: F, out: *Out<R> }\n\n// The thread's first frame (C's convention, the address pthread_create\n// takes).\nextern \"C\" fn thread_start(arg: *u8) -> *u8 {\n    unsafe {\n        let s = arg as *Start;\n        let run = (*s).run;\n        let data = (*s).data;\n        thread_c_free(arg);\n        run(data);\n    }\n    0 as *u8\n}\n\n// The thread's work: the closure called, its result published.\nfn thread_run<F: FnMut() -> R, R>(data: *u8) {\n    unsafe {\n        let q = data as *Packet<F, R>;\n        var p = *q;\n        thread_c_free(data);\n        let r = (p.f)();\n        let out = p.out;\n        (*out).result = Some(r);\n        if (*out).refs.fetch_sub(1, Ordering::AcqRel) == 1 {\n            // (the handle is gone: nobody takes the result)\n            let gone = *out;\n            thread_c_free(out as *u8);\n            drop(gone);\n        }\n    }\n");
        buf_str(out, c"}\n\n// A running thread, joined by `join` or left to run (detached) when the\n// handle is dropped.\npub struct JoinHandle<R> { t: u64, out: *Out<R> }\n\nimpl<R> JoinHandle<R> {\n    // Waits for the thread to finish; its closure's result.\n    pub fn join(sink self) -> R {\n        unsafe {\n            var h = self;\n            thread_c_join(h.t, 0 as *u64);\n            let out = h.out;\n            h.out = 0 as *Out<R>;\n            let o = *out;\n            thread_c_free(out as *u8);\n            o.result.unwrap()\n        }\n    }\n}\n\nimpl<R> Drop for JoinHandle<R> {\n    fn drop(inout self) {\n        unsafe {\n            if self.out == 0 as *Out<R> {\n                return;\n            }\n            thread_c_detach(self.t);\n            let out = self.out;\n            if (*out).refs.fetch_sub(1, Ordering::AcqRel) == 1 {\n                let done = *out;\n                thread_c_free(out as *u8);\n                drop(done);\n            }\n        }\n    }\n}\n\n// The stack of a new thread: 8 MiB (macOS's default for threads past the\n// first is 512 KiB).\nconst THREAD_STACK: u64 = 8388608;\n\n// Starts a thread running f; its handle.\npub fn spawn<F: FnMut() -> R, R>(f: sink F) -> JoinHandle<R> {\n    unsafe {\n        std::fmt::print_threads_started();\n        let out = thread_c_malloc(size_of(Out<R>) as u64) as *Out<R>;\n        if out == 0 as *Out<R> {\n            out_of_memory();\n        }\n        *out = Out { refs: AtomicU32::new(2), result: None };\n        let q = thread_c_malloc(size_of(Packet<F, R>) as u64) as *Packet<F, R>;\n        let s = thread_c_malloc(size_of(Start) as u64) as *Start;\n        if q == 0 as *Packet<F, R> || s == 0 as *Start {\n            out_of_memory();\n        }\n        *q = Packet { f: f, out: out };\n        *s = Start { run: thread_run::<F, R>, data: q as *u8 };\n        // (pthread_attr_t: 64 bytes on macOS and Linux; room for more)\n        var attr: [u64; 16] = [0; 16];\n");
        buf_str(out, c"        let a = &attr as *u8;\n        thread_c_attr_init(a);\n        thread_c_attr_setstacksize(a, THREAD_STACK);\n        var t: u64 = 0;\n        let rc = thread_c_create(&t, a, thread_start, s as *u8);\n        thread_c_attr_destroy(a);\n        if rc != 0 {\n            panic_str(\"thread::spawn: the system could not start a thread\");\n        }\n        JoinHandle { t: t, out: out }\n    }\n}\n\n// The threads a `scope` started, joined when it ends: a list.\npub struct Scope { first: *ScopeJoin }\n\n// A thread of a scope: its handle's join, erased, and the next one.\nstruct ScopeJoin { join: fn(*u8), handle: *u8, next: *ScopeJoin }\n\n// A thread started in a scope: `join` gives its result; a thread not\n// joined by hand is joined when the scope ends.\npub struct ScopedJoinHandle<R> { slot: *ScopeHandle<R> }\n\nstruct ScopeHandle<R> { h: Option<JoinHandle<R>>, done: bool }\n\nfn scope_join<R>(p: *u8) {\n    unsafe {\n        let s = p as *ScopeHandle<R>;\n        if !(*s).done {\n            (*s).done = true;\n            let h = (*s).h;\n            (*s).h = None;\n            match h {\n                Some(handle) => drop(handle.join()),\n                None => {}\n            }\n        }\n        let gone = *s;\n        thread_c_free(p);\n        drop(gone);\n    }\n}\n\nimpl<R> ScopedJoinHandle<R> {\n    // Waits for the thread; its result.\n    pub fn join(sink self) -> R {\n        unsafe {\n            let s = self.slot;\n            (*s).done = true;\n            let h = (*s).h;\n            (*s).h = None;\n            h.unwrap().join()\n        }\n    }\n}\n\nimpl Scope {\n    // Starts a thread running f, joined at the latest when the scope ends.\n    pub fn spawn<F: FnMut() -> R, R>(inout self, f: sink F) -> ScopedJoinHandle<R> {\n        unsafe {\n            let slot = thread_c_malloc(size_of(ScopeHandle<R>) as u64) as *ScopeHandle<R>;\n            if slot == 0 as *ScopeHandle<R> {\n                out_of_memory();\n            }\n");
        buf_str(out, c"            let node = thread_c_malloc(size_of(ScopeJoin) as u64) as *ScopeJoin;\n            if node == 0 as *ScopeJoin {\n                out_of_memory();\n            }\n            *slot = ScopeHandle { h: Some(spawn(f)), done: false };\n            *node = ScopeJoin { join: scope_join::<R>, handle: slot as *u8, next: self.first };\n            self.first = node;\n            ScopedJoinHandle { slot: slot }\n        }\n    }\n}\n\n// Runs f with a scope; every thread started in it is joined before scope\n// returns f's result.\npub fn scope<F: FnMut(inout Scope) -> R, R>(f: sink F) -> R {\n    unsafe {\n        var s = Scope { first: 0 as *ScopeJoin };\n        var g = f;\n        let r = g(&s);\n        var n = s.first;\n        while n != 0 as *ScopeJoin {\n            let next = (*n).next;\n            ((*n).join)((*n).handle);\n            thread_c_free(n as *u8);\n            n = next;\n        }\n        r\n    }\n}\n\n// Lets another thread run.\npub fn yield_now() {\n    unsafe { thread_c_yield(); }\n}\n\n// How many threads can run at once (the CPUs online), at least 1.\npub fn available_parallelism() -> i64 {\n    let n = unsafe { thread_c_sysconf(std::SYS_SC_NPROCESSORS_ONLN) };\n    if n < 1 { 1 } else { n }\n}\n\n// ---- Thread-locals (0.21) ----\n\n// `#[thread_local] static mut X: T = INIT;` (docs/design/concurrency.md\n// §2.3): each thread has its own X, made from INIT when the thread first\n// reaches it. 0.21.0 keeps them with the C library's thread-specific data:\n// the compiler makes every access of X `*__tls_addr(&X's initial value,\n// size)`, a key per thread-local (made once, kept in a table by the\n// initial value's address: looked up without a lock), the thread's copy\n// allocated from C at its first access and freed when the thread ends. A\n// thread-local's drop does not run.\n\nextern \"C\" {\n    #[link_name = \"pthread_key_create\"]\n    #[effects(sync)]\n");
        buf_str(out, c"    fn tls_c_key_create(key: *u64, destructor: extern \"C\" fn(*u8)) -> i32;\n    #[link_name = \"pthread_getspecific\"]\n    #[effects()]\n    fn tls_c_get(key: u64) -> *u8;\n    #[link_name = \"pthread_setspecific\"]\n    #[effects(sync)]\n    fn tls_c_set(key: u64, p: *u8) -> i32;\n    #[link_name = \"memcpy\"]\n    #[effects()]\n    fn tls_c_memcpy(d: *u8, s: *u8, n: u64) -> *u8;\n}\n\n// The key table: open addressing on the initial value's address; an\n// entry's key is published (release) before its address.\nconst TLS_SLOTS: i64 = 1024;\nstatic var TLS_ADDRS: [u64; 1024] = [0; 1024];\nstatic var TLS_KEYS: [u64; 1024] = [0; 1024];\nstatic var TLS_LOCK: std::sync::RawLock = std::sync::RawLock {\n    state: AtomicU32 { v: 0 },\n};\n\nextern \"C\" fn tls_free(p: *u8) {\n    unsafe { thread_c_free(p); }\n}\n\n// This thread's copy of the thread-local whose initial value (size bytes)\n// is at template.\npub unsafe fn __tls_addr(template: *u8, size: i64) -> *u8 {\n    let key = tls_key(template);\n    let p = tls_c_get(key);\n    if p != 0 as *u8 {\n        return p;\n    }\n    tls_first(key, template, size)\n}\n\n#[inline(never)]\nunsafe fn tls_first(key: u64, template: *u8, size: i64) -> *u8 {\n    let n = if size > 0 { size } else { 1 };\n    let p = thread_c_malloc(n as u64);\n    if p == 0 as *u8 {\n        out_of_memory();\n    }\n    tls_c_memcpy(p, template, size as u64);\n    tls_c_set(key, p);\n    p\n}\n\nunsafe fn tls_key(template: *u8) -> u64 {\n    let a = template as u64;\n    var i = ((a >> 4) * 0x9e3779b97f4a7c15 >> 54) as i64;\n    loop {\n        let seen = std::sync::atomic::atomic_load(&TLS_ADDRS[i] as *u64, 1);\n        if seen == a {\n            return std::sync::atomic::atomic_load(&TLS_KEYS[i] as *u64, 1) - 1;\n        }\n        if seen == 0 {\n            return tls_new_key(a);\n        }\n        i = (i + 1) % TLS_SLOTS;\n    }\n}\n\n#[inline(never)]\nunsafe fn tls_new_key(a: u64) -> u64 {\n    TLS_LOCK.lock();\n");
        buf_str(out, c"    var i = ((a >> 4) * 0x9e3779b97f4a7c15 >> 54) as i64;\n    var probes = 0;\n    loop {\n        let seen = std::sync::atomic::atomic_load(&TLS_ADDRS[i] as *u64, 1);\n        if seen == a {\n            TLS_LOCK.unlock();\n            return std::sync::atomic::atomic_load(&TLS_KEYS[i] as *u64, 1) - 1;\n        }\n        if seen == 0 {\n            break;\n        }\n        probes += 1;\n        if probes >= TLS_SLOTS {\n            panic_str(\"thread-locals: more than 1024\");\n        }\n        i = (i + 1) % TLS_SLOTS;\n    }\n    var key: u64 = 0;\n    if tls_c_key_create(&key, tls_free) != 0 {\n        panic_str(\"thread-locals: the system has no key left\");\n    }\n    std::sync::atomic::atomic_store(&TLS_KEYS[i] as *u64, key + 1, 2);\n    std::sync::atomic::atomic_store(&TLS_ADDRS[i] as *u64, a, 2);\n    TLS_LOCK.unlock();\n    key\n}\n// ---- end mod std::thread ----\n}\n// ---- mod std::objc ----\npub mod objc {\n// std::objc (0.22, docs/design/gpu.md §2.9): the Objective-C runtime for\n// vole programs, on macOS. A program that uses it links libobjc\n// (`volec prog.vl -l objc -o prog`); frameworks are opened at run\n// time (`objc::framework(\"Metal\")`), so no -framework is needed at link.\n//\n// - `Id<T>`: an owned (+1) reference to an object of class or protocol T,\n//   a zero-sized marker type, so that Id<MTLBuffer> and Id<MTLTexture> do\n//   not mix. Dropping it sends release; `clone()` sends retain.\n// - `Ref<T>`: a borrowed (+0) reference, a view: it cannot outlive the Id\n//   (or the reference) it came from. `retain()` makes it an Id<T>.\n// - Methods come from tables (compiler/std/objc/tables/*.objc) through\n//   tools/objcgen, which checks every line against the runtime's type\n//   encodings: no objc_msgSend prototype is written by hand.\n\npub mod foundation;\n\nuse foundation::{\n    NSException, NSExceptionMethods, NSObject, NSObjectMethods, NSString, NSStringMethods,\n};\n\n");
        buf_str(out, c"// (0.25) The Objective-C runtime, linked by a program that calls into it\n// (#[link]: when it uses a symbol of this block); the frameworks are\n// opened at run time.\n#[link(lib = \"objc\")]\nextern \"C\" {\n    fn objc_retain(o: *u8) -> *u8;\n    fn objc_release(o: *u8);\n    fn objc_autoreleasePoolPush() -> *u8;\n    fn objc_autoreleasePoolPop(p: *u8);\n    fn sel_registerName(name: *u8) -> *u8;\n    fn objc_getClass(name: *u8) -> *u8;\n}\n\nextern \"C\" {\n    fn strlen(s: *u8) -> u64;\n    fn dlopen(path: *u8, mode: i32) -> *u8;\n    fn dlsym(handle: *u8, name: *u8) -> *u8;\n}\n\n// ---- Objective-C objects (0.22) ----\n\n/// Any object (Objective-C's `id`).\npub struct Object {}\n\n/// What a Ref made from no Id views: objects that live as long as the\n/// process (classes) or the current autorelease pool.\nstatic ANCHOR: u8 = 0;\n\n/// An owned reference (+1) to an object of class or protocol T.\npub struct Id<T> {\n    pub ptr: *u8,\n    anchor: u8,\n}\n\n/// A borrowed reference (+0) to an object of class or protocol T, a view\n/// of what keeps the object alive.\npub struct Ref<T> {\n    pub ptr: *u8,\n    pub keep: let u8,\n}\n\nimpl<T> Drop for Id<T> {\n    fn drop(inout self) {\n        let p = self.ptr;\n        self.ptr = 0 as *u8;\n        // retain and release accept any object pointer and nil; p was a +1\n        // reference this Id owned\n        if !p.is_null() {\n            unsafe { objc_release(p); }\n        }\n    }\n}\n\nimpl<T> Id<T> {\n    /// Takes over a +1 reference (a result of the alloc, new, copy or\n    /// mutableCopy families); None for nil. The caller promises that p is\n    /// nil or a +1 reference to an object of T.\n    pub unsafe fn from_owned(p: *u8) -> Option<Id<T>> {\n        if p.is_null() { None } else { Some(Id::<T> { ptr: p, anchor: 0 }) }\n    }\n\n    /// The same, nil kept as a nil Id (messages to nil do nothing and\n    /// return 0; release of nil does nothing).\n");
        buf_str(out, c"    pub unsafe fn from_owned_or_nil(p: *u8) -> Id<T> {\n        Id::<T> { ptr: p, anchor: 0 }\n    }\n\n    /// A nil Id.\n    pub fn nil() -> Id<T> {\n        Id::<T> { ptr: 0 as *u8, anchor: 0 }\n    }\n\n    /// A borrowed reference to the object, valid while this Id is.\n    pub fn r(self) -> Ref<T> {\n        Ref::<T> { ptr: self.ptr, keep: self.anchor }\n    }\n\n    pub fn is_nil(self) -> bool {\n        self.ptr.is_null()\n    }\n\n    /// Gives the +1 reference up without releasing it (to a method of the\n    /// init family, which consumes its receiver).\n    pub fn into_raw(sink self) -> *u8 {\n        var me = self;\n        let p = me.ptr;\n        me.ptr = 0 as *u8;\n        p\n    }\n\n    /// The object's retain count (for tests: Cocoa's own count, which\n    /// includes the references the frameworks hold).\n    pub fn retain_count(self) -> u64 {\n        self.r().object().retain_count()\n    }\n\n    /// Reinterprets the reference as one to U. The caller promises that\n    /// the object is of class or protocol U.\n    pub unsafe fn cast<U>(sink self) -> Id<U> {\n        Id::<U> { ptr: self.into_raw(), anchor: 0 }\n    }\n}\n\nimpl<T> Clone for Id<T> {\n    /// Another owned reference to the same object: sends retain.\n    fn clone(self) -> Id<T> {\n        // a live (or nil) object pointer owned by self\n        if !self.ptr.is_null() {\n            unsafe { objc_retain(self.ptr); }\n        }\n        Id::<T> { ptr: self.ptr, anchor: 0 }\n    }\n}\n\nimpl<T> Ref<T> {\n    /// A reference to p that lives as long as what `keep` points to (0.20:\n    /// its address, `&r.keep as *u8`: a let parameter of a u8 is a copy). The\n    /// caller promises that p is nil or an object of T, alive while it is used.\n    pub unsafe fn from_raw(p: *u8, keep: *u8) -> Ref<T> {\n        Ref::<T> { ptr: p, keep: *keep }\n    }\n\n    /// The same, None for nil.\n    pub unsafe fn from_raw_opt(p: *u8, keep: *u8) -> Option<Ref<T>> {\n");
        buf_str(out, c"        if p.is_null() { None } else { Some(Ref::<T> { ptr: p, keep: *keep }) }\n    }\n\n    /// A reference to an object the process or the current pool keeps\n    /// (a class, an autoreleased result). The caller promises as for\n    /// from_raw.\n    pub unsafe fn from_global(p: *u8) -> Ref<T> {\n        Ref::<T> { ptr: p, keep: ANCHOR }\n    }\n\n    /// The same, None for nil.\n    pub unsafe fn from_global_opt(p: *u8) -> Option<Ref<T>> {\n        if p.is_null() { None } else { Some(Ref::<T> { ptr: p, keep: ANCHOR }) }\n    }\n\n    /// An owned reference to the object: sends retain.\n    pub fn retain(sink self) -> Id<T> {\n        // a live (or nil) object pointer\n        if !self.ptr.is_null() {\n            unsafe { objc_retain(self.ptr); }\n        }\n        Id::<T> { ptr: self.ptr, anchor: 0 }\n    }\n\n    pub fn is_nil(sink self) -> bool {\n        self.ptr.is_null()\n    }\n\n    /// The object as an NSObject (every class here derives from it).\n    pub fn object(sink self) -> Ref<NSObject> {\n        Ref::<NSObject> { ptr: self.ptr, keep: self.keep }\n    }\n\n    /// The object as an `id`.\n    pub fn any(sink self) -> Ref<Object> {\n        Ref::<Object> { ptr: self.ptr, keep: self.keep }\n    }\n\n    /// Reinterprets the reference as one to U. The caller promises that\n    /// the object is of class or protocol U.\n    pub unsafe fn cast<U>(sink self) -> Ref<U> {\n        Ref::<U> { ptr: self.ptr, keep: self.keep }\n    }\n}\n\n/// The pointer of an optional reference (nil for None), for the generated\n/// bindings' nullable parameters.\npub fn opt_ptr<T>(r: sink Option<Ref<T>>) -> *u8 {\n    match r {\n        Some(x) => x.ptr,\n        None => 0 as *u8,\n    }\n}\n\n// ---- Autorelease pools, selectors, classes, frameworks (0.22) ----\n\n/// Runs f inside an autorelease pool: the objects autoreleased while it\n/// runs are released at its end (closure-scoped push and pop).\npub fn pool<R, F: FnMut() -> R>(f: sink F) -> R {\n");
        buf_str(out, c"    // push and pop are balanced here, in one frame\n    let p = unsafe { objc_autoreleasePoolPush() };\n    let r = f();\n    unsafe { objc_autoreleasePoolPop(p); }\n    r\n}\n\n/// A pool as a value: popped when dropped (pools nest: drop the inner one\n/// first, as a scope does).\npub struct Pool {\n    p: *u8,\n}\n\nimpl Pool {\n    pub fn push() -> Pool {\n        Pool { p: unsafe { objc_autoreleasePoolPush() } }\n    }\n}\n\nimpl Drop for Pool {\n    fn drop(inout self) {\n        // p came from objc_autoreleasePoolPush (the owner keeps the nesting)\n        if !self.p.is_null() {\n            unsafe { objc_autoreleasePoolPop(self.p); }\n        }\n        self.p = 0 as *u8;\n    }\n}\n\n/// The selector for a NUL-terminated name (the generated bindings cache\n/// theirs in statics). The caller passes a NUL-terminated string.\npub unsafe fn sel(name: *u8) -> *u8 {\n    sel_registerName(name)\n}\n\n/// The class of that name, or nil. The caller passes a NUL-terminated\n/// string.\npub unsafe fn class(name: *u8) -> *u8 {\n    objc_getClass(name)\n}\n\n/// Opens a system framework (`framework(\"Metal\")`: its classes and\n/// protocols are registered, its C functions reachable through `symbol`);\n/// false when there is none. Opening one twice is cheap.\npub fn framework(name: [u8]) -> bool {\n    var path: [u8; 256] = [0; 256];\n    let pre = \"/System/Library/Frameworks/\";\n    var n = 0;\n    for part in [pre, name, \".framework/\", name] {\n        for b in part {\n            if n < 255 {\n                path[n] = b;\n                n += 1;\n            }\n        }\n    }\n    if n >= 255 { return false; }\n    // a NUL-terminated path in a local array; RTLD_NOW | RTLD_GLOBAL\n    let h = unsafe { dlopen(&path[0] as *u8, 2 | 8) };\n    !h.is_null()\n}\n\n/// The address of a C symbol of the process and the frameworks it opened,\n/// or null. The caller passes a NUL-terminated name.\npub unsafe fn symbol(name: *u8) -> *u8 {\n");
        buf_str(out, c"    // RTLD_DEFAULT is (void *)-2 on macOS\n    dlsym(-2 as *u8, name)\n}\n\n// ---- Strings and exceptions (0.22) ----\n\n/// A new NSString holding a copy of the UTF-8 bytes of s.\npub fn ns_string(s: [u8]) -> Id<NSString> {\n    let a = NSString::alloc();\n    // initWithBytes:length:encoding: reads s.len() bytes at s.ptr()\n    let r = unsafe {\n        NSString::init_with_bytes_length_encoding(a, s.ptr, s.len() as u64,\n            foundation::NSUTF8StringEncoding)\n    };\n    match r {\n        Some(x) => x,\n        None => Id::<NSString>::nil(),\n    }\n}\n\n/// The UTF-8 bytes of s (empty for nil): a view, valid while s's owner\n/// and the current autorelease pool are.\npub fn ns_bytes(s: Ref<NSString>) -> [u8] {\n    if s.is_nil() { return \"\"; }\n    let p = s.utf8_string();\n    if p.is_null() { return \"\"; }\n    // UTF8String is NUL-terminated and lives as long as s and the pool\n    unsafe { p[0..strlen(p) as i64] }\n}\n\n/// Appends the UTF-8 text of s (nothing for nil) to out.\npub fn push_ns_string<A: Allocator>(out: inout Buf<A>, s: Ref<NSString>) {\n    out.push_str(ns_bytes(s));\n}\n\nextern \"C\" fn print_uncaught(e: *u8) {\n    let ex = unsafe { Ref::<NSException>::from_global(e) };\n    let reason = match ex.reason() {\n        Some(r) => ns_bytes(r),\n        None => \"(no reason)\",\n    };\n    eprintln(f\"objc: uncaught exception {ns_bytes(ex.name())}: {reason}\");\n}\n\nstatic var INITIALIZED: bool = false;\n\n/// Opens Foundation and installs a handler that prints an Objective-C\n/// exception's name and reason before the process ends (an exception that\n/// reaches vole frames terminates it: no vole frame has a handler;\n/// a crash, not undefined behaviour). Idempotent.\npub fn init() {\n    if INITIALIZED { return; }\n    INITIALIZED = true;\n    framework(\"Foundation\");\n    // NSSetUncaughtExceptionHandler is Foundation's, opened above\n    let f = unsafe { symbol(c\"NSSetUncaughtExceptionHandler\") };\n    if !f.is_null() {\n");
        buf_str(out, c"        let set = unsafe { HandlerSetter { p: f }.f };\n        unsafe { set(print_uncaught); }\n    }\n}\n\n#[repr(C)]\nunion HandlerSetter {\n    p: *u8,\n    f: extern \"C\" fn(extern \"C\" fn(*u8)),\n}\n// ---- mod std::objc::foundation ----\npub mod foundation {\n// Generated by tools/objcgen from compiler/std/objc/tables/foundation.objc: do not edit.\n// Every prototype below is checked against the Objective-C runtime's\n// type encoding by `objcgen --check`, and every constant and struct\n// against the SDK's headers by `objcgen --c-check` (tests/gpu/run.sh).\n\nuse std::objc::{Id, Object, Ref, opt_ptr};\n\nextern \"C\" {\n    fn sel_registerName(name: *u8) -> *u8;\n    fn objc_getClass(name: *u8) -> *u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_u64(o: *u8, s: *u8) -> u64;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p(o: *u8, s: *u8) -> *u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_p_u64_u64(o: *u8, s: *u8, a0: *u8, a1: u64, a2: u64) -> *u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_i64(o: *u8, s: *u8) -> i64;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_u64(o: *u8, s: *u8, a0: u64) -> *u8;\n}\n\n// The selectors and classes, looked up on first use.\nstatic var SEL_0: *u8 = 0 as *u8;\n\nfn sel_0() -> *u8 {\n    if SEL_0.is_null() {\n        SEL_0 = unsafe { sel_registerName(c\"retainCount\") };\n    }\n    SEL_0\n}\n\nstatic var SEL_1: *u8 = 0 as *u8;\n\nfn sel_1() -> *u8 {\n    if SEL_1.is_null() {\n        SEL_1 = unsafe { sel_registerName(c\"description\") };\n    }\n    SEL_1\n}\n\nstatic var SEL_2: *u8 = 0 as *u8;\n\nfn sel_2() -> *u8 {\n    if SEL_2.is_null() {\n        SEL_2 = unsafe { sel_registerName(c\"UTF8String\") };\n    }\n    SEL_2\n}\n\nstatic var SEL_3: *u8 = 0 as *u8;\n\nfn sel_3() -> *u8 {\n    if SEL_3.is_null() {\n        SEL_3 = unsafe { sel_registerName(c\"length\") };\n    }\n    SEL_3\n}\n\nstatic var SEL_4: *u8 = 0 as *u8;\n\nfn sel_4() -> *u8 {\n    if SEL_4.is_null() {\n");
        buf_str(out, c"        SEL_4 = unsafe { sel_registerName(c\"alloc\") };\n    }\n    SEL_4\n}\n\nstatic var SEL_5: *u8 = 0 as *u8;\n\nfn sel_5() -> *u8 {\n    if SEL_5.is_null() {\n        SEL_5 = unsafe { sel_registerName(c\"initWithBytes:length:encoding:\") };\n    }\n    SEL_5\n}\n\nstatic var SEL_6: *u8 = 0 as *u8;\n\nfn sel_6() -> *u8 {\n    if SEL_6.is_null() {\n        SEL_6 = unsafe { sel_registerName(c\"localizedDescription\") };\n    }\n    SEL_6\n}\n\nstatic var SEL_7: *u8 = 0 as *u8;\n\nfn sel_7() -> *u8 {\n    if SEL_7.is_null() {\n        SEL_7 = unsafe { sel_registerName(c\"code\") };\n    }\n    SEL_7\n}\n\nstatic var SEL_8: *u8 = 0 as *u8;\n\nfn sel_8() -> *u8 {\n    if SEL_8.is_null() {\n        SEL_8 = unsafe { sel_registerName(c\"domain\") };\n    }\n    SEL_8\n}\n\nstatic var SEL_9: *u8 = 0 as *u8;\n\nfn sel_9() -> *u8 {\n    if SEL_9.is_null() {\n        SEL_9 = unsafe { sel_registerName(c\"name\") };\n    }\n    SEL_9\n}\n\nstatic var SEL_10: *u8 = 0 as *u8;\n\nfn sel_10() -> *u8 {\n    if SEL_10.is_null() {\n        SEL_10 = unsafe { sel_registerName(c\"reason\") };\n    }\n    SEL_10\n}\n\nstatic var SEL_11: *u8 = 0 as *u8;\n\nfn sel_11() -> *u8 {\n    if SEL_11.is_null() {\n        SEL_11 = unsafe { sel_registerName(c\"count\") };\n    }\n    SEL_11\n}\n\nstatic var SEL_12: *u8 = 0 as *u8;\n\nfn sel_12() -> *u8 {\n    if SEL_12.is_null() {\n        SEL_12 = unsafe { sel_registerName(c\"objectAtIndex:\") };\n    }\n    SEL_12\n}\n\nstatic var CLASS_0: *u8 = 0 as *u8;\n\nfn class_0() -> *u8 {\n    if CLASS_0.is_null() {\n        CLASS_0 = unsafe { objc_getClass(c\"NSString\") };\n    }\n    CLASS_0\n}\n\npub const NSUTF8StringEncoding: u64 = 4;\n\n/// The Objective-C class NSObject.\npub struct NSObject {}\n\npub trait NSObjectMethods {\n    // retainCount\n    fn retain_count(self) -> u64;\n    // description\n    fn description(self) -> Ref<NSString>;\n}\n\nimpl NSObjectMethods for Ref<NSObject> {\n    fn retain_count(self) -> u64 {\n");
        buf_str(out, c"        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_u64(self.ptr, sel_0()) }\n    }\n    fn description(self) -> Ref<NSString> {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { Ref::<NSString>::from_raw(msg_p(self.ptr, sel_1()), &self.keep as *u8) }\n    }\n}\n\nimpl NSObjectMethods for Ref<NSString> {\n    fn retain_count(self) -> u64 {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_u64(self.ptr, sel_0()) }\n    }\n    fn description(self) -> Ref<NSString> {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { Ref::<NSString>::from_raw(msg_p(self.ptr, sel_1()), &self.keep as *u8) }\n    }\n}\n\nimpl NSObjectMethods for Ref<NSError> {\n    fn retain_count(self) -> u64 {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_u64(self.ptr, sel_0()) }\n    }\n    fn description(self) -> Ref<NSString> {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { Ref::<NSString>::from_raw(msg_p(self.ptr, sel_1()), &self.keep as *u8) }\n    }\n}\n\nimpl NSObjectMethods for Ref<NSException> {\n    fn retain_count(self) -> u64 {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_u64(self.ptr, sel_0()) }\n    }\n    fn description(self) -> Ref<NSString> {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { Ref::<NSString>::from_raw(msg_p(self.ptr, sel_1()), &self.keep as *u8) }\n    }\n}\n\nimpl NSObjectMethods for Ref<NSArray> {\n    fn retain_count(self) -> u64 {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_u64(self.ptr, sel_0()) }\n    }\n    fn description(self) -> Ref<NSString> {\n");
        buf_str(out, c"        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { Ref::<NSString>::from_raw(msg_p(self.ptr, sel_1()), &self.keep as *u8) }\n    }\n}\n\n/// The Objective-C class NSString.\npub struct NSString {}\n\npub trait NSStringMethods {\n    // UTF8String\n    fn utf8_string(self) -> *u8;\n    // length\n    fn length(self) -> u64;\n}\n\nimpl NSStringMethods for Ref<NSString> {\n    fn utf8_string(self) -> *u8 {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_p(self.ptr, sel_2()) }\n    }\n    fn length(self) -> u64 {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_u64(self.ptr, sel_3()) }\n    }\n}\n\nimpl NSString {\n    // +alloc\n    pub fn alloc() -> Id<NSString> {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { Id::<NSString>::from_owned_or_nil(msg_p(class_0(), sel_4())) }\n    }\n    // -initWithBytes:length:encoding:: consumes `this` (the init family), returns +1\n    pub unsafe fn init_with_bytes_length_encoding(this: sink Id<NSString>, bytes: *u8, length: u64, encoding: u64) -> Option<Id<NSString>> {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        Id::<NSString>::from_owned(msg_p_p_u64_u64(this.into_raw(), sel_5(), bytes, length, encoding))\n    }\n}\n\n/// The Objective-C class NSError.\npub struct NSError {}\n\npub trait NSErrorMethods {\n    // localizedDescription\n    fn localized_description(self) -> Ref<NSString>;\n    // code\n    fn code(self) -> i64;\n    // domain\n    fn domain(self) -> Ref<NSString>;\n}\n\nimpl NSErrorMethods for Ref<NSError> {\n    fn localized_description(self) -> Ref<NSString> {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { Ref::<NSString>::from_raw(msg_p(self.ptr, sel_6()), &self.keep as *u8) }\n    }\n");
        buf_str(out, c"    fn code(self) -> i64 {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_i64(self.ptr, sel_7()) }\n    }\n    fn domain(self) -> Ref<NSString> {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { Ref::<NSString>::from_raw(msg_p(self.ptr, sel_8()), &self.keep as *u8) }\n    }\n}\n\n/// The Objective-C class NSException.\npub struct NSException {}\n\npub trait NSExceptionMethods {\n    // name\n    fn name(self) -> Ref<NSString>;\n    // reason\n    fn reason(self) -> Option<Ref<NSString>>;\n}\n\nimpl NSExceptionMethods for Ref<NSException> {\n    fn name(self) -> Ref<NSString> {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { Ref::<NSString>::from_raw(msg_p(self.ptr, sel_9()), &self.keep as *u8) }\n    }\n    fn reason(self) -> Option<Ref<NSString>> {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { Ref::<NSString>::from_raw_opt(msg_p(self.ptr, sel_10()), &self.keep as *u8) }\n    }\n}\n\n/// The Objective-C class NSArray.\npub struct NSArray {}\n\npub trait NSArrayMethods {\n    // count\n    fn count(self) -> u64;\n    // objectAtIndex:\n    fn object_at_index(self, index: u64) -> Ref<Object>;\n}\n\nimpl NSArrayMethods for Ref<NSArray> {\n    fn count(self) -> u64 {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { msg_u64(self.ptr, sel_11()) }\n    }\n    fn object_at_index(self, index: u64) -> Ref<Object> {\n        // the prototype is checked against the runtime's encoding (objcgen --check)\n        unsafe { Ref::<Object>::from_raw(msg_p_u64(self.ptr, sel_12(), index), &self.keep as *u8) }\n    }\n}\n\n// ---- end mod std::objc::foundation ----\n}\n// ---- end mod std::objc ----\n}\n// ---- mod std::gpu ----\npub mod gpu {\n");
        buf_str(out, c"// std::gpu (0.22, docs/design/gpu.md §2): GPU compute and rendering on\n// wgpu's model. On macOS it runs on Metal (std::gpu::hal::metal); a\n// program that uses it links libobjc: `volec prog.vl -l objc -o\n// prog` (Metal itself is opened at run time).\n//\n// - The objects are wgpu's: Instance, Adapter, Device and Queue, Buffer\n//   (mapping included), Texture and TextureView, Sampler, Shader, the\n//   pipelines, BindGroup, Encoder and Commands, the passes, Surface and\n//   Frame. Each resource is an owned value: dropping it releases it, also\n//   while the GPU still uses it (the work keeps it alive).\n// - Passes are closure-scoped: `enc.compute_pass(|pass| { ... })`.\n// - Misuse is a contract failure (`requires`, exit 101 with the rule's\n//   code: gpu.usage, gpu.align, gpu.range, gpu.layout, gpu.pipeline,\n//   gpu.format, gpu.limits, gpu.state, gpu.unsupported); what can fail\n//   however correct the program is (no adapter, a shader the driver\n//   rejects, a lost device) is a Result.\n// - Backends are behind std::gpu::hal: `Api` (compute, memory, copies)\n//   and `Render` (pipelines, passes, surfaces). Nothing here assumes a\n//   backend's memory model or queue: buffers are reached through\n//   map_read, map_write and unmap; `dev.caps()` says what the device can\n//   do, and a compute-only backend reports `render: false`.\n// - Shaders: `dev.shader(&src)` takes the shader compiler's output for\n//   the device's ShaderKind (MSL on Metal): a ShaderSource, the code and\n//   its reflection.\n\npub mod hal;\npub mod shader;\npub mod types;\npub mod wgsl;\n\npub use hal::{Caps, RawSurface};\npub use shader::{\n    Binding, BindingType, EntryPoint, GroupBinding, Reflection, ShaderKind, ShaderSource,\n    VertexInput,\n};\npub use types::{\n    AddressMode, Blend, BlendComponent, BlendFactor, BlendOp, BufferUsage, Color, ColorTarget,\n    Compare, Cull, DepthState, Filter, Format, FrontFace, IndexFormat, Limits, Load, PipelineState,\n");
        buf_str(out, c"    Power, SamplerDesc, ShaderStage, StepMode, TextureDesc, TextureUsage, Topology, VertexAttribute,\n    VertexFormat, VertexLayout,\n};\n\nuse hal::{Api, Render};\nuse hal::metal as backend;\nuse std::iter::Range;\nuse types::{MAX_BIND_GROUPS, MAX_COLOR_TARGETS, MAX_VERTEX_BUFFERS};\n\nextern \"C\" {\n    fn exit(status: i32) -> !;\n}\n\n/// The backend of this build (Metal on macOS).\npub type Native = backend::Metal;\n\ntype N = backend::Metal;\n\n// ---- GPU: errors (0.22) ----\n\n/// What can fail however correct the program is (§2.7); misuse is a\n/// contract failure instead. Messages are the driver's.\npub enum Error {\n    NoAdapter,\n    DeviceCreation,\n    Shader(Buf),\n    Pipeline(Buf),\n    Submission,\n    SurfaceLost,\n}\n\nimpl Display for Error {\n    fn fmt(self, f: inout Fmt) {\n        match self {\n            Error::NoAdapter => f.str(\"gpu: no adapter\"),\n            Error::DeviceCreation => f.str(\"gpu: the device could not be opened\"),\n            Error::Shader(m) => {\n                f.str(\"gpu: the shader did not compile: \");\n                f.str(m.as_slice());\n            }\n            Error::Pipeline(m) => {\n                f.str(\"gpu: the pipeline was rejected: \");\n                f.str(m.as_slice());\n            }\n            Error::Submission => f.str(\"gpu: a submission failed (device lost or out of memory)\"),\n            Error::SurfaceLost => f.str(\n                \"gpu: the surface has no frame to give (lost, or reconfigure it)\"),\n        }\n    }\n}\n\nimpl Debug for Error {\n    fn fmt_debug(self, f: inout Fmt) {\n        self.fmt(&f);\n    }\n}\n\n/// The device ran out of memory where the API returns no Result (buffer,\n/// texture, sampler creation): the process ends, as an allocation failure\n/// of Gpa does.\nfn out_of_memory(what: [u8]) -> ! {\n    eprintln(f\"gpu: out of device memory ({what})\");\n    // exit is the C library's\n    unsafe { exit(101) }\n}\n\n");
        buf_str(out, c"// ---- GPU: instance, adapters, devices (0.22) ----\n\n/// The entry point: holds the allocator the devices use for host memory.\npub struct Instance {\n    pub gpa: Gpa,\n}\n\nimpl Instance {\n    pub fn new_in(gpa: Gpa) -> Instance {\n        Instance { gpa: gpa }\n    }\n\n    /// Every adapter of the system.\n    pub fn adapters(self) -> Vec<Adapter> {\n        let gpa = self.gpa;\n        var out: Vec<Adapter> = Vec::new_in(gpa);\n        // the backend's list is scratch: an arena, freed at once\n        arena_scope(gpa, |a| {\n            var raw: Vec<backend::Adapter, ScopedArena> = Vec::new_in(a);\n            N::adapters(&raw);\n            for r in raw.iter() {\n                out.push(Adapter { raw: backend::Adapter { dev: r.dev.clone() }, gpa: gpa });\n            }\n        });\n        out\n    }\n\n    /// An adapter: the low-power one when asked and there is one.\n    pub fn adapter(self, power: Power = Power::High) -> Result<Adapter, Error> {\n        if power == Power::Low {\n            let found = arena_scope(self.gpa, |a| {\n                var raw: Vec<backend::Adapter, ScopedArena> = Vec::new_in(a);\n                N::adapters(&raw);\n                var f: Option<backend::Adapter> = None;\n                for r in raw.iter() {\n                    if f.is_none() && N::adapter_low_power(r) {\n                        f = Some(backend::Adapter { dev: r.dev.clone() });\n                    }\n                }\n                f\n            });\n            match found {\n                Some(a) => return Ok(Adapter { raw: a, gpa: self.gpa }),\n                None => {}\n            }\n        }\n        match N::default_adapter() {\n            Some(a) => Ok(Adapter { raw: a, gpa: self.gpa }),\n            None => Err(Error::NoAdapter),\n        }\n    }\n\n    /// A surface for a window (or a headless one): its frames are drawn\n    /// into and presented. Needs a device whose caps have `surfaces`.\n");
        buf_str(out, c"    pub fn surface(self, dev: Device, raw: RawSurface) -> Result<Surface, Error>\n        requires dev.caps.surfaces\n        else \"gpu.unsupported: this device has no surfaces (dev.caps().surfaces)\"\n        {\n        match N::create_surface(dev.raw, raw) {\n            Some(s) => Ok(Surface {\n                raw: s, configured: false, width: 0, height: 0, format: Format::Bgra8Unorm\n            }),\n            None => Err(Error::SurfaceLost),\n        }\n    }\n}\n\npub struct Adapter {\n    pub raw: backend::Adapter,\n    pub gpa: Gpa,\n}\n\nimpl Adapter {\n    /// The adapter's name (\"Apple M5\").\n    pub fn name_in<A: Allocator>(self, out: inout Buf<A>) {\n        N::adapter_name(self.raw, &out);\n    }\n\n    /// The device and its queue.\n    pub fn device(self, limits: Limits = Limits::default()) -> Result<(Device, Queue),\n        Error> {\n        match N::open(self.raw) {\n            Some((d, q)) => {\n                let caps = N::caps(d);\n                Ok((Device { raw: d, gpa: self.gpa, limits: limits, caps: caps }, Queue { raw: q }))\n            }\n            None => Err(Error::DeviceCreation),\n        }\n    }\n}\n\npub struct Device {\n    pub raw: backend::Device,\n    pub gpa: Gpa,\n    pub limits: Limits,\n    pub caps: Caps,\n}\n\npub struct Queue {\n    pub raw: backend::Queue,\n}\n\n/// A layout key: the bindings' kinds and slots, so that a bind group made\n/// for one pipeline is accepted by another only when their layouts agree.\nfn layout_key(entries: [Binding]) -> u64 {\n    var h: u64 = 0x9e3779b97f4a7c15;\n    for b in entries {\n        h = std::hash_mix(h, b.binding as u64);\n        h = std::hash_mix(h, b.ty as u64);\n        h = std::hash_mix(h, b.slot_vertex as u64);\n        h = std::hash_mix(h, b.slot_fragment as u64);\n        h = std::hash_mix(h, b.slot_compute as u64);\n    }\n    if h == 0 { 1 } else { h }\n}\n\nimpl Device {\n    pub fn limits(self) -> Limits {\n        self.limits\n    }\n\n");
        buf_str(out, c"    /// What the device can do: compute, render, surfaces, its ShaderKind.\n    pub fn caps(self) -> Caps {\n        self.caps\n    }\n\n    /// n rounded up to the uniform buffer offset alignment.\n    pub fn align_uniform(self, n: i64) -> i64 {\n        let a = self.limits.min_uniform_buffer_offset_alignment;\n        (n + a - 1) / a * a\n    }\n\n    /// A buffer of size bytes, zeroed.\n    pub fn buffer(self, size: i64, usage: u32) -> Buffer\n        requires size >= 0 && size <= self.limits.max_buffer_size\n        else \"gpu.limits: a buffer's size is 0..limits.max_buffer_size\"\n        requires usage != 0 else \"gpu.usage: a buffer needs a usage\"\n    {\n        match N::create_buffer(self.raw, size, \"\") {\n            Some(b) => Buffer { raw: b, size: size, usage: usage, mapped: false },\n            None => out_of_memory(\"buffer\"),\n        }\n    }\n\n    /// A buffer holding a copy of bytes.\n    pub fn buffer_init(self, bytes: [u8], usage: u32) -> Buffer\n        requires bytes.len() <= self.limits.max_buffer_size\n        else \"gpu.limits: a buffer's size is 0..limits.max_buffer_size\"\n        requires usage != 0 else \"gpu.usage: a buffer needs a usage\"\n    {\n        match N::create_buffer(self.raw, bytes.len(), bytes) {\n            Some(b) => Buffer { raw: b, size: bytes.len(), usage: usage, mapped: false },\n            None => out_of_memory(\"buffer\"),\n        }\n    }\n\n    /// A 2D texture (a 2D array when layers > 1).\n    pub fn texture(self, width: i64, height: i64, format: Format,\n        usage: u32 = TextureUsage::TEXTURE_BINDING | TextureUsage::COPY_DST, layers: i64 = 1,\n        mips: i64 = 1) -> Texture\n        requires self.caps.textures\n        else \"gpu.unsupported: this device has no textures (dev.caps().textures)\"\n        requires width >= 1 && height >= 1 && width <= self.limits.max_texture_dimension_2d\n        && height <= self.limits.max_texture_dimension_2d\n");
        buf_str(out, c"        else \"gpu.limits: a texture's sides are 1..limits.max_texture_dimension_2d\"\n        requires layers >= 1 && layers <= self.limits.max_texture_array_layers && mips >= 1\n        else \"gpu.limits: layers and mips\"\n        requires usage != 0 else \"gpu.usage: a texture needs a usage\"\n        requires usage & TextureUsage::STORAGE_BINDING == 0 || format.is_storable()\n        else \"gpu.format: STORAGE_BINDING needs a storable format\"\n        requires usage & TextureUsage::RENDER_ATTACHMENT == 0 || self.caps.render\n        else \"gpu.unsupported: RENDER_ATTACHMENT on a device without render\"\n        {\n        let desc = TextureDesc {\n            width: width, height: height, layers: layers, mips: mips, format: format, usage: usage\n        };\n        match N::create_texture(self.raw, desc) {\n            Some(t) => Texture { raw: t, desc: desc },\n            None => out_of_memory(\"texture\"),\n        }\n    }\n\n    pub fn sampler(self, desc: SamplerDesc) -> Sampler\n        requires self.caps.textures\n        else \"gpu.unsupported: this device has no samplers (dev.caps().textures)\"\n        requires desc.anisotropy >= 1 && desc.anisotropy <= 16\n        else \"gpu.limits: anisotropy is 1..16\"\n        {\n        match N::create_sampler(self.raw, desc) {\n            Some(s) => Sampler { raw: s, comparison: desc.compare.is_some() },\n            None => out_of_memory(\"sampler\"),\n        }\n    }\n\n    /// A shader module from the shader compiler's output for this device\n    /// (`caps().shader_kind`: MSL on Metal). What it keeps of the source\n    /// is copied.\n    pub fn shader(self, src: ShaderSource) -> Result<Shader, Error>\n        requires src.kind == self.caps.shader_kind\n        else \"gpu.format: the shader is not of this device's ShaderKind (dev.caps().shader_kind)\"\n        {\n        var err = Buf::new_in(self.gpa);\n        match N::create_shader(self.raw, src, &err) {\n            Some(s) => {\n");
        buf_str(out, c"                var entries: Vec<ShaderEntry> = Vec::new_in(self.gpa);\n                for e in src.reflection.entries.iter() {\n                    entries.push(ShaderEntry {\n                        name: Buf::from_in(e.name, self.gpa),\n                        native: Buf::from_in(e.native, self.gpa), stage: e.stage,\n                        workgroup: e.workgroup, sizes_slot: e.sizes_slot\n                    });\n                }\n                assert(src.reflection.sizes.len() <= MAX_SIZES,\n                    \"gpu.limits: at most 16 runtime-sized bindings (the sizes buffer)\");\n                var sizes: Vec<GroupBinding> = Vec::new_in(self.gpa);\n                sizes.extend_from_slice(src.reflection.sizes.as_slice());\n                var bindings: Vec<Binding> = Vec::new_in(self.gpa);\n                bindings.extend_from_slice(src.reflection.bindings.as_slice());\n                var inputs: Vec<VertexInput> = Vec::new_in(self.gpa);\n                inputs.extend_from_slice(src.reflection.inputs.as_slice());\n                Ok(Shader {\n                    raw: s, entries: entries, bindings: bindings, inputs: inputs, sizes: sizes\n                })\n            }\n            None => Err(Error::Shader(err)),\n        }\n    }\n\n    /// A shader module from WGSL source: std::gpu::wgsl translates it for\n    /// this device (MSL on Metal), and its reflection (entry points,\n    /// bindings and their slots, vertex inputs, the sizes buffer) feeds\n    /// pipeline creation as dev.shader's does. A rejected shader is\n    /// Error::Shader with the compiler's `LINE:COL: error wgsl.CODE: ...`.\n    pub fn shader_wgsl(self, src: [u8]) -> Result<Shader, Error> {\n        if self.caps.shader_kind != ShaderKind::Msl {\n            return Err(Error::Shader(Buf::from_in(\n                \"std::gpu::wgsl writes no code for this device's ShaderKind yet\", self.gpa)));\n        }\n        var code = Buf::new_in(self.gpa);\n");
        buf_str(out, c"        var refl = wgsl::new_reflection(self.gpa);\n        var err = wgsl::new_error(self.gpa);\n        if !wgsl::translate(src, wgsl::options(wgsl::TARGET_MSL), &code, &refl, &err, self.gpa) {\n            var m = format_in(f\"{err.line}:{err.col}: error {err.code}: {err.msg.as_slice()}\",\n                self.gpa);\n            if err.help.len() > 0 {\n                m.push_str(\" (help: \");\n                m.push_str(err.help.as_slice());\n                m.push_str(\")\");\n            }\n            return Err(Error::Shader(m));\n        }\n        match shader::from_wgsl(refl, self.gpa) {\n            Ok(r) => {\n                // (0.20: a temporary passed to a let parameter is rejected)\n                let s = ShaderSource::msl(code.as_slice(), r);\n                self.shader(s)\n            }\n            Err(m) => Err(Error::Shader(m)),\n        }\n    }\n\n    /// A compute pipeline for the entry point `entry` of the shader; its\n    /// bind layouts come from the shader's reflection.\n    pub fn compute_pipeline(self, shader: Shader, entry: [u8]) -> Result<ComputePipeline,\n        Error>\n        requires self.caps.compute\n        else \"gpu.unsupported: this device has no compute (dev.caps().compute)\"\n        {\n        let e = match shader.entry(entry, ShaderStage::COMPUTE) {\n            Some(e) => e,\n            None => return Err(\n                Error::Pipeline(format_in(f\"no compute entry point '{entry}' in the shader\",\n                    self.gpa))),\n        };\n        let wg = e.workgroup;\n        let l = self.limits;\n        assert(wg[0] >= 1 && wg[1] >= 1 && wg[2] >= 1,\n            \"gpu.limits: a workgroup size is at least 1\");\n        assert(wg[0] <= l.max_compute_workgroup_size_x && wg[1] <= l.max_compute_workgroup_size_y\n            && wg[2] <= l.max_compute_workgroup_size_z, \"gpu.limits: workgroup size\");\n        assert(wg[0] * wg[1] * wg[2] <= l.max_compute_invocations_per_workgroup,\n");
        buf_str(out, c"            \"gpu.limits: invocations per workgroup\");\n        var err = Buf::new_in(self.gpa);\n        match N::create_compute_pipeline(self.raw, shader.raw, e, &err) {\n            Some(p) => {\n                assert(e.sizes_slot < 31, \"gpu.limits: the sizes buffer's slot is below 31\");\n                var out = ComputePipeline {\n                    raw: p, layouts: Layouts::new(), workgroup: wg,\n                    sizes: StageSizes::of(shader, e.sizes_slot)\n                };\n                out.layouts.merge_stage(shader.bindings.as_slice(), ShaderStage::COMPUTE);\n                Ok(out)\n            }\n            None => Err(Error::Pipeline(err)),\n        }\n    }\n\n    /// A render pipeline.\n    pub fn render_pipeline(self, desc: RenderDesc) -> Result<RenderPipeline, Error>\n        requires self.caps.render\n        else \"gpu.unsupported: this device does not render (dev.caps().render)\"\n        requires desc.state.buffer_count <= self.limits.max_vertex_buffers\n        else \"gpu.limits: vertex buffers\"\n        requires desc.state.target_count >= 0\n        && desc.state.target_count <= self.limits.max_color_attachments\n        else \"gpu.limits: color targets\"\n        {\n        let vs = match desc.vertex.entry(desc.vs, ShaderStage::VERTEX) {\n            Some(e) => e,\n            None => return Err(\n                Error::Pipeline(format_in(f\"no vertex entry point '{desc.vs}' in the shader\",\n                    self.gpa))),\n        };\n        var fs = vs;\n        if desc.has_fs {\n            fs = match desc.fragment.entry(desc.fs, ShaderStage::FRAGMENT) {\n                Some(e) => e,\n                None => return Err(\n                    Error::Pipeline(format_in(f\"no fragment entry point '{desc.fs}' in the shader\",\n                        self.gpa))),\n            };\n        }\n        let st = desc.state;\n        for i in 0..st.buffer_count {\n            let l = st.buffers[i];\n");
        buf_str(out, c"            assert(l.stride >= 0 && l.stride % 4 == 0,\n                \"gpu.align: a vertex buffer's stride is a multiple of 4\");\n            for k in 0..l.count {\n                let a = l.attributes[k];\n                assert(a.offset % 4 == 0,\n                    \"gpu.align: a vertex attribute's offset is a multiple of 4\");\n                assert(a.offset + a.format.size() <= l.stride\n                    || (l.stride == 0 && l.step == StepMode::Instance),\n                    \"gpu.range: a vertex attribute reaches past its stride\");\n            }\n        }\n        // every vertex input of the shader is fed by an attribute\n        for inp in desc.vertex.inputs.iter() {\n            var fed = false;\n            for i in 0..st.buffer_count {\n                let l = st.buffers[i];\n                for k in 0..l.count {\n                    if l.attributes[k].location == inp.location {\n                        fed = true;\n                        assert(l.attributes[k].format.shader_type() == inp.format.shader_type(),\n                            \"gpu.format: a vertex attribute's format differs from the shader's input\");\n                    }\n                }\n            }\n            assert(fed,\n                \"gpu.layout: a vertex input of the shader has no attribute (desc.vertex_buffer)\");\n        }\n        for i in 0..st.target_count {\n            assert(!st.targets[i].format.is_depth(),\n                \"gpu.format: a color target of a depth format\");\n        }\n        match st.depth {\n            Some(d) => assert(d.format.is_depth(),\n                \"gpu.format: the depth state needs a depth format\"),\n            None => {}\n        }\n        var err = Buf::new_in(self.gpa);\n        match N::create_render_pipeline(self.raw, desc.vertex.raw, vs, desc.fragment.raw, fs,\n            desc.has_fs, st, &err) {\n            Some(p) => {\n                // (the sizes buffer's slot stays below the vertex buffers: 30 - i)\n");
        buf_str(out, c"                assert(vs.sizes_slot < 31 - st.buffer_count && fs.sizes_slot < 31,\n                    \"gpu.limits: the sizes buffer's slot is below the vertex buffers' (30 - i)\");\n                var out = RenderPipeline {\n                    raw: p, layouts: Layouts::new(), state: st,\n                    vs_sizes: StageSizes::of(desc.vertex, vs.sizes_slot),\n                    fs_sizes: if desc.has_fs { StageSizes::of(desc.fragment, fs.sizes_slot) }\n                        else { StageSizes::none() }\n                };\n                out.layouts.merge_stage(desc.vertex.bindings.as_slice(), ShaderStage::VERTEX);\n                if desc.has_fs {\n                    out.layouts.merge_stage(desc.fragment.bindings.as_slice(),\n                        ShaderStage::FRAGMENT);\n                }\n                Ok(out)\n            }\n            None => Err(Error::Pipeline(err)),\n        }\n    }\n\n    /// A bind group for `layout` (from `pipe.bind_layout(i)`): one entry per\n    /// binding of the layout, in any order.\n    pub fn bind_group(self, layout: BindLayout, entries: [BindEntry]) -> BindGroup\n        requires entries.len() == layout.count\n        else \"gpu.layout: a bind group has one entry for each binding of its layout\"\n        {\n        var g = N::bind_group_new(self.raw);\n        var bytes = GroupBytes::new();\n        for k in 0..layout.count {\n            let b = layout.entries[k];\n            var found = 0;\n            for e in entries {\n                if e.binding != b.binding { continue; }\n                found += 1;\n                match e.res {\n                    Resource::Buffer(buf, offset, size) => {\n                        assert(b.ty.is_buffer(),\n                            \"gpu.layout: a buffer at a binding that is not one\");\n                        let need = if b.ty == BindingType::Uniform { BufferUsage::UNIFORM }\n                            else { BufferUsage::STORAGE };\n");
        buf_str(out, c"                        assert(buf.usage & need != 0, \"gpu.usage: a buffer bound as uniform or storage was created without that usage\");\n                        assert(!buf.mapped, \"gpu.state: the buffer is mapped: unmap it first\");\n                        let align = if b.ty\n                            == BindingType::Uniform {\n                            self.limits.min_uniform_buffer_offset_alignment\n                        } else { self.limits.min_storage_buffer_offset_alignment };\n                        assert(offset % align == 0, \"gpu.align: a binding's offset is a multiple of the device's alignment (dev.align_uniform(n))\");\n                        let n = if size < 0 { buf.size - offset } else { size };\n                        assert(offset >= 0 && n >= b.min_size && offset + n <= buf.size, \"gpu.range: a binding reaches past its buffer, or is smaller than the shader's\");\n                        N::bind_group_buffer(&g, b, buf.raw, offset, n);\n                        assert(bytes.count < MAX_SIZES,\n                            \"gpu.limits: at most 16 buffers in a bind group\");\n                        bytes.binding[bytes.count] = b.binding;\n                        bytes.bytes[bytes.count] = n;\n                        bytes.count += 1;\n                    }\n                    Resource::Texture(v) => {\n                        assert(b.ty.is_texture(),\n                            \"gpu.layout: a texture at a binding that is not one\");\n                        let need = if b.ty\n                            == BindingType::StorageTexture { TextureUsage::STORAGE_BINDING }\n                            else { TextureUsage::TEXTURE_BINDING };\n                        assert(v.usage & need != 0,\n                            \"gpu.usage: a texture bound without TEXTURE_BINDING or STORAGE_BINDING\");\n                        N::bind_group_texture(&g, b, v.raw);\n                    }\n                    Resource::Sampler(s) => {\n");
        buf_str(out, c"                        assert(b.ty.is_sampler(),\n                            \"gpu.layout: a sampler at a binding that is not one\");\n                        assert(s.comparison == (b.ty == BindingType::ComparisonSampler), \"gpu.layout: a comparison sampler where a plain one is bound, or the reverse\");\n                        N::bind_group_sampler(&g, b, s.raw);\n                    }\n                }\n            }\n            assert(found == 1, \"gpu.layout: each binding of the layout is given once\");\n        }\n        BindGroup { raw: g, key: layout.key, bytes: bytes }\n    }\n\n    /// A command encoder.\n    pub fn encoder(self) -> Encoder {\n        Encoder { raw: N::begin(self.raw), limits: self.limits, caps: self.caps }\n    }\n\n    /// Waits until the GPU has finished everything submitted.\n    pub fn wait_idle(self) {\n        N::device_wait_idle(self.raw);\n    }\n}\n\nimpl Queue {\n    /// Submits recorded commands; they run after everything submitted\n    /// before.\n    pub fn submit(inout self, cmds: sink Commands) {\n        var c = cmds;\n        N::submit(&self.raw, &c.raw);\n    }\n\n    /// Writes bytes into buf at offset, before the commands submitted next\n    /// run (and after the ones submitted before).\n    pub fn write_buffer(inout self, buf: Buffer, offset: i64, bytes: [u8])\n        requires buf.usage & BufferUsage::COPY_DST != 0\n        else \"gpu.usage: write_buffer needs COPY_DST\"\n        requires offset % 4 == 0 && bytes.len() % 4 == 0\n        else \"gpu.align: write_buffer's offset and size are multiples of 4\"\n        requires offset >= 0 && offset + bytes.len() <= buf.size\n        else \"gpu.range: write_buffer reaches past the buffer\"\n        requires !buf.mapped else \"gpu.state: the buffer is mapped: unmap it first\"\n    {\n        N::write_buffer(&self.raw, buf.raw, offset, bytes);\n    }\n\n    /// Writes rows of texels into layer `layer` of tex at (x, y): h rows of\n");
        buf_str(out, c"    /// bytes_per_row bytes each, w texels used of each row.\n    pub fn write_texture(inout self, tex: Texture, bytes: [u8], bytes_per_row: i64,\n        x: i64 = 0, y: i64 = 0, w: i64 = -1, h: i64 = -1, layer: i64 = 0)\n        requires tex.desc.usage & TextureUsage::COPY_DST != 0\n        else \"gpu.usage: write_texture needs COPY_DST\"\n        requires layer >= 0 && layer < tex.desc.layers else \"gpu.range: no such layer\"\n    {\n        let ww = if w < 0 { tex.desc.width - x } else { w };\n        let hh = if h < 0 { tex.desc.height - y } else { h };\n        assert(x >= 0 && y >= 0 && ww >= 1 && hh >= 1 && x + ww <= tex.desc.width\n            && y + hh <= tex.desc.height, \"gpu.range: the region is outside the texture\");\n        assert(bytes_per_row >= ww * tex.desc.format.size(),\n            \"gpu.range: bytes_per_row is shorter than a row\");\n        assert(bytes.len() >= bytes_per_row * (hh - 1) + ww * tex.desc.format.size(),\n            \"gpu.range: fewer bytes than the region\");\n        N::write_texture(&self.raw, tex.raw, layer, x, y, ww, hh, bytes, bytes_per_row);\n    }\n\n    /// Waits until everything submitted has finished.\n    pub fn wait_idle(inout self) -> Result<(), Error> {\n        if N::queue_wait_idle(&self.raw) { Ok(()) } else { Err(Error::Submission) }\n    }\n}\n\n// ---- GPU: buffers, textures, samplers, shaders (0.22) ----\n\npub struct Buffer {\n    pub raw: backend::Buffer,\n    pub size: i64,\n    pub usage: u32,\n    pub mapped: bool,\n}\n\nimpl Buffer {\n    pub fn size(self) -> i64 {\n        self.size\n    }\n\n    pub fn usage(self) -> u32 {\n        self.usage\n    }\n\n    /// The buffer's bytes once the GPU has finished every submitted\n    /// command (it waits): a view of the buffer, which cannot be used\n    /// while the view is.\n    pub fn map_read(inout self, dev: Device) -> [u8]\n        requires self.usage & BufferUsage::MAP_READ != 0 else \"gpu.usage: map_read needs MAP_READ\"\n    {\n");
        buf_str(out, c"        N::device_wait_idle(dev.raw);\n        N::map_read(dev.raw, &self.raw)\n    }\n\n    /// The buffer's bytes to write, once the GPU has finished with it; the\n    /// writes reach the GPU at `unmap`, which must come before the buffer\n    /// is used again.\n    pub fn map_write(inout self, dev: Device) -> inout [u8]\n        requires self.usage & BufferUsage::MAP_WRITE != 0\n        else \"gpu.usage: map_write needs MAP_WRITE\"\n        {\n        N::device_wait_idle(dev.raw);\n        self.mapped = true;\n        N::map_write(dev.raw, &self.raw)\n    }\n\n    /// Ends a map_write: what was written reaches the GPU.\n    pub fn unmap(inout self, dev: Device) {\n        N::unmap(dev.raw, &self.raw);\n        self.mapped = false;\n    }\n}\n\npub struct Texture {\n    pub raw: backend::Texture,\n    pub desc: TextureDesc,\n}\n\nimpl Texture {\n    pub fn width(self) -> i64 {\n        self.desc.width\n    }\n\n    pub fn height(self) -> i64 {\n        self.desc.height\n    }\n\n    pub fn format(self) -> Format {\n        self.desc.format\n    }\n\n    pub fn usage(self) -> u32 {\n        self.desc.usage\n    }\n\n    /// A view of the whole texture (it keeps the texture alive).\n    pub fn view(self) -> TextureView {\n        self.view_as(self.desc.format)\n    }\n\n    /// A view reading the texels as another format of the same size\n    /// (Rgba8Unorm as Rgba8UnormSrgb).\n    pub fn view_as(self, format: Format) -> TextureView\n        requires format.size() == self.desc.format.size()\n        && format.is_depth() == self.desc.format.is_depth()\n        else \"gpu.format: a view's format has its texture's texel size\"\n        {\n        match N::create_view(self.raw, format, format == self.desc.format) {\n            Some(v) => TextureView {\n                raw: v, format: format, width: self.desc.width, height: self.desc.height,\n                usage: self.desc.usage\n            },\n            None => out_of_memory(\"texture view\"),\n        }\n    }\n");
        buf_str(out, c"}\n\npub struct TextureView {\n    pub raw: backend::TextureView,\n    pub format: Format,\n    pub width: i64,\n    pub height: i64,\n    pub usage: u32,\n}\n\npub struct Sampler {\n    pub raw: backend::Sampler,\n    pub comparison: bool,\n}\n\n/// An entry point of a Shader, its names copied.\npub struct ShaderEntry {\n    pub name: Buf,\n    pub native: Buf,\n    pub stage: u32,\n    pub workgroup: [i64; 3],\n    pub sizes_slot: i64,\n}\n\npub struct Shader {\n    pub raw: backend::Shader,\n    pub entries: Vec<ShaderEntry>,\n    pub bindings: Vec<Binding>,\n    pub inputs: Vec<VertexInput>,\n    pub sizes: Vec<GroupBinding>,\n}\n\nimpl Shader {\n    /// The entry point of that name and stage (its names view the\n    /// shader's copies).\n    pub fn entry(self, name: [u8], stage: u32) -> Option<EntryPoint> {\n        for i in 0..self.entries.len() {\n            if self.entries[i].name.as_slice() == name && self.entries[i].stage == stage {\n                return Some(EntryPoint {\n                    name: self.entries[i].name.as_slice(),\n                    native: self.entries[i].native.as_slice(), stage: self.entries[i].stage,\n                    workgroup: self.entries[i].workgroup, sizes_slot: self.entries[i].sizes_slot\n                });\n            }\n        }\n        None\n    }\n}\n\n// ---- GPU: bind layouts and groups (0.22) ----\n\n/// The bindings of one group as a pipeline sees them: plain data, kept in\n/// the pipeline (no allocation).\npub struct BindLayout {\n    pub group: i64,\n    pub entries: [Binding; 16],\n    pub count: i64,\n    pub key: u64,\n}\n\n/// A pipeline's layouts, groups 0..MAX_BIND_GROUPS.\npub struct Layouts {\n    pub groups: [BindLayout; 4],\n    pub used: i64,\n}\n\nimpl Layouts {\n    fn new() -> Layouts {\n        let none = Binding {\n            group: 0, binding: 0, ty: BindingType::Uniform, slot_vertex: -1, slot_fragment: -1,\n            slot_compute: -1, min_size: 0\n        };\n");
        buf_str(out, c"        let l = BindLayout { group: 0, entries: [none; 16], count: 0, key: 0 };\n        var out = Layouts { groups: [l; 4], used: 0 };\n        for i in 0..MAX_BIND_GROUPS {\n            out.groups[i].group = i;\n        }\n        out\n    }\n\n    /// Adds the bindings a stage uses; a binding seen from two stages is\n    /// one entry with both slots.\n    fn merge_stage(inout self, bindings: [Binding], stage: u32) {\n        for b in bindings {\n            if b.visibility() & stage == 0 { continue; }\n            assert(b.group >= 0 && b.group < MAX_BIND_GROUPS, \"gpu.limits: bind groups 0..3\");\n            let gi = b.group;\n            var merged = false;\n            for k in 0..self.groups[gi].count {\n                var e = self.groups[gi].entries[k];\n                if e.binding == b.binding {\n                    assert(e.ty == b.ty,\n                        \"gpu.layout: two stages see one binding as different kinds\");\n                    if stage == ShaderStage::VERTEX { e.slot_vertex = b.slot_vertex; }\n                    if stage == ShaderStage::FRAGMENT { e.slot_fragment = b.slot_fragment; }\n                    if stage == ShaderStage::COMPUTE { e.slot_compute = b.slot_compute; }\n                    self.groups[gi].entries[k] = e;\n                    merged = true;\n                }\n            }\n            if !merged {\n                let n = self.groups[gi].count;\n                assert(n < 16, \"gpu.limits: 16 bindings a group\");\n                var e = b;\n                if stage != ShaderStage::VERTEX { e.slot_vertex = -1; }\n                if stage != ShaderStage::FRAGMENT { e.slot_fragment = -1; }\n                if stage != ShaderStage::COMPUTE { e.slot_compute = -1; }\n                self.groups[gi].entries[n] = e;\n                self.groups[gi].count = n + 1;\n            }\n            if gi + 1 > self.used { self.used = gi + 1; }\n        }\n        for i in 0..MAX_BIND_GROUPS {\n");
        buf_str(out, c"            let n = self.groups[i].count;\n            self.groups[i].key = if n == 0 { 0 } else { layout_key(self.groups[i].entries[0..n]) };\n        }\n    }\n}\n\n/// A resource bound at a binding: a buffer range (size -1: to the end), a\n/// texture view or a sampler.\npub enum Resource {\n    Buffer(let Buffer, i64, i64),\n    Texture(let TextureView),\n    Sampler(let Sampler),\n}\n\npub struct BindEntry {\n    pub binding: i64,\n    pub res: Resource,\n}\n\n/// The whole of a buffer at `binding`.\npub fn bind(binding: i64, buf: Buffer) -> BindEntry {\n    BindEntry { binding: binding, res: Resource::Buffer(buf, 0, -1) }\n}\n\n/// size bytes of a buffer from offset at `binding`.\npub fn bind_range(binding: i64, buf: Buffer, offset: i64, size: i64) -> BindEntry {\n    BindEntry { binding: binding, res: Resource::Buffer(buf, offset, size) }\n}\n\npub fn bind_texture(binding: i64, view: TextureView) -> BindEntry {\n    BindEntry { binding: binding, res: Resource::Texture(view) }\n}\n\npub fn bind_sampler(binding: i64, s: Sampler) -> BindEntry {\n    BindEntry { binding: binding, res: Resource::Sampler(s) }\n}\n\n/// Resources bound together (the group keeps them alive).\npub struct BindGroup {\n    pub raw: backend::BindGroup,\n    pub key: u64,\n    bytes: GroupBytes,\n}\n\n// ---- GPU: the sizes buffer (0.22) ----\n\n// The most runtime-sized bindings a stage reads (the sizes buffer's\n// words), and the most buffers a bind group records the bytes of.\nconst MAX_SIZES: i64 = 16;\n\n/// A bind group's buffers: each one's binding and the bytes it exposes\n/// (its size minus the offset, or the binding's size).\n#[derive(Clone)]\nstruct GroupBytes {\n    count: i64,\n    binding: [i64; 16],\n    bytes: [i64; 16],\n}\n\nimpl GroupBytes {\n    fn new() -> GroupBytes { GroupBytes { count: 0, binding: [0; 16], bytes: [0; 16] } }\n}\n\n/// What one stage of a pipeline reads in its sizes buffer: the slot (-1:\n");
        buf_str(out, c"/// none) and the (group, binding) of each word (shader::Reflection's sizes).\n#[derive(Clone)]\nstruct StageSizes {\n    slot: i64,\n    count: i64,\n    at: [[i64; 2]; 16],\n}\n\nimpl StageSizes {\n    fn none() -> StageSizes { StageSizes { slot: -1, count: 0, at: [[0, 0]; 16] } }\n\n    fn of(shader: Shader, slot: i64) -> StageSizes {\n        var out = StageSizes::none();\n        if slot < 0 { return out; }\n        out.slot = slot;\n        out.count = shader.sizes.len();\n        for i in 0..out.count {\n            out.at[i] = shader.sizes[i];\n        }\n        out\n    }\n\n    /// The words (wgsl::sizes_words's rule): the bytes bound at each\n    /// (group, binding), 0 when nothing is bound there, at most u32's\n    /// largest; how many.\n    fn words(self, groups: [GroupBytes; 4], out: inout [u32; 16]) -> i64 {\n        for i in 0..self.count {\n            let g = self.at[i][0];\n            let b = self.at[i][1];\n            var n = 0;\n            if g >= 0 && g < MAX_BIND_GROUPS {\n                for k in 0..groups[g].count {\n                    if groups[g].binding[k] == b { n = groups[g].bytes[k]; }\n                }\n            }\n            out[i] = if n < 0 { 0 } else if n > 4294967295 { 4294967295u32 } else { n as u32 };\n        }\n        self.count\n    }\n}\n\n// ---- GPU: pipelines (0.22) ----\n\npub struct ComputePipeline {\n    pub raw: backend::ComputePipeline,\n    pub layouts: Layouts,\n    pub workgroup: [i64; 3],\n    sizes: StageSizes,\n}\n\nimpl ComputePipeline {\n    /// The layout of group i, for `dev.bind_group`.\n    pub fn bind_layout(self, i: i64) -> BindLayout\n        requires i >= 0 && i < MAX_BIND_GROUPS else \"gpu.limits: bind groups 0..3\"\n    {\n        self.layouts.groups[i]\n    }\n}\n\npub struct RenderPipeline {\n    pub raw: backend::RenderPipeline,\n    pub layouts: Layouts,\n    pub state: PipelineState,\n    vs_sizes: StageSizes,\n    fs_sizes: StageSizes,\n}\n\nimpl RenderPipeline {\n");
        buf_str(out, c"    pub fn bind_layout(self, i: i64) -> BindLayout\n        requires i >= 0 && i < MAX_BIND_GROUPS else \"gpu.limits: bind groups 0..3\"\n    {\n        self.layouts.groups[i]\n    }\n}\n\n/// A render pipeline's description: shaders and entry points, then the\n/// fixed-function state (PipelineState) with its builder methods.\npub struct RenderDesc {\n    pub vertex: let Shader,\n    pub vs: [u8],\n    pub fragment: let Shader,\n    pub fs: [u8],\n    pub has_fs: bool,\n    pub state: PipelineState,\n}\n\nimpl RenderDesc {\n    /// Vertex entry `vs` and fragment entry `fs` of one shader, drawing\n    /// into one target of `format`.\n    pub fn new(shader: Shader, vs: [u8], fs: [u8], format: Format) -> RenderDesc {\n        RenderDesc {\n            vertex: shader, vs: vs, fragment: shader, fs: fs, has_fs: true,\n            state: PipelineState::new(format)\n        }\n    }\n\n    /// No fragment stage (depth only).\n    pub fn no_fragment(inout self) {\n        self.has_fs = false;\n        self.state.target_count = 0;\n    }\n\n    /// A vertex buffer's layout, at the next slot.\n    pub fn vertex_buffer(inout self, layout: VertexLayout)\n        requires self.state.buffer_count < MAX_VERTEX_BUFFERS\n        else \"gpu.limits: at most 8 vertex buffers\"\n        {\n        self.state.buffers[self.state.buffer_count] = layout;\n        self.state.buffer_count += 1;\n    }\n\n    /// Blending for target i (0: the first).\n    pub fn blend(inout self, blend: Blend, target: i64 = 0)\n        requires target >= 0 && target < self.state.target_count\n        else \"gpu.range: no such color target\"\n        {\n        self.state.targets[target].blend = Some(blend);\n    }\n\n    /// Another color target.\n    pub fn target(inout self, format: Format)\n        requires self.state.target_count < MAX_COLOR_TARGETS\n        else \"gpu.limits: at most 8 color targets\"\n        {\n        self.state.targets[self.state.target_count] = ColorTarget {\n");
        buf_str(out, c"            format: format, blend: None, write_mask: 15\n        };\n        self.state.target_count += 1;\n    }\n\n    pub fn depth(inout self, format: Format = Format::Depth32Float,\n        compare: Compare = Compare::Less, write: bool = true) {\n        self.state.depth = Some(DepthState { format: format, write: write, compare: compare });\n    }\n\n    pub fn topology(inout self, t: Topology) {\n        self.state.topology = t;\n    }\n\n    pub fn cull(inout self, c: Cull, front: FrontFace = FrontFace::Ccw) {\n        self.state.cull = c;\n        self.state.front_face = front;\n    }\n}\n\n// ---- GPU: encoders and passes (0.22) ----\n\npub struct Encoder {\n    pub raw: backend::CommandBuffer,\n    pub limits: Limits,\n    pub caps: Caps,\n}\n\n/// Recorded commands, for `queue.submit` (dropped unsubmitted: discarded).\npub struct Commands {\n    pub raw: backend::CommandBuffer,\n}\n\n/// The bind group keys a pass has bound, against a pipeline's layouts.\nstruct Bindings {\n    bound: [u64; 4],\n    want: [u64; 4],\n    used: i64,\n    has_pipeline: bool,\n}\n\nimpl Bindings {\n    fn new() -> Bindings {\n        Bindings { bound: [0, 0, 0, 0], want: [0, 0, 0, 0], used: 0, has_pipeline: false }\n    }\n\n    fn set_pipeline(inout self, l: Layouts) {\n        self.has_pipeline = true;\n        self.used = l.used;\n        for i in 0..MAX_BIND_GROUPS {\n            self.want[i] = l.groups[i].key;\n        }\n    }\n\n    fn set_group(inout self, i: i64, key: u64)\n        requires i >= 0 && i < MAX_BIND_GROUPS else \"gpu.limits: bind groups 0..3\"\n    {\n        assert(!self.has_pipeline || self.want[i] == 0 || self.want[i] == key, \"gpu.layout: the bind group was made for another layout (make it from pipe.bind_layout(i))\");\n        self.bound[i] = key;\n    }\n\n    /// Before a draw or dispatch: a pipeline, and a matching group for each\n    /// group it uses.\n    fn ready(self) {\n");
        buf_str(out, c"        assert(self.has_pipeline, \"gpu.pipeline: set a pipeline before drawing or dispatching\");\n        for i in 0..self.used {\n            assert(self.want[i] == 0 || self.bound[i] == self.want[i],\n                \"gpu.pipeline: a bind group the pipeline uses is not set (pass.set_bind_group)\");\n        }\n    }\n}\n\npub struct ComputePass {\n    raw: backend::ComputeEncoder,\n    binds: Bindings,\n    max_groups: i64,\n    // the sizes buffer: the pipeline's, and the bound groups' bytes\n    sizes: StageSizes,\n    groups: [GroupBytes; 4],\n}\n\nimpl ComputePass {\n    pub fn set_pipeline(inout self, p: ComputePipeline) {\n        self.binds.set_pipeline(p.layouts);\n        self.sizes = p.sizes;\n        N::compute_set_pipeline(&self.raw, p.raw);\n    }\n\n    pub fn set_bind_group(inout self, i: i64, g: BindGroup) {\n        self.binds.set_group(i, g.key);\n        self.groups[i] = g.bytes;\n        N::compute_set_bind_group(&self.raw, g.raw);\n    }\n\n    /// x * y * z workgroups of the pipeline's workgroup size.\n    pub fn dispatch(inout self, x: i64, y: i64 = 1, z: i64 = 1)\n        requires x >= 0 && y >= 0 && z >= 0 && x <= self.max_groups && y <= self.max_groups\n        && z <= self.max_groups else \"gpu.limits: workgroups per dimension\"\n        {\n        self.binds.ready();\n        if x == 0 || y == 0 || z == 0 { return; }\n        if self.sizes.slot >= 0 {\n            var words: [u32; 16] = [0; 16];\n            let n = self.sizes.words(self.groups, &words);\n            N::compute_set_bytes(&self.raw, bytes_of_u32(words[0..n]), self.sizes.slot);\n        }\n        N::dispatch(&self.raw, x, y, z);\n    }\n}\n\n/// A color attachment of a render pass.\npub struct ColorAttachment {\n    pub view: let TextureView,\n    pub load: Load,\n    pub clear: Color,\n    pub store: bool,\n}\n\npub struct DepthAttachment {\n    pub view: let TextureView,\n    pub load: Load,\n    pub clear: f64,\n    pub store: bool,\n}\n\n");
        buf_str(out, c"/// A render pass's attachments: one color target, maybe a depth one\n/// (several color targets: 0.22.x).\npub struct PassDesc {\n    pub color: ColorAttachment,\n    pub depth: Option<DepthAttachment>,\n}\n\nimpl PassDesc {\n    /// One color attachment, cleared to `clear` (or kept: load =\n    /// Load::Keep) and stored.\n    pub fn color(view: TextureView, clear: Color = Color::black(), load: Load = Load::Clear) -> PassDesc {\n        PassDesc {\n            color: ColorAttachment { view: view, load: load, clear: clear, store: true },\n            depth: None\n        }\n    }\n\n    pub fn with_depth(self, view: TextureView, clear: f64 = 1.0, store: bool = false) -> PassDesc {\n        var d = self;\n        d.depth = Some(DepthAttachment {\n            view: view, load: Load::Clear, clear: clear, store: store\n        });\n        d\n    }\n}\n\npub struct RenderPass {\n    raw: backend::RenderEncoder,\n    binds: Bindings,\n    format: Format,\n    depth: Option<Format>,\n    width: i64,\n    height: i64,\n    // per vertex buffer slot: the bytes after its offset (-1: none)\n    vertex_bytes: [i64; 8],\n    index_bytes: i64,\n    index_size: i64,\n    strides: [i64; 8],\n    steps: [StepMode; 8],\n    buffer_count: i64,\n    // the sizes buffers: the pipeline's per stage, the bound groups' bytes\n    vs_sizes: StageSizes,\n    fs_sizes: StageSizes,\n    groups: [GroupBytes; 4],\n}\n\nimpl RenderPass {\n    pub fn set_pipeline(inout self, p: RenderPipeline) {\n        let st = p.state;\n        assert(st.target_count == 1 && st.targets[0].format == self.format,\n            \"gpu.format: the pipeline's color target format differs from the pass's\");\n        match st.depth {\n            Some(d) => assert(self.depth == Some(d.format),\n                \"gpu.format: the pipeline's depth format differs from the pass's\"),\n            None => {}\n        }\n        self.binds.set_pipeline(p.layouts);\n        self.vs_sizes = p.vs_sizes;\n");
        buf_str(out, c"        self.fs_sizes = p.fs_sizes;\n        self.buffer_count = st.buffer_count;\n        for i in 0..st.buffer_count {\n            self.strides[i] = st.buffers[i].stride;\n            self.steps[i] = st.buffers[i].step;\n        }\n        N::render_set_pipeline(&self.raw, p.raw);\n    }\n\n    pub fn set_bind_group(inout self, i: i64, g: BindGroup) {\n        self.binds.set_group(i, g.key);\n        self.groups[i] = g.bytes;\n        N::render_set_bind_group(&self.raw, g.raw);\n    }\n\n    // Before a draw: each stage's sizes buffer, when it reads one.\n    fn set_sizes(inout self) {\n        var words: [u32; 16] = [0; 16];\n        if self.vs_sizes.slot >= 0 {\n            let n = self.vs_sizes.words(self.groups, &words);\n            N::render_set_bytes(&self.raw, ShaderStage::VERTEX, bytes_of_u32(words[0..n]),\n                self.vs_sizes.slot);\n        }\n        if self.fs_sizes.slot >= 0 {\n            let n = self.fs_sizes.words(self.groups, &words);\n            N::render_set_bytes(&self.raw, ShaderStage::FRAGMENT, bytes_of_u32(words[0..n]),\n                self.fs_sizes.slot);\n        }\n    }\n\n    pub fn set_vertex_buffer(inout self, slot: i64, buf: Buffer, offset: i64 = 0)\n        requires slot >= 0 && slot < MAX_VERTEX_BUFFERS else \"gpu.limits: vertex buffer slots 0..7\"\n        requires buf.usage & BufferUsage::VERTEX != 0\n        else \"gpu.usage: set_vertex_buffer needs VERTEX\"\n        requires offset % 4 == 0 else \"gpu.align: a vertex buffer's offset is a multiple of 4\"\n        requires offset >= 0 && offset <= buf.size else \"gpu.range: the offset is past the buffer\"\n        requires !buf.mapped else \"gpu.state: the buffer is mapped: unmap it first\"\n    {\n        self.vertex_bytes[slot] = buf.size - offset;\n        N::render_set_vertex_buffer(&self.raw, slot, buf.raw, offset);\n    }\n\n    pub fn set_index_buffer(inout self, buf: Buffer, format: IndexFormat,\n        offset: i64 = 0)\n");
        buf_str(out, c"        requires buf.usage & BufferUsage::INDEX != 0 else \"gpu.usage: set_index_buffer needs INDEX\"\n        requires offset % format.size() == 0\n        else \"gpu.align: an index buffer's offset is a multiple of the index size\"\n        requires offset >= 0 && offset <= buf.size else \"gpu.range: the offset is past the buffer\"\n    {\n        self.index_bytes = buf.size - offset;\n        self.index_size = format.size();\n        N::render_set_index_buffer(&self.raw, buf.raw, format, offset);\n    }\n\n    pub fn set_viewport(inout self, x: f32, y: f32, w: f32, h: f32, min_depth: f32 = 0.0,\n        max_depth: f32 = 1.0)\n        requires w > 0.0 && h > 0.0 && min_depth >= 0.0 && max_depth <= 1.0\n        && min_depth <= max_depth else \"gpu.range: the viewport\"\n        {\n        N::render_set_viewport(&self.raw, x, y, w, h, min_depth, max_depth);\n    }\n\n    pub fn set_scissor(inout self, x: i64, y: i64, w: i64, h: i64)\n        requires x >= 0 && y >= 0 && w >= 0 && h >= 0 && x + w <= self.width && y + h <= self.height\n        else \"gpu.range: the scissor rectangle is outside the target\"\n        {\n        N::render_set_scissor(&self.raw, x, y, w, h);\n    }\n\n    pub fn set_blend_constant(inout self, c: Color) {\n        N::render_set_blend_constant(&self.raw, c);\n    }\n\n    // The vertex buffers cover `vertices` and `instances` (wgpu's check).\n    fn check_buffers(self, vertices_end: i64, instances_end: i64) {\n        for i in 0..self.buffer_count {\n            let n = if self.steps[i] == StepMode::Instance { instances_end } else { vertices_end };\n            if self.strides[i] == 0 || n == 0 { continue; }\n            assert(self.vertex_bytes[i] >= 0,\n                \"gpu.pipeline: a vertex buffer the pipeline reads is not set\");\n            assert(n * self.strides[i] <= self.vertex_bytes[i],\n                \"gpu.range: the draw reads past a vertex buffer\");\n        }\n    }\n\n");
        buf_str(out, c"    /// Draws vertices `vertices` of instances `instances` (`0..3, 0..1`).\n    pub fn draw(inout self, vertices: Range<i64>, instances: Range<i64>)\n        requires vertices.start >= 0 && vertices.start <= vertices.end && instances.start >= 0\n        && instances.start <= instances.end else \"gpu.range: a draw's ranges\"\n        {\n        self.binds.ready();\n        self.check_buffers(vertices.end, instances.end);\n        if vertices.end == vertices.start || instances.end == instances.start { return; }\n        self.set_sizes();\n        N::draw(&self.raw, vertices.start, vertices.end - vertices.start, instances.start,\n            instances.end - instances.start);\n    }\n\n    /// Draws indices `indices` of the index buffer, each plus base_vertex.\n    pub fn draw_indexed(inout self, indices: Range<i64>, base_vertex: i64,\n        instances: Range<i64>)\n        requires indices.start >= 0 && indices.start <= indices.end && instances.start >= 0\n        && instances.start <= instances.end else \"gpu.range: a draw's ranges\"\n        {\n        self.binds.ready();\n        assert(self.index_size > 0,\n            \"gpu.pipeline: draw_indexed without an index buffer (pass.set_index_buffer)\");\n        assert(indices.end * self.index_size <= self.index_bytes,\n            \"gpu.range: the draw reads past the index buffer\");\n        // the vertices the indices reach are not known on the CPU: the\n        // shaders' accesses are checked instead (design §2.6)\n        self.check_buffers(0, instances.end);\n        if indices.end == indices.start || instances.end == instances.start { return; }\n        self.set_sizes();\n        N::draw_indexed(&self.raw, indices.start, indices.end - indices.start, base_vertex,\n            instances.start, instances.end - instances.start);\n    }\n}\n\nimpl Encoder {\n    /// Runs f with a compute pass; the pass ends when f returns.\n    pub fn compute_pass<F: FnMut(inout ComputePass)>(inout self, f: sink F)\n");
        buf_str(out, c"        requires self.caps.compute\n        else \"gpu.unsupported: this device has no compute (dev.caps().compute)\"\n        {\n        var pass = ComputePass {\n            raw: N::begin_compute(&self.raw), binds: Bindings::new(),\n            max_groups: self.limits.max_compute_workgroups_per_dimension,\n            sizes: StageSizes::none(), groups: [GroupBytes::new(); 4]\n        };\n        f(&pass);\n        N::end_compute(&pass.raw);\n    }\n\n    /// Runs f with a render pass into desc's attachments; the pass ends\n    /// when f returns.\n    pub fn render_pass<F: FnMut(inout RenderPass)>(inout self, desc: PassDesc, f: sink F)\n        requires self.caps.render\n        else \"gpu.unsupported: this device does not render (dev.caps().render)\"\n        requires desc.color.view.usage & TextureUsage::RENDER_ATTACHMENT != 0\n        else \"gpu.usage: a render target needs RENDER_ATTACHMENT\"\n        requires desc.color.view.format.is_renderable() && !desc.color.view.format.is_depth()\n        else \"gpu.format: the color target's format\"\n        {\n        let c = desc.color;\n        var p = N::pass_new();\n        N::pass_color(&p, 0, c.view.raw, c.load, c.clear, c.store);\n        var depth: Option<Format> = None;\n        match desc.depth {\n            Some(d) => {\n                assert(d.view.usage & TextureUsage::RENDER_ATTACHMENT != 0,\n                    \"gpu.usage: a depth target needs RENDER_ATTACHMENT\");\n                assert(d.view.format.is_depth(), \"gpu.format: the depth target's format\");\n                assert(d.view.width == c.view.width && d.view.height == c.view.height,\n                    \"gpu.range: the depth target's size differs from the color target's\");\n                N::pass_depth(&p, d.view.raw, d.load, d.clear, d.store);\n                depth = Some(d.view.format);\n            }\n            None => {}\n        }\n        var pass = RenderPass {\n            raw: N::begin_render(&self.raw, p),\n");
        buf_str(out, c"            binds: Bindings::new(),\n            format: c.view.format,\n            depth: depth,\n            width: c.view.width,\n            height: c.view.height,\n            vertex_bytes: [-1; 8],\n            index_bytes: 0,\n            index_size: 0,\n            strides: [0; 8],\n            steps: [StepMode::Vertex; 8],\n            buffer_count: 0,\n            vs_sizes: StageSizes::none(),\n            fs_sizes: StageSizes::none(),\n            groups: [GroupBytes::new(); 4],\n        };\n        f(&pass);\n        N::end_render(&pass.raw);\n    }\n\n    /// Copies size bytes between buffers.\n    pub fn copy_buffer(inout self, src: Buffer, src_offset: i64, dst: Buffer,\n        dst_offset: i64, size: i64)\n        requires src.usage & BufferUsage::COPY_SRC != 0 && dst.usage & BufferUsage::COPY_DST != 0\n        else \"gpu.usage: copy_buffer needs COPY_SRC and COPY_DST\"\n        requires src_offset % 4 == 0 && dst_offset % 4 == 0 && size % 4 == 0\n        else \"gpu.align: copy offsets and sizes are multiples of 4\"\n        requires src_offset >= 0 && dst_offset >= 0 && size >= 0 && src_offset + size <= src.size\n        && dst_offset + size <= dst.size else \"gpu.range: the copy reaches past a buffer\"\n        requires !src.mapped && !dst.mapped else \"gpu.state: the buffer is mapped: unmap it first\"\n    {\n        if size == 0 { return; }\n        N::copy_buffer(&self.raw, src.raw, src_offset, dst.raw, dst_offset, size);\n    }\n\n    /// Copies a region of layer `layer` of tex (the whole of it by default)\n    /// into buf at offset, rows bytes_per_row apart (a multiple of 256).\n    pub fn copy_texture_to_buffer(inout self, tex: Texture, buf: Buffer,\n        bytes_per_row: i64, offset: i64 = 0, x: i64 = 0, y: i64 = 0, w: i64 = -1, h: i64 = -1,\n        layer: i64 = 0)\n        requires tex.desc.usage & TextureUsage::COPY_SRC != 0\n        && buf.usage & BufferUsage::COPY_DST != 0\n");
        buf_str(out, c"        else \"gpu.usage: the copy needs COPY_SRC on the texture and COPY_DST on the buffer\"\n        requires bytes_per_row % 256 == 0 && offset % tex.desc.format.size() == 0\n        else \"gpu.align: bytes_per_row is a multiple of 256\"\n        requires layer >= 0 && layer < tex.desc.layers else \"gpu.range: no such layer\"\n        requires !buf.mapped else \"gpu.state: the buffer is mapped: unmap it first\"\n    {\n        let ww = if w < 0 { tex.desc.width - x } else { w };\n        let hh = if h < 0 { tex.desc.height - y } else { h };\n        assert(x >= 0 && y >= 0 && ww >= 1 && hh >= 1 && x + ww <= tex.desc.width\n            && y + hh <= tex.desc.height, \"gpu.range: the region is outside the texture\");\n        assert(bytes_per_row >= ww * tex.desc.format.size(),\n            \"gpu.range: bytes_per_row is shorter than a row\");\n        assert(offset >= 0\n            && offset + bytes_per_row * (hh - 1) + ww * tex.desc.format.size() <= buf.size,\n            \"gpu.range: the copy reaches past the buffer\");\n        N::copy_texture_to_buffer(&self.raw, tex.raw, layer, x, y, ww, hh, buf.raw, offset,\n            bytes_per_row);\n    }\n\n    /// Copies rows of buf (bytes_per_row apart, a multiple of 256) into a\n    /// region of layer `layer` of tex.\n    pub fn copy_buffer_to_texture(inout self, buf: Buffer, tex: Texture,\n        bytes_per_row: i64, offset: i64 = 0, x: i64 = 0, y: i64 = 0, w: i64 = -1, h: i64 = -1,\n        layer: i64 = 0)\n        requires tex.desc.usage & TextureUsage::COPY_DST != 0\n        && buf.usage & BufferUsage::COPY_SRC != 0\n        else \"gpu.usage: the copy needs COPY_SRC on the buffer and COPY_DST on the texture\"\n        requires bytes_per_row % 256 == 0 && offset % tex.desc.format.size() == 0\n        else \"gpu.align: bytes_per_row is a multiple of 256\"\n        requires layer >= 0 && layer < tex.desc.layers else \"gpu.range: no such layer\"\n");
        buf_str(out, c"        requires !buf.mapped else \"gpu.state: the buffer is mapped: unmap it first\"\n    {\n        let ww = if w < 0 { tex.desc.width - x } else { w };\n        let hh = if h < 0 { tex.desc.height - y } else { h };\n        assert(x >= 0 && y >= 0 && ww >= 1 && hh >= 1 && x + ww <= tex.desc.width\n            && y + hh <= tex.desc.height, \"gpu.range: the region is outside the texture\");\n        assert(bytes_per_row >= ww * tex.desc.format.size(),\n            \"gpu.range: bytes_per_row is shorter than a row\");\n        assert(offset >= 0\n            && offset + bytes_per_row * (hh - 1) + ww * tex.desc.format.size() <= buf.size,\n            \"gpu.range: the copy reaches past the buffer\");\n        N::copy_buffer_to_texture(&self.raw, buf.raw, offset, bytes_per_row, tex.raw, layer,\n            x, y, ww, hh);\n    }\n\n    /// The recorded commands, for `queue.submit`.\n    pub fn finish(sink self) -> Commands {\n        Commands { raw: self.raw }\n    }\n}\n\n// ---- GPU: surfaces and frames (0.22) ----\n\n/// What a window shows: frames drawn into and presented.\npub struct Surface {\n    pub raw: backend::Surface,\n    pub configured: bool,\n    pub width: i64,\n    pub height: i64,\n    pub format: Format,\n}\n\n/// A frame of a surface: its texture is the render target; `present`\n/// shows it after the work submitted before.\npub struct Frame {\n    pub raw: backend::Frame,\n    pub texture: Texture,\n}\n\nimpl Surface {\n    /// Sizes the surface's frames; vsync: presented at the display's rate.\n    pub fn configure(inout self, dev: Device, width: i64, height: i64,\n        format: Format = Format::Bgra8Unorm, vsync: bool = true)\n        requires width >= 1 && height >= 1 && width <= dev.limits.max_texture_dimension_2d\n        && height <= dev.limits.max_texture_dimension_2d else \"gpu.limits: a surface's size\"\n        requires format == Format::Bgra8Unorm || format == Format::Bgra8UnormSrgb\n        || format == Format::Rgba16Float\n");
        buf_str(out, c"        else \"gpu.format: a surface is Bgra8Unorm, Bgra8UnormSrgb or Rgba16Float\"\n        {\n        N::configure(&self.raw, dev.raw, width, height, format, vsync);\n        self.configured = true;\n        self.width = width;\n        self.height = height;\n        self.format = format;\n    }\n\n    /// The next frame to draw (waits for one to be free).\n    pub fn frame(inout self) -> Result<Frame, Error>\n        requires self.configured else \"gpu.state: configure the surface before taking a frame\"\n    {\n        match N::next_frame(&self.raw) {\n            Some((f, t)) => {\n                let desc = TextureDesc {\n                    width: self.width, height: self.height, layers: 1, mips: 1, format: self.format,\n                    usage: TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC\n                };\n                Ok(Frame { raw: f, texture: Texture { raw: t, desc: desc } })\n            }\n            None => Err(Error::SurfaceLost),\n        }\n    }\n}\n\nimpl Frame {\n    /// Shows the frame after the work submitted to queue so far.\n    pub fn present(sink self, queue: inout Queue) {\n        let f = self;\n        N::present(&queue.raw, f.raw);\n    }\n}\n\n// ---- GPU: bytes (0.22) ----\n\n/// The bytes of a slice of f32s (a view of the same memory).\npub fn bytes_of_f32(s: [f32]) -> [u8] {\n    // s.len() f32s are s.len() * 4 readable bytes; u8 has no alignment\n    unsafe { (s.ptr as *u8)[0..s.len() * 4] }\n}\n\n/// The bytes of a slice of u32s (a view of the same memory).\npub fn bytes_of_u32(s: [u32]) -> [u8] {\n    // as bytes_of_f32\n    unsafe { (s.ptr as *u8)[0..s.len() * 4] }\n}\n\n/// The bytes of a slice of i32s (a view of the same memory).\npub fn bytes_of_i32(s: [i32]) -> [u8] {\n    // as bytes_of_f32\n    unsafe { (s.ptr as *u8)[0..s.len() * 4] }\n}\n\n/// Bytes as f32s (a view): the length a multiple of 4 and the memory\n/// 4-aligned, as mapped buffers are.\npub fn f32s(b: [u8]) -> [f32]\n");
        buf_str(out, c"    requires b.len() % 4 == 0 && (b.ptr as u64) % 4 == 0\n    else \"gpu.align: f32s needs 4-aligned bytes, a multiple of 4\"\n    {\n    // aligned, and every bit pattern is an f32\n    unsafe { (b.ptr as *f32)[0..b.len() / 4] }\n}\n\n/// Bytes as u32s (a view), as f32s.\npub fn u32s(b: [u8]) -> [u32]\n    requires b.len() % 4 == 0 && (b.ptr as u64) % 4 == 0\n    else \"gpu.align: u32s needs 4-aligned bytes, a multiple of 4\"\n    {\n    // aligned, and every bit pattern is a u32\n    unsafe { (b.ptr as *u32)[0..b.len() / 4] }\n}\n\n/// Bytes as i32s (a view), as f32s.\npub fn i32s(b: [u8]) -> [i32]\n    requires b.len() % 4 == 0 && (b.ptr as u64) % 4 == 0\n    else \"gpu.align: i32s needs 4-aligned bytes, a multiple of 4\"\n    {\n    // aligned, and every bit pattern is an i32\n    unsafe { (b.ptr as *i32)[0..b.len() / 4] }\n}\n\n/// The same bytes, writable, as u32s (a view of mapped memory).\npub fn u32s_mut(b: inout [u8]) -> inout [u32]\n    requires b.len() % 4 == 0 && (b.ptr as u64) % 4 == 0\n    else \"gpu.align: u32s needs 4-aligned bytes, a multiple of 4\"\n    {\n    // aligned, and every bit pattern is a u32\n    unsafe { &(b.ptr as *u32)[0..b.len() / 4] }\n}\n\n/// The same bytes, writable, as f32s.\npub fn f32s_mut(b: inout [u8]) -> inout [f32]\n    requires b.len() % 4 == 0 && (b.ptr as u64) % 4 == 0\n    else \"gpu.align: f32s needs 4-aligned bytes, a multiple of 4\"\n    {\n    // aligned, and every bit pattern is an f32\n    unsafe { &(b.ptr as *f32)[0..b.len() / 4] }\n}\n// ---- mod std::gpu::hal ----\npub mod hal {\n// std::gpu::hal (0.22, docs/design/gpu.md §2.1, §2.8): the backend\n// interface. A backend implements `Api` (devices, memory, compute,\n// copies, submission) and, when it can draw, `Render<Self>` (render\n// pipelines, passes, surfaces). A compute-only backend (CUDA, a CPU\n// fallback) implements `Api` alone and reports `render: false` in its\n// Caps; the public API checks the caps before any render call, so no\n");
        buf_str(out, c"// backend writes stubs. Metal (hal::metal) implements both; Vulkan (G3)\n// will. The design's \"CUDA readiness\" section lists what a new backend\n// needs.\n//\n// The rules of the hal:\n// - Everything is static: no `dyn`; the public API names the backend of\n//   the build (`std::gpu::Native`).\n// - The hal validates nothing: std::gpu checks its contracts first.\n// - Every hal type is an owned value: dropping it releases what it holds\n//   (a resource dropped while the GPU still uses it stays alive until the\n//   work that uses it is done: the backend's business).\n// - Memory is not assumed shared: buffers are reached by map_read,\n//   map_write and unmap, which a discrete-memory backend implements with\n//   staging copies; `Caps::unified_memory` is information only.\n// - A function returning Option fails with None when the driver refuses\n//   (out of memory, a shader or pipeline it rejects); its `err` Buf, when\n//   it takes one, gets the driver's message.\n\npub mod metal;\n\nuse std::gpu::shader::{Binding, EntryPoint, ShaderKind, ShaderSource};\nuse std::gpu::types::{Color, Format, IndexFormat, Load, PipelineState, SamplerDesc, TextureDesc};\n\n// ---- The GPU backend interface (0.22) ----\n\n/// What a backend (and its device) can do.\n#[derive(Eq, Debug, Clone)]\npub struct Caps {\n    /// Compute pipelines and dispatches.\n    pub compute: bool,\n    /// Render pipelines and passes (the backend implements Render).\n    pub render: bool,\n    /// Surfaces: presenting to windows.\n    pub surfaces: bool,\n    /// Textures and samplers bound to shaders (sampled and storage).\n    pub textures: bool,\n    /// Host and device share memory (mapping copies nothing). Information\n    /// only: the API behaves the same either way.\n    pub unified_memory: bool,\n    /// The form of shaders the backend takes (the shader compiler's\n    /// target).\n    pub shader_kind: ShaderKind,\n}\n\n/// A window system's handle for a surface (what std::window gives).\n");
        buf_str(out, c"#[derive(Eq)]\npub enum RawSurface {\n    /// A CAMetalLayer (macOS): the layer's pointer.\n    MetalLayer(*u8),\n    /// No window: a surface whose frames are offscreen textures.\n    Headless,\n}\n\n// (0.20: by hand: a derived Clone of a raw pointer field calls clone_of::<*u8>,\n// which does not compile yet)\nimpl Clone for RawSurface {\n    fn clone(self) -> RawSurface {\n        match self {\n            RawSurface::MetalLayer(p) => RawSurface::MetalLayer(p),\n            RawSurface::Headless => RawSurface::Headless,\n        }\n    }\n}\n\npub trait Api {\n    type Adapter;\n    type Device;\n    type Queue;\n    type Buffer;\n    type Texture;\n    type TextureView;\n    type Sampler;\n    type Shader;\n    type ComputePipeline;\n    type BindGroup;\n    type CommandBuffer;\n    type ComputeEncoder;\n\n    // ---- adapters and devices ----\n    fn adapters<A: Allocator>(out: inout Vec<Self::Adapter, A>);\n    fn default_adapter() -> Option<Self::Adapter>;\n    fn adapter_name<A: Allocator>(a: Self::Adapter, out: inout Buf<A>);\n    fn adapter_low_power(a: Self::Adapter) -> bool;\n    fn open(a: Self::Adapter) -> Option<(Self::Device, Self::Queue)>;\n    fn caps(d: Self::Device) -> Caps;\n    /// Waits for everything submitted to the device.\n    fn device_wait_idle(d: Self::Device);\n\n    // ---- memory and resources ----\n    /// A buffer of size bytes holding init (zeros past it).\n    fn create_buffer(d: Self::Device, size: i64, init: [u8]) -> Option<Self::Buffer>;\n    /// The buffer's bytes as the GPU left them (the caller waited).\n    fn map_read(d: Self::Device, b: inout Self::Buffer) -> [u8];\n    /// The buffer's bytes to write; they reach the GPU at unmap.\n    fn map_write(d: Self::Device, b: inout Self::Buffer) -> inout [u8];\n    fn unmap(d: Self::Device, b: inout Self::Buffer);\n    fn create_texture(d: Self::Device, desc: TextureDesc) -> Option<Self::Texture>;\n    /// A view of t, of t's own format or another of the same size.\n");
        buf_str(out, c"    fn create_view(t: Self::Texture, format: Format, same_format: bool) -> Option<Self::TextureView>;\n    fn create_sampler(d: Self::Device, desc: SamplerDesc) -> Option<Self::Sampler>;\n    fn create_shader<A: Allocator>(d: Self::Device, src: ShaderSource, err: inout Buf<A>) -> Option<Self::Shader>;\n\n    fn create_compute_pipeline<A: Allocator>(d: Self::Device, s: Self::Shader, entry: EntryPoint,\n        err: inout Buf<A>) -> Option<Self::ComputePipeline>;\n\n    // ---- bind groups: resources at the slots their bindings name ----\n    fn bind_group_new(d: Self::Device) -> Self::BindGroup;\n\n    fn bind_group_buffer(g: inout Self::BindGroup, b: Binding, buf: Self::Buffer, offset: i64,\n        size: i64);\n\n    fn bind_group_texture(g: inout Self::BindGroup, b: Binding, v: Self::TextureView);\n    fn bind_group_sampler(g: inout Self::BindGroup, b: Binding, s: Self::Sampler);\n\n    // ---- recording ----\n    fn begin(d: Self::Device) -> Self::CommandBuffer;\n\n    fn copy_buffer(cb: inout Self::CommandBuffer, src: Self::Buffer, src_offset: i64,\n        dst: Self::Buffer, dst_offset: i64, size: i64);\n\n    fn copy_texture_to_buffer(cb: inout Self::CommandBuffer, src: Self::Texture, layer: i64, x: i64,\n        y: i64, w: i64, h: i64, dst: Self::Buffer, offset: i64, bytes_per_row: i64);\n\n    fn copy_buffer_to_texture(cb: inout Self::CommandBuffer, src: Self::Buffer, offset: i64,\n        bytes_per_row: i64, dst: Self::Texture, layer: i64, x: i64, y: i64, w: i64, h: i64);\n\n    fn begin_compute(cb: inout Self::CommandBuffer) -> Self::ComputeEncoder;\n    fn compute_set_pipeline(e: inout Self::ComputeEncoder, p: Self::ComputePipeline);\n    fn compute_set_bind_group(e: inout Self::ComputeEncoder, g: Self::BindGroup);\n    fn dispatch(e: inout Self::ComputeEncoder, x: i64, y: i64, z: i64);\n    /// (0.22) Small data at a native slot of the compute stage, copied now\n    /// (Metal's setBytes): the sizes buffer.\n");
        buf_str(out, c"    fn compute_set_bytes(e: inout Self::ComputeEncoder, bytes: [u8], slot: i64);\n    fn end_compute(e: inout Self::ComputeEncoder);\n\n    // ---- submission ----\n    /// Submits cb (it is empty afterwards).\n    fn submit(q: inout Self::Queue, cb: inout Self::CommandBuffer);\n    /// Writes data at offset, ordered after the work submitted before and\n    /// before the work submitted next.\n    fn write_buffer(q: inout Self::Queue, b: Self::Buffer, offset: i64, data: [u8]);\n\n    fn write_texture(q: inout Self::Queue, t: Self::Texture, layer: i64, x: i64, y: i64, w: i64,\n        h: i64, data: [u8], bytes_per_row: i64);\n\n    /// Waits for everything submitted to q; false if a submission failed.\n    fn queue_wait_idle(q: inout Self::Queue) -> bool;\n}\n\n/// What a backend that draws adds (its Caps say `render: true`).\npub trait Render<B: Api> {\n    type RenderPipeline;\n    type RenderEncoder;\n    type PassDesc;\n    type Surface;\n    type Frame;\n\n    fn create_render_pipeline(d: B::Device, vs: B::Shader, vs_entry: EntryPoint, fs: B::Shader,\n        fs_entry: EntryPoint, has_fs: bool, state: PipelineState,\n        err: inout Buf) -> Option<Self::RenderPipeline>;\n\n    fn pass_new() -> Self::PassDesc;\n\n    fn pass_color(p: inout Self::PassDesc, i: i64, v: B::TextureView, load: Load, clear: Color,\n        store: bool);\n\n    fn pass_depth(p: inout Self::PassDesc, v: B::TextureView, load: Load, clear: f64, store: bool);\n    fn begin_render(cb: inout B::CommandBuffer, p: Self::PassDesc) -> Self::RenderEncoder;\n    fn render_set_pipeline(e: inout Self::RenderEncoder, p: Self::RenderPipeline);\n    fn render_set_bind_group(e: inout Self::RenderEncoder, g: B::BindGroup);\n    fn render_set_vertex_buffer(e: inout Self::RenderEncoder, slot: i64, b: B::Buffer, offset: i64);\n\n    fn render_set_index_buffer(e: inout Self::RenderEncoder, b: B::Buffer, format: IndexFormat,\n        offset: i64);\n\n");
        buf_str(out, c"    fn render_set_viewport(e: inout Self::RenderEncoder, x: f32, y: f32, w: f32, h: f32,\n        min_depth: f32, max_depth: f32);\n\n    fn render_set_scissor(e: inout Self::RenderEncoder, x: i64, y: i64, w: i64, h: i64);\n    fn render_set_blend_constant(e: inout Self::RenderEncoder, c: Color);\n\n    fn draw(e: inout Self::RenderEncoder, first_vertex: i64, vertices: i64, first_instance: i64,\n        instances: i64);\n\n    fn draw_indexed(e: inout Self::RenderEncoder, first_index: i64, indices: i64, base_vertex: i64,\n        first_instance: i64, instances: i64);\n\n    /// (0.22) Small data at a native slot of the vertex or fragment stage\n    /// (ShaderStage::VERTEX, FRAGMENT), copied now: the sizes buffer.\n    fn render_set_bytes(e: inout Self::RenderEncoder, stage: u32, bytes: [u8], slot: i64);\n    fn end_render(e: inout Self::RenderEncoder);\n\n    // ---- surfaces ----\n    fn create_surface(d: B::Device, raw: RawSurface) -> Option<Self::Surface>;\n\n    fn configure(s: inout Self::Surface, d: B::Device, width: i64, height: i64, format: Format,\n        vsync: bool);\n\n    /// The next frame and its texture; None when the surface has none to\n    /// give (outdated, or no drawable within the timeout).\n    fn next_frame(s: inout Self::Surface) -> Option<(Self::Frame, B::Texture)>;\n    /// Shows the frame after the work submitted to q so far.\n    fn present(q: inout B::Queue, f: Self::Frame);\n}\n// ---- mod std::gpu::hal::metal ----\npub mod metal {\n// std::gpu::hal::metal (0.22, docs/design/gpu.md §2.8): hal::Api and\n// hal::Render for Metal, through std::objc and the generated bindings\n// (bindings.vl, from compiler/std/objc/tables/metal.objc: every method\n// checked against the runtime, every constant and struct against the\n// SDK's headers).\n//\n// - Metal is opened at run time (objc::framework): a program links only\n//   libobjc (`-l objc`).\n// - Buffers are MTLResourceStorageModeShared (Apple silicon: unified\n");
        buf_str(out, c"//   memory, mapping copies nothing); textures are Private and reached by\n//   blits.\n// - Commands are encoded straight into Metal's encoders. Command buffers\n//   retain what they use (Metal's default), so dropping a resource while\n//   the GPU uses it is safe; unretained command buffers with submission\n//   tracking are a later optimization (design §2.3).\n// - Nothing runs off the main thread (§2.11): the CPU waits with\n//   waitUntilCompleted, never a completion handler.\n// - Objects Metal returns autoreleased (command buffers, encoders,\n//   drawables, errors) are retained inside an autorelease pool scoped to\n//   the call.\n\npub mod bindings;\n\nuse bindings::{\n    CAMetalDrawable, CAMetalDrawableMethods, CAMetalLayer, CAMetalLayerMethods, CGSize,\n    MTLBlitCommandEncoder, MTLBlitCommandEncoderMethods, MTLBuffer, MTLBufferMethods, MTLClearColor,\n    MTLCommandBuffer, MTLCommandBufferMethods, MTLCommandEncoderMethods, MTLCommandQueue,\n    MTLCommandQueueMethods, MTLCompileOptions, MTLCompileOptionsMethods, MTLComputeCommandEncoder,\n    MTLComputeCommandEncoderMethods, MTLComputePipelineState, MTLDepthStencilDescriptor,\n    MTLDepthStencilDescriptorMethods, MTLDepthStencilState, MTLDevice, MTLDeviceMethods,\n    MTLFunction, MTLLibrary, MTLLibraryMethods, MTLOrigin, MTLRenderCommandEncoder,\n    MTLRenderCommandEncoderMethods, MTLRenderPassAttachmentDescriptorMethods,\n    MTLRenderPassColorAttachmentDescriptorArrayMethods,\n    MTLRenderPassColorAttachmentDescriptorMethods, MTLRenderPassDepthAttachmentDescriptorMethods,\n    MTLRenderPassDescriptor, MTLRenderPassDescriptorMethods,\n    MTLRenderPipelineColorAttachmentDescriptorArrayMethods,\n    MTLRenderPipelineColorAttachmentDescriptorMethods, MTLRenderPipelineDescriptor,\n    MTLRenderPipelineDescriptorMethods, MTLRenderPipelineState, MTLSamplerDescriptor,\n    MTLSamplerDescriptorMethods, MTLSamplerState, MTLScissorRect, MTLSize, MTLTexture,\n");
        buf_str(out, c"    MTLTextureDescriptor, MTLTextureDescriptorMethods, MTLTextureMethods,\n    MTLVertexAttributeDescriptorArrayMethods, MTLVertexAttributeDescriptorMethods,\n    MTLVertexBufferLayoutDescriptorArrayMethods, MTLVertexBufferLayoutDescriptorMethods,\n    MTLVertexDescriptor, MTLVertexDescriptorMethods, MTLViewport,\n};\nuse std::gpu::hal::{Api, Caps, RawSurface, Render};\nuse std::gpu::shader::{Binding, EntryPoint, ShaderKind, ShaderSource};\nuse std::gpu::types::{\n    AddressMode, BlendFactor, BlendOp, Color, Compare, Cull, Filter, Format, FrontFace, IndexFormat,\n    Load, PipelineState, SamplerDesc, ShaderStage, StepMode, TextureDesc, TextureUsage, Topology,\n    VertexFormat,\n};\nuse std::objc::{Id, Ref};\nuse std::objc::foundation::{NSArray, NSArrayMethods, NSError, NSErrorMethods};\n\n// (0.25) The Objective-C runtime (#[link]); Metal and QuartzCore are\n// opened at run time (std::objc::framework).\n#[link(lib = \"objc\")]\nextern \"C\" {\n    fn objc_retain(o: *u8) -> *u8;\n    fn objc_release(o: *u8);\n}\n\nextern \"C\" {\n    fn memcpy(dst: *u8, src: *u8, n: u64) -> *u8;\n}\n\n// ---- GPU on Metal: devices, memory, resources (0.22) ----\n\n/// The Metal implementation of hal::Api and hal::Render.\npub struct Metal {}\n\npub struct Adapter {\n    pub dev: Id<MTLDevice>,\n}\n\npub struct Device {\n    pub dev: Id<MTLDevice>,\n    pub queue: Id<MTLCommandQueue>,\n}\n\npub struct Queue {\n    pub q: Id<MTLCommandQueue>,\n    pub last: Id<MTLCommandBuffer>,\n}\n\npub struct Buffer {\n    pub raw: Id<MTLBuffer>,\n    pub ptr: *u8,\n    pub size: i64,\n}\n\npub struct Texture {\n    pub raw: Id<MTLTexture>,\n}\n\npub struct TextureView {\n    pub raw: Id<MTLTexture>,\n}\n\npub struct Sampler {\n    pub raw: Id<MTLSamplerState>,\n}\n\npub struct Shader {\n    pub lib: Id<MTLLibrary>,\n}\n\npub struct ComputePipeline {\n    pub raw: Id<MTLComputePipelineState>,\n    pub workgroup: MTLSize,\n}\n\npub struct RenderPipeline {\n    pub raw: Id<MTLRenderPipelineState>,\n");
        buf_str(out, c"    pub depth: Id<MTLDepthStencilState>,\n    pub primitive: u64,\n    pub cull: u64,\n    pub winding: u64,\n}\n\n/// One resource of a bind group, with its slot in each stage (-1: none).\n/// `obj` is retained by the group.\npub struct Bound {\n    pub kind: i64,\n    pub vs: i64,\n    pub fs: i64,\n    pub cs: i64,\n    pub obj: *u8,\n    pub offset: u64,\n}\n\nconst BIND_BUFFER: i64 = 0;\nconst BIND_TEXTURE: i64 = 1;\nconst BIND_SAMPLER: i64 = 2;\npub const MAX_BOUND: i64 = 16;\n\n/// A bind group: its resources (retained: the group keeps them alive) and\n/// where they go, in a fixed array (no allocation).\npub struct BindGroup {\n    pub items: [Bound; 16],\n    pub count: i64,\n}\n\nimpl Drop for BindGroup {\n    fn drop(inout self) {\n        for i in 0..self.count {\n            // each object was retained once when bound\n            unsafe { objc_release(self.items[i].obj); }\n        }\n        self.count = 0;\n    }\n}\n\npub struct CommandBuffer {\n    pub cb: Id<MTLCommandBuffer>,\n    pub blit: Id<MTLBlitCommandEncoder>,\n}\n\nimpl Drop for CommandBuffer {\n    fn drop(inout self) {\n        end_blit(&self);\n    }\n}\n\npub struct ComputeEncoder {\n    pub enc: Id<MTLComputeCommandEncoder>,\n    pub workgroup: MTLSize,\n}\n\nimpl Drop for ComputeEncoder {\n    fn drop(inout self) {\n        if !self.enc.is_nil() { self.enc.r().end_encoding(); }\n    }\n}\n\npub struct RenderEncoder {\n    pub enc: Id<MTLRenderCommandEncoder>,\n    pub primitive: u64,\n    pub index: Id<MTLBuffer>,\n    pub index_type: u64,\n    pub index_size: i64,\n    pub index_offset: i64,\n}\n\nimpl Drop for RenderEncoder {\n    fn drop(inout self) {\n        if !self.enc.is_nil() { self.enc.r().end_encoding(); }\n    }\n}\n\npub struct PassDesc {\n    pub raw: Id<MTLRenderPassDescriptor>,\n}\n\npub struct Surface {\n    pub layer: Id<CAMetalLayer>,\n}\n\npub struct Frame {\n    pub drawable: Id<CAMetalDrawable>,\n}\n\n// ---- GPU on Metal: conversions (0.22) ----\n\n#[pure]\n");
        buf_str(out, c"pub fn pixel_format(f: Format) -> u64 {\n    match f {\n        Format::R8Unorm => bindings::MTLPixelFormatR8Unorm,\n        Format::R8Uint => bindings::MTLPixelFormatR8Uint,\n        Format::Rg8Unorm => bindings::MTLPixelFormatRG8Unorm,\n        Format::R16Float => bindings::MTLPixelFormatR16Float,\n        Format::R32Uint => bindings::MTLPixelFormatR32Uint,\n        Format::R32Sint => bindings::MTLPixelFormatR32Sint,\n        Format::R32Float => bindings::MTLPixelFormatR32Float,\n        Format::Rg16Float => bindings::MTLPixelFormatRG16Float,\n        Format::Rgba8Unorm => bindings::MTLPixelFormatRGBA8Unorm,\n        Format::Rgba8UnormSrgb => bindings::MTLPixelFormatRGBA8Unorm_sRGB,\n        Format::Rgba8Uint => bindings::MTLPixelFormatRGBA8Uint,\n        Format::Bgra8Unorm => bindings::MTLPixelFormatBGRA8Unorm,\n        Format::Bgra8UnormSrgb => bindings::MTLPixelFormatBGRA8Unorm_sRGB,\n        Format::Rg32Float => bindings::MTLPixelFormatRG32Float,\n        Format::Rgba16Float => bindings::MTLPixelFormatRGBA16Float,\n        Format::Rgba32Uint => bindings::MTLPixelFormatRGBA32Uint,\n        Format::Rgba32Float => bindings::MTLPixelFormatRGBA32Float,\n        Format::Depth32Float => bindings::MTLPixelFormatDepth32Float,\n    }\n}\n\n#[pure]\nfn vertex_format(f: VertexFormat) -> u64 {\n    match f {\n        VertexFormat::Float32 => bindings::MTLVertexFormatFloat,\n        VertexFormat::Float32x2 => bindings::MTLVertexFormatFloat2,\n        VertexFormat::Float32x3 => bindings::MTLVertexFormatFloat3,\n        VertexFormat::Float32x4 => bindings::MTLVertexFormatFloat4,\n        VertexFormat::Uint32 => bindings::MTLVertexFormatUInt,\n        VertexFormat::Uint32x2 => bindings::MTLVertexFormatUInt2,\n        VertexFormat::Uint32x4 => bindings::MTLVertexFormatUInt4,\n        VertexFormat::Sint32 => bindings::MTLVertexFormatInt,\n        VertexFormat::Unorm8x4 => bindings::MTLVertexFormatUChar4Normalized,\n    }\n}\n\n#[pure]\nfn compare_function(c: Compare) -> u64 {\n");
        buf_str(out, c"    match c {\n        Compare::Never => bindings::MTLCompareFunctionNever,\n        Compare::Less => bindings::MTLCompareFunctionLess,\n        Compare::Equal => bindings::MTLCompareFunctionEqual,\n        Compare::LessEqual => bindings::MTLCompareFunctionLessEqual,\n        Compare::Greater => bindings::MTLCompareFunctionGreater,\n        Compare::NotEqual => bindings::MTLCompareFunctionNotEqual,\n        Compare::GreaterEqual => bindings::MTLCompareFunctionGreaterEqual,\n        Compare::Always => bindings::MTLCompareFunctionAlways,\n    }\n}\n\n#[pure]\nfn blend_factor(f: BlendFactor) -> u64 {\n    match f {\n        BlendFactor::Zero => bindings::MTLBlendFactorZero,\n        BlendFactor::One => bindings::MTLBlendFactorOne,\n        BlendFactor::Src => bindings::MTLBlendFactorSourceColor,\n        BlendFactor::OneMinusSrc => bindings::MTLBlendFactorOneMinusSourceColor,\n        BlendFactor::SrcAlpha => bindings::MTLBlendFactorSourceAlpha,\n        BlendFactor::OneMinusSrcAlpha => bindings::MTLBlendFactorOneMinusSourceAlpha,\n        BlendFactor::Dst => bindings::MTLBlendFactorDestinationColor,\n        BlendFactor::OneMinusDst => bindings::MTLBlendFactorOneMinusDestinationColor,\n        BlendFactor::DstAlpha => bindings::MTLBlendFactorDestinationAlpha,\n        BlendFactor::OneMinusDstAlpha => bindings::MTLBlendFactorOneMinusDestinationAlpha,\n    }\n}\n\n#[pure]\nfn blend_op(o: BlendOp) -> u64 {\n    match o {\n        BlendOp::Add => bindings::MTLBlendOperationAdd,\n        BlendOp::Subtract => bindings::MTLBlendOperationSubtract,\n        BlendOp::ReverseSubtract => bindings::MTLBlendOperationReverseSubtract,\n        BlendOp::Min => bindings::MTLBlendOperationMin,\n        BlendOp::Max => bindings::MTLBlendOperationMax,\n    }\n}\n\n#[pure]\nfn filter(f: Filter) -> u64 {\n    match f {\n        Filter::Nearest => bindings::MTLSamplerMinMagFilterNearest,\n        Filter::Linear => bindings::MTLSamplerMinMagFilterLinear,\n    }\n}\n\n#[pure]\n");
        buf_str(out, c"fn address_mode(a: AddressMode) -> u64 {\n    match a {\n        AddressMode::ClampToEdge => bindings::MTLSamplerAddressModeClampToEdge,\n        AddressMode::Repeat => bindings::MTLSamplerAddressModeRepeat,\n        AddressMode::MirrorRepeat => bindings::MTLSamplerAddressModeMirrorRepeat,\n    }\n}\n\n#[pure]\nfn load_action(l: Load) -> u64 {\n    match l {\n        Load::Clear => bindings::MTLLoadActionClear,\n        Load::Keep => bindings::MTLLoadActionLoad,\n        Load::DontCare => bindings::MTLLoadActionDontCare,\n    }\n}\n\n/// The Metal buffer index of vertex buffer `slot` (30 downward, design\n/// §2.8, so that they never meet the shader's own buffers).\n#[pure]\npub fn vertex_buffer_index(slot: i64) -> u64 {\n    (30 - slot) as u64\n}\n\nfn size3(x: i64, y: i64, z: i64) -> MTLSize {\n    MTLSize { width: x as u64, height: y as u64, depth: z as u64 }\n}\n\nfn origin3(x: i64, y: i64, z: i64) -> MTLOrigin {\n    MTLOrigin { x: x as u64, y: y as u64, z: z as u64 }\n}\n\n/// Appends an NSError's description (or `what` when there is none).\nfn push_error<A: Allocator>(err: inout Buf<A>, e: Option<Ref<NSError>>, what: [u8]) {\n    match e {\n        Some(r) => std::objc::push_ns_string(&err, r.localized_description()),\n        None => err.push_str(what),\n    }\n}\n\nfn function<A: Allocator>(s: Shader, e: EntryPoint, err: inout Buf<A>) -> Option<Id<MTLFunction>> {\n    let name = std::objc::ns_string(e.native);\n    let f = s.lib.r().new_function_with_name(name.r());\n    if f.is_none() {\n        err.push_str(\"no function '\");\n        err.push_str(e.native);\n        err.push_str(\"' in the MSL (entry point '\");\n        err.push_str(e.name);\n        err.push_str(\"')\");\n    }\n    f\n}\n\n#[repr(C)]\nunion CFn0 {\n    p: *u8,\n    f: extern \"C\" fn() -> *u8,\n}\n\n/// Calls a C function `*u8 f(void)` of an opened framework (Metal's device\n/// functions; nil when it is not there).\nfn call_c0(name: *u8) -> *u8 {\n");
        buf_str(out, c"    // name is a NUL-terminated literal; a symbol of that name is the\n    // function `id f(void)` Metal declares\n    unsafe {\n        let p = std::objc::symbol(name);\n        if p.is_null() { return 0 as *u8; }\n        let f = CFn0 { p: p }.f;\n        f()\n    }\n}\n\nstatic var OPENED: bool = false;\n\nfn open_frameworks() -> bool {\n    if !OPENED {\n        std::objc::init();\n        OPENED = std::objc::framework(\"Metal\");\n        std::objc::framework(\"QuartzCore\");\n    }\n    OPENED\n}\n\n// ---- GPU on Metal: recording helpers (0.22) ----\n\nfn begin_on(q: Ref<MTLCommandQueue>) -> CommandBuffer {\n    let cb = std::objc::pool(|| match q.command_buffer() {\n        Some(c) => c.retain(),\n        None => Id::<MTLCommandBuffer>::nil(),\n    });\n    CommandBuffer { cb: cb, blit: Id::<MTLBlitCommandEncoder>::nil() }\n}\n\nfn end_blit(cb: inout CommandBuffer) {\n    if !cb.blit.is_nil() {\n        cb.blit.r().end_encoding();\n        cb.blit = Id::<MTLBlitCommandEncoder>::nil();\n    }\n}\n\nfn blit(cb: inout CommandBuffer) -> Ref<MTLBlitCommandEncoder> {\n    if cb.blit.is_nil() {\n        let raw = cb.cb.r();\n        cb.blit = std::objc::pool(|| match raw.blit_command_encoder() {\n            Some(e) => e.retain(),\n            None => Id::<MTLBlitCommandEncoder>::nil(),\n        });\n    }\n    cb.blit.r()\n}\n\nfn bound(kind: i64, b: Binding, obj: *u8, offset: u64) -> Bound {\n    // the group keeps the object: one retain, released by its drop\n    unsafe { objc_retain(obj); }\n    Bound {\n        kind: kind, vs: b.slot_vertex, fs: b.slot_fragment, cs: b.slot_compute, obj: obj,\n        offset: offset\n    }\n}\n\nfn apply_compute(e: Ref<MTLComputeCommandEncoder>, b: Bound) {\n    if b.cs < 0 { return; }\n    let slot = b.cs as u64;\n    // obj is the retained object of the kind `kind` names\n    unsafe {\n        if b.kind == BIND_BUFFER {\n            e.set_buffer_offset_at_index(Some(Ref::<MTLBuffer>::from_global(b.obj)), b.offset,\n");
        buf_str(out, c"                slot);\n        } else if b.kind == BIND_TEXTURE {\n            e.set_texture_at_index(Some(Ref::<MTLTexture>::from_global(b.obj)), slot);\n        } else {\n            e.set_sampler_state_at_index(Some(Ref::<MTLSamplerState>::from_global(b.obj)), slot);\n        }\n    }\n}\n\nfn apply_render(e: Ref<MTLRenderCommandEncoder>, b: Bound) {\n    // obj is the retained object of the kind `kind` names\n    unsafe {\n        if b.kind == BIND_BUFFER {\n            let r = Some(Ref::<MTLBuffer>::from_global(b.obj));\n            if b.vs >= 0 { e.set_vertex_buffer_offset_at_index(r, b.offset, b.vs as u64); }\n            if b.fs >= 0 { e.set_fragment_buffer_offset_at_index(r, b.offset, b.fs as u64); }\n        } else if b.kind == BIND_TEXTURE {\n            let r = Some(Ref::<MTLTexture>::from_global(b.obj));\n            if b.vs >= 0 { e.set_vertex_texture_at_index(r, b.vs as u64); }\n            if b.fs >= 0 { e.set_fragment_texture_at_index(r, b.fs as u64); }\n        } else {\n            let r = Some(Ref::<MTLSamplerState>::from_global(b.obj));\n            if b.vs >= 0 { e.set_vertex_sampler_state_at_index(r, b.vs as u64); }\n            if b.fs >= 0 { e.set_fragment_sampler_state_at_index(r, b.fs as u64); }\n        }\n    }\n}\n\n// ---- GPU on Metal: hal::Api (0.22) ----\n\nimpl Api for Metal {\n    type Adapter = Adapter;\n    type Device = Device;\n    type Queue = Queue;\n    type Buffer = Buffer;\n    type Texture = Texture;\n    type TextureView = TextureView;\n    type Sampler = Sampler;\n    type Shader = Shader;\n    type ComputePipeline = ComputePipeline;\n    type BindGroup = BindGroup;\n    type CommandBuffer = CommandBuffer;\n    type ComputeEncoder = ComputeEncoder;\n\n    fn adapters<A: Allocator>(out: inout Vec<Adapter, A>) {\n        if !open_frameworks() { return; }\n        // MTLCopyAllDevices returns a +1 NSArray of id<MTLDevice>\n        let all = unsafe { Id::<NSArray>::from_owned_or_nil(call_c0(c\"MTLCopyAllDevices\")) };\n");
        buf_str(out, c"        let n = all.r().count();\n        for i in 0..n {\n            // the array's elements are MTLDevices, kept by the array\n            let d = unsafe { all.r().object_at_index(i).cast::<MTLDevice>() };\n            out.push(Adapter { dev: d.retain() });\n        }\n    }\n\n    fn default_adapter() -> Option<Adapter> {\n        if !open_frameworks() { return None; }\n        // MTLCreateSystemDefaultDevice returns a +1 id<MTLDevice> or nil\n        match unsafe { Id::<MTLDevice>::from_owned(call_c0(c\"MTLCreateSystemDefaultDevice\")) } {\n            Some(d) => Some(Adapter { dev: d }),\n            None => None,\n        }\n    }\n\n    fn adapter_name<A: Allocator>(a: Adapter, out: inout Buf<A>) {\n        let _pool = std::objc::Pool::push();\n        std::objc::push_ns_string(&out, a.dev.r().name());\n    }\n\n    fn adapter_low_power(a: Adapter) -> bool {\n        a.dev.r().is_low_power()\n    }\n\n    fn open(a: Adapter) -> Option<(Device, Queue)> {\n        let q = match a.dev.r().new_command_queue() {\n            Some(q) => q,\n            None => return None,\n        };\n        let dev = Device { dev: a.dev.clone(), queue: q.clone() };\n        Some((dev, Queue { q: q, last: Id::<MTLCommandBuffer>::nil() }))\n    }\n\n    fn caps(d: Device) -> Caps {\n        Caps {\n            compute: true,\n            render: true,\n            surfaces: true,\n            textures: true,\n            unified_memory: d.dev.r().has_unified_memory(),\n            shader_kind: ShaderKind::Msl,\n        }\n    }\n\n    fn device_wait_idle(d: Device) {\n        // an empty command buffer completes after everything committed\n        // before it on the same queue\n        let q = d.queue.r();\n        std::objc::pool(|| match q.command_buffer() {\n            Some(cb) => {\n                cb.commit();\n                cb.wait_until_completed();\n            }\n            None => {}\n        });\n    }\n\n");
        buf_str(out, c"    fn create_buffer(d: Device, size: i64, init: [u8]) -> Option<Buffer> {\n        let n = if size < 4 { 4 } else { size };\n        match d.dev\n            .r()\n            .new_buffer_with_length_options(n as u64, bindings::MTLResourceStorageModeShared) {\n            Some(b) => {\n                let p = b.r().contents();\n                if init.len() > 0 {\n                    // contents is the buffer's n bytes of shared memory;\n                    // init.len() <= size is the caller's contract\n                    unsafe { memcpy(p, init.ptr, init.len() as u64); }\n                }\n                Some(Buffer { raw: b, ptr: p, size: size })\n            }\n            None => None,\n        }\n    }\n\n    #[views(b)]\n    fn map_read(d: Device, b: inout Buffer) -> [u8] {\n        // shared memory: contents is valid for size bytes while b lives\n        unsafe { b.ptr[0..b.size] }\n    }\n\n    #[views(b)]\n    fn map_write(d: Device, b: inout Buffer) -> inout [u8] {\n        // as map_read\n        unsafe { &b.ptr[0..b.size] }\n    }\n\n    fn unmap(d: Device, b: inout Buffer) {}\n\n    fn create_texture(d: Device, desc: TextureDesc) -> Option<Texture> {\n        let td = MTLTextureDescriptor::new();\n        let t = td.r();\n        t.set_texture_type(if desc.layers > 1 { bindings::MTLTextureType2DArray }\n            else { bindings::MTLTextureType2D });\n        t.set_pixel_format(pixel_format(desc.format));\n        t.set_width(desc.width as u64);\n        t.set_height(desc.height as u64);\n        t.set_array_length(desc.layers as u64);\n        t.set_mipmap_level_count(desc.mips as u64);\n        var usage: u64 = bindings::MTLTextureUsagePixelFormatView;\n        if desc.usage & TextureUsage::TEXTURE_BINDING\n            != 0 { usage = usage | bindings::MTLTextureUsageShaderRead; }\n        if desc.usage & TextureUsage::STORAGE_BINDING != 0 {\n            usage = usage | bindings::MTLTextureUsageShaderRead\n");
        buf_str(out, c"                | bindings::MTLTextureUsageShaderWrite;\n        }\n        if desc.usage & TextureUsage::RENDER_ATTACHMENT\n            != 0 { usage = usage | bindings::MTLTextureUsageRenderTarget; }\n        t.set_usage(usage);\n        t.set_storage_mode(bindings::MTLStorageModePrivate);\n        match d.dev.r().new_texture_with_descriptor(t) {\n            Some(x) => Some(Texture { raw: x }),\n            None => None,\n        }\n    }\n\n    fn create_view(t: Texture, format: Format, same_format: bool) -> Option<TextureView> {\n        if same_format {\n            return Some(TextureView { raw: t.raw.clone() });\n        }\n        match t.raw.r().new_texture_view_with_pixel_format(pixel_format(format)) {\n            Some(v) => Some(TextureView { raw: v }),\n            None => None,\n        }\n    }\n\n    fn create_sampler(d: Device, desc: SamplerDesc) -> Option<Sampler> {\n        let sd = MTLSamplerDescriptor::new();\n        let s = sd.r();\n        s.set_min_filter(filter(desc.min));\n        s.set_mag_filter(filter(desc.mag));\n        s.set_mip_filter(if desc.mip == Filter::Linear { bindings::MTLSamplerMipFilterLinear }\n            else { bindings::MTLSamplerMipFilterNearest });\n        s.set_s_address_mode(address_mode(desc.address_u));\n        s.set_t_address_mode(address_mode(desc.address_v));\n        s.set_r_address_mode(address_mode(desc.address_w));\n        s.set_lod_min_clamp(desc.lod_min);\n        s.set_lod_max_clamp(desc.lod_max);\n        s.set_max_anisotropy(desc.anisotropy as u64);\n        match desc.compare {\n            Some(c) => s.set_compare_function(compare_function(c)),\n            None => {}\n        }\n        match d.dev.r().new_sampler_state_with_descriptor(s) {\n            Some(x) => Some(Sampler { raw: x }),\n            None => None,\n        }\n    }\n\n    fn create_shader<A: Allocator>(d: Device, src: ShaderSource, err: inout Buf<A>) -> Option<Shader> {\n        if src.kind != ShaderKind::Msl {\n");
        buf_str(out, c"            err.push_str(\"Metal takes MSL (ShaderKind::Msl)\");\n            return None;\n        }\n        let _pool = std::objc::Pool::push();\n        let opts = MTLCompileOptions::new();\n        opts.r().set_language_version(bindings::MTLLanguageVersion3_0);\n        let source = std::objc::ns_string(src.code);\n        var e: *u8 = 0 as *u8;\n        // the error out-parameter is a local; Metal stores an autoreleased\n        // NSError (or nothing) there, alive until _pool drops\n        let lib = unsafe {\n            d.dev\n                .r()\n                .new_library_with_source_options_error(source.r(), Some(opts.r()), &e as *u8)\n        };\n        match lib {\n            Some(l) => Some(Shader { lib: l }),\n            None => {\n                push_error(&err, unsafe { Ref::<NSError>::from_global_opt(e) },\n                    \"the MSL did not compile\");\n                None\n            }\n        }\n    }\n\n    fn create_compute_pipeline<A: Allocator>(d: Device, s: Shader, entry: EntryPoint,\n        err: inout Buf<A>) -> Option<ComputePipeline> {\n        let f = match function(s, entry, &err) {\n            Some(f) => f,\n            None => return None,\n        };\n        let wg = size3(entry.workgroup[0], entry.workgroup[1], entry.workgroup[2]);\n        let _pool = std::objc::Pool::push();\n        var e: *u8 = 0 as *u8;\n        // the error out-parameter is a local (see create_shader)\n        match unsafe {\n            d.dev.r().new_compute_pipeline_state_with_function_error(f.r(), &e as *u8)\n        } {\n            Some(p) => Some(ComputePipeline { raw: p, workgroup: wg }),\n            None => {\n                push_error(&err, unsafe { Ref::<NSError>::from_global_opt(e) },\n                    \"Metal rejected the compute pipeline\");\n                None\n            }\n        }\n    }\n\n    fn bind_group_new(d: Device) -> BindGroup {\n");
        buf_str(out, c"        let empty = Bound { kind: BIND_BUFFER, vs: -1, fs: -1, cs: -1, obj: 0 as *u8, offset: 0 };\n        BindGroup { items: [empty; 16], count: 0 }\n    }\n\n    fn bind_group_buffer(g: inout BindGroup, b: Binding, buf: Buffer, offset: i64, size: i64) {\n        g.items[g.count] = bound(BIND_BUFFER, b, buf.raw.ptr, offset as u64);\n        g.count += 1;\n    }\n\n    fn bind_group_texture(g: inout BindGroup, b: Binding, v: TextureView) {\n        g.items[g.count] = bound(BIND_TEXTURE, b, v.raw.ptr, 0);\n        g.count += 1;\n    }\n\n    fn bind_group_sampler(g: inout BindGroup, b: Binding, s: Sampler) {\n        g.items[g.count] = bound(BIND_SAMPLER, b, s.raw.ptr, 0);\n        g.count += 1;\n    }\n\n    fn begin(d: Device) -> CommandBuffer {\n        begin_on(d.queue.r())\n    }\n\n    fn copy_buffer(cb: inout CommandBuffer, src: Buffer, src_offset: i64, dst: Buffer,\n        dst_offset: i64, size: i64) {\n        blit(&cb).copy_from_buffer_source_offset_to_buffer_destination_offset_size(src.raw.r(),\n            src_offset as u64, dst.raw.r(), dst_offset as u64, size as u64);\n    }\n\n    fn copy_texture_to_buffer(cb: inout CommandBuffer, src: Texture, layer: i64, x: i64, y: i64,\n        w: i64, h: i64, dst: Buffer, offset: i64, bytes_per_row: i64) {\n        blit(&cb).copy_texture_to_buffer(src.raw.r(), layer as u64, 0, origin3(x, y, 0),\n            size3(w, h, 1), dst.raw.r(), offset as u64, bytes_per_row as u64,\n            (bytes_per_row * h) as u64);\n    }\n\n    fn copy_buffer_to_texture(cb: inout CommandBuffer, src: Buffer, offset: i64, bytes_per_row: i64,\n        dst: Texture, layer: i64, x: i64, y: i64, w: i64, h: i64) {\n        blit(&cb).copy_buffer_to_texture(src.raw.r(), offset as u64, bytes_per_row as u64,\n            (bytes_per_row * h) as u64, size3(w, h, 1), dst.raw.r(), layer as u64, 0,\n            origin3(x, y, 0));\n    }\n\n    fn begin_compute(cb: inout CommandBuffer) -> ComputeEncoder {\n        end_blit(&cb);\n");
        buf_str(out, c"        let raw = cb.cb.r();\n        let e = std::objc::pool(|| match raw.compute_command_encoder() {\n            Some(e) => e.retain(),\n            None => Id::<MTLComputeCommandEncoder>::nil(),\n        });\n        ComputeEncoder { enc: e, workgroup: size3(1, 1, 1) }\n    }\n\n    fn compute_set_pipeline(e: inout ComputeEncoder, p: ComputePipeline) {\n        e.enc.r().set_compute_pipeline_state(p.raw.r());\n        e.workgroup = p.workgroup;\n    }\n\n    fn compute_set_bind_group(e: inout ComputeEncoder, g: BindGroup) {\n        let enc = e.enc.r();\n        for i in 0..g.count {\n            apply_compute(enc, g.items[i]);\n        }\n    }\n\n    fn dispatch(e: inout ComputeEncoder, x: i64, y: i64, z: i64) {\n        e.enc.r().dispatch_threadgroups_threads_per_threadgroup(size3(x, y, z), e.workgroup);\n    }\n\n    fn compute_set_bytes(e: inout ComputeEncoder, bytes: [u8], slot: i64) {\n        // (Metal copies the bytes before the call returns)\n        unsafe {\n            e.enc.r().set_bytes_length_at_index(bytes.ptr, bytes.len() as u64, slot as u64);\n        }\n    }\n\n    fn end_compute(e: inout ComputeEncoder) {\n        e.enc.r().end_encoding();\n        e.enc = Id::<MTLComputeCommandEncoder>::nil();\n    }\n\n    fn submit(q: inout Queue, cb: inout CommandBuffer) {\n        end_blit(&cb);\n        cb.cb.r().commit();\n        q.last = std::replace(&cb.cb, Id::<MTLCommandBuffer>::nil());\n    }\n\n    fn write_buffer(q: inout Queue, b: Buffer, offset: i64, data: [u8]) {\n        if data.len() == 0 { return; }\n        let idle = q.last.is_nil()\n            || q.last.r().status() >= bindings::MTLCommandBufferStatusCompleted;\n        if idle {\n            // no submitted work can be reading the buffer: write its shared\n            // memory directly (offset + data.len() <= size is the caller's\n            // contract)\n            unsafe { memcpy(b.ptr[offset..offset + data.len()].ptr, data.ptr, data.len() as u64); }\n            return;\n");
        buf_str(out, c"        }\n        // in flight: a staging copy, ordered on the queue\n        let dev = q.q.r().device();\n        // data.ptr points to data.len() readable bytes\n        let staging = match unsafe {\n            dev.new_buffer_with_bytes_length_options(data.ptr, data.len() as u64,\n                bindings::MTLResourceStorageModeShared)\n        } {\n            Some(s) => s,\n            None => return,\n        };\n        var cb = begin_on(q.q.r());\n        blit(&cb).copy_from_buffer_source_offset_to_buffer_destination_offset_size(staging.r(),\n            0, b.raw.r(), offset as u64, data.len() as u64);\n        Metal::submit(&q, &cb);\n    }\n\n    fn write_texture(q: inout Queue, t: Texture, layer: i64, x: i64, y: i64, w: i64, h: i64,\n        data: [u8], bytes_per_row: i64) {\n        let dev = q.q.r().device();\n        // data holds bytes_per_row * h bytes (the caller's contract)\n        let staging = match unsafe {\n            dev.new_buffer_with_bytes_length_options(data.ptr, data.len() as u64,\n                bindings::MTLResourceStorageModeShared)\n        } {\n            Some(s) => s,\n            None => return,\n        };\n        var cb = begin_on(q.q.r());\n        blit(&cb).copy_buffer_to_texture(staging.r(), 0, bytes_per_row as u64,\n            (bytes_per_row * h) as u64, size3(w, h, 1), t.raw.r(), layer as u64, 0,\n            origin3(x, y, 0));\n        Metal::submit(&q, &cb);\n    }\n\n    fn queue_wait_idle(q: inout Queue) -> bool {\n        if q.last.is_nil() { return true; }\n        let last = q.last.r();\n        last.wait_until_completed();\n        last.status() == bindings::MTLCommandBufferStatusCompleted\n    }\n}\n\n// ---- GPU on Metal: hal::Render (0.22) ----\n\nimpl Render<Metal> for Metal {\n    type RenderPipeline = RenderPipeline;\n    type RenderEncoder = RenderEncoder;\n    type PassDesc = PassDesc;\n    type Surface = Surface;\n    type Frame = Frame;\n\n");
        buf_str(out, c"    fn create_render_pipeline(d: Device, vs: Shader, vs_entry: EntryPoint, fs: Shader,\n        fs_entry: EntryPoint, has_fs: bool, state: PipelineState,\n        err: inout Buf) -> Option<RenderPipeline> {\n        let vf = match function(vs, vs_entry, &err) {\n            Some(f) => f,\n            None => return None,\n        };\n        var ff = Id::<MTLFunction>::nil();\n        if has_fs {\n            ff = match function(fs, fs_entry, &err) {\n                Some(f) => f,\n                None => return None,\n            };\n        }\n        let pd = MTLRenderPipelineDescriptor::new();\n        let p = pd.r();\n        p.set_vertex_function(Some(vf.r()));\n        if has_fs { p.set_fragment_function(Some(ff.r())); }\n        let colors = p.color_attachments();\n        for i in 0..state.target_count {\n            let t = state.targets[i];\n            let c = colors.object_at_indexed_subscript(i as u64);\n            c.set_pixel_format(pixel_format(t.format));\n            c.set_write_mask(t.write_mask as u64);\n            match t.blend {\n                Some(b) => {\n                    c.set_blending_enabled(true);\n                    c.set_source_rgb_blend_factor(blend_factor(b.color.src));\n                    c.set_destination_rgb_blend_factor(blend_factor(b.color.dst));\n                    c.set_rgb_blend_operation(blend_op(b.color.op));\n                    c.set_source_alpha_blend_factor(blend_factor(b.alpha.src));\n                    c.set_destination_alpha_blend_factor(blend_factor(b.alpha.dst));\n                    c.set_alpha_blend_operation(blend_op(b.alpha.op));\n                }\n                None => c.set_blending_enabled(false),\n            }\n        }\n        let vd = MTLVertexDescriptor::new();\n        if state.buffer_count > 0 {\n            let attrs = vd.r().attributes();\n            let layouts = vd.r().layouts();\n            for i in 0..state.buffer_count {\n                let l = state.buffers[i];\n");
        buf_str(out, c"                let index = vertex_buffer_index(i);\n                let lay = layouts.object_at_indexed_subscript(index);\n                lay.set_stride(l.stride as u64);\n                lay.set_step_function(if l.step\n                    == StepMode::Instance { bindings::MTLVertexStepFunctionPerInstance }\n                    else { bindings::MTLVertexStepFunctionPerVertex });\n                lay.set_step_rate(1);\n                for k in 0..l.count {\n                    let a = l.attributes[k];\n                    let ad = attrs.object_at_indexed_subscript(a.location as u64);\n                    ad.set_format(vertex_format(a.format));\n                    ad.set_offset(a.offset as u64);\n                    ad.set_buffer_index(index);\n                }\n            }\n            p.set_vertex_descriptor(Some(vd.r()));\n        }\n        var depth = Id::<MTLDepthStencilState>::nil();\n        match state.depth {\n            Some(ds) => {\n                p.set_depth_attachment_pixel_format(pixel_format(ds.format));\n                let dd = MTLDepthStencilDescriptor::new();\n                dd.r().set_depth_compare_function(compare_function(ds.compare));\n                dd.r().set_depth_write_enabled(ds.write);\n                match d.dev.r().new_depth_stencil_state_with_descriptor(dd.r()) {\n                    Some(s) => { depth = s; }\n                    None => {}\n                }\n            }\n            None => {}\n        }\n        let _pool = std::objc::Pool::push();\n        var e: *u8 = 0 as *u8;\n        // the error out-parameter is a local (see create_shader)\n        match unsafe { d.dev.r().new_render_pipeline_state_with_descriptor_error(p, &e as *u8) } {\n            Some(raw) => {\n                let primitive = match state.topology {\n                    Topology::PointList => bindings::MTLPrimitiveTypePoint,\n                    Topology::LineList => bindings::MTLPrimitiveTypeLine,\n");
        buf_str(out, c"                    Topology::LineStrip => bindings::MTLPrimitiveTypeLineStrip,\n                    Topology::TriangleList => bindings::MTLPrimitiveTypeTriangle,\n                    Topology::TriangleStrip => bindings::MTLPrimitiveTypeTriangleStrip,\n                };\n                let cull = match state.cull {\n                    Cull::None => bindings::MTLCullModeNone,\n                    Cull::Front => bindings::MTLCullModeFront,\n                    Cull::Back => bindings::MTLCullModeBack,\n                };\n                // WebGPU's clip space has y up, as Metal's: counter-clockwise\n                // is the same winding in both\n                let winding = if state.front_face\n                    == FrontFace::Ccw { bindings::MTLWindingCounterClockwise }\n                    else { bindings::MTLWindingClockwise };\n                Some(RenderPipeline {\n                    raw: raw, depth: depth, primitive: primitive, cull: cull, winding: winding\n                })\n            }\n            None => {\n                push_error(&err, unsafe { Ref::<NSError>::from_global_opt(e) },\n                    \"Metal rejected the render pipeline\");\n                None\n            }\n        }\n    }\n\n    fn pass_new() -> PassDesc {\n        PassDesc { raw: MTLRenderPassDescriptor::new() }\n    }\n\n    fn pass_color(p: inout PassDesc, i: i64, v: TextureView, load: Load, clear: Color, store: bool) {\n        let a = p.raw.r().color_attachments().object_at_indexed_subscript(i as u64);\n        a.set_texture(Some(v.raw.r()));\n        a.set_load_action(load_action(load));\n        a.set_clear_color(MTLClearColor {\n            red: clear.r, green: clear.g, blue: clear.b, alpha: clear.a\n        });\n        a.set_store_action(if store { bindings::MTLStoreActionStore }\n            else { bindings::MTLStoreActionDontCare });\n    }\n\n    fn pass_depth(p: inout PassDesc, v: TextureView, load: Load, clear: f64, store: bool) {\n");
        buf_str(out, c"        let a = p.raw.r().depth_attachment();\n        a.set_texture(Some(v.raw.r()));\n        a.set_load_action(load_action(load));\n        a.set_clear_depth(clear);\n        a.set_store_action(if store { bindings::MTLStoreActionStore }\n            else { bindings::MTLStoreActionDontCare });\n    }\n\n    fn begin_render(cb: inout CommandBuffer, p: PassDesc) -> RenderEncoder {\n        end_blit(&cb);\n        let raw = cb.cb.r();\n        let desc = p.raw.r();\n        let e = std::objc::pool(|| match raw.render_command_encoder_with_descriptor(desc) {\n            Some(e) => e.retain(),\n            None => Id::<MTLRenderCommandEncoder>::nil(),\n        });\n        RenderEncoder {\n            enc: e, primitive: bindings::MTLPrimitiveTypeTriangle, index: Id::<MTLBuffer>::nil(),\n            index_type: 0, index_size: 2, index_offset: 0\n        }\n    }\n\n    fn render_set_pipeline(e: inout RenderEncoder, p: RenderPipeline) {\n        let enc = e.enc.r();\n        enc.set_render_pipeline_state(p.raw.r());\n        enc.set_cull_mode(p.cull);\n        enc.set_front_facing_winding(p.winding);\n        if !p.depth.is_nil() {\n            enc.set_depth_stencil_state(Some(p.depth.r()));\n        }\n        e.primitive = p.primitive;\n    }\n\n    fn render_set_bind_group(e: inout RenderEncoder, g: BindGroup) {\n        let enc = e.enc.r();\n        for i in 0..g.count {\n            apply_render(enc, g.items[i]);\n        }\n    }\n\n    fn render_set_bytes(e: inout RenderEncoder, stage: u32, bytes: [u8], slot: i64) {\n        let enc = e.enc.r();\n        // (Metal copies the bytes before the call returns)\n        unsafe {\n            if stage == ShaderStage::VERTEX {\n                enc.set_vertex_bytes_length_at_index(bytes.ptr, bytes.len() as u64, slot as u64);\n            } else {\n                enc.set_fragment_bytes_length_at_index(bytes.ptr, bytes.len() as u64,\n                    slot as u64);\n            }\n        }\n    }\n\n");
        buf_str(out, c"    fn render_set_vertex_buffer(e: inout RenderEncoder, slot: i64, b: Buffer, offset: i64) {\n        e.enc\n            .r()\n            .set_vertex_buffer_offset_at_index(Some(b.raw.r()), offset as u64,\n                vertex_buffer_index(slot));\n    }\n\n    fn render_set_index_buffer(e: inout RenderEncoder, b: Buffer, format: IndexFormat, offset: i64) {\n        e.index = b.raw.clone();\n        e.index_type = if format == IndexFormat::Uint32 { bindings::MTLIndexTypeUInt32 }\n            else { bindings::MTLIndexTypeUInt16 };\n        e.index_size = format.size();\n        e.index_offset = offset;\n    }\n\n    fn render_set_viewport(e: inout RenderEncoder, x: f32, y: f32, w: f32, h: f32, min_depth: f32,\n        max_depth: f32) {\n        e.enc\n            .r()\n            .set_viewport(MTLViewport {\n                originX: x as f64, originY: y as f64, width: w as f64, height: h as f64,\n                znear: min_depth as f64, zfar: max_depth as f64\n            });\n    }\n\n    fn render_set_scissor(e: inout RenderEncoder, x: i64, y: i64, w: i64, h: i64) {\n        e.enc\n            .r()\n            .set_scissor_rect(MTLScissorRect {\n                x: x as u64, y: y as u64, width: w as u64, height: h as u64\n            });\n    }\n\n    fn render_set_blend_constant(e: inout RenderEncoder, c: Color) {\n        e.enc\n            .r()\n            .set_blend_color_red_green_blue_alpha(c.r as f32, c.g as f32, c.b as f32, c.a as f32);\n    }\n\n    fn draw(e: inout RenderEncoder, first_vertex: i64, vertices: i64, first_instance: i64,\n        instances: i64) {\n        e.enc\n            .r()\n            .draw_primitives_vertex_start_vertex_count_instance_count_base_instance(e.primitive,\n                first_vertex as u64, vertices as u64, instances as u64, first_instance as u64);\n    }\n\n    fn draw_indexed(e: inout RenderEncoder, first_index: i64, indices: i64, base_vertex: i64,\n        first_instance: i64, instances: i64) {\n");
        buf_str(out, c"        let offset = e.index_offset + first_index * e.index_size;\n        e.enc.r().draw_indexed_primitives_index_count_index_type_index_buffer_index_buffer_offset_instance_count_base_vertex_base_instance(e.primitive, indices as u64, e.index_type, e.index.r(), offset as u64, instances as u64, base_vertex, first_instance as u64);\n    }\n\n    fn end_render(e: inout RenderEncoder) {\n        e.enc.r().end_encoding();\n        e.enc = Id::<MTLRenderCommandEncoder>::nil();\n    }\n\n    fn create_surface(d: Device, raw: RawSurface) -> Option<Surface> {\n        if !open_frameworks() { return None; }\n        let layer = match raw {\n            // the window library's CAMetalLayer, kept by a retain\n            RawSurface::MetalLayer(p) => {\n                let r = unsafe { Ref::<CAMetalLayer>::from_global(p) };\n                r.retain()\n            }\n            // an unattached layer: its drawables are offscreen\n            RawSurface::Headless => std::objc::pool(|| CAMetalLayer::layer().retain()),\n        };\n        if layer.is_nil() { return None; }\n        layer.r().set_device(Some(d.dev.r()));\n        Some(Surface { layer: layer })\n    }\n\n    fn configure(s: inout Surface, d: Device, width: i64, height: i64, format: Format, vsync: bool) {\n        let l = s.layer.r();\n        l.set_device(Some(d.dev.r()));\n        l.set_pixel_format(pixel_format(format));\n        l.set_drawable_size(CGSize { width: width as f64, height: height as f64 });\n        l.set_framebuffer_only(false);\n        l.set_maximum_drawable_count(3);\n        l.set_display_sync_enabled(vsync);\n    }\n\n    fn next_frame(s: inout Surface) -> Option<(Frame, Texture)> {\n        let l = s.layer.r();\n        let _pool = std::objc::Pool::push();\n        match l.next_drawable() {\n            Some(dr) => {\n                let tex = dr.texture().retain();\n                Some((Frame { drawable: dr.retain() }, Texture { raw: tex }))\n            }\n          