16float\",\n");
        buf_str(out, c"    \"unpack2x16float\",\n    \"asinh\",\n    \"acosh\",\n    \"atanh\",\n    \"faceForward\",\n    \"ldexp\",\n    \"pack4x8snorm\",\n    \"unpack4x8snorm\",\n    \"pack2x16unorm\",\n    \"unpack2x16unorm\",\n    \"pack2x16snorm\",\n    \"unpack2x16snorm\",\n    \"select\",\n    \"arrayLength\",\n    \"bitcast\",\n    \"atomicLoad\",\n    \"atomicStore\",\n    \"atomicAdd\",\n    \"atomicSub\",\n    \"atomicMax\",\n    \"atomicMin\",\n    \"atomicAnd\",\n    \"atomicOr\",\n    \"atomicXor\",\n    \"atomicExchange\",\n    \"atomicCompareExchangeWeak\",\n    \"workgroupBarrier\",\n    \"storageBarrier\",\n    \"workgroupUniformLoad\",\n    \"dpdx\",\n    \"dpdy\",\n    \"fwidth\",\n    \"dpdxCoarse\",\n    \"dpdyCoarse\",\n    \"fwidthCoarse\",\n    \"dpdxFine\",\n    \"dpdyFine\",\n    \"fwidthFine\",\n    \"textureSample\",\n    \"textureSampleBias\",\n    \"textureSampleLevel\",\n    \"textureSampleCompare\",\n    \"textureSampleCompareLevel\",\n    \"textureLoad\",\n    \"textureStore\",\n    \"textureDimensions\",\n    \"textureNumLevels\",\n    \"textureNumLayers\",\n];\n\n// keywords\npub const K_FN: i64 = 0;\npub const K_LET: i64 = 1;\npub const K_VAR: i64 = 2;\npub const K_CONST: i64 = 3;\npub const K_STRUCT: i64 = 4;\npub const K_RETURN: i64 = 5;\npub const K_IF: i64 = 6;\npub const K_ELSE: i64 = 7;\npub const K_FOR: i64 = 8;\npub const K_WHILE: i64 = 9;\npub const K_LOOP: i64 = 10;\npub const K_BREAK: i64 = 11;\npub const K_CONTINUE: i64 = 12;\npub const K_CONTINUING: i64 = 13;\npub const K_SWITCH: i64 = 14;\npub const K_CASE: i64 = 15;\npub const K_DEFAULT: i64 = 16;\npub const K_DISCARD: i64 = 17;\npub const K_TRUE: i64 = 18;\npub const K_FALSE: i64 = 19;\npub const K_ALIAS: i64 = 20;\npub const K_OVERRIDE: i64 = 21;\npub const K_ENABLE: i64 = 22;\npub const K_REQUIRES: i64 = 23;\npub const K_DIAGNOSTIC: i64 = 24;\npub const K_CONST_ASSERT: i64 = 25;\npub const K_FALLTHROUGH: i64 = 26;\n// types\npub const K_BOOL: i64 = 27;\npub const K_I32: i64 = 28;\n");
