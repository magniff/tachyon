199;\n");
        buf_str(out, c"pub const K_BITCAST: i64 = 200;\npub const K_ATOMIC_LOAD: i64 = 201;\npub const K_ATOMIC_STORE: i64 = 202;\npub const K_ATOMIC_ADD: i64 = 203;\npub const K_ATOMIC_SUB: i64 = 204;\npub const K_ATOMIC_MAX: i64 = 205;\npub const K_ATOMIC_MIN: i64 = 206;\npub const K_ATOMIC_AND: i64 = 207;\npub const K_ATOMIC_OR: i64 = 208;\npub const K_ATOMIC_XOR: i64 = 209;\npub const K_ATOMIC_EXCHANGE: i64 = 210;\npub const K_ATOMIC_COMPARE_EXCHANGE_WEAK: i64 = 211;\npub const K_WORKGROUP_BARRIER: i64 = 212;\npub const K_STORAGE_BARRIER: i64 = 213;\npub const K_WORKGROUP_UNIFORM_LOAD: i64 = 214;\npub const K_DPDX: i64 = 215;\npub const K_DPDY: i64 = 216;\npub const K_FWIDTH: i64 = 217;\npub const K_DPDX_COARSE: i64 = 218;\npub const K_DPDY_COARSE: i64 = 219;\npub const K_FWIDTH_COARSE: i64 = 220;\npub const K_DPDX_FINE: i64 = 221;\npub const K_DPDY_FINE: i64 = 222;\npub const K_FWIDTH_FINE: i64 = 223;\npub const K_TEXTURE_SAMPLE: i64 = 224;\npub const K_TEXTURE_SAMPLE_BIAS: i64 = 225;\npub const K_TEXTURE_SAMPLE_LEVEL: i64 = 226;\npub const K_TEXTURE_SAMPLE_COMPARE: i64 = 227;\npub const K_TEXTURE_SAMPLE_COMPARE_LEVEL: i64 = 228;\npub const K_TEXTURE_LOAD: i64 = 229;\npub const K_TEXTURE_STORE: i64 = 230;\npub const K_TEXTURE_DIMENSIONS: i64 = 231;\npub const K_TEXTURE_NUM_LEVELS: i64 = 232;\npub const K_TEXTURE_NUM_LAYERS: i64 = 233;\npub const K_COUNT: i64 = 234;\n// ---- end mod std::gpu::wgsl::names ----\n}\n// ---- mod std::gpu::wgsl::lex ----\npub mod lex {\n// ---- Shader compiler implementation, lex (0.22) ----\n// The WGSL lexer: the whole source becomes arrays of tokens (kind, start,\n// end, and for an identifier its symbol). Identifiers are interned: the\n// predeclared names (names.vl) have fixed symbols, so the parser\n// compares integers. Comments (`//`, nesting `/* */`) and blanks are\n// skipped.\n\nuse ir::V;\nuse names::PREDECLARED;\nuse std::{HashMap, ScopedArena, Vec};\nuse std::Option::{None, Some};\n\npub const T_EOF: u8 = 0;\npub const T_IDENT: u8 = 1;\n");
        buf_str(out, c"// an integer literal: its text is start .. end, the suffix included\npub const T_INT: u8 = 2;\npub const T_FLOAT: u8 = 3;\npub const T_LPAREN: u8 = 4;\npub const T_RPAREN: u8 = 5;\npub const T_LBRACE: u8 = 6;\npub const T_RBRACE: u8 = 7;\npub const T_LBRACKET: u8 = 8;\npub const T_RBRACKET: u8 = 9;\npub const T_COMMA: u8 = 10;\npub const T_SEMI: u8 = 11;\npub const T_COLON: u8 = 12;\npub const T_DOT: u8 = 13;\npub const T_AT: u8 = 14;\npub const T_ARROW: u8 = 15;\npub const T_EQ: u8 = 16;\npub const T_EQEQ: u8 = 17;\npub const T_NE: u8 = 18;\npub const T_LT: u8 = 19;\npub const T_LE: u8 = 20;\npub const T_GT: u8 = 21;\npub const T_GE: u8 = 22;\npub const T_PLUS: u8 = 23;\npub const T_MINUS: u8 = 24;\npub const T_STAR: u8 = 25;\npub const T_SLASH: u8 = 26;\npub const T_PERCENT: u8 = 27;\npub const T_AMP: u8 = 28;\npub const T_PIPE: u8 = 29;\npub const T_CARET: u8 = 30;\npub const T_TILDE: u8 = 31;\npub const T_BANG: u8 = 32;\npub const T_ANDAND: u8 = 33;\npub const T_OROR: u8 = 34;\npub const T_SHL: u8 = 35;\npub const T_SHR: u8 = 36;\npub const T_PLUSEQ: u8 = 37;\npub const T_MINUSEQ: u8 = 38;\npub const T_STAREQ: u8 = 39;\npub const T_SLASHEQ: u8 = 40;\npub const T_PERCENTEQ: u8 = 41;\npub const T_AMPEQ: u8 = 42;\npub const T_PIPEEQ: u8 = 43;\npub const T_CARETEQ: u8 = 44;\npub const T_SHLEQ: u8 = 45;\npub const T_SHREQ: u8 = 46;\npub const T_PLUSPLUS: u8 = 47;\npub const T_MINUSMINUS: u8 = 48;\npub const T_UNDERSCORE: u8 = 49;\n// a byte that starts no token\npub const T_BAD: u8 = 50;\n\npub struct Tokens {\n    kinds: V<u8>,\n    starts: V<i64>,\n    ends: V<i64>,\n    // the symbol of an identifier, else -1\n    syms: V<i64>,\n    // symbol -> its text\n    names: V<[u8]>,\n    intern: HashMap<[u8], i64, ScopedArena>,\n    // a comment that is not closed: its start, else -1\n    open_comment: i64,\n}\n\nfn is_ident_start(c: u8) -> bool { (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' }\n\n");
        buf_str(out, c"fn is_ident_char(c: u8) -> bool { is_ident_start(c) || (c >= '0' && c <= '9') }\n\nfn is_hex(c: u8) -> bool {\n    (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')\n}\n\nfn is_dec(c: u8) -> bool { c >= '0' && c <= '9' }\n\nimpl Tokens {\n    pub fn sym(inout self, s: [u8]) -> i64 {\n        if let Some(h) = self.intern.get(s) {\n            return h;\n        }\n        let h = self.names.len();\n        self.names.push(s);\n        self.intern.insert(s, h);\n        h\n    }\n\n    fn push_token(inout self, k: u8, s: i64, e: i64, sym: i64) {\n        self.kinds.push(k);\n        self.starts.push(s);\n        self.ends.push(e);\n        self.syms.push(sym);\n    }\n}\n\n// The length of the number at src[i ..], and whether it is a float.\nfn number_len(src: [u8], i: i64) -> (i64, bool) {\n    let n = src.len;\n    var j = i;\n    var float = false;\n    if src[j] == '0' && j + 1 < n && (src[j + 1] == 'x' || src[j + 1] == 'X') {\n        j += 2;\n        while j < n && is_hex(src[j]) {\n            j += 1;\n        }\n        if j < n && src[j] == '.' {\n            float = true;\n            j += 1;\n            while j < n && is_hex(src[j]) {\n                j += 1;\n            }\n        }\n        if j < n && (src[j] == 'p' || src[j] == 'P') {\n            float = true;\n            j += 1;\n            if j < n && (src[j] == '+' || src[j] == '-') {\n                j += 1;\n            }\n            while j < n && is_dec(src[j]) {\n                j += 1;\n            }\n        }\n        if j < n && (src[j] == 'f' || src[j] == 'h') && float {\n            j += 1;\n        } else if j < n && (src[j] == 'i' || src[j] == 'u') && !float {\n            j += 1;\n        }\n        return (j - i, float);\n    }\n    while j < n && is_dec(src[j]) {\n        j += 1;\n    }\n    if j < n && src[j] == '.' && !(j + 1 < n && src[j + 1] == '.') {\n        float = true;\n        j += 1;\n        while j < n && is_dec(src[j]) {\n");
        buf_str(out, c"            j += 1;\n        }\n    }\n    if j < n && (src[j] == 'e' || src[j] == 'E') {\n        var k = j + 1;\n        if k < n && (src[k] == '+' || src[k] == '-') {\n            k += 1;\n        }\n        if k < n && is_dec(src[k]) {\n            float = true;\n            j = k;\n            while j < n && is_dec(src[j]) {\n                j += 1;\n            }\n        }\n    }\n    if j < n && (src[j] == 'f' || src[j] == 'h') {\n        float = true;\n        j += 1;\n    } else if j < n && (src[j] == 'i' || src[j] == 'u') && !float {\n        j += 1;\n    }\n    (j - i, float)\n}\n\npub fn lex(src: [u8], a: ScopedArena) -> Tokens {\n    var t = Tokens {\n        kinds: Vec::with_capacity_in(src.len / 3 + 16, a),\n        starts: Vec::with_capacity_in(src.len / 3 + 16, a),\n        ends: Vec::with_capacity_in(src.len / 3 + 16, a),\n        syms: Vec::with_capacity_in(src.len / 3 + 16, a),\n        names: Vec::with_capacity_in(512, a),\n        intern: HashMap::with_capacity_in(512, a),\n        open_comment: -1,\n    };\n    for i in 0..PREDECLARED.len() {\n        t.sym(PREDECLARED[i]);\n    }\n    let n = src.len;\n    var i = 0;\n    while i < n {\n        let c = src[i];\n        if c == ' ' || c == '\\n' || c == '\\t' || c == '\\r' || c == 11 || c == 12 {\n            i += 1;\n            continue;\n        }\n        if c == '/' && i + 1 < n && src[i + 1] == '/' {\n            while i < n && src[i] != '\\n' {\n                i += 1;\n            }\n            continue;\n        }\n        if c == '/' && i + 1 < n && src[i + 1] == '*' {\n            let start = i;\n            var depth = 1;\n            i += 2;\n            while i < n && depth > 0 {\n                if src[i] == '/' && i + 1 < n && src[i + 1] == '*' {\n                    depth += 1;\n                    i += 2;\n                } else if src[i] == '*' && i + 1 < n && src[i + 1] == '/' {\n                    depth -= 1;\n                    i += 2;\n                } else {\n");
        buf_str(out, c"                    i += 1;\n                }\n            }\n            if depth > 0 {\n                t.open_comment = start;\n            }\n            continue;\n        }\n        if is_ident_start(c) {\n            let s = i;\n            while i < n && is_ident_char(src[i]) {\n                i += 1;\n            }\n            if i - s == 1 && c == '_' {\n                t.push_token(T_UNDERSCORE, s, i, -1);\n            } else {\n                let sym = t.sym(src[s..i]);\n                t.push_token(T_IDENT, s, i, sym);\n            }\n            continue;\n        }\n        if is_dec(c) || (c == '.' && i + 1 < n && is_dec(src[i + 1])) {\n            let (len, float) = number_len(src, i);\n            t.push_token(if float { T_FLOAT } else { T_INT }, i, i + len, -1);\n            i += len;\n            continue;\n        }\n        let c1 = if i + 1 < n { src[i + 1] } else { 0 };\n        let c2 = if i + 2 < n { src[i + 2] } else { 0 };\n        var k = T_BAD;\n        var len = 1;\n        if c == '(' {\n            k = T_LPAREN;\n        } else if c == ')' {\n            k = T_RPAREN;\n        } else if c == '{' {\n            k = T_LBRACE;\n        } else if c == '}' {\n            k = T_RBRACE;\n        } else if c == '[' {\n            k = T_LBRACKET;\n        } else if c == ']' {\n            k = T_RBRACKET;\n        } else if c == ',' {\n            k = T_COMMA;\n        } else if c == ';' {\n            k = T_SEMI;\n        } else if c == ':' {\n            k = T_COLON;\n        } else if c == '.' {\n            k = T_DOT;\n        } else if c == '@' {\n            k = T_AT;\n        } else if c == '~' {\n            k = T_TILDE;\n        } else if c == '=' {\n            if c1 == '=' {\n                k = T_EQEQ;\n                len = 2;\n            } else {\n                k = T_EQ;\n            }\n        } else if c == '!' {\n            if c1 == '=' {\n                k = T_NE;\n                len = 2;\n            } else {\n");
        buf_str(out, c"                k = T_BANG;\n            }\n        } else if c == '<' {\n            if c1 == '<' && c2 == '=' {\n                k = T_SHLEQ;\n                len = 3;\n            } else if c1 == '<' {\n                k = T_SHL;\n                len = 2;\n            } else if c1 == '=' {\n                k = T_LE;\n                len = 2;\n            } else {\n                k = T_LT;\n            }\n        } else if c == '>' {\n            if c1 == '>' && c2 == '=' {\n                k = T_SHREQ;\n                len = 3;\n            } else if c1 == '>' {\n                k = T_SHR;\n                len = 2;\n            } else if c1 == '=' {\n                k = T_GE;\n                len = 2;\n            } else {\n                k = T_GT;\n            }\n        } else if c == '+' {\n            if c1 == '+' {\n                k = T_PLUSPLUS;\n                len = 2;\n            } else if c1 == '=' {\n                k = T_PLUSEQ;\n                len = 2;\n            } else {\n                k = T_PLUS;\n            }\n        } else if c == '-' {\n            if c1 == '>' {\n                k = T_ARROW;\n                len = 2;\n            } else if c1 == '-' {\n                k = T_MINUSMINUS;\n                len = 2;\n            } else if c1 == '=' {\n                k = T_MINUSEQ;\n                len = 2;\n            } else {\n                k = T_MINUS;\n            }\n        } else if c == '*' {\n            if c1 == '=' {\n                k = T_STAREQ;\n                len = 2;\n            } else {\n                k = T_STAR;\n            }\n        } else if c == '/' {\n            if c1 == '=' {\n                k = T_SLASHEQ;\n                len = 2;\n            } else {\n                k = T_SLASH;\n            }\n        } else if c == '%' {\n            if c1 == '=' {\n                k = T_PERCENTEQ;\n                len = 2;\n            } else {\n                k = T_PERCENT;\n            }\n");
        buf_str(out, c"        } else if c == '&' {\n            if c1 == '&' {\n                k = T_ANDAND;\n                len = 2;\n            } else if c1 == '=' {\n                k = T_AMPEQ;\n                len = 2;\n            } else {\n                k = T_AMP;\n            }\n        } else if c == '|' {\n            if c1 == '|' {\n                k = T_OROR;\n                len = 2;\n            } else if c1 == '=' {\n                k = T_PIPEEQ;\n                len = 2;\n            } else {\n                k = T_PIPE;\n            }\n        } else if c == '^' {\n            if c1 == '=' {\n                k = T_CARETEQ;\n                len = 2;\n            } else {\n                k = T_CARET;\n            }\n        }\n        t.push_token(k, i, i + len, -1);\n        i += len;\n    }\n    t.push_token(T_EOF, n, n, -1);\n    t\n}\n\n// How a token is written, for messages.\npub fn token_text(k: u8) -> [u8] {\n    if k == T_EOF {\n        \"the end of the file\"\n    } else if k == T_IDENT {\n        \"an identifier\"\n    } else if k == T_INT || k == T_FLOAT {\n        \"a number\"\n    } else if k == T_LPAREN {\n        \"'('\"\n    } else if k == T_RPAREN {\n        \"')'\"\n    } else if k == T_LBRACE {\n        \"'{'\"\n    } else if k == T_RBRACE {\n        \"'}'\"\n    } else if k == T_LBRACKET {\n        \"'['\"\n    } else if k == T_RBRACKET {\n        \"']'\"\n    } else if k == T_COMMA {\n        \"','\"\n    } else if k == T_SEMI {\n        \"';'\"\n    } else if k == T_COLON {\n        \"':'\"\n    } else if k == T_DOT {\n        \"'.'\"\n    } else if k == T_AT {\n        \"'@'\"\n    } else if k == T_ARROW {\n        \"'->'\"\n    } else if k == T_EQ {\n        \"'='\"\n    } else if k == T_LT {\n        \"'<'\"\n    } else if k == T_GT {\n        \"'>'\"\n    } else if k == T_UNDERSCORE {\n        \"'_'\"\n    } else if k == T_BAD {\n        \"a character WGSL does not use\"\n    } else {\n        \"an operator\"\n    }\n}\n");
        buf_str(out, c"// ---- end mod std::gpu::wgsl::lex ----\n}\n// ---- mod std::gpu::wgsl::front ----\npub mod front {\n// ---- Shader compiler implementation, front (0.22) ----\n// The WGSL front end: parsing, name resolution and type checking in one\n// pass from tokens to IR (docs/design/gpu.md §2.10), with no syntax tree\n// in between.\n//\n// - A skim finds the module-scope declarations (any order is allowed);\n//   types, constants and function signatures are resolved on demand from\n//   their tokens, function bodies in source order.\n// - Expressions are lowered as they are parsed: a `Val` is an IR\n//   expression, a reference (a pointer the Load Rule reads), or a\n//   constant (abstract numbers included) not yet in the IR.\n// - The first error stops the translation: it is recorded, and from then\n//   on every token reads as the end of the file, so the parse unwinds.\n\nuse ir::{\n    ACC_READ, ACC_RW, ACC_WRITE, BIND_BUILTIN, BIND_LOCATION, BIND_NONE, Binding, E_ARG,\n    E_CALL_RESULT, E_GLOBAL, E_LOCAL, Entry, Function, Global, INTERP_FLAT, INTERP_LINEAR,\n    INTERP_PERSPECTIVE, Local, Module, Param, SK_BOOL, SK_F32, SK_I32, SK_U32, SP_FUNCTION,\n    SP_HANDLE, SP_PRIVATE, SP_STORAGE, SP_UNIFORM, SP_WORKGROUP, STAGE_COMPUTE, STAGE_FRAGMENT,\n    STAGE_VERTEX, S_BLOCK, S_BREAK, S_CALL, S_CONTINUE, S_EMIT, S_IF, S_KILL, S_LOOP, S_RETURN,\n    S_STORE, S_SWITCH, StructMember, TK_ARRAY, TK_ATOMIC, TK_MATRIX, TK_POINTER, TK_SAMPLER,\n    TK_SCALAR, TK_STRUCT, TK_TEXTURE, TK_VECTOR, T_BOOL, T_F32, T_I32, T_U32, V, new_function,\n    no_binding,\n};\nuse lex::{\n    T_ARROW, T_AT, T_COLON, T_COMMA, T_EOF, T_EQ, T_GT, T_IDENT, T_LBRACE, T_LBRACKET, T_LPAREN,\n    T_LT, T_MINUSMINUS, T_PLUSPLUS, T_RBRACE, T_RBRACKET, T_RPAREN, T_SEMI, T_SHR, T_UNDERSCORE,\n    Tokens, token_text,\n};\nuse names::{\n    K_ALIAS, K_ALIGN, K_BINDING, K_BREAK, K_BUILTIN, K_CASE, K_CENTER, K_CENTROID, K_COMPUTE,\n");
        buf_str(out, c"    K_CONST, K_CONST_ASSERT, K_CONTINUE, K_CONTINUING, K_DEFAULT, K_DIAGNOSTIC, K_DISCARD, K_ELSE,\n    K_ENABLE, K_FLAT, K_FN, K_FOR, K_FRAGMENT, K_GROUP, K_ID, K_IF, K_INTERPOLATE, K_INVARIANT,\n    K_LET, K_LINEAR, K_LOCATION, K_LOOP, K_MUST_USE, K_OVERRIDE, K_PERSPECTIVE, K_REQUIRES,\n    K_RETURN, K_SAMPLE, K_SIZE, K_STRUCT, K_SWITCH, K_VAR, K_VERTEX, K_WHILE, K_WORKGROUP_SIZE,\n};\nuse std::{Buf, ScopedArena, Vec};\n\n// ---- Shader compiler implementation, front: Values (0.22) ----\n\n// an IR expression's value\npub const VK_VALUE: u8 = 0;\n// a reference: `e` is a pointer, read by the Load Rule where a value is needed\npub const VK_REF: u8 = 1;\n// a constant scalar not yet in the IR: iv (bool, integers) or fv (floats);\n// sk may be abstract; ty is its type, -1 when abstract\npub const VK_CONST: u8 = 2;\n// a module-scope or local name that is a type (in a constructor call)\npub const VK_TYPE: u8 = 3;\n// no value (a call of a function without a result)\npub const VK_VOID: u8 = 4;\n\npub struct Val { k: u8, sk: u8, e: i64, ty: i64, iv: i64, fv: f64 }\n\npub fn val(e: i64, ty: i64) -> Val { Val { k: VK_VALUE, sk: 0, e: e, ty: ty, iv: 0, fv: 0.0 } }\n\npub fn cint(sk: u8, ty: i64, v: i64) -> Val {\n    Val { k: VK_CONST, sk: sk, e: -1, ty: ty, iv: v, fv: 0.0 }\n}\n\npub fn cfloat(sk: u8, ty: i64, v: f64) -> Val {\n    Val { k: VK_CONST, sk: sk, e: -1, ty: ty, iv: 0, fv: v }\n}\n\n// ---- Shader compiler implementation, front: Declarations (0.22) ----\n\npub const D_FN: u8 = 0;\npub const D_STRUCT: u8 = 1;\npub const D_VAR: u8 = 2;\npub const D_CONST: u8 = 3;\npub const D_ALIAS: u8 = 4;\n\npub const DS_TODO: u8 = 0;\npub const DS_BUSY: u8 = 1;\npub const DS_DONE: u8 = 2;\n\n// tok: the token after the attributes (the keyword); attr: the first\n// attribute's token; h: the type, global or function once resolved; cv:\n// a constant's value once known (scalars)\npub struct Decl {\n");
        buf_str(out, c"    kind: u8, state: u8, sym: i64, tok: i64, attr: i64, h: i64, cv: Val, has_cv: bool\n}\n\n// A name in a function's scopes.\npub struct ScopeEntry { sym: i64, v: Val, mutable: bool }\n\npub struct Attrs {\n    stage: i64,\n    wg: [i64; 3],\n    group: i64,\n    binding: i64,\n    loc: i64,\n    builtin: i64,\n    interp: i64,\n    pos: i64,\n}\n\npub struct Front {\n    src: [u8],\n    tk: Tokens,\n    p: i64,\n    m: Module,\n    a: ScopedArena,\n    failed: bool,\n    err_code: [u8],\n    err_pos: i64,\n    emsg: Buf<ScopedArena>,\n    ehelp: Buf<ScopedArena>,\n    decls: V<Decl>,\n    // symbol -> its declaration, or -1\n    decl_of: V<i64>,\n    // the function being lowered\n    f: Function,\n    fh: i64,\n    pending: V<i64>,\n    emit_start: i64,\n    scopes: V<ScopeEntry>,\n    scope_floor: i64,\n    // global -> its E_GLOBAL in f, or -1\n    gexpr: V<i64>,\n    loop_depth: i64,\n    switch_depth: i64,\n    in_continuing: bool,\n    // the start of each loop's body scope (for `continuing`'s check)\n    // the stage of the entry point being lowered (255: a plain function)\n    stage: i64,\n    // the compare-exchange result types: [i32's, u32's], -1 until made\n    cmpxchg_ty: [i64; 2],\n    tmp: Buf<ScopedArena>,\n    // the expected type of the expression being parsed (for inferred\n    // constructors of abstract numbers), or -1\n    hint: i64,\n    // the token after the last call's `)`, and whether a statement was one\n    last_call_end: i64,\n    last_was_call: bool,\n    // call arguments being parsed, with their positions; lowered ones\n    astack: V<Val>,\n    apos: V<i64>,\n    estack: V<i64>,\n}\n\npub fn new_front(src: [u8], a: ScopedArena) -> Front {\n    let tk = lex::lex(src, a);\n    Front {\n        src: src,\n        tk: tk,\n        p: 0,\n        m: Module::new(a),\n        a: a,\n        failed: false,\n        err_code: \"\",\n        err_pos: 0,\n        emsg: Buf::new_in(a),\n        ehelp: Buf::new_in(a),\n");
        buf_str(out, c"        decls: Vec::new_in(a),\n        decl_of: Vec::new_in(a),\n        f: new_function(\"\", a),\n        fh: -1,\n        pending: Vec::new_in(a),\n        emit_start: 0,\n        scopes: Vec::new_in(a),\n        scope_floor: 0,\n        gexpr: Vec::new_in(a),\n        loop_depth: 0,\n        switch_depth: 0,\n        in_continuing: false,\n        stage: 255,\n        cmpxchg_ty: [-1, -1],\n        tmp: Buf::new_in(a),\n        hint: -1,\n        last_call_end: -1,\n        last_was_call: false,\n        astack: Vec::new_in(a),\n        apos: Vec::new_in(a),\n        estack: Vec::new_in(a),\n    }\n}\n\nimpl Front {\n    // ---- Errors ----\n\n    // Records an error at byte `pos` with `code`; true when it is the\n    // first (the caller then writes the message into emsg).\n    pub fn err(inout self, pos: i64, code: [u8]) -> bool {\n        if self.failed {\n            return false;\n        }\n        self.failed = true;\n        self.err_code = code;\n        self.err_pos = pos;\n        true\n    }\n\n    pub fn fail(inout self, pos: i64, code: [u8], msg: [u8]) {\n        if self.err(pos, code) {\n            self.emsg.push_str(msg);\n        }\n    }\n\n    pub fn help(inout self, h: [u8]) {\n        if self.ehelp.len() == 0 {\n            self.ehelp.push_str(h);\n        }\n    }\n\n    pub fn ty_str(inout self, t: i64) {\n        self.m.type_name(t, &self.emsg);\n    }\n\n    // The type of a value as WGSL writes it, into emsg.\n    pub fn val_str(inout self, v: Val) {\n        if v.k == VK_CONST && v.ty < 0 {\n            self.emsg.push_str(ir::scalar_name(v.sk));\n        } else if v.k == VK_REF {\n            self.emsg.push_str(\"ref to \");\n            self.ty_str(self.m.pointee(v.ty));\n        } else if v.k == VK_VOID {\n            self.emsg.push_str(\"nothing (a call without a result)\");\n        } else {\n            self.ty_str(v.ty);\n        }\n    }\n\n    // ---- Tokens ----\n\n    pub fn kind(self) -> u8 {\n        if self.failed {\n");
        buf_str(out, c"            T_EOF\n        } else {\n            self.tk.kinds[self.p]\n        }\n    }\n\n    pub fn kind_at(self, i: i64) -> u8 {\n        if self.failed || i >= self.tk.kinds.len() {\n            T_EOF\n        } else {\n            self.tk.kinds[i]\n        }\n    }\n\n    pub fn sym(self) -> i64 {\n        if self.failed {\n            -1\n        } else {\n            self.tk.syms[self.p]\n        }\n    }\n\n    pub fn pos(self) -> i64 { self.tk.starts[self.p] }\n\n    pub fn text(self, i: i64) -> [u8] { self.src[self.tk.starts[i]..self.tk.ends[i]] }\n\n    pub fn is_kw(self, k: i64) -> bool {\n        self.kind() == T_IDENT && self.tk.syms[self.p] == k\n    }\n\n    pub fn eat(inout self, k: u8) -> bool {\n        if self.kind() == k {\n            self.p += 1;\n            true\n        } else {\n            false\n        }\n    }\n\n    pub fn eat_kw(inout self, k: i64) -> bool {\n        if self.is_kw(k) {\n            self.p += 1;\n            true\n        } else {\n            false\n        }\n    }\n\n    pub fn expect(inout self, k: u8) {\n        if self.kind() == k {\n            self.p += 1;\n            return;\n        }\n        if self.failed {\n            return;\n        }\n        let got = self.kind();\n        if self.err(self.pos(), \"wgsl.syntax\") {\n            self.emsg.push_fmt(f\"expected {token_text(k)}, got \");\n            if got == T_IDENT {\n                self.emsg.push_fmt(f\"'{self.text(self.p)}'\");\n            } else {\n                self.emsg.push_str(token_text(got));\n            }\n        }\n    }\n\n    // `>` closing a template list; a `>>` token gives one `>` and leaves one.\n    pub fn expect_gt(inout self) {\n        if self.kind() == T_SHR {\n            self.tk.kinds[self.p] = T_GT;\n            self.tk.starts[self.p] += 1;\n            return;\n        }\n        self.expect(T_GT);\n    }\n\n    pub fn ident(inout self) -> i64 {\n        if self.kind() == T_IDENT {\n");
        buf_str(out, c"            let s = self.tk.syms[self.p];\n            self.p += 1;\n            return s;\n        }\n        self.expect(T_IDENT);\n        -1\n    }\n\n    pub fn name_of(self, sym: i64) -> [u8] {\n        if sym < 0 {\n            \"_\"\n        } else {\n            self.tk.names[sym]\n        }\n    }\n\n    // ---- Statements of the function being built ----\n\n    pub fn flush(inout self) {\n        let n = self.f.exprs.len();\n        if n > self.emit_start {\n            let s = self.f.stmt(S_EMIT, self.emit_start, n, 0, 0);\n            self.pending.push(s);\n            self.emit_start = n;\n        }\n    }\n\n    pub fn push_stmt(inout self, op: u8, a: i64, b: i64, c: i64, d: i64) -> i64 {\n        self.flush();\n        let s = self.f.stmt(op, a, b, c, d);\n        self.pending.push(s);\n        s\n    }\n\n    // An expression made outside every emit range (a call's result).\n    pub fn unemitted(inout self, op: u8, ty: i64) -> i64 {\n        self.flush();\n        let e = self.f.expr(op, ty, 0, 0, 0);\n        self.emit_start = self.f.exprs.len();\n        e\n    }\n\n    pub fn global_expr(inout self, g: i64) -> i64 {\n        if self.gexpr[g] >= 0 {\n            return self.gexpr[g];\n        }\n        let gl = self.m.globals[g];\n        let ty = if gl.space == SP_HANDLE { gl.ty }\n            else { self.m.ptr_ty(gl.ty, gl.space, gl.access) };\n        let e = self.f.expr(E_GLOBAL, ty, g, 0, 0);\n        self.gexpr[g] = e;\n        e\n    }\n\n    // ---- The module ----\n\n    // Finds every module-scope declaration, without resolving any.\n    fn skim(inout self) {\n        for _ in 0..self.tk.names.len() {\n            self.decl_of.push(-1);\n        }\n        while self.kind() != T_EOF {\n            let attr = self.p;\n            self.skip_attrs();\n            let tok = self.p;\n            if self.is_kw(K_ENABLE) || self.is_kw(K_REQUIRES) || self.is_kw(K_DIAGNOSTIC) {\n                let at = self.pos();\n");
        buf_str(out, c"                if self.is_kw(K_DIAGNOSTIC) {\n                    self.skip_to_semi();\n                    continue;\n                }\n                self.p += 1;\n                let what = self.text(self.p);\n                if self.err(at, \"wgsl.unsupported\") {\n                    self.emsg.push_fmt(\n                        f\"'{what}' is not in the WGSL subset of this release (no extensions)\");\n                    self.help(\"remove the directive; f16 and the other extensions come later\");\n                }\n                return;\n            }\n            if self.is_kw(K_CONST_ASSERT) {\n                self.fail(self.pos(), \"wgsl.unsupported\",\n                    \"'const_assert' is not in the WGSL subset of this release\");\n                return;\n            }\n            if self.is_kw(K_OVERRIDE) {\n                self.fail(self.pos(), \"wgsl.unsupported\",\n                    \"'override' constants are not in the WGSL subset of this release\");\n                self.help(\"use a 'const', or a uniform buffer\");\n                return;\n            }\n            if self.eat(T_SEMI) {\n                continue;\n            }\n            var kind = D_FN;\n            if self.is_kw(K_FN) {\n                kind = D_FN;\n            } else if self.is_kw(K_STRUCT) {\n                kind = D_STRUCT;\n            } else if self.is_kw(K_VAR) {\n                kind = D_VAR;\n            } else if self.is_kw(K_CONST) {\n                kind = D_CONST;\n            } else if self.is_kw(K_ALIAS) {\n                kind = D_ALIAS;\n            } else {\n                if self.kind() == T_IDENT && self.text(self.p) == \"let\" {\n                    self.fail(self.pos(), \"wgsl.syntax\", \"'let' is not allowed at module scope\");\n                    self.help(\"use 'const' for a module-scope constant\");\n                    return;\n                }\n                if self.err(self.pos(), \"wgsl.syntax\") {\n");
        buf_str(out, c"                    self.emsg.push_str(\n                        \"expected a declaration ('fn', 'struct', 'var', 'const', 'alias'), got \");\n                    if self.kind() == T_IDENT {\n                        self.emsg.push_fmt(f\"'{self.text(self.p)}'\");\n                    } else {\n                        self.emsg.push_str(token_text(self.kind()));\n                    }\n                }\n                return;\n            }\n            self.p += 1;\n            if kind == D_VAR && self.kind() == T_LT {\n                self.skip_template();\n            }\n            let at = self.pos();\n            let sym = self.ident();\n            if sym >= 0 {\n                if self.decl_of[sym] >= 0 {\n                    if self.err(at, \"wgsl.redefined\") {\n                        self.emsg.push_fmt(\n                            f\"'{self.name_of(sym)}' is declared twice at module scope\");\n                    }\n                    return;\n                }\n                self.decl_of[sym] = self.decls.len();\n            }\n            self.decls.push(Decl {\n                kind: kind, state: DS_TODO, sym: sym, tok: tok, attr: attr, h: -1,\n                cv: cint(0, -1, 0), has_cv: false\n            });\n            if kind == D_FN {\n                while self.kind() != T_LBRACE && self.kind() != T_EOF {\n                    self.p += 1;\n                }\n                self.skip_balanced();\n            } else if kind == D_STRUCT {\n                self.skip_balanced();\n                self.eat(T_SEMI);\n            } else {\n                self.skip_to_semi();\n            }\n        }\n    }\n\n    fn skip_attrs(inout self) {\n        while self.kind() == T_AT {\n            self.p += 1;\n            self.ident();\n            if self.kind() == T_LPAREN {\n                self.skip_balanced();\n            }\n        }\n    }\n\n    // Skips a bracketed group from its opening token.\n    fn skip_balanced(inout self) {\n");
        buf_str(out, c"        var depth = 0;\n        loop {\n            let k = self.kind();\n            if k == T_EOF {\n                return;\n            }\n            if k == T_LPAREN || k == T_LBRACE || k == T_LBRACKET {\n                depth += 1;\n            } else if k == T_RPAREN || k == T_RBRACE || k == T_RBRACKET {\n                depth -= 1;\n            }\n            self.p += 1;\n            if depth <= 0 {\n                return;\n            }\n        }\n    }\n\n    fn skip_template(inout self) {\n        var depth = 0;\n        loop {\n            let k = self.kind();\n            if k == T_EOF {\n                return;\n            }\n            if k == T_LT {\n                depth += 1;\n            } else if k == T_GT {\n                depth -= 1;\n            } else if k == T_SHR {\n                depth -= 2;\n            }\n            self.p += 1;\n            if depth <= 0 {\n                return;\n            }\n        }\n    }\n\n    fn skip_to_semi(inout self) {\n        while self.kind() != T_SEMI && self.kind() != T_EOF {\n            let k = self.kind();\n            if k == T_LPAREN || k == T_LBRACE || k == T_LBRACKET {\n                self.skip_balanced();\n            } else {\n                self.p += 1;\n            }\n        }\n        self.eat(T_SEMI);\n    }\n\n    // Resolves the whole module: types, globals, signatures, then bodies.\n    pub fn module(inout self) {\n        if self.tk.open_comment >= 0 {\n            self.fail(self.tk.open_comment, \"wgsl.syntax\", \"this block comment is not closed\");\n            return;\n        }\n        for i in 0..self.tk.kinds.len() {\n            if self.tk.kinds[i] == lex::T_BAD {\n                self.p = i;\n                if self.err(self.pos(), \"wgsl.syntax\") {\n                    self.emsg.push_fmt(f\"unexpected character '{self.text(i)}'\");\n                }\n                return;\n            }\n        }\n        self.skim();\n        if self.failed {\n");
        buf_str(out, c"            return;\n        }\n        // function handles, in declaration order\n        for i in 0..self.decls.len() {\n            if self.decls[i].kind == D_FN {\n                self.decls[i].h = self.m.functions.len();\n                let f = new_function(self.name_of(self.decls[i].sym), self.a);\n                self.m.functions.push(f);\n            }\n        }\n        self.f = std::replace(&self.m.consts, new_function(\"\", self.a));\n        for i in 0..self.decls.len() {\n            let k = self.decls[i].kind;\n            if k == D_STRUCT || k == D_ALIAS {\n                self.resolve_type_decl(i);\n            } else if k == D_VAR {\n                self.resolve_global(i);\n            } else if k == D_CONST {\n                self.const_value(i);\n            }\n            if self.failed {\n                return;\n            }\n        }\n        self.m.consts = std::replace(&self.f, new_function(\"\", self.a));\n        for i in 0..self.decls.len() {\n            if self.decls[i].kind == D_FN {\n                self.signature(i);\n            }\n            if self.failed {\n                return;\n            }\n        }\n        for i in 0..self.decls.len() {\n            if self.decls[i].kind == D_FN {\n                self.lower_fn(i);\n            }\n            if self.failed {\n                return;\n            }\n        }\n        self.check_calls();\n    }\n\n    // ---- Attributes ----\n\n    fn const_int_arg(inout self) -> i64 {\n        let at = self.pos();\n        let v = self.parse_expr();\n        if v.k != VK_CONST || v.sk == SK_F32 || v.sk == ir::SK_AFLOAT || v.sk == SK_BOOL {\n            self.fail(at, \"wgsl.type\", \"expected a constant integer\");\n            return 0;\n        }\n        v.iv\n    }\n\n    pub fn parse_attrs(inout self) -> Attrs {\n        var at = Attrs {\n            stage: -1, wg: [0, 0, 0], group: -1, binding: -1, loc: -1, builtin: -1, interp: -1,\n            pos: self.pos()\n        };\n");
        buf_str(out, c"        while self.kind() == T_AT {\n            self.p += 1;\n            let apos = self.pos();\n            let s = self.ident();\n            if s == K_VERTEX {\n                at.stage = STAGE_VERTEX as i64;\n            } else if s == K_FRAGMENT {\n                at.stage = STAGE_FRAGMENT as i64;\n            } else if s == K_COMPUTE {\n                at.stage = STAGE_COMPUTE as i64;\n            } else if s == K_WORKGROUP_SIZE {\n                self.expect(T_LPAREN);\n                at.wg = [1, 1, 1];\n                var i = 0;\n                while i < 3 && self.kind() != T_RPAREN && self.kind() != T_EOF {\n                    let p = self.pos();\n                    let n = self.const_int_arg();\n                    if n < 1 || n > 1024 {\n                        self.fail(p, \"wgsl.attr\", \"a workgroup size is 1 to 1024\");\n                    }\n                    at.wg[i] = n;\n                    i += 1;\n                    if !self.eat(T_COMMA) {\n                        break;\n                    }\n                }\n                self.expect(T_RPAREN);\n                if at.wg[0] * at.wg[1] * at.wg[2] > 1024 {\n                    self.fail(apos, \"wgsl.attr\", \"a workgroup has at most 1024 invocations\");\n                }\n            } else if s == K_GROUP || s == K_BINDING || s == K_LOCATION {\n                self.expect(T_LPAREN);\n                let p = self.pos();\n                let n = self.const_int_arg();\n                self.eat(T_COMMA);\n                self.expect(T_RPAREN);\n                if n < 0 {\n                    self.fail(p, \"wgsl.attr\", \"expected a non-negative integer\");\n                }\n                if s == K_GROUP {\n                    at.group = n;\n                } else if s == K_BINDING {\n                    at.binding = n;\n                } else {\n                    at.loc = n;\n                }\n            } else if s == K_BUILTIN {\n                self.expect(T_LPAREN);\n");
        buf_str(out, c"                let bp = self.pos();\n                let b = self.ident();\n                self.eat(T_COMMA);\n                self.expect(T_RPAREN);\n                if b >= names::K_POSITION && b <= names::K_NUM_WORKGROUPS {\n                    at.builtin = b - names::K_POSITION;\n                } else if self.err(bp, \"wgsl.attr\") {\n                    self.emsg.push_fmt(f\"unknown builtin value '{self.name_of(b)}'\");\n                }\n            } else if s == K_INTERPOLATE {\n                self.expect(T_LPAREN);\n                let ip = self.pos();\n                let k = self.ident();\n                if k == K_FLAT {\n                    at.interp = INTERP_FLAT as i64;\n                } else if k == K_LINEAR {\n                    at.interp = INTERP_LINEAR as i64;\n                } else if k == K_PERSPECTIVE {\n                    at.interp = INTERP_PERSPECTIVE as i64;\n                } else {\n                    self.fail(ip, \"wgsl.attr\", \"expected 'flat', 'linear' or 'perspective'\");\n                }\n                if self.eat(T_COMMA) && self.kind() == T_IDENT {\n                    let smp = self.ident();\n                    if smp != K_CENTER {\n                        if smp == K_CENTROID || smp == K_SAMPLE {\n                            self.fail(ip, \"wgsl.unsupported\",\n                                \"only 'center' sampling is in the WGSL subset of this release\");\n                        }\n                    }\n                    self.eat(T_COMMA);\n                }\n                self.expect(T_RPAREN);\n            } else if s == K_MUST_USE {\n            } else if s == K_INVARIANT || s == K_ALIGN || s == K_SIZE || s == K_ID {\n                if self.err(apos, \"wgsl.unsupported\") {\n                    self.emsg.push_fmt(\n                        f\"'@{self.name_of(s)}' is not in the WGSL subset of this release\");\n                }\n            } else if self.err(apos, \"wgsl.attr\") {\n");
        buf_str(out, c"                self.emsg.push_fmt(f\"unknown attribute '@{self.name_of(s)}'\");\n            }\n        }\n        at\n    }\n\n    fn binding_of(self, at: Attrs) -> Binding {\n        if at.builtin >= 0 {\n            return Binding { kind: BIND_BUILTIN, interp: INTERP_PERSPECTIVE, value: at.builtin };\n        }\n        if at.loc >= 0 {\n            let ip = if at.interp >= 0 { at.interp as u8 } else { INTERP_PERSPECTIVE };\n            return Binding { kind: BIND_LOCATION, interp: ip, value: at.loc };\n        }\n        no_binding()\n    }\n\n    // ---- Types ----\n\n    fn resolve_type_decl(inout self, d: i64) -> i64 {\n        let dd = self.decls[d];\n        if dd.state == DS_DONE {\n            return dd.h;\n        }\n        if dd.state == DS_BUSY {\n            self.p = dd.tok;\n            if self.err(self.pos(), \"wgsl.cycle\") {\n                self.emsg.push_fmt(f\"'{self.name_of(dd.sym)}' refers to itself\");\n            }\n            return T_I32;\n        }\n        self.decls[d].state = DS_BUSY;\n        let saved = self.p;\n        self.p = dd.tok + 2;\n        var h = T_I32;\n        if dd.kind == D_ALIAS {\n            self.expect(T_EQ);\n            h = self.parse_type();\n            self.eat(T_SEMI);\n        } else {\n            h = self.struct_body(dd.sym);\n        }\n        self.p = saved;\n        self.decls[d].state = DS_DONE;\n        self.decls[d].h = h;\n        h\n    }\n\n    fn struct_body(inout self, sym: i64) -> i64 {\n        self.expect(T_LBRACE);\n        var list: V<StructMember> = Vec::new_in(self.a);\n        while self.kind() != T_RBRACE && self.kind() != T_EOF {\n            let at = self.parse_attrs();\n            let mpos = self.pos();\n            let ms = self.ident();\n            self.expect(T_COLON);\n            let tpos = self.pos();\n            let ty = self.parse_type();\n            for i in 0..list.len() {\n                if list[i].name == self.name_of(ms) {\n");
        buf_str(out, c"                    if self.err(mpos, \"wgsl.redefined\") {\n                        self.emsg.push_fmt(f\"member '{self.name_of(ms)}' is declared twice\");\n                    }\n                }\n            }\n            if self.m.is_runtime_sized(ty) && self.kind() != T_RBRACE\n                && !(self.kind() == T_COMMA && self.kind_at(self.p + 1) == T_RBRACE) {\n                self.fail(tpos, \"wgsl.type\",\n                    \"a runtime-sized array must be the last member of a struct\");\n            }\n            if !self.storable(ty) {\n                if self.err(tpos, \"wgsl.type\") {\n                    self.emsg.push_str(\"a struct member cannot have type \");\n                    self.ty_str(ty);\n                }\n            }\n            list.push(StructMember {\n                name: self.name_of(ms), ty: ty, offset: 0, binding: self.binding_of(at)\n            });\n            if !self.eat(T_COMMA) {\n                break;\n            }\n        }\n        self.expect(T_RBRACE);\n        if list.len() == 0 {\n            self.fail(self.pos(), \"wgsl.type\", \"a struct has at least one member\");\n        }\n        let start = self.m.members.len();\n        for i in 0..list.len() {\n            self.m.members.push(list[i]);\n        }\n        self.m.struct_ty(self.name_of(sym), start, list.len())\n    }\n\n    // Whether values of t can live in memory (not pointers, textures, samplers).\n    pub fn storable(self, t: i64) -> bool {\n        let k = self.m.types[t].kind;\n        k != TK_POINTER && k != TK_TEXTURE && k != TK_SAMPLER\n    }\n\n    // An optional `<T>` after vecN / matCxR: T, else -1.\n    fn template_scalar(inout self) -> i64 {\n        if self.kind() != T_LT {\n            return -1;\n        }\n        self.p += 1;\n        let t = self.parse_type();\n        self.expect_gt();\n        t\n    }\n\n    // Whether the identifier at the cursor starts a type (for `T(...)`\n");
        buf_str(out, c"    // constructors and template lists in expressions).\n    pub fn is_type_name(self, s: i64) -> bool {\n        if s >= names::K_BOOL && s <= names::K_TEXTURE_STORAGE_2D_ARRAY {\n            return true;\n        }\n        if s >= 0 && self.decl_of[s] >= 0 {\n            let k = self.decls[self.decl_of[s]].kind;\n            return k == D_STRUCT || k == D_ALIAS;\n        }\n        false\n    }\n\n    pub fn parse_type(inout self) -> i64 {\n        let at = self.pos();\n        if self.kind() != T_IDENT {\n            self.expect(T_IDENT);\n            return T_I32;\n        }\n        let s = self.tk.syms[self.p];\n        self.p += 1;\n        if s == names::K_BOOL {\n            return T_BOOL;\n        }\n        if s == names::K_I32 {\n            return T_I32;\n        }\n        if s == names::K_U32 {\n            return T_U32;\n        }\n        if s == names::K_F32 {\n            return T_F32;\n        }\n        if s == names::K_F16 || (s >= names::K_VEC2H && s <= names::K_VEC4H) {\n            self.fail(at, \"wgsl.unsupported\", \"'f16' is not in the WGSL subset of this release\");\n            self.help(\"use f32\");\n            return T_F32;\n        }\n        if s >= names::K_VEC2 && s <= names::K_VEC4 {\n            let n = s - names::K_VEC2 + 2;\n            if self.kind() != T_LT {\n                self.fail(at, \"wgsl.type\",\n                    \"a vector type needs its component type, as in 'vec3<f32>' or 'vec3f'\");\n                return T_F32;\n            }\n            let c = self.template_scalar();\n            let k = self.m.types[c].kind;\n            if k != TK_SCALAR {\n                self.fail(at, \"wgsl.type\", \"a vector's components are bool, i32, u32 or f32\");\n                return T_F32;\n            }\n            return ir::vec_ty(self.m.types[c].scalar, n);\n        }\n        if s >= names::K_VEC2I && s <= names::K_VEC4F {\n            let i = s - names::K_VEC2I;\n");
        buf_str(out, c"            let sk = if i < 3 { SK_I32 } else if i < 6 { SK_U32 } else { SK_F32 };\n            return ir::vec_ty(sk, i % 3 + 2);\n        }\n        if s >= names::K_MAT2X2 && s <= names::K_MAT4X4F {\n            let i = (s - names::K_MAT2X2) % 9;\n            if s <= names::K_MAT4X4 {\n                if self.kind() != T_LT {\n                    self.fail(at, \"wgsl.type\",\n                        \"a matrix type needs its component type, as in 'mat4x4<f32>' or 'mat4x4f'\");\n                    return T_F32;\n                }\n                let c = self.template_scalar();\n                if c != T_F32 {\n                    self.fail(at, \"wgsl.type\",\n                        \"matrices have f32 components in the WGSL subset of this release\");\n                }\n            }\n            return ir::mat_ty(i / 3 + 2, i % 3 + 2);\n        }\n        if s == names::K_ARRAY {\n            if self.kind() != T_LT {\n                self.fail(at, \"wgsl.type\",\n                    \"an array type needs its element type, as in 'array<f32, 4>'\");\n                return T_I32;\n            }\n            self.p += 1;\n            let ep = self.pos();\n            let el = self.parse_type();\n            var n = 0;\n            if self.eat(T_COMMA) {\n                let np = self.pos();\n                let saved_f = self.save_scope_floor();\n                let v = self.parse_shift();\n                self.scope_floor = saved_f;\n                if v.k != VK_CONST || v.sk == SK_F32 || v.sk == ir::SK_AFLOAT || v.sk == SK_BOOL {\n                    self.fail(np, \"wgsl.type\", \"an array's length is a constant integer\");\n                    self.help(\n                        \"a runtime-sized array is written 'array<T>' and lives in a storage buffer\");\n                } else if v.iv < 1 {\n                    self.fail(np, \"wgsl.type\", \"an array's length is at least 1\");\n                } else {\n                    n = v.iv;\n                }\n");
        buf_str(out, c"            }\n            self.expect_gt();\n            if self.m.is_runtime_sized(el) {\n                self.fail(ep, \"wgsl.type\", \"an array's element cannot be runtime-sized\");\n            }\n            if !self.storable(el) {\n                self.fail(ep, \"wgsl.type\",\n                    \"an array's element cannot be a pointer, texture or sampler\");\n            }\n            return self.m.array_ty(el, n);\n        }\n        if s == names::K_ATOMIC {\n            self.expect(T_LT);\n            let c = self.parse_type();\n            self.expect_gt();\n            if c != T_I32 && c != T_U32 {\n                self.fail(at, \"wgsl.type\", \"an atomic holds an i32 or a u32\");\n                return self.m.atomic_ty(SK_U32);\n            }\n            return self.m.atomic_ty(self.m.types[c].scalar);\n        }\n        if s == names::K_PTR {\n            self.expect(T_LT);\n            let sp = self.address_space();\n            self.expect(T_COMMA);\n            let t = self.parse_type();\n            var acc = if sp == SP_STORAGE || sp == SP_UNIFORM { ACC_READ } else { ACC_RW };\n            if self.eat(T_COMMA) {\n                acc = self.access_mode();\n            }\n            self.expect_gt();\n            if sp != SP_FUNCTION && sp != SP_PRIVATE {\n                // pointers to other spaces are values only (lets), never parameters\n            }\n            return self.m.ptr_ty(t, sp, acc);\n        }\n        if s == names::K_SAMPLER {\n            return self.m.intern(TK_SAMPLER, 0, 0, 0, -1, 0, 0);\n        }\n        if s == names::K_SAMPLER_COMPARISON {\n            return self.m.intern(TK_SAMPLER, 0, 1, 0, -1, 0, 0);\n        }\n        if s == names::K_TEXTURE_2D || s == names::K_TEXTURE_2D_ARRAY {\n            self.expect(T_LT);\n            let c = self.parse_type();\n            self.expect_gt();\n            if c != T_F32 && c != T_I32 && c != T_U32 {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.type\", \"a texture's sampled type is f32, i32 or u32\");\n            }\n            let dim = if s == names::K_TEXTURE_2D { ir::TEX_2D } else { ir::TEX_2D_ARRAY };\n            return self.m.intern(TK_TEXTURE, self.m.types[c].scalar, dim, 0, -1, 0, 0);\n        }\n        if s == names::K_TEXTURE_DEPTH_2D {\n            return self.m.intern(TK_TEXTURE, SK_F32, ir::TEX_DEPTH_2D, 0, -1, 0, 0);\n        }\n        if s == names::K_TEXTURE_STORAGE_2D {\n            self.expect(T_LT);\n            let fp = self.pos();\n            let f = self.ident();\n            var fmt = 0;\n            if f >= names::K_RGBA8UNORM && f <= names::K_RGBA32UINT {\n                fmt = f - names::K_RGBA8UNORM;\n            } else {\n                self.fail(fp, \"wgsl.unsupported\", \"storage textures in this release are rgba8unorm, rgba32float, r32float, r32uint, r32sint or rgba32uint\");\n            }\n            self.expect(T_COMMA);\n            let ap = self.pos();\n            let acc = self.access_mode();\n            if acc != ACC_WRITE {\n                self.fail(ap, \"wgsl.unsupported\",\n                    \"storage textures are write-only in this release\");\n            }\n            self.expect_gt();\n            let sk = if fmt == ir::FMT_R32UINT || fmt == ir::FMT_RGBA32UINT {\n                SK_U32\n            } else if fmt == ir::FMT_R32SINT {\n                SK_I32\n            } else {\n                SK_F32\n            };\n            return self.m.intern(TK_TEXTURE, sk, ir::TEX_STORAGE_2D, fmt, -1, 0, ACC_WRITE);\n        }\n        if s >= names::K_TEXTURE_1D && s <= names::K_TEXTURE_STORAGE_2D_ARRAY {\n            if self.err(at, \"wgsl.unsupported\") {\n                self.emsg.push_fmt(\n                    f\"'{self.name_of(s)}' is not in the WGSL subset of this release\");\n                self.help(\"2D textures are: texture_2d, texture_2d_array, texture_depth_2d, texture_storage_2d\");\n            }\n");
        buf_str(out, c"            return T_F32;\n        }\n        if self.decl_of[s] >= 0 {\n            let d = self.decl_of[s];\n            let k = self.decls[d].kind;\n            if k == D_STRUCT || k == D_ALIAS {\n                return self.resolve_type_decl(d);\n            }\n            if self.err(at, \"wgsl.type\") {\n                self.emsg.push_fmt(f\"'{self.name_of(s)}' is not a type\");\n            }\n            return T_I32;\n        }\n        if self.err(at, \"wgsl.name\") {\n            self.emsg.push_fmt(f\"unknown type '{self.name_of(s)}'\");\n            self.help(\"the types are bool, i32, u32, f32, vecN<T>, matCxR<f32>, array<T, N>, atomic<T>, structs\");\n        }\n        T_I32\n    }\n\n    fn address_space(inout self) -> u8 {\n        let at = self.pos();\n        let s = self.ident();\n        if s == names::K_FUNCTION {\n            SP_FUNCTION\n        } else if s == names::K_PRIVATE {\n            SP_PRIVATE\n        } else if s == names::K_WORKGROUP {\n            SP_WORKGROUP\n        } else if s == names::K_UNIFORM {\n            SP_UNIFORM\n        } else if s == names::K_STORAGE {\n            SP_STORAGE\n        } else {\n            if self.err(at, \"wgsl.syntax\") {\n                self.emsg.push_fmt(f\"unknown address space '{self.name_of(s)}'\");\n                self.help(\"the address spaces are function, private, workgroup, uniform, storage\");\n            }\n            SP_PRIVATE\n        }\n    }\n\n    fn access_mode(inout self) -> u8 {\n        let at = self.pos();\n        let s = self.ident();\n        if s == names::K_READ {\n            ACC_READ\n        } else if s == names::K_WRITE {\n            ACC_WRITE\n        } else if s == names::K_READ_WRITE {\n            ACC_RW\n        } else {\n            if self.err(at, \"wgsl.syntax\") {\n                self.emsg.push_fmt(f\"unknown access mode '{self.name_of(s)}'\");\n            }\n            ACC_READ\n        }\n    }\n\n    // ---- Globals and constants ----\n\n");
        buf_str(out, c"    fn resolve_global(inout self, d: i64) {\n        let dd = self.decls[d];\n        let saved = self.p;\n        self.p = dd.attr;\n        let at = self.parse_attrs();\n        self.p = dd.tok + 1;\n        var sp = SP_HANDLE;\n        var acc = ACC_READ;\n        var explicit_space = false;\n        if self.eat(T_LT) {\n            explicit_space = true;\n            sp = self.address_space();\n            acc = if sp == SP_STORAGE || sp == SP_UNIFORM { ACC_READ } else { ACC_RW };\n            if self.eat(T_COMMA) {\n                let ap = self.pos();\n                acc = self.access_mode();\n                if sp != SP_STORAGE {\n                    self.fail(ap, \"wgsl.type\", \"only storage variables have an access mode\");\n                }\n                if acc == ACC_WRITE {\n                    self.fail(ap, \"wgsl.type\", \"storage variables are 'read' or 'read_write'\");\n                }\n            }\n            self.expect_gt();\n        }\n        let npos = self.pos();\n        self.ident();\n        var ty = T_I32;\n        var have_ty = false;\n        if self.eat(T_COLON) {\n            ty = self.parse_type();\n            have_ty = true;\n        }\n        var init = -1;\n        if self.eat(T_EQ) {\n            let ip = self.pos();\n            if sp != SP_PRIVATE {\n                self.fail(ip, \"wgsl.type\",\n                    \"only 'var<private>' may have an initializer at module scope\");\n            }\n            let v = self.parse_expr_hint(if have_ty { ty } else { -1 });\n            if !have_ty {\n                ty = self.concrete_type_of(v);\n                have_ty = true;\n            }\n            init = self.materialize(v, ty, ip);\n            if !self.is_const_expr(init) {\n                self.fail(ip, \"wgsl.type\",\n                    \"a module-scope initializer must be a constant expression\");\n            }\n        }\n        self.eat(T_SEMI);\n        if !have_ty {\n");
        buf_str(out, c"            self.fail(npos, \"wgsl.type\", \"a module-scope 'var' needs a type\");\n        }\n        let tk = self.m.types[ty].kind;\n        if !explicit_space {\n            if tk != TK_TEXTURE && tk != TK_SAMPLER {\n                self.fail(npos, \"wgsl.type\", \"a module-scope 'var' needs an address space, as in 'var<private>' or 'var<storage, read_write>'\");\n            }\n        } else if tk == TK_TEXTURE || tk == TK_SAMPLER {\n            self.fail(npos, \"wgsl.type\", \"a texture or sampler is declared without an address space: 'var t: texture_2d<f32>;'\");\n        }\n        if sp == SP_UNIFORM || sp == SP_STORAGE || sp == SP_HANDLE {\n            if at.group < 0 || at.binding < 0 {\n                self.fail(npos, \"wgsl.binding\", \"a resource needs '@group(G) @binding(B)'\");\n            }\n        } else if at.group >= 0 || at.binding >= 0 {\n            self.fail(npos, \"wgsl.binding\",\n                \"only uniform, storage, texture and sampler variables have a group and binding\");\n        }\n        if sp == SP_UNIFORM && self.m.is_runtime_sized(ty) {\n            self.fail(npos, \"wgsl.type\", \"a uniform buffer cannot hold a runtime-sized array\");\n        }\n        if sp != SP_STORAGE && self.m.is_runtime_sized(ty) {\n            self.fail(npos, \"wgsl.type\", \"a runtime-sized array lives only in a storage buffer\");\n        }\n        if self.m.has_atomic(ty) && sp != SP_STORAGE && sp != SP_WORKGROUP {\n            self.fail(npos, \"wgsl.type\", \"atomics live in storage or workgroup memory\");\n        }\n        if self.m.has_atomic(ty) && sp == SP_STORAGE && acc != ACC_RW {\n            self.fail(npos, \"wgsl.type\", \"atomics need 'var<storage, read_write>'\");\n        }\n        if (sp == SP_UNIFORM || sp == SP_STORAGE) && !self.host_shareable(ty) {\n            self.fail(npos, \"wgsl.type\", \"a buffer's type cannot hold bool, pointers or textures\");\n        }\n        if sp == SP_UNIFORM {\n");
        buf_str(out, c"            self.check_uniform_layout(ty, npos);\n        }\n        for i in 0..self.m.globals.len() {\n            let o = self.m.globals[i];\n            if o.group >= 0 && o.group == at.group && o.binding == at.binding {\n                if self.err(npos, \"wgsl.binding\") {\n                    self.emsg.push_fmt(\n                        f\"@group({at.group}) @binding({at.binding}) is also '{o.name}'\");\n                }\n            }\n        }\n        let g = Global {\n            name: self.name_of(dd.sym),\n            space: sp,\n            access: acc,\n            ty: ty,\n            group: at.group,\n            binding: at.binding,\n            init: init,\n            pos: npos,\n        };\n        self.m.globals.push(g);\n        self.decls[d].h = self.m.globals.len() - 1;\n        self.decls[d].state = DS_DONE;\n        self.p = saved;\n    }\n\n    pub fn host_shareable(self, t: i64) -> bool {\n        let ty = self.m.types[t];\n        if ty.kind == TK_SCALAR || ty.kind == TK_VECTOR {\n            return ty.scalar != SK_BOOL;\n        }\n        if ty.kind == TK_MATRIX || ty.kind == TK_ATOMIC {\n            return true;\n        }\n        if ty.kind == TK_ARRAY {\n            return self.host_shareable(ty.base);\n        }\n        if ty.kind == TK_STRUCT {\n            for i in ty.mstart..ty.mstart + ty.mcount {\n                if !self.host_shareable(self.m.members[i].ty) {\n                    return false;\n                }\n            }\n            return true;\n        }\n        false\n    }\n\n    // The uniform address space's extra rules: array strides and struct\n    // alignments are multiples of 16.\n    fn check_uniform_layout(inout self, t: i64, pos: i64) {\n        let ty = self.m.types[t];\n        if ty.kind == TK_ARRAY {\n            if ty.stride % 16 != 0 {\n                if self.err(pos, \"wgsl.layout\") {\n                    self.emsg.push_str(\n");
        buf_str(out, c"                        \"in a uniform buffer an array's stride is a multiple of 16; \");\n                    self.ty_str(t);\n                    self.emsg.push_fmt(f\" has {ty.stride}\");\n                    self.help(\"use vec4 elements, or a storage buffer\");\n                }\n            }\n            self.check_uniform_layout(ty.base, pos);\n        } else if ty.kind == TK_STRUCT {\n            for i in ty.mstart..ty.mstart + ty.mcount {\n                let mt = self.m.members[i].ty;\n                let mk = self.m.types[mt].kind;\n                if mk == TK_STRUCT && i > ty.mstart {\n                    let prev = self.m.members[i - 1];\n                    let prev_end = prev.offset + self.m.types[prev.ty].size;\n                    if self.m.members[i].offset - prev_end < 0\n                        || self.m.members[i].offset % 16 != 0 {\n                        if self.err(pos, \"wgsl.layout\") {\n                            self.emsg.push_fmt(\n                                f\"in a uniform buffer the struct member '{self.m.members[i].name}' must start at a multiple of 16\");\n                        }\n                    }\n                }\n                self.check_uniform_layout(mt, pos);\n            }\n        }\n    }\n\n    // A constant's value, evaluated once when it is a scalar; composites\n    // are re-made at each use, in the using function.\n    pub fn const_value(inout self, d: i64) -> Val {\n        let dd = self.decls[d];\n        if dd.has_cv {\n            return dd.cv;\n        }\n        if dd.state == DS_BUSY {\n            self.p = dd.tok;\n            if self.err(self.pos(), \"wgsl.cycle\") {\n                self.emsg.push_fmt(f\"'{self.name_of(dd.sym)}' refers to itself\");\n            }\n            return cint(ir::SK_AINT, -1, 0);\n        }\n        self.decls[d].state = DS_BUSY;\n        let saved = self.p;\n        let saved_floor = self.save_scope_floor();\n        self.p = dd.tok + 2;\n        var ty = -1;\n");
        buf_str(out, c"        if self.eat(T_COLON) {\n            ty = self.parse_type();\n        }\n        self.expect(T_EQ);\n        let ip = self.pos();\n        var v = self.parse_expr_hint(ty);\n        if ty >= 0 {\n            v = self.convert_to(v, ty, ip);\n        }\n        if v.k == VK_REF {\n            self.fail(ip, \"wgsl.type\", \"a 'const' is a constant expression; this reads memory\");\n        } else if v.k == VK_VALUE && !self.is_const_expr(v.e) {\n            self.fail(ip, \"wgsl.type\", \"a 'const' is a constant expression\");\n        }\n        self.scope_floor = saved_floor;\n        self.p = saved;\n        self.decls[d].state = DS_DONE;\n        if v.k == VK_CONST {\n            self.decls[d].cv = v;\n            self.decls[d].has_cv = true;\n        }\n        v\n    }\n\n    // Lookups see only module-scope names until the floor is restored.\n    pub fn save_scope_floor(inout self) -> i64 {\n        let s = self.scope_floor;\n        self.scope_floor = self.scopes.len();\n        s\n    }\n\n    // Whether e is made of literals, zero values and compositions only.\n    pub fn is_const_expr(self, e: i64) -> bool {\n        if e < 0 {\n            return true;\n        }\n        let x = self.f.exprs[e];\n        if x.op == ir::E_LITERAL || x.op == ir::E_ZERO {\n            return true;\n        }\n        if x.op == ir::E_COMPOSE {\n            for i in x.a..x.a + x.b {\n                if !self.is_const_expr(self.f.args[i]) {\n                    return false;\n                }\n            }\n            return true;\n        }\n        if x.op == ir::E_SPLAT {\n            return self.is_const_expr(x.a);\n        }\n        false\n    }\n\n    // ---- Functions ----\n\n    fn signature(inout self, d: i64) {\n        let dd = self.decls[d];\n        let h = dd.h;\n        let saved = self.p;\n        self.p = dd.tok + 2;\n        self.expect(T_LPAREN);\n        var params: V<Param> = Vec::new_in(self.a);\n");
        buf_str(out, c"        while self.kind() != T_RPAREN && self.kind() != T_EOF {\n            let at = self.parse_attrs();\n            let ppos = self.pos();\n            let ps = self.ident();\n            self.expect(T_COLON);\n            let tp = self.pos();\n            let ty = self.parse_type();\n            let tk = self.m.types[ty].kind;\n            if tk == TK_POINTER {\n                let sp = self.m.types[ty].space;\n                if sp != SP_FUNCTION && sp != SP_PRIVATE {\n                    self.fail(tp, \"wgsl.unsupported\", \"pointer parameters are 'ptr<function, T>' or 'ptr<private, T>' in this release\");\n                }\n            } else if self.m.is_runtime_sized(ty) || self.m.has_atomic(ty) {\n                self.fail(tp, \"wgsl.type\",\n                    \"a parameter cannot hold a runtime-sized array or an atomic\");\n            }\n            for i in 0..params.len() {\n                if params[i].name == self.name_of(ps) {\n                    if self.err(ppos, \"wgsl.redefined\") {\n                        self.emsg.push_fmt(f\"parameter '{self.name_of(ps)}' is declared twice\");\n                    }\n                }\n            }\n            params.push(Param { name: self.name_of(ps), ty: ty, binding: self.binding_of(at) });\n            if !self.eat(T_COMMA) {\n                break;\n            }\n        }\n        self.expect(T_RPAREN);\n        var result = -1;\n        var rb = no_binding();\n        if self.eat(T_ARROW) {\n            let at = self.parse_attrs();\n            let rp = self.pos();\n            result = self.parse_type();\n            rb = self.binding_of(at);\n            if !self.storable(result) || self.m.is_runtime_sized(result)\n                || self.m.has_atomic(result) {\n                self.fail(rp, \"wgsl.type\", \"a function cannot return a pointer, texture, sampler, atomic or runtime-sized array\");\n            }\n        }\n        self.m.functions[h].params = params;\n");
        buf_str(out, c"        self.m.functions[h].result = result;\n        self.m.functions[h].result_binding = rb;\n        self.m.functions[h].pos = self.tk.starts[dd.tok + 1];\n        // entry point?\n        self.p = dd.attr;\n        let at = self.parse_attrs();\n        if at.stage >= 0 {\n            if at.stage == STAGE_COMPUTE as i64 && at.wg[0] == 0 {\n                self.fail(self.tk.starts[dd.tok + 1], \"wgsl.entry\",\n                    \"a compute entry point needs '@workgroup_size(X, Y, Z)'\");\n                self.help(\"for example '@compute @workgroup_size(64)'\");\n            }\n            let wg = if at.stage == STAGE_COMPUTE as i64 { at.wg } else { [0, 0, 0] };\n            self.m.entries.push(Entry {\n                stage: at.stage as u8, name: self.name_of(dd.sym), func: h, wg: wg,\n                early_depth: false\n            });\n            entry::check_interface(&self, self.m.entries.len() - 1);\n        } else if at.wg[0] != 0 {\n            self.fail(at.pos, \"wgsl.attr\", \"'@workgroup_size' belongs to a '@compute' entry point\");\n        }\n        self.p = saved;\n    }\n\n    fn lower_fn(inout self, d: i64) {\n        let dd = self.decls[d];\n        let h = dd.h;\n        self.fh = h;\n        self.f = std::replace(&self.m.functions[h], new_function(\"\", self.a));\n        self.stage = 255;\n        for i in 0..self.m.entries.len() {\n            if self.m.entries[i].func == h {\n                self.stage = self.m.entries[i].stage as i64;\n            }\n        }\n        self.gexpr.clear();\n        for _ in 0..self.m.globals.len() {\n            self.gexpr.push(-1);\n        }\n        self.scopes.clear();\n        self.scope_floor = 0;\n        self.pending.clear();\n        self.emit_start = 0;\n        self.loop_depth = 0;\n        self.switch_depth = 0;\n        self.in_continuing = false;\n        // the parameters\n        self.p = dd.tok + 2;\n        self.expect(T_LPAREN);\n        var i = 0;\n");
        buf_str(out, c"        while self.kind() != T_RPAREN && self.kind() != T_EOF {\n            self.parse_attrs();\n            let ps = self.ident();\n            self.expect(T_COLON);\n            self.parse_type();\n            let ty = self.f.params[i].ty;\n            let e = self.f.expr(E_ARG, ty, i, 0, 0);\n            self.f.names[e] = self.name_of(ps);\n            self.scopes.push(ScopeEntry { sym: ps, v: val(e, ty), mutable: false });\n            i += 1;\n            if !self.eat(T_COMMA) {\n                break;\n            }\n        }\n        self.expect(T_RPAREN);\n        if self.eat(T_ARROW) {\n            self.parse_attrs();\n            self.parse_type();\n        }\n        let bpos = self.pos();\n        self.expect(T_LBRACE);\n        let base = self.pending.len();\n        self.statements();\n        let end = self.pos();\n        self.expect(T_RBRACE);\n        self.flush();\n        if self.f.result >= 0 && !self.block_returns(base) {\n            if self.err(end, \"wgsl.return\") {\n                self.emsg.push_fmt(\n                    f\"function '{self.f.name}' can reach its end without returning a value\");\n                self.help(\"end it with a 'return'\");\n            }\n        }\n        let _ = bpos;\n        self.f.body = self.f.block_of(&self.pending, base);\n        self.m.functions[h] = std::replace(&self.f, new_function(\"\", self.a));\n    }\n\n    // Whether the statements pending[from ..] always return (or discard).\n    fn block_returns(self, from: i64) -> bool {\n        for i in from..self.pending.len() {\n            if self.stmt_returns(self.pending[i]) {\n                return true;\n            }\n        }\n        false\n    }\n\n    fn list_returns(self, blk: i64) -> bool {\n        let b = self.f.blocks[blk];\n        for i in b.start..b.start + b.count {\n            if self.stmt_returns(self.f.items[i]) {\n                return true;\n            }\n        }\n        false\n    }\n\n");
        buf_str(out, c"    fn stmt_returns(self, s: i64) -> bool {\n        let st = self.f.stmts[s];\n        if st.op == S_RETURN || st.op == S_KILL {\n            return true;\n        }\n        if st.op == S_BLOCK {\n            return self.list_returns(st.a);\n        }\n        if st.op == S_IF {\n            return self.list_returns(st.b) && self.list_returns(st.c);\n        }\n        if st.op == S_SWITCH {\n            for i in st.b..st.b + st.c {\n                if !self.list_returns(self.f.cases[i].body) {\n                    return false;\n                }\n            }\n            return true;\n        }\n        if st.op == S_LOOP {\n            // a loop without a break of its own never ends but by returning\n            return !self.has_break(st.a, 0) && !self.has_break(st.b, 0) && st.c < 0;\n        }\n        false\n    }\n\n    fn has_break(self, blk: i64, depth: i64) -> bool {\n        let b = self.f.blocks[blk];\n        for i in b.start..b.start + b.count {\n            let st = self.f.stmts[self.f.items[i]];\n            if st.op == S_BREAK && depth == 0 {\n                return true;\n            }\n            if st.op == S_BLOCK && self.has_break(st.a, depth) {\n                return true;\n            }\n            if st.op == S_IF && (self.has_break(st.b, depth) || self.has_break(st.c, depth)) {\n                return true;\n            }\n            if st.op == S_SWITCH {\n                for k in st.b..st.b + st.c {\n                    if self.has_break(self.f.cases[k].body, depth + 1) {\n                        return true;\n                    }\n                }\n            }\n            if st.op == S_LOOP\n                && (self.has_break(st.a, depth + 1) || self.has_break(st.b, depth + 1)) {\n                return true;\n            }\n        }\n        false\n    }\n\n    // No recursion: WGSL's call graph is acyclic.\n    fn check_calls(inout self) {\n        let n = self.m.functions.len();\n");
        buf_str(out, c"        var state: V<u8> = Vec::filled_in(n, 0u8, self.a);\n        for i in 0..n {\n            if !self.visit_calls(i, &state) {\n                return;\n            }\n        }\n        for e in 0..self.m.entries.len() {\n            let fh = self.m.entries[e].func;\n            for i in 0..n {\n                for s in 0..self.m.functions[i].stmts.len() {\n                    let st = self.m.functions[i].stmts[s];\n                    if st.op == S_CALL && st.a == fh {\n                        let pos = self.m.functions[i].pos;\n                        if self.err(pos, \"wgsl.call\") {\n                            self.emsg.push('\\'');\n                            self.emsg.push_str(self.m.functions[i].name);\n                            self.emsg.push_str(\"' calls the entry point '\");\n                            self.emsg.push_str(self.m.entries[e].name);\n                            self.emsg.push('\\'');\n                        }\n                        return;\n                    }\n                }\n            }\n        }\n    }\n\n    fn visit_calls(inout self, i: i64, state: inout V<u8>) -> bool {\n        if state[i] == 2 {\n            return true;\n        }\n        if state[i] == 1 {\n            let pos = self.m.functions[i].pos;\n            if self.err(pos, \"wgsl.recursion\") {\n                self.emsg.push('\\'');\n                self.emsg.push_str(self.m.functions[i].name);\n                self.emsg.push_str(\"' calls itself, directly or through other functions\");\n                self.help(\"WGSL has no recursion: write it as a loop\");\n            }\n            return false;\n        }\n        state[i] = 1;\n        for s in 0..self.m.functions[i].stmts.len() {\n            let st = self.m.functions[i].stmts[s];\n            if st.op == S_CALL {\n                if !self.visit_calls(st.a, &state) {\n                    return false;\n                }\n            }\n        }\n        state[i] = 2;\n        true\n    }\n\n");
        buf_str(out, c"    // ---- Statements ----\n\n    fn lookup(self, sym: i64) -> i64 {\n        var i = self.scopes.len() - 1;\n        while i >= self.scope_floor {\n            if self.scopes[i].sym == sym {\n                return i;\n            }\n            i -= 1;\n        }\n        -1\n    }\n\n    fn statements(inout self) {\n        while self.kind() != T_RBRACE && self.kind() != T_EOF {\n            if self.in_continuing_end() {\n                return;\n            }\n            self.statement();\n        }\n    }\n\n    // In a loop body, `continuing` ends the body.\n    fn in_continuing_end(self) -> bool { self.is_kw(K_CONTINUING) && self.loop_depth > 0 }\n\n    // A `{ ... }` block with a scope of its own: its block handle.\n    fn compound(inout self) -> i64 {\n        self.flush();\n        let base = self.pending.len();\n        let scope = self.scopes.len();\n        self.expect(T_LBRACE);\n        self.statements_plain();\n        self.expect(T_RBRACE);\n        self.flush();\n        self.scopes.truncate(scope);\n        self.f.block_of(&self.pending, base)\n    }\n\n    fn statements_plain(inout self) {\n        while self.kind() != T_RBRACE && self.kind() != T_EOF {\n            self.statement();\n        }\n    }\n\n    fn statement(inout self) {\n        let at = self.pos();\n        let k = self.kind();\n        if k == T_SEMI {\n            self.p += 1;\n            return;\n        }\n        if k == T_LBRACE {\n            let b = self.compound();\n            self.push_stmt(S_BLOCK, b, 0, 0, 0);\n            return;\n        }\n        if k == T_AT {\n            self.fail(at, \"wgsl.unsupported\",\n                \"attributes on statements are not in the WGSL subset of this release\");\n            return;\n        }\n        if k == T_IDENT {\n            let s = self.tk.syms[self.p];\n            if s == K_LET || s == K_CONST {\n                self.p += 1;\n                self.let_decl(s == K_CONST);\n                self.expect(T_SEMI);\n");
        buf_str(out, c"                return;\n            }\n            if s == K_VAR {\n                self.p += 1;\n                self.var_decl();\n                self.expect(T_SEMI);\n                return;\n            }\n            if s == K_IF {\n                self.p += 1;\n                self.if_stmt();\n                return;\n            }\n            if s == K_RETURN {\n                self.p += 1;\n                self.return_stmt(at);\n                self.expect(T_SEMI);\n                return;\n            }\n            if s == K_LOOP {\n                self.p += 1;\n                self.loop_stmt();\n                return;\n            }\n            if s == K_FOR {\n                self.p += 1;\n                self.for_stmt();\n                return;\n            }\n            if s == K_WHILE {\n                self.p += 1;\n                self.while_stmt();\n                return;\n            }\n            if s == K_SWITCH {\n                self.p += 1;\n                self.switch_stmt(at);\n                return;\n            }\n            if s == K_BREAK {\n                self.p += 1;\n                if self.is_kw(K_IF) {\n                    self.fail(at, \"wgsl.syntax\",\n                        \"'break if' is the last statement of a 'continuing' block\");\n                    return;\n                }\n                if self.loop_depth == 0 && self.switch_depth == 0 {\n                    self.fail(at, \"wgsl.syntax\", \"'break' outside a loop or switch\");\n                } else if self.in_continuing && self.switch_depth == 0 {\n                    self.fail(at, \"wgsl.syntax\",\n                        \"'break' in 'continuing'; end it with 'break if COND;'\");\n                }\n                self.push_stmt(S_BREAK, 0, 0, 0, 0);\n                self.expect(T_SEMI);\n                return;\n            }\n            if s == K_CONTINUE {\n                self.p += 1;\n                if self.loop_depth == 0 {\n");
        buf_str(out, c"                    self.fail(at, \"wgsl.syntax\", \"'continue' outside a loop\");\n                } else if self.in_continuing {\n                    self.fail(at, \"wgsl.syntax\", \"'continue' in a 'continuing' block\");\n                }\n                self.push_stmt(S_CONTINUE, 0, 0, 0, 0);\n                self.expect(T_SEMI);\n                return;\n            }\n            if s == K_DISCARD {\n                self.p += 1;\n                if self.stage != STAGE_FRAGMENT as i64 && self.stage != 255 {\n                    self.fail(at, \"wgsl.stage\", \"'discard' is only for fragment shaders\");\n                }\n                self.push_stmt(S_KILL, 0, 0, 0, 0);\n                self.expect(T_SEMI);\n                return;\n            }\n            if s == K_CONST_ASSERT {\n                self.fail(at, \"wgsl.unsupported\",\n                    \"'const_assert' is not in the WGSL subset of this release\");\n                return;\n            }\n            if s == K_CONTINUING {\n                self.fail(at, \"wgsl.syntax\", \"'continuing' belongs at the end of a 'loop'\");\n                return;\n            }\n            if s == K_ELSE {\n                self.fail(at, \"wgsl.syntax\", \"'else' without 'if'\");\n                return;\n            }\n            if s == K_CASE || s == K_DEFAULT {\n                self.fail(at, \"wgsl.syntax\", \"'case' outside a 'switch'\");\n                return;\n            }\n        }\n        self.simple_stmt();\n        self.expect(T_SEMI);\n    }\n\n    // An assignment, increment, call or phony assignment (no `;`).\n    fn simple_stmt(inout self) {\n        let at = self.pos();\n        if self.kind() == T_UNDERSCORE {\n            self.p += 1;\n            self.expect(T_EQ);\n            let v = self.parse_expr();\n            if v.k == VK_VOID {\n                self.fail(at, \"wgsl.type\", \"a function without a result has no value to assign\");\n            }\n");
        buf_str(out, c"            let _ = self.value(v, at);\n            return;\n        }\n        let start_exprs = self.f.exprs.len();\n        let start_stmts = self.pending.len();\n        let lhs = self.parse_unary_for_stmt();\n        let k = self.kind();\n        if k == T_EQ {\n            self.p += 1;\n            let rp = self.pos();\n            let ptr = self.lhs_ptr(lhs, at);\n            let pointee = self.m.pointee(self.f.exprs[ptr].ty);\n            let rhs = self.parse_expr_hint(pointee);\n            let e = self.materialize(rhs, pointee, rp);\n            self.push_stmt(S_STORE, ptr, e, 0, 0);\n            return;\n        }\n        if k >= lex::T_PLUSEQ && k <= lex::T_SHREQ {\n            self.p += 1;\n            let op = compound_op(k);\n            let rp = self.pos();\n            let ptr = self.lhs_ptr(lhs, at);\n            let pointee = self.m.pointee(self.f.exprs[ptr].ty);\n            let cur = self.value(Val {\n                k: VK_REF, sk: 0, e: ptr, ty: self.f.exprs[ptr].ty, iv: 0, fv: 0.0\n            }, at);\n            let rhs = self.parse_expr();\n            let r = self.binary(op, cur, rhs, rp);\n            let e = self.materialize(r, pointee, rp);\n            self.push_stmt(S_STORE, ptr, e, 0, 0);\n            return;\n        }\n        if k == T_PLUSPLUS || k == T_MINUSMINUS {\n            self.p += 1;\n            let ptr = self.lhs_ptr(lhs, at);\n            let pointee = self.m.pointee(self.f.exprs[ptr].ty);\n            if pointee != T_I32 && pointee != T_U32 {\n                self.fail(at, \"wgsl.type\", \"'++' and '--' apply to i32 and u32 variables\");\n                return;\n            }\n            let cur = self.value(Val {\n                k: VK_REF, sk: 0, e: ptr, ty: self.f.exprs[ptr].ty, iv: 0, fv: 0.0\n            }, at);\n            let one = cint(ir::SK_AINT, -1, 1);\n            let r = self.binary(if k == T_PLUSPLUS { ir::OP_ADD } else { ir::OP_SUB }, cur, one,\n                at);\n");
        buf_str(out, c"            let e = self.materialize(r, pointee, at);\n            self.push_stmt(S_STORE, ptr, e, 0, 0);\n            return;\n        }\n        // a call statement: its result, if any, is dropped\n        let _ = start_exprs;\n        let _ = start_stmts;\n        if !self.last_was_call {\n            if self.err(at, \"wgsl.syntax\") {\n                self.emsg.push_str(\n                    \"expected a statement: an assignment, a call, 'let', 'var', 'if', 'for', ...\");\n            }\n        }\n    }\n\n    // The pointer an assignment writes through.\n    fn lhs_ptr(inout self, lhs: Val, at: i64) -> i64 {\n        if lhs.k != VK_REF {\n            if self.err(at, \"wgsl.assign\") {\n                self.emsg.push_str(\"cannot assign to this: it is a value, not a variable\");\n                self.help(\n                    \"assign to a 'var' (a 'let' is immutable), a member or element of one, or '*p'\");\n            }\n            return self.dummy_ptr();\n        }\n        let pt = self.m.types[lhs.ty];\n        if pt.access & ACC_WRITE == 0 {\n            if self.err(at, \"wgsl.access\") {\n                self.emsg.push_fmt(\n                    f\"cannot write to a read-only {ir::space_name(pt.space)} variable\");\n                if pt.space == SP_STORAGE {\n                    self.help(\"declare it 'var<storage, read_write>'\");\n                }\n            }\n        }\n        if self.m.has_atomic(pt.base) {\n            self.fail(at, \"wgsl.type\", \"an atomic is written with atomicStore\");\n        }\n        lhs.e\n    }\n\n    pub fn dummy_ptr(inout self) -> i64 {\n        let ty = self.m.ptr_ty(T_I32, SP_FUNCTION, ACC_RW);\n        self.f.expr(ir::E_ZERO, ty, 0, 0, 0)\n    }\n\n    fn let_decl(inout self, is_const: bool) {\n        let npos = self.pos();\n        let s = self.ident();\n        var ty = -1;\n        if self.eat(T_COLON) {\n            ty = self.parse_type();\n        }\n        self.expect(T_EQ);\n");
        buf_str(out, c"        let ip = self.pos();\n        if is_const {\n            var v = self.parse_expr_hint(ty);\n            if ty >= 0 {\n                v = self.convert_to(v, ty, ip);\n            }\n            if v.k == VK_REF || (v.k == VK_VALUE && !self.is_const_expr(v.e)) {\n                self.fail(ip, \"wgsl.type\", \"a 'const' is a constant expression\");\n            }\n            self.scopes.push(ScopeEntry { sym: s, v: v, mutable: false });\n            return;\n        }\n        let v = self.parse_expr_hint(ty);\n        if v.k == VK_VOID {\n            self.fail(ip, \"wgsl.type\", \"this call has no result to bind\");\n            return;\n        }\n        let t = if ty >= 0 { ty } else { self.concrete_type_of(v) };\n        if self.m.has_atomic(t) || self.m.is_runtime_sized(t) {\n            self.fail(ip, \"wgsl.type\", \"a 'let' cannot hold an atomic or a runtime-sized array\");\n        }\n        let e = self.materialize(v, t, ip);\n        let _ = npos;\n        let eop = self.f.exprs[e].op;\n        if self.f.names[e].len == 0 && eop != E_ARG && eop != E_LOCAL && eop != E_GLOBAL {\n            self.f.names[e] = self.name_of(s);\n        }\n        self.scopes.push(ScopeEntry { sym: s, v: val(e, t), mutable: false });\n    }\n\n    fn var_decl(inout self) {\n        if self.kind() == T_LT {\n            let ap = self.pos();\n            self.p += 1;\n            let sp = self.address_space();\n            self.expect_gt();\n            if sp != SP_FUNCTION {\n                self.fail(ap, \"wgsl.type\", \"a variable in a function is 'var' or 'var<function>'\");\n            }\n        }\n        let npos = self.pos();\n        let s = self.ident();\n        var ty = -1;\n        if self.eat(T_COLON) {\n            ty = self.parse_type();\n        }\n        var init = -1;\n        if self.eat(T_EQ) {\n            let ip = self.pos();\n            let v = self.parse_expr_hint(ty);\n            if v.k == VK_VOID {\n");
        buf_str(out, c"                self.fail(ip, \"wgsl.type\", \"this call has no result\");\n                return;\n            }\n            if ty < 0 {\n                ty = self.concrete_type_of(v);\n            }\n            init = self.materialize(v, ty, ip);\n        }\n        if ty < 0 {\n            self.fail(npos, \"wgsl.type\", \"a 'var' needs a type or an initializer\");\n            return;\n        }\n        if !self.storable(ty) || self.m.has_atomic(ty) || self.m.is_runtime_sized(ty) {\n            if self.err(npos, \"wgsl.type\") {\n                self.emsg.push_str(\"a function variable cannot have type \");\n                self.ty_str(ty);\n            }\n            return;\n        }\n        let l = self.f.locals.len();\n        self.f.locals.push(Local { name: self.name_of(s), ty: ty });\n        let pty = self.m.ptr_ty(ty, SP_FUNCTION, ACC_RW);\n        let e = self.f.expr(E_LOCAL, pty, l, 0, 0);\n        if init >= 0 {\n            self.push_stmt(S_STORE, e, init, 0, 0);\n        } else {\n            // a variable is zero each time its declaration runs\n            let z = self.f.expr(ir::E_ZERO, ty, 0, 0, 0);\n            self.push_stmt(S_STORE, e, z, 0, 0);\n        }\n        self.scopes.push(ScopeEntry {\n            sym: s, v: Val { k: VK_REF, sk: 0, e: e, ty: pty, iv: 0, fv: 0.0 }, mutable: true\n        });\n    }\n\n    fn condition(inout self) -> i64 {\n        let at = self.pos();\n        let v = self.parse_expr();\n        if self.concrete_type_of(v) != T_BOOL {\n            if self.err(at, \"wgsl.type\") {\n                self.emsg.push_str(\"a condition is a bool, not \");\n                self.val_str(v);\n            }\n            return self.f.expr(ir::E_LITERAL, T_BOOL, 0, 0, 0);\n        }\n        self.materialize(v, T_BOOL, at)\n    }\n\n    fn if_stmt(inout self) {\n        let c = self.condition();\n        self.flush();\n        let then_b = self.compound();\n        var else_b = -1;\n        if self.eat_kw(K_ELSE) {\n");
        buf_str(out, c"            if self.eat_kw(K_IF) {\n                let base = self.pending.len();\n                self.if_stmt();\n                self.flush();\n                else_b = self.f.block_of(&self.pending, base);\n            } else {\n                else_b = self.compound();\n            }\n        } else {\n            else_b = self.f.empty_block();\n        }\n        self.push_stmt(S_IF, c, then_b, else_b, 0);\n    }\n\n    fn return_stmt(inout self, at: i64) {\n        let rt = self.f.result;\n        if self.kind() == T_SEMI {\n            if rt >= 0 {\n                if self.err(at, \"wgsl.return\") {\n                    self.emsg.push_str(\"this function returns \");\n                    self.ty_str(rt);\n                    self.emsg.push_str(\": 'return' needs a value\");\n                }\n            }\n            self.push_stmt(S_RETURN, -1, 0, 0, 0);\n            return;\n        }\n        let vp = self.pos();\n        let v = self.parse_expr_hint(rt);\n        if rt < 0 {\n            self.fail(vp, \"wgsl.return\", \"this function has no result: 'return;'\");\n            return;\n        }\n        let e = self.materialize(v, rt, vp);\n        self.push_stmt(S_RETURN, e, 0, 0, 0);\n    }\n\n    // The body of a loop (from its `{`), then `continuing` and `break if`.\n    fn loop_stmt(inout self) {\n        self.flush();\n        let base = self.pending.len();\n        let scope = self.scopes.len();\n        self.expect(T_LBRACE);\n        self.loop_depth += 1;\n        let saved_switch = self.switch_depth;\n        self.switch_depth = 0;\n        self.statements();\n        self.flush();\n        let body = self.f.block_of(&self.pending, base);\n        var cont = -1;\n        var break_if = -1;\n        if self.eat_kw(K_CONTINUING) {\n            // the continuing block sees the body's names\n            let cbase = self.pending.len();\n            let saved_cont = self.in_continuing;\n            self.in_continuing = true;\n");
        buf_str(out, c"            self.expect(T_LBRACE);\n            while self.kind() != T_RBRACE && self.kind() != T_EOF {\n                if self.is_kw(K_BREAK) && self.kind_at(self.p + 1) == T_IDENT\n                    && self.tk.syms[self.p + 1] == K_IF {\n                    self.p += 2;\n                    break_if = self.condition();\n                    self.expect(T_SEMI);\n                    if self.kind() != T_RBRACE {\n                        self.fail(self.pos(), \"wgsl.syntax\",\n                            \"'break if' is the last statement of 'continuing'\");\n                    }\n                    break;\n                }\n                self.statement();\n            }\n            self.expect(T_RBRACE);\n            self.flush();\n            self.in_continuing = saved_cont;\n            cont = self.f.block_of(&self.pending, cbase);\n        } else {\n            cont = self.f.empty_block();\n        }\n        self.expect(T_RBRACE);\n        self.loop_depth -= 1;\n        self.switch_depth = saved_switch;\n        self.scopes.truncate(scope);\n        self.push_stmt(S_LOOP, body, cont, break_if, 0);\n    }\n\n    // `if !cond { break; }` at the head of a loop body.\n    fn break_unless(inout self, c: i64) {\n        self.flush();\n        let then_b = self.f.empty_block();\n        let base = self.pending.len();\n        let s = self.f.stmt(S_BREAK, 0, 0, 0, 0);\n        self.pending.push(s);\n        let else_b = self.f.block_of(&self.pending, base);\n        self.push_stmt(S_IF, c, then_b, else_b, 0);\n    }\n\n    fn for_stmt(inout self) {\n        self.expect(T_LPAREN);\n        self.flush();\n        let outer = self.pending.len();\n        let scope = self.scopes.len();\n        // init\n        if self.kind() != T_SEMI {\n            if self.is_kw(K_VAR) {\n                self.p += 1;\n                self.var_decl();\n            } else if self.is_kw(K_LET) || self.is_kw(K_CONST) {\n                let c = self.is_kw(K_CONST);\n");
        buf_str(out, c"                self.p += 1;\n                self.let_decl(c);\n            } else {\n                self.simple_stmt();\n            }\n        }\n        self.expect(T_SEMI);\n        self.flush();\n        // the loop: its body starts with the condition\n        let base = self.pending.len();\n        self.loop_depth += 1;\n        let saved_switch = self.switch_depth;\n        self.switch_depth = 0;\n        if self.kind() != T_SEMI {\n            let c = self.condition();\n            self.break_unless(c);\n        }\n        self.expect(T_SEMI);\n        // the update is parsed after the body, so remember where it is\n        let upd = self.p;\n        var depth = 0;\n        while self.kind() != T_EOF {\n            let k = self.kind();\n            if k == T_LPAREN {\n                depth += 1;\n            } else if k == T_RPAREN {\n                if depth == 0 {\n                    break;\n                }\n                depth -= 1;\n            }\n            self.p += 1;\n        }\n        self.expect(T_RPAREN);\n        let b = self.compound();\n        self.push_stmt(S_BLOCK, b, 0, 0, 0);\n        self.flush();\n        let body = self.f.block_of(&self.pending, base);\n        let after = self.p;\n        self.p = upd;\n        let cbase = self.pending.len();\n        let saved_cont = self.in_continuing;\n        self.in_continuing = true;\n        if self.kind() != T_RPAREN {\n            self.simple_stmt();\n        }\n        self.in_continuing = saved_cont;\n        self.flush();\n        let cont = self.f.block_of(&self.pending, cbase);\n        self.p = after;\n        self.loop_depth -= 1;\n        self.switch_depth = saved_switch;\n        self.push_stmt(S_LOOP, body, cont, -1, 0);\n        self.flush();\n        self.scopes.truncate(scope);\n        let blk = self.f.block_of(&self.pending, outer);\n        self.push_stmt(S_BLOCK, blk, 0, 0, 0);\n    }\n\n    fn while_stmt(inout self) {\n        self.flush();\n");
        buf_str(out, c"        let base = self.pending.len();\n        self.loop_depth += 1;\n        let saved_switch = self.switch_depth;\n        self.switch_depth = 0;\n        let c = self.condition();\n        self.break_unless(c);\n        let b = self.compound();\n        self.push_stmt(S_BLOCK, b, 0, 0, 0);\n        self.flush();\n        let body = self.f.block_of(&self.pending, base);\n        self.loop_depth -= 1;\n        self.switch_depth = saved_switch;\n        let cont = self.f.empty_block();\n        self.push_stmt(S_LOOP, body, cont, -1, 0);\n    }\n\n    fn switch_stmt(inout self, at: i64) {\n        let sp = self.pos();\n        let sel = self.parse_expr();\n        let st = self.concrete_type_of(sel);\n        if st != T_I32 && st != T_U32 {\n            if self.err(sp, \"wgsl.type\") {\n                self.emsg.push_str(\"a switch selector is an i32 or a u32, not \");\n                self.val_str(sel);\n            }\n            return;\n        }\n        let se = self.materialize(sel, st, sp);\n        self.flush();\n        self.expect(T_LBRACE);\n        var clauses: V<ir::Case> = Vec::new_in(self.a);\n        var seen: V<i64> = Vec::new_in(self.a);\n        var defaults = 0;\n        self.switch_depth += 1;\n        while self.kind() != T_RBRACE && self.kind() != T_EOF {\n            let cp = self.pos();\n            var is_default = false;\n            let vstart = self.f.vals.len();\n            if self.eat_kw(K_DEFAULT) {\n                is_default = true;\n            } else if self.eat_kw(K_CASE) {\n                while self.kind() != T_LBRACE && self.kind() != T_COLON && self.kind() != T_EOF {\n                    if self.eat_kw(K_DEFAULT) {\n                        is_default = true;\n                    } else {\n                        let vp = self.pos();\n                        let v = self.parse_expr();\n                        let c = self.convert_to(v, st, vp);\n                        if c.k != VK_CONST {\n");
        buf_str(out, c"                            self.fail(vp, \"wgsl.type\", \"a case selector is a constant\");\n                        }\n                        for i in 0..seen.len() {\n                            if seen[i] == c.iv {\n                                if self.err(vp, \"wgsl.switch\") {\n                                    self.emsg.push_fmt(f\"case {c.iv} appears twice\");\n                                }\n                            }\n                        }\n                        seen.push(c.iv);\n                        self.f.vals.push(c.iv);\n                    }\n                    if !self.eat(T_COMMA) {\n                        break;\n                    }\n                }\n            } else {\n                if self.err(cp, \"wgsl.syntax\") {\n                    self.emsg.push_str(\"expected 'case' or 'default' in a switch\");\n                }\n                return;\n            }\n            if is_default {\n                defaults += 1;\n                if defaults > 1 {\n                    self.fail(cp, \"wgsl.switch\", \"a switch has one 'default'\");\n                }\n            }\n            self.eat(T_COLON);\n            let body = self.compound();\n            clauses.push(ir::Case {\n                vstart: vstart, vcount: self.f.vals.len() - vstart, is_default: is_default,\n                body: body\n            });\n        }\n        self.switch_depth -= 1;\n        self.expect(T_RBRACE);\n        if defaults == 0 {\n            self.fail(at, \"wgsl.switch\", \"a switch needs a 'default' clause\");\n            self.help(\"add 'default: {}'\");\n        }\n        let cstart = self.f.cases.len();\n        for i in 0..clauses.len() {\n            self.f.cases.push(clauses[i]);\n        }\n        self.push_stmt(S_SWITCH, se, cstart, clauses.len(), 0);\n    }\n\n    // A call as a statement: S_CALL is pushed by the call's lowering.\n    pub fn call_stmt(inout self, fh: i64, args_start: i64, n: i64) -> Val {\n");
        buf_str(out, c"        let rt = if fh == self.fh { self.f.result } else { self.m.functions[fh].result };\n        if rt < 0 {\n            self.push_stmt(S_CALL, fh, args_start, n, -1);\n            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n        }\n        let r = self.unemitted(E_CALL_RESULT, rt);\n        self.push_stmt(S_CALL, fh, args_start, n, r);\n        val(r, rt)\n    }\n}\n\nfn compound_op(k: u8) -> i64 {\n    if k == lex::T_PLUSEQ {\n        ir::OP_ADD\n    } else if k == lex::T_MINUSEQ {\n        ir::OP_SUB\n    } else if k == lex::T_STAREQ {\n        ir::OP_MUL\n    } else if k == lex::T_SLASHEQ {\n        ir::OP_DIV\n    } else if k == lex::T_PERCENTEQ {\n        ir::OP_MOD\n    } else if k == lex::T_AMPEQ {\n        ir::OP_AND\n    } else if k == lex::T_PIPEEQ {\n        ir::OP_OR\n    } else if k == lex::T_CARETEQ {\n        ir::OP_XOR\n    } else if k == lex::T_SHLEQ {\n        ir::OP_SHL\n    } else {\n        ir::OP_SHR\n    }\n}\n// ---- end mod std::gpu::wgsl::front ----\n}\n// ---- mod std::gpu::wgsl::expr ----\npub mod expr {\n// ---- Shader compiler implementation, expr (0.22) ----\n// Expressions: WGSL's grammar, the Load Rule, abstract numbers and their\n// conversions, constant folding, operators and their types, indexing and\n// member access. Calls and constructors are in builtins.vl.\n\nuse front::{\n    Front, ScopeEntry, VK_CONST, VK_REF, VK_TYPE, VK_VALUE, VK_VOID, Val, cfloat, cint, val,\n};\nuse ir::{\n    E_ACCESS, E_ACCESS_INDEX, E_BINARY, E_CONVERT, E_LITERAL, E_LOAD, E_SPLAT, E_SWIZZLE, E_UNARY,\n    E_ZERO, OP_ADD, OP_AND, OP_DIV, OP_EQ, OP_GE, OP_GT, OP_LAND, OP_LE, OP_LOR, OP_LT, OP_MOD,\n    OP_MUL, OP_NE, OP_OR, OP_SHL, OP_SHR, OP_SUB, OP_XOR, SK_AFLOAT, SK_AINT, SK_BOOL, SK_F32,\n    SK_I32, SK_U32, SP_FUNCTION, S_IF, S_STORE, TK_ARRAY, TK_MATRIX, TK_POINTER, TK_SCALAR,\n    TK_STRUCT, TK_VECTOR, T_BOOL, T_F32, T_I32, T_U32, UN_BITNOT, UN_NEG, UN_NOT, f32_bits, mat_ty,\n    vec_ty,\n};\nuse lex::{\n");
        buf_str(out, c"    T_AMP, T_ANDAND, T_BANG, T_CARET, T_DOT, T_EQEQ, T_FLOAT, T_GE, T_GT, T_IDENT, T_INT,\n    T_LBRACKET, T_LE, T_LPAREN, T_LT, T_MINUS, T_NE, T_OROR, T_PERCENT, T_PIPE, T_PLUS, T_RBRACKET,\n    T_RPAREN, T_SHL, T_SHR, T_SLASH, T_STAR, T_TILDE,\n};\nuse names::{K_FALSE, K_TRUE};\n\nconst I32_MIN: i64 = -2147483648;\nconst I32_MAX: i64 = 2147483647;\nconst U32_MAX: i64 = 4294967295;\nconst F32_MAX: f64 = 340282346638528859811704183484516925440.0;\n\nimpl Front {\n    pub fn parse_expr(inout self) -> Val { self.parse_expr_hint(-1) }\n\n    // An expression; `hint` (a type or -1) is the type the context\n    // expects, which an inferred constructor of abstract numbers takes.\n    pub fn parse_expr_hint(inout self, hint: i64) -> Val {\n        let saved = self.hint;\n        self.hint = hint;\n        let at = self.pos();\n        let l = self.parse_relational();\n        let k = self.kind();\n        if k != T_ANDAND && k != T_OROR {\n            self.hint = saved;\n            return l;\n        }\n        var acc = l;\n        while self.kind() == k {\n            let op_at = self.pos();\n            self.p += 1;\n            acc = self.short_circuit(k == T_ANDAND, acc, op_at);\n        }\n        let k2 = self.kind();\n        if k2 == T_ANDAND || k2 == T_OROR {\n            self.fail(self.pos(), \"wgsl.syntax\", \"mixing '&&' and '||' needs parentheses\");\n        }\n        let _ = at;\n        self.hint = saved;\n        acc\n    }\n\n    // `l && r` or `l || r`: r is evaluated only when needed. Without\n    // effects in r this is a plain operator; else it is an `if` writing a\n    // temporary variable.\n    fn short_circuit(inout self, and: bool, l: Val, at: i64) -> Val {\n        let lc = self.concrete_type_of(l);\n        if lc != T_BOOL {\n            self.bad_operands(if and { \"&&\" } else { \"||\" }, l, l, at);\n            return cint(SK_BOOL, T_BOOL, 0);\n        }\n        if l.k == VK_CONST {\n            // a constant left side decides\n");
        buf_str(out, c"            let r = self.parse_relational();\n            if self.concrete_type_of(r) != T_BOOL {\n                self.bad_operands(if and { \"&&\" } else { \"||\" }, l, r, at);\n                return l;\n            }\n            if and && l.iv == 0 {\n                return l;\n            }\n            if !and && l.iv != 0 {\n                return l;\n            }\n            return self.value(r, at);\n        }\n        let le = self.materialize(l, T_BOOL, at);\n        self.flush();\n        let before = self.pending.len();\n        let rp = self.pos();\n        let r = self.parse_relational();\n        if self.concrete_type_of(r) != T_BOOL {\n            self.bad_operands(if and { \"&&\" } else { \"||\" }, l, r, at);\n            return l;\n        }\n        let re = self.materialize(r, T_BOOL, rp);\n        if self.pending.len() == before {\n            let e = self.f.expr(E_BINARY, T_BOOL, if and { OP_LAND } else { OP_LOR }, le, re);\n            return val(e, T_BOOL);\n        }\n        // r made statements (calls): t = l; if (l == and) { r's statements; t = r }\n        self.flush();\n        let lt = self.f.locals.len();\n        self.f.locals.push(ir::Local { name: \"\", ty: T_BOOL });\n        let pty = self.m.ptr_ty(T_BOOL, SP_FUNCTION, ir::ACC_RW);\n        let tv = self.f.expr(ir::E_LOCAL, pty, lt, 0, 0);\n        let st = self.f.stmt(S_STORE, tv, re, 0, 0);\n        self.pending.push(st);\n        let inner = self.f.block_of(&self.pending, before);\n        let empty = self.f.empty_block();\n        let st0 = self.f.stmt(S_STORE, tv, le, 0, 0);\n        self.pending.push(st0);\n        if and {\n            self.push_stmt(S_IF, le, inner, empty, 0);\n        } else {\n            self.push_stmt(S_IF, le, empty, inner, 0);\n        }\n        let e = self.f.expr(E_LOAD, T_BOOL, tv, 0, 0);\n        val(e, T_BOOL)\n    }\n\n    fn parse_relational(inout self) -> Val {\n        let l = self.parse_shift();\n        let k = self.kind();\n");
        buf_str(out, c"        var op = -1;\n        if k == T_LT {\n            op = OP_LT;\n        } else if k == T_LE {\n            op = OP_LE;\n        } else if k == T_GT {\n            op = OP_GT;\n        } else if k == T_GE {\n            op = OP_GE;\n        } else if k == T_EQEQ {\n            op = OP_EQ;\n        } else if k == T_NE {\n            op = OP_NE;\n        }\n        if op < 0 {\n            return l;\n        }\n        let at = self.pos();\n        self.p += 1;\n        let r = self.parse_shift();\n        let v = self.binary(op, l, r, at);\n        let k2 = self.kind();\n        if k2 == T_LT || k2 == T_LE || k2 == T_GT || k2 == T_GE || k2 == T_EQEQ || k2 == T_NE {\n            self.fail(self.pos(), \"wgsl.syntax\", \"comparisons do not chain: 'a < b && b < c'\");\n        }\n        v\n    }\n\n    // A shift, a bitwise expression, or an additive one.\n    pub fn parse_shift(inout self) -> Val {\n        let u = self.parse_unary();\n        let k = self.kind();\n        if k == T_SHL || k == T_SHR {\n            let at = self.pos();\n            self.p += 1;\n            let r = self.parse_unary();\n            return self.binary(if k == T_SHL { OP_SHL } else { OP_SHR }, u, r, at);\n        }\n        if k == T_AMP || k == T_PIPE || k == T_CARET {\n            let op = if k == T_AMP { OP_AND } else if k == T_PIPE { OP_OR } else { OP_XOR };\n            var acc = u;\n            while self.kind() == k {\n                let at = self.pos();\n                self.p += 1;\n                let r = self.parse_unary();\n                acc = self.binary(op, acc, r, at);\n            }\n            let k2 = self.kind();\n            if k2 == T_AMP || k2 == T_PIPE || k2 == T_CARET || k2 == T_PLUS || k2 == T_MINUS\n                || k2 == T_STAR || k2 == T_SLASH || k2 == T_PERCENT {\n                self.fail(self.pos(), \"wgsl.syntax\",\n                    \"mixing bitwise operators with other operators needs parentheses\");\n            }\n            return acc;\n");
        buf_str(out, c"        }\n        var l = self.parse_mult_from(u);\n        while self.kind() == T_PLUS || self.kind() == T_MINUS {\n            let op = if self.kind() == T_PLUS { OP_ADD } else { OP_SUB };\n            let at = self.pos();\n            self.p += 1;\n            let r0 = self.parse_unary();\n            let r = self.parse_mult_from(r0);\n            l = self.binary(op, l, r, at);\n        }\n        let k3 = self.kind();\n        if k3 == T_AMP || k3 == T_PIPE || k3 == T_CARET || k3 == T_SHL || k3 == T_SHR {\n            self.fail(self.pos(), \"wgsl.syntax\",\n                \"mixing bitwise or shift operators with arithmetic needs parentheses\");\n        }\n        l\n    }\n\n    fn parse_mult_from(inout self, u: Val) -> Val {\n        var l = u;\n        loop {\n            let k = self.kind();\n            let op = if k == T_STAR {\n                OP_MUL\n            } else if k == T_SLASH {\n                OP_DIV\n            } else if k == T_PERCENT {\n                OP_MOD\n            } else {\n                return l;\n            };\n            let at = self.pos();\n            self.p += 1;\n            let r = self.parse_unary();\n            l = self.binary(op, l, r, at);\n        }\n    }\n\n    // A statement's left side or call: a unary expression; remembers\n    // whether it ended in a user call.\n    pub fn parse_unary_for_stmt(inout self) -> Val {\n        self.last_call_end = -1;\n        let v = self.parse_unary();\n        if self.last_call_end != self.p {\n            self.last_was_call = false;\n        } else {\n            self.last_was_call = true;\n        }\n        v\n    }\n\n    pub fn parse_unary(inout self) -> Val {\n        let at = self.pos();\n        let k = self.kind();\n        if k == T_MINUS {\n            self.p += 1;\n            let v = self.parse_unary();\n            return self.unary(UN_NEG, v, at);\n        }\n        if k == T_BANG {\n            self.p += 1;\n            let v = self.parse_unary();\n");
        buf_str(out, c"            return self.unary(UN_NOT, v, at);\n        }\n        if k == T_TILDE {\n            self.p += 1;\n            let v = self.parse_unary();\n            return self.unary(UN_BITNOT, v, at);\n        }\n        if k == T_STAR {\n            self.p += 1;\n            let v = self.parse_unary();\n            let pv = self.value(v, at);\n            if pv.k != VK_VALUE || self.m.types[pv.ty].kind != TK_POINTER {\n                if self.err(at, \"wgsl.type\") {\n                    self.emsg.push_str(\"'*' dereferences a pointer, not \");\n                    self.val_str(v);\n                }\n                return cint(SK_AINT, -1, 0);\n            }\n            return Val { k: VK_REF, sk: 0, e: pv.e, ty: pv.ty, iv: 0, fv: 0.0 };\n        }\n        if k == T_AMP {\n            self.p += 1;\n            let v = self.parse_unary();\n            if v.k != VK_REF {\n                if self.err(at, \"wgsl.type\") {\n                    self.emsg.push_str(\"'&' takes the address of a variable (or a member or element of one), not of \");\n                    self.val_str(v);\n                }\n                return cint(SK_AINT, -1, 0);\n            }\n            if self.m.types[self.f.exprs[v.e].ty].kind == TK_POINTER\n                && self.f.exprs[v.e].op == ir::E_ACCESS_INDEX && self.is_vector_component(v.e) {\n                self.fail(at, \"wgsl.type\", \"cannot take the address of a vector component\");\n            }\n            return val(v.e, v.ty);\n        }\n        let p = self.parse_primary();\n        self.parse_postfix(p)\n    }\n\n    fn is_vector_component(self, e: i64) -> bool {\n        let base = self.f.exprs[e].a;\n        let bt = self.m.pointee(self.f.exprs[base].ty);\n        bt >= 0 && self.m.types[bt].kind == TK_VECTOR\n    }\n\n    fn parse_postfix(inout self, v0: Val) -> Val {\n        var v = v0;\n        loop {\n            let k = self.kind();\n            if k == T_LBRACKET {\n                let at = self.pos();\n");
        buf_str(out, c"                self.p += 1;\n                let ip = self.pos();\n                let i = self.parse_expr();\n                self.expect(T_RBRACKET);\n                v = self.index(v, i, at, ip);\n            } else if k == T_DOT {\n                self.p += 1;\n                let at = self.pos();\n                if self.kind() != T_IDENT {\n                    self.expect(T_IDENT);\n                    return v;\n                }\n                let name = self.text(self.p);\n                self.p += 1;\n                v = self.member(v, name, at);\n            } else {\n                return v;\n            }\n        }\n    }\n\n    // ---- Primaries ----\n\n    fn parse_primary(inout self) -> Val {\n        let at = self.pos();\n        let k = self.kind();\n        let hint = self.hint;\n        self.hint = -1;\n        if k == T_INT {\n            return self.int_literal(self.p);\n        }\n        if k == T_FLOAT {\n            return self.float_literal(self.p);\n        }\n        if k == T_LPAREN {\n            self.p += 1;\n            let v = self.parse_expr_hint(hint);\n            self.expect(T_RPAREN);\n            return v;\n        }\n        if k != T_IDENT {\n            if self.err(at, \"wgsl.syntax\") {\n                self.emsg.push_str(\"expected an expression, got \");\n                self.emsg.push_str(lex::token_text(k));\n            }\n            return cint(SK_AINT, -1, 0);\n        }\n        let s = self.tk.syms[self.p];\n        if s == K_TRUE || s == K_FALSE {\n            self.p += 1;\n            return cint(SK_BOOL, T_BOOL, if s == K_TRUE { 1 } else { 0 });\n        }\n        // local names\n        let li = self.lookup_name(s);\n        if li >= 0 {\n            self.p += 1;\n            let ent = self.scopes[li];\n            if self.kind() == T_LPAREN {\n                if self.err(at, \"wgsl.call\") {\n                    self.emsg.push_fmt(f\"'{self.name_of(s)}' is a value, not a function\");\n                }\n");
        buf_str(out, c"            }\n            return ent.v;\n        }\n        // module-scope names\n        if self.decl_of[s] >= 0 {\n            let d = self.decl_of[s];\n            let kind = self.decls[d].kind;\n            if kind == front::D_CONST {\n                self.p += 1;\n                if self.decls[d].has_cv {\n                    return self.decls[d].cv;\n                }\n                let saved = self.p;\n                let v = self.const_value(d);\n                self.p = saved;\n                return v;\n            }\n            if kind == front::D_VAR {\n                self.p += 1;\n                let g = self.decls[d].h;\n                if g < 0 {\n                    // a global used by another module-scope declaration\n                    if self.err(at, \"wgsl.name\") {\n                        self.emsg.push_fmt(\n                            f\"'{self.name_of(s)}' is a variable; a module-scope declaration cannot use it\");\n                    }\n                    return cint(SK_AINT, -1, 0);\n                }\n                if self.fh < 0 {\n                    if self.err(at, \"wgsl.type\") {\n                        self.emsg.push_fmt(\n                            f\"'{self.name_of(s)}' is a variable; a constant expression cannot read it\");\n                    }\n                    return cint(SK_AINT, -1, 0);\n                }\n                let e = self.global_expr(g);\n                let ty = self.f.exprs[e].ty;\n                if self.m.globals[g].space == ir::SP_HANDLE {\n                    return val(e, ty);\n                }\n                return Val { k: VK_REF, sk: 0, e: e, ty: ty, iv: 0, fv: 0.0 };\n            }\n            if kind == front::D_FN {\n                self.p += 1;\n                if self.kind() != T_LPAREN {\n                    if self.err(at, \"wgsl.type\") {\n                        self.emsg.push_fmt(\n");
        buf_str(out, c"                            f\"'{self.name_of(s)}' is a function: call it, '{self.name_of(s)}(...)'\");\n                    }\n                    return cint(SK_AINT, -1, 0);\n                }\n                return self.user_call(self.decls[d].h, at);\n            }\n            // a struct or alias: a constructor\n            let ty = self.parse_type();\n            return self.construct(ty, at);\n        }\n        self.builtin_primary(s, at, hint)\n    }\n\n    pub fn lookup_name(self, s: i64) -> i64 {\n        var i = self.scopes.len() - 1;\n        while i >= self.scope_floor {\n            if self.scopes[i].sym == s {\n                return i;\n            }\n            i -= 1;\n        }\n        -1\n    }\n\n    // ---- Literals ----\n\n    fn int_literal(inout self, t: i64) -> Val {\n        let s = self.text(t);\n        let at = self.pos();\n        self.p += 1;\n        var end = s.len;\n        let last = s[end - 1];\n        var sk = SK_AINT;\n        if last == 'i' {\n            sk = SK_I32;\n            end -= 1;\n        } else if last == 'u' {\n            sk = SK_U32;\n            end -= 1;\n        }\n        var v: i64 = 0;\n        var overflow = false;\n        if end > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X') {\n            for i in 2..end {\n                let c = s[i];\n                let d = if c >= '0' && c <= '9' { c - '0' }\n                    else if c >= 'a' && c <= 'f' { c - 'a' + 10 } else { c - 'A' + 10 };\n                if v > 576460752303423487 {\n                    overflow = true;\n                }\n                v = v * 16 + d as i64;\n            }\n        } else {\n            if end > 1 && s[0] == '0' {\n                self.fail(at, \"wgsl.syntax\", \"a decimal integer does not start with 0\");\n                return cint(SK_AINT, -1, 0);\n            }\n            for i in 0..end {\n                let d = (s[i] - '0') as i64;\n");
        buf_str(out, c"                if v > 922337203685477580 || (v == 922337203685477580 && d > 7) {\n                    overflow = true;\n                }\n                v = v * 10 + d;\n            }\n        }\n        if overflow {\n            self.fail(at, \"wgsl.const\", \"this integer does not fit in 64 bits\");\n            return cint(SK_AINT, -1, 0);\n        }\n        if sk == SK_I32 && v > I32_MAX {\n            self.fail(at, \"wgsl.const\", \"this i32 literal is above 2147483647\");\n            self.help(\"negate a smaller literal, or use an abstract integer: -2147483648\");\n            return cint(SK_I32, T_I32, 0);\n        }\n        if sk == SK_U32 && v > U32_MAX {\n            self.fail(at, \"wgsl.const\", \"this u32 literal is above 4294967295\");\n            return cint(SK_U32, T_U32, 0);\n        }\n        let ty = if sk == SK_I32 { T_I32 } else if sk == SK_U32 { T_U32 } else { -1 };\n        cint(sk, ty, v)\n    }\n\n    fn float_literal(inout self, t: i64) -> Val {\n        let s = self.text(t);\n        let at = self.pos();\n        self.p += 1;\n        var end = s.len;\n        var sk = SK_AFLOAT;\n        let last = s[end - 1];\n        let hex = s.len > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X');\n        if last == 'h' {\n            self.fail(at, \"wgsl.unsupported\",\n                \"'f16' literals are not in the WGSL subset of this release\");\n            return cfloat(SK_F32, T_F32, 0.0);\n        }\n        if last == 'f' && !hex {\n            sk = SK_F32;\n            end -= 1;\n        } else if last == 'f' && hex && s.len > 2 {\n            // hex floats end in f only after an exponent\n            var has_p = false;\n            for i in 0..s.len {\n                if s[i] == 'p' || s[i] == 'P' {\n                    has_p = true;\n                }\n            }\n            if has_p {\n                sk = SK_F32;\n                end -= 1;\n            }\n        }\n        let v = if hex { hex_float(s[0..end]) }\n");
        buf_str(out, c"            else { std::num::parse_f64(s[0..end]).unwrap_or(0.0) };\n        if sk == SK_F32 {\n            let f = v as f32;\n            if f as f64 > F32_MAX || -(f as f64) > F32_MAX {\n                self.fail(at, \"wgsl.const\", \"this f32 literal is out of range\");\n            }\n            return cfloat(SK_F32, T_F32, f as f64);\n        }\n        cfloat(SK_AFLOAT, -1, v)\n    }\n\n    // ---- The Load Rule and conversions ----\n\n    // A value: a reference is read (E_LOAD).\n    pub fn value(inout self, v: Val, at: i64) -> Val {\n        if v.k == VK_REF {\n            let t = self.m.pointee(v.ty);\n            if self.m.has_atomic(t) {\n                self.fail(at, \"wgsl.type\", \"an atomic is read with atomicLoad\");\n                return cint(SK_AINT, -1, 0);\n            }\n            if self.m.is_runtime_sized(t) {\n                self.fail(at, \"wgsl.type\", \"a runtime-sized array cannot be read whole; index it\");\n                return cint(SK_AINT, -1, 0);\n            }\n            let e = self.f.expr(E_LOAD, t, v.e, 0, 0);\n            return val(e, t);\n        }\n        if v.k == VK_VOID {\n            self.fail(at, \"wgsl.type\", \"this call has no result to use\");\n            return cint(SK_AINT, -1, 0);\n        }\n        if v.k == VK_TYPE {\n            self.fail(at, \"wgsl.type\", \"a type is not a value\");\n            return cint(SK_AINT, -1, 0);\n        }\n        v\n    }\n\n    // The type v has once concrete (abstract ints become i32, floats f32).\n    pub fn concrete_type_of(self, v: Val) -> i64 {\n        if v.k == VK_CONST {\n            if v.ty >= 0 {\n                return v.ty;\n            }\n            return if v.sk == SK_AFLOAT { T_F32 } else { T_I32 };\n        }\n        if v.k == VK_REF {\n            return self.m.pointee(v.ty);\n        }\n        if v.k == VK_VOID || v.e < 0 && v.ty < 0 {\n            return T_I32;\n        }\n        v.ty\n    }\n\n");
        buf_str(out, c"    // v as type ty: abstract constants convert, references load; any\n    // other difference is an error.\n    pub fn convert_to(inout self, v0: Val, ty: i64, at: i64) -> Val {\n        let v = self.value(v0, at);\n        if self.failed {\n            return if v.k == VK_CONST { v } else { self.dummy(ty) };\n        }\n        if v.k == VK_CONST {\n            if v.ty == ty {\n                return v;\n            }\n            let t = self.m.types[ty];\n            if v.ty < 0 && t.kind == TK_SCALAR {\n                return self.const_cast(v, t.scalar, at, false);\n            }\n            self.mismatch(ty, v, at);\n            return v;\n        }\n        if v.ty != ty {\n            self.mismatch(ty, v, at);\n        }\n        v\n    }\n\n    pub fn mismatch(inout self, want: i64, got: Val, at: i64) {\n        if self.err(at, \"wgsl.type\") {\n            self.emsg.push_str(\"expected \");\n            self.ty_str(want);\n            self.emsg.push_str(\", got \");\n            self.val_str(got);\n            let gt = self.concrete_type_of(got);\n            if gt >= 0 && self.m.types[gt].kind == TK_SCALAR\n                && self.m.types[want].kind == TK_SCALAR {\n                self.tmp.clear();\n                self.m.type_name(want, &self.tmp);\n                self.ehelp.push_fmt(f\"convert it: {self.tmp.as_slice()}(...)\");\n            }\n        }\n    }\n\n    // A dummy value of type ty, after an error.\n    pub fn dummy(inout self, ty: i64) -> Val {\n        let e = self.f.expr(E_ZERO, ty, 0, 0, 0);\n        val(e, ty)\n    }\n\n    // v as an IR expression of type ty.\n    pub fn materialize(inout self, v0: Val, ty: i64, at: i64) -> i64 {\n        let v = self.convert_to(v0, ty, at);\n        if self.failed {\n            return self.f.expr(E_ZERO, ty, 0, 0, 0);\n        }\n        if v.k == VK_CONST {\n            return self.literal(v, ty);\n        }\n        v.e\n    }\n\n");
        buf_str(out, c"    // v (a value of any concrete type) as an IR expression, its type\n    // concrete.\n    pub fn emit_val(inout self, v: Val, at: i64) -> i64 {\n        let t = self.concrete_type_of(v);\n        self.materialize(v, t, at)\n    }\n\n    pub fn literal(inout self, v: Val, ty: i64) -> i64 {\n        let sk = self.m.types[ty].scalar;\n        let bits = if sk == SK_F32 { f32_bits(v.fv as f32) as i64 } else { v.iv & 4294967295 };\n        self.f.expr(E_LITERAL, ty, bits, 0, 0)\n    }\n\n    // A constant as scalar kind `to`: an automatic conversion of an\n    // abstract number (`explicit` false), or a value constructor's.\n    pub fn const_cast(inout self, v: Val, to: u8, at: i64, explicit: bool) -> Val {\n        let ty = to as i64;\n        let from = v.sk;\n        if from == to {\n            return Val { k: VK_CONST, sk: to, e: -1, ty: ty, iv: v.iv, fv: v.fv };\n        }\n        let is_float = from == SK_F32 || from == SK_AFLOAT;\n        if !explicit {\n            let ok = (from == SK_AINT && (to == SK_I32 || to == SK_U32 || to == SK_F32))\n                || (from == SK_AFLOAT && to == SK_F32);\n            if !ok {\n                if self.err(at, \"wgsl.type\") {\n                    self.emsg.push_fmt(\n                        f\"expected {ir::scalar_name(to)}, got {ir::scalar_name(from)}\");\n                    if from == SK_AFLOAT && (to == SK_I32 || to == SK_U32) {\n                        self.ehelp.push_fmt(f\"convert it: {ir::scalar_name(to)}(...)\");\n                    }\n                }\n                return cint(to, ty, 0);\n            }\n        }\n        if to == SK_BOOL {\n            let nz = if is_float { v.fv != 0.0 } else { v.iv != 0 };\n            return cint(SK_BOOL, T_BOOL, if nz { 1 } else { 0 });\n        }\n        if to == SK_F32 || to == SK_AFLOAT {\n            let x = if is_float { v.fv } else { v.iv as f64 };\n            if to == SK_F32 {\n                if x > F32_MAX || x < -F32_MAX {\n");
        buf_str(out, c"                    self.fail(at, \"wgsl.const\", \"this value is out of f32's range\");\n                }\n                return cfloat(SK_F32, T_F32, (x as f32) as f64);\n            }\n            return cfloat(SK_AFLOAT, -1, x);\n        }\n        // to an integer\n        var x = v.iv;\n        if is_float {\n            if explicit {\n                // value conversion: truncate, then saturate\n                let f = v.fv;\n                if to == SK_I32 {\n                    x = if f != f { 0 } else if f <= -2147483648.0 { I32_MIN }\n                        else if f >= 2147483520.0 { 2147483520 } else { f as i64 };\n                } else {\n                    x = if f != f { 0 } else if f <= 0.0 { 0 }\n                        else if f >= 4294967040.0 { 4294967040 } else { f as i64 };\n                }\n                return cint(to, ty, x);\n            }\n        }\n        if from == SK_BOOL {\n            return cint(to, ty, x);\n        }\n        if explicit && from != SK_AINT {\n            // between i32 and u32: the bits\n            if to == SK_U32 {\n                x = x & U32_MAX;\n            } else {\n                x = (x & U32_MAX) as i32 as i64;\n            }\n            return cint(to, ty, x);\n        }\n        if to == SK_I32 && (x < I32_MIN || x > I32_MAX) {\n            if self.err(at, \"wgsl.const\") {\n                self.emsg.push_fmt(f\"{x} does not fit in an i32\");\n            }\n        } else if to == SK_U32 && (x < 0 || x > U32_MAX) {\n            if self.err(at, \"wgsl.const\") {\n                self.emsg.push_fmt(f\"{x} does not fit in a u32\");\n                if x < 0 {\n                    self.help(\"a u32 is never negative; use an i32, or bitcast<u32>(...)\");\n                }\n            }\n        }\n        cint(to, ty, x)\n    }\n\n    // ---- Operators ----\n\n    pub fn bad_operands(inout self, op: [u8], l: Val, r: Val, at: i64) {\n        if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"            self.emsg.push_fmt(f\"'{op}' cannot take \");\n            self.val_str(l);\n            self.emsg.push_str(\" and \");\n            self.val_str(r);\n        }\n    }\n\n    pub fn unary(inout self, op: i64, v0: Val, at: i64) -> Val {\n        let v = self.value(v0, at);\n        if self.failed {\n            return v;\n        }\n        let t = self.concrete_type_of(v);\n        let tt = self.m.types[t];\n        let sk = if v.k == VK_CONST { v.sk } else { tt.scalar };\n        let numeric = tt.kind == TK_SCALAR || tt.kind == TK_VECTOR;\n        if op == UN_NEG {\n            if !(numeric || tt.kind == TK_MATRIX) || sk == SK_BOOL || sk == SK_U32 {\n                if self.err(at, \"wgsl.type\") {\n                    self.emsg.push_str(\"'-' cannot take \");\n                    self.val_str(v);\n                    if sk == SK_U32 {\n                        self.help(\"a u32 is never negative: 0u - x wraps, or use an i32\");\n                    }\n                }\n                return v;\n            }\n            if v.k == VK_CONST {\n                if sk == SK_AFLOAT || sk == SK_F32 {\n                    return cfloat(sk, v.ty, -v.fv);\n                }\n                if sk == SK_I32 && v.iv == I32_MIN {\n                    self.fail(at, \"wgsl.const\", \"-(-2147483648i) does not fit in an i32\");\n                }\n                return cint(sk, v.ty, -v.iv);\n            }\n            if tt.kind == TK_MATRIX {\n                self.fail(at, \"wgsl.unsupported\",\n                    \"negating a matrix is not in this release; multiply by -1.0\");\n                return v;\n            }\n        } else if op == UN_NOT {\n            if !numeric || sk != SK_BOOL {\n                if self.err(at, \"wgsl.type\") {\n                    self.emsg.push_str(\"'!' takes a bool, not \");\n                    self.val_str(v);\n                    if sk == SK_I32 || sk == SK_U32 {\n");
        buf_str(out, c"                        self.help(\"'~' is the bitwise not of an integer\");\n                    }\n                }\n                return v;\n            }\n            if v.k == VK_CONST {\n                return cint(SK_BOOL, T_BOOL, if v.iv == 0 { 1 } else { 0 });\n            }\n        } else {\n            if !numeric || !(sk == SK_I32 || sk == SK_U32 || sk == SK_AINT) {\n                if self.err(at, \"wgsl.type\") {\n                    self.emsg.push_str(\"'~' takes an integer, not \");\n                    self.val_str(v);\n                }\n                return v;\n            }\n            if v.k == VK_CONST {\n                let x = ~v.iv;\n                return cint(sk, v.ty, if sk == SK_U32 { x & U32_MAX } else { x });\n            }\n        }\n        let e = self.f.expr(E_UNARY, t, op, v.e, 0);\n        val(e, t)\n    }\n\n    pub fn op_text(self, op: i64) -> [u8] {\n        if op == OP_ADD {\n            \"+\"\n        } else if op == OP_SUB {\n            \"-\"\n        } else if op == OP_MUL {\n            \"*\"\n        } else if op == OP_DIV {\n            \"/\"\n        } else if op == OP_MOD {\n            \"%\"\n        } else if op == OP_EQ {\n            \"==\"\n        } else if op == OP_NE {\n            \"!=\"\n        } else if op == OP_LT {\n            \"<\"\n        } else if op == OP_LE {\n            \"<=\"\n        } else if op == OP_GT {\n            \">\"\n        } else if op == OP_GE {\n            \">=\"\n        } else if op == OP_AND {\n            \"&\"\n        } else if op == OP_OR {\n            \"|\"\n        } else if op == OP_XOR {\n            \"^\"\n        } else if op == OP_SHL {\n            \"<<\"\n        } else {\n            \">>\"\n        }\n    }\n\n    // Whether e is a constant (a literal, or a vector of literals) with a\n    // lane of n or more (unsigned).\n    fn const_lanes_at_least(self, e: i64, n: i64) -> bool {\n        let x = self.f.exprs[e];\n        if x.op == E_LITERAL {\n");
        buf_str(out, c"            return x.a >= n;\n        }\n        if x.op == E_SPLAT {\n            return self.const_lanes_at_least(x.a, n);\n        }\n        if x.op == ir::E_COMPOSE {\n            for i in x.a..x.a + x.b {\n                if self.const_lanes_at_least(self.f.args[i], n) {\n                    return true;\n                }\n            }\n        }\n        false\n    }\n\n    pub fn binary(inout self, op: i64, l0: Val, r0: Val, at: i64) -> Val {\n        var l = self.value(l0, at);\n        var r = self.value(r0, at);\n        if self.failed {\n            return l;\n        }\n        if l.k == VK_CONST && r.k == VK_CONST {\n            return self.fold(op, l, r, at);\n        }\n        let shift = op == OP_SHL || op == OP_SHR;\n        // the abstract side takes the other side's scalar\n        if shift {\n            let rt0 = if r.k == VK_CONST { -1 } else { r.ty };\n            if r.k == VK_CONST {\n                if r.ty < 0 || r.sk == SK_U32 {\n                    r = self.const_cast(r, SK_U32, at, false);\n                }\n            }\n            if l.k == VK_CONST && l.ty < 0 {\n                let rk = self.m.types[self.concrete_type_of(r)];\n                let _ = rk;\n                l = self.const_cast(l, SK_I32, at, false);\n            }\n            let _ = rt0;\n        } else if l.k == VK_CONST && l.ty < 0 {\n            let rs = self.m.types[r.ty].scalar;\n            l = self.const_cast(l, rs, at, false);\n        } else if r.k == VK_CONST && r.ty < 0 {\n            let ls = self.m.types[l.ty].scalar;\n            r = self.const_cast(r, ls, at, false);\n        }\n        if self.failed {\n            return l;\n        }\n        let lt = self.concrete_type_of(l);\n        let rt = self.concrete_type_of(r);\n        let a = self.m.types[lt];\n        let b = self.m.types[rt];\n        let ln = if a.kind == TK_SCALAR { 1 } else if a.kind == TK_VECTOR { a.n } else { 0 };\n");
        buf_str(out, c"        let rn = if b.kind == TK_SCALAR { 1 } else if b.kind == TK_VECTOR { b.n } else { 0 };\n        // matrices\n        if a.kind == TK_MATRIX || b.kind == TK_MATRIX {\n            return self.matrix_op(op, l, r, lt, rt, at);\n        }\n        if ln == 0 || rn == 0 {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        let sk = a.scalar;\n        if shift {\n            if (sk != SK_I32 && sk != SK_U32) || b.scalar != SK_U32 || (ln != rn && rn != 1)\n                || (rn != 1 && ln == 1) {\n                if self.err(at, \"wgsl.type\") {\n                    self.emsg.push_fmt(\n                        f\"'{self.op_text(op)}' shifts an integer by a u32 (of the same width); got \");\n                    self.val_str(l);\n                    self.emsg.push_str(\" and \");\n                    self.val_str(r);\n                    if b.scalar == SK_I32 {\n                        self.help(\"convert the amount: u32(...)\");\n                    }\n                }\n                return l;\n            }\n            let le = self.materialize(l, lt, at);\n            var re = self.materialize(r, rt, at);\n            if ln != rn {\n                re = self.f.expr(E_SPLAT, vec_ty(SK_U32, ln), re, 0, 0);\n            }\n            if (r.k == VK_CONST && r.iv >= 32) || self.const_lanes_at_least(re, 32) {\n                self.fail(at, \"wgsl.const\", \"a constant shift amount is below 32\");\n            }\n            let e = self.f.expr(E_BINARY, lt, op, le, re);\n            return val(e, lt);\n        }\n        if sk != b.scalar {\n            self.bad_operands(self.op_text(op), l, r, at);\n            if (sk == SK_I32 && b.scalar == SK_U32) || (sk == SK_U32 && b.scalar == SK_I32) {\n                self.help(\"convert one side: u32(...) or i32(...)\");\n            } else if sk == SK_F32 || b.scalar == SK_F32 {\n                self.help(\"convert one side: f32(...)\");\n            }\n");
        buf_str(out, c"            return l;\n        }\n        let arith = op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_DIV || op == OP_MOD;\n        let cmp = op >= OP_EQ && op <= OP_GE;\n        let bits = op == OP_AND || op == OP_OR || op == OP_XOR;\n        if ln != rn && !(arith && (ln == 1 || rn == 1)) {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        if arith && sk == SK_BOOL {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        if bits && sk == SK_F32 {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        if cmp && sk == SK_BOOL && op != OP_EQ && op != OP_NE {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        let n = if ln > rn { ln } else { rn };\n        let vt = vec_ty(sk, n);\n        var le = self.materialize(l, lt, at);\n        var re = self.materialize(r, rt, at);\n        if ln < n {\n            le = self.f.expr(E_SPLAT, vt, le, 0, 0);\n        }\n        if rn < n {\n            re = self.f.expr(E_SPLAT, vt, re, 0, 0);\n        }\n        let ty = if cmp { vec_ty(SK_BOOL, n) } else { vt };\n        let e = self.f.expr(E_BINARY, ty, op, le, re);\n        val(e, ty)\n    }\n\n    fn matrix_op(inout self, op: i64, l: Val, r: Val, lt: i64, rt: i64, at: i64) -> Val {\n        let a = self.m.types[lt];\n        let b = self.m.types[rt];\n        var ty = -1;\n        if op == OP_ADD || op == OP_SUB {\n            if lt == rt {\n                ty = lt;\n            }\n        } else if op == OP_MUL {\n            if a.kind == TK_MATRIX && b.kind == TK_SCALAR && b.scalar == SK_F32 {\n                ty = lt;\n            } else if a.kind == TK_SCALAR && a.scalar == SK_F32 && b.kind == TK_MATRIX {\n                ty = rt;\n            }\n            else if a.kind == TK_MATRIX && b.kind == TK_VECTOR && b.scalar == SK_F32 && b.n == a.n {\n");
        buf_str(out, c"                ty = vec_ty(SK_F32, a.m);\n            }\n            else if a.kind == TK_VECTOR && a.scalar == SK_F32 && b.kind == TK_MATRIX && a.n == b.m {\n                ty = vec_ty(SK_F32, b.n);\n            } else if a.kind == TK_MATRIX && b.kind == TK_MATRIX && a.n == b.m {\n                ty = mat_ty(b.n, a.m);\n            }\n        }\n        if ty < 0 {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        let le = self.materialize(l, lt, at);\n        let re = self.materialize(r, rt, at);\n        let e = self.f.expr(E_BINARY, ty, op, le, re);\n        val(e, ty)\n    }\n\n    // Both sides constant scalars: the result, computed as WGSL's\n    // constant evaluation does (errors where it overflows or divides by\n    // zero).\n    fn fold(inout self, op: i64, l0: Val, r0: Val, at: i64) -> Val {\n        var l = l0;\n        var r = r0;\n        let shift = op == OP_SHL || op == OP_SHR;\n        // the common kind\n        if shift {\n            if r.sk == SK_AINT {\n                r = self.const_cast(r, SK_U32, at, false);\n            }\n            if r.sk != SK_U32 {\n                self.bad_operands(self.op_text(op), l, r, at);\n                return l;\n            }\n        } else if l.sk != r.sk {\n            if l.ty < 0 && r.ty < 0 {\n                // abstract int and abstract float: float\n                if l.sk == SK_AINT {\n                    l = cfloat(SK_AFLOAT, -1, l.iv as f64);\n                } else {\n                    r = cfloat(SK_AFLOAT, -1, r.iv as f64);\n                }\n            } else if l.ty < 0 {\n                l = self.const_cast(l, r.sk, at, false);\n            } else if r.ty < 0 {\n                r = self.const_cast(r, l.sk, at, false);\n            } else {\n                self.bad_operands(self.op_text(op), l, r, at);\n                return l;\n            }\n        }\n        if self.failed {\n            return l;\n        }\n");
        buf_str(out, c"        let sk = l.sk;\n        let ty = l.ty;\n        if op == OP_LAND || op == OP_LOR {\n            let x = if op == OP_LAND { l.iv != 0 && r.iv != 0 } else { l.iv != 0 || r.iv != 0 };\n            return cint(SK_BOOL, T_BOOL, if x { 1 } else { 0 });\n        }\n        if op >= OP_EQ && op <= OP_GE {\n            var c = 0;\n            if sk == SK_F32 || sk == SK_AFLOAT {\n                let x = l.fv;\n                let y = r.fv;\n                c = if op == OP_EQ { (x == y) as i64 } else if op == OP_NE { (x != y) as i64 }\n                    else if op == OP_LT { (x < y) as i64 } else if op == OP_LE { (x <= y) as i64 }\n                    else if op == OP_GT { (x > y) as i64 } else { (x >= y) as i64 };\n            } else {\n                if sk == SK_BOOL && op != OP_EQ && op != OP_NE {\n                    self.bad_operands(self.op_text(op), l, r, at);\n                    return l;\n                }\n                let x = l.iv;\n                let y = r.iv;\n                c = if op == OP_EQ { (x == y) as i64 } else if op == OP_NE { (x != y) as i64 }\n                    else if op == OP_LT { (x < y) as i64 } else if op == OP_LE { (x <= y) as i64 }\n                    else if op == OP_GT { (x > y) as i64 } else { (x >= y) as i64 };\n            }\n            return cint(SK_BOOL, T_BOOL, c);\n        }\n        if sk == SK_BOOL {\n            if op == OP_AND || op == OP_OR || op == OP_XOR {\n                let x = if op == OP_AND { l.iv & r.iv } else if op == OP_OR { l.iv | r.iv }\n                    else { l.iv ^ r.iv };\n                return cint(SK_BOOL, T_BOOL, x);\n            }\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        if sk == SK_F32 || sk == SK_AFLOAT {\n            if op == OP_AND || op == OP_OR || op == OP_XOR || shift {\n                self.bad_operands(self.op_text(op), l, r, at);\n                return l;\n            }\n            let x = l.fv;\n");
        buf_str(out, c"            let y = r.fv;\n            var z = 0.0;\n            if sk == SK_F32 {\n                let a = x as f32;\n                let b = y as f32;\n                let zz = if op == OP_ADD { a + b } else if op == OP_SUB { a - b }\n                    else if op == OP_MUL { a * b } else if op == OP_DIV { a / b }\n                    else { a - b * trunc32(a / b) };\n                z = zz as f64;\n            } else {\n                z = if op == OP_ADD { x + y } else if op == OP_SUB { x - y }\n                    else if op == OP_MUL { x * y } else if op == OP_DIV { x / y }\n                    else { x - y * trunc64(x / y) };\n            }\n            if z != z || z > 1.7976931348623157e308 || z < -1.7976931348623157e308\n                || (sk == SK_F32 && (z > F32_MAX || z < -F32_MAX)) {\n                self.fail(at, \"wgsl.const\",\n                    \"this constant expression overflows or is not a number\");\n            }\n            return cfloat(sk, ty, z);\n        }\n        // integers: i32, u32, abstract (i64)\n        let x = l.iv;\n        let y = r.iv;\n        var z: i64 = 0;\n        if op == OP_ADD {\n            z = x + y;\n            if sk == SK_AINT && ((x > 0 && y > 0 && z < 0) || (x < 0 && y < 0 && z >= 0)) {\n                self.fail(at, \"wgsl.const\", \"this constant overflows 64 bits\");\n            }\n        } else if op == OP_SUB {\n            z = x - y;\n            if sk == SK_AINT && ((x >= 0 && y < 0 && z < 0) || (x < 0 && y > 0 && z >= 0)) {\n                self.fail(at, \"wgsl.const\", \"this constant overflows 64 bits\");\n            }\n        } else if op == OP_MUL {\n            z = x * y;\n            if sk == SK_AINT && x != 0\n                && (z / x != y || (x == -1 && y == -9223372036854775807 - 1)) {\n                self.fail(at, \"wgsl.const\", \"this constant overflows 64 bits\");\n            }\n        } else if op == OP_DIV || op == OP_MOD {\n            if y == 0 {\n");
        buf_str(out, c"                self.fail(at, \"wgsl.const\", \"a constant expression divides by zero\");\n                return l;\n            }\n            z = if op == OP_DIV { x / y } else { x % y };\n        } else if op == OP_AND {\n            z = x & y;\n        } else if op == OP_OR {\n            z = x | y;\n        } else if op == OP_XOR {\n            z = x ^ y;\n        } else if op == OP_SHL || op == OP_SHR {\n            let width = if sk == SK_AINT { 64 } else { 32 };\n            if y >= width {\n                self.fail(at, \"wgsl.const\",\n                    \"a constant shift amount is below the width of the shifted type\");\n                return l;\n            }\n            if op == OP_SHL {\n                z = x << y;\n            } else if sk == SK_U32 {\n                z = (x & U32_MAX) >> y;\n            } else {\n                z = x >> y;\n            }\n        }\n        if sk == SK_I32 {\n            if op == OP_SHL {\n                z = (z & U32_MAX) as i32 as i64;\n            } else if z < I32_MIN || z > I32_MAX {\n                self.fail(at, \"wgsl.const\", \"this constant expression overflows an i32\");\n            }\n        } else if sk == SK_U32 {\n            if op == OP_SHL {\n                z = z & U32_MAX;\n            } else if z < 0 || z > U32_MAX {\n                self.fail(at, \"wgsl.const\", \"this constant expression overflows a u32\");\n            }\n        }\n        cint(sk, ty, z)\n    }\n\n    // ---- Indexing and members ----\n\n    fn index(inout self, base: Val, i0: Val, at: i64, ip: i64) -> Val {\n        if self.failed {\n            return base;\n        }\n        let i = self.value(i0, ip);\n        let it = self.concrete_type_of(i);\n        if it != T_I32 && it != T_U32 {\n            if self.err(ip, \"wgsl.type\") {\n                self.emsg.push_str(\"an index is an i32 or a u32, not \");\n                self.val_str(i);\n            }\n            return base;\n        }\n");
        buf_str(out, c"        let is_ref = base.k == VK_REF;\n        let bv = if is_ref { base } else { self.value(base, at) };\n        if bv.k == VK_CONST {\n            self.fail(at, \"wgsl.type\", \"a scalar cannot be indexed\");\n            return base;\n        }\n        let bt = if is_ref { self.m.pointee(bv.ty) } else { bv.ty };\n        let t = self.m.types[bt];\n        if t.kind != TK_ARRAY && t.kind != TK_VECTOR && t.kind != TK_MATRIX {\n            if self.err(at, \"wgsl.type\") {\n                self.emsg.push_str(\"cannot index \");\n                self.val_str(bv);\n                if t.kind == TK_POINTER {\n                    self.help(\"dereference the pointer first: (*p)[i]\");\n                }\n            }\n            return base;\n        }\n        let el = self.m.elem_of(bt);\n        let n = self.m.index_len(bt);\n        let rty = if is_ref {\n            let pt = self.m.types[bv.ty];\n            self.m.ptr_ty(el, pt.space, pt.access)\n        } else {\n            el\n        };\n        if i.k == VK_CONST && n > 0 {\n            if i.iv < 0 || i.iv >= n {\n                if self.err(ip, \"wgsl.index\") {\n                    self.emsg.push_fmt(f\"index {i.iv} is out of range: the length is {n}\");\n                }\n                return base;\n            }\n            let e = self.f.expr(E_ACCESS_INDEX, rty, bv.e, i.iv, 0);\n            return Val {\n                k: if is_ref { VK_REF } else { VK_VALUE }, sk: 0, e: e, ty: rty, iv: 0, fv: 0.0\n            };\n        }\n        let ie = self.materialize(i, it, ip);\n        let e = self.f.expr(E_ACCESS, rty, bv.e, ie, ir::CK_PENDING);\n        Val { k: if is_ref { VK_REF } else { VK_VALUE }, sk: 0, e: e, ty: rty, iv: 0, fv: 0.0 }\n    }\n\n    fn member(inout self, base: Val, name: [u8], at: i64) -> Val {\n        if self.failed {\n            return base;\n        }\n        let is_ref = base.k == VK_REF;\n        let bv = if is_ref { base } else { self.value(base, at) };\n");
        buf_str(out, c"        if bv.k == VK_CONST {\n            if self.err(at, \"wgsl.type\") {\n                self.emsg.push_fmt(f\"a scalar has no member '{name}'\");\n            }\n            return base;\n        }\n        let bt = if is_ref { self.m.pointee(bv.ty) } else { bv.ty };\n        let t = self.m.types[bt];\n        if t.kind == TK_STRUCT {\n            for i in 0..t.mcount {\n                let mem = self.m.members[t.mstart + i];\n                if mem.name == name {\n                    let rty = if is_ref {\n                        let pt = self.m.types[bv.ty];\n                        self.m.ptr_ty(mem.ty, pt.space, pt.access)\n                    } else {\n                        mem.ty\n                    };\n                    let e = self.f.expr(E_ACCESS_INDEX, rty, bv.e, i, 0);\n                    return Val {\n                        k: if is_ref { VK_REF } else { VK_VALUE }, sk: 0, e: e, ty: rty, iv: 0,\n                        fv: 0.0\n                    };\n                }\n            }\n            if self.err(at, \"wgsl.member\") {\n                self.emsg.push_fmt(f\"'{t.name}' has no member '{name}'\");\n                self.ehelp.push_str(\"its members are \");\n                for i in 0..t.mcount {\n                    if i > 0 {\n                        self.ehelp.push_str(\", \");\n                    }\n                    self.ehelp.push_str(self.m.members[t.mstart + i].name);\n                }\n            }\n            return base;\n        }\n        if t.kind == TK_VECTOR {\n            var pat = 0;\n            let n = name.len;\n            var set = -1;\n            if n > 4 {\n                self.fail(at, \"wgsl.member\", \"a swizzle has at most 4 components\");\n                return base;\n            }\n            for i in 0..n {\n                let c = name[i];\n                let (comp, s) = if c == 'x' {\n                    (0, 0)\n                } else if c == 'y' {\n                    (1, 0)\n");
        buf_str(out, c"                } else if c == 'z' {\n                    (2, 0)\n                } else if c == 'w' {\n                    (3, 0)\n                } else if c == 'r' {\n                    (0, 1)\n                } else if c == 'g' {\n                    (1, 1)\n                } else if c == 'b' {\n                    (2, 1)\n                } else if c == 'a' {\n                    (3, 1)\n                } else {\n                    (-1, -1)\n                };\n                if comp < 0 || comp >= t.n || (set >= 0 && s != set) {\n                    if self.err(at, \"wgsl.member\") {\n                        self.emsg.push_fmt(f\"'.{name}' is not a component of a vec{t.n}\");\n                        self.help(\"components are x y z w (or r g b a), not mixed\");\n                    }\n                    return base;\n                }\n                set = s;\n                pat = pat | (comp << (2 * i));\n            }\n            if n == 1 {\n                let rty = if is_ref {\n                    let pt = self.m.types[bv.ty];\n                    self.m.ptr_ty(t.scalar as i64, pt.space, pt.access)\n                } else {\n                    t.scalar as i64\n                };\n                let e = self.f.expr(E_ACCESS_INDEX, rty, bv.e, pat, 0);\n                return Val {\n                    k: if is_ref { VK_REF } else { VK_VALUE }, sk: 0, e: e, ty: rty, iv: 0, fv: 0.0\n                };\n            }\n            let v = self.value(bv, at);\n            let rty = vec_ty(t.scalar, n);\n            let e = self.f.expr(E_SWIZZLE, rty, v.e, pat, n);\n            return val(e, rty);\n        }\n        if self.err(at, \"wgsl.member\") {\n            self.emsg.push_fmt(f\"'.{name}': \");\n            self.val_str(bv);\n            self.emsg.push_str(\" has no members\");\n            if t.kind == TK_POINTER {\n                self.help(\"dereference the pointer first: (*p).member\");\n            }\n        }\n        base\n    }\n}\n\n");
        buf_str(out, c"fn trunc32(x: f32) -> f32 {\n    if x != x || x > 8388608.0 || x < -8388608.0 {\n        return x;\n    }\n    (x as i64) as f32\n}\n\nfn trunc64(x: f64) -> f64 {\n    if x != x || x > 4503599627370496.0 || x < -4503599627370496.0 {\n        return x;\n    }\n    (x as i64) as f64\n}\n\n// A hexadecimal float literal's value, `0x1.8p3` (WGSL's: mantissa digits,\n// an optional point, `p` and a decimal exponent of two), exact while the\n// mantissa fits in 53 bits.\nfn hex_float(s: [u8]) -> f64 {\n    var man: f64 = 0.0;\n    var e: i64 = 0;\n    var i = 2;\n    var after_point = false;\n    while i < s.len && s[i] != 'p' && s[i] != 'P' {\n        let c = s[i];\n        if c == '.' {\n            after_point = true;\n        } else {\n            let d = if c >= '0' && c <= '9' { c - '0' }\n                else if c >= 'a' && c <= 'f' { c - 'a' + 10 } else { c - 'A' + 10 };\n            man = man * 16.0 + d as f64;\n            if after_point {\n                e -= 4;\n            }\n        }\n        i += 1;\n    }\n    if i < s.len {\n        i += 1;\n        var neg = false;\n        if i < s.len && (s[i] == '+' || s[i] == '-') {\n            neg = s[i] == '-';\n            i += 1;\n        }\n        var x: i64 = 0;\n        while i < s.len && s[i] >= '0' && s[i] <= '9' && x < 100000 {\n            x = x * 10 + (s[i] - '0') as i64;\n            i += 1;\n        }\n        e += if neg { -x } else { x };\n    }\n    // times 2^e, by exact steps\n    var v = man;\n    while e > 0 && v < 1.0e300 {\n        v = v * 2.0;\n        e -= 1;\n    }\n    while e < 0 && v != 0.0 {\n        v = v * 0.5;\n        e += 1;\n    }\n    v\n}\n// ---- end mod std::gpu::wgsl::expr ----\n}\n// ---- mod std::gpu::wgsl::builtins ----\npub mod builtins {\n// ---- Shader compiler implementation, builtins (0.22) ----\n// Calls: user functions, value constructors (`vec3<f32>(...)`, `S(...)`,\n// inferred `vec3(...)` and `array(...)`), and WGSL's builtin functions\n");
        buf_str(out, c"// with their overloads.\n\nuse front::{Front, VK_CONST, VK_REF, VK_VALUE, VK_VOID, Val, cint, val};\nuse ir::{\n    ACC_RW, AT_ADD, AT_AND, AT_CMPXCHG, AT_EXCHANGE, AT_LOAD, AT_MAX, AT_MIN, AT_OR, AT_STORE,\n    AT_SUB, AT_XOR, BARRIER_STORAGE, BARRIER_WORKGROUP, E_ARRAY_LENGTH, E_ATOMIC_RESULT, E_BITCAST,\n    E_COMPOSE, E_CONVERT, E_DERIVATIVE, E_GLOBAL, E_IMAGE_LOAD, E_IMAGE_QUERY, E_IMAGE_SAMPLE,\n    E_MATH, E_SELECT, E_SPLAT, E_WG_UNIFORM_RESULT, E_ZERO, IMG_SAMPLE, IMG_SAMPLE_BIAS,\n    IMG_SAMPLE_COMPARE, IMG_SAMPLE_COMPARE_LEVEL, IMG_SAMPLE_LEVEL, IQ_LAYERS, IQ_LEVELS, IQ_SIZE,\n    MF_ALL, MF_ANY, MF_CROSS, MF_DETERMINANT, MF_DISTANCE, MF_DOT, MF_EXTRACT_BITS, MF_INSERT_BITS,\n    MF_LDEXP, MF_LENGTH, MF_TRANSPOSE, SK_AFLOAT, SK_AINT, SK_BOOL, SK_F32, SK_I32, SK_U32,\n    SP_HANDLE, SP_STORAGE, SP_WORKGROUP, STAGE_COMPUTE, STAGE_FRAGMENT, S_ATOMIC, S_BARRIER,\n    S_IMAGE_STORE, S_WG_UNIFORM_LOAD, StructMember, TEX_2D_ARRAY, TEX_DEPTH_2D, TEX_STORAGE_2D,\n    TK_ARRAY, TK_ATOMIC, TK_MATRIX, TK_POINTER, TK_SAMPLER, TK_SCALAR, TK_STRUCT, TK_TEXTURE,\n    TK_VECTOR, T_BOOL, T_F32, T_I32, T_U32, mat_ty, vec_ty,\n};\nuse lex::{T_COMMA, T_EOF, T_LPAREN, T_LT, T_RPAREN};\nuse names::{\n    K_ARRAY, K_ARRAY_LENGTH, K_ATOMIC_ADD, K_ATOMIC_AND, K_ATOMIC_COMPARE_EXCHANGE_WEAK,\n    K_ATOMIC_EXCHANGE, K_ATOMIC_LOAD, K_ATOMIC_MAX, K_ATOMIC_MIN, K_ATOMIC_OR, K_ATOMIC_STORE,\n    K_ATOMIC_SUB, K_ATOMIC_XOR, K_BITCAST, K_DPDX, K_FWIDTH_FINE, K_MAT2X2, K_MAT4X4, K_MATH_FIRST,\n    K_MATH_LAST, K_SELECT, K_STORAGE_BARRIER, K_TEXTURE_DIMENSIONS, K_TEXTURE_LOAD,\n    K_TEXTURE_NUM_LAYERS, K_TEXTURE_NUM_LEVELS, K_TEXTURE_SAMPLE, K_TEXTURE_SAMPLE_BIAS,\n    K_TEXTURE_SAMPLE_COMPARE, K_TEXTURE_SAMPLE_COMPARE_LEVEL, K_TEXTURE_SAMPLE_LEVEL,\n    K_TEXTURE_STORE, K_VEC2, K_VEC4, K_WORKGROUP_BARRIER, K_WORKGROUP_UNIFORM_LOAD,\n};\n\nimpl Front {\n    // The arguments of a call, from its `(`: pushed on astack (positions\n");
        buf_str(out, c"    // on apos); returns their first index. `hint`: each argument's\n    // expected type, or -1.\n    fn args(inout self, hint: i64) -> i64 {\n        let base = self.astack.len();\n        self.expect(T_LPAREN);\n        while self.kind() != T_RPAREN && self.kind() != T_EOF {\n            let p = self.pos();\n            let v = self.parse_expr_hint(hint);\n            self.apos.push(p);\n            self.astack.push(v);\n            if !self.eat(T_COMMA) {\n                break;\n            }\n        }\n        self.expect(T_RPAREN);\n        self.last_call_end = self.p;\n        base\n    }\n\n    fn drop_args(inout self, base: i64) {\n        self.astack.truncate(base);\n        self.apos.truncate(base);\n    }\n\n    fn arg_count_error(inout self, at: i64, name: [u8], want: [u8], got: i64) {\n        if self.err(at, \"wgsl.call\") {\n            self.emsg.push_fmt(f\"'{name}' takes {want}, got {got}\");\n        }\n    }\n\n    // ---- User functions ----\n\n    pub fn user_call(inout self, fh: i64, at: i64) -> Val {\n        // the function being lowered has its signature in self.f\n        let nparams = if fh == self.fh { self.f.params.len() }\n            else { self.m.functions[fh].params.len() };\n        let base = self.estack.len();\n        self.expect(T_LPAREN);\n        var n = 0;\n        while self.kind() != T_RPAREN && self.kind() != T_EOF {\n            let ap = self.pos();\n            let hint = if n < nparams { self.param_ty(fh, n) } else { -1 };\n            let v = self.parse_expr_hint(hint);\n            if n < nparams {\n                let pt = self.param_ty(fh, n);\n                var ok = true;\n                if self.m.types[pt].kind == TK_POINTER && v.k == VK_REF {\n                    ok = false;\n                    if self.err(ap, \"wgsl.type\") {\n                        self.emsg.push_str(\"expected a pointer, got a reference\");\n                        self.help(\"pass its address: &x\");\n                    }\n");
        buf_str(out, c"                }\n                if ok {\n                    let e = self.materialize(v, pt, ap);\n                    self.estack.push(e);\n                }\n            }\n            n += 1;\n            if !self.eat(T_COMMA) {\n                break;\n            }\n        }\n        self.expect(T_RPAREN);\n        if n != nparams {\n            if self.err(at, \"wgsl.call\") {\n                self.emsg.push('\\'');\n                if fh == self.fh {\n                    self.emsg.push_str(self.f.name);\n                } else {\n                    self.emsg.push_str(self.m.functions[fh].name);\n                }\n                self.emsg.push_fmt(f\"' takes {nparams} argument\");\n                if nparams != 1 {\n                    self.emsg.push('s');\n                }\n                self.emsg.push_fmt(f\", got {n}\");\n            }\n            self.estack.truncate(base);\n            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n        }\n        let start = self.f.args.len();\n        for i in base..self.estack.len() {\n            self.f.args.push(self.estack[i]);\n        }\n        self.estack.truncate(base);\n        let r = self.call_stmt(fh, start, n);\n        self.last_call_end = self.p;\n        r\n    }\n\n    fn param_ty(self, fh: i64, i: i64) -> i64 {\n        if fh == self.fh {\n            self.f.params[i].ty\n        } else {\n            self.m.functions[fh].params[i].ty\n        }\n    }\n\n    // ---- Constructors ----\n\n    // `T(args)` for a known type T, from the `(`.\n    pub fn construct(inout self, ty: i64, at: i64) -> Val {\n        if self.kind() != T_LPAREN {\n            if self.err(self.pos(), \"wgsl.syntax\") {\n                self.emsg.push_str(\"a type here is a constructor: '\");\n                self.ty_str(ty);\n                self.emsg.push_str(\"(...)'\");\n            }\n            return cint(SK_AINT, -1, 0);\n        }\n        let t = self.m.types[ty];\n");
        buf_str(out, c"        let hint = if t.kind == TK_VECTOR || t.kind == TK_MATRIX {\n            t.scalar as i64\n        } else if t.kind == TK_ARRAY {\n            t.base\n        } else {\n            -1\n        };\n        let base = self.args(hint);\n        let n = self.astack.len() - base;\n        let r = self.construct_from(ty, base, n, at);\n        self.drop_args(base);\n        r\n    }\n\n    fn construct_from(inout self, ty: i64, base: i64, n: i64, at: i64) -> Val {\n        let t = self.m.types[ty];\n        if n == 0 {\n            if !self.storable(ty) || self.m.has_atomic(ty) || self.m.is_runtime_sized(ty) {\n                if self.err(at, \"wgsl.type\") {\n                    self.emsg.push_str(\"cannot construct \");\n                    self.ty_str(ty);\n                }\n                return cint(SK_AINT, -1, 0);\n            }\n            if t.kind == TK_SCALAR {\n                return if t.scalar == SK_F32 { front::cfloat(SK_F32, ty, 0.0) }\n                    else { cint(t.scalar, ty, 0) };\n            }\n            let e = self.f.expr(E_ZERO, ty, 0, 0, 0);\n            return val(e, ty);\n        }\n        if t.kind == TK_SCALAR {\n            if n != 1 {\n                self.arg_count_error(at, \"a scalar constructor\", \"one argument\", n);\n                return cint(SK_AINT, -1, 0);\n            }\n            return self.convert_value(self.astack[base], ty, self.apos[base]);\n        }\n        if t.kind == TK_VECTOR {\n            return self.construct_vector(t.scalar, t.n, base, n, at);\n        }\n        if t.kind == TK_MATRIX {\n            return self.construct_matrix(t.n, t.m, base, n, at);\n        }\n        if t.kind == TK_ARRAY {\n            if t.n == 0 {\n                self.fail(at, \"wgsl.type\", \"a runtime-sized array cannot be constructed\");\n                return cint(SK_AINT, -1, 0);\n            }\n            if n != t.n {\n                if self.err(at, \"wgsl.call\") {\n");
        buf_str(out, c"                    self.emsg.push_fmt(f\"this array has {t.n} elements, got {n}\");\n                }\n                return cint(SK_AINT, -1, 0);\n            }\n            return self.compose_args(ty, t.base, base, n);\n        }\n        if t.kind == TK_STRUCT {\n            if n != t.mcount {\n                if self.err(at, \"wgsl.call\") {\n                    self.emsg.push_fmt(f\"'{t.name}' has {t.mcount} members, got {n} arguments\");\n                }\n                return cint(SK_AINT, -1, 0);\n            }\n            let start = self.estack.len();\n            for i in 0..n {\n                let mt = self.m.members[t.mstart + i].ty;\n                let e = self.materialize(self.astack[base + i], mt, self.apos[base + i]);\n                self.estack.push(e);\n            }\n            return self.compose_from_estack(ty, start);\n        }\n        if self.err(at, \"wgsl.type\") {\n            self.emsg.push_str(\"cannot construct \");\n            self.ty_str(ty);\n        }\n        cint(SK_AINT, -1, 0)\n    }\n\n    fn compose_args(inout self, ty: i64, el: i64, base: i64, n: i64) -> Val {\n        let start = self.estack.len();\n        for i in 0..n {\n            let e = self.materialize(self.astack[base + i], el, self.apos[base + i]);\n            self.estack.push(e);\n        }\n        self.compose_from_estack(ty, start)\n    }\n\n    fn compose_from_estack(inout self, ty: i64, start: i64) -> Val {\n        let a = self.f.args.len();\n        for i in start..self.estack.len() {\n            self.f.args.push(self.estack[i]);\n        }\n        let n = self.estack.len() - start;\n        self.estack.truncate(start);\n        let e = self.f.expr(E_COMPOSE, ty, a, n, 0);\n        val(e, ty)\n    }\n\n    // A value conversion `T(v)`: scalar to scalar, or vector to vector of\n    // the same width.\n    fn convert_value(inout self, v0: Val, ty: i64, at: i64) -> Val {\n        let v = self.value(v0, at);\n        let t = self.m.types[ty];\n");
        buf_str(out, c"        if v.k == VK_CONST {\n            if t.kind == TK_SCALAR {\n                return self.const_cast(v, t.scalar, at, true);\n            }\n            return self.convert_to(v, ty, at);\n        }\n        if self.failed {\n            return v;\n        }\n        let vt = self.m.types[v.ty];\n        if v.ty == ty {\n            return v;\n        }\n        let w = self.m.width_of(v.ty);\n        if w == 0 || w != self.m.width_of(ty) {\n            if self.err(at, \"wgsl.type\") {\n                self.emsg.push_str(\"cannot convert \");\n                self.val_str(v);\n                self.emsg.push_str(\" to \");\n                self.ty_str(ty);\n            }\n            return v;\n        }\n        let _ = vt;\n        let e = self.f.expr(E_CONVERT, ty, v.e, 0, 0);\n        val(e, ty)\n    }\n\n    // The scalar kind of a value's components (abstract kinds included).\n    fn comp_kind(self, v: Val) -> u8 {\n        if v.k == VK_CONST {\n            return v.sk;\n        }\n        let t = self.concrete_type_of(v);\n        self.m.types[t].scalar\n    }\n\n    // The concrete scalar the arguments base .. base + n share: a\n    // concrete argument's, else (all abstract) the hint's, else f32 when\n    // one is a float, else `dflt`.\n    fn common_scalar(self, base: i64, n: i64, hint_sk: i64, dflt: u8) -> u8 {\n        var any_float = false;\n        for i in base..base + n {\n            let v = self.astack[i];\n            if v.k == VK_CONST && v.ty < 0 {\n                if v.sk == SK_AFLOAT {\n                    any_float = true;\n                }\n                continue;\n            }\n            return self.comp_kind(v);\n        }\n        if hint_sk >= 0 && hint_sk <= 3 {\n            let h = hint_sk as u8;\n            if !(any_float && h != SK_F32) {\n                return h;\n            }\n        }\n        if any_float { SK_F32 } else { dflt }\n    }\n\n");
        buf_str(out, c"    fn construct_vector(inout self, sk: u8, n: i64, base: i64, count: i64, at: i64) -> Val {\n        let ty = vec_ty(sk, n);\n        if count == 1 {\n            let v = self.value(self.astack[base], self.apos[base]);\n            let w = if v.k == VK_CONST { 1 } else { self.m.width_of(v.ty) };\n            if w == 1 {\n                let e = self.materialize(v, sk as i64, self.apos[base]);\n                let s = self.f.expr(E_SPLAT, ty, e, 0, 0);\n                return val(s, ty);\n            }\n            if w == n {\n                return self.convert_value(v, ty, self.apos[base]);\n            }\n        }\n        let start = self.estack.len();\n        var total = 0;\n        for i in base..base + count {\n            let v = self.value(self.astack[i], self.apos[i]);\n            if v.k == VK_CONST {\n                let e = self.materialize(v, sk as i64, self.apos[i]);\n                self.estack.push(e);\n                total += 1;\n                continue;\n            }\n            let vt = self.m.types[v.ty];\n            if vt.kind == TK_SCALAR {\n                let e = self.materialize(v, sk as i64, self.apos[i]);\n                self.estack.push(e);\n                total += 1;\n            } else if vt.kind == TK_VECTOR {\n                let e = self.materialize(v, vec_ty(sk, vt.n), self.apos[i]);\n                self.estack.push(e);\n                total += vt.n;\n            } else {\n                if self.err(self.apos[i], \"wgsl.type\") {\n                    self.emsg.push_str(\"a vector is made of scalars and vectors, not \");\n                    self.val_str(v);\n                }\n                self.estack.truncate(start);\n                return cint(SK_AINT, -1, 0);\n            }\n        }\n        if total != n {\n            if self.err(at, \"wgsl.call\") {\n                self.emsg.push_fmt(f\"a vec{n} needs {n} components, got {total}\");\n            }\n            self.estack.truncate(start);\n");
        buf_str(out, c"            return cint(SK_AINT, -1, 0);\n        }\n        self.compose_from_estack(ty, start)\n    }\n\n    fn construct_matrix(inout self, c: i64, r: i64, base: i64, count: i64, at: i64) -> Val {\n        let ty = mat_ty(c, r);\n        let col = vec_ty(SK_F32, r);\n        if count == 1 {\n            let v = self.value(self.astack[base], self.apos[base]);\n            if v.k == VK_VALUE && v.ty == ty {\n                return v;\n            }\n        }\n        let start = self.estack.len();\n        if count == c {\n            for i in base..base + count {\n                let e = self.materialize(self.astack[i], col, self.apos[i]);\n                self.estack.push(e);\n            }\n            return self.compose_from_estack(ty, start);\n        }\n        if count == c * r {\n            for k in 0..c {\n                let cs = self.estack.len();\n                for j in 0..r {\n                    let i = base + k * r + j;\n                    let e = self.materialize(self.astack[i], T_F32, self.apos[i]);\n                    self.estack.push(e);\n                }\n                let colv = self.compose_from_estack(col, cs);\n                self.estack.push(colv.e);\n            }\n            return self.compose_from_estack(ty, start);\n        }\n        if self.err(at, \"wgsl.call\") {\n            self.emsg.push_fmt(\n                f\"a mat{c}x{r} is made of {c} columns or {c * r} scalars, got {count} arguments\");\n        }\n        cint(SK_AINT, -1, 0)\n    }\n\n    // ---- Builtins ----\n\n    pub fn builtin_primary(inout self, s: i64, at: i64, hint: i64) -> Val {\n        // inferred constructors\n        if s >= K_VEC2 && s <= K_VEC4 && self.kind_at(self.p + 1) == T_LPAREN {\n            self.p += 1;\n            let n = s - K_VEC2 + 2;\n            let hs = if hint >= 0 { self.m.types[hint].scalar as i64 } else { -1 };\n            let hk = if hint >= 0 { self.m.types[hint].kind } else { 255 };\n");
        buf_str(out, c"            let base = self.args(if hk == TK_VECTOR || hk == TK_SCALAR { hs } else { -1 });\n            let cnt = self.astack.len() - base;\n            let sk = self.common_scalar(base, cnt,\n                if hk == TK_VECTOR || hk == TK_SCALAR { hs } else { -1 }, SK_I32);\n            let r = if cnt == 0 { self.construct_from(vec_ty(sk, n), base, 0, at) }\n                else { self.construct_vector(sk, n, base, cnt, at) };\n            self.drop_args(base);\n            return r;\n        }\n        if s >= K_MAT2X2 && s <= K_MAT4X4 && self.kind_at(self.p + 1) == T_LPAREN {\n            self.p += 1;\n            let i = s - K_MAT2X2;\n            let base = self.args(T_F32);\n            let cnt = self.astack.len() - base;\n            let r = if cnt == 0 {\n                self.construct_from(mat_ty(i / 3 + 2, i % 3 + 2), base, 0, at)\n            } else {\n                self.construct_matrix(i / 3 + 2, i % 3 + 2, base, cnt, at)\n            };\n            self.drop_args(base);\n            return r;\n        }\n        if s == K_ARRAY && self.kind_at(self.p + 1) == T_LPAREN {\n            self.p += 1;\n            let he = if hint >= 0 && self.m.types[hint].kind == TK_ARRAY { self.m.types[hint].base }\n                else { -1 };\n            let base = self.args(he);\n            let cnt = self.astack.len() - base;\n            if cnt == 0 {\n                self.fail(at, \"wgsl.call\",\n                    \"'array()' needs its elements, or a type: 'array<f32, 4>()'\");\n                self.drop_args(base);\n                return cint(SK_AINT, -1, 0);\n            }\n            // the element type: a concrete element's, else the hint's, else the default\n            var el = -1;\n            for i in base..base + cnt {\n                let v = self.astack[i];\n                if !(v.k == VK_CONST && v.ty < 0) {\n                    el = self.concrete_type_of(v);\n                    break;\n                }\n            }\n            if el < 0 {\n");
        buf_str(out, c"                el = if he >= 0 { he } else { self.concrete_type_of(self.astack[base]) };\n            }\n            let ty = self.m.array_ty(el, cnt);\n            let r = self.compose_args(ty, el, base, cnt);\n            self.drop_args(base);\n            return r;\n        }\n        if self.is_type_name(s) {\n            let ty = self.parse_type();\n            return self.construct(ty, at);\n        }\n        self.p += 1;\n        if self.kind() != T_LPAREN {\n            if s == K_BITCAST && self.kind() == T_LT {\n                self.p += 1;\n                let ty = self.parse_type();\n                self.expect_gt();\n                return self.bitcast(ty, at);\n            }\n            if self.err(at, \"wgsl.name\") {\n                self.emsg.push_fmt(f\"unknown name '{self.name_of(s)}'\");\n            }\n            return cint(SK_AINT, -1, 0);\n        }\n        if s >= K_MATH_FIRST && s <= K_MATH_LAST {\n            return self.math(s - K_MATH_FIRST, s, at);\n        }\n        if s == K_SELECT {\n            return self.select(at);\n        }\n        if s == K_ARRAY_LENGTH {\n            return self.array_length(at);\n        }\n        if s >= K_ATOMIC_LOAD && s <= K_ATOMIC_COMPARE_EXCHANGE_WEAK {\n            return self.atomic(s, at);\n        }\n        if s == K_WORKGROUP_BARRIER || s == K_STORAGE_BARRIER {\n            let base = self.args(-1);\n            let n = self.astack.len() - base;\n            self.drop_args(base);\n            if n != 0 {\n                self.arg_count_error(at, self.name_of(s), \"no arguments\", n);\n            }\n            if self.stage != STAGE_COMPUTE as i64 && self.stage != 255 {\n                self.fail(at, \"wgsl.stage\", \"barriers are for compute shaders\");\n            }\n            self.push_stmt(S_BARRIER,\n                if s == K_WORKGROUP_BARRIER { BARRIER_WORKGROUP } else { BARRIER_STORAGE }, 0, 0,\n                0);\n");
        buf_str(out, c"            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n        }\n        if s == K_WORKGROUP_UNIFORM_LOAD {\n            let base = self.args(-1);\n            let n = self.astack.len() - base;\n            if n != 1 {\n                self.drop_args(base);\n                self.arg_count_error(at, \"workgroupUniformLoad\", \"one pointer\", n);\n                return cint(SK_AINT, -1, 0);\n            }\n            let p = self.value(self.astack[base], self.apos[base]);\n            self.drop_args(base);\n            let pt = if p.k == VK_VALUE { self.m.types[p.ty] } else { self.m.types[T_I32] };\n            if pt.kind != TK_POINTER || pt.space != SP_WORKGROUP || self.m.has_atomic(pt.base) {\n                self.fail(at, \"wgsl.type\",\n                    \"workgroupUniformLoad takes a pointer to workgroup memory (not an atomic): &x\");\n                return cint(SK_AINT, -1, 0);\n            }\n            let r = self.unemitted(E_WG_UNIFORM_RESULT, pt.base);\n            self.push_stmt(S_WG_UNIFORM_LOAD, p.e, r, 0, 0);\n            return val(r, pt.base);\n        }\n        if s >= K_DPDX && s <= K_FWIDTH_FINE {\n            let k = (s - K_DPDX) % 3;\n            let base = self.args(-1);\n            let n = self.astack.len() - base;\n            if n != 1 {\n                self.drop_args(base);\n                self.arg_count_error(at, self.name_of(s), \"one argument\", n);\n                return cint(SK_AINT, -1, 0);\n            }\n            if self.stage != STAGE_FRAGMENT as i64 && self.stage != 255 {\n                self.fail(at, \"wgsl.stage\", \"derivatives are for fragment shaders\");\n            }\n            let ty = self.float_type(self.astack[base], self.apos[base]);\n            let e0 = self.materialize(self.astack[base], ty, self.apos[base]);\n            self.drop_args(base);\n            let e = self.f.expr(E_DERIVATIVE, ty, k, e0, 0);\n            return val(e, ty);\n        }\n");
        buf_str(out, c"        if s >= K_TEXTURE_SAMPLE && s <= K_TEXTURE_NUM_LAYERS {\n            return self.texture_call(s, at);\n        }\n        if self.err(at, \"wgsl.name\") {\n            self.emsg.push_fmt(f\"unknown function '{self.name_of(s)}'\");\n        }\n        cint(SK_AINT, -1, 0)\n    }\n\n    // An f32 scalar or vector type for v (abstract numbers become f32).\n    fn float_type(inout self, v: Val, at: i64) -> i64 {\n        if v.k == VK_CONST && v.ty < 0 {\n            return T_F32;\n        }\n        let t = self.concrete_type_of(v);\n        let tt = self.m.types[t];\n        if (tt.kind != TK_SCALAR && tt.kind != TK_VECTOR) || tt.scalar != SK_F32 {\n            if self.err(at, \"wgsl.type\") {\n                self.emsg.push_str(\"expected f32 or vecN<f32>, got \");\n                self.val_str(v);\n                if tt.scalar == SK_I32 || tt.scalar == SK_U32 {\n                    self.help(\"convert it: f32(...)\");\n                }\n            }\n            return T_F32;\n        }\n        t\n    }\n\n    fn bitcast(inout self, ty: i64, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() - base;\n        if n != 1 {\n            self.drop_args(base);\n            self.arg_count_error(at, \"bitcast\", \"one argument\", n);\n            return cint(SK_AINT, -1, 0);\n        }\n        var v = self.value(self.astack[base], self.apos[base]);\n        let ap = self.apos[base];\n        self.drop_args(base);\n        if v.k == VK_CONST && v.ty < 0 {\n            v = if v.sk == SK_AINT && v.iv > 2147483647 { self.const_cast(v, SK_U32, ap, false) }\n                else {\n                    self.const_cast(v, if v.sk == SK_AINT { SK_I32 } else { SK_F32 }, ap, false)\n                };\n        }\n        let vt = self.concrete_type_of(v);\n        let w = self.m.width_of(vt);\n        let tw = self.m.width_of(ty);\n        if w == 0 || w != tw || self.m.types[vt].scalar == SK_BOOL\n");
        buf_str(out, c"            || self.m.types[ty].scalar == SK_BOOL {\n            if self.err(at, \"wgsl.type\") {\n                self.emsg.push_str(\n                    \"bitcast converts between 32-bit numbers and vectors of them of one width; got \");\n                self.val_str(v);\n                self.emsg.push_str(\" to \");\n                self.ty_str(ty);\n            }\n            return v;\n        }\n        let e0 = self.materialize(v, vt, ap);\n        if vt == ty {\n            return val(e0, ty);\n        }\n        let e = self.f.expr(E_BITCAST, ty, e0, 0, 0);\n        val(e, ty)\n    }\n\n    fn select(inout self, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() - base;\n        if n != 3 {\n            self.drop_args(base);\n            self.arg_count_error(at, \"select\", \"3 arguments (if false, if true, condition)\", n);\n            return cint(SK_AINT, -1, 0);\n        }\n        let sk = self.common_scalar(base, 2, -1, SK_I32);\n        var ty = -1;\n        for i in base..base + 2 {\n            let v = self.astack[i];\n            if !(v.k == VK_CONST && v.ty < 0) {\n                ty = self.concrete_type_of(v);\n                break;\n            }\n        }\n        if ty < 0 {\n            ty = sk as i64;\n        }\n        let tt = self.m.types[ty];\n        if tt.kind != TK_SCALAR && tt.kind != TK_VECTOR {\n            self.drop_args(base);\n            self.fail(at, \"wgsl.type\", \"select chooses between scalars or vectors\");\n            return cint(SK_AINT, -1, 0);\n        }\n        let f = self.materialize(self.astack[base], ty, self.apos[base]);\n        let t = self.materialize(self.astack[base + 1], ty, self.apos[base + 1]);\n        let cv = self.value(self.astack[base + 2], self.apos[base + 2]);\n        let ct = self.concrete_type_of(cv);\n        let w = self.m.width_of(ty);\n        if ct != T_BOOL && ct != vec_ty(SK_BOOL, w) {\n");
        buf_str(out, c"            if self.err(self.apos[base + 2], \"wgsl.type\") {\n                self.emsg.push_str(\n                    \"select's condition is a bool (or a vector of bool as wide as the values), not \");\n                self.val_str(cv);\n            }\n        }\n        let c = self.materialize(cv, ct, self.apos[base + 2]);\n        self.drop_args(base);\n        let e = self.f.expr(E_SELECT, ty, c, t, f);\n        val(e, ty)\n    }\n\n    fn array_length(inout self, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() - base;\n        if n != 1 {\n            self.drop_args(base);\n            self.arg_count_error(at, \"arrayLength\", \"one pointer\", n);\n            return cint(SK_AINT, -1, 0);\n        }\n        let p = self.astack[base];\n        self.drop_args(base);\n        let ok = p.k == VK_VALUE && self.m.types[p.ty].kind == TK_POINTER\n            && self.m.types[p.ty].space == SP_STORAGE;\n        if ok {\n            let pe = self.f.exprs[p.e];\n            let pointee = self.m.pointee(p.ty);\n            let t = self.m.types[pointee];\n            if t.kind == TK_ARRAY && t.n == 0 {\n                if pe.op == E_GLOBAL {\n                    let e = self.f.expr(E_ARRAY_LENGTH, T_U32, pe.a, -1, 0);\n                    self.f.exprs[e].d = t.stride;\n                    return val(e, T_U32);\n                }\n                if pe.op == ir::E_ACCESS_INDEX && self.f.exprs[pe.a].op == E_GLOBAL {\n                    let g = self.f.exprs[pe.a].a;\n                    let st = self.m.types[self.m.globals[g].ty];\n                    let off = self.m.members[st.mstart + pe.b].offset;\n                    let e = self.f.expr(E_ARRAY_LENGTH, T_U32, g, pe.b, off);\n                    self.f.exprs[e].d = t.stride;\n                    return val(e, T_U32);\n                }\n            }\n        }\n        if self.err(at, \"wgsl.type\") {\n");
        buf_str(out, c"            self.emsg.push_str(\"arrayLength takes a pointer to a runtime-sized array in a storage buffer: arrayLength(&buf) or arrayLength(&buf.items)\");\n        }\n        cint(SK_AINT, -1, 0)\n    }\n\n    fn atomic(inout self, s: i64, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() - base;\n        let want = if s == K_ATOMIC_LOAD { 1 } else if s == K_ATOMIC_COMPARE_EXCHANGE_WEAK { 3 }\n            else { 2 };\n        if n != want {\n            self.drop_args(base);\n            if self.err(at, \"wgsl.call\") {\n                self.emsg.push_fmt(f\"'{self.name_of(s)}' takes {want} argument\");\n                if want != 1 {\n                    self.emsg.push('s');\n                }\n                self.emsg.push_fmt(f\", got {n}\");\n            }\n            return cint(SK_AINT, -1, 0);\n        }\n        let p = self.astack[base];\n        let pt = if p.k == VK_VALUE && p.ty >= 0 { self.m.types[p.ty] }\n            else { self.m.types[T_I32] };\n        if pt.kind != TK_POINTER || self.m.types[pt.base].kind != TK_ATOMIC {\n            self.drop_args(base);\n            if self.err(self.apos[base], \"wgsl.type\") {\n                self.emsg.push_fmt(f\"'{self.name_of(s)}' takes a pointer to an atomic, got \");\n                self.val_str(p);\n                if p.k == VK_REF {\n                    self.help(\"pass its address: &x\");\n                }\n            }\n            return cint(SK_AINT, -1, 0);\n        }\n        let sk = self.m.types[pt.base].scalar;\n        let st = sk as i64;\n        let fun = if s == K_ATOMIC_LOAD {\n            AT_LOAD\n        } else if s == K_ATOMIC_STORE {\n            AT_STORE\n        } else if s == K_ATOMIC_ADD {\n            AT_ADD\n        } else if s == K_ATOMIC_SUB {\n            AT_SUB\n        } else if s == K_ATOMIC_MAX {\n            AT_MAX\n        } else if s == K_ATOMIC_MIN {\n            AT_MIN\n        } else if s == K_ATOMIC_AND {\n            AT_AND\n");
        buf_str(out, c"        } else if s == K_ATOMIC_OR {\n            AT_OR\n        } else if s == K_ATOMIC_XOR {\n            AT_XOR\n        } else if s == K_ATOMIC_EXCHANGE {\n            AT_EXCHANGE\n        } else {\n            AT_CMPXCHG\n        };\n        var v = -1;\n        var cmp = -1;\n        if fun == AT_CMPXCHG {\n            cmp = self.materialize(self.astack[base + 1], st, self.apos[base + 1]);\n            v = self.materialize(self.astack[base + 2], st, self.apos[base + 2]);\n        } else if fun != AT_LOAD {\n            v = self.materialize(self.astack[base + 1], st, self.apos[base + 1]);\n        }\n        self.drop_args(base);\n        if fun == AT_STORE {\n            let s0 = self.push_stmt(S_ATOMIC, p.e, fun, v, -1);\n            self.f.stmts[s0].e = -1;\n            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n        }\n        let rty = if fun == AT_CMPXCHG { self.cmpxchg_type(sk) } else { st };\n        let r = self.unemitted(E_ATOMIC_RESULT, rty);\n        let s0 = self.push_stmt(S_ATOMIC, p.e, fun, v, r);\n        self.f.stmts[s0].e = cmp;\n        val(r, rty)\n    }\n\n    // __atomic_compare_exchange_result<T>: { old_value: T, exchanged: bool }\n    pub fn cmpxchg_type(inout self, sk: u8) -> i64 {\n        let i = if sk == SK_I32 { 0 } else { 1 };\n        if self.cmpxchg_ty[i] >= 0 {\n            return self.cmpxchg_ty[i];\n        }\n        let start = self.m.members.len();\n        self.m.members.push(StructMember {\n            name: \"old_value\", ty: sk as i64, offset: 0, binding: ir::no_binding()\n        });\n        self.m.members.push(StructMember {\n            name: \"exchanged\", ty: T_BOOL, offset: 0, binding: ir::no_binding()\n        });\n        let name = if sk == SK_I32 { \"__atomic_compare_exchange_result_i32\" }\n            else { \"__atomic_compare_exchange_result_u32\" };\n        let h = self.m.struct_ty(name, start, 2);\n        self.cmpxchg_ty[i] = h;\n        h\n    }\n\n    // ---- Math ----\n\n");
        buf_str(out, c"    fn math(inout self, fun: i64, s: i64, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() - base;\n        let name = self.name_of(s);\n        let want = math_arity(fun);\n        if n != want {\n            self.drop_args(base);\n            if self.err(at, \"wgsl.call\") {\n                self.emsg.push_fmt(f\"'{name}' takes {want} argument\");\n                if want != 1 {\n                    self.emsg.push('s');\n                }\n                self.emsg.push_fmt(f\", got {n}\");\n            }\n            return cint(SK_AINT, -1, 0);\n        }\n        let r = self.math_typed(fun, name, base, n, at);\n        self.drop_args(base);\n        r\n    }\n\n    fn math_fail(inout self, at: i64, name: [u8], what: [u8], base: i64, n: i64) -> Val {\n        if self.err(at, \"wgsl.type\") {\n            self.emsg.push_fmt(f\"'{name}' takes {what}; got \");\n            for i in base..base + n {\n                if i > base {\n                    self.emsg.push_str(\", \");\n                }\n                self.val_str(self.astack[i]);\n            }\n        }\n        cint(SK_AINT, -1, 0)\n    }\n\n    // The common type of args[base .. base + n] (abstract ones take the\n    // others' scalar; all abstract: f32 when `float`, else by their kind).\n    fn common_type(self, base: i64, n: i64, float: bool) -> i64 {\n        for i in base..base + n {\n            let v = self.astack[i];\n            if !(v.k == VK_CONST && v.ty < 0) {\n                return self.concrete_type_of(v);\n            }\n        }\n        var any_float = float;\n        for i in base..base + n {\n            if self.astack[i].sk == SK_AFLOAT {\n                any_float = true;\n            }\n        }\n        if any_float { T_F32 } else { T_I32 }\n    }\n\n    fn math_typed(inout self, fun: i64, name: [u8], base: i64, n: i64, at: i64) -> Val {\n        let float_only = is_float_fun(fun);\n        if fun == MF_ALL || fun == MF_ANY {\n");
        buf_str(out, c"            let v = self.value(self.astack[base], self.apos[base]);\n            let t = self.concrete_type_of(v);\n            if self.m.types[t].scalar != SK_BOOL || self.m.width_of(t) == 0 {\n                return self.math_fail(at, name, \"a bool or a vector of bool\", base, n);\n            }\n            if t == T_BOOL {\n                return v;\n            }\n            let e0 = self.materialize(v, t, self.apos[base]);\n            return self.math_expr(fun, T_BOOL, [e0, 0, 0, 0], 1);\n        }\n        if fun >= ir::MF_PACK4X8UNORM && fun <= ir::MF_UNPACK2X16FLOAT\n            || fun >= ir::MF_PACK4X8SNORM {\n            return self.packing(fun, name, base, at);\n        }\n        if fun == MF_LDEXP {\n            let t = self.float_type(self.astack[base], self.apos[base]);\n            let w = self.m.width_of(t);\n            let e0 = self.materialize(self.astack[base], t, self.apos[base]);\n            let e1 = self.materialize(self.astack[base + 1], vec_ty(SK_I32, w),\n                self.apos[base + 1]);\n            return self.math_expr(fun, t, [e0, e1, 0, 0], 2);\n        }\n        if fun == MF_EXTRACT_BITS || fun == MF_INSERT_BITS {\n            let k = if fun == MF_EXTRACT_BITS { 1 } else { 2 };\n            let t = self.common_type(base, k, false);\n            let sk = self.m.types[t].scalar;\n            if (sk != SK_I32 && sk != SK_U32) || self.m.width_of(t) == 0 {\n                return self.math_fail(at, name, \"i32 or u32 values and u32 offset and count\", base,\n                    n);\n            }\n            var es: [i64; 4] = [0; 4];\n            for i in 0..k {\n                es[i] = self.materialize(self.astack[base + i], t, self.apos[base + i]);\n            }\n            es[k] = self.materialize(self.astack[base + k], T_U32, self.apos[base + k]);\n            es[k + 1] = self.materialize(self.astack[base + k + 1], T_U32, self.apos[base + k + 1]);\n            return self.math_expr(fun, t, es, k + 2);\n        }\n");
        buf_str(out, c"        if fun == ir::MF_MIX {\n            // mix(a, b, t): t is the same type, or a scalar\n            let t = self.common_type(base, 2, true);\n            if self.m.types[t].scalar != SK_F32 || self.m.width_of(t) == 0 {\n                return self.math_fail(at, name, \"f32 values\", base, n);\n            }\n            let e0 = self.materialize(self.astack[base], t, self.apos[base]);\n            let e1 = self.materialize(self.astack[base + 1], t, self.apos[base + 1]);\n            let tv = self.value(self.astack[base + 2], self.apos[base + 2]);\n            let tt = if tv.k == VK_CONST { T_F32 } else { tv.ty };\n            var e2 = self.materialize(tv, if tt == T_F32 { T_F32 } else { t },\n                self.apos[base + 2]);\n            if tt == T_F32 && t != T_F32 {\n                e2 = self.f.expr(E_SPLAT, t, e2, 0, 0);\n            }\n            return self.math_expr(fun, t, [e0, e1, e2, 0], 3);\n        }\n        let t = self.common_type(base, n, float_only);\n        let tt = self.m.types[t];\n        let sk = tt.scalar;\n        if fun == MF_DETERMINANT || fun == MF_TRANSPOSE {\n            if tt.kind != TK_MATRIX || (fun == MF_DETERMINANT && tt.n != tt.m) {\n                return self.math_fail(at, name,\n                    if fun == MF_DETERMINANT { \"a square matrix\" } else { \"a matrix\" }, base, n);\n            }\n            let e0 = self.materialize(self.astack[base], t, self.apos[base]);\n            let rt = if fun == MF_DETERMINANT { T_F32 } else { mat_ty(tt.m, tt.n) };\n            return self.math_expr(fun, rt, [e0, 0, 0, 0], 1);\n        }\n        let w = self.m.width_of(t);\n        if w == 0 || sk == SK_BOOL {\n            return self.math_fail(at, name,\n                if float_only { \"f32 or vecN<f32>\" } else { \"numbers or vectors of them\" }, base,\n                n);\n        }\n        if float_only && sk != SK_F32 {\n            let r = self.math_fail(at, name, \"f32 or vecN<f32>\", base, n);\n");
        buf_str(out, c"            self.help(\"convert it: f32(...)\");\n            return r;\n        }\n        if is_int_fun(fun) && sk == SK_F32 {\n            return self.math_fail(at, name, \"i32 or u32 (or vectors of them)\", base, n);\n        }\n        if fun == ir::MF_SIGN && sk == SK_U32 {\n            return self.math_fail(at, name, \"i32 or f32 (or vectors of them)\", base, n);\n        }\n        let vector_only = fun == MF_CROSS || fun == ir::MF_NORMALIZE || fun == ir::MF_REFLECT\n            || fun == ir::MF_FACE_FORWARD || fun == MF_DOT || fun == MF_DISTANCE && false;\n        if vector_only && w == 1 {\n            return self.math_fail(at, name, \"vectors\", base, n);\n        }\n        if fun == MF_CROSS && (w != 3 || sk != SK_F32) {\n            return self.math_fail(at, name, \"two vec3<f32>\", base, n);\n        }\n        var es: [i64; 4] = [0; 4];\n        for i in 0..n {\n            es[i] = self.materialize(self.astack[base + i], t, self.apos[base + i]);\n        }\n        let rt = if fun == MF_LENGTH || fun == MF_DISTANCE || fun == MF_DOT { sk as i64 }\n            else { t };\n        // constants fold when they are scalars of the simple kind\n        self.math_expr(fun, rt, es, n)\n    }\n\n    fn math_expr(inout self, fun: i64, ty: i64, es: [i64; 4], n: i64) -> Val {\n        let a = self.f.args.len();\n        for i in 0..n {\n            self.f.args.push(es[i]);\n        }\n        let e = self.f.expr(E_MATH, ty, fun, a, n);\n        val(e, ty)\n    }\n\n    fn packing(inout self, fun: i64, name: [u8], base: i64, at: i64) -> Val {\n        let unpack = fun == ir::MF_UNPACK4X8UNORM || fun == ir::MF_UNPACK2X16FLOAT\n            || fun == ir::MF_UNPACK4X8SNORM || fun == ir::MF_UNPACK2X16UNORM\n            || fun == ir::MF_UNPACK2X16SNORM;\n        let four = fun == ir::MF_PACK4X8UNORM || fun == ir::MF_UNPACK4X8UNORM\n            || fun == ir::MF_PACK4X8SNORM || fun == ir::MF_UNPACK4X8SNORM;\n        let vt = vec_ty(SK_F32, if four { 4 } else { 2 });\n");
        buf_str(out, c"        if unpack {\n            let e0 = self.materialize(self.astack[base], T_U32, self.apos[base]);\n            return self.math_expr(fun, vt, [e0, 0, 0, 0], 1);\n        }\n        let v = self.value(self.astack[base], self.apos[base]);\n        if self.concrete_type_of(v) != vt {\n            return self.math_fail(at, name, if four { \"a vec4<f32>\" } else { \"a vec2<f32>\" }, base,\n                1);\n        }\n        let e0 = self.materialize(v, vt, self.apos[base]);\n        self.math_expr(fun, T_U32, [e0, 0, 0, 0], 1)\n    }\n\n    // ---- Textures ----\n\n    fn texture_arg(inout self, i: i64, sampler: bool) -> i64 {\n        let v = self.astack[i];\n        let want = if sampler { TK_SAMPLER } else { TK_TEXTURE };\n        if v.k != VK_VALUE || self.m.types[v.ty].kind != want {\n            if self.err(self.apos[i], \"wgsl.type\") {\n                self.emsg.push_str(if sampler { \"expected a sampler, got \" }\n                    else { \"expected a texture, got \" });\n                self.val_str(v);\n            }\n            return -1;\n        }\n        v.e\n    }\n\n    fn texture_call(inout self, s: i64, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() - base;\n        let r = self.texture_typed(s, base, n, at);\n        self.drop_args(base);\n        r\n    }\n\n    fn texture_typed(inout self, s: i64, base: i64, n: i64, at: i64) -> Val {\n        let name = self.name_of(s);\n        if n < 1 {\n            self.arg_count_error(at, name, \"a texture first\", n);\n            return cint(SK_AINT, -1, 0);\n        }\n        let te = self.texture_arg(base, false);\n        if te < 0 {\n            return cint(SK_AINT, -1, 0);\n        }\n        let tt = self.m.types[self.f.exprs[te].ty];\n        let arrayed = tt.n == TEX_2D_ARRAY;\n        let depth = tt.n == TEX_DEPTH_2D;\n        let storage = tt.n == TEX_STORAGE_2D;\n        let texel = if depth { T_F32 } else { vec_ty(tt.scalar, 4) };\n");
        buf_str(out, c"        if s == K_TEXTURE_DIMENSIONS || s == K_TEXTURE_NUM_LEVELS || s == K_TEXTURE_NUM_LAYERS {\n            if s == K_TEXTURE_NUM_LAYERS && !arrayed {\n                self.fail(at, \"wgsl.type\", \"textureNumLayers takes an array texture\");\n                return cint(SK_AINT, -1, 0);\n            }\n            if s == K_TEXTURE_NUM_LEVELS && storage {\n                self.fail(at, \"wgsl.type\", \"a storage texture has one level\");\n                return cint(SK_AINT, -1, 0);\n            }\n            var lvl = -1;\n            if s == K_TEXTURE_DIMENSIONS && n == 2 && !storage {\n                let lt = self.int_arg_type(base + 1);\n                lvl = self.materialize(self.astack[base + 1], lt, self.apos[base + 1]);\n            } else if n != 1 {\n                self.arg_count_error(at, name, \"the texture (and for textureDimensions a level)\",\n                    n);\n                return cint(SK_AINT, -1, 0);\n            }\n            let q = if s == K_TEXTURE_DIMENSIONS { IQ_SIZE }\n                else if s == K_TEXTURE_NUM_LEVELS { IQ_LEVELS } else { IQ_LAYERS };\n            let rt = if q == IQ_SIZE { vec_ty(SK_U32, 2) } else { T_U32 };\n            let e = self.f.expr(E_IMAGE_QUERY, rt, te, q, lvl);\n            return val(e, rt);\n        }\n        if s == K_TEXTURE_STORE {\n            if !storage {\n                self.fail(at, \"wgsl.type\", \"textureStore writes a texture_storage_2d\");\n                return cint(SK_AINT, -1, 0);\n            }\n            if n != 3 {\n                self.arg_count_error(at, name, \"3 arguments (texture, coordinates, value)\", n);\n                return cint(SK_AINT, -1, 0);\n            }\n            let ct = self.coords_type(base + 1);\n            let ce = self.materialize(self.astack[base + 1], ct, self.apos[base + 1]);\n            let ve = self.materialize(self.astack[base + 2], texel, self.apos[base + 2]);\n            self.push_stmt(S_IMAGE_STORE, te, ce, ve, -1);\n");
        buf_str(out, c"            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n        }\n        if s == K_TEXTURE_LOAD {\n            if storage {\n                self.fail(at, \"wgsl.unsupported\",\n                    \"storage textures are write-only in this release\");\n                return cint(SK_AINT, -1, 0);\n            }\n            let want = if arrayed { 4 } else { 3 };\n            if n != want {\n                self.arg_count_error(at, name,\n                    if arrayed { \"4 arguments (texture, coordinates, layer, level)\" }\n                    else { \"3 arguments (texture, coordinates, level)\" }, n);\n                return cint(SK_AINT, -1, 0);\n            }\n            let ct = self.coords_type(base + 1);\n            let a = self.f.args.len();\n            let ce = self.materialize(self.astack[base + 1], ct, self.apos[base + 1]);\n            var extra: [i64; 2] = [0; 2];\n            for i in 2..n {\n                let it = self.int_arg_type(base + i);\n                extra[i - 2] = self.materialize(self.astack[base + i], it, self.apos[base + i]);\n            }\n            let a2 = self.f.args.len();\n            let _ = a;\n            self.f.args.push(ce);\n            for i in 2..n {\n                self.f.args.push(extra[i - 2]);\n            }\n            let e = self.f.expr(E_IMAGE_LOAD, texel, te, 0, a2);\n            self.f.exprs[e].d = n - 1;\n            return val(e, texel);\n        }\n        // the sampling functions\n        if storage {\n            self.fail(at, \"wgsl.type\", \"a storage texture cannot be sampled\");\n            return cint(SK_AINT, -1, 0);\n        }\n        let kind = if s == K_TEXTURE_SAMPLE {\n            IMG_SAMPLE\n        } else if s == K_TEXTURE_SAMPLE_BIAS {\n            IMG_SAMPLE_BIAS\n        } else if s == K_TEXTURE_SAMPLE_LEVEL {\n            IMG_SAMPLE_LEVEL\n        } else if s == K_TEXTURE_SAMPLE_COMPARE {\n            IMG_SAMPLE_COMPARE\n        } else {\n");
        buf_str(out, c"            IMG_SAMPLE_COMPARE_LEVEL\n        };\n        let compare = kind == IMG_SAMPLE_COMPARE || kind == IMG_SAMPLE_COMPARE_LEVEL;\n        if compare != depth && (compare || kind == IMG_SAMPLE_BIAS) {\n            self.fail(at, \"wgsl.type\",\n                if compare { \"textureSampleCompare takes a texture_depth_2d\" }\n                else { \"textureSampleBias takes a texture_2d<f32>\" });\n            return cint(SK_AINT, -1, 0);\n        }\n        if !depth && tt.scalar != SK_F32 {\n            self.fail(at, \"wgsl.type\",\n                \"only f32 textures are sampled; use textureLoad for i32 and u32\");\n            return cint(SK_AINT, -1, 0);\n        }\n        if (kind == IMG_SAMPLE || kind == IMG_SAMPLE_BIAS || kind == IMG_SAMPLE_COMPARE)\n            && self.stage != STAGE_FRAGMENT as i64 && self.stage != 255 {\n            if self.err(at, \"wgsl.stage\") {\n                self.emsg.push_fmt(f\"'{name}' computes derivatives: it is for fragment shaders\");\n                self.help(\"use textureSampleLevel elsewhere\");\n            }\n        }\n        let has_aux = kind != IMG_SAMPLE;\n        let want = 3 + (if arrayed { 1 } else { 0 }) + (if has_aux { 1 } else { 0 });\n        if n != want {\n            self.arg_count_error(at, name, \"a texture, a sampler, coordinates, then a layer for an array texture and the bias, level or depth reference\", n);\n            return cint(SK_AINT, -1, 0);\n        }\n        let se = self.texture_arg(base + 1, true);\n        if se < 0 {\n            return cint(SK_AINT, -1, 0);\n        }\n        let sm = self.m.types[self.f.exprs[se].ty];\n        if (sm.n == 1) != compare {\n            self.fail(self.apos[base + 1], \"wgsl.type\",\n                if compare { \"comparisons take a sampler_comparison\" }\n                else { \"this takes a sampler, not a sampler_comparison\" });\n            return cint(SK_AINT, -1, 0);\n        }\n        var es: [i64; 3] = [0; 3];\n");
        buf_str(out, c"        es[0] = self.materialize(self.astack[base + 2], vec_ty(SK_F32, 2), self.apos[base + 2]);\n        var k = 1;\n        if arrayed {\n            let it = self.int_arg_type(base + 3);\n            es[1] = self.materialize(self.astack[base + 3], it, self.apos[base + 3]);\n            k = 2;\n        }\n        if has_aux {\n            let ai = base + n - 1;\n            let at2 = if kind == IMG_SAMPLE_LEVEL && depth { self.int_arg_type(ai) } else { T_F32 };\n            es[k] = self.materialize(self.astack[ai], at2, self.apos[ai]);\n            k += 1;\n        }\n        let a = self.f.args.len();\n        for i in 0..k {\n            self.f.args.push(es[i]);\n        }\n        let e = self.f.expr(E_IMAGE_SAMPLE, texel, te, se, a);\n        self.f.exprs[e].d = kind | (k << 8);\n        val(e, texel)\n    }\n\n    // vec2<i32> or vec2<u32>, as the argument has it.\n    fn coords_type(inout self, i: i64) -> i64 {\n        let v = self.astack[i];\n        let t = self.concrete_type_of(v);\n        if t == vec_ty(SK_U32, 2) || t == vec_ty(SK_I32, 2) {\n            return t;\n        }\n        if self.err(self.apos[i], \"wgsl.type\") {\n            self.emsg.push_str(\"texel coordinates are a vec2<i32> or vec2<u32>, not \");\n            self.val_str(v);\n        }\n        vec_ty(SK_I32, 2)\n    }\n\n    fn int_arg_type(inout self, i: i64) -> i64 {\n        let v = self.astack[i];\n        let t = self.concrete_type_of(v);\n        if t == T_U32 || t == T_I32 {\n            return t;\n        }\n        if self.err(self.apos[i], \"wgsl.type\") {\n            self.emsg.push_str(\"expected an i32 or a u32, got \");\n            self.val_str(v);\n        }\n        T_I32\n    }\n}\n\nfn math_arity(fun: i64) -> i64 {\n    if fun == ir::MF_MIN || fun == ir::MF_MAX || fun == ir::MF_POW || fun == ir::MF_ATAN2\n        || fun == ir::MF_STEP || fun == MF_DISTANCE || fun == MF_DOT || fun == MF_CROSS\n        || fun == ir::MF_REFLECT || fun == MF_LDEXP {\n        2\n    }\n");
        buf_str(out, c"    else if fun == ir::MF_CLAMP || fun == ir::MF_MIX || fun == ir::MF_SMOOTHSTEP\n        || fun == ir::MF_FMA || fun == ir::MF_FACE_FORWARD || fun == MF_EXTRACT_BITS {\n        3\n    } else if fun == MF_INSERT_BITS {\n        4\n    } else {\n        1\n    }\n}\n\nfn is_float_fun(fun: i64) -> bool {\n    (fun >= ir::MF_FLOOR && fun <= ir::MF_FMA) || fun == MF_LENGTH || fun == MF_DISTANCE\n        || fun == MF_CROSS || fun == ir::MF_NORMALIZE || fun == ir::MF_REFLECT\n        || fun == ir::MF_DEGREES || fun == ir::MF_RADIANS || fun == ir::MF_SATURATE\n        || fun == ir::MF_ASINH || fun == ir::MF_ACOSH || fun == ir::MF_ATANH\n        || fun == ir::MF_FACE_FORWARD\n}\n\nfn is_int_fun(fun: i64) -> bool { fun >= ir::MF_COUNT_ONE_BITS && fun <= MF_INSERT_BITS }\n// ---- end mod std::gpu::wgsl::builtins ----\n}\n// ---- mod std::gpu::wgsl::entry ----\npub mod entry {\n// ---- Shader compiler implementation, entry (0.22) ----\n// Entry-point interfaces: what each stage's parameters and result may be\n// bound to, and with which types (WGSL §\"Entry Point Declaration\").\n\nuse front::Front;\nuse ir::{\n    BIND_BUILTIN, BIND_LOCATION, BIND_NONE, BI_FRAG_DEPTH, BI_FRONT_FACING, BI_GLOBAL_INVOCATION_ID,\n    BI_INSTANCE_INDEX, BI_LOCAL_INVOCATION_ID, BI_LOCAL_INVOCATION_INDEX, BI_NUM_WORKGROUPS,\n    BI_POSITION, BI_SAMPLE_INDEX, BI_SAMPLE_MASK, BI_VERTEX_INDEX, BI_WORKGROUP_ID, Binding,\n    INTERP_FLAT, SK_BOOL, SK_F32, SK_U32, STAGE_COMPUTE, STAGE_FRAGMENT, STAGE_VERTEX, TK_SCALAR,\n    TK_STRUCT, TK_VECTOR, T_BOOL, T_F32, T_U32, V, vec_ty,\n};\nuse std::Vec;\n\npub fn builtin_name(b: i64) -> [u8] {\n    if b == BI_POSITION {\n        \"position\"\n    } else if b == BI_VERTEX_INDEX {\n        \"vertex_index\"\n    } else if b == BI_INSTANCE_INDEX {\n        \"instance_index\"\n    } else if b == BI_FRONT_FACING {\n        \"front_facing\"\n    } else if b == BI_FRAG_DEPTH {\n        \"frag_depth\"\n    } else if b == BI_SAMPLE_INDEX {\n        \"sample_index\"\n");
        buf_str(out, c"    } else if b == BI_SAMPLE_MASK {\n        \"sample_mask\"\n    } else if b == BI_LOCAL_INVOCATION_ID {\n        \"local_invocation_id\"\n    } else if b == BI_LOCAL_INVOCATION_INDEX {\n        \"local_invocation_index\"\n    } else if b == BI_GLOBAL_INVOCATION_ID {\n        \"global_invocation_id\"\n    } else if b == BI_WORKGROUP_ID {\n        \"workgroup_id\"\n    } else {\n        \"num_workgroups\"\n    }\n}\n\n// The type a builtin has.\npub fn builtin_type(b: i64) -> i64 {\n    if b == BI_POSITION {\n        vec_ty(SK_F32, 4)\n    } else if b == BI_FRONT_FACING {\n        T_BOOL\n    } else if b == BI_FRAG_DEPTH {\n        T_F32\n    }\n    else if b == BI_LOCAL_INVOCATION_ID || b == BI_GLOBAL_INVOCATION_ID || b == BI_WORKGROUP_ID\n        || b == BI_NUM_WORKGROUPS {\n        vec_ty(SK_U32, 3)\n    } else {\n        T_U32\n    }\n}\n\n// Whether builtin b may be an input (or, `output`, an output) of stage.\nfn builtin_allowed(b: i64, stage: u8, output: bool) -> bool {\n    if stage == STAGE_COMPUTE {\n        return !output && b >= BI_LOCAL_INVOCATION_ID;\n    }\n    if stage == STAGE_VERTEX {\n        if output {\n            return b == BI_POSITION;\n        }\n        return b == BI_VERTEX_INDEX || b == BI_INSTANCE_INDEX;\n    }\n    if output {\n        return b == BI_FRAG_DEPTH || b == BI_SAMPLE_MASK;\n    }\n    b == BI_POSITION || b == BI_FRONT_FACING || b == BI_SAMPLE_INDEX || b == BI_SAMPLE_MASK\n}\n\nstruct Seen { locs: V<i64>, builtins: V<i64>, position: bool }\n\nfn check_binding(fr: inout Front, b: Binding, ty: i64, stage: u8, output: bool, what: [u8],\n    seen: inout Seen) {\n    let at = fr.m.functions[fr.m.entries[fr.m.entries.len() - 1].func].pos;\n    if b.kind == BIND_NONE {\n        if fr.err(at, \"wgsl.entry\") {\n            fr.emsg.push_fmt(f\"{what} of an entry point needs '@location(N)' or '@builtin(NAME)'\");\n        }\n        return;\n    }\n    if b.kind == BIND_BUILTIN {\n        if !builtin_allowed(b.value, stage, output) {\n");
        buf_str(out, c"            let io = if output { \"output\" } else { \"input\" };\n            if fr.err(at, \"wgsl.entry\") {\n                fr.emsg.push_fmt(\n                    f\"'@builtin({builtin_name(b.value)})' is not an {io} of a {stage_name(stage)} shader\");\n            }\n            return;\n        }\n        if builtin_type(b.value) != ty {\n            if fr.err(at, \"wgsl.entry\") {\n                fr.emsg.push_fmt(f\"'@builtin({builtin_name(b.value)})' has type \");\n                fr.ty_str(builtin_type(b.value));\n                fr.emsg.push_str(\", not \");\n                fr.ty_str(ty);\n            }\n            return;\n        }\n        for i in 0..seen.builtins.len() {\n            if seen.builtins[i] == b.value {\n                if fr.err(at, \"wgsl.entry\") {\n                    fr.emsg.push_fmt(f\"'@builtin({builtin_name(b.value)})' appears twice\");\n                }\n                return;\n            }\n        }\n        seen.builtins.push(b.value);\n        if b.value == BI_POSITION {\n            seen.position = true;\n        }\n        return;\n    }\n    // a location\n    if stage == STAGE_COMPUTE {\n        if fr.err(at, \"wgsl.entry\") {\n            fr.emsg.push_str(\"a compute shader has no '@location' inputs\");\n        }\n        return;\n    }\n    let t = fr.m.types[ty];\n    if (t.kind != TK_SCALAR && t.kind != TK_VECTOR) || t.scalar == SK_BOOL {\n        if fr.err(at, \"wgsl.entry\") {\n            fr.emsg.push_fmt(f\"'@location({b.value})' holds a number or a vector of numbers, not \");\n            fr.ty_str(ty);\n        }\n        return;\n    }\n    let interpolated = (stage == STAGE_VERTEX && output) || (stage == STAGE_FRAGMENT && !output);\n    if interpolated && t.scalar != SK_F32 && b.interp != INTERP_FLAT {\n        if fr.err(at, \"wgsl.entry\") {\n            fr.emsg.push_fmt(\n                f\"'@location({b.value})' is an integer: it needs '@interpolate(flat)'\");\n        }\n        return;\n    }\n");
        buf_str(out, c"    for i in 0..seen.locs.len() {\n        if seen.locs[i] == b.value {\n            if fr.err(at, \"wgsl.entry\") {\n                fr.emsg.push_fmt(f\"'@location({b.value})' appears twice\");\n            }\n            return;\n        }\n    }\n    seen.locs.push(b.value);\n}\n\npub fn stage_name(s: u8) -> [u8] {\n    if s == STAGE_VERTEX {\n        \"vertex\"\n    } else if s == STAGE_FRAGMENT {\n        \"fragment\"\n    } else {\n        \"compute\"\n    }\n}\n\n// A parameter or result: a bound value, or a struct of bound members.\nfn check_io(fr: inout Front, b: Binding, ty: i64, stage: u8, output: bool, what: [u8],\n    seen: inout Seen) {\n    let t = fr.m.types[ty];\n    if t.kind == TK_STRUCT && b.kind == BIND_NONE {\n        for i in t.mstart..t.mstart + t.mcount {\n            let mem = fr.m.members[i];\n            if fr.m.types[mem.ty].kind == TK_STRUCT {\n                let at = fr.m.functions[fr.m.entries[fr.m.entries.len() - 1].func].pos;\n                fr.fail(at, \"wgsl.entry\", \"an entry point's IO struct cannot nest structs\");\n                return;\n            }\n            check_binding(&fr, mem.binding, mem.ty, stage, output, \"a member of an IO struct\",\n                &seen);\n        }\n        return;\n    }\n    check_binding(&fr, b, ty, stage, output, what, &seen);\n}\n\npub fn check_interface(fr: inout Front, ei: i64) {\n    let stage = fr.m.entries[ei].stage;\n    let fh = fr.m.entries[ei].func;\n    let pos = fr.m.functions[fh].pos;\n    var ins = Seen { locs: Vec::new_in(fr.a), builtins: Vec::new_in(fr.a), position: false };\n    for i in 0..fr.m.functions[fh].params.len() {\n        let b = fr.m.functions[fh].params[i].binding;\n        let t = fr.m.functions[fh].params[i].ty;\n        check_io(&fr, b, t, stage, false, \"a parameter\", &ins);\n    }\n    var outs = Seen { locs: Vec::new_in(fr.a), builtins: Vec::new_in(fr.a), position: false };\n    let result = fr.m.functions[fh].result;\n    if result >= 0 {\n");
        buf_str(out, c"        if stage == STAGE_COMPUTE {\n            fr.fail(pos, \"wgsl.entry\", \"a compute shader returns nothing\");\n            return;\n        }\n        let rb = fr.m.functions[fh].result_binding;\n        check_io(&fr, rb, result, stage, true, \"the result\", &outs);\n    }\n    if stage == STAGE_VERTEX && !outs.position && !fr.failed {\n        fr.fail(pos, \"wgsl.entry\", \"a vertex shader returns '@builtin(position)' (a vec4<f32>)\");\n        fr.help(\"for example: fn vs(...) -> @builtin(position) vec4<f32>\");\n    }\n}\n// ---- end mod std::gpu::wgsl::entry ----\n}\n// ---- mod std::gpu::wgsl::bounds ----\npub mod bounds {\n// ---- Shader compiler implementation, bounds (0.22) ----\n// Bounds checks (D15: no undefined behaviour in shaders). Every E_ACCESS\n// gets its check: a clamp for vectors, matrices and fixed-size arrays\n// (naga's Restrict), read-zero-skip-write for runtime-sized arrays. A\n// check is dropped only where a dominating comparison proves the index in\n// range: the head of a counted loop, `for (var i = 0u; i < N; i++)`,\n// whose body indexes something of length N or more with `i`.\n\nuse ir::{\n    CK_CLAMP, CK_NONE, CK_PENDING, CK_RZSW, E_ACCESS, E_BINARY, E_LITERAL, E_LOAD, E_LOCAL,\n    Function, Module, OP_LT, S_BLOCK, S_BREAK, S_CALL, S_EMIT, S_IF, S_LOOP, S_STORE, S_SWITCH,\n    TK_ARRAY, TK_POINTER, T_I32, T_U32, V,\n};\nuse std::{ScopedArena, Vec};\n\n// A fact: local `l` is below `n` (and not negative) while it holds.\nstruct Fact { local: i64, n: i64 }\n\npub fn insert_checks(m: inout Module, a: ScopedArena, prove: bool) {\n    for h in 0..m.functions.len() {\n        var f = std::replace(&m.functions[h], ir::new_function(\"\", m.a));\n        for e in 0..f.exprs.len() {\n            let x = f.exprs[e];\n            if x.op != E_ACCESS || x.c != CK_PENDING {\n                continue;\n            }\n            let bt0 = f.exprs[x.a].ty;\n");
        buf_str(out, c"            let bt = if m.types[bt0].kind == TK_POINTER { m.types[bt0].base } else { bt0 };\n            let t = m.types[bt];\n            if t.kind == TK_ARRAY && t.n == 0 {\n                f.exprs[e].c = CK_RZSW;\n            } else {\n                f.exprs[e].c = CK_CLAMP;\n                f.exprs[e].d = t.n;\n            }\n        }\n        if prove && f.body >= 0 {\n            var facts: V<Fact> = Vec::new_in(a);\n            prove_block(m, &f, f.body, &facts);\n        }\n        m.functions[h] = f;\n    }\n    var c = std::replace(&m.consts, ir::new_function(\"\", m.a));\n    for e in 0..c.exprs.len() {\n        if c.exprs[e].op == E_ACCESS && c.exprs[e].c == CK_PENDING {\n            c.exprs[e].c = CK_CLAMP;\n            c.exprs[e].d = m.types[c.exprs[c.exprs[e].a].ty].n;\n        }\n    }\n    m.consts = c;\n}\n\n// The local an expression loads, or -1.\nfn loaded_local(f: Function, e: i64) -> i64 {\n    let x = f.exprs[e];\n    if x.op == E_LOAD && f.exprs[x.a].op == E_LOCAL {\n        return f.exprs[x.a].a;\n    }\n    -1\n}\n\n// Whether the block (or what it calls) may store to local l.\nfn stores_local(f: Function, blk: i64, l: i64) -> bool {\n    let b = f.blocks[blk];\n    for i in b.start..b.start + b.count {\n        let st = f.stmts[f.items[i]];\n        if st.op == S_STORE {\n            let p = f.exprs[st.a];\n            // a store through any pointer derived from the local\n            if p.op == E_LOCAL && p.a == l {\n                return true;\n            }\n            if p.op != E_LOCAL && reaches_local(f, st.a, l) {\n                return true;\n            }\n        } else if st.op == S_CALL {\n            // a pointer to the local passed to a function\n            for k in st.b..st.b + st.c {\n                if reaches_local(f, f.args[k], l) {\n                    return true;\n                }\n            }\n        } else if st.op == S_BLOCK {\n            if stores_local(f, st.a, l) {\n                return true;\n");
        buf_str(out, c"            }\n        } else if st.op == S_IF {\n            if stores_local(f, st.b, l) || stores_local(f, st.c, l) {\n                return true;\n            }\n        } else if st.op == S_SWITCH {\n            for k in st.b..st.b + st.c {\n                if stores_local(f, f.cases[k].body, l) {\n                    return true;\n                }\n            }\n        } else if st.op == S_LOOP {\n            if stores_local(f, st.a, l) || stores_local(f, st.b, l) {\n                return true;\n            }\n        } else if st.op == ir::S_ATOMIC {\n            if reaches_local(f, st.a, l) {\n                return true;\n            }\n        }\n    }\n    false\n}\n\n// Whether pointer expression e is local l or derived from it.\nfn reaches_local(f: Function, e: i64, l: i64) -> bool {\n    let x = f.exprs[e];\n    if x.op == E_LOCAL {\n        return x.a == l;\n    }\n    if x.op == E_ACCESS || x.op == ir::E_ACCESS_INDEX {\n        return reaches_local(f, x.a, l);\n    }\n    false\n}\n\n// The facts the head of a loop body establishes: `if (load(l) < N) {}\n// else { break; }`, with l an unsigned local or a signed one that starts\n// at a non-negative value and is only increased (checked by the caller).\nfn head_fact(m: Module, f: Function, body: i64) -> Fact {\n    let b = f.blocks[body];\n    let none = Fact { local: -1, n: 0 };\n    for i in b.start..b.start + b.count {\n        let st = f.stmts[f.items[i]];\n        if st.op == S_EMIT {\n            continue;\n        }\n        if st.op != S_IF {\n            return none;\n        }\n        let then_b = f.blocks[st.b];\n        let else_b = f.blocks[st.c];\n        if then_b.count != 0 || else_b.count != 1 || f.stmts[f.items[else_b.start]].op != S_BREAK {\n            return none;\n        }\n        let c = f.exprs[st.a];\n        if c.op != E_BINARY || c.a != OP_LT {\n            return none;\n        }\n        let l = loaded_local(f, c.b);\n        let lim = f.exprs[c.c];\n");
        buf_str(out, c"        if l < 0 || lim.op != E_LITERAL {\n            return none;\n        }\n        let lt = f.locals[l].ty;\n        if lt != T_U32 && lt != T_I32 {\n            return none;\n        }\n        let n = if lt == T_I32 { lim.a as u32 as i32 as i64 } else { lim.a };\n        if n <= 0 {\n            return none;\n        }\n        return Fact { local: l, n: n };\n    }\n    none\n}\n\n// Whether local l (an i32) is never negative at the loop: it was stored a\n// non-negative literal just before the loop, and the loop's continuing\n// block only adds a positive literal to it.\nfn nonneg_counter(f: Function, items: V<i64>, pos: i64, l: i64, cont: i64, n: i64) -> bool {\n    // the statement before the loop (skipping emits) stores a literal\n    var k = pos - 1;\n    var ok = false;\n    while k >= 0 {\n        let st = f.stmts[items[k]];\n        if st.op == S_EMIT {\n            k -= 1;\n            continue;\n        }\n        if st.op == S_STORE && f.exprs[st.a].op == E_LOCAL && f.exprs[st.a].a == l {\n            let v = f.exprs[st.b];\n            ok = v.op == E_LITERAL && (v.a as u32 as i32) >= 0;\n        }\n        break;\n    }\n    if !ok {\n        return false;\n    }\n    // continuing: only `l = load(l) + positive literal`\n    let cb = f.blocks[cont];\n    for i in cb.start..cb.start + cb.count {\n        let st = f.stmts[f.items[i]];\n        if st.op == S_STORE && reaches_local(f, st.a, l) {\n            let v = f.exprs[st.b];\n            if v.op != E_BINARY || v.a != ir::OP_ADD || loaded_local(f, v.b) != l {\n                return false;\n            }\n            let inc = f.exprs[v.c];\n            // positive, and i + inc cannot wrap past i32's top while i < n\n            if inc.op != E_LITERAL || (inc.a as u32 as i32) <= 0\n                || n + (inc.a as u32 as i32) as i64 > 2147483647 {\n                return false;\n            }\n        } else if st.op != S_EMIT {\n");
        buf_str(out, c"            if st.op == S_CALL || st.op == S_BLOCK || st.op == S_IF || st.op == S_LOOP\n                || st.op == S_SWITCH {\n                if stores_local(f, cont, l) {\n                    return false;\n                }\n            }\n        }\n    }\n    true\n}\n\nfn prove_block(m: Module, f: inout Function, blk: i64, facts: inout V<Fact>) {\n    let b = f.blocks[blk];\n    // the block's items, so nonneg_counter can look back\n    var items: V<i64> = Vec::new_in(f.items.allocator());\n    for i in b.start..b.start + b.count {\n        items.push(f.items[i]);\n    }\n    for i in 0..items.len() {\n        let s = items[i];\n        let st = f.stmts[s];\n        if st.op == S_EMIT {\n            for e in st.a..st.b {\n                prove_expr(m, &f, e, facts);\n            }\n        } else if st.op == S_BLOCK {\n            prove_block(m, &f, st.a, &facts);\n        } else if st.op == S_IF {\n            prove_block(m, &f, st.b, &facts);\n            prove_block(m, &f, st.c, &facts);\n        } else if st.op == S_SWITCH {\n            for k in st.b..st.b + st.c {\n                prove_block(m, &f, f.cases[k].body, &facts);\n            }\n        } else if st.op == S_LOOP {\n            let base = facts.len();\n            // facts from outside the loop hold inside only when it keeps them\n            var kept = 0;\n            for k in 0..base {\n                if !stores_local(f, st.a, facts[k].local)\n                    && !stores_local(f, st.b, facts[k].local) {\n                    kept += 1;\n                } else {\n                    facts[k].n = -facts[k].n - 1;\n                }\n            }\n            let _ = kept;\n            let fact = head_fact(m, f, st.a);\n            var added = false;\n            if fact.local >= 0 && !stores_local(f, st.a, fact.local) {\n                let lt = f.locals[fact.local].ty;\n                if lt == T_U32 || nonneg_counter(f, items, i, fact.local, st.b, fact.n) {\n");
        buf_str(out, c"                    facts.push(fact);\n                    added = true;\n                }\n            }\n            prove_block(m, &f, st.a, &facts);\n            if added {\n                facts.truncate(base);\n            }\n            prove_block(m, &f, st.b, &facts);\n            for k in 0..base {\n                if facts[k].n < 0 {\n                    facts[k].n = -facts[k].n - 1;\n                }\n            }\n        }\n    }\n}\n\nfn prove_expr(m: Module, f: inout Function, e: i64, facts: V<Fact>) {\n    let x = f.exprs[e];\n    if x.op != E_ACCESS || x.c != CK_CLAMP {\n        return;\n    }\n    let l = loaded_local(f, x.b);\n    if l < 0 {\n        return;\n    }\n    for k in 0..facts.len() {\n        if facts[k].local == l && facts[k].n > 0 && facts[k].n <= x.d {\n            f.exprs[e].c = CK_NONE;\n            return;\n        }\n    }\n}\n\n// Bench only: every check off (CK_NONE), to measure what checks cost.\npub fn insert_no_checks(m: inout Module) {\n    for h in 0..m.functions.len() {\n        var f = std::replace(&m.functions[h], ir::new_function(\"\", m.a));\n        for e in 0..f.exprs.len() {\n            if f.exprs[e].op == E_ACCESS {\n                f.exprs[e].c = CK_NONE;\n            }\n        }\n        m.functions[h] = f;\n    }\n}\n// ---- end mod std::gpu::wgsl::bounds ----\n}\n// ---- mod std::gpu::wgsl::uniformity ----\npub mod uniformity {\n// ---- Shader compiler implementation, uniformity (0.22) ----\n// The uniformity analysis.\n\nuse front::Front;\n\npub fn check(fr: Front) {\n}\n// ---- end mod std::gpu::wgsl::uniformity ----\n}\n// ---- mod std::gpu::wgsl::msl ----\npub mod msl {\n// ---- Shader compiler implementation, msl (0.22) ----\n// The MSL writer (docs/design/gpu.md §2.10): MSL 3.0 text for Metal's\n// run-time compiler, with WGSL's semantics kept where MSL's differ.\n//\n// - Layout: structs get explicit padding and `packed_` vec3 members, so\n");
        buf_str(out, c"//   every struct has WGSL's offsets and size; fixed-size arrays are\n//   wrapped in a struct (`_w_arrN { T inner[N]; }`) to be values.\n// - No undefined behaviour: signed + - * and negation go through uint;\n//   integer / and % through helpers (by zero, MIN / -1); shift amounts are\n//   masked; float to int conversions saturate; every index is clamped or,\n//   for runtime-sized arrays, guarded against the binding's size from the\n//   hidden sizes buffer (`[[buffer(30)]]`).\n// - Bindings: buffers take slots 0.. in declaration order, textures and\n//   samplers theirs; `reflect` gives the slots.\n// - Values: an expression is written where it is used, except loads,\n//   results, `let`s and those used more than once, which get a name where\n//   they are evaluated (their S_EMIT).\n\nuse entry::builtin_name;\nuse ir::{\n    ACC_WRITE, AT_ADD, AT_AND, AT_CMPXCHG, AT_EXCHANGE, AT_LOAD, AT_MAX, AT_MIN, AT_OR, AT_STORE,\n    AT_SUB, AT_XOR, BARRIER_WORKGROUP, BIND_BUILTIN, BIND_LOCATION, BI_FRAG_DEPTH, BI_FRONT_FACING,\n    BI_GLOBAL_INVOCATION_ID, BI_INSTANCE_INDEX, BI_LOCAL_INVOCATION_ID, BI_LOCAL_INVOCATION_INDEX,\n    BI_NUM_WORKGROUPS, BI_POSITION, BI_SAMPLE_INDEX, BI_SAMPLE_MASK, BI_VERTEX_INDEX,\n    BI_WORKGROUP_ID, Binding, CK_CLAMP, CK_RZSW, E_ACCESS, E_ACCESS_INDEX, E_ARG, E_ARRAY_LENGTH,\n    E_ATOMIC_RESULT, E_BINARY, E_BITCAST, E_CALL_RESULT, E_COMPOSE, E_CONVERT, E_DERIVATIVE,\n    E_GLOBAL, E_IMAGE_LOAD, E_IMAGE_QUERY, E_IMAGE_SAMPLE, E_LITERAL, E_LOAD, E_LOCAL, E_MATH,\n    E_SELECT, E_SPLAT, E_SWIZZLE, E_UNARY, E_WG_UNIFORM_RESULT, E_ZERO, Function, IMG_SAMPLE_BIAS,\n    IMG_SAMPLE_COMPARE, IMG_SAMPLE_COMPARE_LEVEL, IMG_SAMPLE_LEVEL, INTERP_FLAT, INTERP_LINEAR,\n    IQ_LAYERS, IQ_LEVELS, Module, OP_ADD, OP_AND, OP_DIV, OP_EQ, OP_GE, OP_GT, OP_LAND, OP_LE,\n    OP_LOR, OP_LT, OP_MOD, OP_MUL, OP_NE, OP_OR, OP_SHL, OP_SHR, OP_SUB, OP_XOR, SK_BOOL, SK_F32,\n    SK_I32, SK_U32, SP_FUNCTION, SP_HANDLE, SP_PRIVATE, SP_STORAGE, SP_UNIFORM, SP_WORKGROUP,\n");
        buf_str(out, c"    STAGE_COMPUTE, STAGE_FRAGMENT, STAGE_VERTEX, S_ATOMIC, S_BARRIER, S_BLOCK, S_BREAK, S_CALL,\n    S_CONTINUE, S_EMIT, S_IF, S_IMAGE_STORE, S_KILL, S_LOOP, S_RETURN, S_STORE, S_SWITCH,\n    S_WG_UNIFORM_LOAD, TEX_2D_ARRAY, TEX_DEPTH_2D, TEX_STORAGE_2D, TK_ARRAY, TK_ATOMIC, TK_MATRIX,\n    TK_POINTER, TK_SAMPLER, TK_SCALAR, TK_STRUCT, TK_TEXTURE, TK_VECTOR, Type, UN_BITNOT, UN_NEG,\n    UN_NOT, V, bits_f32,\n};\nuse std::{Allocator, Buf, Clone, ScopedArena, Vec};\n\nconst RESERVED: [[u8]; 103] = [\n    \"main\", \"kernel\", \"vertex\", \"fragment\", \"device\", \"constant\", \"thread\", \"threadgroup\",\n    \"threadgroup_imageblock\", \"ray_data\", \"object_data\", \"metal\", \"using\", \"namespace\",\n    \"template\", \"typename\", \"class\", \"struct\", \"union\", \"enum\", \"public\", \"private\", \"protected\",\n    \"virtual\", \"operator\", \"new\", \"delete\", \"this\", \"auto\", \"register\", \"static\", \"extern\",\n    \"inline\", \"volatile\", \"const\", \"constexpr\", \"explicit\", \"friend\", \"mutable\", \"goto\",\n    \"sizeof\", \"typedef\", \"typeid\", \"signed\", \"unsigned\", \"short\", \"long\", \"int\", \"uint\", \"char\",\n    \"uchar\", \"float\", \"half\", \"double\", \"bool\", \"void\", \"true\", \"false\", \"nullptr\", \"do\",\n    \"while\", \"for\", \"if\", \"else\", \"switch\", \"case\", \"default\", \"break\", \"continue\", \"return\",\n    \"try\", \"catch\", \"throw\", \"and\", \"or\", \"not\", \"xor\", \"bitand\", \"bitor\", \"compl\", \"not_eq\",\n    \"and_eq\", \"or_eq\", \"xor_eq\", \"asm\", \"export\", \"alignas\", \"alignof\", \"decltype\", \"noexcept\",\n    \"static_assert\", \"static_cast\", \"dynamic_cast\", \"const_cast\", \"reinterpret_cast\", \"wchar_t\",\n    \"char16_t\", \"char32_t\", \"int8_t\", \"uint8_t\", \"int16_t\", \"size_t\", \"ptrdiff_t\",\n];\n\nconst MATH_NAMES: [[u8]; 39] = [\n    \"abs\", \"min\", \"max\", \"clamp\", \"sign\", \"floor\", \"ceil\", \"rint\", \"fract\", \"trunc\", \"sqrt\",\n");
        buf_str(out, c"    \"rsqrt\", \"exp\", \"exp2\", \"log\", \"log2\", \"pow\", \"sin\", \"cos\", \"tan\", \"asin\", \"acos\", \"atan\",\n    \"atan2\", \"sinh\", \"cosh\", \"tanh\", \"mix\", \"step\", \"smoothstep\", \"fma\", \"length\", \"distance\",\n    \"dot\", \"cross\", \"normalize\", \"reflect\", \"determinant\", \"transpose\",\n];\n\n// Where the resources are bound. Per stage (vertex, fragment, compute),\n// buffers, textures and samplers each take slots from 0 in (group,\n// binding) order over the bindings the stage's entry points use; the\n// Metal hal binds what the reflection says. The sizes buffer (the byte\n// sizes of the runtime-sized storage buffers, for bounds checks) takes the\n// stage's next buffer slot; it has one u32 per runtime-sized storage\n// binding of the module, in (group, binding) order.\npub struct Slots {\n    // slot[stage * globals + g], or -1\n    slot: V<i64>,\n    // per global: its index in the sizes buffer, or -1\n    size_index: V<i64>,\n    sizes_count: i64,\n    // per stage: the sizes buffer's slot, or -1 when the stage needs none\n    sizes_slot: [i64; 3],\n}\n\n// The globals in (group, binding) order (the others after, as declared).\npub fn binding_order(m: Module, a: ScopedArena) -> V<i64> {\n    var order: V<i64> = Vec::new_in(a);\n    for g in 0..m.globals.len() {\n        order.push(g);\n    }\n    // an insertion sort: modules have few bindings\n    for i in 1..order.len() {\n        var j = i;\n        while j > 0 && binding_key(m, order[j - 1]) > binding_key(m, order[j]) {\n            order.swap(j - 1, j);\n            j -= 1;\n        }\n    }\n    order\n}\n\nfn binding_key(m: Module, g: i64) -> i64 {\n    let gl = m.globals[g];\n    if gl.group < 0 {\n        return 9223372036854775807 - (m.globals.len() - g);\n    }\n    gl.group * 1048576 + gl.binding\n}\n\npub fn slots(m: Module, uses: V<V<bool>>, a: ScopedArena) -> Slots {\n    let ng = m.globals.len();\n    var s = Slots {\n");
        buf_str(out, c"        slot: Vec::filled_in(3 * ng, -1, a), size_index: Vec::filled_in(ng, -1, a), sizes_count: 0,\n        sizes_slot: [-1, -1, -1]\n    };\n    let order = binding_order(m, a);\n    for k in 0..order.len() {\n        let g = order[k];\n        if m.globals[g].space == SP_STORAGE && m.is_runtime_sized(m.globals[g].ty) {\n            s.size_index[g] = s.sizes_count;\n            s.sizes_count += 1;\n        }\n    }\n    for st in 0..3 {\n        var visible: V<bool> = Vec::filled_in(ng, false, a);\n        for e in 0..m.entries.len() {\n            if m.entries[e].stage as i64 == st {\n                let h = m.entries[e].func;\n                for g in 0..ng {\n                    if uses[h][g] {\n                        visible[g] = true;\n                    }\n                }\n            }\n        }\n        var nb = 0;\n        var nt = 0;\n        var ns = 0;\n        var sized = false;\n        for k in 0..order.len() {\n            let g = order[k];\n            if !visible[g] {\n                continue;\n            }\n            let gl = m.globals[g];\n            let kind = m.types[gl.ty].kind;\n            if gl.space == SP_UNIFORM || gl.space == SP_STORAGE {\n                s.slot[st * ng + g] = nb;\n                nb += 1;\n                if s.size_index[g] >= 0 {\n                    sized = true;\n                }\n            } else if kind == TK_TEXTURE {\n                s.slot[st * ng + g] = nt;\n                nt += 1;\n            } else if kind == TK_SAMPLER {\n                s.slot[st * ng + g] = ns;\n                ns += 1;\n            }\n        }\n        if sized {\n            s.sizes_slot[st] = nb;\n        }\n    }\n    s\n}\n\n// A name the writer made: text in its pool (W.pool).\n#[derive(Clone)]\nstruct Nm { start: i64, len: i64 }\n\nfn nm(pool: Buf<ScopedArena>, n: Nm) -> [u8] { pool.as_slice()[n.start..n.start + n.len] }\n\n// Appends s's bytes. (A Buf<ScopedArena> holds a view, of its arena, so\n");
        buf_str(out, c"// the checker takes `dst.push_str(local.as_slice())` into a field as\n// keeping a view of `local`; bytes pushed one by one are plain values.)\nfn copy_into(dst: inout Buf<ScopedArena>, s: [u8]) {\n    for i in 0..s.len {\n        dst.push(s[i]);\n    }\n}\n\nstruct W {\n    a: ScopedArena,\n    out: Buf<ScopedArena>,\n    // the text of every name the writer made\n    pool: Buf<ScopedArena>,\n    // the types' MSL names, made on first use\n    tname: V<Nm>,\n    tdone: V<bool>,\n    types_out: Buf<ScopedArena>,\n    // helpers used\n    need_div: bool,\n    need_f2i: bool,\n    need_sign: bool,\n    need_flb: bool,\n    need_ftb: bool,\n    need_cmpxchg: V<Nm>,\n    sl: Slots,\n    // per function: the globals it uses (directly or through calls)\n    uses: V<V<bool>>,\n    fnames: V<Nm>,\n    gnames: V<Nm>,\n    // the function being written\n    fh: i64,\n    refc: V<i64>,\n    baked: V<bool>,\n    // a name per local, parameter and baked expression of the function\n    lnames: V<Nm>,\n    enames: V<Nm>,\n    used: V<Nm>,\n    indent: i64,\n    loop_n: i64,\n    // entry points: the stage being written (255: a plain function), and\n    // its output struct's name\n    stage: i64,\n    out_name: Nm,\n    ret_ty: i64,\n    // each type's kind\n    kinds: V<u8>,\n}\n\nfn is_reserved(s: [u8]) -> bool {\n    for i in 0..RESERVED.len() {\n        if RESERVED[i] == s {\n            return true;\n        }\n    }\n    false\n}\n\nimpl W {\n    fn p(inout self, s: [u8]) { self.out.push_str(s); }\n\n    // A pooled name into the output.\n    fn pn(inout self, n: Nm) { self.out.push_str(nm(self.pool, n)); }\n\n    // A type's name into the output.\n    fn pty(inout self, m: Module, t: i64) {\n        let n = self.ty(m, t);\n        self.pn(n);\n    }\n\n    fn s(self, n: Nm) -> [u8] { nm(self.pool, n) }\n\n    // Text into the pool: a name.\n    fn intern(inout self, s: [u8]) -> Nm {\n        let st = self.pool.len();\n        copy_into(&self.pool, s);\n");
        buf_str(out, c"        Nm { start: st, len: s.len }\n    }\n\n    // The pool's text from `st` on, as a name.\n    fn since(self, st: i64) -> Nm { Nm { start: st, len: self.pool.len() - st } }\n\n    fn line(inout self) {\n        self.out.push('\\n');\n        for _ in 0..self.indent {\n            self.out.push_str(\"    \");\n        }\n    }\n\n    // A WGSL identifier as an MSL one: reserved words get a `_`, names\n    // starting with `_` a `u` (the writer's own names start with `_`).\n    fn escape(inout self, s: [u8]) -> Nm {\n        if s.len == 0 {\n            return self.intern(\"_w_t\");\n        }\n        let st = self.pool.len();\n        if s[0] == '_' {\n            self.pool.push('u');\n        }\n        copy_into(&self.pool, s);\n        if is_reserved(s) || s.len > 3 && s[0..3] == \"_w_\" {\n            self.pool.push('_');\n        }\n        self.since(st)\n    }\n\n    fn is_used(self, n: Nm) -> bool {\n        let t = nm(self.pool, n);\n        for i in 0..self.used.len() {\n            if nm(self.pool, self.used[i]) == t {\n                return true;\n            }\n        }\n        false\n    }\n\n    // A name unique in the function being written.\n    fn unique(inout self, base: [u8]) -> Nm {\n        let n = self.escape(base);\n        if !self.is_used(n) {\n            self.used.push(n);\n            return n;\n        }\n        var k = 1;\n        loop {\n            let st = self.pool.len();\n            var i = 0;\n            while i < n.len {\n                let c = self.pool.as_slice()[n.start + i];\n                self.pool.push(c);\n                i += 1;\n            }\n            self.pool.push_fmt(f\"_{k}\");\n            let t = self.since(st);\n            if !self.is_used(t) {\n                self.used.push(t);\n                return t;\n            }\n            k += 1;\n        }\n    }\n\n    // ---- Types ----\n\n    fn scalar(sk: u8) -> [u8] {\n        if sk == SK_BOOL {\n            \"bool\"\n");
        buf_str(out, c"        } else if sk == SK_I32 {\n            \"int\"\n        } else if sk == SK_U32 {\n            \"uint\"\n        } else {\n            \"float\"\n        }\n    }\n\n    // The MSL name of type t (declaring structs and array wrappers once).\n    fn ty(inout self, m: Module, t: i64) -> Nm {\n        if self.tdone[t] {\n            return self.tname[t];\n        }\n        let ty = m.types[t];\n        var n = Nm { start: 0, len: 0 };\n        if ty.kind == TK_SCALAR {\n            n = self.intern(W::scalar(ty.scalar));\n        } else if ty.kind == TK_VECTOR {\n            let st = self.pool.len();\n            self.pool.push_fmt(f\"metal::{W::scalar(ty.scalar)}{ty.n}\");\n            n = self.since(st);\n        } else if ty.kind == TK_MATRIX {\n            let st = self.pool.len();\n            self.pool.push_fmt(f\"metal::float{ty.n}x{ty.m}\");\n            n = self.since(st);\n        } else if ty.kind == TK_ATOMIC {\n            n = self.intern(if ty.scalar == SK_I32 { \"metal::atomic_int\" }\n                else { \"metal::atomic_uint\" });\n        } else if ty.kind == TK_ARRAY {\n            let el = self.ty(m, ty.base);\n            let st = self.pool.len();\n            self.pool.push_fmt(f\"_w_arr{t}\");\n            n = self.since(st);\n            if ty.n > 0 {\n                self.types_out.push_fmt(\n                    f\"struct _w_arr{t} {{\\n    {nm(self.pool, el)} inner[{ty.n}];\\n}};\\n\");\n            }\n        } else if ty.kind == TK_STRUCT {\n            n = self.escape(ty.name);\n            self.struct_def(m, t, n);\n        } else if ty.kind == TK_TEXTURE {\n            let sc = W::scalar(ty.scalar);\n            let st = self.pool.len();\n            if ty.n == TEX_DEPTH_2D {\n                self.pool.push_str(\"metal::depth2d<float, metal::access::sample>\");\n            } else if ty.n == TEX_2D_ARRAY {\n                self.pool.push_fmt(f\"metal::texture2d_array<{sc}, metal::access::sample>\");\n");
        buf_str(out, c"            } else if ty.n == TEX_STORAGE_2D {\n                self.pool.push_fmt(f\"metal::texture2d<{sc}, metal::access::write>\");\n            } else {\n                self.pool.push_fmt(f\"metal::texture2d<{sc}, metal::access::sample>\");\n            }\n            n = self.since(st);\n        } else if ty.kind == TK_SAMPLER {\n            n = self.intern(\"metal::sampler\");\n        } else {\n            n = self.intern(\"void\");\n        }\n        self.tname[t] = n;\n        self.tdone[t] = true;\n        n\n    }\n\n    // A member's MSL type: vec3 members are packed (12 bytes, as WGSL's).\n    fn member_ty(inout self, m: Module, t: i64) -> Nm {\n        let ty = m.types[t];\n        if ty.kind == TK_VECTOR && ty.n == 3 {\n            let st = self.pool.len();\n            self.pool.push_fmt(f\"metal::packed_{W::scalar(ty.scalar)}3\");\n            return self.since(st);\n        }\n        if ty.kind == TK_ARRAY && ty.n == 0 {\n            return self.ty(m, ty.base);\n        }\n        self.ty(m, t)\n    }\n\n    fn struct_def(inout self, m: Module, t: i64, name: Nm) {\n        let ty = m.types[t];\n        // member types first: they must be declared before\n        for i in ty.mstart..ty.mstart + ty.mcount {\n            self.member_ty(m, m.members[i].ty);\n        }\n        var b = Buf::new_in(self.a);\n        b.push_fmt(f\"struct {nm(self.pool, name)} {{\\n\");\n        var off = 0;\n        var pad = 0;\n        for i in ty.mstart..ty.mstart + ty.mcount {\n            let mem = m.members[i];\n            if mem.offset > off {\n                b.push_fmt(f\"    char _pad{pad}[{mem.offset - off}];\\n\");\n                pad += 1;\n            }\n            let mt = m.types[mem.ty];\n            let mty = self.member_ty(m, mem.ty);\n            let mn = self.escape(mem.name);\n            if mt.kind == TK_ARRAY && mt.n == 0 {\n                b.push_fmt(f\"    {nm(self.pool, mty)} {nm(self.pool, mn)}[1];\\n\");\n");
        buf_str(out, c"                off = mem.offset + mt.stride;\n            } else {\n                b.push_fmt(f\"    {nm(self.pool, mty)} {nm(self.pool, mn)};\\n\");\n                off = mem.offset + mt.size;\n            }\n        }\n        if ty.size > off\n            && !(ty.mcount > 0 && m.is_runtime_sized(m.members[ty.mstart + ty.mcount - 1].ty)) {\n            b.push_fmt(f\"    char _pad{pad}[{ty.size - off}];\\n\");\n        }\n        b.push_str(\"};\\n\");\n        copy_into(&self.types_out, b.as_slice());\n    }\n\n    // The padding members before member k of struct t (for aggregate\n    // initialization), and after the last.\n    fn pads_before(m: Module, t: i64, k: i64) -> bool {\n        let ty = m.types[t];\n        let mem = m.members[ty.mstart + k];\n        if k == 0 {\n            return mem.offset > 0;\n        }\n        let prev = m.members[ty.mstart + k - 1];\n        mem.offset > prev.offset + m.types[prev.ty].size\n    }\n\n    fn space(sp: u8, access: u8) -> [u8] {\n        if sp == SP_STORAGE {\n            if access & ACC_WRITE != 0 { \"device\" } else { \"const device\" }\n        } else if sp == SP_UNIFORM {\n            \"constant\"\n        } else if sp == SP_WORKGROUP {\n            \"threadgroup\"\n        } else {\n            \"thread\"\n        }\n    }\n}\n\n// ---- Shader compiler implementation, msl: Analysis (0.22) ----\n\nfn calls_of(f: Function, list: inout V<i64>) {\n    for s in 0..f.stmts.len() {\n        if f.stmts[s].op == S_CALL {\n            list.push(f.stmts[s].a);\n        }\n    }\n}\n\n// Functions in an order where each comes after those it calls.\npub fn call_order(m: Module, a: ScopedArena) -> V<i64> {\n    let n = m.functions.len();\n    var state: V<u8> = Vec::filled_in(n, 0u8, a);\n    var order: V<i64> = Vec::new_in(a);\n    for i in 0..n {\n        visit(m, i, &state, &order, a);\n    }\n    order\n}\n\nfn visit(m: Module, i: i64, state: inout V<u8>, order: inout V<i64>, a: ScopedArena) {\n    if state[i] != 0 {\n");
        buf_str(out, c"        return;\n    }\n    state[i] = 1;\n    var cs: V<i64> = Vec::new_in(a);\n    calls_of(m.functions[i], &cs);\n    for k in 0..cs.len() {\n        visit(m, cs[k], &state, &order, a);\n    }\n    order.push(i);\n}\n\n// Which globals each function uses, through its calls too (order: callees first).\npub fn global_uses(m: Module, order: V<i64>, a: ScopedArena) -> V<V<bool>> {\n    let ng = m.globals.len();\n    var uses: V<V<bool>> = Vec::new_in(a);\n    for _ in 0..m.functions.len() {\n        uses.push(Vec::filled_in(ng, false, a));\n    }\n    for oi in 0..order.len() {\n        let h = order[oi];\n        let f = m.functions[h];\n        for e in 0..f.exprs.len() {\n            if f.exprs[e].op == E_GLOBAL || f.exprs[e].op == E_ARRAY_LENGTH {\n                uses[h][f.exprs[e].a] = true;\n            }\n        }\n        for s in 0..f.stmts.len() {\n            if f.stmts[s].op == S_CALL {\n                let callee = f.stmts[s].a;\n                for g in 0..ng {\n                    if uses[callee][g] {\n                        uses[h][g] = true;\n                    }\n                }\n            }\n        }\n    }\n    uses\n}\n\n// Whether function h needs the sizes buffer (a runtime-sized array it or a\n// callee reads).\nfn needs_sizes(w: W, m: Module, h: i64) -> bool {\n    for g in 0..m.globals.len() {\n        if w.uses[h][g] && w.sl.size_index[g] >= 0 {\n            return true;\n        }\n    }\n    false\n}\n\n// The module as MSL; the reflection's Metal names and slots too.\npub fn write(m: Module, a: ScopedArena, out: inout Buf, refl: inout api::Reflection) {\n    var w = new_writer(m, a);\n    let order = call_order(m, a);\n    w.uses = global_uses(m, order, a);\n    w.sl = slots(m, w.uses, a);\n    for oi in 0..order.len() {\n        let h = order[oi];\n        var is_entry = false;\n        for e in 0..m.entries.len() {\n            if m.entries[e].func == h {\n                is_entry = true;\n            }\n        }\n");
        buf_str(out, c"        if !is_entry {\n            write_fn(&w, m, h);\n        }\n    }\n    for e in 0..m.entries.len() {\n        write_entry(&w, m, e);\n    }\n    finish(w, &out);\n    // the Metal side of the reflection\n    for e in 0..refl.entries.len() {\n        refl.entries[e].target_name.clear();\n        refl.entries[e].target_name.push_str(nm(w.pool, w.fnames[m.entries[e].func]));\n        refl.entries[e].sizes_slot = w.sl.sizes_slot[m.entries[e].stage as i64];\n    }\n    let ng = m.globals.len();\n    for b in 0..refl.bindings.len() {\n        let g = refl.bindings[b].global;\n        for st in 0..3 {\n            refl.bindings[b].slots[st] = w.sl.slot[st * ng + g];\n        }\n    }\n}\n\nfn new_writer(m: Module, a: ScopedArena) -> W {\n    var w = W {\n        a: a,\n        out: Buf::with_capacity_in(16384, a),\n        tname: Vec::new_in(a),\n        tdone: Vec::new_in(a),\n        types_out: Buf::new_in(a),\n        need_div: false,\n        need_f2i: false,\n        need_sign: false,\n        need_flb: false,\n        need_ftb: false,\n        need_cmpxchg: Vec::new_in(a),\n        sl: Slots {\n            slot: Vec::new_in(a), size_index: Vec::new_in(a), sizes_count: 0,\n            sizes_slot: [-1, -1, -1]\n        },\n        uses: Vec::new_in(a),\n        fnames: Vec::new_in(a),\n        gnames: Vec::new_in(a),\n        fh: -1,\n        refc: Vec::new_in(a),\n        baked: Vec::new_in(a),\n        lnames: Vec::new_in(a),\n        enames: Vec::new_in(a),\n        used: Vec::new_in(a),\n        indent: 0,\n        loop_n: 0,\n        stage: 255,\n        out_name: Nm { start: 0, len: 0 },\n        pool: Buf::with_capacity_in(4096, a),\n        ret_ty: -1,\n        kinds: Vec::new_in(a),\n    };\n    for t in 0..m.types.len() {\n        w.tname.push(Nm { start: 0, len: 0 });\n        w.tdone.push(false);\n        w.kinds.push(m.types[t].kind);\n    }\n    // module-scope names: functions and globals, unique among themselves\n");
        buf_str(out, c"    for h in 0..m.functions.len() {\n        let n = w.unique(m.functions[h].name);\n        w.fnames.push(n);\n    }\n    for g in 0..m.globals.len() {\n        let n = w.unique(m.globals[g].name);\n        w.gnames.push(n);\n    }\n    w\n}\n\nfn helpers<A: Allocator>(w: W, out: inout Buf<A>) {\n    if w.need_div {\n        out.push_str(\"static inline int _w_div(int a, int b) { return a / metal::select(b, 1, b == 0 || (a == (-2147483647 - 1) && b == -1)); }\\n\");\n        out.push_str(\"static inline uint _w_div(uint a, uint b) { return a / metal::select(b, 1u, b == 0u); }\\n\");\n        out.push_str(\"static inline int _w_mod(int a, int b) { int c = metal::select(b, 1, b == 0 || (a == (-2147483647 - 1) && b == -1)); return a - (a / c) * c; }\\n\");\n        out.push_str(\"static inline uint _w_mod(uint a, uint b) { return metal::select(a % metal::select(b, 1u, b == 0u), 0u, b == 0u); }\\n\");\n        for n in 2..5 {\n            for k in 0..2 {\n                let t = if k == 0 { \"int\" } else { \"uint\" };\n                out.push_fmt(\n                    f\"static inline metal::{t}{n} _w_div(metal::{t}{n} a, metal::{t}{n} b) {{ metal::{t}{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_div(a[i], b[i]); return r; }}\\n\");\n                out.push_fmt(\n                    f\"static inline metal::{t}{n} _w_mod(metal::{t}{n} a, metal::{t}{n} b) {{ metal::{t}{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_mod(a[i], b[i]); return r; }}\\n\");\n            }\n        }\n    }\n    if w.need_f2i {\n        out.push_str(\"static inline int _w_f2i(float x) { return metal::isnan(x) ? 0 : int(metal::clamp(x, -2147483648.0f, 2147483520.0f)); }\\n\");\n        out.push_str(\"static inline uint _w_f2u(float x) { return metal::isnan(x) ? 0u : uint(metal::clamp(x, 0.0f, 4294967040.0f)); }\\n\");\n        for n in 2..5 {\n            out.push_fmt(\n");
        buf_str(out, c"                f\"static inline metal::int{n} _w_f2i(metal::float{n} x) {{ metal::int{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_f2i(x[i]); return r; }}\\n\");\n            out.push_fmt(\n                f\"static inline metal::uint{n} _w_f2u(metal::float{n} x) {{ metal::uint{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_f2u(x[i]); return r; }}\\n\");\n        }\n    }\n    if w.need_sign {\n        out.push_str(\"template <typename T> static inline T _w_isign(T x) { return metal::select(metal::select(T(0), T(-1), x < T(0)), T(1), x > T(0)); }\\n\");\n    }\n    if w.need_flb {\n        out.push_str(\"static inline uint _w_flb(uint x) { return metal::select(31u - metal::clz(x), 4294967295u, x == 0u); }\\n\");\n        out.push_str(\"static inline int _w_flb(int x) { uint y = as_type<uint>(metal::select(x, ~x, x < 0)); return as_type<int>(metal::select(31u - metal::clz(y), 4294967295u, y == 0u)); }\\n\");\n        for n in 2..5 {\n            for k in 0..2 {\n                let t = if k == 0 { \"int\" } else { \"uint\" };\n                out.push_fmt(\n                    f\"static inline metal::{t}{n} _w_flb(metal::{t}{n} x) {{ metal::{t}{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_flb(x[i]); return r; }}\\n\");\n            }\n        }\n    }\n    if w.need_ftb {\n        out.push_str(\"template <typename T> static inline T _w_ftb(T x) { return metal::select(metal::ctz(x), T(4294967295u), x == T(0)); }\\n\");\n    }\n    for i in 0..w.need_cmpxchg.len() {\n        out.push_str(w.s(w.need_cmpxchg[i]));\n    }\n}\n\nfn finish(w: W, out: inout Buf) {\n    out.push_str(\n        \"// Generated by wgslc (MSL 3.0).\\n#include <metal_stdlib>\\n#include <simd/simd.h>\\n\\n\");\n    helpers(w, &out);\n    out.push('\\n');\n    out.push_str(w.types_out.as_slice());\n    out.push_str(w.out.as_slice());\n}\n\n// ---- Shader compiler implementation, msl: Functions (0.22) ----\n\nfn count_refs(w: inout W, f: Function) {\n    w.refc.clear();\n    w.baked.clear();\n");
        buf_str(out, c"    for _ in 0..f.exprs.len() {\n        w.refc.push(0);\n        w.baked.push(false);\n    }\n    for e in 0..f.exprs.len() {\n        let x = f.exprs[e];\n        let op = x.op;\n        if op == E_ACCESS || op == E_BINARY {\n            if op == E_ACCESS {\n                w.refc[x.a] += 1;\n                w.refc[x.b] += 1;\n            } else {\n                w.refc[x.b] += 1;\n                w.refc[x.c] += 1;\n            }\n        }\n        else if op == E_ACCESS_INDEX || op == E_SPLAT || op == E_SWIZZLE || op == E_LOAD\n            || op == E_CONVERT || op == E_BITCAST {\n            w.refc[x.a] += 1;\n        } else if op == E_UNARY || op == E_DERIVATIVE {\n            w.refc[x.b] += 1;\n        } else if op == E_SELECT {\n            w.refc[x.a] += 1;\n            w.refc[x.b] += 1;\n            w.refc[x.c] += 1;\n        } else if op == E_COMPOSE {\n            for k in x.a..x.a + x.b {\n                w.refc[f.args[k]] += 1;\n            }\n        } else if op == E_MATH {\n            for k in x.b..x.b + x.c {\n                w.refc[f.args[k]] += 1;\n            }\n        } else if op == E_IMAGE_SAMPLE {\n            for k in x.c..x.c + (x.d >> 8) {\n                w.refc[f.args[k]] += 1;\n            }\n        } else if op == E_IMAGE_LOAD {\n            for k in x.c..x.c + x.d {\n                w.refc[f.args[k]] += 1;\n            }\n        } else if op == E_IMAGE_QUERY {\n            if x.c >= 0 {\n                w.refc[x.c] += 1;\n            }\n        }\n    }\n    for s in 0..f.stmts.len() {\n        let st = f.stmts[s];\n        if st.op == S_IF || st.op == S_SWITCH {\n            w.refc[st.a] += 1;\n        } else if st.op == S_STORE {\n            w.refc[st.a] += 1;\n            w.refc[st.b] += 1;\n        } else if st.op == S_RETURN && st.a >= 0 {\n            w.refc[st.a] += 1;\n        } else if st.op == S_LOOP && st.c >= 0 {\n            w.refc[st.c] += 1;\n        } else if st.op == S_CALL {\n");
        buf_str(out, c"            for k in st.b..st.b + st.c {\n                w.refc[f.args[k]] += 1;\n            }\n        } else if st.op == S_ATOMIC {\n            if st.c >= 0 {\n                w.refc[st.c] += 1;\n            }\n            if st.e >= 0 {\n                w.refc[st.e] += 1;\n            }\n        } else if st.op == S_IMAGE_STORE {\n            w.refc[st.b] += 1;\n            w.refc[st.c] += 1;\n            if st.d >= 0 {\n                w.refc[st.d] += 1;\n            }\n        }\n    }\n    for e in 0..f.exprs.len() {\n        let x = f.exprs[e];\n        let op = x.op;\n        let leaf = op == E_LITERAL || op == E_ARG || op == E_GLOBAL || op == E_LOCAL\n            || op == E_CALL_RESULT || op == E_ATOMIC_RESULT || op == E_WG_UNIFORM_RESULT;\n        if leaf {\n            continue;\n        }\n        let k = w.kinds[f.exprs[e].ty];\n        if k == TK_POINTER {\n            continue;\n        }\n        if op == E_LOAD || op == E_IMAGE_SAMPLE || op == E_IMAGE_LOAD || op == E_DERIVATIVE\n            || w.refc[e] > 1 || f.names[e].len > 0 {\n            w.baked[e] = true;\n        }\n    }\n}\n\n// ---- Shader compiler implementation, msl: Expressions (0.22) ----\n\nimpl W {\n    fn lit(inout self, m: Module, f: Function, e: i64) {\n        let x = f.exprs[e];\n        let sk = m.types[x.ty].scalar;\n        if sk == SK_BOOL {\n            self.p(if x.a != 0 { \"true\" } else { \"false\" });\n        } else if sk == SK_U32 {\n            self.out.push_fmt(f\"{x.a}u\");\n        } else if sk == SK_I32 {\n            let v = x.a as u32 as i32 as i64;\n            if v == -2147483648 {\n                self.p(\"(-2147483647 - 1)\");\n            } else if v < 0 {\n                self.out.push_fmt(f\"({v})\");\n            } else {\n                self.out.push_fmt(f\"{v}\");\n            }\n        } else {\n            let v = bits_f32(x.a as u32);\n            let ex = (x.a >> 23) & 255;\n            if ex == 255 {\n");
        buf_str(out, c"                self.out.push_fmt(f\"as_type<float>({x.a}u)\");\n                return;\n            }\n            var b = Buf::new_in(self.a);\n            b.push_fmt(f\"{v}\");\n            let s = b.as_slice();\n            var has_dot = false;\n            for i in 0..s.len {\n                if s[i] == '.' || s[i] == 'e' || s[i] == 'E' || s[i] == 'n' || s[i] == 'i' {\n                    has_dot = true;\n                }\n            }\n            if s[0] == '-' {\n                self.p(\"(\");\n            }\n            self.p(s);\n            if !has_dot {\n                self.p(\".0\");\n            }\n            self.p(\"f\");\n            if s[0] == '-' {\n                self.p(\")\");\n            }\n        }\n    }\n\n    // e as a value: its name, or its text.\n    fn val(inout self, m: Module, f: Function, e: i64) {\n        let op = f.exprs[e].op;\n        if self.baked[e] || op == E_CALL_RESULT || op == E_ATOMIC_RESULT\n            || op == E_WG_UNIFORM_RESULT {\n            self.pn(self.enames[e]);\n            return;\n        }\n        if op == E_ARG {\n            self.pn(self.enames[e]);\n            return;\n        }\n        self.render(m, f, e);\n    }\n\n    // The unsigned type of the same shape as t (i32 -> uint, int3 -> uint3).\n    fn utype(inout self, m: Module, t: i64) -> Nm {\n        let ty = m.types[t];\n        if ty.kind == TK_VECTOR {\n            let st = self.pool.len();\n            self.pool.push_fmt(f\"metal::uint{ty.n}\");\n            return self.since(st);\n        }\n        self.intern(\"uint\")\n    }\n\n    // The index of an E_ACCESS, clamped when its check says so.\n    fn index(inout self, m: Module, f: Function, e: i64) {\n        let x = f.exprs[e];\n        if x.c == CK_CLAMP {\n            self.p(\"metal::min(uint(\");\n            self.val(m, f, x.b);\n            self.out.push_fmt(f\"), {x.d - 1}u)\");\n        } else {\n            self.val(m, f, x.b);\n        }\n    }\n\n");
        buf_str(out, c"    // A pointer expression as an lvalue.\n    fn lval(inout self, m: Module, f: Function, e: i64) {\n        let x = f.exprs[e];\n        if x.op == E_GLOBAL {\n            self.pn(self.gnames[x.a]);\n        } else if x.op == E_LOCAL {\n            self.pn(self.lnames[x.a]);\n        } else if x.op == E_ARG {\n            self.out.push_fmt(f\"(*{nm(self.pool, self.enames[e])})\");\n        } else if x.op == E_ACCESS || x.op == E_ACCESS_INDEX {\n            let bt = m.types[m.pointee(f.exprs[x.a].ty)];\n            self.lval(m, f, x.a);\n            self.selector(m, f, e, bt);\n        } else {\n            self.p(\"/* not a pointer */\");\n        }\n    }\n\n    // `.member`, `[i]` or `.inner[i]` after a base of type bt.\n    fn selector(inout self, m: Module, f: Function, e: i64, bt: Type) {\n        let x = f.exprs[e];\n        if x.op == E_ACCESS_INDEX {\n            if bt.kind == TK_STRUCT {\n                self.p(\".\");\n                let n = self.escape(m.members[bt.mstart + x.b].name);\n                self.pn(n);\n            } else if bt.kind == TK_ARRAY && bt.n > 0 {\n                self.out.push_fmt(f\".inner[{x.b}]\");\n            } else {\n                self.out.push_fmt(f\"[{x.b}]\");\n            }\n            return;\n        }\n        if bt.kind == TK_ARRAY && bt.n > 0 {\n            self.p(\".inner\");\n        }\n        self.p(\"[\");\n        self.index(m, f, e);\n        self.p(\"]\");\n    }\n\n    // Whether e (a pointer, or a member value) is a struct's vec3 member,\n    // which MSL holds packed.\n    fn is_packed_member(self, m: Module, f: Function, e: i64) -> bool {\n        let x = f.exprs[e];\n        if x.op != E_ACCESS_INDEX {\n            return false;\n        }\n        let bt0 = f.exprs[x.a].ty;\n        let bt = if m.types[bt0].kind == TK_POINTER { m.types[bt0].base } else { bt0 };\n        if m.types[bt].kind != TK_STRUCT {\n            return false;\n        }\n");
        buf_str(out, c"        let mt = m.types[m.members[m.types[bt].mstart + x.b].ty];\n        mt.kind == TK_VECTOR && mt.n == 3\n    }\n\n    // The conditions under which the pointer e is in range (runtime-sized\n    // arrays); false when there are none.\n    fn guards(inout self, m: Module, f: Function, e: i64, any: bool) -> bool {\n        let x = f.exprs[e];\n        var a = any;\n        if x.op == E_ACCESS || x.op == E_ACCESS_INDEX {\n            a = self.guards(m, f, x.a, a);\n            if x.op == E_ACCESS && x.c == CK_RZSW {\n                if a {\n                    self.p(\" && \");\n                }\n                self.p(\"uint(\");\n                self.val(m, f, x.b);\n                self.p(\") < \");\n                self.runtime_len(m, f, x.a);\n                a = true;\n            }\n        }\n        a\n    }\n\n    fn has_guards(self, f: Function, e: i64) -> bool {\n        let x = f.exprs[e];\n        if x.op == E_ACCESS && x.c == CK_RZSW {\n            return true;\n        }\n        if x.op == E_ACCESS || x.op == E_ACCESS_INDEX {\n            return self.has_guards(f, x.a);\n        }\n        false\n    }\n\n    // The length of the runtime-sized array pointer `base` points to.\n    fn runtime_len(inout self, m: Module, f: Function, base: i64) {\n        let b = f.exprs[base];\n        var g = -1;\n        var off = 0;\n        if b.op == E_GLOBAL {\n            g = b.a;\n        } else if b.op == E_ACCESS_INDEX && f.exprs[b.a].op == E_GLOBAL {\n            g = f.exprs[b.a].a;\n            let st = m.types[m.globals[g].ty];\n            off = m.members[st.mstart + b.b].offset;\n        }\n        let stride = m.types[m.pointee(b.ty)].stride;\n        self.len_text(g, off, stride);\n    }\n\n    fn len_text(inout self, g: i64, off: i64, stride: i64) {\n        if g < 0 {\n            self.p(\"0u\");\n            return;\n        }\n        let k = self.sl.size_index[g];\n        if off == 0 {\n");
        buf_str(out, c"            self.out.push_fmt(f\"(_w_sizes[{k}] / {stride}u)\");\n        } else {\n            self.out.push_fmt(\n                f\"(_w_sizes[{k}] >= {off}u ? (_w_sizes[{k}] - {off}u) / {stride}u : 0u)\");\n        }\n    }\n\n    fn render(inout self, m: Module, f: Function, e: i64) {\n        let x = f.exprs[e];\n        let op = x.op;\n        let t = m.types[x.ty];\n        if op == E_LITERAL {\n            self.lit(m, f, e);\n        } else if op == E_ZERO {\n            self.pty(m, x.ty);\n            self.p(\" {}\");\n        } else if op == E_COMPOSE {\n            let tn = self.ty(m, x.ty);\n            self.pn(tn);\n            if t.kind == TK_VECTOR || t.kind == TK_MATRIX {\n                self.p(\"(\");\n            } else if t.kind == TK_ARRAY {\n                self.p(\" {{\");\n            } else {\n                self.p(\" {\");\n            }\n            for k in 0..x.b {\n                if k > 0 {\n                    self.p(\", \");\n                }\n                if t.kind == TK_STRUCT && W::pads_before(m, x.ty, k) {\n                    self.p(\"{}, \");\n                }\n                self.val(m, f, f.args[x.a + k]);\n            }\n            if t.kind == TK_VECTOR || t.kind == TK_MATRIX {\n                self.p(\")\");\n            } else if t.kind == TK_ARRAY {\n                self.p(\"}}\");\n            } else {\n                self.p(\"}\");\n            }\n        } else if op == E_SPLAT {\n            self.pty(m, x.ty);\n            self.p(\"(\");\n            self.val(m, f, x.a);\n            self.p(\")\");\n        } else if op == E_SWIZZLE {\n            self.p(\"(\");\n            self.val(m, f, x.a);\n            self.p(\").\");\n            for k in 0..x.c {\n                self.out.push(\"xyzw\"[(x.b >> (2 * k)) & 3]);\n            }\n        } else if op == E_ACCESS || op == E_ACCESS_INDEX {\n            let bt = m.types[f.exprs[x.a].ty];\n");
        buf_str(out, c"            let packed = op == E_ACCESS_INDEX && self.is_packed_member(m, f, e);\n            if packed {\n                self.pty(m, x.ty);\n                self.p(\"(\");\n            }\n            self.p(\"(\");\n            self.val(m, f, x.a);\n            self.p(\")\");\n            self.selector(m, f, e, bt);\n            if packed {\n                self.p(\")\");\n            }\n        } else if op == E_LOAD {\n            let pe = x.a;\n            let g = self.has_guards(f, pe);\n            if g {\n                self.p(\"(\");\n                self.guards(m, f, pe, false);\n                self.p(\" ? \");\n            }\n            let packed = self.is_packed_member(m, f, pe);\n            if packed {\n                self.pty(m, x.ty);\n                self.p(\"(\");\n            }\n            self.lval(m, f, pe);\n            if packed {\n                self.p(\")\");\n            }\n            if g {\n                self.p(\" : \");\n                self.pty(m, x.ty);\n                self.p(\" {})\");\n            }\n        } else if op == E_UNARY {\n            let sk = t.scalar;\n            if x.a == UN_NEG && sk == SK_I32 {\n                let _n1 = self.ty(m, x.ty);\n                let _n2 = self.utype(m, x.ty);\n                self.out.push_fmt(\n                    f\"as_type<{nm(self.pool, _n1)}>(-as_type<{nm(self.pool, _n2)}>(\");\n                self.val(m, f, x.b);\n                self.p(\"))\");\n            } else {\n                self.p(if x.a == UN_NEG { \"(-\" } else if x.a == UN_NOT { \"(!\" } else { \"(~\" });\n                self.val(m, f, x.b);\n                self.p(\")\");\n            }\n        } else if op == E_BINARY {\n            self.binary(m, f, e);\n        } else if op == E_SELECT {\n            let ct = m.types[f.exprs[x.a].ty];\n            if ct.kind == TK_SCALAR {\n                self.p(\"(\");\n                self.val(m, f, x.a);\n                self.p(\" ? \");\n");
        buf_str(out, c"                self.val(m, f, x.b);\n                self.p(\" : \");\n                self.val(m, f, x.c);\n                self.p(\")\");\n            } else {\n                self.p(\"metal::select(\");\n                self.val(m, f, x.c);\n                self.p(\", \");\n                self.val(m, f, x.b);\n                self.p(\", \");\n                self.val(m, f, x.a);\n                self.p(\")\");\n            }\n        } else if op == E_CONVERT {\n            let from = m.types[f.exprs[x.a].ty].scalar;\n            if from == SK_F32 && (t.scalar == SK_I32 || t.scalar == SK_U32) {\n                self.need_f2i = true;\n                self.p(if t.scalar == SK_I32 { \"_w_f2i(\" } else { \"_w_f2u(\" });\n            } else {\n                self.pty(m, x.ty);\n                self.p(\"(\");\n            }\n            self.val(m, f, x.a);\n            self.p(\")\");\n        } else if op == E_BITCAST {\n            let _n3 = self.ty(m, x.ty);\n            self.out.push_fmt(f\"as_type<{nm(self.pool, _n3)}>(\");\n            self.val(m, f, x.a);\n            self.p(\")\");\n        } else if op == E_MATH {\n            self.math(m, f, e);\n        } else if op == E_ARRAY_LENGTH {\n            self.len_text(x.a, x.c, x.d);\n        } else if op == E_DERIVATIVE {\n            self.p(if x.a == 0 { \"metal::dfdx(\" } else if x.a == 1 { \"metal::dfdy(\" }\n                else { \"metal::fwidth(\" });\n            self.val(m, f, x.b);\n            self.p(\")\");\n        } else if op == E_IMAGE_SAMPLE {\n            self.sample(m, f, e);\n        } else if op == E_IMAGE_LOAD {\n            self.image_load(m, f, e);\n        } else if op == E_IMAGE_QUERY {\n            let tex = self.enames_or_global(m, f, x.a);\n            if x.b == IQ_LEVELS {\n                self.out.push_fmt(f\"{nm(self.pool, tex)}.get_num_mip_levels()\");\n            } else if x.b == IQ_LAYERS {\n                self.out.push_fmt(f\"{nm(self.pool, tex)}.get_array_size()\");\n");
        buf_str(out, c"            } else {\n                let tt = m.types[f.exprs[x.a].ty];\n                if x.c >= 0 && tt.n != TEX_STORAGE_2D {\n                    self.out.push_fmt(f\"metal::uint2({nm(self.pool, tex)}.get_width(\");\n                    self.val(m, f, x.c);\n                    self.out.push_fmt(f\"), {nm(self.pool, tex)}.get_height(\");\n                    self.val(m, f, x.c);\n                    self.p(\"))\");\n                } else {\n                    self.out.push_fmt(\n                        f\"metal::uint2({nm(self.pool, tex)}.get_width(), {nm(self.pool, tex)}.get_height())\");\n                }\n            }\n        } else {\n            self.p(\"/* ? */\");\n        }\n    }\n\n    fn enames_or_global(self, m: Module, f: Function, e: i64) -> Nm {\n        let x = f.exprs[e];\n        if x.op == E_GLOBAL {\n            return self.gnames[x.a];\n        }\n        self.enames[e]\n    }\n\n    fn binary(inout self, m: Module, f: Function, e: i64) {\n        let x = f.exprs[e];\n        let op = x.a;\n        let lt = m.types[f.exprs[x.b].ty];\n        let sk = lt.scalar;\n        let int = (sk == SK_I32 || sk == SK_U32) && lt.kind != TK_MATRIX;\n        if int && (op == OP_DIV || op == OP_MOD) {\n            // a literal divisor other than 0 (and -1 for i32) needs no helper\n            let r = f.exprs[x.c];\n            let lit_ok = r.op == E_LITERAL && r.a != 0 && !(sk == SK_I32 && r.a == 4294967295);\n            if lit_ok && !(sk == SK_I32 && op == OP_MOD) {\n                self.p(\"(\");\n                self.val(m, f, x.b);\n                self.p(if op == OP_DIV { \" / \" } else { \" % \" });\n                self.val(m, f, x.c);\n                self.p(\")\");\n                return;\n            }\n            self.need_div = true;\n            self.p(if op == OP_DIV { \"_w_div(\" } else { \"_w_mod(\" });\n            self.val(m, f, x.b);\n            self.p(\", \");\n            self.val(m, f, x.c);\n            self.p(\")\");\n");
        buf_str(out, c"            return;\n        }\n        if sk == SK_I32 && (op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_SHL) {\n            let tn = self.ty(m, f.exprs[x.b].ty);\n            let un = self.utype(m, f.exprs[x.b].ty);\n            self.out.push_fmt(f\"as_type<{nm(self.pool, tn)}>(as_type<{nm(self.pool, un)}>(\");\n            self.val(m, f, x.b);\n            self.p(if op == OP_ADD { \") + as_type<\" } else if op == OP_SUB { \") - as_type<\" }\n                else if op == OP_MUL { \") * as_type<\" } else { \") << (\" });\n            if op == OP_SHL {\n                self.val(m, f, x.c);\n                self.p(\" & 31u))\");\n            } else {\n                self.out.push_fmt(f\"{nm(self.pool, un)}>(\");\n                self.val(m, f, x.c);\n                self.p(\"))\");\n            }\n            return;\n        }\n        if op == OP_MOD && sk == SK_F32 {\n            self.p(\"metal::fmod(\");\n            self.val(m, f, x.b);\n            self.p(\", \");\n            self.val(m, f, x.c);\n            self.p(\")\");\n            return;\n        }\n        self.p(\"(\");\n        self.val(m, f, x.b);\n        let s = if op == OP_ADD {\n            \" + \"\n        } else if op == OP_SUB {\n            \" - \"\n        } else if op == OP_MUL {\n            \" * \"\n        } else if op == OP_DIV {\n            \" / \"\n        } else if op == OP_EQ {\n            \" == \"\n        } else if op == OP_NE {\n            \" != \"\n        } else if op == OP_LT {\n            \" < \"\n        } else if op == OP_LE {\n            \" <= \"\n        } else if op == OP_GT {\n            \" > \"\n        } else if op == OP_GE {\n            \" >= \"\n        } else if op == OP_AND {\n            if sk == SK_BOOL && lt.kind == TK_SCALAR { \" && \" } else { \" & \" }\n        } else if op == OP_OR {\n            if sk == SK_BOOL && lt.kind == TK_SCALAR { \" || \" } else { \" | \" }\n        } else if op == OP_XOR {\n");
        buf_str(out, c"            if sk == SK_BOOL { \" != \" } else { \" ^ \" }\n        } else if op == OP_SHL {\n            \" << (\"\n        } else if op == OP_SHR {\n            \" >> (\"\n        } else if op == OP_LAND {\n            \" && \"\n        } else {\n            \" || \"\n        };\n        self.p(s);\n        self.val(m, f, x.c);\n        if op == OP_SHL || op == OP_SHR {\n            self.p(\" & 31u)\");\n        }\n        self.p(\")\");\n    }\n\n    fn math(inout self, m: Module, f: Function, e: i64) {\n        let x = f.exprs[e];\n        let fun = x.a;\n        let a0 = f.args[x.b];\n        let at = m.types[f.exprs[a0].ty];\n        let sk = at.scalar;\n        let int = sk == SK_I32 || sk == SK_U32;\n        if fun == ir::MF_ABS && sk == SK_I32 {\n            // abs(MIN) is MIN: through uint\n            let _n4 = self.ty(m, x.ty);\n            let _n5 = self.utype(m, x.ty);\n            self.out.push_fmt(\n                f\"as_type<{nm(self.pool, _n4)}>(metal::select(as_type<{nm(self.pool, _n5)}>(\");\n            self.val(m, f, a0);\n            let _n6 = self.utype(m, x.ty);\n            self.out.push_fmt(f\"), -as_type<{nm(self.pool, _n6)}>(\");\n            self.val(m, f, a0);\n            self.p(\"), \");\n            self.val(m, f, a0);\n            let _n7 = self.ty(m, x.ty);\n            self.out.push_fmt(f\" < {nm(self.pool, _n7)}(0)))\");\n            return;\n        }\n        if fun == ir::MF_ABS && sk == SK_U32 {\n            self.val(m, f, a0);\n            return;\n        }\n        if fun == ir::MF_SIGN && int {\n            self.need_sign = true;\n            self.p(\"_w_isign(\");\n            self.val(m, f, a0);\n            self.p(\")\");\n            return;\n        }\n        if fun == ir::MF_DOT && int {\n            // wrapping: as the sum of products, through uint\n            let n = at.n;\n            self.out.push_fmt(f\"as_type<{W::scalar(sk)}>(\");\n            for k in 0..n {\n                if k > 0 {\n");
        buf_str(out, c"                    self.p(\" + \");\n                }\n                self.p(\"as_type<uint>(\");\n                self.val(m, f, a0);\n                self.out.push_fmt(f\"[{k}]) * as_type<uint>(\");\n                self.val(m, f, f.args[x.b + 1]);\n                self.out.push_fmt(f\"[{k}])\");\n            }\n            self.p(\")\");\n            return;\n        }\n        if fun == ir::MF_FIRST_LEADING_BIT {\n            self.need_flb = true;\n            self.p(\"_w_flb(\");\n            self.val(m, f, a0);\n            self.p(\")\");\n            return;\n        }\n        if fun == ir::MF_FIRST_TRAILING_BIT {\n            self.need_ftb = true;\n            self.p(\"_w_ftb(\");\n            self.val(m, f, a0);\n            self.p(\")\");\n            return;\n        }\n        if fun == ir::MF_EXTRACT_BITS || fun == ir::MF_INSERT_BITS {\n            // WGSL clamps offset and count; Metal leaves them undefined\n            let k = if fun == ir::MF_EXTRACT_BITS { 1 } else { 2 };\n            self.p(if fun == ir::MF_EXTRACT_BITS { \"metal::extract_bits(\" }\n                else { \"metal::insert_bits(\" });\n            for i in 0..k {\n                self.val(m, f, f.args[x.b + i]);\n                self.p(\", \");\n            }\n            self.p(\"metal::min(\");\n            self.val(m, f, f.args[x.b + k]);\n            self.p(\", 32u), metal::min(\");\n            self.val(m, f, f.args[x.b + k + 1]);\n            self.p(\", 32u - metal::min(\");\n            self.val(m, f, f.args[x.b + k]);\n            self.p(\", 32u)))\");\n            return;\n        }\n        if fun == ir::MF_DEGREES || fun == ir::MF_RADIANS {\n            self.p(\"(\");\n            self.val(m, f, a0);\n            self.p(if fun == ir::MF_DEGREES { \" * 57.2957795131f)\" }\n                else { \" * 0.0174532925199f)\" });\n            return;\n        }\n        if fun == ir::MF_PACK2X16FLOAT {\n            self.p(\"as_type<uint>(metal::half2(\");\n");
        buf_str(out, c"            self.val(m, f, a0);\n            self.p(\"))\");\n            return;\n        }\n        if fun == ir::MF_UNPACK2X16FLOAT {\n            self.p(\"metal::float2(as_type<metal::half2>(\");\n            self.val(m, f, a0);\n            self.p(\"))\");\n            return;\n        }\n        let name = if fun < MATH_NAMES.len() {\n            MATH_NAMES[fun]\n        } else if fun == ir::MF_COUNT_ONE_BITS {\n            \"popcount\"\n        } else if fun == ir::MF_COUNT_LEADING_ZEROS {\n            \"clz\"\n        } else if fun == ir::MF_COUNT_TRAILING_ZEROS {\n            \"ctz\"\n        } else if fun == ir::MF_REVERSE_BITS {\n            \"reverse_bits\"\n        } else if fun == ir::MF_ALL {\n            \"all\"\n        } else if fun == ir::MF_ANY {\n            \"any\"\n        } else if fun == ir::MF_SATURATE {\n            \"saturate\"\n        } else if fun == ir::MF_ASINH {\n            \"asinh\"\n        } else if fun == ir::MF_ACOSH {\n            \"acosh\"\n        } else if fun == ir::MF_ATANH {\n            \"atanh\"\n        } else if fun == ir::MF_FACE_FORWARD {\n            \"faceforward\"\n        } else if fun == ir::MF_LDEXP {\n            \"ldexp\"\n        } else if fun == ir::MF_PACK4X8UNORM {\n            \"pack_float_to_unorm4x8\"\n        } else if fun == ir::MF_UNPACK4X8UNORM {\n            \"unpack_unorm4x8_to_float\"\n        } else if fun == ir::MF_PACK4X8SNORM {\n            \"pack_float_to_snorm4x8\"\n        } else if fun == ir::MF_UNPACK4X8SNORM {\n            \"unpack_snorm4x8_to_float\"\n        } else if fun == ir::MF_PACK2X16UNORM {\n            \"pack_float_to_unorm2x16\"\n        } else if fun == ir::MF_UNPACK2X16UNORM {\n            \"unpack_unorm2x16_to_float\"\n        } else if fun == ir::MF_PACK2X16SNORM {\n            \"pack_float_to_snorm2x16\"\n        } else {\n            \"unpack_snorm2x16_to_float\"\n        };\n        self.p(\"metal::\");\n        self.p(name);\n        self.p(\"(\");\n");
        buf_str(out, c"        for k in 0..x.c {\n            if k > 0 {\n                self.p(\", \");\n            }\n            self.val(m, f, f.args[x.b + k]);\n        }\n        self.p(\")\");\n    }\n\n    fn sample(inout self, m: Module, f: Function, e: i64) {\n        let x = f.exprs[e];\n        let kind = x.d & 255;\n        let n = x.d >> 8;\n        let tt = m.types[f.exprs[x.a].ty];\n        let tex = self.enames_or_global(m, f, x.a);\n        let smp = self.enames_or_global(m, f, x.b);\n        let compare = kind == IMG_SAMPLE_COMPARE || kind == IMG_SAMPLE_COMPARE_LEVEL;\n        self.out.push_fmt(\n            f\"{nm(self.pool, tex)}.{if compare { \"sample_compare\" } else { \"sample\" }}({nm(self.pool, smp)}, \");\n        self.val(m, f, f.args[x.c]);\n        var k = 1;\n        if tt.n == TEX_2D_ARRAY {\n            self.p(\", \");\n            self.val(m, f, f.args[x.c + 1]);\n            k = 2;\n        }\n        if kind == IMG_SAMPLE_BIAS {\n            self.p(\", metal::bias(\");\n            self.val(m, f, f.args[x.c + k]);\n            self.p(\")\");\n        } else if kind == IMG_SAMPLE_LEVEL {\n            self.p(\", metal::level(\");\n            self.val(m, f, f.args[x.c + k]);\n            self.p(\")\");\n        } else if compare {\n            self.p(\", \");\n            self.val(m, f, f.args[x.c + k]);\n            if kind == IMG_SAMPLE_COMPARE_LEVEL {\n                self.p(\", metal::level(0)\");\n            }\n        }\n        let _ = n;\n        self.p(\")\");\n    }\n\n    // textureLoad: the level, layer and coordinates clamped into range.\n    fn image_load(inout self, m: Module, f: Function, e: i64) {\n        let x = f.exprs[e];\n        let tt = m.types[f.exprs[x.a].ty];\n        let tex = self.enames_or_global(m, f, x.a);\n        let arrayed = tt.n == TEX_2D_ARRAY;\n        let lvl = f.args[x.c + x.d - 1];\n        let saved = std::replace(&self.out, Buf::new_in(self.a));\n        self.out.push_fmt(f\"metal::min(uint(\");\n");
        buf_str(out, c"        self.val(m, f, lvl);\n        self.out.push_fmt(f\"), {nm(self.pool, tex)}.get_num_mip_levels() - 1u)\");\n        let lb = std::replace(&self.out, saved);\n        let l = lb.as_slice();\n        self.out.push_fmt(f\"{nm(self.pool, tex)}.read(metal::min(metal::uint2(\");\n        self.val(m, f, f.args[x.c]);\n        self.out.push_fmt(\n            f\"), metal::uint2({nm(self.pool, tex)}.get_width({l}) - 1u, {nm(self.pool, tex)}.get_height({l}) - 1u))\");\n        if arrayed {\n            self.p(\", metal::min(uint(\");\n            self.val(m, f, f.args[x.c + 1]);\n            self.out.push_fmt(f\"), {nm(self.pool, tex)}.get_array_size() - 1u)\");\n        }\n        self.out.push_fmt(f\", {l})\");\n    }\n}\n\n// ---- Shader compiler implementation, msl: Statements (0.22) ----\n\nimpl W {\n    fn block(inout self, m: Module, f: Function, blk: i64) {\n        let b = f.blocks[blk];\n        for i in b.start..b.start + b.count {\n            self.stmt(m, f, f.items[i]);\n        }\n    }\n\n    fn braced(inout self, m: Module, f: Function, blk: i64) {\n        self.p(\"{\");\n        self.indent += 1;\n        self.block(m, f, blk);\n        self.indent -= 1;\n        self.line();\n        self.p(\"}\");\n    }\n\n    fn atomic_fn(fun: i64) -> [u8] {\n        if fun == AT_ADD {\n            \"metal::atomic_fetch_add_explicit\"\n        } else if fun == AT_SUB {\n            \"metal::atomic_fetch_sub_explicit\"\n        } else if fun == AT_AND {\n            \"metal::atomic_fetch_and_explicit\"\n        } else if fun == AT_OR {\n            \"metal::atomic_fetch_or_explicit\"\n        } else if fun == AT_XOR {\n            \"metal::atomic_fetch_xor_explicit\"\n        } else if fun == AT_MIN {\n            \"metal::atomic_fetch_min_explicit\"\n        } else if fun == AT_MAX {\n            \"metal::atomic_fetch_max_explicit\"\n        } else if fun == AT_EXCHANGE {\n            \"metal::atomic_exchange_explicit\"\n        } else if fun == AT_LOAD {\n");
        buf_str(out, c"            \"metal::atomic_load_explicit\"\n        } else {\n            \"metal::atomic_store_explicit\"\n        }\n    }\n\n    fn stmt(inout self, m: Module, f: Function, s: i64) {\n        let st = f.stmts[s];\n        let op = st.op;\n        if op == S_EMIT {\n            for e in st.a..st.b {\n                if self.baked[e] {\n                    self.line();\n                    self.pty(m, f.exprs[e].ty);\n                    self.p(\" \");\n                    self.pn(self.enames[e]);\n                    self.p(\" = \");\n                    self.render(m, f, e);\n                    self.p(\";\");\n                }\n            }\n            return;\n        }\n        self.line();\n        if op == S_STORE {\n            let g = self.has_guards(f, st.a);\n            if g {\n                self.p(\"if (\");\n                self.guards(m, f, st.a, false);\n                self.p(\") { \");\n            }\n            self.lval(m, f, st.a);\n            self.p(\" = \");\n            self.val(m, f, st.b);\n            self.p(\";\");\n            if g {\n                self.p(\" }\");\n            }\n        } else if op == S_BLOCK {\n            self.braced(m, f, st.a);\n        } else if op == S_IF {\n            self.p(\"if (\");\n            self.val(m, f, st.a);\n            self.p(\") \");\n            self.braced(m, f, st.b);\n            if f.blocks[st.c].count > 0 {\n                self.p(\" else \");\n                self.braced(m, f, st.c);\n            }\n        } else if op == S_SWITCH {\n            self.p(\"switch (\");\n            self.val(m, f, st.a);\n            self.p(\") {\");\n            for k in st.b..st.b + st.c {\n                let c = f.cases[k];\n                self.line();\n                for j in c.vstart..c.vstart + c.vcount {\n                    let sel_t = m.types[f.exprs[st.a].ty].scalar;\n                    if sel_t == SK_U32 {\n");
        buf_str(out, c"                        self.out.push_fmt(f\"case {f.vals[j] & 4294967295}u: \");\n                    } else {\n                        let v = f.vals[j] as u32 as i32 as i64;\n                        if v == -2147483648 {\n                            self.p(\"case (-2147483647 - 1): \");\n                        } else {\n                            self.out.push_fmt(f\"case {v}: \");\n                        }\n                    }\n                }\n                if c.is_default {\n                    self.p(\"default: \");\n                }\n                self.p(\"{\");\n                self.indent += 1;\n                self.block(m, f, c.body);\n                self.line();\n                self.p(\"break;\");\n                self.indent -= 1;\n                self.line();\n                self.p(\"}\");\n            }\n            self.line();\n            self.p(\"}\");\n        } else if op == S_LOOP {\n            let has_cont = f.blocks[st.b].count > 0 || st.c >= 0;\n            if !has_cont {\n                self.p(\"while (true) \");\n                self.braced(m, f, st.a);\n                return;\n            }\n            let li = self.loop_n;\n            self.loop_n += 1;\n            self.out.push_fmt(f\"bool _w_loop{li} = true;\");\n            self.line();\n            self.p(\"while (true) {\");\n            self.indent += 1;\n            self.line();\n            self.out.push_fmt(f\"if (!_w_loop{li}) {{\");\n            self.indent += 1;\n            self.block(m, f, st.b);\n            if st.c >= 0 {\n                self.line();\n                self.p(\"if (\");\n                self.val(m, f, st.c);\n                self.p(\") { break; }\");\n            }\n            self.indent -= 1;\n            self.line();\n            self.p(\"}\");\n            self.line();\n            self.out.push_fmt(f\"_w_loop{li} = false;\");\n            self.block(m, f, st.a);\n            self.indent -= 1;\n            self.line();\n");
        buf_str(out, c"            self.p(\"}\");\n        } else if op == S_BREAK {\n            self.p(\"break;\");\n        } else if op == S_CONTINUE {\n            self.p(\"continue;\");\n        } else if op == S_RETURN {\n            self.ret(m, f, st.a);\n        } else if op == S_KILL {\n            self.p(if self.stage == TEST_KERNEL { \"return;\" }\n                else { \"metal::discard_fragment();\" });\n        } else if op == S_BARRIER {\n            self.p(if st.a\n                == BARRIER_WORKGROUP {\n                \"metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);\"\n            } else { \"metal::threadgroup_barrier(metal::mem_flags::mem_device);\" });\n        } else if op == S_WG_UNIFORM_LOAD {\n            self.p(\"metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);\");\n            self.line();\n            self.pty(m, f.exprs[st.b].ty);\n            self.out.push_fmt(f\" {nm(self.pool, self.enames[st.b])} = \");\n            self.lval(m, f, st.a);\n            self.p(\";\");\n            self.line();\n            self.p(\"metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);\");\n        } else if op == S_CALL {\n            if st.d >= 0 {\n                self.pty(m, f.exprs[st.d].ty);\n                self.out.push_fmt(f\" {nm(self.pool, self.enames[st.d])} = \");\n            }\n            self.call(m, f, st.a, st.b, st.c);\n            self.p(\";\");\n        } else if op == S_ATOMIC {\n            self.atomic(m, f, s);\n        } else if op == S_IMAGE_STORE {\n            let tex = self.enames_or_global(m, f, st.a);\n            self.p(\"if (metal::all(metal::uint2(\");\n            self.val(m, f, st.b);\n            self.out.push_fmt(\n                f\") < metal::uint2({nm(self.pool, tex)}.get_width(), {nm(self.pool, tex)}.get_height()))) {{ {nm(self.pool, tex)}.write(\");\n            self.val(m, f, st.c);\n            self.p(\", metal::uint2(\");\n            self.val(m, f, st.b);\n            self.p(\")); }\");\n");
        buf_str(out, c"        }\n    }\n\n    fn atomic(inout self, m: Module, f: Function, s: i64) {\n        let st = f.stmts[s];\n        let g = self.has_guards(f, st.a);\n        let pt = m.types[f.exprs[st.a].ty];\n        let sk = m.types[pt.base].scalar;\n        let tn = W::scalar(sk);\n        let sp = W::space(pt.space, pt.access);\n        if st.b == AT_CMPXCHG {\n            let rty = self.ty(m, f.exprs[st.d].ty);\n            var rb = Buf::new_in(self.a);\n            rb.push_str(nm(self.pool, rty));\n            let rn = rb.as_slice();\n            let hst = self.pool.len();\n            var h = Buf::new_in(self.a);\n            h.push_fmt(f\"static inline {rn} _w_cmpxchg({sp} metal::atomic_{tn}* p, {tn} cmp, {tn} v) {{ {tn} old = cmp; bool ok = metal::atomic_compare_exchange_weak_explicit(p, &old, v, metal::memory_order_relaxed, metal::memory_order_relaxed); return {rn} {{old, ok}}; }}\\n\");\n            copy_into(&self.pool, h.as_slice());\n            let hs = self.since(hst);\n            var have = false;\n            for i in 0..self.need_cmpxchg.len() {\n                if nm(self.pool, self.need_cmpxchg[i]) == nm(self.pool, hs) {\n                    have = true;\n                }\n            }\n            if !have {\n                self.need_cmpxchg.push(hs);\n            }\n            self.out.push_fmt(f\"{nm(self.pool, rty)} {nm(self.pool, self.enames[st.d])} = \");\n            if g {\n                self.p(\"(\");\n                self.guards(m, f, st.a, false);\n                self.p(\") ? \");\n            }\n            self.p(\"_w_cmpxchg(&\");\n            self.lval(m, f, st.a);\n            self.p(\", \");\n            self.val(m, f, st.e);\n            self.p(\", \");\n            self.val(m, f, st.c);\n            self.p(\")\");\n            if g {\n                self.out.push_fmt(f\" : {nm(self.pool, rty)} {{}}\");\n            }\n            self.p(\";\");\n            return;\n        }\n        if st.d >= 0 {\n");
        buf_str(out, c"            self.out.push_fmt(f\"{tn} {nm(self.pool, self.enames[st.d])} = \");\n        }\n        if g {\n            if st.d >= 0 {\n                self.p(\"(\");\n                self.guards(m, f, st.a, false);\n                self.p(\") ? \");\n            } else {\n                self.p(\"if (\");\n                self.guards(m, f, st.a, false);\n                self.p(\") \");\n            }\n        }\n        self.p(W::atomic_fn(st.b));\n        self.p(\"(&\");\n        self.lval(m, f, st.a);\n        if st.c >= 0 {\n            self.p(\", \");\n            self.val(m, f, st.c);\n        }\n        self.p(\", metal::memory_order_relaxed)\");\n        if g && st.d >= 0 {\n            self.out.push_fmt(f\" : {tn}(0)\");\n        }\n        self.p(\";\");\n    }\n\n    fn call(inout self, m: Module, f: Function, callee: i64, start: i64, n: i64) {\n        self.pn(self.fnames[callee]);\n        self.p(\"(\");\n        var first = true;\n        for k in start..start + n {\n            if !first {\n                self.p(\", \");\n            }\n            first = false;\n            let a = f.args[k];\n            if m.types[f.exprs[a].ty].kind == TK_POINTER {\n                self.p(\"&\");\n                self.lval(m, f, a);\n            } else {\n                self.val(m, f, a);\n            }\n        }\n        for g in 0..m.globals.len() {\n            if self.uses[callee][g] {\n                if !first {\n                    self.p(\", \");\n                }\n                first = false;\n                self.pn(self.gnames[g]);\n            }\n        }\n        if needs_sizes(self, m, callee) {\n            if !first {\n                self.p(\", \");\n            }\n            self.p(\"_w_sizes\");\n        }\n        self.p(\")\");\n    }\n\n    fn ret(inout self, m: Module, f: Function, e: i64) {\n        if e < 0 {\n            self.p(\"return;\");\n            return;\n        }\n        if self.stage == TEST_KERNEL {\n");
        buf_str(out, c"            // a test kernel: the result into its output record\n            self.p(\"{ _w_out[_w_tid] = \");\n            self.val(m, f, e);\n            self.p(\"; return; }\");\n            return;\n        }\n        if self.stage == 255 || self.stage == STAGE_COMPUTE as i64 {\n            self.p(\"return \");\n            self.val(m, f, e);\n            self.p(\";\");\n            return;\n        }\n        // an entry point's result: into its output struct\n        let rt = m.types[self.ret_ty];\n        self.p(\"{ const auto _w_r = \");\n        self.val(m, f, e);\n        self.out.push_fmt(f\"; return {nm(self.pool, self.out_name)} {{ \");\n        if rt.kind == TK_STRUCT && f.result_binding.kind == ir::BIND_NONE {\n            for k in 0..rt.mcount {\n                if k > 0 {\n                    self.p(\", \");\n                }\n                let _n8 = self.escape(m.members[rt.mstart + k].name);\n                self.out.push_fmt(f\"_w_r.{nm(self.pool, _n8)}\");\n            }\n        } else {\n            self.p(\"_w_r\");\n        }\n        self.p(\" }; }\");\n    }\n}\n\n// ---- Shader compiler implementation, msl: Functions and entry points (0.22) ----\n\nfn start_fn(w: inout W, m: Module, h: i64) {\n    let f = m.functions[h];\n    w.fh = h;\n    w.used.clear();\n    w.loop_n = 0;\n    // the module-scope names stay reserved\n    for k in 0..w.fnames.len() {\n        let n = w.fnames[k];\n        w.used.push(n);\n    }\n    for k in 0..w.gnames.len() {\n        let n = w.gnames[k];\n        w.used.push(n);\n    }\n    count_refs(&w, f);\n    w.enames.clear();\n    for e in 0..f.exprs.len() {\n        let x = f.exprs[e];\n        if x.op == E_ARG {\n            let n = w.unique(f.params[x.a].name);\n            w.enames.push(n);\n        }\n        else if w.baked[e] || x.op == E_CALL_RESULT || x.op == E_ATOMIC_RESULT\n            || x.op == E_WG_UNIFORM_RESULT {\n            if f.names[e].len > 0 {\n");
        buf_str(out, c"                let n = w.unique(f.names[e]);\n                w.enames.push(n);\n            } else {\n                let st = w.pool.len();\n                w.pool.push_fmt(f\"_e{e}\");\n                let n = w.since(st);\n                w.enames.push(n);\n            }\n        } else {\n            w.enames.push(Nm { start: 0, len: 0 });\n        }\n    }\n    w.lnames.clear();\n    for l in 0..f.locals.len() {\n        let n = w.unique(f.locals[l].name);\n        w.lnames.push(n);\n    }\n}\n\n// The parameter list's global part: each global the function uses.\nfn global_params(w: inout W, m: Module, h: i64, first: bool) -> bool {\n    var fst = first;\n    for g in 0..m.globals.len() {\n        if !w.uses[h][g] {\n            continue;\n        }\n        if !fst {\n            w.p(\", \");\n        }\n        fst = false;\n        let gl = m.globals[g];\n        let tk = m.types[gl.ty].kind;\n        if gl.space == SP_HANDLE {\n            w.pty(m, gl.ty);\n            w.p(\" \");\n        } else if tk == TK_ARRAY && m.types[gl.ty].n == 0 {\n            let _n9 = w.ty(m, m.types[gl.ty].base);\n            w.out.push_fmt(f\"{W::space(gl.space, gl.access)} {nm(w.pool, _n9)}* \");\n        } else {\n            let _n10 = w.ty(m, gl.ty);\n            w.out.push_fmt(f\"{W::space(gl.space, gl.access)} {nm(w.pool, _n10)}& \");\n        }\n        w.pn(w.gnames[g]);\n    }\n    if needs_sizes(w, m, h) {\n        if !fst {\n            w.p(\", \");\n        }\n        fst = false;\n        w.p(\"constant uint* _w_sizes\");\n    }\n    fst\n}\n\nfn declare_locals(w: inout W, m: Module, f: Function) {\n    for l in 0..f.locals.len() {\n        w.line();\n        let _n11 = w.ty(m, f.locals[l].ty);\n        w.out.push_fmt(f\"{nm(w.pool, _n11)} {nm(w.pool, w.lnames[l])} = {{}};\");\n    }\n}\n\nfn write_fn(w: inout W, m: Module, h: i64) {\n    let f = m.functions[h];\n    start_fn(&w, m, h);\n    w.stage = 255;\n    w.p(\"\\n\");\n    if f.result >= 0 {\n");
        buf_str(out, c"        w.pty(m, f.result);\n    } else {\n        w.p(\"void\");\n    }\n    w.out.push_fmt(f\" {nm(w.pool, w.fnames[h])}(\");\n    var first = true;\n    for k in 0..f.params.len() {\n        if !first {\n            w.p(\", \");\n        }\n        first = false;\n        let pt = m.types[f.params[k].ty];\n        let ae = arg_expr(f, k);\n        let pname = if ae >= 0 { w.enames[ae] } else { w.unique(f.params[k].name) };\n        if pt.kind == TK_POINTER {\n            let _n12 = w.ty(m, pt.base);\n            w.out.push_fmt(f\"thread {nm(w.pool, _n12)}* {nm(w.pool, pname)}\");\n        } else {\n            let _n13 = w.ty(m, f.params[k].ty);\n            w.out.push_fmt(f\"{nm(w.pool, _n13)} {nm(w.pool, pname)}\");\n        }\n    }\n    global_params(&w, m, h, first);\n    w.p(\") {\");\n    w.indent = 1;\n    declare_locals(&w, m, f);\n    w.block(m, f, f.body);\n    w.indent = 0;\n    w.p(\"\\n}\\n\");\n}\n\nfn arg_expr(f: Function, k: i64) -> i64 {\n    for e in 0..f.exprs.len() {\n        if f.exprs[e].op == E_ARG && f.exprs[e].a == k {\n            return e;\n        }\n    }\n    -1\n}\n\nfn builtin_attr(b: i64) -> [u8] {\n    if b == BI_POSITION {\n        \"position\"\n    } else if b == BI_VERTEX_INDEX {\n        \"vertex_id\"\n    } else if b == BI_INSTANCE_INDEX {\n        \"instance_id\"\n    } else if b == BI_FRONT_FACING {\n        \"front_facing\"\n    } else if b == BI_FRAG_DEPTH {\n        \"depth(any)\"\n    } else if b == BI_SAMPLE_INDEX {\n        \"sample_id\"\n    } else if b == BI_SAMPLE_MASK {\n        \"sample_mask\"\n    } else if b == BI_LOCAL_INVOCATION_ID {\n        \"thread_position_in_threadgroup\"\n    } else if b == BI_LOCAL_INVOCATION_INDEX {\n        \"thread_index_in_threadgroup\"\n    } else if b == BI_GLOBAL_INVOCATION_ID {\n        \"thread_position_in_grid\"\n    } else if b == BI_WORKGROUP_ID {\n        \"threadgroup_position_in_grid\"\n    } else {\n        \"threadgroups_per_grid\"\n    }\n}\n\n");
        buf_str(out, c"fn interp_attr(b: Binding) -> [u8] {\n    if b.interp == INTERP_FLAT {\n        \", flat\"\n    } else if b.interp == INTERP_LINEAR {\n        \", center_no_perspective\"\n    } else {\n        \"\"\n    }\n}\n\n// One IO value of an entry point: as a stage_in member (`in_struct`) or a\n// parameter.\nfn io_decl(w: inout W, m: Module, stage: u8, ty: i64, b: Binding, name: [u8], output: bool) {\n    w.pty(m, ty);\n    w.out.push_fmt(f\" {name} [[\");\n    if b.kind == BIND_BUILTIN {\n        w.p(builtin_attr(b.value));\n    } else if stage == STAGE_VERTEX && !output {\n        w.out.push_fmt(f\"attribute({b.value})\");\n    } else if stage == STAGE_FRAGMENT && output {\n        w.out.push_fmt(f\"color({b.value})\");\n    } else {\n        w.out.push_fmt(f\"user(loc{b.value}){interp_attr(b)}\");\n    }\n    w.p(\"]]\");\n}\n\nfn uses_workgroup(w: W, m: Module, h: i64) -> bool {\n    for g in 0..m.globals.len() {\n        if w.uses[h][g] && m.globals[g].space == SP_WORKGROUP {\n            return true;\n        }\n    }\n    false\n}\n\n// Zeroes a workgroup variable (atomics by atomic stores).\nfn zero_workgroup(w: inout W, m: Module, lv: [u8], t: i64, depth: i64) {\n    if !m.has_atomic(t) {\n        w.line();\n        let _n14 = w.ty(m, t);\n        w.out.push_fmt(f\"{lv} = {nm(w.pool, _n14)} {{}};\");\n        return;\n    }\n    let ty = m.types[t];\n    if ty.kind == TK_ATOMIC {\n        w.line();\n        w.out.push_fmt(f\"metal::atomic_store_explicit(&{lv}, 0, metal::memory_order_relaxed);\");\n    } else if ty.kind == TK_ARRAY {\n        w.line();\n        w.out.push_fmt(f\"for (uint _w_i{depth} = 0u; _w_i{depth} < {ty.n}u; _w_i{depth}++) {{\");\n        w.indent += 1;\n        var b = Buf::new_in(w.a);\n        b.push_fmt(f\"{lv}.inner[_w_i{depth}]\");\n        zero_workgroup(&w, m, b.as_slice(), ty.base, depth + 1);\n        w.indent -= 1;\n        w.line();\n        w.p(\"}\");\n    } else if ty.kind == TK_STRUCT {\n");
        buf_str(out, c"        for k in ty.mstart..ty.mstart + ty.mcount {\n            var b = Buf::new_in(w.a);\n            let _n15 = w.escape(m.members[k].name);\n            b.push_fmt(f\"{lv}.{nm(w.pool, _n15)}\");\n            zero_workgroup(&w, m, b.as_slice(), m.members[k].ty, depth);\n        }\n    }\n}\n\nfn write_entry(w: inout W, m: Module, ei: i64) {\n    let en = m.entries[ei];\n    let h = en.func;\n    let f = m.functions[h];\n    start_fn(&w, m, h);\n    w.stage = en.stage as i64;\n    w.ret_ty = f.result;\n    let ename = w.fnames[h];\n    // the stage_in struct: location inputs of vertex and fragment shaders\n    var in_buf = Buf::new_in(w.a);\n    if en.stage != STAGE_COMPUTE {\n        var any = false;\n        let saved = std::replace(&w.out, Buf::new_in(w.a));\n        for k in 0..f.params.len() {\n            let pt = m.types[f.params[k].ty];\n            if pt.kind == TK_STRUCT && f.params[k].binding.kind == ir::BIND_NONE {\n                for j in pt.mstart..pt.mstart + pt.mcount {\n                    let mem = m.members[j];\n                    if mem.binding.kind == BIND_LOCATION\n                        || (mem.binding.kind == BIND_BUILTIN && mem.binding.value == BI_POSITION\n                            && en.stage == STAGE_FRAGMENT) {\n                        w.p(\"\\n    \");\n                        var nb = Buf::new_in(w.a);\n                        nb.push_fmt(f\"_w_p{k}_{j - pt.mstart}\");\n                        io_decl(&w, m, en.stage, mem.ty, mem.binding, nb.as_slice(), false);\n                        w.p(\";\");\n                        any = true;\n                    }\n                }\n            }\n            else if f.params[k].binding.kind == BIND_LOCATION\n                || (f.params[k].binding.kind == BIND_BUILTIN\n                    && f.params[k].binding.value == BI_POSITION && en.stage == STAGE_FRAGMENT) {\n                w.p(\"\\n    \");\n                var nb = Buf::new_in(w.a);\n                nb.push_fmt(f\"_w_p{k}\");\n");
        buf_str(out, c"                io_decl(&w, m, en.stage, f.params[k].ty, f.params[k].binding, nb.as_slice(), false);\n                w.p(\";\");\n                any = true;\n            }\n        }\n        let sb = std::replace(&w.out, saved);\n        if any {\n            in_buf.push_str(nm(w.pool, ename));\n            in_buf.push_str(\"_Input\");\n            w.out.push_str(\"\\nstruct \");\n            copy_into(&w.out, in_buf.as_slice());\n            w.out.push_str(\" {\");\n            copy_into(&w.out, sb.as_slice());\n            w.out.push_str(\"\\n};\\n\");\n        }\n        // the output struct\n        if f.result >= 0 {\n            var nb = Buf::new_in(w.a);\n            nb.push_str(nm(w.pool, ename));\n            nb.push_str(\"_Output\");\n            w.out_name = w.intern(nb.as_slice());\n            w.out.push_fmt(f\"\\nstruct {nm(w.pool, w.out_name)} {{\");\n            let rt = m.types[f.result];\n            if rt.kind == TK_STRUCT && f.result_binding.kind == ir::BIND_NONE {\n                for j in rt.mstart..rt.mstart + rt.mcount {\n                    let mem = m.members[j];\n                    w.p(\"\\n    \");\n                    var mb = Buf::new_in(w.a);\n                    mb.push_fmt(f\"m{j - rt.mstart}\");\n                    io_decl(&w, m, en.stage, mem.ty, mem.binding, mb.as_slice(), true);\n                    w.p(\";\");\n                }\n            } else {\n                w.p(\"\\n    \");\n                io_decl(&w, m, en.stage, f.result, f.result_binding, \"m0\", true);\n                w.p(\";\");\n            }\n            w.p(\"\\n};\\n\");\n        }\n    }\n    let kw = if en.stage == STAGE_COMPUTE { \"kernel void\" }\n        else if en.stage == STAGE_VERTEX { \"vertex\" } else { \"fragment\" };\n    w.out.push_fmt(f\"\\n{kw} \");\n    if en.stage != STAGE_COMPUTE {\n        if f.result >= 0 {\n            w.out.push_fmt(f\"{nm(w.pool, w.out_name)} \");\n        } else {\n            w.p(\"void \");\n        }\n    }\n");
        buf_str(out, c"    w.out.push_fmt(f\"{nm(w.pool, ename)}(\");\n    var first = true;\n    if in_buf.len() > 0 {\n        w.out.push_fmt(f\"{in_buf.as_slice()} _w_in [[stage_in]]\");\n        first = false;\n    }\n    // builtin inputs as parameters\n    var has_lid = false;\n    for k in 0..f.params.len() {\n        let pt = m.types[f.params[k].ty];\n        if pt.kind == TK_STRUCT && f.params[k].binding.kind == ir::BIND_NONE {\n            for j in pt.mstart..pt.mstart + pt.mcount {\n                let mem = m.members[j];\n                if mem.binding.kind == BIND_BUILTIN\n                    && !(mem.binding.value == BI_POSITION && en.stage == STAGE_FRAGMENT) {\n                    if !first {\n                        w.p(\", \");\n                    }\n                    first = false;\n                    var nb = Buf::new_in(w.a);\n                    nb.push_fmt(f\"_w_p{k}_{j - pt.mstart}\");\n                    io_decl(&w, m, en.stage, mem.ty, mem.binding, nb.as_slice(), false);\n                    if mem.binding.value == BI_LOCAL_INVOCATION_INDEX {\n                        has_lid = true;\n                    }\n                }\n            }\n        }\n        else if f.params[k].binding.kind == BIND_BUILTIN\n            && !(f.params[k].binding.value == BI_POSITION && en.stage == STAGE_FRAGMENT) {\n            if !first {\n                w.p(\", \");\n            }\n            first = false;\n            var nb = Buf::new_in(w.a);\n            nb.push_fmt(f\"_w_p{k}\");\n            io_decl(&w, m, en.stage, f.params[k].ty, f.params[k].binding, nb.as_slice(), false);\n            if f.params[k].binding.value == BI_LOCAL_INVOCATION_INDEX {\n                has_lid = true;\n            }\n        }\n    }\n    let wg = en.stage == STAGE_COMPUTE && uses_workgroup(w, m, h);\n    if wg && !has_lid {\n        if !first {\n            w.p(\", \");\n        }\n        first = false;\n        w.p(\"uint _w_lindex [[thread_index_in_threadgroup]]\");\n    }\n");
        buf_str(out, c"    // resources\n    for g in 0..m.globals.len() {\n        if !w.uses[h][g] {\n            continue;\n        }\n        let gl = m.globals[g];\n        if gl.space == SP_PRIVATE || gl.space == SP_WORKGROUP {\n            continue;\n        }\n        if !first {\n            w.p(\", \");\n        }\n        first = false;\n        let tk = m.types[gl.ty].kind;\n        let slot = w.sl.slot[en.stage as i64 * m.globals.len() + g];\n        if gl.space == SP_HANDLE {\n            let _n16 = w.ty(m, gl.ty);\n            w.out.push_fmt(\n                f\"{nm(w.pool, _n16)} {nm(w.pool, w.gnames[g])} [[{if tk == TK_TEXTURE { \"texture\" } else { \"sampler\" }}({slot})]]\");\n        } else if tk == TK_ARRAY && m.types[gl.ty].n == 0 {\n            let _n17 = w.ty(m, m.types[gl.ty].base);\n            w.out.push_fmt(\n                f\"{W::space(gl.space, gl.access)} {nm(w.pool, _n17)}* {nm(w.pool, w.gnames[g])} [[buffer({slot})]]\");\n        } else {\n            let _n18 = w.ty(m, gl.ty);\n            w.out.push_fmt(\n                f\"{W::space(gl.space, gl.access)} {nm(w.pool, _n18)}& {nm(w.pool, w.gnames[g])} [[buffer({slot})]]\");\n        }\n    }\n    if needs_sizes(w, m, h) {\n        if !first {\n            w.p(\", \");\n        }\n        w.out.push_fmt(f\"constant uint* _w_sizes [[buffer({w.sl.sizes_slot[en.stage as i64]})]]\");\n    }\n    w.p(\") {\");\n    w.indent = 1;\n    // private and workgroup variables\n    for g in 0..m.globals.len() {\n        if !w.uses[h][g] {\n            continue;\n        }\n        let gl = m.globals[g];\n        if gl.space == SP_PRIVATE {\n            w.line();\n            let _n19 = w.ty(m, gl.ty);\n            w.out.push_fmt(f\"{nm(w.pool, _n19)} {nm(w.pool, w.gnames[g])} = \");\n            if gl.init >= 0 {\n                write_const(&w, m, gl.init);\n            } else {\n                let _n20 = w.ty(m, gl.ty);\n                w.out.push_fmt(f\"{nm(w.pool, _n20)} {{}}\");\n            }\n");
        buf_str(out, c"            w.p(\";\");\n        } else if gl.space == SP_WORKGROUP {\n            w.line();\n            let _n21 = w.ty(m, gl.ty);\n            w.out.push_fmt(f\"threadgroup {nm(w.pool, _n21)} {nm(w.pool, w.gnames[g])};\");\n        }\n    }\n    if wg {\n        let lid = if has_lid { lid_name(&w, m, f) } else { w.intern(\"_w_lindex\") };\n        w.line();\n        w.out.push_fmt(f\"if ({nm(w.pool, lid)} == 0u) {{\");\n        w.indent += 1;\n        for g in 0..m.globals.len() {\n            if w.uses[h][g] && m.globals[g].space == SP_WORKGROUP {\n                var lb = Buf::new_in(w.a);\n                lb.push_str(nm(w.pool, w.gnames[g]));\n                zero_workgroup(&w, m, lb.as_slice(), m.globals[g].ty, 0);\n            }\n        }\n        w.indent -= 1;\n        w.line();\n        w.p(\"}\");\n        w.line();\n        w.p(\"metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);\");\n    }\n    // the parameters as WGSL sees them\n    for k in 0..f.params.len() {\n        let ae = arg_expr(f, k);\n        if ae < 0 {\n            continue;\n        }\n        let pt = m.types[f.params[k].ty];\n        w.line();\n        if pt.kind == TK_STRUCT && f.params[k].binding.kind == ir::BIND_NONE {\n            let _n22 = w.ty(m, f.params[k].ty);\n            w.out.push_fmt(f\"{nm(w.pool, _n22)} {nm(w.pool, w.enames[ae])} = {{}};\");\n            for j in pt.mstart..pt.mstart + pt.mcount {\n                let mem = m.members[j];\n                let from_in = mem.binding.kind == BIND_LOCATION\n                    || (mem.binding.kind == BIND_BUILTIN && mem.binding.value == BI_POSITION\n                        && en.stage == STAGE_FRAGMENT);\n                w.line();\n                let _n23 = w.escape(mem.name);\n                w.out.push_fmt(\n                    f\"{nm(w.pool, w.enames[ae])}.{nm(w.pool, _n23)} = {if from_in { \"_w_in.\" } else { \"\" }}_w_p{k}_{j - pt.mstart};\");\n            }\n        } else {\n");
        buf_str(out, c"            let from_in = f.params[k].binding.kind == BIND_LOCATION\n                || (f.params[k].binding.kind == BIND_BUILTIN\n                    && f.params[k].binding.value == BI_POSITION && en.stage == STAGE_FRAGMENT);\n            let _n24 = w.ty(m, f.params[k].ty);\n            w.out.push_fmt(\n                f\"{nm(w.pool, _n24)} {nm(w.pool, w.enames[ae])} = {if from_in { \"_w_in.\" } else { \"\" }}_w_p{k};\");\n        }\n    }\n    declare_locals(&w, m, f);\n    w.block(m, f, f.body);\n    w.indent = 0;\n    w.p(\"\\n}\\n\");\n    w.stage = 255;\n}\n\nfn lid_name(w: inout W, m: Module, f: Function) -> Nm {\n    for k in 0..f.params.len() {\n        let pt = m.types[f.params[k].ty];\n        if pt.kind == TK_STRUCT && f.params[k].binding.kind == ir::BIND_NONE {\n            for j in pt.mstart..pt.mstart + pt.mcount {\n                let mem = m.members[j];\n                if mem.binding.kind == BIND_BUILTIN\n                    && mem.binding.value == BI_LOCAL_INVOCATION_INDEX {\n                    let st = w.pool.len();\n                    w.pool.push_fmt(f\"_w_p{k}_{j - pt.mstart}\");\n                    return w.since(st);\n                }\n            }\n        }\n        else if f.params[k].binding.kind == BIND_BUILTIN\n            && f.params[k].binding.value == BI_LOCAL_INVOCATION_INDEX {\n            let st = w.pool.len();\n            w.pool.push_fmt(f\"_w_p{k}\");\n            return w.since(st);\n        }\n    }\n    w.intern(\"_w_lindex\")\n}\n\n// A private global's initializer: an expression of the module's constants.\nfn write_const(w: inout W, m: Module, e: i64) {\n    let nb: V<bool> = Vec::filled_in(m.consts.exprs.len(), false, w.a);\n    let nn: V<Nm> = Vec::filled_in(m.consts.exprs.len(), Nm { start: 0, len: 0 }, w.a);\n    let saved_baked = std::replace(&w.baked, nb);\n    let saved_names = std::replace(&w.enames, nn);\n    w.render(m, m.consts, e);\n    w.baked = saved_baked;\n    w.enames = saved_names;\n}\n\n");
        buf_str(out, c"// ---- Shader compiler implementation, msl: Test kernels (0.22) ----\n\n// The stage of a test kernel being written.\nconst TEST_KERNEL: i64 = 254;\n\n// Entry point ei (a vertex or fragment one) as a kernel, `NAME_w_test`:\n// invocation i reads its parameters from input record i (their record\n// offsets: ir::record_offsets) and writes its result into output record\n// i, so its body runs on Metal as the interpreter runs it alone. Its\n// slots: buffers from 0 in (group, binding) order, then the input, the\n// output and the sizes buffer; textures and samplers from 0.\nfn write_test_kernel(w: inout W, m: Module, ei: i64) -> [i64; 3] {\n    let en = m.entries[ei];\n    let h = en.func;\n    let f = m.functions[h];\n    start_fn(&w, m, h);\n    w.stage = TEST_KERNEL;\n    w.ret_ty = f.result;\n    let ename = w.fnames[h];\n    let offs = ir::record_offsets(m, h, w.a);\n    // the input record\n    var rec = Buf::new_in(w.a);\n    rec.push_str(nm(w.pool, ename));\n    rec.push_str(\"_w_In\");\n    let rn = w.intern(rec.as_slice());\n    var b = Buf::new_in(w.a);\n    b.push_str(\"struct \");\n    b.push_str(nm(w.pool, rn));\n    b.push_str(\" {\\n\");\n    var off = 0;\n    for k in 0..f.params.len() {\n        if offs[k] > off {\n            b.push_fmt(f\"    char _pad{k}[{offs[k] - off}];\\n\");\n        }\n        let mt = w.member_ty(m, f.params[k].ty);\n        b.push_fmt(f\"    {nm(w.pool, mt)} p{k};\\n\");\n        off = offs[k] + m.types[f.params[k].ty].size;\n    }\n    let stride = offs[f.params.len()];\n    if stride > off {\n        b.push_fmt(f\"    char _padend[{stride - off}];\\n\");\n    }\n    b.push_str(\"};\\n\");\n    copy_into(&w.types_out, b.as_slice());\n    let rt = if f.result >= 0 { w.ty(m, f.result) } else { w.intern(\"uint\") };\n    w.out.push_fmt(\n        f\"\\nkernel void {nm(w.pool, ename)}_w_test(uint _w_tid [[threadgroup_position_in_grid]]\");\n    let order = binding_order(m, w.a);\n    var nb = 0;\n    var nt = 0;\n");
        buf_str(out, c"    var ns = 0;\n    for k in 0..order.len() {\n        let g = order[k];\n        if !w.uses[h][g] {\n            continue;\n        }\n        let gl = m.globals[g];\n        if gl.space == SP_PRIVATE || gl.space == SP_WORKGROUP {\n            continue;\n        }\n        w.p(\", \");\n        let kind = m.types[gl.ty].kind;\n        if gl.space == SP_HANDLE {\n            let tn = w.ty(m, gl.ty);\n            let tex = kind == TK_TEXTURE;\n            let slot = if tex { nt } else { ns };\n            w.out.push_fmt(\n                f\"{nm(w.pool, tn)} {nm(w.pool, w.gnames[g])} [[{if tex { \"texture\" } else { \"sampler\" }}({slot})]]\");\n            if tex {\n                nt += 1;\n            } else {\n                ns += 1;\n            }\n        } else if kind == TK_ARRAY && m.types[gl.ty].n == 0 {\n            let tn = w.ty(m, m.types[gl.ty].base);\n            w.out.push_fmt(\n                f\"{W::space(gl.space, gl.access)} {nm(w.pool, tn)}* {nm(w.pool, w.gnames[g])} [[buffer({nb})]]\");\n            nb += 1;\n        } else {\n            let tn = w.ty(m, gl.ty);\n            w.out.push_fmt(\n                f\"{W::space(gl.space, gl.access)} {nm(w.pool, tn)}& {nm(w.pool, w.gnames[g])} [[buffer({nb})]]\");\n            nb += 1;\n        }\n    }\n    w.out.push_fmt(\n        f\", const device {nm(w.pool, rn)}* _w_in [[buffer({nb})]], device {nm(w.pool, rt)}* _w_out [[buffer({nb + 1})]]\");\n    var sizes = -1;\n    if needs_sizes(w, m, h) {\n        sizes = nb + 2;\n        w.out.push_fmt(f\", constant uint* _w_sizes [[buffer({sizes})]]\");\n    }\n    w.p(\") {\");\n    w.indent = 1;\n    for g in 0..m.globals.len() {\n        if w.uses[h][g] && m.globals[g].space == SP_PRIVATE {\n            let gl = m.globals[g];\n            w.line();\n            let tn = w.ty(m, gl.ty);\n            w.out.push_fmt(f\"{nm(w.pool, tn)} {nm(w.pool, w.gnames[g])} = \");\n            if gl.init >= 0 {\n                write_const(&w, m, gl.init);\n");
        buf_str(out, c"            } else {\n                w.out.push_fmt(f\"{nm(w.pool, tn)} {{}}\");\n            }\n            w.p(\";\");\n        }\n    }\n    for k in 0..f.params.len() {\n        let ae = arg_expr(f, k);\n        if ae < 0 {\n            continue;\n        }\n        w.line();\n        let tn = w.ty(m, f.params[k].ty);\n        w.out.push_fmt(f\"{nm(w.pool, tn)} {nm(w.pool, w.enames[ae])} = _w_in[_w_tid].p{k};\");\n    }\n    declare_locals(&w, m, f);\n    w.block(m, f, f.body);\n    w.indent = 0;\n    w.p(\"\\n}\\n\");\n    w.stage = 255;\n    [nb, nb + 1, sizes]\n}\n\n// ---- Shader compiler implementation, msl: Jobs for tests/wgsl/metalrun (0.22) ----\n\n// The MSL text of the module, for a job.\nfn module_text(m: Module, a: ScopedArena, w: inout W) -> Buf<ScopedArena> {\n    let order = call_order(m, a);\n    w.uses = global_uses(m, order, a);\n    w.sl = slots(m, w.uses, a);\n    for oi in 0..order.len() {\n        let h = order[oi];\n        var is_entry = false;\n        for e in 0..m.entries.len() {\n            if m.entries[e].func == h {\n                is_entry = true;\n            }\n        }\n        if !is_entry {\n            write_fn(&w, m, h);\n        }\n    }\n    for e in 0..m.entries.len() {\n        write_entry(&w, m, e);\n    }\n    var text = Buf::new_in(a);\n    finish_into(w, &text);\n    text\n}\n\n// A job that only compiles the MSL and finds each entry point.\npub fn metal_compile_job<A: Allocator>(m: Module, a: ScopedArena, out: inout Buf<A>) {\n    var w = new_writer(m, a);\n    let text = module_text(m, a, &w);\n    out.push_fmt(f\"msl {text.len()}\\n\");\n    out.push_str(text.as_slice());\n    out.push_str(\"\\nfunctions\");\n    for e in 0..m.entries.len() {\n        out.push_fmt(f\" {nm(w.pool, w.fnames[m.entries[e].func])}\");\n    }\n    out.push('\\n');\n}\n\n// The MSL of the module, then what metalrun needs: the entry point's\n// name, workgroup size, dispatch, and each buffer's slot and words.\n");
        buf_str(out, c"pub fn metal_job<A: Allocator>(m: Module, a: ScopedArena, ei: i64, job: job::Job,\n    out: inout Buf<A>) {\n    if job.call_n >= 0 {\n        metal_call_job(m, a, ei, job, &out);\n        return;\n    }\n    var w = new_writer(m, a);\n    let text = module_text(m, a, &w);\n    let en = m.entries[ei];\n    out.push_fmt(f\"msl {text.len()}\\n\");\n    out.push_str(text.as_slice());\n    out.push_fmt(f\"\\nentry {nm(w.pool, w.fnames[en.func])}\\n\");\n    out.push_fmt(f\"tg {en.wg[0]} {en.wg[1]} {en.wg[2]}\\n\");\n    out.push_fmt(f\"dispatch {job.groups[0]} {job.groups[1]} {job.groups[2]}\\n\");\n    var sizes: V<i64> = Vec::filled_in(w.sl.sizes_count, 0, a);\n    for i in 0..job.buffers.len() {\n        let b = job.buffers[i];\n        let g = job::find_global(m, b.group, b.binding);\n        if w.sl.size_index[g] >= 0 {\n            sizes[w.sl.size_index[g]] = b.bytes;\n        }\n        out.push_fmt(\n            f\"buffer {b.group} {b.binding} {w.sl.slot[2 * m.globals.len() + g]} {b.bytes}\");\n        for k in 0..b.words.len() {\n            out.push_fmt(f\" {b.words[k]}\");\n        }\n        out.push('\\n');\n    }\n    if w.sl.sizes_slot[2] >= 0 {\n        out.push_fmt(f\"sizes {w.sl.sizes_slot[2]} {sizes.len()}\");\n        for k in 0..sizes.len() {\n            out.push_fmt(f\" {sizes[k]}\");\n        }\n        out.push('\\n');\n    }\n}\n\nfn finish_into(w: W, out: inout Buf<ScopedArena>) {\n    var tmp = Buf::new_in(w.a);\n    let _ = tmp;\n    // finish writes to a gpa Buf in `write`; here the same text into an arena one\n    out.push_str(\n        \"// Generated by wgslc (MSL 3.0).\\n#include <metal_stdlib>\\n#include <simd/simd.h>\\n\\n\");\n    var h = Buf::new_in(w.a);\n    helpers(w, &h);\n    copy_into(&out, h.as_slice());\n    out.push('\\n');\n    copy_into(&out, w.types_out.as_slice());\n    copy_into(&out, w.out.as_slice());\n    tmp = h;\n}\n\n// A call job: the module's MSL plus entry ei's test kernel, run once per\n");
        buf_str(out, c"// input record (one thread per threadgroup), its resources at the\n// kernel's slots.\nfn metal_call_job<A: Allocator>(m: Module, a: ScopedArena, ei: i64, job: job::Job,\n    out: inout Buf<A>) {\n    var w = new_writer(m, a);\n    let order = call_order(m, a);\n    w.uses = global_uses(m, order, a);\n    w.sl = slots(m, w.uses, a);\n    for oi in 0..order.len() {\n        let h = order[oi];\n        var is_entry = false;\n        for e in 0..m.entries.len() {\n            if m.entries[e].func == h {\n                is_entry = true;\n            }\n        }\n        if !is_entry {\n            write_fn(&w, m, h);\n        }\n    }\n    for e in 0..m.entries.len() {\n        write_entry(&w, m, e);\n    }\n    let io = write_test_kernel(&w, m, ei);\n    var text = Buf::new_in(a);\n    finish_into(w, &text);\n    let h = m.entries[ei].func;\n    out.push_fmt(f\"msl {text.len()}\\n\");\n    out.push_str(text.as_slice());\n    out.push_fmt(\n        f\"\\nentry {nm(w.pool, w.fnames[h])}_w_test\\ntg 1 1 1\\ndispatch {job.call_n} 1 1\\n\");\n    // the kernel's slots: (group, binding) order over what it uses\n    let border = binding_order(m, a);\n    let ng = m.globals.len();\n    var kslot: V<i64> = Vec::filled_in(ng, -1, a);\n    var nb = 0;\n    var nt = 0;\n    for k in 0..border.len() {\n        let g = border[k];\n        if !w.uses[h][g] {\n            continue;\n        }\n        let gl = m.globals[g];\n        if gl.space == ir::SP_UNIFORM || gl.space == SP_STORAGE {\n            kslot[g] = nb;\n            nb += 1;\n        } else if m.types[gl.ty].kind == TK_TEXTURE {\n            kslot[g] = nt;\n            nt += 1;\n        }\n    }\n    var sizes: V<i64> = Vec::filled_in(w.sl.sizes_count, 0, a);\n    for i in 0..job.buffers.len() {\n        let b = job.buffers[i];\n        let g = job::find_global(m, b.group, b.binding);\n        if w.sl.size_index[g] >= 0 {\n            sizes[w.sl.size_index[g]] = b.bytes;\n        }\n");
        buf_str(out, c"        out.push_fmt(f\"buffer {b.group} {b.binding} {kslot[g]} {b.bytes}\");\n        for j in 0..b.words.len() {\n            out.push_fmt(f\" {b.words[j]}\");\n        }\n        out.push('\\n');\n    }\n    for i in 0..job.textures.len() {\n        let t = job.textures[i];\n        let g = job::find_global(m, t.group, t.binding);\n        out.push_fmt(f\"texture {kslot[g]} {t.format} {t.w} {t.h}\");\n        for j in 0..t.words.len() {\n            out.push_fmt(f\" {t.words[j]}\");\n        }\n        out.push('\\n');\n    }\n    let f = m.functions[h];\n    let in_stride = ir::record_offsets(m, h, a)[f.params.len()];\n    let out_stride = if f.result >= 0 { ir::stride_of(m, f.result) } else { 4 };\n    out.push_fmt(f\"buffer -1 0 {io[0]} {job.call_n * in_stride}\");\n    for j in 0..job.input.len() {\n        out.push_fmt(f\" {job.input[j]}\");\n    }\n    out.push_fmt(f\"\\nbuffer -2 0 {io[1]} {job.call_n * out_stride}\\n\");\n    if io[2] >= 0 {\n        out.push_fmt(f\"sizes {io[2]} {sizes.len()}\");\n        for k in 0..sizes.len() {\n            out.push_fmt(f\" {sizes[k]}\");\n        }\n        out.push('\\n');\n    }\n}\n// ---- end mod std::gpu::wgsl::msl ----\n}\n// ---- mod std::gpu::wgsl::spirv ----\npub mod spirv {\n// ---- Shader compiler implementation, spirv (0.22) ----\n// The SPIR-V writer (G6).\n\nuse ir::Module;\nuse std::{Buf, ScopedArena};\n\npub fn write(m: Module, a: ScopedArena, out: inout Buf) {\n    let _ = a;\n}\n// ---- end mod std::gpu::wgsl::spirv ----\n}\n// ---- mod std::gpu::wgsl::interp ----\npub mod interp {\n// ---- Shader compiler implementation, interp (0.22) ----\n// The CPU interpreter (docs/design/gpu.md §2.10, §4): the third back end\n// over the IR and the oracle of the tests and the shader fuzzer. It runs\n// compute entry points with WGSL's semantics, the checked ones included:\n// wrapping integers, division by zero, shifts modulo 32, clamped indices,\n");
        buf_str(out, c"// runtime-sized arrays that read zero and skip writes out of range.\n//\n// Values are 32-bit words in WGSL's memory layout, everywhere: an\n// expression's value lives in its register (words of the frame), so a\n// load or store is a copy. Each invocation keeps its own call and control\n// stacks, so a workgroup barrier suspends it: the invocations of a\n// workgroup run in turn until each reaches the barrier, then all resume.\n\nuse ir::{\n    AT_ADD, AT_AND, AT_CMPXCHG, AT_EXCHANGE, AT_LOAD, AT_MAX, AT_MIN, AT_OR, AT_STORE, AT_SUB,\n    AT_XOR, BIND_BUILTIN, BI_GLOBAL_INVOCATION_ID, BI_LOCAL_INVOCATION_ID,\n    BI_LOCAL_INVOCATION_INDEX, BI_NUM_WORKGROUPS, BI_WORKGROUP_ID, CK_CLAMP, CK_RZSW, E_ACCESS,\n    E_ACCESS_INDEX, E_ARG, E_ARRAY_LENGTH, E_ATOMIC_RESULT, E_BINARY, E_BITCAST, E_CALL_RESULT,\n    E_COMPOSE, E_CONVERT, E_DERIVATIVE, E_GLOBAL, E_IMAGE_LOAD, E_IMAGE_QUERY, E_IMAGE_SAMPLE,\n    E_LITERAL, E_LOAD, E_LOCAL, E_MATH, E_SELECT, E_SPLAT, E_SWIZZLE, E_UNARY, E_WG_UNIFORM_RESULT,\n    E_ZERO, Function, Module, OP_ADD, OP_AND, OP_DIV, OP_EQ, OP_GE, OP_GT, OP_LAND, OP_LE, OP_LOR,\n    OP_LT, OP_MOD, OP_MUL, OP_NE, OP_OR, OP_SHL, OP_SHR, OP_SUB, OP_XOR, SK_BOOL, SK_F32, SK_I32,\n    SK_U32, SP_HANDLE, SP_PRIVATE, SP_STORAGE, SP_UNIFORM, SP_WORKGROUP, S_ATOMIC, S_BARRIER,\n    S_BLOCK, S_BREAK, S_CALL, S_CONTINUE, S_EMIT, S_IF, S_IMAGE_STORE, S_KILL, S_LOOP, S_RETURN,\n    S_STORE, S_SWITCH, S_WG_UNIFORM_LOAD, TK_ARRAY, TK_MATRIX, TK_POINTER, TK_SAMPLER, TK_SCALAR,\n    TK_STRUCT, TK_TEXTURE, TK_VECTOR, UN_BITNOT, UN_NEG, UN_NOT, V, bits_f32, f32_bits,\n};\nuse std::{Buf, ScopedArena, Vec};\n\n// The C library's f32 math (libm): a C boundary, so each call is in\n// `unsafe`; none has effects (no errno is read).\nextern \"C\" {\n    #[effects()]\n    fn acosf(x: f32) -> f32;\n    #[effects()]\n    fn acoshf(x: f32) -> f32;\n    #[effects()]\n    fn asinf(x: f32) -> f32;\n    #[effects()]\n    fn asinhf(x: f32) -> f32;\n    #[effects()]\n");
        buf_str(out, c"    fn atan2f(x: f32, y: f32) -> f32;\n    #[effects()]\n    fn atanf(x: f32) -> f32;\n    #[effects()]\n    fn atanhf(x: f32) -> f32;\n    #[effects()]\n    fn ceilf(x: f32) -> f32;\n    #[effects()]\n    fn cosf(x: f32) -> f32;\n    #[effects()]\n    fn coshf(x: f32) -> f32;\n    #[effects()]\n    fn exp2f(x: f32) -> f32;\n    #[effects()]\n    fn expf(x: f32) -> f32;\n    #[effects()]\n    fn floorf(x: f32) -> f32;\n    #[effects()]\n    fn fmaf(x: f32, y: f32, z: f32) -> f32;\n    #[effects()]\n    fn fmaxf(x: f32, y: f32) -> f32;\n    #[effects()]\n    fn fminf(x: f32, y: f32) -> f32;\n    #[effects()]\n    fn fmodf(x: f32, y: f32) -> f32;\n    #[effects()]\n    fn ldexpf(x: f32, e: i32) -> f32;\n    #[effects()]\n    fn log2f(x: f32) -> f32;\n    #[effects()]\n    fn logf(x: f32) -> f32;\n    #[effects()]\n    fn powf(x: f32, y: f32) -> f32;\n    #[effects()]\n    fn rintf(x: f32) -> f32;\n    #[effects()]\n    fn sinf(x: f32) -> f32;\n    #[effects()]\n    fn sinhf(x: f32) -> f32;\n    #[effects()]\n    fn sqrtf(x: f32) -> f32;\n    #[effects()]\n    fn tanf(x: f32) -> f32;\n    #[effects()]\n    fn tanhf(x: f32) -> f32;\n    #[effects()]\n    fn truncf(x: f32) -> f32;\n}\n\n// Pointer spaces (bits 48..55 of a pointer); bit 56: out of range (RZSW).\nconst PS_FUNC: i64 = 1;\nconst PS_PRIVATE: i64 = 2;\nconst PS_WORKGROUP: i64 = 3;\nconst PS_BUFFER: i64 = 4;\nconst PTR_INVALID: i64 = 72057594037927936;\nconst OFF_MASK: i64 = 4294967295;\n\nconst CT_BLOCK: u8 = 0;\nconst CT_BODY: u8 = 1;\nconst CT_CONT: u8 = 2;\nconst CT_SWITCH: u8 = 3;\n\nconst ST_RUN: u8 = 0;\nconst ST_BARRIER: u8 = 1;\nconst ST_DONE: u8 = 2;\n\npub struct FnInfo {\n    // each expression's register: a word offset in the frame\n    regs: V<i64>,\n    // each local's offset in the frame\n    locals: V<i64>,\n    size: i64,\n    // the E_ARG expression of each parameter, or -1\n    arg_exprs: V<i64>,\n}\n\nstruct Frame { func: i64, base: i64, ctl_base: i64, ret: i64 }\n\n");
        buf_str(out, c"// A position in a block; for loops `s` is the S_LOOP statement.\nstruct Ctl { kind: u8, blk: i64, pos: i64, s: i64 }\n\npub struct Inv {\n    mem: V<u32>,\n    privm: V<u32>,\n    frames: V<Frame>,\n    ctl: V<Ctl>,\n    state: u8,\n    // workgroupUniformLoad's two barriers\n    phase: i64,\n}\n\npub struct Interp {\n    a: ScopedArena,\n    fns: V<FnInfo>,\n    // per global: its words (buffers), and offsets in private or workgroup memory\n    bufs: V<V<u32>>,\n    goff: V<i64>,\n    priv_words: i64,\n    wg_words: i64,\n    priv_init: V<u32>,\n    wg: V<u32>,\n    failed: bool,\n    err: Buf<ScopedArena>,\n    steps: i64,\n    max_steps: i64,\n    // builtins of the invocation being started\n    wg_size: [i64; 3],\n    groups: [i64; 3],\n    // per global: a texture's size and texels (4 words each: f32 bits for\n    // float textures, the integers for i32 and u32 ones), once set\n    tex_w: V<i64>,\n    tex_h: V<i64>,\n    texels: V<V<u32>>,\n}\n\nfn words_of(m: Module, t: i64) -> i64 {\n    let ty = m.types[t];\n    if ty.kind == TK_POINTER {\n        return 2;\n    }\n    if ty.kind == TK_TEXTURE || ty.kind == TK_SAMPLER {\n        return 1;\n    }\n    ty.size / 4\n}\n\npub fn new_interp(m: Module, a: ScopedArena) -> Interp {\n    var it = Interp {\n        a: a,\n        fns: Vec::new_in(a),\n        bufs: Vec::new_in(a),\n        goff: Vec::new_in(a),\n        priv_words: 0,\n        wg_words: 0,\n        priv_init: Vec::new_in(a),\n        wg: Vec::new_in(a),\n        failed: false,\n        err: Buf::new_in(a),\n        steps: 0,\n        max_steps: 2000000000,\n        wg_size: [1, 1, 1],\n        groups: [1, 1, 1],\n        tex_w: Vec::new_in(a),\n        tex_h: Vec::new_in(a),\n        texels: Vec::new_in(a),\n    };\n    for h in 0..m.functions.len() {\n        let f = m.functions[h];\n        var fi = FnInfo {\n            regs: Vec::with_capacity_in(f.exprs.len(), a), locals: Vec::new_in(a), size: 0,\n");
        buf_str(out, c"            arg_exprs: Vec::filled_in(f.params.len(), -1, a)\n        };\n        var off = 0;\n        for l in 0..f.locals.len() {\n            fi.locals.push(off);\n            off += words_of(m, f.locals[l].ty);\n        }\n        for e in 0..f.exprs.len() {\n            fi.regs.push(off);\n            off += words_of(m, f.exprs[e].ty);\n            if f.exprs[e].op == E_ARG {\n                fi.arg_exprs[f.exprs[e].a] = e;\n            }\n        }\n        fi.size = off;\n        it.fns.push(fi);\n    }\n    for g in 0..m.globals.len() {\n        let gl = m.globals[g];\n        it.bufs.push(Vec::new_in(a));\n        it.tex_w.push(0);\n        it.tex_h.push(0);\n        it.texels.push(Vec::new_in(a));\n        if gl.space == SP_PRIVATE {\n            it.goff.push(it.priv_words);\n            it.priv_words += words_of(m, gl.ty);\n        } else if gl.space == SP_WORKGROUP {\n            it.goff.push(it.wg_words);\n            it.wg_words += words_of(m, gl.ty);\n        } else {\n            it.goff.push(0);\n        }\n    }\n    // private globals' initial values, from the module's constant expressions\n    for _ in 0..it.priv_words {\n        it.priv_init.push(0);\n    }\n    var cf = FnInfo {\n        regs: Vec::new_in(a), locals: Vec::new_in(a), size: 0, arg_exprs: Vec::new_in(a)\n    };\n    var off = 0;\n    for e in 0..m.consts.exprs.len() {\n        cf.regs.push(off);\n        off += words_of(m, m.consts.exprs[e].ty);\n    }\n    cf.size = off;\n    if off > 0 {\n        var tmp = Inv {\n            mem: Vec::filled_in(off, 0u32, a), privm: Vec::new_in(a), frames: Vec::new_in(a),\n            ctl: Vec::new_in(a), state: ST_RUN, phase: 0\n        };\n        for g in 0..m.globals.len() {\n            let gl = m.globals[g];\n            if gl.space == SP_PRIVATE && gl.init >= 0 {\n                const_eval(m, cf, &tmp, gl.init);\n                let w = words_of(m, gl.ty);\n                for k in 0..w {\n");
        buf_str(out, c"                    it.priv_init[it.goff[g] + k] = tmp.mem[cf.regs[gl.init] + k];\n                }\n            }\n        }\n    }\n    it\n}\n\n// Evaluates a constant expression of the module's init function (and its\n// operands) into tmp's registers.\nfn const_eval(m: Module, cf: FnInfo, tmp: inout Inv, e: i64) {\n    let x = m.consts.exprs[e];\n    let dst = cf.regs[e];\n    let w = words_of(m, x.ty);\n    if x.op == E_LITERAL {\n        tmp.mem[dst] = x.a as u32;\n    } else if x.op == E_ZERO {\n        for k in 0..w {\n            tmp.mem[dst + k] = 0;\n        }\n    } else if x.op == E_SPLAT {\n        const_eval(m, cf, &tmp, x.a);\n        for k in 0..w {\n            tmp.mem[dst + k] = tmp.mem[cf.regs[x.a]];\n        }\n    } else if x.op == E_COMPOSE {\n        let t = m.types[x.ty];\n        var at = 0;\n        for i in 0..x.b {\n            let a = m.consts.args[x.a + i];\n            const_eval(m, cf, &tmp, a);\n            let aw = words_of(m, m.consts.exprs[a].ty);\n            let o = compose_offset(m, t, i, at);\n            for k in 0..aw {\n                tmp.mem[dst + o + k] = tmp.mem[cf.regs[a] + k];\n            }\n            at += aw;\n        }\n    }\n}\n\n// Where the i-th argument of a composition of type t goes (`at`: the\n// words the earlier arguments filled, for vectors).\nfn compose_offset(m: Module, t: ir::Type, i: i64, at: i64) -> i64 {\n    if t.kind == TK_VECTOR {\n        at\n    } else if t.kind == TK_MATRIX {\n        i * t.stride / 4\n    } else if t.kind == TK_ARRAY {\n        i * t.stride / 4\n    } else {\n        m.members[t.mstart + i].offset / 4\n    }\n}\n\nfn fl(x: u32) -> f32 { bits_f32(x) }\n\nfn ub(x: f32) -> u32 { f32_bits(x) }\n\nfn si(x: u32) -> i64 { x as i32 as i64 }\n\nimpl Interp {\n    pub fn fail(inout self, msg: [u8]) {\n        if !self.failed {\n            self.failed = true;\n            self.err.push_str(msg);\n        }\n    }\n\n    // A buffer's binding: its words (sized to the binding).\n");
        buf_str(out, c"    pub fn set_buffer(inout self, g: i64, words: [u32]) {\n        var v: V<u32> = Vec::with_capacity_in(words.len, self.a);\n        v.extend_from_slice(words);\n        self.bufs[g] = v;\n    }\n\n    // A texture's texels: w x h, 4 words each (see `texels`).\n    pub fn set_texture(inout self, g: i64, w: i64, h: i64, texels: [u32]) {\n        self.tex_w[g] = w;\n        self.tex_h[g] = h;\n        var v: V<u32> = Vec::with_capacity_in(texels.len, self.a);\n        v.extend_from_slice(texels);\n        self.texels[g] = v;\n    }\n\n    // Runs entry point ei once per input record (stride_in bytes each,\n    // its parameters at their record offsets, ir::record_offsets), the\n    // results in `out`, stride_out bytes each. Vertex and fragment entry\n    // points so run alone: their builtins come from the records too.\n    pub fn call(inout self, m: Module, ei: i64, input: [u32], stride_in: i64, n: i64,\n        out: inout V<u32>, stride_out: i64) -> bool {\n        let fi = m.entries[ei].func;\n        let size = self.fns[fi].size;\n        let rw = if m.functions[fi].result >= 0 { words_of(m, m.functions[fi].result) } else { 0 };\n        let offs = ir::record_offsets(m, fi, self.a);\n        self.wg = Vec::filled_in(self.wg_words, 0u32, self.a);\n        for _ in 0..n * stride_out / 4 {\n            out.push(0);\n        }\n        for i in 0..n {\n            var inv = Inv {\n                mem: Vec::filled_in(size + rw, 0u32, self.a),\n                privm: Vec::filled_in(self.priv_words, 0u32, self.a),\n                frames: Vec::new_in(self.a),\n                ctl: Vec::new_in(self.a),\n                state: ST_RUN,\n                phase: 0,\n            };\n            for k in 0..self.priv_words {\n                inv.privm[k] = self.priv_init[k];\n            }\n            let fr = Frame { func: fi, base: 0, ctl_base: 0, ret: size };\n            inv.frames.push(fr);\n            self.enter(m, &inv, fr);\n");
        buf_str(out, c"            inv.ctl.push(Ctl { kind: CT_BLOCK, blk: m.functions[fi].body, pos: 0, s: -1 });\n            for k in 0..m.functions[fi].params.len() {\n                let e = self.fns[fi].arg_exprs[k];\n                if e < 0 {\n                    continue;\n                }\n                let w = words_of(m, m.functions[fi].params[k].ty);\n                let src = i * stride_in / 4 + offs[k] / 4;\n                for j in 0..w {\n                    if src + j < input.len {\n                        inv.mem[self.fns[fi].regs[e] + j] = input[src + j];\n                    }\n                }\n            }\n            self.run(m, &inv);\n            if self.failed {\n                return false;\n            }\n            if inv.state != ST_DONE {\n                self.fail(\"a barrier in an entry point run alone\");\n                return false;\n            }\n            for j in 0..rw {\n                out[i * stride_out / 4 + j] = inv.mem[size + j];\n            }\n        }\n        true\n    }\n\n    // ---- Memory ----\n\n    fn read(self, inv: Inv, ptr: i64, k: i64) -> u32 {\n        let sp = (ptr >> 48) & 255;\n        let off = (ptr & OFF_MASK) + k;\n        if ptr & PTR_INVALID != 0 {\n            return 0;\n        }\n        if sp == PS_FUNC {\n            inv.mem[off]\n        } else if sp == PS_PRIVATE {\n            inv.privm[off]\n        } else if sp == PS_WORKGROUP {\n            self.wg[off]\n        } else {\n            let b = (ptr >> 32) & 65535;\n            if off >= self.bufs[b].len() {\n                // a fixed-size part beyond a too-small binding reads zero\n                return 0;\n            }\n            self.bufs[b][off]\n        }\n    }\n\n    fn write(inout self, inv: inout Inv, ptr: i64, k: i64, v: u32) {\n        let sp = (ptr >> 48) & 255;\n        let off = (ptr & OFF_MASK) + k;\n        if ptr & PTR_INVALID != 0 {\n            return;\n        }\n        if sp == PS_FUNC {\n            inv.mem[off] = v;\n");
        buf_str(out, c"        } else if sp == PS_PRIVATE {\n            inv.privm[off] = v;\n        } else if sp == PS_WORKGROUP {\n            self.wg[off] = v;\n        } else {\n            let b = (ptr >> 32) & 65535;\n            if off < self.bufs[b].len() {\n                self.bufs[b][off] = v;\n            }\n        }\n    }\n\n    fn get_ptr(self, inv: Inv, addr: i64) -> i64 {\n        (inv.mem[addr] as i64) | ((inv.mem[addr + 1] as i64) << 32)\n    }\n\n    fn put_ptr(self, inv: inout Inv, addr: i64, p: i64) {\n        inv.mem[addr] = (p & OFF_MASK) as u32;\n        inv.mem[addr + 1] = ((p >> 32) & OFF_MASK) as u32;\n    }\n\n    // The length of the runtime-sized array at byte `offset` of global g.\n    fn runtime_len(self, g: i64, offset: i64, stride: i64) -> i64 {\n        let bytes = self.bufs[g].len() * 4 - offset;\n        if bytes <= 0 || stride <= 0 {\n            return 0;\n        }\n        bytes / stride\n    }\n\n    // The global a pointer expression starts from, or -1.\n    fn root_global(self, f: Function, e: i64) -> i64 {\n        let x = f.exprs[e];\n        if x.op == E_GLOBAL {\n            return x.a;\n        }\n        if x.op == E_ACCESS || x.op == E_ACCESS_INDEX {\n            return self.root_global(f, x.a);\n        }\n        -1\n    }\n\n    // ---- Running a dispatch ----\n\n    // Runs entry point `ei` over groups[0] x groups[1] x groups[2] workgroups.\n    pub fn dispatch(inout self, m: Module, ei: i64, groups: [i64; 3]) -> bool {\n        let en = m.entries[ei];\n        let n = en.wg[0] * en.wg[1] * en.wg[2];\n        self.wg_size = en.wg;\n        self.groups = groups;\n        let fi = en.func;\n        let size = self.fns[fi].size;\n        var invs: V<Inv> = Vec::with_capacity_in(n, self.a);\n        for _ in 0..n {\n            invs.push(Inv {\n                mem: Vec::filled_in(size + 64, 0u32, self.a),\n                privm: Vec::filled_in(self.priv_words, 0u32, self.a),\n                frames: Vec::new_in(self.a),\n");
        buf_str(out, c"                ctl: Vec::new_in(self.a),\n                state: ST_RUN,\n                phase: 0,\n            });\n        }\n        self.wg = Vec::filled_in(self.wg_words, 0u32, self.a);\n        for gz in 0..groups[2] {\n            for gy in 0..groups[1] {\n                for gx in 0..groups[0] {\n                    for k in 0..self.wg_words {\n                        self.wg[k] = 0;\n                    }\n                    for li in 0..n {\n                        let lx = li % en.wg[0];\n                        let ly = (li / en.wg[0]) % en.wg[1];\n                        let lz = li / (en.wg[0] * en.wg[1]);\n                        inout inv = &invs[li];\n                        inv.mem.truncate(0);\n                        for _ in 0..size {\n                            inv.mem.push(0);\n                        }\n                        for k in 0..self.priv_words {\n                            inv.privm[k] = self.priv_init[k];\n                        }\n                        inv.frames.clear();\n                        inv.ctl.clear();\n                        inv.state = ST_RUN;\n                        inv.phase = 0;\n                        inv.frames.push(Frame { func: fi, base: 0, ctl_base: 0, ret: -1 });\n                        let fr0 = inv.frames[0];\n                        self.enter(m, &inv, fr0);\n                        let body = m.functions[fi].body;\n                        inv.ctl.push(Ctl { kind: CT_BLOCK, blk: body, pos: 0, s: -1 });\n                        self.set_builtins(m, &inv, fi, [lx, ly, lz], [gx, gy, gz], li);\n                    }\n                    // run the workgroup's invocations, barrier to barrier\n                    loop {\n                        var running = 0;\n                        var at_barrier = 0;\n                        for li in 0..n {\n                            if invs[li].state == ST_DONE {\n                                continue;\n                            }\n");
        buf_str(out, c"                            invs[li].state = ST_RUN;\n                            self.run(m, &invs[li]);\n                            if self.failed {\n                                return false;\n                            }\n                            if invs[li].state == ST_BARRIER {\n                                at_barrier += 1;\n                            }\n                            running += 1;\n                        }\n                        if running == 0 {\n                            break;\n                        }\n                        if at_barrier != 0 && at_barrier != running {\n                            self.fail(\"a barrier was reached by some invocations of a workgroup and not others (non-uniform control flow)\");\n                            return false;\n                        }\n                        if at_barrier == 0 {\n                            break;\n                        }\n                    }\n                }\n            }\n        }\n        true\n    }\n\n    fn set_builtins(self, m: Module, inv: inout Inv, fi: i64, l: [i64; 3], g: [i64; 3],\n        li: i64) {\n        let f = m.functions[fi];\n        for p in 0..f.params.len() {\n            let e = self.fns[fi].arg_exprs[p];\n            if e < 0 {\n                continue;\n            }\n            let dst = self.fns[fi].regs[e];\n            let pt = m.types[f.params[p].ty];\n            if pt.kind == TK_STRUCT {\n                for k in 0..pt.mcount {\n                    let mem = m.members[pt.mstart + k];\n                    self.put_builtin(&inv, mem.binding.value, dst + mem.offset / 4, l, g, li);\n                }\n            } else if f.params[p].binding.kind == BIND_BUILTIN {\n                self.put_builtin(&inv, f.params[p].binding.value, dst, l, g, li);\n            }\n        }\n    }\n\n    fn put_builtin(self, inv: inout Inv, b: i64, dst: i64, l: [i64; 3], g: [i64; 3],\n        li: i64) {\n        for k in 0..3 {\n");
        buf_str(out, c"            let v = if b == BI_LOCAL_INVOCATION_ID {\n                l[k]\n            } else if b == BI_GLOBAL_INVOCATION_ID {\n                g[k] * self.wg_size[k] + l[k]\n            } else if b == BI_WORKGROUP_ID {\n                g[k]\n            } else if b == BI_NUM_WORKGROUPS {\n                self.groups[k]\n            } else {\n                li\n            };\n            inv.mem[dst + k] = v as u32;\n            if b == BI_LOCAL_INVOCATION_INDEX {\n                return;\n            }\n        }\n    }\n\n    // ---- Statements ----\n\n    // Runs an invocation until it ends, reaches a barrier or fails.\n    fn run(inout self, m: Module, inv: inout Inv) {\n        loop {\n            if self.failed {\n                return;\n            }\n            if inv.frames.len() == 0 {\n                inv.state = ST_DONE;\n                return;\n            }\n            let fr = inv.frames[inv.frames.len() - 1];\n            if inv.ctl.len() == fr.ctl_base {\n                // the function ran off its end: return nothing\n                self.ret(m, &inv, -1);\n                continue;\n            }\n            let ci = inv.ctl.len() - 1;\n            let c = inv.ctl[ci];\n            let f = m.functions[fr.func];\n            let blk = f.blocks[c.blk];\n            if c.pos >= blk.count {\n                self.end_block(m, &inv, f, ci);\n                continue;\n            }\n            inv.ctl[ci].pos += 1;\n            let s = f.items[blk.start + c.pos];\n            if !self.exec(m, &inv, f, fr, s) {\n                return;\n            }\n        }\n    }\n\n    // The block at ctl[ci] finished.\n    fn end_block(inout self, m: Module, inv: inout Inv, f: Function, ci: i64) {\n        let c = inv.ctl[ci];\n        if c.kind == CT_BODY {\n            let st = f.stmts[c.s];\n            inv.ctl[ci] = Ctl { kind: CT_CONT, blk: st.b, pos: 0, s: c.s };\n            return;\n        }\n        if c.kind == CT_CONT {\n");
        buf_str(out, c"            let st = f.stmts[c.s];\n            if st.c >= 0 {\n                let fr = inv.frames[inv.frames.len() - 1];\n                if inv.mem[fr.base + self.fns[fr.func].regs[st.c]] != 0 {\n                    inv.ctl.truncate(ci);\n                    return;\n                }\n            }\n            self.steps += 1;\n            if self.steps > self.max_steps {\n                self.fail(\"the step limit was reached (an endless loop?)\");\n                return;\n            }\n            inv.ctl[ci] = Ctl { kind: CT_BODY, blk: st.a, pos: 0, s: c.s };\n            return;\n        }\n        inv.ctl.truncate(ci);\n    }\n\n    // Returns from the current function with the value at register `src`\n    // of its frame (or none).\n    fn ret(self, m: Module, inv: inout Inv, src_e: i64) {\n        let fr = inv.frames.pop().unwrap();\n        if fr.ret >= 0 && src_e >= 0 {\n            let w = words_of(m, m.functions[fr.func].exprs[src_e].ty);\n            let src = fr.base + self.fns[fr.func].regs[src_e];\n            for k in 0..w {\n                inv.mem[fr.ret + k] = inv.mem[src + k];\n            }\n        }\n        inv.ctl.truncate(fr.ctl_base);\n        if inv.frames.len() == 0 {\n            inv.state = ST_DONE;\n        } else {\n            inv.mem.truncate(fr.base);\n        }\n    }\n\n    // Runs statement s; false when the invocation stops (a barrier, the\n    // end, an error).\n    fn exec(inout self, m: Module, inv: inout Inv, f: Function, fr: Frame, s: i64) -> bool {\n        let st = f.stmts[s];\n        let op = st.op;\n        if op == S_EMIT {\n            for e in st.a..st.b {\n                self.eval_expr(m, &inv, f, fr, e);\n            }\n            return !self.failed;\n        }\n        if op == S_STORE {\n            let p = self.get_ptr(inv, fr.base + self.fns[fr.func].regs[st.a]);\n            let w = words_of(m, f.exprs[st.b].ty);\n            let src = fr.base + self.fns[fr.func].regs[st.b];\n");
        buf_str(out, c"            for k in 0..w {\n                self.write(&inv, p, k, inv.mem[src + k]);\n            }\n            return true;\n        }\n        if op == S_BLOCK {\n            inv.ctl.push(Ctl { kind: CT_BLOCK, blk: st.a, pos: 0, s: -1 });\n            return true;\n        }\n        if op == S_IF {\n            let c = inv.mem[fr.base + self.fns[fr.func].regs[st.a]];\n            inv.ctl.push(Ctl {\n                kind: CT_BLOCK, blk: if c != 0 { st.b } else { st.c }, pos: 0, s: -1\n            });\n            return true;\n        }\n        if op == S_LOOP {\n            inv.ctl.push(Ctl { kind: CT_BODY, blk: st.a, pos: 0, s: s });\n            return true;\n        }\n        if op == S_SWITCH {\n            let v = inv.mem[fr.base + self.fns[fr.func].regs[st.a]] as i64;\n            var body = -1;\n            for k in st.b..st.b + st.c {\n                let cs = f.cases[k];\n                for j in cs.vstart..cs.vstart + cs.vcount {\n                    if (f.vals[j] & OFF_MASK) == v {\n                        body = cs.body;\n                    }\n                }\n                if cs.is_default && body < 0 {\n                    // remembered, but a later case may still match\n                }\n            }\n            if body < 0 {\n                for k in st.b..st.b + st.c {\n                    if f.cases[k].is_default {\n                        body = f.cases[k].body;\n                    }\n                }\n            }\n            inv.ctl.push(Ctl { kind: CT_SWITCH, blk: body, pos: 0, s: s });\n            return true;\n        }\n        if op == S_BREAK {\n            loop {\n                let c = inv.ctl.pop().unwrap();\n                if c.kind == CT_BODY || c.kind == CT_CONT || c.kind == CT_SWITCH {\n                    return true;\n                }\n            }\n        }\n        if op == S_CONTINUE {\n            loop {\n                let ci = inv.ctl.len() - 1;\n                let c = inv.ctl[ci];\n");
        buf_str(out, c"                if c.kind == CT_BODY {\n                    let ls = f.stmts[c.s];\n                    inv.ctl[ci] = Ctl { kind: CT_CONT, blk: ls.b, pos: 0, s: c.s };\n                    return true;\n                }\n                inv.ctl.truncate(ci);\n            }\n        }\n        if op == S_RETURN {\n            self.ret(m, &inv, st.a);\n            return inv.state != ST_DONE;\n        }\n        if op == S_KILL {\n            inv.frames.clear();\n            inv.ctl.clear();\n            inv.state = ST_DONE;\n            return false;\n        }\n        if op == S_BARRIER {\n            inv.state = ST_BARRIER;\n            return false;\n        }\n        if op == S_WG_UNIFORM_LOAD {\n            if inv.phase == 0 {\n                inv.phase = 1;\n                let ci = inv.ctl.len() - 1;\n                inv.ctl[ci].pos -= 1;\n                inv.state = ST_BARRIER;\n                return false;\n            }\n            inv.phase = 0;\n            let p = self.get_ptr(inv, fr.base + self.fns[fr.func].regs[st.a]);\n            let w = words_of(m, f.exprs[st.b].ty);\n            let dst = fr.base + self.fns[fr.func].regs[st.b];\n            for k in 0..w {\n                inv.mem[dst + k] = self.read(inv, p, k);\n            }\n            inv.state = ST_BARRIER;\n            return false;\n        }\n        if op == S_CALL {\n            let callee = st.a;\n            let base = inv.mem.len();\n            for _ in 0..self.fns[callee].size {\n                inv.mem.push(0);\n            }\n            for k in 0..st.c {\n                let ae = f.args[st.b + k];\n                let pe = self.fns[callee].arg_exprs[k];\n                if pe < 0 {\n                    continue;\n                }\n                let w = words_of(m, m.functions[callee].params[k].ty);\n                let src = fr.base + self.fns[fr.func].regs[ae];\n                let dst = base + self.fns[callee].regs[pe];\n                for j in 0..w {\n");
        buf_str(out, c"                    inv.mem[dst + j] = inv.mem[src + j];\n                }\n            }\n            let ret = if st.d >= 0 { fr.base + self.fns[fr.func].regs[st.d] } else { -1 };\n            let nf = Frame { func: callee, base: base, ctl_base: inv.ctl.len(), ret: ret };\n            inv.frames.push(nf);\n            self.enter(m, &inv, nf);\n            inv.ctl.push(Ctl { kind: CT_BLOCK, blk: m.functions[callee].body, pos: 0, s: -1 });\n            if inv.frames.len() > 64 {\n                self.fail(\"calls nest too deep\");\n                return false;\n            }\n            return true;\n        }\n        if op == S_ATOMIC {\n            let p = self.get_ptr(inv, fr.base + self.fns[fr.func].regs[st.a]);\n            let sk = m.types[m.pointee(f.exprs[st.a].ty)].scalar;\n            let old = self.read(inv, p, 0);\n            let v = if st.c >= 0 { inv.mem[fr.base + self.fns[fr.func].regs[st.c]] } else { 0 };\n            let fun = st.b;\n            var new = old;\n            if fun == AT_ADD {\n                new = old + v;\n            } else if fun == AT_SUB {\n                new = old - v;\n            } else if fun == AT_AND {\n                new = old & v;\n            } else if fun == AT_OR {\n                new = old | v;\n            } else if fun == AT_XOR {\n                new = old ^ v;\n            } else if fun == AT_MIN {\n                new = if sk == SK_I32 { if si(v) < si(old) { v } else { old } }\n                    else { if v < old { v } else { old } };\n            } else if fun == AT_MAX {\n                new = if sk == SK_I32 { if si(v) > si(old) { v } else { old } }\n                    else { if v > old { v } else { old } };\n            } else if fun == AT_EXCHANGE || fun == AT_STORE {\n                new = v;\n            } else if fun == AT_CMPXCHG {\n                let cmp = inv.mem[fr.base + self.fns[fr.func].regs[st.e]];\n                if old == cmp {\n                    new = v;\n                }\n");
        buf_str(out, c"            }\n            if fun != AT_LOAD {\n                self.write(&inv, p, 0, new);\n            }\n            if st.d >= 0 {\n                let dst = fr.base + self.fns[fr.func].regs[st.d];\n                inv.mem[dst] = old;\n                if fun == AT_CMPXCHG {\n                    let cmp = inv.mem[fr.base + self.fns[fr.func].regs[st.e]];\n                    // exchanged: the member at offset 4\n                    inv.mem[dst + 1] = if old == cmp && p & PTR_INVALID == 0 { 1 } else { 0 };\n                }\n            }\n            return true;\n        }\n        if op == S_IMAGE_STORE {\n            self.fail(\"textureStore is not run by the interpreter\");\n            return false;\n        }\n        self.fail(\"unknown statement\");\n        false\n    }\n\n    // A new frame: the registers of its globals and locals hold their\n    // addresses from the start (they are leaves: an S_EMIT may cover one\n    // in a branch the invocation does not take).\n    fn enter(inout self, m: Module, inv: inout Inv, fr: Frame) {\n        let f = m.functions[fr.func];\n        for e in 0..f.exprs.len() {\n            let op = f.exprs[e].op;\n            if op == E_GLOBAL || op == E_LOCAL {\n                self.eval_expr(m, &inv, f, fr, e);\n            }\n        }\n    }\n\n    // ---- Expressions ----\n\n    fn eval_expr(inout self, m: Module, inv: inout Inv, f: Function, fr: Frame, e: i64) {\n        let x = f.exprs[e];\n        let dst = fr.base + self.fns[fr.func].regs[e];\n        let op = x.op;\n        if op == E_LITERAL {\n            inv.mem[dst] = x.a as u32;\n            return;\n        }\n        if op == E_ZERO {\n            let w = words_of(m, x.ty);\n            for k in 0..w {\n                inv.mem[dst + k] = 0;\n            }\n            return;\n        }\n        if op == E_ARG || op == E_CALL_RESULT || op == E_ATOMIC_RESULT\n            || op == E_WG_UNIFORM_RESULT {\n            return;\n        }\n");
        buf_str(out, c"        if op == E_GLOBAL {\n            let g = x.a;\n            let gl = m.globals[g];\n            let p = if gl.space == SP_PRIVATE {\n                (PS_PRIVATE << 48) | self.goff[g]\n            } else if gl.space == SP_WORKGROUP {\n                (PS_WORKGROUP << 48) | self.goff[g]\n            } else if gl.space == SP_HANDLE {\n                g\n            } else {\n                (PS_BUFFER << 48) | (g << 32)\n            };\n            if gl.space == SP_HANDLE {\n                inv.mem[dst] = g as u32;\n            } else {\n                self.put_ptr(&inv, dst, p);\n            }\n            return;\n        }\n        if op == E_LOCAL {\n            let off = fr.base + self.fns[fr.func].locals[x.a];\n            self.put_ptr(&inv, dst, (PS_FUNC << 48) | off);\n            return;\n        }\n        if op == E_LOAD {\n            let p = self.get_ptr(inv, fr.base + self.fns[fr.func].regs[x.a]);\n            let w = words_of(m, x.ty);\n            for k in 0..w {\n                inv.mem[dst + k] = self.read(inv, p, k);\n            }\n            return;\n        }\n        if op == E_ACCESS || op == E_ACCESS_INDEX {\n            let bt0 = f.exprs[x.a].ty;\n            let is_ptr = m.types[bt0].kind == TK_POINTER;\n            let bt = if is_ptr { m.types[bt0].base } else { bt0 };\n            let t = m.types[bt];\n            var idx = 0;\n            var invalid = false;\n            if op == E_ACCESS_INDEX {\n                idx = x.b;\n            } else {\n                let iv = inv.mem[fr.base + self.fns[fr.func].regs[x.b]] as i64;\n                idx = iv;\n                if x.c == CK_CLAMP {\n                    if idx > x.d - 1 {\n                        idx = x.d - 1;\n                    }\n                } else if x.c == CK_RZSW {\n                    let g = self.root_global(f, x.a);\n                    let bp = self.get_ptr(inv, fr.base + self.fns[fr.func].regs[x.a]);\n                    let start = (bp & OFF_MASK) * 4;\n");
        buf_str(out, c"                    let len = if g >= 0 { self.runtime_len(g, start, t.stride) } else { 0 };\n                    if idx >= len {\n                        invalid = true;\n                        idx = 0;\n                    }\n                } else if x.c == ir::CK_PENDING {\n                    self.fail(\"an index has no bounds check (internal error)\");\n                    return;\n                }\n                // CK_NONE: proven in range\n            }\n            // the word offset of the component\n            let off = if t.kind == TK_STRUCT {\n                m.members[t.mstart + idx].offset / 4\n            } else if t.kind == TK_VECTOR {\n                idx\n            } else {\n                idx * t.stride / 4\n            };\n            if is_ptr {\n                var p = self.get_ptr(inv, fr.base + self.fns[fr.func].regs[x.a]) + off;\n                if invalid {\n                    p = p | PTR_INVALID;\n                }\n                self.put_ptr(&inv, dst, p);\n            } else {\n                let w = words_of(m, x.ty);\n                let src = fr.base + self.fns[fr.func].regs[x.a] + off;\n                for k in 0..w {\n                    inv.mem[dst + k] = inv.mem[src + k];\n                }\n            }\n            return;\n        }\n        if op == E_COMPOSE {\n            let t = m.types[x.ty];\n            var at = 0;\n            for k in 0..x.b {\n                let a = f.args[x.a + k];\n                let aw = words_of(m, f.exprs[a].ty);\n                let o = compose_offset(m, t, k, at);\n                let src = fr.base + self.fns[fr.func].regs[a];\n                for j in 0..aw {\n                    inv.mem[dst + o + j] = inv.mem[src + j];\n                }\n                at += aw;\n            }\n            return;\n        }\n        if op == E_SPLAT {\n            let v = inv.mem[fr.base + self.fns[fr.func].regs[x.a]];\n            let n = m.types[x.ty].n;\n            for k in 0..n {\n");
        buf_str(out, c"                inv.mem[dst + k] = v;\n            }\n            return;\n        }\n        if op == E_SWIZZLE {\n            let src = fr.base + self.fns[fr.func].regs[x.a];\n            // through a temporary: the source may be read after the first write\n            var tmp: [u32; 4] = [0; 4];\n            for k in 0..x.c {\n                tmp[k] = inv.mem[src + ((x.b >> (2 * k)) & 3)];\n            }\n            for k in 0..x.c {\n                inv.mem[dst + k] = tmp[k];\n            }\n            return;\n        }\n        if op == E_UNARY {\n            let t = m.types[x.ty];\n            let n = if t.kind == TK_VECTOR { t.n } else { 1 };\n            let src = fr.base + self.fns[fr.func].regs[x.b];\n            for k in 0..n {\n                let v = inv.mem[src + k];\n                inv.mem[dst + k] = if x.a == UN_NEG {\n                    if t.scalar == SK_F32 { ub(-fl(v)) } else { 0 - v }\n                } else if x.a == UN_NOT {\n                    if v == 0 { 1 } else { 0 }\n                } else {\n                    ~v\n                };\n            }\n            return;\n        }\n        if op == E_BINARY {\n            self.binary(m, &inv, f, fr, e);\n            return;\n        }\n        if op == E_SELECT {\n            let t = m.types[x.ty];\n            let w = words_of(m, x.ty);\n            let ct = m.types[f.exprs[x.a].ty];\n            let c = fr.base + self.fns[fr.func].regs[x.a];\n            let tsrc = fr.base + self.fns[fr.func].regs[x.b];\n            let fsrc = fr.base + self.fns[fr.func].regs[x.c];\n            for k in 0..w {\n                let ck = if ct.kind == TK_VECTOR { inv.mem[c + k] } else { inv.mem[c] };\n                inv.mem[dst + k] = if ck != 0 { inv.mem[tsrc + k] } else { inv.mem[fsrc + k] };\n            }\n            let _ = t;\n            return;\n        }\n        if op == E_CONVERT {\n            let t = m.types[x.ty];\n            let from = m.types[f.exprs[x.a].ty].scalar;\n");
        buf_str(out, c"            let n = if t.kind == TK_VECTOR { t.n } else { 1 };\n            let src = fr.base + self.fns[fr.func].regs[x.a];\n            for k in 0..n {\n                inv.mem[dst + k] = convert(inv.mem[src + k], from, t.scalar);\n            }\n            return;\n        }\n        if op == E_BITCAST {\n            let w = words_of(m, x.ty);\n            let src = fr.base + self.fns[fr.func].regs[x.a];\n            for k in 0..w {\n                inv.mem[dst + k] = inv.mem[src + k];\n            }\n            return;\n        }\n        if op == E_MATH {\n            self.math(m, &inv, f, fr, e);\n            return;\n        }\n        if op == E_ARRAY_LENGTH {\n            inv.mem[dst] = self.runtime_len(x.a, x.c, x.d) as u32;\n            return;\n        }\n        if op == E_DERIVATIVE {\n            // one invocation alone: its derivatives are zero\n            let w = words_of(m, x.ty);\n            for k in 0..w {\n                inv.mem[dst + k] = 0;\n            }\n            return;\n        }\n        if op == E_IMAGE_LOAD || op == E_IMAGE_QUERY {\n            let g = inv.mem[fr.base + self.fns[fr.func].regs[x.a]] as i64;\n            let tt = m.types[f.exprs[x.a].ty];\n            if tt.n == ir::TEX_2D_ARRAY {\n                self.fail(\"array textures are not run by the interpreter\");\n                return;\n            }\n            let w = self.tex_w[g];\n            let h = self.tex_h[g];\n            if op == E_IMAGE_QUERY {\n                if x.b == ir::IQ_SIZE {\n                    inv.mem[dst] = w as u32;\n                    inv.mem[dst + 1] = h as u32;\n                } else {\n                    inv.mem[dst] = 1;\n                }\n                return;\n            }\n            // the coordinates clamped (as unsigned) into the one level\n            let c = fr.base + self.fns[fr.func].regs[f.args[x.c]];\n            var cx = inv.mem[c] as i64;\n            var cy = inv.mem[c + 1] as i64;\n            if cx > w - 1 {\n");
        buf_str(out, c"                cx = w - 1;\n            }\n            if cy > h - 1 {\n                cy = h - 1;\n            }\n            if w <= 0 || h <= 0 {\n                self.fail(\"a texture the job does not set is read\");\n                return;\n            }\n            let t = (cy * w + cx) * 4;\n            let n = words_of(m, x.ty);\n            for k in 0..n {\n                inv.mem[dst + k] = self.texels[g][t + k];\n            }\n            return;\n        }\n        if op == E_IMAGE_SAMPLE {\n            self.fail(\"sampling is not run by the interpreter\");\n            return;\n        }\n        self.fail(\"unknown expression\");\n    }\n\n    fn binary(self, m: Module, inv: inout Inv, f: Function, fr: Frame, e: i64) {\n        let x = f.exprs[e];\n        let dst = fr.base + self.fns[fr.func].regs[e];\n        let lt = m.types[f.exprs[x.b].ty];\n        let rt = m.types[f.exprs[x.c].ty];\n        let l = fr.base + self.fns[fr.func].regs[x.b];\n        let r = fr.base + self.fns[fr.func].regs[x.c];\n        let op = x.a;\n        if lt.kind == TK_MATRIX || rt.kind == TK_MATRIX {\n            self.matrix_binary(m, &inv, op, lt, rt, x.ty, l, r, dst);\n            return;\n        }\n        let n = if lt.kind == TK_VECTOR { lt.n } else { 1 };\n        let sk = lt.scalar;\n        // the result first in a temporary: dst never overlaps l or r, but stay simple\n        for k in 0..n {\n            let a = inv.mem[l + k];\n            let b = inv.mem[r + k];\n            inv.mem[dst + k] = scalar_binary(op, sk, a, b);\n        }\n    }\n\n    fn matrix_binary(self, m: Module, inv: inout Inv, op: i64, lt: ir::Type, rt: ir::Type,\n        ty: i64, l: i64, r: i64, dst: i64) {\n        let res = m.types[ty];\n        if op == OP_ADD || op == OP_SUB {\n            let cs = lt.stride / 4;\n            for c in 0..lt.n {\n                for k in 0..lt.m {\n                    let a = fl(inv.mem[l + c * cs + k]);\n");
        buf_str(out, c"                    let b = fl(inv.mem[r + c * cs + k]);\n                    inv.mem[dst + c * cs + k] = ub(if op == OP_ADD { a + b } else { a - b });\n                }\n            }\n            return;\n        }\n        // multiplication\n        if lt.kind == TK_MATRIX && rt.kind == TK_SCALAR {\n            let cs = lt.stride / 4;\n            let s = fl(inv.mem[r]);\n            for c in 0..lt.n {\n                for k in 0..lt.m {\n                    inv.mem[dst + c * cs + k] = ub(fl(inv.mem[l + c * cs + k]) * s);\n                }\n            }\n            return;\n        }\n        if lt.kind == TK_SCALAR {\n            let cs = rt.stride / 4;\n            let s = fl(inv.mem[l]);\n            for c in 0..rt.n {\n                for k in 0..rt.m {\n                    inv.mem[dst + c * cs + k] = ub(s * fl(inv.mem[r + c * cs + k]));\n                }\n            }\n            return;\n        }\n        if lt.kind == TK_MATRIX && rt.kind == TK_VECTOR {\n            // (C x R) * vecC -> vecR\n            let cs = lt.stride / 4;\n            var out: [f32; 4] = [0.0; 4];\n            for k in 0..lt.m {\n                var acc: f32 = 0.0;\n                for c in 0..lt.n {\n                    acc = acc + fl(inv.mem[l + c * cs + k]) * fl(inv.mem[r + c]);\n                }\n                out[k] = acc;\n            }\n            for k in 0..lt.m {\n                inv.mem[dst + k] = ub(out[k]);\n            }\n            return;\n        }\n        if lt.kind == TK_VECTOR {\n            // vecR * (C x R) -> vecC\n            let cs = rt.stride / 4;\n            var out: [f32; 4] = [0.0; 4];\n            for c in 0..rt.n {\n                var acc: f32 = 0.0;\n                for k in 0..rt.m {\n                    acc = acc + fl(inv.mem[l + k]) * fl(inv.mem[r + c * cs + k]);\n                }\n                out[c] = acc;\n            }\n            for c in 0..rt.n {\n                inv.mem[dst + c] = ub(out[c]);\n            }\n");
        buf_str(out, c"            return;\n        }\n        // (K x R) * (C x K) -> (C x R)\n        let ls = lt.stride / 4;\n        let rs = rt.stride / 4;\n        let ds = res.stride / 4;\n        var out: [f32; 16] = [0.0; 16];\n        for c in 0..rt.n {\n            for k in 0..lt.m {\n                var acc: f32 = 0.0;\n                for j in 0..lt.n {\n                    acc = acc + fl(inv.mem[l + j * ls + k]) * fl(inv.mem[r + c * rs + j]);\n                }\n                out[c * 4 + k] = acc;\n            }\n        }\n        for c in 0..rt.n {\n            for k in 0..lt.m {\n                inv.mem[dst + c * ds + k] = ub(out[c * 4 + k]);\n            }\n        }\n    }\n\n    fn math(self, m: Module, inv: inout Inv, fx: Function, fr: Frame, e: i64) {\n        let x = fx.exprs[e];\n        let dst = fr.base + self.fns[fr.func].regs[e];\n        let fun = x.a;\n        let nargs = x.c;\n        var a: [i64; 4] = [0; 4];\n        for k in 0..nargs {\n            a[k] = fr.base + self.fns[fr.func].regs[fx.args[x.b + k]];\n        }\n        let at = m.types[fx.exprs[fx.args[x.b]].ty];\n        let n = if at.kind == TK_VECTOR { at.n } else { 1 };\n        let sk = at.scalar;\n        if fun == ir::MF_DOT {\n            var accf: f32 = 0.0;\n            var acci: u32 = 0;\n            for k in 0..n {\n                let p = inv.mem[a[0] + k];\n                let q = inv.mem[a[1] + k];\n                if sk == SK_F32 {\n                    accf = accf + fl(p) * fl(q);\n                } else {\n                    acci = acci + p * q;\n                }\n            }\n            inv.mem[dst] = if sk == SK_F32 { ub(accf) } else { acci };\n            return;\n        }\n        if fun == ir::MF_LENGTH || fun == ir::MF_DISTANCE || fun == ir::MF_NORMALIZE {\n            var acc: f32 = 0.0;\n            for k in 0..n {\n                var v = fl(inv.mem[a[0] + k]);\n                if fun == ir::MF_DISTANCE {\n                    v = v - fl(inv.mem[a[1] + k]);\n");
        buf_str(out, c"                }\n                acc = acc + v * v;\n            }\n            let len = unsafe { sqrtf(acc) };\n            if fun == ir::MF_NORMALIZE {\n                for k in 0..n {\n                    inv.mem[dst + k] = ub(fl(inv.mem[a[0] + k]) / len);\n                }\n            } else {\n                inv.mem[dst] = ub(len);\n            }\n            return;\n        }\n        if fun == ir::MF_CROSS {\n            let p = [fl(inv.mem[a[0]]), fl(inv.mem[a[0] + 1]), fl(inv.mem[a[0] + 2])];\n            let q = [fl(inv.mem[a[1]]), fl(inv.mem[a[1] + 1]), fl(inv.mem[a[1] + 2])];\n            inv.mem[dst] = ub(p[1] * q[2] - p[2] * q[1]);\n            inv.mem[dst + 1] = ub(p[2] * q[0] - p[0] * q[2]);\n            inv.mem[dst + 2] = ub(p[0] * q[1] - p[1] * q[0]);\n            return;\n        }\n        if fun == ir::MF_REFLECT || fun == ir::MF_FACE_FORWARD {\n            // reflect(e1, e2) = e1 - 2 * dot(e2, e1) * e2\n            // faceForward(e1, e2, e3) = if dot(e2, e3) < 0 { e1 } else { -e1 }\n            let p = if fun == ir::MF_REFLECT { a[1] } else { a[1] };\n            let q = if fun == ir::MF_REFLECT { a[0] } else { a[2] };\n            var d: f32 = 0.0;\n            for k in 0..n {\n                d = d + fl(inv.mem[p + k]) * fl(inv.mem[q + k]);\n            }\n            for k in 0..n {\n                let e1 = fl(inv.mem[a[0] + k]);\n                inv.mem[dst + k] = if fun\n                    == ir::MF_REFLECT { ub(e1 - 2.0 * d * fl(inv.mem[a[1] + k])) }\n                    else if d < 0.0 { ub(e1) } else { ub(-e1) };\n            }\n            return;\n        }\n        if fun == ir::MF_ALL || fun == ir::MF_ANY {\n            var r = if fun == ir::MF_ALL { 1u32 } else { 0u32 };\n            for k in 0..n {\n                let v = inv.mem[a[0] + k];\n                if fun == ir::MF_ALL && v == 0 {\n                    r = 0;\n                }\n                if fun == ir::MF_ANY && v != 0 {\n                    r = 1;\n");
        buf_str(out, c"                }\n            }\n            inv.mem[dst] = r;\n            return;\n        }\n        if fun == ir::MF_DETERMINANT || fun == ir::MF_TRANSPOSE {\n            let cs = at.stride / 4;\n            if fun == ir::MF_TRANSPOSE {\n                let rt = m.types[x.ty];\n                let rs = rt.stride / 4;\n                for c in 0..at.n {\n                    for k in 0..at.m {\n                        inv.mem[dst + k * rs + c] = inv.mem[a[0] + c * cs + k];\n                    }\n                }\n                return;\n            }\n            var mm: [f32; 16] = [0.0; 16];\n            for c in 0..at.n {\n                for k in 0..at.m {\n                    mm[c * 4 + k] = fl(inv.mem[a[0] + c * cs + k]);\n                }\n            }\n            inv.mem[dst] = ub(determinant(mm, at.n));\n            return;\n        }\n        if fun >= ir::MF_PACK4X8UNORM && fun <= ir::MF_UNPACK2X16FLOAT\n            || fun >= ir::MF_PACK4X8SNORM {\n            self.packing(&inv, fun, a[0], dst);\n            return;\n        }\n        // component-wise\n        let mix_scalar = false;\n        let _ = mix_scalar;\n        for k in 0..n {\n            let p = inv.mem[a[0] + k];\n            let q = if nargs > 1 { inv.mem[a[1] + k] } else { 0 };\n            let r = if nargs > 2 { inv.mem[a[2] + k] } else { 0 };\n            let s = if nargs > 3 { inv.mem[a[3] + k] } else { 0 };\n            if fun == ir::MF_EXTRACT_BITS {\n                inv.mem[dst + k] = extract_bits(p, inv.mem[a[1]], inv.mem[a[2]], sk == SK_I32);\n                continue;\n            }\n            if fun == ir::MF_INSERT_BITS {\n                inv.mem[dst + k] = insert_bits(p, q, inv.mem[a[2]], inv.mem[a[3]]);\n                continue;\n            }\n            let _ = s;\n            inv.mem[dst + k] = component_math(fun, sk, p, q, r);\n        }\n    }\n\n    fn packing(self, inv: inout Inv, fun: i64, src: i64, dst: i64) {\n");
        buf_str(out, c"        if fun == ir::MF_PACK4X8UNORM || fun == ir::MF_PACK4X8SNORM {\n            var r: u32 = 0;\n            for k in 0..4 {\n                let v = fl(inv.mem[src + k]);\n                let q = if fun == ir::MF_PACK4X8UNORM {\n                    (round_even(clampf(v, 0.0, 1.0) * 255.0) as i64) & 255\n                } else {\n                    (round_even(clampf(v, -1.0, 1.0) * 127.0) as i64) & 255\n                };\n                r = r | ((q as u32) << (8 * k) as u32);\n            }\n            inv.mem[dst] = r;\n        } else if fun == ir::MF_UNPACK4X8UNORM || fun == ir::MF_UNPACK4X8SNORM {\n            let v = inv.mem[src];\n            for k in 0..4 {\n                let b = (v >> (8 * k) as u32) & 255;\n                inv.mem[dst + k] = if fun == ir::MF_UNPACK4X8UNORM {\n                    ub(b as f32 / 255.0)\n                } else {\n                    let sb = if b >= 128 { b as i64 - 256 } else { b as i64 };\n                    ub(maxf(sb as f32 / 127.0, -1.0))\n                };\n            }\n        } else if fun == ir::MF_PACK2X16UNORM || fun == ir::MF_PACK2X16SNORM {\n            var r: u32 = 0;\n            for k in 0..2 {\n                let v = fl(inv.mem[src + k]);\n                let q = if fun == ir::MF_PACK2X16UNORM {\n                    (round_even(clampf(v, 0.0, 1.0) * 65535.0) as i64) & 65535\n                } else {\n                    (round_even(clampf(v, -1.0, 1.0) * 32767.0) as i64) & 65535\n                };\n                r = r | ((q as u32) << (16 * k) as u32);\n            }\n            inv.mem[dst] = r;\n        } else if fun == ir::MF_UNPACK2X16UNORM || fun == ir::MF_UNPACK2X16SNORM {\n            let v = inv.mem[src];\n            for k in 0..2 {\n                let b = (v >> (16 * k) as u32) & 65535;\n                inv.mem[dst + k] = if fun == ir::MF_UNPACK2X16UNORM {\n                    ub(b as f32 / 65535.0)\n                } else {\n");
        buf_str(out, c"                    let sb = if b >= 32768 { b as i64 - 65536 } else { b as i64 };\n                    ub(maxf(sb as f32 / 32767.0, -1.0))\n                };\n            }\n        } else if fun == ir::MF_PACK2X16FLOAT {\n            let lo = f32_to_f16(fl(inv.mem[src]));\n            let hi = f32_to_f16(fl(inv.mem[src + 1]));\n            inv.mem[dst] = lo | (hi << 16);\n        } else {\n            let v = inv.mem[src];\n            inv.mem[dst] = ub(f16_to_f32(v & 65535));\n            inv.mem[dst + 1] = ub(f16_to_f32(v >> 16));\n        }\n    }\n}\n\nfn clampf(x: f32, lo: f32, hi: f32) -> f32 { if x < lo { lo } else if x > hi { hi } else { x } }\n\nfn maxf(a: f32, b: f32) -> f32 { if a > b { a } else { b } }\n\nfn round_even(x: f32) -> f32 { unsafe { rintf(x) } }\n\nfn f32_to_f16(x: f32) -> u32 {\n    let b = ub(x);\n    let sign = (b >> 16) & 32768;\n    let exp = ((b >> 23) & 255) as i64 - 127 + 15;\n    let man = b & 8388607;\n    if ((b >> 23) & 255) == 255 {\n        return sign | 31744 | (if man != 0 { 512 } else { 0 });\n    }\n    if exp >= 31 {\n        return sign | 31744;\n    }\n    if exp <= 0 {\n        if exp < -10 {\n            return sign;\n        }\n        let m2 = man | 8388608;\n        let shift = (14 - exp) as u32;\n        var h = m2 >> shift;\n        let rem = m2 & ((1u32 << shift) - 1);\n        let half = 1u32 << (shift - 1);\n        if rem > half || (rem == half && (h & 1) != 0) {\n            h += 1;\n        }\n        return sign | h;\n    }\n    var h = sign | ((exp as u32) << 10) | (man >> 13);\n    let rem = man & 8191;\n    if rem > 4096 || (rem == 4096 && (h & 1) != 0) {\n        h += 1;\n    }\n    h\n}\n\nfn f16_to_f32(h: u32) -> f32 {\n    let sign = (h & 32768) << 16;\n    let exp = (h >> 10) & 31;\n    let man = h & 1023;\n    if exp == 0 {\n        let v = man as f32 / 16777216.0;\n        return if sign != 0 { -v } else { v };\n    }\n    if exp == 31 {\n        return fl(sign | 2139095040 | (man << 13));\n");
        buf_str(out, c"    }\n    fl(sign | ((exp + 112) << 23) | (man << 13))\n}\n\nfn determinant(m: [f32; 16], n: i64) -> f32 {\n    if n == 2 {\n        return m[0] * m[5] - m[4] * m[1];\n    }\n    if n == 3 {\n        return m[0] * (m[5] * m[10] - m[9] * m[6]) - m[4] * (m[1] * m[10] - m[9] * m[2]) + m[8] * (\n            m[1] * m[6] - m[5] * m[2]);\n    }\n    var det: f32 = 0.0;\n    for c in 0..4 {\n        var sub: [f32; 16] = [0.0; 16];\n        var sc = 0;\n        for j in 0..4 {\n            if j == c {\n                continue;\n            }\n            for k in 1..4 {\n                sub[sc * 4 + k - 1] = m[j * 4 + k];\n            }\n            sc += 1;\n        }\n        let d = determinant(sub, 3);\n        det = if c % 2 == 0 { det + m[c * 4] * d } else { det - m[c * 4] * d };\n    }\n    det\n}\n\npub fn convert(v: u32, from: u8, to: u8) -> u32 {\n    if from == to {\n        return v;\n    }\n    if to == SK_BOOL {\n        return if from == SK_F32 { if fl(v) != 0.0 { 1 } else { 0 } } else if v != 0 { 1 }\n            else { 0 };\n    }\n    if from == SK_BOOL {\n        return if to == SK_F32 { if v != 0 { ub(1.0) } else { 0 } } else { v };\n    }\n    if to == SK_F32 {\n        return if from == SK_I32 { ub(si(v) as f32) } else { ub(v as i64 as f32) };\n    }\n    if from == SK_F32 {\n        let x = fl(v);\n        if x != x {\n            return 0;\n        }\n        if to == SK_I32 {\n            if x <= -2147483648.0 {\n                return 2147483648;\n            }\n            // WGSL: the nearest value representable in both i32 and f32\n            if x >= 2147483520.0 {\n                return 2147483520;\n            }\n            return (x as i64) as u32;\n        }\n        if x <= 0.0 {\n            return 0;\n        }\n        if x >= 4294967040.0 {\n            return 4294967040;\n        }\n        return (x as i64) as u32;\n    }\n    // i32 <-> u32: the bits\n    v\n}\n\npub fn scalar_binary(op: i64, sk: u8, a: u32, b: u32) -> u32 {\n");
        buf_str(out, c"    if sk == SK_F32 {\n        let x = fl(a);\n        let y = fl(b);\n        if op == OP_ADD {\n            return ub(x + y);\n        }\n        if op == OP_SUB {\n            return ub(x - y);\n        }\n        if op == OP_MUL {\n            return ub(x * y);\n        }\n        if op == OP_DIV {\n            return ub(x / y);\n        }\n        if op == OP_MOD {\n            // WGSL: x - y * trunc(x / y)\n            return ub(unsafe { fmodf(x, y) });\n        }\n        let c = if op == OP_EQ { x == y } else if op == OP_NE { x != y }\n            else if op == OP_LT { x < y } else if op == OP_LE { x <= y }\n            else if op == OP_GT { x > y } else { x >= y };\n        return if c { 1 } else { 0 };\n    }\n    if op == OP_ADD {\n        return a + b;\n    }\n    if op == OP_SUB {\n        return a - b;\n    }\n    if op == OP_MUL {\n        return a * b;\n    }\n    if op == OP_DIV {\n        if b == 0 {\n            return a;\n        }\n        if sk == SK_I32 {\n            if a == 2147483648 && b == 4294967295 {\n                return a;\n            }\n            return (si(a) / si(b)) as u32;\n        }\n        return a / b;\n    }\n    if op == OP_MOD {\n        if b == 0 {\n            return 0;\n        }\n        if sk == SK_I32 {\n            if a == 2147483648 && b == 4294967295 {\n                return 0;\n            }\n            return (si(a) % si(b)) as u32;\n        }\n        return a % b;\n    }\n    if op == OP_AND || op == OP_LAND {\n        return a & b;\n    }\n    if op == OP_OR || op == OP_LOR {\n        return a | b;\n    }\n    if op == OP_XOR {\n        return a ^ b;\n    }\n    if op == OP_SHL {\n        return a << (b & 31);\n    }\n    if op == OP_SHR {\n        if sk == SK_I32 {\n            return (si(a) >> (b & 31) as i64) as u32;\n        }\n        return a >> (b & 31);\n    }\n    let c = if sk == SK_I32 {\n        let x = si(a);\n        let y = si(b);\n");
        buf_str(out, c"        if op == OP_EQ { x == y } else if op == OP_NE { x != y } else if op == OP_LT { x < y }\n        else if op == OP_LE { x <= y } else if op == OP_GT { x > y } else { x >= y }\n    } else {\n        if op == OP_EQ { a == b } else if op == OP_NE { a != b } else if op == OP_LT { a < b }\n        else if op == OP_LE { a <= b } else if op == OP_GT { a > b } else { a >= b }\n    };\n    if c { 1 } else { 0 }\n}\n\nfn extract_bits(e: u32, offset: u32, count: u32, signed: bool) -> u32 {\n    let o = if offset > 32 { 32 } else { offset };\n    let c = if count > 32 - o { 32 - o } else { count };\n    if c == 0 {\n        return 0;\n    }\n    let v = if o == 32 { 0 } else { e >> o };\n    if c == 32 {\n        return v;\n    }\n    let mask = (1u32 << c) - 1;\n    let r = v & mask;\n    if signed && (r >> (c - 1)) & 1 != 0 {\n        return r | ~mask;\n    }\n    r\n}\n\nfn insert_bits(e: u32, nb: u32, offset: u32, count: u32) -> u32 {\n    let o = if offset > 32 { 32 } else { offset };\n    let c = if count > 32 - o { 32 - o } else { count };\n    if c == 0 {\n        return e;\n    }\n    let mask = if c == 32 { 4294967295u32 } else { ((1u32 << c) - 1) << o };\n    (e & ~mask) | ((nb << o) & mask)\n}\n\nfn clz(x: u32) -> u32 {\n    if x == 0 {\n        return 32;\n    }\n    std::leading_zeros(x as u64) as u32 - 32\n}\n\nfn ctz(x: u32) -> u32 {\n    if x == 0 {\n        return 32;\n    }\n    std::trailing_zeros(x as u64) as u32\n}\n\npub fn component_math(fun: i64, sk: u8, p: u32, q: u32, r: u32) -> u32 {\n    if sk != SK_F32 {\n        let signed = sk == SK_I32;\n        if fun == ir::MF_ABS {\n            return if signed && si(p) < 0 { 0 - p } else { p };\n        }\n        if fun == ir::MF_MIN {\n            return if (signed && si(q) < si(p)) || (!signed && q < p) { q } else { p };\n        }\n        if fun == ir::MF_MAX {\n            return if (signed && si(q) > si(p)) || (!signed && q > p) { q } else { p };\n        }\n        if fun == ir::MF_CLAMP {\n");
        buf_str(out, c"            let lo = component_math(ir::MF_MAX, sk, p, q, 0);\n            return component_math(ir::MF_MIN, sk, lo, r, 0);\n        }\n        if fun == ir::MF_SIGN {\n            return if si(p) > 0 { 1 } else if si(p) < 0 { 4294967295 } else { 0 };\n        }\n        if fun == ir::MF_COUNT_ONE_BITS {\n            var c: u32 = 0;\n            var x = p;\n            while x != 0 {\n                c += x & 1;\n                x = x >> 1;\n            }\n            return c;\n        }\n        if fun == ir::MF_COUNT_LEADING_ZEROS {\n            return clz(p);\n        }\n        if fun == ir::MF_COUNT_TRAILING_ZEROS {\n            return ctz(p);\n        }\n        if fun == ir::MF_FIRST_LEADING_BIT {\n            let x = if signed && si(p) < 0 { ~p } else { p };\n            if x == 0 {\n                return 4294967295;\n            }\n            return 31 - clz(x);\n        }\n        if fun == ir::MF_FIRST_TRAILING_BIT {\n            if p == 0 {\n                return 4294967295;\n            }\n            return ctz(p);\n        }\n        if fun == ir::MF_REVERSE_BITS {\n            var x = p;\n            var rr: u32 = 0;\n            for _ in 0..32 {\n                rr = (rr << 1) | (x & 1);\n                x = x >> 1;\n            }\n            return rr;\n        }\n        return 0;\n    }\n    let x = fl(p);\n    let y = fl(q);\n    let z = fl(r);\n    let v: f32 = if fun == ir::MF_ABS {\n        if x < 0.0 { -x } else if x == 0.0 { 0.0 } else { x }\n    } else if fun == ir::MF_MIN {\n        unsafe { fminf(x, y) }\n    } else if fun == ir::MF_MAX {\n        unsafe { fmaxf(x, y) }\n    } else if fun == ir::MF_CLAMP {\n        unsafe { fminf(fmaxf(x, y), z) }\n    } else if fun == ir::MF_SIGN {\n        if x > 0.0 { 1.0 } else if x < 0.0 { -1.0 } else { 0.0 }\n    } else if fun == ir::MF_FLOOR {\n        unsafe { floorf(x) }\n    } else if fun == ir::MF_CEIL {\n        unsafe { ceilf(x) }\n    } else if fun == ir::MF_ROUND {\n");
        buf_str(out, c"        unsafe { rintf(x) }\n    } else if fun == ir::MF_FRACT {\n        x - unsafe { floorf(x) }\n    } else if fun == ir::MF_TRUNC {\n        unsafe { truncf(x) }\n    } else if fun == ir::MF_SQRT {\n        unsafe { sqrtf(x) }\n    } else if fun == ir::MF_INVERSE_SQRT {\n        1.0 / unsafe { sqrtf(x) }\n    } else if fun == ir::MF_EXP {\n        unsafe { expf(x) }\n    } else if fun == ir::MF_EXP2 {\n        unsafe { exp2f(x) }\n    } else if fun == ir::MF_LOG {\n        unsafe { logf(x) }\n    } else if fun == ir::MF_LOG2 {\n        unsafe { log2f(x) }\n    } else if fun == ir::MF_POW {\n        unsafe { powf(x, y) }\n    } else if fun == ir::MF_SIN {\n        unsafe { sinf(x) }\n    } else if fun == ir::MF_COS {\n        unsafe { cosf(x) }\n    } else if fun == ir::MF_TAN {\n        unsafe { tanf(x) }\n    } else if fun == ir::MF_ASIN {\n        unsafe { asinf(x) }\n    } else if fun == ir::MF_ACOS {\n        unsafe { acosf(x) }\n    } else if fun == ir::MF_ATAN {\n        unsafe { atanf(x) }\n    } else if fun == ir::MF_ATAN2 {\n        unsafe { atan2f(x, y) }\n    } else if fun == ir::MF_SINH {\n        unsafe { sinhf(x) }\n    } else if fun == ir::MF_COSH {\n        unsafe { coshf(x) }\n    } else if fun == ir::MF_TANH {\n        unsafe { tanhf(x) }\n    } else if fun == ir::MF_ASINH {\n        unsafe { asinhf(x) }\n    } else if fun == ir::MF_ACOSH {\n        unsafe { acoshf(x) }\n    } else if fun == ir::MF_ATANH {\n        unsafe { atanhf(x) }\n    } else if fun == ir::MF_MIX {\n        x * (1.0 - z) + y * z\n    } else if fun == ir::MF_STEP {\n        if y >= x { 1.0 } else { 0.0 }\n    } else if fun == ir::MF_SMOOTHSTEP {\n        let t = clampf((z - x) / (y - x), 0.0, 1.0);\n        t * t * (3.0 - 2.0 * t)\n    } else if fun == ir::MF_FMA {\n        unsafe { fmaf(x, y, z) }\n    } else if fun == ir::MF_DEGREES {\n        x * 57.295779513082322865\n    } else if fun == ir::MF_RADIANS {\n        x * 0.017453292519943295\n");
        buf_str(out, c"    } else if fun == ir::MF_SATURATE {\n        clampf(x, 0.0, 1.0)\n    } else if fun == ir::MF_LDEXP {\n        unsafe { ldexpf(x, q as i32) }\n    } else {\n        0.0\n    };\n    ub(v)\n}\n// ---- end mod std::gpu::wgsl::interp ----\n}\n// ---- mod std::gpu::wgsl::dump ----\npub mod dump {\n// ---- Shader compiler implementation, dump (0.22) ----\n// The IR as text: `wgslc ir FILE`, and the front end's golden tests.\n\nuse ir::{\n    E_ACCESS, E_ACCESS_INDEX, E_ARG, E_ARRAY_LENGTH, E_ATOMIC_RESULT, E_BINARY, E_BITCAST,\n    E_CALL_RESULT, E_COMPOSE, E_CONVERT, E_DERIVATIVE, E_GLOBAL, E_IMAGE_LOAD, E_IMAGE_QUERY,\n    E_IMAGE_SAMPLE, E_LITERAL, E_LOAD, E_LOCAL, E_MATH, E_SELECT, E_SPLAT, E_SWIZZLE, E_UNARY,\n    E_WG_UNIFORM_RESULT, E_ZERO, Function, Module, SK_BOOL, SK_F32, SK_I32, S_ATOMIC, S_BARRIER,\n    S_BLOCK, S_BREAK, S_CALL, S_CONTINUE, S_EMIT, S_IF, S_IMAGE_STORE, S_KILL, S_LOOP, S_RETURN,\n    S_STORE, S_SWITCH, S_WG_UNIFORM_LOAD, bits_f32,\n};\nuse std::{Allocator, Buf};\n\nconst UN: [[u8]; 3] = [\"neg\", \"not\", \"bitnot\"];\nconst BIN: [[u8]; 18] = [\"add\", \"sub\", \"mul\", \"div\", \"mod\", \"eq\", \"ne\", \"lt\", \"le\", \"gt\", \"ge\",\n    \"and\", \"or\", \"xor\", \"shl\", \"shr\", \"land\", \"lor\"];\nconst ATOM: [[u8]; 11] = [\"add\", \"sub\", \"and\", \"or\", \"xor\", \"min\", \"max\", \"exchange\", \"load\",\n    \"store\", \"cmpxchg\"];\nconst CK: [[u8]; 4] = [\"pending\", \"none\", \"clamp\", \"rzsw\"];\n\npub fn dump<A: Allocator>(m: Module, b: inout Buf<A>) {\n    for t in ir::T_FIXED_COUNT..m.types.len() {\n        let ty = m.types[t];\n        if ty.kind == ir::TK_STRUCT {\n            b.push_fmt(f\"struct {ty.name} (size {ty.size}, align {ty.align}) {{\");\n            for i in ty.mstart..ty.mstart + ty.mcount {\n                let mem = m.members[i];\n                b.push_fmt(f\" {mem.name}: \");\n                m.type_name(mem.ty, &b);\n                b.push_fmt(f\" @{mem.offset};\");\n            }\n");
        buf_str(out, c"            b.push_str(\" }\\n\");\n        }\n    }\n    for g in 0..m.globals.len() {\n        let gl = m.globals[g];\n        b.push_fmt(f\"global {g} {gl.name}: {ir::space_name(gl.space)}\");\n        if gl.space == ir::SP_STORAGE {\n            b.push_str(if gl.access == ir::ACC_RW { \" read_write\" } else { \" read\" });\n        }\n        b.push(' ');\n        m.type_name(gl.ty, &b);\n        if gl.group >= 0 {\n            b.push_fmt(f\" @group({gl.group}) @binding({gl.binding})\");\n        }\n        if gl.init >= 0 {\n            b.push_str(\" = \");\n            expr_text(m, m.consts, gl.init, &b);\n        }\n        b.push('\\n');\n    }\n    for e in 0..m.entries.len() {\n        let en = m.entries[e];\n        b.push_fmt(f\"entry {entry::stage_name(en.stage)} {en.name} = fn {en.func}\");\n        if en.stage == ir::STAGE_COMPUTE {\n            b.push_fmt(f\" workgroup_size({en.wg[0]}, {en.wg[1]}, {en.wg[2]})\");\n        }\n        b.push('\\n');\n    }\n    for i in 0..m.functions.len() {\n        dump_fn(m, i, &b);\n    }\n}\n\nfn binding_text<A: Allocator>(bd: ir::Binding, b: inout Buf<A>) {\n    if bd.kind == ir::BIND_BUILTIN {\n        b.push_fmt(f\" @builtin({entry::builtin_name(bd.value)})\");\n    } else if bd.kind == ir::BIND_LOCATION {\n        b.push_fmt(f\" @location({bd.value})\");\n        if bd.interp == ir::INTERP_FLAT {\n            b.push_str(\" @interpolate(flat)\");\n        }\n    }\n}\n\nfn dump_fn<A: Allocator>(m: Module, h: i64, b: inout Buf<A>) {\n    let f = m.functions[h];\n    b.push_fmt(f\"fn {h} {f.name}(\");\n    for i in 0..f.params.len() {\n        if i > 0 {\n            b.push_str(\", \");\n        }\n        b.push_fmt(f\"{f.params[i].name}: \");\n        m.type_name(f.params[i].ty, &b);\n        binding_text(f.params[i].binding, &b);\n    }\n    b.push_str(\") -> \");\n    m.type_name(f.result, &b);\n    binding_text(f.result_binding, &b);\n    b.push('\\n');\n    for i in 0..f.locals.len() {\n");
        buf_str(out, c"        b.push_fmt(f\"  local {i} {f.locals[i].name}: \");\n        m.type_name(f.locals[i].ty, &b);\n        b.push('\\n');\n    }\n    for e in 0..f.exprs.len() {\n        b.push_fmt(f\"  e{e}: \");\n        m.type_name(f.exprs[e].ty, &b);\n        b.push_str(\" = \");\n        expr_text(m, f, e, &b);\n        if f.names[e].len > 0 {\n            b.push_fmt(f\"  // {f.names[e]}\");\n        }\n        b.push('\\n');\n    }\n    if f.body >= 0 {\n        block_text(m, f, f.body, 1, &b);\n    }\n}\n\nfn indent<A: Allocator>(n: i64, b: inout Buf<A>) {\n    for _ in 0..n {\n        b.push_str(\"  \");\n    }\n}\n\nfn block_text<A: Allocator>(m: Module, f: Function, blk: i64, depth: i64, b: inout Buf<A>) {\n    let bl = f.blocks[blk];\n    for i in bl.start..bl.start + bl.count {\n        stmt_text(m, f, f.items[i], depth, &b);\n    }\n}\n\nfn stmt_text<A: Allocator>(m: Module, f: Function, s: i64, depth: i64, b: inout Buf<A>) {\n    let st = f.stmts[s];\n    indent(depth, &b);\n    if st.op == S_EMIT {\n        b.push_fmt(f\"emit e{st.a}..e{st.b}\\n\");\n    } else if st.op == S_BLOCK {\n        b.push_str(\"block\\n\");\n        block_text(m, f, st.a, depth + 1, &b);\n    } else if st.op == S_IF {\n        b.push_fmt(f\"if e{st.a}\\n\");\n        block_text(m, f, st.b, depth + 1, &b);\n        if f.blocks[st.c].count > 0 {\n            indent(depth, &b);\n            b.push_str(\"else\\n\");\n            block_text(m, f, st.c, depth + 1, &b);\n        }\n    } else if st.op == S_SWITCH {\n        b.push_fmt(f\"switch e{st.a}\\n\");\n        for i in st.b..st.b + st.c {\n            let c = f.cases[i];\n            indent(depth, &b);\n            b.push_str(\"case\");\n            for k in c.vstart..c.vstart + c.vcount {\n                b.push_fmt(f\" {f.vals[k]}\");\n            }\n            if c.is_default {\n                b.push_str(\" default\");\n            }\n            b.push('\\n');\n            block_text(m, f, c.body, depth + 1, &b);\n        }\n");
        buf_str(out, c"    } else if st.op == S_LOOP {\n        b.push_str(\"loop\\n\");\n        block_text(m, f, st.a, depth + 1, &b);\n        if f.blocks[st.b].count > 0 || st.c >= 0 {\n            indent(depth, &b);\n            b.push_str(\"continuing\\n\");\n            block_text(m, f, st.b, depth + 1, &b);\n            if st.c >= 0 {\n                indent(depth + 1, &b);\n                b.push_fmt(f\"break if e{st.c}\\n\");\n            }\n        }\n    } else if st.op == S_BREAK {\n        b.push_str(\"break\\n\");\n    } else if st.op == S_CONTINUE {\n        b.push_str(\"continue\\n\");\n    } else if st.op == S_RETURN {\n        if st.a >= 0 {\n            b.push_fmt(f\"return e{st.a}\\n\");\n        } else {\n            b.push_str(\"return\\n\");\n        }\n    } else if st.op == S_KILL {\n        b.push_str(\"discard\\n\");\n    } else if st.op == S_BARRIER {\n        b.push_str(if st.a == ir::BARRIER_WORKGROUP { \"barrier workgroup\\n\" }\n            else { \"barrier storage\\n\" });\n    } else if st.op == S_STORE {\n        b.push_fmt(f\"store e{st.a} <- e{st.b}\\n\");\n    } else if st.op == S_CALL {\n        if st.d >= 0 {\n            b.push_fmt(f\"e{st.d} = \");\n        }\n        b.push_fmt(f\"call fn {st.a}(\");\n        for i in st.b..st.b + st.c {\n            if i > st.b {\n                b.push_str(\", \");\n            }\n            b.push_fmt(f\"e{f.args[i]}\");\n        }\n        b.push_str(\")\\n\");\n    } else if st.op == S_ATOMIC {\n        if st.d >= 0 {\n            b.push_fmt(f\"e{st.d} = \");\n        }\n        b.push_fmt(f\"atomic {ATOM[st.b]} e{st.a}\");\n        if st.e >= 0 {\n            b.push_fmt(f\" cmp e{st.e}\");\n        }\n        if st.c >= 0 {\n            b.push_fmt(f\" e{st.c}\");\n        }\n        b.push('\\n');\n    } else if st.op == S_IMAGE_STORE {\n        b.push_fmt(f\"image_store e{st.a} at e{st.b} <- e{st.c}\\n\");\n    } else if st.op == S_WG_UNIFORM_LOAD {\n");
        buf_str(out, c"        b.push_fmt(f\"e{st.b} = workgroup_uniform_load e{st.a}\\n\");\n    }\n}\n\npub fn expr_text<A: Allocator>(m: Module, f: Function, e: i64, b: inout Buf<A>) {\n    let x = f.exprs[e];\n    let op = x.op;\n    if op == E_LITERAL {\n        let sk = m.types[x.ty].scalar;\n        if sk == SK_BOOL {\n            b.push_str(if x.a != 0 { \"true\" } else { \"false\" });\n        } else if sk == SK_F32 {\n            b.push_fmt(f\"{bits_f32(x.a as u32)}\");\n        } else if sk == SK_I32 {\n            b.push_fmt(f\"{x.a as u32 as i32}i\");\n        } else {\n            b.push_fmt(f\"{x.a}u\");\n        }\n    } else if op == E_ZERO {\n        b.push_str(\"zero\");\n    } else if op == E_COMPOSE {\n        b.push_str(\"compose(\");\n        args_text(f, x.a, x.b, &b);\n        b.push(')');\n    } else if op == E_SPLAT {\n        b.push_fmt(f\"splat(e{x.a})\");\n    } else if op == E_SWIZZLE {\n        b.push_fmt(f\"e{x.a}.\");\n        for i in 0..x.c {\n            b.push(\"xyzw\"[(x.b >> (2 * i)) & 3]);\n        }\n    } else if op == E_ACCESS {\n        b.push_fmt(f\"e{x.a}[e{x.b}] check {CK[x.c]}\");\n        if x.c == ir::CK_CLAMP {\n            b.push_fmt(f\" {x.d}\");\n        }\n    } else if op == E_ACCESS_INDEX {\n        b.push_fmt(f\"e{x.a}.{x.b}\");\n    } else if op == E_ARG {\n        b.push_fmt(f\"arg {x.a}\");\n    } else if op == E_GLOBAL {\n        b.push_fmt(f\"global {x.a}\");\n    } else if op == E_LOCAL {\n        b.push_fmt(f\"local {x.a}\");\n    } else if op == E_LOAD {\n        b.push_fmt(f\"load e{x.a}\");\n    } else if op == E_UNARY {\n        b.push_fmt(f\"{UN[x.a]} e{x.b}\");\n    } else if op == E_BINARY {\n        b.push_fmt(f\"{BIN[x.a]} e{x.b} e{x.c}\");\n    } else if op == E_SELECT {\n        b.push_fmt(f\"select e{x.a} ? e{x.b} : e{x.c}\");\n    } else if op == E_MATH {\n        b.push_str(names::PREDECLARED[names::K_MATH_FIRST + x.a]);\n        b.push('(');\n        args_text(f, x.b, x.c, &b);\n        b.push(')');\n");
        buf_str(out, c"    } else if op == E_CONVERT {\n        b.push_fmt(f\"convert e{x.a}\");\n    } else if op == E_BITCAST {\n        b.push_fmt(f\"bitcast e{x.a}\");\n    } else if op == E_CALL_RESULT {\n        b.push_str(\"call result\");\n    } else if op == E_ATOMIC_RESULT {\n        b.push_str(\"atomic result\");\n    } else if op == E_WG_UNIFORM_RESULT {\n        b.push_str(\"workgroup uniform load result\");\n    } else if op == E_ARRAY_LENGTH {\n        b.push_fmt(f\"array_length global {x.a} member {x.b} offset {x.c} stride {x.d}\");\n    } else if op == E_DERIVATIVE {\n        b.push_fmt(f\"derivative {x.a} e{x.b}\");\n    } else if op == E_IMAGE_SAMPLE {\n        b.push_fmt(f\"sample {x.d & 255} e{x.a} e{x.b} (\");\n        args_text(f, x.c, x.d >> 8, &b);\n        b.push(')');\n    } else if op == E_IMAGE_LOAD {\n        b.push_fmt(f\"image_load e{x.a} (\");\n        args_text(f, x.c, x.d, &b);\n        b.push(')');\n    } else if op == E_IMAGE_QUERY {\n        b.push_fmt(f\"image_query {x.b} e{x.a}\");\n        if x.c >= 0 {\n            b.push_fmt(f\" level e{x.c}\");\n        }\n    }\n}\n\nfn args_text<A: Allocator>(f: Function, start: i64, n: i64, b: inout Buf<A>) {\n    for i in start..start + n {\n        if i > start {\n            b.push_str(\", \");\n        }\n        b.push_fmt(f\"e{f.args[i]}\");\n    }\n}\n// ---- end mod std::gpu::wgsl::dump ----\n}\n// ---- mod std::gpu::wgsl::job ----\npub mod job {\n// ---- Shader compiler implementation, job (0.22) ----\n// Jobs: a compute dispatch with its buffers, run by the interpreter\n// (`wgslc run`) or turned into the input of tests/wgsl/metalrun\n// (`wgslc metal-job`), whose output has the same form, so the two compare\n// as text. A job file:\n//\n//   entry NAME                  the entry point (default: the first compute one)\n//   dispatch X Y Z              workgroups\n//   buffer G B BYTES [random SEED | WORD...]   a binding's size and contents\n//\n");
        buf_str(out, c"// Words are decimal or 0x hex; missing words are zero. The output is each\n// buffer, in the job's order: `buffer G B`, then its words in hex.\n\nuse api::{fill_error, new_error};\nuse front::new_front;\nuse interp::new_interp;\nuse ir::{Module, STAGE_COMPUTE, V};\nuse std::{Allocator, Buf, Option, Scanner, ScopedArena, Vec, parse_int, split_whitespace_in};\nuse std::Option::{None, Some};\nuse std::Result::{Err, Ok};\n\npub struct JobBuffer { group: i64, binding: i64, bytes: i64, words: V<u32> }\n\n// A texture: its format (`rgba8unorm`, `r8unorm`, `rgba32float`,\n// `rgba32uint`) and texels as words (rgba8unorm: one a texel; r8unorm:\n// four texels a word; the 32-bit formats: four words a texel).\npub struct JobTexture { group: i64, binding: i64, format: [u8], w: i64, h: i64, words: V<u32> }\n\n// call_n >= 0: a call job (`call ENTRY N`): the entry runs once per input\n// record (`input BYTES ...`), its results printed as `buffer -2 0`.\npub struct Job {\n    entry: [u8], groups: [i64; 3], buffers: V<JobBuffer>, call_n: i64, input: V<u32>,\n    textures: V<JobTexture>\n}\n\nfn xorshift(s: inout u32) -> u32 {\n    var x = s;\n    x = x ^ (x << 13);\n    x = x ^ (x >> 17);\n    x = x ^ (x << 5);\n    s = x;\n    x\n}\n\n// A job word: decimal, 0x hex, or a float with a point (its f32 bits).\nfn parse_word(t: [u8]) -> Option<u32> {\n    for i in 0..t.len {\n        if t[i] == '.' {\n            return match std::num::parse_f64(t) {\n                Ok(v) => Some(ir::f32_bits(v as f32)),\n                Err(_) => None,\n            };\n        }\n    }\n    if t.len > 2 && t[0] == '0' && (t[1] == 'x' || t[1] == 'X') {\n        var v: u64 = 0;\n        for i in 2..t.len {\n            let c = t[i];\n            let d = if c >= '0' && c <= '9' { c - '0' }\n                else if c >= 'a' && c <= 'f' { c - 'a' + 10 }\n                else if c >= 'A' && c <= 'F' { c - 'A' + 10 } else { return None; };\n            v = v * 16 + d as u64;\n        }\n");
        buf_str(out, c"        return Some(v as u32);\n    }\n    match parse_int(t) {\n        Ok(v) => Some(v as u32),\n        Err(_) => None,\n    }\n}\n\n// words[from ..]: `random SEED` or the words themselves.\nfn fill_words<B: Allocator>(v: inout V<u32>, words: Vec<[u8], ScopedArena>, from: i64,\n    err: inout Buf<B>) -> bool {\n    if words.len() >= from + 2 && words[from] == \"random\" {\n        var s = parse_word(words[from + 1]).unwrap_or(1);\n        if s == 0 {\n            s = 1;\n        }\n        for k in 0..v.len() {\n            v[k] = xorshift(&s);\n        }\n        return true;\n    }\n    for k in from..words.len() {\n        if k - from >= v.len() {\n            break;\n        }\n        match parse_word(words[k]) {\n            Some(x) => v[k - from] = x,\n            None => {\n                err.push_fmt(f\"not a word: '{words[k]}'\");\n                return false;\n            }\n        }\n    }\n    true\n}\n\n// A job texture's texels as the interpreter holds them: four words each,\n// f32 bits for the unorm and float formats (unorm: n / 255).\npub fn texels(t: JobTexture, a: ScopedArena) -> V<u32> {\n    let n = t.w * t.h;\n    var v: V<u32> = Vec::filled_in(4 * n, 0u32, a);\n    for i in 0..n {\n        if t.format == \"rgba8unorm\" {\n            let x = t.words[i];\n            for c in 0..4 {\n                let b = (x >> (8 * c) as u32) & 255;\n                v[4 * i + c] = ir::f32_bits(b as f32 / 255.0);\n            }\n        } else if t.format == \"r8unorm\" {\n            let b = (t.words[i / 4] >> (8 * (i % 4)) as u32) & 255;\n            v[4 * i] = ir::f32_bits(b as f32 / 255.0);\n            v[4 * i + 3] = ir::f32_bits(1.0);\n        } else {\n            for c in 0..4 {\n                v[4 * i + c] = t.words[4 * i + c];\n            }\n        }\n    }\n    v\n}\n\npub fn parse_job<B: Allocator>(text: [u8], a: ScopedArena, err: inout Buf<B>) -> Option<Job> {\n    var job = Job {\n");
        buf_str(out, c"        entry: \"\", groups: [1, 1, 1], buffers: Vec::new_in(a), call_n: -1, input: Vec::new_in(a),\n        textures: Vec::new_in(a)\n    };\n    var sc = Scanner::new(text);\n    while let Some(line) = sc.next_line() {\n        let words = split_whitespace_in(line, a);\n        if words.len() == 0 || words[0][0] == '#' {\n            continue;\n        }\n        let kw = words[0];\n        if kw == \"entry\" && words.len() == 2 {\n            job.entry = words[1];\n        } else if kw == \"dispatch\" && words.len() == 4 {\n            for k in 0..3 {\n                job.groups[k] = parse_int(words[k + 1]).unwrap_or(1);\n            }\n        } else if kw == \"call\" && words.len() == 3 {\n            job.entry = words[1];\n            job.call_n = parse_int(words[2]).unwrap_or(0);\n        } else if kw == \"input\" && words.len() >= 2 {\n            let bytes = parse_int(words[1]).unwrap_or(0);\n            job.input = Vec::filled_in(bytes / 4, 0u32, a);\n            if !fill_words(&job.input, words, 2, &err) {\n                return None;\n            }\n        } else if kw == \"texture\" && words.len() >= 6 {\n            let w = parse_int(words[4]).unwrap_or(0);\n            let h = parse_int(words[5]).unwrap_or(0);\n            let fm = words[3];\n            let n = if fm == \"rgba8unorm\" { w * h } else if fm == \"r8unorm\" { (w * h + 3) / 4 }\n                else if fm == \"rgba32float\" || fm == \"rgba32uint\" { 4 * w * h } else { -1 };\n            if n < 0 || w <= 0 || h <= 0 {\n                err.push_fmt(f\"a texture is FORMAT W H with a format of rgba8unorm, r8unorm, rgba32float, rgba32uint: {line}\");\n                return None;\n            }\n            var t = JobTexture {\n                group: parse_int(words[1]).unwrap_or(0), binding: parse_int(words[2]).unwrap_or(0),\n                format: fm, w: w, h: h, words: Vec::filled_in(n, 0u32, a)\n            };\n            if !fill_words(&t.words, words, 6, &err) {\n");
        buf_str(out, c"                return None;\n            }\n            job.textures.push(t);\n        } else if kw == \"buffer\" && words.len() >= 4 {\n            let bytes = parse_int(words[3]).unwrap_or(0);\n            if bytes <= 0 || bytes % 4 != 0 {\n                err.push_fmt(f\"a buffer's size is a positive multiple of 4: {line}\");\n                return None;\n            }\n            var b = JobBuffer {\n                group: parse_int(words[1]).unwrap_or(0), binding: parse_int(words[2]).unwrap_or(0),\n                bytes: bytes, words: Vec::filled_in(bytes / 4, 0u32, a)\n            };\n            if words.len() >= 6 && words[4] == \"random\" {\n                var s = parse_word(words[5]).unwrap_or(1);\n                if s == 0 {\n                    s = 1;\n                }\n                for k in 0..bytes / 4 {\n                    b.words[k] = xorshift(&s);\n                }\n            } else {\n                for k in 4..words.len() {\n                    if k - 4 >= bytes / 4 {\n                        break;\n                    }\n                    match parse_word(words[k]) {\n                        Some(w) => b.words[k - 4] = w,\n                        None => {\n                            err.push_fmt(f\"not a word: '{words[k]}'\");\n                            return None;\n                        }\n                    }\n                }\n            }\n            job.buffers.push(b);\n        } else {\n            err.push_fmt(f\"cannot read this job line: {line}\");\n            return None;\n        }\n    }\n    Some(job)\n}\n\n// The entry point a job names (or the first compute one), or -1.\npub fn find_entry(m: Module, name: [u8]) -> i64 {\n    for e in 0..m.entries.len() {\n        if m.entries[e].stage == STAGE_COMPUTE && (name.len == 0 || m.entries[e].name == name) {\n            return e;\n        }\n    }\n    -1\n}\n\n// The entry point of any stage named `name`, or -1.\n");
        buf_str(out, c"pub fn find_any_entry(m: Module, name: [u8]) -> i64 {\n    for e in 0..m.entries.len() {\n        if m.entries[e].name == name {\n            return e;\n        }\n    }\n    -1\n}\n\n// The global bound at (group, binding), or -1.\npub fn find_global(m: Module, g: i64, b: i64) -> i64 {\n    for i in 0..m.globals.len() {\n        if m.globals[i].group == g && m.globals[i].binding == b {\n            return i;\n        }\n    }\n    -1\n}\n\npub fn print_words<A: Allocator>(group: i64, w: V<u32>, out: inout Buf<A>) {\n    out.push_fmt(f\"buffer {group} 0\\n\");\n    for k in 0..w.len() {\n        out.push_fmt(f\"{w[k]:08x}\");\n        out.push(if k % 8 == 7 || k == w.len() - 1 { '\\n' } else { ' ' });\n    }\n}\n\n// Each job buffer's words: words[idx[i]] for the job's i-th buffer.\npub fn print_buffers<A: Allocator>(job: Job, words: V<V<u32>>, idx: V<i64>, out: inout Buf<A>) {\n    for i in 0..job.buffers.len() {\n        let b = job.buffers[i];\n        out.push_fmt(f\"buffer {b.group} {b.binding}\\n\");\n        let w = words[idx[i]];\n        for k in 0..w.len() {\n            out.push_fmt(f\"{w[k]:08x}\");\n            out.push(if k % 8 == 7 || k == w.len() - 1 { '\\n' } else { ' ' });\n        }\n    }\n}\n// ---- end mod std::gpu::wgsl::job ----\n}\n// ---- mod std::gpu::wgsl::api ----\npub mod api {\n// ---- Shader compiler implementation, translate (0.22) ----\n// The translator's entry: WGSL source to an output (the IR as text, MSL,\n// SPIR-V), on an arena of its own (docs/design/gpu.md §2.10: everything a\n// translation allocates is freed when it ends; no io, no globals).\n\nuse front::new_front;\nuse std::{Buf, Gpa, ScopedArena, Vec, arena_scope};\n\npub const TARGET_CHECK: i64 = 0;\npub const TARGET_IR: i64 = 1;\npub const TARGET_MSL: i64 = 2;\npub const TARGET_SPIRV: i64 = 3;\n\npub struct Options {\n    target: i64,\n    // bench only: no bounds checks (the cost of the checks is measured\n    // against this; never shipped)\n    no_checks: bool,\n");
        buf_str(out, c"    // drop checks proven unneeded by a dominating loop condition\n    prove: bool,\n}\n\npub fn options(target: i64) -> Options { Options { target: target, no_checks: false, prove: true } }\n\n// ---- Shader compiler implementation, translate: Reflection (0.22) ----\n\n// What a binding holds (WebGPU's binding types).\npub const BK_UNIFORM: u8 = 0;\npub const BK_STORAGE: u8 = 1;\npub const BK_READ_ONLY_STORAGE: u8 = 2;\npub const BK_TEXTURE: u8 = 3;\npub const BK_STORAGE_TEXTURE: u8 = 4;\npub const BK_SAMPLER: u8 = 5;\npub const BK_COMPARISON_SAMPLER: u8 = 6;\n\n// One `@group(g) @binding(b)`: its kind, the smallest buffer it accepts\n// (a runtime-sized array counts one element), and, for the target, its\n// slot in each stage (vertex, fragment, compute; -1: not used there).\npub struct BindingInfo {\n    group: i64, binding: i64, kind: u8, min_size: i64, slots: [i64; 3], global: i64\n}\n\n// An entry point: its WGSL name, its name in the output, its stage\n// (ir::STAGE_*), a compute entry's workgroup size, and the slot of the\n// sizes buffer it needs (-1: none; Metal only).\npub struct EntryInfo {\n    name: Buf, target_name: Buf, stage: u8, workgroup: [i64; 3], sizes_slot: i64\n}\n\n// A vertex entry's input at @location(n): its scalar (ir::SK_*) and\n// component count, as WebGPU's vertex formats (`float32x3`: f32, 3).\npub struct InputInfo { location: i64, scalar: u8, components: i64 }\n\n// A translated module's interface, in (group, binding) order; `sizes`\n// lists the runtime-sized storage bindings (indices into `bindings`) in\n// the order of the sizes buffer.\npub struct Reflection {\n    entries: Vec<EntryInfo>, bindings: Vec<BindingInfo>, inputs: Vec<InputInfo>, sizes: Vec<i64>\n}\n\npub fn new_reflection(gpa: Gpa) -> Reflection {\n    Reflection {\n        entries: Vec::new_in(gpa), bindings: Vec::new_in(gpa), inputs: Vec::new_in(gpa),\n        sizes: Vec::new_in(gpa)\n    }\n}\n\n// The target-neutral part of the reflection, from the IR.\n");
        buf_str(out, c"pub fn reflect(m: ir::Module, a: ScopedArena, refl: inout Reflection, gpa: Gpa) {\n    refl.entries.clear();\n    refl.bindings.clear();\n    refl.inputs.clear();\n    refl.sizes.clear();\n    for e in 0..m.entries.len() {\n        let en = m.entries[e];\n        var name = Buf::new_in(gpa);\n        name.push_str(en.name);\n        refl.entries.push(EntryInfo {\n            name: name, target_name: Buf::new_in(gpa), stage: en.stage, workgroup: en.wg,\n            sizes_slot: -1\n        });\n        if en.stage == ir::STAGE_VERTEX {\n            let f = m.functions[en.func];\n            for k in 0..f.params.len() {\n                let pt = m.types[f.params[k].ty];\n                if pt.kind == ir::TK_STRUCT && f.params[k].binding.kind == ir::BIND_NONE {\n                    for j in pt.mstart..pt.mstart + pt.mcount {\n                        let mem = m.members[j];\n                        if mem.binding.kind == ir::BIND_LOCATION {\n                            refl.inputs.push(InputInfo {\n                                location: mem.binding.value, scalar: m.types[mem.ty].scalar,\n                                components: m.width_of(mem.ty)\n                            });\n                        }\n                    }\n                } else if f.params[k].binding.kind == ir::BIND_LOCATION {\n                    refl.inputs.push(InputInfo {\n                        location: f.params[k].binding.value, scalar: pt.scalar,\n                        components: m.width_of(f.params[k].ty)\n                    });\n                }\n            }\n        }\n    }\n    let order = msl::binding_order(m, a);\n    for k in 0..order.len() {\n        let g = order[k];\n        let gl = m.globals[g];\n        if gl.group < 0 {\n            continue;\n        }\n        let t = m.types[gl.ty];\n        let kind = if gl.space == ir::SP_UNIFORM {\n            BK_UNIFORM\n        } else if gl.space == ir::SP_STORAGE {\n");
        buf_str(out, c"            if gl.access == ir::ACC_RW { BK_STORAGE } else { BK_READ_ONLY_STORAGE }\n        } else if t.kind == ir::TK_TEXTURE {\n            if t.n == ir::TEX_STORAGE_2D { BK_STORAGE_TEXTURE } else { BK_TEXTURE }\n        } else if t.n == 1 {\n            BK_COMPARISON_SAMPLER\n        } else {\n            BK_SAMPLER\n        };\n        let min = if gl.space == ir::SP_UNIFORM || gl.space == ir::SP_STORAGE { t.size } else { 0 };\n        if gl.space == ir::SP_STORAGE && m.is_runtime_sized(gl.ty) {\n            refl.sizes.push(refl.bindings.len());\n        }\n        refl.bindings.push(BindingInfo {\n            group: gl.group, binding: gl.binding, kind: kind, min_size: min, slots: [-1, -1, -1],\n            global: g\n        });\n    }\n}\n\n// The sizes buffer (Metal; the bounds checks of runtime-sized arrays): an\n// entry point whose `sizes_slot` is >= 0 reads one u32 per binding of\n// `refl.sizes`, in that order, the bytes the buffer bound there exposes\n// (its size minus the binding's offset, or the binding's size when one is\n// given), and the backend gives them with setBytes(words, 4 * len,\n// sizes_slot) before each dispatch or draw, in that entry's stage. `bound`\n// says it for a (group, binding), 0 when nothing is bound. A runtime-sized\n// array then has (bytes - its offset in the binding) / stride elements;\n// past them a load reads zero and a store is skipped.\npub fn sizes_words<F: FnMut(i64, i64) -> i64>(refl: Reflection, bound: F, out: inout Vec<u32>) {\n    var f = bound;\n    out.clear();\n    for i in 0..refl.sizes.len() {\n        let b = refl.bindings[refl.sizes[i]];\n        let n = f(b.group, b.binding);\n        out.push(if n < 0 { 0 } else if n > 4294967295 { 4294967295u32 } else { n as u32 });\n    }\n}\n\n// A shader the translator rejects: its first error.\npub struct ShaderError { code: [u8], pos: i64, line: i64, col: i64, msg: Buf, help: Buf }\n\npub fn new_error(gpa: Gpa) -> ShaderError {\n");
        buf_str(out, c"    ShaderError { code: \"\", pos: 0, line: 0, col: 0, msg: Buf::new_in(gpa), help: Buf::new_in(gpa) }\n}\n\nimpl ShaderError {\n    pub fn free(inout self) {\n        self.msg.free();\n        self.help.free();\n    }\n}\n\n// The 1-based line and column of byte `pos`.\npub fn line_col(src: [u8], pos: i64) -> (i64, i64) {\n    var line = 1;\n    var col = 1;\n    let end = if pos < src.len { pos } else { src.len };\n    for i in 0..end {\n        if src[i] == '\\n' {\n            line += 1;\n            col = 1;\n        } else {\n            col += 1;\n        }\n    }\n    (line, col)\n}\n\npub fn fill_error(fr: front::Front, err: inout ShaderError) {\n    err.code = fr.err_code;\n    err.pos = fr.err_pos;\n    let (l, c) = line_col(fr.src, fr.err_pos);\n    err.line = l;\n    err.col = c;\n    err.msg.clear();\n    err.msg.push_str(fr.emsg.as_slice());\n    err.help.clear();\n    err.help.push_str(fr.ehelp.as_slice());\n}\n\n// Translates src; the output is appended to `out` (SPIR-V: its words,\n// little-endian). False, with err filled, when the shader is rejected.\npub fn translate(src: [u8], opts: Options, out: inout Buf, refl: inout Reflection,\n    err: inout ShaderError, gpa: Gpa) -> bool {\n    // (0.20: the closure reaches out, refl and err through their addresses:\n    // a closure given to arena_scope's let F cannot capture an inout\n    // parameter yet; they outlive it)\n    let po = &out as *Buf;\n    let pr = &refl as *Reflection;\n    let pe = &err as *ShaderError;\n    arena_scope(gpa, |a| -> bool {\n        var fr = new_front(src, a);\n        fr.module();\n        if !fr.failed {\n            uniformity::check(fr);\n        }\n        if fr.failed {\n            unsafe { fill_error(fr, &*pe); }\n            return false;\n        }\n        if !opts.no_checks {\n            bounds::insert_checks(&fr.m, a, opts.prove);\n        } else {\n            bounds::insert_no_checks(&fr.m);\n        }\n        unsafe { reflect(fr.m, a, &*pr, gpa); }\n");
        buf_str(out, c"        if opts.target == TARGET_IR {\n            unsafe { dump::dump(fr.m, &*po); }\n        } else if opts.target == TARGET_MSL {\n            unsafe { msl::write(fr.m, a, &*po, &*pr); }\n        } else if opts.target == TARGET_SPIRV {\n            unsafe { spirv::write(fr.m, a, &*po); }\n        }\n        true\n    })\n}\n// ---- end mod std::gpu::wgsl::api ----\n}\n// ---- end mod std::gpu::wgsl ----\n}\n// ---- end mod std::gpu ----\n}\n// ---- mod std::string ----\npub mod string {\n// std::string (0.20, docs/design/collections-text-io.md §2.5, task B5):\n// `str`, the view of UTF-8 text, and `String`, UTF-8 text that owns its\n// bytes, with Rust's names. A `str` is std::str's `[u8]` known to be\n// UTF-8: the compiler takes string literals as one where a `str` goes,\n// `&str` as `str`, and lets a `str` go where `[u8]` does; bytes become a\n// `str` only checked (`str::from_utf8`), outside std. What allocates takes\n// an allocator, the `_in` forms; the Rust forms (`to_uppercase()`,\n// `String::new()`) are errors naming them. A code point is a `u32` until\n// `char` exists.\n//\n// Searching takes a Pattern: a `str` or `[u8]` (a substring), a `u8` (an\n// ASCII byte: `','`) or a `u32` (a code point). Empty patterns match at\n// every char boundary, as Rust's do.\n\nuse std::{\n    Allocator, Ambient, Buf, Clone, Debug, Display, Eq, Fmt, Gpa, Hash, Iterator, Option, Ord,\n    ParseIntError, Result, Vec,\n};\nuse std::num::{ParseFloatError, parse_f32, parse_f64, parse_i64_radix, parse_u64_radix};\nuse std::str::{\n    Utf8Error, encode_utf8, is_char_boundary, lossy_next, memchr, memrchr, next_code_point,\n    next_code_point_reverse, utf8_char_width, validate_utf8,\n};\nuse std::unicode::{Graphemes, graphemes, is_whitespace, str_width, to_lower, to_upper};\n\n// ---- Text: str (0.20) ----\n\n// UTF-8 text, a view: `[u8]` whose bytes are UTF-8 (0.20). String literals\n// are `str` where one goes; `&str` is `str`; a `str` goes where `[u8]` does,\n");
        buf_str(out, c"// for free; bytes become one through `str::from_utf8(b)?`.\npub type str = distinct [u8];\n\n// Whether code point cp is White_Space (ASCII first).\n#[inline]\nfn is_space_cp(cp: u32) -> bool {\n    if cp < 0x80 {\n        return cp == 0x20 || (cp >= 0x09 && cp <= 0x0d);\n    }\n    is_whitespace(cp)\n}\n\n// The code point that starts at byte i of s (UTF-8), and its length.\n#[inline]\nfn cp_at(s: [u8], i: i64) -> (u32, i64) {\n    let b = s[i];\n    if b < 0x80 {\n        return (b as u32, 1);\n    }\n    var p = i;\n    let cp = lossy_next(s, &p);\n    (cp, p - i)\n}\n\n// The code point that ends at byte `end` of s, and its length.\n#[inline]\nfn cp_before(s: [u8], end: i64) -> (u32, i64) {\n    let b = s[end - 1];\n    if b < 0x80 {\n        return (b as u32, 1);\n    }\n    var start = end - 1;\n    while start > 0 && end - start < 4 && (s[start] & 0xc0) == 0x80 {\n        start -= 1;\n    }\n    var p = start;\n    let cp = lossy_next(s, &p);\n    if p != end {\n        return (0xfffd, 1);\n    }\n    (cp, end - start)\n}\n\n// The index of the first byte b in s at or after `from`, or -1: a plain\n// loop over a short span (a field, a line), std::str's memchr (NEON) over\n// a long one.\n#[inline]\nfn find_byte(b: u8, s: [u8], from: i64) -> i64 {\n    var i = from;\n    let short = if s.len - from < 32 { s.len } else { from + 32 };\n    while i < short {\n        if s[i] == b {\n            return i;\n        }\n        i += 1;\n    }\n    if i >= s.len {\n        return -1;\n    }\n    match memchr(b, s[i..]) {\n        Option::Some(k) => i + k,\n        Option::None => -1,\n    }\n}\n\n// Where `needle` first occurs in s at or after `from`, or -1.\nfn find_bytes(s: [u8], needle: [u8], from: i64) -> i64 {\n    let n = needle.len;\n    if n == 0 {\n        return if from <= s.len { from } else { -1 };\n    }\n    let first = needle[0];\n    if s.len < n {\n        return -1;\n    }\n    let hay = s[..s.len - n + 1];\n    var i = from;\n");
        buf_str(out, c"    while i < hay.len {\n        let at = find_byte(first, hay, i);\n        if at < 0 {\n            return -1;\n        }\n        var same = true;\n        for j in 1..n {\n            if s[at + j] != needle[j] {\n                same = false;\n                break;\n            }\n        }\n        if same {\n            return at;\n        }\n        i = at + 1;\n    }\n    -1\n}\n\n// Where `needle` last occurs in s[..to], or -1.\nfn rfind_bytes(s: [u8], needle: [u8], to: i64) -> i64 {\n    let n = needle.len;\n    if n == 0 {\n        return to;\n    }\n    if n > to {\n        return -1;\n    }\n    let last = needle[n - 1];\n    var end = to;\n    while end >= n {\n        match memrchr(last, s[n - 1..end]) {\n            Option::Some(k) => {\n                let at = k;\n                var same = true;\n                for j in 0..n - 1 {\n                    if s[at + j] != needle[j] {\n                        same = false;\n                        break;\n                    }\n                }\n                if same {\n                    return at;\n                }\n                end = at + n - 1;\n            }\n            Option::None => return -1,\n        }\n    }\n    -1\n}\n\n// What `split`, `find`, `trim_matches` and their kin look for: a `str` or\n// `[u8]` (a substring), a `u8` (a byte: `','`) or a `u32` (a code point).\npub trait Pattern {\n    // The first match in s at or after byte `from`: its start and end, or\n    // (-1, -1).\n    fn next_match(self, s: [u8], from: i64) -> (i64, i64);\n    // The last match in s[..to]: its start and end, or (-1, -1).\n    fn last_match(self, s: [u8], to: i64) -> (i64, i64);\n    // The length of a match at the start of s, or -1.\n    fn prefix_len(self, s: [u8]) -> i64;\n    // The length of a match at the end of s, or -1.\n    fn suffix_len(self, s: [u8]) -> i64;\n}\n\nimpl Pattern for [u8] {\n    fn next_match(self, s: [u8], from: i64) -> (i64, i64) {\n");
        buf_str(out, c"        let at = find_bytes(s, self, from);\n        if at < 0 { (-1, -1) } else { (at, at + self.len) }\n    }\n\n    fn last_match(self, s: [u8], to: i64) -> (i64, i64) {\n        let at = rfind_bytes(s, self, to);\n        if at < 0 { (-1, -1) } else { (at, at + self.len) }\n    }\n\n    fn prefix_len(self, s: [u8]) -> i64 {\n        let p = self;\n        if p.len <= s.len && s[..p.len] == p { p.len } else { -1 }\n    }\n\n    fn suffix_len(self, s: [u8]) -> i64 {\n        let p = self;\n        if p.len <= s.len && s[s.len - p.len..] == p { p.len } else { -1 }\n    }\n}\n\nimpl Pattern for str {\n    fn next_match(self, s: [u8], from: i64) -> (i64, i64) {\n        let p = self as [u8];\n        p.next_match(s, from)\n    }\n\n    fn last_match(self, s: [u8], to: i64) -> (i64, i64) {\n        let p = self as [u8];\n        p.last_match(s, to)\n    }\n\n    fn prefix_len(self, s: [u8]) -> i64 {\n        let p = self as [u8];\n        p.prefix_len(s)\n    }\n\n    fn suffix_len(self, s: [u8]) -> i64 {\n        let p = self as [u8];\n        p.suffix_len(s)\n    }\n}\n\nimpl Pattern for u8 {\n    fn next_match(self, s: [u8], from: i64) -> (i64, i64) {\n        let at = if from < s.len { find_byte(self, s, from) } else { -1 };\n        if at < 0 { (-1, -1) } else { (at, at + 1) }\n    }\n\n    fn last_match(self, s: [u8], to: i64) -> (i64, i64) {\n        match memrchr(self, s[..to]) {\n            Option::Some(k) => (k, k + 1),\n            Option::None => (-1, -1),\n        }\n    }\n\n    fn prefix_len(self, s: [u8]) -> i64 {\n        if s.len > 0 && s[0] == self { 1 } else { -1 }\n    }\n\n    fn suffix_len(self, s: [u8]) -> i64 {\n        if s.len > 0 && s[s.len - 1] == self { 1 } else { -1 }\n    }\n}\n\nimpl Pattern for u32 {\n    fn next_match(self, s: [u8], from: i64) -> (i64, i64) {\n        var buf: [u8; 4] = [0; 4];\n        let n = encode_utf8(self, &buf);\n        let p = buf[..n];\n        p.next_match(s, from)\n    }\n\n");
        buf_str(out, c"    fn last_match(self, s: [u8], to: i64) -> (i64, i64) {\n        var buf: [u8; 4] = [0; 4];\n        let n = encode_utf8(self, &buf);\n        let p = buf[..n];\n        p.last_match(s, to)\n    }\n\n    fn prefix_len(self, s: [u8]) -> i64 {\n        var buf: [u8; 4] = [0; 4];\n        let n = encode_utf8(self, &buf);\n        let p = buf[..n];\n        p.prefix_len(s)\n    }\n\n    fn suffix_len(self, s: [u8]) -> i64 {\n        var buf: [u8; 4] = [0; 4];\n        let n = encode_utf8(self, &buf);\n        let p = buf[..n];\n        p.suffix_len(s)\n    }\n}\n\nimpl str {\n    // The text of bytes b, when they are UTF-8 (Rust's `str::from_utf8`).\n    pub fn from_utf8(b: [u8]) -> Result<str, Utf8Error> {\n        match validate_utf8(b) {\n            Result::Ok(_) => Result::Ok(b as str),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n\n    // The text of bytes b, which must be UTF-8 (not checked: text that is\n    // not decodes as U+FFFD, never out of bounds).\n    pub unsafe fn from_utf8_unchecked(b: [u8]) -> str {\n        b as str\n    }\n\n    // The length in bytes.\n    #[inline]\n    pub fn len(self) -> i64 {\n        (self as [u8]).len\n    }\n\n    #[inline]\n    pub fn is_empty(self) -> bool {\n        (self as [u8]).len == 0\n    }\n\n    // Its bytes.\n    #[inline]\n    pub fn as_bytes(self) -> [u8] {\n        self as [u8]\n    }\n\n    // Whether byte index i starts a code point (or is the end).\n    pub fn is_char_boundary(self, i: i64) -> bool {\n        is_char_boundary(self as [u8], i)\n    }\n\n    // Whether every byte is ASCII.\n    pub fn is_ascii(self) -> bool {\n        let b = self as [u8];\n        for i in 0..b.len {\n            if b[i] >= 0x80 {\n                return false;\n            }\n        }\n        true\n    }\n\n    // The code points (u32), front to back; `.rev()` back to front.\n    #[inline]\n    pub fn chars(self) -> Chars {\n        let b = self as [u8];\n");
        buf_str(out, c"        Chars { s: b, front: 0, back: b.len }\n    }\n\n    // (byte index, code point) pairs.\n    #[inline]\n    pub fn char_indices(self) -> CharIndices {\n        CharIndices { s: self as [u8], pos: 0 }\n    }\n\n    // The bytes, as `as_bytes().iter()`.\n    #[inline]\n    pub fn bytes(self) -> std::SliceIter<u8> {\n        (self as [u8]).iter()\n    }\n\n    // The lines: split at '\\n', a '\\r' before it dropped; no last empty\n    // line after a final '\\n'.\n    #[inline]\n    pub fn lines(self) -> Lines {\n        Lines { s: self as [u8], pos: 0 }\n    }\n\n    // The pieces between matches of p.\n    #[inline]\n    pub fn split<P: Pattern>(self, p: sink P) -> Split<P> {\n        Split { s: self as [u8], start: 0, pos: 0, pat: p, left: -1, done: false }\n    }\n\n    // At most n pieces: the last is the rest.\n    #[inline]\n    pub fn splitn<P: Pattern>(self, n: i64, p: sink P) -> Split<P> {\n        Split { s: self as [u8], start: 0, pos: 0, pat: p, left: n, done: n <= 0 }\n    }\n\n    // The pieces between runs of whitespace (Unicode White_Space), none\n    // empty.\n    #[inline]\n    pub fn split_whitespace(self) -> SplitWhitespace {\n        SplitWhitespace { s: self as [u8], pos: 0, ascii: false }\n    }\n\n    // As split_whitespace, ASCII whitespace only.\n    #[inline]\n    pub fn split_ascii_whitespace(self) -> SplitWhitespace {\n        SplitWhitespace { s: self as [u8], pos: 0, ascii: true }\n    }\n\n    // The parts before and after the first match of p.\n    pub fn split_once<P: Pattern>(self, p: sink P) -> Option<(str, str)> {\n        let b = self as [u8];\n        let (a, e) = p.next_match(b, 0);\n        if a < 0 {\n            return Option::None;\n        }\n        Option::Some((b[..a] as str, b[e..] as str))\n    }\n\n    // The parts before and after the last match of p.\n    pub fn rsplit_once<P: Pattern>(self, p: sink P) -> Option<(str, str)> {\n        let b = self as [u8];\n        let (a, e) = p.last_match(b, b.len);\n");
        buf_str(out, c"        if a < 0 {\n            return Option::None;\n        }\n        Option::Some((b[..a] as str, b[e..] as str))\n    }\n\n    // The matches of p, front to back.\n    #[inline]\n    pub fn matches<P: Pattern>(self, p: sink P) -> Matches<P> {\n        Matches { s: self as [u8], pos: 0, pat: p }\n    }\n\n    // The byte index of the first match of p.\n    pub fn find<P: Pattern>(self, p: sink P) -> Option<i64> {\n        let (a, _) = p.next_match(self as [u8], 0);\n        if a < 0 { Option::None } else { Option::Some(a) }\n    }\n\n    // The byte index of the last match of p.\n    pub fn rfind<P: Pattern>(self, p: sink P) -> Option<i64> {\n        let b = self as [u8];\n        let (a, _) = p.last_match(b, b.len);\n        if a < 0 { Option::None } else { Option::Some(a) }\n    }\n\n    pub fn contains<P: Pattern>(self, p: sink P) -> bool {\n        let (a, _) = p.next_match(self as [u8], 0);\n        a >= 0\n    }\n\n    pub fn starts_with<P: Pattern>(self, p: sink P) -> bool {\n        p.prefix_len(self as [u8]) >= 0\n    }\n\n    pub fn ends_with<P: Pattern>(self, p: sink P) -> bool {\n        p.suffix_len(self as [u8]) >= 0\n    }\n\n    // Without a match of p at its start.\n    pub fn strip_prefix<P: Pattern>(self, p: sink P) -> Option<str> {\n        let b = self as [u8];\n        let n = p.prefix_len(b);\n        if n < 0 { Option::None } else { Option::Some(b[n..] as str) }\n    }\n\n    // Without a match of p at its end.\n    pub fn strip_suffix<P: Pattern>(self, p: sink P) -> Option<str> {\n        let b = self as [u8];\n        let n = p.suffix_len(b);\n        if n < 0 { Option::None } else { Option::Some(b[..b.len - n] as str) }\n    }\n\n    // Without whitespace (Unicode White_Space) at either end.\n    pub fn trim(self) -> str {\n        self.trim_start().trim_end()\n    }\n\n    pub fn trim_start(self) -> str {\n        let b = self as [u8];\n        var i = 0;\n        while i < b.len {\n            let (cp, n) = cp_at(b, i);\n");
        buf_str(out, c"            if !is_space_cp(cp) {\n                break;\n            }\n            i += n;\n        }\n        b[i..] as str\n    }\n\n    pub fn trim_end(self) -> str {\n        let b = self as [u8];\n        var end = b.len;\n        while end > 0 {\n            let (cp, n) = cp_before(b, end);\n            if !is_space_cp(cp) {\n                break;\n            }\n            end -= n;\n        }\n        b[..end] as str\n    }\n\n    // Without ASCII whitespace at either end.\n    pub fn trim_ascii(self) -> str {\n        let b = self as [u8];\n        var i = 0;\n        var end = b.len;\n        while i < end && is_space_cp(b[i] as u32) && b[i] < 0x80 {\n            i += 1;\n        }\n        while end > i && is_space_cp(b[end - 1] as u32) && b[end - 1] < 0x80 {\n            end -= 1;\n        }\n        b[i..end] as str\n    }\n\n    // Without the matches of p repeated at either end (an empty p: as it\n    // is).\n    pub fn trim_matches<P: Pattern>(self, p: sink P) -> str {\n        self.trim_start_matches(p).trim_end_matches(p)\n    }\n\n    pub fn trim_start_matches<P: Pattern>(self, p: sink P) -> str {\n        var b = self as [u8];\n        loop {\n            let n = p.prefix_len(b);\n            if n <= 0 {\n                break;\n            }\n            b = b[n..];\n        }\n        b as str\n    }\n\n    pub fn trim_end_matches<P: Pattern>(self, p: sink P) -> str {\n        var b = self as [u8];\n        loop {\n            let n = p.suffix_len(b);\n            if n <= 0 {\n                break;\n            }\n            b = b[..b.len - n];\n        }\n        b as str\n    }\n\n    // Whether the two are equal ignoring ASCII case.\n    pub fn eq_ignore_ascii_case(self, other: str) -> bool {\n        let a = self as [u8];\n        let b = other as [u8];\n        if a.len != b.len {\n            return false;\n        }\n        for i in 0..a.len {\n            if ascii_lower(a[i]) != ascii_lower(b[i]) {\n");
        buf_str(out, c"                return false;\n            }\n        }\n        true\n    }\n\n    // The number of code points.\n    pub fn char_count(self) -> i64 {\n        std::str::count_chars(self as [u8])\n    }\n\n    // Its value as a T: `s.trim().parse::<i64>()?` (Rust's FromStr: an\n    // optional sign, digits, no whitespace).\n    #[inline]\n    pub fn parse<T: FromStr>(self) -> Result<T, T::Err> {\n        T::from_str(self)\n    }\n\n    // Its display width in a terminal's columns (std::unicode: per grapheme\n    // cluster, East Asian Wide and emoji 2).\n    pub fn width(self) -> i64 {\n        str_width(self as [u8], false)\n    }\n\n    // As width, East Asian Ambiguous 2 (CJK contexts).\n    pub fn width_cjk(self) -> i64 {\n        str_width(self as [u8], true)\n    }\n\n    // The extended grapheme clusters (UAX #29): the unicode-segmentation\n    // crate's `graphemes(true)`; the flag is Rust's spelling (legacy\n    // clusters are not offered).\n    #[inline]\n    pub fn graphemes(self, extended: bool) -> StrGraphemes {\n        StrGraphemes { g: graphemes(self as [u8]) }\n    }\n\n    // ---- allocating, on allocator a ----\n\n    // A String of this text.\n    pub fn to_string_in<A: Allocator>(self, a: sink A) -> String<A> {\n        String::from_in(self, a)\n    }\n\n    pub fn to_owned_in<A: Allocator>(self, a: sink A) -> String<A> {\n        String::from_in(self, a)\n    }\n\n    // The text in lower case (Unicode's full mappings: 'İ' is two code\n    // points).\n    pub fn to_lowercase_in<A: Allocator>(self, a: sink A) -> String<A> {\n        let b = self as [u8];\n        var out: String<A> = String::with_capacity_in(b.len, a);\n        var i = 0;\n        while i < b.len {\n            let c = b[i];\n            if c < 0x80 {\n                out.bytes.push(ascii_lower(c));\n                i += 1;\n                continue;\n            }\n            let (cp, n) = cp_at(b, i);\n            let m = to_lower(cp);\n            for k in 0..3 {\n");
        buf_str(out, c"                if m[k] != 0 {\n                    out.push(m[k]);\n                }\n            }\n            i += n;\n        }\n        out\n    }\n\n    // The text in upper case (full mappings: 'ß' is \"SS\").\n    pub fn to_uppercase_in<A: Allocator>(self, a: sink A) -> String<A> {\n        let b = self as [u8];\n        var out: String<A> = String::with_capacity_in(b.len, a);\n        var i = 0;\n        while i < b.len {\n            let c = b[i];\n            if c < 0x80 {\n                out.bytes.push(ascii_upper(c));\n                i += 1;\n                continue;\n            }\n            let (cp, n) = cp_at(b, i);\n            let m = to_upper(cp);\n            for k in 0..3 {\n                if m[k] != 0 {\n                    out.push(m[k]);\n                }\n            }\n            i += n;\n        }\n        out\n    }\n\n    pub fn to_ascii_lowercase_in<A: Allocator>(self, a: sink A) -> String<A> {\n        let b = self as [u8];\n        var out: String<A> = String::with_capacity_in(b.len, a);\n        for i in 0..b.len {\n            out.bytes.push(ascii_lower(b[i]));\n        }\n        out\n    }\n\n    pub fn to_ascii_uppercase_in<A: Allocator>(self, a: sink A) -> String<A> {\n        let b = self as [u8];\n        var out: String<A> = String::with_capacity_in(b.len, a);\n        for i in 0..b.len {\n            out.bytes.push(ascii_upper(b[i]));\n        }\n        out\n    }\n\n    // The text with every match of `from` replaced by `to`.\n    pub fn replace_in<P: Pattern,\n        A: Allocator>(self, from: sink P, to: str, a: sink A) -> String<A> {\n        self.replacen_in(from, to, -1, a)\n    }\n\n    // The first n matches replaced (n < 0: all).\n    pub fn replacen_in<P: Pattern, A: Allocator>(self, from: sink P, to: str, n: i64, a: sink A)\n        -> String<A> {\n        let b = self as [u8];\n        var out: String<A> = String::with_capacity_in(b.len, a);\n        var start = 0;\n        var pos = 0;\n");
        buf_str(out, c"        var left = n;\n        while left != 0 && pos <= b.len {\n            let (m, e) = from.next_match(b, pos);\n            if m < 0 {\n                break;\n            }\n            out.bytes.extend_from_slice(b[start..m]);\n            out.bytes.extend_from_slice(to as [u8]);\n            start = e;\n            pos = if e == m { e + char_len_at(b, e) } else { e };\n            if left > 0 {\n                left -= 1;\n            }\n        }\n        out.bytes.extend_from_slice(b[start..]);\n        out\n    }\n\n    // The text n times.\n    pub fn repeat_in<A: Allocator>(self, n: i64, a: sink A) -> String<A> {\n        let b = self as [u8];\n        var out: String<A> = String::with_capacity_in(b.len * n, a);\n        for _ in 0..n {\n            out.bytes.extend_from_slice(b);\n        }\n        out\n    }\n\n    // ---- the Rust forms: errors naming the _in forms (front/ambient) ----\n\n    #[ambient(\"to_string_in(gpa)\")]\n    pub fn to_string(self) -> String {\n        self.to_string_in(Gpa::ambient())\n    }\n\n    #[ambient(\"to_owned_in(gpa)\")]\n    pub fn to_owned(self) -> String {\n        self.to_owned_in(Gpa::ambient())\n    }\n\n    #[ambient(\"to_lowercase_in(gpa)\")]\n    pub fn to_lowercase(self) -> String {\n        self.to_lowercase_in(Gpa::ambient())\n    }\n\n    #[ambient(\"to_uppercase_in(gpa)\")]\n    pub fn to_uppercase(self) -> String {\n        self.to_uppercase_in(Gpa::ambient())\n    }\n\n    #[ambient(\"replace_in(from, to, gpa)\")]\n    pub fn replace<P: Pattern>(self, from: sink P, to: str) -> String {\n        self.replace_in(from, to, Gpa::ambient())\n    }\n\n    #[ambient(\"repeat_in(n, gpa)\")]\n    pub fn repeat(self, n: i64) -> String {\n        self.repeat_in(n, Gpa::ambient())\n    }\n}\n\n#[inline]\nfn ascii_lower(c: u8) -> u8 {\n    if c >= 'A' && c <= 'Z' { c + 32 } else { c }\n}\n\n#[inline]\nfn ascii_upper(c: u8) -> u8 {\n    if c >= 'a' && c <= 'z' { c - 32 } else { c }\n}\n\n");
        buf_str(out, c"// The length of the code point at byte i (1 past the end).\n#[inline]\nfn char_len_at(s: [u8], i: i64) -> i64 {\n    if i >= s.len {\n        return 1;\n    }\n    let n = utf8_char_width(s[i]);\n    if n == 0 { 1 } else { n }\n}\n\n// ---- Text: str's iterators (0.20) ----\n\n// `s.chars()`: the code points, front to back (`next_back`, `rev()`: back\n// to front). Text that is not UTF-8 (std's own, from_utf8_unchecked)\n// yields U+FFFD for what is not.\npub struct Chars { s: [u8], front: i64, back: i64 }\n\nimpl Iterator for Chars {\n    type Item = u32;\n\n    #[inline]\n    fn next(inout self) -> Option<u32> {\n        if self.front >= self.back {\n            return Option::None;\n        }\n        let b = self.s[self.front];\n        if b < 0x80 {\n            self.front += 1;\n            return Option::Some(b as u32);\n        }\n        let s = self.s[..self.back];\n        Option::Some(lossy_next(s, &self.front))\n    }\n\n    // The code points left: the bytes that are not continuation bytes.\n    fn count(self) -> i64 {\n        std::str::count_chars(self.s[self.front..self.back])\n    }\n}\n\nimpl Chars {\n    // The last code point left.\n    pub fn next_back(inout self) -> Option<u32> {\n        if self.front >= self.back {\n            return Option::None;\n        }\n        let (cp, n) = cp_before(self.s[self.front..self.back], self.back - self.front);\n        self.back -= n;\n        Option::Some(cp)\n    }\n\n    // The code points back to front.\n    pub fn rev(self) -> RevChars {\n        RevChars { c: self }\n    }\n\n    // The text left.\n    pub fn as_str(self) -> str {\n        self.s[self.front..self.back] as str\n    }\n}\n\n// `s.chars().rev()`.\npub struct RevChars { c: Chars }\n\nimpl Iterator for RevChars {\n    type Item = u32;\n\n    #[inline]\n    fn next(inout self) -> Option<u32> {\n        self.c.next_back()\n    }\n}\n\n// `s.char_indices()`: (byte index, code point).\npub struct CharIndices { s: [u8], pos: i64 }\n\n");
        buf_str(out, c"impl Iterator for CharIndices {\n    type Item = (i64, u32);\n\n    #[inline]\n    fn next(inout self) -> Option<(i64, u32)> {\n        if self.pos >= self.s.len {\n            return Option::None;\n        }\n        let at = self.pos;\n        let (cp, n) = cp_at(self.s, at);\n        self.pos = at + n;\n        Option::Some((at, cp))\n    }\n}\n\n// `s.lines()`.\npub struct Lines { s: [u8], pos: i64 }\n\nimpl Iterator for Lines {\n    type Item = str;\n\n    fn next(inout self) -> Option<str> {\n        let s = self.s;\n        let start = self.pos;\n        if start >= s.len {\n            return Option::None;\n        }\n        var end = find_byte('\\n', s, start);\n        if end >= 0 {\n            self.pos = end + 1;\n        } else {\n            end = s.len;\n            self.pos = s.len;\n        }\n        if end > start && s[end - 1] == '\\r' {\n            end -= 1;\n        }\n        Option::Some(s[start..end] as str)\n    }\n}\n\n// `s.split(p)`, `s.splitn(n, p)`.\npub struct Split<P> { s: [u8], start: i64, pos: i64, pat: P, left: i64, done: bool }\n\nimpl<P: Pattern> Iterator for Split<P> {\n    type Item = str;\n\n    fn next(inout self) -> Option<str> {\n        if self.done {\n            return Option::None;\n        }\n        let s = self.s;\n        if self.left == 1 {\n            self.done = true;\n            return Option::Some(s[self.start..] as str);\n        }\n        let (m, e) = if self.pos <= s.len { self.pat.next_match(s, self.pos) } else { (-1, -1) };\n        if m < 0 {\n            self.done = true;\n            return Option::Some(s[self.start..] as str);\n        }\n        let piece = s[self.start..m];\n        self.start = e;\n        self.pos = if e == m { e + char_len_at(s, e) } else { e };\n        if self.left > 0 {\n            self.left -= 1;\n        }\n        Option::Some(piece as str)\n    }\n}\n\n// `s.split_whitespace()`, `s.split_ascii_whitespace()`.\n");
        buf_str(out, c"pub struct SplitWhitespace { s: [u8], pos: i64, ascii: bool }\n\nimpl Iterator for SplitWhitespace {\n    type Item = str;\n\n    fn next(inout self) -> Option<str> {\n        let s = self.s;\n        var i = self.pos;\n        // (the whitespace before the piece)\n        while i < s.len {\n            let c = s[i];\n            if c < 0x80 {\n                if !is_space_cp(c as u32) {\n                    break;\n                }\n                i += 1;\n            } else {\n                if self.ascii {\n                    break;\n                }\n                let (cp, n) = cp_at(s, i);\n                if !is_space_cp(cp) {\n                    break;\n                }\n                i += n;\n            }\n        }\n        if i >= s.len {\n            self.pos = s.len;\n            return Option::None;\n        }\n        let start = i;\n        while i < s.len {\n            let c = s[i];\n            if c < 0x80 {\n                if is_space_cp(c as u32) {\n                    break;\n                }\n                i += 1;\n            } else if self.ascii {\n                i += 1;\n            } else {\n                let (cp, n) = cp_at(s, i);\n                if is_space_cp(cp) {\n                    break;\n                }\n                i += n;\n            }\n        }\n        self.pos = i;\n        Option::Some(s[start..i] as str)\n    }\n}\n\n// `s.matches(p)`.\npub struct Matches<P> { s: [u8], pos: i64, pat: P }\n\nimpl<P: Pattern> Iterator for Matches<P> {\n    type Item = str;\n\n    fn next(inout self) -> Option<str> {\n        let s = self.s;\n        if self.pos > s.len {\n            return Option::None;\n        }\n        let (m, e) = self.pat.next_match(s, self.pos);\n        if m < 0 {\n            self.pos = s.len + 1;\n            return Option::None;\n        }\n        self.pos = if e == m { e + char_len_at(s, e) } else { e };\n        Option::Some(s[m..e] as str)\n    }\n}\n\n");
        buf_str(out, c"// `s.graphemes(true)`: the extended grapheme clusters.\npub struct StrGraphemes { g: Graphemes }\n\nimpl Iterator for StrGraphemes {\n    type Item = str;\n\n    #[inline]\n    fn next(inout self) -> Option<str> {\n        match self.g.next() {\n            Option::Some(b) => Option::Some(b as str),\n            Option::None => Option::None,\n        }\n    }\n}\n\n// ---- Text: parsing (0.20) ----\n\n// A type that text parses as: `s.parse::<T>()`, `T::from_str(s)` (Rust's).\npub trait FromStr {\n    type Err;\n    fn from_str(s: str) -> Result<Self, Self::Err>;\n}\n\n// Why `s.parse::<bool>()` failed: the text is not \"true\" or \"false\".\n#[derive(Eq, Debug, Clone)]\npub struct ParseBoolError { at: i64 }\n\nimpl Display for ParseBoolError {\n    fn fmt(self, f: inout Fmt) {\n        f.str(\"provided string was not `true` or `false`\");\n    }\n}\n\nimpl FromStr for bool {\n    type Err = ParseBoolError;\n\n    fn from_str(s: str) -> Result<bool, ParseBoolError> {\n        if s == \"true\" {\n            return Result::Ok(true);\n        }\n        if s == \"false\" {\n            return Result::Ok(false);\n        }\n        Result::Err(ParseBoolError { at: 0 })\n    }\n}\n\nimpl FromStr for i64 {\n    type Err = ParseIntError;\n\n    fn from_str(s: str) -> Result<i64, ParseIntError> {\n        parse_i64_radix(s as [u8], 10)\n    }\n}\n\nimpl FromStr for u64 {\n    type Err = ParseIntError;\n\n    fn from_str(s: str) -> Result<u64, ParseIntError> {\n        parse_u64_radix(s as [u8], 10)\n    }\n}\n\n// An i64 that fits in [lo, hi], else Overflow.\nfn parse_signed_in(s: str, lo: i64, hi: i64) -> Result<i64, ParseIntError> {\n    match parse_i64_radix(s as [u8], 10) {\n        Result::Ok(v) => if v < lo || v > hi { Result::Err(ParseIntError::Overflow) }\n            else { Result::Ok(v) },\n        Result::Err(e) => Result::Err(e),\n    }\n}\n\nfn parse_unsigned_in(s: str, hi: u64) -> Result<u64, ParseIntError> {\n    match parse_u64_radix(s as [u8], 10) {\n");
        buf_str(out, c"        Result::Ok(v) => if v > hi { Result::Err(ParseIntError::Overflow) } else { Result::Ok(v) },\n        Result::Err(e) => Result::Err(e),\n    }\n}\n\nimpl FromStr for i32 {\n    type Err = ParseIntError;\n\n    fn from_str(s: str) -> Result<i32, ParseIntError> {\n        match parse_signed_in(s, -2147483648, 2147483647) {\n            Result::Ok(v) => Result::Ok(v as i32),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl FromStr for i16 {\n    type Err = ParseIntError;\n\n    fn from_str(s: str) -> Result<i16, ParseIntError> {\n        match parse_signed_in(s, -32768, 32767) {\n            Result::Ok(v) => Result::Ok(v as i16),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl FromStr for i8 {\n    type Err = ParseIntError;\n\n    fn from_str(s: str) -> Result<i8, ParseIntError> {\n        match parse_signed_in(s, -128, 127) {\n            Result::Ok(v) => Result::Ok(v as i8),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl FromStr for u32 {\n    type Err = ParseIntError;\n\n    fn from_str(s: str) -> Result<u32, ParseIntError> {\n        match parse_unsigned_in(s, 4294967295) {\n            Result::Ok(v) => Result::Ok(v as u32),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl FromStr for u16 {\n    type Err = ParseIntError;\n\n    fn from_str(s: str) -> Result<u16, ParseIntError> {\n        match parse_unsigned_in(s, 65535) {\n            Result::Ok(v) => Result::Ok(v as u16),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl FromStr for u8 {\n    type Err = ParseIntError;\n\n    fn from_str(s: str) -> Result<u8, ParseIntError> {\n        match parse_unsigned_in(s, 255) {\n            Result::Ok(v) => Result::Ok(v as u8),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl FromStr for f64 {\n    type Err = ParseFloatError;\n\n    fn from_str(s: str) -> Result<f64, ParseFloatError> {\n");
        buf_str(out, c"        parse_f64(s as [u8])\n    }\n}\n\nimpl FromStr for f32 {\n    type Err = ParseFloatError;\n\n    fn from_str(s: str) -> Result<f32, ParseFloatError> {\n        parse_f32(s as [u8])\n    }\n}\n\n// ---- Text: String (0.20) ----\n\n// UTF-8 text that owns its bytes, on allocator A (Rust's String):\n// `String::new_in(gpa)`, `s.push_str(\"..\")`, `s.push_fmt(f\"..\")`. It has\n// its `str`'s methods (`s.trim()`, `s.split(',')`: the compiler calls\n// them on `s.as_str()`), and `&s` goes where a `str` or `[u8]` does.\n// (its bytes are std's: #[sealed] keeps other code from changing them)\n#[sealed]\npub struct String<A: Allocator = Gpa> { pub bytes: Vec<u8, A> }\n\nimpl<A: Allocator> String<A> {\n    pub fn new_in(a: sink A) -> String<A> {\n        String { bytes: Vec::new_in(a) }\n    }\n\n    pub fn with_capacity_in(cap: i64, a: sink A) -> String<A> {\n        String { bytes: Vec::with_capacity_in(cap, a) }\n    }\n\n    // A String of s's text (Rust's `String::from(s)`).\n    pub fn from_in(s: str, a: sink A) -> String<A> {\n        let b = s as [u8];\n        var v: Vec<u8, A> = Vec::with_capacity_in(b.len, a);\n        v.extend_from_slice(b);\n        String { bytes: v }\n    }\n\n    // The String of bytes v when they are UTF-8 (they are dropped when not).\n    pub fn from_utf8(v: sink Vec<u8, A>) -> Result<String<A>, Utf8Error> {\n        match validate_utf8(v.as_slice()) {\n            Result::Ok(_) => Result::Ok(String { bytes: v }),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n\n    // The String of Buf b's bytes when they are UTF-8.\n    pub fn from_buf(b: sink Buf<A>) -> Result<String<A>, Utf8Error> {\n        var b = b;\n        let v = b.bytes.take();\n        String::from_utf8(v)\n    }\n\n    // The text of bytes b, U+FFFD in place of what is not UTF-8 (each\n    // maximal subpart, as Rust's from_utf8_lossy).\n    pub fn from_utf8_lossy_in(b: [u8], a: sink A) -> String<A> {\n");
        buf_str(out, c"        var out: String<A> = String::with_capacity_in(b.len, a);\n        var i = 0;\n        while i < b.len {\n            let start = i;\n            while i < b.len && b[i] < 0x80 {\n                i += 1;\n            }\n            out.bytes.extend_from_slice(b[start..i]);\n            if i < b.len {\n                let cp = lossy_next(b, &i);\n                out.push(cp);\n            }\n        }\n        out\n    }\n\n    #[inline]\n    pub fn len(self) -> i64 {\n        self.bytes.len\n    }\n\n    #[inline]\n    pub fn is_empty(self) -> bool {\n        self.bytes.len == 0\n    }\n\n    pub fn capacity(self) -> i64 {\n        self.bytes.capacity()\n    }\n\n    pub fn reserve(inout self, extra: i64) {\n        self.bytes.reserve(extra);\n    }\n\n    pub fn clear(inout self) {\n        self.bytes.clear();\n    }\n\n    // The text, a view (valid until the String changes).\n    #[inline]\n    pub fn as_str(self) -> str {\n        self.bytes.as_slice() as str\n    }\n\n    #[inline]\n    pub fn as_bytes(self) -> [u8] {\n        self.bytes.as_slice()\n    }\n\n    // Its bytes, as a Buf's `as_slice`.\n    #[inline]\n    pub fn as_slice(self) -> [u8] {\n        self.bytes.as_slice()\n    }\n\n    // Appends code point cp (U+FFFD for one that is not a scalar value).\n    pub fn push(inout self, cp: u32) {\n        if cp < 0x80 {\n            self.bytes.push(cp as u8);\n            return;\n        }\n        var buf: [u8; 4] = [0; 4];\n        let n = encode_utf8(cp, &buf);\n        self.bytes.extend_from_slice(buf[..n]);\n    }\n\n    // Appends s (`s.push_str(f\"..\")` writes the f-string in place).\n    #[inline]\n    pub fn push_str(inout self, s: str) {\n        self.bytes.extend_from_slice(s as [u8]);\n    }\n\n    // Appends x's Display: `s.push_fmt(f\"{k}={v};\")`.\n    pub fn push_fmt<T: Display>(inout self, x: sink T) {\n        var f = std::fmt::fmt_to_vec(&self.bytes);\n        loop {\n            x.fmt(&f);\n");
        buf_str(out, c"            if std::fmt::fmt_end_vec(&self.bytes, &f) {\n                return;\n            }\n        }\n    }\n\n    // The last code point, removed.\n    pub fn pop(inout self) -> Option<u32> {\n        let n = self.bytes.len;\n        if n == 0 {\n            return Option::None;\n        }\n        let (cp, k) = cp_before(self.bytes.as_slice(), n);\n        self.bytes.truncate(n - k);\n        Option::Some(cp)\n    }\n\n    // Keeps the first n bytes; n must be a char boundary.\n    pub fn truncate(inout self, n: i64) {\n        if n < self.bytes.len {\n            if !is_char_boundary(self.bytes.as_slice(), n) {\n                std::panic_str(\"String::truncate: not a char boundary\");\n            }\n            self.bytes.truncate(n);\n        }\n    }\n\n    // Inserts s at byte index i (a char boundary).\n    pub fn insert_str(inout self, i: i64, s: str) {\n        let b = s as [u8];\n        let len = self.bytes.len;\n        if i < 0 || i > len || !is_char_boundary(self.bytes.as_slice(), i) {\n            std::panic_str(\"String::insert_str: not a char boundary\");\n        }\n        for k in 0..b.len {\n            self.bytes.push(0);\n        }\n        let all = self.bytes.as_mut_slice();\n        var j = len;\n        while j > i {\n            j -= 1;\n            all[j + b.len] = all[j];\n        }\n        for k in 0..b.len {\n            all[i + k] = b[k];\n        }\n    }\n\n    // Inserts code point cp at byte index i.\n    pub fn insert(inout self, i: i64, cp: u32) {\n        var buf: [u8; 4] = [0; 4];\n        let n = encode_utf8(cp, &buf);\n        let t = buf[..n];\n        self.insert_str(i, t as str);\n    }\n\n    // Removes the code point at byte index i, returning it.\n    pub fn remove(inout self, i: i64) -> u32 {\n        let len = self.bytes.len;\n        if i < 0 || i >= len || !is_char_boundary(self.bytes.as_slice(), i) {\n            std::panic_str(\"String::remove: not a char boundary\");\n        }\n");
        buf_str(out, c"        let (cp, n) = cp_at(self.bytes.as_slice(), i);\n        let all = self.bytes.as_mut_slice();\n        for j in i..len - n {\n            all[j] = all[j + n];\n        }\n        self.bytes.truncate(len - n);\n        cp\n    }\n\n    // Keeps the code points f is true for.\n    pub fn retain<F: FnMut(u32) -> bool>(inout self, f: F) {\n        var f = f;\n        let len = self.bytes.len;\n        var w = 0;\n        var i = 0;\n        while i < len {\n            let (cp, n) = cp_at(self.bytes.as_slice(), i);\n            if f(cp) {\n                let all = self.bytes.as_mut_slice();\n                for k in 0..n {\n                    all[w + k] = all[i + k];\n                }\n                w += n;\n            }\n            i += n;\n        }\n        self.bytes.truncate(w);\n    }\n\n    // Its bytes, as a Vec (the String is gone).\n    pub fn into_bytes(sink self) -> Vec<u8, A> {\n        var s = self;\n        s.bytes.take()\n    }\n\n    // Its bytes, as a Buf.\n    pub fn into_buf(sink self) -> Buf<A> {\n        var s = self;\n        Buf { bytes: s.bytes.take() }\n    }\n\n    pub fn allocator(self) -> A {\n        self.bytes.allocator()\n    }\n}\n\nimpl<A: Allocator + Ambient> String<A> {\n    #[ambient(\"String::new_in(gpa)\")]\n    pub fn new() -> String<A> {\n        String { bytes: Vec::new_in(A::ambient()) }\n    }\n\n    #[ambient(\"String::with_capacity_in(cap, gpa)\")]\n    pub fn with_capacity(cap: i64) -> String<A> {\n        String { bytes: Vec::with_capacity_in(cap, A::ambient()) }\n    }\n\n    #[ambient(\"String::from_in(s, gpa)\")]\n    pub fn from(s: str) -> String<A> {\n        String::from_in(s, A::ambient())\n    }\n}\n\nimpl<A: Allocator> Display for String<A> {\n    fn fmt(self, f: inout Fmt) {\n        f.str(self.bytes.as_slice());\n    }\n}\n\nimpl<A: Allocator> Debug for String<A> {\n    fn fmt_debug(self, f: inout Fmt) {\n        let s = self.bytes.as_slice();\n        s.fmt_debug(&f);\n    }\n}\n\n");
        buf_str(out, c"impl<A: Allocator> Eq for String<A> {\n    fn eq(self, other: String<A>) -> bool {\n        let a = self.bytes.as_slice();\n        let b = other.bytes.as_slice();\n        a == b\n    }\n}\n\nimpl<A: Allocator> Ord for String<A> {\n    fn cmp(self, other: String<A>) -> i64 {\n        let a = self.bytes.as_slice();\n        let b = other.bytes.as_slice();\n        a.cmp(b)\n    }\n}\n\nimpl<A: Allocator> Hash for String<A> {\n    fn hash(self) -> u64 {\n        let a = self.bytes.as_slice();\n        a.hash()\n    }\n}\n\nimpl<A: Allocator> Clone for String<A> {\n    fn clone(self) -> String<A> {\n        String { bytes: self.bytes.clone() }\n    }\n}\n\n// x's Display as a new String on allocator a: `to_string_in(n, gpa)`,\n// `to_string_in(f\"{a}-{b}\", gpa)` (Rust's `x.to_string()`, `format!`).\npub fn to_string_in<T: Display, A: Allocator>(x: sink T, a: sink A) -> String<A> {\n    var s: String<A> = String::new_in(a);\n    s.push_fmt(x);\n    s\n}\n// ---- end mod std::string ----\n}\n// ---- mod std::path ----\npub mod path {\n// std::path (0.20, docs/design/collections-text-io.md §2.6.3, task B6):\n// Path, a view of a path's bytes (Unix paths are bytes, as Rust's OsStr\n// is on Unix), and PathBuf, one that owns them, on an allocator. A string\n// literal is a Path where one goes, a Path goes where `[u8]` does, and\n// `&p` of a PathBuf where a Path or `[u8]` does.\n\nuse std::{Allocator, Debug, Display, Fmt, Gpa, Iterator, Option, Vec};\nuse std::str::validate_utf8;\nuse std::string::str;\n\n// ---- Paths (0.20) ----\n\n// A path: its bytes, '/' between its components.\npub type Path = distinct [u8];\n\n// The index of the last '/' in b, or -1.\nfn last_slash(b: [u8]) -> i64 {\n    var i = b.len;\n    while i > 0 {\n        i -= 1;\n        if b[i] == '/' {\n            return i;\n        }\n    }\n    -1\n}\n\n// b without the '/'s at its end (one stays for the root).\nfn trim_slashes(b: [u8]) -> [u8] {\n    var n = b.len;\n");
        buf_str(out, c"    while n > 1 && b[n - 1] == '/' {\n        n -= 1;\n    }\n    b[..n]\n}\n\nimpl Path {\n    // The path of bytes (or text) s: `Path::new(\"a/b.txt\")`.\n    #[inline]\n    pub fn new(s: [u8]) -> Path {\n        s as Path\n    }\n\n    #[inline]\n    pub fn as_bytes(self) -> [u8] {\n        self as [u8]\n    }\n\n    #[inline]\n    pub fn len(self) -> i64 {\n        (self as [u8]).len\n    }\n\n    // Its text, when its bytes are UTF-8.\n    pub fn to_str(self) -> Option<str> {\n        match str::from_utf8(self as [u8]) {\n            Ok(s) => Option::Some(s),\n            Err(_) => Option::None,\n        }\n    }\n\n    // What prints it (Path is Display itself: its bytes).\n    #[inline]\n    pub fn display(self) -> Path {\n        self\n    }\n\n    pub fn is_absolute(self) -> bool {\n        let b = self as [u8];\n        b.len > 0 && b[0] == '/'\n    }\n\n    pub fn is_relative(self) -> bool {\n        !self.is_absolute()\n    }\n\n    // The last component (None for \"/\", \"\", \"..\", or one ending in \"..\").\n    pub fn file_name(self) -> Option<Path> {\n        let b = trim_slashes(self as [u8]);\n        if b.len == 0 || b == \"/\" {\n            return Option::None;\n        }\n        let name = b[last_slash(b) + 1..];\n        if name == \"..\" || name == \".\" {\n            return Option::None;\n        }\n        Option::Some(name as Path)\n    }\n\n    // The path without its last component (\"\" for a single component, None\n    // for \"/\" and \"\").\n    pub fn parent(self) -> Option<Path> {\n        let b = trim_slashes(self as [u8]);\n        if b.len == 0 || b == \"/\" {\n            return Option::None;\n        }\n        let k = last_slash(b);\n        if k < 0 {\n            return Option::Some(\"\"[..0] as Path);\n        }\n        if k == 0 {\n            return Option::Some(b[..1] as Path);\n        }\n        Option::Some(trim_slashes(b[..k]) as Path)\n    }\n\n");
        buf_str(out, c"    // The file name after its last '.' (none for \".bashrc\" or \"a\").\n    pub fn extension(self) -> Option<Path> {\n        match self.file_name() {\n            Option::Some(n) => {\n                let b = n as [u8];\n                let k = last_dot(b);\n                if k <= 0 { Option::None } else { Option::Some(b[k + 1..] as Path) }\n            }\n            Option::None => Option::None,\n        }\n    }\n\n    // The file name before its last '.'.\n    pub fn file_stem(self) -> Option<Path> {\n        match self.file_name() {\n            Option::Some(n) => {\n                let b = n as [u8];\n                let k = last_dot(b);\n                if k <= 0 { Option::Some(n) } else { Option::Some(b[..k] as Path) }\n            }\n            Option::None => Option::None,\n        }\n    }\n\n    // Whether its first components are base's.\n    pub fn starts_with(self, base: Path) -> bool {\n        let a = self as [u8];\n        let b = trim_slashes(base as [u8]);\n        if b.len > a.len || a[..b.len] != b {\n            return false;\n        }\n        a.len == b.len || b == \"/\" || a[b.len] == '/'\n    }\n\n    // The components (\"/\" first for an absolute path; \".\" and empty ones\n    // left out, as Rust's).\n    #[inline]\n    pub fn components(self) -> Components {\n        Components { b: self as [u8], pos: 0 }\n    }\n\n    // The path with p after it, on allocator a (p absolute: p).\n    pub fn join_in<A: Allocator>(self, p: [u8], a: sink A) -> PathBuf<A> {\n        var out: PathBuf<A> = PathBuf::from_in(self as [u8], a);\n        out.push(p);\n        out\n    }\n\n    // An owned copy, on allocator a.\n    pub fn to_path_buf_in<A: Allocator>(self, a: sink A) -> PathBuf<A> {\n        PathBuf::from_in(self as [u8], a)\n    }\n\n    // Whether something is there (std::fs::metadata succeeds).\n    pub fn exists(self) -> bool {\n        std::fs::exists(self as [u8])\n    }\n\n    pub fn is_dir(self) -> bool {\n");
        buf_str(out, c"        match std::fs::metadata(self as [u8]) {\n            Ok(m) => m.is_dir(),\n            Err(_) => false,\n        }\n    }\n\n    pub fn is_file(self) -> bool {\n        match std::fs::metadata(self as [u8]) {\n            Ok(m) => m.is_file(),\n            Err(_) => false,\n        }\n    }\n}\n\n// The index of the last '.' in b, or -1.\nfn last_dot(b: [u8]) -> i64 {\n    var i = b.len;\n    while i > 0 {\n        i -= 1;\n        if b[i] == '.' {\n            return i;\n        }\n    }\n    -1\n}\n\n// `p.components()`.\npub struct Components { b: [u8], pos: i64 }\n\nimpl Iterator for Components {\n    type Item = Path;\n\n    fn next(inout self) -> Option<Path> {\n        let b = self.b;\n        if self.pos == 0 && b.len > 0 && b[0] == '/' {\n            self.pos = 1;\n            return Option::Some(b[..1] as Path);\n        }\n        loop {\n            while self.pos < b.len && b[self.pos] == '/' {\n                self.pos += 1;\n            }\n            if self.pos >= b.len {\n                return Option::None;\n            }\n            let start = self.pos;\n            while self.pos < b.len && b[self.pos] != '/' {\n                self.pos += 1;\n            }\n            let c = b[start..self.pos];\n            if c != \".\" {\n                return Option::Some(c as Path);\n            }\n        }\n    }\n}\n\n// An owned path, on allocator A.\n#[sealed]\npub struct PathBuf<A: Allocator = Gpa> { pub bytes: Vec<u8, A> }\n\nimpl<A: Allocator> PathBuf<A> {\n    pub fn new_in(a: sink A) -> PathBuf<A> {\n        PathBuf { bytes: Vec::new_in(a) }\n    }\n\n    // A PathBuf of p's bytes.\n    pub fn from_in(p: [u8], a: sink A) -> PathBuf<A> {\n        var v: Vec<u8, A> = Vec::with_capacity_in(p.len, a);\n        v.extend_from_slice(p);\n        PathBuf { bytes: v }\n    }\n\n    #[inline]\n    pub fn as_path(self) -> Path {\n        self.bytes.as_slice() as Path\n    }\n\n    #[inline]\n    pub fn as_bytes(self) -> [u8] {\n");
        buf_str(out, c"        self.bytes.as_slice()\n    }\n\n    // Appends p after a '/' (p absolute: p replaces the path).\n    pub fn push(inout self, p: [u8]) {\n        if p.len > 0 && p[0] == '/' {\n            self.bytes.clear();\n        } else if self.bytes.len > 0 && self.bytes.as_slice()[self.bytes.len - 1] != '/' {\n            self.bytes.push('/');\n        }\n        self.bytes.extend_from_slice(p);\n    }\n\n    // Removes the last component: false when there is none.\n    pub fn pop(inout self) -> bool {\n        match self.as_path().parent() {\n            Option::Some(q) => {\n                let n = (q as [u8]).len;\n                self.bytes.truncate(n);\n                true\n            }\n            Option::None => false,\n        }\n    }\n\n    // Its extension replaced by ext (added when it has none; ext \"\" removes\n    // it): false when it has no file name.\n    pub fn set_extension(inout self, ext: [u8]) -> bool {\n        let stem_end = match self.as_path().file_stem() {\n            Option::Some(s) => {\n                // (the stem starts the last component)\n                let b = trim_slashes(self.bytes.as_slice());\n                last_slash(b) + 1 + (s as [u8]).len\n            }\n            Option::None => return false,\n        };\n        self.bytes.truncate(stem_end);\n        if ext.len > 0 {\n            self.bytes.push('.');\n            self.bytes.extend_from_slice(ext);\n        }\n        true\n    }\n}\n\nimpl<A: Allocator> Display for PathBuf<A> {\n    fn fmt(self, f: inout Fmt) {\n        f.str(self.bytes.as_slice());\n    }\n}\n\nimpl<A: Allocator> Debug for PathBuf<A> {\n    fn fmt_debug(self, f: inout Fmt) {\n        let s = self.bytes.as_slice();\n        s.fmt_debug(&f);\n    }\n}\n// ---- end mod std::path ----\n}\n// ---- mod std::fs ----\npub mod fs {\n// std::fs (0.20, docs/design/collections-text-io.md §2.6.3, task B6):\n// files and directories with Rust's names. A path is any `[u8]`: a\n");
        buf_str(out, c"// literal, a `str`, a Path, `&s` of a String or PathBuf. It reaches C as a\n// NUL-ended copy on the stack (std::sys: InvalidInput when it is longer\n// than the system's PATH_MAX or holds a NUL), so nothing here allocates\n// but what returns a Vec or a String, on the allocator given.\n\nuse std::{Allocator, Drop, Iterator, Option, Vec};\nuse std::io::buffered::{Read, Write};\nuse std::io::error::{Error, ErrorKind, Result, __io_error, __os_error};\nuse std::path::{Path, PathBuf};\nuse std::str::validate_utf8;\nuse std::string::{String, str};\nuse std::sys::{\n    FileStat, SYS_DT_DIR, SYS_DT_LNK, SYS_DT_REG, SYS_DT_UNKNOWN, SYS_EEXIST, SYS_O_APPEND,\n    SYS_O_CLOEXEC, SYS_O_CREAT, SYS_O_EXCL, SYS_O_RDONLY, SYS_O_RDWR, SYS_O_TRUNC, SYS_O_WRONLY,\n    SYS_SEEK_CUR, SYS_SEEK_END, SYS_SEEK_SET, SysDir, sys_close, sys_closedir, sys_fstat, sys_fsync,\n    sys_ftruncate, sys_lseek, sys_lstat, sys_mkdir, sys_open, sys_opendir, sys_read,\n    sys_readdir_into, sys_rename, sys_rmdir, sys_stat, sys_unlink, sys_write,\n};\n\n// ---- Files (0.20) ----\n\n// An open file; dropping it closes it.\npub struct File { fd: i32 }\n\nimpl Drop for File {\n    fn drop(inout self) {\n        if self.fd >= 0 {\n            let _ = sys_close(self.fd);\n            self.fd = -1;\n        }\n    }\n}\n\n// The Result of a sys call, its errno an io::Error.\n#[inline]\nfn os<T>(r: sink std::Result<T, i32>) -> Result<T> {\n    match r {\n        Ok(v) => Ok(v),\n        Err(e) => Err(__os_error(e)),\n    }\n}\n\nimpl File {\n    // Opens path for reading.\n    pub fn open(path: [u8]) -> Result<File> {\n        let fd = os(sys_open(path, SYS_O_RDONLY | SYS_O_CLOEXEC, 0))?;\n        Ok(File { fd: fd })\n    }\n\n    // Opens path for writing: made if it is not there, emptied if it is.\n    pub fn create(path: [u8]) -> Result<File> {\n        let fd = os(sys_open(path, SYS_O_WRONLY | SYS_O_CREAT | SYS_O_TRUNC | SYS_O_CLOEXEC,\n            0x1b6))?;\n        Ok(File { fd: fd })\n    }\n\n");
        buf_str(out, c"    // Makes path and opens it for writing: AlreadyExists when it is there.\n    pub fn create_new(path: [u8]) -> Result<File> {\n        let fd = os(sys_open(path, SYS_O_WRONLY | SYS_O_CREAT | SYS_O_EXCL | SYS_O_CLOEXEC,\n            0x1b6))?;\n        Ok(File { fd: fd })\n    }\n\n    // The options to open a file with: `OpenOptions::new().append(true)`.\n    pub fn options() -> OpenOptions {\n        OpenOptions::new()\n    }\n\n    // Its file descriptor.\n    pub fn as_raw_fd(self) -> i32 {\n        self.fd\n    }\n\n    pub fn metadata(self) -> Result<Metadata> {\n        let st = os(sys_fstat(self.fd))?;\n        Ok(Metadata { st: st })\n    }\n\n    // Its length becomes n (cut, or zeros after).\n    pub fn set_len(self, n: i64) -> Result<()> {\n        os(sys_ftruncate(self.fd, n))\n    }\n\n    // Writes what the system holds of it to the disk.\n    pub fn sync_all(self) -> Result<()> {\n        os(sys_fsync(self.fd))\n    }\n\n    // Moves the position: to `off` from the start (Rust's\n    // `seek(SeekFrom::Start(off))`); the new position.\n    pub fn seek(inout self, pos: SeekFrom) -> Result<i64> {\n        let r = match pos {\n            SeekFrom::Start(o) => sys_lseek(self.fd, o, SYS_SEEK_SET),\n            SeekFrom::End(o) => sys_lseek(self.fd, o, SYS_SEEK_END),\n            SeekFrom::Current(o) => sys_lseek(self.fd, o, SYS_SEEK_CUR),\n        };\n        os(r)\n    }\n}\n\n// Where File::seek moves to.\n#[derive(Eq, Debug, Clone)]\npub enum SeekFrom { Start(i64), End(i64), Current(i64) }\n\nimpl Read for File {\n    fn read(inout self, buf: inout [u8]) -> Result<i64> {\n        os(sys_read(self.fd, buf))\n    }\n}\n\nimpl Write for File {\n    fn write(inout self, buf: [u8]) -> Result<i64> {\n        os(sys_write(self.fd, buf))\n    }\n\n    fn flush(inout self) -> Result<()> {\n        Ok(())\n    }\n}\n\n// How File::open... opens a file (Rust's OpenOptions):\n// `OpenOptions::new().append(true).create(true).open(p)?`.\n");
        buf_str(out, c"#[derive(Eq, Debug, Clone)]\npub struct OpenOptions {\n    read: bool, write: bool, append: bool, truncate: bool, create: bool, create_new: bool,\n    mode: i32,\n}\n\nimpl OpenOptions {\n    pub fn new() -> OpenOptions {\n        OpenOptions { read: false, write: false, append: false, truncate: false, create: false,\n            create_new: false, mode: 0x1b6 }\n    }\n\n    pub fn read(self, on: bool) -> OpenOptions {\n        var o = self;\n        o.read = on;\n        o\n    }\n\n    pub fn write(self, on: bool) -> OpenOptions {\n        var o = self;\n        o.write = on;\n        o\n    }\n\n    pub fn append(self, on: bool) -> OpenOptions {\n        var o = self;\n        o.append = on;\n        o\n    }\n\n    pub fn truncate(self, on: bool) -> OpenOptions {\n        var o = self;\n        o.truncate = on;\n        o\n    }\n\n    pub fn create(self, on: bool) -> OpenOptions {\n        var o = self;\n        o.create = on;\n        o\n    }\n\n    pub fn create_new(self, on: bool) -> OpenOptions {\n        var o = self;\n        o.create_new = on;\n        o\n    }\n\n    // The permission bits a file it makes gets (0x1b6 before the umask).\n    pub fn mode(self, bits: i32) -> OpenOptions {\n        var o = self;\n        o.mode = bits;\n        o\n    }\n\n    pub fn open(self, path: [u8]) -> Result<File> {\n        let writes = self.write || self.append;\n        var flags = if self.read && writes { SYS_O_RDWR } else if writes { SYS_O_WRONLY }\n            else { SYS_O_RDONLY };\n        if self.append {\n            flags |= SYS_O_APPEND;\n        }\n        if self.truncate {\n            flags |= SYS_O_TRUNC;\n        }\n        if self.create_new {\n            flags |= SYS_O_CREAT | SYS_O_EXCL;\n        } else if self.create {\n            flags |= SYS_O_CREAT;\n        }\n        let fd = os(sys_open(path, flags | SYS_O_CLOEXEC, self.mode))?;\n        Ok(File { fd: fd })\n    }\n}\n\n// What stat says of a file.\n#[derive(Eq, Debug)]\n");
        buf_str(out, c"pub struct Metadata { st: FileStat }\n\nimpl Metadata {\n    // The size in bytes.\n    pub fn len(self) -> i64 {\n        self.st.size\n    }\n\n    pub fn is_dir(self) -> bool {\n        self.st.is_dir()\n    }\n\n    pub fn is_file(self) -> bool {\n        self.st.is_file()\n    }\n\n    pub fn is_symlink(self) -> bool {\n        self.st.is_symlink()\n    }\n\n    // The permission bits (0x1ed: 0o755, ...).\n    pub fn mode(self) -> u32 {\n        self.st.permissions()\n    }\n\n    // When it was last changed: since the Unix epoch.\n    pub fn modified(self) -> std::time::Duration {\n        std::time::Duration::new(self.st.mtime_sec as u64, self.st.mtime_nsec as u32)\n    }\n}\n\n// ---- Whole files (0.20) ----\n\n// The bytes of the file at path, in a new Vec on allocator a.\npub fn read_in<A: Allocator>(path: [u8], a: sink A) -> Result<Vec<u8, A>> {\n    var f = File::open(path)?;\n    let size = match f.metadata() {\n        Ok(m) => m.len(),\n        Err(_) => 0,\n    };\n    var v: Vec<u8, A> = Vec::with_capacity_in(size + 1, a);\n    f.read_to_end(&v)?;\n    Ok(v)\n}\n\n// The text of the file at path, in a new String on allocator a\n// (InvalidData when it is not UTF-8).\npub fn read_to_string_in<A: Allocator>(path: [u8], a: sink A) -> Result<String<A>> {\n    let v = read_in(path, a)?;\n    match String::from_utf8(v) {\n        Ok(s) => Ok(s),\n        Err(_) => Err(__io_error(ErrorKind::InvalidData, c\"stream did not contain valid UTF-8\")),\n    }\n}\n\n// The file at path holds data: made, or emptied first.\npub fn write(path: [u8], data: [u8]) -> Result<()> {\n    var f = File::create(path)?;\n    f.write_all(data)\n}\n\n// data at the end of the file at path (made when it is not there).\npub fn append(path: [u8], data: [u8]) -> Result<()> {\n    var f = OpenOptions::new().append(true).create(true).open(path)?;\n    f.write_all(data)\n}\n\n// Copies the file at `from` to `to` (made, or emptied): the bytes copied.\n");
        buf_str(out, c"pub fn copy(from: [u8], to: [u8]) -> Result<i64> {\n    var src = File::open(from)?;\n    var dst = File::create(to)?;\n    var buf: [u8; 65536] = [0; 65536];\n    var total = 0;\n    loop {\n        let n = src.read(&buf[..])?;\n        if n == 0 {\n            return Ok(total);\n        }\n        dst.write_all(buf[..n])?;\n        total += n;\n    }\n}\n\n// What stat says of the file at path (through a symlink).\npub fn metadata(path: [u8]) -> Result<Metadata> {\n    let st = os(sys_stat(path))?;\n    Ok(Metadata { st: st })\n}\n\n// As metadata, of a symlink itself.\npub fn symlink_metadata(path: [u8]) -> Result<Metadata> {\n    let st = os(sys_lstat(path))?;\n    Ok(Metadata { st: st })\n}\n\n// Whether something is at path.\npub fn exists(path: [u8]) -> bool {\n    match sys_stat(path) {\n        Ok(_) => true,\n        Err(_) => false,\n    }\n}\n\npub fn remove_file(path: [u8]) -> Result<()> {\n    os(sys_unlink(path))\n}\n\n// Removes the empty directory at path.\npub fn remove_dir(path: [u8]) -> Result<()> {\n    os(sys_rmdir(path))\n}\n\npub fn rename(from: [u8], to: [u8]) -> Result<()> {\n    os(sys_rename(from, to))\n}\n\npub fn create_dir(path: [u8]) -> Result<()> {\n    os(sys_mkdir(path, 0x1ff))\n}\n\n// Makes the directory at path and the ones above it that are missing\n// (Ok when it is there).\npub fn create_dir_all(path: [u8]) -> Result<()> {\n    if path.len == 0 {\n        return Ok(());\n    }\n    match sys_mkdir(path, 0x1ff) {\n        Ok(_) => return Ok(()),\n        Err(e) => {\n            if e == SYS_EEXIST {\n                return if is_dir_at(path) { Ok(()) } else { Err(__os_error(e)) };\n            }\n        }\n    }\n    // (the parents first, then this one)\n    var end = path.len;\n    while end > 0 && path[end - 1] == '/' {\n        end -= 1;\n    }\n    var k = end;\n    while k > 0 && path[k - 1] != '/' {\n        k -= 1;\n    }\n    if k > 1 {\n        create_dir_all(path[..k - 1])?;\n    }\n");
        buf_str(out, c"    match sys_mkdir(path, 0x1ff) {\n        Ok(_) => Ok(()),\n        Err(e) => if e == SYS_EEXIST && is_dir_at(path) { Ok(()) } else { Err(__os_error(e)) },\n    }\n}\n\nfn is_dir_at(path: [u8]) -> bool {\n    match sys_stat(path) {\n        Ok(st) => st.is_dir(),\n        Err(_) => false,\n    }\n}\n\n// Removes the directory at path and all it holds (symlinks are removed,\n// not followed).\npub fn remove_dir_all(path: [u8]) -> Result<()> {\n    var stack: [u8; 4096] = [0; 4096];\n    if path.len >= 4096 {\n        return Err(__io_error(ErrorKind::InvalidInput, c\"path too long\"));\n    }\n    for i in 0..path.len {\n        stack[i] = path[i];\n    }\n    remove_tree(&stack, path.len)\n}\n\n// Removes the tree at buf[..n], which it extends with each entry's name.\nfn remove_tree(buf: inout [u8; 4096], n: i64) -> Result<()> {\n    let st = os(sys_lstat(buf[..n]))?;\n    if !st.is_dir() {\n        return os(sys_unlink(buf[..n]));\n    }\n    var dir = read_dir(buf[..n])?;\n    loop {\n        let e = match dir.next() {\n            Option::Some(r) => r?,\n            Option::None => break,\n        };\n        let name = e.name[..e.len];\n        if n + 1 + name.len >= 4096 {\n            return Err(__io_error(ErrorKind::InvalidInput, c\"path too long\"));\n        }\n        buf[n] = '/';\n        for i in 0..name.len {\n            buf[n + 1 + i] = name[i];\n        }\n        remove_tree(&buf, n + 1 + name.len)?;\n    }\n    os(sys_rmdir(buf[..n]))\n}\n\n// ---- Directories (0.20) ----\n\n// The entries of the directory at path (\".\" and \"..\" left out), in the\n// order the file system gives them.\npub fn read_dir(path: [u8]) -> Result<ReadDir> {\n    let d = os(sys_opendir(path))?;\n    Ok(ReadDir { dir: d })\n}\n\n// `fs::read_dir(p)?`: each item an io::Result<DirEntry>. Dropping it\n// closes the directory.\npub struct ReadDir { dir: SysDir }\n\nimpl Drop for ReadDir {\n    fn drop(inout self) {\n        let _ = sys_closedir(&self.dir);\n    }\n}\n\n");
        buf_str(out, c"impl Iterator for ReadDir {\n    type Item = Result<DirEntry>;\n\n    fn next(inout self) -> Option<Result<DirEntry>> {\n        loop {\n            var e = DirEntry { name: [0; 256], len: 0, kind: 0 };\n            match sys_readdir_into(&self.dir, &e.name) {\n                Ok(Option::Some(x)) => {\n                    e.len = x.name_len;\n                    e.kind = x.kind;\n                    let nm = e.name[..e.len];\n                    if nm == \".\" || nm == \"..\" {\n                        continue;\n                    }\n                    return Option::Some(Ok(e));\n                }\n                Ok(Option::None) => return Option::None,\n                Err(err) => return Option::Some(Err(__os_error(err))),\n            }\n        }\n    }\n}\n\n// A directory's entry: its name (inline, up to 256 bytes) and kind.\npub struct DirEntry { name: [u8; 256], len: i64, kind: u8 }\n\nimpl DirEntry {\n    // Its name, a view of the entry.\n    // (0.24: self is a borrow, as its result views it: conv::let_by_ref)\n    pub fn file_name(self) -> Path {\n        self.name[..self.len] as Path\n    }\n\n    // dir's path with the name after it, on allocator a.\n    pub fn path_in<A: Allocator>(self, dir: [u8], a: sink A) -> PathBuf<A> {\n        var p: PathBuf<A> = PathBuf::from_in(dir, a);\n        p.push(self.name[..self.len]);\n        p\n    }\n\n    // Whether the file system says it is a directory (false when it does\n    // not say: fs::metadata knows).\n    pub fn is_dir(self) -> bool {\n        self.kind == SYS_DT_DIR\n    }\n\n    pub fn is_file(self) -> bool {\n        self.kind == SYS_DT_REG\n    }\n\n    pub fn is_symlink(self) -> bool {\n        self.kind == SYS_DT_LNK\n    }\n}\n// ---- end mod std::fs ----\n}\n// ---- mod std::env ----\npub mod env {\n// std::env (0.20, docs/design/collections-text-io.md §2.6.3, task B6):\n// the program's arguments and environment, with Rust's names. `args()`\n");
        buf_str(out, c"// yields views of argv, valid for the whole program (no allocation);\n// a variable's value is copied (`get_in`), since the environment can\n// change under a view. (Rust's `env::var` is `env::get` here: `var`\n// is a word, a keyword from 0.21.)\n\nuse std::{Allocator, Display, Fmt, Gpa, Iterator, Option, Result, Vec, sys_args};\nuse std::io::error::{Error, ErrorKind, __io_error, __os_error};\nuse std::path::PathBuf;\nuse std::str::validate_utf8;\nuse std::string::{String, str};\nuse std::sys::{\n    sys_chdir, sys_cstr_view, sys_env_at, sys_env_count, sys_getcwd_into, sys_getenv, sys_setenv,\n    sys_unsetenv,\n};\n\n// ---- Arguments (0.20) ----\n\n// The i-th argument's bytes (i < n), of the argv `args()` read: `next`\n// does no io where reading them does (Linux's /proc/self/cmdline, 0.24:\n// std::cli's #[no_io] parse takes an Args).\nfn arg_bytes(argv: **u8, n: i64, i: i64) -> [u8] {\n    if i < 0 || i >= n {\n        std::panic_str(\"env: argument index out of bounds\");\n    }\n    // (argv[0..argc] are crt's NUL-ended strings, for the whole program)\n    unsafe { sys_cstr_view(argv[i]) }\n}\n\n// The arguments, the program's name first: `for a in env::args()`,\n// `env::args().collect_in(gpa)`. One that is not UTF-8 stops the program\n// (as Rust's); `args_os()` yields bytes.\npub fn args() -> Args {\n    let (n, argv) = sys_args();\n    Args { i: 0, n: n, argv: argv }\n}\n\n// The arguments as bytes.\npub fn args_os() -> ArgsOs {\n    let (n, argv) = sys_args();\n    ArgsOs { i: 0, n: n, argv: argv }\n}\n\npub struct Args { i: i64, n: i64, argv: **u8 }\n\nimpl Iterator for Args {\n    type Item = str;\n\n    fn next(inout self) -> Option<str> {\n        if self.i >= self.n {\n            return Option::None;\n        }\n        let b = arg_bytes(self.argv, self.n, self.i);\n        self.i += 1;\n        match str::from_utf8(b) {\n            Ok(s) => Option::Some(s),\n            Err(_) => std::panic_str(\n");
        buf_str(out, c"                \"env::args: an argument is not UTF-8 (env::args_os yields bytes)\"),\n        }\n    }\n\n    fn exact_len(self) -> i64 {\n        self.n - self.i\n    }\n}\n\nimpl Args {\n    // The arguments left.\n    pub fn len(self) -> i64 {\n        self.n - self.i\n    }\n\n    // Skips the first n (`env::args().skip(1)`: the program's name).\n    pub fn skip(self, n: i64) -> Args {\n        var a = self;\n        a.i = if a.i + n < a.n { a.i + n } else { a.n };\n        a\n    }\n}\n\npub struct ArgsOs { i: i64, n: i64, argv: **u8 }\n\nimpl Iterator for ArgsOs {\n    type Item = [u8];\n\n    fn next(inout self) -> Option<[u8]> {\n        if self.i >= self.n {\n            return Option::None;\n        }\n        let b = arg_bytes(self.argv, self.n, self.i);\n        self.i += 1;\n        Option::Some(b)\n    }\n}\n\n// ---- The environment (0.20) ----\n\n// Why env::get_in failed: the variable is not set, or its value is not\n// UTF-8.\n#[derive(Eq, Debug, Clone)]\npub enum VarError { NotPresent, NotUnicode }\n\nimpl Display for VarError {\n    fn fmt(self, f: inout Fmt) {\n        match self {\n            VarError::NotPresent => f.str(\"environment variable not found\"),\n            VarError::NotUnicode => f.str(\"environment variable was not valid unicode\"),\n        }\n    }\n}\n\n// The value of variable name, copied into a new String on allocator a.\npub fn get_in<A: Allocator>(name: [u8], a: sink A) -> Result<String<A>, VarError> {\n    match sys_getenv(name) {\n        Option::Some(v) => match validate_utf8(v) {\n            Ok(_) => Ok(String::from_in(v as str, a)),\n            Err(_) => Err(VarError::NotUnicode),\n        },\n        Option::None => Err(VarError::NotPresent),\n    }\n}\n\n// (0.16: an error outside std, front/ambient.vl)\n#[ambient(\"get_in(name, gpa)\")]\npub fn get(name: [u8]) -> Result<String, VarError> {\n    get_in(name, Gpa::ambient())\n}\n\n// The value of variable name, its bytes copied into a new Vec on a.\n");
        buf_str(out, c"pub fn var_os_in<A: Allocator>(name: [u8], a: sink A) -> Option<Vec<u8, A>> {\n    match sys_getenv(name) {\n        Option::Some(v) => {\n            var out: Vec<u8, A> = Vec::with_capacity_in(v.len, a);\n            out.extend_from_slice(v);\n            Option::Some(out)\n        }\n        Option::None => Option::None,\n    }\n}\n\n// Whether variable name is set.\npub fn var_is_set(name: [u8]) -> bool {\n    sys_getenv(name).is_some()\n}\n\n// Every variable, (name, value) copied into Strings on allocator a (the\n// ones that are not UTF-8 left out).\npub fn vars_in<A: Allocator>(a: sink A) -> Vec<(String<A>, String<A>), A> {\n    var out: Vec<(String<A>, String<A>), A> = Vec::new_in(a);\n    for i in 0..sys_env_count() {\n        let kv = sys_env_at(i);\n        var eq = -1;\n        for k in 0..kv.len {\n            if kv[k] == '=' {\n                eq = k;\n                break;\n            }\n        }\n        if eq < 0 || validate_utf8(kv).is_err() {\n            continue;\n        }\n        let name: String<A> = String::from_in(kv[..eq] as str, a);\n        let value: String<A> = String::from_in(kv[eq + 1..] as str, a);\n        out.push((name, value));\n    }\n    out\n}\n\n// Sets variable name to value (Rust 2024's `unsafe fn`: no other thread\n// may read the environment meanwhile, and views of it end).\npub unsafe fn set_var(name: [u8], value: [u8]) {\n    let _ = sys_setenv(name, value);\n}\n\npub unsafe fn remove_var(name: [u8]) {\n    let _ = sys_unsetenv(name);\n}\n\n// ---- The working directory (0.20) ----\n\n// The current directory, in a new PathBuf on allocator a.\npub fn current_dir_in<A: Allocator>(a: sink A) -> std::io::Result<PathBuf<A>> {\n    var buf: [u8; 4096] = [0; 4096];\n    match sys_getcwd_into(&buf[..]) {\n        Ok(n) => Ok(PathBuf::from_in(buf[..n], a)),\n        Err(e) => Err(__os_error(e)),\n    }\n}\n\npub fn set_current_dir(path: [u8]) -> std::io::Result<()> {\n    match sys_chdir(path) {\n        Ok(_) => Ok(()),\n");
        buf_str(out, c"        Err(e) => Err(__os_error(e)),\n    }\n}\n// ---- end mod std::env ----\n}\n// ---- mod std::process ----\npub mod process {\n// std::process (0.20, docs/design/collections-text-io.md §2.6.3, task\n// B6): running programs, with Rust's names, through posix_spawnp\n// (std::sys). A Command keeps its program and up to 32 arguments as\n// views, inline, and builds argv on the stack when it runs (each argument\n// and the program's name up to 4 KB in all: InvalidInput beyond), so\n// `Command::new(p)` allocates nothing; `output_in(gpa)` puts what the\n// child writes in Vecs on gpa. `c.arg(x)` changes c in place (Rust's\n// `&mut Command`): `let mut c = Command::new(\"ls\"); c.arg(\"-l\");\n// let out = c.output_in(gpa)?;`.\n\nuse std::{Allocator, Display, Fmt, Option, Vec};\nuse std::io::error::{Error, ErrorKind, Result, __io_error, __os_error};\nuse std::sys::{\n    SYS_EINTR, SYS_O_RDWR, SYS_POLLHUP, SYS_POLLIN, SysPollFd, SysSpawnActions, sys_close,\n    sys_exit_code, sys_exit_signal, sys_kill, sys_open, sys_pipe, sys_poll, sys_read, sys_spawn,\n    sys_spawn_actions, sys_waitpid,\n};\n\n// ---- Processes (0.20) ----\n\nconst MAX_ARGS: i64 = 32;\nconst ARG_TEXT: i64 = 4096;\n\n// What a child's stdin, stdout or stderr is: this process's (inherit),\n// /dev/null (null), or a pipe to this process (piped: output_in's).\n#[derive(Eq, Debug, Clone)]\npub enum Stdio { Inherit, Null, Piped }\n\nimpl Stdio {\n    pub fn inherit() -> Stdio { Stdio::Inherit }\n    pub fn null() -> Stdio { Stdio::Null }\n    pub fn piped() -> Stdio { Stdio::Piped }\n}\n\n// A program to run, its arguments and its streams.\npub struct Command {\n    prog: [u8],\n    args: [[u8]; 32],\n    count: i64,\n    stdin: Stdio,\n    stdout: Stdio,\n    stderr: Stdio,\n}\n\n// How a child ended: its exit code, or the signal that ended it.\n#[derive(Eq, Debug, Clone)]\npub struct ExitStatus { status: i32 }\n\nimpl ExitStatus {\n    // Whether it exited with 0.\n    pub fn success(self) -> bool {\n");
        buf_str(out, c"        match sys_exit_code(self.status) {\n            Option::Some(c) => c == 0,\n            Option::None => false,\n        }\n    }\n\n    // Its exit code (None when a signal ended it).\n    pub fn code(self) -> Option<i32> {\n        sys_exit_code(self.status)\n    }\n\n    // The signal that ended it.\n    pub fn signal(self) -> Option<i32> {\n        sys_exit_signal(self.status)\n    }\n}\n\nimpl Display for ExitStatus {\n    fn fmt(self, f: inout Fmt) {\n        match sys_exit_code(self.status) {\n            Option::Some(c) => {\n                f.str(\"exit status: \");\n                f.int(c as i64);\n            }\n            Option::None => {\n                f.str(\"signal: \");\n                f.int(self.status as i64 & 0x7f);\n            }\n        }\n    }\n}\n\n// What output_in returns: how the child ended, and what it wrote.\npub struct Output<A: Allocator> {\n    pub status: ExitStatus, pub stdout: Vec<u8, A>, pub stderr: Vec<u8, A>\n}\n\n// A running child: wait for it (dropping it does not).\npub struct Child { pid: i32, done: bool, status: i32 }\n\nimpl Child {\n    pub fn id(self) -> i32 {\n        self.pid\n    }\n\n    // Waits for it to end.\n    pub fn wait(inout self) -> Result<ExitStatus> {\n        if self.done {\n            return Ok(ExitStatus { status: self.status });\n        }\n        let st = wait_pid(self.pid)?;\n        self.done = true;\n        self.status = st;\n        Ok(ExitStatus { status: st })\n    }\n\n    // How it ended, if it has: None while it runs.\n    pub fn try_wait(inout self) -> Result<Option<ExitStatus>> {\n        if self.done {\n            return Ok(Option::Some(ExitStatus { status: self.status }));\n        }\n        match sys_waitpid(self.pid, true) {\n            Ok((p, st)) => {\n                if p == 0 {\n                    return Ok(Option::None);\n                }\n                self.done = true;\n                self.status = st;\n");
        buf_str(out, c"                Ok(Option::Some(ExitStatus { status: st }))\n            }\n            Err(e) => Err(__os_error(e)),\n        }\n    }\n\n    // Sends it SIGKILL.\n    pub fn kill(inout self) -> Result<()> {\n        match sys_kill(self.pid, 9) {\n            Ok(_) => Ok(()),\n            Err(e) => Err(__os_error(e)),\n        }\n    }\n}\n\n// Waits for pid (again when a signal interrupts): its status.\nfn wait_pid(pid: i32) -> Result<i32> {\n    loop {\n        match sys_waitpid(pid, false) {\n            Ok((_, st)) => return Ok(st),\n            Err(e) => {\n                if e != SYS_EINTR {\n                    return Err(__os_error(e));\n                }\n            }\n        }\n    }\n}\n\n// The NUL-ended copies of a command's program and arguments, and argv.\nstruct Argv { text: [u8; 4096], ptrs: [*u8; 34] }\n\nimpl Command {\n    // Runs prog: a path, or a name looked up in PATH.\n    pub fn new(prog: [u8]) -> Command {\n        Command { prog: prog, args: [\"\"; 32], count: 0, stdin: Stdio::Inherit,\n            stdout: Stdio::Inherit, stderr: Stdio::Inherit }\n    }\n\n    // Adds an argument (up to 32).\n    pub fn arg(inout self, a: [u8]) {\n        if self.count >= MAX_ARGS {\n            std::panic_str(\"Command::arg: more than 32 arguments\");\n        }\n        self.args[self.count] = a;\n        self.count += 1;\n    }\n\n    // Adds each of list.\n    pub fn args(inout self, list: [[u8]]) {\n        for a in list {\n            self.arg(a);\n        }\n    }\n\n    pub fn stdin(inout self, s: Stdio) {\n        self.stdin = s;\n    }\n\n    pub fn stdout(inout self, s: Stdio) {\n        self.stdout = s;\n    }\n\n    pub fn stderr(inout self, s: Stdio) {\n        self.stderr = s;\n    }\n\n    // argv for C, in out: InvalidInput when it does not fit or holds a NUL.\n    fn build_argv(self, out: inout Argv) -> Result<()> {\n        var at = 0;\n        for k in 0..self.count + 1 {\n");
        buf_str(out, c"            let s = if k == 0 { self.prog } else { self.args[k - 1] };\n            if at + s.len + 1 > ARG_TEXT {\n                return Err(__io_error(ErrorKind::InvalidInput, c\"arguments over 4096 bytes\"));\n            }\n            for i in 0..s.len {\n                if s[i] == 0 {\n                    return Err(__io_error(ErrorKind::InvalidInput, c\"an argument holds a NUL\"));\n                }\n                out.text[at + i] = s[i];\n            }\n            out.text[at + s.len] = 0;\n            // (text is out's: it lives as long as ptrs does)\n            out.ptrs[k] = &out.text[at] as *u8;\n            at += s.len + 1;\n        }\n        out.ptrs[self.count + 1] = 0 as *u8;\n        Ok(())\n    }\n\n    // Starts it with the streams as set (piped ones are not supported\n    // here: output_in pipes stdout and stderr).\n    pub fn spawn(self) -> Result<Child> {\n        var acts = os(sys_spawn_actions())?;\n        var null: i32 = -1;\n        let r = self.spawn_with(&acts, &null, -1, -1);\n        acts.free();\n        if null >= 0 {\n            let _ = sys_close(null);\n        }\n        let pid = r?;\n        Ok(Child { pid: pid, done: false, status: 0 })\n    }\n\n    // Runs it, waits for it: how it ended.\n    pub fn status(self) -> Result<ExitStatus> {\n        var c = self.spawn()?;\n        c.wait()\n    }\n\n    // Runs it with stdout and stderr piped to this process (stdin\n    // inherited), and waits: how it ended and what it wrote, in Vecs on a.\n    pub fn output_in<A: Allocator>(self, a: sink A) -> Result<Output<A>> {\n        let (out_r, out_w) = os(sys_pipe())?;\n        let (err_r, err_w) = match sys_pipe() {\n            Ok(p) => p,\n            Err(e) => {\n                let _ = sys_close(out_r);\n                let _ = sys_close(out_w);\n                return Err(__os_error(e));\n            }\n        };\n        var acts = os(sys_spawn_actions())?;\n        var null: i32 = -1;\n");
        buf_str(out, c"        let r = self.spawn_with(&acts, &null, out_w, err_w);\n        acts.free();\n        let _ = sys_close(out_w);\n        let _ = sys_close(err_w);\n        if null >= 0 {\n            let _ = sys_close(null);\n        }\n        let pid = match r {\n            Ok(p) => p,\n            Err(e) => {\n                let _ = sys_close(out_r);\n                let _ = sys_close(err_r);\n                return Err(e);\n            }\n        };\n        var stdout: Vec<u8, A> = Vec::new_in(a);\n        var stderr: Vec<u8, A> = Vec::new_in(a);\n        let got = drain_two(out_r, err_r, &stdout, &stderr);\n        let _ = sys_close(out_r);\n        let _ = sys_close(err_r);\n        let st = wait_pid(pid)?;\n        got?;\n        Ok(Output { status: ExitStatus { status: st }, stdout: stdout, stderr: stderr })\n    }\n\n    // Spawns it with the file actions for its streams in acts (out_w,\n    // err_w: pipes for stdout and stderr, or -1); /dev/null, when one is\n    // Null, opened into *null.\n    fn spawn_with(self, acts: inout SysSpawnActions, null: inout i32, out_w: i32,\n        err_w: i32) -> Result<i32> {\n        let wants_null = self.stdin == Stdio::Null || self.stdout == Stdio::Null\n            || self.stderr == Stdio::Null;\n        if wants_null {\n            let fd = os(sys_open(\"/dev/null\", SYS_O_RDWR, 0))?;\n            null = fd;\n        }\n        let nfd = null;\n        if self.stdin == Stdio::Null {\n            os(acts.dup2(nfd, 0))?;\n        }\n        if out_w >= 0 {\n            os(acts.dup2(out_w, 1))?;\n        } else if self.stdout == Stdio::Null {\n            os(acts.dup2(nfd, 1))?;\n        }\n        if err_w >= 0 {\n            os(acts.dup2(err_w, 2))?;\n        } else if self.stderr == Stdio::Null {\n            os(acts.dup2(nfd, 2))?;\n        }\n        var argv = Argv { text: [0; 4096], ptrs: [0 as *u8; 34] };\n        self.build_argv(&argv)?;\n        let envp: [*u8; 0] = [];\n");
        buf_str(out, c"        // (argv's strings are NUL-ended and its pointers end with null:\n        // build_argv; prog is ptrs[0])\n        let r = unsafe { sys_spawn(argv.ptrs[0], argv.ptrs[..self.count + 2], envp[..], &acts) };\n        os(r)\n    }\n}\n\n// The Result of a sys call, its errno an io::Error.\n#[inline]\nfn os<T>(r: sink std::Result<T, i32>) -> Result<T> {\n    match r {\n        Ok(v) => Ok(v),\n        Err(e) => Err(__os_error(e)),\n    }\n}\n\n// Reads the pipes a and b to their ends, into va and vb (poll: neither\n// child stream blocks the other).\nfn drain_two<A: Allocator>(a: i32, b: i32, va: inout Vec<u8, A>, vb: inout Vec<u8, A>)\n    -> Result<()> {\n    var open_a = true;\n    var open_b = true;\n    while open_a || open_b {\n        var fds: [SysPollFd; 2] = [\n            SysPollFd { fd: if open_a { a } else { -1 }, events: SYS_POLLIN, revents: 0 },\n            SysPollFd { fd: if open_b { b } else { -1 }, events: SYS_POLLIN, revents: 0 },\n        ];\n        match sys_poll(fds[..], -1) {\n            Ok(_) => {}\n            Err(e) => {\n                if e == SYS_EINTR {\n                    continue;\n                }\n                return Err(__os_error(e));\n            }\n        }\n        if open_a && fds[0].revents != 0 {\n            open_a = read_some(a, &va)?;\n        }\n        if open_b && fds[1].revents != 0 {\n            open_b = read_some(b, &vb)?;\n        }\n    }\n    Ok(())\n}\n\n// Reads what fd has into v: false at its end.\nfn read_some<A: Allocator>(fd: i32, v: inout Vec<u8, A>) -> Result<bool> {\n    if v.cap - v.len < 4096 {\n        v.reserve(if v.cap < 8192 { 8192 } else { v.cap });\n    }\n    // (v's room: its capacity past its length)\n    let room = unsafe { v.ptr[v.len..v.cap] };\n    match sys_read(fd, &room) {\n        Ok(n) => {\n            v.len += n;\n            Ok(n > 0)\n        }\n        Err(e) => if e == SYS_EINTR { Ok(true) } else { Err(__os_error(e)) },\n    }\n}\n\n");
        buf_str(out, c"// Ends this process with code (Rust's `std::process::exit`); what print\n// buffered is written out first.\npub fn exit(code: i32) -> ! {\n    std::fmt::__flush_print();\n    unsafe { std::exit(code) }\n}\n\n// This process's id.\npub fn id() -> i32 {\n    std::sys::sys_getpid()\n}\n// ---- end mod std::process ----\n}\n// ---- mod std::window ----\npub mod window {\n// std::window: windows and input (docs/design/terminal.md §2), winit's\n// objects with a pull-model event loop. 0.23.0 has the Cocoa backend\n// (cocoa.vl); Wayland and X11 come in 0.23.1 beside it, behind the same\n// `Backend` trait. objc.vl is the Objective-C layer the backend calls\n// until std::objc (0.22) replaces it; tables/ lists every method it\n// calls, for objcgen's runtime check. A program that uses std::window\n// links AppKit, QuartzCore, CoreFoundation, CoreGraphics and libobjc\n// (0.25: cocoa.vl's and objc.vl's extern blocks say so, `#[link]`).\n//\n// Events are pulled (D1): `app.wait()` blocks until one is ready,\n// `app.poll()` returns at once, `app.wait_timeout(ms)` waits at most that\n// long. An event is a plain value; nothing allocates per event once the\n// queue has grown to its working size. Frames come on request (D2):\n// `win.request_frame()` asks for one `Event::Frame` at the next display\n// refresh, and an idle application wakes up never. A watched file\n// descriptor (D3) delivers `Event::Readable` from inside `wait`, which\n// is how the terminal serves its pty before 0.21's threads.\n//\n// `App` and `Window` release their Cocoa objects when dropped; drop the\n// windows before the App. The live-resize hook is a plain `fn(*u8)` with\n// a context pointer (a closure once callbacks can borrow).\n\n// ---- Windows and input (0.23) ----\n\npub mod cocoa;\npub mod keys;\nmod objc;\n\nuse keys::{KeyCode, Logical, Mods};\n\npub struct WindowId {\n    pub n: i64,\n}\n\nimpl WindowId {\n    pub fn eq(self, o: WindowId) -> bool {\n        self.n == o.n\n    }\n}\n\n");
        buf_str(out, c"// A size in physical pixels, and the scale from logical points (2.0 on\n// a Retina display).\npub struct Size {\n    pub w: i64,\n    pub h: i64,\n    pub scale: f64,\n}\n\n// A key press, repeat or release. `ime` is true when an input method\n// took the key (composition in progress before or after it): a terminal\n// does not encode it. `text_follows` is true when the key produced text,\n// delivered by the `Event::Text` right after this event (a terminal\n// sends the text, not an encoding of the key, unless it treats Option as\n// Meta).\npub struct Key {\n    pub win: WindowId,\n    pub code: KeyCode,\n    pub key: Logical,\n    pub mods: Mods,\n    pub pressed: bool,\n    pub repeat: bool,\n    pub ime: bool,\n    pub text_follows: bool,\n}\n\n// Text typed or committed by an input method, its UTF-8 bytes inline\n// (D4): a longer commit arrives as several events, never split inside a\n// character. Its text is `t.bytes[0..t.len as i64]` (0.20: a Text is\n// plain, so a method takes a copy of it and cannot return a view of its\n// bytes).\npub struct Text {\n    pub win: WindowId,\n    pub len: u8,\n    pub bytes: [u8; 30],\n}\n\n// The input method's composition changed: `app.preedit()` is its text\n// (empty: composition ended), `cursor` a byte offset in it.\npub struct Preedit {\n    pub win: WindowId,\n    pub len: i64,\n    pub cursor: i64,\n}\n\npub enum Button {\n    Left,\n    Right,\n    Middle,\n    Other(i64),\n    None,\n}\n\npub enum MouseAction {\n    Press,\n    Release,\n    Move,\n}\n\n// A mouse button or motion; the position is in physical pixels from the\n// window's content top-left. `clicks` counts a double (2) or triple (3)\n// click on presses.\npub struct Mouse {\n    pub win: WindowId,\n    pub action: MouseAction,\n    pub button: Button,\n    pub x: f64,\n    pub y: f64,\n    pub mods: Mods,\n    pub clicks: i64,\n}\n\n// Scrolling: `precise` deltas are in physical pixels (a trackpad);\n");
        buf_str(out, c"// otherwise in lines (a wheel). Positive dy scrolls up (content moves\n// down), as AppKit and winit report it.\npub struct Scroll {\n    pub win: WindowId,\n    pub dx: f64,\n    pub dy: f64,\n    pub precise: bool,\n    pub mods: Mods,\n}\n\npub enum Event {\n    // A frame asked for by `request_frame`: draw now.\n    Frame(WindowId),\n    Key(Key),\n    Text(Text),\n    Preedit(Preedit),\n    // The content's new size (also its first size, after `window`).\n    Resize(WindowId, Size),\n    Mouse(Mouse),\n    Scroll(Scroll),\n    // The pointer entered (true) or left the window.\n    Cursor(WindowId, bool),\n    Focus(WindowId, bool),\n    // A watched file descriptor is readable.\n    Readable(i32),\n    // The user asked to close the window (it stays open until `close`).\n    Close(WindowId),\n    // The user chose Quit (Command-Q).\n    Quit,\n}\n\npub enum Error {\n    // No window server (a headless session, ssh).\n    NoDisplay,\n    Failed([u8]),\n}\n\npub enum CursorIcon {\n    Arrow,\n    Text,\n    Pointer,\n}\n\npub struct WindowDesc {\n    pub title: [u8],\n    // Logical points.\n    pub w: i64,\n    pub h: i64,\n    pub min_w: i64,\n    pub min_h: i64,\n    pub resizable: bool,\n}\n\nimpl WindowDesc {\n    pub fn new(title: [u8], w: i64, h: i64) -> WindowDesc {\n        WindowDesc { title: title, w: w, h: h, min_w: 100, min_h: 60, resizable: true }\n    }\n}\n\n// What each backend provides (D6). App and Window call the one the\n// target's OS has, statically.\npub trait Backend {\n    fn open_window(inout self, desc: WindowDesc, id: WindowId) -> Result<Window, Error>;\n    fn next_event(inout self, ms: i64) -> Option<Event>;\n    fn watch(inout self, fd: i32) -> bool;\n    fn unwatch(inout self, fd: i32);\n    fn clipboard_get_in<A: Allocator>(self, a: sink A) -> Option<Buf<A>>;\n    fn clipboard_set(self, text: [u8]);\n    fn preedit(self) -> [u8];\n    fn set_live_resize(inout self, f: fn(*u8), ctx: *u8);\n    fn close(inout self);\n}\n\n");
        buf_str(out, c"pub struct App {\n    b: cocoa::Cocoa,\n    next_id: i64,\n}\n\nimpl App {\n    // The application: on macOS, NSApplication without a bundle (a\n    // regular app with a Dock icon and a menu with Quit). Err(NoDisplay)\n    // when there is no window server.\n    pub fn new_in(gpa: Gpa) -> Result<App, Error> {\n        match cocoa::Cocoa::new_in(gpa) {\n            Ok(b) => Ok(App { b: b, next_id: 1 }),\n            Err(e) => Err(e),\n        }\n    }\n\n    pub fn window(inout self, desc: WindowDesc) -> Result<Window, Error> {\n        let id = WindowId { n: self.next_id };\n        self.next_id += 1;\n        self.b.open_window(desc, id)\n    }\n\n    // The next event, waiting as long as it takes.\n    pub fn wait(inout self) -> Result<Event, Error> {\n        loop {\n            match self.b.next_event(-1) {\n                Some(e) => return Ok(e),\n                None => {}\n            }\n        }\n    }\n\n    // The next event if one is ready.\n    pub fn poll(inout self) -> Option<Event> {\n        self.b.next_event(0)\n    }\n\n    // The next event within `ms` milliseconds.\n    pub fn wait_timeout(inout self, ms: i64) -> Option<Event> {\n        self.b.next_event(if ms < 0 { 0 } else { ms })\n    }\n\n    // Delivers `Event::Readable(fd)` whenever `fd` has data, from inside\n    // wait/poll (until `unwatch`). False if the fd cannot be watched.\n    pub fn watch(inout self, fd: i32) -> bool {\n        self.b.watch(fd)\n    }\n\n    pub fn unwatch(inout self, fd: i32) {\n        self.b.unwatch(fd);\n    }\n\n    // The clipboard's text, in a Buf of `a` (a frame's ScopedArena for a\n    // paste that is sent and forgotten).\n    pub fn clipboard_get_in<A: Allocator>(self, a: sink A) -> Option<Buf<A>> {\n        self.b.clipboard_get_in(a)\n    }\n\n    pub fn clipboard_set(self, text: [u8]) {\n        self.b.clipboard_set(text);\n    }\n\n    // The input method's current composition (see Event::Preedit), a view\n    // valid until the next event.\n");
        buf_str(out, c"    pub fn preedit(self) -> [u8] {\n        self.b.preedit()\n    }\n\n    // macOS runs a loop of its own while the user drags a window's edge,\n    // so `wait` does not return until the drag ends. `f(ctx)` is called\n    // for each size change during the drag: it can `poll` (only the\n    // queued events are returned there) and draw. The one callback of the\n    // API (terminal.md §2.1).\n    pub fn on_live_resize(inout self, f: fn(*u8), ctx: *u8) {\n        self.b.set_live_resize(f, ctx);\n    }\n}\n\n// The application's state is released with it (its windows should be\n// dropped first: they do not outlive the App).\nimpl Drop for App {\n    fn drop(inout self) {\n        self.b.close();\n    }\n}\n\n// A window: its Cocoa objects, retained until it is dropped (or closed).\npub struct Window {\n    pub id: WindowId,\n    pub ns: cocoa::NsWindow,\n}\n\nimpl Window {\n    // One Event::Frame at the next refresh of the window's display.\n    pub fn request_frame(self) {\n        self.ns.request_frame();\n    }\n\n    pub fn size(self) -> Size {\n        self.ns.size()\n    }\n\n    // The CAMetalLayer (on macOS) a GPU surface is made on.\n    pub fn raw_surface(self) -> *u8 {\n        self.ns.layer\n    }\n\n    pub fn set_title(self, t: [u8]) {\n        self.ns.set_title(t);\n    }\n\n    pub fn set_cursor(self, c: CursorIcon) {\n        self.ns.set_cursor(c);\n    }\n\n    // Hides the pointer until the mouse moves (while typing).\n    pub fn hide_cursor_while_typing(self) {\n        cocoa::hide_cursor_until_moved();\n    }\n\n    // Where the input method's candidate window goes: the text cursor's\n    // rectangle in physical pixels from the content's top-left.\n    pub fn set_ime_area(self, x: f64, y: f64, w: f64, h: f64) {\n        self.ns.set_ime_area(x, y, w, h);\n    }\n\n    pub fn set_fullscreen(self, on: bool) {\n        self.ns.set_fullscreen(on);\n    }\n\n    pub fn is_fullscreen(self) -> bool {\n        self.ns.is_fullscreen()\n    }\n\n");
        buf_str(out, c"    pub fn focused(self) -> bool {\n        self.ns.focused()\n    }\n\n    // Closes the window now (dropping it does the same).\n    pub fn close(inout self) {\n        self.ns.close();\n    }\n}\n\nimpl Drop for Window {\n    fn drop(inout self) {\n        self.ns.close();\n    }\n}\n// ---- mod std::window::cocoa ----\npub mod cocoa {\n// The Cocoa backend (terminal.md §2.3, task W1): NSApplication without a\n// bundle or a nib, a runtime NSView subclass with a CAMetalLayer, events\n// drained with nextEventMatchingMask and sendEvent, NSTextInputClient for\n// input methods, CADisplayLink frames, CFFileDescriptor watches.\n//\n// Its message calls go through objc.vl's hand-typed shapes, each with\n// the selector's documented C types, and every one is listed in\n// tables/appkit.objc and tables/quartzcore.objc, which objcgen --check\n// verifies against the runtime; when std::objc lands they are generated\n// from those tables instead.\n//\n// Pitfalls of running AppKit from a plain executable, and what is done\n// about each:\n// - No bundle: the process starts as a background app with no Dock icon\n//   and no menu bar. `setActivationPolicy: Regular` makes it a regular\n//   app; `finishLaunching` must be called since `[NSApp run]` is not;\n//   then `activateIgnoringOtherApps:` (again after the first window is\n//   shown, or a terminal that launched it keeps the focus).\n// - No nib: the menu bar is built by hand (an app menu with Quit, which\n//   targets our own object, so Command-Q is an Event::Quit, not exit()).\n// - No [NSApp run]: events are pulled with\n//   nextEventMatchingMask:untilDate:inMode:dequeue: and dispatched with\n//   sendEvent:, each batch inside an autorelease pool. Run-loop sources\n//   (the display link, watched fds) fire inside nextEventMatchingMask\n//   without an NSEvent, so it would not return: they post an\n//   application-defined NSEvent to wake it, which is dropped.\n");
        buf_str(out, c"// - Key input goes through interpretKeyEvents:, which needs the view to\n//   be the first responder and to implement NSTextInputClient, including\n//   doCommandBySelector: (without it, every Return or arrow beeps).\n// - Command-key releases: NSApplication does not send keyUp: for a key\n//   pressed with Command (a known AppKit quirk); such releases are not\n//   reported.\n// - Live resize runs AppKit's own loop: windowDidResize: calls the one\n//   hook (App::on_live_resize) so the application can draw during the\n//   drag.\n// - Mouse moves need setAcceptsMouseMovedEvents: and a tracking area\n//   (enter and leave too).\n// - The display link (NSView.displayLinkWithTarget:selector:, macOS 14)\n//   runs on the main run loop in common modes: no thread, so no callback\n//   arrives off the main thread before 0.21 (gpu.md §2.11).\n// - A headless session (ssh, no window server) makes NSApplication abort\n//   the process: CGSessionCopyCurrentDictionary is asked first, and\n//   App::new_in returns Err(NoDisplay).\n\n// ---- The Cocoa backend (0.23) ----\n\nuse keys::{\n    first_char, mac_keycode, mac_logical, mac_modifier_down, mac_mods, utf16_to_byte, utf8_cut,\n};\nuse super::{\n    Button, CursorIcon, Error, Event, Key, Mouse, MouseAction, Preedit, Scroll, Size, Text, Window,\n    WindowDesc, WindowId,\n};\nuse super::objc::{\n    NOT_FOUND, Point, Range, Rect, class, class_addIvar, class_addProtocol,\n    class_getInstanceVariable, ivar_getOffset, method_types, msg_b, msg_b_i, msg_b_p, msg_b_pp,\n    msg_d, msg_h, msg_i, msg_p, msg_p_d, msg_p_p, msg_p_pp, msg_p_ppp, msg_p_r, msg_p_rupp,\n    msg_p_ruub, msg_p_u, msg_p_uppb, msg_p_utudipsii, msg_r, msg_r_r, msg_r_rp, msg_t, msg_t_tp,\n    msg_u, msg_v, msg_v_b, msg_v_d, msg_v_p, msg_v_pb, msg_v_pp, msg_v_rp, msg_v_u, msg_v_z,\n    nsstring, nsstring_bytes, objc_allocateClassPair, objc_getProtocol, objc_registerClassPair,\n    pool_pop, pool_push, release, retain, sel,\n};\nuse super::objc::Size as NsSize;\n");
        buf_str(out, c"\n// (0.25) What the Cocoa backend links: AppKit and the frameworks under it.\n#[link(framework = \"AppKit\", framework = \"QuartzCore\", framework = \"CoreGraphics\")]\n#[link(framework = \"CoreFoundation\", framework = \"Foundation\")]\nextern \"C\" {\n    static NSDefaultRunLoopMode: *u8;\n    static NSRunLoopCommonModes: *u8;\n    static NSPasteboardTypeString: *u8;\n    static kCFRunLoopDefaultMode: *u8;\n    fn CGSessionCopyCurrentDictionary() -> *u8;\n    fn CFRelease(o: *u8);\n    fn CFRunLoopGetMain() -> *u8;\n    fn CFRunLoopAddSource(rl: *u8, src: *u8, mode: *u8);\n    fn CFRunLoopRemoveSource(rl: *u8, src: *u8, mode: *u8);\n\n    fn CFFileDescriptorCreate(alloc: *u8, fd: i32, close_on_invalidate: bool,\n        callout: extern \"C\" fn(*u8, u64, *u8), ctx: *FdContext) -> *u8;\n\n    fn CFFileDescriptorEnableCallBacks(f: *u8, types: u64);\n    fn CFFileDescriptorCreateRunLoopSource(alloc: *u8, f: *u8, order: i64) -> *u8;\n    fn CFFileDescriptorGetNativeDescriptor(f: *u8) -> i32;\n    fn CFFileDescriptorInvalidate(f: *u8);\n\n    // class_addMethod, once per IMP shape (an `extern \"C\" fn` type does\n    // not cast to another, so each shape has its own declaration).\n    #[link_name = \"class_addMethod\"]\n    fn add_v(c: *u8, s: *u8, imp: extern \"C\" fn(*u8, *u8), t: *u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    fn add_v_p(c: *u8, s: *u8, imp: extern \"C\" fn(*u8, *u8, *u8), t: *u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    fn add_b(c: *u8, s: *u8, imp: extern \"C\" fn(*u8, *u8) -> bool, t: *u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    fn add_b_p(c: *u8, s: *u8, imp: extern \"C\" fn(*u8, *u8, *u8) -> bool, t: *u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    fn add_g(c: *u8, s: *u8, imp: extern \"C\" fn(*u8, *u8) -> Range, t: *u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    fn add_p(c: *u8, s: *u8, imp: extern \"C\" fn(*u8, *u8) -> *u8, t: *u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n");
        buf_str(out, c"    fn add_v_pg(c: *u8, s: *u8, imp: extern \"C\" fn(*u8, *u8, *u8, Range), t: *u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    fn add_v_pgg(c: *u8, s: *u8, imp: extern \"C\" fn(*u8, *u8, *u8, Range, Range), t: *u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    fn add_p_gP(c: *u8, s: *u8, imp: extern \"C\" fn(*u8, *u8, Range, *Range) -> *u8, t: *u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    fn add_r_gP(c: *u8, s: *u8, imp: extern \"C\" fn(*u8, *u8, Range, *Range) -> Rect, t: *u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    fn add_u_t(c: *u8, s: *u8, imp: extern \"C\" fn(*u8, *u8, Point) -> u64, t: *u8) -> bool;\n}\n\n// CFFileDescriptorContext; the callbacks we do not use are null.\n#[repr(C)]\nstruct FdContext {\n    version: i64,\n    info: *u8,\n    retain: *u8,\n    release: *u8,\n    describe: *u8,\n}\n\n// NSEventType values.\nconst EV_LEFT_DOWN: u64 = 1;\nconst EV_LEFT_UP: u64 = 2;\nconst EV_RIGHT_DOWN: u64 = 3;\nconst EV_RIGHT_UP: u64 = 4;\nconst EV_MOVED: u64 = 5;\nconst EV_LEFT_DRAGGED: u64 = 6;\nconst EV_RIGHT_DRAGGED: u64 = 7;\nconst EV_APP_DEFINED: u64 = 15;\nconst EV_OTHER_DOWN: u64 = 25;\nconst EV_OTHER_UP: u64 = 26;\nconst EV_OTHER_DRAGGED: u64 = 27;\n\n// data1 of our wake-up NSEvent.\nconst WAKE: i64 = 0x74616368;\n\n// The view's instance variable \"vole\": the window id, the cursor\n// shape, the input method area (physical pixels).\nstruct ViewData {\n    id: i64,\n    cursor: i64,\n    ime_x: f64,\n    ime_y: f64,\n    ime_w: f64,\n    ime_h: f64,\n}\n\nstruct Watch {\n    fd: i32,\n    cf: *u8,\n    src: *u8,\n    armed: bool,\n}\n\n// What the IMPs and run-loop callbacks reach: one per process (AppKit\n// has one NSApp), on the heap, pointed to by ST while the App lives.\nstruct State {\n    q: Vec<Event>,\n    head: i64,\n    // The current composition, and whether there is one.\n    preedit: Buf,\n    marked: bool,\n    // Text produced while a keyDown: is interpreted, sent after its Key.\n");
        buf_str(out, c"    in_key: bool,\n    key_text: Buf,\n    // Inside nextEventMatchingMask (a callback must wake it), and\n    // whether a wake-up is already posted.\n    waiting: bool,\n    wake_posted: bool,\n    // The live-resize hook, and whether it is running.\n    hook: Option<fn(*u8)>,\n    hook_ctx: *u8,\n    in_hook: bool,\n    watches: Vec<Watch>,\n    app: *u8,\n    delegate: *u8,\n    target: *u8,\n    view_class: *u8,\n    ivar_off: i64,\n}\n\n// The State of the App (null when there is none). Statics are safe to\n// use on one thread; the pointer is dereferenced in unsafe blocks only.\nstatic var ST: *State = 0 as *State;\n\npub struct Cocoa {\n    // The State's storage (one element: its address is stable).\n    st: Vec<State>,\n}\n\n// SAFETY (for every `unsafe { ST... }` below): ST points to the element\n// of the App's `st` Vec from new_in until close, which nulls it; IMPs and\n// callbacks run on the main thread only, inside App calls (sendEvent:,\n// nextEventMatchingMask:, window creation and closing), so the State is\n// live whenever they run and nothing else holds a reference to it then.\nfn st_live() -> bool {\n    unsafe { ST != 0 as *State }\n}\n\nfn push(e: Event) {\n    // SAFETY: see st_live.\n    unsafe {\n        if ST == 0 as *State {\n            return;\n        }\n        ST.q.push(e);\n        if ST.waiting && !ST.wake_posted {\n            ST.wake_posted = true;\n            post_wake(ST.app);\n        }\n    }\n}\n\n// Posts an application-defined event, so nextEventMatchingMask returns.\nunsafe fn post_wake(app: *u8) {\n    let ev = msg_p_utudipsii(class(c\"NSEvent\"),\n        sel(c\"otherEventWithType:location:modifierFlags:timestamp:windowNumber:context:subtype:data1:data2:\"),\n        EV_APP_DEFINED, Point { x: 0.0, y: 0.0 }, 0, 0.0, 0, 0 as *u8, 0, WAKE, 0);\n    msg_v_pb(app, sel(c\"postEvent:atStart:\"), ev, false);\n}\n\n// Text events for `s`, cut into pieces of at most 30 bytes at character\n// boundaries.\n");
        buf_str(out, c"fn push_text(win: WindowId, s: [u8]) {\n    var rest = s;\n    while rest.len > 0 {\n        let n = utf8_cut(rest, 30);\n        if n == 0 {\n            break;\n        }\n        var t = Text { win: win, len: n as u8, bytes: [0; 30] };\n        for i in 0..n {\n            t.bytes[i] = rest[i];\n        }\n        push(Event::Text(t));\n        rest = rest[n..rest.len];\n    }\n}\n\n// The view's data (an instance variable at a known offset).\nunsafe fn vdata(view: *u8) -> *ViewData {\n    &view[ST.ivar_off] as *ViewData\n}\n\nunsafe fn view_id(view: *u8) -> WindowId {\n    WindowId { n: vdata(view).id }\n}\n\n// The window's backing scale (2.0 on Retina).\nunsafe fn scale_of(view: *u8) -> f64 {\n    let w = msg_p(view, sel(c\"window\"));\n    if w == 0 as *u8 {\n        return 1.0;\n    }\n    msg_d(w, sel(c\"backingScaleFactor\"))\n}\n\nunsafe fn view_size(view: *u8) -> Size {\n    let b = msg_r(view, sel(c\"bounds\"));\n    let s = scale_of(view);\n    Size { w: (b.w * s + 0.5) as i64, h: (b.h * s + 0.5) as i64, scale: s }\n}\n\n// Sets the layer's scale and drawable size to the view's.\nunsafe fn sync_layer(view: *u8) -> Size {\n    let sz = view_size(view);\n    let layer = msg_p(view, sel(c\"layer\"));\n    if layer != 0 as *u8 {\n        msg_v_d(layer, sel(c\"setContentsScale:\"), sz.scale);\n        msg_v_z(layer, sel(c\"setDrawableSize:\"), NsSize { w: sz.w as f64, h: sz.h as f64 });\n    }\n    sz\n}\n\n// ---- the view's methods (IMPs) (0.23) ----\n\nextern \"C\" fn imp_yes(this: *u8, cmd: *u8) -> bool {\n    true\n}\n\nextern \"C\" fn imp_yes_p(this: *u8, cmd: *u8, a: *u8) -> bool {\n    true\n}\n\nextern \"C\" fn imp_key_down(this: *u8, cmd: *u8, ev: *u8) {\n    if !st_live() {\n        return;\n    }\n    // SAFETY: see st_live; `ev` is the NSEvent AppKit passes; the array\n    // is autoreleased in the pool around sendEvent:.\n    unsafe {\n        let code = mac_keycode(msg_h(ev, sel(c\"keyCode\")));\n");
        buf_str(out, c"        let flags = msg_u(ev, sel(c\"modifierFlags\"));\n        let repeat = msg_b(ev, sel(c\"isARepeat\"));\n        let c = first_char(nsstring_bytes(msg_p(ev, sel(c\"charactersIgnoringModifiers\"))));\n        let id = view_id(this);\n        let had_marked = ST.marked;\n        ST.in_key = true;\n        ST.key_text.clear();\n        let arr = msg_p_p(class(c\"NSArray\"), sel(c\"arrayWithObject:\"), ev);\n        msg_v_p(this, sel(c\"interpretKeyEvents:\"), arr);\n        ST.in_key = false;\n        let text_len = ST.key_text.len();\n        push(Event::Key(Key {\n            win: id,\n            code: code,\n            key: mac_logical(c, code),\n            mods: mac_mods(flags),\n            pressed: true,\n            repeat: repeat,\n            ime: had_marked || ST.marked,\n            text_follows: text_len > 0,\n        }));\n        if text_len > 0 {\n            push_text(id, ST.key_text.as_slice());\n        }\n    }\n}\n\nextern \"C\" fn imp_key_up(this: *u8, cmd: *u8, ev: *u8) {\n    if !st_live() {\n        return;\n    }\n    // SAFETY: see st_live and imp_key_down.\n    unsafe {\n        let code = mac_keycode(msg_h(ev, sel(c\"keyCode\")));\n        let flags = msg_u(ev, sel(c\"modifierFlags\"));\n        let c = first_char(nsstring_bytes(msg_p(ev, sel(c\"charactersIgnoringModifiers\"))));\n        push(Event::Key(Key {\n            win: view_id(this),\n            code: code,\n            key: mac_logical(c, code),\n            mods: mac_mods(flags),\n            pressed: false,\n            repeat: false,\n            ime: ST.marked,\n            text_follows: false,\n        }));\n    }\n}\n\nextern \"C\" fn imp_flags_changed(this: *u8, cmd: *u8, ev: *u8) {\n    if !st_live() {\n        return;\n    }\n    // SAFETY: see imp_key_down.\n    unsafe {\n        let code = mac_keycode(msg_h(ev, sel(c\"keyCode\")));\n        let flags = msg_u(ev, sel(c\"modifierFlags\"));\n        push(Event::Key(Key {\n            win: view_id(this),\n");
        buf_str(out, c"            code: code,\n            key: mac_logical(0, code),\n            mods: mac_mods(flags),\n            pressed: mac_modifier_down(code, flags),\n            repeat: false,\n            ime: false,\n            text_follows: false,\n        }));\n    }\n}\n\nextern \"C\" fn imp_mouse(this: *u8, cmd: *u8, ev: *u8) {\n    if !st_live() {\n        return;\n    }\n    // SAFETY: see imp_key_down; convertPoint:fromView: with nil converts\n    // from the window's coordinates.\n    unsafe {\n        let ty = msg_u(ev, sel(c\"type\"));\n        let at = msg_t(ev, sel(c\"locationInWindow\"));\n        let p = msg_t_tp(this, sel(c\"convertPoint:fromView:\"), at, 0 as *u8);\n        let s = scale_of(this);\n        let n = msg_i(ev, sel(c\"buttonNumber\"));\n        let action = if ty == EV_LEFT_DOWN || ty == EV_RIGHT_DOWN || ty == EV_OTHER_DOWN {\n            MouseAction::Press\n        } else if ty == EV_LEFT_UP || ty == EV_RIGHT_UP || ty == EV_OTHER_UP {\n            MouseAction::Release\n        } else {\n            MouseAction::Move\n        };\n        let button = if ty == EV_MOVED {\n            Button::None\n        } else if n == 0 {\n            Button::Left\n        } else if n == 1 {\n            Button::Right\n        } else if n == 2 {\n            Button::Middle\n        } else {\n            Button::Other(n)\n        };\n        let clicks = if ty == EV_MOVED || ty == EV_LEFT_DRAGGED || ty == EV_RIGHT_DRAGGED\n            || ty == EV_OTHER_DRAGGED {\n            0\n        } else {\n            msg_i(ev, sel(c\"clickCount\"))\n        };\n        push(Event::Mouse(Mouse {\n            win: view_id(this),\n            action: action,\n            button: button,\n            x: p.x * s,\n            y: p.y * s,\n            mods: mac_mods(msg_u(ev, sel(c\"modifierFlags\"))),\n            clicks: clicks,\n        }));\n    }\n}\n\nextern \"C\" fn imp_entered(this: *u8, cmd: *u8, ev: *u8) {\n    if !st_live() {\n        return;\n    }\n");
        buf_str(out, c"    // SAFETY: see st_live.\n    unsafe { push(Event::Cursor(view_id(this), true)); }\n}\n\nextern \"C\" fn imp_exited(this: *u8, cmd: *u8, ev: *u8) {\n    if !st_live() {\n        return;\n    }\n    // SAFETY: see st_live.\n    unsafe { push(Event::Cursor(view_id(this), false)); }\n}\n\nextern \"C\" fn imp_scroll(this: *u8, cmd: *u8, ev: *u8) {\n    if !st_live() {\n        return;\n    }\n    // SAFETY: see imp_key_down.\n    unsafe {\n        let precise = msg_b(ev, sel(c\"hasPreciseScrollingDeltas\"));\n        let s = if precise { scale_of(this) } else { 1.0 };\n        push(Event::Scroll(Scroll {\n            win: view_id(this),\n            dx: msg_d(ev, sel(c\"scrollingDeltaX\")) * s,\n            dy: msg_d(ev, sel(c\"scrollingDeltaY\")) * s,\n            precise: precise,\n            mods: mac_mods(msg_u(ev, sel(c\"modifierFlags\"))),\n        }));\n    }\n}\n\nextern \"C\" fn imp_frame(this: *u8, cmd: *u8, link: *u8) {\n    if !st_live() {\n        return;\n    }\n    // SAFETY: see st_live; `link` is the CADisplayLink that called us.\n    unsafe {\n        msg_v_b(link, sel(c\"setPaused:\"), true);\n        push(Event::Frame(view_id(this)));\n    }\n}\n\nextern \"C\" fn imp_reset_cursor_rects(this: *u8, cmd: *u8) {\n    if !st_live() {\n        return;\n    }\n    // SAFETY: see st_live; the NSCursor class methods return shared\n    // cursors (+0).\n    unsafe {\n        let k = vdata(this).cursor;\n        let c = if k == 1 {\n            msg_p(class(c\"NSCursor\"), sel(c\"IBeamCursor\"))\n        } else if k == 2 {\n            msg_p(class(c\"NSCursor\"), sel(c\"pointingHandCursor\"))\n        } else {\n            msg_p(class(c\"NSCursor\"), sel(c\"arrowCursor\"))\n        };\n        msg_v_rp(this, sel(c\"addCursorRect:cursor:\"), msg_r(this, sel(c\"bounds\")), c);\n    }\n}\n\n// ---- NSTextInputClient (0.23) ----\n\nextern \"C\" fn imp_has_marked(this: *u8, cmd: *u8) -> bool {\n    // SAFETY: see st_live.\n    st_live() && unsafe { ST.marked }\n}\n");
        buf_str(out, c"\nextern \"C\" fn imp_marked_range(this: *u8, cmd: *u8) -> Range {\n    // SAFETY: see st_live.\n    unsafe {\n        if st_live() && ST.marked {\n            return Range { loc: 0, len: utf16_len(ST.preedit.as_slice()) };\n        }\n    }\n    Range { loc: NOT_FOUND, len: 0 }\n}\n\nextern \"C\" fn imp_selected_range(this: *u8, cmd: *u8) -> Range {\n    Range { loc: NOT_FOUND, len: 0 }\n}\n\nfn utf16_len(s: [u8]) -> u64 {\n    var n: u64 = 0;\n    for b in s {\n        if (b & 0xC0) != 0x80 {\n            n += if b >= 0xF0 { 2 } else { 1 };\n        }\n    }\n    n\n}\n\n// The text of an NSString or NSAttributedString argument.\nunsafe fn arg_text(s: *u8) -> [u8] {\n    if msg_b_p(s, sel(c\"isKindOfClass:\"), class(c\"NSAttributedString\")) {\n        return nsstring_bytes(msg_p(s, sel(c\"string\")));\n    }\n    nsstring_bytes(s)\n}\n\nextern \"C\" fn imp_set_marked(this: *u8, cmd: *u8, text: *u8, selected: Range, replaced: Range) {\n    if !st_live() {\n        return;\n    }\n    // SAFETY: see st_live; `text` is the NSString or NSAttributedString\n    // the input method passes.\n    unsafe {\n        let s = arg_text(text);\n        ST.preedit.clear();\n        ST.preedit.push_str(s);\n        ST.marked = s.len > 0;\n        let cursor = if selected.loc == NOT_FOUND { s.len }\n            else { utf16_to_byte(s, selected.loc as i64) };\n        push(Event::Preedit(Preedit { win: view_id(this), len: s.len, cursor: cursor }));\n    }\n}\n\nextern \"C\" fn imp_unmark(this: *u8, cmd: *u8) {\n    if !st_live() {\n        return;\n    }\n    // SAFETY: see st_live; discardMarkedText on the view's input context.\n    unsafe {\n        if ST.marked {\n            ST.marked = false;\n            ST.preedit.clear();\n            push(Event::Preedit(Preedit { win: view_id(this), len: 0, cursor: 0 }));\n        }\n        let ic = msg_p(this, sel(c\"inputContext\"));\n        if ic != 0 as *u8 {\n            msg_v(ic, sel(c\"discardMarkedText\"));\n        }\n    }\n}\n\n");
        buf_str(out, c"extern \"C\" fn imp_insert_text(this: *u8, cmd: *u8, text: *u8, replaced: Range) {\n    if !st_live() {\n        return;\n    }\n    // SAFETY: see imp_set_marked.\n    unsafe {\n        let s = arg_text(text);\n        let id = view_id(this);\n        if ST.marked {\n            ST.marked = false;\n            ST.preedit.clear();\n            push(Event::Preedit(Preedit { win: id, len: 0, cursor: 0 }));\n        }\n        if ST.in_key {\n            ST.key_text.push_str(s);\n        } else {\n            push_text(id, s);\n        }\n    }\n}\n\nextern \"C\" fn imp_valid_attributes(this: *u8, cmd: *u8) -> *u8 {\n    // SAFETY: +[NSArray array] returns an empty, autoreleased array.\n    unsafe { msg_p(class(c\"NSArray\"), sel(c\"array\")) }\n}\n\nextern \"C\" fn imp_attributed_substring(this: *u8, cmd: *u8, r: Range, actual: *Range) -> *u8 {\n    0 as *u8\n}\n\nextern \"C\" fn imp_char_index(this: *u8, cmd: *u8, p: Point) -> u64 {\n    NOT_FOUND\n}\n\nextern \"C\" fn imp_first_rect(this: *u8, cmd: *u8, r: Range, actual: *Range) -> Rect {\n    if !st_live() {\n        return Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 };\n    }\n    // SAFETY: see st_live; the conversions take and return rects by value.\n    unsafe {\n        let d = vdata(this);\n        let s = scale_of(this);\n        let local = Rect { x: d.ime_x / s, y: d.ime_y / s, w: d.ime_w / s, h: d.ime_h / s };\n        let inwin = msg_r_rp(this, sel(c\"convertRect:toView:\"), local, 0 as *u8);\n        let w = msg_p(this, sel(c\"window\"));\n        if w == 0 as *u8 {\n            return inwin;\n        }\n        msg_r_r(w, sel(c\"convertRectToScreen:\"), inwin)\n    }\n}\n\nextern \"C\" fn imp_do_command(this: *u8, cmd: *u8, selector: *u8) {\n    // Nothing: the application reads keys from Event::Key (and the\n    // default would beep).\n}\n\n// ---- the window delegate (0.23) ----\n\nunsafe fn note_view(note: *u8) -> *u8 {\n    let w = msg_p(note, sel(c\"object\"));\n    msg_p(w, sel(c\"contentView\"))\n}\n\n");
        buf_str(out, c"extern \"C\" fn imp_should_close(this: *u8, cmd: *u8, win: *u8) -> bool {\n    if !st_live() {\n        return true;\n    }\n    // SAFETY: see st_live; `win` is one of our windows (its content view\n    // is our view).\n    unsafe { push(Event::Close(view_id(msg_p(win, sel(c\"contentView\"))))); }\n    false\n}\n\nextern \"C\" fn imp_did_resize(this: *u8, cmd: *u8, note: *u8) {\n    if !st_live() {\n        return;\n    }\n    // SAFETY: see st_live; the hook is called with the context it was\n    // registered with (the application's promise: it is valid while the\n    // hook is set).\n    unsafe {\n        let view = note_view(note);\n        let sz = sync_layer(view);\n        push(Event::Resize(view_id(view), sz));\n        let live = msg_b(view, sel(c\"inLiveResize\"));\n        if live && !ST.in_hook {\n            match ST.hook {\n                Some(f) => {\n                    ST.in_hook = true;\n                    f(ST.hook_ctx);\n                    ST.in_hook = false;\n                }\n                None => {}\n            }\n        }\n    }\n}\n\nextern \"C\" fn imp_did_backing(this: *u8, cmd: *u8, note: *u8) {\n    if !st_live() {\n        return;\n    }\n    // SAFETY: see st_live.\n    unsafe {\n        let view = note_view(note);\n        let sz = sync_layer(view);\n        push(Event::Resize(view_id(view), sz));\n    }\n}\n\nextern \"C\" fn imp_did_key(this: *u8, cmd: *u8, note: *u8) {\n    if !st_live() {\n        return;\n    }\n    // SAFETY: see st_live.\n    unsafe { push(Event::Focus(view_id(note_view(note)), true)); }\n}\n\nextern \"C\" fn imp_did_resign(this: *u8, cmd: *u8, note: *u8) {\n    if !st_live() {\n        return;\n    }\n    // SAFETY: see st_live.\n    unsafe { push(Event::Focus(view_id(note_view(note)), false)); }\n}\n\nextern \"C\" fn imp_quit(this: *u8, cmd: *u8, sender: *u8) {\n    push(Event::Quit);\n}\n\n// ---- watched file descriptors (0.23) ----\n\nextern \"C\" fn fd_ready(f: *u8, types: u64, info: *u8) {\n");
        buf_str(out, c"    if !st_live() {\n        return;\n    }\n    // SAFETY: see st_live; `f` is one of our CFFileDescriptors.\n    unsafe {\n        let fd = CFFileDescriptorGetNativeDescriptor(f);\n        for i in 0..ST.watches.len() {\n            if ST.watches[i].fd == fd {\n                ST.watches[i].armed = false;\n            }\n        }\n        push(Event::Readable(fd));\n    }\n}\n\n// ---- classes (0.23) ----\n\n// The encoding of method `name` of the superclass or protocol, or `dflt`.\nfn types(cls: *u8, proto: *u8, name: *u8, dflt: *u8) -> *u8 {\n    let t = method_types(cls, proto, name);\n    if t == 0 as *u8 { dflt } else { t }\n}\n\nunsafe fn make_view_class() -> *u8 {\n    let existing = class(c\"VoleView\");\n    if existing != 0 as *u8 {\n        return existing;\n    }\n    let sup = class(c\"NSView\");\n    let tic = objc_getProtocol(c\"NSTextInputClient\");\n    let c = objc_allocateClassPair(sup, c\"VoleView\", 0);\n    class_addIvar(c, c\"vole\", 48, 3, c\"[6q]\");\n    class_addProtocol(c, tic);\n    add_b(c, sel(c\"acceptsFirstResponder\"), imp_yes,\n        types(sup, 0 as *u8, c\"acceptsFirstResponder\", c\"c@:\"));\n    add_b(c, sel(c\"isFlipped\"), imp_yes, types(sup, 0 as *u8, c\"isFlipped\", c\"c@:\"));\n    add_b_p(c, sel(c\"acceptsFirstMouse:\"), imp_yes_p,\n        types(sup, 0 as *u8, c\"acceptsFirstMouse:\", c\"c@:@\"));\n    let vp = types(sup, 0 as *u8, c\"keyDown:\", c\"v@:@\");\n    add_v_p(c, sel(c\"keyDown:\"), imp_key_down, vp);\n    add_v_p(c, sel(c\"keyUp:\"), imp_key_up, vp);\n    add_v_p(c, sel(c\"flagsChanged:\"), imp_flags_changed, vp);\n    add_v_p(c, sel(c\"mouseDown:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"mouseUp:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"mouseDragged:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"mouseMoved:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"rightMouseDown:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"rightMouseUp:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"rightMouseDragged:\"), imp_mouse, vp);\n");
        buf_str(out, c"    add_v_p(c, sel(c\"otherMouseDown:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"otherMouseUp:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"otherMouseDragged:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"mouseEntered:\"), imp_entered, vp);\n    add_v_p(c, sel(c\"mouseExited:\"), imp_exited, vp);\n    add_v_p(c, sel(c\"scrollWheel:\"), imp_scroll, vp);\n    add_v_p(c, sel(c\"voleFrame:\"), imp_frame, c\"v@:@\");\n    add_v(c, sel(c\"resetCursorRects\"), imp_reset_cursor_rects,\n        types(sup, 0 as *u8, c\"resetCursorRects\", c\"v@:\"));\n    // NSTextInputClient.\n    add_b(c, sel(c\"hasMarkedText\"), imp_has_marked, types(0 as *u8, tic, c\"hasMarkedText\", c\"c@:\"));\n    add_g(c, sel(c\"markedRange\"), imp_marked_range,\n        types(0 as *u8, tic, c\"markedRange\", c\"{_NSRange=QQ}@:\"));\n    add_g(c, sel(c\"selectedRange\"), imp_selected_range,\n        types(0 as *u8, tic, c\"selectedRange\", c\"{_NSRange=QQ}@:\"));\n    add_v_pgg(c, sel(c\"setMarkedText:selectedRange:replacementRange:\"), imp_set_marked,\n        types(0 as *u8, tic, c\"setMarkedText:selectedRange:replacementRange:\",\n            c\"v@:@{_NSRange=QQ}{_NSRange=QQ}\"));\n    add_v(c, sel(c\"unmarkText\"), imp_unmark, types(0 as *u8, tic, c\"unmarkText\", c\"v@:\"));\n    add_p(c, sel(c\"validAttributesForMarkedText\"), imp_valid_attributes,\n        types(0 as *u8, tic, c\"validAttributesForMarkedText\", c\"@@:\"));\n    add_p_gP(c, sel(c\"attributedSubstringForProposedRange:actualRange:\"), imp_attributed_substring,\n        types(0 as *u8, tic, c\"attributedSubstringForProposedRange:actualRange:\",\n            c\"@@:{_NSRange=QQ}^{_NSRange=QQ}\"));\n    add_v_pg(c, sel(c\"insertText:replacementRange:\"), imp_insert_text,\n        types(0 as *u8, tic, c\"insertText:replacementRange:\", c\"v@:@{_NSRange=QQ}\"));\n    add_u_t(c, sel(c\"characterIndexForPoint:\"), imp_char_index,\n        types(0 as *u8, tic, c\"characterIndexForPoint:\", c\"Q@:{CGPoint=dd}\"));\n");
        buf_str(out, c"    add_r_gP(c, sel(c\"firstRectForCharacterRange:actualRange:\"), imp_first_rect,\n        types(0 as *u8, tic, c\"firstRectForCharacterRange:actualRange:\",\n            c\"{CGRect={CGPoint=dd}{CGSize=dd}}@:{_NSRange=QQ}^{_NSRange=QQ}\"));\n    add_v_p(c, sel(c\"doCommandBySelector:\"), imp_do_command,\n        types(0 as *u8, tic, c\"doCommandBySelector:\", c\"v@::\"));\n    objc_registerClassPair(c);\n    c\n}\n\nunsafe fn make_delegate_class() -> *u8 {\n    let existing = class(c\"VoleWindowDelegate\");\n    if existing != 0 as *u8 {\n        return existing;\n    }\n    let c = objc_allocateClassPair(class(c\"NSObject\"), c\"VoleWindowDelegate\", 0);\n    let p = objc_getProtocol(c\"NSWindowDelegate\");\n    if p != 0 as *u8 {\n        class_addProtocol(c, p);\n    }\n    add_b_p(c, sel(c\"windowShouldClose:\"), imp_should_close, c\"c@:@\");\n    add_v_p(c, sel(c\"windowDidResize:\"), imp_did_resize, c\"v@:@\");\n    add_v_p(c, sel(c\"windowDidChangeBackingProperties:\"), imp_did_backing, c\"v@:@\");\n    add_v_p(c, sel(c\"windowDidBecomeKey:\"), imp_did_key, c\"v@:@\");\n    add_v_p(c, sel(c\"windowDidResignKey:\"), imp_did_resign, c\"v@:@\");\n    add_v_p(c, sel(c\"voleQuit:\"), imp_quit, c\"v@:@\");\n    objc_registerClassPair(c);\n    c\n}\n\n// The menu bar: an application menu with Quit (Command-Q).\nunsafe fn make_menu(app: *u8, target: *u8) {\n    let bar = msg_p(msg_p(class(c\"NSMenu\"), sel(c\"alloc\")), sel(c\"init\"));\n    let app_item = msg_p(msg_p(class(c\"NSMenuItem\"), sel(c\"alloc\")), sel(c\"init\"));\n    msg_v_p(bar, sel(c\"addItem:\"), app_item);\n    let menu = msg_p(msg_p(class(c\"NSMenu\"), sel(c\"alloc\")), sel(c\"init\"));\n    let quit = msg_p_ppp(msg_p(class(c\"NSMenuItem\"), sel(c\"alloc\")),\n        sel(c\"initWithTitle:action:keyEquivalent:\"), nsstring(\"Quit\"), sel(c\"voleQuit:\"),\n        nsstring(\"q\"));\n    msg_v_p(quit, sel(c\"setTarget:\"), target);\n    msg_v_p(menu, sel(c\"addItem:\"), quit);\n");
        buf_str(out, c"    msg_v_p(app_item, sel(c\"setSubmenu:\"), menu);\n    msg_v_p(app, sel(c\"setMainMenu:\"), bar);\n    release(quit);\n    release(menu);\n    release(app_item);\n    release(bar);\n}\n\n// Whether a window server session exists (false under ssh or in a\n// launchd daemon), checked before NSApplication is touched.\npub fn has_display() -> bool {\n    // SAFETY: CGSessionCopyCurrentDictionary returns a +1 dictionary or\n    // null; it is released.\n    unsafe {\n        let d = CGSessionCopyCurrentDictionary();\n        if d == 0 as *u8 {\n            return false;\n        }\n        CFRelease(d);\n        true\n    }\n}\n\npub fn hide_cursor_until_moved() {\n    // SAFETY: +[NSCursor setHiddenUntilMouseMoves:] takes a BOOL.\n    unsafe { msg_v_b(class(c\"NSCursor\"), sel(c\"setHiddenUntilMouseMoves:\"), true); }\n}\n\nimpl Cocoa {\n    pub fn new_in(gpa: Gpa) -> Result<Cocoa, Error> {\n        if !has_display() {\n            return Err(Error::NoDisplay);\n        }\n        // SAFETY: AppKit setup on the main thread with the documented\n        // selectors and types; ST is set to the State's address, which\n        // stays put (the Vec is never pushed to again) until close.\n        unsafe {\n            if ST != 0 as *State {\n                return Err(Error::Failed(\"one App per process\"));\n            }\n            let pool = pool_push();\n            let app = msg_p(class(c\"NSApplication\"), sel(c\"sharedApplication\"));\n            if app == 0 as *u8 {\n                pool_pop(pool);\n                return Err(Error::NoDisplay);\n            }\n            // NSApplicationActivationPolicyRegular.\n            msg_b_i(app, sel(c\"setActivationPolicy:\"), 0);\n            msg_v_b(class(c\"NSWindow\"), sel(c\"setAllowsAutomaticWindowTabbing:\"), false);\n            let view_class = make_view_class();\n            let dc = make_delegate_class();\n            let delegate = msg_p(msg_p(dc, sel(c\"alloc\")), sel(c\"init\"));\n");
        buf_str(out, c"            make_menu(app, delegate);\n            msg_v(app, sel(c\"finishLaunching\"));\n            msg_v_b(app, sel(c\"activateIgnoringOtherApps:\"), true);\n            let off = ivar_getOffset(class_getInstanceVariable(view_class, c\"vole\"));\n            var c = Cocoa { st: Vec::with_capacity_in(1, gpa) };\n            c.st.push(State {\n                q: Vec::with_capacity_in(64, gpa),\n                head: 0,\n                preedit: Buf::new_in(gpa),\n                marked: false,\n                in_key: false,\n                key_text: Buf::new_in(gpa),\n                waiting: false,\n                wake_posted: false,\n                hook: None,\n                hook_ctx: 0 as *u8,\n                in_hook: false,\n                watches: Vec::new_in(gpa),\n                app: app,\n                delegate: delegate,\n                target: delegate,\n                view_class: view_class,\n                ivar_off: off,\n            });\n            ST = &c.st[0];\n            pool_pop(pool);\n            Ok(c)\n        }\n    }\n}\n\nimpl State {\n    fn pop(inout self) -> Option<Event> {\n        if self.head < self.q.len() {\n            let e = self.q[self.head];\n            self.head += 1;\n            if self.head == self.q.len() {\n                self.q.clear();\n                self.head = 0;\n            }\n            return Some(e);\n        }\n        None\n    }\n\n    fn next_event(inout self, ms: i64) -> Option<Event> {\n        match self.pop() {\n            Some(e) => return Some(e),\n            None => {}\n        }\n        if self.in_hook {\n            return None;\n        }\n        for i in 0..self.watches.len() {\n            if !self.watches[i].armed {\n                // SAFETY: a CFFileDescriptor of ours, live until unwatch.\n                unsafe { CFFileDescriptorEnableCallBacks(self.watches[i].cf, 1); }\n                self.watches[i].armed = true;\n            }\n        }\n");
        buf_str(out, c"        // SAFETY: the event loop's AppKit calls with their documented\n        // types, each batch in an autorelease pool; the date is\n        // autoreleased in the outer pool, which outlives the loop.\n        unsafe {\n            let outer = pool_push();\n            let date = if ms < 0 {\n                msg_p(class(c\"NSDate\"), sel(c\"distantFuture\"))\n            } else if ms == 0 {\n                msg_p(class(c\"NSDate\"), sel(c\"distantPast\"))\n            } else {\n                msg_p_d(class(c\"NSDate\"), sel(c\"dateWithTimeIntervalSinceNow:\"), ms as f64 / 1000.0)\n            };\n            loop {\n                let p = pool_push();\n                self.waiting = ms != 0;\n                let ev = msg_p_uppb(self.app,\n                    sel(c\"nextEventMatchingMask:untilDate:inMode:dequeue:\"), 0xFFFFFFFFFFFFFFFF,\n                    date, NSDefaultRunLoopMode, true);\n                self.waiting = false;\n                if ev == 0 as *u8 {\n                    pool_pop(p);\n                    break;\n                }\n                if msg_u(ev, sel(c\"type\")) == EV_APP_DEFINED && msg_i(ev, sel(c\"data1\")) == WAKE {\n                    self.wake_posted = false;\n                } else {\n                    msg_v_p(self.app, sel(c\"sendEvent:\"), ev);\n                }\n                pool_pop(p);\n                if self.head < self.q.len() {\n                    break;\n                }\n            }\n            pool_pop(outer);\n        }\n        self.pop()\n    }\n\n    fn watch(inout self, fd: i32) -> bool {\n        let ctx = FdContext {\n            version: 0, info: 0 as *u8, retain: 0 as *u8, release: 0 as *u8, describe: 0 as *u8\n        };\n        // SAFETY: CFFileDescriptorCreate copies the context; the source\n        // is added to the main run loop in the default mode (the mode\n        // wait runs it in) and removed by unwatch.\n        unsafe {\n");
        buf_str(out, c"            let cf = CFFileDescriptorCreate(0 as *u8, fd, false, fd_ready, &ctx);\n            if cf == 0 as *u8 {\n                return false;\n            }\n            let src = CFFileDescriptorCreateRunLoopSource(0 as *u8, cf, 0);\n            CFRunLoopAddSource(CFRunLoopGetMain(), src, kCFRunLoopDefaultMode);\n            CFFileDescriptorEnableCallBacks(cf, 1);\n            self.watches.push(Watch { fd: fd, cf: cf, src: src, armed: true });\n        }\n        true\n    }\n\n    fn unwatch(inout self, fd: i32) {\n        var i = 0;\n        while i < self.watches.len() {\n            let w = self.watches[i];\n            if w.fd == fd {\n                // SAFETY: the source and descriptor watch made (+1 each).\n                unsafe {\n                    CFRunLoopRemoveSource(CFRunLoopGetMain(), w.src, kCFRunLoopDefaultMode);\n                    CFFileDescriptorInvalidate(w.cf);\n                    CFRelease(w.src);\n                    CFRelease(w.cf);\n                }\n                self.watches.remove(i);\n            } else {\n                i += 1;\n            }\n        }\n    }\n\n    fn free(inout self) {\n        while self.watches.len() > 0 {\n            let fd = self.watches[0].fd;\n            self.unwatch(fd);\n        }\n        // SAFETY: the delegate was made +1 in new_in.\n        unsafe { release(self.delegate); }\n        self.delegate = 0 as *u8;\n    }\n}\n\nimpl super::Backend for Cocoa {\n    fn open_window(inout self, desc: WindowDesc, id: WindowId) -> Result<Window, Error> {\n        let view_class = self.st[0].view_class;\n        let delegate = self.st[0].delegate;\n        let app = self.st[0].app;\n        // SAFETY: AppKit and Core Animation calls with their documented\n        // types; alloc/init results are +1 and kept in the NsWindow (the\n        // display link and the layer are retained); the view's data is\n        // the ivar this class was given (48 bytes at ivar_off).\n        unsafe {\n");
        buf_str(out, c"            let pool = pool_push();\n            let rect = Rect { x: 0.0, y: 0.0, w: desc.w as f64, h: desc.h as f64 };\n            // Titled | Closable | Miniaturizable | Resizable.\n            let style: u64 = if desc.resizable { 1 | 2 | 4 | 8 } else { 1 | 2 | 4 };\n            let win = msg_p_ruub(msg_p(class(c\"NSWindow\"), sel(c\"alloc\")),\n                sel(c\"initWithContentRect:styleMask:backing:defer:\"), rect, style, 2, false);\n            if win == 0 as *u8 {\n                pool_pop(pool);\n                return Err(Error::Failed(\"NSWindow\"));\n            }\n            msg_v_b(win, sel(c\"setReleasedWhenClosed:\"), false);\n            let view = msg_p_r(msg_p(view_class, sel(c\"alloc\")), sel(c\"initWithFrame:\"), rect);\n            let d = vdata(view);\n            d.id = id.n;\n            d.cursor = 1;\n            d.ime_x = 0.0;\n            d.ime_y = 0.0;\n            d.ime_w = 0.0;\n            d.ime_h = 0.0;\n            // A layer-hosting view: the layer is set before wantsLayer.\n            let layer = retain(msg_p(class(c\"CAMetalLayer\"), sel(c\"layer\")));\n            msg_v_p(view, sel(c\"setLayer:\"), layer);\n            msg_v_b(view, sel(c\"setWantsLayer:\"), true);\n            msg_v_p(win, sel(c\"setContentView:\"), view);\n            msg_v_p(win, sel(c\"setDelegate:\"), delegate);\n            msg_v_p(win, sel(c\"setTitle:\"), nsstring(desc.title));\n            msg_v_b(win, sel(c\"setAcceptsMouseMovedEvents:\"), true);\n            msg_v_z(win, sel(c\"setContentMinSize:\"),\n                NsSize { w: desc.min_w as f64, h: desc.min_h as f64 });\n            // NSWindowCollectionBehaviorFullScreenPrimary.\n            msg_v_u(win, sel(c\"setCollectionBehavior:\"), 1 << 7);\n            // Enter, leave and moves over the visible rect, always.\n            let ta = msg_p_rupp(msg_p(class(c\"NSTrackingArea\"), sel(c\"alloc\")),\n                sel(c\"initWithRect:options:owner:userInfo:\"),\n");
        buf_str(out, c"                Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 }, 0x01 | 0x02 | 0x80 | 0x200, view,\n                0 as *u8);\n            msg_v_p(view, sel(c\"addTrackingArea:\"), ta);\n            release(ta);\n            msg_v(win, sel(c\"center\"));\n            msg_b_p(win, sel(c\"makeFirstResponder:\"), view);\n            msg_v_p(win, sel(c\"makeKeyAndOrderFront:\"), 0 as *u8);\n            msg_v_b(app, sel(c\"activateIgnoringOtherApps:\"), true);\n            let sz = sync_layer(view);\n            var link = 0 as *u8;\n            if msg_b_p(view, sel(c\"respondsToSelector:\"), sel(c\"displayLinkWithTarget:selector:\")) {\n                link = retain(msg_p_pp(view, sel(c\"displayLinkWithTarget:selector:\"), view,\n                    sel(c\"voleFrame:\")));\n                msg_v_b(link, sel(c\"setPaused:\"), true);\n                msg_v_pp(link, sel(c\"addToRunLoop:forMode:\"),\n                    msg_p(class(c\"NSRunLoop\"), sel(c\"mainRunLoop\")), NSRunLoopCommonModes);\n            }\n            pool_pop(pool);\n            push(Event::Resize(id, sz));\n            Ok(Window { id: id, ns: NsWindow { win: win, view: view, layer: layer, link: link } })\n        }\n    }\n\n    fn next_event(inout self, ms: i64) -> Option<Event> {\n        self.st[0].next_event(ms)\n    }\n\n    fn watch(inout self, fd: i32) -> bool {\n        self.st[0].watch(fd)\n    }\n\n    fn unwatch(inout self, fd: i32) {\n        self.st[0].unwatch(fd);\n    }\n\n    fn clipboard_get_in<A: Allocator>(self, a: sink A) -> Option<Buf<A>> {\n        // SAFETY: NSPasteboard calls with their types; the string's bytes\n        // are copied before the pool is popped.\n        unsafe {\n            let pool = pool_push();\n            let pb = msg_p(class(c\"NSPasteboard\"), sel(c\"generalPasteboard\"));\n            let s = msg_p_p(pb, sel(c\"stringForType:\"), NSPasteboardTypeString);\n            if s == 0 as *u8 {\n                pool_pop(pool);\n                return None;\n");
        buf_str(out, c"            }\n            var b = Buf::new_in(a);\n            b.push_str(nsstring_bytes(s));\n            pool_pop(pool);\n            Some(b)\n        }\n    }\n\n    fn clipboard_set(self, text: [u8]) {\n        // SAFETY: as clipboard_get_in.\n        unsafe {\n            let pool = pool_push();\n            let pb = msg_p(class(c\"NSPasteboard\"), sel(c\"generalPasteboard\"));\n            msg_i(pb, sel(c\"clearContents\"));\n            msg_b_pp(pb, sel(c\"setString:forType:\"), nsstring(text), NSPasteboardTypeString);\n            pool_pop(pool);\n        }\n    }\n\n    fn preedit(self) -> [u8] {\n        self.st[0].preedit.as_slice()\n    }\n\n    fn set_live_resize(inout self, f: fn(*u8), ctx: *u8) {\n        self.st[0].hook = Some(f);\n        self.st[0].hook_ctx = ctx;\n    }\n\n    fn close(inout self) {\n        // SAFETY: ST no longer points at the State once it is freed.\n        unsafe { ST = 0 as *State; }\n        self.st[0].free();\n    }\n}\n\n// A window's Cocoa objects (each retained once).\npub struct NsWindow {\n    pub win: *u8,\n    pub view: *u8,\n    pub layer: *u8,\n    pub link: *u8,\n}\n\nimpl NsWindow {\n    pub fn request_frame(self) {\n        if self.link != 0 as *u8 {\n            // SAFETY: setPaused: on the display link this window retained.\n            unsafe { msg_v_b(self.link, sel(c\"setPaused:\"), false); }\n        }\n    }\n\n    pub fn size(self) -> Size {\n        // SAFETY: the view this window retained.\n        unsafe { view_size(self.view) }\n    }\n\n    pub fn set_title(self, t: [u8]) {\n        // SAFETY: setTitle: takes an NSString (autoreleased in our pool).\n        unsafe {\n            let p = pool_push();\n            msg_v_p(self.win, sel(c\"setTitle:\"), nsstring(t));\n            pool_pop(p);\n        }\n    }\n\n    pub fn set_cursor(self, c: CursorIcon) {\n        let k = match c {\n            CursorIcon::Arrow => 0,\n            CursorIcon::Text => 1,\n            CursorIcon::Pointer => 2,\n");
        buf_str(out, c"        };\n        // SAFETY: the view's ivar (see open_window); the window rebuilds\n        // its cursor rects, calling resetCursorRects.\n        unsafe {\n            if ST == 0 as *State {\n                return;\n            }\n            vdata(self.view).cursor = k;\n            msg_v_p(self.win, sel(c\"invalidateCursorRectsForView:\"), self.view);\n        }\n    }\n\n    pub fn set_ime_area(self, x: f64, y: f64, w: f64, h: f64) {\n        // SAFETY: the view's ivar (see open_window).\n        unsafe {\n            if ST == 0 as *State {\n                return;\n            }\n            let d = vdata(self.view);\n            d.ime_x = x;\n            d.ime_y = y;\n            d.ime_w = w;\n            d.ime_h = h;\n        }\n    }\n\n    pub fn is_fullscreen(self) -> bool {\n        // SAFETY: styleMask returns NSWindowStyleMask; FullScreen is 1 << 14.\n        unsafe { (msg_u(self.win, sel(c\"styleMask\")) & (1 << 14)) != 0 }\n    }\n\n    pub fn set_fullscreen(self, on: bool) {\n        if on != self.is_fullscreen() {\n            // SAFETY: toggleFullScreen: takes a sender (nil).\n            unsafe { msg_v_p(self.win, sel(c\"toggleFullScreen:\"), 0 as *u8); }\n        }\n    }\n\n    pub fn focused(self) -> bool {\n        // SAFETY: isKeyWindow returns a BOOL.\n        unsafe { msg_b(self.win, sel(c\"isKeyWindow\")) }\n    }\n\n    pub fn close(inout self) {\n        // SAFETY: releases what open_window retained, after detaching the\n        // delegate (no callback reaches a closed window) and stopping the\n        // display link.\n        unsafe {\n            if self.win == 0 as *u8 {\n                return;\n            }\n            if self.link != 0 as *u8 {\n                msg_v(self.link, sel(c\"invalidate\"));\n                release(self.link);\n            }\n            msg_v_p(self.win, sel(c\"setDelegate:\"), 0 as *u8);\n            msg_v(self.win, sel(c\"close\"));\n            release(self.view);\n");
        buf_str(out, c"            release(self.layer);\n            release(self.win);\n            self.win = 0 as *u8;\n        }\n    }\n}\n// ---- end mod std::window::cocoa ----\n}\n// ---- mod std::window::keys ----\npub mod keys {\n// Keys (terminal.md §2.2): the physical key (`KeyCode`, winit's names,\n// from USB HID usages), the logical key (a named key or the character it\n// produces), and the modifiers with left and right told apart. The macOS\n// tables live here, as pure functions the headless tests check; the\n// Linux backends (xkbcommon) add theirs.\n\n// ---- Keys (0.23) ----\n\npub enum KeyCode {\n    Unidentified,\n    KeyA,\n    KeyB,\n    KeyC,\n    KeyD,\n    KeyE,\n    KeyF,\n    KeyG,\n    KeyH,\n    KeyI,\n    KeyJ,\n    KeyK,\n    KeyL,\n    KeyM,\n    KeyN,\n    KeyO,\n    KeyP,\n    KeyQ,\n    KeyR,\n    KeyS,\n    KeyT,\n    KeyU,\n    KeyV,\n    KeyW,\n    KeyX,\n    KeyY,\n    KeyZ,\n    Digit0,\n    Digit1,\n    Digit2,\n    Digit3,\n    Digit4,\n    Digit5,\n    Digit6,\n    Digit7,\n    Digit8,\n    Digit9,\n    Minus,\n    Equal,\n    BracketLeft,\n    BracketRight,\n    Backslash,\n    Semicolon,\n    Quote,\n    Backquote,\n    Comma,\n    Period,\n    Slash,\n    IntlBackslash,\n    IntlYen,\n    IntlRo,\n    Enter,\n    Tab,\n    Space,\n    Backspace,\n    Escape,\n    CapsLock,\n    ShiftLeft,\n    ShiftRight,\n    ControlLeft,\n    ControlRight,\n    AltLeft,\n    AltRight,\n    SuperLeft,\n    SuperRight,\n    Fn,\n    F1,\n    F2,\n    F3,\n    F4,\n    F5,\n    F6,\n    F7,\n    F8,\n    F9,\n    F10,\n    F11,\n    F12,\n    F13,\n    F14,\n    F15,\n    F16,\n    F17,\n    F18,\n    F19,\n    F20,\n    Numpad0,\n    Numpad1,\n    Numpad2,\n    Numpad3,\n    Numpad4,\n    Numpad5,\n    Numpad6,\n    Numpad7,\n    Numpad8,\n    Numpad9,\n    NumpadDecimal,\n    NumpadMultiply,\n    NumpadAdd,\n    NumpadSubtract,\n    NumpadDivide,\n    NumpadEnter,\n    NumpadEqual,\n    NumpadComma,\n    NumLock,\n    AudioVolumeUp,\n    AudioVolumeDown,\n");
        buf_str(out, c"    AudioVolumeMute,\n    Insert,\n    Delete,\n    Home,\n    End,\n    PageUp,\n    PageDown,\n    ArrowLeft,\n    ArrowRight,\n    ArrowUp,\n    ArrowDown,\n    ContextMenu,\n    Lang1,\n    Lang2,\n}\n\n// The physical key of a macOS virtual key code (Carbon's kVK_*, the\n// position on an ANSI keyboard whatever the layout).\npub fn mac_keycode(vk: u16) -> KeyCode {\n    match vk {\n        0x00 => KeyCode::KeyA,\n        0x01 => KeyCode::KeyS,\n        0x02 => KeyCode::KeyD,\n        0x03 => KeyCode::KeyF,\n        0x04 => KeyCode::KeyH,\n        0x05 => KeyCode::KeyG,\n        0x06 => KeyCode::KeyZ,\n        0x07 => KeyCode::KeyX,\n        0x08 => KeyCode::KeyC,\n        0x09 => KeyCode::KeyV,\n        0x0A => KeyCode::IntlBackslash,\n        0x0B => KeyCode::KeyB,\n        0x0C => KeyCode::KeyQ,\n        0x0D => KeyCode::KeyW,\n        0x0E => KeyCode::KeyE,\n        0x0F => KeyCode::KeyR,\n        0x10 => KeyCode::KeyY,\n        0x11 => KeyCode::KeyT,\n        0x12 => KeyCode::Digit1,\n        0x13 => KeyCode::Digit2,\n        0x14 => KeyCode::Digit3,\n        0x15 => KeyCode::Digit4,\n        0x16 => KeyCode::Digit6,\n        0x17 => KeyCode::Digit5,\n        0x18 => KeyCode::Equal,\n        0x19 => KeyCode::Digit9,\n        0x1A => KeyCode::Digit7,\n        0x1B => KeyCode::Minus,\n        0x1C => KeyCode::Digit8,\n        0x1D => KeyCode::Digit0,\n        0x1E => KeyCode::BracketRight,\n        0x1F => KeyCode::KeyO,\n        0x20 => KeyCode::KeyU,\n        0x21 => KeyCode::BracketLeft,\n        0x22 => KeyCode::KeyI,\n        0x23 => KeyCode::KeyP,\n        0x24 => KeyCode::Enter,\n        0x25 => KeyCode::KeyL,\n        0x26 => KeyCode::KeyJ,\n        0x27 => KeyCode::Quote,\n        0x28 => KeyCode::KeyK,\n        0x29 => KeyCode::Semicolon,\n        0x2A => KeyCode::Backslash,\n        0x2B => KeyCode::Comma,\n        0x2C => KeyCode::Slash,\n        0x2D => KeyCode::KeyN,\n        0x2E => KeyCode::KeyM,\n        0x2F => KeyCode::Period,\n");
        buf_str(out, c"        0x30 => KeyCode::Tab,\n        0x31 => KeyCode::Space,\n        0x32 => KeyCode::Backquote,\n        0x33 => KeyCode::Backspace,\n        0x35 => KeyCode::Escape,\n        0x36 => KeyCode::SuperRight,\n        0x37 => KeyCode::SuperLeft,\n        0x38 => KeyCode::ShiftLeft,\n        0x39 => KeyCode::CapsLock,\n        0x3A => KeyCode::AltLeft,\n        0x3B => KeyCode::ControlLeft,\n        0x3C => KeyCode::ShiftRight,\n        0x3D => KeyCode::AltRight,\n        0x3E => KeyCode::ControlRight,\n        0x3F => KeyCode::Fn,\n        0x40 => KeyCode::F17,\n        0x41 => KeyCode::NumpadDecimal,\n        0x43 => KeyCode::NumpadMultiply,\n        0x45 => KeyCode::NumpadAdd,\n        0x47 => KeyCode::NumLock,\n        0x48 => KeyCode::AudioVolumeUp,\n        0x49 => KeyCode::AudioVolumeDown,\n        0x4A => KeyCode::AudioVolumeMute,\n        0x4B => KeyCode::NumpadDivide,\n        0x4C => KeyCode::NumpadEnter,\n        0x4E => KeyCode::NumpadSubtract,\n        0x4F => KeyCode::F18,\n        0x50 => KeyCode::F19,\n        0x51 => KeyCode::NumpadEqual,\n        0x52 => KeyCode::Numpad0,\n        0x53 => KeyCode::Numpad1,\n        0x54 => KeyCode::Numpad2,\n        0x55 => KeyCode::Numpad3,\n        0x56 => KeyCode::Numpad4,\n        0x57 => KeyCode::Numpad5,\n        0x58 => KeyCode::Numpad6,\n        0x59 => KeyCode::Numpad7,\n        0x5A => KeyCode::F20,\n        0x5B => KeyCode::Numpad8,\n        0x5C => KeyCode::Numpad9,\n        0x5D => KeyCode::IntlYen,\n        0x5E => KeyCode::IntlRo,\n        0x5F => KeyCode::NumpadComma,\n        0x60 => KeyCode::F5,\n        0x61 => KeyCode::F6,\n        0x62 => KeyCode::F7,\n        0x63 => KeyCode::F3,\n        0x64 => KeyCode::F8,\n        0x65 => KeyCode::F9,\n        0x66 => KeyCode::Lang2,\n        0x67 => KeyCode::F11,\n        0x68 => KeyCode::Lang1,\n        0x69 => KeyCode::F13,\n        0x6A => KeyCode::F16,\n        0x6B => KeyCode::F14,\n        0x6D => KeyCode::F10,\n        0x6E => KeyCode::ContextMenu,\n");
        buf_str(out, c"        0x6F => KeyCode::F12,\n        0x71 => KeyCode::F15,\n        0x72 => KeyCode::Insert,\n        0x73 => KeyCode::Home,\n        0x74 => KeyCode::PageUp,\n        0x75 => KeyCode::Delete,\n        0x76 => KeyCode::F4,\n        0x77 => KeyCode::End,\n        0x78 => KeyCode::F2,\n        0x79 => KeyCode::PageDown,\n        0x7A => KeyCode::F1,\n        0x7B => KeyCode::ArrowLeft,\n        0x7C => KeyCode::ArrowRight,\n        0x7D => KeyCode::ArrowDown,\n        0x7E => KeyCode::ArrowUp,\n        _ => KeyCode::Unidentified,\n    }\n}\n\n// Keys that have a name rather than a character.\npub enum Named {\n    Enter,\n    Tab,\n    Backspace,\n    Escape,\n    Delete,\n    Insert,\n    Home,\n    End,\n    PageUp,\n    PageDown,\n    ArrowLeft,\n    ArrowRight,\n    ArrowUp,\n    ArrowDown,\n    Shift,\n    Control,\n    Alt,\n    Super,\n    CapsLock,\n    Fn,\n    ContextMenu,\n    Clear,\n}\n\n// The logical key: what the key means in the current layout, without\n// the modifiers' effect (`charactersIgnoringModifiers`): a named key, a\n// function key F1..F35, or a character.\npub enum Logical {\n    Named(Named),\n    F(i64),\n    Char(u32),\n    Unidentified,\n}\n\n// The logical key for the first character macOS reports (its\n// NSFunctionKey private-use range, control characters, or text).\npub fn mac_logical(c: u32, code: KeyCode) -> Logical {\n    // Modifier keys report no character: name them by their key.\n    match code {\n        KeyCode::ShiftLeft => return Logical::Named(Named::Shift),\n        KeyCode::ShiftRight => return Logical::Named(Named::Shift),\n        KeyCode::ControlLeft => return Logical::Named(Named::Control),\n        KeyCode::ControlRight => return Logical::Named(Named::Control),\n        KeyCode::AltLeft => return Logical::Named(Named::Alt),\n        KeyCode::AltRight => return Logical::Named(Named::Alt),\n        KeyCode::SuperLeft => return Logical::Named(Named::Super),\n");
        buf_str(out, c"        KeyCode::SuperRight => return Logical::Named(Named::Super),\n        KeyCode::CapsLock => return Logical::Named(Named::CapsLock),\n        KeyCode::Fn => return Logical::Named(Named::Fn),\n        _ => {}\n    }\n    if c >= 0xF704 && c <= 0xF726 {\n        return Logical::F((c - 0xF704 + 1) as i64);\n    }\n    match c {\n        0 => Logical::Unidentified,\n        0x03 => Logical::Named(Named::Enter),\n        0x0D => Logical::Named(Named::Enter),\n        0x09 => Logical::Named(Named::Tab),\n        0x19 => Logical::Named(Named::Tab),\n        0x08 => Logical::Named(Named::Backspace),\n        0x7F => Logical::Named(Named::Backspace),\n        0x1B => Logical::Named(Named::Escape),\n        0xF700 => Logical::Named(Named::ArrowUp),\n        0xF701 => Logical::Named(Named::ArrowDown),\n        0xF702 => Logical::Named(Named::ArrowLeft),\n        0xF703 => Logical::Named(Named::ArrowRight),\n        0xF727 => Logical::Named(Named::Insert),\n        0xF728 => Logical::Named(Named::Delete),\n        0xF729 => Logical::Named(Named::Home),\n        0xF72B => Logical::Named(Named::End),\n        0xF72C => Logical::Named(Named::PageUp),\n        0xF72D => Logical::Named(Named::PageDown),\n        0xF735 => Logical::Named(Named::ContextMenu),\n        0xF739 => Logical::Named(Named::Clear),\n        0xF746 => Logical::Named(Named::Insert),\n        _ => {\n            if c >= 0xF700 && c < 0xF900 { Logical::Unidentified } else { Logical::Char(c) }\n        }\n    }\n}\n\n// Modifiers: left and right apart, and caps lock.\npub struct Mods {\n    pub bits: u32,\n}\n\npub const SHIFT_L: u32 = 1;\npub const SHIFT_R: u32 = 2;\npub const CTRL_L: u32 = 4;\npub const CTRL_R: u32 = 8;\npub const ALT_L: u32 = 16;\npub const ALT_R: u32 = 32;\npub const SUPER_L: u32 = 64;\npub const SUPER_R: u32 = 128;\npub const CAPS: u32 = 256;\n\nimpl Mods {\n    pub fn none() -> Mods {\n        Mods { bits: 0 }\n    }\n\n    pub fn shift(self) -> bool {\n");
        buf_str(out, c"        (self.bits & (SHIFT_L | SHIFT_R)) != 0\n    }\n\n    pub fn ctrl(self) -> bool {\n        (self.bits & (CTRL_L | CTRL_R)) != 0\n    }\n\n    pub fn alt(self) -> bool {\n        (self.bits & (ALT_L | ALT_R)) != 0\n    }\n\n    pub fn sup(self) -> bool {\n        (self.bits & (SUPER_L | SUPER_R)) != 0\n    }\n\n    pub fn caps(self) -> bool {\n        (self.bits & CAPS) != 0\n    }\n}\n\n// NSEventModifierFlags: device-independent bits, and the device bits\n// (IOKit's NX_DEVICE*KEYMASK) that tell left from right. A flag without\n// either device bit (a synthesized event) counts as the left key.\npub fn mac_mods(flags: u64) -> Mods {\n    var b: u32 = 0;\n    if (flags & (1 << 16)) != 0 {\n        b = b | CAPS;\n    }\n    b = b | side(flags, 1 << 17, 0x02, 0x04, SHIFT_L, SHIFT_R);\n    b = b | side(flags, 1 << 18, 0x01, 0x2000, CTRL_L, CTRL_R);\n    b = b | side(flags, 1 << 19, 0x20, 0x40, ALT_L, ALT_R);\n    b = b | side(flags, 1 << 20, 0x08, 0x10, SUPER_L, SUPER_R);\n    Mods { bits: b }\n}\n\nfn side(flags: u64, any: u64, left: u64, right: u64, l: u32, r: u32) -> u32 {\n    if (flags & any) == 0 {\n        return 0;\n    }\n    var b: u32 = 0;\n    if (flags & left) != 0 {\n        b = b | l;\n    }\n    if (flags & right) != 0 {\n        b = b | r;\n    }\n    if b == 0 { l } else { b }\n}\n\n// For flagsChanged: whether the modifier key `code` is now down.\npub fn mac_modifier_down(code: KeyCode, flags: u64) -> bool {\n    let m = mac_mods(flags).bits;\n    match code {\n        KeyCode::ShiftLeft => (m & SHIFT_L) != 0,\n        KeyCode::ShiftRight => (m & SHIFT_R) != 0,\n        KeyCode::ControlLeft => (m & CTRL_L) != 0,\n        KeyCode::ControlRight => (m & CTRL_R) != 0,\n        KeyCode::AltLeft => (m & ALT_L) != 0,\n        KeyCode::AltRight => (m & ALT_R) != 0,\n        KeyCode::SuperLeft => (m & SUPER_L) != 0,\n        KeyCode::SuperRight => (m & SUPER_R) != 0,\n        KeyCode::CapsLock => (m & CAPS) != 0,\n");
        buf_str(out, c"        KeyCode::Fn => (flags & (1 << 23)) != 0,\n        _ => false,\n    }\n}\n\n// The first code point of UTF-8 text (0 for none; U+FFFD for a bad\n// sequence).\npub fn first_char(s: [u8]) -> u32 {\n    if s.len == 0 {\n        return 0;\n    }\n    let b = s[0] as u32;\n    if b < 0x80 {\n        return b;\n    }\n    let n = if b >= 0xF0 { 4 } else if b >= 0xE0 { 3 } else if b >= 0xC0 { 2 } else { 0 };\n    if n == 0 || s.len < n {\n        return 0xFFFD;\n    }\n    var c = b & (0x7F >> n);\n    for i in 1..n {\n        c = (c << 6) | (s[i] as u32 & 0x3F);\n    }\n    c\n}\n\n// The byte offset in UTF-8 text of a position counted in UTF-16 units\n// (AppKit's ranges count UTF-16 units; the preedit cursor is reported in\n// bytes). Past the end: the text's length.\npub fn utf16_to_byte(s: [u8], units: i64) -> i64 {\n    var i = 0;\n    var u = 0;\n    while i < s.len && u < units {\n        let b = s[i];\n        let n = if b >= 0xF0 { 4 } else if b >= 0xE0 { 3 } else if b >= 0xC0 { 2 } else { 1 };\n        u += if n == 4 { 2 } else { 1 };\n        i += n;\n    }\n    if i > s.len { s.len } else { i }\n}\n\n// The end of the longest prefix of `s` that is at most `max` bytes and\n// does not split a UTF-8 sequence (for text events' inline bytes).\npub fn utf8_cut(s: [u8], max: i64) -> i64 {\n    if s.len <= max {\n        return s.len;\n    }\n    var n = max;\n    while n > 0 && (s[n] & 0xC0) == 0x80 {\n        n -= 1;\n    }\n    n\n}\n// ---- end mod std::window::keys ----\n}\n// ---- mod std::window::objc ----\nmod objc {\n// std::window's Objective-C layer: a minimal stand-in for std::objc\n// (docs/design/gpu.md §2.9, 0.22) until it lands. Everything here is replaced then: the message shapes by\n// objcgen's generated, runtime-checked wrappers (tables appkit.objc and\n// quartzcore.objc, owned by W1), `Id` by `Id<T>`/`Ref<T>`, the pool\n// functions by `objc::pool`, the class functions by `ClassBuilder`.\n//\n");
        buf_str(out, c"// One typed declaration per selector shape (`#[link_name =\n// \"objc_msgSend\"]`): on arm64 objc_msgSend is a trampoline that keeps\n// every argument register and x8, so a call through a declaration whose\n// C types match the method's is exactly the call clang emits. The shapes\n// are named by their result and arguments: p a pointer (an object, a\n// selector, a C string), v void, u u64, i i64, h u16, b BOOL, d f64,\n// r a rect (4 f64, an HFA in v0-v3), z a size and t a point (2 f64), g\n// an NSRange (2 u64 in x0/x1), c a clear colour (4 f64), m an MTLRegion\n// (48 bytes, passed by reference).\n//\n// Every caller is `unsafe`: a shape used with a selector whose types it\n// does not match is undefined behaviour. The callers are cocoa.vl and\n// voltty's renderer (its copy), each call with the selector's documented\n// types, listed in tables/*.objc and checked against the runtime.\n\n// ---- The Objective-C layer (0.23) ----\n\n#[repr(C)]\npub struct Point {\n    pub x: f64,\n    pub y: f64,\n}\n\n#[repr(C)]\npub struct Size {\n    pub w: f64,\n    pub h: f64,\n}\n\n#[repr(C)]\npub struct Rect {\n    pub x: f64,\n    pub y: f64,\n    pub w: f64,\n    pub h: f64,\n}\n\n#[repr(C)]\npub struct Range {\n    pub loc: u64,\n    pub len: u64,\n}\n\n// The method-description pair protocol_getMethodDescription returns\n// (16 bytes, in x0/x1).\n#[repr(C)]\npub struct MethodDesc {\n    pub name: *u8,\n    pub types: *u8,\n}\n\n// NSNotFound, the location of an empty NSRange.\npub const NOT_FOUND: u64 = 0x7fffffffffffffff;\n\n#[link(lib = \"objc\")]\npub extern \"C\" {\n    fn objc_getClass(name: *u8) -> *u8;\n    fn objc_getProtocol(name: *u8) -> *u8;\n    fn sel_registerName(name: *u8) -> *u8;\n    fn objc_allocateClassPair(superclass: *u8, name: *u8, extra: u64) -> *u8;\n    fn objc_registerClassPair(cls: *u8);\n    fn class_addProtocol(cls: *u8, protocol: *u8) -> bool;\n    fn class_addIvar(cls: *u8, name: *u8, size: u64, align_log2: u8, types: *u8) -> bool;\n");
        buf_str(out, c"    fn class_getInstanceVariable(cls: *u8, name: *u8) -> *u8;\n    fn class_getInstanceMethod(cls: *u8, sel: *u8) -> *u8;\n    fn method_getTypeEncoding(m: *u8) -> *u8;\n    fn ivar_getOffset(ivar: *u8) -> i64;\n    fn protocol_getMethodDescription(p: *u8, sel: *u8, required: bool, instance: bool) -> MethodDesc;\n    fn objc_autoreleasePoolPush() -> *u8;\n    fn objc_autoreleasePoolPop(pool: *u8);\n    fn objc_retain(o: *u8) -> *u8;\n    fn objc_release(o: *u8);\n\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p(o: *u8, s: *u8) -> *u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_p(o: *u8, s: *u8, a: *u8) -> *u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_pp(o: *u8, s: *u8, a: *u8, b: *u8) -> *u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_ppp(o: *u8, s: *u8, a: *u8, b: *u8, c: *u8) -> *u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_u(o: *u8, s: *u8, a: u64) -> *u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_uu(o: *u8, s: *u8, a: u64, b: u64) -> *u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_d(o: *u8, s: *u8, a: f64) -> *u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_r(o: *u8, s: *u8, a: Rect) -> *u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_ruub(o: *u8, s: *u8, a: Rect, b: u64, c: u64, d: bool) -> *u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_rupp(o: *u8, s: *u8, a: Rect, b: u64, c: *u8, d: *u8) -> *u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_uppb(o: *u8, s: *u8, a: u64, b: *u8, c: *u8, d: bool) -> *u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_uuub(o: *u8, s: *u8, a: u64, b: u64, c: u64, d: bool) -> *u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_ppP(o: *u8, s: *u8, a: *u8, b: *u8, err: **u8) -> *u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_pP(o: *u8, s: *u8, a: *u8, err: **u8) -> *u8;\n    // otherEventWithType:location:modifierFlags:timestamp:windowNumber:\n    // context:subtype:data1:data2:\n    #[link_name = \"objc_msgSend\"]\n");
        buf_str(out, c"    fn msg_p_utudipsii(o: *u8, s: *u8, ty: u64, at: Point, flags: u64, time: f64, win: i64,\n        ctx: *u8, sub: i16, d1: i64, d2: i64) -> *u8;\n    // keyEventWithType:location:modifierFlags:timestamp:windowNumber:\n    // context:characters:charactersIgnoringModifiers:isARepeat:keyCode:\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_utudipppbh(o: *u8, s: *u8, ty: u64, at: Point, flags: u64, time: f64, win: i64,\n        ctx: *u8, chars: *u8, plain: *u8, repeat: bool, code: u16) -> *u8;\n    // mouseEventWithType:location:modifierFlags:timestamp:windowNumber:\n    // context:eventNumber:clickCount:pressure:\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_utudipiif(o: *u8, s: *u8, ty: u64, at: Point, flags: u64, time: f64, win: i64,\n        ctx: *u8, num: i64, clicks: i64, pressure: f32) -> *u8;\n\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v(o: *u8, s: *u8);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_p(o: *u8, s: *u8, a: *u8);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_pp(o: *u8, s: *u8, a: *u8, b: *u8);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_pb(o: *u8, s: *u8, a: *u8, b: bool);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_b(o: *u8, s: *u8, a: bool);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_u(o: *u8, s: *u8, a: u64);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_d(o: *u8, s: *u8, a: f64);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_z(o: *u8, s: *u8, a: Size);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_rp(o: *u8, s: *u8, a: Rect, b: *u8);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_pu(o: *u8, s: *u8, a: *u8, b: u64);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_puu(o: *u8, s: *u8, a: *u8, b: u64, c: u64);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_uuuu(o: *u8, s: *u8, a: u64, b: u64, c: u64, d: u64);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_c(o: *u8, s: *u8, a: ClearColor);\n    #[link_name = \"objc_msgSend\"]\n");
        buf_str(out, c"    fn msg_v_mupu(o: *u8, s: *u8, a: MtlRegion, b: u64, c: *u8, d: u64);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_pumu(o: *u8, s: *u8, a: *u8, b: u64, c: MtlRegion, d: u64);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_pg(o: *u8, s: *u8, a: *u8, b: Range);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_pgg(o: *u8, s: *u8, a: *u8, b: Range, c: Range);\n\n    #[link_name = \"objc_msgSend\"]\n    fn msg_u(o: *u8, s: *u8) -> u64;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_u_u(o: *u8, s: *u8, a: u64) -> u64;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_i(o: *u8, s: *u8) -> i64;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_h(o: *u8, s: *u8) -> u16;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_h_u(o: *u8, s: *u8, a: u64) -> u16;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_b(o: *u8, s: *u8) -> bool;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_b_p(o: *u8, s: *u8, a: *u8) -> bool;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_b_pp(o: *u8, s: *u8, a: *u8, b: *u8) -> bool;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_b_i(o: *u8, s: *u8, a: i64) -> bool;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_d(o: *u8, s: *u8) -> f64;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_t(o: *u8, s: *u8) -> Point;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_r(o: *u8, s: *u8) -> Rect;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_r_r(o: *u8, s: *u8, a: Rect) -> Rect;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_r_rp(o: *u8, s: *u8, a: Rect, b: *u8) -> Rect;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_g(o: *u8, s: *u8) -> Range;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_r_gP(o: *u8, s: *u8, a: Range, b: *Range) -> Rect;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_t_tp(o: *u8, s: *u8, a: Point, b: *u8) -> Point;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_gP(o: *u8, s: *u8, a: Range, b: *Range);\n}\n\npub extern \"C\" {\n    fn strlen(s: *u8) -> u64;\n}\n\n");
        buf_str(out, c"// MTLClearColor: four doubles, an HFA passed in v0-v3.\n#[repr(C)]\npub struct ClearColor {\n    pub r: f64,\n    pub g: f64,\n    pub b: f64,\n    pub a: f64,\n}\n\n// MTLRegion: an origin and a size of three u64 each (48 bytes: passed\n// by reference to a copy, as AAPCS64 says for large aggregates).\n#[repr(C)]\npub struct MtlRegion {\n    pub x: u64,\n    pub y: u64,\n    pub z: u64,\n    pub w: u64,\n    pub h: u64,\n    pub d: u64,\n}\n\n// A class by name; null when the runtime has none (its framework is not\n// loaded).\npub fn class(name: *u8) -> *u8 {\n    // SAFETY: objc_getClass reads a NUL-terminated name; every caller\n    // passes a c\"...\" literal.\n    unsafe { objc_getClass(name) }\n}\n\n// A selector by name (registered on first use).\npub fn sel(name: *u8) -> *u8 {\n    // SAFETY: as `class`: a NUL-terminated literal.\n    unsafe { sel_registerName(name) }\n}\n\n// The text of a C string as a slice, valid while the string is (for an\n// NSString's UTF8String: until the autorelease pool around it is\n// popped).\npub unsafe fn cstr(p: *u8) -> [u8] {\n    if p == 0 as *u8 {\n        return \"\";\n    }\n    p[0..strlen(p) as i64]\n}\n\n// The type encoding of an instance method `name` of class `cls` (or of\n// its superclasses), or of the protocol `proto`'s method: the encoding a\n// method added to a subclass must have. Null when neither has it.\npub fn method_types(cls: *u8, proto: *u8, name: *u8) -> *u8 {\n    let s = sel(name);\n    // SAFETY: the runtime's metadata queries take a class (or null), a\n    // protocol (or null) and a selector; they return null or a pointer\n    // into the runtime's own (immortal) metadata.\n    unsafe {\n        if cls != 0 as *u8 {\n            let m = class_getInstanceMethod(cls, s);\n            if m != 0 as *u8 {\n                return method_getTypeEncoding(m);\n            }\n        }\n        if proto != 0 as *u8 {\n            let d = protocol_getMethodDescription(proto, s, true, true);\n");
        buf_str(out, c"            if d.types != 0 as *u8 {\n                return d.types;\n            }\n            let o = protocol_getMethodDescription(proto, s, false, true);\n            return o.types;\n        }\n    }\n    0 as *u8\n}\n\n// An autoreleased NSString with the bytes of `s` (UTF-8). Valid until\n// the enclosing autorelease pool is popped; `retain` keeps it longer.\npub fn nsstring(s: [u8]) -> *u8 {\n    // SAFETY: -[NSString initWithBytes:length:encoding:] reads exactly\n    // `len` bytes at `ptr`; `s` is a live slice. NSUTF8StringEncoding is\n    // 4. alloc/init returns +1, balanced by autorelease.\n    unsafe {\n        let a = msg_p(class(c\"NSString\"), sel(c\"alloc\"));\n        let o = msg_p_puu(a, sel(c\"initWithBytes:length:encoding:\"), s.ptr, s.len as u64, 4);\n        msg_p(o, sel(c\"autorelease\"))\n    }\n}\n\npub extern \"C\" {\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_puu(o: *u8, s: *u8, a: *u8, b: u64, c: u64) -> *u8;\n}\n\n// The UTF-8 bytes of an NSString (or NSAttributedString's string), a\n// view valid until the current autorelease pool is popped.\npub fn nsstring_bytes(o: *u8) -> [u8] {\n    if o == 0 as *u8 {\n        return \"\";\n    }\n    // SAFETY: `o` is an NSString (callers pass the results of methods\n    // typed NSString); UTF8String returns an inner pointer that lives as\n    // long as the pool the caller is inside.\n    unsafe {\n        let p = msg_p(o, sel(c\"UTF8String\"));\n        cstr(p)\n    }\n}\n\npub fn retain(o: *u8) -> *u8 {\n    // SAFETY: objc_retain takes any object or nil.\n    unsafe { objc_retain(o) }\n}\n\npub fn release(o: *u8) {\n    // SAFETY: callers release only what they retained (or got at +1).\n    unsafe { objc_release(o); }\n}\n\npub fn pool_push() -> *u8 {\n    // SAFETY: push and pop are paired by every caller, on the main thread.\n    unsafe { objc_autoreleasePoolPush() }\n}\n\npub fn pool_pop(p: *u8) {\n    // SAFETY: `p` is the token of the matching push.\n");
        buf_str(out, c"    unsafe { objc_autoreleasePoolPop(p); }\n}\n// ---- end mod std::window::objc ----\n}\n// ---- end mod std::window ----\n}\n// ---- mod std::cli ----\npub mod cli {\n// std::cli (0.24, docs/design/cli.md, guide cli): a command-line parser,\n// clap's builder without derive (the overview: below the first banner).\n\nuse std::{Allocator, Buf, Display, Fmt, Gpa, Iterator, Option, Result, Vec, arena_scope};\nuse std::string::{FromStr, str};\n\n// ---- Arguments and commands (0.24) ----\n\n// A Command lists its arguments (flags, options with a value,\n// positionals) and subcommands; `cmd.parse(args)`\n// gives the Matches, or a CliError that `cmd.exit(e)` prints with the\n// usage line (exit code 2; 0 for --help and --version).\n//\n//     let cmd = Command::new_in(\"grep\", gpa).version(\"1.0\")\n//         .arg(Arg::flag(\"count\").short('c').help(\"count the matches\"))\n//         .arg(Arg::option(\"max\").short('m').value_name(\"N\").default(\"0\"))\n//         .arg(Arg::positional(\"pattern\").required())\n//         .arg(Arg::positional(\"file\").multiple());\n//     let m = cmd.parse_or_exit(env::args());\n//     let n = m.get_as::<i64>(\"max\").unwrap_or(0);\n//\n// Accepted: `-v`, `-vvv` (m.count), `-abc` (a cluster of short flags;\n// an option in it takes the rest, `-ofile`), `-o FILE`, `--out FILE`,\n// `--out=FILE`, `--` (everything after it is positional), `-` (a\n// positional). An option takes the next argument as its value even when\n// it starts with '-' (`--n -5`). An option given twice keeps both values\n// (m.values; m.get: the last). A positional takes one value, or every one\n// left with `.multiple()`. A subcommand's name ends its parent's\n// arguments; its own follow.\n//\n// Parsing is pure but for its allocation: the definition is on the Gpa\n// given to Command::new_in, the Matches on the Gpa or on the allocator\n// given to parse_in (an arena: `arena_scope(gpa, |a| { let m =\n");
        buf_str(out, c"// cmd.parse_in(args, a)?; .. })`). Help and error text are built in a\n// scoped arena when cmd.exit prints them. Only exit and parse_or_exit do\n// io.\n\nconst FLAG: i64 = 0;\nconst OPTION: i64 = 1;\nconst POSITIONAL: i64 = 2;\n\n// One argument of a command: a flag (`-v`, `--verbose`), an option with a\n// value (`-o FILE`, `--out FILE`, `--out=FILE`) or a positional, made by\n// Arg::flag, Arg::option or Arg::positional; each method returns the\n// changed Arg. Its name is what Matches asks for (`m.flag(\"verbose\")`);\n// a flag's or option's long form is its name unless `.long(..)`.\npub struct Arg {\n    name: str,\n    kind: i64,\n    short: u8,\n    long: str,\n    help: str,\n    value_name: str,\n    default: str,\n    has_default: bool,\n    required: bool,\n    multiple: bool,\n    cmd: i64,\n}\n\nimpl Arg {\n    fn make(name: str, kind: i64) -> Arg {\n        var long: str = name;\n        if kind == POSITIONAL {\n            long = \"\";\n        }\n        Arg {\n            name: name, kind: kind, short: 0, long: long, help: \"\", value_name: \"\",\n            default: \"\", has_default: false, required: false, multiple: false, cmd: 0,\n        }\n    }\n\n    // A flag, `--NAME` (and `.short('x')`): m.flag(name), m.count(name).\n    pub fn flag(name: str) -> Arg {\n        Arg::make(name, FLAG)\n    }\n\n    // An option with a value, `--NAME VALUE` or `--NAME=VALUE`: m.get(name).\n    pub fn option(name: str) -> Arg {\n        Arg::make(name, OPTION)\n    }\n\n    // A positional argument, in the order of the command's `.arg` calls.\n    pub fn positional(name: str) -> Arg {\n        Arg::make(name, POSITIONAL)\n    }\n\n    // Its one-letter form, `-c`.\n    pub fn short(sink self, c: u8) -> Arg {\n        self.short = c;\n        self\n    }\n\n    // Its long form, `--s`, instead of its name (`\"\"`: none).\n    pub fn long(sink self, s: str) -> Arg {\n        self.long = s;\n        self\n    }\n\n    // Its line in the help.\n");
        buf_str(out, c"    pub fn help(sink self, s: str) -> Arg {\n        self.help = s;\n        self\n    }\n\n    // The name of an option's value in the help, `--out <FILE>` (the name\n    // in capitals by default).\n    pub fn value_name(sink self, s: str) -> Arg {\n        self.value_name = s;\n        self\n    }\n\n    // The value when it is not given (m.get gives it; m.flag stays false).\n    pub fn default(sink self, s: str) -> Arg {\n        self.default = s;\n        self.has_default = true;\n        self\n    }\n\n    // An error when it is not given.\n    pub fn required(sink self) -> Arg {\n        self.required = true;\n        self\n    }\n\n    // A positional that takes every value left (m.values).\n    pub fn multiple(sink self) -> Arg {\n        self.multiple = true;\n        self\n    }\n}\n\n// A command of the tree: its subcommands are those whose parent it is.\nstruct Cmd {\n    name: str,\n    about: str,\n    version: str,\n    parent: i64,\n}\n\n// A program's command line: its name, arguments and subcommands. The\n// tree is kept flat, every command in `cmds` (the first is this one) and\n// every argument in `args` with its command's index.\npub struct Command {\n    cmds: Vec<Cmd>,\n    args: Vec<Arg>,\n    width: i64,\n    gpa: Gpa,\n}\n\nimpl Command {\n    // A command named name, its definition on gpa.\n    pub fn new_in(name: str, gpa: Gpa) -> Command {\n        var cmds: Vec<Cmd> = Vec::new_in(gpa);\n        cmds.push(Cmd { name: name, about: \"\", version: \"\", parent: -1 });\n        Command { cmds: cmds, args: Vec::new_in(gpa), width: 80, gpa: gpa }\n    }\n\n    // The help's line under the name.\n    pub fn about(sink self, s: str) -> Command {\n        self.cmds[0].about = s;\n        self\n    }\n\n    // Its version: `--version` (and `-V`) print `NAME VERSION`.\n    pub fn version(sink self, s: str) -> Command {\n        self.cmds[0].version = s;\n        self\n    }\n\n    // The help's width in columns (80).\n");
        buf_str(out, c"    pub fn width(sink self, n: i64) -> Command {\n        self.width = n;\n        self\n    }\n\n    // Adds an argument.\n    pub fn arg(sink self, a: Arg) -> Command {\n        var x = a;\n        x.cmd = 0;\n        self.args.push(x);\n        self\n    }\n\n    // Adds a subcommand: `prog NAME ...`, m.subcommand().\n    pub fn subcommand(sink self, sub: sink Command) -> Command {\n        let base = self.cmds.len();\n        for i in 0..sub.cmds.len() {\n            var c = sub.cmds[i];\n            c.parent = if c.parent < 0 { 0 } else { c.parent + base };\n            self.cmds.push(c);\n        }\n        for i in 0..sub.args.len() {\n            var a = sub.args[i];\n            a.cmd = a.cmd + base;\n            self.args.push(a);\n        }\n        self\n    }\n\n    // The subcommand of c named name, or -1.\n    fn sub_named(self, c: i64, name: str) -> i64 {\n        for i in 1..self.cmds.len() {\n            if self.cmds[i].parent == c && self.cmds[i].name == name {\n                return i;\n            }\n        }\n        -1\n    }\n\n    fn has_subs(self, c: i64) -> bool {\n        for i in 1..self.cmds.len() {\n            if self.cmds[i].parent == c {\n                return true;\n            }\n        }\n        false\n    }\n}\n\n// ---- Parsing (0.24) ----\n\n// What went wrong, or what was asked instead of a run: --help and\n// --version are CliErrors too, whose exit code is 0.\n#[derive(Eq, Debug, Clone)]\npub enum CliErrorKind {\n    Help,\n    Version,\n    UnknownOption,\n    UnknownCommand,\n    UnexpectedArgument,\n    MissingValue,\n    FlagValue,\n    MissingRequired,\n    InvalidValue,\n}\n\n// An error of parse (or Matches::get_as): Display gives its two lines,\n// `error: ...` and `try: ...`; cmd.exit(e) prints them with the usage line\n// (or the help, the version) and exits with e.exit_code().\npub struct CliError {\n    pub kind: CliErrorKind,\n    // the argument as given ('--outt', '-vx', the bad value)\n    pub text: str,\n");
        buf_str(out, c"    // the command it is about (cmd.render_in prints its usage)\n    cmd: i64,\n    // an unknown short option inside a cluster (`-x` of `-vx`)\n    short: u8,\n    // the argument it is about\n    arg: Arg,\n    // did you mean: a long option (`--` before it) or a command\n    hint: str,\n    hint_long: bool,\n}\n\nimpl CliError {\n    fn new(kind: CliErrorKind, cmd: i64, text: str) -> CliError {\n        CliError {\n            kind: kind, text: text, cmd: cmd, short: 0, arg: Arg::make(\"\", FLAG), hint: \"\",\n            hint_long: false,\n        }\n    }\n\n    fn of(kind: CliErrorKind, cmd: i64, text: str, a: Arg) -> CliError {\n        var e = CliError::new(kind, cmd, text);\n        e.arg = a;\n        e\n    }\n\n    // 0 for --help and --version, else 2 (a usage error, as clap's).\n    pub fn exit_code(self) -> i32 {\n        match self.kind {\n            CliErrorKind::Help => 0,\n            CliErrorKind::Version => 0,\n            _ => 2,\n        }\n    }\n}\n\n// How an argument is written: `--out <FILE>`, `-o <FILE>`, `--verbose`,\n// `<input>`, `<file>...`.\nstruct Spell {\n    a: Arg,\n}\n\nimpl Display for Spell {\n    fn fmt(self, f: inout Fmt) {\n        let a = self.a;\n        if a.kind == POSITIONAL {\n            f.byte('<');\n            f.str(a.name);\n            f.byte('>');\n            if a.multiple {\n                f.str(\"...\");\n            }\n            return;\n        }\n        if a.long.len() > 0 {\n            f.str(\"--\");\n            f.str(a.long);\n        } else {\n            f.byte('-');\n            f.byte(a.short);\n        }\n        if a.kind == OPTION {\n            f.byte(' ');\n            f.display(ValueName { a: a });\n        }\n    }\n}\n\n// `<FILE>`: an option's value name, or its name in capitals.\nstruct ValueName {\n    a: Arg,\n}\n\nimpl Display for ValueName {\n    fn fmt(self, f: inout Fmt) {\n        f.byte('<');\n        if self.a.value_name.len() > 0 {\n            f.str(self.a.value_name);\n");
        buf_str(out, c"        } else {\n            for c in self.a.name.bytes() {\n                f.byte(if c >= 'a' && c <= 'z' { c - 32 } else if c == '-' { '_' } else { c });\n            }\n        }\n        f.byte('>');\n    }\n}\n\nimpl Display for CliError {\n    fn fmt(self, f: inout Fmt) {\n        let sp = Spell { a: self.arg };\n        match self.kind {\n            CliErrorKind::Help => f.str(\"help requested: cmd.exit(e) prints it\"),\n            CliErrorKind::Version => f.str(\"version requested: cmd.exit(e) prints it\"),\n            CliErrorKind::UnknownOption => {\n                f.str(\"error: unknown option '\");\n                if self.short != 0 {\n                    f.byte('-');\n                    f.byte(self.short);\n                    if self.text.len() > 2 {\n                        f.str(\"' in '\");\n                        f.str(self.text);\n                    }\n                } else {\n                    f.str(self.text);\n                }\n                f.str(\"'\\ntry: \");\n                if self.hint.len() > 0 {\n                    if self.hint_long {\n                        f.str(\"--\");\n                    }\n                    f.str(self.hint);\n                } else {\n                    f.str(\"--help\");\n                }\n            }\n            CliErrorKind::UnknownCommand => {\n                f.str(\"error: unknown command '\");\n                f.str(self.text);\n                f.str(\"'\\ntry: \");\n                f.str(if self.hint.len() > 0 { self.hint } else { \"--help\" });\n            }\n            CliErrorKind::UnexpectedArgument => {\n                f.str(\"error: unexpected argument '\");\n                f.str(self.text);\n                f.str(\"'\\ntry: --help\");\n            }\n            CliErrorKind::MissingValue => {\n                f.str(\"error: option '\");\n                if self.short != 0 {\n                    f.byte('-');\n                    f.byte(self.short);\n");
        buf_str(out, c"                } else {\n                    f.str(self.text);\n                }\n                f.str(\"' needs a value\\ntry: \");\n                f.display(sp);\n            }\n            CliErrorKind::FlagValue => {\n                f.str(\"error: flag '\");\n                f.display(sp);\n                f.str(\"' takes no value\\ntry: \");\n                f.display(sp);\n            }\n            CliErrorKind::MissingRequired => {\n                f.str(if self.arg.kind == POSITIONAL { \"error: missing argument '\" }\n                    else { \"error: missing option '\" });\n                f.display(sp);\n                f.str(\"'\\ntry: \");\n                f.display(sp);\n            }\n            CliErrorKind::InvalidValue => {\n                f.str(\"error: invalid value '\");\n                f.str(self.text);\n                f.str(\"' for '\");\n                f.display(sp);\n                f.str(\"'\\ntry: \");\n                f.display(sp);\n            }\n        }\n    }\n}\n\n// The edit distance of a and b: insertions, deletions, substitutions and\n// swaps of two neighbours (`--nmae` is 1 from `--name`); 64 beyond 63\n// bytes.\nfn distance(a: [u8], b: [u8]) -> i64 {\n    if a.len > 63 || b.len > 63 {\n        return 64;\n    }\n    var prev2: [i64; 64] = [0; 64];\n    var prev: [i64; 64] = [0; 64];\n    var cur: [i64; 64] = [0; 64];\n    for j in 0..b.len + 1 {\n        prev[j] = j;\n    }\n    for i in 1..a.len + 1 {\n        cur[0] = i;\n        for j in 1..b.len + 1 {\n            var best = prev[j - 1] + if a[i - 1] == b[j - 1] { 0 } else { 1 };\n            if prev[j] + 1 < best {\n                best = prev[j] + 1;\n            }\n            if cur[j - 1] + 1 < best {\n                best = cur[j - 1] + 1;\n            }\n            if i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1]\n                && prev2[j - 2] + 1 < best {\n                best = prev2[j - 2] + 1;\n            }\n");
        buf_str(out, c"            cur[j] = best;\n        }\n        for j in 0..b.len + 1 {\n            prev2[j] = prev[j];\n            prev[j] = cur[j];\n        }\n    }\n    prev[b.len]\n}\n\n// Whether a candidate at distance d from word is worth suggesting.\nfn near(d: i64, word: [u8]) -> bool {\n    let most = if word.len / 3 > 1 { word.len / 3 } else { 1 };\n    d <= most\n}\n\nimpl Command {\n    // The long option of c nearest to word: its name, or \"\".\n    fn near_long(self, c: i64, word: str) -> str {\n        var best: str = \"\";\n        var bd = 64;\n        for i in 0..self.args.len() {\n            let a = self.args[i];\n            if a.cmd == c && a.kind != POSITIONAL && a.long.len() > 0 {\n                let d = distance(word, a.long);\n                if d < bd {\n                    bd = d;\n                    best = a.long;\n                }\n            }\n        }\n        let builtin: [str; 2] = [\"help\", \"version\"];\n        for k in 0..2 {\n            if k == 1 && self.cmds[c].version.len() == 0 {\n                continue;\n            }\n            let d = distance(word, builtin[k]);\n            if d < bd {\n                bd = d;\n                best = builtin[k];\n            }\n        }\n        if near(bd, word) { best } else { \"\" }\n    }\n\n    // The subcommand of c nearest to word: its name, or \"\".\n    fn near_sub(self, c: i64, word: str) -> str {\n        var best: str = \"\";\n        var bd = 64;\n        for i in 1..self.cmds.len() {\n            if self.cmds[i].parent == c {\n                let d = distance(word, self.cmds[i].name);\n                if d < bd {\n                    bd = d;\n                    best = self.cmds[i].name;\n                }\n            }\n        }\n        if near(bd, word) { best } else { \"\" }\n    }\n\n    // The argument of c with long form name (not a positional), or -1.\n    fn find_long(self, c: i64, name: str) -> i64 {\n        for i in 0..self.args.len() {\n");
        buf_str(out, c"            let a = self.args[i];\n            if a.cmd == c && a.kind != POSITIONAL && a.long.len() > 0 && a.long == name {\n                return i;\n            }\n        }\n        -1\n    }\n\n    // The argument of c with short form ch, or -1.\n    fn find_short(self, c: i64, ch: u8) -> i64 {\n        for i in 0..self.args.len() {\n            let a = self.args[i];\n            if a.cmd == c && a.kind != POSITIONAL && a.short != 0 && a.short == ch {\n                return i;\n            }\n        }\n        -1\n    }\n\n    // Parses args (the program's name first, as env::args() gives them),\n    // the Matches on the command's Gpa.\n    #[no_io]\n    pub fn parse<I: Iterator<Item = str>>(self, args: sink I) -> Result<Matches, CliError> {\n        self.parse_in(args, self.gpa)\n    }\n\n    // Parses args, the Matches on allocator a.\n    #[no_io]\n    pub fn parse_in<I: Iterator<Item = str>, A: Allocator>(self, args: sink I, a: A)\n        -> Result<Matches<A>, CliError> {\n        var it = args;\n        let _ = it.next();\n        var m: Matches<A> = Matches {\n            slots: Vec::new_in(a), owner: Vec::new_in(a), texts: Vec::new_in(a),\n            names: Vec::new_in(a), cmds: Vec::new_in(a), level: 0,\n        };\n        var cur = 0;\n        m.enter(self, 0);\n        var npos = 0;\n        var dashdash = false;\n        // the slot an option waits for its value in, and how it was written\n        var pending = -1;\n        var pending_text: str = \"\";\n        var pending_short: u8 = 0;\n        // a required argument missing: reported at the end, so that a\n        // later --help still prints the help\n        var late = CliError::new(CliErrorKind::Help, 0, \"\");\n        var has_late = false;\n        loop {\n            let tok = match it.next() {\n                Option::Some(t) => t,\n                Option::None => break,\n            };\n            if pending >= 0 {\n                m.push(pending, tok);\n");
        buf_str(out, c"                pending = -1;\n                continue;\n            }\n            let b = tok.as_bytes();\n            if dashdash || b.len < 2 || b[0] != '-' {\n                // a positional, or a subcommand's name\n                if !dashdash {\n                    let sub = self.sub_named(cur, tok);\n                    if sub >= 0 {\n                        match m.finish(cur) {\n                            Err(e) => if !has_late {\n                                late = e;\n                                has_late = true;\n                            },\n                            Ok(_) => {}\n                        }\n                        cur = sub;\n                        m.enter(self, sub);\n                        npos = 0;\n                        continue;\n                    }\n                }\n                let s = m.positional(npos);\n                if s >= 0 {\n                    m.push(s, tok);\n                    if !m.slots[s].arg.multiple {\n                        npos += 1;\n                    }\n                    continue;\n                }\n                if self.has_subs(cur) {\n                    var e = CliError::new(CliErrorKind::UnknownCommand, cur, tok);\n                    e.hint = self.near_sub(cur, tok);\n                    return Err(e);\n                }\n                return Err(CliError::new(CliErrorKind::UnexpectedArgument, cur, tok));\n            }\n            if tok == \"--\" {\n                dashdash = true;\n                continue;\n            }\n            if b[1] == '-' {\n                // --name, --name=value\n                let body = tok.strip_prefix(\"--\").unwrap();\n                var name = body;\n                var value: str = \"\";\n                var has_value = false;\n                match body.split_once('=') {\n                    Option::Some((n, v)) => {\n                        name = n;\n                        value = v;\n");
        buf_str(out, c"                        has_value = true;\n                    }\n                    Option::None => {}\n                }\n                let i = self.find_long(cur, name);\n                if i < 0 {\n                    if name == \"help\" {\n                        return Err(CliError::new(CliErrorKind::Help, cur, tok));\n                    }\n                    if name == \"version\" && self.cmds[cur].version.len() > 0 {\n                        return Err(CliError::new(CliErrorKind::Version, cur, tok));\n                    }\n                    let shown = if has_value { tok.split_once('=').unwrap().0 } else { tok };\n                    var e = CliError::new(CliErrorKind::UnknownOption, cur, shown);\n                    e.hint = self.near_long(cur, name);\n                    e.hint_long = true;\n                    return Err(e);\n                }\n                let s = m.slot_of(i);\n                let a = self.args[i];\n                if a.kind == FLAG {\n                    if has_value {\n                        return Err(CliError::of(CliErrorKind::FlagValue, cur, tok, a));\n                    }\n                    m.slots[s].count += 1;\n                } else if has_value {\n                    m.push(s, value);\n                } else {\n                    pending = s;\n                    pending_text = tok;\n                    pending_short = 0;\n                }\n                continue;\n            }\n            // -abc: short flags, the last may be an option (-ofile, -o file)\n            var j = 1;\n            while j < b.len {\n                let ch = b[j];\n                let i = self.find_short(cur, ch);\n                if i < 0 {\n                    if ch == 'h' {\n                        return Err(CliError::new(CliErrorKind::Help, cur, tok));\n                    }\n                    if ch == 'V' && self.cmds[cur].version.len() > 0 {\n");
        buf_str(out, c"                        return Err(CliError::new(CliErrorKind::Version, cur, tok));\n                    }\n                    var e = CliError::new(CliErrorKind::UnknownOption, cur, tok);\n                    e.short = ch;\n                    // `-verbose` for `--verbose`\n                    if b.len > 2 {\n                        let word = tok.strip_prefix(\"-\").unwrap();\n                        if self.find_long(cur, word) >= 0 {\n                            e.hint = word;\n                        } else {\n                            e.hint = self.near_long(cur, word);\n                        }\n                        e.hint_long = e.hint.len() > 0;\n                    }\n                    return Err(e);\n                }\n                let s = m.slot_of(i);\n                if self.args[i].kind == FLAG {\n                    m.slots[s].count += 1;\n                    j += 1;\n                    continue;\n                }\n                // (after an ASCII byte: UTF-8)\n                var rest = str::from_utf8(b[j + 1..]).unwrap_or(\"\");\n                match rest.strip_prefix(\"=\") {\n                    Option::Some(r) => rest = r,\n                    Option::None => {}\n                }\n                if rest.len() > 0 {\n                    m.push(s, rest);\n                } else {\n                    pending = s;\n                    pending_text = tok;\n                    pending_short = ch;\n                }\n                break;\n            }\n        }\n        if pending >= 0 {\n            var e = CliError::of(CliErrorKind::MissingValue, cur, pending_text,\n                m.slots[pending].arg);\n            e.short = pending_short;\n            return Err(e);\n        }\n        if has_late {\n            return Err(late);\n        }\n        m.finish(cur)?;\n        m.group();\n        Ok(m)\n    }\n}\n\n// ---- Matches (0.24) ----\n\n// An argument of a matched command: how many times it was given, and\n");
        buf_str(out, c"// (after parse) where its values are in Matches.texts.\nstruct Slot {\n    level: i64,\n    index: i64,\n    arg: Arg,\n    count: i64,\n    start: i64,\n    len: i64,\n}\n\n// What parse found: for the command and each subcommand on the line (a\n// level each), every argument's count and values. `m.subcommand()` gives\n// the next level's Matches.\npub struct Matches<A: Allocator = Gpa> {\n    slots: Vec<Slot, A>,\n    // while parsing, the slot of each value; texts: the values\n    owner: Vec<i64, A>,\n    texts: Vec<str, A>,\n    // each level's command: its name and index\n    names: Vec<str, A>,\n    cmds: Vec<i64, A>,\n    level: i64,\n}\n\nimpl<A: Allocator> Matches<A> {\n    // A new level for command c: a slot for each of its arguments.\n    fn enter(inout self, cmd: Command, c: i64) {\n        self.level = self.names.len();\n        self.names.push(cmd.cmds[c].name);\n        self.cmds.push(c);\n        for i in 0..cmd.args.len() {\n            if cmd.args[i].cmd == c {\n                self.slots.push(Slot {\n                    level: self.level, index: i, arg: cmd.args[i], count: 0, start: 0, len: 0,\n                });\n            }\n        }\n    }\n\n    // The slot of argument i on the last level.\n    fn slot_of(self, i: i64) -> i64 {\n        for s in 0..self.slots.len() {\n            if self.slots[s].level == self.level && self.slots[s].index == i {\n                return s;\n            }\n        }\n        -1\n    }\n\n    // The slot of the k-th positional of the last level, or -1.\n    fn positional(self, k: i64) -> i64 {\n        var n = 0;\n        for s in 0..self.slots.len() {\n            if self.slots[s].level == self.level && self.slots[s].arg.kind == POSITIONAL {\n                if n == k {\n                    return s;\n                }\n                n += 1;\n            }\n        }\n        -1\n    }\n\n    fn push(inout self, s: i64, text: str) {\n        self.slots[s].count += 1;\n        self.owner.push(s);\n");
        buf_str(out, c"        self.texts.push(text);\n    }\n\n    // The end of command c's arguments: the defaults, the required ones.\n    fn finish(inout self, c: i64) -> Result<(), CliError> {\n        for s in 0..self.slots.len() {\n            let sl = self.slots[s];\n            if sl.level != self.level || sl.count > 0 {\n                continue;\n            }\n            if sl.arg.has_default {\n                self.owner.push(s);\n                self.texts.push(sl.arg.default);\n            } else if sl.arg.required {\n                return Err(CliError::of(CliErrorKind::MissingRequired, c, \"\", sl.arg));\n            }\n        }\n        Ok(())\n    }\n\n    // Each slot's values together, in the order given; the first level\n    // current.\n    fn group(inout self) {\n        var out: Vec<str, A> = Vec::with_capacity_in(self.texts.len(), self.texts.allocator());\n        for s in 0..self.slots.len() {\n            self.slots[s].start = out.len();\n            for k in 0..self.owner.len() {\n                if self.owner[k] == s {\n                    out.push(self.texts[k]);\n                }\n            }\n            self.slots[s].len = out.len() - self.slots[s].start;\n        }\n        self.texts = out;\n        self.owner.clear();\n        self.level = 0;\n    }\n\n    // The slot of the argument named name on this level.\n    fn find(self, name: str) -> i64 {\n        for s in 0..self.slots.len() {\n            if self.slots[s].level == self.level && self.slots[s].arg.name == name {\n                return s;\n            }\n        }\n        std::panic_str(\n            \"std::cli: Matches: no argument by that name in this command (an Arg's name, not its long or short form)\");\n    }\n\n    // Whether the argument was given (a default does not count).\n    pub fn flag(self, name: str) -> bool {\n        self.slots[self.find(name)].count > 0\n    }\n\n    // How many times it was given: `-vvv` is 3.\n    pub fn count(self, name: str) -> i64 {\n");
        buf_str(out, c"        self.slots[self.find(name)].count\n    }\n\n    // Its value (the last one given), else its default.\n    pub fn get(self, name: str) -> Option<str> {\n        let sl = self.slots[self.find(name)];\n        if sl.len == 0 {\n            return Option::None;\n        }\n        Option::Some(self.texts[sl.start + sl.len - 1])\n    }\n\n    // Every value given, in order (or its default).\n    pub fn values(self, name: str) -> [str] {\n        let sl = self.slots[self.find(name)];\n        self.texts.as_slice()[sl.start..sl.start + sl.len]\n    }\n\n    // Its value parsed as a T (`m.get_as::<i64>(\"n\")`): an InvalidValue\n    // error naming the argument when it does not parse, MissingRequired\n    // when it has no value (give it a default, or make it required).\n    pub fn get_as<T: FromStr>(self, name: str) -> Result<T, CliError> {\n        let sl = self.slots[self.find(name)];\n        let c = self.cmds[self.level];\n        if sl.len == 0 {\n            return Err(CliError::of(CliErrorKind::MissingRequired, c, \"\", sl.arg));\n        }\n        let text = self.texts[sl.start + sl.len - 1];\n        match T::from_str(text) {\n            Ok(v) => Ok(v),\n            Err(_) => Err(CliError::of(CliErrorKind::InvalidValue, c, text, sl.arg)),\n        }\n    }\n\n    // The subcommand given, its name, or None.\n    pub fn subcommand_name(self) -> Option<str> {\n        if self.level + 1 < self.names.len() {\n            return Option::Some(self.names[self.level + 1]);\n        }\n        Option::None\n    }\n\n    // The subcommand given: its name and its Matches (a copy), or None.\n    pub fn subcommand(self) -> Option<(str, Matches<A>)> {\n        if self.level + 1 >= self.names.len() {\n            return Option::None;\n        }\n        let sub = Matches {\n            slots: self.slots.clone(), owner: self.owner.clone(), texts: self.texts.clone(),\n            names: self.names.clone(), cmds: self.cmds.clone(), level: self.level + 1,\n        };\n");
        buf_str(out, c"        Option::Some((self.names[self.level + 1], sub))\n    }\n}\n\n// ---- Help and errors (0.24) ----\n\n// Writes text from column col (already there) to width, breaking at\n// spaces; later lines start at column indent.\nfn wrap<A: Allocator>(out: inout Buf<A>, text: str, col: i64, indent: i64, width: i64) {\n    var at = col;\n    var first = true;\n    for w in text.split(' ') {\n        if w.len() == 0 {\n            continue;\n        }\n        if !first {\n            if at + 1 + w.len() > width && at > indent {\n                out.push('\\n');\n                for _ in 0..indent {\n                    out.push(' ');\n                }\n                at = indent;\n            } else {\n                out.push(' ');\n                at += 1;\n            }\n        }\n        out.push_str(w);\n        at += w.len();\n        first = false;\n    }\n}\n\nimpl Command {\n    // `git remote add`: the names from the root to c.\n    fn path_into<A: Allocator>(self, c: i64, out: inout Buf<A>) {\n        let p = self.cmds[c].parent;\n        if p >= 0 {\n            self.path_into(p, &out);\n            out.push(' ');\n        }\n        out.push_str(self.cmds[c].name);\n    }\n\n    // `usage: prog [options] --out <FILE> <input> [file]... [command]`\n    fn usage_into<A: Allocator>(self, c: i64, out: inout Buf<A>) {\n        out.push_str(\"usage: \");\n        self.path_into(c, &out);\n        out.push_str(\" [options]\");\n        for i in 0..self.args.len() {\n            let a = self.args[i];\n            if a.cmd == c && a.kind == OPTION && a.required {\n                out.push(' ');\n                out.push_fmt(Spell { a: a });\n            }\n        }\n        for i in 0..self.args.len() {\n            let a = self.args[i];\n            if a.cmd == c && a.kind == POSITIONAL {\n                out.push(' ');\n                if a.required {\n                    out.push_fmt(Spell { a: a });\n                } else {\n                    out.push('[');\n");
        buf_str(out, c"                    out.push_str(a.name);\n                    out.push(']');\n                    if a.multiple {\n                        out.push_str(\"...\");\n                    }\n                }\n            }\n        }\n        if self.has_subs(c) {\n            out.push_str(\" [command]\");\n        }\n    }\n\n    // An argument's left column: `-o, --out <FILE>`, `    --tag`, `<input>`.\n    fn left_into<A: Allocator>(self, a: Arg, out: inout Buf<A>) {\n        if a.kind == POSITIONAL {\n            out.push_fmt(Spell { a: a });\n            return;\n        }\n        if a.short != 0 {\n            out.push('-');\n            out.push(a.short);\n            if a.long.len() > 0 {\n                out.push_str(\", \");\n            }\n        } else {\n            out.push_str(\"    \");\n        }\n        if a.long.len() > 0 {\n            out.push_str(\"--\");\n            out.push_str(a.long);\n        }\n        if a.kind == OPTION {\n            out.push(' ');\n            out.push_fmt(ValueName { a: a });\n        }\n    }\n\n    // The rest of a table's line begun at out[start..] (its left column\n    // written): its help at column col.\n    fn row_end<A: Allocator>(self, out: inout Buf<A>, start: i64, help: str, default: str,\n        has_default: bool, col: i64) {\n        var at = out.len() - start;\n        if help.len() > 0 || has_default {\n            if at + 2 > col {\n                out.push('\\n');\n                at = 0;\n            }\n            while at < col {\n                out.push(' ');\n                at += 1;\n            }\n            wrap(&out, help, col, col, self.width);\n            if has_default {\n                if help.len() > 0 {\n                    out.push(' ');\n                }\n                out.push_str(\"[default: \");\n                out.push_str(default);\n                out.push(']');\n            }\n        }\n        out.push('\\n');\n    }\n\n");
        buf_str(out, c"    // A table's line: name, then its help at column col.\n    fn row<A: Allocator>(self, out: inout Buf<A>, name: str, help: str, col: i64) {\n        let start = out.len();\n        out.push_str(\"  \");\n        out.push_str(name);\n        self.row_end(&out, start, help, \"\", false, col);\n    }\n\n    // An argument's line of a table.\n    fn arg_row<A: Allocator>(self, out: inout Buf<A>, x: Arg, col: i64) {\n        let start = out.len();\n        out.push_str(\"  \");\n        self.left_into(x, &out);\n        self.row_end(&out, start, x.help, x.default, x.has_default, col);\n    }\n\n    // The help of command c.\n    fn help_into<A: Allocator>(self, c: i64, out: inout Buf<A>, a: A) {\n        let cmd = self.cmds[c];\n        self.path_into(c, &out);\n        if cmd.version.len() > 0 {\n            out.push(' ');\n            out.push_str(cmd.version);\n        }\n        out.push('\\n');\n        if cmd.about.len() > 0 {\n            wrap(&out, cmd.about, 0, 0, self.width);\n            out.push('\\n');\n        }\n        out.push('\\n');\n        self.usage_into(c, &out);\n        out.push('\\n');\n        // the left column's width: the widest entry, at most 24\n        var left = Buf::new_in(a);\n        var widest = 13;\n        for i in 0..self.args.len() {\n            if self.args[i].cmd == c {\n                left.clear();\n                self.left_into(self.args[i], &left);\n                if left.len() > widest && left.len() <= 24 {\n                    widest = left.len();\n                }\n            }\n        }\n        for i in 1..self.cmds.len() {\n            if self.cmds[i].parent == c && self.cmds[i].name.len() > widest\n                && self.cmds[i].name.len() <= 24 {\n                widest = self.cmds[i].name.len();\n            }\n        }\n        let col = 2 + widest + 2;\n        var any = false;\n        for i in 0..self.args.len() {\n            let x = self.args[i];\n            if x.cmd == c && x.kind == POSITIONAL {\n");
        buf_str(out, c"                if !any {\n                    out.push_str(\"\\narguments:\\n\");\n                    any = true;\n                }\n                self.arg_row(&out, x, col);\n            }\n        }\n        out.push_str(\"\\noptions:\\n\");\n        var own_help = false;\n        var own_version = false;\n        for i in 0..self.args.len() {\n            let x = self.args[i];\n            if x.cmd == c && x.kind != POSITIONAL {\n                self.arg_row(&out, x, col);\n                if x.long == \"help\" || x.short == 'h' {\n                    own_help = true;\n                }\n                if x.long == \"version\" || x.short == 'V' {\n                    own_version = true;\n                }\n            }\n        }\n        if !own_help {\n            self.row(&out, \"-h, --help\", \"print this help\", col);\n        }\n        if !own_version && cmd.version.len() > 0 {\n            self.row(&out, \"-V, --version\", \"print the version\", col);\n        }\n        if self.has_subs(c) {\n            out.push_str(\"\\ncommands:\\n\");\n            for i in 1..self.cmds.len() {\n                if self.cmds[i].parent == c {\n                    self.row(&out, self.cmds[i].name, self.cmds[i].about, col);\n                }\n            }\n        }\n    }\n\n    // The help, on allocator a.\n    pub fn help_in<A: Allocator>(self, a: A) -> Buf<A> {\n        var out = Buf::new_in(a);\n        self.help_into(0, &out, a);\n        out\n    }\n\n    // What cmd.exit(e) prints, on allocator a: the help or the version\n    // line, or e's two lines and the usage line.\n    pub fn render_in<A: Allocator>(self, e: CliError, a: A) -> Buf<A> {\n        var out = Buf::new_in(a);\n        match e.kind {\n            CliErrorKind::Help => self.help_into(e.cmd, &out, a),\n            CliErrorKind::Version => {\n                self.path_into(e.cmd, &out);\n                out.push(' ');\n                out.push_str(self.cmds[e.cmd].version);\n");
        buf_str(out, c"                out.push('\\n');\n            }\n            _ => {\n                out.push_fmt(e);\n                out.push('\\n');\n                self.usage_into(e.cmd, &out);\n                out.push('\\n');\n            }\n        }\n        out\n    }\n\n    // Prints what e asks (the help and the version to stdout, an error\n    // to stderr) and ends the program with e.exit_code().\n    pub fn exit(self, e: CliError) -> ! {\n        let code = e.exit_code();\n        arena_scope(self.gpa, |a| {\n            let text = self.render_in(e, a);\n            if code == 0 {\n                std::print(text.as_slice());\n            } else {\n                std::eprint(text.as_slice());\n            }\n        });\n        std::process::exit(code)\n    }\n\n    // parse, and on an error (or --help, --version) cmd.exit(e).\n    pub fn parse_or_exit<I: Iterator<Item = str>>(self, args: sink I) -> Matches {\n        match self.parse(args) {\n            Ok(m) => m,\n            Err(e) => self.exit(e),\n        }\n    }\n}\n// ---- end mod std::cli ----\n}\n");
    }
    std_alloc_tail(out);
}

// Gpa's implementation (0.16), the end of std's source unless
// --check-alloc (front/stdalloc.vl).
pub fn std_gpa_source(out: i64) {
    unsafe {
        buf_str(out, c"// ---- Gpa's implementation (0.16) ----\n\n// C's allocator; malloc's memory is aligned to 16, larger alignments go\n// through posix_memalign. (--check-alloc replaces this part of std with\n// alloc_check.vl.)\n\nextern \"C\" {\n    #[effects(alloc(extern))]\n    fn posix_memalign(out: **u8, align: u64, size: u64) -> i32;\n}\n\nconst GPA_MALLOC_ALIGN: i64 = 16;\n\nimpl Allocator for Gpa {\n    #[inline]\n    fn try_alloc(self: *Gpa, size: i64, align: i64) -> *u8 {\n        if size == 0 {\n            // (a pointer nothing is read through)\n            return unsafe { align as *u8 };\n        }\n        if align > GPA_MALLOC_ALIGN {\n            return gpa_aligned(size, align);\n        }\n        unsafe { malloc(size as u64) }\n    }\n\n    #[inline]\n    unsafe fn try_resize(self: *Gpa, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n        if align > GPA_MALLOC_ALIGN || new_size == 0 {\n            return gpa_resize_slow(p, old_size, new_size, align);\n        }\n        realloc(if old_size == 0 { 0 as *u8 } else { p }, new_size as u64)\n    }\n\n    #[inline]\n    unsafe fn free(self: *Gpa, p: *u8, size: i64, align: i64) {\n        if size != 0 {\n            free(p);\n        }\n    }\n}\n\n// size bytes (not 0) aligned to align (above malloc's), or null.\nfn gpa_aligned(size: i64, align: i64) -> *u8 {\n    var p = 0 as *u8;\n    if unsafe { posix_memalign(&p, align as u64, size as u64) } != 0 {\n        return 0 as *u8;\n    }\n    p\n}\n\n// Gpa::try_resize to 0 bytes, or above malloc's alignment.\n#[cold]\nunsafe fn gpa_resize_slow(p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n    if new_size == 0 {\n        if old_size != 0 {\n            free(p);\n        }\n        return align as *u8;\n    }\n    let q = gpa_aligned(new_size, align);\n    if q == 0 as *u8 {\n        return q;\n    }\n    let n = if old_size < new_size { old_size } else { new_size };\n    for i in 0..n {\n        q[i] = p[i];\n    }\n    if old_size != 0 {\n");
        buf_str(out, c"        free(p);\n    }\n    q\n}\n\n// ---- Gpa's leak checks (0.16) ----\n\nimpl Gpa {\n    // The blocks allocated and not freed: -1, unknown, unless --check-alloc\n    // (the checking allocator, compiler/std/alloc_check.vl).\n    pub fn live_blocks(self) -> i64 {\n        -1\n    }\n\n    // Whether no block is left allocated (with --check-alloc, which lists\n    // them); always true without.\n    pub fn check_leaks(self) -> bool {\n        true\n    }\n}\n\n// (0.18) The checking allocator's leaks since a mark (alloc_check.vl):\n// nothing to count without --check-alloc.\nfn check_alloc_leaks_since(mark: i64) -> i64 {\n    0\n}\n\n// ---- The checking allocator's hooks for arenas (0.16) ----\n\n// With --check-alloc (CHECK_ALLOC), arenas route each allocation to the\n// checking allocator's pages (compiler/std/alloc_check.vl); without, these\n// are never called.\n\n// A block of size bytes for the allocator whose state is at owner.\nfn check_alloc_block(owner: u64, size: i64, align: i64) -> *u8 {\n    0 as *u8\n}\n\n// p, a block of owner of old_size bytes, moved to new_size bytes.\nunsafe fn check_alloc_moved(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64)\n    -> *u8 {\n    0 as *u8\n}\n\n// The blocks allocated so far: a mark for check_alloc_release.\nfn check_alloc_mark() -> i64 {\n    0\n}\n\n// Every block of owner allocated after mark given back.\nfn check_alloc_release(owner: u64, mark: i64) {}\n\n// Whether p is the last live block of owner (an arena's last block grows\n// and is given back in place).\nfn check_alloc_is_last(owner: u64, p: *u8) -> bool {\n    false\n}\n\n// The site of the call being run, and that site set again (a scope's end\n// is its call's).\nfn check_alloc_site() -> *u8 {\n    0 as *u8\n}\n\nfn check_alloc_set_site(site: *u8) {}\n");
    }
}

// The checking Gpa (0.16), the end of std's source with --check-alloc
// (front/stdalloc.vl).
pub fn std_check_gpa_source(out: i64) {
    unsafe {
        buf_str(out, c"// ---- Gpa's leak checks (0.16) ----\n\nimpl Gpa {\n    // The blocks allocated and not freed: -1, unknown, unless --check-alloc.\n    pub fn live_blocks(self) -> i64 {\n        CHECK_LIVE\n    }\n\n    // Whether no block is left allocated (with --check-alloc, which lists\n    // them); always true without.\n    pub fn check_leaks(self) -> bool {\n        unsafe { check_alloc_list_leaks() }\n        CHECK_LIVE == 0\n    }\n}\n\n// (0.18) The blocks allocated from `mark` (check_alloc_mark) on and not\n// freed, listed as at exit (the first line names them a case's): a\n// property's case, or a fuzz run, leaks them (test_case, fuzz_exec);\n// their count.\nfn check_alloc_leaks_since(mark: i64) -> i64 {\n    var live = 0;\n    var bytes = 0;\n    unsafe {\n        for b in mark..CHECK_COUNT {\n            if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n                live += 1;\n                bytes += CHECK_BLOCKS[b].size;\n            }\n        }\n        if live == 0 {\n            return 0;\n        }\n        var m = check_msg();\n        m.text(\"check-alloc: \");\n        m.int(live);\n        m.text(if live == 1 { \" block\" } else { \" blocks\" });\n        m.text(\" of Gpa not freed by the case (\");\n        m.int(bytes);\n        m.text(\" bytes):\");\n        m.out();\n        var shown = 0;\n        for b in mark..CHECK_COUNT {\n            if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK\n                && shown < 20 {\n                var line = check_msg();\n                line.text(\"  \");\n                check_describe(&line, b);\n                line.out();\n                shown += 1;\n            }\n        }\n        CHECK_LISTED = CHECK_CHANGES;\n    }\n    live\n}\n\n// ---- Gpa's implementation: the checking allocator (0.16, --check-alloc) ----\n\n// With --check-alloc (docs/design/effects-allocation.md, §2.5), Gpa gives\n");
        buf_str(out, c"// every block pages of its own, at the cursor of a large reservation of\n// address space with no access: a block's pages are made readable and\n// writable when it is allocated, and are given back with no access when it\n// is freed, never to be handed out again; every resize moves. A later\n// access to a freed block faults, and the fault handler names the block,\n// where it was allocated and where freed (the compiler stores the site of\n// each call from the program that may allocate in CHECK_ALLOC_SITE). Frees\n// are checked: double, invalid and wrong-size frees stop the program; the\n// blocks left at exit are listed. Arenas route their allocations here too\n// (check_alloc_block, check_alloc_release). Block numbers count every\n// allocation from 1, the same each run: VOLE_ALLOC_TRAP=N raises SIGTRAP\n// when block N is allocated, for a debugger.\n\n// (Its messages and stops are the allocator's misuse, the effect `alloc`:\n// not io, which an allocator may not do.)\nextern \"C\" {\n    #[effects(alloc(extern), global)]\n    fn mmap(addr: *u8, len: u64, prot: i32, flags: i32, fd: i32, offset: i64) -> *u8;\n    #[effects(alloc(extern), global)]\n    fn mprotect(addr: *u8, len: u64, prot: i32) -> i32;\n    #[effects(global)]\n    fn getpagesize() -> i32;\n    #[effects(global)]\n    fn getenv(name: *u8) -> *u8;\n    #[effects(global)]\n    fn raise(sig: i32) -> i32;\n    #[effects(global)]\n    fn atexit(f: extern \"C\" fn()) -> i32;\n    #[effects(global)]\n    fn sigaction(sig: i32, act: *CheckSigaction, old: *CheckSigaction) -> i32;\n    #[link_name = \"write\"]\n    #[effects(global)]\n    fn check_write(fd: i32, data: *u8, count: u64) -> i64;\n    #[effects(diverge)]\n    fn _exit(code: i32) -> !;\n}\n\n// The site of the program's call being run that may allocate (`main.vl:\n// 14:9`, a C string), stored by the compiled program before the call.\nstatic var CHECK_ALLOC_SITE: *u8 = 0 as *u8;\n\n");
        buf_str(out, c"// A block: its pages [start, start + span), its size, its allocator (0:\n// Gpa, else an arena's state), its state, and where it was allocated and\n// freed.\nstruct CheckBlock {\n    start: u64,\n    size: i64,\n    span: i64,\n    owner: u64,\n    state: i64,\n    alloc_site: *u8,\n    free_site: *u8,\n}\n\nconst CHECK_LIVE_BLOCK: i64 = 1;\nconst CHECK_FREED: i64 = 2;\nconst CHECK_RELEASED: i64 = 3;\n\n// Every block, in the order allocated (block #N is CHECK_BLOCKS[N - 1]).\nstatic var CHECK_BLOCKS: *CheckBlock = 0 as *CheckBlock;\nstatic var CHECK_COUNT: i64 = 0;\nstatic var CHECK_CAP: i64 = 0;\n// The live blocks of Gpa (arenas' blocks are not counted).\nstatic var CHECK_LIVE: i64 = 0;\n// The reservations of address space (regions): their bounds and their\n// first block; a region's blocks follow each other (blocks are never\n// placed in an earlier region), so the blocks are sorted by address within\n// one. The cursor is in the last region.\nconst CHECK_MAX_REGIONS: i64 = 256;\nstatic var CHECK_REGION_START: [u64; 256] = [0; 256];\nstatic var CHECK_REGION_END: [u64; 256] = [0; 256];\nstatic var CHECK_REGION_FIRST: [i64; 256] = [0; 256];\nstatic var CHECK_REGIONS: i64 = 0;\nstatic var CHECK_CURSOR: u64 = 0;\n// The page size, 0 until the first allocation.\nstatic var CHECK_PAGE: i64 = 0;\n// VOLE_ALLOC_TRAP; VOLE_ALLOC_MAX_LIVE (the map limit's message when\n// this many blocks are live: for tests, on any system); 0 when unset.\nstatic var CHECK_TRAP: i64 = 0;\nstatic var CHECK_MAX_LIVE: i64 = 0;\n// The changes to the blocks (allocations and frees), and their count when\n// check_leaks listed the leaks (the exit's list is left out then).\nstatic var CHECK_CHANGES: i64 = 0;\nstatic var CHECK_LISTED: i64 = -1;\n\nconst CHECK_REGION_BYTES: u64 = 68719476736;\nconst CHECK_PROT_NONE: i32 = 0;\nconst CHECK_PROT_RW: i32 = 3;\n\n// The system's constants: macOS (CHECK_ALLOC_OS 0) and Linux (1).\nfn check_map_flags() -> i32 {\n");
        buf_str(out, c"    // MAP_PRIVATE | MAP_ANON | MAP_NORESERVE\n    if CHECK_ALLOC_OS == 1 { 2 | 32 | 16384 } else { 2 | 4096 | 64 }\n}\n\nconst CHECK_MAP_FIXED: i32 = 16;\n\nfn check_sigbus() -> i32 {\n    if CHECK_ALLOC_OS == 1 { 7 } else { 10 }\n}\n\n// struct sigaction: the handler, then (macOS) a 4-byte mask and the flags,\n// or (glibc) a 128-byte mask and the flags.\n#[repr(C)]\nstruct CheckSigaction { handler: extern \"C\" fn(i32, *u8, *u8), words: [u64; 19] }\n\nfn check_sigaction() -> CheckSigaction {\n    var a = CheckSigaction { handler: unsafe { check_alloc_fault }, words: [0; 19] };\n    if CHECK_ALLOC_OS == 1 {\n        // SA_SIGINFO | SA_RESETHAND\n        a.words[16] = 4 | 2147483648;\n    } else {\n        a.words[0] = (64 | 4) << 32;\n    }\n    a\n}\n\n// The offset of si_addr in siginfo_t.\nfn check_si_addr() -> u64 {\n    if CHECK_ALLOC_OS == 1 { 16 } else { 24 }\n}\n\n// A message, written to stderr at once.\nstruct CheckMsg { len: i64, bytes: [u8; 2048] }\n\nimpl CheckMsg {\n    fn text(inout self, s: [u8]) {\n        for i in 0..s.len {\n            if self.len < 2048 {\n                self.bytes[self.len] = s[i];\n                self.len += 1;\n            }\n        }\n    }\n\n    unsafe fn cstr(inout self, s: *u8) {\n        var n = 0;\n        while s[n] != 0 {\n            n += 1;\n        }\n        self.text(s[0..n]);\n    }\n\n    fn int(inout self, v: i64) {\n        if v < 0 {\n            self.text(\"-\");\n            self.int(0 - v);\n            return;\n        }\n        if v >= 10 {\n            self.int(v / 10);\n        }\n        let d: [u8; 1] = [('0' as i64 + v % 10) as u8];\n        self.text(d[0..1]);\n    }\n\n    fn hex(inout self, v: u64) {\n        self.text(\"0x\");\n        let digits = \"0123456789abcdef\";\n        var started = false;\n        for k in 0..16 {\n            let d = (v >> ((15 - k) * 4) as u64) & 15;\n            if d != 0 || started || k == 15 {\n                started = true;\n");
        buf_str(out, c"                self.text(digits[d as i64..d as i64 + 1]);\n            }\n        }\n    }\n\n    unsafe fn site(inout self, s: *u8) {\n        if s == 0 as *u8 {\n            self.text(\"an unknown place\");\n        } else {\n            self.cstr(s);\n        }\n    }\n\n    // `block #N (48 bytes)`, ` of an arena`.\n    fn block(inout self, b: i64) {\n        unsafe {\n            self.text(\"block #\");\n            self.int(b + 1);\n            self.text(\" (\");\n            self.int(CHECK_BLOCKS[b].size);\n            self.text(if CHECK_BLOCKS[b].size == 1 { \" byte)\" } else { \" bytes)\" });\n            if CHECK_BLOCKS[b].owner != 0 {\n                self.text(\" of an arena\");\n            }\n        }\n    }\n\n    fn out(inout self) {\n        self.text(\"\\n\");\n        unsafe {\n            check_write(2, &self.bytes[0], self.len as u64);\n        }\n    }\n}\n\nfn check_msg() -> CheckMsg {\n    CheckMsg { len: 0, bytes: [0; 2048] }\n}\n\n// Stops the program with message m (exit 101, without the leaks' list).\nfn check_stop(m: inout CheckMsg) -> ! {\n    m.out();\n    unsafe { _exit(101) }\n}\n\n// `block #N (48 bytes), allocated at X[, freed at Y]`.\nunsafe fn check_describe(m: *CheckMsg, b: i64) {\n    m.block(b);\n    m.text(\", allocated at \");\n    m.site(CHECK_BLOCKS[b].alloc_site);\n    if CHECK_BLOCKS[b].state != CHECK_LIVE_BLOCK {\n        m.text(if CHECK_BLOCKS[b].state == CHECK_FREED { \", freed at \" } else { \", released at \" });\n        m.site(CHECK_BLOCKS[b].free_site);\n        if CHECK_BLOCKS[b].state == CHECK_RELEASED {\n            m.text(\" (the arena's reset or scope end)\");\n        }\n    }\n}\n\n// The decimal number in C string s (0 when null or none).\n// (0.21: VOLE_X wins over VOLE_X, the name from 0.24)\nunsafe fn check_env_int(vole: *u8, name: *u8) -> i64 {\n    var s = getenv(vole);\n    if s == 0 as *u8 {\n        s = getenv(name);\n    }\n    if s == 0 as *u8 {\n        return 0;\n    }\n    var v = 0;\n");
        buf_str(out, c"    var i = 0;\n    while s[i] >= '0' && s[i] <= '9' {\n        v = v * 10 + (s[i] - '0') as i64;\n        i += 1;\n    }\n    v\n}\n\n// The first allocation: the page size, the fault handlers, the leaks'\n// list at exit, the environment.\nunsafe fn check_init() {\n    CHECK_PAGE = getpagesize() as i64;\n    let a = check_sigaction();\n    sigaction(11, &a, 0 as *CheckSigaction);\n    sigaction(check_sigbus(), &a, 0 as *CheckSigaction);\n    atexit(check_alloc_at_exit);\n    CHECK_TRAP = check_env_int(c\"VOLE_ALLOC_TRAP\", c\"VOLE_ALLOC_TRAP\");\n    CHECK_MAX_LIVE = check_env_int(c\"VOLE_ALLOC_MAX_LIVE\", c\"VOLE_ALLOC_MAX_LIVE\");\n}\n\n// The system refused to change a block's pages: on Linux, the limit of\n// memory maps (each run of live blocks between freed ones is a map).\nunsafe fn check_map_limit() -> ! {\n    var m = check_msg();\n    m.text(\"check-alloc: out of memory maps at block #\");\n    m.int(CHECK_COUNT + 1);\n    m.text(\", with \");\n    m.int(CHECK_LIVE);\n    m.text(\" blocks live: the kernel's vm.max_map_count is reached (every live block has pages of its own)\");\n    m.text(\"\\ntry: sudo sysctl vm.max_map_count=1048576\");\n    check_stop(&m)\n}\n\n// A new region of at least `bytes`, or false.\nunsafe fn check_reserve(bytes: u64) -> bool {\n    if CHECK_REGIONS == CHECK_MAX_REGIONS {\n        return false;\n    }\n    var size = CHECK_REGION_BYTES;\n    while size < bytes {\n        size = size * 2;\n    }\n    loop {\n        let p = mmap(0 as *u8, size, CHECK_PROT_NONE, check_map_flags(), -1, 0);\n        if p as i64 != -1 {\n            let r = CHECK_REGIONS;\n            CHECK_REGION_START[r] = p as u64;\n            CHECK_REGION_END[r] = p as u64 + size;\n            CHECK_REGION_FIRST[r] = CHECK_COUNT;\n            CHECK_REGIONS += 1;\n            CHECK_CURSOR = p as u64;\n            return true;\n        }\n        // (less address space: smaller reservations)\n        if size / 2 < bytes || size <= 1073741824 {\n");
        buf_str(out, c"            return false;\n        }\n        size = size / 2;\n    }\n}\n\n// A new block of size bytes on pages of its own, for allocator owner (0:\n// Gpa), or null when out of memory.\nunsafe fn check_new_block(owner: u64, size: i64) -> *u8 {\n    if CHECK_PAGE == 0 {\n        check_init();\n    }\n    if size < 0 || size > 4611686018427387904 {\n        return 0 as *u8;\n    }\n    let page = CHECK_PAGE as u64;\n    let span = (size as u64 + page - 1) / page * page;\n    if CHECK_REGIONS == 0 || CHECK_CURSOR + span > CHECK_REGION_END[CHECK_REGIONS - 1] {\n        if !check_reserve(span) {\n            return 0 as *u8;\n        }\n    }\n    if CHECK_MAX_LIVE > 0 && CHECK_LIVE >= CHECK_MAX_LIVE {\n        check_map_limit();\n    }\n    let p = CHECK_CURSOR as *u8;\n    if mprotect(p, span, CHECK_PROT_RW) != 0 {\n        if CHECK_ALLOC_OS == 1 {\n            check_map_limit();\n        }\n        return 0 as *u8;\n    }\n    CHECK_CURSOR += span;\n    if CHECK_COUNT == CHECK_CAP {\n        CHECK_CAP = if CHECK_CAP == 0 { 1024 } else { CHECK_CAP * 2 };\n        CHECK_BLOCKS = realloc(CHECK_BLOCKS as *u8, (CHECK_CAP * size_of(CheckBlock)) as u64)\n            as *CheckBlock;\n    }\n    CHECK_BLOCKS[CHECK_COUNT] = CheckBlock {\n        start: p as u64,\n        size: size,\n        span: span as i64,\n        owner: owner,\n        state: CHECK_LIVE_BLOCK,\n        alloc_site: CHECK_ALLOC_SITE,\n        free_site: 0 as *u8,\n    };\n    CHECK_COUNT += 1;\n    CHECK_CHANGES += 1;\n    if owner == 0 {\n        CHECK_LIVE += 1;\n    }\n    if CHECK_COUNT == CHECK_TRAP {\n        var m = check_msg();\n        m.text(\"check-alloc: \");\n        check_describe(&m, CHECK_COUNT - 1);\n        m.text(\" (VOLE_ALLOC_TRAP): SIGTRAP\");\n        m.out();\n        raise(5);\n    }\n    p\n}\n\n// Block b's pages given back, with no access, never used again.\nunsafe fn check_drop_block(b: i64, state: i64) {\n    let p = CHECK_BLOCKS[b].start as *u8;\n");
        buf_str(out, c"    let span = CHECK_BLOCKS[b].span as u64;\n    let flags = check_map_flags() | CHECK_MAP_FIXED;\n    if mmap(p, span, CHECK_PROT_NONE, flags, -1, 0) != p {\n        if CHECK_ALLOC_OS == 1 {\n            check_map_limit();\n        }\n        // (the pages keep their contents, but no access)\n        mprotect(p, span, CHECK_PROT_NONE);\n    }\n    if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n        CHECK_LIVE -= 1;\n    }\n    CHECK_BLOCKS[b].state = state;\n    CHECK_BLOCKS[b].free_site = CHECK_ALLOC_SITE;\n    CHECK_CHANGES += 1;\n}\n\n// The block whose pages hold address a; -1 when a is outside the\n// reservations, -2 when in one but in no block.\nunsafe fn check_find(a: u64) -> i64 {\n    for r in 0..CHECK_REGIONS {\n        if a >= CHECK_REGION_START[r] && a < CHECK_REGION_END[r] {\n            var lo = CHECK_REGION_FIRST[r];\n            var hi = if r + 1 < CHECK_REGIONS { CHECK_REGION_FIRST[r + 1] }\n                else { CHECK_COUNT };\n            // the last block starting at or before a\n            while lo < hi {\n                let mid = (lo + hi) / 2;\n                if CHECK_BLOCKS[mid].start <= a {\n                    lo = mid + 1;\n                } else {\n                    hi = mid;\n                }\n            }\n            let b = lo - 1;\n            if b >= CHECK_REGION_FIRST[r]\n                && a < CHECK_BLOCKS[b].start + CHECK_BLOCKS[b].span as u64 {\n                return b;\n            }\n            return -2;\n        }\n    }\n    -1\n}\n\n// The live block p of `size` bytes from allocator owner, being freed or\n// resized: its index, or the program stops.\nunsafe fn check_owned(p: *u8, size: i64, owner: u64, freeing: bool) -> i64 {\n    let b = check_find(p as u64);\n    var m = check_msg();\n    if b < 0 || CHECK_BLOCKS[b].start != p as u64 {\n        m.text(if freeing { \"invalid free at \" } else { \"invalid resize at \" });\n        m.site(CHECK_ALLOC_SITE);\n");
        buf_str(out, c"        m.text(\": \");\n        m.hex(p as u64);\n        if b >= 0 {\n            m.text(\" is \");\n            m.int((p as u64 - CHECK_BLOCKS[b].start) as i64);\n            m.text(\" bytes into \");\n            check_describe(&m, b);\n        } else {\n            m.text(if owner == 0 { \" is not a block of Gpa\" }\n                else { \" is not a block of the arena\" });\n        }\n        check_stop(&m);\n    }\n    if CHECK_BLOCKS[b].state != CHECK_LIVE_BLOCK {\n        m.text(if freeing { \"double free: \" } else { \"resize after free: \" });\n        check_describe(&m, b);\n        m.text(if freeing { \", freed again at \" } else { \", resized at \" });\n        m.site(CHECK_ALLOC_SITE);\n        check_stop(&m);\n    }\n    if CHECK_BLOCKS[b].owner != owner {\n        m.text(if freeing { \"invalid free at \" } else { \"invalid resize at \" });\n        m.site(CHECK_ALLOC_SITE);\n        m.text(\": \");\n        check_describe(&m, b);\n        m.text(if owner == 0 { \", given to Gpa\" } else { \", given to another allocator\" });\n        check_stop(&m);\n    }\n    if CHECK_BLOCKS[b].size != size {\n        m.text(if freeing { \"wrong-size free: \" } else { \"wrong-size resize: \" });\n        check_describe(&m, b);\n        m.text(if freeing { \", freed as \" } else { \", resized as \" });\n        m.int(size);\n        m.text(if size == 1 { \" byte at \" } else { \" bytes at \" });\n        m.site(CHECK_ALLOC_SITE);\n        check_stop(&m);\n    }\n    b\n}\n\n// p (old_size bytes from owner) moved to a new block of new_size bytes, or\n// null (p untouched).\nunsafe fn check_move(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n    if old_size == 0 {\n        return check_alloc_block(owner, new_size, align);\n    }\n    let b = check_owned(p, old_size, owner, false);\n    if new_size == 0 {\n        check_drop_block(b, CHECK_FREED);\n        return align as *u8;\n    }\n    let q = check_new_block(owner, new_size);\n");
        buf_str(out, c"    if q == 0 as *u8 {\n        return q;\n    }\n    memcpy(q, p, (if old_size < new_size { old_size } else { new_size }) as u64);\n    check_drop_block(b, CHECK_FREED);\n    q\n}\n\n// (Arenas, with --check-alloc) A block of size bytes on pages of its own\n// for the allocator whose state is at owner (0: Gpa), or null; size 0: an\n// aligned pointer, no block.\nfn check_alloc_block(owner: u64, size: i64, align: i64) -> *u8 {\n    if size == 0 {\n        return unsafe { align as *u8 };\n    }\n    unsafe { check_new_block(owner, size) }\n}\n\n// (Arenas) p, a block of owner of old_size bytes, moved to new_size bytes.\nunsafe fn check_alloc_moved(owner: u64, p: *u8, old_size: i64, new_size: i64, align: i64)\n    -> *u8 {\n    check_move(owner, p, old_size, new_size, align)\n}\n\n// (Arenas) The blocks allocated so far: a mark for check_alloc_release.\nfn check_alloc_mark() -> i64 {\n    CHECK_COUNT\n}\n\n// (Arenas: a reset, a scope's end) Every block of owner allocated after\n// mark is given back: a later access faults.\nfn check_alloc_release(owner: u64, mark: i64) {\n    unsafe {\n        for b in mark..CHECK_COUNT {\n            if CHECK_BLOCKS[b].owner == owner && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n                check_drop_block(b, CHECK_RELEASED);\n            }\n        }\n    }\n}\n\n// (Arenas) The site of the call being run, and that site set again: a\n// scope's end is reported at the scope's call, not at the last call in it.\nfn check_alloc_site() -> *u8 {\n    unsafe { CHECK_ALLOC_SITE }\n}\n\nfn check_alloc_set_site(site: *u8) {\n    unsafe {\n        CHECK_ALLOC_SITE = site;\n    }\n}\n\n// (Arenas) Whether p starts the last live block of owner: the block an\n// arena grows, or gives back, in place.\nfn check_alloc_is_last(owner: u64, p: *u8) -> bool {\n    unsafe {\n        for k in 0..CHECK_COUNT {\n            let b = CHECK_COUNT - 1 - k;\n            if CHECK_BLOCKS[b].owner == owner && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n");
        buf_str(out, c"                return CHECK_BLOCKS[b].start == p as u64;\n            }\n        }\n        false\n    }\n}\n\n// (--check-unsafe with --check-alloc) The access of size bytes at p:\n// false when p is no memory of the checking allocator, true when it is in\n// bounds of a live block; else the program stops.\npub unsafe fn check_alloc_access(p: u64, size: u64, site: *u8) -> bool {\n    let b = check_find(p);\n    if b == -1 {\n        return false;\n    }\n    var m = check_msg();\n    if b >= 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n        if p + size <= CHECK_BLOCKS[b].start + CHECK_BLOCKS[b].size as u64 {\n            return true;\n        }\n        m.text(\"unsafe access out of bounds: \");\n    } else if b >= 0 {\n        m.text(\"unsafe access after free: \");\n    } else {\n        m.text(\"unsafe access outside every block: \");\n    }\n    m.int(size as i64);\n    m.text(if size == 1 { \" byte at \" } else { \" bytes at \" });\n    if b >= 0 {\n        m.text(\"offset \");\n        m.int((p - CHECK_BLOCKS[b].start) as i64);\n        m.text(\" of \");\n        check_describe(&m, b);\n    } else {\n        m.hex(p);\n    }\n    m.text(\"\\n --> \");\n    m.site(site);\n    check_stop(&m)\n}\n\n// SIGSEGV, SIGBUS: an access to a freed block (or to the pages after the\n// last one) is reported; any other fault happens again with the default\n// action (SA_RESETHAND), as without --check-alloc.\nextern \"C\" fn check_alloc_fault(sig: i32, info: *u8, context: *u8) {\n    unsafe {\n        let a = *((info as u64 + check_si_addr()) as *u64);\n        let b = check_find(a);\n        if b == -1 {\n            return;\n        }\n        var m = check_msg();\n        if b >= 0 {\n            m.text(if CHECK_BLOCKS[b].state == CHECK_RELEASED { \"use after release: \" }\n                else { \"use after free: \" });\n            check_describe(&m, b);\n        } else {\n            m.text(\"access outside every block: \");\n            m.hex(a);\n");
        buf_str(out, c"            m.text(\" (memory the checking allocator never handed out)\");\n        }\n        check_stop(&m);\n    }\n}\n\n// The live blocks of Gpa, listed (at most 20).\nunsafe fn check_alloc_list_leaks() {\n    CHECK_LISTED = CHECK_CHANGES;\n    if CHECK_LIVE <= 0 {\n        return;\n    }\n    var m = check_msg();\n    var bytes = 0;\n    for b in 0..CHECK_COUNT {\n        if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n            bytes += CHECK_BLOCKS[b].size;\n        }\n    }\n    m.text(\"check-alloc: \");\n    m.int(CHECK_LIVE);\n    m.text(if CHECK_LIVE == 1 { \" block\" } else { \" blocks\" });\n    m.text(\" of Gpa not freed (\");\n    m.int(bytes);\n    m.text(\" bytes):\");\n    m.out();\n    var shown = 0;\n    for b in 0..CHECK_COUNT {\n        if CHECK_BLOCKS[b].owner == 0 && CHECK_BLOCKS[b].state == CHECK_LIVE_BLOCK {\n            if shown == 20 {\n                var more = check_msg();\n                more.text(\"  and \");\n                more.int(CHECK_LIVE - shown);\n                more.text(\" more\");\n                more.out();\n                return;\n            }\n            var line = check_msg();\n            line.text(\"  \");\n            check_describe(&line, b);\n            line.out();\n            shown += 1;\n        }\n    }\n}\n\n// At exit: the leaks, unless check_leaks listed them and nothing changed\n// since.\nextern \"C\" fn check_alloc_at_exit() {\n    unsafe {\n        if CHECK_LISTED != CHECK_CHANGES {\n            check_alloc_list_leaks();\n        }\n    }\n}\n\nimpl Allocator for Gpa {\n    fn try_alloc(self: *Gpa, size: i64, align: i64) -> *u8 {\n        check_alloc_block(0, size, align)\n    }\n\n    unsafe fn try_resize(self: *Gpa, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {\n        check_move(0, p, old_size, new_size, align)\n    }\n\n    unsafe fn free(self: *Gpa, p: *u8, size: i64, align: i64) {\n        if size == 0 && check_find(p as u64) == -1 {\n");
        buf_str(out, c"            return;\n        }\n        check_drop_block(check_owned(p, size, 0, true), CHECK_FREED);\n    }\n}\n");
    }
}

// (0.20) The end of std's text, after std::CHECK_ALLOC: the target's
// system, sys/linux.vl or sys/macos.vl (front/stdalloc.vl), the
// same length, std_sys_len bytes, so that one index holds for both.
pub fn std_sys_source(out: i64, linux: bool) {
    unsafe {
        if linux {
            buf_str(out, c"// ---- The target's system (0.20) ----\n\n// The end of std's text (front/stdalloc.vl, std_sys_source): what differs\n// between the targets' C libraries, for sys/unix.vl. sys/macos.vl has\n// the same items, in the same order, and the same length to the byte\n// (embed.sh checks it), so that std's index holds for every target; the\n// numbers are written as 8 hex digits for that.\n// (Linux's values, aarch64 glibc: <fcntl.h>, <errno.h>, <time.h>, ioctls\n// <asm/ioctls.h>, <signal.h>; errno: __errno_location().)\n\n// 0: macOS, 1: Linux.\npub const TARGET_OS: i64 = 0x00000001;\n\npub const SYS_O_CREAT: i32 = 0x00000040;\npub const SYS_O_TRUNC: i32 = 0x00000200;\npub const SYS_O_APPEND: i32 = 0x00000400;\npub const SYS_O_EXCL: i32 = 0x00000080;\npub const SYS_O_NONBLOCK: i32 = 0x00000800;\npub const SYS_O_CLOEXEC: i32 = 0x00080000;\npub const SYS_O_NOCTTY: i32 = 0x00000100;\npub const SYS_O_DIRECTORY: i32 = 0x00004000;\n\npub const SYS_EAGAIN: i32 = 0x0000000b;\npub const SYS_ENOTEMPTY: i32 = 0x00000027;\npub const SYS_ETIMEDOUT: i32 = 0x0000006e;\npub const SYS_ENOSYS: i32 = 0x00000026;\npub const SYS_ENOTSUP: i32 = 0x0000005f;\npub const SYS_ENAMETOOLONG: i32 = 0x00000024;\npub const SYS_ELOOP: i32 = 0x00000028;\n\npub const SYS_CLOCK_MONOTONIC: i32 = 0x00000001;\npub const SYS_PATH_MAX: i64 = 0x00001000;\npub const SYS_SIGCHLD: i32 = 0x00000011;\npub const SYS_TIOCSWINSZ: u64 = 0x00005414;\npub const SYS_TIOCGWINSZ: u64 = 0x00005413;\npub const SYS_TIOCSCTTY: u64 = 0x0000540e;\n\nextern \"C\" {\n    #[link_name = \"__errno_location\"]\n    #[effects(global)]\n    fn sys_errno_location() -> *i32;\n}\n\n// (0.21) Waiting on a 32-bit word (std::sync's locks): the futex system\n// call (98 on aarch64), FUTEX_WAIT_PRIVATE and FUTEX_WAKE_PRIVATE.\n// (x86-64's number is 202: x86-64 is compiled, not run, in 0.21.0.)\n//-----------------------------------------------------\npub const SYS_SC_NPROCESSORS_ONLN: i32 = 0x00000054;\n\nextern \"C\" {\n");
            buf_str(out, c"    #[link_name = \"syscall\"]\n    #[effects(sync)]\n    fn sys_c_futex(n: i64, addr: *u32, op: i64, val: i64, t: *u8, a: i64, b: i64) -> i64;\n}\n\n// Sleeps while *addr is `expected`, or until woken (spuriously too).\npub unsafe fn sys_futex_wait(addr: *u32, expected: u32) {\n    sys_c_futex(98, addr, 128, expected as i64, 0 as *u8, 0, 0);\n}\n\n// Wakes one thread sleeping on addr, or all.\npub unsafe fn sys_futex_wake(addr: *u32, all: bool) {\n    sys_c_futex(98, addr, 129, if all { 2147483647 } else { 1 }, 0 as *u8, 0, 0);\n}\n\n// (0.20) The program's arguments (std::env::args): argc, and argv, its C\n// strings. Linux: /proc/self/cmdline, read once (up to 128 KB and 4096\n// arguments) into std's statics, its NULs ending each argument.\nstatic var SYS_ARG_TEXT: [u8; 131072] = [0; 131072];\nstatic var SYS_ARG_PTRS: [*u8; 4097] = [0 as *u8; 4097];\nstatic var SYS_ARG_COUNT: i64 = -1;\n\npub fn sys_args() -> (i64, **u8) {\n    if SYS_ARG_COUNT < 0 {\n        SYS_ARG_COUNT = 0;\n        var len = 0;\n        match std::sys::sys_open(\"/proc/self/cmdline\", 0, 0) {\n            Ok(fd) => {\n                loop {\n                    let n = match std::sys::sys_read(fd, &SYS_ARG_TEXT[len..131071]) {\n                        Ok(n) => n,\n                        Err(_) => 0,\n                    };\n                    if n <= 0 {\n                        break;\n                    }\n                    len += n;\n                }\n                let _ = std::sys::sys_close(fd);\n            }\n            Err(_) => {}\n        }\n        var start = 0;\n        for i in 0..len {\n            if SYS_ARG_TEXT[i] == 0 && SYS_ARG_COUNT < 4096 {\n                SYS_ARG_PTRS[SYS_ARG_COUNT] = &SYS_ARG_TEXT[start] as *u8;\n                SYS_ARG_COUNT += 1;\n                start = i + 1;\n            }\n        }\n    }\n    (SYS_ARG_COUNT, &SYS_ARG_PTRS[0] as **u8)\n}\n// (padding: the two systems' files are the same length)---------------\n");
        } else {
            buf_str(out, c"// ---- The target's system (0.20) ----\n\n// The end of std's text (front/stdalloc.vl, std_sys_source): what differs\n// between the targets' C libraries, for sys/unix.vl. sys/linux.vl has\n// the same items, in the same order, and the same length to the byte\n// (embed.sh checks it), so that std's index holds for every target; the\n// numbers are written as 8 hex digits for that.\n// (macOS's values: <sys/fcntl.h>, <sys/errno.h>, <time.h>, <sys/ttycom.h>,\n// <sys/signal.h>; errno is the int that __error() points to, C.)\n\n// 0: macOS, 1: Linux.\npub const TARGET_OS: i64 = 0x00000000;\n\npub const SYS_O_CREAT: i32 = 0x00000200;\npub const SYS_O_TRUNC: i32 = 0x00000400;\npub const SYS_O_APPEND: i32 = 0x00000008;\npub const SYS_O_EXCL: i32 = 0x00000800;\npub const SYS_O_NONBLOCK: i32 = 0x00000004;\npub const SYS_O_CLOEXEC: i32 = 0x01000000;\npub const SYS_O_NOCTTY: i32 = 0x00020000;\npub const SYS_O_DIRECTORY: i32 = 0x00100000;\n\npub const SYS_EAGAIN: i32 = 0x00000023;\npub const SYS_ENOTEMPTY: i32 = 0x00000042;\npub const SYS_ETIMEDOUT: i32 = 0x0000003c;\npub const SYS_ENOSYS: i32 = 0x0000004e;\npub const SYS_ENOTSUP: i32 = 0x0000002d;\npub const SYS_ENAMETOOLONG: i32 = 0x0000003f;\npub const SYS_ELOOP: i32 = 0x0000003e;\n\npub const SYS_CLOCK_MONOTONIC: i32 = 0x00000006;\npub const SYS_PATH_MAX: i64 = 0x00000400;\npub const SYS_SIGCHLD: i32 = 0x00000014;\npub const SYS_TIOCSWINSZ: u64 = 0x80087467;\npub const SYS_TIOCGWINSZ: u64 = 0x40087468;\npub const SYS_TIOCSCTTY: u64 = 0x20007461;\n\nextern \"C\" {\n    #[link_name = \"__error\"]\n    #[effects(global)]\n    fn sys_errno_location() -> *i32;\n}\n\n// (0.21) Waiting on a 32-bit word (std::sync's locks): __ulock_wait with\n// UL_COMPARE_AND_WAIT | ULF_NO_ERRNO, __ulock_wake (ULF_WAKE_ALL for all).\npub const SYS_SC_NPROCESSORS_ONLN: i32 = 0x0000003a;\n\nextern \"C\" {\n    #[link_name = \"__ulock_wait\"]\n    #[effects(sync)]\n    fn sys_c_ulock_wait(op: u32, addr: *u8, value: u64, timeout_us: u32) -> i32;\n");
            buf_str(out, c"    #[link_name = \"__ulock_wake\"]\n    #[effects(sync)]\n    fn sys_c_ulock_wake(op: u32, addr: *u8, value: u64) -> i32;\n}\n\n// Sleeps while *addr is `expected`, or until woken (spuriously too).\npub unsafe fn sys_futex_wait(addr: *u32, expected: u32) {\n    sys_c_ulock_wait(0x01000001, addr as *u8, expected as u64, 0);\n}\n\n// Wakes one thread sleeping on addr, or all.\npub unsafe fn sys_futex_wake(addr: *u32, all: bool) {\n    sys_c_ulock_wake(if all { 0x01000101 } else { 0x01000001 }, addr as *u8, 0);\n}\n\n// (0.20) The program's arguments (std::env::args): argc, and argv, its C\n// strings. macOS: crt's own, which _NSGetArgc and _NSGetArgv point to.\npub fn sys_args() -> (i64, **u8) {\n    // (libSystem's pointers to crt's argc and argv, set before main)\n    unsafe { (*sys_argc_location() as i64, *sys_argv_location()) }\n}\n\nextern \"C\" {\n    #[link_name = \"_NSGetArgc\"]\n    #[effects(global)]\n    fn sys_argc_location() -> *i32;\n    #[link_name = \"_NSGetArgv\"]\n    #[effects(global)]\n    fn sys_argv_location() -> ***u8;\n}\n// (padding: the two systems' files are the same length)\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//----------------------------------------------------------------------------\n//--------------------------\n");
        }
    }
}

pub fn std_sys_len() -> i64 {
    3838
}

