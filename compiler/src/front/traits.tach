// Traits (0.9): bounded generics by monomorphization.
//
//   trait Hash { fn hash(self: *Self) -> u64; }
//   impl Hash for Point { fn hash(self: *Point) -> u64 { ... } }
//   impl<T: Hash> Hash for Vec<T> { ... }
//   fn f<T: Hash + Eq>(x: T) -> u64 { x.hash() }
//
// A trait declares functions, some with a default body. An impl block for
// a trait gives its functions to the type as methods (one namespace with
// the type's own methods); a function the impl leaves out is its trait's
// default, copied into the impl (and checked there). There is at most one
// impl per (trait, type): a generic impl covers every instance of its
// template whose arguments satisfy the impl's bounds.
//
// Bounds are checked when an instance is made: each type argument must
// implement each trait of its parameter's bounds. Generic code is still
// checked per instance (0.5); a method called on a value declared with a
// bounded parameter's type (`x: T`, `x: *T`) or as `T::f(...)` must be a
// function of one of the bounds. Unbounded parameters behave as in 0.5.
//
// The operator traits of std (Add, Sub, Mul, Div, Neg, Eq, Ord): `a + b`
// on a type implementing Add is `a.add(b)`, `-a` is `a.neg()`, `a == b`
// is `a.eq(&b)` (before 0.6's structural ==), `a < b` is `a.cmp(&b) < 0`.
// Builtin types implement them intrinsically (numbers: all of them;
// everything with ==: Eq; numbers, pointers and fieldless enums: Ord).
// There are no trait objects (`dyn`): dispatch is static.

use crate::base::{IntVec, buf_byte, buf_new, buf_slice, grow, intern, intern_c, sym_table};
use crate::base::diag::{
    ERR_HELP, err_begin, err_end, err_end_soft, err_help, err_help_sym, err_str, err_sym, fail_name,
};
use crate::front::assoc::{
    assoc_constraints_hold, collect_impl_assoc, collect_trait_assoc, constraint_error,
};
use crate::front::ast::{
    FN_LAZY, FN_SIG_FAILED, NODES, NodeKind, child, list_begin, list_end, list_push, new_node,
};
use crate::front::check::{
    CHECK_UNCHECKED, PROGRAM, SELF_TYPE, TRY_RESULT, Try, attempt, has_error_type, pop_scope,
    push_scope, resolve_type_or_error,
};
use crate::front::check::collect::{add_fn, slice_template, template_of_type_node};
use crate::front::check::equality::eq_unsupported;
use crate::front::check::resolve::{resolve_type, type_name_key};
use crate::front::check::synth_mode::synth_expr;
use crate::front::closures::fn_bounds::{fn_bound_error, fn_bound_satisfied};
use crate::front::convert::{
    bound_args, buf_bound, collect_trait_params, err_bound, impl_trait_args, implements_with,
    same_trait_args, trait_param_count,
};
use crate::front::generics::{
    CUR_INST, TPL_NONE, env_enter, env_leave, instance_of, instance_targs, mangle_type,
};
use crate::front::generics::instantiate::clone_node;
use crate::front::lexer::{SUF_NONE, Tok};
use crate::front::modules::{CUR_MOD, STD_MODULE, module_of, qualify};
use crate::front::patterns::check_pattern;
use crate::front::types::{
    FNS, FN_COUNT, TLISTS, TSCRATCH, TYPES, TY_BOOL, TY_ERROR, TY_NEVER, TY_UNIT, TyKind, err_type,
    fn_param, is_fieldless_enum, is_numeric, is_pointer, make_type,
};

// (0.15: params, the Generics node of a generic trait's type parameters,
// 0 for none: convert::collect_trait_params)
pub struct TraitInfo { name: i64, node: i64, module: i64, params: i64 }
// An impl of trait `tr` for type `ty`, or (generic) for the instances of
// template `tpl` (generics.tach's encoding). (0.15: targs, the arguments
// of a generic trait, `impl From<i64> for T`: a TLISTS index, as many as
// the trait's parameters; convert::impl_trait_args.)
pub struct ImplInfo { node: i64, tr: i64, ty: i64, tpl: i64, module: i64, targs: i64 }

pub static mut TRAITS: *TraitInfo = 0 as *TraitInfo;
pub static mut TRAIT_COUNT: i64 = 0;
static mut TRAIT_CAP: i64 = 0;
pub static mut IMPLS: *ImplInfo = 0 as *ImplInfo;
pub static mut IMPL_COUNT: i64 = 0;
static mut IMPL_CAP: i64 = 0;
// Per key: trait + 1.
pub static mut SYM_TRAIT: *i64 = 0 as *i64;
// Per function: the impl it belongs to + 1 (0: none).
static mut FN_IMPL: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

pub fn init_traits() {
    sym_table(&SYM_TRAIT);
}

pub fn add_trait(item: i64, key: i64, m: i64) {
    unsafe {
        TRAITS = grow(TRAITS, TRAIT_COUNT, &TRAIT_CAP);
        TRAITS[TRAIT_COUNT] = TraitInfo { name: NODES[item].a, node: item, module: m, params: 0 };
        TRAIT_COUNT += 1;
        SYM_TRAIT[key] = TRAIT_COUNT;
        collect_trait_assoc(TRAIT_COUNT - 1);
        // (0.15: `trait From<T>`)
        collect_trait_params(TRAIT_COUNT - 1);
    }
}

fn set_fn_impl(f: i64, i: i64) {
    while FN_IMPL.count <= f {
        FN_IMPL.push(0);
    }
    unsafe { FN_IMPL.data[f] = i + 1; }
}

// The impl function f belongs to, or -1.
pub fn impl_of_fn(f: i64) -> i64 {
    if f < FN_IMPL.count { unsafe { FN_IMPL.data[f] - 1 } } else { -1 }
}

// The item node of the trait of the impl function f belongs to, or 0
// (tachyonc query, 0.11).
pub fn impl_trait_node(f: i64) -> i64 {
    let i = impl_of_fn(f);
    if i < 0 {
        return 0;
    }
    unsafe {
        let tr = IMPLS[i].tr;
        if tr < 0 { 0 } else { TRAITS[tr].node }
    }
}

// The trait named by type node n (in module CUR_MOD). (0.15: its type
// arguments, `From<i64>`, are the caller's: impl_trait_args, bound_args.)
pub fn trait_named(n: i64) -> i64 {
    unsafe {
        let key = if NODES[n].kind == NodeKind::TyName { type_name_key(n) } else { -1 };
        if key < 0 || SYM_TRAIT[key] == 0 {
            err_begin(NODES[n].start);
            err_str(c"'");
            err_sym(NODES[n].a);
            if key < 0 {
                err_str(c"' is not a trait in scope");
            } else {
                err_str(c"' is not a trait");
            }
            err_end();
        }
        SYM_TRAIT[key] - 1
    }
}

// The trait of bound node b (a TyName in a parameter's bounds), resolved
// in its own module once; -1 when it names none (0.10: an error recorded,
// and the bound holds for every type; 0.14: or it is an `Fn` bound).
pub fn bound_trait(b: i64) -> i64 {
    unsafe {
        // (0.14: `Fn(A) -> R` names no trait: fn_bound_satisfied)
        if NODES[b].kind == NodeKind::TyFn {
            return -1;
        }
        if NODES[b].x == 0 {
            let saved = CUR_MOD;
            CUR_MOD = module_of(b);
            NODES[b].x = if attempt(Try::Bound, b) { TRY_RESULT + 1 } else { -1 };
            CUR_MOD = saved;
        }
        if NODES[b].x < 0 { -1 } else { NODES[b].x - 1 }
    }
}

// The function of trait tr named `name` (a Fn node), or 0.
pub fn trait_fn(tr: i64, name: i64) -> i64 {
    if tr < 0 {
        return 0;
    }
    unsafe {
        let node = TRAITS[tr].node;
        for i in 0..NODES[node].count {
            if NODES[child(node, i)].a == name {
                return child(node, i);
            }
        }
        0
    }
}

pub fn trait_declares(tr: i64, name: i64) -> bool {
    tr < 0 || trait_fn(tr, name) != 0
}

// `impl<A> Tr for T<A>`: the impl's parameters, then f's own.
fn merged_generics(outer: i64, own: i64) -> i64 {
    unsafe {
        let n = new_node(NodeKind::Generics, NODES[outer].start, NODES[outer].end);
        let mark = list_begin();
        for i in 0..NODES[outer].count {
            list_push(child(outer, i));
        }
        if own != 0 {
            for i in 0..NODES[own].count {
                list_push(child(own, i));
            }
        }
        list_end(n, mark);
        NODES[n].a = NODES[outer].count;
        n
    }
}

fn impl_is_generic(node: i64) -> bool {
    unsafe { NODES[node].g != 0 && NODES[NODES[node].g].count > 0 }
}

fn impl_type_error(node: i64, before: *u8, tr: i64, after: *u8) {
    unsafe {
        err_begin(NODES[node].start);
        err_str(before);
        err_sym(TRAITS[tr].name);
        err_str(c"' for '");
        let i = IMPL_COUNT - 1;
        if IMPLS[i].ty != 0 {
            err_type(IMPLS[i].ty);
        } else {
            err_sym(NODES[NODES[node].b].a);
        }
        err_str(c"'");
        err_str(after);
        err_end_soft();
    }
}

// The impl blocks of traits (a phase of the declarations, before the
// methods): their traits and types, coherence, and the default functions
// they leave out, copied into them.
pub fn collect_impls() {
    unsafe {
        // The bounds of every generic item name traits.
        for k in 0..NODES[PROGRAM].count {
            let item = child(PROGRAM, k);
            let kind = NODES[item].kind;
            let g = NODES[item].g;
            if g == 0
                || (kind != NodeKind::Fn && kind != NodeKind::Struct && kind != NodeKind::Enum) {
                continue;
            }
            for i in 0..NODES[g].count {
                let bounds = NODES[child(g, i)].h;
                if bounds != 0 {
                    for j in 0..NODES[bounds].count {
                        bound_trait(child(bounds, j));
                    }
                }
            }
        }
        IMPL_EXTRA.count = 0;
        for k in 0..NODES[PROGRAM].count {
            let node = child(PROGRAM, k);
            if NODES[node].kind != NodeKind::Impl {
                continue;
            }
            if !attempt(Try::Impl, node) {
                // (its trait or type is unknown: its functions are left out)
                for i in 0..NODES[node].count {
                    let f = child(node, i);
                    NODES[f].p |= FN_SIG_FAILED;
                    fail_name(NODES[f].a);
                }
            }
        }
        CUR_MOD = 0;
        if IMPL_EXTRA.count > 0 {
            let mark = list_begin();
            for i in 0..NODES[PROGRAM].count {
                list_push(child(PROGRAM, i));
            }
            for i in 0..IMPL_EXTRA.count {
                list_push(IMPL_EXTRA.data[i]);
            }
            list_end(PROGRAM, mark);
        }
    }
}

// The trait's functions impls leave out, copied into them.
static mut IMPL_EXTRA: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Impl block `node`.
pub fn collect_impl(node: i64) {
    unsafe {
        let m = module_of(node);
        CUR_MOD = m;
        let tr = trait_named(NODES[node].a);
        let mut ty = 0;
        let mut tpl = TPL_NONE;
        if impl_is_generic(node) {
            tpl = template_of_type_node(NODES[node].b);
            // (0.14: `impl<T> Tr for [T]`)
            if tpl == TPL_NONE {
                tpl = slice_template(NODES[node].b, NODES[node].g);
            }
            if tpl == TPL_NONE {
                err_begin(NODES[NODES[node].b].start);
                err_str(c"a generic impl is for a generic struct or enum, with the impl's parameters as its arguments: 'impl<T> Hash for Vec<T>'");
                err_end();
            }
        } else {
            ty = resolve_type(NODES[node].b);
        }
        IMPLS = grow(IMPLS, IMPL_COUNT, &IMPL_CAP);
        IMPLS[IMPL_COUNT] = ImplInfo { node: node, tr: tr, ty: ty, tpl: tpl, module: m, targs: 0 };
        IMPL_COUNT += 1;
        let me = IMPL_COUNT - 1;
        // (0.15: `impl From<i64> for T`)
        impl_trait_args(me);
        // Coherence: one impl per (trait, type) (0.15: per trait arguments
        // too, `From<i64>` and `From<[u8]>`).
        for j in 0..me {
            if IMPLS[j].tr != tr {
                continue;
            }
            let same = (ty != 0 && IMPLS[j].ty == ty) || (tpl != TPL_NONE && IMPLS[j].tpl == tpl)
                || (ty != 0 && IMPLS[j].tpl != TPL_NONE && instance_of(ty, IMPLS[j].tpl))
                || (tpl != TPL_NONE && IMPLS[j].ty != 0 && instance_of(IMPLS[j].ty, tpl));
            if same && same_trait_args(j, me) {
                impl_type_error(node, c"conflicting impls of trait '", tr,
                    c" (one impl per trait and type)");
                // (its functions are left out: the first impl's are the
                // type's)
                for i in 0..NODES[node].count {
                    NODES[child(node, i)].p |= FN_SIG_FAILED;
                }
                return;
            }
        }
        collect_impl_assoc(me);
        // Its functions: each one of the trait's.
        for i in 0..NODES[node].count {
            let f = child(node, i);
            set_fn_impl(NODES[f].x - 1, me);
            if trait_fn(tr, NODES[f].a) == 0 {
                err_begin(NODES[f].start);
                err_str(c"'");
                err_sym(NODES[f].a);
                err_str(c"' is not a function of trait '");
                err_sym(TRAITS[tr].name);
                err_str(c"'");
                err_end_soft();
            }
        }
        // The trait's functions it leaves out: their defaults.
        let tnode = TRAITS[tr].node;
        for i in 0..NODES[tnode].count {
            let decl = child(tnode, i);
            let mut found = false;
            for j in 0..NODES[node].count {
                if NODES[child(node, j)].a == NODES[decl].a {
                    found = true;
                }
            }
            // (0.15: a generic trait's function without a body was
            // reported by collect_trait_params)
            if found || trait_param_count(tr) != 0 && NODES[decl].c != 0 {
                continue;
            }
            if NODES[decl].c == 0 {
                err_begin(NODES[node].start);
                err_str(c"the impl of trait '");
                err_sym(TRAITS[tr].name);
                err_str(c"' is missing '");
                err_sym(NODES[decl].a);
                err_str(c"'");
                err_help(c"it has no default: write it in the impl");
                err_end_soft();
                continue;
            }
            let f = clone_node(decl);
            NODES[f].d = if NODES[NODES[node].b].kind == NodeKind::TyName { NODES[NODES[node].b].a }
                else { intern_c(c"_") };
            NODES[f].h = NODES[node].b;
            if impl_is_generic(node) {
                NODES[f].g = merged_generics(NODES[node].g, NODES[f].g);
            }
            NODES[f].p |= 1;
            // (0.14: checked only when used, ensure_checked; `sum` is no
            // error for an iterator of slices that never sums)
            if NODES[f].g == 0 {
                NODES[f].p |= FN_LAZY;
            }
            add_fn(f, NODES[f].a, NODES[f].a);
            // (checked in the trait's module, where it is written; 0.13:
            // the impl's, which does not see the names a std default uses)
            FNS[FN_COUNT - 1].module = TRAITS[tr].module;
            set_fn_impl(FN_COUNT - 1, me);
            IMPL_EXTRA.push(f);
        }
    }
}

// After the signatures are resolved: each function of a (non-generic)
// impl has its trait's signature, with Self the impl's type.
pub fn check_impl_signatures() {
    unsafe {
        for f in 0..FN_COUNT {
            let i = impl_of_fn(f);
            if i < 0 || FNS[f].generic > 0 || FNS[f].tmpl != 0
                || (NODES[FNS[f].node].p & FN_SIG_FAILED) != 0 {
                continue;
            }
            let tr = IMPLS[i].tr;
            let decl = trait_fn(tr, NODES[FNS[f].node].a);
            if decl == 0 || NODES[decl].g != 0 {
                continue;
            }
            let saved_mod = CUR_MOD;
            let saved_self = SELF_TYPE;
            CUR_MOD = TRAITS[tr].module;
            SELF_TYPE = FNS[f].self_ty;
            // (0.15: a generic trait's parameters are the impl's arguments)
            let count = trait_param_count(tr);
            if count != 0 && IMPLS[i].targs < 0 {
                CUR_MOD = saved_mod;
                SELF_TYPE = saved_self;
                continue;
            }
            let saved_env = if count != 0 { env_enter(TRAITS[tr].params, IMPLS[i].targs, count) }
                else { 0 };
            let mark = TSCRATCH.count;
            for k in 0..NODES[decl].count {
                TSCRATCH.push(resolve_type_or_error(NODES[child(decl, k)].b));
            }
            let ret = if NODES[decl].b == 0 { TY_UNIT }
                else { resolve_type_or_error(NODES[decl].b) };
            if count != 0 {
                env_leave(saved_env);
            }
            CUR_MOD = saved_mod;
            SELF_TYPE = saved_self;
            let count = TSCRATCH.count - mark;
            let mut same = count == FNS[f].param_count && ret == FNS[f].ret
                && ((NODES[decl].p & 64) == (NODES[FNS[f].node].p & 64));
            if same {
                for k in 0..count {
                    if TSCRATCH.data[mark + k] != fn_param(f, k) {
                        same = false;
                    }
                }
            }
            // (a type that failed, in either, follows from an earlier error)
            let mut failed = has_error_type(ret) || has_error_type(FNS[f].ret);
            for k in 0..count {
                if has_error_type(TSCRATCH.data[mark + k]) {
                    failed = true;
                }
            }
            for k in 0..FNS[f].param_count {
                if has_error_type(fn_param(f, k)) {
                    failed = true;
                }
            }
            if !same && !failed {
                // (what differs is the error type from now on: the uses of
                // the function report nothing more about it)
                if ret != FNS[f].ret {
                    FNS[f].ret = TY_ERROR;
                }
                for k in 0..FNS[f].param_count {
                    if k >= count || TSCRATCH.data[mark + k] != fn_param(f, k) {
                        TLISTS.data[FNS[f].params + k] = TY_ERROR;
                    }
                }
                let expected = make_type(TyKind::Fn, ret, 0, mark);
                err_begin(NODES[FNS[f].node].start);
                err_str(c"'");
                err_sym(NODES[FNS[f].node].a);
                err_str(c"' does not have the signature trait '");
                err_sym(TRAITS[tr].name);
                err_str(c"' declares: expected '");
                if (NODES[decl].p & 64) != 0 {
                    err_str(c"unsafe ");
                }
                err_type(expected);
                err_str(c"'");
                err_end_soft();
            }
            TSCRATCH.count = mark;
        }
    }
}

// ---- Whether a type implements a trait ----

// std's trait `name`, or -1 (std not loaded, or no such trait).
pub fn std_trait(name: *u8) -> i64 {
    unsafe {
        if STD_MODULE < 0 {
            return -1;
        }
        let key = qualify(STD_MODULE, intern_c(name));
        if SYM_TRAIT[key] == 0 { -1 } else { SYM_TRAIT[key] - 1 }
    }
}

// Whether t implements tr through an impl block.
pub fn has_impl(tr: i64, t: i64) -> bool {
    unsafe {
        for i in 0..IMPL_COUNT {
            if IMPLS[i].tr != tr {
                continue;
            }
            if IMPLS[i].ty != 0 && IMPLS[i].ty == t {
                return true;
            }
            if IMPLS[i].tpl != TPL_NONE && instance_of(t, IMPLS[i].tpl) {
                // ... when its arguments satisfy the impl's bounds.
                let params = NODES[IMPLS[i].node].g;
                let targs = instance_targs(t);
                // (0.14: the parameters bound, for the constraints)
                let saved = env_enter(params, targs, NODES[params].count);
                let mut ok = true;
                for k in 0..NODES[params].count {
                    if !satisfies(child(params, k), TLISTS.data[targs + k]) {
                        ok = false;
                    }
                }
                env_leave(saved);
                return ok;
            }
        }
        false
    }
}

// The operator traits builtin types implement without an impl block.
fn intrinsic(tr: i64, t: i64) -> bool {
    unsafe {
        if tr == std_trait(c"Add") || tr == std_trait(c"Sub") || tr == std_trait(c"Mul")
            || tr == std_trait(c"Div") || tr == std_trait(c"Neg") {
            return is_numeric(t);
        }
        if tr == std_trait(c"Eq") {
            return eq_unsupported(t) == 0;
        }
        if tr == std_trait(c"Ord") {
            return is_numeric(t) || is_pointer(t) || is_fieldless_enum(t);
        }
        false
    }
}

pub fn implements(tr: i64, t: i64) -> bool {
    tr < 0 || has_error_type(t) || t == TY_NEVER || has_impl(tr, t) || intrinsic(tr, t)
}

// Whether type t satisfies the bounds of parameter node p.
pub fn satisfies(p: i64, t: i64) -> bool {
    unsafe {
        let bounds = NODES[p].h;
        if bounds == 0 {
            return true;
        }
        for i in 0..NODES[bounds].count {
            let b = child(bounds, i);
            // (0.15: `From<U>`, a generic trait's bound)
            if NODES[b].g != 0 && !implements_with(bound_trait(b), t, bound_args(b))
                || NODES[b].g == 0 && !implements(bound_trait(b), t) {
                return false;
            }
            // (0.14: `Fn(A) -> R`, and constraints `Iterator<Item = A>`)
            if NODES[b].kind == NodeKind::TyFn && !fn_bound_satisfied(b, t)
                || NODES[b].h != 0 && !assoc_constraints_hold(b, t) {
                return false;
            }
        }
        true
    }
}

// The instances made by the declarations (a struct field
// `HashMap<i64, i64>`, an enum payload, an impl's type) are made before
// every impl is known: their bounds wait in BOUNDS_LATER (params, targs,
// count, what, pos) until the declarations are collected
// (check_later_bounds, their last phase).
static mut IMPLS_KNOWN: bool = false;
static mut BOUNDS_LATER: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The bounds the declarations met, now that every impl is known.
pub fn check_later_bounds() {
    unsafe {
        IMPLS_KNOWN = true;
        let mut i = 0;
        while i < BOUNDS_LATER.count {
            let d = BOUNDS_LATER.data;
            check_bounds(d[i], d[i + 1], d[i + 2], d[i + 3], d[i + 4]);
            i += 5;
        }
        BOUNDS_LATER.count = 0;
    }
}

// The type arguments TLISTS[targs..] of generic item `what` (its name),
// with parameters `params`, satisfy their bounds; an error at pos if not.
pub fn check_bounds(params: i64, targs: i64, count: i64, what: i64, pos: i64) {
    unsafe {
        if params == 0 {
            return;
        }
        if !IMPLS_KNOWN {
            BOUNDS_LATER.push(params);
            BOUNDS_LATER.push(targs);
            BOUNDS_LATER.push(count);
            BOUNDS_LATER.push(what);
            BOUNDS_LATER.push(pos);
            return;
        }
        // (0.14: the parameters bound, for the constraints, `Item = T`)
        let saved = env_enter(params, targs, count);
        for k in 0..count {
            let p = child(params, k);
            let bounds = NODES[p].h;
            if bounds == 0 {
                continue;
            }
            let t = TLISTS.data[targs + k];
            if t == TY_ERROR && CHECK_UNCHECKED {
                continue;
            }
            for i in 0..NODES[bounds].count {
                let b = child(bounds, i);
                // (0.14: constraints `Iterator<Item = A>`)
                if NODES[b].h != 0 && !assoc_constraints_hold(b, t) {
                    constraint_error(b, t, NODES[p].a, what, pos);
                }
                // (0.14: `Fn(A) -> R`, its types with the parameters bound
                // to the arguments)
                if NODES[b].kind == NodeKind::TyFn {
                    let saved = env_enter(params, targs, count);
                    let ok = fn_bound_satisfied(b, t);
                    env_leave(saved);
                    if !ok {
                        fn_bound_error(b, t, NODES[p].a, what, pos);
                    }
                }
                let tr = bound_trait(b);
                // (0.15: `From<U>`, a generic trait's bound)
                let bargs = if NODES[b].g != 0 { bound_args(b) } else { -1 };
                let holds = if bargs >= 0 { implements_with(tr, t, bargs) }
                    else { implements(tr, t) };
                if !holds {
                    err_begin(pos);
                    err_str(c"the trait '");
                    if bargs >= 0 {
                        err_bound(tr, bargs);
                    } else {
                        err_sym(TRAITS[tr].name);
                    }
                    err_str(c"' is not implemented for '");
                    err_type(t);
                    err_str(c"'");
                    err_help(c"required by the bound '");
                    err_help_sym(NODES[p].a);
                    err_help(c": ");
                    if bargs >= 0 {
                        buf_bound(ERR_HELP, tr, bargs);
                    } else {
                        err_help_sym(TRAITS[tr].name);
                    }
                    err_help(c"' of '");
                    err_help_sym(what);
                    err_help(c"'");
                    err_end();
                }
            }
        }
        env_leave(saved);
    }
}

// ---- Bounded parameters in generic code ----

// The parameter node of the instance being checked named `name`, when
// it has bounds; 0 otherwise.
pub fn bounded_param(name: i64) -> i64 {
    unsafe {
        if CUR_INST < 0 || FNS[CUR_INST].tmpl == 0 {
            return 0;
        }
        let g = NODES[FNS[FNS[CUR_INST].tmpl - 1].node].g;
        if g == 0 {
            return 0;
        }
        for i in 0..NODES[g].count {
            let p = child(g, i);
            if NODES[p].a == name {
                return if NODES[p].h != 0 { p } else { 0 };
            }
        }
        0
    }
}

// The bounded parameter a declared type (a parameter's type node) names,
// itself or through a pointer, or 0.
pub fn bounded_param_of_type(n: i64) -> i64 {
    unsafe {
        let mut t = n;
        if t != 0 && NODES[t].kind == NodeKind::TyPtr {
            t = NODES[t].a;
        }
        if t == 0 || NODES[t].kind != NodeKind::TyName || NODES[t].g != 0 || NODES[t].count != 0 {
            return 0;
        }
        bounded_param(NODES[t].a)
    }
}

// Function `name`, used through bounded parameter p, must be one of its
// bounds'.
pub fn require_in_bounds(p: i64, name: i64, pos: i64) {
    unsafe {
        let bounds = NODES[p].h;
        for i in 0..NODES[bounds].count {
            if trait_declares(bound_trait(child(bounds, i)), name) {
                return;
            }
        }
        err_begin(pos);
        err_str(c"no function '");
        err_sym(name);
        err_str(c"' in the bounds of '");
        err_sym(NODES[p].a);
        err_str(c"'");
        for tr in 0..TRAIT_COUNT {
            if trait_declares(tr, name) {
                err_help(c"add the bound: '");
                err_help_sym(NODES[p].a);
                err_help(c": ");
                err_help_sym(TRAITS[tr].name);
                err_help(c"'");
                break;
            }
        }
        err_end();
    }
}

// ---- Operators ----

fn op_ident(name: i64, pos: i64) -> i64 {
    let n = new_node(NodeKind::Ident, pos, pos);
    unsafe { NODES[n].a = name; }
    n
}

fn op_let(name: i64, init: i64, pos: i64) -> i64 {
    unsafe {
        let p = new_node(NodeKind::PatBind, pos, pos);
        NODES[p].a = name;
        let n = new_node(NodeKind::Let, pos, pos);
        NODES[n].a = p;
        NODES[n].c = init;
        n
    }
}

fn op_method(receiver: i64, name: *u8, arg: i64, pos: i64) -> i64 {
    let n = new_node(NodeKind::MethodCall, pos, pos);
    unsafe {
        NODES[n].a = receiver;
        NODES[n].b = intern_c(name);
    }
    let mark = list_begin();
    if arg != 0 {
        list_push(arg);
    }
    list_end(n, mark);
    n
}

// The trait of binary operator op on values of type t, when t implements
// it through an impl block (-1 otherwise).
pub fn binary_op_trait(op: Tok, t: i64) -> i64 {
    unsafe {
        // (the builtin scalars keep their operators)
        if is_numeric(t) || t == TY_BOOL || is_pointer(t) || TYPES[t].kind == TyKind::Fn
            || t == TY_NEVER || t == TY_ERROR {
            return -1;
        }
        let tr = if op == Tok::Plus {
            std_trait(c"Add")
        } else if op == Tok::Minus {
            std_trait(c"Sub")
        } else if op == Tok::Star {
            std_trait(c"Mul")
        } else if op == Tok::Slash {
            std_trait(c"Div")
        } else if op == Tok::EqEq || op == Tok::BangEq {
            std_trait(c"Eq")
        } else if op == Tok::Lt || op == Tok::Gt || op == Tok::LtEq || op == Tok::GtEq {
            std_trait(c"Ord")
        } else {
            -1
        };
        if tr >= 0 && has_impl(tr, t) { tr } else { -1 }
    }
}

// Rewrites binary node n (its operands checked, of type t) into a call of
// its trait's function:
//     { let ==l = a; let ==r = b; ==l.add(==r) }      (+ - * /)
//     { let ==l = a; let ==r = b; ==l.eq(&==r) }      (==; != negates)
//     { let ==l = a; let ==r = b; ==l.cmp(&==r) < 0 } (< > <= >=)
// and returns its type.
pub fn operator_call(n: i64, t: i64) -> i64 {
    unsafe {
        let op = NODES[n].op;
        let pos = NODES[n].start;
        let l = intern_c(c"==l");
        let r = intern_c(c"==r");
        let block = new_node(NodeKind::Block, NODES[n].start, NODES[n].end);
        let mark = list_begin();
        let let_l = op_let(l, NODES[n].b, pos);
        let let_r = op_let(r, NODES[n].c, pos);
        list_push(let_l);
        list_push(let_r);
        list_end(block, mark);
        let mut tail = 0;
        if op == Tok::EqEq || op == Tok::BangEq || op == Tok::Lt || op == Tok::Gt || op == Tok::LtEq
            || op == Tok::GtEq {
            let addr = new_node(NodeKind::Unary, pos, pos);
            NODES[addr].op = Tok::Amp;
            NODES[addr].b = op_ident(r, pos);
            if op == Tok::EqEq || op == Tok::BangEq {
                tail = op_method(op_ident(l, pos), c"eq", addr, pos);
                if op == Tok::BangEq {
                    let not = new_node(NodeKind::Unary, pos, pos);
                    NODES[not].op = Tok::Bang;
                    NODES[not].b = tail;
                    tail = not;
                }
            } else {
                let zero = new_node(NodeKind::Int, pos, pos);
                NODES[zero].b = SUF_NONE;
                let cmp = new_node(NodeKind::Binary, pos, pos);
                NODES[cmp].op = op;
                NODES[cmp].b = op_method(op_ident(l, pos), c"cmp", addr, pos);
                NODES[cmp].c = zero;
                tail = cmp;
            }
        } else {
            let name = if op == Tok::Plus { c"add" } else if op == Tok::Minus { c"sub" }
                else if op == Tok::Star { c"mul" } else { c"div" };
            tail = op_method(op_ident(l, pos), name, op_ident(r, pos), pos);
        }
        NODES[block].a = tail;
        // The operands are checked already: only their bindings are made.
        push_scope();
        check_pattern(NODES[let_l].a, t);
        check_pattern(NODES[let_r].a, NODES[NODES[n].c].ty);
        let ty = synth_expr(tail);
        pop_scope();
        NODES[n] = NODES[block];
        NODES[n].ty = ty;
        ty
    }
}

// `-a` on a type implementing std's Neg through an impl block: `{ let
// ==l = a; ==l.neg() }` (its operand checked, of type t).
pub fn negation_call(n: i64, t: i64) -> i64 {
    unsafe {
        let pos = NODES[n].start;
        let l = intern_c(c"==l");
        let block = new_node(NodeKind::Block, NODES[n].start, NODES[n].end);
        let mark = list_begin();
        let let_l = op_let(l, NODES[n].b, pos);
        list_push(let_l);
        list_end(block, mark);
        let tail = op_method(op_ident(l, pos), c"neg", 0, pos);
        NODES[block].a = tail;
        push_scope();
        check_pattern(NODES[let_l].a, t);
        let ty = synth_expr(tail);
        pop_scope();
        NODES[n] = NODES[block];
        NODES[n].ty = ty;
        ty
    }
}

// The symbol part of a type without one (impls for builtin types):
// `T` and its code (generics.tach).
pub fn builtin_type_symbol(t: i64) -> i64 {
    let out = buf_new();
    buf_byte(out, 'T');
    mangle_type(out, t);
    intern(buf_slice(out))
}
