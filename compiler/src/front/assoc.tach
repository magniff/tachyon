// Associated types (0.14; docs/design/closures-iterators.md), restricted:
// `type Item;` in a trait, `type Item = T;` in its impls, the projection
// `X::Item` when X is concrete (always so in an instance) or `Self`, the
// built-in `F::Output` of a closure or fn type, and the constraints of a
// bound, `I: Iterator<Item = T>`, checked when an instance is made and
// used to infer T. Also lazy defaults: a trait default copied into a
// non-generic impl (FN_LAZY) is checked only when first used.
//
// Phase 0: the interface, with stubs (the checking is the associated
// types task's).

use crate::front::ast::{NODES, NodeKind, child};
use crate::front::check::{SELF_TYPE, SELF_TYPE_SYM};
use crate::front::closures::unimplemented;
use crate::front::generics::env_lookup;
use crate::front::traits::IMPLS;

// The associated types trait `tr` (a TRAITS index) declares: its node's
// `b` (a holder of AssocType nodes, 0: none).
pub fn collect_trait_assoc(tr: i64) {}

// The associated types impl `i` (an IMPLS index) defines: its node's `c`
// (a holder of AssocType nodes, 0: none); each name its trait declares
// must be defined.
pub fn collect_impl_assoc(i: i64) {
    unsafe {
        let holder = NODES[IMPLS[i].node].c;
        if holder != 0 {
            unimplemented(NODES[child(holder, 0)].start, c"associated types");
        }
    }
}

// The type `t::name` (an error at pos when there is none, or two traits
// of t define it).
pub fn projection(t: i64, name: i64, pos: i64) -> i64 {
    unsafe { unimplemented(pos, c"associated types") }
}

// The type projection node n (a TyName, is_projection_node) stands for.
pub fn resolve_projection_node(n: i64) -> i64 {
    unsafe { unimplemented(NODES[n].start, c"associated types") }
}

// Whether type node n is a projection, `T::Item` or `Self::Item` (not a
// type in a module, `a::T`).
pub fn is_projection_node(n: i64) -> bool {
    unsafe {
        if NODES[n].kind != NodeKind::TyName || NODES[n].count != 1 || NODES[n].g != 0 {
            return false;
        }
        let first = NODES[child(n, 0)].a;
        (first == SELF_TYPE_SYM && SELF_TYPE != 0) || env_lookup(first) != 0
    }
}

// Whether type t meets the constraints of bound node `bound` (a TyName
// whose `h` holds AssocType nodes, `Item = T`).
pub fn assoc_constraints_hold(bound: i64, t: i64) -> bool {
    unsafe { unimplemented(NODES[bound].start, c"associated type constraints") }
}

// After the arguments (infer_from's last pass): the parameters the
// constraints of parameter k's bounds name, bound from bound[k]'s
// associated types.
pub fn infer_from_assoc(params: i64, bound: *i64, tmod: i64, k: i64) {}

// Function f (a FNS index) is used: if it is a lazy default (FN_LAZY),
// it is checked now (and FN_LAZY cleared; finish_program drops the ones
// still lazy).
pub fn ensure_checked(f: i64) {}
