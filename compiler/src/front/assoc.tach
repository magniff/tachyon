// Associated types (0.14; docs/design/closures-iterators.md), restricted:
// `type Item;` in a trait, `type Item = T;` in its impls, the projection
// `X::Item` when X is concrete (always so in an instance) or `Self`, the
// built-in `F::Output` of a closure or fn type, and the constraints of a
// bound, `I: Iterator<Item = T>`, checked when an instance is made and
// used to infer T. Also lazy defaults: a trait default copied into a
// non-generic impl (FN_LAZY) is checked only when first used.
//
// An impl's definitions are resolved when a projection asks for them (in
// the impl's module, `Self` the type, a generic impl's parameters bound to
// the type's arguments); those of a non-generic impl once (cached in the
// AssocType node's `ty`).

use crate::base::{IntVec, intern_c};
use crate::base::diag::{err_begin, err_end, err_end_soft, err_help, err_help_sym, err_str, err_sym};
use crate::front::ast::{FN_LAZY, NODES, NodeKind, child};
use crate::front::check::{SELF_TYPE, SELF_TYPE_SYM, has_error_type, resolve_type_or_error};
use crate::front::closures::{closure_of_type, closure_sig};
use crate::front::generics::{
    CUR_INST, INST_QUEUE, TPL_NONE, env_enter, env_leave, env_lookup, instance_of, instance_targs,
};
use crate::front::generics::instantiate::unify;
use crate::front::modules::{CUR_MOD, STD_MODULE, module_of};
use crate::front::traits::{IMPLS, IMPL_COUNT, TRAITS, bound_trait, implements};
use crate::front::types::{FNS, TYPES, TY_ERROR, TyKind, err_type};

// The AssocType node named `name` in holder h (0: none), or 0.
fn assoc_in(h: i64, name: i64) -> i64 {
    if h == 0 {
        return 0;
    }
    unsafe {
        for i in 0..NODES[h].count {
            if NODES[child(h, i)].a == name {
                return child(h, i);
            }
        }
    }
    0
}

fn duplicate_names(h: i64) {
    if h == 0 {
        return;
    }
    unsafe {
        for i in 0..NODES[h].count {
            let c = child(h, i);
            for j in 0..i {
                if NODES[child(h, j)].a == NODES[c].a {
                    err_begin(NODES[c].start);
                    err_str(c"duplicate associated type '");
                    err_sym(NODES[c].a);
                    err_str(c"'");
                    err_end_soft();
                    break;
                }
            }
        }
    }
}

// The associated types trait `tr` (a TRAITS index) declares: its node's
// `b` (a holder of AssocType nodes, 0: none).
pub fn collect_trait_assoc(tr: i64) {
    unsafe { duplicate_names(NODES[TRAITS[tr].node].b); }
}

// The associated types impl `i` (an IMPLS index) defines: its node's `c`
// (a holder of AssocType nodes, 0: none); each name its trait declares
// must be defined.
pub fn collect_impl_assoc(i: i64) {
    unsafe {
        let node = IMPLS[i].node;
        let holder = NODES[node].c;
        let tr = IMPLS[i].tr;
        let declared = NODES[TRAITS[tr].node].b;
        duplicate_names(holder);
        if holder != 0 {
            for k in 0..NODES[holder].count {
                let c = child(holder, k);
                if assoc_in(declared, NODES[c].a) == 0 {
                    err_begin(NODES[c].start);
                    err_str(c"'");
                    err_sym(NODES[c].a);
                    err_str(c"' is not an associated type of trait '");
                    err_sym(TRAITS[tr].name);
                    err_str(c"'");
                    err_end_soft();
                }
            }
        }
        if declared != 0 {
            for k in 0..NODES[declared].count {
                let d = child(declared, k);
                if assoc_in(holder, NODES[d].a) == 0 {
                    err_begin(NODES[node].start);
                    err_str(c"the impl of trait '");
                    err_sym(TRAITS[tr].name);
                    err_str(c"' is missing 'type ");
                    err_sym(NODES[d].a);
                    err_str(c"'");
                    err_help(c"write it in the impl: 'type ");
                    err_help_sym(NODES[d].a);
                    err_help(c" = ...;'");
                    err_end_soft();
                }
            }
        }
    }
}

// Whether impl i is for type t.
fn impl_covers(i: i64, t: i64) -> bool {
    unsafe {
        (IMPLS[i].ty != 0 && IMPLS[i].ty == t)
            || (IMPLS[i].tpl != TPL_NONE && instance_of(t, IMPLS[i].tpl))
    }
}

// What find_assoc found: the impl, and whether a second trait's impl
// defines the name too (an ambiguity).
static mut FOUND_IMPL: i64 = -1;
static mut FOUND_OTHER: i64 = -1;

// The AssocType node `name` of the impl of trait tr (of any trait when tr
// < 0) for type t, or 0; the impl in FOUND_IMPL.
fn find_assoc(tr: i64, t: i64, name: i64) -> i64 {
    unsafe {
        let mut found = 0;
        FOUND_IMPL = -1;
        FOUND_OTHER = -1;
        for i in 0..IMPL_COUNT {
            if tr >= 0 && IMPLS[i].tr != tr {
                continue;
            }
            let c = assoc_in(NODES[IMPLS[i].node].c, name);
            if c == 0 || !impl_covers(i, t) {
                continue;
            }
            if found == 0 {
                found = c;
                FOUND_IMPL = i;
            } else if IMPLS[i].tr != IMPLS[FOUND_IMPL].tr && FOUND_OTHER < 0 {
                FOUND_OTHER = i;
            }
        }
        found
    }
}

// Projections being resolved (a cycle guard: `type A = Self::B;` and `type
// B = Self::A;`).
static mut ASSOC_DEPTH: i64 = 0;
const MAX_ASSOC_DEPTH: i64 = 32;

// The type definition c (an AssocType node) of impl i gives type t.
fn assoc_value(i: i64, c: i64, t: i64, pos: i64) -> i64 {
    unsafe {
        let node = IMPLS[i].node;
        let params = NODES[node].g;
        let generic = params != 0 && NODES[params].count > 0;
        if !generic && NODES[c].ty != 0 {
            return NODES[c].ty;
        }
        if ASSOC_DEPTH >= MAX_ASSOC_DEPTH {
            err_begin(pos);
            err_str(c"the associated type '");
            err_sym(NODES[c].a);
            err_str(c"' of '");
            err_type(t);
            err_str(c"' is defined in terms of itself");
            err_end();
        }
        ASSOC_DEPTH += 1;
        let saved_mod = CUR_MOD;
        let saved_self = SELF_TYPE;
        CUR_MOD = IMPLS[i].module;
        SELF_TYPE = t;
        // (a non-generic impl sees no type parameter: an empty frame)
        let saved = if generic { env_enter(params, instance_targs(t), NODES[params].count) }
            else { env_enter(0, 0, 0) };
        let ty = resolve_type_or_error(NODES[c].b);
        env_leave(saved);
        CUR_MOD = saved_mod;
        SELF_TYPE = saved_self;
        ASSOC_DEPTH -= 1;
        if !generic {
            NODES[c].ty = ty;
        }
        ty
    }
}

// Whether some impl for t is of a trait declaring `name` (which then
// lacks it: an error reported with the impl).
fn declared_for(t: i64, name: i64) -> bool {
    unsafe {
        for i in 0..IMPL_COUNT {
            if impl_covers(i, t) && assoc_in(NODES[TRAITS[IMPLS[i].tr].node].b, name) != 0 {
                return true;
            }
        }
        false
    }
}

// The type `t::name` (an error at pos when there is none, or two traits
// of t define it).
pub fn projection(t: i64, name: i64, pos: i64) -> i64 {
    unsafe {
        if has_error_type(t) {
            return TY_ERROR;
        }
        // (built in: the result type of a closure or fn type)
        if name == intern_c(c"Output") {
            let cl = closure_of_type(t);
            if cl != 0 {
                let sig = closure_sig(cl - 1);
                return if sig != 0 { TYPES[sig].a } else { TY_ERROR };
            }
            if TYPES[t].kind == TyKind::Fn {
                return TYPES[t].a;
            }
        }
        let c = find_assoc(-1, t, name);
        if c == 0 {
            if declared_for(t, name) {
                return TY_ERROR;
            }
            err_begin(pos);
            err_str(c"'");
            err_type(t);
            err_str(c"' has no associated type '");
            err_sym(name);
            err_str(c"'");
            err_end();
        }
        if FOUND_OTHER >= 0 {
            err_begin(pos);
            err_str(c"'");
            err_type(t);
            err_str(c"::");
            err_sym(name);
            err_str(c"' is ambiguous: traits '");
            err_sym(TRAITS[IMPLS[FOUND_IMPL].tr].name);
            err_str(c"' and '");
            err_sym(TRAITS[IMPLS[FOUND_OTHER].tr].name);
            err_str(c"' both define it");
            err_end();
        }
        assoc_value(FOUND_IMPL, c, t, pos)
    }
}

// The associated type `name` trait tr gives type t, or 0 when t has no
// impl of tr defining it (no error).
pub fn trait_projection(tr: i64, t: i64, name: i64, pos: i64) -> i64 {
    let c = find_assoc(tr, t, name);
    if c == 0 {
        return 0;
    }
    unsafe { assoc_value(FOUND_IMPL, c, t, pos) }
}

// The type projection node n (a TyName, is_projection_node) stands for.
pub fn resolve_projection_node(n: i64) -> i64 {
    unsafe {
        let first = NODES[child(n, 0)].a;
        let param = env_lookup(first);
        let base = if param != 0 { param } else { SELF_TYPE };
        projection(base, NODES[n].a, NODES[n].start)
    }
}

// Whether type node n is a projection, `T::Item` or `Self::Item` (not a
// type in a module, `a::T`).
pub fn is_projection_node(n: i64) -> bool {
    unsafe {
        if NODES[n].kind != NodeKind::TyName || NODES[n].count != 1 || NODES[n].g != 0 {
            return false;
        }
        let first = NODES[child(n, 0)].a;
        (first == SELF_TYPE_SYM && SELF_TYPE != 0) || env_lookup(first) != 0
    }
}

// The type constraint c (an AssocType node of a bound) names, resolved in
// its own module (with the type parameters in scope: check_bounds binds
// those of the item being instantiated).
fn constraint_type(c: i64) -> i64 {
    unsafe {
        let saved = CUR_MOD;
        CUR_MOD = module_of(c);
        let t = resolve_type_or_error(NODES[c].b);
        CUR_MOD = saved;
        t
    }
}

// Whether type t meets the constraints of bound node `bound` (a TyName
// whose `h` holds AssocType nodes, `Item = T`). (A type that does not
// implement the bound's trait meets them: that is the bound's error.)
pub fn assoc_constraints_hold(bound: i64, t: i64) -> bool {
    unsafe {
        let tr = bound_trait(bound);
        if tr < 0 || has_error_type(t) || !implements(tr, t) {
            return true;
        }
        let holder = NODES[bound].h;
        for i in 0..NODES[holder].count {
            let c = child(holder, i);
            let want = constraint_type(c);
            let got = trait_projection(tr, t, NODES[c].a, NODES[c].start);
            if got != 0 && !has_error_type(got) && !has_error_type(want) && got != want {
                return false;
            }
        }
        true
    }
}

// The error for the first constraint of `bound` type t does not meet:
// `'Small::Item' is 'u8', but the bound 'I: Iterator<Item = i64>' of 'f'
// requires 'i64'` (param: the parameter's name, what: the item's).
pub fn constraint_error(bound: i64, t: i64, param: i64, what: i64, pos: i64) -> ! {
    unsafe {
        let tr = bound_trait(bound);
        let holder = NODES[bound].h;
        let mut c = child(holder, 0);
        let mut want = 0;
        let mut got = 0;
        for i in 0..NODES[holder].count {
            c = child(holder, i);
            want = constraint_type(c);
            got = trait_projection(tr, t, NODES[c].a, NODES[c].start);
            if got != 0 && got != want {
                break;
            }
        }
        err_begin(pos);
        err_str(c"'");
        err_type(t);
        err_str(c"::");
        err_sym(NODES[c].a);
        err_str(c"' is '");
        err_type(got);
        err_str(c"', but the bound '");
        err_sym(param);
        err_str(c": ");
        err_sym(TRAITS[tr].name);
        err_str(c"<");
        err_sym(NODES[c].a);
        err_str(c" = ");
        err_type(want);
        err_str(c">' of '");
        err_sym(what);
        err_str(c"' requires '");
        err_type(want);
        err_str(c"'");
        err_end()
    }
}

// After the arguments (infer_from's last pass): the parameters the
// constraints of parameter k's bounds name, bound from bound[k]'s
// associated types (`I: Iterator<Item = T>` binds T to I's Item; a
// mismatch is left to check_bounds).
pub fn infer_from_assoc(params: i64, bound: *i64, tmod: i64, k: i64) {
    unsafe {
        let t = bound[k];
        let bounds = NODES[child(params, k)].h;
        if t == 0 || bounds == 0 || has_error_type(t) {
            return;
        }
        for i in 0..NODES[bounds].count {
            let b = child(bounds, i);
            if NODES[b].kind != NodeKind::TyName || NODES[b].h == 0 {
                continue;
            }
            let tr = bound_trait(b);
            if tr < 0 {
                continue;
            }
            let holder = NODES[b].h;
            for j in 0..NODES[holder].count {
                let c = child(holder, j);
                let got = trait_projection(tr, t, NODES[c].a, NODES[c].start);
                if got != 0 {
                    unify(params, bound, tmod, NODES[c].b, got);
                }
            }
        }
    }
}

// The lazy defaults queued (FNS index -> 1).
static mut LAZY_QUEUED: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Function f (a FNS index) is used: if it is a lazy default (FN_LAZY), it
// is checked with the instances (queued once on INST_QUEUE). It keeps
// FN_LAZY: finish_program takes it from the queue, as an instance, and
// drops the lazy defaults never used from the items.
pub fn ensure_checked(f: i64, origin: i64) {
    unsafe {
        if f < 0 || (NODES[FNS[f].node].p & FN_LAZY) == 0 {
            return;
        }
        while LAZY_QUEUED.count <= f {
            LAZY_QUEUED.push(0);
        }
        if LAZY_QUEUED.data[f] != 0 {
            return;
        }
        LAZY_QUEUED.data[f] = 1;
        // (an error in it notes where it was first used, as an instance)
        FNS[f].origin = origin;
        FNS[f].parent = CUR_INST + 1;
        FNS[f].depth = if CUR_INST >= 0 { FNS[CUR_INST].depth + 1 } else { 1 };
        INST_QUEUE.push(f);
    }
}

// std's functions that are not generic are lazy (0.15), as the trait
// defaults copied into impls: checked and emitted only when a program
// uses them (std grew by its formatting; a program pays for what it
// calls, at every level: -O0 emits what is checked).
pub fn lazy_std(program: i64) {
    unsafe {
        if STD_MODULE < 0 {
            return;
        }
        for i in 0..NODES[program].count {
            let item = child(program, i);
            if NODES[item].kind == NodeKind::Fn && NODES[item].g == 0
                && module_of(item) == STD_MODULE {
                NODES[item].p |= FN_LAZY;
            }
        }
    }
}
