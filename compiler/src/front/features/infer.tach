// What each function needs (docs/design/arch.md §2.4), inferred as the
// effects are:
//
//     needs(F) = ∪ over the calls c in F of (needs(callee(c)) \ known(c))
//     needs(intrinsic) = its table's features
//
// beyond the build's features, which every point knows. A declaration
// (#[target_feature]) pins a function's set to what it declares: its body
// can no longer change what its callers must know (check.tach checks the
// body against it). A worklist over the calls (regions.tach's CALLS), from
// the intrinsics and the declarations up to their callers: each set only
// grows, by at most the 33 feature bits.

use crate::arch::{INTRS, intrinsic_of_fn};
use crate::arch::features::implied;
use crate::base::{IntVec, alloc_array};
use crate::front::ast::NODES;
use crate::front::features::regions::{CALLS, CALL_WIDTH, C_ALT, C_CALLEE, C_FN, C_KNOWN};
use crate::front::types::FNS;

// Each function's requirement, beyond the build's features (FNS indexes;
// NEEDS_COUNT of them, 0 before the pass).
pub static mut NEEDS: *i64 = 0 as *i64;
pub static mut NEEDS_COUNT: i64 = 0;
// Each function's declared set (implied features included) with
// DECLARED_MARK, or 0 when it declares none.
pub static mut DECLARED: *i64 = 0 as *i64;
pub const DECLARED_MARK: i64 = 1 << 48;

// The calls of each function: CALLS' records from CALL_FIRST[f] to
// CALL_FIRST[f + 1] (a function's are together: one walk each).
pub static mut CALL_FIRST: *i64 = 0 as *i64;

// Function f's set when it is an intrinsic without a body (-1: not one).
pub fn intrinsic_needs(f: i64, build: i64) -> i64 {
    unsafe {
        let id = intrinsic_of_fn(f);
        if id < 0 || NODES[FNS[f].node].c != 0 {
            return -1;
        }
        implied(INTRS[id].features) & ~build
    }
}

// The requirements, from the walked calls (NEEDS holds the intrinsics' and
// the declared sets already).
pub fn infer_needs(n: i64) {
    unsafe {
        // (the calls of each callee)
        let first = alloc_array::<i64>(n + 2);
        let total = CALLS.count / CALL_WIDTH;
        for r in 0..total {
            first[CALLS.data[r * CALL_WIDTH + C_CALLEE] + 1] += 1;
        }
        for g in 0..n {
            first[g + 1] += first[g];
        }
        let fill = alloc_array::<i64>(n + 1);
        let order = alloc_array::<i64>(total + 1);
        for r in 0..total {
            let g = CALLS.data[r * CALL_WIDTH + C_CALLEE];
            order[first[g] + fill[g]] = r;
            fill[g] += 1;
        }
        let queued = alloc_array::<i64>(n + 1);
        let mut work = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for g in 0..n {
            if NEEDS[g] != 0 {
                work.push(g);
                queued[g] = 1;
            }
        }
        while work.count > 0 {
            work.count -= 1;
            let g = work.data[work.count];
            queued[g] = 0;
            for k in first[g]..first[g + 1] {
                let at = order[k] * CALL_WIDTH;
                let f = CALLS.data[at + C_FN];
                if DECLARED[f] != 0 {
                    continue;
                }
                // (an ambiguous name's other reading is reported where it
                // is, check.tach, and not carried up to the callers)
                let add = NEEDS[g] & ~(CALLS.data[at + C_KNOWN] | CALLS.data[at + C_ALT]);
                if (add & ~NEEDS[f]) != 0 {
                    NEEDS[f] |= add;
                    if queued[f] == 0 {
                        queued[f] = 1;
                        work.push(f);
                    }
                }
            }
        }
    }
}
