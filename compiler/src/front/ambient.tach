// Explicit allocation (0.16, the user's decision U1): nothing allocates
// without being given an allocator. A program's general-purpose
// allocator is the `gpa: Gpa` its `fn main(gpa: Gpa)` takes (main_gpa),
// passed down as a parameter; std has no ambient allocator: `Vec::new()`,
// `Buf::new()`, `HashMap::new()`, `collect()`, `format(x)`, `read_stdin()`,
// `split(..)`, `sort_stable(..)` are errors with the `_in` form to write
// instead (`Vec::new_in(gpa)`).
//
// Those functions stay in std, marked `#[ambient("Vec::new_in(gpa)")]`
// (the attribute is std's: their try text), for two things: the error
// names the `_in` form to write, and `tachyonc fix --only alloc016`
// (tools/refactor_shape/alloc016.tach) reads a 0.15 program's calls of
// them, as the checker resolved them, to migrate it. (0.16 T5: the corpus
// is migrated; `--ambient-gpa` and TACHYON_AMBIENT_GPA are gone.)

use crate::base::{SRC, SYMS, buf_bytes, buf_new, buf_slice, buf_str, intern_c, sym_text};
use crate::base::diag::{
    err_begin, err_end_soft, err_fix, err_help, err_help_fmt, err_str, err_sym, err_try_tool,
};
use crate::front::ast::{
    FN_AMBIENT, FN_SIG_FAILED, NODES, NODE_IMPLICIT, NodeKind, child, list_begin, list_end,
    list_push, new_node,
};
use crate::front::check::{CUR_FN, lookup_local};
use crate::front::modules::{CUR_MOD, STD_MODULE};
use crate::front::types::{FNS, FN_COUNT, STRUCTS, TLISTS, TYPES, TyKind};
use crate::middle::lower::ssa::HMap;

// Whether the calls are allowed: only `fix --only alloc016` sets it, to
// read a 0.15 program (no option or variable does).
pub static mut AMBIENT_GPA: bool = false;
// The start position of an #[ambient("...")] function + 1 -> the symbol of
// its text + 1 (copies of a function, instances and trait defaults, have
// its start).
pub static mut AMBIENT_TRY: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

// Call n of function f: an error when f is one of std's ambient functions
// and the caller is not std (and the fix is not reading the program). The
// help says where the allocator comes from (0.17): this function's `gpa`,
// main's parameter, or a parameter to add; the try: line is the fix that
// threads main's through.
pub fn check_ambient_call(n: i64, f: i64) {
    unsafe {
        let node = FNS[f].node;
        if (NODES[node].p & FN_AMBIENT) == 0 || AMBIENT_GPA || CUR_MOD == STD_MODULE {
            return;
        }
        let text = AMBIENT_TRY.get(NODES[node].start + 1) - 1;
        err_begin(NODES[n].start);
        err_str(c"allocation is explicit: pass an allocator");
        if text >= 0 {
            err_str(c" (try: ");
            err_sym(text);
            err_str(c")");
        }
        let has_gpa = has_local_gpa();
        if has_gpa {
            err_help(c"this function's `gpa` is the allocator to pass");
            if text >= 0 {
                ambient_fix(n, SYMS[text].text);
            }
        } else if CUR_FN >= 0 && SYMS[FNS[CUR_FN].display].text == "main" {
            err_help(c"main takes the allocator: `fn main(gpa: Gpa)`, passed down as a parameter");
        } else if CUR_FN >= 0 {
            err_help_fmt(
                f"a 'gpa: Gpa' comes from 'fn main(gpa: Gpa)': add the parameter `gpa: Gpa` to '{sym_text(FNS[CUR_FN].display)}' and pass it down");
        } else {
            err_help(
                c"a 'gpa: Gpa' comes from 'fn main(gpa: Gpa)' and is passed down as a parameter");
        }
        err_try_tool("fix --only alloc016", true);
        err_end_soft();
    }
}

// Whether the function being checked has a local or parameter `gpa`.
pub fn has_local_gpa() -> bool {
    unsafe {
        match lookup_local(intern_c(c"gpa")) {
            Option::Some(_) => true,
            Option::None => false,
        }
    }
}

// (0.18) The fix of call n of an ambient function whose `_in` form is
// `text` (`Vec::new_in(gpa)`), when this function's `gpa` is passed: the
// name given `_in`, `gpa` the last argument (`Vec::new_in(gpa)`,
// `split_whitespace_in(s, gpa)`). None when the call's text is not that
// plain (a string in its arguments, type arguments before them).
fn ambient_fix(n: i64, text: [u8]) {
    unsafe {
        let start = NODES[n].start;
        let end = NODES[n].end;
        if end - start < 3 || SRC[end - 1] != ')' || text.len < 5
            || text[text.len - 4..text.len] != "gpa)" {
            return;
        }
        // The `_in` name: the word before the try text's `(`.
        let mut tp = 0;
        while tp < text.len && text[tp] != '(' {
            tp += 1;
        }
        let mut ts = tp;
        while ts > 0 && ident_byte(text[ts - 1]) {
            ts -= 1;
        }
        let new = text[ts..tp];
        // The call's `(`, and the name before it.
        let mut open = end - 2;
        let mut depth = 0;
        while open > start && !(SRC[open] == '(' && depth == 0) {
            let c = SRC[open];
            if c == '\'' {
                return;
            }
            if c == '"' {
                // (a string: to its opening quote)
                open -= 1;
                while open > start && !(SRC[open] == '"' && SRC[open - 1] != '\\') {
                    open -= 1;
                }
            }
            if c == ')' {
                depth += 1;
            } else if c == '(' {
                depth -= 1;
            }
            open -= 1;
        }
        let mut ns = open;
        while ns > start && ident_byte(SRC[ns - 1]) {
            ns -= 1;
        }
        let old = SRC[ns..open];
        if open <= start || old.len == 0 || old.len + 3 != new.len || new[0..old.len] != old {
            return;
        }
        let mut blank = true;
        for i in open + 1..end - 1 {
            if SRC[i] != ' ' && SRC[i] != '\n' && SRC[i] != '\t' {
                blank = false;
            }
        }
        let b = buf_new();
        buf_bytes(b, new);
        buf_bytes(b, SRC[open..end - 1]);
        buf_str(b, if blank { c"gpa)" } else { c", gpa)" });
        err_fix(ns, end, buf_slice(b));
    }
}

fn ident_byte(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

// `fn main(gpa: Gpa)`, or a last parameter `gpa: Gpa` after main's others
// (`fn main(argc: i32, argv: **u8, gpa: Gpa)`) (called once the signatures are resolved, before
// main_result_wrapper): the program's general-purpose allocator, made by
// the runtime's entry. Its body becomes `{ let gpa: Gpa = Gpa {}; body }`
// (the literal flagged NODE_IMPLICIT: the one Gpa made outside std, which
// #[sealed] lets through) and main takes no parameter, as C's entry.
pub fn main_gpa() {
    unsafe {
        let main = intern_c(c"main");
        let gpa = intern_c(c"Gpa");
        for f in 0..FN_COUNT {
            let node = FNS[f].node;
            if FNS[f].name != main || NODES[node].kind != NodeKind::Fn || NODES[node].d != 0
                || NODES[node].h != 0 || (NODES[node].p & FN_SIG_FAILED) != 0
                || FNS[f].generic != 0 || FNS[f].tmpl != 0 || FNS[f].param_count < 1 {
                continue;
            }
            let last = FNS[f].param_count - 1;
            let t = TLISTS.data[FNS[f].params + last];
            if TYPES[t].kind != TyKind::Struct || STRUCTS[TYPES[t].a].name != gpa
                || STRUCTS[TYPES[t].a].module != STD_MODULE {
                continue;
            }
            let param = child(node, last);
            let (start, end) = (NODES[param].start, NODES[param].end);
            let lit = new_node(NodeKind::StructLit, start, end);
            NODES[lit].a = gpa;
            NODES[lit].p = NODE_IMPLICIT;
            let none = list_begin();
            list_end(lit, none);
            let bind = new_node(NodeKind::PatBind, start, end);
            NODES[bind].a = NODES[param].a;
            NODES[bind].b = NODES[param].c;
            let binding = new_node(NodeKind::Let, start, end);
            NODES[binding].a = bind;
            NODES[binding].b = NODES[param].b;
            NODES[binding].c = lit;
            let body = NODES[node].c;
            let block = new_node(NodeKind::Block, NODES[body].start, NODES[body].end);
            NODES[block].a = body;
            let mark = list_begin();
            list_push(binding);
            list_end(block, mark);
            NODES[node].c = block;
            // (0.16 T5: `fn main(argc: i32, argv: **u8, gpa: Gpa)` keeps
            // the others)
            let kept = list_begin();
            for i in 0..last {
                list_push(child(node, i));
            }
            list_end(node, kept);
            FNS[f].param_count = last;
        }
    }
}
