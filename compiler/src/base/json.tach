// `--json` (0.15): the diagnostics and the output of every command as
// JSON lines, made from their text forms when they are printed, for a
// harness (a hook, the agent eval; docs/query.md, "JSON").

use crate::base::{IntVec, buf_byte, buf_bytes, buf_clear, buf_int, buf_new, buf_slice, buf_str};
use crate::base::diag::put_short_positions;

// (0.15) `--json`: diagnostics and output as JSON, one object per line,
// for a harness (a hook, the agent eval) rather than a reader. A
// diagnostic:
//   {"kind":"diagnostic","severity":"error","code":"type error",
//    "file":"main.tach","line":2,"col":37,"message":"...",
//    "help":[...],"notes":[...],"try":[...]}
// `code` is a compiler error's kind or a tool's code (`query.no-match`);
// file, line and col are null without a position; positions in the texts
// are in the short form (`file:line:col`). Any other line of output:
// {"kind":"output","fields":[...]}, its tab-separated fields. Every key is
// always there. Set by `--json` anywhere on the command line (main).
pub static mut DIAG_JSON: bool = false;

// s as a JSON string: quoted, escaped.
pub fn buf_json_str(out: i64, s: [u8]) {
    unsafe {
        let hex = c"0123456789abcdef";
        buf_byte(out, '"');
        for i in 0..s.len {
            let c = s[i];
            if c == '"' || c == 92 as u8 {
                buf_byte(out, 92 as u8);
                buf_byte(out, c);
            } else if c == '\n' {
                buf_byte(out, 92 as u8);
                buf_byte(out, 'n');
            } else if c == '\t' {
                buf_byte(out, 92 as u8);
                buf_byte(out, 't');
            } else if c < 32 as u8 {
                buf_byte(out, 92 as u8);
                buf_str(out, c"u00");
                buf_byte(out, hex[(c >> 4) as i64]);
                buf_byte(out, hex[(c & 15) as i64]);
            } else {
                buf_byte(out, c);
            }
        }
        buf_byte(out, '"');
    }
}

// Whether s starts with p.
fn bytes_start(s: [u8], p: *u8) -> bool {
    unsafe {
        let mut i = 0;
        while p[i] != 0 {
            if i >= s.len || s[i] != p[i] {
                return false;
            }
            i += 1;
        }
        true
    }
}

// `,"key":[...]`: the buffers of items as JSON strings.
fn json_list(out: i64, key: *u8, items: *IntVec) {
    unsafe {
        buf_str(out, c",\"");
        buf_str(out, key);
        buf_str(out, c"\":[");
        for i in 0..items.count {
            if i > 0 {
                buf_byte(out, ',');
            }
            buf_json_str(out, buf_slice(items.data[i]));
        }
        buf_byte(out, ']');
    }
}

// The lists of a diagnostic: its help, notes and try lines.
struct JsonTails {
    help: IntVec,
    notes: IntVec,
    tries: IntVec,
}

fn json_tails_new() -> JsonTails {
    JsonTails {
        help: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        notes: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        tries: IntVec { data: 0 as *i64, count: 0, cap: 0 },
    }
}

// A tail of a diagnostic (`help: ...`, `try: ...`, `note: ...`; other
// text is a note) into its list.
fn json_tail(tails: *JsonTails, t: [u8]) {
    unsafe {
        let b = buf_new();
        if bytes_start(t, c"help: ") {
            put_short_positions(b, t[6..t.len]);
            tails.help.push(b);
        } else if bytes_start(t, c"try: ") {
            buf_bytes(b, t[5..t.len]);
            tails.tries.push(b);
        } else if bytes_start(t, c"note: ") {
            put_short_positions(b, t[6..t.len]);
            tails.notes.push(b);
        } else {
            put_short_positions(b, t);
            tails.notes.push(b);
        }
    }
}

// One diagnostic object (see DIAG_JSON): file empty, line and col -1 when
// there is no position.
fn json_diag(out: i64, sev: [u8], code: [u8], file: [u8], line: i64, col: i64, message: [u8],
    tails: *JsonTails) {
    unsafe {
        buf_str(out, c"{\"kind\":\"diagnostic\",\"severity\":");
        buf_json_str(out, sev);
        buf_str(out, c",\"code\":");
        buf_json_str(out, code);
        buf_str(out, c",\"file\":");
        if file.len == 0 {
            buf_str(out, c"null");
        } else {
            buf_json_str(out, file);
        }
        buf_str(out, c",\"line\":");
        if line < 0 {
            buf_str(out, c"null");
        } else {
            buf_int(out, line);
        }
        buf_str(out, c",\"col\":");
        if col < 0 {
            buf_str(out, c"null");
        } else {
            buf_int(out, col);
        }
        buf_str(out, c",\"message\":");
        let m = buf_new();
        put_short_positions(m, message);
        buf_json_str(out, buf_slice(m));
        json_list(out, c"help", &tails.help);
        json_list(out, c"notes", &tails.notes);
        json_list(out, c"try", &tails.tries);
        buf_str(out, c"}\n");
    }
}

// The number of decimal digits at s[i..].
fn digits_at(s: [u8], i: i64) -> i64 {
    let mut j = i;
    while j < s.len && s[j] >= '0' && s[j] <= '9' {
        j += 1;
    }
    j - i
}

// The value of the n digits at s[i..].
fn number_at(s: [u8], i: i64, n: i64) -> i64 {
    let mut v = 0;
    for k in i..i + n {
        v = v * 10 + (s[k] - '0') as i64;
    }
    v
}

// Diagnostic text in the human form (`severity[kind]: message`, ` -->
// file: line l, column c`, `  = help: ...`) as a JSON object.
pub fn json_diagnostic(out: i64, text: [u8]) {
    unsafe {
        let mut e = 0;
        while e < text.len && text[e] != '\n' {
            e += 1;
        }
        let head = text[0..e];
        let mut s = 0;
        while s < head.len && head[s] != '[' && head[s] != ':' {
            s += 1;
        }
        let mut code = head[0..0];
        let mut m = s;
        if s < head.len && head[s] == '[' {
            let mut k = s + 1;
            while k < head.len && head[k] != ']' {
                k += 1;
            }
            code = head[s + 1..k];
            m = if k < head.len { k + 1 } else { k };
        }
        if m < head.len && head[m] == ':' {
            m += 1;
        }
        while m < head.len && head[m] == ' ' {
            m += 1;
        }
        let mut file = head[0..0];
        let mut line = -1;
        let mut col = -1;
        let mut tails = json_tails_new();
        let mut i = e + 1;
        while i < text.len {
            let mut j = i;
            while j < text.len && text[j] != '\n' {
                j += 1;
            }
            let l = text[i..j];
            if line < 0 && bytes_start(l, c" --> ") {
                // `file: line l, column c`: the last `: line ` ends the file
                let mut p = l.len - 7;
                while p > 5 && !bytes_start(l[p..l.len], c": line ") {
                    p -= 1;
                }
                if p > 5 {
                    file = l[5..p];
                    let n = digits_at(l, p + 7);
                    line = number_at(l, p + 7, n);
                    let q = p + 7 + n;
                    if bytes_start(l[q..l.len], c", column ") {
                        col = number_at(l, q + 9, digits_at(l, q + 9));
                    }
                } else {
                    json_tail(&tails, l[5..l.len]);
                }
            } else {
                let mut a = 0;
                while a < l.len && (l[a] == ' ' || l[a] == '=') {
                    a += 1;
                }
                if a < l.len {
                    json_tail(&tails, l[a..l.len]);
                }
            }
            i = j + 1;
        }
        json_diag(out, head[0..s], code, file, line, col, head[m..head.len], &tails);
    }
}

// A line of the short form (`file:line:col: severity[kind] message | help:
// ... | note: ...`) as a JSON diagnostic; false, writing nothing, when s is
// not one.
pub fn json_short_line(out: i64, s: [u8]) -> bool {
    unsafe {
        // the position: the first `:<digits>:<digits>: `
        let mut p = 1;
        let mut found = false;
        let mut line_n = 0;
        let mut col_n = 0;
        while p < s.len && !found {
            if s[p] == ':' {
                line_n = digits_at(s, p + 1);
                if line_n > 0 && p + 1 + line_n < s.len && s[p + 1 + line_n] == ':' {
                    col_n = digits_at(s, p + 2 + line_n);
                    let after = p + 2 + line_n + col_n;
                    found = col_n > 0 && bytes_start(s[after..s.len], c": ");
                }
            }
            if !found {
                p += 1;
            }
        }
        if !found {
            return false;
        }
        let h = p + 4 + line_n + col_n;
        let mut b = h;
        while b < s.len && s[b] != '[' && s[b] != ' ' {
            b += 1;
        }
        if b >= s.len || s[b] != '[' {
            return false;
        }
        let mut k = b + 1;
        while k < s.len && s[k] != ']' {
            k += 1;
        }
        if k + 1 >= s.len {
            return false;
        }
        // the message and the tails, split at ` | `
        let mut tails = json_tails_new();
        let mut from = k + 2;
        let mut message = s[from..from];
        let mut first = true;
        let mut i = from;
        while i <= s.len {
            if i == s.len || (i + 3 <= s.len && s[i] == ' ' && s[i + 1] == '|' && s[i + 2] == ' ') {
                if first {
                    message = s[from..i];
                    first = false;
                } else {
                    json_tail(&tails, s[from..i]);
                }
                from = i + 3;
                i += 3;
            } else {
                i += 1;
            }
        }
        json_diag(out, s[h..b], s[b + 1..k], s[0..p], number_at(s, p + 1, line_n),
            number_at(s, p + 2 + line_n, col_n), message, &tails);
        true
    }
}

// The severity, code and message of a tool's diagnostic line
// (`<severity> <code>: <message>`, severity error, warning or note): the
// index of the space after the severity, of the colon after the code; -1
// when the line is not one.
fn tool_head(l: [u8]) -> i64 {
    unsafe {
        if !(bytes_start(l, c"error ") || bytes_start(l, c"warning ") || bytes_start(l, c"note ")) {
            return -1;
        }
        let mut s = 0;
        while l[s] != ' ' {
            s += 1;
        }
        let mut c = s + 1;
        while c < l.len && l[c] != ':' && l[c] != ' ' {
            c += 1;
        }
        if c == s + 1 || c + 1 >= l.len || l[c] != ':' || l[c + 1] != ' ' {
            return -1;
        }
        s
    }
}

// The tools' diagnostics (`<severity> <code>: <message>` lines, each with
// its `try:` lines and notes after it; a line of the short form among
// them, as an edit's new errors) as JSON objects.
pub fn json_tool_diags(out: i64, text: [u8]) {
    unsafe {
        let mut head = text[0..0];
        let mut tails = json_tails_new();
        let probe = buf_new();
        let mut i = 0;
        while i < text.len {
            let mut j = i;
            while j < text.len && text[j] != '\n' {
                j += 1;
            }
            let l = text[i..j];
            let s = tool_head(l);
            buf_clear(probe);
            let short = s < 0 && json_short_line(probe, l);
            if s >= 0 || short || (head.len == 0 && l.len > 0) {
                flush_tool_diag(out, head, &tails);
                head = text[0..0];
                tails = json_tails_new();
                if s >= 0 {
                    head = l;
                } else if short {
                    buf_bytes(out, buf_slice(probe));
                } else {
                    json_output_line(out, l);
                }
            } else if l.len > 0 {
                let mut a = 0;
                while a < l.len && l[a] == ' ' {
                    a += 1;
                }
                json_tail(&tails, l[a..l.len]);
            }
            i = j + 1;
        }
        flush_tool_diag(out, head, &tails);
    }
}

// The diagnostic of a tool whose head line is head (none when empty).
fn flush_tool_diag(out: i64, head: [u8], tails: *JsonTails) {
    if head.len == 0 {
        return;
    }
    let s = tool_head(head);
    let mut c = s + 1;
    while head[c] != ':' {
        c += 1;
    }
    json_diag(out, head[0..s], head[s + 1..c], head[0..0], -1, -1, head[c + 2..head.len], tails);
}

// A line of output that is not a diagnostic: its tab-separated fields.
fn json_output_line(out: i64, l: [u8]) {
    unsafe {
        buf_str(out, c"{\"kind\":\"output\",\"fields\":[");
        let mut from = 0;
        for i in 0..l.len + 1 {
            if i == l.len || l[i] == '\t' {
                if from > 0 {
                    buf_byte(out, ',');
                }
                buf_json_str(out, l[from..i]);
                from = i + 1;
            }
        }
        buf_str(out, c"]}\n");
    }
}

// What goes to stdout with --json: each line a JSON object (a line of the
// short form as a diagnostic, any other line as its fields).
pub fn json_output(out: i64, text: [u8]) {
    let mut i = 0;
    while i < text.len {
        let mut j = i;
        while j < text.len && text[j] != '\n' {
            j += 1;
        }
        if !json_short_line(out, text[i..j]) {
            json_output_line(out, text[i..j]);
        }
        i = j + 1;
    }
}
