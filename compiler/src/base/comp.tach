// The compilation's two allocators (0.18 T6; docs/design/contracts-verification.md
// §4.1). Comp holds what lives until the compilation ends (types,
// symbols, file texts, positions): `static mut X: Vec<T, Comp>` replaces
// the compiler's raw tables. Ast holds the tokens, nodes and node lists,
// released once the program is lowered at -O1 and -O2. Both are
// zero-sized, so `Comp {}` is a constant a static can hold.
//
// Phase 0: both take their memory from C's allocator, block by block; T6
// makes each an arena (and its `free` a no-op, so values in it skip
// destruction).

use crate::base::{free, malloc, realloc};

pub struct Comp {}

pub struct Ast {}

// size bytes from C's allocator (16-aligned), or null; a larger alignment
// is not served in phase 0.
fn c_alloc(size: i64, align: i64) -> *u8 {
    if align > 16 || size < 0 {
        return 0 as *u8;
    }
    unsafe { malloc(if size == 0 { 1 } else { size } as u64) }
}

fn c_resize(p: *u8, new_size: i64, align: i64) -> *u8 {
    if align > 16 || new_size < 0 {
        return 0 as *u8;
    }
    unsafe { realloc(p, if new_size == 0 { 1 } else { new_size } as u64) }
}

impl Allocator for Comp {
    fn try_alloc(self: *Comp, size: i64, align: i64) -> *u8 {
        c_alloc(size, align)
    }

    unsafe fn try_resize(self: *Comp, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
        c_resize(p, new_size, align)
    }

    unsafe fn free(self: *Comp, p: *u8, size: i64, align: i64) {
        free(p);
    }
}

impl Allocator for Ast {
    fn try_alloc(self: *Ast, size: i64, align: i64) -> *u8 {
        c_alloc(size, align)
    }

    unsafe fn try_resize(self: *Ast, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
        c_resize(p, new_size, align)
    }

    unsafe fn free(self: *Ast, p: *u8, size: i64, align: i64) {
        free(p);
    }
}
