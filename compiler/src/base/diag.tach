// Diagnostics: errors at a source position, as the parser and the checker
// report them; several errors per run, through recovery points; warnings;
// the short one-line form of --diagnostics=short; and the names whose
// declaration failed (their uses are not reported again).

use crate::base::{
    BUFS, FILES, FILE_COUNT, IntVec, SRC, SRC_LEN, STDERR, STDOUT, SYMS, _longjmp, alloc_array,
    alloc_zeroed, buf_byte, buf_bytes, buf_clear, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, exit, free, intern,
};
use crate::front::generics::instantiate::instantiation_notes;

// ---- Errors at a source position ----

pub static mut ERR: i64 = -1;
static mut ERR_POS: i64 = 0;
// `--tokens`: errors print as `error <position in the file>` on stdout, the
// format of the reference lexer's dump.
pub static mut ERRORS_AS_DUMP: bool = false;
// The phase reporting errors, as in the reference compiler's diagnostics.
pub static mut ERR_KIND: *u8 = 0 as *u8;
pub static mut ERR_HELP: i64 = -1;

// Starts an error message at `pos`; finish it with err_* and err_end.
pub fn err_begin(pos: i64) {
    if ERR < 0 {
        ERR = buf_new();
        ERR_HELP = buf_new();
    }
    buf_clear(ERR);
    buf_clear(ERR_HELP);
    ERR_POS = pos;
    ERR_POISONED = false;
}

// ---- Several errors (0.5) ----
//
// The parser and the checker set recovery points (around an item, a
// statement, a function's body): an error is recorded, and the work goes
// on after the innermost recovery point, which skips what failed. At the
// end of a phase that had errors, they are all printed, sorted by
// position, and the compiler exits with 1. An error whose message names
// the error type (the type given to what failed, see TY_ERROR) follows
// from an earlier one and is not reported. (0.10) The phases go on after
// errors (the checker after the parser's); an error whose caller makes do
// without jumping is recorded by err_end_soft.
//
// A recovery point:
//     let depth = RECOVER_DEPTH;
//     if _setjmp(recover_enter()) == 0 {
//         ... work that may fail ...
//     } else {
//         ... clean up after a failure ...
//     }
//     recover_leave(depth);
// (_setjmp must be called by the function that goes on after the jump,
// and that function must not return in between: the work is a call
// followed by more code, never a tail call.)

const MAX_ERRORS: i64 = 50;

static mut RECOVER_BUFS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut RECOVER_DEPTH: i64 = 0;
// The recorded errors: position and message (a buffer), in pairs.
static mut ERRORS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut ERROR_COUNT: i64 = 0;
// (position, message symbol) of each recorded error, in pairs.
static mut ERROR_KEYS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Whether the message being made names the error type.
pub static mut ERR_POISONED: bool = false;

pub fn recover_enter() -> *u8 {
    if RECOVER_BUFS.count <= RECOVER_DEPTH {
        RECOVER_BUFS.push(alloc_zeroed(512) as i64);
    }
    let jb = unsafe { RECOVER_BUFS.data[RECOVER_DEPTH] as *u8 };
    RECOVER_DEPTH += 1;
    jb
}

pub fn recover_leave(depth: i64) {
    RECOVER_DEPTH = depth;
}

// ---- Warnings (0.9) ----
//
// A warning is printed like an error, `warning[<kind>]: ...`, and does not
// fail the compilation; each (position, message) once, however often the
// checker meets it (a generic function is checked per instance), in
// position order, at most MAX_WARNINGS of them. `--deny-warnings` makes
// every warning an error.

pub static mut DENY_WARNINGS: bool = false;
const MAX_WARNINGS: i64 = 50;
// The recorded warnings: position, text (a buffer), key, in triples.
static mut WARNINGS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Records a warning (or, with --deny-warnings, an error) at `pos`; `key`
// tells warnings at one position apart.
pub fn report_warning(pos: i64, key: i64, kind: *u8, message: *u8, help: *u8) {
    unsafe {
        let mut i = 0;
        while i < WARNINGS.count {
            if WARNINGS.data[i] == pos && WARNINGS.data[i + 2] == key {
                return;
            }
            i += 3;
        }
        let out = buf_new();
        buf_str(out, if DENY_WARNINGS { c"error[" } else { c"warning[" });
        buf_str(out, kind);
        buf_str(out, c"]: ");
        buf_str(out, message);
        buf_str(out, c"\n --> ");
        buf_position(out, pos);
        buf_byte(out, '\n');
        if help != 0 as *u8 {
            buf_str(out, c"  = help: ");
            buf_str(out, help);
            buf_byte(out, '\n');
        }
        WARNINGS.push(pos);
        WARNINGS.push(out);
        WARNINGS.push(key);
        if DENY_WARNINGS && ERROR_COUNT < MAX_ERRORS {
            ERRORS.push(pos);
            ERRORS.push(out);
            ERROR_COUNT += 1;
        }
    }
}

// Records an error of kind `kind` at `pos` (0.10: unsafe operations
// outside unsafe code), once per position and `key`, however often the
// checker meets it (a generic function is checked per instance).
static mut KEYED_ERRORS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

pub fn report_error_once(pos: i64, key: i64, kind: *u8, message: *u8, help: *u8) {
    unsafe {
        let mut i = 0;
        while i < KEYED_ERRORS.count {
            if KEYED_ERRORS.data[i] == pos && KEYED_ERRORS.data[i + 1] == key {
                return;
            }
            i += 2;
        }
        KEYED_ERRORS.push(pos);
        KEYED_ERRORS.push(key);
        if ERROR_COUNT >= MAX_ERRORS {
            return;
        }
        let out = buf_new();
        buf_str(out, c"error[");
        buf_str(out, kind);
        buf_str(out, c"]: ");
        buf_str(out, message);
        buf_str(out, c"\n --> ");
        buf_position(out, pos);
        buf_byte(out, '\n');
        if help != 0 as *u8 {
            buf_str(out, c"  = help: ");
            buf_str(out, help);
            buf_byte(out, '\n');
        }
        ERRORS.push(pos);
        ERRORS.push(out);
        ERROR_COUNT += 1;
    }
}

// Prints the recorded warnings (not with --deny-warnings: they are
// errors), sorted by position, and forgets them.
pub fn flush_warnings() {
    unsafe {
        let n = WARNINGS.count / 3;
        if n == 0 || DENY_WARNINGS {
            return;
        }
        for i in 1..n {
            let mut j = i;
            while j > 0 && WARNINGS.data[3 * (j - 1)] > WARNINGS.data[3 * j] {
                for k in 0..3 {
                    let t = WARNINGS.data[3 * j + k];
                    WARNINGS.data[3 * j + k] = WARNINGS.data[3 * (j - 1) + k];
                    WARNINGS.data[3 * (j - 1) + k] = t;
                }
                j -= 1;
            }
        }
        let out = buf_new();
        let shown = if n < MAX_WARNINGS { n } else { MAX_WARNINGS };
        for i in 0..shown {
            put_diagnostic(out, buf_slice(WARNINGS.data[3 * i + 1]));
        }
        if n > shown {
            buf_str(out, c"warning: ");
            buf_int(out, n - shown);
            buf_str(out, c" more warnings not shown\n");
        }
        buf_write_fd(out, STDERR);
        WARNINGS.count = 0;
    }
}

// `tachyonc query` (0.11): where an error that would end the compilation
// goes instead (a jump buffer; 0: none), so the query answers with what
// the front end got to.
pub static mut ERR_BAIL: *u8 = 0 as *u8;

// Prints the recorded errors and exits with 1, if there are any.
pub fn exit_if_errors() {
    unsafe {
        if ERROR_COUNT == 0 {
            return;
        }
        if ERR_BAIL != 0 as *u8 {
            _longjmp(ERR_BAIL, 1);
        }
        write_errors();
        exit(1);
    }
}

// Prints the recorded errors (and the warnings), sorted by position.
pub fn write_errors() {
    unsafe {
        flush_warnings();
        sort_errors();
        let n = ERRORS.count / 2;
        let out = buf_new();
        for i in 0..n {
            put_diagnostic(out, buf_slice(ERRORS.data[2 * i + 1]));
        }
        if ERROR_COUNT >= MAX_ERRORS {
            buf_str(out, c"error: too many errors; stopping after ");
            buf_int(out, MAX_ERRORS);
            buf_byte(out, '\n');
        }
        buf_write_fd(out, STDERR);
    }
}

// The number of errors recorded.
// The number of errors recorded, and forgetting the errors recorded
// since (0.11: a rewrite's pattern is parsed after the program, and its
// syntax error is not the program's).
pub fn errors_mark() -> i64 {
    unsafe { ERRORS.count }
}

pub fn errors_forget(mark: i64) {
    unsafe {
        ERRORS.count = mark;
        ERROR_KEYS.count = mark;
        ERROR_COUNT = mark / 2;
    }
}

pub fn error_count() -> i64 {
    ERROR_COUNT
}

// The recorded errors and warnings, for the tools' cache (0.13): the
// errors' (position, text) pairs and the warnings' (position, text, key)
// triples, the texts as buffers, into `errors` and `warnings`; returns the
// number of errors.
pub fn diag_records(errors: *IntVec, warnings: *IntVec) -> i64 {
    unsafe {
        for i in 0..ERRORS.count {
            errors.push(ERRORS.data[i]);
        }
        for i in 0..WARNINGS.count {
            warnings.push(WARNINGS.data[i]);
        }
        ERROR_COUNT
    }
}

// The errors and warnings diag_records gave, recorded again.
pub fn diag_restore(errors: *IntVec, warnings: *IntVec, count: i64) {
    unsafe {
        for i in 0..(*errors).count {
            ERRORS.push((*errors).data[i]);
        }
        for i in 0..(*warnings).count {
            WARNINGS.push((*warnings).data[i]);
        }
        ERROR_COUNT = count;
    }
}

// The first error (by position) in the short form, without its help and
// notes, and without a newline (`tachyonc query`, 0.11).
pub fn first_error_short(out: i64) {
    unsafe {
        if ERRORS.count == 0 {
            return;
        }
        sort_errors();
        short_diagnostic(out, buf_slice(ERRORS.data[1]), false);
    }
}

// Every recorded error in the short form, one per line, sorted by
// position (0.11: what an edit is checked against).
pub fn errors_short(out: i64) {
    unsafe {
        sort_errors();
        let n = ERRORS.count / 2;
        for i in 0..n {
            short_diagnostic(out, buf_slice(ERRORS.data[2 * i + 1]), true);
            buf_byte(out, '\n');
        }
    }
}

// ---- Short diagnostics (0.11) ----
//
// `--diagnostics=short`: each diagnostic on one line, for tools and
// agents:
//   <file>:<line>:<col>: error[<kind>] <message> | help: <help> | note: <note>
// made from the human form (error_text) when it is printed.
pub static mut DIAG_SHORT: bool = false;

// Diagnostic `text` (in the human form) as it is printed.
fn put_diagnostic(out: i64, text: [u8]) {
    unsafe {
        if DIAG_SHORT {
            short_diagnostic(out, text, true);
            buf_byte(out, '\n');
        } else {
            buf_bytes(out, text);
        }
    }
}

// The one-line form of diagnostic `text`: its position first, then its
// head (`error[kind] message`), then (with `tails`) its help and notes.
fn short_diagnostic(out: i64, text: [u8], tails: bool) {
    unsafe {
        // The lines of text: the head, ` --> position`, `  = help: ...`.
        let mut head_end = 0;
        while head_end < text.len && text[head_end] != '\n' {
            head_end += 1;
        }
        let mut i = head_end + 1;
        let mut pos_from = -1;
        let mut pos_to = -1;
        let mut rest = i;
        if i + 5 <= text.len && text[i] == ' ' && text[i + 1] == '-' && text[i + 2] == '-' && text[i + 3] == '>' {
            pos_from = i + 5;
            while i < text.len && text[i] != '\n' {
                i += 1;
            }
            pos_to = i;
            rest = i + 1;
        }
        if pos_from >= 0 {
            put_short_positions(out, text[pos_from..pos_to]);
            buf_str(out, c": ");
        }
        // `error[kind]: message` -> `error[kind] message`
        let head = text[0..head_end];
        let mut k = 0;
        while k + 2 < head.len && !(head[k] == ']' && head[k + 1] == ':' && head[k + 2] == ' ') {
            k += 1;
        }
        if k + 2 < head.len && head[0] != ' ' {
            buf_bytes(out, head[0..k + 1]);
            put_short_positions(out, head[k + 2..head.len]);
        } else {
            put_short_positions(out, head);
        }
        if !tails {
            return;
        }
        i = rest;
        while i < text.len {
            let mut e = i;
            while e < text.len && text[e] != '\n' {
                e += 1;
            }
            let mut a = i;
            while a < e && (text[a] == ' ' || text[a] == '=') {
                a += 1;
            }
            if a < e {
                buf_str(out, c" | ");
                put_short_positions(out, text[a..e]);
            }
            i = e + 1;
        }
    }
}

// Text s with each `<file>: line <l>, column <c>` as `<file>:<l>:<c>` (and
// `<file>: line <l>` as `<file>:<l>`).
fn put_short_positions(out: i64, s: [u8]) {
    unsafe {
        let mut i = 0;
        while i < s.len {
            if i + 7 <= s.len && s[i] == ':' && s[i + 1] == ' ' && s[i + 2] == 'l' && s[i + 3] == 'i'
                && s[i + 4] == 'n' && s[i + 5] == 'e' && s[i + 6] == ' ' {
                let mut j = i + 7;
                while j < s.len && s[j] >= '0' && s[j] <= '9' {
                    j += 1;
                }
                if j > i + 7 {
                    buf_byte(out, ':');
                    buf_bytes(out, s[i + 7..j]);
                    // `, column <c>`
                    if j + 9 < s.len && s[j] == ',' && s[j + 1] == ' ' && s[j + 2] == 'c' && s[j + 8] == ' ' {
                        let mut c = j + 9;
                        while c < s.len && s[c] >= '0' && s[c] <= '9' {
                            c += 1;
                        }
                        if c > j + 9 {
                            buf_byte(out, ':');
                            buf_bytes(out, s[j + 9..c]);
                            j = c;
                        }
                    }
                    i = j;
                    continue;
                }
            }
            buf_byte(out, s[i]);
            i += 1;
        }
    }
}

// Edit distance of a and b: insertions, deletions, substitutions and
// transpositions of neighbours (optimal string alignment), each 1.
pub fn edit_distance(a: [u8], b: [u8]) -> i64 {
    unsafe {
        let before = alloc_array::<i64>(b.len + 1);
        let prev = alloc_array::<i64>(b.len + 1);
        let cur = alloc_array::<i64>(b.len + 1);
        for j in 0..b.len + 1 {
            prev[j] = j;
        }
        for i in 1..a.len + 1 {
            cur[0] = i;
            for j in 1..b.len + 1 {
                let cost = if a[i - 1] == b[j - 1] { 0 } else { 1 };
                let mut best = prev[j - 1] + cost;
                if prev[j] + 1 < best {
                    best = prev[j] + 1;
                }
                if cur[j - 1] + 1 < best {
                    best = cur[j - 1] + 1;
                }
                if i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1] && before[j - 2] + 1 < best {
                    best = before[j - 2] + 1;
                }
                cur[j] = best;
            }
            for j in 0..b.len + 1 {
                before[j] = prev[j];
                prev[j] = cur[j];
            }
        }
        let result = prev[b.len];
        free(before as *u8);
        free(prev as *u8);
        free(cur as *u8);
        result
    }
}

// Sorts the recorded errors by position (stable: an insertion sort of the
// pairs).
fn sort_errors() {
    unsafe {
        let n = ERRORS.count / 2;
        for i in 1..n {
            let mut j = i;
            while j > 0 && ERRORS.data[2 * (j - 1)] > ERRORS.data[2 * j] {
                let pos = ERRORS.data[2 * j];
                let text = ERRORS.data[2 * j + 1];
                ERRORS.data[2 * j] = ERRORS.data[2 * (j - 1)];
                ERRORS.data[2 * j + 1] = ERRORS.data[2 * (j - 1) + 1];
                ERRORS.data[2 * (j - 1)] = pos;
                ERRORS.data[2 * (j - 1) + 1] = text;
                j -= 1;
            }
        }
    }
}

// Text for the error's help line.
pub fn err_help(s: *u8) {
    buf_str(ERR_HELP, s);
}

pub fn err_help_sym(sym: i64) {
    unsafe { buf_bytes(ERR_HELP, SYMS[sym].text); }
}

pub fn err_str(s: *u8) {
    buf_str(ERR, s);
}

pub fn err_sym(sym: i64) {
    unsafe { buf_bytes(ERR, SYMS[sym].text); }
}

pub fn err_int(value: i64) {
    buf_int(ERR, value);
}

// Prints the error and exits:
//   error[<kind>]: <message>
//    --> <file>: line <line>, column <column>
//     = help: <help>
pub fn err_end() -> ! {
    unsafe {
        if ERRORS_AS_DUMP {
            let mut file = 0;
            while file + 1 < FILE_COUNT && ERR_POS >= FILES[file + 1].start {
                file += 1;
            }
            let out = buf_new();
            buf_str(out, c"error ");
            buf_int(out, ERR_POS - FILES[file].start);
            buf_byte(out, '\n');
            buf_write_fd(out, STDOUT);
            exit(0);
        }
        record_error(error_text());
        err_jump()
    }
}

// On after the innermost recovery point; at none (or after too many
// errors), the errors are printed and the compiler exits.
fn err_jump() -> ! {
    unsafe {
        if RECOVER_DEPTH > 0 && ERROR_COUNT < MAX_ERRORS {
            _longjmp(RECOVER_BUFS.data[RECOVER_DEPTH - 1] as *u8, 1);
        }
        exit_if_errors();
        if ERR_BAIL != 0 as *u8 {
            _longjmp(ERR_BAIL, 1);
        }
        exit(1)
    }
}

// An error whose text, `out`, is made by the caller (an error in a C
// header, which is not part of the source), sorted as if at pos.
pub fn err_end_text(pos: i64, out: i64) -> ! {
    err_begin(pos);
    buf_bytes(ERR, buf_slice(out));
    record_error(out);
    err_jump()
}

// The error being made, as printed.
fn error_text() -> i64 {
    unsafe {
        let out = buf_new();
        buf_str(out, c"error[");
        buf_str(out, ERR_KIND);
        buf_str(out, c"]: ");
        buf_bytes(out, buf_slice(ERR));
        buf_str(out, c"\n --> ");
        buf_position(out, ERR_POS);
        buf_byte(out, '\n');
        if BUFS[ERR_HELP].len > 0 {
            buf_str(out, c"  = help: ");
            buf_bytes(out, buf_slice(ERR_HELP));
            buf_byte(out, '\n');
        }
        instantiation_notes(out);
        out
    }
}

// Records the error being made (its text in `out`), unless it names the
// error type or is already recorded: the same message at the same
// position (a generic function is checked per instance; 0.10).
fn record_error(out: i64) {
    unsafe {
        if ERR_POISONED {
            return;
        }
        let key = intern(buf_slice(ERR));
        let mut i = 0;
        while i < ERROR_KEYS.count {
            if ERROR_KEYS.data[i] == ERR_POS && ERROR_KEYS.data[i + 1] == key {
                return;
            }
            i += 2;
        }
        ERROR_KEYS.push(ERR_POS);
        ERROR_KEYS.push(key);
        ERRORS.push(ERR_POS);
        ERRORS.push(out);
        ERROR_COUNT += 1;
    }
}

// Like err_end, but the work goes on after the error (0.10): for errors
// that leave nothing undone, or whose callers make do (an unknown type is
// the error type, a duplicate is left out...).
pub fn err_end_soft() {
    record_error(error_text());
    if ERROR_COUNT >= MAX_ERRORS {
        exit_if_errors();
    }
}

pub fn error_at_soft(pos: i64, message: *u8) {
    err_begin(pos);
    err_str(message);
    err_end_soft();
}

// ---- Names whose declaration failed (0.10) ----
//
// An item the parser skipped, an import that could not be resolved, a
// module whose file is missing: the errors saying that such a name is
// unknown follow from the first one and are not reported (see
// err_failed_name).
static mut FAILED_NAMES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

pub fn fail_name(name: i64) {
    FAILED_NAMES.push(name);
}

pub fn name_failed(name: i64) -> bool {
    unsafe {
        for i in 0..FAILED_NAMES.count {
            if FAILED_NAMES.data[i] == name {
                return true;
            }
        }
        false
    }
}

// The error being made says that `name` is unknown: it is not reported
// when name's declaration failed.
pub fn err_failed_name(name: i64) {
    if name_failed(name) {
        ERR_POISONED = true;
    }
}

// `<file>: line <line>, column <column>` of position pos.
pub fn buf_position(out: i64, pos: i64) {
    unsafe {
        let mut file = 0;
        while file + 1 < FILE_COUNT && pos >= FILES[file + 1].start {
            file += 1;
        }
        let mut line = 1;
        let mut col = 1;
        let mut i = FILES[file].start;
        while i < pos && i < SRC_LEN {
            if SRC[i] == '\n' {
                line += 1;
                col = 1;
            } else {
                col += 1;
            }
            i += 1;
        }
        buf_str(out, FILES[file].path);
        buf_str(out, c": line ");
        buf_int(out, line);
        buf_str(out, c", column ");
        buf_int(out, col);
    }
}

pub fn error_at(pos: i64, message: *u8) -> ! {
    err_begin(pos);
    err_str(message);
    err_end()
}
