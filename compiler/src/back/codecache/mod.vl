use crate::back::codecache::hash::{
    FN_AMBIG, FN_CANON, FN_NAMEH, H2, fn_of_name, h2_new, h2_put, h2_puti, hash_bytes, ir_hash,
    ir_nameh, ir_of_name, mix, names_begin, strings_begin, types_hash,
};
