// Block layout: the order the blocks of a function are emitted in, apart
// from the order register allocation numbered them (ORDER). Any order is
// correct: every move belongs to a block or to an edge (emit.tach), and
// a block's code depends on its allocation only, not on where it goes.
//
// Chains by fall-through (Pettis and Hansen, "Profile Guided Code
// Positioning", PLDI 1990, with static estimates instead of a profile):
// the edges, heaviest first, join the chain ending at their source to the
// chain starting at their target. A block's frequency is 8^(its loop
// depth); a branch sends 63/64 of it away from a cold successor (one that
// only leads to a panic or `unreachable`), 7/8 along a loop's back edge or
// within its loop rather than out of it, else half each way. The chain of
// the entry comes first, then the others by their first block's
// allocation order; cold chains go last.

// The emission order (block ids, skipped blocks left out).
use crate::back::emit::blocks::{is_skipped, jump_target};
use crate::back::regalloc::{LDEPTH, ORDER};
use crate::back::regalloc::intervals::min_i64;
use crate::base::IntVec;
use crate::front::types::fn_attr_cold;
use crate::gen0::target::rt_panic_sym;
use crate::middle::ir::{BLOCKS, INSTS, Op, Term};
use crate::middle::ir::cfg::{succ, succ_count};

pub static mut EMIT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Per layout index (BLOCKS[b].order): the next block of its chain (-1),
// the first block of its chain, the last one (valid at the first), and
// whether the block is cold.
static mut CHAIN_NEXT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut CHAIN_HEAD: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut CHAIN_TAIL: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut COLD: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Edges: (weight, source index, target index) triples, then sorted.
static mut EDGES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut EDGE_ORDER: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut EDGE_TEMP: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn int_vec_fill(vec: *IntVec, n: i64, value: i64) {
    vec.count = 0;
    for _ in 0..n {
        vec.push(value);
    }
}

// Whether block b only leads to a panic (or `unreachable`): it ends in
// one, or calls the panic or a `#[cold]` function, or jumps to such a
// block.
fn ends_cold(b: i64) -> bool {
    unsafe {
        let mut x = b;
        for _ in 0..8 {
            if BLOCKS[x].term == Term::Unreach {
                return true;
            }
            let mut v = BLOCKS[x].first;
            while v != 0 {
                if INSTS[v].op == Op::CallC && INSTS[v].imm == rt_panic_sym() {
                    return true;
                }
                if INSTS[v].op == Op::Call && fn_attr_cold(INSTS[v].imm) {
                    return true;
                }
                v = INSTS[v].next;
            }
            if BLOCKS[x].term != Term::Jump {
                return false;
            }
            x = BLOCKS[x].s0;
        }
        false
    }
}

fn block_freq(k: i64) -> i64 {
    unsafe {
        if PROFILED {
            let c = COUNT.data[k];
            if c >= 0 {
                return c;
            }
        }
        1 << (3 * min_i64(LDEPTH.data[k], 6)) as u64
    }
}

// With a profile (0.10): the blocks' counts, by layout index (estimated
// for blocks made after the profile was read: an edge's block runs as
// often as the least of its ends, another as its predecessors' shares).
static mut PROFILED: bool = false;
static mut COUNT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn estimate_counts(n: i64) {
    unsafe {
        COUNT.count = 0;
        for k in 0..n {
            COUNT.push(BLOCKS[ORDER.data[k]].count);
        }
        PROFILED = n > 0 && COUNT.data[0] > 0;
        if !PROFILED {
            return;
        }
        for k in 0..n {
            if COUNT.data[k] >= 0 {
                continue;
            }
            let b = ORDER.data[k];
            let mut sum = 0;
            let mut known = false;
            for i in 0..BLOCKS[b].preds.count {
                let p = BLOCKS[BLOCKS[b].preds.data[i]].order;
                if p >= 0 && COUNT.data[p] >= 0 {
                    let share = COUNT.data[p] / (if succ_count(ORDER.data[p])
                        > 1 { succ_count(ORDER.data[p]) } else { 1 });
                    sum += share;
                    known = true;
                }
            }
            if BLOCKS[b].preds.count == 1 && succ_count(b) == 1 {
                let s = BLOCKS[succ(b, 0)].order;
                let p = BLOCKS[BLOCKS[b].preds.data[0]].order;
                if s >= 0 && p >= 0 && COUNT.data[s] >= 0 && COUNT.data[p] >= 0 {
                    sum = min_i64(COUNT.data[s], COUNT.data[p]);
                    known = true;
                }
            }
            if known {
                COUNT.data[k] = sum;
            }
        }
    }
}

// The share (of 64) of block k's frequency going to its successor s
// (by index), on a branch to s and other.
fn branch_share(k: i64, s: i64, other: i64) -> i64 {
    unsafe {
        if PROFILED && COUNT.data[s] >= 0 && COUNT.data[other] >= 0
            && COUNT.data[s] + COUNT.data[other] > 0 {
            let share = 64 * COUNT.data[s] / (COUNT.data[s] + COUNT.data[other]);
            return if share < 1 { 1 } else if share > 63 { 63 } else { share };
        }
        let cold_s = COLD.data[s] != 0;
        let cold_other = COLD.data[other] != 0;
        if cold_s != cold_other {
            return if cold_s { 1 } else { 63 };
        }
        // A back edge (to a block not later in the allocation order: a loop
        // header) is likely; so is staying within the loop.
        let back_s = s <= k;
        let back_other = other <= k;
        if back_s != back_other {
            return if back_s { 56 } else { 8 };
        }
        let depth = LDEPTH.data[k];
        let in_s = LDEPTH.data[s] >= depth;
        let in_other = LDEPTH.data[other] >= depth;
        if in_s != in_other {
            return if in_s { 56 } else { 8 };
        }
        32
    }
}

fn add_edge(weight: i64, from: i64, to: i64) {
    if to == from || to < 0 {
        return;
    }
    EDGES.push(weight);
    EDGES.push(from);
    EDGES.push(to);
}

// Whether edge i comes before edge j: heavier first, then in order.
fn edge_before(i: i64, j: i64) -> bool {
    unsafe {
        let wi = EDGES.data[3 * i];
        let wj = EDGES.data[3 * j];
        if wi != wj {
            return wi > wj;
        }
        i < j
    }
}

// Sorts EDGE_ORDER (indices of edges) by edge_before: bottom-up merge sort.
fn sort_edges() {
    unsafe {
        let n = EDGE_ORDER.count;
        int_vec_fill(&EDGE_TEMP, n, 0);
        let mut width = 1;
        while width < n {
            let mut lo = 0;
            while lo < n {
                let mid = min_i64(lo + width, n);
                let hi = min_i64(lo + 2 * width, n);
                let mut i = lo;
                let mut j = mid;
                let mut k = lo;
                while k < hi {
                    if i < mid
                        && (j >= hi || !edge_before(EDGE_ORDER.data[j], EDGE_ORDER.data[i])) {
                        EDGE_TEMP.data[k] = EDGE_ORDER.data[i];
                        i += 1;
                    } else {
                        EDGE_TEMP.data[k] = EDGE_ORDER.data[j];
                        j += 1;
                    }
                    k += 1;
                }
                lo = hi;
            }
            for k in 0..n {
                EDGE_ORDER.data[k] = EDGE_TEMP.data[k];
            }
            width *= 2;
        }
    }
}

// The layout index of the block a jump to b really reaches.
fn edge_target(b: i64) -> i64 {
    let t = jump_target(b);
    if is_skipped(t) {
        return -1;
    }
    unsafe { BLOCKS[t].order }
}

pub fn layout_emission() {
    unsafe {
        let n = ORDER.count;
        int_vec_fill(&CHAIN_NEXT, n, -1);
        CHAIN_HEAD.count = 0;
        CHAIN_TAIL.count = 0;
        COLD.count = 0;
        estimate_counts(n);
        for k in 0..n {
            CHAIN_HEAD.push(k);
            CHAIN_TAIL.push(k);
            let never = PROFILED && COUNT.data[k] == 0;
            COLD.push(if ends_cold(ORDER.data[k]) || never { 1 } else { 0 });
        }
        EDGES.count = 0;
        for k in 0..n {
            let b = ORDER.data[k];
            if is_skipped(b) {
                continue;
            }
            let freq = block_freq(k);
            let term = BLOCKS[b].term;
            if term == Term::Jump {
                add_edge(64 * freq, k, edge_target(BLOCKS[b].s0));
            } else if term == Term::Branch {
                let s0 = edge_target(BLOCKS[b].s0);
                let s1 = edge_target(BLOCKS[b].s1);
                if s0 >= 0 && s1 >= 0 {
                    add_edge(branch_share(k, s0, s1) * freq, k, s0);
                    add_edge(branch_share(k, s1, s0) * freq, k, s1);
                }
            }
        }
        EDGE_ORDER.count = 0;
        for i in 0..EDGES.count / 3 {
            EDGE_ORDER.push(i);
        }
        sort_edges();
        for i in 0..EDGE_ORDER.count {
            let e = EDGE_ORDER.data[i];
            let from = EDGES.data[3 * e + 1];
            let to = EDGES.data[3 * e + 2];
            let head_from = CHAIN_HEAD.data[from];
            let head_to = CHAIN_HEAD.data[to];
            // From the end of a chain to the start of another (never to the
            // entry, which stays first).
            if CHAIN_TAIL.data[head_from] != from || head_to != to || head_from == head_to
                || to == 0 {
                continue;
            }
            CHAIN_NEXT.data[from] = to;
            CHAIN_TAIL.data[head_from] = CHAIN_TAIL.data[to];
            let mut x = to;
            while x >= 0 {
                CHAIN_HEAD.data[x] = head_from;
                x = CHAIN_NEXT.data[x];
            }
        }
        // The chains: the entry's, the hot ones, the cold ones (a chain is cold
        // when its first block is).
        EMIT.count = 0;
        for pass in 0..2 {
            for k in 0..n {
                if CHAIN_HEAD.data[k] != k {
                    continue;
                }
                let cold = COLD.data[k] != 0 && k != 0;
                if (pass == 0) == cold {
                    continue;
                }
                let mut x = k;
                while x >= 0 {
                    let b = ORDER.data[x];
                    if !is_skipped(b) {
                        EMIT.push(b);
                    }
                    x = CHAIN_NEXT.data[x];
                }
            }
        }
    }
}
