// Block layout: the order the blocks of a function are emitted in, apart
// from the order register allocation numbered them (ORDER). Any order is
// correct: every move belongs to a block or to an edge (emit.tach), and
// a block's code depends on its allocation only, not on where it goes.
//
// Chains by fall-through (Pettis and Hansen, "Profile Guided Code
// Positioning", PLDI 1990, with static estimates instead of a profile):
// the edges, heaviest first, join the chain ending at their source to the
// chain starting at their target. A block's frequency is 8^(its loop
// depth); a branch sends 63/64 of it away from a cold successor (one that
// only leads to a panic or `unreachable`), 7/8 along a loop's back edge or
// within its loop rather than out of it, else half each way. The chain of
// the entry comes first, then the others by their first block's
// allocation order; cold chains go last.

// The emission order (block ids, skipped blocks left out).
use crate::back::emit::blocks::{is_skipped, jump_target};
use crate::back::regalloc::intervals::min_i64;
use crate::base::IntVec;
use crate::front::types::fn_attr_cold;
use crate::gen0::target::rt_panic_sym;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Op, Term};
use crate::middle::ir::cfg::{succ, succ_count};

fn int_vec_fill(vec: *IntVec, n: i64, value: i64) {
    unsafe {
        vec.count = 0;
        for _ in 0..n {
            vec.push(value);
        }
    }
}

// Whether block b only leads to a panic (or `unreachable`): it ends in
// one, or calls the panic or a `#[cold]` function, or jumps to such a
// block.
fn ends_cold(mut cx: *FnCtx, b: i64) -> bool {
    unsafe {
        let mut x = b;
        for _ in 0..8 {
            if cx.blocks[x].term == Term::Unreach {
                return true;
            }
            let mut v = cx.blocks[x].first;
            while v != 0 {
                if cx.insts[v].op == Op::CallC && cx.insts[v].imm == rt_panic_sym() {
                    return true;
                }
                if cx.insts[v].op == Op::Call && fn_attr_cold(cx.insts[v].imm) {
                    return true;
                }
                v = cx.insts[v].next;
            }
            if cx.blocks[x].term != Term::Jump {
                return false;
            }
            x = cx.blocks[x].s0;
        }
        false
    }
}

fn block_freq(mut cx: *FnCtx, k: i64) -> i64 {
    unsafe {
        if cx.profiled {
            let c = cx.count.data[k];
            if c >= 0 {
                return c;
            }
        }
        1 << (3 * min_i64(cx.ldepth.data[k], 6)) as u64
    }
}

fn estimate_counts(mut cx: *FnCtx, n: i64) {
    unsafe {
        cx.count.count = 0;
        for k in 0..n {
            cx.count.push(cx.blocks[cx.order.data[k]].count);
        }
        cx.profiled = n > 0 && cx.count.data[0] > 0;
        if !cx.profiled {
            return;
        }
        for k in 0..n {
            if cx.count.data[k] >= 0 {
                continue;
            }
            let b = cx.order.data[k];
            let mut sum = 0;
            let mut known = false;
            for i in 0..cx.blocks[b].preds.count {
                let p = cx.blocks[cx.blocks[b].preds.data[i]].order;
                if p >= 0 && cx.count.data[p] >= 0 {
                    let share = cx.count.data[p] / (if succ_count(cx, cx.order.data[p])
                        > 1 { succ_count(cx, cx.order.data[p]) } else { 1 });
                    sum += share;
                    known = true;
                }
            }
            if cx.blocks[b].preds.count == 1 && succ_count(cx, b) == 1 {
                let s = cx.blocks[succ(cx, b, 0)].order;
                let p = cx.blocks[cx.blocks[b].preds.data[0]].order;
                if s >= 0 && p >= 0 && cx.count.data[s] >= 0 && cx.count.data[p] >= 0 {
                    sum = min_i64(cx.count.data[s], cx.count.data[p]);
                    known = true;
                }
            }
            if known {
                cx.count.data[k] = sum;
            }
        }
    }
}

// The share (of 64) of block k's frequency going to its successor s
// (by index), on a branch to s and other.
fn branch_share(mut cx: *FnCtx, k: i64, s: i64, other: i64) -> i64 {
    unsafe {
        if cx.profiled && cx.count.data[s] >= 0 && cx.count.data[other] >= 0
            && cx.count.data[s] + cx.count.data[other] > 0 {
            let share = 64 * cx.count.data[s] / (cx.count.data[s] + cx.count.data[other]);
            return if share < 1 { 1 } else if share > 63 { 63 } else { share };
        }
        let cold_s = cx.cold.data[s] != 0;
        let cold_other = cx.cold.data[other] != 0;
        if cold_s != cold_other {
            return if cold_s { 1 } else { 63 };
        }
        // A back edge (to a block not later in the allocation order: a loop
        // header) is likely; so is staying within the loop.
        let back_s = s <= k;
        let back_other = other <= k;
        if back_s != back_other {
            return if back_s { 56 } else { 8 };
        }
        let depth = cx.ldepth.data[k];
        let in_s = cx.ldepth.data[s] >= depth;
        let in_other = cx.ldepth.data[other] >= depth;
        if in_s != in_other {
            return if in_s { 56 } else { 8 };
        }
        32
    }
}

fn add_edge(mut cx: *FnCtx, weight: i64, from: i64, to: i64) {
    unsafe {
        if to == from || to < 0 {
            return;
        }
        cx.edges.push(weight);
        cx.edges.push(from);
        cx.edges.push(to);
    }
}

// Whether edge i comes before edge j: heavier first, then in order.
fn edge_before(mut cx: *FnCtx, i: i64, j: i64) -> bool {
    unsafe {
        let wi = cx.edges.data[3 * i];
        let wj = cx.edges.data[3 * j];
        if wi != wj {
            return wi > wj;
        }
        i < j
    }
}

// Sorts EDGE_ORDER (indices of edges) by edge_before: bottom-up merge sort.
fn sort_edges(mut cx: *FnCtx) {
    unsafe {
        let n = cx.edge_order.count;
        int_vec_fill(&cx.edge_temp, n, 0);
        let mut width = 1;
        while width < n {
            let mut lo = 0;
            while lo < n {
                let mid = min_i64(lo + width, n);
                let hi = min_i64(lo + 2 * width, n);
                let mut i = lo;
                let mut j = mid;
                let mut k = lo;
                while k < hi {
                    if i < mid
                        && (j >= hi
                            || !edge_before(cx, cx.edge_order.data[j], cx.edge_order.data[i])) {
                        cx.edge_temp.data[k] = cx.edge_order.data[i];
                        i += 1;
                    } else {
                        cx.edge_temp.data[k] = cx.edge_order.data[j];
                        j += 1;
                    }
                    k += 1;
                }
                lo = hi;
            }
            for k in 0..n {
                cx.edge_order.data[k] = cx.edge_temp.data[k];
            }
            width *= 2;
        }
    }
}

// The layout index of the block a jump to b really reaches.
fn edge_target(mut cx: *FnCtx, b: i64) -> i64 {
    let t = jump_target(cx, b);
    if is_skipped(cx, t) {
        return -1;
    }
    unsafe { cx.blocks[t].order }
}

pub fn layout_emission(mut cx: *FnCtx) {
    unsafe {
        let n = cx.order.count;
        int_vec_fill(&cx.chain_next, n, -1);
        cx.chain_head.count = 0;
        cx.chain_tail.count = 0;
        cx.cold.count = 0;
        estimate_counts(cx, n);
        for k in 0..n {
            cx.chain_head.push(k);
            cx.chain_tail.push(k);
            let never = cx.profiled && cx.count.data[k] == 0;
            cx.cold.push(if ends_cold(cx, cx.order.data[k]) || never { 1 } else { 0 });
        }
        cx.edges.count = 0;
        for k in 0..n {
            let b = cx.order.data[k];
            if is_skipped(cx, b) {
                continue;
            }
            let freq = block_freq(cx, k);
            let term = cx.blocks[b].term;
            if term == Term::Jump {
                add_edge(cx, 64 * freq, k, edge_target(cx, cx.blocks[b].s0));
            } else if term == Term::Branch {
                let s0 = edge_target(cx, cx.blocks[b].s0);
                let s1 = edge_target(cx, cx.blocks[b].s1);
                if s0 >= 0 && s1 >= 0 {
                    add_edge(cx, branch_share(cx, k, s0, s1) * freq, k, s0);
                    add_edge(cx, branch_share(cx, k, s1, s0) * freq, k, s1);
                }
            }
        }
        cx.edge_order.count = 0;
        for i in 0..cx.edges.count / 3 {
            cx.edge_order.push(i);
        }
        sort_edges(cx);
        for e in cx.edge_order.items() {
            let from = cx.edges.data[3 * e + 1];
            let to = cx.edges.data[3 * e + 2];
            let head_from = cx.chain_head.data[from];
            let head_to = cx.chain_head.data[to];
            // From the end of a chain to the start of another (never to the
            // entry, which stays first).
            if cx.chain_tail.data[head_from] != from || head_to != to || head_from == head_to
                || to == 0 {
                continue;
            }
            cx.chain_next.data[from] = to;
            cx.chain_tail.data[head_from] = cx.chain_tail.data[to];
            let mut x = to;
            while x >= 0 {
                cx.chain_head.data[x] = head_from;
                x = cx.chain_next.data[x];
            }
        }
        // The chains: the entry's, the hot ones, the cold ones (a chain is cold
        // when its first block is).
        cx.emit.count = 0;
        for pass in 0..2 {
            for k in 0..n {
                if cx.chain_head.data[k] != k {
                    continue;
                }
                let cold = cx.cold.data[k] != 0 && k != 0;
                if (pass == 0) == cold {
                    continue;
                }
                let mut x = k;
                while x >= 0 {
                    let b = cx.order.data[x];
                    if !is_skipped(cx, b) {
                        cx.emit.push(b);
                    }
                    x = cx.chain_next.data[x];
                }
            }
        }
    }
}
