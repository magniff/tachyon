// x86-64 instructions (AT&T syntax) for the IR back end (emit/), on
// physical registers: 0-15 are the integer registers by hardware number
// (rax rcx rdx rbx rsp rbp rsi rdi r8-r15), 32 + n is xmm<n>.
//
// Use of the registers: rax, rcx, rdx, rsi, rdi, r8 and r9 (caller-saved)
// and rbx, r12-r15 (callee-saved) are allocated (division and MULH take
// rax and rdx, a shift by a register cl: the allocator keeps them free
// there);
// r10 and r11 are the temporaries inside one instruction, and of the
// parallel moves (r10 breaks cycles, r11 is the temporary and holds the
// callee of indirect calls). xmm0-xmm13 are allocated, xmm14 and xmm15 are
// the parallel moves' registers and temporaries inside one instruction.
//
// Here: registers and memory operands, moves, constants, loads, stores,
// addresses, the frame link and block copies. The operations are in
// ops.tach, the vector instructions in vector.tach.

pub mod ops;
pub mod vector;
pub mod arch;
pub mod atomic;

use crate::base::buf_uint;
use crate::front::consteval::{f32_bits, f64_of_bits};
use crate::front::types::{
    TY_F32, TY_F64, TY_I16, TY_I32, TY_I8, TY_U16, TY_U32, TY_U8, is_float, is_vector, type_size,
};
use crate::gen0::target::{emit_symbol_ref, global_prefix, ins, o, o_str_label, oi, on};
use crate::gen0::x86_64::fits_i32;
use crate::middle::ctx::FnCtx;

fn mx_name(r: i64, size: i64) -> *u8 {
    if r >= 32 {
        return c"";
    }
    if r
        == 0 {
        return if size == 8 { c"%rax" } else if size == 4 { c"%eax" } else if size == 2 { c"%ax" }
            else { c"%al" };
    }
    if r
        == 1 {
        return if size == 8 { c"%rcx" } else if size == 4 { c"%ecx" } else if size == 2 { c"%cx" }
            else { c"%cl" };
    }
    if r
        == 2 {
        return if size == 8 { c"%rdx" } else if size == 4 { c"%edx" } else if size == 2 { c"%dx" }
            else { c"%dl" };
    }
    if r
        == 3 {
        return if size == 8 { c"%rbx" } else if size == 4 { c"%ebx" } else if size == 2 { c"%bx" }
            else { c"%bl" };
    }
    if r
        == 4 {
        return if size == 8 { c"%rsp" } else if size == 4 { c"%esp" } else if size == 2 { c"%sp" }
            else { c"%spl" };
    }
    if r
        == 5 {
        return if size == 8 { c"%rbp" } else if size == 4 { c"%ebp" } else if size == 2 { c"%bp" }
            else { c"%bpl" };
    }
    if r
        == 6 {
        return if size == 8 { c"%rsi" } else if size == 4 { c"%esi" } else if size == 2 { c"%si" }
            else { c"%sil" };
    }
    if r
        == 7 {
        return if size == 8 { c"%rdi" } else if size == 4 { c"%edi" } else if size == 2 { c"%di" }
            else { c"%dil" };
    }
    if r
        == 8 {
        return if size == 8 { c"%r8" } else if size == 4 { c"%r8d" } else if size == 2 { c"%r8w" }
            else { c"%r8b" };
    }
    if r
        == 9 {
        return if size == 8 { c"%r9" } else if size == 4 { c"%r9d" } else if size == 2 { c"%r9w" }
            else { c"%r9b" };
    }
    if r
        == 10 {
        return if size == 8 { c"%r10" } else if size == 4 { c"%r10d" }
            else if size == 2 { c"%r10w" } else { c"%r10b" };
    }
    if r
        == 11 {
        return if size == 8 { c"%r11" } else if size == 4 { c"%r11d" }
            else if size == 2 { c"%r11w" } else { c"%r11b" };
    }
    if r
        == 12 {
        return if size == 8 { c"%r12" } else if size == 4 { c"%r12d" }
            else if size == 2 { c"%r12w" } else { c"%r12b" };
    }
    if r
        == 13 {
        return if size == 8 { c"%r13" } else if size == 4 { c"%r13d" }
            else if size == 2 { c"%r13w" } else { c"%r13b" };
    }
    if r
        == 14 {
        return if size == 8 { c"%r14" } else if size == 4 { c"%r14d" }
            else if size == 2 { c"%r14w" } else { c"%r14b" };
    }
    if size == 8 { c"%r15" } else if size == 4 { c"%r15d" } else if size == 2 { c"%r15w" }
    else { c"%r15b" }
}

// Writes register r: 64-bit name for integers (size for narrower), xmm<n>
// for floats.
fn mx_r(mut cx: *FnCtx, r: i64) {
    mx_rs(cx, r, 8);
}

pub fn mx_rs(mut cx: *FnCtx, r: i64, size: i64) {
    unsafe {
        if r >= 32 {
            // (0.19: a 256-bit value's, size 32: the ymm register)
            o(cx, if size == 32 { c"%ymm" } else { c"%xmm" });
            oi(cx, r - 32);
        } else {
            o(cx, mx_name(r, size));
        }
    }
}

// "    <mnemonic> %a, %b\n"
fn mx_rr(mut cx: *FnCtx, mnemonic: *u8, a: i64, b: i64) {
    unsafe {
        o(cx, c"    ");
        o(cx, mnemonic);
        o(cx, c" ");
        mx_r(cx, a);
        o(cx, c", ");
        mx_r(cx, b);
        on(cx);
    }
}

// "    <mnemonic> $imm, %r\n"
fn mx_ir(mut cx: *FnCtx, mnemonic: *u8, imm: i64, r: i64) {
    unsafe {
        o(cx, c"    ");
        o(cx, mnemonic);
        o(cx, c" $");
        oi(cx, imm);
        o(cx, c", ");
        mx_r(cx, r);
        on(cx);
    }
}

// "<offset>(%base)"
fn mx_mem(mut cx: *FnCtx, base: i64, offset: i64) {
    unsafe {
        if offset != 0 {
            oi(cx, offset);
        }
        o(cx, c"(");
        mx_r(cx, base);
        if cx.mem_index >= 0 {
            // disp(base, index, 1 << s) (see isel.tach).
            o(cx, c",");
            mx_r(cx, cx.mem_index);
            if cx.mem_scale != 0 {
                o(cx, c",");
                oi(cx, 1 << cx.mem_scale as u64);
            }
        }
        o(cx, c")");
    }
}

pub fn mx_mov(mut cx: *FnCtx, dst: i64, src: i64, ty: i64) {
    unsafe {
        if dst >= 32 && is_vector(ty) && type_size(ty) == 32 {
            o(cx, c"    vmovdqa ");
            mx_rs(cx, src, 32);
            o(cx, c", ");
            mx_rs(cx, dst, 32);
            on(cx);
        } else if dst >= 32 {
            mx_rr(cx, c"movapd", src, dst);
        } else {
            mx_rr(cx, c"movq", src, dst);
        }
    }
}

pub fn mx_load_imm(mut cx: *FnCtx, dst: i64, value: u64) {
    unsafe {
        let signed = value as i64;
        if signed == 0 {
            o(cx, c"    xorl ");
            mx_rs(cx, dst, 4);
            o(cx, c", ");
            mx_rs(cx, dst, 4);
            on(cx);
        } else if signed > 0 && signed <= 4294967295 {
            // movl zero-extends to 64 bits.
            o(cx, c"    movl $");
            buf_uint(cx.code, value);
            o(cx, c", ");
            mx_rs(cx, dst, 4);
            on(cx);
        } else if fits_i32(signed) {
            mx_ir(cx, c"movq", signed, dst);
        } else {
            mx_ir(cx, c"movabsq", signed, dst);
        }
    }
}

// Through r10 (free after the cycles of a parallel move, where constants
// are rematerialized, and inside instructions).
pub fn mx_load_fimm(mut cx: *FnCtx, dst: i64, bits: i64, ty: i64) {
    unsafe {
        if bits == 0 {
            mx_rr(cx, if ty == TY_F32 { c"xorps" } else { c"xorpd" }, dst, dst);
            return;
        }
        if ty == TY_F32 {
            o(cx, c"    movl $");
            buf_uint(cx.code, f32_bits(f64_of_bits(bits)));
            o(cx, c", %r10d\n    movd %r10d, ");
            mx_r(cx, dst);
            on(cx);
        } else {
            mx_ir(cx, c"movabsq", bits, 10);
            o(cx, c"    movq %r10, ");
            mx_r(cx, dst);
            on(cx);
        }
    }
}

pub fn mx_load(mut cx: *FnCtx, ty: i64, dst: i64, base: i64, offset: i64) {
    unsafe {
        let size = type_size(ty);
        o(cx, c"    ");
        if is_vector(ty) && size == 32 {
            // (0.19: AVX, in a function whose 256-bit values only AVX code makes)
            o(cx, c"vmovdqu ");
            mx_mem(cx, base, offset);
            o(cx, c", ");
            mx_rs(cx, dst, 32);
            on(cx);
            return;
        }
        if is_vector(ty) && size == 16 {
            o(cx, c"movups ");
        } else if ty == TY_F64 || is_vector(ty) {
            // (0.19: a 64-bit vector, the xmm register's low half)
            o(cx, c"movsd ");
        } else if ty == TY_F32 {
            o(cx, c"movss ");
        } else if ty == TY_I8 {
            o(cx, c"movsbq ");
        } else if size == 1 {
            o(cx, c"movzbl ");
        } else if ty == TY_I16 {
            o(cx, c"movswq ");
        } else if size == 2 {
            o(cx, c"movzwl ");
        } else if ty == TY_I32 {
            o(cx, c"movslq ");
        } else if size == 4 {
            o(cx, c"movl ");
        } else {
            o(cx, c"movq ");
        }
        mx_mem(cx, base, offset);
        o(cx, c", ");
        if !is_float(ty) && (size == 1 || size == 2 || (size == 4 && ty != TY_I32)) && ty != TY_I8
            && ty != TY_I16 {
            mx_rs(cx, dst, 4);
        } else {
            mx_r(cx, dst);
        }
        on(cx);
    }
}

pub fn mx_store(mut cx: *FnCtx, ty: i64, src: i64, base: i64, offset: i64) {
    unsafe {
        let size = type_size(ty);
        o(cx, c"    ");
        if is_vector(ty) && size == 32 {
            o(cx, c"vmovdqu ");
            mx_rs(cx, src, 32);
        } else if is_vector(ty) && size == 16 {
            o(cx, c"movups ");
            mx_r(cx, src);
        } else if is_vector(ty) {
            o(cx, c"movsd ");
            mx_r(cx, src);
        } else if ty == TY_F32 {
            o(cx, c"movss ");
            mx_r(cx, src);
        } else if ty == TY_F64 {
            o(cx, c"movsd ");
            mx_r(cx, src);
        } else if size == 1 {
            o(cx, c"movb ");
            mx_rs(cx, src, 1);
        } else if size == 2 {
            o(cx, c"movw ");
            mx_rs(cx, src, 2);
        } else if size == 4 {
            o(cx, c"movl ");
            mx_rs(cx, src, 4);
        } else {
            o(cx, c"movq ");
            mx_r(cx, src);
        }
        o(cx, c", ");
        mx_mem(cx, base, offset);
        on(cx);
    }
}

pub fn mx_lea(mut cx: *FnCtx, dst: i64, base: i64, offset: i64) {
    unsafe {
        o(cx, c"    leaq ");
        mx_mem(cx, base, offset);
        o(cx, c", ");
        mx_r(cx, dst);
        on(cx);
    }
}

pub fn mx_symbol_addr(mut cx: *FnCtx, dst: i64, prefix: *u8, name: i64) {
    unsafe {
        o(cx, c"    leaq ");
        emit_symbol_ref(cx, prefix, name);
        o(cx, c"(%rip), ");
        mx_r(cx, dst);
        on(cx);
    }
}

pub fn mx_extern_addr(mut cx: *FnCtx, dst: i64, name: i64) {
    unsafe {
        o(cx, c"    movq ");
        emit_symbol_ref(cx, global_prefix(), name);
        o(cx, c"@GOTPCREL(%rip), ");
    }
    mx_r(cx, dst);
    on(cx);
}

pub fn mx_string_addr(mut cx: *FnCtx, dst: i64, id: i64) {
    unsafe {
        o(cx, c"    leaq ");
        o_str_label(cx, id);
        o(cx, c"(%rip), ");
        mx_r(cx, dst);
        on(cx);
    }
}

pub fn mx_normalize(mut cx: *FnCtx, r: i64, ty: i64) {
    unsafe {
        if ty == TY_I8 {
            o(cx, c"    movsbq ");
            mx_rs(cx, r, 1);
        } else if ty == TY_U8 {
            o(cx, c"    movzbl ");
            mx_rs(cx, r, 1);
            o(cx, c", ");
            mx_rs(cx, r, 4);
            on(cx);
            return;
        } else if ty == TY_I16 {
            o(cx, c"    movswq ");
            mx_rs(cx, r, 2);
        } else if ty == TY_U16 {
            o(cx, c"    movzwl ");
            mx_rs(cx, r, 2);
            o(cx, c", ");
            mx_rs(cx, r, 4);
            on(cx);
            return;
        } else if ty == TY_I32 {
            o(cx, c"    movslq ");
            mx_rs(cx, r, 4);
        } else if ty == TY_U32 {
            o(cx, c"    movl ");
            mx_rs(cx, r, 4);
            o(cx, c", ");
            mx_rs(cx, r, 4);
            on(cx);
            return;
        } else {
            return;
        }
        o(cx, c", ");
        mx_r(cx, r);
        on(cx);
    }
}

// Links a frame: saves the frame pointer, points it at itself.
pub fn mx_frame_link(mut cx: *FnCtx) {
    unsafe {
        ins(cx, c"pushq %rbp");
        ins(cx, c"movq %rsp, %rbp");
    }
}

// Unlinks it: rsp from the frame pointer, which is restored.
pub fn mx_frame_unlink(mut cx: *FnCtx) {
    unsafe {
        ins(cx, c"movq %rbp, %rsp");
        ins(cx, c"popq %rbp");
    }
}

pub fn mx_copy(mut cx: *FnCtx, dst: i64, src: i64, size: i64) {
    unsafe {
        let mut offset = 0;
        while offset + 8 <= size {
            mx_copy_chunk(cx, c"movq", 8, dst, src, offset);
            offset += 8;
        }
        if offset + 4 <= size {
            mx_copy_chunk(cx, c"movl", 4, dst, src, offset);
            offset += 4;
        }
        if offset + 2 <= size {
            mx_copy_chunk(cx, c"movw", 2, dst, src, offset);
            offset += 2;
        }
        if offset < size {
            mx_copy_chunk(cx, c"movb", 1, dst, src, offset);
        }
    }
}

fn mx_copy_chunk(mut cx: *FnCtx, mnemonic: *u8, size: i64, dst: i64, src: i64, offset: i64) {
    unsafe {
        o(cx, c"    ");
        o(cx, mnemonic);
        o(cx, c" ");
        mx_mem(cx, src, offset);
        o(cx, c", ");
        mx_rs(cx, 11, size);
        on(cx);
        o(cx, c"    ");
        o(cx, mnemonic);
        o(cx, c" ");
        mx_rs(cx, 11, size);
        o(cx, c", ");
        mx_mem(cx, dst, offset);
        on(cx);
    }
}
