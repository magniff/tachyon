// x86-64 operations (mc_x86_64/mod.tach): integer and float arithmetic,
// comparisons and branches, conversions, jump tables, and the machine
// operations of instruction selection.

use crate::back::emit::machine::{m_mov, stays_canonical};
use crate::back::mc_x86_64::{mx_ir, mx_load_imm, mx_mov, mx_normalize, mx_r, mx_rr, mx_rs};
use crate::front::types::{TY_F32, TY_F64, TY_U64, int_bits, is_float, is_signed};
use crate::gen0::target::{emit_label, ins, new_label, o, o_label, oi, on};
use crate::gen0::x86_64::{fits_i32, x64_int_cc, x64_jcc, x64_jump};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Cond, Op};
use crate::middle::ir::Op::{Add, And, Div, Mul, Neg, Not, Or, Rem, Shl, Shr, Sub, Xor};

fn mx_op_mnemonic(op: Op) -> *u8 {
    match op {
        Add => c"addq",
        Sub => c"subq",
        Mul => c"imulq",
        And => c"andq",
        Or => c"orq",
        _ => c"xorq",
    }
}

pub fn is_commutative(op: Op) -> bool {
    op == Add || op == Mul || op == And || op == Or || op == Xor
}

// d = a <op> b (for shifts, none of them is rcx).
pub fn mx_int_op(mut cx: *FnCtx, op: Op, ty: i64, d: i64, a: i64, b: i64) {
    unsafe {
        if op == Shl || op == Shr {
            // The amount is taken modulo 32 for types up to 32 bits, modulo 64
            // for 64-bit ones.
            mx_rr(cx, c"movq", b, 1);
            mx_ir(cx, c"andq", if int_bits(ty) == 64 { 63 } else { 31 }, 1);
            m_mov(cx, d, a, TY_U64);
            o(cx, c"    ");
            if op == Shl {
                o(cx, c"shlq");
            } else if is_signed(ty) {
                o(cx, c"sarq");
            } else {
                o(cx, c"shrq");
            }
            o(cx, c" %cl, ");
            mx_r(cx, d);
            on(cx);
        } else if d == b && d != a {
            if is_commutative(op) {
                mx_rr(cx, mx_op_mnemonic(op), a, d);
            } else {
                mx_rr(cx, c"movq", a, 11);
                mx_rr(cx, mx_op_mnemonic(op), b, 11);
                mx_rr(cx, c"movq", 11, d);
            }
        } else {
            m_mov(cx, d, a, TY_U64);
            mx_rr(cx, mx_op_mnemonic(op), b, d);
        }
        // (0.16: not after and, or, xor, right shifts: see stays_canonical)
        if !stays_canonical(op, is_signed(ty)) {
            mx_normalize(cx, d, ty);
        }
    }
}

// Whether mx_int_op_imm emits `a <op> imm`.
pub fn mx_int_imm_ok(op: Op, imm: i64) -> bool {
    if op == Shl || op == Shr {
        return true;
    }
    op != Div && op != Rem && fits_i32(imm)
}

pub fn mx_int_op_imm(mut cx: *FnCtx, op: Op, ty: i64, d: i64, a: i64, imm: i64) -> bool {
    unsafe {
        if op == Shl || op == Shr {
            let amount = imm & (if int_bits(ty) == 64 { 63 } else { 31 });
            m_mov(cx, d, a, TY_U64);
            if amount != 0 {
                mx_ir(cx,
                    if op == Shl { c"shlq" } else if is_signed(ty) { c"sarq" } else { c"shrq" },
                    amount, d);
            }
            if op == Shl {
                mx_normalize(cx, d, ty);
            }
            return true;
        }
        if op == Div || op == Rem || !fits_i32(imm) {
            return false;
        }
        if op == Mul && (imm == 3 || imm == 5 || imm == 9) {
            // a * (2^k + 1) = a + a * 2^k
            o(cx, c"    leaq (");
            mx_r(cx, a);
            o(cx, c",");
            mx_r(cx, a);
            o(cx, c",");
            oi(cx, imm - 1);
            o(cx, c"), ");
            mx_r(cx, d);
            on(cx);
            mx_normalize(cx, d, ty);
            return true;
        }
        if op == Mul {
            o(cx, c"    imulq $");
            oi(cx, imm);
            o(cx, c", ");
            mx_r(cx, a);
            o(cx, c", ");
            mx_r(cx, d);
            on(cx);
        } else {
            m_mov(cx, d, a, TY_U64);
            mx_ir(cx, mx_op_mnemonic(op), imm, d);
        }
        if !stays_canonical(op, is_signed(ty)) {
            mx_normalize(cx, d, ty);
        }
        true
    }
}

// d = a / b (or a % b). Division by zero gives 0 and the remainder the
// dividend, and the signed MIN / -1 wraps, as on AArch64 (where idiv would
// trap); the checks are left out for a constant divisor that needs none.
// Neither a nor b is rax or rdx (nor is d).
pub fn mx_div(mut cx: *FnCtx, op: Op, ty: i64, d: i64, a: i64, b: i64, b_const: i64,
    b_is_const: bool) {
    unsafe {
        let remainder = op == Rem;
        let signed = is_signed(ty);
        mx_rr(cx, c"movq", a, 0);
        mx_rr(cx, c"movq", b, 11);
        let checked = !(b_is_const && b_const != 0 && !(signed && b_const == -1));
        let by_zero = new_label(cx);
        let done = new_label(cx);
        if checked {
            ins(cx, c"testq %r11, %r11");
            x64_jcc(cx, c"e", by_zero);
        }
        if signed {
            let by_minus_one = new_label(cx);
            if checked {
                ins(cx, c"cmpq $-1, %r11");
                x64_jcc(cx, c"e", by_minus_one);
            }
            ins(cx, c"cqto");
            ins(cx, c"idivq %r11");
            if remainder {
                ins(cx, c"movq %rdx, %rax");
            }
            if checked {
                x64_jump(cx, done);
                emit_label(cx, by_minus_one);
                ins(cx, if remainder { c"xorl %eax, %eax" } else { c"negq %rax" });
            }
        } else {
            ins(cx, c"xorl %edx, %edx");
            ins(cx, c"divq %r11");
            if remainder {
                ins(cx, c"movq %rdx, %rax");
            }
        }
        if checked {
            x64_jump(cx, done);
            emit_label(cx, by_zero);
            if !remainder {
                ins(cx, c"xorl %eax, %eax");
            }
            emit_label(cx, done);
        }
        m_mov(cx, d, 0, TY_U64);
        mx_normalize(cx, d, ty);
    }
}

// d = the high 64 bits of a * b (MULH, 0.11): mulq or imulq, which leave
// them in rdx (the allocator keeps rax and rdx free there, as for a
// division; neither a nor b nor d is one of them). The result is already
// canonical for its type (see isel.tach).
pub fn mx_mulh(mut cx: *FnCtx, signed: bool, d: i64, a: i64, b: i64) {
    unsafe {
        mx_rr(cx, c"movq", a, 0);
        o(cx, if signed { c"    imulq " } else { c"    mulq " });
        mx_r(cx, b);
        on(cx);
        mx_rr(cx, c"movq", 2, d);
    }
}

pub fn mx_float_op(mut cx: *FnCtx, op: Op, ty: i64, d: i64, a: i64, b: i64) {
    unsafe {
        let f32 = ty == TY_F32;
        let mut name = c"div";
        if op == Add { name = c"add"; }
        else if op == Sub { name = c"sub"; }
        else if op == Mul { name = c"mul"; }
        if d == b && d != a {
            if op == Add || op == Mul {
                mx_float_rr(cx, name, f32, a, d);
                return;
            }
            mx_rr(cx, c"movapd", a, 47);
            mx_float_rr(cx, name, f32, b, 47);
            mx_rr(cx, c"movapd", 47, d);
            return;
        }
        m_mov(cx, d, a, ty);
        mx_float_rr(cx, name, f32, b, d);
    }
}

// "    <name>ss/sd %a, %b\n"
fn mx_float_rr(mut cx: *FnCtx, name: *u8, f32: bool, a: i64, b: i64) {
    unsafe {
        o(cx, c"    ");
        o(cx, name);
        o(cx, if f32 { c"ss " } else { c"sd " });
        mx_r(cx, a);
        o(cx, c", ");
        mx_r(cx, b);
        on(cx);
    }
}

pub fn mx_unary(mut cx: *FnCtx, op: Op, ty: i64, d: i64, a: i64) {
    unsafe {
        if op == Neg && ty == TY_F32 {
            mx_rr(cx, c"movd", a, 11);
            ins(cx, c"xorl $0x80000000, %r11d");
            mx_rr(cx, c"movd", 11, d);
            return;
        }
        if op == Neg && ty == TY_F64 {
            mx_rr(cx, c"movq", a, 11);
            ins(cx, c"btcq $63, %r11");
            mx_rr(cx, c"movq", 11, d);
            return;
        }
        m_mov(cx, d, a, TY_U64);
        if op == Neg {
            o(cx, c"    negq ");
        } else if op == Not {
            mx_ir(cx, c"xorq", 1, d);
            return;
        } else {
            o(cx, c"    notq ");
        }
        mx_r(cx, d);
        on(cx);
        mx_normalize(cx, d, ty);
    }
}

pub fn mx_cmp(mut cx: *FnCtx, op: Cond, ty: i64, d: i64, a: i64, b: i64) {
    unsafe {
        if !is_float(ty) {
            mx_rr(cx, c"cmpq", b, a);
            o(cx, c"    set");
            o(cx, x64_int_cc(op, is_signed(ty)));
            o(cx, c" %r11b\n");
        } else {
            let compare = if ty == TY_F32 { c"ucomiss" } else { c"ucomisd" };
            // Unordered (NaN) sets ZF, PF and CF: == and != check PF; < and <=
            // swap the operands to use the ordered "above" conditions.
            if op == Cond::Lt || op == Cond::Le {
                mx_rr(cx, compare, a, b);
            } else {
                mx_rr(cx, compare, b, a);
            }
            if op == Cond::Eq {
                ins(cx, c"sete %r11b");
                ins(cx, c"setnp %r10b");
                ins(cx, c"andb %r10b, %r11b");
            } else if op == Cond::Ne {
                ins(cx, c"setne %r11b");
                ins(cx, c"setp %r10b");
                ins(cx, c"orb %r10b, %r11b");
            } else if op == Cond::Lt || op == Cond::Gt {
                ins(cx, c"seta %r11b");
            } else {
                ins(cx, c"setae %r11b");
            }
        }
        o(cx, c"    movzbl %r11b, ");
        mx_rs(cx, d, 4);
        on(cx);
    }
}

// d = (a op imm), integers, imm a 32-bit immediate.
pub fn mx_cmp_imm(mut cx: *FnCtx, op: Cond, ty: i64, d: i64, a: i64, imm: i64) {
    unsafe {
        mx_ir(cx, c"cmpq", imm, a);
        o(cx, c"    set");
        o(cx, x64_int_cc(op, is_signed(ty)));
        o(cx, c" %r11b\n");
        o(cx, c"    movzbl %r11b, ");
    }
    mx_rs(cx, d, 4);
    on(cx);
}

pub fn mx_cmp_branch(mut cx: *FnCtx, op: Cond, ty: i64, a: i64, b: i64, b_is_imm: bool, imm: i64,
    label: i64) {
    unsafe {
        if b_is_imm {
            mx_ir(cx, c"cmpq", imm, a);
        } else {
            mx_rr(cx, c"cmpq", b, a);
        }
        x64_jcc(cx, x64_int_cc(op, is_signed(ty)), label);
    }
}

pub fn mx_branch_bool(mut cx: *FnCtx, r: i64, if_nonzero: bool, label: i64) {
    unsafe {
        mx_rr(cx, c"testq", r, r);
        x64_jcc(cx, if if_nonzero { c"ne" } else { c"e" }, label);
    }
}

pub fn mx_conv(mut cx: *FnCtx, from: i64, to: i64, d: i64, src: i64) {
    unsafe {
        let from_f32 = from == TY_F32;
        if is_float(from) && is_float(to) {
            mx_rr(cx, if to == TY_F64 { c"cvtss2sd" } else { c"cvtsd2ss" }, src, d);
            return;
        }
        if is_float(to) {
            mx_int_to_float(cx, from, to, d, src);
            return;
        }
        if !is_float(from) {
            m_mov(cx, d, src, TY_U64);
            mx_normalize(cx, d, to);
            return;
        }
        // Saturating float to integer (see x64_float_to_int), in r11.
        if is_signed(to) && int_bits(to) <= 32 {
            mx_truncate(cx, from_f32, 32, src);
            ins(cx, c"movslq %r11d, %r11");
        } else if to != TY_U64 {
            mx_truncate(cx, from_f32, 64, src);
        } else {
            // value >= 2^63 ? the unsigned conversion : the signed one.
            let big = new_label(cx);
            let done = new_label(cx);
            if from_f32 {
                ins(cx, c"movl $0x5f000000, %r11d");
                ins(cx, c"movd %r11d, %xmm15");
                mx_rr(cx, c"ucomiss", 47, src);
            } else {
                ins(cx, c"movabsq $0x43e0000000000000, %r11");
                ins(cx, c"movq %r11, %xmm15");
                mx_rr(cx, c"ucomisd", 47, src);
            }
            x64_jcc(cx, c"ae", big);
            mx_truncate(cx, from_f32, 64, src);
            x64_jump(cx, done);
            emit_label(cx, big);
            // value - 2^63 converts exactly below 2^64; above, the indefinite
            // result means "saturate to the maximum".
            mx_rr(cx, c"movapd", src, 46);
            ins(cx, if from_f32 { c"subss %xmm15, %xmm14" } else { c"subsd %xmm15, %xmm14" });
            ins(cx, if from_f32 { c"cvttss2si %xmm14, %r11" } else { c"cvttsd2si %xmm14, %r11" });
            let saturate = new_label(cx);
            ins(cx, c"testq %r11, %r11");
            x64_jcc(cx, c"s", saturate);
            ins(cx, c"btsq $63, %r11");
            x64_jump(cx, done);
            emit_label(cx, saturate);
            ins(cx, c"movq $-1, %r11");
            emit_label(cx, done);
        }
        m_mov(cx, d, 11, TY_U64);
        mx_normalize(cx, d, to);
    }
}

// r11 (r11d at 32 bits) = the saturating signed conversion of float
// register src (see x64_truncate); r10 is a temporary.
fn mx_truncate(mut cx: *FnCtx, f32: bool, bits: i64, src: i64) {
    unsafe {
        let done = new_label(cx);
        let nan = new_label(cx);
        o(cx, if f32 { c"    cvttss2si " } else { c"    cvttsd2si " });
        mx_r(cx, src);
        o(cx, if bits == 32 { c", %r11d\n" } else { c", %r11\n" });
        if bits == 32 {
            ins(cx, c"cmpl $-2147483648, %r11d");
        } else {
            ins(cx, c"movabsq $-9223372036854775808, %r10");
            ins(cx, c"cmpq %r10, %r11");
        }
        x64_jcc(cx, c"ne", done);
        mx_rr(cx, if f32 { c"ucomiss" } else { c"ucomisd" }, src, src);
        x64_jcc(cx, c"p", nan);
        // The minimum is right for negative overflow (and the minimum itself).
        if f32 {
            mx_rr(cx, c"movd", src, 10);
            ins(cx, c"testl %r10d, %r10d");
        } else {
            mx_rr(cx, c"movq", src, 10);
            ins(cx, c"testq %r10, %r10");
        }
        x64_jcc(cx, c"s", done);
        if bits == 32 {
            ins(cx, c"movl $2147483647, %r11d");
        } else {
            ins(cx, c"movabsq $9223372036854775807, %r11");
        }
        x64_jump(cx, done);
        emit_label(cx, nan);
        ins(cx, c"xorl %r11d, %r11d");
        emit_label(cx, done);
    }
}

fn mx_int_to_float(mut cx: *FnCtx, from: i64, to: i64, d: i64, src: i64) {
    unsafe {
        let convert = if to == TY_F32 { c"cvtsi2ssq" } else { c"cvtsi2sdq" };
        if from != TY_U64 {
            // Signed, or unsigned below 2^32 (zero-extended): exact as signed.
            mx_rr(cx, convert, src, d);
            return;
        }
        // u64 at 2^63 and above: halve (keeping the low bit, for rounding),
        // convert, double.
        let big = new_label(cx);
        let done = new_label(cx);
        mx_rr(cx, c"testq", src, src);
        x64_jcc(cx, c"s", big);
        mx_rr(cx, convert, src, d);
        x64_jump(cx, done);
        emit_label(cx, big);
        mx_rr(cx, c"movq", src, 11);
        ins(cx, c"movq %r11, %r10");
        ins(cx, c"shrq $1, %r11");
        ins(cx, c"andl $1, %r10d");
        ins(cx, c"orq %r10, %r11");
        mx_rr(cx, convert, 11, d);
        mx_rr(cx, if to == TY_F32 { c"addss" } else { c"addsd" }, d, d);
        emit_label(cx, done);
    }
}

// A jump through a table of 32-bit offsets (from the table) to labels:
// entry `value - low` for register r, the default above the range
// (position independent).
pub fn mx_jump_table(mut cx: *FnCtx, r: i64, low: i64, range: i64, default: i64, table: *i64) {
    unsafe {
        // The index: the value itself when the cases start at 0.
        let index = if low == 0 { r } else { 11 };
        if low != 0 {
            mx_mov(cx, 11, r, TY_U64);
        }
        if low != 0 {
            if fits_i32(low) {
                mx_ir(cx, c"subq", low, 11);
            } else {
                mx_load_imm(cx, 10, low as u64);
                mx_rr(cx, c"subq", 10, 11);
            }
        }
        mx_ir(cx, c"cmpq", range - 1, index);
        x64_jcc(cx, c"a", default);
        let at = new_label(cx);
        o(cx, c"    leaq ");
        o_label(cx, at);
        o(cx, c"(%rip), %r10\n");
        o(cx, c"    movslq (%r10,");
        mx_r(cx, index);
        o(cx, c",4), %r11\n");
        ins(cx, c"addq %r10, %r11");
        ins(cx, c"jmp *%r11");
        ins(cx, c".p2align 2");
        emit_label(cx, at);
        for i in 0..range {
            o(cx, c"    .long ");
            o_label(cx, table[i]);
            o(cx, c" - ");
            o_label(cx, at);
            on(cx);
        }
    }
}

// ---- Machine operations of instruction selection (isel/) ----

// Sets the flags from a & b (b < 0: a & mask).
fn mx_test(mut cx: *FnCtx, a: i64, b: i64, mask: i64) {
    unsafe {
        if b >= 0 {
            mx_rr(cx, c"testq", b, a);
        } else {
            mx_ir(cx, c"testq", mask, a);
        }
    }
}

// Jumps to `label` when a & b (b < 0: a & mask) is nonzero, or zero.
pub fn mx_test_branch(mut cx: *FnCtx, a: i64, b: i64, mask: i64, if_nonzero: bool, label: i64) {
    mx_test(cx, a, b, mask);
    unsafe { x64_jcc(cx, if if_nonzero { c"ne" } else { c"e" }, label); }
}

// d = (lhs op rhs) ? then : other (integers), or (lhs & rhs) op 0 when
// `test` (rhs < 0: the immediate imm); the flags are already set unless
// `compare`.
pub fn mx_select(mut cx: *FnCtx, op: Cond, test: bool, compare: bool, cmp_ty: i64, lhs: i64,
    rhs: i64, imm: i64, d: i64, then: i64, other: i64) {
    unsafe {
        if !compare {
        } else if test {
            mx_test(cx, lhs, rhs, imm);
        } else if rhs < 0 {
            mx_ir(cx, c"cmpq", imm, lhs);
        } else {
            mx_rr(cx, c"cmpq", rhs, lhs);
        }
        let signed = is_signed(cmp_ty);
        // movq leaves the flags alone.
        if d == other {
            mx_cmov(cx, x64_int_cc(op, signed), then, d);
        } else if d == then {
            mx_cmov(cx, x64_int_cc(op.negate(), signed), other, d);
        } else {
            mx_rr(cx, c"movq", other, d);
            mx_cmov(cx, x64_int_cc(op, signed), then, d);
        }
    }
}

fn mx_cmov(mut cx: *FnCtx, cc: *u8, src: i64, d: i64) {
    unsafe {
        o(cx, c"    cmov");
        o(cx, cc);
        o(cx, c"q ");
        mx_r(cx, src);
        o(cx, c", ");
        mx_r(cx, d);
        on(cx);
    }
}

// d = sqrt(a).
pub fn mx_sqrt(mut cx: *FnCtx, ty: i64, d: i64, a: i64) {
    unsafe { mx_rr(cx, if ty == TY_F32 { c"sqrtss" } else { c"sqrtsd" }, a, d); }
}
