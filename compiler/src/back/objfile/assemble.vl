// The assembler proper (objfile): each line of the text is a label, a
// directive or an instruction (encoded by enc_arm64.vl or enc_x86.vl),
// appended to the object being built (mod.vl) as bytes, symbols and
// fixups. Here: errors, scanning a line and its operands, numbers and
// data values, AArch64 ELF mapping symbols, and the directives.

use crate::back::enc_arm64::a64_instruction;
use crate::back::enc_x86::x86_instruction;
use crate::back::objfile::{
    ASYMS, ASYM_LOOKUPS, ATEXT, CUR_ATOM, CUR_SEC, FIXUPS, FIXUP_COUNT, FRAGS, FRAG_COUNT, FX_ABS32,
    FX_ABS64, FX_DIFF32, OBJ, OPEN, ObjBytes, RAW, SEC_ALIGN, SEC_CONST, SEC_DATA, SEC_DEBUG_ABBREV,
    SEC_DEBUG_INFO, SEC_DEBUG_LINE, SEC_NOTE, SEC_TEXT, TAIL_ALIGN, asym, bytes_append, end_frag,
    fixup, hash_bytes, here, is_debug, is_temp, obj_reserve, out32, out64, out8, switch_section,
};
use crate::back::objfile::debug::{
    LOC_COL, LOC_FILE, LOC_LINE, LOC_PENDING, cfi_directive, dwarf_file, line_row,
};
use crate::base::{
    IntVec, STDERR, alloc_array, buf_fmt, buf_new, buf_write_fd, cstr, exit, free, grow, memcmp,
    memcpy, memset,
};
use crate::base::target::X86;
use crate::middle::ctx::FnCtx;

// ---- Errors ----

static var LINE_START: i64 = 0;
static var LINE_END: i64 = 0;

pub fn asm_error(cx: sink *FnCtx, message: *u8) -> ! {
    unsafe {
        let line = ATEXT[LINE_START..LINE_END];
        let out = buf_new();
        buf_fmt(out, f"internal error: cannot assemble: {cstr(message)}: {line}\n");
        buf_write_fd(out, STDERR);
        exit(1)
    }
}

// ---- Lines ----

#[inline]
pub fn is_space(c: u8) -> bool {
    c == ' ' || c == '\t'
}

// Whether bytes [a, b) of the text spell `word`.
// (0.17: compared byte by byte, stopping at the first difference, without
// strlen and memcmp: the assembler asks it of every directive and operand
// against many words, a tenth of -O0)
pub fn text_is(cx: sink *FnCtx, a: i64, b: i64, word: *u8) -> bool {
    unsafe {
        let t = ATEXT;
        let n = b - a;
        for i in 0..n {
            let c = word[i];
            if c == 0 || c != t[a + i] {
                return false;
            }
        }
        word[n] == 0
    }
}

// The operands of the statement being assembled: [OP_START[i], OP_END[i])
// of the text, split at commas outside brackets and parentheses.
pub static var OP_START: [i64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
pub static var OP_END: [i64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
pub static var OP_COUNT: i64 = 0;

// (0.25) Each byte's class for split_operands: 1 a comma, 2 an opening
// bracket or parenthesis, 3 a closing one, 0 any other (one test a byte).
static var OP_CLASS: [u8; 256] = [0; 256];

fn split_operands(cx: sink *FnCtx, a: i64, b: i64) {
    unsafe {
        let t = ATEXT;
        var count = 0;
        var i = a;
        while i < b {
            while i < b && is_space(t[i]) {
                i += 1;
            }
            if i >= b {
                break;
            }
            let start = i;
            var depth = 0;
            while i < b {
                let k = OP_CLASS[t[i] as i64];
                if k != 0 {
                    if k == 1 {
                        if depth == 0 {
                            break;
                        }
                    } else if k == 2 {
                        depth += 1;
                    } else {
                        depth -= 1;
                    }
                }
                i += 1;
            }
            var end = i;
            while end > start && is_space(t[end - 1]) {
                end -= 1;
            }
            if count == 8 {
                OP_COUNT = count;
                asm_error(cx, c"too many operands");
            }
            OP_START[count] = start;
            OP_END[count] = end;
            count += 1;
            i += 1;
        }
        OP_COUNT = count;
    }
}

// A number at [a, b): decimal or 0x hex, maybe negative.
pub fn parse_number(cx: sink *FnCtx, a: i64, b: i64) -> i64 {
    unsafe {
        let t = ATEXT;
        var i = a;
        var neg = false;
        if i < b && t[i] == '-' {
            neg = true;
            i += 1;
        }
        var v: u64 = 0;
        if i + 1 < b && t[i] == '0' && (t[i + 1] == 'x' || t[i + 1] == 'X') {
            i += 2;
            while i < b {
                let c = t[i];
                let d = if c >= '0' && c <= '9' { (c - '0') as u64 }
                    else if c >= 'a' && c <= 'f' { (c - 'a') as u64 + 10 }
                    else if c >= 'A' && c <= 'F' { (c - 'A') as u64 + 10 }
                    else { asm_error(cx, c"bad number") };
                v = v * 16 + d;
                i += 1;
            }
        } else {
            if i >= b {
                asm_error(cx, c"bad number");
            }
            while i < b {
                let c = t[i];
                if c < '0' || c > '9' {
                    asm_error(cx, c"bad number");
                }
                v = v * 10 + (c - '0') as u64;
                i += 1;
            }
        }
        if neg { 0 - v as i64 } else { v as i64 }
    }
}

pub fn is_digit_start(c: u8) -> bool {
    (c >= '0' && c <= '9') || c == '-'
}

// A data value: a number, a symbol, or `A - B` (two labels).
fn data_value(cx: sink *FnCtx, a: i64, b: i64, size: i64) {
    unsafe {
        let t = ATEXT;
        if is_digit_start(t[a]) {
            if size == 4 { out32(parse_number(cx, a, b)); } else { out64(parse_number(cx, a, b)); }
            return;
        }
        var minus = a;
        while minus < b && t[minus] != '-' {
            minus += 1;
        }
        if minus < b {
            var e1 = minus;
            while e1 > a && is_space(t[e1 - 1]) {
                e1 -= 1;
            }
            var s2 = minus + 1;
            while s2 < b && is_space(t[s2]) {
                s2 += 1;
            }
            if size != 4 {
                asm_error(cx, c"a difference of labels must be a .long");
            }
            let s1 = asym(t[a..e1]);
            let s2sym = asym(t[s2..b]);
            fixup(FX_DIFF32, here(), s1, 0, 0, false);
            FIXUPS[FIXUP_COUNT - 1].sym2 = s2sym;
            out32(0);
            return;
        }
        if size == 4 {
            // (0.11) A 32-bit reference: the offset of a debug section (ELF).
            fixup(FX_ABS32, here(), asym(t[a..b]), 0, 0, false);
            out32(0);
            return;
        }
        fixup(FX_ABS64, here(), asym(t[a..b]), 0, 0, false);
        out64(0);
    }
}

// ---- AArch64 ELF mapping symbols ----
//
// The AArch64 ELF ABI marks where code ($x) and data ($d) start in a
// section, as GNU as does (disassemblers show data in code, such as jump
// tables, as data): (section, fragment, offset, kind) for each change.

// Whether the object has mapping symbols (AArch64 ELF).
pub static var MAPPING: bool = false;
// Whether an instruction may need more than its encoding: mapping symbols
// or `.loc`s (one test on the common path).
pub static var HOOKS: bool = false;
pub const MAP_CODE: i64 = 1;
const MAP_DATA: i64 = 2;
static var MAP_STATE: [i64; 8] = [0; 8];
pub static var MAPS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn mapping(kind: i64) {
    unsafe {
        if MAP_STATE[CUR_SEC] == kind || is_debug(CUR_SEC) {
            return;
        }
        MAP_STATE[CUR_SEC] = kind;
        MAPS.push(CUR_SEC);
        MAPS.push(OPEN);
        MAPS.push(here() - FRAGS[OPEN].start);
        MAPS.push(kind);
    }
}

fn directive(cx: sink *FnCtx, a: i64, b: i64, rest: i64, end: i64) {
    unsafe {
        let t = ATEXT;
        if text_is(cx, a, b, c".byte") {
            if MAPPING {
                mapping(MAP_DATA);
            }
            var i = rest;
            while i < end {
                var v = 0;
                while i < end && t[i] >= '0' && t[i] <= '9' {
                    v = v * 10 + (t[i] - '0') as i64;
                    i += 1;
                }
                out8(v);
                while i < end && (t[i] == ',' || is_space(t[i])) {
                    i += 1;
                }
            }
            return;
        }
        if text_is(cx, a, b, c".vole_data") {
            // (0.25) bytes of RAW (mod.vl): `.vole_data OFFSET, LENGTH`
            if MAPPING {
                mapping(MAP_DATA);
            }
            split_operands(cx, rest, end);
            if OP_COUNT != 2 {
                asm_error(cx, c"bad .vole_data");
            }
            let at = parse_number(cx, OP_START[0], OP_END[0]);
            let n = parse_number(cx, OP_START[1], OP_END[1]);
            if at < 0 || n < 0 || at + n > RAW.len {
                asm_error(cx, c"bad .vole_data");
            }
            obj_reserve(n);
            memcpy(&OBJ.data[OBJ.len], &RAW.data[at], n as u64);
            OBJ.len += n;
            return;
        }
        if text_is(cx, a, b, c".long") || text_is(cx, a, b, c".quad") {
            if MAPPING {
                mapping(MAP_DATA);
            }
            split_operands(cx, rest, end);
            for k in 0..OP_COUNT {
                data_value(cx, OP_START[k], OP_END[k], if t[b - 1] == 'g' { 4 } else { 8 });
            }
            return;
        }
        if text_is(cx, a, b, c".p2align") {
            let n = parse_number(cx, rest, end);
            if n > SEC_ALIGN[CUR_SEC] {
                SEC_ALIGN[CUR_SEC] = n;
            }
            if n > 0 {
                end_frag(TAIL_ALIGN, n, -1);
            }
            return;
        }
        if text_is(cx, a, b, c".space") {
            if MAPPING {
                mapping(MAP_DATA);
            }
            let n = parse_number(cx, rest, end);
            obj_reserve(n);
            memset(&OBJ.data[OBJ.len], 0, n as u64);
            OBJ.len += n;
            return;
        }
        if text_is(cx, a, b, c".globl") {
            let s = asym(t[rest..end]);
            ASYMS[s].global = true;
            return;
        }
        if text_is(cx, a, b, c".text") {
            switch_section(SEC_TEXT);
            return;
        }
        if text_is(cx, a, b, c".data") {
            switch_section(SEC_DATA);
            return;
        }
        if text_is(cx, a, b, c".section") {
            if text_is(cx, rest, end, c"__TEXT,__text") {
                switch_section(SEC_TEXT);
            }
            else if text_is(cx, rest, end, c"__TEXT,__const")
                || text_is(cx, rest, end, c".rodata") {
                switch_section(SEC_CONST);
            } else if text_is(cx, rest, end, c"__DATA,__data") {
                switch_section(SEC_DATA);
            } else if end - rest > 15 && text_is(cx, rest, rest + 15, c".note.GNU-stack") {
                switch_section(SEC_NOTE);
            }
            else if text_is(cx, rest, end, c"__DWARF,__debug_abbrev,regular,debug")
                || text_is(cx, rest, end, c".debug_abbrev,\"\",@progbits") {
                switch_section(SEC_DEBUG_ABBREV);
            }
            else if text_is(cx, rest, end, c"__DWARF,__debug_info,regular,debug")
                || text_is(cx, rest, end, c".debug_info,\"\",@progbits") {
                switch_section(SEC_DEBUG_INFO);
            }
            else if text_is(cx, rest, end, c"__DWARF,__debug_line,regular,debug")
                || text_is(cx, rest, end, c".debug_line,\"\",@progbits") {
                switch_section(SEC_DEBUG_LINE);
            } else {
                asm_error(cx, c"unknown section");
            }
            return;
        }
        // (0.19: the instruction sets the system assemblers need named,
        // mc_arm64/arch.vl; this one knows them all)
        if text_is(cx, a, b, c".arch_extension") || text_is(cx, a, b, c".arch") {
            return;
        }
        if text_is(cx, a, b, c".loc") {
            split_operands(cx, rest, end);
            // .loc file line column
            var fields: [i64; 3] = [0, 0, 0];
            var k = 0;
            var i = rest;
            while i < end && k < 3 {
                while i < end && is_space(t[i]) {
                    i += 1;
                }
                let start = i;
                while i < end && !is_space(t[i]) {
                    i += 1;
                }
                fields[k] = parse_number(cx, start, i);
                k += 1;
            }
            LOC_FILE = fields[0];
            LOC_LINE = fields[1];
            LOC_COL = fields[2];
            LOC_PENDING = true;
            HOOKS = true;
            return;
        }
        if text_is(cx, a, b, c".file") {
            dwarf_file(cx, rest, end);
            return;
        }
        if end - rest >= 0 && b - a > 5 && text_is(cx, a, a + 5, c".cfi_") {
            cfi_directive(cx, a, b);
            return;
        }
        asm_error(cx, c"unknown directive");
    }
}

fn label(cx: sink *FnCtx, a: i64, b: i64) {
    unsafe {
        let s = asym(ATEXT[a..b]);
        if ASYMS[s].defined {
            asm_error(cx, c"label defined twice");
        }
        ASYMS[s].defined = true;
        ASYMS[s].frag = OPEN;
        ASYMS[s].off = here() - FRAGS[OPEN].start;
        ASYMS[s].sec = CUR_SEC;
        if !is_temp(s) {
            CUR_ATOM[CUR_SEC] = s;
        }
        ASYMS[s].atom = CUR_ATOM[CUR_SEC];
    }
}

// ---- Lines assembled before (0.25) ----
//
// An instruction that names no symbol (`ldr x0, [x29, #-24]`, `sub sp,
// sp, #16`) assembles to the same bytes wherever it is. Its bytes are kept
// by its text, and a line spelling it again is copied, not parsed and
// encoded: 87% of the lines of the compiler's -O0 code (fewer than 8000
// distinct ones), half of its -O2 code. An instruction is kept when its
// encoding asked for no symbol and made no fixup and no fragment.

struct Memo { hash: u64, text: i64, len: i64, code: i64, code2: i64, size: i64 }

static var MEMOS: *Memo = 0 as *Memo;
static var MEMO_COUNT: i64 = 0;
static var MEMO_CAP: i64 = 0;
// Memo + 1 by hash (open addressing).
static var MEMO_TABLE: *i64 = 0 as *i64;
static var MEMO_SIZE: i64 = 0;
// The lines' text.
static var MEMO_TEXT: ObjBytes = ObjBytes { data: 0 as *u8, len: 0, cap: 0 };
// The hash of the line memo_find was last asked.
static var MEMO_HASH: u64 = 0;
// (bounds the memory a program of only distinct lines takes)
const MEMO_LIMIT: i64 = 1 << 20;

// The state before an object's first line: no line known, the bytes'
// classes for split_operands.
pub fn assemble_begin() {
    unsafe {
        OP_CLASS[',' as i64] = 1;
        OP_CLASS['[' as i64] = 2;
        OP_CLASS['(' as i64] = 2;
        OP_CLASS['{' as i64] = 2;
        OP_CLASS[']' as i64] = 3;
        OP_CLASS[')' as i64] = 3;
        OP_CLASS['}' as i64] = 3;
        free(MEMO_TABLE as *u8);
        MEMO_TABLE = 0 as *i64;
        MEMO_SIZE = 0;
        MEMO_COUNT = 0;
        MEMO_TEXT.len = 0;
    }
}

// The memo of line [a, b) of t, or -1 (MEMO_HASH: the line's hash).
fn memo_find(t: *u8, a: i64, b: i64) -> i64 {
    unsafe {
        let h = hash_bytes(&t[a], b - a);
        MEMO_HASH = h;
        if MEMO_SIZE == 0 {
            return -1;
        }
        let n = b - a;
        let mask = (MEMO_SIZE - 1) as u64;
        var slot = h & mask;
        while MEMO_TABLE[slot] != 0 {
            let m = MEMO_TABLE[slot] - 1;
            if MEMOS[m].hash == h && MEMOS[m].len == n
                && memcmp(&MEMO_TEXT.data[MEMOS[m].text], &t[a], n as u64) == 0 {
                return m;
            }
            slot = (slot + 1) & mask;
        }
        -1
    }
}

// Keeps line [a, b) of t (hash MEMO_HASH), assembled to OBJ's bytes from
// `start` on.
fn memo_add(t: *u8, a: i64, b: i64, start: i64) {
    unsafe {
        let size = OBJ.len - start;
        if size < 1 || size > 16 || MEMO_COUNT >= MEMO_LIMIT {
            return;
        }
        if (MEMO_COUNT + 1) * 2 > MEMO_SIZE {
            memo_rehash();
        }
        var code: [i64; 2] = [0, 0];
        for k in 0..size {
            code[k / 8] = code[k / 8] | (OBJ.data[start + k] as i64) << (k % 8 * 8);
        }
        let text = bytes_append(&MEMO_TEXT, t[a..b]);
        MEMOS = grow(MEMOS, MEMO_COUNT, &MEMO_CAP);
        MEMOS[MEMO_COUNT] = Memo {
            hash: MEMO_HASH, text, len: b - a, code: code[0], code2: code[1], size
        };
        let mask = (MEMO_SIZE - 1) as u64;
        var slot = MEMO_HASH & mask;
        while MEMO_TABLE[slot] != 0 {
            slot = (slot + 1) & mask;
        }
        MEMO_TABLE[slot] = MEMO_COUNT + 1;
        MEMO_COUNT += 1;
    }
}

// MEMO_TABLE twice as large.
fn memo_rehash() {
    unsafe {
        let size = if MEMO_SIZE == 0 { 4096 } else { MEMO_SIZE * 2 };
        free(MEMO_TABLE as *u8);
        MEMO_TABLE = alloc_array::<i64>(size);
        MEMO_SIZE = size;
        let mask = (size - 1) as u64;
        for m in 0..MEMO_COUNT {
            var slot = MEMOS[m].hash & mask;
            while MEMO_TABLE[slot] != 0 {
                slot = (slot + 1) & mask;
            }
            MEMO_TABLE[slot] = m + 1;
        }
    }
}

// Writes memo m's bytes.
fn memo_out(m: i64) {
    unsafe {
        let size = MEMOS[m].size;
        if size == 4 {
            out32(MEMOS[m].code);
            return;
        }
        obj_reserve(size);
        for k in 0..size {
            let word = if k < 8 { MEMOS[m].code } else { MEMOS[m].code2 };
            OBJ.data[OBJ.len + k] = ((word >> (k % 8 * 8)) & 255) as u8;
        }
        OBJ.len += size;
    }
}

pub fn assemble_line(cx: sink *FnCtx, a: i64, b: i64) {
    unsafe {
        let t = ATEXT;
        var i = a;
        while i < b && is_space(t[i]) {
            i += 1;
        }
        var e = b;
        while e > i && is_space(t[e - 1]) {
            e -= 1;
        }
        if i >= e {
            return;
        }
        LINE_START = i;
        LINE_END = e;
        // (0.25) an instruction assembled before: its bytes
        let memo = t[i] != '.' && t[e - 1] != ':';
        if memo {
            let m = memo_find(t, i, e);
            if m >= 0 {
                if HOOKS {
                    if LOC_PENDING {
                        line_row();
                    }
                    if MAPPING {
                        mapping(MAP_CODE);
                    }
                }
                memo_out(m);
                return;
            }
        }
        var w = i;
        while w < e && !is_space(t[w]) {
            w += 1;
        }
        if w == e && t[e - 1] == ':' {
            label(cx, i, e - 1);
            return;
        }
        var r = w;
        while r < e && is_space(t[r]) {
            r += 1;
        }
        if t[i] == '.' {
            directive(cx, i, w, r, e);
            return;
        }
        split_operands(cx, r, e);
        if HOOKS {
            // (a row of the line table, a mapping symbol)
            if LOC_PENDING {
                line_row();
            }
            if MAPPING {
                mapping(MAP_CODE);
            }
        }
        let lookups = ASYM_LOOKUPS;
        let fixups = FIXUP_COUNT;
        let frags = FRAG_COUNT;
        let start = OBJ.len;
        if X86 {
            x86_instruction(cx, i, w);
        } else {
            a64_instruction(cx, i, w);
        }
        if memo && ASYM_LOOKUPS == lookups && FIXUP_COUNT == fixups && FRAG_COUNT == frags {
            memo_add(t, i, e, start);
        }
    }
}
