// What write_output adds around the object (0.16): the C module's symbols
// spelled for assemblers (c_module_symbols), and the link: the command
// that makes the executable (link_command), with what the command line
// added for it (`-l NAME`, `-L DIR`, objects, archives, shared libraries,
// C files) and C's math library when the program calls into it.

use crate::back::dwarf::DEBUG_INFO;
use crate::back::objfile::{ASYMS, ASYM_COUNT};
use crate::base::{BUFS, IntVec, buf_byte, buf_fmt, buf_new, buf_str, strlen};
use crate::base::target::{ELF, X86};
use crate::front::modules::C_MODULE;
use crate::middle::ctx::FnCtx;
use crate::middle::opt::OPT_LEVEL;

extern "C" {
    fn getenv(name: *u8) -> *u8;
}

// ---- The C module's symbols ----

// The functions of the C module (an impl's methods on a C type, generic
// instances at C types: `id.GN9<c>.div_t`) have `<c>`, its name, in their
// symbols, which no assembler takes. It is spelled `0c_` (as long, and no
// module's name: a name does not start with a digit) in the text, before
// it is written (-S) or assembled: the object and `cc` of the text agree.
pub fn c_module_symbols(cx: sink *FnCtx) {
    unsafe {
        if C_MODULE < 0 {
            return;
        }
        let text = BUFS[cx.asm].data;
        let n = BUFS[cx.asm].len;
        var i = 0;
        while i + 2 < n {
            if text[i] == '<' && text[i + 1] == 'c' && text[i + 2] == '>' {
                text[i] = '0';
                text[i + 2] = '_';
                i += 3;
            } else {
                i += 1;
            }
        }
    }
}

// ---- The link ----

// What the command line added for the link, in its order: a kind ('l':
// `-l NAME`, 'L': `-L DIR`, ' ': an input) then the text, two words each.
static var LINK_ARGS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The -I directories, for the C files.
static var LINK_INCLUDES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Whether a C file is among the inputs.
static var LINK_C: bool = false;

// Whether path ends with suffix.
unsafe fn ends_with(path: *u8, suffix: *u8) -> bool {
    let n = strlen(path) as i64;
    let k = strlen(suffix) as i64;
    if n <= k {
        return false;
    }
    for i in 0..k {
        if path[n - k + i] != suffix[i] {
            return false;
        }
    }
    true
}

// Whether a command-line input is for the link (an object, an archive, a
// shared library, a C file) rather than vole source.
pub fn is_link_input(path: *u8) -> bool {
    unsafe {
        ends_with(path, c".o") || ends_with(path, c".a") || ends_with(path, c".c")
            || ends_with(path, c".so") || ends_with(path, c".dylib")
    }
}

// Adds `-l NAME` (kind 'l'), `-L DIR` ('L') or an input (' ') to the link.
pub fn add_link_arg(kind: u8, text: *u8) {
    unsafe {
        LINK_ARGS.push(kind as i64);
        LINK_ARGS.push(text as i64);
        if kind == ' ' && ends_with(text, c".c") {
            LINK_C = true;
        }
    }
}

// Adds an -I directory (the C headers' search path is the C files' too).
pub fn add_link_include(dir: *u8) {
    unsafe {
        LINK_INCLUDES.push(dir as i64);
    }
}

// Whether the command line added anything for the link.
pub fn link_args_given() -> bool {
    unsafe { LINK_ARGS.count > 0 }
}

// s, quoted for the shell.
fn quoted(b: i64, s: *u8) {
    unsafe {
        buf_byte(b, '\'');
        var i = 0;
        while s[i] != 0 {
            if s[i] == '\'' {
                buf_str(b, c"'\\''");
            } else {
                buf_byte(b, s[i]);
            }
            i += 1;
        }
        buf_byte(b, '\'');
    }
}

// Whether the program calls a function of C's math library (a symbol it
// refers to and does not define, by its name; an `f` or `l` at the end:
// the float and long double forms).
fn uses_libm() -> bool {
    let all = [
        "acos", "asin", "atan", "atan2", "cos", "sin", "tan", "acosh", "asinh", "atanh", "cosh",
        "sinh", "tanh", "exp", "exp2", "expm1", "log", "log10", "log1p", "log2", "logb", "ilogb",
        "pow", "sqrt", "cbrt", "hypot", "erf", "erfc", "tgamma", "lgamma", "ceil", "floor",
        "trunc", "round", "lround", "llround", "rint", "lrint", "llrint", "nearbyint", "fmod",
        "remainder", "remquo", "copysign", "nan", "nextafter", "nexttoward", "fdim", "fmax",
        "fmin", "fma", "fabs", "frexp", "ldexp", "modf", "scalbn", "scalbln", "sincos",
    ];
    let names = all[..];
    unsafe {
        for s in 0..ASYM_COUNT {
            if ASYMS[s].defined {
                continue;
            }
            var name = ASYMS[s].text;
            if !ELF {
                if name.len == 0 || name[0] != '_' {
                    continue;
                }
                name = name[1..name.len];
            }
            if name.len == 0 {
                continue;
            }
            let last = name[name.len - 1];
            let base = if last == 'f' || last == 'l' { name[0..name.len - 1] } else { name };
            for i in 0..names.len {
                if names[i] == name || names[i] == base {
                    return true;
                }
            }
        }
        false
    }
}

// (0.18.1) Whether the program calls pthread_create (a symbol it refers to
// and does not define): glibc before 2.34 has it in libpthread, which is
// linked then (the compiler's own threads, middle::threads).
fn uses_pthreads() -> bool {
    unsafe {
        for s in 0..ASYM_COUNT {
            if !ASYMS[s].defined && ASYMS[s].text == "pthread_create" {
                return true;
            }
        }
        false
    }
}

// The command linking the program's object obj_path into executable path:
// cc (or $VOLE_CC), the command line's link arguments in their order
// (C files compiled at the program's -O level, with its -I directories
// and -g), then libm on Linux when the program or a C file may call it
// (Linux links it only when asked; on macOS it is part of libSystem).
pub fn link_command(path: *u8, obj_path: *u8) -> *u8 {
    unsafe {
        let cmd = buf_new();
        let cc = getenv(c"VOLE_CC");
        buf_str(cmd, if cc != 0 as *u8 && cc[0] != 0 { cc } else { c"cc" });
        if !ELF {
            buf_str(cmd, if X86 { c" -arch x86_64" } else { c" -arch arm64" });
        }
        if LINK_C {
            buf_str(cmd, c" -O");
            buf_byte(cmd, ('0' as i64 + OPT_LEVEL) as u8);
            if DEBUG_INFO {
                buf_str(cmd, c" -g");
            }
            for i in 0..LINK_INCLUDES.count {
                buf_str(cmd, c" -I");
                quoted(cmd, LINK_INCLUDES.data[i] as *u8);
            }
        }
        buf_str(cmd, c" -o ");
        quoted(cmd, path);
        buf_byte(cmd, ' ');
        quoted(cmd, obj_path);
        var i = 0;
        while i < LINK_ARGS.count {
            let kind = LINK_ARGS.data[i] as u8;
            buf_byte(cmd, ' ');
            if kind != ' ' {
                buf_fmt(cmd, f"-{kind:c}");
            }
            quoted(cmd, LINK_ARGS.data[i + 1] as *u8);
            i += 2;
        }
        if ELF && (LINK_C || uses_libm()) {
            buf_str(cmd, c" -lm");
        }
        if ELF && uses_pthreads() {
            buf_str(cmd, c" -lpthread");
        }
        buf_byte(cmd, 0);
        BUFS[cmd].data
    }
}
