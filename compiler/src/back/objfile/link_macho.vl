    c"execve", c"execvp", c"exit", c"exp", c"exp2", c"exp2f", c"expf", c"expm1", c"expm1f", c"fabs",
    c"fabsf", c"fchmod", c"fchown", c"fclose", c"fcntl", c"fdim", c"fdimf", c"fdopen", c"feof",
