// The compiler's own Mach-O linker (0.25, `--linker=internal`): the
// executable of a program that is the compiler's one AArch64 object and
// libSystem, made without ld (whose fixed cost, reading libSystem's
// stubs, is most of a small program's link).
//
// What it takes: an object of __TEXT,__text, __TEXT,__const and
// __DATA,__data, as write_object makes it without -g; relocations
// BRANCH26, PAGE21, PAGEOFF12 and GOT_LOAD_* in the text, 64-bit UNSIGNED
// in the data; undefined symbols that libSystem has (LIBSYSTEM, below:
// another one is linked by ld, which says whether it exists). Anything
// else, and link_macho says no and the system's linker links.
//
// What it makes, as ld64 lays it out: __PAGEZERO; __TEXT (the header and
// load commands, __text, __stubs, __const); __DATA_CONST (__got);
// __DATA (__data); __LINKEDIT (the chained fixups, the exports trie, the
// symbol table, the indirect symbols, the strings and the code
// signature). A call to libSystem goes through a stub and its GOT slot,
// bound by dyld from the chained fixups (DYLD_CHAINED_PTR_64); a pointer
// in the data is a rebase in the same chains. The signature is ad hoc,
// SHA-256 over 4 KB pages, as `ld` signs ("linker-signed"); the UUID is
// a hash of the page hashes, so the same input gives the same file.

use crate::back::objfile::align_up;
use crate::back::objfile::output::read_into;
use crate::base::{
    BUFS, IntVec, alloc_array, alloc_zeroed, buf_new, fclose, fopen, fwrite, memcpy, streq, strlen,
};
use crate::base::target::{ELF, X86};
use std::arch::detect;
use std::arch::aarch64::{
    vaddq_u32, vld1q_u32, vld1q_u8, vreinterpretq_u32_u8, vrev32q_u8, vsha256h2q_u32, vsha256hq_u32,
    vsha256su0q_u32, vsha256su1q_u32, vst1q_u32,
};

extern "C" {
    fn chmod(path: *u8, mode: i32) -> i32;
    fn rename(from: *u8, to: *u8) -> i32;
    fn unlink(path: *u8) -> i32;
    fn getpid() -> i32;
}

// The functions and data libSystem has on every macOS from 12 (the
// externs of compiler/std and compiler/src, those of the tests and
// examples, libm's and the rest of the C library's common ones), without
// the leading underscore, sorted. An import
// of another name goes to ld. (tests/link/run.sh checks that libSystem
// has each.)
const LIBSYSTEM: [*u8; 402] = [
    c"_NSGetArgc", c"_NSGetArgv", c"__error", c"__stderrp", c"__stdinp", c"__stdoutp",
    c"__ulock_wait", c"__ulock_wake", c"_exit", c"_longjmp", c"_setjmp", c"abort", c"abs",
    c"accept", c"access", c"acos", c"acosf", c"acosh", c"acoshf", c"alarm", c"aligned_alloc",
    c"arc4random", c"arc4random_buf", c"arc4random_uniform", c"asin", c"asinf", c"asinh", c"asinhf",
    c"atan", c"atan2", c"atan2f", c"atanf", c"atanh", c"atanhf", c"atexit", c"atof", c"atoi",
    c"atol", c"basename", c"bind", c"bsearch", c"bzero", c"calloc", c"cbrt", c"cbrtf", c"ceil",
    c"ceilf", c"cfmakeraw", c"chdir", c"chmod", c"chown", c"clock", c"clock_getres",
    c"clock_gettime", c"close", c"closedir", c"confstr", c"connect", c"copysign", c"copysignf",
