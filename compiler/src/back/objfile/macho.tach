// The Mach-O writer (macOS, both instruction sets): the header, one
// segment of the present sections, their relocations, and the symbol and
// string tables.

use crate::back::objfile::{
    ASYMS, ASYM_COUNT, FRAGS, RELOCS, RELOC_COUNT, SEC_ADDR, SEC_ALIGN, SEC_BUF, SEC_CONST,
    SEC_COUNT, SEC_DATA, SEC_DEBUG_ABBREV, SEC_DEBUG_INFO, SEC_DEBUG_LINE, SEC_NOTE, SEC_TEXT,
    SEC_UNWIND, SEC_USED, align_up, asym, is_debug, is_temp, pad_to, sym_addr, w16, w32, w64, w8,
    wname16,
};
use crate::base::{BUFS, IntVec, buf_bytes, buf_fmt, buf_new, buf_slice, buf_write_file};
use crate::base::target::X86;

// A section's Mach-O names: its section and its segment.
fn macho_sectname(sec: i64) -> *u8 {
    if sec == SEC_TEXT { c"__text" } else if sec == SEC_CONST { c"__const" }
    else if sec == SEC_DATA { c"__data" } else if sec == SEC_DEBUG_ABBREV { c"__debug_abbrev" }
    else if sec == SEC_DEBUG_INFO { c"__debug_info" }
    else if sec == SEC_DEBUG_LINE { c"__debug_line" } else { c"__compact_unwind" }
}

fn macho_segname(sec: i64) -> *u8 {
    if sec == SEC_DATA { c"__DATA" } else if is_debug(sec) { c"__DWARF" }
    else if sec == SEC_UNWIND { c"__LD" } else { c"__TEXT" }
}

pub fn macho_write(path: *u8) {
    unsafe {
        // Sections present: text always, the others when used.
        let mut ord: [i64; 8] = [0; 8];
        let mut secs: [i64; 8] = [0; 8];
        let mut nsect = 0;
        for sec in 0..SEC_COUNT {
            if sec != SEC_NOTE && (sec == SEC_TEXT || BUFS[SEC_BUF[sec]].len > 0 || SEC_USED[sec]) {
                secs[nsect] = sec;
                nsect += 1;
                ord[sec] = nsect;
            }
        }
        let mut vm = 0;
        for k in 0..nsect {
            let sec = secs[k];
            vm = align_up(vm, 1 << SEC_ALIGN[sec]);
            SEC_ADDR[sec] = vm;
            vm += BUFS[SEC_BUF[sec]].len;
        }
        // On AArch64 LLVM marks the start of every section (but the debug
        // ones) with a local symbol (ltmp0, ltmp1, ...): the linker keeps a
        // section, even an empty one, by its symbols. The same here.
        if !X86 {
            let mut number = 0;
            for k in 0..nsect {
                let sec = secs[k];
                if is_debug(sec) {
                    continue;
                }
                let name = buf_new();
                buf_fmt(name, f"ltmp{number}");
                number += 1;
                let s = asym(buf_slice(name));
                let mut first = 0;
                while FRAGS[first].sec != sec {
                    first += 1;
                }
                ASYMS[s].defined = true;
                ASYMS[s].sec = sec;
                ASYMS[s].frag = first;
                ASYMS[s].off = 0;
            }
        }
        // Symbols: locals (labels that are not temporary, and temporaries a
        // relocation needs), then defined globals, then undefined ones.
        let mut order = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for pass in 0..3 {
            for s in 0..ASYM_COUNT {
                let def = ASYMS[s].defined;
                let local = def && !ASYMS[s].global && (!is_temp(s) || ASYMS[s].in_table);
                let ext = def && ASYMS[s].global;
                let undef = !def && (ASYMS[s].in_table || ASYMS[s].global);
                if (pass == 0 && local) || (pass == 1 && ext) || (pass == 2 && undef) {
                    ASYMS[s].index = order.count;
                    order.push(s);
                }
            }
        }
        let mut nlocal = 0;
        let mut next = 0;
        for s in order.items() {
            if ASYMS[s].defined && !ASYMS[s].global {
                nlocal += 1;
            } else if ASYMS[s].defined {
                next += 1;
            }
        }
        let nundef = order.count - nlocal - next;
        // Relocations per section.
        let ncmds = 4;
        let seg_size = 72 + 80 * nsect;
        let cmds_size = seg_size + 24 + 24 + 80;
        // The contents mirror the addresses, as LLVM lays them out (0.11:
        // aligned in the file as in memory, so that the segment's size in
        // the file is its size in memory, which dsymutil checks).
        let mut sec_off: [i64; 8] = [0; 8];
        for k in 0..nsect {
            let sec = secs[k];
            sec_off[sec] = 32 + cmds_size + SEC_ADDR[sec];
        }
        let content_end = 32 + cmds_size + vm;
        let mut off = content_end;
        off = align_up(off, 8);
        let mut rel_off: [i64; 8] = [0; 8];
        let mut rel_n: [i64; 8] = [0; 8];
        for k in 0..nsect {
            let sec = secs[k];
            rel_off[sec] = off;
            for r in 0..RELOC_COUNT {
                if RELOCS[r].sec == sec {
                    rel_n[sec] += 1;
                }
            }
            off += 8 * rel_n[sec];
        }
        let sym_off = off;
        off += 16 * order.count;
        let str_off = off;
        let strs = buf_new();
        w8(strs, 0);
        let mut strx = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..order.count {
            strx.push(BUFS[strs].len);
            buf_bytes(strs, ASYMS[order.data[i]].text);
            w8(strs, 0);
        }
        pad_to(strs, align_up(BUFS[strs].len, 8));
        let out = buf_new();
        // Header.
        w32(out, 0xfeedfacf);
        w32(out, if X86 { 0x01000007 } else { 0x0100000c });
        w32(out, if X86 { 3 } else { 0 });
        w32(out, 1);
        w32(out, ncmds);
        w32(out, cmds_size);
        w32(out, 0);
        w32(out, 0);
        // The segment and its sections.
        w32(out, 0x19);
        w32(out, seg_size);
        wname16(out, c"");
        w64(out, 0);
        w64(out, vm);
        w64(out, 32 + cmds_size);
        w64(out, content_end - (32 + cmds_size));
        w32(out, 7);
        w32(out, 7);
        w32(out, nsect);
        w32(out, 0);
        for k in 0..nsect {
            let sec = secs[k];
            wname16(out, macho_sectname(sec));
            wname16(out, macho_segname(sec));
            w64(out, SEC_ADDR[sec]);
            w64(out, BUFS[SEC_BUF[sec]].len);
            w32(out, sec_off[sec]);
            w32(out, SEC_ALIGN[sec]);
            w32(out, if rel_n[sec] > 0 { rel_off[sec] } else { 0 });
            w32(out, rel_n[sec]);
            w32(out,
                if sec == SEC_TEXT { 0x80000400 }
                else if is_debug(sec) || sec == SEC_UNWIND { 0x02000000 } else { 0 });
            w32(out, 0);
            w32(out, 0);
            w32(out, 0);
        }
        // LC_BUILD_VERSION: macOS 11.0 (arm64) or 10.13 (x86-64).
        w32(out, 0x32);
        w32(out, 24);
        w32(out, 1);
        w32(out, if X86 { 0x000a0d00 } else { 0x000b0000 });
        w32(out, 0);
        w32(out, 0);
        // LC_SYMTAB.
        w32(out, 2);
        w32(out, 24);
        w32(out, sym_off);
        w32(out, order.count);
        w32(out, str_off);
        w32(out, BUFS[strs].len);
        // LC_DYSYMTAB.
        w32(out, 0xb);
        w32(out, 80);
        w32(out, 0);
        w32(out, nlocal);
        w32(out, nlocal);
        w32(out, next);
        w32(out, nlocal + next);
        w32(out, nundef);
        for i in 0..12 {
            w32(out, 0);
        }
        // Contents (a section-relative relocation holds the address in the
        // object's address space: its section's address added).
        for k in 0..nsect {
            let sec = secs[k];
            pad_to(out, sec_off[sec]);
            let start = BUFS[out].len;
            buf_bytes(out, buf_slice(SEC_BUF[sec]));
            if !is_debug(sec) && sec != SEC_UNWIND {
                continue;
            }
            for r in 0..RELOC_COUNT {
                if RELOCS[r].sec == sec && RELOCS[r].sym < 0 {
                    let at = start + RELOCS[r].offset;
                    let target = SEC_ADDR[-1 - RELOCS[r].sym] + RELOCS[r].addend;
                    for i in 0..8 {
                        BUFS[out].data[at + i] = ((target >> (8 * i)) & 255) as u8;
                    }
                }
            }
        }
        pad_to(out, align_up(BUFS[out].len, 8));
        for k in 0..nsect {
            let sec = secs[k];
            pad_to(out, rel_off[sec]);
            for r in 0..RELOC_COUNT {
                if RELOCS[r].sec == sec {
                    let rl = RELOCS[r];
                    w32(out, rl.offset);
                    let pcrel = if rl.pcrel { 1 } else { 0 };
                    if rl.sym < 0 {
                        w32(out, ord[-1 - rl.sym] | pcrel << 24 | rl.length << 25 | rl.rtype << 28);
                    } else {
                        w32(out,
                            ASYMS[rl.sym].index | pcrel << 24 | rl.length << 25 | 1 << 27
                                | rl.rtype << 28);
                    }
                }
            }
        }
        pad_to(out, sym_off);
        for i in 0..order.count {
            let s = order.data[i];
            w32(out, strx.data[i]);
            if ASYMS[s].defined {
                w8(out, if ASYMS[s].global { 0x0f } else { 0x0e });
                w8(out, ord[ASYMS[s].sec]);
                w16(out, 0);
                w64(out, SEC_ADDR[ASYMS[s].sec] + sym_addr(s));
            } else {
                w8(out, 0x01);
                w8(out, 0);
                w16(out, 0);
                w64(out, 0);
            }
        }
        buf_bytes(out, buf_slice(strs));
        buf_write_file(out, path);
    }
}
