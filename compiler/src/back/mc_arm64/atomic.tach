// (0.21) AArch64 atomics (docs/design/concurrency.md §4.3): the standard
// mappings, LSE (cas, swp, ldadd...) where the target has it (always on
// aarch64-macos: apple-m1's baseline), else exclusive-pair loops (ldxr,
// stxr). One ATOMIC is one sequence written here whole, so no spill,
// reload or other memory access can fall inside a loop: the loops use x16
// and x17 (the emitter's temporaries) and x15, which the register
// allocator keeps free across an ATOMIC that needs it (atomic_scratch).
// The operands are only read and the result written last, so the result
// may share a register with an operand. The -O0 code generator writes the
// intrinsics' bodies with the same sequences (gen0/gen/atomic.tach).
//
// Loads and stores: ldr/str (Relaxed), ldar (Acquire, SeqCst), stlr
// (Release, SeqCst). Read-modify-writes and CAS take the suffix a
// (Acquire), l (Release), al (AcqRel, SeqCst); loops ldaxr/stlxr likewise.
// A failed CAS loop ends with clrex. Fences: dmb ishld (Acquire), dmb ish.

use crate::front::types::{TY_I16, TY_I32, TY_I8, type_size};
use crate::gen0::arm64::a64_label;
use crate::gen0::target::{emit_label, new_label, o, oi, on};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::atomic::{
    ATOMIC_ADD, ATOMIC_AND, ATOMIC_CAS, ATOMIC_LOAD, ATOMIC_NAND, ATOMIC_OR, ATOMIC_SMAX,
    ATOMIC_SMIN, ATOMIC_STORE, ATOMIC_SUB, ATOMIC_SWAP, ATOMIC_UMAX, ATOMIC_UMIN, ATOMIC_XOR,
    FENCE_COMPILER, ORD_ACQUIRE, ORD_RELAXED, order_acquires, order_releases,
};

// Whether atomics use LSE: -1 by the target (aarch64-macos yes, Linux
// no), else --atomics=lse (1) or --atomics=llsc (0).
pub static mut A64_LSE_FLAG: i64 = -1;

// The scratch register an ATOMIC may need besides x16 and x17.
pub const ATOMIC_SCRATCH: i64 = 15;

// Whether the target's atomics use LSE.
pub fn a64_lse() -> bool {
    unsafe {
        if A64_LSE_FLAG >= 0 {
            return A64_LSE_FLAG == 1;
        }
        crate::base::target::APPLE_A64
    }
}

// Whether an ATOMIC of `kind` needs ATOMIC_SCRATCH (a loop).
pub fn atomic_needs_scratch(kind: i64) -> bool {
    if kind == ATOMIC_LOAD || kind == ATOMIC_STORE {
        return false;
    }
    if !a64_lse() {
        return true;
    }
    kind == ATOMIC_NAND
}

// Register r for an access of `size` bytes: w<r> up to 4, x<r> for 8.
fn reg(mut cx: *FnCtx, r: i64, size: i64) {
    unsafe {
        o(cx, if size <= 4 { c"w" } else { c"x" });
        oi(cx, r);
    }
}

fn xreg(mut cx: *FnCtx, r: i64) {
    unsafe {
        o(cx, c"x");
        oi(cx, r);
    }
}

// The width suffix of an access: b, h or none.
fn width(mut cx: *FnCtx, size: i64) {
    unsafe {
        if size == 1 {
            o(cx, c"b");
        } else if size == 2 {
            o(cx, c"h");
        }
    }
}

// The ordering suffix of an LSE instruction: a, l, al or none.
fn order_suffix(mut cx: *FnCtx, order: i64) {
    unsafe {
        let acq = order_acquires(order);
        let rel = order_releases(order);
        if acq {
            o(cx, c"a");
        }
        if rel {
            o(cx, c"l");
        }
    }
}

// "    <m><order><width> Rs, Rt, [xA]\n"
fn lse(mut cx: *FnCtx, m: *u8, order: i64, size: i64, s: i64, t: i64, a: i64) {
    unsafe {
        o(cx, c"    ");
        o(cx, m);
        order_suffix(cx, order);
        width(cx, size);
        o(cx, c" ");
        reg(cx, s, size);
        o(cx, c", ");
        reg(cx, t, size);
        o(cx, c", [");
        xreg(cx, a);
        o(cx, c"]");
        on(cx);
    }
}

// "    <m> Rt, [xA]\n" with the width suffix.
fn mem1(mut cx: *FnCtx, m: *u8, size: i64, t: i64, a: i64) {
    unsafe {
        o(cx, c"    ");
        o(cx, m);
        width(cx, size);
        o(cx, c" ");
        reg(cx, t, size);
        o(cx, c", [");
        xreg(cx, a);
        o(cx, c"]");
        on(cx);
    }
}

// The exclusive store "    st[l]xr<width> w17, Rt, [xA]\n".
fn store_exclusive(mut cx: *FnCtx, order: i64, size: i64, t: i64, a: i64) {
    unsafe {
        o(cx, if order_releases(order) { c"    stlxr" } else { c"    stxr" });
        width(cx, size);
        o(cx, c" w17, ");
        reg(cx, t, size);
        o(cx, c", [");
        xreg(cx, a);
        o(cx, c"]");
        on(cx);
    }
}

fn load_exclusive(mut cx: *FnCtx, order: i64, size: i64, t: i64, a: i64) {
    unsafe { mem1(cx, if order_acquires(order) { c"ldaxr" } else { c"ldxr" }, size, t, a); }
}

// "    <m> xD, xA, xB\n"
fn rrr(mut cx: *FnCtx, m: *u8, d: i64, a: i64, b: i64) {
    unsafe {
        o(cx, c"    ");
        o(cx, m);
        o(cx, c" ");
        xreg(cx, d);
        o(cx, c", ");
        xreg(cx, a);
        o(cx, c", ");
        xreg(cx, b);
        on(cx);
    }
}

fn rr(mut cx: *FnCtx, m: *u8, d: i64, a: i64) {
    unsafe {
        o(cx, c"    ");
        o(cx, m);
        o(cx, c" ");
        xreg(cx, d);
        o(cx, c", ");
        xreg(cx, a);
        on(cx);
    }
}

// xD = the value of type ty in the low bits of xS (zero-extended there)
// in its canonical form: sign-extended for a signed type narrower than 8.
fn canonical(mut cx: *FnCtx, d: i64, s: i64, ty: i64) {
    unsafe {
        if ty == TY_I8 || ty == TY_I16 || ty == TY_I32 {
            o(cx, if ty == TY_I8 { c"    sxtb " } else if ty == TY_I16 { c"    sxth " }
                else { c"    sxtw " });
            xreg(cx, d);
            o(cx, c", w");
            oi(cx, s);
            on(cx);
        } else if d != s {
            rr(cx, c"mov", d, s);
        }
    }
}

fn branch(mut cx: *FnCtx, m: *u8, label: i64) {
    unsafe {
        o(cx, c"    ");
        o(cx, m);
        o(cx, c" ");
        a64_label(cx, label);
        on(cx);
    }
}

// The comparison of an RMW loop's max or min: xs (canonical) with xB;
// csel's condition.
fn minmax_cond(kind: i64) -> *u8 {
    if kind == ATOMIC_SMAX { c"gt" } else if kind == ATOMIC_SMIN { c"lt" }
    else if kind == ATOMIC_UMAX { c"hi" } else { c"lo" }
}

// x15 = op(x16, xB) for a read-modify-write of `kind` (the loops).
fn rmw_op(mut cx: *FnCtx, kind: i64, ty: i64, b: i64) {
    unsafe {
        if kind == ATOMIC_ADD {
            rrr(cx, c"add", 15, 16, b);
        } else if kind == ATOMIC_SUB {
            rrr(cx, c"sub", 15, 16, b);
        } else if kind == ATOMIC_AND {
            rrr(cx, c"and", 15, 16, b);
        } else if kind == ATOMIC_NAND {
            rrr(cx, c"and", 15, 16, b);
            rr(cx, c"mvn", 15, 15);
        } else if kind == ATOMIC_OR {
            rrr(cx, c"orr", 15, 16, b);
        } else if kind == ATOMIC_XOR {
            rrr(cx, c"eor", 15, 16, b);
        } else {
            canonical(cx, 15, 16, ty);
            o(cx, c"    cmp x15, ");
            xreg(cx, b);
            on(cx);
            o(cx, c"    csel x15, x15, ");
            xreg(cx, b);
            o(cx, c", ");
            o(cx, minmax_cond(kind));
            on(cx);
        }
    }
}

// The LSE instruction of a read-modify-write kind (sub and and through
// ldadd and ldclr of the negated or inverted operand).
fn lse_name(kind: i64) -> *u8 {
    if kind == ATOMIC_ADD || kind == ATOMIC_SUB { c"ldadd" }
    else if kind == ATOMIC_AND { c"ldclr" } else if kind == ATOMIC_OR { c"ldset" }
    else if kind == ATOMIC_XOR { c"ldeor" } else if kind == ATOMIC_SMAX { c"ldsmax" }
    else if kind == ATOMIC_SMIN { c"ldsmin" } else if kind == ATOMIC_UMAX { c"ldumax" }
    else { c"ldumin" }
}

// The ATOMIC of `kind` and `order` on a value of IR type ty: address in
// xa, value (CAS: the new one) in xb, CAS's expected value in xc, the
// result (the old value) into xd (d < 0: none).
pub fn ma_atomic(mut cx: *FnCtx, kind: i64, order: i64, ty: i64, d: i64, a: i64, b: i64, c: i64) {
    unsafe {
        let size = type_size(ty);
        if kind == ATOMIC_LOAD {
            mem1(cx, if order == ORD_RELAXED { c"ldr" } else { c"ldar" }, size, 16, a);
        } else if kind == ATOMIC_STORE {
            mem1(cx, if order == ORD_RELAXED { c"str" } else { c"stlr" }, size, b, a);
            return;
        } else if a64_lse() && kind != ATOMIC_NAND {
            if kind == ATOMIC_SWAP {
                lse(cx, c"swp", order, size, b, 16, a);
            } else if kind == ATOMIC_CAS {
                rr(cx, c"mov", 16, c);
                lse(cx, c"cas", order, size, 16, b, a);
            } else if kind == ATOMIC_SUB {
                rr(cx, c"neg", 17, b);
                lse(cx, c"ldadd", order, size, 17, 16, a);
            } else if kind == ATOMIC_AND {
                rr(cx, c"mvn", 17, b);
                lse(cx, c"ldclr", order, size, 17, 16, a);
            } else {
                lse(cx, lse_name(kind), order, size, b, 16, a);
            }
        } else if a64_lse() {
            // NAND with LSE: a CAS loop from a plain load.
            let again = new_label(cx);
            mem1(cx, c"ldr", size, 16, a);
            emit_label(cx, again);
            rmw_op(cx, kind, ty, b);
            rr(cx, c"mov", 17, 16);
            lse(cx, c"cas", order, size, 17, 15, a);
            o(cx, c"    cmp ");
            reg(cx, 17, size);
            o(cx, c", ");
            reg(cx, 16, size);
            on(cx);
            rr(cx, c"mov", 16, 17);
            branch(cx, c"b.ne", again);
        } else if kind == ATOMIC_CAS {
            // The expected value as the loaded one is: zero-extended.
            if size < 4 {
                o(cx, c"    and w15, ");
                reg(cx, c, 4);
                o(cx, if size == 1 { c", #0xff\n" } else { c", #0xffff\n" });
            } else {
                rr(cx, c"mov", 15, c);
            }
            let again = new_label(cx);
            let fail = new_label(cx);
            let done = new_label(cx);
            emit_label(cx, again);
            load_exclusive(cx, order, size, 16, a);
            o(cx, c"    cmp ");
            reg(cx, 16, size);
            o(cx, c", ");
            reg(cx, 15, size);
            on(cx);
            branch(cx, c"b.ne", fail);
            store_exclusive(cx, order, size, b, a);
            branch(cx, c"cbnz w17,", again);
            branch(cx, c"b", done);
            emit_label(cx, fail);
            o(cx, c"    clrex\n");
            emit_label(cx, done);
        } else {
            let again = new_label(cx);
            emit_label(cx, again);
            load_exclusive(cx, order, size, 16, a);
            if kind == ATOMIC_SWAP {
                store_exclusive(cx, order, size, b, a);
            } else {
                rmw_op(cx, kind, ty, b);
                store_exclusive(cx, order, size, 15, a);
            }
            branch(cx, c"cbnz w17,", again);
        }
        if d >= 0 {
            canonical(cx, d, 16, ty);
        }
    }
}

// A FENCE (imm: its ordering, FENCE_COMPILER: no instruction).
pub fn ma_fence(mut cx: *FnCtx, imm: i64) {
    unsafe {
        if (imm & FENCE_COMPILER) != 0 {
            return;
        }
        let order = imm & 15;
        if order == ORD_ACQUIRE {
            o(cx, c"    dmb ishld\n");
        } else if order != ORD_RELAXED {
            o(cx, c"    dmb ish\n");
        }
    }
}
