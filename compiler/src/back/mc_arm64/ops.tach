// AArch64 operations (mc_arm64/mod.tach): integer and float arithmetic,
// comparisons and branches, conversions, jump tables, and the machine
// operations of instruction selection.

use crate::back::emit::machine::stays_canonical;
use crate::back::mc_arm64::{ma_f, ma_lea, ma_normalize, ma_r, ma_rr, ma_rrr, ma_w, o_back_imm};
use crate::base::BUFS;
use crate::front::types::{TY_F64, TY_U32, TY_U64, int_bits, is_float, is_signed};
use crate::gen0::arm64::{a64_condition, a64_label, a64_load_imm};
use crate::gen0::target::{emit_label, ins, log2, new_label, o, oi, on};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{BITS_ONES, BITS_TRAILING, Cond, Op};
use crate::middle::ir::Op::{Add, And, Div, Mul, Neg, Not, Or, Rem, Shl, Shr, Sub, Xor};

// Division by zero gives 0 (and the remainder the dividend), as sdiv and
// udiv do. (0.16) A u32 operation is done on the w registers (its result
// zero-extended: canonical as it is, and a shift takes its amount modulo
// 32 itself); and, or, xor, right shifts and unsigned divisions of
// canonical operands are canonical: no normalization after them.
pub fn ma_int_op(mut cx: *FnCtx, op: Op, ty: i64, d: i64, a: i64, b: i64) {
    unsafe {
        let signed = is_signed(ty);
        let w32 = ty == TY_U32;
        cx.ma_w32 = w32;
        if op == Add { ma_rrr(cx, c"add", d, a, b); }
        else if op == Sub { ma_rrr(cx, c"sub", d, a, b); }
        else if op == Mul { ma_rrr(cx, c"mul", d, a, b); }
        else if op == Div { ma_rrr(cx, if signed { c"sdiv" } else { c"udiv" }, d, a, b); }
        else if op == Rem {
            ma_rrr(cx, if signed { c"sdiv" } else { c"udiv" }, 17, a, b);
            o(cx, c"    msub ");
            ma_r(cx, d);
            o(cx, if w32 { c", w17, " } else { c", x17, " });
            ma_r(cx, b);
            o(cx, c", ");
            ma_r(cx, a);
            on(cx);
        } else if op == And { ma_rrr(cx, c"and", d, a, b); }
        else if op == Or { ma_rrr(cx, c"orr", d, a, b); }
        else if op == Xor { ma_rrr(cx, c"eor", d, a, b); }
        else if w32 {
            ma_rrr(cx, if op == Shl { c"lsl" } else { c"lsr" }, d, a, b);
        } else {
            // The amount is taken modulo 32 for types up to 32 bits, modulo 64
            // for 64-bit ones.
            ma_rr(cx, c"and", 17, b);
            o_back_imm(cx, if int_bits(ty) == 64 { 63 } else { 31 });
            if op == Shl {
                ma_rrr(cx, c"lsl", d, a, 17);
            } else {
                ma_rrr(cx, if signed { c"asr" } else { c"lsr" }, d, a, 17);
            }
        }
        cx.ma_w32 = false;
        if !w32 && !stays_canonical(op, signed) {
            ma_normalize(cx, d, ty);
        }
    }
}

// d = the high 64 bits of a * b (MULH, 0.11): smulh or umulh. The result
// is already canonical for its type (see isel.tach).
pub fn ma_mulh(mut cx: *FnCtx, signed: bool, d: i64, a: i64, b: i64) {
    unsafe { ma_rrr(cx, if signed { c"smulh" } else { c"umulh" }, d, a, b); }
}

// Whether ma_int_op_imm emits `a <op> imm` (one instruction).
pub fn ma_int_imm_ok(op: Op, imm: i64) -> bool {
    if op == Add || op == Sub {
        return imm > -4096 && imm < 4096;
    }
    if op == Mul {
        return imm == 3 || imm == 5 || imm == 9;
    }
    if op == And || op == Or || op == Xor {
        return is_logical_imm(imm as u64);
    }
    op == Shl || op == Shr
}

pub fn ma_int_op_imm(mut cx: *FnCtx, op: Op, ty: i64, d: i64, a: i64, imm: i64) -> bool {
    unsafe {
        // (0.16) u32 on the w registers, as ma_int_op.
        let w32 = ty == TY_U32;
        if op == Add || op == Sub {
            let mut value = imm;
            let mut subtract = op == Sub;
            if value < 0 && value > -4096 {
                value = 0 - value;
                subtract = !subtract;
            }
            if value < 0 || value >= 4096 {
                return false;
            }
            cx.ma_w32 = w32;
            ma_rr(cx, if subtract { c"sub" } else { c"add" }, d, a);
            cx.ma_w32 = false;
            o_back_imm(cx, value);
            if !w32 {
                ma_normalize(cx, d, ty);
            }
            return true;
        }
        if op == Mul && (imm == 3 || imm == 5 || imm == 9) {
            // a * (2^k + 1) = a + (a << k)
            cx.ma_w32 = w32;
            ma_rrr(cx, c"add", d, a, a);
            cx.ma_w32 = false;
            BUFS[cx.code].len -= 1;
            o(cx, c", lsl #");
            oi(cx, log2(imm - 1));
            on(cx);
            if !w32 {
                ma_normalize(cx, d, ty);
            }
            return true;
        }
        if (op == And || op == Or || op == Xor) && is_logical_imm(imm as u64) {
            // (of canonical operands, canonical)
            ma_rr(cx, if op == And { c"and" } else if op == Or { c"orr" } else { c"eor" }, d, a);
            o_back_imm(cx, imm);
            return true;
        }
        if op == Shl || op == Shr {
            let amount = imm & (if int_bits(ty) == 64 { 63 } else { 31 });
            if amount == 0 {
                if d != a {
                    ma_rr(cx, c"mov", d, a);
                }
            } else if op == Shl {
                cx.ma_w32 = w32;
                ma_rr(cx, c"lsl", d, a);
                cx.ma_w32 = false;
                o_back_imm(cx, amount);
            } else {
                ma_rr(cx, if is_signed(ty) { c"asr" } else { c"lsr" }, d, a);
                o_back_imm(cx, amount);
            }
            if op == Shl && !w32 {
                ma_normalize(cx, d, ty);
            }
            return true;
        }
        false
    }
}

// Whether `value` is encodable as an AArch64 logical immediate: a
// pattern of 2, 4, ..., 64 bits, repeated, that is a rotated run of ones.
pub fn is_logical_imm(value: u64) -> bool {
    if value == 0 || value == 0xffffffffffffffff {
        return false;
    }
    let mut size = 64;
    while size > 2 {
        let half = size / 2;
        let mask = ((1 as u64) << half as u64) - 1;
        if (value & mask) != ((value >> half as u64) & mask) {
            break;
        }
        size = half;
    }
    let mask: u64 = if size == 64 { 0xffffffffffffffff } else { ((1 as u64) << size as u64) - 1 };
    let element = value & mask;
    // A rotated run of ones has exactly two transitions, circularly.
    let rotated = ((element >> 1) | (element << (size - 1) as u64)) & mask;
    let transitions = element ^ rotated;
    let mut count = 0;
    let mut bits = transitions;
    while bits != 0 {
        bits &= bits - 1;
        count += 1;
    }
    count == 2
}

pub fn ma_float_op(mut cx: *FnCtx, op: Op, ty: i64, d: i64, a: i64, b: i64) {
    unsafe {
        o(cx, c"    ");
        if op == Add { o(cx, c"fadd "); }
        else if op == Sub { o(cx, c"fsub "); }
        else if op == Mul { o(cx, c"fmul "); }
        else { o(cx, c"fdiv "); }
        ma_f(cx, d, ty);
        o(cx, c", ");
        ma_f(cx, a, ty);
        o(cx, c", ");
        ma_f(cx, b, ty);
        on(cx);
    }
}

pub fn ma_unary(mut cx: *FnCtx, op: Op, ty: i64, d: i64, a: i64) {
    unsafe {
        if op == Neg && is_float(ty) {
            o(cx, c"    fneg ");
            ma_f(cx, d, ty);
            o(cx, c", ");
            ma_f(cx, a, ty);
            on(cx);
            return;
        }
        if ty == TY_U32 && op != Not {
            // (0.16: on the w registers, as ma_int_op)
            cx.ma_w32 = true;
            ma_rr(cx, if op == Neg { c"neg" } else { c"mvn" }, d, a);
            cx.ma_w32 = false;
            return;
        }
        if op == Neg {
            ma_rr(cx, c"neg", d, a);
        } else if op == Not {
            ma_rr(cx, c"eor", d, a);
            o_back_imm(cx, 1);
            return;
        } else {
            ma_rr(cx, c"mvn", d, a);
        }
        ma_normalize(cx, d, ty);
    }
}

fn ma_compare(mut cx: *FnCtx, ty: i64, a: i64, b: i64) {
    unsafe {
        if is_float(ty) {
            o(cx, c"    fcmp ");
            ma_f(cx, a, ty);
            o(cx, c", ");
            ma_f(cx, b, ty);
            on(cx);
        } else {
            ma_rr(cx, c"cmp", a, b);
        }
    }
}

pub fn ma_cmp(mut cx: *FnCtx, op: Cond, ty: i64, d: i64, a: i64, b: i64) {
    unsafe {
        ma_compare(cx, ty, a, b);
        o(cx, c"    cset ");
        ma_r(cx, d);
        o(cx, c", ");
        o(cx, a64_condition(op, is_signed(ty), is_float(ty)));
        on(cx);
    }
}

// Sets the flags from a - imm, |imm| < 4096 (cmn for a negative one).
fn ma_compare_imm(mut cx: *FnCtx, a: i64, imm: i64) {
    unsafe {
        o(cx, if imm < 0 { c"    cmn " } else { c"    cmp " });
        ma_r(cx, a);
        o(cx, c", #");
        oi(cx, if imm < 0 { 0 - imm } else { imm });
        on(cx);
    }
}

// d = (a op imm), integers, |imm| < 4096.
pub fn ma_cmp_imm(mut cx: *FnCtx, op: Cond, ty: i64, d: i64, a: i64, imm: i64) {
    unsafe {
        ma_compare_imm(cx, a, imm);
        o(cx, c"    cset ");
        ma_r(cx, d);
        o(cx, c", ");
        o(cx, a64_condition(op, is_signed(ty), float: false));
        on(cx);
    }
}

pub fn ma_cmp_branch(mut cx: *FnCtx, op: Cond, ty: i64, a: i64, b: i64, b_is_imm: bool, imm: i64,
    label: i64) {
    unsafe {
        if b_is_imm && imm == 0 && (op == Cond::Eq || op == Cond::Ne) {
            ma_branch_bool(cx, a, op == Cond::Ne, label);
            return;
        }
        if b_is_imm {
            ma_compare_imm(cx, a, imm);
        } else {
            ma_rr(cx, c"cmp", a, b);
        }
        o(cx, c"    b.");
        o(cx, a64_condition(op, is_signed(ty), float: false));
        o(cx, c" ");
        a64_label(cx, label);
        on(cx);
    }
}

pub fn ma_branch_bool(mut cx: *FnCtx, r: i64, if_nonzero: bool, label: i64) {
    unsafe {
        o(cx, if if_nonzero { c"    cbnz " } else { c"    cbz " });
        ma_r(cx, r);
        o(cx, c", ");
        a64_label(cx, label);
        on(cx);
    }
}

pub fn ma_conv(mut cx: *FnCtx, from: i64, to: i64, d: i64, src: i64) {
    unsafe {
        if is_float(from) && is_float(to) {
            o(cx, c"    fcvt ");
            ma_f(cx, d, to);
            o(cx, c", ");
            ma_f(cx, src, from);
            on(cx);
            return;
        }
        if is_float(to) {
            o(cx, if is_signed(from) { c"    scvtf " } else { c"    ucvtf " });
            ma_f(cx, d, to);
            o(cx, c", ");
            ma_r(cx, src);
            on(cx);
            return;
        }
        if !is_float(from) {
            if d != src {
                ma_rr(cx, c"mov", d, src);
            }
            ma_normalize(cx, d, to);
            return;
        }
        // Saturating float to integer (see emit_float_to_int).
        if is_signed(to) && int_bits(to) <= 32 {
            o(cx, c"    fcvtzs ");
            ma_w(cx, d);
            o(cx, c", ");
            ma_f(cx, src, from);
            on(cx);
            o(cx, c"    sxtw ");
            ma_r(cx, d);
            o(cx, c", ");
            ma_w(cx, d);
            on(cx);
        } else if to != TY_U64 {
            o(cx, c"    fcvtzs ");
            ma_r(cx, d);
            o(cx, c", ");
            ma_f(cx, src, from);
            on(cx);
        } else {
            // d = value >= 2^63 ? fcvtzu(value) : fcvtzs(value); fcvtzs gives
            // INT64_MAX exactly for those values (no smaller float rounds to
            // it), the one value whose increment overflows.
            o(cx, c"    fcvtzs x16, ");
            ma_f(cx, src, from);
            on(cx);
            o(cx, c"    fcvtzu x17, ");
            ma_f(cx, src, from);
            on(cx);
            ins(cx, c"cmn x16, #1");
            o(cx, c"    csel ");
            ma_r(cx, d);
            o(cx, c", x17, x16, vs\n");
        }
        ma_normalize(cx, d, to);
    }
}

// A jump through a table of 32-bit offsets (from the table) to labels:
// entry `value - low` for register r, the default above the range.
pub fn ma_jump_table(mut cx: *FnCtx, r: i64, low: i64, range: i64, default: i64, table: *i64) {
    unsafe {
        // The index: the value itself when the cases start at 0.
        let index = if low == 0 { r } else { 16 };
        if low != 0 {
            ma_lea(cx, 16, r, 0 - low);
        }
        if range - 1 < 4096 {
            o(cx, c"    cmp ");
            ma_r(cx, index);
            o(cx, c", #");
            oi(cx, range - 1);
            on(cx);
        } else {
            a64_load_imm(cx, 17, (range - 1) as u64);
            o(cx, c"    cmp ");
            ma_r(cx, index);
            o(cx, c", x17");
            on(cx);
        }
        o(cx, c"    b.hi ");
        a64_label(cx, default);
        on(cx);
        let at = new_label(cx);
        o(cx, c"    adr x17, ");
        a64_label(cx, at);
        on(cx);
        o(cx, c"    ldrsw x16, [x17, ");
        ma_r(cx, index);
        o(cx, c", lsl #2]");
        on(cx);
        ins(cx, c"add x17, x17, x16");
        ins(cx, c"br x17");
        ins(cx, c".p2align 2");
        emit_label(cx, at);
        for i in 0..range {
            o(cx, c"    .long ");
            a64_label(cx, table[i]);
            o(cx, c" - ");
            a64_label(cx, at);
            on(cx);
        }
    }
}

// ---- Machine operations of instruction selection (isel/) ----

// d = c + a * b, or c - a * b.
pub fn ma_madd(mut cx: *FnCtx, sub: bool, ty: i64, d: i64, a: i64, b: i64, c: i64) {
    unsafe {
        // (0.16: u32 on the w registers, as ma_int_op)
        cx.ma_w32 = ty == TY_U32;
        o(cx, if sub { c"    msub " } else { c"    madd " });
        ma_r(cx, d);
        o(cx, c", ");
        ma_r(cx, a);
        o(cx, c", ");
        ma_r(cx, b);
        o(cx, c", ");
        ma_r(cx, c);
        on(cx);
        if !cx.ma_w32 {
            ma_normalize(cx, d, ty);
        }
        cx.ma_w32 = false;
    }
}

// d = a op (b sh k); `code` is 4 * op + sh (0 lsl, 1 lsr, 2 asr).
pub fn ma_shop(mut cx: *FnCtx, code: i64, ty: i64, d: i64, a: i64, b: i64, k: i64) {
    let op = code / 4;
    let kind = code % 4;
    let mnemonic = if op == Add as i64 { c"add" } else if op == Sub as i64 { c"sub" }
        else if op == And as i64 { c"and" } else if op == Or as i64 { c"orr" } else { c"eor" };
    // (0.16: u32 on the w registers, as ma_int_op)
    let w32 = ty == TY_U32 && k < 32;
    unsafe {
        cx.ma_w32 = w32;
        ma_rrr(cx, mnemonic, d, a, b);
        cx.ma_w32 = false;
        BUFS[cx.code].len -= 1;
        o(cx, if kind == 0 { c", lsl #" } else if kind == 1 { c", lsr #" } else { c", asr #" });
    }
    oi(cx, k);
    on(cx);
    if !w32 {
        ma_normalize(cx, d, ty);
    }
}

// d = (a >> k) & (2^n - 1).
pub fn ma_ubfx(mut cx: *FnCtx, d: i64, a: i64, k: i64, n: i64) {
    unsafe {
        ma_rr(cx, c"ubfx", d, a);
        BUFS[cx.code].len -= 1;
        o(cx, c", #");
        oi(cx, k);
        o(cx, c", #");
        oi(cx, n);
        on(cx);
    }
}

// Sets the flags from a & b (b < 0: a & mask).
fn ma_tst(mut cx: *FnCtx, a: i64, b: i64, mask: i64) {
    unsafe {
        if b >= 0 {
            ma_rr(cx, c"tst", a, b);
        } else {
            o(cx, c"    tst ");
            ma_r(cx, a);
            o(cx, c", #");
            oi(cx, mask);
            on(cx);
        }
    }
}

// Jumps to `label` when a & b (b < 0: a & mask) is nonzero, or zero.
pub fn ma_test_branch(mut cx: *FnCtx, a: i64, b: i64, mask: i64, if_nonzero: bool, label: i64) {
    unsafe {
        if b < 0 && mask > 0 && (mask & (mask - 1)) == 0 && cx.short_branches {
            o(cx, if if_nonzero { c"    tbnz " } else { c"    tbz " });
            ma_r(cx, a);
            o(cx, c", #");
            oi(cx, log2(mask));
            o(cx, c", ");
            a64_label(cx, label);
            on(cx);
            return;
        }
        ma_tst(cx, a, b, mask);
        o(cx, if if_nonzero { c"    b.ne " } else { c"    b.eq " });
        a64_label(cx, label);
        on(cx);
    }
}

// d = (lhs op rhs) ? then : other (other + 1 when `increment`), or
// (lhs & rhs) op 0 when `test` (rhs < 0: the immediate imm); cmp_ty is the
// type compared, ty the selected; the flags are already set unless
// `compare`.
pub fn ma_select(mut cx: *FnCtx, op: Cond, test: bool, compare: bool, cmp_ty: i64, lhs: i64,
    rhs: i64, imm: i64, ty: i64, d: i64, then: i64, other: i64, increment: bool) {
    unsafe {
        if !compare {
        } else if test {
            ma_tst(cx, lhs, rhs, imm);
        } else if is_float(cmp_ty) {
            ma_compare(cx, cmp_ty, lhs, rhs);
        } else if rhs < 0 {
            ma_compare_imm(cx, lhs, imm);
        } else {
            ma_rr(cx, c"cmp", lhs, rhs);
        }
        let condition = a64_condition(op, is_signed(cmp_ty), is_float(cmp_ty) && !test);
        if is_float(ty) {
            o(cx, c"    fcsel ");
            ma_f(cx, d, ty);
            o(cx, c", ");
            ma_f(cx, then, ty);
            o(cx, c", ");
            ma_f(cx, other, ty);
        } else {
            o(cx, if increment { c"    csinc " } else { c"    csel " });
            ma_r(cx, d);
            o(cx, c", ");
            ma_r_or_zero(cx, then);
            o(cx, c", ");
            ma_r_or_zero(cx, other);
        }
        o(cx, c", ");
        o(cx, condition);
        on(cx);
    }
}

// x<r>, or xzr for -1.
fn ma_r_or_zero(mut cx: *FnCtx, r: i64) {
    if r < 0 {
        unsafe { o(cx, c"xzr"); }
    } else {
        ma_r(cx, r);
    }
}

// Stores (or loads) registers r and s at [sp, #offset] and [sp, #offset +
// 8]: x or d registers alike.
pub fn ma_pair(mut cx: *FnCtx, load: bool, r: i64, s: i64, offset: i64) {
    unsafe {
        o(cx, if load { c"    ldp " } else { c"    stp " });
        if r >= 32 {
            ma_f(cx, r, TY_F64);
            o(cx, c", ");
            ma_f(cx, s, TY_F64);
        } else {
            ma_r(cx, r);
            o(cx, c", ");
            ma_r(cx, s);
        }
        o(cx, c", [sp");
        if offset != 0 {
            o(cx, c", #");
            oi(cx, offset);
        }
        o(cx, c"]\n");
    }
}

// d = sqrt, fabs, floor, ceil, trunc or round (kind 0 to 5) of a.
pub fn ma_fmath(mut cx: *FnCtx, kind: i64, ty: i64, d: i64, a: i64) {
    unsafe {
        o(cx, if kind == 0 { c"    fsqrt " } else if kind == 1 { c"    fabs " }
            else if kind == 2 { c"    frintm " } else if kind == 3 { c"    frintp " }
            else if kind == 4 { c"    frintz " } else { c"    frinta " });
        ma_f(cx, d, ty);
        o(cx, c", ");
        ma_f(cx, a, ty);
        on(cx);
    }
}

// (0.16) d = the count `kind` of a's bits (BITS_ONES: cnt over the bytes
// in v31, the vector temporary, and their sum; BITS_LEADING: clz;
// BITS_TRAILING: rbit, then clz).
pub fn ma_bits(mut cx: *FnCtx, kind: i64, d: i64, a: i64) {
    unsafe {
        if kind == BITS_ONES {
            o(cx, c"    fmov d31, ");
            ma_r(cx, a);
            on(cx);
            o(cx, c"    cnt v31.8b, v31.8b\n");
            o(cx, c"    addv b31, v31.8b\n");
            o(cx, c"    fmov ");
            ma_w(cx, d);
            o(cx, c", s31\n");
            return;
        }
        if kind == BITS_TRAILING {
            ma_rr(cx, c"rbit", d, a);
            ma_rr(cx, c"clz", d, d);
            return;
        }
        ma_rr(cx, c"clz", d, a);
    }
}
