// AArch64 operations (mc_arm64/mod.tach): integer and float arithmetic,
// comparisons and branches, conversions, jump tables, and the machine
// operations of instruction selection.

use crate::back::emit::SHORT_BRANCHES;
use crate::back::mc_arm64::{ma_f, ma_lea, ma_normalize, ma_r, ma_rr, ma_rrr, ma_w, o_back_imm};
use crate::base::BUFS;
use crate::front::types::{TY_F64, TY_U64, int_bits, is_float, is_signed};
use crate::gen0::arm64::{a64_condition, a64_label, a64_load_imm};
use crate::gen0::target::{CODE, emit_label, ins, log2, new_label, o, oi, on};
use crate::middle::ir::{Cond, Op};
use crate::middle::ir::Op::{Add, And, Div, Mul, Neg, Not, Or, Rem, Shl, Shr, Sub, Xor};

// Division by zero gives 0 (and the remainder the dividend), as sdiv and
// udiv do.
pub fn ma_int_op(op: Op, ty: i64, d: i64, a: i64, b: i64) {
    unsafe {
        let signed = is_signed(ty);
        if op == Add { ma_rrr(c"add", d, a, b); }
        else if op == Sub { ma_rrr(c"sub", d, a, b); }
        else if op == Mul { ma_rrr(c"mul", d, a, b); }
        else if op == Div { ma_rrr(if signed { c"sdiv" } else { c"udiv" }, d, a, b); }
        else if op == Rem {
            ma_rrr(if signed { c"sdiv" } else { c"udiv" }, 17, a, b);
            o(c"    msub ");
            ma_r(d);
            o(c", x17, ");
            ma_r(b);
            o(c", ");
            ma_r(a);
            on();
        } else if op == And { ma_rrr(c"and", d, a, b); }
        else if op == Or { ma_rrr(c"orr", d, a, b); }
        else if op == Xor { ma_rrr(c"eor", d, a, b); }
        else {
            // The amount is taken modulo 32 for types up to 32 bits, modulo 64
            // for 64-bit ones.
            ma_rr(c"and", 17, b);
            o_back_imm(if int_bits(ty) == 64 { 63 } else { 31 });
            if op == Shl {
                ma_rrr(c"lsl", d, a, 17);
            } else {
                ma_rrr(if signed { c"asr" } else { c"lsr" }, d, a, 17);
            }
        }
        ma_normalize(d, ty);
    }
}

// d = the high 64 bits of a * b (MULH, 0.11): smulh or umulh. The result
// is already canonical for its type (see isel.tach).
pub fn ma_mulh(signed: bool, d: i64, a: i64, b: i64) {
    unsafe { ma_rrr(if signed { c"smulh" } else { c"umulh" }, d, a, b); }
}

// Whether ma_int_op_imm emits `a <op> imm` (one instruction).
pub fn ma_int_imm_ok(op: Op, imm: i64) -> bool {
    if op == Add || op == Sub {
        return imm > -4096 && imm < 4096;
    }
    if op == Mul {
        return imm == 3 || imm == 5 || imm == 9;
    }
    if op == And || op == Or || op == Xor {
        return is_logical_imm(imm as u64);
    }
    op == Shl || op == Shr
}

pub fn ma_int_op_imm(op: Op, ty: i64, d: i64, a: i64, imm: i64) -> bool {
    unsafe {
        if op == Add || op == Sub {
            let mut value = imm;
            let mut subtract = op == Sub;
            if value < 0 && value > -4096 {
                value = 0 - value;
                subtract = !subtract;
            }
            if value < 0 || value >= 4096 {
                return false;
            }
            ma_rr(if subtract { c"sub" } else { c"add" }, d, a);
            o_back_imm(value);
            ma_normalize(d, ty);
            return true;
        }
        if op == Mul && (imm == 3 || imm == 5 || imm == 9) {
            // a * (2^k + 1) = a + (a << k)
            ma_rrr(c"add", d, a, a);
            BUFS[CODE].len -= 1;
            o(c", lsl #");
            oi(log2(imm - 1));
            on();
            ma_normalize(d, ty);
            return true;
        }
        if (op == And || op == Or || op == Xor) && is_logical_imm(imm as u64) {
            ma_rr(if op == And { c"and" } else if op == Or { c"orr" } else { c"eor" }, d, a);
            o_back_imm(imm);
            ma_normalize(d, ty);
            return true;
        }
        if op == Shl || op == Shr {
            let amount = imm & (if int_bits(ty) == 64 { 63 } else { 31 });
            if amount == 0 {
                if d != a {
                    ma_rr(c"mov", d, a);
                }
            } else if op == Shl {
                ma_rr(c"lsl", d, a);
                o_back_imm(amount);
            } else {
                ma_rr(if is_signed(ty) { c"asr" } else { c"lsr" }, d, a);
                o_back_imm(amount);
            }
            ma_normalize(d, ty);
            return true;
        }
        false
    }
}

// Whether `value` is encodable as an AArch64 logical immediate: a
// pattern of 2, 4, ..., 64 bits, repeated, that is a rotated run of ones.
pub fn is_logical_imm(value: u64) -> bool {
    if value == 0 || value == 0xffffffffffffffff {
        return false;
    }
    let mut size = 64;
    while size > 2 {
        let half = size / 2;
        let mask = ((1 as u64) << half as u64) - 1;
        if (value & mask) != ((value >> half as u64) & mask) {
            break;
        }
        size = half;
    }
    let mask: u64 = if size == 64 { 0xffffffffffffffff } else { ((1 as u64) << size as u64) - 1 };
    let element = value & mask;
    // A rotated run of ones has exactly two transitions, circularly.
    let rotated = ((element >> 1) | (element << (size - 1) as u64)) & mask;
    let transitions = element ^ rotated;
    let mut count = 0;
    let mut bits = transitions;
    while bits != 0 {
        bits &= bits - 1;
        count += 1;
    }
    count == 2
}

pub fn ma_float_op(op: Op, ty: i64, d: i64, a: i64, b: i64) {
    unsafe {
        o(c"    ");
        if op == Add { o(c"fadd "); }
        else if op == Sub { o(c"fsub "); }
        else if op == Mul { o(c"fmul "); }
        else { o(c"fdiv "); }
        ma_f(d, ty);
        o(c", ");
        ma_f(a, ty);
        o(c", ");
        ma_f(b, ty);
        on();
    }
}

pub fn ma_unary(op: Op, ty: i64, d: i64, a: i64) {
    unsafe {
        if op == Neg && is_float(ty) {
            o(c"    fneg ");
            ma_f(d, ty);
            o(c", ");
            ma_f(a, ty);
            on();
            return;
        }
        if op == Neg {
            ma_rr(c"neg", d, a);
        } else if op == Not {
            ma_rr(c"eor", d, a);
            o_back_imm(1);
            return;
        } else {
            ma_rr(c"mvn", d, a);
        }
        ma_normalize(d, ty);
    }
}

fn ma_compare(ty: i64, a: i64, b: i64) {
    unsafe {
        if is_float(ty) {
            o(c"    fcmp ");
            ma_f(a, ty);
            o(c", ");
            ma_f(b, ty);
            on();
        } else {
            ma_rr(c"cmp", a, b);
        }
    }
}

pub fn ma_cmp(op: Cond, ty: i64, d: i64, a: i64, b: i64) {
    unsafe {
        ma_compare(ty, a, b);
        o(c"    cset ");
        ma_r(d);
        o(c", ");
        o(a64_condition(op, is_signed(ty), is_float(ty)));
        on();
    }
}

// Sets the flags from a - imm, |imm| < 4096 (cmn for a negative one).
fn ma_compare_imm(a: i64, imm: i64) {
    unsafe {
        o(if imm < 0 { c"    cmn " } else { c"    cmp " });
        ma_r(a);
        o(c", #");
        oi(if imm < 0 { 0 - imm } else { imm });
        on();
    }
}

// d = (a op imm), integers, |imm| < 4096.
pub fn ma_cmp_imm(op: Cond, ty: i64, d: i64, a: i64, imm: i64) {
    unsafe {
        ma_compare_imm(a, imm);
        o(c"    cset ");
        ma_r(d);
        o(c", ");
        o(a64_condition(op, is_signed(ty), false));
        on();
    }
}

pub fn ma_cmp_branch(op: Cond, ty: i64, a: i64, b: i64, b_is_imm: bool, imm: i64, label: i64) {
    unsafe {
        if b_is_imm && imm == 0 && (op == Cond::Eq || op == Cond::Ne) {
            ma_branch_bool(a, op == Cond::Ne, label);
            return;
        }
        if b_is_imm {
            ma_compare_imm(a, imm);
        } else {
            ma_rr(c"cmp", a, b);
        }
        o(c"    b.");
        o(a64_condition(op, is_signed(ty), false));
        o(c" ");
        a64_label(label);
        on();
    }
}

pub fn ma_branch_bool(r: i64, if_nonzero: bool, label: i64) {
    unsafe {
        o(if if_nonzero { c"    cbnz " } else { c"    cbz " });
        ma_r(r);
        o(c", ");
        a64_label(label);
        on();
    }
}

pub fn ma_conv(from: i64, to: i64, d: i64, src: i64) {
    unsafe {
        if is_float(from) && is_float(to) {
            o(c"    fcvt ");
            ma_f(d, to);
            o(c", ");
            ma_f(src, from);
            on();
            return;
        }
        if is_float(to) {
            o(if is_signed(from) { c"    scvtf " } else { c"    ucvtf " });
            ma_f(d, to);
            o(c", ");
            ma_r(src);
            on();
            return;
        }
        if !is_float(from) {
            if d != src {
                ma_rr(c"mov", d, src);
            }
            ma_normalize(d, to);
            return;
        }
        // Saturating float to integer (see emit_float_to_int).
        if is_signed(to) && int_bits(to) <= 32 {
            o(c"    fcvtzs ");
            ma_w(d);
            o(c", ");
            ma_f(src, from);
            on();
            o(c"    sxtw ");
            ma_r(d);
            o(c", ");
            ma_w(d);
            on();
        } else if to != TY_U64 {
            o(c"    fcvtzs ");
            ma_r(d);
            o(c", ");
            ma_f(src, from);
            on();
        } else {
            // d = value >= 2^63 ? fcvtzu(value) : fcvtzs(value); fcvtzs gives
            // INT64_MAX exactly for those values (no smaller float rounds to
            // it), the one value whose increment overflows.
            o(c"    fcvtzs x16, ");
            ma_f(src, from);
            on();
            o(c"    fcvtzu x17, ");
            ma_f(src, from);
            on();
            ins(c"cmn x16, #1");
            o(c"    csel ");
            ma_r(d);
            o(c", x17, x16, vs\n");
        }
        ma_normalize(d, to);
    }
}

// A jump through a table of 32-bit offsets (from the table) to labels:
// entry `value - low` for register r, the default above the range.
pub fn ma_jump_table(r: i64, low: i64, range: i64, default: i64, table: *i64) {
    unsafe {
        // The index: the value itself when the cases start at 0.
        let index = if low == 0 { r } else { 16 };
        if low != 0 {
            ma_lea(16, r, 0 - low);
        }
        if range - 1 < 4096 {
            o(c"    cmp ");
            ma_r(index);
            o(c", #");
            oi(range - 1);
            on();
        } else {
            a64_load_imm(17, (range - 1) as u64);
            o(c"    cmp ");
            ma_r(index);
            o(c", x17");
            on();
        }
        o(c"    b.hi ");
        a64_label(default);
        on();
        let at = new_label();
        o(c"    adr x17, ");
        a64_label(at);
        on();
        o(c"    ldrsw x16, [x17, ");
        ma_r(index);
        o(c", lsl #2]");
        on();
        ins(c"add x17, x17, x16");
        ins(c"br x17");
        ins(c".p2align 2");
        emit_label(at);
        for i in 0..range {
            o(c"    .long ");
            a64_label(table[i]);
            o(c" - ");
            a64_label(at);
            on();
        }
    }
}

// ---- Machine operations of instruction selection (isel/) ----

// d = c + a * b, or c - a * b.
pub fn ma_madd(sub: bool, ty: i64, d: i64, a: i64, b: i64, c: i64) {
    unsafe {
        o(if sub { c"    msub " } else { c"    madd " });
        ma_r(d);
        o(c", ");
        ma_r(a);
        o(c", ");
        ma_r(b);
        o(c", ");
        ma_r(c);
        on();
        ma_normalize(d, ty);
    }
}

// d = a op (b sh k); `code` is 4 * op + sh (0 lsl, 1 lsr, 2 asr).
pub fn ma_shop(code: i64, ty: i64, d: i64, a: i64, b: i64, k: i64) {
    let op = code / 4;
    let kind = code % 4;
    let mnemonic = if op == Add as i64 { c"add" } else if op == Sub as i64 { c"sub" }
        else if op == And as i64 { c"and" } else if op == Or as i64 { c"orr" } else { c"eor" };
    unsafe {
        ma_rrr(mnemonic, d, a, b);
        BUFS[CODE].len -= 1;
        o(if kind == 0 { c", lsl #" } else if kind == 1 { c", lsr #" } else { c", asr #" });
    }
    oi(k);
    on();
    ma_normalize(d, ty);
}

// d = (a >> k) & (2^n - 1).
pub fn ma_ubfx(d: i64, a: i64, k: i64, n: i64) {
    unsafe {
        ma_rr(c"ubfx", d, a);
        BUFS[CODE].len -= 1;
        o(c", #");
        oi(k);
        o(c", #");
        oi(n);
        on();
    }
}

// Sets the flags from a & b (b < 0: a & mask).
fn ma_tst(a: i64, b: i64, mask: i64) {
    unsafe {
        if b >= 0 {
            ma_rr(c"tst", a, b);
        } else {
            o(c"    tst ");
            ma_r(a);
            o(c", #");
            oi(mask);
            on();
        }
    }
}

// Jumps to `label` when a & b (b < 0: a & mask) is nonzero, or zero.
pub fn ma_test_branch(a: i64, b: i64, mask: i64, if_nonzero: bool, label: i64) {
    unsafe {
        if b < 0 && mask > 0 && (mask & (mask - 1)) == 0 && SHORT_BRANCHES {
            o(if if_nonzero { c"    tbnz " } else { c"    tbz " });
            ma_r(a);
            o(c", #");
            oi(log2(mask));
            o(c", ");
            a64_label(label);
            on();
            return;
        }
        ma_tst(a, b, mask);
        o(if if_nonzero { c"    b.ne " } else { c"    b.eq " });
        a64_label(label);
        on();
    }
}

// d = (lhs op rhs) ? then : other (other + 1 when `increment`), or
// (lhs & rhs) op 0 when `test` (rhs < 0: the immediate imm); cmp_ty is the
// type compared, ty the selected; the flags are already set unless
// `compare`.
pub fn ma_select(op: Cond, test: bool, compare: bool, cmp_ty: i64, lhs: i64, rhs: i64, imm: i64,
    ty: i64, d: i64, then: i64, other: i64, increment: bool) {
    unsafe {
        if !compare {
        } else if test {
            ma_tst(lhs, rhs, imm);
        } else if is_float(cmp_ty) {
            ma_compare(cmp_ty, lhs, rhs);
        } else if rhs < 0 {
            ma_compare_imm(lhs, imm);
        } else {
            ma_rr(c"cmp", lhs, rhs);
        }
        let condition = a64_condition(op, is_signed(cmp_ty), is_float(cmp_ty) && !test);
        if is_float(ty) {
            o(c"    fcsel ");
            ma_f(d, ty);
            o(c", ");
            ma_f(then, ty);
            o(c", ");
            ma_f(other, ty);
        } else {
            o(if increment { c"    csinc " } else { c"    csel " });
            ma_r(d);
            o(c", ");
            ma_r_or_zero(then);
            o(c", ");
            ma_r_or_zero(other);
        }
        o(c", ");
        o(condition);
        on();
    }
}

// x<r>, or xzr for -1.
fn ma_r_or_zero(r: i64) {
    if r < 0 {
        unsafe { o(c"xzr"); }
    } else {
        ma_r(r);
    }
}

// Stores (or loads) registers r and s at [sp, #offset] and [sp, #offset +
// 8]: x or d registers alike.
pub fn ma_pair(load: bool, r: i64, s: i64, offset: i64) {
    unsafe {
        o(if load { c"    ldp " } else { c"    stp " });
        if r >= 32 {
            ma_f(r, TY_F64);
            o(c", ");
            ma_f(s, TY_F64);
        } else {
            ma_r(r);
            o(c", ");
            ma_r(s);
        }
        o(c", [sp");
        if offset != 0 {
            o(c", #");
            oi(offset);
        }
        o(c"]\n");
    }
}

// d = sqrt, fabs, floor, ceil, trunc or round (kind 0 to 5) of a.
pub fn ma_fmath(kind: i64, ty: i64, d: i64, a: i64) {
    unsafe {
        o(if kind == 0 { c"    fsqrt " } else if kind == 1 { c"    fabs " }
            else if kind == 2 { c"    frintm " } else if kind == 3 { c"    frintp " }
            else if kind == 4 { c"    frintz " } else { c"    frinta " });
        ma_f(d, ty);
        o(c", ");
        ma_f(a, ty);
        on();
    }
}
