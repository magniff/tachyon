// Operands and results (emit/mod.tach): values put in registers where an
// instruction reads them, results put where the allocation wants them,
// and the parallel moves that put values in place.

use crate::back::emit::machine::{
    m_extern_addr, m_lea, m_load, m_load_fimm, m_load_imm, m_mov, m_store, m_string_addr,
    m_symbol_addr, reg_cycle, reg_fp, reg_move_temp, reg_sp, spill_offset, spill_type,
};
use crate::back::regalloc::{LOC_NONE, LOC_REMAT};
use crate::back::regalloc::locations::{stored_at_def, vloc};
use crate::back::regalloc::prepare::tracked;
use crate::base::{buf_byte, die};
use crate::front::types::{FNS, STATICS, SYM_STATIC, in_fregs, is_float};
use crate::gen0::gen::{fn_symbol_prefix, static_symbol_prefix};
use crate::gen0::target::{oi, on};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::Op;
use crate::middle::ir::Op::{Const, GAddr, SAddr, Slot};

// ---- Operands and results ----

// Rematerializes value `v` (is_remat_op) into register `r`.
pub fn materialize(mut cx: *FnCtx, v: i64, r: i64) {
    unsafe {
        let op = cx.insts[v].op;
        let imm = cx.insts[v].imm;
        if op == Const {
            if is_float(cx.insts[v].ty) {
                m_load_fimm(cx, r, imm, cx.insts[v].ty);
            } else {
                m_load_imm(cx, r, imm as u64);
            }
        } else if op == Slot {
            m_lea(cx, r, reg_sp(), cx.slots[imm].offset);
        } else if op == GAddr {
            let st = SYM_STATIC[imm] - 1;
            if STATICS[st].linkage == 1 {
                m_extern_addr(cx, r, imm);
            } else {
                m_symbol_addr(cx, r, static_symbol_prefix(st), imm);
            }
        } else if op == SAddr {
            m_string_addr(cx, r, imm);
        } else if op == Op::RtId {
            // (0.18.1) A line the join makes `mov r, #N` (m_load_imm) of the
            // program's number for it: \x04r,i, i its index in the text's.
            let mut i = 0;
            while i < cx.text_rtids.count && cx.text_rtids.data[i] != imm {
                i += 1;
            }
            if i == cx.text_rtids.count {
                cx.text_rtids.push(imm);
            }
            buf_byte(cx.code, 4);
            oi(cx, r);
            buf_byte(cx.code, ',');
            oi(cx, i);
            on(cx);
        } else if FNS[imm].is_extern {
            m_extern_addr(cx, r, FNS[imm].name);
        } else {
            m_symbol_addr(cx, r, fn_symbol_prefix(imm), FNS[imm].name);
        }
    }
}

// The register holding value `v`, an operand of the instruction being
// emitted that needs one.
fn use_reg(mut cx: *FnCtx, v: i64) -> i64 {
    let loc = unsafe { vloc(cx, v, cx.cur_pos) };
    if loc < 0 || loc >= 64 {
        unsafe { die(c"internal error: an operand not in a register"); }
    }
    loc
}

// Value `v`, used at `pos` where it may be anywhere, in a register: its
// own, or `scratch` after loading or rematerializing it there.
pub fn use_any(mut cx: *FnCtx, v: i64, pos: i64, scratch: i64) -> i64 {
    unsafe {
        if cx.insts[v].op.is_remat() {
            materialize(cx, v, scratch);
            return scratch;
        }
        let loc = vloc(cx, v, pos);
        if loc == LOC_NONE || loc == LOC_REMAT {
            die(c"internal error: operand without a location");
        }
        if loc >= 0 {
            return loc;
        }
        m_load(cx, spill_type(cx.insts[v].ty), scratch, reg_sp(), spill_offset(cx, loc));
        scratch
    }
}

// Value `v` (used at `pos`) in register `r` exactly.
pub fn use_into(mut cx: *FnCtx, v: i64, pos: i64, r: i64) {
    let got = use_any(cx, v, pos, r);
    unsafe { m_mov(cx, r, got, cx.insts[v].ty); }
}

pub fn int_operand(mut cx: *FnCtx, v: i64) -> i64 {
    use_reg(cx, v)
}

pub fn float_operand(mut cx: *FnCtx, v: i64) -> i64 {
    use_reg(cx, v)
}

pub fn operand_reg(mut cx: *FnCtx, v: i64) -> i64 {
    use_reg(cx, v)
}

// Where the result of `v` is computed.
pub fn result_reg(mut cx: *FnCtx, v: i64) -> i64 {
    let loc = unsafe { vloc(cx, v, cx.cur_pos + 2) };
    if loc < 0 || loc >= 64 {
        unsafe { die(c"internal error: a result not in a register"); }
    }
    loc
}

// Stores the result into its spill slot when it goes to the stack.
pub fn result_done(mut cx: *FnCtx, v: i64, r: i64) {
    let t = tracked(cx, v);
    if t >= 0 && stored_at_def(cx, t) {
        unsafe {
            m_store(cx, spill_type(cx.insts[v].ty), r, reg_sp(),
                spill_offset(cx, 0 - (1 + cx.rv_slot[t])));
        }
    }
}

// Whether `v` is a constant (and its value in *value).
pub fn const_of(mut cx: *FnCtx, v: i64, value: &mut i64) -> bool {
    unsafe {
        if cx.insts[v].op == Const {
            *value = cx.insts[v].imm;
            return true;
        }
        false
    }
}

// ---- Parallel moves ----

// Pending moves: destination location, kind, source, type, done, the value
// read and the value written (for the checker). Kinds: a location, a
// rematerialized value, a stack argument of the caller (the source is an
// offset from the frame pointer), the address of one.
pub const PM_LOC: i64 = 0;

pub const PM_REMAT: i64 = 1;

pub const PM_STACK: i64 = 2;

pub const PM_ADDR: i64 = 3;

pub const PM_FIELDS: i64 = 7;

// (A move to its own location is kept: for the checker, the location then
// holds the value written, as a phi takes its operand's register.)
pub fn pm_add(mut cx: *FnCtx, dst: i64, kind: i64, src: i64, ty: i64, value: i64, result: i64) {
    unsafe {
        cx.pm.push(dst);
        cx.pm.push(kind);
        cx.pm.push(src);
        cx.pm.push(ty);
        // Not done.
        cx.pm.push(0);
        cx.pm.push(value);
        cx.pm.push(result);
    }
}

pub fn pm_dst(mut cx: *FnCtx, i: i64) -> i64 { unsafe { cx.pm.data[i * PM_FIELDS] } }

pub fn pm_kind(mut cx: *FnCtx, i: i64) -> i64 { unsafe { cx.pm.data[i * PM_FIELDS + 1] } }

pub fn pm_src(mut cx: *FnCtx, i: i64) -> i64 { unsafe { cx.pm.data[i * PM_FIELDS + 2] } }

fn pm_ty(mut cx: *FnCtx, i: i64) -> i64 { unsafe { cx.pm.data[i * PM_FIELDS + 3] } }

fn pm_done(mut cx: *FnCtx, i: i64) -> bool { unsafe { cx.pm.data[i * PM_FIELDS + 4] != 0 } }

pub fn pm_value(mut cx: *FnCtx, i: i64) -> i64 { unsafe { cx.pm.data[i * PM_FIELDS + 5] } }

pub fn pm_result(mut cx: *FnCtx, i: i64) -> i64 { unsafe { cx.pm.data[i * PM_FIELDS + 6] } }

// Moves location `src` to location `dst` (a value of type `ty`).
fn move_loc(mut cx: *FnCtx, dst: i64, src: i64, ty: i64) {
    if dst == src {
        return;
    }
    let st = spill_type(ty);
    if dst >= 0 && src >= 0 {
        m_mov(cx, dst, src, ty);
    } else if dst >= 0 {
        m_load(cx, st, dst, reg_sp(), spill_offset(cx, src));
    } else if src >= 0 {
        m_store(cx, st, src, reg_sp(), spill_offset(cx, dst));
    } else {
        let temp = reg_move_temp(in_fregs(ty));
        m_load(cx, st, temp, reg_sp(), spill_offset(cx, src));
        m_store(cx, st, temp, reg_sp(), spill_offset(cx, dst));
    }
}

// Whether location `loc` is the source of a pending location move other
// than move `except`.
fn pm_is_source(mut cx: *FnCtx, loc: i64, except: i64) -> bool {
    let n = unsafe { cx.pm.count / PM_FIELDS };
    for j in 0..n {
        if j != except && !pm_done(cx, j) && pm_kind(cx, j) == PM_LOC && pm_src(cx, j) == loc {
            return true;
        }
    }
    false
}

// Emits every pending move, then clears them.
pub fn pm_resolve(mut cx: *FnCtx) {
    unsafe {
        let n = cx.pm.count / PM_FIELDS;
        for i in 0..n {
            if pm_kind(cx, i) == PM_LOC && pm_dst(cx, i) == pm_src(cx, i) {
                cx.pm.data[i * PM_FIELDS + 4] = 1;
            }
        }
        loop {
            let mut pending = false;
            let mut progress = false;
            for i in 0..n {
                if pm_done(cx, i) || pm_kind(cx, i) != PM_LOC {
                    continue;
                }
                pending = true;
                if !pm_is_source(cx, pm_dst(cx, i), i) {
                    move_loc(cx, pm_dst(cx, i), pm_src(cx, i), pm_ty(cx, i));
                    cx.pm.data[i * PM_FIELDS + 4] = 1;
                    progress = true;
                }
            }
            if !pending {
                break;
            }
            if progress {
                continue;
            }
            // Only cycles are left: save one destination's current value in
            // the cycle register, and read it from there instead.
            let mut i = 0;
            while pm_done(cx, i) || pm_kind(cx, i) != PM_LOC {
                i += 1;
            }
            let d = pm_dst(cx, i);
            let temp = reg_cycle(in_fregs(pm_ty(cx, i)));
            if pm_is_source(cx, temp, -1) {
                die(c"internal error: parallel move cycle register in use");
            }
            move_loc(cx, temp, d, pm_ty(cx, i));
            for j in 0..n {
                if !pm_done(cx, j) && pm_kind(cx, j) == PM_LOC && pm_src(cx, j) == d {
                    cx.pm.data[j * PM_FIELDS + 2] = temp;
                }
            }
        }
        for i in 0..n {
            if pm_done(cx, i) || pm_kind(cx, i) == PM_LOC {
                continue;
            }
            let dst = pm_dst(cx, i);
            let ty = pm_ty(cx, i);
            let r = if dst >= 0 { dst } else { reg_move_temp(in_fregs(ty)) };
            if pm_kind(cx, i) == PM_REMAT {
                materialize(cx, pm_src(cx, i), r);
            } else if pm_kind(cx, i) == PM_ADDR {
                m_lea(cx, r, reg_fp(), pm_src(cx, i));
            } else {
                m_load(cx, ty, r, reg_fp(), pm_src(cx, i));
            }
            if dst < 0 {
                m_store(cx, spill_type(ty), r, reg_sp(), spill_offset(cx, dst));
            }
        }
        cx.pm.count = 0;
    }
}

// Adds the move of value `v` (where it is at `pos`) into location `dst`.
pub fn pm_add_value(mut cx: *FnCtx, dst: i64, v: i64, pos: i64) {
    unsafe {
        if cx.insts[v].op.is_remat() {
            pm_add(cx, dst, PM_REMAT, v, cx.insts[v].ty, v, v);
        } else {
            pm_add(cx, dst, PM_LOC, vloc(cx, v, pos), cx.insts[v].ty, v, v);
        }
    }
}
