// Operands and results (emit/mod.tach): values put in registers where an
// instruction reads them, results put where the allocation wants them,
// and the parallel moves that put values in place.

use crate::back::emit::machine::{
    m_extern_addr, m_lea, m_load, m_load_fimm, m_load_imm, m_mov, m_store, m_string_addr,
    m_symbol_addr, reg_cycle, reg_fp, reg_move_temp, reg_sp, spill_offset, spill_type,
};
use crate::back::regalloc::{LOC_NONE, LOC_REMAT, RV_SLOT};
use crate::back::regalloc::locations::{stored_at_def, vloc};
use crate::back::regalloc::prepare::tracked;
use crate::base::{IntVec, die};
use crate::front::types::{FNS, STATICS, SYM_STATIC, in_fregs, is_float};
use crate::gen0::gen::{fn_symbol_prefix, static_symbol_prefix};
use crate::middle::ir::{INSTS, SLOTS};
use crate::middle::ir::Op::{Const, GAddr, SAddr, Slot};

// ---- Operands and results ----

// The position of the instruction being emitted.
pub static mut CUR_POS: i64 = 0;

// Rematerializes value `v` (is_remat_op) into register `r`.
pub fn materialize(v: i64, r: i64) {
    unsafe {
        let op = INSTS[v].op;
        let imm = INSTS[v].imm;
        if op == Const {
            if is_float(INSTS[v].ty) {
                m_load_fimm(r, imm, INSTS[v].ty);
            } else {
                m_load_imm(r, imm as u64);
            }
        } else if op == Slot {
            m_lea(r, reg_sp(), SLOTS[imm].offset);
        } else if op == GAddr {
            let st = SYM_STATIC[imm] - 1;
            if STATICS[st].linkage == 1 {
                m_extern_addr(r, imm);
            } else {
                m_symbol_addr(r, static_symbol_prefix(st), imm);
            }
        } else if op == SAddr {
            m_string_addr(r, imm);
        } else if FNS[imm].is_extern {
            m_extern_addr(r, FNS[imm].name);
        } else {
            m_symbol_addr(r, fn_symbol_prefix(imm), FNS[imm].name);
        }
    }
}

// The register holding value `v`, an operand of the instruction being
// emitted that needs one.
fn use_reg(v: i64) -> i64 {
    let loc = vloc(v, CUR_POS);
    if loc < 0 || loc >= 64 {
        unsafe { die(c"internal error: an operand not in a register"); }
    }
    loc
}

// Value `v`, used at `pos` where it may be anywhere, in a register: its
// own, or `scratch` after loading or rematerializing it there.
pub fn use_any(v: i64, pos: i64, scratch: i64) -> i64 {
    unsafe {
        if INSTS[v].op.is_remat() {
            materialize(v, scratch);
            return scratch;
        }
        let loc = vloc(v, pos);
        if loc == LOC_NONE || loc == LOC_REMAT {
            die(c"internal error: operand without a location");
        }
        if loc >= 0 {
            return loc;
        }
        m_load(spill_type(INSTS[v].ty), scratch, reg_sp(), spill_offset(loc));
        scratch
    }
}

// Value `v` (used at `pos`) in register `r` exactly.
pub fn use_into(v: i64, pos: i64, r: i64) {
    let got = use_any(v, pos, r);
    unsafe { m_mov(r, got, INSTS[v].ty); }
}

pub fn int_operand(v: i64) -> i64 {
    use_reg(v)
}

pub fn float_operand(v: i64) -> i64 {
    use_reg(v)
}

pub fn operand_reg(v: i64) -> i64 {
    use_reg(v)
}

// Where the result of `v` is computed.
pub fn result_reg(v: i64) -> i64 {
    let loc = vloc(v, CUR_POS + 2);
    if loc < 0 || loc >= 64 {
        unsafe { die(c"internal error: a result not in a register"); }
    }
    loc
}

// Stores the result into its spill slot when it goes to the stack.
pub fn result_done(v: i64, r: i64) {
    let t = tracked(v);
    if t >= 0 && stored_at_def(t) {
        unsafe {
            m_store(spill_type(INSTS[v].ty), r, reg_sp(), spill_offset(0 - (1 + RV_SLOT[t])));
        }
    }
}

// Whether `v` is a constant (and its value in *value).
pub fn const_of(v: i64, value: *i64) -> bool {
    unsafe {
        if INSTS[v].op == Const {
            *value = INSTS[v].imm;
            return true;
        }
        false
    }
}

// ---- Parallel moves ----

// Pending moves: destination location, kind, source, type, done, the value
// read and the value written (for the checker). Kinds: a location, a
// rematerialized value, a stack argument of the caller (the source is an
// offset from the frame pointer), the address of one.
pub const PM_LOC: i64 = 0;

pub const PM_REMAT: i64 = 1;

pub const PM_STACK: i64 = 2;

pub const PM_ADDR: i64 = 3;

pub const PM_FIELDS: i64 = 7;

pub static mut PM: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// (A move to its own location is kept: for the checker, the location then
// holds the value written, as a phi takes its operand's register.)
pub fn pm_add(dst: i64, kind: i64, src: i64, ty: i64, value: i64, result: i64) {
    PM.push(dst);
    PM.push(kind);
    PM.push(src);
    PM.push(ty);
    // Not done.
    PM.push(0);
    PM.push(value);
    PM.push(result);
}

pub fn pm_dst(i: i64) -> i64 { unsafe { PM.data[i * PM_FIELDS] } }

pub fn pm_kind(i: i64) -> i64 { unsafe { PM.data[i * PM_FIELDS + 1] } }

pub fn pm_src(i: i64) -> i64 { unsafe { PM.data[i * PM_FIELDS + 2] } }

fn pm_ty(i: i64) -> i64 { unsafe { PM.data[i * PM_FIELDS + 3] } }

fn pm_done(i: i64) -> bool { unsafe { PM.data[i * PM_FIELDS + 4] != 0 } }

pub fn pm_value(i: i64) -> i64 { unsafe { PM.data[i * PM_FIELDS + 5] } }

pub fn pm_result(i: i64) -> i64 { unsafe { PM.data[i * PM_FIELDS + 6] } }

// Moves location `src` to location `dst` (a value of type `ty`).
fn move_loc(dst: i64, src: i64, ty: i64) {
    if dst == src {
        return;
    }
    let st = spill_type(ty);
    if dst >= 0 && src >= 0 {
        m_mov(dst, src, ty);
    } else if dst >= 0 {
        m_load(st, dst, reg_sp(), spill_offset(src));
    } else if src >= 0 {
        m_store(st, src, reg_sp(), spill_offset(dst));
    } else {
        let temp = reg_move_temp(in_fregs(ty));
        m_load(st, temp, reg_sp(), spill_offset(src));
        m_store(st, temp, reg_sp(), spill_offset(dst));
    }
}

// Whether location `loc` is the source of a pending location move other
// than move `except`.
fn pm_is_source(loc: i64, except: i64) -> bool {
    let n = PM.count / PM_FIELDS;
    for j in 0..n {
        if j != except && !pm_done(j) && pm_kind(j) == PM_LOC && pm_src(j) == loc {
            return true;
        }
    }
    false
}

// Emits every pending move, then clears them.
pub fn pm_resolve() {
    unsafe {
        let n = PM.count / PM_FIELDS;
        for i in 0..n {
            if pm_kind(i) == PM_LOC && pm_dst(i) == pm_src(i) {
                PM.data[i * PM_FIELDS + 4] = 1;
            }
        }
        loop {
            let mut pending = false;
            let mut progress = false;
            for i in 0..n {
                if pm_done(i) || pm_kind(i) != PM_LOC {
                    continue;
                }
                pending = true;
                if !pm_is_source(pm_dst(i), i) {
                    move_loc(pm_dst(i), pm_src(i), pm_ty(i));
                    PM.data[i * PM_FIELDS + 4] = 1;
                    progress = true;
                }
            }
            if !pending {
                break;
            }
            if progress {
                continue;
            }
            // Only cycles are left: save one destination's current value in
            // the cycle register, and read it from there instead.
            let mut i = 0;
            while pm_done(i) || pm_kind(i) != PM_LOC {
                i += 1;
            }
            let d = pm_dst(i);
            let temp = reg_cycle(in_fregs(pm_ty(i)));
            if pm_is_source(temp, -1) {
                die(c"internal error: parallel move cycle register in use");
            }
            move_loc(temp, d, pm_ty(i));
            for j in 0..n {
                if !pm_done(j) && pm_kind(j) == PM_LOC && pm_src(j) == d {
                    PM.data[j * PM_FIELDS + 2] = temp;
                }
            }
        }
        for i in 0..n {
            if pm_done(i) || pm_kind(i) == PM_LOC {
                continue;
            }
            let dst = pm_dst(i);
            let ty = pm_ty(i);
            let r = if dst >= 0 { dst } else { reg_move_temp(in_fregs(ty)) };
            if pm_kind(i) == PM_REMAT {
                materialize(pm_src(i), r);
            } else if pm_kind(i) == PM_ADDR {
                m_lea(r, reg_fp(), pm_src(i));
            } else {
                m_load(ty, r, reg_fp(), pm_src(i));
            }
            if dst < 0 {
                m_store(spill_type(ty), r, reg_sp(), spill_offset(dst));
            }
        }
        PM.count = 0;
    }
}

// Adds the move of value `v` (where it is at `pos`) into location `dst`.
pub fn pm_add_value(dst: i64, v: i64, pos: i64) {
    unsafe {
        if INSTS[v].op.is_remat() {
            pm_add(dst, PM_REMAT, v, INSTS[v].ty, v, v);
        } else {
            pm_add(dst, PM_LOC, vloc(v, pos), INSTS[v].ty, v, v);
        }
    }
}
