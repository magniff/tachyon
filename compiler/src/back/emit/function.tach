// A function's code around its blocks (emit/mod.tach): the frame layout,
// callee-saved registers, the parameters' locations and the entry moves,
// gen_ir_function, debug line locations, returns and the epilogue, and
// shrink-wrapping.

use crate::back::abi::{
    AbiClass, abi_piece_locations, abi_stack_location, conv_classify, conv_returns_through_pointer,
    fn_uses_c,
};
use crate::back::dwarf::{dbg_function_begin, dbg_function_end, dbg_loc};
use crate::back::emit::blocks::{emit_ir_block, find_trivial_jumps};
use crate::back::emit::calls::{call_stack_size, callee_param, callee_param_count};
use crate::back::emit::machine::{
    arg_reg, conv_result_ptr_reg, m_jump, m_load, m_normalize, m_store, reg_move_temp, reg_sp,
    spill_offset, t_arg_location, xl_from_c, xl_is_stack, xl_offset,
};
use crate::back::emit::operands::{PM_ADDR, PM_LOC, PM_STACK, pm_add, pm_resolve, result_done};
use crate::back::emit::stats::{STATS, ST_FRAME, ST_FRAMES, ST_SAVES, st_function_done};
use crate::back::isel::select_function;
use crate::back::layout::layout_emission;
use crate::back::mc_arm64::{ma_frame_link, ma_frame_unlink};
use crate::back::mc_arm64::ops::ma_pair;
use crate::back::mc_x86_64::{mx_frame_link, mx_frame_unlink};
use crate::back::objfile::asm_flush;
use crate::back::regalloc::{LOC_NONE, VERIFY_REGALLOC, allocate_registers};
use crate::back::regalloc::check::check_allocation;
use crate::back::regalloc::locations::{mark_frame_blocks, tloc, vloc};
use crate::back::regalloc::prepare::{count_uses, is_emitted, tracked};
use crate::base::{BUFS, IntVec, buf_bytes, buf_clear, buf_slice, die, free, memcmp, strlen};
use crate::base::target::X86;
use crate::base::timer::{T_CODEGEN, T_ISEL, T_SCALAR, timer_add, timer_now};
use crate::front::ast::NODES;
use crate::front::types::{
    FNS, TY_BOOL, TY_F64, TY_U64, TY_U8, align_to, fn_param, int_bits, is_compound, is_integer,
    is_void, max_i64, scalar_type, type_align,
};
use crate::gen0::arm64::{a64_align_down, a64_epilogue, a64_frame_reserve};
use crate::gen0::gen::{fn_is_global, fn_symbol_prefix};
use crate::gen0::target::{
    LABEL_COUNT, arg_location, emit_function_start, emit_label, first_int_arg, ins, new_label,
};
use crate::gen0::x86_64::{x64_epilogue, x64_frame_reserve, x64_imm};
use crate::middle::ctx::FnCtx;
use crate::middle::inline::{FN_LIVE, leaf_dropped, leaf_kept};
use crate::middle::ir::{
    IRFUNCS, IRFUNC_COUNT, Term, VARIADIC_PIECE, ir_enter, ir_free_func, ir_operand,
    ir_operand_count,
};
use crate::middle::ir::Op::{CallC, Param, Phi, Slot};
use crate::middle::ir::cfg::{succ, succ_count};
use crate::middle::opt::{PER_FUNCTION, optimize_function};

// ---- Functions ----

fn layout_frame(mut cx: *FnCtx, fi: i64) {
    unsafe {
        cx.frame_out = 0;
        cx.frame_align = 16;
        cx.has_calls = false;
        cx.uses_slots = false;
        // Slots no instruction refers to any more (scalar replacement took
        // them apart) get no room: offset -1.
        for i in 0..IRFUNCS[fi].slots.count {
            cx.slots[IRFUNCS[fi].slots.data[i]].offset = -1;
        }
        for i in 0..cx.order.count {
            let mut v = cx.blocks[cx.order.data[i]].first;
            while v != 0 {
                if cx.insts[v].op.is_call() && is_emitted(cx, v) {
                    cx.has_calls = true;
                }
                if cx.insts[v].op == Slot && cx.regalloc_uses[v] > 0 {
                    cx.slots[cx.insts[v].imm].offset = 0;
                    cx.uses_slots = true;
                }
                if cx.insts[v].op.is_call() {
                    let size = call_stack_size(cx, v);
                    if size > cx.frame_out {
                        cx.frame_out = size;
                    }
                    if cx.insts[v].op != CallC {
                        for k in 0..callee_param_count(cx, v) {
                            cx.frame_align = max_i64(cx.frame_align,
                                type_align(callee_param(cx, v, k)));
                        }
                    }
                    // Aggregates passed to `...` (their first piece carries the
                    // type, negated).
                    for k in 0..cx.insts[v].nargs {
                        let declared = cx.argty.data[cx.insts[v].args + k];
                        if declared < 0 && declared != VARIADIC_PIECE {
                            cx.frame_align = max_i64(cx.frame_align, type_align(0 - declared));
                        }
                    }
                }
                v = cx.insts[v].next;
            }
        }
        let mut offset = align_to(cx.frame_out, if cx.spill_vectors { 16 } else { 8 });
        cx.spill_base = offset;
        offset += 8 * cx.spill_count;
        cx.save_base = offset;
        offset += 8 * cx.callee_used[0..64].iter().filter(|u| u != 0).count();
        if offset > 32760 {
            die(c"internal error: too many spill slots");
        }
        for s in IRFUNCS[fi].slots.items() {
            if cx.slots[s].offset < 0 {
                continue;
            }
            offset = align_to(offset, cx.slots[s].align);
            cx.slots[s].offset = offset;
            offset += cx.slots[s].size;
            cx.frame_align = max_i64(cx.frame_align, cx.slots[s].align);
        }
        cx.frame_total = align_to(offset, 16);
    }
}

// Saves (or restores) the callee-saved registers used: on AArch64 two at
// a time (stp, ldp) when they are of one kind.
fn save_callee_saved(mut cx: *FnCtx, restore: bool) {
    unsafe {
        let mut offset = cx.save_base;
        let mut pending = -1;
        for r in 0..64 {
            if cx.callee_used[r] == 0 {
                continue;
            }
            if !X86 && pending >= 0 && (pending >= 32) == (r >= 32) && offset - 8 <= 504 {
                ma_pair(cx, restore, pending, r, offset - 8);
                pending = -1;
            } else {
                if pending >= 0 {
                    save_one(cx, restore, pending, offset - 8);
                }
                pending = r;
            }
            offset += 8;
        }
        if pending >= 0 {
            save_one(cx, restore, pending, offset - 8);
        }
    }
}

fn save_one(mut cx: *FnCtx, restore: bool, r: i64, offset: i64) {
    let ty = if r >= 32 { TY_F64 } else { TY_U64 };
    if restore {
        m_load(cx, ty, r, reg_sp(), offset);
    } else {
        m_store(cx, ty, r, reg_sp(), offset);
    }
}

// The location of each parameter of function `f` (by its convention): of
// parameter i at locations[i], or of its pieces at pieces[4 * i + k] (see
// abi.tach).
pub fn param_locations(mut cx: *FnCtx, f: i64, locations: *i64, pieces: *i64) {
    unsafe {
        let c = fn_uses_c(f);
        let ret = FNS[f].ret;
        let first = if c { first_int_arg(cx, ret) }
            else if conv_returns_through_pointer(cx, false, ret) { 1 } else { 0 };
        let mut state: [i64; 3] = [first, 0, 0];
        for i in 0..FNS[f].param_count {
            let ty = fn_param(f, i);
            if is_void(ty) {
                continue;
            }
            let kind = conv_classify(cx, c, ty);
            if !c {
                if kind == AbiClass::Pieces {
                    for k in 0..cx.abi_piece_count {
                        pieces[4 * i + k] = t_arg_location(cx.abi_piece_ty[k], &state as *i64);
                    }
                } else {
                    locations[i] = t_arg_location(if kind == AbiClass::Ref { TY_U64 }
                        else { scalar_type(ty) }, &state as *i64);
                }
                continue;
            }
            if kind == AbiClass::Pieces {
                abi_piece_locations(cx, ty, &state as *i64, &pieces[4 * i]);
                for k in 0..cx.abi_piece_count {
                    pieces[4 * i + k] = xl_from_c(pieces[4 * i + k]);
                }
            } else if kind == AbiClass::Stack {
                locations[i] = xl_from_c(abi_stack_location(ty, &state as *i64));
            } else {
                locations[i] = xl_from_c(arg_location(if kind == AbiClass::Ref { TY_U64 }
                    else { scalar_type(ty) }, &state as *i64));
            }
        }
    }
}

// Moves the parameters from where the caller put them to their locations.
fn emit_entry_moves(mut cx: *FnCtx, fi: i64) {
    unsafe {
        let f = IRFUNCS[fi].f;
        let mut locations: [i64; 64] = [0; 64];
        let mut pieces: [i64; 256] = [0; 256];
        if FNS[f].param_count > 64 {
            die(c"too many parameters (at most 64 are supported)");
        }
        param_locations(cx, f, &locations as *i64, &pieces as *i64);
        let entry = IRFUNCS[fi].entry;
        let mut v = cx.blocks[entry].first;
        while v != 0 {
            let loc = vloc(cx, v, 0);
            if cx.insts[v].op == Param && loc != LOC_NONE {
                let ty = cx.insts[v].ty;
                let index = cx.insts[v].imm;
                let piece = cx.insts[v].imm2;
                if index < 0 {
                    pm_add(cx, loc, PM_LOC, conv_result_ptr_reg(fn_uses_c(f)), TY_U64, 0, v);
                } else {
                    let location = if piece > 0 { pieces[4 * index + piece - 1] }
                        else { locations[index] };
                    // Stack arguments are 16 bytes above the frame pointer.
                    if piece < 0 {
                        pm_add(cx, loc, PM_ADDR, 16 + xl_offset(location), TY_U64, 0, v);
                    } else if xl_is_stack(location) {
                        let param_ty = fn_param(f, index);
                        let load_ty = if is_compound(param_ty) && piece == 0 { TY_U64 } else { ty };
                        pm_add(cx, loc, PM_STACK, 16 + xl_offset(location), load_ty, 0, v);
                    } else {
                        pm_add(cx, loc, PM_LOC, arg_reg(location), ty, 0, v);
                    }
                }
            }
            v = cx.insts[v].next;
        }
        pm_resolve(cx);
        // Narrow integers from C callers may carry garbage above their width;
        // parameters that go to the stack are stored there.
        v = cx.blocks[entry].first;
        while v != 0 {
            let ty = cx.insts[v].ty;
            let t = tracked(cx, v);
            if cx.insts[v].op == Param && t >= 0 {
                let narrow = cx.insts[v].imm >= 0
                    && (ty == TY_BOOL || (is_integer(ty) && int_bits(ty) < 64));
                let loc = tloc(cx, t, 0);
                if loc >= 0 {
                    if narrow {
                        m_normalize(cx, loc, if ty == TY_BOOL { TY_U8 } else { ty });
                    }
                    result_done(cx, v, loc);
                } else if narrow {
                    let r = reg_move_temp(float: false);
                    m_load(cx, TY_U64, r, reg_sp(), spill_offset(cx, loc));
                    m_normalize(cx, r, if ty == TY_BOOL { TY_U8 } else { ty });
                    m_store(cx, TY_U64, r, reg_sp(), spill_offset(cx, loc));
                }
            }
            v = cx.insts[v].next;
        }
    }
}

pub fn gen_ir_function(mut cx: *FnCtx, fi: i64) {
    unsafe {
        ir_enter(cx, fi);
        let f = IRFUNCS[fi].f;
        allocate_registers(cx, fi);
        if VERIFY_REGALLOC {
            check_allocation(cx, fi);
        }
        layout_frame(cx, fi);
        shrink_wrap(cx, fi);
        cx.short_branches = function_size(cx, fi) <= 800;
        find_trivial_jumps(cx);
        layout_emission(cx);
        buf_clear(cx.code);
        // The peepholes' memory of what was just emitted belongs to the code of
        // the function before (whose length the new one's may match).
        cx.last_mov_end = -1;
        cx.last_store_end = -1;
        cx.pair_end = -1;
        cx.last_select = 0;
        cx.last_select_end = -1;
        cx.label_base = LABEL_COUNT + 1;
        LABEL_COUNT += cx.order.count;
        cx.epilogue_label = new_label();
        cx.epilogue_used = false;
        cx.fell_into_epilogue = false;
        cx.has_frame = cx.save >= 0;
        cx.last_loc = 0;
        let item = IRFUNCS[fi].item;
        dbg_function_begin(cx, f, fn_symbol_prefix(f),
            if item > 0 { NODES[item].start } else { -1 });
        ir_function_start(cx, fn_symbol_prefix(f), FNS[f].name, fn_is_global(f), cx.save == 0);
        cx.cur_in_frame = cx.save == 0;
        if cx.save == 0 {
            emit_frame_setup(cx);
        }
        emit_entry_moves(cx, fi);
        for j in 0..cx.emit.count {
            emit_ir_block(cx, cx.emit.data[j], j);
        }
        // The epilogue, when a block jumps to it or the last one falls into it
        // (blocks in the frame's region only).
        if cx.epilogue_used || cx.fell_into_epilogue {
            cx.cur_in_frame = true;
            emit_label(cx, cx.epilogue_label);
            emit_ir_epilogue(cx);
        }
        if STATS > 0 {
            if cx.has_frame {
                cx.st_fn[ST_FRAMES] = 1;
                cx.st_fn[ST_FRAME] = cx.frame_total + 16;
            }
            cx.st_fn[ST_SAVES] += cx.callee_used[0..64].iter().filter(|u| u != 0).count();
            st_function_done(cx, fi);
        }
        buf_bytes(cx.asm, buf_slice(cx.code));
        dbg_function_end(cx);
    }
}

// (0.17) Every live IR function, in order: at -O1 (PER_FUNCTION) the small
// leaves' calls inlined and the scalar pipeline run here, then
// instruction selection, register allocation and emission, end to end;
// each function's IR is freed once it is emitted (or dropped), so the IR
// in flight is one function's, at -O2 the optimized program's at most.
// -O1's small leaves come last: the functions after one inline its IR as
// the middle end left it, not as instruction selection makes it.
pub fn emit_ir_functions(mut cx: *FnCtx) {
    unsafe {
        for fi in 0..IRFUNC_COUNT {
            if !leaf_kept(fi) {
                emit_ir_function(cx, fi);
            }
        }
        for fi in 0..IRFUNC_COUNT {
            if leaf_kept(fi) {
                emit_ir_function(cx, fi);
            }
        }
    }
}

// One function of emit_ir_functions, then its IR freed.
fn emit_ir_function(mut cx: *FnCtx, fi: i64) {
    unsafe {
        if FN_LIVE[fi] != 0 && !leaf_dropped(fi) {
            if PER_FUNCTION {
                let t = timer_now();
                optimize_function(cx, fi);
                timer_add(T_SCALAR, t);
            }
            let t = timer_now();
            select_function(cx, fi);
            timer_add(T_ISEL, t);
            let t2 = timer_now();
            count_uses(cx, fi);
            gen_ir_function(cx, fi);
            timer_add(T_CODEGEN, t2);
            let t3 = timer_now();
            asm_flush(cx);
            timer_add(T_CODEGEN, t3);
        }
        ir_free_func(cx, fi);
    }
}

// (-g) The `.loc` of instruction v, when it starts another statement. The
// peepholes that look at what was just emitted see through it.
pub fn emit_loc(mut cx: *FnCtx, v: i64) {
    unsafe {
        let loc = cx.inst_loc.data[v];
        if loc == 0 || loc == cx.last_loc {
            return;
        }
        cx.last_loc = loc;
        let before = BUFS[cx.code].len;
        dbg_loc(cx.code, loc - 1);
        let after = BUFS[cx.code].len;
        if cx.last_mov_end == before {
            cx.last_mov_end = after;
        }
        if cx.last_store_end == before {
            cx.last_store_end = after;
        }
        if cx.last_select_end == before {
            cx.last_select_end = after;
        }
    }
}

fn emit_ir_epilogue(mut cx: *FnCtx) {
    unsafe {
        if !cx.cur_in_frame {
            ins(cx, c"ret");
            return;
        }
        save_callee_saved(cx, restore: true);
        if !cx.has_frame {
            ins(cx, c"ret");
        } else if X86 {
            x64_epilogue(cx);
        } else {
            a64_epilogue(cx);
        }
    }
}

// A return from a block that is not the last: the epilogue itself when it
// is short (at most 4 registers to restore), else a jump to it.
pub fn emit_return(mut cx: *FnCtx) {
    unsafe {
        if !cx.cur_in_frame {
            unsafe { ins(cx, c"ret"); }
            return;
        }
        let saved = cx.callee_used[0..64].iter().filter(|u| u != 0).count();
        if saved <= 4 {
            emit_ir_epilogue(cx);
        } else {
            cx.epilogue_used = true;
            m_jump(cx, cx.epilogue_label);
        }
    }
}

// The number of instructions of function fi.
fn function_size(mut cx: *FnCtx, fi: i64) -> i64 {
    unsafe {
        let mut n = 0;
        for i in 0..cx.order.count {
            let mut v = cx.blocks[cx.order.data[i]].first;
            while v != 0 {
                n += 1;
                v = cx.insts[v].next;
            }
        }
        n
    }
}

// Whether function fi has parameters on the stack (read from the frame
// pointer: the frame is then set up at its entry).
fn has_stack_params(mut cx: *FnCtx, fi: i64) -> bool {
    unsafe {
        let f = IRFUNCS[fi].f;
        let mut locations: [i64; 64] = [0; 64];
        let mut pieces: [i64; 256] = [0; 256];
        if FNS[f].param_count > 64 {
            return true;
        }
        param_locations(cx, f, &locations as *i64, &pieces as *i64);
        let mut v = cx.blocks[IRFUNCS[fi].entry].first;
        while v != 0 {
            if cx.insts[v].op == Param && cx.insts[v].imm >= 0 {
                let index = cx.insts[v].imm;
                let piece = cx.insts[v].imm2;
                let location = if piece > 0 { pieces[4 * index + piece - 1] }
                    else { locations[index] };
                if piece < 0 || xl_is_stack(location) {
                    return true;
                }
            }
            v = cx.insts[v].next;
        }
        false
    }
}

// Whether block b ends in a call that does not return, passing nothing
// on the stack (its frame can be its own).
pub fn is_noreturn_call_block(mut cx: *FnCtx, b: i64) -> bool {
    unsafe {
        let v = cx.blocks[b].last;
        cx.blocks[b].term == Term::Unreach && v != 0 && cx.insts[v].op.is_call()
            && call_stack_size(cx, v) == 0
    }
}

fn sw_intersect(mut cx: *FnCtx, a: i64, b: i64) -> i64 {
    unsafe {
        let mut x = a;
        let mut y = b;
        while x != y {
            while x > y {
                x = cx.sw_idom.data[x];
            }
            while y > x {
                y = cx.sw_idom.data[y];
            }
        }
        x
    }
}

// Whether layout index a dominates layout index x.
fn sw_dominates(mut cx: *FnCtx, a: i64, x: i64) -> bool {
    let mut y = x;
    while y > a {
        unsafe { y = cx.sw_idom.data[y]; }
    }
    y == a
}

// Dominators over the layout (a reverse post-order): Cooper, Harvey and
// Kennedy's iteration.
fn sw_dominators(mut cx: *FnCtx) {
    unsafe {
        let n = cx.order.count;
        cx.sw_idom.count = 0;
        for k in 0..n {
            cx.sw_idom.push(if k == 0 { 0 } else { -1 });
        }
        let mut changed = true;
        while changed {
            changed = false;
            for k in 1..n {
                let b = cx.order.data[k];
                let mut idom = -1;
                for i in 0..cx.blocks[b].preds.count {
                    let pk = cx.blocks[cx.blocks[b].preds.data[i]].order;
                    if pk < 0 || cx.sw_idom.data[pk] < 0 {
                        continue;
                    }
                    idom = if idom < 0 { pk } else { sw_intersect(cx, pk, idom) };
                }
                if idom != cx.sw_idom.data[k] {
                    cx.sw_idom.data[k] = idom;
                    changed = true;
                }
            }
        }
    }
}

// Whether the frame can be set up at layout index s: s is in no loop, no
// block of its region leads back to it, and only jumps leave the region.
fn sw_valid(mut cx: *FnCtx, s: i64) -> bool {
    unsafe {
        if s == 0 {
            return true;
        }
        if cx.ldepth.data[s] != 0 {
            return false;
        }
        for k in s..cx.order.count {
            if !sw_dominates(cx, s, k) {
                continue;
            }
            let b = cx.order.data[k];
            for i in 0..succ_count(cx, b) {
                let sk = cx.blocks[succ(cx, b, i)].order;
                if sk == s || sk < 0
                    || (!sw_dominates(cx, s, sk) && cx.blocks[b].term != Term::Jump) {
                    return false;
                }
            }
        }
        true
    }
}

// Tears the frame down (on a jump out of its region): restores the
// callee-saved registers, sp, the frame pointer and the return address.
pub fn emit_frame_teardown(mut cx: *FnCtx) {
    save_callee_saved(cx, restore: true);
    if X86 { mx_frame_unlink(cx); } else { ma_frame_unlink(cx); }
}

fn shrink_wrap(mut cx: *FnCtx, fi: i64) {
    unsafe {
        let n = cx.order.count;
        let mut need = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for _ in 0..n {
            need.push(0);
        }
        for k in 0..n {
            let b = cx.order.data[k];
            let mut v = cx.blocks[b].first;
            while v != 0 {
                let op = cx.insts[v].op;
                if op.is_call() && is_emitted(cx, v)
                    && !(v == cx.blocks[b].last && is_noreturn_call_block(cx, b)) {
                    need.data[k] = 1;
                }
                if op == Slot && is_emitted(cx, v) {
                    need.data[k] = 1;
                }
                for i in 0..ir_operand_count(cx, v) {
                    let u = ir_operand(cx, v, i);
                    if u != 0 && cx.insts[u].op == Slot {
                        need.data[k] = 1;
                        if op == Phi {
                            for j in 0..cx.blocks[b].preds.count {
                                let pk = cx.blocks[cx.blocks[b].preds.data[j]].order;
                                if pk >= 0 {
                                    need.data[pk] = 1;
                                }
                            }
                        }
                    }
                }
                v = cx.insts[v].next;
            }
            let cond = cx.blocks[b].cond;
            if cond != 0 && cx.insts[cond].op == Slot {
                need.data[k] = 1;
            }
        }
        mark_frame_blocks(cx, need.data);
        let mut any = (0..n).any(|k| need.data[k] != 0);
        if cx.returns_twice || cx.frame_align > 16 || has_stack_params(cx, fi)
            || (cx.frame_total > 0 && !any) {
            need.data[0] = 1;
            any = true;
        }
        cx.in_frame.count = 0;
        for _ in 0..n {
            cx.in_frame.push(0);
        }
        cx.save = -1;
        if any {
            sw_dominators(cx);
            let mut s = -1;
            for k in 0..n {
                if need.data[k] != 0 {
                    s = if s < 0 { k } else { sw_intersect(cx, s, k) };
                }
            }
            while !sw_valid(cx, s) {
                s = cx.sw_idom.data[s];
            }
            cx.save = s;
            for k in 0..n {
                if sw_dominates(cx, s, k) {
                    cx.in_frame.data[k] = 1;
                }
            }
        }
        free(need.data as *u8);
    }
}

// Links a frame: saves the frame pointer and the return address.
pub fn emit_frame_link(mut cx: *FnCtx) {
    if X86 { mx_frame_link(cx); } else { ma_frame_link(cx); }
}

// Reserves the frame's area, realigns it, saves the callee-saved
// registers.
pub fn emit_frame_setup(mut cx: *FnCtx) {
    unsafe {
        if cx.frame_total > 0 {
            if X86 { x64_frame_reserve(cx, cx.frame_total); }
            else { a64_frame_reserve(cx, cx.frame_total); }
            if cx.frame_align > 16 {
                // The frame is addressed from sp: aligned, its slots are (the
                // epilogue restores sp from the frame pointer).
                if X86 {
                    x64_imm(cx, c"andq", 0 - cx.frame_align, c"%rsp");
                } else {
                    ins(cx, c"mov x16, sp");
                    a64_align_down(cx, 16, cx.frame_align);
                    ins(cx, c"mov sp, x16");
                }
            }
        }
        save_callee_saved(cx, restore: false);
    }
}

// The function's label (as the shared emit_function_start writes it), and
// the saving of the frame pointer and return address when it has a frame.
fn ir_function_start(mut cx: *FnCtx, prefix: *u8, name: i64, global: bool, frame: bool) {
    unsafe {
        emit_function_start(cx, prefix, name, global);
        if frame {
            return;
        }
        let prologue = if X86 { c"    pushq %rbp\n    movq %rsp, %rbp\n" }
            else { c"    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n" };
        let n = strlen(prologue) as i64;
        let len = BUFS[cx.asm].len;
        if len < n || memcmp(&BUFS[cx.asm].data[len - n], prologue, n as u64) != 0 {
            die(c"internal error: unexpected function prologue");
        }
        BUFS[cx.asm].len = len - n;
    }
}
