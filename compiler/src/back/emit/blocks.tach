// Blocks (emit/mod.tach): blocks that are only a jump skipped, the
// blocks emitted in layout order with their bodies and branches, and
// switches.

use crate::back::abi::{
    conv_classify, conv_return_piece_reg, conv_returns_through_pointer, fn_uses_c,
};
use crate::back::dwarf::DEBUG_INFO;
use crate::back::emit::function::{
    emit_frame_link, emit_frame_setup, emit_frame_teardown, emit_loc, emit_return,
    is_noreturn_call_block,
};
use crate::back::emit::insts::{emit_inst, mem_base_any};
use crate::back::emit::machine::{
    block_label, m_branch_bool, m_cmp_branch, m_jump, m_load, m_load_imm, m_mov, m_trap,
    reg_move_temp, reg_ret,
};
use crate::back::emit::operands::{
    PM_FIELDS, PM_LOC, const_of, int_operand, pm_add_value, pm_dst, pm_kind, pm_resolve, pm_src,
    result_done, use_into,
};
use crate::back::emit::stats::{ST_BACK, ST_MOVES, ST_RELOADS, ST_SPILLS};
use crate::back::mc_arm64::ops::{ma_jump_table, ma_test_branch};
use crate::back::mc_x86_64::ops::{mx_jump_table, mx_test_branch};
use crate::back::regalloc::locations::{
    gap_index, plan_end_moves, plan_gap_moves, plan_start_moves, stored_at_def, tloc,
};
use crate::back::regalloc::prepare::{is_emitted, is_fused_compare, tracked};
use crate::base::{alloc_array, free};
use crate::base::target::X86;
use crate::front::patterns::usefulness::int_key;
use crate::front::types::{FNS, TY_U64, is_compound, is_float};
use crate::gen0::target::{emit_label, new_label};
use crate::gen0::x86_64::fits_i32;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Cond, IRFUNCS, Term, ir_arg};
use crate::middle::ir::Op::{Const, Pack, Param, Phi, Piece, Select, Test};
use crate::middle::ir::cfg::{case_target, case_value};

pub fn find_trivial_jumps(mut cx: *FnCtx) {
    unsafe {
        cx.trivial.count = 0;
        for k in 0..cx.order.count {
            cx.trivial.push(if unsafe { is_trivial_jump_now(cx, cx.order.data[k]) } { 1 }
                else { 0 });
        }
    }
}

// Whether block b emits nothing but a jump: no instruction, no move.
fn is_trivial_jump_now(mut cx: *FnCtx, b: i64) -> bool {
    unsafe {
        if cx.blocks[b].term != Term::Jump || b == IRFUNCS[cx.irf].entry
            || cx.blocks[b].order == cx.save {
            return false;
        }
        // A jump out of the frame's region tears the frame down.
        let sk = cx.blocks[cx.blocks[b].s0].order;
        if cx.in_frame.data[cx.blocks[b].order] != 0 && (sk < 0 || cx.in_frame.data[sk] == 0) {
            return false;
        }
        let mut v = cx.blocks[b].first;
        while v != 0 {
            let t = tracked(cx, v);
            if is_emitted(cx, v) || cx.insts[v].op == Param
                || (cx.insts[v].op == Phi && t >= 0 && stored_at_def(cx, t)) {
                return false;
            }
            v = cx.insts[v].next;
        }
        let k = cx.blocks[b].order;
        let i = gap_index(cx, cx.bstart.data[k]);
        if i < cx.split_moves.count / 2 && cx.split_moves.data[2 * i] <= cx.bend.data[k] {
            return false;
        }
        plan_start_moves(cx, b);
        plan_end_moves(cx, b);
        let empty = (0..cx.pm.count / PM_FIELDS).all(|j| pm_kind(cx, j) == PM_LOC
            && pm_dst(cx, j) == pm_src(cx, j));
        cx.pm.count = 0;
        empty
    }
}

fn is_trivial_jump(mut cx: *FnCtx, b: i64) -> bool {
    unsafe { cx.blocks[b].order >= 0 && cx.trivial.data[cx.blocks[b].order] != 0 }
}

// Where a jump to b really goes: past blocks that only jump on (b itself
// when the chain does not end, in an empty endless loop).
pub fn jump_target(mut cx: *FnCtx, b: i64) -> i64 {
    unsafe {
        let mut target = b;
        for _ in 0..16 {
            if target == IRFUNCS[cx.irf].entry || !is_trivial_jump(cx, target) {
                return target;
            }
            target = cx.blocks[target].s0;
        }
        b
    }
}

// Blocks every jump passes by are not emitted at all.
pub fn is_skipped(mut cx: *FnCtx, b: i64) -> bool {
    unsafe { b != IRFUNCS[cx.irf].entry && is_trivial_jump(cx, b) && jump_target(cx, b) != b }
}

// The block emitted after the one at index j of the emission order, or 0.
fn next_block(mut cx: *FnCtx, j: i64) -> i64 {
    if unsafe { j + 1 < cx.emit.count } { unsafe { cx.emit.data[j + 1] } } else { 0 }
}

pub fn emit_ir_block(mut cx: *FnCtx, b: i64, j: i64) {
    emit_label(cx, block_label(cx, b));
    emit_block_code(cx, b, next_block(cx, j));
}

fn is_duplicable(mut cx: *FnCtx, b: i64) -> bool {
    unsafe {
        let term = cx.blocks[b].term;
        if b == IRFUNCS[cx.irf].entry || cx.blocks[b].order == cx.save
            || (term != Term::Jump && term != Term::Branch && term != Term::Ret) {
            return false;
        }
        let mut n = 0;
        let mut v = cx.blocks[b].first;
        while v != 0 {
            if cx.insts[v].op.is_call() || cx.insts[v].op == Piece
                || cx.insts[v].op == Select && X86 {
                return false;
            }
            if is_emitted(cx, v) && !is_fused_compare(cx, v) {
                n += 1;
            }
            v = cx.insts[v].next;
        }
        n <= 3
    }
}

// The code of block b (without its label); `next` is the block emitted
// after it (0: none, -1: a copy, which nothing follows).
fn emit_block_code(mut cx: *FnCtx, b: i64, next: i64) {
    unsafe {
        let k = cx.blocks[b].order;
        let outer = cx.cur_in_frame;
        cx.cur_in_frame = cx.in_frame.data[k] != 0;
        if cx.save > 0 && k == cx.save {
            emit_frame_link(cx);
            emit_frame_setup(cx);
        } else if !cx.cur_in_frame && is_noreturn_call_block(cx, b) {
            emit_frame_link(cx);
        }
        emit_block_body(cx, b, next);
        cx.cur_in_frame = outer;
    }
}

fn emit_block_body(mut cx: *FnCtx, b: i64, next: i64) {
    unsafe {
        let k = cx.blocks[b].order;
        let start = cx.bstart.data[k];
        plan_start_moves(cx, b);
        pm_resolve(cx);
        // Phis that go to the stack are stored there.
        let mut v = cx.blocks[b].first;
        while v != 0 {
            let t = tracked(cx, v);
            if cx.insts[v].op == Phi && t >= 0 && stored_at_def(cx, t) {
                let loc = tloc(cx, t, start);
                if loc >= 0 {
                    result_done(cx, v, loc);
                }
            }
            v = cx.insts[v].next;
        }
        v = cx.blocks[b].first;
        while v != 0 {
            let op = cx.insts[v].op;
            if op != Phi && op != Param {
                cx.cur_pos = cx.insts[v].mark;
                plan_gap_moves(cx, cx.cur_pos - 1);
                pm_resolve(cx);
                if is_emitted(cx, v) && !is_fused_compare(cx, v) {
                    if DEBUG_INFO {
                        emit_loc(cx, v);
                    }
                    emit_inst(cx, v);
                }
            }
            v = cx.insts[v].next;
        }
        if cx.tail_called {
            // The callee returns for this block.
            cx.tail_called = false;
            return;
        }
        let end = cx.bend.data[k];
        cx.cur_pos = end;
        plan_gap_moves(cx, end - 1);
        pm_resolve(cx);
        let term = cx.blocks[b].term;
        if term == Term::Jump {
            let s = cx.blocks[b].s0;
            let before = cx.st_fn[ST_MOVES] + cx.st_fn[ST_SPILLS] + cx.st_fn[ST_RELOADS];
            plan_end_moves(cx, b);
            pm_resolve(cx);
            if cx.blocks[s].order <= k {
                cx.st_fn[ST_BACK] += cx.st_fn[ST_MOVES] + cx.st_fn[ST_SPILLS] + cx.st_fn[ST_RELOADS] - before;
            }
            let target = jump_target(cx, s);
            if cx.cur_in_frame && cx.in_frame.data[cx.blocks[target].order] == 0 {
                emit_frame_teardown(cx);
            }
            if target != next {
                if cx.dup_depth < 2 && is_duplicable(cx, target) {
                    cx.dup_depth += 1;
                    // The copy ends where this block does: its next block follows.
                    emit_block_code(cx, target, next);
                    cx.dup_depth -= 1;
                } else {
                    m_jump(cx, block_label(cx, target));
                }
            }
        } else if term == Term::Branch {
            emit_branch(cx, b, next);
        } else if term == Term::Switch {
            emit_switch(cx, b);
        } else if term == Term::Ret {
            let value = cx.blocks[b].cond;
            let ret = FNS[IRFUNCS[cx.irf].f].ret;
            let c = fn_uses_c(IRFUNCS[cx.irf].f);
            if value != 0 && cx.insts[value].op == Pack {
                // The pieces of an aggregate result, into the result registers.
                conv_classify(cx, c, ret);
                for i in 0..cx.insts[value].nargs {
                    pm_add_value(cx, conv_return_piece_reg(cx, c, i), ir_arg(cx, value, i), end);
                }
                pm_resolve(cx);
            } else if value != 0 && is_compound(ret) && !conv_returns_through_pointer(cx, c, ret) {
                // An aggregate returned in registers: its pieces, from its
                // address (out of the way of the result registers).
                conv_classify(cx, c, ret);
                let mut offset = 0;
                let mut base = mem_base_any(cx, value, 0, end, &mut offset);
                for i in 0..cx.abi_piece_count {
                    if base == conv_return_piece_reg(cx, c, i) {
                        m_mov(cx, reg_move_temp(float: false), base, TY_U64);
                        base = reg_move_temp(float: false);
                    }
                }
                for i in 0..cx.abi_piece_count {
                    m_load(cx, cx.abi_piece_ty[i], conv_return_piece_reg(cx, c, i), base,
                        offset + cx.abi_piece_offset[i]);
                }
            } else if value != 0 {
                use_into(cx, value, end, reg_ret(is_float(cx.insts[value].ty)));
            }
            if next != 0 || !cx.cur_in_frame {
                emit_return(cx);
            } else {
                cx.fell_into_epilogue = true;
            }
        } else {
            m_trap(cx);
        }
    }
}

fn emit_branch(mut cx: *FnCtx, b: i64, next: i64) {
    unsafe {
        let cond = cx.blocks[b].cond;
        // Branches have no phi moves (edges into phis are split), so they can
        // skip blocks that only jump on.
        let s0 = jump_target(cx, cx.blocks[b].s0);
        let s1 = jump_target(cx, cx.blocks[b].s1);
        // Jump to `target` when the condition is `sense`, fall through or jump
        // to `other` otherwise.
        let mut target = s0;
        let mut other = s1;
        let mut sense = true;
        if s0 == next {
            target = s1;
            other = s0;
            sense = false;
        }
        if is_fused_compare(cx, cond) && cx.insts[cond].op == Test {
            let mut op = cx.insts[cond].cond;
            if !sense {
                op = op.negate();
            }
            let a = int_operand(cx, cx.insts[cond].a);
            let b = if cx.insts[cond].b != 0 { int_operand(cx, cx.insts[cond].b) } else { -1 };
            if X86 {
                mx_test_branch(cx, a, b, cx.insts[cond].imm, op == Cond::Ne,
                    block_label(cx, target));
            } else {
                ma_test_branch(cx, a, b, cx.insts[cond].imm, op == Cond::Ne,
                    block_label(cx, target));
            }
        } else if is_fused_compare(cx, cond) {
            let mut op = cx.insts[cond].cond;
            if !sense {
                op = op.negate();
            }
            let ty = cx.insts[cond].imm2;
            let a = int_operand(cx, cx.insts[cond].a);
            let mut imm = 0;
            let rhs = cx.insts[cond].b;
            if const_of(cx, rhs, &mut imm) && fits_cmp_imm(imm) {
                m_cmp_branch(cx, op, ty, a, 0, true, imm, block_label(cx, target));
            } else {
                let r = int_operand(cx, rhs);
                m_cmp_branch(cx, op, ty, a, r, false, 0, block_label(cx, target));
            }
        } else {
            let r = int_operand(cx, cond);
            m_branch_bool(cx, r, sense, block_label(cx, target));
        }
        if other != next {
            m_jump(cx, block_label(cx, other));
        }
    }
}

// ---- Switches ----

// A switch: a jump table when its cases are dense (at least 4, filling at
// least a third of their range), else a binary search. Like branches,
// switches have no phi moves (edges into phis are split).
fn emit_switch(mut cx: *FnCtx, b: i64) {
    unsafe {
        let cond = cx.blocks[b].cond;
        let ty = cx.insts[cond].ty;
        let n = cx.blocks[b].ncases;
        cx.sw_values.count = 0;
        cx.sw_labels.count = 0;
        for i in 0..n {
            // Insertion in order of the keys (see int_key).
            let key = int_key(case_value(cx, b, i), ty);
            let mut at = cx.sw_values.count;
            cx.sw_values.push(0);
            cx.sw_labels.push(0);
            while at > 0 && int_key(cx.sw_values.data[at - 1], ty) > key {
                cx.sw_values.data[at] = cx.sw_values.data[at - 1];
                cx.sw_labels.data[at] = cx.sw_labels.data[at - 1];
                at -= 1;
            }
            cx.sw_values.data[at] = case_value(cx, b, i);
            cx.sw_labels.data[at] = block_label(cx, jump_target(cx, case_target(cx, b, i)));
        }
        let default = block_label(cx, jump_target(cx, cx.blocks[b].s0));
        let r = int_operand(cx, cond);
        if n == 0 {
            m_jump(cx, default);
            return;
        }
        let low = cx.sw_values.data[0];
        let range = int_key(cx.sw_values.data[n - 1], ty) - int_key(low, ty) + 1;
        if n >= 4 && range > 0 && range <= 3 * n && range <= 4096 {
            // One entry per value of the range: the case's label or the default.
            let table = alloc_array::<i64>(range);
            for i in 0..range {
                table[i] = default;
            }
            for i in 0..n {
                table[cx.sw_values.data[i] - low] = cx.sw_labels.data[i];
            }
            if X86 {
                mx_jump_table(cx, r, low, range, default, table);
            } else {
                ma_jump_table(cx, r, low, range, default, table);
            }
            free(table as *u8);
            return;
        }
        emit_switch_search(cx, r, ty, 0, n, default);
    }
}

// Compares and branches for the cases lo..hi (sorted), by halves.
fn emit_switch_search(mut cx: *FnCtx, r: i64, ty: i64, lo: i64, hi: i64, default: i64) {
    unsafe {
        if hi - lo <= 3 {
            for i in lo..hi {
                switch_compare(cx, Cond::Eq, ty, r, cx.sw_values.data[i], cx.sw_labels.data[i]);
            }
            m_jump(cx, default);
            return;
        }
        let mid = (lo + hi) / 2;
        switch_compare(cx, Cond::Eq, ty, r, cx.sw_values.data[mid], cx.sw_labels.data[mid]);
        let right = new_label(cx);
        switch_compare(cx, Cond::Gt, ty, r, cx.sw_values.data[mid], right);
        emit_switch_search(cx, r, ty, lo, mid, default);
        emit_label(cx, right);
        emit_switch_search(cx, r, ty, mid + 1, hi, default);
    }
}

// Jumps to `label` when register r <op> value.
fn switch_compare(mut cx: *FnCtx, op: Cond, ty: i64, r: i64, value: i64, label: i64) {
    if fits_cmp_imm(value) {
        m_cmp_branch(cx, op, ty, r, 0, true, value, label);
    } else {
        let scratch = reg_move_temp(float: false);
        m_load_imm(cx, scratch, value as u64);
        m_cmp_branch(cx, op, ty, r, scratch, false, 0, label);
    }
}

pub fn fits_cmp_imm(imm: i64) -> bool {
    // AArch64: cmp #imm, or cmn #-imm for a negative one.
    if X86 { fits_i32(imm) } else { imm > -4096 && imm < 4096 }
}

// Whether comparison v (CMP) compares integers with a constant that fits
// an immediate.
pub fn is_cmp_imm_operand(mut cx: *FnCtx, v: i64) -> bool {
    unsafe {
        let b = cx.insts[v].b;
        !is_float(cx.insts[v].imm2) && b != 0 && cx.insts[b].op == Const
            && fits_cmp_imm(cx.insts[b].imm)
    }
}
