// --stats (emit/mod.tach): counts of the machine code emitted, per
// function and in total, printed on stderr.

use crate::back::emit::{MEM_INDEX, SAVE_BASE, SPILL_BASE};
use crate::base::{BUFS, STDERR, SYMS, buf_byte, buf_bytes, buf_int, buf_new, buf_str, buf_write_fd};
use crate::front::types::FNS;
use crate::gen0::target::CODE;
use crate::middle::ir::IRFUNCS;
use crate::back::emit::machine::reg_sp;

// ---- Statistics (--stats) ----

// --stats: 1 prints totals of the machine code emitted (at -O1 and -O2)
// on stderr, 2 also a line per function.
pub static mut STATS: i64 = 0;

// The counters, of the function being emitted (ST_FN) and in total
// (ST_ALL): instructions, register moves, stores to spill slots, loads
// from them, moves and spill traffic on loop back edges, frame bytes
// (with the saved frame pointer and return address), functions with a
// frame, saved callee-saved registers, functions.
const ST_INSTS: i64 = 0;

pub const ST_MOVES: i64 = 1;

pub const ST_SPILLS: i64 = 2;

pub const ST_RELOADS: i64 = 3;

pub const ST_BACK: i64 = 4;

pub const ST_FRAME: i64 = 5;

pub const ST_FRAMES: i64 = 6;

pub const ST_SAVES: i64 = 7;

const ST_FUNCS: i64 = 8;

const ST_COUNT: i64 = 9;

pub static mut ST_FN: [i64; 9] = [0; 9];

static mut ST_ALL: [i64; 9] = [0; 9];

fn st_names(k: i64) -> *u8 {
    if k == ST_INSTS { c"instructions" }
    else if k == ST_MOVES { c"moves" }
    else if k == ST_SPILLS { c"spill stores" }
    else if k == ST_RELOADS { c"reloads" }
    else if k == ST_BACK { c"back-edge moves" }
    else if k == ST_FRAME { c"frame bytes" }
    else if k == ST_FRAMES { c"frames" }
    else if k == ST_SAVES { c"saved registers" }
    else { c"functions" }
}

// The spill traffic of the move to or from [sp + offset].
pub fn st_spill(load: bool, base: i64, offset: i64) {
    if MEM_INDEX < 0 && base == reg_sp() && offset >= SPILL_BASE && offset < SAVE_BASE {
        ST_FN[if load { ST_RELOADS } else { ST_SPILLS }] += 1;
    }
}

// The instructions of the function just emitted: lines of CODE indented
// by four spaces that are not directives.
fn st_count_instructions() -> i64 {
    unsafe {
        let data = BUFS[CODE].data;
        let len = BUFS[CODE].len;
        let mut n = 0;
        let mut i = 0;
        while i < len {
            if i + 4 < len && data[i] == ' ' && data[i + 4] != '.' && data[i + 4] != ' ' {
                n += 1;
            }
            while i < len && data[i] != '\n' {
                i += 1;
            }
            i += 1;
        }
        n
    }
}

pub fn st_function_done(fi: i64) {
    unsafe {
        ST_FN[ST_INSTS] = st_count_instructions();
        ST_FN[ST_FUNCS] = 1;
        if STATS > 1 {
            let out = buf_new();
            buf_str(out, c"stats ");
            let name = FNS[IRFUNCS[fi].f].name;
            buf_bytes(out, SYMS[name].text);
            for k in 0..ST_COUNT - 1 {
                buf_byte(out, ' ');
                buf_int(out, ST_FN[k]);
            }
            buf_byte(out, '\n');
            buf_write_fd(out, STDERR);
        }
        for k in 0..ST_COUNT {
            ST_ALL[k] += ST_FN[k];
            ST_FN[k] = 0;
        }
    }
}

// Prints the totals (after the last function).
pub fn print_stats() {
    unsafe {
        if STATS == 0 {
            return;
        }
        let out = buf_new();
        buf_str(out, c"stats:");
        for k in 0..ST_COUNT {
            buf_str(out, if k == 0 { c" " } else { c", " });
            buf_int(out, ST_ALL[k]);
            buf_byte(out, ' ');
            buf_str(out, st_names(k));
        }
        buf_byte(out, '\n');
        buf_write_fd(out, STDERR);
    }
}
