// The operands of an AArch64 instruction of the assembler (enc_arm64):
// registers, vector registers, symbols with their modifiers, immediates
// and addresses.

use crate::back::enc_arm64::{
    AOp, C_B, C_D, C_H, C_Q, C_S, C_V, C_VL, C_W, C_X, K_COND, K_IMM, K_LIST, K_MEM, K_REG, K_SHIFT,
    K_SYM, M_GOTPAGE, M_GOTPAGEOFF, M_NONE, M_PAGE, M_PAGEOFF, OPS, cond_code, elem_size_of, tchar,
};
use crate::back::objfile::{ATEXT, asym};
use crate::back::objfile::assemble::{OP_END, OP_START, asm_error, parse_number, text_is};
use crate::middle::ctx::FnCtx;

// ---- Operands ----

// A register at [a, b): sets op.reg, op.cls, op.sp; false if not one.
fn parse_reg(mut cx: *FnCtx, a: i64, b: i64, op: &mut AOp) -> bool {
    unsafe {
        // (0.17: sp, xzr and wzr told by their bytes, not by text_is: every
        // register operand is asked)
        let c0 = tchar(cx, a);
        if b - a == 2 && c0 == 's' && tchar(cx, a + 1) == 'p' {
            (*op).reg = 31;
            (*op).cls = C_X;
            (*op).sp = true;
            return true;
        }
        if b - a == 3 && (c0 == 'x' || c0 == 'w') && tchar(cx, a + 1) == 'z'
            && tchar(cx, a + 2) == 'r' {
            (*op).reg = 31;
            (*op).cls = if tchar(cx, a) == 'x' { C_X } else { C_W };
            (*op).sp = false;
            return true;
        }
        if tchar(cx, a) == 'v' && parse_vreg(cx, a, b, op) {
            return true;
        }
        if b - a < 2 || b - a > 3 {
            return false;
        }
        let c = tchar(cx, a);
        let cls = if c == 'x' { C_X } else if c == 'w' { C_W } else if c == 'd' { C_D }
            else if c == 's' { C_S } else if c == 'q' { C_Q } else if c == 'h' { C_H }
            else if c == 'b' { C_B } else { 0 };
        if cls == 0 {
            return false;
        }
        let mut n = 0;
        for i in a + 1..b {
            let d = tchar(cx, i);
            if d < '0' || d > '9' {
                return false;
            }
            n = n * 10 + (d - '0') as i64;
        }
        (*op).reg = n;
        (*op).cls = cls;
        (*op).sp = false;
        true
    }
}

// v<n>.<arrangement> or v<n>.<e>[i] at [a, b) (0.10).
fn parse_vreg(mut cx: *FnCtx, a: i64, b: i64, op: &mut AOp) -> bool {
    unsafe {
        let mut i = a + 1;
        let mut n = 0;
        while i < b && tchar(cx, i) >= '0' && tchar(cx, i) <= '9' {
            n = n * 10 + (tchar(cx, i) - '0') as i64;
            i += 1;
        }
        if i == a + 1 || i >= b || tchar(cx, i) != '.' {
            return false;
        }
        i += 1;
        (*op).reg = n;
        (*op).sp = false;
        if i + 1 < b && tchar(cx, i + 1) == '[' {
            let size = elem_size_of(tchar(cx, i));
            if size < 0 || tchar(cx, b - 1) != ']' {
                return false;
            }
            (*op).cls = C_VL;
            (*op).imm = size;
            (*op).amount = parse_number(cx, i + 2, b - 1);
            return true;
        }
        let mut lanes = 0;
        while i < b && tchar(cx, i) >= '0' && tchar(cx, i) <= '9' {
            lanes = lanes * 10 + (tchar(cx, i) - '0') as i64;
            i += 1;
        }
        // (0.19) a group of lanes as one element: sdot's `v2.4b[1]`, a 32-bit
        // element
        if lanes > 0 && i + 1 < b && tchar(cx, i + 1) == '[' {
            let lsize = elem_size_of(tchar(cx, i));
            if lsize < 0 || tchar(cx, b - 1) != ']' {
                return false;
            }
            let bytes = lanes << lsize as u64;
            (*op).cls = C_VL;
            (*op).imm = if bytes == 4 { 2 } else if bytes == 8 { 3 } else { 1 };
            (*op).amount = parse_number(cx, i + 2, b - 1);
            return true;
        }
        if i + 1 != b {
            return false;
        }
        // (0.19) `.1q`: pmull's 128-bit result, size 4
        let size = if tchar(cx, i) == 'q' { 4 } else { elem_size_of(tchar(cx, i)) };
        if size < 0 {
            return false;
        }
        (*op).cls = C_V;
        (*op).imm = size;
        (*op).shift = if lanes << size as u64 == 16 { 1 } else { 0 };
        true
    }
}

fn skip_spaces(mut cx: *FnCtx, i: i64, b: i64) -> i64 {
    let mut k = i;
    while k < b && (tchar(cx, k) == ' ' || tchar(cx, k) == '\t') {
        k += 1;
    }
    k
}

// A symbol with an optional modifier at [a, b): `sym@PAGEOFF`... on
// Mach-O, `:lo12:sym`, `:got:sym`, `:got_lo12:sym` on ELF (where adrp's
// plain `sym` is its page).
fn parse_sym(mut cx: *FnCtx, a: i64, b: i64, op: &mut AOp) {
    unsafe {
        if tchar(cx, a) == ':' {
            let mut colon = a + 1;
            while colon < b && tchar(cx, colon) != ':' {
                colon += 1;
            }
            if colon >= b {
                asm_error(cx, c"bad symbol modifier");
            }
            (*op).sym = asym(ATEXT[colon + 1..b]);
            if text_is(cx, a + 1, colon, c"lo12") {
                (*op).modifier = M_PAGEOFF;
            } else if text_is(cx, a + 1, colon, c"got") {
                (*op).modifier = M_GOTPAGE;
            } else if text_is(cx, a + 1, colon, c"got_lo12") {
                (*op).modifier = M_GOTPAGEOFF;
            } else {
                asm_error(cx, c"unknown symbol modifier");
            }
            return;
        }
        let mut at = a;
        while at < b && tchar(cx, at) != '@' {
            at += 1;
        }
        (*op).sym = asym(ATEXT[a..at]);
        (*op).modifier = M_NONE;
        if at < b {
            if text_is(cx, at + 1, b, c"PAGE") {
                (*op).modifier = M_PAGE;
            } else if text_is(cx, at + 1, b, c"PAGEOFF") {
                (*op).modifier = M_PAGEOFF;
            } else if text_is(cx, at + 1, b, c"GOTPAGE") {
                (*op).modifier = M_GOTPAGE;
            } else if text_is(cx, at + 1, b, c"GOTPAGEOFF") {
                (*op).modifier = M_GOTPAGEOFF;
            } else {
                asm_error(cx, c"unknown symbol modifier");
            }
        }
    }
}

pub fn parse_operand(mut cx: *FnCtx, k: i64) {
    unsafe {
        let a = OP_START[k];
        let b = OP_END[k];
        let mut op = AOp {
            kind: 0, reg: 0, cls: 0, sp: false, imm: 0, index: -1, index_cls: 0, amount: 0, sym: -1,
            modifier: 0, shift: 0, pre: false
        };
        let c = tchar(cx, a);
        if c == '#' {
            op.kind = K_IMM;
            // (0.19: `#0.0`, the float compares against zero)
            op.imm = if text_is(cx, a + 1, b, c"0.0") { 0 } else { parse_number(cx, a + 1, b) };
        } else if c == '{' {
            // (0.19) a register list: its first register, and the count
            op.kind = K_LIST;
            let mut i = a + 1;
            let mut count = 0;
            while i < b && tchar(cx, i) != '}' {
                i = skip_spaces(cx, i, b);
                let mut j = i;
                while j < b && tchar(cx, j) != ',' && tchar(cx, j) != '}' {
                    j += 1;
                }
                let mut e = j;
                while e > i && tchar(cx, e - 1) == ' ' {
                    e -= 1;
                }
                let mut item = AOp {
                    kind: 0, reg: 0, cls: 0, sp: false, imm: 0, index: -1, index_cls: 0,
                    amount: 0, sym: -1, modifier: 0, shift: 0, pre: false
                };
                if !parse_reg(cx, i, e, &mut item) {
                    asm_error(cx, c"bad register list");
                }
                if count == 0 {
                    op.reg = item.reg;
                    op.cls = item.cls;
                    op.imm = item.imm;
                    op.shift = item.shift;
                }
                count += 1;
                i = if j < b && tchar(cx, j) == ',' { j + 1 } else { j };
            }
            op.amount = count;
        } else if c == '[' {
            op.kind = K_MEM;
            let mut e = b;
            if tchar(cx, e - 1) == '!' {
                op.pre = true;
                e -= 1;
            }
            if tchar(cx, e - 1) != ']' {
                asm_error(cx, c"bad memory operand");
            }
            e -= 1;
            // [base(, x)*]
            let mut i = a + 1;
            let mut j = i;
            while j < e && tchar(cx, j) != ',' {
                j += 1;
            }
            if !parse_reg(cx, i, j, &mut op) {
                asm_error(cx, c"bad base register");
            }
            if j < e {
                i = skip_spaces(cx, j + 1, e);
                j = i;
                while j < e && tchar(cx, j) != ',' {
                    j += 1;
                }
                if tchar(cx, i) == '#' {
                    op.imm = parse_number(cx, i + 1, j);
                } else {
                    let mut idx = AOp {
                        kind: 0, reg: 0, cls: 0, sp: false, imm: 0, index: -1, index_cls: 0,
                        amount: 0, sym: -1, modifier: 0, shift: 0, pre: false
                    };
                    if parse_reg(cx, i, j, &mut idx) {
                        op.index = idx.reg;
                        op.index_cls = idx.cls;
                        if j < e {
                            i = skip_spaces(cx, j + 1, e);
                            if !text_is(cx, i, i + 5, c"lsl #") {
                                asm_error(cx, c"bad index shift");
                            }
                            op.amount = parse_number(cx, i + 5, e);
                        }
                    } else {
                        let base_reg = op.reg;
                        let base_cls = op.cls;
                        let base_sp = op.sp;
                        parse_sym(cx, i, j, &mut op);
                        op.reg = base_reg;
                        op.cls = base_cls;
                        op.sp = base_sp;
                    }
                }
            }
        }
        else if (c == 'l' || c == 'a')
            && (text_is(cx, a, a + 4, c"lsl ") || text_is(cx, a, a + 4, c"lsr ")
                || text_is(cx, a, a + 4, c"asr ")) {
            op.kind = K_SHIFT;
            op.shift = if c == 'l' { if tchar(cx, a + 2) == 'l' { 0 } else { 1 } } else { 2 };
            let i = skip_spaces(cx, a + 4, b);
            if tchar(cx, i) != '#' {
                asm_error(cx, c"bad shift");
            }
            op.amount = parse_number(cx, i + 1, b);
        } else if parse_reg(cx, a, b, &mut op) {
            op.kind = K_REG;
        } else if cond_code(cx, a, b) >= 0 {
            op.kind = K_COND;
            op.imm = cond_code(cx, a, b);
        } else {
            op.kind = K_SYM;
            parse_sym(cx, a, b, &mut op);
        }
        OPS[k] = op;
    }
}
