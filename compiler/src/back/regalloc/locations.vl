// Where the allocation (regalloc/mod.vl) put each value: its location
// at a position, the blocks that need the frame, and the moves that
// reconcile locations inside blocks and on edges.

use crate::back::emit::operands::{PM_LOC, PM_REMAT, pm_add};
use crate::back::regalloc::{LOC_NONE, LOC_REMAT, ON_STACK, UNASSIGNED};
use crate::back::regalloc::intervals::{block_at, ra_start, trailing_zeros};
use crate::back::regalloc::prepare::{live_set, tracked};
use crate::back::regalloc::scan::{is_callee_saved_reg, value_start};
use crate::base::die;
use crate::front::types::max_i64;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Term, ir_arg};
use crate::middle::ir::Op::Phi;
use crate::middle::ir::cfg::{pred_index, succ_count};

// The interval of dense index t holding position pos.
fn interval_at(cx: sink *FnCtx, t: i64, pos: i64) -> i64 {
    unsafe {
        var i = cx.rv_first[t];
        while cx.ivs[i].next >= 0 && ra_start(cx, cx.ivs[i].next) <= pos {
            i = cx.ivs[i].next;
        }
        i
    }
}

// The location of dense index t at position pos.
pub fn tloc(cx: sink *FnCtx, t: i64, pos: i64) -> i64 {
    unsafe {
        let r = cx.ivs[interval_at(cx, t, pos)].reg;
        if r >= 0 {
            return r;
        }
        if r == UNASSIGNED {
            die(c"internal error: an interval without a location");
        }
        if cx.insts[cx.ra_vals.data[t]].op.is_remat() {
            return LOC_REMAT;
        }
        0 - (1 + cx.rv_slot[t])
    }
}

// The location of value v at position pos.
pub fn vloc(cx: sink *FnCtx, v: i64, pos: i64) -> i64 {
    let t = tracked(cx, v);
    if t < 0 {
        return LOC_NONE;
    }
    tloc(cx, t, pos)
}

// Whether value v (dense index t) is stored to its spill slot when it is
// defined.
pub fn stored_at_def(cx: sink *FnCtx, t: i64) -> bool {
    unsafe { cx.rv_slot[t] >= 0 }
}

// Shrink-wrapping (see emit.vl): marks in `need` (per layout index)
// the blocks where some value is in a callee-saved register or on the
// stack, or is stored to its spill slot, and the predecessors of a block
// that starts with one there (their edge moves may write it).
pub fn mark_frame_blocks(cx: sink *FnCtx, need: *i64) {
    unsafe {
        for t in 0..cx.ra_vals.count {
            let v = cx.ra_vals.data[t];
            var i = cx.rv_first[t];
            if i < 0 {
                continue;
            }
            if cx.rv_slot[t] >= 0 {
                need[block_at(cx, value_start(cx, t))] = 1;
            }
            while i >= 0 {
                let r = cx.ivs[i].reg;
                if (r >= 0 && is_callee_saved_reg(r))
                    || (r == ON_STACK && !cx.insts[v].op.is_remat()) {
                    for j in 0..cx.ivs[i].ranges.count / 2 {
                        mark_frame_range(cx, need, cx.ivs[i].ranges.data[2 * j],
                            cx.ivs[i].ranges.data[2 * j + 1]);
                    }
                }
                i = cx.ivs[i].next;
            }
        }
    }
}

fn mark_frame_range(cx: sink *FnCtx, need: *i64, from: i64, to: i64) {
    unsafe {
        var k = max_i64(block_at(cx, from), 0);
        while k < cx.order.count && cx.bstart.data[k] < to {
            need[k] = 1;
            if from <= cx.bstart.data[k] {
                let b = cx.order.data[k];
                for p in cx.blocks[b].preds.items() {
                    if cx.blocks[p].order >= 0 {
                        need[cx.blocks[p].order] = 1;
                    }
                }
            }
            k += 1;
        }
    }
}

// ---- Moves ----
//
// The moves of the allocation, shared by the emitter (which emits them)
// and the checker (which simulates them): each adds to PM (see 51_emit).

// Value v (dense index t) goes from `from` to `to`, where it is live
// across: a register or the stack. The stack needs no move (the value is
// there since its definition, or is rematerialized).
fn add_relocation(cx: sink *FnCtx, t: i64, from: i64, to: i64) {
    unsafe {
        if from == to || to < 0 || to == LOC_REMAT {
            return;
        }
        let v = cx.ra_vals.data[t];
        if from == LOC_REMAT {
            pm_add(cx, to, PM_REMAT, v, cx.insts[v].ty, v, v);
        } else {
            pm_add(cx, to, PM_LOC, from, cx.insts[v].ty, v, v);
        }
    }
}

// The moves in the gap at q.
pub fn plan_gap_moves(cx: sink *FnCtx, q: i64) {
    unsafe {
        let n = cx.split_moves.count / 2;
        var i = gap_index(cx, q);
        while i < n && cx.split_moves.data[2 * i] == q {
            let t = cx.split_moves.data[2 * i + 1];
            add_relocation(cx, t, tloc(cx, t, q - 1), tloc(cx, t, q));
            i += 1;
        }
    }
}

// The first entry of SPLIT_MOVES at gap q or later.
pub fn gap_index(cx: sink *FnCtx, q: i64) -> i64 {
    var lo = 0;
    var hi = unsafe { cx.split_moves.count / 2 };
    while lo < hi {
        let mid = (lo + hi) / 2;
        if unsafe { cx.split_moves.data[2 * mid] < q } {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo
}

// The moves of the edge from b to s: the values live into s, and its phis.
fn plan_edge_moves(cx: sink *FnCtx, b: i64, s: i64) {
    unsafe {
        let from_pos = cx.bend.data[cx.blocks[b].order] + 1;
        let to_pos = cx.bstart.data[cx.blocks[s].order];
        let live_in = live_set(cx, cx.live_in, cx.blocks[s].order);
        for w in 0..cx.live_words {
            var bits = live_in[w];
            while bits != 0 {
                let bit = trailing_zeros(bits);
                bits &= bits - 1;
                let t = w * 64 + bit;
                add_relocation(cx, t, tloc(cx, t, from_pos), tloc(cx, t, to_pos));
            }
        }
        let index = pred_index(cx, s, b);
        var phi = cx.blocks[s].first;
        while phi != 0 && cx.insts[phi].op == Phi {
            let t = tracked(cx, phi);
            if t >= 0 {
                let dst = tloc(cx, t, to_pos);
                let arg = ir_arg(cx, phi, index);
                let a = tracked(cx, arg);
                if cx.insts[arg].op.is_remat() || a < 0 {
                    pm_add(cx, dst, PM_REMAT, arg, cx.insts[phi].ty, arg, phi);
                } else {
                    let src = tloc(cx, a, from_pos);
                    if src == LOC_REMAT {
                        pm_add(cx, dst, PM_REMAT, arg, cx.insts[phi].ty, arg, phi);
                    } else {
                        pm_add(cx, dst, PM_LOC, src, cx.insts[phi].ty, arg, phi);
                    }
                }
            }
            phi = cx.insts[phi].next;
        }
    }
}

// The moves at the start of block b: those of its edge when its single
// predecessor has other successors.
pub fn plan_start_moves(cx: sink *FnCtx, b: i64) {
    unsafe {
        if cx.blocks[b].preds.count == 1 {
            let p = cx.blocks[b].preds.data[0];
            if succ_count(cx, p) > 1 {
                plan_edge_moves(cx, p, b);
            }
        }
    }
}

// The moves at the end of block b, after its last instruction: those of
// its edge when it has a single successor.
pub fn plan_end_moves(cx: sink *FnCtx, b: i64) {
    unsafe {
        if cx.blocks[b].term == Term::Jump {
            plan_edge_moves(cx, b, cx.blocks[b].s0);
        }
    }
}
