// The linear scan (regalloc/mod.vl): the registers each class of value
// may get, intervals given free registers or registers taken from others,
// splits at loop entries, and spill slots for the values that go to the
// stack.

use crate::back::regalloc::{ON_STACK, POS_MAX, UNASSIGNED, USE_REG};
use crate::back::regalloc::intervals::{
    block_at, covers, gap_before, min_i64, move_point_before, next_intersection, next_use, ra_end,
    ra_start, split_at, split_point,
};
use crate::base::{IntVec, die, free};
use crate::base::target::X86;
use crate::front::types::{in_fregs, is_vector, max_i64, type_size};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::Op::Phi;

// ---- Registers ----

// The registers allocated, in order of preference: caller-saved first.
fn class_regs(float: bool, vector: bool, regs: *i64) -> i64 {
    unsafe {
        var n = 0;
        if X86 {
            if float {
                for r in 2..14 { regs[n] = 32 + r; n += 1; }
                regs[n] = 32; n += 1;
                regs[n] = 33; n += 1;
                return n;
            }
            let list: [i64; 12] = [6, 7, 8, 9, 0, 1, 2, 3, 12, 13, 14, 15];
            for i in 0..12 {
                if is_allocatable(list[i]) {
                    regs[n] = list[i];
                    n += 1;
                }
            }
            return n;
        }
        if float {
            for r in 16..30 { regs[n] = 32 + r; n += 1; }
            for r in 0..8 { regs[n] = 32 + r; n += 1; }
            if !vector {
                for r in 8..16 { regs[n] = 32 + r; n += 1; }
            }
            return n;
        }
        for r in 9..16 { regs[n] = r; n += 1; }
        for r in 0..9 { regs[n] = r; n += 1; }
        for r in 19..29 { regs[n] = r; n += 1; }
        n
    }
}

// x86-64 keeps rax, rcx and rdx out of allocation while the machine layer
// still uses them inside instructions.
pub static var X86_ALLOC_ACD: bool = true;

pub fn is_allocatable(r: i64) -> bool {
    if X86 {
        if r >= 32 {
            return r < 46;
        }
        if r == 0 || r == 1 || r == 2 {
            return X86_ALLOC_ACD;
        }
        return r == 3 || r == 6 || r == 7 || r == 8 || r == 9 || (r >= 12 && r <= 15);
    }
    if r >= 32 {
        return r < 62;
    }
    r <= 15 || (r >= 19 && r <= 28)
}

pub fn is_callee_saved_reg(r: i64) -> bool {
    if X86 {
        return r == 3 || (r >= 12 && r <= 15);
    }
    (r >= 19 && r <= 28) || (r >= 40 && r <= 47)
}

// ---- Linear scan ----

fn heap_less(cx: sink *FnCtx, a: i64, b: i64) -> bool {
    let sa = ra_start(cx, a);
    let sb = ra_start(cx, b);
    sa < sb || (sa == sb && a < b)
}

fn heap_push(cx: sink *FnCtx, i: i64) {
    unsafe {
        cx.unhandled.push(i);
        var k = cx.unhandled.count - 1;
        while k > 0 {
            let parent = (k - 1) / 2;
            if !heap_less(cx, cx.unhandled.data[k], cx.unhandled.data[parent]) {
                break;
            }
            let t = cx.unhandled.data[k];
            cx.unhandled.data[k] = cx.unhandled.data[parent];
            cx.unhandled.data[parent] = t;
            k = parent;
        }
    }
}

fn heap_pop(cx: sink *FnCtx) -> i64 {
    unsafe {
        let top = cx.unhandled.data[0];
        cx.unhandled.count -= 1;
        let n = cx.unhandled.count;
        if n > 0 {
            cx.unhandled.data[0] = cx.unhandled.data[n];
            var k = 0;
            loop {
                let l = 2 * k + 1;
                let r = l + 1;
                var m = k;
                if l < n && heap_less(cx, cx.unhandled.data[l], cx.unhandled.data[m]) {
                    m = l;
                }
                if r < n && heap_less(cx, cx.unhandled.data[r], cx.unhandled.data[m]) {
                    m = r;
                }
                if m == k {
                    break;
                }
                let t = cx.unhandled.data[k];
                cx.unhandled.data[k] = cx.unhandled.data[m];
                cx.unhandled.data[m] = t;
                k = m;
            }
        }
        top
    }
}

fn iv_float(cx: sink *FnCtx, i: i64) -> bool {
    unsafe { in_fregs(cx.insts[cx.ra_vals.data[cx.ivs[i].value]].ty) }
}

// A vector (0.10): in a float register, but never in one whose upper half
// a call may change (d8-d15 keep only their low 64 bits on AArch64).
fn iv_vector(cx: sink *FnCtx, i: i64) -> bool {
    unsafe { is_vector(cx.insts[cx.ra_vals.data[cx.ivs[i].value]].ty) }
}

// Whether register r may hold interval i.
fn reg_fits(cx: sink *FnCtx, i: i64, r: i64) -> bool {
    r >= 0 && (r >= 32) == iv_float(cx, i) && is_allocatable(r)
        && !(iv_vector(cx, i) && !X86 && r >= 40 && r < 48)
}

fn iv_remat(cx: sink *FnCtx, i: i64) -> bool {
    unsafe { cx.insts[cx.ra_vals.data[cx.ivs[i].value]].op.is_remat() }
}

// How soon a use at `pos` comes after `from`, for choosing what to spill:
// uses in loops count as nearer (by 4 per level), remat values are cheap
// to bring back; between equals, the nearer position.
fn use_distance(cx: sink *FnCtx, i: i64, pos: i64, from: i64) -> i64 {
    if pos >= POS_MAX {
        return POS_MAX;
    }
    let depth = unsafe { min_i64(cx.ldepth.data[block_at(cx, pos)], 6) };
    let raw = pos - from;
    var d = raw >> (2 * depth) as u64;
    // A constant is cheap to bring back, unless it is needed by the very
    // next instruction (two constants needed there would take each
    // other's register forever).
    if iv_remat(cx, i) && raw > 4 {
        d = d * 4 + 3;
    }
    (d << 20) | min_i64(raw, 0xfffff)
}

// The register the value of interval i would like, or -1: its partner's
// (a phi and its operands), else the register it arrives in or goes to.
fn hint_reg(cx: sink *FnCtx, i: i64) -> i64 {
    unsafe {
        let t = cx.ivs[i].value;
        var other = cx.rv_hint[t];
        // The partner's register, or (not allocated yet) its own partner's.
        for _ in 0..2 {
            if other < 0 || other == t {
                break;
            }
            var j = cx.rv_first[other];
            while j >= 0 {
                if cx.ivs[j].reg >= 0 {
                    return cx.ivs[j].reg;
                }
                j = cx.ivs[j].next;
            }
            other = cx.rv_hint[other];
        }
        cx.rv_hreg[t]
    }
}

fn assign(cx: sink *FnCtx, i: i64, r: i64) {
    unsafe { cx.ivs[i].reg = r; }
    if is_callee_saved_reg(r) {
        unsafe { cx.callee_used[r] = 1; }
    }
}

fn ra_dominators(cx: sink *FnCtx) {
    unsafe {
        if cx.ra_idom_ready {
            return;
        }
        cx.ra_idom_ready = true;
        let n = cx.order.count;
        cx.ra_idom.count = 0;
        for k in 0..n {
            cx.ra_idom.push(if k == 0 { 0 } else { -1 });
        }
        var changed = true;
        while changed {
            changed = false;
            for k in 1..n {
                let b = cx.order.data[k];
                var idom = -1;
                for i in 0..cx.blocks[b].preds.count {
                    let pk = cx.blocks[cx.blocks[b].preds.data[i]].order;
                    if pk < 0 || cx.ra_idom.data[pk] < 0 {
                        continue;
                    }
                    if idom < 0 {
                        idom = pk;
                    } else {
                        var x = pk;
                        var y = idom;
                        while x != y {
                            while x > y {
                                x = cx.ra_idom.data[x];
                            }
                            while y > x {
                                y = cx.ra_idom.data[y];
                            }
                        }
                        idom = x;
                    }
                }
                if idom != cx.ra_idom.data[k] {
                    cx.ra_idom.data[k] = idom;
                    changed = true;
                }
            }
        }
    }
}

fn ra_dominates(cx: sink *FnCtx, a: i64, x: i64) -> bool {
    var y = x;
    while y > a {
        unsafe { y = cx.ra_idom.data[y]; }
    }
    y == a
}

// Whether interval i (a whole value) can move to its second location at
// the start of block k (in no loop): k dominates every block at or after
// it where the value lives. (A block in no loop reaches only blocks after
// it in the layout, a reverse post-order: going back takes a back edge,
// into a loop that would contain it. So no block before k where the value
// lives can see the second location.)
fn entry_split_ok(cx: sink *FnCtx, i: i64, k: i64) -> bool {
    ra_dominators(cx);
    let n = unsafe { cx.order.count };
    unsafe {
        for j in 0..cx.ivs[i].ranges.count / 2 {
            let from = cx.ivs[i].ranges.data[2 * j];
            let to = cx.ivs[i].ranges.data[2 * j + 1];
            var b = max_i64(block_at(cx, from), k);
            while b < n && cx.bstart.data[b] < to {
                if !ra_dominates(cx, k, b) {
                    return false;
                }
                b += 1;
            }
        }
    }
    true
}

// A value defined in the entry block (a parameter, mostly) that would take
// a callee-saved register for its whole lifetime: it keeps a caller-saved
// one (its hint first) until just before that one is needed elsewhere (a
// call, usually), when that is past the entry block, and the rest goes on.
// Moving it into the callee-saved register there rather than at the entry
// costs the same move, and leaves the paths that return before any call
// without a frame (shrink-wrapping, see emit.vl).
fn try_entry_split(cx: sink *FnCtx, cur: i64, hint: i64, regs: *i64, n: i64) -> bool {
    unsafe {
        let start = ra_start(cx, cur);
        if block_at(cx, start) != 0 || cx.rv_first[cx.ivs[cur].value] != cur || cx.returns_twice {
            return false;
        }
        var c = -1;
        if reg_fits(cx, cur, hint) && !is_callee_saved_reg(hint)
            && cx.free_until[hint] > cx.bend.data[0] {
            c = hint;
        } else {
            for k in 0..n {
                let r = regs[k];
                if !is_callee_saved_reg(r) && (c < 0 || cx.free_until[r] > cx.free_until[c]) {
                    c = r;
                }
            }
        }
        if c < 0 || cx.free_until[c] <= cx.bend.data[0] {
            return false;
        }
        let end = ra_end(cx, cur);
        if cx.free_until[c] >= end {
            // Free all along: no callee-saved register is needed at all.
            assign(cx, cur, c);
            return true;
        }
        // Out of loops, where every later use passes: in the block of the
        // conflict, or at the start of the last block before it that is in no
        // loop and dominates the rest of the value's blocks (in layout order,
        // a loop run before it may come after it).
        let limit = cx.free_until[c];
        var k = block_at(cx, limit);
        var split = -1;
        if cx.ldepth.data[k] == 0 && entry_split_ok(cx, cur, k) {
            split = move_point_before(cx, limit, start + 1);
        }
        while split < 0 && k > 0 {
            if cx.ldepth.data[k] == 0 && cx.bstart.data[k] < limit && entry_split_ok(cx, cur, k) {
                split = cx.bstart.data[k];
            }
            k -= 1;
        }
        if split <= start || split >= end || block_at(cx, split) == 0 {
            return false;
        }
        assign(cx, cur, c);
        heap_push(cx, split_at(cx, cur, split));
        true
    }
}

// Whether v is a phi of a loop header (a block with a back edge into it).
fn is_loop_phi(cx: sink *FnCtx, v: i64) -> bool {
    unsafe {
        if cx.insts[v].op != Phi {
            return false;
        }
        let b = cx.insts[v].block;
        let k = cx.blocks[b].order;
        for i in 0..cx.blocks[b].preds.count {
            if cx.blocks[cx.blocks[b].preds.data[i]].order >= k {
                return true;
            }
        }
        false
    }
}

// After build_intervals: which registers' fixed ranges are the same.
fn find_same_fixed(cx: sink *FnCtx) {
    unsafe {
        for r in 0..64 {
            cx.fixed_canon[r] = r;
            cx.fix_at[r] = 0;
            if cx.fixed[r].count == 0 {
                continue;
            }
            for q in 0..r {
                if cx.fixed_canon[q] == q && cx.fixed[q].count == cx.fixed[r].count
                    && same_ranges(&cx.fixed[q], &cx.fixed[r]) {
                    cx.fixed_canon[r] = q;
                    break;
                }
            }
        }
    }
}

fn same_ranges(a: *IntVec, b: *IntVec) -> bool {
    unsafe {
        for i in 0..a.count {
            if a.data[i] != b.data[i] {
                return false;
            }
        }
    }
    true
}

// next_intersection(&FIXED[r], &IVS[i].ranges, from), shared (see
// FIXED_CANON).
fn fixed_intersection(cx: sink *FnCtx, r: i64, i: i64, from: i64) -> i64 {
    unsafe {
        let c = cx.fixed_canon[r];
        if cx.fix_at[c] == cx.fix_step && cx.fix_iv[c] == i && cx.fix_from[c] == from {
            return cx.fix_x[c];
        }
        let x = next_intersection(&cx.fixed[c], &cx.ivs[i].ranges, from);
        cx.fix_at[c] = cx.fix_step;
        cx.fix_iv[c] = i;
        cx.fix_from[c] = from;
        cx.fix_x[c] = x;
        x
    }
}

// Whether interval i lives across a call: every caller-saved register of
// `regs` is clobbered somewhere in it.
fn crosses_calls(cx: sink *FnCtx, i: i64, regs: *i64, n: i64) -> bool {
    unsafe {
        var any = false;
        for k in 0..n {
            let r = regs[k];
            if is_callee_saved_reg(r) {
                continue;
            }
            any = true;
            if cx.fixed[r].count == 0 || fixed_intersection(cx, r, i, 0) == POS_MAX {
                return false;
            }
        }
        any
    }
}

// Gives interval cur register r, free for its whole lifetime: unless r is
// callee-saved and an entry split keeps it in a caller-saved one first.
fn assign_whole(cx: sink *FnCtx, cur: i64, r: i64, hint: i64, regs: *i64, n: i64) {
    if is_callee_saved_reg(r) && try_entry_split(cx, cur, hint, regs, n) {
        return;
    }
    assign(cx, cur, r);
}

fn try_allocate_free(cx: sink *FnCtx, cur: i64) -> bool {
    unsafe {
        cx.fix_step += 1;
        var regs: [i64; 32] = [0; 32];
        let n = class_regs(iv_float(cx, cur), iv_vector(cx, cur), &regs as *i64);
        let start = ra_start(cx, cur);
        let end = ra_end(cx, cur);
        for k in 0..n {
            cx.free_until[regs[k]] = POS_MAX;
        }
        for k in 0..cx.active.count {
            cx.free_until[cx.ivs[cx.active.data[k]].reg] = 0;
        }
        for a in cx.inactive.items() {
            let r = cx.ivs[a].reg;
            if cx.free_until[r] > 0 {
                let x = next_intersection(&cx.ivs[a].ranges, &cx.ivs[cur].ranges, start);
                if x < cx.free_until[r] {
                    cx.free_until[r] = x;
                }
            }
        }
        for k in 0..n {
            let r = regs[k];
            if cx.free_until[r] > 0 && cx.fixed[r].count > 0 {
                let x = fixed_intersection(cx, r, cur, start);
                if x < cx.free_until[r] {
                    cx.free_until[r] = x;
                }
            }
        }
        let hint = hint_reg(cx, cur);
        // Out of loops, a value that lives across no call does not follow its
        // hint into a callee-saved register: the move the hint saves runs
        // once, the frame it may force on paths that need none (see
        // shrink-wrapping in emit.vl) every time.
        let cheap_hint = !is_callee_saved_reg(hint) || cx.ldepth.data[block_at(cx, start)] != 0
            || crosses_calls(cx, cur, &regs as *i64, n);
        if reg_fits(cx, cur, hint) && cx.free_until[hint] >= end && cheap_hint {
            assign_whole(cx, cur, hint, hint, &regs as *i64, n);
            return true;
        }
        // The partner not allocated yet will need a callee-saved register (it
        // lives across a call): one free now can be both's.
        let partner = cx.rv_hint[cx.ivs[cur].value];
        if hint < 0 && partner >= 0 && partner != cx.ivs[cur].value && cx.rv_first[partner] >= 0
            && is_loop_phi(cx, cx.ra_vals.data[cx.ivs[cur].value])
            && cx.ivs[cx.rv_first[partner]].reg == UNASSIGNED
            && crosses_calls(cx, cx.rv_first[partner], &regs as *i64, n) {
            for k in 0..n {
                let r = regs[k];
                if is_callee_saved_reg(r) && cx.free_until[r] >= end {
                    assign_whole(cx, cur, r, hint, &regs as *i64, n);
                    return true;
                }
            }
        }
        // Else the argument or result register the value goes to, when the
        // partner's is taken.
        let to = cx.rv_hreg[cx.ivs[cur].value];
        if to != hint && reg_fits(cx, cur, to) && cx.free_until[to] >= end {
            assign_whole(cx, cur, to, hint, &regs as *i64, n);
            return true;
        }
        var best = regs[0];
        for k in 0..n {
            let r = regs[k];
            if cx.free_until[r] >= end {
                assign_whole(cx, cur, r, hint, &regs as *i64, n);
                return true;
            }
            if cx.free_until[r] > cx.free_until[best] {
                best = r;
            }
        }
        if cx.free_until[best] <= start {
            return false;
        }
        // Free for a first part only.
        let split = split_point(cx, start + 1, cx.free_until[best]);
        if split <= start {
            return false;
        }
        assign(cx, cur, best);
        heap_push(cx, split_at(cx, cur, split));
        true
    }
}

// Interval a gives up its register from pos on: the rest goes to the
// stack until just before its next use in a register.
fn spill_from(cx: sink *FnCtx, a: i64, pos: i64) {
    unsafe {
        var rest = a;
        if ra_start(cx, a) < pos {
            rest = split_at(cx, a, pos);
        }
        cx.ivs[rest].reg = ON_STACK;
        let start = ra_start(cx, rest);
        let u = next_use(cx, rest, start, USE_REG);
        if u == POS_MAX {
            return;
        }
        let split = split_point(cx, start + 1, gap_before(u));
        if split <= start {
            // Needed in a register right away: allocate it again.
            cx.ivs[rest].reg = UNASSIGNED;
            heap_push(cx, rest);
            return;
        }
        heap_push(cx, split_at(cx, rest, split));
    }
}

fn remove_at(list: *IntVec, k: i64) {
    unsafe {
        list.data[k] = list.data[list.count - 1];
        list.count -= 1;
    }
}

fn allocate_blocked(cx: sink *FnCtx, cur: i64) {
    unsafe {
        cx.fix_step += 1;
        var regs: [i64; 32] = [0; 32];
        let n = class_regs(iv_float(cx, cur), iv_vector(cx, cur), &regs as *i64);
        let start = ra_start(cx, cur);
        for k in 0..n {
            cx.use_pos[regs[k]] = POS_MAX;
            cx.block_pos[regs[k]] = POS_MAX;
        }
        for a in cx.active.items() {
            let r = cx.ivs[a].reg;
            let u = use_distance(cx, a, next_use(cx, a, start, USE_REG), start);
            if u < cx.use_pos[r] {
                cx.use_pos[r] = u;
            }
        }
        for a in cx.inactive.items() {
            let r = cx.ivs[a].reg;
            if next_intersection(&cx.ivs[a].ranges, &cx.ivs[cur].ranges, start) < POS_MAX {
                let u = use_distance(cx, a, next_use(cx, a, start, USE_REG), start);
                if u < cx.use_pos[r] {
                    cx.use_pos[r] = u;
                }
            }
        }
        let end = ra_end(cx, cur);
        let first = next_use(cx, cur, start, USE_REG);
        if first == POS_MAX {
            cx.ivs[cur].reg = ON_STACK;
            return;
        }
        // A register is a candidate when no fixed interval takes it before
        // the first use, nor before a place to give it back; the best one is
        // taken from the intervals whose next use is farthest.
        var best = -1;
        for k in 0..n {
            let r = regs[k];
            if cx.fixed[r].count > 0 {
                let x = fixed_intersection(cx, r, cur, start);
                cx.block_pos[r] = x;
                if x <= first || (x < end && split_point(cx, start + 1, x) <= start) {
                    continue;
                }
            }
            if best < 0 || cx.use_pos[r] > cx.use_pos[best] {
                best = r;
            }
        }
        let split = split_point(cx, start + 1, gap_before(first));
        if split > start && (best < 0 || cx.use_pos[best] <= use_distance(cx, cur, first, start)) {
            // Every register is needed as soon: to the stack until its first
            // use.
            cx.ivs[cur].reg = ON_STACK;
            heap_push(cx, split_at(cx, cur, split));
            return;
        }
        if best < 0 {
            die(c"internal error: no register for an operand");
        }
        assign(cx, cur, best);
        if cx.block_pos[best] < ra_end(cx, cur) {
            let at = split_point(cx, start + 1, cx.block_pos[best]);
            if at <= start {
                die(c"internal error: no place to split before a fixed register");
            }
            heap_push(cx, split_at(cx, cur, at));
        }
        // Take the register from the intervals holding it.
        var k = 0;
        while k < cx.active.count {
            let a = cx.active.data[k];
            if cx.ivs[a].reg == best {
                remove_at(&cx.active, k);
                spill_from(cx, a, start);
            } else {
                k += 1;
            }
        }
        k = 0;
        while k < cx.inactive.count {
            let a = cx.inactive.data[k];
            if cx.ivs[a].reg == best
                && next_intersection(&cx.ivs[a].ranges, &cx.ivs[cur].ranges, start) < POS_MAX {
                remove_at(&cx.inactive, k);
                spill_from(cx, a, start);
            } else {
                k += 1;
            }
        }
    }
}

pub fn linear_scan(cx: sink *FnCtx) {
    unsafe {
        for r in 0..64 {
            cx.callee_used[r] = 0;
        }
        find_same_fixed(cx);
        cx.active.count = 0;
        cx.inactive.count = 0;
        cx.unhandled.count = 0;
        for t in 0..cx.ra_vals.count {
            heap_push(cx, cx.rv_first[t]);
        }
        var steps = 0;
        while cx.unhandled.count > 0 {
            let cur = heap_pop(cx);
            steps += 1;
            if steps > 64 * (cx.ra_vals.count + 16) * 16 {
                die(c"internal error: register allocation does not finish");
            }
            let pos = ra_start(cx, cur);
            var k = 0;
            while k < cx.active.count {
                let a = cx.active.data[k];
                if ra_end(cx, a) <= pos {
                    remove_at(&cx.active, k);
                } else if !covers(cx, a, pos) {
                    remove_at(&cx.active, k);
                    cx.inactive.push(a);
                } else {
                    k += 1;
                }
            }
            k = 0;
            while k < cx.inactive.count {
                let a = cx.inactive.data[k];
                if ra_end(cx, a) <= pos {
                    remove_at(&cx.inactive, k);
                } else if covers(cx, a, pos) {
                    remove_at(&cx.inactive, k);
                    cx.active.push(a);
                } else {
                    k += 1;
                }
            }
            if !try_allocate_free(cx, cur) {
                allocate_blocked(cx, cur);
            }
            if cx.ivs[cur].reg >= 0 {
                cx.active.push(cur);
            }
        }
        sort_split_moves(cx);
        assign_spill_slots(cx);
    }
}

fn sort_split_moves(cx: sink *FnCtx) {
    unsafe {
        // Insertion sort by gap (stable), on (gap, value) pairs.
        let n = cx.split_moves.count / 2;
        for i in 1..n {
            let g = cx.split_moves.data[2 * i];
            let t = cx.split_moves.data[2 * i + 1];
            var j = i;
            while j > 0 && cx.split_moves.data[2 * (j - 1)] > g {
                cx.split_moves.data[2 * j] = cx.split_moves.data[2 * (j - 1)];
                cx.split_moves.data[2 * j + 1] = cx.split_moves.data[2 * (j - 1) + 1];
                j -= 1;
            }
            cx.split_moves.data[2 * j] = g;
            cx.split_moves.data[2 * j + 1] = t;
        }
    }
}

// Spill slots: a value that is on the stack anywhere gets one, shared
// with values whose lifetimes (from definition to last use) do not
// overlap its own.
fn assign_spill_slots(cx: sink *FnCtx) {
    unsafe {
        cx.spill_count = 0;
        var spilled = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for t in 0..cx.ra_vals.count {
            if cx.insts[cx.ra_vals.data[t]].op.is_remat() {
                continue;
            }
            var i = cx.rv_first[t];
            while i >= 0 {
                if cx.ivs[i].reg == ON_STACK {
                    spilled.push(t);
                    break;
                }
                i = cx.ivs[i].next;
            }
        }
        // By start of lifetime (values are numbered in layout order, but phis
        // and parameters come first in their block: sort to be sure).
        let n = spilled.count;
        for i in 1..n {
            let t = spilled.data[i];
            let s = value_start(cx, t);
            var j = i;
            while j > 0 && value_start(cx, spilled.data[j - 1]) > s {
                spilled.data[j] = spilled.data[j - 1];
                j -= 1;
            }
            spilled.data[j] = t;
        }
        // slot_end[i]: where the lifetime of the value in slot i ends. A
        // vector (0.10) takes two slots, the first of them even (the spill
        // area is then 16-aligned); a 256-bit one (0.19, x86-64's ymm) four,
        // the first a multiple of four.
        var slot_end = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        cx.spill_vectors = false;
        for i in 0..n {
            let t = spilled.data[i];
            let s = value_start(cx, t);
            let ty = cx.insts[cx.ra_vals.data[t]].ty;
            let wide = is_vector(ty);
            let step = if !wide { 1 } else if type_size(ty) == 32 { 4 } else { 2 };
            var slot = -1;
            var k = 0;
            while k + step <= slot_end.count {
                var free = !cx.returns_twice;
                for j in 0..step {
                    if slot_end.data[k + j] > s {
                        free = false;
                    }
                }
                if free {
                    slot = k;
                    break;
                }
                k += step;
            }
            if slot < 0 {
                while slot_end.count % step != 0 {
                    slot_end.push(0);
                }
                slot = slot_end.count;
                for _ in 0..step {
                    slot_end.push(0);
                }
            }
            for j in 0..step {
                slot_end.data[slot + j] = value_end(cx, t);
            }
            if wide {
                cx.spill_vectors = true;
            }
            cx.rv_slot[t] = slot;
        }
        cx.spill_count = slot_end.count;
        free(spilled.data as *u8);
        free(slot_end.data as *u8);
    }
}

pub fn value_start(cx: sink *FnCtx, t: i64) -> i64 {
    unsafe { ra_start(cx, cx.rv_first[t]) }
}

fn value_end(cx: sink *FnCtx, t: i64) -> i64 {
    unsafe {
        var i = cx.rv_first[t];
        while cx.ivs[i].next >= 0 {
            i = cx.ivs[i].next;
        }
        ra_end(cx, i)
    }
}
