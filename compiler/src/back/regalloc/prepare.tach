// What register allocation (regalloc/mod.tach) starts from: use counts,
// critical edges split, the blocks in layout order, what each use of a
// value needs, positions, and liveness.

use crate::back::abi::{conv_returns_through_pointer, fn_uses_c};
use crate::back::emit::blocks::{fits_cmp_imm, is_cmp_imm_operand};
use crate::back::emit::machine::{call_returns_through_pointer, m_int_imm_ok};
use crate::back::regalloc::{USE_ANY, USE_NONE, USE_REG};
use crate::back::regalloc::locations::vloc;
use crate::base::{IntVec, alloc_array, free};
use crate::base::target::X86;
use crate::front::types::{FNS, is_compound, is_float};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    IRFUNCS, Term, ir_arg, ir_enter, ir_new_block, ir_operand, ir_operand_count, ir_set_arg,
};
use crate::middle::ir::Op::{
    Cmp, Const, Div, Lea, Load, LoadX, Pack, Param, Phi, Piece, Rem, Select, Slot, Store, StoreX,
    Test,
};
use crate::middle::ir::cfg::{pred_index, redirect_succ, succ, succ_count};

// ---- Preparation ----

// Counts the uses of every value of function fi (before it is emitted).
pub fn count_uses(cx: sink *FnCtx, fi: i64) {
    unsafe {
        ir_enter(cx, fi);
        free(cx.regalloc_uses as *u8);
        free(cx.reg_used as *u8);
        cx.regalloc_uses = alloc_array::<i64>(cx.inst_count + 1);
        cx.reg_used = alloc_array::<i64>(cx.inst_count + 1);
        if cx.fixed == 0 as *IntVec {
            cx.fixed = alloc_array::<IntVec>(64);
        }
        for b in IRFUNCS[fi].blocks.items() {
            if cx.blocks[b].removed != 0 {
                continue;
            }
            var v = cx.blocks[b].first;
            while v != 0 {
                for k in 0..ir_operand_count(cx, v) {
                    let operand = ir_operand(cx, v, k);
                    if operand != 0 {
                        cx.regalloc_uses[operand] += 1;
                    }
                }
                v = cx.insts[v].next;
            }
            let cond = cx.blocks[b].cond;
            if cond != 0 {
                cx.regalloc_uses[cond] += 1;
            }
        }
    }
}

// Splits every critical edge (from a block with several successors to one
// with several predecessors) with an empty block, so that the moves of
// each edge have a place of their own.
pub fn split_critical_edges(cx: sink *FnCtx, fi: i64) {
    unsafe {
        ir_enter(cx, fi);
        let count = IRFUNCS[fi].blocks.count;
        for i in 0..count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 || succ_count(cx, b) < 2 {
                continue;
            }
            if cx.blocks[b].term == Term::Branch && cx.blocks[b].s0 == cx.blocks[b].s1 {
                // Both ways lead to the same block: a jump (one edge less).
                let s = cx.blocks[b].s0;
                let first = pred_index(cx, s, b);
                var second = -1;
                for j in first + 1..cx.blocks[s].preds.count {
                    if second < 0 && cx.blocks[s].preds.data[j] == b {
                        second = j;
                    }
                }
                if second >= 0 {
                    for j in second..cx.blocks[s].preds.count - 1 {
                        cx.blocks[s].preds.data[j] = cx.blocks[s].preds.data[j + 1];
                    }
                    cx.blocks[s].preds.count -= 1;
                    var phi = cx.blocks[s].first;
                    while phi != 0 && cx.insts[phi].op == Phi {
                        let gone = ir_arg(cx, phi, second);
                        if gone != 0 {
                            cx.regalloc_uses[gone] -= 1;
                        }
                        for j in second..cx.insts[phi].nargs - 1 {
                            ir_set_arg(cx, phi, j, ir_arg(cx, phi, j + 1));
                        }
                        cx.insts[phi].nargs -= 1;
                        phi = cx.insts[phi].next;
                    }
                }
                cx.regalloc_uses[cx.blocks[b].cond] -= 1;
                cx.blocks[b].cond = 0;
                cx.blocks[b].term = Term::Jump;
                cx.blocks[b].s1 = 0;
                continue;
            }
            var k = 0;
            while k < succ_count(cx, b) {
                let s = succ(cx, b, k);
                k += 1;
                if cx.blocks[s].preds.count < 2 {
                    continue;
                }
                let e = ir_new_block(cx);
                cx.blocks[e].sealed = 1;
                cx.blocks[e].term = Term::Jump;
                cx.blocks[e].s0 = s;
                cx.blocks[e].preds.push(b);
                redirect_succ(cx, b, s, e);
                // Same index in the predecessor list, so the phis still match.
                let index = pred_index(cx, s, b);
                cx.blocks[s].preds.data[index] = e;
            }
        }
    }
}

// Lays out the reachable blocks in reverse post-order (BLOCKS[b].order is
// the layout index, -1 for unreachable blocks), and finds their loop
// depths (LDEPTH, for the back end).
pub fn layout_blocks(cx: sink *FnCtx, fi: i64) {
    layout_order(cx, fi);
    loop_depths(cx);
}

// (0.17) The reverse post-order alone (BLOCKS[b].order, ORDER): what the
// middle end's users of the layout need (dominators, unreachable blocks);
// the loop depths cost a walk of every loop's blocks.
pub fn layout_order(cx: sink *FnCtx, fi: i64) {
    unsafe {
        for b in IRFUNCS[fi].blocks.items() {
            cx.blocks[b].order = -1;
            cx.blocks[b].mark = 0;
        }
        cx.order.count = 0;
        // Iterative depth-first search; post-order into ORDER, reversed below.
        var stack = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let entry = IRFUNCS[fi].entry;
        stack.push(entry);
        stack.push(0);
        cx.blocks[entry].mark = 1;
        while stack.count > 0 {
            let b = stack.data[stack.count - 2];
            let next = stack.data[stack.count - 1];
            if next < succ_count(cx, b) {
                stack.data[stack.count - 1] = next + 1;
                // The second successor first, so that the first one comes
                // right after the block when it can.
                let s = succ(cx, b, succ_count(cx, b) - 1 - next);
                if cx.blocks[s].mark == 0 {
                    cx.blocks[s].mark = 1;
                    stack.push(s);
                    stack.push(0);
                }
            } else {
                stack.count -= 2;
                cx.order.push(b);
            }
        }
        let n = cx.order.count;
        for i in 0..n / 2 {
            let t = cx.order.data[i];
            cx.order.data[i] = cx.order.data[n - 1 - i];
            cx.order.data[n - 1 - i] = t;
        }
        for i in 0..n {
            cx.blocks[cx.order.data[i]].order = i;
        }
        free(stack.data as *u8);
    }
}

// The loop depth of each block of the layout (LDEPTH, by layout index).
fn loop_depths(cx: sink *FnCtx) {
    unsafe {
        let n = cx.order.count;
        var stack = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        // Loops: an edge to a block not later in the order is a back edge
        // (the graph is reducible); the loop of header h is h and the blocks
        // reaching a latch without passing h.
        cx.ldepth.count = 0;
        for _ in 0..n {
            cx.ldepth.push(0);
        }
        // (0.17) The marks of the previous walk are cleared, not every
        // block's for every header: that was quadratic in the blocks of a
        // function with many loops. The first walk clears them all, the
        // DFS's.
        var walked = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var first_walk = true;
        for h in 0..n {
            let header = cx.order.data[h];
            stack.count = 0;
            for p in cx.blocks[header].preds.items() {
                if cx.blocks[p].order >= h {
                    stack.push(p);
                }
            }
            if stack.count == 0 {
                continue;
            }
            if first_walk {
                for k in 0..n {
                    cx.blocks[cx.order.data[k]].mark = 0;
                }
                first_walk = false;
            } else {
                for k in 0..walked.count {
                    cx.blocks[walked.data[k]].mark = 0;
                }
            }
            walked.count = 0;
            cx.blocks[header].mark = 1;
            walked.push(header);
            cx.ldepth.data[h] += 1;
            while stack.count > 0 {
                let b = stack.pop();
                if cx.blocks[b].mark != 0 || cx.blocks[b].order < 0 {
                    continue;
                }
                cx.blocks[b].mark = 1;
                walked.push(b);
                cx.ldepth.data[cx.blocks[b].order] += 1;
                for x in cx.blocks[b].preds.items() {
                    stack.push(x);
                }
            }
        }
        free(stack.data as *u8);
        free(walked.data as *u8);
    }
}

// Whether compare (or test) `v` is fused into the branch that ends its
// block.
pub fn is_fused_compare(cx: sink *FnCtx, v: i64) -> bool {
    unsafe {
        let b = cx.insts[v].block;
        (cx.insts[v].op == Cmp || cx.insts[v].op == Test) && cx.regalloc_uses[v] == 1
            && cx.blocks[b].term == Term::Branch && cx.blocks[b].cond == v && cx.insts[v].next == 0
            && !is_float(cx.insts[v].imm2)
    }
}

// How instruction v uses its operand i (see ir_operand).
pub fn use_kind(cx: sink *FnCtx, v: i64, i: i64) -> i64 {
    unsafe {
        let operand = ir_operand(cx, v, i);
        if operand == 0 {
            return USE_NONE;
        }
        let op = cx.insts[v].op;
        if op.is_call() {
            if i == 2 && cx.insts[operand].op == Slot && !call_returns_through_pointer(cx, v) {
                return USE_NONE;
            }
            return USE_ANY;
        }
        if op == Piece {
            return USE_NONE;
        }
        if op == Pack {
            return USE_ANY;
        }
        if op == Phi {
            return USE_ANY;
        }
        if (op == Load || op == Store) && i == 0 && cx.insts[operand].op == Slot {
            return USE_NONE;
        }
        // AArch64's csel and csinc read a 0 from xzr.
        if op == Select && i < 2 && !X86 && is_zero_operand(cx, operand) {
            return USE_NONE;
        }
        // x86-64's indexed forms address a frame slot from %rsp.
        if (op == LoadX || op == StoreX || op == Lea) && i == 0 && cx.insts[operand].op == Slot {
            return USE_NONE;
        }
        // An integer comparison with a constant that fits compares with an
        // immediate.
        if op == Cmp && i == 1 && is_cmp_imm_operand(cx, v) {
            return USE_NONE;
        }
        if op.is_binary() && i == 1 && !is_float(cx.insts[v].ty) && op != Div && op != Rem
            && cx.insts[operand].op == Const
            && m_int_imm_ok(op, cx.insts[v].ty, cx.insts[operand].imm) {
            return USE_NONE;
        }
        USE_REG
    }
}

// The operands the terminator of block b reads (at BEND), with their
// kinds: up to four (value, kind) pairs in out; returns the count.
pub fn term_uses(cx: sink *FnCtx, b: i64, out: *i64) -> i64 {
    unsafe {
        let cond = cx.blocks[b].cond;
        let term = cx.blocks[b].term;
        if cond == 0 {
            return 0;
        }
        if term == Term::Ret && cx.insts[cond].op == Pack {
            // The pieces of an aggregate result.
            for i in 0..cx.insts[cond].nargs {
                out[2 * i] = ir_arg(cx, cond, i);
                out[2 * i + 1] = USE_ANY;
            }
            return cx.insts[cond].nargs;
        }
        if term == Term::Ret {
            let ret = FNS[IRFUNCS[cx.irf].f].ret;
            if is_compound(ret)
                && !conv_returns_through_pointer(cx, fn_uses_c(IRFUNCS[cx.irf].f), ret)
                && cx.insts[cond].op == Slot {
                return 0;
            }
            out[0] = cond;
            out[1] = USE_ANY;
            return 1;
        }
        if term == Term::Branch && is_fused_compare(cx, cond) && cx.insts[cond].op == Test {
            out[0] = cx.insts[cond].a;
            out[1] = USE_REG;
            if cx.insts[cond].b == 0 {
                return 1;
            }
            out[2] = cx.insts[cond].b;
            out[3] = USE_REG;
            return 2;
        }
        if term == Term::Branch && is_fused_compare(cx, cond) {
            out[0] = cx.insts[cond].a;
            out[1] = USE_REG;
            let rhs = cx.insts[cond].b;
            if cx.insts[rhs].op == Const && fits_cmp_imm(cx.insts[rhs].imm) {
                return 1;
            }
            out[2] = rhs;
            out[3] = USE_REG;
            return 2;
        }
        if term == Term::Branch || term == Term::Switch {
            out[0] = cond;
            out[1] = USE_REG;
            return 1;
        }
        0
    }
}

// Whether a use of kind `kind` of value `v` makes it live: remat values
// only when they are needed in a register (else they are rematerialized
// where they are needed).
pub fn is_live_use(cx: sink *FnCtx, v: i64, kind: i64) -> bool {
    unsafe { kind == USE_REG || (kind == USE_ANY && !cx.insts[v].op.is_remat()) }
}

// Whether `v` is computed where it is defined.
pub fn is_emitted(cx: sink *FnCtx, v: i64) -> bool {
    unsafe {
        let op = cx.insts[v].op;
        if op == Phi || op == Param || op == Piece || op == Pack {
            return false;
        }
        if op.is_remat() {
            if cx.insts[v].aux == 0 {
                return false;
            }
            let loc = vloc(cx, v, cx.insts[v].mark + 2);
            return loc >= 0 && loc < 64;
        }
        op.has_side_effect() || cx.regalloc_uses[v] > 0
    }
}

fn needs_location(cx: sink *FnCtx, v: i64) -> bool {
    unsafe {
        let op = cx.insts[v].op;
        if cx.insts[v].ty == 0 || cx.regalloc_uses[v] == 0 || is_fused_compare(cx, v) {
            return false;
        }
        !op.is_remat() || cx.reg_used[v] != 0
    }
}

// ---- Positions and liveness ----

fn ra_reserve(cx: sink *FnCtx, n: i64) {
    unsafe {
        if n <= cx.rv_cap {
            return;
        }
        var cap = cx.rv_cap * 2;
        if cap < n {
            cap = n;
        }
        if cap < 1024 {
            cap = 1024;
        }
        unsafe {
            free(cx.rv_first as *u8);
            free(cx.rv_slot as *u8);
            free(cx.rv_hint as *u8);
            free(cx.rv_hreg as *u8);
        }
        cx.rv_first = alloc_array::<i64>(cap);
        cx.rv_slot = alloc_array::<i64>(cap);
        cx.rv_hint = alloc_array::<i64>(cap);
        cx.rv_hreg = alloc_array::<i64>(cap);
        cx.rv_cap = cap;
    }
}

// Marks the values some use needs in a register.
pub fn mark_reg_uses(cx: sink *FnCtx) {
    unsafe {
        var out: [i64; 8] = [0; 8];
        for b in cx.order.items() {
            var v = cx.blocks[b].first;
            while v != 0 {
                if !is_fused_compare(cx, v) {
                    for i in 0..ir_operand_count(cx, v) {
                        if use_kind(cx, v, i) == USE_REG {
                            cx.reg_used[ir_operand(cx, v, i)] = 1;
                        }
                    }
                }
                v = cx.insts[v].next;
            }
            let n = term_uses(cx, b, &out as *i64);
            for i in 0..n {
                if out[2 * i + 1] == USE_REG {
                    cx.reg_used[out[2 * i]] = 1;
                }
            }
        }
    }
}

// Numbers the instructions and the allocated values.
pub fn number_positions(cx: sink *FnCtx) {
    unsafe {
        cx.bstart.count = 0;
        cx.bend.count = 0;
        cx.ra_vals.count = 0;
        var pos = 0;
        for b in cx.order.items() {
            let start = pos;
            cx.bstart.push(start);
            var v = cx.blocks[b].first;
            while v != 0 {
                let op = cx.insts[v].op;
                if op == Phi || op == Param {
                    cx.insts[v].mark = start;
                } else {
                    pos += 4;
                    cx.insts[v].mark = pos;
                }
                cx.insts[v].aux = 0;
                if needs_location(cx, v) {
                    cx.ra_vals.push(v);
                    cx.insts[v].aux = cx.ra_vals.count;
                }
                v = cx.insts[v].next;
            }
            pos += 4;
            cx.bend.push(pos);
            pos += 4;
        }
        ra_reserve(cx, cx.ra_vals.count);
    }
}

pub fn bit_set(set: *u64, i: i64) {
    unsafe { set[i >> 6] |= (1 as u64) << (i & 63) as u64; }
}

pub fn bit_clear(set: *u64, i: i64) {
    unsafe { set[i >> 6] &= ~((1 as u64) << (i & 63) as u64); }
}

fn bit_get(set: *u64, i: i64) -> bool {
    unsafe { (set[i >> 6] >> (i & 63) as u64) & 1 != 0 }
}

pub fn live_set(cx: sink *FnCtx, sets: *u64, k: i64) -> *u64 {
    unsafe { &sets[k * cx.live_words] }
}

// The dense index of operand `v` if it is allocated, else -1.
pub fn tracked(cx: sink *FnCtx, v: i64) -> i64 {
    if v == 0 {
        return -1;
    }
    unsafe { cx.insts[v].aux - 1 }
}

pub fn compute_liveness(cx: sink *FnCtx) {
    unsafe {
        let n = cx.order.count;
        cx.live_words = (cx.ra_vals.count + 63) / 64 + 1;
        free(cx.live_in as *u8);
        free(cx.live_out as *u8);
        cx.live_in = alloc_array::<u64>(n * cx.live_words + 1);
        cx.live_out = alloc_array::<u64>(n * cx.live_words + 1);
        let gen = alloc_array::<u64>(n * cx.live_words + 1);
        let kill = alloc_array::<u64>(n * cx.live_words + 1);
        var out: [i64; 8] = [0; 8];
        for k in 0..n {
            let b = cx.order.data[k];
            let g = live_set(cx, gen, k);
            let d = live_set(cx, kill, k);
            var v = cx.blocks[b].first;
            while v != 0 {
                if cx.insts[v].op != Phi && !is_fused_compare(cx, v) {
                    for i in 0..ir_operand_count(cx, v) {
                        let operand = ir_operand(cx, v, i);
                        let t = tracked(cx, operand);
                        if t >= 0 && is_live_use(cx, operand, use_kind(cx, v, i))
                            && !bit_get(d, t) {
                            bit_set(&*g, t);
                        }
                    }
                }
                let t = tracked(cx, v);
                if t >= 0 {
                    bit_set(&*d, t);
                }
                v = cx.insts[v].next;
            }
            let count = term_uses(cx, b, &out as *i64);
            for i in 0..count {
                let t = tracked(cx, out[2 * i]);
                if t >= 0 && is_live_use(cx, out[2 * i], out[2 * i + 1]) && !bit_get(d, t) {
                    bit_set(&*g, t);
                }
            }
        }
        var changed = true;
        while changed {
            changed = false;
            var k = n - 1;
            while k >= 0 {
                let b = cx.order.data[k];
                let live_out = live_set(cx, cx.live_out, k);
                for i in 0..succ_count(cx, b) {
                    let s = succ(cx, b, i);
                    let sk = cx.blocks[s].order;
                    let sin = live_set(cx, cx.live_in, sk);
                    for w in 0..cx.live_words {
                        live_out[w] |= sin[w];
                    }
                    // Phi operands flowing from b.
                    let index = pred_index(cx, s, b);
                    var phi = cx.blocks[s].first;
                    while phi != 0 && cx.insts[phi].op == Phi {
                        let arg = ir_arg(cx, phi, index);
                        let t = tracked(cx, arg);
                        if t >= 0 && tracked(cx, phi) >= 0 && is_live_use(cx, arg, USE_ANY) {
                            bit_set(&*live_out, t);
                        }
                        phi = cx.insts[phi].next;
                    }
                }
                let live_in = live_set(cx, cx.live_in, k);
                let g = live_set(cx, gen, k);
                let d = live_set(cx, kill, k);
                for w in 0..cx.live_words {
                    let value = g[w] | (live_out[w] & ~d[w]);
                    if value != live_in[w] {
                        live_in[w] = value;
                        changed = true;
                    }
                }
                k -= 1;
            }
        }
        free(gen as *u8);
        free(kill as *u8);
    }
}

// Whether `v` is the integer constant 0 (read from xzr on AArch64).
pub fn is_zero_operand(cx: sink *FnCtx, v: i64) -> bool {
    unsafe { cx.insts[v].op == Const && cx.insts[v].imm == 0 && !is_float(cx.insts[v].ty) }
}
