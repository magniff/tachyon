// Tiling by maximal munch (isel/mod.vl, step 2): the rules that rewrite
// an instruction and the operands it covers into a machine operation, per
// target: addresses, lea, madd, shop, ubfx, test branches, selects and
// library calls.

use crate::back::emit::blocks::fits_cmp_imm;
use crate::back::isel::{
    coverable, isel_const, isel_count_uses, isel_release, isel_retain, isel_set_operands,
};
use crate::back::mc_arm64::ops::{is_logical_imm, ma_int_imm_ok};
use crate::base::{streq, sym_name};
use crate::base::target::{ELF, X86};
use crate::front::types::{
    FNS, TY_F32, TY_F64, TY_U32, TY_U64, fn_param, int_bits, is_float, is_integer, is_signed,
    type_size,
};
use crate::gen0::target::{LINK_NAMES, log2};
use crate::gen0::x86_64::fits_i32;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Cond, IRFUNCS, Op, Term, ir_arg, ir_set_arg};
use crate::middle::ir::Op::{
    Add, And, Call, Cmp, Const, FMath, Lea, Load, LoadX, MAdd, MSub, Mul, Or, Select, ShOp, Shl,
    Shr, Slot, Store, StoreX, Sub, Test, Ubfx, Xor,
};
use crate::middle::opt::resolve_all;

// ---- Tiling ----

pub fn isel_function(cx: sink *FnCtx, fi: i64) {
    resolve_all(cx, fi);
    isel_count_uses(cx, fi);
    unsafe {
        for b in IRFUNCS[fi].blocks.items() {
            if cx.blocks[b].removed != 0 {
                continue;
            }
            isel_branch(cx, b);
            var v = cx.blocks[b].last;
            while v != 0 {
                let prev = cx.insts[v].prev;
                if cx.isel_uses[v] > 0 || cx.insts[v].op.has_side_effect() {
                    isel_inst(cx, v);
                }
                v = prev;
            }
        }
    }
}

fn isel_inst(cx: sink *FnCtx, v: i64) {
    unsafe {
        let op = cx.insts[v].op;
        if op == Call {
            isel_libcall(cx, v);
        } else if op == Load || op == Store {
            isel_address(cx, v);
        } else if op == Select {
            isel_select_test(cx, v);
            isel_select_increment(cx, v);
        } else if is_float(cx.insts[v].ty) {
            return;
        } else if X86 {
            if op == Add || op == Sub {
                isel_lea(cx, v);
            }
        } else if op == Add || op == Sub {
            if !isel_madd(cx, v) && !isel_cinc(cx, v) {
                isel_shop(cx, v);
            }
        } else if op == And {
            if !isel_ubfx(cx, v) {
                isel_shop(cx, v);
            }
        } else if op == Or || op == Xor {
            if !isel_rotate(cx, v) {
                isel_shop(cx, v);
            }
        }
    }
}

// A 64-bit integer type (no normalization).
fn is_wide_int(ty: i64) -> bool {
    is_integer(ty) && int_bits(ty) == 64
}

// load/store of base + (index << s) (or base + index).
fn isel_address(cx: sink *FnCtx, v: i64) {
    unsafe {
        let addr = cx.insts[v].a;
        let store = cx.insts[v].op == Store;
        let ty = if store { cx.insts[v].imm2 } else { cx.insts[v].ty };
        let offset = cx.insts[v].imm;
        if !coverable(cx, addr, Add, v) || !is_wide_int(cx.insts[addr].ty) {
            return;
        }
        if !X86 && offset != 0 {
            return;
        }
        if X86 && !fits_i32(offset) {
            return;
        }
        let size = type_size(ty);
        var chosen_base = 0;
        var chosen_index = 0;
        var chosen_scale = -1;
        // A shifted index first, then a plain one.
        for side in 0..2 {
            let base = if side == 0 { cx.insts[addr].a } else { cx.insts[addr].b };
            let index = if side == 0 { cx.insts[addr].b } else { cx.insts[addr].a };
            var k = 0;
            if chosen_scale < 0 && coverable(cx, index, Shl, addr)
                && is_wide_int(cx.insts[index].ty)
                && isel_const(cx, cx.insts[index].b, &k) && base_ok(cx, base) {
                let s = k & 63;
                if (X86 && s <= 3) || (!X86 && (s == 0 || (1 << s as u64) == size)) {
                    chosen_base = base;
                    chosen_index = cx.insts[index].a;
                    chosen_scale = s;
                }
            }
        }
        if chosen_scale < 0 {
            let base = cx.insts[addr].a;
            let index = cx.insts[addr].b;
            if cx.insts[index].op.is_remat() && !cx.insts[base].op.is_remat() {
                // A constant or an address is the base (a slot from %rsp).
                if !base_ok(cx, index) {
                    return;
                }
                chosen_base = index;
                chosen_index = base;
            } else {
                if !base_ok(cx, base) {
                    return;
                }
                chosen_base = base;
                chosen_index = index;
            }
            if cx.insts[chosen_index].op == Const {
                // base + constant: instcombine folds those into the offset.
                return;
            }
            chosen_scale = 0;
        }
        if store {
            let value = cx.insts[v].b;
            cx.insts[v].op = StoreX;
            isel_set_operands(cx, v, chosen_base, chosen_index, value);
        } else {
            cx.insts[v].op = LoadX;
            isel_set_operands(cx, v, chosen_base, chosen_index, 0);
        }
        cx.insts[v].scale = chosen_scale;
    }
}

// Whether `base` may be the base of an indexed access: a frame slot only
// on x86-64 (from %rsp, the slot's offset in the displacement).
fn base_ok(cx: sink *FnCtx, base: i64) -> bool {
    unsafe { base != 0 && (X86 || cx.insts[base].op != Slot) }
}

// x86-64: a + (b << s), a + b, a + k, a - k into any register.
fn isel_lea(cx: sink *FnCtx, v: i64) {
    unsafe {
        let ty = cx.insts[v].ty;
        if !is_wide_int(ty) {
            return;
        }
        let a = cx.insts[v].a;
        let b = cx.insts[v].b;
        var k = 0;
        if isel_const(cx, b, &k) {
            let disp = if cx.insts[v].op == Sub { 0 - k } else { k };
            if !fits_i32(k) || !fits_i32(disp) || cx.insts[a].op.is_remat() {
                return;
            }
            cx.insts[v].op = Lea;
            cx.insts[v].imm = disp;
            cx.insts[v].scale = 0;
            // (x * 3) + k = k(x, x, 2), and (x + y) + k = k(x, y).
            var m = 0;
            if coverable(cx, a, Mul, v) && cx.insts[a].ty == ty
                && isel_const(cx, cx.insts[a].b, &m)
                && (m == 3 || m == 5 || m == 9) {
                cx.insts[v].scale = log2(m - 1);
                isel_set_operands(cx, v, cx.insts[a].a, cx.insts[a].a, 0);
                return;
            }
            if coverable(cx, a, Add, v) && cx.insts[a].ty == ty
                && !cx.insts[cx.insts[a].a].op.is_remat()
                && !cx.insts[cx.insts[a].b].op.is_remat() {
                isel_set_operands(cx, v, cx.insts[a].a, cx.insts[a].b, 0);
                return;
            }
            isel_set_operands(cx, v, a, 0, 0);
            return;
        }
        if cx.insts[v].op != Add || cx.insts[a].op == Const || cx.insts[b].op == Const {
            return;
        }
        for side in 0..2 {
            let base = if side == 0 { a } else { b };
            let index = if side == 0 { b } else { a };
            var s = 0;
            if coverable(cx, index, Shl, v) && cx.insts[index].ty == ty
                && isel_const(cx, cx.insts[index].b, &s)
                && (s & 63) <= 3 && cx.insts[base].op != Slot {
                cx.insts[v].op = Lea;
                cx.insts[v].imm = 0;
                cx.insts[v].scale = s & 63;
                isel_set_operands(cx, v, base, cx.insts[index].a, 0);
                return;
            }
        }
        if cx.insts[a].op == Slot || cx.insts[b].op == Slot {
            return;
        }
        cx.insts[v].op = Lea;
        cx.insts[v].imm = 0;
        cx.insts[v].scale = 0;
        isel_set_operands(cx, v, a, b, 0);
    }
}

// AArch64: c + a * b, c - a * b.
fn isel_madd(cx: sink *FnCtx, v: i64) -> bool {
    unsafe {
        let ty = cx.insts[v].ty;
        let sub = cx.insts[v].op == Sub;
        for side in 0..2 {
            if sub && side == 1 {
                break;
            }
            let m = if side == 0 { cx.insts[v].b } else { cx.insts[v].a };
            let other = if side == 0 { cx.insts[v].a } else { cx.insts[v].b };
            var k = 0;
            if coverable(cx, m, Mul, v) && cx.insts[m].ty == ty && cx.insts[other].op != Const
                && !(isel_const(cx, cx.insts[m].b, &k) && ma_int_imm_ok(Mul, k)) {
                cx.insts[v].op = if sub { MSub } else { MAdd };
                isel_set_operands(cx, v, cx.insts[m].a, cx.insts[m].b, other);
                return true;
            }
        }
        false
    }
}

// AArch64: x + (a cmp b), an integer comparison's 0 or 1 added: cinc (a
// csinc on the opposite condition, !c ? x : x + 1), so the comparison's
// flags feed the add instead of a cset first (0.20: the branchless
// partitions and merges of std's sorts count with it). 64-bit only, as
// isel_select_increment.
fn isel_cinc(cx: sink *FnCtx, v: i64) -> bool {
    unsafe {
        if cx.insts[v].op != Add || !is_wide_int(cx.insts[v].ty) {
            return false;
        }
        for side in 0..2 {
            let c = if side == 0 { cx.insts[v].b } else { cx.insts[v].a };
            let other = if side == 0 { cx.insts[v].a } else { cx.insts[v].b };
            if !coverable(cx, c, Cmp, v) || is_float(cx.insts[c].imm2) || other == 0
                || cx.insts[other].op == Const {
                continue;
            }
            let lhs = cx.insts[c].a;
            var rhs = cx.insts[c].b;
            var imm = 0;
            var value = 0;
            if isel_const(cx, rhs, &value) && fits_cmp_imm(value) {
                rhs = 0;
                imm = value;
            }
            cx.insts[v].op = Select;
            cx.insts[v].cond = cx.insts[c].cond.negate();
            cx.insts[v].imm2 = cx.insts[c].imm2;
            cx.insts[v].imm = imm;
            cx.insts[v].scale = 2;
            cx.insts[v].args = cx.args.count;
            cx.args.push(lhs);
            cx.argty.push(0);
            cx.args.push(rhs);
            cx.argty.push(0);
            cx.insts[v].nargs = 2;
            isel_retain(cx, lhs);
            isel_retain(cx, rhs);
            isel_set_operands(cx, v, other, other, 0);
            return true;
        }
        false
    }
}

// AArch64 (0.20): (x << a) | (x >> b) with a + b the width, a rotation:
// ror (also with ^, the two sides having no bit in common). u64 and u32
// only: an unsigned >> is a logical shift.
fn isel_rotate(cx: sink *FnCtx, v: i64) -> bool {
    unsafe {
        let ty = cx.insts[v].ty;
        let bits = if ty == TY_U64 { 64 } else if ty == TY_U32 { 32 } else { 0 };
        if bits == 0 {
            return false;
        }
        for side in 0..2 {
            let l = if side == 0 { cx.insts[v].a } else { cx.insts[v].b };
            let r = if side == 0 { cx.insts[v].b } else { cx.insts[v].a };
            if !coverable(cx, l, Shl, v) || !coverable(cx, r, Shr, v) || cx.insts[l].ty != ty
                || cx.insts[r].ty != ty || cx.insts[l].a != cx.insts[r].a {
                continue;
            }
            var ka = 0;
            var kb = 0;
            if !isel_const(cx, cx.insts[l].b, &ka) || !isel_const(cx, cx.insts[r].b, &kb)
                || ka <= 0 || kb <= 0 || ka + kb != bits {
                continue;
            }
            cx.insts[v].op = ShOp;
            cx.insts[v].imm = kb;
            cx.insts[v].imm2 = 4 * (Or as i64) + 3;
            isel_set_operands(cx, v, cx.insts[r].a, 0, 0);
            return true;
        }
        false
    }
}

// AArch64: x op (y sh k).
fn isel_shop(cx: sink *FnCtx, v: i64) -> bool {
    unsafe {
        let ty = cx.insts[v].ty;
        let op = cx.insts[v].op;
        let commutative = op != Sub;
        for side in 0..2 {
            if !commutative && side == 1 {
                break;
            }
            let s = if side == 0 { cx.insts[v].b } else { cx.insts[v].a };
            let other = if side == 0 { cx.insts[v].a } else { cx.insts[v].b };
            if other == 0 || cx.insts[other].op == Const || s == 0 {
                continue;
            }
            var k = 0;
            let sop = cx.insts[s].op;
            if (sop == Shl || sop == Shr) && coverable(cx, s, sop, v) && cx.insts[s].ty == ty
                && isel_const(cx, cx.insts[s].b, &k) {
                let amount = k & (if int_bits(ty) == 64 { 63 } else { 31 });
                let kind = if sop == Shl { 0 } else if is_signed(ty) { 2 } else { 1 };
                cx.insts[v].op = ShOp;
                cx.insts[v].imm = amount;
                cx.insts[v].imm2 = 4 * (op as i64) + kind;
                isel_set_operands(cx, v, other, cx.insts[s].a, 0);
                return true;
            }
        }
        false
    }
}

// AArch64: (x >> k) & (2^n - 1), the field within the type.
fn isel_ubfx(cx: sink *FnCtx, v: i64) -> bool {
    unsafe {
        let ty = cx.insts[v].ty;
        let s = cx.insts[v].a;
        var mask = 0;
        var k = 0;
        if !isel_const(cx, cx.insts[v].b, &mask) || mask <= 0 || !coverable(cx, s, Shr, v)
            || cx.insts[s].ty != ty
            || !isel_const(cx, cx.insts[s].b, &k) {
            return false;
        }
        if (mask & (mask + 1)) != 0 {
            return false;
        }
        let n = log2(mask + 1);
        let amount = k & (if int_bits(ty) == 64 { 63 } else { 31 });
        if n < 1 || amount + n > int_bits(ty) {
            return false;
        }
        cx.insts[v].op = Ubfx;
        cx.insts[v].imm = amount;
        cx.insts[v].imm2 = n;
        isel_set_operands(cx, v, cx.insts[s].a, 0, 0);
        true
    }
}

// The mask of a test as an immediate, when the target encodes it.
fn test_imm_ok(mask: i64) -> bool {
    if X86 { fits_i32(mask) } else { is_logical_imm(mask as u64) }
}

// The branch ending block b on (x & y) == 0 or != 0: a test.
fn isel_branch(cx: sink *FnCtx, b: i64) {
    unsafe {
        let c = cx.blocks[b].cond;
        if cx.blocks[b].term != Term::Branch || cx.blocks[b].s0 == cx.blocks[b].s1 || c == 0
            || cx.insts[c].op != Cmp || cx.isel_uses[c] != 1
            || cx.insts[c].block != b || cx.insts[c].next != 0 || is_float(cx.insts[c].imm2) {
            return;
        }
        let op = cx.insts[c].cond;
        var zero = 1;
        if (op != Cond::Eq && op != Cond::Ne) || !isel_const(cx, cx.insts[c].b, &zero)
            || zero != 0 {
            return;
        }
        let and = cx.insts[c].a;
        if !coverable(cx, and, And, c) {
            return;
        }
        var mask = 0;
        cx.insts[c].op = Test;
        if isel_const(cx, cx.insts[and].b, &mask) && test_imm_ok(mask) {
            cx.insts[c].imm = mask;
            isel_set_operands(cx, c, cx.insts[and].a, 0, 0);
        } else {
            isel_set_operands(cx, c, cx.insts[and].a, cx.insts[and].b, 0);
        }
    }
}

// A select on (x & y) == 0 or != 0 tests instead of comparing.
fn isel_select_test(cx: sink *FnCtx, v: i64) {
    unsafe {
        let lhs = ir_arg(cx, v, 0);
        let op = cx.insts[v].cond;
        if cx.insts[v].scale != 0 || ir_arg(cx, v, 1) != 0 || cx.insts[v].imm != 0
            || (op != Cond::Eq && op != Cond::Ne)
            || !coverable(cx, lhs, And, v) {
            return;
        }
        var mask = 0;
        cx.insts[v].scale = 1;
        isel_retain(cx, cx.insts[lhs].a);
        ir_set_arg(cx, v, 0, cx.insts[lhs].a);
        if isel_const(cx, cx.insts[lhs].b, &mask) && test_imm_ok(mask) {
            cx.insts[v].imm = mask;
        } else {
            isel_retain(cx, cx.insts[lhs].b);
            ir_set_arg(cx, v, 1, cx.insts[lhs].b);
        }
        isel_release(cx, lhs);
    }
}

// AArch64: a select of an increment adds it itself (csinc): c ? a : b + 1;
// for c ? a + 1 : b, the condition is inverted (integer comparisons and
// tests only: a negated float comparison is not the opposite one).
fn isel_select_increment(cx: sink *FnCtx, v: i64) {
    unsafe {
        // 64-bit integers only: csinc adds without wrapping at a narrower width.
        if X86 || !is_wide_int(cx.insts[v].ty) || (cx.insts[v].scale & 2) != 0 {
            return;
        }
        var one = 0;
        let other = cx.insts[v].b;
        if coverable(cx, other, Add, v) && cx.insts[other].ty == cx.insts[v].ty
            && isel_const(cx, cx.insts[other].b, &one)
            && one == 1 {
            cx.insts[v].scale = cx.insts[v].scale | 2;
            isel_set_operands(cx, v, cx.insts[v].a, cx.insts[other].a, 0);
            return;
        }
        let then = cx.insts[v].a;
        let invertible = (cx.insts[v].scale & 1) == 1 || !is_float(cx.insts[v].imm2);
        if invertible && coverable(cx, then, Add, v) && cx.insts[then].ty == cx.insts[v].ty
            && isel_const(cx, cx.insts[then].b, &one) && one == 1 {
            cx.insts[v].scale = cx.insts[v].scale | 2;
            cx.insts[v].cond = cx.insts[v].cond.negate();
            isel_set_operands(cx, v, cx.insts[v].b, cx.insts[then].a, 0);
        }
    }
}

// A call of one of the C library's math functions that is one instruction
// (of a function declared with its C signature, under its own name).
fn isel_libcall(cx: sink *FnCtx, v: i64) {
    unsafe {
        let f = cx.insts[v].imm;
        if !FNS[f].is_extern || FNS[f].variadic || FNS[f].param_count != 1 || cx.insts[v].nargs != 1
            || cx.insts[v].c != 0 {
            return;
        }
        let ty = FNS[f].ret;
        if (ty != TY_F64 && ty != TY_F32) || fn_param(f, 0) != ty
            || LINK_NAMES.get(FNS[f].name + 1) > 0 {
            return;
        }
        let single = ty == TY_F32;
        let name = sym_name(FNS[f].name);
        var kind = -1;
        if streq(name, if single { c"sqrtf" } else { c"sqrt" }) {
            kind = 0;
        } else if streq(name, if single { c"fabsf" } else { c"fabs" }) {
            kind = 1;
        } else if streq(name, if single { c"floorf" } else { c"floor" }) {
            kind = 2;
        } else if streq(name, if single { c"ceilf" } else { c"ceil" }) {
            kind = 3;
        } else if streq(name, if single { c"truncf" } else { c"trunc" }) {
            kind = 4;
        } else if streq(name, if single { c"roundf" } else { c"round" }) {
            kind = 5;
        }
        // glibc's sqrt sets errno for negative arguments; x86-64 has the others
        // only from SSE4.1 on.
        if kind < 0 || (kind == 0 && ELF) || (kind > 0 && X86) {
            return;
        }
        let arg = ir_arg(cx, v, 0);
        cx.insts[v].op = FMath;
        cx.insts[v].a = arg;
        cx.insts[v].b = 0;
        cx.insts[v].c = 0;
        cx.insts[v].imm = kind;
        cx.insts[v].args = 0;
        cx.insts[v].nargs = 0;
    }
}
