// The late expansion of CPUFEAT (0.19, docs/design/arch.md §2.5), just
// before instruction selection: what the optimizer kept of
// std::arch::detect (pure, numbered by GVN, hoisted by LICM, unswitched)
// becomes the test of the run-time feature word.
//
// Phase 0 (a stub, T3 owns it): every CPUFEAT is the constant false, so a
// detect of a feature that is not known takes the fallback path. T3 makes
// it a load of the cached word, a bit test, and the cold call of
// std::arch::init_features when the word is 0.

use crate::middle::ctx::FnCtx;
use crate::middle::ir::{IRFUNCS, Op};

// The CPUFEATs of function fi (the current one).
pub fn expand_cpu_features(mut cx: *FnCtx, fi: i64) {
    unsafe {
        for b in IRFUNCS[fi].blocks.items() {
            if cx.blocks[b].removed != 0 {
                continue;
            }
            let mut v = cx.blocks[b].first;
            while v != 0 {
                if cx.insts[v].op == Op::CpuFeat {
                    cx.insts[v].op = Op::Const;
                    cx.insts[v].imm = 0;
                }
                v = cx.insts[v].next;
            }
        }
    }
}
