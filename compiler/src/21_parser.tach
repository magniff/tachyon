// Parser: tokens to the AST. Items and statements by recursive descent,
// expressions by a Pratt parser with the binding powers of
// docs/grammar.md. The first syntax error ends the compilation.

static mut P: i64 = 0;
// In `if`/`while` conditions and `for` ranges, `Name {` starts the body.
static mut NO_STRUCT: bool = false;

const AS_BP: i64 = 24;
const PREFIX_BP: i64 = 25;
const POSTFIX_BP: i64 = 27;

fn tok_kind(offset: i64) -> Tok {
    let i = P + offset;
    if i >= TOK_COUNT { Tok::Eof } else { TOKS[i].kind }
}

fn cur() -> Tok {
    TOKS[P].kind
}

fn at(kind: Tok) -> bool {
    TOKS[P].kind == kind
}

fn cur_start() -> i64 {
    TOKS[P].start
}

// The end of the previous token.
fn prev_end() -> i64 {
    if P == 0 { 0 } else { TOKS[P - 1].end }
}

fn advance() {
    if TOKS[P].kind != Tok::Eof {
        P += 1;
    }
}

fn eat(kind: Tok) -> bool {
    if at(kind) {
        advance();
        return true;
    }
    false
}

fn err_token(i: i64) {
    let kind = TOKS[i].kind;
    if kind == Tok::Ident || kind == Tok::Reserved || kind.is_keyword() {
        err_sym(TOKS[i].value as i64);
    } else if kind == Tok::Int || kind == Tok::Float || kind == Tok::Char {
        buf_bytes(ERR, SRC[TOKS[i].start..TOKS[i].end]);
    } else if kind == Tok::Str || kind == Tok::CStr {
        err_str(c"string literal");
    } else {
        err_str(kind.text());
    }
}

fn syntax_error(message: *u8) -> ! {
    err_begin(cur_start());
    err_str(message);
    err_str(c", got '");
    err_token(P);
    err_str(c"'");
    err_end()
}

fn expect(kind: Tok) {
    if !at(kind) {
        err_begin(cur_start());
        err_str(c"expected '");
        err_str(kind.text());
        err_str(c"', got '");
        err_token(P);
        err_str(c"'");
        err_end();
    }
    advance();
}

fn reserved_error() -> ! {
    err_begin(cur_start());
    err_str(c"'");
    err_token(P);
    if at(Tok::Reserved) {
        err_str(c"' is a reserved keyword (reserved for future use)");
    } else {
        err_str(c"' is reserved for future use");
    }
    err_end()
}

static mut UNDERSCORE: i64 = -1;

fn expect_ident() -> i64 {
    if at(Tok::Reserved) {
        reserved_error();
    }
    if !at(Tok::Ident) {
        syntax_error(c"expected identifier");
    }
    let sym = TOKS[P].value as i64;
    advance();
    sym
}

// A name being declared: an identifier other than `_`.
fn expect_binding_name() -> i64 {
    if at(Tok::Ident) && TOKS[P].value as i64 == UNDERSCORE {
        error_at(cur_start(), c"'_' cannot be used as a name here");
    }
    expect_ident()
}

fn with_no_struct(value: bool) -> bool {
    let saved = NO_STRUCT;
    NO_STRUCT = value;
    saved
}

// ---- Items ----

fn parse_program() -> i64 {
    UNDERSCORE = intern_c(c"_");
    let program = new_node(NodeKind::None, 0, 0);
    let mark = list_begin();
    while !at(Tok::Eof) {
        if at(Tok::Impl) {
            // The functions of an impl block are items of the program.
            parse_impl();
        } else if at(Tok::Extern) {
            parse_extern();
        } else if at(Tok::Hash) {
            list_push(parse_attributed_item());
        } else {
            list_push(parse_item());
        }
    }
    list_end(program, mark);
    program
}

fn parse_item() -> i64 {
    match cur() {
        Tok::Fn => parse_function(),
        Tok::Struct | Tok::Union => parse_struct(),
        Tok::Const => parse_const_or_static(NodeKind::Const),
        Tok::Static => parse_const_or_static(NodeKind::Static),
        Tok::Type => parse_type_alias(),
        Tok::Enum => parse_enum(),
        Tok::Reserved => reserved_error(),
        _ => syntax_error(c"expected an item ('fn', 'extern', 'struct', 'union', 'enum', 'impl', 'const', 'static' or 'type')"),
    }
}

// `impl T { fn ... }`: each function is pushed as an item, marked with T.
fn parse_impl() {
    expect(Tok::Impl);
    let type_name = expect_ident();
    if at(Tok::Lt) {
        error_at(cur_start(), c"generic impl blocks are not supported yet");
    }
    expect(Tok::LBrace);
    while !at(Tok::RBrace) && !at(Tok::Eof) {
        if !at(Tok::Fn) {
            syntax_error(c"expected 'fn' or '}' in an impl block");
        }
        let f = parse_function();
        NODES[f].d = type_name;
        list_push(f);
    }
    expect(Tok::RBrace);
}

// `enum E { A, B(T, ...), C = expr, ... }`
fn parse_enum() -> i64 {
    let start = cur_start();
    expect(Tok::Enum);
    let n = new_node(NodeKind::Enum, start, 0);
    NODES[n].a = expect_binding_name();
    if at(Tok::Lt) {
        error_at(cur_start(), c"generic enums are not supported yet");
    }
    expect(Tok::LBrace);
    let mark = list_begin();
    while !at(Tok::RBrace) && !at(Tok::Eof) {
        let variant = new_node(NodeKind::Variant, cur_start(), 0);
        NODES[variant].a = expect_binding_name();
        if at(Tok::LBrace) {
            error_at(cur_start(), c"struct-like enum variants are not supported yet; use a tuple variant");
        }
        if eat(Tok::LParen) {
            NODES[variant].c = 1;
            let types = list_begin();
            while !at(Tok::RParen) && !at(Tok::Eof) {
                list_push(parse_type());
                if !eat(Tok::Comma) {
                    break;
                }
            }
            list_end(variant, types);
            expect(Tok::RParen);
        }
        if eat(Tok::Eq) {
            NODES[variant].b = parse_expr();
        }
        NODES[variant].end = prev_end();
        list_push(variant);
        if !eat(Tok::Comma) {
            break;
        }
    }
    list_end(n, mark);
    expect(Tok::RBrace);
    NODES[n].end = prev_end();
    n
}

fn parse_function() -> i64 {
    let start = cur_start();
    expect(Tok::Fn);
    let n = new_node(NodeKind::Fn, start, 0);
    NODES[n].a = expect_binding_name();
    expect(Tok::LParen);
    parse_params(n, false);
    expect(Tok::RParen);
    NODES[n].b = parse_return_type();
    NODES[n].c = parse_block();
    NODES[n].end = prev_end();
    n
}

// After `extern "C"`: a block of C declarations, `extern "C" { fn f(...)
// -> T; static mut x: T; }`; a function with the C convention and an
// unmangled symbol, `extern "C" fn f(...) -> T { ... }`; or a static with
// a C symbol, `extern "C" static mut x: T = v;`. Items are pushed to the
// program's list. (0.2's single declarations, `extern fn f(...) -> T;`,
// were removed in 0.4.)
fn parse_extern() {
    let start = cur_start();
    expect(Tok::Extern);
    if !at(Tok::Str) {
        error_at(start, c_fn_outside_block());
    }
    let abi = TOKS[P].value as i64;
    if !(STRS[abi].len == 1 && STRS[abi].ptr[0] == 'C') {
        error_at(cur_start(), c"unsupported ABI; only \"C\" is supported");
    }
    advance();
    if eat(Tok::LBrace) {
        while !at(Tok::RBrace) && !at(Tok::Eof) {
            if at(Tok::Fn) {
                list_push(parse_c_function(cur_start(), true));
            } else if at(Tok::Static) {
                list_push(parse_c_static(cur_start(), false));
            } else {
                syntax_error(c"expected 'fn', 'static' or '}' in an extern block");
            }
        }
        expect(Tok::RBrace);
        return;
    }
    if at(Tok::Static) {
        list_push(parse_c_static(start, true));
        return;
    }
    list_push(parse_c_function(start, false));
}

fn c_fn_outside_block() -> *u8 {
    c"C functions are declared in an extern block: `extern \"C\" { fn f(...) -> T; }` (the 0.2 form `extern fn f(...) -> T;` was removed in 0.4)"
}

// `fn f(...) -> T;` (a C function, only in an extern block) or `fn
// f(...) -> T { ... }` (one with the C convention, defined here).
fn parse_c_function(start: i64, in_block: bool) -> i64 {
    if tok_kind(2) == Tok::LParen {
        // Look past the parameters for the body.
        let saved = P;
        advance();
        advance();
        let mut depth = 0;
        while !at(Tok::Eof) {
            if at(Tok::LParen) {
                depth += 1;
            } else if at(Tok::RParen) {
                depth -= 1;
                if depth == 0 {
                    break;
                }
            }
            advance();
        }
        advance();
        if eat(Tok::Arrow) {
            parse_type();
        }
        let has_body = at(Tok::LBrace);
        P = saved;
        if has_body {
            let f = parse_function();
            NODES[f].start = start;
            NODES[f].y = 1;
            return f;
        }
    }
    if !in_block {
        error_at(start, c_fn_outside_block());
    }
    expect(Tok::Fn);
    let n = new_node(NodeKind::ExternFn, start, 0);
    NODES[n].a = expect_binding_name();
    expect(Tok::LParen);
    NODES[n].d = parse_params(n, true) as i64;
    expect(Tok::RParen);
    NODES[n].b = parse_return_type();
    expect(Tok::Semi);
    NODES[n].end = prev_end();
    n
}

// `static [mut] x: T;` (defined in C) or, when `defines`, also `static
// [mut] x: T = v;` (defined here, with a C symbol).
fn parse_c_static(start: i64, defines: bool) -> i64 {
    expect(Tok::Static);
    let n = new_node(NodeKind::Static, start, 0);
    NODES[n].d = eat(Tok::Mut) as i64;
    NODES[n].a = expect_binding_name();
    expect(Tok::Colon);
    NODES[n].b = parse_type();
    NODES[n].y = 1;
    if defines && eat(Tok::Eq) {
        NODES[n].c = parse_expr();
        NODES[n].y = 2;
    }
    expect(Tok::Semi);
    NODES[n].end = prev_end();
    n
}

// `#[repr(...)]` before a struct, union or enum.
fn parse_attributed_item() -> i64 {
    let mut flags = 0;
    let mut align = 0;
    let mut int_type = 0;
    let at_start = cur_start();
    while at(Tok::Hash) {
        advance();
        expect(Tok::LBracket);
        let name = expect_ident();
        if name != intern_c(c"repr") {
            name_error(TOKS[P - 1].start, c"unknown attribute '", name, c"' (attributes in 0.3: repr)");
        }
        expect(Tok::LParen);
        while !at(Tok::RParen) && !at(Tok::Eof) {
            let pos = cur_start();
            let arg = expect_ident();
            if arg == intern_c(c"C") {
                flags |= REPR_C;
            } else if arg == intern_c(c"packed") {
                flags |= REPR_PACKED;
            } else if arg == intern_c(c"align") {
                expect(Tok::LParen);
                if !at(Tok::Int) {
                    syntax_error(c"expected the alignment");
                }
                align = TOKS[P].value as i64;
                advance();
                expect(Tok::RParen);
                if align < 1 || align > 16 || (align & (align - 1)) != 0 {
                    error_at(pos, c"align(N) needs a power of two from 1 to 16");
                }
            } else if is_int_type_name(arg) {
                flags |= REPR_INT;
                int_type = arg;
            } else {
                name_error(pos, c"unknown repr '", arg, c"' (expected C, packed, align(N) or an integer type)");
            }
            if !eat(Tok::Comma) {
                break;
            }
        }
        expect(Tok::RParen);
        expect(Tok::RBracket);
    }
    if !at(Tok::Struct) && !at(Tok::Union) && !at(Tok::Enum) {
        error_at(at_start, c"#[repr(...)] goes before a struct, union or enum");
    }
    if ((flags & REPR_PACKED) != 0 || align != 0) && (flags & REPR_C) == 0 {
        error_at(at_start, c"packed and align(N) are only for #[repr(C, ...)] types");
    }
    if (flags & REPR_PACKED) != 0 && align != 0 {
        error_at(at_start, c"a type cannot be both packed and aligned");
    }
    let item = parse_item();
    if NODES[item].kind == NodeKind::Enum {
        if (flags & REPR_PACKED) != 0 || align != 0 {
            error_at(at_start, c"packed and align(N) are for structs and unions, not enums");
        }
        NODES[item].d = int_type;
    } else {
        if (flags & REPR_INT) != 0 {
            error_at(at_start, c"an integer repr is for enums only");
        }
        NODES[item].d = align;
    }
    NODES[item].c = NODES[item].c | flags;
    item
}

// Whether `name` is an integer type's name (for #[repr(u8)] and so on).
fn is_int_type_name(name: i64) -> bool {
    let names: [*u8; 8] = [c"i8", c"i16", c"i32", c"i64", c"u8", c"u16", c"u32", c"u64"];
    for i in 0..8 {
        if name == intern_c(names[i]) {
            return true;
        }
    }
    false
}

// The parameters of `n` up to `)`; whether they end with `...`.
fn parse_params(n: i64, allow_ellipsis: bool) -> bool {
    let mark = list_begin();
    let mut variadic = false;
    while !at(Tok::RParen) && !at(Tok::Eof) {
        if at(Tok::Ellipsis) {
            if !allow_ellipsis {
                error_at(cur_start(), c"only extern functions can be variadic");
            }
            advance();
            variadic = true;
            eat(Tok::Comma);
            break;
        }
        list_push(parse_param());
        if !eat(Tok::Comma) {
            break;
        }
    }
    list_end(n, mark);
    variadic
}

fn parse_param() -> i64 {
    let start = cur_start();
    let mutable = eat(Tok::Mut);
    let n = new_node(NodeKind::Param, start, 0);
    NODES[n].a = if mutable { expect_binding_name() } else { expect_ident() };
    expect(Tok::Colon);
    NODES[n].b = parse_type();
    NODES[n].c = mutable as i64;
    NODES[n].end = prev_end();
    n
}

fn parse_return_type() -> i64 {
    if eat(Tok::Arrow) { parse_type() } else { 0 }
}

fn parse_struct() -> i64 {
    let start = cur_start();
    let is_union = at(Tok::Union);
    advance();
    let n = new_node(NodeKind::Struct, start, 0);
    if is_union {
        NODES[n].c = REPR_UNION;
    }
    NODES[n].a = expect_binding_name();
    expect(Tok::LBrace);
    let mark = list_begin();
    while !at(Tok::RBrace) && !at(Tok::Eof) {
        let field_start = cur_start();
        let field = new_node(NodeKind::Field, field_start, 0);
        NODES[field].a = expect_binding_name();
        expect(Tok::Colon);
        NODES[field].b = parse_type();
        NODES[field].end = prev_end();
        list_push(field);
        if !eat(Tok::Comma) {
            break;
        }
    }
    list_end(n, mark);
    expect(Tok::RBrace);
    NODES[n].end = prev_end();
    n
}

fn parse_const_or_static(kind: NodeKind) -> i64 {
    let start = cur_start();
    advance();
    let n = new_node(kind, start, 0);
    if kind == NodeKind::Static {
        NODES[n].d = eat(Tok::Mut) as i64;
    }
    NODES[n].a = expect_binding_name();
    expect(Tok::Colon);
    NODES[n].b = parse_type();
    expect(Tok::Eq);
    NODES[n].c = parse_expr();
    expect(Tok::Semi);
    NODES[n].end = prev_end();
    n
}

fn parse_type_alias() -> i64 {
    let start = cur_start();
    expect(Tok::Type);
    let n = new_node(NodeKind::TypeAlias, start, 0);
    NODES[n].a = expect_binding_name();
    if at(Tok::Lt) {
        error_at(cur_start(), c"generic type aliases are not supported yet");
    }
    expect(Tok::Eq);
    NODES[n].b = parse_type();
    expect(Tok::Semi);
    NODES[n].end = prev_end();
    n
}

// ---- Types ----

fn parse_type() -> i64 {
    let start = cur_start();
    let kind = cur();
    if kind == Tok::Ident {
        let n = new_node(NodeKind::TyName, start, 0);
        NODES[n].a = expect_ident();
        if at(Tok::ColonColon) {
            error_at(cur_start(), c"paths are not supported yet");
        }
        NODES[n].end = prev_end();
        return n;
    }
    if kind == Tok::Star {
        advance();
        let n = new_node(NodeKind::TyPtr, start, 0);
        NODES[n].a = parse_type();
        NODES[n].end = prev_end();
        return n;
    }
    if kind == Tok::Bang {
        advance();
        return new_node(NodeKind::TyNever, start, prev_end());
    }
    if kind == Tok::LParen {
        return parse_paren_type(start);
    }
    if kind == Tok::LBracket {
        return parse_array_type(start);
    }
    if kind == Tok::Fn {
        return parse_fn_type(start);
    }
    if kind == Tok::Extern {
        advance();
        if at(Tok::Str) {
            let abi = TOKS[P].value as i64;
            if !(STRS[abi].len == 1 && STRS[abi].ptr[0] == 'C') {
                error_at(cur_start(), c"unsupported ABI; only \"C\" is supported");
            }
            advance();
        }
        let n = parse_fn_type(start);
        NODES[n].d = 1;
        return n;
    }
    if kind == Tok::Reserved {
        reserved_error();
    }
    syntax_error(c"expected type")
}

fn parse_paren_type(start: i64) -> i64 {
    expect(Tok::LParen);
    if eat(Tok::RParen) {
        return new_node(NodeKind::TyUnit, start, prev_end());
    }
    let first = parse_type();
    if !eat(Tok::Comma) {
        expect(Tok::RParen);
        return first;
    }
    let n = new_node(NodeKind::TyTuple, start, 0);
    let mark = list_begin();
    list_push(first);
    while !at(Tok::RParen) && !at(Tok::Eof) {
        list_push(parse_type());
        if !eat(Tok::Comma) {
            break;
        }
    }
    list_end(n, mark);
    expect(Tok::RParen);
    NODES[n].end = prev_end();
    n
}

fn parse_array_type(start: i64) -> i64 {
    expect(Tok::LBracket);
    let n = new_node(NodeKind::TyArray, start, 0);
    NODES[n].a = parse_type();
    if eat(Tok::RBracket) {
        NODES[n].kind = NodeKind::TySlice;
        NODES[n].end = prev_end();
        return n;
    }
    expect(Tok::Semi);
    let saved = with_no_struct(false);
    NODES[n].b = parse_expr();
    NO_STRUCT = saved;
    expect(Tok::RBracket);
    NODES[n].end = prev_end();
    n
}

fn parse_fn_type(start: i64) -> i64 {
    expect(Tok::Fn);
    expect(Tok::LParen);
    let n = new_node(NodeKind::TyFn, start, 0);
    let mark = list_begin();
    while !at(Tok::RParen) && !at(Tok::Eof) {
        if at(Tok::Ellipsis) {
            error_at(cur_start(), c"function pointer types cannot be variadic; call variadic functions directly");
        }
        list_push(parse_type());
        if !eat(Tok::Comma) {
            break;
        }
    }
    list_end(n, mark);
    expect(Tok::RParen);
    if eat(Tok::Arrow) {
        NODES[n].a = parse_type();
    } else {
        NODES[n].a = new_node(NodeKind::TyUnit, prev_end(), prev_end());
    }
    NODES[n].end = prev_end();
    n
}

// ---- Blocks and statements ----

fn parse_block() -> i64 {
    let start = cur_start();
    expect(Tok::LBrace);
    let saved = with_no_struct(false);
    let block = new_node(NodeKind::Block, start, 0);
    let mark = list_begin();
    let mut tail = 0;
    while !at(Tok::RBrace) && !at(Tok::Eof) {
        if eat(Tok::Semi) {
            continue;
        }
        if is_item_start(cur()) {
            syntax_error(c"expected '}' (items cannot be nested in blocks)");
        }
        if tail != 0 {
            syntax_error(c"expected ';' or '}' after expression");
        }
        let stmt = parse_stmt();
        if NODES[stmt].kind == NodeKind::ExprStmt && NODES[stmt].b == 2 {
            // A tail expression.
            tail = NODES[stmt].a;
        } else {
            list_push(stmt);
        }
    }
    list_end(block, mark);
    NODES[block].a = tail;
    expect(Tok::RBrace);
    NO_STRUCT = saved;
    NODES[block].end = prev_end();
    block
}

fn is_item_start(kind: Tok) -> bool {
    kind == Tok::Fn || kind == Tok::Extern || kind == Tok::Struct || kind == Tok::Const
        || kind == Tok::Static || kind == Tok::Type || kind == Tok::Enum || kind == Tok::Impl
        || kind == Tok::Union
}

// `name:` before `loop`, `while` or `for`.
fn at_label() -> bool {
    let after = tok_kind(2);
    at(Tok::Ident) && tok_kind(1) == Tok::Colon
        && (after == Tok::Loop || after == Tok::While || after == Tok::For)
}

fn at_block_like() -> bool {
    let kind = cur();
    kind == Tok::LBrace || kind == Tok::If || kind == Tok::Loop || kind == Tok::While
        || kind == Tok::For || kind == Tok::Match || at_label()
}

fn expr_stmt(expr: i64, has_semi: i64, start: i64) -> i64 {
    let n = new_node(NodeKind::ExprStmt, start, prev_end());
    NODES[n].a = expr;
    NODES[n].b = has_semi;
    n
}

// A statement; an NodeKind::ExprStmt with b == 2 is the block's tail expression.
fn parse_stmt() -> i64 {
    let start = cur_start();
    if at(Tok::Let) {
        return parse_let();
    }
    if at_block_like() {
        // Ends at its closing brace; a `;` right after belongs to it.
        let expr = parse_primary();
        if at(Tok::RBrace) {
            return expr_stmt(expr, 2, start);
        }
        let has_semi = eat(Tok::Semi);
        return expr_stmt(expr, has_semi as i64, start);
    }
    let expr = parse_expr();
    if at(Tok::Semi) {
        advance();
        return expr_stmt(expr, 1, start);
    }
    if at(Tok::RBrace) {
        return expr_stmt(expr, 2, start);
    }
    syntax_error(c"expected ';' or '}' after expression")
}

fn parse_let() -> i64 {
    let start = cur_start();
    expect(Tok::Let);
    let n = new_node(NodeKind::Let, start, 0);
    NODES[n].a = parse_pattern();
    if eat(Tok::Colon) {
        NODES[n].b = parse_type();
    }
    if at(Tok::Semi) {
        error_at(cur_start(), c"'let' without an initializer is not supported; give the binding a value");
    }
    expect(Tok::Eq);
    NODES[n].c = parse_expr();
    expect(Tok::Semi);
    NODES[n].end = prev_end();
    n
}

// A pattern: alternatives separated by `|`.
fn parse_pattern() -> i64 {
    let start = cur_start();
    let first = parse_single_pattern();
    if !at(Tok::Pipe) {
        return first;
    }
    let n = new_node(NodeKind::PatOr, start, 0);
    let mark = list_begin();
    list_push(first);
    while eat(Tok::Pipe) {
        list_push(parse_single_pattern());
    }
    list_end(n, mark);
    NODES[n].end = prev_end();
    n
}

fn at_literal_pattern() -> bool {
    let kind = cur();
    kind == Tok::Int || kind == Tok::Char || kind == Tok::True || kind == Tok::False
        || (kind == Tok::Minus && (tok_kind(1) == Tok::Int || tok_kind(1) == Tok::Float)) || kind == Tok::Float
}

// A literal (or a constant's name) in a pattern: an expression node.
fn parse_pattern_literal() -> i64 {
    let start = cur_start();
    if at(Tok::Minus) {
        advance();
        let operand = parse_primary();
        return make_unary(Tok::Minus, operand, start);
    }
    if at(Tok::Ident) {
        let n = new_node(NodeKind::Ident, start, 0);
        NODES[n].a = expect_ident();
        NODES[n].end = prev_end();
        return n;
    }
    parse_primary()
}

// `lo ..= hi` after the low end has been parsed.
fn parse_range_pattern(start: i64, low: i64) -> i64 {
    if at(Tok::DotDot) {
        error_at(cur_start(), c"exclusive range patterns are not supported; use 'a..=b'");
    }
    expect(Tok::DotDotEq);
    let n = new_node(NodeKind::PatRange, start, 0);
    NODES[n].a = low;
    if !(at_literal_pattern() || at(Tok::Ident)) {
        syntax_error(c"expected the end of the range pattern");
    }
    NODES[n].b = parse_pattern_literal();
    NODES[n].end = prev_end();
    n
}

fn parse_single_pattern() -> i64 {
    let start = cur_start();
    if at(Tok::Ident) && TOKS[P].value as i64 == UNDERSCORE {
        advance();
        return new_node(NodeKind::PatWild, start, prev_end());
    }
    if at(Tok::Mut) {
        advance();
        let n = new_node(NodeKind::PatBind, start, 0);
        NODES[n].a = expect_binding_name();
        NODES[n].b = 1;
        NODES[n].end = prev_end();
        return n;
    }
    if at_literal_pattern() {
        let low = parse_pattern_literal();
        if at(Tok::DotDotEq) || at(Tok::DotDot) {
            return parse_range_pattern(start, low);
        }
        let n = new_node(NodeKind::PatLit, start, prev_end());
        NODES[n].a = low;
        return n;
    }
    if at(Tok::Ident) && tok_kind(1) == Tok::ColonColon {
        return parse_variant_pattern(start);
    }
    if at(Tok::Ident) && (tok_kind(1) == Tok::DotDotEq || tok_kind(1) == Tok::DotDot) {
        let low = parse_pattern_literal();
        return parse_range_pattern(start, low);
    }
    if at(Tok::Ident) {
        let n = new_node(NodeKind::PatBind, start, 0);
        NODES[n].a = expect_ident();
        NODES[n].end = prev_end();
        if at(Tok::LBrace) || at(Tok::LParen) {
            error_at(cur_start(), c"struct and tuple-struct patterns are not supported; enum variants are written 'Enum::Variant(...)'");
        }
        return n;
    }
    if at(Tok::LParen) {
        return parse_tuple_pattern(start);
    }
    if at(Tok::Reserved) {
        reserved_error();
    }
    syntax_error(c"expected a pattern")
}

// `E::V` or `E::V(p, ...)`
fn parse_variant_pattern(start: i64) -> i64 {
    let n = new_node(NodeKind::PatVariant, start, 0);
    NODES[n].a = expect_ident();
    expect(Tok::ColonColon);
    NODES[n].b = expect_ident();
    if eat(Tok::LParen) {
        NODES[n].c = 1;
        let mark = list_begin();
        while !at(Tok::RParen) && !at(Tok::Eof) {
            list_push(parse_pattern());
            if !eat(Tok::Comma) {
                break;
            }
        }
        list_end(n, mark);
        expect(Tok::RParen);
    }
    NODES[n].end = prev_end();
    n
}

fn parse_tuple_pattern(start: i64) -> i64 {
    expect(Tok::LParen);
    let n = new_node(NodeKind::PatTuple, start, 0);
    let mark = list_begin();
    let mut trailing_comma = false;
    while !at(Tok::RParen) && !at(Tok::Eof) {
        list_push(parse_pattern());
        trailing_comma = eat(Tok::Comma);
        if !trailing_comma {
            break;
        }
    }
    expect(Tok::RParen);
    if SCRATCH.count - mark == 1 && !trailing_comma {
        let only = SCRATCH.data[mark];
        SCRATCH.count = mark;
        return only;
    }
    list_end(n, mark);
    NODES[n].end = prev_end();
    n
}

// ---- Expressions ----

fn parse_expr() -> i64 {
    parse_expr_bp(0)
}

fn parse_expr_no_struct() -> i64 {
    let saved = with_no_struct(true);
    let e = parse_expr_bp(0);
    NO_STRUCT = saved;
    e
}

// Left and right binding powers of an infix operator token, 0 if none.
fn infix_left_bp(kind: Tok) -> i64 {
    match kind {
        Tok::Eq | Tok::PlusEq | Tok::MinusEq | Tok::StarEq | Tok::SlashEq | Tok::PercentEq
            | Tok::AmpEq | Tok::PipeEq | Tok::CaretEq | Tok::ShlEq | Tok::ShrEq => 2,
        Tok::DotDot | Tok::DotDotEq => 4,
        Tok::PipePipe => 6,
        Tok::AmpAmp => 8,
        Tok::EqEq | Tok::BangEq | Tok::Lt | Tok::Gt | Tok::LtEq | Tok::GtEq => 10,
        Tok::Pipe => 12,
        Tok::Caret => 14,
        Tok::Amp => 16,
        Tok::Shl | Tok::Shr => 18,
        Tok::Plus | Tok::Minus => 20,
        Tok::Star | Tok::Slash | Tok::Percent => 22,
        _ => 0,
    }
}

fn is_comparison(kind: Tok) -> bool {
    infix_left_bp(kind) == 10
}

fn is_assign_op(kind: Tok) -> bool {
    infix_left_bp(kind) == 2
}

fn is_reserved_punct(kind: Tok) -> bool {
    kind == Tok::Hash || kind == Tok::Question || kind == Tok::At
}

// Non-associative level of an operator: 1 comparison, 2 range, 0 none.
fn non_assoc_level(kind: Tok) -> i64 {
    if is_comparison(kind) { return 1; }
    if kind == Tok::DotDot || kind == Tok::DotDotEq { return 2; }
    0
}

fn parse_expr_bp(min_bp: i64) -> i64 {
    let lhs = parse_prefix();
    parse_infix(lhs, min_bp)
}

// Continues an expression whose first operand `first` is parsed.
fn parse_infix(first: i64, min_bp: i64) -> i64 {
    let mut lhs = first;
    let mut built_by = 0;
    loop {
        let kind = cur();
        if (kind == Tok::LParen || kind == Tok::LBracket || kind == Tok::Dot) && POSTFIX_BP >= min_bp {
            lhs = parse_postfix(lhs);
            built_by = 0;
            continue;
        }
        if kind == Tok::As && AS_BP >= min_bp {
            advance();
            let n = new_node(NodeKind::Cast, NODES[lhs].start, 0);
            NODES[n].a = lhs;
            NODES[n].b = parse_type();
            NODES[n].end = prev_end();
            lhs = n;
            built_by = 0;
            continue;
        }
        if is_reserved_punct(kind) {
            reserved_error();
        }
        let left_bp = infix_left_bp(kind);
        if left_bp == 0 || left_bp < min_bp {
            break;
        }
        let level = non_assoc_level(kind);
        if level != 0 && built_by == level {
            if level == 1 {
                error_at(cur_start(), c"comparison operators cannot be chained; use parentheses");
            }
            error_at(cur_start(), c"range operators cannot be chained; use parentheses");
        }
        advance();
        // Assignment is right-associative; everything else left.
        let right_bp = if left_bp == 2 { 1 } else { left_bp + 1 };
        let rhs = parse_expr_bp(right_bp);
        lhs = make_infix(kind, lhs, rhs);
        built_by = level;
    }
    lhs
}

fn make_infix(kind: Tok, lhs: i64, rhs: i64) -> i64 {
    let start = NODES[lhs].start;
    let end = NODES[rhs].end;
    if is_assign_op(kind) {
        let n = new_node(NodeKind::Assign, start, end);
        NODES[n].op = kind;
        NODES[n].b = lhs;
        NODES[n].c = rhs;
        return n;
    }
    if kind == Tok::DotDot || kind == Tok::DotDotEq {
        let n = new_node(NodeKind::Range, start, end);
        NODES[n].a = lhs;
        NODES[n].b = rhs;
        NODES[n].c = (kind == Tok::DotDotEq) as i64;
        return n;
    }
    let n = new_node(NodeKind::Binary, start, end);
    NODES[n].op = kind;
    NODES[n].b = lhs;
    NODES[n].c = rhs;
    n
}

fn starts_expr(kind: Tok) -> bool {
    kind == Tok::Int || kind == Tok::Float || kind == Tok::Char || kind == Tok::Str || kind == Tok::CStr
        || kind == Tok::Ident || kind == Tok::True || kind == Tok::False || kind == Tok::LParen
        || kind == Tok::LBracket || kind == Tok::LBrace || kind == Tok::Minus || kind == Tok::Bang
        || kind == Tok::Tilde || kind == Tok::Star || kind == Tok::Amp || kind == Tok::AmpAmp
        || kind == Tok::If || kind == Tok::Loop || kind == Tok::While || kind == Tok::For
        || kind == Tok::Return || kind == Tok::Break || kind == Tok::Continue || kind == Tok::Match
}

fn make_unary(op: Tok, operand: i64, start: i64) -> i64 {
    let n = new_node(NodeKind::Unary, start, NODES[operand].end);
    NODES[n].op = op;
    NODES[n].b = operand;
    n
}

fn parse_prefix() -> i64 {
    let kind = cur();
    let start = cur_start();
    if kind == Tok::Minus || kind == Tok::Bang || kind == Tok::Tilde || kind == Tok::Star || kind == Tok::Amp {
        advance();
        let operand = parse_expr_bp(PREFIX_BP);
        return make_unary(kind, operand, start);
    }
    if kind == Tok::AmpAmp {
        // `&&x` is `& &x`.
        advance();
        let operand = parse_expr_bp(PREFIX_BP);
        let inner = make_unary(Tok::Amp, operand, start + 1);
        return make_unary(Tok::Amp, inner, start);
    }
    if kind == Tok::Plus {
        error_at(start, c"unary '+' is not supported");
    }
    if kind == Tok::Return {
        advance();
        let n = new_node(NodeKind::Return, start, 0);
        NODES[n].a = parse_jump_value();
        NODES[n].end = prev_end();
        return n;
    }
    if kind == Tok::Break {
        advance();
        let n = new_node(NodeKind::Break, start, 0);
        NODES[n].a = parse_jump_label();
        NODES[n].b = parse_jump_value();
        NODES[n].end = prev_end();
        return n;
    }
    if kind == Tok::Continue {
        advance();
        let n = new_node(NodeKind::Continue, start, 0);
        NODES[n].a = parse_jump_label();
        NODES[n].end = prev_end();
        return n;
    }
    if kind == Tok::DotDot || kind == Tok::DotDotEq {
        error_at(start, c"a range needs a start: write 'a..b'");
    }
    parse_primary()
}

fn parse_jump_value() -> i64 {
    if starts_expr(cur()) { parse_expr_bp(0) } else { 0 }
}

fn parse_jump_label() -> i64 {
    if at(Tok::Colon) && tok_kind(1) == Tok::Ident {
        advance();
        return expect_ident();
    }
    0
}

fn parse_postfix(lhs: i64) -> i64 {
    let start = NODES[lhs].start;
    if eat(Tok::LParen) {
        let n = new_node(NodeKind::Call, start, 0);
        NODES[n].a = lhs;
        let saved = with_no_struct(false);
        parse_expr_list(n, Tok::RParen);
        NO_STRUCT = saved;
        expect(Tok::RParen);
        NODES[n].end = prev_end();
        return n;
    }
    if eat(Tok::LBracket) {
        let n = new_node(NodeKind::Index, start, 0);
        NODES[n].a = lhs;
        let saved = with_no_struct(false);
        NODES[n].b = parse_index();
        NO_STRUCT = saved;
        expect(Tok::RBracket);
        NODES[n].end = prev_end();
        return n;
    }
    expect(Tok::Dot);
    if at(Tok::Ident) {
        if tok_kind(1) == Tok::LParen {
            let n = new_node(NodeKind::MethodCall, start, 0);
            NODES[n].a = lhs;
            NODES[n].b = expect_ident();
            expect(Tok::LParen);
            let saved = with_no_struct(false);
            parse_expr_list(n, Tok::RParen);
            NO_STRUCT = saved;
            expect(Tok::RParen);
            NODES[n].end = prev_end();
            return n;
        }
        let n = new_node(NodeKind::FieldAccess, start, 0);
        NODES[n].a = lhs;
        NODES[n].b = expect_ident();
        NODES[n].end = prev_end();
        return n;
    }
    if at(Tok::Int) && TOKS[P].suffix == SUF_NONE {
        let n = new_node(NodeKind::TupleField, start, TOKS[P].end);
        NODES[n].a = lhs;
        NODES[n].b = TOKS[P].value as i64;
        advance();
        return n;
    }
    syntax_error(c"expected field name or index after '.'")
}

// The inside of `[...]`: an index, or a range with optional ends
// (`lo..hi`, `lo..`, `..hi`, `..`, `lo..=hi`, `..=hi`) for slicing.
fn parse_index() -> i64 {
    let start = cur_start();
    let mut low = 0;
    if !at(Tok::DotDot) && !at(Tok::DotDotEq) {
        // Stops before a range operator.
        low = parse_expr_bp(5);
        if !at(Tok::DotDot) && !at(Tok::DotDotEq) {
            return parse_infix(low, 0);
        }
    }
    let inclusive = at(Tok::DotDotEq);
    advance();
    let n = new_node(NodeKind::Range, start, 0);
    NODES[n].a = low;
    NODES[n].c = inclusive as i64;
    if !at(Tok::RBracket) {
        NODES[n].b = parse_expr_bp(5);
    } else if inclusive {
        syntax_error(c"an inclusive range needs an end");
    }
    NODES[n].end = prev_end();
    n
}

// `e, e, ...` up to `close` (not consumed), as the list of `n`.
fn parse_expr_list(n: i64, close: Tok) {
    let mark = list_begin();
    while !at(close) && !at(Tok::Eof) {
        list_push(parse_expr());
        if !eat(Tok::Comma) {
            break;
        }
    }
    list_end(n, mark);
}

fn literal_node(kind: NodeKind, start: i64, a: i64, b: i64) -> i64 {
    advance();
    let n = new_node(kind, start, prev_end());
    NODES[n].a = a;
    NODES[n].b = b;
    n
}

fn parse_primary() -> i64 {
    let kind = cur();
    let start = cur_start();
    let value = TOKS[P].value as i64;
    let suffix = TOKS[P].suffix;
    if kind == Tok::Int { return literal_node(NodeKind::Int, start, value, suffix); }
    if kind == Tok::Float { return literal_node(NodeKind::Float, start, value, suffix); }
    if kind == Tok::Char { return literal_node(NodeKind::Char, start, value, 0); }
    if kind == Tok::Str { return literal_node(NodeKind::Str, start, value, 0); }
    if kind == Tok::CStr { return literal_node(NodeKind::CStr, start, value, 0); }
    if kind == Tok::True { return literal_node(NodeKind::Bool, start, 1, 0); }
    if kind == Tok::False { return literal_node(NodeKind::Bool, start, 0, 0); }
    if kind == Tok::LParen {
        let saved = with_no_struct(false);
        let e = parse_paren_expr();
        NO_STRUCT = saved;
        return e;
    }
    if kind == Tok::LBracket {
        let saved = with_no_struct(false);
        let e = parse_array_literal();
        NO_STRUCT = saved;
        return e;
    }
    if kind == Tok::LBrace { return parse_block(); }
    if kind == Tok::If { return parse_if(); }
    if kind == Tok::Match { return parse_match(); }
    if kind == Tok::Loop || kind == Tok::While || kind == Tok::For {
        return parse_loop(0, start);
    }
    if kind == Tok::Ident && at_label() {
        let label = expect_ident();
        expect(Tok::Colon);
        return parse_loop(label, start);
    }
    if kind == Tok::Ident && value == UNDERSCORE {
        error_at(start, c"'_' can only be used in patterns");
    }
    if kind == Tok::Ident {
        return parse_name_or_struct_literal();
    }
    if is_reserved_punct(kind) || kind == Tok::Reserved {
        reserved_error();
    }
    syntax_error(c"expected expression")
}

fn parse_name_or_struct_literal() -> i64 {
    let start = cur_start();
    let name = expect_ident();
    if eat(Tok::ColonColon) {
        let n = new_node(NodeKind::Path, start, 0);
        NODES[n].a = name;
        NODES[n].b = expect_ident();
        if at(Tok::ColonColon) {
            error_at(cur_start(), c"paths have two parts: 'Type::member'");
        }
        NODES[n].end = prev_end();
        return n;
    }
    if !NO_STRUCT && at(Tok::LBrace) {
        advance();
        let n = new_node(NodeKind::StructLit, start, 0);
        NODES[n].a = name;
        let saved = with_no_struct(false);
        let mark = list_begin();
        while !at(Tok::RBrace) && !at(Tok::Eof) {
            let init_start = cur_start();
            let init = new_node(NodeKind::FieldInit, init_start, 0);
            NODES[init].a = expect_binding_name();
            expect(Tok::Colon);
            NODES[init].b = parse_expr();
            NODES[init].end = prev_end();
            list_push(init);
            if !eat(Tok::Comma) {
                break;
            }
        }
        list_end(n, mark);
        NO_STRUCT = saved;
        expect(Tok::RBrace);
        NODES[n].end = prev_end();
        return n;
    }
    let n = new_node(NodeKind::Ident, start, prev_end());
    NODES[n].a = name;
    n
}

// `()`, `(e)`, `(e,)` or `(e, e, ...)`
fn parse_paren_expr() -> i64 {
    let start = cur_start();
    expect(Tok::LParen);
    if eat(Tok::RParen) {
        return new_node(NodeKind::Unit, start, prev_end());
    }
    let first = parse_expr();
    if eat(Tok::Comma) {
        let n = new_node(NodeKind::Tuple, start, 0);
        let mark = list_begin();
        list_push(first);
        while !at(Tok::RParen) && !at(Tok::Eof) {
            list_push(parse_expr());
            if !eat(Tok::Comma) {
                break;
            }
        }
        list_end(n, mark);
        expect(Tok::RParen);
        NODES[n].end = prev_end();
        return n;
    }
    expect(Tok::RParen);
    NODES[first].start = start;
    NODES[first].end = prev_end();
    first
}

// `[]`, `[e; n]` or `[e, e, ...]`
fn parse_array_literal() -> i64 {
    let start = cur_start();
    expect(Tok::LBracket);
    if eat(Tok::RBracket) {
        return new_node(NodeKind::Array, start, prev_end());
    }
    let first = parse_expr();
    if eat(Tok::Semi) {
        let n = new_node(NodeKind::Repeat, start, 0);
        NODES[n].a = first;
        NODES[n].b = parse_expr();
        expect(Tok::RBracket);
        NODES[n].end = prev_end();
        return n;
    }
    let n = new_node(NodeKind::Array, start, 0);
    let mark = list_begin();
    list_push(first);
    if eat(Tok::Comma) {
        while !at(Tok::RBracket) && !at(Tok::Eof) {
            list_push(parse_expr());
            if !eat(Tok::Comma) {
                break;
            }
        }
    }
    list_end(n, mark);
    expect(Tok::RBracket);
    NODES[n].end = prev_end();
    n
}

fn parse_if() -> i64 {
    let start = cur_start();
    expect(Tok::If);
    let n = new_node(NodeKind::If, start, 0);
    NODES[n].a = parse_expr_no_struct();
    NODES[n].b = parse_block();
    if eat(Tok::Else) {
        if at(Tok::If) {
            // `else if`: an else block holding just the inner `if`.
            let inner = parse_if();
            let block = new_node(NodeKind::Block, NODES[inner].start, NODES[inner].end);
            NODES[block].a = inner;
            NODES[n].c = block;
        } else {
            NODES[n].c = parse_block();
        }
    }
    NODES[n].end = prev_end();
    n
}

// `match e { pattern [if guard] => body, ... }`
fn parse_match() -> i64 {
    let start = cur_start();
    expect(Tok::Match);
    let n = new_node(NodeKind::Match, start, 0);
    NODES[n].a = parse_expr_no_struct();
    expect(Tok::LBrace);
    let saved = with_no_struct(false);
    let mark = list_begin();
    while !at(Tok::RBrace) && !at(Tok::Eof) {
        let arm = new_node(NodeKind::Arm, cur_start(), 0);
        NODES[arm].a = parse_pattern();
        if eat(Tok::If) {
            NODES[arm].b = parse_expr();
        }
        expect(Tok::FatArrow);
        if at_block_like() {
            // Ends at its closing brace, like a statement.
            NODES[arm].c = parse_primary();
            eat(Tok::Comma);
        } else {
            NODES[arm].c = parse_expr();
            if !at(Tok::RBrace) {
                if !at(Tok::Comma) {
                    syntax_error(c"expected ',' or '}' after a match arm");
                }
                advance();
            }
        }
        NODES[arm].end = prev_end();
        list_push(arm);
    }
    list_end(n, mark);
    NO_STRUCT = saved;
    expect(Tok::RBrace);
    NODES[n].end = prev_end();
    n
}

fn parse_loop(label: i64, start: i64) -> i64 {
    if eat(Tok::Loop) {
        let n = new_node(NodeKind::Loop, start, 0);
        NODES[n].a = label;
        NODES[n].b = parse_block();
        NODES[n].end = prev_end();
        return n;
    }
    if eat(Tok::While) {
        let n = new_node(NodeKind::While, start, 0);
        NODES[n].a = label;
        NODES[n].b = parse_expr_no_struct();
        NODES[n].c = parse_block();
        NODES[n].end = prev_end();
        return n;
    }
    expect(Tok::For);
    let n = new_node(NodeKind::For, start, 0);
    NODES[n].a = label;
    NODES[n].b = parse_pattern();
    expect(Tok::In);
    NODES[n].c = parse_expr_no_struct();
    NODES[n].d = parse_block();
    NODES[n].end = prev_end();
    n
}
