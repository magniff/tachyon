use crate::fixunsafe::{FIX_UNSAFE, fix_unsafe};

static mut FRAME_SIZE: i64 = 0;
static mut RETURN_LABEL: i64 = 0;
// Frame slot holding the result pointer of a function returning a
// compound value.
static mut RESULT_SLOT: i64 = 0;
static mut CUR_FN: i64 = 0;
// The temporaries depth at the start of each loop, by its continue label.
static mut LABEL_DEPTH: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut MAIN_SYM: i64 = 0;
// --emit-ir: print the optimized IR instead of assembly.
pub static mut EMIT_IR: bool = false;
// --emit-mir: the IR after instruction selection (isel.tach).
pub static mut EMIT_MIR: bool = false;

// Slots aligned above 16 (offset, alignment, size triples): the frame
// pointer is only 16-aligned, so their address is rounded up at run time,
// inside room left for it (see emit_frame_addr).
pub static mut OVERALIGNED: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// A new frame slot; returns its offset below the frame pointer.
fn alloc_slot(size: i64, align: i64) -> i64 {
    let mut a = align;
    if a < 1 {
        a = 1;
    }
    if a > 16 {
        FRAME_SIZE = align_to(FRAME_SIZE + size + a - 16, 16);
        OVERALIGNED.push(FRAME_SIZE);
        OVERALIGNED.push(a);
        OVERALIGNED.push(size);
        return FRAME_SIZE;
    }
    FRAME_SIZE = align_to(FRAME_SIZE + size, a);
    FRAME_SIZE
}

// The slot aligned above 16 holding frame offset `offset` (the offset of
// a slot, or of a field inside one: `slot - field`), as its index in
// OVERALIGNED, or -1.
pub fn overaligned_slot(offset: i64) -> i64 {
    let mut i = 0;
    while i < OVERALIGNED.count {
        let slot = OVERALIGNED.data[i];
        if offset <= slot && offset > slot - OVERALIGNED.data[i + 2] {
            return i;
        }
        i += 3;
    }
    -1
}

// A frame slot for a value of type `ty`; compound values get a multiple
// of 8 bytes, so that they can be read and written in 8-byte pieces.
fn alloc_slot_for(ty: i64) -> i64 {
    let size = if is_compound(ty) { align_to(type_size(ty), 8) } else { type_size(ty) };
    alloc_slot(size, type_align(ty))
}

pub fn fn_symbol_prefix(f: i64) -> *u8 {
    if FNS[f].is_extern || FNS[f].export || FNS[f].name == MAIN_SYM { global_prefix() } else { function_prefix() }
}

// Whether function f has a global (C-visible) symbol.
pub fn fn_is_global(f: i64) -> bool {
    FNS[f].name == MAIN_SYM || FNS[f].export
}

// R_ACC (or `reg` with the machine layer) = the address of static `name`:
// through the GOT when C defines it.
fn emit_static_addr(name: i64) {
    let s = SYM_STATIC[name] - 1;
    let linkage = STATICS[s].linkage;
    if linkage == 1 {
        emit_extern_symbol_addr(name);
    } else {
        emit_local_symbol_addr(static_symbol_prefix(s), name);
    }
}

pub fn static_symbol_prefix(s: i64) -> *u8 {
    if STATICS[s].linkage != 0 { global_prefix() } else { static_prefix() }
}

// ---- The program ----

pub fn compile_program(output: *u8) {
    let mut t = timer_now();
    init_ast();
    ERR_KIND = c"parser error";
    let program = parse_program();
    if IMPORTED_START >= 0 {
        drop_shadowed_imports(program);
    }
    timer_add(T_PARSE, t);
    t = timer_now();
    MAIN_SYM = intern_c(c"main");
    init_types();
    init_declarations();
    ERR_KIND = c"type error";
    check_program(program);
    timer_add(T_CHECK, t);
    if FIX_IMPORTS {
        fix_imports();
        exit(0);
    }
    if FIX_UNSAFE {
        fix_unsafe();
        exit(0);
    }
    flush_warnings();
    if EMIT_HEADER {
        emit_c_header(program, output);
        return;
    }
    ASM = buf_new();
    DATA = buf_new();
    CODE = buf_new();
    if OPT_LEVEL > 0 || EMIT_IR {
        t = timer_now();
        lower_program(program);
        timer_add(T_LOWER, t);
        optimize_program();
        if EMIT_IR {
            for fi in 0..IRFUNC_COUNT {
                if FN_LIVE[fi] != 0 {
                    print_ir_func(ASM, fi);
                }
            }
            buf_write_file(ASM, output);
            return;
        }
        t = timer_now();
        select_instructions();
        timer_add(T_ISEL, t);
        if EMIT_MIR {
            for fi in 0..IRFUNC_COUNT {
                if FN_LIVE[fi] != 0 {
                    print_ir_func(ASM, fi);
                }
            }
            buf_write_file(ASM, output);
            return;
        }
        count_uses();
    }
    t = timer_now();
    emit_file_header();
    if OPT_LEVEL > 0 {
        for fi in 0..IRFUNC_COUNT {
            if FN_LIVE[fi] != 0 {
                gen_ir_function(fi);
            }
        }
        print_stats();
    } else {
        for i in 0..NODES[program].count {
            let item = child(program, i);
            if NODES[item].kind == Fn {
                gen_function(item);
            }
        }
    }
    timer_add(T_CODEGEN, t);
    t = timer_now();
    emit_runtime();
    gen_data();
    buf_bytes(ASM, buf_slice(DATA));
    emit_file_trailer();
    write_output(output);
    timer_add(T_OUTPUT, t);
    timer_report();
}

fn gen_data() {
    data_section(false);
    for id in 0..STR_COUNT {
        data_string(id);
    }
    let scratch = buf_new();
    for s in 0..STATIC_COUNT {
        let item = STATICS[s].node;
        let ty = STATICS[s].ty;
        if STATICS[s].linkage == 1 {
            // Defined in C.
            continue;
        }
        buf_clear(scratch);
        let init = NODES[item].c;
        if NODES[init].kind == CStr {
            // A C string (0.4): the address of its bytes. (In the
            // writable section: the address is relocated at load time.)
            data_section(true);
            data_align(8);
            if STATICS[s].linkage == 2 {
                buf_str(DATA, c".globl ");
                buf_str(DATA, global_prefix());
                buf_bytes(DATA, SYMS[NODES[item].a].text);
                buf_byte(DATA, '\n');
            }
            data_label(static_symbol_prefix(s), NODES[item].a);
            buf_str(DATA, c"    .quad ");
            buf_str(DATA, local_prefix());
            buf_str(DATA, c"str.");
            buf_int(DATA, NODES[init].a);
            buf_byte(DATA, '\n');
            continue;
        }
        const_emit(init, ty, scratch);
        data_section(STATICS[s].mutable);
        data_align(type_align(ty));
        if STATICS[s].linkage == 2 {
            buf_str(DATA, c".globl ");
            buf_str(DATA, global_prefix());
            buf_bytes(DATA, SYMS[NODES[item].a].text);
            buf_byte(DATA, '\n');
        }
        data_label(static_symbol_prefix(s), NODES[item].a);
        data_bytes(buf_slice(scratch));
        if BUFS[scratch].len == 0 {
            buf_str(DATA, c"    .space 1\n");
        }
    }
}

// ---- Functions ----

fn gen_function(item: i64) {
    let f = NODES[item].x - 1;
    CUR_FN = f;
    DEFERS.count = 0;
    DEFER_LOOPS.count = 0;
    buf_clear(CODE);
    DEPTH = 0;
    FRAME_SIZE = 0;
    OVERALIGNED.count = 0;
    RETURN_LABEL = new_label();
    emit_function_start(fn_symbol_prefix(f), FNS[f].name, fn_is_global(f));
    let ret = FNS[f].ret;
    RESULT_SLOT = 0;
    if returns_through_pointer(ret) {
        RESULT_SLOT = alloc_slot(8, 8);
        emit_frame_addr(R_ADDR, RESULT_SLOT);
        emit_store(TY_U64, R_RESULT, R_ADDR);
    }
    gen_params(item, f);
    let body = NODES[item].c;
    gen_block(body);
    if NODES[body].ty != TY_NEVER {
        gen_return_value(ret);
    }
    emit_label(RETURN_LABEL);
    if is_void(ret) && FNS[f].name == MAIN_SYM {
        // `main` without a result exits with 0.
        emit_load_imm(R_ACC, 0);
    }
    emit_epilogue();
    emit_frame_reserve(FRAME_SIZE);
    buf_bytes(ASM, buf_slice(CODE));
}

// Stores the incoming parameters in their frame slots, in order (so a
// register is saved before another parameter's move can reuse it).
// Aggregates in registers are stored piece by piece; those passed by
// reference or on the stack are copied once every register is saved.
fn gen_params(item: i64, f: i64) {
    let mut state: [i64; 3] = [first_int_arg(FNS[f].ret), 0, 0];
    let mut pending: [i64; 64] = [0; 64];
    let mut pending_count = 0;
    let mut pieces: [i64; 4] = [0; 4];
    for i in 0..FNS[f].param_count {
        let ty = fn_param(f, i);
        if is_void(ty) {
            continue;
        }
        let kind = abi_classify(ty);
        let local = NODES[child(item, i)].x;
        if kind == AbiClass::Pieces {
            abi_piece_locations(ty, &state as *i64, &pieces as *i64);
            if local < 0 {
                continue;
            }
            let slot = alloc_slot_for(ty);
            LOCALS[local].offset = slot;
            for k in 0..ABI_PIECE_COUNT {
                // On x86-64 a piece on the stack is copied as an integer of
                // its size: through the float accumulator it would
                // overwrite the first float argument register (xmm0),
                // which a later parameter may still be in. Not on AArch64,
                // whose int accumulator is x0, the first int argument
                // register (an HFA on the stack, after the float registers
                // ran out, may come before int parameters still in
                // registers); its float registers are all taken by earlier
                // parameters then.
                let mut piece_ty = ABI_PIECE_TY[k];
                if X86 && pieces[k] >= 16 && is_float(piece_ty) {
                    piece_ty = if piece_ty == TY_F32 { TY_U32 } else { TY_U64 };
                }
                emit_load_param(pieces[k], piece_ty);
                store_to_frame(piece_ty, slot - ABI_PIECE_OFFSET[k]);
            }
            continue;
        }
        let mut location = 0;
        if kind == AbiClass::Stack {
            location = abi_stack_location(ty, &state as *i64);
        } else {
            location = arg_location(if kind == AbiClass::Ref { TY_U64 } else { ty }, &state as *i64);
        }
        if local < 0 {
            continue;
        }
        let slot = alloc_slot_for(ty);
        LOCALS[local].offset = slot;
        if kind == AbiClass::Scalar {
            emit_load_param(location, ty);
            emit_frame_addr(R_ADDR, slot);
            emit_store(ty, R_ACC, R_ADDR);
            continue;
        }
        // The accumulator = the address of the caller's copy.
        if kind == AbiClass::Stack {
            m_lea(0, reg_fp(), location);
        } else {
            emit_load_param(location, TY_U64);
        }
        let pointer_slot = alloc_slot(8, 8);
        emit_frame_addr(R_ADDR, pointer_slot);
        emit_store(TY_U64, R_ACC, R_ADDR);
        pending[pending_count] = local;
        pending[pending_count + 1] = pointer_slot;
        pending_count += 2;
    }
    let mut i = 0;
    while i < pending_count {
        let local = pending[i];
        emit_frame_addr(R_ADDR, pending[i + 1]);
        emit_load_reg(R_ACC, R_ADDR);
        emit_frame_addr(R_SECOND, LOCALS[local].offset);
        emit_copy(type_size(LOCALS[local].ty));
        i += 2;
    }
}

// The accumulator holds the function's result: hand it to the caller (in
// registers, or copied through the result pointer, which x86-64 also
// returns in rax).
fn gen_return_value(ret: i64) {
    if !is_compound(ret) {
        return;
    }
    if returns_through_pointer(ret) {
        emit_frame_addr(R_ADDR, RESULT_SLOT);
        emit_load_reg(R_SECOND, R_ADDR);
        emit_copy(type_size(ret));
        if X86 {
            load_reg_from_frame(R_ACC, RESULT_SLOT);
        }
        return;
    }
    let size = type_size(ret);
    if size % 8 != 0 {
        // Read in whole pieces from a copy of a multiple of 8 bytes.
        let copy = alloc_slot_for(ret);
        emit_frame_addr(R_SECOND, copy);
        emit_copy(size);
        emit_frame_addr(R_ACC, copy);
    }
    abi_classify(ret);
    // The address moves out of the accumulator (a result register).
    let base = if X86 { 11 } else { 16 };
    m_mov(base, 0, TY_U64);
    for k in 0..ABI_PIECE_COUNT {
        m_load(ABI_PIECE_TY[k], return_piece_reg(k), base, ABI_PIECE_OFFSET[k]);
    }
}

// ---- Statements ----

fn gen_block(block: i64) {
    let mark = DEFERS.count;
    for i in 0..NODES[block].count {
        let stmt = child(block, i);
        if NODES[stmt].kind == Let {
            gen_expr(NODES[stmt].c);
            bind(NODES[stmt].a);
        } else if NODES[stmt].kind == Defer {
            DEFERS.push(stmt);
        } else {
            gen_expr(NODES[stmt].a);
        }
    }
    let tail = NODES[block].a;
    if tail != 0 {
        gen_expr(tail);
    }
    if DEFERS.count > mark {
        gen_defers(mark, if tail != 0 { NODES[tail].ty } else { TY_UNIT });
        DEFERS.count = mark;
    }
}

// Runs the deferred statements registered above DEFERS depth `depth`, last
// first (0.6), keeping the accumulator's value of type `ty` (a compound
// one is copied first, so a deferred statement cannot change it).
fn gen_defers(depth: i64, ty: i64) {
    if DEFERS.count <= depth {
        return;
    }
    let keep = !is_void(ty) && ty != TY_NEVER;
    let mut slot = 0;
    if keep {
        slot = alloc_slot_for(ty);
        store_to_frame(ty, slot);
    }
    let mut i = DEFERS.count - 1;
    while i >= depth {
        gen_expr(NODES[DEFERS.data[i]].a);
        i -= 1;
    }
    if keep {
        emit_frame_addr(R_ACC, slot);
        load_from_x0(ty);
    }
}

// Stores the accumulator (of type `ty`) in the frame slot at `offset`.
fn store_to_frame(ty: i64, offset: i64) {
    if is_void(ty) {
        return;
    }
    if is_compound(ty) {
        emit_frame_addr(R_SECOND, offset);
        emit_copy(type_size(ty));
        return;
    }
    emit_frame_addr(R_ADDR, offset);
    emit_store(ty, R_ACC, R_ADDR);
}

// Binds a pattern to the value in the accumulator (of the pattern's type).
fn bind(pattern: i64) {
    let kind = NODES[pattern].kind;
    let ty = NODES[pattern].ty;
    if kind == PatWild || ty == TY_NEVER {
        return;
    }
    if kind == PatBind {
        let local = NODES[pattern].x;
        let slot = alloc_slot_for(ty);
        LOCALS[local].offset = slot;
        store_to_frame(ty, slot);
        return;
    }
    if NODES[pattern].count == 0 {
        return;
    }
    // A tuple, or the only variant of an enum: the accumulator is its
    // address.
    push_x0();
    for i in 0..NODES[pattern].count {
        let mut elem_ty = 0;
        let mut offset = 0;
        if kind == PatVariant {
            elem_ty = variant_field(NODES[pattern].x, i);
            offset = variant_field_offset(NODES[pattern].x, i);
        } else {
            elem_ty = type_elem(ty, i);
            offset = tuple_offset(ty, i);
        }
        emit_peek(R_ACC);
        emit_add_imm(R_ACC, offset);
        if !is_compound(elem_ty) && !is_void(elem_ty) {
            emit_load(elem_ty, R_ACC);
        }
        bind(child(pattern, i));
    }
    pop_x(R_ACC);
}

// ---- Expressions ----

fn gen_expr(n: i64) {
    let ty = NODES[n].ty;
    match NODES[n].kind {
        Int | Char => emit_load_imm(R_ACC, wrap_int(NODES[n].a, ty) as u64),
        Float => emit_load_float(float_const(f64_of_bits(NODES[n].a), ty), ty),
        Bool => emit_load_imm(R_ACC, NODES[n].a as u64),
        Unit => {}
        Str => gen_string(n),
        CStr => emit_string_addr(NODES[n].a),
        Ident => gen_ident(n),
        Binary => gen_binary(n),
        Unary => gen_unary(n),
        Cast => {
            gen_expr(NODES[n].a);
            gen_cast(NODES[NODES[n].a].ty, ty);
        }
        Call => gen_call(n),
        Index if NODES[NODES[n].b].kind == Range => gen_slicing(n),
        Index | FieldAccess | TupleField => {
            gen_addr(n);
            load_from_x0(ty);
        }
        Tuple | Array | StructLit => gen_aggregate(n),
        Repeat => gen_repeat(n),
        NodeKind::Block => gen_block(n),
        If => gen_if(n),
        Match => gen_match(n),
        VariantLit => gen_variant(n),
        Loop | While => gen_loop(n),
        For => gen_for(n),
        Assign => gen_assign(n),
        EnumPanic => {
            gen_expr(NODES[n].a);
            emit_panic(NODES[n].x);
        }
        Return => {
            if NODES[n].a != 0 {
                gen_expr(NODES[n].a);
                gen_defers(0, NODES[NODES[n].a].ty);
                gen_return_value(FNS[CUR_FN].ret);
            } else {
                gen_defers(0, TY_UNIT);
            }
            emit_jump(RETURN_LABEL);
        }
        Break => {
            let mut ty = TY_UNIT;
            if NODES[n].b != 0 {
                gen_expr(NODES[n].b);
                ty = NODES[NODES[n].b].ty;
            }
            gen_defers(defer_loop_depth(NODES[n].x), ty);
            jump_out_to_loop(NODES[n].x, 1);
        }
        Continue => {
            gen_defers(defer_loop_depth(NODES[n].x), TY_UNIT);
            jump_out_to_loop(NODES[n].x, 0);
        }
        _ => type_error(n, c"internal error: unexpected node in code generation"),
    }
}

// The accumulator holds the address of a value of type `ty`: load it if it
// is a scalar.
fn load_from_x0(ty: i64) {
    if !is_compound(ty) && !is_void(ty) {
        emit_load(ty, R_ACC);
    }
}

// A string literal is a (pointer, length) tuple.
fn gen_string(n: i64) {
    let slot = alloc_slot(16, 8);
    emit_string_addr(NODES[n].a);
    emit_frame_addr(R_ADDR, slot);
    emit_store(TY_U64, R_ACC, R_ADDR);
    emit_load_imm(R_ACC, STRS[NODES[n].a].len as u64);
    emit_store_offset(R_ACC, R_ADDR, 8);
    emit_frame_addr(R_ACC, slot);
}

fn gen_ident(n: i64) {
    let ty = NODES[n].ty;
    let resolution = NODES[n].res;
    let index = NODES[n].y;
    if resolution == Res::Local {
        emit_frame_addr(R_ACC, LOCALS[index].offset);
        load_from_x0(ty);
    } else if resolution == Res::Const {
        let value = const_value(index);
        if is_float(ty) {
            emit_load_float(value, ty);
        } else {
            emit_load_imm(R_ACC, value as u64);
        }
    } else if resolution == Res::Static {
        emit_static_addr(NODES[n].a);
        load_from_x0(ty);
    } else {
        gen_fn_address(index);
    }
}

fn gen_fn_address(f: i64) {
    if FNS[f].is_extern {
        emit_extern_symbol_addr(FNS[f].name);
    } else {
        emit_local_symbol_addr(fn_symbol_prefix(f), FNS[f].name);
    }
}

// The accumulator = the address of a place (or of a compound value).
fn gen_addr(n: i64) {
    match NODES[n].kind {
        Ident if NODES[n].res == Res::Local => emit_frame_addr(R_ACC, LOCALS[NODES[n].y].offset),
        Ident if NODES[n].res == Res::Static => emit_static_addr(NODES[n].a),
        Unary if NODES[n].op == Tok::Star => gen_expr(NODES[n].b),
        FieldAccess => {
            // The struct's (or slice's) address, or the pointer to the struct.
            gen_expr(NODES[n].a);
            emit_add_imm(R_ACC, field_offset_of(n));
        }
        TupleField => {
            let base = NODES[n].a;
            gen_expr(base);
            emit_add_imm(R_ACC, tuple_offset(NODES[base].ty, NODES[n].b));
        }
        Index => gen_index_addr(n),
        _ => gen_expr(n),
    }
}

// The offset of the field of NodeKind::FieldAccess n in its base: a struct (also through
// a pointer), or a slice.
pub fn field_offset_of(n: i64) -> i64 {
    let base_ty = NODES[NODES[n].a].ty;
    if NODES[n].y == 2 {
        return NODES[n].x * 8;
    }
    if NODES[n].y == 1 {
        return field_offset(TYPES[TYPES[base_ty].a].a, NODES[n].x);
    }
    field_offset(TYPES[base_ty].a, NODES[n].x)
}

pub fn panic_kind(index_ty: i64, range: bool) -> i64 {
    let signed = is_signed(index_ty);
    if range {
        return if signed { PANIC_RANGE_SIGNED } else { PANIC_RANGE_UNSIGNED };
    }
    if signed { PANIC_INDEX_SIGNED } else { PANIC_INDEX_UNSIGNED }
}

fn gen_index_addr(n: i64) {
    let base = NODES[n].a;
    let base_ty = NODES[base].ty;
    let elem_size = type_size(TYPES[base_ty].a);
    gen_expr(base);
    push_x0();
    gen_expr(NODES[n].b);
    if is_slice(base_ty) {
        // Checked: the index against the slice's length.
        emit_peek(R_SECOND);
        emit_add_imm(R_SECOND, 8);
        emit_load_reg(R_SECOND, R_SECOND);
        let ok = new_label();
        emit_compare_jump(Cond::Lt, false, ok);
        emit_panic(panic_kind(NODES[NODES[n].b].ty, false));
        emit_label(ok);
        pop_x(R_SECOND);
        emit_load_reg(R_SECOND, R_SECOND);
        emit_index_addr(elem_size);
        return;
    }
    if TYPES[base_ty].kind == TyKind::Array {
        // Checked (0.7): the index against the array's length.
        emit_load_imm(R_SECOND, TYPES[base_ty].b as u64);
        let ok = new_label();
        emit_compare_jump(Cond::Lt, false, ok);
        emit_panic(panic_kind(NODES[NODES[n].b].ty, false));
        emit_label(ok);
    }
    pop_x(R_SECOND);
    emit_index_addr(elem_size);
}

// ---- Operators ----

fn gen_binary(n: i64) {
    let op = NODES[n].op;
    let lhs = NODES[n].b;
    let rhs = NODES[n].c;
    if op == Tok::AmpAmp || op == Tok::PipePipe {
        let end = new_label();
        gen_expr(lhs);
        if op == Tok::AmpAmp {
            emit_jump_if_zero(end);
        } else {
            emit_jump_if_nonzero(end);
        }
        gen_expr(rhs);
        emit_label(end);
        return;
    }
    let operand_ty = NODES[lhs].ty;
    gen_expr(lhs);
    push_value(operand_ty);
    gen_expr(rhs);
    pop_second_operand(operand_ty);
    gen_operator(op, operand_ty, NODES[n].ty);
}

// Moves the accumulator to the second operand and pops the first one into
// the accumulator.
fn pop_second_operand(ty: i64) {
    emit_move_to_second(ty);
    if is_float(ty) {
        pop_d(0);
    } else {
        pop_x(R_ACC);
    }
}

// Accumulator = accumulator <op> second operand.
fn gen_operator(op: Tok, operand_ty: i64, result_ty: i64) {
    if is_comparison(op) {
        emit_compare(cond_of_token(op), operand_ty);
    } else if is_float(operand_ty) {
        emit_float_binary(op, result_ty);
    } else {
        emit_int_binary(op, result_ty);
    }
}

fn gen_unary(n: i64) {
    let op = NODES[n].op;
    let operand = NODES[n].b;
    let ty = NODES[n].ty;
    if op == Tok::Amp {
        gen_addr(operand);
        return;
    }
    gen_expr(operand);
    if op == Tok::Minus {
        emit_negate(ty);
    } else if op == Tok::Bang {
        emit_not_bool();
    } else if op == Tok::Tilde {
        emit_bitnot(ty);
    } else {
        // Deref: the accumulator is the pointer.
        load_from_x0(ty);
    }
}

fn gen_cast(from: i64, to: i64) {
    if from == TY_NEVER || from == to {
        return;
    }
    if is_float(from) && is_float(to) {
        emit_float_to_float(from, to);
    } else if is_float(to) {
        emit_int_to_float(from, to);
    } else if is_float(from) {
        emit_float_to_int(from, to);
    } else if from != TY_BOOL {
        // Integers and pointers: the accumulator is canonical for `from`,
        // so this truncates or extends.
        emit_normalize(to);
    }
}

// ---- Aggregates ----

// A struct, tuple or array literal, built in a new frame slot.
fn gen_aggregate(n: i64) {
    let ty = NODES[n].ty;
    let kind = NODES[n].kind;
    let slot = alloc_slot_for(ty);
    for i in 0..NODES[n].count {
        let elem = child(n, i);
        let mut value = elem;
        let mut offset = 0;
        let mut elem_ty = 0;
        if kind == StructLit {
            let s = TYPES[ty].a;
            value = NODES[elem].b;
            offset = field_offset(s, NODES[elem].x);
            elem_ty = (*struct_field(s, NODES[elem].x)).ty;
        } else if kind == Tuple {
            offset = tuple_offset(ty, i);
            elem_ty = type_elem(ty, i);
        } else {
            elem_ty = TYPES[ty].a;
            offset = i * type_size(elem_ty);
        }
        gen_expr(value);
        store_to_frame(elem_ty, slot - offset);
    }
    emit_frame_addr(R_ACC, slot);
}

// `[value; count]`: the value is evaluated once.
fn gen_repeat(n: i64) {
    let ty = NODES[n].ty;
    let elem_ty = TYPES[ty].a;
    let count = TYPES[ty].b;
    let elem_size = type_size(elem_ty);
    let slot = alloc_slot_for(ty);
    gen_expr(NODES[n].a);
    if count > 0 && !is_void(elem_ty) && elem_size > 0 {
        let top = new_label();
        if is_compound(elem_ty) {
            // Copies from the value's address, keeping the cursor and the
            // count in frame slots (copies may call memcpy).
            let source = alloc_slot(8, 8);
            let cursor = alloc_slot(8, 8);
            let remaining = alloc_slot(8, 8);
            store_reg_to_frame(R_ACC, source);
            emit_frame_addr(R_ACC, slot);
            store_reg_to_frame(R_ACC, cursor);
            emit_load_imm(R_ACC, count as u64);
            store_reg_to_frame(R_ACC, remaining);
            emit_label(top);
            load_reg_from_frame(R_SECOND, cursor);
            load_reg_from_frame(R_ACC, source);
            emit_copy(elem_size);
            load_reg_from_frame(R_ACC, cursor);
            emit_add_imm(R_ACC, elem_size);
            emit_store(TY_U64, R_ACC, R_ADDR);
            load_reg_from_frame(R_ACC, remaining);
            emit_decrement(R_ACC);
            emit_store(TY_U64, R_ACC, R_ADDR);
            emit_jump_unless_zero_result(top);
        } else {
            emit_frame_addr(R_LOOP_PTR, slot);
            emit_load_imm(R_LOOP_COUNT, count as u64);
            emit_label(top);
            emit_store(elem_ty, R_ACC, R_LOOP_PTR);
            emit_add_imm(R_LOOP_PTR, elem_size);
            emit_decrement(R_LOOP_COUNT);
            emit_jump_unless_zero_result(top);
        }
    }
    emit_frame_addr(R_ACC, slot);
}

// The 8 bytes of frame slot `offset` = <reg> (R_ADDR keeps the address).
fn store_reg_to_frame(reg: i64, offset: i64) {
    emit_frame_addr(R_ADDR, offset);
    emit_store(TY_U64, reg, R_ADDR);
}

// <reg> = the 8 bytes of frame slot `offset` (R_ADDR keeps the address).
fn load_reg_from_frame(reg: i64, offset: i64) {
    emit_frame_addr(R_ADDR, offset);
    emit_load_reg(reg, R_ADDR);
}

// ---- Enums and slices ----

// `E::V(...)`: a fieldless enum's tag, or a new value in a frame slot.
fn gen_variant(n: i64) {
    let ty = NODES[n].ty;
    let v = NODES[n].a;
    let tag = ENUMS[TYPES[ty].a].tag;
    if !is_compound(ty) {
        emit_load_imm(R_ACC, wrap_int(VARIANTS[v].discr, tag) as u64);
        return;
    }
    let slot = alloc_slot_for(ty);
    for i in 0..NODES[n].count {
        gen_expr(child(n, i));
        store_to_frame(variant_field(v, i), slot - variant_field_offset(v, i));
    }
    emit_load_imm(R_ACC, wrap_int(VARIANTS[v].discr, tag) as u64);
    store_to_frame(tag, slot);
    emit_frame_addr(R_ACC, slot);
}

// `a[lo..hi]` (and the other ranges) of an array, a slice or a pointer: a
// new slice in a frame slot. Arrays and slices are checked: lo <= hi <=
// the length (lo <= hi + 1 and hi < the length for `..=`).
fn gen_slicing(n: i64) {
    let base = NODES[n].a;
    let base_ty = NODES[base].ty;
    let range = NODES[n].b;
    let low = NODES[range].a;
    let high = NODES[range].b;
    let inclusive = NODES[range].c != 0;
    let elem_size = type_size(TYPES[base_ty].a);
    // The result: the pointer at `slot`, the length at `slot - 8`.
    let slot = alloc_slot(16, 8);
    let length = alloc_slot(8, 8);
    let low_slot = alloc_slot(8, 8);
    let high_slot = alloc_slot(8, 8);
    gen_expr(base);
    if is_slice(base_ty) {
        emit_move_to_second(TY_U64);
        emit_load_reg(R_ACC, R_SECOND);
        store_reg_to_frame(R_ACC, slot);
        emit_add_imm(R_SECOND, 8);
        emit_load_reg(R_ACC, R_SECOND);
        store_reg_to_frame(R_ACC, length);
    } else {
        store_reg_to_frame(R_ACC, slot);
        if TYPES[base_ty].kind == TyKind::Array {
            emit_load_imm(R_ACC, TYPES[base_ty].b as u64);
            store_reg_to_frame(R_ACC, length);
        }
    }
    let mut bound_ty = TY_U64;
    if low != 0 {
        gen_expr(low);
        bound_ty = NODES[low].ty;
    } else {
        emit_load_imm(R_ACC, 0);
    }
    store_reg_to_frame(R_ACC, low_slot);
    if high != 0 {
        gen_expr(high);
        bound_ty = NODES[high].ty;
    } else {
        load_reg_from_frame(R_ACC, length);
    }
    store_reg_to_frame(R_ACC, high_slot);
    if TYPES[base_ty].kind != TyKind::Ptr {
        let ok = new_label();
        let fail = new_label();
        // hi <= length (hi < length for `..=`), then lo <= hi (+ 1).
        load_reg_from_frame(R_SECOND, length);
        load_reg_from_frame(R_ACC, high_slot);
        emit_compare_jump(if inclusive { Cond::Ge } else { Cond::Gt }, false, fail);
        if inclusive {
            emit_add_imm(R_ACC, 1);
        }
        emit_move_to_second(TY_U64);
        load_reg_from_frame(R_ACC, low_slot);
        emit_compare_jump(Cond::Le, false, ok);
        emit_label(fail);
        load_reg_from_frame(R_ACC, length);
        push_x0();
        load_reg_from_frame(R_SECOND, high_slot);
        if inclusive {
            emit_add_imm(R_SECOND, 1);
        }
        load_reg_from_frame(R_ACC, low_slot);
        pop_x(R_ADDR);
        emit_panic(panic_kind(bound_ty, true));
        emit_label(ok);
    }
    // ptr += lo * size; len = hi (+ 1) - lo.
    load_reg_from_frame(R_ACC, low_slot);
    load_reg_from_frame(R_SECOND, slot);
    emit_index_addr(elem_size);
    store_reg_to_frame(R_ACC, slot);
    load_reg_from_frame(R_ACC, low_slot);
    emit_move_to_second(TY_U64);
    load_reg_from_frame(R_ACC, high_slot);
    if inclusive {
        emit_add_imm(R_ACC, 1);
    }
    emit_int_binary(Tok::Minus, TY_U64);
    store_reg_to_frame(R_ACC, slot - 8);
    emit_frame_addr(R_ACC, slot);
}

// ---- match ----

// Sequential tests in arm order: the scrutinee is evaluated once (a
// compound one stays where it is: its address is kept), every arm's
// pattern is tested in order, its bindings copied, its guard evaluated.
fn gen_match(n: i64) {
    let scrutinee = NODES[n].a;
    let st = NODES[scrutinee].ty;
    gen_expr(scrutinee);
    if st == TY_NEVER {
        return;
    }
    let held = alloc_slot(8, 8);
    if is_compound(st) {
        store_reg_to_frame(R_ACC, held);
    } else {
        store_to_frame(st, held);
    }
    let end = new_label();
    for i in 0..NODES[n].count {
        let arm = child(n, i);
        let next = new_label();
        alloc_pattern_slots(NODES[arm].a);
        gen_pattern_test(NODES[arm].a, st, held, next);
        if NODES[arm].b != 0 {
            gen_expr(NODES[arm].b);
            emit_jump_if_zero(next);
        }
        gen_expr(NODES[arm].c);
        emit_jump(end);
        emit_label(next);
    }
    emit_label(end);
}

// Frame slots for the locals a pattern binds (once: the alternatives of an
// or-pattern bind the same locals).
fn alloc_pattern_slots(p: i64) {
    let kind = NODES[p].kind;
    if kind == PatBind {
        let local = NODES[p].x;
        if LOCALS[local].offset == 0 {
            LOCALS[local].offset = alloc_slot_for(LOCALS[local].ty);
        }
        return;
    }
    if kind == PatTuple || kind == PatVariant || kind == PatOr {
        for i in 0..NODES[p].count {
            alloc_pattern_slots(child(p, i));
        }
    }
}

// Jumps to `fail` unless the value of type `ty` in frame slot `held` (the
// address of a compound value) matches pattern p; binds its variables.
fn gen_pattern_test(p: i64, ty: i64, held: i64, fail: i64) {
    let kind = NODES[p].kind;
    if ty == TY_NEVER {
        return;
    }
    match kind {
        PatWild => return,
        PatBind => {
            if !is_void(ty) {
                load_held(ty, held);
                store_to_frame(ty, LOCALS[NODES[p].x].offset);
            }
            return;
        }
        PatLit => {
            load_held(ty, held);
            emit_load_imm(R_SECOND, NODES[p].x as u64);
            emit_compare_jump(Cond::Ne, is_signed(scalar_type(ty)), fail);
            return;
        }
        PatRange => {
            let signed = is_signed(scalar_type(ty));
            load_held(ty, held);
            emit_load_imm(R_SECOND, NODES[p].x as u64);
            emit_compare_jump(Cond::Lt, signed, fail);
            emit_load_imm(R_SECOND, NODES[p].y as u64);
            emit_compare_jump(Cond::Gt, signed, fail);
            return;
        }
        PatOr => {
            let ok = new_label();
            let last = NODES[p].count - 1;
            for i in 0..last {
                let next = new_label();
                gen_pattern_test(child(p, i), ty, held, next);
                emit_jump(ok);
                emit_label(next);
            }
            gen_pattern_test(child(p, last), ty, held, fail);
            emit_label(ok);
            return;
        }
        PatVariant => {
            let v = NODES[p].x;
            let tag = ENUMS[TYPES[ty].a].tag;
            if is_compound(ty) {
                load_reg_from_frame(R_ACC, held);
                emit_load(tag, R_ACC);
            } else {
                load_held(ty, held);
            }
            emit_load_imm(R_SECOND, wrap_int(VARIANTS[v].discr, tag) as u64);
            emit_compare_jump(Cond::Ne, is_signed(tag), fail);
        }
        _ => {}
    }
    // The elements of a tuple, the fields of a variant.
    for i in 0..NODES[p].count {
        let sub = child(p, i);
        if NODES[sub].kind == PatWild {
            continue;
        }
        let mut elem_ty = 0;
        let mut offset = 0;
        if kind == PatVariant {
            elem_ty = variant_field(NODES[p].x, i);
            offset = variant_field_offset(NODES[p].x, i);
        } else {
            elem_ty = type_elem(ty, i);
            offset = tuple_offset(ty, i);
        }
        let elem_held = alloc_slot(8, 8);
        load_reg_from_frame(R_ACC, held);
        emit_add_imm(R_ACC, offset);
        if is_compound(elem_ty) {
            store_reg_to_frame(R_ACC, elem_held);
        } else if !is_void(elem_ty) {
            emit_load(elem_ty, R_ACC);
            store_to_frame(elem_ty, elem_held);
        }
        gen_pattern_test(sub, elem_ty, elem_held, fail);
    }
}

// The accumulator = the value held in frame slot `held` (the address of a
// compound value).
fn load_held(ty: i64, held: i64) {
    if is_compound(ty) {
        load_reg_from_frame(R_ACC, held);
    } else {
        emit_frame_addr(R_ACC, held);
        load_from_x0(ty);
    }
}

// ---- Control flow ----

fn gen_if(n: i64) {
    let else_label = new_label();
    let end_label = new_label();
    gen_expr(NODES[n].a);
    emit_jump_if_zero(else_label);
    gen_block(NODES[n].b);
    if NODES[n].c != 0 {
        emit_jump(end_label);
        emit_label(else_label);
        gen_block(NODES[n].c);
        emit_label(end_label);
    } else {
        emit_label(else_label);
    }
}

fn new_loop_labels(n: i64, count: i64) -> i64 {
    let first = new_label();
    for _ in 1..count {
        new_label();
    }
    NODES[n].z = first;
    while LABEL_DEPTH.count <= first {
        LABEL_DEPTH.push(0);
    }
    LABEL_DEPTH.data[first] = DEPTH;
    first
}

// `loop` and `while`.
fn gen_loop(n: i64) {
    let top = new_loop_labels(n, 2);
    emit_label(top);
    if NODES[n].kind == While {
        gen_expr(NODES[n].b);
        emit_jump_if_zero(top + 1);
        defer_loop_enter(n);
        gen_block(NODES[n].c);
    } else {
        defer_loop_enter(n);
        gen_block(NODES[n].b);
    }
    defer_loop_leave();
    emit_jump(top);
    emit_label(top + 1);
}

// `for i in a..b`: the bounds are evaluated once; the loop variable is a
// copy of the counter.
fn gen_for(n: i64) {
    let range = NODES[n].c;
    let ty = NODES[range].ty;
    let inclusive = NODES[range].c != 0;
    let counter = alloc_slot(8, 8);
    let end = alloc_slot(8, 8);
    gen_expr(NODES[range].a);
    store_reg_to_frame(R_ACC, counter);
    gen_expr(NODES[range].b);
    store_reg_to_frame(R_ACC, end);
    let labels = new_loop_labels(n, 3);
    let next = labels;
    let exit = labels + 1;
    let test = labels + 2;
    emit_label(test);
    load_counter_and_end(counter, end);
    emit_compare_jump(if inclusive { Cond::Gt } else { Cond::Ge }, is_signed(ty), exit);
    bind(NODES[n].b);
    defer_loop_enter(n);
    gen_block(NODES[n].d);
    defer_loop_leave();
    emit_label(next);
    load_counter_and_end(counter, end);
    if inclusive {
        emit_compare_jump(Cond::Eq, is_signed(ty), exit);
    }
    emit_add_imm(R_ACC, 1);
    store_reg_to_frame(R_ACC, counter);
    emit_jump(test);
    emit_label(exit);
}

// The accumulator = the counter, the second operand = the end.
fn load_counter_and_end(counter: i64, end: i64) {
    load_reg_from_frame(R_SECOND, end);
    load_reg_from_frame(R_ACC, counter);
}

// `break` (to_end 1) or `continue` (to_end 0) out of loop `lp`.
fn jump_out_to_loop(lp: i64, to_end: i64) {
    let label = NODES[lp].z;
    emit_drop_temps(DEPTH - LABEL_DEPTH.data[label]);
    emit_jump(label + to_end);
}

// ---- Assignment ----

pub fn arith_op_of_assign(op: Tok) -> Tok {
    match op {
        Tok::PlusEq => Tok::Plus,
        Tok::MinusEq => Tok::Minus,
        Tok::StarEq => Tok::Star,
        Tok::SlashEq => Tok::Slash,
        Tok::PercentEq => Tok::Percent,
        Tok::AmpEq => Tok::Amp,
        Tok::PipeEq => Tok::Pipe,
        Tok::CaretEq => Tok::Caret,
        Tok::ShlEq => Tok::Shl,
        _ => Tok::Shr,
    }
}

// The right-hand side is evaluated first, then the target's address; a
// compound assignment then reads the old value.
fn gen_assign(n: i64) {
    let op = NODES[n].op;
    let target = NODES[n].b;
    let value = NODES[n].c;
    let ty = NODES[target].ty;
    gen_expr(value);
    if op == Tok::Eq {
        if is_void(ty) {
            gen_addr(target);
            return;
        }
        // The value (the source's address for compound values) waits on the
        // stack while the target's address is computed.
        push_value(ty);
        gen_addr(target);
        emit_move_to_second(TY_U64);
        if is_float(ty) {
            pop_d(0);
        } else {
            pop_x(R_ACC);
        }
        if is_compound(ty) {
            emit_copy(type_size(ty));
        } else {
            emit_store(ty, R_ACC, R_SECOND);
        }
        return;
    }
    let value_ty = NODES[value].ty;
    push_value(value_ty);
    gen_addr(target);
    push_x0();
    emit_peek(R_ADDR);
    emit_load(ty, R_ADDR);
    emit_peek_at(R_SECOND, 1, is_float(value_ty));
    gen_operator(arith_op_of_assign(op), ty, ty);
    pop_x(R_ADDR);
    emit_store(ty, R_ACC, R_ADDR);
    emit_drop_temps(1);
    DEPTH -= 1;
}

// ---- Calls ----

// Expressions whose compound value lives in a place another expression can
// change: passed by value, they are copied first.
fn is_place_kind(n: i64) -> bool {
    let kind = NODES[n].kind;
    kind == Ident || kind == FieldAccess || kind == TupleField || kind == Index
        || (kind == Unary && NODES[n].op == Tok::Star)
}

fn gen_call(n: i64) {
    let callee = NODES[n].a;
    let direct = NODES[n].x - 1;
    let mut param_count = 0;
    let mut ret = 0;
    let mut variadic = false;
    let mut callee_ty = 0;
    if direct >= 0 {
        param_count = FNS[direct].param_count;
        ret = FNS[direct].ret;
        variadic = FNS[direct].variadic;
    } else {
        callee_ty = NODES[callee].ty;
        param_count = TYPES[callee_ty].count;
        ret = TYPES[callee_ty].a;
    }
    let count = NODES[n].count;
    if count > 64 {
        type_error(n, c"too many arguments (at most 64 are supported)");
    }
    // The type of each passed argument (0 for unit arguments, not passed).
    let mut arg_types: [i64; 64] = [0; 64];
    let mut pushed = 0;
    for i in 0..count {
        let arg = child(n, i);
        let mut ty = NODES[arg].ty;
        if i < param_count {
            ty = if direct >= 0 { fn_param(direct, i) } else { type_elem(callee_ty, i) };
        }
        gen_expr(arg);
        if is_void(ty) {
            continue;
        }
        // A private copy, of a multiple of 8 bytes (read in pieces), unless
        // the value is a new temporary.
        if is_compound(ty) && !is_fresh(arg) {
            let copy = alloc_slot_for(ty);
            emit_frame_addr(R_SECOND, copy);
            emit_copy(type_size(ty));
            emit_frame_addr(R_ACC, copy);
        }
        push_value(ty);
        arg_types[i] = ty;
        pushed += 1;
    }
    if direct < 0 {
        gen_expr(callee);
        push_x0();
        pushed += 1;
    }
    gen_call_sequence(n, direct, &arg_types as *i64, count, param_count, variadic, pushed, ret);
}

// Where each argument goes (see arg_location): `locations[i]` for scalars,
// pointers to copies (AbiClass::Ref) and copies on the stack (AbiClass::Stack), the
// pieces' locations at `pieces[4 * i + k]` for aggregates in pieces;
// `kinds[i]` is the ABI kind. Returns the size of the outgoing stack area,
// and the number of float registers used in `float_regs`.
fn assign_arg_locations(arg_types: *i64, count: i64, param_count: i64, variadic: bool,
                        ret: i64, locations: *i64, pieces: *i64, kinds: *AbiClass,
                        float_regs: *i64) -> i64 {
    let mut state: [i64; 3] = [first_int_arg(ret), 0, 0];
    for i in 0..count {
        let ty = arg_types[i];
        if ty == 0 {
            continue;
        }
        let extra = variadic && i >= param_count;
        let kind = if extra { variadic_kind(ty) } else { abi_classify(ty) };
        kinds[i] = kind;
        if extra && kind == AbiClass::Pieces {
            abi_variadic_piece_locations(ty, &state as *i64, &pieces[4 * i]);
        } else if extra && kind != AbiClass::Stack {
            locations[i] = variadic_arg_location(if kind == AbiClass::Ref { TY_U64 } else { ty }, &state as *i64);
        } else if kind == AbiClass::Pieces {
            abi_piece_locations(ty, &state as *i64, &pieces[4 * i]);
        } else if kind == AbiClass::Stack {
            locations[i] = abi_stack_location(ty, &state as *i64);
        } else {
            locations[i] = arg_location(if kind == AbiClass::Ref { TY_U64 } else { ty }, &state as *i64);
        }
    }
    *float_regs = state[1];
    align_to(state[2], 16)
}

// Moves the pushed arguments into their registers and stack slots. The
// k-th pushed temporary is at sp + stack_size + 16 * (pushed - 1 - k); an
// aggregate's temporary holds its address (of a private copy).
fn place_args(arg_types: *i64, count: i64, param_count: i64, variadic: bool,
              locations: *i64, pieces: *i64, kinds: *AbiClass, stack_size: i64, pushed: i64) {
    let scratch = if X86 { 10 } else { 16 };
    let temp_int = if X86 { 11 } else { 17 };
    let temp_float = if X86 { 40 } else { 48 };
    let mut k = 0;
    for i in 0..count {
        let ty = arg_types[i];
        if ty == 0 {
            continue;
        }
        let from = stack_size + 16 * (pushed - 1 - k);
        k += 1;
        let kind = kinds[i];
        if kind == AbiClass::Pieces {
            abi_classify(ty);
            m_load(TY_U64, scratch, reg_sp(), from);
            for p in 0..ABI_PIECE_COUNT {
                let location = pieces[4 * i + p];
                let piece_ty = ABI_PIECE_TY[p];
                let offset = ABI_PIECE_OFFSET[p];
                if location < 16 {
                    m_load(piece_ty, arg_reg(xl_from_c(location)), scratch, offset);
                } else {
                    let temp = if is_float(piece_ty) { temp_float } else { temp_int };
                    m_load(piece_ty, temp, scratch, offset);
                    m_store(piece_ty, temp, reg_sp(), location - 16);
                }
            }
            continue;
        }
        let location = locations[i];
        if kind == AbiClass::Stack {
            // The aggregate's bytes, in 8-byte pieces (its copy is a
            // multiple of 8 bytes).
            m_load(TY_U64, scratch, reg_sp(), from);
            let mut offset = 0;
            while offset < type_size(ty) {
                m_load(TY_U64, temp_int, scratch, offset);
                m_store(TY_U64, temp_int, reg_sp(), location - 16 + offset);
                offset += 8;
            }
            continue;
        }
        let value_ty = if kind == AbiClass::Ref { TY_U64 } else { ty };
        let promote = variadic && i >= param_count;
        if location >= 16 {
            emit_stack_arg(value_ty, from, location - 16, promote);
        } else {
            emit_load_arg_reg(location, value_ty, from, promote);
        }
    }
}

// Moves the pushed arguments into place, calls, and pops them. A compound
// result is in a new frame slot (through the result pointer, or stored
// from the result registers).
fn gen_call_sequence(n: i64, direct: i64, arg_types: *i64, count: i64, param_count: i64,
                     variadic: bool, pushed: i64, ret: i64) {
    let mut locations: [i64; 64] = [0; 64];
    let mut pieces: [i64; 256] = [0; 256];
    let mut kinds: [AbiClass; 64] = [AbiClass::Scalar; 64];
    let mut float_regs = 0;
    let stack_size = assign_arg_locations(arg_types, count, param_count, variadic, ret,
                                          &locations as *i64, &pieces as *i64,
                                          &kinds as *AbiClass, &float_regs);
    // An aggregate aligned above 16 copied onto the stack (x86-64) must be
    // aligned there: the pushed arguments move down so that the stack area
    // is, and sp is restored from a frame slot after the call.
    let mut over = 0;
    for i in 0..count {
        if kinds[i] == AbiClass::Stack {
            let t = if arg_types[i] < 0 { 0 - arg_types[i] } else { arg_types[i] };
            over = max_i64(over, type_align(t));
        }
    }
    let mut saved_sp = 0;
    if over > 16 && X86 {
        saved_sp = alloc_slot(8, 8);
        x64_realign_pushed(pushed, stack_size, over, saved_sp);
    }
    if stack_size > 0 {
        emit_sp_sub(stack_size);
    }
    place_args(arg_types, count, param_count, variadic, &locations as *i64, &pieces as *i64,
               &kinds as *AbiClass, stack_size, pushed);
    if direct < 0 {
        emit_load_callee(stack_size);
    }
    let mut result_slot = 0;
    let through_pointer = returns_through_pointer(ret);
    if is_compound(ret) {
        result_slot = alloc_slot_for(ret);
    }
    if through_pointer {
        emit_frame_addr(R_RESULT, result_slot);
    }
    if direct >= 0 {
        emit_call(fn_symbol_prefix(direct), FNS[direct].name,
                  FNS[direct].is_extern || FNS[direct].export, variadic, float_regs);
    } else {
        emit_call_indirect();
    }
    if saved_sp != 0 {
        x64_restore_sp(saved_sp);
        DEPTH -= pushed;
    } else {
        emit_drop_temps_now(stack_size, pushed);
    }
    if is_compound(ret) {
        if !through_pointer {
            abi_classify(ret);
            emit_frame_addr(R_ADDR, result_slot);
            let base = if X86 { 11 } else { 9 };
            for k in 0..ABI_PIECE_COUNT {
                m_store(ABI_PIECE_TY[k], return_piece_reg(k), base, ABI_PIECE_OFFSET[k]);
            }
        }
        emit_frame_addr(R_ACC, result_slot);
    } else if is_integer(scalar_type(ret)) || ret == TY_BOOL {
        emit_normalize(if ret == TY_BOOL { TY_U8 } else { ret });
    }
}

fn emit_drop_temps_now(stack_size: i64, pushed: i64) {
    let total = stack_size + 16 * pushed;
    if total > 0 {
        emit_sp_add(total);
    }
    DEPTH -= pushed;
}
