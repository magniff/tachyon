use crate::cheader::emit_c_header;
use crate::ast::{
    DEFERS, DEFER_LOOPS, NODES, NodeKind, child, defer_loop_depth, defer_loop_enter,
    defer_loop_leave, init_ast,
};
use crate::parser::{is_comparison, parse_program};
use crate::types::{
    ENUMS, FNS, STATICS, STATIC_COUNT, SYM_STATIC, TYPES, TY_BOOL, TY_F32, TY_NEVER, TY_U32, TY_U64,
    TY_U8, TY_UNIT, TyKind, VARIANTS, align_to, field_offset, fn_param, init_declarations,
    init_types, is_compound, is_float, is_integer, is_signed, is_slice, is_void, max_i64,
    scalar_type, struct_field, tuple_offset, type_align, type_elem, type_size, variant_field,
    variant_field_offset,
