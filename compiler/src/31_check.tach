// Type checker: declarations, then every function body. Bidirectional,
// like the reference checker (seed/src/typechecker): `check` pushes an expected
// type into an expression (literals, aggregates, branches, arithmetic
// operands take it), `synth` computes a type from the expression alone.
// Every expression node gets its type in `ty`: the expected type in check
// mode, the computed one in synth mode. The first error ends the
// compilation.
//
// Resolutions recorded on nodes:
//   E_IDENT  x = R_LOCAL / R_CONST / R_STATIC / R_FN, y = its index
//   E_CALL   x = function + 1 for a direct call, 0 for a call through a value
//   E_FIELD  x = field index
//   E_BREAK, E_CONTINUE  x = the loop node
//   E_LOOP   x = 1 if it has a break, y = the type of its break values
//   P_BIND, PARAM  x = the local

const R_LOCAL: i64 = 1;
const R_CONST: i64 = 2;
const R_STATIC: i64 = 3;
const R_FN: i64 = 4;

struct Local { name: i64, ty: i64, mutable: bool, is_param: bool, offset: i64 }

static mut LOCALS: *Local = 0 as *Local;
static mut LOCAL_COUNT: i64 = 0;
static mut LOCAL_CAP: i64 = 0;
// Locals in scope (innermost last), and where each scope starts in it.
static mut ENV: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut SCOPES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut LOOP_STACK: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut RETURN_TYPE: i64 = 0;
// In constant expressions no locals are visible.
static mut CONST_CONTEXT: bool = false;
static mut PROGRAM: i64 = 0;
// The type `Self` names (in an impl block), or 0; the symbols `Self` and
// `self`.
static mut SELF_TYPE: i64 = 0;
static mut SELF_TYPE_SYM: i64 = 0;
static mut SELF_SYM: i64 = 0;

// ---- Errors ----

fn type_error(n: i64, message: *u8) -> ! {
    error_at(NODES[n].start, message)
}

fn mismatch_error(n: i64, expected: i64, actual: i64) -> ! {
    err_begin(NODES[n].start);
    err_str(c"expected '");
    err_type(expected);
    err_str(c"', got '");
    err_type(actual);
    err_str(c"'");
    err_end()
}

// `message` followed by `, got '<type>'`.
fn type_error_got(n: i64, message: *u8, t: i64) -> ! {
    err_begin(NODES[n].start);
    err_str(message);
    err_str(c", got '");
    err_type(t);
    err_str(c"'");
    err_end()
}

fn name_error(pos: i64, before: *u8, name: i64, after: *u8) -> ! {
    err_begin(pos);
    err_str(before);
    err_sym(name);
    err_str(after);
    err_end()
}

// ---- Scopes ----

fn push_scope() {
    intvec_push(&SCOPES, ENV.count);
}

fn pop_scope() {
    ENV.count = intvec_pop(&SCOPES);
}

fn define_local(name: i64, ty: i64, mutable: bool, is_param: bool) -> i64 {
    LOCALS = grow(LOCALS as *u8, LOCAL_COUNT, &LOCAL_CAP, 40) as *Local;
    let id = LOCAL_COUNT;
    LOCALS[id] = Local { name: name, ty: ty, mutable: mutable, is_param: is_param, offset: 0 };
    LOCAL_COUNT += 1;
    intvec_push(&ENV, id);
    id
}

// The innermost local named `name`, or -1.
fn lookup_local(name: i64) -> i64 {
    if CONST_CONTEXT {
        return -1;
    }
    let mut i = ENV.count - 1;
    while i >= 0 {
        let id = ENV.data[i];
        if LOCALS[id].name == name {
            return id;
        }
        i -= 1;
    }
    -1
}

// ---- Declarations ----

fn check_program(program: i64) {
    PROGRAM = program;
    SELF_TYPE_SYM = intern_c(c"Self");
    SELF_SYM = intern_c(c"self");
    collect_names();
    collect_const_types();
    collect_structs();
    collect_enums();
    collect_aliases();
    check_struct_cycles();
    collect_methods();
    collect_functions();
    collect_statics();
    evaluate_consts();
    for i in 0..NODES[program].count {
        let item = child(program, i);
        if NODES[item].kind == I_FN {
            check_function(item);
        }
    }
}

fn duplicate_error(item: i64, kind: *u8) -> ! {
    err_begin(NODES[item].start);
    err_str(c"duplicate ");
    err_str(kind);
    err_str(c" '");
    err_sym(NODES[item].a);
    err_str(c"'");
    err_end()
}

fn collect_names() {
    for i in 0..NODES[PROGRAM].count {
        let item = child(PROGRAM, i);
        let kind = NODES[item].kind;
        let name = NODES[item].a;
        if kind == I_STRUCT || kind == I_TYPE || kind == I_ENUM {
            if SYM_STRUCT[name] != 0 || SYM_ENUM[name] != 0 || SYM_ALIAS[name] != 0
                || SYM_PRIMITIVE[name] != 0 || name == SELF_TYPE_SYM {
                duplicate_error(item, if kind == I_STRUCT { c"struct" } else if kind == I_ENUM { c"enum" } else { c"type" });
            }
            if kind == I_STRUCT {
                add_struct(item);
            } else if kind == I_ENUM {
                add_enum(item);
            } else {
                SYM_ALIAS[name] = item;
            }
            continue;
        }
        if kind == I_FN && NODES[item].d != 0 {
            // A method or associated function: named `Type.name`, found
            // through METHODS (see collect_methods).
            add_fn(item, method_symbol(NODES[item].d, name));
            continue;
        }
        if SYM_FN[name] != 0 || SYM_CONST[name] != 0 || SYM_STATIC[name] != 0 {
            if kind == I_CONST {
                duplicate_error(item, c"constant");
            }
            if kind == I_STATIC {
                duplicate_error(item, c"static");
            }
            duplicate_error(item, c"function");
        }
        if kind == I_FN || kind == I_EXTERN {
            add_fn(item, name);
            SYM_FN[name] = FN_COUNT;
        } else if kind == I_CONST {
            CONSTS = grow(CONSTS as *u8, CONST_COUNT, &CONST_CAP, 32) as *ConstInfo;
            CONSTS[CONST_COUNT] = ConstInfo { node: item, ty: 0, value: 0, state: 0 };
            CONST_COUNT += 1;
            SYM_CONST[name] = CONST_COUNT;
        } else if kind == I_STATIC {
            STATICS = grow(STATICS as *u8, STATIC_COUNT, &STATIC_CAP, 32) as *StaticInfo;
            STATICS[STATIC_COUNT] = StaticInfo {
                node: item, ty: 0, mutable: NODES[item].d != 0, linkage: NODES[item].y,
            };
            STATIC_COUNT += 1;
            SYM_STATIC[name] = STATIC_COUNT;
        }
    }
}

fn add_fn(item: i64, name: i64) {
    FNS = grow(FNS as *u8, FN_COUNT, &FN_CAP, 64) as *FnInfo;
    let kind = NODES[item].kind;
    FNS[FN_COUNT] = FnInfo {
        name: name, node: item, params: 0, param_count: 0, ret: TY_UNIT,
        variadic: kind == I_EXTERN && NODES[item].d != 0, is_extern: kind == I_EXTERN,
        self_ty: 0, export: kind == I_FN && NODES[item].y != 0,
    };
    FN_COUNT += 1;
    NODES[item].x = FN_COUNT;
}

// The symbol `Type.name` of a method.
fn method_symbol(type_name: i64, name: i64) -> i64 {
    let out = buf_new();
    buf_bytes(out, SYMS[type_name].ptr, SYMS[type_name].len);
    buf_byte(out, '.');
    buf_bytes(out, SYMS[name].ptr, SYMS[name].len);
    intern(BUFS[out].data, BUFS[out].len)
}

fn add_enum(item: i64) {
    ENUMS = grow(ENUMS as *u8, ENUM_COUNT, &ENUM_CAP, 72) as *EnumInfo;
    ENUMS[ENUM_COUNT] = EnumInfo {
        name: NODES[item].a, node: item, variants: 0, variant_count: 0, tag: TY_U8,
        has_fields: false, layout_state: 0, repr: NODES[item].c, payload: 0,
    };
    ENUM_COUNT += 1;
    SYM_ENUM[NODES[item].a] = ENUM_COUNT;
}

fn add_struct(item: i64) {
    STRUCTS = grow(STRUCTS as *u8, STRUCT_COUNT, &STRUCT_CAP, 56) as *StructInfo;
    STRUCTS[STRUCT_COUNT] = StructInfo {
        name: NODES[item].a, node: item, fields: 0, field_count: 0, layout_state: 0,
        repr: NODES[item].c, align: NODES[item].d,
    };
    STRUCT_COUNT += 1;
    SYM_STRUCT[NODES[item].a] = STRUCT_COUNT;
}

fn collect_const_types() {
    for c in 0..CONST_COUNT {
        let item = CONSTS[c].node;
        let ty = resolve_type(NODES[item].b);
        if !(is_numeric(ty) || ty == TY_BOOL) {
            err_begin(NODES[NODES[item].b].start);
            err_str(c"constant '");
            err_sym(NODES[item].a);
            err_str(c"' has type '");
            err_type(ty);
            err_str(c"'; constants must be integers, floats or bool");
            err_end();
        }
        CONSTS[c].ty = ty;
    }
}

fn collect_structs() {
    for s in 0..STRUCT_COUNT {
        let item = STRUCTS[s].node;
        STRUCTS[s].fields = FIELD_COUNT;
        for i in 0..NODES[item].count {
            let field = child(item, i);
            for j in 0..i {
                if NODES[child(item, j)].a == NODES[field].a {
                    err_begin(NODES[field].start);
                    err_str(c"duplicate field '");
                    err_sym(NODES[field].a);
                    err_str(c"' in struct '");
                    err_sym(NODES[item].a);
                    err_str(c"'");
                    err_end();
                }
            }
            let ty = resolve_type(NODES[field].b);
            FIELDS = grow(FIELDS as *u8, FIELD_COUNT, &FIELD_CAP, 24) as *FieldInfo;
            FIELDS[FIELD_COUNT] = FieldInfo { name: NODES[field].a, ty: ty, offset: 0 };
            FIELD_COUNT += 1;
        }
        STRUCTS[s].field_count = NODES[item].count;
    }
}

fn collect_enums() {
    for e in 0..ENUM_COUNT {
        let item = ENUMS[e].node;
        ENUMS[e].variants = VARIANT_COUNT;
        ENUMS[e].variant_count = NODES[item].count;
        let mut has_fields = false;
        for i in 0..NODES[item].count {
            if NODES[child(item, i)].c != 0 {
                has_fields = true;
            }
        }
        ENUMS[e].has_fields = has_fields;
        let mut next = 0;
        let mut low = 0;
        let mut high = 0;
        for i in 0..NODES[item].count {
            let node = child(item, i);
            for j in 0..i {
                if NODES[child(item, j)].a == NODES[node].a {
                    err_begin(NODES[node].start);
                    err_str(c"duplicate variant '");
                    err_sym(NODES[node].a);
                    err_str(c"' in enum '");
                    err_sym(NODES[item].a);
                    err_str(c"'");
                    err_end();
                }
            }
            if NODES[node].c != 0 && NODES[node].count == 0 {
                type_error(node, c"a tuple variant needs at least one field; write the variant without '()'");
            }
            let fields = TLISTS.count;
            let mark = TSCRATCH.count;
            for k in 0..NODES[node].count {
                let ty = resolve_type(child(node, k));
                intvec_push(&TSCRATCH, ty);
            }
            for k in mark..TSCRATCH.count {
                intvec_push(&TLISTS, TSCRATCH.data[k]);
            }
            TSCRATCH.count = mark;
            let mut discr = next;
            if NODES[node].b != 0 {
                if has_fields {
                    type_error(NODES[node].b, c"explicit discriminants are only allowed in enums without fields");
                }
                discr = eval_discriminant(NODES[node].b);
            }
            for j in 0..i {
                if VARIANTS[enum_variant(e, j)].discr == discr {
                    err_begin(NODES[node].start);
                    err_str(c"discriminant ");
                    err_int(discr);
                    err_str(c" of variant '");
                    err_sym(NODES[node].a);
                    err_str(c"' is already used by '");
                    err_sym(VARIANTS[enum_variant(e, j)].name);
                    err_str(c"'");
                    err_end();
                }
            }
            if i == 0 || discr < low {
                low = discr;
            }
            if i == 0 || discr > high {
                high = discr;
            }
            next = discr + 1;
            VARIANTS = grow(VARIANTS as *u8, VARIANT_COUNT, &VARIANT_CAP, 56) as *VariantInfo;
            VARIANTS[VARIANT_COUNT] = VariantInfo {
                name: NODES[node].a, node: node, enum_id: e, discr: discr, fields: fields,
                field_count: NODES[node].count, shape: 0,
            };
            VARIANT_COUNT += 1;
        }
        ENUMS[e].tag = enum_tag_type(e, item, low, high);
        let repr_c = (ENUMS[e].repr & REPR_C) != 0;
        if has_fields {
            for i in 0..ENUMS[e].variant_count {
                let v = enum_variant(e, i);
                let mark = TSCRATCH.count;
                if !repr_c {
                    intvec_push(&TSCRATCH, ENUMS[e].tag);
                }
                for k in 0..VARIANTS[v].field_count {
                    intvec_push(&TSCRATCH, variant_field(v, k));
                }
                VARIANTS[v].shape = make_type(TY_TUPLE, 0, 0, mark);
            }
        }
    }
}

// The type of the tag of enum e: from #[repr(u8)] and the like, a C int
// for #[repr(C)], else the smallest that holds every discriminant.
fn enum_tag_type(e: i64, item: i64, low: i64, high: i64) -> i64 {
    let mut tag = 0;
    if (ENUMS[e].repr & REPR_INT) != 0 {
        tag = SYM_PRIMITIVE[NODES[item].d];
    } else if (ENUMS[e].repr & REPR_C) != 0 {
        tag = TY_I32;
    } else {
        return tag_type_for(low, high);
    }
    if ENUMS[e].variant_count > 0 && (wrap_int(low, tag) != low || wrap_int(high, tag) != high) {
        err_begin(NODES[item].start);
        err_str(c"the discriminants of enum '");
        err_sym(NODES[item].a);
        err_str(c"' do not fit its tag type '");
        err_type(tag);
        err_str(c"'");
        err_end();
    }
    tag
}

// The smallest integer type holding every discriminant in low..=high.
fn tag_type_for(low: i64, high: i64) -> i64 {
    if low >= 0 {
        if high <= 255 { return TY_U8; }
        if high <= 65535 { return TY_U16; }
        if high <= 4294967295 { return TY_U32; }
        return TY_I64;
    }
    if low >= -128 && high <= 127 { return TY_I8; }
    if low >= -32768 && high <= 32767 { return TY_I16; }
    if low >= -2147483648 && high <= 2147483647 { return TY_I32; }
    TY_I64
}

fn eval_discriminant(n: i64) -> i64 {
    let saved_context = CONST_CONTEXT;
    CONST_CONTEXT = true;
    let ty = synth_expr(n);
    if !is_integer(ty) {
        type_error_got(n, c"an enum discriminant must be an integer", ty);
    }
    let value = const_eval(n);
    CONST_CONTEXT = saved_context;
    if ty == TY_U64 && value < 0 {
        type_error(n, c"an enum discriminant must fit in i64");
    }
    value
}

// The methods and associated functions of impl blocks.
fn collect_methods() {
    for f in 0..FN_COUNT {
        let item = FNS[f].node;
        let type_name = NODES[item].d;
        if FNS[f].is_extern || type_name == 0 {
            continue;
        }
        let mut t = 0;
        if SYM_STRUCT[type_name] != 0 {
            t = struct_type(SYM_STRUCT[type_name] - 1);
        } else if SYM_ENUM[type_name] != 0 {
            t = enum_type(SYM_ENUM[type_name] - 1);
        } else if SYM_ALIAS[type_name] != 0 || SYM_PRIMITIVE[type_name] != 0 {
            name_error(NODES[item].start, c"impl blocks are only allowed for structs and enums, not '", type_name, c"'");
        } else {
            name_error(NODES[item].start, c"impl for unknown type '", type_name, c"'");
        }
        if find_method(t, NODES[item].a) >= 0 {
            err_begin(NODES[item].start);
            err_str(c"duplicate method '");
            err_sym(NODES[item].a);
            err_str(c"' for type '");
            err_type(t);
            err_str(c"'");
            err_end();
        }
        if t != 0 && TYPES[t].kind == TY_ENUM && find_variant(TYPES[t].a, NODES[item].a) >= 0 {
            err_begin(NODES[item].start);
            err_str(c"'");
            err_sym(NODES[item].a);
            err_str(c"' is both a variant and an associated function of '");
            err_type(t);
            err_str(c"'");
            err_end();
        }
        FNS[f].self_ty = t;
        METHODS = grow(METHODS as *u8, METHOD_COUNT, &METHOD_CAP, 24) as *MethodInfo;
        METHODS[METHOD_COUNT] = MethodInfo { ty: t, name: NODES[item].a, f: f };
        METHOD_COUNT += 1;
    }
}

fn collect_aliases() {
    for i in 0..NODES[PROGRAM].count {
        let item = child(PROGRAM, i);
        if NODES[item].kind == I_TYPE {
            resolve_named(NODES[item].a, NODES[item].start);
        }
    }
}

fn reset_layout_states() {
    for t in 0..STRUCT_COUNT {
        STRUCTS[t].layout_state = 0;
    }
    for t in 0..ENUM_COUNT {
        ENUMS[t].layout_state = 0;
    }
}

fn check_struct_cycles() {
    for s in 0..STRUCT_COUNT {
        reset_layout_states();
        if struct_has_cycle(s) {
            err_begin(NODES[STRUCTS[s].node].start);
            err_str(c"struct '");
            err_sym(STRUCTS[s].name);
            err_str(c"' has infinite size due to recursive field (use a pointer to break the cycle)");
            err_end();
        }
    }
    for e in 0..ENUM_COUNT {
        reset_layout_states();
        if enum_has_cycle(e) {
            err_begin(NODES[ENUMS[e].node].start);
            err_str(c"enum '");
            err_sym(ENUMS[e].name);
            err_str(c"' has infinite size due to a recursive field (use a pointer to break the cycle)");
            err_end();
        }
    }
}

fn enum_has_cycle(e: i64) -> bool {
    if ENUMS[e].layout_state == 1 {
        return true;
    }
    ENUMS[e].layout_state = 1;
    for i in 0..ENUMS[e].variant_count {
        let v = enum_variant(e, i);
        for k in 0..VARIANTS[v].field_count {
            if embeds_cycle(variant_field(v, k)) {
                return true;
            }
        }
    }
    ENUMS[e].layout_state = 0;
    false
}

// layout_state: 1 while visiting.
fn struct_has_cycle(s: i64) -> bool {
    if STRUCTS[s].layout_state == 1 {
        return true;
    }
    STRUCTS[s].layout_state = 1;
    for i in 0..STRUCTS[s].field_count {
        if embeds_cycle((*struct_field(s, i)).ty) {
            return true;
        }
    }
    STRUCTS[s].layout_state = 0;
    false
}

fn embeds_cycle(t: i64) -> bool {
    let kind = TYPES[t].kind;
    if kind == TY_STRUCT {
        return struct_has_cycle(TYPES[t].a);
    }
    if kind == TY_ENUM {
        return enum_has_cycle(TYPES[t].a);
    }
    if kind == TY_ARRAY {
        return embeds_cycle(TYPES[t].a);
    }
    if kind == TY_TUPLE {
        for i in 0..TYPES[t].count {
            if embeds_cycle(type_elem(t, i)) {
                return true;
            }
        }
    }
    false
}

fn collect_functions() {
    for f in 0..FN_COUNT {
        let item = FNS[f].node;
        SELF_TYPE = FNS[f].self_ty;
        let mark = TSCRATCH.count;
        for i in 0..NODES[item].count {
            let param = child(item, i);
            let name = NODES[param].a;
            if name != UNDERSCORE {
                for j in 0..i {
                    if NODES[child(item, j)].a == name {
                        name_error(NODES[param].start, c"duplicate parameter '", name, c"'");
                    }
                }
            }
            intvec_push(&TSCRATCH, resolve_type(NODES[param].b));
        }
        FNS[f].params = TLISTS.count;
        FNS[f].param_count = TSCRATCH.count - mark;
        for i in mark..TSCRATCH.count {
            intvec_push(&TLISTS, TSCRATCH.data[i]);
        }
        TSCRATCH.count = mark;
        FNS[f].ret = if NODES[item].b == 0 { TY_UNIT } else { resolve_type(NODES[item].b) };
        if FNS[f].is_extern || FNS[f].export {
            check_c_function(f);
        }
    }
    SELF_TYPE = 0;
}

// The parameters and result of a function with C's convention must be
// FFI-safe (see is_ffi_safe).
fn check_c_function(f: i64) {
    let item = FNS[f].node;
    for i in 0..FNS[f].param_count {
        let param = child(item, i);
        check_ffi_type(fn_param(f, i), NODES[param].b, c"parameter");
    }
    let ret = FNS[f].ret;
    if ret != TY_UNIT && ret != TY_NEVER {
        check_ffi_type(ret, NODES[item].b, c"result");
    }
}

fn check_c_signature(fn_ty: i64, n: i64, what: *u8) {
    for i in 0..TYPES[fn_ty].count {
        check_ffi_type(type_elem(fn_ty, i), child(n, i), c"parameter");
    }
    let ret = TYPES[fn_ty].a;
    if ret != TY_UNIT && ret != TY_NEVER {
        check_ffi_type(ret, NODES[n].a, c"result");
    }
}

fn check_ffi_type(t: i64, n: i64, what: *u8) {
    if is_ffi_safe(t) {
        return;
    }
    err_begin(NODES[n].start);
    err_str(c"type '");
    err_type(t);
    err_str(c"' of this ");
    err_str(what);
    err_str(c" cannot cross to C");
    let kind = TYPES[t].kind;
    if kind == TY_STRUCT || kind == TY_ENUM {
        err_help(c"declare it #[repr(C)] (its layout is unspecified otherwise), with fields that can cross to C");
    } else if kind == TY_FN {
        err_help(c"use an extern \"C\" fn type, and pass functions defined with extern \"C\" fn");
    } else if kind == TY_SLICE {
        err_help(c"pass the pointer and the length (s.ptr, s.len)");
    } else if kind == TY_TUPLE {
        err_help(c"use a #[repr(C)] struct");
    } else if kind == TY_ARRAY {
        err_help(c"pass a pointer to its first element, or wrap it in a #[repr(C)] struct");
    }
    err_end();
}

fn collect_statics() {
    for s in 0..STATIC_COUNT {
        let item = STATICS[s].node;
        let ty = resolve_type(NODES[item].b);
        STATICS[s].ty = ty;
        if STATICS[s].linkage != 0 {
            check_ffi_type(ty, NODES[item].b, c"static");
        }
        if STATICS[s].linkage == 1 {
            continue;
        }
        check_const_expr(NODES[item].c, ty);
        // Evaluated now to report non-constant initializers; the code
        // generator evaluates it again into the data section.
        let scratch = buf_new();
        const_emit(NODES[item].c, ty, scratch);
    }
}

fn evaluate_consts() {
    for c in 0..CONST_COUNT {
        const_value(c);
    }
}

// ---- Resolving types ----

fn resolve_type(n: i64) -> i64 {
    let kind = NODES[n].kind;
    if kind == T_NAME {
        return resolve_named(NODES[n].a, NODES[n].start);
    }
    if kind == T_UNIT { return TY_UNIT; }
    if kind == T_NEVER { return TY_NEVER; }
    if kind == T_PTR {
        return ptr_to(resolve_type(NODES[n].a));
    }
    if kind == T_SLICE {
        return slice_of(resolve_type(NODES[n].a));
    }
    if kind == T_ARRAY {
        let elem = resolve_type(NODES[n].a);
        return array_of(elem, eval_array_len(NODES[n].b));
    }
    let mark = TSCRATCH.count;
    for i in 0..NODES[n].count {
        let elem = resolve_type(child(n, i));
        intvec_push(&TSCRATCH, elem);
    }
    if kind == T_TUPLE {
        return make_type(TY_TUPLE, 0, 0, mark);
    }
    let result = resolve_type(NODES[n].a);
    let fn_ty = make_type(TY_FN, result, NODES[n].d, mark);
    if NODES[n].d != 0 {
        check_c_signature(fn_ty, n, c"an extern \"C\" fn type");
    }
    fn_ty
}

fn resolve_named(name: i64, pos: i64) -> i64 {
    if SYM_PRIMITIVE[name] != 0 {
        return SYM_PRIMITIVE[name];
    }
    if SYM_STRUCT[name] != 0 {
        return struct_type(SYM_STRUCT[name] - 1);
    }
    if SYM_ENUM[name] != 0 {
        return enum_type(SYM_ENUM[name] - 1);
    }
    if name == SELF_TYPE_SYM && SELF_TYPE != 0 {
        return SELF_TYPE;
    }
    if ALIAS_TYPE[name] != 0 {
        return ALIAS_TYPE[name];
    }
    let alias = SYM_ALIAS[name];
    if alias == 0 {
        name_error(pos, c"unknown type '", name, c"'");
    }
    if ALIAS_BUSY[name] != 0 {
        name_error(pos, c"type alias '", name, c"' is defined in terms of itself");
    }
    ALIAS_BUSY[name] = 1;
    let resolved = resolve_type(NODES[alias].b);
    ALIAS_BUSY[name] = 0;
    ALIAS_TYPE[name] = resolved;
    resolved
}

// ---- Functions ----

fn check_function(item: i64) {
    let f = NODES[item].x - 1;
    SELF_TYPE = FNS[f].self_ty;
    RETURN_TYPE = FNS[f].ret;
    LOOP_STACK.count = 0;
    ENV.count = 0;
    SCOPES.count = 0;
    for i in 0..NODES[item].count {
        let param = child(item, i);
        if NODES[param].a != UNDERSCORE {
            NODES[param].x = define_local(NODES[param].a, fn_param(f, i), NODES[param].c != 0, true);
        } else {
            NODES[param].x = -1;
        }
    }
    let body = NODES[item].c;
    let body_ty = check_block(body, RETURN_TYPE);
    if body_ty != RETURN_TYPE && body_ty != TY_NEVER {
        err_begin(NODES[body].start);
        err_str(c"function '");
        err_sym(NODES[item].a);
        err_str(c"' body has type '");
        err_type(body_ty);
        err_str(c"', expected '");
        err_type(RETURN_TYPE);
        err_str(c"'");
        err_end();
    }
    SELF_TYPE = 0;
}

// The type of a block; `expected` (0 for none) goes to its tail.
fn check_block(block: i64, expected: i64) -> i64 {
    push_scope();
    let mut diverges = false;
    for i in 0..NODES[block].count {
        if check_stmt(child(block, i)) {
            diverges = true;
        }
    }
    let tail = NODES[block].a;
    let mut ty = TY_UNIT;
    if tail != 0 {
        ty = if expected != 0 { check_expr(tail, expected) } else { synth_expr(tail) };
    }
    pop_scope();
    NODES[block].ty = if diverges { TY_NEVER } else { ty };
    NODES[block].ty
}

fn check_branch(block: i64, expected: i64) -> i64 {
    let ty = check_block(block, expected);
    if ty != expected && ty != TY_NEVER {
        mismatch_error(block, expected, ty);
    }
    ty
}

// Whether the statement diverges.
fn check_stmt(stmt: i64) -> bool {
    if NODES[stmt].kind == S_LET {
        return check_let(stmt);
    }
    let expr = NODES[stmt].a;
    let ty = if NODES[stmt].b != 0 { synth_expr(expr) } else { check_expr(expr, TY_UNIT) };
    ty == TY_NEVER
}

fn check_let(stmt: i64) -> bool {
    let init = NODES[stmt].c;
    let mut binding_ty = 0;
    let mut actual = 0;
    if NODES[stmt].b != 0 {
        binding_ty = resolve_type(NODES[stmt].b);
        actual = check_expr(init, binding_ty);
    } else {
        binding_ty = synth_expr(init);
        actual = binding_ty;
    }
    check_pattern(NODES[stmt].a, binding_ty);
    check_irrefutable(NODES[stmt].a, c"let");
    actual == TY_NEVER
}

// ---- Check mode ----

fn passes_expected_to_operands(op: i64, expected: i64) -> bool {
    if op == TK_PLUS || op == TK_MINUS || op == TK_STAR || op == TK_SLASH || op == TK_PERCENT {
        return is_numeric(expected);
    }
    if op == TK_AMP || op == TK_PIPE || op == TK_CARET {
        return is_integer(expected);
    }
    false
}

// Checks `n` against `expected`; returns `expected`, or `!` when the
// expression diverges.
fn check_expr(n: i64, expected: i64) -> i64 {
    let actual = check_expr_inner(n, expected);
    NODES[n].ty = expected;
    actual
}

fn check_expr_inner(n: i64, expected: i64) -> i64 {
    let kind = NODES[n].kind;
    if kind == E_INT && NODES[n].b == SUF_NONE && is_integer(expected) {
        check_int_fits(n, NODES[n].a as u64, expected);
        return expected;
    }
    if kind == E_CHAR && is_integer(expected) {
        check_int_fits(n, NODES[n].a as u64, expected);
        return expected;
    }
    if kind == E_FLOAT && NODES[n].b == SUF_NONE && is_float(expected) {
        return expected;
    }
    if kind == E_TUPLE && TYPES[expected].kind == TY_TUPLE {
        check_tuple(n, expected);
        return expected;
    }
    if kind == E_ARRAY && TYPES[expected].kind == TY_ARRAY {
        check_array(n, expected);
        return expected;
    }
    if kind == E_REPEAT && TYPES[expected].kind == TY_ARRAY {
        check_expr(NODES[n].a, TYPES[expected].a);
        let count = eval_array_len(NODES[n].b);
        if count != TYPES[expected].b {
            err_begin(NODES[NODES[n].b].start);
            err_str(c"array repeat count is ");
            err_int(count);
            err_str(c", expected ");
            err_int(TYPES[expected].b);
            err_end();
        }
        return expected;
    }
    if kind == E_STRUCT {
        check_struct_literal(n, expected);
        return expected;
    }
    if kind == E_IF {
        return check_if(n, expected);
    }
    if kind == E_MATCH {
        return check_match(n, expected);
    }
    if kind == E_BLOCK {
        return check_branch(n, expected);
    }
    if kind == E_LOOP {
        return check_loop(n, expected);
    }
    if kind == E_BINARY && passes_expected_to_operands(NODES[n].a, expected) {
        check_expr(NODES[n].b, expected);
        check_expr(NODES[n].c, expected);
        return expected;
    }
    if kind == E_BINARY && (NODES[n].a == TK_SHL || NODES[n].a == TK_SHR) && is_integer(expected) {
        check_expr(NODES[n].b, expected);
        check_shift_amount(NODES[n].c);
        return expected;
    }
    if kind == E_UNARY && NODES[n].a == TK_MINUS && is_numeric(expected) {
        check_negation(n, expected);
        return expected;
    }
    if kind == E_UNARY && NODES[n].a == TK_TILDE && is_integer(expected) {
        check_expr(NODES[n].b, expected);
        return expected;
    }
    let actual = synth_expr(n);
    if actual == TY_NEVER {
        return actual;
    }
    if actual != expected {
        mismatch_error(n, expected, actual);
    }
    expected
}

fn check_int_fits(n: i64, value: u64, ty: i64) {
    if value > int_max(ty) {
        err_begin(NODES[n].start);
        err_str(c"integer literal ");
        buf_uint(ERR, value);
        err_str(c" does not fit in type '");
        err_type(ty);
        err_str(c"'");
        err_end();
    }
}

fn check_tuple(n: i64, expected: i64) {
    let count = NODES[n].count;
    if count != TYPES[expected].count {
        err_begin(NODES[n].start);
        err_str(c"tuple has ");
        err_int(count);
        err_str(c" elements, expected ");
        err_int(TYPES[expected].count);
        err_end();
    }
    for i in 0..count {
        check_expr(child(n, i), type_elem(expected, i));
    }
}

fn check_array(n: i64, expected: i64) {
    let count = NODES[n].count;
    if count != TYPES[expected].b {
        err_begin(NODES[n].start);
        err_str(c"array has ");
        err_int(count);
        err_str(c" elements, expected ");
        err_int(TYPES[expected].b);
        err_end();
    }
    for i in 0..count {
        check_expr(child(n, i), TYPES[expected].a);
    }
}

// The struct named `name` (`Self` included), or -1.
fn struct_of_name(name: i64) -> i64 {
    if name == SELF_TYPE_SYM && SELF_TYPE != 0 && TYPES[SELF_TYPE].kind == TY_STRUCT {
        return TYPES[SELF_TYPE].a;
    }
    SYM_STRUCT[name] - 1
}

fn check_struct_literal(n: i64, expected: i64) {
    let name = NODES[n].a;
    if TYPES[expected].kind == TY_STRUCT && struct_of_name(name) >= 0
        && TYPES[expected].a != struct_of_name(name) {
        err_begin(NODES[n].start);
        err_str(c"expected struct '");
        err_sym(STRUCTS[TYPES[expected].a].name);
        err_str(c"', got constructor for '");
        err_sym(name);
        err_str(c"'");
        err_end();
    }
    let actual = check_struct_fields(n);
    if actual != expected {
        mismatch_error(n, expected, actual);
    }
}

// The fields of `Name { ... }`: each exactly once, with its declared type.
fn check_struct_fields(n: i64) -> i64 {
    let name = NODES[n].a;
    let s = struct_of_name(name);
    if s < 0 {
        name_error(NODES[n].start, c"unknown struct '", name, c"'");
    }
    for i in 0..NODES[n].count {
        let init = child(n, i);
        for j in 0..i {
            if NODES[child(n, j)].a == NODES[init].a {
                name_error(NODES[init].start, c"duplicate field '", NODES[init].a, c"' in constructor");
            }
        }
        let field = find_field(s, NODES[init].a);
        if field < 0 {
            err_begin(NODES[init].start);
            err_str(c"unknown field '");
            err_sym(NODES[init].a);
            err_str(c"' in struct '");
            err_sym(name);
            err_str(c"'");
            err_end();
        }
        NODES[init].x = field;
        check_expr(NODES[init].b, (*struct_field(s, field)).ty);
    }
    if (STRUCTS[s].repr & REPR_UNION) != 0 {
        if NODES[n].count != 1 {
            err_begin(NODES[n].start);
            err_str(c"a literal of union '");
            err_sym(name);
            err_str(c"' sets exactly one field");
            err_end();
        }
        return struct_type(s);
    }
    for f in 0..STRUCTS[s].field_count {
        let mut found = false;
        for i in 0..NODES[n].count {
            if NODES[child(n, i)].x == f {
                found = true;
            }
        }
        if !found {
            err_begin(NODES[n].start);
            err_str(c"missing field '");
            err_sym((*struct_field(s, f)).name);
            err_str(c"' in struct '");
            err_sym(name);
            err_str(c"' constructor");
            err_end();
        }
    }
    struct_type(s)
}

fn check_if(n: i64, expected: i64) -> i64 {
    check_expr(NODES[n].a, TY_BOOL);
    let else_block = NODES[n].c;
    if else_block == 0 {
        if expected != TY_UNIT {
            err_begin(NODES[n].start);
            err_str(c"if without else must have type '()', expected '");
            err_type(expected);
            err_str(c"'");
            err_end();
        }
        check_branch(NODES[n].b, TY_UNIT);
        return expected;
    }
    let then_ty = check_branch(NODES[n].b, expected);
    let else_ty = check_branch(else_block, expected);
    if then_ty == TY_NEVER && else_ty == TY_NEVER { TY_NEVER } else { expected }
}

fn check_negation(n: i64, expected: i64) {
    let operand = NODES[n].b;
    if NODES[operand].kind == E_INT && NODES[operand].b == SUF_NONE && is_signed(expected) {
        let value = NODES[operand].a as u64;
        let magnitude: u64 = if value == 0 { 0 } else { value - 1 };
        if magnitude > int_max(expected) {
            err_begin(NODES[n].start);
            err_str(c"integer literal -");
            buf_uint(ERR, value);
            err_str(c" does not fit in type '");
            err_type(expected);
            err_str(c"'");
            err_end();
        }
        NODES[operand].ty = expected;
        return;
    }
    check_expr(operand, expected);
}

fn check_shift_amount(amount: i64) {
    let ty = synth_expr(amount);
    if !is_integer(ty) {
        type_error_got(amount, c"shift amount must be integer", ty);
    }
}

// ---- Synth mode ----

fn synth_expr(n: i64) -> i64 {
    let ty = synth_expr_inner(n);
    NODES[n].ty = ty;
    ty
}

fn synth_expr_inner(n: i64) -> i64 {
    let kind = NODES[n].kind;
    if kind == E_INT || kind == E_FLOAT {
        if NODES[n].b != SUF_NONE {
            return suffixed_literal(n, false);
        }
        return if kind == E_INT { TY_I64 } else { TY_F64 };
    }
    if kind == E_CHAR { return TY_U8; }
    if kind == E_BOOL { return TY_BOOL; }
    if kind == E_UNIT { return TY_UNIT; }
    if kind == E_STR { return TY_STRING; }
    if kind == E_CSTR { return TY_U8_PTR; }
    if kind == E_IDENT { return synth_name(n); }
    if kind == E_BINARY { return synth_binary(n); }
    if kind == E_UNARY { return synth_unary(n); }
    if kind == E_CAST { return synth_cast(n); }
    if kind == E_CALL { return synth_call(n); }
    if kind == E_INDEX { return synth_index(n); }
    if kind == E_FIELD { return synth_field(n); }
    if kind == E_TUPLE_FIELD { return synth_tuple_field(n); }
    if kind == E_TUPLE {
        let mark = TSCRATCH.count;
        for i in 0..NODES[n].count {
            let elem = synth_expr(child(n, i));
            intvec_push(&TSCRATCH, elem);
        }
        return make_type(TY_TUPLE, 0, 0, mark);
    }
    if kind == E_ARRAY { return synth_array(n); }
    if kind == E_REPEAT {
        let elem = synth_expr(NODES[n].a);
        return array_of(elem, eval_array_len(NODES[n].b));
    }
    if kind == E_STRUCT { return check_struct_fields(n); }
    if kind == E_BLOCK { return check_block(n, 0); }
    if kind == E_IF { return synth_if(n); }
    if kind == E_MATCH { return check_match(n, 0); }
    if kind == E_PATH { return synth_path(n); }
    if kind == E_METHOD { return synth_method(n); }
    if kind == E_LOOP { return check_loop(n, 0); }
    if kind == E_WHILE { return check_while(n); }
    if kind == E_FOR { return check_for(n); }
    if kind == E_RANGE {
        type_error(n, c"ranges can only be used as the bounds of a 'for' loop");
    }
    if kind == E_ASSIGN {
        check_assign(n);
        return TY_UNIT;
    }
    if kind == E_RETURN { return check_return(n); }
    if kind == E_BREAK {
        check_break(n);
        return TY_NEVER;
    }
    // E_CONTINUE
    NODES[n].x = find_loop(n, c"continue");
    TY_NEVER
}

fn suffix_type(suffix: i64) -> i64 {
    if suffix == SUF_I8 { return TY_I8; }
    if suffix == SUF_I16 { return TY_I16; }
    if suffix == SUF_I32 { return TY_I32; }
    if suffix == SUF_I64 || suffix == SUF_ISIZE { return TY_I64; }
    if suffix == SUF_U8 { return TY_U8; }
    if suffix == SUF_U16 { return TY_U16; }
    if suffix == SUF_U32 { return TY_U32; }
    if suffix == SUF_U64 || suffix == SUF_USIZE { return TY_U64; }
    if suffix == SUF_F32 { return TY_F32; }
    TY_F64
}

// `1u8`, `2.5f32`; `negated` allows `-128i8`.
fn suffixed_literal(n: i64, negated: bool) -> i64 {
    let ty = suffix_type(NODES[n].b);
    if NODES[n].kind == E_INT && is_integer(ty) {
        let value = NODES[n].a as u64;
        let mut limit = value;
        if negated && is_signed(ty) && value > 0 {
            limit = value - 1;
        }
        if limit > int_max(ty) {
            err_begin(NODES[n].start);
            err_str(c"integer literal ");
            if negated {
                err_str(c"-");
            }
            buf_uint(ERR, value);
            err_str(c" does not fit in type '");
            err_type(ty);
            err_str(c"'");
            err_end();
        }
    }
    ty
}

fn synth_name(n: i64) -> i64 {
    let name = NODES[n].a;
    let local = lookup_local(name);
    if local >= 0 {
        NODES[n].x = R_LOCAL;
        NODES[n].y = local;
        return LOCALS[local].ty;
    }
    if SYM_CONST[name] != 0 {
        NODES[n].x = R_CONST;
        NODES[n].y = SYM_CONST[name] - 1;
        return CONSTS[NODES[n].y].ty;
    }
    if SYM_STATIC[name] != 0 {
        NODES[n].x = R_STATIC;
        NODES[n].y = SYM_STATIC[name] - 1;
        return STATICS[NODES[n].y].ty;
    }
    if SYM_FN[name] != 0 {
        let f = SYM_FN[name] - 1;
        if FNS[f].variadic {
            name_error(NODES[n].start, c"variadic function '", name, c"' cannot be used as a value");
        }
        NODES[n].x = R_FN;
        NODES[n].y = f;
        return fn_value_type(f);
    }
    name_error(NODES[n].start, c"undefined variable '", name, c"'")
}

fn fn_value_type(f: i64) -> i64 {
    let mark = TSCRATCH.count;
    for i in 0..FNS[f].param_count {
        intvec_push(&TSCRATCH, fn_param(f, i));
    }
    if FNS[f].is_extern || FNS[f].export {
        return make_type(TY_FN, FNS[f].ret, 1, mark);
    }
    make_type(TY_FN, FNS[f].ret, 0, mark)
}

fn is_valid_cast(from: i64, to: i64) -> bool {
    if is_fieldless_enum(from) && is_integer(to) { return true; }
    if is_numeric(from) && is_numeric(to) { return true; }
    if is_pointer(from) && is_pointer(to) { return true; }
    if is_integer(from) && is_pointer(to) { return true; }
    if is_pointer(from) && is_integer(to) { return true; }
    if from == TY_BOOL && is_integer(to) { return true; }
    from == TY_NEVER
}

fn synth_cast(n: i64) -> i64 {
    let operand = NODES[n].a;
    let from = synth_expr(operand);
    let to = resolve_type(NODES[n].b);
    if !is_valid_cast(from, to) {
        err_begin(NODES[operand].start);
        err_str(c"cannot cast '");
        err_type(from);
        err_str(c"' to '");
        err_type(to);
        err_str(c"'");
        err_end();
    }
    to
}

fn synth_index(n: i64) -> i64 {
    let base = NODES[n].a;
    let base_ty = synth_expr(base);
    let base_kind = TYPES[base_ty].kind;
    if base_kind != TY_ARRAY && base_kind != TY_PTR && base_kind != TY_SLICE {
        err_begin(NODES[base].start);
        err_str(c"cannot index type '");
        err_type(base_ty);
        err_str(c"'");
        err_end();
    }
    let index = NODES[n].b;
    if NODES[index].kind == E_RANGE {
        // Slicing.
        if NODES[index].a != 0 {
            check_index_type(NODES[index].a);
        }
        if NODES[index].b != 0 {
            check_index_type(NODES[index].b);
        } else if base_kind == TY_PTR {
            type_error(index, c"slicing a pointer needs an end: 'p[lo..hi]'");
        }
        NODES[index].ty = TY_UNIT;
        return slice_of(TYPES[base_ty].a);
    }
    check_index_type(index);
    TYPES[base_ty].a
}

fn check_index_type(index: i64) {
    let index_ty = synth_expr(index);
    if !is_integer(index_ty) {
        err_begin(NODES[index].start);
        err_str(c"index must be integer, got '");
        err_type(index_ty);
        err_str(c"'");
        err_end();
    }
}

// Fields of structs (also through a pointer to one: y = 1) and the `ptr`
// and `len` of slices (y = 2, x = 0 for ptr and 1 for len).
fn synth_field(n: i64) -> i64 {
    let mut base_ty = synth_expr(NODES[n].a);
    let name = NODES[n].b;
    NODES[n].y = 0;
    if TYPES[base_ty].kind == TY_SLICE {
        NODES[n].y = 2;
        if name == intern_c(c"len") {
            NODES[n].x = 1;
            return TY_U64;
        }
        if name == intern_c(c"ptr") {
            NODES[n].x = 0;
            return ptr_to(TYPES[base_ty].a);
        }
        err_begin(NODES[n].start);
        err_str(c"slices have the fields 'ptr' and 'len', not '");
        err_sym(name);
        err_str(c"'");
        err_end();
    }
    if TYPES[base_ty].kind == TY_PTR && TYPES[TYPES[base_ty].a].kind == TY_STRUCT {
        NODES[n].y = 1;
        base_ty = TYPES[base_ty].a;
    }
    if TYPES[base_ty].kind != TY_STRUCT {
        err_begin(NODES[n].start);
        err_str(c"cannot access field '");
        err_sym(name);
        err_str(c"' on type '");
        err_type(base_ty);
        err_str(c"'");
        err_end();
    }
    let s = TYPES[base_ty].a;
    let field = find_field(s, name);
    if field < 0 {
        err_begin(NODES[n].start);
        err_str(c"struct '");
        err_sym(STRUCTS[s].name);
        err_str(c"' has no field '");
        err_sym(name);
        err_str(c"'");
        if find_method(base_ty, name) >= 0 {
            err_help(c"'");
            err_help_sym(name);
            err_help(c"' is a method: call it with '(...)'");
        }
        err_end();
    }
    NODES[n].x = field;
    (*struct_field(s, field)).ty
}

fn synth_tuple_field(n: i64) -> i64 {
    let base_ty = synth_expr(NODES[n].a);
    let index = NODES[n].b;
    if TYPES[base_ty].kind != TY_TUPLE {
        err_begin(NODES[n].start);
        err_str(c"cannot use tuple index on type '");
        err_type(base_ty);
        err_str(c"'");
        err_end();
    }
    if index >= TYPES[base_ty].count {
        err_begin(NODES[n].start);
        err_str(c"tuple index ");
        err_int(index);
        err_str(c" out of range for tuple with ");
        err_int(TYPES[base_ty].count);
        err_str(c" elements");
        err_end();
    }
    type_elem(base_ty, index)
}

fn synth_array(n: i64) -> i64 {
    let count = NODES[n].count;
    if count == 0 {
        type_error(n, c"cannot infer the type of an empty array; annotate it");
    }
    let elem = synth_expr(child(n, 0));
    for i in 1..count {
        check_expr(child(n, i), elem);
    }
    array_of(elem, count)
}

fn synth_if(n: i64) -> i64 {
    check_expr(NODES[n].a, TY_BOOL);
    let then_ty = check_block(NODES[n].b, 0);
    let else_block = NODES[n].c;
    if else_block == 0 {
        if then_ty != TY_UNIT && then_ty != TY_NEVER {
            type_error_got(n, c"if without else must have type '()'", then_ty);
        }
        return TY_UNIT;
    }
    let else_ty = check_block(else_block, 0);
    if then_ty == TY_NEVER {
        return else_ty;
    }
    if else_ty == TY_NEVER || then_ty == else_ty {
        return then_ty;
    }
    err_begin(NODES[n].start);
    err_str(c"if/else branches have different types: '");
    err_type(then_ty);
    err_str(c"' vs '");
    err_type(else_ty);
    err_str(c"'");
    err_end()
}

// ---- Operators ----

fn is_untyped_literal(n: i64) -> bool {
    let kind = NODES[n].kind;
    if (kind == E_INT || kind == E_FLOAT) && NODES[n].b == SUF_NONE {
        return true;
    }
    if kind == E_CHAR {
        return true;
    }
    if kind == E_UNARY && NODES[n].a == TK_MINUS {
        return is_untyped_literal(NODES[n].b);
    }
    false
}

fn literal_takes_rhs_type(lhs: i64, rhs: i64) -> bool {
    is_untyped_literal(lhs) && !is_untyped_literal(rhs)
}

// The common type of a non-shift operator's operands.
fn synth_operands(lhs: i64, rhs: i64) -> i64 {
    if literal_takes_rhs_type(lhs, rhs) {
        let rhs_ty = synth_expr(rhs);
        check_expr(lhs, rhs_ty);
        return rhs_ty;
    }
    let lhs_ty = synth_expr(lhs);
    check_expr(rhs, lhs_ty);
    lhs_ty
}

fn synth_binary(n: i64) -> i64 {
    let op = NODES[n].a;
    let lhs = NODES[n].b;
    let rhs = NODES[n].c;
    if op == TK_SHL || op == TK_SHR {
        let value_ty = synth_expr(lhs);
        let amount_ty = synth_expr(rhs);
        if !is_integer(value_ty) {
            type_error_got(n, c"shift operator requires integer type", value_ty);
        }
        if !is_integer(amount_ty) {
            type_error_got(n, c"shift amount must be integer", amount_ty);
        }
        return value_ty;
    }
    let ty = synth_operands(lhs, rhs);
    if op == TK_PLUS || op == TK_MINUS || op == TK_STAR || op == TK_SLASH || op == TK_PERCENT {
        if !is_numeric(ty) {
            type_error_got(n, c"arithmetic operator requires numeric type", ty);
        }
        return ty;
    }
    if op == TK_LT || op == TK_GT || op == TK_LT_EQ || op == TK_GT_EQ {
        if !(is_numeric(ty) || is_pointer(ty)) {
            type_error_got(n, c"comparison requires numeric type", ty);
        }
        return TY_BOOL;
    }
    if op == TK_EQ_EQ || op == TK_BANG_EQ {
        if !(is_numeric(ty) || ty == TY_BOOL || is_pointer(ty) || is_fn_type(ty)
            || is_fieldless_enum(ty)) {
            type_error_got(n, c"equality requires numeric, bool, pointer or fieldless enum type", ty);
        }
        return TY_BOOL;
    }
    if op == TK_AMP_AMP || op == TK_PIPE_PIPE {
        if ty != TY_BOOL {
            type_error_got(n, c"logical operator requires bool", ty);
        }
        return TY_BOOL;
    }
    if !is_integer(ty) {
        type_error_got(n, c"bitwise operator requires integer type", ty);
    }
    ty
}

fn synth_unary(n: i64) -> i64 {
    let op = NODES[n].a;
    let operand = NODES[n].b;
    if op == TK_MINUS {
        let mut ty = 0;
        if NODES[operand].kind == E_INT && NODES[operand].b != SUF_NONE {
            ty = suffixed_literal(operand, true);
            NODES[operand].ty = ty;
        } else {
            ty = synth_expr(operand);
        }
        if !is_numeric(ty) {
            type_error_got(n, c"unary '-' requires numeric type", ty);
        }
        return ty;
    }
    if op == TK_BANG {
        check_expr(operand, TY_BOOL);
        return TY_BOOL;
    }
    if op == TK_TILDE {
        let ty = synth_expr(operand);
        if !is_integer(ty) {
            type_error_got(n, c"bitwise NOT requires integer type", ty);
        }
        return ty;
    }
    if op == TK_STAR {
        let ty = synth_expr(operand);
        if !is_pointer(ty) {
            err_begin(NODES[n].start);
            err_str(c"cannot deref non-pointer type '");
            err_type(ty);
            err_str(c"'");
            err_end();
        }
        return TYPES[ty].a;
    }
    // TK_AMP
    let ty = synth_expr(operand);
    if !is_place(operand) {
        type_error(n, c"cannot take address of non-lvalue expression");
    }
    ptr_to(ty)
}

// ---- Calls ----

fn is_variadic_arg_type(t: i64) -> bool {
    is_ffi_safe(t)
}

fn synth_call(n: i64) -> i64 {
    let callee = NODES[n].a;
    if NODES[callee].kind == E_PATH {
        return synth_path_call(n, callee);
    }
    if NODES[callee].kind == E_IDENT && lookup_local(NODES[callee].a) < 0
        && SYM_FN[NODES[callee].a] != 0 {
        let f = SYM_FN[NODES[callee].a] - 1;
        NODES[n].x = f + 1;
        return check_direct_call(n, f);
    }
    let callee_ty = synth_expr(callee);
    if !is_fn_type(callee_ty) {
        err_begin(NODES[callee].start);
        err_str(c"cannot call non-function type '");
        err_type(callee_ty);
        err_str(c"'");
        err_end();
    }
    if NODES[n].count != TYPES[callee_ty].count {
        err_begin(NODES[n].start);
        err_str(c"function pointer expects ");
        err_int(TYPES[callee_ty].count);
        err_str(c" arguments, got ");
        err_int(NODES[n].count);
        err_end();
    }
    for i in 0..NODES[n].count {
        check_expr(child(n, i), type_elem(callee_ty, i));
    }
    TYPES[callee_ty].a
}

fn check_direct_call(n: i64, f: i64) -> i64 {
    let count = NODES[n].count;
    let params = FNS[f].param_count;
    let variadic = FNS[f].variadic;
    let arity_ok = if variadic { count >= params } else { count == params };
    if !arity_ok {
        err_begin(NODES[n].start);
        err_str(c"function '");
        err_sym(FNS[f].name);
        err_str(c"' expects ");
        if variadic {
            err_str(c"at least ");
        }
        err_int(params);
        err_str(c" arguments, got ");
        err_int(count);
        err_end();
    }
    for i in 0..params {
        check_expr(child(n, i), fn_param(f, i));
    }
    for i in params..count {
        let arg = child(n, i);
        let ty = synth_expr(arg);
        if !is_variadic_arg_type(ty) {
            err_begin(NODES[arg].start);
            err_str(c"cannot pass value of type '");
            err_type(ty);
            err_str(c"' as a variadic argument");
            err_end();
        }
    }
    FNS[f].ret
}

// ---- Paths, variants and methods ----

// `T::m`: a variant without fields, or an associated function as a value.
fn synth_path(n: i64) -> i64 {
    let t = resolve_named(NODES[n].a, NODES[n].start);
    let member = NODES[n].b;
    if TYPES[t].kind == TY_ENUM {
        let v = find_variant(TYPES[t].a, member);
        if v >= 0 {
            if VARIANTS[v].field_count > 0 {
                err_begin(NODES[n].start);
                err_str(c"variant '");
                err_type(t);
                err_str(c"::");
                err_sym(member);
                err_str(c"' has ");
                err_int(VARIANTS[v].field_count);
                err_str(if VARIANTS[v].field_count == 1 { c" field" } else { c" fields" });
                err_help(c"construct it with '");
                buf_type(ERR_HELP, t);
                err_help(c"::");
                err_help_sym(member);
                err_help(c"(...)'");
                err_end();
            }
            NODES[n].kind = E_VARIANT;
            NODES[n].a = v;
            NODES[n].count = 0;
            return t;
        }
    }
    let f = find_method(t, member);
    if f < 0 {
        path_member_error(n, t, member);
    }
    NODES[n].kind = E_IDENT;
    NODES[n].a = FNS[f].name;
    NODES[n].x = R_FN;
    NODES[n].y = f;
    fn_value_type(f)
}

fn path_member_error(n: i64, t: i64, member: i64) -> ! {
    err_begin(NODES[n].start);
    if TYPES[t].kind == TY_ENUM {
        err_str(c"no variant or associated function '");
    } else {
        err_str(c"no associated function '");
    }
    err_sym(member);
    err_str(c"' in '");
    err_type(t);
    err_str(c"'");
    err_end()
}

// `T::m(args)`: a variant with fields, or a call of an associated function
// (or of a method, with the receiver passed explicitly).
fn synth_path_call(n: i64, callee: i64) -> i64 {
    let t = resolve_named(NODES[callee].a, NODES[callee].start);
    let member = NODES[callee].b;
    if TYPES[t].kind == TY_ENUM {
        let v = find_variant(TYPES[t].a, member);
        if v >= 0 {
            let count = VARIANTS[v].field_count;
            if count == 0 {
                err_begin(NODES[n].start);
                err_str(c"variant '");
                err_type(t);
                err_str(c"::");
                err_sym(member);
                err_str(c"' has no fields");
                err_help(c"write it without parentheses");
                err_end();
            }
            if NODES[n].count != count {
                err_begin(NODES[n].start);
                err_str(c"variant '");
                err_type(t);
                err_str(c"::");
                err_sym(member);
                err_str(c"' has ");
                err_int(count);
                err_str(if count == 1 { c" field" } else { c" fields" });
                err_str(c", got ");
                err_int(NODES[n].count);
                err_end();
            }
            for i in 0..count {
                check_expr(child(n, i), variant_field(v, i));
            }
            NODES[n].kind = E_VARIANT;
            NODES[n].a = v;
            return t;
        }
    }
    let f = find_method(t, member);
    if f < 0 {
        path_member_error(callee, t, member);
    }
    NODES[n].x = f + 1;
    check_direct_call(n, f)
}

// Whether function f is a method: its first parameter is named `self`.
fn is_method(f: i64) -> bool {
    let item = FNS[f].node;
    FNS[f].param_count > 0 && NODES[child(item, 0)].a == SELF_SYM
}

// A new node for the checker: `op operand` (`&` or `*`) of type `ty`.
fn synthetic_unary(op: i64, operand: i64, ty: i64) -> i64 {
    let u = new_node(E_UNARY, NODES[operand].start, NODES[operand].end);
    NODES[u].a = op;
    NODES[u].b = operand;
    NODES[u].ty = ty;
    u
}

// `x.m(args)`: a call of method m of x's type (or of the type x points
// to), with `&x` or `*x` as needed for its `self`; becomes an E_CALL.
fn synth_method(n: i64) -> i64 {
    let receiver = NODES[n].a;
    let name = NODES[n].b;
    let receiver_ty = synth_expr(receiver);
    let mut t = receiver_ty;
    let mut through_pointer = false;
    if is_pointer(t) && (TYPES[TYPES[t].a].kind == TY_STRUCT || TYPES[TYPES[t].a].kind == TY_ENUM) {
        t = TYPES[t].a;
        through_pointer = true;
    }
    let mut f = -1;
    if TYPES[t].kind == TY_STRUCT || TYPES[t].kind == TY_ENUM {
        f = find_method(t, name);
    }
    if f < 0 {
        err_begin(NODES[n].start);
        err_str(c"no method '");
        err_sym(name);
        err_str(c"' on type '");
        err_type(receiver_ty);
        err_str(c"'");
        if TYPES[t].kind == TY_STRUCT && find_field(TYPES[t].a, name) >= 0 {
            err_help(c"to call a function stored in a field, write (s.f)(x)");
        }
        err_end();
    }
    if !is_method(f) {
        err_begin(NODES[n].start);
        err_str(c"'");
        err_type(t);
        err_str(c"::");
        err_sym(name);
        err_str(c"' is an associated function, not a method (it has no 'self' parameter)");
        err_help(c"call it as '");
        buf_type(ERR_HELP, t);
        err_help(c"::");
        err_help_sym(name);
        err_help(c"(...)'");
        err_end();
    }
    let self_ty = fn_param(f, 0);
    let mut arg = receiver;
    if self_ty == t {
        if through_pointer {
            arg = synthetic_unary(TK_STAR, receiver, t);
        }
    } else if self_ty == ptr_to(t) {
        if !through_pointer {
            if !is_place(receiver) && !is_compound(t) {
                err_begin(NODES[n].start);
                err_str(c"method '");
                err_sym(name);
                err_str(c"' takes 'self: *");
                err_type(t);
                err_str(c"', but the receiver is a temporary value");
                err_help(c"bind it to a variable first");
                err_end();
            }
            arg = synthetic_unary(TK_AMP, receiver, self_ty);
        }
    } else {
        err_begin(NODES[n].start);
        err_str(c"method '");
        err_sym(name);
        err_str(c"' has 'self' of type '");
        err_type(self_ty);
        err_str(c"'; a method's 'self' must be '");
        err_type(t);
        err_str(c"' or '*");
        err_type(t);
        err_str(c"'");
        err_end();
    }
    let count = NODES[n].count;
    if count + 1 != FNS[f].param_count {
        err_begin(NODES[n].start);
        err_str(c"method '");
        err_sym(name);
        err_str(c"' expects ");
        err_int(FNS[f].param_count - 1);
        err_str(c" arguments, got ");
        err_int(count);
        err_end();
    }
    let mark = list_begin();
    list_push(arg);
    for i in 0..count {
        let a = child(n, i);
        check_expr(a, fn_param(f, i + 1));
        list_push(a);
    }
    list_end(n, mark);
    NODES[n].kind = E_CALL;
    NODES[n].a = 0;
    NODES[n].x = f + 1;
    FNS[f].ret
}

// ---- Places and assignment ----

fn is_place(n: i64) -> bool {
    let kind = NODES[n].kind;
    if kind == E_IDENT {
        let name = NODES[n].a;
        return lookup_local(name) >= 0 || SYM_STATIC[name] != 0;
    }
    if kind == E_UNARY {
        return NODES[n].a == TK_STAR;
    }
    if kind == E_FIELD && NODES[n].y == 1 {
        // Through a pointer.
        return true;
    }
    if kind == E_FIELD || kind == E_TUPLE_FIELD {
        return is_place(NODES[n].a);
    }
    if kind == E_INDEX {
        let base = NODES[n].a;
        if NODES[NODES[n].b].kind == E_RANGE {
            return false;
        }
        return is_pointer(NODES[base].ty) || is_slice(NODES[base].ty) || is_place(base);
    }
    false
}

fn check_assign(n: i64) {
    let op = NODES[n].a;
    let target = NODES[n].b;
    let value = NODES[n].c;
    let target_ty = synth_expr(target);
    if !is_place(target) {
        let name = NODES[target].a;
        if NODES[target].kind == E_IDENT && SYM_CONST[name] != 0 {
            name_error(NODES[target].start, c"cannot assign to constant '", name, c"'");
        }
        if NODES[target].kind == E_IDENT && SYM_FN[name] != 0 {
            name_error(NODES[target].start, c"cannot assign to function '", name, c"'");
        }
        type_error(target, c"invalid assignment target");
    }
    check_mutable_place(target);
    if op == TK_EQ {
        check_expr(value, target_ty);
        return;
    }
    if op == TK_SHL_EQ || op == TK_SHR_EQ {
        if !is_integer(target_ty) {
            type_error_got(n, c"shift assignment requires integer type", target_ty);
        }
        check_shift_amount(value);
        return;
    }
    if op == TK_AMP_EQ || op == TK_PIPE_EQ || op == TK_CARET_EQ {
        if !is_integer(target_ty) {
            type_error_got(n, c"bitwise assignment requires integer type", target_ty);
        }
    } else if !is_numeric(target_ty) {
        type_error_got(n, c"compound assignment requires numeric type", target_ty);
    }
    check_expr(value, target_ty);
}

fn check_mutable_place(target: i64) {
    let mut root = target;
    loop {
        let kind = NODES[root].kind;
        if kind == E_FIELD && NODES[root].y == 1 {
            // Through a pointer: no `mut` needed.
            return;
        } else if kind == E_FIELD || kind == E_TUPLE_FIELD {
            root = NODES[root].a;
        } else if kind == E_INDEX && !is_pointer(NODES[NODES[root].a].ty)
            && !is_slice(NODES[NODES[root].a].ty) {
            root = NODES[root].a;
        } else if kind == E_IDENT {
            check_mutable_name(NODES[root].a, target);
            return;
        } else {
            return;
        }
    }
}

fn check_mutable_name(name: i64, target: i64) {
    let local = lookup_local(name);
    if local >= 0 {
        if LOCALS[local].mutable {
            return;
        }
        err_begin(NODES[target].start);
        err_str(c"cannot assign to immutable variable '");
        err_sym(name);
        err_str(c"'");
        if LOCALS[local].is_param {
            err_help(c"make the parameter mutable: `mut ");
            err_help_sym(name);
            err_help(c": ");
            buf_type(ERR_HELP, LOCALS[local].ty);
            err_help(c"`");
        } else {
            err_help(c"make it mutable: `let mut ");
            err_help_sym(name);
            err_help(c"`");
        }
        err_end();
    }
    if SYM_STATIC[name] != 0 && !STATICS[SYM_STATIC[name] - 1].mutable {
        err_begin(NODES[target].start);
        err_str(c"cannot assign to immutable static '");
        err_sym(name);
        err_str(c"'");
        err_help(c"declare it `static mut ");
        err_help_sym(name);
        err_help(c"`");
        err_end();
    }
}

// ---- Loops and jumps ----

// The loop a `break`/`continue` refers to.
fn find_loop(n: i64, keyword: *u8) -> i64 {
    let label = NODES[n].a;
    if label == 0 {
        if LOOP_STACK.count == 0 {
            err_begin(NODES[n].start);
            err_str(keyword);
            err_str(c" outside of loop");
            err_end();
        }
        return LOOP_STACK.data[LOOP_STACK.count - 1];
    }
    let mut i = LOOP_STACK.count - 1;
    while i >= 0 {
        let lp = LOOP_STACK.data[i];
        if NODES[lp].a == label {
            return lp;
        }
        i -= 1;
    }
    name_error(NODES[n].start, c"unknown loop label ':", label, c"'")
}

fn check_loop_body(lp: i64, body: i64) {
    intvec_push(&LOOP_STACK, lp);
    check_branch(body, TY_UNIT);
    intvec_pop(&LOOP_STACK);
}

// `loop`; `expected` (0 for none) is the type of its break values.
fn check_loop(n: i64, expected: i64) -> i64 {
    NODES[n].x = 0;
    NODES[n].y = expected;
    check_loop_body(n, NODES[n].b);
    if NODES[n].x == 0 {
        return TY_NEVER;
    }
    if NODES[n].y == 0 { TY_UNIT } else { NODES[n].y }
}

fn check_while(n: i64) -> i64 {
    check_expr(NODES[n].b, TY_BOOL);
    check_loop_body(n, NODES[n].c);
    TY_UNIT
}

fn check_for(n: i64) -> i64 {
    let range = NODES[n].c;
    if NODES[range].kind != E_RANGE {
        type_error(range, c"'for' loops can only iterate over integer ranges ('a..b' or 'a..=b')");
    }
    let start = NODES[range].a;
    let end = NODES[range].b;
    let mut elem_ty = 0;
    if literal_takes_rhs_type(start, end) {
        elem_ty = synth_expr(end);
        check_expr(start, elem_ty);
    } else {
        elem_ty = synth_expr(start);
        check_expr(end, elem_ty);
    }
    if !is_integer(elem_ty) {
        type_error_got(range, c"range bounds must be integers", elem_ty);
    }
    NODES[range].ty = elem_ty;
    let pattern = NODES[n].b;
    if NODES[pattern].kind == P_TUPLE {
        type_error(pattern, c"a 'for' loop over a range binds one integer, not a tuple");
    }
    push_scope();
    check_pattern(pattern, elem_ty);
    check_irrefutable(pattern, c"for");
    check_loop_body(n, NODES[n].d);
    pop_scope();
    TY_UNIT
}

fn check_break(n: i64) {
    let lp = find_loop(n, c"break");
    NODES[n].x = lp;
    let value = NODES[n].b;
    if value != 0 {
        if NODES[lp].kind != E_LOOP {
            err_begin(NODES[value].start);
            err_str(c"'break' with a value is only allowed in 'loop', not in '");
            err_str(if NODES[lp].kind == E_WHILE { c"while" } else { c"for" });
            err_str(c"'");
            err_end();
        }
        if NODES[lp].y != 0 {
            check_expr(value, NODES[lp].y);
        } else {
            let ty = synth_expr(value);
            if ty != TY_NEVER {
                NODES[lp].y = ty;
            }
        }
    } else if NODES[lp].kind == E_LOOP {
        let ty = NODES[lp].y;
        if ty != 0 && ty != TY_UNIT && ty != TY_NEVER {
            err_begin(NODES[n].start);
            err_str(c"expected '");
            err_type(ty);
            err_str(c"', got '()' (break without a value)");
            err_end();
        }
        if ty == 0 {
            NODES[lp].y = TY_UNIT;
        }
    }
    NODES[lp].x = 1;
}

fn check_return(n: i64) -> i64 {
    let value = NODES[n].a;
    if value != 0 {
        check_expr(value, RETURN_TYPE);
    } else if RETURN_TYPE != TY_UNIT && RETURN_TYPE != TY_NEVER {
        err_begin(NODES[n].start);
        err_str(c"empty return in function returning '");
        err_type(RETURN_TYPE);
        err_str(c"'");
        err_end();
    }
    TY_NEVER
}
