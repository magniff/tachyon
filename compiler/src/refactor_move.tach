// Moving items between modules, and splitting a module (0.11, phase 2a;
// docs/refactor.md):
//
//   tachyonc refactor move PATH... --to MODULE
//   tachyonc refactor split MODULE --into NEWMOD --items a,b,c
//   tachyonc refactor split MODULE --plan|--auto [--max-lines N]
//
// What moves with an item: its text (its lines, with the comment and
// attribute lines directly above it); the impl blocks of a type moved
// (inherent and trait impls in its module; --keep-impls leaves them), and
// the trait impls in its module of a trait moved for a type that is not an
// item of that module; the banner of a group of items (a comment block
// with blank lines around it, after some code: it heads the items up to
// the next banner) when every item of the group moves to one module. Then
// the references: paths naming a moved item are written from `crate`, the
// `use` lines importing it import it from its new module, the code that
// named it bare gets an import, the moved code gets the imports it needs
// (what its old module imported, and the old module's items), `super::`
// and `self::` paths in it are written from `crate`, items used from
// where they are private become `pub` (and the modules on the way), and
// the imports of the old module that nothing names any more are removed.
// Nothing else changes, byte for byte.

use crate::base::{BUFS, FILES, FILE_COUNT, IntVec, SRC, STDOUT, SYMS, alloc_array, buf_byte, buf_bytes, buf_int,
    buf_new, buf_slice, buf_str, buf_write_fd, intern};
use crate::lexer::{TOKS, TOK_COUNT, Tok};
use crate::ast::{NODES, NODE_COUNT, NodeKind, child};
use crate::lower::HMap;
use crate::modules::{child_module, file_of_pos, module_at, module_count, module_of};
use crate::query::{
    DEFS, DEF_COUNT, K_ENUM, K_IMPL_METHOD, K_METHOD, K_MOD, K_STRUCT, K_TRAIT, K_VARIANT, OPT_MAX_LINES, PROG,
    QF_DEF, QF_USE, R_DEF, R_FLAGS, R_POS, ROOT_GIVEN, bytes_eq, c_slice, diag, line_end, line_start, mod_fqn,
    put_cword, put_word, sym_less, token_at, try_begin, try_end,
};
use crate::edit::{after_line, blank_line, delete_lines, node_head};
use crate::plan::cluster;
use crate::refactor_mod::{
    NM_BODY, NM_PATH, NM_USES, OPT_AUTO, OPT_INTO, OPT_ITEMS, OPT_KEEP_IMPLS, OPT_PLAN, REFS, binding_of,
    collision, comment_line, emit_regions, finish, inline_module, is_ident, is_new, item_binding, load_refs,
    make_module, make_path, module_named, no_module, one_definition, own_file, path_segments, path_start,
    put_edit, put_region_path, qualified, ref_named, region_name, text_of, use_binding, use_id_at, use_node_of,
    user_pos, within, chain_public,
};

// ---- Units: the top-level pieces of a file ----

const U_ITEM: i64 = 1;
const U_IMPL: i64 = 2;
const U_EXTERN: i64 = 3;
const U_OTHER: i64 = 4;

// Per unit: its text (from the comment and attribute lines above it to
// after its last line), its first and last tokens, its kind, its item (an
// impl's type when it is an item of the module), an impl's trait, its
// file, the start of the banner above it (-1), where it moves (-1).
static mut UN_START: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut UN_END: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut UN_FIRST: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut UN_LAST: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut UN_KIND: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut UN_DEF: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut UN_TRAIT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut UN_FILE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut UN_BANNER: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut UN_DEST: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The unit of an item (definition + 1 -> unit + 1), files done.
static mut UNIT_OF: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static mut UNITS_DONE: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
// The top-level definitions by the token index of their start.
static mut DEF_TOK: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

fn closing(i: i64) -> i64 {
    unsafe {
        let mut depth = 0;
        let mut j = i;
        while j < TOK_COUNT && TOKS[j].kind != Tok::Eof {
            let k = TOKS[j].kind;
            if k == Tok::LBrace || k == Tok::LParen || k == Tok::LBracket {
                depth += 1;
            } else if k == Tok::RBrace || k == Tok::RParen || k == Tok::RBracket {
                depth -= 1;
                if depth == 0 {
                    return j;
                }
            }
            j += 1;
        }
        j - 1
    }
}

// The units of file f, in order.
fn units_of(f: i64) {
    unsafe {
        if UNITS_DONE.get(f + 1) != 0 {
            return;
        }
        UNITS_DONE.put(f + 1, 1);
        if DEF_TOK.count == 0 {
            for d in 0..DEF_COUNT {
                if DEFS[d].parent < 0 && DEFS[d].kind != K_METHOD && DEFS[d].kind != K_IMPL_METHOD {
                    DEF_TOK.put(token_at(DEFS[d].start) + 1, d + 1);
                }
            }
        }
        let first_unit = UN_START.count;
        let mut i = token_at(FILES[f].start);
        while i < TOK_COUNT && TOKS[i].kind != Tok::Eof && TOKS[i].start < FILES[f].end {
            let head = i;
            while TOKS[i].kind == Tok::Hash && TOKS[i + 1].kind == Tok::LBracket {
                i = closing(i + 1) + 1;
            }
            if TOKS[i].kind == Tok::Pub {
                i += 1;
            }
            let kw = TOKS[i].kind;
            let braced = kw == Tok::Fn || kw == Tok::Struct || kw == Tok::Enum || kw == Tok::Union || kw == Tok::Impl
                || kw == Tok::Trait || kw == Tok::Extern || kw == Tok::Mod || kw == Tok::Unsafe;
            let mut j = i;
            let mut depth = 0;
            loop {
                let k = TOKS[j].kind;
                if k == Tok::Eof || TOKS[j].start >= FILES[f].end {
                    j -= 1;
                    break;
                }
                if k == Tok::LBrace || k == Tok::LParen || k == Tok::LBracket {
                    depth += 1;
                } else if k == Tok::RBrace || k == Tok::RParen || k == Tok::RBracket {
                    depth -= 1;
                    if depth == 0 && k == Tok::RBrace && braced {
                        break;
                    }
                } else if k == Tok::Semi && depth == 0 {
                    break;
                }
                j += 1;
            }
            let u = UN_START.count;
            UN_START.push(unit_text_start(f, TOKS[head].start));
            UN_END.push(after_line(TOKS[j].end - 1));
            UN_FIRST.push(head);
            UN_LAST.push(j);
            UN_FILE.push(f);
            UN_BANNER.push(-1);
            UN_DEST.push(-1);
            UN_TRAIT.push(-1);
            let m = module_at(TOKS[i].start);
            if kw == Tok::Impl {
                UN_KIND.push(U_IMPL);
                impl_names(i, m);
            } else if kw == Tok::Extern && TOKS[i + 1].kind == Tok::Str && TOKS[i + 2].kind == Tok::LBrace {
                UN_KIND.push(U_EXTERN);
                UN_DEF.push(-1);
            } else if kw == Tok::Use || kw == Tok::Import || kw == Tok::Mod {
                UN_KIND.push(U_OTHER);
                UN_DEF.push(-1);
            } else {
                let mut d = -1;
                let mut t = i;
                while t <= j && t <= i + 3 && d < 0 {
                    d = DEF_TOK.get(t + 1) - 1;
                    t += 1;
                }
                UN_KIND.push(if d >= 0 { U_ITEM } else { U_OTHER });
                UN_DEF.push(d);
                if d >= 0 {
                    UNIT_OF.put(d + 1, u + 1);
                }
            }
            i = j + 1;
        }
        banners(f, first_unit);
    }
}

// The start of the text of an item whose first token is at pos: its line,
// and the comment and attribute lines directly above.
fn unit_text_start(f: i64, pos: i64) -> i64 {
    unsafe {
        let mut first = line_start(pos);
        while first > FILES[f].start {
            let prev = line_start(first - 1);
            let mut a = prev;
            while a < first - 1 && (SRC[a] == ' ' || SRC[a] == '\t') {
                a += 1;
            }
            let comment = a + 1 < first && SRC[a] == '/' && SRC[a + 1] == '/';
            let attribute = a + 1 < first && SRC[a] == '#' && SRC[a + 1] == '[';
            if !comment && !attribute {
                break;
            }
            first = prev;
        }
        first
    }
}

// The type and the trait of the impl block at token i (`impl`), when they
// are items of module m: UN_DEF and UN_TRAIT.
fn impl_names(i: i64, m: i64) {
    unsafe {
        let mut t = i + 1;
        if TOKS[t].kind == Tok::Lt {
            let mut depth = 0;
            loop {
                let k = TOKS[t].kind;
                if k == Tok::Lt {
                    depth += 1;
                } else if k == Tok::Gt {
                    depth -= 1;
                } else if k == Tok::Shr {
                    depth -= 2;
                }
                t += 1;
                if depth <= 0 || k == Tok::LBrace || k == Tok::Eof {
                    break;
                }
            }
        }
        let mut angle = 0;
        let mut last = -1;
        let mut tr = -1;
        while TOKS[t].kind != Tok::LBrace && TOKS[t].kind != Tok::Eof {
            let k = TOKS[t].kind;
            if k == Tok::Lt {
                angle += 1;
            } else if k == Tok::Gt {
                angle -= 1;
            } else if k == Tok::Shr {
                angle -= 2;
            } else if k == Tok::For && angle == 0 {
                tr = last;
                last = -1;
            } else if k == Tok::Ident && angle == 0 {
                last = t;
            }
            t += 1;
        }
        let mut ty = -1;
        if last >= 0 {
            let d = item_binding(m, TOKS[last].value as i64);
            if d >= 0 && (DEFS[d].kind == K_STRUCT || DEFS[d].kind == K_ENUM) {
                ty = d;
            }
        }
        UN_DEF.push(ty);
        if tr >= 0 {
            let d = item_binding(m, TOKS[tr].value as i64);
            if d >= 0 && DEFS[d].kind == K_TRAIT {
                UN_TRAIT.data[UN_TRAIT.count - 1] = d;
            }
        }
    }
}

// The banners above the units of file f (from unit `first`): a block of
// comment lines, a blank line after it and one before it (or code), with
// code somewhere before it in the file (the comment at the top of a file
// is the file's).
fn banners(f: i64, first: i64) {
    unsafe {
        let code_start = if first < UN_START.count { TOKS[UN_FIRST.data[first]].start } else { FILES[f].end };
        for u in first..UN_START.count {
            let a = UN_START.data[u];
            if a <= FILES[f].start {
                continue;
            }
            let mut q = line_start(a - 1);
            if !blank_line(q) {
                continue;
            }
            while q > FILES[f].start && blank_line(q) {
                q = line_start(q - 1);
            }
            if !comment_line(q) {
                continue;
            }
            let mut cs = q;
            while cs > FILES[f].start && comment_line(line_start(cs - 1)) {
                cs = line_start(cs - 1);
            }
            if cs < code_start || (u > first && cs < UN_END.data[u - 1]) {
                continue;
            }
            UN_BANNER.data[u] = cs;
        }
    }
}

// The unit holding position pos (of a file whose units are made), or -1.
fn unit_at(pos: i64) -> i64 {
    unsafe {
        for u in 0..UN_START.count {
            if UN_START.data[u] <= pos && pos < UN_END.data[u] {
                return u;
            }
        }
        -1
    }
}

// ---- Blocks: the text that moves ----

// Per block: its range, where it goes, and for a function of an extern
// block moved alone, the extern block's unit (its header wraps it).
static mut BL_START: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut BL_END: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut BL_DEST: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut BL_WRAP: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The moves asked for: items and their regions.
pub static mut MV_DEF: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
pub static mut MV_DEST: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The region the code at pos is in after the edit.
fn region_at(pos: i64) -> i64 {
    unsafe {
        let mut lo = 0;
        let mut hi = BL_START.count;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if BL_START.data[mid] <= pos {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if lo > 0 && pos < BL_END.data[lo - 1] {
            return BL_DEST.data[lo - 1];
        }
        module_at(pos)
    }
}

fn add_block(start: i64, end: i64, dest: i64, wrap: i64) {
    unsafe {
        // (in order of position)
        let mut k = BL_START.count;
        BL_START.push(0);
        BL_END.push(0);
        BL_DEST.push(0);
        BL_WRAP.push(0);
        while k > 0 && BL_START.data[k - 1] > start {
            BL_START.data[k] = BL_START.data[k - 1];
            BL_END.data[k] = BL_END.data[k - 1];
            BL_DEST.data[k] = BL_DEST.data[k - 1];
            BL_WRAP.data[k] = BL_WRAP.data[k - 1];
            k -= 1;
        }
        BL_START.data[k] = start;
        BL_END.data[k] = end;
        BL_DEST.data[k] = dest;
        BL_WRAP.data[k] = wrap;
    }
}

// Whether item d can move (diagnosed when not).
fn movable(d: i64) -> bool {
    unsafe {
        let k = DEFS[d].kind;
        let mut why = 0 as *u8;
        if k == K_METHOD || k == K_IMPL_METHOD {
            why = c" is a method: it moves with its type's impl block";
        } else if DEFS[d].parent >= 0 {
            why = c" is part of an item: move the item";
        } else if k == K_MOD {
            why = c" is a module: use move-module";
        }
        if why != 0 as *u8 {
            let e = diag(c"error", c"refactor.not-movable");
            buf_bytes(e, SYMS[DEFS[d].fqn].text);
            buf_str(e, why);
            buf_byte(e, '\n');
            if k == K_MOD {
                let out = try_begin(c"move-module", SYMS[DEFS[d].fqn].text, true);
                buf_str(out, c" crate::NEW::PATH");
                try_end(out);
            }
            return false;
        }
        let f = file_of_pos(DEFS[d].start);
        if module_at(DEFS[d].start) != FILES[f].module {
            inline_module(module_at(DEFS[d].start));
            return false;
        }
        true
    }
}

// The blocks of the moves: each item's unit (or its line in an extern
// block), the impl blocks that go with it, the banners. False after a
// diagnostic.
fn make_blocks() -> bool {
    unsafe {
        let mut seen = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for i in 0..MV_DEF.count {
            let d = MV_DEF.data[i];
            let f = file_of_pos(DEFS[d].start);
            units_of(f);
            let u = UNIT_OF.get(d + 1) - 1;
            if u >= 0 {
                UN_DEST.data[u] = MV_DEST.data[i];
                continue;
            }
            // A function of an extern block.
            let x = unit_at(DEFS[d].start);
            if x < 0 || UN_KIND.data[x] != U_EXTERN {
                let e = diag(c"error", c"refactor.not-movable");
                buf_bytes(e, SYMS[DEFS[d].fqn].text);
                buf_str(e, c" is not an item of its file that the refactorings know how to move\n");
                return false;
            }
            seen.put(d + 1, MV_DEST.data[i] + 1);
        }
        // The extern blocks: whole when all their functions go to one
        // place, else function by function.
        for x in 0..UN_START.count {
            if UN_KIND.data[x] != U_EXTERN {
                continue;
            }
            let mut dest = -2;
            let mut all = true;
            for d in 0..DEF_COUNT {
                if DEFS[d].parent >= 0 || DEFS[d].start < TOKS[UN_FIRST.data[x]].start || DEFS[d].start > TOKS[UN_LAST.data[x]].start {
                    continue;
                }
                let g = seen.get(d + 1) - 1;
                if g < 0 {
                    all = false;
                } else if dest == -2 {
                    dest = g;
                } else if dest != g {
                    all = false;
                }
            }
            if dest == -2 {
                continue;
            }
            if all {
                UN_DEST.data[x] = dest;
                continue;
            }
            for d in 0..DEF_COUNT {
                let g = seen.get(d + 1) - 1;
                if g >= 0 && DEFS[d].start >= TOKS[UN_FIRST.data[x]].start && DEFS[d].start <= TOKS[UN_LAST.data[x]].start {
                    let f = UN_FILE.data[x];
                    let tail = TOKS[token_at(DEFS[d].end - 1)].end;
                    add_block(unit_text_start(f, node_head(DEFS[d].start)), after_line(tail - 1), g, x);
                }
            }
        }
        // The impl blocks go with their type (or their trait).
        for x in 0..UN_START.count {
            if UN_KIND.data[x] != U_IMPL || UN_DEST.data[x] >= 0 {
                continue;
            }
            let ty = UN_DEF.data[x];
            let tr = UN_TRAIT.data[x];
            if ty >= 0 && !OPT_KEEP_IMPLS {
                let tu = UNIT_OF.get(ty + 1) - 1;
                if tu >= 0 && UN_DEST.data[tu] >= 0 {
                    UN_DEST.data[x] = UN_DEST.data[tu];
                }
            } else if ty < 0 && tr >= 0 {
                let tu = UNIT_OF.get(tr + 1) - 1;
                if tu >= 0 && UN_DEST.data[tu] >= 0 {
                    UN_DEST.data[x] = UN_DEST.data[tu];
                }
            }
        }
        // The units that move, with their banners.
        for u in 0..UN_START.count {
            if UN_DEST.data[u] < 0 {
                continue;
            }
            let mut start = UN_START.data[u];
            if UN_BANNER.data[u] >= 0 {
                let mut whole = true;
                let mut v = u;
                while v < UN_START.count && UN_FILE.data[v] == UN_FILE.data[u] && (v == u || UN_BANNER.data[v] < 0) {
                    if UN_DEST.data[v] != UN_DEST.data[u] {
                        whole = false;
                    }
                    v += 1;
                }
                if whole {
                    start = UN_BANNER.data[u];
                }
            }
            add_block(start, UN_END.data[u], UN_DEST.data[u], -1);
        }
        true
    }
}

// ---- Edits inside moved text ----
//
// Every edit that may fall in moved text goes here first: at the end, the
// ones inside a block are made in its copy, the others in the files.

static mut L_START: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut L_END: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut L_TEXT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut L_AT: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

fn later_edit(a: i64, b: i64, text: i64) {
    unsafe {
        // (one edit per position)
        if L_AT.get(a + 1) != 0 {
            return;
        }
        L_AT.put(a + 1, 1);
        L_START.push(a);
        L_END.push(b);
        L_TEXT.push(text);
    }
}

// Block k's text, with the edits inside it, ending with a newline.
fn block_text(k: i64) -> i64 {
    unsafe {
        let a = BL_START.data[k];
        let b = BL_END.data[k];
        let mut inner = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for e in 0..L_START.count {
            if L_START.data[e] >= a && L_END.data[e] <= b && !(L_START.data[e] == b && L_END.data[e] == b) {
                inner.push(e);
            }
        }
        // (by position)
        for i in 1..inner.count {
            let mut j = i;
            while j > 0 && L_START.data[inner.data[j]] < L_START.data[inner.data[j - 1]] {
                let t = inner.data[j];
                inner.data[j] = inner.data[j - 1];
                inner.data[j - 1] = t;
                j -= 1;
            }
        }
        let out = buf_new();
        let mut cur = a;
        for i in 0..inner.count {
            let e = inner.data[i];
            buf_bytes(out, SRC[cur..L_START.data[e]]);
            buf_bytes(out, buf_slice(L_TEXT.data[e]));
            cur = L_END.data[e];
        }
        buf_bytes(out, SRC[cur..b]);
        if BUFS[out].len > 0 && BUFS[out].data[BUFS[out].len - 1] != '\n' {
            buf_byte(out, '\n');
        }
        out
    }
}

fn in_block(pos: i64) -> bool {
    unsafe {
        for k in 0..BL_START.count {
            if BL_START.data[k] <= pos && pos < BL_END.data[k] {
                return true;
            }
        }
        false
    }
}

// ---- Imports ----

// The imports to add: region, definition, the name it is imported as.
static mut IM_REGION: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut IM_DEF: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut IM_NAME: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The `use` names removed (Ident node -> 1), and the Use nodes whose path
// becomes another (node -> text).
static mut DROPPED: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static mut DROP_USES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut REPATH: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
// The imports of a moved item to rewrite: Ident node, the path of its new
// module.
static mut MU_ID: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut MU_DEF: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut MU_PATH: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut REFUSED: bool = false;

// Name id of Use node u is removed.
pub fn remove_use_names(u: i64, id: i64) {
    unsafe {
        if DROPPED.get(id) != 0 {
            return;
        }
        DROPPED.put(id, 1);
        let mut seen = false;
        for i in 0..DROP_USES.count {
            if DROP_USES.data[i] == u {
                seen = true;
            }
        }
        if !seen {
            DROP_USES.push(u);
        }
    }
}

// The path definition d is imported from once the edit is made (its
// module's, or for a variant its enum's): `crate::a::b`.
fn import_path(out: i64, d: i64) {
    unsafe {
        let it = if DEFS[d].kind == K_VARIANT { DEFS[d].parent } else { d };
        let h = home(it);
        put_region_path(out, h);
        if it != d {
            buf_str(out, c"::");
            buf_bytes(out, SYMS[DEFS[it].name].text);
        }
    }
}

// The region an item is in after the edit.
fn home(d: i64) -> i64 {
    unsafe {
        if !user_pos(DEFS[d].start) {
            return module_at(DEFS[d].start);
        }
        region_at(DEFS[d].start)
    }
}

// Region r needs definition d under name `name` (`again`: its import
// there is removed).
fn need_import(r: i64, d: i64, name: i64) {
    add_import(r, d, name, false);
}

fn add_import(r: i64, d: i64, name: i64, again: bool) {
    unsafe {
        for i in 0..IM_REGION.count {
            if IM_REGION.data[i] == r && IM_NAME.data[i] == name {
                if IM_DEF.data[i] != d && !REFUSED {
                    REFUSED = true;
                    collision(SYMS[name].text, r, IM_DEF.data[i], true);
                }
                return;
            }
        }
        if !is_new(r) {
            // What the name is there now: d (nothing to do), something
            // else that stays (a collision), or what leaves.
            let ib = item_binding(r, name);
            let uid = crate::refactor_mod::use_binding_id(r, name);
            let ub = use_binding(r, name);
            if ib >= 0 && home(ib) == r {
                if ib != d && !REFUSED {
                    REFUSED = true;
                    collision(SYMS[name].text, r, ib, false);
                }
                return;
            }
            if ib < 0 && uid != 0 && DROPPED.get(uid) == 0 {
                if ub != d && !REFUSED {
                    REFUSED = true;
                    collision(SYMS[name].text, r, ub, true);
                }
                if ub != d || !again {
                    return;
                }
            }
        }
        // (an item moved there with that name)
        for i in 0..MV_DEF.count {
            let x = MV_DEF.data[i];
            if MV_DEST.data[i] == r && DEFS[x].name == name && x != d && !REFUSED {
                REFUSED = true;
                collision(SYMS[name].text, r, x, false);
                return;
            }
        }
        IM_REGION.push(r);
        IM_DEF.push(d);
        IM_NAME.push(name);
    }
}

// The `use` line text of the imports of region r with path p (a buffer):
// `use p::a;`, `use p::{a, b};` (wrapped at 100 columns), and a line of
// its own for each name imported under another name.
fn put_use_lines(out: i64, p: [u8], names: *IntVec, defs: *IntVec) {
    unsafe {
        let mut plain = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..(*names).count {
            let n = (*names).data[i];
            let d = (*defs).data[i];
            if n != DEFS[d].name {
                buf_str(out, c"use ");
                buf_bytes(out, p);
                buf_str(out, c"::");
                buf_bytes(out, SYMS[DEFS[d].name].text);
                buf_str(out, c" as ");
                buf_bytes(out, SYMS[n].text);
                buf_str(out, c";\n");
            } else {
                plain.push(n);
            }
        }
        if plain.count == 0 {
            return;
        }
        let line = buf_new();
        buf_str(line, c"use ");
        buf_bytes(line, p);
        buf_str(line, c"::");
        if plain.count == 1 {
            buf_bytes(line, SYMS[plain.data[0]].text);
            buf_str(line, c";\n");
            buf_bytes(out, buf_slice(line));
            return;
        }
        buf_byte(line, '{');
        for i in 0..plain.count {
            if i > 0 {
                buf_str(line, c", ");
            }
            buf_bytes(line, SYMS[plain.data[i]].text);
        }
        buf_str(line, c"};\n");
        if BUFS[line].len <= 101 {
            buf_bytes(out, buf_slice(line));
            return;
        }
        buf_str(out, c"use ");
        buf_bytes(out, p);
        buf_str(out, c"::{\n");
        let mut col = 0;
        for i in 0..plain.count {
            let w = SYMS[plain.data[i]].text;
            if col > 0 && col + 2 + w.len + 1 > 100 {
                buf_str(out, c",\n");
                col = 0;
            } else if col > 0 {
                buf_str(out, c", ");
                col += 2;
            }
            if col == 0 {
                buf_str(out, c"    ");
                col = 4;
            }
            buf_bytes(out, w);
            col += w.len;
        }
        buf_str(out, c",\n};\n");
    }
}

// The import lines of region r (sorted by path, then name).
fn region_uses(r: i64) -> i64 {
    unsafe {
        let mut idx = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut paths = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..IM_REGION.count {
            if IM_REGION.data[i] == r {
                idx.push(i);
                let b = buf_new();
                import_path(b, IM_DEF.data[i]);
                paths.push(intern(buf_slice(b)));
            }
        }
        // (by path, then name)
        for i in 1..idx.count {
            let mut j = i;
            while j > 0 && (sym_less(paths.data[j], paths.data[j - 1])
                || (paths.data[j] == paths.data[j - 1] && sym_less(IM_NAME.data[idx.data[j]], IM_NAME.data[idx.data[j - 1]]))) {
                let t = idx.data[j];
                idx.data[j] = idx.data[j - 1];
                idx.data[j - 1] = t;
                let s = paths.data[j];
                paths.data[j] = paths.data[j - 1];
                paths.data[j - 1] = s;
                j -= 1;
            }
        }
        let out = buf_new();
        let mut i = 0;
        while i < idx.count {
            let mut names = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            let mut defs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            let mut j = i;
            while j < idx.count && paths.data[j] == paths.data[i] {
                names.push(IM_NAME.data[idx.data[j]]);
                defs.push(IM_DEF.data[idx.data[j]]);
                j += 1;
            }
            put_use_lines(out, SYMS[paths.data[i]].text, &names, &defs);
            i = j;
        }
        out
    }
}

// ---- The analysis ----

// The references of the program, in turn: what each needs once the moves
// are made. False after a diagnostic.
fn analyze() -> bool {
    unsafe {
        let mut pubbed = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for k in 0..REFS.count {
            let r = REFS.data[k];
            let p = R_POS.data[r];
            let d = R_DEF.data[r];
            let flags = R_FLAGS.data[r];
            if (flags & QF_DEF) != 0 || !user_pos(p) {
                continue;
            }
            let kd = DEFS[d].kind;
            let mut it = d;
            if kd == K_VARIANT {
                it = DEFS[d].parent;
            } else if DEFS[d].parent >= 0 || kd == K_METHOD || kd == K_IMPL_METHOD {
                continue;
            }
            let old_home = module_at(DEFS[it].start);
            let new_home = home(it);
            let old_reg = module_at(p);
            let new_reg = region_at(p);
            let moved_item = old_home != new_home;
            let moved_code = old_reg != new_reg;
            if !moved_item && !moved_code {
                continue;
            }
            let ti = token_at(p);
            if ti >= TOK_COUNT || TOKS[ti].start != p || TOKS[ti].kind != Tok::Ident {
                continue;
            }
            let name = TOKS[ti].value as i64;
            let use_ref = (flags & QF_USE) != 0;
            // Visible from where it is used.
            let from = if use_ref { old_reg } else { new_reg };
            if user_pos(DEFS[it].start) && !DEFS[it].public && !within(from, new_home) && pubbed.get(it + 1) == 0 {
                pubbed.put(it + 1, 1);
                later_edit(DEFS[it].start, DEFS[it].start, text_of(c_slice(c"pub ")));
            }
            chain_public(from, new_home);
            if use_ref {
                if moved_item {
                    let id = use_id_at(p);
                    if id != 0 {
                        if old_reg == new_home && d == it && NODES[id].b == 0 {
                            remove_use_names(use_node_of(id), id);
                        } else {
                            MU_ID.push(id);
                            MU_DEF.push(d);
                            let b = buf_new();
                            import_path(b, d);
                            MU_PATH.push(b);
                        }
                    }
                }
                continue;
            }
            if qualified(p) {
                if moved_item && d == it {
                    let b = buf_new();
                    put_region_path(b, new_home);
                    buf_str(b, c"::");
                    later_edit(path_start(p), p, b);
                }
                continue;
            }
            let via_import = use_binding(old_reg, name) == d;
            let was_local = old_home == old_reg && d == it && name == DEFS[d].name && !via_import;
            if new_home == new_reg && d == it {
                continue;
            }
            if !moved_code {
                if was_local {
                    need_import(new_reg, d, name);
                }
                continue;
            }
            if via_import || was_local {
                need_import(new_reg, d, name);
            }
        }
        !REFUSED
    }
}

// The imports of moved items: a `use` whose names all move to one module
// gets that module's path; else the names leave it for `use` lines of
// their own.
fn rewrite_imports() {
    unsafe {
        for i in 0..MU_ID.count {
            let id = MU_ID.data[i];
            let u = use_node_of(id);
            if REPATH.get(u) != 0 || DROPPED.get(id) != 0 {
                continue;
            }
            // Every name of u moves, to one place?
            let mut all = true;
            for k in 0..NODES[u].count {
                let c = child(u, k);
                let mut found = false;
                for j in 0..MU_ID.count {
                    if MU_ID.data[j] == c && same_bytes_buf(MU_PATH.data[j], MU_PATH.data[i]) {
                        found = true;
                    }
                }
                if !found || DROPPED.get(c) != 0 {
                    all = false;
                }
            }
            if all {
                REPATH.put(u, MU_PATH.data[i]);
                continue;
            }
        }
        for i in 0..MU_ID.count {
            let id = MU_ID.data[i];
            let u = use_node_of(id);
            if REPATH.get(u) != 0 {
                continue;
            }
            remove_use_names(u, id);
            add_import(module_of(u), MU_DEF.data[i], crate::refactor_mod::use_local(id), true);
        }
    }
}

fn same_bytes_buf(a: i64, b: i64) -> bool {
    bytes_eq(buf_slice(a), buf_slice(b))
}

// The `super::` and `self::` paths of the moved code, written from `crate`.
fn moved_relative_paths() {
    unsafe {
        let sup = intern(c_slice(c"super"));
        let slf = intern(c_slice(c"self"));
        for k in 0..BL_START.count {
            let mut i = token_at(BL_START.data[k]);
            while i + 1 < TOK_COUNT && TOKS[i].start < BL_END.data[k] {
                let v = TOKS[i].value as i64;
                if TOKS[i].kind != Tok::Ident || (v != sup && v != slf) || TOKS[i + 1].kind != Tok::ColonColon
                    || (i > 0 && TOKS[i - 1].kind == Tok::ColonColon) {
                    i += 1;
                    continue;
                }
                let first = i;
                let mut m = module_at(TOKS[i].start);
                if v == slf {
                    i += 2;
                } else {
                    while i + 1 < TOK_COUNT && TOKS[i].kind == Tok::Ident && TOKS[i].value as i64 == sup
                        && TOKS[i + 1].kind == Tok::ColonColon {
                        m = crate::refactor_mod::region_parent(m);
                        i += 2;
                    }
                }
                if m < 0 {
                    continue;
                }
                let b = buf_new();
                buf_bytes(b, SYMS[mod_fqn(m)].text);
                buf_str(b, c"::");
                later_edit(TOKS[first].start, TOKS[i].start, b);
            }
        }
    }
}

// The imports of the modules the moved code leaves that nothing there
// names any more.
fn unused_imports() {
    unsafe {
        let mut files = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for k in 0..BL_START.count {
            let f = file_of_pos(BL_START.data[k]);
            let mut seen = false;
            for i in 0..files.count {
                if files.data[i] == f {
                    seen = true;
                }
            }
            if !seen {
                files.push(f);
            }
        }
        for u in 1..NODE_COUNT {
            if !crate::refactor_mod::is_name_use(u) || (NODES[u].p & crate::parser::ITEM_PUBLIC) != 0 {
                continue;
            }
            let f = file_of_pos(NODES[u].start);
            let mut mine = false;
            for i in 0..files.count {
                if files.data[i] == f {
                    mine = true;
                }
            }
            if !mine || in_block(NODES[u].start) {
                continue;
            }
            for k in 0..NODES[u].count {
                let id = child(u, k);
                let name = crate::refactor_mod::use_local(id);
                let mut before = 0;
                let mut after = 0;
                let mut i = token_at(FILES[f].start);
                while i < TOK_COUNT && TOKS[i].start < FILES[f].end {
                    let s = TOKS[i].start;
                    if TOKS[i].kind == Tok::Ident && TOKS[i].value as i64 == name && (s < NODES[u].start || s >= NODES[u].end) {
                        before += 1;
                        if !in_block(s) {
                            after += 1;
                        }
                    }
                    i += 1;
                }
                if before > 0 && after == 0 {
                    remove_use_names(u, id);
                }
            }
        }
    }
}

// Whether only blanks are before pos on its line, and after end (or a
// comment).
fn alone_on_lines(pos: i64, end: i64) -> bool {
    unsafe {
        let mut p = line_start(pos);
        while p < pos && (SRC[p] == ' ' || SRC[p] == '\t') {
            p += 1;
        }
        if p != pos {
            return false;
        }
        let e = line_end(end);
        let mut q = end;
        while q < e && (SRC[q] == ' ' || SRC[q] == '\t' || SRC[q] == '\r') {
            q += 1;
        }
        q == e || (q + 1 < e && SRC[q] == '/' && SRC[q + 1] == '/')
    }
}

// The edits of the `use` items: the names removed, the paths rewritten.
pub fn emit_use_edits() {
    unsafe {
        for i in 0..DROP_USES.count {
            let u = DROP_USES.data[i];
            let n = NODES[u].count;
            let mut gone = 0;
            for k in 0..n {
                if DROPPED.get(child(u, k)) != 0 {
                    gone += 1;
                }
            }
            if gone == n {
                let head = node_head(NODES[u].start);
                if alone_on_lines(head, NODES[u].end) {
                    delete_lines(line_start(head), NODES[u].end);
                } else {
                    put_edit(head, NODES[u].end, buf_new());
                }
                continue;
            }
            // (each name with what follows it up to the next; the last ones
            // from the end of the one before)
            let mut last_kept = -1;
            for k in 0..n {
                if DROPPED.get(child(u, k)) == 0 {
                    last_kept = k;
                }
            }
            if n - gone == 1 && crate::refactor_mod::braced(u) && line_start(NODES[u].start) == line_start(NODES[u].end) {
                // (one name left: `use p::{a};` is `use p::a;`)
                let mut open = NODES[NODES[u].c].end;
                while SRC[open] != '{' {
                    open += 1;
                }
                let mut close = NODES[u].end;
                while SRC[close] != '}' {
                    close -= 1;
                }
                let kept = child(u, last_kept);
                put_edit(open, close + 1, text_of(SRC[NODES[kept].start..NODES[kept].end]));
                continue;
            }
            for k in 0..n {
                if DROPPED.get(child(u, k)) == 0 {
                    continue;
                }
                if k < last_kept {
                    put_edit(NODES[child(u, k)].start, NODES[child(u, k + 1)].start, buf_new());
                } else {
                    put_edit(NODES[child(u, last_kept)].end, NODES[child(u, n - 1)].end, buf_new());
                    break;
                }
            }
        }
        for u in 1..NODE_COUNT {
            let t = REPATH.get(u);
            if t != 0 && NODES[u].kind == NodeKind::Use {
                put_edit(NODES[NODES[u].c].start, NODES[NODES[u].c].end, t);
            }
        }
    }
}

// Where imports go in module m's file: after its last `use` that stays
// (true), or before its first unit that stays.
fn import_anchor(m: i64, after: *bool) -> i64 {
    unsafe {
        let f = own_file(m);
        let mut last = -1;
        for u in 1..NODE_COUNT {
            if NODES[u].kind != NodeKind::Use || module_of(u) != m || file_of_pos(NODES[u].start) != f {
                continue;
            }
            let mut gone = 0;
            for k in 0..NODES[u].count {
                if DROPPED.get(child(u, k)) != 0 {
                    gone += 1;
                }
            }
            if NODES[u].count > 0 && gone == NODES[u].count {
                continue;
            }
            if last < 0 || NODES[u].start > NODES[last].start {
                last = u;
            }
        }
        if last >= 0 {
            *after = true;
            return line_end(NODES[last].end - 1);
        }
        *after = false;
        units_of(f);
        for u in 0..UN_START.count {
            if UN_FILE.data[u] == f && !in_block(UN_START.data[u]) {
                return if UN_BANNER.data[u] >= 0 { UN_BANNER.data[u] } else { UN_START.data[u] };
            }
        }
        FILES[f].end
    }
}

// ---- The edit ----

// Makes the moves of MV_DEF / MV_DEST (the references collected): false
// after a diagnostic.
pub fn move_edits() -> bool {
    unsafe {
        // Names taken where the items go.
        for i in 0..MV_DEF.count {
            let d = MV_DEF.data[i];
            let r = MV_DEST.data[i];
            for j in 0..i {
                if MV_DEST.data[j] == r && DEFS[MV_DEF.data[j]].name == DEFS[d].name {
                    collision(SYMS[DEFS[d].name].text, r, MV_DEF.data[j], false);
                    return false;
                }
            }
            if !is_new(r) {
                let b = binding_of(r, DEFS[d].name);
                if b >= 0 && b != d {
                    collision(SYMS[DEFS[d].name].text, r, b, item_binding(r, DEFS[d].name) < 0);
                    return false;
                }
            }
        }
        if !make_blocks() {
            return false;
        }
        if !analyze() {
            return false;
        }
        rewrite_imports();
        if REFUSED {
            return false;
        }
        moved_relative_paths();
        unused_imports();
        // The moved text, from where it was.
        let mut texts = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for k in 0..BL_START.count {
            texts.push(block_text(k));
        }
        let mut k = 0;
        while k < BL_START.count {
            // (blocks with only blank lines between: one deletion)
            let mut j = k;
            while j + 1 < BL_START.count && file_of_pos(BL_START.data[j + 1]) == file_of_pos(BL_START.data[k])
                && only_blank(BL_END.data[j], BL_START.data[j + 1]) {
                j += 1;
            }
            delete_lines(BL_START.data[k], BL_END.data[j]);
            k = j + 1;
        }
        // The other edits.
        for e in 0..L_START.count {
            if !in_block(L_START.data[e]) {
                put_edit(L_START.data[e], L_END.data[e], L_TEXT.data[e]);
            }
        }
        emit_use_edits();
        // The imports, where they go.
        let mut regions = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..IM_REGION.count {
            push_once(&regions, IM_REGION.data[i]);
        }
        for i in 0..regions.count {
            let r = regions.data[i];
            let lines = region_uses(r);
            if is_new(r) {
                buf_bytes(NM_USES.data[r - module_count()], buf_slice(lines));
                continue;
            }
            let mut after = false;
            let at = import_anchor(r, &after);
            let text = buf_new();
            if after {
                buf_byte(text, '\n');
                let s = buf_slice(lines);
                buf_bytes(text, s[0..s.len - 1]);
            } else {
                buf_bytes(text, buf_slice(lines));
                if at < FILES[own_file(r)].end {
                    buf_byte(text, '\n');
                }
            }
            put_edit(at, at, text);
        }
        // The moved text, where it goes.
        let mut dests = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for k in 0..BL_START.count {
            push_once(&dests, BL_DEST.data[k]);
        }
        for i in 0..dests.count {
            let r = dests.data[i];
            let body = buf_new();
            let mut k = 0;
            while k < BL_START.count {
                if BL_DEST.data[k] != r {
                    k += 1;
                    continue;
                }
                if BUFS[body].len > 0 {
                    buf_byte(body, '\n');
                }
                let x = BL_WRAP.data[k];
                if x < 0 {
                    buf_bytes(body, buf_slice(texts.data[k]));
                    k += 1;
                    continue;
                }
                // Functions of an extern block: in one like it.
                let t = UN_FIRST.data[x];
                let mut lb = t;
                while TOKS[lb].kind != Tok::LBrace {
                    lb += 1;
                }
                buf_bytes(body, SRC[TOKS[t].start..TOKS[lb].end]);
                buf_byte(body, '\n');
                while k < BL_START.count && BL_DEST.data[k] == r && BL_WRAP.data[k] == x {
                    buf_bytes(body, buf_slice(texts.data[k]));
                    k += 1;
                }
                buf_str(body, c"}\n");
            }
            if is_new(r) {
                buf_bytes(NM_BODY.data[r - module_count()], buf_slice(body));
                continue;
            }
            let f = own_file(r);
            let end = FILES[f].end;
            let text = buf_new();
            if end > FILES[f].start && SRC[end - 1] != '\n' {
                buf_str(text, c"\n\n");
            } else if end > FILES[f].start && !(end - 1 > FILES[f].start && SRC[end - 2] == '\n') {
                buf_byte(text, '\n');
            }
            buf_bytes(text, buf_slice(body));
            put_edit(end, end, text);
        }
        true
    }
}

fn push_once(v: *IntVec, x: i64) {
    unsafe {
        for i in 0..(*v).count {
            if (*v).data[i] == x {
                return;
            }
        }
        v.push(x);
    }
}

fn only_blank(a: i64, b: i64) -> bool {
    unsafe {
        for p in a..b {
            if SRC[p] != ' ' && SRC[p] != '\t' && SRC[p] != '\n' && SRC[p] != '\r' {
                return false;
            }
        }
        true
    }
}

// ---- move ----

// `refactor move PATH... --to MODULE`.
pub fn run_move(words: *IntVec, to: *u8, root: *u8) -> i64 {
    unsafe {
        let t = module_named(c_slice(to));
        if t < 0 {
            return no_module(c_slice(to), c"new-module");
        }
        if own_file(t) < 0 {
            return inline_module(t);
        }
        load_refs();
        for i in 0..(*words).count {
            let name = c_slice((*words).data[i] as *u8);
            let d = one_definition(c"move", name, c_slice(c""));
            if d < 0 || !movable(d) {
                return 1;
            }
            if DEFS[d].module == t {
                continue;
            }
            MV_DEF.push(d);
            MV_DEST.push(t);
        }
        if MV_DEF.count == 0 {
            let e = diag(c"note", c"edit.unchanged");
            buf_str(e, c"nothing to change\n");
            return 0;
        }
        if !move_edits() {
            return 1;
        }
        emit_regions();
        let what = buf_new();
        buf_str(what, c"moved ");
        if MV_DEF.count == 1 {
            buf_bytes(what, SYMS[DEFS[MV_DEF.data[0]].fqn].text);
        } else {
            buf_int(what, MV_DEF.count);
            buf_str(what, c" items");
        }
        buf_str(what, c" to ");
        buf_bytes(what, SYMS[mod_fqn(t)].text);
        finish(what, root)
    }
}

// ---- split ----

// `refactor split MODULE --into NEWMOD --items a,b,c`: the items move to
// NEWMOD (made when it does not exist: a child of MODULE makes MODULE a
// dir module). `--plan`: the split of MODULE into parts of at most
// --max-lines lines (query deps's clustering, on its items with their impl
// blocks), as the commands that make it; `--auto`: that split, made in one
// edit.
pub fn run_split(name: [u8], root: *u8) -> i64 {
    unsafe {
        let m = module_named(name);
        if m < 0 {
            return no_module(name, 0 as *u8);
        }
        let f = own_file(m);
        if f < 0 {
            return inline_module(m);
        }
        load_refs();
        units_of(f);
        if OPT_PLAN || OPT_AUTO {
            return split_plan(m, f, root);
        }
        let mut segs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let into = c_slice(OPT_INTO);
        if !path_segments(into, &segs) || segs.count == 0 {
            return crate::refactor_mod::usage(c"--into takes a module path (crate::a::b)", 0 as *u8);
        }
        let mut converts = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        let mut t = make_path(&segs, segs.count, false, &converts);
        if t == -2 {
            t = module_named(into);
        }
        if t < 0 {
            return 1;
        }
        if !is_new(t) && own_file(t) < 0 {
            return inline_module(t);
        }
        // The items, by their names in MODULE (or their paths).
        let items = c_slice(OPT_ITEMS);
        let mut i = 0;
        while i < items.len {
            let mut e = i;
            while e < items.len && items[e] != ',' {
                e += 1;
            }
            let w = items[i..e];
            i = e + 1;
            if w.len == 0 {
                continue;
            }
            let full = buf_new();
            if !has_colons(w) {
                buf_bytes(full, SYMS[mod_fqn(m)].text);
                buf_str(full, c"::");
            }
            buf_bytes(full, w);
            let d = one_definition(c"move", buf_slice(full), c_slice(c""));
            if d < 0 || !movable(d) {
                return 1;
            }
            MV_DEF.push(d);
            MV_DEST.push(t);
        }
        if MV_DEF.count == 0 {
            return crate::refactor_mod::usage(c"--items names no item", 0 as *u8);
        }
        if !move_edits() {
            return 1;
        }
        emit_regions();
        let what = buf_new();
        buf_str(what, c"split ");
        buf_bytes(what, SYMS[mod_fqn(m)].text);
        buf_str(what, c": ");
        buf_int(what, MV_DEF.count);
        buf_str(what, if MV_DEF.count == 1 { c" item into " } else { c" items into " });
        buf_bytes(what, into);
        finish(what, root)
    }
}

fn has_colons(s: [u8]) -> bool {
    for i in 0..s.len {
        if s[i] == ':' {
            return true;
        }
    }
    false
}

// The lines of SRC[a..b).
fn lines_of(a: i64, b: i64) -> i64 {
    unsafe {
        let mut n = 0;
        for p in a..b {
            if SRC[p] == '\n' {
                n += 1;
            }
        }
        n
    }
}

// The split of module m (file f) into parts: printed as commands
// (--plan), or made (--auto).
fn split_plan(m: i64, f: i64, root: *u8) -> i64 {
    unsafe {
        let total = lines_of(FILES[f].start, FILES[f].end);
        let max = OPT_MAX_LINES;
        if total <= max {
            let e = diag(c"note", c"refactor.fits");
            buf_bytes(e, SYMS[mod_fqn(m)].text);
            buf_str(e, c" has ");
            buf_int(e, total);
            buf_str(e, c" lines (at most ");
            buf_int(e, max);
            buf_str(e, c"); nothing to split\n");
            return 0;
        }
        // The items that can move (an impl block counts with its type, or
        // its trait), their lines; what stays (the rest) and its lines.
        let mut items = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let owner = alloc_array::<i64>(UN_START.count + 1);
        for u in 0..UN_START.count {
            owner[u] = -1;
            if UN_FILE.data[u] == f && UN_KIND.data[u] == U_ITEM && DEFS[UN_DEF.data[u]].kind != K_MOD {
                owner[u] = items.count;
                items.push(u);
            }
        }
        let n = items.count;
        let lines = alloc_array::<i64>(n + 1);
        let mut pinned = total;
        for u in 0..UN_START.count {
            if UN_FILE.data[u] != f {
                continue;
            }
            if UN_KIND.data[u] == U_IMPL {
                let ty = UN_DEF.data[u];
                let tr = UN_TRAIT.data[u];
                let tu = if ty >= 0 { UNIT_OF.get(ty + 1) - 1 } else if tr >= 0 { UNIT_OF.get(tr + 1) - 1 } else { -1 };
                if tu >= 0 && owner[tu] >= 0 {
                    owner[u] = owner[tu];
                }
            }
            if owner[u] >= 0 {
                let l = lines_of(UN_START.data[u], UN_END.data[u]);
                lines[owner[u]] += l;
                pinned -= l;
            }
        }
        // The references between items, and from other modules.
        let weight = alloc_array::<i64>(n * n + 1);
        let outside = alloc_array::<i64>(n + 1);
        for k in 0..REFS.count {
            let r = REFS.data[k];
            if (R_FLAGS.data[r] & QF_DEF) != 0 {
                continue;
            }
            let tu = unit_at(DEFS[R_DEF.data[r]].start);
            if tu < 0 || owner[tu] < 0 {
                continue;
            }
            let t = owner[tu];
            let p = R_POS.data[r];
            if file_of_pos(p) != f {
                if module_at(p) != m {
                    outside[t] += 1;
                }
                continue;
            }
            let su = unit_at(p);
            if su >= 0 && owner[su] >= 0 && owner[su] != t {
                weight[owner[su] * n + t] += 1;
            }
        }
        let mut budget = max - pinned - 20;
        if budget < max / 2 {
            budget = max / 2;
        }
        let group = alloc_array::<i64>(n + 1);
        let size = alloc_array::<i64>(n + 1);
        cluster(weight, lines, n, budget, group, size);
        // The parts, largest first; the one most used from outside stays.
        let mut parts = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for g in 0..n {
            if size[g] >= 0 {
                let mut k = parts.count;
                parts.push(g);
                while k > 0 && size[parts.data[k - 1]] < size[g] {
                    parts.data[k] = parts.data[k - 1];
                    k -= 1;
                }
                parts.data[k] = g;
            }
        }
        let mut stay = -1;
        let mut best = -1;
        for k in 0..parts.count {
            let g = parts.data[k];
            let mut o = 0;
            for i in 0..n {
                if group[i] == g {
                    o += outside[i];
                }
            }
            if o > best {
                best = o;
                stay = g;
            }
        }
        // Their names.
        let mut names = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for k in 0..parts.count {
            let g = parts.data[k];
            names.push(if g == stay { -1 } else { part_name(m, g, group, &items, n, &names, k) });
        }
        if OPT_PLAN {
            let out = buf_new();
            buf_str(out, c"# ");
            buf_bytes(out, SYMS[mod_fqn(m)].text);
            buf_byte(out, '\t');
            buf_int(out, total);
            buf_str(out, c" lines\t");
            buf_int(out, parts.count);
            buf_str(out, c" parts of at most ");
            buf_int(out, max);
            buf_str(out, c" lines\n");
            for k in 0..parts.count {
                let g = parts.data[k];
                if g == stay {
                    continue;
                }
                put_cword(out, PROG);
                buf_str(out, c" refactor split ");
                buf_bytes(out, SYMS[mod_fqn(m)].text);
                buf_str(out, c" --into ");
                buf_bytes(out, SYMS[mod_fqn(m)].text);
                buf_str(out, c"::");
                buf_bytes(out, SYMS[names.data[k]].text);
                buf_str(out, c" --items ");
                let mut first = true;
                for i in 0..n {
                    if group[i] != g {
                        continue;
                    }
                    if !first {
                        buf_byte(out, ',');
                    }
                    first = false;
                    buf_bytes(out, SYMS[DEFS[UN_DEF.data[items.data[i]]].name].text);
                }
                if ROOT_GIVEN != 0 as *u8 {
                    crate::query::put_root(out);
                }
                buf_byte(out, '\n');
            }
            // (the out buffer starts with a space before each command)
            buf_write_fd(trim_lines(out), STDOUT);
            let e = diag(c"note", c"refactor.plan");
            buf_str(e, c"the same in one edit: --auto\n");
            let t = try_begin(c"split", SYMS[mod_fqn(m)].text, true);
            buf_str(t, c" --auto --max-lines ");
            buf_int(t, max);
            try_end(t);
            return 0;
        }
        // --auto: the parts, made.
        let mut converts = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        let mut made = 0;
        for k in 0..parts.count {
            let g = parts.data[k];
            if g == stay {
                continue;
            }
            let r = make_module(m, names.data[k], false, &converts);
            if r < 0 {
                return 1;
            }
            made += 1;
            for i in 0..n {
                if group[i] == g {
                    MV_DEF.push(UN_DEF.data[items.data[i]]);
                    MV_DEST.push(r);
                }
            }
        }
        if !move_edits() {
            return 1;
        }
        emit_regions();
        let what = buf_new();
        buf_str(what, c"split ");
        buf_bytes(what, SYMS[mod_fqn(m)].text);
        buf_str(what, c" into ");
        buf_int(what, made);
        buf_str(what, if made == 1 { c" module" } else { c" modules" });
        finish(what, root)
    }
}

// The lines of buffer b without the space put_cword puts first.
fn trim_lines(b: i64) -> i64 {
    unsafe {
        let s = buf_slice(b);
        let out = buf_new();
        let mut i = 0;
        let mut start = true;
        while i < s.len {
            if !(start && s[i] == ' ') {
                buf_byte(out, s[i]);
            }
            start = s[i] == '\n';
            i += 1;
        }
        out
    }
}

// A name for part g of module m (the k-th part): the word of its items'
// names that is the most its own (weighted by their lines, against the
// other parts'), not a name of m nor of a part before; `partK` else.
fn part_name(m: i64, g: i64, group: *i64, items: *IntVec, n: i64, taken: *IntVec, k: i64) -> i64 {
    unsafe {
        let mut mine = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        let mut theirs = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        let mut words = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..n {
            let u = (*items).data[i];
            let d = UN_DEF.data[u];
            let l = 1000 + lines_of(UN_START.data[u], UN_END.data[u]);
            let s = SYMS[DEFS[d].name].text;
            let mut a = 0;
            while a < s.len {
                // (words: between underscores and at capitals)
                let mut e = a + 1;
                while e < s.len && s[e] != '_' && !(s[e] >= 'A' && s[e] <= 'Z' && s[e - 1] >= 'a' && s[e - 1] <= 'z') {
                    e += 1;
                }
                let b = buf_new();
                for x in a..e {
                    let c = s[x];
                    if c != '_' {
                        buf_byte(b, if c >= 'A' && c <= 'Z' { c + 32 } else { c });
                    }
                }
                if BUFS[b].len >= 3 {
                    let w = intern(buf_slice(b));
                    if group[i] == g {
                        if mine.get(w + 1) == 0 {
                            words.push(w);
                        }
                        mine.put(w + 1, mine.get(w + 1) + l);
                    } else {
                        theirs.put(w + 1, theirs.get(w + 1) + l);
                    }
                }
                a = e;
                while a < s.len && s[a] == '_' {
                    a += 1;
                }
            }
        }
        let mut best = -1;
        let mut best_score = 0;
        for i in 0..words.count {
            let w = words.data[i];
            let text = SYMS[w].text;
            if !is_ident(text) || item_binding(m, w) >= 0 || child_module(m, w) >= 0 || stop_word(text) {
                continue;
            }
            let mut used = false;
            for j in 0..(*taken).count {
                if (*taken).data[j] == w {
                    used = true;
                }
            }
            if used {
                continue;
            }
            // (how much it is here, times how much it is only here)
            let score = mine.get(w + 1) * mine.get(w + 1) / (mine.get(w + 1) + 2 * theirs.get(w + 1) + 1);
            if best < 0 || score > best_score || (score == best_score && sym_less(w, best)) {
                best = w;
                best_score = score;
            }
        }
        if best >= 0 {
            return best;
        }
        let b = buf_new();
        buf_str(b, c"part");
        buf_int(b, k + 1);
        intern(buf_slice(b))
    }
}

fn stop_word(w: [u8]) -> bool {
    unsafe {
        let words = c_slice(c" the and for from with into get put set new run add has the all one two is_ ");
        let mut i = 1;
        while i < words.len {
            let mut e = i;
            while e < words.len && words[e] != ' ' {
                e += 1;
            }
            if bytes_eq(words[i..e], w) {
                return true;
            }
            i = e + 1;
        }
        false
    }
}
