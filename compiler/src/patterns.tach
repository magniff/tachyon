// Patterns: their type checking (bindings, constants, literals, ranges,
// tuples, variants and or-patterns), refutability, the type of `match`, and
// the exhaustiveness and reachability of its arms by usefulness (Maranget,
// "Warnings for pattern matching", JFP 2007).
//
// Resolutions recorded on pattern nodes:
//   NodeKind::PatBind     x = the local
//   NodeKind::PatLit      x = the value (canonical for the type; a bool is 0 or 1)
//   NodeKind::PatRange    x = the low value, y = the high value
//   NodeKind::PatVariant  x = the variant (VARIANTS)

// Or-patterns: the alternatives after the first bind the locals of the
// first (OR_FIRST..OR_END in ENV) instead of new ones.
use std::Option;
use crate::base::{
    ERR, ERR_HELP, IntVec, buf_byte, buf_int, buf_str, buf_uint, err_begin, err_end, err_help,
    err_help_sym, err_int, err_str, err_sym, free, sym_name,
};
use crate::ast::{
    ARM_NO_ELSE, ARM_SYNTHETIC, NODES, child, list_begin, list_end, list_push, new_node,
};
use crate::modules::{
    B_ITEM, B_PRIVATE, CUR_MOD, access_error, binding_kind, binding_value, lookup_commit,
    lookup_name, note_c_use, note_pattern_pos, path_module,
};
use crate::types::{
    CONSTS, ENUMS, SYM_PRIMITIVE, TYPES, TY_BOOL, TY_NEVER, TY_UNIT, TyKind, VARIANTS, buf_type,
    enum_type, enum_variant, err_type, find_variant, int_max, is_fieldless_enum, is_float,
    is_integer, is_signed, type_elem, variant_field,
};
use crate::check::{
    ENV, LOCALS, SELF_TYPE, SELF_TYPE_SYM, check_expr, check_wrapped, define_local, lookup_local, mismatch_error,
    name_error, pop_scope, push_scope, resolve_key, resolve_named, scope_const, synth_expr,
    type_error, type_error_got, unknown_name_error, used_variant_enum,
};
use crate::consteval::{check_const_expr, const_eval, const_less, const_value, wrap_int};
use crate::generics::{TPL_NONE, env_lookup, instance_of, template_of_key};
use crate::ast::NodeKind::{Ident, PatBind, PatLit, PatOr, PatRange, PatTuple, PatVariant, PatWild};

pub static mut OR_MODE: bool = false;
static mut OR_FIRST: i64 = 0;
static mut OR_END: i64 = 0;
// Where the locals of the pattern being checked start in ENV.
static mut PATTERN_START: i64 = 0;

pub fn check_pattern(p: i64, ty: i64) {
    PATTERN_START = ENV.count;
    check_pat(p, ty);
}

fn check_pat(p: i64, ty: i64) {
    unsafe {
        let kind = NODES[p].kind;
        NODES[p].ty = ty;
        if kind == PatWild {
            return;
        }
        if kind == PatBind && NODES[p].b == 0 && scope_const(NODES[p].a) == 0
            && lookup_local(NODES[p].a).is_none() && used_variant_enum(NODES[p].a, ty, p) != 0 {
            // A variant brought into scope by `use` (0.4) or the prelude (0.6).
            lookup_commit(NODES[p].a, NODES[p].start);
            NODES[p].y = used_variant_enum(NODES[p].a, ty, p);
            NODES[p].kind = PatVariant;
            NODES[p].b = NODES[p].a;
            NODES[p].c = 0;
            check_pat(p, ty);
            return;
        }
        if kind == PatVariant && NODES[p].d == 1 {
            // `V(p, ...)`: a variant by its own name, from `use`.
            let t = used_variant_enum(NODES[p].b, ty, p);
            if t == 0 {
                name_error(NODES[p].start, c"unknown variant '", NODES[p].b, c"' (write 'Enum::Variant', or bring it into scope with 'use Enum::Variant;')");
            }
            lookup_commit(NODES[p].b, NODES[p].start);
            NODES[p].y = t;
            NODES[p].d = 0;
            check_pat(p, ty);
            return;
        }
        if kind == PatRange && NODES[NODES[p].a].kind == PatVariant {
            variant_range(p, ty);
            return;
        }
        if kind == PatBind && NODES[p].b == 0 && scope_const(NODES[p].a) != 0
            && lookup_local(NODES[p].a).is_none() && is_fieldless_enum(CONSTS[scope_const(NODES[p].a) - 1].ty) {
            // A constant of a fieldless enum: its variant's pattern.
            note_pattern_pos(NODES[p].start);
            lookup_commit(NODES[p].a, NODES[p].start);
            let c = scope_const(NODES[p].a) - 1;
            let e = TYPES[CONSTS[c].ty].a;
            let value = const_value(c);
            for i in 0..ENUMS[e].variant_count {
                let v = enum_variant(e, i);
                if wrap_int(VARIANTS[v].discr, ENUMS[e].tag) == value {
                    NODES[p].kind = PatVariant;
                    NODES[p].y = enum_type(e);
                    NODES[p].b = VARIANTS[v].name;
                    NODES[p].c = 0;
                }
            }
            check_pat(p, ty);
            return;
        }
        if kind == PatBind {
            let name = NODES[p].a;
            if scope_const(name) != 0 && NODES[p].b == 0 && lookup_local(name).is_none() {
                // A constant's name: a literal pattern.
                note_pattern_pos(NODES[p].start);
                let e = new_node(Ident, NODES[p].start, NODES[p].end);
                NODES[e].a = name;
                NODES[p].kind = PatLit;
                NODES[p].a = e;
                check_pat(p, ty);
                return;
            }
            if OR_MODE {
                NODES[p].x = or_rebind(p, name, ty);
                return;
            }
            for i in PATTERN_START..ENV.count {
                if LOCALS[ENV.data[i]].name == name {
                    name_error(NODES[p].start, c"identifier '", name, c"' is bound more than once in the same pattern");
                }
            }
            NODES[p].x = define_local(name, ty, NODES[p].b != 0, false);
            return;
        }
        if kind == PatOr {
            check_or_pattern(p, ty);
            return;
        }
        if ty == TY_NEVER {
            for i in 0..NODES[p].count {
                check_pat(child(p, i), TY_NEVER);
            }
            return;
        }
        match kind {
            PatTuple => {
                let count = NODES[p].count;
                if ty == TY_UNIT && count == 0 {
                    return;
                }
                if TYPES[ty].kind != TyKind::Tuple || TYPES[ty].count != count {
                    err_begin(NODES[p].start);
                    err_str(c"a tuple pattern with ");
                    err_int(count);
                    err_str(c" elements cannot bind a value of type '");
                    err_type(ty);
                    err_str(c"'");
                    err_end();
                }
                for i in 0..count {
                    check_pat(child(p, i), type_elem(ty, i));
                }
            }
            PatLit => {
                check_literal_type(p, ty, c"a literal pattern");
                let e = NODES[p].a;
                check_const_expr(e, ty);
                NODES[p].x = const_eval(e);
            }
            PatRange => {
                check_literal_type(p, ty, c"a range pattern");
                if ty == TY_BOOL {
                    type_error(p, c"range patterns need an integer type, not 'bool'");
                }
                check_const_expr(NODES[p].a, ty);
                check_const_expr(NODES[p].b, ty);
                NODES[p].x = const_eval(NODES[p].a);
                NODES[p].y = const_eval(NODES[p].b);
                if const_less(NODES[p].y, NODES[p].x, ty) {
                    type_error(p, c"the range pattern is empty (its start is above its end)");
                }
            }
            _ => check_variant_pattern(p, ty),
        }
    }
}

// `E::A..=E::C` (0.4): the variants from A to C in declaration order, as
// an or-pattern.
fn variant_range(p: i64, ty: i64) {
    unsafe {
        let lo = NODES[p].a;
        let hi = NODES[p].b;
        let t = pattern_enum_type(lo, ty);
        if TYPES[t].kind != TyKind::Enum || pattern_enum_type(hi, ty) != t {
            type_error(p, c"a variant range needs two variants of the same enum");
        }
        let e = TYPES[t].a;
        let first = find_variant(e, NODES[lo].b);
        let last = find_variant(e, NODES[hi].b);
        if first < 0 || last < 0 {
            type_error(p, c"unknown variant in a variant range");
        }
        if last < first {
            type_error(p, c"the variant range is empty (its first variant is declared after its last)");
        }
        let mark = list_begin();
        for v in first..last + 1 {
            if VARIANTS[v].field_count > 0 {
                name_error(NODES[p].start, c"variant ranges are for variants without fields; '", VARIANTS[v].name, c"' has fields");
            }
            let alt = new_node(PatVariant, NODES[p].start, NODES[p].end);
            NODES[alt].y = t;
            NODES[alt].b = VARIANTS[v].name;
            list_push(alt);
        }
        list_end(p, mark);
        NODES[p].kind = PatOr;
        check_pat(p, ty);
    }
}

fn check_literal_type(p: i64, ty: i64, what: *u8) {
    unsafe {
        if is_float(ty) {
            err_begin(NODES[p].start);
            err_str(what);
            err_str(c" cannot match a float");
            err_help(c"compare with '==' in a guard: 'x if x == 1.5 =>'");
            err_end();
        }
        if !(is_integer(ty) || ty == TY_BOOL) {
            err_begin(NODES[p].start);
            err_str(what);
            err_str(c" cannot match a value of type '");
            err_type(ty);
            err_str(c"'");
            err_end();
        }
    }
}

// The type a variant pattern's enum name stands for: through its module
// path (h); a generic enum written without arguments stands for the
// instance being matched.
fn pattern_enum_type(p: i64, ty: i64) -> i64 {
    unsafe {
        if NODES[p].y != 0 {
            return NODES[p].y;
        }
        let name = NODES[p].a;
        if NODES[p].h == 0 && (env_lookup(name) != 0 || SYM_PRIMITIVE[name] != 0 || (name == SELF_TYPE_SYM && SELF_TYPE != 0)) {
            return resolve_named(name, NODES[p].start);
        }
        let m = if NODES[p].h != 0 { path_module(NODES[p].h, NODES[NODES[p].h].count) } else { CUR_MOD };
        let b = lookup_name(m, name, CUR_MOD);
        if NODES[p].h == 0 {
            note_c_use(NODES[p].start, name, b);
        }
        if binding_kind(b) == B_PRIVATE {
            access_error(b, NODES[p].start, name);
        }
        if binding_kind(b) != B_ITEM {
            unknown_name_error(NODES[p].start, c"unknown type '", name);
        }
        let key = binding_value(b);
        let tpl = template_of_key(key);
        if tpl != TPL_NONE {
            if instance_of(ty, tpl) {
                return ty;
            }
            err_begin(NODES[p].start);
            err_str(c"expected '");
            err_type(ty);
            err_str(c"', got a pattern of '");
            err_sym(name);
            err_str(c"'");
            err_end();
        }
        resolve_key(key, name, NODES[p].start)
    }
}

fn check_variant_pattern(p: i64, ty: i64) {
    unsafe {
        let t = pattern_enum_type(p, ty);
        if TYPES[t].kind != TyKind::Enum {
            err_begin(NODES[p].start);
            err_str(c"'");
            err_type(t);
            err_str(c"' is not an enum");
            err_end();
        }
        if t != ty {
            mismatch_error(p, ty, t);
        }
        let v = find_variant(TYPES[t].a, NODES[p].b);
        if v < 0 {
            err_begin(NODES[p].start);
            err_str(c"no variant '");
            err_sym(NODES[p].b);
            err_str(c"' in enum '");
            err_type(t);
            err_str(c"'");
            err_end();
        }
        let count = VARIANTS[v].field_count;
        if NODES[p].c == 0 && count > 0 {
            err_begin(NODES[p].start);
            err_str(c"variant '");
            err_type(t);
            err_str(c"::");
            err_sym(NODES[p].b);
            err_str(c"' has ");
            err_int(count);
            err_str(if count == 1 { c" field" } else { c" fields" });
            err_help(c"match them: '");
            buf_type(ERR_HELP, t);
            err_help(c"::");
            err_help_sym(NODES[p].b);
            err_help(c"(_");
            for _ in 1..count {
                err_help(c", _");
            }
            err_help(c")'");
            err_end();
        }
        if NODES[p].c != 0 && NODES[p].count != count {
            err_begin(NODES[p].start);
            err_str(c"variant '");
            err_type(t);
            err_str(c"::");
            err_sym(NODES[p].b);
            err_str(c"' has ");
            err_int(count);
            err_str(if count == 1 { c" field" } else { c" fields" });
            err_str(c", the pattern has ");
            err_int(NODES[p].count);
            err_end();
        }
        NODES[p].x = v;
        for i in 0..count {
            check_pat(child(p, i), variant_field(v, i));
        }
    }
}

fn check_or_pattern(p: i64, ty: i64) {
    let first = ENV.count;
    check_pat(child(p, 0), ty);
    let saved_mode = OR_MODE;
    let saved_first = OR_FIRST;
    let saved_end = OR_END;
    if !OR_MODE {
        OR_FIRST = first;
        OR_END = ENV.count;
    }
    OR_MODE = true;
    let bound = binding_count(child(p, 0));
    unsafe {
        for i in 1..NODES[p].count {
            let alt = child(p, i);
            check_pat(alt, ty);
            if binding_count(alt) != bound {
                type_error(alt, c"every alternative of an or-pattern must bind the same variables");
            }
        }
    }
    OR_MODE = saved_mode;
    OR_FIRST = saved_first;
    OR_END = saved_end;
}

// The local of the first alternative named `name`, for a later one.
fn or_rebind(p: i64, name: i64, ty: i64) -> i64 {
    unsafe {
        for i in OR_FIRST..OR_END {
            let id = ENV.data[i];
            if LOCALS[id].name == name {
                if LOCALS[id].ty != ty {
                    err_begin(NODES[p].start);
                    err_str(c"variable '");
                    err_sym(name);
                    err_str(c"' has type '");
                    err_type(LOCALS[id].ty);
                    err_str(c"' in one alternative and '");
                    err_type(ty);
                    err_str(c"' in another");
                    err_end();
                }
                return id;
            }
        }
        name_error(NODES[p].start, c"variable '", name, c"' is not bound in every alternative of the or-pattern")
    }
}

pub fn binding_count(p: i64) -> i64 {
    unsafe {
        match NODES[p].kind {
            PatBind => 1,
            PatOr => binding_count(child(p, 0)),
            PatTuple | PatVariant => {
                let mut total = 0;
                for i in 0..NODES[p].count {
                    total += binding_count(child(p, i));
                }
                total
            }
            _ => 0,
        }
    }
}

// ---- Refutability ----

pub fn is_irrefutable(p: i64) -> bool {
    unsafe {
        match NODES[p].kind {
            PatWild | PatBind => true,
            _ if NODES[p].ty == TY_NEVER => true,
            PatVariant if ENUMS[VARIANTS[NODES[p].x].enum_id].variant_count != 1 => false,
            PatTuple | PatVariant => {
                for i in 0..NODES[p].count {
                    if !is_irrefutable(child(p, i)) {
                        return false;
                    }
                }
                true
            }
            _ => false,
        }
    }
}

fn has_or_pattern(p: i64) -> i64 {
    unsafe {
        if NODES[p].kind == PatOr {
            return p;
        }
        if NODES[p].kind == PatTuple || NODES[p].kind == PatVariant {
            for i in 0..NODES[p].count {
                let found = has_or_pattern(child(p, i));
                if found != 0 {
                    return found;
                }
            }
        }
        0
    }
}

// Patterns of `let` and `for` must match every value.
pub fn check_irrefutable(p: i64, what: *u8) {
    unsafe {
        let or = has_or_pattern(p);
        if or != 0 {
            err_begin(NODES[or].start);
            err_str(c"or-patterns are only allowed in match arms, not in '");
            err_str(what);
            err_str(c"'");
            err_end();
        }
        if !is_irrefutable(p) {
            err_begin(NODES[p].start);
            err_str(c"refutable pattern in '");
            err_str(what);
            err_str(c"': it does not match every value of type '");
            err_type(NODES[p].ty);
            err_str(c"'");
            err_help(c"use 'match' to handle the other cases");
            err_end();
        }
    }
}

// ---- match ----

// `match`; `expected` (0 for none) is the type of the arms.
pub fn check_match(n: i64, expected: i64) -> i64 {
    unsafe {
        let scrutinee = NODES[n].a;
        let st = check_wrapped(scrutinee, 0);
        let mut result = expected;
        let mut all_never = true;
        // `if let` without `else` (0.6): of type `()`, like an `if`.
        let no_else = NODES[n].count == 2 && (NODES[child(n, 1)].p & ARM_NO_ELSE) != 0;
        if no_else && expected != 0 && expected != TY_UNIT {
            err_begin(NODES[n].start);
            err_str(c"'if let' without else must have type '()', expected '");
            err_type(expected);
            err_str(c"'");
            err_end();
        }
        for i in 0..NODES[n].count {
            let arm = child(n, i);
            push_scope();
            check_pattern(NODES[arm].a, st);
            if NODES[arm].b != 0 {
                check_expr(NODES[arm].b, TY_BOOL);
            }
            let body = NODES[arm].c;
            let mut t = 0;
            if no_else && i == 0 {
                t = check_wrapped(body, 0);
                if t != TY_UNIT && t != TY_NEVER {
                    type_error_got(n, c"'if let' without else must have type '()'", t);
                }
                result = TY_UNIT;
            } else if result != 0 {
                t = check_wrapped(body, result);
            } else {
                t = check_wrapped(body, 0);
                if t != TY_NEVER {
                    result = t;
                }
            }
            if t != TY_NEVER {
                all_never = false;
            }
            pop_scope();
        }
        if st != TY_NEVER {
            check_arms(n, st);
        }
        if all_never || result == 0 {
            return TY_NEVER;
        }
        result
    }
}

// ---- Usefulness ----
//
// A pattern matrix is MAT[start + row * cols + col] (pattern nodes, 0 for a
// wildcard), with the column types at MTY[types + col]. Matrices are made
// on top of MAT and dropped on return.

static mut MAT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut MTY: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Integer segments (start keys) of the column being split.
static mut CUTS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Witnesses: nodes (kind, value, type, first kid, kid count) in WIT, kids
// in WKIDS; the witness of the columns being searched is on WSTACK.
static mut WIT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut WKIDS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut WSTACK: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

const W_ANY: i64 = 0;
const W_VARIANT: i64 = 1;
const W_BOOL: i64 = 2;
const W_TUPLE: i64 = 3;
const W_INT: i64 = 4;

fn is_wild(p: i64) -> bool {
    unsafe { p == 0 || NODES[p].kind == PatWild || NODES[p].kind == PatBind }
}

// Integers in an order-preserving signed form: unsigned values with the
// top bit flipped.
pub fn int_key(value: i64, ty: i64) -> i64 {
    if is_signed(ty) { value } else { value ^ (1 << 63) }
}

fn key_value(key: i64, ty: i64) -> i64 {
    if is_signed(ty) { key } else { key ^ (1 << 63) }
}

fn min_key(ty: i64) -> i64 {
    if is_signed(ty) {
        return 0 - (int_max(ty) as i64) - 1;
    }
    int_key(0, ty)
}

fn max_key(ty: i64) -> i64 {
    int_key(int_max(ty) as i64, ty)
}

// The range (keys) of an integer head pattern.
fn head_low(p: i64, ty: i64) -> i64 {
    unsafe { int_key(NODES[p].x, ty) }
}

fn head_high(p: i64, ty: i64) -> i64 {
    unsafe {
        if NODES[p].kind == PatRange {
            return int_key(NODES[p].y, ty);
        }
        int_key(NODES[p].x, ty)
    }
}

// The kind of the constructors of type ty: 1 enum, 2 bool, 3 tuple, 4
// integer, 0 none (only wildcards match it).
fn ctor_kind(ty: i64) -> i64 {
    let kind = unsafe { TYPES[ty].kind };
    if kind == TyKind::Enum { return 1; }
    if ty == TY_BOOL { return 2; }
    if kind == TyKind::Tuple || ty == TY_UNIT { return 3; }
    if is_integer(ty) { return 4; }
    0
}

fn mat_row(m: i64, cols: i64, r: i64) -> i64 {
    m + r * cols
}

// Copies the rows of matrix (m, rows, cols) with or-patterns in the first
// column expanded into one row per alternative; returns the new start and
// sets *out_rows.
fn expand_rows(m: i64, rows: i64, cols: i64, out_rows: *i64) -> i64 {
    let start = MAT.count;
    let mut count = 0;
    for r in 0..rows {
        unsafe {
            count += push_expanded(mat_row(m, cols, r), cols, MAT.data[mat_row(m, cols, r)]);
        }
    }
    *out_rows = count;
    start
}

// Pushes the row at `row` with head `head` (expanding or-patterns); returns
// the number of rows pushed.
fn push_expanded(row: i64, cols: i64, head: i64) -> i64 {
    unsafe {
        if head != 0 && NODES[head].kind == PatOr {
            let mut count = 0;
            for i in 0..NODES[head].count {
                count += push_expanded(row, cols, child(head, i));
            }
            return count;
        }
        MAT.push(head);
        for c in 1..cols {
            MAT.push(MAT.data[row + c]);
        }
        1
    }
}

// The arity and field types of constructor `c` of type ty (pushed on
// MTY); returns the arity.
fn push_ctor_types(ty: i64, c: i64) -> i64 {
    unsafe {
        let kind = ctor_kind(ty);
        if kind == 1 {
            let v = enum_variant(TYPES[ty].a, c);
            for i in 0..VARIANTS[v].field_count {
                MTY.push(variant_field(v, i));
            }
            return VARIANTS[v].field_count;
        }
        if kind == 3 && ty != TY_UNIT {
            for i in 0..TYPES[ty].count {
                MTY.push(type_elem(ty, i));
            }
            return TYPES[ty].count;
        }
        0
    }
}

// Whether head pattern p (not a wildcard) is constructor c of type ty (for
// integers, c is a segment start key, the segment ending at `c_end`).
fn head_is(p: i64, ty: i64, c: i64, c_end: i64) -> bool {
    unsafe {
        let kind = ctor_kind(ty);
        if kind == 1 {
            return NODES[p].x - ENUMS[TYPES[ty].a].variants == c;
        }
        if kind == 2 {
            return NODES[p].x == c;
        }
        if kind == 3 {
            return true;
        }
        head_low(p, ty) <= c && c_end <= head_high(p, ty)
    }
}

// Pushes the specialization of the row at `row` (head of type ty) by
// constructor c of the given arity; returns whether the row was kept.
fn push_specialized(row: i64, cols: i64, ty: i64, c: i64, c_end: i64, arity: i64) -> bool {
    unsafe {
        let head = MAT.data[row];
        if is_wild(head) {
            for _ in 0..arity {
                MAT.push(0);
            }
        } else if head_is(head, ty, c, c_end) {
            for i in 0..arity {
                MAT.push(child(head, i));
            }
        } else {
            return false;
        }
        for k in 1..cols {
            MAT.push(MAT.data[row + k]);
        }
        true
    }
}

// The integer segments of column 0 of matrix (m, rows, cols), split also
// at the range of `extra` (a head pattern, or 0): their start keys in CUTS
// (sorted, unique); the last segment ends at the type's maximum.
fn int_segments(m: i64, rows: i64, cols: i64, ty: i64, extra: i64) {
    unsafe {
        CUTS.count = 0;
        CUTS.push(min_key(ty));
        let top = max_key(ty);
        for r in 0..rows + 1 {
            let p = if r < rows { MAT.data[mat_row(m, cols, r)] } else { extra };
            if is_wild(p) {
                continue;
            }
            CUTS.push(head_low(p, ty));
            let high = head_high(p, ty);
            if high < top {
                CUTS.push(high + 1);
            }
        }
        // Insertion sort, then unique.
        for i in 1..CUTS.count {
            let mut j = i;
            while j > 0 && CUTS.data[j - 1] > CUTS.data[j] {
                let t = CUTS.data[j];
                CUTS.data[j] = CUTS.data[j - 1];
                CUTS.data[j - 1] = t;
                j -= 1;
            }
        }
        let mut n = 0;
        for i in 0..CUTS.count {
            if n == 0 || CUTS.data[n - 1] != CUTS.data[i] {
                CUTS.data[n] = CUTS.data[i];
                n += 1;
            }
        }
        CUTS.count = n;
    }
}

fn segment_end(i: i64, ty: i64) -> i64 {
    if i + 1 < CUTS.count { unsafe { CUTS.data[i + 1] - 1 } } else { max_key(ty) }
}

// The number of constructors of the column's type to try, and whether the
// constructors in column 0 cover the type (`complete`).
fn ctor_count(m: i64, rows: i64, cols: i64, ty: i64, complete: *bool) -> i64 {
    unsafe {
        let kind = ctor_kind(ty);
        let mut total = 0;
        if kind == 1 {
            total = ENUMS[TYPES[ty].a].variant_count;
        } else if kind == 2 {
            total = 2;
        } else if kind == 3 {
            total = 1;
        } else if kind == 4 {
            total = CUTS.count;
        }
        let mut all = kind != 0;
        for c in 0..total {
            let mut seen = false;
            let start = if kind == 4 { CUTS.data[c] } else { c };
            let end = if kind == 4 { segment_end(c, ty) } else { c };
            for r in 0..rows {
                let p = MAT.data[mat_row(m, cols, r)];
                if !is_wild(p) && head_is(p, ty, start, end) {
                    seen = true;
                    break;
                }
            }
            if !seen {
                all = false;
            }
        }
        *complete = all;
        total
    }
}

// Whether row q (at `q`, `cols` patterns) is useful with respect to the
// matrix (m, rows, cols) with column types at `types`: whether some value
// matches q and no row.
fn useful(m: i64, rows: i64, cols: i64, types: i64, q: i64) -> bool {
    unsafe {
        if cols == 0 {
            return rows == 0;
        }
        let mark = MAT.count;
        let tmark = MTY.count;
        let head = MAT.data[q];
        let mut result = false;
        if head != 0 && NODES[head].kind == PatOr {
            for i in 0..NODES[head].count {
                let q2 = MAT.count;
                MAT.push(child(head, i));
                for k in 1..cols {
                    MAT.push(MAT.data[q + k]);
                }
                if useful(m, rows, cols, types, q2) {
                    result = true;
                    break;
                }
            }
            MAT.count = mark;
            return result;
        }
        let mut erows = 0;
        let em = expand_rows(m, rows, cols, &erows);
        let ty = MTY.data[types];
        let kind = ctor_kind(ty);
        if kind == 4 {
            int_segments(em, erows, cols, ty, if is_wild(head) { 0 } else { head });
        }
        if !is_wild(head) || kind != 0 {
            let mut complete = false;
            let total = ctor_count(em, erows, cols, ty, &complete);
            if !is_wild(head) || complete {
                // Saved: the recursion reuses CUTS.
                let cuts = MAT.count;
                if kind == 4 {
                    for i in 0..CUTS.count {
                        MAT.push(CUTS.data[i]);
                    }
                }
                for c in 0..total {
                    let start = if kind == 4 { MAT.data[cuts + c] } else { c };
                    let end = if kind == 4 {
                        if c + 1 < total { MAT.data[cuts + c + 1] - 1 } else { max_key(ty) }
                    } else { c };
                    if !is_wild(head) && !head_is(head, ty, start, end) {
                        continue;
                    }
                    if specialized_useful(em, erows, cols, types, q, ty, start, end) {
                        result = true;
                        break;
                    }
                }
                MAT.count = mark;
                MTY.count = tmark;
                return result;
            }
        }
        // The default matrix: the rows with a wildcard head, without it.
        let d = MAT.count;
        let mut drows = 0;
        for r in 0..erows {
            let row = mat_row(em, cols, r);
            if is_wild(MAT.data[row]) {
                for k in 1..cols {
                    MAT.push(MAT.data[row + k]);
                }
                drows += 1;
            }
        }
        result = useful(d, drows, cols - 1, types + 1, q + 1);
        MAT.count = mark;
        MTY.count = tmark;
        result
    }
}

fn specialized_useful(m: i64, rows: i64, cols: i64, types: i64, q: i64, ty: i64,
                      c: i64, c_end: i64) -> bool {
    let mark = MAT.count;
    let tmark = MTY.count;
    let arity = push_ctor_types(ty, c);
    for k in 1..cols {
        unsafe { MTY.push(MTY.data[types + k]); }
    }
    let new_cols = arity + cols - 1;
    let s = MAT.count;
    let mut srows = 0;
    for r in 0..rows {
        if push_specialized(mat_row(m, cols, r), cols, ty, c, c_end, arity) {
            srows += 1;
        }
    }
    let sq = MAT.count;
    push_specialized(q, cols, ty, c, c_end, arity);
    let result = useful(s, srows, new_cols, tmark, sq);
    MAT.count = mark;
    MTY.count = tmark;
    result
}

// Whether some value matches no row of the matrix; if so, its witness
// (one node per column) is pushed on WSTACK.
fn find_missing(m: i64, rows: i64, cols: i64, types: i64) -> bool {
    unsafe {
        if cols == 0 {
            return rows == 0;
        }
        let mark = MAT.count;
        let tmark = MTY.count;
        let mut erows = 0;
        let em = expand_rows(m, rows, cols, &erows);
        let ty = MTY.data[types];
        let kind = ctor_kind(ty);
        if kind == 4 {
            int_segments(em, erows, cols, ty, 0);
        }
        let mut complete = false;
        let total = ctor_count(em, erows, cols, ty, &complete);
        let cuts = MAT.count;
        if kind == 4 {
            for i in 0..CUTS.count {
                MAT.push(CUTS.data[i]);
            }
        }
        if complete {
            for c in 0..total {
                let start = if kind == 4 { MAT.data[cuts + c] } else { c };
                let end = if kind == 4 {
                    if c + 1 < total { MAT.data[cuts + c + 1] - 1 } else { max_key(ty) }
                } else { c };
                let arity_mark = MTY.count;
                let arity = push_ctor_types(ty, start);
                for k in 1..cols {
                    MTY.push(MTY.data[types + k]);
                }
                let s = MAT.count;
                let mut srows = 0;
                for r in 0..erows {
                    if push_specialized(mat_row(em, cols, r), cols, ty, start, end, arity) {
                        srows += 1;
                    }
                }
                if find_missing(s, srows, arity + cols - 1, arity_mark) {
                    // The first `arity` witnesses are the constructor's fields:
                    // they become the kids of its node, which takes their place.
                    let found = arity + cols - 1;
                    let base = WSTACK.count - found;
                    let node = witness_node(if kind == 1 { W_VARIANT } else if kind == 2 { W_BOOL } else if kind == 3 { W_TUPLE } else { W_INT },
                                            if kind == 1 { enum_variant(TYPES[ty].a, start) } else if kind == 4 { key_value(start, ty) } else { start },
                                            ty, base, arity);
                    for k in 0..cols - 1 {
                        WSTACK.push(WSTACK.data[base + arity + k]);
                    }
                    WSTACK.data[base] = node;
                    for k in 0..cols - 1 {
                        WSTACK.data[base + 1 + k] = WSTACK.data[base + found + k];
                    }
                    WSTACK.count = base + cols;
                    MAT.count = mark;
                    MTY.count = tmark;
                    return true;
                }
                MAT.count = s;
                MTY.count = arity_mark;
            }
            MAT.count = mark;
            MTY.count = tmark;
            return false;
        }
        let d = MAT.count;
        let mut drows = 0;
        for r in 0..erows {
            let row = mat_row(em, cols, r);
            if is_wild(MAT.data[row]) {
                for k in 1..cols {
                    MAT.push(MAT.data[row + k]);
                }
                drows += 1;
            }
        }
        let found = find_missing(d, drows, cols - 1, types + 1);
        if found {
            // A constructor no row starts with, or `_`.
            let mut node = witness_node(W_ANY, 0, ty, 0, 0);
            for c in 0..total {
                let start = if kind == 4 { MAT.data[cuts + c] } else { c };
                let end = if kind == 4 {
                    if c + 1 < total { MAT.data[cuts + c + 1] - 1 } else { max_key(ty) }
                } else { c };
                let mut seen = false;
                for r in 0..erows {
                    let p = MAT.data[mat_row(em, cols, r)];
                    if !is_wild(p) && head_is(p, ty, start, end) {
                        seen = true;
                    }
                }
                if !seen {
                    if kind == 1 {
                        let v = enum_variant(TYPES[ty].a, c);
                        let kids = WKIDS.count;
                        for _ in 0..VARIANTS[v].field_count {
                            WKIDS.push(witness_node(W_ANY, 0, 0, 0, 0));
                        }
                        node = witness_node(W_VARIANT, v, ty, 0, 0);
                        WIT.data[node + 3] = kids;
                        WIT.data[node + 4] = VARIANTS[v].field_count;
                    } else if kind == 2 {
                        node = witness_node(W_BOOL, c, ty, 0, 0);
                    } else if kind == 4 {
                        node = witness_node(W_INT, key_value(start, ty), ty, 0, 0);
                    }
                    break;
                }
            }
            let base = WSTACK.count - (cols - 1);
            WSTACK.push(0);
            let mut k = WSTACK.count - 1;
            while k > base {
                WSTACK.data[k] = WSTACK.data[k - 1];
                k -= 1;
            }
            WSTACK.data[base] = node;
        }
        MAT.count = mark;
        MTY.count = tmark;
        found
    }
}

// A witness node; `kids` kids from WSTACK[kids_at..] are copied.
fn witness_node(kind: i64, value: i64, ty: i64, kids_at: i64, kids: i64) -> i64 {
    let first = WKIDS.count;
    for i in 0..kids {
        unsafe { WKIDS.push(WSTACK.data[kids_at + i]); }
    }
    let node = WIT.count;
    WIT.push(kind);
    WIT.push(value);
    WIT.push(ty);
    WIT.push(first);
    WIT.push(kids);
    node
}

fn buf_witness(out: i64, node: i64) {
    unsafe {
        let kind = WIT.data[node];
        let value = WIT.data[node + 1];
        let ty = WIT.data[node + 2];
        let first = WIT.data[node + 3];
        let kids = WIT.data[node + 4];
        if kind == W_ANY {
            buf_byte(out, '_');
        } else if kind == W_BOOL {
            buf_str(out, if value != 0 { c"true" } else { c"false" });
        } else if kind == W_INT {
            if is_signed(ty) {
                buf_int(out, value);
            } else {
                buf_uint(out, value as u64);
            }
        } else if kind == W_VARIANT {
            buf_type(out, ty);
            buf_str(out, c"::");
            buf_str(out, sym_name(VARIANTS[value].name));
        }
        if kind == W_TUPLE || (kind == W_VARIANT && kids > 0) {
            buf_byte(out, '(');
            for i in 0..kids {
                if i > 0 {
                    buf_str(out, c", ");
                }
                buf_witness(out, WKIDS.data[first + i]);
            }
            if kind == W_TUPLE && kids == 1 {
                buf_byte(out, ',');
            }
            buf_byte(out, ')');
        }
    }
}

// Reachability of every arm, and exhaustiveness, of match n on type st.
fn check_arms(n: i64, st: i64) {
    unsafe {
        MAT.count = 0;
        MTY.count = 0;
        MTY.push(st);
        // The patterns of the arms without guards so far: one-column rows.
        let rows_start = 0;
        let mut rows = 0;
        let mut kept = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..NODES[n].count {
            let arm = child(n, i);
            let p = NODES[arm].a;
            // The matrix is rebuilt from `kept` for every arm.
            MAT.count = 0;
            for r in 0..kept.count {
                MAT.push(kept.data[r]);
            }
            let q = MAT.count;
            MAT.push(p);
            if !useful(rows_start, kept.count, 1, 0, q) && (NODES[arm].p & ARM_SYNTHETIC) == 0 {
                type_error(p, c"unreachable match arm: the arms above match every value it matches");
            }
            if NODES[arm].b == 0 {
                kept.push(p);
                rows += 1;
            }
        }
        MAT.count = 0;
        for r in 0..kept.count {
            MAT.push(kept.data[r]);
        }
        WSTACK.count = 0;
        if find_missing(0, kept.count, 1, 0) {
            err_begin(NODES[n].start);
            err_str(c"non-exhaustive match: '");
            buf_witness(ERR, WSTACK.data[0]);
            err_str(c"' is not covered");
            if rows < NODES[n].count {
                err_help(c"arms with guards do not count; add an arm without a guard");
            } else {
                err_help(c"add an arm for it, or a wildcard arm '_ =>'");
            }
            err_end();
        }
        free(kept.data as *u8);
    }
}
