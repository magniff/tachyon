// AArch64 instructions for the IR back end (emit.tach), on physical
// registers: 0-30 are x0-x30, 31 is sp (as a base or an addition source),
// 32 + n is d<n> (s<n> for f32).
//
// Use of the registers: x0-x15 (caller-saved; x0-x7 also carry arguments,
// x8 the result pointer) and x19-x28 (callee-saved) are allocated; x16
// holds the callee of indirect calls and is the parallel moves' temporary;
// x17 breaks parallel move cycles and is the temporary for addresses and
// constants here; x18 is reserved by the platform. d0-d29 are allocated
// (d8-d15 callee-saved); d30 and d31 are the parallel moves' registers.

use crate::base::BUFS;
use crate::types::{
    TY_F32, TY_F64, TY_I16, TY_I32, TY_I8, TY_U16, TY_U32, TY_U64, TY_U8, int_bits, is_float,
    is_signed, type_size, is_vector, vec_elem, vec_lanes,
};
use crate::consteval::{f32_bits, f64_of_bits};
use crate::target::{CODE, emit_label, end_i, global_prefix, ins, log2, new_label, o, oi, on};
use crate::arm64::{
    A64_GOTPAGE, A64_GOTPAGEOFF, A64_PAGE, A64_PAGEOFF, a64_condition, a64_label, a64_load_imm,
    a64_str_sym, a64_sym,
};
use crate::ir::{Cond, Op};
use crate::emit::{MEM_INDEX, MEM_SCALE, SHORT_BRANCHES};
use crate::ir::Op::{Add, And, Div, Mul, Neg, Not, Or, Rem, Shl, Shr, Sub, Xor};

fn ma_r(r: i64) {
    unsafe {
        if r == 31 {
            o(c"sp");
        } else {
            o(c"x");
            oi(r);
        }
    }
}

fn ma_w(r: i64) {
    unsafe { o(c"w"); }
    oi(r);
}

// The float register r (32 + n) for a value of type ty (q<n> for a
// vector).
fn ma_f(r: i64, ty: i64) {
    unsafe { o(if is_vector(ty) { c"q" } else if ty == TY_F32 { c"s" } else { c"d" }); }
    oi(r - 32);
}

// "    <mnemonic> x<d>, x<a>, x<b>\n"
fn ma_rrr(mnemonic: *u8, d: i64, a: i64, b: i64) {
    unsafe {
        o(c"    ");
        o(mnemonic);
        o(c" ");
        ma_r(d);
        o(c", ");
        ma_r(a);
        o(c", ");
        ma_r(b);
        on();
    }
}

fn ma_rr(mnemonic: *u8, d: i64, a: i64) {
    unsafe {
        o(c"    ");
        o(mnemonic);
        o(c" ");
        ma_r(d);
        o(c", ");
        ma_r(a);
        on();
    }
}

pub fn ma_mov(dst: i64, src: i64, ty: i64) {
    unsafe {
        if dst >= 32 && is_vector(ty) {
            o(c"    mov ");
            ma_v(dst, c"16b");
            o(c", ");
            ma_v(src, c"16b");
            on();
        } else if dst >= 32 {
            o(c"    fmov ");
            ma_f(dst, TY_F64);
            o(c", ");
            ma_f(src, TY_F64);
            on();
        } else {
            ma_rr(c"mov", dst, src);
        }
    }
}

pub fn ma_load_imm(dst: i64, value: u64) {
    unsafe {
        let signed = value as i64;
        // One instruction: movz, or movn for small negative values.
        if (signed >= 0 && signed < 65536) || (signed < 0 && signed >= -65536) {
            o(c"    mov ");
            ma_r(dst);
            o(c", #");
            oi(signed);
            on();
            return;
        }
        a64_load_imm(dst, value);
    }
}

pub fn ma_load_fimm(dst: i64, bits: i64, ty: i64) {
    unsafe {
        if bits == 0 {
            o(c"    fmov ");
            ma_f(dst, ty);
            o(if ty == TY_F32 { c", wzr\n" } else { c", xzr\n" });
            return;
        }
        if ty == TY_F32 {
            a64_load_imm(17, f32_bits(f64_of_bits(bits)) as u64);
            o(c"    fmov ");
            ma_f(dst, ty);
            o(c", w17\n");
        } else {
            a64_load_imm(17, bits as u64);
            o(c"    fmov ");
            ma_f(dst, ty);
            o(c", x17\n");
        }
    }
}

// dst = base + offset.
pub fn ma_lea(dst: i64, base: i64, offset: i64) {
    unsafe {
        if offset == 0 {
            if dst != base {
                ma_rr(c"mov", dst, base);
            }
            return;
        }
        if offset > 0 && offset < 4096 {
            ma_rr(c"add", dst, base);
            o_back_imm(offset);
            return;
        }
        if offset < 0 && offset > -4096 {
            ma_rr(c"sub", dst, base);
            o_back_imm(0 - offset);
            return;
        }
        a64_load_imm(17, offset as u64);
        ma_rrr(c"add", dst, base, 17);
    }
}

// Replaces the newline just written with ", #<value>\n".
fn o_back_imm(value: i64) {
    unsafe {
        BUFS[CODE].len -= 1;
        o(c", #");
    }
    oi(value);
    on();
}

// "[x<base>, #offset]" when encodable as an unsigned scaled offset;
// otherwise the address is computed into x17 first (call before starting
// the instruction's line).
fn ma_address(base: i64, offset: i64, size: i64) -> i64 {
    if offset >= 0 && offset % size == 0 && offset / size < 4096 {
        return offset;
    }
    ma_lea(17, base, offset);
    -1
}

fn ma_mem_operand(base: i64, offset: i64) {
    unsafe {
        o(c"[");
        if MEM_INDEX >= 0 {
            // [base, index, lsl #s] (no offset: see isel.tach).
            ma_r(base);
            o(c", ");
            ma_r(MEM_INDEX);
            if MEM_SCALE != 0 {
                o(c", lsl #");
                oi(MEM_SCALE);
            }
            o(c"]");
            return;
        }
        if offset < 0 {
            o(c"x17]");
            return;
        }
        ma_r(base);
        if offset != 0 {
            o(c", #");
            oi(offset);
        }
        o(c"]");
    }
}

pub fn ma_load(ty: i64, dst: i64, base: i64, offset: i64) {
    unsafe {
        let size = type_size(ty);
        let at = if MEM_INDEX >= 0 { 0 } else { ma_address(base, offset, size) };
        o(c"    ");
        if is_float(ty) || is_vector(ty) {
            o(c"ldr ");
            ma_f(dst, ty);
        } else if ty == TY_I8 {
            o(c"ldrsb ");
            ma_r(dst);
        } else if size == 1 {
            o(c"ldrb ");
            ma_w(dst);
        } else if ty == TY_I16 {
            o(c"ldrsh ");
            ma_r(dst);
        } else if size == 2 {
            o(c"ldrh ");
            ma_w(dst);
        } else if ty == TY_I32 {
            o(c"ldrsw ");
            ma_r(dst);
        } else if size == 4 {
            o(c"ldr ");
            ma_w(dst);
        } else {
            o(c"ldr ");
            ma_r(dst);
        }
        o(c", ");
        ma_mem_operand(base, at);
        on();
    }
}

pub fn ma_store(ty: i64, src: i64, base: i64, offset: i64) {
    unsafe {
        let size = type_size(ty);
        let at = if MEM_INDEX >= 0 { 0 } else { ma_address(base, offset, size) };
        o(c"    ");
        if is_float(ty) || is_vector(ty) {
            o(c"str ");
            ma_f(src, ty);
        } else if size == 1 {
            o(c"strb ");
            ma_w(src);
        } else if size == 2 {
            o(c"strh ");
            ma_w(src);
        } else if size == 4 {
            o(c"str ");
            ma_w(src);
        } else {
            o(c"str ");
            ma_r(src);
        }
        o(c", ");
        ma_mem_operand(base, at);
        on();
    }
}

pub fn ma_symbol_addr(dst: i64, prefix: *u8, name: i64) {
    unsafe {
        o(c"    adrp ");
        ma_r(dst);
        o(c", ");
        a64_sym(prefix, name, A64_PAGE);
        o(c"\n    add ");
        ma_r(dst);
        o(c", ");
        ma_r(dst);
        o(c", ");
        a64_sym(prefix, name, A64_PAGEOFF);
        on();
    }
}

pub fn ma_extern_addr(dst: i64, name: i64) {
    unsafe {
        o(c"    adrp ");
        ma_r(dst);
        o(c", ");
        a64_sym(global_prefix(), name, A64_GOTPAGE);
        o(c"\n    ldr ");
        ma_r(dst);
        o(c", [");
        ma_r(dst);
        o(c", ");
        a64_sym(global_prefix(), name, A64_GOTPAGEOFF);
        o(c"]\n");
    }
}

pub fn ma_string_addr(dst: i64, id: i64) {
    unsafe {
        o(c"    adrp ");
        ma_r(dst);
        o(c", ");
        a64_str_sym(id, A64_PAGE);
        o(c"\n    add ");
        ma_r(dst);
        o(c", ");
        ma_r(dst);
        o(c", ");
        a64_str_sym(id, A64_PAGEOFF);
        on();
    }
}

pub fn ma_normalize(r: i64, ty: i64) {
    unsafe {
        if ty == TY_I8 {
            o(c"    sxtb ");
            ma_r(r);
            o(c", ");
            ma_w(r);
            on();
        } else if ty == TY_U8 {
            ma_rr(c"and", r, r);
            o_back_imm(0xff);
        } else if ty == TY_I16 {
            o(c"    sxth ");
            ma_r(r);
            o(c", ");
            ma_w(r);
            on();
        } else if ty == TY_U16 {
            ma_rr(c"and", r, r);
            o_back_imm(0xffff);
        } else if ty == TY_I32 {
            o(c"    sxtw ");
            ma_r(r);
            o(c", ");
            ma_w(r);
            on();
        } else if ty == TY_U32 {
            o(c"    mov ");
            ma_w(r);
            o(c", ");
            ma_w(r);
            on();
        }
    }
}

// Division by zero gives 0 (and the remainder the dividend), as sdiv and
// udiv do.
pub fn ma_int_op(op: Op, ty: i64, d: i64, a: i64, b: i64) {
    unsafe {
        let signed = is_signed(ty);
        if op == Add { ma_rrr(c"add", d, a, b); }
        else if op == Sub { ma_rrr(c"sub", d, a, b); }
        else if op == Mul { ma_rrr(c"mul", d, a, b); }
        else if op == Div { ma_rrr(if signed { c"sdiv" } else { c"udiv" }, d, a, b); }
        else if op == Rem {
            ma_rrr(if signed { c"sdiv" } else { c"udiv" }, 17, a, b);
            o(c"    msub ");
            ma_r(d);
            o(c", x17, ");
            ma_r(b);
            o(c", ");
            ma_r(a);
            on();
        } else if op == And { ma_rrr(c"and", d, a, b); }
        else if op == Or { ma_rrr(c"orr", d, a, b); }
        else if op == Xor { ma_rrr(c"eor", d, a, b); }
        else {
            // The amount is taken modulo 32 for types up to 32 bits, modulo 64
            // for 64-bit ones.
            ma_rr(c"and", 17, b);
            o_back_imm(if int_bits(ty) == 64 { 63 } else { 31 });
            if op == Shl {
                ma_rrr(c"lsl", d, a, 17);
            } else {
                ma_rrr(if signed { c"asr" } else { c"lsr" }, d, a, 17);
            }
        }
        ma_normalize(d, ty);
    }
}

// Whether ma_int_op_imm emits `a <op> imm` (one instruction).
pub fn ma_int_imm_ok(op: Op, imm: i64) -> bool {
    if op == Add || op == Sub {
        return imm > -4096 && imm < 4096;
    }
    if op == Mul {
        return imm == 3 || imm == 5 || imm == 9;
    }
    if op == And || op == Or || op == Xor {
        return is_logical_imm(imm as u64);
    }
    op == Shl || op == Shr
}

pub fn ma_int_op_imm(op: Op, ty: i64, d: i64, a: i64, imm: i64) -> bool {
    unsafe {
        if op == Add || op == Sub {
            let mut value = imm;
            let mut subtract = op == Sub;
            if value < 0 && value > -4096 {
                value = 0 - value;
                subtract = !subtract;
            }
            if value < 0 || value >= 4096 {
                return false;
            }
            ma_rr(if subtract { c"sub" } else { c"add" }, d, a);
            o_back_imm(value);
            ma_normalize(d, ty);
            return true;
        }
        if op == Mul && (imm == 3 || imm == 5 || imm == 9) {
            // a * (2^k + 1) = a + (a << k)
            ma_rrr(c"add", d, a, a);
            BUFS[CODE].len -= 1;
            o(c", lsl #");
            oi(log2(imm - 1));
            on();
            ma_normalize(d, ty);
            return true;
        }
        if (op == And || op == Or || op == Xor) && is_logical_imm(imm as u64) {
            ma_rr(if op == And { c"and" } else if op == Or { c"orr" } else { c"eor" }, d, a);
            o_back_imm(imm);
            ma_normalize(d, ty);
            return true;
        }
        if op == Shl || op == Shr {
            let amount = imm & (if int_bits(ty) == 64 { 63 } else { 31 });
            if amount == 0 {
                if d != a {
                    ma_rr(c"mov", d, a);
                }
            } else if op == Shl {
                ma_rr(c"lsl", d, a);
                o_back_imm(amount);
            } else {
                ma_rr(if is_signed(ty) { c"asr" } else { c"lsr" }, d, a);
                o_back_imm(amount);
            }
            ma_normalize(d, ty);
            return true;
        }
        false
    }
}

// Whether `value` is encodable as an AArch64 logical immediate: a
// pattern of 2, 4, ..., 64 bits, repeated, that is a rotated run of ones.
pub fn is_logical_imm(value: u64) -> bool {
    if value == 0 || value == 0xffffffffffffffff {
        return false;
    }
    let mut size = 64;
    while size > 2 {
        let half = size / 2;
        let mask = ((1 as u64) << half as u64) - 1;
        if (value & mask) != ((value >> half as u64) & mask) {
            break;
        }
        size = half;
    }
    let mask: u64 = if size == 64 { 0xffffffffffffffff } else { ((1 as u64) << size as u64) - 1 };
    let element = value & mask;
    // A rotated run of ones has exactly two transitions, circularly.
    let rotated = ((element >> 1) | (element << (size - 1) as u64)) & mask;
    let transitions = element ^ rotated;
    let mut count = 0;
    let mut bits = transitions;
    while bits != 0 {
        bits &= bits - 1;
        count += 1;
    }
    count == 2
}

pub fn ma_float_op(op: Op, ty: i64, d: i64, a: i64, b: i64) {
    unsafe {
        o(c"    ");
        if op == Add { o(c"fadd "); }
        else if op == Sub { o(c"fsub "); }
        else if op == Mul { o(c"fmul "); }
        else { o(c"fdiv "); }
        ma_f(d, ty);
        o(c", ");
        ma_f(a, ty);
        o(c", ");
        ma_f(b, ty);
        on();
    }
}

pub fn ma_unary(op: Op, ty: i64, d: i64, a: i64) {
    unsafe {
        if op == Neg && is_float(ty) {
            o(c"    fneg ");
            ma_f(d, ty);
            o(c", ");
            ma_f(a, ty);
            on();
            return;
        }
        if op == Neg {
            ma_rr(c"neg", d, a);
        } else if op == Not {
            ma_rr(c"eor", d, a);
            o_back_imm(1);
            return;
        } else {
            ma_rr(c"mvn", d, a);
        }
        ma_normalize(d, ty);
    }
}

fn ma_compare(ty: i64, a: i64, b: i64) {
    unsafe {
        if is_float(ty) {
            o(c"    fcmp ");
            ma_f(a, ty);
            o(c", ");
            ma_f(b, ty);
            on();
        } else {
            ma_rr(c"cmp", a, b);
        }
    }
}

pub fn ma_cmp(op: Cond, ty: i64, d: i64, a: i64, b: i64) {
    unsafe {
        ma_compare(ty, a, b);
        o(c"    cset ");
        ma_r(d);
        o(c", ");
        o(a64_condition(op, is_signed(ty), is_float(ty)));
        on();
    }
}

// Sets the flags from a - imm, |imm| < 4096 (cmn for a negative one).
fn ma_compare_imm(a: i64, imm: i64) {
    unsafe {
        o(if imm < 0 { c"    cmn " } else { c"    cmp " });
        ma_r(a);
        o(c", #");
        oi(if imm < 0 { 0 - imm } else { imm });
        on();
    }
}

// Links a frame: saves the frame pointer and the return address, points
// the frame pointer at them.
pub fn ma_frame_link() {
    unsafe {
        ins(c"stp x29, x30, [sp, #-16]!");
        ins(c"mov x29, sp");
    }
}

// Unlinks it: sp from the frame pointer, which and the return address are
// restored.
pub fn ma_frame_unlink() {
    unsafe {
        ins(c"mov sp, x29");
        ins(c"ldp x29, x30, [sp], #16");
    }
}

// d = (a op imm), integers, |imm| < 4096.
pub fn ma_cmp_imm(op: Cond, ty: i64, d: i64, a: i64, imm: i64) {
    unsafe {
        ma_compare_imm(a, imm);
        o(c"    cset ");
        ma_r(d);
        o(c", ");
        o(a64_condition(op, is_signed(ty), false));
        on();
    }
}

pub fn ma_cmp_branch(op: Cond, ty: i64, a: i64, b: i64, b_is_imm: bool, imm: i64, label: i64) {
    unsafe {
        if b_is_imm && imm == 0 && (op == Cond::Eq || op == Cond::Ne) {
            ma_branch_bool(a, op == Cond::Ne, label);
            return;
        }
        if b_is_imm {
            ma_compare_imm(a, imm);
        } else {
            ma_rr(c"cmp", a, b);
        }
        o(c"    b.");
        o(a64_condition(op, is_signed(ty), false));
        o(c" ");
        a64_label(label);
        on();
    }
}

pub fn ma_branch_bool(r: i64, if_nonzero: bool, label: i64) {
    unsafe {
        o(if if_nonzero { c"    cbnz " } else { c"    cbz " });
        ma_r(r);
        o(c", ");
        a64_label(label);
        on();
    }
}

pub fn ma_conv(from: i64, to: i64, d: i64, src: i64) {
    unsafe {
        if is_float(from) && is_float(to) {
            o(c"    fcvt ");
            ma_f(d, to);
            o(c", ");
            ma_f(src, from);
            on();
            return;
        }
        if is_float(to) {
            o(if is_signed(from) { c"    scvtf " } else { c"    ucvtf " });
            ma_f(d, to);
            o(c", ");
            ma_r(src);
            on();
            return;
        }
        if !is_float(from) {
            if d != src {
                ma_rr(c"mov", d, src);
            }
            ma_normalize(d, to);
            return;
        }
        // Saturating float to integer (see emit_float_to_int).
        if is_signed(to) && int_bits(to) <= 32 {
            o(c"    fcvtzs ");
            ma_w(d);
            o(c", ");
            ma_f(src, from);
            on();
            o(c"    sxtw ");
            ma_r(d);
            o(c", ");
            ma_w(d);
            on();
        } else if to != TY_U64 {
            o(c"    fcvtzs ");
            ma_r(d);
            o(c", ");
            ma_f(src, from);
            on();
        } else {
            // d = value >= 2^63 ? fcvtzu(value) : fcvtzs(value); fcvtzs gives
            // INT64_MAX exactly for those values (no smaller float rounds to
            // it), the one value whose increment overflows.
            o(c"    fcvtzs x16, ");
            ma_f(src, from);
            on();
            o(c"    fcvtzu x17, ");
            ma_f(src, from);
            on();
            ins(c"cmn x16, #1");
            o(c"    csel ");
            ma_r(d);
            o(c", x17, x16, vs\n");
        }
        ma_normalize(d, to);
    }
}

pub fn ma_copy(dst: i64, src: i64, size: i64) {
    unsafe {
        let mut offset = 0;
        while offset + 8 <= size {
            ma_copy_chunk(c"ldr x17", c"str x17", dst, src, offset);
            offset += 8;
        }
        if offset + 4 <= size {
            ma_copy_chunk(c"ldr w17", c"str w17", dst, src, offset);
            offset += 4;
        }
        if offset + 2 <= size {
            ma_copy_chunk(c"ldrh w17", c"strh w17", dst, src, offset);
            offset += 2;
        }
        if offset < size {
            ma_copy_chunk(c"ldrb w17", c"strb w17", dst, src, offset);
        }
    }
}

fn ma_copy_chunk(load: *u8, store: *u8, dst: i64, src: i64, offset: i64) {
    unsafe {
        o(c"    ");
        o(load);
        o(c", [");
        ma_r(src);
        end_i(c", #", offset, c"]");
        o(c"    ");
        o(store);
        o(c", [");
        ma_r(dst);
        end_i(c", #", offset, c"]");
    }
}

// A jump through a table of 32-bit offsets (from the table) to labels:
// entry `value - low` for register r, the default above the range.
pub fn ma_jump_table(r: i64, low: i64, range: i64, default: i64, table: *i64) {
    unsafe {
        // The index: the value itself when the cases start at 0.
        let index = if low == 0 { r } else { 16 };
        if low != 0 {
            ma_lea(16, r, 0 - low);
        }
        if range - 1 < 4096 {
            o(c"    cmp ");
            ma_r(index);
            o(c", #");
            oi(range - 1);
            on();
        } else {
            a64_load_imm(17, (range - 1) as u64);
            o(c"    cmp ");
            ma_r(index);
            o(c", x17");
            on();
        }
        o(c"    b.hi ");
        a64_label(default);
        on();
        let at = new_label();
        o(c"    adr x17, ");
        a64_label(at);
        on();
        o(c"    ldrsw x16, [x17, ");
        ma_r(index);
        o(c", lsl #2]");
        on();
        ins(c"add x17, x17, x16");
        ins(c"br x17");
        ins(c".p2align 2");
        emit_label(at);
        for i in 0..range {
            o(c"    .long ");
            a64_label(table[i]);
            o(c" - ");
            a64_label(at);
            on();
        }
    }
}

// ---- Machine operations of instruction selection (isel.tach) ----

// d = c + a * b, or c - a * b.
pub fn ma_madd(sub: bool, ty: i64, d: i64, a: i64, b: i64, c: i64) {
    unsafe {
        o(if sub { c"    msub " } else { c"    madd " });
        ma_r(d);
        o(c", ");
        ma_r(a);
        o(c", ");
        ma_r(b);
        o(c", ");
        ma_r(c);
        on();
        ma_normalize(d, ty);
    }
}

// d = a op (b sh k); `code` is 4 * op + sh (0 lsl, 1 lsr, 2 asr).
pub fn ma_shop(code: i64, ty: i64, d: i64, a: i64, b: i64, k: i64) {
    let op = code / 4;
    let kind = code % 4;
    let mnemonic = if op == Add as i64 { c"add" } else if op == Sub as i64 { c"sub" }
        else if op == And as i64 { c"and" } else if op == Or as i64 { c"orr" } else { c"eor" };
    unsafe {
        ma_rrr(mnemonic, d, a, b);
        BUFS[CODE].len -= 1;
        o(if kind == 0 { c", lsl #" } else if kind == 1 { c", lsr #" } else { c", asr #" });
    }
    oi(k);
    on();
    ma_normalize(d, ty);
}

// d = (a >> k) & (2^n - 1).
pub fn ma_ubfx(d: i64, a: i64, k: i64, n: i64) {
    unsafe {
        ma_rr(c"ubfx", d, a);
        BUFS[CODE].len -= 1;
        o(c", #");
        oi(k);
        o(c", #");
        oi(n);
        on();
    }
}

// Sets the flags from a & b (b < 0: a & mask).
fn ma_tst(a: i64, b: i64, mask: i64) {
    unsafe {
        if b >= 0 {
            ma_rr(c"tst", a, b);
        } else {
            o(c"    tst ");
            ma_r(a);
            o(c", #");
            oi(mask);
            on();
        }
    }
}

// Jumps to `label` when a & b (b < 0: a & mask) is nonzero, or zero.
pub fn ma_test_branch(a: i64, b: i64, mask: i64, if_nonzero: bool, label: i64) {
    unsafe {
        if b < 0 && mask > 0 && (mask & (mask - 1)) == 0 && SHORT_BRANCHES {
            o(if if_nonzero { c"    tbnz " } else { c"    tbz " });
            ma_r(a);
            o(c", #");
            oi(log2(mask));
            o(c", ");
            a64_label(label);
            on();
            return;
        }
        ma_tst(a, b, mask);
        o(if if_nonzero { c"    b.ne " } else { c"    b.eq " });
        a64_label(label);
        on();
    }
}

// d = (lhs op rhs) ? then : other (other + 1 when `increment`), or
// (lhs & rhs) op 0 when `test` (rhs < 0: the immediate imm); cmp_ty is the
// type compared, ty the selected; the flags are already set unless
// `compare`.
pub fn ma_select(op: Cond, test: bool, compare: bool, cmp_ty: i64, lhs: i64, rhs: i64, imm: i64, ty: i64, d: i64, then: i64,
             other: i64, increment: bool) {
    unsafe {
        if !compare {
        } else if test {
            ma_tst(lhs, rhs, imm);
        } else if is_float(cmp_ty) {
            ma_compare(cmp_ty, lhs, rhs);
        } else if rhs < 0 {
            ma_compare_imm(lhs, imm);
        } else {
            ma_rr(c"cmp", lhs, rhs);
        }
        let condition = a64_condition(op, is_signed(cmp_ty), is_float(cmp_ty) && !test);
        if is_float(ty) {
            o(c"    fcsel ");
            ma_f(d, ty);
            o(c", ");
            ma_f(then, ty);
            o(c", ");
            ma_f(other, ty);
        } else {
            o(if increment { c"    csinc " } else { c"    csel " });
            ma_r(d);
            o(c", ");
            ma_r_or_zero(then);
            o(c", ");
            ma_r_or_zero(other);
        }
        o(c", ");
        o(condition);
        on();
    }
}

// x<r>, or xzr for -1.
fn ma_r_or_zero(r: i64) {
    if r < 0 {
        unsafe { o(c"xzr"); }
    } else {
        ma_r(r);
    }
}

// Stores (or loads) registers r and s at [sp, #offset] and [sp, #offset +
// 8]: x or d registers alike.
pub fn ma_pair(load: bool, r: i64, s: i64, offset: i64) {
    unsafe {
        o(if load { c"    ldp " } else { c"    stp " });
        if r >= 32 {
            ma_f(r, TY_F64);
            o(c", ");
            ma_f(s, TY_F64);
        } else {
            ma_r(r);
            o(c", ");
            ma_r(s);
        }
        o(c", [sp");
        if offset != 0 {
            o(c", #");
            oi(offset);
        }
        o(c"]\n");
    }
}

// d = sqrt, fabs, floor, ceil, trunc or round (kind 0 to 5) of a.
pub fn ma_fmath(kind: i64, ty: i64, d: i64, a: i64) {
    unsafe {
        o(if kind == 0 { c"    fsqrt " } else if kind == 1 { c"    fabs " } else if kind == 2 { c"    frintm " }
            else if kind == 3 { c"    frintp " } else if kind == 4 { c"    frintz " } else { c"    frinta " });
        ma_f(d, ty);
        o(c", ");
        ma_f(a, ty);
        on();
    }
}

// ---- Vectors (0.10) ----
//
// NEON on the 128-bit registers v0-v31 (32 + n). Lanewise operations are
// one instruction each, except a 64-bit integer multiplication (lane by
// lane in x16 and x17). v31 is the temporary.

// The arrangement of vector type vt: 2d, 4s, 8h or 16b.
fn ma_arr(vt: i64) -> *u8 {
    let lanes = vec_lanes(vt);
    if lanes == 2 { return c"2d"; }
    if lanes == 4 { return c"4s"; }
    if lanes == 8 { return c"8h"; }
    c"16b"
}

// The element size letter of vector type vt: d, s, h or b.
fn ma_elem_letter(vt: i64) -> *u8 {
    let lanes = vec_lanes(vt);
    if lanes == 2 { return c"d"; }
    if lanes == 4 { return c"s"; }
    if lanes == 8 { return c"h"; }
    c"b"
}

// "v<n>.<arrangement>"
fn ma_v(r: i64, arr: *u8) {
    unsafe {
        o(c"v");
        oi(r - 32);
        o(c".");
        o(arr);
    }
}

// "v<n>.<e>[lane]"
fn ma_vlane(r: i64, letter: *u8, lane: i64) {
    unsafe {
        o(c"v");
        oi(r - 32);
        o(c".");
        o(letter);
        o(c"[");
        oi(lane);
        o(c"]");
    }
}

// "    <mnemonic> vd.<arr>, va.<arr>, vb.<arr>\n"
fn ma_v3(mnemonic: *u8, arr: *u8, d: i64, a: i64, b: i64) {
    unsafe {
        o(c"    ");
        o(mnemonic);
        o(c" ");
        ma_v(d, arr);
        o(c", ");
        ma_v(a, arr);
        o(c", ");
        ma_v(b, arr);
        on();
    }
}

fn ma_v2(mnemonic: *u8, arr: *u8, d: i64, a: i64) {
    unsafe {
        o(c"    ");
        o(mnemonic);
        o(c" ");
        ma_v(d, arr);
        o(c", ");
        ma_v(a, arr);
        on();
    }
}

fn ma_vmov(d: i64, a: i64) {
    if d != a {
        unsafe { ma_v2(c"mov", c"16b", d, a); }
    }
}

// x<r> = lane `lane` of v<a> (letter d: umov, else smov, sign-extended).
fn ma_lane_to_x(r: i64, a: i64, letter: *u8, lane: i64) {
    unsafe {
        o(if *letter == 'd' { c"    mov " } else { c"    smov " });
        ma_r(r);
        o(c", ");
        ma_vlane(a, letter, lane);
        on();
    }
}

// lane `lane` of v<d> = x<r> (w<r> below 64 bits).
fn ma_x_to_lane(d: i64, letter: *u8, lane: i64, r: i64) {
    unsafe {
        o(c"    mov ");
        ma_vlane(d, letter, lane);
        o(c", ");
        if *letter == 'd' { ma_r(r); } else { ma_w(r); }
        on();
    }
}

// d = a <op> b lanewise (op: Add, Sub, Mul, Div, And, Or, Xor).
pub fn ma_vbin(op: Op, vt: i64, d: i64, a: i64, b: i64) {
    unsafe {
        let arr = ma_arr(vt);
        let float = is_float(vec_elem(vt));
        if op == And || op == Or || op == Xor {
            ma_v3(if op == And { c"and" } else if op == Or { c"orr" } else { c"eor" }, c"16b", d, a, b);
            return;
        }
        if op == Mul && !float && vec_lanes(vt) == 2 {
            for lane in 0..2 {
                ma_lane_to_x(16, a, c"d", lane);
                ma_lane_to_x(17, b, c"d", lane);
                ma_rrr(c"mul", 16, 16, 17);
                ma_x_to_lane(63, c"d", lane, 16);
            }
            ma_vmov(d, 63);
            return;
        }
        let m = if op == Add { if float { c"fadd" } else { c"add" } }
            else if op == Sub { if float { c"fsub" } else { c"sub" } }
            else if op == Mul { if float { c"fmul" } else { c"mul" } }
            else { c"fdiv" };
        ma_v3(m, arr, d, a, b);
    }
}

pub fn ma_vneg(vt: i64, d: i64, a: i64) {
    unsafe { ma_v2(if is_float(vec_elem(vt)) { c"fneg" } else { c"neg" }, ma_arr(vt), d, a); }
}

// d = a <cond> b lanewise, -1 or 0 per lane; operands of vector type vt.
pub fn ma_vcmp(cond: Cond, vt: i64, d: i64, a: i64, b: i64) {
    unsafe {
        let arr = ma_arr(vt);
        let float = is_float(vec_elem(vt));
        if cond == Cond::Eq || cond == Cond::Ne {
            ma_v3(if float { c"fcmeq" } else { c"cmeq" }, arr, d, a, b);
            if cond == Cond::Ne {
                ma_v2(c"mvn", c"16b", d, d);
            }
            return;
        }
        let gt = if float { c"fcmgt" } else { c"cmgt" };
        let ge = if float { c"fcmge" } else { c"cmge" };
        if cond == Cond::Gt { ma_v3(gt, arr, d, a, b); }
        else if cond == Cond::Ge { ma_v3(ge, arr, d, a, b); }
        else if cond == Cond::Lt { ma_v3(gt, arr, d, b, a); }
        else { ma_v3(ge, arr, d, b, a); }
    }
}

// d = every lane a (a scalar: an integer register, or a float one).
pub fn ma_vsplat(vt: i64, d: i64, a: i64) {
    unsafe {
        o(c"    dup ");
        ma_v(d, ma_arr(vt));
        o(c", ");
        if is_float(vec_elem(vt)) {
            ma_vlane(a, ma_elem_letter(vt), 0);
        } else if vec_lanes(vt) == 2 {
            ma_r(a);
        } else {
            ma_w(a);
        }
        on();
    }
}

// d = lane `lane` of a (a scalar, canonical).
pub fn ma_vext(vt: i64, d: i64, a: i64, lane: i64) {
    unsafe {
        let letter = ma_elem_letter(vt);
        if is_float(vec_elem(vt)) {
            o(c"    mov ");
            o(letter);
            oi(d - 32);
            o(c", ");
            ma_vlane(a, letter, lane);
            on();
            return;
        }
        ma_lane_to_x(d, a, letter, lane);
    }
}

// d = a with lane `lane` = b.
pub fn ma_vins(vt: i64, d: i64, a: i64, b: i64, lane: i64) {
    unsafe {
        let letter = ma_elem_letter(vt);
        let float = is_float(vec_elem(vt));
        // (A float b in d itself: build the vector in v31.)
        let t = if float && d == b && d != a { 63 } else { d };
        ma_vmov(t, a);
        if float {
            o(c"    mov ");
            ma_vlane(t, letter, lane);
            o(c", ");
            ma_vlane(b, letter, 0);
            on();
        } else {
            ma_x_to_lane(t, letter, lane, b);
        }
        ma_vmov(d, t);
    }
}

// d = the sum of a's lanes (floats pairwise).
pub fn ma_vsum(vt: i64, d: i64, a: i64) {
    unsafe {
        let lanes = vec_lanes(vt);
        if is_float(vec_elem(vt)) {
            if lanes == 2 {
                o(c"    faddp d");
                oi(d - 32);
                o(c", ");
                ma_v(a, c"2d");
                on();
                return;
            }
            ma_v3(c"faddp", c"4s", 63, a, a);
            o(c"    faddp s");
            oi(d - 32);
            o(c", ");
            ma_v(63, c"2s");
            on();
            return;
        }
        if lanes == 2 {
            o(c"    addp d31, ");
            ma_v(a, c"2d");
            o(c"\n    fmov ");
            ma_r(d);
            o(c", d31\n");
            return;
        }
        let letter = ma_elem_letter(vt);
        o(c"    addv ");
        o(letter);
        o(c"31, ");
        ma_v(a, ma_arr(vt));
        on();
        ma_lane_to_x(d, 63, letter, 0);
    }
}

// d = (x & m) | (y & ~m).
pub fn ma_vsel(d: i64, m: i64, x: i64, y: i64) {
    unsafe {
        if d == m {
            ma_v3(c"bsl", c"16b", d, x, y);
        } else if d == x {
            ma_v3(c"bif", c"16b", d, y, m);
        } else if d == y {
            ma_v3(c"bit", c"16b", d, x, m);
        } else {
            ma_vmov(d, m);
            ma_v3(c"bsl", c"16b", d, x, y);
        }
    }
}
