// The target layer: what the code generator (40_gen.tach) knows about the
// machine. This file holds the target selection, the output helpers shared
// by every target, and the target interface, which dispatches to the
// instruction set's file: 42_arm64.tach (a64_*) or 43_x86_64.tach (x64_*).
//
// Targets:
//   aarch64-macos  AArch64, Apple's arm64 ABI, Mach-O
//   x86_64-linux   x86-64, System V ABI, ELF (position independent)
//   x86_64-macos   x86-64, System V ABI, Mach-O
//
// Machine model used by the code generator, in virtual registers that each
// target maps to real ones:
//   R_ACC (0)     the accumulator: integers, bools and pointers; the float
//                 accumulator is a separate register (d0/s0, xmm0); values
//                 kept in memory (structs, tuples, arrays) are represented
//                 by their address in R_ACC
//   R_SECOND (1)  the second operand (int or float), and the destination
//                 of a copy
//   R_RESULT (8)  the result pointer of a function returning a compound
//                 value (set by the caller right before the call)
//   R_ADDR (9)    an address, for a load or store right after it is made
//   R_LOOP_PTR (10), R_LOOP_COUNT (11)
//                 the cursor and count of a fill loop (no calls inside)
// Temporaries (16 bytes each) live on the machine stack; every local lives
// in a frame slot at a negative offset from the frame pointer. Each target
// keeps its own scratch registers out of this set.

const T_AARCH64_MACOS: i64 = 1;
const T_X86_64_LINUX: i64 = 2;
const T_X86_64_MACOS: i64 = 3;

const R_ACC: i64 = 0;
const R_SECOND: i64 = 1;
const R_RESULT: i64 = 8;
const R_ADDR: i64 = 9;
const R_LOOP_PTR: i64 = 10;
const R_LOOP_COUNT: i64 = 11;

// The target being compiled for, and the properties the shared code needs.
static mut TARGET: i64 = 0;
static mut X86: bool = false;
static mut ELF: bool = false;

// The assembly being generated for the current function, and for the
// whole file.
static mut CODE: i64 = -1;
static mut ASM: i64 = -1;
static mut DATA: i64 = -1;
// Temporaries currently pushed (16 bytes each).
static mut DEPTH: i64 = 0;
static mut LABEL_COUNT: i64 = 0;

// ---- Targets ----

fn target_name(target: i64) -> *u8 {
    if target == T_AARCH64_MACOS { return c"aarch64-macos"; }
    if target == T_X86_64_LINUX { return c"x86_64-linux"; }
    c"x86_64-macos"
}

// The target named `name`, or 0.
fn target_of_name(name: *u8) -> i64 {
    for target in T_AARCH64_MACOS..T_X86_64_MACOS + 1 {
        if streq(name, target_name(target)) {
            return target;
        }
    }
    0
}

fn set_target(target: i64) {
    TARGET = target;
    X86 = target != T_AARCH64_MACOS;
    ELF = target == T_X86_64_LINUX;
}

// ---- Output helpers ----

fn o(s: *u8) {
    buf_str(CODE, s);
}

fn oi(value: i64) {
    buf_int(CODE, value);
}

fn on() {
    buf_byte(CODE, '\n');
}

// "    <s>\n"
fn ins(s: *u8) {
    buf_str(CODE, c"    ");
    buf_str(CODE, s);
    buf_byte(CODE, '\n');
}

// "    <a><value><b>\n"
fn ins_i(a: *u8, value: i64, b: *u8) {
    buf_str(CODE, c"    ");
    buf_str(CODE, a);
    buf_int(CODE, value);
    buf_str(CODE, b);
    buf_byte(CODE, '\n');
}

// Ends a line started with o(): "<a><value><b>\n".
fn end_i(a: *u8, value: i64, b: *u8) {
    buf_str(CODE, a);
    buf_int(CODE, value);
    buf_str(CODE, b);
    buf_byte(CODE, '\n');
}

// Ends a line started with o(): "<s>\n".
fn end(s: *u8) {
    buf_str(CODE, s);
    buf_byte(CODE, '\n');
}

fn new_label() -> i64 {
    LABEL_COUNT += 1;
    LABEL_COUNT
}

// Assembler-local labels: "L" on Mach-O, ".L" on ELF.
fn local_prefix() -> *u8 {
    if ELF { c".L" } else { c"L" }
}

// The prefix of C-visible symbols: "_" on Mach-O, nothing on ELF.
fn global_prefix() -> *u8 {
    if ELF { c"" } else { c"_" }
}

// The symbol prefix of tachyon functions (other than main) and statics.
fn function_prefix() -> *u8 {
    if ELF { c"tachyon." } else { c"_tachyon." }
}

fn static_prefix() -> *u8 {
    if ELF { c"tachyon.static." } else { c"_tachyon.static." }
}

fn emit_label(label: i64) {
    o(local_prefix());
    oi(label);
    o(c":\n");
}

// "<prefix><name>"
fn emit_symbol_ref(sym_prefix: *u8, name: i64) {
    o(sym_prefix);
    buf_bytes(CODE, SYMS[name].ptr, SYMS[name].len);
}

// log2 of a power of two.
fn log2(value: i64) -> i64 {
    let mut result = 0;
    while (1 << result as u64) < value {
        result += 1;
    }
    result
}

// Pushes the accumulator for a value of type `ty`.
fn push_value(ty: i64) {
    if is_float(ty) {
        push_d0();
    } else {
        push_x0();
    }
}

// ---- Data ----

fn data_label(prefix: *u8, name: i64) {
    buf_str(DATA, prefix);
    buf_bytes(DATA, SYMS[name].ptr, SYMS[name].len);
    buf_str(DATA, c":\n");
}

// `.byte` lines for `n` bytes at `p`.
fn data_bytes(p: *u8, n: i64) {
    let mut all_zero = true;
    for i in 0..n {
        if p[i] != 0 {
            all_zero = false;
        }
    }
    if all_zero {
        if n > 0 {
            buf_str(DATA, c"    .space ");
            buf_int(DATA, n);
            buf_byte(DATA, '\n');
        }
        return;
    }
    let mut i = 0;
    while i < n {
        buf_str(DATA, c"    .byte ");
        let mut j = 0;
        while j < 16 && i < n {
            if j > 0 {
                buf_byte(DATA, ',');
            }
            buf_uint(DATA, p[i] as u64);
            i += 1;
            j += 1;
        }
        buf_byte(DATA, '\n');
    }
}

fn data_section(writable: bool) {
    if ELF {
        buf_str(DATA, if writable { c"\n.data\n" } else { c"\n.section .rodata\n" });
    } else {
        buf_str(DATA, if writable { c"\n.section __DATA,__data\n" } else { c"\n.section __TEXT,__const\n" });
    }
}

fn data_align(align: i64) {
    buf_str(DATA, c".p2align ");
    buf_int(DATA, log2(align));
    buf_byte(DATA, '\n');
}

fn data_string(id: i64) {
    buf_str(DATA, local_prefix());
    buf_str(DATA, c"str.");
    buf_int(DATA, id);
    buf_str(DATA, c":\n");
    data_bytes(STRS[id].ptr, STRS[id].len);
    buf_str(DATA, c"    .byte 0\n");
}

// The start and the end of the assembly file.
fn emit_file_header() {
    buf_str(ASM, if ELF { c".text\n" } else { c".section __TEXT,__text\n" });
}

fn emit_file_trailer() {
    if ELF {
        // No executable stack.
        buf_str(ASM, c"\n.section .note.GNU-stack,\"\",@progbits\n");
    }
}

// ---- The target interface ----
//
// Every function below dispatches to the instruction set. The comments
// describe the contract in terms of the virtual registers above.

// Control flow.
fn emit_jump(label: i64) {
    if X86 { x64_jump(label); } else { a64_jump(label); }
}

// Jumps when the accumulator is zero (false).
fn emit_jump_if_zero(label: i64) {
    if X86 { x64_jump_if_zero(label); } else { a64_jump_if_zero(label); }
}

fn emit_jump_if_nonzero(label: i64) {
    if X86 { x64_jump_if_nonzero(label); } else { a64_jump_if_nonzero(label); }
}

// <reg> -= 1, setting the flags for emit_jump_unless_zero_result.
fn emit_decrement(reg: i64) {
    if X86 { x64_decrement(reg); } else { a64_decrement(reg); }
}

// Jumps unless the last emit_decrement reached zero (stores in between do
// not change the flags).
fn emit_jump_unless_zero_result(label: i64) {
    if X86 { x64_jump_unless_zero_result(label); } else { a64_jump_unless_zero_result(label); }
}

// Jumps when R_ACC <op> R_SECOND, integers (op a comparison token).
fn emit_compare_jump(op: i64, signed: bool, label: i64) {
    if X86 { x64_compare_jump(op, signed, label); } else { a64_compare_jump(op, signed, label); }
}

// Constants and addresses.

// <reg> = value
fn emit_load_imm(reg: i64, value: u64) {
    if X86 { x64_load_imm(reg, value); } else { a64_load_imm(reg, value); }
}

// <reg> = frame pointer - offset
fn emit_frame_addr(reg: i64, offset: i64) {
    if X86 { x64_frame_addr(reg, offset); } else { a64_frame_addr(reg, offset); }
}

// <reg> += value
fn emit_add_imm(reg: i64, value: i64) {
    if X86 { x64_add_imm(reg, value); } else { a64_add_imm(reg, value); }
}

// R_ACC = address of a symbol defined in this file.
fn emit_local_symbol_addr(prefix: *u8, name: i64) {
    if X86 { x64_local_symbol_addr(prefix, name); } else { a64_local_symbol_addr(prefix, name); }
}

// R_ACC = address of an external (C) symbol.
fn emit_extern_symbol_addr(name: i64) {
    if X86 { x64_extern_symbol_addr(name); } else { a64_extern_symbol_addr(name); }
}

// R_ACC = address of string literal `id`.
fn emit_string_addr(id: i64) {
    if X86 { x64_string_addr(id); } else { a64_string_addr(id); }
}

// Float accumulator = the float whose f64 bits are `bits`.
fn emit_load_float(bits: i64, ty: i64) {
    if X86 { x64_load_float(bits, ty); } else { a64_load_float(bits, ty); }
}

// Temporaries.

fn push_x0() {
    if X86 { x64_push_int(); } else { a64_push_int(); }
    DEPTH += 1;
}

fn push_d0() {
    if X86 { x64_push_float(); } else { a64_push_float(); }
    DEPTH += 1;
}

// Pops the top temporary into int register <reg>.
fn pop_x(reg: i64) {
    if X86 { x64_pop_int(reg); } else { a64_pop_int(reg); }
    DEPTH -= 1;
}

// Pops the top temporary into float register <reg> (0: the accumulator).
fn pop_d(reg: i64) {
    if X86 { x64_pop_float(reg); } else { a64_pop_float(reg); }
    DEPTH -= 1;
}

// <reg> = the top temporary, left in place.
fn emit_peek(reg: i64) {
    if X86 { x64_peek(reg); } else { a64_peek(reg); }
}

// Drops `count` temporaries without changing DEPTH (for jumps out of the
// current expression).
fn emit_drop_temps(count: i64) {
    if count > 0 {
        if X86 { x64_drop_temps(count); } else { a64_drop_temps(count); }
    }
}

// Loads and stores.

// Accumulator = the value of type `ty` at [<addr>].
fn emit_load(ty: i64, addr: i64) {
    if X86 { x64_load(ty, addr); } else { a64_load(ty, addr); }
}

// <reg> = the 8 bytes at [<addr>].
fn emit_load_reg(reg: i64, addr: i64) {
    if X86 { x64_load_reg(reg, addr); } else { a64_load_reg(reg, addr); }
}

// [<addr>] = <reg>, a value of type `ty` (register <reg> of the float
// accumulator's kind for floats).
fn emit_store(ty: i64, reg: i64, addr: i64) {
    if X86 { x64_store(ty, reg, addr); } else { a64_store(ty, reg, addr); }
}

// [<addr> + offset] = the 8 bytes of <reg>.
fn emit_store_offset(reg: i64, addr: i64, offset: i64) {
    if X86 { x64_store_offset(reg, addr, offset); } else { a64_store_offset(reg, addr, offset); }
}

// Copies `size` bytes from [R_ACC] to [R_SECOND]; clobbers the target's
// scratch registers (and every caller-saved register for large copies).
fn emit_copy(size: i64) {
    if X86 { x64_copy(size); } else { a64_copy(size); }
}

// R_SECOND = accumulator (the float registers for floats).
fn emit_move_to_second(ty: i64) {
    if X86 { x64_move_to_second(ty); } else { a64_move_to_second(ty); }
}

// Integer operations: integers are kept sign- or zero-extended to 64 bits.

// Brings R_ACC into the canonical form of `ty`.
fn emit_normalize(ty: i64) {
    if X86 { x64_normalize(ty); } else { a64_normalize(ty); }
}

// R_ACC = R_ACC <op> R_SECOND for integers of type `ty`.
fn emit_int_binary(op: i64, ty: i64) {
    if X86 { x64_int_binary(op, ty); } else { a64_int_binary(op, ty); }
}

// R_ACC = (accumulator <op> second operand) as a bool; operands of `ty`.
fn emit_compare(op: i64, ty: i64) {
    if X86 { x64_compare(op, ty); } else { a64_compare(op, ty); }
}

// Accumulator = -accumulator.
fn emit_negate(ty: i64) {
    if X86 { x64_negate(ty); } else { a64_negate(ty); }
}

// R_ACC = !R_ACC (a bool).
fn emit_not_bool() {
    if X86 { x64_not_bool(); } else { a64_not_bool(); }
}

// R_ACC = ~R_ACC.
fn emit_bitnot(ty: i64) {
    if X86 { x64_bitnot(ty); } else { a64_bitnot(ty); }
}

// R_ACC = R_SECOND + R_ACC * elem_size (an element's address).
fn emit_index_addr(elem_size: i64) {
    if X86 { x64_index_addr(elem_size); } else { a64_index_addr(elem_size); }
}

// Floats.

// Float accumulator = accumulator <op> second operand.
fn emit_float_binary(op: i64, ty: i64) {
    if X86 { x64_float_binary(op, ty); } else { a64_float_binary(op, ty); }
}

fn emit_int_to_float(from: i64, to: i64) {
    if X86 { x64_int_to_float(from, to); } else { a64_int_to_float(from, to); }
}

fn emit_float_to_float(from: i64, to: i64) {
    if from == to {
        return;
    }
    if X86 { x64_float_to_float(to); } else { a64_float_to_float(to); }
}

// Saturating conversions (NaN is 0): signed results up to 32 bits convert
// at 32 bits and wrap, unsigned ones up to 32 bits convert signed at 64
// bits and wrap; u64 converts unsigned at 2^63 and above.
fn emit_float_to_int(from: i64, to: i64) {
    if X86 { x64_float_to_int(from, to); } else { a64_float_to_int(from, to); }
}

// Functions.

fn emit_function_start(symbol_prefix: *u8, name: i64, global: bool) {
    if X86 { x64_function_start(symbol_prefix, name, global); } else { a64_function_start(symbol_prefix, name, global); }
}

// Reserves the frame once its size is known (written to ASM, after the
// function start).
fn emit_frame_reserve(frame_size: i64) {
    let size = align_to(frame_size, 16);
    if size == 0 {
        return;
    }
    let out = CODE;
    CODE = ASM;
    if X86 { x64_frame_reserve(size); } else { a64_frame_reserve(size); }
    CODE = out;
}

fn emit_epilogue() {
    if X86 { x64_epilogue(); } else { a64_epilogue(); }
}

// Calls. An argument's location is 0-7 for an int register (by index in
// the target's argument registers), 8-15 for a float register, or
// 16 + offset for the outgoing stack area. `state` holds the next int
// register, the next float register and the stack offset.

fn arg_location(ty: i64, state: *i64) -> i64 {
    if X86 { x64_arg_location(ty, state) } else { a64_arg_location(ty, state) }
}

// The location of an argument passed to the `...` of a C function.
fn variadic_arg_location(ty: i64, state: *i64) -> i64 {
    if X86 { x64_arg_location(ty, state) } else { a64_variadic_arg_location(state) }
}

// The first int argument register used by ordinary arguments of a function
// returning `ret` (1 where the result pointer takes the first one).
fn first_int_arg(ret: i64) -> i64 {
    if X86 && is_compound(ret) { 1 } else { 0 }
}

// Accumulator = the incoming parameter at `location`, of type `ty` (a
// pointer for compound values).
fn emit_load_param(location: i64, ty: i64) {
    if X86 { x64_load_param(location, ty); } else { a64_load_param(location, ty); }
}

// Moves the stack pointer down (reserve) or up (release) by `size` bytes.
fn emit_sp_sub(size: i64) {
    if X86 { x64_sp_sub(size); } else { a64_sp_sub(size); }
}

fn emit_sp_add(size: i64) {
    if X86 { x64_sp_add(size); } else { a64_sp_add(size); }
}

// Loads argument register `location` from the temporary at sp + from;
// `promote` widens an f32 to f64 (C's default promotion).
fn emit_load_arg_reg(location: i64, ty: i64, from: i64, promote: bool) {
    if X86 { x64_load_arg_reg(location, ty, from, promote); } else { a64_load_arg_reg(location, ty, from); }
}

// Copies the temporary at sp + from to the outgoing stack area at
// sp + offset.
fn emit_stack_arg(ty: i64, from: i64, offset: i64, promote: bool) {
    if X86 { x64_stack_arg(ty, from, offset, promote); } else { a64_stack_arg(ty, from, offset, promote); }
}

// Loads the callee of an indirect call from the temporary at sp + from.
fn emit_load_callee(from: i64) {
    if X86 { x64_load_callee(from); } else { a64_load_callee(from); }
}

// Calls a function by symbol; `vector_regs` float registers carry
// arguments (needed by variadic C functions on x86-64).
fn emit_call(prefix: *u8, name: i64, is_extern: bool, variadic: bool, vector_regs: i64) {
    if X86 { x64_call(prefix, name, is_extern, variadic, vector_regs); } else { a64_call(prefix, name); }
}

fn emit_call_indirect() {
    if X86 { x64_call_indirect(); } else { a64_call_indirect(); }
}
