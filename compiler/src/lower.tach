// Lowering: the checked AST to the IR of ir.tach, building SSA form on
// the fly (Braun, Buchwald, Hack, Leißa, Mallon, Zwinkau: "Simple and
// Efficient Construction of Static Single Assignment Form", CC 2013).
//
// SSA variables are the scalar locals whose address is never taken (the
// others live in frame slots), and synthetic variables for the values of
// `if`, `&&`/`||`, `loop` with `break` values and loop counters. A block
// is sealed once all its predecessors are known; reading a variable in an
// unsealed block makes an incomplete phi, completed when the block is
// sealed. Structured control flow makes the sealing points obvious.
//
// Semantics are those of the 0.1 code generator (gen.tach): the same
// evaluation order, the same calling convention (compound arguments are
// passed as a pointer to a private copy, compound results through a
// result pointer), and the same arithmetic.

// An open-addressing hash map from i64 keys (never 0) to i64 values.
use crate::base::*;
use crate::lexer::*;
use crate::ast::*;
use crate::parser::*;
use crate::types::*;
use crate::check::*;
use crate::consteval::*;
use crate::patterns::*;
use crate::gen::*;
use crate::abi::*;
use crate::target::*;
use crate::ir::*;
use crate::ast::NodeKind::*;

pub struct HMap { keys: *i64, vals: *i64, size: i64, count: i64 }

impl HMap {
    fn slot(self: *HMap, key: i64) -> i64 {
        let mask = (*self).size - 1;
        let mut slot = ((key as u64 * 11400714819323198485) >> 20) as i64 & mask;
        while (*self).keys[slot] != 0 && (*self).keys[slot] != key {
            slot = (slot + 1) & mask;
        }
        slot
    }

    fn get(self: *HMap, key: i64) -> i64 {
        if (*self).size == 0 {
            return 0;
        }
        let slot = self.slot(key);
        if (*self).keys[slot] == key { (*self).vals[slot] } else { 0 }
    }

    fn put(self: *HMap, key: i64, value: i64) {
        if ((*self).count + 1) * 2 > (*self).size {
            self.rehash();
        }
        let slot = self.slot(key);
        if (*self).keys[slot] == 0 {
            (*self).count += 1;
            (*self).keys[slot] = key;
        }
        (*self).vals[slot] = value;
    }

    fn rehash(self: *HMap) {
        let old_keys = (*self).keys;
        let old_vals = (*self).vals;
        let old_size = (*self).size;
        let mut size = old_size * 2;
        if size < 256 {
            size = 256;
        }
        (*self).keys = alloc_array::<i64>(size);
        (*self).vals = alloc_array::<i64>(size);
        (*self).size = size;
        (*self).count = 0;
        for i in 0..old_size {
            if old_keys[i] != 0 {
                self.put(old_keys[i], old_vals[i]);
            }
        }
        if old_size > 0 {
            free(old_keys as *u8);
            free(old_vals as *u8);
        }
    }

    fn clear(self: *HMap) {
        if (*self).size > 0 {
            memset((*self).keys as *u8, 0, ((*self).size * 8) as u64);
        }
        (*self).count = 0;
    }
}

// ---- SSA construction ----

// The current definition of each variable in each block: key
// (var + 1) << 32 | block.
pub static mut DEFS: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
// Incomplete phis: triples (var, phi, next) linked from Block.incomplete
// (index + 1).
static mut INCOMPLETE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Scratch stack for phi operands and call arguments.
pub static mut SSA_STACK: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Types of the synthetic variables (variable LOCAL_COUNT + i).
static mut SYNTH_TY: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Per local: whether it is an SSA variable, and the address of its
// storage otherwise.
static mut PROMOTE: *i64 = 0 as *i64;
static mut LOCAL_ADDR: *i64 = 0 as *i64;
// Per loop (NODES[loop].z): continue block, exit block, break variable.
static mut LOOP_INFO: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

fn def_key(var: i64, b: i64) -> i64 {
    ((var + 1) << 32) | b
}

fn var_type(var: i64) -> i64 {
    if var < LOCAL_COUNT {
        return ir_type(LOCALS[var].ty);
    }
    SYNTH_TY.data[var - LOCAL_COUNT]
}

pub fn new_synth_var(ty: i64) -> i64 {
    SYNTH_TY.push(ty);
    LOCAL_COUNT + SYNTH_TY.count - 1
}

pub fn ssa_write(var: i64, b: i64, value: i64) {
    DEFS.put(def_key(var, b), value);
}

pub fn ssa_read(var: i64, b: i64) -> i64 {
    let v = DEFS.get(def_key(var, b));
    if v != 0 {
        return ir_val(v);
    }
    ssa_read_recursive(var, b)
}

// An undefined value of type `ty`: 0, placed in the entry block.
pub fn ssa_undef(ty: i64) -> i64 {
    let v = ir_make(Op::Const, ty, 0, 0, 0);
    ir_prepend(IRFUNCS[IRF].entry, v);
    v
}

fn new_phi(var: i64, b: i64) -> i64 {
    let phi = ir_make(Op::Phi, var_type(var), 0, 0, 0);
    ir_prepend(b, phi);
    phi
}

fn ssa_read_recursive(var: i64, b: i64) -> i64 {
    let mut value = 0;
    let preds = BLOCKS[b].preds.count;
    if BLOCKS[b].sealed == 0 {
        value = new_phi(var, b);
        INCOMPLETE.push(var);
        INCOMPLETE.push(value);
        INCOMPLETE.push(BLOCKS[b].incomplete);
        BLOCKS[b].incomplete = INCOMPLETE.count / 3;
    } else if preds == 1 {
        value = ssa_read(var, BLOCKS[b].preds.data[0]);
    } else if preds == 0 {
        value = ssa_undef(var_type(var));
    } else {
        let phi = new_phi(var, b);
        ssa_write(var, b, phi);
        value = add_phi_operands(var, phi);
    }
    ssa_write(var, b, value);
    value
}

fn add_phi_operands(var: i64, phi: i64) -> i64 {
    let b = INSTS[phi].block;
    let mark = SSA_STACK.count;
    for i in 0..BLOCKS[b].preds.count {
        let pred = BLOCKS[b].preds.data[i];
        let value = ssa_read(var, pred);
        SSA_STACK.push(value);
    }
    let count = SSA_STACK.count - mark;
    INSTS[phi].args = ARGS.count;
    INSTS[phi].nargs = count;
    for i in 0..count {
        ARGS.push(SSA_STACK.data[mark + i]);
        ARGTY.push(0);
    }
    SSA_STACK.count = mark;
    try_remove_trivial_phi(phi)
}

// A phi whose operands are all the same value (or itself) is that value.
fn try_remove_trivial_phi(phi: i64) -> i64 {
    let mut same = 0;
    for i in 0..INSTS[phi].nargs {
        let operand = ir_val(ir_arg(phi, i));
        if operand == same || operand == phi {
            continue;
        }
        if same != 0 {
            return phi;
        }
        same = operand;
    }
    if same == 0 {
        same = ssa_undef(INSTS[phi].ty);
    }
    ir_replace(phi, same);
    same
}

pub fn ir_seal(b: i64) {
    let mut entry = BLOCKS[b].incomplete;
    while entry != 0 {
        let at = (entry - 1) * 3;
        let var = INCOMPLETE.data[at];
        let phi = INCOMPLETE.data[at + 1];
        add_phi_operands(var, phi);
        entry = INCOMPLETE.data[at + 2];
    }
    BLOCKS[b].incomplete = 0;
    BLOCKS[b].sealed = 1;
}

// ---- Blocks during lowering ----

// A block that no edge reaches (code after `return`, `break`, ...).
fn is_dead_block(b: i64) -> bool {
    BLOCKS[b].sealed != 0 && BLOCKS[b].preds.count == 0 && b != IRFUNCS[IRF].entry
}

fn start_dead_block() {
    let b = ir_new_block();
    BLOCKS[b].sealed = 1;
    CUR = b;
}

// Ends the current block with a jump (no edge from a dead block).
fn lower_jump(target: i64) {
    if is_dead_block(CUR) {
        ir_terminate(CUR, Term::Unreach, 0, 0, 0);
    } else {
        ir_terminate(CUR, Term::Jump, 0, target, 0);
    }
}

fn lower_branch(cond: i64, if_true: i64, if_false: i64) {
    if is_dead_block(CUR) {
        ir_terminate(CUR, Term::Unreach, 0, 0, 0);
    } else {
        ir_terminate(CUR, Term::Branch, cond, if_true, if_false);
    }
}

// ---- The program ----

// Lowers every function to IR.
pub fn lower_program(program: i64) {
    init_ir();
    PROMOTE = alloc_array::<i64>(LOCAL_COUNT + 1);
    LOCAL_ADDR = alloc_array::<i64>(LOCAL_COUNT + 1);
    for local in 0..LOCAL_COUNT {
        let ty = LOCALS[local].ty;
        PROMOTE[local] = if is_void(ty) || is_compound(ty) { 0 } else { 1 };
    }
    // A local whose address is taken lives in memory.
    for n in 1..NODE_COUNT {
        if NODES[n].kind == Unary && NODES[n].op == Tok::Amp {
            let operand = NODES[n].b;
            if NODES[operand].kind == Ident && NODES[operand].res == Res::Local {
                PROMOTE[NODES[operand].y] = 0;
            }
        }
    }
    for i in 0..NODES[program].count {
        let item = child(program, i);
        if NODES[item].kind == Fn {
            lower_function(item);
        }
    }
}

fn lower_function(item: i64) {
    let f = NODES[item].x - 1;
    IRF = ir_new_func(f, item);
    DEFS.clear();
    let entry = ir_new_block();
    IRFUNCS[IRF].entry = entry;
    BLOCKS[entry].sealed = 1;
    CUR = entry;
    let ret = FNS[f].ret;
    let c = fn_uses_c(f);
    if conv_returns_through_pointer(c, ret) {
        IRFUNCS[IRF].result_ptr = emit_ir(Op::Param, TY_U64, 0, 0, -1);
    }
    for i in 0..FNS[f].param_count {
        let ty = fn_param(f, i);
        let local = NODES[child(item, i)].x;
        if is_void(ty) || local < 0 {
            continue;
        }
        let kind = conv_classify(c, ty);
        if kind == AbiClass::Pieces {
            // Stored from the registers (or stack slots) of its pieces:
            // NodeKind::Param imm2 = the piece + 1.
            let slot = ir_slot_addr(new_slot_for(ty));
            for k in 0..ABI_PIECE_COUNT {
                let piece = emit_ir(Op::Param, ABI_PIECE_TY[k], 0, 0, i);
                INSTS[piece].imm2 = k + 1;
                ir_store(ABI_PIECE_TY[k], slot, piece, ABI_PIECE_OFFSET[k]);
            }
            bind_local(local, slot, ty, true);
            continue;
        }
        let param = emit_ir(Op::Param, ir_type(ty), 0, 0, i);
        if kind == AbiClass::Stack {
            // The address of the caller's copy on the stack.
            INSTS[param].imm2 = -1;
        }
        // A compound parameter points to the caller's private copy.
        bind_local(local, param, ty, true);
    }
    let body = NODES[item].c;
    let value = lower_block(body);
    if NODES[body].ty != TY_NEVER {
        lower_return(value);
    }
    if BLOCKS[CUR].term == Term::None {
        ir_terminate(CUR, Term::Unreach, 0, 0, 0);
    }
}

fn lower_return(value: i64) {
    let f = IRFUNCS[IRF].f;
    let ret = FNS[f].ret;
    let mut result = 0;
    let c = fn_uses_c(f);
    if conv_returns_through_pointer(c, ret) {
        lower_copy(IRFUNCS[IRF].result_ptr, value, type_size(ret));
        if X86 && c {
            // Returned in rax, as C does.
            result = IRFUNCS[IRF].result_ptr;
        }
    } else if is_compound(ret) {
        // Returned in registers: its pieces, read from a multiple of 8
        // bytes, packed for the RET.
        let mut addr = need_value(value, ret);
        if type_size(ret) % 8 != 0 && INSTS[addr].op != Op::Slot {
            let copy = ir_slot_addr(new_slot_for(ret));
            lower_copy(copy, addr, type_size(ret));
            addr = copy;
        }
        conv_classify(c, ret);
        let count = ABI_PIECE_COUNT;
        let mut tys: [i64; 4] = [0; 4];
        let mut offsets: [i64; 4] = [0; 4];
        for k in 0..count {
            tys[k] = ABI_PIECE_TY[k];
            offsets[k] = ABI_PIECE_OFFSET[k];
        }
        let mark = SSA_STACK.count;
        for k in 0..count {
            push_arg(ir_load(tys[k], addr, offsets[k]), tys[k]);
        }
        result = emit_ir(Op::Pack, 0, 0, 0, 0);
        take_args(result, mark);
    } else if is_void(ret) {
        // `main` without a result exits with 0.
        if FNS[f].name == MAIN_SYM {
            result = ir_const(0, TY_I64);
        }
    } else {
        result = need_value(value, ret);
    }
    if !is_dead_block(CUR) {
        ir_terminate(CUR, Term::Ret, result, 0, 0);
    } else {
        ir_terminate(CUR, Term::Unreach, 0, 0, 0);
    }
    start_dead_block();
}

// ---- Statements and bindings ----

fn lower_block(block: i64) -> i64 {
    for i in 0..NODES[block].count {
        let stmt = child(block, i);
        if NODES[stmt].kind == Let {
            lower_let(stmt);
        } else {
            lower_expr(NODES[stmt].a);
        }
    }
    if NODES[block].a != 0 {
        return lower_expr(NODES[block].a);
    }
    0
}

// Expressions whose compound value is a new temporary, which a binding or
// an argument may take over without copying.
pub fn is_fresh(n: i64) -> bool {
    match NODES[n].kind {
        StructLit | Tuple | Array | Repeat
            | Call | Str | VariantLit => true,
        Index => NODES[NODES[n].b].kind == Range,
        _ => false,
    }
}

fn lower_let(stmt: i64) {
    let init = NODES[stmt].c;
    let value = lower_expr(init);
    if NODES[init].ty == TY_NEVER {
        return;
    }
    bind_pattern_ir(NODES[stmt].a, value, is_fresh(init));
}

fn bind_pattern_ir(pattern: i64, value: i64, fresh: bool) {
    let kind = NODES[pattern].kind;
    let ty = NODES[pattern].ty;
    if kind == PatWild || ty == TY_NEVER {
        return;
    }
    if kind == PatBind {
        bind_local(NODES[pattern].x, value, ty, fresh);
        return;
    }
    for i in 0..NODES[pattern].count {
        let mut elem_ty = 0;
        let mut offset = 0;
        if kind == PatVariant {
            elem_ty = variant_field(NODES[pattern].x, i);
            offset = variant_field_offset(NODES[pattern].x, i);
        } else {
            elem_ty = type_elem(ty, i);
            offset = tuple_offset(ty, i);
        }
        let mut elem = 0;
        if is_compound(elem_ty) {
            elem = ir_offset(value, offset);
        } else if !is_void(elem_ty) {
            elem = ir_load(ir_type(elem_ty), value, offset);
        }
        bind_pattern_ir(child(pattern, i), elem, false);
    }
}

// Binds local `local` (of type `ty`) to `value` (the address of a compound
// value, taken over when `fresh`).
fn bind_local(local: i64, value: i64, ty: i64, fresh: bool) {
    if is_void(ty) {
        return;
    }
    if PROMOTE[local] != 0 {
        ssa_write(local, CUR, need_value(value, ty));
        return;
    }
    if is_compound(ty) && fresh {
        LOCAL_ADDR[local] = value;
        return;
    }
    let addr = ir_slot_addr(new_slot_for(ty));
    if is_compound(ty) {
        lower_copy(addr, value, type_size(ty));
    } else {
        ir_store(ir_type(ty), addr, need_value(value, ty), 0);
    }
    LOCAL_ADDR[local] = addr;
}

// A frame slot for a value of type `ty`; compound values get a multiple of
// 8 bytes, so that they can be read and written in 8-byte pieces.
fn new_slot_for(ty: i64) -> i64 {
    let size = if is_compound(ty) { align_to(type_size(ty), 8) } else { type_size(ty) };
    let slot = ir_new_slot(size, type_align(ty));
    SLOTS[slot].ty = ty;
    slot
}

// Copies `size` bytes from `src` to `dst`.
fn lower_copy(dst: i64, src: i64, size: i64) {
    if size == 0 {
        return;
    }
    if size <= INLINE_COPY_MAX {
        let v = emit_ir(Op::Copy, 0, dst, src, size);
        INSTS[v].imm2 = 0;
        return;
    }
    let mark = SSA_STACK.count;
    push_arg(dst, TY_U64);
    push_arg(src, TY_U64);
    push_arg(ir_const(size, TY_U64), TY_U64);
    let call = emit_ir(Op::CallC, 0, 0, 0, intern_c(c"memcpy"));
    take_args(call, mark);
}

// ---- Expressions ----

// `value`, or an undefined value of type `ty` when there is none (in code
// after a diverging expression).
fn need_value(value: i64, ty: i64) -> i64 {
    if value != 0 || is_void(ty) {
        return value;
    }
    ssa_undef(ir_type(ty))
}

fn lower_operand(n: i64) -> i64 {
    need_value(lower_expr(n), NODES[n].ty)
}

fn load_scalar(addr: i64, ty: i64) -> i64 {
    if is_compound(ty) {
        return addr;
    }
    if is_void(ty) {
        return 0;
    }
    ir_load(ir_type(ty), addr, 0)
}

fn lower_expr(n: i64) -> i64 {
    let value = lower_expr_inner(n);
    if NODES[n].ty == TY_NEVER {
        if !is_dead_block(CUR) {
            ir_terminate(CUR, Term::Unreach, 0, 0, 0);
            start_dead_block();
        }
        return 0;
    }
    value
}

fn lower_expr_inner(n: i64) -> i64 {
    let ty = NODES[n].ty;
    match NODES[n].kind {
        Int | Char => ir_const(wrap_int(NODES[n].a, ty), ir_type(ty)),
        Float => ir_const(float_const(f64_of_bits(NODES[n].a), ty), ty),
        Bool => ir_const(NODES[n].a, TY_BOOL),
        Unit => 0,
        Str => lower_string(n),
        CStr => emit_ir(Op::SAddr, TY_U64, 0, 0, NODES[n].a),
        Ident => lower_ident(n),
        Binary => lower_binary(n),
        Unary => lower_unary(n),
        Cast => {
            let operand = NODES[n].a;
            let value = lower_expr(operand);
            lower_cast(value, NODES[operand].ty, ty)
        }
        Call => lower_call(n),
        Index if NODES[NODES[n].b].kind == Range => lower_slicing(n),
        Index | FieldAccess | TupleField => load_scalar(lower_addr(n), ty),
        VariantLit => lower_variant(n),
        Match => lower_match(n),
        Tuple | Array | StructLit => lower_aggregate(n),
        Repeat => lower_repeat(n),
        NodeKind::Block => lower_block(n),
        If => lower_if(n),
        Loop | While => lower_loop(n),
        For => {
            lower_for(n);
            0
        }
        Assign => {
            lower_assign(n);
            0
        }
        EnumPanic => {
            let operand = NODES[n].a;
            let value = lower_cast(lower_operand(operand), NODES[operand].ty, TY_I64);
            lower_panic(NODES[n].x, value);
            0
        }
        Return => {
            let mut value = 0;
            if NODES[n].a != 0 {
                value = lower_expr(NODES[n].a);
            }
            lower_return(value);
            0
        }
        Break => {
            lower_break(n);
            0
        }
        Continue => {
            let info = NODES[NODES[n].x].z;
            lower_jump(LOOP_INFO.data[info]);
            start_dead_block();
            0
        }
        _ => type_error(n, c"internal error: unexpected node in IR lowering"),
    }
}

fn lower_string(n: i64) -> i64 {
    let base = ir_slot_addr(new_slot_for(TY_STRING));
    ir_store(TY_U64, base, emit_ir(Op::SAddr, TY_U64, 0, 0, NODES[n].a), 0);
    ir_store(TY_U64, base, ir_const(STRS[NODES[n].a].len as i64, TY_U64), 8);
    base
}

fn lower_ident(n: i64) -> i64 {
    let ty = NODES[n].ty;
    let resolution = NODES[n].res;
    let index = NODES[n].y;
    if resolution == Res::Local {
        if is_void(ty) {
            return 0;
        }
        if PROMOTE[index] != 0 {
            return ssa_read(index, CUR);
        }
        return load_scalar(LOCAL_ADDR[index], ty);
    }
    if resolution == Res::Const {
        return ir_const(const_value(index), ir_type(ty));
    }
    if resolution == Res::Static {
        return load_scalar(emit_ir(Op::GAddr, TY_U64, 0, 0, NODES[n].a), ty);
    }
    emit_ir(Op::FAddr, TY_U64, 0, 0, index)
}

// The address of a place (or of a compound value).
fn lower_addr(n: i64) -> i64 {
    match NODES[n].kind {
        Ident if NODES[n].res == Res::Local => {
            let local = NODES[n].y;
            if PROMOTE[local] != 0 {
                type_error(n, c"internal error: address of an SSA variable");
            }
            LOCAL_ADDR[local]
        }
        Ident if NODES[n].res == Res::Static => emit_ir(Op::GAddr, TY_U64, 0, 0, NODES[n].a),
        Unary if NODES[n].op == Tok::Star => lower_operand(NODES[n].b),
        FieldAccess => {
            let addr = lower_operand(NODES[n].a);
            ir_offset(addr, field_offset_of(n))
        }
        TupleField => {
            let base = NODES[n].a;
            let addr = lower_operand(base);
            ir_offset(addr, tuple_offset(NODES[base].ty, NODES[n].b))
        }
        Index => {
            let base = NODES[n].a;
            let base_ty = NODES[base].ty;
            let elem_size = type_size(TYPES[base_ty].a);
            let mut addr = lower_operand(base);
            let index = lower_operand(NODES[n].b);
            if is_slice(base_ty) {
                let length = ir_load(TY_U64, addr, 8);
                lower_check(ir_cmp(Cond::Lt, TY_U64, index, length),
                            panic_kind(NODES[NODES[n].b].ty, false), index, length, 0);
                addr = ir_load(TY_U64, addr, 0);
            }
            let mut scaled = index;
            if elem_size != 1 {
                scaled = ir_binary(Op::Mul, TY_U64, index, ir_const(elem_size, TY_U64));
            }
            ir_binary(Op::Add, TY_U64, addr, scaled)
        }
        _ => lower_operand(n),
    }
}

// ---- Operators ----

fn arith_op(token: Tok) -> Op {
    match token {
        Tok::Plus => Op::Add,
        Tok::Minus => Op::Sub,
        Tok::Star => Op::Mul,
        Tok::Slash => Op::Div,
        Tok::Percent => Op::Rem,
        Tok::Amp => Op::And,
        Tok::Pipe => Op::Or,
        Tok::Caret => Op::Xor,
        Tok::Shl => Op::Shl,
        _ => Op::Shr,
    }
}

// a <token> b, for operands of type `operand_ty` and a result of type `ty`.
fn lower_operator(token: Tok, operand_ty: i64, ty: i64, a: i64, b: i64) -> i64 {
    if is_comparison(token) {
        return ir_cmp(cond_of_token(token), ir_type(operand_ty), a, b);
    }
    if is_float(ty) && token == Tok::Percent {
        let mark = SSA_STACK.count;
        push_arg(a, ty);
        push_arg(b, ty);
        let call = emit_ir(Op::CallC, ty, 0, 0, intern_c(if ty == TY_F32 { c"fmodf" } else { c"fmod" }));
        take_args(call, mark);
        return call;
    }
    ir_binary(arith_op(token), ir_type(ty), a, b)
}

fn lower_binary(n: i64) -> i64 {
    let op = NODES[n].op;
    let lhs = NODES[n].b;
    let rhs = NODES[n].c;
    if op == Tok::AmpAmp || op == Tok::PipePipe {
        return lower_short_circuit(op, lhs, rhs);
    }
    let a = lower_operand(lhs);
    let b = lower_operand(rhs);
    lower_operator(op, NODES[lhs].ty, NODES[n].ty, a, b)
}

fn lower_short_circuit(op: Tok, lhs: i64, rhs: i64) -> i64 {
    let result = new_synth_var(TY_BOOL);
    let a = lower_operand(lhs);
    ssa_write(result, CUR, a);
    let rhs_block = ir_new_block();
    let join = ir_new_block();
    if op == Tok::AmpAmp {
        lower_branch(a, rhs_block, join);
    } else {
        lower_branch(a, join, rhs_block);
    }
    ir_seal(rhs_block);
    CUR = rhs_block;
    let b = lower_operand(rhs);
    ssa_write(result, CUR, b);
    lower_jump(join);
    ir_seal(join);
    CUR = join;
    ssa_read(result, join)
}

fn lower_unary(n: i64) -> i64 {
    let op = NODES[n].op;
    let operand = NODES[n].b;
    let ty = NODES[n].ty;
    if op == Tok::Amp {
        return lower_addr(operand);
    }
    let value = lower_operand(operand);
    if op == Tok::Minus {
        return emit_ir(Op::Neg, ir_type(ty), value, 0, 0);
    }
    if op == Tok::Bang {
        return emit_ir(Op::Not, TY_BOOL, value, 0, 0);
    }
    if op == Tok::Tilde {
        return emit_ir(Op::BNot, ir_type(ty), value, 0, 0);
    }
    load_scalar(value, ty)
}

fn ir_conv(value: i64, from: i64, to: i64) -> i64 {
    let v = emit_ir(Op::Conv, to, value, 0, 0);
    INSTS[v].imm2 = from;
    v
}

fn lower_cast(value: i64, checker_from: i64, to: i64) -> i64 {
    let from = scalar_type(checker_from);
    if from == TY_NEVER || from == to || from == TY_BOOL {
        return value;
    }
    let operand = need_value(value, from);
    if is_float(from) || is_float(to) {
        return ir_conv(operand, ir_type(from), ir_type(to));
    }
    // Integers and pointers: truncate or extend to `to`.
    if !is_integer(to) || int_bits(to) == 64 {
        return operand;
    }
    ir_conv(operand, ir_type(from), to)
}

// ---- Calls ----

fn push_arg(value: i64, ty: i64) {
    SSA_STACK.push(value);
    SSA_STACK.push(ty);
}

// Moves the arguments pushed since `mark` into call `call`.
fn take_args(call: i64, mark: i64) {
    let count = (SSA_STACK.count - mark) / 2;
    INSTS[call].args = ARGS.count;
    INSTS[call].nargs = count;
    for i in 0..count {
        ARGS.push(SSA_STACK.data[mark + 2 * i]);
        ARGTY.push(SSA_STACK.data[mark + 2 * i + 1]);
    }
    SSA_STACK.count = mark;
}

fn lower_call(n: i64) -> i64 {
    let callee = NODES[n].a;
    let direct = NODES[n].x - 1;
    let mut param_count = 0;
    let mut ret = 0;
    let mut variadic = false;
    let mut callee_ty = 0;
    let mut c = true;
    if direct >= 0 {
        param_count = FNS[direct].param_count;
        ret = FNS[direct].ret;
        variadic = FNS[direct].variadic;
        c = fn_uses_c(direct);
    } else {
        callee_ty = NODES[callee].ty;
        param_count = TYPES[callee_ty].count;
        ret = TYPES[callee_ty].a;
        c = fn_type_uses_c(callee_ty);
    }
    let mark = SSA_STACK.count;
    for i in 0..NODES[n].count {
        let arg = child(n, i);
        let mut ty = NODES[arg].ty;
        if i < param_count {
            ty = if direct >= 0 { fn_param(direct, i) } else { type_elem(callee_ty, i) };
        }
        let mut value = lower_expr(arg);
        if is_void(ty) {
            continue;
        }
        value = need_value(value, ty);
        let extra = variadic && i >= param_count;
        if is_compound(ty) {
            if !is_fresh(arg) {
                let copy = ir_slot_addr(new_slot_for(ty));
                lower_copy(copy, value, type_size(ty));
                value = copy;
            }
            let kind = if extra { variadic_kind(ty) } else { conv_classify(c, ty) };
            if kind == AbiClass::Pieces {
                // Its pieces, read from the (new) slot; a variadic one's
                // first piece carries its type (see call_locations).
                for k in 0..ABI_PIECE_COUNT {
                    let piece = ir_load(ABI_PIECE_TY[k], value, ABI_PIECE_OFFSET[k]);
                    let mut arg_ty = ABI_PIECE_TY[k];
                    if extra {
                        arg_ty = if k == 0 { 0 - ty } else { VARIADIC_PIECE };
                    }
                    push_arg(piece, arg_ty);
                }
                continue;
            }
            push_arg(value, if extra { 0 - ty } else { ty });
            continue;
        }
        if extra && ty == TY_F32 {
            // C's default promotion.
            value = ir_conv(value, TY_F32, TY_F64);
            ty = TY_F64;
        }
        let arg_ty = scalar_type(ty);
        push_arg(value, if extra { 0 - arg_ty } else { arg_ty });
    }
    let mut callee_value = 0;
    if direct < 0 {
        callee_value = lower_operand(callee);
    }
    let mut result_ptr = 0;
    if is_compound(ret) {
        result_ptr = ir_slot_addr(new_slot_for(ret));
    }
    let result_ty = if is_compound(ret) { 0 } else { ir_type(ret) };
    let mut call = 0;
    if direct >= 0 {
        call = emit_ir(Op::Call, result_ty, 0, 0, direct);
    } else {
        call = emit_ir(Op::CallI, result_ty, callee_value, 0, callee_ty);
    }
    let in_registers = is_compound(ret) && !conv_returns_through_pointer(c, ret);
    INSTS[call].c = if in_registers { 0 } else { result_ptr };
    take_args(call, mark);
    if in_registers {
        // Its pieces, from the result registers (PIECE instructions right
        // after the call), stored into the result's slot.
        conv_classify(c, ret);
        let count = ABI_PIECE_COUNT;
        let mut pieces: [i64; 4] = [0; 4];
        for k in 0..count {
            pieces[k] = emit_ir(Op::Piece, ABI_PIECE_TY[k], call, 0, k);
        }
        for k in 0..count {
            ir_store(ABI_PIECE_TY[k], result_ptr, pieces[k], ABI_PIECE_OFFSET[k]);
        }
    }
    if is_compound(ret) {
        return result_ptr;
    }
    if result_ty == 0 {
        return 0;
    }
    call
}

// ---- Checks ----

// Continues when `ok` holds; otherwise calls the run-time helper (see
// emit_panic) with kind, a, b and c, which does not return.
fn lower_check(ok: i64, kind: i64, a: i64, b: i64, c: i64) {
    PANIC_USED = true;
    let pass = ir_new_block();
    let fail = ir_new_block();
    lower_branch(ok, pass, fail);
    ir_seal(fail);
    CUR = fail;
    let mark = SSA_STACK.count;
    push_arg(ir_const(kind, TY_U64), TY_U64);
    push_arg(a, TY_U64);
    push_arg(b, TY_U64);
    push_arg(if c != 0 { c } else { ir_const(0, TY_U64) }, TY_U64);
    let call = emit_ir(Op::CallC, 0, 0, 0, rt_panic_sym());
    take_args(call, mark);
    ir_terminate(CUR, Term::Unreach, 0, 0, 0);
    ir_seal(pass);
    CUR = pass;
}

// A failed `n as E`: the run-time helper with the value; does not return.
fn lower_panic(kind: i64, a: i64) {
    PANIC_USED = true;
    let mark = SSA_STACK.count;
    push_arg(ir_const(kind, TY_U64), TY_U64);
    push_arg(a, TY_U64);
    push_arg(ir_const(0, TY_U64), TY_U64);
    push_arg(ir_const(0, TY_U64), TY_U64);
    let call = emit_ir(Op::CallC, 0, 0, 0, rt_panic_sym());
    take_args(call, mark);
    ir_terminate(CUR, Term::Unreach, 0, 0, 0);
    start_dead_block();
}

// ---- Enums and slices ----

fn lower_variant(n: i64) -> i64 {
    let ty = NODES[n].ty;
    let v = NODES[n].a;
    let tag = ENUMS[TYPES[ty].a].tag;
    let discr = wrap_int(VARIANTS[v].discr, tag);
    if !is_compound(ty) {
        return ir_const(discr, tag);
    }
    let base = ir_slot_addr(new_slot_for(ty));
    for i in 0..NODES[n].count {
        let value = lower_expr(child(n, i));
        store_value(base, variant_field_offset(v, i), value, variant_field(v, i));
    }
    ir_store(tag, base, ir_const(discr, tag), 0);
    base
}

// `a[lo..hi]`: as gen_slicing (gen.tach).
fn lower_slicing(n: i64) -> i64 {
    let base = NODES[n].a;
    let base_ty = NODES[base].ty;
    let range = NODES[n].b;
    let low = NODES[range].a;
    let high = NODES[range].b;
    let inclusive = NODES[range].c != 0;
    let elem_size = type_size(TYPES[base_ty].a);
    let value = lower_operand(base);
    let mut pointer = value;
    let mut length = 0;
    if is_slice(base_ty) {
        pointer = ir_load(TY_U64, value, 0);
        length = ir_load(TY_U64, value, 8);
    } else if TYPES[base_ty].kind == TyKind::Array {
        length = ir_const(TYPES[base_ty].b, TY_U64);
    }
    let mut bound_ty = TY_U64;
    let mut lo = 0;
    if low != 0 {
        lo = lower_operand(low);
        bound_ty = NODES[low].ty;
    } else {
        lo = ir_const(0, TY_U64);
    }
    let mut hi = 0;
    if high != 0 {
        hi = lower_operand(high);
        bound_ty = NODES[high].ty;
    } else {
        hi = length;
    }
    let mut end = hi;
    if inclusive {
        end = ir_binary(Op::Add, TY_U64, hi, ir_const(1, TY_U64));
    }
    if TYPES[base_ty].kind != TyKind::Ptr {
        let kind = panic_kind(bound_ty, true);
        lower_check(ir_cmp(if inclusive { Cond::Lt } else { Cond::Le }, TY_U64, hi, length), kind, lo, end, length);
        lower_check(ir_cmp(Cond::Le, TY_U64, lo, end), kind, lo, end, length);
    }
    let mut scaled = lo;
    if elem_size != 1 {
        scaled = ir_binary(Op::Mul, TY_U64, lo, ir_const(elem_size, TY_U64));
    }
    let result = ir_slot_addr(new_slot_for(NODES[n].ty));
    ir_store(TY_U64, result, ir_binary(Op::Add, TY_U64, pointer, scaled), 0);
    ir_store(TY_U64, result, ir_binary(Op::Sub, TY_U64, end, lo), 8);
    result
}

// ---- match ----

// As gen_match (gen.tach): the arms in order, each pattern tested by
// branches to the next arm.
fn lower_match(n: i64) -> i64 {
    let ty = NODES[n].ty;
    let scrutinee = NODES[n].a;
    let st = NODES[scrutinee].ty;
    let has_value = !is_void(ty);
    let mut result = 0;
    if has_value {
        result = join_new(ty);
    }
    let value = lower_operand(scrutinee);
    if st == TY_NEVER {
        return 0;
    }
    let join = ir_new_block();
    if switch_cases(n, st) {
        lower_match_switch(n, st, value, result, join);
        ir_seal(join);
        CUR = join;
        if has_value {
            return join_read(result, join);
        }
        return 0;
    }
    for i in 0..NODES[n].count {
        let arm = child(n, i);
        let fail = ir_new_block();
        alloc_pattern_locals(NODES[arm].a);
        lower_pattern_test(NODES[arm].a, st, value, fail);
        if NODES[arm].b != 0 {
            let guard = lower_operand(NODES[arm].b);
            let body = ir_new_block();
            lower_branch(guard, body, fail);
            ir_seal(body);
            CUR = body;
        }
        let body = NODES[arm].c;
        let v = lower_expr(body);
        if has_value && NODES[body].ty != TY_NEVER {
            join_write(result, v, ty);
        }
        lower_jump(join);
        ir_seal(fail);
        CUR = fail;
    }
    if !is_dead_block(CUR) {
        ir_terminate(CUR, Term::Unreach, 0, 0, 0);
    }
    ir_seal(join);
    CUR = join;
    if has_value {
        return join_read(result, join);
    }
    0
}

// The storage of the locals a pattern binds that live in memory (once: the
// alternatives of an or-pattern bind the same locals).
fn alloc_pattern_locals(p: i64) {
    let kind = NODES[p].kind;
    if kind == PatBind {
        let local = NODES[p].x;
        let ty = LOCALS[local].ty;
        if PROMOTE[local] == 0 && !is_void(ty) {
            LOCAL_ADDR[local] = ir_slot_addr(new_slot_for(ty));
        }
        return;
    }
    if kind == PatTuple || kind == PatVariant || kind == PatOr {
        for i in 0..NODES[p].count {
            alloc_pattern_locals(child(p, i));
        }
    }
}

// Branches to `fail` unless `value` (of checker type ty; the address of a
// compound value) matches pattern p; binds its variables.
fn lower_pattern_test(p: i64, ty: i64, value: i64, fail: i64) {
    let kind = NODES[p].kind;
    if ty == TY_NEVER {
        return;
    }
    match kind {
        PatWild => return,
        PatBind => {
            let local = NODES[p].x;
            if is_void(ty) {
                return;
            }
            if PROMOTE[local] != 0 {
                ssa_write(local, CUR, need_value(value, ty));
            } else if is_compound(ty) {
                lower_copy(LOCAL_ADDR[local], value, type_size(ty));
            } else {
                ir_store(ir_type(ty), LOCAL_ADDR[local], need_value(value, ty), 0);
            }
            return;
        }
        PatLit => {
            let t = ir_type(ty);
            test_or_fail(ir_cmp(Cond::Eq, t, value, ir_const(NODES[p].x, t)), fail);
            return;
        }
        PatRange => {
            let t = ir_type(ty);
            test_or_fail(ir_cmp(Cond::Ge, t, value, ir_const(NODES[p].x, t)), fail);
            test_or_fail(ir_cmp(Cond::Le, t, value, ir_const(NODES[p].y, t)), fail);
            return;
        }
        PatOr => {
            let ok = ir_new_block();
            let last = NODES[p].count - 1;
            for i in 0..last {
                let next = ir_new_block();
                lower_pattern_test(child(p, i), ty, value, next);
                lower_jump(ok);
                ir_seal(next);
                CUR = next;
            }
            lower_pattern_test(child(p, last), ty, value, fail);
            lower_jump(ok);
            ir_seal(ok);
            CUR = ok;
            return;
        }
        PatVariant => {
            let v = NODES[p].x;
            let tag = ENUMS[TYPES[ty].a].tag;
            let tag_value = if is_compound(ty) { ir_load(tag, value, 0) } else { value };
            test_or_fail(ir_cmp(Cond::Eq, tag, tag_value, ir_const(wrap_int(VARIANTS[v].discr, tag), tag)), fail);
        }
        _ => {}
    }
    for i in 0..NODES[p].count {
        let sub = child(p, i);
        if NODES[sub].kind == PatWild {
            continue;
        }
        let mut elem_ty = 0;
        let mut offset = 0;
        if kind == PatVariant {
            elem_ty = variant_field(NODES[p].x, i);
            offset = variant_field_offset(NODES[p].x, i);
        } else {
            elem_ty = type_elem(ty, i);
            offset = tuple_offset(ty, i);
        }
        let mut elem = 0;
        if is_compound(elem_ty) {
            elem = ir_offset(value, offset);
        } else if !is_void(elem_ty) {
            elem = ir_load(ir_type(elem_ty), value, offset);
        }
        lower_pattern_test(sub, elem_ty, elem, fail);
    }
}

// ---- match as a switch ----

// The cases of a match lowered to a switch: (value, arm index) pairs, and
// the arm matching every other value (-1: none).
static mut SW_CASES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static mut SW_DEFAULT: i64 = -1;

// Whether match n (on type st) is a switch: no guards; an integer (or
// fieldless enum) scrutinee matched against literals, ranges and their
// alternatives, or an enum matched by variant (whose fields only bind);
// a wildcard or binding last. Collects SW_CASES and SW_DEFAULT.
fn switch_cases(n: i64, st: i64) -> bool {
    let integer = is_integer(scalar_type(st));
    if !integer && !(is_enum(st) && is_compound(st)) {
        return false;
    }
    SW_CASES.count = 0;
    SW_DEFAULT = -1;
    for i in 0..NODES[n].count {
        let arm = child(n, i);
        let p = NODES[arm].a;
        if NODES[arm].b != 0 {
            return false;
        }
        let kind = NODES[p].kind;
        if kind == PatWild || kind == PatBind {
            SW_DEFAULT = i;
            break;
        }
        if !add_switch_values(p, i) {
            return false;
        }
    }
    SW_CASES.count >= 6 || (is_compound(st) && SW_CASES.count >= 4)
}

// Adds the values pattern p matches (for arm i, unless an earlier arm has
// them); false when p is not a set of values.
fn add_switch_values(p: i64, arm: i64) -> bool {
    match NODES[p].kind {
        PatLit => {
            add_switch_value(NODES[p].x, arm);
            true
        }
        PatRange => {
            let ty = scalar_type(NODES[p].ty);
            let count = int_key(NODES[p].y, ty) - int_key(NODES[p].x, ty) + 1;
            if count < 1 || count > 256 || SW_CASES.count + 2 * count > 2048 {
                return false;
            }
            for k in 0..count {
                add_switch_value(wrap_int(NODES[p].x + k, ty), arm);
            }
            true
        }
        PatVariant => {
            for i in 0..NODES[p].count {
                if !is_irrefutable(child(p, i)) {
                    return false;
                }
            }
            let v = NODES[p].x;
            add_switch_value(wrap_int(VARIANTS[v].discr, ENUMS[VARIANTS[v].enum_id].tag), arm);
            true
        }
        PatOr => {
            if binding_count(p) != 0 {
                return false;
            }
            for i in 0..NODES[p].count {
                if !add_switch_values(child(p, i), arm) {
                    return false;
                }
            }
            true
        }
        _ => false,
    }
}

fn add_switch_value(value: i64, arm: i64) {
    let mut i = 0;
    while i < SW_CASES.count {
        if SW_CASES.data[i] == value {
            return;
        }
        i += 2;
    }
    SW_CASES.push(value);
    SW_CASES.push(arm);
}

// Match n as a switch on the scrutinee (or its tag): every arm in a block
// of its own, which binds the pattern's variables and evaluates the body.
fn lower_match_switch(n: i64, st: i64, value: i64, result: i64, join: i64) {
    let mut key = value;
    if is_compound(st) {
        let tag = ENUMS[TYPES[st].a].tag;
        key = ir_load(tag, value, 0);
    }
    // (Matches in the arms reuse SW_CASES and SW_DEFAULT.)
    let catch_all = SW_DEFAULT;
    let first = BLOCK_COUNT;
    for _ in 0..NODES[n].count {
        ir_new_block();
    }
    let mut default = 0;
    if catch_all >= 0 {
        default = first + catch_all;
    } else {
        default = ir_new_block();
    }
    let unreachable = default;
    if is_dead_block(CUR) {
        ir_terminate(CUR, Term::Unreach, 0, 0, 0);
    } else {
        let mark = SSA_STACK.count;
        let mut i = 0;
        while i < SW_CASES.count {
            SSA_STACK.push(SW_CASES.data[i]);
            SSA_STACK.push(first + SW_CASES.data[i + 1]);
            i += 2;
        }
        ir_switch(CUR, key, default, mark);
    }
    let has_value = !is_void(NODES[n].ty);
    for i in 0..NODES[n].count {
        let arm = child(n, i);
        let p = NODES[arm].a;
        CUR = first + i;
        ir_seal(CUR);
        alloc_pattern_locals(p);
        lower_pattern_binds(p, st, value);
        let body = NODES[arm].c;
        let v = lower_expr(body);
        if has_value && NODES[body].ty != TY_NEVER {
            join_write(result, v, NODES[n].ty);
        }
        lower_jump(join);
    }
    if catch_all < 0 {
        CUR = unreachable;
        ir_seal(CUR);
        ir_terminate(CUR, Term::Unreach, 0, 0, 0);
    }
}

// Binds the variables of pattern p, known to match `value`: its fields
// for a variant, the value for a binding.
fn lower_pattern_binds(p: i64, ty: i64, value: i64) {
    let kind = NODES[p].kind;
    if kind == PatBind || kind == PatWild {
        lower_pattern_test(p, ty, value, 0);
        return;
    }
    if kind != PatVariant {
        return;
    }
    let v = NODES[p].x;
    for i in 0..NODES[p].count {
        let sub = child(p, i);
        let elem_ty = variant_field(v, i);
        let offset = variant_field_offset(v, i);
        let mut elem = 0;
        if is_compound(elem_ty) {
            elem = ir_offset(value, offset);
        } else if !is_void(elem_ty) {
            elem = ir_load(ir_type(elem_ty), value, offset);
        }
        lower_pattern_test(sub, elem_ty, elem, 0);
    }
}

// Continues in a new block when `cond` holds, else goes to `fail`.
fn test_or_fail(cond: i64, fail: i64) {
    let next = ir_new_block();
    lower_branch(cond, next, fail);
    ir_seal(next);
    CUR = next;
}

// ---- Aggregates ----

fn lower_aggregate(n: i64) -> i64 {
    let ty = NODES[n].ty;
    let kind = NODES[n].kind;
    let base = ir_slot_addr(new_slot_for(ty));
    for i in 0..NODES[n].count {
        let elem = child(n, i);
        let mut value_node = elem;
        let mut offset = 0;
        let mut elem_ty = 0;
        if kind == StructLit {
            let s = TYPES[ty].a;
            value_node = NODES[elem].b;
            offset = field_offset(s, NODES[elem].x);
            elem_ty = (*struct_field(s, NODES[elem].x)).ty;
        } else if kind == Tuple {
            offset = tuple_offset(ty, i);
            elem_ty = type_elem(ty, i);
        } else {
            elem_ty = TYPES[ty].a;
            offset = i * type_size(elem_ty);
        }
        let value = lower_expr(value_node);
        store_value(base, offset, value, elem_ty);
    }
    base
}

// Stores `value` (of checker type `ty`) at addr + offset.
fn store_value(addr: i64, offset: i64, value: i64, ty: i64) {
    if is_void(ty) {
        return;
    }
    let v = need_value(value, ty);
    if is_compound(ty) {
        lower_copy(ir_offset(addr, offset), v, type_size(ty));
    } else {
        ir_store(ir_type(ty), addr, v, offset);
    }
}

// `[value; count]`: the value is evaluated once.
fn lower_repeat(n: i64) -> i64 {
    let ty = NODES[n].ty;
    let elem_ty = TYPES[ty].a;
    let count = TYPES[ty].b;
    let elem_size = type_size(elem_ty);
    let base = ir_slot_addr(new_slot_for(ty));
    let value = lower_expr(NODES[n].a);
    if count == 0 || is_void(elem_ty) || elem_size == 0 {
        return base;
    }
    if count <= 4 {
        for i in 0..count {
            store_value(base, i * elem_size, value, elem_ty);
        }
        return base;
    }
    let cursor = new_synth_var(TY_U64);
    ssa_write(cursor, CUR, base);
    let end = ir_offset(base, count * elem_size);
    let body = ir_new_block();
    let exit = ir_new_block();
    lower_jump(body);
    CUR = body;
    let at = ssa_read(cursor, body);
    store_value(at, 0, value, elem_ty);
    let next = ir_offset(at, elem_size);
    ssa_write(cursor, CUR, next);
    lower_branch(ir_cmp(Cond::Ne, TY_U64, next, end), body, exit);
    ir_seal(body);
    ir_seal(exit);
    CUR = exit;
    base
}

// ---- Control flow ----

// The value of an expression with several exits (if, match, loop): an SSA
// variable, or for a compound value of up to 128 bytes the address of a
// frame slot every exit copies its value into (which scalar replacement
// sees through), as JOIN_SLOT + the address.
const JOIN_SLOT: i64 = 1 << 40;

fn join_new(ty: i64) -> i64 {
    if is_compound(ty) && type_size(ty) <= 128 {
        return JOIN_SLOT + ir_slot_addr(new_slot_for(ty));
    }
    new_synth_var(ir_type(ty))
}

fn join_write(join: i64, value: i64, ty: i64) {
    if join >= JOIN_SLOT {
        lower_copy(join - JOIN_SLOT, need_value(value, ty), type_size(ty));
    } else {
        ssa_write(join, CUR, need_value(value, ty));
    }
}

fn join_read(join: i64, b: i64) -> i64 {
    if join >= JOIN_SLOT { join - JOIN_SLOT } else { ssa_read(join, b) }
}

fn lower_if(n: i64) -> i64 {
    let ty = NODES[n].ty;
    let has_value = !is_void(ty);
    let mut result = 0;
    if has_value {
        result = join_new(ty);
    }
    let cond = lower_operand(NODES[n].a);
    let then_block = ir_new_block();
    let mut else_block = 0;
    if NODES[n].c != 0 {
        else_block = ir_new_block();
    }
    let join = ir_new_block();
    lower_branch(cond, then_block, if else_block != 0 { else_block } else { join });
    ir_seal(then_block);
    CUR = then_block;
    lower_branch_body(NODES[n].b, result, has_value, join);
    if else_block != 0 {
        ir_seal(else_block);
        CUR = else_block;
        lower_branch_body(NODES[n].c, result, has_value, join);
    }
    ir_seal(join);
    CUR = join;
    if has_value {
        return join_read(result, join);
    }
    0
}

fn lower_branch_body(block: i64, result: i64, has_value: bool, join: i64) {
    let value = lower_block(block);
    if has_value && NODES[block].ty != TY_NEVER {
        join_write(result, value, NODES[block].ty);
    }
    lower_jump(join);
}

fn new_loop_info(n: i64, continue_block: i64, exit: i64, break_var: i64) {
    NODES[n].z = LOOP_INFO.count;
    LOOP_INFO.push(continue_block);
    LOOP_INFO.push(exit);
    LOOP_INFO.push(break_var);
}

// `loop` and `while`.
fn lower_loop(n: i64) -> i64 {
    let header = ir_new_block();
    let exit = ir_new_block();
    let mut break_var = -1;
    if NODES[n].kind == Loop && NODES[n].x != 0 && !is_void(NODES[n].y) {
        break_var = join_new(NODES[n].y);
    }
    new_loop_info(n, header, exit, break_var);
    lower_jump(header);
    CUR = header;
    if NODES[n].kind == While {
        let cond = lower_operand(NODES[n].b);
        let body = ir_new_block();
        lower_branch(cond, body, exit);
        ir_seal(body);
        CUR = body;
        lower_block(NODES[n].c);
    } else {
        lower_block(NODES[n].b);
    }
    lower_jump(header);
    ir_seal(header);
    ir_seal(exit);
    CUR = exit;
    if break_var >= 0 {
        return join_read(break_var, exit);
    }
    0
}

fn lower_break(n: i64) {
    let info = NODES[NODES[n].x].z;
    let value = NODES[n].b;
    let break_var = LOOP_INFO.data[info + 2];
    if value != 0 {
        let v = lower_expr(value);
        if break_var >= 0 && NODES[value].ty != TY_NEVER {
            join_write(break_var, v, NODES[value].ty);
        }
    }
    lower_jump(LOOP_INFO.data[info + 1]);
    start_dead_block();
}

// `for i in a..b`: the bounds are evaluated once; the loop variable is a
// copy of the counter.
fn lower_for(n: i64) {
    let range = NODES[n].c;
    let ty = NODES[range].ty;
    let inclusive = NODES[range].c != 0;
    let counter = new_synth_var(ty);
    let start = lower_operand(NODES[range].a);
    let end = lower_operand(NODES[range].b);
    ssa_write(counter, CUR, start);
    let test = ir_new_block();
    let next = ir_new_block();
    let exit = ir_new_block();
    new_loop_info(n, next, exit, -1);
    lower_jump(test);
    CUR = test;
    let value = ssa_read(counter, test);
    let body = ir_new_block();
    lower_branch(ir_cmp(if inclusive { Cond::Gt } else { Cond::Ge }, ty, value, end), exit, body);
    ir_seal(body);
    CUR = body;
    bind_pattern_ir(NODES[n].b, ssa_read(counter, body), false);
    lower_block(NODES[n].d);
    lower_jump(next);
    ir_seal(next);
    CUR = next;
    let current = ssa_read(counter, next);
    if inclusive {
        let step = ir_new_block();
        lower_branch(ir_cmp(Cond::Eq, ty, current, end), exit, step);
        ir_seal(step);
        CUR = step;
    }
    ssa_write(counter, CUR, ir_binary(Op::Add, ty, current, ir_const(1, ty)));
    lower_jump(test);
    ir_seal(test);
    ir_seal(exit);
    CUR = exit;
}

// ---- Assignment ----

// The right-hand side is evaluated first, then the target's address; a
// compound assignment then reads the old value.
fn lower_assign(n: i64) {
    let op = NODES[n].op;
    let target = NODES[n].b;
    let value = NODES[n].c;
    let ty = NODES[target].ty;
    if NODES[target].kind == Ident && NODES[target].res == Res::Local
        && (PROMOTE[NODES[target].y] != 0 || is_void(ty)) {
        let local = NODES[target].y;
        if is_void(ty) {
            lower_expr(value);
            return;
        }
        let v = lower_operand(value);
        if op == Tok::Eq {
            ssa_write(local, CUR, v);
            return;
        }
        let old = ssa_read(local, CUR);
        ssa_write(local, CUR, lower_operator(arith_op_of_assign(op), ty, ty, old, v));
        return;
    }
    if op == Tok::Eq {
        let v = lower_expr(value);
        let addr = lower_addr(target);
        store_value(addr, 0, v, ty);
        return;
    }
    let v = lower_operand(value);
    let addr = lower_addr(target);
    let old = ir_load(ir_type(ty), addr, 0);
    ir_store(ir_type(ty), addr, lower_operator(arith_op_of_assign(op), ty, ty, old, v), 0);
}
