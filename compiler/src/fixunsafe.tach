// `tachyonc --fix-unsafe FILE...` (0.9): rewrites a program, in place, so
// that its unsafe operations are inside unsafe blocks (see "Unsafe code"
// in check.tach), for 0.10, where an unsafe operation outside unsafe
// code is an error.
//
// The checker notes, for each unsafe operation outside unsafe code, the
// innermost unit around it that can be wrapped: a statement, a block's
// tail, a condition (`if`, `while`, `match`, `for x in`) or a match arm's
// body. Each is wrapped once, the outermost of nested ones:
//
//   - a statement `e;` becomes `unsafe { e; }`, and consecutive such
//     statements share one block, one statement per line;
//   - `let p = e;` becomes `let p = unsafe { e };` (so that the binding
//     stays in scope);
//   - an expression (a tail, a condition, an arm, a deferred statement)
//     becomes `unsafe { e }`.
//
// What is not wrapped is left as it is, byte for byte; a second run finds
// nothing to do.

use crate::base::{
    FILES, FILE_COUNT, IntVec, SRC, STDOUT, buf_byte, buf_bytes, buf_new, buf_slice, buf_str,
    buf_write_fd, buf_write_file,
};
use crate::ast::{NODES, NodeKind};
use crate::modules::{C_MODULE, STD_MODULE, file_of_pos};
use crate::edit::edit_replace;

pub static mut FIX_UNSAFE: bool = false;

// The units to wrap (nodes), each once.
static mut SITES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

pub fn note_unsafe_site(node: i64) {
    if node == 0 {
        return;
    }
    for i in 0..SITES.count {
        if unsafe { SITES.data[i] == node } {
            return;
        }
    }
    SITES.push(node);
}

// The widest line kept on one line.
const LINE_WIDTH: i64 = 100;

// Kinds of ranges: statements ending with `;`, or an expression.
const R_STMT: i64 = 1;
const R_EXPR: i64 = 2;

fn line_start(pos: i64) -> i64 {
    let f = file_of_pos(pos);
    let mut i = pos;
    while unsafe { i > FILES[f].start && SRC[i - 1] != '\n' } {
        i -= 1;
    }
    i
}

fn line_end(pos: i64) -> i64 {
    let f = file_of_pos(pos);
    let mut i = pos;
    while unsafe { i < FILES[f].end && SRC[i] != '\n' } {
        i += 1;
    }
    i
}

fn blank(from: i64, to: i64) -> bool {
    for i in from..to {
        if unsafe { SRC[i] != ' ' && SRC[i] != '\t' && SRC[i] != '\r' && SRC[i] != '\n' } {
            return false;
        }
    }
    true
}

fn has_newline(from: i64, to: i64) -> bool {
    for i in from..to {
        if unsafe { SRC[i] == '\n' } {
            return true;
        }
    }
    false
}

// The text of [from, to) with every line after the first indented by
// four more spaces (blank lines stay empty).
fn push_indented(out: i64, from: i64, to: i64) {
    unsafe {
        let mut at_line_start = false;
        for i in from..to {
            let c = SRC[i];
            if at_line_start && c != '\n' {
                buf_str(out, c"    ");
            }
            buf_byte(out, c);
            at_line_start = c == '\n';
        }
    }
}

// Appends an edit: replace [pos, pos + del) by buffer text.
fn add_edit(edits: *IntVec, pos: i64, del: i64, text: i64) {
    edits.push(pos);
    edits.push(del);
    edits.push(text);
}

// The edit wrapping [s, e) (a range of kind `kind`).
fn wrap_edit(s: i64, e: i64, kind: i64, edits: *IntVec) {
    unsafe {
        let ls = line_start(s);
        let le = line_end(e);
        let alone = blank(ls, s) && blank(e, le);
        let multi = has_newline(s, e);
        if alone && (multi || (kind == R_STMT && (le - ls) + 12 > LINE_WIDTH)) {
            // On lines of their own:
            //     unsafe {
            //         ...
            //     }
            let indent = SRC[ls..s];
            let text = buf_new();
            buf_bytes(text, indent);
            buf_str(text, c"unsafe {\n");
            buf_bytes(text, indent);
            buf_str(text, c"    ");
            push_indented(text, s, e);
            buf_byte(text, '\n');
            buf_bytes(text, indent);
            buf_byte(text, '}');
            add_edit(edits, ls, e - ls, text);
            return;
        }
        let open = buf_new();
        buf_str(open, c"unsafe { ");
        add_edit(edits, s, 0, open);
        let close = buf_new();
        buf_str(close, c" }");
        add_edit(edits, e, 0, close);
    }
}

// The edits wrapping the unsafe operations (to the edit engine,
// edit.tach); returns the number of unsafe blocks made.
pub fn fix_unsafe_edits() -> i64 {
    unsafe {
        // The ranges: start, end, kind.
        let mut ranges = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..SITES.count {
            let w = SITES.data[i];
            let kind = NODES[w].kind;
            let mut s = NODES[w].start;
            let mut e = NODES[w].end;
            let mut k = R_EXPR;
            if kind == NodeKind::Let {
                s = NODES[NODES[w].c].start;
                e = NODES[NODES[w].c].end;
            } else if kind == NodeKind::Defer {
                s = NODES[NODES[w].a].start;
                e = NODES[NODES[w].a].end;
            } else if kind == NodeKind::ExprStmt {
                if NODES[w].b == 1 {
                    k = R_STMT;
                } else {
                    s = NODES[NODES[w].a].start;
                    e = NODES[NODES[w].a].end;
                }
            }
            let f = file_of_pos(s);
            if FILES[f].module == STD_MODULE || FILES[f].module == C_MODULE {
                continue;
            }
            ranges.push(s);
            ranges.push(e);
            ranges.push(k);
        }
        // By start, the outer of nested ranges first (an insertion sort).
        let n = ranges.count / 3;
        for a in 1..n {
            let mut j = a;
            while j > 0 && (ranges.data[3 * j] < ranges.data[3 * (j - 1)]
                || (ranges.data[3 * j] == ranges.data[3 * (j - 1)]
                    && ranges.data[3 * j + 1] > ranges.data[3 * (j - 1) + 1])) {
                for x in 0..3 {
                    let t = ranges.data[3 * j + x];
                    ranges.data[3 * j + x] = ranges.data[3 * (j - 1) + x];
                    ranges.data[3 * (j - 1) + x] = t;
                }
                j -= 1;
            }
        }
        // The outermost ones, consecutive statements merged.
        let mut kept = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for a in 0..n {
            let s = ranges.data[3 * a];
            let e = ranges.data[3 * a + 1];
            let k = ranges.data[3 * a + 2];
            if kept.count > 0 {
                let ps = kept.data[kept.count - 3];
                let pe = kept.data[kept.count - 2];
                let pk = kept.data[kept.count - 1];
                if s >= ps && e <= pe {
                    continue;
                }
                if k == R_STMT && pk == R_STMT && s >= pe && blank(pe, s)
                    && file_of_pos(s) == file_of_pos(ps) {
                    kept.data[kept.count - 2] = e;
                    continue;
                }
            }
            kept.push(s);
            kept.push(e);
            kept.push(k);
        }
        let mut edits = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let mut a = 0;
        while a < kept.count {
            wrap_edit(kept.data[a], kept.data[a + 1], kept.data[a + 2], &edits);
            a += 3;
        }
        // (in order of position; edits at one position keep their order)
        let m = edits.count / 3;
        for x in 1..m {
            let mut j = x;
            while j > 0 && edits.data[3 * j] < edits.data[3 * (j - 1)] {
                for y in 0..3 {
                    let t = edits.data[3 * j + y];
                    edits.data[3 * j + y] = edits.data[3 * (j - 1) + y];
                    edits.data[3 * (j - 1) + y] = t;
                }
                j -= 1;
            }
        }
        let mut k = 0;
        while k < edits.count {
            edit_replace(edits.data[k], edits.data[k] + edits.data[k + 1], edits.data[k + 2]);
            k += 3;
        }
        kept.count / 3
    }
}
