// x86-64 instructions (AT&T syntax) for the IR back end (51_emit.tach), on
// physical registers: 0-15 are the integer registers by hardware number
// (rax rcx rdx rbx rsp rbp rsi rdi r8-r15), 32 + n is xmm<n>.
//
// Use of the registers: rax, rcx, rdx, rsi, rdi, r8 and r9 (caller-saved)
// and rbx, r12-r15 (callee-saved) are allocated (division takes rax and
// rdx, a shift by a register cl: the allocator keeps them free there);
// r10 and r11 are the temporaries inside one instruction, and of the
// parallel moves (r10 breaks cycles, r11 is the temporary and holds the
// callee of indirect calls). xmm0-xmm13 are allocated, xmm14 and xmm15 are
// the parallel moves' registers and temporaries inside one instruction.

fn mx_name(r: i64, size: i64) -> *u8 {
    if r >= 32 {
        return c"";
    }
    if r == 0 { return if size == 8 { c"%rax" } else if size == 4 { c"%eax" } else if size == 2 { c"%ax" } else { c"%al" }; }
    if r == 1 { return if size == 8 { c"%rcx" } else if size == 4 { c"%ecx" } else if size == 2 { c"%cx" } else { c"%cl" }; }
    if r == 2 { return if size == 8 { c"%rdx" } else if size == 4 { c"%edx" } else if size == 2 { c"%dx" } else { c"%dl" }; }
    if r == 3 { return if size == 8 { c"%rbx" } else if size == 4 { c"%ebx" } else if size == 2 { c"%bx" } else { c"%bl" }; }
    if r == 4 { return if size == 8 { c"%rsp" } else if size == 4 { c"%esp" } else if size == 2 { c"%sp" } else { c"%spl" }; }
    if r == 5 { return if size == 8 { c"%rbp" } else if size == 4 { c"%ebp" } else if size == 2 { c"%bp" } else { c"%bpl" }; }
    if r == 6 { return if size == 8 { c"%rsi" } else if size == 4 { c"%esi" } else if size == 2 { c"%si" } else { c"%sil" }; }
    if r == 7 { return if size == 8 { c"%rdi" } else if size == 4 { c"%edi" } else if size == 2 { c"%di" } else { c"%dil" }; }
    if r == 8 { return if size == 8 { c"%r8" } else if size == 4 { c"%r8d" } else if size == 2 { c"%r8w" } else { c"%r8b" }; }
    if r == 9 { return if size == 8 { c"%r9" } else if size == 4 { c"%r9d" } else if size == 2 { c"%r9w" } else { c"%r9b" }; }
    if r == 10 { return if size == 8 { c"%r10" } else if size == 4 { c"%r10d" } else if size == 2 { c"%r10w" } else { c"%r10b" }; }
    if r == 11 { return if size == 8 { c"%r11" } else if size == 4 { c"%r11d" } else if size == 2 { c"%r11w" } else { c"%r11b" }; }
    if r == 12 { return if size == 8 { c"%r12" } else if size == 4 { c"%r12d" } else if size == 2 { c"%r12w" } else { c"%r12b" }; }
    if r == 13 { return if size == 8 { c"%r13" } else if size == 4 { c"%r13d" } else if size == 2 { c"%r13w" } else { c"%r13b" }; }
    if r == 14 { return if size == 8 { c"%r14" } else if size == 4 { c"%r14d" } else if size == 2 { c"%r14w" } else { c"%r14b" }; }
    if size == 8 { c"%r15" } else if size == 4 { c"%r15d" } else if size == 2 { c"%r15w" } else { c"%r15b" }
}

// Writes register r: 64-bit name for integers (size for narrower), xmm<n>
// for floats.
fn mx_r(r: i64) {
    mx_rs(r, 8);
}

fn mx_rs(r: i64, size: i64) {
    if r >= 32 {
        o(c"%xmm");
        oi(r - 32);
    } else {
        o(mx_name(r, size));
    }
}

// "    <mnemonic> %a, %b\n"
fn mx_rr(mnemonic: *u8, a: i64, b: i64) {
    o(c"    ");
    o(mnemonic);
    o(c" ");
    mx_r(a);
    o(c", ");
    mx_r(b);
    on();
}

// "    <mnemonic> $imm, %r\n"
fn mx_ir(mnemonic: *u8, imm: i64, r: i64) {
    o(c"    ");
    o(mnemonic);
    o(c" $");
    oi(imm);
    o(c", ");
    mx_r(r);
    on();
}

// "<offset>(%base)"
fn mx_mem(base: i64, offset: i64) {
    if offset != 0 {
        oi(offset);
    }
    o(c"(");
    mx_r(base);
    if MEM_INDEX >= 0 {
        // disp(base, index, 1 << s) (see 50_isel.tach).
        o(c",");
        mx_r(MEM_INDEX);
        if MEM_SCALE != 0 {
            o(c",");
            oi(1 << MEM_SCALE as u64);
        }
    }
    o(c")");
}

fn mx_mov(dst: i64, src: i64, ty: i64) {
    if dst >= 32 {
        mx_rr(c"movapd", src, dst);
    } else {
        mx_rr(c"movq", src, dst);
    }
}

fn mx_load_imm(dst: i64, value: u64) {
    let signed = value as i64;
    if signed == 0 {
        o(c"    xorl ");
        mx_rs(dst, 4);
        o(c", ");
        mx_rs(dst, 4);
        on();
    } else if signed > 0 && signed <= 4294967295 {
        // movl zero-extends to 64 bits.
        o(c"    movl $");
        buf_uint(CODE, value);
        o(c", ");
        mx_rs(dst, 4);
        on();
    } else if fits_i32(signed) {
        mx_ir(c"movq", signed, dst);
    } else {
        mx_ir(c"movabsq", signed, dst);
    }
}

// Through r10 (free after the cycles of a parallel move, where constants
// are rematerialized, and inside instructions).
fn mx_load_fimm(dst: i64, bits: i64, ty: i64) {
    if bits == 0 {
        mx_rr(if ty == TY_F32 { c"xorps" } else { c"xorpd" }, dst, dst);
        return;
    }
    if ty == TY_F32 {
        o(c"    movl $");
        buf_uint(CODE, f32_bits(f64_of_bits(bits)) as u64);
        o(c", %r10d\n    movd %r10d, ");
        mx_r(dst);
        on();
    } else {
        mx_ir(c"movabsq", bits, 10);
        o(c"    movq %r10, ");
        mx_r(dst);
        on();
    }
}

fn mx_load(ty: i64, dst: i64, base: i64, offset: i64) {
    let size = type_size(ty);
    o(c"    ");
    if ty == TY_F32 {
        o(c"movss ");
    } else if ty == TY_F64 {
        o(c"movsd ");
    } else if ty == TY_I8 {
        o(c"movsbq ");
    } else if size == 1 {
        o(c"movzbl ");
    } else if ty == TY_I16 {
        o(c"movswq ");
    } else if size == 2 {
        o(c"movzwl ");
    } else if ty == TY_I32 {
        o(c"movslq ");
    } else if size == 4 {
        o(c"movl ");
    } else {
        o(c"movq ");
    }
    mx_mem(base, offset);
    o(c", ");
    if !is_float(ty) && (size == 1 || size == 2 || (size == 4 && ty != TY_I32)) && ty != TY_I8 && ty != TY_I16 {
        mx_rs(dst, 4);
    } else {
        mx_r(dst);
    }
    on();
}

fn mx_store(ty: i64, src: i64, base: i64, offset: i64) {
    let size = type_size(ty);
    o(c"    ");
    if ty == TY_F32 {
        o(c"movss ");
        mx_r(src);
    } else if ty == TY_F64 {
        o(c"movsd ");
        mx_r(src);
    } else if size == 1 {
        o(c"movb ");
        mx_rs(src, 1);
    } else if size == 2 {
        o(c"movw ");
        mx_rs(src, 2);
    } else if size == 4 {
        o(c"movl ");
        mx_rs(src, 4);
    } else {
        o(c"movq ");
        mx_r(src);
    }
    o(c", ");
    mx_mem(base, offset);
    on();
}

fn mx_lea(dst: i64, base: i64, offset: i64) {
    o(c"    leaq ");
    mx_mem(base, offset);
    o(c", ");
    mx_r(dst);
    on();
}

fn mx_symbol_addr(dst: i64, prefix: *u8, name: i64) {
    o(c"    leaq ");
    emit_symbol_ref(prefix, name);
    o(c"(%rip), ");
    mx_r(dst);
    on();
}

fn mx_extern_addr(dst: i64, name: i64) {
    o(c"    movq ");
    emit_symbol_ref(global_prefix(), name);
    o(c"@GOTPCREL(%rip), ");
    mx_r(dst);
    on();
}

fn mx_string_addr(dst: i64, id: i64) {
    o(c"    leaq ");
    o(local_prefix());
    o(c"str.");
    oi(id);
    o(c"(%rip), ");
    mx_r(dst);
    on();
}

fn mx_normalize(r: i64, ty: i64) {
    if ty == TY_I8 {
        o(c"    movsbq ");
        mx_rs(r, 1);
    } else if ty == TY_U8 {
        o(c"    movzbl ");
        mx_rs(r, 1);
        o(c", ");
        mx_rs(r, 4);
        on();
        return;
    } else if ty == TY_I16 {
        o(c"    movswq ");
        mx_rs(r, 2);
    } else if ty == TY_U16 {
        o(c"    movzwl ");
        mx_rs(r, 2);
        o(c", ");
        mx_rs(r, 4);
        on();
        return;
    } else if ty == TY_I32 {
        o(c"    movslq ");
        mx_rs(r, 4);
    } else if ty == TY_U32 {
        o(c"    movl ");
        mx_rs(r, 4);
        o(c", ");
        mx_rs(r, 4);
        on();
        return;
    } else {
        return;
    }
    o(c", ");
    mx_r(r);
    on();
}

fn mx_op_mnemonic(op: Op) -> *u8 {
    match op {
        Op::Add => c"addq",
        Op::Sub => c"subq",
        Op::Mul => c"imulq",
        Op::And => c"andq",
        Op::Or => c"orq",
        _ => c"xorq",
    }
}

fn is_commutative(op: Op) -> bool {
    op == Op::Add || op == Op::Mul || op == Op::And || op == Op::Or || op == Op::Xor
}

// d = a <op> b (for shifts, none of them is rcx).
fn mx_int_op(op: Op, ty: i64, d: i64, a: i64, b: i64) {
    if op == Op::Shl || op == Op::Shr {
        // The amount is taken modulo 32 for types up to 32 bits, modulo 64
        // for 64-bit ones.
        mx_rr(c"movq", b, 1);
        mx_ir(c"andq", if int_bits(ty) == 64 { 63 } else { 31 }, 1);
        m_mov(d, a, TY_U64);
        o(c"    ");
        if op == Op::Shl {
            o(c"shlq");
        } else if is_signed(ty) {
            o(c"sarq");
        } else {
            o(c"shrq");
        }
        o(c" %cl, ");
        mx_r(d);
        on();
    } else if d == b && d != a {
        if is_commutative(op) {
            mx_rr(mx_op_mnemonic(op), a, d);
        } else {
            mx_rr(c"movq", a, 11);
            mx_rr(mx_op_mnemonic(op), b, 11);
            mx_rr(c"movq", 11, d);
        }
    } else {
        m_mov(d, a, TY_U64);
        mx_rr(mx_op_mnemonic(op), b, d);
    }
    mx_normalize(d, ty);
}

// Whether mx_int_op_imm emits `a <op> imm`.
fn mx_int_imm_ok(op: Op, imm: i64) -> bool {
    if op == Op::Shl || op == Op::Shr {
        return true;
    }
    op != Op::Div && op != Op::Rem && fits_i32(imm)
}

fn mx_int_op_imm(op: Op, ty: i64, d: i64, a: i64, imm: i64) -> bool {
    if op == Op::Shl || op == Op::Shr {
        let amount = imm & (if int_bits(ty) == 64 { 63 } else { 31 });
        m_mov(d, a, TY_U64);
        if amount != 0 {
            mx_ir(if op == Op::Shl { c"shlq" } else if is_signed(ty) { c"sarq" } else { c"shrq" }, amount, d);
        }
        mx_normalize(d, ty);
        return true;
    }
    if op == Op::Div || op == Op::Rem || !fits_i32(imm) {
        return false;
    }
    if op == Op::Mul && (imm == 3 || imm == 5 || imm == 9) {
        // a * (2^k + 1) = a + a * 2^k
        o(c"    leaq (");
        mx_r(a);
        o(c",");
        mx_r(a);
        o(c",");
        oi(imm - 1);
        o(c"), ");
        mx_r(d);
        on();
        mx_normalize(d, ty);
        return true;
    }
    if op == Op::Mul {
        o(c"    imulq $");
        oi(imm);
        o(c", ");
        mx_r(a);
        o(c", ");
        mx_r(d);
        on();
    } else {
        m_mov(d, a, TY_U64);
        mx_ir(mx_op_mnemonic(op), imm, d);
    }
    mx_normalize(d, ty);
    true
}

// d = a / b (or a % b). Division by zero gives 0 and the remainder the
// dividend, and the signed MIN / -1 wraps, as on AArch64 (where idiv would
// trap); the checks are left out for a constant divisor that needs none.
// Neither a nor b is rax or rdx (nor is d).
fn mx_div(op: Op, ty: i64, d: i64, a: i64, b: i64, b_const: i64, b_is_const: bool) {
    let remainder = op == Op::Rem;
    let signed = is_signed(ty);
    mx_rr(c"movq", a, 0);
    mx_rr(c"movq", b, 11);
    let checked = !(b_is_const && b_const != 0 && !(signed && b_const == -1));
    let by_zero = new_label();
    let done = new_label();
    if checked {
        ins(c"testq %r11, %r11");
        x64_jcc(c"e", by_zero);
    }
    if signed {
        let by_minus_one = new_label();
        if checked {
            ins(c"cmpq $-1, %r11");
            x64_jcc(c"e", by_minus_one);
        }
        ins(c"cqto");
        ins(c"idivq %r11");
        if remainder {
            ins(c"movq %rdx, %rax");
        }
        if checked {
            x64_jump(done);
            emit_label(by_minus_one);
            ins(if remainder { c"xorl %eax, %eax" } else { c"negq %rax" });
        }
    } else {
        ins(c"xorl %edx, %edx");
        ins(c"divq %r11");
        if remainder {
            ins(c"movq %rdx, %rax");
        }
    }
    if checked {
        x64_jump(done);
        emit_label(by_zero);
        if !remainder {
            ins(c"xorl %eax, %eax");
        }
        emit_label(done);
    }
    m_mov(d, 0, TY_U64);
    mx_normalize(d, ty);
}

fn mx_float_op(op: Op, ty: i64, d: i64, a: i64, b: i64) {
    let f32 = ty == TY_F32;
    let mut name = c"div";
    if op == Op::Add { name = c"add"; }
    else if op == Op::Sub { name = c"sub"; }
    else if op == Op::Mul { name = c"mul"; }
    if d == b && d != a {
        if op == Op::Add || op == Op::Mul {
            mx_float_rr(name, f32, a, d);
            return;
        }
        mx_rr(c"movapd", a, 47);
        mx_float_rr(name, f32, b, 47);
        mx_rr(c"movapd", 47, d);
        return;
    }
    m_mov(d, a, ty);
    mx_float_rr(name, f32, b, d);
}

// "    <name>ss/sd %a, %b\n"
fn mx_float_rr(name: *u8, f32: bool, a: i64, b: i64) {
    o(c"    ");
    o(name);
    o(if f32 { c"ss " } else { c"sd " });
    mx_r(a);
    o(c", ");
    mx_r(b);
    on();
}

fn mx_unary(op: Op, ty: i64, d: i64, a: i64) {
    if op == Op::Neg && ty == TY_F32 {
        mx_rr(c"movd", a, 11);
        ins(c"xorl $0x80000000, %r11d");
        mx_rr(c"movd", 11, d);
        return;
    }
    if op == Op::Neg && ty == TY_F64 {
        mx_rr(c"movq", a, 11);
        ins(c"btcq $63, %r11");
        mx_rr(c"movq", 11, d);
        return;
    }
    m_mov(d, a, TY_U64);
    if op == Op::Neg {
        o(c"    negq ");
    } else if op == Op::Not {
        mx_ir(c"xorq", 1, d);
        return;
    } else {
        o(c"    notq ");
    }
    mx_r(d);
    on();
    mx_normalize(d, ty);
}

fn mx_cmp(op: Cond, ty: i64, d: i64, a: i64, b: i64) {
    if !is_float(ty) {
        mx_rr(c"cmpq", b, a);
        o(c"    set");
        o(x64_int_cc(op, is_signed(ty)));
        o(c" %r11b\n");
    } else {
        let compare = if ty == TY_F32 { c"ucomiss" } else { c"ucomisd" };
        // Unordered (NaN) sets ZF, PF and CF: == and != check PF; < and <=
        // swap the operands to use the ordered "above" conditions.
        if op == Cond::Lt || op == Cond::Le {
            mx_rr(compare, a, b);
        } else {
            mx_rr(compare, b, a);
        }
        if op == Cond::Eq {
            ins(c"sete %r11b");
            ins(c"setnp %r10b");
            ins(c"andb %r10b, %r11b");
        } else if op == Cond::Ne {
            ins(c"setne %r11b");
            ins(c"setp %r10b");
            ins(c"orb %r10b, %r11b");
        } else if op == Cond::Lt || op == Cond::Gt {
            ins(c"seta %r11b");
        } else {
            ins(c"setae %r11b");
        }
    }
    o(c"    movzbl %r11b, ");
    mx_rs(d, 4);
    on();
}

fn mx_cmp_branch(op: Cond, ty: i64, a: i64, b: i64, b_is_imm: bool, imm: i64, label: i64) {
    if b_is_imm {
        mx_ir(c"cmpq", imm, a);
    } else {
        mx_rr(c"cmpq", b, a);
    }
    x64_jcc(x64_int_cc(op, is_signed(ty)), label);
}

fn mx_branch_bool(r: i64, if_nonzero: bool, label: i64) {
    mx_rr(c"testq", r, r);
    x64_jcc(if if_nonzero { c"ne" } else { c"e" }, label);
}

fn mx_conv(from: i64, to: i64, d: i64, src: i64) {
    let from_f32 = from == TY_F32;
    if is_float(from) && is_float(to) {
        mx_rr(if to == TY_F64 { c"cvtss2sd" } else { c"cvtsd2ss" }, src, d);
        return;
    }
    if is_float(to) {
        mx_int_to_float(from, to, d, src);
        return;
    }
    if !is_float(from) {
        m_mov(d, src, TY_U64);
        mx_normalize(d, to);
        return;
    }
    // Saturating float to integer (see x64_float_to_int), in r11.
    if is_signed(to) && int_bits(to) <= 32 {
        mx_truncate(from_f32, 32, src);
        ins(c"movslq %r11d, %r11");
    } else if to != TY_U64 {
        mx_truncate(from_f32, 64, src);
    } else {
        // value >= 2^63 ? the unsigned conversion : the signed one.
        let big = new_label();
        let done = new_label();
        if from_f32 {
            ins(c"movl $0x5f000000, %r11d");
            ins(c"movd %r11d, %xmm15");
            mx_rr(c"ucomiss", 47, src);
        } else {
            ins(c"movabsq $0x43e0000000000000, %r11");
            ins(c"movq %r11, %xmm15");
            mx_rr(c"ucomisd", 47, src);
        }
        x64_jcc(c"ae", big);
        mx_truncate(from_f32, 64, src);
        x64_jump(done);
        emit_label(big);
        // value - 2^63 converts exactly below 2^64; above, the indefinite
        // result means "saturate to the maximum".
        mx_rr(c"movapd", src, 46);
        ins(if from_f32 { c"subss %xmm15, %xmm14" } else { c"subsd %xmm15, %xmm14" });
        ins(if from_f32 { c"cvttss2si %xmm14, %r11" } else { c"cvttsd2si %xmm14, %r11" });
        let saturate = new_label();
        ins(c"testq %r11, %r11");
        x64_jcc(c"s", saturate);
        ins(c"btsq $63, %r11");
        x64_jump(done);
        emit_label(saturate);
        ins(c"movq $-1, %r11");
        emit_label(done);
    }
    m_mov(d, 11, TY_U64);
    mx_normalize(d, to);
}

// r11 (r11d at 32 bits) = the saturating signed conversion of float
// register src (see x64_truncate); r10 is a temporary.
fn mx_truncate(f32: bool, bits: i64, src: i64) {
    let done = new_label();
    let nan = new_label();
    o(if f32 { c"    cvttss2si " } else { c"    cvttsd2si " });
    mx_r(src);
    o(if bits == 32 { c", %r11d\n" } else { c", %r11\n" });
    if bits == 32 {
        ins(c"cmpl $-2147483648, %r11d");
    } else {
        ins(c"movabsq $-9223372036854775808, %r10");
        ins(c"cmpq %r10, %r11");
    }
    x64_jcc(c"ne", done);
    mx_rr(if f32 { c"ucomiss" } else { c"ucomisd" }, src, src);
    x64_jcc(c"p", nan);
    // The minimum is right for negative overflow (and the minimum itself).
    if f32 {
        mx_rr(c"movd", src, 10);
        ins(c"testl %r10d, %r10d");
    } else {
        mx_rr(c"movq", src, 10);
        ins(c"testq %r10, %r10");
    }
    x64_jcc(c"s", done);
    if bits == 32 {
        ins(c"movl $2147483647, %r11d");
    } else {
        ins(c"movabsq $9223372036854775807, %r11");
    }
    x64_jump(done);
    emit_label(nan);
    ins(c"xorl %r11d, %r11d");
    emit_label(done);
}

fn mx_int_to_float(from: i64, to: i64, d: i64, src: i64) {
    let convert = if to == TY_F32 { c"cvtsi2ssq" } else { c"cvtsi2sdq" };
    if from != TY_U64 {
        // Signed, or unsigned below 2^32 (zero-extended): exact as signed.
        mx_rr(convert, src, d);
        return;
    }
    // u64 at 2^63 and above: halve (keeping the low bit, for rounding),
    // convert, double.
    let big = new_label();
    let done = new_label();
    mx_rr(c"testq", src, src);
    x64_jcc(c"s", big);
    mx_rr(convert, src, d);
    x64_jump(done);
    emit_label(big);
    mx_rr(c"movq", src, 11);
    ins(c"movq %r11, %r10");
    ins(c"shrq $1, %r11");
    ins(c"andl $1, %r10d");
    ins(c"orq %r10, %r11");
    mx_rr(convert, 11, d);
    mx_rr(if to == TY_F32 { c"addss" } else { c"addsd" }, d, d);
    emit_label(done);
}

fn mx_copy(dst: i64, src: i64, size: i64) {
    let mut offset = 0;
    while offset + 8 <= size {
        mx_copy_chunk(c"movq", 8, dst, src, offset);
        offset += 8;
    }
    if offset + 4 <= size {
        mx_copy_chunk(c"movl", 4, dst, src, offset);
        offset += 4;
    }
    if offset + 2 <= size {
        mx_copy_chunk(c"movw", 2, dst, src, offset);
        offset += 2;
    }
    if offset < size {
        mx_copy_chunk(c"movb", 1, dst, src, offset);
    }
}

fn mx_copy_chunk(mnemonic: *u8, size: i64, dst: i64, src: i64, offset: i64) {
    o(c"    ");
    o(mnemonic);
    o(c" ");
    mx_mem(src, offset);
    o(c", ");
    mx_rs(11, size);
    on();
    o(c"    ");
    o(mnemonic);
    o(c" ");
    mx_rs(11, size);
    o(c", ");
    mx_mem(dst, offset);
    on();
}

// A jump through a table of 32-bit offsets (from the table) to labels:
// entry `value - low` for register r, the default above the range
// (position independent).
fn mx_jump_table(r: i64, low: i64, range: i64, default: i64, table: *i64) {
    mx_mov(11, r, TY_U64);
    if low != 0 {
        if fits_i32(low) {
            mx_ir(c"subq", low, 11);
        } else {
            mx_load_imm(10, low as u64);
            mx_rr(c"subq", 10, 11);
        }
    }
    mx_ir(c"cmpq", range - 1, 11);
    x64_jcc(c"a", default);
    let at = new_label();
    o(c"    leaq ");
    o(local_prefix());
    oi(at);
    o(c"(%rip), %r10\n");
    ins(c"movslq (%r10,%r11,4), %r11");
    ins(c"addq %r10, %r11");
    ins(c"jmp *%r11");
    ins(c".p2align 2");
    emit_label(at);
    for i in 0..range {
        o(c"    .long ");
        o(local_prefix());
        oi(table[i]);
        o(c" - ");
        o(local_prefix());
        oi(at);
        on();
    }
}

// ---- Machine operations of instruction selection (50_isel.tach) ----

// Sets the flags from a & b (b < 0: a & mask).
fn mx_test(a: i64, b: i64, mask: i64) {
    if b >= 0 {
        mx_rr(c"testq", b, a);
    } else {
        mx_ir(c"testq", mask, a);
    }
}

// Jumps to `label` when a & b (b < 0: a & mask) is nonzero, or zero.
fn mx_test_branch(a: i64, b: i64, mask: i64, if_nonzero: bool, label: i64) {
    mx_test(a, b, mask);
    x64_jcc(if if_nonzero { c"ne" } else { c"e" }, label);
}

// d = (lhs op rhs) ? then : other (integers), or (lhs & rhs) op 0 when
// `test` (rhs < 0: the immediate imm); the flags are already set unless
// `compare`.
fn mx_select(op: Cond, test: bool, compare: bool, cmp_ty: i64, lhs: i64, rhs: i64, imm: i64, d: i64, then: i64,
             other: i64) {
    if !compare {
    } else if test {
        mx_test(lhs, rhs, imm);
    } else if rhs < 0 {
        mx_ir(c"cmpq", imm, lhs);
    } else {
        mx_rr(c"cmpq", rhs, lhs);
    }
    let signed = is_signed(cmp_ty);
    // movq leaves the flags alone.
    if d == other {
        mx_cmov(x64_int_cc(op, signed), then, d);
    } else if d == then {
        mx_cmov(x64_int_cc(op.negate(), signed), other, d);
    } else {
        mx_rr(c"movq", other, d);
        mx_cmov(x64_int_cc(op, signed), then, d);
    }
}

fn mx_cmov(cc: *u8, src: i64, d: i64) {
    o(c"    cmov");
    o(cc);
    o(c"q ");
    mx_r(src);
    o(c", ");
    mx_r(d);
    on();
}

// d = sqrt(a).
fn mx_sqrt(ty: i64, d: i64, a: i64) {
    mx_rr(if ty == TY_F32 { c"sqrtss" } else { c"sqrtsd" }, a, d);
}
