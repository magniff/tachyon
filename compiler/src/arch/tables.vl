        buf_str(out, c"_mm256_testc_si256 | avx | (a: __m256i, b: __m256i) -> i32 | intr | vptest <b:y>, <a:y>; setb <d:b>; movzbl <d:b>, <d:w> | pure | none | - | r = min over k of (if (a[k] ^ 255) & b[k] == 0 { 1 } else { 0 }) (bytes) | - | 1 when !a & b is all zeros\n");
