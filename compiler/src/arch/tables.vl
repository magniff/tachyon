        buf_str(out, c"_mm256_andnot_pd | avx | (a: __m256d, b: __m256d) -> __m256d | intr | vandnpd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = (a[k] ^ 255) & b[k] (a, b, r: bytes) | - | bitwise !a & b\n");
        buf_str(out, c"_mm256_sqrt_pd | avx | (a: __m256d) -> __m256d | intr | vsqrtpd <a:y>, <d:y> | pure | none | - | r = each lane's square root (correctly rounded) | - | lanewise square root\n");
        buf_str(out, c"_mm256_cmp_pd | avx | (a: __m256d, b: __m256d, imm8: const 0..=31) -> __m256d | intr | vcmppd $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r = each lane compared by predicate imm8 (Intel's _CMP_*): a mask, each lane all ones or 0 (r: i64 lanes) | - | lanewise compare by predicate imm8 (_CMP_EQ_OQ = 0 ... _CMP_TRUE_US = 31)\n");
        buf_str(out, c"_mm256_blendv_pd | avx | (a: __m256d, b: __m256d, mask: __m256d) -> __m256d | intr | vblendvpd <mask:y>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if mask[k] < 0 { b[k] } else { a[k] } (a, b, r: u64 lanes; mask: i64 lanes) | - | lane k is b's where mask's lane k has its sign bit set, else a's\n");
        buf_str(out, c"_mm256_movemask_pd | avx | (a: __m256d) -> i32 | intr | vmovmskpd <a:y>, <d:w> | pure | none | - | r = sum over k of (if a[k] < 0 { 1 << k } else { 0 }) (a: i64 lanes) | - | the lanes' sign bits\n");
        buf_str(out, c"_mm256_blend_pd | avx | (a: __m256d, b: __m256d, imm8: const 0..=15) -> __m256d | intr | vblendpd $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if (imm8 >> k) & 1 != 0 { b[k] } else { a[k] } (a, b, r: u64 lanes) | - | lane k is b's where imm8's bit k is set\n");
        buf_str(out, c"_mm256_extractf128_si256 | avx | (a: __m256i, imm8: const 0..=1) -> __m128i | intr | vextractf128 $<imm8>, <a:y>, <d> | pure | none | - | r[k] = a[16 * imm8 + k] (a, r: bytes) | - | the 128-bit half imm8 (0 low, 1 high)\n");
        buf_str(out, c"_mm256_insertf128_si256 | avx | (a: __m256i, b: __m128i, imm8: const 0..=1) -> __m256i | intr | vinsertf128 $<imm8>, <b>, <a:y>, <d:y> | pure | none | - | r[k] = if k / 16 == imm8 { b[k % 16] } else { a[k] } (a, b, r: bytes) | - | a with its 128-bit half imm8 replaced by b\n");
        buf_str(out, c"_mm256_permute2f128_si256 | avx | (a: __m256i, b: __m256i, imm8: const 0..=255) -> __m256i | intr | vperm2f128 $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if (imm8 >> (4 * (k / 16))) & 8 != 0 { 0 } else if (imm8 >> (4 * (k / 16))) & 2 == 0 { a[16 * ((imm8 >> (4 * (k / 16))) & 1) + k % 16] } else { b[16 * ((imm8 >> (4 * (k / 16))) & 1) + k % 16] } (a, b, r: bytes) | - | each half from a or b by imm8 (bits 0-1 low, 4-5 high; bits 3, 7: zero)\n");
