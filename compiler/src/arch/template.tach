// The instruction templates of the intrinsics (0.19): the `instruction`
// column, as both machine layers (back/mc_arm64/arch.tach,
// back/mc_x86_64/arch.tach) and -O0 (gen0/gen/arch.tach) write it.
//
// A template is the assembly text with placeholders in angle brackets:
// `<d>` the result's register, `<t>` the instruction temporary (v31 /
// xmm15), `<NAME>` parameter NAME's register or, for an immediate, its
// value; `<NAME:M>` a view of the register: `w` (32 bits) or `x` (64) for
// a general register, `b h s d q` for a vector register's scalar view on
// AArch64. Instructions are separated by `; `. (A parameter named d or t
// hides the placeholder: `<_d>` and `<_t>` always name them.)

use crate::arch::{INTRS, intr_param_name};
use crate::base::{die, intern};

// A piece of a template (template_piece): text, a placeholder, the end of
// an instruction, the end.
pub const TP_TEXT: i64 = 0;
pub const TP_SLOT: i64 = 1;
pub const TP_NEXT: i64 = 2;
pub const TP_END: i64 = 3;

// What a placeholder names (template_slot): the result, the temporary, or
// parameter k (k >= 0).
pub const SLOT_D: i64 = -1;
pub const SLOT_T: i64 = -2;

pub struct TPiece { kind: i64, start: i64, end: i64, name: i64, modifier: u8 }

// The piece of template `text` at `at` into *p; the position after it.
pub fn template_piece(text: [u8], at: i64, p: *TPiece) -> i64 {
    unsafe {
        let n = text.len as i64;
        (*p).start = at;
        (*p).modifier = 0;
        if at >= n {
            (*p).kind = TP_END;
            (*p).end = at;
            return at;
        }
        if text[at] == ';' {
            (*p).kind = TP_NEXT;
            let mut i = at + 1;
            while i < n && text[i] == ' ' {
                i += 1;
            }
            (*p).end = i;
            return i;
        }
        if text[at] == '<' {
            let mut i = at + 1;
            while i < n && text[i] != '>' && text[i] != ':' {
                i += 1;
            }
            (*p).kind = TP_SLOT;
            (*p).name = intern(text[at + 1..i]);
            if i < n && text[i] == ':' {
                (*p).modifier = text[i + 1];
                i += 2;
            }
            if i >= n || text[i] != '>' {
                die(c"internal error: arch table: a placeholder without '>'");
            }
            (*p).end = i + 1;
            return i + 1;
        }
        let mut i = at;
        while i < n && text[i] != '<' && text[i] != ';' {
            i += 1;
        }
        (*p).kind = TP_TEXT;
        (*p).end = i;
        i
    }
}

// What placeholder `name` of intrinsic id's template names: a parameter's
// index, else SLOT_D (`d`, `_d`) or SLOT_T (`t`, `_t`). (A parameter named
// d or t hides the placeholder: its template writes `<_d>`, `<_t>`.)
pub fn template_slot(id: i64, name: i64) -> i64 {
    unsafe {
        for k in 0..INTRS[id].nparams {
            if intr_param_name(id, k) == name {
                return k;
            }
        }
        if name == intern("d") || name == intern("_d") {
            return SLOT_D;
        }
        if name == intern("t") || name == intern("_t") {
            return SLOT_T;
        }
        die(c"internal error: arch table: a placeholder naming no parameter")
    }
}
