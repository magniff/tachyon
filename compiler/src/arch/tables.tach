        buf_str(out, c"_mm256_cmpeq_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpcmpeqw <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = if a[k] == b[k] { -1 } else { 0 } (i16 lanes) | x86_64: _mm_cmpeq_epi16, twice | lanewise a == b: a mask\n");
        buf_str(out, c"_mm256_cmpgt_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpcmpgtw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if a[k] > b[k] { -1 } else { 0 } (i16 lanes) | - | lanewise a > b (signed): a mask\n");
        buf_str(out, c"_mm256_cmpeq_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpcmpeqd <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = if a[k] == b[k] { -1 } else { 0 } (i32 lanes) | x86_64: _mm_cmpeq_epi32, twice | lanewise a == b: a mask\n");
        buf_str(out, c"_mm256_cmpgt_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpcmpgtd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if a[k] > b[k] { -1 } else { 0 } (i32 lanes) | - | lanewise a > b (signed): a mask\n");
        buf_str(out, c"_mm256_cmpeq_epi64 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpcmpeqq <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = if a[k] == b[k] { -1 } else { 0 } (i64 lanes) | x86_64: _mm_cmpeq_epi64, twice | lanewise a == b: a mask\n");
        buf_str(out, c"_mm256_cmpgt_epi64 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpcmpgtq <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if a[k] > b[k] { -1 } else { 0 } (i64 lanes) | - | lanewise a > b (signed): a mask\n");
        buf_str(out, c"_mm256_and_si256 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpand <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] & b[k] (bytes) | - | bitwise a & b\n");
        buf_str(out, c"_mm256_or_si256 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpor <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k]|b[k] (bytes) | - | bitwise a|b\n");
        buf_str(out, c"_mm256_xor_si256 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpxor <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] ^ b[k] (bytes) | - | bitwise a ^ b\n");
        buf_str(out, c"_mm256_andnot_si256 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpandn <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = (a[k] ^ 255) & b[k] (bytes) | - | bitwise !a & b\n");
        buf_str(out, c"_mm256_movemask_epi8 | avx2 | (a: __m256i) -> i32 | intr | vpmovmskb <a:y>, <d:w> | pure | none | movemask.b | r = sum over k of (if a[k] >= 128 { 1 << k } else { 0 }) (bytes) | x86_64: _mm_movemask_epi8, twice | the 32 bytes' top bits as a 32-bit mask\n");
        buf_str(out, c"_mm256_blendv_epi8 | avx2 | (a: __m256i, b: __m256i, mask: __m256i) -> __m256i | intr | vpblendvb <mask:y>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if mask[k] >= 128 { b[k] } else { a[k] } (bytes) | - | byte k is b's where mask's byte k has its top bit set\n");
        buf_str(out, c"_mm256_blend_epi16 | avx2 | (a: __m256i, b: __m256i, imm8: const 0..=255) -> __m256i | intr | vpblendw $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if (imm8 >> (k % 8)) & 1 != 0 { b[k] } else { a[k] } (i16 lanes) | - | lane k is b's where imm8's bit k % 8 is set (the same 8 bits for each 128-bit half)\n");
        buf_str(out, c"_mm256_blend_epi32 | avx2 | (a: __m256i, b: __m256i, imm8: const 0..=255) -> __m256i | intr | vpblendd $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if (imm8 >> k) & 1 != 0 { b[k] } else { a[k] } (i32 lanes) | - | lane k is b's where imm8's bit k is set\n");
        buf_str(out, c"_mm_blend_epi32 | avx2 | (a: __m128i, b: __m128i, imm8: const 0..=15) -> __m128i | intr | vpblendd $<imm8>, <b>, <a>, <d> | pure | none | - | r[k] = if (imm8 >> k) & 1 != 0 { b[k] } else { a[k] } (i32 lanes) | - | lane k is b's where imm8's bit k is set\n");
        buf_str(out, c"_mm256_shuffle_epi8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpshufb <b:y>, <a:y>, <d:y> | pure | none | perm.pshufb | r[k] = if b[k] & 0x80 != 0 { 0 } else { a[k - k % 16 + (b[k] & 15)] } (bytes) | - | a table lookup in each 128-bit half: byte k is its half's a[b[k] & 15], 0 when b[k]'s bit 7 is set\n");
        buf_str(out, c"_mm256_alignr_epi8 | avx2 | (a: __m256i, b: __m256i, imm8: const 0..=255) -> __m256i | intr | vpalignr $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 16 + imm8 < 16 { b[k + imm8] } else if k % 16 + imm8 < 32 { a[k + imm8 - 16] } else { 0 } (bytes) | - | in each 128-bit half, bytes imm8.. of b's half then a's\n");
        buf_str(out, c"_mm256_shuffle_epi32 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpshufd $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = a[k - k % 4 + ((imm8 >> (2 * (k % 4))) & 3)] (i32 lanes) | - | each 128-bit half's lanes shuffled by imm8\n");
        buf_str(out, c"_mm256_shufflelo_epi16 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpshuflw $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 8 < 4 { a[k - k % 8 + ((imm8 >> (2 * (k % 8))) & 3)] } else { a[k] } (i16 lanes) | - | each half's low four lanes shuffled by imm8\n");
        buf_str(out, c"_mm256_shufflehi_epi16 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpshufhw $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 8 < 4 { a[k] } else { a[k - k % 8 + 4 + ((imm8 >> (2 * (k % 8 - 4))) & 3)] } (i16 lanes) | - | each half's high four lanes shuffled by imm8\n");
