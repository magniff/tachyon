        buf_str(out, c"_mm256_unpackhi_epi8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpunpckhbw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 2 == 0 { a[k - k % 16 + 8 + (k % 16) / 2] } else { b[k - k % 16 + 8 + (k % 16) / 2] } (i8 lanes) | - | each half's high lanes interleaved, a's first\n");
        buf_str(out, c"_mm256_unpacklo_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpunpcklwd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 2 == 0 { a[k - k % 8 + (k % 8) / 2] } else { b[k - k % 8 + (k % 8) / 2] } (i16 lanes) | - | each half's low lanes interleaved, a's first\n");
        buf_str(out, c"_mm256_unpackhi_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpunpckhwd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 2 == 0 { a[k - k % 8 + 4 + (k % 8) / 2] } else { b[k - k % 8 + 4 + (k % 8) / 2] } (i16 lanes) | - | each half's high lanes interleaved, a's first\n");
        buf_str(out, c"_mm256_unpacklo_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpunpckldq <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 2 == 0 { a[k - k % 4 + (k % 4) / 2] } else { b[k - k % 4 + (k % 4) / 2] } (i32 lanes) | - | each half's low lanes interleaved, a's first\n");
