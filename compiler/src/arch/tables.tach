// Generated by compiler/arch/embed.sh from compiler/arch/*.def (do not
// edit): the intrinsic tables (0.19), parsed by arch/table.tach on a
// program's first use of std::arch.

use crate::base::buf_str;

// The intrinsics: portable.def, aarch64.def, x86_64.def, each after a
// line `= ARCH`.
pub fn intrinsics_source(out: i64) {
    unsafe {
        buf_str(out, c"= portable\n");
        buf_str(out, c"count_ones | - | (x: u64) -> i64 | bits.ones | - | pure | none | bits.ones | r = the number of 1 bits of x | aarch64: cnt + addv; x86_64: popcnt (popcnt) | the number of 1 bits of x (std::count_ones)\n");
        buf_str(out, c"has | - | (feature: [u8]) -> bool | feat.has | - | pure | none | feat | r = whether `feature` is known at this point (baseline, declared, guarded) | - | a constant: true when the feature is known where it is asked (never for another architecture's)\n");
        buf_str(out, c"detect | - | (feature: [u8]) -> bool | feat.detect | - | pure | none | feat | r = whether the CPU running the program has `feature` | - | true when the running CPU has the feature: a constant when known or foreign, else one cached bit test\n");
        buf_str(out, c"= aarch64\n");
        buf_str(out, c"vld1q_u8 | neon | (s: [u8], i: i64) -> uint8x16_t | load | ldr <d:q>, [<s>] | - | load(s, 16) | - | r[k] = s[i + k] | x86_64: _mm_loadu_si128 | the 16 bytes s[i..i + 16] as a vector (checked: 0 <= i, i + 16 <= s.len)\n");
        buf_str(out, c"vst1q_u8 | neon | (s: [u8], i: i64, v: uint8x16_t) | store | str <v:q>, [<s>] | - | store(s, 16) | - | s[i + k] = v[k] | x86_64: _mm_storeu_si128 | v's 16 bytes into s[i..i + 16] (checked)\n");
        buf_str(out, c"vdupq_n_u8 | neon | (x: u8) -> uint8x16_t | vsplat | dup <d>.16b, <x:w> | pure | none | splat | r[k] = x | x86_64: _mm_set1_epi8 | every lane x\n");
        buf_str(out, c"vget_lane_u64 | neon | (v: uint64x1_t, lane: const 0..=0) -> u64 | vext | mov <d:x>, <v>.d[<lane>] | pure | none | lane | r = v[lane] | - | lane `lane` of v\n");
        buf_str(out, c"vreinterpretq_u16_u8 | neon | (a: uint8x16_t) -> uint16x8_t | cast | - | pure | none | cast | r = a's 16 bytes as u16 lanes | x86_64: (the same __m128i) | the same bits as eight u16 lanes\n");
        buf_str(out, c"vaddq_u8 | neon | (a: uint8x16_t, b: uint8x16_t) -> uint8x16_t | vbin.add | add <d>.16b, <a>.16b, <b>.16b | pure commutative | none | lanes.add | r[k] = a[k] + b[k] (wrapping) | x86_64: _mm_add_epi8 | lanewise a + b, wrapping\n");
        buf_str(out, c"vqsubq_u8 | neon | (a: uint8x16_t, b: uint8x16_t) -> uint8x16_t | intr | uqsub <d>.16b, <a>.16b, <b>.16b | pure | none | lanes.qsub_u | r[k] = max(a[k] - b[k], 0) | x86_64: _mm_subs_epu8 | lanewise a - b, saturating at 0\n");
        buf_str(out, c"vceqq_u8 | neon | (a: uint8x16_t, b: uint8x16_t) -> uint8x16_t | vcmp.eq | cmeq <d>.16b, <a>.16b, <b>.16b | pure commutative | none | lanes.eq | r[k] = if a[k] == b[k] { 0xff } else { 0 } | x86_64: _mm_cmpeq_epi8 | lanewise a == b: a mask, each lane 0xff or 0\n");
        buf_str(out, c"vshrn_n_u16 | neon | (a: uint16x8_t, n: const 1..=8) -> uint8x8_t | intr | shrn <d>.8b, <a>.8h, #<n> | pure | none | lanes.shrn | r[k] = (a[k] >> n) as u8 | - | each u16 lane shifted right by n, narrowed to its low 8 bits (the NEON movemask: n = 4 gives 4 bits per byte)\n");
        buf_str(out, c"vmaxvq_u8 | neon | (a: uint8x16_t) -> u8 | intr | umaxv <t:b>, <a>.16b; umov <d:w>, <t>.b[0] | pure | none | across.max_u | r = max over k of a[k] | - | the largest lane (any byte set: vmaxvq_u8(m) != 0)\n");
        buf_str(out, c"vextq_u8 | neon | (a: uint8x16_t, b: uint8x16_t, n: const 0..=15) -> uint8x16_t | intr | ext <d>.16b, <a>.16b, <b>.16b, #<n> | pure | none | perm.ext | r[k] = if k + n < 16 { a[k + n] } else { b[k + n - 16] } | x86_64: _mm_alignr_epi8(b, a, n) | bytes n..n + 16 of a then b\n");
        buf_str(out, c"vqtbl1q_u8 | neon | (t: uint8x16_t, idx: uint8x16_t) -> uint8x16_t | intr | tbl <d>.16b, {<t>.16b}, <idx>.16b | pure | none | perm.tbl | r[k] = if idx[k] < 16 { t[idx[k]] } else { 0 } | x86_64: _mm_shuffle_epi8 (zeroes when bit 7 is set instead) | a table lookup: lane k is t[idx[k]], 0 when idx[k] >= 16\n");
        buf_str(out, c"__crc32cd | crc | (crc: u32, data: u64) -> u32 | intr | crc32cx <d:w>, <crc:w>, <data:x> | pure | none | crc.c64 | r = CRC-32C of crc and data's 8 bytes (Castagnoli, reflected, no inversion) | x86_64: _mm_crc32_u64 | one step of CRC-32C over 8 bytes\n");
        buf_str(out, c"= x86_64\n");
        buf_str(out, c"_mm_loadu_si128 | sse2 | (s: [u8], i: i64) -> __m128i | load | movdqu (<s>), <d> | - | load(s, 16) | - | r = s[i..i + 16] | aarch64: vld1q_u8 | the 16 bytes s[i..i + 16] (checked: 0 <= i, i + 16 <= s.len)\n");
        buf_str(out, c"_mm_storeu_si128 | sse2 | (s: [u8], i: i64, v: __m128i) | store | movdqu <v>, (<s>) | - | store(s, 16) | - | s[i..i + 16] = v | aarch64: vst1q_u8 | v's 16 bytes into s[i..i + 16] (checked)\n");
        buf_str(out, c"_mm_set1_epi8 | sse2 | (x: i8) -> __m128i | vsplat:v16i8 | movd <x:w>, <d>; punpcklbw <d>, <d>; pshuflw $0, <d>, <d>; pshufd $0, <d>, <d> | pure | none | splat | r[k] = x (bytes) | aarch64: vdupq_n_u8 | every byte x\n");
        buf_str(out, c"_mm_cmpeq_epi8 | sse2 | (a: __m128i, b: __m128i) -> __m128i | vcmp.eq:v16i8 | pcmpeqb <b>, <d> | pure commutative tied=a | none | lanes.eq | r[k] = if a[k] == b[k] { 0xff } else { 0 } (bytes) | aarch64: vceqq_u8 | bytewise a == b: a mask, each byte 0xff or 0\n");
        buf_str(out, c"_mm_movemask_epi8 | sse2 | (a: __m128i) -> i32 | intr | pmovmskb <a>, <d:w> | pure | none | movemask.b | r = the top bit of each byte, byte k at bit k | aarch64: (recipe) vshrn_n_u16(vreinterpretq_u16_u8(m), 4) | the 16 bytes' top bits as a 16-bit mask\n");
        buf_str(out, c"_mm_shuffle_epi8 | ssse3 | (a: __m128i, b: __m128i) -> __m128i | intr | pshufb <b>, <d> | pure tied=a | none | perm.pshufb | r[k] = if b[k] & 0x80 != 0 { 0 } else { a[b[k] & 15] } (bytes) | aarch64: vqtbl1q_u8 (zeroes when idx >= 16 instead) | a table lookup: byte k is a[b[k] & 15], 0 when b[k]'s bit 7 is set\n");
        buf_str(out, c"_mm_crc32_u64 | sse4.2 | (crc: u64, v: u64) -> u64 | intr | crc32q <v>, <d> | pure tied=crc | none | crc.c64 | r = CRC-32C of crc's low 32 bits and v's 8 bytes | aarch64: __crc32cd | one step of CRC-32C over 8 bytes\n");
    }
}

// The AArch64 instructions' encodings: insn_a64.def.
pub fn insn_a64_source(out: i64) {
    unsafe {
        buf_str(out, c"uqsub | same3 | 0x2e202c00 | uqsub Vd.T, Vn.T, Vm.T\n");
        buf_str(out, c"umaxv | across | 0x2e30a800 | umaxv <V>d, Vn.T\n");
        buf_str(out, c"umov | umov | 0x0e003c00 | umov Wd, Vn.Ts[i]\n");
        buf_str(out, c"tbl | tbl | 0x0e000000 | tbl Vd.T, {Vn.16b, ...}, Vm.T\n");
        buf_str(out, c"ext | ext | 0x2e000000 | ext Vd.T, Vn.T, Vm.T, #index\n");
        buf_str(out, c"shrn | shrn | 0x0f008400 | shrn Vd.Tb, Vn.Ta, #shift\n");
        buf_str(out, c"crc32cx | crc | 0x9ac05c00 | crc32cx Wd, Wn, Xm\n");
    }
}

