// The x86-64 instructions' encodings: insn_x86.def.
pub fn insn_x86_source(out: i64) {
    unsafe {
        buf_str(out, c"pshufb | sse | 66 | 0f38 | 00 | -\n");
        buf_str(out, c"pmovmskb | sse | 66 | 0f | d7 | -\n");
        buf_str(out, c"pshuflw | ssei | f2 | 0f | 70 | -\n");
        buf_str(out, c"crc32q | sse | f2 | 0f38 | f1 | w\n");
    }
}
