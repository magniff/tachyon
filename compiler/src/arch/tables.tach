        buf_str(out, c"_mm256_unpacklo_epi64 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpunpcklqdq <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 2 == 0 { a[k - k % 2 + (k % 2) / 2] } else { b[k - k % 2 + (k % 2) / 2] } (i64 lanes) | - | each half's low lanes interleaved, a's first\n");
        buf_str(out, c"_mm256_unpackhi_epi64 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpunpckhqdq <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 2 == 0 { a[k - k % 2 + 1 + (k % 2) / 2] } else { b[k - k % 2 + 1 + (k % 2) / 2] } (i64 lanes) | - | each half's high lanes interleaved, a's first\n");
        buf_str(out, c"_mm256_packs_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpacksswb <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 16 < 8 { clamp(a[k / 16 * 8 + k % 16], -128, 127) } else { clamp(b[k / 16 * 8 + k % 16 - 8], -128, 127) } (a, b: i16 lanes; r: i8 lanes) | - | per 128-bit half: a's then b's lanes narrowed to 8 bits, saturating\n");
        buf_str(out, c"_mm256_packs_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpackssdw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 8 < 4 { clamp(a[k / 8 * 4 + k % 8], -32768, 32767) } else { clamp(b[k / 8 * 4 + k % 8 - 4], -32768, 32767) } (a, b: i32 lanes; r: i16 lanes) | - | per 128-bit half: a's then b's lanes narrowed to 16 bits, saturating\n");
        buf_str(out, c"_mm256_packus_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpackuswb <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 16 < 8 { clamp(a[k / 16 * 8 + k % 16], 0, 255) } else { clamp(b[k / 16 * 8 + k % 16 - 8], 0, 255) } (a, b: i16 lanes; r: u8 lanes) | - | per 128-bit half: a's then b's lanes narrowed to 8 bits, saturating to 0..255\n");
        buf_str(out, c"_mm256_packus_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpackusdw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 8 < 4 { clamp(a[k / 8 * 4 + k % 8], 0, 65535) } else { clamp(b[k / 8 * 4 + k % 8 - 4], 0, 65535) } (a, b: i32 lanes; r: u16 lanes) | - | per 128-bit half: a's then b's lanes narrowed to 16 bits, saturating to 0..65535\n");
        buf_str(out, c"_mm256_hadd_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vphaddw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 8 < 4 { a[k - k % 8 + 2 * (k % 8)] + a[k - k % 8 + 2 * (k % 8) + 1] } else { b[k - k % 8 + 2 * (k % 8) - 8] + b[k - k % 8 + 2 * (k % 8) - 7] } (i16 lanes) | - | per 128-bit half: adjacent pairs, a's then b's (wrapping)\n");
        buf_str(out, c"_mm256_hsub_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vphsubw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 8 < 4 { a[k - k % 8 + 2 * (k % 8)] - a[k - k % 8 + 2 * (k % 8) + 1] } else { b[k - k % 8 + 2 * (k % 8) - 8] - b[k - k % 8 + 2 * (k % 8) - 7] } (i16 lanes) | - | per 128-bit half: adjacent pairs, a's then b's (wrapping)\n");
        buf_str(out, c"_mm256_hadd_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vphaddd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 4 < 2 { a[k - k % 4 + 2 * (k % 4)] + a[k - k % 4 + 2 * (k % 4) + 1] } else { b[k - k % 4 + 2 * (k % 4) - 4] + b[k - k % 4 + 2 * (k % 4) - 3] } (i32 lanes) | - | per 128-bit half: adjacent pairs, a's then b's (wrapping)\n");
        buf_str(out, c"_mm256_hsub_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vphsubd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 4 < 2 { a[k - k % 4 + 2 * (k % 4)] - a[k - k % 4 + 2 * (k % 4) + 1] } else { b[k - k % 4 + 2 * (k % 4) - 4] - b[k - k % 4 + 2 * (k % 4) - 3] } (i32 lanes) | - | per 128-bit half: adjacent pairs, a's then b's (wrapping)\n");
    }
}

// The AArch64 instructions' encodings: insn_a64.def.
pub fn insn_a64_source(out: i64) {
    unsafe {
        buf_str(out, c"uqsub | same3 | 0x2e202c00 | uqsub Vd.T, Vn.T, Vm.T\n");
        buf_str(out, c"umaxv | across | 0x2e30a800 | umaxv <V>d, Vn.T\n");
        buf_str(out, c"umov | umov | 0x0e003c00 | umov Wd, Vn.Ts[i]\n");
        buf_str(out, c"tbl | tbl | 0x0e000000 | tbl Vd.T, {Vn.16b, ...}, Vm.T\n");
        buf_str(out, c"ext | ext | 0x2e000000 | ext Vd.T, Vn.T, Vm.T, #index\n");
        buf_str(out, c"shrn | shrn | 0x0f008400 | shrn Vd.Tb, Vn.Ta, #shift\n");
        buf_str(out, c"crc32cx | crc | 0x9ac05c00 | crc32cx Wd, Wn, Xm\n");
    }
}

