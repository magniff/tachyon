        buf_str(out, c"_mm_sha256msg2_epu32 | sha | (a: __m128i, b: __m128i) -> __m128i | intr | sha256msg2 <b>, <d> | pure tied=a | none | - | r = SHA-256's second message schedule step on a and b (a, b, r: u32 lanes) | aarch64: vsha256su1q_u32 | SHA-256 message schedule, step 2\n");
        buf_str(out, c"_mm256_cmpeq_epi8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpcmpeqb <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = if a[k] == b[k] { -1 } else { 0 } (i8 lanes) | x86_64: _mm_cmpeq_epi8, twice | lanewise a == b: a mask\n");
