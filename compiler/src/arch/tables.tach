        buf_str(out, c"_mm_sha256rnds2_epu32 | sha | (a: __m128i, b: __m128i, wk: __m128i) -> __m128i | intr | sha256rnds2 <wk:0>, <b>, <d> | pure tied=a | none | - | r = two SHA-256 rounds: a the state's C D G H, b its A B E F, wk's lanes 0 and 1 the message words plus constants; the new A B E F (a, b, wk, r: u32 lanes) | aarch64: vsha256hq_u32 + vsha256h2q_u32 | two SHA-256 rounds\n");
