// Lexer: source text to tokens. Mirrors the reference lexer
// (seed/src/lexer, the Rust compiler) token for token; `tachyonc --tokens`
// prints the same dump as `tachyon tokens`.

// ---- Token kinds ----

// (Numbered as in 0.3: the keywords and the punctuation are kept in the
// ranges the token dump of the seed expects.)
enum Tok {
    Eof = 0, Int = 1, Float = 2, Char = 3, Str = 4, CStr = 5, Ident = 6,
    // A reserved word (`trait`, `pub`, ...): an error wherever it is used.
    Reserved = 7,
    // Keywords.
    Fn = 10, Let = 11, Mut = 12, Struct = 13, If = 14, Else = 15, Loop = 16,
    While = 17, For = 18, In = 19, Break = 20, Continue = 21, True = 22,
    False = 23, As = 24, Return = 25, Extern = 26, Const = 27, Static = 28,
    Type = 29, Enum = 30, Match = 31, Impl = 32, Union = 33, Import = 34, Use = 35,
    Pub = 36, Mod = 37,
    // Punctuation.
    PlusEq = 40, MinusEq = 41, StarEq = 42, SlashEq = 43, PercentEq = 44,
    AmpEq = 45, PipeEq = 46, CaretEq = 47, BangEq = 48, EqEq = 49, GtEq = 50,
    LtEq = 51, AmpAmp = 52, PipePipe = 53, Arrow = 54, FatArrow = 55, Shl = 56,
    Shr = 57, ShlEq = 58, ShrEq = 59, DotDot = 60, DotDotEq = 61,
    Ellipsis = 62, ColonColon = 63, Eq = 64, Plus = 65, Minus = 66, Star = 67,
    Slash = 68, Percent = 69, Caret = 70, Amp = 71, Pipe = 72, Tilde = 73,
    Bang = 74, Lt = 75, Gt = 76, Dot = 77, Comma = 78, Semi = 79, Colon = 80,
    Hash = 81, Question = 82, At = 83, LParen = 84, RParen = 85, LBrace = 86,
    RBrace = 87, LBracket = 88, RBracket = 89,
}

// Numeric literal suffixes (0: none).
const SUF_NONE: i64 = 0;
const SUF_I8: i64 = 1;
const SUF_I16: i64 = 2;
const SUF_I32: i64 = 3;
const SUF_I64: i64 = 4;
const SUF_ISIZE: i64 = 5;
const SUF_U8: i64 = 6;
const SUF_U16: i64 = 7;
const SUF_U32: i64 = 8;
const SUF_U64: i64 = 9;
const SUF_USIZE: i64 = 10;
const SUF_F32: i64 = 11;
const SUF_F64: i64 = 12;

// `value` is the integer value, the float's bits, the character, the
// string id (Tok::Str, Tok::CStr) or the symbol (Tok::Ident, Tok::Reserved).
struct Token { kind: Tok, start: i64, end: i64, value: u64, suffix: i64, joint: bool }

static mut TOKS: *Token = 0 as *Token;
static mut TOK_COUNT: i64 = 0;
static mut TOK_CAP: i64 = 0;

// For each symbol: the keyword it spells, Tok::Reserved, or Tok::Eof.
static mut SYM_KEYWORD: *Tok = 0 as *Tok;
static mut SYM_KEYWORD_COUNT: i64 = 0;
static mut SUFFIX_NAME: **u8 = 0 as **u8;
// Symbol of the first suffix name; the suffixes are interned in order.
static mut SUFFIX_SYM_BASE: i64 = 0;

// String literals: their bytes, by id.
static mut STRS: *[u8] = 0 as *[u8];
static mut STR_COUNT: i64 = 0;
static mut STR_CAP: i64 = 0;

fn add_keyword(text: *u8, kind: Tok) {
    let sym = intern_c(text);
    SYM_KEYWORD[sym] = kind;
}

fn add_reserved(text: *u8) {
    let sym = intern_c(text);
    SYM_KEYWORD[sym] = Tok::Reserved;
}

// Interns the keywords first, so their symbols are small numbers.
fn init_lexer() {
    SYM_KEYWORD_COUNT = 64;
    SYM_KEYWORD = alloc_zeroed(SYM_KEYWORD_COUNT) as *Tok;
    add_keyword(c"fn", Tok::Fn);
    add_keyword(c"let", Tok::Let);
    add_keyword(c"mut", Tok::Mut);
    add_keyword(c"struct", Tok::Struct);
    add_keyword(c"if", Tok::If);
    add_keyword(c"else", Tok::Else);
    add_keyword(c"loop", Tok::Loop);
    add_keyword(c"while", Tok::While);
    add_keyword(c"for", Tok::For);
    add_keyword(c"in", Tok::In);
    add_keyword(c"break", Tok::Break);
    add_keyword(c"continue", Tok::Continue);
    add_keyword(c"true", Tok::True);
    add_keyword(c"false", Tok::False);
    add_keyword(c"as", Tok::As);
    add_keyword(c"return", Tok::Return);
    add_keyword(c"extern", Tok::Extern);
    add_keyword(c"const", Tok::Const);
    add_keyword(c"static", Tok::Static);
    add_keyword(c"type", Tok::Type);
    add_keyword(c"enum", Tok::Enum);
    add_keyword(c"match", Tok::Match);
    add_keyword(c"impl", Tok::Impl);
    add_keyword(c"union", Tok::Union);
    add_keyword(c"import", Tok::Import);
    add_keyword(c"use", Tok::Use);
    add_keyword(c"pub", Tok::Pub);
    add_keyword(c"mod", Tok::Mod);
    add_reserved(c"trait");
    add_reserved(c"where");
    add_reserved(c"unsafe");
    add_reserved(c"defer");
    add_reserved(c"dyn");
    add_reserved(c"move");
    init_suffixes();
}

impl Tok {
    // The text of a keyword or punctuation token, for messages and the token
    // dump.
    fn text(self: Tok) -> *u8 {
        match self {
            Tok::Eof => c"EOF",
            Tok::Fn => c"fn",
            Tok::Let => c"let",
            Tok::Mut => c"mut",
            Tok::Struct => c"struct",
            Tok::If => c"if",
            Tok::Else => c"else",
            Tok::Loop => c"loop",
            Tok::While => c"while",
            Tok::For => c"for",
            Tok::In => c"in",
            Tok::Break => c"break",
            Tok::Continue => c"continue",
            Tok::True => c"true",
            Tok::False => c"false",
            Tok::As => c"as",
            Tok::Return => c"return",
            Tok::Extern => c"extern",
            Tok::Const => c"const",
            Tok::Static => c"static",
            Tok::Type => c"type",
            Tok::Enum => c"enum",
            Tok::Match => c"match",
            Tok::Impl => c"impl",
            Tok::Union => c"union",
            Tok::Import => c"import",
            Tok::Use => c"use",
            Tok::Pub => c"pub",
            Tok::Mod => c"mod",
            Tok::PlusEq => c"+=",
            Tok::MinusEq => c"-=",
            Tok::StarEq => c"*=",
            Tok::SlashEq => c"/=",
            Tok::PercentEq => c"%=",
            Tok::AmpEq => c"&=",
            Tok::PipeEq => c"|=",
            Tok::CaretEq => c"^=",
            Tok::BangEq => c"!=",
            Tok::EqEq => c"==",
            Tok::GtEq => c">=",
            Tok::LtEq => c"<=",
            Tok::AmpAmp => c"&&",
            Tok::PipePipe => c"||",
            Tok::Arrow => c"->",
            Tok::FatArrow => c"=>",
            Tok::Shl => c"<<",
            Tok::Shr => c">>",
            Tok::ShlEq => c"<<=",
            Tok::ShrEq => c">>=",
            Tok::DotDot => c"..",
            Tok::DotDotEq => c"..=",
            Tok::Ellipsis => c"...",
            Tok::ColonColon => c"::",
            Tok::Eq => c"=",
            Tok::Plus => c"+",
            Tok::Minus => c"-",
            Tok::Star => c"*",
            Tok::Slash => c"/",
            Tok::Percent => c"%",
            Tok::Caret => c"^",
            Tok::Amp => c"&",
            Tok::Pipe => c"|",
            Tok::Tilde => c"~",
            Tok::Bang => c"!",
            Tok::Lt => c"<",
            Tok::Gt => c">",
            Tok::Dot => c".",
            Tok::Comma => c",",
            Tok::Semi => c";",
            Tok::Colon => c":",
            Tok::Hash => c"#",
            Tok::Question => c"?",
            Tok::At => c"@",
            Tok::LParen => c"(",
            Tok::RParen => c")",
            Tok::LBrace => c"{",
            Tok::RBrace => c"}",
            Tok::LBracket => c"[",
            Tok::RBracket => c"]",
            // Tokens with a value: printed with it, by their users.
            _ => c"",
        }
    }

    // Keywords: printed as the identifier they are spelled with.
    fn is_keyword(self: Tok) -> bool {
        let k = self as i64;
        k >= Tok::Fn as i64 && k <= Tok::Mod as i64
    }
}

fn init_suffixes() {
    SUFFIX_NAME = alloc_zeroed(13 * 8) as **u8;
    SUFFIX_NAME[SUF_I8] = c"i8";
    SUFFIX_NAME[SUF_I16] = c"i16";
    SUFFIX_NAME[SUF_I32] = c"i32";
    SUFFIX_NAME[SUF_I64] = c"i64";
    SUFFIX_NAME[SUF_ISIZE] = c"isize";
    SUFFIX_NAME[SUF_U8] = c"u8";
    SUFFIX_NAME[SUF_U16] = c"u16";
    SUFFIX_NAME[SUF_U32] = c"u32";
    SUFFIX_NAME[SUF_U64] = c"u64";
    SUFFIX_NAME[SUF_USIZE] = c"usize";
    SUFFIX_NAME[SUF_F32] = c"f32";
    SUFFIX_NAME[SUF_F64] = c"f64";
    SUFFIX_SYM_BASE = SYM_COUNT;
    for suffix in 1..13 {
        intern_c(SUFFIX_NAME[suffix]);
    }
}

// The suffix a symbol names, or SUF_NONE.
fn suffix_of_sym(sym: i64) -> i64 {
    if sym >= SUFFIX_SYM_BASE && sym < SUFFIX_SYM_BASE + 12 {
        return sym - SUFFIX_SYM_BASE + 1;
    }
    SUF_NONE
}

fn is_float_suffix(suffix: i64) -> bool {
    suffix == SUF_F32 || suffix == SUF_F64
}

fn keyword_of_sym(sym: i64) -> Tok {
    if sym < SYM_KEYWORD_COUNT { SYM_KEYWORD[sym] } else { Tok::Eof }
}

// ---- The lexer ----

static mut LEX_POS: i64 = 0;
static mut LEX_END: i64 = 0;
// The previous token was '.', so a number is a tuple index (`t.0.1`).
static mut LEX_AFTER_DOT: bool = false;
static mut LEX_SCRATCH: i64 = -1;

fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn is_alpha(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

fn is_ident_byte(c: u8) -> bool {
    c == '_' || is_alpha(c) || is_digit(c)
}

fn is_whitespace(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

// The byte at `offset` from the lexer position, 0 past the end.
fn peek_at(offset: i64) -> u8 {
    if LEX_POS + offset < LEX_END { SRC[LEX_POS + offset] } else { 0 }
}

fn at_end() -> bool {
    LEX_POS >= LEX_END
}

fn push_token(kind: Tok, start: i64, value: u64, suffix: i64) {
    TOKS = grow(TOKS as *u8, TOK_COUNT, &TOK_CAP, 48) as *Token;
    TOKS[TOK_COUNT] = Token {
        kind: kind, start: start, end: LEX_POS, value: value, suffix: suffix, joint: at_joint(),
    };
    TOK_COUNT += 1;
    LEX_AFTER_DOT = kind == Tok::Dot;
}

// Nothing separates the token just lexed from the next one.
fn at_joint() -> bool {
    if at_end() {
        return false;
    }
    let c = peek_at(0);
    if is_whitespace(c) {
        return false;
    }
    if c == '/' {
        let next = peek_at(1);
        return !(next == '/' || next == '*');
    }
    true
}

fn skip_whitespace_and_comments() {
    loop {
        while !at_end() && is_whitespace(peek_at(0)) {
            LEX_POS += 1;
        }
        if peek_at(0) == '/' && peek_at(1) == '/' {
            while !at_end() && peek_at(0) != '\n' {
                LEX_POS += 1;
            }
        } else if peek_at(0) == '/' && peek_at(1) == '*' {
            skip_block_comment();
        } else {
            return;
        }
    }
}

// Block comments nest.
fn skip_block_comment() {
    let start = LEX_POS;
    let mut depth = 0;
    while !at_end() {
        if peek_at(0) == '/' && peek_at(1) == '*' {
            depth += 1;
            LEX_POS += 2;
        } else if peek_at(0) == '*' && peek_at(1) == '/' {
            depth -= 1;
            LEX_POS += 2;
            if depth == 0 {
                return;
            }
        } else {
            LEX_POS += 1;
        }
    }
    error_at(start, c"unterminated block comment");
}

// Lexes SRC[start..end) and appends its tokens; `last` adds the EOF token.
fn lex_range(start: i64, end: i64, last: bool) {
    if LEX_SCRATCH < 0 {
        LEX_SCRATCH = buf_new();
    }
    LEX_POS = start;
    LEX_END = end;
    LEX_AFTER_DOT = false;
    loop {
        skip_whitespace_and_comments();
        if at_end() {
            break;
        }
        lex_token();
    }
    if last {
        push_token(Tok::Eof, LEX_POS, 0, 0);
    }
}

fn lex_token() {
    let c = peek_at(0);
    if c == '"' {
        lex_string(LEX_POS, false);
    } else if c == 'c' && peek_at(1) == '"' {
        lex_string(LEX_POS, true);
    } else if c == '\'' {
        lex_char();
    } else if is_digit(c) {
        lex_number();
    } else if c == 'r' && peek_at(1) == '#' && (peek_at(2) == '_' || is_alpha(peek_at(2))) {
        lex_raw_ident();
    } else if c == '_' || is_alpha(c) {
        lex_ident();
    } else {
        lex_operator();
    }
}

fn lex_ident() {
    let start = LEX_POS;
    while !at_end() && is_ident_byte(peek_at(0)) {
        LEX_POS += 1;
    }
    let sym = intern(SRC[start..LEX_POS]);
    let keyword = keyword_of_sym(sym);
    if keyword == Tok::Eof {
        push_token(Tok::Ident, start, sym as u64, 0);
    } else {
        push_token(keyword, start, sym as u64, 0);
    }
}

// `r#name`: an identifier even when `name` is a keyword (C names imported
// by `import`, for instance a field named `type`).
fn lex_raw_ident() {
    let start = LEX_POS;
    LEX_POS += 2;
    let name_start = LEX_POS;
    while !at_end() && is_ident_byte(peek_at(0)) {
        LEX_POS += 1;
    }
    push_token(Tok::Ident, start, intern(SRC[name_start..LEX_POS]) as u64, 0);
}

// The operators spelled by the next bytes (Tok::Eof: none).
fn three_char_operator(a: u8, b: u8, c: u8) -> Tok {
    if a == '<' && b == '<' && c == '=' { return Tok::ShlEq; }
    if a == '>' && b == '>' && c == '=' { return Tok::ShrEq; }
    if a == '.' && b == '.' && c == '.' { return Tok::Ellipsis; }
    if a == '.' && b == '.' && c == '=' { return Tok::DotDotEq; }
    Tok::Eof
}

fn two_char_operator(a: u8, b: u8) -> Tok {
    if b == '=' {
        if a == '+' { return Tok::PlusEq; }
        if a == '-' { return Tok::MinusEq; }
        if a == '*' { return Tok::StarEq; }
        if a == '/' { return Tok::SlashEq; }
        if a == '%' { return Tok::PercentEq; }
        if a == '&' { return Tok::AmpEq; }
        if a == '|' { return Tok::PipeEq; }
        if a == '^' { return Tok::CaretEq; }
        if a == '!' { return Tok::BangEq; }
        if a == '=' { return Tok::EqEq; }
        if a == '>' { return Tok::GtEq; }
        if a == '<' { return Tok::LtEq; }
        return Tok::Eof;
    }
    if a == '<' && b == '<' { return Tok::Shl; }
    if a == '>' && b == '>' { return Tok::Shr; }
    if a == '&' && b == '&' { return Tok::AmpAmp; }
    if a == '|' && b == '|' { return Tok::PipePipe; }
    if a == '-' && b == '>' { return Tok::Arrow; }
    if a == '=' && b == '>' { return Tok::FatArrow; }
    if a == '.' && b == '.' { return Tok::DotDot; }
    if a == ':' && b == ':' { return Tok::ColonColon; }
    Tok::Eof
}

fn one_char_operator(c: u8) -> Tok {
    if c == '=' { return Tok::Eq; }
    if c == '+' { return Tok::Plus; }
    if c == '-' { return Tok::Minus; }
    if c == '*' { return Tok::Star; }
    if c == '/' { return Tok::Slash; }
    if c == '%' { return Tok::Percent; }
    if c == '^' { return Tok::Caret; }
    if c == '&' { return Tok::Amp; }
    if c == '|' { return Tok::Pipe; }
    if c == '~' { return Tok::Tilde; }
    if c == '!' { return Tok::Bang; }
    if c == '<' { return Tok::Lt; }
    if c == '>' { return Tok::Gt; }
    if c == '.' { return Tok::Dot; }
    if c == ',' { return Tok::Comma; }
    if c == ';' { return Tok::Semi; }
    if c == ':' { return Tok::Colon; }
    if c == '#' { return Tok::Hash; }
    if c == '?' { return Tok::Question; }
    if c == '@' { return Tok::At; }
    if c == '(' { return Tok::LParen; }
    if c == ')' { return Tok::RParen; }
    if c == '{' { return Tok::LBrace; }
    if c == '}' { return Tok::RBrace; }
    if c == '[' { return Tok::LBracket; }
    if c == ']' { return Tok::RBracket; }
    Tok::Eof
}

fn lex_operator() {
    let start = LEX_POS;
    let a = peek_at(0);
    if LEX_POS + 2 < LEX_END {
        let kind = three_char_operator(a, peek_at(1), peek_at(2));
        if kind != Tok::Eof {
            LEX_POS += 3;
            push_token(kind, start, 0, 0);
            return;
        }
    }
    if LEX_POS + 1 < LEX_END {
        let kind = two_char_operator(a, peek_at(1));
        if kind != Tok::Eof {
            LEX_POS += 2;
            push_token(kind, start, 0, 0);
            return;
        }
    }
    let kind = one_char_operator(a);
    if kind == Tok::Eof {
        error_at(start, c"unexpected character");
    }
    LEX_POS += 1;
    push_token(kind, start, 0, 0);
}

// ---- Strings and characters ----

fn add_string(bytes: [u8]) -> i64 {
    STRS = grow(STRS as *u8, STR_COUNT, &STR_CAP, 16) as *[u8];
    let n = bytes.len as i64;
    let copy = alloc_zeroed(n + 1);
    memcpy(copy, bytes.ptr, n as u64);
    STRS[STR_COUNT] = copy[0..n];
    STR_COUNT += 1;
    STR_COUNT - 1
}

// `"..."` or `c"..."` starting at `start`.
fn lex_string(start: i64, is_c: bool) {
    LEX_POS += if is_c { 2 } else { 1 };
    buf_clear(LEX_SCRATCH);
    loop {
        if at_end() {
            error_at(start, c"unterminated string literal");
        }
        let c = peek_at(0);
        LEX_POS += 1;
        if c == '"' {
            break;
        }
        if c == '\n' {
            error_at(LEX_POS - 1, c"newline in string literal");
        }
        if c == '\\' {
            lex_escape(LEX_SCRATCH, false);
        } else {
            buf_byte(LEX_SCRATCH, c);
        }
    }
    let bytes = BUFS[LEX_SCRATCH].data;
    let n = BUFS[LEX_SCRATCH].len;
    if is_c {
        for i in 0..n {
            if bytes[i] == 0 {
                error_at(start, c"C string literal contains a NUL byte");
            }
        }
    }
    let id = add_string(bytes[0..n]);
    push_token(if is_c { Tok::CStr } else { Tok::Str }, start, id as u64, 0);
}

fn hex_value(c: u8) -> i64 {
    if c >= '0' && c <= '9' { return (c - '0') as i64; }
    if c >= 'a' && c <= 'f' { return (c - 'a') as i64 + 10; }
    if c >= 'A' && c <= 'F' { return (c - 'A') as i64 + 10; }
    -1
}

fn lex_hex_digit() -> i64 {
    if at_end() {
        error_at(LEX_POS, c"expected hex digit");
    }
    let value = hex_value(peek_at(0));
    if value < 0 {
        error_at(LEX_POS, c"expected hex digit");
    }
    LEX_POS += 1;
    value
}

// UTF-8 encoding of a code point.
fn buf_utf8(out: i64, cp: i64) {
    if cp < 0x80 {
        buf_byte(out, cp as u8);
    } else if cp < 0x800 {
        buf_byte(out, (0xc0 | (cp >> 6)) as u8);
        buf_byte(out, (0x80 | (cp & 0x3f)) as u8);
    } else if cp < 0x10000 {
        buf_byte(out, (0xe0 | (cp >> 12)) as u8);
        buf_byte(out, (0x80 | ((cp >> 6) & 0x3f)) as u8);
        buf_byte(out, (0x80 | (cp & 0x3f)) as u8);
    } else {
        buf_byte(out, (0xf0 | (cp >> 18)) as u8);
        buf_byte(out, (0x80 | ((cp >> 12) & 0x3f)) as u8);
        buf_byte(out, (0x80 | ((cp >> 6) & 0x3f)) as u8);
        buf_byte(out, (0x80 | (cp & 0x3f)) as u8);
    }
}

// An escape after '\'; appends its bytes to `out`.
fn lex_escape(out: i64, in_char: bool) {
    if at_end() {
        error_at(LEX_POS, c"unterminated escape");
    }
    let escape_at = LEX_POS;
    let c = peek_at(0);
    LEX_POS += 1;
    if c == 'n' { buf_byte(out, '\n'); return; }
    if c == 't' { buf_byte(out, '\t'); return; }
    if c == 'r' { buf_byte(out, '\r'); return; }
    if c == '0' { buf_byte(out, 0); return; }
    if c == '"' { buf_byte(out, '"'); return; }
    if c == '\'' { buf_byte(out, '\''); return; }
    if c == '\\' { buf_byte(out, '\\'); return; }
    if c == 'x' {
        let high = lex_hex_digit();
        let low = lex_hex_digit();
        buf_byte(out, ((high << 4) | low) as u8);
        return;
    }
    if c == 'u' {
        let cp = lex_unicode_escape(escape_at - 1, in_char);
        buf_utf8(out, cp);
        return;
    }
    error_at(escape_at, c"unknown escape");
}

fn lex_unicode_escape(backslash_at: i64, in_char: bool) -> i64 {
    if peek_at(0) != '{' || at_end() {
        error_at(LEX_POS, c"expected '{' after '\\u'");
    }
    LEX_POS += 1;
    let mut value = 0;
    let mut digits = 0;
    while at_end() || peek_at(0) != '}' {
        if digits == 6 {
            error_at(LEX_POS, c"too many digits in '\\u{...}' escape");
        }
        value = value * 16 + lex_hex_digit();
        digits += 1;
    }
    LEX_POS += 1;
    if digits == 0 {
        error_at(LEX_POS, c"empty '\\u{}' escape");
    }
    if value > 0x10ffff || (value >= 0xd800 && value <= 0xdfff) {
        error_at(backslash_at, c"invalid unicode escape");
    }
    if in_char && value >= 0x80 {
        error_at(backslash_at, c"character literal is not ASCII (a character is one byte, u8)");
    }
    value
}

fn lex_char() {
    let start = LEX_POS;
    LEX_POS += 1;
    buf_clear(LEX_SCRATCH);
    let c = peek_at(0);
    if at_end() || c == '\n' {
        error_at(start, c"unterminated character literal");
    }
    if c == '\'' {
        error_at(start, c"empty character literal");
    }
    if c == '\\' {
        LEX_POS += 1;
        lex_escape(LEX_SCRATCH, true);
    } else if c < 0x80 {
        LEX_POS += 1;
        buf_byte(LEX_SCRATCH, c);
    } else {
        // The character's UTF-8 bytes: the lead byte and its continuations.
        let mut end = LEX_POS + 1;
        while end < LEX_END && (SRC[end] & 0xc0) == 0x80 {
            end += 1;
        }
        err_begin(start);
        err_str(c"character literal '");
        buf_bytes(ERR, SRC[LEX_POS..end]);
        err_str(c"' is not ASCII (a character is one byte, u8)");
        err_end();
    }
    if at_end() || peek_at(0) != '\'' {
        error_at(start, c"unterminated character literal (expected ')");
    }
    LEX_POS += 1;
    push_token(Tok::Char, start, BUFS[LEX_SCRATCH].data[0] as u64, 0);
}

// ---- Numbers ----

// A '_' may end the digits only when a suffix follows (`1_u8`).
fn check_trailing_underscore(last_underscore: bool) {
    if last_underscore && !(!at_end() && is_alpha(peek_at(0))) {
        error_at(LEX_POS - 1, c"trailing underscore in literal");
    }
}

fn lex_number() {
    let start = LEX_POS;
    let second = peek_at(1);
    if peek_at(0) == '0' && (second == 'x' || second == 'X' || second == 'b' || second == 'B') {
        let radix: u64 = if second == 'x' || second == 'X' { 16 } else { 2 };
        LEX_POS += 2;
        let value = lex_radix_digits(radix);
        lex_int_suffix(value, start, false);
        return;
    }
    lex_decimal_or_float(start);
}

fn digit_value(c: u8, radix: u64) -> i64 {
    let value = hex_value(c);
    if value < 0 || value as u64 >= radix { -1 } else { value }
}

fn lex_radix_digits(radix: u64) -> u64 {
    if at_end() || digit_value(peek_at(0), radix) < 0 {
        error_at(LEX_POS, if radix == 16 { c"expected hex digit after '0x'" } else { c"expected binary digit after '0b'" });
    }
    let mut value: u64 = 0;
    let mut last_underscore = false;
    while !at_end() {
        let c = peek_at(0);
        if c == '_' {
            last_underscore = true;
            LEX_POS += 1;
            continue;
        }
        let digit = digit_value(c, radix);
        if digit < 0 {
            break;
        }
        last_underscore = false;
        if value > (0xffffffffffffffff - digit as u64) / radix {
            error_at(LEX_POS, c"literal overflow");
        }
        value = value * radix + digit as u64;
        LEX_POS += 1;
    }
    check_trailing_underscore(last_underscore);
    value
}

// An identifier glued to a literal: its symbol, or -1.
fn read_suffix() -> i64 {
    if at_end() || !is_ident_byte(peek_at(0)) {
        return -1;
    }
    let start = LEX_POS;
    while !at_end() && is_ident_byte(peek_at(0)) {
        LEX_POS += 1;
    }
    intern(SRC[start..LEX_POS])
}

fn bits_of_f64(value: f64) -> u64 {
    let copy = value;
    *(&copy as *u64)
}

fn lex_int_suffix(value: u64, start: i64, decimal: bool) {
    let suffix_at = LEX_POS;
    let sym = read_suffix();
    if sym < 0 {
        push_token(Tok::Int, start, value, 0);
        return;
    }
    let suffix = suffix_of_sym(sym);
    if suffix != SUF_NONE && is_float_suffix(suffix) && decimal {
        push_token(Tok::Float, start, bits_of_f64(value as f64), suffix);
        return;
    }
    if suffix != SUF_NONE && !is_float_suffix(suffix) {
        push_token(Tok::Int, start, value, suffix);
        return;
    }
    error_at(suffix_at, c"invalid suffix on integer literal");
}

// Decimal digits (without '_') appended to `out`.
fn read_decimal_digits(out: i64) {
    if at_end() || !is_digit(peek_at(0)) {
        error_at(LEX_POS, c"expected digit");
    }
    let mut last_underscore = false;
    while !at_end() {
        let c = peek_at(0);
        if c == '_' {
            last_underscore = true;
            LEX_POS += 1;
            continue;
        }
        if !is_digit(c) {
            break;
        }
        last_underscore = false;
        buf_byte(out, c);
        LEX_POS += 1;
    }
    check_trailing_underscore(last_underscore);
}

// An exponent (`e5`, `E-3`) starts here.
fn at_exponent() -> bool {
    let e = peek_at(0);
    if at_end() || !(e == 'e' || e == 'E') || LEX_POS + 1 >= LEX_END {
        return false;
    }
    let sign = peek_at(1);
    if sign == '+' || sign == '-' {
        return LEX_POS + 2 < LEX_END && is_digit(peek_at(2));
    }
    is_digit(sign)
}

fn lex_decimal_or_float(start: i64) {
    let text = LEX_SCRATCH;
    buf_clear(text);
    read_decimal_digits(text);
    let has_fraction = peek_at(0) == '.' && LEX_POS + 1 < LEX_END && is_digit(peek_at(1));
    let has_exponent = at_exponent();
    if LEX_AFTER_DOT || !(has_fraction || has_exponent) {
        let mut value: u64 = 0;
        for i in 0..BUFS[text].len {
            let digit = (BUFS[text].data[i] - '0') as u64;
            if value > (0xffffffffffffffff - digit) / 10 {
                error_at(LEX_POS, c"integer overflow");
            }
            value = value * 10 + digit;
        }
        lex_int_suffix(value, start, !LEX_AFTER_DOT);
        return;
    }
    if has_fraction {
        LEX_POS += 1;
        buf_byte(text, '.');
        read_decimal_digits(text);
    }
    if !at_end() && (peek_at(0) == 'e' || peek_at(0) == 'E') {
        LEX_POS += 1;
        buf_byte(text, 'e');
        if !at_end() && (peek_at(0) == '+' || peek_at(0) == '-') {
            buf_byte(text, peek_at(0));
            LEX_POS += 1;
        }
        if at_end() || !is_digit(peek_at(0)) {
            error_at(LEX_POS, c"expected digit in exponent");
        }
        read_decimal_digits(text);
    }
    buf_byte(text, 0);
    let value = strtod(BUFS[text].data, 0 as **u8);
    let suffix_at = LEX_POS;
    let sym = read_suffix();
    if sym < 0 {
        push_token(Tok::Float, start, bits_of_f64(value), 0);
        return;
    }
    let suffix = suffix_of_sym(sym);
    if suffix == SUF_NONE || !is_float_suffix(suffix) {
        error_at(suffix_at, c"invalid suffix on float literal");
    }
    push_token(Tok::Float, start, bits_of_f64(value), suffix);
}

// ---- The token dump (`--tokens`) ----

fn dump_tokens(out: i64, base: i64) {
    for i in 0..TOK_COUNT {
        let tok = &TOKS[i];
        buf_int(out, (*tok).start - base);
        buf_byte(out, ' ');
        buf_int(out, (*tok).end - base);
        buf_byte(out, ' ');
        buf_byte(out, if (*tok).joint { '1' } else { '0' });
        buf_byte(out, ' ');
        dump_token_text(out, tok);
        buf_byte(out, '\n');
    }
}

fn dump_hex_bytes(out: i64, id: i64) {
    for i in 0..STRS[id].len as i64 {
        buf_hex(out, STRS[id].ptr[i] as u64, 2);
    }
}

fn dump_token_text(out: i64, tok: *Token) {
    let kind = (*tok).kind;
    let value = (*tok).value;
    if kind == Tok::Int {
        buf_str(out, c"int ");
        buf_uint(out, value);
    } else if kind == Tok::Float {
        buf_str(out, c"float ");
        buf_hex(out, value, 16);
    } else if kind == Tok::Char {
        buf_str(out, c"char ");
        buf_uint(out, value);
    } else if kind == Tok::Str {
        buf_str(out, c"str ");
        dump_hex_bytes(out, value as i64);
    } else if kind == Tok::CStr {
        buf_str(out, c"cstr ");
        dump_hex_bytes(out, value as i64);
    } else if kind == Tok::Ident {
        buf_str(out, c"ident ");
        buf_str(out, sym_name(value as i64));
    } else if kind == Tok::Reserved {
        buf_str(out, sym_name(value as i64));
    } else {
        buf_str(out, kind.text());
    }
    if (*tok).suffix != SUF_NONE {
        buf_byte(out, ' ');
        buf_str(out, SUFFIX_NAME[(*tok).suffix]);
    }
}
