// AArch64 instructions for the IR back end (51_emit.tach), on physical
// registers: 0-30 are x0-x30, 31 is sp (as a base or an addition source),
// 32 + n is d<n> (s<n> for f32).
//
// Use of the registers: x0-x7 carry arguments and serve as operand
// scratch registers (x0-x2) and the result scratch register (x3) between
// calls; x8 is the result pointer; x9-x15 (caller-saved) and x19-x28
// (callee-saved) are allocated; x16 holds the callee of indirect calls and
// is the parallel moves' temporary; x17 breaks parallel move cycles and is
// the temporary for addresses and constants here; x18 is reserved by the
// platform. d0-d7 carry arguments and serve as scratch; d8-d15 and
// d16-d29 are allocated; d30 and d31 are the parallel moves' registers.

fn ma_r(r: i64) {
    if r == 31 {
        o(c"sp");
    } else {
        o(c"x");
        oi(r);
    }
}

fn ma_w(r: i64) {
    o(c"w");
    oi(r);
}

// The float register r (32 + n) for a value of type ty.
fn ma_f(r: i64, ty: i64) {
    o(if ty == TY_F32 { c"s" } else { c"d" });
    oi(r - 32);
}

// "    <mnemonic> x<d>, x<a>, x<b>\n"
fn ma_rrr(mnemonic: *u8, d: i64, a: i64, b: i64) {
    o(c"    ");
    o(mnemonic);
    o(c" ");
    ma_r(d);
    o(c", ");
    ma_r(a);
    o(c", ");
    ma_r(b);
    on();
}

fn ma_rr(mnemonic: *u8, d: i64, a: i64) {
    o(c"    ");
    o(mnemonic);
    o(c" ");
    ma_r(d);
    o(c", ");
    ma_r(a);
    on();
}

fn ma_mov(dst: i64, src: i64, ty: i64) {
    if dst >= 32 {
        o(c"    fmov ");
        ma_f(dst, TY_F64);
        o(c", ");
        ma_f(src, TY_F64);
        on();
    } else {
        ma_rr(c"mov", dst, src);
    }
}

fn ma_load_imm(dst: i64, value: u64) {
    let signed = value as i64;
    // One instruction: movz, or movn for small negative values.
    if (signed >= 0 && signed < 65536) || (signed < 0 && signed >= -65536) {
        o(c"    mov ");
        ma_r(dst);
        o(c", #");
        oi(signed);
        on();
        return;
    }
    a64_load_imm(dst, value);
}

fn ma_load_fimm(dst: i64, bits: i64, ty: i64) {
    if bits == 0 {
        o(c"    fmov ");
        ma_f(dst, ty);
        o(if ty == TY_F32 { c", wzr\n" } else { c", xzr\n" });
        return;
    }
    if ty == TY_F32 {
        a64_load_imm(17, f32_bits(f64_of_bits(bits)) as u64);
        o(c"    fmov ");
        ma_f(dst, ty);
        o(c", w17\n");
    } else {
        a64_load_imm(17, bits as u64);
        o(c"    fmov ");
        ma_f(dst, ty);
        o(c", x17\n");
    }
}

// dst = base + offset.
fn ma_lea(dst: i64, base: i64, offset: i64) {
    if offset == 0 {
        if dst != base {
            ma_rr(c"mov", dst, base);
        }
        return;
    }
    if offset > 0 && offset < 4096 {
        ma_rr(c"add", dst, base);
        o_back_imm(offset);
        return;
    }
    if offset < 0 && offset > -4096 {
        ma_rr(c"sub", dst, base);
        o_back_imm(0 - offset);
        return;
    }
    a64_load_imm(17, offset as u64);
    ma_rrr(c"add", dst, base, 17);
}

// Replaces the newline just written with ", #<value>\n".
fn o_back_imm(value: i64) {
    BUFS[CODE].len -= 1;
    o(c", #");
    oi(value);
    on();
}

// "[x<base>, #offset]" when encodable as an unsigned scaled offset;
// otherwise the address is computed into x17 first (call before starting
// the instruction's line).
fn ma_address(base: i64, offset: i64, size: i64) -> i64 {
    if offset >= 0 && offset % size == 0 && offset / size < 4096 {
        return offset;
    }
    ma_lea(17, base, offset);
    -1
}

fn ma_mem_operand(base: i64, offset: i64) {
    o(c"[");
    if offset < 0 {
        o(c"x17]");
        return;
    }
    ma_r(base);
    if offset != 0 {
        o(c", #");
        oi(offset);
    }
    o(c"]");
}

fn ma_load(ty: i64, dst: i64, base: i64, offset: i64) {
    let size = size_of(ty);
    let at = ma_address(base, offset, size);
    o(c"    ");
    if is_float(ty) {
        o(c"ldr ");
        ma_f(dst, ty);
    } else if ty == TY_I8 {
        o(c"ldrsb ");
        ma_r(dst);
    } else if size == 1 {
        o(c"ldrb ");
        ma_w(dst);
    } else if ty == TY_I16 {
        o(c"ldrsh ");
        ma_r(dst);
    } else if size == 2 {
        o(c"ldrh ");
        ma_w(dst);
    } else if ty == TY_I32 {
        o(c"ldrsw ");
        ma_r(dst);
    } else if size == 4 {
        o(c"ldr ");
        ma_w(dst);
    } else {
        o(c"ldr ");
        ma_r(dst);
    }
    o(c", ");
    ma_mem_operand(base, at);
    on();
}

fn ma_store(ty: i64, src: i64, base: i64, offset: i64) {
    let size = size_of(ty);
    let at = ma_address(base, offset, size);
    o(c"    ");
    if is_float(ty) {
        o(c"str ");
        ma_f(src, ty);
    } else if size == 1 {
        o(c"strb ");
        ma_w(src);
    } else if size == 2 {
        o(c"strh ");
        ma_w(src);
    } else if size == 4 {
        o(c"str ");
        ma_w(src);
    } else {
        o(c"str ");
        ma_r(src);
    }
    o(c", ");
    ma_mem_operand(base, at);
    on();
}

fn ma_symbol_addr(dst: i64, prefix: *u8, name: i64) {
    o(c"    adrp ");
    ma_r(dst);
    o(c", ");
    emit_symbol_ref(prefix, name);
    o(c"@PAGE\n    add ");
    ma_r(dst);
    o(c", ");
    ma_r(dst);
    o(c", ");
    emit_symbol_ref(prefix, name);
    o(c"@PAGEOFF\n");
}

fn ma_extern_addr(dst: i64, name: i64) {
    o(c"    adrp ");
    ma_r(dst);
    o(c", ");
    emit_symbol_ref(c"_", name);
    o(c"@GOTPAGE\n    ldr ");
    ma_r(dst);
    o(c", [");
    ma_r(dst);
    o(c", ");
    emit_symbol_ref(c"_", name);
    o(c"@GOTPAGEOFF]\n");
}

fn ma_string_addr(dst: i64, id: i64) {
    o(c"    adrp ");
    ma_r(dst);
    end_i(c", Lstr.", id, c"@PAGE");
    o(c"    add ");
    ma_r(dst);
    o(c", ");
    ma_r(dst);
    end_i(c", Lstr.", id, c"@PAGEOFF");
}

fn ma_normalize(r: i64, ty: i64) {
    if ty == TY_I8 {
        o(c"    sxtb ");
        ma_r(r);
        o(c", ");
        ma_w(r);
        on();
    } else if ty == TY_U8 {
        ma_rr(c"and", r, r);
        o_back_imm(0xff);
    } else if ty == TY_I16 {
        o(c"    sxth ");
        ma_r(r);
        o(c", ");
        ma_w(r);
        on();
    } else if ty == TY_U16 {
        ma_rr(c"and", r, r);
        o_back_imm(0xffff);
    } else if ty == TY_I32 {
        o(c"    sxtw ");
        ma_r(r);
        o(c", ");
        ma_w(r);
        on();
    } else if ty == TY_U32 {
        o(c"    mov ");
        ma_w(r);
        o(c", ");
        ma_w(r);
        on();
    }
}

// Division by zero gives 0 (and the remainder the dividend), as sdiv and
// udiv do.
fn ma_int_op(op: Op, ty: i64, d: i64, a: i64, b: i64) {
    let signed = is_signed(ty);
    if op == Op::Add { ma_rrr(c"add", d, a, b); }
    else if op == Op::Sub { ma_rrr(c"sub", d, a, b); }
    else if op == Op::Mul { ma_rrr(c"mul", d, a, b); }
    else if op == Op::Div { ma_rrr(if signed { c"sdiv" } else { c"udiv" }, d, a, b); }
    else if op == Op::Rem {
        ma_rrr(if signed { c"sdiv" } else { c"udiv" }, 17, a, b);
        o(c"    msub ");
        ma_r(d);
        o(c", x17, ");
        ma_r(b);
        o(c", ");
        ma_r(a);
        on();
    } else if op == Op::And { ma_rrr(c"and", d, a, b); }
    else if op == Op::Or { ma_rrr(c"orr", d, a, b); }
    else if op == Op::Xor { ma_rrr(c"eor", d, a, b); }
    else {
        // The amount is taken modulo 32 for types up to 32 bits, modulo 64
        // for 64-bit ones.
        ma_rr(c"and", 17, b);
        o_back_imm(if int_bits(ty) == 64 { 63 } else { 31 });
        if op == Op::Shl {
            ma_rrr(c"lsl", d, a, 17);
        } else {
            ma_rrr(if signed { c"asr" } else { c"lsr" }, d, a, 17);
        }
    }
    ma_normalize(d, ty);
}

fn ma_int_op_imm(op: Op, ty: i64, d: i64, a: i64, imm: i64) -> bool {
    if op == Op::Add || op == Op::Sub {
        let mut value = imm;
        let mut subtract = op == Op::Sub;
        if value < 0 && value > -4096 {
            value = 0 - value;
            subtract = !subtract;
        }
        if value < 0 || value >= 4096 {
            return false;
        }
        ma_rr(if subtract { c"sub" } else { c"add" }, d, a);
        o_back_imm(value);
        ma_normalize(d, ty);
        return true;
    }
    if op == Op::Mul && (imm == 3 || imm == 5 || imm == 9) {
        // a * (2^k + 1) = a + (a << k)
        ma_rrr(c"add", d, a, a);
        BUFS[CODE].len -= 1;
        o(c", lsl #");
        oi(log2(imm - 1));
        on();
        ma_normalize(d, ty);
        return true;
    }
    if (op == Op::And || op == Op::Or || op == Op::Xor) && is_logical_imm(imm as u64) {
        ma_rr(if op == Op::And { c"and" } else if op == Op::Or { c"orr" } else { c"eor" }, d, a);
        o_back_imm(imm);
        ma_normalize(d, ty);
        return true;
    }
    if op == Op::Shl || op == Op::Shr {
        let amount = imm & (if int_bits(ty) == 64 { 63 } else { 31 });
        if amount == 0 {
            if d != a {
                ma_rr(c"mov", d, a);
            }
        } else if op == Op::Shl {
            ma_rr(c"lsl", d, a);
            o_back_imm(amount);
        } else {
            ma_rr(if is_signed(ty) { c"asr" } else { c"lsr" }, d, a);
            o_back_imm(amount);
        }
        ma_normalize(d, ty);
        return true;
    }
    false
}

// Whether `value` is encodable as an AArch64 logical immediate: a
// pattern of 2, 4, ..., 64 bits, repeated, that is a rotated run of ones.
fn is_logical_imm(value: u64) -> bool {
    if value == 0 || value == 0xffffffffffffffff {
        return false;
    }
    let mut size = 64;
    while size > 2 {
        let half = size / 2;
        let mask = ((1 as u64) << half as u64) - 1;
        if (value & mask) != ((value >> half as u64) & mask) {
            break;
        }
        size = half;
    }
    let mask: u64 = if size == 64 { 0xffffffffffffffff } else { ((1 as u64) << size as u64) - 1 };
    let element = value & mask;
    // A rotated run of ones has exactly two transitions, circularly.
    let rotated = ((element >> 1) | (element << (size - 1) as u64)) & mask;
    let transitions = element ^ rotated;
    let mut count = 0;
    let mut bits = transitions;
    while bits != 0 {
        bits &= bits - 1;
        count += 1;
    }
    count == 2
}

fn ma_float_op(op: Op, ty: i64, d: i64, a: i64, b: i64) {
    o(c"    ");
    if op == Op::Add { o(c"fadd "); }
    else if op == Op::Sub { o(c"fsub "); }
    else if op == Op::Mul { o(c"fmul "); }
    else { o(c"fdiv "); }
    ma_f(d, ty);
    o(c", ");
    ma_f(a, ty);
    o(c", ");
    ma_f(b, ty);
    on();
}

fn ma_unary(op: Op, ty: i64, d: i64, a: i64) {
    if op == Op::Neg && is_float(ty) {
        o(c"    fneg ");
        ma_f(d, ty);
        o(c", ");
        ma_f(a, ty);
        on();
        return;
    }
    if op == Op::Neg {
        ma_rr(c"neg", d, a);
    } else if op == Op::Not {
        ma_rr(c"eor", d, a);
        o_back_imm(1);
        return;
    } else {
        ma_rr(c"mvn", d, a);
    }
    ma_normalize(d, ty);
}

fn ma_compare(ty: i64, a: i64, b: i64) {
    if is_float(ty) {
        o(c"    fcmp ");
        ma_f(a, ty);
        o(c", ");
        ma_f(b, ty);
        on();
    } else {
        ma_rr(c"cmp", a, b);
    }
}

fn ma_cmp(op: Cond, ty: i64, d: i64, a: i64, b: i64) {
    ma_compare(ty, a, b);
    o(c"    cset ");
    ma_r(d);
    o(c", ");
    o(a64_condition(op, is_signed(ty), is_float(ty)));
    on();
}

fn ma_cmp_branch(op: Cond, ty: i64, a: i64, b: i64, b_is_imm: bool, imm: i64, label: i64) {
    if b_is_imm && imm == 0 && (op == Cond::Eq || op == Cond::Ne) {
        ma_branch_bool(a, op == Cond::Ne, label);
        return;
    }
    if b_is_imm {
        o(c"    cmp ");
        ma_r(a);
        o(c", #");
        oi(imm);
        on();
    } else {
        ma_rr(c"cmp", a, b);
    }
    o(c"    b.");
    o(a64_condition(op, is_signed(ty), false));
    o(c" L");
    oi(label);
    on();
}

fn ma_branch_bool(r: i64, if_nonzero: bool, label: i64) {
    o(if if_nonzero { c"    cbnz " } else { c"    cbz " });
    ma_r(r);
    end_i(c", L", label, c"");
}

fn ma_conv(from: i64, to: i64, d: i64, src: i64) {
    if is_float(from) && is_float(to) {
        o(c"    fcvt ");
        ma_f(d, to);
        o(c", ");
        ma_f(src, from);
        on();
        return;
    }
    if is_float(to) {
        o(if is_signed(from) { c"    scvtf " } else { c"    ucvtf " });
        ma_f(d, to);
        o(c", ");
        ma_r(src);
        on();
        return;
    }
    if !is_float(from) {
        if d != src {
            ma_rr(c"mov", d, src);
        }
        ma_normalize(d, to);
        return;
    }
    // Saturating float to integer (see emit_float_to_int).
    if is_signed(to) && int_bits(to) <= 32 {
        o(c"    fcvtzs ");
        ma_w(d);
        o(c", ");
        ma_f(src, from);
        on();
        o(c"    sxtw ");
        ma_r(d);
        o(c", ");
        ma_w(d);
        on();
    } else if to != TY_U64 {
        o(c"    fcvtzs ");
        ma_r(d);
        o(c", ");
        ma_f(src, from);
        on();
    } else {
        // d = value >= 2^63 ? fcvtzu(value) : fcvtzs(value)
        o(c"    fcvtzs x16, ");
        ma_f(src, from);
        on();
        o(c"    fcvtzu x17, ");
        ma_f(src, from);
        on();
        if from == TY_F32 {
            a64_load_imm(5, 0x5f000000);
            ins(c"fmov s7, w5");
        } else {
            a64_load_imm(5, 0x43e0000000000000);
            ins(c"fmov d7, x5");
        }
        o(c"    fcmp ");
        ma_f(src, from);
        o(if from == TY_F32 { c", s7\n" } else { c", d7\n" });
        o(c"    csel ");
        ma_r(d);
        o(c", x17, x16, ge\n");
    }
    ma_normalize(d, to);
}

fn ma_copy(dst: i64, src: i64, size: i64) {
    let mut offset = 0;
    while offset + 8 <= size {
        ma_copy_chunk(c"ldr x17", c"str x17", dst, src, offset);
        offset += 8;
    }
    if offset + 4 <= size {
        ma_copy_chunk(c"ldr w17", c"str w17", dst, src, offset);
        offset += 4;
    }
    if offset + 2 <= size {
        ma_copy_chunk(c"ldrh w17", c"strh w17", dst, src, offset);
        offset += 2;
    }
    if offset < size {
        ma_copy_chunk(c"ldrb w17", c"strb w17", dst, src, offset);
    }
}

fn ma_copy_chunk(load: *u8, store: *u8, dst: i64, src: i64, offset: i64) {
    o(c"    ");
    o(load);
    o(c", [");
    ma_r(src);
    end_i(c", #", offset, c"]");
    o(c"    ");
    o(store);
    o(c", [");
    ma_r(dst);
    end_i(c", #", offset, c"]");
}

// A jump through a table of 32-bit offsets (from the table) to labels:
// entry `value - low` for register r, the default above the range.
fn ma_jump_table(r: i64, low: i64, range: i64, default: i64, table: *i64) {
    ma_lea(16, r, 0 - low);
    if range - 1 < 4096 {
        ins_i(c"cmp x16, #", range - 1, c"");
    } else {
        a64_load_imm(17, (range - 1) as u64);
        ins(c"cmp x16, x17");
    }
    o(c"    b.hi L");
    oi(default);
    on();
    let at = new_label();
    o(c"    adr x17, L");
    oi(at);
    on();
    ins(c"ldrsw x16, [x17, x16, lsl #2]");
    ins(c"add x17, x17, x16");
    ins(c"br x17");
    ins(c".p2align 2");
    emit_label(at);
    for i in 0..range {
        o(c"    .long L");
        oi(table[i]);
        o(c" - L");
        oi(at);
        on();
    }
}
