# The AArch64 instructions of the intrinsics, for the compiler's assembler
# (back/enc_arm64/simd.tach): one mnemonic per line, its encoding class and
# the fixed bits of its encoding (Q, size, registers and immediates are
# the class's to add). compiler/arch/README.md gives the classes. A
# mnemonic the scalar encoder (back/enc_arm64/mod.tach) knows is not here.
#
# mnemonic | class | bits | syntax

uqsub | same3 | 0x2e202c00 | uqsub Vd.T, Vn.T, Vm.T
umaxv | across | 0x2e30a800 | umaxv <V>d, Vn.T
umov | umov | 0x0e003c00 | umov Wd, Vn.Ts[i]
tbl | tbl | 0x0e000000 | tbl Vd.T, {Vn.16b, ...}, Vm.T
ext | ext | 0x2e000000 | ext Vd.T, Vn.T, Vm.T, #index
shrn | shrn | 0x0f008400 | shrn Vd.Tb, Vn.Ta, #shift
crc32cx | crc | 0x9ac05c00 | crc32cx Wd, Wn, Xm
