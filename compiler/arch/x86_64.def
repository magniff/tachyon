_mm_cmpnle_ps | sse | (a: __m128, b: __m128) -> __m128 | intr | cmpps $6, <b>, <d> | pure tied=a | none | - | r[k] = if !(a[k] <= b[k]) { -1 } else { 0 } (r: i32 lanes) | - | lanewise compare (predicate 6): a mask, each lane all ones or 0
_mm_cmpord_ps | sse | (a: __m128, b: __m128) -> __m128 | intr | cmpps $7, <b>, <d> | pure tied=a | none | - | r[k] = if a[k] == a[k] && b[k] == b[k] { -1 } else { 0 } (r: i32 lanes) | - | lanewise compare (predicate 7): a mask, each lane all ones or 0
_mm_cmpeq_pd | sse2 | (a: __m128d, b: __m128d) -> __m128d | intr | cmppd $0, <b>, <d> | pure tied=a | none | - | r[k] = if a[k] == b[k] { -1 } else { 0 } (r: i64 lanes) | - | lanewise compare (predicate 0): a mask, each lane all ones or 0
_mm_cmplt_pd | sse2 | (a: __m128d, b: __m128d) -> __m128d | intr | cmppd $1, <b>, <d> | pure tied=a | none | - | r[k] = if a[k] < b[k] { -1 } else { 0 } (r: i64 lanes) | - | lanewise compare (predicate 1): a mask, each lane all ones or 0
_mm_cmple_pd | sse2 | (a: __m128d, b: __m128d) -> __m128d | intr | cmppd $2, <b>, <d> | pure tied=a | none | - | r[k] = if a[k] <= b[k] { -1 } else { 0 } (r: i64 lanes) | - | lanewise compare (predicate 2): a mask, each lane all ones or 0
_mm_cmpunord_pd | sse2 | (a: __m128d, b: __m128d) -> __m128d | intr | cmppd $3, <b>, <d> | pure tied=a | none | - | r[k] = if a[k] != a[k] || b[k] != b[k] { -1 } else { 0 } (r: i64 lanes) | - | lanewise compare (predicate 3): a mask, each lane all ones or 0
_mm_cmpneq_pd | sse2 | (a: __m128d, b: __m128d) -> __m128d | intr | cmppd $4, <b>, <d> | pure tied=a | none | - | r[k] = if a[k] != b[k] { -1 } else { 0 } (r: i64 lanes) | - | lanewise compare (predicate 4): a mask, each lane all ones or 0
_mm_cmpnlt_pd | sse2 | (a: __m128d, b: __m128d) -> __m128d | intr | cmppd $5, <b>, <d> | pure tied=a | none | - | r[k] = if !(a[k] < b[k]) { -1 } else { 0 } (r: i64 lanes) | - | lanewise compare (predicate 5): a mask, each lane all ones or 0
_mm_cmpnle_pd | sse2 | (a: __m128d, b: __m128d) -> __m128d | intr | cmppd $6, <b>, <d> | pure tied=a | none | - | r[k] = if !(a[k] <= b[k]) { -1 } else { 0 } (r: i64 lanes) | - | lanewise compare (predicate 6): a mask, each lane all ones or 0
_mm_cmpord_pd | sse2 | (a: __m128d, b: __m128d) -> __m128d | intr | cmppd $7, <b>, <d> | pure tied=a | none | - | r[k] = if a[k] == a[k] && b[k] == b[k] { -1 } else { 0 } (r: i64 lanes) | - | lanewise compare (predicate 7): a mask, each lane all ones or 0

# ---- Float conversions (SSE2) ----
_mm_cvtepi32_ps | sse2 | (a: __m128i) -> __m128 | intr | cvtdq2ps <a>, <d> | pure | none | - | r[k] = a[k] (a: i32 lanes) | - | each i32 lane as an f32 (rounded to nearest)
_mm_cvttps_epi32 | sse2 | (a: __m128) -> __m128i | intr | cvttps2dq <a>, <d> | pure | none | - | r = each lane truncated to i32; NaN and out of range give 0x80000000 (r: i32 lanes) | - | each lane truncated to an i32 (0x80000000 when out of range or NaN)
_mm_cvtps_epi32 | sse2 | (a: __m128) -> __m128i | intr | cvtps2dq <a>, <d> | pure | none | - | r = each lane rounded to the nearest i32, ties to even; NaN and out of range give 0x80000000 (r: i32 lanes) | - | each lane rounded to an i32 (to nearest even; 0x80000000 when out of range or NaN)
_mm_cvtepi32_pd | sse2 | (a: __m128i) -> __m128d | intr | cvtdq2pd <a>, <d> | pure | none | - | r[k] = a[k] (a: i32 lanes) | - | the low two i32 lanes as f64s
_mm_cvtps_pd | sse2 | (a: __m128) -> __m128d | intr | cvtps2pd <a>, <d> | pure | none | - | r[k] = a[k] | - | the low two f32 lanes as f64s
_mm_cvtpd_ps | sse2 | (a: __m128d) -> __m128 | intr | cvtpd2ps <a>, <d> | pure | none | - | r[k] = if k < 2 { a[k] } else { 0.0 } | - | the two f64 lanes rounded to f32s, the high two zero

# ---- SSE3 ----
_mm_hadd_ps | sse3 | (a: __m128, b: __m128) -> __m128 | intr | haddps <b>, <d> | pure tied=a | none | - | r[k] = if k < 2 { a[2 * k] + a[2 * k + 1] } else { b[2 * k - 4] + b[2 * k - 3] } | - | adjacent pairs summed: a's two sums, then b's
_mm_hadd_pd | sse3 | (a: __m128d, b: __m128d) -> __m128d | intr | haddpd <b>, <d> | pure tied=a | none | - | r[k] = if k == 0 { a[0] + a[1] } else { b[0] + b[1] } | - | a's sum, then b's
_mm_hsub_ps | sse3 | (a: __m128, b: __m128) -> __m128 | intr | hsubps <b>, <d> | pure tied=a | none | - | r[k] = if k < 2 { a[2 * k] - a[2 * k + 1] } else { b[2 * k - 4] - b[2 * k - 3] } | - | adjacent pairs subtracted: a's two, then b's
_mm_hsub_pd | sse3 | (a: __m128d, b: __m128d) -> __m128d | intr | hsubpd <b>, <d> | pure tied=a | none | - | r[k] = if k == 0 { a[0] - a[1] } else { b[0] - b[1] } | - | a's difference, then b's
_mm_addsub_ps | sse3 | (a: __m128, b: __m128) -> __m128 | intr | addsubps <b>, <d> | pure tied=a | none | - | r[k] = if k % 2 == 0 { a[k] - b[k] } else { a[k] + b[k] } | - | even lanes subtracted, odd lanes added
_mm_addsub_pd | sse3 | (a: __m128d, b: __m128d) -> __m128d | intr | addsubpd <b>, <d> | pure tied=a | none | - | r[k] = if k == 0 { a[0] - b[0] } else { a[1] + b[1] } | - | lane 0 subtracted, lane 1 added
_mm_movehdup_ps | sse3 | (a: __m128) -> __m128 | intr | movshdup <a>, <d> | pure | none | - | r[k] = a[k - k % 2 + 1] | - | the odd lanes, each twice
_mm_moveldup_ps | sse3 | (a: __m128) -> __m128 | intr | movsldup <a>, <d> | pure | none | - | r[k] = a[k - k % 2] | - | the even lanes, each twice

# ---- SSSE3 ----
_mm_shuffle_epi8 | ssse3 | (a: __m128i, b: __m128i) -> __m128i | intr | pshufb <b>, <d> | pure tied=a | none | perm.pshufb | r[k] = if b[k] & 0x80 != 0 { 0 } else { a[b[k] & 15] } (bytes) | aarch64: vqtbl1q_u8 (zeroes when idx >= 16 instead) | a table lookup: byte k is a[b[k] & 15], 0 when b[k]'s bit 7 is set
_mm_alignr_epi8 | ssse3 | (a: __m128i, b: __m128i, imm8: const 0..=255) -> __m128i | intr | palignr $<imm8>, <b>, <d> | pure tied=a | none | - | r[k] = if k + imm8 < 16 { b[k + imm8] } else if k + imm8 < 32 { a[k + imm8 - 16] } else { 0 } (bytes) | aarch64: vextq_u8(b, a, imm8) | bytes imm8.. of b then a (b the low half), zeros past them
_mm_abs_epi8 | ssse3 | (a: __m128i) -> __m128i | intr | pabsb <a>, <d> | pure | none | - | r[k] = abs(a[k]) (i8 lanes) | aarch64: vabsq_s8 | lanewise absolute value (MIN stays MIN)
_mm_sign_epi8 | ssse3 | (a: __m128i, b: __m128i) -> __m128i | intr | psignb <b>, <d> | pure tied=a | none | - | r[k] = if b[k] < 0 { -a[k] } else if b[k] == 0 { 0 } else { a[k] } (i8 lanes) | - | a negated where b < 0, zeroed where b == 0
_mm_abs_epi16 | ssse3 | (a: __m128i) -> __m128i | intr | pabsw <a>, <d> | pure | none | - | r[k] = abs(a[k]) (i16 lanes) | aarch64: vabsq_s16 | lanewise absolute value (MIN stays MIN)
_mm_sign_epi16 | ssse3 | (a: __m128i, b: __m128i) -> __m128i | intr | psignw <b>, <d> | pure tied=a | none | - | r[k] = if b[k] < 0 { -a[k] } else if b[k] == 0 { 0 } else { a[k] } (i16 lanes) | - | a negated where b < 0, zeroed where b == 0
_mm_abs_epi32 | ssse3 | (a: __m128i) -> __m128i | intr | pabsd <a>, <d> | pure | none | - | r[k] = abs(a[k]) (i32 lanes) | aarch64: vabsq_s32 | lanewise absolute value (MIN stays MIN)
_mm_sign_epi32 | ssse3 | (a: __m128i, b: __m128i) -> __m128i | intr | psignd <b>, <d> | pure tied=a | none | - | r[k] = if b[k] < 0 { -a[k] } else if b[k] == 0 { 0 } else { a[k] } (i32 lanes) | - | a negated where b < 0, zeroed where b == 0
_mm_hadd_epi16 | ssse3 | (a: __m128i, b: __m128i) -> __m128i | intr | phaddw <b>, <d> | pure tied=a | none | - | r[k] = if k < 4 { a[2 * k] + a[2 * k + 1] } else { b[2 * k - 8] + b[2 * k - 7] } (i16 lanes) | - | adjacent pairs summed (wrapping): a's, then b's
_mm_hsub_epi16 | ssse3 | (a: __m128i, b: __m128i) -> __m128i | intr | phsubw <b>, <d> | pure tied=a | none | - | r[k] = if k < 4 { a[2 * k] - a[2 * k + 1] } else { b[2 * k - 8] - b[2 * k - 7] } (i16 lanes) | - | adjacent pairs subtracted (wrapping): a's, then b's
_mm_hadd_epi32 | ssse3 | (a: __m128i, b: __m128i) -> __m128i | intr | phaddd <b>, <d> | pure tied=a | none | - | r[k] = if k < 2 { a[2 * k] + a[2 * k + 1] } else { b[2 * k - 4] + b[2 * k - 3] } (i32 lanes) | - | adjacent pairs summed (wrapping): a's, then b's
_mm_hsub_epi32 | ssse3 | (a: __m128i, b: __m128i) -> __m128i | intr | phsubd <b>, <d> | pure tied=a | none | - | r[k] = if k < 2 { a[2 * k] - a[2 * k + 1] } else { b[2 * k - 4] - b[2 * k - 3] } (i32 lanes) | - | adjacent pairs subtracted (wrapping): a's, then b's
_mm_hadds_epi16 | ssse3 | (a: __m128i, b: __m128i) -> __m128i | intr | phaddsw <b>, <d> | pure tied=a | none | - | r[k] = if k < 4 { clamp(a[2 * k] + a[2 * k + 1], -32768, 32767) } else { clamp(b[2 * k - 8] + b[2 * k - 7], -32768, 32767) } (i16 lanes) | - | adjacent pairs, saturating: a's, then b's
_mm_hsubs_epi16 | ssse3 | (a: __m128i, b: __m128i) -> __m128i | intr | phsubsw <b>, <d> | pure tied=a | none | - | r[k] = if k < 4 { clamp(a[2 * k] - a[2 * k + 1], -32768, 32767) } else { clamp(b[2 * k - 8] - b[2 * k - 7], -32768, 32767) } (i16 lanes) | - | adjacent pairs, saturating: a's, then b's
_mm_maddubs_epi16 | ssse3 | (a: __m128i, b: __m128i) -> __m128i | intr | pmaddubsw <b>, <d> | pure tied=a | none | - | r[k] = clamp(a[2 * k] * b[2 * k] + a[2 * k + 1] * b[2 * k + 1], -32768, 32767) (a: u8 lanes; b: i8 lanes; r: i16 lanes) | - | unsigned bytes of a times signed bytes of b, adjacent pairs summed, saturating
_mm_mulhrs_epi16 | ssse3 | (a: __m128i, b: __m128i) -> __m128i | intr | pmulhrsw <b>, <d> | pure commutative tied=a | none | - | r[k] = (((a[k] * b[k]) >> 14) + 1) >> 1 (i16 lanes) | - | lanewise (a * b + 0x4000) >> 15: a rounded fixed-point product

# ---- SSE4.1 blends and tests ----
_mm_blendv_epi8 | sse4.1 | (a: __m128i, b: __m128i, mask: __m128i) -> __m128i | intr | pblendvb <mask:0>, <b>, <d> | pure tied=a | none | - | r[k] = if mask[k] >= 128 { b[k] } else { a[k] } (bytes) | aarch64: vbslq_u8 | byte k is b's where mask's byte k has its top bit set, else a's
_mm_blendv_ps | sse4.1 | (a: __m128, b: __m128, mask: __m128) -> __m128 | intr | blendvps <mask:0>, <b>, <d> | pure tied=a | none | - | r[k] = if mask[k] < 0 { b[k] } else { a[k] } (a, b, r: u32 lanes; mask: i32 lanes) | - | lane k is b's where mask's lane k has its sign bit set, else a's
_mm_blendv_pd | sse4.1 | (a: __m128d, b: __m128d, mask: __m128d) -> __m128d | intr | blendvpd <mask:0>, <b>, <d> | pure tied=a | none | - | r[k] = if mask[k] < 0 { b[k] } else { a[k] } (a, b, r: u64 lanes; mask: i64 lanes) | - | lane k is b's where mask's lane k has its sign bit set, else a's
_mm_blend_epi16 | sse4.1 | (a: __m128i, b: __m128i, imm8: const 0..=255) -> __m128i | intr | pblendw $<imm8>, <b>, <d> | pure tied=a | none | - | r[k] = if (imm8 >> k) & 1 != 0 { b[k] } else { a[k] } (i16 lanes) | - | lane k is b's where imm8's bit k is set
_mm_blend_ps | sse4.1 | (a: __m128, b: __m128, imm8: const 0..=15) -> __m128 | intr | blendps $<imm8>, <b>, <d> | pure tied=a | none | - | r[k] = if (imm8 >> k) & 1 != 0 { b[k] } else { a[k] } (a, b, r: u32 lanes) | - | lane k is b's where imm8's bit k is set
_mm_blend_pd | sse4.1 | (a: __m128d, b: __m128d, imm8: const 0..=3) -> __m128d | intr | blendpd $<imm8>, <b>, <d> | pure tied=a | none | - | r[k] = if (imm8 >> k) & 1 != 0 { b[k] } else { a[k] } (a, b, r: u64 lanes) | - | lane k is b's where imm8's bit k is set
_mm_testz_si128 | sse4.1 | (a: __m128i, b: __m128i) -> i32 | intr | ptest <b>, <a>; sete <d:b>; movzbl <d:b>, <d:w> | pure | none | - | r = min over k of (if a[k] & b[k] == 0 { 1 } else { 0 }) (bytes) | - | 1 when a & b is all zeros
_mm_testc_si128 | sse4.1 | (a: __m128i, b: __m128i) -> i32 | intr | ptest <b>, <a>; setb <d:b>; movzbl <d:b>, <d:w> | pure | none | - | r = min over k of (if (a[k] ^ 255) & b[k] == 0 { 1 } else { 0 }) (bytes) | - | 1 when !a & b is all zeros
_mm_testnzc_si128 | sse4.1 | (a: __m128i, b: __m128i) -> i32 | intr | ptest <b>, <a>; seta <d:b>; movzbl <d:b>, <d:w> | pure | none | - | r = 1 when neither a & b nor !a & b is all zeros (bytes) | - | 1 when neither a & b nor !a & b is all zeros

# ---- SSE4.1 integer ----
_mm_min_epi8 | sse4.1 | (a: __m128i, b: __m128i) -> __m128i | intr | pminsb <b>, <d> | pure commutative tied=a | none | - | r[k] = min(a[k], b[k]) (i8 lanes) | - | lanewise minimum
_mm_max_epi8 | sse4.1 | (a: __m128i, b: __m128i) -> __m128i | intr | pmaxsb <b>, <d> | pure commutative tied=a | none | - | r[k] = max(a[k], b[k]) (i8 lanes) | - | lanewise maximum
_mm_min_epu16 | sse4.1 | (a: __m128i, b: __m128i) -> __m128i | intr | pminuw <b>, <d> | pure commutative tied=a | none | - | r[k] = min(a[k], b[k]) (u16 lanes) | - | lanewise minimum
_mm_max_epu16 | sse4.1 | (a: __m128i, b: __m128i) -> __m128i | intr | pmaxuw <b>, <d> | pure commutative tied=a | none | - | r[k] = max(a[k], b[k]) (u16 lanes) | - | lanewise maximum
_mm_min_epi32 | sse4.1 | (a: __m128i, b: __m128i) -> __m128i | intr | pminsd <b>, <d> | pure commutative tied=a | none | - | r[k] = min(a[k], b[k]) (i32 lanes) | - | lanewise minimum
_mm_max_epi32 | sse4.1 | (a: __m128i, b: __m128i) -> __m128i | intr | pmaxsd <b>, <d> | pure commutative tied=a | none | - | r[k] = max(a[k], b[k]) (i32 lanes) | - | lanewise maximum
_mm_min_epu32 | sse4.1 | (a: __m128i, b: __m128i) -> __m128i | intr | pminud <b>, <d> | pure commutative tied=a | none | - | r[k] = min(a[k], b[k]) (u32 lanes) | - | lanewise minimum
_mm_max_epu32 | sse4.1 | (a: __m128i, b: __m128i) -> __m128i | intr | pmaxud <b>, <d> | pure commutative tied=a | none | - | r[k] = max(a[k], b[k]) (u32 lanes) | - | lanewise maximum
_mm_mullo_epi32 | sse4.1 | (a: __m128i, b: __m128i) -> __m128i | intr | pmulld <b>, <d> | pure commutative tied=a | none | - | r[k] = a[k] * b[k] (i32 lanes) | aarch64: vmulq_s32 | lanewise a * b, the low 32 bits
_mm_mul_epi32 | sse4.1 | (a: __m128i, b: __m128i) -> __m128i | intr | pmuldq <b>, <d> | pure commutative tied=a | none | - | r[k] = a[2 * k] * b[2 * k] (a, b: i32 lanes; r: i64 lanes) | - | the 64-bit products of the even signed 32-bit lanes
_mm_cmpeq_epi64 | sse4.1 | (a: __m128i, b: __m128i) -> __m128i | intr | pcmpeqq <b>, <d> | pure commutative tied=a | none | - | r[k] = if a[k] == b[k] { -1 } else { 0 } (i64 lanes) | aarch64: vceqq_u64 | lanewise a == b: a mask
_mm_packus_epi32 | sse4.1 | (a: __m128i, b: __m128i) -> __m128i | intr | packusdw <b>, <d> | pure tied=a | none | - | r[k] = if k < 4 { clamp(a[k], 0, 65535) } else { clamp(b[k - 4], 0, 65535) } (a, b: i32 lanes; r: u16 lanes) | - | a's then b's lanes narrowed to 16 bits, saturating to 0..65535
_mm_minpos_epu16 | sse4.1 | (a: __m128i) -> __m128i | intr | phminposuw <a>, <d> | pure | none | - | r = the least lane in lane 0, its index in lane 1, zeros above (a, r: u16 lanes) | - | the least lane and its (first) index

# ---- SSE4.1 lanes ----
_mm_extract_epi8 | sse4.1 | (a: __m128i, imm8: const 0..=15) -> i32 | intr | pextrb $<imm8>, <a>, <d:w> | pure | none | - | r = a[imm8] (u8 lanes) | - | lane imm8, zero-extended
_mm_extract_epi32 | sse4.1 | (a: __m128i, imm8: const 0..=3) -> i32 | intr | pextrd $<imm8>, <a>, <d:w> | pure | none | - | r = a[imm8] (i32 lanes) | - | lane imm8
_mm_extract_epi64 | sse4.1 | (a: __m128i, imm8: const 0..=1) -> i64 | intr | pextrq $<imm8>, <a>, <d> | pure | none | - | r = a[imm8] (i64 lanes) | - | lane imm8
_mm_insert_epi8 | sse4.1 | (a: __m128i, i: i32, imm8: const 0..=15) -> __m128i | intr | pinsrb $<imm8>, <i:w>, <d> | pure tied=a | none | - | r[k] = if k == imm8 { i } else { a[k] } (i8 lanes) | - | a with lane imm8 = i
_mm_insert_epi32 | sse4.1 | (a: __m128i, i: i32, imm8: const 0..=3) -> __m128i | intr | pinsrd $<imm8>, <i:w>, <d> | pure tied=a | none | - | r[k] = if k == imm8 { i } else { a[k] } (i32 lanes) | - | a with lane imm8 = i
_mm_insert_epi64 | sse4.1 | (a: __m128i, i: i64, imm8: const 0..=1) -> __m128i | intr | pinsrq $<imm8>, <i>, <d> | pure tied=a | none | - | r[k] = if k == imm8 { i } else { a[k] } (i64 lanes) | - | a with lane imm8 = i
_mm_extract_ps | sse4.1 | (a: __m128, imm8: const 0..=3) -> i32 | intr | extractps $<imm8>, <a>, <d:w> | pure | none | - | r = a[imm8] (a: i32 lanes) | - | lane imm8's bits

# ---- SSE4.1 widening ----
_mm_cvtepi8_epi16 | sse4.1 | (a: __m128i) -> __m128i | intr | pmovsxbw <a>, <d> | pure | none | - | r[k] = a[k] (a: i8 lanes; r: i16 lanes) | - | the low lanes sign-extended to 16 bits
_mm_cvtepu8_epi16 | sse4.1 | (a: __m128i) -> __m128i | intr | pmovzxbw <a>, <d> | pure | none | - | r[k] = a[k] (a: u8 lanes; r: i16 lanes) | - | the low lanes zero-extended to 16 bits
_mm_cvtepi8_epi32 | sse4.1 | (a: __m128i) -> __m128i | intr | pmovsxbd <a>, <d> | pure | none | - | r[k] = a[k] (a: i8 lanes; r: i32 lanes) | - | the low lanes sign-extended to 32 bits
_mm_cvtepu8_epi32 | sse4.1 | (a: __m128i) -> __m128i | intr | pmovzxbd <a>, <d> | pure | none | - | r[k] = a[k] (a: u8 lanes; r: i32 lanes) | - | the low lanes zero-extended to 32 bits
_mm_cvtepi8_epi64 | sse4.1 | (a: __m128i) -> __m128i | intr | pmovsxbq <a>, <d> | pure | none | - | r[k] = a[k] (a: i8 lanes; r: i64 lanes) | - | the low lanes sign-extended to 64 bits
_mm_cvtepu8_epi64 | sse4.1 | (a: __m128i) -> __m128i | intr | pmovzxbq <a>, <d> | pure | none | - | r[k] = a[k] (a: u8 lanes; r: i64 lanes) | - | the low lanes zero-extended to 64 bits
_mm_cvtepi16_epi32 | sse4.1 | (a: __m128i) -> __m128i | intr | pmovsxwd <a>, <d> | pure | none | - | r[k] = a[k] (a: i16 lanes; r: i32 lanes) | - | the low lanes sign-extended to 32 bits
_mm_cvtepu16_epi32 | sse4.1 | (a: __m128i) -> __m128i | intr | pmovzxwd <a>, <d> | pure | none | - | r[k] = a[k] (a: u16 lanes; r: i32 lanes) | - | the low lanes zero-extended to 32 bits
_mm_cvtepi16_epi64 | sse4.1 | (a: __m128i) -> __m128i | intr | pmovsxwq <a>, <d> | pure | none | - | r[k] = a[k] (a: i16 lanes; r: i64 lanes) | - | the low lanes sign-extended to 64 bits
_mm_cvtepu16_epi64 | sse4.1 | (a: __m128i) -> __m128i | intr | pmovzxwq <a>, <d> | pure | none | - | r[k] = a[k] (a: u16 lanes; r: i64 lanes) | - | the low lanes zero-extended to 64 bits
_mm_cvtepi32_epi64 | sse4.1 | (a: __m128i) -> __m128i | intr | pmovsxdq <a>, <d> | pure | none | - | r[k] = a[k] (a: i32 lanes; r: i64 lanes) | - | the low lanes sign-extended to 64 bits
_mm_cvtepu32_epi64 | sse4.1 | (a: __m128i) -> __m128i | intr | pmovzxdq <a>, <d> | pure | none | - | r[k] = a[k] (a: u32 lanes; r: i64 lanes) | - | the low lanes zero-extended to 64 bits

# ---- SSE4.1 rounding ----
_mm_round_ps | sse4.1 | (a: __m128, rounding: const 0..=15) -> __m128 | intr | roundps $<rounding>, <a>, <d> | pure | none | - | r = each lane rounded to an integer by `rounding` (0 nearest even, 1 down, 2 up, 3 toward zero; 4 and up: the current mode, nearest) | - | each lane rounded to an integral value by the mode in rounding
_mm_floor_ps | sse4.1 | (a: __m128) -> __m128 | intr | roundps $9, <a>, <d> | pure | none | - | r = each lane rounded down to an integer | - | each lane rounded down
_mm_ceil_ps | sse4.1 | (a: __m128) -> __m128 | intr | roundps $10, <a>, <d> | pure | none | - | r = each lane rounded up to an integer | - | each lane rounded up
_mm_round_pd | sse4.1 | (a: __m128d, rounding: const 0..=15) -> __m128d | intr | roundpd $<rounding>, <a>, <d> | pure | none | - | r = each lane rounded to an integer by `rounding` (0 nearest even, 1 down, 2 up, 3 toward zero; 4 and up: the current mode, nearest) | - | each lane rounded to an integral value by the mode in rounding
_mm_floor_pd | sse4.1 | (a: __m128d) -> __m128d | intr | roundpd $9, <a>, <d> | pure | none | - | r = each lane rounded down to an integer | - | each lane rounded down
_mm_ceil_pd | sse4.1 | (a: __m128d) -> __m128d | intr | roundpd $10, <a>, <d> | pure | none | - | r = each lane rounded up to an integer | - | each lane rounded up

# ---- SSE4.2 ----
_mm_cmpgt_epi64 | sse4.2 | (a: __m128i, b: __m128i) -> __m128i | intr | pcmpgtq <b>, <d> | pure tied=a | none | - | r[k] = if a[k] > b[k] { -1 } else { 0 } (i64 lanes) | aarch64: vcgtq_s64 | lanewise a > b (signed): a mask

# ---- CRC-32C ----
_mm_crc32_u8 | sse4.2 | (crc: u32, v: u8) -> u32 | intr | crc32b <v:b>, <d:w> | pure tied=crc | none | crc.c8 | r = CRC-32C of crc and v's 1 byte | aarch64: __crc32cb | one step of CRC-32C over 1 byte
_mm_crc32_u16 | sse4.2 | (crc: u32, v: u16) -> u32 | intr | crc32w <v:h>, <d:w> | pure tied=crc | none | crc.c16 | r = CRC-32C of crc and v's 2 bytes | aarch64: __crc32ch | one step of CRC-32C over 2 bytes
_mm_crc32_u32 | sse4.2 | (crc: u32, v: u32) -> u32 | intr | crc32l <v:w>, <d:w> | pure tied=crc | none | crc.c32 | r = CRC-32C of crc and v's 4 bytes | aarch64: __crc32cw | one step of CRC-32C over 4 bytes
_mm_crc32_u64 | sse4.2 | (crc: u64, v: u64) -> u64 | intr | crc32q <v>, <d> | pure tied=crc | none | crc.c64 | r = CRC-32C of crc's low 32 bits and v's 8 bytes | aarch64: __crc32cd | one step of CRC-32C over 8 bytes

# ---- Bit counts (POPCNT, LZCNT, BMI1, BMI2) ----
_popcnt32 | popcnt | (a: i32) -> i32 | intr | popcntl <a:w>, <d:w> | pure | none | bits.ones | r = the number of 1 bits of a | std::arch::count_ones | the number of 1 bits
_popcnt64 | popcnt | (a: i64) -> i32 | intr | popcntq <a>, <d> | pure | none | bits.ones | r = the number of 1 bits of a | std::arch::count_ones | the number of 1 bits
_lzcnt_u32 | lzcnt | (a: u32) -> u32 | intr | lzcntl <a:w>, <d:w> | pure | none | bits.leading | r = the number of leading 0 bits of a (32 for 0) | - | leading zero bits (32 for 0)
_lzcnt_u64 | lzcnt | (a: u64) -> u64 | intr | lzcntq <a>, <d> | pure | none | bits.leading | r = the number of leading 0 bits of a (64 for 0) | - | leading zero bits (64 for 0)
_tzcnt_u32 | bmi1 | (a: u32) -> u32 | intr | tzcntl <a:w>, <d:w> | pure | none | bits.trailing | r = the number of trailing 0 bits of a (32 for 0) | - | trailing zero bits (32 for 0)
_tzcnt_u64 | bmi1 | (a: u64) -> u64 | intr | tzcntq <a>, <d> | pure | none | bits.trailing | r = the number of trailing 0 bits of a (64 for 0) | - | trailing zero bits (64 for 0)
_andn_u32 | bmi1 | (a: u32, b: u32) -> u32 | intr | andnl <b:w>, <a:w>, <d:w> | pure | none | - | r = (a ^ 0xffffffff) & b | - | !a & b
_blsr_u32 | bmi1 | (a: u32) -> u32 | intr | blsrl <a:w>, <d:w> | pure | none | - | r = a & (a - 1) | - | a without its lowest set bit
_blsi_u32 | bmi1 | (a: u32) -> u32 | intr | blsil <a:w>, <d:w> | pure | none | - | r = a & (0 - a) | - | a's lowest set bit alone
_blsmsk_u32 | bmi1 | (a: u32) -> u32 | intr | blsmskl <a:w>, <d:w> | pure | none | - | r = a ^ (a - 1) | - | the bits up to a's lowest set bit
_bextr2_u32 | bmi1 | (a: u32, control: u32) -> u32 | intr | bextrl <control:w>, <a:w>, <d:w> | pure | none | - | r = the control >> 8 & 255 bits of a from bit control & 255, zero-extended | - | a bit field of a: start in control's bits 0-7, length in 8-15
_bzhi_u32 | bmi2 | (a: u32, index: u32) -> u32 | intr | bzhil <index:w>, <a:w>, <d:w> | pure | none | - | r = a with the bits from index & 255 up cleared | - | a with the bits from index up cleared
_pdep_u32 | bmi2 | (a: u32, mask: u32) -> u32 | intr | pdepl <mask:w>, <a:w>, <d:w> | pure | none | - | r = a's low bits deposited at mask's set bits, in order | - | parallel bit deposit
_pext_u32 | bmi2 | (a: u32, mask: u32) -> u32 | intr | pextl <mask:w>, <a:w>, <d:w> | pure | none | - | r = a's bits at mask's set bits, gathered into the low bits in order | - | parallel bit extract
_andn_u64 | bmi1 | (a: u64, b: u64) -> u64 | intr | andnq <b>, <a>, <d> | pure | none | - | r = (a ^ 0xffffffffffffffffu64) & b | - | !a & b
_blsr_u64 | bmi1 | (a: u64) -> u64 | intr | blsrq <a>, <d> | pure | none | - | r = a & (a - 1) | - | a without its lowest set bit
_blsi_u64 | bmi1 | (a: u64) -> u64 | intr | blsiq <a>, <d> | pure | none | - | r = a & (0 - a) | - | a's lowest set bit alone
_blsmsk_u64 | bmi1 | (a: u64) -> u64 | intr | blsmskq <a>, <d> | pure | none | - | r = a ^ (a - 1) | - | the bits up to a's lowest set bit
_bextr2_u64 | bmi1 | (a: u64, control: u64) -> u64 | intr | bextrq <control>, <a>, <d> | pure | none | - | r = the control >> 8 & 255 bits of a from bit control & 255, zero-extended | - | a bit field of a: start in control's bits 0-7, length in 8-15
_bzhi_u64 | bmi2 | (a: u64, index: u64) -> u64 | intr | bzhiq <index>, <a>, <d> | pure | none | - | r = a with the bits from index & 255 up cleared | - | a with the bits from index up cleared
_pdep_u64 | bmi2 | (a: u64, mask: u64) -> u64 | intr | pdepq <mask>, <a>, <d> | pure | none | - | r = a's low bits deposited at mask's set bits, in order | - | parallel bit deposit
_pext_u64 | bmi2 | (a: u64, mask: u64) -> u64 | intr | pextq <mask>, <a>, <d> | pure | none | - | r = a's bits at mask's set bits, gathered into the low bits in order | - | parallel bit extract

# ---- Carry-less multiply (PCLMULQDQ) ----
_mm_clmulepi64_si128 | pclmulqdq | (a: __m128i, b: __m128i, imm8: const 0..=255) -> __m128i | intr | pclmulqdq $<imm8>, <b>, <d> | pure tied=a | none | - | r = the carry-less product of a's lane imm8 & 1 and b's lane (imm8 >> 4) & 1 (a, b, r: u64 lanes) | aarch64: vmull_p64 | the 128-bit carry-less product of a 64-bit lane of each

# ---- AES ----
_mm_aesenc_si128 | aes | (a: __m128i, round_key: __m128i) -> __m128i | intr | aesenc <round_key>, <d> | pure tied=a | none | - | r = one AES encryption round: ShiftRows, SubBytes, MixColumns, then ^ round_key | aarch64: vaeseq_u8 + vaesmcq_u8 (the key added first) | one AES encryption round: ShiftRows, SubBytes, MixColumns, then ^ round_key
_mm_aesenclast_si128 | aes | (a: __m128i, round_key: __m128i) -> __m128i | intr | aesenclast <round_key>, <d> | pure tied=a | none | - | r = the last AES encryption round: ShiftRows, SubBytes, then ^ round_key | aarch64: vaeseq_u8 + vaesmcq_u8 (the key added first) | the last AES encryption round: ShiftRows, SubBytes, then ^ round_key
_mm_aesdec_si128 | aes | (a: __m128i, round_key: __m128i) -> __m128i | intr | aesdec <round_key>, <d> | pure tied=a | none | - | r = one AES decryption round: InvShiftRows, InvSubBytes, InvMixColumns, then ^ round_key | aarch64: vaeseq_u8 + vaesmcq_u8 (the key added first) | one AES decryption round: InvShiftRows, InvSubBytes, InvMixColumns, then ^ round_key
_mm_aesdeclast_si128 | aes | (a: __m128i, round_key: __m128i) -> __m128i | intr | aesdeclast <round_key>, <d> | pure tied=a | none | - | r = the last AES decryption round: InvShiftRows, InvSubBytes, then ^ round_key | aarch64: vaeseq_u8 + vaesmcq_u8 (the key added first) | the last AES decryption round: InvShiftRows, InvSubBytes, then ^ round_key
_mm_aesimc_si128 | aes | (a: __m128i) -> __m128i | intr | aesimc <a>, <d> | pure | none | - | r = InvMixColumns of a | aarch64: vaesimcq_u8 | InvMixColumns (decryption keys from encryption ones)
_mm_aeskeygenassist_si128 | aes | (a: __m128i, imm8: const 0..=255) -> __m128i | intr | aeskeygenassist $<imm8>, <a>, <d> | pure | none | - | r = SubWord of a's words 1 and 3, each also rotated and ^ imm8 (the key expansion's step) | - | the AES key expansion's SubWord/RotWord step with round constant imm8

# ---- SHA ----
_mm_sha1rnds4_epu32 | sha | (a: __m128i, b: __m128i, func: const 0..=3) -> __m128i | intr | sha1rnds4 $<func>, <b>, <d> | pure tied=a | none | - | r = four SHA-1 rounds on state a (A..D) with b's message words plus E, function func (a, b, r: u32 lanes) | aarch64: vsha1cq_u32 / vsha1pq_u32 / vsha1mq_u32 | four SHA-1 rounds
_mm_sha1nexte_epu32 | sha | (a: __m128i, b: __m128i) -> __m128i | intr | sha1nexte <b>, <d> | pure tied=a | none | - | r = b with rol(a's lane 3, 30) added to its lane 3 (a, b, r: u32 lanes) | - | the next E for SHA-1's rounds
_mm_sha1msg1_epu32 | sha | (a: __m128i, b: __m128i) -> __m128i | intr | sha1msg1 <b>, <d> | pure tied=a | none | - | r = SHA-1's first message schedule step on a and b (a, b, r: u32 lanes) | aarch64: vsha1su0q_u32 | SHA-1 message schedule, step 1
_mm_sha1msg2_epu32 | sha | (a: __m128i, b: __m128i) -> __m128i | intr | sha1msg2 <b>, <d> | pure tied=a | none | - | r = SHA-1's second message schedule step on a and b (a, b, r: u32 lanes) | aarch64: vsha1su1q_u32 | SHA-1 message schedule, step 2
_mm_sha256rnds2_epu32 | sha | (a: __m128i, b: __m128i, wk: __m128i) -> __m128i | intr | sha256rnds2 <wk:0>, <b>, <d> | pure tied=a | none | - | r = two SHA-256 rounds: a the state's C D G H, b its A B E F, wk's lanes 0 and 1 the message words plus constants; the new A B E F (a, b, wk, r: u32 lanes) | aarch64: vsha256hq_u32 + vsha256h2q_u32 | two SHA-256 rounds
_mm_sha256msg1_epu32 | sha | (a: __m128i, b: __m128i) -> __m128i | intr | sha256msg1 <b>, <d> | pure tied=a | none | - | r = SHA-256's first message schedule step on a and b (a, b, r: u32 lanes) | aarch64: vsha256su0q_u32 | SHA-256 message schedule, step 1
_mm_sha256msg2_epu32 | sha | (a: __m128i, b: __m128i) -> __m128i | intr | sha256msg2 <b>, <d> | pure tied=a | none | - | r = SHA-256's second message schedule step on a and b (a, b, r: u32 lanes) | aarch64: vsha256su1q_u32 | SHA-256 message schedule, step 2

# ---- AVX float ----
_mm256_add_ps | avx | (a: __m256, b: __m256) -> __m256 | intr | vaddps <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] + b[k] | - | lanewise a + b
_mm256_sub_ps | avx | (a: __m256, b: __m256) -> __m256 | intr | vsubps <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = a[k] - b[k] | - | lanewise a - b
_mm256_mul_ps | avx | (a: __m256, b: __m256) -> __m256 | intr | vmulps <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] * b[k] | - | lanewise a * b
_mm256_div_ps | avx | (a: __m256, b: __m256) -> __m256 | intr | vdivps <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = a[k] / b[k] | - | lanewise a / b
_mm256_min_ps | avx | (a: __m256, b: __m256) -> __m256 | intr | vminps <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if a[k] < b[k] { a[k] } else { b[k] } | - | lanewise minimum: b when either is NaN or both are zeros
_mm256_max_ps | avx | (a: __m256, b: __m256) -> __m256 | intr | vmaxps <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if a[k] > b[k] { a[k] } else { b[k] } | - | lanewise maximum: b when either is NaN or both are zeros
_mm256_and_ps | avx | (a: __m256, b: __m256) -> __m256 | intr | vandps <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] & b[k] (a, b, r: bytes) | - | bitwise a & b
_mm256_or_ps | avx | (a: __m256, b: __m256) -> __m256 | intr | vorps <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k]|b[k] (a, b, r: bytes) | - | bitwise a|b
_mm256_xor_ps | avx | (a: __m256, b: __m256) -> __m256 | intr | vxorps <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] ^ b[k] (a, b, r: bytes) | - | bitwise a ^ b
_mm256_andnot_ps | avx | (a: __m256, b: __m256) -> __m256 | intr | vandnps <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = (a[k] ^ 255) & b[k] (a, b, r: bytes) | - | bitwise !a & b
_mm256_sqrt_ps | avx | (a: __m256) -> __m256 | intr | vsqrtps <a:y>, <d:y> | pure | none | - | r = each lane's square root (correctly rounded) | - | lanewise square root
_mm256_cmp_ps | avx | (a: __m256, b: __m256, imm8: const 0..=31) -> __m256 | intr | vcmpps $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r = each lane compared by predicate imm8 (Intel's _CMP_*): a mask, each lane all ones or 0 (r: i32 lanes) | - | lanewise compare by predicate imm8 (_CMP_EQ_OQ = 0 ... _CMP_TRUE_US = 31)
_mm256_blendv_ps | avx | (a: __m256, b: __m256, mask: __m256) -> __m256 | intr | vblendvps <mask:y>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if mask[k] < 0 { b[k] } else { a[k] } (a, b, r: u32 lanes; mask: i32 lanes) | - | lane k is b's where mask's lane k has its sign bit set, else a's
_mm256_movemask_ps | avx | (a: __m256) -> i32 | intr | vmovmskps <a:y>, <d:w> | pure | none | - | r = sum over k of (if a[k] < 0 { 1 << k } else { 0 }) (a: i32 lanes) | - | the lanes' sign bits
_mm256_blend_ps | avx | (a: __m256, b: __m256, imm8: const 0..=255) -> __m256 | intr | vblendps $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if (imm8 >> k) & 1 != 0 { b[k] } else { a[k] } (a, b, r: u32 lanes) | - | lane k is b's where imm8's bit k is set
_mm256_add_pd | avx | (a: __m256d, b: __m256d) -> __m256d | intr | vaddpd <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] + b[k] | - | lanewise a + b
_mm256_sub_pd | avx | (a: __m256d, b: __m256d) -> __m256d | intr | vsubpd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = a[k] - b[k] | - | lanewise a - b
_mm256_mul_pd | avx | (a: __m256d, b: __m256d) -> __m256d | intr | vmulpd <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] * b[k] | - | lanewise a * b
_mm256_div_pd | avx | (a: __m256d, b: __m256d) -> __m256d | intr | vdivpd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = a[k] / b[k] | - | lanewise a / b
_mm256_min_pd | avx | (a: __m256d, b: __m256d) -> __m256d | intr | vminpd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if a[k] < b[k] { a[k] } else { b[k] } | - | lanewise minimum: b when either is NaN or both are zeros
_mm256_max_pd | avx | (a: __m256d, b: __m256d) -> __m256d | intr | vmaxpd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if a[k] > b[k] { a[k] } else { b[k] } | - | lanewise maximum: b when either is NaN or both are zeros
_mm256_and_pd | avx | (a: __m256d, b: __m256d) -> __m256d | intr | vandpd <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] & b[k] (a, b, r: bytes) | - | bitwise a & b
_mm256_or_pd | avx | (a: __m256d, b: __m256d) -> __m256d | intr | vorpd <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k]|b[k] (a, b, r: bytes) | - | bitwise a|b
_mm256_xor_pd | avx | (a: __m256d, b: __m256d) -> __m256d | intr | vxorpd <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] ^ b[k] (a, b, r: bytes) | - | bitwise a ^ b
_mm256_andnot_pd | avx | (a: __m256d, b: __m256d) -> __m256d | intr | vandnpd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = (a[k] ^ 255) & b[k] (a, b, r: bytes) | - | bitwise !a & b
_mm256_sqrt_pd | avx | (a: __m256d) -> __m256d | intr | vsqrtpd <a:y>, <d:y> | pure | none | - | r = each lane's square root (correctly rounded) | - | lanewise square root
_mm256_cmp_pd | avx | (a: __m256d, b: __m256d, imm8: const 0..=31) -> __m256d | intr | vcmppd $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r = each lane compared by predicate imm8 (Intel's _CMP_*): a mask, each lane all ones or 0 (r: i64 lanes) | - | lanewise compare by predicate imm8 (_CMP_EQ_OQ = 0 ... _CMP_TRUE_US = 31)
_mm256_blendv_pd | avx | (a: __m256d, b: __m256d, mask: __m256d) -> __m256d | intr | vblendvpd <mask:y>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if mask[k] < 0 { b[k] } else { a[k] } (a, b, r: u64 lanes; mask: i64 lanes) | - | lane k is b's where mask's lane k has its sign bit set, else a's
_mm256_movemask_pd | avx | (a: __m256d) -> i32 | intr | vmovmskpd <a:y>, <d:w> | pure | none | - | r = sum over k of (if a[k] < 0 { 1 << k } else { 0 }) (a: i64 lanes) | - | the lanes' sign bits
_mm256_blend_pd | avx | (a: __m256d, b: __m256d, imm8: const 0..=15) -> __m256d | intr | vblendpd $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if (imm8 >> k) & 1 != 0 { b[k] } else { a[k] } (a, b, r: u64 lanes) | - | lane k is b's where imm8's bit k is set

# ---- AVX lanes and tests ----
_mm256_extractf128_si256 | avx | (a: __m256i, imm8: const 0..=1) -> __m128i | intr | vextractf128 $<imm8>, <a:y>, <d> | pure | none | - | r[k] = a[16 * imm8 + k] (a, r: bytes) | - | the 128-bit half imm8 (0 low, 1 high)
_mm256_insertf128_si256 | avx | (a: __m256i, b: __m128i, imm8: const 0..=1) -> __m256i | intr | vinsertf128 $<imm8>, <b>, <a:y>, <d:y> | pure | none | - | r[k] = if k / 16 == imm8 { b[k % 16] } else { a[k] } (a, b, r: bytes) | - | a with its 128-bit half imm8 replaced by b
_mm256_permute2f128_si256 | avx | (a: __m256i, b: __m256i, imm8: const 0..=255) -> __m256i | intr | vperm2f128 $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if (imm8 >> (4 * (k / 16))) & 8 != 0 { 0 } else if (imm8 >> (4 * (k / 16))) & 2 == 0 { a[16 * ((imm8 >> (4 * (k / 16))) & 1) + k % 16] } else { b[16 * ((imm8 >> (4 * (k / 16))) & 1) + k % 16] } (a, b, r: bytes) | - | each half from a or b by imm8 (bits 0-1 low, 4-5 high; bits 3, 7: zero)
_mm256_extractf128_ps | avx | (a: __m256, imm8: const 0..=1) -> __m128 | intr | vextractf128 $<imm8>, <a:y>, <d> | pure | none | - | r[k] = a[16 * imm8 + k] (a, r: bytes) | - | the 128-bit half imm8 (0 low, 1 high)
_mm256_insertf128_ps | avx | (a: __m256, b: __m128, imm8: const 0..=1) -> __m256 | intr | vinsertf128 $<imm8>, <b>, <a:y>, <d:y> | pure | none | - | r[k] = if k / 16 == imm8 { b[k % 16] } else { a[k] } (a, b, r: bytes) | - | a with its 128-bit half imm8 replaced by b
_mm256_permute2f128_ps | avx | (a: __m256, b: __m256, imm8: const 0..=255) -> __m256 | intr | vperm2f128 $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if (imm8 >> (4 * (k / 16))) & 8 != 0 { 0 } else if (imm8 >> (4 * (k / 16))) & 2 == 0 { a[16 * ((imm8 >> (4 * (k / 16))) & 1) + k % 16] } else { b[16 * ((imm8 >> (4 * (k / 16))) & 1) + k % 16] } (a, b, r: bytes) | - | each half from a or b by imm8 (bits 0-1 low, 4-5 high; bits 3, 7: zero)
_mm256_extractf128_pd | avx | (a: __m256d, imm8: const 0..=1) -> __m128d | intr | vextractf128 $<imm8>, <a:y>, <d> | pure | none | - | r[k] = a[16 * imm8 + k] (a, r: bytes) | - | the 128-bit half imm8 (0 low, 1 high)
_mm256_insertf128_pd | avx | (a: __m256d, b: __m128d, imm8: const 0..=1) -> __m256d | intr | vinsertf128 $<imm8>, <b>, <a:y>, <d:y> | pure | none | - | r[k] = if k / 16 == imm8 { b[k % 16] } else { a[k] } (a, b, r: bytes) | - | a with its 128-bit half imm8 replaced by b
_mm256_permute2f128_pd | avx | (a: __m256d, b: __m256d, imm8: const 0..=255) -> __m256d | intr | vperm2f128 $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if (imm8 >> (4 * (k / 16))) & 8 != 0 { 0 } else if (imm8 >> (4 * (k / 16))) & 2 == 0 { a[16 * ((imm8 >> (4 * (k / 16))) & 1) + k % 16] } else { b[16 * ((imm8 >> (4 * (k / 16))) & 1) + k % 16] } (a, b, r: bytes) | - | each half from a or b by imm8 (bits 0-1 low, 4-5 high; bits 3, 7: zero)
_mm256_testz_si256 | avx | (a: __m256i, b: __m256i) -> i32 | intr | vptest <b:y>, <a:y>; sete <d:b>; movzbl <d:b>, <d:w> | pure | none | - | r = min over k of (if a[k] & b[k] == 0 { 1 } else { 0 }) (bytes) | - | 1 when a & b is all zeros
_mm256_testc_si256 | avx | (a: __m256i, b: __m256i) -> i32 | intr | vptest <b:y>, <a:y>; setb <d:b>; movzbl <d:b>, <d:w> | pure | none | - | r = min over k of (if (a[k] ^ 255) & b[k] == 0 { 1 } else { 0 }) (bytes) | - | 1 when !a & b is all zeros

# ---- AVX2 integer arithmetic ----
_mm256_add_epi8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpaddb <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] + b[k] (i8 lanes) | - | lanewise a + b, wrapping
_mm256_sub_epi8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsubb <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = a[k] - b[k] (i8 lanes) | - | lanewise a - b, wrapping
_mm256_add_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpaddw <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] + b[k] (i16 lanes) | - | lanewise a + b, wrapping
_mm256_sub_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsubw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = a[k] - b[k] (i16 lanes) | - | lanewise a - b, wrapping
_mm256_add_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpaddd <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] + b[k] (i32 lanes) | - | lanewise a + b, wrapping
_mm256_sub_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsubd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = a[k] - b[k] (i32 lanes) | - | lanewise a - b, wrapping
_mm256_add_epi64 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpaddq <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] + b[k] (i64 lanes) | - | lanewise a + b, wrapping
_mm256_sub_epi64 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsubq <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = a[k] - b[k] (i64 lanes) | - | lanewise a - b, wrapping
_mm256_adds_epi8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpaddsb <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = clamp(a[k] + b[k], -128, 127) (i8 lanes) | - | lanewise a + b, saturating
_mm256_subs_epi8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsubsb <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = clamp(a[k] - b[k], -128, 127) (i8 lanes) | - | lanewise a - b, saturating
_mm256_adds_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpaddsw <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = clamp(a[k] + b[k], -32768, 32767) (i16 lanes) | - | lanewise a + b, saturating
_mm256_subs_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsubsw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = clamp(a[k] - b[k], -32768, 32767) (i16 lanes) | - | lanewise a - b, saturating
_mm256_adds_epu8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpaddusb <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = clamp(a[k] + b[k], 0, 255) (u8 lanes) | - | lanewise a + b, saturating
_mm256_subs_epu8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsubusb <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = clamp(a[k] - b[k], 0, 255) (u8 lanes) | - | lanewise a - b, saturating
_mm256_adds_epu16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpaddusw <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = clamp(a[k] + b[k], 0, 65535) (u16 lanes) | - | lanewise a + b, saturating
_mm256_subs_epu16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsubusw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = clamp(a[k] - b[k], 0, 65535) (u16 lanes) | - | lanewise a - b, saturating
_mm256_mullo_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpmullw <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] * b[k] (i16 lanes) | - | lanewise a * b, the low 16 bits
_mm256_mullo_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpmulld <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] * b[k] (i32 lanes) | - | lanewise a * b, the low 32 bits
_mm256_mulhi_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpmulhw <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = (a[k] * b[k]) >> 16 (i16 lanes) | - | the high 16 bits of the signed products
_mm256_mulhi_epu16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpmulhuw <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = (a[k] * b[k]) >> 16 (u16 lanes) | - | the high 16 bits of the unsigned products
_mm256_mul_epu32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpmuludq <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = (a[2 * k] as u64) * (b[2 * k] as u64) (a, b: u32 lanes; r: u64 lanes) | - | the 64-bit products of the even unsigned 32-bit lanes
_mm256_mul_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpmuldq <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[2 * k] * b[2 * k] (a, b: i32 lanes; r: i64 lanes) | - | the 64-bit products of the even signed 32-bit lanes
_mm256_madd_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpmaddwd <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[2 * k] * b[2 * k] + a[2 * k + 1] * b[2 * k + 1] (a, b: i16 lanes; r: i32 lanes) | - | adjacent signed 16-bit products, summed in pairs (wrapping)
_mm256_maddubs_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpmaddubsw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = clamp(a[2 * k] * b[2 * k] + a[2 * k + 1] * b[2 * k + 1], -32768, 32767) (a: u8 lanes; b: i8 lanes; r: i16 lanes) | - | unsigned bytes of a times signed bytes of b, adjacent pairs summed, saturating
_mm256_mulhrs_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpmulhrsw <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = (((a[k] * b[k]) >> 14) + 1) >> 1 (i16 lanes) | - | lanewise rounded fixed-point product
_mm256_sad_epu8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsadbw <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = abs(a[8 * k + 0] - b[8 * k + 0]) + abs(a[8 * k + 1] - b[8 * k + 1]) + abs(a[8 * k + 2] - b[8 * k + 2]) + abs(a[8 * k + 3] - b[8 * k + 3]) + abs(a[8 * k + 4] - b[8 * k + 4]) + abs(a[8 * k + 5] - b[8 * k + 5]) + abs(a[8 * k + 6] - b[8 * k + 6]) + abs(a[8 * k + 7] - b[8 * k + 7]) (a, b: u8 lanes; r: u64 lanes) | - | sums of absolute byte differences, one per 8 bytes
_mm256_avg_epu8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpavgb <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = (a[k] + b[k] + 1) >> 1 (bytes) | - | lanewise rounded average
_mm256_avg_epu16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpavgw <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = (a[k] + b[k] + 1) >> 1 (u16 lanes) | - | lanewise rounded average

# ---- AVX2 min, max, abs, sign ----
_mm256_min_epu8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpminub <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = min(a[k], b[k]) (bytes) | - | lanewise minimum
_mm256_max_epu8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpmaxub <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = max(a[k], b[k]) (bytes) | - | lanewise maximum
_mm256_min_epi8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpminsb <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = min(a[k], b[k]) (i8 lanes) | - | lanewise minimum
_mm256_max_epi8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpmaxsb <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = max(a[k], b[k]) (i8 lanes) | - | lanewise maximum
_mm256_min_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpminsw <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = min(a[k], b[k]) (i16 lanes) | - | lanewise minimum
_mm256_max_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpmaxsw <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = max(a[k], b[k]) (i16 lanes) | - | lanewise maximum
_mm256_min_epu16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpminuw <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = min(a[k], b[k]) (u16 lanes) | - | lanewise minimum
_mm256_max_epu16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpmaxuw <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = max(a[k], b[k]) (u16 lanes) | - | lanewise maximum
_mm256_min_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpminsd <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = min(a[k], b[k]) (i32 lanes) | - | lanewise minimum
_mm256_max_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpmaxsd <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = max(a[k], b[k]) (i32 lanes) | - | lanewise maximum
_mm256_min_epu32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpminud <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = min(a[k], b[k]) (u32 lanes) | - | lanewise minimum
_mm256_max_epu32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpmaxud <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = max(a[k], b[k]) (u32 lanes) | - | lanewise maximum
_mm256_abs_epi8 | avx2 | (a: __m256i) -> __m256i | intr | vpabsb <a:y>, <d:y> | pure | none | - | r[k] = abs(a[k]) (i8 lanes) | - | lanewise absolute value (MIN stays MIN)
_mm256_sign_epi8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsignb <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if b[k] < 0 { -a[k] } else if b[k] == 0 { 0 } else { a[k] } (i8 lanes) | - | a negated where b < 0, zeroed where b == 0
_mm256_abs_epi16 | avx2 | (a: __m256i) -> __m256i | intr | vpabsw <a:y>, <d:y> | pure | none | - | r[k] = abs(a[k]) (i16 lanes) | - | lanewise absolute value (MIN stays MIN)
_mm256_sign_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsignw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if b[k] < 0 { -a[k] } else if b[k] == 0 { 0 } else { a[k] } (i16 lanes) | - | a negated where b < 0, zeroed where b == 0
_mm256_abs_epi32 | avx2 | (a: __m256i) -> __m256i | intr | vpabsd <a:y>, <d:y> | pure | none | - | r[k] = abs(a[k]) (i32 lanes) | - | lanewise absolute value (MIN stays MIN)
_mm256_sign_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsignd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if b[k] < 0 { -a[k] } else if b[k] == 0 { 0 } else { a[k] } (i32 lanes) | - | a negated where b < 0, zeroed where b == 0

# ---- AVX2 compare and logic ----
_mm256_cmpeq_epi8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpcmpeqb <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = if a[k] == b[k] { -1 } else { 0 } (i8 lanes) | x86_64: _mm_cmpeq_epi8, twice | lanewise a == b: a mask
_mm256_cmpgt_epi8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpcmpgtb <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if a[k] > b[k] { -1 } else { 0 } (i8 lanes) | - | lanewise a > b (signed): a mask
_mm256_cmpeq_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpcmpeqw <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = if a[k] == b[k] { -1 } else { 0 } (i16 lanes) | x86_64: _mm_cmpeq_epi16, twice | lanewise a == b: a mask
_mm256_cmpgt_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpcmpgtw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if a[k] > b[k] { -1 } else { 0 } (i16 lanes) | - | lanewise a > b (signed): a mask
_mm256_cmpeq_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpcmpeqd <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = if a[k] == b[k] { -1 } else { 0 } (i32 lanes) | x86_64: _mm_cmpeq_epi32, twice | lanewise a == b: a mask
_mm256_cmpgt_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpcmpgtd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if a[k] > b[k] { -1 } else { 0 } (i32 lanes) | - | lanewise a > b (signed): a mask
_mm256_cmpeq_epi64 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpcmpeqq <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = if a[k] == b[k] { -1 } else { 0 } (i64 lanes) | x86_64: _mm_cmpeq_epi64, twice | lanewise a == b: a mask
_mm256_cmpgt_epi64 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpcmpgtq <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if a[k] > b[k] { -1 } else { 0 } (i64 lanes) | - | lanewise a > b (signed): a mask
_mm256_and_si256 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpand <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] & b[k] (bytes) | - | bitwise a & b
_mm256_or_si256 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpor <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k]|b[k] (bytes) | - | bitwise a|b
_mm256_xor_si256 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpxor <b:y>, <a:y>, <d:y> | pure commutative | none | - | r[k] = a[k] ^ b[k] (bytes) | - | bitwise a ^ b
_mm256_andnot_si256 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpandn <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = (a[k] ^ 255) & b[k] (bytes) | - | bitwise !a & b
_mm256_movemask_epi8 | avx2 | (a: __m256i) -> i32 | intr | vpmovmskb <a:y>, <d:w> | pure | none | movemask.b | r = sum over k of (if a[k] >= 128 { 1 << k } else { 0 }) (bytes) | x86_64: _mm_movemask_epi8, twice | the 32 bytes' top bits as a 32-bit mask
_mm256_blendv_epi8 | avx2 | (a: __m256i, b: __m256i, mask: __m256i) -> __m256i | intr | vpblendvb <mask:y>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if mask[k] >= 128 { b[k] } else { a[k] } (bytes) | - | byte k is b's where mask's byte k has its top bit set
_mm256_blend_epi16 | avx2 | (a: __m256i, b: __m256i, imm8: const 0..=255) -> __m256i | intr | vpblendw $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if (imm8 >> (k % 8)) & 1 != 0 { b[k] } else { a[k] } (i16 lanes) | - | lane k is b's where imm8's bit k % 8 is set (the same 8 bits for each 128-bit half)
_mm256_blend_epi32 | avx2 | (a: __m256i, b: __m256i, imm8: const 0..=255) -> __m256i | intr | vpblendd $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if (imm8 >> k) & 1 != 0 { b[k] } else { a[k] } (i32 lanes) | - | lane k is b's where imm8's bit k is set
_mm_blend_epi32 | avx2 | (a: __m128i, b: __m128i, imm8: const 0..=15) -> __m128i | intr | vpblendd $<imm8>, <b>, <a>, <d> | pure | none | - | r[k] = if (imm8 >> k) & 1 != 0 { b[k] } else { a[k] } (i32 lanes) | - | lane k is b's where imm8's bit k is set

# ---- AVX2 shifts ----
_mm256_slli_epi16 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpsllw $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = if imm8 > 15 { 0 } else { a[k] << imm8 } (u16 lanes) | - | each lane shifted left by imm8
_mm256_srli_epi16 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpsrlw $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = if imm8 > 15 { 0 } else { a[k] >> imm8 } (u16 lanes) | - | each lane shifted right by imm8, zeros in
_mm256_sll_epi16 | avx2 | (a: __m256i, count: __m128i) -> __m256i | intr | vpsllw <count>, <a:y>, <d:y> | pure | none | - | r[k] = if count[0] > 15 { 0 } else { a[k] << (count[0] as i64) } (a, r: u16 lanes; count: u64 lanes) | - | each lane shifted left by count's low 64 bits
_mm256_srl_epi16 | avx2 | (a: __m256i, count: __m128i) -> __m256i | intr | vpsrlw <count>, <a:y>, <d:y> | pure | none | - | r[k] = if count[0] > 15 { 0 } else { a[k] >> (count[0] as i64) } (a, r: u16 lanes; count: u64 lanes) | - | each lane shifted right by count's low 64 bits, zeros in
_mm256_srai_epi16 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpsraw $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = a[k] >> min(imm8, 15) (i16 lanes) | - | each lane shifted right by imm8, the sign in
_mm256_sra_epi16 | avx2 | (a: __m256i, count: __m128i) -> __m256i | intr | vpsraw <count>, <a:y>, <d:y> | pure | none | - | r[k] = a[k] >> (if count[0] > 15 { 15 } else { count[0] as i64 }) (a, r: i16 lanes; count: u64 lanes) | - | each lane shifted right by count's low 64 bits, the sign in
_mm256_slli_epi32 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpslld $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = if imm8 > 31 { 0 } else { a[k] << imm8 } (u32 lanes) | - | each lane shifted left by imm8
_mm256_srli_epi32 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpsrld $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = if imm8 > 31 { 0 } else { a[k] >> imm8 } (u32 lanes) | - | each lane shifted right by imm8, zeros in
_mm256_sll_epi32 | avx2 | (a: __m256i, count: __m128i) -> __m256i | intr | vpslld <count>, <a:y>, <d:y> | pure | none | - | r[k] = if count[0] > 31 { 0 } else { a[k] << (count[0] as i64) } (a, r: u32 lanes; count: u64 lanes) | - | each lane shifted left by count's low 64 bits
_mm256_srl_epi32 | avx2 | (a: __m256i, count: __m128i) -> __m256i | intr | vpsrld <count>, <a:y>, <d:y> | pure | none | - | r[k] = if count[0] > 31 { 0 } else { a[k] >> (count[0] as i64) } (a, r: u32 lanes; count: u64 lanes) | - | each lane shifted right by count's low 64 bits, zeros in
_mm256_srai_epi32 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpsrad $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = a[k] >> min(imm8, 31) (i32 lanes) | - | each lane shifted right by imm8, the sign in
_mm256_sra_epi32 | avx2 | (a: __m256i, count: __m128i) -> __m256i | intr | vpsrad <count>, <a:y>, <d:y> | pure | none | - | r[k] = a[k] >> (if count[0] > 31 { 31 } else { count[0] as i64 }) (a, r: i32 lanes; count: u64 lanes) | - | each lane shifted right by count's low 64 bits, the sign in
_mm256_slli_epi64 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpsllq $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = if imm8 > 63 { 0 } else { a[k] << (imm8 as u64) } (u64 lanes) | - | each lane shifted left by imm8
_mm256_srli_epi64 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpsrlq $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = if imm8 > 63 { 0 } else { a[k] >> (imm8 as u64) } (u64 lanes) | - | each lane shifted right by imm8, zeros in
_mm256_sll_epi64 | avx2 | (a: __m256i, count: __m128i) -> __m256i | intr | vpsllq <count>, <a:y>, <d:y> | pure | none | - | r[k] = if count[0] > 63 { 0 } else { a[k] << (count[0]) } (a, r: u64 lanes; count: u64 lanes) | - | each lane shifted left by count's low 64 bits
_mm256_srl_epi64 | avx2 | (a: __m256i, count: __m128i) -> __m256i | intr | vpsrlq <count>, <a:y>, <d:y> | pure | none | - | r[k] = if count[0] > 63 { 0 } else { a[k] >> (count[0]) } (a, r: u64 lanes; count: u64 lanes) | - | each lane shifted right by count's low 64 bits, zeros in
_mm_sllv_epi32 | avx2 | (a: __m128i, b: __m128i) -> __m128i | intr | vpsllvd <b>, <a>, <d> | pure | none | - | r[k] = if b[k] > 31 { 0 } else { a[k] << b[k] } (u32 lanes) | - | each lane shifted left by b's lane (0 from 32)
_mm_srlv_epi32 | avx2 | (a: __m128i, b: __m128i) -> __m128i | intr | vpsrlvd <b>, <a>, <d> | pure | none | - | r[k] = if b[k] > 31 { 0 } else { a[k] >> b[k] } (u32 lanes) | - | each lane shifted right by b's lane, zeros in (0 from 32)
_mm256_sllv_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsllvd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if b[k] > 31 { 0 } else { a[k] << b[k] } (u32 lanes) | - | each lane shifted left by b's lane (0 from 32)
_mm256_srlv_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsrlvd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if b[k] > 31 { 0 } else { a[k] >> b[k] } (u32 lanes) | - | each lane shifted right by b's lane, zeros in (0 from 32)
_mm_srav_epi32 | avx2 | (a: __m128i, b: __m128i) -> __m128i | intr | vpsravd <b>, <a>, <d> | pure | none | - | r[k] = a[k] >> min(b[k], 31) (a, r: i32 lanes; b: u32 lanes) | - | each lane shifted right by b's lane, the sign in
_mm256_srav_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsravd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = a[k] >> min(b[k], 31) (a, r: i32 lanes; b: u32 lanes) | - | each lane shifted right by b's lane, the sign in
_mm_sllv_epi64 | avx2 | (a: __m128i, b: __m128i) -> __m128i | intr | vpsllvq <b>, <a>, <d> | pure | none | - | r[k] = if b[k] > 63 { 0 } else { a[k] << (b[k] as u64) } (u64 lanes) | - | each lane shifted left by b's lane (0 from 64)
_mm_srlv_epi64 | avx2 | (a: __m128i, b: __m128i) -> __m128i | intr | vpsrlvq <b>, <a>, <d> | pure | none | - | r[k] = if b[k] > 63 { 0 } else { a[k] >> (b[k] as u64) } (u64 lanes) | - | each lane shifted right by b's lane, zeros in (0 from 64)
_mm256_sllv_epi64 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsllvq <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if b[k] > 63 { 0 } else { a[k] << (b[k] as u64) } (u64 lanes) | - | each lane shifted left by b's lane (0 from 64)
_mm256_srlv_epi64 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpsrlvq <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if b[k] > 63 { 0 } else { a[k] >> (b[k] as u64) } (u64 lanes) | - | each lane shifted right by b's lane, zeros in (0 from 64)
_mm256_slli_si256 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpslldq $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 16 >= imm8 { a[k - imm8] } else { 0 } (bytes) | - | each 128-bit half shifted left by imm8 bytes
_mm256_srli_si256 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpsrldq $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 16 + imm8 < 16 { a[k + imm8] } else { 0 } (bytes) | - | each 128-bit half shifted right by imm8 bytes

# ---- AVX2 shuffles within 128-bit halves ----
_mm256_shuffle_epi8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpshufb <b:y>, <a:y>, <d:y> | pure | none | perm.pshufb | r[k] = if b[k] & 0x80 != 0 { 0 } else { a[k - k % 16 + (b[k] & 15)] } (bytes) | - | a table lookup in each 128-bit half: byte k is its half's a[b[k] & 15], 0 when b[k]'s bit 7 is set
_mm256_alignr_epi8 | avx2 | (a: __m256i, b: __m256i, imm8: const 0..=255) -> __m256i | intr | vpalignr $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 16 + imm8 < 16 { b[k + imm8] } else if k % 16 + imm8 < 32 { a[k + imm8 - 16] } else { 0 } (bytes) | - | in each 128-bit half, bytes imm8.. of b's half then a's
_mm256_shuffle_epi32 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpshufd $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = a[k - k % 4 + ((imm8 >> (2 * (k % 4))) & 3)] (i32 lanes) | - | each 128-bit half's lanes shuffled by imm8
_mm256_shufflelo_epi16 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpshuflw $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 8 < 4 { a[k - k % 8 + ((imm8 >> (2 * (k % 8))) & 3)] } else { a[k] } (i16 lanes) | - | each half's low four lanes shuffled by imm8
_mm256_shufflehi_epi16 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpshufhw $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 8 < 4 { a[k] } else { a[k - k % 8 + 4 + ((imm8 >> (2 * (k % 8 - 4))) & 3)] } (i16 lanes) | - | each half's high four lanes shuffled by imm8
_mm256_unpacklo_epi8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpunpcklbw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 2 == 0 { a[k - k % 16 + (k % 16) / 2] } else { b[k - k % 16 + (k % 16) / 2] } (i8 lanes) | - | each half's low lanes interleaved, a's first
_mm256_unpackhi_epi8 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpunpckhbw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 2 == 0 { a[k - k % 16 + 8 + (k % 16) / 2] } else { b[k - k % 16 + 8 + (k % 16) / 2] } (i8 lanes) | - | each half's high lanes interleaved, a's first
_mm256_unpacklo_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpunpcklwd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 2 == 0 { a[k - k % 8 + (k % 8) / 2] } else { b[k - k % 8 + (k % 8) / 2] } (i16 lanes) | - | each half's low lanes interleaved, a's first
_mm256_unpackhi_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpunpckhwd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 2 == 0 { a[k - k % 8 + 4 + (k % 8) / 2] } else { b[k - k % 8 + 4 + (k % 8) / 2] } (i16 lanes) | - | each half's high lanes interleaved, a's first
_mm256_unpacklo_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpunpckldq <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 2 == 0 { a[k - k % 4 + (k % 4) / 2] } else { b[k - k % 4 + (k % 4) / 2] } (i32 lanes) | - | each half's low lanes interleaved, a's first
_mm256_unpackhi_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpunpckhdq <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 2 == 0 { a[k - k % 4 + 2 + (k % 4) / 2] } else { b[k - k % 4 + 2 + (k % 4) / 2] } (i32 lanes) | - | each half's high lanes interleaved, a's first
_mm256_unpacklo_epi64 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpunpcklqdq <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 2 == 0 { a[k - k % 2 + (k % 2) / 2] } else { b[k - k % 2 + (k % 2) / 2] } (i64 lanes) | - | each half's low lanes interleaved, a's first
_mm256_unpackhi_epi64 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpunpckhqdq <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 2 == 0 { a[k - k % 2 + 1 + (k % 2) / 2] } else { b[k - k % 2 + 1 + (k % 2) / 2] } (i64 lanes) | - | each half's high lanes interleaved, a's first
_mm256_packs_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpacksswb <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 16 < 8 { clamp(a[k / 16 * 8 + k % 16], -128, 127) } else { clamp(b[k / 16 * 8 + k % 16 - 8], -128, 127) } (a, b: i16 lanes; r: i8 lanes) | - | per 128-bit half: a's then b's lanes narrowed to 8 bits, saturating
_mm256_packs_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpackssdw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 8 < 4 { clamp(a[k / 8 * 4 + k % 8], -32768, 32767) } else { clamp(b[k / 8 * 4 + k % 8 - 4], -32768, 32767) } (a, b: i32 lanes; r: i16 lanes) | - | per 128-bit half: a's then b's lanes narrowed to 16 bits, saturating
_mm256_packus_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpackuswb <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 16 < 8 { clamp(a[k / 16 * 8 + k % 16], 0, 255) } else { clamp(b[k / 16 * 8 + k % 16 - 8], 0, 255) } (a, b: i16 lanes; r: u8 lanes) | - | per 128-bit half: a's then b's lanes narrowed to 8 bits, saturating to 0..255
_mm256_packus_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vpackusdw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 8 < 4 { clamp(a[k / 8 * 4 + k % 8], 0, 65535) } else { clamp(b[k / 8 * 4 + k % 8 - 4], 0, 65535) } (a, b: i32 lanes; r: u16 lanes) | - | per 128-bit half: a's then b's lanes narrowed to 16 bits, saturating to 0..65535
_mm256_hadd_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vphaddw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 8 < 4 { a[k - k % 8 + 2 * (k % 8)] + a[k - k % 8 + 2 * (k % 8) + 1] } else { b[k - k % 8 + 2 * (k % 8) - 8] + b[k - k % 8 + 2 * (k % 8) - 7] } (i16 lanes) | - | per 128-bit half: adjacent pairs, a's then b's (wrapping)
_mm256_hsub_epi16 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vphsubw <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 8 < 4 { a[k - k % 8 + 2 * (k % 8)] - a[k - k % 8 + 2 * (k % 8) + 1] } else { b[k - k % 8 + 2 * (k % 8) - 8] - b[k - k % 8 + 2 * (k % 8) - 7] } (i16 lanes) | - | per 128-bit half: adjacent pairs, a's then b's (wrapping)
_mm256_hadd_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vphaddd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 4 < 2 { a[k - k % 4 + 2 * (k % 4)] + a[k - k % 4 + 2 * (k % 4) + 1] } else { b[k - k % 4 + 2 * (k % 4) - 4] + b[k - k % 4 + 2 * (k % 4) - 3] } (i32 lanes) | - | per 128-bit half: adjacent pairs, a's then b's (wrapping)
_mm256_hsub_epi32 | avx2 | (a: __m256i, b: __m256i) -> __m256i | intr | vphsubd <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if k % 4 < 2 { a[k - k % 4 + 2 * (k % 4)] - a[k - k % 4 + 2 * (k % 4) + 1] } else { b[k - k % 4 + 2 * (k % 4) - 4] - b[k - k % 4 + 2 * (k % 4) - 3] } (i32 lanes) | - | per 128-bit half: adjacent pairs, a's then b's (wrapping)

# ---- AVX2 across halves ----
_mm256_permute4x64_epi64 | avx2 | (a: __m256i, imm8: const 0..=255) -> __m256i | intr | vpermq $<imm8>, <a:y>, <d:y> | pure | none | - | r[k] = a[(imm8 >> (2 * k)) & 3] (i64 lanes) | - | lane k is a's lane (imm8 >> 2k) & 3
_mm256_permutevar8x32_epi32 | avx2 | (a: __m256i, idx: __m256i) -> __m256i | intr | vpermd <a:y>, <idx:y>, <d:y> | pure | none | - | r[k] = a[idx[k] & 7] (i32 lanes) | - | lane k is a's lane idx[k] & 7
_mm256_permute2x128_si256 | avx2 | (a: __m256i, b: __m256i, imm8: const 0..=255) -> __m256i | intr | vperm2i128 $<imm8>, <b:y>, <a:y>, <d:y> | pure | none | - | r[k] = if (imm8 >> (4 * (k / 16))) & 8 != 0 { 0 } else if (imm8 >> (4 * (k / 16))) & 2 == 0 { a[16 * ((imm8 >> (4 * (k / 16))) & 1) + k % 16] } else { b[16 * ((imm8 >> (4 * (k / 16))) & 1) + k % 16] } (a, b, r: bytes) | - | each half from a or b by imm8 (bits 0-1 low, 4-5 high; bits 3, 7: zero)
_mm256_extracti128_si256 | avx2 | (a: __m256i, imm8: const 0..=1) -> __m128i | intr | vextracti128 $<imm8>, <a:y>, <d> | pure | none | - | r[k] = a[16 * imm8 + k] (bytes) | - | the 128-bit half imm8 (0 low, 1 high)
_mm256_inserti128_si256 | avx2 | (a: __m256i, b: __m128i, imm8: const 0..=1) -> __m256i | intr | vinserti128 $<imm8>, <b>, <a:y>, <d:y> | pure | none | - | r[k] = if k / 16 == imm8 { b[k % 16] } else { a[k] } (bytes) | - | a with its 128-bit half imm8 replaced by b
_mm_broadcastb_epi8 | avx2 | (a: __m128i) -> __m128i | intr | vpbroadcastb <a>, <d> | pure | none | - | r[k] = a[0] (i8 lanes) | - | a's lane 0 in every lane
_mm256_broadcastb_epi8 | avx2 | (a: __m128i) -> __m256i | intr | vpbroadcastb <a>, <d:y> | pure | none | - | r[k] = a[0] (i8 lanes) | - | a's lane 0 in every lane
_mm_broadcastw_epi16 | avx2 | (a: __m128i) -> __m128i | intr | vpbroadcastw <a>, <d> | pure | none | - | r[k] = a[0] (i16 lanes) | - | a's lane 0 in every lane
_mm256_broadcastw_epi16 | avx2 | (a: __m128i) -> __m256i | intr | vpbroadcastw <a>, <d:y> | pure | none | - | r[k] = a[0] (i16 lanes) | - | a's lane 0 in every lane
_mm_broadcastd_epi32 | avx2 | (a: __m128i) -> __m128i | intr | vpbroadcastd <a>, <d> | pure | none | - | r[k] = a[0] (i32 lanes) | - | a's lane 0 in every lane
_mm256_broadcastd_epi32 | avx2 | (a: __m128i) -> __m256i | intr | vpbroadcastd <a>, <d:y> | pure | none | - | r[k] = a[0] (i32 lanes) | - | a's lane 0 in every lane
