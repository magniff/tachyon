# std::arch::x86_64: the intrinsics, one per line (compiler/arch/README.md
# gives the columns). Names and signatures are Intel's; an immediate is an
# ordinary argument, `n: const LO..=HI`. Instructions are AT&T syntax
# (source first), as the compiler writes them.
#
# name | features | signature | form | instruction | flags | memory | fold | semantics | equivalent | doc

# ---- Loads and stores (safe: a slice and an index, checked) ----
_mm_loadu_si128 | sse2 | (s: [u8], i: i64) -> __m128i | load | movdqu (<s>), <d> | - | load(s, 16) | - | r = s[i..i + 16] | aarch64: vld1q_u8 | the 16 bytes s[i..i + 16] (checked: 0 <= i, i + 16 <= s.len)
_mm_storeu_si128 | sse2 | (s: [u8], i: i64, v: __m128i) | store | movdqu <v>, (<s>) | - | store(s, 16) | - | s[i..i + 16] = v | aarch64: vst1q_u8 | v's 16 bytes into s[i..i + 16] (checked)

# ---- Build ----
_mm_set1_epi8 | sse2 | (x: i8) -> __m128i | vsplat:v16i8 | movd <x:w>, <d>; punpcklbw <d>, <d>; pshuflw $0, <d>, <d>; pshufd $0, <d>, <d> | pure | none | splat | r[k] = x (bytes) | aarch64: vdupq_n_u8 | every byte x

# ---- Compare ----
_mm_cmpeq_epi8 | sse2 | (a: __m128i, b: __m128i) -> __m128i | vcmp.eq:v16i8 | pcmpeqb <b>, <d> | pure commutative tied=a | none | lanes.eq | r[k] = if a[k] == b[k] { 0xff } else { 0 } (bytes) | aarch64: vceqq_u8 | bytewise a == b: a mask, each byte 0xff or 0

# ---- Masks ----
_mm_movemask_epi8 | sse2 | (a: __m128i) -> i32 | intr | pmovmskb <a>, <d:w> | pure | none | movemask.b | r = the top bit of each byte, byte k at bit k | aarch64: (recipe) vshrn_n_u16(vreinterpretq_u16_u8(m), 4) | the 16 bytes' top bits as a 16-bit mask

# ---- Permutes ----
_mm_shuffle_epi8 | ssse3 | (a: __m128i, b: __m128i) -> __m128i | intr | pshufb <b>, <d> | pure tied=a | none | perm.pshufb | r[k] = if b[k] & 0x80 != 0 { 0 } else { a[b[k] & 15] } (bytes) | aarch64: vqtbl1q_u8 (zeroes when idx >= 16 instead) | a table lookup: byte k is a[b[k] & 15], 0 when b[k]'s bit 7 is set

# ---- CRC-32 ----
_mm_crc32_u64 | sse4.2 | (crc: u64, v: u64) -> u64 | intr | crc32q <v>, <d> | pure tied=crc | none | crc.c64 | r = CRC-32C of crc's low 32 bits and v's 8 bytes | aarch64: __crc32cd | one step of CRC-32C over 8 bytes
