vaddl_s8 | neon | (a: int8x8_t, b: int8x8_t) -> int16x8_t | intr | saddl <d>.8h, <a>.8b, <b>.8b | pure | none | lanes.addl | r[k] = a[k] + b[k] | - | lanewise a + b, widened
