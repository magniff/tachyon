vshlq_n_s8 | neon | (a: int8x16_t, n: const 0..=7) -> int8x16_t | intr | shl <d>.16b, <a>.16b, #<n> | pure | none | lanes.shl | r[k] = a[k] << n | - | lanewise a << n
