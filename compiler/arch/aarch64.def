vxarq_u64 | sha3 | (a: uint64x2_t, b: uint64x2_t, imm6: const 0..=63) -> uint64x2_t | intr | xar <d>.2d, <a>.2d, <b>.2d, #<imm6> | pure | none | lanes.xar | (a[k] ^ b[k]) rotated right by imm6 | - | (a ^ b) rotated right by imm6, Keccak's rho step

# ---- AES, carry-less multiply ----
vaeseq_u8 | aes | (data: uint8x16_t, key: uint8x16_t) -> uint8x16_t | intr | aese <d>.16b, <key>.16b | pure tied=data | none | - | one AES encryption round: AddRoundKey, SubBytes, ShiftRows (FIPS-197) | x86_64: _mm_aesenclast_si128 (key added after) | one AES round: AddRoundKey, SubBytes, ShiftRows
vaesdq_u8 | aes | (data: uint8x16_t, key: uint8x16_t) -> uint8x16_t | intr | aesd <d>.16b, <key>.16b | pure tied=data | none | - | one AES decryption round: AddRoundKey, InvSubBytes, InvShiftRows (FIPS-197) | x86_64: _mm_aesdeclast_si128 (key added after) | one AES round: AddRoundKey, InvSubBytes, InvShiftRows
vaesmcq_u8 | aes | (data: uint8x16_t) -> uint8x16_t | intr | aesmc <d>.16b, <data>.16b | pure | none | - | AES MixColumns of data (FIPS-197) | - | AES MixColumns
vaesimcq_u8 | aes | (data: uint8x16_t) -> uint8x16_t | intr | aesimc <d>.16b, <data>.16b | pure | none | - | AES InvMixColumns of data (FIPS-197) | x86_64: _mm_aesimc_si128 | AES InvMixColumns
vmull_p64 | aes | (a: u64, b: u64) -> v2u64 | intr | fmov <t:d>, <a:x>; fmov <u:d>, <b:x>; pmull <d>.1q, <t>.1d, <u>.1d | pure commutative | none | clmul | the carry-less product of a and b, 128 bits, low lane first | x86_64: _mm_clmulepi64_si128(a, b, 0x00) | carry-less multiply: 64 x 64 -> 128 bits (CRC folding, GHASH)
vmull_high_p64 | aes | (a: poly64x2_t, b: poly64x2_t) -> v2u64 | intr | pmull2 <d>.1q, <a>.2d, <b>.2d | pure commutative | none | clmul | the carry-less product of a[1] and b[1], 128 bits, low lane first | x86_64: _mm_clmulepi64_si128(a, b, 0x11) | carry-less multiply of the high lanes
vmull_p8 | neon | (a: poly8x8_t, b: poly8x8_t) -> poly16x8_t | intr | pmull <d>.8h, <a>.8b, <b>.8b | pure commutative | none | clmul | the carry-less product of a[k] and b[k], 16 bits | - | lanewise carry-less multiply, 8 x 8 -> 16 bits

# ---- Dot products ----
vdotq_u32 | dotprod | (acc: uint32x4_t, a: uint8x16_t, b: uint8x16_t) -> uint32x4_t | intr | udot <d>.4s, <a>.16b, <b>.16b | pure tied=acc | none | dot | r[k] = acc[k] + a[4 * k] * b[4 * k] + a[4 * k + 1] * b[4 * k + 1] + a[4 * k + 2] * b[4 * k + 2] + a[4 * k + 3] * b[4 * k + 3] | - | each 32-bit lane of acc plus the dot product of its four bytes of a and b
vdot_u32 | dotprod | (acc: uint32x2_t, a: uint8x8_t, b: uint8x8_t) -> uint32x2_t | intr | udot <d>.2s, <a>.8b, <b>.8b | pure tied=acc | none | dot | r[k] = acc[k] + a[4 * k] * b[4 * k] + a[4 * k + 1] * b[4 * k + 1] + a[4 * k + 2] * b[4 * k + 2] + a[4 * k + 3] * b[4 * k + 3] | - | each 32-bit lane of acc plus the dot product of its four bytes of a and b
vdotq_laneq_u32 | dotprod | (acc: uint32x4_t, a: uint8x16_t, b: uint8x16_t, lane: const 0..=3) -> uint32x4_t | intr | udot <d>.4s, <a>.16b, <b>.4b[<lane>] | pure tied=acc | none | dot | r[k] = acc[k] + a[4 * k] * b[4 * lane] + a[4 * k + 1] * b[4 * lane + 1] + a[4 * k + 2] * b[4 * lane + 2] + a[4 * k + 3] * b[4 * lane + 3] | - | each 32-bit lane of acc plus the dot product of its four bytes of a and b's group `lane`
vdotq_lane_u32 | dotprod | (acc: uint32x4_t, a: uint8x16_t, b: uint8x8_t, lane: const 0..=1) -> uint32x4_t | intr | udot <d>.4s, <a>.16b, <b>.4b[<lane>] | pure tied=acc | none | dot | r[k] = acc[k] + a[4 * k] * b[4 * lane] + a[4 * k + 1] * b[4 * lane + 1] + a[4 * k + 2] * b[4 * lane + 2] + a[4 * k + 3] * b[4 * lane + 3] | - | each 32-bit lane of acc plus the dot product of its four bytes of a and b's group `lane`
vdot_laneq_u32 | dotprod | (acc: uint32x2_t, a: uint8x8_t, b: uint8x16_t, lane: const 0..=3) -> uint32x2_t | intr | udot <d>.2s, <a>.8b, <b>.4b[<lane>] | pure tied=acc | none | dot | r[k] = acc[k] + a[4 * k] * b[4 * lane] + a[4 * k + 1] * b[4 * lane + 1] + a[4 * k + 2] * b[4 * lane + 2] + a[4 * k + 3] * b[4 * lane + 3] | - | each 32-bit lane of acc plus the dot product of its four bytes of a and b's group `lane`
vdot_lane_u32 | dotprod | (acc: uint32x2_t, a: uint8x8_t, b: uint8x8_t, lane: const 0..=1) -> uint32x2_t | intr | udot <d>.2s, <a>.8b, <b>.4b[<lane>] | pure tied=acc | none | dot | r[k] = acc[k] + a[4 * k] * b[4 * lane] + a[4 * k + 1] * b[4 * lane + 1] + a[4 * k + 2] * b[4 * lane + 2] + a[4 * k + 3] * b[4 * lane + 3] | - | each 32-bit lane of acc plus the dot product of its four bytes of a and b's group `lane`
vdotq_s32 | dotprod | (acc: int32x4_t, a: int8x16_t, b: int8x16_t) -> int32x4_t | intr | sdot <d>.4s, <a>.16b, <b>.16b | pure tied=acc | none | dot | r[k] = acc[k] + a[4 * k] * b[4 * k] + a[4 * k + 1] * b[4 * k + 1] + a[4 * k + 2] * b[4 * k + 2] + a[4 * k + 3] * b[4 * k + 3] | - | each 32-bit lane of acc plus the dot product of its four bytes of a and b
