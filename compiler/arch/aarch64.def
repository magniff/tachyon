__crc32ch | crc | (crc: u32, data: u16) -> u32 | intr | crc32ch <d:w>, <crc:w>, <data:w> | pure | none | crc.c16 | r = CRC-32C (Castagnoli, reflected, no inversion) of crc and data's 2 bytes | x86_64: _mm_crc32_u16 | one step of CRC-32C over 2 bytes
__crc32cw | crc | (crc: u32, data: u32) -> u32 | intr | crc32cw <d:w>, <crc:w>, <data:w> | pure | none | crc.c32 | r = CRC-32C (Castagnoli, reflected, no inversion) of crc and data's 4 bytes | x86_64: _mm_crc32_u32 | one step of CRC-32C over 4 bytes
__crc32cd | crc | (crc: u32, data: u64) -> u32 | intr | crc32cx <d:w>, <crc:w>, <data:x> | pure | none | crc.c64 | r = CRC-32C (Castagnoli, reflected, no inversion) of crc and data's 8 bytes | x86_64: _mm_crc32_u64 | one step of CRC-32C over 8 bytes

# ---- SHA-1, SHA-256 ----
