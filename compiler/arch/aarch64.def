# std::arch::aarch64: the intrinsics, one per line (compiler/arch/README.md
# gives the columns). Names and signatures are ACLE's (arm_neon.h,
# arm_acle.h); an immediate is an ordinary argument, `n: const LO..=HI`.
#
# name | features | signature | form | instruction | flags | memory | fold | semantics | equivalent | doc

# ---- Loads and stores (safe: a slice and an index, checked) ----
vld1q_u8 | neon | (s: [u8], i: i64) -> uint8x16_t | load | ldr <d:q>, [<s>] | - | load(s, 16) | - | r[k] = s[i + k] | x86_64: _mm_loadu_si128 | the 16 bytes s[i..i + 16] as a vector (checked: 0 <= i, i + 16 <= s.len)
vst1q_u8 | neon | (s: [u8], i: i64, v: uint8x16_t) | store | str <v:q>, [<s>] | - | store(s, 16) | - | s[i + k] = v[k] | x86_64: _mm_storeu_si128 | v's 16 bytes into s[i..i + 16] (checked)

# ---- Build, lanes ----
vdupq_n_u8 | neon | (x: u8) -> uint8x16_t | vsplat | dup <d>.16b, <x:w> | pure | none | splat | r[k] = x | x86_64: _mm_set1_epi8 | every lane x
vget_lane_u64 | neon | (v: uint64x1_t, lane: const 0..=0) -> u64 | vext | mov <d:x>, <v>.d[<lane>] | pure | none | lane | r = v[lane] | - | lane `lane` of v

# ---- Casts (no instruction) ----
vreinterpretq_u16_u8 | neon | (a: uint8x16_t) -> uint16x8_t | cast | - | pure | none | cast | r = a's 16 bytes as u16 lanes | x86_64: (the same __m128i) | the same bits as eight u16 lanes

# ---- Arithmetic ----
vaddq_u8 | neon | (a: uint8x16_t, b: uint8x16_t) -> uint8x16_t | vbin.add | add <d>.16b, <a>.16b, <b>.16b | pure commutative | none | lanes.add | r[k] = a[k] + b[k] (wrapping) | x86_64: _mm_add_epi8 | lanewise a + b, wrapping
vqsubq_u8 | neon | (a: uint8x16_t, b: uint8x16_t) -> uint8x16_t | intr | uqsub <d>.16b, <a>.16b, <b>.16b | pure | none | lanes.qsub_u | r[k] = max(a[k] - b[k], 0) | x86_64: _mm_subs_epu8 | lanewise a - b, saturating at 0

# ---- Compare ----
vceqq_u8 | neon | (a: uint8x16_t, b: uint8x16_t) -> uint8x16_t | vcmp.eq | cmeq <d>.16b, <a>.16b, <b>.16b | pure commutative | none | lanes.eq | r[k] = if a[k] == b[k] { 0xff } else { 0 } | x86_64: _mm_cmpeq_epi8 | lanewise a == b: a mask, each lane 0xff or 0

# ---- Narrowing ----
vshrn_n_u16 | neon | (a: uint16x8_t, n: const 1..=8) -> uint8x8_t | intr | shrn <d>.8b, <a>.8h, #<n> | pure | none | lanes.shrn | r[k] = (a[k] >> n) as u8 | - | each u16 lane shifted right by n, narrowed to its low 8 bits (the NEON movemask: n = 4 gives 4 bits per byte)

# ---- Horizontal ----
vmaxvq_u8 | neon | (a: uint8x16_t) -> u8 | intr | umaxv <t:b>, <a>.16b; umov <d:w>, <t>.b[0] | pure | none | across.max_u | r = max over k of a[k] | - | the largest lane (any byte set: vmaxvq_u8(m) != 0)

# ---- Permutes ----
vextq_u8 | neon | (a: uint8x16_t, b: uint8x16_t, n: const 0..=15) -> uint8x16_t | intr | ext <d>.16b, <a>.16b, <b>.16b, #<n> | pure | none | perm.ext | r[k] = if k + n < 16 { a[k + n] } else { b[k + n - 16] } | x86_64: _mm_alignr_epi8(b, a, n) | bytes n..n + 16 of a then b
vqtbl1q_u8 | neon | (t: uint8x16_t, idx: uint8x16_t) -> uint8x16_t | intr | tbl <d>.16b, {<t>.16b}, <idx>.16b | pure | none | perm.tbl | r[k] = if idx[k] < 16 { t[idx[k]] } else { 0 } | x86_64: _mm_shuffle_epi8 (zeroes when bit 7 is set instead) | a table lookup: lane k is t[idx[k]], 0 when idx[k] >= 16

# ---- CRC-32 ----
__crc32cd | crc | (crc: u32, data: u64) -> u32 | intr | crc32cx <d:w>, <crc:w>, <data:x> | pure | none | crc.c64 | r = CRC-32C of crc and data's 8 bytes (Castagnoli, reflected, no inversion) | x86_64: _mm_crc32_u64 | one step of CRC-32C over 8 bytes
