vshrn_high_n_s16 | neon | (lo: int8x8_t, a: int16x8_t, n: const 1..=8) -> int8x16_t | intr | shrn2 <d>.16b, <a>.8h, #<n> | pure tied=lo | none | lanes.shrn | r[k] = if k < 8 { lo[k] } else { (a[k - 8] >> n) } | - | lo, then a shifted and narrowed as vshrn_n_s16 does, as the high half
vshrn_high_n_u16 | neon | (lo: uint8x8_t, a: uint16x8_t, n: const 1..=8) -> uint8x16_t | intr | shrn2 <d>.16b, <a>.8h, #<n> | pure tied=lo | none | lanes.shrn | r[k] = if k < 8 { lo[k] } else { (a[k - 8] >> n) } | - | lo, then a shifted and narrowed as vshrn_n_u16 does, as the high half
