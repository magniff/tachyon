vshrn_high_n_u64 | neon | (lo: uint32x2_t, a: uint64x2_t, n: const 1..=32) -> uint32x4_t | intr | shrn2 <d>.4s, <a>.2d, #<n> | pure tied=lo | none | lanes.shrn | r[k] = if k < 2 { lo[k] } else { ((a[k - 2] >> (n as u64)) as i64) } | - | lo, then a shifted and narrowed as vshrn_n_u64 does, as the high half
vrshrn_high_n_s16 | neon | (lo: int8x8_t, a: int16x8_t, n: const 1..=8) -> int8x16_t | intr | rshrn2 <d>.16b, <a>.8h, #<n> | pure tied=lo | none | lanes.rshrn | r[k] = if k < 8 { lo[k] } else { ((a[k - 8] + (1 << (n - 1))) >> n) } | - | lo, then a shifted and narrowed as vrshrn_n_s16 does, as the high half
vrshrn_high_n_u16 | neon | (lo: uint8x8_t, a: uint16x8_t, n: const 1..=8) -> uint8x16_t | intr | rshrn2 <d>.16b, <a>.8h, #<n> | pure tied=lo | none | lanes.rshrn | r[k] = if k < 8 { lo[k] } else { ((a[k - 8] + (1 << (n - 1))) >> n) } | - | lo, then a shifted and narrowed as vrshrn_n_u16 does, as the high half
vrshrn_high_n_s32 | neon | (lo: int16x4_t, a: int32x4_t, n: const 1..=16) -> int16x8_t | intr | rshrn2 <d>.8h, <a>.4s, #<n> | pure tied=lo | none | lanes.rshrn | r[k] = if k < 4 { lo[k] } else { ((a[k - 4] + (1 << (n - 1))) >> n) } | - | lo, then a shifted and narrowed as vrshrn_n_s32 does, as the high half
