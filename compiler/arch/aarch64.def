veor3q_u64 | sha3 | (a: uint64x2_t, b: uint64x2_t, c: uint64x2_t) -> uint64x2_t | intr | eor3 <d>.16b, <a>.16b, <b>.16b, <c>.16b | pure commutative | none | lanes.eor3 | r[k] = a[k] ^ b[k] ^ c[k] | - | three-way exclusive or
vbcaxq_s8 | sha3 | (a: int8x16_t, b: int8x16_t, c: int8x16_t) -> int8x16_t | intr | bcax <d>.16b, <a>.16b, <b>.16b, <c>.16b | pure | none | lanes.bcax | r[k] = (a[k] ^ (b[k] & ~c[k])) | - | a ^ (b & ~c), Keccak's chi step
