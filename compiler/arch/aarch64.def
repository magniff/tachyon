vshll_n_u16 | neon | (a: uint16x4_t, n: const 0..=15) -> uint32x4_t | intr | ushll <d>.4s, <a>.4h, #<n> | pure | none | lanes.shll | r[k] = a[k] << n | - | each lane widened, then shifted left by n (n < the lane's bits)
vmovl_s32 | neon | (a: int32x2_t) -> int64x2_t | intr | sshll <d>.2d, <a>.2s, #0 | pure | none | lanes.movl | r[k] = a[k] | - | each lane widened
vmovl_high_s32 | neon | (a: int32x4_t) -> int64x2_t | intr | sshll2 <d>.2d, <a>.4s, #0 | pure | none | lanes.movl | r[k] = a[k + 2] | - | each lane of the high half widened
vshll_n_s32 | neon | (a: int32x2_t, n: const 0..=31) -> int64x2_t | intr | sshll <d>.2d, <a>.2s, #<n> | pure | none | lanes.shll | r[k] = a[k] << n | - | each lane widened, then shifted left by n (n < the lane's bits)
vmovl_u32 | neon | (a: uint32x2_t) -> uint64x2_t | intr | ushll <d>.2d, <a>.2s, #0 | pure | none | lanes.movl | r[k] = a[k] | - | each lane widened
vmovl_high_u32 | neon | (a: uint32x4_t) -> uint64x2_t | intr | ushll2 <d>.2d, <a>.4s, #0 | pure | none | lanes.movl | r[k] = a[k + 2] | - | each lane of the high half widened
vshll_n_u32 | neon | (a: uint32x2_t, n: const 0..=31) -> uint64x2_t | intr | ushll <d>.2d, <a>.2s, #<n> | pure | none | lanes.shll | r[k] = ((a[k] as u64) << (n as u64)) | - | each lane widened, then shifted left by n (n < the lane's bits)

# ---- Narrowing, high halves ----
vmovn_high_s16 | neon | (lo: int8x8_t, a: int16x8_t) -> int8x16_t | intr | xtn2 <d>.16b, <a>.8h | pure tied=lo | none | lanes.movn | r[k] = if k < 8 { lo[k] } else { a[k - 8] } | - | lo, then a narrowed as vmovn_s16 does, as the high half
vmovn_high_u16 | neon | (lo: uint8x8_t, a: uint16x8_t) -> uint8x16_t | intr | xtn2 <d>.16b, <a>.8h | pure tied=lo | none | lanes.movn | r[k] = if k < 8 { lo[k] } else { a[k - 8] } | - | lo, then a narrowed as vmovn_u16 does, as the high half
vmovn_high_s32 | neon | (lo: int16x4_t, a: int32x4_t) -> int16x8_t | intr | xtn2 <d>.8h, <a>.4s | pure tied=lo | none | lanes.movn | r[k] = if k < 4 { lo[k] } else { a[k - 4] } | - | lo, then a narrowed as vmovn_s32 does, as the high half
vmovn_high_u32 | neon | (lo: uint16x4_t, a: uint32x4_t) -> uint16x8_t | intr | xtn2 <d>.8h, <a>.4s | pure tied=lo | none | lanes.movn | r[k] = if k < 4 { lo[k] } else { a[k - 4] } | - | lo, then a narrowed as vmovn_u32 does, as the high half
vmovn_high_s64 | neon | (lo: int32x2_t, a: int64x2_t) -> int32x4_t | intr | xtn2 <d>.4s, <a>.2d | pure tied=lo | none | lanes.movn | r[k] = if k < 2 { lo[k] } else { a[k - 2] } | - | lo, then a narrowed as vmovn_s64 does, as the high half
vmovn_high_u64 | neon | (lo: uint32x2_t, a: uint64x2_t) -> uint32x4_t | intr | xtn2 <d>.4s, <a>.2d | pure tied=lo | none | lanes.movn | r[k] = if k < 2 { lo[k] } else { (a[k - 2] as i64) } | - | lo, then a narrowed as vmovn_u64 does, as the high half
vqmovn_high_s16 | neon | (lo: int8x8_t, a: int16x8_t) -> int8x16_t | intr | sqxtn2 <d>.16b, <a>.8h | pure tied=lo | none | lanes.qmovn | r[k] = if k < 8 { lo[k] } else { clamp(a[k - 8], -128, 127) } | - | lo, then a narrowed as vqmovn_s16 does, as the high half
vqmovn_high_u16 | neon | (lo: uint8x8_t, a: uint16x8_t) -> uint8x16_t | intr | uqxtn2 <d>.16b, <a>.8h | pure tied=lo | none | lanes.qmovn | r[k] = if k < 8 { lo[k] } else { min(a[k - 8], 255) } | - | lo, then a narrowed as vqmovn_u16 does, as the high half
vqmovn_high_s32 | neon | (lo: int16x4_t, a: int32x4_t) -> int16x8_t | intr | sqxtn2 <d>.8h, <a>.4s | pure tied=lo | none | lanes.qmovn | r[k] = if k < 4 { lo[k] } else { clamp(a[k - 4], -32768, 32767) } | - | lo, then a narrowed as vqmovn_s32 does, as the high half
vqmovn_high_u32 | neon | (lo: uint16x4_t, a: uint32x4_t) -> uint16x8_t | intr | uqxtn2 <d>.8h, <a>.4s | pure tied=lo | none | lanes.qmovn | r[k] = if k < 4 { lo[k] } else { min(a[k - 4], 65535) } | - | lo, then a narrowed as vqmovn_u32 does, as the high half
vqmovn_high_s64 | neon | (lo: int32x2_t, a: int64x2_t) -> int32x4_t | intr | sqxtn2 <d>.4s, <a>.2d | pure tied=lo | none | lanes.qmovn | r[k] = if k < 2 { lo[k] } else { clamp(a[k - 2], -2147483648, 2147483647) } | - | lo, then a narrowed as vqmovn_s64 does, as the high half
vqmovn_high_u64 | neon | (lo: uint32x2_t, a: uint64x2_t) -> uint32x4_t | intr | uqxtn2 <d>.4s, <a>.2d | pure tied=lo | none | lanes.qmovn | r[k] = if k < 2 { lo[k] } else { (min(a[k - 2], 4294967295u64) as i64) } | - | lo, then a narrowed as vqmovn_u64 does, as the high half
vqmovun_high_s16 | neon | (lo: uint8x8_t, a: int16x8_t) -> uint8x16_t | intr | sqxtun2 <d>.16b, <a>.8h | pure tied=lo | none | lanes.qmovun | r[k] = if k < 8 { lo[k] } else { clamp(a[k - 8], 0, 255) } | - | lo, then a narrowed as vqmovun_s16 does, as the high half
