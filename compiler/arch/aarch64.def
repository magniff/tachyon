vrshrn_high_n_s64 | neon | (lo: int32x2_t, a: int64x2_t, n: const 1..=32) -> int32x4_t | intr | rshrn2 <d>.4s, <a>.2d, #<n> | pure tied=lo | none | lanes.rshrn | r[k] = if k < 2 { lo[k] } else { ((a[k - 2] + (1 << (n - 1))) >> n) } | - | lo, then a shifted and narrowed as vrshrn_n_s64 does, as the high half
vrshrn_high_n_u64 | neon | (lo: uint32x2_t, a: uint64x2_t, n: const 1..=32) -> uint32x4_t | intr | rshrn2 <d>.4s, <a>.2d, #<n> | pure tied=lo | none | lanes.rshrn | r[k] = if k < 2 { lo[k] } else { (((a[k - 2] >> (n as u64)) + ((a[k - 2] >> ((n - 1) as u64)) & 1u64)) as i64) } | - | lo, then a shifted and narrowed as vrshrn_n_u64 does, as the high half
