# ---- Narrowing ----
vshrn_n_s16 | neon | (a: int16x8_t, n: const 1..=8) -> int8x8_t | intr | shrn <d>.8b, <a>.8h, #<n> | pure | none | lanes.shrn | r[k] = a[k] >> n | - | each lane shifted right by n, narrowed to its low half
vshrn_n_u16 | neon | (a: uint16x8_t, n: const 1..=8) -> uint8x8_t | intr | shrn <d>.8b, <a>.8h, #<n> | pure | none | lanes.shrn | r[k] = a[k] >> n | - | each lane shifted right by n, narrowed to its low half (the NEON movemask: n = 4 gives 4 bits per byte)
vshrn_n_s32 | neon | (a: int32x4_t, n: const 1..=16) -> int16x4_t | intr | shrn <d>.4h, <a>.4s, #<n> | pure | none | lanes.shrn | r[k] = a[k] >> n | - | each lane shifted right by n, narrowed to its low half
vshrn_n_u32 | neon | (a: uint32x4_t, n: const 1..=16) -> uint16x4_t | intr | shrn <d>.4h, <a>.4s, #<n> | pure | none | lanes.shrn | r[k] = a[k] >> n | - | each lane shifted right by n, narrowed to its low half
vshrn_n_s64 | neon | (a: int64x2_t, n: const 1..=32) -> int32x2_t | intr | shrn <d>.2s, <a>.2d, #<n> | pure | none | lanes.shrn | r[k] = a[k] >> n | - | each lane shifted right by n, narrowed to its low half
vshrn_n_u64 | neon | (a: uint64x2_t, n: const 1..=32) -> uint32x2_t | intr | shrn <d>.2s, <a>.2d, #<n> | pure | none | lanes.shrn | r[k] = (a[k] >> (n as u64)) | - | each lane shifted right by n, narrowed to its low half
vrshrn_n_s16 | neon | (a: int16x8_t, n: const 1..=8) -> int8x8_t | intr | rshrn <d>.8b, <a>.8h, #<n> | pure | none | lanes.rshrn | r[k] = (a[k] + (1 << (n - 1))) >> n | - | each lane shifted right by n, rounding, narrowed to its low half
vrshrn_n_u16 | neon | (a: uint16x8_t, n: const 1..=8) -> uint8x8_t | intr | rshrn <d>.8b, <a>.8h, #<n> | pure | none | lanes.rshrn | r[k] = (a[k] + (1 << (n - 1))) >> n | - | each lane shifted right by n, rounding, narrowed to its low half
vrshrn_n_s32 | neon | (a: int32x4_t, n: const 1..=16) -> int16x4_t | intr | rshrn <d>.4h, <a>.4s, #<n> | pure | none | lanes.rshrn | r[k] = (a[k] + (1 << (n - 1))) >> n | - | each lane shifted right by n, rounding, narrowed to its low half
vrshrn_n_u32 | neon | (a: uint32x4_t, n: const 1..=16) -> uint16x4_t | intr | rshrn <d>.4h, <a>.4s, #<n> | pure | none | lanes.rshrn | r[k] = (a[k] + (1 << (n - 1))) >> n | - | each lane shifted right by n, rounding, narrowed to its low half
vrshrn_n_s64 | neon | (a: int64x2_t, n: const 1..=32) -> int32x2_t | intr | rshrn <d>.2s, <a>.2d, #<n> | pure | none | lanes.rshrn | r[k] = (a[k] + (1 << (n - 1))) >> n | - | each lane shifted right by n, rounding, narrowed to its low half
vrshrn_n_u64 | neon | (a: uint64x2_t, n: const 1..=32) -> uint32x2_t | intr | rshrn <d>.2s, <a>.2d, #<n> | pure | none | lanes.rshrn | (a[k] + (1 << (n - 1))) >> n, narrowed (computed without overflow) | - | each lane shifted right by n, rounding, narrowed to its low half
vmovn_s16 | neon | (a: int16x8_t) -> int8x8_t | intr | xtn <d>.8b, <a>.8h | pure | none | lanes.movn | r[k] = a[k] | - | each lane narrowed to its low half
vmovn_u16 | neon | (a: uint16x8_t) -> uint8x8_t | intr | xtn <d>.8b, <a>.8h | pure | none | lanes.movn | r[k] = a[k] | - | each lane narrowed to its low half
vmovn_s32 | neon | (a: int32x4_t) -> int16x4_t | intr | xtn <d>.4h, <a>.4s | pure | none | lanes.movn | r[k] = a[k] | - | each lane narrowed to its low half
vmovn_u32 | neon | (a: uint32x4_t) -> uint16x4_t | intr | xtn <d>.4h, <a>.4s | pure | none | lanes.movn | r[k] = a[k] | - | each lane narrowed to its low half
vmovn_s64 | neon | (a: int64x2_t) -> int32x2_t | intr | xtn <d>.2s, <a>.2d | pure | none | lanes.movn | r[k] = a[k] | - | each lane narrowed to its low half
vmovn_u64 | neon | (a: uint64x2_t) -> uint32x2_t | intr | xtn <d>.2s, <a>.2d | pure | none | lanes.movn | r[k] = ((a[k] as i64)) | - | each lane narrowed to its low half
vqmovn_s16 | neon | (a: int16x8_t) -> int8x8_t | intr | sqxtn <d>.8b, <a>.8h | pure | none | lanes.qmovn | r[k] = (clamp(a[k], -128, 127)) | - | each lane narrowed, saturating
vqmovn_u16 | neon | (a: uint16x8_t) -> uint8x8_t | intr | uqxtn <d>.8b, <a>.8h | pure | none | lanes.qmovn | r[k] = (min(a[k], 255)) | - | each lane narrowed, saturating
vqmovn_s32 | neon | (a: int32x4_t) -> int16x4_t | intr | sqxtn <d>.4h, <a>.4s | pure | none | lanes.qmovn | r[k] = (clamp(a[k], -32768, 32767)) | - | each lane narrowed, saturating
vqmovn_u32 | neon | (a: uint32x4_t) -> uint16x4_t | intr | uqxtn <d>.4h, <a>.4s | pure | none | lanes.qmovn | r[k] = (min(a[k], 65535)) | - | each lane narrowed, saturating
vqmovn_s64 | neon | (a: int64x2_t) -> int32x2_t | intr | sqxtn <d>.2s, <a>.2d | pure | none | lanes.qmovn | r[k] = (clamp(a[k], -2147483648, 2147483647)) | - | each lane narrowed, saturating
vqmovn_u64 | neon | (a: uint64x2_t) -> uint32x2_t | intr | uqxtn <d>.2s, <a>.2d | pure | none | lanes.qmovn | r[k] = min(a[k], 4294967295u64) as i64 | - | each lane narrowed, saturating
vqmovun_s16 | neon | (a: int16x8_t) -> uint8x8_t | intr | sqxtun <d>.8b, <a>.8h | pure | none | lanes.qmovun | r[k] = (clamp(a[k], 0, 255)) | - | each signed lane narrowed to unsigned, saturating
vqmovun_s32 | neon | (a: int32x4_t) -> uint16x4_t | intr | sqxtun <d>.4h, <a>.4s | pure | none | lanes.qmovun | r[k] = (clamp(a[k], 0, 65535)) | - | each signed lane narrowed to unsigned, saturating
vqmovun_s64 | neon | (a: int64x2_t) -> uint32x2_t | intr | sqxtun <d>.2s, <a>.2d | pure | none | lanes.qmovun | r[k] = (clamp(a[k], 0, 4294967295)) | - | each signed lane narrowed to unsigned, saturating
vqshrn_n_s16 | neon | (a: int16x8_t, n: const 1..=8) -> int8x8_t | intr | sqshrn <d>.8b, <a>.8h, #<n> | pure | none | lanes.qshrn | r[k] = (clamp(a[k] >> n, -128, 127)) | - | each lane shifted right by n, narrowed, saturating
vqshrn_n_u16 | neon | (a: uint16x8_t, n: const 1..=8) -> uint8x8_t | intr | uqshrn <d>.8b, <a>.8h, #<n> | pure | none | lanes.qshrn | r[k] = (min(a[k] >> n, 255)) | - | each lane shifted right by n, narrowed, saturating
vqshrn_n_s32 | neon | (a: int32x4_t, n: const 1..=16) -> int16x4_t | intr | sqshrn <d>.4h, <a>.4s, #<n> | pure | none | lanes.qshrn | r[k] = (clamp(a[k] >> n, -32768, 32767)) | - | each lane shifted right by n, narrowed, saturating
vqshrn_n_u32 | neon | (a: uint32x4_t, n: const 1..=16) -> uint16x4_t | intr | uqshrn <d>.4h, <a>.4s, #<n> | pure | none | lanes.qshrn | r[k] = (min(a[k] >> n, 65535)) | - | each lane shifted right by n, narrowed, saturating
vqshrn_n_s64 | neon | (a: int64x2_t, n: const 1..=32) -> int32x2_t | intr | sqshrn <d>.2s, <a>.2d, #<n> | pure | none | lanes.qshrn | r[k] = (clamp(a[k] >> n, -2147483648, 2147483647)) | - | each lane shifted right by n, narrowed, saturating
vqshrn_n_u64 | neon | (a: uint64x2_t, n: const 1..=32) -> uint32x2_t | intr | uqshrn <d>.2s, <a>.2d, #<n> | pure | none | lanes.qshrn | r[k] = min(a[k] >> (n as u64), 4294967295u64) as i64 | - | each lane shifted right by n, narrowed, saturating
vqshrun_n_s16 | neon | (a: int16x8_t, n: const 1..=8) -> uint8x8_t | intr | sqshrun <d>.8b, <a>.8h, #<n> | pure | none | lanes.qshrun | r[k] = (clamp(a[k] >> n, 0, 255)) | - | each signed lane shifted right by n, narrowed to unsigned, saturating
vqshrun_n_s32 | neon | (a: int32x4_t, n: const 1..=16) -> uint16x4_t | intr | sqshrun <d>.4h, <a>.4s, #<n> | pure | none | lanes.qshrun | r[k] = (clamp(a[k] >> n, 0, 65535)) | - | each signed lane shifted right by n, narrowed to unsigned, saturating
vqshrun_n_s64 | neon | (a: int64x2_t, n: const 1..=32) -> uint32x2_t | intr | sqshrun <d>.2s, <a>.2d, #<n> | pure | none | lanes.qshrun | r[k] = (clamp(a[k] >> n, 0, 4294967295)) | - | each signed lane shifted right by n, narrowed to unsigned, saturating

# ---- Permutes ----
vextq_s8 | neon | (a: int8x16_t, b: int8x16_t, n: const 0..=15) -> int8x16_t | intr | ext <d>.16b, <a>.16b, <b>.16b, #<n> | pure | none | perm.ext | r[k] = if k + n < 16 { a[k + n] } else { b[k + n - 16] } | x86_64: _mm_alignr_epi8(b, a, n) | lanes n..n + 16 of a then b
vextq_u8 | neon | (a: uint8x16_t, b: uint8x16_t, n: const 0..=15) -> uint8x16_t | intr | ext <d>.16b, <a>.16b, <b>.16b, #<n> | pure | none | perm.ext | r[k] = if k + n < 16 { a[k + n] } else { b[k + n - 16] } | x86_64: _mm_alignr_epi8(b, a, n) | lanes n..n + 16 of a then b
