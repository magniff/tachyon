// The root of the 0.22 GPU library while it lives outside std
// (docs/design/gpu.md: C2, std submodules loaded on use, is a compiler
// change for later). A program names this file on its command line:
//
//     tachyonc prog.tach lib/root.tach -o prog.o
//     cc prog.o -o prog -framework Metal -framework Foundation -lobjc
//
// and reaches the modules as `objc::...` and `gpu::...` (from 0.22,
// `std::objc` and `std::gpu`). -framework is linked by hand: tachyonc
// does not take it yet (C4).

pub mod objc;
pub mod gpu;
