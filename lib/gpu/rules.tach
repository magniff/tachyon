// The validation rules of std::gpu (docs/design/gpu.md, §2.6). Until
// contracts land (0.18), each public function starts with
// `validate(cond, Rule::X)` statements in exactly this form; A18's
// refactor script turns those leading lines into `requires` clauses.
// A violation is misuse, not a run-time failure: it prints the rule's
// code and text and exits with 101, as a failed contract will.

extern "C" {
    fn exit(status: i32) -> !;
}

#[derive(Eq, Debug, Clone)]
pub enum Rule {
    Usage,
    Align,
    Range,
    Layout,
    Pipeline,
    Format,
    Limits,
    FrameDropped,
    State,
}

impl Rule {
    #[pure]
    pub fn code(self: Rule) -> [u8] {
        match self {
            Rule::Usage => "gpu.usage",
            Rule::Align => "gpu.align",
            Rule::Range => "gpu.range",
            Rule::Layout => "gpu.layout",
            Rule::Pipeline => "gpu.pipeline",
            Rule::Format => "gpu.format",
            Rule::Limits => "gpu.limits",
            Rule::FrameDropped => "gpu.frame_dropped",
            Rule::State => "gpu.state",
        }
    }

    #[pure]
    pub fn text(self: Rule) -> [u8] {
        match self {
            Rule::Usage => "a buffer or texture is used in a way its usage flags do not allow (try: add the usage at creation)",
            Rule::Align => "an offset or size is not aligned: uniform and storage offsets to the device's alignment (dev.align_uniform(n)), copies to 4 bytes, texture rows to 256",
            Rule::Range => "an offset, size or draw range reaches past the end of its buffer or texture",
            Rule::Layout => "a bind group does not match the layout the pipeline expects at that index (try: make it from pipe.bind_layout(i))",
            Rule::Pipeline => "a draw or dispatch needs a pipeline, and a bind group for every group its layout uses",
            Rule::Format => "a format does not fit: render target formats match the pipeline's, storage textures need a storable format",
            Rule::Limits => "a size, count or workgroup dimension exceeds the device's limits",
            Rule::FrameDropped => "a frame from surf.frame() was not presented before the next",
            Rule::State => "the object is used after free, or a buffer is used while mapped",
        }
    }
}

/// Exits with 101 and the rule when cond is false.
pub fn validate(cond: bool, rule: Rule) {
    if !cond {
        fail(rule);
    }
}

fn fail(rule: Rule) -> ! {
    eprintln(f"contract {rule.code()} failed: {rule.text()}");
    // exit is the C library's; the status is a contract failure's
    unsafe { exit(101) }
}
