// std::gpu::metal: the Metal backend (docs/design/gpu.md, §2.8), hal::Api
// for Metal through std::objc and the generated bindings (sys.tach, from
// lib/objc/tables/metal.objc). Becomes compiler/std/gpu/metal.macos.tach
// with C1.
//
// - Buffers are MTLResourceStorageModeShared (Apple silicon: unified
//   memory, a mapped range is the buffer's contents); textures are
//   Private and reached by blits.
// - Commands are encoded straight into Metal's encoders. Command buffers
//   retain what they use (Metal's default), so freeing a resource while
//   the GPU uses it is safe; unretained command buffers with submission
//   tracking are a later optimization (design §2.3).
// - Nothing runs off the main thread (§2.11): the CPU waits with
//   waitUntilCompleted, never a completion handler.
// - Objects Metal returns autoreleased (command buffers, encoders, errors)
//   are retained inside an autorelease pool scoped to the call.

pub mod sys;

use crate::objc;
use crate::gpu::hal::Api;
use crate::gpu::metal::sys;
use crate::gpu::metal::sys::{
    MTLBlitCommandEncoder, MTLBuffer, MTLClearColor, MTLCommandBuffer, MTLCommandQueue,
    MTLCompileOptions, MTLComputeCommandEncoder, MTLComputePipelineState, MTLDepthStencilDescriptor,
    MTLDepthStencilState, MTLDevice, MTLLibrary, MTLOrigin, MTLRegion, MTLRenderCommandEncoder,
    MTLRenderPassDescriptor, MTLRenderPipelineDescriptor, MTLRenderPipelineState,
    MTLSamplerDescriptor, MTLSamplerState, MTLScissorRect, MTLSize, MTLTexture,
    MTLTextureDescriptor, MTLVertexDescriptor, MTLViewport,
};
use crate::gpu::shader::{Binding, BindingType, EntryPoint, ShaderSource};
use crate::gpu::types::{
    AddressMode, BlendFactor, BlendOp, Color, Compare, Cull, Filter, Format, FrontFace, IndexFormat,
    Load, PipelineState, SamplerDesc, StepMode, TextureDesc, TextureUsage, Topology, VertexFormat,
};
use crate::objc::{Id, Ref};
use crate::objc::foundation::{NSArray, NSError};
use std::Buf;

extern "C" {
    fn MTLCreateSystemDefaultDevice() -> *u8;
    fn MTLCopyAllDevices() -> *u8;
    fn memcpy(dst: *u8, src: *u8, n: u64) -> *u8;
}

/// The Metal implementation of hal::Api.
pub struct Metal {}

pub struct Adapter {
    pub dev: Id<MTLDevice>,
}

pub struct Device {
    pub dev: Id<MTLDevice>,
    pub queue: Id<MTLCommandQueue>,
}

pub struct Queue {
    pub q: Id<MTLCommandQueue>,
    pub last: Id<MTLCommandBuffer>,
}

pub struct Buffer {
    pub raw: Id<MTLBuffer>,
    pub ptr: *u8,
    pub size: i64,
}

pub struct Texture {
    pub raw: Id<MTLTexture>,
}

pub struct TextureView {
    pub raw: Id<MTLTexture>,
}

pub struct Sampler {
    pub raw: Id<MTLSamplerState>,
}

pub struct Shader {
    pub lib: Id<MTLLibrary>,
}

pub struct ComputePipeline {
    pub raw: Id<MTLComputePipelineState>,
    pub workgroup: MTLSize,
}

pub struct RenderPipeline {
    pub raw: Id<MTLRenderPipelineState>,
    pub depth: Id<MTLDepthStencilState>,
    pub primitive: u64,
    pub cull: u64,
    pub winding: u64,
}

/// One resource of a bind group, with its slot in each stage (-1: none).
pub struct Bound {
    pub kind: i64,
    pub vs: i64,
    pub fs: i64,
    pub cs: i64,
    pub buf: Ref<MTLBuffer>,
    pub tex: Ref<MTLTexture>,
    pub smp: Ref<MTLSamplerState>,
    pub offset: u64,
}

const BIND_BUFFER: i64 = 0;
const BIND_TEXTURE: i64 = 1;
const BIND_SAMPLER: i64 = 2;
const MAX_BOUND: i64 = 16;

/// A bind group: its resources (retained: the group keeps them alive) and
/// where they go, in a fixed array (no allocation).
pub struct BindGroup {
    pub items: [Bound; 16],
    pub count: i64,
}

pub struct CommandBuffer {
    pub cb: Id<MTLCommandBuffer>,
    pub blit: Id<MTLBlitCommandEncoder>,
}

pub struct ComputeEncoder {
    pub enc: Id<MTLComputeCommandEncoder>,
    pub workgroup: MTLSize,
}

pub struct RenderEncoder {
    pub enc: Id<MTLRenderCommandEncoder>,
    pub primitive: u64,
    pub index: Ref<MTLBuffer>,
    pub index_type: u64,
    pub index_size: i64,
    pub index_offset: i64,
}

pub struct PassDesc {
    pub raw: Id<MTLRenderPassDescriptor>,
}

// ---- conversions ----

#[pure]
pub fn pixel_format(f: Format) -> u64 {
    match f {
        Format::R8Unorm => sys::MTLPixelFormatR8Unorm,
        Format::R8Uint => sys::MTLPixelFormatR8Uint,
        Format::Rg8Unorm => sys::MTLPixelFormatRG8Unorm,
        Format::R16Float => sys::MTLPixelFormatR16Float,
        Format::R32Uint => sys::MTLPixelFormatR32Uint,
        Format::R32Sint => sys::MTLPixelFormatR32Sint,
        Format::R32Float => sys::MTLPixelFormatR32Float,
        Format::Rg16Float => sys::MTLPixelFormatRG16Float,
        Format::Rgba8Unorm => sys::MTLPixelFormatRGBA8Unorm,
        Format::Rgba8UnormSrgb => sys::MTLPixelFormatRGBA8Unorm_sRGB,
        Format::Rgba8Uint => sys::MTLPixelFormatRGBA8Uint,
        Format::Bgra8Unorm => sys::MTLPixelFormatBGRA8Unorm,
        Format::Bgra8UnormSrgb => sys::MTLPixelFormatBGRA8Unorm_sRGB,
        Format::Rg32Float => sys::MTLPixelFormatRG32Float,
        Format::Rgba16Float => sys::MTLPixelFormatRGBA16Float,
        Format::Rgba32Uint => sys::MTLPixelFormatRGBA32Uint,
        Format::Rgba32Float => sys::MTLPixelFormatRGBA32Float,
        Format::Depth32Float => sys::MTLPixelFormatDepth32Float,
    }
}

#[pure]
fn vertex_format(f: VertexFormat) -> u64 {
    match f {
        VertexFormat::Float32 => sys::MTLVertexFormatFloat,
        VertexFormat::Float32x2 => sys::MTLVertexFormatFloat2,
        VertexFormat::Float32x3 => sys::MTLVertexFormatFloat3,
        VertexFormat::Float32x4 => sys::MTLVertexFormatFloat4,
        VertexFormat::Uint32 => sys::MTLVertexFormatUInt,
        VertexFormat::Uint32x2 => sys::MTLVertexFormatUInt2,
        VertexFormat::Uint32x4 => sys::MTLVertexFormatUInt4,
        VertexFormat::Sint32 => sys::MTLVertexFormatInt,
        VertexFormat::Unorm8x4 => sys::MTLVertexFormatUChar4Normalized,
    }
}

#[pure]
fn compare_function(c: Compare) -> u64 {
    match c {
        Compare::Never => sys::MTLCompareFunctionNever,
        Compare::Less => sys::MTLCompareFunctionLess,
        Compare::Equal => sys::MTLCompareFunctionEqual,
        Compare::LessEqual => sys::MTLCompareFunctionLessEqual,
        Compare::Greater => sys::MTLCompareFunctionGreater,
        Compare::NotEqual => sys::MTLCompareFunctionNotEqual,
        Compare::GreaterEqual => sys::MTLCompareFunctionGreaterEqual,
        Compare::Always => sys::MTLCompareFunctionAlways,
    }
}

#[pure]
fn blend_factor(f: BlendFactor) -> u64 {
    match f {
        BlendFactor::Zero => sys::MTLBlendFactorZero,
        BlendFactor::One => sys::MTLBlendFactorOne,
        BlendFactor::Src => sys::MTLBlendFactorSourceColor,
        BlendFactor::OneMinusSrc => sys::MTLBlendFactorOneMinusSourceColor,
        BlendFactor::SrcAlpha => sys::MTLBlendFactorSourceAlpha,
        BlendFactor::OneMinusSrcAlpha => sys::MTLBlendFactorOneMinusSourceAlpha,
        BlendFactor::Dst => sys::MTLBlendFactorDestinationColor,
        BlendFactor::OneMinusDst => sys::MTLBlendFactorOneMinusDestinationColor,
        BlendFactor::DstAlpha => sys::MTLBlendFactorDestinationAlpha,
        BlendFactor::OneMinusDstAlpha => sys::MTLBlendFactorOneMinusDestinationAlpha,
    }
}

#[pure]
fn blend_op(o: BlendOp) -> u64 {
    match o {
        BlendOp::Add => sys::MTLBlendOperationAdd,
        BlendOp::Subtract => sys::MTLBlendOperationSubtract,
        BlendOp::ReverseSubtract => sys::MTLBlendOperationReverseSubtract,
        BlendOp::Min => sys::MTLBlendOperationMin,
        BlendOp::Max => sys::MTLBlendOperationMax,
    }
}

#[pure]
fn filter(f: Filter) -> u64 {
    match f {
        Filter::Nearest => sys::MTLSamplerMinMagFilterNearest,
        Filter::Linear => sys::MTLSamplerMinMagFilterLinear,
    }
}

#[pure]
fn address_mode(a: AddressMode) -> u64 {
    match a {
        AddressMode::ClampToEdge => sys::MTLSamplerAddressModeClampToEdge,
        AddressMode::Repeat => sys::MTLSamplerAddressModeRepeat,
        AddressMode::MirrorRepeat => sys::MTLSamplerAddressModeMirrorRepeat,
    }
}

#[pure]
fn load_action(l: Load) -> u64 {
    match l {
        Load::Clear => sys::MTLLoadActionClear,
        Load::Keep => sys::MTLLoadActionLoad,
        Load::DontCare => sys::MTLLoadActionDontCare,
    }
}

/// The Metal buffer index of vertex buffer `slot` (30 downward, design
/// §2.8, so that they never meet the shader's own buffers).
#[pure]
pub fn vertex_buffer_index(slot: i64) -> u64 {
    (30 - slot) as u64
}

fn size3(x: i64, y: i64, z: i64) -> MTLSize {
    MTLSize { width: x as u64, height: y as u64, depth: z as u64 }
}

fn origin3(x: i64, y: i64, z: i64) -> MTLOrigin {
    MTLOrigin { x: x as u64, y: y as u64, z: z as u64 }
}

fn nil<T>() -> Id<T> {
    // nil is a valid Id: messages to it do nothing, release ignores it
    unsafe { Id::<T>::from_owned_or_nil(0 as *u8) }
}

fn nil_ref<T>() -> Ref<T> {
    // nil is a valid Ref (see nil)
    unsafe { Ref::<T>::from_raw(0 as *u8) }
}

/// Appends an NSError's description (or `what` when there is none). The
/// callers pass the error out-parameter of a Metal call: nil or an
/// autoreleased NSError, alive until their pool is popped.
fn push_error<A: Allocator>(err: *Buf<A>, e: Option<Ref<NSError>>, what: [u8]) {
    match e {
        Some(r) => objc::push_ns_string(err, r.localized_description()),
        None => err.push_str(what),
    }
}

fn function<A: Allocator>(s: *Shader, e: *EntryPoint, err: *Buf<A>) -> Option<Id<sys::MTLFunction>> {
    let mut name = objc::ns_string(e.msl_name);
    let f = s.lib.r().new_function_with_name(name.r());
    name.free();
    if f.is_none() {
        err.push_str("no function '");
        err.push_str(e.msl_name);
        err.push_str("' in the MSL (entry point '");
        err.push_str(e.name);
        err.push_str("')");
    }
    f
}

fn begin_on(q: Ref<MTLCommandQueue>) -> CommandBuffer {
    let cb = objc::pool(|| match q.command_buffer() {
        Some(c) => c.retain(),
        None => nil::<MTLCommandBuffer>(),
    });
    CommandBuffer { cb: cb, blit: nil::<MTLBlitCommandEncoder>() }
}

fn end_blit(cb: *CommandBuffer) {
    if !cb.blit.is_nil() {
        cb.blit.r().end_encoding();
        cb.blit.free();
    }
}

fn blit(cb: *CommandBuffer) -> Ref<MTLBlitCommandEncoder> {
    if cb.blit.is_nil() {
        let raw = cb.cb.r();
        cb.blit = objc::pool(|| match raw.blit_command_encoder() {
            Some(e) => e.retain(),
            None => nil::<MTLBlitCommandEncoder>(),
        });
    }
    cb.blit.r()
}

fn apply_compute(e: Ref<MTLComputeCommandEncoder>, b: *Bound) {
    if b.cs < 0 { return; }
    let slot = b.cs as u64;
    if b.kind == BIND_BUFFER {
        e.set_buffer_offset_at_index(Some(b.buf), b.offset, slot);
    } else if b.kind == BIND_TEXTURE {
        e.set_texture_at_index(Some(b.tex), slot);
    } else {
        e.set_sampler_state_at_index(Some(b.smp), slot);
    }
}

fn apply_render(e: Ref<MTLRenderCommandEncoder>, b: *Bound) {
    if b.kind == BIND_BUFFER {
        if b.vs >= 0 { e.set_vertex_buffer_offset_at_index(Some(b.buf), b.offset, b.vs as u64); }
        if b.fs >= 0 { e.set_fragment_buffer_offset_at_index(Some(b.buf), b.offset, b.fs as u64); }
    } else if b.kind == BIND_TEXTURE {
        if b.vs >= 0 { e.set_vertex_texture_at_index(Some(b.tex), b.vs as u64); }
        if b.fs >= 0 { e.set_fragment_texture_at_index(Some(b.tex), b.fs as u64); }
    } else {
        if b.vs >= 0 { e.set_vertex_sampler_state_at_index(Some(b.smp), b.vs as u64); }
        if b.fs >= 0 { e.set_fragment_sampler_state_at_index(Some(b.smp), b.fs as u64); }
    }
}

fn bound(kind: i64, b: *Binding) -> Bound {
    Bound {
        kind: kind, vs: b.slot_vertex, fs: b.slot_fragment, cs: b.slot_compute,
        buf: nil_ref::<MTLBuffer>(), tex: nil_ref::<MTLTexture>(),
        smp: nil_ref::<MTLSamplerState>(), offset: 0
    }
}

impl Api for Metal {
    type Adapter = Adapter;
    type Device = Device;
    type Queue = Queue;
    type Buffer = Buffer;
    type Texture = Texture;
    type TextureView = TextureView;
    type Sampler = Sampler;
    type Shader = Shader;
    type ComputePipeline = ComputePipeline;
    type RenderPipeline = RenderPipeline;
    type BindGroup = BindGroup;
    type CommandBuffer = CommandBuffer;
    type ComputeEncoder = ComputeEncoder;
    type RenderEncoder = RenderEncoder;
    type PassDesc = PassDesc;

    // ---- adapters and devices ----

    fn adapters(out: *Vec<Adapter>) {
        // MTLCopyAllDevices returns a +1 NSArray of id<MTLDevice>
        let mut all = unsafe { Id::<NSArray>::from_owned_or_nil(MTLCopyAllDevices()) };
        let n = all.r().count();
        for i in 0..n {
            // the array's elements are MTLDevices, kept by the array
            let d = unsafe { all.r().object_at_index(i).cast::<MTLDevice>() };
            out.push(Adapter { dev: d.retain() });
        }
        all.free();
    }

    fn default_adapter() -> Option<Adapter> {
        // MTLCreateSystemDefaultDevice returns a +1 id<MTLDevice> or nil
        match unsafe { Id::<MTLDevice>::from_owned(MTLCreateSystemDefaultDevice()) } {
            Some(d) => Some(Adapter { dev: d }),
            None => None,
        }
    }

    fn adapter_name<A: Allocator>(a: *Adapter, out: *Buf<A>) {
        let d = a.dev.r();
        objc::pool(|| objc::push_ns_string(out, d.name()));
    }

    fn adapter_low_power(a: *Adapter) -> bool {
        a.dev.r().is_low_power()
    }

    fn adapter_free(a: *Adapter) {
        a.dev.free();
    }

    fn open(a: *Adapter) -> Option<(Device, Queue)> {
        let q = match a.dev.r().new_command_queue() {
            Some(q) => q,
            None => return None,
        };
        let dev = Device { dev: a.dev.clone(), queue: q.clone() };
        Some((dev, Queue { q: q, last: nil::<MTLCommandBuffer>() }))
    }

    fn device_free(d: *Device) {
        d.queue.free();
        d.dev.free();
    }

    fn queue_free(q: *Queue) {
        q.last.free();
        q.q.free();
    }

    fn device_wait_idle(d: *Device) {
        // an empty command buffer completes after everything committed
        // before it on the same queue
        let q = d.queue.r();
        objc::pool(|| match q.command_buffer() {
            Some(cb) => {
                cb.commit();
                cb.wait_until_completed();
            }
            None => {}
        });
    }

    // ---- resources ----

    fn create_buffer(d: *Device, size: i64, init: [u8]) -> Option<Buffer> {
        let n = if size < 4 { 4 } else { size };
        let raw = d.dev
            .r()
            .new_buffer_with_length_options(n as u64, sys::MTLResourceStorageModeShared);
        match raw {
            Some(b) => {
                let p = b.r().contents();
                if init.len > 0 {
                    // contents is the buffer's n bytes of shared memory;
                    // init.len <= size is checked by the caller
                    unsafe { memcpy(p, init.ptr, init.len as u64); }
                }
                Some(Buffer { raw: b, ptr: p, size: size })
            }
            None => None,
        }
    }

    fn buffer_bytes(b: *Buffer) -> [u8] {
        // contents is valid for the buffer's size while the buffer lives
        unsafe { b.ptr[0..b.size] }
    }

    fn buffer_free(b: *Buffer) {
        b.raw.free();
        b.ptr = 0 as *u8;
        b.size = 0;
    }

    fn create_texture(d: *Device, desc: *TextureDesc) -> Option<Texture> {
        let mut td = MTLTextureDescriptor::new();
        let t = td.r();
        t.set_texture_type(if desc.layers > 1 { sys::MTLTextureType2DArray }
            else { sys::MTLTextureType2D });
        t.set_pixel_format(pixel_format(desc.format));
        t.set_width(desc.width as u64);
        t.set_height(desc.height as u64);
        t.set_array_length(desc.layers as u64);
        t.set_mipmap_level_count(desc.mips as u64);
        let mut usage: u64 = 0;
        if desc.usage & TextureUsage::TEXTURE_BINDING
            != 0 { usage = usage | sys::MTLTextureUsageShaderRead; }
        if desc.usage & TextureUsage::STORAGE_BINDING
            != 0 {
            usage = usage | sys::MTLTextureUsageShaderRead | sys::MTLTextureUsageShaderWrite;
        }
        if desc.usage & TextureUsage::RENDER_ATTACHMENT
            != 0 { usage = usage | sys::MTLTextureUsageRenderTarget; }
        usage = usage | sys::MTLTextureUsagePixelFormatView;
        t.set_usage(usage);
        t.set_storage_mode(sys::MTLStorageModePrivate);
        let r = d.dev.r().new_texture_with_descriptor(t);
        td.free();
        match r {
            Some(x) => Some(Texture { raw: x }),
            None => None,
        }
    }

    fn texture_free(t: *Texture) {
        t.raw.free();
    }

    fn create_view(t: *Texture, format: Format, same_format: bool) -> Option<TextureView> {
        if same_format {
            return Some(TextureView { raw: t.raw.clone() });
        }
        match t.raw.r().new_texture_view_with_pixel_format(pixel_format(format)) {
            Some(v) => Some(TextureView { raw: v }),
            None => None,
        }
    }

    fn view_free(v: *TextureView) {
        v.raw.free();
    }

    fn create_sampler(d: *Device, desc: *SamplerDesc) -> Option<Sampler> {
        let mut sd = MTLSamplerDescriptor::new();
        let s = sd.r();
        s.set_min_filter(filter(desc.min));
        s.set_mag_filter(filter(desc.mag));
        s.set_mip_filter(if desc.mip == Filter::Linear { sys::MTLSamplerMipFilterLinear }
            else { sys::MTLSamplerMipFilterNearest });
        s.set_s_address_mode(address_mode(desc.address_u));
        s.set_t_address_mode(address_mode(desc.address_v));
        s.set_r_address_mode(address_mode(desc.address_w));
        s.set_lod_min_clamp(desc.lod_min);
        s.set_lod_max_clamp(desc.lod_max);
        s.set_max_anisotropy(desc.anisotropy as u64);
        match desc.compare {
            Some(c) => s.set_compare_function(compare_function(c)),
            None => {}
        }
        let r = d.dev.r().new_sampler_state_with_descriptor(s);
        sd.free();
        match r {
            Some(x) => Some(Sampler { raw: x }),
            None => None,
        }
    }

    fn sampler_free(s: *Sampler) {
        s.raw.free();
    }

    fn create_shader<A: Allocator>(d: *Device, src: *ShaderSource, err: *Buf<A>) -> Option<Shader> {
        let dev = d.dev.r();
        let text = src.msl;
        objc::pool(|| {
            let mut opts = MTLCompileOptions::new();
            opts.r().set_language_version(sys::MTLLanguageVersion3_0);
            let mut source = objc::ns_string(text);
            let mut e: *u8 = 0 as *u8;
            // the error out-parameter is a local; Metal stores an
            // autoreleased NSError (or nothing) there
            let lib = unsafe {
                dev.new_library_with_source_options_error(source.r(), Some(opts.r()), &e as *u8)
            };
            source.free();
            opts.free();
            match lib {
                Some(l) => Some(Shader { lib: l }),
                None => {
                    push_error(err, unsafe { Ref::<NSError>::from_raw_opt(e) },
                        "the MSL did not compile");
                    None
                }
            }
        })
    }

    fn shader_free(s: *Shader) {
        s.lib.free();
    }

    fn create_compute_pipeline<A: Allocator>(d: *Device, s: *Shader, entry: *EntryPoint,
        err: *Buf<A>) -> Option<ComputePipeline> {
        let mut f = match function(s, entry, err) {
            Some(f) => f,
            None => return None,
        };
        let dev = d.dev.r();
        let fr = f.r();
        let wg = size3(entry.workgroup[0], entry.workgroup[1], entry.workgroup[2]);
        let r = objc::pool(|| {
            let mut e: *u8 = 0 as *u8;
            // the error out-parameter is a local (see create_shader)
            match unsafe { dev.new_compute_pipeline_state_with_function_error(fr, &e as *u8) } {
                Some(p) => Some(ComputePipeline { raw: p, workgroup: wg }),
                None => {
                    push_error(err, unsafe { Ref::<NSError>::from_raw_opt(e) },
                        "Metal rejected the compute pipeline");
                    None
                }
            }
        });
        f.free();
        r
    }

    fn compute_pipeline_free(p: *ComputePipeline) {
        p.raw.free();
    }

    fn create_render_pipeline<A: Allocator>(d: *Device, vs: *Shader, vs_entry: *EntryPoint,
        fs: *Shader, fs_entry: *EntryPoint, has_fs: bool, state: *PipelineState,
        err: *Buf<A>) -> Option<RenderPipeline> {
        let mut vf = match function(vs, vs_entry, err) {
            Some(f) => f,
            None => return None,
        };
        let mut ff = nil::<sys::MTLFunction>();
        if has_fs {
            ff = match function(fs, fs_entry, err) {
                Some(f) => f,
                None => {
                    vf.free();
                    return None;
                }
            };
        }
        let mut pd = MTLRenderPipelineDescriptor::new();
        let p = pd.r();
        p.set_vertex_function(Some(vf.r()));
        if has_fs { p.set_fragment_function(Some(ff.r())); }
        let colors = p.color_attachments();
        for i in 0..state.target_count {
            let t = state.targets[i];
            let c = colors.object_at_indexed_subscript(i as u64);
            c.set_pixel_format(pixel_format(t.format));
            c.set_write_mask(t.write_mask as u64);
            match t.blend {
                Some(b) => {
                    c.set_blending_enabled(true);
                    c.set_source_rgb_blend_factor(blend_factor(b.color.src));
                    c.set_destination_rgb_blend_factor(blend_factor(b.color.dst));
                    c.set_rgb_blend_operation(blend_op(b.color.op));
                    c.set_source_alpha_blend_factor(blend_factor(b.alpha.src));
                    c.set_destination_alpha_blend_factor(blend_factor(b.alpha.dst));
                    c.set_alpha_blend_operation(blend_op(b.alpha.op));
                }
                None => c.set_blending_enabled(false),
            }
        }
        let mut vd = MTLVertexDescriptor::new();
        if state.buffer_count > 0 {
            let attrs = vd.r().attributes();
            let layouts = vd.r().layouts();
            for i in 0..state.buffer_count {
                let l = state.buffers[i];
                let index = vertex_buffer_index(i);
                let lay = layouts.object_at_indexed_subscript(index);
                lay.set_stride(l.stride as u64);
                lay.set_step_function(if l.step
                    == StepMode::Instance { sys::MTLVertexStepFunctionPerInstance }
                    else { sys::MTLVertexStepFunctionPerVertex });
                lay.set_step_rate(1);
                for k in 0..l.count {
                    let a = l.attributes[k];
                    let ad = attrs.object_at_indexed_subscript(a.location as u64);
                    ad.set_format(vertex_format(a.format));
                    ad.set_offset(a.offset as u64);
                    ad.set_buffer_index(index);
                }
            }
            p.set_vertex_descriptor(Some(vd.r()));
        }
        let mut depth = nil::<MTLDepthStencilState>();
        match state.depth {
            Some(ds) => {
                p.set_depth_attachment_pixel_format(pixel_format(ds.format));
                let mut dd = MTLDepthStencilDescriptor::new();
                dd.r().set_depth_compare_function(compare_function(ds.compare));
                dd.r().set_depth_write_enabled(ds.write);
                match d.dev.r().new_depth_stencil_state_with_descriptor(dd.r()) {
                    Some(s) => { depth = s; }
                    None => {}
                }
                dd.free();
            }
            None => {}
        }
        let dev = d.dev.r();
        let mut e: *u8 = 0 as *u8;
        let pool = objc::pool_push();
        // the error out-parameter is a local (see create_shader); the
        // NSError stays alive until pool_pop below
        let r = unsafe { dev.new_render_pipeline_state_with_descriptor_error(p, &e as *u8) };
        let out = match r {
            Some(raw) => {
                let primitive = match state.topology {
                    Topology::PointList => sys::MTLPrimitiveTypePoint,
                    Topology::LineList => sys::MTLPrimitiveTypeLine,
                    Topology::LineStrip => sys::MTLPrimitiveTypeLineStrip,
                    Topology::TriangleList => sys::MTLPrimitiveTypeTriangle,
                    Topology::TriangleStrip => sys::MTLPrimitiveTypeTriangleStrip,
                };
                let cull = match state.cull {
                    Cull::None => sys::MTLCullModeNone,
                    Cull::Front => sys::MTLCullModeFront,
                    Cull::Back => sys::MTLCullModeBack,
                };
                // WebGPU's y points up in clip space, as Metal's does:
                // counter-clockwise is the same winding in both
                let winding = if state.front_face
                    == FrontFace::Ccw { sys::MTLWindingCounterClockwise }
                    else { sys::MTLWindingClockwise };
                Some(RenderPipeline {
                    raw: raw, depth: depth, primitive: primitive, cull: cull, winding: winding
                })
            }
            None => {
                push_error(err, unsafe { Ref::<NSError>::from_raw_opt(e) },
                    "Metal rejected the render pipeline");
                depth.free();
                None
            }
        };
        objc::pool_pop(pool);
        vd.free();
        pd.free();
        vf.free();
        ff.free();
        out
    }

    fn render_pipeline_free(p: *RenderPipeline) {
        p.raw.free();
        p.depth.free();
    }

    // ---- bind groups ----

    fn bind_group_new(d: *Device) -> BindGroup {
        let empty = Bound {
            kind: BIND_BUFFER, vs: -1, fs: -1, cs: -1, buf: nil_ref::<MTLBuffer>(),
            tex: nil_ref::<MTLTexture>(), smp: nil_ref::<MTLSamplerState>(), offset: 0
        };
        BindGroup { items: [empty; 16], count: 0 }
    }

    fn bind_group_buffer(g: *BindGroup, b: *Binding, buf: *Buffer, offset: i64, size: i64) {
        let mut x = bound(BIND_BUFFER, b);
        x.buf = buf.raw.r().retain().r();
        x.offset = offset as u64;
        g.items[g.count] = x;
        g.count += 1;
    }

    fn bind_group_texture(g: *BindGroup, b: *Binding, v: *TextureView) {
        let mut x = bound(BIND_TEXTURE, b);
        x.tex = v.raw.r().retain().r();
        g.items[g.count] = x;
        g.count += 1;
    }

    fn bind_group_sampler(g: *BindGroup, b: *Binding, s: *Sampler) {
        let mut x = bound(BIND_SAMPLER, b);
        x.smp = s.raw.r().retain().r();
        g.items[g.count] = x;
        g.count += 1;
    }

    fn bind_group_free(g: *BindGroup) {
        // each resource was retained once when bound
        for i in 0..g.count {
            let x = g.items[i];
            if x.kind == BIND_BUFFER {
                let mut id = unsafe { Id::<MTLBuffer>::from_owned_or_nil(x.buf.ptr) };
                id.free();
            } else if x.kind == BIND_TEXTURE {
                let mut id = unsafe { Id::<MTLTexture>::from_owned_or_nil(x.tex.ptr) };
                id.free();
            } else {
                let mut id = unsafe { Id::<MTLSamplerState>::from_owned_or_nil(x.smp.ptr) };
                id.free();
            }
        }
        g.count = 0;
    }

    // ---- recording ----

    fn begin(d: *Device) -> CommandBuffer {
        begin_on(d.queue.r())
    }

    fn copy_buffer(cb: *CommandBuffer, src: *Buffer, src_offset: i64, dst: *Buffer, dst_offset: i64,
        size: i64) {
        blit(cb).copy_from_buffer_source_offset_to_buffer_destination_offset_size(src.raw.r(),
            src_offset as u64, dst.raw.r(), dst_offset as u64, size as u64);
    }

    fn copy_texture_to_buffer(cb: *CommandBuffer, src: *Texture, layer: i64, x: i64, y: i64, w: i64,
        h: i64, dst: *Buffer, offset: i64, bytes_per_row: i64) {
        blit(cb).copy_texture_to_buffer(src.raw.r(), layer as u64, 0, origin3(x, y, 0),
            size3(w, h, 1), dst.raw.r(), offset as u64, bytes_per_row as u64,
            (bytes_per_row * h) as u64);
    }

    fn copy_buffer_to_texture(cb: *CommandBuffer, src: *Buffer, offset: i64, bytes_per_row: i64,
        dst: *Texture, layer: i64, x: i64, y: i64, w: i64, h: i64) {
        blit(cb).copy_buffer_to_texture(src.raw.r(), offset as u64, bytes_per_row as u64,
            (bytes_per_row * h) as u64, size3(w, h, 1), dst.raw.r(), layer as u64, 0,
            origin3(x, y, 0));
    }

    fn begin_compute(cb: *CommandBuffer) -> ComputeEncoder {
        end_blit(cb);
        let raw = cb.cb.r();
        let e = objc::pool(|| match raw.compute_command_encoder() {
            Some(e) => e.retain(),
            None => nil::<MTLComputeCommandEncoder>(),
        });
        ComputeEncoder { enc: e, workgroup: size3(1, 1, 1) }
    }

    fn compute_set_pipeline(e: *ComputeEncoder, p: *ComputePipeline) {
        e.enc.r().set_compute_pipeline_state(p.raw.r());
        e.workgroup = p.workgroup;
    }

    fn compute_set_bind_group(e: *ComputeEncoder, g: *BindGroup) {
        let enc = e.enc.r();
        for i in 0..g.count {
            apply_compute(enc, &g.items[i]);
        }
    }

    fn dispatch(e: *ComputeEncoder, x: i64, y: i64, z: i64) {
        e.enc.r().dispatch_threadgroups_threads_per_threadgroup(size3(x, y, z), e.workgroup);
    }

    fn end_compute(e: *ComputeEncoder) {
        e.enc.r().end_encoding();
        e.enc.free();
    }

    fn pass_new() -> PassDesc {
        PassDesc { raw: MTLRenderPassDescriptor::new() }
    }

    fn pass_color(p: *PassDesc, i: i64, v: *TextureView, load: Load, clear: Color, store: bool) {
        let a = p.raw.r().color_attachments().object_at_indexed_subscript(i as u64);
        a.set_texture(Some(v.raw.r()));
        a.set_load_action(load_action(load));
        a.set_clear_color(MTLClearColor {
            red: clear.r, green: clear.g, blue: clear.b, alpha: clear.a
        });
        a.set_store_action(if store { sys::MTLStoreActionStore }
            else { sys::MTLStoreActionDontCare });
    }

    fn pass_depth(p: *PassDesc, v: *TextureView, load: Load, clear: f64, store: bool) {
        let a = p.raw.r().depth_attachment();
        a.set_texture(Some(v.raw.r()));
        a.set_load_action(load_action(load));
        a.set_clear_depth(clear);
        a.set_store_action(if store { sys::MTLStoreActionStore }
            else { sys::MTLStoreActionDontCare });
    }

    fn pass_free(p: *PassDesc) {
        p.raw.free();
    }

    fn begin_render(cb: *CommandBuffer, p: *PassDesc) -> RenderEncoder {
        end_blit(cb);
        let raw = cb.cb.r();
        let desc = p.raw.r();
        let e = objc::pool(|| match raw.render_command_encoder_with_descriptor(desc) {
            Some(e) => e.retain(),
            None => nil::<MTLRenderCommandEncoder>(),
        });
        RenderEncoder {
            enc: e, primitive: sys::MTLPrimitiveTypeTriangle, index: nil_ref::<MTLBuffer>(),
            index_type: 0, index_size: 2, index_offset: 0
        }
    }

    fn render_set_pipeline(e: *RenderEncoder, p: *RenderPipeline) {
        let enc = e.enc.r();
        enc.set_render_pipeline_state(p.raw.r());
        enc.set_cull_mode(p.cull);
        enc.set_front_facing_winding(p.winding);
        if !p.depth.is_nil() {
            enc.set_depth_stencil_state(Some(p.depth.r()));
        }
        e.primitive = p.primitive;
    }

    fn render_set_bind_group(e: *RenderEncoder, g: *BindGroup) {
        let enc = e.enc.r();
        for i in 0..g.count {
            apply_render(enc, &g.items[i]);
        }
    }

    fn render_set_vertex_buffer(e: *RenderEncoder, slot: i64, b: *Buffer, offset: i64) {
        e.enc
            .r()
            .set_vertex_buffer_offset_at_index(Some(b.raw.r()), offset as u64,
                vertex_buffer_index(slot));
    }

    fn render_set_index_buffer(e: *RenderEncoder, b: *Buffer, format: IndexFormat, offset: i64) {
        e.index = b.raw.r();
        e.index_type = if format == IndexFormat::Uint32 { sys::MTLIndexTypeUInt32 }
            else { sys::MTLIndexTypeUInt16 };
        e.index_size = format.size();
        e.index_offset = offset;
    }

    fn render_set_viewport(e: *RenderEncoder, x: f32, y: f32, w: f32, h: f32, min_depth: f32,
        max_depth: f32) {
        e.enc
            .r()
            .set_viewport(MTLViewport {
                originX: x as f64, originY: y as f64, width: w as f64, height: h as f64,
                znear: min_depth as f64, zfar: max_depth as f64
            });
    }

    fn render_set_scissor(e: *RenderEncoder, x: i64, y: i64, w: i64, h: i64) {
        e.enc
            .r()
            .set_scissor_rect(MTLScissorRect {
                x: x as u64, y: y as u64, width: w as u64, height: h as u64
            });
    }

    fn render_set_blend_constant(e: *RenderEncoder, c: Color) {
        e.enc
            .r()
            .set_blend_color_red_green_blue_alpha(c.r as f32, c.g as f32, c.b as f32, c.a as f32);
    }

    fn draw(e: *RenderEncoder, first_vertex: i64, vertices: i64, first_instance: i64,
        instances: i64) {
        e.enc
            .r()
            .draw_primitives_vertex_start_vertex_count_instance_count_base_instance(e.primitive,
                first_vertex as u64, vertices as u64, instances as u64, first_instance as u64);
    }

    fn draw_indexed(e: *RenderEncoder, first_index: i64, indices: i64, base_vertex: i64,
        first_instance: i64, instances: i64) {
        let offset = e.index_offset + first_index * e.index_size;
        e.enc.r().draw_indexed_primitives_index_count_index_type_index_buffer_index_buffer_offset_instance_count_base_vertex_base_instance(e.primitive, indices as u64, e.index_type, e.index, offset as u64, instances as u64, base_vertex, first_instance as u64);
    }

    fn end_render(e: *RenderEncoder) {
        e.enc.r().end_encoding();
        e.enc.free();
    }

    // ---- submission ----

    fn submit(q: *Queue, cb: *CommandBuffer) {
        end_blit(cb);
        cb.cb.r().commit();
        q.last.free();
        q.last = cb.cb;
        cb.cb = nil::<MTLCommandBuffer>();
    }

    fn command_buffer_free(cb: *CommandBuffer) {
        end_blit(cb);
        cb.cb.free();
    }

    fn write_buffer(q: *Queue, b: *Buffer, offset: i64, data: [u8]) {
        if data.len == 0 { return; }
        let idle = q.last.is_nil() || q.last.r().status() >= sys::MTLCommandBufferStatusCompleted;
        if idle {
            // no submitted work can be reading the buffer: write its
            // shared memory directly (offset + data.len <= size is checked
            // by the caller)
            unsafe { memcpy(b.ptr[offset..offset + data.len].ptr, data.ptr, data.len as u64); }
            return;
        }
        // in flight: a staging copy, ordered on the queue
        let dev = q.q.r().device();
        let mut staging = match unsafe {
            dev.new_buffer_with_bytes_length_options(data.ptr, data.len as u64,
                sys::MTLResourceStorageModeShared)
        } {
            Some(s) => s,
            None => return,
        };
        let mut cb = begin_on(q.q.r());
        blit(&cb).copy_from_buffer_source_offset_to_buffer_destination_offset_size(staging.r(), 0,
            b.raw.r(), offset as u64, data.len as u64);
        Metal::submit(q, &cb);
        staging.free();
    }

    fn write_texture(q: *Queue, t: *Texture, layer: i64, x: i64, y: i64, w: i64, h: i64, data: [u8],
        bytes_per_row: i64) {
        let dev = q.q.r().device();
        // data holds bytes_per_row * h bytes (checked by the caller)
        let mut staging = match unsafe {
            dev.new_buffer_with_bytes_length_options(data.ptr, data.len as u64,
                sys::MTLResourceStorageModeShared)
        } {
            Some(s) => s,
            None => return,
        };
        let mut cb = begin_on(q.q.r());
        blit(&cb).copy_buffer_to_texture(staging.r(), 0, bytes_per_row as u64,
            (bytes_per_row * h) as u64, size3(w, h, 1), t.raw.r(), layer as u64, 0,
            origin3(x, y, 0));
        Metal::submit(q, &cb);
        staging.free();
    }

    fn queue_wait_idle(q: *Queue) -> bool {
        if q.last.is_nil() { return true; }
        let last = q.last.r();
        last.wait_until_completed();
        last.status() == sys::MTLCommandBufferStatusCompleted
    }
}
