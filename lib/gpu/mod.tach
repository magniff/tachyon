// std::gpu (0.22): GPU compute and rendering, on wgpu's model
// (docs/design/gpu.md, §2). Here as lib/gpu until std grows submodules
// (C2); it moves to compiler/std/gpu/ then.
//
// The objects are wgpu's: Instance, Adapter, Device and Queue, Buffer,
// Texture and TextureView, Sampler, Shader, the pipelines, BindGroup,
// Encoder and Commands, and the passes, which are closure-scoped
// (`enc.compute_pass(|pass| { ... })`). Dispatch is static: the backend is
// the `backend` module below (Metal; Vulkan with C1's OS-specific files).
//
// Today's form (0.16): resources are freed with `free()`, usually
// `defer x.free()`; receivers are `self: *T`; descriptors and bind
// entries hold copies of the handles they name. With 0.17 (A17, `fix
// --values`) each resource gets `impl Drop`, `map_read` returns a view of
// its buffer, passes take `&mut RenderPass`, and descriptors borrow. The
// rules of §2.6 are `validate(cond, Rule::X)` statements at the start of
// each public function: `requires` clauses with 0.18 (A18).
//
// Shaders: `dev.shader(&src)` takes the shader compiler's output for
// Metal (a ShaderSource: MSL text and its reflection). Until the WGSL
// compiler lands (std::gpu::wgsl), programs write both by hand.

pub mod hal;
pub mod metal;
pub mod rules;
pub mod shader;
pub mod types;

use self::metal as backend;

pub use self::rules::{Rule, validate};
pub use self::shader::{Binding, BindingType, EntryPoint, Reflection, ShaderSource, VertexInput};
pub use self::types::{
    AddressMode, Blend, BlendComponent, BlendFactor, BlendOp, BufferUsage, Color, ColorTarget,
    Compare, Cull, DepthState, Filter, Format, FrontFace, IndexFormat, Limits, Load, PipelineState,
    Power, SamplerDesc, ShaderStage, StepMode, TextureDesc, TextureUsage, Topology, VertexAttribute,
    VertexFormat, VertexLayout,
};

use self::hal::Api;
use self::types::{MAX_BIND_GROUPS, MAX_COLOR_TARGETS, MAX_VERTEX_BUFFERS};
use std::{Buf, Range};

extern "C" {
    fn exit(status: i32) -> !;
}

/// The backend of this build.
type B = backend::Metal;

// ---- errors ----

/// What can fail however correct the program is (§2.7). Misuse is a
/// contract failure instead (gpu/rules.tach). Messages are the driver's.
pub enum Error {
    NoAdapter,
    DeviceCreation,
    Shader(Buf),
    Pipeline(Buf),
    Submission,
}

impl Display for Error {
    fn fmt(self: *Error, f: *std::Fmt) {
        match *self {
            Error::NoAdapter => f.str("gpu: no adapter"),
            Error::DeviceCreation => f.str("gpu: the device could not be opened"),
            Error::Shader(m) => {
                f.str("gpu: the shader did not compile: ");
                f.str(m.as_slice());
            }
            Error::Pipeline(m) => {
                f.str("gpu: the pipeline was rejected: ");
                f.str(m.as_slice());
            }
            Error::Submission => f.str("gpu: a submission failed (device lost or out of memory)"),
        }
    }
}

impl Debug for Error {
    fn fmt_debug(self: *Error, f: *std::Fmt) {
        self.fmt(f);
    }
}

impl Error {
    /// Frees the message (Shader and Pipeline errors hold one).
    pub fn free(self: *Error) {
        match *self {
            Error::Shader(m) => {
                let mut b = m;
                b.free();
            }
            Error::Pipeline(m) => {
                let mut b = m;
                b.free();
            }
            _ => {}
        }
        *self = Error::NoAdapter;
    }
}

/// The device ran out of memory where the API returns no Result (buffer,
/// texture, sampler creation): the process ends, as an allocation failure
/// of Gpa does.
fn out_of_memory(what: [u8]) -> ! {
    eprintln(f"gpu: out of device memory ({what})");
    // exit is the C library's
    unsafe { exit(101) }
}

// ---- instance and adapters ----

/// The entry point: holds the allocator the device and its children use
/// for host memory.
pub struct Instance {
    pub gpa: Gpa,
}

impl Instance {
    pub fn new_in(gpa: Gpa) -> Instance {
        crate::objc::init();
        Instance { gpa: gpa }
    }

    /// Every adapter of the system.
    pub fn adapters(self: *Instance) -> Vec<Adapter> {
        let mut raw: Vec<backend::Adapter> = Vec::new_in(self.gpa);
        B::adapters(&raw);
        let mut out: Vec<Adapter> = Vec::new_in(self.gpa);
        for a in raw.iter() {
            out.push(Adapter { raw: a, gpa: self.gpa });
        }
        raw.free();
        out
    }

    /// An adapter, the low-power one when asked and there is one.
    pub fn adapter(self: *Instance, power: Power = Power::High) -> Result<Adapter, Error> {
        if power == Power::Low {
            let mut all = self.adapters();
            let mut found: Option<Adapter> = None;
            for i in 0..all.len() {
                let mut a = all.get(i);
                if found.is_none() && B::adapter_low_power(&a.raw) {
                    found = Some(a);
                } else {
                    a.free();
                }
            }
            all.free();
            if found.is_some() { return Ok(found.unwrap()); }
        }
        match B::default_adapter() {
            Some(a) => Ok(Adapter { raw: a, gpa: self.gpa }),
            None => Err(Error::NoAdapter),
        }
    }
}

pub struct Adapter {
    pub raw: backend::Adapter,
    pub gpa: Gpa,
}

impl Adapter {
    /// The adapter's name ("Apple M5").
    pub fn name_in<A: Allocator>(self: *Adapter, out: *Buf<A>) {
        B::adapter_name(&self.raw, out);
    }

    /// The device and its queue.
    pub fn device(self: *Adapter, limits: Limits = Limits::default()) -> Result<(Device, Queue),
        Error> {
        match B::open(&self.raw) {
            Some((d, q)) => Ok((Device { raw: d, gpa: self.gpa, limits: limits },
                Queue { raw: q })),
            None => Err(Error::DeviceCreation),
        }
    }

    pub fn free(self: *Adapter) {
        B::adapter_free(&self.raw);
    }
}

// ---- the device ----

pub struct Device {
    pub raw: backend::Device,
    pub gpa: Gpa,
    pub limits: Limits,
}

pub struct Queue {
    pub raw: backend::Queue,
}

/// A layout key: the bindings' kinds and slots, so that a bind group made
/// for one pipeline is accepted by another only when their layouts agree.
fn layout_key(entries: [Binding]) -> u64 {
    let mut h: u64 = 0x9e3779b97f4a7c15;
    for b in entries {
        h = std::hash_mix(h, b.binding as u64);
        h = std::hash_mix(h, b.ty as u64);
        h = std::hash_mix(h, b.slot_vertex as u64);
        h = std::hash_mix(h, b.slot_fragment as u64);
        h = std::hash_mix(h, b.slot_compute as u64);
    }
    if h == 0 { 1 } else { h }
}

impl Device {
    pub fn limits(self: *Device) -> Limits {
        self.limits
    }

    /// n rounded up to the uniform buffer offset alignment.
    pub fn align_uniform(self: *Device, n: i64) -> i64 {
        let a = self.limits.min_uniform_buffer_offset_alignment;
        (n + a - 1) / a * a
    }

    /// A buffer of size bytes, zeroed.
    pub fn buffer(self: *Device, size: i64, usage: u32) -> Buffer {
        validate(size >= 0 && size <= self.limits.max_buffer_size, Rule::Limits);
        validate(usage != 0, Rule::Usage);
        match B::create_buffer(&self.raw, size, "") {
            Some(b) => Buffer { raw: b, size: size, usage: usage },
            None => out_of_memory("buffer"),
        }
    }

    /// A buffer holding a copy of bytes.
    pub fn buffer_init(self: *Device, bytes: [u8], usage: u32) -> Buffer {
        validate(bytes.len <= self.limits.max_buffer_size, Rule::Limits);
        validate(usage != 0, Rule::Usage);
        match B::create_buffer(&self.raw, bytes.len, bytes) {
            Some(b) => Buffer { raw: b, size: bytes.len, usage: usage },
            None => out_of_memory("buffer"),
        }
    }

    /// A 2D texture (a 2D array when layers > 1).
    pub fn texture(self: *Device, width: i64, height: i64, format: Format,
        usage: u32 = TextureUsage::TEXTURE_BINDING | TextureUsage::COPY_DST, layers: i64 = 1,
        mips: i64 = 1) -> Texture {
        let lim = self.limits.max_texture_dimension_2d;
        validate(width >= 1 && height >= 1 && width <= lim && height <= lim, Rule::Limits);
        validate(layers >= 1 && layers <= self.limits.max_texture_array_layers && mips >= 1,
            Rule::Limits);
        validate(usage != 0, Rule::Usage);
        validate(usage & TextureUsage::STORAGE_BINDING == 0 || format.is_storable(), Rule::Format);
        let desc = TextureDesc {
            width: width, height: height, layers: layers, mips: mips, format: format, usage: usage
        };
        match B::create_texture(&self.raw, &desc) {
            Some(t) => Texture { raw: t, desc: desc },
            None => out_of_memory("texture"),
        }
    }

    pub fn sampler(self: *Device, desc: *SamplerDesc) -> Sampler {
        validate(desc.anisotropy >= 1 && desc.anisotropy <= 16, Rule::Limits);
        match B::create_sampler(&self.raw, desc) {
            Some(s) => Sampler { raw: s, comparison: desc.compare.is_some() },
            None => out_of_memory("sampler"),
        }
    }

    /// A shader module from the shader compiler's output for this backend
    /// (MSL and its reflection on Metal). The source is copied: it may be
    /// freed once this returns.
    pub fn shader(self: *Device, src: *ShaderSource) -> Result<Shader, Error> {
        let mut err = Buf::new_in(self.gpa);
        match B::create_shader(&self.raw, src, &err) {
            Some(s) => {
                err.free();
                let mut entries: Vec<ShaderEntry> = Vec::new_in(self.gpa);
                for e in src.reflection.entries.iter() {
                    let mut name = Buf::new_in(self.gpa);
                    name.push_str(e.name);
                    let mut msl = Buf::new_in(self.gpa);
                    msl.push_str(e.msl_name);
                    entries.push(ShaderEntry {
                        name: name, msl_name: msl, stage: e.stage, workgroup: e.workgroup
                    });
                }
                let mut bindings: Vec<Binding> = Vec::new_in(self.gpa);
                bindings.extend_from_slice(src.reflection.bindings.as_slice());
                let mut inputs: Vec<VertexInput> = Vec::new_in(self.gpa);
                inputs.extend_from_slice(src.reflection.inputs.as_slice());
                Ok(Shader { raw: s, entries: entries, bindings: bindings, inputs: inputs })
            }
            None => Err(Error::Shader(err)),
        }
    }

    /// A compute pipeline for the entry point `entry` of the shader; its
    /// bind layouts come from the shader's reflection.
    pub fn compute_pipeline(self: *Device, shader: *Shader, entry: [u8]) -> Result<ComputePipeline,
        Error> {
        let e = match shader.entry(entry, ShaderStage::COMPUTE) {
            Some(e) => e,
            None => {
                let mut m = Buf::new_in(self.gpa);
                m.push_fmt(f"no compute entry point '{entry}' in the shader");
                return Err(Error::Pipeline(m));
            }
        };
        let wg = e.workgroup;
        let l = self.limits;
        validate(wg[0] >= 1 && wg[1] >= 1 && wg[2] >= 1, Rule::Limits);
        validate(wg[0] <= l.max_compute_workgroup_size_x && wg[1] <= l.max_compute_workgroup_size_y
            && wg[2] <= l.max_compute_workgroup_size_z, Rule::Limits);
        validate(wg[0] * wg[1] * wg[2] <= l.max_compute_invocations_per_workgroup, Rule::Limits);
        let mut err = Buf::new_in(self.gpa);
        match B::create_compute_pipeline(&self.raw, &shader.raw, &e, &err) {
            Some(p) => {
                err.free();
                let mut out = ComputePipeline { raw: p, layouts: Layouts::new(), workgroup: wg };
                out.layouts.add(shader.bindings.as_slice(), ShaderStage::COMPUTE);
                Ok(out)
            }
            None => Err(Error::Pipeline(err)),
        }
    }

    /// A render pipeline.
    pub fn render_pipeline(self: *Device, desc: *RenderDesc) -> Result<RenderPipeline, Error> {
        let vs = match desc.vertex.entry(desc.vs, ShaderStage::VERTEX) {
            Some(e) => e,
            None => {
                let mut m = Buf::new_in(self.gpa);
                m.push_fmt(f"no vertex entry point '{desc.vs}' in the shader");
                return Err(Error::Pipeline(m));
            }
        };
        let mut fs = vs;
        if desc.has_fs {
            fs = match desc.fragment.entry(desc.fs, ShaderStage::FRAGMENT) {
                Some(e) => e,
                None => {
                    let mut m = Buf::new_in(self.gpa);
                    m.push_fmt(f"no fragment entry point '{desc.fs}' in the shader");
                    return Err(Error::Pipeline(m));
                }
            };
        }
        let st = desc.state;
        validate(st.buffer_count <= self.limits.max_vertex_buffers, Rule::Limits);
        validate(st.target_count >= 0 && st.target_count <= self.limits.max_color_attachments,
            Rule::Limits);
        for i in 0..st.buffer_count {
            let l = st.buffers[i];
            validate(l.stride >= 0 && l.stride % 4 == 0, Rule::Align);
            for k in 0..l.count {
                let a = l.attributes[k];
                validate(a.offset % 4 == 0, Rule::Align);
                validate(a.offset + a.format.size() <= l.stride
                    || (l.stride == 0 && l.step == StepMode::Instance), Rule::Range);
            }
        }
        // every vertex input of the shader is fed by an attribute
        for inp in desc.vertex.inputs.iter() {
            let mut fed = false;
            for i in 0..st.buffer_count {
                let l = st.buffers[i];
                for k in 0..l.count {
                    if l.attributes[k].location == inp.location {
                        fed = true;
                        validate(l.attributes[k].format == inp.format, Rule::Format);
                    }
                }
            }
            validate(fed, Rule::Layout);
        }
        for i in 0..st.target_count {
            validate(!st.targets[i].format.is_depth(), Rule::Format);
        }
        match st.depth {
            Some(d) => validate(d.format.is_depth(), Rule::Format),
            None => {}
        }
        let mut err = Buf::new_in(self.gpa);
        match B::create_render_pipeline(&self.raw, &desc.vertex.raw, &vs, &desc.fragment.raw, &fs,
            desc.has_fs, &st, &err) {
            Some(p) => {
                err.free();
                let mut out = RenderPipeline { raw: p, layouts: Layouts::new(), state: st };
                out.layouts.add(desc.vertex.bindings.as_slice(), ShaderStage::VERTEX);
                if desc.has_fs {
                    out.layouts.add(desc.fragment.bindings.as_slice(), ShaderStage::FRAGMENT);
                }
                Ok(out)
            }
            None => Err(Error::Pipeline(err)),
        }
    }

    /// A bind group for `layout` (from `pipe.bind_layout(i)`): one entry per
    /// binding of the layout, in any order.
    pub fn bind_group(self: *Device, layout: BindLayout, entries: [BindEntry]) -> BindGroup {
        validate(entries.len == layout.count, Rule::Layout);
        let mut g = B::bind_group_new(&self.raw);
        for k in 0..layout.count {
            let b = layout.entries[k];
            let mut found = 0;
            for e in entries {
                if e.binding != b.binding { continue; }
                found += 1;
                match e.res {
                    Resource::Buffer(buf, offset, size) => {
                        validate(b.ty.is_buffer(), Rule::Layout);
                        let need = if b.ty == BindingType::Uniform { BufferUsage::UNIFORM }
                            else { BufferUsage::STORAGE };
                        validate(buf.usage & need != 0, Rule::Usage);
                        let align = if b.ty
                            == BindingType::Uniform {
                            self.limits.min_uniform_buffer_offset_alignment
                        } else { self.limits.min_storage_buffer_offset_alignment };
                        validate(offset % align == 0, Rule::Align);
                        let n = if size < 0 { buf.size - offset } else { size };
                        validate(offset >= 0 && n >= b.min_size && offset + n <= buf.size,
                            Rule::Range);
                        B::bind_group_buffer(&g, &b, &buf.raw, offset, n);
                    }
                    Resource::Texture(v) => {
                        validate(b.ty.is_texture(), Rule::Layout);
                        let need = if b.ty
                            == BindingType::StorageTexture { TextureUsage::STORAGE_BINDING }
                            else { TextureUsage::TEXTURE_BINDING };
                        validate(v.usage & need != 0, Rule::Usage);
                        B::bind_group_texture(&g, &b, &v.raw);
                    }
                    Resource::Sampler(s) => {
                        validate(b.ty.is_sampler(), Rule::Layout);
                        validate(s.comparison == (b.ty == BindingType::ComparisonSampler),
                            Rule::Layout);
                        B::bind_group_sampler(&g, &b, &s.raw);
                    }
                }
            }
            validate(found == 1, Rule::Layout);
        }
        BindGroup { raw: g, key: layout.key }
    }

    /// A command encoder.
    pub fn encoder(self: *Device) -> Encoder {
        Encoder { raw: B::begin(&self.raw), limits: self.limits }
    }

    /// Waits until the GPU has finished everything submitted.
    pub fn wait_idle(self: *Device) {
        B::device_wait_idle(&self.raw);
    }

    pub fn free(self: *Device) {
        B::device_free(&self.raw);
    }
}

impl Queue {
    /// Submits recorded commands; they run after everything submitted
    /// before.
    pub fn submit(self: *Queue, cmds: Commands) {
        let mut c = cmds;
        B::submit(&self.raw, &c.raw);
    }

    /// Writes bytes into buf at offset, before the commands submitted next
    /// run (and after the ones submitted before).
    pub fn write_buffer(self: *Queue, buf: *Buffer, offset: i64, bytes: [u8]) {
        validate(buf.usage & BufferUsage::COPY_DST != 0, Rule::Usage);
        validate(offset % 4 == 0 && bytes.len % 4 == 0, Rule::Align);
        validate(offset >= 0 && offset + bytes.len <= buf.size, Rule::Range);
        B::write_buffer(&self.raw, &buf.raw, offset, bytes);
    }

    /// Writes rows of texels into layer `layer` of tex at (x, y): h rows of
    /// bytes_per_row bytes each, w texels used of each row.
    pub fn write_texture(self: *Queue, tex: *Texture, bytes: [u8], bytes_per_row: i64, x: i64 = 0,
        y: i64 = 0, w: i64 = -1, h: i64 = -1, layer: i64 = 0) {
        let ww = if w < 0 { tex.desc.width - x } else { w };
        let hh = if h < 0 { tex.desc.height - y } else { h };
        validate(tex.desc.usage & TextureUsage::COPY_DST != 0, Rule::Usage);
        validate(x >= 0 && y >= 0 && ww >= 1 && hh >= 1 && x + ww <= tex.desc.width
            && y + hh <= tex.desc.height, Rule::Range);
        validate(layer >= 0 && layer < tex.desc.layers, Rule::Range);
        validate(bytes_per_row >= ww * tex.desc.format.size(), Rule::Range);
        validate(bytes.len >= bytes_per_row * (hh - 1) + ww * tex.desc.format.size(), Rule::Range);
        B::write_texture(&self.raw, &tex.raw, layer, x, y, ww, hh, bytes, bytes_per_row);
    }

    /// Waits until everything submitted has finished.
    pub fn wait_idle(self: *Queue) -> Result<(), Error> {
        if B::queue_wait_idle(&self.raw) { Ok(()) } else { Err(Error::Submission) }
    }

    pub fn free(self: *Queue) {
        B::queue_free(&self.raw);
    }
}

// ---- resources ----

pub struct Buffer {
    pub raw: backend::Buffer,
    pub size: i64,
    pub usage: u32,
}

impl Buffer {
    pub fn size(self: *Buffer) -> i64 {
        self.size
    }

    pub fn usage(self: *Buffer) -> u32 {
        self.usage
    }

    /// The buffer's bytes, once the GPU has finished every submitted
    /// command (it waits): a view of the buffer, valid until it is freed.
    /// 0.17: `#[views(self)]`, so that the buffer cannot be used, submitted
    /// or freed while the view lives.
    pub fn map_read(self: *Buffer, dev: *Device) -> Result<[u8], Error> {
        validate(self.usage & BufferUsage::MAP_READ != 0, Rule::Usage);
        B::device_wait_idle(&dev.raw);
        Ok(B::buffer_bytes(&self.raw))
    }

    /// The buffer's bytes to write, once the GPU has finished with it.
    pub fn map_write(self: *Buffer, dev: *Device) -> Result<[u8], Error> {
        validate(self.usage & BufferUsage::MAP_WRITE != 0, Rule::Usage);
        B::device_wait_idle(&dev.raw);
        Ok(B::buffer_bytes(&self.raw))
    }

    pub fn free(self: *Buffer) {
        B::buffer_free(&self.raw);
        self.size = 0;
        self.usage = 0;
    }
}

pub struct Texture {
    pub raw: backend::Texture,
    pub desc: TextureDesc,
}

impl Texture {
    pub fn width(self: *Texture) -> i64 {
        self.desc.width
    }

    pub fn height(self: *Texture) -> i64 {
        self.desc.height
    }

    pub fn format(self: *Texture) -> Format {
        self.desc.format
    }

    pub fn usage(self: *Texture) -> u32 {
        self.desc.usage
    }

    /// A view of the whole texture (it keeps the texture alive).
    pub fn view(self: *Texture) -> TextureView {
        self.view_as(self.desc.format)
    }

    /// A view reading the texels as another format of the same size
    /// (Rgba8Unorm as Rgba8UnormSrgb).
    pub fn view_as(self: *Texture, format: Format) -> TextureView {
        validate(format.size() == self.desc.format.size()
            && format.is_depth() == self.desc.format.is_depth(), Rule::Format);
        match B::create_view(&self.raw, format, format == self.desc.format) {
            Some(v) => TextureView {
                raw: v, format: format, width: self.desc.width, height: self.desc.height,
                usage: self.desc.usage
            },
            None => out_of_memory("texture view"),
        }
    }

    pub fn free(self: *Texture) {
        B::texture_free(&self.raw);
    }
}

pub struct TextureView {
    pub raw: backend::TextureView,
    pub format: Format,
    pub width: i64,
    pub height: i64,
    pub usage: u32,
}

impl TextureView {
    pub fn free(self: *TextureView) {
        B::view_free(&self.raw);
    }
}

pub struct Sampler {
    pub raw: backend::Sampler,
    pub comparison: bool,
}

impl Sampler {
    pub fn free(self: *Sampler) {
        B::sampler_free(&self.raw);
    }
}

/// An entry point of a Shader, its names copied.
pub struct ShaderEntry {
    pub name: Buf,
    pub msl_name: Buf,
    pub stage: u32,
    pub workgroup: [i64; 3],
}

pub struct Shader {
    pub raw: backend::Shader,
    pub entries: Vec<ShaderEntry>,
    pub bindings: Vec<Binding>,
    pub inputs: Vec<VertexInput>,
}

impl Shader {
    /// The entry point of that name and stage (its names are views of the
    /// shader's copies).
    pub fn entry(self: *Shader, name: [u8], stage: u32) -> Option<EntryPoint> {
        for e in self.entries.iter() {
            if e.name.as_slice() == name && e.stage == stage {
                return Some(EntryPoint {
                    name: e.name.as_slice(), msl_name: e.msl_name.as_slice(), stage: e.stage,
                    workgroup: e.workgroup
                });
            }
        }
        None
    }

    pub fn free(self: *Shader) {
        B::shader_free(&self.raw);
        for e in self.entries.iter() {
            let mut n = e.name;
            n.free();
            let mut m = e.msl_name;
            m.free();
        }
        self.entries.free();
        self.bindings.free();
        self.inputs.free();
    }
}

// ---- bind layouts and groups ----

/// The bindings of one group as a pipeline sees them: plain data, kept in
/// the pipeline (no allocation).
pub struct BindLayout {
    pub group: i64,
    pub entries: [Binding; 16],
    pub count: i64,
    pub key: u64,
}

/// A pipeline's layouts, groups 0..MAX_BIND_GROUPS.
pub struct Layouts {
    pub groups: [BindLayout; 4],
    pub used: i64,
}

impl Layouts {
    fn new() -> Layouts {
        let none = Binding {
            group: 0, binding: 0, ty: BindingType::Uniform, slot_vertex: -1, slot_fragment: -1,
            slot_compute: -1, min_size: 0
        };
        let l = BindLayout { group: 0, entries: [none; 16], count: 0, key: 0 };
        let mut out = Layouts { groups: [l; 4], used: 0 };
        for i in 0..MAX_BIND_GROUPS {
            out.groups[i].group = i;
        }
        out
    }

    /// Adds the bindings a stage uses; a binding seen from two stages is
    /// one entry with both slots.
    fn add(self: *Layouts, bindings: [Binding], stage: u32) {
        for b in bindings {
            if b.visibility() & stage == 0 { continue; }
            validate(b.group >= 0 && b.group < MAX_BIND_GROUPS, Rule::Limits);
            let gi = b.group;
            let mut merged = false;
            for k in 0..self.groups[gi].count {
                let mut e = self.groups[gi].entries[k];
                if e.binding == b.binding {
                    validate(e.ty == b.ty, Rule::Layout);
                    if stage == ShaderStage::VERTEX { e.slot_vertex = b.slot_vertex; }
                    if stage == ShaderStage::FRAGMENT { e.slot_fragment = b.slot_fragment; }
                    if stage == ShaderStage::COMPUTE { e.slot_compute = b.slot_compute; }
                    self.groups[gi].entries[k] = e;
                    merged = true;
                }
            }
            if !merged {
                let n = self.groups[gi].count;
                validate(n < 16, Rule::Limits);
                let mut e = b;
                if stage != ShaderStage::VERTEX { e.slot_vertex = -1; }
                if stage != ShaderStage::FRAGMENT { e.slot_fragment = -1; }
                if stage != ShaderStage::COMPUTE { e.slot_compute = -1; }
                self.groups[gi].entries[n] = e;
                self.groups[gi].count = n + 1;
            }
            if gi + 1 > self.used { self.used = gi + 1; }
        }
        for i in 0..MAX_BIND_GROUPS {
            let n = self.groups[i].count;
            self.groups[i].key = if n == 0 { 0 } else { layout_key(self.groups[i].entries[0..n]) };
        }
    }
}

/// A resource bound at a binding: a buffer range (size -1: to the end), a
/// texture view or a sampler. Holds copies of the handles (0.17: borrows).
pub enum Resource {
    Buffer(Buffer, i64, i64),
    Texture(TextureView),
    Sampler(Sampler),
}

pub struct BindEntry {
    pub binding: i64,
    pub res: Resource,
}

/// The whole of a buffer at `binding`.
pub fn bind(binding: i64, buf: *Buffer) -> BindEntry {
    BindEntry { binding: binding, res: Resource::Buffer(*buf, 0, -1) }
}

/// size bytes of a buffer from offset at `binding`.
pub fn bind_range(binding: i64, buf: *Buffer, offset: i64, size: i64) -> BindEntry {
    BindEntry { binding: binding, res: Resource::Buffer(*buf, offset, size) }
}

pub fn bind_texture(binding: i64, view: *TextureView) -> BindEntry {
    BindEntry { binding: binding, res: Resource::Texture(*view) }
}

pub fn bind_sampler(binding: i64, s: *Sampler) -> BindEntry {
    BindEntry { binding: binding, res: Resource::Sampler(*s) }
}

/// Resources bound together (they are kept alive by the group).
pub struct BindGroup {
    pub raw: backend::BindGroup,
    pub key: u64,
}

impl BindGroup {
    pub fn free(self: *BindGroup) {
        B::bind_group_free(&self.raw);
        self.key = 0;
    }
}

// ---- pipelines ----

pub struct ComputePipeline {
    pub raw: backend::ComputePipeline,
    pub layouts: Layouts,
    pub workgroup: [i64; 3],
}

impl ComputePipeline {
    /// The layout of group i, for `dev.bind_group`.
    pub fn bind_layout(self: *ComputePipeline, i: i64) -> BindLayout {
        validate(i >= 0 && i < MAX_BIND_GROUPS, Rule::Limits);
        self.layouts.groups[i]
    }

    pub fn free(self: *ComputePipeline) {
        B::compute_pipeline_free(&self.raw);
    }
}

pub struct RenderPipeline {
    pub raw: backend::RenderPipeline,
    pub layouts: Layouts,
    pub state: PipelineState,
}

impl RenderPipeline {
    pub fn bind_layout(self: *RenderPipeline, i: i64) -> BindLayout {
        validate(i >= 0 && i < MAX_BIND_GROUPS, Rule::Limits);
        self.layouts.groups[i]
    }

    pub fn free(self: *RenderPipeline) {
        B::render_pipeline_free(&self.raw);
    }
}

/// A render pipeline's description: shaders and entry points, then the
/// fixed-function state (PipelineState) with its builder methods.
pub struct RenderDesc {
    pub vertex: Shader,
    pub vs: [u8],
    pub fragment: Shader,
    pub fs: [u8],
    pub has_fs: bool,
    pub state: PipelineState,
}

impl RenderDesc {
    /// Vertex entry `vs` and fragment entry `fs` of one shader, drawing
    /// into one target of `format`.
    pub fn new(shader: *Shader, vs: [u8], fs: [u8], format: Format) -> RenderDesc {
        RenderDesc {
            vertex: *shader, vs: vs, fragment: *shader, fs: fs, has_fs: true,
            state: PipelineState::new(format)
        }
    }

    /// The fragment stage from another shader.
    pub fn fragment_from(self: *RenderDesc, shader: *Shader, fs: [u8]) {
        self.fragment = *shader;
        self.fs = fs;
        self.has_fs = true;
    }

    /// No fragment stage (depth only).
    pub fn no_fragment(self: *RenderDesc) {
        self.has_fs = false;
        self.state.target_count = 0;
    }

    /// A vertex buffer's layout, at the next slot.
    pub fn vertex_buffer(self: *RenderDesc, layout: VertexLayout) {
        validate(self.state.buffer_count < MAX_VERTEX_BUFFERS, Rule::Limits);
        self.state.buffers[self.state.buffer_count] = layout;
        self.state.buffer_count += 1;
    }

    /// Blending for target i (0: the first).
    pub fn blend(self: *RenderDesc, blend: Blend, target: i64 = 0) {
        validate(target >= 0 && target < self.state.target_count, Rule::Range);
        self.state.targets[target].blend = Some(blend);
    }

    /// Another color target.
    pub fn target(self: *RenderDesc, format: Format) {
        validate(self.state.target_count < MAX_COLOR_TARGETS, Rule::Limits);
        self.state.targets[self.state.target_count] = ColorTarget {
            format: format, blend: None, write_mask: 15
        };
        self.state.target_count += 1;
    }

    pub fn depth(self: *RenderDesc, format: Format = Format::Depth32Float,
        compare: Compare = Compare::Less, write: bool = true) {
        self.state.depth = Some(DepthState { format: format, write: write, compare: compare });
    }

    pub fn topology(self: *RenderDesc, t: Topology) {
        self.state.topology = t;
    }

    pub fn cull(self: *RenderDesc, c: Cull, front: FrontFace = FrontFace::Ccw) {
        self.state.cull = c;
        self.state.front_face = front;
    }
}

// ---- recording ----

pub struct Encoder {
    pub raw: backend::CommandBuffer,
    pub limits: Limits,
}

/// Recorded commands, for `queue.submit`.
pub struct Commands {
    pub raw: backend::CommandBuffer,
}

impl Commands {
    /// Drops commands that will not be submitted.
    pub fn free(self: *Commands) {
        B::command_buffer_free(&self.raw);
    }
}

/// The bind group keys a pass has bound, against a pipeline's layouts.
struct Bindings {
    bound: [u64; 4],
    want: [u64; 4],
    used: i64,
    has_pipeline: bool,
}

impl Bindings {
    fn new() -> Bindings {
        Bindings { bound: [0, 0, 0, 0], want: [0, 0, 0, 0], used: 0, has_pipeline: false }
    }

    fn set_pipeline(self: *Bindings, l: *Layouts) {
        self.has_pipeline = true;
        self.used = l.used;
        for i in 0..MAX_BIND_GROUPS {
            self.want[i] = l.groups[i].key;
        }
    }

    fn set_group(self: *Bindings, i: i64, key: u64) {
        validate(i >= 0 && i < MAX_BIND_GROUPS, Rule::Limits);
        validate(!self.has_pipeline || self.want[i] == 0 || self.want[i] == key, Rule::Layout);
        self.bound[i] = key;
    }

    /// Before a draw or dispatch: a pipeline, and a matching group for each
    /// group it uses.
    fn ready(self: *Bindings) {
        validate(self.has_pipeline, Rule::Pipeline);
        for i in 0..self.used {
            validate(self.want[i] == 0 || self.bound[i] == self.want[i], Rule::Pipeline);
        }
    }
}

pub struct ComputePass {
    raw: backend::ComputeEncoder,
    binds: Bindings,
    max_groups: i64,
}

impl ComputePass {
    pub fn set_pipeline(self: *ComputePass, p: *ComputePipeline) {
        self.binds.set_pipeline(&p.layouts);
        B::compute_set_pipeline(&self.raw, &p.raw);
    }

    pub fn set_bind_group(self: *ComputePass, i: i64, g: *BindGroup) {
        self.binds.set_group(i, g.key);
        B::compute_set_bind_group(&self.raw, &g.raw);
    }

    /// x * y * z workgroups of the pipeline's workgroup size.
    pub fn dispatch(self: *ComputePass, x: i64, y: i64 = 1, z: i64 = 1) {
        self.binds.ready();
        let m = self.max_groups;
        validate(x >= 0 && y >= 0 && z >= 0 && x <= m && y <= m && z <= m, Rule::Limits);
        if x == 0 || y == 0 || z == 0 { return; }
        B::dispatch(&self.raw, x, y, z);
    }
}

/// A color attachment of a render pass.
pub struct ColorAttachment {
    pub view: TextureView,
    pub load: Load,
    pub clear: Color,
    pub store: bool,
}

pub struct DepthAttachment {
    pub view: TextureView,
    pub load: Load,
    pub clear: f64,
    pub store: bool,
}

/// A render pass's attachments: one color target, maybe a depth one
/// (several color targets: 0.22.x).
pub struct PassDesc {
    pub color: ColorAttachment,
    pub depth: Option<DepthAttachment>,
}

impl PassDesc {
    /// One color attachment, cleared to `clear` (or kept: load =
    /// Load::Keep) and stored.
    pub fn color(view: *TextureView, clear: Color = Color::black(), load: Load = Load::Clear) -> PassDesc {
        PassDesc {
            color: ColorAttachment { view: *view, load: load, clear: clear, store: true },
            depth: None
        }
    }

    pub fn with_depth(self: PassDesc, view: *TextureView, clear: f64 = 1.0, store: bool = false) -> PassDesc {
        let mut d = self;
        d.depth = Some(DepthAttachment {
            view: *view, load: Load::Clear, clear: clear, store: store
        });
        d
    }
}

pub struct RenderPass {
    raw: backend::RenderEncoder,
    binds: Bindings,
    formats: [Format; 8],
    format_count: i64,
    depth: Option<Format>,
    width: i64,
    height: i64,
    // per vertex buffer slot: the bytes after its offset (-1: none)
    vertex_bytes: [i64; 8],
    index_bytes: i64,
    index_size: i64,
    strides: [i64; 8],
    steps: [StepMode; 8],
    buffer_count: i64,
}

impl RenderPass {
    pub fn set_pipeline(self: *RenderPass, p: *RenderPipeline) {
        let st = p.state;
        validate(st.target_count == self.format_count, Rule::Format);
        for i in 0..st.target_count {
            validate(st.targets[i].format == self.formats[i], Rule::Format);
        }
        match st.depth {
            Some(d) => validate(self.depth == Some(d.format), Rule::Format),
            None => {}
        }
        self.binds.set_pipeline(&p.layouts);
        self.buffer_count = st.buffer_count;
        for i in 0..st.buffer_count {
            self.strides[i] = st.buffers[i].stride;
            self.steps[i] = st.buffers[i].step;
        }
        B::render_set_pipeline(&self.raw, &p.raw);
    }

    pub fn set_bind_group(self: *RenderPass, i: i64, g: *BindGroup) {
        self.binds.set_group(i, g.key);
        B::render_set_bind_group(&self.raw, &g.raw);
    }

    pub fn set_vertex_buffer(self: *RenderPass, slot: i64, buf: *Buffer, offset: i64 = 0) {
        validate(slot >= 0 && slot < MAX_VERTEX_BUFFERS, Rule::Limits);
        validate(buf.usage & BufferUsage::VERTEX != 0, Rule::Usage);
        validate(offset % 4 == 0, Rule::Align);
        validate(offset >= 0 && offset <= buf.size, Rule::Range);
        self.vertex_bytes[slot] = buf.size - offset;
        B::render_set_vertex_buffer(&self.raw, slot, &buf.raw, offset);
    }

    pub fn set_index_buffer(self: *RenderPass, buf: *Buffer, format: IndexFormat, offset: i64 = 0) {
        validate(buf.usage & BufferUsage::INDEX != 0, Rule::Usage);
        validate(offset % format.size() == 0, Rule::Align);
        validate(offset >= 0 && offset <= buf.size, Rule::Range);
        self.index_bytes = buf.size - offset;
        self.index_size = format.size();
        B::render_set_index_buffer(&self.raw, &buf.raw, format, offset);
    }

    pub fn set_viewport(self: *RenderPass, x: f32, y: f32, w: f32, h: f32, min_depth: f32 = 0.0,
        max_depth: f32 = 1.0) {
        validate(w > 0.0 && h > 0.0 && min_depth >= 0.0 && max_depth <= 1.0
            && min_depth <= max_depth, Rule::Range);
        B::render_set_viewport(&self.raw, x, y, w, h, min_depth, max_depth);
    }

    pub fn set_scissor(self: *RenderPass, x: i64, y: i64, w: i64, h: i64) {
        validate(x >= 0 && y >= 0 && w >= 0 && h >= 0 && x + w <= self.width
            && y + h <= self.height, Rule::Range);
        B::render_set_scissor(&self.raw, x, y, w, h);
    }

    pub fn set_blend_constant(self: *RenderPass, c: Color) {
        B::render_set_blend_constant(&self.raw, c);
    }

    // The vertex buffers cover `vertices` and `instances` (wgpu's check).
    fn check_buffers(self: *RenderPass, vertices: Range<i64>, instances: Range<i64>) {
        for i in 0..self.buffer_count {
            let n = if self.steps[i] == StepMode::Instance { instances.end } else { vertices.end };
            if self.strides[i] == 0 || n == 0 { continue; }
            validate(self.vertex_bytes[i] >= 0, Rule::Pipeline);
            validate(n * self.strides[i] <= self.vertex_bytes[i], Rule::Range);
        }
    }

    /// Draws vertices `vertices` of instances `instances` (`0..3, 0..1`).
    pub fn draw(self: *RenderPass, vertices: Range<i64>, instances: Range<i64>) {
        self.binds.ready();
        validate(vertices.start >= 0 && vertices.start <= vertices.end && instances.start >= 0
            && instances.start <= instances.end, Rule::Range);
        self.check_buffers(Range::<i64> { start: 0, end: vertices.end }, instances);
        if vertices.end == vertices.start || instances.end == instances.start { return; }
        B::draw(&self.raw, vertices.start, vertices.end - vertices.start, instances.start,
            instances.end - instances.start);
    }

    /// Draws indices `indices` of the index buffer, each plus base_vertex.
    pub fn draw_indexed(self: *RenderPass, indices: Range<i64>, base_vertex: i64,
        instances: Range<i64>) {
        self.binds.ready();
        validate(self.index_size > 0, Rule::Pipeline);
        validate(indices.start >= 0 && indices.start <= indices.end && instances.start >= 0
            && instances.start <= instances.end, Rule::Range);
        validate(indices.end * self.index_size <= self.index_bytes, Rule::Range);
        // the vertices the indices reach are not known on the CPU: the
        // shaders' accesses are checked instead (design §2.6)
        self.check_buffers(Range::<i64> { start: 0, end: 0 }, instances);
        if indices.end == indices.start || instances.end == instances.start { return; }
        B::draw_indexed(&self.raw, indices.start, indices.end - indices.start, base_vertex,
            instances.start, instances.end - instances.start);
    }
}

impl Encoder {
    /// Runs f with a compute pass; the pass ends when f returns.
    pub fn compute_pass<F: FnMut(*ComputePass)>(self: *Encoder, mut f: F) {
        let mut pass = ComputePass {
            raw: B::begin_compute(&self.raw), binds: Bindings::new(),
            max_groups: self.limits.max_compute_workgroups_per_dimension
        };
        f(&pass);
        B::end_compute(&pass.raw);
    }

    /// Runs f with a render pass into desc's attachments; the pass ends
    /// when f returns.
    pub fn render_pass<F: FnMut(*RenderPass)>(self: *Encoder, desc: PassDesc, mut f: F) {
        let c = desc.color;
        validate(c.view.usage & TextureUsage::RENDER_ATTACHMENT != 0, Rule::Usage);
        validate(c.view.format.is_renderable() && !c.view.format.is_depth(), Rule::Format);
        let mut p = B::pass_new();
        B::pass_color(&p, 0, &c.view.raw, c.load, c.clear, c.store);
        let mut depth: Option<Format> = None;
        match desc.depth {
            Some(d) => {
                validate(d.view.usage & TextureUsage::RENDER_ATTACHMENT != 0, Rule::Usage);
                validate(d.view.format.is_depth(), Rule::Format);
                validate(d.view.width == c.view.width && d.view.height == c.view.height,
                    Rule::Range);
                B::pass_depth(&p, &d.view.raw, d.load, d.clear, d.store);
                depth = Some(d.view.format);
            }
            None => {}
        }
        let mut formats = [Format::Rgba8Unorm; 8];
        formats[0] = c.view.format;
        let mut pass = RenderPass {
            raw: B::begin_render(&self.raw, &p),
            binds: Bindings::new(),
            formats: formats,
            format_count: 1,
            depth: depth,
            width: c.view.width,
            height: c.view.height,
            vertex_bytes: [-1; 8],
            index_bytes: 0,
            index_size: 0,
            strides: [0; 8],
            steps: [StepMode::Vertex; 8],
            buffer_count: 0,
        };
        B::pass_free(&p);
        f(&pass);
        B::end_render(&pass.raw);
    }

    /// Copies size bytes between buffers.
    pub fn copy_buffer(self: *Encoder, src: *Buffer, src_offset: i64, dst: *Buffer, dst_offset: i64,
        size: i64) {
        validate(src.usage & BufferUsage::COPY_SRC != 0 && dst.usage & BufferUsage::COPY_DST != 0,
            Rule::Usage);
        validate(src_offset % 4 == 0 && dst_offset % 4 == 0 && size % 4 == 0, Rule::Align);
        validate(src_offset >= 0 && dst_offset >= 0 && size >= 0, Rule::Range);
        validate(src_offset + size <= src.size && dst_offset + size <= dst.size, Rule::Range);
        if size == 0 { return; }
        B::copy_buffer(&self.raw, &src.raw, src_offset, &dst.raw, dst_offset, size);
    }

    /// Copies a region of layer `layer` of tex (the whole of it by default)
    /// into buf at offset, rows bytes_per_row apart (a multiple of 256).
    pub fn copy_texture_to_buffer(self: *Encoder, tex: *Texture, buf: *Buffer, bytes_per_row: i64,
        offset: i64 = 0, x: i64 = 0, y: i64 = 0, w: i64 = -1, h: i64 = -1, layer: i64 = 0) {
        let ww = if w < 0 { tex.desc.width - x } else { w };
        let hh = if h < 0 { tex.desc.height - y } else { h };
        validate(tex.desc.usage & TextureUsage::COPY_SRC != 0
            && buf.usage & BufferUsage::COPY_DST != 0, Rule::Usage);
        validate(bytes_per_row % 256 == 0 && offset % tex.desc.format.size() == 0, Rule::Align);
        validate(x >= 0 && y >= 0 && ww >= 1 && hh >= 1 && x + ww <= tex.desc.width
            && y + hh <= tex.desc.height, Rule::Range);
        validate(layer >= 0 && layer < tex.desc.layers, Rule::Range);
        validate(bytes_per_row >= ww * tex.desc.format.size(), Rule::Range);
        validate(offset >= 0
            && offset + bytes_per_row * (hh - 1) + ww * tex.desc.format.size() <= buf.size,
            Rule::Range);
        B::copy_texture_to_buffer(&self.raw, &tex.raw, layer, x, y, ww, hh, &buf.raw, offset,
            bytes_per_row);
    }

    /// Copies rows of buf (bytes_per_row apart, a multiple of 256) into a
    /// region of layer `layer` of tex.
    pub fn copy_buffer_to_texture(self: *Encoder, buf: *Buffer, tex: *Texture, bytes_per_row: i64,
        offset: i64 = 0, x: i64 = 0, y: i64 = 0, w: i64 = -1, h: i64 = -1, layer: i64 = 0) {
        let ww = if w < 0 { tex.desc.width - x } else { w };
        let hh = if h < 0 { tex.desc.height - y } else { h };
        validate(tex.desc.usage & TextureUsage::COPY_DST != 0
            && buf.usage & BufferUsage::COPY_SRC != 0, Rule::Usage);
        validate(bytes_per_row % 256 == 0 && offset % tex.desc.format.size() == 0, Rule::Align);
        validate(x >= 0 && y >= 0 && ww >= 1 && hh >= 1 && x + ww <= tex.desc.width
            && y + hh <= tex.desc.height, Rule::Range);
        validate(layer >= 0 && layer < tex.desc.layers, Rule::Range);
        validate(bytes_per_row >= ww * tex.desc.format.size(), Rule::Range);
        validate(offset >= 0
            && offset + bytes_per_row * (hh - 1) + ww * tex.desc.format.size() <= buf.size,
            Rule::Range);
        B::copy_buffer_to_texture(&self.raw, &buf.raw, offset, bytes_per_row, &tex.raw, layer, x, y,
            ww, hh);
    }

    /// The recorded commands, for `queue.submit`.
    pub fn finish(self: *Encoder) -> Commands {
        Commands { raw: self.raw }
    }
}

// ---- bytes ----

/// The bytes of a slice of f32s (a view of the same memory).
pub fn bytes_of_f32(s: [f32]) -> [u8] {
    // s.len f32s are s.len * 4 readable bytes; u8 has no alignment
    unsafe { (s.ptr as *u8)[0..s.len * 4] }
}

/// The bytes of a slice of u32s (a view of the same memory).
pub fn bytes_of_u32(s: [u32]) -> [u8] {
    // as bytes_of_f32
    unsafe { (s.ptr as *u8)[0..s.len * 4] }
}

/// The bytes of a slice of i32s (a view of the same memory).
pub fn bytes_of_i32(s: [i32]) -> [u8] {
    // as bytes_of_f32
    unsafe { (s.ptr as *u8)[0..s.len * 4] }
}

/// Bytes as f32s (a view): the length must be a multiple of 4 and the
/// memory 4-aligned, as mapped buffers are.
pub fn f32s(b: [u8]) -> [f32] {
    validate(b.len % 4 == 0 && (b.ptr as u64) % 4 == 0, Rule::Align);
    // aligned, and every bit pattern is an f32
    unsafe { (b.ptr as *f32)[0..b.len / 4] }
}

/// Bytes as u32s (a view), as f32s.
pub fn u32s(b: [u8]) -> [u32] {
    validate(b.len % 4 == 0 && (b.ptr as u64) % 4 == 0, Rule::Align);
    // aligned, and every bit pattern is a u32
    unsafe { (b.ptr as *u32)[0..b.len / 4] }
}

/// Bytes as i32s (a view), as f32s.
pub fn i32s(b: [u8]) -> [i32] {
    validate(b.len % 4 == 0 && (b.ptr as u64) % 4 == 0, Rule::Align);
    // aligned, and every bit pattern is an i32
    unsafe { (b.ptr as *i32)[0..b.len / 4] }
}
