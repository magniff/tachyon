// What pipeline creation takes from the shader compiler (docs/design/
// gpu.md, §2.10): the translated text and its reflection. The WGSL
// compiler (std::gpu::wgsl, branch g22-shader) produces a ShaderSource
// for Target::Msl; until it does, tests write the MSL and its reflection
// by hand (tests/gpu/cases). `Device::shader` takes either.
//
// The reflection carries the Metal slots the writer chose, per stage: the
// hal binds what it is told and assumes no numbering rule. The rule the
// MSL writer is expected to follow, so that compatible layouts get the
// same slots: per stage, buffers, textures and samplers each numbered from
// 0 in (group, binding) order over the bindings visible in that stage;
// vertex buffers at 30 downward (vertex buffer i at 30 - i).

use crate::gpu::types::{ShaderStage, VertexFormat};

/// What a binding holds.
#[derive(Eq, Debug, Clone)]
pub enum BindingType {
    Uniform,
    Storage,
    ReadOnlyStorage,
    Texture,
    StorageTexture,
    Sampler,
    ComparisonSampler,
}

impl BindingType {
    #[pure]
    pub fn is_buffer(self: BindingType) -> bool {
        match self {
            BindingType::Uniform | BindingType::Storage | BindingType::ReadOnlyStorage => true,
            _ => false,
        }
    }

    #[pure]
    pub fn is_texture(self: BindingType) -> bool {
        self == BindingType::Texture || self == BindingType::StorageTexture
    }

    #[pure]
    pub fn is_sampler(self: BindingType) -> bool {
        self == BindingType::Sampler || self == BindingType::ComparisonSampler
    }
}

/// One `@group(g) @binding(b)` of a shader, with its Metal slot in each
/// stage (-1: not used there).
#[derive(Eq, Debug, Clone)]
pub struct Binding {
    pub group: i64,
    pub binding: i64,
    pub ty: BindingType,
    pub slot_vertex: i64,
    pub slot_fragment: i64,
    pub slot_compute: i64,
    pub min_size: i64,
}

impl Binding {
    #[pure]
    pub fn visibility(self: *Binding) -> u32 {
        let mut v: u32 = 0;
        if self.slot_vertex >= 0 { v = v | ShaderStage::VERTEX; }
        if self.slot_fragment >= 0 { v = v | ShaderStage::FRAGMENT; }
        if self.slot_compute >= 0 { v = v | ShaderStage::COMPUTE; }
        v
    }
}

/// An entry point: its WGSL name, its name in the MSL text (MSL reserves
/// some, `main` among them), its stage, and a compute entry's workgroup
/// size.
#[derive(Eq)]
pub struct EntryPoint {
    pub name: [u8],
    pub msl_name: [u8],
    pub stage: u32,
    pub workgroup: [i64; 3],
}

/// A vertex entry point's input at `@location(n)`.
#[derive(Eq, Debug, Clone)]
pub struct VertexInput {
    pub location: i64,
    pub format: VertexFormat,
}

/// A translated module's interface.
pub struct Reflection {
    pub entries: Vec<EntryPoint>,
    pub bindings: Vec<Binding>,
    pub inputs: Vec<VertexInput>,
}

impl Reflection {
    pub fn new_in(gpa: Gpa) -> Reflection {
        Reflection {
            entries: Vec::new_in(gpa), bindings: Vec::new_in(gpa), inputs: Vec::new_in(gpa)
        }
    }

    /// A compute entry point with its workgroup size.
    pub fn compute(self: *Reflection, name: [u8], msl_name: [u8], x: i64, y: i64 = 1, z: i64 = 1) {
        self.entries.push(EntryPoint {
            name: name, msl_name: msl_name, stage: ShaderStage::COMPUTE, workgroup: [x, y, z]
        });
    }

    pub fn vertex(self: *Reflection, name: [u8], msl_name: [u8]) {
        self.entries.push(EntryPoint {
            name: name, msl_name: msl_name, stage: ShaderStage::VERTEX, workgroup: [0, 0, 0]
        });
    }

    pub fn fragment(self: *Reflection, name: [u8], msl_name: [u8]) {
        self.entries.push(EntryPoint {
            name: name, msl_name: msl_name, stage: ShaderStage::FRAGMENT, workgroup: [0, 0, 0]
        });
    }

    /// A binding and its slots (-1 where a stage does not use it).
    pub fn bind(self: *Reflection, group: i64, binding: i64, ty: BindingType, vertex: i64 = -1,
        fragment: i64 = -1, compute: i64 = -1, min_size: i64 = 0) {
        self.bindings.push(Binding {
            group: group, binding: binding, ty: ty, slot_vertex: vertex, slot_fragment: fragment,
            slot_compute: compute, min_size: min_size
        });
    }

    pub fn input(self: *Reflection, location: i64, format: VertexFormat) {
        self.inputs.push(VertexInput { location: location, format: format });
    }

    pub fn free(self: *Reflection) {
        self.entries.free();
        self.bindings.free();
        self.inputs.free();
    }
}

/// A module translated for Metal: the MSL text and its reflection (the
/// shader compiler's output for Target::Msl).
pub struct ShaderSource {
    pub msl: [u8],
    pub reflection: Reflection,
}
