// std::objc (0.22): the Objective-C runtime for tachyon programs.
//
// Here as lib/objc until std grows submodules loaded on use (design
// docs/design/gpu.md, C2); it moves to compiler/std/objc/ then, and
// `crate::objc` becomes `std::objc`. A program uses it by naming
// lib/root.tach on its command line (`tachyonc prog.tach lib/root.tach`)
// and linking with `-lobjc` and its frameworks (`cc prog.o -framework
// Foundation -lobjc`): -framework is C4, not in the compiler yet.
//
// - `Id<T>`: an owned (+1) reference to an object of class or protocol T
//   (a zero-sized marker type, so Id<MTLBuffer> and Id<MTLTexture> do not
//   mix). `free()` sends release; `clone()` sends retain.
// - `Ref<T>`: a borrowed (+0) reference: an object some other reference
//   or the current autorelease pool keeps alive. `retain()` makes it an
//   Id<T>.
// - Methods come from tables (lib/objc/tables/*.objc) through
//   tools/objcgen, which checks every line against the runtime's type
//   encodings: no objc_msgSend prototype is written by hand.
//
// 0.17 (fix --values): Id<T> gets `impl Drop` (free's body), `free`
// stays one release as the consuming alias; Ref<T> becomes a view type.

pub mod foundation;

use crate::objc::foundation::{
    NSException, NSExceptionMethods, NSObject, NSObjectMethods, NSString, NSStringMethods,
};
use std::Buf;

extern "C" {
    fn objc_retain(o: *u8) -> *u8;
    fn objc_release(o: *u8);
    fn objc_autoreleasePoolPush() -> *u8;
    fn objc_autoreleasePoolPop(p: *u8);
    fn sel_registerName(name: *u8) -> *u8;
    fn objc_getClass(name: *u8) -> *u8;
    fn strlen(s: *u8) -> u64;
    fn NSSetUncaughtExceptionHandler(h: extern "C" fn(*u8));
}

/// Any object (Objective-C's `id`).
pub struct Object {}

/// An owned reference (+1) to an object of class or protocol T.
pub struct Id<T> {
    pub ptr: *u8,
}

/// A borrowed reference (+0) to an object of class or protocol T.
pub struct Ref<T> {
    pub ptr: *u8,
}

impl<T> Id<T> {
    /// Takes over a +1 reference (a result of the alloc, new, copy or
    /// mutableCopy families); None for nil. The caller promises that p is
    /// nil or a +1 reference to an object of T.
    pub unsafe fn from_owned(p: *u8) -> Option<Id<T>> {
        if p == 0 as *u8 { None } else { Some(Id::<T> { ptr: p }) }
    }

    /// The same, nil kept as a nil Id (messages to nil do nothing and
    /// return 0; release of nil does nothing).
    pub unsafe fn from_owned_or_nil(p: *u8) -> Id<T> {
        Id::<T> { ptr: p }
    }

    /// A borrowed reference to the object, valid while this Id is.
    pub fn r(self: *Id<T>) -> Ref<T> {
        Ref::<T> { ptr: self.ptr }
    }

    pub fn is_nil(self: *Id<T>) -> bool {
        self.ptr == 0 as *u8
    }

    /// Sends release; this copy becomes nil, so a second free does nothing.
    pub fn free(self: *Id<T>) {
        let p = self.ptr;
        self.ptr = 0 as *u8;
        // retain and release are defined for any object pointer and nil;
        // p came from a +1 reference this Id owned.
        if p != 0 as *u8 {
            unsafe { objc_release(p); }
        }
    }

    /// The object's retain count (for tests: Cocoa's own count, which
    /// includes the references the frameworks hold).
    pub fn retain_count(self: *Id<T>) -> u64 {
        self.r().object().retain_count()
    }

    /// Reinterprets the reference as one to U. The caller promises that
    /// the object is of class or protocol U.
    pub unsafe fn cast<U>(self: Id<T>) -> Id<U> {
        Id::<U> { ptr: self.ptr }
    }
}

impl<T> Clone for Id<T> {
    /// Another owned reference to the same object: sends retain.
    fn clone(self: *Id<T>) -> Id<T> {
        // a live (or nil) object pointer owned by self
        if self.ptr != 0 as *u8 {
            unsafe { objc_retain(self.ptr); }
        }
        Id::<T> { ptr: self.ptr }
    }
}

impl<T> Ref<T> {
    /// A borrowed reference to p. The caller promises that p is nil or an
    /// object of T, kept alive while the Ref is used.
    pub unsafe fn from_raw(p: *u8) -> Ref<T> {
        Ref::<T> { ptr: p }
    }

    /// The same, None for nil.
    pub unsafe fn from_raw_opt(p: *u8) -> Option<Ref<T>> {
        if p == 0 as *u8 { None } else { Some(Ref::<T> { ptr: p }) }
    }

    /// An owned reference to the object: sends retain.
    pub fn retain(self: Ref<T>) -> Id<T> {
        // a live (or nil) object pointer
        if self.ptr != 0 as *u8 {
            unsafe { objc_retain(self.ptr); }
        }
        Id::<T> { ptr: self.ptr }
    }

    pub fn is_nil(self: Ref<T>) -> bool {
        self.ptr == 0 as *u8
    }

    /// The object as an NSObject (every class here derives from it).
    pub fn object(self: Ref<T>) -> Ref<NSObject> {
        Ref::<NSObject> { ptr: self.ptr }
    }

    /// The object as an `id`.
    pub fn any(self: Ref<T>) -> Ref<Object> {
        Ref::<Object> { ptr: self.ptr }
    }

    /// Reinterprets the reference as one to U. The caller promises that
    /// the object is of class or protocol U.
    pub unsafe fn cast<U>(self: Ref<T>) -> Ref<U> {
        Ref::<U> { ptr: self.ptr }
    }
}

/// The pointer of an optional reference (nil for None), for the generated
/// bindings' nullable parameters.
pub fn opt_ptr<T>(r: Option<Ref<T>>) -> *u8 {
    match r {
        Some(x) => x.ptr,
        None => 0 as *u8,
    }
}

/// Runs f inside an autorelease pool: the objects autoreleased while it
/// runs are released at its end (closure-scoped push and pop).
pub fn pool<R, F: FnMut() -> R>(mut f: F) -> R {
    // push and pop are balanced here, in one frame
    let p = unsafe { objc_autoreleasePoolPush() };
    let r = f();
    unsafe { objc_autoreleasePoolPop(p); }
    r
}

/// The pool as two calls, for code that cannot be a closure: every
/// `pool_push` must be matched by a `pool_pop` of its result, innermost
/// first.
pub fn pool_push() -> PoolToken {
    PoolToken { p: unsafe { objc_autoreleasePoolPush() } }
}

pub struct PoolToken {
    p: *u8,
}

pub fn pool_pop(t: PoolToken) {
    // t came from pool_push (the caller keeps the nesting)
    unsafe { objc_autoreleasePoolPop(t.p); }
}

/// The selector for a NUL-terminated name (the generated bindings cache
/// theirs in statics). The caller passes a NUL-terminated string.
pub unsafe fn sel(name: *u8) -> *u8 {
    sel_registerName(name)
}

/// The class of that name, or nil.
pub unsafe fn class(name: *u8) -> *u8 {
    objc_getClass(name)
}

/// A new NSString holding a copy of the UTF-8 bytes of s.
pub fn ns_string(s: [u8]) -> Id<NSString> {
    let a = NSString::alloc();
    // initWithBytes:length:encoding: reads s.len bytes at s.ptr
    let r = unsafe {
        NSString::init_with_bytes_length_encoding(a, s.ptr, s.len as u64,
            foundation::NSUTF8StringEncoding)
    };
    match r {
        Some(x) => x,
        None => unsafe { Id::<NSString>::from_owned_or_nil(0 as *u8) },
    }
}

/// The UTF-8 bytes of s (empty for nil): a view, valid while s and the
/// current autorelease pool are.
pub fn ns_bytes(s: Ref<NSString>) -> [u8] {
    if s.is_nil() { return ""; }
    let p = s.utf8_string();
    if p == 0 as *u8 { return ""; }
    // UTF8String is NUL-terminated and lives as long as s and the pool
    unsafe { p[0..strlen(p) as i64] }
}

/// Appends the UTF-8 text of s (nothing for nil) to out.
pub fn push_ns_string<A: Allocator>(out: *Buf<A>, s: Ref<NSString>) {
    out.push_str(ns_bytes(s));
}

extern "C" fn print_uncaught(e: *u8) {
    let ex = unsafe { Ref::<NSException>::from_raw(e) };
    let reason = match ex.reason() {
        Some(r) => ns_bytes(r),
        None => "(no reason)",
    };
    eprintln(f"objc: uncaught exception {ns_bytes(ex.name())}: {reason}");
}

/// Prints an Objective-C exception's name and reason before the process
/// ends (an exception that reaches tachyon frames terminates it: no
/// tachyon frame has a handler; that is a crash, not undefined behaviour).
pub fn init() {
    unsafe { NSSetUncaughtExceptionHandler(print_uncaught); }
}
