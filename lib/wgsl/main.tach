// wgslc: the WGSL shader compiler of docs/design/gpu.md §2.10 (0.22's
// G4-G7), as a command-line program while std has no submodules.
//
//   wgslc check FILE...          the first error of each file, one line each
//   wgslc ir FILE                the IR, as text
//   wgslc msl FILE [-o OUT]      Metal Shading Language 3.0
//   wgslc spv FILE -o OUT        SPIR-V 1.3 (binary)
//   wgslc run FILE JOB           run a compute job on the CPU interpreter
//   wgslc metal-job FILE JOB     the job for tests/wgsl/metalrun (MSL + slots)
//   wgslc bench [-n N] [--target msl|spv|ir] [--no-checks] FILE...
//   wgslc explain CODE           what a wgsl.* diagnostic means
//
// The library is the module tree under this file: lex, front (with expr,
// builtins, entry), ir, bounds, uniformity, msl, spirv, interp, dump,
// translate. With C2 (std submodules) it moves to compiler/std/gpu/wgsl/
// and `translate` becomes `std::gpu::wgsl::translate`.
mod builtins;
mod bounds;
mod dump;
mod entry;
mod explain;
mod expr;
mod front;
mod interp;
mod ir;
mod job;
mod lex;
mod msl;
mod names;
mod spirv;
mod translate;
mod uniformity;

use translate::{
    Options, ShaderError, TARGET_CHECK, TARGET_IR, TARGET_MSL, TARGET_SPIRV, new_error, options,
};

import "stdio.h" as c;
import "string.h" as c;
import "time.h" as c;

fn usage() -> i32 {
    eprintln("usage: wgslc check|ir|msl|spv FILE [-o OUT] | run FILE JOB | metal-job FILE JOB | bench [-n N] [--target msl|spv|ir] [--no-checks] FILE... | explain CODE");
    2
}

// The bytes of a C string (an argv element).
fn arg(argv: **u8, i: i64) -> [u8] { unsafe { argv[i][0..c::strlen(argv[i]) as i64] } }

// The whole file, or None when it cannot be read.
pub fn read_file(path: [u8], gpa: Gpa) -> Option<Buf> {
    let mut cpath = Buf::new_in(gpa);
    defer cpath.free();
    cpath.push_str(path);
    cpath.push(0);
    // stdio: a C boundary
    let f = unsafe { c::fopen(cpath.as_slice().ptr, c"rb") };
    if f == 0 as *c::FILE {
        return None;
    }
    let mut b = Buf::new_in(gpa);
    let mut chunk: [u8; 65536] = [0; 65536];
    loop {
        let n = unsafe { c::fread(&chunk[0], 1, 65536, f) } as i64;
        if n <= 0 {
            break;
        }
        b.push_str(chunk[0..n]);
    }
    unsafe { c::fclose(f) };
    Some(b)
}

pub fn write_file(path: [u8], data: [u8], gpa: Gpa) -> bool {
    let mut cpath = Buf::new_in(gpa);
    defer cpath.free();
    cpath.push_str(path);
    cpath.push(0);
    let f = unsafe { c::fopen(cpath.as_slice().ptr, c"wb") };
    if f == 0 as *c::FILE {
        return false;
    }
    unsafe {
        c::fwrite(data.ptr, 1, data.len as u64, f);
        c::fclose(f);
    }
    true
}

// file:line:col: error CODE: message, then help: when there is one
pub fn print_error(file: [u8], err: *ShaderError) {
    eprintln(f"{file}:{err.line}:{err.col}: error {err.code}: {err.msg.as_slice()}");
    if err.help.len() > 0 {
        eprintln(f"help: {err.help.as_slice()}");
    }
    eprintln(f"try: wgslc explain {err.code}");
}

fn now_ns() -> i64 {
    let mut ts = c::timespec { tv_sec: 0, tv_nsec: 0 };
    // C11's clock (a C boundary)
    unsafe { c::timespec_get(&ts, c::TIME_UTC) };
    ts.tv_sec * 1000000000 + ts.tv_nsec
}

fn translate_file(path: [u8], opts: Options, out: *Buf, gpa: Gpa) -> bool {
    let src = match read_file(path, gpa) {
        Some(b) => b,
        None => {
            eprintln(f"error wgslc.read: cannot read '{path}'");
            return false;
        }
    };
    let mut err = new_error(gpa);
    defer err.free();
    let ok = translate::translate(src.as_slice(), opts, out, &err, gpa);
    if !ok {
        print_error(path, &err);
    }
    ok
}

fn main(argc: i32, argv: **u8, gpa: Gpa) -> i32 {
    if argc < 3 {
        if argc == 2 && arg(argv, 1) == "--help" {
            usage();
            return 0;
        }
        return usage();
    }
    let cmd = arg(argv, 1);
    if cmd == "explain" {
        return explain::explain(arg(argv, 2));
    }
    if cmd == "check" {
        let mut status = 0;
        for i in 2..argc as i64 {
            let mut out = Buf::new_in(gpa);
            defer out.free();
            if !translate_file(arg(argv, i), options(TARGET_CHECK), &out, gpa) {
                status = 1;
            }
        }
        return status as i32;
    }
    if cmd == "ir" || cmd == "msl" || cmd == "spv" {
        let target = if cmd == "ir" { TARGET_IR } else if cmd == "msl" { TARGET_MSL }
            else { TARGET_SPIRV };
        let mut file: [u8] = "";
        let mut outp: [u8] = "";
        let mut opts = options(target);
        let mut i = 2;
        while i < argc as i64 {
            let a = arg(argv, i);
            if a == "-o" && i + 1 < argc as i64 {
                outp = arg(argv, i + 1);
                i += 2;
                continue;
            }
            if a == "--no-checks" {
                opts.no_checks = true;
            } else if a == "--no-prove" {
                opts.prove = false;
            } else {
                file = a;
            }
            i += 1;
        }
        let mut out = Buf::new_in(gpa);
        defer out.free();
        if !translate_file(file, opts, &out, gpa) {
            return 1;
        }
        if outp.len == 0 {
            if target == TARGET_SPIRV {
                eprintln("error wgslc.output: SPIR-V is binary: give '-o FILE'");
                return 2;
            }
            print(out.as_slice());
            return 0;
        }
        if !write_file(outp, out.as_slice(), gpa) {
            eprintln(f"error wgslc.write: cannot write '{outp}'");
            return 1;
        }
        return 0;
    }
    if cmd == "run" || cmd == "metal-job" {
        if argc < 4 {
            return usage();
        }
        return job::command(cmd == "run", arg(argv, 2), arg(argv, 3), gpa);
    }
    if cmd == "bench" {
        return bench(argc, argv, gpa);
    }
    usage()
}

// Translates each file N times; prints the median time per file.
fn bench(argc: i32, argv: **u8, gpa: Gpa) -> i32 {
    let mut n = 200;
    let mut opts = options(TARGET_MSL);
    let mut files: Vec<[u8]> = Vec::new_in(gpa);
    defer files.free();
    let mut i = 2;
    while i < argc as i64 {
        let a = arg(argv, i);
        if a == "-n" && i + 1 < argc as i64 {
            n = parse_int(arg(argv, i + 1)).unwrap_or(200);
            i += 2;
            continue;
        }
        if a == "--target" && i + 1 < argc as i64 {
            let t = arg(argv, i + 1);
            opts.target = if t == "spv" { TARGET_SPIRV } else if t == "ir" { TARGET_CHECK }
                else { TARGET_MSL };
            i += 2;
            continue;
        }
        if a == "--no-checks" {
            opts.no_checks = true;
        } else {
            files.push(a);
        }
        i += 1;
    }
    let mut total = 0;
    for k in 0..files.len() {
        let src = match read_file(files[k], gpa) {
            Some(b) => b,
            None => {
                eprintln(f"error wgslc.read: cannot read '{files[k]}'");
                return 1;
            }
        };
        let mut times: Vec<i64> = Vec::new_in(gpa);
        defer times.free();
        let mut out = Buf::new_in(gpa);
        defer out.free();
        let mut err = new_error(gpa);
        defer err.free();
        let mut bytes = 0;
        for _ in 0..n {
            out.clear();
            let t0 = now_ns();
            if !translate::translate(src.as_slice(), opts, &out, &err, gpa) {
                print_error(files[k], &err);
                return 1;
            }
            times.push(now_ns() - t0);
            bytes = out.len();
        }
        sort(times.as_slice());
        let med = times[times.len() / 2];
        total += med;
        println(
            f"{files[k]}\t{src.len()} bytes in\t{bytes} bytes out\tmedian {med / 1000}.{(med % 1000) / 100} us");
    }
    println(f"total (sum of medians)\t{total / 1000}.{(total % 1000) / 100} us");
    0
}
