// All six comparisons, signed vs unsigned, at every width.
// EXPECT: 101001
// EXPECT: 010101
// EXPECT: 001110
// EXPECT: 010101
// EXPECT: 010101
// EXPECT: 101001
// EXPECT: 101001
extern fn printf(format: *u8, ...) -> i32;

fn row(a: bool, b: bool, c: bool, d: bool, e: bool, f: bool) {
    printf(c"%d%d%d%d%d%d\n", a, b, c, d, e, f);
}

fn main() -> i64 {
    let x: i8 = (0 - 1) as i8;
    let y: i8 = 1;
    row(x < y, x > y, x <= y, x >= y, x == y, x != y);
    let p: u8 = 255;
    let q: u8 = 1;
    row(p < q, p > q, p <= q, p >= q, p == q, p != q);
    let r: i32 = (0 - 5) as i32;
    let s: i32 = (0 - 5) as i32;
    row(r < s, r > s, r <= s, r >= s, r == s, r != s);
    let t: u32 = 4000000000;
    let u: u32 = 5;
    row(t < u, t > u, t <= u, t >= u, t == u, t != u);
    let v: u64 = 0x8000000000000000;
    let w: u64 = 1;
    row(v < w, v > w, v <= w, v >= w, v == w, v != w);
    let m: i64 = 0 - 9223372036854775807;
    let n: i64 = 9223372036854775807;
    row(m < n, m > n, m <= n, m >= n, m == n, m != n);
    let g: i16 = (0 - 300) as i16;
    let h: i16 = 200;
    row(g < h, g > h, g <= h, g >= h, g == h, g != h);
    0
}
