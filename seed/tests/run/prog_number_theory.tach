// Integer square root (Newton), gcd/lcm (Euclid), modular exponentiation
// and the longest Collatz chain below 100000.
// EXPECT: 0 9 31622 4294967295
// EXPECT: 21 23562
// EXPECT: 235042059 24580
// EXPECT: 77031 351
extern fn printf(format: *u8, ...) -> i32;

fn isqrt(n: u64) -> u64 {
    if n < 2 { return n; }
    let mut x = n;
    let mut y = (x + 1) / 2;
    while y < x {
        x = y;
        y = (x + n / x) / 2;
    }
    x
}

fn gcd(a: u64, b: u64) -> u64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn powmod(b: u64, e: u64, m: u64) -> u64 {
    let mut r: u64 = 1;
    let mut base = b % m;
    let mut ex = e;
    while ex != 0 {
        if ex & 1 == 1 { r = r * base % m; }
        base = base * base % m;
        ex >>= 1;
    }
    r
}

fn main() -> i64 {
    printf(c"%lu %lu %lu %lu\n", isqrt(0), isqrt(99), isqrt(1000000007), isqrt(18446744073709551614));
    let a: u64 = 1071;
    let b: u64 = 462;
    printf(c"%lu %lu\n", gcd(a, b), a / gcd(a, b) * b);
    printf(c"%lu %lu\n", powmod(2, 1000000, 1000000007), powmod(3, 200, 65521));
    let mut best: u64 = 0;
    let mut best_len: u64 = 0;
    let mut start: u64 = 1;
    while start < 100000 {
        let mut n = start;
        let mut len: u64 = 1;
        while n != 1 {
            if n % 2 == 0 { n = n / 2; } else { n = 3 * n + 1; }
            len += 1;
        }
        if len > best_len { best_len = len; best = start; }
        start += 1;
    }
    printf(c"%lu %lu\n", best, best_len);
    0
}
