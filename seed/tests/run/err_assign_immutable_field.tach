// Fields and elements of an immutable binding are immutable too.
// ERROR: cannot assign to immutable variable 'p'
// ERROR: cannot assign to immutable variable 'grid'
struct P { x: i64, y: (i64, i64) }
fn main() -> i64 {
    let p = P { x: 1, y: (2, 3) };
    p.y.1 = 4;
    let grid = [[0; 2]; 2];
    grid[1][0] = 5;
    0
}
