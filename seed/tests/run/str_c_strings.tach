// c"..." literals are NUL-terminated *u8 C strings.
// EXPECT: hello, world
// EXPECT: 12 0 119
// EXPECT: 9|3
// EXPECT: []
extern fn printf(format: *u8, ...) -> i32;
extern fn puts(s: *u8) -> i32;
extern fn strlen(s: *u8) -> u64;
extern fn strcmp(a: *u8, b: *u8) -> i32;

fn main() -> i64 {
    let greeting: *u8 = c"hello, world";
    puts(greeting);
    printf(c"%lu %d %d\n", strlen(greeting), strcmp(c"abc", c"abc"), greeting[7] as i32);
    let tab = c"a\tb";
    printf(c"%d|%lu\n", tab[1] as i32, strlen(tab));
    printf(c"[%s]\n", c"");
    0
}
