// `return` from inside nested loops and branches.
// EXPECT: 206 909 -1
extern fn printf(format: *u8, ...) -> i32;

fn find(target: i64) -> i64 {
    let mut i = 0;
    loop {
        let mut j = 0;
        loop {
            if i * j == target { return i * 100 + j; }
            j += 1;
            if j > 9 { break; }
        }
        i += 1;
        if i > 9 { return 0 - 1; }
    }
    0
}

fn main() -> i64 {
    printf(c"%ld %ld %ld\n", find(12), find(81), find(97));
    0
}
