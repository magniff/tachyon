// The example in README.md.
// EXPECT: 27 y
extern fn printf(format: *u8, ...) -> i32;

struct Point { x: i64, y: i64 }

const N: i64 = 10;

fn main() -> i64 {
    let mut sum = 0;
    for i in 0..N {
        if i % 3 == 0 { continue; }
        sum += i;
    }
    let p = Point { x: sum, y: -1 };
    let found = loop {
        if p.x > 20 { break 'y'; }
        break 'n';
    };
    printf(c"%ld %c\n", p.x, found as i32);
    0
}
