// Unsigned and narrow int <-> float conversions.
// EXPECT: 200 4000000000 18446744073709551616 -5
// EXPECT: 3000000000 10000000000000000000 7
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let a: u8 = 200;
    let b: u32 = 4000000000;
    let c: u64 = 18446744073709551615;
    let d: i8 = (0 - 5) as i8;
    printf(c"%.0f %.0f %.0f %.0f\n", a as f64, b as f64, c as f64, d as f64);
    let x: f64 = 3000000000.0;
    let y: f64 = 10000000000000000000.0;
    let z: f32 = 7.5;
    printf(c"%u %lu %d\n", x as u32, y as u64, z as u8);
    0
}
