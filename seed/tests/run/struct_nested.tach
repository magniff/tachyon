// Nested structs: construction, reads and writes at depth.
// EXPECT: 7 -5 200 2.5 99
// EXPECT: 7 123 18 10.0 99
// EXPECT: 0 123
extern fn printf(format: *u8, ...) -> i32;

struct Inner { a: i32, b: u8 }
struct Mid { inner: Inner, scale: f64 }
struct Outer { tag: u16, mid: Mid, tail: i64 }

fn main() -> i64 {
    let mut o = Outer { tag: 7, mid: Mid { inner: Inner { a: 0 - 5, b: 200 }, scale: 2.5 }, tail: 99 };
    printf(c"%d %d %d %.1f %ld\n", o.tag, o.mid.inner.a, o.mid.inner.b, o.mid.scale, o.tail);
    o.mid.inner.b = 17;
    o.mid.scale = o.mid.scale * 4.0;
    o.mid.inner = Inner { a: 123, b: o.mid.inner.b + 1 };
    printf(c"%d %d %d %.1f %ld\n", o.tag, o.mid.inner.a, o.mid.inner.b, o.mid.scale, o.tail);
    let mut m = o.mid;
    m.inner.a = 0;
    printf(c"%d %d\n", m.inner.a, o.mid.inner.a);
    0
}
