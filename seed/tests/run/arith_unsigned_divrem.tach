// Unsigned division and remainder with the top bit set at every width.
// EXPECT: 41 5
// EXPECT: 256 241
// EXPECT: 65535 65531
// EXPECT: 1844674407370955155 7
// EXPECT: 1 3
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let a: u8 = 251;
    let b: u8 = 6;
    printf(c"%d %d\n", a / b, a % b);
    let c: u16 = 65521;
    let d: u16 = 255;
    printf(c"%d %d\n", c / d, c % d);
    let e: u32 = 4294967291;
    let f: u32 = 65536;
    printf(c"%u %u\n", e / f, e % f);
    let g: u64 = 18446744073709551557;
    let h: u64 = 10;
    printf(c"%lu %lu\n", g / h, g % h);
    let k: u64 = 3;
    printf(c"%lu %lu\n", g / (g - k), g % (g - k));
    0
}
