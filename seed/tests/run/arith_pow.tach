// Integer exponentiation (there is no `**` operator): squaring in a loop,
// wrapping like other integer arithmetic.
// EXPECT: 1024 1 1000000000000000000 -8 16
// EXPECT: 7 2401 0
extern fn printf(format: *u8, ...) -> i32;

fn ipow(base: i64, exp: i64) -> i64 {
    let mut result: i64 = 1;
    let mut b = base;
    let mut e = exp;
    while e > 0 {
        if e & 1 == 1 { result *= b; }
        b *= b;
        e >>= 1;
    }
    result
}

fn main() -> i64 {
    let two: i64 = 2;
    let three: i64 = 3;
    let ten: i64 = 10;
    let m: i64 = -2;
    printf(c"%ld %ld %ld %ld %ld\n", ipow(two, 10), ipow(three, 0), ipow(ten, 18), ipow(m, 3), ipow(m, 4));
    let b: i64 = 7;
    printf(c"%ld %ld %ld\n", ipow(b, 1), ipow(b, ipow(2, 2)), ipow(2, 64));
    0
}
