// bool -> int, pointer <-> integer round trips and pointer -> pointer.
// EXPECT: 1 0 1 1
// EXPECT: 102030405060708
// EXPECT: 8 1
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let t = true;
    let f = false;
    printf(c"%d %d %ld %lu\n", t as u8, f as i32, t as i64, t as u64);
    let x: i64 = 0x0102030405060708;
    let p = &x;
    let n = p as u64;
    let q = n as *i64;
    printf(c"%lx\n", *q);
    let bp = p as *u8;
    printf(c"%d %d\n", *bp, *((n + 7) as *u8));
    0
}
