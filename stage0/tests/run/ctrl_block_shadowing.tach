// Block expressions with their own scopes; shadowing ends at the block.
// EXPECT: 1001 111 4
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let x = 1;
    let y = {
        let x = 10;
        let z = { let x = 100; x + 1 };
        x + z
    };
    let x = x + 1000;
    let mut i = 0;
    loop {
        let x = i * 2;
        i += 1;
        if x >= 6 { break; }
    }
    printf(c"%ld %ld %ld\n", x, y, i);
    0
}
