# std's module tree (0.20 P0), as a replayable refactoring.
#
#   target/tachyonc refactor --script docs/design/std020-tree.script
#
# runs on std's files (compiler/std: the script names std's items, so it
# runs with --std-tree compiler/std, then embed.sh), checked once, all or
# nothing, one undo. It moves whole sections (banner groups): `split
# --group-impls` moves an impl block with the items of its group only, so
# each section keeps its text and its title, and index.awk keeps it lazy
# or core as before. The banners it inserts first cut a section where its
# items go to different modules, each heading the part that stays or
# the part a split moves first; their titles are in index.awk's lists
# (lazy where the section they come from was). Sections that are only a
# file's header (flat/collections' Heaps, flat/io's Reading stdin) do not
# move as banners: Heaps stays at std's root. `--reexport` keeps every
# `pub` item at `std::NAME`.
#
# To replay it on a newer std: run it, then `git rm` the files of
# compiler/std/flat/ that hold no item any more (embed.sh and the
# compiler skip a root file that is gone), embed.sh, and same-output. An
# item a newer std added to a section that moves stays at std's root (in
# its flat/ file): add it to the step's --items.

# ---- Cuts ----
edit insert --before std::Eq <<END
// ---- Eq, Ord and Hash (0.9) ----
END
edit insert --before std::sort <<END
// ---- Sorting (0.9) ----
END
edit insert --after std::Into <<END
// ---- Option and Result's adapters (0.15) ----
END
edit insert --after std::Clone <<END
// ---- Hashing and comparing helpers (0.15) ----
END

# ---- Modules ----
refactor split std --into std::ops --items Add,Sub,Mul,Div,Neg --reexport --group-impls --header 'std::ops: the operator traits (0.20: from std.tach).'
refactor split std --into std::iter --items Iterator,Map,Filter,Enumerate,Zip,Take,Range,RangeInclusive,SliceIter,SliceRefIter,HashMapIter,Keys,Values,sort_by --reexport --group-impls --header 'std::iter: the Iterator trait, its adapters and its sources (0.20: from flat/iter.tach).'
refactor split std --into std::slice --items sort,SORT_SMALL,quicksort,insertion_sort,swap_at,swap_raw,heapsort,sift_down,sort_stable_in,sort_stable,sort_stable_by,STABLE_RUN,sort_stable_by_in --reexport --group-impls --header 'std::slice: sorting (0.20: from std.tach).'
refactor split std --into std::collections --items HashMap,SLOT_FREE,SLOT_FULL,SLOT_GONE --reexport --group-impls --header 'std::collections: the hash map (0.20: from std.tach).'
refactor split std::collections --into std::collections::hash_map --items HashMap,SLOT_FREE,SLOT_FULL,SLOT_GONE --reexport --group-impls --header 'std::collections::hash_map: HashMap.'
refactor split std --into std::io --items STDIN_BUF,STDIN_POS,STDIN_LEN,STDIN_BLOCK,stdin_fill,read_line,read_stdin_in --reexport --group-impls --header 'std::io: reading stdin (0.20: from flat/io.tach).'
refactor split std --into std::fmt --items snprintf,strtod,strtof,print,println,print_int,print_cstr,eprint,eprintln,format_in,__fmt_tmp,__fmt_in_end,__buf_fmt,__buf_fmt_end,format,fmt_to_vec,fmt_end_vec,Display,Debug,FMT_LEFT,FMT_RIGHT,FMT_ZERO,FMT_HEX,FMT_UPPER,FMT_BIN,FMT_CHAR,FMT_NUM,FMT_PAD,FMT_CAP,FMT_OUT,FMT_LEN,FMT_FD,FMT_DONE,fmt_flush,fmt_room,fmt_make_room,fmt_fd_room,fmt_lost,fmt_str,fmt_str_fd,fmt_str_buf,fmt_byte,fmt_decimal,Fmt,fmt_spec_decimal,fmt_number_start,fmt_radix,fmt_signed,fmt_pad,fmt_float,fmt_fixed_long,fmt_quoted,debug_list,Interp,FmtSpec,fmt_hole --reexport --group-impls --header 'std::fmt: printing, Display and Debug, and Fmt, the formatter (0.20: from flat/fmt.tach).'
refactor split std --into std::num --items I8_MIN,I8_MAX,I16_MIN,I16_MAX,I32_MIN,I32_MAX,I64_MIN,I64_MAX,U8_MAX,U16_MAX,U32_MAX,U64_MAX,count_ones,leading_zeros,trailing_zeros --reexport --group-impls --header 'std::num: integer limits and bits (0.20: from flat/io.tach).'
refactor split std --into std::convert --items From,Into --reexport --group-impls --header 'std::convert: From and Into (0.20: from flat/convert.tach).'
refactor split std --into std::clone --items Clone --reexport --group-impls --header 'std::clone: the Clone trait (0.20: from flat/clone.tach).'
