// SYNTAX TEST "source.vole" "vole items"
/* A block comment /* that nests */ still a comment */
//                    ^^^^^^^^^^ comment.block.vole comment.block.vole
//                                  ^^^^^ comment.block.vole
use std::Buf;
//  ^^^ entity.name.namespace.vole
//     ^^ punctuation.separator.namespace.vole
import "stdio.h" as c;
// <------ keyword.other.import.vole
//               ^^ keyword.operator.cast.vole
mod util { pub fn twice(x: i64) -> i64 { x * 2 } }
//  ^^^^ entity.name.namespace.vole
//                ^^^^^ entity.name.function.vole

#[repr(C, align(16))]
// <-- meta.attribute.vole
//^^^^ meta.attribute.vole entity.other.attribute-name.vole
//        ^^^^^ entity.other.attribute-name.vole
//              ^^ meta.attribute.vole constant.numeric.integer.vole
#[derive(Debug, Display)]
//              ^^^^^^^ meta.attribute.vole entity.other.attribute-name.vole
#[test]
pub union Bits { i: u32, f: f32 }
//  ^^^^^ storage.type.vole
//        ^^^^ entity.name.type.vole

pub enum Tok { Num(i64), Op(u8), End }
//             ^^^ entity.name.type.vole
type Grid = [[u8; 8]; 8];
//   ^^^^ entity.name.type.alias.vole
type NodeId = distinct i64;
//            ^^^^^^^^ storage.modifier.vole
const LIMIT: i64 = 100;
//    ^^^^^ variable.other.constant.vole
trait Named { fn name(self) -> [u8]; }
//    ^^^^^ entity.name.type.vole

impl Stack {
    fn pop(inout self) -> i64
        requires self.items.len() > 0 else "pop on an empty stack"
//      ^^^^^^^^ keyword.other.contract.vole
//                                    ^^^^ keyword.control.vole
        ensures self.items.len() == old(self.items.len()) - 1
//      ^^^^^^^ keyword.other.contract.vole
//                                  ^^^ variable.language.contract.old.vole
        debug ensures result >= 0
//      ^^^^^ keyword.other.contract.vole
//                    ^^^^^^ variable.language.contract.result.vole
    {
        self.items.pop().unwrap()
    }
}

fn generic<T>(s: [T]) -> Option<T> where T: Display {
//                                 ^^^^^ keyword.other.reserved.vole
//                       ^^^^^^ support.type.std.vole
    let r#type = 1;
//      ^^^^^^ variable.other.raw.vole - storage.type.vole
    let n = parse::<i64>(s)?;
//          ^^^^^ entity.name.function.vole
    rows: for r in 0..3 {
//  ^^^^ entity.name.label.vole
        if r == 1 { continue :rows; }
//                            ^^^^ entity.name.label.vole
        if r == 2 { break :rows; }
//                  ^^^^^ keyword.control.vole
    }
    match o { Some(x) if x > 0 => x, None => 0, _ => -1 }
//            ^^^^ support.constant.variant.vole
//                             ^^ keyword.operator.arrow.fat.vole
//                                              ^ variable.language.wildcard.vole
    assert!(n != 0);
//  ^^^^^^^ entity.name.function.macro.vole
//            ^^ keyword.operator.comparison.vole
    unsafe { *p = x as i64 << 2; }
//  ^^^^^^ storage.modifier.vole
//                         ^^ keyword.operator.bitwise.shift.vole
    defer println("last");
//  ^^^^^ keyword.control.vole
    a && b || !c;
//            ^ keyword.operator.logical.vole
    x <<= 1; y ^= 3; z %= 4;
//    ^^^ keyword.operator.assignment.compound.vole
    crate::util::twice(super::K)
//                     ^^^^^ keyword.other.path.vole
}
