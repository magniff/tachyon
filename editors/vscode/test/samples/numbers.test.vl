// SYNTAX TEST "source.vole" "vole numbers"
fn main() {
    let a = 42;
//          ^^ constant.numeric.integer.vole
    let b = 1_000_000;
//          ^^^^^^^^^ constant.numeric.integer.vole
    let c = 0xff;
//          ^^^^ constant.numeric.hex.vole
    let d = 0b1010_u8;
//          ^^^^^^ constant.numeric.binary.vole
//                ^^^ constant.numeric.binary.vole entity.name.type.numeric.vole
    let e = 255u8;
//          ^^^ constant.numeric.integer.vole - entity.name.type.numeric.vole
//             ^^ constant.numeric.integer.vole entity.name.type.numeric.vole
    let f = 7i32;
//           ^^^ entity.name.type.numeric.vole
    let g = 1.5;
//          ^^^ constant.numeric.float.vole
    let h = 2e10;
//          ^^^^ constant.numeric.float.vole
    let i = 1.5f32;
//          ^^^ constant.numeric.float.vole
//             ^^^ constant.numeric.float.vole entity.name.type.numeric.vole
    let j = 2f64;
//          ^^^^ constant.numeric.float.vole
    let k = 3usize;
//           ^^^^^ entity.name.type.numeric.vole
    let t = pair.0.1;
//               ^^^ - constant.numeric.float.vole
    for x in 0..10 { }
//            ^^ keyword.operator.range.vole
//              ^^ constant.numeric.integer.vole
    for y in 1..=5 { }
//            ^^^ keyword.operator.range.vole
    let v: u8x16 = splat(0);
//         ^^^^^ storage.type.primitive.simd.vole
}
