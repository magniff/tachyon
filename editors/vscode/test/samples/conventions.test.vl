// SYNTAX TEST "source.vole" "vole conventions"
// The parameter conventions (docs/design/conventions.md) and the 0.19 spelling.
struct Counter { n: i64 }

impl Counter {
    fn get(self) -> i64 { self.n }
    fn bump(inout self) { self.n += 1; }
//          ^^^^^ storage.modifier.convention.vole
//                ^^^^ variable.language.self.vole
    fn finish(sink self) -> Report { Report { n: self.n } }
//            ^^^^ storage.modifier.convention.vole
    fn old_get(self: &Counter) -> i64 { self.n }
//                   ^ keyword.operator.access.vole
    fn old_bump(self: &mut Counter) { self.n += 1; }
//                     ^^^ storage.modifier.vole
//     ^^^^^^^^ entity.name.function.vole
}

fn total(v: Vec<i64>) -> i64 { 0 }
//          ^^^ support.type.std.vole
//              ^^^ storage.type.primitive.vole
fn fill(v: inout Vec<i64>, n: i64) { }
//         ^^^^^ storage.modifier.convention.vole
fn keep(store: inout Vec<Buf>, b: sink Buf) { store.push(b); }
//                                ^^^^ storage.modifier.convention.vole
//                                     ^^^ entity.name.type.vole
fn view(x: let [u8]) -> inout V { }
//         ^^^ storage.type.binding.vole
//                      ^^^^^ storage.modifier.convention.vole

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
//  ^^^ storage.type.binding.vole - variable.other.vole
    fill(&v, 4);
//       ^ keyword.operator.access.vole
    inout r = &v;
//  ^^^^^ storage.modifier.convention.vole
    let mut w = 0;
//  ^^^ storage.type.binding.vole
//      ^^^ storage.modifier.vole
    let p = &mut w;
//           ^^^ storage.modifier.vole
    let c = move || w + 1;
//          ^^^^ storage.modifier.vole
}

static var COUNT: i64 = 0;
// <------ storage.modifier.vole
//     ^^^ storage.type.binding.vole
//         ^^^^^ variable.other.constant.vole
static mut OLD: i64 = 0;
//     ^^^ storage.modifier.vole
extern "C" { static var errno: i32; }
// <------ storage.modifier.vole
//     ^^^ string.quoted.double.vole
//                      ^^^^^ variable.other.vole
