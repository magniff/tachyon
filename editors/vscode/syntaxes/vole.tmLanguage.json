{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vole",
  "scopeName": "source.vole",
  "fileTypes": ["vl", "tach"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#raw-identifiers" },
    { "include": "#numbers" },
    { "include": "#labels" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#macros" },
    { "include": "#paths" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#variables" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vole",
          "match": "(//).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.vole" } }
        },
        { "include": "#block-comment" }
      ]
    },
    "block-comment": {
      "name": "comment.block.vole",
      "begin": "/\\*",
      "end": "\\*/",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.vole" } },
      "endCaptures": { "0": { "name": "punctuation.definition.comment.end.vole" } },
      "patterns": [{ "include": "#block-comment" }]
    },

    "attributes": {
      "name": "meta.attribute.vole",
      "begin": "(#)(!?)(\\[)",
      "end": "\\]",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.attribute.vole" },
        "2": { "name": "punctuation.definition.attribute.inner.vole" },
        "3": { "name": "punctuation.definition.attribute.begin.vole" }
      },
      "endCaptures": { "0": { "name": "punctuation.definition.attribute.end.vole" } },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#attribute-parens" },
        {
          "name": "entity.other.attribute-name.vole",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        { "name": "keyword.operator.assignment.vole", "match": "=" },
        { "name": "punctuation.separator.comma.vole", "match": "," }
      ]
    },
    "attribute-parens": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": { "0": { "name": "punctuation.brackets.round.vole" } },
      "endCaptures": { "0": { "name": "punctuation.brackets.round.vole" } },
      "patterns": [
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#attribute-parens" },
        {
          "name": "entity.other.attribute-name.vole",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        { "name": "keyword.operator.assignment.vole", "match": "=" },
        { "name": "punctuation.separator.comma.vole", "match": "," }
      ]
    },

    "strings": {
      "patterns": [
        { "include": "#format-string" },
        { "include": "#c-string" },
        { "include": "#byte-string" },
        { "include": "#plain-string" }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.vole",
          "match": "\\\\(?:[ntr0\\\\\"']|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\})"
        },
        {
          "name": "constant.character.escape.line-continuation.vole",
          "match": "\\\\$"
        },
        {
          "name": "invalid.illegal.escape.vole",
          "match": "\\\\."
        }
      ]
    },
    "plain-string": {
      "name": "string.quoted.double.vole",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.vole" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.vole" } },
      "patterns": [{ "include": "#escapes" }]
    },
    "c-string": {
      "name": "string.quoted.double.c.vole",
      "begin": "\\b(c)(\")",
      "end": "\"",
      "beginCaptures": {
        "1": { "name": "storage.type.string.vole" },
        "2": { "name": "punctuation.definition.string.begin.vole" }
      },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.vole" } },
      "patterns": [{ "include": "#escapes" }]
    },
    "byte-string": {
      "name": "string.quoted.double.byte.vole",
      "begin": "\\b(b)(\")",
      "end": "\"",
      "beginCaptures": {
        "1": { "name": "storage.type.string.vole" },
        "2": { "name": "punctuation.definition.string.begin.vole" }
      },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.vole" } },
      "patterns": [{ "include": "#escapes" }]
    },
    "format-string": {
      "name": "string.interpolated.vole",
      "begin": "\\b(f)(\")",
      "end": "\"",
      "beginCaptures": {
        "1": { "name": "storage.type.string.vole" },
        "2": { "name": "punctuation.definition.string.begin.vole" }
      },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.vole" } },
      "patterns": [
        { "name": "constant.character.escape.brace.vole", "match": "\\{\\{|\\}\\}" },
        { "include": "#escapes" },
        { "include": "#format-hole" }
      ]
    },
    "format-hole": {
      "name": "meta.embedded.line.vole",
      "contentName": "source.vole",
      "begin": "\\{",
      "end": "(?:(:)([<>]?0?[0-9]*(?:\\.[0-9]+)?[?xXbc]?))?(\\})",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.vole" } },
      "endCaptures": {
        "1": { "name": "punctuation.separator.format-spec.vole" },
        "2": { "name": "constant.other.format-spec.vole" },
        "3": { "name": "punctuation.section.embedded.end.vole" }
      },
      "patterns": [
        { "include": "#hole-braces" },
        { "include": "$self" }
      ]
    },
    "hole-braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.brackets.curly.vole" } },
      "endCaptures": { "0": { "name": "punctuation.brackets.curly.vole" } },
      "patterns": [
        { "include": "#hole-braces" },
        { "include": "$self" }
      ]
    },

    "chars": {
      "name": "string.quoted.single.char.vole",
      "match": "(b?)(')(?:(\\\\(?:[ntr0\\\\\"']|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\}))|[^\\\\'])(')",
      "captures": {
        "1": { "name": "storage.type.string.vole" },
        "2": { "name": "punctuation.definition.char.begin.vole" },
        "3": { "name": "constant.character.escape.vole" },
        "4": { "name": "punctuation.definition.char.end.vole" }
      }
    },

    "raw-identifiers": {
      "name": "variable.other.raw.vole",
      "match": "\\br#[A-Za-z_][A-Za-z0-9_]*\\b"
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.vole",
          "match": "\\b0[xX][0-9a-fA-F](?:[0-9a-fA-F_]*[0-9a-fA-F])?(_?[iu](?:8|16|32|64|size))?\\b",
          "captures": { "1": { "name": "entity.name.type.numeric.vole" } }
        },
        {
          "name": "constant.numeric.binary.vole",
          "match": "\\b0[bB][01](?:[01_]*[01])?(_?[iu](?:8|16|32|64|size))?\\b",
          "captures": { "1": { "name": "entity.name.type.numeric.vole" } }
        },
        {
          "name": "constant.numeric.float.vole",
          "match": "(?<!\\.)\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?|[eE][+-]?[0-9][0-9_]*)(_?f(?:32|64))?\\b",
          "captures": { "1": { "name": "entity.name.type.numeric.vole" } }
        },
        {
          "name": "constant.numeric.float.vole",
          "match": "(?<!\\.)\\b[0-9](?:[0-9_]*[0-9])?(_?f(?:32|64))\\b",
          "captures": { "1": { "name": "entity.name.type.numeric.vole" } }
        },
        {
          "name": "constant.numeric.integer.vole",
          "match": "\\b[0-9](?:[0-9_]*[0-9])?(_?[iu](?:8|16|32|64|size))?\\b",
          "captures": { "1": { "name": "entity.name.type.numeric.vole" } }
        }
      ]
    },

    "labels": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(:)(?=\\s*(?:for|while|loop)\\b)",
          "captures": {
            "1": { "name": "entity.name.label.vole" },
            "2": { "name": "punctuation.definition.label.vole" }
          }
        },
        {
          "match": "\\b(break|continue)\\s+(:)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.vole" },
            "2": { "name": "punctuation.definition.label.vole" },
            "3": { "name": "entity.name.label.vole" }
          }
        }
      ]
    },

    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.fn.vole" },
            "2": { "name": "entity.name.function.vole" }
          }
        },
        {
          "match": "\\b(struct|enum|union|trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.vole storage.type.vole" },
            "2": { "name": "entity.name.type.vole" }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.vole storage.type.type.vole" },
            "2": { "name": "entity.name.type.alias.vole" }
          }
        },
        {
          "match": "\\b(mod)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.mod.vole storage.type.mod.vole" },
            "2": { "name": "entity.name.namespace.vole" }
          }
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vole",
          "match": "\\b(?:if|else|match|loop|while|for|in|break|continue|return|defer)\\b"
        },
        { "include": "#ensures-clause" },
        {
          "comment": "Contracts (0.18): requires, ensures and their debug forms.",
          "name": "keyword.other.contract.vole",
          "match": "\\b(?:requires|ensures)\\b"
        },
        {
          "match": "\\b(debug)\\s+(requires|ensures)\\b",
          "captures": {
            "1": { "name": "keyword.other.contract.vole" },
            "2": { "name": "keyword.other.contract.vole" }
          }
        },
        {
          "name": "keyword.other.fn.vole",
          "match": "\\bfn\\b"
        },
        {
          "name": "keyword.declaration.vole storage.type.vole",
          "match": "\\b(?:struct|enum|union|trait|type|mod|impl)\\b"
        },
        {
          "comment": "Bindings: let (both spellings), var (the conventions design; was let mut).",
          "name": "storage.type.binding.vole",
          "match": "\\b(?:let|var)\\b"
        },
        {
          "comment": "Parameter conventions inout and sink, plus the transitional mut and move.",
          "name": "storage.modifier.convention.vole",
          "match": "\\b(?:inout|sink)\\b"
        },
        {
          "name": "storage.modifier.vole",
          "match": "\\b(?:mut|move|pub|const|static|extern|unsafe|distinct)\\b"
        },
        {
          "name": "keyword.other.import.vole",
          "match": "\\b(?:use|import)\\b"
        },
        {
          "name": "keyword.operator.cast.vole",
          "match": "\\bas\\b"
        },
        {
          "comment": "Reserved: an error today.",
          "name": "keyword.other.reserved.vole",
          "match": "\\b(?:where|dyn)\\b"
        },
        {
          "name": "constant.language.boolean.vole",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "variable.language.self.vole",
          "match": "\\bself\\b"
        },
        {
          "name": "storage.type.self.vole",
          "match": "\\bSelf\\b"
        },
        {
          "name": "keyword.other.path.vole",
          "match": "\\b(?:crate|super)\\b"
        }
      ]
    },

    "ensures-clause": {
      "comment": "An ensures clause runs to the body's brace: result and old(e) mean the returned value and e at entry.",
      "name": "meta.contract.ensures.vole",
      "begin": "\\b(?:(debug)\\s+)?(ensures)\\b",
      "end": "(?=\\{|;|\\b(?:requires|ensures|debug)\\b)",
      "beginCaptures": {
        "1": { "name": "keyword.other.contract.vole" },
        "2": { "name": "keyword.other.contract.vole" }
      },
      "patterns": [
        { "name": "variable.language.contract.result.vole", "match": "\\bresult\\b" },
        {
          "match": "\\b(old)\\s*(?=\\()",
          "captures": { "1": { "name": "variable.language.contract.old.vole" } }
        },
        { "include": "$self" }
      ]
    },

    "macros": {
      "comment": "Rust-style name!(...): not part of the language; highlighted so the fix is easy to spot.",
      "match": "\\b([a-z_][A-Za-z0-9_]*)(!)(?=\\s*[\\(\\[\\{])",
      "captures": {
        "1": { "name": "entity.name.function.macro.vole" },
        "2": { "name": "entity.name.function.macro.vole punctuation.definition.macro.vole" }
      }
    },

    "paths": {
      "patterns": [
        {
          "comment": "A call with a turbofish: name::<T>(...).",
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=::<)",
          "captures": { "1": { "name": "entity.name.function.vole" } }
        },
        {
          "match": "\\b(std|core)\\b(?=\\s*::)",
          "name": "support.namespace.std.vole entity.name.namespace.vole"
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=::)",
          "captures": { "1": { "name": "entity.name.namespace.vole" } }
        },
        {
          "name": "punctuation.separator.namespace.vole",
          "match": "::"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.vole",
          "match": "\\b(?:i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64|bool)\\b"
        },
        {
          "comment": "SIMD vector types (0.19), such as u8x16 and f32x4.",
          "name": "storage.type.primitive.simd.vole",
          "match": "\\b(?:i8|i16|i32|i64|u8|u16|u32|u64|f32|f64)x(?:2|4|8|16|32|64)\\b"
        },
        {
          "name": "support.constant.variant.vole",
          "match": "\\b(?:Some|None|Ok|Err)\\b"
        },
        {
          "name": "support.type.std.vole entity.name.type.vole",
          "match": "\\b(?:Vec|Option|Result|Buf|HashMap|HashSet|Gpa|Arena|FixedBuffer|Allocator|Interp|Display|Debug|Iterator|Drop|Clone|Copy|Eq|Ord|Hash|From|Into|Fn|FnMut|NonNull)\\b"
        },
        {
          "comment": "SCREAMING_CASE: constants and statics.",
          "name": "variable.other.constant.vole",
          "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z])"
        },
        {
          "name": "entity.name.type.vole",
          "match": "\\b_*[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "name": "meta.function-call.vole",
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.vole" } }
        }
      ]
    },

    "variables": {
      "patterns": [
        {
          "name": "variable.language.wildcard.vole",
          "match": "\\b_\\b"
        },
        {
          "name": "variable.other.vole",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.vole", "match": "->" },
        { "name": "keyword.operator.arrow.fat.vole", "match": "=>" },
        { "name": "keyword.operator.range.vole", "match": "\\.\\.=|\\.\\." },
        { "name": "keyword.operator.assignment.compound.vole", "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=" },
        { "name": "keyword.operator.comparison.vole", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.vole", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.bitwise.shift.vole", "match": "<<|>>" },
        { "name": "keyword.operator.comparison.vole", "match": "<|>" },
        { "name": "keyword.operator.assignment.vole", "match": "=" },
        { "name": "keyword.operator.question.vole", "match": "\\?" },
        { "name": "keyword.operator.access.vole", "match": "&" },
        { "name": "keyword.operator.arithmetic.vole", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.bitwise.vole", "match": "[|^~]" },
        { "name": "keyword.operator.at.vole", "match": "@" }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.vole", "match": ";" },
        { "name": "punctuation.separator.comma.vole", "match": "," },
        { "name": "punctuation.separator.colon.vole", "match": ":" },
        { "name": "punctuation.accessor.dot.vole", "match": "\\." },
        { "name": "punctuation.brackets.curly.vole", "match": "[{}]" },
        { "name": "punctuation.brackets.round.vole", "match": "[()]" },
        { "name": "punctuation.brackets.square.vole", "match": "[\\[\\]]" }
      ]
    }
  }
}
