{
  "name": "vole",
  "displayName": "Vole",
  "description": "Vole language support: syntax highlighting, and diagnostics, completion, formatting on save, go to definition, references, hover and document and workspace symbols from `volec lsp`, std included.",
  "version": "0.25.1",
  "publisher": "vole-lang",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/magniff/vole.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "vole",
    "volec",
    "systems programming"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:vole"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vole",
        "aliases": [
          "Vole",
          "vole"
        ],
        "extensions": [
          ".vl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-light.png",
          "dark": "./images/file-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "vole",
        "scopeName": "source.vole",
        "path": "./syntaxes/vole.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[vole]": {
        "editor.defaultFormatter": "vole-lang.vole",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    },
    "commands": [
      {
        "command": "vole.restartServer",
        "title": "Restart Language Server",
        "category": "Vole"
      },
      {
        "command": "vole.showOutput",
        "title": "Show Language Server Output",
        "category": "Vole"
      }
    ],
    "configuration": {
      "title": "Vole",
      "properties": {
        "vole.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the language server (`volec lsp`). Highlighting works without it."
        },
        "vole.server.path": {
          "type": "string",
          "default": "volec",
          "scope": "machine-overridable",
          "description": "The compiler that runs the language server: a name looked up on PATH, or a path (relative paths are taken from the first workspace folder)."
        },
        "vole.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "The arguments that start the language server."
        },
        "vole.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the language server to the Vole output."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run test:grammar && npm run test:snapshots && npm run test:package && npm run test:lsp",
    "test:grammar": "vscode-tmgrammar-test -g syntaxes/vole.tmLanguage.json \"test/samples/*.test.vl\"",
    "test:snapshots": "python3 test/tmgrammar.py",
    "package": "vsce package --out vole.vsix",
    "test:package": "node test/package.test.js",
    "test:lsp": "node test/lsp.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.82.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.4.5",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
