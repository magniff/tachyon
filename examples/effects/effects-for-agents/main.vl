// Renders a few small documents to HTML with the `markup` module.
mod markup;

fn main(gpa: Gpa) -> i32 {
    let docs = [
        "# Arenas\nAn *arena* hands out memory\nby bumping a pointer.\n\n# Why arenas?\nFreeing is `free_all`: once.",
        "# Effects\nEach function has a set: `alloc(Gpa)`, *io*, ...",
    ];
    for doc in docs {
        let html = markup::render(doc, gpa);
        print(html.as_slice());
    }
    0
}
