// A small subset of Markdown to HTML: `# ` headings (with an id made from
// their text), paragraphs separated by blank lines, `*emphasis*` and
// `code` inside them, and a table of contents first. Everything it makes
// for a document lives until the document is printed.
use std::{Buf, split_in};

pub struct Heading { pub title: [u8], pub id: Buf }

// The document's lines (views of src) in a new Vec.
fn lines(src: [u8], gpa: Gpa) -> Vec<[u8]> {
    split_in(src, '\n', gpa)
}

// The id of a heading: its letters and digits in lowercase, words joined
// by '-' ("Why arenas?" is "why-arenas").
fn slug(title: [u8], gpa: Gpa) -> Buf {
    let mut id = Buf::new_in(gpa);
    let mut dash = false;
    for b in title {
        let c = if b >= 'A' && b <= 'Z' { b + 32 } else { b };
        if (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') {
            if dash && id.len() > 0 {
                id.push('-');
            }
            id.push(c);
            dash = false;
        } else {
            dash = true;
        }
    }
    id
}

// `*x*` as <em>x</em> and `x` (backquotes) as <code>x</code>, the rest as
// it is, appended to out.
fn inline(text: [u8], out: &mut Buf) {
    let mut em = false;
    let mut code = false;
    for b in text {
        if b == '`' {
            out.push_str(if code { "</code>" } else { "<code>" });
            code = !code;
        } else if b == '*' && !code {
            out.push_str(if em { "</em>" } else { "<em>" });
            em = !em;
        } else if b == '<' {
            out.push_str("&lt;");
        } else {
            out.push(b);
        }
    }
}

// The headings of the document, with their ids.
fn headings(ls: [[u8]], gpa: Gpa) -> Vec<Heading> {
    let mut hs: Vec<Heading> = Vec::new_in(gpa);
    for l in ls {
        if l.len() > 2 && l[0] == '#' && l[1] == ' ' {
            hs.push(Heading { title: l[2..], id: slug(l[2..], gpa) });
        }
    }
    hs
}

// The document as HTML, in a new Buf.
pub fn render(src: [u8], gpa: Gpa) -> Buf {
    let mut out = Buf::new_in(gpa);
    let ls = lines(src, gpa);
    let hs = headings(ls.as_slice(), gpa);
    out.push_str("<ul>\n");
    for h in hs.iter() {
        out.push_str("<li><a href=\"#");
        out.push_str(h.id.as_slice());
        out.push_str("\">");
        inline(h.title, &mut out);
        out.push_str("</a></li>\n");
    }
    out.push_str("</ul>\n");
    let mut k = 0;
    let mut para = false;
    for l in ls.iter() {
        if l.len() > 2 && l[0] == '#' && l[1] == ' ' {
            if para {
                out.push_str("</p>\n");
                para = false;
            }
            out.push_str("<h1 id=\"");
            out.push_str(hs.as_slice()[k].id.as_slice());
            out.push_str("\">");
            inline(l[2..], &mut out);
            out.push_str("</h1>\n");
            k += 1;
        } else if l.len() == 0 {
            if para {
                out.push_str("</p>\n");
                para = false;
            }
        } else {
            out.push_str(if para { "\n" } else { "<p>" });
            inline(l, &mut out);
            para = true;
        }
    }
    if para {
        out.push_str("</p>\n");
    }
    out
}
