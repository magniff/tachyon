// A small table library: rows of a name and a value, and operations that
// take closures. Each closure parameter's bound says what the closure may
// do (`+ effects(...)`), because the library decides how often, and in
// which order, it calls it. The compiler checks the bound where a closure
// is given: an error there names the closure's effect and where it comes
// from, at the caller's line, not inside this module.
use std::sort_by;

pub struct Row { pub name: [u8], pub value: i64 }

// Every value replaced by f(value). f may compute and panic, nothing
// else: no I/O, no statics, no allocation. (So the library is free to
// call it once per row, or once per distinct value, or in any order.)
pub fn map_values<F: Fn(i64) -> i64 + effects(panic)>(rows: inout [Row], f: F) {
    for i in 0..rows.len() {
        rows[i].value = f(rows[i].value);
    }
}

// Moves the rows for which keep(row) is true to the front, in their
// order; returns how many. keep may do nothing at all but compute, not
// even panic (`effects()`, the empty set): a filter that may stop the
// program halfway would leave the table half moved.
pub fn partition<F: Fn(let Row) -> bool + effects()>(rows: inout [Row], keep: F) -> i64 {
    var n = 0;
    for i in 0..rows.len() {
        if keep(rows[i]) {
            let r = rows[i];
            for k in 0..i - n {
                rows[i - k] = rows[i - k - 1];
            }
            rows[n] = r;
            n += 1;
        }
    }
    n
}

// Sorted by key(row), smallest first. key is called about 2 n log n times,
// in an order that is the sort's business: it may compute and panic.
pub fn sort_by_key<F: Fn(let Row) -> i64 + effects(panic)>(rows: inout [Row], key: F) {
    sort_by(rows, |a, b| key(a) - key(b));
}

// Calls f on each row, in order, once: anything goes (no effects bound),
// printing included.
pub fn each<F: FnMut(let Row)>(rows: [Row], f: sink F) {
    for r in rows {
        f(r);
    }
}
