// The table library used well: closures that compute, given to the
// operations whose bounds say they may only compute; a closure that
// prints, given to the one that allows it.
mod table;

use table::{Row, each, map_values, partition, sort_by_key};

fn main() -> i32 {
    let mut rows = [
        Row { name: "ada", value: 36 },
        Row { name: "brian", value: 7 },
        Row { name: "grace", value: 85 },
        Row { name: "alan", value: 41 },
        Row { name: "barbara", value: 12 },
    ];
    let bonus = 5;
    map_values(&mut rows[..], |v| v + bonus);
    let n = partition(&mut rows[..], |r| r.value >= 20);
    sort_by_key(&mut rows[..n], |r| -r.value);
    let mut shown = 0;
    each(rows[..], |r| {
        println(f"{r.name:<8} {r.value:>3}");
        shown += 1;
    });
    println(f"{n} of {shown} rows kept, sorted by value");
    0
}
