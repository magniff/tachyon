// The most frequent words of a text, counted without regard to case
// ("The" and "the" are one word). The keys are a type of this program,
// `Word`, with hand-written Hash and Eq, and the counts are sorted by a
// hand-written Ord. std declares these three traits' methods #[pure]
// (no allocation, I/O or statics), and the declaration binds every impl:
// a hash that counts its calls in a static, an eq that prints, or a cmp
// that allocates is an error at the impl.
use std::{HashMap, Ord, sort, split_whitespace_in};

// A word, compared and hashed as if it were in lowercase.
struct Word { text: [u8] }

fn lower(b: u8) -> u8 {
    if b >= 'A' && b <= 'Z' { b + 32 } else { b }
}

// FNV-1a over the lowercase bytes: equal words (by eq, below) must hash
// equal, so both look at the same thing.
impl Hash for Word {
    fn hash(self: &Word) -> u64 {
        let mut h = 0xcbf29ce484222325u64;
        for b in self.text {
            h = (h ^ lower(b) as u64) * 0x100000001b3u64;
        }
        h
    }
}

impl Eq for Word {
    fn eq(self: &Word, other: &Word) -> bool {
        if self.text.len != other.text.len {
            return false;
        }
        for i in 0..self.text.len {
            if lower(self.text[i]) != lower(other.text[i]) {
                return false;
            }
        }
        true
    }
}

// A word and how often it occurs: the most frequent first, then
// alphabetically (as written, so "The" before "the").
struct Count { word: Word, n: i64 }

impl Ord for Count {
    fn cmp(self: &Count, other: &Count) -> i64 {
        if self.n != other.n {
            return other.n - self.n;
        }
        self.word.text.cmp(&other.word.text)
    }
}

// The word in w: w without the punctuation around it.
fn trim_word(w: [u8]) -> [u8] {
    let mut a = 0;
    let mut b = w.len;
    for _ in 0..w.len {
        if a < b && !is_letter(w[a]) {
            a += 1;
        }
        if a < b && !is_letter(w[b - 1]) {
            b -= 1;
        }
    }
    w[a..b]
}

fn is_letter(b: u8) -> bool {
    (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '\''
}

fn main(gpa: Gpa) -> i32 {
    let text = "The cat sat on the mat. The mat was flat, and the cat was fat; \
                a cat on a mat is a happy cat. THE END";
    let mut words = split_whitespace_in(text, gpa);
    let mut counts: HashMap<Word, i64> = HashMap::new_in(gpa);
    for w in words.iter() {
        let t = trim_word(w);
        if t.len > 0 {
            let key = Word { text: t };
            let before = counts.get(key).unwrap_or(0);
            counts.insert(key, before + 1);
        }
    }
    let mut ranked: Vec<Count> = counts
        .iter()
        .map(|(w, n)| Count { word: w, n: n })
        .collect_in(gpa);
    sort(ranked.as_slice());
    println(f"{words.len()} words, {counts.len()} different");
    for c in ranked.as_slice()[..5] {
        println(f"{c.n:>3} {c.word.text}");
    }
    0
}
