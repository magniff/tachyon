extern fn read(fd: i32, buf: *u8, count: u64) -> i64;
extern fn write(fd: i32, buf: *u8, len: u64) -> i64;
extern fn open(path: *u8, flags: i32) -> i32;
extern fn close(fd: i32) -> i32;
extern fn memcpy(dst: *u8, src: *u8, n: u64) -> *u8;
extern fn memset(s: *u8, c: i32, n: u64) -> *u8;

fn rb(p: *u8, i: u64) -> u8 { *((p as u64 + i) as *u8) }
fn wb(p: *u8, i: u64, v: u8) { *((p as u64 + i) as *u8) = v; }

fn rotl(x: u32, n: u32) -> u32 {
    (x << n) | (x >> (32 as u32 - n))
}

// Read little-endian u32 from byte pointer
fn read_u32_le(p: *u8) -> u32 {
    rb(p, 0) as u32
    | (rb(p, 1) as u32 << 8 as u32)
    | (rb(p, 2) as u32 << 16 as u32)
    | (rb(p, 3) as u32 << 24 as u32)
}

// Write little-endian u32 to byte pointer
fn write_u32_le(p: *u8, v: u32) {
    wb(p, 0, v as u8);
    wb(p, 1, (v >> 8 as u32) as u8);
    wb(p, 2, (v >> 16 as u32) as u8);
    wb(p, 3, (v >> 24 as u32) as u8);
}

// Write little-endian u64 to byte pointer
fn write_u64_le(p: *u8, v: u64) {
    wb(p, 0, v as u8);
    wb(p, 1, (v >> 8) as u8);
    wb(p, 2, (v >> 16) as u8);
    wb(p, 3, (v >> 24) as u8);
    wb(p, 4, (v >> 32) as u8);
    wb(p, 5, (v >> 40) as u8);
    wb(p, 6, (v >> 48) as u8);
    wb(p, 7, (v >> 56) as u8);
}

// K table — precomputed floor(2^32 * abs(sin(i+1))) for i=0..63
// Stored as a flat byte array (64 * 4 = 256 bytes), read with read_u32_le
fn get_K(i: u32) -> u32 {
    // The 64 round constants
    if i ==  0 { return 0xd76aa478 as u32; };
    if i ==  1 { return 0xe8c7b756 as u32; };
    if i ==  2 { return 0x242070db as u32; };
    if i ==  3 { return 0xc1bdceee as u32; };
    if i ==  4 { return 0xf57c0faf as u32; };
    if i ==  5 { return 0x4787c62a as u32; };
    if i ==  6 { return 0xa8304613 as u32; };
    if i ==  7 { return 0xfd469501 as u32; };
    if i ==  8 { return 0x698098d8 as u32; };
    if i ==  9 { return 0x8b44f7af as u32; };
    if i == 10 { return 0xffff5bb1 as u32; };
    if i == 11 { return 0x895cd7be as u32; };
    if i == 12 { return 0x6b901122 as u32; };
    if i == 13 { return 0xfd987193 as u32; };
    if i == 14 { return 0xa679438e as u32; };
    if i == 15 { return 0x49b40821 as u32; };
    if i == 16 { return 0xf61e2562 as u32; };
    if i == 17 { return 0xc040b340 as u32; };
    if i == 18 { return 0x265e5a51 as u32; };
    if i == 19 { return 0xe9b6c7aa as u32; };
    if i == 20 { return 0xd62f105d as u32; };
    if i == 21 { return 0x02441453 as u32; };
    if i == 22 { return 0xd8a1e681 as u32; };
    if i == 23 { return 0xe7d3fbc8 as u32; };
    if i == 24 { return 0x21e1cde6 as u32; };
    if i == 25 { return 0xc33707d6 as u32; };
    if i == 26 { return 0xf4d50d87 as u32; };
    if i == 27 { return 0x455a14ed as u32; };
    if i == 28 { return 0xa9e3e905 as u32; };
    if i == 29 { return 0xfcefa3f8 as u32; };
    if i == 30 { return 0x676f02d9 as u32; };
    if i == 31 { return 0x8d2a4c8a as u32; };
    if i == 32 { return 0xfffa3942 as u32; };
    if i == 33 { return 0x8771f681 as u32; };
    if i == 34 { return 0x6d9d6122 as u32; };
    if i == 35 { return 0xfde5380c as u32; };
    if i == 36 { return 0xa4beea44 as u32; };
    if i == 37 { return 0x4bdecfa9 as u32; };
    if i == 38 { return 0xf6bb4b60 as u32; };
    if i == 39 { return 0xbebfbc70 as u32; };
    if i == 40 { return 0x289b7ec6 as u32; };
    if i == 41 { return 0xeaa127fa as u32; };
    if i == 42 { return 0xd4ef3085 as u32; };
    if i == 43 { return 0x04881d05 as u32; };
    if i == 44 { return 0xd9d4d039 as u32; };
    if i == 45 { return 0xe6db99e5 as u32; };
    if i == 46 { return 0x1fa27cf8 as u32; };
    if i == 47 { return 0xc4ac5665 as u32; };
    if i == 48 { return 0xf4292244 as u32; };
    if i == 49 { return 0x432aff97 as u32; };
    if i == 50 { return 0xab9423a7 as u32; };
    if i == 51 { return 0xfc93a039 as u32; };
    if i == 52 { return 0x655b59c3 as u32; };
    if i == 53 { return 0x8f0ccc92 as u32; };
    if i == 54 { return 0xffeff47d as u32; };
    if i == 55 { return 0x85845dd1 as u32; };
    if i == 56 { return 0x6fa87e4f as u32; };
    if i == 57 { return 0xfe2ce6e0 as u32; };
    if i == 58 { return 0xa3014314 as u32; };
    if i == 59 { return 0x4e0811a1 as u32; };
    if i == 60 { return 0xf7537e82 as u32; };
    if i == 61 { return 0xbd3af235 as u32; };
    if i == 62 { return 0x2ad7d2bb as u32; };
    0xeb86d391
}

fn get_shift(i: u32) -> u32 {
    // Per-round shift amounts
    let s: [u8; 64] = [
        7,12,17,22, 7,12,17,22, 7,12,17,22, 7,12,17,22,
        5, 9,14,20, 5, 9,14,20, 5, 9,14,20, 5, 9,14,20,
        4,11,16,23, 4,11,16,23, 4,11,16,23, 4,11,16,23,
        6,10,15,21, 6,10,15,21, 6,10,15,21, 6,10,15,21
    ];
    rb(&s as *u8, i as u64) as u32
}

fn md5_process_chunk(chunk: *u8, state: *u32) {
    // Read 16 u32 words from chunk (little-endian)
    let M: [u32; 16] = [0 as u32; 16];
    let wi: u32 = 0;
    loop {
        if wi >= 16 as u32 { break; };
        *(((&M as *u8) as u64 + wi as u64 * 4) as *u32) =
            read_u32_le((chunk as u64 + wi as u64 * 4) as *u8);
        wi += 1 as u32;
    }

    let a = *state;
    let b = *((state as u64 + 4) as *u32);
    let c = *((state as u64 + 8) as *u32);
    let d = *((state as u64 + 12) as *u32);

    let i: u32 = 0;
    loop {
        if i >= 64 as u32 { break; };

        let f: u32 = 0;
        let g: u32 = 0;

        if i < 16 as u32 {
            // Round 1: F = (B & C) | (~B & D)
            f = (b & c) | (~b & d);
            g = i;
        } else {
            if i < 32 as u32 {
                // Round 2: F = (D & B) | (~D & C)
                f = (d & b) | (~d & c);
                g = (5 as u32 * i + 1 as u32) % 16 as u32;
            } else {
                if i < 48 as u32 {
                    // Round 3: F = B ^ C ^ D
                    f = b ^ c ^ d;
                    g = (3 as u32 * i + 5 as u32) % 16 as u32;
                } else {
                    // Round 4: F = C ^ (B | ~D)
                    f = c ^ (b | ~d);
                    g = (7 as u32 * i) % 16 as u32;
                };
            };
        };

        let mg = *(((&M as *u8) as u64 + g as u64 * 4) as *u32);
        f = f + a + get_K(i) + mg;
        a = d;
        d = c;
        c = b;
        b = b + rotl(f, get_shift(i));

        i += 1 as u32;
    }

    // Add back to state
    *state = *state + a;
    *((state as u64 + 4) as *u32) = *((state as u64 + 4) as *u32) + b;
    *((state as u64 + 8) as *u32) = *((state as u64 + 8) as *u32) + c;
    *((state as u64 + 12) as *u32) = *((state as u64 + 12) as *u32) + d;
}

fn md5(input_fd: i32, digest: *u8) {
    let state: [u32; 4] = [
        0x67452301 as u32,
        0xefcdab89 as u32,
        0x98badcfe as u32,
        0x10325476 as u32
    ];

    let chunk: [u8; 64] = [0; 64];
    let total_bytes: u64 = 0;
    let done = false;

    loop {
        if done { break; };

        let n = read(input_fd, &chunk as *u8, 64);
        if n < 0 { n = 0; };
        total_bytes += n as u64;

        if n == 64 {
            md5_process_chunk(&chunk as *u8, &state as *u32);
            continue;
        };

        // Final chunk(s): n < 64 means EOF
        let bytes_read = n as u64;

        // Pad: set 0x80 byte after data
        wb(&chunk as *u8, bytes_read, 0x80 as u8);
        let zi = bytes_read + 1;
        loop {
            if zi >= 64 { break; };
            wb(&chunk as *u8, zi, 0 as u8);
            zi += 1;
        }

        if bytes_read < 56 {
            // Room for length in this chunk
            write_u64_le((&chunk as *u8 as u64 + 56) as *u8, total_bytes * 8);
            md5_process_chunk(&chunk as *u8, &state as *u32);
        } else {
            // No room — need two chunks
            md5_process_chunk(&chunk as *u8, &state as *u32);
            memset(&chunk as *u8, 0, 64);
            write_u64_le((&chunk as *u8 as u64 + 56) as *u8, total_bytes * 8);
            md5_process_chunk(&chunk as *u8, &state as *u32);
        };
        done = true;
    }

    write_u32_le(digest, *(&state as *u32));
    write_u32_le((digest as u64 + 4) as *u8, *((&state as *u8 as u64 + 4) as *u32));
    write_u32_le((digest as u64 + 8) as *u8, *((&state as *u8 as u64 + 8) as *u32));
    write_u32_le((digest as u64 + 12) as *u8, *((&state as *u8 as u64 + 12) as *u32));
}

fn byte_to_hex(val: u8, buf: *u8) {
    let hi = (val >> 4 as u8) & 0xF as u8;
    let lo = val & 0xF as u8;
    if hi < 10 { wb(buf, 0, hi + 48 as u8); }
    else { wb(buf, 0, hi + 87 as u8); };
    if lo < 10 as u8 { wb(buf, 1, lo + 48 as u8); }
    else { wb(buf, 1, lo + 87 as u8); };
}

fn print_hex(data: *u8, len: u64) {
    let hex: [u8; 2] = [0; 2];
    let i: u64 = 0;
    loop {
        if i >= len { break; };
        byte_to_hex(rb(data, i), &hex as *u8);
        write(1, &hex as *u8, 2);
        i += 1;
    }
}

fn main(argc: usize, argv: **u8) -> i32 {
    let fd: i32 = 0;
    if argc >= 2 {
        let filename = *((argv as u64 + 8) as **u8);
        fd = open(filename, 0);
        if fd < 0 {
            write(2, "error: cannot open file\n".0, 24);
            return 1;
        };
    };

    let digest: [u8; 16] = [0; 16];
    md5(fd, &digest as *u8);
    print_hex(&digest as *u8, 16);
    write(1, "\n".0, 1);
    if fd != 0 { close(fd); };

    0
}
