// httpd.tach — a simple HTTP file server written in Tachyon
// Clone of `python -m http.server`
// Serves directory listings and files on http://127.0.0.1:8000/
//
// Usage: httpd <directory>
//   e.g. httpd /var/www
//        httpd .

extern "C" {
    fn socket(domain: i32, sock_type: i32, protocol: i32) -> i32;
    fn setsockopt(fd: i32, level: i32, optname: i32, optval: *u8, optlen: u32) -> i32;
    fn bind(fd: i32, addr: *u8, addrlen: u32) -> i32;
    fn listen(fd: i32, backlog: i32) -> i32;
    fn accept(fd: i32, addr: *u8, addrlen: *u32) -> i32;
    fn read(fd: i32, buf: *u8, count: u64) -> i64;
    fn write(fd: i32, buf: *u8, len: u64) -> i64;
    fn close(fd: i32) -> i32;
    fn htons(hostshort: u16) -> u16;
    fn open(path: *u8, flags: i32) -> i32;
    fn stat(path: *u8, buf: *u8) -> i32;
    fn opendir(name: *u8) -> *u8;
    fn readdir(dirp: *u8) -> *u8;
    fn closedir(dirp: *u8) -> i32;
    fn strlen(s: *u8) -> u64;
    fn memcpy(dst: *u8, src: *u8, n: u64) -> *u8;
    fn memset(s: *u8, c: i32, n: u64) -> *u8;
    fn getcwd(buf: *u8, size: u64) -> *u8;
    fn chdir(path: *u8) -> i32;
    fn realpath(path: *u8, resolved: *u8) -> *u8;
    fn strcmp(a: *u8, b: *u8) -> i32;
}

// ============================================================================
// Byte-level helpers
// ============================================================================
fn rb(p: *u8, off: u64) -> u8 {
    p[off]
}

fn wb(p: *u8, off: u64, v: u8) {
    p[off] = v;
}

// ============================================================================
// String buffer helpers
// ============================================================================

// Append raw bytes to buffer at offset, return new offset
fn bcat(buf: *u8, off: u64, src: *u8, len: u64) -> u64 {
    memcpy(&buf[off], src, len);
    off + len
}

// Append a C string (null-terminated) to buffer
fn bcats(buf: *u8, off: u64, s: *u8) -> u64 {
    let len = strlen(s);
    bcat(buf, off, s, len)
}

// Append a Tachyon string (ptr+len) to buffer
fn bcatstr(buf: *u8, off: u64, s: [u8]) -> u64 {
    bcat(buf, off, s.ptr, (s.len as u64))
}

// Write i64 as decimal into buf, return chars written
fn i64_to_dec(val: i64, buf: *u8) -> u64 {
    let tmp: [u8; 20] = [0; 20];
    let mut pos: i64 = 19;
    let mut v = val;
    if v == 0 {
        wb(buf, 0, '0');
        return 1 as u64;
    }
    let neg = v < 0;
    if neg { v = 0 - v; }
    while v != 0 {
        let digit = (v % 10) as i32;
        wb(&tmp as *u8, pos as u64, (digit + 48) as u8);
        v = v / 10;
        pos -= 1;
    }
    if neg { wb(&tmp as *u8, pos as u64, '-'); pos -= 1; }
    let start = (pos + 1) as u64;
    let len = 20 as u64 - start;
    memcpy(buf, &tmp[start], len);
    len
}

// Append i64 as decimal string to buffer
fn bcat_i64(buf: *u8, off: u64, val: i64) -> u64 {
    let n = i64_to_dec(val, &buf[off]);
    off + n
}

// ============================================================================
// URL decoding — decode %XX sequences in-place, return new length
// ============================================================================
fn hex_val(ch: u8) -> i32 {
    if ch >= '0' {
        if ch <= '9' { return (ch - '0') as i32; }
    }
    if ch >= 'A' {
        if ch <= 'F' { return (ch - 55 as u8) as i32; }
    }
    if ch >= 'a' {
        if ch <= 'f' { return (ch - 87 as u8) as i32; }
    }
    0 as i32 - 1
}

fn url_decode(buf: *u8, len: u64) -> u64 {
    let mut r: u64 = 0;
    let mut w: u64 = 0;
    while r < len {
        let ch = rb(buf, r);
        if ch == '%' {
            // '%'
            if r + 2 < len {
                let hi = hex_val(rb(buf, r + 1));
                let lo = hex_val(rb(buf, r + 2));
                if hi >= 0 {
                    if lo >= 0 {
                        wb(buf, w, (hi * 16 + lo) as u8);
                        w += 1;
                        r += 3;
                        continue;
                    }
                }
            }
            wb(buf, w, ch);
            w += 1;
            r += 1;
        } else {
            if ch == '+' {
                // '+' → space
                wb(buf, w, ' ');
            } else {
                wb(buf, w, ch);
            }
            w += 1;
            r += 1;
        }
    }
    wb(buf, w, 0);
    w
}

// ============================================================================
// Path utilities
// ============================================================================

// Build full filesystem path: root + url_path → out, null-terminated
// Returns length (excluding null)
fn build_path(root: *u8, rootlen: u64, urlpath: *u8, pathlen: u64, out: *u8) -> u64 {
    let mut p: u64 = 0;
    p = bcat(out, p, root, rootlen);
    // Don't double-slash: if root ends with / and path starts with /, skip one
    if rootlen > 0 {
        if pathlen > 0 {
            if rb(root, rootlen - 1) == '/' {
                if rb(urlpath, 0) == '/' {
                    p = bcat(out, p, &urlpath[1], pathlen - 1);
                    wb(out, p, 0);
                    return p;
                }
            }
        }
    }
    p = bcat(out, p, urlpath, pathlen);
    wb(out, p, 0);
    p
}

// Check if path has a trailing slash
fn has_trailing_slash(p: *u8, len: u64) -> bool {
    if len == 0 { return false; }
    rb(p, len - 1) == '/'
}

// ============================================================================
// stat helpers (Linux x86-64 struct stat offsets)
// ============================================================================

// st_mode at offset 24 (u32)
// st_size at offset 48 (i64)

fn stat_mode(sb: *u8) -> u32 {
    *((sb as u64 + 24) as *u32)
}

fn stat_size(sb: *u8) -> i64 {
    *((sb as u64 + 48) as *i64)
}

fn is_dir(mode: u32) -> bool {
    (mode & 0xF000 as u32) == 0x4000 as u32
}

fn is_regular(mode: u32) -> bool {
    (mode & 0xF000 as u32) == 0x8000 as u32
}

// ============================================================================
// MIME type detection (minimal, by extension)
// ============================================================================

fn ends_with(s: *u8, slen: u64, suffix: *u8, sufflen: u64) -> bool {
    if slen < sufflen { return false; }
    let mut i: u64 = 0;
    while i != sufflen {
        if rb(s, slen - sufflen + i) != rb(suffix, i) { return false; }
        i += 1;
    }
    true
}

// Returns (ptr, len) for Content-Type header value
fn guess_mime(path: *u8, pathlen: u64) -> [u8] {
    if ends_with(path, pathlen, c".html", 5) { return "text/html; charset=utf-8"; }
    if ends_with(path, pathlen, c".htm", 4)  { return "text/html; charset=utf-8"; }
    if ends_with(path, pathlen, c".css", 4)  { return "text/css"; }
    if ends_with(path, pathlen, c".js", 3)   { return "application/javascript"; }
    if ends_with(path, pathlen, c".json", 5) { return "application/json"; }
    if ends_with(path, pathlen, c".txt", 4)  { return "text/plain; charset=utf-8"; }
    if ends_with(path, pathlen, c".md", 3)   { return "text/plain; charset=utf-8"; }
    if ends_with(path, pathlen, c".png", 4)  { return "image/png"; }
    if ends_with(path, pathlen, c".jpg", 4)  { return "image/jpeg"; }
    if ends_with(path, pathlen, c".jpeg", 5) { return "image/jpeg"; }
    if ends_with(path, pathlen, c".gif", 4)  { return "image/gif"; }
    if ends_with(path, pathlen, c".svg", 4)  { return "image/svg+xml"; }
    if ends_with(path, pathlen, c".ico", 4)  { return "image/x-icon"; }
    if ends_with(path, pathlen, c".pdf", 4)  { return "application/pdf"; }
    if ends_with(path, pathlen, c".zip", 4)  { return "application/zip"; }
    if ends_with(path, pathlen, c".tar", 4)  { return "application/x-tar"; }
    if ends_with(path, pathlen, c".gz", 3)   { return "application/gzip"; }
    if ends_with(path, pathlen, c".wasm", 5) { return "application/wasm"; }
    if ends_with(path, pathlen, c".xml", 4)  { return "application/xml"; }
    if ends_with(path, pathlen, c".mp4", 4)  { return "video/mp4"; }
    if ends_with(path, pathlen, c".webm", 5) { return "video/webm"; }
    if ends_with(path, pathlen, c".mp3", 4)  { return "audio/mpeg"; }
    "application/octet-stream"
}

// ============================================================================
// HTML-escape a string for safe display (handles &, <, >, ")
// ============================================================================

fn html_escape(src: *u8, srclen: u64, dst: *u8) -> u64 {
    let mut w: u64 = 0;
    let mut r: u64 = 0;
    while r < srclen {
        let ch = rb(src, r);
        if ch == '&' {
            // &amp;
            w = bcat(dst, w, c"&amp;", 5);
        } else if ch == '<' {
            w = bcat(dst, w, c"&lt;", 4);
        } else if ch == '>' {
            w = bcat(dst, w, c"&gt;", 4);
        } else if ch == '"' {
            w = bcat(dst, w, c"&quot;", 6);
        } else {
            wb(dst, w, ch);
            w += 1;
        }
        r += 1;
    }
    w
}

// ============================================================================
// HTTP response builders
// ============================================================================

fn send_all(fd: i32, buf: *u8, len: u64) {
    let mut sent: u64 = 0;
    while sent < len {
        let n = write(fd, &buf[sent], len - sent);
        if n <= 0 { break; }
        sent += n as u64;
    }
}

fn send_headers(fd: i32, status: *u8, slen: u64, ctype: *u8, ctlen: u64, content_len: i64) {
    let hdr: [u8; 1024] = [0; 1024];
    let mut p: u64 = 0;
    p = bcatstr(&hdr as *u8, p, "HTTP/1.0 ");
    p = bcat(&hdr as *u8, p, status, slen);
    p = bcatstr(&hdr as *u8, p, "\r\nContent-Type: ");
    p = bcat(&hdr as *u8, p, ctype, ctlen);
    if content_len >= 0 {
        p = bcatstr(&hdr as *u8, p, "\r\nContent-Length: ");
        p = bcat_i64(&hdr as *u8, p, content_len);
    }
    p = bcatstr(&hdr as *u8, p, "\r\nConnection: close\r\n\r\n");
    send_all(fd, &hdr as *u8, p);
}

fn send_404(fd: i32, urlpath: *u8, pathlen: u64) {
    let body: [u8; 2048] = [0; 2048];
    let mut p: u64 = 0;
    p = bcatstr(&body as *u8, p, "<!DOCTYPE html><html><head><title>404 Not Found</title>");
    p = bcatstr(&body as *u8, p, "<style>body{font-family:sans-serif;margin:40px}</style></head>");
    p = bcatstr(&body as *u8, p, "<body><h1>404 Not Found</h1><p>The path <code>");
    let esc: [u8; 1024] = [0; 1024];
    let esclen = html_escape(urlpath, pathlen, &esc as *u8);
    p = bcat(&body as *u8, p, &esc as *u8, esclen);
    p = bcatstr(&body as *u8, p, "</code> was not found on this server.</p></body></html>");
    send_headers(fd, c"404 Not Found", 13, c"text/html; charset=utf-8", 24, p as i64);
    send_all(fd, &body as *u8, p);
}

fn send_redirect(fd: i32, location: *u8, loclen: u64) {
    let hdr: [u8; 1024] = [0; 1024];
    let mut p: u64 = 0;
    p = bcatstr(&hdr as *u8, p, "HTTP/1.0 301 Moved Permanently\r\nLocation: ");
    p = bcat(&hdr as *u8, p, location, loclen);
    p = bcatstr(&hdr as *u8, p, "\r\nConnection: close\r\n\r\n");
    send_all(fd, &hdr as *u8, p);
}

// ============================================================================
// Directory listing
// ============================================================================

// struct dirent on Linux x86-64:
//   d_ino:    u64 (offset 0)
//   d_off:    i64 (offset 8)
//   d_reclen: u16 (offset 16)
//   d_type:   u8  (offset 18)
//   d_name:  [u8] (offset 19)
// DT_DIR = 4, DT_REG = 8

fn dirent_name(ent: *u8) -> *u8 {
    &ent[19]
}

fn dirent_type(ent: *u8) -> u8 {
    rb(ent, 18)
}

fn serve_directory(fd: i32, fspath: *u8, fspathlen: u64, urlpath: *u8, urlpathlen: u64) {
    let dir = opendir(fspath);
    if dir as u64 == 0 {
        send_404(fd, urlpath, urlpathlen);
        return;
    }

    // We'll build the HTML in a large buffer (64KB should be plenty for most directories)
    let body: [u8; 65536] = [0; 65536];
    let mut p: u64 = 0;
    let maxp: u64 = 64000;

    // HTML header
    p = bcatstr(&body as *u8, p, "<!DOCTYPE html>\n<html>\n<head>\n");
    p = bcatstr(&body as *u8, p, "<meta charset=\"utf-8\">\n");
    p = bcatstr(&body as *u8, p, "<title>Directory listing for ");
    let esc: [u8; 2048] = [0; 2048];
    let esclen = html_escape(urlpath, urlpathlen, &esc as *u8);
    p = bcat(&body as *u8, p, &esc as *u8, esclen);
    p = bcatstr(&body as *u8, p, "</title>\n");
    p = bcatstr(&body as *u8, p, "<style>\n");
    p = bcatstr(&body as *u8, p, "body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; ");
    p = bcatstr(&body as *u8, p, "margin: 0; padding: 20px 40px; background: #fafafa; color: #333; }\n");
    p = bcatstr(&body as *u8, p, "h1 { font-weight: 400; border-bottom: 1px solid #ddd; padding-bottom: 10px; }\n");
    p = bcatstr(&body as *u8, p, "table { border-collapse: collapse; width: 100%; max-width: 800px; }\n");
    p = bcatstr(&body as *u8, p, "th, td { text-align: left; padding: 8px 16px; }\n");
    p = bcatstr(&body as *u8, p, "th { background: #eee; font-weight: 600; font-size: 0.85em; ");
    p = bcatstr(&body as *u8, p, "text-transform: uppercase; letter-spacing: 0.05em; }\n");
    p = bcatstr(&body as *u8, p, "tr:hover { background: #f0f0f0; }\n");
    p = bcatstr(&body as *u8, p, "a { color: #0066cc; text-decoration: none; }\n");
    p = bcatstr(&body as *u8, p, "a:hover { text-decoration: underline; }\n");
    p = bcatstr(&body as *u8, p, ".dir { font-weight: 600; }\n");
    p = bcatstr(&body as *u8, p, ".size { font-variant-numeric: tabular-nums; color: #666; }\n");
    p = bcatstr(&body as *u8, p, ".icon { width: 20px; }\n");
    p = bcatstr(&body as *u8, p, "</style>\n");
    p = bcatstr(&body as *u8, p, "</head>\n<body>\n");
    p = bcatstr(&body as *u8, p, "<h1>Directory listing for ");
    p = bcat(&body as *u8, p, &esc as *u8, esclen);
    p = bcatstr(&body as *u8, p, "</h1>\n");

    // Parent directory link (if not root)
    if urlpathlen > 1 {
        p = bcatstr(&body as *u8, p, "<p><a href=\"..\">Parent directory</a></p>\n");
    }

    p = bcatstr(&body as *u8, p, "<table>\n<tr><th class=\"icon\"></th><th>Name</th><th>Size</th></tr>\n");

    // Read entries
    loop {
        let ent = readdir(dir);
        if ent as u64 == 0 { break; }

        let name = dirent_name(ent);
        let namelen = strlen(name);

        // Skip "." and ".."
        if namelen == 1 {
            if rb(name, 0) == '.' { continue; }
        }
        if namelen == 2 {
            if rb(name, 0) == '.' {
                if rb(name, 1) == '.' { continue; }
            }
        }

        // Safety check
        if p > maxp { break; }

        let dtype = dirent_type(ent);
        let mut entry_is_dir = dtype == 4 as u8;

        // If dtype is DT_UNKNOWN (0), fall back to stat
        if dtype == 0 as u8 {
            let spath: [u8; 2048] = [0; 2048];
            let mut sp: u64 = 0;
            sp = bcat(&spath as *u8, sp, fspath, fspathlen);
            if rb(fspath, fspathlen - 1) != '/' {
                wb(&spath as *u8, sp, '/');
                sp += 1;
            }
            sp = bcat(&spath as *u8, sp, name, namelen);
            wb(&spath as *u8, sp, 0);
            let sb2: [u8; 144] = [0; 144];
            if stat(&spath as *u8, &sb2 as *u8) == 0 {
                entry_is_dir = is_dir(stat_mode(&sb2 as *u8));
            }
        }

        // Escape name for HTML
        let ename: [u8; 1024] = [0; 1024];
        let enamelen = html_escape(name, namelen, &ename as *u8);

        // Build stat path for file size
        let stpath: [u8; 2048] = [0; 2048];
        let mut stp: u64 = 0;
        stp = bcat(&stpath as *u8, stp, fspath, fspathlen);
        if rb(fspath, fspathlen - 1) != '/' {
            wb(&stpath as *u8, stp, '/');
            stp += 1;
        }
        stp = bcat(&stpath as *u8, stp, name, namelen);
        wb(&stpath as *u8, stp, 0);

        let mut filesize: i64 = 0 - 1;
        let sb3: [u8; 144] = [0; 144];
        if stat(&stpath as *u8, &sb3 as *u8) == 0 {
            filesize = stat_size(&sb3 as *u8);
        }

        // Table row
        p = bcatstr(&body as *u8, p, "<tr><td class=\"icon\">");
        p = bcatstr(&body as *u8, p, "</td><td><a ");
        if entry_is_dir { p = bcatstr(&body as *u8, p, "class=\"dir\" "); }
        p = bcatstr(&body as *u8, p, "href=\"");
        p = bcat(&body as *u8, p, &ename as *u8, enamelen);
        if entry_is_dir { p = bcatstr(&body as *u8, p, "/"); }
        p = bcatstr(&body as *u8, p, "\">");
        p = bcat(&body as *u8, p, &ename as *u8, enamelen);
        if entry_is_dir { p = bcatstr(&body as *u8, p, "/"); }
        p = bcatstr(&body as *u8, p, "</a></td><td class=\"size\">");

        if entry_is_dir {
            p = bcatstr(&body as *u8, p, "-");
        } else if filesize >= 0 {
            p = bcat_i64(&body as *u8, p, filesize);
        } else {
            p = bcatstr(&body as *u8, p, "?");
        }

        p = bcatstr(&body as *u8, p, "</td></tr>\n");
    }

    closedir(dir);

    p = bcatstr(&body as *u8, p, "</table>\n");
    p = bcatstr(&body as *u8, p, "<hr><p style=\"color:#999;font-size:0.85em\">");
    p = bcatstr(&body as *u8, p, "Tachyon HTTP Server</p>\n");
    p = bcatstr(&body as *u8, p, "</body>\n</html>\n");

    send_headers(fd, c"200 OK", 6, c"text/html; charset=utf-8", 24, p as i64);
    send_all(fd, &body as *u8, p);
}

// ============================================================================
// File serving
// ============================================================================

fn serve_file(fd: i32, fspath: *u8, fspathlen: u64, filesize: i64) {
    let filefd = open(fspath, 0);
    if filefd < 0 {
        send_404(fd, fspath, fspathlen);
        return;
    }

    let mime = guess_mime(fspath, fspathlen);
    send_headers(fd, c"200 OK", 6, mime.ptr, mime.len as u64, filesize);

    // Stream file in 8KB chunks
    let chunk: [u8; 8192] = [0; 8192];
    loop {
        let n = read(filefd, &chunk as *u8, 8192);
        if n <= 0 { break; }
        send_all(fd, &chunk as *u8, n as u64);
    }

    close(filefd);
}

// ============================================================================
// Request parsing
// ============================================================================

// Extract method and path from HTTP request line
// Returns path length (0 on error), writes path to out
fn parse_request(req: *u8, reqlen: u64, method: *u8, path: *u8) -> u64 {
    // Find first space → end of method
    let mut i: u64 = 0;
    loop {
        if i >= reqlen { return 0 as u64; }
        if rb(req, i) == ' ' { break; }
        i += 1;
    }
    // Copy method
    memcpy(method, req, i);
    wb(method, i, 0);
    let mlen = i;

    // Skip space
    i += 1;
    let path_start = i;

    // Find next space or ? (query string) → end of path
    while i < reqlen {
        let ch = rb(req, i);
        if ch == ' ' { break; }
        if ch == '?' { break; }
        i += 1;
    }

    let pathlen = i - path_start;
    memcpy(path, &req[path_start], pathlen);
    wb(path, pathlen, 0);

    pathlen
}

// ============================================================================
// Handle a single HTTP request
// ============================================================================

fn handle_request(cfd: i32, root: *u8, rootlen: u64) {
    let reqbuf: [u8; 8192] = [0; 8192];
    let n = read(cfd, &reqbuf as *u8, 8191);
    if n <= 0 {
        close(cfd);
        return;
    }

    // Parse request
    let method: [u8; 16] = [0; 16];
    let urlpath: [u8; 2048] = [0; 2048];
    let pathlen = parse_request(&reqbuf as *u8, n as u64, &method as *u8, &urlpath as *u8);

    if pathlen == 0 {
        send_404(cfd, c"/", 1);
        close(cfd);
        return;
    }

    // URL decode the path
    let decoded_len = url_decode(&urlpath as *u8, pathlen);

    // Log request to stderr
    write(2, &method as *u8, strlen(&method as *u8));
    write(2, c" ", 1);
    write(2, &urlpath as *u8, decoded_len);

    // Build filesystem path
    let fspath: [u8; 4096] = [0; 4096];
    let fspathlen = build_path(root, rootlen, &urlpath as *u8, decoded_len, &fspath as *u8);

    // Stat the path
    let sb: [u8; 144] = [0; 144];
    let sr = stat(&fspath as *u8, &sb as *u8);
    if sr < 0 {
        write(2, c" 404\n", 5);
        send_404(cfd, &urlpath as *u8, decoded_len);
        close(cfd);
        return;
    }

    let mode = stat_mode(&sb as *u8);
    let fsize = stat_size(&sb as *u8);

    if is_dir(mode) {
        // Directory: ensure trailing slash
        if has_trailing_slash(&urlpath as *u8, decoded_len) == false {
            // Redirect to path with trailing slash
            let redir: [u8; 2048] = [0; 2048];
            let mut rp: u64 = 0;
            rp = bcat(&redir as *u8, rp, &urlpath as *u8, decoded_len);
            wb(&redir as *u8, rp, '/');
            rp += 1;
            write(2, c" 301\n", 5);
            send_redirect(cfd, &redir as *u8, rp);
            close(cfd);
            return;
        }

        // Check for index.html
        let idx: [u8; 4096] = [0; 4096];
        let mut ip: u64 = 0;
        ip = bcat(&idx as *u8, ip, &fspath as *u8, fspathlen);
        if rb(&fspath as *u8, fspathlen - 1) != '/' {
            wb(&idx as *u8, ip, '/');
            ip += 1;
        }
        ip = bcatstr(&idx as *u8, ip, "index.html");
        wb(&idx as *u8, ip, 0);

        let isb: [u8; 144] = [0; 144];
        let isr = stat(&idx as *u8, &isb as *u8);
        if isr == 0 {
            if is_regular(stat_mode(&isb as *u8)) {
                write(2, c" 200 (index.html)\n", 18);
                serve_file(cfd, &idx as *u8, ip, stat_size(&isb as *u8));
                close(cfd);
                return;
            }
        }

        write(2, c" 200 (dir)\n", 11);
        serve_directory(cfd, &fspath as *u8, fspathlen, &urlpath as *u8, decoded_len);
    } else {
        write(2, c" 200 (", 6);
        let mime = guess_mime(&fspath as *u8, fspathlen);
        write(2, mime.ptr, mime.len as u64);
        write(2, c")\n", 2);
        serve_file(cfd, &fspath as *u8, fspathlen, fsize);
    }

    close(cfd);
}

// ============================================================================
// Main — create socket, bind, listen, accept loop
// ============================================================================

fn main() -> i32 {
    // Resolve root directory: use argv[1] if given, else cwd
    // Since we can't easily access argv in Tachyon, we serve the cwd.
    // The user should chdir before running, or we accept the path via a trick:
    // we read /proc/self/cmdline to get argv.

    let root: [u8; 4096] = [0; 4096];
    let mut rootlen: u64 = 0;

    // Try to get argv[1] from /proc/self/cmdline
    let cmdline: [u8; 8192] = [0; 8192];
    let cmdfd = open(c"/proc/self/cmdline", 0);
    let mut got_arg = false;
    if cmdfd >= 0 {
        let clen = read(cmdfd, &cmdline as *u8, 8191);
        close(cmdfd);
        if clen > 0 {
            // cmdline is null-separated: argv[0]\0argv[1]\0...
            // Skip argv[0]
            let mut i: u64 = 0;
            while i < clen as u64 {
                if rb(&cmdline as *u8, i) == 0 as u8 { break; }
                i += 1;
            }
            i += 1; // skip the null
            if i < clen as u64 {
                // We have argv[1]
                let argstart = i;
                while i < clen as u64 {
                    if rb(&cmdline as *u8, i) == 0 as u8 { break; }
                    i += 1;
                }
                let arglen = i - argstart;
                if arglen > 0 {
                    // Resolve to absolute path
                    let resolved: [u8; 4096] = [0; 4096];
                    let rp = realpath(&cmdline[argstart], &resolved as *u8);
                    if rp as u64 != 0 {
                        rootlen = strlen(&resolved as *u8);
                        memcpy(&root as *u8, &resolved as *u8, rootlen);
                        got_arg = true;
                    }
                }
            }
        }
    }

    if got_arg == false {
        // Fall back to cwd
        let cwd = getcwd(&root as *u8, 4096);
        if cwd as u64 == 0 {
            write(2, c"error: cannot get cwd\n", 22);
            return 1;
        }
        rootlen = strlen(&root as *u8);
    }

    write(2, c"Serving ", 8);
    write(2, &root as *u8, rootlen);
    write(2, c"\n", 1);

    // Create socket
    let sfd = socket(2, 1, 0);
    if sfd < 0 {
        write(2, c"error: socket() failed\n", 23);
        return 1;
    }

    // SO_REUSEADDR
    let one: i32 = 1;
    setsockopt(sfd, 1, 2, &one as *u8, 4 as u32);

    // Bind to 127.0.0.1:8000
    let sa: [u8; 16] = [0; 16];
    let sap = &sa as *u8;
    *(sap as *u16) = 2 as u16;                         // AF_INET
    *((sap as u64 + 2) as *u16) = htons(8000 as u16);  // port 8000
    *((sap as u64 + 4) as *u32) = 0x0100007f as u32;   // 127.0.0.1

    if bind(sfd, sap, 16 as u32) < 0 {
        write(2, c"error: bind() failed (port 8000 in use?)\n", 41);
        close(sfd);
        return 1;
    }

    if listen(sfd, 128) < 0 {
        write(2, c"error: listen() failed\n", 23);
        close(sfd);
        return 1;
    }

    write(2, c"Serving HTTP on http://127.0.0.1:8000/ ...\n", 43);

    // Accept loop
    loop {
        let cfd = accept(sfd, 0 as *u8, 0 as *u32);
        if cfd < 0 { continue; }
        handle_request(cfd, &root as *u8, rootlen);
    }

    close(sfd);
    0
}
