// Units of length: one struct per unit, so a value in feet cannot be
// added to one in metres by mistake. `From` converts, operator traits
// give + - and unary -, `Ord` gives < and >.
use std::Fmt;

pub struct Meters { pub m: f64 }
pub struct Feet { pub ft: f64 }

const FEET_PER_METER: f64 = 3.28084;

impl From<Feet> for Meters {
    fn from(f: Feet) -> Meters { Meters { m: f.ft / FEET_PER_METER } }
}

impl From<Meters> for Feet {
    fn from(m: Meters) -> Feet { Feet { ft: m.m * FEET_PER_METER } }
}

impl Add for Meters {
    fn add(self, o: Meters) -> Meters { Meters { m: self.m + o.m } }
}

impl Sub for Meters {
    fn sub(self, o: Meters) -> Meters { Meters { m: self.m - o.m } }
}

impl Neg for Meters {
    fn neg(self) -> Meters { Meters { m: -self.m } }
}

// Ord's cmp returns negative, zero or positive; < <= > >= follow from it.
impl Ord for Meters {
    fn cmp(self, o: Meters) -> i64 {
        if self.m < o.m { -1 } else if self.m > o.m { 1 } else { 0 }
    }
}

impl Display for Meters {
    fn fmt(self, f: inout Fmt) { f.write(f"{self.m:.2} m"); }
}

impl Display for Feet {
    fn fmt(self, f: inout Fmt) { f.write(f"{self.ft:.2} ft"); }
}

// An area: what a length times a length is.
pub struct SquareMeters { pub m2: f64 }

impl Display for SquareMeters {
    fn fmt(self, f: inout Fmt) { f.write(f"{self.m2:.2} m2"); }
}

// Any length given in a unit that converts to metres: `T: Into<Meters>`
// holds for every T with `impl From<T> for Meters` (Meters itself too).
pub fn total<T: Into<Meters>>(lengths: [T]) -> Meters {
    var sum = Meters { m: 0.0 };
    for x in lengths {
        let m: Meters = x.into(); // Into needs the target type: here, the let's
        sum = sum + m;
    }
    sum
}
