// A small geometry and units library, used: traits with default methods,
// generic functions with bounds, an associated type, derived and
// hand-written trait impls, operator overloading, and From/Into between
// unit types. The library is two modules, geometry.tach and units.tach.
mod geometry;
mod units;

use geometry::{
    AnyShape, Circle, HALF_TURN, Measured, Polygon, ROTATE_90, Rect, Segment, Shape, Vec2,
};
use std::{HashMap, sort};
use units::{Feet, Meters, total};

// Generic over any Shape: the bound lets the body call area().
fn total_area<T: Shape>(shapes: [T]) -> f64 {
    let mut total = 0.0;
    for s in shapes { total += s.area(); } // s: each element in place
    total
}

// Generic over any Ord: the largest element, or None for an empty slice.
fn largest<T: Ord>(xs: [T]) -> Option<T> {
    if xs.len() == 0 { return None; }
    let mut best = xs[0];
    for x in xs { if x > best { best = x; } }
    Some(best)
}

// Generic over the associated type: T::Output is whatever T measures to.
// The body is checked per instance, so printing it needs T::Output to
// have Display only for the T's actually used.
fn show<T: Measured>(label: [u8], x: &T) {
    let m: T::Output = x.measure();
    println(f"{label:<10} {m}");
}

fn main(gpa: Gpa) -> i32 {
    println("== vectors (operators, derive)");
    let a = Vec2::new(3, 4);
    let b = Vec2::new(-1, 2);
    println(f"a + b = {a + b}, a - b = {a - b}, -a = {-a}");
    println(f"a.dot(b) = {a.dot(b)}, |a| = {a.length()}, a == b: {a == b}, a > b: {a > b}");
    println(f"debug: {a:?}");
    let turn = ROTATE_90 * ROTATE_90; // * on Mat2: composition
    println(f"rotate a by 90: {ROTATE_90.apply(a)}, by 180: {turn.apply(a)}");
    println(f"rotating twice is a half turn: {turn == HALF_TURN}, {turn:?}");

    println("== sorting and hashing (derive(Ord, Hash))");
    let at = Vec2::new; // a function as a value
    let mut points = [at(2, 1), at(0, 5), at(2, 0), at(0, 5), at(-3, 3)];
    points.sort(); // by x, then y: the field order
    print("sorted:");
    for p in points { print(f" {p}"); }
    println("");
    let mut seen: HashMap<Vec2, i64> = HashMap::new_in(gpa);
    for p in points { seen.get_or_insert(p, 0)[0] += 1; }
    println(f"distinct: {seen.len()}, (0, 5) seen {seen.get(Vec2::new(0, 5)).unwrap_or(0)} times");
    let nothing: [i64; 0] = [0; 0];
    println(f"largest point: {largest(points[..]):?}, of nothing: {largest(nothing[..]):?}");

    println("== shapes (a trait, defaults, generics)");
    let circle = Circle { center: Vec2::new(0, 0), r: 2 };
    let rect = Rect { min: Vec2::new(0, 0), max: Vec2::new(4, 3) };
    let mut triangle = Polygon { points: Vec::new_in(gpa) };
    for p in [Vec2::new(0, 0), Vec2::new(4, 0), Vec2::new(0, 3)] { triangle.points.push(p); }
    circle.describe();
    rect.describe();
    triangle.describe(); // Polygon keeps the default name, "shape"

    let rects = [rect, Rect { min: Vec2::new(1, 1), max: Vec2::new(2, 3) }];
    println(f"total area of the rects: {total_area(rects[..]):.2}");
    let shapes = [AnyShape::C(circle), AnyShape::R(rect), AnyShape::P(triangle.clone())];
    println(f"total area of everything: {total_area(shapes[..]):.2}");

    // Clone of a struct with a Vec field copies the Vec (derive(Clone)).
    let mut bigger = triangle.clone();
    bigger.points.set(1, Vec2::new(8, 0));
    println(f"stretched clone: area {bigger.area():.1}, the original: {triangle.area():.1}");
    println(f"{bigger:?}");

    println("== units (From, Into, an associated type)");
    let run = Meters { m: 5000.0 };
    let tower = Feet { ft: 1063.0 };
    let tower_m: Meters = tower.into();
    let run_ft = Feet::from(run);
    println(f"{run} is {run_ft}; {tower} is {tower_m}");
    let limit = Meters { m: 300.0 };
    println(f"taller than {limit}? {tower_m > limit}");
    println(f"difference: {run - tower_m}, negated: {-(run - tower_m)}");
    let laps = [Feet { ft: 1312.34 }, Feet { ft: 656.17 }];
    println(f"two laps: {total(laps[..])}, in metres already: {total([run, tower_m][..])}");
    let diagonal = Segment { a: rect.min, b: rect.max };
    show("diagonal", &diagonal); // Segment::Output is Meters
    show("rect", &rect); // Rect::Output is SquareMeters
    0
}
