// Points, a 2x2 matrix, shapes, and two traits over them.
use crate::units::{Meters, SquareMeters};
use std::Fmt;

extern "C" {
    fn sqrt(x: f64) -> f64;
}

pub const PI: f64 = 3.141592653589793;

// A safe wrapper: sqrt of any f64 is defined (NaN for a negative).
pub fn square_root(x: f64) -> f64 { unsafe { sqrt(x) } }

// derive writes == (Eq), < (Ord: x, then y), hashing (a HashMap key),
// {:?} (Debug) and .clone().
#[derive(Eq, Ord, Hash, Debug, Clone)]
pub struct Vec2 { pub x: i64, pub y: i64 }

impl Vec2 {
    pub fn new(x: i64, y: i64) -> Vec2 { Vec2 { x, y } }
    pub fn dot(self: Vec2, o: Vec2) -> i64 { self.x * o.x + self.y * o.y }
    pub fn cross(self: Vec2, o: Vec2) -> i64 { self.x * o.y - self.y * o.x }
    pub fn length(self: Vec2) -> f64 { square_root(self.dot(self) as f64) }
}

impl Add for Vec2 {
    fn add(self: Vec2, o: Vec2) -> Vec2 { Vec2 { x: self.x + o.x, y: self.y + o.y } }
}

impl Sub for Vec2 {
    fn sub(self: Vec2, o: Vec2) -> Vec2 { Vec2 { x: self.x - o.x, y: self.y - o.y } }
}

impl Neg for Vec2 {
    fn neg(self: Vec2) -> Vec2 { Vec2 { x: -self.x, y: -self.y } }
}

impl Display for Vec2 {
    fn fmt(self: &Vec2, f: &mut Fmt) { f.write(f"({self.x}, {self.y})"); }
}

// A linear map of the plane. `*` composes two maps: (a * b).apply(p) is
// a.apply(b.apply(p)).
#[derive(Eq, Debug)]
pub struct Mat2 { pub a: i64, pub b: i64, pub c: i64, pub d: i64 }

// (a const holds numbers, bools and strings; a struct value is a static)
pub static ROTATE_90: Mat2 = Mat2 { a: 0, b: -1, c: 1, d: 0 };
pub static HALF_TURN: Mat2 = Mat2 { a: -1, b: 0, c: 0, d: -1 };

impl Mat2 {
    pub fn apply(self: Mat2, p: Vec2) -> Vec2 {
        Vec2 { x: self.a * p.x + self.b * p.y, y: self.c * p.x + self.d * p.y }
    }
}

impl Mul for Mat2 {
    fn mul(self: Mat2, o: Mat2) -> Mat2 {
        Mat2 {
            a: self.a * o.a + self.b * o.c,
            b: self.a * o.b + self.b * o.d,
            c: self.c * o.a + self.d * o.c,
            d: self.c * o.b + self.d * o.d,
        }
    }
}

// ---- Shapes ----

// What every shape can do. `name` and `describe` have default bodies:
// an impl may keep them or write its own.
pub trait Shape {
    fn area(self: &Self) -> f64;
    fn perimeter(self: &Self) -> f64;
    fn name(self: &Self) -> [u8] { "shape" }

    fn describe(self: &Self) {
        println(f"{self.name():<8} area {self.area():>7.2}  perimeter {self.perimeter():>6.2}");
    }
}

pub struct Circle { pub center: Vec2, pub r: i64 }
pub struct Rect { pub min: Vec2, pub max: Vec2 }

#[derive(Debug, Clone)]
pub struct Polygon { pub points: Vec<Vec2> }

impl Shape for Circle {
    fn area(self: &Circle) -> f64 { PI * (self.r * self.r) as f64 }
    fn perimeter(self: &Circle) -> f64 { 2.0 * PI * self.r as f64 }
    fn name(self: &Circle) -> [u8] { "circle" }
}

impl Shape for Rect {
    fn area(self: &Rect) -> f64 {
        let d = self.max - self.min;
        (d.x * d.y) as f64
    }

    fn perimeter(self: &Rect) -> f64 {
        let d = self.max - self.min;
        (2 * (d.x + d.y)) as f64
    }

    // overrides the default `name`
    fn name(self: &Rect) -> [u8] { "rect" }
}

impl Polygon {
    // The polygon's edges, in order, each from a vertex to the next.
    pub fn edges(self: &Polygon) -> Edges { Edges { points: self.points.as_slice(), i: 0 } }
}

impl Shape for Polygon {
    // The shoelace formula: half the sum of the edges' cross products.
    fn area(self: &Polygon) -> f64 {
        let twice = self.edges().map(|(a, b)| a.cross(b)).sum();
        (if twice < 0 { -twice } else { twice }) as f64 / 2.0
    }

    fn perimeter(self: &Polygon) -> f64 {
        self.edges().fold(0.0, |acc, (a, b)| acc + (b - a).length())
    }
    // `name` is left out: Polygon gets the trait's default, "shape".
}

// An iterator of our own: its associated type `Item` is a pair of points.
pub struct Edges { points: [Vec2], i: i64 }

impl Iterator for Edges {
    type Item = (Vec2, Vec2);

    fn next(self: &mut Edges) -> Option<(Vec2, Vec2)> {
        let n = self.points.len;
        if self.i >= n { return None; }
        let edge = (self.points[self.i], self.points[(self.i + 1) % n]);
        self.i += 1;
        Some(edge)
    }
}

// No trait objects: a list of mixed shapes is an enum of the cases, and
// the enum implements the trait by dispatching with match.
pub enum AnyShape { C(Circle), R(Rect), P(Polygon) }

impl Shape for AnyShape {
    fn area(self: &AnyShape) -> f64 {
        match *self {
            AnyShape::C(c) => c.area(),
            AnyShape::R(r) => r.area(),
            AnyShape::P(p) => p.area(),
        }
    }

    fn perimeter(self: &AnyShape) -> f64 {
        match *self {
            AnyShape::C(c) => c.perimeter(),
            AnyShape::R(r) => r.perimeter(),
            AnyShape::P(p) => p.perimeter(),
        }
    }

    fn name(self: &AnyShape) -> [u8] {
        match *self {
            AnyShape::C(c) => c.name(),
            AnyShape::R(r) => r.name(),
            AnyShape::P(p) => p.name(),
        }
    }
}

// ---- Measuring: a trait with an associated type ----

// What `measure` returns depends on the implementing type: a segment
// has a length, a rectangle an area.
pub trait Measured {
    type Output;
    fn measure(self: &Self) -> Self::Output;
}

pub struct Segment { pub a: Vec2, pub b: Vec2 }

impl Measured for Segment {
    type Output = Meters;
    fn measure(self: &Segment) -> Meters { Meters { m: (self.b - self.a).length() } }
}

impl Measured for Rect {
    type Output = SquareMeters;
    fn measure(self: &Rect) -> SquareMeters { SquareMeters { m2: self.area() } }
}
