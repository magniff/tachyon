// Conway's Game of Life in the terminal: a torus the size of the window,
// random at first. Each frame is built in a std Buf and written at once.
// ANSI 24-bit color: live cells are white, dead ones fade from blue to
// black with the time since they died.
//
// It runs on Linux and macOS, built for either from either: the one
// difference it meets, the number of the ioctl that asks for the window
// size, is chosen at run time by uname().
extern "C" {
    fn write(fd: i32, buf: *u8, count: u64) -> i64;
    fn rand() -> i32;
    fn srand(seed: u32);
    fn time(t: *i64) -> i64;
    fn ioctl(fd: i32, request: u64, ...) -> i32;
    fn uname(name: *u8) -> i32;
}

use std::Buf;

// struct winsize, the same on both systems.
#[repr(C)]
struct Winsize { rows: u16, cols: u16, xpixel: u16, ypixel: u16 }

const TIOCGWINSZ_LINUX: u64 = 0x5413;
const TIOCGWINSZ_MACOS: u64 = 0x40087468; // _IOR('t', 104, struct winsize)

fn on_macos() -> bool {
    // struct utsname starts with the system's name on both systems (its
    // fields are 65 bytes long on Linux, 256 on macOS)
    var names: [u8; 1280] = [0; 1280];
    if unsafe { uname(&names as *u8) != 0 } {
        return false;
    }
    names[0..6] == "Darwin"
}

// `age`: the generations since the cell died, up to 255.
struct Cell { alive: bool, age: u8 }

struct World { width: i64, height: i64, cells: Vec<Cell>, next: Vec<Cell> }

impl World {
    fn random(width: i64, height: i64, gpa: Gpa) -> World {
        var world = World { width, height, cells: Vec::new_in(gpa), next: Vec::new_in(gpa) };
        for _ in 0..width * height {
            let cell = unsafe { Cell { alive: rand() % 2 == 0, age: 0 } };
            world.cells.push(cell);
            world.next.push(cell);
        }
        world
    }

    // The cell at (x, y), the edges wrapping around.
    fn alive(self, x: i64, y: i64) -> bool {
        let wx = (x + self.width) % self.width;
        let wy = (y + self.height) % self.height;
        self.cells[wy * self.width + wx].alive
    }

    fn neighbours(self, x: i64, y: i64) -> i64 {
        var n = 0;
        for dy in -1..=1 {
            for dx in -1..=1 {
                if (dx != 0 || dy != 0) && self.alive(x + dx, y + dy) {
                    n += 1;
                }
            }
        }
        n
    }

    fn step(inout self) {
        for y in 0..self.height {
            for x in 0..self.width {
                let i = y * self.width + x;
                let cell = self.cells[i];
                let n = self.neighbours(x, y);
                let next = if cell.alive {
                    if n == 2 || n == 3 { cell } else { Cell { alive: false, age: 1 } }
                } else if n == 3 {
                    Cell { alive: true, age: 0 }
                } else if cell.age < 255 {
                    Cell { alive: false, age: cell.age + 1 }
                } else {
                    cell
                };
                self.next[i] = next;
            }
        }
        // the two buffers trade places, nothing copied
        let old = self.cells.take();
        self.cells = std::replace(&self.next, old);
    }

    // One character cell per cell, row after row, the terminal wrapping
    // the lines; then the cursor back home.
    fn render(self, out: inout Buf) {
        out.clear();
        for cell in self.cells.as_slice() {
            if cell.alive {
                out.push_str("\x1B[48;2;255;255;255m ");
            } else {
                // blue fading to black: the red, green and blue of the
                // background color
                let color = 255 - cell.age as i64;
                out.push_fmt(f"\x1B[48;2;{color / 2};{color / 5};{color}m ");
            }
        }
        out.push_str("\x1B[1;1H");
    }
}

fn write_all(bytes: [u8]) {
    var at = 0;
    while at < bytes.len() {
        let n = unsafe { write(1, &bytes[at], (bytes.len() - at) as u64) };
        if n <= 0 {
            return;
        }
        at += n;
    }
}

fn main(gpa: Gpa) -> i32 {
    unsafe { srand(time(0 as *i64) as u32); }

    var size = Winsize { rows: 0, cols: 0, xpixel: 0, ypixel: 0 };
    let request = if on_macos() { TIOCGWINSZ_MACOS } else { TIOCGWINSZ_LINUX };
    if unsafe { ioctl(1, request, &size) != 0 } {
        println("ioctl failed");
        return 1;
    }

    var world = World::random(size.cols as i64, size.rows as i64, gpa);
    var frame = Buf::new_in(gpa);
    print("\x1B[?25l");
    loop {
        world.render(&frame);
        write_all(frame.as_slice());
        world.step();
    }
}
