// c-libc-tour: the C library through its own headers. `import "x.h" as c`
// reads the system's headers for the target, so the structs (struct tm,
// struct stat, struct dirent) have the layout of this system's libc,
// whichever it is; the program is the same on macOS and Linux.
//
// usage: c-libc-tour [DIR...]   (no DIR: a tour, in a directory it makes)
import "stdlib.h" as c;
import "stdio.h" as c;
import "string.h" as c;
import "time.h" as c;
import "unistd.h" as c;
import "dirent.h" as c;
import "sys/stat.h" as c;

use std::Buf;

// ---- between tachyon text and C strings ----------------------------------

// A tachyon slice as a C string: C wants the NUL a slice does not have,
// so the bytes are copied into a Buf with a 0 after them. Pass
// `s.as_slice().ptr` to C; free the Buf after.
fn cstring(s: [u8], gpa: Gpa) -> Buf {
    let mut b = Buf::new_in(gpa);
    b.push_str(s);
    b.push(0);
    b
}

// The C string "DIR/NAME", for the file NAME in the directory DIR.
fn c_path(dir: [u8], name: [u8], gpa: Gpa) -> Buf {
    let mut b = format_in(f"{dir}/{name}", gpa);
    b.push(0);
    b
}

// A C string's text, copied into a Buf (the caller frees it): C may
// reuse its memory (readdir and getenv may), a Buf is ours.
//
// Unsafe: `p` must point to a NUL-terminated string.
unsafe fn owned(p: *u8, gpa: Gpa) -> Buf {
    let mut b = Buf::new_in(gpa);
    b.push_cstr(p);
    b
}

// A struct stat of zero bytes, to be filled in by C: it has no tachyon
// constructor, and its fields differ between systems. (A generic
// `zeroed<T>` would serve any C struct; `-S` assembly output cannot
// name an instance of one with a C type yet, so this one is for stat.)
//
// Unsafe: it calls C, and trusts calloc to return zeroed memory.
unsafe fn zeroed_stat() -> c::stat {
    let p = c::calloc(1, size_of(c::stat) as u64) as *c::stat;
    let value = *p;
    c::free(p as *u8);
    value
}

// ---- the environment ---------------------------------------------------------

// getenv's NULL becomes None.
fn env(name: [u8], gpa: Gpa) -> Option<Buf> {
    let mut cname = cstring(name, gpa);
    defer cname.free();
    let p = unsafe { c::getenv(cname.as_slice().ptr) };
    if p == 0 as *u8 { None } else { Some(unsafe { owned(p, gpa) }) }
}

fn set_env(name: [u8], value: [u8], gpa: Gpa) {
    let mut cname = cstring(name, gpa);
    defer cname.free();
    let mut cvalue = cstring(value, gpa);
    defer cvalue.free();
    unsafe { c::setenv(cname.as_slice().ptr, cvalue.as_slice().ptr, 1); }
}

fn environment(gpa: Gpa) {
    println("== environment");
    set_env("TOUR_GREETING", "hello from setenv", gpa);
    let mut greeting = env("TOUR_GREETING", gpa);
    println(f"TOUR_GREETING = {greeting:?}");
    if let Some(mut b) = greeting { b.free(); }
    unsafe { c::unsetenv(c"TOUR_MISSING"); }
    println(f"TOUR_MISSING  = {env("TOUR_MISSING", gpa):?}");
    let entries = match env("PATH", gpa) {
        Some(path) => {
            let mut path = path;
            let mut dirs = std::split_in(path.as_slice(), ':', gpa);
            let n = dirs.len();
            dirs.free();
            path.free();
            n
        }
        None => 0,
    };
    println(f"PATH is set: {entries > 0}");
}

// ---- time ----------------------------------------------------------------------

// strftime into a stack buffer; the text as a Buf.
fn format_time(format: [u8], t: *c::tm, gpa: Gpa) -> Buf {
    let mut cformat = cstring(format, gpa);
    defer cformat.free();
    let mut out: [u8; 128] = [0; 128];
    let n = unsafe { c::strftime(&out as *u8, 128, cformat.as_slice().ptr, t) };
    let mut b = Buf::new_in(gpa);
    b.push_str(out[0..n as i64]);
    b
}

// localtime follows $TZ: tzset reads it again.
fn use_zone(zone: [u8], gpa: Gpa) {
    set_env("TZ", zone, gpa);
    unsafe { c::tzset(); }
}

fn show_in_zone(zone: [u8], when: i64, gpa: Gpa) {
    use_zone(zone, gpa);
    // localtime returns a pointer to a static struct tm: copy it out.
    let parts: c::tm = unsafe { *c::localtime(&when) };
    let mut text = format_time("%Y-%m-%d %H:%M:%S %z", &parts, gpa);
    defer text.free();
    let offset = parts.tm_gmtoff;
    let sign = if offset < 0 { "-" } else { "+" };
    let minutes = if offset < 0 { -offset / 60 } else { offset / 60 };
    println(f"  {zone:<9} {text.as_slice()}  (UTC{sign}{minutes / 60}:{minutes % 60:02})");
}

fn time_demo(gpa: Gpa) {
    println("== time");
    // A fixed moment, so the output is the same on every run.
    let when: i64 = 1234567890;
    let mut utc: c::tm = unsafe { *c::gmtime(&when) };
    let mut long = format_time("%A, %d %B %Y, %H:%M:%S UTC", &utc, gpa);
    defer long.free();
    println(f"{when} is {long.as_slice()}");
    println(
        f"  struct tm: year {utc.tm_year + 1900}, month {utc.tm_mon + 1}, day {utc.tm_yday + 1} of the year, weekday {utc.tm_wday}");
    // POSIX zone strings (name, offset west of UTC) need no zone database.
    for zone in ["UTC0", "JST-9", "NPT-5:45", "<-03>3"] { show_in_zone(zone, when, gpa); }
    // mktime goes back from a struct tm (local time) to seconds, and
    // normalizes it: day 113 of February is in May.
    use_zone("UTC0", gpa);
    utc.tm_mday += 100;
    let later = unsafe { c::mktime(&utc) };
    let mut date = format_time("%Y-%m-%d, a %A", &utc, gpa);
    defer date.free();
    println(f"100 days later: {date.as_slice()} ({later - when} seconds later)");
}

// ---- files and directories ------------------------------------------------------

struct Entry { name: Buf, size: i64, mode: u32 }

fn is_dir(mode: u32) -> bool {
    (mode as i32 & c::S_IFMT) == c::S_IFDIR
}

// "drwxr-xr-x", as ls prints it.
fn mode_text(mode: u32, out: *Buf) {
    out.push(if is_dir(mode) { 'd' } else { '-' });
    let letters = "rwxrwxrwx";
    for i in 0..9 {
        let bit = 1u32 << (8 - i) as u32;
        out.push(if mode & bit != 0 { letters[i] } else { '-' });
    }
}

// The entries of `dir` but . and .., sorted by name, with their sizes and
// modes; None if it cannot be opened. Free them with free_entries.
fn list(dir: [u8], gpa: Gpa) -> Option<Vec<Entry>> {
    let mut cdir = cstring(dir, gpa);
    defer cdir.free();
    let d = unsafe { c::opendir(cdir.as_slice().ptr) };
    if d == 0 as *c::DIR {
        return None;
    }
    defer unsafe { c::closedir(d); };
    let mut entries: Vec<Entry> = Vec::new_in(gpa);
    loop {
        let ent = unsafe { c::readdir(d) };
        if ent == 0 as *c::dirent {
            break;
        }
        // d_name is a char array inside the struct readdir returns
        let name_ptr = unsafe { &ent.d_name as *u8 };
        let name = unsafe { owned(name_ptr, gpa) };
        if name.as_slice() == "." || name.as_slice() == ".." {
            let mut name = name;
            name.free();
            continue;
        }
        entries.push(Entry { name: name, size: 0, mode: 0 });
    }
    // readdir's order is the file system's: sort by name.
    entries.sort_by(|a, b| {
        let x = a.name.as_slice();
        let y = b.name.as_slice();
        x.cmp(&y)
    });
    for i in 0..entries.len() {
        let mut e = entries.get(i);
        let mut path = c_path(dir, e.name.as_slice(), gpa);
        defer path.free();
        let mut st: c::stat = unsafe { zeroed_stat() };
        if unsafe { c::stat(path.as_slice().ptr, &st) } == 0 {
            e.size = st.st_size;
            e.mode = st.st_mode; // u16 on macOS, u32 on Linux: it widens
        }
        entries.set(i, e);
    }
    Some(entries)
}

fn free_entries(entries: *Vec<Entry>) {
    for i in 0..entries.len() {
        let mut e = entries.get(i);
        e.name.free();
    }
    entries.free();
}

fn print_listing(title: [u8], entries: *Vec<Entry>, gpa: Gpa) {
    println(f"{title}: {entries.len()} entries");
    let mut line = Buf::new_in(gpa);
    defer line.free();
    for e in entries.iter() {
        line.clear();
        mode_text(e.mode, &line);
        // (a directory's size is the file system's business: 64 on
        // APFS, 4096 on ext4)
        if is_dir(e.mode) {
            line.push_fmt(f" {"<dir>":>6}  {e.name.as_slice()}/");
        } else {
            line.push_fmt(f" {e.size:>6}  {e.name.as_slice()}");
        }
        println(line.as_slice());
    }
    let bytes = entries.iter().filter(|e| !is_dir(e.mode)).map(|e| e.size).sum();
    println(f"total {bytes} bytes in files");
}

// Writes `text` to the file `name` in `dir` with stdio and gives it the
// permissions `mode` (not left to the umask); false if it cannot.
fn write_file(dir: [u8], name: [u8], text: [u8], mode: u16, gpa: Gpa) -> bool {
    let mut cpath = c_path(dir, name, gpa);
    defer cpath.free();
    let f = unsafe { c::fopen(cpath.as_slice().ptr, c"w") };
    if f == 0 as *c::FILE {
        return false;
    }
    unsafe {
        c::fwrite(text.ptr, 1, text.len as u64, f);
        c::fclose(f);
        c::chmod(cpath.as_slice().ptr, mode) == 0
    }
}

// Permission bits (tachyon has no octal literals: 0755 is 0x1ed).
const RWXR_XR_X: u16 = 0x1ed;
const RW_R__R__: u16 = 0x1a4;
const RW_______: u16 = 0x180;

fn files_demo(gpa: Gpa) {
    println("== files");
    // mkdtemp replaces the XXXXXX in place: the template must be ours.
    let mut template = cstring("/tmp/c-libc-tour.XXXXXX", gpa);
    defer template.free();
    if unsafe { c::mkdtemp(template.as_slice().ptr) } == 0 as *u8 {
        println("mkdtemp failed");
        return;
    }
    let dir = template.as_slice()[0..template.len() - 1]; // without the NUL
    let made = write_file(dir, "notes.txt", "remember the NUL\n", RW_______, gpa)
        && write_file(dir, "data.csv", "a,b\n1,2\n3,4\n", RW_R__R__, gpa)
        && write_file(dir, "empty", "", RW_R__R__, gpa);
    let mut sub = c_path(dir, "subdir", gpa);
    defer sub.free();
    unsafe {
        c::mkdir(sub.as_slice().ptr, RWXR_XR_X);
        c::chmod(sub.as_slice().ptr, RWXR_XR_X); // mkdir's mode is masked by the umask
    }
    println(f"made three files and a directory: {made}");

    match list(dir, gpa) {
        Some(entries) => {
            let mut entries = entries;
            print_listing("the directory", &entries, gpa);
            // clean up: files with unlink, directories with rmdir
            for e in entries.iter() {
                let mut path = c_path(dir, e.name.as_slice(), gpa);
                defer path.free();
                unsafe {
                    if is_dir(e.mode) { c::rmdir(path.as_slice().ptr); }
                    else { c::unlink(path.as_slice().ptr); }
                }
            }
            free_entries(&entries);
        }
        None => println("cannot list it"),
    }
    let removed = unsafe { c::rmdir(template.as_slice().ptr) } == 0;
    println(f"removed it again: {removed}");
}

fn main(argc: i32, argv: **u8, gpa: Gpa) -> i32 {
    if argc > 1 {
        for k in 1..argc as i64 {
            let mut dir = unsafe { owned(argv[k], gpa) };
            defer dir.free();
            match list(dir.as_slice(), gpa) {
                Some(entries) => {
                    let mut entries = entries;
                    print_listing(dir.as_slice(), &entries, gpa);
                    free_entries(&entries);
                }
                None => eprintln(f"cannot open {dir.as_slice()}"),
            }
        }
        return 0;
    }
    environment(gpa);
    time_demo(gpa);
    files_demo(gpa);
    0
}
