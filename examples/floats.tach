extern fn printf(template: *u8, value: f64);
extern fn pow(value: f64, exponent: f64) -> f64;
extern fn sqrt(value: f64) -> f64;

struct Point {
    x: f64,
    y: f64,
    z: f64,
}

fn distance(a: Point, b: Point) -> f64 {
    sqrt(
        pow((a.x - b.x), 2.0) +
        pow((a.y - b.y), 2.0) +
        pow((a.z - b.z), 2.0)
    )
}

fn main(argc: usize, ) -> i32 {
    let a = Point {x: 0.0, y: 0.0, z: 0.0};
    let b = Point {x: 1.0, y: 1.0, z: 1.0};
    printf("%f\n".0, distance(a, b));
    0
}