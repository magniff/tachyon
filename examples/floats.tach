// The distance between two points in space, with f64 and C's math
// library; printf formats the float.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn sqrt(x: f64) -> f64;
}

struct Point { x: f64, y: f64, z: f64 }

impl Point {
    fn distance(self: Point, other: Point) -> f64 {
        let dx = self.x - other.x;
        let dy = self.y - other.y;
        let dz = self.z - other.z;
        unsafe { sqrt(dx * dx + dy * dy + dz * dz) }
    }
}

fn main() -> i32 {
    let a = Point { x: 0.0, y: 0.0, z: 0.0 };
    let b = Point { x: 1.0, y: 1.0, z: 1.0 };
    unsafe { printf(c"%f\n", a.distance(b)); }
    0
}
