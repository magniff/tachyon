// c-math: numerical integration and root finding in tachyon, checked
// against the C math library (libm). The algorithms take the function
// as a closure (`F: Fn(f64) -> f64`); libm's functions go in through
// closures too, since calling C is unsafe and a closure can wrap it.
//
// Linking: libm is part of libSystem on macOS; on Linux it is its own
// library, so link with -lm (see README.md).
import "math.h" as c;

// math.h's M_PI: object-like macros that are numbers come in as constants.
const PI: f64 = c::M_PI;

// ---- integration --------------------------------------------------------------

// Composite Simpson's rule on n intervals (n even): exact for cubics, its
// error shrinks with the 4th power of the step.
fn simpson<F: Fn(f64) -> f64>(f: F, a: f64, b: f64, n: i64) -> f64 {
    let h = (b - a) / n as f64;
    let mut sum = f(a) + f(b);
    for i in 1..n {
        let x = a + i as f64 * h;
        sum += if i % 2 == 1 { 4.0 * f(x) } else { 2.0 * f(x) };
    }
    sum * h / 3.0
}

// Adaptive Simpson: halves an interval only where the two halves disagree
// with the whole, so smooth stretches cost little. `calls` counts the
// function evaluations.
fn adaptive<F: Fn(f64) -> f64>(f: F, a: f64, b: f64, tolerance: f64, calls: &mut i64) -> f64 {
    let m = (a + b) / 2.0;
    let (fa, fm, fb) = (f(a), f(m), f(b));
    *calls += 3;
    let whole = (b - a) / 6.0 * (fa + 4.0 * fm + fb);
    refine(f, a, b, fa, fm, fb, whole, tolerance, 40, calls)
}

fn refine<F: Fn(f64) -> f64>(
    f: F, a: f64, b: f64, fa: f64, fm: f64, fb: f64, whole: f64, tolerance: f64, depth: i64,
    calls: &mut i64,
) -> f64 {
    let m = (a + b) / 2.0;
    let (lm, rm) = ((a + m) / 2.0, (m + b) / 2.0);
    let (flm, frm) = (f(lm), f(rm));
    *calls += 2;
    let left = (m - a) / 6.0 * (fa + 4.0 * flm + fm);
    let right = (b - m) / 6.0 * (fm + 4.0 * frm + fb);
    let delta = left + right - whole;
    if depth == 0 || unsafe { c::fabs(delta) } <= 15.0 * tolerance {
        return left + right + delta / 15.0; // Richardson's correction
    }
    refine(f, a, m, fa, flm, fm, left, tolerance / 2.0, depth - 1, calls)
        + refine(f, m, b, fm, frm, fb, right, tolerance / 2.0, depth - 1, calls)
}

// ---- roots ----------------------------------------------------------------------

// Bisection: f(lo) and f(hi) have opposite signs; the bracket halves until
// it is narrower than `tolerance`. Slow (one bit per step) but sure.
fn bisect<F: Fn(f64) -> f64>(f: F, lo: f64, hi: f64, tolerance: f64) -> Option<(f64, i64)> {
    let (mut lo, mut hi) = (lo, hi);
    if f(lo) * f(hi) > 0.0 {
        return None; // no sign change: no bracketed root
    }
    let mut steps = 0;
    while hi - lo > tolerance {
        let mid = (lo + hi) / 2.0;
        if f(lo) * f(mid) <= 0.0 { hi = mid; } else { lo = mid; }
        steps += 1;
    }
    Some(((lo + hi) / 2.0, steps))
}

// Newton's method: x - f(x) / f'(x) until the step is tiny. Fast (the
// correct digits double each step) near a simple root; `trace` gets each
// iterate.
fn newton<F: Fn(f64) -> f64, D: Fn(f64) -> f64, T: FnMut(i64, f64)>(
    f: F, df: D, x0: f64, mut trace: T,
) -> Option<f64> {
    let mut x = x0;
    for i in 1..=50 {
        let slope = df(x);
        if slope == 0.0 {
            return None;
        }
        let next = x - f(x) / slope;
        trace(i, next);
        if next == x || unsafe { c::fabs(next - x) } < 1e-15 * unsafe { c::fabs(next) } {
            return Some(next);
        }
        x = next;
    }
    None
}

// ---- the report -----------------------------------------------------------------

fn close(a: f64, b: f64, tolerance: f64) -> bool {
    let difference = unsafe { c::fabs(a - b) };
    difference <= tolerance
}

fn libm_tour() {
    println("== libm");
    unsafe {
        println(f"sqrt(2)      = {c::sqrt(2.0):.12}");
        println(f"cbrt(-27)    = {c::cbrt(-27.0):.12}");
        println(f"hypot(3, 4)  = {c::hypot(3.0, 4.0):.12}");
        println(f"4 atan(1)    = {4.0 * c::atan(1.0):.12}");
        println(f"exp(1)       = {c::exp(1.0):.12}");
        println(f"log10(1e6)   = {c::log10(1000000.0):.12}");
        println(f"pow(2, 0.5)  = {c::pow(2.0, 0.5):.12}");
        println(f"tgamma(5)    = {c::tgamma(5.0):.12}  (4!)");
        println(
            f"floor(-2.5)  = {c::floor(-2.5):.1}, ceil(-2.5) = {c::ceil(-2.5):.1}, round(-2.5) = {c::round(-2.5):.1}");
    }
    // Out-parameters: C returns a second result through a pointer.
    let mut exponent: i32 = 0;
    let mantissa = unsafe { c::frexp(48.0, &exponent) };
    println(f"frexp(48)    = {mantissa:.4} * 2^{exponent}");
    let mut whole = 0.0;
    let fraction = unsafe { c::modf(PI, &whole) };
    println(f"modf(pi)     = {whole:.1} + {fraction:.12}");
}

fn integration(gpa: Gpa) {
    println("== integration");
    let sin = |x: f64| unsafe { c::sin(x) };
    println("Simpson on sin over [0, pi] (exactly 2): the error / 16 per doubling");
    let mut previous = 0.0;
    for n in [4, 8, 16, 32, 64] {
        let value = simpson(sin, 0.0, PI, n);
        let error = unsafe { c::fabs(value - 2.0) };
        let mut line = format_in(f"  n = {n:>2}  {value:.12}  error {error * 1e9:>12.3}e-9", gpa);
        if previous > 0.0 { line.push_fmt(f"  ratio {previous / error:.1}"); }
        println(line.as_slice());
        previous = error;
    }

    // The normal distribution's mass within 2 sigma, against libm's erf.
    let density = |x: f64| unsafe { c::exp(-x * x / 2.0) / c::sqrt(2.0 * PI) };
    let mut calls = 0;
    let mass = adaptive(density, -2.0, 2.0, 1e-12, &mut calls);
    let exact = unsafe { c::erf(2.0 / c::sqrt(2.0)) };
    println(f"P(|Z| < 2)  = {mass:.12}  erf: {exact:.12}  agree: {close(mass, exact, 1e-11)}");

    // Gamma(x) = the integral of t^(x-1) e^-t over [0, inf): cut at 60.
    let x = 4.5;
    let integrand = |t: f64| unsafe { c::pow(t, x - 1.0) * c::exp(-t) };
    let mut gamma_calls = 0;
    let gamma = adaptive(integrand, 0.0, 60.0, 1e-11, &mut gamma_calls);
    let libm_gamma = unsafe { c::tgamma(x) };
    println(
        f"Gamma(4.5)  = {gamma:.10}  tgamma: {libm_gamma:.10}  agree: {close(gamma, libm_gamma, 1e-8)}");
    println(f"evaluations: {calls} for P, {gamma_calls} for Gamma (Simpson with n = 64: 65)");
}

fn roots() {
    println("== roots");
    // cos x = x has one root, the Dottie number.
    let g = |x: f64| unsafe { c::cos(x) } - x;
    match bisect(g, 0.0, 1.0, 1e-12) {
        Some((root, steps)) => println(f"bisection: cos x = x at {root:.10} after {steps} steps"),
        None => println("bisection: no sign change"),
    }
    match bisect(|x: f64| x * x + 1.0, -1.0, 1.0, 1e-12) {
        Some((root, _)) => println(f"x^2 + 1 = 0 at {root}?"),
        None => println("bisection: x^2 + 1 has no sign change on [-1, 1]"),
    }

    // Newton on x^3 - 2: each line has about twice the digits of the last.
    println("Newton on x^3 = 2, from 1:");
    let cube = newton(
        |x: f64| x * x * x - 2.0,
        |x: f64| 3.0 * x * x,
        1.0,
        |i: i64, x: f64| println(f"  step {i}: {x:.15}"),
    );
    match cube {
        Some(r) => {
            let libm = unsafe { c::cbrt(2.0) };
            println(f"cbrt(2): Newton {r:.15}, libm {libm:.15}, agree: {close(r, libm, 1e-15)}");
        }
        None => println("Newton did not converge"),
    }
    // A flat start: f'(0) = 0.
    let flat = newton(|x: f64| x * x - 4.0, |x: f64| 2.0 * x, 0.0, |_i: i64, _x: f64| {});
    println(f"Newton on x^2 = 4 from 0: {flat:?}");
}

fn main(gpa: Gpa) -> i32 {
    libm_tour();
    integration(gpa);
    roots();
    0
}
