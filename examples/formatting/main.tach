// Formatting: f-strings and their format specs, Display and Debug written
// by hand and derived, and the ways to send formatted text somewhere:
// println, eprintln (stderr), format (a new Buf), push_fmt (append).
// The program prints a small inventory report.
use std::{Buf, Fmt};

// ---- Types that format themselves ----

// Money in cents. Display by hand: "$1,234.50", "-$3.05".
struct Money { cents: i64 }

impl Display for Money {
    fn fmt(self: *Money, f: *Fmt) {
        let mut c = self.cents;
        if c < 0 {
            f.byte('-');
            c = -c;
        }
        f.byte('$');
        // the dollars, with a comma every three digits
        let dollars = c / 100;
        let mut group = 1;
        while group * 1000 <= dollars { group *= 1000; }
        f.write(dollars / group);
        while group > 1 {
            group /= 1000;
            f.write(f",{dollars / group % 1000:03}");
        }
        f.write(f".{c % 100:02}");
    }
}

// Debug is for programmers: the raw value.
impl Debug for Money {
    fn fmt_debug(self: *Money, f: *Fmt) { f.write(f"Money({self.cents})"); }
}

// A stock-keeping number: Display "#42", Debug "SKU-0042".
struct Sku { id: i64 }

impl Display for Sku {
    fn fmt(self: *Sku, f: *Fmt) { f.write(f"#{self.id}"); }
}

impl Debug for Sku {
    fn fmt_debug(self: *Sku, f: *Fmt) { f.write(f"SKU-{self.id:04}"); }
}

// derive(Debug) writes Rust's text for these, using the impls above for
// the Sku and Money fields.
#[derive(Debug)]
enum Category { Tools, Food(i64), Toys }

#[derive(Debug)]
struct Item { sku: Sku, name: [u8], category: Category, qty: i64, price: Money }

fn item(id: i64, name: [u8], category: Category, qty: i64, cents: i64) -> Item {
    Item { sku: Sku { id }, name, category, qty, price: Money { cents } }
}

// ---- The sections of the report ----

// One line of the spec table: the spec as written, what it printed (a
// Buf from `format`, freed here), and a note.
fn row(spec: [u8], shown: Buf, note: [u8]) {
    let mut shown = shown;
    defer shown.free();
    let mut cell = format(f"[{shown.as_slice()}]");
    defer cell.free();
    println(f"{spec:<13} {cell.as_slice():<12} {note}");
}

fn specs() {
    println("== format specs");
    let n = 42;
    let x = 3.14159;
    let name = "tachyon";
    row("{n}", format(f"{n}"), "Display");
    row("{n:>8}", format(f"{n:>8}"), "right-aligned: the default for numbers");
    row("{n:<8}", format(f"{n:<8}"), "left-aligned");
    row("{n:08}", format(f"{n:08}"), "zero-padded");
    row("{n:x} {n:X}", format(f"{n:x} {n:X}"), "hex");
    row("{n:08b}", format(f"{n:08b}"), "binary, zero-padded");
    row("{x}", format(f"{x}"), "the shortest text that reads back");
    row("{x:.2}", format(f"{x:.2}"), "two decimals");
    row("{x:>9.3}", format(f"{x:>9.3}"), "width and precision");
    row("{name:>9}", format(f"{name:>9}"), "text goes left by default");
    row("{name:?}", format(f"{name:?}"), "Debug: quoted and escaped");
    row("{'A':c}", format(f"{'A':c}"), "a u8 as a character");
    row("{n * 2 + 1}", format(f"{n * 2 + 1}"), "any expression");
    println(f"{{{{ and }}}} in an f-string are literal braces: {{n}}");
}

fn table(items: [Item]) {
    println("== inventory");
    println(f"{"sku":<6} {"item":<16} {"qty":>5} {"price":>10} {"value":>12}");
    let mut rule = Buf::new();
    defer rule.free();
    for _ in 0..53 { rule.push('-'); }
    println(rule.as_slice());
    let mut total = Money { cents: 0 };
    for it in items {
        let value = Money { cents: it.price.cents * it.qty };
        total.cents += value.cents;
        // A width applies to our own Display too: Money is right-aligned.
        println(f"{it.sku:<6} {it.name:<16} {it.qty:>5} {it.price:>10} {value:>12}");
    }
    println(rule.as_slice());
    println(f"{"total":<40} {total:>12}");
}

fn debug_views(items: [Item]) {
    println("== debug");
    println(f"{items[0]:?}");
    println(f"{items[2].category:?} {items[2].sku:?} {items[2].price:?}");
    let mut quantities: Vec<i64> = Vec::new();
    defer quantities.free();
    for it in items { quantities.push(it.qty); }
    println(f"{quantities:?} {quantities.last():?} {"tab\there":?}");
}

fn hex_dump(bytes: [u8]) {
    println("== hex dump");
    let mut at = 0;
    while at < bytes.len {
        let end = if at + 8 < bytes.len { at + 8 } else { bytes.len };
        let mut line = format(f"{at:04x}  "); // format: a new Buf to keep
        defer line.free();
        for i in at..at + 8 {
            if i < end { line.push_fmt(f"{bytes[i]:02x} "); } else { line.push_str("   "); }
        }
        line.push_str(" |");
        for b in bytes[at..end] {
            line.push_fmt(f"{if b >= ' ' && b <= '~' { b } else { '.' }:c}");
        }
        line.push('|');
        println(line.as_slice());
        at = end;
    }
}

fn main() -> i32 {
    let items = [
        item(7, "hammer", Category::Tools, 12, 1599),
        item(42, "socket set", Category::Tools, 3, 8950),
        item(108, "coffee beans", Category::Food(180), 40, 1275),
        item(9, "rubber duck", Category::Toys, 250, 199),
        item(1500, "workbench", Category::Tools, 2, 64900),
    ];
    specs();
    table(items[..]);
    debug_views(items[..]);
    hex_dump("tachyon formats\tbytes\n");

    // Warnings go to stderr: the report on stdout stays clean.
    for it in items {
        if it.qty < 5 { eprintln(f"warning: {it.name} ({it.sku:?}) is low: {it.qty} left"); }
    }
    0
}
