extern fn write(fd: i32, buf: *u8, count: u64) -> i64;
extern fn strlen(s: *u8) -> u64; 

fn print(s: (*u8, u64)) {
    write(1, s.0, s.1);
}

fn print_num(n: i64) {
    if n >= 10 {
        print_num(n / 10);
    };
    let ch: i64 = n % 10 + 48;
    write(1, &ch as *u8, 1);
}

fn main(argc: i64, argv: **u8) -> i64 {
    print("argc: ");
    print_num(argc);
    print("\n");

    let argument_number: i64 = 0;
    loop {
        if argument_number >= argc { break; };
        let ptr: *u8 = *((argv as u64 + (argument_number * 8) as u64) as **u8);
        let len: u64 = strlen(ptr);
        print("-- ");
        write(1, ptr, len);
        print("\n");
        argument_number += 1;
    }
    0
}