// A triangle rendered into a texture, read back and printed as text: one
// character per pixel, after the channel that dominates it.

use std::gpu;
use std::gpu::{BufferUsage, Format, PassDesc, TextureUsage, VertexFormat, VertexLayout};

const W: i64 = 48;
const H: i64 = 20;

// The shader in WGSL, translated for the device by std::gpu::wgsl: its
// vertex inputs at @location(0) and (1), as the layout below gives them.
const WGSL: [u8] = "struct VOut {\n\
    @builtin(position) pos: vec4<f32>,\n\
    @location(0) color: vec3<f32>,\n\
    }\n\
    @vertex fn vs(@location(0) pos: vec2<f32>, @location(1) color: vec3<f32>) -> VOut {\n\
    var o: VOut;\n\
    o.pos = vec4<f32>(pos, 0.5, 1.0);\n\
    o.color = color;\n\
    return o;\n\
    }\n\
    @fragment fn fs(v: VOut) -> @location(0) vec4<f32> { return vec4<f32>(v.color, 1.0); }\n";

fn main(gpa: Gpa) -> Result<(), gpu::Error> {
    let inst = gpu::Instance::new_in(gpa);
    let (dev, var queue) = inst.adapter()?.device()?;
    let shader = dev.shader_wgsl(WGSL)?;

    // x, y in clip space, then r, g, b
    let verts: [f32; 15] = [
        0.0, 0.9, 1.0, 0.0, 0.0,
        -0.9, -0.9, 0.0, 1.0, 0.0,
        0.9, -0.9, 0.0, 0.0, 1.0,
    ];
    let vb = dev.buffer_init(gpu::bytes_of_f32(verts[..]), BufferUsage::VERTEX);
    var layout = VertexLayout::new(20);
    layout.attribute(0, VertexFormat::Float32x2, 0);
    layout.attribute(1, VertexFormat::Float32x3, 8);
    var desc = gpu::RenderDesc::new(shader, "vs", "fs", Format::Rgba8Unorm);
    desc.vertex_buffer(layout);
    let pipe = dev.render_pipeline(desc)?;

    let target = dev.texture(W, H, Format::Rgba8Unorm,
        usage: TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC);
    let view = target.view();
    var pixels = dev.buffer(256 * H, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    var enc = dev.encoder();
    enc.render_pass(PassDesc::color(view), |pass| {
        pass.set_pipeline(pipe);
        pass.set_vertex_buffer(0, vb);
        pass.draw(0..3, 0..1);
    });
    enc.copy_texture_to_buffer(target, pixels, 256);
    queue.submit(enc.finish());

    let px = pixels.map_read(dev);
    for y in 0..H {
        var line = Buf::new_in(gpa);
        for x in 0..W {
            let i = y * 256 + x * 4;
            let (r, g, b) = (px[i], px[i + 1], px[i + 2]);
            let c = if r as i64 + g as i64 + b as i64 == 0 { '.' } else if r >= g && r >= b { 'R' }
                else if g >= b { 'G' } else { 'B' };
            line.push(c);
        }
        println(line.as_slice());
    }
    Ok(())
}
