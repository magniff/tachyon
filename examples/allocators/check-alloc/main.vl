// The memory bugs vole 0.25 still lets through, one per command-line
// argument: `leak`, `dangling` and `twice` (none: the correct version of
// each). Safe code cannot read memory after it is freed or free it twice:
// since 0.17 those are compile errors (the README shows them). What is
// left is a leak, which is safe, and a bug in `unsafe` code, whose raw
// pointers nothing checks. Built as usual, each prints a wrong number,
// crashes or shows nothing at all; built with `volec --check-alloc`, each
// is reported with its block, where it was allocated and where it was
// freed.
use std::env;
use std::cli::{Arg, Command};

// The bug: an Arena's memory never given back. An Arena is not dropped:
// `free_all` returns its memory, and it is unsafe, as a view into the
// arena could still be used after it.
fn leaked(gpa: Gpa, fixed: bool) {
    let notes = Arena::new_in(gpa);
    {
        var b: Buf<Arena> = Buf::new_in(notes);
        b.push_str("a report nobody frees");
        println(b.as_slice());
    }
    if fixed {
        unsafe { notes.free_all() };
    }
}

// The bug: a raw pointer into a Vec kept across a push that moved the
// Vec's memory. A view (`v.as_slice()`) kept across the push would be a
// compile error; a raw pointer is not checked.
fn dangling(gpa: Gpa, fixed: bool) {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..4 {
        v.push(i * 10 + 1);
    }
    let first = v.as_slice().ptr;
    v.push(41);
    if fixed {
        // safe code indexes the Vec: there is no pointer to keep valid
        println(f"first {v[0]}");
    } else {
        println(f"first {unsafe { first[0] }}");
    }
}

// Two i64s managed by hand, through a raw pointer. The struct has no
// `Drop`, so it is a plain type: `let b = a;` copies the pointer, not the
// memory, and nothing frees it but an explicit `gpa.free`.
struct Pair { p: *i64 }

fn pair_new(gpa: Gpa, a: i64, b: i64) -> Pair {
    let p = gpa.try_alloc(16, 8) as *i64;
    if p == 0 as *i64 {
        panic("out of memory");
    }
    unsafe {
        p[0] = a;
        p[1] = b;
    }
    Pair { p: p }
}

// The bug: two copies of a Pair, each freed.
fn freed_twice(gpa: Gpa, fixed: bool) {
    let counts = pair_new(gpa, 3, 4);
    let shelf = counts;
    println(f"shelf: {unsafe { shelf.p[0] + shelf.p[1] }}");
    unsafe { gpa.free(counts.p as *u8, 16, 8) };
    if !fixed {
        unsafe { gpa.free(shelf.p as *u8, 16, 8) };
    }
}

enum Bug { NoBug, Leak, Dangling, Twice }

// The bug the arguments name; None (and a message) for one it does not
// know. `--help` prints the help and exits.
fn parse_args(gpa: Gpa) -> Option<Bug> {
    let cmd = Command::new_in("shop", gpa)
        .about("memory bugs for --check-alloc to find")
        .arg(Arg::positional("bug").help("leak, dangling or twice (none: the correct versions)"));
    let m = cmd.parse_or_exit(env::args());
    let bug = m.get("bug").unwrap_or("");
    if bug == "" {
        Some(Bug::NoBug)
    } else if bug == "leak" {
        Some(Bug::Leak)
    } else if bug == "dangling" {
        Some(Bug::Dangling)
    } else if bug == "twice" {
        Some(Bug::Twice)
    } else {
        eprintln(f"shop: no bug '{bug}': leak, dangling or twice");
        None
    }
}

fn main(gpa: Gpa) -> i32 {
    let bug = match parse_args(gpa) {
        Some(b) => b,
        None => return 2,
    };
    let fixed = bug == Bug::NoBug;
    if fixed || bug == Bug::Leak {
        leaked(gpa, fixed);
    }
    if fixed || bug == Bug::Dangling {
        dangling(gpa, fixed);
    }
    if fixed || bug == Bug::Twice {
        freed_twice(gpa, fixed);
    }
    if fixed && std::CHECK_ALLOC {
        // (known only to the checking Gpa: -1 otherwise)
        println(f"blocks still allocated: {gpa.live_blocks()}");
    }
    0
}
