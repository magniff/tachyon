// Totals of a shop's orders, read from stdin, one per line: `customer
// item quantity price` (the price in cents). The program shows where
// memory comes from in vole: nothing allocates unless it is given an
// allocator, the general-purpose one (`Gpa`) is main's parameter, and it
// is passed down to whatever allocates. A function's signature says
// whether it allocates; `volec query effects` confirms it.
use std::{Buf, HashMap, read_stdin_in, sort_by, split_in, split_whitespace_in};

struct Order { customer: [u8], item: [u8], quantity: i64, cents: i64 }

// The orders in `text`, in a new Vec on `gpa` (the caller frees it). A
// line that does not parse is reported and skipped. The [u8] fields are
// views of `text`: they live as long as it does, and cost nothing.
fn parse_orders(text: [u8], gpa: Gpa) -> Vec<Order> {
    var orders: Vec<Order> = Vec::new_in(gpa);
    var lines = split_in(text, '\n', gpa);
    for line in lines.as_slice() {
        var f = split_whitespace_in(line, gpa);
        if f.len() == 0 {
            continue;
        }
        let w = f.as_slice();
        if w.len() != 4 {
            eprintln(f"skipped: {line}");
            continue;
        }
        match (std::parse_int(w[2]), std::parse_int(w[3])) {
            (Ok(q), Ok(c)) => orders.push(Order {
                customer: w[0], item: w[1], quantity: q, cents: c
            }),
            _ => eprintln(f"skipped: {line}"),
        }
    }
    orders
}

// The sum of the orders' amounts. It only reads: it takes a slice, and no
// allocator, so it cannot allocate.
fn total(orders: [Order]) -> i64 {
    var t = 0;
    for o in orders {
        t += o.quantity * o.cents;
    }
    t
}

// Each customer's total, in a new map on the same allocator as `orders`:
// a container carries its allocator, `allocator()` hands it over, so this
// function needs no allocator parameter of its own.
fn by_customer(orders: Vec<Order>) -> HashMap<[u8], i64> {
    var m: HashMap<[u8], i64> = HashMap::new_in(orders.allocator());
    for o in orders.iter() {
        let before = m.get(o.customer).unwrap_or(0);
        m.insert(o.customer, before + o.quantity * o.cents);
    }
    m
}

// How many of each item, on whatever allocator the caller picks: generic
// over it (Gpa here; an arena or a FixedBuf would do as well).
fn count_items<A: Allocator>(orders: [Order], a: sink A) -> HashMap<[u8], i64, A> {
    var m: HashMap<[u8], i64, A> = HashMap::new_in(a);
    for o in orders {
        let before = m.get(o.item).unwrap_or(0);
        m.insert(o.item, before + o.quantity);
    }
    m
}

fn main(gpa: Gpa) -> i32 {
    // stdin, all of it, in a Buf on gpa.
    var input = read_stdin_in(gpa).unwrap();

    var orders = parse_orders(input.as_slice(), gpa);

    var customers = by_customer(orders);
    var items = count_items(orders.as_slice(), gpa);

    // The customers by name: their entries in a Vec, sorted.
    var rows: Vec<([u8], i64)> = customers.iter().collect_in(gpa);
    sort_by(rows.as_mut_slice(), |a, b| a.0.cmp(b.0));
    for (name, cents) in rows.iter() {
        println(f"{name:<8} {cents / 100:>4}.{cents % 100:02}");
    }
    let t = total(orders.as_slice());
    println(f"{orders.len()} orders, {items.len()} items, total {t / 100}.{t % 100:02}");
    var line = std::format_in(f"apples sold: {items.get("apples").unwrap_or(0)}", gpa);
    println(line.as_slice());
    0
}
