// A day at the till: the shop's products, then what the clerk types.

mod shop;

use shop::{Store, add_product, free_cart, free_store, money, new_cart, new_store, run};
use std::Buf;

fn main(gpa: Gpa) -> i32 {
    var st: Store = new_store(gpa);
    defer free_store(&st);
    add_product(&st, 1, "green tea", 450, 10);
    add_product(&st, 2, "oat biscuits", 299, 4);
    add_product(&st, 3, "honey jar", 825, 2);
    add_product(&st, 4, "teapot", 2400, 1);

    var cart = new_cart(gpa);
    defer free_cart(&cart);
    let day = [
        "add 1 4", "add 3 5", "coupon TEA3", "checkout",
        "add 4 1", "add 2 2", "coupon FIVER", "remove 2", "checkout",
        "restock 4 3", "add 4 2", "coupon TEN", "frobnicate", "checkout",
        "stock",
    ];
    for line in day {
        run(&st, &cart, line, gpa);
    }
    var b = Buf::new_in(gpa);
    money(&b, st.takings);
    println(f"takings: {b.as_slice()}");
    0
}
