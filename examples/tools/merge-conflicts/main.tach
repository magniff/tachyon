// units: a table of everyday conversions.

mod convert;

use convert::{c_to_f, f_to_c, kg_to_lb, km_to_mi};

fn main() -> i32 {
    println("celsius  fahrenheit");
    for c in [-40, 0, 21, 37, 100] {
        println(f"{c:>7}  {c_to_f(c):>10}");
    }
    println("fahrenheit  celsius");
    for f in [0, 50, 98, 212] {
        println(f"{f:>10}  {f_to_c(f):>7}");
    }
    println("km  miles");
    for km in [1, 5, 10, 42, 100] {
        println(f"{km:>3}  {km_to_mi(km):>5}");
    }
    println("kg  pounds");
    for kg in [1, 50, 70] {
        println(f"{kg:>2}  {kg_to_lb(kg):>6}");
    }
    0
}
