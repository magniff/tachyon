// Conversions between units, in whole numbers.

// Celsius to Fahrenheit.
pub fn c_to_f(c: i64) -> i64 {
    c * 9 / 5 + 32
}

// Fahrenheit to Celsius.
pub fn f_to_c(f: i64) -> i64 {
    (f - 32) * 5 / 9
}

// Kilometres to miles.
pub fn km_to_mi(km: i64) -> i64 {
    km * 1000 / 1609
}

// Kilograms to pounds.
pub fn kg_to_lb(kg: i64) -> i64 {
    kg * 100000 / 45359
}
