// Text into lines and words.

use std::{split_in, split_whitespace_in};

// Lowercase ASCII letters and digits; every other byte ends a word.
fn is_word_byte(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')
}

fn lower(c: u8) -> u8 {
    if c >= 'A' && c <= 'Z' { c + 32 } else { c }
}

// The words of `text`, lowercased into `store`, as slices of it.
pub fn words(text: [u8], store: &mut Vec<u8>, gpa: Gpa) -> Vec<[u8]> {
    store.clear();
    store.reserve(text.len);
    for i in 0..text.len {
        let c = text[i];
        let l = lower(c);
        store.push(if is_word_byte(l) { l } else { ' ' });
    }
    split_whitespace_in(store.as_slice(), gpa)
}

pub fn lines(text: [u8], gpa: Gpa) -> Vec<[u8]> {
    let mut v = split_in(text, '\n', gpa);
    if v.len() > 0 && v.get(v.len() - 1).len == 0 {
        v.pop();
    }
    v
}

// The length of the longest line, and its index.
pub fn longest_line(ls: [[u8]]) -> (i64, i64) {
    let mut best = 0;
    let mut at = 0;
    for i in 0..ls.len {
        let l = ls[i];
        if l.len > best {
            best = l.len;
            at = i;
        }
    }
    (best, at)
}
