// Helpers from before std had them. Deprecated: std's methods do the
// same (`b.push_str(s)`, `v.get(i)`), and new code should call those.

use std::Buf;

// Appends s to b. Deprecated: b.push_str(s).
pub fn buf_add(b: inout Buf, s: [u8]) {
    b.push_str(s);
}

// Appends the decimal digits of n to b. Deprecated: b.push_int(n).
pub fn buf_add_int(b: inout Buf, n: i64) {
    b.push_int(n);
}

// Element i of v. Deprecated: v.get(i).
pub fn vec_at<T>(v: Vec<T>, i: i64) -> T {
    v.get(i)
}
