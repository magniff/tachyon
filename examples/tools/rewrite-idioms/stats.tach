// Counting: word frequencies, the commonest words, word lengths.

use crate::compat::vec_at;
use std::{HashMap, sort_by};

pub struct Count {
    pub word: [u8],
    pub n: i64,
}

pub fn frequencies(ws: [[u8]], gpa: Gpa) -> HashMap<[u8], i64> {
    let mut m: HashMap<[u8], i64> = HashMap::new_in(gpa);
    for i in 0..ws.len {
        let w = ws[i];
        m.get_or_insert(w, 0)[0] += 1;
    }
    m
}

// The counts, commonest first; ties in alphabetical order.
pub fn ranked(m: &HashMap<[u8], i64>, gpa: Gpa) -> Vec<Count> {
    let mut v: Vec<Count> = Vec::new_in(gpa);
    for (w, n) in m.iter() {
        v.push(Count { word: w, n: n });
    }
    sort_by(v.as_mut_slice(), |a: &Count, b: &Count| {
        if a.n != b.n {
            b.n - a.n
        } else if a.word < b.word {
            -1
        } else if a.word > b.word {
            1
        } else {
            0
        }
    });
    v
}

// How many words have each length, 1 to 12 (longer ones count as 12).
pub fn length_histogram(ws: [[u8]]) -> [i64; 13] {
    let mut h = [0; 13];
    for i in 0..ws.len {
        let w = ws[i];
        let k = if w.len > 12 { 12 } else { w.len };
        h[k] += 1;
    }
    h
}

pub fn total_letters(ws: [[u8]]) -> i64 {
    let mut t = 0;
    for i in 0..ws.len {
        let w = ws[i];
        t += w.len;
    }
    t
}

// The first k counts, as `word n` pairs.
pub fn top(v: &Vec<Count>, k: i64, gpa: Gpa) -> Vec<Count> {
    let mut out: Vec<Count> = Vec::new_in(gpa);
    let n = if v.len() < k { v.len() } else { k };
    for i in 0..n {
        out.push(vec_at(v, i));
    }
    out
}

// Words that occur once.
pub fn hapaxes(v: &Vec<Count>) -> i64 {
    let mut n = 0;
    for i in 0..v.len() {
        if vec_at(v, i).n == 1 {
            n += 1;
        }
    }
    n
}
