// wordstat: lines, words, the commonest words and word lengths of the
// text on stdin.

mod compat;
mod report;
mod stats;
mod text;

use std::{Buf, read_stdin};

fn main() -> i32 {
    let mut input = read_stdin().unwrap();
    defer input.free();
    let t = input.as_slice();

    let ls = text::lines(t);
    let mut store: Vec<u8> = Vec::new();
    defer store.free();
    let ws = text::words(t, &store);
    if ws.len() == 0 {
        println("no words");
        return 1;
    }

    let mut freq = stats::frequencies(ws.as_slice());
    defer freq.free();
    let mut ranked = stats::ranked(&freq);
    defer ranked.free();
    let mut top = stats::top(&ranked, 5);
    defer top.free();
    let h = stats::length_histogram(ws.as_slice());
    let (len, at) = text::longest_line(ls.as_slice());

    let mut b = Buf::new();
    defer b.free();
    report::summary(&b, ls.len(), ws.len(), stats::total_letters(ws.as_slice()), freq.len(),
        stats::hapaxes(&ranked));
    report::commonest(&b, &top);
    report::histogram(&b, h[..]);
    report::longest(&b, len, ls.get(at), at);
    report::finish(&b);
    print(b.as_slice());
    0
}
