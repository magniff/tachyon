// wordstat: lines, words, the commonest words and word lengths of the
// text on stdin.

mod compat;
mod report;
mod stats;
mod text;

use std::{Buf, read_stdin_in};

fn main(gpa: Gpa) -> i32 {
    var input = read_stdin_in(gpa).unwrap();
    let t = input.as_slice();

    let ls = text::lines(t, gpa);
    var store: Vec<u8> = Vec::new_in(gpa);
    let ws = text::words(t, &store, gpa);
    if ws.len() == 0 {
        println("no words");
        return 1;
    }

    var freq = stats::frequencies(ws.as_slice(), gpa);
    var ranked = stats::ranked(freq, gpa);
    var top = stats::top(ranked, 5, gpa);
    let h = stats::length_histogram(ws.as_slice());
    let (len, at) = text::longest_line(ls.as_slice());

    var b = Buf::new_in(gpa);
    report::summary(&b, ls.len(), ws.len(), stats::total_letters(ws.as_slice()), freq.len(),
        stats::hapaxes(ranked));
    report::commonest(&b, top);
    report::histogram(&b, h[..]);
    report::longest(&b, len, ls.get(at), at);
    report::finish(&b);
    print(b.as_slice());
    0
}
