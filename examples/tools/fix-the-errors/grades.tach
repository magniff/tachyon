// From scores to grades.

extern "C" {
    fn abs(x: i32) -> i32;
}

const HONOURS: [u8] = ", with honours";

// The mean of the scores, rounded down; 0 for none.
pub fn average(scores: [i64]) -> i64 {
    if scores.len == 0 {
        return 0;
    }
    let mut total = 0;
    for s in scores {
        total += s;
    }
    totl / scores.len
}

fn letter(avg: i64) -> u8 {
    if avg >= 90 {
        'A'
    } else if avg >= 80 {
        'B'
    } else if avg >= 70 {
        'C'
    } else if avg >= 60 {
        'D'
    } else {
        'F'
    }
}

// The largest difference between two consecutive scores.
pub fn biggest_swing(scores: [i64]) -> i64 {
    let mut most = 0;
    for i in 1..scores.len {
        let d = abs((scores[i] - scores[i - 1]) as i32) as i64;
        if d > most {
            most = d;
        }
    }
    most
}

pub fn remark(avg: i64) -> [u8] {
    if avg >= 95 { HONOURS } else { "" }
}
