// gradebook: a class's test scores, each student's average, grade and
// biggest swing, and the class's best student. It does not compile yet:
// see README.md.

mod grades;
mod roster;

use grades::{average, biggest_swing, letter, remark};
use roster::{add_score, enrol, free_roster, new_roster, with_scores};

fn main(gpa: Gpa) -> i32 {
    let mut r = new_roster(gpa);
    defer free_roster(&r);
    let ada = [91, 97, 99];
    let brook = [72, 85, 64, 80];
    let cyd = [55, 61];
    enrol(&r, "Ada", ada[..]);
    enrol(&r, "Brook", brook[..]);
    enrol(&r, "Cyd", cyd[..]);
    // a late test
    add_score(&r, "Cyd", 78);

    let mut best: HashMap<[u8], i64> = HashMap::new_in(gpa);
    defer best.free();
    for s in r.students.iter() {
        let avg = average(s.scores.as_slice());
        let g = letter(avg);
        println(
            f"{s.name:<6} {avg:>3} {g:c}  swing {biggest_swing(s.scores.as_slice()):>2}{remark(avg)}");
        best.insert(s.name, avg);
    }
    let mut top: [u8] = "";
    let mut top_avg = -1;
    for (name, avg) in best.iter() {
        if avg > top_avg {
            top = name;
            top_avg = avg;
        }
    }
    println(f"best: {top} ({top_avg}); {with_scores(&r, 3)} students have 3 scores or more");
    0
}
