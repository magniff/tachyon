// The class: each student's name and test scores.

pub struct Student {
    pub name: [u8],
    pub scores: Vec<i64>,
}

pub struct Roster {
    pub students: Vec<Student>,
}

pub fn new_roster() -> Roster {
    Roster { students: Vec::new() }
}

// A student with no scores yet.
pub fn enrol(r: *Roster, name: [u8]) {
    r.students.push(Student { name: name, scores: Vec::new() });
}

// How many students have at least `n` scores.
pub fn with_scores(r: *Roster, n: i64) -> i64 {
    let count = 0;
    for s in r.students.iter() {
        if s.scores.len() >= n {
            count += 1;
        }
    }
    count
}

pub fn free_roster(r: *Roster) {
    for s in r.students.iter() {
        let mut v = s.scores;
        v.free();
    }
    r.students.free();
}
