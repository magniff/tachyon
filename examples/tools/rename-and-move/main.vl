// A small lending library: books, members, loans and late fees, run
// through a scripted month and reported at the end.

mod catalog;
mod loans;
mod members;
mod report;

use catalog::Catalog;
use loans::{Loan, Outcome, give_back, lend};
use members::Members;

fn say(what: [u8], o: Outcome) {
    match o {
        Outcome::Lent(due) => println(f"{what}: lent, due on day {due}"),
        Outcome::NoCopy => println(f"{what}: no copy on the shelf"),
        Outcome::NotAllowed => println(f"{what}: not allowed"),
        Outcome::Unknown => println(f"{what}: unknown member"),
    }
}

fn main(gpa: Gpa) -> i32 {
    var cat = Catalog::new(gpa);
    var ms = Members::new(gpa);
    var out: Vec<Loan> = Vec::new_in(gpa);

    let dune = cat.add("Dune", "Frank Herbert", 2);
    let sicp = cat.add("Structure and Interpretation", "Abelson, Sussman", 1);
    let ada = ms.join("Ada", 2);
    let bob = ms.join("Bob", 1);

    say("day 1, Ada takes Dune", lend(&cat, &ms, &out, dune, ada, 1));
    say("day 2, Bob takes SICP", lend(&cat, &ms, &out, sicp, bob, 2));
    say("day 3, Ada takes SICP", lend(&cat, &ms, &out, sicp, ada, 3));
    say("day 3, Bob takes Dune", lend(&cat, &ms, &out, dune, bob, 3));
    let fee = give_back(&cat, &ms, &out, sicp, bob, 20);
    println(f"day 20, Bob returns SICP: fee {fee} cents");
    say("day 21, Bob takes Dune", lend(&cat, &ms, &out, dune, bob, 21));
    say("day 21, Ada takes SICP", lend(&cat, &ms, &out, sicp, ada, 21));

    report::shelf(cat);
    report::people(ms);
    println(f"overdue on day 30: {report::overdue(out, 30)}");
    0
}
