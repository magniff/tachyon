// The end-of-day report.

use crate::catalog::Catalog;
use crate::loans::Loan;
use crate::members::Members;

pub fn shelf(cat: *Catalog) {
    println("shelf:");
    for b in cat.books.iter() {
        println(f"  {b.title:<28} {b.author:<18} count {b.count}/{b.owned}");
    }
}

pub fn people(ms: *Members) {
    println("members:");
    for m in ms.list.iter() {
        println(f"  {m.name:<10} holds {m.count} of {m.limit}, owes {m.owed} cents");
    }
}

pub fn overdue(loans: *Vec<Loan>, today: i64) -> i64 {
    let mut n = 0;
    for l in loans.iter() {
        if l.due < today {
            n += 1;
        }
    }
    n
}
