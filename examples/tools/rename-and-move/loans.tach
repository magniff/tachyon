// Lending and returning books, and the fees for late returns.

use crate::catalog::{Catalog, put_back, take};
use crate::members::{Members, can_borrow};

// A loan is due this many days after it starts.
pub const LOAN_DAYS: i64 = 14;
// cents per day late
pub const FEE_PER_DAY: i64 = 25;
// a fee never exceeds this, however late
pub const MAX_FEE: i64 = 1000;

pub struct Loan {
    pub book: i64,
    pub member: i64,
    pub due: i64,
}

pub enum Outcome {
    Lent(i64),
    NoCopy,
    NotAllowed,
    Unknown,
}

pub fn lend(cat: *Catalog, ms: *Members, loans: *Vec<Loan>, book: i64, member: i64, today: i64) -> Outcome {
    let i = match crate::members::find(ms, member) {
        Some(i) => i,
        None => return Outcome::Unknown,
    };
    let mut m = ms.list.get(i);
    if !can_borrow(m) {
        return Outcome::NotAllowed;
    }
    if !take(cat, book) {
        return Outcome::NoCopy;
    }
    m.count += 1;
    ms.list.set(i, m);
    let due = today + LOAN_DAYS;
    loans.push(Loan { book: book, member: member, due: due });
    Outcome::Lent(due)
}

// The fee for a book returned `d` days after it was due.
pub fn late_fee(d: i64) -> i64 {
    if d <= 0 {
        return 0;
    }
    let fee = d * FEE_PER_DAY;
    if fee > MAX_FEE { MAX_FEE } else { fee }
}

// The book back from the member; the fee charged (0 when on time).
pub fn give_back(cat: *Catalog, ms: *Members, loans: *Vec<Loan>, book: i64, member: i64, today: i64) -> i64 {
    for k in 0..loans.len() {
        let l = loans.get(k);
        if l.book == book && l.member == member {
            loans.remove(k);
            put_back(cat, book);
            let d = today - l.due;
            let fee = late_fee(d);
            if let Some(i) = crate::members::find(ms, member) {
                let mut m = ms.list.get(i);
                m.count -= 1;
                m.owed += fee;
                ms.list.set(i, m);
            }
            return fee;
        }
    }
    0
}
