// The library's books: what it owns, and how many copies of each are on
// the shelf right now.

pub struct Book {
    pub id: i64,
    pub title: [u8],
    pub author: [u8],
    // copies on the shelf (the others are lent)
    pub count: i64,
    pub owned: i64,
}

pub struct Catalog {
    pub books: Vec<Book>,
}

impl Catalog {
    pub fn new(gpa: Gpa) -> Catalog {
        Catalog { books: Vec::new_in(gpa) }
    }

    // A new title, with `n` copies; its id is its place in the catalog.
    pub fn add(inout self, title: [u8], author: [u8], n: i64) -> i64 {
        let id = self.books.len() + 1;
        self.books.push(Book { id: id, title: title, author: author, count: n, owned: n });
        id
    }
}

// The index of book `id` in the catalog, or None.
pub fn find(cat: Catalog, id: i64) -> Option<i64> {
    cat.books.iter().position(|b| b.id == id)
}

// One copy off the shelf; false when none is left.
pub fn take(cat: inout Catalog, id: i64) -> bool {
    match find(cat, id) {
        Some(i) => {
            if cat.books[i].count == 0 {
                return false;
            }
            cat.books[i].count -= 1;
            true
        }
        None => false,
    }
}

// A copy back on the shelf.
pub fn put_back(cat: inout Catalog, id: i64) {
    if let Some(i) = find(cat, id) {
        cat.books[i].count += 1;
    }
}
