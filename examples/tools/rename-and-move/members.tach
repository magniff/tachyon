// The library's members, and how many books each may hold.

pub struct Member {
    pub id: i64,
    pub name: [u8],
    // the count of books held now
    pub count: i64,
    pub limit: i64,
    // fees owed, in cents
    pub owed: i64,
}

pub struct Members {
    pub list: Vec<Member>,
}

impl Members {
    pub fn new() -> Members {
        Members { list: Vec::new() }
    }

    pub fn join(self: *Members, name: [u8], limit: i64) -> i64 {
        let id = 100 + self.list.len();
        self.list.push(Member { id: id, name: name, count: 0, limit: limit, owed: 0 });
        id
    }

    pub fn free(self: *Members) {
        self.list.free();
    }
}

// The index of member `id`, or None.
pub fn find(ms: *Members, id: i64) -> Option<i64> {
    for i in 0..ms.list.len() {
        if ms.list.get(i).id == id {
            return Some(i);
        }
    }
    None
}

pub fn can_borrow(m: Member) -> bool {
    m.count < m.limit && m.owed == 0
}
