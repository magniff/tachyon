// The library's books: what it owns, and how many copies of each are on
// the shelf right now.

pub struct Book {
    pub id: i64,
    pub title: [u8],
    pub author: [u8],
    // copies on the shelf (the others are lent)
    pub count: i64,
    pub owned: i64,
}

pub struct Catalog {
    pub books: Vec<Book>,
}

impl Catalog {
    pub fn new() -> Catalog {
        Catalog { books: Vec::new() }
    }

    // A new title, with `n` copies; its id is its place in the catalog.
    pub fn add(self: *Catalog, title: [u8], author: [u8], n: i64) -> i64 {
        let id = self.books.len() + 1;
        self.books.push(Book { id: id, title: title, author: author, count: n, owned: n });
        id
    }

    pub fn free(self: *Catalog) {
        self.books.free();
    }
}

// The index of book `id` in the catalog, or None.
pub fn find(cat: *Catalog, id: i64) -> Option<i64> {
    for i in 0..cat.books.len() {
        if cat.books.get(i).id == id {
            return Some(i);
        }
    }
    None
}

// One copy off the shelf; false when none is left.
pub fn take(cat: *Catalog, id: i64) -> bool {
    match find(cat, id) {
        Some(i) => {
            let mut b = cat.books.get(i);
            if b.count == 0 {
                return false;
            }
            b.count -= 1;
            cat.books.set(i, b);
            true
        }
        None => false,
    }
}

// A copy back on the shelf.
pub fn put_back(cat: *Catalog, id: i64) {
    if let Some(i) = find(cat, id) {
        let mut b = cat.books.get(i);
        b.count += 1;
        cat.books.set(i, b);
    }
}
