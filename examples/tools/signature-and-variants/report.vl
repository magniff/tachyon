// Statements: what each event was, in words.

use std::Buf;

use crate::account::Account;
use crate::event::Event;

pub fn describe(e: Event, gpa: Gpa) -> Buf {
    match e {
        Event::Deposit(n) => format_in(f"deposit of {n}", gpa),
        Event::Withdraw(n) => format_in(f"withdrawal of {n}", gpa),
        Event::Transfer(to, n) => format_in(f"transfer of {n} to #{to}", gpa),
        Event::Interest(p) => format_in(f"interest at {p} per mille", gpa),
    }
}

// Money in, for the account the event happens to.
pub fn is_credit(e: Event) -> bool {
    match e {
        Event::Deposit(_) | Event::Interest(_) => true,
        Event::Withdraw(_) | Event::Transfer(_, _) => false,
    }
}

pub fn summary(a: Account) {
    println(f"#{a.id} {a.owner:<10} balance {a.balance:>6}, may go to -{a.limit}");
}
