// A small bank: accounts, a ledger of events, and the statements.

mod account;
mod event;
mod ledger;
mod report;

use account::open;
use ledger::{apply, new_ledger, transfer};
use report::{describe, is_credit, summary};

fn main(gpa: Gpa) -> i32 {
    var l = new_ledger(gpa);
    defer l.accounts.free();
    l.accounts.push(open(1, "Ada", 0));
    l.accounts.push(open(2, "Grace", 5000));

    // The house lends interest from its own reserve.
    l.accounts.set(0, account::Account { id: 0, owner: "the bank", balance: 100000, limit: 0 });

    let day = [
        (1, "deposit 12000"),
        (2, "withdraw 3000"),
        (1, "transfer 2 4500"),
        (2, "withdraw 9000"),
        (1, "interest 15"),
        (1, "withdraw 99999"),
        (2, "lend 7"),
    ];
    var k = 0;
    for (who, line) in day {
        k += 1;
        match event::parse(line, gpa) {
            Some(e) => {
                var what = describe(e, gpa);
                let ok = apply(&l, who, e, k);
                let sign = if is_credit(e) { "+" } else { "-" };
                let verdict = if ok { "ok" } else { "refused" };
                println(f"day {k}: #{who} {sign} {what.as_slice()}: {verdict}");
            }
            None => println(f"day {k}: #{who} cannot read '{line}'"),
        }
    }
    // Grace pays Ada back directly.
    transfer(&l, 1000, 2, 1);
    for a in l.accounts.iter() {
        summary(a);
    }
    0
}
