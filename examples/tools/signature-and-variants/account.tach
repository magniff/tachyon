// Accounts: a balance in cents, and how far below zero it may go.

pub struct Account {
    pub id: i64,
    pub owner: [u8],
    pub balance: i64,
    // how far below zero the balance may go
    pub limit: i64,
}

pub fn open(id: i64, owner: [u8], limit: i64) -> Account {
    Account { id: id, owner: owner, balance: 0, limit: limit }
}

// The bank's own account, which collects what it charges.
pub fn house() -> Account {
    Account { id: 0, owner: "the bank", balance: 0, limit: 0 }
}

pub fn can_pay(a: &Account, amount: i64) -> bool {
    a.balance + a.limit >= amount
}
