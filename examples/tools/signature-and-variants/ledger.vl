// The ledger: every account, and the events applied to them.

use crate::account::{Account, can_pay, house};
use crate::event::Event;

pub struct Ledger {
    pub accounts: Vec<Account>,
}

pub fn new_ledger(gpa: Gpa) -> Ledger {
    var l = Ledger { accounts: Vec::new_in(gpa) };
    l.accounts.push(house());
    l
}

fn index_of(l: Ledger, id: i64) -> Option<i64> {
    for i in 0..l.accounts.len() {
        if l.accounts.get(i).id == id {
            return Some(i);
        }
    }
    None
}

fn credit(l: inout Ledger, id: i64, amount: i64) {
    if let Some(i) = index_of(l, id) {
        var a = l.accounts.get(i);
        a.balance += amount;
        l.accounts.set(i, a);
    }
}

fn debit(l: inout Ledger, id: i64, amount: i64) -> bool {
    match index_of(l, id) {
        Some(i) => {
            var a = l.accounts.get(i);
            if amount < 0 || !can_pay(a, amount) {
                return false;
            }
            a.balance -= amount;
            l.accounts.set(i, a);
            true
        }
        None => false,
    }
}

// `amount` from one account to another; false when it cannot pay.
pub fn transfer(l: inout Ledger, amount: i64, from: i64, to: i64) -> bool {
    if index_of(l, to).is_none() || !debit(&l, from, amount) {
        return false;
    }
    credit(&l, to, amount);
    true
}

pub fn balance(l: Ledger, id: i64) -> i64 {
    match index_of(l, id) {
        Some(i) => l.accounts.get(i).balance,
        None => 0,
    }
}

// One event on account `who`; false when it was refused.
pub fn apply(l: inout Ledger, who: i64, e: Event, day: i64) -> bool {
    match e {
        Event::Deposit(n) => {
            if n <= 0 {
                return false;
            }
            credit(&l, who, n);
            true
        }
        Event::Withdraw(n) => debit(&l, who, n),
        Event::Transfer(to, n) => transfer(&l, n, who, to),
        Event::Interest(permille) => {
            let b = balance(l, who);
            if b <= 0 {
                return true;
            }
            transfer(&l, b * permille / 1000, 0, who)
        }
    }
}
