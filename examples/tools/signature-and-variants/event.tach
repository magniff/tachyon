// What happens to an account, read from lines like `deposit 500`.

use std::{parse_int, split_whitespace_in};

pub enum Event {
    Deposit(i64),
    Withdraw(i64),
    // to the account with this id, this amount
    Transfer(i64, i64),
    // interest, in tenths of a percent of the balance
    Interest(i64),
}

fn number(word: [u8]) -> i64 {
    parse_int(word).unwrap_or(-1)
}

pub fn parse(line: [u8], gpa: Gpa) -> Option<Event> {
    let mut w = split_whitespace_in(line, gpa);
    let w = w.as_slice();
    if w.len == 2 && w[0] == "deposit" {
        return Some(Event::Deposit(number(w[1])));
    }
    if w.len == 2 && w[0] == "withdraw" {
        return Some(Event::Withdraw(number(w[1])));
    }
    if w.len == 3 && w[0] == "transfer" {
        return Some(Event::Transfer(number(w[1]), number(w[2])));
    }
    if w.len == 2 && w[0] == "interest" {
        return Some(Event::Interest(number(w[1])));
    }
    None
}
