// Run-length encoding: each run of one byte becomes a count (1 to 255)
// and the byte.

fn run_at(s: [u8], i: i64) -> i64 {
    let mut n = 1;
    while i + n < s.len && s[i + n] == s[i] && n < 255 {
        n += 1;
    }
    n
}

pub fn encode(s: [u8]) -> Vec<u8> {
    let mut out: Vec<u8> = Vec::new();
    let mut i = 0;
    while i < s.len {
        let n = run_at(s, i);
        out.push(n as u8);
        out.push(s[i]);
        i += n;
    }
    out
}

// The bytes back; None when `s` is not an encoding (an odd length, or
// a count of 0).
pub fn decode(s: [u8]) -> Option<Vec<u8>> {
    if s.len % 2 != 0 {
        return None;
    }
    let mut out: Vec<u8> = Vec::new();
    let mut i = 0;
    while i < s.len {
        let n = s[i] as i64;
        if n == 0 {
            out.free();
            return None;
        }
        for _ in 0..n {
            out.push(s[i + 1]);
        }
        i += 2;
    }
    Some(out)
}

// The longest run in `s`.
pub fn longest_run(s: [u8]) -> i64 {
    let mut best = 0;
    let mut i = 0;
    while i < s.len {
        let n = run_at(s, i);
        if n > best {
            best = n;
        }
        i += n;
    }
    best
}
