// pack: run-length encodes stdin, checks that it decodes back, and
// reports sizes and Adler-32 checksums.

mod adler;
mod rle;

use adler::{adler32, hex8};
use std::read_stdin_in;

fn percent(part: i64, whole: i64) -> i64 {
    if whole == 0 { 0 } else { part * 100 / whole }
}

fn main(gpa: Gpa) -> i32 {
    let mut input = read_stdin_in(gpa).unwrap();
    defer input.free();
    let s = input.as_slice();
    let mut packed = rle::encode(s, gpa);
    defer packed.free();
    let p = packed.as_slice();

    // check the round trip before reporting anything
    let ok = match rle::decode(p, gpa) {
        Some(v) => {
            let mut back = v;
            let same = back.as_slice() == s;
            back.free();
            same
        }
        None => false,
    };
    if !ok {
        eprintln("pack: the encoding does not decode back");
        return 1;
    }

    let mut c1 = hex8(adler32(s), gpa);
    defer c1.free();
    let mut c2 = hex8(adler32(p), gpa);
    defer c2.free();
    println(f"in   {s.len:>6} bytes  adler32 {c1.as_slice()}");
    println(
        f"out  {p.len:>6} bytes  adler32 {c2.as_slice()}  ({percent(p.len, s.len)}% of the input)");
    println(f"longest run {rle::longest_run(s)}");
    0
}
