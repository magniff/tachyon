// Adler-32, the checksum of zlib: two running sums modulo a prime.

pub fn adler32(data: [u8]) -> u64 {
    let mut a: u64 = 1;
    let mut b: u64 = 0;
    for x in data {
        a = (a + x as u64) % 65521;
        b = (b + a) % 65521;
    }
    (b << 16) | a
}

// The checksum as 8 hex digits.
pub fn hex8(v: u64, gpa: Gpa) -> std::Buf {
    format_in(f"{v:08x}", gpa)
}
