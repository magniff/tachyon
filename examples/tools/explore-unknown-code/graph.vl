// The network as a graph: stations are numbers, each with the edges
// that leave it.

// A ride from one station to the next on one line.
pub struct Edge {
    pub to: i64,
    pub minutes: i64,
    pub line: u8,
}

pub struct Graph {
    pub names: Vec<[u8]>,
    // edges[i]: the rides that leave station i
    pub edges: Vec<Vec<Edge>>,
}

pub fn new_graph(gpa: Gpa) -> Graph {
    Graph { names: Vec::new_in(gpa), edges: Vec::new_in(gpa) }
}

pub fn size(g: Graph) -> i64 {
    g.names.len()
}

// The station called `name`, added when it is new.
pub fn station(g: inout Graph, name: [u8], gpa: Gpa) -> i64 {
    if let Some(i) = find(g, name) {
        return i;
    }
    g.names.push(name);
    g.edges.push(Vec::new_in(gpa));
    g.names.len() - 1
}

pub fn find(g: Graph, name: [u8]) -> Option<i64> {
    g.names.iter().position(|n: [u8]| n == name)
}

pub fn name_of(g: Graph, i: i64) -> [u8] {
    g.names[i]
}

fn add_edge(g: inout Graph, from: i64, e: Edge) {
    g.edges[from].push(e);
}

// Trains run both ways.
pub fn connect(g: inout Graph, a: i64, b: i64, minutes: i64, line: u8) {
    add_edge(&g, a, Edge { to: b, minutes: minutes, line: line });
    add_edge(&g, b, Edge { to: a, minutes: minutes, line: line });
}

pub fn edges_from(g: Graph, i: i64) -> [Edge] {
    g.edges[i].as_slice()
}
