// transit: the quickest routes across the city's train network, with
// the legs to ride and where to change.

mod graph;
mod heap;
mod network;
mod route;

use graph::{find, name_of};
use route::quickest;

fn plan(g: graph::Graph, from: [u8], to: [u8], gpa: Gpa) {
    let (a, b) = match (find(g, from), find(g, to)) {
        (Some(a), Some(b)) => (a, b),
        _ => {
            println(f"{from} -> {to}: no such station");
            return;
        }
    };
    match quickest(g, a, b, gpa) {
        Some(r) => {
            println(f"{from} -> {to}: {r.total} min");
            for l in r.legs.iter() {
                println(
                    f"  line {l.line:c}  {name_of(g, l.from):<10} -> {name_of(g, l.to):<10} {l.minutes:>3} min");
            }
        }
        None => println(f"{from} -> {to}: no route"),
    }
}

fn main(gpa: Gpa) -> i32 {
    let g = network::load(gpa);
    plan(g, "Airport", "Museum", gpa);
    plan(g, "Airport", "Market", gpa);
    plan(g, "Beach", "Stadium", gpa);
    plan(g, "Airport", "Moon", gpa);
    0
}
