// transit: the quickest routes across the city's train network, with
// the legs to ride and where to change.

mod graph;
mod heap;
mod network;
mod route;

use graph::{find, free_graph, name_of};
use route::quickest;

fn plan(g: *graph::Graph, from: [u8], to: [u8]) {
    let (a, b) = match (find(g, from), find(g, to)) {
        (Some(a), Some(b)) => (a, b),
        _ => {
            println(f"{from} -> {to}: no such station");
            return;
        }
    };
    match quickest(g, a, b) {
        Some(r) => {
            println(f"{from} -> {to}: {r.total} min");
            for l in r.legs.iter() {
                println(
                    f"  line {l.line:c}  {name_of(g, l.from):<10} -> {name_of(g, l.to):<10} {l.minutes:>3} min");
            }
            let mut legs = r.legs;
            legs.free();
        }
        None => println(f"{from} -> {to}: no route"),
    }
}

fn main() -> i32 {
    let mut g = network::load();
    defer free_graph(&g);
    plan(&g, "Airport", "Museum");
    plan(&g, "Airport", "Market");
    plan(&g, "Beach", "Stadium");
    plan(&g, "Airport", "Moon");
    0
}
