// A binary min-heap of search states, cheapest first.

pub struct Entry {
    pub cost: i64,
    pub node: i64,
    // the line the state arrived on; 0 at the start
    pub line: u8,
}

pub struct MinHeap {
    items: Vec<Entry>,
}

pub fn new_heap() -> MinHeap {
    MinHeap { items: Vec::new() }
}

pub fn is_empty(h: *MinHeap) -> bool {
    h.items.len() == 0
}

pub fn push(h: *MinHeap, e: Entry) {
    h.items.push(e);
    let mut i = h.items.len() - 1;
    while i > 0 {
        let parent = (i - 1) / 2;
        if h.items.get(parent).cost <= h.items.get(i).cost {
            break;
        }
        h.items.swap(parent, i);
        i = parent;
    }
}

pub fn pop(h: *MinHeap) -> Option<Entry> {
    let n = h.items.len();
    if n == 0 {
        return None;
    }
    h.items.swap(0, n - 1);
    let top = h.items.pop();
    let n = n - 1;
    let mut i = 0;
    loop {
        let l = 2 * i + 1;
        let r = l + 1;
        let mut least = i;
        if l < n && h.items.get(l).cost < h.items.get(least).cost {
            least = l;
        }
        if r < n && h.items.get(r).cost < h.items.get(least).cost {
            least = r;
        }
        if least == i {
            break;
        }
        h.items.swap(i, least);
        i = least;
    }
    top
}

pub fn free_heap(h: *MinHeap) {
    h.items.free();
}
