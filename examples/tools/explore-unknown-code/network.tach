// The city's network, from its timetable: one ride per line, `LINE FROM
// TO MINUTES`.

use crate::graph::{Graph, connect, new_graph, station};
use std::{parse_int, split_in, split_whitespace_in};

static TIMETABLE: [u8] = "\
    A Airport Docks 7\n\
    A Docks Central 5\n\
    A Central Museum 4\n\
    A Museum University 6\n\
    B Harbor Central 9\n\
    B Central Market 3\n\
    B Market Stadium 8\n\
    C Docks Harbor 6\n\
    C Harbor Beach 11\n\
    C University Stadium 7\n";

pub fn load(gpa: Gpa) -> Graph {
    let mut g = new_graph(gpa);
    let mut rows = split_in(TIMETABLE, '\n', gpa);
    for row in rows.as_slice() {
        let mut w = split_whitespace_in(row, gpa);
        let w = w.as_slice();
        if w.len() != 4 {
            continue;
        }
        let a = station(&mut g, w[1], gpa);
        let b = station(&mut g, w[2], gpa);
        let minutes = parse_int(w[3]).unwrap_or(0);
        connect(&mut g, a, b, minutes, w[0][0]);
    }
    g
}
