// The quickest route between two stations: Dijkstra's search over the
// graph, where changing lines costs a transfer.

use crate::graph::{Graph, edges_from, size};
use crate::heap::{Entry, free_heap, is_empty, new_heap, pop, push};

// Minutes lost changing from one line to another at a station.
pub const TRANSFER_MINUTES: i64 = 5;

pub struct Leg {
    pub from: i64,
    pub to: i64,
    pub line: u8,
    pub minutes: i64,
}

pub struct Route {
    pub legs: Vec<Leg>,
    pub total: i64,
}

// How a station was first reached: from where, on which line.
struct Step {
    from: i64,
    line: u8,
    minutes: i64,
}

// What a ride on `e` costs, arriving at its start on `here_line`.
fn ride_cost(here_line: u8, minutes: i64, line: u8) -> i64 {
    if line != here_line { minutes + TRANSFER_MINUTES } else { minutes }
}

pub fn quickest(g: *Graph, from: i64, to: i64) -> Option<Route> {
    let n = size(g);
    let mut best: Vec<i64> = Vec::filled(n, i64::MAX);
    defer best.free();
    let mut how: Vec<Step> = Vec::filled(n, Step { from: -1, line: 0, minutes: 0 });
    defer how.free();
    let mut h = new_heap();
    defer free_heap(&h);

    best.set(from, 0);
    push(&h, Entry { cost: 0, node: from, line: 0 });
    while !is_empty(&h) {
        let cur = pop(&h).unwrap();
        if cur.cost > best.get(cur.node) {
            continue;
        }
        if cur.node == to {
            break;
        }
        for e in edges_from(g, cur.node) {
            let cost = cur.cost + ride_cost(cur.line, e.minutes, e.line);
            if cost < best.get(e.to) {
                best.set(e.to, cost);
                how.set(e.to, Step { from: cur.node, line: e.line, minutes: e.minutes });
                push(&h, Entry { cost: cost, node: e.to, line: e.line });
            }
        }
    }
    if best.get(to) == i64::MAX {
        return None;
    }
    Some(Route { legs: legs_to(&how, from, to), total: best.get(to) })
}

// The legs from `from` to `to`, read backwards from `how`, then turned
// around; consecutive rides on one line are one leg.
fn legs_to(how: *Vec<Step>, from: i64, to: i64) -> Vec<Leg> {
    let mut back: Vec<Leg> = Vec::new();
    let mut at = to;
    while at != from {
        let s = how.get(at);
        back.push(Leg { from: s.from, to: at, line: s.line, minutes: s.minutes });
        at = s.from;
    }
    let mut legs: Vec<Leg> = Vec::new();
    while let Some(l) = back.pop() {
        match legs.last() {
            Some(prev) if prev.line == l.line => {
                let k = legs.len() - 1;
                legs.set(k,
                    Leg {
                        from: prev.from, to: l.to, line: l.line, minutes: prev.minutes + l.minutes
                    });
            }
            _ => legs.push(l),
        }
    }
    back.free();
    legs
}
