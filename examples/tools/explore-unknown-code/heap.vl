// A binary min-heap of search states, cheapest first.

pub struct Entry {
    pub cost: i64,
    pub node: i64,
    // the line the state arrived on; 0 at the start
    pub line: u8,
}

pub struct Heap {
    items: Vec<Entry>,
}

pub fn new_heap(gpa: Gpa) -> Heap {
    Heap { items: Vec::new_in(gpa) }
}

pub fn is_empty(h: Heap) -> bool {
    h.items.len() == 0
}

pub fn push(h: inout Heap, e: Entry) {
    h.items.push(e);
    var i = h.items.len() - 1;
    while i > 0 {
        let parent = (i - 1) / 2;
        if h.items[parent].cost <= h.items[i].cost {
            break;
        }
        h.items.swap(parent, i);
        i = parent;
    }
}

pub fn pop(h: inout Heap) -> Option<Entry> {
    let n = h.items.len();
    if n == 0 {
        return None;
    }
    h.items.swap(0, n - 1);
    let top = h.items.pop();
    let n = n - 1;
    var i = 0;
    loop {
        let l = 2 * i + 1;
        let r = l + 1;
        var least = i;
        if l < n && h.items[l].cost < h.items[least].cost {
            least = l;
        }
        if r < n && h.items[r].cost < h.items[least].cost {
            least = r;
        }
        if least == i {
            break;
        }
        h.items.swap(i, least);
        i = least;
    }
    top
}
