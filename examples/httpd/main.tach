// httpd: a simple HTTP file server, a clone of `python -m http.server`:
// serves the files and directory listings of a directory on
// http://127.0.0.1:8000/.
//
// usage: httpd [DIRECTORY]          (default: the current directory)
//   e.g. httpd /var/www
//        httpd .
//
// It runs on Linux and macOS, built for either from either: the C library
// is declared by hand, and where the systems differ (socket constants,
// struct sockaddr_in, struct dirent) the module `sys` asks uname() which
// one it runs on.

use std::Buf;

extern "C" {
    fn socket(domain: i32, kind: i32, protocol: i32) -> i32;
    fn setsockopt(fd: i32, level: i32, name: i32, value: *u8, len: u32) -> i32;
    fn bind(fd: i32, addr: *u8, len: u32) -> i32;
    fn listen(fd: i32, backlog: i32) -> i32;
    fn accept(fd: i32, addr: *u8, len: *u32) -> i32;
    fn read(fd: i32, buf: *u8, count: u64) -> i64;
    fn write(fd: i32, buf: *u8, count: u64) -> i64;
    fn open(path: *u8, flags: i32, ...) -> i32;
    fn close(fd: i32) -> i32;
    fn lseek(fd: i32, offset: i64, whence: i32) -> i64;
    fn opendir(path: *u8) -> *u8;
    fn readdir(dir: *u8) -> *u8;
    fn closedir(dir: *u8) -> i32;
    fn strlen(s: *u8) -> u64;
    fn getcwd(buf: *u8, size: u64) -> *u8;
    fn realpath(path: *u8, resolved: *u8) -> *u8;
    fn uname(names: *u8) -> i32;
}

const PORT: u16 = 8000;
const LOCALHOST: u32 = 0x7f000001; // 127.0.0.1
const O_RDONLY: i32 = 0;
const SEEK_END: i32 = 2;
const PATH_MAX: i64 = 4096;

// ============================================================================
// What differs between Linux and macOS
// ============================================================================

mod sys {
    use super::{bind, close, listen, setsockopt, socket, strlen, uname};

    // The system the program runs on. Intel Macs keep the old struct
    // dirent under readdir's plain name.
    pub enum System { Linux, MacArm, MacIntel }

    fn starts_with(s: [u8], prefix: [u8]) -> bool {
        s.len >= prefix.len && s[..prefix.len] == prefix
    }

    pub fn detect() -> System {
        // struct utsname: five fields of 256 bytes on macOS (the machine
        // last), six of 65 on Linux; the system's name comes first.
        let mut names: [u8; 1280] = [0; 1280];
        if unsafe { uname(&names as *u8) != 0 || !starts_with(names[..], "Darwin") } {
            return System::Linux;
        }
        if starts_with(names[1024..], "arm64") { System::MacArm } else { System::MacIntel }
    }

    // struct sockaddr_in: BSD puts the length before the family.
    #[repr(C)]
    struct SockaddrIn { family: u16, port: u16, addr: u32, zero: [u8; 8] }

    #[repr(C)]
    struct SockaddrInBsd { len: u8, family: u8, port: u16, addr: u32, zero: [u8; 8] }

    const AF_INET: i32 = 2;
    const SOCK_STREAM: i32 = 1;

    fn swap16(x: u16) -> u16 {
        (x << 8) | (x >> 8)
    }

    fn swap32(x: u32) -> u32 {
        (x << 24) | ((x & 0xff00) << 8) | ((x >> 8) & 0xff00) | (x >> 24)
    }

    // A TCP socket listening on addr:port (in host order), with
    // SO_REUSEADDR; or the message of what failed.
    pub fn listen_tcp(system: System, addr: u32, port: u16) -> Result<i32, [u8]> {
        let fd = unsafe { socket(AF_INET, SOCK_STREAM, 0) };
        if fd < 0 {
            return Err("error: socket() failed\n");
        }
        // SOL_SOCKET and SO_REUSEADDR
        let linux = system == System::Linux;
        let level: i32 = if linux { 1 } else { 0xffff };
        let name: i32 = if linux { 2 } else { 4 };
        let one: i32 = 1;
        unsafe { setsockopt(fd, level, name, &one as *u8, size_of(i32) as u32); }

        let bound = if linux {
            let sa = SockaddrIn {
                family: AF_INET as u16, port: swap16(port), addr: swap32(addr), zero: [0; 8]
            };
            unsafe { bind(fd, &sa as *u8, size_of(SockaddrIn) as u32) }
        } else {
            let sa = SockaddrInBsd {
                len: size_of(SockaddrInBsd) as u8,
                family: AF_INET as u8,
                port: swap16(port),
                addr: swap32(addr),
                zero: [0; 8],
            };
            unsafe { bind(fd, &sa as *u8, size_of(SockaddrInBsd) as u32) }
        };
        if bound < 0 {
            unsafe { close(fd); }
            return Err("error: bind() failed (port 8000 in use?)\n");
        }
        if unsafe { listen(fd, 128) < 0 } {
            unsafe { close(fd); }
            return Err("error: listen() failed\n");
        }
        Ok(fd)
    }

    // struct dirent as readdir returns it on each system (d_name is as
    // long as the name).
    #[repr(C)]
    struct DirentLinux { ino: u64, off: i64, reclen: u16, r#type: u8, name: [u8; 256] }

    #[repr(C)]
    struct DirentMac {
        ino: u64, seekoff: u64, reclen: u16, namlen: u16, r#type: u8, name: [u8; 1024]
    }

    #[repr(C)]
    struct DirentMacOld { ino: u32, reclen: u16, r#type: u8, namlen: u8, name: [u8; 256] }

    // O_NONBLOCK, so that opening a FIFO does not wait for a writer
    pub fn o_nonblock(system: System) -> i32 {
        if system == System::Linux { 0x800 } else { 0x4 }
    }

    pub const DT_UNKNOWN: u8 = 0;
    pub const DT_DIR: u8 = 4;

    // The name (NUL-terminated) and the d_type of an entry from readdir.
    pub fn dirent(system: System, entry: *u8) -> (*u8, u8) {
        match system {
            System::Linux => {
                let d = entry as *DirentLinux;
                unsafe { (&d.name as *u8, d.r#type) }
            }
            System::MacArm => {
                let d = entry as *DirentMac;
                unsafe { (&d.name as *u8, d.r#type) }
            }
            System::MacIntel => {
                let d = entry as *DirentMacOld;
                unsafe { (&d.name as *u8, d.r#type) }
            }
        }
    }

    // The bytes of a C string.
    pub fn cstr(s: *u8) -> [u8] {
        unsafe { s[0..strlen(s) as i64] }
    }
}

use sys::System;

// ============================================================================
// Bytes and paths
// ============================================================================

fn ends_with(s: [u8], suffix: [u8]) -> bool {
    s.len >= suffix.len && s[s.len - suffix.len..] == suffix
}

// A path for C: its bytes and a NUL.
struct Path { buf: Buf }

impl Path {
    // dir/name, without doubling the slash between them.
    fn join(dir: [u8], name: [u8]) -> Path {
        let mut buf = Buf::new();
        buf.push_str(dir);
        let dir_slash = ends_with(dir, "/");
        let name_slash = name.len > 0 && name[0] == '/';
        if dir_slash && name_slash {
            buf.push_str(name[1..]);
        } else {
            if !dir_slash && !name_slash {
                buf.push('/');
            }
            buf.push_str(name);
        }
        buf.push(0);
        Path { buf: buf }
    }

    fn c(self: *Path) -> *u8 {
        self.buf.as_slice().ptr
    }

    fn bytes(self: *Path) -> [u8] {
        let s = self.buf.as_slice();
        s[..s.len - 1]
    }

    fn free(self: *Path) {
        self.buf.free();
    }
}

// What a path names.
enum Kind { Missing, Dir, File(i64) }

fn probe(system: System, path: *u8) -> Kind {
    let dir = unsafe { opendir(path) };
    if dir as u64 != 0 {
        unsafe { closedir(dir); }
        return Kind::Dir;
    }
    let fd = unsafe { open(path, O_RDONLY | sys::o_nonblock(system)) };
    if fd < 0 {
        return Kind::Missing;
    }
    defer unsafe { close(fd) };
    unsafe { Kind::File(lseek(fd, 0, SEEK_END)) }
}

// ============================================================================
// URL decoding: %XX sequences, and '+' as a space
// ============================================================================

fn hex_val(ch: u8) -> Option<u8> {
    match ch {
        '0'..='9' => Some(ch - '0'),
        'A'..='F' => Some(ch - 'A' + 10),
        'a'..='f' => Some(ch - 'a' + 10),
        _ => None,
    }
}

fn url_decode(s: [u8]) -> Buf {
    let mut out = Buf::new();
    let mut r = 0;
    while r < s.len {
        let ch = s[r];
        r += 1;
        if ch == '%' && r + 1 < s.len {
            if let Some(hi) = hex_val(s[r]) {
                if let Some(lo) = hex_val(s[r + 1]) {
                    out.push(hi * 16 + lo);
                    r += 2;
                    continue;
                }
            }
        }
        out.push(if ch == '+' { ' ' } else { ch });
    }
    out
}

// ============================================================================
// MIME type detection (minimal, by extension)
// ============================================================================

struct Mime { ext: [u8], kind: [u8] }

fn guess_mime(path: [u8]) -> [u8] {
    let types = [
        Mime { ext: ".html", kind: "text/html; charset=utf-8" },
        Mime { ext: ".htm", kind: "text/html; charset=utf-8" },
        Mime { ext: ".css", kind: "text/css" },
        Mime { ext: ".js", kind: "application/javascript" },
        Mime { ext: ".json", kind: "application/json" },
        Mime { ext: ".txt", kind: "text/plain; charset=utf-8" },
        Mime { ext: ".md", kind: "text/plain; charset=utf-8" },
        Mime { ext: ".png", kind: "image/png" },
        Mime { ext: ".jpg", kind: "image/jpeg" },
        Mime { ext: ".jpeg", kind: "image/jpeg" },
        Mime { ext: ".gif", kind: "image/gif" },
        Mime { ext: ".svg", kind: "image/svg+xml" },
        Mime { ext: ".ico", kind: "image/x-icon" },
        Mime { ext: ".pdf", kind: "application/pdf" },
        Mime { ext: ".zip", kind: "application/zip" },
        Mime { ext: ".tar", kind: "application/x-tar" },
        Mime { ext: ".gz", kind: "application/gzip" },
        Mime { ext: ".wasm", kind: "application/wasm" },
        Mime { ext: ".xml", kind: "application/xml" },
        Mime { ext: ".mp4", kind: "video/mp4" },
        Mime { ext: ".webm", kind: "video/webm" },
        Mime { ext: ".mp3", kind: "audio/mpeg" },
    ];
    for m in types {
        if ends_with(path, m.ext) {
            return m.kind;
        }
    }
    "application/octet-stream"
}

// ============================================================================
// HTML-escape a string for safe display (handles &, <, >, ")
// ============================================================================

fn push_escaped(out: *Buf, s: [u8]) {
    for ch in s {
        match ch {
            '&' => out.push_str("&amp;"),
            '<' => out.push_str("&lt;"),
            '>' => out.push_str("&gt;"),
            '"' => out.push_str("&quot;"),
            _ => out.push(ch),
        }
    }
}

// ============================================================================
// HTTP responses
// ============================================================================

fn send_all(fd: i32, s: [u8]) {
    let mut sent = 0;
    while sent < s.len {
        let n = unsafe { write(fd, &s[sent], (s.len - sent) as u64) };
        if n <= 0 {
            break;
        }
        sent += n;
    }
}

// The headers, with a Content-Length when it is known.
fn send_headers(fd: i32, status: [u8], content_type: [u8], length: Option<i64>) {
    let mut h = Buf::new();
    defer h.free();
    h.push_fmt(f"HTTP/1.0 {status}\r\nContent-Type: {content_type}");
    if let Some(n) = length {
        h.push_fmt(f"\r\nContent-Length: {n}");
    }
    h.push_str("\r\nConnection: close\r\n\r\n");
    send_all(fd, h.as_slice());
}

fn send_html(fd: i32, status: [u8], body: *Buf) {
    let bytes = body.as_slice();
    send_headers(fd, status, "text/html; charset=utf-8", Some(bytes.len));
    send_all(fd, bytes);
}

fn send_404(fd: i32, path: [u8]) {
    let mut body = Buf::new();
    defer body.free();
    body.push_str("<!DOCTYPE html><html><head><title>404 Not Found</title>");
    body.push_str("<style>body{font-family:sans-serif;margin:40px}</style></head>");
    body.push_str("<body><h1>404 Not Found</h1><p>The path <code>");
    push_escaped(&body, path);
    body.push_str("</code> was not found on this server.</p></body></html>");
    send_html(fd, "404 Not Found", &body);
}

fn send_redirect(fd: i32, location: [u8]) {
    let mut h = Buf::new();
    defer h.free();
    h.push_fmt(
        f"HTTP/1.0 301 Moved Permanently\r\nLocation: {location}\r\nConnection: close\r\n\r\n");
    send_all(fd, h.as_slice());
}

// ============================================================================
// Directory listing
// ============================================================================

fn push_style(out: *Buf) {
    out.push_str("<style>\n");
    out.push_str("body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; ");
    out.push_str("margin: 0; padding: 20px 40px; background: #fafafa; color: #333; }\n");
    out.push_str("h1 { font-weight: 400; border-bottom: 1px solid #ddd; padding-bottom: 10px; }\n");
    out.push_str("table { border-collapse: collapse; width: 100%; max-width: 800px; }\n");
    out.push_str("th, td { text-align: left; padding: 8px 16px; }\n");
    out.push_str("th { background: #eee; font-weight: 600; font-size: 0.85em; ");
    out.push_str("text-transform: uppercase; letter-spacing: 0.05em; }\n");
    out.push_str("tr:hover { background: #f0f0f0; }\n");
    out.push_str("a { color: #0066cc; text-decoration: none; }\n");
    out.push_str("a:hover { text-decoration: underline; }\n");
    out.push_str(".dir { font-weight: 600; }\n");
    out.push_str(".size { font-variant-numeric: tabular-nums; color: #666; }\n");
    out.push_str(".icon { width: 20px; }\n");
    out.push_str("</style>\n");
}

fn serve_directory(fd: i32, system: System, dir_path: *Path, url: [u8]) {
    let dir = unsafe { opendir(dir_path.c()) };
    if dir as u64 == 0 {
        send_404(fd, url);
        return;
    }
    defer unsafe { closedir(dir) };

    let mut body = Buf::new();
    defer body.free();
    body.push_str("<!DOCTYPE html>\n<html>\n<head>\n");
    body.push_str("<meta charset=\"utf-8\">\n");
    body.push_str("<title>Directory listing for ");
    push_escaped(&body, url);
    body.push_str("</title>\n");
    push_style(&body);
    body.push_str("</head>\n<body>\n");
    body.push_str("<h1>Directory listing for ");
    push_escaped(&body, url);
    body.push_str("</h1>\n");
    if url.len > 1 {
        body.push_str("<p><a href=\"..\">Parent directory</a></p>\n");
    }
    body.push_str("<table>\n<tr><th class=\"icon\"></th><th>Name</th><th>Size</th></tr>\n");

    loop {
        let entry = unsafe { readdir(dir) };
        if entry as u64 == 0 {
            break;
        }
        let (cname, dtype) = unsafe { sys::dirent(system, entry) };
        let name = unsafe { sys::cstr(cname) };
        if ends_with(name, ".") && (name.len == 1 || name.len == 2 && name[0] == '.') {
            continue;
        }

        let mut path = Path::join(dir_path.bytes(), name);
        defer path.free();
        let kind = unsafe { probe(system, path.c()) };
        // d_type is DT_UNKNOWN on file systems that do not keep it
        let is_dir = if dtype == sys::DT_UNKNOWN { kind == Kind::Dir }
            else { dtype == sys::DT_DIR };

        body.push_str("<tr><td class=\"icon\">");
        body.push_str("</td><td><a ");
        if is_dir {
            body.push_str("class=\"dir\" ");
        }
        body.push_str("href=\"");
        push_escaped(&body, name);
        if is_dir {
            body.push('/');
        }
        body.push_str("\">");
        push_escaped(&body, name);
        if is_dir {
            body.push('/');
        }
        body.push_str("</a></td><td class=\"size\">");
        match kind {
            _ if is_dir => body.push('-'),
            Kind::File(size) if size >= 0 => body.push_int(size),
            _ => body.push('?'),
        }
        body.push_str("</td></tr>\n");
    }

    body.push_str("</table>\n");
    body.push_str("<hr><p style=\"color:#999;font-size:0.85em\">");
    body.push_str("Tachyon HTTP Server</p>\n");
    body.push_str("</body>\n</html>\n");
    send_html(fd, "200 OK", &body);
}

// ============================================================================
// File serving
// ============================================================================

fn serve_file(fd: i32, system: System, path: *Path, size: i64) {
    // (not to wait for a writer if it is a FIFO)
    let file = unsafe { open(path.c(), O_RDONLY | sys::o_nonblock(system)) };
    if file < 0 {
        send_404(fd, path.bytes());
        return;
    }
    defer unsafe { close(file) };

    // (a FIFO or a device has no size)
    let length: Option<i64> = if size >= 0 { Some(size) } else { None };
    send_headers(fd, "200 OK", guess_mime(path.bytes()), length);
    let mut chunk: [u8; 8192] = [0; 8192];
    loop {
        let n = unsafe { read(file, &chunk as *u8, 8192) };
        if n <= 0 {
            break;
        }
        send_all(fd, chunk[..n]);
    }
}

// ============================================================================
// Requests
// ============================================================================

// The method and the path (without the query) of a request line.
fn parse_request(req: [u8]) -> Option<([u8], [u8])> {
    let mut i = 0;
    while i < req.len && req[i] != ' ' {
        i += 1;
    }
    if i == req.len {
        return None;
    }
    let method = req[..i];
    let start = i + 1;
    i = start;
    while i < req.len && req[i] != ' ' && req[i] != '?' {
        i += 1;
    }
    if i == start {
        return None;
    }
    Some((method, req[start..i]))
}

fn handle_request(fd: i32, system: System, root: [u8]) {
    defer unsafe { close(fd) };
    let mut request: [u8; 8192] = [0; 8192];
    let n = unsafe { read(fd, &request as *u8, 8191) };
    if n <= 0 {
        return;
    }
    let (method, raw_path) = if let Some(parts) = parse_request(request[..n]) {
        parts
    } else {
        send_404(fd, "/");
        return;
    };

    let mut decoded = url_decode(raw_path);
    defer decoded.free();
    let url = decoded.as_slice();

    // log the request on stderr
    eprint(f"{method} {url}");

    let mut path = Path::join(root, url);
    defer path.free();
    match unsafe { probe(system, path.c()) } {
        Kind::Missing => {
            eprintln(" 404");
            send_404(fd, url);
        }
        Kind::File(size) => {
            eprintln(f" 200 ({guess_mime(path.bytes())})");
            serve_file(fd, system, &path, size);
        }
        Kind::Dir => {
            if !ends_with(url, "/") {
                let mut location = Buf::new();
                defer location.free();
                location.push_str(url);
                location.push('/');
                eprintln(" 301");
                send_redirect(fd, location.as_slice());
                return;
            }
            let mut index = Path::join(path.bytes(), "index.html");
            defer index.free();
            if let Kind::File(size) = unsafe { probe(system, index.c()) } {
                eprintln(" 200 (index.html)");
                serve_file(fd, system, &index, size);
                return;
            }
            eprintln(" 200 (dir)");
            serve_directory(fd, system, &path, url);
        }
    }
}

// ============================================================================
// Main: the root directory, then a socket and the accept loop
// ============================================================================

fn main(argc: i64, argv: **u8) -> i32 {
    let system = sys::detect();

    // argv[1] made absolute, else the current directory
    let mut root_buf: [u8; 4096] = [0; 4096];
    let root_c = &root_buf as *u8;
    if unsafe { argc < 2 || realpath(argv[1], root_c) as u64 == 0 } {
        if unsafe { getcwd(root_c, PATH_MAX as u64) as u64 == 0 } {
            eprintln("error: cannot get cwd");
            return 1;
        }
    }
    let root = unsafe { sys::cstr(root_c) };

    eprintln(f"Serving {root}");

    match sys::listen_tcp(system, LOCALHOST, PORT) {
        Err(message) => {
            eprint(message);
            1
        }
        Ok(server) => {
            eprintln("Serving HTTP on http://127.0.0.1:8000/ ...");
            loop {
                let fd = unsafe { accept(server, 0 as *u8, 0 as *u32) };
                if fd >= 0 {
                    handle_request(fd, system, root);
                }
            }
        }
    }
}
