// md5: the MD5 digest (RFC 1321) of a file, or of stdin, in hex.
//
// usage: md5 [FILE]
extern "C" {
    fn read(fd: i32, buf: *u8, count: u64) -> i64;
    fn open(path: *u8, flags: i32, ...) -> i32;
    fn close(fd: i32) -> i32;
}

use std::Buf;

const O_RDONLY: i32 = 0;

// The round constants: floor(2^32 * abs(sin(i + 1))).
static K: [u32; 64] = [
    0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee,
    0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
    0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be,
    0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
    0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa,
    0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
    0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed,
    0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
    0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c,
    0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
    0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05,
    0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
    0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039,
    0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
    0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1,
    0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
];

// The rotation of each step.
static SHIFT: [u32; 64] = [
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21,
];

fn rotl(x: u32, n: u32) -> u32 {
    (x << n) | (x >> (32 - n))
}

// The little-endian u32 at s[at..at + 4].
fn load_le(s: [u8], at: i64) -> u32 {
    s[at] as u32 | (s[at + 1] as u32 << 8) | (s[at + 2] as u32 << 16) | (s[at + 3] as u32 << 24)
}

// The digest of a stream of bytes: `update` with each part, then `finish`.
// `block` holds the bytes of a block not yet complete (`used` of them).
struct Md5 { state: [u32; 4], block: [u8; 64], used: i64, total: u64 }

impl Md5 {
    fn new() -> Md5 {
        Md5 {
            state: [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476],
            block: [0; 64],
            used: 0,
            total: 0,
        }
    }

    // Mixes one 64-byte block into the state.
    fn compress(self: *Md5, block: [u8]) {
        let mut m: [u32; 16] = [0; 16];
        for i in 0..16 {
            m[i] = load_le(block, i * 4);
        }
        let mut a = self.state[0];
        let mut b = self.state[1];
        let mut c = self.state[2];
        let mut d = self.state[3];
        for i in 0..64 {
            let mut f: u32 = 0;
            let mut g: i64 = 0;
            if i < 16 {
                f = (b & c) | (~b & d);
                g = i;
            } else if i < 32 {
                f = (d & b) | (~d & c);
                g = (5 * i + 1) % 16;
            } else if i < 48 {
                f = b ^ c ^ d;
                g = (3 * i + 5) % 16;
            } else {
                f = c ^ (b | ~d);
                g = (7 * i) % 16;
            }
            f = f + a + K[i] + m[g];
            a = d;
            d = c;
            c = b;
            b = b + rotl(f, SHIFT[i]);
        }
        self.state[0] += a;
        self.state[1] += b;
        self.state[2] += c;
        self.state[3] += d;
    }

    fn update(self: *Md5, data: [u8]) {
        self.total += data.len as u64;
        let mut at = 0;
        // complete the pending block first
        if self.used > 0 {
            while self.used < 64 && at < data.len {
                self.block[self.used] = data[at];
                self.used += 1;
                at += 1;
            }
            if self.used < 64 {
                return;
            }
            self.compress(self.block[..]);
            self.used = 0;
        }
        while data.len - at >= 64 {
            self.compress(data[at..at + 64]);
            at += 64;
        }
        for b in data[at..] {
            self.block[self.used] = b;
            self.used += 1;
        }
    }

    // Pads the message (a 1 bit, zeros, its length in bits) and returns
    // the digest.
    fn finish(self: *Md5) -> [u8; 16] {
        let bits = self.total * 8;
        let mut tail: [u8; 72] = [0; 72];
        tail[0] = 0x80;
        // up to 56 bytes into a block, then the 8 of the length
        let pad = if self.used < 56 { 56 - self.used } else { 120 - self.used };
        for i in 0..8 {
            tail[pad + i] = (bits >> (8 * i)) as u8;
        }
        self.update(tail[..pad + 8]);
        let mut digest: [u8; 16] = [0; 16];
        for i in 0..16 {
            digest[i] = (self.state[i / 4] >> (8 * (i % 4))) as u8;
        }
        digest
    }
}

fn main(argc: i64, argv: **u8) -> i32 {
    let mut fd: i32 = 0;
    if argc >= 2 {
        unsafe { fd = open(argv[1], O_RDONLY); }
        if fd < 0 {
            eprintln("error: cannot open file");
            return 1;
        }
    }
    defer if fd != 0 { unsafe { close(fd); } };

    let mut hash = Md5::new();
    let mut chunk: [u8; 65536] = [0; 65536];
    loop {
        let n = unsafe { read(fd, &chunk as *u8, 65536) };
        if n <= 0 {
            break;
        }
        hash.update(chunk[..n]);
    }

    // Each byte as two hex digits: the spec `02x` pads with a zero.
    let mut hex = Buf::new();
    defer hex.free();
    for byte in hash.finish() {
        hex.push_fmt(f"{byte:02x}");
    }
    println(hex.as_slice());
    0
}
