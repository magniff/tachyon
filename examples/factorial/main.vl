// Factorials of 1 to 10, two ways: recursively, and as the product of a
// range folded by a closure. Each line is an f-string.

// n! = n * (n - 1)!, and 0! = 1.
fn factorial(n: i64) -> i64 {
    if n == 0 { 1 } else { n * factorial(n - 1) }
}

// The same, with no recursion: 1 * 2 * ... * n.
fn factorial_fold(n: i64) -> i64 {
    (1..=n).fold(1, |acc, k| acc * k)
}

fn main() -> i32 {
    for n in 1..=10 {
        let f = factorial(n);
        if f != factorial_fold(n) {
            eprintln(f"the two disagree at {n}");
            return 1;
        }
        println(f"Factorial of {n} == {f}");
    }
    0
}
