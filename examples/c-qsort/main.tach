// c-qsort: sorting tachyon data with the C library's qsort, and finding
// it again with bsearch. The records are #[repr(C)] structs, so C sees
// the layout tachyon wrote; the comparisons are tachyon functions with
// C's calling convention (`extern "C" fn`), which qsort calls back.
import "stdlib.h" as c;
import "string.h" as c;

// One city: C's struct layout (field order, padding), so a pointer to it
// can go to C and come back.
#[repr(C)]
struct City { name: *u8, country: *u8, population: i64, area: f64 }

// The text of a C string, as a tachyon slice.
//
// Unsafe: `p` must point to a NUL-terminated string that outlives the
// slice.
unsafe fn text(p: *u8) -> [u8] {
    p[0..c::strlen(p) as i64]
}

// Callbacks: qsort hands them `const void *`, which arrives as *u8; each
// casts back to the type it knows the array holds.

extern "C" fn by_population(a: *u8, b: *u8) -> i32 {
    let x = unsafe { (*(a as *City)).population };
    let y = unsafe { (*(b as *City)).population };
    // not `x - y`: the difference of two i64 does not fit an i32
    if x < y { -1 } else if x > y { 1 } else { 0 }
}

extern "C" fn by_name(a: *u8, b: *u8) -> i32 {
    unsafe { c::strcmp((*(a as *City)).name, (*(b as *City)).name) }
}

// Population per square kilometre, descending.
extern "C" fn by_density_desc(a: *u8, b: *u8) -> i32 {
    let x = unsafe { density(*(a as *City)) };
    let y = unsafe { density(*(b as *City)) };
    if x > y { -1 } else if x < y { 1 } else { 0 }
}

// bsearch's comparison: the key against an element. The key need not be
// an element: here it is a tachyon slice, which C only passes along (as
// `const void *`) without looking inside.
extern "C" fn name_key(key: *u8, element: *u8) -> i32 {
    let wanted = unsafe { *(key as *[u8]) };
    let name = unsafe { text((*(element as *City)).name) };
    sign(wanted.cmp(&name))
}

fn sign(x: i64) -> i32 {
    if x < 0 { -1 } else if x > 0 { 1 } else { 0 }
}

fn density(city: City) -> f64 {
    city.population as f64 / city.area
}

// Any slice, any element type, sorted by a C comparison: the slice's
// pointer, length and element size are what qsort needs.
//
// Unsafe: `cmp` must read its two pointers as `T`s, which the compiler
// cannot check (a C callback sees only `void *`).
unsafe fn c_sort<T>(items: [T], cmp: extern "C" fn(*u8, *u8) -> i32) {
    c::qsort(items.ptr as *u8, items.len() as u64, size_of(T) as u64, cmp); // an unsafe fn body: no block needed
}

// The city named `name` in `cities` (sorted by name), if there is one.
fn find(cities: [City], name: [u8]) -> Option<City> {
    let hit = unsafe {
        c::bsearch(&name as *u8, cities.ptr as *u8, cities.len() as u64, size_of(City) as u64,
            name_key)
    };
    if hit == 0 as *u8 { None } else { Some(unsafe { *(hit as *City) }) }
}

fn show(title: [u8], cities: [City]) {
    println(f"{title}:");
    for (i, city) in cities.iter().enumerate() {
        let name = unsafe { text(city.name) };
        let country = unsafe { text(city.country) };
        let d = density(city);
        println(f"  {i + 1:>2}. {name:<12} {country:<10} {city.population:>9} {d:>8.1}/km2");
    }
}

fn main() -> i32 {
    let mut cities = [
        City { name: c"Lagos", country: c"Nigeria", population: 15388000, area: 1171.3 },
        City { name: c"Tokyo", country: c"Japan", population: 13960000, area: 2194.1 },
        City { name: c"Reykjavik", country: c"Iceland", population: 139875, area: 273.0 },
        City { name: c"Lima", country: c"Peru", population: 10092000, area: 2672.3 },
        City { name: c"Oslo", country: c"Norway", population: 709037, area: 454.0 },
        City { name: c"Montevideo", country: c"Uruguay", population: 1319108, area: 201.0 },
        City { name: c"Dhaka", country: c"Bangladesh", population: 10278882, area: 306.4 },
    ];
    println(f"{size_of(City)} bytes per City, {cities[..].len()} cities");
    println("");

    unsafe { c_sort(cities[..], by_population); }
    show("by population", cities[..]);
    unsafe { c_sort(cities[..], by_density_desc); }
    show("by density, densest first", cities[..]);
    unsafe { c_sort(cities[..], by_name); }
    show("by name", cities[..]);

    // bsearch needs the order qsort just made.
    println("");
    for name in ["Oslo", "Lima", "Atlantis"] {
        match find(cities[..], name) {
            Some(city) => println(f"found {name}: {city.population} people"),
            None => println(f"no {name}"),
        }
    }

    // The same wrapper sorts plain numbers: a C callback over i32s.
    let mut primes: [i32; 8] = [17, 2, 13, 5, 19, 3, 11, 7];
    unsafe { c_sort(primes[..], by_i32); }
    let total: i64 = primes[..].iter().fold(0, |acc, p| acc + p);
    println(f"primes {primes[0]}..{primes[7]}, sum {total}");
    0
}

extern "C" fn by_i32(a: *u8, b: *u8) -> i32 {
    let x = unsafe { *(a as *i32) };
    let y = unsafe { *(b as *i32) };
    if x < y { -1 } else if x > y { 1 } else { 0 }
}
