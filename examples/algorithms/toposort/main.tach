// Topological sorting, with Kahn's algorithm, and cycle detection, with a
// depth-first search that colours the nodes white, grey and black.
//
// A topological order lists a directed graph's nodes so that every edge
// goes forward: each task after the tasks it depends on. One exists if
// and only if the graph has no cycle. Kahn's algorithm repeatedly takes
// a node nothing points to any more; when it gets stuck, the graph has a
// cycle, and the depth-first search finds one to report.
//
//     tachyonc examples/algorithms/toposort/main.tach -o toposort && ./toposort
//
// A small build plan, given as text, is sorted, then broken by one more
// dependency; then a random DAG of 1,000,000 nodes and 4,000,000 edges
// is sorted, its longest path found, and a cycle added and detected. The
// results go to stdout, the times to stderr.

import "time.h" as c;

use std::{HashMap, split_whitespace};

// ---------------------------------------------------------------- graph

// A directed graph in CSR form: the edges leaving v go to
// targets[start[v]..start[v + 1]].
struct Graph { n: i64, start: Vec<i64>, targets: Vec<i32> }

impl Graph {
    // The graph of n nodes with these (from, to) edges: a counting sort
    // of the edges by their source.
    fn new(n: i64, edges: [(i32, i32)]) -> Graph {
        let mut start = Vec::filled(n + 1, 0);
        let s = start.as_slice();
        for (from, _) in edges { s[from + 1] += 1; }
        for v in 0..n { s[v + 1] += s[v]; }
        let mut targets = Vec::filled(edges.len, 0i32);
        let t = targets.as_slice();
        let mut fill = Vec::filled(n, 0);
        defer fill.free();
        let f = fill.as_slice();
        for (from, to) in edges {
            t[s[from] + f[from]] = to;
            f[from] += 1;
        }
        Graph { n: n, start: start, targets: targets }
    }

    // The nodes v points to.
    fn edges(self: *Graph, v: i64) -> [i32] {
        self.targets.as_slice()[self.start.get(v)..self.start.get(v + 1)]
    }

    fn free(self: *Graph) {
        self.start.free();
        self.targets.free();
    }
}

// ----------------------------------------------------------------- sort

// Kahn's algorithm: the nodes in a topological order, or Err with the
// number of nodes it could not place (they are on or behind a cycle).
fn kahn(g: *Graph) -> Result<Vec<i32>, i64> {
    let mut indegree = Vec::filled(g.n, 0i32);
    defer indegree.free();
    let deg = indegree.as_slice();
    for u in g.targets.as_slice() { deg[u] += 1; }

    // `order` is also the queue: the nodes before `head` are done, the
    // ones after it wait for their edges to be removed.
    let mut order: Vec<i32> = Vec::with_capacity(g.n);
    for v in 0..g.n {
        if deg[v] == 0 { order.push(v as i32); }
    }
    let mut head = 0;
    while head < order.len() {
        let v = order.get(head);
        head += 1;
        for u in g.edges(v) {
            deg[u] -= 1;
            if deg[u] == 0 { order.push(u); }
        }
    }
    if order.len() < g.n {
        let left = g.n - order.len();
        order.free();
        return Err(left);
    }
    Ok(order)
}

const WHITE: u8 = 0; // not reached yet
const GREY: u8 = 1; // on the current path of the search
const BLACK: u8 = 2; // finished: everything after it is explored

// A cycle of g, as its nodes in order (the last one points back to the
// first), or None if g has none. A depth-first search with its own stack
// (a recursive one would overflow on a path of a million nodes): an edge
// to a grey node closes a cycle, the part of the stack from that node on.
fn find_cycle(g: *Graph) -> Option<Vec<i32>> {
    let mut colour = Vec::filled(g.n, WHITE);
    defer colour.free();
    let col = colour.as_slice();
    let mut stack: Vec<(i32, i64)> = Vec::new(); // (node, its next edge)
    defer stack.free();
    let start = g.start.as_slice();
    let targets = g.targets.as_slice();
    for root in 0..g.n {
        if col[root] != WHITE { continue; }
        col[root] = GREY;
        stack.push((root as i32, start[root]));
        while let Some((v, k)) = stack.last() {
            if k == start[v + 1] { // every edge done: v is finished
                col[v] = BLACK;
                stack.pop();
                continue;
            }
            stack.set(stack.len() - 1, (v, k + 1));
            let u = targets[k];
            if col[u] == GREY {
                let from = stack.iter().position(|(w, _)| w == u)?; // grey: on the stack
                let cycle = stack.as_slice()[from..].iter().map(|(w, _)| w).collect();
                return Some(cycle);
            }
            if col[u] == WHITE {
                col[u] = GREY;
                stack.push((u, start[u]));
            }
        }
    }
    None
}

// The number of nodes on a longest path, and the path's first and last
// nodes, given a topological order: each node's depth is one more than
// the deepest node pointing to it.
fn longest_path(g: *Graph, order: [i32]) -> (i64, i32, i32) {
    let mut depth = Vec::filled(g.n, 1i32);
    defer depth.free();
    let mut from = (0..g.n).map(|v| v as i32).collect(); // where v's path starts
    defer from.free();
    let (d, f) = (depth.as_slice(), from.as_slice());
    let mut last = order[0];
    for v in order {
        for u in g.edges(v) {
            if d[v] + 1 > d[u] {
                d[u] = d[v] + 1;
                f[u] = f[v];
            }
        }
        if d[v] > d[last] { last = v; }
    }
    (d[last], f[last], last)
}

// ----------------------------------------------------------- build plan

enum PlanError { Syntax([u8]), Cycle(Vec<[u8]>) }

// A cycle of node numbers, before it gets its names back.
struct Cycle { nodes: Vec<i32> }

// Tasks and their dependencies, from lines "task: dep dep ...".
struct Plan { names: Vec<[u8]>, ids: HashMap<[u8], i64>, edges: Vec<(i32, i32)> }

impl Plan {
    fn parse(lines: [[u8]]) -> Result<Plan, PlanError> {
        let mut plan = Plan { names: Vec::new(), ids: HashMap::new(), edges: Vec::new() };
        for line in lines {
            let mut words = split_whitespace(line);
            defer words.free();
            let first = words.get(0);
            if words.len() == 0 || first[first.len - 1] != ':' {
                plan.free();
                return Err(PlanError::Syntax(line));
            }
            let task = plan.id(first[..first.len - 1]);
            for k in 1..words.len() {
                let dep = plan.id(words.get(k));
                plan.edges.push((dep as i32, task as i32)); // dep before task
            }
        }
        Ok(plan)
    }

    // The number of a task's name, a new one the first time it is seen.
    fn id(self: *Plan, name: [u8]) -> i64 {
        if let Some(i) = self.ids.get(name) { return i; }
        let i = self.names.len();
        self.names.push(name);
        self.ids.insert(name, i);
        i
    }

    // The tasks in an order that runs each after its dependencies.
    fn order(self: *Plan) -> Result<Vec<[u8]>, PlanError> {
        let mut g = Graph::new(self.names.len(), self.edges.as_slice());
        defer g.free();
        let mut order = sort(&g).map_err(|c| self.named(c))?;
        defer order.free();
        Ok(order.iter().map(|v| self.names.get(v)).collect())
    }

    fn named(self: *Plan, cycle: Cycle) -> PlanError {
        let mut c = cycle;
        defer c.nodes.free();
        PlanError::Cycle(c.nodes.iter().map(|v| self.names.get(v)).collect())
    }

    fn free(self: *Plan) {
        self.names.free();
        self.ids.free();
        self.edges.free();
    }
}

// A topological order of g, or a cycle that prevents one.
fn sort(g: *Graph) -> Result<Vec<i32>, Cycle> {
    match kahn(g) {
        Ok(order) => Ok(order),
        Err(_) => Err(Cycle { nodes: find_cycle(g).unwrap() }),
    }
}

// The order of the tasks in `lines`: `?` passes a syntax error or a
// cycle on to the caller.
fn plan_order(lines: [[u8]]) -> Result<Vec<[u8]>, PlanError> {
    let mut plan = Plan::parse(lines)?;
    defer plan.free();
    plan.order() // the names are views of `lines`, not of the plan
}

fn print_plan(lines: [[u8]]) {
    match plan_order(lines) {
        Ok(order) => {
            let mut o = order;
            defer o.free();
            print("order:");
            for name in o { print(f" {name}"); }
            println("");
        }
        Err(PlanError::Cycle(names)) => {
            // The cycle's edges go from a dependency to what needs it:
            // read backwards, each task needs the next.
            let mut c = names;
            defer c.free();
            print("cycle:");
            for k in 1..=c.len() { print(f" {c.get(c.len() - k)} needs"); }
            println(f" {c.get(c.len() - 1)}");
        }
        Err(PlanError::Syntax(line)) => println(f"not a dependency line: '{line}'"),
    }
}

// --------------------------------------------------------- random graph

// xorshift64*: a small, fast, seeded generator of 64-bit values.
struct Rng { state: u64 }

impl Rng {
    fn new(seed: u64) -> Rng { Rng { state: seed | 1 } }

    fn next(self: *Rng) -> u64 {
        let mut x = self.state;
        x ^= x >> 12;
        x ^= x << 25;
        x ^= x >> 27;
        self.state = x;
        x * 0x2545F4914F6CDD1D
    }

    // A value in 0..n.
    fn below(self: *Rng, n: i64) -> i64 { ((self.next() >> 33) % (n as u64)) as i64 }
}

// m random edges between n nodes, all going forward in a hidden random
// order of the nodes, so the graph is acyclic.
fn random_dag(n: i64, m: i64, seed: u64 = 99) -> Vec<(i32, i32)> {
    let mut rng = Rng::new(seed);
    let mut rank = (0..n).collect();
    defer rank.free();
    let r = rank.as_slice();
    for i in 1..n { // Fisher-Yates: a random permutation
        let j = rng.below(i + 1);
        let t = r[i];
        r[i] = r[j];
        r[j] = t;
    }
    let mut edges: Vec<(i32, i32)> = Vec::with_capacity(m + 1);
    while edges.len() < m {
        let (a, b) = (rng.below(n), rng.below(n));
        if a == b { continue; }
        if r[a] < r[b] { edges.push((a as i32, b as i32)); }
        else { edges.push((b as i32, a as i32)); }
    }
    edges
}

fn now_ns() -> i64 {
    let mut ts = c::timespec { tv_sec: 0, tv_nsec: 0 };
    unsafe { c::timespec_get(&ts, c::TIME_UTC); }
    ts.tv_sec * 1_000_000_000 + ts.tv_nsec
}

fn main() -> i32 {
    // A small build: each line is a task and what it needs first.
    let build = [
        "app: net ui",
        "net: io tls",
        "tls: crypto",
        "ui: gfx io",
        "gfx: math",
        "crypto: math",
        "tests: app",
    ];
    print_plan(build[..]);
    // One more dependency closes a loop.
    let broken = ["app: net ui", "net: io tls", "tls: crypto", "crypto: math", "math: app"];
    print_plan(broken[..]);
    print_plan(["app net"][..]);

    // A random DAG of a million nodes, sorted and checked.
    let n = 1_000_000;
    let mut edges = random_dag(n, 4_000_000);
    defer edges.free();
    let mut g = Graph::new(n, edges.as_slice());
    defer g.free();
    let t0 = now_ns();
    let mut order = kahn(&g).unwrap();
    let t1 = now_ns();
    defer order.free();
    let mut position = Vec::filled(n, 0);
    defer position.free();
    for (i, v) in order.iter().enumerate() { position.set(v, i); }
    let p = position.as_slice();
    let forward = edges.iter().all(|(a, b)| p[a] < p[b]);
    println(f"random DAG: {n} nodes, {edges.len()} edges");
    println(
        f"sorted: {order.len()} nodes, first {order.get(0)}, last {order.get(n - 1)}, every edge forward: {forward}");
    let (length, first, last) = longest_path(&g, order.as_slice());
    println(f"longest path: {length} nodes, from {first} to {last}");

    // An edge from the end of that path back to its start makes a cycle.
    edges.push((last, first));
    let mut cyclic = Graph::new(n, edges.as_slice());
    defer cyclic.free();
    let t2 = now_ns();
    let stuck = kahn(&cyclic).err().unwrap_or(0);
    let mut cycle = find_cycle(&cyclic).unwrap();
    let t3 = now_ns();
    defer cycle.free();
    let s = cycle.as_slice();
    let closed = (0..s.len).all(|i| cyclic.edges(s[i]).iter().any(|u| u == s[(i + 1) % s.len]));
    println(f"with the edge {last} -> {first}: kahn stuck with {stuck} nodes left");
    println(f"cycle found: {s.len} nodes, every step an edge: {closed}");
    eprintln(
        f"kahn on {n} nodes: {(t1 - t0) / 1_000_000} ms, kahn + cycle search: {(t3 - t2) / 1_000_000} ms");
    0
}
