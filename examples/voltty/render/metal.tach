// The renderer's GPU interface: the few Metal objects it draws with, a
// small stand-in for std::gpu (docs/design/gpu.md, 0.22; branch
// g22-metalb) until that lands. It has what the renderer and its tests
// use: a device and queue, shared buffers, 2D textures (upload,
// readback), a render pipeline from MSL source, one render pass, and a
// CAMetalLayer's drawables. On std::gpu these become `Device`, `Buffer`,
// `Texture`, `RenderPipeline` and `Surface`; renderer.tach changes its
// types, not its structure.
//
// Every object is retained by its handle and released by its drop.

use super::objc::{
    ClearColor, MtlRegion, Size, class, msg_d, msg_i, msg_p, msg_p_p, msg_p_pP, msg_p_ppP, msg_p_u,
    msg_p_uu, msg_p_uuub, msg_v, msg_v_b, msg_v_c, msg_v_mupu, msg_v_p, msg_v_pu, msg_v_pumu,
    msg_v_puu, msg_v_u, msg_v_uuuu, msg_v_z, nsstring, nsstring_bytes, pool_pop, pool_push, release,
    retain, sel,
};

extern "C" {
    fn MTLCreateSystemDefaultDevice() -> *u8;
}

// MTLPixelFormat values.
pub const R8_UNORM: u64 = 10;
pub const RGBA8_UNORM: u64 = 70;
pub const BGRA8_UNORM: u64 = 80;

// MTLTextureUsage bits.
pub const USAGE_SHADER_READ: u64 = 1;
pub const USAGE_RENDER_TARGET: u64 = 4;

// MTLStorageMode.
pub const STORAGE_SHARED: u64 = 0;
pub const STORAGE_PRIVATE: u64 = 2;

pub struct Device {
    pub dev: *u8,
    pub queue: *u8,
}

pub struct Buffer {
    pub obj: *u8,
    pub ptr: *u8,
    pub len: i64,
}

pub struct Texture {
    pub obj: *u8,
    pub w: i64,
    pub h: i64,
    pub format: u64,
}

pub struct Pipeline {
    pub obj: *u8,
}

// One render pass being encoded: its command buffer (retained, handed
// to the Submitted) and its encoder (retained until it ends).
pub struct Pass {
    pub cmd: *u8,
    pub enc: *u8,
}

// A committed command buffer.
pub struct Submitted {
    pub cmd: *u8,
}

impl Drop for Device {
    fn drop(self: &mut Device) {
        // SAFETY: both were created at +1 by `system` (or retained by clone).
        unsafe {
            release(self.queue);
            release(self.dev);
        }
    }
}

impl Clone for Device {
    fn clone(self: &Device) -> Device {
        // SAFETY: one more reference to each, released by its drop.
        unsafe { Device { dev: retain(self.dev), queue: retain(self.queue) } }
    }
}

impl Drop for Buffer {
    fn drop(self: &mut Buffer) {
        // SAFETY: created at +1 by Device::buffer.
        unsafe { release(self.obj); }
    }
}

impl Drop for Texture {
    fn drop(self: &mut Texture) {
        // SAFETY: created at +1 by Device::texture, or retained by Layer::next.
        unsafe { release(self.obj); }
    }
}

impl Drop for Pipeline {
    fn drop(self: &mut Pipeline) {
        // SAFETY: created at +1 by Device::pipeline.
        unsafe { release(self.obj); }
    }
}

impl Drop for Submitted {
    fn drop(self: &mut Submitted) {
        // SAFETY: the reference Device::begin retained.
        unsafe { release(self.cmd); }
    }
}

impl Device {
    // The system's default device, or None (no Metal: a VM without a GPU).
    pub fn system() -> Option<Device> {
        // SAFETY: MTLCreateSystemDefaultDevice returns +1 or nil;
        // newCommandQueue returns +1.
        unsafe {
            let d = MTLCreateSystemDefaultDevice();
            if d == 0 as *u8 {
                return None;
            }
            let q = msg_p(d, sel(c"newCommandQueue"));
            Some(Device { dev: d, queue: q })
        }
    }

    // The device's name, e.g. "Apple M5", into `out`.
    pub fn name(self: &Device, out: &mut Buf) {
        // SAFETY: -[MTLDevice name] returns an NSString (+0), its bytes
        // copied before the pool is popped.
        unsafe {
            let p = pool_push();
            out.push_str(nsstring_bytes(msg_p(self.dev, sel(c"name"))));
            pool_pop(p);
        }
    }

    // A shared buffer of `len` bytes (CPU and GPU see the same memory on
    // Apple silicon: writes through `ptr` need no upload).
    pub fn buffer(self: &Device, len: i64) -> Buffer {
        let n = if len < 16 { 16 } else { len };
        // SAFETY: newBufferWithLength:options: (NSUInteger, MTLResourceOptions)
        // returns +1; contents returns the shared storage, valid while
        // the buffer lives.
        unsafe {
            let b = msg_p_uu(self.dev, sel(c"newBufferWithLength:options:"), n as u64, 0);
            if b == 0 as *u8 {
                panic("metal: newBufferWithLength failed");
            }
            let p = msg_p(b, sel(c"contents"));
            Buffer { obj: b, ptr: p, len: n }
        }
    }

    // A 2D texture.
    pub fn texture(self: &Device, w: i64, h: i64, format: u64, usage: u64, storage: u64) -> Texture {
        // SAFETY: the descriptor is autoreleased (+0) inside our pool;
        // newTextureWithDescriptor: returns +1.
        unsafe {
            let pool = pool_push();
            let d = msg_p_uuub(class(c"MTLTextureDescriptor"),
                sel(c"texture2DDescriptorWithPixelFormat:width:height:mipmapped:"), format,
                w as u64, h as u64, false);
            msg_v_u(d, sel(c"setUsage:"), usage);
            msg_v_u(d, sel(c"setStorageMode:"), storage);
            let t = msg_p_p(self.dev, sel(c"newTextureWithDescriptor:"), d);
            pool_pop(pool);
            if t == 0 as *u8 {
                panic("metal: newTextureWithDescriptor failed");
            }
            Texture { obj: t, w: w, h: h, format: format }
        }
    }

    // A render pipeline from MSL source: vertex function `vs`, fragment
    // function `fs`, one colour attachment of `format`, no blending. The
    // error is the compiler's message, written into `err`.
    pub fn pipeline(self: &Device, msl: [u8], vs: [u8], fs: [u8], format: u64, err: &mut Buf)
        -> Option<Pipeline> {
        // SAFETY: newLibraryWithSource:options:error: and
        // newRenderPipelineStateWithDescriptor:error: return +1 or nil
        // with an autoreleased NSError in *error; everything else is +0
        // in our pool. The NSError's description is copied out before
        // the pool is popped.
        unsafe {
            let pool = pool_push();
            let mut e: *u8 = 0 as *u8;
            let lib = msg_p_ppP(self.dev, sel(c"newLibraryWithSource:options:error:"),
                nsstring(msl), 0 as *u8, &mut e as **u8);
            if lib == 0 as *u8 {
                err.push_str(nsstring_bytes(msg_p(e, sel(c"localizedDescription"))));
                pool_pop(pool);
                return None;
            }
            let fv = msg_p_p(lib, sel(c"newFunctionWithName:"), nsstring(vs));
            let ff = msg_p_p(lib, sel(c"newFunctionWithName:"), nsstring(fs));
            if fv == 0 as *u8 || ff == 0 as *u8 {
                err.push_str("metal: a shader function is missing");
                pool_pop(pool);
                return None;
            }
            let d = msg_p(msg_p(class(c"MTLRenderPipelineDescriptor"), sel(c"alloc")),
                sel(c"init"));
            msg_v_p(d, sel(c"setVertexFunction:"), fv);
            msg_v_p(d, sel(c"setFragmentFunction:"), ff);
            let att = msg_p_u(msg_p(d, sel(c"colorAttachments")), sel(c"objectAtIndexedSubscript:"),
                0);
            msg_v_u(att, sel(c"setPixelFormat:"), format);
            let p = msg_p_pP(self.dev, sel(c"newRenderPipelineStateWithDescriptor:error:"), d,
                &mut e as **u8);
            release(d);
            release(fv);
            release(ff);
            release(lib);
            if p == 0 as *u8 {
                err.push_str(nsstring_bytes(msg_p(e, sel(c"localizedDescription"))));
                pool_pop(pool);
                return None;
            }
            pool_pop(pool);
            Some(Pipeline { obj: p })
        }
    }

    // Starts a render pass on `target`, cleared to `clear` (or loaded
    // when `load`).
    pub fn begin(self: &Device, target: &Texture, clear: ClearColor, load: bool) -> Pass {
        // SAFETY: commandBuffer, renderPassDescriptor and
        // renderCommandEncoderWithDescriptor: are +0 in our pool; the
        // command buffer is retained for the Submitted, the encoder until
        // submit or present ends it.
        unsafe {
            let pool = pool_push();
            let cmd = retain(msg_p(self.queue, sel(c"commandBuffer")));
            let rp = msg_p(class(c"MTLRenderPassDescriptor"), sel(c"renderPassDescriptor"));
            let att = msg_p_u(msg_p(rp, sel(c"colorAttachments")),
                sel(c"objectAtIndexedSubscript:"), 0);
            msg_v_p(att, sel(c"setTexture:"), target.obj);
            // MTLLoadActionLoad 1, Clear 2; MTLStoreActionStore 1.
            msg_v_u(att, sel(c"setLoadAction:"), if load { 1 } else { 2 });
            msg_v_u(att, sel(c"setStoreAction:"), 1);
            msg_v_c(att, sel(c"setClearColor:"), clear);
            let enc = retain(msg_p_p(cmd, sel(c"renderCommandEncoderWithDescriptor:"), rp));
            pool_pop(pool);
            Pass { cmd: cmd, enc: enc }
        }
    }
}

impl Texture {
    // Writes `w`×`h` texels at (x, y) from `bytes` (rows of `row_bytes`).
    pub fn upload(self: &Texture, x: i64, y: i64, w: i64, h: i64, bytes: [u8], row_bytes: i64) {
        if w <= 0 || h <= 0 {
            return;
        }
        if bytes.len() < (h - 1) * row_bytes + w * texel_bytes(self.format) {
            panic("metal: upload: too few bytes");
        }
        let r = MtlRegion { x: x as u64, y: y as u64, z: 0, w: w as u64, h: h as u64, d: 1 };
        // SAFETY: replaceRegion:mipmapLevel:withBytes:bytesPerRow: reads
        // h rows of row_bytes from bytes.ptr; checked above to be inside
        // the slice. The texture is shared (CPU-writable).
        unsafe {
            msg_v_mupu(self.obj, sel(c"replaceRegion:mipmapLevel:withBytes:bytesPerRow:"), r, 0,
                bytes.ptr, row_bytes as u64);
        }
    }

    // Reads the whole texture into `out` (rows of w × texel bytes).
    pub fn read(self: &Texture, out: &mut Vec<u8>) {
        let row = self.w * texel_bytes(self.format);
        out.clear();
        for _ in 0..row * self.h {
            out.push(0);
        }
        let r = MtlRegion { x: 0, y: 0, z: 0, w: self.w as u64, h: self.h as u64, d: 1 };
        let s = out.as_mut_slice();
        // SAFETY: getBytes:bytesPerRow:fromRegion:mipmapLevel: writes h
        // rows of `row` bytes: exactly the slice's length.
        unsafe {
            msg_v_pumu(self.obj, sel(c"getBytes:bytesPerRow:fromRegion:mipmapLevel:"), s.ptr,
                row as u64, r, 0);
        }
    }
}

pub fn texel_bytes(format: u64) -> i64 {
    if format == R8_UNORM { 1 } else { 4 }
}

impl Pass {
    pub fn set_pipeline(self: &Pass, p: &Pipeline) {
        // SAFETY: setRenderPipelineState: takes an MTLRenderPipelineState.
        unsafe { msg_v_p(self.enc, sel(c"setRenderPipelineState:"), p.obj); }
    }

    pub fn vertex_buffer(self: &Pass, b: &Buffer, offset: i64, slot: i64) {
        // SAFETY: setVertexBuffer:offset:atIndex: (id, NSUInteger, NSUInteger).
        unsafe {
            msg_v_puu(self.enc, sel(c"setVertexBuffer:offset:atIndex:"), b.obj, offset as u64,
                slot as u64);
        }
    }

    // Small constant data copied into the command stream (at most 4 KiB).
    pub fn vertex_bytes(self: &Pass, data: [u8], slot: i64) {
        // SAFETY: setVertexBytes:length:atIndex: copies `len` bytes now.
        unsafe {
            msg_v_puu(self.enc, sel(c"setVertexBytes:length:atIndex:"), data.ptr, data.len() as u64,
                slot as u64);
        }
    }

    pub fn fragment_bytes(self: &Pass, data: [u8], slot: i64) {
        // SAFETY: as vertex_bytes.
        unsafe {
            msg_v_puu(self.enc, sel(c"setFragmentBytes:length:atIndex:"), data.ptr,
                data.len() as u64, slot as u64);
        }
    }

    pub fn fragment_texture(self: &Pass, t: &Texture, slot: i64) {
        // SAFETY: setFragmentTexture:atIndex: (id, NSUInteger).
        unsafe { msg_v_pu(self.enc, sel(c"setFragmentTexture:atIndex:"), t.obj, slot as u64); }
    }

    // `instances` instances of a 4-vertex triangle strip.
    pub fn draw_quads(self: &Pass, instances: i64) {
        if instances <= 0 {
            return;
        }
        // SAFETY: drawPrimitives:vertexStart:vertexCount:instanceCount:
        // (MTLPrimitiveType, NSUInteger×3); TriangleStrip is 4.
        unsafe {
            msg_v_uuuu(self.enc, sel(c"drawPrimitives:vertexStart:vertexCount:instanceCount:"), 4,
                0, 4, instances as u64);
        }
    }

    // Ends the encoder and commits.
    pub fn submit(self: Pass) -> Submitted {
        // SAFETY: endEncoding and commit on the command buffer this pass
        // retained; the Submitted keeps that reference.
        unsafe {
            msg_v(self.enc, sel(c"endEncoding"));
            release(self.enc);
            msg_v(self.cmd, sel(c"commit"));
        }
        Submitted { cmd: self.cmd }
    }

    // Ends the encoder, schedules `d`'s presentation and commits.
    pub fn present(self: Pass, d: &Drawable) -> Submitted {
        // SAFETY: as submit; presentDrawable: takes the drawable this
        // pass rendered into.
        unsafe {
            msg_v(self.enc, sel(c"endEncoding"));
            release(self.enc);
            msg_v_p(self.cmd, sel(c"presentDrawable:"), d.obj);
            msg_v(self.cmd, sel(c"commit"));
        }
        Submitted { cmd: self.cmd }
    }
}

impl Submitted {
    pub fn wait(self: &Submitted) {
        // SAFETY: waitUntilCompleted on a committed command buffer (the
        // main thread blocks; no completion handler runs elsewhere).
        unsafe { msg_v(self.cmd, sel(c"waitUntilCompleted")); }
    }

    // MTLCommandBufferStatusCompleted (4) or Error (5).
    pub fn done(self: &Submitted) -> bool {
        // SAFETY: status returns an NSUInteger enum.
        unsafe { msg_i(self.cmd, sel(c"status")) >= 4 }
    }

    // The GPU time of the command buffer in seconds (after completion).
    pub fn gpu_seconds(self: &Submitted) -> f64 {
        // SAFETY: GPUStartTime and GPUEndTime return CFTimeInterval (f64).
        unsafe { msg_d(self.cmd, sel(c"GPUEndTime")) - msg_d(self.cmd, sel(c"GPUStartTime")) }
    }
}

// A CAMetalLayer as a presentation surface: the window's raw surface,
// owned by the window.
pub struct Layer {
    pub obj: *u8,
}

impl Layer {
    // Points the layer at `dev`, BGRA8, framebuffer-only, two drawables,
    // display sync on (the lowest latency without tearing: terminal.md §3.5).
    pub fn configure(self: &Layer, dev: &Device, w: i64, h: i64) {
        // SAFETY: CAMetalLayer's documented setters, with their types.
        unsafe {
            msg_v_p(self.obj, sel(c"setDevice:"), dev.dev);
            msg_v_u(self.obj, sel(c"setPixelFormat:"), BGRA8_UNORM);
            msg_v_b(self.obj, sel(c"setFramebufferOnly:"), true);
            msg_v_u(self.obj, sel(c"setMaximumDrawableCount:"), 2);
            msg_v_b(self.obj, sel(c"setDisplaySyncEnabled:"), true);
            msg_v_z(self.obj, sel(c"setDrawableSize:"), Size { w: w as f64, h: h as f64 });
        }
    }

    pub fn resize(self: &Layer, w: i64, h: i64) {
        // SAFETY: setDrawableSize: takes a CGSize (an HFA of two doubles).
        unsafe { msg_v_z(self.obj, sel(c"setDrawableSize:"), Size { w: w as f64, h: h as f64 }); }
    }

    // The next drawable, or None when the layer has none to give (not on
    // screen, or all in flight for 1 s).
    pub fn next(self: &Layer) -> Option<Drawable> {
        // SAFETY: nextDrawable returns +0 (retained here, released by the
        // Drawable's drop), and so does its texture (retained by the
        // Texture).
        unsafe {
            let p = pool_push();
            let d = msg_p(self.obj, sel(c"nextDrawable"));
            if d == 0 as *u8 {
                pool_pop(p);
                return None;
            }
            let d2 = retain(d);
            let t = retain(msg_p(d2, sel(c"texture")));
            let w = msg_i(t, sel(c"width"));
            let h = msg_i(t, sel(c"height"));
            pool_pop(p);
            Some(Drawable { obj: d2, tex: Texture { obj: t, w: w, h: h, format: BGRA8_UNORM } })
        }
    }
}

// A layer's drawable and its texture.
pub struct Drawable {
    pub obj: *u8,
    pub tex: Texture,
}

impl Drop for Drawable {
    fn drop(self: &mut Drawable) {
        // SAFETY: releases the reference `Layer::next` retained (the
        // texture's own is released by its drop).
        unsafe { release(self.obj); }
    }
}

// Whether the process has Metal at all (cheap; for tests to skip).
pub fn available() -> bool {
    Device::system().is_some()
}
