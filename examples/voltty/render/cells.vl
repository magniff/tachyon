            let top = min(ul - t + tri * 2 * t / h, ch - t);\n\
            on = y >= top && y < top + t;\n\
        } else if s == 4u {\n\
            on = y >= ul && y < ul + t && (x / t) % 2 == 0;\n\
        } else if s == 5u {\n\
            on = y >= ul && y < ul + t && x % (6 * t) < 4 * t;\n\
        }\n\
        if (fl & 8u) != 0u {\n\
            let sp = i32(u.strike_pos);\n\
            on = on || (y >= sp && y < sp + t);\n\
