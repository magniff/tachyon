// The renderer's input: the grid's cell array (terminal.md §6.3, "E2 and
// E5 meet at the damage interface"). The renderer never reads the grid's
// internals; it asks a `CellGrid` for its size, each visible line's
// cells and damage, and how far the whole screen scrolled.
//
// `Cell` and its constants mirror examples/voltty/term/cell.tach (task E2,
// branch voltty-core) bit for bit: 16 bytes, colours as a tag and a value,
// Alacritty's flags. When the two trees meet (E7) this file keeps only
// the trait and re-exports term::cell's items instead of defining them.

pub struct Cell {
    pub ch: u32,
    pub fg: u32,
    pub bg: u32,
    pub flags: u16,
    pub extra: u16,
}

pub const COLOR_NAMED: u32 = 0;
pub const COLOR_INDEXED: u32 = 0x1000000;
pub const COLOR_RGB: u32 = 0x2000000;
pub const TAG_MASK: u32 = 0x3000000;
pub const VALUE_MASK: u32 = 0xFFFFFF;
pub const CHAR_MASK: u32 = 0x1FFFFF;

// Alacritty's NamedColor numbers past the 16 ANSI colours.
pub const DEFAULT_FG: u32 = 256;
pub const DEFAULT_BG: u32 = 257;
pub const CURSOR_COLOR: u32 = 258;
pub const DIM_BLACK: u32 = 259;
pub const BRIGHT_FG: u32 = 267;
pub const DIM_FG: u32 = 268;

pub const INVERSE: u16 = 0x1;
pub const BOLD: u16 = 0x2;
pub const ITALIC: u16 = 0x4;
pub const UNDERLINE: u16 = 0x8;
pub const WRAPLINE: u16 = 0x10;
pub const WIDE_CHAR: u16 = 0x20;
pub const WIDE_CHAR_SPACER: u16 = 0x40;
pub const DIM: u16 = 0x80;
pub const HIDDEN: u16 = 0x100;
pub const STRIKEOUT: u16 = 0x200;
pub const LEADING_WIDE_CHAR_SPACER: u16 = 0x400;
pub const DOUBLE_UNDERLINE: u16 = 0x800;
pub const UNDERCURL: u16 = 0x1000;
pub const DOTTED_UNDERLINE: u16 = 0x2000;
pub const DASHED_UNDERLINE: u16 = 0x4000;

pub fn named(n: u32) -> u32 {
    COLOR_NAMED | n
}

pub fn indexed(i: u32) -> u32 {
    COLOR_INDEXED | i
}

pub fn rgb(r: u32, g: u32, b: u32) -> u32 {
    COLOR_RGB | (r << 16) | (g << 8) | b
}

pub fn cell(c: u32, fg: u32, bg: u32, flags: u16) -> Cell {
    Cell { ch: c, fg: fg, bg: bg, flags: flags, extra: 0 }
}

// What the renderer reads from the terminal. Lines are the visible ones,
// 0 at the top (the grid applies its display offset into scrollback).
pub trait CellGrid {
    fn lines(self: &Self) -> i64;
    fn cols(self: &Self) -> i64;
    // The cells of visible line `l` (`cols` of them).
    fn row(self: &Self, l: i64) -> [Cell];
    // Whether line `l` changed since the last `reset_damage`, other than
    // by moving with a whole-screen scroll.
    fn damaged(self: &Self, l: i64) -> bool;
    // Everything changed (a resize, a clear, the alternate screen): the
    // renderer rebuilds every line and ignores `scrolled`.
    fn damage_all(self: &Self) -> bool;
    // How many lines the whole screen moved up since the last
    // `reset_damage` (the grid's ring moving its base): the renderer
    // moves its own ring of instance rows as far and rebuilds only the
    // damaged lines, which include the ones that scrolled in. 0 when the
    // grid does not count scrolls (it then damages the moved lines).
    fn scrolled(self: &Self) -> i64;
    fn reset_damage(self: &mut Self);
}

// The cursor as the renderer draws it (the terminal's DECSCUSR shape and
// DECTCEM visibility, the window's focus for the hollow block).
pub const CURSOR_HIDDEN: i64 = 0;
pub const CURSOR_BLOCK: i64 = 1;
pub const CURSOR_BEAM: i64 = 2;
pub const CURSOR_UNDERLINE: i64 = 3;
pub const CURSOR_HOLLOW: i64 = 4;

pub struct CursorView {
    pub line: i64,
    pub col: i64,
    pub shape: i64,
}
