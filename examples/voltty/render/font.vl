// Fonts through Core Text (terminal.md §3.5): the regular face and its
// bold, italic and bold-italic copies, the cell metrics, glyph lookup
// with the system's fallback, and rasterization of one glyph into a
// cell-sized bitmap (coverage, or premultiplied RGBA for colour glyphs).
//
// This is the macOS variant: font.macos.vl once OS-specific module
// files exist (0.22's C1); font.linux.vl (FreeType + fontconfig) is the
// other. The C functions are declared by hand until framework headers
// can be imported (C4); every prototype is copied from the SDK's
// CoreText, CoreGraphics and CoreFoundation headers.
//
// A glyph is drawn with its pen at the cell's left edge and baseline,
// into a bitmap exactly the size of the cell (two cells for a wide
// character): what falls outside is clipped, as the renderer clips every
// glyph to its cell (one draw, no overlap: §3.5). The atlas keeps only
// the bitmap's inked box.

use super::objc::{Point, Rect};

// CFRange: a location and a length (CFIndex).
#[repr(C)]
struct CfRange {
    loc: i64,
    len: i64,
}

// (0.25) Core Text, and Core Graphics and Core Foundation under it.
#[link(framework = "CoreText", framework = "CoreGraphics", framework = "CoreFoundation")]
extern "C" {
    fn CFStringCreateWithBytes(alloc: *u8, bytes: *u8, len: i64, encoding: u32, external: bool) -> *u8;
    fn CFRelease(o: *u8);
    fn CTFontCreateWithName(name: *u8, size: f64, matrix: *u8) -> *u8;
    fn CTFontCreateCopyWithSymbolicTraits(font: *u8, size: f64, matrix: *u8, value: u32, mask: u32) -> *u8;
    fn CTFontCreateForString(font: *u8, s: *u8, range: CfRange) -> *u8;
    fn CTFontCopyPostScriptName(font: *u8) -> *u8;
    fn CTFontGetSymbolicTraits(font: *u8) -> u32;
    fn CTFontGetAscent(font: *u8) -> f64;
    fn CTFontGetDescent(font: *u8) -> f64;
    fn CTFontGetLeading(font: *u8) -> f64;
    fn CTFontGetUnderlinePosition(font: *u8) -> f64;
    fn CTFontGetUnderlineThickness(font: *u8) -> f64;
    fn CTFontGetGlyphsForCharacters(font: *u8, chars: *u16, glyphs: *u16, count: i64) -> bool;

    fn CTFontGetAdvancesForGlyphs(font: *u8, orientation: u32, glyphs: *u16, advances: *u8,
        count: i64) -> f64;

    fn CTFontDrawGlyphs(font: *u8, glyphs: *u16, positions: *Point, count: u64, ctx: *u8);
    fn CFStringGetCString(s: *u8, buf: *u8, size: i64, encoding: u32) -> bool;
    fn CGColorSpaceCreateDeviceGray() -> *u8;
    fn CGColorSpaceCreateDeviceRGB() -> *u8;
    fn CGColorSpaceRelease(space: *u8);

    fn CGBitmapContextCreate(data: *u8, w: u64, h: u64, bits: u64, row_bytes: u64, space: *u8,
        info: u32) -> *u8;

    fn CGContextRelease(ctx: *u8);
    fn CGContextSetGrayFillColor(ctx: *u8, gray: f64, alpha: f64);
    fn CGContextSetShouldAntialias(ctx: *u8, on: bool);
    fn CGContextSetAllowsFontSmoothing(ctx: *u8, on: bool);
    fn CGContextSetShouldSmoothFonts(ctx: *u8, on: bool);
    fn CGContextSetAllowsFontSubpixelQuantization(ctx: *u8, on: bool);
    fn CGContextSetShouldSubpixelQuantizeFonts(ctx: *u8, on: bool);
}

const UTF8: u32 = 0x08000100;
const TRAIT_ITALIC: u32 = 1;
const TRAIT_BOLD: u32 = 2;
const TRAIT_COLOR: u32 = 1 << 13;
// kCGImageAlphaNone (grey) and kCGImageAlphaPremultipliedLast (RGBA, in
// memory R, G, B, A).
const ALPHA_NONE: u32 = 0;
const ALPHA_PREMUL_LAST: u32 = 1;

// The four styles; a cell's bold and italic flags select one.
pub const REGULAR: i64 = 0;
pub const BOLD: i64 = 1;
pub const ITALIC: i64 = 2;
pub const BOLD_ITALIC: i64 = 3;

// A cell's metrics in pixels.
pub struct Metrics {
    pub cw: i64, // cell width
    pub ch: i64, // cell height
    pub base: i64, // from the cell's top to the baseline
    pub ul_pos: i64, // from the cell's top to the underline's top
    pub ul_thick: i64, // underline (and strike, beam cursor) thickness
    pub strike_pos: i64, // from the cell's top to the strike's top
}

// A rasterized glyph: its inked box inside the cell box (cw × ch, or
// 2cw × ch for wide), and its pixels (1 byte of coverage, or 4 of
// premultiplied RGBA when `color`), rows of `w`. An empty glyph (a
// space) has w == 0.
pub struct Glyph {
    pub x: i64,
    pub y: i64,
    pub w: i64,
    pub h: i64,
    pub color: bool,
}

pub struct Font {
    faces: [*u8; 4],
    pub size_px: f64,
    pub m: Metrics,
    // Scratch bitmaps of 2 cells × 1 cell, reused for every glyph.
    grey: Vec<u8>,
    rgba: Vec<u8>,
    grey_ctx: *u8,
    rgba_ctx: *u8,
    gpa: Gpa,
    // Statistics, for the tests and the bench.
    pub fallbacks: i64,
    pub rasterized: i64,
}

fn round(x: f64) -> i64 {
    if x >= 0.0 { (x + 0.5) as i64 } else { -((-x + 0.5) as i64) }
}

// A CFString (+1) of `s`; the caller releases it.
unsafe fn cfstring(s: [u8]) -> *u8 {
    CFStringCreateWithBytes(0 as *u8, s.ptr, s.len, UTF8, false)
}

// UTF-16 units of a code point, and how many (1 or 2).
fn utf16(c: u32) -> ([u16; 2], i64) {
    if c < 0x10000 {
        return ([c as u16, 0], 1);
    }
    let v = c - 0x10000;
    ([(0xD800 + (v >> 10)) as u16, (0xDC00 + (v & 0x3FF)) as u16], 2)
}

// UTF-8 bytes of a code point, and how many.
pub fn utf8(c: u32) -> ([u8; 4], i64) {
    if c < 0x80 {
        return ([c as u8, 0, 0, 0], 1);
    }
    if c < 0x800 {
        return ([(0xC0 | (c >> 6)) as u8, (0x80 | (c & 0x3F)) as u8, 0, 0], 2);
    }
    if c < 0x10000 {
        return ([(0xE0 | (c >> 12)) as u8, (0x80 | ((c >> 6) & 0x3F)) as u8,
            (0x80 | (c & 0x3F)) as u8, 0], 3);
    }
    ([(0xF0 | (c >> 18)) as u8, (0x80 | ((c >> 12) & 0x3F)) as u8, (0x80 | ((c >> 6) & 0x3F)) as u8,
        (0x80 | (c & 0x3F)) as u8], 4)
}

impl Font {
    // `name` at `points` × `scale` pixels (Menlo 14 at 2× is 28 px).
    // None when Core Text has no such font.
    pub fn new_in(name: [u8], points: f64, scale: f64, gpa: Gpa) -> Option<Font> {
        let size = points * scale;
        // SAFETY: Core Text and Core Graphics calls with the SDK's
        // prototypes; every object created here (+1) is kept in the Font
        // and released by the drop. The scratch bitmaps are Vecs that are
        // never resized after their contexts are made over them, so the
        // contexts' data pointers stay valid until the drop.
        unsafe {
            let cname = cfstring(name);
            let reg = CTFontCreateWithName(cname, size, 0 as *u8);
            CFRelease(cname);
            if reg == 0 as *u8 {
                return None;
            }
            var faces: [*u8; 4] = [reg, reg, reg, reg];
            let b = CTFontCreateCopyWithSymbolicTraits(reg, 0.0, 0 as *u8, TRAIT_BOLD, TRAIT_BOLD);
            let i = CTFontCreateCopyWithSymbolicTraits(reg, 0.0, 0 as *u8, TRAIT_ITALIC,
                TRAIT_ITALIC);
            let bi = CTFontCreateCopyWithSymbolicTraits(reg, 0.0, 0 as *u8,
                TRAIT_BOLD | TRAIT_ITALIC, TRAIT_BOLD | TRAIT_ITALIC);
            // A face the family lacks falls back to the regular one
            // (retained again, so the drop releases each slot once).
            faces[1] = if b != 0 as *u8 { b } else { super::objc::retain(reg) };
            faces[2] = if i != 0 as *u8 { i } else { super::objc::retain(reg) };
            faces[3] = if bi != 0 as *u8 { bi } else { super::objc::retain(reg) };

            let ascent = CTFontGetAscent(reg);
            let descent = CTFontGetDescent(reg);
            let leading = CTFontGetLeading(reg);
            var ch16: [u16; 2] = [48, 0];
            var g: [u16; 2] = [0, 0];
            CTFontGetGlyphsForCharacters(reg, &ch16 as *u16, &g as *u16, 1);
            var adv: [f64; 2] = [0.0, 0.0];
            CTFontGetAdvancesForGlyphs(reg, 0, &g as *u16, &adv as *u8, 1);
            let cw = round(adv[0]);
            let ch = round(ascent + descent + leading);
            let base = ch - round(descent);
            var thick = round(CTFontGetUnderlineThickness(reg));
            if thick < 1 {
                thick = 1;
            }
            // Core Text's underline position is below the baseline,
            // negative; the line's centre is there.
            var ul = base - round(CTFontGetUnderlinePosition(reg)) - thick / 2;
            if ul + thick > ch {
                ul = ch - thick;
            }
            // The strike goes through the middle of the x-height, about
            // a third of the ascent above the baseline.
            let strike = base - round(ascent / 3.0) - thick / 2;
            let m = Metrics {
                cw: cw, ch: ch, base: base, ul_pos: ul, ul_thick: thick, strike_pos: strike,
            };

            var grey: Vec<u8> = Vec::filled_in(2 * cw * ch, 0, gpa);
            var rgba: Vec<u8> = Vec::filled_in(2 * cw * ch * 4, 0, gpa);
            let gs = CGColorSpaceCreateDeviceGray();
            let rs = CGColorSpaceCreateDeviceRGB();
            let gs_slice = grey.as_slice();
            let rs_slice = rgba.as_slice();
            let gctx = CGBitmapContextCreate(gs_slice.ptr, (2 * cw) as u64, ch as u64, 8,
                (2 * cw) as u64, gs, ALPHA_NONE);
            let rctx = CGBitmapContextCreate(rs_slice.ptr, (2 * cw) as u64, ch as u64, 8,
                (8 * cw) as u64, rs, ALPHA_PREMUL_LAST);
            CGColorSpaceRelease(gs);
            CGColorSpaceRelease(rs);
            // Antialiased coverage; no font smoothing (it thickens glyphs
            // differently against each background) and no subpixel
            // quantization: the pen is always on a whole pixel.
            CGContextSetGrayFillColor(gctx, 1.0, 1.0);
            CGContextSetShouldAntialias(gctx, true);
            CGContextSetAllowsFontSmoothing(gctx, false);
            CGContextSetShouldSmoothFonts(gctx, false);
            CGContextSetAllowsFontSubpixelQuantization(gctx, false);
            CGContextSetShouldSubpixelQuantizeFonts(gctx, false);
            CGContextSetShouldAntialias(rctx, true);
            CGContextSetAllowsFontSmoothing(rctx, false);
            Some(Font {
                faces: faces,
                size_px: size,
                m: m,
                grey: grey,
                rgba: rgba,
                grey_ctx: gctx,
                rgba_ctx: rctx,
                gpa: gpa,
                fallbacks: 0,
                rasterized: 0,
            })
        }
    }

    // Rasterizes `c` in `style` over `cells` cells (1, or 2 for a wide
    // character). The pixels are in `pixels()` until the next call.
    pub fn raster(inout self, c: u32, style: i64, cells: i64) -> Glyph {
        self.rasterized += 1;
        let cw = self.m.cw;
        let ch = self.m.ch;
        let (units, n) = utf16(c);
        var glyphs: [u16; 2] = [0, 0];
        let face = self.faces[style & 3];
        // SAFETY: Core Text and Core Graphics calls with the SDK's
        // prototypes, over arrays of the lengths they are told; the
        // fallback font (+1) is released before returning. The contexts
        // draw into the scratch Vecs, whose memory is live (see new_in).
        unsafe {
            var font = face;
            var owned = 0 as *u8;
            if !CTFontGetGlyphsForCharacters(face, &units as *u16, &glyphs as *u16, n)
                || glyphs[0] == 0 {
                let (u8s, len) = utf8(c);
                let s = cfstring(u8s[0..len]);
                let f = CTFontCreateForString(face, s, CfRange { loc: 0, len: n });
                CFRelease(s);
                if f != 0 as *u8 {
                    self.fallbacks += 1;
                    owned = f;
                    font = f;
                    glyphs[0] = 0;
                    glyphs[1] = 0;
                    CTFontGetGlyphsForCharacters(f, &units as *u16, &glyphs as *u16, n);
                }
            }
            if glyphs[0] == 0 {
                if owned != 0 as *u8 {
                    CFRelease(owned);
                }
                return Glyph { x: 0, y: 0, w: 0, h: 0, color: false };
            }
            let color = (CTFontGetSymbolicTraits(font) & TRAIT_COLOR) != 0;
            // The pen: the cell's left edge, on the baseline (Core
            // Graphics counts y from the bitmap's bottom).
            let pen = Point { x: 0.0, y: (ch - self.m.base) as f64 };
            let width = cw * cells;
            let g = if color {
                for i in 0..self.rgba.len() {
                    self.rgba[i] = 0;
                }
                CTFontDrawGlyphs(font, &glyphs as *u16, &pen, 1, self.rgba_ctx);
                ink_box(self.rgba.as_slice(), 2 * cw, 4, width, ch, true)
            } else {
                for i in 0..self.grey.len() {
                    self.grey[i] = 0;
                }
                CTFontDrawGlyphs(font, &glyphs as *u16, &pen, 1, self.grey_ctx);
                ink_box(self.grey.as_slice(), 2 * cw, 1, width, ch, false)
            };
            if owned != 0 as *u8 {
                CFRelease(owned);
            }
            g
        }
    }

    // The scratch bitmap of the last raster: rows of 2·cw texels.
    pub fn pixels(self, color: bool) -> [u8] {
        if color { self.rgba.as_slice() } else { self.grey.as_slice() }
    }

    pub fn row_bytes(self, color: bool) -> i64 {
        if color { 8 * self.m.cw } else { 2 * self.m.cw }
    }

    // The PostScript name of the font Core Text uses for `c` (the face,
    // or its fallback), into `out`; for tests.
    pub fn face_for(self, c: u32, out: inout Buf) {
        let (units, n) = utf16(c);
        var glyphs: [u16; 2] = [0, 0];
        // SAFETY: as in raster; the names (+1) are released.
        unsafe {
            let face = self.faces[0];
            var f = face;
            var owned = 0 as *u8;
            if !CTFontGetGlyphsForCharacters(face, &units as *u16, &glyphs as *u16, n)
                || glyphs[0] == 0 {
                let (u8s, len) = utf8(c);
                let s = cfstring(u8s[0..len]);
                owned = CTFontCreateForString(face, s, CfRange { loc: 0, len: n });
                CFRelease(s);
                f = owned;
            }
            if f == 0 as *u8 {
                return;
            }
            let name = CTFontCopyPostScriptName(f);
            var buf: [u8; 128] = [0; 128];
            if CFStringGetCString(name, &buf as *u8, 128, UTF8) {
                var i = 0;
                while i < 128 && buf[i] != 0 {
                    out.push(buf[i]);
                    i += 1;
                }
            }
            CFRelease(name);
            if owned != 0 as *u8 {
                CFRelease(owned);
            }
        }
    }
}

impl Drop for Font {
    fn drop(inout self) {
        // SAFETY: each face slot holds one +1 reference (see new_in); the
        // contexts are released here, before the drop of the bitmaps under
        // them.
        unsafe {
            for i in 0..4 {
                CFRelease(self.faces[i]);
            }
            CGContextRelease(self.grey_ctx);
            CGContextRelease(self.rgba_ctx);
        }
    }
}

// The inked box of the first `w` × `h` texels of a bitmap with rows of
// `stride` texels of `bpp` bytes (for RGBA, the alpha byte decides).
fn ink_box(px: [u8], stride: i64, bpp: i64, w: i64, h: i64, color: bool) -> Glyph {
    var x0 = w;
    var x1 = -1;
    var y0 = h;
    var y1 = -1;
    let a = if bpp == 4 { 3 } else { 0 };
    for y in 0..h {
        let row = y * stride * bpp;
        for x in 0..w {
            if px[row + x * bpp + a] != 0 {
                if x < x0 {
                    x0 = x;
                }
                if x > x1 {
                    x1 = x;
                }
                if y < y0 {
                    y0 = y;
                }
                y1 = y;
            }
        }
    }
    if x1 < 0 {
        return Glyph { x: 0, y: 0, w: 0, h: 0, color: color };
    }
    Glyph { x: x0, y: y0, w: x1 - x0 + 1, h: y1 - y0 + 1, color: color }
}
