// CSI and DCS parameters: up to 32 values, each a group of a value and
// its colon sub-parameters (`38:2::255:0:0`), in fixed arrays, as vte's
// `Params`. A group is found from its first index: `group_len(i)`
// values start there, and the next group starts after them.

pub const MAX_PARAMS: i64 = 32;

pub struct Params {
    // At a group's first index: the number of values in the group.
    subparams: [u8; 32],
    values: [u16; 32],
    // Sub-parameters of the group being collected.
    current_subparams: u8,
    pub len: i64,
}

impl Params {
    pub fn new() -> Params {
        Params { subparams: [0; 32], values: [0; 32], current_subparams: 0, len: 0 }
    }

    #[inline]

    pub fn is_full(self) -> bool {
        self.len == MAX_PARAMS
    }

    pub fn clear(inout self) {
        self.current_subparams = 0;
        self.len = 0;
    }

    // Ends the current group with `value`.
    #[inline]
    pub fn push(inout self, value: u16) {
        self.subparams[self.len - self.current_subparams as i64] = self.current_subparams + 1;
        self.values[self.len] = value;
        self.current_subparams = 0;
        self.len += 1;
    }

    // Adds `value` to the current group; a sub-parameter follows.
    #[inline]
    pub fn extend(inout self, value: u16) {
        self.subparams[self.len - self.current_subparams as i64] = self.current_subparams + 1;
        self.values[self.len] = value;
        self.current_subparams += 1;
        self.len += 1;
    }

    // The number of values in the group starting at `i`.
    #[inline]
    pub fn group_len(self, i: i64) -> i64 {
        self.subparams[i] as i64
    }

    #[inline]

    pub fn value(self, i: i64) -> u16 {
        self.values[i]
    }

    // The values of the group starting at `i`, a view of them.
    pub fn group(self, i: i64) -> [u16] {
        self.values[i..i + self.subparams[i] as i64]
    }

    pub fn groups(self) -> i64 {
        var n = 0;
        var i = 0;
        while i < self.len {
            i += self.subparams[i] as i64;
            n += 1;
        }
        n
    }
}

// Walks the groups: `next()` is the next group's first index, or -1.
pub struct ParamIter {
    pub at: i64,
}

impl ParamIter {
    pub fn new() -> ParamIter {
        ParamIter { at: 0 }
    }

    #[inline]

    pub fn next(inout self, p: Params) -> i64 {
        if self.at >= p.len {
            return -1;
        }
        let i = self.at;
        self.at += p.group_len(i);
        i
    }

    // vte's `next_param_or`: the next group's first value, or `default`
    // when there is none or it is 0.
    #[inline]
    pub fn next_or(inout self, p: Params, default: u16) -> u16 {
        let i = self.next(p);
        if i < 0 {
            return default;
        }
        let v = p.value(i);
        if v == 0 { default } else { v }
    }
}
