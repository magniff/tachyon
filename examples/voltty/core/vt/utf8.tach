// UTF-8 as Rust's `str::from_utf8` reads it, which is what vte's ground
// state does: a sequence is valid by the table of Unicode 3.9 (no
// overlongs, no surrogates, nothing above U+10FFFF), and an invalid one
// is replaced by one U+FFFD per maximal valid prefix (its "error
// length"), the byte that broke it read again.

pub const REPLACEMENT: u32 = 0xFFFD;

// The length of the sequence a lead byte starts: 2, 3 or 4; 0 when the
// byte cannot start one (a continuation byte, 0xC0, 0xC1, 0xF5 and up).
pub fn seq_len(lead: u8) -> i64 {
    if lead < 0xC2 {
        0
    } else if lead < 0xE0 {
        2
    } else if lead < 0xF0 {
        3
    } else if lead < 0xF5 {
        4
    } else {
        0
    }
}

// Whether `b` may be byte `k` (1, 2 or 3) of the sequence led by `lead`.
pub fn continues(lead: u8, k: i64, b: u8) -> bool {
    if k == 1 {
        if lead == 0xE0 {
            return b >= 0xA0 && b <= 0xBF;
        }
        if lead == 0xED {
            return b >= 0x80 && b <= 0x9F;
        }
        if lead == 0xF0 {
            return b >= 0x90 && b <= 0xBF;
        }
        if lead == 0xF4 {
            return b >= 0x80 && b <= 0x8F;
        }
    }
    b >= 0x80 && b <= 0xBF
}

// The code point of a complete, valid sequence of `n` bytes.
pub fn decode(s: [u8], n: i64) -> u32 {
    if n == 2 {
        ((s[0] as u32 & 0x1F) << 6) | (s[1] as u32 & 0x3F)
    } else if n == 3 {
        ((s[0] as u32 & 0x0F) << 12) | ((s[1] as u32 & 0x3F) << 6) | (s[2] as u32 & 0x3F)
    } else {
        ((s[0] as u32 & 0x07) << 18) | ((s[1] as u32 & 0x3F) << 12) | ((s[2] as u32 & 0x3F) << 6)
            | (s[3] as u32 & 0x3F)
    }
}

// Rust's `str::from_utf8(s)`: the length of the valid prefix; `err` set
// to the error's length (1..3), to 0 when all of `s` is valid, to -1 when
// it ends inside a sequence.
pub fn validate(s: [u8], err: &mut i64) -> i64 {
    let mut i = 0;
    while i < s.len {
        let b = s[i];
        if b < 0x80 {
            i += 1;
            continue;
        }
        let n = seq_len(b);
        if n == 0 {
            *err = 1;
            return i;
        }
        let mut k = 1;
        while k < n {
            if i + k == s.len {
                *err = -1;
                return i;
            }
            if !continues(b, k, s[i + k]) {
                *err = k;
                return i;
            }
            k += 1;
        }
        i += n;
    }
    *err = 0;
    i
}

// The length of the sequence starting `s` (valid), 1 for ASCII.
pub fn char_len(lead: u8) -> i64 {
    if lead < 0x80 { 1 } else { seq_len(lead) }
}

// Appends the UTF-8 of `c` to `out` at `at`; returns the new end.
pub fn encode(c: u32, out: &mut [u8], at: i64) -> i64 {
    if c < 0x80 {
        out[at] = c as u8;
        at + 1
    } else if c < 0x800 {
        out[at] = (0xC0 | (c >> 6)) as u8;
        out[at + 1] = (0x80 | (c & 0x3F)) as u8;
        at + 2
    } else if c < 0x10000 {
        out[at] = (0xE0 | (c >> 12)) as u8;
        out[at + 1] = (0x80 | ((c >> 6) & 0x3F)) as u8;
        out[at + 2] = (0x80 | (c & 0x3F)) as u8;
        at + 3
    } else {
        out[at] = (0xF0 | (c >> 18)) as u8;
        out[at + 1] = (0x80 | ((c >> 12) & 0x3F)) as u8;
        out[at + 2] = (0x80 | ((c >> 6) & 0x3F)) as u8;
        out[at + 3] = (0x80 | (c & 0x3F)) as u8;
        at + 4
    }
}
