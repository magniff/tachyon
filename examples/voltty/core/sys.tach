// Files and the clock for the headless modes, over std::sys.

use std::Buf;
use std::sys::{
    SYS_CLOCK_REALTIME, SYS_O_RDONLY, sys_clock_gettime, sys_close, sys_open, sys_read, sys_write,
};

// Nanoseconds of the wall clock.
pub fn now_ns() -> i64 {
    let (s, ns) = sys_clock_gettime(SYS_CLOCK_REALTIME);
    s * 1000000000 + ns
}

// The whole of a file, or None.
pub fn read_file(path: [u8], gpa: Gpa) -> Option<Buf> {
    let fd = match sys_open(path, SYS_O_RDONLY, 0) {
        Ok(fd) => fd,
        Err(_) => return None,
    };
    let mut out = Buf::new_in(gpa);
    let mut chunk: Vec<u8> = Vec::filled_in(65536, 0, gpa);
    loop {
        match sys_read(fd, chunk.as_mut_slice()) {
            Ok(n) => {
                if n <= 0 {
                    break;
                }
                out.push_str(chunk.as_slice()[0..n]);
            }
            Err(_) => break,
        }
    }
    let _ = sys_close(fd);
    Some(out)
}

// All of `bytes` to file descriptor `fd`.
pub fn write_all(fd: i32, bytes: [u8]) {
    let mut at = 0;
    while at < bytes.len {
        match sys_write(fd, bytes[at..]) {
            Ok(n) => {
                if n <= 0 {
                    return;
                }
                at += n;
            }
            Err(_) => return,
        }
    }
}
