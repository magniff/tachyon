// The little of the C library the headless terminal needs: files, the
// clock, the OS. Declared by hand, the same on macOS and Linux.
//
// 0.20: std's fs and time replace this module.

use std::Buf;

extern "C" {
    fn open(path: *u8, flags: i32, ...) -> i32;
    fn read(fd: i32, buf: *u8, count: u64) -> i64;
    fn write(fd: i32, buf: *u8, count: u64) -> i64;
    fn close(fd: i32) -> i32;
    fn clock_gettime(clock: i32, ts: *Timespec) -> i32;
    fn uname(name: *u8) -> i32;
}

#[repr(C)]
pub struct Timespec {
    pub sec: i64,
    pub nsec: i64,
}

// Nanoseconds of the wall clock (CLOCK_REALTIME, 0 on both systems).
pub fn now_ns() -> i64 {
    let mut ts = Timespec { sec: 0, nsec: 0 };
    // SAFETY: a valid pointer to a timespec, which the call fills.
    unsafe {
        clock_gettime(0, &ts);
    }
    ts.sec * 1000000000 + ts.nsec
}

// The whole of a file, or None.
pub fn read_file(path: [u8], gpa: Gpa) -> Option<Buf> {
    let mut name = Buf::new_in(gpa);
    name.push_str(path);
    name.push(0);
    // SAFETY: a NUL-terminated path.
    let fd = unsafe { open(name.as_slice().ptr, 0) };
    name.free();
    if fd < 0 {
        return None;
    }
    let mut out = Buf::new_in(gpa);
    let mut chunk: [u8; 65536] = [0; 65536];
    loop {
        // SAFETY: the buffer and its length.
        let n = unsafe { read(fd, &chunk[0], 65536) };
        if n <= 0 {
            break;
        }
        out.push_str(chunk[0..n]);
    }
    // SAFETY: the descriptor opened above.
    unsafe {
        close(fd);
    }
    Some(out)
}

// All of `bytes` to file descriptor `fd`.
pub fn write_all(fd: i32, bytes: &mut [u8]) {
    let mut at = 0;
    while at < bytes.len {
        // SAFETY: the rest of the slice and its length.
        let n = unsafe { write(fd, &bytes[at], (bytes.len - at) as u64) };
        if n <= 0 {
            return;
        }
        at += n;
    }
}

pub fn on_macos() -> bool {
    // struct utsname starts with the system's name on both systems.
    let mut names: [u8; 1280] = [0; 1280];
    // SAFETY: utsname is 390 bytes on Linux, 1280 on macOS.
    if unsafe { uname(&names[0]) != 0 } {
        return false;
    }
    names[0..6] == "Darwin"
}
