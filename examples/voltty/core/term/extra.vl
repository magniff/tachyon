// What a 16-byte cell has no room for: its combining characters, its
// underline colour, its hyperlink (Alacritty's `CellExtra`). Cells refer
// to an entry by index; 0 is none. Entries made for the cursor's template
// are shared by every cell written with it; an entry made for combining
// characters belongs to one cell (cells are moved, never duplicated), so
// it may be changed in place.
//
// Entries are reclaimed by a mark and sweep over the cells of both
// screens when the table would grow past twice what survived the last
// one; hyperlinks (their id and URI) with them.

use std::Buf;

pub struct Extra {
    // The combining characters, in order.
    pub zw: Vec<u32>,
    // The underline colour, or NO_COLOR (grid.vl).
    pub ul: u32,
    // A links index, or 0.
    pub link: i64,
    // The entry belongs to one cell.
    pub owned: bool,
    pub live: bool,
}

pub struct Link {
    pub id: Buf,
    // The id was made up (Alacritty: "N_alacritty"); the dump prints `*`.
    pub auto_id: bool,
    pub uri: Buf,
    pub live: bool,
}

pub struct Extras {
    pub entries: Vec<Extra>,
    pub free: Vec<i64>,
    pub links: Vec<Link>,
    pub free_links: Vec<i64>,
    // Entries in use after the last collection (at least 1024).
    pub threshold: i64,
    pub gpa: Gpa,
}

// The largest index a cell can hold: 27 bits.
pub const MAX_EXTRAS: i64 = 0x7FFFFFF;

impl Extras {
    pub fn new_in(gpa: Gpa) -> Extras {
        var x = Extras {
            entries: Vec::new_in(gpa),
            free: Vec::new_in(gpa),
            links: Vec::new_in(gpa),
            free_links: Vec::new_in(gpa),
            threshold: 1024,
            gpa: gpa,
        };
        // Index 0: none.
        x.entries.push(Extra {
            zw: Vec::new_in(gpa), ul: 0xFFFFFFFF, link: 0, owned: false, live: true,
        });
        x.links.push(Link {
            id: Buf::new_in(gpa), auto_id: false, uri: Buf::new_in(gpa), live: true,
        });
        x
    }

    pub fn free(inout self) {
        for i in 0..self.entries.len() {
            self.entries[i].zw.free();
        }
        for i in 0..self.links.len() {
            self.links[i].id.free();
            self.links[i].uri.free();
        }
        self.entries.free();
        self.free.free();
        self.links.free();
        self.free_links.free();
    }

    // Whether a collection is due before the next entry is made.
    #[inline]
    pub fn wants_collect(self) -> bool {
        self.free.len() == 0 && self.entries.len() >= self.threshold
    }

    // A new entry (no combining characters).
    pub fn make(inout self, ul: u32, link: i64, owned: bool) -> i64 {
        if self.free.len() > 0 {
            let i = self.free.pop().unwrap();
            self.entries[i].zw.clear();
            self.entries[i].ul = ul;
            self.entries[i].link = link;
            self.entries[i].owned = owned;
            self.entries[i].live = true;
            return i;
        }
        if self.entries.len() > MAX_EXTRAS {
            // No room left: the cell gets none (never reached in practice:
            // 134 million entries).
            return 0;
        }
        self.entries.push(Extra {
            zw: Vec::new_in(self.gpa), ul: ul, link: link, owned: owned, live: true,
        });
        self.entries.len() - 1
    }

    // A cell's entry, before its combining characters change: an owned
    // copy of `id` (a new one if `id` is shared or 0).
    pub fn own(inout self, id: i64) -> i64 {
        if id != 0 && self.entries[id].owned {
            return id;
        }
        var ul: u32 = 0xFFFFFFFF;
        var link = 0;
        if id != 0 {
            ul = self.entries[id].ul;
            link = self.entries[id].link;
        }
        let n = self.make(ul, link, true);
        if id != 0 && n != 0 {
            // (by index: a view of entries[id] would be held across the
            // push into entries[n], one Vec)
            let count = self.entries[id].zw.len();
            for k in 0..count {
                let z = self.entries[id].zw[k];
                self.entries[n].zw.push(z);
            }
        }
        n
    }

    pub fn push_zw(inout self, id: i64, c: u32) {
        if id != 0 {
            self.entries[id].zw.push(c);
        }
    }

    pub fn zw(self, id: i64) -> [u32] {
        self.entries[id].zw.as_slice()
    }

    #[inline]

    pub fn has_zw(self, id: i64) -> bool {
        id != 0 && self.entries[id].zw.len() > 0
    }

    pub fn ul(self, id: i64) -> u32 {
        self.entries[id].ul
    }

    pub fn link(self, id: i64) -> i64 {
        self.entries[id].link
    }

    pub fn make_link(inout self, id: [u8], auto_id: bool, uri: [u8]) -> i64 {
        var i = 0;
        if self.free_links.len() > 0 {
            i = self.free_links.pop().unwrap();
            self.links[i].id.clear();
            self.links[i].uri.clear();
            self.links[i].live = true;
            self.links[i].auto_id = auto_id;
        } else {
            self.links.push(Link {
                id: Buf::new_in(self.gpa), auto_id: auto_id, uri: Buf::new_in(self.gpa), live: true,
            });
            i = self.links.len() - 1;
        }
        self.links[i].id.push_str(id);
        self.links[i].uri.push_str(uri);
        i
    }

    // The collection: everything unmarked, then `mark` (called by the
    // terminal for every index in use), then `sweep`.
    pub fn unmark(inout self) {
        for i in 1..self.entries.len() {
            self.entries[i].live = false;
        }
        for i in 1..self.links.len() {
            self.links[i].live = false;
        }
    }

    pub fn mark(inout self, id: i64) {
        if id > 0 && id < self.entries.len() {
            self.entries[id].live = true;
        }
    }

    pub fn mark_link(inout self, link: i64) {
        if link > 0 && link < self.links.len() {
            self.links[link].live = true;
        }
    }

    pub fn sweep(inout self) {
        // A live entry keeps its link.
        for i in 1..self.entries.len() {
            if self.entries[i].live {
                let l = self.entries[i].link;
                self.mark_link(l);
            }
        }
        self.free.clear();
        var used = 0;
        for i in 1..self.entries.len() {
            if self.entries[i].live {
                used += 1;
            } else {
                self.entries[i].zw.clear();
                self.free.push(i);
            }
        }
        self.free_links.clear();
        for i in 1..self.links.len() {
            if !self.links[i].live {
                self.free_links.push(i);
            }
        }
        // At least 64K: a collection scans every cell of both screens.
        self.threshold = used * 2;
        if self.threshold < 65536 {
            self.threshold = 65536;
        }
    }
}
