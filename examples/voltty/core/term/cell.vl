// A cell: 16 bytes (Alacritty's is 24).
//
//   ch     the character in its low 21 bits; the high 11 bits extend
//          `extra` (an extra's index is `(ch >> 21) << 16 | extra`)
//   fg, bg a colour: a tag in bits 24..25 and a value below
//   flags  Alacritty's cell flags, bit for bit (the dump prints them)
//   extra  with `ch`'s high bits, an index into the terminal's side
//          table of combining characters, underline colour and
//          hyperlink (extra.vl); 0 for none
//
// 0.18: `requires` on the coordinate functions of grid.vl.

pub struct Cell {
    pub ch: u32,
    pub fg: u32,
    pub bg: u32,
    pub flags: u16,
    pub extra: u16,
}

// Colours. Named: Alacritty's `NamedColor` numbers (0..15, then 256
// foreground, 257 background, 258 cursor, ...); indexed: 0..255 from
// `38;5;n`; RGB: 24 bits.
pub const COLOR_NAMED: u32 = 0;
pub const COLOR_INDEXED: u32 = 0x1000000;
pub const COLOR_RGB: u32 = 0x2000000;
pub const TAG_MASK: u32 = 0x3000000;
pub const VALUE_MASK: u32 = 0xFFFFFF;

pub const DEFAULT_FG: u32 = 256;
pub const DEFAULT_BG: u32 = 257;

#[inline]

pub fn named(n: u32) -> u32 {
    COLOR_NAMED | n
}

#[inline]

pub fn indexed(i: u32) -> u32 {
    COLOR_INDEXED | i
}

#[inline]

pub fn rgb(r: u32, g: u32, b: u32) -> u32 {
    COLOR_RGB | (r << 16) | (g << 8) | b
}

// Flags, as Alacritty's.
pub const INVERSE: u16 = 0x1;
pub const BOLD: u16 = 0x2;
pub const ITALIC: u16 = 0x4;
pub const UNDERLINE: u16 = 0x8;
pub const WRAPLINE: u16 = 0x10;
pub const WIDE_CHAR: u16 = 0x20;
pub const WIDE_CHAR_SPACER: u16 = 0x40;
pub const DIM: u16 = 0x80;
pub const HIDDEN: u16 = 0x100;
pub const STRIKEOUT: u16 = 0x200;
pub const LEADING_WIDE_CHAR_SPACER: u16 = 0x400;
pub const DOUBLE_UNDERLINE: u16 = 0x800;
pub const UNDERCURL: u16 = 0x1000;
pub const DOTTED_UNDERLINE: u16 = 0x2000;
pub const DASHED_UNDERLINE: u16 = 0x4000;
pub const ALL_UNDERLINES: u16 = 0x8 | 0x800 | 0x1000 | 0x2000 | 0x4000;

pub const CHAR_MASK: u32 = 0x1FFFFF;

impl Cell {
    // A blank cell with the background `bg` (Alacritty's `bg.into()`).
    #[inline]
    pub fn blank(bg: u32) -> Cell {
        Cell { ch: 32, fg: DEFAULT_FG, bg: bg, flags: 0, extra: 0 }
    }

    #[inline]

    pub fn c(self) -> u32 {
        self.ch & CHAR_MASK
    }

    #[inline]

    pub fn extra_id(self) -> i64 {
        ((self.ch >> 21) as i64 << 16) | self.extra as i64
    }

    #[inline]

    pub fn set_char(inout self, c: u32) {
        self.ch = (self.ch & ~CHAR_MASK) | c;
    }

    #[inline]

    pub fn set_extra(inout self, id: i64) {
        self.ch = (self.ch & CHAR_MASK) | ((id >> 16) as u32 << 21);
        self.extra = (id & 0xFFFF) as u16;
    }
}

// A cell from its parts.
#[inline]
pub fn make(c: u32, fg: u32, bg: u32, flags: u16, extra: i64) -> Cell {
    Cell {
        ch: c | ((extra >> 16) as u32 << 21), fg: fg, bg: bg, flags: flags,
        extra: (extra & 0xFFFF) as u16,
    }
}
