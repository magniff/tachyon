// Prints the number of command-line arguments, then each of them. `main`
// may take C's argc and argv; each argument is a NUL-terminated C string,
// turned here into a [u8] slice of its bytes.
import "string.h" as c;

// The bytes of the C string at `s`, without its NUL. It is an `unsafe fn`:
// nothing checks that `s` points at a NUL-terminated string, the caller
// promises it.
unsafe fn c_bytes(s: *u8) -> [u8] {
    s[0..c::strlen(s) as i64]
}

fn main(argc: i64, argv: **u8) -> i32 {
    println(f"argc: {argc}");
    for i in 0..argc {
        let arg = unsafe { c_bytes(argv[i]) };
        println(f"-- {arg}");
    }
    0
}
