// examples/args with std::cli: the words on the command line, printed one
// a line, now with a flag and two options. std::cli parses them (`-v`,
// `-vv`, `-n 2`, `-n2`, `--prefix=>`, `--` before a word that starts with
// `-`) and gives `--help`, `--version` and the errors for bad arguments,
// with their exit codes; no argv, no unsafe.
use std::env;
use std::cli::{Arg, Command};

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("cli", gpa).version("0.25").about("prints its words, one a line")
        .arg(Arg::flag("verbose").short('v').help("also print the options (-vv: the count too)"))
        .arg(Arg::option("prefix").short('p').value_name("TEXT").default("--")
            .help("printed before each word"))
        .arg(Arg::option("times").short('n').value_name("N").default("1")
            .help("print the words N times"))
        .arg(Arg::positional("word").required().multiple().help("the words"));
    // An error, --help or --version: printed, and the program ends (exit
    // status 2 for an error, 0 for the others).
    let m = cmd.parse_or_exit(env::args());
    // A value is text; get_as parses it, and its error names the option.
    let times = match m.get_as::<i64>("times") {
        Ok(n) => n,
        Err(e) => cmd.exit(e),
    };
    let prefix = m.get("prefix").unwrap_or("--");
    let words = m.values("word");
    if m.count("verbose") >= 1 {
        println(f"prefix: {prefix}, times: {times}");
    }
    if m.count("verbose") >= 2 {
        println(f"words: {words.len()}");
    }
    for _ in 0..times {
        for w in words {
            println(f"{prefix} {w}");
        }
    }
    0
}
