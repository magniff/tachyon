// A calculator: reads lines of arithmetic from stdin and prints their
// values. A tokenizer and a recursive-descent parser over a slice of
// tokens, with enums, match, methods and slices.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn getchar() -> i32;
}

enum Token { Num(i64), Plus, Minus, Star, Slash, Percent, Open, Close, End }

enum Error { None, BadChar(u8), Unexpected(Token), DivideByZero }

// `bad`: a character that starts no token (0: none).
struct Lexer { text: [u8], at: u64, bad: u8 }

impl Lexer {
    fn next(self: *Lexer) -> Token {
        while self.at < self.text.len && self.text[self.at] == ' ' {
            self.at += 1;
        }
        if self.at == self.text.len {
            return Token::End;
        }
        let c = self.text[self.at];
        self.at += 1;
        match c {
            '0'..='9' => {
                let mut value = (c - '0') as i64;
                while self.at < self.text.len && self.text[self.at] >= '0' && self.text[self.at] <= '9' {
                    value = value * 10 + (self.text[self.at] - '0') as i64;
                    self.at += 1;
                }
                Token::Num(value)
            }
            '+' => Token::Plus,
            '-' => Token::Minus,
            '*' => Token::Star,
            '/' => Token::Slash,
            '%' => Token::Percent,
            '(' => Token::Open,
            ')' => Token::Close,
            _ => {
                self.bad = c;
                Token::End
            }
        }
    }
}

struct Parser { tokens: [Token], at: u64, error: Error }

impl Parser {
    fn peek(self: *Parser) -> Token {
        self.tokens[self.at]
    }

    fn fail(self: *Parser, e: Error) -> i64 {
        match self.error {
            Error::None => self.error = e,
            _ => {}
        }
        0
    }

    // sum: term (('+' | '-') term)*
    fn sum(self: *Parser) -> i64 {
        let mut value = self.term();
        loop {
            match self.peek() {
                Token::Plus => {
                    self.at += 1;
                    value += self.term();
                }
                Token::Minus => {
                    self.at += 1;
                    value -= self.term();
                }
                _ => return value,
            }
        }
    }

    // term: unary (('*' | '/' | '%') unary)*
    fn term(self: *Parser) -> i64 {
        let mut value = self.unary();
        loop {
            let op = self.peek();
            match op {
                Token::Star | Token::Slash | Token::Percent => {
                    self.at += 1;
                    let rhs = self.unary();
                    value = match op {
                        Token::Star => value * rhs,
                        _ if rhs == 0 => self.fail(Error::DivideByZero),
                        Token::Slash => value / rhs,
                        _ => value % rhs,
                    };
                }
                _ => return value,
            }
        }
    }

    // unary: '-' unary | number | '(' sum ')'
    fn unary(self: *Parser) -> i64 {
        let t = self.peek();
        self.at += 1;
        match t {
            Token::Minus => 0 - self.unary(),
            Token::Num(n) => n,
            Token::Open => {
                let value = self.sum();
                match self.peek() {
                    Token::Close => {
                        self.at += 1;
                        value
                    }
                    other => self.fail(Error::Unexpected(other)),
                }
            }
            other => {
                self.at -= 1;
                self.fail(Error::Unexpected(other))
            }
        }
    }
}

fn token_name(t: Token) -> *u8 {
    match t {
        Token::Num(_) => c"a number",
        Token::Plus => c"'+'",
        Token::Minus => c"'-'",
        Token::Star => c"'*'",
        Token::Slash => c"'/'",
        Token::Percent => c"'%'",
        Token::Open => c"'('",
        Token::Close => c"')'",
        Token::End => c"the end",
    }
}

fn evaluate(line: [u8]) {
    let mut tokens: [Token; 256] = [Token::End; 256];
    let mut lexer = Lexer { text: line, at: 0, bad: 0 };
    let mut count: u64 = 0;
    loop {
        let t = lexer.next();
        tokens[count] = t;
        count += 1;
        match t {
            Token::End => break,
            _ => if count == 255 { break; },
        }
    }
    let mut parser = Parser { tokens: tokens[..count], at: 0, error: Error::None };
    if lexer.bad != 0 {
        parser.error = Error::BadChar(lexer.bad);
    }
    let value = parser.sum();
    match parser.peek() {
        Token::End => {}
        other => {
            parser.fail(Error::Unexpected(other));
        }
    }
    match parser.error {
        Error::None => printf(c"%ld\n", value),
        Error::DivideByZero => printf(c"error: division by zero\n"),
        Error::Unexpected(t) => printf(c"error: unexpected %s\n", token_name(t)),
        Error::BadChar(c) => printf(c"error: unexpected character '%c'\n", c as i32),
    };
}

fn main() -> i32 {
    let mut line: [u8; 1024] = [0; 1024];
    let mut n: u64 = 0;
    loop {
        let c = getchar();
        if c < 0 || c == '\n' as i32 {
            if n > 0 {
                evaluate(line[..n]);
            }
            n = 0;
            if c < 0 {
                return 0;
            }
        } else if n < 1024 {
            line[n] = c as u8;
            n += 1;
        }
    }
}
