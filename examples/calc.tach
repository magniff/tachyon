// A calculator: reads lines of arithmetic from stdin and prints their
// values. A tokenizer and a recursive-descent parser over a slice of
// tokens, with enums, match, methods, slices and std's Vec and Buf.
extern "C" {
    fn getchar() -> i32;
}

use std::Buf;

enum Token { Num(i64), Plus, Minus, Star, Slash, Percent, Open, Close, End }
use Token::{Num, Plus, Minus, Star, Slash, Percent, Open, Close, End};

enum Error { BadChar(u8), Unexpected(Token), DivideByZero }
use Error::{BadChar, Unexpected, DivideByZero};

// `bad`: the character that stopped the tokenizer, if one did.
struct Lexer { text: [u8], at: i64, bad: Option<u8> }

impl Lexer {
    fn next(self: *Lexer) -> Token {
        while self.at < self.text.len && self.text[self.at] == ' ' {
            self.at += 1;
        }
        if self.at == self.text.len {
            return End;
        }
        let c = self.text[self.at];
        self.at += 1;
        match c {
            '0'..='9' => {
                let mut value = (c - '0') as i64;
                while self.at < self.text.len {
                    let d = self.text[self.at];
                    if d < '0' || d > '9' {
                        break;
                    }
                    value = value * 10 + (d - '0') as i64;
                    self.at += 1;
                }
                Num(value)
            }
            '+' => Plus,
            '-' => Minus,
            '*' => Star,
            '/' => Slash,
            '%' => Percent,
            '(' => Open,
            ')' => Close,
            _ => {
                self.bad = Some(c);
                End
            }
        }
    }
}

// `error`: the first error met; a failed expression's value is 0.
struct Parser { tokens: [Token], at: i64, error: Option<Error> }

impl Parser {
    fn peek(self: *Parser) -> Token {
        self.tokens[self.at]
    }

    fn fail(self: *Parser, e: Error) -> i64 {
        if self.error.is_none() {
            self.error = Some(e);
        }
        0
    }

    // sum: term (('+' | '-') term)*
    fn sum(self: *Parser) -> i64 {
        let mut value = self.term();
        loop {
            match self.peek() {
                Plus => {
                    self.at += 1;
                    value += self.term();
                }
                Minus => {
                    self.at += 1;
                    value -= self.term();
                }
                _ => return value,
            }
        }
    }

    // term: unary (('*' | '/' | '%') unary)*
    fn term(self: *Parser) -> i64 {
        let mut value = self.unary();
        loop {
            let op = self.peek();
            match op {
                Star | Slash | Percent => {
                    self.at += 1;
                    let rhs = self.unary();
                    value = match op {
                        Star => value * rhs,
                        _ if rhs == 0 => self.fail(DivideByZero),
                        Slash => value / rhs,
                        _ => value % rhs,
                    };
                }
                _ => return value,
            }
        }
    }

    // unary: '-' unary | number | '(' sum ')'
    fn unary(self: *Parser) -> i64 {
        let t = self.peek();
        self.at += 1;
        match t {
            Minus => -self.unary(),
            Num(n) => n,
            Open => {
                let value = self.sum();
                match self.peek() {
                    Close => {
                        self.at += 1;
                        value
                    }
                    other => self.fail(Unexpected(other)),
                }
            }
            other => {
                self.at -= 1;
                self.fail(Unexpected(other))
            }
        }
    }
}

fn token_name(t: Token) -> [u8] {
    match t {
        Num(_) => "a number",
        Plus => "'+'",
        Minus => "'-'",
        Star => "'*'",
        Slash => "'/'",
        Percent => "'%'",
        Open => "'('",
        Close => "')'",
        End => "the end",
    }
}

fn evaluate(line: [u8]) {
    let mut tokens: Vec<Token> = Vec::new();
    defer tokens.free();
    let mut lexer = Lexer { text: line, at: 0, bad: None };
    loop {
        let t = lexer.next();
        tokens.push(t);
        if t == End {
            break;
        }
    }

    let mut parser = Parser { tokens: tokens.as_slice(), at: 0, error: None };
    if let Some(c) = lexer.bad {
        parser.error = Some(BadChar(c));
    }
    let value = parser.sum();
    let rest = parser.peek();
    if rest != End {
        parser.fail(Unexpected(rest));
    }

    let mut out = Buf::new();
    defer out.free();
    match parser.error {
        None => out.push_int(value),
        Some(DivideByZero) => out.push_str("error: division by zero"),
        Some(Unexpected(t)) => {
            out.push_str("error: unexpected ");
            out.push_str(token_name(t));
        }
        Some(BadChar(c)) => {
            out.push_str("error: unexpected character '");
            out.push(c);
            out.push('\'');
        }
    }
    println(out.as_slice());
}

fn main() -> i32 {
    let mut line = Buf::new();
    defer line.free();
    loop {
        let c = getchar();
        if c < 0 || c == '\n' as i32 {
            if line.len() > 0 {
                evaluate(line.as_slice());
            }
            line.clear();
            if c < 0 {
                return 0;
            }
        } else {
            line.push(c as u8);
        }
    }
}
