// Factorials of 1 to 10, recursively, each line built in a std Buf.
use std::Buf;

fn factorial(n: i64) -> i64 {
    if n == 0 { 1 } else { n * factorial(n - 1) }
}

fn main(gpa: Gpa) -> i32 {
    let mut line = Buf::new_in(gpa);
    defer line.free();
    for n in 1..=10 {
        line.clear();
        line.push_str("Factorial of ");
        line.push_int(n);
        line.push_str(" == ");
        line.push_int(factorial(n));
        println(line.as_slice());
    }
    0
}
