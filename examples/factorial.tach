extern "C" {
    fn puts(s: *u8) -> i32;
    fn printf(s: *u8, ...) -> i32;
}


fn factorial(value: usize) -> usize {
    if (value == 0) {
        return 1;
    }
    value * factorial(value - 1)
}

fn main() -> i64 {
    let mut current_value = 1 as usize;
    while current_value <= 10 {
        printf(
            c"Factorial of %d == %d\n",
            current_value,
            factorial(current_value)
        );
        current_value += 1;
    }
    0
}