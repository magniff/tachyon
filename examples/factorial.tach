extern fn puts(s: *u8) -> i32;
extern fn printf(s: *u8, a: usize, b: usize) -> i32;


fn factorial(value: usize) -> usize {
    if (value == 0) {
        return 1;
    };
    value * factorial(value - 1)
}

fn main() -> i64 {
    let current_value = 1 as usize;
    loop {
        if (current_value > (10 as usize)) {
            break;
        };
        printf(
            "Factorial of %d == %d\n".0,
            current_value,
            factorial(current_value)
        );
        current_value += 1;
    }
    0
}