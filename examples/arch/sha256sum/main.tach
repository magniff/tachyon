// sha256sum: SHA-256 checksums of files, coreutils-compatible. The
// hashing is sha256.tach (the ARMv8 SHA-256 instructions behind
// detect("sha2"), with a portable fallback); this file is the command:
// its options, the reading (1 MiB at a time, into one buffer allocated
// once), the output and `-c`'s checking.

mod sha256;

// The C library, declared by hand (no headers: the program also compiles
// for x86-64 on a machine without its C headers). The constants are the
// same on Linux and macOS.
mod libc {
    pub extern "C" {
        fn open(path: *u8, flags: i32) -> i32;
        fn read(fd: i32, buf: *u8, n: u64) -> i64;
        fn write(fd: i32, buf: *u8, n: u64) -> i64;
        fn close(fd: i32) -> i32;
        fn strerror(e: i32) -> *u8;
        fn strlen(s: *u8) -> u64;
        // errno.c
        fn sha256sum_errno() -> i32;
    }

    pub const O_RDONLY: i32 = 0;
    pub const ENOENT: i32 = 2;
    pub const EINTR: i32 = 4;
}

use crate::sha256::{H0, blocks, finish};

// The read buffer: 1 MiB, allocated once and reused by every file.
const BUF: i64 = 1 << 20;

fn usage(out: &mut Buf) {
    out.push_str("Usage: sha256sum [OPTION]... [FILE]...\n");
    out.push_str("Print or check SHA256 (256-bit) checksums.\n");
    out.push_str("\n");
    out.push_str("With no FILE, or when FILE is -, read standard input.\n");
    out.push_str("  -b, --binary          read in binary mode (marks the name with '*')\n");
    out.push_str("  -c, --check           read checksums from the FILEs and check them\n");
    out.push_str("      --tag             create a BSD-style checksum\n");
    out.push_str("  -t, --text            read in text mode (default)\n");
    out.push_str("\n");
    out.push_str("The following five options are useful only when verifying checksums:\n");
    out.push_str("      --ignore-missing  don't fail or report status for missing files\n");
    out.push_str("      --quiet           don't print OK for each successfully verified file\n");
    out.push_str("      --status          don't output anything, status code shows success\n");
    out.push_str("      --strict          exit non-zero for improperly formatted checksum lines\n");
    out.push_str("  -w, --warn            warn about improperly formatted checksum lines\n");
    out.push_str("\n");
    out.push_str("      --help            display this help and exit\n");
    out.push_str("      --version         output version information and exit\n");
}

struct Opts {
    check: bool,
    tag: bool,
    binary: bool,
    quiet: bool,
    status: bool,
    strict: bool,
    warn: bool,
    ignore_missing: bool,
}

// ---- output ---------------------------------------------------------

// Writes all of s to fd.
fn write_all(fd: i32, s: [u8]) {
    let mut i = 0;
    while i < s.len {
        let n = unsafe { libc::write(fd, &s[i], (s.len - i) as u64) };
        if n <= 0 {
            return;
        }
        i += n as i64;
    }
}

// Stdout is buffered in out, written when it passes 64 KiB, at an
// error (so the two streams keep their order) and at the end.
fn flush(out: &mut Buf) {
    write_all(1, out.as_slice());
    out.clear();
}

fn errno() -> i32 {
    unsafe { libc::sha256sum_errno() }
}

// `sha256sum: NAME: MESSAGE` on stderr, coreutils' form: the name
// quoted as a shell would need it, the line number after it (if > 0).
fn report(out: &mut Buf, name: [u8], line: i64, message: [u8]) {
    flush(out);
    write_all(2, "sha256sum: ");
    if name.len > 0 {
        write_quoted(name);
        if line > 0 {
            out.push_str(": ");
            out.push_int(line);
            write_all(2, out.as_slice());
            out.clear();
        }
        write_all(2, ": ");
    }
    write_all(2, message);
    write_all(2, "\n");
}

// A name on stderr as coreutils quotes it: bare if every byte is plain,
// else in single quotes ('\'' for one inside), or in double quotes when
// it has a single quote and nothing a shell expands there.
fn write_quoted(name: [u8]) {
    let mut plain = true;
    let mut single = false;
    let mut double_ok = true;
    for b in name {
        let ok = (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9')
            || b == '%' || b == '+' || b == ',' || b == '-' || b == '.' || b == '/' || b == ':'
            || b == '=' || b == '@' || b == '_' || b == '^';
        if !ok {
            plain = false;
        }
        if b == '\'' {
            single = true;
        }
        if b == '"' || b == '$' || b == '`' || b == '\\' || b == '!' {
            double_ok = false;
        }
    }
    if plain {
        write_all(2, name);
    } else if single && double_ok {
        write_all(2, "\"");
        write_all(2, name);
        write_all(2, "\"");
    } else {
        write_all(2, "'");
        let mut from = 0;
        for j in 0..name.len {
            if name[j] == '\'' {
                write_all(2, name[from..j]);
                write_all(2, "'\\''");
                from = j + 1;
            }
        }
        write_all(2, name[from..name.len]);
        write_all(2, "'");
    }
}

// The C library's text for an errno value.
fn strerror(e: i32) -> [u8] {
    let p = unsafe { libc::strerror(e) };
    unsafe { p[0..libc::strlen(p) as i64] }
}

// Does a name need coreutils' escaping (a leading backslash, and \\, \n,
// \r spelled out)?
fn needs_escape(name: [u8]) -> bool {
    for b in name {
        if b == '\\' || b == '\n' || b == '\r' {
            return true;
        }
    }
    false
}

// -c's test: a newline or CR in the name (a backslash alone is not
// escaped there).
fn has_line_break(name: [u8]) -> bool {
    for b in name {
        if b == '\n' || b == '\r' {
            return true;
        }
    }
    false
}

fn push_name(out: &mut Buf, name: [u8], escape: bool) {
    if !escape {
        out.push_str(name);
        return;
    }
    for b in name {
        if b == '\\' {
            out.push_str("\\\\");
        } else if b == '\n' {
            out.push_str("\\n");
        } else if b == '\r' {
            out.push_str("\\r");
        } else {
            out.push(b);
        }
    }
}

fn push_hex(out: &mut Buf, digest: [u8]) {
    let hex = "0123456789abcdef";
    for b in digest {
        out.push(hex[(b >> 4) as i64]);
        out.push(hex[(b & 15) as i64]);
    }
}

// ---- hashing --------------------------------------------------------

// The digest of what fd holds, into digest[0..32], reading into buf;
// 0, or the errno of a failed read. Each read's whole blocks are hashed
// in place; the few bytes after them move to buf's start.
fn hash_fd(fd: i32, buf: &mut [u8], digest: &mut [u8]) -> i32 {
    let mut state: [u32; 8] = H0;
    let mut total: u64 = 0;
    let mut fill = 0;
    loop {
        let n = unsafe { libc::read(fd, &buf[fill], (buf.len - fill) as u64) };
        if n < 0 {
            let e = errno();
            if e == libc::EINTR {
                continue;
            }
            return e;
        }
        if n == 0 {
            break;
        }
        fill += n as i64;
        total += n as u64;
        let whole = fill & ~63;
        if whole > 0 {
            blocks(&mut state[..], buf[0..whole]);
            for j in whole..fill {
                buf[j - whole] = buf[j];
            }
            fill -= whole;
        }
    }
    finish(&mut state[..], buf[0..fill], total, digest);
    0
}

// The digest of the file at path (a C string; "-": stdin): 0 or an
// errno.
fn hash_path(path: *u8, name: [u8], buf: &mut [u8], digest: &mut [u8]) -> i32 {
    if name == "-" {
        return hash_fd(0, buf, digest);
    }
    let fd = unsafe { libc::open(path, libc::O_RDONLY) };
    if fd < 0 {
        return errno();
    }
    let e = hash_fd(fd, buf, digest);
    unsafe {
        libc::close(fd);
    }
    e
}

// One line of output for a file: `HASH  NAME`, `HASH *NAME` (-b) or
// `SHA256 (NAME) = HASH` (--tag).
fn print_sum(out: &mut Buf, o: &Opts, name: [u8], digest: [u8]) {
    let escape = needs_escape(name);
    if escape {
        out.push('\\');
    }
    if o.tag {
        out.push_str("SHA256 (");
        push_name(out, name, escape);
        out.push_str(") = ");
        push_hex(out, digest);
    } else {
        push_hex(out, digest);
        out.push_str(if o.binary { " *" } else { "  " });
        push_name(out, name, escape);
    }
    out.push('\n');
    if out.len() >= 65536 {
        flush(out);
    }
}

// ---- checking (-c) --------------------------------------------------

fn hex_value(b: u8) -> i64 {
    if b >= '0' && b <= '9' {
        (b - '0') as i64
    } else if b >= 'a' && b <= 'f' {
        (b - 'a' + 10) as i64
    } else if b >= 'A' && b <= 'F' {
        (b - 'A' + 10) as i64
    } else {
        -1
    }
}

// 64 hex digits at s[i..] into want[0..32]; false if they are not.
fn parse_hex(s: [u8], i: i64, want: &mut [u8]) -> bool {
    if i < 0 || i + 64 > s.len {
        return false;
    }
    for j in 0..32 {
        let hi = hex_value(s[i + 2 * j]);
        let lo = hex_value(s[i + 2 * j + 1]);
        if hi < 0 || lo < 0 {
            return false;
        }
        want[j] = (hi * 16 + lo) as u8;
    }
    true
}

// A checksum line, `HASH  NAME`, `HASH *NAME` or `SHA256 (NAME) = HASH`
// (a leading backslash: the name escaped), into want and name (the
// name without its escapes, then a 0 for C); false if it is none.
fn parse_line(line: [u8], want: &mut [u8], name: &mut Buf) -> bool {
    let mut i = 0;
    while i < line.len && (line[i] == ' ' || line[i] == '\t') {
        i += 1;
    }
    let escaped = i < line.len && line[i] == '\\';
    if escaped {
        i += 1;
    }
    let mut from = 0;
    let mut to = 0;
    let tag = "SHA256 (";
    if line.len - i >= tag.len && line[i..i + tag.len] == tag {
        // BSD: the hash is the last 64 bytes, after ") = ".
        let h = line.len - 64;
        if h < i + tag.len + 4 || line[h - 4..h] != ") = " || !parse_hex(line, h, want) {
            return false;
        }
        from = i + tag.len;
        to = h - 4;
    } else {
        if !parse_hex(line, i, want) {
            return false;
        }
        let mut j = i + 64;
        if j >= line.len || (line[j] != ' ' && line[j] != '\t') {
            return false;
        }
        j += 1;
        if j < line.len && (line[j] == ' ' || line[j] == '*') {
            j += 1;
        }
        from = j;
        to = line.len;
    }
    if from >= to {
        return false;
    }
    name.clear();
    let mut k = from;
    while k < to {
        let b = line[k];
        if escaped && b == '\\' {
            if k + 1 >= to {
                return false;
            }
            let e = line[k + 1];
            if e == '\\' {
                name.push('\\');
            } else if e == 'n' {
                name.push('\n');
            } else if e == 'r' {
                name.push('\r');
            } else {
                return false;
            }
            k += 2;
        } else {
            name.push(b);
            k += 1;
        }
    }
    name.push(0);
    true
}

// The whole of fd into text (cleared first), read through buf: 0 or an
// errno.
fn read_all(fd: i32, buf: &mut [u8], text: &mut Buf) -> i32 {
    text.clear();
    loop {
        let n = unsafe { libc::read(fd, &buf[0], buf.len as u64) };
        if n < 0 {
            let e = errno();
            if e == libc::EINTR {
                continue;
            }
            return e;
        }
        if n == 0 {
            return 0;
        }
        text.push_str(buf[0..n as i64]);
    }
}

fn plural(n: i64, one: [u8], many: [u8], out: &mut Buf, scratch: &mut Buf) {
    scratch.clear();
    scratch.push_str("WARNING: ");
    scratch.push_int(n);
    scratch.push_str(if n == 1 { one } else { many });
    report(out, "", 0, scratch.as_slice());
}

// Checks the list in the file at path (name "-": stdin); true if all
// is well.
fn check_list(
    path: *u8, list: [u8], o: &Opts, buf: &mut [u8], out: &mut Buf, text: &mut Buf, name: &mut Buf,
    scratch: &mut Buf,
) -> bool {
    let mut e: i32 = 0;
    if list == "-" {
        e = read_all(0, buf, text);
    } else {
        let fd = unsafe { libc::open(path, libc::O_RDONLY) };
        if fd < 0 {
            e = errno();
        } else {
            e = read_all(fd, buf, text);
            unsafe {
                libc::close(fd);
            }
        }
    }
    // (coreutils' name for stdin in its messages)
    let shown = if list == "-" { "standard input" } else { list };
    if e != 0 {
        report(out, shown, 0, strerror(e));
        return false;
    }
    let mut want: [u8; 32] = [0; 32];
    let mut digest: [u8; 32] = [0; 32];
    let mut lines = 0;
    let mut good = 0;
    let mut bad_lines = 0;
    let mut mismatched = 0;
    let mut unreadable = 0;
    let mut verified = 0;
    let all = text.as_slice();
    let mut start = 0;
    while start < all.len {
        let mut end = start;
        while end < all.len && all[end] != '\n' {
            end += 1;
        }
        let line = all[start..end];
        start = end + 1;
        lines += 1;
        if line.len > 0 && line[0] == '#' {
            continue;
        }
        if !parse_line(line, &mut want[..], name) {
            bad_lines += 1;
            if o.warn {
                report(out, shown, lines, "improperly formatted SHA256 checksum line");
            }
            continue;
        }
        good += 1;
        let cname = name.as_slice();
        let file = cname[0..cname.len - 1];
        let r = hash_path(&cname[0], file, buf, &mut digest[..]);
        // (coreutils escapes a name here only for a newline or CR)
        let escape = has_line_break(file);
        if r != 0 {
            if o.ignore_missing && r == libc::ENOENT {
                continue;
            }
            unreadable += 1;
            report(out, file, 0, strerror(r));
            if !o.status {
                if escape {
                    out.push('\\');
                }
                push_name(out, file, escape);
                out.push_str(": FAILED open or read\n");
            }
            continue;
        }
        verified += 1;
        let ok = digest[..] == want[..];
        if !ok {
            mismatched += 1;
        }
        if !o.status && (!ok || !o.quiet) {
            if escape {
                out.push('\\');
            }
            push_name(out, file, escape);
            out.push_str(if ok { ": OK\n" } else { ": FAILED\n" });
            if out.len() >= 65536 {
                flush(out);
            }
        }
    }
    if good == 0 {
        report(out, shown, 0, "no properly formatted checksum lines found");
        return false;
    }
    if !o.status {
        if bad_lines > 0 {
            plural(bad_lines, " line is improperly formatted", " lines are improperly formatted",
                out, scratch);
        }
        if unreadable > 0 {
            plural(unreadable, " listed file could not be read", " listed files could not be read",
                out, scratch);
        }
        if mismatched > 0 {
            plural(mismatched, " computed checksum did NOT match",
                " computed checksums did NOT match", out, scratch);
        }
    }
    if o.ignore_missing && verified == 0 {
        if !o.status {
            report(out, shown, 0, "no file was verified");
        }
        return false;
    }
    mismatched == 0 && unreadable == 0 && (!o.strict || bad_lines == 0)
}

// ---- the command ----------------------------------------------------

fn arg(argv: **u8, i: i64) -> [u8] {
    let p = unsafe { argv[i] };
    unsafe { p[0..libc::strlen(p) as i64] }
}

fn usage_error(out: &mut Buf, message: [u8]) -> i32 {
    report(out, "", 0, message);
    write_all(2, "Try 'sha256sum --help' for more information.\n");
    1
}

fn main(argc: i32, argv: **u8, gpa: Gpa) -> i32 {
    let mut o = Opts {
        check: false, tag: false, binary: false, quiet: false, status: false, strict: false,
        warn: false, ignore_missing: false,
    };
    let mut out = Buf::with_capacity_in(1 << 17, gpa);
    let mut scratch = Buf::new_in(gpa);
    // The operands: their indexes in argv.
    let mut files: Vec<i64> = Vec::with_capacity_in(argc as i64, gpa);
    let mut options_end = false;
    let mut mode_given = false;
    for i in 1..argc as i64 {
        let a = arg(argv, i);
        if options_end || a.len < 2 || a[0] != '-' {
            files.push(i);
        } else if a == "--" {
            options_end = true;
        } else if a[1] == '-' {
            if a == "--check" {
                o.check = true;
            } else if a == "--tag" {
                o.tag = true;
            } else if a == "--binary" || a == "--text" {
                o.binary = a == "--binary";
                mode_given = true;
            } else if a == "--quiet" {
                o.quiet = true;
            } else if a == "--status" {
                o.status = true;
            } else if a == "--strict" {
                o.strict = true;
            } else if a == "--warn" {
                o.warn = true;
            } else if a == "--ignore-missing" {
                o.ignore_missing = true;
            } else if a == "--help" {
                usage(&mut out);
                flush(&mut out);
                return 0;
            } else if a == "--version" {
                out.push_str("sha256sum (tachyon example) 0.19\n");
                flush(&mut out);
                return 0;
            } else {
                scratch.push_str("unrecognized option '");
                scratch.push_str(a);
                scratch.push_str("'");
                return usage_error(&mut out, scratch.as_slice());
            }
        } else {
            for j in 1..a.len {
                let f = a[j];
                if f == 'c' {
                    o.check = true;
                } else if f == 'b' || f == 't' {
                    o.binary = f == 'b';
                    mode_given = true;
                } else if f == 'w' {
                    o.warn = true;
                } else {
                    scratch.push_str("invalid option -- '");
                    scratch.push(f);
                    scratch.push_str("'");
                    return usage_error(&mut out, scratch.as_slice());
                }
            }
        }
    }
    if o.check && o.tag {
        return usage_error(&mut out, "the --tag option is meaningless when verifying checksums");
    }
    if o.check && mode_given {
        return usage_error(&mut out,
            "the --binary and --text options are meaningless when verifying checksums");
    }
    // (coreutils' order)
    let only: [(bool, [u8]); 5] = [
        (o.ignore_missing, "ignore-missing"), (o.status, "status"), (o.warn, "warn"),
        (o.quiet, "quiet"), (o.strict, "strict"),
    ];
    for (set, option) in only {
        if set && !o.check {
            scratch.push_str("the --");
            scratch.push_str(option);
            scratch.push_str(" option is meaningful only when verifying checksums");
            return usage_error(&mut out, scratch.as_slice());
        }
    }
    let mut buf: Vec<u8> = Vec::filled_in(BUF, 0, gpa);
    let b = buf.as_mut_slice();
    let mut ok = true;
    let n = if files.len() == 0 { 1 } else { files.len() };
    let mut digest: [u8; 32] = [0; 32];
    let mut text = Buf::new_in(gpa);
    let mut name = Buf::new_in(gpa);
    for k in 0..n {
        let (path, file) = if files.len() == 0 {
            (c"-", "-")
        } else {
            (unsafe { argv[files.get(k)] }, arg(argv, files.get(k)))
        };
        if o.check {
            if !check_list(path, file, &o, b, &mut out, &mut text, &mut name, &mut scratch) {
                ok = false;
            }
            continue;
        }
        let e = hash_path(path, file, b, &mut digest[..]);
        if e != 0 {
            report(&mut out, file, 0, strerror(e));
            ok = false;
        } else {
            print_sum(&mut out, &o, file, digest[..]);
        }
    }
    flush(&mut out);
    if ok { 0 } else { 1 }
}
