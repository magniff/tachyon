// SHA-256 (FIPS 180-4): the compression function three ways, and the
// padding. `blocks` is the entry: it hashes whole 64-byte blocks into a
// state, by the ARMv8 SHA-256 instructions when the CPU has them, by
// x86-64's SHA extensions (compiled and checked, not run here), else by
// the portable rounds.

use std::arch::detect;
use std::arch::aarch64::{
    uint32x4_t, vaddq_u32, vld1q_u32, vld1q_u8, vreinterpretq_u32_u8, vrev32q_u8, vsha256h2q_u32,
    vsha256hq_u32, vsha256su0q_u32, vsha256su1q_u32, vst1q_u32,
};
use std::arch::x86_64::{
    _mm_add_epi32, _mm_alignr_epi8, _mm_blend_epi16, _mm_loadu_si128, _mm_sha256msg1_epu32,
    _mm_sha256msg2_epu32, _mm_sha256rnds2_epu32, _mm_shuffle_epi32, _mm_shuffle_epi8,
    _mm_storeu_si128,
};

// SHA-256's round constants (FIPS 180-4, 4.2.2).
static K: [u32; 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

// The same, as the little-endian bytes x86-64's loads take.
static KB: [u8; 256] = [
    0x98, 0x2f, 0x8a, 0x42, 0x91, 0x44, 0x37, 0x71, 0xcf, 0xfb, 0xc0, 0xb5, 0xa5, 0xdb, 0xb5, 0xe9,
    0x5b, 0xc2, 0x56, 0x39, 0xf1, 0x11, 0xf1, 0x59, 0xa4, 0x82, 0x3f, 0x92, 0xd5, 0x5e, 0x1c, 0xab,
    0x98, 0xaa, 0x07, 0xd8, 0x01, 0x5b, 0x83, 0x12, 0xbe, 0x85, 0x31, 0x24, 0xc3, 0x7d, 0x0c, 0x55,
    0x74, 0x5d, 0xbe, 0x72, 0xfe, 0xb1, 0xde, 0x80, 0xa7, 0x06, 0xdc, 0x9b, 0x74, 0xf1, 0x9b, 0xc1,
    0xc1, 0x69, 0x9b, 0xe4, 0x86, 0x47, 0xbe, 0xef, 0xc6, 0x9d, 0xc1, 0x0f, 0xcc, 0xa1, 0x0c, 0x24,
    0x6f, 0x2c, 0xe9, 0x2d, 0xaa, 0x84, 0x74, 0x4a, 0xdc, 0xa9, 0xb0, 0x5c, 0xda, 0x88, 0xf9, 0x76,
    0x52, 0x51, 0x3e, 0x98, 0x6d, 0xc6, 0x31, 0xa8, 0xc8, 0x27, 0x03, 0xb0, 0xc7, 0x7f, 0x59, 0xbf,
    0xf3, 0x0b, 0xe0, 0xc6, 0x47, 0x91, 0xa7, 0xd5, 0x51, 0x63, 0xca, 0x06, 0x67, 0x29, 0x29, 0x14,
    0x85, 0x0a, 0xb7, 0x27, 0x38, 0x21, 0x1b, 0x2e, 0xfc, 0x6d, 0x2c, 0x4d, 0x13, 0x0d, 0x38, 0x53,
    0x54, 0x73, 0x0a, 0x65, 0xbb, 0x0a, 0x6a, 0x76, 0x2e, 0xc9, 0xc2, 0x81, 0x85, 0x2c, 0x72, 0x92,
    0xa1, 0xe8, 0xbf, 0xa2, 0x4b, 0x66, 0x1a, 0xa8, 0x70, 0x8b, 0x4b, 0xc2, 0xa3, 0x51, 0x6c, 0xc7,
    0x19, 0xe8, 0x92, 0xd1, 0x24, 0x06, 0x99, 0xd6, 0x85, 0x35, 0x0e, 0xf4, 0x70, 0xa0, 0x6a, 0x10,
    0x16, 0xc1, 0xa4, 0x19, 0x08, 0x6c, 0x37, 0x1e, 0x4c, 0x77, 0x48, 0x27, 0xb5, 0xbc, 0xb0, 0x34,
    0xb3, 0x0c, 0x1c, 0x39, 0x4a, 0xaa, 0xd8, 0x4e, 0x4f, 0xca, 0x9c, 0x5b, 0xf3, 0x6f, 0x2e, 0x68,
    0xee, 0x82, 0x8f, 0x74, 0x6f, 0x63, 0xa5, 0x78, 0x14, 0x78, 0xc8, 0x84, 0x08, 0x02, 0xc7, 0x8c,
    0xfa, 0xff, 0xbe, 0x90, 0xeb, 0x6c, 0x50, 0xa4, 0xf7, 0xa3, 0xf9, 0xbe, 0xf2, 0x78, 0x71, 0xc6,
];

// pshufb's mask that turns each little-endian word big-endian.
static BSWAP: [u8; 16] = [3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12];

// The initial state (FIPS 180-4, 5.3.3).
pub static H0: [u32; 8] = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
];

// Hashes data's whole 64-byte blocks into state (data.len a multiple
// of 64): the instructions the CPU has, chosen at each call by one test
// of a cached bit.
pub fn blocks(state: &mut [u32], data: [u8]) {
    if detect("sha2") {
        blocks_arm(state, data);
    } else if detect("sha") && detect("sse4.1") {
        blocks_x86(state, data);
    } else {
        blocks_portable(state, data);
    }
}

// The 4 big-endian words of data[i..i + 16].
fn words(data: [u8], i: i64) -> uint32x4_t {
    vreinterpretq_u32_u8(vrev32q_u8(vld1q_u8(data, i)))
}

// ARMv8: four rounds an instruction. vsha256hq_u32 makes the new abcd,
// vsha256h2q_u32 the new efgh from the old abcd; vsha256su0q_u32 and
// vsha256su1q_u32 extend the message schedule four words at a time.
#[target_feature(enable = "sha2")]
fn blocks_arm(state: &mut [u32], data: [u8]) {
    let k = K[..];
    let mut abcd = vld1q_u32(state, 0);
    let mut efgh = vld1q_u32(state, 4);
    let mut i = 0;
    while i + 64 <= data.len {
        let abcd0 = abcd;
        let efgh0 = efgh;
        let mut w0 = words(data, i);
        let mut w1 = words(data, i + 16);
        let mut w2 = words(data, i + 32);
        let mut w3 = words(data, i + 48);
        let wk0 = vaddq_u32(w0, vld1q_u32(k, 0));
        w0 = vsha256su1q_u32(vsha256su0q_u32(w0, w1), w2, w3);
        let a0 = abcd;
        abcd = vsha256hq_u32(abcd, efgh, wk0);
        efgh = vsha256h2q_u32(efgh, a0, wk0);
        let wk1 = vaddq_u32(w1, vld1q_u32(k, 4));
        w1 = vsha256su1q_u32(vsha256su0q_u32(w1, w2), w3, w0);
        let a1 = abcd;
        abcd = vsha256hq_u32(abcd, efgh, wk1);
        efgh = vsha256h2q_u32(efgh, a1, wk1);
        let wk2 = vaddq_u32(w2, vld1q_u32(k, 8));
        w2 = vsha256su1q_u32(vsha256su0q_u32(w2, w3), w0, w1);
        let a2 = abcd;
        abcd = vsha256hq_u32(abcd, efgh, wk2);
        efgh = vsha256h2q_u32(efgh, a2, wk2);
        let wk3 = vaddq_u32(w3, vld1q_u32(k, 12));
        w3 = vsha256su1q_u32(vsha256su0q_u32(w3, w0), w1, w2);
        let a3 = abcd;
        abcd = vsha256hq_u32(abcd, efgh, wk3);
        efgh = vsha256h2q_u32(efgh, a3, wk3);
        let wk4 = vaddq_u32(w0, vld1q_u32(k, 16));
        w0 = vsha256su1q_u32(vsha256su0q_u32(w0, w1), w2, w3);
        let a4 = abcd;
        abcd = vsha256hq_u32(abcd, efgh, wk4);
        efgh = vsha256h2q_u32(efgh, a4, wk4);
        let wk5 = vaddq_u32(w1, vld1q_u32(k, 20));
        w1 = vsha256su1q_u32(vsha256su0q_u32(w1, w2), w3, w0);
        let a5 = abcd;
        abcd = vsha256hq_u32(abcd, efgh, wk5);
        efgh = vsha256h2q_u32(efgh, a5, wk5);
        let wk6 = vaddq_u32(w2, vld1q_u32(k, 24));
        w2 = vsha256su1q_u32(vsha256su0q_u32(w2, w3), w0, w1);
        let a6 = abcd;
        abcd = vsha256hq_u32(abcd, efgh, wk6);
        efgh = vsha256h2q_u32(efgh, a6, wk6);
        let wk7 = vaddq_u32(w3, vld1q_u32(k, 28));
        w3 = vsha256su1q_u32(vsha256su0q_u32(w3, w0), w1, w2);
        let a7 = abcd;
        abcd = vsha256hq_u32(abcd, efgh, wk7);
        efgh = vsha256h2q_u32(efgh, a7, wk7);
        let wk8 = vaddq_u32(w0, vld1q_u32(k, 32));
        w0 = vsha256su1q_u32(vsha256su0q_u32(w0, w1), w2, w3);
        let a8 = abcd;
        abcd = vsha256hq_u32(abcd, efgh, wk8);
        efgh = vsha256h2q_u32(efgh, a8, wk8);
        let wk9 = vaddq_u32(w1, vld1q_u32(k, 36));
        w1 = vsha256su1q_u32(vsha256su0q_u32(w1, w2), w3, w0);
        let a9 = abcd;
        abcd = vsha256hq_u32(abcd, efgh, wk9);
        efgh = vsha256h2q_u32(efgh, a9, wk9);
        let wk10 = vaddq_u32(w2, vld1q_u32(k, 40));
        w2 = vsha256su1q_u32(vsha256su0q_u32(w2, w3), w0, w1);
        let a10 = abcd;
        abcd = vsha256hq_u32(abcd, efgh, wk10);
        efgh = vsha256h2q_u32(efgh, a10, wk10);
        let wk11 = vaddq_u32(w3, vld1q_u32(k, 44));
        w3 = vsha256su1q_u32(vsha256su0q_u32(w3, w0), w1, w2);
        let a11 = abcd;
        abcd = vsha256hq_u32(abcd, efgh, wk11);
        efgh = vsha256h2q_u32(efgh, a11, wk11);
        let wk12 = vaddq_u32(w0, vld1q_u32(k, 48));
        let a12 = abcd;
        abcd = vsha256hq_u32(abcd, efgh, wk12);
        efgh = vsha256h2q_u32(efgh, a12, wk12);
        let wk13 = vaddq_u32(w1, vld1q_u32(k, 52));
        let a13 = abcd;
        abcd = vsha256hq_u32(abcd, efgh, wk13);
        efgh = vsha256h2q_u32(efgh, a13, wk13);
        let wk14 = vaddq_u32(w2, vld1q_u32(k, 56));
        let a14 = abcd;
        abcd = vsha256hq_u32(abcd, efgh, wk14);
        efgh = vsha256h2q_u32(efgh, a14, wk14);
        let wk15 = vaddq_u32(w3, vld1q_u32(k, 60));
        let a15 = abcd;
        abcd = vsha256hq_u32(abcd, efgh, wk15);
        efgh = vsha256h2q_u32(efgh, a15, wk15);
        abcd = vaddq_u32(abcd, abcd0);
        efgh = vaddq_u32(efgh, efgh0);
        i += 64;
    }
    vst1q_u32(state, 0, abcd);
    vst1q_u32(state, 4, efgh);
}

// x86-64's SHA extensions: sha256rnds2 does two rounds and keeps the
// state as abef and cdgh; the schedule by sha256msg1 and sha256msg2.
// Compiled and its encodings checked on every build; not run on this
// machine (no x86-64 with SHA here).
#[target_feature(enable = "sha,sse4.1")]
fn blocks_x86(state: &mut [u32], data: [u8]) {
    // The state as bytes, for the loads.
    let mut sb: [u8; 32] = [0; 32];
    for j in 0..32 {
        sb[j] = (state[j / 4] >> (8 * (j % 4) as u32)) as u8;
    }
    let kb = KB[..];
    let mask = _mm_loadu_si128(BSWAP[..], 0);
    let dcba = _mm_shuffle_epi32(_mm_loadu_si128(sb[..], 0), 0xb1);
    let efgh = _mm_shuffle_epi32(_mm_loadu_si128(sb[..], 16), 0x1b);
    let mut abef = _mm_alignr_epi8(dcba, efgh, 8);
    let mut cdgh = _mm_blend_epi16(efgh, dcba, 0xf0);
    let mut m0 = mask;
    let mut m1 = mask;
    let mut m2 = mask;
    let mut m3 = mask;
    let mut i = 0;
    while i + 64 <= data.len {
        let abef0 = abef;
        let cdgh0 = cdgh;
        m0 = _mm_shuffle_epi8(_mm_loadu_si128(data, i + 0), mask);
        let wk0 = _mm_add_epi32(m0, _mm_loadu_si128(kb, 0));
        cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk0);
        abef = _mm_sha256rnds2_epu32(abef, cdgh, _mm_shuffle_epi32(wk0, 0x0e));
        m1 = _mm_shuffle_epi8(_mm_loadu_si128(data, i + 16), mask);
        let wk1 = _mm_add_epi32(m1, _mm_loadu_si128(kb, 16));
        cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk1);
        abef = _mm_sha256rnds2_epu32(abef, cdgh, _mm_shuffle_epi32(wk1, 0x0e));
        m0 = _mm_sha256msg1_epu32(m0, m1);
        m2 = _mm_shuffle_epi8(_mm_loadu_si128(data, i + 32), mask);
        let wk2 = _mm_add_epi32(m2, _mm_loadu_si128(kb, 32));
        cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk2);
        abef = _mm_sha256rnds2_epu32(abef, cdgh, _mm_shuffle_epi32(wk2, 0x0e));
        m1 = _mm_sha256msg1_epu32(m1, m2);
        m3 = _mm_shuffle_epi8(_mm_loadu_si128(data, i + 48), mask);
        let wk3 = _mm_add_epi32(m3, _mm_loadu_si128(kb, 48));
        cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk3);
        m0 = _mm_sha256msg2_epu32(_mm_add_epi32(m0, _mm_alignr_epi8(m3, m2, 4)), m3);
        abef = _mm_sha256rnds2_epu32(abef, cdgh, _mm_shuffle_epi32(wk3, 0x0e));
        m2 = _mm_sha256msg1_epu32(m2, m3);
        let wk4 = _mm_add_epi32(m0, _mm_loadu_si128(kb, 64));
        cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk4);
        m1 = _mm_sha256msg2_epu32(_mm_add_epi32(m1, _mm_alignr_epi8(m0, m3, 4)), m0);
        abef = _mm_sha256rnds2_epu32(abef, cdgh, _mm_shuffle_epi32(wk4, 0x0e));
        m3 = _mm_sha256msg1_epu32(m3, m0);
        let wk5 = _mm_add_epi32(m1, _mm_loadu_si128(kb, 80));
        cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk5);
        m2 = _mm_sha256msg2_epu32(_mm_add_epi32(m2, _mm_alignr_epi8(m1, m0, 4)), m1);
        abef = _mm_sha256rnds2_epu32(abef, cdgh, _mm_shuffle_epi32(wk5, 0x0e));
        m0 = _mm_sha256msg1_epu32(m0, m1);
        let wk6 = _mm_add_epi32(m2, _mm_loadu_si128(kb, 96));
        cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk6);
        m3 = _mm_sha256msg2_epu32(_mm_add_epi32(m3, _mm_alignr_epi8(m2, m1, 4)), m2);
        abef = _mm_sha256rnds2_epu32(abef, cdgh, _mm_shuffle_epi32(wk6, 0x0e));
        m1 = _mm_sha256msg1_epu32(m1, m2);
        let wk7 = _mm_add_epi32(m3, _mm_loadu_si128(kb, 112));
        cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk7);
        m0 = _mm_sha256msg2_epu32(_mm_add_epi32(m0, _mm_alignr_epi8(m3, m2, 4)), m3);
        abef = _mm_sha256rnds2_epu32(abef, cdgh, _mm_shuffle_epi32(wk7, 0x0e));
        m2 = _mm_sha256msg1_epu32(m2, m3);
        let wk8 = _mm_add_epi32(m0, _mm_loadu_si128(kb, 128));
        cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk8);
        m1 = _mm_sha256msg2_epu32(_mm_add_epi32(m1, _mm_alignr_epi8(m0, m3, 4)), m0);
        abef = _mm_sha256rnds2_epu32(abef, cdgh, _mm_shuffle_epi32(wk8, 0x0e));
        m3 = _mm_sha256msg1_epu32(m3, m0);
        let wk9 = _mm_add_epi32(m1, _mm_loadu_si128(kb, 144));
        cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk9);
        m2 = _mm_sha256msg2_epu32(_mm_add_epi32(m2, _mm_alignr_epi8(m1, m0, 4)), m1);
        abef = _mm_sha256rnds2_epu32(abef, cdgh, _mm_shuffle_epi32(wk9, 0x0e));
        m0 = _mm_sha256msg1_epu32(m0, m1);
        let wk10 = _mm_add_epi32(m2, _mm_loadu_si128(kb, 160));
        cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk10);
        m3 = _mm_sha256msg2_epu32(_mm_add_epi32(m3, _mm_alignr_epi8(m2, m1, 4)), m2);
        abef = _mm_sha256rnds2_epu32(abef, cdgh, _mm_shuffle_epi32(wk10, 0x0e));
        m1 = _mm_sha256msg1_epu32(m1, m2);
        let wk11 = _mm_add_epi32(m3, _mm_loadu_si128(kb, 176));
        cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk11);
        m0 = _mm_sha256msg2_epu32(_mm_add_epi32(m0, _mm_alignr_epi8(m3, m2, 4)), m3);
        abef = _mm_sha256rnds2_epu32(abef, cdgh, _mm_shuffle_epi32(wk11, 0x0e));
        m2 = _mm_sha256msg1_epu32(m2, m3);
        let wk12 = _mm_add_epi32(m0, _mm_loadu_si128(kb, 192));
        cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk12);
        m1 = _mm_sha256msg2_epu32(_mm_add_epi32(m1, _mm_alignr_epi8(m0, m3, 4)), m0);
        abef = _mm_sha256rnds2_epu32(abef, cdgh, _mm_shuffle_epi32(wk12, 0x0e));
        m3 = _mm_sha256msg1_epu32(m3, m0);
        let wk13 = _mm_add_epi32(m1, _mm_loadu_si128(kb, 208));
        cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk13);
        m2 = _mm_sha256msg2_epu32(_mm_add_epi32(m2, _mm_alignr_epi8(m1, m0, 4)), m1);
        abef = _mm_sha256rnds2_epu32(abef, cdgh, _mm_shuffle_epi32(wk13, 0x0e));
        let wk14 = _mm_add_epi32(m2, _mm_loadu_si128(kb, 224));
        cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk14);
        m3 = _mm_sha256msg2_epu32(_mm_add_epi32(m3, _mm_alignr_epi8(m2, m1, 4)), m2);
        abef = _mm_sha256rnds2_epu32(abef, cdgh, _mm_shuffle_epi32(wk14, 0x0e));
        let wk15 = _mm_add_epi32(m3, _mm_loadu_si128(kb, 240));
        cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk15);
        abef = _mm_sha256rnds2_epu32(abef, cdgh, _mm_shuffle_epi32(wk15, 0x0e));
        abef = _mm_add_epi32(abef, abef0);
        cdgh = _mm_add_epi32(cdgh, cdgh0);
        i += 64;
    }
    let feba = _mm_shuffle_epi32(abef, 0x1b);
    let dchg = _mm_shuffle_epi32(cdgh, 0xb1);
    _mm_storeu_si128(&mut sb[..], 0, _mm_blend_epi16(feba, dchg, 0xf0));
    _mm_storeu_si128(&mut sb[..], 16, _mm_alignr_epi8(dchg, feba, 8));
    for j in 0..8 {
        state[j] = sb[4 * j] as u32 | (sb[4 * j + 1] as u32) << 8 | (sb[4 * j + 2] as u32) << 16
            | (sb[4 * j + 3] as u32) << 24;
    }
}

fn rotr(x: u32, n: u32) -> u32 {
    (x >> n) | (x << (32 - n))
}

// The portable rounds, as FIPS 180-4 6.2.2 writes them: the fallback for
// a CPU without the instructions (TACHYON_ARCH_DISABLE=all forces it).
pub fn blocks_portable(state: &mut [u32], data: [u8]) {
    let mut w: [u32; 64] = [0; 64];
    let mut i = 0;
    while i + 64 <= data.len {
        for t in 0..16 {
            let p = i + 4 * t;
            w[t] = (data[p] as u32) << 24 | (data[p + 1] as u32) << 16 | (data[p + 2] as u32) << 8
                | data[p + 3] as u32;
        }
        for t in 16..64 {
            let x = w[t - 15];
            let y = w[t - 2];
            let s0 = rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3);
            let s1 = rotr(y, 17) ^ rotr(y, 19) ^ (y >> 10);
            w[t] = w[t - 16] + s0 + w[t - 7] + s1;
        }
        let mut a = state[0];
        let mut b = state[1];
        let mut c = state[2];
        let mut d = state[3];
        let mut e = state[4];
        let mut f = state[5];
        let mut g = state[6];
        let mut h = state[7];
        for t in 0..64 {
            let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
            let ch = (e & f) ^ (~e & g);
            let t1 = h + s1 + ch + K[t] + w[t];
            let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let t2 = s0 + maj;
            h = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
        }
        state[0] += a;
        state[1] += b;
        state[2] += c;
        state[3] += d;
        state[4] += e;
        state[5] += f;
        state[6] += g;
        state[7] += h;
        i += 64;
    }
}

// Hashes the last bytes, tail (fewer than 64), of a message of total
// bytes, padded: 0x80, zeros, the length in bits, big-endian; one block
// or two. Then the digest, state's words big-endian, into out[0..32].
pub fn finish(state: &mut [u32], tail: [u8], total: u64, out: &mut [u8]) {
    let mut pad: [u8; 128] = [0; 128];
    for j in 0..tail.len {
        pad[j] = tail[j];
    }
    pad[tail.len] = 0x80;
    let n = if tail.len < 56 { 64 } else { 128 };
    let bits = total << 3;
    for j in 0..8 {
        pad[n - 1 - j] = (bits >> (8 * j as u64)) as u8;
    }
    blocks(state, pad[0..n]);
    for j in 0..32 {
        out[j] = (state[j / 4] >> (24 - 8 * (j % 4)) as u32) as u8;
    }
}
