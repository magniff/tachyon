// CRC-32 (the checksum of gzip, zip and PNG) by AArch64's crc32
// instructions, 16 bytes a load, against the portable table-driven
// version. crc is not in every Arm CPU's baseline (Linux on arm64 promises
// only Armv8.0), so the program tests the CPU once with detect("crc") and
// falls back to the table. `./crc32` checks both on the standard check
// value and on every length and offset up to 300 bytes; `./crc32 hw` and
// `./crc32 portable` checksum 1 GiB with one of them, for timing
// (README.md).
use std::env;
use std::arch::detect;
use std::arch::aarch64::{__crc32b, __crc32d, vgetq_lane_u64, vld1q_u8, vreinterpretq_u64_u8};
use std::cli::{Arg, Command};

// The table of the byte-at-a-time algorithm: entry n is the CRC of byte n
// (the reflected polynomial 0xedb88320).
fn make_table(t: inout [u32]) {
    for n in 0..256 {
        var c = n as u32;
        for _ in 0..8 {
            c = if (c & 1) != 0 { 0xedb88320 ^ (c >> 1) } else { c >> 1 };
        }
        t[n] = c;
    }
}

// CRC-32 of s, continuing from crc (0 to start), a byte at a time.
fn crc32_portable(t: [u32], crc: u32, s: [u8]) -> u32 {
    var c = ~crc;
    for b in s {
        c = t[((c ^ b as u32) & 0xff) as i64] ^ (c >> 8);
    }
    ~c
}

// The same by the crc instructions: two 8-byte steps per 16-byte load,
// then a byte at a time. It needs crc (`query features crc32_hw`).
fn crc32_hw(crc: u32, s: [u8]) -> u32 {
    var c = ~crc;
    var i = 0;
    while i + 16 <= s.len {
        let v = vreinterpretq_u64_u8(vld1q_u8(s, i));
        c = __crc32d(c, vgetq_lane_u64(v, 0));
        c = __crc32d(c, vgetq_lane_u64(v, 1));
        i += 16;
    }
    while i < s.len {
        c = __crc32b(c, s[i]);
        i += 1;
    }
    ~c
}

// CRC-32 of s: by the instructions when the CPU has them. Below the
// early return, crc is known, so crc32_hw may be called.
fn crc32(t: [u32], crc: u32, s: [u8]) -> u32 {
    if !detect("crc") {
        return crc32_portable(t, crc, s);
    }
    crc32_hw(crc, s)
}

// Pseudo-random bytes (xorshift).
fn noise(v: inout Vec<u8>, n: i64) {
    var x: u64 = 0x9e3779b97f4a7c15;
    for _ in 0..n {
        x ^= x << 13;
        x ^= x >> 7;
        x ^= x << 17;
        v.push(x as u8);
    }
}

// The check value, and every length and offset up to 300 bytes: the
// instructions and the table agree, in one piece and in two.
fn check(gpa: Gpa, t: [u32]) {
    println(f"crc32(\"123456789\") = {crc32(t, 0, "123456789"):08x}");
    var v: Vec<u8> = Vec::with_capacity_in(320, gpa);
    noise(&v, 320);
    let s = v.as_slice();
    var sums = 0;
    var wrong = 0;
    for off in 0..16 {
        for len in 0..300 {
            let part = s[off..off + len];
            let whole = crc32(t, 0, part);
            let split = crc32(t, crc32(t, 0, part[0..len / 3]), part[len / 3..len]);
            sums += 1;
            if whole != crc32_portable(t, 0, part) || split != whole {
                wrong += 1;
            }
        }
    }
    println(f"{sums} checksums, {wrong} wrong");
}

// 1024 checksums of 1 MiB, by crc32 or the table.
fn bench(gpa: Gpa, t: [u32], hw: bool) {
    let n = 1 << 20;
    var v: Vec<u8> = Vec::with_capacity_in(n, gpa);
    noise(&v, n);
    let s = v.as_slice();
    var c: u32 = 0;
    for _ in 0..1024 {
        // (each continues the last: no two are the same computation)
        c = if hw { crc32(t, c, s) } else { crc32_portable(t, c, s) };
    }
    println(f"{c:08x}");
}

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("crc32", gpa)
        .about("CRC-32 by the crc instructions, checked against the table")
        .arg(Arg::positional("mode")
            .help("hw or portable: checksum 1 GiB with one of them, for timing (none: check that they agree)"));
    let m = cmd.parse_or_exit(env::args());
    let mode = m.get("mode").unwrap_or("");
    var t: [u32; 256] = [0; 256];
    make_table(&t[..]);
    if mode == "hw" || mode == "portable" {
        bench(gpa, t[..], mode == "hw");
    } else {
        check(gpa, t[..]);
    }
    0
}
