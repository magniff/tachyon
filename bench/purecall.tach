// purecall (0.16): calls of pure functions in hot loops, left where they
// are written. The optimizer hoists a call with loop-invariant arguments
// out of its loop and merges two equal calls into one (value numbering);
// bench/purecall_hoisted.tach is the same program with both done by hand,
// and bench/run.sh fails when this one is more than 1.05 times slower.
// The functions are not inlined (`#[inline(never)]`: as functions too
// large to inline are not), so what is measured is the calls.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

// The length of x's Collatz sequence: pure, with a loop the optimizer
// cannot prove finite.
#[inline(never)]
fn collatz_len(x: i64) -> i64 {
    var n = x;
    var count = 0;
    while n > 1 {
        n = if n % 2 == 0 { n / 2 } else { 3 * n + 1 };
        count += 1;
    }
    count
}

// A mix of the bits of x: pure, always returns.
#[inline(never)]
fn mix(x: u64) -> u64 {
    var h = x ^ (x >> 31);
    h = h * 0x7fb5d329728ea185;
    h = h ^ (h >> 27);
    h = h * 0x81dadef4bc2dd44d;
    h ^ (h >> 33)
}

fn invariant(n: i64, limit: i64) -> u64 {
    var s: u64 = 0;
    for i in 0..n {
        s = s * 31 + ((collatz_len(limit) ^ (i & 7)) as u64);
    }
    s
}

fn repeated(n: i64) -> u64 {
    var s: u64 = 0;
    for i in 0..n {
        let k = (i & 1023) as u64;
        s = s + (mix(k) >> 3) + (mix(k) & 7);
    }
    s
}

fn main() -> i32 {
    let a = invariant(50000000, 6);
    let b = invariant(1000, 27);
    let c = repeated(40000000);
    unsafe { printf(c"%lu %lu %lu\n", a, b, c); }
    0
}
