// A 5-point stencil (Jacobi relaxation) on a 400x400 grid of f64, 200
// sweeps, through slices: loops, bounds checks, strided addresses.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn calloc(count: u64, size: u64) -> *u8;
}

const N: i64 = 400;

fn sweep(src: [f64], dst: inout [f64]) {
    for i in 1..N - 1 {
        for j in 1..N - 1 {
            let k = i * N + j;
            dst[k] = 0.25 * (src[k - 1] + src[k + 1] + src[k - N] + src[k + N]);
        }
    }
}

fn main() -> i32 {
    let a = unsafe { calloc((N * N) as u64, 8) as *f64 };
    let b = unsafe { calloc((N * N) as u64, 8) as *f64 };
    let sa = unsafe { &a[0..N * N] };
    let sb = unsafe { &b[0..N * N] };
    // A hot edge: the left column at 100.
    for i in 0..N {
        sa[i * N] = 100.0;
        sb[i * N] = 100.0;
    }
    for _ in 0..100 {
        sweep(sa, sb);
        sweep(sb, sa);
    }
    var total = 0.0;
    for k in 0..N * N {
        total += sa[k];
    }
    unsafe { printf(c"%.6f\n", total); }
    0
}
