// fannkuch-redux of the benchmarks game, n = 10: permutations, flips of
// prefixes of small arrays (checked indexing), a checksum.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn fannkuch(n: i64) -> (i64, i64) {
    let mut perm: [i64; 16] = [0; 16];
    let mut perm1: [i64; 16] = [0; 16];
    let mut count: [i64; 16] = [0; 16];
    for i in 0..n {
        perm1[i] = i;
    }
    let mut r = n;
    let mut max_flips = 0;
    let mut checksum = 0;
    let mut perm_count = 0;
    loop {
        while r != 1 {
            count[r - 1] = r;
            r -= 1;
        }
        for i in 0..n {
            perm[i] = perm1[i];
        }
        let mut flips = 0;
        let mut k = perm[0];
        while k != 0 {
            let half = (k + 1) >> 1;
            for i in 0..half {
                let t = perm[i];
                perm[i] = perm[k - i];
                perm[k - i] = t;
            }
            flips += 1;
            k = perm[0];
        }
        if flips > max_flips {
            max_flips = flips;
        }
        if perm_count % 2 == 0 {
            checksum += flips;
        } else {
            checksum -= flips;
        }
        loop {
            if r == n {
                return (checksum, max_flips);
            }
            let perm0 = perm1[0];
            for i in 0..r {
                perm1[i] = perm1[i + 1];
            }
            perm1[r] = perm0;
            count[r] -= 1;
            if count[r] > 0 {
                break;
            }
            r += 1;
        }
        perm_count += 1;
    }
}

fn main() -> i32 {
    let n = 10;
    let result = fannkuch(n);
    unsafe { printf(c"%ld\nPfannkuchen(%ld) = %ld\n", result.0, n, result.1); }
    0
}
