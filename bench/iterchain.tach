// Iterator chains (0.14): six kernels over a vector of 2^20 integers, as
// chains of std's adapters and closures; bench/iterloop.tach computes the
// same with hand-written loops, and bench/run.sh prints the ratio of the
// two times (zero cost: about 1).

extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

#[inline(never)]
fn filter_map_sum(v: *Vec<i64>, r: i64) -> i64 {
    v.iter().filter(|x| x & 1 == 0).map(|x| x * x + r).sum()
}

#[inline(never)]
fn dot(v: *Vec<i64>, w: *Vec<i64>, r: i64) -> i64 {
    v.iter().zip(w.iter()).map(|(a, b)| a * b + r).sum()
}

#[inline(never)]
fn enumerate_sum(v: *Vec<i64>, r: i64) -> i64 {
    v.iter().enumerate().map(|(i, x)| i * x + r).sum()
}

#[inline(never)]
fn max_count(v: *Vec<i64>, r: i64) -> i64 {
    v.iter().map(|x| x ^ r).max().unwrap() + v.iter().filter(|x| x > r).count()
}

#[inline(never)]
fn take_loop(v: *Vec<i64>, n: i64) -> i64 {
    let mut t = 0;
    for x in v.iter().take(n) {
        t += x;
    }
    t
}

#[inline(never)]
fn collect_sort(v: *Vec<i64>, m: i64, r: i64) -> i64 {
    let mut u = v.iter().take(m).map(|x| x ^ r).collect();
    defer u.free();
    u.sort_by(|a, b| b.cmp(a));
    u.get(0) - u.get(m - 1) + u.get(m / 2)
}

fn main() -> i32 {
    let n = 1048576;
    let reps = 200;
    let mut v: Vec<i64> = Vec::with_capacity(n);
    defer v.free();
    let mut w: Vec<i64> = Vec::with_capacity(n);
    defer w.free();
    for i in 0..n {
        v.push(i * 2654435761 % 1000003 % 1001 - 500);
        w.push(i % 17 - 8);
    }
    let mut c1 = 0;
    let mut c2 = 0;
    let mut c3 = 0;
    let mut c4 = 0;
    let mut c5 = 0;
    for r in 0..reps {
        c1 += filter_map_sum(&v, r);
        c2 += dot(&v, &w, r);
        c3 += enumerate_sum(&v, r);
        c4 += max_count(&v, r * 4999);
        c5 += take_loop(&v, n - r);
    }
    let mut c6 = 0;
    for r in 0..10 {
        c6 += collect_sort(&v, 65536, r);
    }
    unsafe { printf(c"%ld %ld %ld %ld %ld %ld\n", c1, c2, c3, c4, c5, c6); }
    0
}
