// purecall_hoisted (0.16): bench/purecall.tach with its pure calls hoisted
// out of the loop and merged by hand: what the optimizer must match.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

// The length of x's Collatz sequence: pure, with a loop the optimizer
// cannot prove finite.
#[inline(never)]
fn collatz_len(x: i64) -> i64 {
    let mut n = x;
    let mut count = 0;
    while n > 1 {
        n = if n % 2 == 0 { n / 2 } else { 3 * n + 1 };
        count += 1;
    }
    count
}

// A mix of the bits of x: pure, always returns.
#[inline(never)]
fn mix(x: u64) -> u64 {
    let mut h = x ^ (x >> 31);
    h = h * 0x7fb5d329728ea185;
    h = h ^ (h >> 27);
    h = h * 0x81dadef4bc2dd44d;
    h ^ (h >> 33)
}

fn invariant(n: i64, limit: i64) -> u64 {
    let mut s: u64 = 0;
    let p = if n > 0 { collatz_len(limit) } else { 0 };
    for i in 0..n {
        s = s * 31 + ((p ^ (i & 7)) as u64);
    }
    s
}

fn repeated(n: i64) -> u64 {
    let mut s: u64 = 0;
    for i in 0..n {
        let k = (i & 1023) as u64;
        let m = mix(k);
        s = s + (m >> 3) + (m & 7);
    }
    s
}

fn main() -> i32 {
    let a = invariant(50000000, 6);
    let b = invariant(1000, 27);
    let c = repeated(40000000);
    unsafe { printf(c"%lu %lu %lu\n", a, b, c); }
    0
}
