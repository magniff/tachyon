// Priority queues: std::BinaryHeap (a max-heap) fed 1,000,000 pseudo-random
// integers and emptied; then std::MinHeap of (distance, node) pairs as
// Dijkstra uses it, 2,000,000 rounds of a pop and one or two pushes. The
// popped values are checked (in order) and summed.
use std::{BinaryHeap, MinHeap, Vec};

extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn next(state: &mut u64) -> u64 {
    *state = *state * 6364136223846793005u64 + 1442695040888963407u64;
    *state >> 17
}

fn main(gpa: Gpa) -> i32 {
    let mut state = 42u64;
    let n = 1000000;
    let mut h: BinaryHeap<i64> = BinaryHeap::with_capacity_in(n, gpa);
    for _ in 0..n {
        h.push(next(&mut state) as i64);
    }
    let mut sum = 0u64;
    let mut ordered = true;
    let mut last = i64::MAX;
    while let Some(x) = h.pop() {
        sum = sum * 31u64 + x as u64;
        if x > last {
            ordered = false;
        }
        last = x;
    }
    unsafe { printf(c"%d %lu\n", ordered as i32, sum); }

    let mut q: MinHeap<(i64, i64)> = MinHeap::new_in(gpa);
    for i in 0..1000 {
        q.push(((next(&mut state) % 1000u64) as i64, i));
    }
    let mut sum2 = 0u64;
    let mut ordered2 = true;
    let mut prev = 0;
    for r in 0..2000000 {
        let (d, u) = q.pop().unwrap();
        if d < prev {
            ordered2 = false;
        }
        prev = d;
        sum2 = sum2 * 31u64 + (d + u) as u64;
        q.push((d + (next(&mut state) % 1000u64) as i64, (u * 7 + r) % 100000));
        if r % 2 == 0 && q.len() < 200000 {
            q.push((d + (next(&mut state) % 5000u64) as i64, r % 100000));
        }
    }
    unsafe { printf(c"%d %lu %ld\n", ordered2 as i32, sum2, q.len()); }
    0
}
