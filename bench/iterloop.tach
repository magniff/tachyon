// The kernels of bench/iterchain.tach as hand-written loops: the same
// results, the time an iterator chain should match (bench/run.sh prints
// the ratio).

extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

#[inline(never)]
fn filter_map_sum(v: *Vec<i64>, r: i64) -> i64 {
    let s = v.as_slice();
    let mut t = 0;
    for x in s {
        if x & 1 == 0 {
            t += x * x + r;
        }
    }
    t
}

#[inline(never)]
fn dot(v: *Vec<i64>, w: *Vec<i64>, r: i64) -> i64 {
    let a = v.as_slice();
    let b = w.as_slice();
    let n = if a.len < b.len { a.len } else { b.len };
    let mut t = 0;
    for k in 0..n {
        t += a[k] * b[k] + r;
    }
    t
}

#[inline(never)]
fn enumerate_sum(v: *Vec<i64>, r: i64) -> i64 {
    let s = v.as_slice();
    let mut t = 0;
    for k in 0..s.len {
        t += k * s[k] + r;
    }
    t
}

#[inline(never)]
fn max_count(v: *Vec<i64>, r: i64) -> i64 {
    let s = v.as_slice();
    let mut m = s[0] ^ r;
    for k in 1..s.len {
        let x = s[k] ^ r;
        if x > m {
            m = x;
        }
    }
    let mut c = 0;
    for x in s {
        if x > r {
            c += 1;
        }
    }
    m + c
}

#[inline(never)]
fn take_loop(v: *Vec<i64>, n: i64) -> i64 {
    let s = v.as_slice();
    let m = if n < s.len { n } else { s.len };
    let mut t = 0;
    for k in 0..m {
        t += s[k];
    }
    t
}

// std's heapsort, largest first.
fn sift_down(s: [i64], start: i64, end: i64) {
    let mut root = start;
    loop {
        let mut child = 2 * root + 1;
        if child >= end {
            return;
        }
        if child + 1 < end && s[child + 1] < s[child] {
            child += 1;
        }
        if s[child] >= s[root] {
            return;
        }
        let t = s[root];
        s[root] = s[child];
        s[child] = t;
        root = child;
    }
}

// (a library function, as std's sort is: not inlined into its caller)
#[inline(never)]
fn sort_desc(s: [i64]) {
    let n = s.len;
    let mut start = n / 2;
    while start > 0 {
        start -= 1;
        sift_down(s, start, n);
    }
    let mut end = n;
    while end > 1 {
        end -= 1;
        let top = s[0];
        s[0] = s[end];
        s[end] = top;
        sift_down(s, 0, end);
    }
}

#[inline(never)]
fn collect_sort(v: *Vec<i64>, m: i64, r: i64) -> i64 {
    let s = v.as_slice();
    let mut u: Vec<i64> = Vec::new();
    defer u.free();
    for k in 0..m {
        u.push(s[k] ^ r);
    }
    sort_desc(u.as_slice());
    u.get(0) - u.get(m - 1) + u.get(m / 2)
}

fn main() -> i32 {
    let n = 1048576;
    let reps = 200;
    let mut v: Vec<i64> = Vec::with_capacity(n);
    defer v.free();
    let mut w: Vec<i64> = Vec::with_capacity(n);
    defer w.free();
    for i in 0..n {
        v.push(i * 2654435761 % 1000003 % 1001 - 500);
        w.push(i % 17 - 8);
    }
    let mut c1 = 0;
    let mut c2 = 0;
    let mut c3 = 0;
    let mut c4 = 0;
    let mut c5 = 0;
    for r in 0..reps {
        c1 += filter_map_sum(&v, r);
        c2 += dot(&v, &w, r);
        c3 += enumerate_sum(&v, r);
        c4 += max_count(&v, r * 4999);
        c5 += take_loop(&v, n - r);
    }
    let mut c6 = 0;
    for r in 0..10 {
        c6 += collect_sort(&v, 65536, r);
    }
    unsafe { printf(c"%ld %ld %ld %ld %ld %ld\n", c1, c2, c3, c4, c5, c6); }
    0
}
