// 300x300 f64 matrix multiplication, three times: arrays and loops.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn malloc(size: u64) -> *u8;
}

const N: i64 = 300;

fn at(m: &mut f64, i: i64, j: i64) -> *f64 {
    unsafe { &m[i * N + j] }
}

fn multiply(a: &mut f64, b: &mut f64, c: &mut f64) {
    for i in 0..N {
        for j in 0..N {
            let mut sum = 0.0;
            for k in 0..N {
                unsafe { sum += *at(a, i, k) * *at(b, k, j); }
            }
            unsafe { *at(c, i, j) = sum; }
        }
    }
}

fn main() -> i32 {
    let a = unsafe { malloc((N * N * 8) as u64) as *f64 };
    let b = unsafe { malloc((N * N * 8) as u64) as *f64 };
    let c = unsafe { malloc((N * N * 8) as u64) as *f64 };
    for i in 0..N {
        for j in 0..N {
            unsafe {
                *at(&mut *a, i, j) = (i + j) as f64 / N as f64;
                *at(&mut *b, i, j) = (i - j) as f64 / N as f64;
            }
        }
    }
    let mut total = 0.0;
    for _ in 0..3 {
        unsafe {
            multiply(&mut *a, &mut *b, &mut *c);
            total += *at(&mut *c, N / 2, N / 3);
        }
    }
    unsafe { printf(c"%.6f\n", total); }
    0
}
