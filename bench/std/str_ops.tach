// bench/std: str's methods on 2,000,000 CSV-like lines (`k123, -4567 ,
// abcab`, made first): lines(), split(','), trim(), parse::<i64>(),
// starts_with, contains, three times. Prints the lines, the sum of the
// numbers, the words that contain "ab" and the keys that start with "k1".
fn next(s: inout u64) -> u64 {
    var x = s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    s = x;
    x
}

fn main(gpa: Gpa) -> i32 {
    let n = 2000000;
    var st = 0x9E3779B97F4A7C15u64;
    var text = String::with_capacity_in(n * 32, gpa);
    let letters: [u8] = "abcde";
    for _ in 0..n {
        let r = next(&st);
        text.push_fmt(f"k{r % 1000}, {(r >> 10) as i64 % 100000 - 50000} , ");
        let len = 3 + (r >> 40) % 6;
        for j in 0..len {
            text.push(letters[((r >> (j * 3)) % 5) as i64] as u32);
        }
        text.push('\n');
    }
    let s = text.as_str();
    var lines = 0;
    var sum: i64 = 0;
    var ab = 0;
    var k1 = 0;
    for _ in 0..3 {
        for line in s.lines() {
            var f = line.split(',');
            let key = f.next().unwrap();
            let num = f.next().unwrap().trim().parse::<i64>().unwrap_or(0);
            let word = f.next().unwrap().trim();
            lines += 1;
            sum += num;
            if word.contains("ab") {
                ab += 1;
            }
            if key.starts_with("k1") {
                k1 += 1;
            }
        }
    }
    println(f"{lines} {sum} {ab} {k1}");
    0
}
