// bench/std: BTreeMap<u64, u64>, 1,000,000 inserts of random u64, then
// 1,000,000 lookups (half hits) and 1000 range scans of about 1000 pairs
// each. Prints the pairs, the hits, the sum of the values found, and the
// pairs and the sum of the values scanned.
use std::BTreeMap;

fn xorshift(x: inout u64) -> u64 {
    var v = x;
    v ^= v << 13;
    v ^= v >> 7;
    v ^= v << 17;
    x = v;
    v
}

fn main(gpa: Gpa) {
    let n = 1000000;
    var m: BTreeMap<u64, u64> = BTreeMap::new_in(gpa);
    var x = 0x9e3779b97f4a7c15u64;
    for i in 0..n {
        m.insert(xorshift(&x), i as u64);
    }
    var y = 0x9e3779b97f4a7c15u64;
    var sum = 0u64;
    var hits = 0;
    for i in 0..n {
        let k = if i % 2 == 0 { xorshift(&y) } else { xorshift(&x) };
        match m.get(k) {
            Some(v) => {
                sum += v;
                hits += 1;
            }
            None => {}
        }
    }
    // (ranges of 2^54: about a thousandth of the keys each)
    var scanned = 0;
    var ssum = 0u64;
    for _ in 0..1000 {
        let lo = xorshift(&x) >> 1;
        for (_, v) in m.range(lo, lo + (1u64 << 54)) {
            scanned += 1;
            ssum += v;
        }
    }
    println(f"{m.len()} {hits} {sum} {scanned} {ssum}");
}
