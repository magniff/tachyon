// bench/std's text benchmarks' input (0.20): five kinds of UTF-8 text of
// about 16 MB each, made from a fixed xorshift64 seed, byte for byte the
// same as text_gen.rs and text_gen.h make (the checksums compare them):
//
//   0 source  code-like ASCII lines (the terminal's `cat` stream)
//   1 latin   French and German-like words, a sixth of the letters accented
//   2 cjk     Chinese text with CJK punctuation
//   3 emoji   a chat log: ASCII words and emoji of every kind
//   4 mixed   all of these, Cyrillic, Greek, Hangul syllables and jamo,
//             Devanagari conjuncts, combining accents
//
// Each ends with four newlines (the benchmarks cut 0 to 3 bytes off it).

pub const KINDS: i64 = 5;
pub const SIZE: i64 = 16 * 1024 * 1024;

pub fn kind_name(k: i64) -> [u8] {
    if k == 0 { "source" } else if k == 1 { "latin" } else if k == 2 { "cjk" }
    else if k == 3 { "emoji" } else { "mixed" }
}

fn next(s: &mut u64) -> u64 {
    let mut x = *s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    *s = x;
    x
}

fn put(b: &mut Buf, cp: u32) {
    if cp < 0x80 {
        b.push(cp as u8);
    } else if cp < 0x800 {
        b.push((0xc0 | (cp >> 6)) as u8);
        b.push((0x80 | (cp & 0x3f)) as u8);
    } else if cp < 0x10000 {
        b.push((0xe0 | (cp >> 12)) as u8);
        b.push((0x80 | ((cp >> 6) & 0x3f)) as u8);
        b.push((0x80 | (cp & 0x3f)) as u8);
    } else {
        b.push((0xf0 | (cp >> 18)) as u8);
        b.push((0x80 | ((cp >> 12) & 0x3f)) as u8);
        b.push((0x80 | ((cp >> 6) & 0x3f)) as u8);
        b.push((0x80 | (cp & 0x3f)) as u8);
    }
}

// An ASCII word of 1 to 9 letters from the bits of x above bit 8.
fn word(b: &mut Buf, x: u64) {
    let n = 1 + (x >> 8) % 9;
    for i in 0..n {
        b.push((97 + (x >> (12 + i * 5)) % 26) as u8);
    }
}

const ACCENTED: [u32; 16] = [0xe9, 0xe8, 0xea, 0xe0, 0xe7, 0xf4, 0xfb, 0xe4, 0xf6, 0xfc, 0xdf, 0xc9,
    0xef, 0xee, 0xf9, 0x153];

fn latin_word(b: &mut Buf, x: u64) {
    let n = 2 + (x >> 8) % 9;
    for i in 0..n {
        let y = x >> (12 + i * 5);
        if y % 6 == 0 {
            put(b, ACCENTED[((y >> 1) % 16) as i64]);
        } else {
            b.push((97 + y % 26) as u8);
        }
    }
}

const CJK_PUNCT: [u32; 6] = [0x3001, 0x3002, 0xff0c, 0xff01, 0x300c, 0x300d];

fn cjk_run(b: &mut Buf, s: &mut u64, x: u64) {
    let n = 4 + (x >> 8) % 20;
    for _ in 0..n {
        put(b, (0x4e00 + next(s) % 0x5200) as u32);
    }
    put(b, CJK_PUNCT[((x >> 16) % 6) as i64]);
}

// Emoji sequences, each ended by 0: presentation, text + VS16, a skin
// tone, a ZWJ family, a flag, a keycap, a ZWJ profession.
const EMOJI: [u32; 26] = [
    0x1f600, 0, 0x1f680, 0, 0x2764, 0xfe0f, 0, 0x1f44d, 0x1f3fd, 0, 0x1f468, 0x200d, 0x1f469,
    0x200d, 0x1f467, 0, 0x1f1eb, 0x1f1f7, 0, 0x33, 0xfe0f, 0x20e3, 0, 0x1f9d1, 0x200d, 0x1f4bb,
];
const EMOJI_STARTS: [i64; 7] = [0, 2, 4, 7, 10, 16, 19];

fn emoji(b: &mut Buf, x: u64) {
    let k = ((x >> 8) % 8) as i64;
    if k == 7 {
        // (a face of the emoticons block)
        put(b, (0x1f600 + (x >> 16) % 0x50) as u32);
        return;
    }
    let mut i = if k == 6 { 23 } else { EMOJI_STARTS[k] };
    while i < 26 && EMOJI[i] != 0 {
        put(b, EMOJI[i]);
        i += 1;
    }
}

// Text of kind k into b.
pub fn make(k: i64, b: &mut Buf) {
    let mut s: u64 = 0x9e3779b97f4a7c15 ^ ((k as u64 + 1) * 0x2545f4914f6cdd1d);
    let mut col = 0;
    while b.len() < SIZE {
        let x = next(&mut s);
        let start = b.len();
        if k == 0 {
            let t = x % 10;
            if t < 6 {
                word(b, x);
            } else if t == 6 {
                b.push_str("(x, 1);");
            } else if t == 7 {
                b.push_str("{ }");
            } else if t == 8 {
                b.push_str("= 0");
            } else {
                b.push_str("\n    ");
                col = 0;
            }
        } else if k == 1 {
            latin_word(b, x);
        } else if k == 2 {
            cjk_run(b, &mut s, x);
        } else if k == 3 {
            if x % 4 == 0 { emoji(b, x); } else { word(b, x); }
        } else {
            let t = x % 100;
            if t < 50 {
                word(b, x);
            } else if t < 62 {
                latin_word(b, x);
            } else if t < 68 {
                for i in 0..3 + (x >> 8) % 6 { put(b, (0x430 + (x >> (12 + i * 5)) % 32) as u32); }
            } else if t < 72 {
                for i in 0..3 + (x >> 8) % 6 { put(b, (0x3b1 + (x >> (12 + i * 5)) % 25) as u32); }
            } else if t < 80 {
                cjk_run(b, &mut s, x);
            } else if t < 85 {
                put(b, (0xac00 + (x >> 8) % 11172) as u32);
                put(b, (0x1100 + (x >> 24) % 19) as u32);
                put(b, (0x1161 + (x >> 32) % 21) as u32);
                put(b, (0x11a8 + (x >> 40) % 27) as u32);
            } else if t < 90 {
                put(b, (0x915 + (x >> 8) % 32) as u32);
                put(b, 0x94d);
                put(b, (0x915 + (x >> 16) % 32) as u32);
                put(b, (0x93e + (x >> 24) % 10) as u32);
            } else if t < 95 {
                b.push('e');
                put(b, (0x300 + (x >> 8) % 0x30) as u32);
            } else {
                emoji(b, x);
            }
        }
        col += b.len() - start;
        if k != 0 {
            if col > 60 + ((x >> 56) % 20) as i64 {
                b.push('\n');
                col = 0;
            } else if k != 2 {
                b.push(' ');
            }
        } else if col > 0 {
            b.push(' ');
        }
    }
    b.push_str("\n\n\n\n");
}

// The benchmark: for each kind of `kinds`, its text, then op over it
// REPS times (rep r on all but its last r % 4 bytes); prints `KIND SUM`
// (the results' wrapping sum) on stdout, and the fastest rep's speed on
// stderr: `NAME KIND: MB/s` (bench/std/run.sh times the whole program).
pub fn run<F: Fn([u8]) -> u64>(name: [u8], kinds: [i64], op: F, gpa: Gpa) -> i32 {
    let reps = 10;
    for j in 0..kinds.len {
        let k = kinds[j];
        let mut b = Buf::with_capacity_in(SIZE + 1024, gpa);
        make(k, &mut b);
        let s = b.as_slice();
        let mut sum: u64 = 0;
        let mut best = 1e30;
        for r in 0..reps {
            let v = s[0..s.len - r % 4];
            let t0 = std::time::monotonic_now().as_secs_f64();
            let x = op(v);
            let dt = std::time::monotonic_now().as_secs_f64() - t0;
            sum += x;
            if dt < best {
                best = dt;
            }
        }
        println(f"{kind_name(k)} {sum}");
        eprintln(f"{name} {kind_name(k)}: {(s.len as f64 / best / 1e6):.0} MB/s");
    }
    0
}
