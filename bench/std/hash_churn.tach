// bench/std: HashMap<u64, u64> churn, 10,000,000 operations on about
// 100,000 keys: the i-th random key inserted, the key inserted 100,000
// operations before removed (erased buckets pile up, the table rehashes
// in place). Prints the entries left, the removals and the sum of the
// values removed.
use std::collections::HashMap;

fn next(s: &mut u64) -> u64 {
    let mut x = *s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    *s = x;
    x
}

fn main(gpa: Gpa) -> i32 {
    let ops = 10000000;
    let lag = 100000;
    let mut ins = 0x9E3779B97F4A7C15u64;
    let mut del = ins;
    let mut m: HashMap<u64, u64> = HashMap::new_in(gpa);
    let mut removed = 0;
    let mut sum = 0u64;
    for i in 0..ops / 2 {
        m.insert(next(&mut ins), i as u64);
        if i >= lag {
            match m.remove(next(&mut del)) {
                Some(v) => {
                    removed += 1;
                    sum += v;
                }
                None => {}
            }
        }
    }
    println(f"{m.len()} {removed} {sum}");
    0
}
