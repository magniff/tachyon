// bench/std graphemes (0.20 A5): the number of grapheme clusters plus the
// sum of their byte lengths squared, over ASCII, mixed and emoji-heavy
// text (text_gen.tach): std::unicode::graphemes. Rust:
// unicode-segmentation's graphemes(true) (no C baseline).
mod text_gen;

use std::unicode::graphemes;

fn main(gpa: Gpa) -> i32 {
    text_gen::run("graphemes", [0, 4, 3][..], |s| {
        graphemes(s).fold(0u64, |r, g| r + 1 + (g.len * g.len) as u64)
    }, gpa)
}
