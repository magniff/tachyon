// bench/std: read a 256 MB file of text lines (made first, untimed, by
// `read_lines --make PATH`: random ASCII lines of 0 to 120 bytes) with
// BufReader::read_line into one String. Prints the lines, their bytes
// (each '\n' included) and the sum of each line's first byte.
// bench-std: data
use std::{env, io};
use std::fs::File;
use std::io::{BufReader, BufWriter, Write};

fn next(s: &mut u64) -> u64 {
    let mut x = *s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    *s = x;
    x
}

// The input: 256 MB of lines.
fn make(path: [u8]) -> io::Result<()> {
    let mut w = BufWriter::new(File::create(path)?);
    let mut st = 0x9E3779B97F4A7C15u64;
    let mut total = 0;
    let mut line: [u8; 128] = [0; 128];
    while total < 256 * 1024 * 1024 {
        let r = next(&mut st);
        let len = (r % 121) as i64;
        for j in 0..len {
            line[j] = 32 + ((r >> (j % 50)) + j as u64) as u8 % 95;
        }
        line[len] = '\n';
        w.write_all(line[..len + 1])?;
        total += len + 1;
    }
    w.flush()
}

fn read(path: [u8], gpa: Gpa) -> io::Result<()> {
    let mut r = BufReader::new(File::open(path)?);
    let mut line = String::new_in(gpa);
    let mut lines = 0;
    let mut bytes = 0;
    let mut first = 0;
    loop {
        line.clear();
        let n = r.read_line(&mut line)?;
        if n == 0 {
            break;
        }
        lines += 1;
        bytes += n;
        first += line.as_bytes()[0] as i64;
    }
    println(f"{lines} {bytes} {first}");
    Ok(())
}

fn main(gpa: Gpa) -> i32 {
    let args: Vec<str> = env::args().collect_in(gpa);
    let r = if args.len() == 3 && args[1] == "--make" { make(args[2]) }
        else if args.len() == 2 { read(args[1], gpa) }
        else { println("usage: read_lines [--make] PATH"); return 2; };
    match r {
        Ok(_) => 0,
        Err(e) => {
            eprintln(f"read_lines: {e}");
            1
        }
    }
}
