// bench/std: sort 5,000,000 random u64 (xorshift64), stable
// (std::sort_stable_in, a merge sort; Rust: sort; C: mergesort). Prints
// a checksum of the sorted values.
fn next(s: &mut u64) -> u64 {
    let mut x = *s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    *s = x;
    x
}

fn main(gpa: Gpa) -> i32 {
    let n = 5000000;
    let mut st = 0x9E3779B97F4A7C15u64;
    let mut v: Vec<u64> = Vec::with_capacity_in(n, gpa);
    for _ in 0..n {
        v.push(next(&mut st));
    }
    std::sort_stable_in(v.as_mut_slice(), gpa);
    let s = v.as_slice();
    let mut sum = 0u64;
    for i in 0..n {
        sum = sum * 31u64 + s[i];
    }
    println(f"{sum}");
    0
}
