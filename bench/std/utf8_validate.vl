// bench/std utf8_validate (0.20 A4, D2): std::str::validate_utf8 over 16 MB
// of each kind of text (text_gen.vl); the result is the valid length.
// Rust: std::str::from_utf8.
mod text_gen;

use std::str::validate_utf8;

fn main(gpa: Gpa) -> i32 {
    text_gen::run("utf8_validate", [0, 1, 2, 3][..], |s| match validate_utf8(s) {
        Ok(()) => s.len as u64,
        Err(e) => e.valid_up_to() as u64,
    }, gpa)
}
