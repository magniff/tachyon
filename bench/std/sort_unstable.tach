// bench/std: sort 5,000,000 random u64 (xorshift64), not stable
// (std::sort, ipnsort since 0.20; Rust: sort_unstable; C: qsort). Prints a
// checksum of the sorted values.
fn next(s: inout u64) -> u64 {
    var x = s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    s = x;
    x
}

fn main(gpa: Gpa) -> i32 {
    let n = 5000000;
    var st = 0x9E3779B97F4A7C15u64;
    var v: Vec<u64> = Vec::with_capacity_in(n, gpa);
    for _ in 0..n {
        v.push(next(&st));
    }
    std::sort(v.as_mut_slice());
    let s = v.as_slice();
    var sum = 0u64;
    for i in 0..n {
        sum = sum * 31u64 + s[i];
    }
    println(f"{sum}");
    0
}
