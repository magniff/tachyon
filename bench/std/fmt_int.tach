// bench/std: Display of 10,000,000 random i64 (random magnitude and sign)
// into one Buf, a space after each, cleared every 64 KB. Prints the length
// written and the FNV-1a hash.
fn next(s: inout u64) -> u64 {
    var x = s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    s = x;
    x
}

fn hash(h: u64, s: [u8]) -> u64 {
    var x = h;
    for i in 0..s.len {
        x = (x ^ s[i] as u64) * 0x100000001b3u64;
    }
    x
}

fn main(gpa: Gpa) -> i32 {
    let n = 10000000;
    var st = 0x9E3779B97F4A7C15u64;
    var out = Buf::with_capacity_in(1 << 17, gpa);
    var h = 0xcbf29ce484222325u64;
    var total = 0;
    for _ in 0..n {
        let r = next(&st);
        let v0 = (r >> (r & 63)) as i64;
        let v = if (r & 64) != 0 { 0 - v0 } else { v0 };
        out.push_fmt(f"{v} ");
        if out.len() > 65536 {
            h = hash(h, out.as_slice());
            total += out.len();
            out.clear();
        }
    }
    h = hash(h, out.as_slice());
    total += out.len();
    println(f"{total} {h}");
    0
}
