// bench/std rng (0.20, A7): std's xoshiro256++ (Xoshiro256pp): 10^9
// next_u64, then 10^8 random_range_u64 over ranges of 1 to 1024 values
// (Lemire's method); the outputs summed. rng.rs and rng.c are the same
// algorithm in Rust and C; all three print the same sums.
use std::random::Xoshiro256pp;

fn main() -> i32 {
    let mut r = Xoshiro256pp::seed_from_u64(20201016);
    let mut sum = 0u64;
    for _ in 0..1000000000 {
        sum = sum + r.next_u64();
    }
    let mut sum2 = 0u64;
    for i in 0..100000000 {
        sum2 = sum2 + r.random_range_u64(0, ((i & 1023) + 1) as u64);
    }
    println(f"{sum} {sum2}");
    0
}
