// bench/std chars (0.20 A4): the number of code points plus their sum, over
// source-like ASCII and mixed text (text_gen.vl): std::str::count_chars
// and code_points. Rust: s.chars().count() and the chars' sum; C: a
// decode loop by hand.
mod text_gen;

use std::str::{code_points, count_chars};

fn main(gpa: Gpa) -> i32 {
    text_gen::run("chars", [0, 4][..], |s| {
        let n = count_chars(s) as u64;
        n + code_points(s).fold(0u64, |a, c| a + c as u64)
    }, gpa)
}
