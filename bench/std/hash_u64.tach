// bench/std: HashMap<u64, u64>, 2,000,000 inserts of random u64
// (xorshift64), then 2,000,000 lookups (half hits). Prints how many were
// found, the sum of their values and the map's length.
use std::collections::HashMap;

fn next(s: &mut u64) -> u64 {
    let mut x = *s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    *s = x;
    x
}

fn main(gpa: Gpa) -> i32 {
    let n = 2000000;
    let mut st = 0x9E3779B97F4A7C15u64;
    let mut keys: Vec<u64> = Vec::with_capacity_in(n, gpa);
    let mut m: HashMap<u64, u64> = HashMap::new_in(gpa);
    for i in 0..n {
        let k = next(&mut st);
        keys.push(k);
        m.insert(k, i as u64);
    }
    let mut found = 0u64;
    let mut sum = 0u64;
    for i in 0..n {
        let k = if i % 2 == 0 { keys[i] } else { next(&mut st) };
        match m.get(k) {
            Some(v) => {
                found += 1u64;
                sum += v;
            }
            None => {}
        }
    }
    println(f"{found} {sum} {m.len()}");
    0
}
