// bench/std: read a 256 MB file of text lines (made first, untimed, by
// `read_lines --make PATH`: random ASCII lines of 0 to 120 bytes) with
// BufReader::read_line into one String. Prints the lines, their bytes
// (each '\n' included) and the sum of each line's first byte.
// bench-std: data
use std::{env, io};
use std::cli::{Arg, Command};
use std::fs::File;
use std::io::{BufReader, BufWriter, Write};

fn next(s: inout u64) -> u64 {
    var x = s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    s = x;
    x
}

// The input: 256 MB of lines.
fn make(path: [u8]) -> io::Result<()> {
    var w = BufWriter::new(File::create(path)?);
    var st = 0x9E3779B97F4A7C15u64;
    var total = 0;
    var line: [u8; 128] = [0; 128];
    while total < 256 * 1024 * 1024 {
        let r = next(&st);
        let len = (r % 121) as i64;
        for j in 0..len {
            line[j] = 32 + ((r >> (j % 50)) + j as u64) as u8 % 95;
        }
        line[len] = '\n';
        w.write_all(line[..len + 1])?;
        total += len + 1;
    }
    w.flush()
}

fn read(path: [u8], gpa: Gpa) -> io::Result<()> {
    var r = BufReader::new(File::open(path)?);
    var line = String::new_in(gpa);
    var lines = 0;
    var bytes = 0;
    var first = 0;
    loop {
        line.clear();
        let n = r.read_line(&line)?;
        if n == 0 {
            break;
        }
        lines += 1;
        bytes += n;
        first += line.as_bytes()[0] as i64;
    }
    println(f"{lines} {bytes} {first}");
    Ok(())
}

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("read_lines", gpa)
        .about("read a file of text lines with BufReader::read_line")
        .arg(Arg::flag("make").help("write the 256 MB input there instead (untimed)"))
        .arg(Arg::positional("path").required());
    let m = cmd.parse_or_exit(env::args());
    // (required: parse_or_exit has said so when it is missing)
    let path = m.get("path").unwrap();
    let r = if m.flag("make") { make(path) } else { read(path, gpa) };
    match r {
        Ok(_) => 0,
        Err(e) => {
            eprintln(f"read_lines: {e}");
            1
        }
    }
}
