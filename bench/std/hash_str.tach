// bench/std: word count, 4,000,000 pseudo-random words (about 20 MB of
// text, skewed toward short frequent words) counted in a
// HashMap<[u8], u64> keyed by slices of the text. Prints the distinct
// words, the words, and the sum of the counts' squares.
use std::collections::HashMap;

fn next(s: inout u64) -> u64 {
    var x = s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    s = x;
    x
}

fn main(gpa: Gpa) -> i32 {
    let words = 4000000;
    var st = 0x9E3779B97F4A7C15u64;
    var text: Vec<u8> = Vec::with_capacity_in(words * 6, gpa);
    for _ in 0..words {
        let a = next(&st) % 4096u64;
        let b = next(&st) % 4096u64;
        var id = a * b / 64u64;
        loop {
            text.push('a' + (id % 26u64) as u8);
            id = id / 26u64;
            if id == 0u64 {
                break;
            }
        }
        text.push(' ');
    }
    let s = text.as_slice();
    var counts: HashMap<[u8], u64> = HashMap::new_in(gpa);
    var total = 0u64;
    var i = 0;
    while i < s.len {
        let start = i;
        while s[i] != ' ' {
            i += 1;
        }
        counts.get_or_insert(s[start..i], 0u64)[0] += 1u64;
        total += 1u64;
        i += 1;
    }
    var squares = 0u64;
    for (_, c) in counts.iter() {
        squares += c * c;
    }
    println(f"{counts.len()} {total} {squares}");
    0
}
