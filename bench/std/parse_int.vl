// bench/std: parse 10,000,000 decimal i64 texts (random magnitude and
// sign, made first, in one Buf) with parse_int, three times. Prints the
// count and the sum (a text out of range counts 0).
fn next(s: inout u64) -> u64 {
    var x = s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    s = x;
    x
}

fn main(gpa: Gpa) -> i32 {
    let n = 10000000;
    var st = 0x9E3779B97F4A7C15u64;
    var text = Buf::with_capacity_in(n * 21, gpa);
    for _ in 0..n {
        let r = next(&st);
        var m = r >> (r & 63);
        if (r & 64) != 0 {
            text.push('-');
        }
        var d: [u8; 20] = [0; 20];
        var k = 20;
        loop {
            k -= 1;
            d[k] = '0' + (m % 10) as u8;
            m = m / 10;
            if m == 0 {
                break;
            }
        }
        text.push_str(d[k..20]);
        text.push(' ');
    }
    let s = text.as_slice();
    var sum: i64 = 0;
    var count = 0;
    for _ in 0..3 {
        var start = 0;
        for i in 0..s.len {
            if s[i] == ' ' {
                sum += parse_int(s[start..i]).unwrap_or(0);
                count += 1;
                start = i + 1;
            }
        }
    }
    println(f"{count} {sum}");
    0
}
