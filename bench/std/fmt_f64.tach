// bench/std: Display of 1,000,000 random f64 (in [0, 1e6), every
// mantissa bit random) into one Buf, a space after each. Prints the
// text's length and its FNV-1a hash.
fn next(s: &mut u64) -> u64 {
    let mut x = *s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    *s = x;
    x
}

fn main(gpa: Gpa) -> i32 {
    let n = 1000000;
    let mut st = 0x9E3779B97F4A7C15u64;
    let mut out = Buf::with_capacity_in(n * 20, gpa);
    for _ in 0..n {
        let x = (next(&mut st) >> 11) as f64 * (1.0 / 9007199254740992.0) * 1000000.0;
        out.push_fmt(x);
        out.push(' ');
    }
    let s = out.as_slice();
    let mut h = 0xcbf29ce484222325u64;
    for i in 0..s.len {
        h = (h ^ s[i] as u64) * 0x100000001b3u64;
    }
    println(f"{s.len} {h}");
    0
}
