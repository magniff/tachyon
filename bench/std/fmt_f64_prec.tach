// bench/std: `{:.3}` of 1,000,000 random f64 (in [0, 1e6)) into one Buf,
// a space after each. Prints the length and the FNV-1a hash.
fn next(s: inout u64) -> u64 {
    var x = s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    s = x;
    x
}

fn main(gpa: Gpa) -> i32 {
    let n = 1000000;
    var st = 0x9E3779B97F4A7C15u64;
    var out = Buf::with_capacity_in(n * 16, gpa);
    for _ in 0..n {
        let x = (next(&st) >> 11) as f64 * (1.0 / 9007199254740992.0) * 1000000.0;
        out.push_fmt(f"{x:.3} ");
    }
    let s = out.as_slice();
    var h = 0xcbf29ce484222325u64;
    for i in 0..s.len {
        h = (h ^ s[i] as u64) * 0x100000001b3u64;
    }
    println(f"{s.len} {h}");
    0
}
