// bench/std width (0.20 A5, D2): the display width of ASCII and CJK text
// (text_gen.vl), code point by code point: std::unicode::str_width_chars.
// Rust: unicode-width's char widths summed (`rust:str`: its str width,
// with its ligature rules: another number); C: mbrtowc and wcwidth.
mod text_gen;

use std::unicode::str_width_chars;

fn main(gpa: Gpa) -> i32 {
    text_gen::run("width", [0, 2][..], |s| str_width_chars(s) as u64, gpa)
}
