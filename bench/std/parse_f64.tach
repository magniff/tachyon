use std::num::{f64_to_bits, parse_f64};

// bench/std: parse 1,000,000 float texts `d.ddddddddddddddddeX` (17 random
// digits, the exponent in [-300, 300]: the shape of a shortest f64) with
// std::num::parse_f64, the texts made first, in one Buf, five times. Prints the
// count and the FNV-1a hash of the bits read.
fn next(s: inout u64) -> u64 {
    var x = s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    s = x;
    x
}

fn main(gpa: Gpa) -> i32 {
    let n = 1000000;
    var st = 0x9E3779B97F4A7C15u64;
    var text = Buf::with_capacity_in(n * 24, gpa);
    for _ in 0..n {
        var m = next(&st) % 100000000000000000;
        var d: [u8; 17] = [0; 17];
        for k in 0..17 {
            d[16 - k] = '0' + (m % 10) as u8;
            m = m / 10;
        }
        text.push(d[0]);
        text.push('.');
        text.push_str(d[1..17]);
        let e = (next(&st) % 601) as i64 - 300;
        text.push_fmt(f"e{e} ");
    }
    let s = text.as_slice();
    var h = 0xcbf29ce484222325u64;
    var count = 0;
    for _ in 0..5 {
        var start = 0;
        for i in 0..s.len {
            if s[i] == ' ' {
                let v = parse_f64(s[start..i]).unwrap();
                h = (h ^ f64_to_bits(v)) * 0x100000001b3u64;
                count += 1;
                start = i + 1;
            }
        }
    }
    println(f"{count} {h}");
    0
}
