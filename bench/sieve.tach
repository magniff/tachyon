// Sieve of Eratosthenes up to 30,000,000: the number of primes.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn calloc(count: u64, size: u64) -> *u8;
}

fn count_primes(limit: i64) -> i64 {
    let composite = unsafe { calloc(limit as u64 + 1, 1) };
    var count = 0;
    var i = 2;
    while i <= limit {
        if unsafe { composite[i] == 0 } {
            count += 1;
            var j = i * i;
            while j <= limit {
                unsafe { composite[j] = 1; }
                j += i;
            }
        }
        i += 1;
    }
    count
}

fn main() -> i32 {
    unsafe { printf(c"%ld\n", count_primes(30000000)); }
    0
}
