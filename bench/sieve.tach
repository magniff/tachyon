// Sieve of Eratosthenes up to 30,000,000: the number of primes.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn calloc(count: u64, size: u64) -> *u8;
}

fn count_primes(limit: i64) -> i64 {
    let composite = calloc(limit as u64 + 1, 1);
    let mut count = 0;
    let mut i = 2;
    while i <= limit {
        if composite[i] == 0 {
            count += 1;
            let mut j = i * i;
            while j <= limit {
                composite[j] = 1;
                j += i;
            }
        }
        i += 1;
    }
    count
}

fn main() -> i32 {
    printf(c"%ld\n", count_primes(30000000));
    0
}
