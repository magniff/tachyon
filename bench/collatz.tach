// The longest Collatz chain starting below 3,000,000.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn steps(start: u64) -> i64 {
    let mut n = start;
    let mut count = 0;
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        count += 1;
    }
    count
}

fn main() -> i32 {
    let mut best = 0;
    let mut best_start: u64 = 1;
    for start in 1..3000000u64 {
        let s = steps(start);
        if s > best {
            best = s;
            best_start = start;
        }
    }
    unsafe { printf(c"%lu %ld\n", best_start, best); }
    0
}
