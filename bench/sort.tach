// Sorting: std::sort (an introsort) of 1,000,000 pseudo-random integers,
// then of 200,000 records by key; the results checked and summed.
use std::{Ord, Vec, sort};

extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct Rec { key: i64, id: i64 }

impl Ord for Rec {
    fn cmp(self: &Rec, other: &Rec) -> i64 {
        if self.key < other.key {
            -1
        } else if self.key > other.key {
            1
        } else if self.id < other.id {
            -1
        } else if self.id > other.id {
            1
        } else {
            0
        }
    }
}

fn next(state: &mut u64) -> u64 {
    *state = *state * 6364136223846793005u64 + 1442695040888963407u64;
    *state >> 17
}

fn main(gpa: Gpa) -> i32 {
    let mut state = 42u64;
    let n = 1000000;
    let mut v: Vec<i64> = Vec::with_capacity_in(n, gpa);
    for _ in 0..n {
        v.push(next(&mut state) as i64);
    }
    let s = v.as_slice();
    sort::<i64>(s);
    let mut sum = 0u64;
    let mut sorted = true;
    for i in 0..n {
        sum = sum * 31u64 + s[i] as u64;
        if i > 0 && s[i - 1] > s[i] {
            sorted = false;
        }
    }
    unsafe { printf(c"%d %lu\n", sorted as i32, sum); }

    let m = 200000;
    let mut r: Vec<Rec> = Vec::with_capacity_in(m, gpa);
    for i in 0..m {
        r.push(Rec { key: (next(&mut state) % 1000u64) as i64, id: i });
    }
    let t = r.as_slice();
    sort::<Rec>(t);
    let mut sum2 = 0u64;
    for i in 0..m {
        sum2 = sum2 * 31u64 + (t[i].key * 1000003 + t[i].id) as u64;
    }
    unsafe { printf(c"%lu\n", sum2); }
    v.free();
    r.free();
    0
}
