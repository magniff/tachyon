// Word counting: 3,000,000 pseudo-random words (about 17 MB of text,
// skewed toward short, frequent words) split and counted in a
// std::HashMap<[u8], i64> keyed by slices of the text.
use std::{Hash, HashMap, Option, Vec};

extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn next(state: &mut u64) -> u64 {
    *state = *state * 6364136223846793005u64 + 1442695040888963407u64;
    *state >> 33
}

fn is_letter(c: u8) -> bool {
    c >= 'a' && c <= 'z'
}

fn main(gpa: Gpa) -> i32 {
    let mut text: Vec<u8> = Vec::new_in(gpa);
    let mut state = 7u64;
    let words = 3000000;
    for w in 0..words {
        let a = next(&mut state) % 4096u64;
        let b = next(&mut state) % 4096u64;
        let mut id = a * b / 64u64;
        loop {
            text.push('a' + (id % 26u64) as u8);
            id = id / 26u64;
            if id == 0u64 {
                break;
            }
        }
        text.push(if w % 12 == 11 { '\n' } else { ' ' });
    }

    let s = text.as_slice();
    let n = s.len;
    let mut counts: HashMap<[u8], i64> = HashMap::new_in(gpa);
    let mut total = 0;
    let mut i = 0;
    while i < n {
        while i < n && !is_letter(s[i]) {
            i += 1;
        }
        let start = i;
        while i < n && is_letter(s[i]) {
            i += 1;
        }
        if i > start {
            let w = s[start..i];
            let c = counts.get(w).unwrap_or(0);
            counts.insert(w, c + 1);
            total += 1;
        }
    }

    let mut best: [u8] = "";
    let mut best_count = 0;
    let mut checksum = 0u64;
    for slot in 0..counts.slots() {
        match counts.key_at(slot) {
            Option::Some(w) => {
                let c = counts.get(w).unwrap();
                checksum += (c as u64) * w.hash();
                if c > best_count || (c == best_count && w < best) {
                    best = w;
                    best_count = c;
                }
            }
            Option::None => {}
        }
    }
    unsafe {
        printf(c"%ld words, %ld distinct, checksum %lu\n", total, counts.len(), checksum);
        printf(c"most frequent: %.*s (%ld)\n", best.len as i32, best.ptr, best_count);
    }
    counts.free();
    text.free();
    0
}
