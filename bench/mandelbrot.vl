// The Mandelbrot set of the benchmarks game on a 2400 x 2400 grid, at most
// 50 iterations a point: a float loop with an early exit; the bitmap's
// bytes are hashed instead of printed.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i32 {
    let n = 2400;
    var inside = 0;
    var hash = 14695981039346656037u64;
    for y in 0..n {
        let ci = 2.0 * (y as f64) / (n as f64) - 1.0;
        var bits = 0u64;
        for x in 0..n {
            let cr = 2.0 * (x as f64) / (n as f64) - 1.5;
            var zr = 0.0;
            var zi = 0.0;
            var tr = 0.0;
            var ti = 0.0;
            var i = 0;
            while i < 50 && tr + ti <= 4.0 {
                zi = 2.0 * zr * zi + ci;
                zr = tr - ti + cr;
                tr = zr * zr;
                ti = zi * zi;
                i += 1;
            }
            bits = bits << 1;
            if tr + ti <= 4.0 {
                bits = bits | 1;
                inside += 1;
            }
            if x % 8 == 7 {
                hash = (hash ^ bits) * 1099511628211u64;
                bits = 0;
            }
        }
    }
    unsafe { printf(c"%ld %lu\n", inside, hash); }
    0
}
