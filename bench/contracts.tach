// contracts (0.18.1): do checked contracts make the code faster? Four
// kernels over Vec<i64> whose clauses give the range analysis facts:
// bench/contracts_plain.tach is the same program without the clauses
// (docs/optimizer.md, "Contracts and generated code: the evidence").
// With an argument K (1-4) only kernel K runs; with none, all four.
//
// 1 prefix: `requires n <= v.len()` on a summing loop to n;
// 2 window: a helper reading v[i..i + 4] called in a hot loop, whose
//   requires states the window is inside v;
// 3 bucket: a hash helper whose ensures bounds its result by n, the
//   length of the table the caller indexes;
// 4 dot: a dot product whose requires says both vectors are as long.

fn sum_prefix(v: Vec<i64>, n: i64) -> i64
    requires 0 <= n && n <= v.len()
{
    var s = 0;
    for i in 0..n {
        s += v[i];
    }
    s
}

fn weigh(v: Vec<i64>, i: i64) -> i64
    requires 0 <= i && i + 4 <= v.len()
{
    v[i] + 2 * v[i + 1] + 3 * v[i + 2] + 4 * v[i + 3]
}

fn bucket(x: u64, n: i64) -> i64
    requires n > 0
    ensures 0 <= result && result < n
{
    var h = x ^ (x >> 31);
    h = h * 0x7fb5d329728ea185;
    h = h ^ (h >> 27);
    (h % (n as u64)) as i64
}

fn dot(a: Vec<i64>, b: Vec<i64>) -> i64
    requires a.len() == b.len()
{
    var s = 0;
    for i in 0..a.len() {
        s += a[i] * b[i];
    }
    s
}

fn prefix(v: Vec<i64>) -> i64 {
    var t = 0;
    for r in 0..40000 {
        t += sum_prefix(v, v.len() - (r & 63));
    }
    t
}

fn window(v: Vec<i64>) -> i64 {
    var t = 0;
    for _ in 0..20000 {
        for i in 0..v.len() - 3 {
            t += weigh(v, i);
        }
    }
    t
}

fn buckets(gpa: Gpa) -> i64 {
    var counts: Vec<i64> = Vec::new_in(gpa);
    for _ in 0..1021 {
        counts.push(0);
    }
    var x: u64 = 1;
    for _ in 0..60000000 {
        x = x * 6364136223846793005 + 1442695040888963407;
        let b = bucket(x, counts.len());
        counts[b] += 1;
    }
    var t = 0;
    for i in 0..counts.len() {
        t = t * 31 + counts[i];
    }
    t
}

fn dots(v: Vec<i64>, w: Vec<i64>) -> i64 {
    var t = 0;
    for r in 0..40000 {
        t += dot(v, w) ^ r;
    }
    t
}

fn main(gpa: Gpa, argc: i64, argv: **u8) -> i32 {
    let k = if argc > 1 { unsafe { argv[1][0] as i64 - 48 } } else { 0 };
    var v: Vec<i64> = Vec::new_in(gpa);
    var w: Vec<i64> = Vec::new_in(gpa);
    var x: u64 = 7;
    for _ in 0..4096 {
        x = x * 6364136223846793005 + 1442695040888963407;
        v.push((x >> 40) as i64);
        w.push((x >> 50) as i64);
    }
    if k == 0 || k == 1 {
        println(f"prefix {prefix(v)}");
    }
    if k == 0 || k == 2 {
        println(f"window {window(v)}");
    }
    if k == 0 || k == 3 {
        println(f"bucket {buckets(gpa)}");
    }
    if k == 0 || k == 4 {
        println(f"dot {dots(v, w)}");
    }
    0
}
