// A bytecode interpreter: an enum of instructions with fields, dispatched
// by match, on a struct with methods. The program counts the primes below
// 150000 by trial division.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

enum Op {
    Push(i64),
    Load(u64),
    Store(u64),
    Add,
    Mul,
    Rem,
    Lt,
    JumpIfZero(u64),
    Jump(u64),
    Halt,
}

struct Vm { stack: [i64; 16], sp: u64, regs: [i64; 4] }

impl Vm {
    fn push(self: &mut Vm, v: i64) {
        self.stack[self.sp] = v;
        self.sp += 1;
    }

    fn pop(self: &mut Vm) -> i64 {
        self.sp -= 1;
        self.stack[self.sp]
    }

    fn run(self: &mut Vm, code: [Op]) {
        let mut pc: u64 = 0;
        loop {
            match code[pc] {
                Op::Push(v) => self.push(v),
                Op::Load(r) => {
                    let v = self.regs[r];
                    self.push(v);
                }
                Op::Store(r) => {
                    let v = self.pop();
                    self.regs[r] = v;
                }
                Op::Add => {
                    let b = self.pop();
                    let a = self.pop();
                    self.push(a + b);
                }
                Op::Mul => {
                    let b = self.pop();
                    let a = self.pop();
                    self.push(a * b);
                }
                Op::Rem => {
                    let b = self.pop();
                    let a = self.pop();
                    self.push(a % b);
                }
                Op::Lt => {
                    let b = self.pop();
                    let a = self.pop();
                    self.push((a < b) as i64);
                }
                Op::JumpIfZero(t) => {
                    if self.pop() == 0 {
                        pc = t;
                        continue;
                    }
                }
                Op::Jump(t) => {
                    pc = t;
                    continue;
                }
                Op::Halt => return,
            }
            pc += 1;
        }
    }
}

fn main() -> i32 {
    // r0: n, r1: the count, r2: the divisor.
    let code: [Op; 36] = [
        Op::Push(2), Op::Store(0), Op::Push(0), Op::Store(1),
        Op::Load(0), Op::Push(150000), Op::Lt, Op::JumpIfZero(35),
        Op::Push(2), Op::Store(2),
        Op::Load(0), Op::Load(2), Op::Load(2), Op::Mul, Op::Lt, Op::JumpIfZero(17),
        Op::Jump(26),
        Op::Load(0), Op::Load(2), Op::Rem, Op::JumpIfZero(30),
        Op::Load(2), Op::Push(1), Op::Add, Op::Store(2), Op::Jump(10),
        Op::Load(1), Op::Push(1), Op::Add, Op::Store(1),
        Op::Load(0), Op::Push(1), Op::Add, Op::Store(0), Op::Jump(4),
        Op::Halt,
    ];
    let mut vm = Vm { stack: [0; 16], sp: 0, regs: [0; 4] };
    vm.run(code[..]);
    unsafe { printf(c"%ld\n", vm.regs[1]); }
    0
}
