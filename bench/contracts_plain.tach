// contracts_plain (0.18.1): bench/contracts.tach without its requires and
// ensures clauses, to measure what the clauses' facts change (see there).

fn sum_prefix(v: &Vec<i64>, n: i64) -> i64
    {
    let mut s = 0;
    for i in 0..n {
        s += v[i];
    }
    s
}

fn weigh(v: &Vec<i64>, i: i64) -> i64
    {
    v[i] + 2 * v[i + 1] + 3 * v[i + 2] + 4 * v[i + 3]
}

fn bucket(x: u64, n: i64) -> i64
    {
    let mut h = x ^ (x >> 31);
    h = h * 0x7fb5d329728ea185;
    h = h ^ (h >> 27);
    (h % (n as u64)) as i64
}

fn dot(a: &Vec<i64>, b: &Vec<i64>) -> i64
    {
    let mut s = 0;
    for i in 0..a.len() {
        s += a[i] * b[i];
    }
    s
}

fn prefix(v: &Vec<i64>) -> i64 {
    let mut t = 0;
    for r in 0..40000 {
        t += sum_prefix(v, v.len() - (r & 63));
    }
    t
}

fn window(v: &Vec<i64>) -> i64 {
    let mut t = 0;
    for _ in 0..20000 {
        for i in 0..v.len() - 3 {
            t += weigh(v, i);
        }
    }
    t
}

fn buckets(gpa: Gpa) -> i64 {
    let mut counts: Vec<i64> = Vec::new_in(gpa);
    for _ in 0..1021 {
        counts.push(0);
    }
    let mut x: u64 = 1;
    for _ in 0..60000000 {
        x = x * 6364136223846793005 + 1442695040888963407;
        let b = bucket(x, counts.len());
        counts[b] += 1;
    }
    let mut t = 0;
    for i in 0..counts.len() {
        t = t * 31 + counts[i];
    }
    t
}

fn dots(v: &Vec<i64>, w: &Vec<i64>) -> i64 {
    let mut t = 0;
    for r in 0..40000 {
        t += dot(v, w) ^ r;
    }
    t
}

fn main(gpa: Gpa, argc: i64, argv: **u8) -> i32 {
    let k = if argc > 1 { unsafe { argv[1][0] as i64 - 48 } } else { 0 };
    let mut v: Vec<i64> = Vec::new_in(gpa);
    let mut w: Vec<i64> = Vec::new_in(gpa);
    let mut x: u64 = 7;
    for _ in 0..4096 {
        x = x * 6364136223846793005 + 1442695040888963407;
        v.push((x >> 40) as i64);
        w.push((x >> 50) as i64);
    }
    if k == 0 || k == 1 {
        println(f"prefix {prefix(&v)}");
    }
    if k == 0 || k == 2 {
        println(f"window {window(&v)}");
    }
    if k == 0 || k == 3 {
        println(f"bucket {buckets(gpa)}");
    }
    if k == 0 || k == 4 {
        println(f"dot {dots(&v, &w)}");
    }
    0
}
