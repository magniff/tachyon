// A JSON-ish parser: about 24 MB of generated text (nested arrays and
// objects of numbers, strings with escapes and literals) parsed by
// recursive descent, byte by byte; branchy code. Prints what it counted.
use std::Vec;

extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct Gen { out: Vec<u8>, state: u64 }

impl Gen {
    fn next(self: *Gen) -> u64 {
        self.state = self.state * 6364136223846793005u64 + 1442695040888963407u64;
        self.state >> 33
    }

    fn push(self: *Gen, c: u8) {
        self.out.push(c);
    }

    fn number(self: *Gen) {
        let mut v = (self.next() % 200000u64) as i64 - 100000;
        if v < 0 {
            self.push('-');
            v = -v;
        }
        let mut digits: [u8; 20] = [0; 20];
        let mut n = 0;
        loop {
            digits[n] = '0' + (v % 10) as u8;
            n += 1;
            v = v / 10;
            if v == 0 {
                break;
            }
        }
        while n > 0 {
            n -= 1;
            self.push(digits[n]);
        }
    }

    fn string(self: *Gen) {
        self.push('"');
        let len = self.next() % 12u64;
        for _ in 0..len {
            let r = self.next() % 32u64;
            if r == 0u64 {
                self.push('\\');
                self.push('"');
            } else if r == 1u64 {
                self.push('\\');
                self.push('n');
            } else {
                self.push('a' + (r % 26u64) as u8);
            }
        }
        self.push('"');
    }

    fn literal(self: *Gen, w: [u8]) {
        for c in w {
            self.push(c);
        }
    }

    fn value(self: *Gen, depth: i64) {
        let r = if depth >= 6 { self.next() % 6u64 } else { self.next() % 10u64 };
        if r <= 1u64 || r == 5u64 {
            self.number();
        } else if r <= 3u64 {
            self.string();
        } else if r == 4u64 {
            let k = self.next() % 3u64;
            if k == 0u64 {
                self.literal("true");
            } else if k == 1u64 {
                self.literal("false");
            } else {
                self.literal("null");
            }
        } else if r <= 7u64 {
            self.push('[');
            let n = self.next() % 6u64;
            for i in 0..n {
                if i > 0u64 {
                    self.push(',');
                    self.push(' ');
                }
                self.value(depth + 1);
            }
            self.push(']');
        } else {
            self.push('{');
            let n = self.next() % 6u64;
            for i in 0..n {
                if i > 0u64 {
                    self.push(',');
                    self.push(' ');
                }
                self.string();
                self.push(':');
                self.push(' ');
                self.value(depth + 1);
            }
            self.push('}');
        }
    }
}

struct Parser {
    s: [u8], pos: i64,
    values: i64, numbers: i64, sum: i64, strings: i64, chars: i64,
    literals: i64, arrays: i64, objects: i64, max_depth: i64,
}

impl Parser {
    fn peek(self: *Parser) -> u8 {
        if self.pos < self.s.len { self.s[self.pos] } else { 0 }
    }

    fn skip_space(self: *Parser) {
        while self.pos < self.s.len {
            let c = self.s[self.pos];
            if c == ' ' || c == '\n' || c == '\t' || c == '\r' {
                self.pos += 1;
            } else {
                break;
            }
        }
    }

    fn string(self: *Parser) -> bool {
        self.pos += 1;
        loop {
            if self.pos >= self.s.len {
                return false;
            }
            let c = self.s[self.pos];
            self.pos += 1;
            if c == '"' {
                self.strings += 1;
                return true;
            }
            if c == '\\' {
                if self.pos >= self.s.len {
                    return false;
                }
                self.pos += 1;
            }
            self.chars += 1;
        }
    }

    fn number(self: *Parser) -> bool {
        let mut negative = false;
        if self.peek() == '-' {
            negative = true;
            self.pos += 1;
        }
        let start = self.pos;
        let mut v = 0;
        while self.pos < self.s.len {
            let c = self.s[self.pos];
            if c < '0' || c > '9' {
                break;
            }
            v = v * 10 + (c - '0') as i64;
            self.pos += 1;
        }
        if self.pos == start {
            return false;
        }
        self.numbers += 1;
        self.sum += if negative { -v } else { v };
        true
    }

    fn literal(self: *Parser, w: [u8]) -> bool {
        for c in w {
            if self.peek() != c {
                return false;
            }
            self.pos += 1;
        }
        self.literals += 1;
        true
    }

    fn value(self: *Parser, depth: i64) -> bool {
        if depth > self.max_depth {
            self.max_depth = depth;
        }
        self.skip_space();
        let c = self.peek();
        if c == '[' {
            self.arrays += 1;
            self.pos += 1;
            self.skip_space();
            if self.peek() == ']' {
                self.pos += 1;
                return true;
            }
            loop {
                if !self.value(depth + 1) {
                    return false;
                }
                self.skip_space();
                let d = self.peek();
                self.pos += 1;
                if d == ']' {
                    return true;
                }
                if d != ',' {
                    return false;
                }
            }
        }
        if c == '{' {
            self.objects += 1;
            self.pos += 1;
            self.skip_space();
            if self.peek() == '}' {
                self.pos += 1;
                return true;
            }
            loop {
                self.skip_space();
                if self.peek() != '"' || !self.string() {
                    return false;
                }
                self.skip_space();
                if self.peek() != ':' {
                    return false;
                }
                self.pos += 1;
                if !self.value(depth + 1) {
                    return false;
                }
                self.skip_space();
                let d = self.peek();
                self.pos += 1;
                if d == '}' {
                    return true;
                }
                if d != ',' {
                    return false;
                }
            }
        }
        if c == '"' {
            return self.string();
        }
        if c == '-' || (c >= '0' && c <= '9') {
            return self.number();
        }
        if c == 't' {
            return self.literal("true");
        }
        if c == 'f' {
            return self.literal("false");
        }
        if c == 'n' {
            return self.literal("null");
        }
        false
    }
}

fn main() -> i32 {
    let mut g = Gen { out: Vec::new(), state: 12345u64 };
    while g.out.len() < 24000000 {
        g.value(0);
        g.push('\n');
    }
    let mut p = Parser {
        s: g.out.as_slice(), pos: 0,
        values: 0, numbers: 0, sum: 0, strings: 0, chars: 0,
        literals: 0, arrays: 0, objects: 0, max_depth: 0,
    };
    loop {
        p.skip_space();
        if p.pos >= p.s.len {
            break;
        }
        if !p.value(1) {
            unsafe { printf(c"error at %ld\n", p.pos); }
            return 1;
        }
        p.values += 1;
    }
    unsafe {
        printf(c"%ld bytes, %ld values\n", p.s.len, p.values);
        printf(c"%ld numbers (sum %ld), %ld strings (%ld chars), %ld literals\n",
            p.numbers, p.sum, p.strings, p.chars, p.literals);
        printf(c"%ld arrays, %ld objects, depth %ld\n", p.arrays, p.objects, p.max_depth);
    }
    g.out.free();
    0
}
