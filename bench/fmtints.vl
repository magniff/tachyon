// The text of bench/fmtloop.vl made without f-strings: Buf's push_int
// and push_str, hex digits and padding by hand (bench/run.sh prints the
// ratio of the two times).
use std::Buf;

fn push_hex(b: inout Buf, v: u32) {
    let digits = "0123456789abcdef";
    var d: [u8; 8] = [0; 8];
    var n = 8;
    var u = v;
    loop {
        n -= 1;
        d[n] = digits[(u & 15) as i64];
        u = u >> 4;
        if u == 0 {
            break;
        }
    }
    b.push_str(d[n..8]);
}

fn main(gpa: Gpa) {
    var x: u64 = 88172645463325252;
    var b = Buf::new_in(gpa);
    var total = 0;
    for i in 0..1000000 {
        x ^= x << 13;
        x ^= x >> 7;
        x ^= x << 17;
        let k = (x % 2000) as i64 - 1000;
        let h = (x >> 40) as u32;
        b.push_int(i);
        b.push(' ');
        b.push_int(k);
        b.push(' ');
        push_hex(&b, h);
        b.push(' ');
        let m = i * 3 % 7;
        if m < 10 {
            b.push_str("  ");
        } else if m < 100 {
            b.push(' ');
        }
        b.push_int(m);
        b.push_str("|\n");
        if b.len() > 60000 {
            total += b.len();
            b.clear();
        }
    }
    total += b.len();
    print(b.as_slice());
    std::print_int(total);
    println(" bytes");
}
