// tests/debug.sh: a breakpoint on line 13, then a crash there (a store
// through a null pointer), called from line 20, called from line 26.
use crate::helper::total;

mod helper;

#[inline(never)]
fn poke(p: *i64, n: i64) -> i64 {
    let mut s = total(n);
    if s < 0 {
        s = 0;
    }
    unsafe { *p = s; }
    s
}

#[inline(never)]
fn outer(n: i64) -> i64 {
    let q = 0 as *i64;
    let r = unsafe { poke(q, n) };
    r + 1
}

fn main() {
    let n = 5;
    let x = outer(n);
    if x > 100 {
        main();
    }
}
