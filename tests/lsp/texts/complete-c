mod shapes;

use shapes::{Shape, Store, area};

struct Point { x: i64, y: i64 }

impl Point {
    // The point moved right by dx.
    fn moved(self, dx: i64) -> Point {
        Point { x: self.x + dx, y: self.y }
    }

    fn sum(self) -> i64 {
        self.x + self.y
    }
}

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    let p = Point { x: 1, y: 2 };
    var store = Store::new_in(gpa);
    store.add(
    p.moved(1
    Vec::with_capacity_in(4, 
    area(Shape::Square(2)
    Point::moved(p, 
    0
}
