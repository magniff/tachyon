// The program the language server's sessions ask about (tests/lsp).
mod shapes;

use shapes::{Shape, area, collect, total};

fn main(gpa: Gpa) {
    let s = Shape::Square(3);
    let a = aera(s);
    let mut v = collect(gpa, 4);
    v.push(a);
    let label = "größe"; let k = a + 1;
    println(f"{label} {total(&v)} {k}");
}
