// Shapes: a pure function, one that allocates, one that prints.

pub enum Shape {
    Square(i64),
    Rect(i64, i64),
}

#[pure]
pub fn area(s: Shape) -> i64 {
    match s {
        Shape::Square(w) => w * w,
        Shape::Rect(w, h) => w * h,
    }
}

pub fn collect(gpa: Gpa, n: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..n {
        v.push(i);
    }
    v
}

pub fn total(v: Vec<i64>) -> i64 {
    var sum = 0;
    for x in v.iter() {
        sum += x;
    }
    println(f"total {sum}");
    sum
}
