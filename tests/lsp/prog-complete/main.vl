// The program of the completion sessions (tests/lsp/complete.lsp): each
// context completion knows, asked on texts that do not parse
// (tests/lsp/texts/complete-*).
mod shapes;

use shapes::{Shape, Store, area};

struct Point { x: i64, y: i64 }

impl Point {
    // The point moved right by dx.
    fn moved(self, dx: i64) -> Point {
        Point { x: self.x + dx, y: self.y }
    }

    fn sum(self) -> i64 {
        self.x + self.y
    }
}

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let p = Point { x: 1, y: 2 };
    let name = "vole";
    var store = Store::new_in(gpa);
    store.add(p.x);
    let s = Shape::Square(3);
    let total: i64 = area(s) + p.moved(1).sum();
    println(f"{total} {name.len()} {v.len()} {store.count()}");
    0
}
