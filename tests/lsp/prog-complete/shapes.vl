// Shapes, and a store of numbers.

pub enum Shape {
    Square(i64),
    Rect(i64, i64),
}

#[pure]
pub fn area(s: Shape) -> i64 {
    match s {
        Shape::Square(w) => w * w,
        Shape::Rect(w, h) => w * h,
    }
}

pub struct Store {
    pub items: Vec<i64>,
    total: i64,
}

impl Store {
    pub fn new_in(gpa: Gpa) -> Store {
        Store { items: Vec::new_in(gpa), total: 0 }
    }

    pub fn add(inout self, x: i64) {
        self.items.push(x);
        self.total += x;
    }

    pub fn count(self) -> i64 {
        self.items.len()
    }

    // The sum of the items added.
    pub fn sum(self) -> i64 {
        self.total
    }

    fn secret(self) -> i64 {
        0
    }
}
