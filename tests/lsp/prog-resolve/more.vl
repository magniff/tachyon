// More names: a derived method, `into`, an enum's path in a `use`, an
// associated type, a C function's parameter, an attribute's argument, a
// closure bound, `super` and `self`, built-in functions.
use std::convert::From;

#[derive(Clone, Debug)]
pub struct Feet { pub n: i64 }

pub struct Meters { pub n: i64 }

impl From<Feet> for Meters {
    fn from(f: Feet) -> Meters { Meters { n: f.n * 3 / 10 } }
}

pub enum Tok { Num(i64), Plus }
use Tok::{Num, Plus};

pub trait Measure {
    type Output;
    fn measure(self) -> Self::Output;
}

impl Measure for Feet {
    type Output = Meters;
    fn measure(self) -> Meters { self.into() }
}

extern "C" {
    fn abs(x: i32) -> i32;
}

#[repr(C)]
pub struct Pair { a: i32, b: i32 }

fn twice<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 { f(f(x)) }

mod inner {
    use super::Tok;
    pub fn count(s: [u8]) -> i64 { s.len() + size_of(Tok) as i64 * 0 }
    pub fn again(s: [u8]) -> i64 { self::count(s) }
}

pub fn run() -> i64 {
    let f = Feet { n: 10 };
    let g = f.clone();
    let m: Meters = g.into();
    let t = Num(1);
    let k = match t { Num(v) => v, Plus => 0 };
    let o = f.measure();
    let c = unsafe { abs(-3) } as i64;
    m.n + k + o.n + c + twice(|x| x + 1, 1) + inner::again("ab")
}
