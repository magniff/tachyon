// Every kind of name the language server resolves: std's items (the
// prelude, std::cli, std::thread, std::gpu), allocators, methods through
// traits, generics, operators, names in f-strings, contracts and
// attributes, and the parameter conventions.
use std::{Allocator, FixedBuf, gpu, thread};
use std::cli::{Arg, Command};
use std::ops::Add;

// A point of the plane.
#[derive(Eq, Debug)]
struct V2 { x: i64, y: i64 }

impl Add for V2 {
    fn add(self, o: V2) -> V2 { V2 { x: self.x + o.x, y: self.y + o.y } }
}

trait Named {
    fn name(self) -> [u8];
}

impl Named for V2 {
    fn name(self) -> [u8] { "v2" }
}

fn label<T: Named>(t: T) -> [u8] { t.name() }

fn largest<T: Ord + Copy>(s: [T]) -> T {
    var m = s[0];
    for x in s { if x > m { m = x; } }
    m
}

fn fill<A: Allocator>(v: inout Vec<i64, A>, n: i64) { for i in 0..n { v.push(i); } }

fn bump(v: inout Vec<i64>, x: sink i64) { v.push(x); }

fn peek(v: Vec<i64>) -> i64
    requires v.len() > 0 else "empty"
    ensures result >= 0
{
    v.len()
}

// x, twice.
#[pure]
fn twice(x: i64) -> i64 { x + x }

fn arena_sum(gpa: Gpa) -> i64 {
    arena_scope(gpa, |a: ScopedArena| {
        var tmp: Vec<i64, ScopedArena> = Vec::new_in(a);
        tmp.push(1);
        tmp.len()
    })
}

fn fixed() -> i64 {
    var mem: [u8; 256] = [0; 256];
    let fb = FixedBuf::new(&mem[..]);
    var w: Vec<i64, FixedBuf> = Vec::new_in(fb);
    w.push(2);
    w.len()
}

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    bump(&v, 2);
    fill(&v, 3);
    let s = String::from_in("hi", gpa);
    var m: HashMap<[u8], i64> = HashMap::new_in(gpa);
    m.insert("k", 3);
    let p = V2 { x: 1, y: 2 } + V2 { x: 3, y: 4 };
    let n = label(p);
    let big = largest(v.as_slice());
    let total = thread::scope(|sc| {
        let a = sc.spawn(|| twice(big));
        a.join()
    });
    let cmd = Command::new_in("t", gpa).arg(Arg::flag("v"));
    let inst = gpu::Instance::new_in(gpa);
    println(f"{v.len()} {s.len()} {n} {total} {peek(v)} {arena_sum(gpa)} {fixed()}");
    let sum: i64 = v.iter().sum();
    println(sum);
    println(more::run());
    0
}

mod more;
