// The std-heavy program of the gate's compile-cost row
// (tests/compile_cost.sh): text, collections, formatting and a file, so
// that most of std's sections are read, checked and emitted. Written in
// what the previous release compiles too: the row builds it with both.
use std::fs;
use std::collections::BTreeMap;
use std::string::String;

fn main(gpa: Gpa) -> i32 {
    let text: str = "the quick brown fox jumps over the lazy dog\nthe dog sleeps, the fox runs\n";
    var counts: HashMap<str, i64> = HashMap::new_in(gpa);
    var order: BTreeMap<i64, i64> = BTreeMap::new_in(gpa);
    var words: Vec<str> = Vec::new_in(gpa);
    for line in text.lines() {
        for w in line.split_whitespace() {
            let w = w.trim_matches(',');
            counts.get_or_insert(w, 0)[0] += 1;
            words.push(w);
        }
    }
    words.sort();
    var out = String::new_in(gpa);
    for i in 0..words.len() {
        let w = words[i];
        order.insert(i, w.len() as i64);
        out.push_str(w);
        out.push_fmt(f" {w.len()}:{w.to_uppercase_in(gpa)} {1.5 * i as f64:.2}\n");
    }
    let path = "/tmp/tachyon-compile-cost.txt";
    match fs::write(path, out.as_bytes()) {
        Ok(_) => {}
        Err(e) => eprintln(f"cannot write {path}: {e}"),
    }
    let back = fs::read_to_string_in(path, gpa);
    let total = match back {
        Ok(s) => s.len(),
        Err(_) => 0,
    };
    let n = "42".parse::<i64>().unwrap_or(0);
    println(f"{counts.len()} words, {order.len()} entries, {total} bytes, {n}");
    0
}
