// Reads integers from stdin, one per line, and prints the largest.

extern "C" {
    fn read(fd: i32, buf: *u8, n: u64) -> i64;
}

// All of stdin.
fn read_all(gpa: Gpa) -> Vec<u8> {
    let mut data: Vec<u8> = Vec::new_in(gpa);
    let mut chunk = [0u8; 65536];
    loop {
        let n = unsafe { read(0, &chunk[0], 65536) };
        if n <= 0 { break; }
        for i in 0..n { data.push(chunk[i]); }
    }
    data
}

// The integers in `s`, one per line; blank lines are skipped.
fn parse_numbers(s: [u8], gpa: Gpa) -> Vec<i64> {
    let mut out: Vec<i64> = Vec::new_in(gpa);
    let mut cur = 0;
    let mut neg = false;
    let mut in_num = false;
    for i in 0..s.len {
        let c = s[i];
        if c == '-' {
            neg = true;
            in_num = true;
        } else if c >= '0' && c <= '9' {
            cur = cur * 10 + (c - '0') as i64;
            in_num = true;
        } else {
            if in_num {
                out.push(if neg { -cur } else { cur });
            }
            cur = 0;
            neg = false;
            in_num = false;
        }
    }
    if in_num {
        out.push(if neg { -cur } else { cur });
    }
    out
}

// The largest value of a non-empty slice.
fn largest(values: [i64]) -> i64 {
    let mut best = values[0];
    for x in values {
        if x > best { best = x; }
    }
    best
}

fn main(gpa: Gpa) -> i32 {
    let mut data = read_all(gpa);
    let mut numbers = parse_numbers(data.as_slice(), gpa);
    std::print_int(largest(numbers.as_slice()));
    println("");
    0
}
