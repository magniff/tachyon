// Reads integers from stdin, one per line (blank lines ignored), and
// prints their sum.

extern "C" {
    fn read(fd: i32, buf: *u8, n: u64) -> i64;
}

// All of stdin.
fn read_all(gpa: Gpa) -> Vec<u8> {
    let mut data: Vec<u8> = Vec::new_in(gpa);
    let mut chunk = [0u8; 65536];
    loop {
        let n = unsafe { read(0, &chunk[0], 65536) };
        if n <= 0 { break; }
        for i in 0..n { data.push(chunk[i]); }
    }
    data
}

fn main(gpa: Gpa) -> i32 {
    let mut data = read_all(gpa);
    defer data.free();
    let s = data.as_slice();
    let mut total = 0;
    let mut cur = 0;
    let mut neg = false;
    let mut in_num = false;
    for i in 0..s.len {
        let c = s[i];
        if c == '-' {
            neg = true;
            in_num = true;
        } else if c >= '0' && c <= '9' {
            cur = cur * 10 + (c - '0') as i64;
            in_num = true;
        } else {
            if in_num {
                if neg { total -= cur; } else { total += cur; }
            }
            cur = 0;
            neg = false;
            in_num = false;
        }
    }
    if in_num {
        if neg { total -= cur; } else { total += cur; }
    }
    std::print_int(total);
    println("");
    0
}
