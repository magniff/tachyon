// A match on an integer whose range arms cover every value of its type is
// exhaustive: no wildcard arm is needed.
// EXPECT: 1 0 2 3 4
// EXPECT: ascii 4 continuation 1 lead 1
use std::print_int;

// The length of a UTF-8 sequence from its first byte (0: a continuation
// byte).
fn utf8_len(lead: u8) -> i64 {
    match lead {
        0..=127 => 1,
        128..=191 => 0,
        192..=223 => 2,
        224..=239 => 3,
        240..=255 => 4,
    }
}

fn main() {
    print_int(utf8_len(65));
    print(" ");
    print_int(utf8_len(0x80));
    print(" ");
    print_int(utf8_len(0xC3));
    print(" ");
    print_int(utf8_len(0xE2));
    print(" ");
    print_int(utf8_len(0xF0));
    println("");
    // "Héi!\n"
    let text: [u8; 6] = [72, 0xC3, 0xA9, 105, 33, 10];
    let mut ascii = 0;
    let mut continuation = 0;
    let mut lead = 0;
    for b in text {
        match b {
            0..=127 => ascii += 1,
            128..=191 => continuation += 1,
            192..=255 => lead += 1,
        }
    }
    print("ascii ");
    print_int(ascii);
    print(" continuation ");
    print_int(continuation);
    print(" lead ");
    print_int(lead);
    println("");
}
