// Exhaustive matches on signed and wider integers, by ranges, single
// values and constants, without a wildcard arm.
// EXPECT: neg zero pos
// EXPECT: low mid high
// EXPECT: min neg zero one pos max
// EXPECT: small large
use std::print_int;

const TOP: u16 = 65535;

fn sign(x: i8) -> [u8] {
    match x {
        -128..=-1 => "neg",
        0 => "zero",
        1..=127 => "pos",
    }
}

fn band(x: u16) -> [u8] {
    match x {
        0 => "low",
        1..=999 => "low",
        1000..=59999 => "mid",
        60000..=65534 => "high",
        TOP => "high",
    }
}

fn name(x: i64) -> [u8] {
    match x {
        -9223372036854775808 => "min",
        -9223372036854775807..=-1 => "neg",
        0 => "zero",
        1 => "one",
        2..=9223372036854775806 => "pos",
        9223372036854775807 => "max",
    }
}

fn size(x: u64) -> [u8] {
    match x {
        0..=4294967295 => "small",
        4294967296..=18446744073709551615 => "large",
    }
}

fn main() {
    print(sign(-7));
    print(" ");
    print(sign(0));
    print(" ");
    print(sign(100));
    println("");
    print(band(0));
    print(" ");
    print(band(1234));
    print(" ");
    print(band(65535));
    println("");
    let big: i64 = 9223372036854775807;
    print(name(0 - big - 1));
    print(" ");
    print(name(-3));
    print(" ");
    print(name(0));
    print(" ");
    print(name(1));
    print(" ");
    print(name(77));
    print(" ");
    print(name(big));
    println("");
    print(size(7));
    print(" ");
    print(size(5000000000));
    println("");
}
