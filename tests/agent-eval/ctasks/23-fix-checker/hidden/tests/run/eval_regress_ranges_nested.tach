// Integer ranges inside tuples and variants: covering the whole type in
// each position is exhaustive.
// EXPECT: on off-low off-high
// EXPECT: none low high
// EXPECT: 1 2 3 4
use std::print_int;

enum Reading {
    Missing,
    Level(u8),
    Pair(bool, i8),
}

fn state(on: bool, level: u8) -> [u8] {
    match (on, level) {
        (true, _) => "on",
        (false, 0..=99) => "off-low",
        (false, 100..=255) => "off-high",
    }
}

fn opt(x: Option<u8>) -> [u8] {
    match x {
        None => "none",
        Some(0..=127) => "low",
        Some(128..=255) => "high",
    }
}

fn code(r: Reading) -> i64 {
    match r {
        Reading::Missing => 1,
        Reading::Level(0..=9) | Reading::Level(10..=255) => 2,
        Reading::Pair(true, -128..=-1) | Reading::Pair(false, _) => 3,
        Reading::Pair(true, 0..=127) => 4,
    }
}

fn main() {
    print(state(true, 5));
    print(" ");
    print(state(false, 5));
    print(" ");
    print(state(false, 200));
    println("");
    print(opt(None));
    print(" ");
    print(opt(Some(3)));
    print(" ");
    print(opt(Some(250)));
    println("");
    print_int(code(Reading::Missing));
    print(" ");
    print_int(code(Reading::Level(42)));
    print(" ");
    print_int(code(Reading::Pair(false, 5)));
    print(" ");
    print_int(code(Reading::Pair(true, 5)));
    println("");
}
