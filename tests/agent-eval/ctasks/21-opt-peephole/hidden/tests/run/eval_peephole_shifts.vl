// A shift of a shift by constants, the same direction and type, is one
// shift by the sum of the amounts (each taken modulo 32 or 64, as the
// machine takes it); past the width a left or logical shift leaves 0 and
// an arithmetic one only the sign. The program prints what -O0 prints.
// EXPECT: 0 0 0 0 64 0
// EXPECT: 0 0 0 0 0 0 0
// EXPECT: 1 0 0
// EXPECT: 32 -32768 5 5 4294967232 281474976710655
// EXPECT: 5 5 0 0 -1 -1 -1
// EXPECT: 268435455 0 -1
// EXPECT: 224 -32768 251 -5 3606267200 1883
// EXPECT: 65531 35 -1 0 0 0 0
// EXPECT: 123456789 3 120563
// EXPECT: 64 0 244 500 1214632896 281474976695585
// EXPECT: 500 450 3 0 -1 -1 -1
// EXPECT: 86087503 0 -2
// EXPECT: 0 -32768 127 -385 4294967232 140737488355327
// EXPECT: 65151 1000 -3 -1 -1 0 0
// EXPECT: 268435455 3 4503599627370495
// EXPECT: 224 0 128 -640 0 140737488355328
// EXPECT: 64896 1275 -4 -1 0 -1 -1
// EXPECT: 0 3 -1
// CHECK: fn shl_u8:
// CHECK-NOT: shl
// CHECK: const 5
// CHECK: shl
// CHECK-NOT: shl
// CHECK: ret
// CHECK: fn shl_i16:
// CHECK-NOT: shl
// CHECK: const 13
// CHECK: shl
// CHECK-NOT: shl
// CHECK: ret
// CHECK: fn shl_u8_out:
// CHECK-NOT: shl
// CHECK: ret
// CHECK: fn shl_i64_out:
// CHECK-NOT: shl
// CHECK: ret
// CHECK: fn shl_u32_masked:
// CHECK-NOT: shl
// CHECK: const 6
// CHECK: shl
// CHECK-NOT: shl
// CHECK: ret
// CHECK: fn shr_u64:
// CHECK-NOT: shr
// CHECK: const 16
// CHECK: shr
// CHECK-NOT: shr
// CHECK: ret
// CHECK: fn shr_u16_out:
// CHECK-NOT: shr
// CHECK: ret
// CHECK: fn shr_u32_out:
// CHECK-NOT: shr
// CHECK: ret
// CHECK: fn shr_i8:
// CHECK-NOT: shr
// CHECK: const 5
// CHECK: shr
// CHECK-NOT: shr
// CHECK: ret
// CHECK: fn shr_i8_out:
// CHECK: shr
// CHECK-NOT: shr
// CHECK: ret
// CHECK: fn shr_i32_out:
// CHECK-NOT: shr
// CHECK: const 31
// CHECK: shr
// CHECK-NOT: shr
// CHECK: ret
// CHECK: fn shr_i64_out:
// CHECK-NOT: shr
// CHECK: const 63
// CHECK: shr
// CHECK-NOT: shr
// CHECK: ret
// CHECK: fn shr_i64_large:
// CHECK-NOT: shr
// CHECK: const 63
// CHECK: shr
// CHECK-NOT: shr
// CHECK: ret
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

#[inline(never)]
fn shl_u8(x: u8) -> u8 { (x << 3) << 2 }
#[inline(never)]
fn shl_i16(x: i16) -> i16 { (x << 6) << 7 }
#[inline(never)]
fn shl_u8_out(x: u8, y: u8) -> u8 { ((x << 20) << 15) + y * 5 }
#[inline(never)]
fn shl_i64_out(x: i64, y: i64) -> i64 { ((x << 40) << 40) + y * 5 }
#[inline(never)]
fn shl_u32_masked(x: u32) -> u32 { (x << 35) << 35 }
#[inline(never)]
fn shr_u64(x: u64) -> u64 { (x >> 7) >> 9 }
#[inline(never)]
fn shr_u16_out(x: u16, y: u16) -> u16 { ((x >> 20) >> 15) + y * 5 }
#[inline(never)]
fn shr_u32_out(x: u32, y: u32) -> u32 { ((x >> 20) >> 20) + y * 5 }
#[inline(never)]
fn shr_i8(x: i8) -> i8 { (x >> 3) >> 2 }
#[inline(never)]
fn shr_i8_out(x: i8) -> i8 { (x >> 6) >> 6 }
#[inline(never)]
fn shr_i32_out(x: i32) -> i32 { (x >> 20) >> 20 }
#[inline(never)]
fn shr_i64_out(x: i64) -> i64 { (x >> 50) >> 50 }
#[inline(never)]
fn shr_i64_large(x: i64) -> i64 { (x >> -1) >> 1 }
#[inline(never)]
fn mixed(x: u32) -> u32 { (x << 4) >> 4 }
#[inline(never)]
fn via_cast(x: i32) -> u32 { ((x >> 4) as u32) >> 30 }
#[inline(never)]
fn variable(x: i64, k: i64) -> i64 { (x >> k) >> 3 }

fn main() -> i32 {
    let small: [i64; 6] = [0, 1, 7, 90, 200, 255];
    let signed: [i64; 6] = [0, 1, -1, 100, -77, -128];
    let wide: [i64; 6] = [1, -1, 123456789, -987654321, 9223372036854775807,
        -9223372036854775807 - 1];
    unsafe {
        for i in 0..6 {
            let s = small[i];
            let g = signed[i];
            let w = wide[i];
            printf(c"%d %d %d %ld %u %lu\n", shl_u8(s as u8) as i32,
                shl_i16((g * 300) as i16) as i32, shl_u8_out(s as u8, g as u8) as i32,
                shl_i64_out(w, g), shl_u32_masked(w as u32), shr_u64(w as u64));
            printf(c"%d %u %d %d %d %ld %ld\n", shr_u16_out((w * 7) as u16, g as u16) as i32,
                shr_u32_out(w as u32, s as u32), shr_i8(g as i8) as i32,
                shr_i8_out((g + 1) as i8) as i32, shr_i32_out(w as i32), shr_i64_out(w),
                shr_i64_large(w));
            printf(c"%u %u %ld\n", mixed(w as u32), via_cast(g as i32), variable(w, s));
        }
    }
    0
}
