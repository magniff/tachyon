diff --git a/compiler/src/middle/fold/mod.vl b/compiler/src/middle/fold/mod.vl
index 49ff30b..7e17a46 100644
--- a/compiler/src/middle/fold/mod.vl
+++ b/compiler/src/middle/fold/mod.vl
@@ -375,6 +375,24 @@ fn combine(v: i64) -> bool {
         if (op == Shl || op == Shr) && shift_amount(c, ty) == 0 {
             return replace_same_type(v, a);
         }
+        // (x << c1) << c2 is x << (c1 + c2), and >> likewise, each amount
+        // taken as the machine takes it; past the width every bit is
+        // shifted out (0), or, arithmetic, only the sign is left.
+        if (op == Shl || op == Shr) && INSTS[a].op == op && INSTS[a].ty == ty
+            && is_const(INSTS[a].b) && is_integer(ty) {
+            let mut total = shift_amount(INSTS[INSTS[a].b].imm, ty) + shift_amount(c, ty);
+            let bits = int_bits(ty) as u64;
+            if total >= bits {
+                if op == Shl || !is_signed(ty) {
+                    return make_const(v, 0);
+                }
+                total = bits - 1;
+            }
+            INSTS[v].a = INSTS[a].a;
+            let operand = const_before(v, total as i64, INSTS[b].ty);
+            INSTS[v].b = operand;
+            return true;
+        }
         if c == 0 && (op == Mul || op == And) {
             return make_const(v, 0);
         }
