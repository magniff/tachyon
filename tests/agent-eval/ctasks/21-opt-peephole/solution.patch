diff --git a/tests/run/opt_shift_chains.vl b/tests/run/opt_shift_chains.vl
new file mode 100644
index 0000000..d039e70
--- /dev/null
+++ b/tests/run/opt_shift_chains.vl
@@ -0,0 +1,40 @@
+// Shifts of shifts by constants combine (instruction combining): one
+// shift by the sum, or 0 past the width (left, logical), or a shift by
+// width - 1 (arithmetic): `logical` returns 0,
+// and its calls are gone. The program prints what -O0 prints.
+// EXPECT: 128 0 0
+// EXPECT: 4294967168 0 -1
+// EXPECT: 5120000 0 -1
+// CHECK: fn left:
+// CHECK: const 7
+// CHECK: shl
+// CHECK-NOT: shl
+// CHECK: ret
+// CHECK: fn arithmetic:
+// CHECK: const 15
+// CHECK: shr
+// CHECK-NOT: shr
+// CHECK: ret
+// CHECK: fn main:
+// CHECK-NOT: call logical
+extern "C" {
+    fn printf(format: *u8, ...) -> i32;
+}
+
+#[inline(never)]
+fn left(x: u32) -> u32 { (x << 3) << 4 }
+#[inline(never)]
+fn logical(x: u64) -> u64 { (x >> 30) >> 40 }
+#[inline(never)]
+fn arithmetic(x: i16) -> i16 { (x >> 9) >> 9 }
+
+fn main() -> i32 {
+    let xs: [i64; 3] = [1, -1, 40000];
+    for i in 0..3 {
+        let x = xs[i];
+        unsafe {
+            printf(c"%u %lu %d\n", left(x as u32), logical(x as u64), arithmetic(x as i16) as i32);
+        }
+    }
+    0
+}
