diff --git a/tests/run/std_text_strip.vl b/tests/run/std_text_strip.vl
new file mode 100644
index 00000000..a3ab9826
--- /dev/null
+++ b/tests/run/std_text_strip.vl
@@ -0,0 +1,35 @@
+// EXPECT: prefix: [b] [ab] [] None None
+// EXPECT: suffix: [a] [ab] [] None None
+// EXPECT: 1 [x]
+// 0.16: std's strip_prefix and strip_suffix: a match, an empty prefix or
+// suffix, the whole text, a longer one, a mismatch; the result is a view
+// of the text.
+use std::{strip_prefix, strip_suffix};
+
+fn show(o: Option<[u8]>) {
+    match o {
+        Some(v) => print(f" [{v}]"),
+        None => print(" None"),
+    }
+}
+
+fn main(gpa: Gpa) -> i32 {
+    print("prefix:");
+    for p in ["a", "", "ab", "abc", "b"] {
+        show(strip_prefix("ab", p));
+    }
+    println("");
+    print("suffix:");
+    for p in ["b", "", "ab", "xab", "a"] {
+        show(strip_suffix("ab", p));
+    }
+    println("");
+    let mut v: Vec<u8> = Vec::new_in(gpa);
+    defer v.free();
+    v.extend_from_slice("(y)");
+    let inner = strip_suffix(strip_prefix(v.as_slice(), "(").unwrap(), ")").unwrap();
+    v.set(1, 'x');
+    std::print_int(inner.len);
+    println(f" [{inner}]");
+    0
+}
