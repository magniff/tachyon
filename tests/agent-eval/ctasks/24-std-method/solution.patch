+// s without `prefix` at its start, as a view of s; None when s does not
+// start with it (an empty prefix: Some(s); s itself: Some("")). (0.16)
+pub fn strip_prefix(s: [u8], prefix: [u8]) -> Option<[u8]> {
+    if prefix.len > s.len {
+        return Option::None;
+    }
+    for i in 0..prefix.len {
+        if s[i] != prefix[i] {
+            return Option::None;
+        }
+    }
+    Option::Some(s[prefix.len..])
+}
+
+// s without `suffix` at its end, as a view of s; None when s does not end
+// with it (an empty suffix: Some(s); s itself: Some("")). (0.16)
+pub fn strip_suffix(s: [u8], suffix: [u8]) -> Option<[u8]> {
+    if suffix.len > s.len {
+        return Option::None;
+    }
+    let start = s.len - suffix.len;
+    for i in 0..suffix.len {
+        if s[start + i] != suffix[i] {
+            return Option::None;
+        }
+    }
+    Option::Some(s[..start])
+}
+
