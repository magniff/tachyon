// EXPECT: 3 4 [cde] [abc]
// EXPECT: [Xde] [abX]
// EXPECT: 255 [ok] None
// EXPECT: 0 0
// The hidden check that std::strip_prefix and std::strip_suffix return
// views of their text, not copies (a change to the Vec shows through
// them), work on bytes that are not ASCII, and on a Buf's text.
use std::{Buf, strip_prefix, strip_suffix};

fn main() -> i32 {
    let mut v: Vec<u8> = Vec::new();
    defer v.free();
    v.extend_from_slice("abcde");
    let tail = strip_prefix(v.as_slice(), "ab").unwrap();
    let head = strip_suffix(v.as_slice(), "de").unwrap();
    std::print_int(tail.len);
    print(" ");
    std::print_int(strip_prefix(v.as_slice(), "a").unwrap().len);
    print(" [");
    print(tail);
    print("] [");
    print(head);
    println("]");
    v.set(2, 'X');
    print("[");
    print(tail);
    print("] [");
    print(head);
    println("]");

    let mut b = Buf::new();
    defer b.free();
    b.push(255);
    b.push_str("ok");
    b.push(254);
    let mut hi = Buf::new();
    defer hi.free();
    hi.push(255);
    let mut lo = Buf::new();
    defer lo.free();
    lo.push(254);
    let mid = strip_suffix(strip_prefix(b.as_slice(), hi.as_slice()).unwrap(), lo.as_slice()).unwrap();
    std::print_int(b.as_slice()[0] as i64);
    print(" [");
    print(mid);
    print("]");
    match strip_prefix(b.as_slice(), lo.as_slice()) {
        Some(_) => println(" Some"),
        None => println(" None"),
    }

    let e = strip_prefix(b.as_slice(), b.as_slice()).unwrap();
    let f = strip_suffix(b.as_slice(), b.as_slice()).unwrap();
    std::print_int(e.len);
    print(" ");
    std::print_int(f.len);
    println("");
    0
}
