// EXPECT: p: [world] [hello world] [] None None None [a] [] None
// EXPECT: s: [hello] [hello world] [] None None None [a] [] None
// EXPECT: path: [b=2] [k]
// EXPECT: keys: name=[ada] age=[36] skip skip x=[]
// EXPECT: exts: [main] none [lib.rs] [] none
// The hidden check of std::strip_prefix and std::strip_suffix (agent
// eval task 24-std-method): matches, an empty prefix, the whole text, a
// longer prefix, a mismatch at the last byte, repeats, empty texts.
use std::{strip_prefix, strip_suffix};

fn show(o: Option<[u8]>) {
    match o {
        Some(v) => {
            print(" [");
            print(v);
            print("]");
        }
        None => print(" None"),
    }
}

fn main() -> i32 {
    print("p:");
    show(strip_prefix("hello world", "hello "));
    show(strip_prefix("hello world", ""));
    show(strip_prefix("hello world", "hello world"));
    show(strip_prefix("hello", "hello world"));
    show(strip_prefix("hello", "help"));
    show(strip_prefix("hello", "ello"));
    show(strip_prefix("aaa", "aa"));
    show(strip_prefix("", ""));
    show(strip_prefix("", "a"));
    println("");

    print("s:");
    show(strip_suffix("hello world", " world"));
    show(strip_suffix("hello world", ""));
    show(strip_suffix("hello world", "hello world"));
    show(strip_suffix("world", "hello world"));
    show(strip_suffix("world", "xorld"));
    show(strip_suffix("world", "worl"));
    show(strip_suffix("aaa", "aa"));
    show(strip_suffix("", ""));
    show(strip_suffix("", "a"));
    println("");

    // By path, without an import, and chained.
    print("path:");
    show(std::strip_prefix("a=1,b=2", "a=1,"));
    let inner = std::strip_suffix(std::strip_prefix("[k]", "[").unwrap(), "]").unwrap();
    print(" [");
    print(inner);
    println("]");

    print("keys:");
    for line in ["name=ada", "age=36", "name", "=x", "x="] {
        let mut found = false;
        for key in ["name", "age", "x"] {
            if let Some(rest) = strip_prefix(line, key) {
                if let Some(v) = strip_prefix(rest, "=") {
                    print(" ");
                    print(key);
                    print("=[");
                    print(v);
                    print("]");
                    found = true;
                }
            }
        }
        if !found {
            print(" skip");
        }
    }
    println("");

    print("exts:");
    for f in ["main.tach", "main.c", "lib.rs.tach", ".tach", "tach"] {
        match strip_suffix(f, ".tach") {
            Some(stem) => {
                print(" [");
                print(stem);
                print("]");
            }
            None => print(" none"),
        }
    }
    println("");
    0
}
