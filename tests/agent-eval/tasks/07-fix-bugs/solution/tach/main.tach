// Order processing: reads an inventory and a list of orders from stdin,
// fills the orders against the stock and prints a report.

mod inventory;
mod money;
mod orders;

import "stdio.h" as c;

use inventory::{Inventory, Item};
use money::push_cents;
use orders::{Order, OrderLine, parse_tier, process_orders};
use std::Buf;

// Reads whitespace-separated words from the input.
struct Scanner {
    text: [u8],
    pos: i64,
}

impl Scanner {
    fn new(text: [u8]) -> Scanner {
        Scanner { text: text, pos: 0 }
    }

    fn is_space(c: u8) -> bool {
        c == ' ' || c == '\n' || c == '\t' || c == '\r'
    }

    // The next word, or "" at the end of the input.
    fn next_word(self: &mut Scanner) -> [u8] {
        while self.pos < self.text.len() && Scanner::is_space(self.text[self.pos]) {
            self.pos += 1;
        }
        let start = self.pos;
        while self.pos < self.text.len() && !Scanner::is_space(self.text[self.pos]) {
            self.pos += 1;
        }
        self.text[start..self.pos]
    }

    // The next word as a non-negative decimal integer.
    fn next_int(self: &mut Scanner) -> i64 {
        let word = self.next_word();
        let mut n = 0;
        for c in word {
            n = n * 10 + (c - '0') as i64;
        }
        n
    }
}

fn read_all(gpa: Gpa) -> Buf {
    let mut b = Buf::new_in(gpa);
    loop {
        let ch = unsafe { c::getchar() };
        if ch < 0 {
            break;
        }
        b.push(ch as u8);
    }
    b
}

fn read_inventory(sc: &mut Scanner, gpa: Gpa) -> Inventory {
    let mut inv = Inventory::new(gpa);
    sc.next_word(); // "items"
    let count = sc.next_int();
    for _ in 0..count {
        let sku = sc.next_int();
        let price = sc.next_int();
        let stock = sc.next_int();
        let name = sc.next_word();
        inv.add(Item { sku: sku, name: name, price: price, stock: stock });
    }
    inv.sort_by_sku();
    inv
}

fn read_orders(sc: &mut Scanner, gpa: Gpa) -> Vec<Order> {
    let mut list: Vec<Order> = Vec::new_in(gpa);
    sc.next_word(); // "orders"
    let count = sc.next_int();
    for _ in 0..count {
        let customer = sc.next_word();
        let tier = parse_tier(sc.next_word());
        let nlines = sc.next_int();
        let mut lines: Vec<OrderLine> = Vec::new_in(gpa);
        for _ in 0..nlines {
            let sku = sc.next_int();
            let qty = sc.next_int();
            lines.push(OrderLine { sku: sku, qty: qty });
        }
        list.push(Order { customer: customer, tier: tier, lines: lines });
    }
    list
}

fn main(gpa: Gpa) -> i32 {
    let input = read_all(gpa);
    let mut sc = Scanner::new(input.as_slice());
    let mut inv = read_inventory(&mut sc, gpa);
    let list = read_orders(&mut sc, gpa);
    let mut out = Buf::new_in(gpa);
    let revenue = process_orders(&mut inv, &list, &mut out);
    inv.report(&mut out);
    out.push_str("revenue ");
    push_cents(&mut out, revenue);
    out.push('\n');
    print(out.as_slice());
    0
}
