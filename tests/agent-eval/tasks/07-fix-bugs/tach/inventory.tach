// The stock: items kept sorted by SKU, found by binary search.

use std::{Buf, sort};

pub struct Item {
    pub sku: i64,
    pub name: [u8],
    pub price: i64, // cents
    pub stock: i64,
}

impl Ord for Item {
    fn cmp(self: *Item, other: *Item) -> i64 {
        self.sku - other.sku
    }
}

pub struct Inventory {
    pub items: Vec<Item>,
}

impl Inventory {
    pub fn new() -> Inventory {
        Inventory { items: Vec::new() }
    }

    pub fn add(self: *Inventory, item: Item) {
        self.items.push(item);
    }

    // Puts the items in SKU order; `find` needs it.
    pub fn sort_by_sku(self: *Inventory) {
        sort(self.items.as_slice());
    }

    // The index of the item with this SKU, if there is one.
    pub fn find(self: *Inventory, sku: i64) -> Option<i64> {
        let items = self.items.as_slice();
        let mut lo = 0;
        let mut hi = items.len - 1;
        while lo < hi {
            let mid = (lo + hi) / 2;
            let here = items[mid].sku;
            if here == sku {
                return Some(mid);
            }
            if here < sku {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
        None
    }

    // Takes `qty` units of item `index` out of stock; false (and nothing
    // taken) when there are not enough.
    pub fn take(self: *Inventory, index: i64, qty: i64) -> bool {
        let items = self.items.as_slice();
        if items[index].stock < qty {
            return false;
        }
        items[index].stock -= qty;
        true
    }

    // One line per item, in SKU order: "  SKU NAME STOCK".
    pub fn report(self: *Inventory, out: *Buf) {
        out.push_str("inventory\n");
        for item in self.items.as_slice() {
            out.push_str("  ");
            out.push_int(item.sku);
            out.push(' ');
            out.push_str(item.name);
            out.push(' ');
            out.push_int(item.stock);
            out.push('\n');
        }
    }
}
