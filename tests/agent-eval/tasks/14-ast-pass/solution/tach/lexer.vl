// Splits the program text into tokens. Names are interned: an Ident
// token's value is the index of its name in `names`.

use std::HashMap;

pub enum TokenKind {
    Num,
    Ident,
    Let,
    Print,
    If,
    Else,
    While,
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Bang,
    Lt,
    Le,
    Gt,
    Ge,
    EqEq,
    Ne,
    AndAnd,
    OrOr,
    Assign,
    LParen,
    RParen,
    LBrace,
    RBrace,
    Semi,
    Comma,
    // After the last token; its line is the last token's line.
    End,
}

pub struct Token {
    pub kind: TokenKind,
    // A number's value, a name's index in `names`; 0 for the others.
    pub value: i64,
    pub line: i64,
}

pub struct Lexed {
    pub tokens: Vec<Token>,
    pub names: Vec<[u8]>,
}

fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn is_alpha(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

fn is_space(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

// The keyword spelled by `word`, if it is one.
fn keyword(word: [u8]) -> Option<TokenKind> {
    if word == "let" {
        Some(TokenKind::Let)
    } else if word == "print" {
        Some(TokenKind::Print)
    } else if word == "if" {
        Some(TokenKind::If)
    } else if word == "else" {
        Some(TokenKind::Else)
    } else if word == "while" {
        Some(TokenKind::While)
    } else {
        None
    }
}

// A token of one character, if `c` starts one that cannot be longer.
fn single(c: u8) -> Option<TokenKind> {
    match c {
        '+' => Some(TokenKind::Plus),
        '-' => Some(TokenKind::Minus),
        '*' => Some(TokenKind::Star),
        '/' => Some(TokenKind::Slash),
        '%' => Some(TokenKind::Percent),
        '(' => Some(TokenKind::LParen),
        ')' => Some(TokenKind::RParen),
        '{' => Some(TokenKind::LBrace),
        '}' => Some(TokenKind::RBrace),
        ';' => Some(TokenKind::Semi),
        ',' => Some(TokenKind::Comma),
        _ => None,
    }
}

// A token of one or two characters: `first` alone, or `second` when the
// next character is `next`.
fn one_or_two(src: [u8], i: i64, next: u8, first: TokenKind, second: TokenKind) -> (TokenKind, i64) {
    if i + 1 < src.len() && src[i + 1] == next {
        (second, 2)
    } else {
        (first, 1)
    }
}

// The index of `word` in `names`, added if it is new; `ids` maps the
// names seen so far to their indices.
fn intern(ids: inout HashMap<[u8], i64>, names: inout Vec<[u8]>, word: [u8]) -> i64 {
    match ids.get(word) {
        Some(id) => id,
        None => {
            let id = names.len();
            ids.insert(word, id);
            names.push(word);
            id
        }
    }
}

// The tokens of the program, ending with End, or the line of the first
// character that starts no token. `#` starts a comment to the end of the
// line. Names are slices of `src`, which must outlive them.
pub fn tokenize(src: [u8], gpa: Gpa) -> Result<Lexed, i64> {
    var tokens: Vec<Token> = Vec::new_in(gpa);
    var ids: HashMap<[u8], i64> = HashMap::new_in(gpa);
    var names: Vec<[u8]> = Vec::new_in(gpa);
    let n = src.len();
    var i = 0;
    var line = 1;
    while i < n {
        let c = src[i];
        if c == '\n' {
            line += 1;
            i += 1;
        } else if is_space(c) {
            i += 1;
        } else if c == '#' {
            while i < n && src[i] != '\n' {
                i += 1;
            }
        } else if is_digit(c) {
            var value = 0;
            while i < n && is_digit(src[i]) {
                value = value * 10 + (src[i] - '0') as i64;
                i += 1;
            }
            tokens.push(Token { kind: TokenKind::Num, value: value, line: line });
        } else if is_alpha(c) {
            let start = i;
            while i < n && (is_alpha(src[i]) || is_digit(src[i])) {
                i += 1;
            }
            let word = src[start..i];
            match keyword(word) {
                Some(kind) => tokens.push(Token { kind: kind, value: 0, line: line }),
                None => {
                    let id = intern(&ids, &names, word);
                    tokens.push(Token { kind: TokenKind::Ident, value: id, line: line });
                }
            }
        } else {
            let (kind, len) = match c {
                '<' => one_or_two(src, i, '=', TokenKind::Lt, TokenKind::Le),
                '>' => one_or_two(src, i, '=', TokenKind::Gt, TokenKind::Ge),
                '=' => one_or_two(src, i, '=', TokenKind::Assign, TokenKind::EqEq),
                '!' => one_or_two(src, i, '=', TokenKind::Bang, TokenKind::Ne),
                '&' => one_or_two(src, i, '&', TokenKind::End, TokenKind::AndAnd),
                '|' => one_or_two(src, i, '|', TokenKind::End, TokenKind::OrOr),
                _ => match single(c) {
                    Some(kind) => (kind, 1),
                    None => (TokenKind::End, 1),
                },
            };
            if kind == TokenKind::End {
                return Err(line);
            }
            tokens.push(Token { kind: kind, value: 0, line: line });
            i += len;
        }
    }
    let last_line = if tokens.is_empty() { 1 } else { tokens.get(tokens.len() - 1).line };
    tokens.push(Token { kind: TokenKind::End, value: 0, line: last_line });
    Ok(Lexed { tokens: tokens, names: names })
}
