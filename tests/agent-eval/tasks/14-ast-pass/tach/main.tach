// An interpreter for a small statement language over 64-bit integers.
// The first line of the program picks the mode: `#!dump` prints the
// syntax tree, anything else runs the program.

mod ast;
mod eval;
mod lexer;
mod parser;

import "unistd.h" as c;

use ast::dump;
use eval::run;
use lexer::tokenize;
use parser::parse;
use std::Buf;

// All of stdin.
fn read_all() -> Buf {
    let mut b = Buf::new();
    let mut chunk = [0u8; 65536];
    loop {
        let n = unsafe { c::read(0, &chunk[0] as *u8, 65536) } as i64;
        if n <= 0 {
            break;
        }
        b.push_str(chunk[0..n]);
    }
    b
}

// Whether the first line of `src` is `#!dump` (a `\r` before its end
// allowed).
fn is_dump(src: [u8]) -> bool {
    let mut end = 0;
    while end < src.len && src[end] != '\n' {
        end += 1;
    }
    let mut line = src[0..end];
    if line.len > 0 && line[line.len - 1] == '\r' {
        line = line[0..line.len - 1];
    }
    line == "#!dump"
}

fn syntax_error(line: i64, out: *Buf) {
    out.push_str("syntax error at line ");
    out.push_int(line);
    out.push('\n');
}

fn main() -> i32 {
    let mut input = read_all();
    defer input.free();
    let src = input.as_slice();
    let mut out = Buf::new();
    defer out.free();
    match tokenize(src) {
        Err(line) => syntax_error(line, &out),
        Ok(lexed) => match parse(lexed) {
            Err(line) => syntax_error(line, &out),
            Ok(t) => {
                if is_dump(src) {
                    dump(&t, &out);
                } else {
                    run(&t, &out);
                }
            }
        },
    }
    print(out.as_slice());
    0
}
