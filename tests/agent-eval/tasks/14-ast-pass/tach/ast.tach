// The syntax tree, and its dump. Nodes live in vectors and refer to each
// other by index; a list of children (a block's statements, a print's
// expressions) is a run of `count` indices in `lists` from `first`.

use std::Buf;

pub enum UnOp {
    Neg,
    Not,
}

pub enum BinOp {
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    Lt,
    Le,
    Gt,
    Ge,
    Eq,
    Ne,
    And,
    Or,
}

pub enum Expr {
    Num(i64),
    // The name's index, the line of the name.
    Var(i64, i64),
    // The operator, the operand, the line of the operator.
    Unary(UnOp, i64, i64),
    // The operator, the left and right operands, the line of the operator.
    Binary(BinOp, i64, i64, i64),
}

pub enum Stmt {
    // `let name = expr;`: the name, the expression.
    Let(i64, i64),
    // `name = expr;`: the name, the expression, the line of the name.
    Set(i64, i64, i64),
    // `print e, e;`: the list of expressions (first, count).
    Print(i64, i64),
    // The condition, the then-block's list (first, count), and the else
    // part: -1 for none, or a statement (a Block or an If).
    If(i64, i64, i64, i64),
    // `{ ... }`: the list of statements (first, count).
    Block(i64, i64),
}

pub struct Ast {
    pub exprs: Vec<Expr>,
    pub stmts: Vec<Stmt>,
    pub lists: Vec<i64>,
    pub names: Vec<[u8]>,
    // The program's statements: a list (first, count).
    pub top_first: i64,
    pub top_count: i64,
}

impl Ast {
    pub fn expr(self: &Ast, i: i64) -> Expr {
        self.exprs.get(i)
    }

    pub fn stmt(self: &Ast, i: i64) -> Stmt {
        self.stmts.get(i)
    }

    pub fn list(self: &Ast, i: i64) -> i64 {
        self.lists.get(i)
    }

    pub fn add_expr(self: &mut Ast, e: Expr) -> i64 {
        self.exprs.push(e);
        self.exprs.len() - 1
    }

    pub fn add_stmt(self: &mut Ast, s: Stmt) -> i64 {
        self.stmts.push(s);
        self.stmts.len() - 1
    }

    // Copies `items` to the end of `lists`; returns where they start.
    pub fn add_list(self: &mut Ast, items: [i64]) -> i64 {
        let first = self.lists.len();
        for x in items {
            self.lists.push(x);
        }
        first
    }
}

pub fn unop_text(op: UnOp) -> [u8] {
    match op {
        UnOp::Neg => "neg",
        UnOp::Not => "not",
    }
}

pub fn binop_text(op: BinOp) -> [u8] {
    match op {
        BinOp::Add => "+",
        BinOp::Sub => "-",
        BinOp::Mul => "*",
        BinOp::Div => "/",
        BinOp::Rem => "%",
        BinOp::Lt => "<",
        BinOp::Le => "<=",
        BinOp::Gt => ">",
        BinOp::Ge => ">=",
        BinOp::Eq => "==",
        BinOp::Ne => "!=",
        BinOp::And => "&&",
        BinOp::Or => "||",
    }
}

fn indent(out: &mut Buf, depth: i64) {
    for _ in 0..depth {
        out.push_str("  ");
    }
}

// An expression on one line: a number, a name, `(op a)` or `(op a b)`.
pub fn dump_expr(ast: &Ast, e: i64, out: &mut Buf) {
    match ast.expr(e) {
        Expr::Num(v) => out.push_int(v),
        Expr::Var(name, _) => out.push_str(ast.names.get(name)),
        Expr::Unary(op, a, _) => {
            out.push('(');
            out.push_str(unop_text(op));
            out.push(' ');
            dump_expr(ast, a, out);
            out.push(')');
        }
        Expr::Binary(op, a, b, _) => {
            out.push('(');
            out.push_str(binop_text(op));
            out.push(' ');
            dump_expr(ast, a, out);
            out.push(' ');
            dump_expr(ast, b, out);
            out.push(')');
        }
    }
}

// The statements of a list, each at `depth`.
pub fn dump_list(ast: &Ast, first: i64, count: i64, depth: i64, out: &mut Buf) {
    for k in 0..count {
        dump_stmt(ast, ast.list(first + k), depth, out);
    }
}

// A statement on its own line, indented two spaces per level; the
// statements inside it one level deeper.
pub fn dump_stmt(ast: &Ast, s: i64, depth: i64, out: &mut Buf) {
    indent(out, depth);
    match ast.stmt(s) {
        Stmt::Let(name, e) => {
            out.push_str("let ");
            out.push_str(ast.names.get(name));
            out.push(' ');
            dump_expr(ast, e, out);
            out.push('\n');
        }
        Stmt::Set(name, e, _) => {
            out.push_str("set ");
            out.push_str(ast.names.get(name));
            out.push(' ');
            dump_expr(ast, e, out);
            out.push('\n');
        }
        Stmt::Print(first, count) => {
            out.push_str("print");
            for k in 0..count {
                out.push(' ');
                dump_expr(ast, ast.list(first + k), out);
            }
            out.push('\n');
        }
        Stmt::If(cond, first, count, els) => {
            out.push_str("if ");
            dump_expr(ast, cond, out);
            out.push('\n');
            dump_list(ast, first, count, depth + 1, out);
            if els >= 0 {
                indent(out, depth);
                out.push_str("else\n");
                match ast.stmt(els) {
                    Stmt::Block(f, c) => dump_list(ast, f, c, depth + 1, out),
                    _ => dump_stmt(ast, els, depth + 1, out),
                }
            }
        }
        Stmt::Block(first, count) => {
            out.push_str("block\n");
            dump_list(ast, first, count, depth + 1, out);
        }
    }
}

// The whole program: `program`, then its statements one level deeper.
pub fn dump(ast: &Ast, out: &mut Buf) {
    out.push_str("program\n");
    dump_list(ast, ast.top_first, ast.top_count, 1, out);
}
