#!run
# counts the primes below 250000 by trial division, and a checksum
let n = 2;
let count = 0;
let sum = 0;
while n < 250000 {
    let d = 2;
    let prime = 1;
    while d * d <= n && prime {
        if n % d == 0 { prime = 0; }
        d = d + 1;
    }
    if prime && 1 + 1 == 2 {
        count = count + 1;
        sum = (sum * 31 + n) % 1000000007;
    }
    n = n + 1;
}
print count, sum;
let i = 0;
let h = 7;
while i < 1000000 {
    h = h * 6364136223846793005 + 1442695040888963407;
    if (h / 3) % 2 == 0 || 0 { h = h + i; } else { h = h - (2 * 3); }
    i = i + 1;
}
print h;
