#!run
# Fibonacci numbers
let a = 0;
let b = 1;
let i = 0;
while i < 15 {
    let t = a + b;
    a = b;
    b = t;
    i = i + 1;
}
print a, b, i;
# primes below 60 by trial division
let n = 2;
while n < 60 {
    let d = 2;
    let prime = 1;
    while d * d <= n && prime {
        if n % d == 0 {
            prime = 0;
        }
        d = d + 1;
    }
    if prime {
        print n;
    }
    n = n + 1;
}
# gcd and a nested table
let p = 1071;
let q = 462;
while q != 0 {
    let r = p % q;
    p = q;
    q = r;
}
print p;
let row = 1;
while row <= 4 {
    let col = 1;
    let acc = 0;
    while col <= row {
        acc = acc * 10 + col;
        col = col + 1;
    }
    print row, acc;
    row = row + 1;
}
# a body's let is new on every pass
let k = 0;
while k < 3 {
    let fresh = 5;
    fresh = fresh + k;
    print fresh;
    k = k + 1;
}
while 0 {
    print 999;
}
print k;
