// The books the library owns: each title once, with its number of copies.

pub struct Item {
    pub id: i64,
    pub title: [u8],
    // Copies the library owns.
    pub qty: i64,
    // Copies out on loan.
    pub lent: i64,
}

impl Item {
    // Copies on the shelf.
    pub fn available(self) -> i64 {
        self.qty - self.lent
    }
}

pub struct Catalog {
    // In the order they were added.
    pub items: Vec<Item>,
}

impl Catalog {
    pub fn new(gpa: Gpa) -> Catalog {
        Catalog { items: Vec::new_in(gpa) }
    }

    // The index of the book `id`.
    pub fn find(self, id: i64) -> Option<i64> {
        let items = self.items.as_slice();
        for i in 0..items.len() {
            if items[i].id == id {
                return Some(i);
            }
        }
        None
    }

    // Adds `qty` copies of the book `id`, a new title or more of one the
    // library has; returns its copies now.
    pub fn add(inout self, id: i64, title: [u8], qty: i64) -> i64 {
        match self.find(id) {
            Some(i) => {
                let items = self.items.as_mut_slice();
                items[i].qty += qty;
                items[i].qty
            }
            None => {
                self.items.push(Item { id: id, title: title, qty: qty, lent: 0 });
                qty
            }
        }
    }

    // Copies owned, over every title.
    pub fn total_qty(self) -> i64 {
        var n = 0;
        for it in self.items.as_slice() {
            n += it.qty;
        }
        n
    }

    // Copies out on loan, over every title.
    pub fn total_lent(self) -> i64 {
        var n = 0;
        for it in self.items.as_slice() {
            n += it.lent;
        }
        n
    }
}
