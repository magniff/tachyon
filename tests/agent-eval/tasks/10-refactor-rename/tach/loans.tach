// Books out on loan, and the fee for returning one late.

// A loan lasts this many days; each day after it is late.
pub const LOAN_DAYS: i64 = 14;
// The first late days cost FEE_LOW cents each, later ones FEE_HIGH.
const LOW_DAYS: i64 = 7;
const FEE_LOW: i64 = 25;
const FEE_HIGH: i64 = 50;
// No fee is more than this.
const FEE_CAP: i64 = 1500;

pub struct Loan {
    pub member: i64,
    pub book: i64,
    // The day it was lent.
    pub day: i64,
}

pub struct Loans {
    // Oldest first.
    pub list: Vec<Loan>,
}

impl Loans {
    pub fn new(gpa: Gpa) -> Loans {
        Loans { list: Vec::new_in(gpa) }
    }

    pub fn lend(inout self, member: i64, book: i64, day: i64) {
        self.list.push(Loan { member: member, book: book, day: day });
    }

    // The index of the oldest loan of `book` to `member`.
    pub fn find(self, member: i64, book: i64) -> Option<i64> {
        let list = self.list.as_slice();
        for i in 0..list.len() {
            if list[i].member == member && list[i].book == book {
                return Some(i);
            }
        }
        None
    }

    // Removes loan `i`, keeping the others in order; returns it.
    pub fn remove(inout self, i: i64) -> Loan {
        let list = self.list.as_mut_slice();
        let loan = list[i];
        for j in i..list.len() - 1 {
            list[j] = list[j + 1];
        }
        self.list.pop();
        loan
    }
}

// Days past the loan period for a book held `days` days (0 if on time).
pub fn days_late(days: i64) -> i64 {
    if days > LOAN_DAYS {
        days - LOAN_DAYS
    } else {
        0
    }
}

// The late fee, in cents, for a book held `days` days.
pub fn calc(days: i64) -> i64 {
    let late = days_late(days);
    let low = if late < LOW_DAYS { late } else { LOW_DAYS };
    let fee = low * FEE_LOW + (late - low) * FEE_HIGH;
    if fee > FEE_CAP {
        FEE_CAP
    } else {
        fee
    }
}
