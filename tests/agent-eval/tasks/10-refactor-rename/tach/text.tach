// Command lines as words and numbers; numbers and money as text.

use std::Buf;

// The words of `line`, separated by runs of spaces.
pub fn words(line: [u8], gpa: Gpa) -> Vec<[u8]> {
    let mut v: Vec<[u8]> = Vec::new_in(gpa);
    let mut i = 0;
    while i < line.len {
        while i < line.len && line[i] == ' ' {
            i += 1;
        }
        let start = i;
        while i < line.len && line[i] != ' ' {
            i += 1;
        }
        if i > start {
            v.push(line[start..i]);
        }
    }
    v
}

// What follows the first `n` words of `line`, from the next word on.
pub fn rest_after(line: [u8], n: i64) -> [u8] {
    let mut i = 0;
    for _ in 0..n {
        while i < line.len && line[i] == ' ' {
            i += 1;
        }
        while i < line.len && line[i] != ' ' {
            i += 1;
        }
    }
    while i < line.len && line[i] == ' ' {
        i += 1;
    }
    line[i..]
}

// A decimal number of at most 12 digits, or None.
pub fn parse_int(word: [u8]) -> Option<i64> {
    if word.len == 0 || word.len > 12 {
        return None;
    }
    let mut n = 0;
    for ch in word {
        if ch < '0' || ch > '9' {
            return None;
        }
        n = n * 10 + (ch - '0') as i64;
    }
    Some(n)
}

pub fn push_int(out: *Buf, n: i64) {
    out.push_int(n);
}

// Appends an amount in cents as dollars: 1234 is "12.34", 5 is "0.05".
pub fn push_money(out: *Buf, cents: i64) {
    push_int(out, cents / 100);
    out.push('.');
    let rest = cents % 100;
    if rest < 10 {
        out.push('0');
    }
    push_int(out, rest);
}
