+// The books of a catalog, in order.
+pub struct Books {
+    items: [Book],
+    next: i64,
+}
+
+impl Iterator for Books {
+    type Item = Book;
+    fn next(self: *Books) -> Option<Book> {
+        if self.next >= self.items.len {
+            return None;
+        }
+        self.next += 1;
+        Some(self.items[self.next - 1])
+    }
+}
+
 impl Catalog {
+    pub fn books(self: *Catalog) -> Books {
+        Books { items: self.items.as_slice(), next: 0 }
+    }
+
     pub fn new(gpa: Gpa) -> Catalog {
         Catalog { items: Vec::new_in(gpa) }
     }
