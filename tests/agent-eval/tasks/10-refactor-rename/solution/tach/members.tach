// The library's members and what they owe.

pub struct Member {
    pub id: i64,
    pub name: [u8],
    // Books held now.
    pub on_loan: i64,
    // Late fees not yet paid, in cents.
    pub owes: i64,
    // Late fees paid so far, in cents.
    pub paid: i64,
}

pub struct Members {
    // In the order they joined.
    pub list: Vec<Member>,
}

impl Members {
    pub fn new(gpa: Gpa) -> Members {
        Members { list: Vec::new_in(gpa) }
    }

    // The index of the member `id`.
    pub fn find(self: &Members, id: i64) -> Option<i64> {
        let list = self.list.as_slice();
        for i in 0..list.len() {
            if list[i].id == id {
                return Some(i);
            }
        }
        None
    }

    // Adds a member; false if `id` is taken.
    pub fn add(self: &mut Members, id: i64, name: [u8]) -> bool {
        if self.find(id).is_some() {
            return false;
        }
        self.list.push(Member { id: id, name: name, on_loan: 0, owes: 0, paid: 0 });
        true
    }

    // Takes up to `cents` off what member `i` owes; returns the amount taken.
    pub fn pay(self: &mut Members, i: i64, cents: i64) -> i64 {
        let list = self.list.as_mut_slice();
        let amount = if cents < list[i].owes { cents } else { list[i].owes };
        list[i].owes -= amount;
        list[i].paid += amount;
        amount
    }

    // Fees owed, over every member.
    pub fn total_owed(self: &Members) -> i64 {
        let mut n = 0;
        for m in self.list.as_slice() {
            n += m.owes;
        }
        n
    }
}
