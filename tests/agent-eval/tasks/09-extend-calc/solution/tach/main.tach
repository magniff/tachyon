// A line calculator: each line of stdin is an expression over 64-bit
// integers; its value (or an error) is printed on a line of its own.

mod eval;
mod lexer;
mod parser;

import "stdio.h" as c;

use eval::{EvalError, evaluate};
use lexer::tokenize;
use parser::parse;
use std::{Buf, HashMap};

fn read_all() -> Buf {
    let mut b = Buf::new();
    loop {
        let ch = unsafe { c::getchar() };
        if ch < 0 {
            break;
        }
        b.push(ch as u8);
    }
    b
}

// Evaluates one line and appends the result line to `out`. A line with
// no tokens (blank, or only a comment) prints nothing.
fn run_line(line: [u8], vars: *HashMap<[u8], i64>, out: *Buf) {
    let mut tokens = match tokenize(line) {
        Some(t) => t,
        None => {
            out.push_str("error: syntax\n");
            return;
        }
    };
    defer tokens.free();
    if tokens.len() == 1 {
        return; // only the end marker
    }
    let mut tree = match parse(tokens) {
        Some(t) => t,
        None => {
            out.push_str("error: syntax\n");
            return;
        }
    };
    defer tree.nodes.free();
    match evaluate(&tree, tree.root, vars) {
        Ok(v) => {
            if let Some(name) = tree.let_name {
                out.push_str(name);
                out.push_str(" = ");
                vars.insert(name, v);
            }
            out.push_int(v);
            out.push('\n');
        }
        Err(EvalError::DivisionByZero) => out.push_str("error: division by zero\n"),
        Err(EvalError::UnknownVariable(name)) => {
            out.push_str("error: unknown variable ");
            out.push_str(name);
            out.push('\n');
        }
    }
}

fn main() -> i32 {
    let input = read_all();
    let text = input.as_slice();
    let mut vars: HashMap<[u8], i64> = HashMap::new();
    let mut out = Buf::new();
    let mut start = 0;
    for i in 0..text.len + 1 {
        if i == text.len || text[i] == '\n' {
            run_line(text[start..i], &vars, &out);
            start = i + 1;
        }
    }
    print(out.as_slice());
    0
}
