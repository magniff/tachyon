// Evaluates a parsed tree.

use crate::parser::{Node, Op, Tree};
use std::HashMap;

pub enum EvalError {
    DivisionByZero,
    UnknownVariable([u8]),
}

fn apply(op: Op, a: i64, b: i64) -> Result<i64, EvalError> {
    match op {
        Op::Add => Ok(a + b),
        Op::Sub => Ok(a - b),
        Op::Mul => Ok(a * b),
        Op::Div => {
            if b == 0 {
                return Err(EvalError::DivisionByZero);
            }
            Ok(a / b)
        }
        Op::Rem => {
            if b == 0 {
                return Err(EvalError::DivisionByZero);
            }
            Ok(a % b)
        }
        Op::Lt => Ok((a < b) as i64),
        Op::Le => Ok((a <= b) as i64),
        Op::Gt => Ok((a > b) as i64),
        Op::Ge => Ok((a >= b) as i64),
        Op::Eq => Ok((a == b) as i64),
        Op::Ne => Ok((a != b) as i64),
    }
}

// The value of node `index`: the left operand is evaluated before the
// right one, and the first error stops the evaluation.
pub fn evaluate(tree: &Tree, index: i64, vars: &HashMap<[u8], i64>) -> Result<i64, EvalError> {
    match tree.nodes.get(index) {
        Node::Num(v) => Ok(v),
        Node::Var(name) => match vars.get(name) {
            Some(v) => Ok(v),
            None => Err(EvalError::UnknownVariable(name)),
        },
        Node::Neg(inner) => match evaluate(tree, inner, vars) {
            Ok(v) => Ok(-v),
            Err(e) => Err(e),
        },
        Node::Binary(op, left, right) => {
            let a = match evaluate(tree, left, vars) {
                Ok(v) => v,
                Err(e) => return Err(e),
            };
            let b = match evaluate(tree, right, vars) {
                Ok(v) => v,
                Err(e) => return Err(e),
            };
            apply(op, a, b)
        }
    }
}
