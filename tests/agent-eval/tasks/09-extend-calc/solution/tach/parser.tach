// Parses tokens into a tree, by recursive descent:
//
//   line       := 'let' NAME '=' expr | expr
//   expr       := relational (('==' | '!=') relational)*
//   relational := additive (('<' | '<=' | '>' | '>=') additive)*
//   additive   := term (('+' | '-') term)*
//   term       := unary (('*' | '/' | '%') unary)*
//   unary      := '-' unary | primary
//   primary    := NUMBER | NAME | '(' expr ')'
//
// The nodes live in one vector and refer to each other by index.

use crate::lexer::{Token, TokenKind};

pub enum Op {
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    Lt,
    Le,
    Gt,
    Ge,
    Eq,
    Ne,
}

pub enum Node {
    Num(i64),
    Var([u8]),
    Neg(i64),
    // An operator and the indices of its left and right operands.
    Binary(Op, i64, i64),
}

pub struct Tree {
    pub nodes: Vec<Node>,
    pub root: i64,
    // The variable a `let` line sets.
    pub let_name: Option<[u8]>,
}

struct Parser {
    tokens: Vec<Token>,
    pos: i64,
    nodes: Vec<Node>,
}

impl Parser {
    fn peek(self) -> TokenKind {
        self.tokens.get(self.pos).kind
    }

    fn advance(inout self) -> Token {
        let t = self.tokens.get(self.pos);
        if t.kind != TokenKind::End {
            self.pos += 1;
        }
        t
    }

    fn add(inout self, node: Node) -> i64 {
        self.nodes.push(node);
        self.nodes.len() - 1
    }

    fn binary(inout self, op: Op, left: i64, right: i64) -> i64 {
        self.add(Node::Binary(op, left, right))
    }

    fn expr(inout self) -> Option<i64> {
        var left = match self.relational() {
            Some(n) => n,
            None => return None,
        };
        loop {
            let op = match self.peek() {
                TokenKind::EqEq => Op::Eq,
                TokenKind::Ne => Op::Ne,
                _ => return Some(left),
            };
            self.advance();
            let right = match self.relational() {
                Some(n) => n,
                None => return None,
            };
            left = self.binary(op, left, right);
        }
    }

    fn relational(inout self) -> Option<i64> {
        var left = match self.additive() {
            Some(n) => n,
            None => return None,
        };
        loop {
            let op = match self.peek() {
                TokenKind::Lt => Op::Lt,
                TokenKind::Le => Op::Le,
                TokenKind::Gt => Op::Gt,
                TokenKind::Ge => Op::Ge,
                _ => return Some(left),
            };
            self.advance();
            let right = match self.additive() {
                Some(n) => n,
                None => return None,
            };
            left = self.binary(op, left, right);
        }
    }

    fn additive(inout self) -> Option<i64> {
        var left = match self.term() {
            Some(n) => n,
            None => return None,
        };
        loop {
            let op = match self.peek() {
                TokenKind::Plus => Op::Add,
                TokenKind::Minus => Op::Sub,
                _ => return Some(left),
            };
            self.advance();
            let right = match self.term() {
                Some(n) => n,
                None => return None,
            };
            left = self.binary(op, left, right);
        }
    }

    fn term(inout self) -> Option<i64> {
        var left = match self.unary() {
            Some(n) => n,
            None => return None,
        };
        loop {
            let op = match self.peek() {
                TokenKind::Star => Op::Mul,
                TokenKind::Slash => Op::Div,
                TokenKind::Percent => Op::Rem,
                _ => return Some(left),
            };
            self.advance();
            let right = match self.unary() {
                Some(n) => n,
                None => return None,
            };
            left = self.binary(op, left, right);
        }
    }

    fn unary(inout self) -> Option<i64> {
        if self.peek() == TokenKind::Minus {
            self.advance();
            let inner = match self.unary() {
                Some(n) => n,
                None => return None,
            };
            return Some(self.add(Node::Neg(inner)));
        }
        self.primary()
    }

    fn primary(inout self) -> Option<i64> {
        let t = self.advance();
        match t.kind {
            TokenKind::Num => Some(self.add(Node::Num(t.value))),
            TokenKind::Name => Some(self.add(Node::Var(t.name))),
            TokenKind::LParen => {
                let inner = match self.expr() {
                    Some(n) => n,
                    None => return None,
                };
                if self.advance().kind != TokenKind::RParen {
                    return None;
                }
                Some(inner)
            }
            _ => None,
        }
    }
}

// The tree of a whole line, or None when the tokens are not a line of
// the grammar.
pub fn parse(tokens: sink Vec<Token>, gpa: Gpa) -> Option<Tree> {
    var p = Parser { tokens: tokens, pos: 0, nodes: Vec::new_in(gpa) };
    var let_name: Option<[u8]> = None;
    if p.peek() == TokenKind::Let {
        p.advance();
        let name = p.advance();
        if name.kind != TokenKind::Name || p.advance().kind != TokenKind::Assign {
            return None;
        }
        let_name = Some(name.name);
    }
    let root = match p.expr() {
        Some(n) => n,
        None => {
            return None;
        }
    };
    if p.peek() != TokenKind::End {
        return None;
    }
    Some(Tree { nodes: p.nodes, root: root, let_name: let_name })
}
