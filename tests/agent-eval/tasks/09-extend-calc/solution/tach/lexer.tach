// Splits a line into tokens.

pub enum TokenKind {
    Num,
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    LParen,
    RParen,
    Lt,
    Le,
    Gt,
    Ge,
    EqEq,
    Ne,
    Assign,
    Name,
    Let,
    // After the last token of every line.
    End,
}

pub struct Token {
    pub kind: TokenKind,
    // The number's value, for Num; 0 for the others.
    pub value: i64,
    // The name, for Name; "" for the others.
    pub name: [u8],
}

fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn is_space(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\r'
}

fn is_name_start(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

// One token of a single character, if `c` starts one.
fn single(c: u8) -> Option<TokenKind> {
    match c {
        '+' => Some(TokenKind::Plus),
        '-' => Some(TokenKind::Minus),
        '*' => Some(TokenKind::Star),
        '/' => Some(TokenKind::Slash),
        '%' => Some(TokenKind::Percent),
        '(' => Some(TokenKind::LParen),
        ')' => Some(TokenKind::RParen),
        _ => None,
    }
}

// A token of one or two characters starting with `c` (`<`, `<=`, `=`,
// `==`, ...), and its length; `next` is the character after `c`, or 0.
fn operator(c: u8, next: u8) -> Option<(TokenKind, i64)> {
    let with_eq = next == '=';
    match c {
        '<' => Some(if with_eq { (TokenKind::Le, 2) } else { (TokenKind::Lt, 1) }),
        '>' => Some(if with_eq { (TokenKind::Ge, 2) } else { (TokenKind::Gt, 1) }),
        '=' => Some(if with_eq { (TokenKind::EqEq, 2) } else { (TokenKind::Assign, 1) }),
        '!' => if with_eq { Some((TokenKind::Ne, 2)) } else { None },
        _ => None,
    }
}

fn token(kind: TokenKind) -> Token {
    Token { kind: kind, value: 0, name: "" }
}

// The tokens of `line`, ending with End; None when a character starts no
// token. `#` starts a comment that runs to the end of the line.
pub fn tokenize(line: [u8], gpa: Gpa) -> Option<Vec<Token>> {
    let mut tokens: Vec<Token> = Vec::new_in(gpa);
    let mut i = 0;
    while i < line.len {
        let c = line[i];
        if is_space(c) {
            i += 1;
        } else if c == '#' {
            break;
        } else if is_digit(c) {
            let mut value = 0;
            while i < line.len && is_digit(line[i]) {
                value = value * 10 + (line[i] - '0') as i64;
                i += 1;
            }
            tokens.push(Token { kind: TokenKind::Num, value: value, name: "" });
        } else if is_name_start(c) {
            let start = i;
            while i < line.len && (is_name_start(line[i]) || is_digit(line[i])) {
                i += 1;
            }
            let name = line[start..i];
            if name == "let" {
                tokens.push(token(TokenKind::Let));
            } else {
                tokens.push(Token { kind: TokenKind::Name, value: 0, name: name });
            }
        } else {
            let next: u8 = if i + 1 < line.len { line[i + 1] } else { 0 };
            if let Some((kind, len)) = operator(c, next) {
                tokens.push(token(kind));
                i += len;
                continue;
            }
            match single(c) {
                Some(kind) => tokens.push(token(kind)),
                None => {
                    tokens.free();
                    return None;
                }
            }
            i += 1;
        }
    }
    tokens.push(token(TokenKind::End));
    Some(tokens)
}
