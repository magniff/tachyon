// Parses tokens into a tree, by recursive descent:
//
//   expr    := term (('+' | '-') term)*
//   term    := primary (('*' | '/') primary)*
//   primary := NUMBER | '(' expr ')'
//
// The nodes live in one vector and refer to each other by index.

use crate::lexer::{Token, TokenKind};

pub enum Op {
    Add,
    Sub,
    Mul,
    Div,
}

pub enum Node {
    Num(i64),
    // An operator and the indices of its left and right operands.
    Binary(Op, i64, i64),
}

pub struct Tree {
    pub nodes: Vec<Node>,
    pub root: i64,
}

struct Parser {
    tokens: Vec<Token>,
    pos: i64,
    nodes: Vec<Node>,
}

impl Parser {
    fn peek(self: &Parser) -> TokenKind {
        self.tokens.get(self.pos).kind
    }

    fn advance(self: &mut Parser) -> Token {
        let t = self.tokens.get(self.pos);
        if t.kind != TokenKind::End {
            self.pos += 1;
        }
        t
    }

    fn add(self: &mut Parser, node: Node) -> i64 {
        self.nodes.push(node);
        self.nodes.len() - 1
    }

    fn binary(self: &mut Parser, op: Op, left: i64, right: i64) -> i64 {
        self.add(Node::Binary(op, left, right))
    }

    fn expr(self: &mut Parser) -> Option<i64> {
        let mut left = match self.term() {
            Some(n) => n,
            None => return None,
        };
        loop {
            let op = match self.peek() {
                TokenKind::Plus => Op::Add,
                TokenKind::Minus => Op::Sub,
                _ => return Some(left),
            };
            self.advance();
            let right = match self.term() {
                Some(n) => n,
                None => return None,
            };
            left = self.binary(op, left, right);
        }
    }

    fn term(self: &mut Parser) -> Option<i64> {
        let mut left = match self.primary() {
            Some(n) => n,
            None => return None,
        };
        loop {
            let op = match self.peek() {
                TokenKind::Star => Op::Mul,
                TokenKind::Slash => Op::Div,
                _ => return Some(left),
            };
            self.advance();
            let right = match self.primary() {
                Some(n) => n,
                None => return None,
            };
            left = self.binary(op, left, right);
        }
    }

    fn primary(self: &mut Parser) -> Option<i64> {
        let t = self.advance();
        match t.kind {
            TokenKind::Num => Some(self.add(Node::Num(t.value))),
            TokenKind::LParen => {
                let inner = match self.expr() {
                    Some(n) => n,
                    None => return None,
                };
                if self.advance().kind != TokenKind::RParen {
                    return None;
                }
                Some(inner)
            }
            _ => None,
        }
    }
}

// The tree of a whole line, or None when the tokens are not an expression.
pub fn parse(tokens: Vec<Token>, gpa: Gpa) -> Option<Tree> {
    let mut p = Parser { tokens: tokens, pos: 0, nodes: Vec::new_in(gpa) };
    let root = match p.expr() {
        Some(n) => n,
        None => {
            return None;
        }
    };
    if p.peek() != TokenKind::End {
        return None;
    }
    Some(Tree { nodes: p.nodes, root: root })
}
