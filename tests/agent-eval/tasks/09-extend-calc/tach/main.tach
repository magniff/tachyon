// A line calculator: each line of stdin is an expression over 64-bit
// integers; its value (or an error) is printed on a line of its own.

mod eval;
mod lexer;
mod parser;

import "stdio.h" as c;

use eval::{EvalError, evaluate};
use lexer::tokenize;
use parser::parse;
use std::Buf;

fn read_all(gpa: Gpa) -> Buf {
    var b = Buf::new_in(gpa);
    loop {
        let ch = unsafe { c::getchar() };
        if ch < 0 {
            break;
        }
        b.push(ch as u8);
    }
    b
}

// Evaluates one line and appends the result line to `out`. A line with
// no tokens (blank, or only a comment) prints nothing.
fn run_line(line: [u8], out: inout Buf, gpa: Gpa) {
    var tokens = match tokenize(line, gpa) {
        Some(t) => t,
        None => {
            out.push_str("error: syntax\n");
            return;
        }
    };
    if tokens.len() == 1 {
        return; // only the end marker
    }
    var tree = match parse(tokens, gpa) {
        Some(t) => t,
        None => {
            out.push_str("error: syntax\n");
            return;
        }
    };
    match evaluate(tree, tree.root) {
        Ok(v) => {
            out.push_int(v);
            out.push('\n');
        }
        Err(EvalError::DivisionByZero) => out.push_str("error: division by zero\n"),
    }
}

fn main(gpa: Gpa) -> i32 {
    let input = read_all(gpa);
    let text = input.as_slice();
    var out = Buf::new_in(gpa);
    var start = 0;
    for i in 0..text.len() + 1 {
        if i == text.len() || text[i] == '\n' {
            run_line(text[start..i], &out, gpa);
            start = i + 1;
        }
    }
    print(out.as_slice());
    0
}
