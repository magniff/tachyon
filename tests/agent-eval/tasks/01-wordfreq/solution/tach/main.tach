// Word frequencies: the N most frequent words of the text on stdin.
use std::{Buf, HashMap, read_stdin_in, sort};

struct Entry {
    word: [u8],
    count: i64,
}

// Higher count first, then alphabetical.
fn cmp_entries(a: &Entry, b: &Entry) -> i64 {
    if a.count != b.count {
        return b.count - a.count;
    }
    a.word.cmp(&b.word)
}

impl Ord for Entry {
    fn cmp(self: &Entry, other: &Entry) -> i64 {
        cmp_entries(&*self, &*other)
    }
}

fn is_letter(ch: u8) -> bool {
    (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')
}

fn to_lower(ch: u8) -> u8 {
    if ch >= 'A' && ch <= 'Z' { ch + 32 } else { ch }
}

// The first line's number and the offset where the text starts.
fn parse_header(input: [u8]) -> (i64, i64) {
    let mut n = 0;
    let mut i = 0;
    while i < input.len() && input[i] != '\n' {
        let ch = input[i];
        if ch >= '0' && ch <= '9' {
            n = n * 10 + (ch - '0') as i64;
        }
        i += 1;
    }
    (n, i)
}

fn count_words(text: [u8], gpa: Gpa) -> HashMap<[u8], i64> {
    let mut counts: HashMap<[u8], i64> = HashMap::new_in(gpa);
    let mut start = 0;
    let mut in_word = false;
    for i in 0..text.len() + 1 {
        let letter = i < text.len() && is_letter(text[i]);
        if letter && !in_word {
            start = i;
            in_word = true;
        } else if !letter && in_word {
            let word = text[start..i];
            counts.get_or_insert(word, 0)[0] += 1;
            in_word = false;
        }
    }
    counts
}

fn main(gpa: Gpa) -> i32 {
    let mut buf = read_stdin_in(gpa).unwrap();
    let input = buf.as_mut_slice();
    let header = parse_header(input);
    let n = header.0;
    for i in header.1..input.len() {
        input[i] = to_lower(input[i]);
    }
    let text = input[header.1..];
    let mut counts = count_words(text, gpa);
    let mut entries: Vec<Entry> = Vec::new_in(gpa);
    for i in 0..counts.slots() {
        if let Some(word) = counts.key_at(i) {
            entries.push(Entry { word: word, count: counts.value_at(i).unwrap() });
        }
    }
    sort(entries.as_slice());
    let mut out = Buf::new_in(gpa);
    let mut i = 0;
    while i < entries.len() && i < n {
        let e = entries.get(i);
        out.push_str(e.word);
        out.push(' ');
        out.push_int(e.count);
        out.push('\n');
        i += 1;
    }
    print(out.as_slice());
    0
}
