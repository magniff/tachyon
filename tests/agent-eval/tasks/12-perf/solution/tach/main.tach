// Distinct values in ranges, offline: queries grouped by their right end,
// a Fenwick tree over positions that counts each value at its last
// occurrence so far. O((n + q) log n).

use std::{Buf, Scanner, read_stdin, sort};

struct Rng {
    x: u64,
}

impl Rng {
    fn next(self: *Rng) -> u64 {
        self.x = self.x * 6364136223846793005 + 1442695040888963407;
        self.x >> 33
    }
}

// A Vec of `len` copies of `x`.
fn filled<T>(len: i64, x: T) -> Vec<T> {
    let mut v: Vec<T> = Vec::with_capacity(len);
    for _ in 0..len {
        v.push(x);
    }
    v
}

// The index of `x` in the sorted `s`, which holds it.
fn find(s: [u64], x: u64) -> i64 {
    let mut lo = 0;
    let mut hi = s.len;
    while hi - lo > 1 {
        let mid = (lo + hi) / 2;
        if s[mid] <= x {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    lo
}

fn main() -> i32 {
    let mut input = read_stdin().unwrap();
    defer input.free();
    let mut sc = Scanner::new(input.as_slice());
    let n = sc.next_int().unwrap();
    let q = sc.next_int().unwrap();
    let m = sc.next_int().unwrap() as u64;
    let mut rng = Rng { x: sc.next_int().unwrap() as u64 };

    let mut av: Vec<u64> = Vec::with_capacity(n);
    defer av.free();
    for _ in 0..n {
        av.push(rng.next() % m);
    }
    let a = av.as_slice();
    // Values to ranks 0..k.
    let mut sv: Vec<u64> = Vec::with_capacity(n);
    defer sv.free();
    for x in a {
        sv.push(x);
    }
    sort(sv.as_slice());
    let s = sv.as_slice();
    let mut k = 0;
    for i in 0..n {
        if i == 0 || s[i] != s[k - 1] {
            s[k] = s[i];
            k += 1;
        }
    }
    let sorted = s[..k];
    let mut rankv: Vec<i32> = filled(n, 0i32);
    defer rankv.free();
    let rank = rankv.as_slice();
    for i in 0..n {
        rank[i] = find(sorted, a[i]) as i32;
    }

    // Queries as lists by right end: head[r], next[j].
    let mut qlv: Vec<i32> = filled(q, 0i32);
    defer qlv.free();
    let mut headv: Vec<i32> = filled(n, -1i32);
    defer headv.free();
    let mut nextv: Vec<i32> = filled(q, -1i32);
    defer nextv.free();
    let ql = qlv.as_slice();
    let head = headv.as_slice();
    let next = nextv.as_slice();
    for j in 0..q {
        let u = (rng.next() % n as u64) as i64;
        let v = (rng.next() % n as u64) as i64;
        let l = if u < v { u } else { v };
        let r = if u < v { v } else { u };
        ql[j] = l as i32;
        next[j] = head[r];
        head[r] = j as i32;
    }

    let mut treev: Vec<i32> = filled(n + 1, 0i32);
    defer treev.free();
    let mut lastv: Vec<i32> = filled(k, -1i32);
    defer lastv.free();
    let mut ansv: Vec<i64> = filled(q, 0);
    defer ansv.free();
    let tree = treev.as_slice();
    let last = lastv.as_slice();
    let ans = ansv.as_slice();
    for i in 0..n {
        let r = rank[i] as i64;
        if last[r] >= 0 {
            let mut p = last[r] as i64 + 1;
            while p <= n {
                tree[p] -= 1;
                p += p & -p;
            }
        }
        last[r] = i as i32;
        let mut p = i + 1;
        while p <= n {
            tree[p] += 1;
            p += p & -p;
        }
        let mut j = head[i] as i64;
        while j >= 0 {
            let l = ql[j] as i64;
            let mut sum = 0;
            let mut p = i + 1;
            while p > 0 {
                sum += tree[p] as i64;
                p -= p & -p;
            }
            p = l;
            while p > 0 {
                sum -= tree[p] as i64;
                p -= p & -p;
            }
            ans[j] = sum;
            j = next[j] as i64;
        }
    }

    let mut out = Buf::new();
    defer out.free();
    let mut total = 0;
    let mut hash = 0;
    for j in 0..q {
        if j < 10 {
            out.push_int(ans[j]);
            out.push('\n');
        }
        total += ans[j];
        hash = (hash * 1000003 + ans[j]) % 1000000007;
    }
    out.push_str("sum ");
    out.push_int(total);
    out.push_str("\nhash ");
    out.push_int(hash);
    out.push('\n');
    print(out.as_slice());
    0
}
