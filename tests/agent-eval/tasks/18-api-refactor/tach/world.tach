// The state that commands change: where the robot and the boxes are, the
// marks, the steps that can be undone, and the counters.

use crate::grid::{cell_index, partner, step, tile_at};
use crate::level::Level;

// One step of the robot, enough to take it back.
pub struct Step {
    // Where the robot was before the step.
    pub robot: (i64, i64),
    // The box it pushed (an index into World::boxes), or -1.
    pub moved_box: i64,
    // Where that box was before the push.
    pub box_from: (i64, i64),
}

pub struct World {
    pub robot: (i64, i64),
    pub boxes: Vec<(i64, i64)>,
    pub marks: Vec<(i64, i64)>,
    // Oldest first.
    pub history: Vec<Step>,
    pub moves: i64,
    pub pushes: i64,
}

impl World {
    pub fn new(level: &Level, gpa: Gpa) -> World {
        let mut w = World {
            robot: level.start,
            boxes: Vec::new_in(gpa),
            marks: Vec::new_in(gpa),
            history: Vec::new_in(gpa),
            moves: 0,
            pushes: 0,
        };
        w.reset(level);
        w
    }

    // Back to the level's start: robot, boxes, no marks, no history.
    pub fn reset(self: &mut World, level: &Level) {
        self.robot = level.start;
        self.boxes.clear();
        for i in 0..level.boxes.len() {
            self.boxes.push(level.boxes.get(i));
        }
        self.marks.clear();
        self.history.clear();
        self.moves = 0;
        self.pushes = 0;
    }

    // The index of the box at `p`, or -1.
    pub fn box_at(self: &World, p: (i64, i64)) -> i64 {
        for i in 0..self.boxes.len() {
            if self.boxes.get(i) == p {
                return i;
            }
        }
        -1
    }

    pub fn boxes_on_goals(self: &World, level: &Level) -> i64 {
        let mut n = 0;
        for i in 0..self.boxes.len() {
            if tile_at(level, self.boxes.get(i)) == 'G' {
                n += 1;
            }
        }
        n
    }

    // The fewest steps the robot needs from `from` to `to` without pushing
    // a box, teleporters included; -1 if it cannot get there.
    pub fn distance(self: &World, level: &Level, from: (i64, i64), to: (i64, i64), gpa: Gpa) -> i64 {
        if from == to {
            return 0;
        }
        let cells = level.height * level.width;
        let mut blocked: Vec<bool> = Vec::with_capacity_in(cells, gpa);
        let mut dist: Vec<i64> = Vec::with_capacity_in(cells, gpa);
        for i in 0..cells {
            blocked.push(false);
            dist.push(-1);
        }
        for i in 0..self.boxes.len() {
            blocked.set(cell_index(level, self.boxes.get(i)), true);
        }
        let mut queue: Vec<(i64, i64)> = Vec::new_in(gpa);
        dist.set(cell_index(level, from), 0);
        queue.push(from);
        let dirs = "NSEW";
        let mut head = 0;
        while head < queue.len() {
            let p = queue.get(head);
            head += 1;
            let d = dist.get(cell_index(level, p));
            for k in 0..4 {
                let mut q = step(p, dirs[k]);
                if tile_at(level, q) == '#' || blocked.get(cell_index(level, q)) {
                    continue;
                }
                if tile_at(level, q) == 'T' {
                    let t = partner(level, q);
                    if !blocked.get(cell_index(level, t)) {
                        q = t;
                    }
                }
                let qi = cell_index(level, q);
                if dist.get(qi) < 0 {
                    dist.set(qi, d + 1);
                    if q == to {
                        return d + 1;
                    }
                    queue.push(q);
                }
            }
        }
        -1
    }
}
