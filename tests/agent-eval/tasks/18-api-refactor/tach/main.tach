// A warehouse robot: reads a map and then commands from stdin, moves the
// robot around (pushing boxes, taking teleporters), and prints what the
// commands ask for. Everything printed goes through `out`.

mod grid;
mod level;
mod report;
mod world;

import "unistd.h" as c;
use grid::{in_bounds, partner, push_pos, step, tile_at};
use level::{Level, load_level};
use report::{push_load_error, push_map, push_status, push_summary};
use std::{Buf, sort};
use world::{Step, World};

// All of stdin.
fn read_all(gpa: Gpa) -> Buf {
    let mut b = Buf::new_in(gpa);
    let mut chunk = [0u8; 65536];
    loop {
        let n = unsafe { c::read(0, &chunk[0] as *u8, 65536) } as i64;
        if n <= 0 {
            break;
        }
        b.push_str(chunk[0..n]);
    }
    b
}

// The input's lines, without their line ends ("\n" or "\r\n").
fn split_lines(text: [u8], gpa: Gpa) -> Vec<[u8]> {
    let mut lines: Vec<[u8]> = Vec::new_in(gpa);
    let mut start = 0;
    for i in 0..text.len() + 1 {
        if i == text.len() || text[i] == '\n' {
            if i == text.len() && start == i {
                break;
            }
            let mut end = i;
            if end > start && text[end - 1] == '\r' {
                end -= 1;
            }
            lines.push(text[start..end]);
            start = i + 1;
        }
    }
    lines
}

// A number of 1 to 9 digits, or -1.
fn parse_num(word: [u8]) -> i64 {
    if word.len() == 0 || word.len() > 9 {
        return -1;
    }
    let mut n = 0;
    for ch in word {
        if ch < '0' || ch > '9' {
            return -1;
        }
        n = n * 10 + (ch - '0') as i64;
    }
    n
}

// Runs the commands: the lines after the map's '---' line. `first` is
// the index of the first of them in `lines`; line numbers in messages
// count every line of the input from 1.
fn run_commands(level: &Level, world: &mut World, lines: [[u8]], first: i64, out: &mut Buf,
    gpa: Gpa) {
    for li in first..lines.len() {
        let line = lines[li];
        let number = li + 1;
        // The words, separated by runs of spaces.
        let mut words: Vec<[u8]> = Vec::new_in(gpa);
        let mut i = 0;
        while i < line.len() {
            if line[i] == ' ' {
                i += 1;
                continue;
            }
            let start = i;
            while i < line.len() && line[i] != ' ' {
                i += 1;
            }
            words.push(line[start..i]);
        }
        if words.len() == 0 || words.get(0)[0] == '#' {
            continue;
        }
        let cmd = words.get(0);
        let nargs = words.len() - 1;
        if cmd == "N" || cmd == "S" || cmd == "E" || cmd == "W" {
            // Up to `count` steps; the first blocked step ends the command.
            if nargs > 1 {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": bad arguments\n");
                continue;
            }
            let mut count = 1;
            if nargs == 1 {
                count = parse_num(words.get(1));
                if count < 1 {
                    out.push_str("line ");
                    out.push_int(number);
                    out.push_str(": bad count\n");
                    continue;
                }
            }
            let dir = cmd[0];
            let mut done = 0;
            while done < count {
                let next = step(world.robot, dir);
                if tile_at(level, next) == '#' {
                    break;
                }
                let b = world.box_at(next);
                if b >= 0 {
                    let beyond = step(next, dir);
                    if tile_at(level, beyond) == '#' || world.box_at(beyond) >= 0 {
                        break;
                    }
                    world.history.push(Step { robot: world.robot, moved_box: b, box_from: next });
                    world.boxes.set(b, beyond);
                    world.pushes += 1;
                } else {
                    world.history.push(Step {
                        robot: world.robot, moved_box: -1, box_from: (0, 0)
                    });
                }
                world.robot = next;
                if tile_at(level, next) == 'T' {
                    let other = partner(level, next);
                    if world.box_at(other) < 0 {
                        world.robot = other;
                    }
                }
                world.moves += 1;
                done += 1;
            }
            if done < count {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": blocked after ");
                out.push_int(done);
                out.push_str(" of ");
                out.push_int(count);
                out.push_str(" at ");
                push_pos(out, world.robot);
                out.push('\n');
            }
        } else if cmd == "UNDO" {
            // Takes back up to `count` steps, newest first.
            if nargs > 1 {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": bad arguments\n");
                continue;
            }
            let mut count = 1;
            if nargs == 1 {
                count = parse_num(words.get(1));
                if count < 1 {
                    out.push_str("line ");
                    out.push_int(number);
                    out.push_str(": bad count\n");
                    continue;
                }
            }
            if world.history.len() == 0 {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": nothing to undo\n");
                continue;
            }
            let mut undone = 0;
            while undone < count {
                let s = match world.history.pop() {
                    Some(s) => s,
                    None => break,
                };
                world.robot = s.robot;
                if s.moved_box >= 0 {
                    world.boxes.set(s.moved_box, s.box_from);
                    world.pushes -= 1;
                }
                world.moves -= 1;
                undone += 1;
            }
        } else if cmd == "RESET" {
            if nargs != 0 {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": bad arguments\n");
                continue;
            }
            world.reset(level);
        } else if cmd == "WHERE" {
            if nargs != 0 {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": bad arguments\n");
                continue;
            }
            out.push_str("robot at ");
            push_pos(out, world.robot);
            out.push('\n');
        } else if cmd == "BOXES" {
            // Sorted by row, then column.
            if nargs != 0 {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": bad arguments\n");
                continue;
            }
            out.push_str("boxes:");
            if world.boxes.len() == 0 {
                out.push_str(" none");
            }
            let mut keys: Vec<i64> = Vec::new_in(gpa);
            for k in 0..world.boxes.len() {
                let b = world.boxes.get(k);
                keys.push(b.0 * level.width + b.1);
            }
            keys.sort();
            for k in 0..keys.len() {
                let p = (keys.get(k) / level.width, keys.get(k) % level.width);
                out.push(' ');
                push_pos(out, p);
            }
            out.push('\n');
        } else if cmd == "MARK" {
            if nargs != 0 {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": bad arguments\n");
                continue;
            }
            world.marks.push(world.robot);
            out.push_str("mark ");
            out.push_int(world.marks.len());
            out.push_str(" at ");
            push_pos(out, world.robot);
            out.push('\n');
        } else if cmd == "MARKS" {
            if nargs != 0 {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": bad arguments\n");
                continue;
            }
            out.push_str("marks:");
            if world.marks.len() == 0 {
                out.push_str(" none");
            }
            for k in 0..world.marks.len() {
                out.push(' ');
                out.push_int(k + 1);
                out.push('=');
                push_pos(out, world.marks.get(k));
            }
            out.push('\n');
        } else if cmd == "DIST" {
            // The fewest steps from the robot to a row and column.
            if nargs != 2 {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": bad arguments\n");
                continue;
            }
            let r = parse_num(words.get(1));
            let c = parse_num(words.get(2));
            let target = (r, c);
            if r < 0 || c < 0 || !in_bounds(level, target) {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": bad position\n");
                continue;
            }
            let d = world.distance(level, world.robot, target, gpa);
            out.push_str("dist ");
            push_pos(out, target);
            if d < 0 {
                out.push_str(": unreachable\n");
            } else {
                out.push_str(": ");
                out.push_int(d);
                out.push('\n');
            }
        } else if cmd == "GOTO" {
            // Walks to a mark by a shortest path; the walk cannot be undone.
            if nargs != 1 {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": bad arguments\n");
                continue;
            }
            let k = parse_num(words.get(1));
            if k < 0 {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": bad arguments\n");
                continue;
            }
            if k < 1 || k > world.marks.len() {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": no mark ");
                out.push_int(k);
                out.push('\n');
                continue;
            }
            let target = world.marks.get(k - 1);
            let d = world.distance(level, world.robot, target, gpa);
            if d < 0 {
                out.push_str("goto ");
                out.push_int(k);
                out.push_str(": unreachable\n");
                continue;
            }
            world.robot = target;
            world.moves += d;
            world.history.clear();
            out.push_str("goto ");
            out.push_int(k);
            out.push_str(": ");
            out.push_int(d);
            out.push_str(" moves\n");
        } else if cmd == "HISTORY" {
            if nargs != 0 {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": bad arguments\n");
                continue;
            }
            out.push_str("history ");
            out.push_int(world.history.len());
            out.push('\n');
        } else if cmd == "SHOW" {
            if nargs != 0 {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": bad arguments\n");
                continue;
            }
            push_map(out, level, world, gpa);
        } else if cmd == "STATUS" {
            if nargs != 0 {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": bad arguments\n");
                continue;
            }
            push_status(out, level, world);
        } else {
            out.push_str("line ");
            out.push_int(number);
            out.push_str(": unknown command '");
            out.push_str(cmd);
            out.push_str("'\n");
        }
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut input = read_all(gpa);
    let mut lines = split_lines(input.as_slice(), gpa);
    let mut out = Buf::new_in(gpa);
    let mut level = Level::new(gpa);
    let code = load_level(lines.as_slice(), &mut level);
    if code != 0 {
        push_load_error(&mut out, code, &level);
    } else {
        push_summary(&mut out, &level);
        let mut world = World::new(&level, gpa);
        run_commands(&level, &mut world, lines.as_slice(), level.map_lines + 1, &mut out, gpa);
        out.push_str("final: ");
        push_status(&mut out, &level, &world);
    }
    print(out.as_slice());
    0
}
