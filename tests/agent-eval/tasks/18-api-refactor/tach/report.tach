// What the program prints about a level and its state.

use crate::grid::{cell_index, push_pos, tile_at};
use crate::level::{
    ERR_EMPTY, ERR_MANY_ROBOTS, ERR_NO_ROBOT, ERR_NO_SEPARATOR, ERR_ODD_TELEPORTERS, ERR_RAGGED,
    ERR_UNKNOWN_TILE, Level,
};
use crate::world::World;
use std::Buf;

// The line for a load_level error code.
pub fn push_load_error(out: &mut Buf, code: i64, level: &Level) {
    out.push_str("error: ");
    if code == ERR_EMPTY {
        out.push_str("the map is empty");
    } else if code == ERR_NO_SEPARATOR {
        out.push_str("no '---' line after the map");
    } else if code == ERR_RAGGED {
        out.push_str("row ");
        out.push_int(level.error_at.0);
        out.push_str(" has length ");
        out.push_int(level.error_num);
        out.push_str(", expected ");
        out.push_int(level.width);
    } else if code == ERR_UNKNOWN_TILE {
        out.push_str("unknown tile '");
        out.push(level.error_tile);
        out.push_str("' at ");
        push_pos(out, level.error_at);
    } else if code == ERR_NO_ROBOT {
        out.push_str("no robot on the map");
    } else if code == ERR_MANY_ROBOTS {
        out.push_str("second robot at ");
        push_pos(out, level.error_at);
    } else if code == ERR_ODD_TELEPORTERS {
        out.push_int(level.error_num);
        out.push_str(" teleporters, expected an even number");
    }
    out.push('\n');
}

// "level WxH, B boxes, G goals, T teleporters"
pub fn push_summary(out: &mut Buf, level: &Level) {
    out.push_str("level ");
    out.push_int(level.width);
    out.push('x');
    out.push_int(level.height);
    out.push_str(", ");
    out.push_int(level.boxes.len());
    out.push_str(" boxes, ");
    out.push_int(level.goals.len());
    out.push_str(" goals, ");
    out.push_int(level.teleporters.len());
    out.push_str(" teleporters\n");
}

// "moves M, pushes P, boxes on goals B/N", and " (solved)" when every
// box is on a goal.
pub fn push_status(out: &mut Buf, level: &Level, world: &World) {
    let on = world.boxes_on_goals(level);
    let n = world.boxes.len();
    out.push_str("moves ");
    out.push_int(world.moves);
    out.push_str(", pushes ");
    out.push_int(world.pushes);
    out.push_str(", boxes on goals ");
    out.push_int(on);
    out.push('/');
    out.push_int(n);
    if n > 0 && on == n {
        out.push_str(" (solved)");
    }
    out.push('\n');
}

// The map as it is now: '@' the robot, '$' a box, '*' a box on a goal.
pub fn push_map(out: &mut Buf, level: &Level, world: &World, gpa: Gpa) {
    let mut cells: Vec<u8> = Vec::new_in(gpa);
    for i in 0..level.tiles.len() {
        cells.push(level.tiles.get(i));
    }
    for i in 0..world.boxes.len() {
        let b = world.boxes.get(i);
        let k = cell_index(level, b);
        cells.set(k, if tile_at(level, b) == 'G' { '*' } else { '$' });
    }
    cells.set(cell_index(level, world.robot), '@');
    for r in 0..level.height {
        for c in 0..level.width {
            out.push(cells.get(cell_index(level, (r, c))));
        }
        out.push('\n');
    }
}
