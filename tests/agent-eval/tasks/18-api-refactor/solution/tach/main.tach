// A warehouse robot: reads a map and then commands from stdin, moves the
// robot around (pushing boxes, taking teleporters), and prints what the
// commands ask for. Everything printed goes through `out`.

mod grid;
mod level;
mod report;
mod world;

import "unistd.h" as c;
use grid::{Pos, in_bounds, partner, push_pos, step, tile_at};
use level::{Level, load_level};
use report::{push_load_error, push_map, push_status, push_summary};
use std::{Buf, sort};
use world::{Step, World};

// One command line, parsed.
enum Command {
    // A blank line or a comment.
    Skip,
    // A line that is not a command: the message after "line N: ".
    Fail([u8]),
    Unknown([u8]),
    // A direction and a count.
    Move(u8, i64),
    Undo(i64),
    Reset,
    Where,
    Boxes,
    Mark,
    Marks,
    Dist(Pos),
    Goto(i64),
    History,
    Show,
    Status,
}

// All of stdin.
fn read_all(gpa: Gpa) -> Buf {
    var b = Buf::new_in(gpa);
    var chunk = [0u8; 65536];
    loop {
        let n = unsafe { c::read(0, &chunk[0] as *u8, 65536) } as i64;
        if n <= 0 {
            break;
        }
        b.push_str(chunk[0..n]);
    }
    b
}

// The input's lines, without their line ends ("\n" or "\r\n").
fn split_lines(text: [u8], gpa: Gpa) -> Vec<[u8]> {
    var lines: Vec<[u8]> = Vec::new_in(gpa);
    var start = 0;
    for i in 0..text.len() + 1 {
        if i == text.len() || text[i] == '\n' {
            if i == text.len() && start == i {
                break;
            }
            var end = i;
            if end > start && text[end - 1] == '\r' {
                end -= 1;
            }
            lines.push(text[start..end]);
            start = i + 1;
        }
    }
    lines
}

// A number of 1 to 9 digits, or -1.
fn parse_num(word: [u8]) -> i64 {
    if word.len() == 0 || word.len() > 9 {
        return -1;
    }
    var n = 0;
    for ch in word {
        if ch < '0' || ch > '9' {
            return -1;
        }
        n = n * 10 + (ch - '0') as i64;
    }
    n
}

// The optional count of a move or UNDO (1 when there is none), or why
// it is bad.
fn parse_count(words: Vec<[u8]>) -> Result<i64, [u8]> {
    if words.len() > 2 {
        return Err("bad arguments");
    }
    if words.len() == 1 {
        return Ok(1);
    }
    let count = parse_num(words.get(1));
    if count < 1 {
        return Err("bad count");
    }
    Ok(count)
}

// Turns a line into a command.
fn parse_command(level: Level, line: [u8], gpa: Gpa) -> Command {
    // The words, separated by runs of spaces.
    var words: Vec<[u8]> = Vec::new_in(gpa);
    var i = 0;
    while i < line.len() {
        if line[i] == ' ' {
            i += 1;
            continue;
        }
        let start = i;
        while i < line.len() && line[i] != ' ' {
            i += 1;
        }
        words.push(line[start..i]);
    }
    if words.len() == 0 || words.get(0)[0] == '#' {
        return Command::Skip;
    }
    let cmd = words.get(0);
    let nargs = words.len() - 1;
    if cmd == "N" || cmd == "S" || cmd == "E" || cmd == "W" {
        return match parse_count(words) {
            Ok(n) => Command::Move(cmd[0], n),
            Err(m) => Command::Fail(m),
        };
    }
    if cmd == "UNDO" {
        return match parse_count(words) {
            Ok(n) => Command::Undo(n),
            Err(m) => Command::Fail(m),
        };
    }
    if cmd == "DIST" {
        if nargs != 2 {
            return Command::Fail("bad arguments");
        }
        let target = Pos::new(parse_num(words.get(1)), parse_num(words.get(2)));
        if target.row < 0 || target.col < 0 || !in_bounds(level, target) {
            return Command::Fail("bad position");
        }
        return Command::Dist(target);
    }
    if cmd == "GOTO" {
        if nargs != 1 {
            return Command::Fail("bad arguments");
        }
        let k = parse_num(words.get(1));
        if k < 0 {
            return Command::Fail("bad arguments");
        }
        return Command::Goto(k);
    }
    let plain = if cmd == "RESET" {
        Command::Reset
    } else if cmd == "WHERE" {
        Command::Where
    } else if cmd == "BOXES" {
        Command::Boxes
    } else if cmd == "MARK" {
        Command::Mark
    } else if cmd == "MARKS" {
        Command::Marks
    } else if cmd == "HISTORY" {
        Command::History
    } else if cmd == "SHOW" {
        Command::Show
    } else if cmd == "STATUS" {
        Command::Status
    } else {
        return Command::Unknown(cmd);
    };
    if nargs != 0 {
        return Command::Fail("bad arguments");
    }
    plain
}

// The commands that move the robot or the boxes: the moves, UNDO, RESET
// and GOTO. Returns false if `cmd` is not one of them.
fn apply_move(level: Level, world: inout World, cmd: Command, number: i64, out: inout Buf, gpa: Gpa) -> bool {
    match cmd {
        Command::Move(dir, count) => {
            // Up to `count` steps; the first blocked step ends the command.
            var done = 0;
            while done < count {
                let next = step(world.robot, dir);
                if tile_at(level, next) == '#' {
                    break;
                }
                let b = world.box_at(next);
                if b >= 0 {
                    let beyond = step(next, dir);
                    if tile_at(level, beyond) == '#' || world.box_at(beyond) >= 0 {
                        break;
                    }
                    world.history.push(Step { robot: world.robot, moved_box: b, box_from: next });
                    world.boxes.set(b, beyond);
                    world.pushes += 1;
                } else {
                    world.history.push(Step {
                        robot: world.robot, moved_box: -1, box_from: Pos::new(0, 0)
                    });
                }
                world.robot = next;
                if tile_at(level, next) == 'T' {
                    let other = partner(level, next);
                    if world.box_at(other) < 0 {
                        world.robot = other;
                    }
                }
                world.moves += 1;
                done += 1;
            }
            if done < count {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": blocked after ");
                out.push_int(done);
                out.push_str(" of ");
                out.push_int(count);
                out.push_str(" at ");
                push_pos(&out, world.robot);
                out.push('\n');
            }
        }
        Command::Undo(count) => {
            // Takes back up to `count` steps, newest first.
            if world.history.len() == 0 {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": nothing to undo\n");
                return true;
            }
            var undone = 0;
            while undone < count {
                let s = match world.history.pop() {
                    Some(s) => s,
                    None => break,
                };
                world.robot = s.robot;
                if s.moved_box >= 0 {
                    world.boxes.set(s.moved_box, s.box_from);
                    world.pushes -= 1;
                }
                world.moves -= 1;
                undone += 1;
            }
        }
        Command::Reset => world.reset(level),
        Command::Goto(k) => {
            // Walks to a mark by a shortest path; the walk cannot be undone.
            if k < 1 || k > world.marks.len() {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": no mark ");
                out.push_int(k);
                out.push('\n');
                return true;
            }
            let target = world.marks.get(k - 1);
            let d = world.distance(level, world.robot, target, gpa);
            if d < 0 {
                out.push_str("goto ");
                out.push_int(k);
                out.push_str(": unreachable\n");
                return true;
            }
            world.robot = target;
            world.moves += d;
            world.history.clear();
            out.push_str("goto ");
            out.push_int(k);
            out.push_str(": ");
            out.push_int(d);
            out.push_str(" moves\n");
        }
        _ => return false,
    }
    true
}

// The commands that only look (and MARK, which only remembers).
fn apply_query(level: Level, world: inout World, cmd: Command, out: inout Buf, gpa: Gpa) {
    match cmd {
        Command::Where => {
            out.push_str("robot at ");
            push_pos(&out, world.robot);
            out.push('\n');
        }
        Command::Boxes => {
            // Sorted by row, then column.
            out.push_str("boxes:");
            if world.boxes.len() == 0 {
                out.push_str(" none");
            }
            var keys: Vec<i64> = Vec::new_in(gpa);
            for k in 0..world.boxes.len() {
                let b = world.boxes.get(k);
                keys.push(b.row * level.width + b.col);
            }
            keys.sort();
            for k in 0..keys.len() {
                out.push(' ');
                push_pos(&out, Pos::new(keys.get(k) / level.width, keys.get(k) % level.width));
            }
            out.push('\n');
        }
        Command::Mark => {
            world.marks.push(world.robot);
            out.push_str("mark ");
            out.push_int(world.marks.len());
            out.push_str(" at ");
            push_pos(&out, world.robot);
            out.push('\n');
        }
        Command::Marks => {
            out.push_str("marks:");
            if world.marks.len() == 0 {
                out.push_str(" none");
            }
            for k in 0..world.marks.len() {
                out.push(' ');
                out.push_int(k + 1);
                out.push('=');
                push_pos(&out, world.marks.get(k));
            }
            out.push('\n');
        }
        Command::Dist(target) => {
            // The fewest steps from the robot to a row and column.
            let d = world.distance(level, world.robot, target, gpa);
            out.push_str("dist ");
            push_pos(&out, target);
            if d < 0 {
                out.push_str(": unreachable\n");
            } else {
                out.push_str(": ");
                out.push_int(d);
                out.push('\n');
            }
        }
        Command::History => {
            out.push_str("history ");
            out.push_int(world.history.len());
            out.push('\n');
        }
        Command::Show => push_map(&out, level, world, gpa),
        Command::Status => push_status(&out, level, world),
        _ => {}
    }
}

// Runs the commands: the lines after the map's '---' line. `first` is
// the index of the first of them in `lines`; line numbers in messages
// count every line of the input from 1.
fn run_commands(level: Level, world: inout World, lines: [[u8]], first: i64, out: inout Buf,
    gpa: Gpa) {
    for li in first..lines.len() {
        let number = li + 1;
        let cmd = parse_command(level, lines[li], gpa);
        match cmd {
            Command::Skip => {}
            Command::Fail(m) => {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": ");
                out.push_str(m);
                out.push('\n');
            }
            Command::Unknown(w) => {
                out.push_str("line ");
                out.push_int(number);
                out.push_str(": unknown command '");
                out.push_str(w);
                out.push_str("'\n");
            }
            _ => {
                if !apply_move(level, &world, cmd, number, &out, gpa) {
                    apply_query(level, &world, cmd, &out, gpa);
                }
            }
        }
    }
}

fn main(gpa: Gpa) -> i32 {
    var input = read_all(gpa);
    var lines = split_lines(input.as_slice(), gpa);
    var out = Buf::new_in(gpa);
    match load_level(lines.as_slice(), gpa) {
        Err(e) => push_load_error(&out, e),
        Ok(level) => {
            push_summary(&out, level);
            var world = World::new(level, gpa);
            run_commands(level, &world, lines.as_slice(), level.map_lines + 1, &out, gpa);
            out.push_str("final: ");
            push_status(&out, level, world);
        }
    }
    print(out.as_slice());
    0
}
