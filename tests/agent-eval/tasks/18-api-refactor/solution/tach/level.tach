// The level: the map's tiles, where the robot starts, the boxes, the goals
// and the teleporters, and `load_level`, which reads them from the input.

use crate::grid::Pos;

// Why load_level refused a map.
pub enum LoadError {
    EmptyMap,
    NoSeparator,
    // The row, its length, the length expected (the first row's).
    RaggedRow(i64, i64, i64),
    // Where, the tile.
    UnknownTile(Pos, u8),
    NoRobot,
    // Where the second robot is.
    SecondRobot(Pos),
    // How many teleporters there are.
    OddTeleporters(i64),
}

pub struct Level {
    pub height: i64,
    pub width: i64,
    // Row by row: '#' wall, '.' floor, 'G' goal, 'T' teleporter. The robot
    // and the boxes are not in it: their tiles are floor or goal.
    pub tiles: Vec<u8>,
    pub start: Pos,
    // Each in reading order (row by row, left to right).
    pub boxes: Vec<Pos>,
    pub goals: Vec<Pos>,
    pub teleporters: Vec<Pos>,
    // The number of map lines; the '---' line comes after them.
    pub map_lines: i64,
}

impl Level {
    pub fn new(gpa: Gpa) -> Level {
        Level {
            height: 0,
            width: 0,
            tiles: Vec::new_in(gpa),
            start: Pos::new(0, 0),
            boxes: Vec::new_in(gpa),
            goals: Vec::new_in(gpa),
            teleporters: Vec::new_in(gpa),
            map_lines: 0,
        }
    }
}

// Reads the map from the input's lines: the lines before the first '---'
// line.
pub fn load_level(lines: [[u8]], gpa: Gpa) -> Result<Level, LoadError> {
    let mut sep = -1;
    for i in 0..lines.len {
        if lines[i] == "---" {
            sep = i;
            break;
        }
    }
    if sep < 0 {
        return Err(LoadError::NoSeparator);
    }
    if sep == 0 || lines[0].len == 0 {
        return Err(LoadError::EmptyMap);
    }
    let mut level = Level::new(gpa);
    level.map_lines = sep;
    level.height = sep;
    level.width = lines[0].len;
    let mut robots = 0;
    for r in 0..sep {
        let row = lines[r];
        if row.len != level.width {
            return Err(LoadError::RaggedRow(r, row.len, level.width));
        }
        for c in 0..level.width {
            let t = row[c];
            let here = Pos::new(r, c);
            let mut tile = t;
            if t == '@' {
                robots += 1;
                if robots > 1 {
                    return Err(LoadError::SecondRobot(here));
                }
                level.start = here;
                tile = '.';
            } else if t == '$' {
                level.boxes.push(here);
                tile = '.';
            } else if t == '*' {
                level.boxes.push(here);
                level.goals.push(here);
                tile = 'G';
            } else if t == 'G' {
                level.goals.push(here);
            } else if t == 'T' {
                level.teleporters.push(here);
            } else if t != '#' && t != '.' {
                return Err(LoadError::UnknownTile(here, t));
            }
            level.tiles.push(tile);
        }
    }
    if robots == 0 {
        return Err(LoadError::NoRobot);
    }
    if level.teleporters.len() % 2 == 1 {
        return Err(LoadError::OddTeleporters(level.teleporters.len()));
    }
    Ok(level)
}
