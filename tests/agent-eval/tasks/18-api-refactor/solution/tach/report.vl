// What the program prints about a level and its state.

use crate::grid::{Pos, cell_index, push_pos, tile_at};
use crate::level::{Level, LoadError};
use crate::world::World;
use std::Buf;

// The line for a load_level error.
pub fn push_load_error(out: inout Buf, err: LoadError) {
    out.push_str("error: ");
    match err {
        LoadError::EmptyMap => out.push_str("the map is empty"),
        LoadError::NoSeparator => out.push_str("no '---' line after the map"),
        LoadError::RaggedRow(row, len, width) => {
            out.push_str("row ");
            out.push_int(row);
            out.push_str(" has length ");
            out.push_int(len);
            out.push_str(", expected ");
            out.push_int(width);
        }
        LoadError::UnknownTile(at, tile) => {
            out.push_str("unknown tile '");
            out.push(tile);
            out.push_str("' at ");
            push_pos(&out, at);
        }
        LoadError::NoRobot => out.push_str("no robot on the map"),
        LoadError::SecondRobot(at) => {
            out.push_str("second robot at ");
            push_pos(&out, at);
        }
        LoadError::OddTeleporters(n) => {
            out.push_int(n);
            out.push_str(" teleporters, expected an even number");
        }
    }
    out.push('\n');
}

// "level WxH, B boxes, G goals, T teleporters"
pub fn push_summary(out: inout Buf, level: Level) {
    out.push_str("level ");
    out.push_int(level.width);
    out.push('x');
    out.push_int(level.height);
    out.push_str(", ");
    out.push_int(level.boxes.len());
    out.push_str(" boxes, ");
    out.push_int(level.goals.len());
    out.push_str(" goals, ");
    out.push_int(level.teleporters.len());
    out.push_str(" teleporters\n");
}

// "moves M, pushes P, boxes on goals B/N", and " (solved)" when every
// box is on a goal.
pub fn push_status(out: inout Buf, level: Level, world: World) {
    let on = world.boxes_on_goals(level);
    let n = world.boxes.len();
    out.push_str("moves ");
    out.push_int(world.moves);
    out.push_str(", pushes ");
    out.push_int(world.pushes);
    out.push_str(", boxes on goals ");
    out.push_int(on);
    out.push('/');
    out.push_int(n);
    if n > 0 && on == n {
        out.push_str(" (solved)");
    }
    out.push('\n');
}

// The map as it is now: '@' the robot, '$' a box, '*' a box on a goal.
pub fn push_map(out: inout Buf, level: Level, world: World, gpa: Gpa) {
    var cells: Vec<u8> = Vec::new_in(gpa);
    for i in 0..level.tiles.len() {
        cells.push(level.tiles.get(i));
    }
    for i in 0..world.boxes.len() {
        let b = world.boxes.get(i);
        let k = cell_index(level, b);
        cells.set(k, if tile_at(level, b) == 'G' { '*' } else { '$' });
    }
    cells.set(cell_index(level, world.robot), '@');
    for r in 0..level.height {
        for c in 0..level.width {
            out.push(cells.get(cell_index(level, Pos::new(r, c))));
        }
        out.push('\n');
    }
}
