// Cells within reach: a generated grid of open cells and walls, and many
// bounded breadth-first searches on it. Correct, but too slow on the
// large tests.

import "unistd.h" as c;

use std::{Buf, HashMap};

struct Rng {
    x: u64,
}

impl Rng {
    fn next(self: *Rng) -> u64 {
        self.x = self.x * 6364136223846793005 + 1442695040888963407;
        self.x >> 33
    }
}

// All of stdin.
fn read_all() -> Buf {
    let mut b = Buf::new();
    let mut chunk = [0u8; 65536];
    loop {
        let n = unsafe { c::read(0, &chunk[0] as *u8, 65536) } as i64;
        if n <= 0 {
            break;
        }
        b.push_str(chunk[0..n]);
    }
    b
}

// Parses the unsigned integers of the input line.
fn numbers(text: [u8]) -> Vec<u64> {
    let mut out: Vec<u64> = Vec::new();
    let mut i = 0;
    while i < text.len {
        if text[i] >= '0' && text[i] <= '9' {
            let mut v: u64 = 0;
            while i < text.len && text[i] >= '0' && text[i] <= '9' {
                v = v * 10 + (text[i] - '0') as u64;
                i += 1;
            }
            out.push(v);
        } else {
            i += 1;
        }
    }
    out
}

struct Step {
    r: i64,
    c: i64,
    dist: i64,
}

// The number of open cells at most d steps from cell (r, c).
fn reach(grid: *Vec<Vec<bool>>, r: i64, c: i64, d: i64) -> i64 {
    let h = grid.len();
    let w = grid.get(0).len();
    if !grid.get(r).get(c) {
        return 0;
    }
    let mut seen: HashMap<i64, bool> = HashMap::new();
    defer seen.free();
    let mut queue: Vec<Step> = Vec::new();
    defer queue.free();
    seen.insert(r * w + c, true);
    queue.push(Step { r: r, c: c, dist: 0 });
    let mut head = 0;
    while head < queue.len() {
        let s = queue.get(head);
        head += 1;
        if s.dist == d {
            continue;
        }
        let moves = [(-1, 0), (1, 0), (0, -1), (0, 1)];
        for m in moves {
            let nr = s.r + m.0;
            let nc = s.c + m.1;
            if nr < 0 || nr >= h || nc < 0 || nc >= w {
                continue;
            }
            if !grid.get(nr).get(nc) {
                continue;
            }
            if seen.contains(nr * w + nc) {
                continue;
            }
            seen.insert(nr * w + nc, true);
            queue.push(Step { r: nr, c: nc, dist: s.dist + 1 });
        }
    }
    seen.len()
}

fn main() -> i32 {
    let mut input = read_all();
    defer input.free();
    let mut nums = numbers(input.as_slice());
    defer nums.free();
    let h = nums.get(0) as i64;
    let w = nums.get(1) as i64;
    let q = nums.get(2) as i64;
    let p = nums.get(3);
    let dmax = nums.get(4);
    let mut rng = Rng { x: nums.get(5) };

    let mut grid: Vec<Vec<bool>> = Vec::new();
    for i in 0..h {
        let mut row: Vec<bool> = Vec::new();
        for j in 0..w {
            row.push(rng.next() % 100 >= p);
        }
        grid.push(row);
    }

    let mut out = Buf::new();
    defer out.free();
    let mut sum = 0;
    let mut hash = 0;
    for j in 0..q {
        let r = (rng.next() % h as u64) as i64;
        let c = (rng.next() % w as u64) as i64;
        let d = (rng.next() % (dmax + 1)) as i64;
        let a = reach(&grid, r, c, d);
        if j < 10 {
            out.push_int(a);
            out.push('\n');
        }
        sum += a;
        hash = (hash * 1000003 + a) % 1000000007;
    }
    out.push_str("sum ");
    out.push_int(sum);
    out.push_str("\nhash ");
    out.push_int(hash);
    out.push('\n');
    print(out.as_slice());
    0
}
