// Cells within reach: a generated grid of open cells and walls, and many
// bounded breadth-first searches on it. The grid is one flat array of
// marks with a border of walls around it (so a neighbour needs no bounds
// test). A cell's mark is the number of the last search that reached it,
// and a wall's is the largest u32, which no search number exceeds: so one
// test (mark < this search) says "open and not yet reached", nothing is
// cleared or allocated per query, and the queue is reused.

import "unistd.h" as c;

use std::Buf;

struct Rng {
    x: u64,
}

impl Rng {
    fn next(self: *Rng) -> u64 {
        self.x = self.x * 6364136223846793005 + 1442695040888963407;
        self.x >> 33
    }
}

// All of stdin.
fn read_all(gpa: Gpa) -> Buf {
    let mut b = Buf::new_in(gpa);
    let mut chunk = [0u8; 65536];
    loop {
        let n = unsafe { c::read(0, &chunk[0] as *u8, 65536) } as i64;
        if n <= 0 {
            break;
        }
        b.push_str(chunk[0..n]);
    }
    b
}

// Parses the unsigned integers of the input line.
fn numbers(text: [u8], gpa: Gpa) -> Vec<u64> {
    let mut out: Vec<u64> = Vec::new_in(gpa);
    let mut i = 0;
    while i < text.len {
        if text[i] >= '0' && text[i] <= '9' {
            let mut v: u64 = 0;
            while i < text.len && text[i] >= '0' && text[i] <= '9' {
                v = v * 10 + (text[i] - '0') as u64;
                i += 1;
            }
            out.push(v);
        } else {
            i += 1;
        }
    }
    out
}

// The mark of a wall.
const WALL: u32 = 4294967295;

struct Search {
    // the padded width: w + 2
    stride: i64,
    // per cell: WALL, or the stamp of the last search that reached it
    mark: Vec<u32>,
    queue: Vec<i32>,
    stamp: u32,
}

impl Search {
    // Visits `n` if it is open and not yet reached by this search.
    fn visit(self: *Search, n: i64) {
        let mark = self.mark.as_slice();
        if mark[n] < self.stamp {
            mark[n] = self.stamp;
            self.queue.push(n as i32);
        }
    }

    // The number of open cells at most d steps from cell (r, c).
    fn reach(self: *Search, r: i64, c: i64, d: i64) -> i64 {
        let stride = self.stride;
        let start = (r + 1) * stride + c + 1;
        if self.mark.as_slice()[start] == WALL {
            return 0;
        }
        self.stamp += 1;
        self.queue.clear();
        self.queue.push(start as i32);
        self.mark.as_slice()[start] = self.stamp;
        let mut head = 0;
        let mut dist = 0;
        while head < self.queue.len && dist < d {
            let layer_end = self.queue.len;
            while head < layer_end {
                let cell = self.queue.as_slice()[head] as i64;
                head += 1;
                self.visit(cell - stride);
                self.visit(cell + stride);
                self.visit(cell - 1);
                self.visit(cell + 1);
            }
            dist += 1;
        }
        self.queue.len
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut input = read_all(gpa);
    defer input.free();
    let mut nums = numbers(input.as_slice(), gpa);
    defer nums.free();
    let h = nums.get(0) as i64;
    let w = nums.get(1) as i64;
    let q = nums.get(2) as i64;
    let p = nums.get(3);
    let dmax = nums.get(4);
    let mut rng = Rng { x: nums.get(5) };

    let stride = w + 2;
    let cells = (h + 2) * stride;
    let mut mark: Vec<u32> = Vec::with_capacity_in(cells, gpa);
    for i in 0..cells {
        mark.push(WALL);
    }
    let grid = mark.as_slice();
    for r in 0..h {
        for c in 0..w {
            if rng.next() % 100 >= p {
                grid[(r + 1) * stride + c + 1] = 0;
            }
        }
    }
    let mut s = Search {
        stride: stride,
        mark: mark,
        queue: Vec::with_capacity_in(4096, gpa),
        stamp: 0,
    };
    defer {
        s.mark.free();
        s.queue.free();
    }

    let mut out = Buf::new_in(gpa);
    defer out.free();
    let mut sum = 0;
    let mut hash = 0;
    for j in 0..q {
        let r = (rng.next() % h as u64) as i64;
        let c = (rng.next() % w as u64) as i64;
        let d = (rng.next() % (dmax + 1)) as i64;
        let a = s.reach(r, c, d);
        if j < 10 {
            out.push_int(a);
            out.push('\n');
        }
        sum += a;
        hash = (hash * 1000003 + a) % 1000000007;
    }
    out.push_str("sum ");
    out.push_int(sum);
    out.push_str("\nhash ");
    out.push_int(hash);
    out.push('\n');
    print(out.as_slice());
    0
}
