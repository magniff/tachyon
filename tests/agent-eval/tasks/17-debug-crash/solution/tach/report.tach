// The report printed after the last line of input.

use crate::State;
use crate::stats::ranking;
use crate::text::{push_grouped, push_int, wrap};
use std::Buf;

pub fn write_report(st: State, out: inout Buf, gpa: Gpa) {
    out.push_str("events ");
    push_int(&out, st.events);
    out.push_str(", keys ");
    push_int(&out, st.table.len());
    out.push_str(", bad ");
    push_int(&out, st.bad);
    out.push('\n');

    var quiet: Vec<[u8]> = Vec::new_in(gpa);
    for g in st.groups.as_slice() {
        out.push_str(g.key);
        out.push_str(": count ");
        push_int(&out, g.count);
        out.push_str(", sum ");
        push_grouped(&out, g.sum, gpa);
        out.push_str(", min ");
        push_int(&out, g.min);
        out.push_str(", max ");
        push_int(&out, g.max);
        out.push_str(", mean ");
        push_int(&out, g.mean());
        out.push('\n');

        let b = g.busiest(st.span);
        out.push_str("  busiest ");
        push_int(&out, b.count);
        out.push_str(" in [");
        push_int(&out, b.start);
        out.push_str(", ");
        push_int(&out, b.start + st.span);
        out.push_str(")\n");

        match g.recent(st.now, st.span, gpa) {
            Some(r) => {
                out.push_str("  recent ");
                push_int(&out, r.n);
                out.push_str(": min ");
                push_int(&out, r.min);
                out.push_str(", median ");
                push_int(&out, r.median);
                out.push_str(", max ");
                push_int(&out, r.max);
                out.push('\n');
            }
            None => {
                out.push_str("  recent none\n");
                quiet.push(g.key);
            }
        }
    }

    write_top(st, &out, gpa);

    if quiet.len() > 0 {
        out.push_str("quiet:\n");
        wrap(quiet.as_slice(), st.width, &out);
    }
    if st.notes.len() > 0 {
        var notes: Vec<[u8]> = Vec::new_in(gpa);
        for n in st.notes.as_slice() {
            notes.push(n);
        }
        out.push_str("notes:\n");
        wrap(notes.as_slice(), st.width, &out);
    }
}

// The `top` groups with the largest sums.
fn write_top(st: State, out: inout Buf, gpa: Gpa) {
    if st.top == 0 || st.groups.len() == 0 {
        return;
    }
    let groups = st.groups.as_slice();
    var order = ranking(groups, gpa);
    let k = if st.top < order.len() { st.top } else { order.len() };
    out.push_str("top ");
    push_int(&out, k);
    out.push_str(" by sum:\n");
    for rank in 0..k {
        let g = &groups[order.get(rank)];
        out.push_str("  ");
        push_int(&out, rank + 1);
        out.push_str(". ");
        out.push_str(g.key);
        out.push(' ');
        push_grouped(&out, g.sum, gpa);
        out.push('\n');
    }
}
