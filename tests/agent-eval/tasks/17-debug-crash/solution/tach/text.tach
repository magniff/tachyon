// Text helpers: splitting lines into words, reading integers, writing
// numbers, and wrapping a list of words to a width.

use std::Buf;

// The words of a line: maximal runs of bytes other than space and tab.
pub fn split_words(line: [u8], gpa: Gpa) -> Vec<[u8]> {
    let mut words: Vec<[u8]> = Vec::new_in(gpa);
    let mut i = 0;
    while i < line.len {
        while i < line.len && is_blank(line[i]) {
            i += 1;
        }
        let start = i;
        while i < line.len && !is_blank(line[i]) {
            i += 1;
        }
        if i > start {
            words.push(line[start..i]);
        }
    }
    words
}

fn is_blank(b: u8) -> bool {
    b == ' ' || b == '\t'
}

// An integer: an optional '-', then 1 to 18 decimal digits, nothing else.
pub fn parse_int(s: [u8]) -> Option<i64> {
    let mut i = 0;
    let mut negative = false;
    if s.len > 0 && s[0] == '-' {
        negative = true;
        i = 1;
    }
    let digits = s.len - i;
    if digits < 1 || digits > 18 {
        return None;
    }
    let mut v: i64 = 0;
    while i < s.len {
        let b = s[i];
        if b < '0' || b > '9' {
            return None;
        }
        v = v * 10 + (b - '0') as i64;
        i += 1;
    }
    if negative {
        v = -v;
    }
    Some(v)
}

// The decimal digits of v.
pub fn push_int(out: &mut Buf, v: i64) {
    out.push_int(v);
}

// v with its digits in groups of three: 1234567 is "1,234,567",
// -1234 is "-1,234".
pub fn push_grouped(out: &mut Buf, v: i64, gpa: Gpa) {
    let mut digits = Buf::new_in(gpa);
    push_int(&mut digits, v);
    let d = digits.as_slice();
    let mut start = 0;
    if d.len > 0 && d[0] == '-' {
        out.push('-');
        start = 1;
    }
    let n = d.len - start;
    for k in 0..n {
        if k > 0 && (n - k) % 3 == 0 {
            out.push(',');
        }
        out.push(d[start + k]);
    }
}

// Writes `words` as lines of at most `width` bytes (words joined by one
// space), each line indented by two spaces. A line takes as many words
// as fit; a word longer than the width gets a line of its own.
pub fn wrap(words: [[u8]], width: i64, out: &mut Buf) {
    let mut i = 0;
    while i < words.len {
        let mut j = i;
        let mut len = 0;
        while j < words.len {
            let need = if j == i {
                words[j].len
            } else {
                len + 1 + words[j].len
            };
            if need > width {
                break;
            }
            len = need;
            j += 1;
        }
        if j == i {
            // a word longer than the width: on a line of its own
            j = i + 1;
        }
        out.push_str("  ");
        for k in i..j {
            if k > i {
                out.push(' ');
            }
            out.push_str(words[k]);
        }
        out.push('\n');
        i = j;
    }
}
