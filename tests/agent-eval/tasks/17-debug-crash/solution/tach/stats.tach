// The events of one key and the numbers computed from them.

use std::sort;

pub struct Group {
    pub key: [u8],
    // The number of the line holding its first event (1-based).
    pub first_line: i64,
    pub count: i64,
    pub sum: i64,
    pub min: i64,
    pub max: i64,
    // Every event, in input order (so `times` never decreases).
    pub times: Vec<i64>,
    pub values: Vec<i64>,
}

// The events of a group in the recent window.
pub struct Recent {
    pub n: i64,
    pub min: i64,
    pub median: i64,
    pub max: i64,
}

// The busiest window of a group: `count` events in [start, start + span).
pub struct Busiest {
    pub count: i64,
    pub start: i64,
}

impl Group {
    pub fn new(key: [u8], line: i64, gpa: Gpa) -> Group {
        Group {
            key: key,
            first_line: line,
            count: 0,
            sum: 0,
            min: 0,
            max: 0,
            times: Vec::new_in(gpa),
            values: Vec::new_in(gpa),
        }
    }

    pub fn add(self: &mut Group, time: i64, value: i64) {
        if self.count == 0 || value < self.min {
            self.min = value;
        }
        if self.count == 0 || value > self.max {
            self.max = value;
        }
        self.count += 1;
        self.sum += value;
        self.times.push(time);
        self.values.push(value);
    }

    // The sum over the count, truncated toward zero.
    pub fn mean(self: &Group) -> i64 {
        self.sum / self.count
    }

    // The index of the first event later than `cutoff` (the number of
    // events when there is none): a binary search over `times`.
    fn first_after(self: &Group, cutoff: i64) -> i64 {
        let times = self.times.as_slice();
        let mut lo = 0;
        let mut hi = times.len;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if times[mid] <= cutoff {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        lo
    }

    // The events with a time after `now - span`; None when there are none.
    pub fn recent(self: &Group, now: i64, span: i64, gpa: Gpa) -> Option<Recent> {
        let start = self.first_after(now - span);
        let mut vals: Vec<i64> = Vec::new_in(gpa);
        for v in self.values.as_slice()[start..] {
            vals.push(v);
        }
        let n = vals.len();
        if n == 0 {
            return None;
        }
        let s = vals.as_slice();
        sort(s);
        Some(Recent {
            n: n,
            min: s[0],
            median: median(s),
            max: s[n - 1],
        })
    }

    // The window [t, t + span), t the time of one of the group's events,
    // holding the most events; the earliest such t on a tie.
    pub fn busiest(self: &Group, span: i64) -> Busiest {
        let t = self.times.as_slice();
        let mut best = Busiest { count: 0, start: 0 };
        let mut r = 0;
        for i in 0..t.len {
            if r < i {
                r = i;
            }
            while r < t.len && t[r] < t[i] + span {
                r += 1;
            }
            let count = r - i;
            if count > best.count {
                best = Busiest { count: count, start: t[i] };
            }
        }
        best
    }
}

// The median of sorted values (at least one): the middle one, or the
// mean of the two middle ones truncated toward zero.
pub fn median(sorted: [i64]) -> i64 {
    let n = sorted.len;
    if n % 2 == 1 {
        sorted[n / 2]
    } else {
        (sorted[n / 2 - 1] + sorted[n / 2]) / 2
    }
}

// Whether group a comes before group b in the ranking: the larger sum
// first, then the earlier first event.
fn ranks_before(groups: [Group], a: i64, b: i64) -> bool {
    let ga = &groups[a];
    let gb = &groups[b];
    if ga.sum != gb.sum {
        return ga.sum > gb.sum;
    }
    ga.first_line < gb.first_line
}

// The group numbers in ranking order (a merge sort).
pub fn ranking(groups: [Group], gpa: Gpa) -> Vec<i64> {
    let n = groups.len;
    let mut order: Vec<i64> = Vec::new_in(gpa);
    for i in 0..n {
        order.push(i);
    }
    let mut tmp: Vec<i64> = Vec::new_in(gpa);
    for i in 0..n {
        tmp.push(0);
    }
    let o = order.as_mut_slice();
    let t = tmp.as_mut_slice();
    let mut width = 1;
    while width < n {
        let mut lo = 0;
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n };
            let hi = if lo + 2 * width < n { lo + 2 * width } else { n };
            let mut i = lo;
            let mut j = mid;
            let mut k = lo;
            while k < hi {
                if j >= hi || (i < mid && !ranks_before(groups, o[j], o[i])) {
                    t[k] = o[i];
                    i += 1;
                } else {
                    t[k] = o[j];
                    j += 1;
                }
                k += 1;
            }
            lo = hi;
        }
        for k in 0..n {
            o[k] = t[k];
        }
        width *= 2;
    }
    order
}
