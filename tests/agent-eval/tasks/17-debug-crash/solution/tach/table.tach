// A hash table from keys to group numbers: open addressing with linear
// probing, the capacity a power of two, grown to keep it at most half
// full.

pub struct Table {
    // Per slot: the key's hash, the key, and its group (-1: a free slot).
    hashes: Vec<i32>,
    keys: Vec<[u8]>,
    groups: Vec<i64>,
    used: i64,
}

// The hash of a key: h = h * 31 + byte over its bytes, in 32 bits.
pub fn hash_key(key: [u8]) -> i32 {
    let mut h: i32 = 0;
    for b in key {
        h = h * 31 + b as i32;
    }
    h
}

impl Table {
    pub fn new() -> Table {
        let mut t = Table { hashes: Vec::new(), keys: Vec::new(), groups: Vec::new(), used: 0 };
        t.alloc(16);
        t
    }

    fn alloc(self: *Table, cap: i64) {
        self.hashes = Vec::new();
        self.keys = Vec::new();
        self.groups = Vec::new();
        for i in 0..cap {
            self.hashes.push(0);
            self.keys.push("");
            self.groups.push(-1);
        }
        self.used = 0;
    }

    fn cap(self: *Table) -> i64 {
        self.groups.len()
    }

    // The slot holding `key`, or the free slot where it would go.
    fn probe(self: *Table, key: [u8], h: i32) -> i64 {
        let mask = self.cap() - 1;
        let hashes = self.hashes.as_slice();
        let keys = self.keys.as_slice();
        let groups = self.groups.as_slice();
        let mut i = (h as u32 as i64) & mask;
        loop {
            if groups[i] == -1 {
                return i;
            }
            if hashes[i] == h && keys[i].len == key.len && keys[i] == key {
                return i;
            }
            i = (i + 1) & mask;
        }
    }

    // The group of `key`, if it has one.
    pub fn get(self: *Table, key: [u8]) -> Option<i64> {
        let s = self.probe(key, hash_key(key));
        let g = self.groups.get(s);
        if g == -1 {
            None
        } else {
            Some(g)
        }
    }

    // Records that `key` (not in the table yet) belongs to `group`.
    pub fn insert(self: *Table, key: [u8], group: i64) {
        if (self.used + 1) * 2 > self.cap() {
            self.grow();
        }
        let h = hash_key(key);
        let s = self.probe(key, h);
        self.hashes.set(s, h);
        self.keys.set(s, key);
        self.groups.set(s, group);
        self.used += 1;
    }

    // Doubles the capacity and puts every entry back.
    fn grow(self: *Table) {
        let mut hashes = self.hashes;
        let mut keys = self.keys;
        let mut groups = self.groups;
        defer {
            hashes.free();
            keys.free();
            groups.free();
        }
        self.alloc(groups.len() * 2);
        for s in 0..groups.len() {
            if groups.get(s) != -1 {
                let t = self.probe(keys.get(s), hashes.get(s));
                self.hashes.set(t, hashes.get(s));
                self.keys.set(t, keys.get(s));
                self.groups.set(t, groups.get(s));
                self.used += 1;
            }
        }
    }

    pub fn len(self: *Table) -> i64 {
        self.used
    }
}
