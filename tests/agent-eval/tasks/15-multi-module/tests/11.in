SELECT code, id, name, dept FROM t WHERE '' < score ORDER BY age ASC LIMIT 1
SELECT code, age, score, id FROM t WHERE name IS NULL ORDER BY dept, code ASC LIMIT 0
SELECT COUNT(*), dept, COUNT(score) FROM t WHERE name <= 'lima vi' GROUP BY dept LIMIT 5
select dept, age from t where (age > 1180) ORDER BY dept, id DESC, name LIMIT 0
select SUM(age), COUNT(id) from t ORDER BY MAX(score) ASC, SUM(id) ASC LIMIT 20
SELECT age, COUNT(*) FROM t GROUP BY age ORDER BY MIN(dept) DESC, age DESC LIMIT 1
SELECT id, score FROM t ORDER BY score DESC LIMIT 10
select age, code from t where name IS NOT NULL ORDER BY dept, age, code ASC LIMIT 10
select name, id from t where age > -7 ORDER BY dept DESC, age LIMIT 10
SELECT id, code FROM t WHERE name > dept ORDER BY score, score LIMIT 10
select name, code from t where name <= 'oscar' OR age = 1136 ORDER BY dept DESC LIMIT 0
SELECT id, name FROM t ORDER BY name, id DESC LIMIT 10
SELECT COUNT(*), SUM(score), MIN(score), MAX(score), MIN(code), MAX(code) FROM t
SELECT MIN(code), MAX(score), COUNT(id) FROM t WHERE score <= age LIMIT 1
select dept, age, code from t where dept != 'ops' ORDER BY id LIMIT 5
select code from t where 837 = id ORDER BY id DESC, id, code LIMIT 0
SELECT name, score, id FROM t WHERE code IS NOT NULL ORDER BY score, dept ASC, name ASC LIMIT 3
SELECT dept, MIN(name) FROM t WHERE dept <= dept GROUP BY dept ORDER BY dept, dept ASC LIMIT 10
SELECT code FROM t WHERE score IS NULL GROUP BY code LIMIT 1
SELECT code, id FROM t WHERE id >= 882 ORDER BY score DESC, dept DESC LIMIT 20
SELECT dept FROM t WHERE 'ops' <= dept Or dept <= 'sales' GROUP BY dept ORDER BY SUM(age) ASC, dept ASC LIMIT 10
SELECT dept, code FROM t WHERE id != 811 ORDER BY code ASC, dept DESC LIMIT 10
SELECT score, dept, name, code, bogus FROM t ORDER BY id, id ASC LIMIT 0
select name from t ORDER BY code, age LIMIT 20
