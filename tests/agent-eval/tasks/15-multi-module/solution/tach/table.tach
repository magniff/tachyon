// The table: its header and rows, read from the CSV part of the input.

use std::Buf;

pub enum ColType {
    Int,
    Str,
}

pub enum Value {
    Null,
    Int(i64),
    Str([u8]),
}

pub struct Table {
    pub names: Vec<[u8]>,
    pub types: Vec<ColType>,
    // Row r, column c is cells[r * ncols + c].
    pub cells: Vec<Value>,
    pub nrows: i64,
}

impl Table {
    pub fn ncols(self: &Table) -> i64 {
        self.names.len()
    }

    pub fn cell(self: &Table, row: i64, col: i64) -> Value {
        self.cells.get(row * self.names.len() + col)
    }

    pub fn find(self: &Table, name: [u8]) -> Option<i64> {
        for i in 0..self.names.len() {
            if self.names.get(i) == name {
                return Some(i);
            }
        }
        None
    }
}

pub fn is_null(v: Value) -> bool {
    match v {
        Value::Null => true,
        _ => false,
    }
}

// Negative, zero or positive; NULL is smaller than everything.
pub fn compare(a: Value, b: Value) -> i64 {
    match (a, b) {
        (Value::Null, Value::Null) => 0,
        (Value::Null, _) => -1,
        (_, Value::Null) => 1,
        (Value::Int(x), Value::Int(y)) => {
            if x < y {
                -1
            } else if x > y {
                1
            } else {
                0
            }
        }
        (Value::Str(x), Value::Str(y)) => compare_bytes(x, y),
        (Value::Int(_), Value::Str(_)) => -1,
        (Value::Str(_), Value::Int(_)) => 1,
    }
}

pub fn compare_bytes(a: [u8], b: [u8]) -> i64 {
    let n = if a.len() < b.len() { a.len() } else { b.len() };
    for i in 0..n {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
    }
    if a.len() < b.len() {
        -1
    } else if a.len() > b.len() {
        1
    } else {
        0
    }
}

pub fn parse_int(s: [u8]) -> i64 {
    let mut i = 0;
    let mut neg = false;
    if i < s.len() && s[i] == '-' {
        neg = true;
        i += 1;
    }
    let mut v: i64 = 0;
    while i < s.len() {
        v = v * 10 + (s[i] - '0') as i64;
        i += 1;
    }
    if neg {
        -v
    } else {
        v
    }
}

// Splits one CSV line into its fields. A quoted field is unquoted into a
// Buf pushed onto `store`, and left empty here: `quoted` gets (its field,
// its Buf), for read_table to point it at the Buf once the store is
// complete.
fn split_fields(line: [u8], store: &mut Vec<Buf>, quoted: &mut Vec<(i64, i64)>, gpa: Gpa) -> Vec<[
    u8]> {
    let mut fields: Vec<[u8]> = Vec::new_in(gpa);
    let mut i = 0;
    loop {
        if i < line.len() && line[i] == '"' {
            // the unquoted text, kept in the store
            let mut field = Buf::new_in(gpa);
            i += 1;
            while i < line.len() {
                if line[i] == '"' {
                    if i + 1 < line.len() && line[i + 1] == '"' {
                        field.push('"');
                        i += 2;
                    } else {
                        i += 1;
                        break;
                    }
                } else {
                    field.push(line[i]);
                    i += 1;
                }
            }
            quoted.push((fields.len(), store.len()));
            fields.push("");
            store.push(field);
        } else {
            let start = i;
            while i < line.len() && line[i] != ',' {
                i += 1;
            }
            fields.push(line[start..i]);
        }
        if i < line.len() && line[i] == ',' {
            i += 1;
        } else {
            break;
        }
    }
    fields
}

// Reads the header and the rows from `lines`, up to the line `%%`; returns
// the table and the index of the first line after `%%`. The unquoted text
// of quoted fields is kept in `store`, which the table views.
pub fn read_table(lines: [[u8]], store: &mut Vec<Buf>, gpa: Gpa) -> (Table, i64) {
    let mut t = Table {
        names: Vec::new_in(gpa), types: Vec::new_in(gpa), cells: Vec::new_in(gpa), nrows: 0
    };
    let mut k = 0;
    // (cell, its Buf in the store) for every quoted field
    let mut quoted: Vec<(i64, i64)> = Vec::new_in(gpa);
    if lines.len() > 0 {
        // (names are never quoted)
        let mut hq: Vec<(i64, i64)> = Vec::new_in(gpa);
        let mut header = split_fields(lines[0], store, &mut hq, gpa);
        for item in header.as_slice() {
            let mut colon = item.len();
            for j in 0..item.len() {
                if item[j] == ':' {
                    colon = j;
                    break;
                }
            }
            t.names.push(item[0..colon]);
            let ty = item[colon + 1..];
            t.types.push(if ty == "int" { ColType::Int } else { ColType::Str });
        }
        k = 1;
    }
    while k < lines.len() {
        let line = lines[k];
        k += 1;
        if line == "%%" {
            break;
        }
        if line.len() == 0 {
            continue;
        }
        let first = quoted.len();
        let mut fields = split_fields(line, store, &mut quoted, gpa);
        let fq = quoted.as_mut_slice();
        for j in first..fq.len() {
            fq[j].0 += t.cells.len();
        }
        for c in 0..t.ncols() {
            let text = fields.get(c);
            let v = if t.types.get(c) == ColType::Int {
                if text.len() == 0 {
                    Value::Null
                } else {
                    Value::Int(parse_int(text))
                }
            } else {
                Value::Str(text)
            };
            t.cells.push(v);
        }
        t.nrows += 1;
    }
    // The store is complete: the quoted cells can view it now.
    let cells = t.cells.as_mut_slice();
    for q in quoted.as_slice() {
        cells[q.0] = Value::Str(store[q.1].as_slice());
    }
    (t, k)
}
