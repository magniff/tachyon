// A small query engine: a CSV table on stdin, then queries in a subset of
// SQL, one per line; prints each query's result or one error line.

mod check;
mod exec;
mod lexer;
mod parser;
mod sort;
mod table;

import "unistd.h" as c;

use std::Buf;

use check::plan;
use exec::run;
use lexer::tokenize;
use parser::parse;
use table::{Table, read_table};

// All of stdin.
fn read_all(gpa: Gpa) -> Buf {
    var b = Buf::new_in(gpa);
    var chunk = [0u8; 65536];
    loop {
        let n = unsafe { c::read(0, &chunk[0] as *u8, 65536) } as i64;
        if n <= 0 {
            break;
        }
        b.push_str(chunk[0..n]);
    }
    b
}

// The input's lines, without their `\n` and one trailing `\r`.
fn split_lines(text: [u8], gpa: Gpa) -> Vec<[u8]> {
    var lines: Vec<[u8]> = Vec::new_in(gpa);
    var start = 0;
    for i in 0..text.len() + 1 {
        if i == text.len() || text[i] == '\n' {
            if i == text.len() && start == i {
                break;
            }
            var end = i;
            if end > start && text[end - 1] == '\r' {
                end -= 1;
            }
            lines.push(text[start..end]);
            start = i + 1;
        }
    }
    lines
}

fn is_blank(line: [u8]) -> bool {
    for b in line {
        if b != ' ' && b != '\t' {
            return false;
        }
    }
    true
}

fn run_query(line: [u8], t: Table, out: inout Buf, gpa: Gpa) {
    // the values of the query's strings, owned here for the tokens to view
    var strings: Vec<Buf> = Vec::new_in(gpa);
    var toks = match tokenize(line, &strings, gpa) {
        Ok(toks) => toks,
        Err(e) => return report(e, &out),
    };
    var q = match parse(toks.as_slice(), gpa) {
        Ok(q) => q,
        Err(e) => return report(e, &out),
    };
    var p = match plan(q, t, gpa) {
        Ok(p) => p,
        Err(e) => return report(e, &out),
    };
    run(p, t, &out, gpa);
}

fn report(e: Buf, out: inout Buf) {
    out.push_str("error: ");
    out.push_str(e.as_slice());
    out.push('\n');
}

fn main(gpa: Gpa) -> i32 {
    let input = read_all(gpa);
    var lines = split_lines(input.as_slice(), gpa);
    // the text of the table's quoted fields, owned here for the table to view
    var store: Vec<Buf> = Vec::new_in(gpa);
    let tl = read_table(lines.as_slice(), &store, gpa);
    let t = tl.0;
    var out = Buf::new_in(gpa);
    for k in tl.1..lines.len() {
        let line = lines.get(k);
        if is_blank(line) || (line.len() >= 2 && line[0..2] == "--") {
            continue;
        }
        run_query(line, t, &out, gpa);
    }
    print(out.as_slice());
    0
}
