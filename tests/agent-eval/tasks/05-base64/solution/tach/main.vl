// Base64: `enc TEXT` and `dec DATA` requests, one per line.
use std::{Buf, read_line};

static ALPHABET: [u8] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

// The value of an alphabet character, or -1.
fn sextet(ch: u8) -> i64 {
    if ch >= 'A' && ch <= 'Z' {
        (ch - 'A') as i64
    } else if ch >= 'a' && ch <= 'z' {
        (ch - 'a') as i64 + 26
    } else if ch >= '0' && ch <= '9' {
        (ch - '0') as i64 + 52
    } else if ch == '+' {
        62
    } else if ch == '/' {
        63
    } else {
        -1
    }
}

fn encode(data: [u8], out: inout Buf) {
    var i = 0;
    while i < data.len() {
        let rest = data.len() - i;
        let b0 = data[i] as i64;
        let b1 = if rest > 1 { data[i + 1] as i64 } else { 0 };
        let b2 = if rest > 2 { data[i + 2] as i64 } else { 0 };
        let group = (b0 << 16) | (b1 << 8) | b2;
        out.push(ALPHABET[(group >> 18) & 63]);
        out.push(ALPHABET[(group >> 12) & 63]);
        out.push(if rest > 1 { ALPHABET[(group >> 6) & 63] } else { '=' });
        out.push(if rest > 2 { ALPHABET[group & 63] } else { '=' });
        i += 3;
    }
}

// Appends the decoded bytes to out; false when the data is not valid base64.
fn decode(data: [u8], out: inout Buf) -> bool {
    if data.len() % 4 != 0 {
        return false;
    }
    var pad = 0;
    if data.len() >= 1 && data[data.len() - 1] == '=' {
        pad = 1;
        if data[data.len() - 2] == '=' {
            pad = 2;
        }
    }
    var i = 0;
    while i < data.len() {
        let last = i + 4 == data.len();
        var group = 0;
        for k in 0..4 {
            var v = 0;
            if !(last && k >= 4 - pad) {
                v = sextet(data[i + k]);
                if v < 0 {
                    return false;
                }
            }
            group = (group << 6) | v;
        }
        out.push((group >> 16) as u8);
        if last && pad == 2 {
            if group & 0xffff != 0 {
                return false;
            }
        } else if last && pad == 1 {
            out.push((group >> 8) as u8);
            if group & 0xff != 0 {
                return false;
            }
        } else {
            out.push((group >> 8) as u8);
            out.push(group as u8);
        }
        i += 4;
    }
    true
}

fn push_decoded(bytes: [u8], out: inout Buf) {
    var printable = true;
    for b in bytes {
        if b < 32 || b > 126 {
            printable = false;
        }
    }
    if printable {
        out.push_str(bytes);
        return;
    }
    let digits = "0123456789abcdef";
    out.push_str("hex:");
    for b in bytes {
        out.push(digits[b >> 4]);
        out.push(digits[b & 15]);
    }
}

fn handle(line: [u8], out: inout Buf, scratch: inout Buf) {
    let (cmd, arg) = if line.len() >= 4 && line[3] == ' ' {
        (line[..3], line[4..])
    } else {
        (line, "")
    };
    if cmd == "enc" {
        encode(arg, &out);
    } else if cmd == "dec" {
        scratch.clear();
        if decode(arg, &scratch) {
            push_decoded(scratch.as_slice(), &out);
        } else {
            out.push_str("invalid");
        }
    } else {
        out.push_str("invalid");
    }
    out.push('\n');
}

fn main(gpa: Gpa) -> i32 {
    var line = Buf::new_in(gpa);
    var out = Buf::new_in(gpa);
    var scratch = Buf::new_in(gpa);
    while read_line(&line).unwrap_or(false) {
        handle(line.as_slice(), &out, &scratch);
    }
    print(out.as_slice());
    0
}
