// RPN calculator: one expression per line, wrapping i64 arithmetic.
use std::{Buf, read_line};

enum Token {
    Num(i64),
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    Dup,
    Swap,
    Bad,
}

fn parse_number(tok: [u8]) -> Token {
    var i = 0;
    let negative = tok[0] == '-';
    if negative {
        i = 1;
    }
    if i == tok.len() {
        return Token::Bad;
    }
    var n = 0;
    while i < tok.len() {
        let ch = tok[i];
        if ch < '0' || ch > '9' {
            return Token::Bad;
        }
        n = n * 10 + (ch - '0') as i64; // wraps
        i += 1;
    }
    if negative {
        n = -n;
    }
    Token::Num(n)
}

fn parse_token(tok: [u8]) -> Token {
    if tok == "+" {
        Token::Add
    } else if tok == "-" {
        Token::Sub
    } else if tok == "*" {
        Token::Mul
    } else if tok == "/" {
        Token::Div
    } else if tok == "%" {
        Token::Rem
    } else if tok == "dup" {
        Token::Dup
    } else if tok == "swap" {
        Token::Swap
    } else {
        parse_number(tok)
    }
}

// Applies one token to the stack; false on an error.
fn apply(tok: Token, stack: inout Vec<i64>) -> bool {
    match tok {
        Token::Num(n) => {
            stack.push(n);
            true
        }
        Token::Dup => {
            if stack.is_empty() {
                return false;
            }
            let top = stack.last().unwrap();
            stack.push(top);
            true
        }
        Token::Swap => {
            let n = stack.len();
            if n < 2 {
                return false;
            }
            stack.swap(n - 1, n - 2);
            true
        }
        Token::Bad => false,
        _ => {
            if stack.len() < 2 {
                return false;
            }
            let b = stack.pop().unwrap();
            let a = stack.pop().unwrap();
            let r = match tok {
                Token::Add => a + b,
                Token::Sub => a - b,
                Token::Mul => a * b,
                Token::Div => {
                    if b == 0 {
                        return false;
                    }
                    a / b
                }
                _ => {
                    if b == 0 {
                        return false;
                    }
                    a % b
                }
            };
            stack.push(r);
            true
        }
    }
}

fn eval_line(line: [u8], stack: inout Vec<i64>) -> Option<i64> {
    stack.clear();
    var i = 0;
    while i < line.len() {
        if line[i] == ' ' {
            i += 1;
            continue;
        }
        let start = i;
        while i < line.len() && line[i] != ' ' {
            i += 1;
        }
        if !apply(parse_token(line[start..i]), &stack) {
            return None;
        }
    }
    if stack.len() != 1 {
        return None;
    }
    Some(stack.get(0))
}

fn main(gpa: Gpa) -> i32 {
    var line = Buf::new_in(gpa);
    var stack: Vec<i64> = Vec::new_in(gpa);
    var out = Buf::new_in(gpa);
    while read_line(&line).unwrap_or(false) {
        match eval_line(line.as_slice(), &stack) {
            Some(v) => out.push_int(v),
            None => out.push_str("error"),
        }
        out.push('\n');
    }
    print(out.as_slice());
    0
}
