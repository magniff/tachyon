// Formats comma-separated lines from stdin as a boxed text table.

mod render;
mod table;

import "stdio.h" as c;

use std::Buf;

use table::parse_table;

fn read_all(gpa: Gpa) -> Buf {
    var b = Buf::new_in(gpa);
    loop {
        let ch = unsafe { c::getchar() };
        if ch < 0 {
            break;
        }
        b.push(ch as u8);
    }
    b
}

fn main(gpa: Gpa) -> i32 {
    let input = read_all(gpa);
    let t = parse_table(input.as_slice(), gpa);
    var out = Buf::new_in(gpa);
    if t.ncols > 0 {
        render::render(t, &out, gpa);
    }
    print(out.as_slice());
    0
}
