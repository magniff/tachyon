// Formats comma-separated lines from stdin as a boxed text table.

mod render;
mod table;

import "stdio.h" as c;

use std::Buf;
use table::parse_table;

fn read_all() -> Buf {
    let mut b = Buf::new();
    loop {
        let ch = unsafe { c::getchar() };
        if ch < 0 {
            break;
        }
        b.push(ch as u8);
    }
    b
}

fn main() -> i32 {
    let input = read_all();
    let t = parse_table(input.as_slice());
    let mut out = Buf::new();
    if t.ncols > 0 {
        render::render(&t, &out);
    }
    print(out.as_slice());
    0
}
