// The table: a header row and data rows of text cells, read from
// comma-separated lines.

pub struct Table {
    pub header: Vec<[u8]>,
    pub rows: Vec<Vec<[u8]>>,
    // The number of columns: the most fields on any line.
    pub ncols: i64,
}

impl Table {
    // Cell `col` of `row`, or "" when the row is shorter.
    pub fn cell(row: &Vec<[u8]>, col: i64) -> [u8] {
        if col < row.len() {
            row.get(col)
        } else {
            ""
        }
    }
}

fn is_blank(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\r'
}

// `s` without blanks at either end.
fn trim(s: [u8]) -> [u8] {
    let mut lo = 0;
    let mut hi = s.len;
    while lo < hi && is_blank(s[lo]) {
        lo += 1;
    }
    while hi > lo && is_blank(s[hi - 1]) {
        hi -= 1;
    }
    s[lo..hi]
}

// The fields of one line, split at commas and trimmed.
fn split_line(line: [u8], gpa: Gpa) -> Vec<[u8]> {
    let mut fields: Vec<[u8]> = Vec::new_in(gpa);
    let mut start = 0;
    for i in 0..line.len + 1 {
        if i == line.len || line[i] == ',' {
            fields.push(trim(line[start..i]));
            start = i + 1;
        }
    }
    fields
}

// The first non-blank line is the header; the other non-blank lines are rows.
pub fn parse_table(text: [u8], gpa: Gpa) -> Table {
    let mut t = Table { header: Vec::new_in(gpa), rows: Vec::new_in(gpa), ncols: 0 };
    let mut have_header = false;
    let mut start = 0;
    for i in 0..text.len + 1 {
        if i == text.len || text[i] == '\n' {
            let line = text[start..i];
            start = i + 1;
            if trim(line).len == 0 {
                continue;
            }
            let fields = split_line(line, gpa);
            if fields.len() > t.ncols {
                t.ncols = fields.len();
            }
            if have_header {
                t.rows.push(fields);
            } else {
                t.header = fields;
                have_header = true;
            }
        }
    }
    t
}
