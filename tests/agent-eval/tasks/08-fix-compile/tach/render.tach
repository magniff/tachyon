// Draws a table with borders: numeric columns right-aligned, the others
// left-aligned, every column as wide as its widest cell.

use crate::table::Table;
use std::Buf;

fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

// An optional '-', digits, and optionally '.' and more digits.
fn is_number(s: [u8]) -> bool {
    let mut i = 0;
    if i < s.len && s[i] == '-' {
        i += 1;
    }
    let digits_start = i;
    while i < s.len && is_digit(s[i]) {
        i += 1;
    }
    if i == digits_start {
        return false;
    }
    if i < s.len && s[i] == '.' {
        i += 1;
        let frac_start = i;
        while i < s.len && is_digit(s[i]) {
            i += 1;
        }
        if i == frac_start {
            return false;
        }
    }
    i == s.len
}

// The width of each column: its longest cell, header included, at least 1.
pub fn column_widths(t: *Table, gpa: Gpa) -> Vec<i64> {
    let mut widths: Vec<i64> = Vec::new_in(gpa);
    for c in 0..t.ncols {
        let mut w = 0;
        for row in t.rows.as_slice() {
            let len = Table::cell(row, c).len;
            if len > w {
                w = len;
            }
        }
        if w < 1 {
            w = 1;
        }
        widths.push(w);
    }
    widths
}

// A column is numeric when it has a non-empty data cell and every
// non-empty data cell is a number (the header does not count).
pub fn numeric_columns(t: *Table, gpa: Gpa) -> Vec<bool> {
    let mut numeric: Vec<bool> = Vec::new_in(gpa);
    for c in 0..t.ncols {
        let mut seen = false;
        let mut all = true;
        for row in t.rows.as_slice() {
            let text = Table::cell(row, c);
            if text.len == 0 {
                continue;
            }
            seen = true;
            if !is_number(text) {
                all = false;
            }
        }
        numeric.push(seen && all);
    }
    numeric
}

fn push_border(out: *Buf, widths: [i64]) {
    out.push('+');
    for w in widths {
        for _ in 0..w + 2 {
            out.push('-');
        }
        out.push('+');
    }
    out.push('\n');
}

// `text` padded with spaces to `width`, on the left when `right`.
fn pad_cell(out: *Buf, text: [u8], width: i64, right: bool) {
    let pad = width - text.len;
    if !right {
        out.push_string(text);
    }
    for _ in 0..pad {
        out.push(' ');
    }
    if right {
        out.push_str(text);
    }
}

fn push_row(out: *Buf, row: Vec<[u8]>, widths: [i64], numeric: [bool]) {
    out.push('|');
    for c in 0..widths.len {
        out.push(' ');
        pad_cell(out, Table::cell(row, c), widths[c]);
        out.push_str(" |");
    }
    out.push('\n');
}

fn render(t: *Table, out: *Buf, gpa: Gpa) {
    let widths = column_widths(t, gpa);
    let numeric = numeric_columns(t, gpa);
    push_border(out, widths.as_slice());
    push_row(out, t.header, widths.as_slice(), numeric.as_slice());
    push_border(out, widths.as_slice());
    for row in t.rows.as_slice() {
        push_row(out, row, widths.as_slice(), numeric.as_slice());
    }
    if t.rows.len() > 0 {
        push_border(out, widths.as_slice());
    }
}
