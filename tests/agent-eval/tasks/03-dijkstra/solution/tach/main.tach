// Shortest paths: Dijkstra with a binary heap, one search per query.
import "stdio.h" as c;
use std::Buf;

struct Scanner {
    data: [u8],
    pos: i64,
}

fn is_digit(ch: u8) -> bool {
    ch >= '0' && ch <= '9'
}

impl Scanner {
    fn next_int(self: *Scanner) -> i64 {
        while self.pos < self.data.len
            && !(self.data[self.pos] == '-' || is_digit(self.data[self.pos])) {
            self.pos += 1;
        }
        let mut negative = false;
        if self.pos < self.data.len && self.data[self.pos] == '-' {
            negative = true;
            self.pos += 1;
        }
        let mut n = 0;
        while self.pos < self.data.len && is_digit(self.data[self.pos]) {
            n = n * 10 + (self.data[self.pos] - '0') as i64;
            self.pos += 1;
        }
        if negative { -n } else { n }
    }
}

struct HeapItem {
    dist: i64,
    node: i64,
}

// A binary min-heap on dist.
struct MinHeap {
    items: Vec<HeapItem>,
}

impl MinHeap {
    fn push(self: *MinHeap, item: HeapItem) {
        self.items.push(item);
        let s = self.items.as_slice();
        let mut i = s.len - 1;
        while i > 0 {
            let parent = (i - 1) / 2;
            if s[parent].dist <= s[i].dist {
                break;
            }
            let tmp = s[parent];
            s[parent] = s[i];
            s[i] = tmp;
            i = parent;
        }
    }

    fn pop(self: *MinHeap) -> Option<HeapItem> {
        let n = self.items.len();
        if n == 0 {
            return None;
        }
        let top = self.items.get(0);
        let last = self.items.pop().unwrap();
        if n > 1 {
            let s = self.items.as_slice();
            s[0] = last;
            let len = n - 1;
            let mut i = 0;
            loop {
                let left = 2 * i + 1;
                let right = left + 1;
                let mut smallest = i;
                if left < len && s[left].dist < s[smallest].dist {
                    smallest = left;
                }
                if right < len && s[right].dist < s[smallest].dist {
                    smallest = right;
                }
                if smallest == i {
                    break;
                }
                let tmp = s[smallest];
                s[smallest] = s[i];
                s[i] = tmp;
                i = smallest;
            }
        }
        Some(top)
    }
}

// Adjacency lists in compressed form: the edges of u are
// targets[start[u]..start[u + 1]].
struct Graph {
    start: Vec<i64>,
    targets: Vec<i64>,
    weights: Vec<i64>,
}

fn filled(n: i64, x: i64) -> Vec<i64> {
    let mut v: Vec<i64> = Vec::with_capacity(n);
    for _ in 0..n {
        v.push(x);
    }
    v
}

fn build_graph(n: i64, from: [i64], to: [i64], w: [i64]) -> Graph {
    let m = from.len;
    let mut start_v = filled(n + 1, 0);
    let start = start_v.as_slice();
    for i in 0..m {
        start[from[i] + 1] += 1;
    }
    for u in 0..n {
        start[u + 1] += start[u];
    }
    let mut fill_v = filled(n + 1, 0);
    defer fill_v.free();
    let fill = fill_v.as_slice();
    for u in 0..n + 1 {
        fill[u] = start[u];
    }
    let targets_v = filled(m, 0);
    let weights_v = filled(m, 0);
    let targets = targets_v.as_slice();
    let weights = weights_v.as_slice();
    for i in 0..m {
        let k = fill[from[i]];
        targets[k] = to[i];
        weights[k] = w[i];
        fill[from[i]] += 1;
    }
    Graph { start: start_v, targets: targets_v, weights: weights_v }
}

fn shortest(g: *Graph, s: i64, t: i64, dist: [i64], heap: *MinHeap) -> i64 {
    for i in 0..dist.len {
        dist[i] = -1;
    }
    heap.items.clear();
    let start = g.start.as_slice();
    let targets = g.targets.as_slice();
    let weights = g.weights.as_slice();
    dist[s] = 0;
    heap.push(HeapItem { dist: 0, node: s });
    while let Some(item) = heap.pop() {
        let u = item.node;
        if item.dist != dist[u] {
            continue; // stale entry
        }
        if u == t {
            return item.dist;
        }
        for k in start[u]..start[u + 1] {
            let v = targets[k];
            let nd = item.dist + weights[k];
            if dist[v] < 0 || nd < dist[v] {
                dist[v] = nd;
                heap.push(HeapItem { dist: nd, node: v });
            }
        }
    }
    -1
}

fn read_all() -> Buf {
    let mut b = Buf::new();
    loop {
        let ch = unsafe { c::getchar() };
        if ch < 0 {
            break;
        }
        b.push(ch as u8);
    }
    b
}

fn main() -> i32 {
    let mut input = read_all();
    defer input.free();
    let mut sc = Scanner { data: input.as_slice(), pos: 0 };
    let n = sc.next_int();
    let m = sc.next_int();
    let q = sc.next_int();
    let mut from: Vec<i64> = Vec::with_capacity(m);
    let mut to: Vec<i64> = Vec::with_capacity(m);
    let mut w: Vec<i64> = Vec::with_capacity(m);
    defer from.free();
    defer to.free();
    defer w.free();
    for _ in 0..m {
        from.push(sc.next_int());
        to.push(sc.next_int());
        w.push(sc.next_int());
    }
    let mut g = build_graph(n, from.as_slice(), to.as_slice(), w.as_slice());
    defer g.start.free();
    defer g.targets.free();
    defer g.weights.free();
    let mut dist = filled(n, -1);
    defer dist.free();
    let mut heap = MinHeap { items: Vec::new() };
    defer heap.items.free();
    let mut out = Buf::new();
    defer out.free();
    for _ in 0..q {
        let s = sc.next_int();
        let t = sc.next_int();
        let d = shortest(&g, s, t, dist.as_slice(), &heap);
        out.push_int(d);
        out.push('\n');
    }
    print(out.as_slice());
    0
}
