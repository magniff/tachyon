// Shortest paths: Dijkstra with a binary heap, one search per query.
use std::{Buf, Scanner, read_stdin_in};

// The next number of the input (which is well formed).
fn next(sc: &mut Scanner) -> i64 {
    sc.next_int().unwrap()
}

struct HeapItem {
    dist: i64,
    node: i64,
}

// A binary min-heap on dist.
struct MinHeap {
    items: Vec<HeapItem>,
}

impl MinHeap {
    fn push(self: &mut MinHeap, item: HeapItem) {
        self.items.push(item);
        let s = self.items.as_mut_slice();
        let mut i = s.len() - 1;
        while i > 0 {
            let parent = (i - 1) / 2;
            if s[parent].dist <= s[i].dist {
                break;
            }
            let tmp = s[parent];
            s[parent] = s[i];
            s[i] = tmp;
            i = parent;
        }
    }

    fn pop(self: &mut MinHeap) -> Option<HeapItem> {
        let n = self.items.len();
        if n == 0 {
            return None;
        }
        let top = self.items.get(0);
        let last = self.items.pop().unwrap();
        if n > 1 {
            let s = self.items.as_mut_slice();
            s[0] = last;
            let len = n - 1;
            let mut i = 0;
            loop {
                let left = 2 * i + 1;
                let right = left + 1;
                let mut smallest = i;
                if left < len && s[left].dist < s[smallest].dist {
                    smallest = left;
                }
                if right < len && s[right].dist < s[smallest].dist {
                    smallest = right;
                }
                if smallest == i {
                    break;
                }
                let tmp = s[smallest];
                s[smallest] = s[i];
                s[i] = tmp;
                i = smallest;
            }
        }
        Some(top)
    }
}

// Adjacency lists in compressed form: the edges of u are
// targets[start[u]..start[u + 1]].
struct Graph {
    start: Vec<i64>,
    targets: Vec<i64>,
    weights: Vec<i64>,
}

fn filled(n: i64, x: i64, gpa: Gpa) -> Vec<i64> {
    let mut v: Vec<i64> = Vec::with_capacity_in(n, gpa);
    for _ in 0..n {
        v.push(x);
    }
    v
}

fn build_graph(n: i64, from: [i64], to: [i64], w: [i64], gpa: Gpa) -> Graph {
    let m = from.len();
    let mut start_v = filled(n + 1, 0, gpa);
    let start = start_v.as_mut_slice();
    for i in 0..m {
        start[from[i] + 1] += 1;
    }
    for u in 0..n {
        start[u + 1] += start[u];
    }
    let mut fill_v = filled(n + 1, 0, gpa);
    let fill = fill_v.as_mut_slice();
    for u in 0..n + 1 {
        fill[u] = start[u];
    }
    let targets_v = filled(m, 0, gpa);
    let weights_v = filled(m, 0, gpa);
    let targets = targets_v.as_mut_slice();
    let weights = weights_v.as_mut_slice();
    for i in 0..m {
        let k = fill[from[i]];
        targets[k] = to[i];
        weights[k] = w[i];
        fill[from[i]] += 1;
    }
    Graph { start: start_v, targets: targets_v, weights: weights_v }
}

fn shortest(g: &Graph, s: i64, t: i64, dist: &mut [i64], heap: &mut MinHeap) -> i64 {
    for i in 0..dist.len() {
        dist[i] = -1;
    }
    heap.items.clear();
    let start = g.start.as_slice();
    let targets = g.targets.as_slice();
    let weights = g.weights.as_slice();
    dist[s] = 0;
    heap.push(HeapItem { dist: 0, node: s });
    while let Some(item) = heap.pop() {
        let u = item.node;
        if item.dist != dist[u] {
            continue; // stale entry
        }
        if u == t {
            return item.dist;
        }
        for k in start[u]..start[u + 1] {
            let v = targets[k];
            let nd = item.dist + weights[k];
            if dist[v] < 0 || nd < dist[v] {
                dist[v] = nd;
                heap.push(HeapItem { dist: nd, node: v });
            }
        }
    }
    -1
}

fn main(gpa: Gpa) -> i32 {
    let mut input = read_stdin_in(gpa).unwrap();
    let mut sc = Scanner::new(input.as_slice());
    let n = next(&mut sc);
    let m = next(&mut sc);
    let q = next(&mut sc);
    let mut from: Vec<i64> = Vec::with_capacity_in(m, gpa);
    let mut to: Vec<i64> = Vec::with_capacity_in(m, gpa);
    let mut w: Vec<i64> = Vec::with_capacity_in(m, gpa);
    for _ in 0..m {
        from.push(next(&mut sc));
        to.push(next(&mut sc));
        w.push(next(&mut sc));
    }
    let mut g = build_graph(n, from.as_slice(), to.as_slice(), w.as_slice(), gpa);
    let mut dist = filled(n, -1, gpa);
    let mut heap = MinHeap { items: Vec::new_in(gpa) };
    let mut out = Buf::new_in(gpa);
    for _ in 0..q {
        let s = next(&mut sc);
        let t = next(&mut sc);
        let d = shortest(&g, s, t, dist.as_mut_slice(), &mut heap);
        out.push_int(d);
        out.push('\n');
    }
    print(out.as_slice());
    0
}
