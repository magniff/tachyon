// Bank ledger: commands on named accounts, errors per line, sorted reports.
use std::{Buf, HashMap, Scanner, read_stdin_in, sort};

struct Account {
    name: [u8],
    balance: i64,
    txns: i64,
}

impl Ord for Account {
    fn cmp(self: &Account, other: &Account) -> i64 {
        self.name.cmp(&other.name)
    }
}

enum Command {
    Open([u8]),
    Deposit([u8], i64),
    Withdraw([u8], i64),
    Transfer([u8], [u8], i64),
    Close([u8]),
    Balance([u8]),
    Report,
    Blank,
    Bad([u8]),
}

fn valid_name(s: [u8]) -> bool {
    if s.len() == 0 || s.len() > 16 {
        return false;
    }
    for ch in s {
        let ok = (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '_';
        if !ok {
            return false;
        }
    }
    true
}

// The amount, or 0 when it is not valid.
fn parse_amount(s: [u8]) -> i64 {
    if s.len() == 0 || s.len() > 12 {
        return 0;
    }
    let mut n = 0;
    for ch in s {
        if ch < '0' || ch > '9' {
            return 0;
        }
        n = n * 10 + (ch - '0') as i64;
    }
    n
}

fn split_tokens(line: [u8], gpa: Gpa) -> Vec<[u8]> {
    let mut tokens: Vec<[u8]> = Vec::new_in(gpa);
    let mut i = 0;
    while i < line.len() {
        if line[i] == ' ' {
            i += 1;
            continue;
        }
        let start = i;
        while i < line.len() && line[i] != ' ' {
            i += 1;
        }
        tokens.push(line[start..i]);
    }
    tokens
}

fn parse_command(line: [u8], gpa: Gpa) -> Command {
    let mut tokens = split_tokens(line, gpa);
    let t = tokens.as_slice();
    if t.len() == 0 {
        return Command::Blank;
    }
    let (args, names, amount) = if t[0] == "open" || t[0] == "close" || t[0] == "balance" {
        (1, 1, false)
    } else if t[0] == "deposit" || t[0] == "withdraw" {
        (2, 1, true)
    } else if t[0] == "transfer" {
        (3, 2, true)
    } else if t[0] == "report" {
        (0, 0, false)
    } else {
        return Command::Bad("error: bad command");
    };
    if t.len() != args + 1 {
        return Command::Bad("error: bad command");
    }
    for k in 1..names + 1 {
        if !valid_name(t[k]) {
            return Command::Bad("error: bad name");
        }
    }
    let mut amt = 0;
    if amount {
        amt = parse_amount(t[args]);
        if amt == 0 {
            return Command::Bad("error: bad amount");
        }
    }
    if t[0] == "open" {
        Command::Open(t[1])
    } else if t[0] == "close" {
        Command::Close(t[1])
    } else if t[0] == "balance" {
        Command::Balance(t[1])
    } else if t[0] == "deposit" {
        Command::Deposit(t[1], amt)
    } else if t[0] == "withdraw" {
        Command::Withdraw(t[1], amt)
    } else if t[0] == "transfer" {
        Command::Transfer(t[1], t[2], amt)
    } else {
        Command::Report
    }
}

fn push_account(out: &mut Buf, a: Account) {
    out.push_str(a.name);
    out.push(' ');
    out.push_int(a.balance);
    out.push(' ');
    out.push_int(a.txns);
    out.push('\n');
}

fn report(accounts: &HashMap<[u8], Account>, out: &mut Buf, gpa: Gpa) {
    let mut list: Vec<Account> = Vec::new_in(gpa);
    let mut total = 0;
    for i in 0..accounts.slots() {
        if let Some(a) = accounts.value_at(i) {
            list.push(a);
            total += a.balance;
        }
    }
    sort(list.as_slice());
    out.push_str("accounts: ");
    out.push_int(list.len());
    out.push_str(", total: ");
    out.push_int(total);
    out.push('\n');
    for a in list.as_slice() {
        push_account(out, a);
    }
}

fn execute(cmd: Command, accounts: &mut HashMap<[u8], Account>, out: &mut Buf, gpa: Gpa) -> Result<(),
    [u8]> {
    match cmd {
        Command::Blank => {}
        Command::Bad(msg) => return Err(msg),
        Command::Report => report(accounts, out, gpa),
        Command::Open(name) => {
            if accounts.contains(name) {
                return Err("error: account exists");
            }
            accounts.insert(name, Account { name: name, balance: 0, txns: 0 });
        }
        Command::Balance(name) => match accounts.get(name) {
            Some(a) => push_account(out, a),
            None => return Err("error: no such account"),
        },
        Command::Close(name) => {
            let a = match accounts.get(name) {
                Some(a) => a,
                None => return Err("error: no such account"),
            };
            if a.balance != 0 {
                return Err("error: balance not zero");
            }
            accounts.remove(name);
        }
        // get_mut: the account in place, a view of one element.
        Command::Deposit(name, amt) => match accounts.get_mut(name) {
            Some(a) => {
                a[0].balance += amt;
                a[0].txns += 1;
            }
            None => return Err("error: no such account"),
        },
        Command::Withdraw(name, amt) => {
            let a = match accounts.get_mut(name) {
                Some(a) => a,
                None => return Err("error: no such account"),
            };
            if a[0].balance < amt {
                return Err("error: insufficient funds");
            }
            a[0].balance -= amt;
            a[0].txns += 1;
        }
        Command::Transfer(from, to, amt) => {
            // Every check first, then one account in place at a time: two
            // get_mut views of one map at once would conflict (as in Rust).
            let balance = match accounts.get(from) {
                Some(a) => a.balance,
                None => return Err("error: no such account"),
            };
            if !accounts.contains(to) {
                return Err("error: no such account");
            }
            if from == to {
                return Err("error: same account");
            }
            if balance < amt {
                return Err("error: insufficient funds");
            }
            if let Some(src) = accounts.get_mut(from) {
                src[0].balance -= amt;
                src[0].txns += 1;
            }
            if let Some(dst) = accounts.get_mut(to) {
                dst[0].balance += amt;
                dst[0].txns += 1;
            }
        }
    }
    Ok(())
}

fn main(gpa: Gpa) -> i32 {
    // All of stdin, not read_line: account names are views of the input,
    // kept as the map's keys.
    let mut input = read_stdin_in(gpa).unwrap();
    let mut sc = Scanner::new(input.as_slice());
    let mut accounts: HashMap<[u8], Account> = HashMap::new_in(gpa);
    let mut out = Buf::new_in(gpa);
    while let Some(line) = sc.next_line() {
        if let Err(msg) = execute(parse_command(line, gpa), &mut accounts, &mut out, gpa) {
            out.push_str(msg);
            out.push('\n');
        }
    }
    print(out.as_slice());
    0
}
