// Interval coverage: merge closed integer intervals, answer queries on the union.
import "stdio.h" as c;
use std::{Buf, sort};

struct Scanner {
    data: [u8],
    pos: i64,
}

impl Scanner {
    // The next run of non-space bytes.
    fn next_token(self: *Scanner) -> [u8] {
        while self.pos < self.data.len && self.data[self.pos] <= ' ' {
            self.pos += 1;
        }
        let start = self.pos;
        while self.pos < self.data.len && self.data[self.pos] > ' ' {
            self.pos += 1;
        }
        self.data[start..self.pos]
    }

    fn next_int(self: *Scanner) -> i64 {
        let tok = self.next_token();
        let mut i = 0;
        let negative = tok.len > 0 && tok[0] == '-';
        if negative {
            i = 1;
        }
        let mut n = 0;
        while i < tok.len {
            n = n * 10 + (tok[i] - '0') as i64;
            i += 1;
        }
        if negative { -n } else { n }
    }
}

struct Interval {
    lo: i64,
    hi: i64,
}

impl Ord for Interval {
    fn cmp(self: *Interval, other: *Interval) -> i64 {
        if self.lo != other.lo {
            return if self.lo < other.lo { -1 } else { 1 };
        }
        if self.hi < other.hi { -1 } else if self.hi > other.hi { 1 } else { 0 }
    }
}

// The union: sorted, disjoint, non-touching intervals.
struct Union {
    parts: Vec<Interval>,
    // before[i]: the integers covered by parts[0..i].
    before: Vec<i64>,
}

fn merge(list: [Interval]) -> Union {
    sort(list);
    let mut parts: Vec<Interval> = Vec::new();
    for iv in list {
        let n = parts.len();
        if n > 0 && iv.lo <= parts.get(n - 1).hi + 1 {
            if iv.hi > parts.get(n - 1).hi {
                parts.as_slice()[n - 1].hi = iv.hi;
            }
        } else {
            parts.push(iv);
        }
    }
    let mut before: Vec<i64> = Vec::with_capacity(parts.len() + 1);
    let mut total = 0;
    before.push(0);
    for p in parts.as_slice() {
        total += p.hi - p.lo + 1;
        before.push(total);
    }
    Union { parts: parts, before: before }
}

impl Union {
    // The index of the last part with lo <= x, or -1.
    fn find(self: *Union, x: i64) -> i64 {
        let parts = self.parts.as_slice();
        let mut lo = 0;
        let mut hi = parts.len; // answer in lo-1..hi-1
        while lo < hi {
            let mid = (lo + hi) / 2;
            if parts[mid].lo <= x {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        lo - 1
    }

    fn covers(self: *Union, a: i64, b: i64) -> bool {
        let i = self.find(a);
        i >= 0 && self.parts.get(i).hi >= b
    }

    // The covered integers that are <= x.
    fn count_upto(self: *Union, x: i64) -> i64 {
        let i = self.find(x);
        if i < 0 {
            return 0;
        }
        let p = self.parts.get(i);
        let end = if p.hi < x { p.hi } else { x };
        self.before.get(i) + end - p.lo + 1
    }

    fn total(self: *Union) -> i64 {
        self.before.get(self.parts.len())
    }
}

fn push_yes_no(out: *Buf, yes: bool) {
    out.push_str(if yes { "yes\n" } else { "no\n" });
}

fn read_all() -> Buf {
    let mut b = Buf::new();
    loop {
        let ch = unsafe { c::getchar() };
        if ch < 0 {
            break;
        }
        b.push(ch as u8);
    }
    b
}

fn main() -> i32 {
    let mut input = read_all();
    defer input.free();
    let mut sc = Scanner { data: input.as_slice(), pos: 0 };
    let n = sc.next_int();
    let mut list: Vec<Interval> = Vec::new();
    defer list.free();
    for _ in 0..n {
        let lo = sc.next_int();
        let hi = sc.next_int();
        list.push(Interval { lo: lo, hi: hi });
    }
    let mut u = merge(list.as_slice());
    defer u.parts.free();
    defer u.before.free();
    let mut out = Buf::new();
    defer out.free();
    out.push_int(u.parts.len());
    out.push(' ');
    out.push_int(u.total());
    out.push('\n');
    let q = sc.next_int();
    for _ in 0..q {
        let kind = sc.next_token();
        if kind == "point" {
            let x = sc.next_int();
            push_yes_no(&out, u.covers(x, x));
        } else if kind == "cover" {
            let a = sc.next_int();
            let b = sc.next_int();
            push_yes_no(&out, u.covers(a, b));
        } else {
            let a = sc.next_int();
            let b = sc.next_int();
            let count = u.count_upto(b) - u.count_upto(a - 1);
            out.push_int(count);
            out.push('\n');
        }
    }
    print(out.as_slice());
    0
}
