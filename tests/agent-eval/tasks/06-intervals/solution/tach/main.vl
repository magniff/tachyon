// Interval coverage: merge closed integer intervals, answer queries on the union.
use std::{Buf, Scanner, read_stdin_in, sort};

// The next number of the input (which is well formed).
fn next(sc: inout Scanner) -> i64 {
    sc.next_int().unwrap()
}

struct Interval {
    lo: i64,
    hi: i64,
}

impl Ord for Interval {
    fn cmp(self, other: Interval) -> i64 {
        if self.lo != other.lo {
            return if self.lo < other.lo { -1 } else { 1 };
        }
        if self.hi < other.hi { -1 } else if self.hi > other.hi { 1 } else { 0 }
    }
}

// The union: sorted, disjoint, non-touching intervals.
struct Union {
    parts: Vec<Interval>,
    // before[i]: the integers covered by parts[0..i].
    before: Vec<i64>,
}

fn merge(list: inout [Interval], gpa: Gpa) -> Union {
    sort(list);
    var parts: Vec<Interval> = Vec::new_in(gpa);
    for iv in list {
        let n = parts.len();
        if n > 0 && iv.lo <= parts.get(n - 1).hi + 1 {
            if iv.hi > parts.get(n - 1).hi {
                parts.as_slice()[n - 1].hi = iv.hi;
            }
        } else {
            parts.push(iv);
        }
    }
    var before: Vec<i64> = Vec::with_capacity_in(parts.len() + 1, gpa);
    var total = 0;
    before.push(0);
    for p in parts.as_slice() {
        total += p.hi - p.lo + 1;
        before.push(total);
    }
    Union { parts: parts, before: before }
}

impl Union {
    // The index of the last part with lo <= x, or -1.
    fn find(self, x: i64) -> i64 {
        let parts = self.parts.as_slice();
        var lo = 0;
        var hi = parts.len(); // answer in lo-1..hi-1
        while lo < hi {
            let mid = (lo + hi) / 2;
            if parts[mid].lo <= x {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        lo - 1
    }

    fn covers(self, a: i64, b: i64) -> bool {
        let i = self.find(a);
        i >= 0 && self.parts.get(i).hi >= b
    }

    // The covered integers that are <= x.
    fn count_upto(self, x: i64) -> i64 {
        let i = self.find(x);
        if i < 0 {
            return 0;
        }
        let p = self.parts.get(i);
        let end = if p.hi < x { p.hi } else { x };
        self.before.get(i) + end - p.lo + 1
    }

    fn total(self) -> i64 {
        self.before.get(self.parts.len())
    }
}

fn push_yes_no(out: inout Buf, yes: bool) {
    out.push_str(if yes { "yes\n" } else { "no\n" });
}

fn main(gpa: Gpa) -> i32 {
    var input = read_stdin_in(gpa).unwrap();
    var sc = Scanner::new(input.as_slice());
    let n = next(&sc);
    var list: Vec<Interval> = Vec::new_in(gpa);
    for _ in 0..n {
        let lo = next(&sc);
        let hi = next(&sc);
        list.push(Interval { lo: lo, hi: hi });
    }
    var u = merge(list.as_mut_slice(), gpa);
    var out = Buf::new_in(gpa);
    out.push_int(u.parts.len());
    out.push(' ');
    out.push_int(u.total());
    out.push('\n');
    let q = next(&sc);
    for _ in 0..q {
        let kind = sc.next_token().unwrap();
        if kind == "point" {
            let x = next(&sc);
            push_yes_no(&out, u.covers(x, x));
        } else if kind == "cover" {
            let a = next(&sc);
            let b = next(&sc);
            push_yes_no(&out, u.covers(a, b));
        } else {
            let a = next(&sc);
            let b = next(&sc);
            let count = u.count_upto(b) - u.count_upto(a - 1);
            out.push_int(count);
            out.push('\n');
        }
    }
    print(out.as_slice());
    0
}
