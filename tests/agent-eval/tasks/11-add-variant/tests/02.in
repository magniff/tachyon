.list
; sum of i*i for i = 10 down to 1
    push 10     ; n
    push 0      ; acc
square:
    pick 1
    pick 2
    mul
    add         ; n acc+n*n
    swap
    push 1
    sub
    swap        ; n-1 acc
    pick 1
    jz done
    jmp square
done:
    print
    pop
; fibonacci below 1000
    push 0
    push 1
fib:
    pick 1
    print
    swap
    pick 1
    add
    pick 1
    push 1000
    lt
    jz end
    jmp fib
end:
    halt
