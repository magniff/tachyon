// The instructions of the stack machine: their names, costs and kinds.

pub enum Op {
    // Pushes a constant.
    Push(i64),
    // Drops the top value.
    Pop,
    // Pushes a copy of the top value.
    Dup,
    // Swaps the top two values.
    Swap,
    // Pushes a copy of the value under the top.
    Over,
    // The binary operations pop b, then a, and push `a op b`.
    Add,
    Sub,
    Mul,
    Div,
    Mod,
    // 1 if a < b, else 0.
    Lt,
    // 1 if a == b, else 0.
    Eq,
    // Jumps to an instruction.
    Jmp(i64),
    // Pops a value; jumps if it is zero.
    Jz(i64),
    // Pops a value and prints it on a line.
    Print,
    // Stops the machine.
    Halt,
}

// The kinds of instruction, counted separately when the machine runs.
pub const STACK: i64 = 0;
pub const ARITH: i64 = 1;
pub const CONTROL: i64 = 2;
pub const IO: i64 = 3;

pub fn kind_name(k: i64) -> [u8] {
    if k == STACK {
        "stack"
    } else if k == ARITH {
        "arith"
    } else if k == CONTROL {
        "control"
    } else {
        "io"
    }
}

// The instruction's name in source and listings.
pub fn mnemonic(op: Op) -> [u8] {
    match op {
        Op::Push(_) => "push",
        Op::Pop => "pop",
        Op::Dup => "dup",
        Op::Swap => "swap",
        Op::Over => "over",
        Op::Add => "add",
        Op::Sub => "sub",
        Op::Mul => "mul",
        Op::Div => "div",
        Op::Mod => "mod",
        Op::Lt => "lt",
        Op::Eq => "eq",
        Op::Jmp(_) => "jmp",
        Op::Jz(_) => "jz",
        Op::Print => "print",
        Op::Halt => "halt",
    }
}

// What executing the instruction costs.
pub fn cost(op: Op) -> i64 {
    match op {
        Op::Push(_) | Op::Pop | Op::Dup | Op::Swap | Op::Over => 1,
        Op::Add | Op::Sub | Op::Lt | Op::Eq => 1,
        Op::Mul => 3,
        Op::Div | Op::Mod => 10,
        Op::Jmp(_) | Op::Jz(_) => 2,
        Op::Print => 5,
        Op::Halt => 0,
    }
}

// The instruction's kind: STACK, ARITH, CONTROL or IO.
pub fn kind(op: Op) -> i64 {
    match op {
        Op::Push(_) | Op::Pop | Op::Dup | Op::Swap | Op::Over => STACK,
        Op::Add | Op::Sub | Op::Mul | Op::Div | Op::Mod | Op::Lt | Op::Eq => ARITH,
        Op::Jmp(_) | Op::Jz(_) | Op::Halt => CONTROL,
        Op::Print => IO,
    }
}
