// Runs a verified program.

use crate::op::{Op, cost, kind};
use std::Buf;

// The machine stops after this many steps.
pub const STEP_LIMIT: i64 = 100000;

// Why the machine stopped.
pub const RUNNING: i64 = 0;
pub const HALTED: i64 = 1;
pub const DIVIDE_BY_ZERO: i64 = 2;
pub const OUT_OF_STEPS: i64 = 3;

pub struct Machine {
    pub stack: Vec<i64>,
    pub pc: i64,
    pub steps: i64,
    pub cost: i64,
    // Steps run of each kind of instruction.
    pub counts: [i64; 4],
    pub status: i64,
}

impl Machine {
    pub fn new(gpa: Gpa) -> Machine {
        Machine {
            stack: Vec::new_in(gpa), pc: 0, steps: 0, cost: 0, counts: [0; 4], status: RUNNING
        }
    }

    fn pop(inout self) -> i64 {
        self.stack.pop().unwrap()
    }

    fn top(self, below: i64) -> i64 {
        self.stack.get(self.stack.len() - 1 - below)
    }
}

// Runs one instruction, or sets `m.status` to why it cannot. Printed
// values go to `out`.
pub fn step(ops: [Op], m: inout Machine, out: inout Buf) {
    if m.pc >= ops.len() {
        m.status = HALTED;
        return;
    }
    if m.steps == STEP_LIMIT {
        m.status = OUT_OF_STEPS;
        return;
    }
    let op = ops[m.pc];
    var next = m.pc + 1;
    match op {
        Op::Push(v) => m.stack.push(v),
        Op::Pop => {
            m.pop();
        }
        Op::Dup => m.stack.push(m.top(0)),
        Op::Swap => {
            let b = m.pop();
            let a = m.pop();
            m.stack.push(b);
            m.stack.push(a);
        }
        Op::Over => m.stack.push(m.top(1)),
        Op::Pick(n) => m.stack.push(m.top(n)),
        Op::Add | Op::Sub | Op::Mul | Op::Div | Op::Mod | Op::Lt | Op::Eq => {
            let b = m.top(0);
            let a = m.top(1);
            if (op == Op::Div || op == Op::Mod) && b == 0 {
                m.status = DIVIDE_BY_ZERO;
                return;
            }
            m.pop();
            m.pop();
            m.stack.push(binary(op, a, b));
        }
        Op::Jmp(t) => next = t,
        Op::Jz(t) => {
            if m.pop() == 0 {
                next = t;
            }
        }
        Op::Print => {
            let v = m.pop();
            out.push_int(v);
            out.push('\n');
        }
        Op::Halt => {
            m.status = HALTED;
        }
    }
    m.steps += 1;
    m.cost += cost(op);
    m.counts[kind(op)] += 1;
    if m.status == RUNNING {
        m.pc = next;
    }
}

// a op b for the binary operations; integers wrap.
fn binary(op: Op, a: i64, b: i64) -> i64 {
    match op {
        Op::Add => a + b,
        Op::Sub => a - b,
        Op::Mul => a * b,
        Op::Div => a / b,
        Op::Mod => a % b,
        Op::Lt => if a < b { 1 } else { 0 },
        Op::Eq => if a == b { 1 } else { 0 },
        _ => 0,
    }
}

// Runs from instruction 0 until the machine stops.
pub fn run(ops: [Op], out: inout Buf, gpa: Gpa) -> Machine {
    var m = Machine::new(gpa);
    while m.status == RUNNING {
        step(ops, &m, &out);
    }
    m
}
