// A stack machine: reads a program from stdin, checks it, lists it if
// asked, runs it, and reports how it stopped.

mod op;
mod parse;
mod verify;
mod vm;

import "stdio.h" as c;
use std::Buf;

use op::{Op, kind_name, mnemonic};
use vm::{DIVIDE_BY_ZERO, HALTED, OUT_OF_STEPS};

// The instruction as a listing shows it: its name and operand.
fn write_op(out: inout Buf, op: Op) {
    out.push_str(mnemonic(op));
    match op {
        Op::Push(n) | Op::Pick(n) | Op::Jmp(n) | Op::Jz(n) => {
            out.push(' ');
            out.push_int(n);
        }
        Op::Pop | Op::Dup | Op::Swap | Op::Over => {}
        Op::Add | Op::Sub | Op::Mul | Op::Div | Op::Mod | Op::Lt | Op::Eq => {}
        Op::Print | Op::Halt => {}
    }
}

fn main(gpa: Gpa) -> i32 {
    var input = Buf::new_in(gpa);
    loop {
        let ch = unsafe { c::getchar() };
        if ch < 0 {
            break;
        }
        input.push(ch as u8);
    }
    var out = Buf::new_in(gpa);
    run_program(input.as_slice(), &out, gpa);
    print(out.as_slice());
    0
}

fn run_program(input: [u8], out: inout Buf, gpa: Gpa) {
    var prog = match parse::parse(input, gpa) {
        Ok(p) => p,
        Err(e) => {
            out.push_str("parse error on line ");
            out.push_int(e.line);
            out.push_str(": ");
            e.message.push_to(&out);
            out.push('\n');
            return;
        }
    };
    if let Err(e) = verify::verify(prog.ops.as_slice(), gpa) {
        out.push_str("verify error at ");
        out.push_int(e.pc);
        out.push_str(": ");
        out.push_str(e.message);
        out.push('\n');
        return;
    }
    if prog.list {
        for pc in 0..prog.ops.len() {
            out.push_int(pc);
            out.push_str(": ");
            write_op(&out, prog.ops.get(pc));
            out.push('\n');
        }
    }
    var m = vm::run(prog.ops.as_slice(), &out, gpa);
    if m.status == HALTED {
        out.push_str("halted");
    } else if m.status == DIVIDE_BY_ZERO {
        out.push_str("division by zero");
    } else if m.status == OUT_OF_STEPS {
        out.push_str("out of steps");
    }
    out.push_str(" at ");
    out.push_int(m.pc);
    out.push_str(" after ");
    out.push_int(m.steps);
    out.push_str(" steps, cost ");
    out.push_int(m.cost);
    out.push('\n');
    out.push_str("stack:");
    if m.stack.len() == 0 {
        out.push_str(" empty");
    }
    for v in m.stack.as_slice() {
        out.push(' ');
        out.push_int(v);
    }
    out.push('\n');
    for k in 0..4 {
        out.push_str(if k == 0 { "steps: " } else { ", " });
        out.push_str(kind_name(k));
        out.push(' ');
        out.push_int(m.counts[k]);
    }
    out.push('\n');
}
