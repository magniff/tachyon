// metalrun: runs `wgslc metal-job` jobs on Metal, headless (compute only),
// and prints the buffers as `wgslc run` does, so the interpreter's output
// and the GPU's compare as text. Jobs come on stdin, one after another,
// each ended by `end`; each output is ended by `end` too (one process
// serves a whole fuzzing batch).
//
// Built by tests/wgsl/run.sh: `tachyonc -c`, then `cc ... -framework Metal
// -framework Foundation -lobjc` (tachyonc has no -framework before C4).
// Every call into Objective-C is a C boundary: the `unsafe` blocks below
// are those calls and the pointer reads of Metal's buffer contents.
use std::Buf;

import "stdio.h" as c;
import "stdlib.h" as c;
import "string.h" as c;

#[repr(C)]
struct MTLSize { w: u64, h: u64, d: u64 }

#[repr(C)]
struct MTLRegion { x: u64, y: u64, z: u64, w: u64, h: u64, d: u64 }

extern "C" {
    fn MTLCreateSystemDefaultDevice() -> *u8;
    fn sel_registerName(name: *u8) -> *u8;
    fn objc_getClass(name: *u8) -> *u8;
    fn objc_autoreleasePoolPush() -> *u8;
    fn objc_autoreleasePoolPop(pool: *u8);
    #[link_name = "objc_msgSend"]
    fn msg(o: *u8, s: *u8) -> *u8;
    #[link_name = "objc_msgSend"]
    fn msg_u64(o: *u8, s: *u8) -> u64;
    #[link_name = "objc_msgSend"]
    fn msg_p(o: *u8, s: *u8, a: *u8) -> *u8;
    #[link_name = "objc_msgSend"]
    fn msg_set_u64(o: *u8, s: *u8, a: u64);
    #[link_name = "objc_msgSend"]
    fn msg_set_bool(o: *u8, s: *u8, a: bool);
    #[link_name = "objc_msgSend"]
    fn msg_ppp(o: *u8, s: *u8, a: *u8, b: *u8, c: **u8) -> *u8;
    #[link_name = "objc_msgSend"]
    fn msg_pp(o: *u8, s: *u8, a: *u8, b: **u8) -> *u8;
    #[link_name = "objc_msgSend"]
    fn msg_buf(o: *u8, s: *u8, p: *u8, len: u64, opts: u64) -> *u8;
    #[link_name = "objc_msgSend"]
    fn msg_set_buffer(o: *u8, s: *u8, buf: *u8, off: u64, index: u64);
    #[link_name = "objc_msgSend"]
    fn msg_set_bytes(o: *u8, s: *u8, p: *u8, len: u64, index: u64);
    #[link_name = "objc_msgSend"]
    fn msg_dispatch(o: *u8, s: *u8, grid: MTLSize, tg: MTLSize);
    #[link_name = "objc_msgSend"]
    fn msg_tex_desc(o: *u8, s: *u8, format: u64, w: u64, h: u64, mipmapped: bool) -> *u8;
    #[link_name = "objc_msgSend"]
    fn msg_replace(o: *u8, s: *u8, region: MTLRegion, level: u64, bytes: *u8, bpr: u64);
    #[link_name = "objc_msgSend"]
    fn msg_set_texture(o: *u8, s: *u8, t: *u8, index: u64);
}

fn sel(name: *u8) -> *u8 { unsafe { sel_registerName(name) } }

// An NSString's or NSError's text, for messages.
fn describe(o: *u8) -> [u8] {
    if o == 0 as *u8 {
        return "(nil)";
    }
    unsafe {
        let d = msg(o, sel(c"localizedDescription"));
        let s = msg(d, sel(c"UTF8String"));
        s[0..c::strlen(s) as i64]
    }
}

struct Buffer { group: i64, binding: i64, slot: i64, bytes: i64, words: Vec<u32> }

struct Texture { slot: i64, format: u64, bpp: i64, w: i64, h: i64, words: Vec<u32> }

fn parse_u32(t: [u8]) -> u32 {
    var v: u64 = 0;
    for i in 0..t.len {
        v = v * 10 + (t[i] - '0') as u64;
    }
    v as u32
}

// Runs one job (its text after the MSL); false on a Metal error.
fn run(dev: *u8, queue: *u8, msl: [u8], rest: [u8], out: inout Buf, gpa: Gpa) -> bool {
    var entry: [u8] = "";
    var tg: [u64; 3] = [1, 1, 1];
    var groups: [u64; 3] = [1, 1, 1];
    var bufs: Vec<Buffer> = Vec::new_in(gpa);
    var sizes: Vec<u32> = Vec::new_in(gpa);
    var sizes_slot: i64 = -1;
    var functions: Vec<[u8]> = Vec::new_in(gpa);
    var textures: Vec<Texture> = Vec::new_in(gpa);
    var sc = Scanner::new(rest);
    while let Some(line) = sc.next_line() {
        let w = split_whitespace_in(line, gpa);
        if w.len() == 0 {
            continue;
        }
        if w[0] == "entry" {
            entry = w[1];
        } else if w[0] == "tg" || w[0] == "dispatch" {
            for k in 0..3 {
                let v = parse_u32(w[k + 1]) as u64;
                if w[0] == "tg" {
                    tg[k] = v;
                } else {
                    groups[k] = v;
                }
            }
        } else if w[0] == "buffer" {
            var b = Buffer {
                group: parse_int(w[1]).unwrap(), binding: parse_int(w[2]).unwrap(),
                slot: parse_int(w[3]).unwrap(), bytes: parse_int(w[4]).unwrap(),
                words: Vec::new_in(gpa)
            };
            for k in 5..w.len() {
                b.words.push(parse_u32(w[k]));
            }
            // missing words are zero
            while b.words.len() * 4 < b.bytes {
                b.words.push(0);
            }
            bufs.push(b);
        } else if w[0] == "texture" {
            let fm = w[2];
            let (format, bpp) = if fm == "rgba8unorm" { (70, 4) }
                else if fm == "r8unorm" { (10, 1) } else if fm == "rgba32float" { (125, 16) }
                else { (123, 16) };
            var t = Texture {
                slot: parse_int(w[1]).unwrap(), format: format as u64, bpp: bpp,
                w: parse_int(w[3]).unwrap(), h: parse_int(w[4]).unwrap(), words: Vec::new_in(gpa)
            };
            for k in 5..w.len() {
                t.words.push(parse_u32(w[k]));
            }
            textures.push(t);
        } else if w[0] == "functions" {
            for k in 1..w.len() {
                functions.push(w[k]);
            }
        } else if w[0] == "sizes" {
            sizes_slot = parse_int(w[1]).unwrap();
            for k in 3..w.len() {
                sizes.push(parse_u32(w[k]));
            }
        }
    }
    var src = Buf::new_in(gpa);
    src.push_str(msl);
    src.push(0);
    var name = Buf::new_in(gpa);
    name.push_str(entry);
    name.push(0);
    unsafe {
        let nsstring = objc_getClass(c"NSString");
        let s = msg_p(nsstring, sel(c"stringWithUTF8String:"), src.as_slice().ptr);
        let opts = msg(objc_getClass(c"MTLCompileOptions"), sel(c"new"));
        // MTLLanguageVersion3_0, and IEEE math (the interpreter's)
        msg_set_u64(opts, sel(c"setLanguageVersion:"), 196608);
        msg_set_bool(opts, sel(c"setFastMathEnabled:"), false);
        var err = 0 as *u8;
        let lib = msg_ppp(dev, sel(c"newLibraryWithSource:options:error:"), s, opts, &err);
        if lib == 0 as *u8 {
            out.push_str(f"error metal.compile: {describe(err)}\n");
            return false;
        }
        if functions.len() > 0 {
            // compile only: every entry point is there
            for i in 0..functions.len() {
                var fnm = Buf::new_in(gpa);
                fnm.push_str(functions[i]);
                fnm.push(0);
                let ns = msg_p(nsstring, sel(c"stringWithUTF8String:"), fnm.as_slice().ptr);
                let fun = msg_p(lib, sel(c"newFunctionWithName:"), ns);
                if fun == 0 as *u8 {
                    out.push_str(f"error metal.entry: no function '{functions[i]}'\n");
                    return false;
                }
                msg(fun, sel(c"release"));
            }
            msg(lib, sel(c"release"));
            msg(opts, sel(c"release"));
            return true;
        }
        let fname = msg_p(nsstring, sel(c"stringWithUTF8String:"), name.as_slice().ptr);
        let func = msg_p(lib, sel(c"newFunctionWithName:"), fname);
        if func == 0 as *u8 {
            out.push_str(f"error metal.entry: no function '{entry}'\n");
            return false;
        }
        var err2 = 0 as *u8;
        let pso = msg_pp(dev, sel(c"newComputePipelineStateWithFunction:error:"), func, &err2);
        if pso == 0 as *u8 {
            out.push_str(f"error metal.pipeline: {describe(err2)}\n");
            return false;
        }
        let cb = msg(queue, sel(c"commandBuffer"));
        let enc = msg(cb, sel(c"computeCommandEncoder"));
        msg_p(enc, sel(c"setComputePipelineState:"), pso);
        var mtl: Vec<*u8> = Vec::new_in(gpa);
        for i in 0..bufs.len() {
            let b = bufs[i];
            let mb = msg_buf(dev, sel(c"newBufferWithBytes:length:options:"),
                b.words.as_slice().ptr as *u8, b.bytes as u64, 0);
            msg_set_buffer(enc, sel(c"setBuffer:offset:atIndex:"), mb, 0, b.slot as u64);
            mtl.push(mb);
        }
        for i in 0..textures.len() {
            let t = textures[i];
            let desc = msg_tex_desc(objc_getClass(c"MTLTextureDescriptor"),
                sel(c"texture2DDescriptorWithPixelFormat:width:height:mipmapped:"), t.format,
                t.w as u64, t.h as u64, false);
            let tex = msg_p(dev, sel(c"newTextureWithDescriptor:"), desc);
            if tex == 0 as *u8 {
                out.push_str("error metal.texture: cannot make a texture\n");
                return false;
            }
            let region = MTLRegion { x: 0, y: 0, z: 0, w: t.w as u64, h: t.h as u64, d: 1 };
            msg_replace(tex, sel(c"replaceRegion:mipmapLevel:withBytes:bytesPerRow:"), region, 0,
                t.words.as_slice().ptr as *u8, (t.w * t.bpp) as u64);
            msg_set_texture(enc, sel(c"setTexture:atIndex:"), tex, t.slot as u64);
        }
        if sizes_slot >= 0 {
            let n = if sizes.len() > 0 { sizes.len() } else { 1 };
            if sizes.len() == 0 {
                sizes.push(0);
            }
            msg_set_bytes(enc, sel(c"setBytes:length:atIndex:"), sizes.as_slice().ptr as *u8,
                (n * 4) as u64, sizes_slot as u64);
        }
        msg_dispatch(enc, sel(c"dispatchThreadgroups:threadsPerThreadgroup:"),
            MTLSize { w: groups[0], h: groups[1], d: groups[2] },
            MTLSize { w: tg[0], h: tg[1], d: tg[2] });
        msg(enc, sel(c"endEncoding"));
        msg(cb, sel(c"commit"));
        msg(cb, sel(c"waitUntilCompleted"));
        let e = msg(cb, sel(c"error"));
        if e != 0 as *u8 {
            out.push_str(f"error metal.run: {describe(e)}\n");
            return false;
        }
        for i in 0..bufs.len() {
            let b = bufs[i];
            out.push_str(f"buffer {b.group} {b.binding}\n");
            let p = msg(mtl[i], sel(c"contents")) as *u32;
            let n = b.bytes / 4;
            for k in 0..n {
                out.push_str(f"{p[k]:08x}");
                out.push(if k % 8 == 7 || k == n - 1 { '\n' } else { ' ' });
            }
            msg(mtl[i], sel(c"release"));
        }
        msg(pso, sel(c"release"));
        msg(func, sel(c"release"));
        msg(lib, sel(c"release"));
        msg(opts, sel(c"release"));
    }
    true
}

fn main(gpa: Gpa) -> i32 {
    let input = read_stdin_in(gpa).unwrap();
    let text = input.as_slice();
    let dev = unsafe { MTLCreateSystemDefaultDevice() };
    if dev == 0 as *u8 {
        eprintln("error metal.device: no Metal device");
        return 2;
    }
    let queue = unsafe { msg(dev, sel(c"newCommandQueue")) };
    var out = Buf::new_in(gpa);
    var status = 0;
    var i = 0;
    while i < text.len {
        // "msl N\n", then N bytes of MSL, then lines up to "end"
        if text.len - i < 4 || text[i..i + 4] != "msl " {
            i += 1;
            continue;
        }
        var j = i + 4;
        var n = 0;
        while j < text.len && text[j] != '\n' {
            n = n * 10 + (text[j] - '0') as i64;
            j += 1;
        }
        j += 1;
        let msl = text[j..j + n];
        j += n;
        var k = j;
        while k + 4 <= text.len && !(text[k..k + 4] == "end\n" && (k == 0 || text[k - 1] == '\n')) {
            k += 1;
        }
        let rest = text[j..k];
        let pool = unsafe { objc_autoreleasePoolPush() };
        // dev and queue are Objective-C objects, opaque handles
        if !unsafe { run(dev, queue, msl, rest, &out, gpa) } {
            status = 1;
        }
        unsafe { objc_autoreleasePoolPop(pool) };
        out.push_str("end\n");
        print(out.as_slice());
        out.clear();
        i = k + 4;
    }
    status as i32
}
