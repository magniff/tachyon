// PPM (P6) and PGM (P5) files for the reference images, and a clock.

extern "C" {
    fn fopen(path: *u8, mode: *u8) -> *u8;
    fn fclose(f: *u8) -> i32;
    fn fwrite(p: *u8, size: u64, n: u64, f: *u8) -> u64;
    fn fread(p: *u8, size: u64, n: u64, f: *u8) -> u64;
    fn clock_gettime_nsec_np(clock: i32) -> u64;
}

// Nanoseconds of a monotonic clock (CLOCK_UPTIME_RAW).
pub fn now_ns() -> i64 {
    // SAFETY: a libc clock read, no pointers.
    unsafe { clock_gettime_nsec_np(8) as i64 }
}

// A NUL-terminated copy of `path` in `buf`.
fn cpath(path: [u8], buf: inout Buf) {
    buf.clear();
    buf.push_str(path);
    buf.push(0);
}

// Writes w × h pixels of `chans` bytes (3: from RGBA8 `px`, dropping
// alpha, as P6; 1: grey as P5).
pub fn write(path: [u8], px: [u8], w: i64, h: i64, chans: i64, gpa: Gpa) -> bool {
    var b = Buf::new_in(gpa);
    if chans == 1 {
        b.push_str("P5\n");
    } else {
        b.push_str("P6\n");
    }
    b.push_int(w);
    b.push_str(" ");
    b.push_int(h);
    b.push_str("\n255\n");
    if chans == 1 {
        for i in 0..w * h {
            b.push(px[i]);
        }
    } else {
        for i in 0..w * h {
            b.push(px[i * 4]);
            b.push(px[i * 4 + 1]);
            b.push(px[i * 4 + 2]);
        }
    }
    var p = Buf::new_in(gpa);
    cpath(path, &p);
    let s = b.as_slice();
    // SAFETY: fopen/fwrite/fclose with a NUL-terminated path and a live
    // slice of s.len bytes.
    unsafe {
        let f = fopen(p.as_slice().ptr, c"wb");
        if f == 0 as *u8 {
            return false;
        }
        let n = fwrite(s.ptr, 1, s.len as u64, f);
        fclose(f);
        n == s.len as u64
    }
}

// Reads a P5 or P6 file into `out` (RGBA8 for P6, grey for P5); the size
// and channel count, or None.
pub fn read(path: [u8], out: inout Vec<u8>, gpa: Gpa) -> Option<(i64, i64, i64)> {
    var p = Buf::new_in(gpa);
    cpath(path, &p);
    var data: Vec<u8> = Vec::new_in(gpa);
    var chunk: [u8; 65536] = [0; 65536];
    // SAFETY: fread into a local array of the size it is told.
    unsafe {
        let f = fopen(p.as_slice().ptr, c"rb");
        if f == 0 as *u8 {
            return None;
        }
        loop {
            let n = fread(&chunk as *u8, 1, 65536, f) as i64;
            for i in 0..n {
                data.push(chunk[i]);
            }
            if n < 65536 {
                break;
            }
        }
        fclose(f);
    }
    let d = data.as_slice();
    if d.len < 3 || d[0] != 'P' {
        return None;
    }
    let chans = if d[1] == '5' { 1 } else { 3 };
    // Three numbers after the magic, then one whitespace byte.
    var nums: [i64; 3] = [0, 0, 0];
    var i = 2;
    for k in 0..3 {
        while i < d.len && (d[i] == ' ' || d[i] == '\n') {
            i += 1;
        }
        while i < d.len && d[i] >= '0' && d[i] <= '9' {
            nums[k] = nums[k] * 10 + (d[i] - '0') as i64;
            i += 1;
        }
    }
    i += 1;
    let w = nums[0];
    let h = nums[1];
    if d.len < i + w * h * chans {
        return None;
    }
    out.clear();
    for j in 0..w * h {
        if chans == 1 {
            out.push(d[i + j]);
        } else {
            out.push(d[i + j * 3]);
            out.push(d[i + j * 3 + 1]);
            out.push(d[i + j * 3 + 2]);
            out.push(255);
        }
    }
    Some((w, h, chans))
}
