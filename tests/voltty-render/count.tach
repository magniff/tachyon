// Counts the program's own allocations: this executable's malloc and
// realloc (std's Gpa calls them) are defined here and forwarded to the
// default malloc zone. Frameworks bind to libsystem_malloc directly (the
// two-level namespace), so Metal's and Core Text's own allocations are
// not counted: the count is what tachyon code asked for.

extern "C" {
    fn malloc_default_zone() -> *u8;
    fn malloc_zone_malloc(zone: *u8, n: u64) -> *u8;
    fn malloc_zone_realloc(zone: *u8, p: *u8, n: u64) -> *u8;
}

static var ALLOCS: i64 = 0;

extern "C" fn malloc(n: u64) -> *u8 {
    ALLOCS += 1;
    // SAFETY: the default zone's malloc, what libc's malloc calls.
    unsafe { malloc_zone_malloc(malloc_default_zone(), n) }
}

extern "C" fn realloc(p: *u8, n: u64) -> *u8 {
    ALLOCS += 1;
    // SAFETY: as malloc; p came from this zone (or is null).
    unsafe { malloc_zone_realloc(malloc_default_zone(), p, n) }
}

// Allocations (and resizes) so far.
pub fn allocs() -> i64 {
    ALLOCS
}
