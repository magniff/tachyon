// a default method with a let self calling an inout-self method
// ERROR: [own.readonly]
trait C {
    fn bump(inout self);
    fn twice(self) { self.bump(); self.bump(); }
}

struct P { x: i64 }
impl C for P { fn bump(inout self) { self.x += 1; } }

fn main() {
    var p = P { x: 1 };
    p.twice();
    println(f"{p.x}");
}
