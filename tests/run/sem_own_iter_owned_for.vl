// sem-own: owned items made by map, iterated by for: each dropped at the end of its iteration.
// EXPECT: it 0
// EXPECT: drop 0
// EXPECT: it 1
// EXPECT: drop 1
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    for d in (0..2).map(|i| mk(i, gpa)) { println(f"it {d.id}"); }
    println("end");
}
