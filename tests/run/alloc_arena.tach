// 0.16: an Arena (its chunks from main's Gpa) under every container:
// Vec, Buf, HashMap, and what std makes on an allocator it is given
// (format_in, collect_in, clone_in, split_in, sort_stable_in). Blocks
// bump through chunks; the last block grows in place; a request above
// 32 KB gets a chunk of its own (given back by `free`); `reset` keeps the
// chunks, `free_all` gives everything back.
// EXPECT: 499500 1000 4950 hello 42 [1, 2, 3]
// EXPECT: grew in place: true; used 24 then 48
// EXPECT: large: true, freed: true
// EXPECT: x=7 y=[1, 2, 3] 1234567890
// EXPECT: [0, 2, 4, 6, 8] 5 [a, bb, ccc] [1, 2, 3, 5, 8]
// EXPECT: copy on gpa: 45 [0, 1, 2]
// EXPECT: reset: used 0, chunks kept: true
// EXPECT: free_all: used 0
use std::{Buf, HashMap, format_in, sort_stable_in, split_in};

fn total<A: Allocator>(v: *Vec<i64, A>) -> i64 {
    let mut t = 0;
    for x in v.iter() {
        t += x;
    }
    t
}

fn main(gpa: Gpa) {
    let mut a = Arena::new_in(gpa);
    // containers
    let mut v: Vec<i64, Arena> = Vec::new_in(a);
    for i in 0..1000 {
        v.push(i);
    }
    let mut m: HashMap<i64, i64, Arena> = HashMap::with_capacity_in(10, a);
    for i in 0..100 {
        m.insert(i, i);
    }
    let mut mt = 0;
    for i in 0..100 {
        mt += m.get(i).unwrap();
    }
    let mut b: Buf<Arena> = Buf::new_in(a);
    b.push_str("hello ");
    b.push_int(42);
    let mut w: Vec<i64, Arena> = Vec::with_capacity_in(2, a);
    w.extend_from_slice([1, 2, 3][..]);
    println(f"{total(&v)} {v.len()} {mt} {b} {w:?}");
    // the last block grows in place
    let mut g = Arena::new_in(gpa);
    let p = g.alloc(16, 8);
    let q = unsafe { g.resize(p, 16, 48, 8) };
    let before = g.used();
    unsafe {
        g.free(q, 48, 8);
    }
    let after = g.alloc(24, 8);
    println(f"grew in place: {p == q}; used {g.used()} then {before}");
    // a block of its own
    let held = g.chunk_bytes();
    let mut big: Vec<u8, Arena> = Vec::with_capacity_in(80000, g);
    for i in 0..80000 {
        big.push((i % 7) as u8);
    }
    let lent = g.chunk_bytes() - held;
    big.free();
    println(f"large: {lent >= 80000}, freed: {g.chunk_bytes() == held}");
    // formatting and std's functions on an arena
    let s = format_in(f"x={7} y={w:?}", a);
    let mut t: Buf<Arena> = Buf::new_in(a);
    t.push_fmt(1234567890);
    println(f"{s} {t}");
    let evens = (0..5).map(|i: i64| i * 2).collect_in(a);
    let parts = split_in("a,bb,ccc", ',', a);
    let mut fib: Vec<i64, Arena> = Vec::new_in(a);
    for x in [8, 3, 5, 1, 2] {
        fib.push(x);
    }
    sort_stable_in(fib.as_slice(), a);
    print(f"{evens:?} {evens.len()} [");
    for i in 0..parts.len() {
        print(if i > 0 { ", " } else { "" });
        print(parts.get(i));
    }
    println(f"] {fib:?}");
    let small: Vec<i64, Arena> = (0..10).collect_in(a);
    let mut copy = small.clone_in(gpa);
    copy.truncate(3);
    println(f"copy on gpa: {total(&small)} {copy:?}");
    copy.free();
    // reset keeps the chunks; free_all gives them back
    let chunks = a.chunk_bytes();
    unsafe {
        a.reset();
    }
    println(f"reset: used {a.used()}, chunks kept: {a.chunk_bytes() == chunks}");
    unsafe {
        a.free_all();
        g.free_all();
    }
    println(f"free_all: used {a.used()}");
}
