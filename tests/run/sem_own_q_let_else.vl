// (0.25) let-else on a borrowed copy (`let Some(t) = v.last() else ..`): its
// bindings borrow, as `match`'s, `?`'s and unwrap's do; nothing is dropped twice.
// EXPECT: 1 5 7 3
// EXPECT: live 0
static var LIVE: i64 = 0;
struct T { id: i64 }
fn mk(id: i64) -> T { LIVE += 1; T { id: id } }
impl Drop for T { fn drop(inout self) { LIVE -= 1; } }
fn le(v: Vec<T>) -> i64 { let Some(t) = v.last() else { return 0; }; t.id }
fn le2(v: Vec<(T, T)>) -> i64 { let Some((a, b)) = v.last() else { return 0; }; a.id + b.id }
fn le3(v: Vec<T>) -> i64 { let Some(t) = v.as_slice().get(3) else { return 7; }; t.id }

fn main(gpa: Gpa) -> i32 {
    { var v: Vec<T> = Vec::new_in(gpa); v.push(mk(1));
        var w: Vec<(T, T)> = Vec::new_in(gpa); w.push((mk(2), mk(3)));
        println(f"{le(v)} {le2(w)} {le3(v)} {LIVE}"); }
    println(f"live {LIVE}");
    0
}
