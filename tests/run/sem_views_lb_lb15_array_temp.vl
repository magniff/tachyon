// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: a slice of an array literal temporary kept across iterations
// ERROR: error[own.escape]
fn main(gpa: Gpa) -> i32 {
    var keep: Vec<[u8]> = Vec::new_in(gpa);
    for i in 0..2 {
        let c = 'a' + i as u8;
        let a = [c, c];
        keep.push(a[..]);
    }
    println(f"{keep.get(0)} {keep.get(1)}");
    0
}
