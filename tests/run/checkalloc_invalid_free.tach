// FLAGS: --check-alloc
// EXIT: 101
// STDERR: invalid free at
// STDERR: checkalloc_invalid_free.tach:14:9:
// STDERR: is 16 bytes into block #2 (48 bytes), allocated at
// STDERR: checkalloc_invalid_free.tach:11:13
// 0.16: --check-alloc: freeing an address no block starts at (here, one
// inside a block; a stack address is "not a block of Gpa").
fn main(gpa: Gpa) {
    let q = gpa.alloc(8, 8);
    let p = gpa.alloc(48, 8);
    unsafe {
        gpa.free(q, 8, 8);
        gpa.free(&p[16], 32, 8);
    }
}
