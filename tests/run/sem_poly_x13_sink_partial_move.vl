// a sink closure moving one field out of a captured struct: the other field freed by the closure's drop
// FLAGS: --check-alloc
// EXPECT: 1
// XFAIL: OVERSTRICT a sink closure may move a whole capture out but not one field of it
struct P { a: Vec<i64>, b: Vec<i64> }
fn eat(v: sink Vec<i64>) -> i64 { v.len() }
fn call<F: FnMut() -> i64>(f: sink F) -> i64 { f() }

fn main(gpa: Gpa) {
    var a: Vec<i64> = Vec::new_in(gpa);
    a.push(1);
    var b: Vec<i64> = Vec::new_in(gpa);
    b.push(2); b.push(3);
    let p = P { a: a, b: b };
    println(f"{call(sink || eat(p.a))}");
}
