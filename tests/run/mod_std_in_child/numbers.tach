use std::{Option, Vec};

pub fn run(gpa: Gpa) {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..5 {
        v.push(i * i);
    }
    let mut sum = 0;
    for x in v.as_slice() {
        sum += x;
    }
    std::print_int(sum + 0);
    unsafe { std::print_cstr(c"\n"); }
    match v.pop() {
        Option::Some(last) => { std::print_int(last / 4); unsafe { std::print_cstr(c"\n"); } }
        Option::None => {}
    }
}
