// EXPECT: -1 0 1
// EXPECT: neg low mid max high
// EXPECT: k=7, plain [  7]
// 0.17: a range pattern's bounds may be constants' paths (`i8::MIN..=-1`,
// `0..=m::TOP`, `i64::MAX` alone); `b.push_str(f"..")` is `b.push_fmt(..)`.
use std::Buf;

const LIMIT: i64 = 100;

mod m {
    pub const TOP: i64 = 50;
}

fn sign(x: i8) -> i64 {
    match x {
        i8::MIN..=-1 => -1,
        0 => 0,
        1..=i8::MAX => 1,
    }
}

fn bucket(x: i64) -> [u8] {
    match x {
        i64::MIN..=-1 => "neg",
        0..=m::TOP => "low",
        51..=LIMIT => "mid",
        i64::MAX => "max",
        _ => "high",
    }
}

fn more(b: *Buf, k: i64) {
    b.push_str(f" [{k:>3}]");
}

fn main(gpa: Gpa) {
    println(f"{sign(-5)} {sign(0)} {sign(7)}");
    println(f"{bucket(-3)} {bucket(10)} {bucket(70)} {bucket(i64::MAX)} {bucket(200)}");
    let mut b: Buf = Buf::new_in(gpa);
    defer b.free();
    let k = 7;
    b.push_str(f"k={k}, ");
    b.push_str("plain");
    more(&b, k);
    println(b.as_slice());
}
