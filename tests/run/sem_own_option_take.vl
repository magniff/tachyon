// sem-own: std::take on an Option leaves None; the taken one dropped once.
// EXPECT: took 4
// EXPECT: drop 4
// EXPECT: none true
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    var o: Option<D> = Some(mk(4, gpa));
    {
        let t = std::replace(&o, None);
        if let Some(d) = t { println(f"took {d.id}"); }
    }
    println(f"none {o.is_none()}");
    println("end");
}
