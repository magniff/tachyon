// Ord's cmp is #[pure], which binds every impl: one that prints is rejected.
// ERROR: 'V::cmp' implements 'Ord::cmp', which is #[pure], but it does io
struct V { n: i64 }
impl Ord for V {
    fn cmp(self, o: V) -> i64 { println("io"); self.n - o.n }
}

fn main() -> i32 {
    println(V { n: 1 } < V { n: 2 });
    0
}
