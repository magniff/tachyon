// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a closure returning a part of its parameter
// XFAIL: SOUNDNESS the item of a temporary str/Path iterator loses its origin: use after free
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let first = |x: str| -> str { x.split(' ').next().unwrap() };
    let r = first(s.as_str());
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
