// sem-own: std::take/replace of an inout parameter: the taken value dropped once.
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: now 0
// EXPECT: drop 0
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn f(d: inout D, gpa: Gpa) {
    let t = std::replace(&d, D { id: 0, v: Vec::new_in(gpa) }); println(f"got {t.id}");
}

fn main(gpa: Gpa) {
    var a = mk(1, gpa);
    f(&a, gpa);
    println(f"now {a.id}");
}
