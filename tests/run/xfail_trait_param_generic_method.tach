// (0.22) A trait with a type parameter cannot have a generic method: the
// method's own parameter is "unknown type 'M'". std::gpu::hal::Render<B>
// takes `err: &mut Buf` (Gpa) where hal::Api's methods take `&mut Buf<A>`
// for any allocator.
// XFAIL: a generic method of a trait with a type parameter (0.22)
// EXPECT: 5

pub trait Api {
    type Device;
}

pub trait Render<B: Api> {
    fn label<M: Allocator>(out: &mut Buf<M>) -> i64;
}

pub struct Metal {}

impl Api for Metal {
    type Device = i64;
}

impl Render<Metal> for Metal {
    fn label<M: Allocator>(out: &mut Buf<M>) -> i64 {
        out.push_str("metal");
        out.len()
    }
}

fn main(gpa: Gpa) {
    let mut b = Buf::new_in(gpa);
    println(Metal::label(&mut b));
}
