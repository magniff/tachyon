// Shifts: the amount mod 64 for 64-bit operands, mod 32 for narrower ones
// (shifted as 32-bit values, then truncated); a negative amount is large.
// EXPECT: 0 2 -9223372036854775808 1 2
// EXPECT: 0 2
// EXPECT: 1 2 -9223372036854775808 -1 -1
// EXPECT: 1 2147483648 2
// EXPECT: -1 -1 -1 -128
// EXPECT: 64 0 128 64
// EXPECT: 0 -1 -1
// EXPECT: 1 18446744073709551615 9223372036854775808
// EXPECT: -1 -128 0 64 0
// EXPECT: 128 5
static var Z: i64 = 0;

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let z = Z;
    // constants, from the grammar's examples
    let one8: u8 = 1;
    println(f"{one8 << 9} {one8 << 33} {1 << -1} {1 << 64} {1 << 65}");
    // run time
    let o8: u8 = 1 + z as u8;
    let n9: u8 = 9 + z as u8; let n33: u8 = 33 + z as u8;
    println(f"{o8 << n9} {o8 << n33}");
    let one = 1 + z;
    println(
        f"{one << (64 + z)} {one << (65 + z)} {one << (-1 + z)} {(-1 + z) >> (63 + z)} {(-1 + z) >> (64 + z)}");
    let o32: u32 = 1 + z as u32;
    println(f"{o32 << (32 + z as u32)} {o32 << (31 + z as u32)} {o32 << (33 + z as u32)}");
    let i8m: i8 = -128 + z as i8;
    println(
        f"{i8m >> (9 + z as i8)} {i8m >> (7 + z as i8)} {i8m >> (31 + z as i8)} {i8m >> (32 + z as i8)}");
    let u8m: u8 = 128 + z as u8;
    println(
        f"{u8m >> (1 + z as u8)} {u8m >> (8 + z as u8)} {u8m >> (32 + z as u8)} {u8m >> (33 + z as u8)}");
    let i16v: i16 = -2 + z as i16;
    println(f"{i16v << (15 + z as i16)} {i16v >> (16 + z as i16)} {i16v >> (48 + z as i16)}");
    let u64v: u64 = 18446744073709551615 + z as u64;
    println(f"{u64v >> (63 + z as u64)} {u64v >> (64 + z as u64)} {u64v << (127 + z as u64)}");
    // constant folding of the same narrow cases
    let c8: i8 = -128;
    let cu8: u8 = 128;
    println(f"{c8 >> 9} {c8 >> 32} {cu8 >> 8} {cu8 >> 33} {cu8 << 1}");
    // compound
    var s: u8 = 3 + z as u8; s <<= 7; var t: i64 = 5 + z; t <<= 64 + z;
    println(f"{s} {t}");
    0
}
