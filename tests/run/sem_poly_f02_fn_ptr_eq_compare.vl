// fn pointers compared with ==: the same function equal, others not
// FLAGS: --check-alloc
// EXPECT: true false
fn a(x: i64) -> i64 { x + 1 }
fn b(x: i64) -> i64 { x + 2 }

fn main() {
    let f: fn(i64) -> i64 = a;
    let g: fn(i64) -> i64 = a;
    let h: fn(i64) -> i64 = b;
    println(f"{f == g} {f == h}");
}
