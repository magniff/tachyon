// 0.20 T1: writes through accesses reach the caller's place: fields,
// nested fields, compound assignment, owned fields replaced (the old
// value dropped), pushes, through `inout` parameters, `inout self`, an
// `inout r = &x` local, generic instances (`x = v` for T = Vec), and access
// fields (`struct H { p: inout P }`).
// FLAGS: --syntax=0.20
// EXPECT: 6 15 15 1
// EXPECT: 8 28 2 7 set
// EXPECT: 40 30 3 0
// EXPECT: 9 1 1
// EXPECT: 1 2 0
// EXPECT: 15 2 7
// EXPECT: new
struct In { b: i64, w: Vec<i64> }
struct P { q: i64, a: In, items: Vec<i64>, name: Buf }

impl P {
    fn set(inout self, v: i64, gpa: Gpa) {
        self.q = v;
        self.q += 1;
        self.a.b = v * 2;
        self.a.b *= 2;
        self.items.push(v);
        self.a.w = Vec::new_in(gpa);
        self.a.w.push(v);
        self.name = Buf::new_in(gpa);
        self.name.push_str("set");
    }
}

fn upd(p: inout P, v: i64, gpa: Gpa) {
    p.q = v;
    p.q += 1;
    p.a.b = v * 3;
    p.items.push(v);
    p.items[0] += 10;
    p.a.w = Vec::new_in(gpa);
    p.a.w.push(1);
    p.name = Buf::new_in(gpa);
}

fn gen<T>(x: inout T, v: sink T) { x = v; }
fn gen_push<T>(x: inout Vec<T>, v: sink T) { x.push(v); }

fn whole(p: inout P, gpa: Gpa) {
    p = P {
        q: 1, a: In { b: 2, w: Vec::new_in(gpa) }, items: Vec::new_in(gpa), name: Buf::new_in(gpa)
    };
}

fn main1(gpa: Gpa) {
    var p = P {
        q: 0, a: In { b: 0, w: Vec::new_in(gpa) }, items: Vec::new_in(gpa), name: Buf::new_in(gpa)
    };
    upd(&p, 5, gpa);
    println(f"{p.q} {p.a.b} {p.items[0]} {p.a.w.len()}");
    p.set(7, gpa);
    println(f"{p.q} {p.a.b} {p.items.len()} {p.a.w[0]} {p.name.as_slice()}");
    inout r = &p;
    r.q = 40;
    r.a.b += 2;
    r.items.push(1);
    r.a.w = Vec::new_in(gpa);
    println(f"{p.q} {p.a.b} {p.items.len()} {p.a.w.len()}");
    var n = 1;
    gen(&n, 9);
    var s: Vec<i64> = Vec::new_in(gpa);
    s.push(3);
    var t: Vec<i64> = Vec::new_in(gpa);
    gen(&s, t);
    gen_push(&s, 4);
    var bs: Vec<Buf> = Vec::new_in(gpa);
    gen_push(&bs, Buf::new_in(gpa));
    println(f"{n} {s.len()} {bs.len()}");
    whole(&p, gpa);
    println(f"{p.q} {p.a.b} {p.items.len()}");
}

struct H { p: inout P2, n: inout i64 }
struct P2 { q: i64, items: Vec<i64> }
fn work(h: inout H) { h.p.q += 5; h.p.items.push(3); }

fn main2(gpa: Gpa) {
    var p = P2 { q: 1, items: Vec::new_in(gpa) };
    var k = 0;
    var h = H { p: &p, n: &k };
    h.p.q = 10;
    h.p.items.push(2);
    work(&h);
    h.n = 7;
    println(f"{p.q} {p.items.len()} {k}");
    more(gpa);
}

struct B { b: inout Buf }
fn rebuf(x: inout B, gpa: Gpa) { x.b = Buf::new_in(gpa); x.b.push_str("new"); }

fn more(gpa: Gpa) {
    var buf = Buf::new_in(gpa);
    buf.push_str("old");
    var x = B { b: &buf };
    rebuf(&x, gpa);
    println(buf.as_slice());
}

fn main(gpa: Gpa) {
    main1(gpa);
    main2(gpa);
}
