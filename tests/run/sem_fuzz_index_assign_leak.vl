// (0.25, the semantics fuzzer) Assigning an owned element, `w[i] = x`,
// or `w.set(i, x)` (which writes `self.as_mut_slice()[i] = x`), does not
// drop the old element: it leaks. A field assignment, `s.a = x`, drops
// the old value first, as the design says every owned place does.
// XFAIL: SOUNDNESS an assignment to an indexed owned element leaks the old one
// EXPECT: d1
// EXPECT: assigned
// EXPECT: d2
// EXPECT: set
// EXPECT: d5
// EXPECT: field
// EXPECT: d6
// EXPECT: d3
// EXPECT: d4
// EXPECT: live 0

static var NEXT: i64 = 0;
static var LIVE: i64 = 0;
struct T { id: i64 }
fn mk() -> T { NEXT += 1; LIVE += 1; T { id: NEXT } }
impl Drop for T {
    fn drop(inout self) { LIVE -= 1; println(f"d{self.id}"); }
}
struct S { a: T }

fn run(gpa: Gpa) {
    var w: Vec<T> = Vec::new_in(gpa);
    w.push(mk());
    w.push(mk());
    w[0] = mk();
    println("assigned");
    w.set(1, mk());
    println("set");
    var s = S { a: mk() };
    s.a = mk();
    println("field");
}

fn main(gpa: Gpa) -> i32 {
    run(gpa);
    println(f"live {LIVE}");
    0
}
