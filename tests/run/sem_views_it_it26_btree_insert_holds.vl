// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: m holds a view of s; s grows; m read
// XFAIL: SOUNDNESS BTreeMap/BTreeSet/HashSet insert does not record the view it stores: use after free
// ERROR: error[own.conflict]
use std::collections::btree_map::BTreeMap;

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var m: BTreeMap<i64, str> = BTreeMap::new_in(gpa);
    m.insert(1, s.as_str());
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(m.get(1).unwrap());
    0
}
