// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a generic apply of an identity closure returns a view of the argument
// ERROR: error[own.conflict]
fn apply<F: Fn(str) -> str>(f: F, x: str) -> str { f(x) }
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    let r = apply(|x| x.trim(), s.as_str());
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
