// Entry facts are never reached unchecked (0.18.1, middle::entryfacts): a
// requires is checked at direct calls only, so a function whose address
// is taken assumes nothing at its entry. `at` is called directly (its
// check passes) and then through a fn value with an index out of bounds:
// its own bounds check still stops it, at every level.
// FLAGS: -O2
// EXPECT: 3
// EXIT: 101
// STDERR: index out of bounds: index 12, length 10

#[inline(never)]
fn at(v: Vec<i64>, i: i64) -> i64
    requires 0 <= i && i < v.len()
{
    v[i]
}

#[inline(never)]
fn through(f: fn(let Vec<i64>, i64) -> i64, v: Vec<i64>, i: i64) -> i64 {
    f(v, i)
}

fn main(gpa: Gpa, argc: i64, argv: **u8) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..10 {
        v.push(i);
    }
    println(f"{at(v, 3)}");
    println(f"{through(at, v, 11 + argc)}");
    0
}
