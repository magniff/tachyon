// (0.16) Value numbering of calls: two calls of a function that reads and
// writes no memory (readnone: inferred, or a libm function from the
// builtin table of C effects) with the same arguments are one, wherever
// the first dominates the second; two calls of one that only reads
// memory (readonly) are one within a block when nothing is written
// between them.
// EXPECT: 8198104266001300 9.0 8 3 8
// CHECK: fn twice:
// CHECK: call mix
// CHECK-NOT: call mix
// CHECK: fn roots:
// CHECK: call sqrt
// CHECK-NOT: call sqrt
// CHECK: fn branches:
// CHECK: call mix
// CHECK-NOT: call mix
// CHECK: fn peeks:
// CHECK: call peek
// CHECK-NOT: call peek
// CHECK: fn peeks_write:
// CHECK: call peek
// CHECK: store
// CHECK: call peek
// CHECK: fn main:
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn sqrt(x: f64) -> f64;
}

static var TABLE: [i64; 4] = [3, 1, 4, 1];

#[inline(never)]
fn mix(x: i64) -> i64 {
    var h = x;
    for i in 0..10 {
        h = h * 31 + i;
    }
    h
}

#[inline(never)]
fn peek(i: i64) -> i64 {
    unsafe { TABLE[i & 3] }
}

fn twice(x: i64) -> i64 {
    mix(x) + mix(x)
}

fn roots(x: f64) -> f64 {
    unsafe { sqrt(x) * sqrt(x) }
}

// The first call dominates the second.
fn branches(x: i64, c: bool) -> i64 {
    let a = mix(x);
    if c {
        return a - mix(x);
    }
    a
}

fn peeks(i: i64) -> i64 {
    peek(i) + peek(i)
}

// A store between: the second call may read what it wrote.
fn peeks_write(i: i64) -> i64 {
    let a = peek(i);
    unsafe {
        TABLE[1] = a;
    }
    a + peek(i)
}

fn main() -> i32 {
    // (Through function values: no constant arguments, nothing inlined.)
    let f = twice;
    let g = roots;
    let h = branches;
    let p = peeks;
    let q = peeks_write;
    unsafe {
        printf(c"%ld %.1f %ld %ld %ld\n", f(5), g(9.0), h(1, true) + p(2), q(2) - 5, q(1));
    }
    0
}
