// XFAIL: SOUNDNESS a view made after the closure, used after calling it (use after free)
// the closure (capturing v inout) is made first, then a view, then the closure called
// ERROR: own.conflict
fn main(gpa: Gpa) { var v: Vec<i64> = Vec::new_in(gpa); v.push(1); var g = || { for i in 0..1000 { v.push(i); } }; let s = v.as_slice(); g(); println(f"{s[0]}"); }
