// 0.21: `var`, `inout` and `sink` are keywords (conventions.md D27; in
// 0.20 they were identifiers where they were not its words): a name
// spelled so is an error, with the rename in its help.
// ERROR: 'sink' is a keyword (`var x = ..`, `x: inout T`, `x: sink T`): a name cannot be spelled so
fn main() {
    let sink = 1;
    println(f"{sink}");
}
