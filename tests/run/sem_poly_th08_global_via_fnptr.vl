// a thread reaching a static var through a fn pointer
// ERROR: [sync.not_send]: 'thread::spawn' moves 'f'
use std::thread;
static var G: i64 = 0;
fn touch() -> i64 { G += 1; G }

fn main() {
    let f: fn() -> i64 = touch;
    let h = thread::spawn(sink || f());
    let a = touch();
    println(f"{h.join() + a}");
}
