// A #[no_io] template is checked per instance.
// ERROR: 'read' is #[no_io], but it does io
trait Get { fn get(self) -> i64; }
struct Loud { n: i64 }
impl Get for Loud { fn get(self) -> i64 { println("io"); self.n } }
struct Calm { n: i64 }
impl Get for Calm { fn get(self) -> i64 { self.n } }

#[no_io]
fn read<T: Get>(t: T) -> i64 { t.get() }

fn main() -> i32 {
    println(read(Calm { n: 1 }) + read(Loud { n: 2 }));
    0
}
