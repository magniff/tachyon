// EXPECT: 12 0
// EXPECT: 10
// EXPECT: 6 7
// EXPECT: 33
// EXPECT: 80
// EXPECT: 20
// EXPECT: 3
// 0.10: vectors in statics (constant lanes), enums, tuples, generics,
// branches, arrays and through pointers.
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

static mut G: v2i64 = v2i64(1, 2);

enum Shape {
    Point(v2f64),
    Box(v2f64, v2f64),
    Empty,
}

fn area(s: Shape) -> f64 {
    match s {
        Shape::Point(_) => 0.0,
        Shape::Box(a, b) => {
            let d = b - a;
            d.lane(0) * d.lane(1)
        }
        Shape::Empty => -1.0,
    }
}

fn id<T>(x: T) -> T {
    x
}

fn pick(c: bool, a: v4i32, b: v4i32) -> v4i32 {
    if c { a } else { b }
}

fn main() -> i32 {
    let s = Shape::Box(v2f64(1.0, 2.0), v2f64(4.0, 6.0));
    unsafe { printf(c"%g %g\n", area(s), area(Shape::Point(v2f64::splat(3.0)))); }
    let v = id(v4f32(1.0, 2.0, 3.0, 4.0));
    unsafe { printf(c"%g\n", v.sum() as f64); }
    let t = (v2i64(5, 6), 7);
    unsafe { printf(c"%ld %ld\n", t.0.lane(1), t.1); }
    G = G + v2i64(10, 20);
    unsafe { printf(c"%ld\n", G.sum()); }
    let mut acc = v4i32::splat(0);
    for i in 0..10 {
        acc = pick(i % 2 == 0, acc + v4i32::splat(i as i32), acc);
    }
    unsafe { printf(c"%d\n", acc.sum()); }
    let p = &acc;
    unsafe { printf(c"%d\n", (*p).lane(3)); }
    let arr = [v2f64::splat(1.0), v2f64::splat(2.0)];
    let mut tot = v2f64::splat(0.0);
    for x in arr[..] {
        tot += x;
    }
    unsafe { printf(c"%g\n", tot.lane(0)); }
    0
}
