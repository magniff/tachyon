// a fn passed by name to with returns a view of the locked data
// ERROR: [own.escape]: the function's result views its argument, the data 'with' locks
use std::sync::Mutex;
fn view(d: inout Vec<i64>) -> [i64] { d.as_slice() }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let m = Mutex::new(v);
    let s = m.with(view);
    println(f"{s[0]}");
}
