// a fn passed by name to with returns a view of the locked data
// ERROR: [sync.view_item]: the closure given to the lock returns [i64], a view
use std::sync::Mutex;
fn view(d: inout Vec<i64>) -> [i64] { d.as_slice() }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let m = Mutex::new(v);
    let s = m.with(view);
    println(f"{s[0]}");
}
