// (0.21) A scoped thread only reads what it borrows (0.21.0).
// ERROR: a thread of 'thread::scope' changes 'total', which the scope's other code may use at the same time

use std::thread;

fn main() {
    let mut total = 0;
    thread::scope(|s| {
        s.spawn(|| { total += 1; 0 });
        0
    });
    println(f"{total}");
}
