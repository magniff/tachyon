// a thread handle dropped without join; the thread's owned capture dropped once
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: 1
// EXPECT: drop 2
// EXPECT: end
use std::thread;
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }

fn main() {
    let r = R { id: 1 };
    let h = thread::spawn(sink || r.id);
    println(f"{h.join()}");
    let r2 = R { id: 2 };
    let h2 = thread::spawn(sink || r2.id);
    drop(h2);
    thread::yield_now();
    println("end");
}
