// a thread handle dropped without join; the thread's owned capture dropped once
// (0.25: main waits on an atomic the drop sets, not on one yield: a
// detached thread need not have run by then, and under load it had not)
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: 1
// EXPECT: drop 2
// EXPECT: end
use std::thread;
use std::sync::atomic::{AtomicI64, Ordering};

static DROPS: AtomicI64 = AtomicI64 { v: 0 };

struct R { id: i64 }

impl Drop for R {
    fn drop(inout self) {
        println(f"drop {self.id}");
        DROPS.fetch_add(1, Ordering::AcqRel);
    }
}

fn main() {
    let r = R { id: 1 };
    let h = thread::spawn(sink || r.id);
    println(f"{h.join()}");
    let r2 = R { id: 2 };
    let h2 = thread::spawn(sink || r2.id);
    drop(h2);
    while DROPS.load(Ordering::Acquire) < 2 {
        thread::yield_now();
    }
    println("end");
}
