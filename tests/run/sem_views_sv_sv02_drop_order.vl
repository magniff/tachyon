// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: g (declared first) views v (declared later), so v is dropped before g's Drop reads it
// ERROR: error[own.drop_view]
struct G { s: [i64] }
impl Drop for G { fn drop(inout self) { println(self.s.len()); } }
fn main(gpa: Gpa) -> i32 {
    let u: Vec<i64> = Vec::new_in(gpa);
    var g = G { s: u.as_slice() };
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    g = G { s: v.as_slice() };
    println(v.len());
    0
}
