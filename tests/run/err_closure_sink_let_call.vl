// (0.25) A sink closure that changes what it owns changes itself when
// called: a let binding of it cannot be called (FnMut needs inout).
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    let c = sink || { v.push(1); v.len() };
    println(f"{c()}");
}
// ERROR: 'c()' changes 'c', a let binding: it is read-only
