// A leaf function (no call, nothing on the stack) has no frame: no frame
// pointer, no saved return address, just `ret`. Called through function
// pointers, so that it is not inlined.
// EXPECT: 111 -7 12
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn poly(x: i64) -> i64 {
    x * x * 3 + x * 7 + 1
}

fn clamp(x: i64) -> i64 {
    if x < -7 { -7 } else if x > 99 { 99 } else { x }
}

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

fn main() -> i32 {
    let fs: [fn(i64) -> i64; 2] = [poly, clamp];
    printf(c"%ld %ld %ld\n", apply(fs[0], 5), apply(fs[1], -20), apply(fs[1], 12));
    0
}

// ASM(aarch64-macos): poly:
// ASM-NOT(aarch64-macos): stp x29
// ASM(aarch64-macos): ret
// ASM(aarch64-macos): clamp:
// ASM-NOT(aarch64-macos): stp x29
// ASM(aarch64-macos): ret
// ASM(x86_64-macos): poly:
// ASM-NOT(x86_64-macos): pushq %rbp
// ASM(x86_64-macos): ret
// ASM(x86_64-linux): poly:
// ASM-NOT(x86_64-linux): pushq %rbp
// ASM(x86_64-linux): ret
