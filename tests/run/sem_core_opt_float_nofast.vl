// No fast-math: no reassociation, contraction, or folds that are wrong
// for NaN, infinities or -0.0, at any level.
// EXPECT: NaN -0 NaN false true
// EXPECT: inf -inf true false NaN
// EXPECT: 1 0
// EXPECT: 0
// EXPECT: 0 0
static var Z: i64 = 0;

#[inline(never)]
fn times_zero(x: f64) -> f64 { x * 0.0 }
#[inline(never)]
fn minus_self(x: f64) -> f64 { x - x }
#[inline(never)]
fn self_eq(x: f64) -> bool { x == x }
#[inline(never)]
fn self_ne(x: f64) -> bool { x != x }
#[inline(never)]
fn plus_zero(x: f64) -> f64 { x + 0.0 }
#[inline(never)]
fn not_lt(a: f64, b: f64) -> bool { !(a < b) }
#[inline(never)]
fn ge(a: f64, b: f64) -> bool { a >= b }
#[inline(never)]
fn assoc(a: f64, b: f64, c: f64) -> f64 { (a + b) + c }
#[inline(never)]
fn mul_add(a: f64, b: f64, c: f64) -> f64 { a * b + c }
#[inline(never)]
fn div_self(x: f64) -> f64 { x / x }

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let zf = Z as f64;
    let nan = (0.0 + zf) / (0.0 + zf);
    let inf = (1.0 + zf) / (0.0 + zf);
    let nz = -(0.0 + zf);
    println(f"{times_zero(inf)} {times_zero(-1.0 + zf)} {minus_self(inf)} {self_eq(nan)} {self_ne(nan)}");
    println(f"{1.0 / plus_zero(nz)} {1.0 / nz} {not_lt(nan, 1.0 + zf)} {ge(nan, 1.0 + zf)} {div_self(0.0 + zf)}");
    println(f"{assoc(1e16 + zf, -1e16 + zf, 1.0 + zf)} {assoc(1.0 + zf, 1e16 + zf, -1e16 + zf)}");
    println(f"{mul_add(0.1 + zf, 10.0 + zf, -1.0 + zf)}");
    let x: f32 = 16777216.0 + zf as f32;
    println(f"{x + 1.0 - x} {(x + 1.0) + 1.0 - x}");
    0
}
