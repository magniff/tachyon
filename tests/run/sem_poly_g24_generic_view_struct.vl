// a generic struct holding a view (T = [i64]) outliving the Vec
// ERROR: [own.escape]: the block's value views 'v', which dies
struct Box1<T> { x: T }
fn mk<T>(x: sink T) -> Box1<T> { Box1 { x: x } }

fn main(gpa: Gpa) {
    let b = {
        var v: Vec<i64> = Vec::new_in(gpa);
        v.push(1);
        mk(v.as_slice())
    };
    println(f"{b.x[0]}");
}
