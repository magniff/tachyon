// f64 arithmetic printed with full precision.
// EXPECT: 0.30000000000000004 -0.10000000000000001 0.020000000000000004 0.5
// EXPECT: inf 0 inf
// EXPECT: 123456789.000000 17636.684143
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let a: f64 = 0.1;
    let b: f64 = 0.2;
    printf("%.17g %.17g %.17g %.17g\n".0, a + b, a - b, a * b, a / b);
    let c: f64 = 1e300;
    let d: f64 = 1e-300;
    printf("%.17g %.17g %.17g\n".0, c * c, d * d, c / d);
    let e: f64 = 123456.789;
    printf("%.6f %.6f\n".0, e * 1000.0, e / 7.0);
    0
}
