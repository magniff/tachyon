// Division and remainder by constants (strength-reduced) at the extremes of every width.
// EXPECT: -3074457345618258602 -2 1317624576693539401 0 -1317624576693539401 -1 -4611686018427387904 0 4611686018427387904 -2305843009213693951
// EXPECT: -7 -2 -1 0 -1 -1 -1 0
// EXPECT: 2635249153387078802 1 6148914691236517205 1844674407370955161 5 1 1
// EXPECT: -715827882 -2 306783378 1 -2147483648 -306783378
// EXPECT: 613566756 3 1431655765
// EXPECT: -42 -2 -18 36 3 -10922 -8
static var Z: i64 = 0;

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let max = 9223372036854775807 + Z;
    let min = -9223372036854775807 - 1 + Z;
    println(f"{min / 3} {min % 3} {max / 7} {max % 7} {min / 7} {min % 7} {min / 2} {min % 2} {min / -2} {(min + 1) / 4}");
    println(f"{-7 + Z / 3} {(-7 + Z) / 3} {(-7 + Z) % 3} {(-1 + Z) / 2} {(-1 + Z) % 2} {(-9 + Z) / 8} {(-9 + Z) % 8} {(-9 + Z) / 1000000007}");
    let um: u64 = 18446744073709551615 + Z as u64;
    println(f"{um / 7} {um % 7} {um / 3} {um / 10} {um % 10} {um / 9223372036854775808} {um / 18446744073709551615}");
    let i32m: i32 = -2147483648 + Z as i32;
    let i32x: i32 = 2147483647 + Z as i32;
    println(f"{i32m / 3} {i32m % 3} {i32x / 7} {i32x % 7} {i32m / -1} {i32m / 7}");
    let u32x: u32 = 4294967295 + Z as u32;
    println(f"{u32x / 7} {u32x % 7} {u32x / 3}");
    let i8m: i8 = -128 + Z as i8;
    let u8x: u8 = 255 + Z as u8;
    let i16m: i16 = -32768 + Z as i16;
    println(f"{i8m / 3} {i8m % 3} {i8m / 7} {u8x / 7} {u8x % 7} {i16m / 3} {i16m % 10}");
    0
}
