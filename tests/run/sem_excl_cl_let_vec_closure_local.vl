// the closure bound to a local first, then passed with v
// ERROR: own.conflict
fn f<F: FnMut()>(p: Vec<i64>, w: F) -> i64 { let s = p.as_slice(); w(); s[0] }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa); v.push(1); let g = || { for i in 0..1000 { v.push(i); } };
    let r = f(v, g); println(f"{r}");
}
