// (0.25) a scoped thread changes what a view it copied views: an inout
// method of a shared view made before the scope (two threads sorting one
// `v.as_slice()` raced; `fill(s)` and `s[0] = 1` are own.readonly)
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 's'
use std::thread;

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..1000 { v.push(1000 - i); }
    let s = v.as_slice();
    thread::scope(|sc| {
        sc.spawn(|| { s.sort(); 0 });
        sc.spawn(|| s[0]);
        0
    });
}
