// 0.17: `v.len` on a Vec reads as `v.len()`, but it is no place: writing
// it, or taking its address, is the sealed field's error, and a compound
// assignment to it is no assignment target.
// ERROR: 'Vec' is sealed: its field 'len' is private to module 'std'
// ERROR: help: use the methods of 'Vec'
// ERROR: 'Vec' is sealed: its field 'len' is private to module 'std'
// ERROR: invalid assignment target
// ERROR-COUNT: 3
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.len = 0;
    let p = v.len;
    v.len += 1;
}
