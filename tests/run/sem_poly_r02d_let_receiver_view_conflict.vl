// the let-receiver bug with a view held: s.grow() on a let s while h views s.v
// ERROR: [own.readonly]
struct S { v: Vec<i64> }
impl S { fn grow(inout self) { for i in 0..1000 { self.v.push(i); } } }

fn main(gpa: Gpa) {
    let s0 = S { v: Vec::new_in(gpa) };
    let s = s0;
    let h = s.v.as_slice();
    s.grow();
    println(f"{s.v.len()}");
}
