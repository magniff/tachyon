// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a HashMap iterator kept across inserts
// XFAIL: SOUNDNESS HashMap iterators hold no loan on the map: insert or remove while iterating
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var m: HashMap<i64, i64> = HashMap::new_in(gpa);
    m.insert(1, 1);
    var it = m.iter();
    for i in 0..100 { m.insert(i, i); }
    println(it.next().unwrap().0);
    0
}
