// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `vv.get(0).get(0)`; s grows while it is used
// XFAIL: SOUNDNESS an element read through two levels of containers loses its origin: use after free
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var v: Vec<str> = Vec::new_in(gpa); v.push(w); var vv: Vec<Vec<str>> = Vec::new_in(gpa);
    vv.push(v);
    let r = vv.get(0).get(0);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
