// Indexing a fixed array is checked like indexing a slice (0.7): out of
// its bounds writes a message to stderr and exits with 101, at every
// optimization level. Writes too, through a struct field, with a negative
// index, and in a loop the optimizer cannot prove safe.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct Vm { stack: [i64; 4], sp: i64 }

#[inline(never)]
fn get(a: &[i32; 3], i: i64) -> i32 {
    (*a)[i]
}

#[inline(never)]
fn push(vm: &mut Vm, v: i64) {
    vm.stack[vm.sp] = v;
    vm.sp += 1;
}

fn main() {
    let a: [i32; 3] = [10, 20, 30];
    unsafe { printf(c"%d\n", get(&a, 2)); }
    let mut vm = Vm { stack: [0; 4], sp: 0 };
    let mut sum = 0;
    for i in 0..4 {
        push(&mut vm, i * 10);
        sum += vm.stack[i];
    }
    unsafe { printf(c"%lld\n", sum); }
    let k: i8 = -1;
    if get(&a, 0) == 10 {
        unsafe { printf(c"%lld\n", vm.stack[(k + 1) as i64]); }
    }
    push(&mut vm, 99);
    unsafe { printf(c"not reached\n"); }
}

// EXPECT: 30
// EXPECT: 60
// EXPECT: 0
// EXIT: 101
// STDERR: index out of bounds: index 4, length 4
