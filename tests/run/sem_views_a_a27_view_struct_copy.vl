// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a copy of a view-struct keeps the loan
// ERROR: error[own.conflict]
struct W { s: [i64] }
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let w = W { s: v.as_slice() };
    let w2 = w;
    v.push(2);
    println(w2.s[0]);
    0
}
