// (0.25, the semantics fuzzer) A by-value match on an owned enum that
// moves some of the payload out leaks the rest: the parts bound by `_`
// or `..`, and the whole value when it takes a wildcard arm of a match
// with a binding arm elsewhere. Every Tracked value must be dropped once.
// EXPECT: a1
// EXPECT: d1
// EXPECT: d2
// EXPECT: a3
// EXPECT: d3
// EXPECT: d4
// EXPECT: a5
// EXPECT: d5
// EXPECT: d6
// EXPECT: wild
// EXPECT: d7
// EXPECT: d8
// EXPECT: live 0

static var NEXT: i64 = 0;
static var LIVE: i64 = 0;
struct T { id: i64 }
fn mk() -> T { NEXT += 1; LIVE += 1; T { id: NEXT } }

impl Drop for T {
    fn drop(inout self) { LIVE -= 1; println(f"d{self.id}"); }
}

enum E { One(T), Two { a: T, b: T } }
enum F { P(T, T), Q }

fn run() {
    { let e = E::Two { a: mk(), b: mk() };
        match e { E::Two { a, b: _ } => println(f"a{a.id}"), _ => {} } }
    { let e = E::Two { a: mk(), b: mk() };
        match e { E::Two { a, .. } => println(f"a{a.id}"), _ => {} } }
    { let e = F::P(mk(), mk()); match e { F::P(a, _) => println(f"a{a.id}"), _ => {} } }
    { let e = E::Two { a: mk(), b: mk() };
        match e { E::One(t) => println(f"t{t.id}"), _ => println("wild") } }
}

fn main() -> i32 {
    run();
    println(f"live {LIVE}");
    0
}
