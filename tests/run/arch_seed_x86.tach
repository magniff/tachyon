// CROSS: x86_64-linux
// EXPECT: 3 15 -1
// EXPECT: 7 7
// (0.19 Phase 0) std::arch's x86-64 seed intrinsics: compiled for
// x86_64-linux (CROSS: assembly and object, nothing run: x86-64 is not
// executed), each one instruction (the ASM lines; the byte splat is
// SSE2's four). On AArch64 the has and detect branches are dead and the
// portable fallbacks print the same.
// CHECK-OPT: 2
// ASM(x86_64-linux): pcmpeqb %xmm
// ASM(x86_64-linux): pmovmskb %xmm
// ASM(x86_64-linux): pshufb %xmm
// ASM(x86_64-linux): crc32q %
use std::arch::{detect, has};
use std::arch::x86_64::{
    __m128i, _mm_cmpeq_epi8, _mm_crc32_u64, _mm_loadu_si128, _mm_movemask_epi8, _mm_set1_epi8,
    _mm_shuffle_epi8, _mm_storeu_si128,
};

fn first(m: i32) -> i64 {
    if m == 0 {
        return -1;
    }
    var n = 0;
    var x = m;
    while (x & 1) == 0 {
        x = x >> 1;
        n += 1;
    }
    n
}

// The first i with s[i] == b among s[0..16], or -1.
fn find16(s: [u8], b: u8) -> i64 {
    if has("sse2") {
        let v: __m128i = _mm_loadu_si128(s, 0);
        return first(_mm_movemask_epi8(_mm_cmpeq_epi8(v, _mm_set1_epi8(b as i8))));
    }
    for i in 0..16 {
        if s[i] == b {
            return i;
        }
    }
    -1
}

// Byte 2 of s's first 16, everywhere: pshufb by a splat index.
fn byte2(s: [u8]) -> u8 {
    if detect("ssse3") {
        var out: [u8; 16] = [0; 16];
        _mm_storeu_si128(&out[..], 0,
            _mm_shuffle_epi8(_mm_loadu_si128(s, 0), _mm_set1_epi8(2)));
        return out[5];
    }
    s[2]
}

// A CRC-32C step's result above its 32 bits (0), or 0 without sse4.2:
// only compiled (the CROSS assembly has crc32q).
fn crc_bit(x: u64) -> u64 {
    if detect("sse4.2") {
        return _mm_crc32_u64(0xffffffff, x) >> 40;
    }
    0
}

fn main() {
    var buf: [u8; 16] = [0; 16];
    for i in 0..16 {
        buf[i] = (i * 3 + 1) as u8;
    }
    let s = buf[..];
    println(f"{find16(s, 10)} {find16(s, 46)} {find16(s, 2)}");
    println(f"{byte2(s)} {byte2(s) as u64 + crc_bit(5)}");
}
