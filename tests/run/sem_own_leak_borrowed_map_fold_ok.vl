// sem-own: map and fold over m.values() (borrowed items): no element dropped in a closure.
// EXPECT: s 3
// EXPECT: end
// EXPECT: drop 2
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
use std::HashMap;

fn main(gpa: Gpa) {
    var m: HashMap<i64, D> = HashMap::new_in(gpa);
    m.insert(1, mk(1, gpa));
    m.insert(2, mk(2, gpa));
    let s = m.values().fold(0, |a, d| a + d.id);
    println(f"s {s}");
    println("end");
}
