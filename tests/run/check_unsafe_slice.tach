// FLAGS: --check-unsafe
// EXIT: 101
// EXPECT: 6
// STDERR: unsafe access out of bounds: 48 bytes at offset 0 of a block of 24 bytes
// 0.10: --check-unsafe checks a slice made from a raw pointer.
extern "C" {
    fn printf(f: *u8, ...) -> i32;
    fn calloc(n: u64, size: u64) -> *u8;
    fn fflush(f: *u8) -> i32;
}

fn sum(s: [i64]) -> i64 {
    var t = 0;
    for x in s {
        t += x;
    }
    t
}

fn main() -> i32 {
    let p = unsafe { calloc(3, 8) as *i64 };
    unsafe {
        p[0] = 1;
        p[1] = 2;
        p[2] = 3;
        printf(c"%ld\n", sum(p[0..3]));
        fflush(0 as *u8);
        printf(c"%ld\n", sum(p[0..6]));
    }
    0
}
