// for i in 0..=3 over an array of 3 indexes a[3].
// EXIT: 101
// STDERR: index out of bounds: index 3, length 3
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    let a = [1, 2, 3];
    var t = 0;
    for i in 0..=3 { t += a[i]; }
    println(t);
    println("not reached");
    0
}
