// `&p.x`, `&t.1`, `&arr[i]` and `&p.inner.f` point into the original value.
// EXPECT: 5 6 80 20 9
extern fn printf(format: *u8, ...) -> i32;

struct I { f: i32 }
struct P { x: i64, inner: I }

fn main() -> i64 {
    let p = P { x: 1, inner: I { f: 2 } };
    let px = &p.x;
    *px = 5;
    let pf = &p.inner.f;
    *pf = 6;
    let t = (7, 8);
    let t1 = &t.1;
    *t1 = 80;
    let arr: [i64; 3] = [1, 2, 3];
    let a1 = &arr[1];
    *a1 = 20;
    let ps: [P; 2] = [P { x: 0, inner: I { f: 0 } }, P { x: 0, inner: I { f: 0 } }];
    let deep = &ps[1].inner.f;
    *deep = 9;
    printf("%ld %d %ld %ld %d\n".0, p.x, p.inner.f, t.1, arr[1], ps[1].inner.f);
    0
}
