// an argument that changes the value already lent inout to an earlier argument
// ERROR: own.conflict
fn grow(v: inout Vec<i64>) -> i64 { for i in 0..100 { v.push(i); } 0 }
fn put(a: inout i64, b: i64) { a = b; }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa); v.push(3); put(&v[0], grow(&v)); println(f"{v[0]}");
}
