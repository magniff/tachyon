use std::arch::aarch64::{uint8x16_t, vaddq_u8, vextq_u8, vld1q_u8, vst1q_u8};
use std::arch::x86_64::__m128i;

fn opaque(m: __m128i) -> u8 {
    let x = m.lane(0);
    let y = __m128i::splat(1);
    let z = -m;
    v16u8::from_bits(m).lane(0)
}

fn memory(s: [u8], p: *u8) -> u8 {
    let v = vld1q_u8(s, 0);
    let y = vld1q_u8(s[4]);
    vst1q_u8(s[0], v);
    let x = vld1q_u8(p);
    let w = vld1q_u8(s);
    let q = vextq_u8(v, v, 16);
    let r = uint8x16_t::shuffle(v);
    0
}

fn main() {
    let s: [u8; 16] = [0; 16];
    println(f"{memory(s[..], &s[0])}");
}

fn assign(m: __m128i) {
    var x = m;
    x += m;
}

fn convert(a: v16i8) -> uint8x16_t {
    vaddq_u8(a, uint8x16_t::splat(1))
}
