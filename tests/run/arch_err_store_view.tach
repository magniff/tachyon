// ERROR: error[own.conflict]: 'out[..]' borrows mutably 'out' while 'view'
// ERROR-COUNT: 1
// (0.19.1) A store intrinsic's `&mut [T]` slice is an exclusive loan the
// own pass sees: storing into a buffer while a view of it is still used
// is a conflict, as any write through `&mut out[..]` is.
use std::arch::aarch64::{vdupq_n_u8, vst1q_u8};

fn main() {
    var out: [u8; 16] = [0; 16];
    let view = out[..];
    vst1q_u8(&out[..], 0, vdupq_n_u8(7));
    println(f"{view[0]}");
}
