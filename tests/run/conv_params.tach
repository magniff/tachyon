// 0.20 Phase 0: parameter conventions in a mixed file (docs/design/
// conventions.md): `x: inout T`, `x: sink T`, `x: let T`, receivers `self`,
// `inout self`, `sink self`, `&x` as the inout marker, `var`, `inout r =
// &x;`, `static var`, `sink ||`, `var` in patterns, `fn(inout T)`. Until T1
// an access is a reference (not yet transparent: `r.push(9)` reaches
// through it as a reference does). A mixed file since 0.20 made the new
// spelling the default (Phase M).
// FLAGS: --syntax=mixed
// EXPECT: 16 16 7
// EXPECT: 2
// EXPECT: 3
// EXPECT: 6
// EXPECT: 1 2 6
struct Counter { n: i64, log: Vec<i64> }

impl Counter {
    fn get(self) -> i64 { self.n }
    fn bump(inout self) { self.n += 1; self.log.push(self.n); }
    fn finish(sink self) -> i64 { self.log.push(0); self.log.len() }
}

static var HITS: i64 = 0;

fn fill(v: inout Vec<i64>, n: i64) { for i in 0..n { v.push(i); } }
fn keep(store: inout Vec<Buf>, b: sink Buf) { store.push(b); }
fn total(v: let Vec<i64>) -> i64 { var s = 0; for x in v { s += x; } s }
fn count(n: sink i64) -> i64 { n += 1; n }
fn apply(f: fn(inout Vec<i64>, i64), v: inout Vec<i64>) { f(&v, 2); }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    fill(&v, 4);
    inout r = &v;
    r.push(9);
    apply(fill, &v);
    println(f"{total(&v)} {total(v)} {v.len()}");
    var c = Counter { n: 0, log: Vec::new_in(gpa) };
    c.bump();
    c.bump();
    println(c.get());
    println(c.finish());
    var store: Vec<Buf> = Vec::new_in(gpa);
    keep(&store, Buf::new_in(gpa));
    var (a, b) = (1, 2);
    a += b;
    b += 1;
    match Some(3) { Some(var n) => { n += a; println(n); } None => {} }
    let g = sink || count(5);
    unsafe { HITS += g(); }
    println(f"{store.len()} {count(1)} {unsafe { HITS }}");
    0
}
