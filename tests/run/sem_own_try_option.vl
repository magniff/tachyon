// sem-own: `?` on an Option of an owned value inside a loop: the locals of the loop body and the function dropped.
// EXPECT: drop 0
// EXPECT: drop 10
// EXPECT: drop 1
// EXPECT: drop 11
// EXPECT: drop 12
// EXPECT: drop 100
// EXPECT: r -1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn g(i: i64, gpa: Gpa) -> Option<D> { if i < 2 { Some(mk(i, gpa)) } else { None } }

fn f(gpa: Gpa) -> Option<i64> {
    let a = mk(100, gpa);
    for i in 0..5 {
        let b = mk(10 + i, gpa);
        let d = g(i, gpa)?;
    }
    Some(0)
}

fn main(gpa: Gpa) {
    println(f"r {f(gpa).unwrap_or(-1)}");
}
