// `while`, `else if`, and labeled `break`/`continue`.
// EXPECT: 10 37
// EXPECT: 6 7
// EXPECT: 10
// EXPECT: -1 0 1 2
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn classify(n: i64) -> i64 {
    if n < 0 { -1 } else if n == 0 { 0 } else if n < 10 { 1 } else { 2 }
}

fn main() -> i64 {
    let mut i = 0;
    let mut sum = 0;
    while i < 10 {
        i += 1;
        if i % 3 == 0 { continue; }
        sum += i;
    }
    unsafe { printf(c"%ld %ld\n", i, sum); }

    // the first pair a < b with a * b == 42 and a + b == 13
    let mut found_a = 0;
    let mut found_b = 0;
    let mut a = 1;
    search: while a < 20 {
        let mut b = a + 1;
        while b < 20 {
            if a * b == 42 && a + b == 13 {
                found_a = a;
                found_b = b;
                break :search;
            }
            b += 1;
        }
        a += 1;
    }
    unsafe { printf(c"%ld %ld\n", found_a, found_b); }

    // `continue :outer` skips the rest of the outer body
    let mut count = 0;
    let mut x = 0;
    outer: while x < 5 {
        x += 1;
        let mut y = 0;
        while y < 5 {
            y += 1;
            if y == 3 { continue :outer; }
            count += 1;
        }
        count += 100;
    }
    unsafe {
        printf(c"%ld\n", count);
        printf(c"%ld %ld %ld %ld\n", classify(-5), classify(0), classify(7), classify(70));
    }
    0
}
