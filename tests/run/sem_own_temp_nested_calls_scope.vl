// sem-own: owned temporaries given to let parameters are dropped at the end
// of their statement (value-semantics.md §2.2), not at the end of the block.
// (0.25: at the end of the `let`, before the next statement)
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: 3
// EXPECT: in
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn add(a: D, b: D) -> i64 { a.id + b.id }

fn main(gpa: Gpa) {
    {
        let n = add(mk(1, gpa), mk(2, gpa));
        println(f"{n}");
        println("in");
    }
    println("end");
}
