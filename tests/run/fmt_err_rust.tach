// Rust's formatting (0.15): each macro's help is the f-string call that
// replaces it, written out; `fmt(&self, f: &mut Formatter)` gets
// tachyon's Display and Debug signatures.
// ERROR: 'println!' is a macro call: tachyon has no macros
// ERROR: help: write `println(f"{a} = {a * 2:>4}, {v:?} {name}")`
// ERROR: 'format!' is a macro call
// ERROR: help: write `format(f"{a}-{b::c}{{}}")`
// ERROR: 'eprint!' is a macro call
// ERROR: help: write `eprint(f"{v:?}{a}")`
// ERROR: expected identifier, got '&'
// ERROR: help: Display and Debug in tachyon: `fn fmt(self: &Self, f: &mut std::Fmt)`
// ERROR: 'writeln!' is a macro call
// ERROR: help: write `f.write(f"P({p.x}, {if a { 1 } else { 2 }})\n")`
// ERROR: 'print!' is a macro call
// ERROR: help: an f-string: `println(f"x = {x}, v = {v:?}")`
// ERROR-COUNT: 6
struct P { x: i64 }

fn main() {
    let a = 1;
    let v = 2;
    println !("{} = {:>4}, {:#?} {name}", a, a * 2, v);
    let s = format !("{}-{}{{}}", a, b::c);
    eprint !("{1:?}{0}", a, v);
}

impl std::Display for P {
    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
        write !(f, "P({})", self.x)
    }
}

fn show(f: *std::Fmt, p: P, a: bool) {
    writeln !(f, "P({}, {})", p.x, if a { 1 } else { 2 });
}

fn other() {
    print !(some_text);
}
