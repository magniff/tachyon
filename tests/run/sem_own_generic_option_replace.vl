// sem-own: std::replace through a generic: the old value handed back, dropped once.
// EXPECT: old 1
// EXPECT: drop 1
// EXPECT: end
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn put<T>(slot: inout T, x: sink T) -> T { std::replace(&slot, x) }

fn main(gpa: Gpa) {
    var a = mk(1, gpa);
    { let o = put(&a, mk(2, gpa)); println(f"old {o.id}"); }
    println("end");
}
