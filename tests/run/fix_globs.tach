// FIXIMPORTS: `*` imports become the names used through them (0.8)
// FIXED: use shapes::{Shape, area};
// FIXED: use util::twice;
// FIXED: use outer::{DEPTH, deep};
// FIXED:     pub use inner::{DEPTH, deep};
// FIXED: use Color::{Blue, Red};
// EXPECT: area 12
// EXPECT: twice 14
// EXPECT: deep 7 2
// EXPECT: colors 0 2 5
// Code written for 0.7: each `*` is replaced by the names the program
// finds through it; a `*` nothing comes through is removed (`nothing`);
// a name the module declares itself (`Green`) is not imported.
mod shapes {
    pub struct Shape { w: i64, h: i64 }
    pub fn area(s: Shape) -> i64 { s.w * s.h }
    pub fn unused() -> i64 { 0 }
}

mod util {
    pub fn twice(x: i64) -> i64 { x * 2 }
}

mod nothing {
    pub fn never() {}
}

mod outer {
    pub use inner::*;

    pub mod inner {
        pub const DEPTH: i64 = 2;
        pub fn deep() -> i64 { 7 }
        pub fn other() {}
    }
}

use shapes::*;
use util::*;
use nothing::*;
use outer::*;

enum Color { Red, Green, Blue }
use Color::*;
const Green: i64 = 5;

fn code(c: Color) -> i64 {
    match c {
        Red => 0,
        Color::Green => 1,
        Blue => 2,
    }
}

fn main() -> i32 {
    std::print("area ");
    std::print_int(area(Shape { w: 3, h: 4 }));
    std::println("");
    std::print("twice ");
    std::print_int(twice(7));
    std::println("");
    std::print("deep ");
    std::print_int(deep());
    std::print(" ");
    std::print_int(DEPTH);
    std::println("");
    std::print("colors ");
    std::print_int(code(Red));
    std::print(" ");
    std::print_int(code(Blue));
    std::print(" ");
    std::print_int(Green);
    std::println("");
    0
}
