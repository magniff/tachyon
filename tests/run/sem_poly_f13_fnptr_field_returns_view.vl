// a fn pointer in a struct field whose result views its argument
// ERROR: [own.conflict]: 'v.push(i)' may change 'v' while 's'
struct Ops { get: fn(Vec<i64>) -> [i64] }
fn sl(d: Vec<i64>) -> [i64] { d.as_slice() }

fn main(gpa: Gpa) {
    let o = Ops { get: sl };
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let s = (o.get)(v);
    for i in 0..1000 { v.push(i); }
    println(f"{s[0]}");
}
