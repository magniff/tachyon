// a generic with a let T calling an inout-self method
// ERROR: [own.readonly]
// XFAIL: WRONG an inout-self method on a let T parameter is accepted where T is plain (rejected for owned T)
trait B { fn bump(inout self); }
impl B for i64 { fn bump(inout self) { self += 1; } }
fn use_it<T: B>(x: T) { x.bump(); }

fn main() {
    let n = 1;
    use_it(n);
    println(f"{n}");
}
