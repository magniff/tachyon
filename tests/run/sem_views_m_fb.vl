fn f(m: HashMap<str, i64>) -> str { var r: str = ""; for (k, _) in m.iter() { r = k; } r }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    var m: HashMap<str, i64> = HashMap::new_in(gpa); m.insert(s.as_str(), 1); let r = f(m);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
