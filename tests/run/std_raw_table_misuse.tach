// (0.20) RawTable checks the buckets it is given: erasing one that holds
// no element stops the program.
// EXIT: 101
// EXPECT: 1
// STDERR: RawTable: the bucket is not full
use std::collections::RawTable;
use std::hash::FixedState;

fn main(gpa: Gpa) -> i32 {
    let fs = FixedState::new();
    let mut t: RawTable<u64> = RawTable::new_in(gpa);
    let i = t.insert(fs.hash_u64(7), 7, |e: &u64| fs.hash_u64(*e));
    println(f"{t.len()}");
    t.erase(i);
    t.erase(i);
    0
}
