// FLAGS: --check-alloc
// EXPECT: live 4 false
// EXPECT: live 0 true
// STDERR: check-alloc: 4 blocks of Gpa not freed (168 bytes):
// STDERR: block #1 (32 bytes), allocated at
// STDERR: checkalloc_leaks.tach:17:5
// STDERR: block #4 (8 bytes), allocated at
// STDERR: checkalloc_leaks.tach:19:5
// STDERR: check-alloc: 1 block of Gpa not freed (8 bytes):
// STDERR: block #5 (8 bytes), allocated at
// STDERR: checkalloc_leaks.tach:26:5
// 0.16: --check-alloc: Gpa knows its live blocks: live_blocks(),
// check_leaks() (which lists them), and the list at exit (the exit status
// is unchanged).
fn main(gpa: Gpa) {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let mut m: std::HashMap<i64, i64> = std::HashMap::new_in(gpa);
    m.insert(1, 2);
    let clean = gpa.check_leaks();
    println(f"live {gpa.live_blocks()} {clean}");
    v.free();
    m.free();
    println(f"live {gpa.live_blocks()} {gpa.check_leaks()}");
    let mut b = std::Buf::new_in(gpa);
    b.push_str("leaked");
}
