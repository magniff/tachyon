// (0.25) `&v[0]` lent inout next to v as the receiver of the same call,
// let or inout self: own.conflict (-O2 assumed them apart).
trait Peek {
    fn peek_with(self, a: inout i64) -> i64;
}

impl Peek for Vec<i64> {
    fn peek_with(self, a: inout i64) -> i64 {
        let b = self[0];
        a = 5;
        b * 100 + self[0]
    }
}

trait Grow {
    fn grow_with(inout self, a: inout i64);
}

impl Grow for Vec<i64> {
    fn grow_with(inout self, a: inout i64) {
        self.push(a);
        a = 1;
    }
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    println(f"{v.peek_with(&v[0])}");
    v.grow_with(&v[0]);
}
// ERROR: 'v' is lent inout to '&v[0]' and read by 'v' in the same call
// ERROR: the receiver 'v' of 'v.grow_with(&v[0])' is changed by its own argument
