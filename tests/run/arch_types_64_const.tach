// EXPECT: 8 7 17
// (0.19 T4) A 64-bit vector of constant lanes (a load of a constant 8-byte
// array, folded) is materialized in a vector register, not a general one.
fn main() {
    let idx: [u8; 8] = [8, 7, 6, 5, 16, 200, 255, 17];
    let mut out: [u8; 8] = [0; 8];
    let v = v8u8::load(idx[..], 0);
    let w = v + v8u8::load(out[..], 0);
    w.store(out[..], 0);
    println(f"{out[0]} {out[1]} {out[7]}");
}
