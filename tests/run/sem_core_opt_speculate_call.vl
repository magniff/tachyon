// (0.25) LICM runs a call where the loop would not have only when it is
// bounded: no loop, a few instructions (`volec --print-attrs`:
// `bounded(N)`). `slow` returns (willreturn) but after 2^62 iterations:
// under a condition that never holds it must not run, in a `for`, a
// `while` or an inner loop. `sq` and libm's `sin` are bounded, and may.
// FLAGS: -O2
// EXPECT: 3 3 9 3 0
extern "C" { fn sin(x: f64) -> f64; }
static var Z: i64 = 0;

#[inline(never)]
fn slow(n: i64) -> i64 {
    var t = 0;
    for i in 0..n { t = t * 31 + i; }
    t
}

#[inline(never)]
fn sq(n: i64) -> i64 { n * n + 3 }

#[inline(never)]
fn wave(x: f64) -> f64 { unsafe { sin(x) * 2.0 } }

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let big = 4611686018427387904 + Z;
    var a = 0;
    for k in 0..3 + Z {
        if k == 5 { a += slow(big); }
        a += k;
    }
    var b = 0;
    var k = 0;
    while k < 3 + Z {
        if k > 7 { b += slow(big) + 1; }
        b += k;
        k += 1;
    }
    var c = 0;
    for j in 0..3 + Z {
        for i in 0..2 + Z { if i + j > 9 { c += slow(big); } c += i + j; }
    }
    var d = 0;
    var f = 0.0;
    for i in 0..3 + Z {
        if i == 5 { d += sq(Z + 7); f += wave(2.0 + Z as f64); }
        d += i;
    }
    println(f"{a} {b} {c} {d} {f}");
    0
}
