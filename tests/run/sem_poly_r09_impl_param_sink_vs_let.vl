// an impl whose parameter is sink where the trait says let: generic callers think they still own it
// ERROR: [type error]: 'keep' does not have the signature trait 'K' declares: expec
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
trait K { fn keep(self, r: R) -> i64; }
struct P { x: i64 }
impl K for P { fn keep(self, r: sink R) -> i64 { r.id } }
fn go<T: K>(t: T) -> i64 { let r = R { id: 7 }; let a = t.keep(r); a + r.id }
fn main() { println(f"{go(P { x: 1 })}"); }
