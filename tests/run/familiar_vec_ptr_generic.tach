// 0.17 (decided 2026-10-16): `p[i]` means what p's type, as written, says.
// Where p points to a type parameter (`p: *T`, a field `*T`, `x as *T`,
// a local from one), it is pointer arithmetic in every instance, T = Vec
// as T = i64: a generic body means one thing for every T. A pointer
// written to a Vec (`*Vec<T>`) indexes the Vec.
// EXPECT: 3 8
// EXPECT: 3 8
// EXPECT: 3 8
// EXPECT: 3 8
// EXPECT: 3 8
// EXPECT: 1 7
struct Arr<T> { p: *T }

fn second<T>(p: *T) -> T { unsafe { p[1] } }

fn second_mut<T>(p: sink *T) -> T { unsafe { p[1] } }

fn second_field<T>(a: sink Arr<T>) -> T { unsafe { a.p[1] } }

fn second_local<T>(q: *T) -> T {
    let r = q;
    unsafe { r[1] }
}

fn second_cast<T>(x: *u8) -> T { unsafe { (x as *T)[1] } }

fn head<T>(v: Vec<T>) -> T { v[0] }

fn main(gpa: Gpa) -> i32 {
    var a: Vec<i64> = Vec::new_in(gpa);
    var b: Vec<i64> = Vec::new_in(gpa);
    a.push(1);
    b.push(2);
    b.push(4);
    b.push(6);
    let vs = [a, b];
    let xs = [7, 8, 9];
    println(f"{second(&vs[0]).len()} {second(&xs[0])}");
    println(f"{second_mut(&vs[0]).len()} {second_mut(&xs[0])}");
    println(f"{second_field(Arr { p: &vs[0] }).len()} {second_field(Arr { p: &xs[0] })}");
    println(f"{second_local(&vs[0]).len()} {unsafe { second_cast::<i64>(&xs[0] as *u8) }}");
    println(f"{unsafe { second_cast::<Vec<i64>>(&vs[0] as *u8) }.len()} {second_local(&xs[0])}");
    var c: Vec<i64> = Vec::new_in(gpa);
    c.push(7);
    println(f"{head(vs[0])} {head(c)}");
    0
}
