// (0.21) std::sync::Mutex under contention: four threads add to the data
// with `with` and through a guard; the totals are exact. try_with on a
// held lock gives None.
// EXPECT: 40000 40000
// EXPECT: busy true

use std::thread;
use std::sync::Mutex;

fn main(gpa: Gpa) {
    let m: Mutex<Vec<i64>> = Mutex::new(Vec::new_in(gpa));
    let c = Mutex::new(0);
    let mp = &m as *Mutex<Vec<i64>>;
    let cp = &c as *Mutex<i64>;
    let mut hs: Vec<thread::JoinHandle<i64>> = Vec::new_in(gpa);
    for k in 0..4 {
        hs.push(unsafe { thread::spawn(move || {
            for i in 0..10000 {
                (*mp).with(|v| v.push(i));
                let mut g = (*cp).lock();
                g.with(|n| *n += 1);
            }
            k
        }) });
    }
    while hs.len() > 0 { hs.pop().unwrap().join(); }
    let len = m.with(|v| v.len());
    println(f"{len} {c.with(|n| *n)}");
    let busy = unsafe {
        let g = c.lock();
        let r = c.try_with(|n| *n).is_none();
        drop(g);
        r && c.try_with(|n| *n).is_some()
    };
    println(f"busy {busy}");
}
