// the projection keeps s exclusively borrowed while r is used
// ERROR: own.conflict
struct S { a: i64, b: i64 }
fn pick(s: inout S, first: bool) -> inout i64 { if first { &s.a } else { &s.b } }
fn main() { var s = S { a: 1, b: 2 }; inout r = pick(&s, true); let t = s.b; r += 10; println(f"{s.a} {t}"); }
