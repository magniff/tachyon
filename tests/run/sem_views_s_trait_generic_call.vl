// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `call(b)`; s grows while it is used
// ERROR: error[own.conflict]
trait G { fn g(self) -> str; }
struct B { names: Vec<str> }
impl G for B { fn g(self) -> str { self.names[0] } }
fn call<X: G>(x: X) -> str { x.g() }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var n: Vec<str> = Vec::new_in(gpa); n.push(w); let b = B { names: n };
    let r = call(b);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
