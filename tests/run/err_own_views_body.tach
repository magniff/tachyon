// 0.17 (value semantics, T3): a #[views] declaration is checked against
// the body (own.views); its help gives the declaration the body makes.
// FLAGS: --values=error
// ERROR: 'Lexer::word' is #[views(*self)] but returns a view of 'self': 'self.src.as_slice()[a..b]'
// ERROR: 'keep' is #[stores()] but 'names' may hold a view of 'word' when it returns
struct Lexer { src: Buf, pos: i64 }

impl Lexer {
    #[views(*self)]
    fn word(self: &mut Lexer) -> [u8] {
        let a = self.pos;
        let b = a + 1;
        self.pos = b;
        self.src.as_slice()[a..b]
    }
}

#[views()]
#[stores()]
fn keep(names: &mut Vec<[u8]>, word: [u8]) {
    names.push(word);
}

fn main(gpa: Gpa) {
    let mut lx = Lexer { src: Buf::new_in(gpa), pos: 0 };
    lx.src.push_str("ab");
    println(lx.word());
    let mut names: Vec<[u8]> = Vec::new_in(gpa);
    keep(&mut names, "x");
}
