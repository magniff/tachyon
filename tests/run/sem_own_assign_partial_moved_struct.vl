// sem-own: assigning a whole struct after a field was moved out: only the unmoved field is dropped.
// EXPECT: eat 1
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: end
// EXPECT: drop 3
// EXPECT: drop 4
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
struct P { a: D, b: D }

fn main(gpa: Gpa) {
    var p = P { a: mk(1, gpa), b: mk(2, gpa) };
    eat(p.a);
    p = P { a: mk(3, gpa), b: mk(4, gpa) };
    println("end");
}
