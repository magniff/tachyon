// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.escape: v (outer) holds a view of an inner String
// ERROR: error[own.escape]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<str> = Vec::new_in(gpa);
    {
        let s = String::from_in("hello", gpa);
        v.push(s.as_str());
    }
    println(v.get(0));
    0
}
