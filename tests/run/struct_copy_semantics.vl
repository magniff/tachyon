// `let b = a` and `b = a` copy the whole struct.
// EXPECT: 1 20 10 2 1 2
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct P { x: i64, y: i64 }

fn main() -> i64 {
    var a = P { x: 1, y: 2 };
    var b = a;
    b.x = 10;
    var c = P { x: 0, y: 0 };
    c = a;
    a.y = 20;
    unsafe { printf(c"%ld %ld %ld %ld %ld %ld\n", a.x, a.y, b.x, b.y, c.x, c.y); }
    0
}
