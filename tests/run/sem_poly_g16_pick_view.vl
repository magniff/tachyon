// a generic choosing one of two views: the result views both arguments
// ERROR: [own.conflict]: 'y.push(3)' may change 'y' while 's'
fn pick<T>(a: T, b: T, first: bool) -> T { if first { a } else { b } }

fn main(gpa: Gpa) {
    var x: Vec<i64> = Vec::new_in(gpa);
    x.push(1);
    var y: Vec<i64> = Vec::new_in(gpa);
    y.push(2);
    let s = pick(x.as_slice(), y.as_slice(), false);
    y.push(3);
    println(f"{s[0]}");
}
