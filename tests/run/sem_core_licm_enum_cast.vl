// A checked cast to an enum under a never-true condition in a loop.
// FLAGS: -O2
// EXPECT: 0
static var Z: i64 = 0;
#[repr(u8)]
enum E { A = 1, B = 2 }

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var t = 0;
    var k = 0;
    let x = 7 + Z;
    while k < 5 + Z { if k > 100 { t += (x as E) as i64; } k += 1; }
    println(t);
    0
}
