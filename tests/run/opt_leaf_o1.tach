// (0.17) -O1 inlines the calls of small leaf functions (no calls, a few
// instructions; #[inline]: more), and a leaf inlined everywhere is not
// emitted; #[inline(never)] and a function that calls stay calls.
// CHECK-OPT: 1
// EXPECT: twice
// EXPECT: 3 12 25 7 6
// CHECK-NOT: fn width:
// CHECK: fn kept:
// CHECK: fn main:
// CHECK-NOT: call width
// CHECK-NOT: call area
// CHECK: call twice
// CHECK: call kept
// CHECK-NOT: fn width:
use std::println;

struct Rect { w: i64, h: i64 }

fn width(r: &Rect) -> i64 {
    r.w
}

#[inline]
fn area(r: &Rect) -> i64 {
    let a = r.w * r.h;
    if a < 0 { -a } else { a }
}

#[inline(never)]
fn kept(r: &Rect) -> i64 {
    r.w + r.h
}

fn twice(r: &Rect) -> i64 {
    println("twice");
    2 * r.w
}

fn main() {
    let r = Rect { w: 3, h: 4 };
    let s = Rect { w: 5, h: 5 };
    // (after inlining, width(&r) == 0 is known false: no call)
    if width(&r) == 0 {
        println("never");
    }
    let t = twice(&r);
    println(f"{width(&r)} {area(&r)} {area(&s)} {kept(&r)} {t}");
}
