// A receiver changed by its own `?` argument is still a conflict (0.18.1:
// `v.push(p.item()?)` is not one, own_push_try.tach); the message names
// the change and points at it.
// ERROR: the receiver 'v' of 'v.push(v.pop()?)' is changed by its own argument 'v.pop()'
// ERROR: the receiver 'v' of 'v.push(take(&v)?)' is changed by its own argument 'take(&v)'
// ERROR: the receiver 'v' of 'v.push({ v.clear(); o? })' is changed by its own argument 'v.clear()'
fn take(v: inout Vec<i64>) -> Option<i64> { v.pop() }

fn f(gpa: Gpa) -> Option<i64> {
    var v: Vec<i64> = Vec::new_in(gpa);
    let o = Some(1);
    v.push(v.pop()?);
    v.push(take(&v)?);
    v.push({ v.clear(); o? });
    Some(v.len())
}

fn main(gpa: Gpa) -> i32 { println(f(gpa).unwrap()); 0 }
