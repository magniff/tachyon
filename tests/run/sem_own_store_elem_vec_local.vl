// (0.25) A store to an element, or through inout, drops the value it replaces.
// v[0] = new on a Vec<Vec<i64>>: the replaced inner Vec must be freed
// FLAGS: --check-alloc
// EXPECT: 1
// EXPECT: live 0
fn main(gpa: Gpa) {
    {
        var v: Vec<Vec<i64>> = Vec::new_in(gpa); var e: Vec<i64> = Vec::new_in(gpa); e.push(1);
        v.push(e);
        v[0] = Vec::new_in(gpa); v[0].push(2); println(f"{v[0].len()}");
    }
    println(f"live {gpa.live_blocks()}");
}
