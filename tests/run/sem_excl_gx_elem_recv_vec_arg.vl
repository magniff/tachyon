// receiver an element, argument the whole Vec inout
// ERROR: own.conflict
struct S { n: i64 }

impl S {
    fn grow(inout self, v: inout Vec<S>) { for i in 0..100 { v.push(S { n: i }); } self.n = 7; }
}

fn main(gpa: Gpa) {
    var v: Vec<S> = Vec::new_in(gpa); v.push(S { n: 1 }); v[0].grow(&v); println(f"{v[0].n}");
}
