// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: c read while its inout projection is live
// ERROR: error[own.escape]
struct C { n: i64 }
impl C { fn cell(inout self) -> inout i64 { &self.n } }

fn main() -> i32 {
    var c = C { n: 10 };
    inout r = c.cell();
    println(c.n);
    r += 1;
    println(c.n);
    0
}
