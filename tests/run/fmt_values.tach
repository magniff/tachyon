// f-strings (0.15): holes evaluated where the f-string is written, left to
// right, once; an f-string is a value (stored, passed to any T: Display,
// printed twice); Display and Debug impls written with f.write; std's
// Debug of Option, Result, Vec, HashMap, Buf; format, push_fmt, eprintln.
// EXPECT: <a><b><c>
// EXPECT: 1 2:3 1 2:3
// EXPECT: k=1 now k=2
// EXPECT: (3, -4) Point { x: 3, y: -4 } [   (3, -4)] [(3, -4)   ] [   Point { x: 3, y: -4 }]
// EXPECT:          dot (3, -4)|
// EXPECT:  line (3, -4)-(0, 0)|
// EXPECT: (3, -4) Point { x: 3, y: -4 }
// EXPECT: Some(5) None Ok(1) Err("bad")
// EXPECT: ["x", "y\n"] [Some(1), None] {7: "seven"} buf "buf"
// EXPECT: [Point { x: 3, y: -4 }, Point { x: 1, y: 1 }] and (1, 1)    9
// EXPECT: g(10) = 12
// STDERR: to stderr: (3, -4)
// STDERR: no newline
// STDERR: 123
use std::{Buf, Fmt, HashMap, debug_list, format_in};

static var CALLS: i64 = 0;

fn next(tag: [u8]) -> i64 {
    CALLS += 1;
    print(f"<{tag}>");
    CALLS
}

struct Point { x: i64, y: i64 }

impl Display for Point {
    fn fmt(self, f: inout Fmt) {
        f.write(f"({self.x}, {self.y})");
    }
}

impl Debug for Point {
    fn fmt_debug(self, f: inout Fmt) {
        f.str("Point { x: ");
        f.debug(&self.x);
        f.str(", y: ");
        f.debug(&self.y);
        f.str(" }");
    }
}

enum Shape { Dot(Point), Line(Point, Point) }

impl Display for Shape {
    fn fmt(self, f: inout Fmt) {
        match self {
            Shape::Dot(p) => f.write(f"dot {p}"),
            Shape::Line(a, b) => f.write(f"line {a}-{b}"),
        }
    }
}

// (0.16: debug_list into a Buf, through a Display)
struct Points { s: [Point] }

impl Display for Points {
    fn fmt(self, f: inout Fmt) {
        debug_list(&f, self.s);
    }
}

impl Point {
    fn show(self, gpa: Gpa) -> Buf {
        format_in(f"{self} {self:?}", gpa)
    }
}

fn twice<T: Display>(x: sink T) {
    print(x);
    print(" ");
    println(x);
}

fn main(gpa: Gpa) {
    // left to right, once, where it is written
    let s = f"{next("a")} {next("b")}:{next("c"):?}";
    println("");
    CALLS = 100;
    twice(s);
    var k = 1;
    let saved = f"k={k}";
    k = 2;
    println(f"{saved} now k={k}");
    // impls, nested specs (the hole's text is padded as a whole)
    let p = Point { x: 3, y: -4 };
    println(f"{p} {p:?} [{p:>10}] [{p:<10}] [{p:>24?}]");
    let shapes = [Shape::Dot(p), Shape::Line(p, Point { x: 0, y: 0 })];
    for sh in shapes {
        println(f"{sh:>20}|");
    }
    var b = p.show(gpa);
    println(b.as_slice());
    b.free();
    // std's Debug
    let some: Option<i64> = Some(5);
    let none: Option<i64> = None;
    let ok: Result<i64, [u8]> = Ok(1);
    let err: Result<i64, [u8]> = Err("bad");
    println(f"{some:?} {none:?} {ok:?} {err:?}");
    var v: Vec<[u8]> = Vec::new_in(gpa);
    v.push("x");
    v.push("y\n");
    var nested: Vec<Option<i64>> = Vec::new_in(gpa);
    nested.push(Some(1));
    nested.push(None);
    var m: HashMap<i64, [u8]> = HashMap::new_in(gpa);
    m.insert(7, "seven");
    var text = Buf::new_in(gpa);
    text.push_str("buf");
    println(f"{v:?} {nested:?} {m:?} {text} {text:?}");
    let arr = [p, Point { x: 1, y: 1 }];
    var out = Buf::new_in(gpa);
    out.push_fmt(Points { s: arr[..] });
    out.push_fmt(f" and {arr[1]} {(1 + 2) * 3:>4}");
    println(out.as_slice());
    // a closure's f-string; a hole holding a closure call
    let add = |a: i64| a + k;
    let g = |x: i64| format_in(f"g({x}) = {add(x)}", gpa);
    var r = g(10);
    println(r.as_slice());
    r.free();
    // stderr
    eprintln(f"to stderr: {p}");
    eprint("no newline");
    eprintln("");
    std::eprint(f"{1}{2}");
    std::eprintln(f"{3}");
}
