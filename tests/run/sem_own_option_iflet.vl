// sem-own: if let Some(d) = o moves d out; the None branch drops nothing.
// EXPECT: got 3
// EXPECT: drop 3
// EXPECT: none
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn f(o: sink Option<D>) {
    if let Some(d) = o { println(f"got {d.id}"); } else { println("none"); }
}

fn main(gpa: Gpa) {
    f(Some(mk(3, gpa)));
    f(None);
    println("end");
}
