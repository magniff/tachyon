// sem-own: a conditionally moved local carries a drop flag: dropped at scope
// end only when not moved.
// EXPECT: eat 1
// EXPECT: drop 1
// EXPECT: end a
// EXPECT: end b
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn run(id: i64, c: bool, gpa: Gpa) {
    let d = mk(id, gpa);
    if c { eat(d); }
    println(if c { "end a" } else { "end b" });
}

fn main(gpa: Gpa) {
    run(1, true, gpa);
    run(2, false, gpa);
}
