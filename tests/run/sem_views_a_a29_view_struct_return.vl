// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: returned struct holds a view of v
// ERROR: error[own.conflict]
struct W { s: [i64] }
fn wrap(v: Vec<i64>) -> W { W { s: v.as_slice() } }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let w = wrap(v);
    v.push(2);
    println(w.s[0]);
    0
}
