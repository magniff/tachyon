// A struct literal's field shorthand (0.15): `P { x, y }` is
// `P { x: x, y: y }`.
// EXPECT: 3 4 5
use std::print_int;

struct P { x: i64, y: i64, z: i64 }

fn main() {
    let x = 3;
    let y = 4;
    let p = P { x, y, z: x + 2 };
    print_int(p.x);
    print(" ");
    print_int(p.y);
    print(" ");
    print_int(p.z);
    println("");
}
