// `loop` with `break` and `continue`.
// EXPECT: 100 2500
// EXPECT: 1000000
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let mut i = 0;
    let mut odd_sum = 0;
    loop {
        i += 1;
        if i > 99 { break; }
        if i % 2 == 0 { continue; }
        odd_sum += i;
    }
    printf(c"%ld %ld\n", i, odd_sum);
    let mut n = 0;
    loop {
        n += 1;
        if n == 1000000 { break; }
    }
    printf(c"%ld\n", n);
    0
}
