// `loop` with `break` and `continue`.
// EXPECT: 100 2500
// EXPECT: 1000000
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    var i = 0;
    var odd_sum = 0;
    loop {
        i += 1;
        if i > 99 { break; }
        if i % 2 == 0 { continue; }
        odd_sum += i;
    }
    unsafe { printf(c"%ld %ld\n", i, odd_sum); }
    var n = 0;
    loop {
        n += 1;
        if n == 1000000 { break; }
    }
    unsafe { printf(c"%ld\n", n); }
    0
}
