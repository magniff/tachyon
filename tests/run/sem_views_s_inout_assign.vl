// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `o`; s grows while it is used
// XFAIL: SOUNDNESS a view stored into an inout parameter from its let parameter's elements is lost (summary): use after free
// ERROR: error[own.conflict]
fn f(out: inout str, src: Vec<str>) { out = src[0]; }
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var v: Vec<str> = Vec::new_in(gpa); v.push(w); var o: str = ""; f(&o, v);
    let r = o;
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
