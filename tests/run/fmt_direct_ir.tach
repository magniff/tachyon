// (0.17) An f-string passed straight to println, push_fmt or format_in
// makes no function: no closure, no std::Interp instance or Display of
// one, no instance of println, push_fmt or format_in; the writes are in
// the caller (fmt_direct: what they print). At -O0, where nothing is
// inlined away.
// CHECK-OPT: 0
// EXPECT: v=42 s="hi"
// EXPECT: [v=42]
// EXPECT: 42/hi
// CHECK-NOT: Interp
// CHECK-NOT: closure
// CHECK-NOT: fn main.
// CHECK-NOT: call std.println
// CHECK-NOT: call std.Buf.push_fmt
// CHECK-NOT: call std.format_in
// CHECK: fn main:
// CHECK: call std.Fmt.to_fd
// CHECK: call std.Fmt.flush
// CHECK: call std.__buf_fmt.
// CHECK: call std.__buf_fmt_end.
// CHECK: call std.__fmt_tmp
// CHECK: call std.__fmt_in_end.
// CHECK-NOT: Interp
// CHECK-NOT: fn main.
use std::{Buf, Gpa, format_in, println};

fn main(gpa: Gpa) {
    let v = 42;
    let s: [u8] = "hi";
    println(f"v={v} s={s:?}");
    let mut b: Buf<Gpa> = Buf::new_in(gpa);
    b.push_fmt(f"[v={v}]");
    println(b.as_slice());
    let t = format_in(f"{v}/{s}", gpa);
    println(t.as_slice());
    b.free();
    t.free();
}
