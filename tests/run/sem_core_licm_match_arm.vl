// A guarded index in a match arm that never matches.
// FLAGS: -O2
// EXPECT: 5
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var t = 0;
    var k = 0;
    let a = [1, 2, 3];
    let i = -1099511627776 + Z;
    while k < 5 + Z { match k { 1000 => t += a[i], _ => t += 1 } k += 1; }
    println(t);
    0
}
