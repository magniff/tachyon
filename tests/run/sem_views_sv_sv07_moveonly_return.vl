// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a struct returned holding an inout of v, v used directly meanwhile
// ERROR: error[own.conflict]
struct P { q: inout Vec<i64> }
fn mk(v: inout Vec<i64>) -> P { P { q: &v } }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    var p = mk(&v);
    v.push(1);
    p.q.push(2);
    println(v.len());
    0
}
