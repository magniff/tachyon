// The sources' `exact_len` and `at` (0.14), and `sort_by` with named
// functions as the function argument (a function with pointer parameters
// as a value is unsafe). Their `fold`: iter_chain_fold_named.
// EXPECT: len 10 0 3 2 4 2
// EXPECT: at 5 7 30 11
// EXPECT: sorted 9 7 5 3 1 | 1 3 5 7 9 | 2 3 3 4 5 5
use std::{HashMap, sort_by};

fn desc(a: i64, b: i64) -> i64 {
    b - a
}

fn asc(a: i64, b: i64) -> i64 {
    a - b
}

fn show(x: i64) {
    print(" ");
    std::print_int(x);
}

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(5);
    v.push(1);
    v.push(9);
    v.push(3);
    v.push(7);
    var m: HashMap<i64, i64> = HashMap::new_in(gpa);
    m.insert(10, 3);
    m.insert(20, 15);

    print("len");
    show((0..10).exact_len());
    show((5..2).exact_len());
    show((3..=5).exact_len());
    var r = 3..=4;
    r.next();
    r.next();
    show(r.exact_len() + 2);
    show(v.iter().exact_len() - 1);
    show(m.iter().exact_len());
    println("");

    print("at");
    var s = v.iter();
    show(s.at(0));
    var ten = 0..10;
    show(ten.at(7));
    var big = 25..=30;
    show(big.at(5));
    var keys = m.keys();
    let k0 = keys.at(0);
    let k1 = keys.at(1);
    show((k0 + k1) / 3 + 1);
    println("");

    print("sorted");
    unsafe { v.sort_by(desc); }
    for x in v {
        show(x);
    }
    print(" |");
    unsafe { sort_by(v.as_mut_slice(), asc); }
    for x in v {
        show(x);
    }
    print(" |");
    var w = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3];
    unsafe { sort_by(&w[..], asc); }
    for x in w[2..8] {
        show(x);
    }
    println("");
    0
}
