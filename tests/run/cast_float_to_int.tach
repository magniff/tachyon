// Float to every integer type truncates toward zero (in-range values).
// EXPECT: -3 -3 -3 -3
// EXPECT: 250 250 250 250
// EXPECT: 4294967295 18446744073709549568 9223372036854775808
// EXPECT: -7 -7 3000000000 9999999980506447872
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let a: f64 = -3.99;
    let b: f64 = 250.7;
    printf(c"%d %d %d %ld\n", a as i8, a as i16, a as i32, a as i64);
    printf(c"%d %d %u %lu\n", b as u8, b as u16, b as u32, b as u64);
    let c: f64 = 4294967295.9;
    let d: f64 = 18446744073709549568.0;
    let e: f64 = 9223372036854775808.0;
    printf(c"%u %lu %lu\n", c as u32, d as u64, e as u64);
    let f: f32 = (0.0 - 7.5) as f32;
    let g: f32 = 3000000000.0;
    let h: f32 = 1e19;
    printf(c"%d %ld %u %lu\n", f as i32, f as i64, g as u32, h as u64);
    0
}
