// EXPECT: 0 1 4 9 16
// EXPECT: len 5 cap 8
// EXPECT: 3
// EXPECT: pairs 2: (1, 2) (3, 4)
// EXPECT: 10
// EXPECT: 120
// EXPECT: maybe 7
// EXPECT: nothing
// EXPECT: 6 7
// EXPECT: 1.5
// Nested generic types, a heap vector, generic methods calling each
// other, methods with type parameters of their own, recursion.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn malloc(size: u64) -> *u8;
    fn realloc(p: *u8, size: u64) -> *u8;
    fn free(p: *u8);
}

struct Vec<T> { data: *T, len: i64, cap: i64 }

impl<T> Vec<T> {
    fn new() -> Vec<T> {
        Vec { data: 0 as *T, len: 0, cap: 0 }
    }

    fn push(inout self, x: sink T) {
        if self.len == self.cap {
            self.grow();
        }
        unsafe { self.data[self.len] = x; }
        self.len += 1;
    }

    fn grow(inout self) {
        let cap = if self.cap == 0 { 4 } else { self.cap * 2 };
        unsafe { self.data = realloc(self.data as *u8, (cap * size_of(T)) as u64) as *T; }
        self.cap = cap;
    }

    fn get(self, i: i64) -> T {
        unsafe { self.data[i] }
    }

    fn as_slice(self) -> [T] {
        unsafe { self.data[0..self.len] }
    }

    fn map<U>(inout self, f: fn(T) -> U) -> Vec<U> {
        var out: Vec<U> = Vec::new();
        for i in 0..self.len {
            out.push(f(self.get(i)));
        }
        out
    }

    fn fold<A>(self, init: sink A, f: fn(A, T) -> A) -> A {
        var acc = init;
        for x in self.as_slice() {
            acc = f(acc, x);
        }
        acc
    }

    fn free(inout self) {
        unsafe { free(self.data as *u8); }
        self.len = 0;
        self.cap = 0;
    }
}

struct Pair<A, B> { a: A, b: B }

enum Maybe<T> { Nothing, Just(T) }

fn square(x: i64) -> i64 {
    x * x
}

fn add(a: i64, b: i64) -> i64 {
    a + b
}

fn half(x: i64) -> f64 {
    x as f64 / 2.0
}

fn count_just<T>(xs: Vec<Maybe<T>>) -> i64 {
    var n = 0;
    for i in 0..xs.len {
        match xs.get(i) {
            Maybe::Just(_) => n += 1,
            Maybe::Nothing => {}
        }
    }
    n
}

fn factorial<T>(n: sink T, one: sink T) -> T {
    if n == one { one } else { n * factorial(n - one, one) }
}

fn show(m: Maybe<Pair<i64, u8>>) {
    match m {
        Maybe::Just(p) => unsafe { printf(c"maybe %ld\n", p.a + p.b as i64) },
        Maybe::Nothing => unsafe { printf(c"nothing\n") },
    };
}

fn main() -> i32 {
    var v: Vec<i64> = Vec::new();
    for i in 0..5 {
        v.push(i);
    }
    let sq = v.map(square);
    for x in sq.as_slice() {
        if x > 0 {
            unsafe { printf(c" "); }
        }
        unsafe { printf(c"%ld", x); }
    }
    unsafe {
        printf(c"\n");
        printf(c"len %ld cap %ld\n", sq.len, sq.cap);
    }
    var ms = Vec::<Maybe<i32>>::new();
    ms.push(Maybe::Just(1));
    ms.push(Maybe::Nothing);
    ms.push(Maybe::Just(3));
    ms.push(Maybe::Just(4));
    unsafe { printf(c"%ld\n", count_just(ms)); }
    var ps: Vec<Pair<i64, i64>> = Vec::new();
    ps.push(Pair { a: 1, b: 2 });
    ps.push(Pair { a: 3, b: 4 });
    unsafe { printf(c"pairs %ld:", ps.len); }
    for p in ps.as_slice() {
        unsafe { printf(c" (%ld, %ld)", p.a, p.b); }
    }
    unsafe {
        printf(c"\n");
        printf(c"%ld\n", v.fold(0, add));
        printf(c"%ld\n", factorial(5, 1));
    }
    show(Maybe::Just(Pair { a: 4, b: 3u8 }));
    show(Maybe::Nothing);
    var nested: Vec<Vec<i64>> = Vec::new();
    nested.push(v);
    nested.push(sq);
    let inner = nested.get(1);
    unsafe { printf(c"%ld %ld\n", nested.len * 3, inner.len + 2); }
    let halves = v.map(half);
    unsafe { printf(c"%.1f\n", halves.get(3) - halves.get(0)); }
    v.free();
    0
}
