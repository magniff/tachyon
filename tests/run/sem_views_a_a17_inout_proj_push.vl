// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: projection result live across a push
// ERROR: error[own.conflict]
fn mid(v: inout Vec<i64>) -> inout [i64] { &v[0..1] }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let m = mid(&v);
    for i in 0..100 { v.push(i); }
    m[0] = 5;
    println(v[0]);
    0
}
