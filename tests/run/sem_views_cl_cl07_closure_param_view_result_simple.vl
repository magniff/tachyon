// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a closure returning its trimmed parameter
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("  hello  ", gpa);
    let t = |x: str| -> str { x.trim() };
    let r = t(s.as_str());
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
