// a view of a local stored into a Mutex's data, the local dropped first
// ERROR: [own.escape]
use std::sync::Mutex;

fn main(gpa: Gpa) {
    let d: Vec<[i64]> = Vec::new_in(gpa);
    let m = Mutex::new(d);
    {
        var v: Vec<i64> = Vec::new_in(gpa);
        for i in 0..10 { v.push(i + 100); }
        let s = v.as_slice();
        m.with(|d| d.push(s));
    }
    var w: Vec<i64> = Vec::new_in(gpa);
    for i in 0..10 { w.push(i); }
    println(f"{m.with(|d| d[0][3])}");
}
