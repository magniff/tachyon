// 0.17: `v[i]` on a Vec is checked as its slice is: out of bounds, the
// program prints the failed check and exits with 101.
// EXIT: 101
// STDERR: index out of bounds: index 3, length 3
fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(3);
    let i = v.len();
    v[i] = 4;
    0
}
