// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: a DirEntry's file_name kept past the entry (the loop's item)
// ERROR: error[own.escape]
use std::fs;
use std::path::Path;

fn main(gpa: Gpa) -> i32 {
    var keep: Vec<Path> = Vec::new_in(gpa);
    for e in fs::read_dir(".").unwrap() {
        let e = e.unwrap();
        keep.push(e.file_name());
    }
    println(keep.len() > 0);
    0
}
