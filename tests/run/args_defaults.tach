// Parameter defaults (0.15): trailing parameters of functions and
// methods may have one; a call that leaves them out gets the default,
// computed per call (0.16: a default has no allocator: `None`, and the
// Vec made in the body), and widened
// like an argument; generic functions get theirs per instance; a later
// default can be given by name while an earlier one is left out.
// EXPECT: hello a|hi b|hello c|hello c|yo d|yo d|
// EXPECT: 1 1 0
// EXPECT: 30 6
// EXPECT: 2 7 7 b
// EXPECT: 5
use std::{Vec, print_int};

fn greet(name: [u8], greeting: [u8] = "hello", times: i64 = 1) {
    for _ in 0..times {
        print(greeting);
        print(" ");
        print(name);
        print("|");
    }
}

fn with(gpa: Gpa, x: i64, v: sink Option<Vec<i64>> = None) -> Vec<i64> {
    var v2 = match v {
        Some(v) => v,
        None => Vec::new_in(gpa),
    };
    v2.push(x);
    v2
}

struct Rect { w: i64, h: i64 }

impl Rect {
    fn scaled(self, by: i64 = 5) -> i64 {
        self.w * self.h * by
    }
}

fn twice<T>(x: sink T, n: i64 = 2) -> T {
    print_int(n);
    print(" ");
    x
}

fn small(n: i32 = 5) -> i64 {
    n
}

fn main(gpa: Gpa) {
    greet("a");
    greet("b", "hi");
    greet("c", times: 2);
    greet("d", greeting: "yo", times: 2);
    println("");
    let a = with(gpa, 1);
    let b = with(gpa, 2);
    var c: Vec<i64> = Vec::new_in(gpa);
    c.push(9);
    let d = with(gpa, 3, Some(c));
    print_int(a.len());
    print(" ");
    print_int(b.len());
    print(" ");
    print_int(a.get(0) - 1);
    println("");
    let r = Rect { w: 2, h: 3 };
    print_int(r.scaled());
    print(" ");
    print_int(r.scaled(by: 1));
    println("");
    print_int(twice(7));
    print(" ");
    println(twice("b", n: 7));
    print_int(small());
    println("");
}
