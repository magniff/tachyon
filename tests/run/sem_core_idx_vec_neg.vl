// A Vec index of -1 is out of bounds.
// EXIT: 101
// STDERR: index out of bounds: index -1, length 2
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1); v.push(2);
    println(v[-1 + Z]);
    println("not reached");
    0
}
