// sem-own: a body local moved, then `continue`: not dropped again.
// EXPECT: eat 0
// EXPECT: drop 0
// EXPECT: drop 1
// EXPECT: eat 2
// EXPECT: drop 2
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    for i in 0..3 {
        let a = mk(i, gpa);
        if i % 2 == 0 { eat(a); continue; }
    }
    println("end");
}
