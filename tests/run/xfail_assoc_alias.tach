// (0.22) A generic struct whose field is an associated type of its
// parameter cannot be named at a concrete type outside generic code: a
// type alias of it, or a struct field of it, is "'Metal' has no
// associated type 'Device'" (written Device::<Metal> in an expression it
// works). This is what keeps std::gpu to one backend per build: with it,
// the public types become core::Device<A: hal::Api> and a second backend
// (CUDA, Vulkan) is another instance next to the native one. Workaround
// in std::gpu: the public structs hold the backend's concrete types
// (`use hal::metal as backend`), and hal::Api's impl checks the backend
// against the interface.
// XFAIL: an associated type in a generic struct's field, at a concrete instance (0.22)
// EXPECT: 7 3

pub trait Api {
    type Device;
    fn open() -> Self::Device;
    fn id(d: Self::Device) -> i64;
}

pub struct Metal {}

pub struct MetalDevice {
    x: i64,
}

impl Api for Metal {
    type Device = MetalDevice;
    fn open() -> MetalDevice { MetalDevice { x: 7 } }
    fn id(d: MetalDevice) -> i64 { d.x }
}

pub struct Device<A: Api> {
    raw: A::Device,
}

impl<A: Api> Device<A> {
    pub fn open() -> Device<A> { Device::<A> { raw: A::open() } }
    pub fn id(self: Device<A>) -> i64 { A::id(self.raw) }
}

pub type NativeDevice = Device<Metal>;

struct Holder {
    dev: Device<Metal>,
    n: i64,
}

fn main() {
    let d = NativeDevice::open();
    let h = Holder { dev: Device::<Metal>::open(), n: 3 };
    println(f"{d.id()} {h.n}");
}
