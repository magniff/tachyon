// sem-own: assigning a field of an owned struct drops the old field.
// EXPECT: drop 1
// EXPECT: end
// EXPECT: drop 2
// EXPECT: drop 3
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
struct P { a: D, b: D }

fn main(gpa: Gpa) {
    var p = P { a: mk(1, gpa), b: mk(3, gpa) };
    p.a = mk(2, gpa);
    println("end");
}
