// sem-own: `if let Some(d) = self.o` in an inout self method moves out of a reference: own.move_out.
// ERROR: own.move_out
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
struct P { o: Option<D> }
impl P { fn f(inout self) { if let Some(d) = self.o { eat(d); } } }

fn main(gpa: Gpa) {
    var p = P { o: Some(mk(1, gpa)) };
    p.f();
}
