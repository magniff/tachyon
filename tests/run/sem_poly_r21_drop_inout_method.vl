// a Drop impl calling another inout method of the value; dropped once each, in reverse order
// FLAGS: --check-alloc
// EXPECT: end
// EXPECT: drop 2 6
// EXPECT: drop 1 1
struct R { id: i64, log: i64 }
impl R { fn mark(inout self) { self.log += 1; } }
impl Drop for R { fn drop(inout self) { self.mark(); println(f"drop {self.id} {self.log}"); } }

fn main() {
    let a = R { id: 1, log: 0 };
    let b = R { id: 2, log: 5 };
    println("end");
}
