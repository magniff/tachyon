// Logical vs arithmetic right shift, left shift dropping high bits, at every
// width; shift amounts of a different integer type.
// EXPECT: 8: 64 25 -32 -13
// EXPECT: 16: 6784 6250 -28928 -2500
// EXPECT: 32: 2525163520 375000000 1179869184 -250000000
// EXPECT: 64: 8000000000000008 1e00000000000000 7ffffffffffffff8 f1ffffffffffffff
// EXPECT: edge: 2147483648 -1 3000000000
// EXPECT: 9223372036854775808
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let s: u8 = 3;
    let u8v: u8 = 200;
    let i8v: i8 = (0 - 100) as i8;
    unsafe { printf(c"8: %d %d %d %d\n", u8v << s, u8v >> s, i8v << s, i8v >> s); }
    let u16v: u16 = 50000;
    let i16v: i16 = (0 - 20000) as i16;
    unsafe { printf(c"16: %d %d %d %d\n", u16v << s, u16v >> s, i16v << s, i16v >> s); }
    let u32v: u32 = 3000000000;
    let i32v: i32 = (0 - 2000000000) as i32;
    unsafe { printf(c"32: %u %u %d %d\n", u32v << s, u32v >> s, i32v << s, i32v >> s); }
    let u64v: u64 = 0xF000000000000001;
    let i64v: i64 = 0 - 0x7000000000000001;
    unsafe { printf(c"64: %lx %lx %lx %lx\n", u64v << s, u64v >> s, i64v << s, i64v >> s); }
    let big: u32 = 31;
    let one: u32 = 1;
    let m: i32 = (0 - 1) as i32;
    unsafe { printf(c"edge: %u %d %u\n", one << big, m >> big, u32v >> (0 as u32)); }
    let x: u64 = 1;
    let n: i64 = 63;
    unsafe { printf(c"%lu\n", x << n); }
    0
}
