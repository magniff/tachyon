// 0.6: generic type aliases.
// EXPECT: 3 7 12 -2
type Pair<T> = (T, T);
type Grid<T> = [[T; 2]; 2];
type Lookup<K, V> = (K, Option<V>);
type IntPair = Pair<i64>;

fn swap<T>(p: sink Pair<T>) -> Pair<T> { (p.1, p.0) }

fn main() -> i32 {
    let p: IntPair = (7, 3);
    let q = swap(p);
    let g: Grid<i64> = [[1, 2], [4, 5]];
    let l: Lookup<u8, i64> = (2, Some(12));
    std::print_int(q.0);
    print(" ");
    std::print_int(q.1);
    print(" ");
    std::print_int(match l.1 { Some(v) => v, None => 0 });
    print(" ");
    std::print_int(l.0 as i64 * (g[1][1] - g[1][0]) - 4);
    println("");
    0
}
