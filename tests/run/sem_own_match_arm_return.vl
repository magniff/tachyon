// sem-own: a `return` inside a match arm after binding the payload: the binding and the other locals dropped once.
// EXPECT: drop 5
// EXPECT: drop 1
// EXPECT: r 5
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
enum E { A(D), N }

fn f(e: sink E, gpa: Gpa) -> i64 {
    let a = mk(1, gpa); match e { E::A(d) => { return d.id; }, E::N => {} } 0
}

fn main(gpa: Gpa) {
    println(f"r {f(E::A(mk(5, gpa)), gpa)}");
}
