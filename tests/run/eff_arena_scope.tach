// EXPECT: 3 2
// 0.16: Arena::scope discharges as designed (§2.3): its effects are the
// closure's minus alloc(ScopedArena), plus alloc(Arena); the arena's own
// refills from Gpa and its frees to Gpa at the scope's end are the
// arena's business, as they are for its Allocator methods.
#[effects(alloc(Arena), panic)]
fn in_scope(a: &mut Arena) -> i64 {
    a.scope(|s| {
        let mut v: Vec<i64, ScopedArena> = Vec::new_in(s);
        for i in 0..3 { v.push(i); }
        v.len()
    })
}

#[effects(alloc(Arena), panic)]
fn nested(a: &mut Arena) -> i64 {
    a.scope(|s| s.scope(|t| {
        let mut v: Vec<i64, ScopedArena> = Vec::new_in(t);
        v.push(1);
        v.push(2);
        v.len()
    }))
}

fn main(gpa: Gpa) -> i32 {
    let mut a = Arena::new_in(gpa);
    println(f"{in_scope(&mut a)} {nested(&mut a)}");
    unsafe { a.free_all(); }
    0
}
