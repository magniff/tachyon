// sem-own: temporaries in nested calls: inner results given to let params, dropped at the statement end.
// XFAIL: WRONG temporaries given to let parameters are dropped at the block's end, not the statement's
// EXPECT: 3
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn add(a: D, b: D) -> i64 { a.id + b.id }

fn main(gpa: Gpa) {
    println(f"{add(mk(1, gpa), mk(2, gpa))}");
    println("end");
}
