// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: method of a view struct returning its slice (views(*self))
// ERROR: error[own.conflict]
struct W { s: [i64] }
impl W { fn get(self) -> [i64] { self.s } }
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let r = W { s: v.as_slice() }.get();
    v.push(2);
    println(r[0]);
    0
}
