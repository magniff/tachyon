// (0.25) A closure that changes a capture holds an inout access of it from
// its creation to its last call (conventions.md §5.4): a read of n between
// two calls is own.conflict.
fn main() {
    var n = 0;
    var f = || { n += 10; };
    f();
    println(f"{n}");
    f();
}
// ERROR: 'n' is read while 'f'
