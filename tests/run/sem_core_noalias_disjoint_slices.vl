// An inout slice and a let slice of one array that do not overlap (constant
// ranges 0..2 and 2..4): rejected as own.conflict. Reasonable code; Rust
// rejects it too (split_at_mut). The message says "borrowed mutably".
// XFAIL: OVERSTRICT f(&x[0..2], x[2..4]) with disjoint constant ranges is own.conflict
// EXPECT: 3
// EXPECT: 50
#[inline(never)]
fn f(a: inout [i64], b: [i64]) -> i64 { a[1] = 50; b[0] }

fn main() -> i32 {
    var x = [1, 2, 3, 4];
    println(f(&x[0..2], x[2..4]));
    println(x[1]);
    0
}
