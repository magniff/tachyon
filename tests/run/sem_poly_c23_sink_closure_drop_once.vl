// sink closures holding R: never called, called once, copied (moved), each R dropped once
// FLAGS: --check-alloc
// EXPECT: drop 2
// EXPECT: 2
// EXPECT: 3 3
// EXPECT: end
// EXPECT: drop 3
// EXPECT: drop 1
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn call<F: FnMut() -> i64>(f: sink F) -> i64 { f() }

fn main() {
    let a = R { id: 1 };
    let b = R { id: 2 };
    let c = R { id: 3 };
    let ka = sink || a.id;
    let kb = sink || b.id;
    let kb2 = kb;
    println(f"{call(kb2)}");
    let kc = sink || c.id;
    println(f"{kc()} {kc()}");
    println("end");
}
