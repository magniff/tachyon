// a generic with a let T calling a sink-self method: copy for i64, own.move_out for an owned T
// ERROR: [own.move_out]: cannot move 'x'
trait E { fn eat(sink self) -> i64; }
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
impl E for R { fn eat(sink self) -> i64 { self.id } }
impl E for i64 { fn eat(sink self) -> i64 { self } }
fn use_it<T: E>(x: T) -> i64 { x.eat() }

fn main() {
    println(f"{use_it(4)}");
    let r = R { id: 1 };
    println(f"{use_it(r)}");
    println(f"{r.id}");
}
