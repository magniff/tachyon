// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) sync.borrow_escapes: a struct holding a str, into a detached thread
// ERROR: error[sync.borrow_escapes]
use std::thread;
struct D { t: str }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    let d = D { t: s.as_str() };
    let h = thread::spawn(sink || d.t.len());
    println(h.join());
    0
}
