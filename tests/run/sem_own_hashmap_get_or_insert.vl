// sem-own: get_or_insert returns an inout slot: assigning drops the old value once.
// XFAIL: SOUNDNESS assigning through the inout [V] slot of get_or_insert (`s[0] = x`) leaks the old value (an assignment through an index)
// EXPECT: drop 9
// EXPECT: drop 1
// EXPECT: end
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
use std::HashMap;

fn main(gpa: Gpa) {
    var m: HashMap<i64, D> = HashMap::new_in(gpa);
    m.insert(1, mk(1, gpa));
    {
        inout s = &m.get_or_insert(1, mk(9, gpa));
        s[0] = mk(2, gpa);
    }
    println("end");
}
