// FLAGS: --check-alloc
// EXPECT: "héllo, wörld  \n second line\r\nthird" 38 36
// EXPECT: <  héllo, wörld  >< second line><third>
// EXPECT: ["a", "b", "", "c"] 4
// EXPECT: ["a", "b", "c"]
// EXPECT: ["", "a", "b", "c", ""]
// EXPECT: ["a", "b-c-d"]
// EXPECT: Some(1) Some(4) None true
// EXPECT: true true Some("b,,c")
// EXPECT: key|value a.b|c
// EXPECT: 42 Ok(2.5) Ok(true) Err(InvalidDigit(0)) Err(Overflow)
// EXPECT: "HÉLLO, WÖRLD  \n SECOND LINE\r\nTHIRD" àéî straße STRASSE
// EXPECT: one 2 2 ababab
// EXPECT: hello 世 43! [42] 18 4 hello 世 43! [42
// EXPECT: Some(93) "hello 世 43! [42"
// EXPECT: 42-42 false true
// EXPECT: çba 6 2
// EXPECT: 0:97,1:233,
// EXPECT: Ok("hello 世 43! [42") Err(Utf8Error { valid_up_to: 0, error_len: Some(1) }) ��
// EXPECT: Ok("from buf")
// EXPECT: ["x", "y", "z"] 2 true
// 0.20 (B5): std's `str` and String: literals as `str`, `&str`
// parameters, split/splitn with byte and substring patterns (an empty one
// matches at every char boundary), find/rfind/contains, trim and
// strip_prefix, split_once/rsplit_once, parse::<T>() for numbers and
// bools, Unicode case mapping (ß is SS), replace_in/repeat_in, String's
// push/push_str/push_fmt/pop, `&s` where a `str` goes, `s.trim()` on a
// String, to_string_in of an f-string, chars().rev(), width, graphemes,
// char_indices, from_utf8 and from_utf8_lossy_in, String::from_buf.
fn count_words(s: &str) -> i64 { s.split_whitespace().count() }

fn main(gpa: Gpa) -> Result<(), std::ParseIntError> {
    // (0.20: a literal is a `str` where one goes, `&str` is `str`)
    let text: str = "  héllo, wörld  \n second line\r\nthird";
    println(f"{text.trim():?} {text.len()} {text.chars().count()}");
    for line in text.lines() {
        print(f"<{line}>");
    }
    println("");
    let csv: str = "a,b,,c";
    let parts: Vec<str> = csv.split(',').collect_in(gpa);
    println(f"{parts:?} {parts.len()}");
    let parts2: Vec<str> = "a, b, c".split(", ").collect_in(gpa);
    println(f"{parts2:?}");
    let e: Vec<str> = "abc".split("").collect_in(gpa);
    println(f"{e:?}");
    let n: Vec<str> = "a-b-c-d".splitn(2, '-').collect_in(gpa);
    println(f"{n:?}");
    let a1 = csv.find(',');
    let a2 = csv.rfind(',');
    let a3 = csv.find("zz");
    let a4 = csv.contains("b,");
    println(f"{a1:?} {a2:?} {a3:?} {a4}");
    let b1 = text.trim().starts_with("hé");
    let b2 = csv.ends_with('c');
    let b3 = csv.strip_prefix("a,");
    println(f"{b1} {b2} {b3:?}");
    let (k1, v1) = "key=value".split_once('=').unwrap();
    let (k2, v2) = "a.b.c".rsplit_once('.').unwrap();
    println(f"{k1}|{v1} {k2}|{v2}");
    let v: i64 = " 42 ".trim().parse::<i64>()?;
    let f = "2.5".parse::<f64>();
    let b = "true".parse::<bool>();
    let d1 = "x1".parse::<i32>();
    let d2 = "300".parse::<u8>();
    println(f"{v} {f:?} {b:?} {d1:?} {d2:?}");
    let up = text.trim().to_uppercase_in(gpa);
    let low = "ÀÉÎ Straße".to_lowercase_in(gpa);
    let up2 = "straße".to_uppercase_in(gpa);
    println(f"{up:?} {low} {up2}");
    let r = "one two two".replace_in("two", "2", gpa);
    let r2 = "ab".repeat_in(3, gpa);
    println(f"{r} {r2}");
    let mut s = String::new_in(gpa);
    s.push_str("hello");
    s.push(' ');
    s.push(0x4e16);
    s.push_fmt(f" {v + 1}!");
    s.push_str(f" [{v}]");
    println(f"{s} {s.len()} {count_words(&s)} {s.trim_end_matches(']')}");
    let p = s.pop();
    println(f"{p:?} {s:?}");
    let t = to_string_in(f"{v}-{v}", gpa);
    let t2 = t.as_str() == "42-42";
    println(f"{t} {t == s} {t2}");
    let mut chars_rev = String::new_in(gpa);
    for c in "abç".chars().rev() {
        chars_rev.push(c);
    }
    let w = "日本語".width();
    let g = "e\u{301}x".graphemes(true).count();
    println(f"{chars_rev} {w} {g}");
    for (i, c) in "aé".char_indices() {
        print(f"{i}:{c},");
    }
    println("");
    let bytes = s.as_bytes();
    let back = str::from_utf8(bytes);
    let bad: [u8] = "\xff\xfe";
    let lossy = String::from_utf8_lossy_in(bad, gpa);
    let bad2 = str::from_utf8(bad);
    println(f"{back:?} {bad2:?} {lossy}");
    let mut buf = Buf::new_in(gpa);
    buf.push_str("from buf");
    let sb = String::from_buf(buf);
    println(f"{sb:?}");
    let ws: Vec<str> = " x  y\tz ".split_whitespace().collect_in(gpa);
    let m = "aXbXc".matches('X').count();
    let q = "Hello".eq_ignore_ascii_case("hELLO");
    println(f"{ws:?} {m} {q}");
    Ok(())
}
