// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a lexer that owns its text; second word() changes it while first used
// ERROR: error[own.conflict]
struct Lexer { src: Buf, pos: i64 }

impl Lexer {
    fn word(inout self) -> [u8] {
        let a = self.pos; self.pos += 1; self.src.as_slice()[a..self.pos]
    }
}

fn main(gpa: Gpa) {
    var b = Buf::new_in(gpa);
    b.push_str("ab");
    var lx = Lexer { src: b, pos: 0 };
    let a = lx.word();
    let c = lx.word();
    println(f"{a} {c}");
}
