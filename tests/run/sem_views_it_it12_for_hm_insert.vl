// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: insert while iterating
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var m: HashMap<i64, i64> = HashMap::new_in(gpa);
    m.insert(1, 1);
    for (k, x) in m.iter() { m.insert(k + 100, x); }
    println(m.len());
    0
}
