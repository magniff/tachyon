// An index whose byte offset wraps to a valid one (2^61 * 8 == 0) is out of bounds.
// EXIT: 101
// STDERR: index out of bounds: index 2305843009213693952, length 1
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(7);
    println(v[2305843009213693952 + Z]);
    println("not reached");
    0
}
