mod util {
    pub fn double(x: i64) -> i64 { x * 2 }
    pub fn half(x: i64) -> i64 { x / 2 }
    pub fn unused() {}
}

mod empty {
    pub fn never() {}
}

use util::*;
use empty::*;

enum Dir { Up, Down }
use Dir::*;

fn main() -> i32 {
    let d = Up;
    match d {
        Dir::Down => 1,
        _ => (half(double(3)) - 3) as i32,
    }
}
