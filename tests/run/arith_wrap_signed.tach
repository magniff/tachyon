// Signed add/sub/mul wrap around (two's complement) at every width.
// EXPECT: i8 -126 126 -80
// EXPECT: i16 -32766 32766 -80
// EXPECT: i32 -2147483646 2147483646 -80
// EXPECT: i64 -9223372036854775806 9223372036854775806 -80
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let a: i8 = 120;
    let b: i8 = 10;
    printf(c"i8 %d %d %d\n", a + b, (0 - 120) as i8 - b, a * b);
    let c: i16 = 32760;
    let d: i16 = 10;
    printf(c"i16 %d %d %d\n", c + d, (0 - 32760) as i16 - d, c * d);
    let e: i32 = 2147483640;
    let f: i32 = 10;
    printf(c"i32 %d %d %d\n", e + f, (0 - 2147483640) as i32 - f, e * f);
    let g: i64 = 9223372036854775800;
    let h: i64 = 10;
    printf(c"i64 %ld %ld %ld\n", g + h, (0 - g) - h, g * h);
    0
}
