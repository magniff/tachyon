// a call through fn(R) (let): the callee borrows; the caller drops once
// FLAGS: --check-alloc
// EXPECT: 1 1
// EXPECT: 2
// EXPECT: drop 2
// EXPECT: end
// EXPECT: drop 1
// XFAIL: OVERSTRICT a temporary passed through a fn(R) pointer's let parameter is rejected (a direct call takes it)
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn look(r: R) -> i64 { r.id }

fn main() {
    let f: fn(R) -> i64 = look;
    let r = R { id: 1 };
    println(f"{f(r)} {f(r)}");
    println(f"{f(R { id: 2 })}");
    println("end");
}
