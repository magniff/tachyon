// (0.24) A field moved out of a temporary, `let x = make().v;`: the
// temporary (a statement's, dropped at its end) was read through its
// address, so its drop freed the moved field again (use after free). The
// field moves out of the value; a type with Drop needs all of it, which is
// own.partial (err_own_temp_field_drop). Reading a field, or borrowing
// one, still keeps the temporary to the statement's end.
// FLAGS: --check-alloc
// EXPECT: 5 1 1
struct P { v: Vec<i64>, n: i64 }

fn make(gpa: Gpa) -> P {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(5);
    P { v: v, n: 1 }
}

fn main(gpa: Gpa) {
    let x = make(gpa).v;
    println(f"{x[0]} {make(gpa).v.len()} {make(gpa).n}");
}
