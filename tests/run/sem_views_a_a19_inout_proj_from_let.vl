// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.readonly: inout result from a let param
// ERROR: error[own.readonly]
fn mid(v: Vec<i64>) -> inout [i64] { &v[0..1] }
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let m = mid(v);
    m[0] = 5;
    println(v[0]);
    0
}
