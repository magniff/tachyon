// std::cli (0.24): parse_or_exit on an error prints the error, its try:
// line and the usage line on stderr, and exits with 2.
// ARGS: --nmae world
// EXIT: 2
// STDERR: error: unknown option '--nmae'
// STDERR: try: --name
// STDERR: usage: hello [options] <file>...
use std::cli::{Arg, Command};
use std::env;

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("hello", gpa)
        .arg(Arg::option("name").default("you"))
        .arg(Arg::positional("file").multiple().required());
    let m = cmd.parse_or_exit(env::args());
    println(f"hello {m.get("name").unwrap()}");
    0
}
