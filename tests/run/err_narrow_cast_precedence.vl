// `cr - 1 as i32` is `cr - (1 as i32)`: the narrowing error's try:
// converts the whole operation (0.18.1), not `cr` alone.
// ERROR: try: (cr - 1) as i32
// ERROR: try: (cr * 2) as i32
fn f(x: i32) -> i32 { x }

fn main() {
    let cr: i64 = 5;
    let a: i32 = cr - 1 as i32;
    let b = f(cr * 2 as i32);
    println(f"{a} {b}");
}
