// FLAGS: --check-unsafe
// EXIT: 101
// EXPECT: 7
// STDERR: unsafe access after free: 16 bytes at offset 0 of a block of 16 bytes
// 0.10: --check-unsafe finds a use after free (through a field).
extern "C" {
    fn printf(f: *u8, ...) -> i32;
    fn malloc(size: u64) -> *u8;
    fn free(p: *u8);
    fn fflush(f: *u8) -> i32;
}

struct Pair { a: i32, b: i32, c: i64 }

fn main() -> i32 {
    let p = unsafe { malloc(16) as *Pair };
    unsafe {
        (*p).a = 3;
        (*p).b = 4;
        printf(c"%d\n", (*p).a + (*p).b);
        fflush(0 as *u8);
        free(p as *u8);
    }
    unsafe { (*p).b }
}
