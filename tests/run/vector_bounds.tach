// EXIT: 101
// STDERR: slice range out of bounds: 3..5, length 4
// EXPECT: 3
// 0.10: vector loads and stores are checked: lanes i..i + lanes in bounds.
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

fn main() -> i32 {
    let xs: [f64; 4] = [1.0, 2.0, 3.0, 4.0];
    let s = xs[0..4];
    let mut i = 0;
    loop {
        let v = v2f64::load(s, i);
        unsafe { printf(c"%g\n", v.sum()); }
        i += 3;
    }
}
