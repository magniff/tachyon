// (0.25 semantics audit, views) The item of a temporary text iterator
// views the text: `s.split(' ').next().unwrap()` views s, so growing s
// while it is used is own.conflict. A named iterator (`var it =
// s.split(' '); it.next()`) and a `for` over it are caught; the chained
// form on the temporary is not (split, split_whitespace, splitn, matches,
// lines, map over them).
// XFAIL: SOUNDNESS the item of a temporary str iterator loses its origin: use after free
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let r = s.split(' ').next().unwrap();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
