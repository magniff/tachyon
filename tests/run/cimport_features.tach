// `import` of a C header: constants from macros and enums, structs with
// bit-fields, packing, alignment and anonymous members, unions, keyword
// field names, function pointers, variadic, renamed and noreturn
// functions, variables and macro aliases, all used against C.
// CSOURCE: tests/c/cimport.c
// EXPECT: 42 65280 1234567890123 -17 4096 35 4464
// EXPECT: 18446744073709551615 65 0.0025 1.50 0.25 24
// EXPECT: green 5 6 -20 1 4
// EXPECT: bits 6 77 -5 24 8
// EXPECT: flags 1 300 1.5 8
// EXPECT: packed 998 7 1
// EXPECT: pack2 5000000009 12 2
// EXPECT: aligned 32 16 16
// EXPECT: anon 42 7
// EXPECT: outer 112
// EXPECT: keywords 15 21
// EXPECT: fnptr 14 42 arith
// EXPECT: variadic 60
// EXPECT: renamed 500
// EXPECT: vars 3 8 99 30 -2 5
// EXPECT: point 11 22 complex -5.0 10.0 scale 9.0
// EXPECT: aligned32 32 32 7 77
import "../c/cimport.h";
import "stdio.h";

extern "C" fn twice_sum(a: i32, b: i32) -> i32 {
    (a + b) * 2
}

fn main() -> i32 {
    printf(c"%d %u %ld %d %d %d %d\n", CI_INT, CI_HEX, CI_LONG, CI_NEG, CI_SHIFT, CI_EXPR, CI_CAST as i32);
    printf(c"%lu %d %.4f %.2f %.2f %lu\n", CI_SIZE, CI_CHAR, CI_DOUBLE, CI_FLOAT as f64, CI_HEXFLOAT, CI_SIZEOF);
    printf(c"%s %u %u %d %ld %ld\n", ci_color_name(CI_GREEN), CI_GREEN, CI_BLUE, ci_signed_value(CI_LOW),
        size_of(ci_small), size_of(ci_color));

    let b = ci_bits_make(5, 17, -100, 123456789012);
    printf(c"bits %d %d %d %ld %ld\n", ci_bits_sum(b), b.after as i32, b.tail, size_of(ci_bits), align_of(ci_bits));

    let f = ci_flags_make(9, 300, 1.5);
    printf(c"flags %d %d %.1f %ld\n", ci_flags_check(f, 9, 300), f.id as i32, f.weight as f64, size_of(ci_flags));

    let p = ci_packed { c: 1, i: 1000, s: -3 };
    printf(c"packed %ld %ld %ld\n", ci_packed_sum(p), size_of(ci_packed), align_of(ci_packed));
    let q = ci_pack2 { c: 2, l: 5000000000, s: 7 };
    printf(c"pack2 %ld %ld %ld\n", ci_pack2_sum(q), size_of(ci_pack2), align_of(ci_pack2));
    let ma = 4096 as *ci_member_aligned;
    printf(c"aligned %ld %ld %ld\n", size_of(ci_member_aligned), align_of(ci_member_aligned),
        (&(*ma).i) as i64 - 4096);

    let mut m = ci_anon_members {
        kind: 0,
        _anon0: ci_anon_members_anon0 { i: 42 },
        _anon1: ci_anon_members_anon1 { lo: 3, hi: 4 },
    };
    let first = ci_anon_get(&m);
    m.kind = 1;
    printf(c"anon %d %d\n", first, ci_anon_get(&m));

    let o = ci_outer {
        inner: ci_inner { a: 1, b: 2 },
        array: [ci_inner { a: 3, b: 4 }, ci_inner { a: 5, b: 6 }],
        u: ci_union { l: 100 },
    };
    printf(c"outer %ld\n", ci_outer_sum(&o));

    let k = ci_keywords { r#type: 1, r#match: 2, r#fn: 3, r#in: 4, r#loop: 5 };
    printf(c"keywords %d %d\n", ci_keywords_sum(k), r#match(7));

    let ops = ci_get_ops();
    printf(c"fnptr %d %d %s\n", ci_apply(twice_sum, 3, 4), (ops.mul)(6, 7), ops.name);
    printf(c"variadic %d\n", ci_sum_ints(3, 10, 20, 30));
    printf(c"renamed %d\n", ci_renamed(5));

    let before = ci_counter;
    ci_set_counter(8);
    printf(c"vars %d %d %d %d %d %d\n", before, ci_alias_counter, ci_limit, ci_table[2], ci_origin.y,
        ci_alias_add(2, 3));

    let s = ci_point_add(ci_point { x: 1, y: 2 }, ci_point { x: 10, y: 20 });
    let z = ci_complex_mul(ci_complex { re: 1.0, im: 2.0 }, ci_complex { re: 3.0, im: 4.0 });
    printf(c"point %d %d complex %.1f %.1f scale %.1f\n", s.x, s.y, z.re, z.im, ci_scale(2.0, 1.5, 3));
    // A record aligned above 16 (0.5: realigned frames).
    let a32 = ci_aligned32_make(7);
    let b32 = ci_aligned32 { v: a32.v };
    printf(c"aligned32 %ld %ld %d %d\n", size_of(ci_aligned32), align_of(ci_aligned32), a32.v,
        ci_aligned32_sum(a32, &b32));
    // Noreturn: C's exit flushes stdout.
    ci_exit(0)
}
