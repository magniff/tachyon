// `import` of a C header: constants from macros and enums, structs with
// bit-fields, packing, alignment and anonymous members, unions, keyword
// field names, function pointers, variadic, renamed and noreturn
// functions, variables and macro aliases, all used against C.
// CSOURCE: tests/c/cimport.c
// EXPECT: 42 65280 1234567890123 -17 4096 35 4464
// EXPECT: 18446744073709551615 65 0.0025 1.50 0.25 24
// EXPECT: green 5 6 -20 1 4
// EXPECT: bits 6 77 -5 24 8
// EXPECT: flags 1 300 1.5 8
// EXPECT: packed 998 7 1
// EXPECT: pack2 5000000009 12 2
// EXPECT: aligned 32 16 16
// EXPECT: anon 42 7
// EXPECT: outer 112
// EXPECT: keywords 15 21
// EXPECT: fnptr 14 42 arith
// EXPECT: variadic 60
// EXPECT: renamed 500
// EXPECT: vars 3 8 99 30 -2 5
// EXPECT: point 11 22 complex -5.0 10.0 scale 9.0
// EXPECT: aligned32 32 32 7 77
import "../c/cimport.h" as c;
import "stdio.h" as c;

extern "C" fn twice_sum(a: i32, b: i32) -> i32 {
    (a + b) * 2
}

fn main() -> i32 {
    unsafe {
        c::printf(c"%d %u %ld %d %d %d %d\n", c::CI_INT, c::CI_HEX, c::CI_LONG, c::CI_NEG, c::CI_SHIFT, c::CI_EXPR, c::CI_CAST as i32);
        c::printf(c"%lu %d %.4f %.2f %.2f %lu\n", c::CI_SIZE, c::CI_CHAR, c::CI_DOUBLE, c::CI_FLOAT as f64, c::CI_HEXFLOAT, c::CI_SIZEOF);
        c::printf(c"%s %u %u %d %ld %ld\n", c::ci_color_name(c::CI_GREEN), c::CI_GREEN, c::CI_BLUE, c::ci_signed_value(c::CI_LOW),
            size_of(c::ci_small), size_of(c::ci_color));
    }

    let b = unsafe { c::ci_bits_make(5, 17, -100, 123456789012) };
    unsafe {
        c::printf(c"bits %d %d %d %ld %ld\n", c::ci_bits_sum(b), b.after as i32, b.tail, size_of(c::ci_bits), align_of(c::ci_bits));
    }

    let f = unsafe { c::ci_flags_make(9, 300, 1.5) };
    unsafe {
        c::printf(c"flags %d %d %.1f %ld\n", c::ci_flags_check(f, 9, 300), f.id as i32, f.weight as f64, size_of(c::ci_flags));
    }

    let p = c::ci_packed { c: 1, i: 1000, s: -3 };
    unsafe {
        c::printf(c"packed %ld %ld %ld\n", c::ci_packed_sum(p), size_of(c::ci_packed), align_of(c::ci_packed));
    }
    let q = c::ci_pack2 { c: 2, l: 5000000000, s: 7 };
    unsafe {
        c::printf(c"pack2 %ld %ld %ld\n", c::ci_pack2_sum(q), size_of(c::ci_pack2), align_of(c::ci_pack2));
    }
    let ma = unsafe { 4096 as *c::ci_member_aligned };
    unsafe {
        c::printf(c"aligned %ld %ld %ld\n", size_of(c::ci_member_aligned), align_of(c::ci_member_aligned),
            (&(*ma).i) as i64 - 4096);
    }

    let mut m = c::ci_anon_members {
        kind: 0,
        _anon0: c::ci_anon_members_anon0 { i: 42 },
        _anon1: c::ci_anon_members_anon1 { lo: 3, hi: 4 },
    };
    let first = unsafe { c::ci_anon_get(&m) };
    m.kind = 1;
    unsafe { c::printf(c"anon %d %d\n", first, c::ci_anon_get(&m)); }

    let o = c::ci_outer {
        inner: c::ci_inner { a: 1, b: 2 },
        array: [c::ci_inner { a: 3, b: 4 }, c::ci_inner { a: 5, b: 6 }],
        u: c::ci_union { l: 100 },
    };
    unsafe { c::printf(c"outer %ld\n", c::ci_outer_sum(&o)); }

    let k = c::ci_keywords { r#type: 1, r#match: 2, r#fn: 3, r#in: 4, r#loop: 5 };
    unsafe { c::printf(c"keywords %d %d\n", c::ci_keywords_sum(k), c::r#match(7)); }

    let ops = unsafe { c::ci_get_ops() };
    unsafe {
        c::printf(c"fnptr %d %d %s\n", c::ci_apply(twice_sum, 3, 4), (ops.mul)(6, 7), ops.name);
        c::printf(c"variadic %d\n", c::ci_sum_ints(3, 10, 20, 30));
        c::printf(c"renamed %d\n", c::ci_renamed(5));
    }

    let before = c::ci_counter;
    unsafe {
        c::ci_set_counter(8);
        c::printf(c"vars %d %d %d %d %d %d\n", before, c::ci_alias_counter, c::ci_limit, c::ci_table[2], c::ci_origin.y,
            c::ci_alias_add(2, 3));
    }

    let s = unsafe { c::ci_point_add(c::ci_point { x: 1, y: 2 }, c::ci_point { x: 10, y: 20 }) };
    let z = unsafe { c::ci_complex_mul(c::ci_complex { re: 1.0, im: 2.0 }, c::ci_complex { re: 3.0, im: 4.0 }) };
    unsafe {
        c::printf(c"point %d %d complex %.1f %.1f scale %.1f\n", s.x, s.y, z.re, z.im, c::ci_scale(2.0, 1.5, 3));
    }
    // A record aligned above 16 (0.5: realigned frames).
    let a32 = unsafe { c::ci_aligned32_make(7) };
    let b32 = c::ci_aligned32 { v: a32.v };
    unsafe {
        c::printf(c"aligned32 %ld %ld %d %d\n", size_of(c::ci_aligned32), align_of(c::ci_aligned32), a32.v,
            c::ci_aligned32_sum(a32, &b32));
    }
    // Noreturn: C's exit flushes stdout.
    unsafe { c::ci_exit(0) }
}
