// a generic struct with a generic Drop impl, holding an R: W's drop then its field's
// FLAGS: --check-alloc
// EXPECT: end
// EXPECT: drop W40
// EXPECT: drop W30
// EXPECT: drop R2
// EXPECT: drop W20
// EXPECT: drop W10
// EXPECT: drop R1
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop R{self.id}"); } }
struct W<T> { x: T, tag: i64 }
impl<T> Drop for W<T> { fn drop(inout self) { println(f"drop W{self.tag}"); } }

fn main() {
    let a = W { x: R { id: 1 }, tag: 10 };
    let b = W { x: 5, tag: 20 };
    let c = W { x: W { x: R { id: 2 }, tag: 30 }, tag: 40 };
    println("end");
}
