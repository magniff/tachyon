// requires i >= 0 && i + 1 <= len does not prove i < len when i + 1 wraps.
// EXPECT: 3
// EXIT: 101
// STDERR: index out of bounds: index 9223372036854775807, length 3
static var Z: i64 = 0;

#[inline(never)]
fn at(s: [i64], i: i64) -> i64
    requires i >= 0 && i + 1 <= s.len()
{
    s[i]
}

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [1, 2, 3];
    println(at(a[..], 2 + Z));
    println(at(a[..], 9223372036854775807 + Z));
    0
}
