// Vec::remove has a requires: a #[no_panic] function calling it may panic.
// ERROR: 'take' is #[no_panic], but it may panic
#[no_panic]
fn take(v: inout Vec<i64>, i: i64) -> i64 { v.remove(i) }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    println(take(&v, 3));
    0
}
