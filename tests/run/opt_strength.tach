// Multiplication and division by powers of two become shifts and masks;
// signed division rounds toward zero (the fix-up for negative values).
// EXPECT: 40 -40 1 -1 2 -2 3 -3 0 0
// EXPECT: 1 -1 3 -3 3 1
// EXPECT: 12 255 4611686018427387903 3
// CHECK-OPT: 1
// CHECK: fn scale:
// CHECK: shl
// CHECK-NOT: mul
// CHECK: fn halve_u:
// CHECK-NOT: div
// CHECK: shr
// CHECK: fn quarter:
// CHECK-NOT: div
// CHECK: fn main:
extern fn printf(format: *u8, ...) -> i32;

fn scale(x: i64) -> i64 { x * 8 }
fn halve_u(x: u64) -> u64 { x / 2 }
fn quarter(x: i32) -> i32 { x / 4 }
fn quarter_rem(x: i32) -> i32 { x % 4 }
fn mask(x: u8) -> u8 { x % 16u8 }

fn main() -> i32 {
    printf(c"%ld %ld %d %d %d %d %d %d %d %d\n", scale(5), scale(-5), quarter(7), quarter(-7),
           quarter(8), quarter(-8), quarter(15), quarter(-15), quarter(3), quarter(-3));
    printf(c"%d %d %d %d %d %d\n", quarter_rem(5), quarter_rem(-5), quarter_rem(7), quarter_rem(-7),
           quarter_rem(2147483647), mask(17u8) as i32);
    printf(c"%lu %d %lu %d\n", halve_u(24) / 1, (255u8 / 1u8) as i32,
           halve_u(18446744073709551615) / 2, quarter(-2147483647 - 1) / -178956970);
    0
}
