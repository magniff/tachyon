// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: hello (closure with a let array param returning a view)
// XFAIL: OVERSTRICT a closure's let array parameter is copied, so a view of it is own.escape
// EXPECT: hello
// EXPECT: 7
fn clobber() -> i64 { let z = [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]; z[3] }
fn main() -> i32 {
    let a = ['h', 'e', 'l', 'l', 'o'];
    let c = |x: [u8; 5]| -> [u8] { x[..] };
    let n = c(a);
    let k = clobber();
    println(n);
    println(k);
    0
}
