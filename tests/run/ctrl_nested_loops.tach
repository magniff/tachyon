// `break` and `continue` apply to the innermost loop only.
// EXPECT: 750
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let mut total = 0;
    let mut i = 0;
    while i != 10 {
        let mut j = 0;
        while j != 10 {
            j += 1;
            if j > i { break; }
            if (i + j) % 3 == 0 { continue; }
            total += i * j;
        }
        i += 1;
    }
    unsafe { printf(c"%ld\n", total); }
    0
}
