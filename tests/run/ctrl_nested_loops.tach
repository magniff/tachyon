// `break` and `continue` apply to the innermost loop only.
// EXPECT: 750
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let total = 0;
    let i = 0;
    loop {
        if i == 10 { break; };
        let j = 0;
        loop {
            if j == 10 { break; };
            j += 1;
            if j > i { break; };
            if (i + j) % 3 == 0 { continue; };
            total += i * j;
        }
        i += 1;
    }
    printf("%ld\n".0, total);
    0
}
