// 0.16: a generic instantiated at a C type, and an impl's method on one,
// have the C module in their symbols (`id.GN9<c>.div_t`): spelled `0c_`
// for assemblers, so `-S` gives assembly cc takes (tests/objcheck.sh
// assembles it), the same symbols as the compiler's own objects.
// CHECK-OPT: 0
// ASM(aarch64-macos): _vole.0c_.div_t.q:
// ASM(aarch64-macos): bl _vole.id.GN90c_.div_t
// ASM(aarch64-macos): bl _vole.Bx.get.GN90c_.div_t
// ASM(aarch64-macos): bl _vole.id.GPN90c_.div_t
// ASM(aarch64-linux): vole.0c_.div_t.q:
// ASM(aarch64-linux): bl vole.id.GN90c_.div_t
// ASM(aarch64-linux): bl vole.Bx.get.GN90c_.div_t
// ASM(aarch64-linux): bl vole.id.GPN90c_.div_t
// EXPECT: 3 1 3 3
import "stdlib.h" as c;

trait Q {
    fn q(self) -> i64;
}

impl Q for c::div_t {
    fn q(self) -> i64 {
        self.quot as i64
    }
}

struct Bx<T> { v: T }

impl<T> Bx<T> {
    fn get(self) -> T {
        self.v
    }
}

fn id<T>(x: sink T) -> T {
    x
}

fn qq<T: Q>(x: T) -> i64 {
    x.q()
}

fn main() {
    let v = id(unsafe { c::div(7, 2) });
    let b = Bx { v: v };
    let w = b.get();
    let p: *c::div_t = &w;
    let s = id(p);
    println(f"{v.quot} {w.rem} {unsafe { qq(*s) }} {v.q()}");
}
