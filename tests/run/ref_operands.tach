// (0.18.1) A reference to a number or a bool is read through where the
// value is wanted: an operator's operand (`n + 1`, `3 < n`, `a - b` in a
// `sort_by` closure), an argument, a typed `let`; two references compare
// what they point to.
// EXPECT: 10 1 true 10
enum E { A(i64), B }

fn f(e: &E) -> i64 {
    match e {
        E::A(n) => { let z = n + 1; let w = 1 + n; if 3 < n && n == 4 { z + w } else { 0 } } E::B => 0
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64> = Vec::new_in(gpa); v.push(3); v.push(1);
    v.sort_by(|a, b| a - b);
    let e = E::A(4);
    let a = 5; let b = 5; let ra = &a; let rb = &b;
    println(f"{f(&e)} {v[0]} {ra == rb} {ra + rb}");
}
