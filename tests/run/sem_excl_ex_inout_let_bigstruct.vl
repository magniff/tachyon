// a large plain struct may be passed by address (D5's ABI): still a copy semantically
// EXPECT: 10 1
struct P { x: i64, y: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64 }
fn f(a: inout P, b: P) { a.x = 10; a.y = b.x; }

fn main() {
    var p = P { x: 1, y: 2, a: 0, b: 0, c: 0, d: 0, e: 0, f: 0, g: 0 }; f(&p, p);
    println(f"{p.x} {p.y}");
}
