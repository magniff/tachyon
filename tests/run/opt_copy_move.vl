// FLAGS: --values=error
// EXPECT: 1498500
// (0.17) A move is a COPY_MOVE (middle/copies.vl): under --values=error,
// `let mut b = a` of an owned local leaves `a` unread until it is bound
// again, so the copy is elided in a loop too; only the copy of the array
// literal stays.
// CHECK: fn main:
// CHECK: callc memcpy
// CHECK-NOT: callc memcpy
// CHECK: ret
use std::Vec;

extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct Pack { items: Vec<i64>, pad: [i64; 20] }

fn main(gpa: Gpa) -> i32 {
    var total = 0;
    for k in 0..1000 {
        var a = Pack { items: Vec::new_in(gpa), pad: [0; 20] };
        a.pad[k % 20] = k;
        var b = a;
        b.pad[(k + 3) % 20] = 2 * k;
        total += b.pad[k % 20] + b.pad[(k + 3) % 20] + b.pad[(k + 7) % 20];
    }
    unsafe { printf(c"%ld\n", total); }
    0
}
