// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `f(v.as_slice())`; s grows while it is used
// ERROR: error[own.conflict]
fn f(l: [str]) -> str { l[0] }
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var v: Vec<str> = Vec::new_in(gpa); v.push(w);
    let r = f(v.as_slice());
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
