// a default inout-self method calling a sink-self method: a move out of an inout access
// ERROR: [own.move_out]: cannot move 'self'
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }

trait C {
    fn eat(sink self) -> i64;
    fn poke(inout self) -> i64 { self.eat() }
}

impl C for R { fn eat(sink self) -> i64 { self.id } }

fn main() {
    var r = R { id: 1 };
    println(f"{r.poke()}");
    println("end");
}
