// 0.18.1: a heap's peek is a copy of an element the heap keeps (as Vec's
// last): reading it is fine, moving it out would drop it twice.
// ERROR: own.move_out
// ERROR: it is a copy of an element the collection keeps
struct Job { pri: i64, data: Vec<i64> }

impl Eq for Job {
    fn eq(self: &Job, o: &Job) -> bool { self.pri == o.pri }
}

impl Ord for Job {
    fn cmp(self: &Job, o: &Job) -> i64 { self.pri - o.pri }
}

fn keep(j: Job) -> i64 { j.pri }

fn main(gpa: Gpa) -> i32 {
    let mut t: MinHeap<Job> = MinHeap::new_in(gpa);
    t.push(Job { pri: 1, data: Vec::new_in(gpa) });
    let n = t.peek().unwrap().pri;
    keep(t.peek().unwrap());
    0
}
