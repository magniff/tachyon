// --coverage (0.18): std::coverage() counts the blocks that ran; more of
// them after each new path.
// FLAGS: --coverage
// EXPECT: true true
fn f(x: i64) -> i64 { if x > 3 { x * 2 } else { x + 1 } }

fn hits() -> i64 {
    let c = std::coverage();
    let mut n = 0;
    for i in 0..c.len { if c[i] != 0 { n += 1; } }
    n
}

fn main() -> i32 {
    let a = hits();
    let _ = f(1);
    let b = hits();
    let _ = f(9);
    let c = hits();
    println(f"{a < b} {b < c}");
    0
}
