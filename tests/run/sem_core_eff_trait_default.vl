// A trait's default method calling the required one, whose impl prints.
// ERROR: 'quiet' is #[no_io], but it does io
trait Get {
    fn get(self) -> i64;
    fn twice(self) -> i64 { self.get() * 2 }
}

struct Loud { n: i64 }
impl Get for Loud { fn get(self) -> i64 { println("io"); self.n } }

#[no_io]
fn quiet(l: Loud) -> i64 { l.twice() }

fn main() -> i32 {
    println(quiet(Loud { n: 3 }));
    0
}
