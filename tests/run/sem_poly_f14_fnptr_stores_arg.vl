// a fn pointer that stores its view argument into an inout Vec: the Vec of views outlives the source
// ERROR: [own.escape]: 'all' is used here, but 'v', which it views, was dropped
fn keep(dst: inout Vec<[i64]>, s: [i64]) { dst.push(s); }

fn main(gpa: Gpa) {
    let f: fn(inout Vec<[i64]>, [i64]) = keep;
    var all: Vec<[i64]> = Vec::new_in(gpa);
    {
        var v: Vec<i64> = Vec::new_in(gpa);
        for i in 0..10 { v.push(i + 100); }
        f(&all, v.as_slice());
    }
    var w: Vec<i64> = Vec::new_in(gpa);
    for i in 0..10 { w.push(i); }
    println(f"{all[0][3]}");
}
