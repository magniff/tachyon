// and/or/xor/not at every width, including sign bits.
// EXPECT: 74 223 149 53
// EXPECT: 4032 -12297 -16329 12344
// EXPECT: e0d0e0f dfafbfef d1a2b1e0 21524110
// EXPECT: 123456789abcdef ffffffffffffffff fedcba9876543210 -81985529216486896
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let a: u8 = 0xCA;
    let b: u8 = 0x5F;
    printf("%d %d %d %d\n".0, a & b, a | b, a ^ b, ~a);
    let c: i16 = (0 - 12345) as i16;
    let d: i16 = 0x0FF0;
    printf("%d %d %d %d\n".0, c & d, c | d, c ^ d, ~c);
    let e: u32 = 0xDEADBEEF;
    let f: u32 = 0x0F0F0F0F;
    printf("%x %x %x %x\n".0, e & f, e | f, e ^ f, ~e);
    let g: i64 = 0 - 1;
    let h: i64 = 0x123456789ABCDEF;
    printf("%lx %lx %lx %ld\n".0, g & h, g | h, g ^ h, ~h);
    0
}
