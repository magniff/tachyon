// +=, -=, <<=, >>= at several widths, wrapping where needed.
// EXPECT: 44 -5 2147483648 -8 15 3.25
// EXPECT: 275
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    var a: u8 = 200;
    a += 100;
    var b: i16 = 5;
    b -= 10;
    var c: u32 = 1;
    c <<= 31;
    var d: i32 = (0 - 64) as i32;
    d >>= 3;
    var e: u64 = 0xFFFFFFFFFFFFFFFF;
    e >>= 60;
    var f: f64 = 1.5;
    f += 2.25;
    f -= 0.5;
    unsafe { printf(c"%d %d %u %d %lu %.2f\n", a, b, c, d, e, f); }
    var i: i64 = 0;
    var acc: i64 = 0;
    while i != 10 {
        acc += i * i;
        acc -= 1;
        i += 1;
    }
    unsafe { printf(c"%ld\n", acc); }
    0
}
