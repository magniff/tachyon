// XFAIL: DIAG &(if c { a } else { b }) is "cannot take address of non-lvalue expression", not conv.place
// an if expression choosing between places is not a place
// ERROR: conv.place
fn bump(n: inout i64) { n += 1; }
fn main() { var a = 1; var b = 1; let c = true; bump(&(if c { a } else { b })); println(f"{a}"); }
