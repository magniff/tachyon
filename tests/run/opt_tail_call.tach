// Sibling calls: a call whose result is returned at once becomes a jump
// after the frame goes (at -O2), directly or through a function pointer.
// Mutual recursion this deep only runs in constant stack that way, but
// it is shallow enough here to run at every level.
// EXPECT: 1 0 1
// EXPECT: 4950 120
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn is_even(n: i64) -> i64 {
    if n == 0 { 1 } else { is_odd(n - 1) }
}

fn is_odd(n: i64) -> i64 {
    if n == 0 { 0 } else { is_even(n - 1) }
}

fn sum_to(n: i64, acc: i64, step: fn(i64, i64, fn(i64, i64) -> i64) -> i64) -> i64 {
    step(n, acc, add_down)
}

fn add_down(n: i64, acc: i64) -> i64 {
    if n == 0 { acc } else { sum_to(n - 1, acc + n, through) }
}

fn through(n: i64, acc: i64, next: fn(i64, i64) -> i64) -> i64 {
    next(n, acc)
}

fn fact(n: i64) -> i64 {
    if n <= 1 { 1 } else { n * fact(n - 1) }
}

fn main() -> i32 {
    printf(c"%ld %ld %ld\n", is_even(100000), is_even(7), is_odd(9));
    printf(c"%ld %ld\n", sum_to(99, 0, through), fact(5));
    0
}

// ASM(aarch64-macos): is_odd:
// ASM(aarch64-macos): ldp x29, x30
// ASM(aarch64-macos): b _tachyon.is_even
// ASM(x86_64-macos): is_odd:
// ASM(x86_64-macos): popq %rbp
// ASM(x86_64-macos): jmp _tachyon.is_even
