// moving out of an inout parameter is own.move_out (it must keep a value)
// ERROR: own.move_out
fn sw(a: inout Vec<i64>, b: inout Vec<i64>) { let t = a; a = b; b = t; }

fn main(gpa: Gpa) {
    var a: Vec<i64> = Vec::new_in(gpa); var b: Vec<i64> = Vec::new_in(gpa); sw(&a, &b);
    println(f"{a.len()}");
}
