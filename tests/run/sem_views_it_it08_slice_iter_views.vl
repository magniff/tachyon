// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: items of a slice of Vec<str>
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var v: Vec<str> = Vec::new_in(gpa);
    v.push(s.as_str());
    let sl = v.as_slice();
    var r: str = "";
    for x in sl { r = x; }
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
