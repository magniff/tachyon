// Mutex<Vec<R>> pushed into from scoped threads: every R dropped once
// FLAGS: --check-alloc
// EXPECT: 200
use std::thread;
use std::sync::Mutex;
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { if self.id < 0 { println("neg"); } } }

fn main(gpa: Gpa) {
    let v: Vec<R> = Vec::new_in(gpa);
    let m = Mutex::new(v);
    thread::scope(|s| {
        s.spawn(|| { for i in 0..100 { m.with(|d| d.push(R { id: i })); } 0 });
        s.spawn(|| { for i in 0..100 { m.with(|d| d.push(R { id: i })); } 0 });
        0
    });
    println(f"{m.with(|d| d.len())}");
}
