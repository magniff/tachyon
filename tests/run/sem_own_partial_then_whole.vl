// sem-own: after a partial move, using the whole struct is own.moved.
// ERROR: own.
struct D { id: i64, v: Vec<i64> }
struct P { a: D, b: D }
fn take(p: sink P) {}

fn main(gpa: Gpa) {
    let p = P { a: D { id: 1, v: Vec::new_in(gpa) }, b: D { id: 2, v: Vec::new_in(gpa) } };
    let x = p.b;
    take(p);
}
