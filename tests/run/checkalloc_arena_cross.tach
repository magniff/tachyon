// FLAGS: --check-alloc
// EXIT: 101
// STDERR: invalid free at
// STDERR: checkalloc_arena_cross.tach:10:14: block #2 (16 bytes) of an arena, allocated at
// STDERR: checkalloc_arena_cross.tach:9:13, given to Gpa
// 0.16: --check-alloc: an arena's block given to Gpa.
fn main(gpa: Gpa) -> i32 {
    let a = Arena::new_in(gpa);
    let p = a.alloc(16, 8);
    unsafe { gpa.free(p, 16, 8); }
    0
}
