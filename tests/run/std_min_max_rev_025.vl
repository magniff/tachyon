// (0.25) std::min, max, clamp (any Ord) and abs (i64); `.rev()` of an
// inclusive range as of an exclusive one.
// EXPECT: 3 4 -7 5 5 10 0 4
// EXPECT: 1.5 b y
// EXPECT: 321215
// EXPECT: 100
use std::{abs, clamp, max, min};

fn main(gpa: Gpa) -> i32 {
    println(
        f"{min(3, 4)} {max(3, 4)} {min(-1, -7)} {abs(-5)} {abs(5)} {clamp(12, 0, 10)} {clamp(-2, 0, 10)} {clamp(4, 0, 10)}");
    let a = String::from_in("x", gpa);
    let b = String::from_in("y", gpa);
    let m = max(a, b);
    println(f"{min(2.5, 1.5)} {max("a", "b")} {m}");
    for i in (1..=3).rev() { print(i); }
    for i in (1..3).rev() { print(i); }
    for i in (5..=5).rev() { print(i); }
    for i in (6..=5).rev() { print(i); }
    println("");
    let s: i64 = (1..=4).rev().map(|x| x * 10).sum();
    println(s);
    0
}
