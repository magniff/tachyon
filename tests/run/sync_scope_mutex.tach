// (0.21) Scoped threads share one Mutex of the caller's (borrowed, not
// copied) and an immutable atomic static; the totals are exact.
// EXPECT: 4001 4000

use std::thread;
use std::sync::Mutex;
use std::sync::atomic::{AtomicI64, Ordering};

static HITS: AtomicI64 = AtomicI64 { v: 0 };

fn main() {
    let m = Mutex::new(0);
    thread::scope(|s| {
        for _ in 0..4 {
            s.spawn(|| {
                for _ in 0..1000 {
                    m.with(|n| n += 1);
                    HITS.fetch_add(1, Ordering::Relaxed);
                }
                0
            });
        }
        m.with(|n| n += 1);
        0
    });
    println(f"{m.with(|n| n)} {HITS.load(Ordering::SeqCst)}");
}
