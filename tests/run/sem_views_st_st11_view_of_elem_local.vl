// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view into an element String; the Vec of Strings is cleared
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var owners: Vec<String> = Vec::new_in(gpa);
    owners.push(String::from_in("hello", gpa));
    let w = owners[0].as_str();
    owners.clear();
    println(w);
    0
}
