// Value ranges: bounds checks proven by the loop's test go (and others
// stay, and still fail when they should), comparisons decided by masks
// and branches fold, a match with guards becomes a decision tree (a failed
// guard goes straight to the arms that can still match), and a chain of
// equality tests on one value becomes a switch.
// EXPECT: 15 15 6 1 1 7 4 20 0 40 3
// CHECK: fn total:
// CHECK-NOT: rt.panic
// CHECK: fn total_u:
// CHECK-NOT: rt.panic
// CHECK: fn shifted:
// CHECK: rt.panic
// CHECK: fn masked:
// CHECK-NOT: branch
// CHECK: fn pick:
// CHECK: fn classify:
// CHECK: switch
// CHECK: fn main:
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn total(s: [i64]) -> i64 {
    let mut t = 0;
    for i in 0..s.len as i64 {
        t += s[i];
    }
    t
}

fn total_u(s: [i64]) -> i64 {
    let mut t = 0;
    let mut i: u64 = 0;
    while i < s.len as u64 {
        t += s[i];
        i += 1;
    }
    t
}

// s[i + 1] is not proven: its check stays.
fn shifted(s: [i64]) -> i64 {
    let mut t = 0;
    for i in 0..s.len as i64 {
        if i + 1 < s.len as i64 {
            t += s[i + 1] - s[i];
        }
    }
    t
}

// x & 7 is below 8: the test is always true.
fn masked(x: i64) -> i64 {
    let y = x & 7;
    if y < 8 { y } else { 100 }
}

enum Shape { Circle(i64), Square(i64), Dot }

fn pick(s: Shape, limit: i64) -> i64 {
    match s {
        Shape::Circle(r) if r > limit => 1,
        Shape::Square(x) => x,
        Shape::Circle(r) => r + 2,
        Shape::Dot => 7,
    }
}

fn classify(c: i64) -> i64 {
    if c == 1 { 10 } else if c == 5 { 20 } else if c == 9 { 30 } else if c == 12 { 40 } else { 0 }
}

fn main() -> i32 {
    let a = [1, 2, 3, 4, 5];
    let t = total;
    let tu = total_u;
    let sh = shifted;
    let m = masked;
    let p = pick;
    let c = classify;
    unsafe {
        printf(c"%ld %ld %ld %ld %ld %ld %ld %ld %ld %ld %ld\n", t(a[..]), tu(a[..]), m(14), p(Shape::Circle(5), 1),
               sh(a[..]) - 3, p(Shape::Dot, 0), p(Shape::Square(4), 0), c(5), c(6), c(12), p(Shape::Circle(1), 3));
    }
    0
}
