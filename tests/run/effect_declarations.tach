// 0.16 phase 0: effect declarations parse and are accepted (the checks
// come with the effects, T1): on functions, trait and impl functions,
// C functions; `effects(...)` bounds; #[sealed] and #[scoped] structs.
// EXPECT: 9 4 2
extern "C" {
    #[link_name = "labs"]
    #[pure]
    fn abs64(x: i64) -> i64;
}

trait Area {
    #[pure]
    fn area(self: &Self) -> i64;
}

#[sealed]
struct Sq { side: i64 }

impl Area for Sq {
    #[effects()]
    #[inline]
    fn area(self: &Sq) -> i64 { self.side * self.side }
}

#[sealed]
#[scoped]
struct H { id: i64 }
#[no_alloc]
#[no_io]
#[no_panic]
fn apply<F: Fn(i64) -> i64 + effects(panic, diverge)>(f: F, x: i64) -> i64 {
    f(x)
}
#[effects(alloc(Gpa, extern), io, global, panic, diverge, unsafe)]
fn noisy(gpa: Gpa) -> i64 {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(2);
    let n = v.get(0);
    v.free();
    n
}

fn main(gpa: Gpa) {
    let s = Sq { side: 3 };
    let h = H { id: apply(|x| x + 1, 3) };
    println(f"{s.area()} {h.id} {unsafe { abs64(-noisy(gpa)) }}");
}
