// `let PAT = e else { .. };` (0.18.1), Rust's let-else: the bindings are
// in scope after it; the else block leaves (return, continue, panic). One
// binding, several (`mut` kept), in a loop, on a borrowed copy.
// EXPECT: 8 -1 4 0 5 7
enum E { A(i64, i64), B }
struct P { x: i64, y: i64 }

fn f(o: Option<i64>) -> i64 {
    let Some(x) = o else { return -1; };
    x * 2
}

fn g(e: E) -> i64 {
    let E::A(a, mut b) = e else { return 0; };
    b += 1;
    a + b
}

fn h(v: &Vec<Option<[u8]>>) -> i64 {
    let mut n = 0;
    for i in 0..v.len() {
        let Some(s) = v.get(i) else { continue; };
        n += s.len();
    }
    n
}

fn k(r: Result<i64, [u8]>) -> i64 {
    let Ok(v) = r else { panic("bad"); };
    v
}

fn main(gpa: Gpa) {
    let mut v: Vec<Option<[u8]>> = Vec::new_in(gpa);
    v.push(Some("ab"));
    v.push(None);
    v.push(Some("cde"));
    println(f"{f(Some(4))} {f(None)} {g(E::A(1, 2))} {g(E::B)} {h(&v)} {k(Ok(7))}");
}
