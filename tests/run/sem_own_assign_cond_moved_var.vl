// sem-own: assigning to a conditionally moved var: the old value dropped only when it was not moved.
// EXPECT: eat 1
// EXPECT: drop 1
// EXPECT: drop 3
// EXPECT: end
// EXPECT: drop 4
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn run(c: bool, id: i64, gpa: Gpa) -> D {
    var a = mk(id, gpa);
    if c { eat(a); }
    a = mk(id + 1, gpa);
    a
}

fn main(gpa: Gpa) {
    let x = run(true, 1, gpa);
    let y = run(false, 3, gpa);
    println("end");
}
