// A negative index into a fixed array is out of bounds (0.7): the message
// shows it as signed.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

#[inline(never)]
fn at(i: i64) -> i64 {
    let table: [i64; 5] = [1, 2, 3, 4, 5];
    table[i]
}

fn main() {
    unsafe {
        printf(c"%lld\n", at(4));
        printf(c"%lld\n", at(-1));
    }
}

// EXPECT: 5
// EXIT: 101
// STDERR: index out of bounds: index -1, length 5
