// An assert_eq's operands are walked like any expression (0.25): a call
// that allocates in one is the function's effect.
// ERROR: 'f' is #[no_alloc], but it allocates from Gpa
fn make(gpa: Gpa) -> i64 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.len()
}

#[no_alloc]
fn f(gpa: Gpa) { assert_eq(make(gpa), 1); }

fn main(gpa: Gpa) -> i32 {
    f(gpa);
    0
}
