// A memory intrinsic's bounds check names the index's position at every
// level, as `v.load(s, i)` does (found by tests/fuzz/run.sh -A: -O0 said
// where, -O1 and -O2 did not).
// EXIT: 101
// EXPECT: in
// STDERR: arch_bounds_site.tach:11:19: slice range out of bounds: 9..25, length 24
use std::arch::has;
use std::arch::aarch64::vst1q_u8;

fn put(dst: inout [u8], i: i64) {
    vst1q_u8(dst, i, v16u8::splat(7));
}

fn main() {
    var d: [u8; 24] = [0; 24];
    if has("aarch64.neon") {
        put(&d[..], 8);
        println("in");
        put(&d[..], 9);
    }
    println("never");
}
