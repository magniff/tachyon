// 0.17: the SLP vectorizer's tables (uses and positions, by instruction)
// grow with the instructions it makes. Instruction ids are local to each
// function since 0.17; main below is small, and packing its literals' four
// lanes, in more than one block, adds more than half again its
// instructions: the tables, sized once when the pass started, were
// written past their end when the uses were counted again after a block
// (a heap corruption glibc stopped on aarch64-linux, in opt_slp's main).
// EXPECT: 16 26 36 46
// EXPECT: 7 9 11 13
// EXPECT: 9 11 13 15 | 20 30 40 50
// CHECK: fn main:
// CHECK: v4i32
struct Q { a: i32, b: i32, c: i32, d: i32 }
struct T { x: Q, y: Q, o: Q }

#[inline(never)]
fn mix(q: &mut Q, r: &Q) {
    q.a = q.a + r.a * 3;
    q.b = q.b + r.b * 3;
    q.c = q.c + r.c * 3;
    q.d = q.d + r.d * 3;
}

#[inline(never)]
fn add4(t: &mut T) {
    t.o.a = t.x.a + t.y.a;
    t.o.b = t.x.b + t.y.b;
    t.o.c = t.x.c + t.y.c;
    t.o.d = t.x.d + t.y.d;
}

fn main() {
    let mut q = Q { a: 1, b: 2, c: 3, d: 4 };
    let r = Q { a: 5, b: 8, c: 11, d: 14 };
    mix(&mut q, &r);
    println(f"{q.a} {q.b} {q.c} {q.d}");
    let mut t = T {
        x: Q { a: 3, b: 4, c: 5, d: 6 }, y: Q { a: 4, b: 5, c: 6, d: 7 },
        o: Q { a: 0, b: 0, c: 0, d: 0 }
    };
    add4(&mut t);
    println(f"{t.o.a} {t.o.b} {t.o.c} {t.o.d}");
    for i in 0..2 {
        let mut u = T {
            x: Q { a: 4, b: 5, c: 6, d: 7 }, y: Q { a: 5, b: 6, c: 7, d: 8 },
            o: Q { a: 0, b: 0, c: 0, d: 0 }
        };
        add4(&mut u);
        let mut v = Q { a: 2, b: 3, c: 4, d: 5 };
        let w = Q { a: 6, b: 9, c: 12, d: 15 };
        mix(&mut v, &w);
        if i == 1 {
            println(f"{u.o.a} {u.o.b} {u.o.c} {u.o.d} | {v.a} {v.b} {v.c} {v.d}");
        }
    }
}
