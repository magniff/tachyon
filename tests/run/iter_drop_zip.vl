// 0.25: zip: when one side ends, the item the other gave is dropped, and
// the rest of an owning side drops with the Zip.
// FLAGS: --check-alloc
// EXPECT: pairs 2
// EXPECT: zip: made 5 dropped 5
// EXPECT: pairs 2
// EXPECT: pop: made 11 dropped 11
static var MADE: i64 = 0;
static var DROPS: i64 = 0;
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { DROPS += 1; } }
impl Eq for D { fn eq(self, o: Self) -> bool { self.id == o.id } }
impl Ord for D { fn cmp(self, o: Self) -> i64 { self.id - o.id } }

fn mk(id: i64, gpa: Gpa) -> D {
    MADE += 1;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

// Makes D 1, 2, ..., n, one per call to next.
struct Gen { n: i64, k: i64, gpa: Gpa }

impl Iterator for Gen {
    type Item = D;

    fn next(inout self) -> Option<D> {
        if self.k >= self.n { return None; }
        self.k += 1;
        Some(mk(self.k, self.gpa))
    }
}

fn gen(n: i64, gpa: Gpa) -> Gen { Gen { n: n, k: 0, gpa: gpa } }
// Owns D 1..n (pops n first): the ones it has not given out drop with it.
struct Pop { v: Vec<D> }

impl Iterator for Pop {
    type Item = D;
    fn next(inout self) -> Option<D> { self.v.pop() }
}

fn pop(n: i64, gpa: Gpa) -> Pop {
    var v: Vec<D> = Vec::new_in(gpa);
    for i in 1..=n { v.push(mk(i, gpa)); }
    Pop { v: v }
}

fn report(what: [u8]) {
    println(f"{what}: made {MADE} dropped {DROPS}");
}

fn main(gpa: Gpa) {
    var n = 0;
    for (a, b) in gen(3, gpa).zip(gen(2, gpa)) { n += a.id * 0 + b.id * 0 + 1; }
    println(f"pairs {n}");
    report("zip");
    let k = pop(4, gpa).zip(gen(2, gpa)).count();
    println(f"pairs {k}");
    report("pop");
}
