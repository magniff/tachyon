// EXPECT: 2 8
// (0.25) std::arch named only through a `use` of the module itself, then
// `arch::NAME`: the intrinsic tables are loaded (arch/virtual.vl,
// arch_names_std).
mod a {
    use std::arch;

    pub fn f() -> i64 { arch::count_ones(5) }
}

fn main() {
    std::println(f"{a::f()} {a::f() * 4}");
}
