// sem-own: Vec<D>::clone clones each element: both dropped once.
// EXPECT: 2 2
// EXPECT: end
// EXPECT: drop 11
// EXPECT: drop 12
// EXPECT: drop 1
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
impl Clone for D { fn clone(self) -> D { D { id: self.id + 10, v: self.v.clone() } } }

fn main(gpa: Gpa) {
    var v: Vec<D> = Vec::new_in(gpa);
    v.push(mk(1, gpa));
    v.push(mk(2, gpa));
    let w = v.clone();
    println(f"{v.len()} {w.len()}");
    println("end");
}
