// A pattern on a reference binds references (0.18.1): `n + 1` and `3 < n`
// with `n: &i64` say to read through it, with the exact fix (`*n`).
// ERROR: try: *n
// ERROR: try: 3 < *n
enum E { A(i64), B }

fn f(e: &E) -> i64 { match e { E::A(n) => n + 1, E::B => 0 } }

fn g(e: &E) -> bool { match e { E::A(n) => 3 < n, E::B => false } }

fn main() {}
