// (0.25 semantics audit, views) A static holds only views of constant
// data (string literals): storing a view of a String into a `static var`
// (directly, into an element of a static array, or in a function that
// stores its parameter there) is own.escape (or own.static). It is
// accepted, and the static is read after the String grew: a use after
// free.
// XFAIL: SOUNDNESS a static var may hold a view of a local String: use after free
// ERROR: error[own.
static var K: str = "";
fn keep(w: str) { K = w; }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    keep(s.as_str());
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(K);
    0
}
