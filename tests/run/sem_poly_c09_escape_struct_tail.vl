// a closure borrowing a block's var escapes inside a struct literal at the block's tail
// ERROR: [type error]: this value holds a closure that borrows 'n', which does not
struct H<F> { f: F }

fn main() {
    let h = {
        var n = 3;
        n += 1;
        H { f: || n }
    };
    println(f"{(h.f)()}");
}
