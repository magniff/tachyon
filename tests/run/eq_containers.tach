// `==` on Vec, Buf and HashMap compares contents (0.15, as Rust's): Vecs
// element by element, a Buf by bytes, maps by their entries in any order;
// a derived Eq over such fields too. Identity is a comparison of pointers.
// EXPECT: true false true true true true
// EXPECT: false false false true
// EXPECT: true false
use std::{Buf, HashMap};

#[derive(Eq, Clone)]
struct R { v: Vec<i64>, n: [u8] }

fn main(gpa: Gpa) {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let w = v.clone();
    let mut b = Buf::new_in(gpa);
    b.push_str("ab");
    let mut c = Buf::new_in(gpa);
    c.push_str("ab");
    let mut m: HashMap<[u8], i64> = HashMap::new_in(gpa);
    m.insert("a", 1);
    m.insert("b", 2);
    let mut n: HashMap<[u8], i64> = HashMap::new_in(gpa);
    n.insert("b", 2);
    n.insert("a", 1);
    let r = R { v: v.clone(), n: "x" };
    let mut vs: Vec<[u8]> = Vec::new_in(gpa);
    vs.push("q");
    let mut ws: Vec<[u8]> = Vec::new_in(gpa);
    ws.push("q");
    println(f"{v == w} {v != w} {b == c} {m == n} {r == r.clone()} {vs == ws}");
    n.insert("c", 3);
    let mut u: Vec<i64> = Vec::new_in(gpa);
    u.push(1);
    let mut s = r.clone();
    s.v.push(3);
    c.push_str("c");
    println(f"{m == n} {v == u} {s == r} {b != c}");
    // the same Vec: its elements' address
    println(f"{v.as_slice().ptr == v.as_slice().ptr} {v.as_slice().ptr == w.as_slice().ptr}");
}
