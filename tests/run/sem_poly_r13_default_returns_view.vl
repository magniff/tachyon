// a default method returning a view of self: the result views the receiver
// ERROR: [own.conflict]: 's.v.push(i)' may change 's' while 'h'
trait H {
    fn data(self) -> [i64];
    fn head(self) -> [i64] { self.data()[0..1] }
}

struct S { v: Vec<i64> }
impl H for S { fn data(self) -> [i64] { self.v.as_slice() } }

fn main(gpa: Gpa) {
    var s = S { v: Vec::new_in(gpa) };
    s.v.push(1);
    let h = s.head();
    for i in 0..100 { s.v.push(i); }
    println(f"{h[0]}");
}
