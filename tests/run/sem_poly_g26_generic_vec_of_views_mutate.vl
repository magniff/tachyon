// a generic collecting views into a Vec<T>: the source grown while the Vec lives
// ERROR: [own.conflict]
// XFAIL: OVERSTRICT var r = Vec::new_in(gpa); r.push(a); r in a generic: T not inferred from the push or the result
fn two<T>(a: sink T, gpa: Gpa) -> Vec<T> { var r = Vec::new_in(gpa); r.push(a); r }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let vs = two(v.as_slice(), gpa);
    for i in 0..100 { v.push(i); }
    println(f"{vs[0][0]}");
}
