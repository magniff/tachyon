// A guarded index of an array parameter, in a function.
// FLAGS: -O2
// EXPECT: 0
static var Z: i64 = 0;

#[inline(never)]
fn f(a: [i64; 3], i: i64, n: i64) -> i64 {
    var t = 0;
    var k = 0;
    while k < n { if k > 100 { t += a[i]; } k += 1; }
    t
}

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    let i = -1099511627776 + Z;
    let a = [1, 2, 3];
    println(f(a, i, 5 + Z));
    0
}
