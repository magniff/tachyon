// Compile-time constants: declared in any order, with arithmetic, casts and
// bit operations, usable as array sizes and repeat counts. Constant
// arithmetic wraps like run-time arithmetic.
// EXPECT: 40 8 5 40 268435455 -128 18446744073709551615 4 0.50 1.50 1 99
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

const AREA: i64 = WIDTH * HEIGHT;
const WIDTH: i64 = 1 << 3;
const HEIGHT: i64 = WIDTH / 2 + 1;
const MASK: u32 = ~0u32 >> 4;
const NEG: i8 = -(100 + 28);
const BIG: u64 = 0xFFFF_FFFF_FFFF_FFFF;
const WRAP: u8 = 250 + 10;
const HALF: f64 = 1.0 / 2.0;
const SCALE: f32 = HALF as f32 * 3.0;
const ON: bool = AREA > 30 && WIDTH != 0;
const CH: u8 = 'a' + 2;

fn main() -> i64 {
    let cells: [i64; AREA] = [1; AREA];
    let mut total = 0;
    for i in 0..AREA { total += cells[i]; }
    let _row: [u8; 5] = [0u8; WIDTH as u64 - 3];
    unsafe {
        printf(
            c"%ld %ld %ld %ld %u %d %lu %d %.2f %.2f %d %d\n",
            AREA, WIDTH, HEIGHT, total, MASK, NEG as i32, BIG, WRAP as i32, HALF, SCALE, ON as i32,
            CH as i32,);
    }
    0
}
