// 0.18.1: Vec's contains, first, retain and sort_by_key (stable, its
// buffer from the Vec's allocator), a slice's contains, `(a..b).rev()`;
// owned elements retain drops once (--check-alloc).
// FLAGS: --check-alloc
// EXPECT: true false true 5
// EXPECT: [5, 3, 1, 9]
// EXPECT: 43210543 10 60
// EXPECT: adbc
// EXPECT: bcad
// EXPECT: 4 1 5
// EXPECT: true false
// EXPECT: true false
struct P { name: [u8], n: i64 }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    for x in [5, 3, 8, 1, 9, 2] { v.push(x); }
    println(f"{v.contains(8)} {v.contains(7)} {v.as_slice().contains(1)} {v.first().unwrap()}");
    v.retain(|x| x % 2 == 1);
    println(f"{v:?}");
    var s = Buf::new_in(gpa);
    for i in (0..5).rev() { s.push_int(i); }
    for i in (3u8..6u8).rev() { s.push_int(i as i64); }
    let c = (0..10).rev().count();
    let t: i64 = (1..4).rev().map(|x| x * 10).sum();
    println(f"{s} {c} {t}");
    var ps: Vec<P> = Vec::new_in(gpa);
    ps.push(P { name: "b", n: 2 }); ps.push(P { name: "a", n: 1 }); ps.push(P { name: "c", n: 2 });
    ps.push(P { name: "d", n: 1 });
    ps.sort_by_key(|p| p.n);
    for p in ps.iter() { print(p.name); }
    println("");
    ps.sort_by_key(|p| (-p.n, p.name));
    for p in ps.iter() { print(p.name); }
    println("");
    var vs: Vec<Vec<i64>> = Vec::new_in(gpa);
    for k in 0..6 { var x: Vec<i64> = Vec::new_in(gpa); x.push(k); vs.push(x); }
    vs.retain(|x| x[0] % 3 != 0);
    println(f"{vs.len()} {vs[0][0]} {vs[3][0]}");
    let e: Vec<i64> = Vec::new_in(gpa);
    println(f"{e.first().is_none()} {e.contains(1)}");
    var words: Vec<[u8]> = Vec::new_in(gpa);
    words.push("x"); words.push("yy");
    println(f"{words.contains("yy")} {words.contains("z")}");
    0
}
