// The syntax of 0.18 (phase 0: read and kept, not checked yet;
// docs/design/contracts-verification.md): requires/ensures clauses, an
// invariant after a struct and an enum, `type X = distinct T`, and the test
// attributes. The program runs as if they were not there.
// EXPECT: 7
// EXPECT: 3
// EXPECT: 12
// EXPECT: 2

struct Stack { items: [i64; 8], len: i64, max: i64 }
invariant self.len <= self.max else "a stack holds at most max items"

enum Level { Low, High }
debug invariant true

type NodeId = distinct i64;
type Percent = distinct i64 invariant 0 <= self && self <= 100;

fn push(s: *Stack, x: i64)
    requires s.len < s.max else "push on a full stack"
    ensures s.len == old(s.len) + 1
{
    unsafe {
        (*s).items[(*s).len] = x;
        (*s).len += 1;
    }
}

fn top(s: *Stack) -> i64
    requires s.len > 0
    debug requires s.len <= 8
    ensures result == s.items[s.len - 1]
{
    unsafe { (*s).items[(*s).len - 1] }
}

trait Sized2 {
    fn size2(self: *Self) -> i64 ensures result >= 0;
}

impl Sized2 for Stack {
    fn size2(self: *Stack) -> i64 ensures result == self.len {
        unsafe { (*self).len }
    }
}

fn next_id(n: NodeId) -> NodeId requires n >= 0 {
    n + 1
}

#[test]
fn pushes_one() {
    let mut s = Stack { items: [0; 8], len: 0, max: 8 };
    push(&s, 4);
}

#[property]
fn any_id(n: i64) {}

#[fuzz]
fn any_bytes(data: [u8]) {}

#[cfg(test)]
mod tests {
    #[test]
    fn two() {}
}

fn main() -> i32 {
    let mut s = Stack { items: [0; 8], len: 0, max: 8 };
    push(&s, 3);
    push(&s, 7);
    std::print_int(top(&s));
    println("");
    let p: Percent = 3;
    std::print_int(p);
    println("");
    let id: NodeId = 11;
    std::print_int(next_id(id));
    println("");
    std::print_int(s.size2());
    println("");
    0
}
