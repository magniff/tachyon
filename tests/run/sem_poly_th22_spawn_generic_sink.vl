// a generic function spawning a thread with a T: instantiated with a view type
// ERROR: [sync.borrow_escapes]: 'thread::spawn' moves 'x'
use std::thread;

fn go<T>(x: sink T) -> i64 {
    let h = thread::spawn(sink || { let y = x; 1 });
    h.join()
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    println(f"{go(v.as_slice())}");
}
