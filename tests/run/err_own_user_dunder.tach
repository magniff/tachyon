// 0.17 (value semantics): the own pass leaves the checker's own locals
// (an f-string's `__out`, a derived impl's `__f`) out of its reports by
// where they are bound, never by name: a program's own `__` locals are
// checked like any other.
// FLAGS: --values=error
// ERROR: '__out.push(2)' may change '__out' while '__t'
// ERROR: '__v' is read while '__r'
fn bump(__p: &mut i64) { *__p += 1; }

fn main(gpa: Gpa) {
    let mut __out: Vec<i64> = Vec::new_in(gpa);
    __out.push(1);
    let __t = __out.as_slice();
    __out.push(2);
    let n = format_in(f"{__out.len()}", gpa);
    println(f"{__t[0]} {n}");
    let mut __v = 1;
    let __r = &mut __v;
    let c = __v + 1;
    bump(__r);
    println(f"{c}");
}
