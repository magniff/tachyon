// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: closure captures v by access, then push
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let c = || v[0];
    v.push(2);
    println(c());
    0
}
