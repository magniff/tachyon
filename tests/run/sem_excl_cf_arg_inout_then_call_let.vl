// XFAIL: WRONG conventions §3 says f(&a, a.len()) conflicts; reads of a in later arguments are accepted (benign: they end before the call)
// ERROR: own.conflict
fn n(v: Vec<i64>) -> i64 { v.len() }
fn add(a: inout Vec<i64>, b: i64) { a.push(b); }
fn main(gpa: Gpa) { var v: Vec<i64> = Vec::new_in(gpa); add(&v, n(v)); println(f"{v.len()}"); }
