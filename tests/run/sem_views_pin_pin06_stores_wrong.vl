// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.views: pinned stores() but stores a view of w
// ERROR: error[own.views]
#[stores()]
fn keep(out: inout Vec<[u8]>, w: [u8]) { out.push(w); }
fn main(gpa: Gpa) -> i32 { var o: Vec<[u8]> = Vec::new_in(gpa); keep(&o, "x"); println(o.len()); 0 }
