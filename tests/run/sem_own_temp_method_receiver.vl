// sem-own: an owned temporary as a method receiver (let self): dropped after the statement.
// EXPECT: drop 1
// EXPECT: len 1
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
impl D { fn len(self) -> i64 { self.v.len() } }

fn main(gpa: Gpa) {
    let n = mk(1, gpa).len();
    println(f"len {n}");
    println("end");
}
