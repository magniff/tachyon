// a sink closure capturing an inout parameter: its changes are its own (a snapshot), the caller's v unchanged
// ERROR: [own.move_out]
fn f(v: inout Vec<i64>) -> i64 {
    let c = sink || { v.push(9); v.len() };
    c()
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    println(f"{f(&v)} {v.len()}");
}
