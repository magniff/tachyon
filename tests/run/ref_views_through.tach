// Views through references (0.18.1, the eval's task 15): a view taken
// through a reference local or a pattern's reference binding (`s` of
// `match o { O::Str(s) => s.as_slice() }`) views what it points to, not
// the reference: it may be returned, stored or kept after the binding's
// scope. A place where `&T` is expected is borrowed (`unknown(it)` for
// `it` of `iter()`), `&&T` reads through to `&T` (receivers too), and
// `cmp_of(x, y)` of slices infers T.
// EXPECT: 1
// EXPECT: 1
// EXPECT: 25 -1 3
enum Opnd { Col(Vec<u8>), Int(i64) }
enum Cond { Cmp(Opnd, i64, Opnd), Not(i64) }
enum P { Cmp([u8], i64, [u8]), Not(i64) }
struct Q { conds: Vec<Cond> }

fn res(o: Opnd) -> Result<[u8], i64> {
    match o { Opnd::Col(n) => Ok(n.as_slice()), Opnd::Int(_) => Err(1) }
}

fn plan(q: Q, gpa: Gpa) -> Result<Vec<P>, i64> {
    var out: Vec<P> = Vec::new_in(gpa);
    for i in 0..q.conds.len() {
        let pc = match q.conds[i] {
            Cond::Not(a) => P::Not(a),
            Cond::Cmp(l, c, r) => {
                let pl = res(l)?;
                let pr = res(r)?;
                P::Cmp(pl, c, pr)
            }
        };
        out.push(pc);
    }
    Ok(out)
}

fn names(cs: Vec<Cond>, i: i64, out: inout Vec<[u8]>) {
    match cs[i] {
        Cond::Cmp(Opnd::Col(n), _, _) => out.push(n.as_slice()),
        _ => {}
    }
}

struct S { v: Vec<u8> }
enum O { Str(Vec<u8>), Int(i64) }
fn f1(o: S) -> [u8] { let s = o.v; s.as_slice() }
fn f2(o: O) -> [u8] { match o { O::Str(s) => s.as_slice(), O::Int(_) => "" } }
struct Item { name: [u8], qty: i64 }
enum Val { Str([u8]), Int(i64) }
struct Table { rows: Vec<i64> }
impl Table { fn cell(self, i: i64) -> i64 { self.rows[i] } }
fn unknown(it: Item) -> i64 { it.qty }

fn cmpv(a: Val, b: Val) -> i64 {
    match (a, b) {
        (Val::Str(x), Val::Str(y)) => cmp_of(x, y),
        (Val::Int(x), Val::Int(y)) => x - y,
        _ => 0,
    }
}

fn total(t: Table) -> i64 { t.cell(0) }

fn run(t: Table, items: Vec<Item>) -> i64 {
    var s = 0;
    for it in items.iter() { s += unknown(it); }
    let tr = t;
    s += tr.cell(0);
    s += total(tr);
    s + items.len()
}

fn main(gpa: Gpa) {
    var v: Vec<u8> = Vec::new_in(gpa);
    v.push('a');
    var cs: Vec<Cond> = Vec::new_in(gpa);
    cs.push(Cond::Cmp(Opnd::Col(v), 3, Opnd::Int(1)));
    let q = Q { conds: cs };
    match plan(q, gpa) { Ok(p) => println(p.len()), Err(e) => println(e) }
    var o: Vec<[u8]> = Vec::new_in(gpa);
    names(q.conds, 0, &o);
    println(o.len());
    var items: Vec<Item> = Vec::new_in(gpa);
    items.push(Item { name: "a", qty: 2 });
    var r: Vec<i64> = Vec::new_in(gpa);
    r.push(11);
    let t = Table { rows: r };
    let a = Val::Str("a");
    let b = Val::Str("b");
    let s = S { v: Vec::new_in(gpa) };
    let e = O::Str(Vec::new_in(gpa));
    let n = cmpv(Val::Int(5), Val::Int(2)) + f1(s).len() + f2(e).len();
    println(f"{run(t, items)} {cmpv(a, b)} {n}");
}
