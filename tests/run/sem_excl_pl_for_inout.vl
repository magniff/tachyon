// XFAIL: DIAG for inout is not built yet (D18); the parser says "'inout' is a keyword ... a name cannot be spelled so"
// EXPECT: 11 12 13
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa); v.push(1); v.push(2); v.push(3);
    for inout x in &v { x += 10; } println(f"{v[0]} {v[1]} {v[2]}");
}
