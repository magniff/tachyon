// a struct of a Mutex and an atomic shared by let with scoped threads
// FLAGS: --check-alloc
// EXPECT: 2000 2000
use std::thread;
use std::sync::Mutex;
use std::sync::atomic::{AtomicI64, Ordering};
struct St { m: Mutex<i64>, a: AtomicI64 }

fn main() {
    let st = St { m: Mutex::new(0), a: AtomicI64::new(0) };
    thread::scope(|s| {
        for _ in 0..4 {
            s.spawn(|| {
                for _ in 0..500 { st.m.with(|n| n += 1); st.a.fetch_add(1, Ordering::Relaxed); } 0
            });
        }
        0
    });
    println(f"{st.m.with(|n| n)} {st.a.load(Ordering::SeqCst)}");
}
