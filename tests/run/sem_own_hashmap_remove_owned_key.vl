// sem-own: remove(key: sink K) of an owned key: the key argument and the stored key each dropped once.
// EXPECT: drop 1
// EXPECT: drop 1
// EXPECT: rem 5
// EXPECT: drop 5
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
use std::HashMap;
impl Eq for D { fn eq(self, other: D) -> bool { self.id == other.id } }
impl Hash for D { fn hash(self) -> u64 { self.id as u64 } }

fn main(gpa: Gpa) {
    var m: HashMap<D, D> = HashMap::new_in(gpa);
    m.insert(mk(1, gpa), mk(5, gpa));
    { let r = m.remove(mk(1, gpa)); if let Some(d) = r { println(f"rem {d.id}"); } }
    println("end");
}
