// A guarded Vec index in a while loop.
// FLAGS: -O2
// EXPECT: 0
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    let i = -1099511627776 + Z;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    var t = 0;
    var k = 0;
    while k < 5 + Z { if k > 100 { t += v[i]; } k += 1; }
    println(t);
    0
}
