// EXPECT: 123 -45 7 0 9223372036854775807 -9223372036854775808
// EXPECT: none: "" "-" "+" "12a" " 1" "1 " "9223372036854775808" "-9223372036854775809" "99999999999999999999"
// EXPECT: split: [a] [] [b] [] 4
// EXPECT: words: [a] [bb] [ccc] [d] 4
// EXPECT: none: 0 0
// EXPECT: trim: [x y] [] []
// EXPECT: scan: 3 [x] [rest of line] [] end
// 0.14: std's text helpers: parse_int (signs, overflow at both ends,
// anything else rejected), split (empty parts kept), split_whitespace,
// trim, and a Scanner mixing tokens and lines. (0.15: parse_int returns
// a Result.)
use std::{Scanner, parse_int, split_in, split_whitespace_in, trim};

fn show_parts(label: [u8], parts: Vec<[u8]>) {
    print(label);
    for p in parts.as_slice() {
        print(" [");
        print(p);
        print("]");
    }
    print(" ");
    std::print_int(parts.len());
    println("");
}

fn main(gpa: Gpa) -> i32 {
    for s in ["123", "-45", "+7", "-0", "9223372036854775807", "-9223372036854775808"] {
        std::print_int(parse_int(s).unwrap());
        print(if s[0] == '-' && s.len > 3 { "\n" } else { " " });
    }
    print("none:");
    for s in ["", "-", "+", "12a", " 1", "1 ", "9223372036854775808", "-9223372036854775809",
        "99999999999999999999"] {
        if parse_int(s).is_err() {
            print(" \"");
            print(s);
            print("\"");
        }
    }
    println("");

    let mut parts = split_in("a,,b,", ',', gpa);
    defer parts.free();
    show_parts("split:", parts);
    let mut words = split_whitespace_in("  a bb\tccc \r\n d ", gpa);
    defer words.free();
    show_parts("words:", words);
    let mut e1 = split_whitespace_in(" \t\n", gpa);
    defer e1.free();
    let mut e2 = split_whitespace_in("", gpa);
    defer e2.free();
    print("none: ");
    std::print_int(e1.len());
    print(" ");
    std::print_int(e2.len());
    println("");

    print("trim: [");
    print(trim(" \t x y\r\n"));
    print("] [");
    print(trim("   "));
    print("] [");
    print(trim(""));
    println("]");

    let mut sc = Scanner::new("  3 x rest of line\n\nlast");
    print("scan: ");
    std::print_int(sc.next_int().unwrap());
    print(" [");
    print(sc.next_token().unwrap());
    print("] [");
    print(trim(sc.next_line().unwrap()));
    print("] [");
    print(sc.next_line().unwrap());
    print("]");
    sc.next_line();
    println(if sc.next_line().is_none() && sc.next_token().is_none() { " end" } else { " more" });
    0
}
