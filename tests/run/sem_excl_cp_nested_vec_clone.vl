// a deep clone: the inner Vecs are independent too
// EXPECT: 1 1 2 9
fn main(gpa: Gpa) {
    var a: Vec<Vec<i64>> = Vec::new_in(gpa);
    var e: Vec<i64> = Vec::new_in(gpa); e.push(1); a.push(e);
    var b = a.clone();
    b[0].push(2); b[0][0] = 9;
    println(f"{a[0].len()} {a[0][0]} {b[0].len()} {b[0][0]}");
}
