// Value numbering: equal computations dominated by an equal one are
// reused, and a load after a store to the same place reads the stored
// value; stores through pointers that may alias are respected.
// EXPECT: 168 26 7 5 99
// CHECK-OPT: 1
// (0.17: #[inline(never)]: -O1 inlines small leaf functions)
// CHECK: fn twice:
// CHECK: mul
// CHECK-NOT: mul
// CHECK: ret
// CHECK: fn main:
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct P { x: i64, y: i64 }

#[inline(never)]
fn twice(a: i64, b: i64) -> i64 {
    let first = a * b;
    let second = b * a;
    first + second
}

fn fields(p: *P) -> i64 {
    (*p).x + (*p).y + (*p).x
}

fn through(p: *i64, q: *i64) -> i64 {
    *p = 7;
    *q = 5;
    *p
}

fn main() -> i32 {
    let mut s = P { x: 10, y: 10 };
    let a = twice(6, 7) * 2;
    let mut v: i64 = 0;
    let r = through(&v, &v);
    let mut w: i64 = 0;
    let t = through(&s.x, &w);
    s.y = 99;
    let alias = &s.y;
    unsafe { printf(c"%ld %ld %ld %ld %ld\n", a, fields(&s) - 99 - 7 + 10 + 9, t, r, *alias); }
    0
}
