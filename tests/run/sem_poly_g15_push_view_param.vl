// pushing a view T into a Vec<T> outliving the viewed Vec
// ERROR: [own.escape]: 'words' is used here, but 'v', which it views, was dropped
fn store<T>(dst: inout Vec<T>, x: sink T) { dst.push(x); }

fn main(gpa: Gpa) {
    var words: Vec<[i64]> = Vec::new_in(gpa);
    {
        var v: Vec<i64> = Vec::new_in(gpa);
        for i in 0..100 { v.push(i + 1000); }
        store(&words, v.as_slice());
    }
    var w: Vec<i64> = Vec::new_in(gpa);
    for i in 0..100 { w.push(i); }
    println(f"{words[0][5]}");
}
