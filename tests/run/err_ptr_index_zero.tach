// 0.17 (eval iteration 10): `out[0] = acc` with `out: *i64` a parameter
// meant `*out = acc`. `p[0]` on a pointer to anything but a Vec, a Buf or
// a slice is pointer arithmetic; through a borrow (a pointer parameter not
// `mut`) the error names `*p`, safe there, and its try: is the statement
// written with it (fix --suggested makes it), not `fix --only unsafe`.
// Through a raw pointer (a `mut` parameter) `*p` is unsafe too: the help
// names it, the try: still wraps. Other indices keep the old error.
// ERROR: indexing a pointer is unsafe pointer arithmetic; the value 'out' points to is `*out`
// ERROR: help: `out[0]` indexes memory from out, unchecked
// ERROR: try: *out = acc
// ERROR: fix --suggested
// ERROR: the value 'out' points to is `*out`
// ERROR: try: *out += 1
// ERROR: the value 'out' points to is `*out`
// ERROR: try: *out
// ERROR: the value 'p' points to is `*p`
// ERROR: try: (*p)
// ERROR: indexing a raw pointer is unsafe
// ERROR: the value p points to is `*p` (`*p = x` writes it), unsafe as well through a raw pointer
// ERROR: fix --only unsafe
// ERROR: indexing a raw pointer is unsafe
// ERROR-COUNT: 6
struct S { x: i64 }

fn parse_num(t: [u8], out: *i64) -> i64 {
    var acc: i64 = 0;
    for c in t {
        acc = acc * 10 + (c - 48) as i64;
    }
    out[0] = acc;
    out[0] += 1;
    out[0] * 2
}

fn field(p: S) -> i64 { p[0].x }

fn raw(p: sink * i64) { p[0] = 3; }

fn second(out: *i64) { out[1] = 2; }

fn main() -> i32 {
    var x: i64 = 0;
    parse_num("12", &x);
    0
}
