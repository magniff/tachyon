// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict x3
// ERROR: error[own.conflict]
struct E { name: [u8; 8], len: i64 }
fn nm(e: E) -> Option<[u8]> { Some(e.name[..e.len]) }
fn nt(e: E) -> (i64, [u8]) { (e.len, e.name[..e.len]) }
struct V { t: [u8] }
fn nv(e: E) -> V { V { t: e.name[..e.len] } }

fn main() -> i32 {
    var e = E { name: ['h', 'e', 'l', 'l', 'o', 0, 0, 0], len: 5 };
    let a = nm(e).unwrap();
    let (_, b) = nt(e);
    let c = nv(e);
    e.len = 0;
    println(f"{a} {b} {c.t}");
    0
}
