// a fn pointer whose result views its let argument: the Vec grown while the result is used
// ERROR: [own.conflict]: 'v.push(i)' may change 'v' while 's'
fn sl(d: Vec<i64>) -> [i64] { d.as_slice() }

fn main(gpa: Gpa) {
    let f: fn(Vec<i64>) -> [i64] = sl;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let s = f(v);
    for i in 0..1000 { v.push(i); }
    println(f"{s[0]}");
}
