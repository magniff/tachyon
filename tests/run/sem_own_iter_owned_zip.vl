// sem-own: zip of two owned-item iterators, the longer one's extra item: dropped once.
// XFAIL: OVERSTRICT `let w: Vec<(D, D)> = a.zip(b).collect_in(gpa)`: "cannot infer type parameter A of Zip::collect_in" (also BTreeIter::collect_in; Map, Enumerate infer)
// EXPECT: n 1
// EXPECT: drop 0
// EXPECT: drop 10
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let w: Vec<(D, D)> = (0..1)
        .map(|i| mk(i, gpa))
        .zip((0..2).map(|i| mk(10 + i, gpa)))
        .collect_in(gpa);
    println(f"n {w.len()}");
}
