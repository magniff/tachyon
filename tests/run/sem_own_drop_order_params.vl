// sem-own: a sink parameter is dropped at the function end, after the locals.
// EXPECT: body
// EXPECT: drop 3
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn f(a: sink D, b: sink D, gpa: Gpa) { let c = mk(3, gpa); println("body"); }

fn main(gpa: Gpa) {
    f(mk(1, gpa), mk(2, gpa), gpa);
    println("end");
}
