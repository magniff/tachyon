// EXIT: 101
// STDERR: index out of bounds: index 4, length 4
// EXPECT: 10
// 0.10: a lane index is checked.
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

fn lane_sum(v: v4i32, n: i64) -> i32 {
    let mut s: i32 = 0;
    for i in 0..n {
        s += v.lane(i);
    }
    s
}

fn main() -> i32 {
    let v = v4i32(1, 2, 3, 4);
    unsafe { printf(c"%d\n", lane_sum(v, 4)); }
    unsafe { printf(c"%d\n", lane_sum(v, 5)); }
    0
}
