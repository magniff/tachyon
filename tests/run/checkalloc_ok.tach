// FLAGS: --check-alloc --verify-effects
// EXPECT: [0, 1, 4, 9, 16] 30 [16, 9, 4, 1, 0]
// EXPECT: 100 4950 x=42
// EXPECT: 3
// EXPECT: live 0 true
// 0.16: --check-alloc runs a correct program as without it: std's
// containers (growth, clone, HashMap's rehashes, Buf, sort, split) on the
// checking Gpa, everything freed at the end.
fn main(gpa: Gpa) {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..5 {
        v.push(i * i);
    }
    let mut w = v.clone();
    w.as_slice().sort_by(|a: *i64, b: *i64| *b - *a);
    let total = v.iter().sum();
    println(f"{v:?} {total} {w:?}");
    let mut m: std::HashMap<i64, i64> = std::HashMap::new_in(gpa);
    for i in 0..100 {
        m.insert(i, i);
    }
    let mut keys = 0;
    for i in 0..100 {
        if m.get(i).is_some() {
            keys += i;
        }
    }
    let mut b = std::Buf::new_in(gpa);
    b.push_str("x=");
    b.push_int(42);
    println(f"{m.len()} {keys} {b.as_slice()}");
    let parts = std::split_in("a bb ccc", ' ', gpa);
    println(f"{parts.len()}");
    v.free();
    w.free();
    m.free();
    b.free();
    parts.free();
    println(f"live {gpa.live_blocks()} {gpa.check_leaks()}");
}
