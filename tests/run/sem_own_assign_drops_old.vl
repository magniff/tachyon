// sem-own: assigning a new owned value to a var drops the old one first (after evaluating the right side).
// EXPECT: make 2
// EXPECT: drop 1
// EXPECT: now 2
// EXPECT: end
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn mkp(id: i64, gpa: Gpa) -> D { println(f"make {id}"); mk(id, gpa) }

fn main(gpa: Gpa) {
    var a = mk(1, gpa);
    a = mkp(2, gpa);
    println(f"now {a.id}");
    println("end");
}
