// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.views: a trait's pinned views() binds the impl that returns a view of self
// ERROR: error[own.views]
trait G { #[views()] fn g(self) -> [u8]; }
struct L { src: [u8; 2] }
impl G for L { fn g(self) -> [u8] { self.src[..] } }
fn main() -> i32 { let l = L { src: ['a', 'b'] }; println(l.g()); 0 }
