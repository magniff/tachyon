// 0.6: name resolution order: the module's own items, then names imported
// by name, then `*` imports; two `*` imports of the same name are fine
// until it is used (and an explicit import settles it).
// EXPECT: 1 2 3
enum A { X, Y, Shared }
enum B { Z, W, Shared }
use A::*;
use B::*;
use B::Shared;

fn main() -> i32 {
    let x = match X { X => 1, _ => 0 };
    let w = match W { W => 2, _ => 0 };
    let s = match Shared { B::Shared => 3, _ => 0 };
    std::print_int(x);
    std::print(" ");
    std::print_int(w);
    std::print(" ");
    std::print_int(s);
    std::println("");
    0
}
