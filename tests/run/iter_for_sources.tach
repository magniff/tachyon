// `for` over std's iterator sources (0.14): a Vec by value and through a
// pointer, `v.iter()`, a HashMap's entries, keys and values, ranges as
// values (`a..b`, `a..=b`, partly used up by `next`), a user Iterator,
// a type with `iter`, and a generic function iterating whatever it
// is given.
// EXPECT: vec 3 4 5 | 30 40 50 | 4 5 6
// EXPECT: map 3030 3 30
// EXPECT: counter 1 2 3 4
// EXPECT: bag 3 4 5
// EXPECT: ranges 45 10 0 1 2 3 4 | 2 3 | 7 8 9 | 9
// EXPECT: u8 32640 256 1515
// EXPECT: generic 6 12 12 12 3
use std::HashMap;

struct Counter { n: i64, limit: i64 }

impl Iterator for Counter {
    type Item = i64;

    fn next(self: *Counter) -> Option<i64> {
        if self.n < self.limit {
            self.n += 1;
            Some(self.n)
        } else {
            None
        }
    }
}

struct Bag { items: Vec<i64> }

impl Bag {
    fn iter(self: *Bag) -> std::SliceIter<i64> {
        self.items.iter()
    }
}

fn total<I>(it: I) -> i64 {
    let mut s = 0;
    for x in it {
        s += x;
    }
    s
}

fn show(x: i64) {
    print(" ");
    std::print_int(x);
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    defer v.free();
    v.push(3);
    v.push(4);
    v.push(5);
    print("vec");
    for x in v {
        show(x);
    }
    print(" |");
    for x in &v {
        show(x * 10);
    }
    print(" |");
    for x in v.iter() {
        show(x + 1);
    }
    println("");

    let mut m: HashMap<i64, i64> = HashMap::new_in(gpa);
    defer m.free();
    m.insert(1, 10);
    m.insert(2, 20);
    let mut s = 0;
    for (k, x) in m {
        s += k * 1000 + x;
    }
    let mut ks = 0;
    for k in m.keys() {
        ks += k;
    }
    let mut vs = 0;
    for x in m.values() {
        vs += x;
    }
    print("map");
    show(s);
    show(ks);
    show(vs);
    println("");

    print("counter");
    let c = Counter { n: 0, limit: 4 };
    for x in c {
        show(x);
    }
    println("");

    print("bag");
    let b = Bag { items: v };
    for x in b {
        show(x);
    }
    println("");

    print("ranges");
    let mut t = 0;
    for x in (0..10) {
        t += x;
    }
    show(t);
    let r = 0..5;
    show(total(r) as i64);
    for x in r {
        show(x);
    }
    print(" |");
    let mut it = 1..4;
    it.next();
    for x in it {
        show(x);
    }
    print(" |");
    let mut inc = 6..=9;
    inc.next();
    for x in inc {
        show(x);
    }
    print(" |");
    let mut last = 8..=9;
    last.next();
    last.next();
    last.next();
    for x in last {
        show(100 + x);
    }
    show(last.start);
    println("");

    print("u8");
    let mut n = 0;
    for x in 0..=255u8 {
        n += x as i64;
    }
    show(n);
    let mut count = 0;
    for _ in 0u8..=255 {
        count += 1;
    }
    show(count);
    let mut tail = 0;
    let top = 250..=255u8;
    for x in top {
        tail += x as i64;
    }
    show(tail);
    println("");

    print("generic");
    show(total(1..4));
    show(total(v.iter()));
    show(total(v));
    show(total(v.as_slice()));
    show(total(Counter { n: 0, limit: 2 }));
    println("");
    0
}
