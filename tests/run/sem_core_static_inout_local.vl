// an inout local of a static, then the static written by name while it is alive.
// ERROR: own.static
struct Big { a: i64, b: i64, c: i64, d: i64 }

static var G: Big = Big { a: 1, b: 2, c: 3, d: 4 };

#[inline(never)]
fn poke() { G.a = 99; }

fn main() -> i32 {
    inout r = &G;
    r.a = 5;
    poke();
    println(r.a);
    0
}
