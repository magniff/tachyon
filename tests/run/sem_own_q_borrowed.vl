// (0.25) `?` on a borrowed copy (`v.last()?`, `s.get(i)?`, HashMap::get, in a
// closure, an arm, a loop, an early return; a struct payload): the payload
// borrows, as with unwrap or match; the element is dropped once, by its Vec.
// EXPECT: last 1 1
// EXPECT: first 1 1
// EXPECT: get 1 1
// EXPECT: inline 1 1
// EXPECT: closure 1 1
// EXPECT: arm 1 1
// EXPECT: loop 2 1
// EXPECT: early 1 1
// EXPECT: none 0 1
// EXPECT: il 1 1
// EXPECT: struct 2 2
// EXPECT: map 3 3
// EXPECT: live 0
use std::collections::HashMap;
static var LIVE: i64 = 0;
struct T { id: i64 }
fn mk(id: i64) -> T { LIVE += 1; T { id: id } }

impl Drop for T {
    fn drop(inout self) { LIVE -= 1; }
}

struct P { a: T, b: Vec<i64> }

fn q_last(v: Vec<T>) -> Option<i64> { let t = v.last()?; Some(t.id) }
fn q_first(v: Vec<T>) -> Option<i64> { let s = v.as_slice(); let t = s.get(0)?; Some(t.id) }
fn q_get(v: Vec<T>) -> Option<i64> { let t = v.as_slice().get(0)?; Some(t.id) }
fn q_inline(v: Vec<T>) -> Option<i64> { Some(v.last()?.id) }

fn q_closure(v: Vec<T>) -> i64 {
    let f = || -> Option<i64> { let t = v.last()?; Some(t.id) }; f().unwrap_or(0)
}

fn q_struct(v: Vec<P>) -> Option<i64> { let p = v.last()?; Some(p.a.id) }

fn q_arm(v: Vec<T>, k: i64) -> Option<i64> {
    match k { 0 => { let t = v.last()?; Some(t.id) }, _ => None }
}

fn q_loop(v: Vec<T>) -> Option<i64> {
    var s = 0;
    var i = 0;
    while i
        < 3 {
        i += 1; let t = v.as_slice().get(0)?; if t.id == 9 { continue; } s += t.id;
        if i == 2 { break; }
    }
    Some(s)
}

fn q_early(v: Vec<T>) -> Option<i64> {
    if v.len() > 0 { let t = v.last()?; return Some(t.id); } None
}

fn q_none(v: Vec<T>) -> Option<i64> { let t = v.as_slice().get(5)?; Some(t.id) }
fn il(v: Vec<T>) -> i64 { if let Some(t) = v.last() { t.id } else { 0 } }
fn q_map(m: HashMap<i64, T>) -> Option<i64> { let t = m.get(1)?; Some(t.id) }

fn run(gpa: Gpa) {
    var v: Vec<T> = Vec::new_in(gpa);
    v.push(mk(1));
    println(f"last {q_last(v).unwrap_or(0)} {LIVE}");
    println(f"first {q_first(v).unwrap_or(0)} {LIVE}");
    println(f"get {q_get(v).unwrap_or(0)} {LIVE}");
    println(f"inline {q_inline(v).unwrap_or(0)} {LIVE}");
    println(f"closure {q_closure(v)} {LIVE}");
    println(f"arm {q_arm(v, 0).unwrap_or(0)} {LIVE}");
    println(f"loop {q_loop(v).unwrap_or(0)} {LIVE}");
    println(f"early {q_early(v).unwrap_or(0)} {LIVE}");
    println(f"none {q_none(v).unwrap_or(0)} {LIVE}");
    println(f"il {il(v)} {LIVE}");
    var w: Vec<P> = Vec::new_in(gpa);
    w.push(P { a: mk(2), b: Vec::new_in(gpa) });
    println(f"struct {q_struct(w).unwrap_or(0)} {LIVE}");
    var m: HashMap<i64, T> = HashMap::new_in(gpa);
    m.insert(1, mk(3));
    println(f"map {q_map(m).unwrap_or(0)} {LIVE}");
}

fn main(gpa: Gpa) -> i32 { run(gpa); println(f"live {LIVE}"); 0 }
