// atomics shared by let between scoped threads
// FLAGS: --check-alloc
// EXPECT: 4000
use std::thread;
use std::sync::atomic::{AtomicI64, Ordering};

fn main() {
    let a = AtomicI64::new(0);
    thread::scope(|s| {
        for _ in 0..4 { s.spawn(|| { for _ in 0..1000 { a.fetch_add(1, Ordering::Relaxed); } 0 }); }
        0
    });
    println(f"{a.load(Ordering::SeqCst)}");
}
