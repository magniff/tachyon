// (0.17, T7) std on owned element types: std::swap exchanges bit for bit
// (it dropped and double-freed through its assignments), and
// the iterators' fold hands a closure the elements they read, as a for
// loop does (it was own.move_out inside std).
#[derive(Clone)]
struct N { v: Vec<i64> }

fn main(gpa: Gpa) -> i32 {
    var a = N { v: Vec::new_in(gpa) };
    var b = N { v: Vec::new_in(gpa) };
    b.v.push(1);
    std::swap(&a, &b);
    var xs: Vec<N> = Vec::new_in(gpa);
    xs.push(a.clone());
    let total = xs.iter().map(|n| n.v.len()).fold(0, |s, k| s + k);
    var ys: Vec<N> = Vec::new_in(gpa);
    for x in xs.iter() {
        ys.push(x.clone());
    }
    println(f"{total} {ys.len()} {b.v.len()}");
    0
}
// FLAGS: --check-alloc
// EXPECT: 1 1 0
