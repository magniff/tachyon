// (0.17, T7) std's Eq, Ord and Hash take `&Self` (eq_of, cmp_of, hash_of
// `&T`): `a.cmp(&a)`, `a == a` through one reference, a value compared
// with itself while borrowed. Derived impls take `&Self`; a hand-written
// impl with the legacy `*Self` is taken as the trait's `&Self`.
#[derive(Eq, Clone)]
struct P { name: Vec<i64>, n: i64 }
#[derive(Eq, Ord, Hash)]
struct R { a: i64, b: i64 }
struct Q { v: i64 }
impl std::Eq for Q { fn eq(self, other: Q) -> bool { self.v == other.v } }
impl std::Ord for Q { fn cmp(self, other: Q) -> i64 { self.v - other.v } }
fn same(a: R) -> bool { a.cmp(a) == 0 && a == a }

fn main(gpa: Gpa) -> i32 {
    var a = P { name: Vec::new_in(gpa), n: 1 };
    a.name.push(4);
    let b = a.clone();
    let p = &a;
    let e = a == b && std::eq_of(a, a) && p == &b;
    let r = R { a: 1, b: 2 };
    let s = R { a: 1, b: 3 };
    let c = r.cmp(r) + std::cmp_of(r, s) + s.cmp(r);
    let q = Q { v: 2 };
    let t = Q { v: 3 };
    println(f"{e} {c} {same(r)} {q == q} {q < t} {std::hash_of(r) == std::hash_of(r)}");
    0
}
// FLAGS: --check-alloc
// EXPECT: true 0 true true true true
