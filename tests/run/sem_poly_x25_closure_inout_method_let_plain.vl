// a closure calling an inout method on a captured plain let struct (captured by copy)
// ERROR: [own.readonly]
// XFAIL: WRONG a closure calling an inout method on a captured plain let changes the let (not a copy)
struct P { x: i64 }
impl P { fn bump(inout self) { self.x += 1; } }

fn main() {
    let p = P { x: 1 };
    let c = || { p.bump(); p.x };
    println(f"{c()} {c()} {p.x}");
}
