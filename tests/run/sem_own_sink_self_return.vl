// sem-own: a `sink self` method returning self: moves through, dropped once by the caller.
// EXPECT: got 9
// EXPECT: drop 9
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
impl D { fn with_id(sink self, n: i64) -> D { self.id = n; self } }

fn main(gpa: Gpa) {
    let a = mk(1, gpa).with_id(9);
    println(f"got {a.id}");
}
