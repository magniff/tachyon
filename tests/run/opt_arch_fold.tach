// EXPECT: 6673307777
// CHECK: fn main
// CHECK: = const 6673307777
// CHECK-NOT: = intr.
// CHECK-NOT: = vsplat
// CHECK: fn std.
// (0.19 T6) Constant vectors fold through std::arch's intrinsics, as the
// instructions compute (-O0 runs them: the same output): saturating and
// absolute differences, compares and the bitwise select they feed,
// permutes, bit counts and reversals, shifts, halving, reductions, lanes,
// and CRC-32/CRC-32C; the whole function is one constant.
use std::arch::aarch64::{
    __crc32cd, __crc32w, vabdq_u8, vaddq_u8, vaddvq_u8, vbslq_u8, vceqq_u8, vclzq_u8, vcntq_u8,
    vdupq_n_s16, vdupq_n_u8, vgetq_lane_u8, vhaddq_s16, vmaxvq_u8, vminvq_s16, vqaddq_u8,
    vqsubq_s16, vrbitq_u8, vshrq_n_s16, vshrq_n_u8, vzip1q_u8,
};

// Constant vectors fold through std::arch's intrinsics: nothing of this
// is computed at run time.
fn folded() -> u64 {
    let a = vdupq_n_u8(200);
    let b = vdupq_n_u8(100);
    let s = vqaddq_u8(a, b);
    let d = vabdq_u8(b, a);
    let m = vceqq_u8(s, vdupq_n_u8(255));
    let pick = vbslq_u8(m, d, a);
    let z = vzip1q_u8(pick, pick);
    let bits = vaddq_u8(vcntq_u8(vrbitq_u8(vdupq_n_u8(6))), vclzq_u8(vshrq_n_u8(b, 3)));
    let h = vhaddq_s16(vdupq_n_s16(-7), vqsubq_s16(vdupq_n_s16(-32768), vdupq_n_s16(5)));
    let r = vmaxvq_u8(z) as u64 * 1000000 + vgetq_lane_u8(bits, 3) as u64 * 10000
        + (vminvq_s16(vshrq_n_s16(h, 2)) as i64 + 10000) as u64 + vaddvq_u8(b) as u64;
    r + __crc32cd(0xffffffff, 0x1234567890) as u64 + __crc32w(7, 99) as u64
}

fn main() {
    println(f"{folded()}");
}
