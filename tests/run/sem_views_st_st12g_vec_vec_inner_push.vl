// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: inner Vec grown through vv[0] while a slice of it is used
// XFAIL: SOUNDNESS a view read out of a Vec of views by index loses the element's origin: use after free
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var vv: Vec<Vec<i64>> = Vec::new_in(gpa);
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    vv.push(v);
    let sl = vv[0].as_slice();
    for i in 0..100 { vv[0].push(i); }
    println(sl[0]);
    0
}
