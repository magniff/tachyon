// a scope's closure returns a view of a Vec made inside it
// ERROR: [own.escape]: 'closure(inout Scope) -> [i64]
use std::thread;

fn main(gpa: Gpa) {
    let s = thread::scope(|sc| {
        var v: Vec<i64> = Vec::new_in(gpa);
        v.push(4);
        let h = sc.spawn(|| 1);
        h.join();
        v.as_slice()
    });
    println(f"{s[0]}");
}
