// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) sync.borrow_escapes: a HashMap<str, i64> holding views, into a detached thread
// ERROR: error[sync.borrow_escapes]
use std::thread;

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var m: HashMap<str, i64> = HashMap::new_in(gpa);
    m.insert(s.as_str(), 1);
    let h = thread::spawn(sink || m.len());
    println(h.join());
    0
}
