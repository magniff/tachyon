// sem-own: a sink closure temporary given to a let parameter: its capture dropped once, after the call.
// XFAIL: OVERSTRICT+DIAG a sink closure literal given to a let F parameter: "expected 'let closure..', got 'closure..'", this value has no place
// EXPECT: 1
// EXPECT: drop 1
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn run<F: Fn() -> i64>(f: F) -> i64 { f() }

fn main(gpa: Gpa) {
    let d = mk(1, gpa);
    println(f"{run(sink || d.id)}");
    println("end");
}
