// 0.17: `&mut x` is `&x`: one pointer type, `*T`.
// EXPECT: 3 [1, 2]
fn bump(x: *i64) { *x += 1; }

fn add(v: *Vec<i64>, x: i64) { v.push(x); }

fn main(gpa: Gpa) -> i32 {
    let mut n = 1;
    bump(&mut n);
    bump(&n);
    let mut v: Vec<i64> = Vec::new_in(gpa);
    defer v.free();
    add(&mut v, 1);
    add(&mut v, 2);
    println(f"{n} {v:?}");
    0
}
