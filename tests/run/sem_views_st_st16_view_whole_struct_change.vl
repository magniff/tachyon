// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: view into p.name, then p replaced as a whole
// ERROR: error[own.conflict]
struct P { name: String, n: i64 }

fn main(gpa: Gpa) -> i32 {
    var p = P { name: String::from_in("hello", gpa), n: 1 };
    let w = p.name.as_str();
    p = P { name: String::from_in("bye", gpa), n: 2 };
    println(w);
    0
}
