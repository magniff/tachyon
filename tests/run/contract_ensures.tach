// (0.18) An ensures is checked at every return of the function (the tail,
// `return`, `?`), on the value returned (`result`); `old(e)` is e at
// entry. Its failure blames the function, at the clause.
// EXIT: 101
// EXPECT: 4
// EXPECT: 3
// EXPECT: 2
// STDERR: contract_ensures.tach:21:5: ensures failed: 'result <= n' of 'count_up': result = 9, n = 8

struct Counter { n: i64 }

fn bump(c: inout Counter, by: i64) -> i64
    ensures c.n == old(c.n) + by
    ensures result == c.n
{
    unsafe { c.n += by; c.n }
}

fn count_up(n: i64) -> i64
    ensures 0 <= result
    ensures result <= n
{
    if n > 7 {
        return n + 1;
    }
    n
}

fn half(x: i64) -> Option<i64>
    ensures result.is_some() || x % 2 == 1
{
    if x % 2 == 1 {
        return None;
    }
    Some(x / 2)
}

fn quarter(x: i64) -> Option<i64>
    ensures !result.is_some() || result.unwrap() * 4 <= x
{
    let h = half(x)?;
    half(h)
}

fn main() -> i32 {
    var c = Counter { n: 1 };
    bump(&c, 3);
    std::print_int(bump(&c, 0));
    println("");
    std::print_int(count_up(3));
    println("");
    std::print_int(quarter(8).unwrap());
    println("");
    let _ = quarter(6);
    std::print_int(count_up(8));
    0
}
