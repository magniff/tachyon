// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) sync.scope_write: s grown while a scoped thread reads views of it held in v
// ERROR: error[sync.scope_write]
use std::thread;
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var v: Vec<str> = Vec::new_in(gpa);
    v.push(s.as_str());
    let n = thread::scope(|sc| {
        let a = sc.spawn(|| v.get(0).len());
        s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
        a.join()
    });
    println(n);
    0
}
