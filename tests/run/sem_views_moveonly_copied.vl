// (0.25 semantics audit, views) A struct with an `inout` field is a
// move-only view: `var p2 = p` (or `let p2 = p`, or a sink argument) moves
// it, and p is dead until reassigned. Today p stays usable, so two
// exclusive accesses to v are live at once: a slice taken through p2
// survives p's pushes, a use after free.
// XFAIL: SOUNDNESS a move-only view (inout field) is copied, not moved: aliasing, use after free
// ERROR: error[own.moved]
struct P { q: inout Vec<i64> }
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    var p = P { q: &v };
    var p2 = p;
    let sl = p2.q.as_slice();
    for i in 0..100 { p.q.push(i); }
    println(sl[0]);
    0
}
