// 0.14: a closure that assigns what it captures is `FnMut`, not `Fn`.
// ERROR: the closure assigns to 'count', so it is not 'Fn' as the bound of 'F' of 'apply' asks
// ERROR-COUNT: 1
fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 {
    f(x)
}

fn main() -> i64 {
    let mut count = 0;
    apply(| x | {
        count += 1;
        x
    }, 1)
}
