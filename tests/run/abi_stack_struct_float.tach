// C calls a tachyon function whose struct argument goes on the stack
// (x86-64: no integer register left for its INTEGER eightbyte) and whose
// next argument is a float in the first float register: at -O0, copying
// the struct must not overwrite that register.
// CSOURCE: tests/c/abi_stack_struct_float.c
// EXPECT: 30.75
#[repr(C)]
struct Mixed { d: f64, i: i32 }

extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn c_call() -> f64;
}

extern "C" fn t_after_stack(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, m: Mixed, x: f64) -> f64 {
    (a + b + c + d + e + f) as f64 + m.d + m.i as f64 + x
}

fn main() -> i32 {
    printf(c"%.2f\n", c_call());
    0
}
