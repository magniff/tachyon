// XFAIL: SOUNDNESS f(v, || v.push(2)): a let argument changed during the call by a closure argument
// an owned var passed let while a closure argument changes it
// ERROR: own.conflict
fn f<F: FnMut()>(p: Vec<i64>, w: F) -> i64 { let before = p.len(); w(); before * 100 + p.len() }
fn main(gpa: Gpa) { var v: Vec<i64> = Vec::new_in(gpa); v.push(1); let r = f(v, || { v.push(2); }); println(f"{r} {v.len()}"); }
