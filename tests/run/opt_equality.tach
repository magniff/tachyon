// 0.11: equalities from branches (gvn.tach). Below `if a.len != b.len
// { return false; }` b.len is a.len, so the range analysis drops the
// check of b[i] in a loop over a's indices; below `if n == 3`, n is 3.
// EXPECT: 1 0 0 1
// EXPECT: 21 8
// CHECK: fn same:
// CHECK-NOT: rt.panic
// CHECK: fn scale:
// CHECK: const 21
// CHECK: fn main:
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

#[inline(never)]
fn same(a: [u8], b: [u8]) -> bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

#[inline(never)]
fn scale(n: i64, x: i64) -> i64 {
    if n == 3 {
        return n * 7;
    }
    n + x
}

fn main() -> i32 {
    unsafe {
        printf(c"%d %d %d %d\n", same("abc", "abc") as i32, same("abc", "abd") as i32,
            same("abc", "ab") as i32, same("", "") as i32);
        printf(c"%ld %ld\n", scale(3, 1), scale(4, 4));
    }
    0
}
