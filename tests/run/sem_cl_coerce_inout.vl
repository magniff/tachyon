// (0.25) A captured Vec or Buf given as an `inout [T]` (`bump(&v)`) inside
// a closure writes the captured container (it segfaulted: the coercion
// replaced the name the closure rewrites).
// EXPECT: 5 5 7
// EXPECT: 15 98
// EXPECT: 18
fn bump(s: inout [i64]) { s[0] += 5; }
fn up(s: inout [u8]) { s[0] = s[0] + 1; }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(0);
    var b = Buf::new_in(gpa);
    b.push_str("a");
    var a = [2, 0];
    {
        var f = || bump(&v);
        f();
    }
    var u: Vec<i64> = Vec::new_in(gpa);
    u.push(0);
    {
        var g = || bump(&u[..]);
        g();
    }
    {
        var h = || bump(&a);
        h();
    }
    {
        var k = || up(&b);
        k();
    }
    println(f"{v[0]} {u[0]} {a[0]}");
    {
        var f = || { bump(&v); bump(&v); };
        f();
    }
    println(f"{v[0]} {b[0]}");
    var mut_sink = sink || { bump(&v); bump(&v[..]); v[0] - 7 };
    println(f"{mut_sink()}");
}
