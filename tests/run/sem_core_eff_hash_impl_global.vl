// Hash is #[pure]: an impl reading a static var is rejected.
// ERROR: 'K::hash' implements 'Hash::hash', which is #[pure], but it uses a static (global)
static var SEED: u64 = 1;
struct K { n: i64 }
impl Hash for K { fn hash(self) -> u64 { SEED + self.n as u64 } }
impl Eq for K { fn eq(self, o: K) -> bool { self.n == o.n } }

fn main(gpa: Gpa) -> i32 {
    var m: HashMap<K, i64> = HashMap::new_in(gpa);
    m.insert(K { n: 1 }, 2);
    println(m.len());
    0
}
