// (0.17, T7) XFAIL until 0.17.1: an element of a Vec<[u8]> yielded by
// iter() is taken to view the Vec itself, not what its elements view:
// a declared #[views(self)] (Vec::iter) puts self at both levels of the
// result. Returning the element after the Vec is dropped is own.escape.
// The fix needs level-aware declarations (views(self) at level 1, *self
// at level 2) checked against split_in-like functions, whose results'
// elements do view their argument. lines.as_slice() and lines.get(0) work.
fn first(text: [u8], gpa: Gpa) -> [u8] {
    let lines = split_in(text, '\n', gpa);
    for line in lines.iter() { return line; }
    ""
}

fn main(gpa: Gpa) -> i32 { println(first("a\nb", gpa)); 0 }
// XFAIL: views(self) puts self at level 2 (0.17.1)
// EXPECT: a
