// a sink closure moving its capture out, called twice: stops the program (exit 101)
// R dropped exactly once
// FLAGS: --check-alloc
// EXPECT: drop 7
// EXIT: 101
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn eat(r: sink R) -> i64 { r.id }
fn call2<F: FnMut() -> i64>(f: sink F) -> i64 { f() + f() }

fn main() {
    let r = R { id: 7 };
    println(f"{call2(sink || eat(r))}");
}
