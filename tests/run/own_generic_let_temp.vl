// (0.24) A value given to a generic function's let parameter is a
// temporary of the statement, so that the instance, which borrows a
// non-copyable one, has a place to borrow (`gl(make())` was "this value
// has no place"); a copyable one is copied, as before. Dropped at the
// end of the statement (0.25; it was the block's), after an impure
// argument too.
// EXPECT: 1 1 5
// EXPECT: drop N
// EXPECT: end
struct N { v: Vec<i64> }

impl Drop for N {
    fn drop(inout self) { println("drop N"); }
}

fn make(gpa: Gpa) -> N {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(5);
    N { v: v }
}

fn gl<T>(x: T) -> i64 { 1 }

fn len_of<T>(x: Vec<T>) -> i64 { x.len() + 4 }

fn main(gpa: Gpa) {
    var e: Vec<i64> = Vec::new_in(gpa);
    e.push(1);
    let k = len_of(e.clone());
    println(f"{gl(make(gpa))} {gl(3)} {k}");
    println("end");
}
