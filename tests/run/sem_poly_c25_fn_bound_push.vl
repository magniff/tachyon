// a closure that changes a captured Vec through a method (push) given to an Fn bound
// ERROR: does not satisfy the bound
// XFAIL: WRONG a closure pushing to a captured Vec satisfies an Fn bound
fn apply<F: Fn()>(f: F) { f(); f(); }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    apply(|| v.push(1));
    println(f"{v.len()}");
}
