// matching an owned local by value moves its payload out (5.3): reassigning the scrutinee is fine
// EXPECT: 1
enum E { A(Vec<i64>), B }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa); v.push(1); var e = E::A(v);
    match e { E::A(w) => { e = E::B; println(f"{w.len()}"); } E::B => {} }
}
