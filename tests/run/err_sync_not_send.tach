// (0.21) A raw pointer may alias memory the spawning thread still uses.
// ERROR: 'thread::spawn' moves 'c' (Cache holds a raw pointer at '.slots' (*i64)) to another thread

use std::thread;

struct Cache { slots: *i64, n: i64 }

fn main() {
    let mut x = 3;
    let c = Cache { slots: &mut x as *i64, n: 1 };
    let h = thread::spawn(move || c.n);
    println(f"{h.join()}");
}
