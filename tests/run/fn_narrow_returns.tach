// Narrow return values are used at their own width by the caller.
// EXPECT: 44 -56 4464 4294967295 1
// EXPECT: 4 1
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn mk_u8(x: i64) -> u8 { x as u8 }
fn mk_i8(x: i64) -> i8 { x as i8 }
fn mk_i16(x: i64) -> i16 { x as i16 }
fn mk_u32(x: i64) -> u32 { x as u32 }
fn mk_bool(x: i64) -> bool { x > 0 }

fn main() -> i64 {
    unsafe {
        printf(c"%lu %ld %ld %lu %d\n", mk_u8(300) as u64, mk_i8(200) as i64, mk_i16(70000) as i64, mk_u32(0 - 1) as u64, mk_bool(5));
    }
    let s: u8 = mk_u8(250) + mk_u8(10);
    unsafe { printf(c"%d %d\n", s, mk_i8(255) < mk_i8(1)); }
    0
}
