// 0.16: a static can hold a container on an arena: `Vec::new_in(Arena::none())`
// is a constant (a constant constructor: its body is one struct literal),
// and main gives the static its arena. Constructors nest (`Buf::new_in`
// calls `Vec::new_in`), take arguments (`P::at(3, 4)`), and fill tuples
// and arrays.
// FLAGS: --no-ambient-gpa
// EXPECT: 0 0 0 7 3 4 9
// EXPECT: 3 nodes, 6 total; 2 names; text: a1b2
struct Node { id: i64, weight: i64 }

struct P { x: i64, y: i64 }

impl P {
    fn at(x: i64, y: i64) -> P {
        P { x: x, y: y }
    }
}

fn with_weight(p: P, k: i64) -> (P, i64) {
    (p, k * 2 + 1)
}

static mut ARENA: Arena = Arena::none();
static mut NODES: Vec<Node, Arena> = Vec::new_in(Arena::none());
static mut NAMES: std::HashMap<i64, [u8], Arena> = std::HashMap::new_in(Arena::none());
static mut TEXT: std::Buf<Arena> = std::Buf::new_in(Arena::none());
static mut PAIR: (i64, Vec<i64, Arena>) = (7, Vec::new_in(Arena::none()));
static mut PS: [P; 2] = [P::at(3, 4), P::at(5, 6)];
static mut T: (P, i64) = with_weight(P::at(3, 4), 4);

fn add(id: i64, weight: i64) {
    NODES.push(Node { id: id, weight: weight });
}

fn main(gpa: Gpa) {
    println(f"{NODES.len()} {NAMES.len()} {TEXT.len()} {PAIR.0} {PS[0].x} {PS[0].y} {T.1}");
    ARENA = Arena::new_in(gpa);
    NODES = Vec::new_in(ARENA);
    NAMES = std::HashMap::new_in(ARENA);
    TEXT = std::Buf::new_in(ARENA);
    add(1, 1);
    add(2, 2);
    add(3, 3);
    NAMES.insert(1, "one");
    NAMES.insert(2, "two");
    TEXT.push_str("a1");
    TEXT.push_str("b2");
    let mut total = 0;
    for n in NODES.as_slice() {
        total += n.weight;
    }
    println(f"{NODES.len()} nodes, {total} total; {NAMES.len()} names; text: {TEXT}");
}
