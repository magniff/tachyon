// (0.21) std::thread: eight threads at once, each counting into one
// atomic and returning a value its handle's join gives back; a thread that
// moved a Vec in; a handle dropped without join (detached); scope joining
// threads that read the caller's slice.
// EXPECT: 499500
// EXPECT: 800000 28
// EXPECT: scoped 499500 true
// EXPECT: cpus true

use std::thread;
use std::sync::atomic::{AtomicI64, Ordering};

static COUNT: AtomicI64 = AtomicI64 { v: 0 };

fn part(s: [i64]) -> i64 {
    var t = 0;
    for x in s { t += x; }
    t
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..1000 { v.push(i); }
    let w = v.clone();
    let h = thread::spawn(sink || part(w.as_slice()));
    println(f"{h.join()}");

    var hs: Vec<thread::JoinHandle<i64>> = Vec::new_in(gpa);
    for k in 0..8 {
        hs.push(thread::spawn(sink || {
            for _ in 0..100000 { COUNT.fetch_add(1, Ordering::Relaxed); }
            k
        }));
    }
    var ks = 0;
    while hs.len() > 0 { ks += hs.pop().unwrap().join(); }
    println(f"{COUNT.load(Ordering::SeqCst)} {ks}");

    let detached = thread::spawn(sink || 1);
    drop(detached);

    let s = v.as_slice();
    let n = s.len() / 2;
    let total = thread::scope(|sc| {
        let a = sc.spawn(|| part(s[0..n]));
        let b = sc.spawn(|| part(s[n..]));
        let c = sc.spawn(|| 0);
        drop(c);
        a.join() + b.join()
    });
    println(f"scoped {total} {v.len() == 1000}");
    println(f"cpus {thread::available_parallelism() >= 1}");
}
