// Reading and writing struct fields through a pointer with `(*p).f`.
// EXPECT: 1 3
// EXPECT: 3 12
// EXPECT: 5 60 7 60
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct P { x: i64, y: i64 }
struct Box { p: P, n: i32 }

fn bump(p: &mut P) {
    (*p).x = (*p).x + 1;
    (*p).y = (*p).y * 2;
}

fn main() -> i64 {
    let mut p = P { x: 1, y: 3 };
    let q = &mut p;
    unsafe {
        printf(c"%ld %ld\n", (*q).x, (*q).y);
        bump(&mut *q);
    }
    bump(&mut p);
    unsafe { printf(c"%ld %ld\n", p.x, p.y); }
    let b = Box { p: P { x: 5, y: 6 }, n: 7 };
    let pb = &mut b;
    unsafe { (*pb).p.y = 60; }
    let copy = unsafe { *pb };
    let inner = unsafe { (*pb).p };
    unsafe { printf(c"%ld %ld %d %ld\n", copy.p.x, copy.p.y, (*pb).n, inner.y); }
    0
}
