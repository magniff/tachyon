// 0.6: `defer` runs at scope exit, last first, on every way out: the end
// of the block, return, break and continue (labelled too); a returned or
// broken-out value is computed before the deferred statements run.
// EXPECT: 300 21
// EXPECT: -1 341
// EXPECT: 1 2 5 6
// EXPECT: 4042 66656665657
// EXPECT: 8
// EXPECT: block
// EXPECT: inner
extern "C" { fn printf(format: *u8, ...) -> i32; }

static var LOG: i64 = 0;

fn note(d: i64) {
    LOG = LOG * 10 + d;
}

struct P { a: i64, b: i64 }

fn early(x: i64) -> i64 {
    defer note(1);
    if x > 0 {
        defer note(2);
        return x * 100;
    }
    defer { note(3); note(4); }
    x
}

fn returns_struct() -> P {
    var p = P { a: 1, b: 2 };
    defer p.a = 99;
    p
}

fn returns_struct2() -> P {
    var p = P { a: 5, b: 6 };
    defer { p.b = 77; }
    return p;
}

fn loops() -> i64 {
    var total = 0;
    outer: for i in 0..4 {
        defer note(5);
        var j = 0;
        while j < 3 {
            defer note(6);
            j += 1;
            if j == 2 { continue; }
            if i == 2 { break :outer; }
            total += 1;
        }
    }
    let v = loop {
        defer note(7);
        break 42;
    };
    total * 1000 + v
}

fn value_before(x: i64) -> i64 {
    var y = x;
    defer y = 0;
    y
}

fn main() -> i32 {
    LOG = 0;
    let a = early(3);
    unsafe { printf(c"%ld %ld\n", a, LOG); }
    LOG = 0;
    let b = early(-1);
    unsafe { printf(c"%ld %ld\n", b, LOG); }
    let p = returns_struct();
    let q = returns_struct2();
    unsafe { printf(c"%ld %ld %ld %ld\n", p.a, p.b, q.a, q.b); }
    LOG = 0;
    let l = loops();
    unsafe {
        printf(c"%ld %ld\n", l, LOG);
        printf(c"%ld\n", value_before(8));
    }
    {
        defer unsafe { printf(c"inner\n") };
        unsafe { printf(c"block\n"); }
    }
    0
}
