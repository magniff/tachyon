// f-strings (0.15): every part of a spec, `{{` and `}}`, and the Display
// and Debug of std's numbers, bool and text.
// EXPECT: [    42] [42    ] [    42] [tach  ] [  tach] [tach  ]
// EXPECT: [000042] [-00042] [   -42] [-42   ] [000]
// EXPECT: ff FF 101 A 65 ff fffffffe FFFFFFFE 0   101010|
// EXPECT: [3.14] [   3.142] [3.1     ] [00003.14] [ta] [ta   ] [3]
// EXPECT: {} {42} }{
// EXPECT: -128 -32768 2147483647 -9223372036854775808 65535 4294967295 18446744073709551615 ffffffffffffffff
// EXPECT: 1 1.5 0.3333333333333333 1000000000000000000000 0.000001 -0 0.1 0.30000000000000004
// EXPECT: 1.0 1.5 1e16 1000000000000000.0 1e-6 0.0001 -0.0 0.1 2.5e-8
// EXPECT: NaN inf -inf NaN
// EXPECT: true true  false| "a\"b\\c\nd\te\u{1}" ""
// EXPECT: plain
// EXPECT: 42
fn main() {
    let n = 42;
    let neg = -42;
    let name = "tach";
    // width and alignment: numbers right, text left by default
    println(f"[{n:6}] [{n:<6}] [{n:>6}] [{name:6}] [{name:>6}] [{name:<6}]");
    // zero padding, after the sign
    println(f"[{n:06}] [{neg:06}] [{neg:6}] [{neg:<6}] [{0:03}]");
    // hex, upper hex, binary, a byte
    let b: u8 = 65;
    let m: i8 = -1;
    let w: i32 = -2;
    println(f"{255:x} {255:X} {5:b} {b:c} {b} {m:x} {w:x} {w:08X} {0:x} {n:>8b}|");
    // precision: decimals of a float, characters of text
    let pi = 3.14159265;
    println(f"[{pi:.2}] [{pi:8.3}] [{pi:<8.1}] [{pi:08.2}] [{name:.2}] [{name:5.2}] [{pi:.0}]");
    // braces
    println(f"{{}} {{{n}}} }}{{");
    // integers of every size, their limits
    let a: i8 = -128;
    let c: i16 = -32768;
    let d: i32 = 2147483647;
    let e: i64 = -9223372036854775807 - 1;
    let f: u16 = 65535;
    let g: u32 = 4294967295;
    let h: u64 = 18446744073709551615;
    println(f"{a} {c} {d} {e} {f} {g} {h} {h:x}");
    // floats: the shortest text that reads back; Debug as Rust writes it
    let third = 1.0 / 3.0;
    let small = 0.000001;
    let x: f32 = 0.1;
    println(f"{1.0} {1.5} {third} {1e21} {small} {-0.0} {x} {0.1 + 0.2}");
    println(f"{1.0:?} {1.5:?} {1e16:?} {1e15:?} {small:?} {0.0001:?} {-0.0:?} {x:?} {2.5e-8:?}");
    let zero = 0.0;
    println(f"{zero / zero} {1.0 / zero} {-1.0 / zero} {zero / zero:?}");
    // bool, text and its Debug (escaped)
    let t = true;
    let text = "a\"b\\c\nd\te\x01";
    println(f"{t} {t:?} {!t:>6}| {text:?} {"":?}");
    // an f-string with no hole, and one only a hole
    println(f"plain");
    println(f"{n}");
}
