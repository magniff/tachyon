// Without --coverage, std::coverage() is all zeros (0.18).
// EXPECT: false false
fn f(x: i64) -> i64 { if x > 3 { x * 2 } else { x + 1 } }

fn hits() -> i64 {
    let c = std::coverage();
    var n = 0;
    for i in 0..c.len { if c[i] != 0 { n += 1; } }
    n
}

fn main() -> i32 {
    let a = hits();
    let _ = f(1);
    let b = hits();
    let _ = f(9);
    let c = hits();
    println(f"{a < b} {b < c}");
    0
}
