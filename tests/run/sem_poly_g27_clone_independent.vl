// a generic cloning a Vec<T> of Vec: the copy independent
// FLAGS: --check-alloc
// EXPECT: 1 2
fn dup<T: Clone>(x: T) -> T { x.clone() }

fn main(gpa: Gpa) {
    var inner: Vec<i64> = Vec::new_in(gpa);
    inner.push(1);
    var a: Vec<Vec<i64>> = Vec::new_in(gpa);
    a.push(inner);
    var b = dup(a);
    b[0].push(2);
    println(f"{a[0].len()} {b[0].len()}");
}
