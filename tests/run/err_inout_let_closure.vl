// (0.25) In a closure, a captured let is as read-only as outside: `&n`
// and an `inout self` method on a captured let are own.readonly.
fn bump(n: inout i64) { n += 1; }
fn main(gpa: Gpa) {
    let n = 1;
    let f = || bump(&n);
    f();
    var w: Vec<i64> = Vec::new_in(gpa);
    w.push(1);
    let v = w;
    let g = || { v.push(2); };
    g();
    println(f"{n} {v.len()}");
}
// ERROR: '&n' changes 'n', a let binding
// ERROR: 'v.push(2)' changes 'v', a let binding
