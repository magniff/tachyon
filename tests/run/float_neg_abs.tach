// Unary minus flips the sign bit only (including zero and NaN payload).
// EXPECT: -1.25 -0 -3.5 -0
// EXPECT: 1.25
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let a: f64 = 1.25;
    let z: f64 = 0.0;
    let b: f32 = 3.5;
    let zf: f32 = 0.0;
    printf("%g %g %g %g\n".0, -a, -z, -b, -zf);
    printf("%g\n".0, -(-a));
    0
}
