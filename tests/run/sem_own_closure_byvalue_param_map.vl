// sem-own: (known leak) Option::map's closure takes its item sink; the item
// is not dropped inside the closure.
// XFAIL: SOUNDNESS known leak: a closure's sink parameter is never dropped (Option::map)
// EXPECT: id 2
// EXPECT: drop 2
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let o: Option<D> = Some(mk(2, gpa));
    let n = o.map(|d| d.id);
    println(f"id {n.unwrap_or(0)}");
    println("end");
}
