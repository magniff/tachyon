#[inline(never)]
fn deep(v: Vec<i64>) -> i64 {
    let it0 = SliceIter { s: v.as_slice(), pos: 0 };
    let it1 = map(it0, C0 { k: 0 });
    let it2 = map(it1, C1 { k: 1 });
    let it3 = map(it2, C2 { k: 2 });
    let it4 = map(it3, C3 { k: 3 });
    let it5 = map(it4, C4 { k: 4 });
