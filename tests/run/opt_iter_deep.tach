#[inline(never)]
fn hand(v: Vec<i64>) -> i64 {
    let s = v.as_slice();
    var t = 0;
    for k in 0..s.len {
        t += s[k] + 1770;
    }
    t
}

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..1000 {
        v.push(i);
    }
    std::print_int(deep(v));
    println("");
    std::print_int(hand(v));
    println("");
    0
}
