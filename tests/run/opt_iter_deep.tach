// 0.14: a chain of 60 maps, each closure capturing a value, hand-desugared
// (see opt_iter_map_sum.tach): every level copies the level below into its
// struct (`self: Self`, memcpy above 128 bytes), and the fold's closures
// nest 60 deep. The copies are elided (copies.tach), the environments
// replaced by scalars, the calls inlined whatever the budgets (closures
// no bigger than their call; #[inline] counted once simplified), and the
// type arguments, 60 levels deep, are within the limits (front/generics):
// one vector loop, as the hand-written one.
// EXPECT: 2269500
// EXPECT: 2269500
// CHECK: fn deep:
// CHECK-NOT: call
// CHECK-NOT: slot
// CHECK: v2i64 = load
// CHECK-NOT: call
// CHECK-NOT: slot
// CHECK: fn hand:
struct SliceIter { s: [i64], pos: i64 }

impl SliceIter {
    #[inline]
    fn fold<B, G>(self, init: sink B, g: sink G) -> B {
        var acc = init;
        for k in self.pos..self.s.len {
            acc = g.call(acc, self.s[k]);
        }
        acc
    }
}

struct Map<I, F> { it: I, f: F }

// |acc, x| g(acc, f(x)): f a `let mut` (by reference), g a parameter (by
// reference too, above 32 bytes)
struct MapFold<F, G> { f: *F, g: *G }

impl<F, G> MapFold<F, G> {
    #[inline]
    fn call<B>(self, acc: sink B, x: i64) -> B {
        unsafe { (*self.g).call(acc, (*self.f).call(x)) }
    }
}

impl<I, F> Map<I, F> {
    #[inline]
    fn fold<B, G>(sink self, init: sink B, g: sink G) -> B {
        var f = self.f;
        self.it.fold(init, map_fold(&f, &g))
    }
}

#[inline]
fn map_fold<F, G>(f: inout F, g: inout G) -> MapFold<F, G> {
    MapFold { f: &f, g: &g }
}

#[inline]
fn map<I, F>(it: sink I, f: sink F) -> Map<I, F> {
    Map { it: it, f: f }
}

struct SumFold {}

impl SumFold {
    fn call(self, a: i64, x: i64) -> i64 {
        a + x
    }
}

