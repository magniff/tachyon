// `fn main() -> Result<(), E>` (0.15): an Err prints `Error: ` and the
// error's Debug on stderr, and the exit status is 1; deferred statements
// of main have run.
// EXPECT: 0
// EXPECT: 1
// EXPECT: cleanup
// STDERR: Error: 30
// EXIT: 1
fn check(x: i64) -> Result<i64, i64> {
    if x > 1 { Err(x * 15) } else { Ok(x) }
}

fn main() -> Result<(), i64> {
    defer println("cleanup");
    for i in 0..5 {
        let v = check(i)?;
        std::print_int(v);
        println("");
    }
    Ok(())
}
