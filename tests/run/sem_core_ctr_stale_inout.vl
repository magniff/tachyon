// A requires fact about an inout Vec's length goes stale when the body shrinks it.
// EXIT: 101
// STDERR: index out of bounds: index 2, length 0
static var Z: i64 = 0;

#[inline(never)]
fn at(v: inout Vec<i64>, i: i64) -> i64
    requires 0 <= i && i < v.len()
{
    v.clear();
    v[i]
}

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var v: Vec<i64> = Vec::new_in(gpa);
    for k in 0..4 { v.push(k * 11); }
    println(at(&v, 2 + Z));
    0
}
