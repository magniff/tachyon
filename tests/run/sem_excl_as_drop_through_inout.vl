// assigning through an inout drops the old value exactly once
// EXPECT: drop 1
// EXPECT: after
// EXPECT: drop 2
struct D { id: i64 }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn put(d: inout D, id: i64) { d = D { id: id }; }
fn main() { var a = D { id: 1 }; put(&a, 2); println("after"); }
