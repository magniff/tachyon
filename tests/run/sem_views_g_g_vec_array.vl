// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `f(l)`; s grows while it is used
// XFAIL: SOUNDNESS a function's view of what its parameter's elements or fields hold is lost (summary): use after free
// ERROR: error[own.conflict]
fn f(l: Vec<[str; 2]>) -> str { l.get(0)[1] }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var l: Vec<[str; 2]> = Vec::new_in(gpa); l.push([w, w]);
    let r = f(l);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
