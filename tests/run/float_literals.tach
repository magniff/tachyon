// Float constants are emitted bit-exactly for f32 and f64.
// EXPECT: 0.10000000149011612 0.10000000000000001 3.4028234663852886e+38 2.2250738585072014e-308 1.4012984643248171e-45 6.0221407599999999e+23
// EXPECT: 2 2
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let a: f32 = 0.1;
    let b: f64 = 0.1;
    let c: f32 = 3.4028234e38;
    let d: f64 = 2.2250738585072014e-308;
    let e: f32 = 1e-45;
    let f: f64 = 6.02214076e23;
    printf(c"%.17g %.17g %.17g %.17g %.17g %.17g\n", a, b, c, d, e, f);
    let g: f32 = 2.0;
    let h: f64 = 2.0;
    printf(c"%.17g %.17g\n", g, h);
    0
}
